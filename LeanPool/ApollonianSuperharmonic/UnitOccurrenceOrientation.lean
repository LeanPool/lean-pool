module

public import Mathlib.Init

public import LeanPool.ApollonianSuperharmonic.PrimitiveVectorOrientation

-- [TABLET NODE: UnitOccurrenceOrientation]

/-!
# UnitOccurrenceOrientation

Adapted from Wesley Pegden’s Apache-2.0 Trellis formalization of Levine–Pegden–Smart.
Changes: pool module paths, public exports, project namespace and current Mathlib compatibility.
-/

@[expose] public section

namespace ApollonianSuperharmonic

/--
For a proper ordered band quadruple $q=(C_0,C_1,C_2,C_3)$, a selected
unit parent slot $i\in\mathbb Z/3\mathbb Z$, and
$\epsilon\in\{\mathsf{standard},\mathsf{rotated}\}$, the relation
$\operatorname{UnitOccurrenceOrientation}(q,i,\epsilon)$ is generated by
the following occurrence rules.

Put $U_z=(1,1+2z)$.  The two first proper successor families are
$$
 L_z=((4,1+8z+4i),U_z,(0,-1),U_{z+i}),
 \qquad
 R_z=((4,7+8z+4i),U_z,U_{z+i},(0,1)).
$$
In $L_z$, the $U_z$ occurrence is standard and the $U_{z+i}$ occurrence
is rotated.  In $R_z$, the $U_z$ occurrence is likewise standard and the
$U_{z+i}$ occurrence is likewise rotated.  Cyclic rotation of the three
parent slots carries the orientation with the selected occurrence.  Finally,
a proper successor
$$
 (A,X,B,D)\longmapsto(2(A+B+D)-X,A,B,D)
$$
transports a certificate on a retained unit parent by inspecting the other
retained parent.  If $B,D$ are both units, use the canonical primitive
orientation of their literal common side.  When $B\longrightarrow D$, the
successor labels are
$(B\text{ rotated},D\text{ standard})$; when
$D\longrightarrow B$, they are
$(B\text{ standard},D\text{ rotated})$.  In particular these labels do not
depend on, and are not obtained by negating, the predecessor labels.  If the
sibling of the selected unit is a line or has curvature different from one,
the predecessor label is preserved.  For the first successor which retains
both units in either root family, the direction rule reproduces the root
labels; hence both selected occurrences preserve their Boolean and there is
no exceptional mismatch transition.  There is deliberately no constructor
transporting the replaced parent $X$, nor one selecting a chart from the
magnitude or direction of a whole boundary-string displacement.
-/
inductive UnitOccurrenceOrientation :
    (Fin 4 → CircleCoordinates) → Fin 3 → Bool → Prop where
-- BODY
  | leftLower (z : GaussianInt) :
      UnitOccurrenceOrientation
        ![(4, 1 + 8 * z + 4 * ⟨0, 1⟩),
          (1, 1 + 2 * z), (0, -1), (1, 1 + 2 * z + 2 * ⟨0, 1⟩)]
        0 true
  | leftUpper (z : GaussianInt) :
      UnitOccurrenceOrientation
        ![(4, 1 + 8 * z + 4 * ⟨0, 1⟩),
          (1, 1 + 2 * z), (0, -1), (1, 1 + 2 * z + 2 * ⟨0, 1⟩)]
        2 false
  | rightUpper (z : GaussianInt) :
      UnitOccurrenceOrientation
        ![(4, 7 + 8 * z + 4 * ⟨0, 1⟩),
          (1, 1 + 2 * z), (1, 1 + 2 * z + 2 * ⟨0, 1⟩), (0, 1)]
        0 true
  | rightLower (z : GaussianInt) :
      UnitOccurrenceOrientation
        ![(4, 7 + 8 * z + 4 * ⟨0, 1⟩),
          (1, 1 + 2 * z), (1, 1 + 2 * z + 2 * ⟨0, 1⟩), (0, 1)]
        1 false
  | rotate {q : Fin 4 → CircleCoordinates} {i : Fin 3}
      {orientation : Bool} :
      UnitOccurrenceOrientation q i orientation →
      UnitOccurrenceOrientation ![q 0, q 2, q 3, q 1] (i + 2) orientation
  | retainSecondToThird {q : Fin 4 → CircleCoordinates} {orientation : Bool} :
      ProperBandQuadruple q → (q 3).1 = 1 →
      PrimitiveVectorOrientation (q 2) (q 3) →
      UnitOccurrenceOrientation q 1 orientation →
      UnitOccurrenceOrientation
        ![(2 * (q 0).1 + 2 * (q 2).1 + 2 * (q 3).1 - (q 1).1,
            2 * (q 0).2 + 2 * (q 2).2 + 2 * (q 3).2 - (q 1).2),
          q 0, q 2, q 3]
        1 false
  | retainSecondFromThird {q : Fin 4 → CircleCoordinates} {orientation : Bool} :
      ProperBandQuadruple q → (q 3).1 = 1 →
      PrimitiveVectorOrientation (q 3) (q 2) →
      UnitOccurrenceOrientation q 1 orientation →
      UnitOccurrenceOrientation
        ![(2 * (q 0).1 + 2 * (q 2).1 + 2 * (q 3).1 - (q 1).1,
            2 * (q 0).2 + 2 * (q 2).2 + 2 * (q 3).2 - (q 1).2),
          q 0, q 2, q 3]
        1 true
  | retainSecondOther {q : Fin 4 → CircleCoordinates} {orientation : Bool} :
      ProperBandQuadruple q → (q 3).1 ≠ 1 →
      UnitOccurrenceOrientation q 1 orientation →
      UnitOccurrenceOrientation
        ![(2 * (q 0).1 + 2 * (q 2).1 + 2 * (q 3).1 - (q 1).1,
            2 * (q 0).2 + 2 * (q 2).2 + 2 * (q 3).2 - (q 1).2),
          q 0, q 2, q 3]
        1 orientation
  | retainThirdFromSecond {q : Fin 4 → CircleCoordinates} {orientation : Bool} :
      ProperBandQuadruple q → (q 2).1 = 1 →
      PrimitiveVectorOrientation (q 2) (q 3) →
      UnitOccurrenceOrientation q 2 orientation →
      UnitOccurrenceOrientation
        ![(2 * (q 0).1 + 2 * (q 2).1 + 2 * (q 3).1 - (q 1).1,
            2 * (q 0).2 + 2 * (q 2).2 + 2 * (q 3).2 - (q 1).2),
          q 0, q 2, q 3]
        2 true
  | retainThirdToSecond {q : Fin 4 → CircleCoordinates} {orientation : Bool} :
      ProperBandQuadruple q → (q 2).1 = 1 →
      PrimitiveVectorOrientation (q 3) (q 2) →
      UnitOccurrenceOrientation q 2 orientation →
      UnitOccurrenceOrientation
        ![(2 * (q 0).1 + 2 * (q 2).1 + 2 * (q 3).1 - (q 1).1,
            2 * (q 0).2 + 2 * (q 2).2 + 2 * (q 3).2 - (q 1).2),
          q 0, q 2, q 3]
        2 false
  | retainThirdOther {q : Fin 4 → CircleCoordinates} {orientation : Bool} :
      ProperBandQuadruple q → (q 2).1 ≠ 1 →
      UnitOccurrenceOrientation q 2 orientation →
      UnitOccurrenceOrientation
        ![(2 * (q 0).1 + 2 * (q 2).1 + 2 * (q 3).1 - (q 1).1,
            2 * (q 0).2 + 2 * (q 2).2 + 2 * (q 3).2 - (q 1).2),
          q 0, q 2, q 3]
        2 orientation

end ApollonianSuperharmonic

end

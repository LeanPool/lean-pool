-- [TABLET NODE: BandPackingSymmetry]

/-!
# BandPackingSymmetry

Adapted from Wesley Pegden’s Apache-2.0 Trellis formalization of Levine–Pegden–Smart.
Changes: pool module paths, public exports, project namespace and current Mathlib compatibility.
-/

@[expose] public section

namespace ApollonianSuperharmonic

/--
A *band-packing symmetry word* is an expression in the free abstract
syntax generated by
$$
 \operatorname{identity},\qquad \operatorname{negate},\qquad
 \operatorname{conjugate},\qquad \operatorname{shift}(w)
 \quad (w\in\mathbb Z[i]),
$$
together with a binary constructor
$\operatorname{comp}(g,h)$ for symmetry words $g$ and $h$.  No relations
between these expressions are imposed at the level of this syntax.
-/
inductive BandPackingSymmetry : Type where
-- BODY
  | identity
  | negate
  | conjugate
  | shift (w : GaussianInt)
  | comp (g h : BandPackingSymmetry)

end ApollonianSuperharmonic

end

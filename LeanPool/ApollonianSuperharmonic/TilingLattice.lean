/-!
# TilingLattice

Adapted from Wesley Pegden’s Apache-2.0 Trellis formalization of Levine–Pegden–Smart.
Changes: pool module paths, public exports, project namespace and current Mathlib compatibility.
-/

@[expose] public section

namespace ApollonianSuperharmonic

/--
For a curvature-one band circle set $\Lambda_C=\mathbb Z[i]$.  Otherwise,
let $(C,C_1,C_2,C_3)$ be its unique proper parent quadruple and set
$$
 \Lambda_C=\mathbb Z v(C_1,C)+\mathbb Z v(C_2,C)+\mathbb Z v(C_3,C),
$$
as the additive subgroup generated by the three incoming parent vectors.
Equivalently one may use any two: the parent triple is unique up to rotation,
and the superbasis relation makes the third generator redundant.  This
definition is independent of $L_C$.
-/
def TilingLattice (C : BandCircle) : AddSubgroup GaussianInt :=
-- BODY
  if C.1.1.1 = 1 then ⊤ else
    AddSubgroup.closure {u | ∃ q : Fin 4 → CircleCoordinates,
      SemiProperQuadruple q ∧ q 0 = C.1.1 ∧
      (∀ j : Fin 3, (q j.succ).1 < C.1.1.1) ∧
      ∃ j : Fin 3, u = BandVectors.1 (q j.succ) (q 0)}

end ApollonianSuperharmonic

end

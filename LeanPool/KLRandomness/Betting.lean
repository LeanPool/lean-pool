-- Modified for Lean Pool.

module

public import LeanPool.KLRandomness.Cantor
public import Mathlib.Computability.Partrec
public import Mathlib.Data.Rat.Cast.Order
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Positivity

/-!
# Total nonmonotonic betting strategies

These definitions follow Section 2 of Liu and Meng, arXiv:2611.31004v1.
The capital can be a computable real, rather than just a rational number.
Computability is witnessed by uniform rational approximations, encoded by
their integer numerator and natural denominator.

The definition of KL randomness here uses total strategies, as in the paper.
`PartialBettingCapital` proves totalization for partial rational-wager programs.
The bridge from general partial computable-real capital remains separate.
-/

@[expose] public section

namespace Klr

/-- Uniform computability of a real-valued function on finite bit strings.
The rate of approximation is fixed, so mere pointwise computability does not
suffice. Rational numbers use their canonical numerator/denominator coding. -/
def ComputableRealCapital (d : List Bool → ℝ) : Prop :=
  ∃ q : List Bool → ℕ → ℚ,
    Computable (fun p : List Bool × ℕ => ((q p.1 p.2).num, (q p.1 p.2).den)) ∧
    ∀ v n, |(q v n : ℝ) - d v| ≤ (1 / 2 : ℝ) ^ n

/-- A total computable query rule, with no repeated query on a branch.
Freshness is imposed on every finite transcript, including transcripts not
generated by a particular input. -/
structure ScanRule where
  /-- Position of the next input bit after a finite transcript. -/
  query : List Bool → ℕ
  computable_query : Computable query
  fresh : ∀ (v : List Bool) (n : ℕ), n < v.length → query (v.take n) ≠ query v

namespace ScanRule

/-- The answers actually observed by a scan rule on input `X`. -/
def transcript (π : ScanRule) (X : Cantor) : ℕ → List Bool
  | 0 => []
  | n + 1 =>
    let v := transcript π X n
    v ++ [X (π.query v)]

@[simp] theorem transcript_zero (π : ScanRule) (X : Cantor) :
    π.transcript X 0 = [] := rfl

@[simp] theorem transcript_succ (π : ScanRule) (X : Cantor) (n : ℕ) :
    π.transcript X (n + 1) =
      π.transcript X n ++ [X (π.query (π.transcript X n))] := rfl

@[simp] theorem length_transcript (π : ScanRule) (X : Cantor) (n : ℕ) :
    (π.transcript X n).length = n := by
  induction n with
  | zero => rfl
  | succ n ih => simp [ih]

theorem transcript_prefix (π : ScanRule) (X : Cantor) {m n : ℕ} (h : m ≤ n) :
    π.transcript X m <+: π.transcript X n := by
  induction h with
  | refl => exact List.prefix_refl _
  | @step n h ih =>
    exact ih.trans (List.prefix_append _ _)

theorem transcript_take (π : ScanRule) (X : Cantor) {m n : ℕ} (h : m ≤ n) :
    (π.transcript X n).take m = π.transcript X m := by
  obtain ⟨t, ht⟩ := π.transcript_prefix X h
  rw [← ht, ← π.length_transcript X m]
  simp

/-- Distinct times query distinct input positions. This is the condition
needed for fair-coin inputs to induce fair-coin transcripts. -/
theorem query_ne_of_lt (π : ScanRule) (X : Cantor) {m n : ℕ} (h : m < n) :
    π.query (π.transcript X m) ≠ π.query (π.transcript X n) := by
  have hf := π.fresh (π.transcript X n) m (by simpa using h)
  simpa [π.transcript_take X h.le] using hf

theorem query_injective (π : ScanRule) (X : Cantor) :
    Function.Injective (fun n => π.query (π.transcript X n)) := by
  intro m n h
  rcases lt_trichotomy m n with hlt | heq | hgt
  · exact False.elim (π.query_ne_of_lt X hlt h)
  · exact heq
  · exact False.elim (π.query_ne_of_lt X hgt h.symm)

/-- Reading input positions in their usual increasing order. -/
def monotone : ScanRule where
  query := List.length
  computable_query := Computable.list_length
  fresh := by
    intro v n hn
    simp only [List.length_take, Nat.min_eq_left hn.le]
    omega

/-- The usual prefix of an input, expressed as a list. -/
def inputPrefix (X : Cantor) (n : ℕ) : List Bool :=
  (List.range n).map X

@[simp] theorem monotone_transcript (X : Cantor) (n : ℕ) :
    monotone.transcript X n = inputPrefix X n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [transcript_succ]
    change monotone.transcript X n ++ [X (monotone.transcript X n).length] = _
    rw [length_transcript, ih]
    simp [inputPrefix, List.range_succ]

end ScanRule

/-- A nonnegative fair capital function, with initial capital one. -/
structure CapitalProcess where
  /-- Capital after observing a finite binary transcript. -/
  value : List Bool → ℝ
  initial : value [] = 1
  nonneg : ∀ v, 0 ≤ value v
  fair : ∀ v, value (v ++ [false]) + value (v ++ [true]) = 2 * value v

namespace CapitalProcess

/-- The signed fraction staked on the next answer. At zero capital it is zero
by the convention for division in Lean. -/
noncomputable def wager (d : CapitalProcess) (v : List Bool) : ℝ :=
  (d.value (v ++ [true]) - d.value (v ++ [false])) / (2 * d.value v)

theorem successor_le (d : CapitalProcess) (v : List Bool) (b : Bool) :
    d.value (v ++ [b]) ≤ 2 * d.value v := by
  have h := d.fair v
  have h₀ := d.nonneg (v ++ [false])
  have h₁ := d.nonneg (v ++ [true])
  cases b <;> linarith

theorem successor_eq_zero (d : CapitalProcess) (v : List Bool)
    (hv : d.value v = 0) (b : Bool) : d.value (v ++ [b]) = 0 := by
  have h := d.successor_le v b
  rw [hv] at h
  exact le_antisymm (by linarith) (d.nonneg _)

theorem abs_wager_le_one (d : CapitalProcess) (v : List Bool)
    (hv : 0 < d.value v) : |d.wager v| ≤ 1 := by
  have h := d.fair v
  have h₀ := d.nonneg (v ++ [false])
  have h₁ := d.nonneg (v ++ [true])
  rw [wager, abs_le]
  constructor
  · apply (le_div_iff₀ (by positivity : 0 < 2 * d.value v)).2
    linarith
  · apply (div_le_iff₀ (by positivity : 0 < 2 * d.value v)).2
    linarith

theorem update (d : CapitalProcess) (v : List Bool)
    (hv : 0 < d.value v) (b : Bool) :
    d.value (v ++ [b]) =
      d.value v * (1 + (if b then 1 else -1) * d.wager v) := by
  have h := d.fair v
  have hn : d.value v ≠ 0 := ne_of_gt hv
  cases b <;> simp only [Bool.false_eq_true, ite_false, ite_true] <;>
    unfold wager <;> field_simp <;> nlinarith

end CapitalProcess

/-- A total computable nonmonotonic betting strategy. -/
structure BettingStrategy where
  /-- The adaptive order in which the input bits are read. -/
  scan : ScanRule
  /-- The fair capital process associated with the scan. -/
  capital : CapitalProcess
  computable_capital : ComputableRealCapital capital.value

/-- Success means unbounded capital, not convergence to infinity. -/
def BettingStrategy.Succeeds (s : BettingStrategy) (X : Cantor) : Prop :=
  ∀ bound : ℝ, ∃ n, bound < s.capital.value (s.scan.transcript X n)

/-- Kolmogorov–Loveland randomness in the paper's total-strategy formulation. -/
def KolmogorovLovelandRandom (X : Cantor) : Prop :=
  ∀ s : BettingStrategy, ¬ s.Succeeds X

/-- Computable randomness, using the same computable-real capital functions
and ordinary left-to-right scanning. -/
def ComputablyRandom (X : Cantor) : Prop :=
  ∀ d : CapitalProcess, ComputableRealCapital d.value →
    ¬ (∀ bound : ℝ, ∃ n, bound < d.value (ScanRule.inputPrefix X n))

theorem KolmogorovLovelandRandom.computablyRandom {X : Cantor}
    (hX : KolmogorovLovelandRandom X) : ComputablyRandom X := by
  intro d hd hs
  apply hX ⟨ScanRule.monotone, d, hd⟩
  intro bound
  obtain ⟨n, hn⟩ := hs bound
  exact ⟨n, by simpa using hn⟩

end Klr

-- Modified for Lean Pool.

module

public import LeanPool.KLRandomness.RemainingRank
public import Mathlib.MeasureTheory.Measure.Continuity

/-!
# Transcript laws restricted to no rank drop

The finite-stage cylinder identity extends to every Borel transcript event on
the event that the new block never loses full unread rank.  The proof first
intersects cylinders with finite-horizon survival events, passes to the
decreasing intersection, and then uses uniqueness of finite measures on the
prefix-cylinder generator of Cantor space.
-/

@[expose] public section

namespace Klr

open MeasureTheory ProbabilityTheory
open scoped ENNReal

namespace StoppingTranscript

/-- Extending a transcript only shrinks its input event. -/
theorem inputEvent_subset_of_prefix (π : ScanRule) {u v : List Bool} (h : u <+: v) :
    inputEvent π v ⊆ inputEvent π u := by
  intro X hX
  change π.transcript X v.length = v at hX
  change π.transcript X u.length = u
  rw [← π.transcript_take X h.length_le, hX]
  exact (List.prefix_iff_eq_take.mp h).symm

end StoppingTranscript

/-- Ordinary prefix cylinders are the input events of the monotone scan. -/
theorem cylinder_eq_monotone_inputEvent (v : List Bool) :
    cylinder v = StoppingTranscript.inputEvent ScanRule.monotone v := by
  ext X
  change (∀ i < v.length, X i = v.getD i false) ↔ _
  rw [StoppingTranscript.inputEvent, Set.mem_ofPred, ScanRule.transcript_eq_iff]
  constructor <;> intro h i hi <;>
    simpa [ScanRule.monotone, List.length_take, Nat.min_eq_left hi.le] using h i hi

theorem cylinder_subset_of_prefix {u v : List Bool} (h : u <+: v) :
    cylinder v ⊆ cylinder u := by
  rw [cylinder_eq_monotone_inputEvent, cylinder_eq_monotone_inputEvent]
  exact StoppingTranscript.inputEvent_subset_of_prefix ScanRule.monotone h

/-- A one-coordinate specification is a countable union of ordinary prefix cylinders. -/
theorem coordinate_event_eq_iUnion_cylinders (n : ℕ) (b : Bool) :
    {X : Cantor | X n = b} =
      ⋃ v : {v : List Bool // v.length = n + 1 ∧ v.getD n false = b}, cylinder v.val := by
  ext X
  constructor
  · intro hb
    let v := ScanRule.monotone.transcript X (n + 1)
    have hv : v.length = n + 1 ∧ v.getD n false = b := by
      constructor
      · simp only [v, ScanRule.length_transcript]
      · rw [ScanRule.getD_transcript ScanRule.monotone X (by omega)]
        change X (ScanRule.monotone.transcript X n).length = b
        rwa [ScanRule.length_transcript]
    apply Set.mem_iUnion.mpr
    refine ⟨⟨v, hv⟩, ?_⟩
    rw [cylinder_eq_monotone_inputEvent]
    change ScanRule.monotone.transcript X v.length = v
    rw [hv.1]
  · intro h
    obtain ⟨v, hv⟩ := Set.mem_iUnion.mp h
    exact (hv n (by rw [v.property.1]; omega)).trans v.property.2

/-- Prefix cylinders form a π-system. -/
theorem isPiSystem_cylinders : IsPiSystem (Set.range cylinder) := by
  rintro _ ⟨u, rfl⟩ _ ⟨v, rfl⟩ ⟨X, hu, hv⟩
  rw [cylinder_eq_monotone_inputEvent] at hu hv
  rcases StoppingTranscript.comparable_of_mem_inputEvent ScanRule.monotone hu hv with h | h
  · exact ⟨v, (Set.inter_eq_right.mpr (cylinder_subset_of_prefix h)).symm⟩
  · exact ⟨u, (Set.inter_eq_left.mpr (cylinder_subset_of_prefix h)).symm⟩

/-- The product measurable space on Cantor space is generated by prefix cylinders. -/
theorem measurableSpace_eq_generateFrom_cylinders :
    (inferInstance : MeasurableSpace Cantor) =
      MeasurableSpace.generateFrom (Set.range cylinder) := by
  apply le_antisymm
  · have h : @Measurable Cantor Cantor
        (MeasurableSpace.generateFrom (Set.range cylinder)) inferInstance id := by
      let : MeasurableSpace Cantor := MeasurableSpace.generateFrom (Set.range cylinder)
      apply measurable_pi_iff.mpr
      intro n
      apply measurable_to_countable'
      intro b
      change @MeasurableSet Cantor (MeasurableSpace.generateFrom (Set.range cylinder))
        {X | X n = b}
      rw [coordinate_event_eq_iUnion_cylinders]
      exact MeasurableSet.iUnion fun v =>
        MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self v.val)
    exact h
  · exact MeasurableSpace.generateFrom_le (fun _ ⟨v, hv⟩ => hv ▸ measurableSet_cylinder v)

/-- A finite measure on Cantor space is determined by the probabilities of finite prefixes. -/
theorem measure_eq_of_cylinders (μ ν : Measure Cantor) [IsFiniteMeasure μ]
    (h : ∀ v, μ (cylinder v) = ν (cylinder v)) : μ = ν := by
  apply ext_of_generate_finite (Set.range cylinder) measurableSpace_eq_generateFrom_cylinders
    isPiSystem_cylinders
  · rintro _ ⟨v, rfl⟩
    exact h v
  · simpa using h []

/-- An arbitrary condition on a fixed finite prefix gives a measurable cylinder union. -/
theorem prefix_event_eq_iUnion_cylinders (P : List Bool → Prop) (n : ℕ) :
    {X : Cantor | P (ScanRule.inputPrefix X n)} =
      ⋃ v : {v : List Bool // v.length = n ∧ P v}, cylinder v.val := by
  ext X
  constructor
  · intro h
    change P (ScanRule.inputPrefix X n) at h
    let v := ScanRule.monotone.transcript X n
    have hv : v.length = n ∧ P v :=
      ⟨ScanRule.length_transcript _ _ _, by simpa only [v, ScanRule.monotone_transcript] using h⟩
    apply Set.mem_iUnion.mpr
    refine ⟨⟨v, hv⟩, ?_⟩
    rw [cylinder_eq_monotone_inputEvent]
    change ScanRule.monotone.transcript X v.length = v
    rw [hv.1]
  · intro h
    obtain ⟨v, hv⟩ := Set.mem_iUnion.mp h
    rw [cylinder_eq_monotone_inputEvent] at hv
    change ScanRule.monotone.transcript X v.val.length = v.val at hv
    rw [v.property.1, ScanRule.monotone_transcript] at hv
    change P (ScanRule.inputPrefix X n)
    rw [hv]
    exact v.property.2

theorem measurableSet_prefix_event (P : List Bool → Prop) (n : ℕ) :
    MeasurableSet {X : Cantor | P (ScanRule.inputPrefix X n)} := by
  rw [prefix_event_eq_iUnion_cylinders]
  exact MeasurableSet.iUnion fun v => measurableSet_cylinder v.val

namespace ScanRule

/-- The entire sequence of answers observed by a total adaptive scan. -/
def observationMap (π : ScanRule) (X : Cantor) : Cantor :=
  fun n => X (π.query (π.transcript X n))

/-- The infinite observation map has the prescribed finite transcript as every prefix. -/
theorem observationMap_mem_cylinder_iff (π : ScanRule) (X : Cantor) (v : List Bool) :
    π.observationMap X ∈ cylinder v ↔ π.transcript X v.length = v := by
  constructor
  · intro h
    apply List.ext_getElem (π.length_transcript X v.length)
    intro i hi hv
    have he := π.getD_transcript X hv
    rw [List.getD_eq_getElem _ _ hi] at he
    rw [he]
    exact (h i hv).trans (List.getD_eq_getElem _ _ hv)
  · intro h i hi
    change X (π.query (π.transcript X i)) = v.getD i false
    rw [← π.getD_transcript X hi, h]

theorem observationMap_preimage_cylinder (π : ScanRule) (v : List Bool) :
    π.observationMap ⁻¹' cylinder v = StoppingTranscript.inputEvent π v := by
  ext X
  exact π.observationMap_mem_cylinder_iff X v

theorem inputPrefix_observationMap (π : ScanRule) (X : Cantor) (n : ℕ) :
    inputPrefix (π.observationMap X) n = π.transcript X n := by
  have h : π.observationMap X ∈ cylinder (π.transcript X n) := by
    apply (π.observationMap_mem_cylinder_iff X _).mpr
    rw [π.length_transcript]
  rw [cylinder_eq_monotone_inputEvent] at h
  change ScanRule.monotone.transcript (π.observationMap X) (π.transcript X n).length =
    π.transcript X n at h
  simpa only [π.length_transcript, ScanRule.monotone_transcript] using h

/-- Measurability follows from the finite transcript preimages of the cylinder generator. -/
theorem measurable_observationMap (π : ScanRule) : Measurable π.observationMap := by
  suffices h : @Measurable Cantor Cantor inferInstance
      (MeasurableSpace.generateFrom (Set.range cylinder)) π.observationMap by
    rwa [← measurableSpace_eq_generateFrom_cylinders] at h
  apply measurable_generateFrom
  rintro _ ⟨v, rfl⟩
  rw [observationMap_preimage_cylinder]
  exact StoppingTranscript.measurableSet_inputEvent π v

end ScanRule

namespace NoDrop

open StoppingTranscript

/-- Full unread rank remains after the first `n` observations. -/
def survivalEvent (B : AffineBlock) (π : ScanRule) (n : ℕ) : Set Cantor :=
  {X | B.UnreadFullRank π (π.transcript X n)}

/-- The new block never loses full unread rank along the scan. -/
def noDropEvent (B : AffineBlock) (π : ScanRule) : Set Cantor :=
  {X | ∀ n, B.UnreadFullRank π (π.transcript X n)}

/-- The event `T = ∞`, viewed as a Borel set of infinite answer transcripts. -/
def noDropTranscripts (B : AffineBlock) (π : ScanRule) : Set Cantor :=
  {Y | ∀ n, B.UnreadFullRank π (ScanRule.inputPrefix Y n)}

theorem measurableSet_noDropTranscripts (B : AffineBlock) (π : ScanRule) :
    MeasurableSet (noDropTranscripts B π) := by
  change MeasurableSet {Y | ∀ n, B.UnreadFullRank π (ScanRule.inputPrefix Y n)}
  simp only [Set.ofPred_forall]
  exact MeasurableSet.iInter (fun n => measurableSet_prefix_event (B.UnreadFullRank π) n)

theorem observationMap_preimage_noDropTranscripts (B : AffineBlock) (π : ScanRule) :
    π.observationMap ⁻¹' noDropTranscripts B π = noDropEvent B π := by
  ext X
  simp only [Set.mem_preimage, noDropTranscripts, noDropEvent, Set.mem_ofPred_eq,
    π.inputPrefix_observationMap]

theorem survivalEvent_antitone (B : AffineBlock) (π : ScanRule) :
    Antitone (survivalEvent B π) := by
  intro m n h X hX
  apply (B.unreadFullRank_iff_remainingRank π _).mpr
  apply le_antisymm (B.remainingRank_le π _)
  rw [← (B.unreadFullRank_iff_remainingRank π _).mp hX]
  exact B.remainingRank_transcript_antitone π X h

/-- Fixed-length extensions which retain full unread rank. -/
def survivingExtensions (B : AffineBlock) (π : ScanRule) (v : List Bool) (n : ℕ) :
    Set (List Bool) :=
  {w | w.length = n ∧ v <+: w ∧ B.UnreadFullRank π w}

theorem survivingExtensions_prefixFree (B : AffineBlock) (π : ScanRule)
    (v : List Bool) (n : ℕ) : PrefixFree (survivingExtensions B π v n) := by
  intro u w hu hw h
  exact h.eq_of_length (hu.1.trans hw.1.symm)

/-- A transcript cylinder intersected with finite survival is a disjoint union of
full-rank extensions at that horizon. -/
theorem inputEvent_inter_survival_eq_union (B : AffineBlock) (π : ScanRule)
    (v : List Bool) (n : ℕ) (hn : v.length ≤ n) :
    inputEvent π v ∩ survivalEvent B π n =
      unionEvent π (survivingExtensions B π v n) := by
  ext X
  constructor
  · rintro ⟨hv, hfull⟩
    change π.transcript X v.length = v at hv
    have hw : π.transcript X n ∈ survivingExtensions B π v n := by
      refine ⟨π.length_transcript X n, ?_, hfull⟩
      simpa only [hv] using π.transcript_prefix X hn
    apply Set.mem_iUnion.mpr
    refine ⟨⟨π.transcript X n, hw⟩, ?_⟩
    change π.transcript X (π.transcript X n).length = π.transcript X n
    rw [π.length_transcript]
  · intro h
    obtain ⟨w, hw⟩ := Set.mem_iUnion.mp h
    refine ⟨inputEvent_subset_of_prefix π w.property.2.1 hw, ?_⟩
    change π.transcript X w.val.length = w.val at hw
    rw [w.property.1] at hw
    change B.UnreadFullRank π (π.transcript X n)
    rw [hw]
    exact w.property.2.2

theorem measurableSet_survivalEvent (B : AffineBlock) (π : ScanRule) (n : ℕ) :
    MeasurableSet (survivalEvent B π n) := by
  have h := inputEvent_inter_survival_eq_union B π [] n (by simp)
  have he : inputEvent π [] = Set.univ := by
    ext X
    simp [inputEvent]
  rw [he, Set.univ_inter] at h
  rw [h]
  exact measurableSet_unionEvent π _

theorem noDropEvent_eq_iInter (B : AffineBlock) (π : ScanRule) :
    noDropEvent B π = ⋂ n, survivalEvent B π n := by
  ext X
  simp [noDropEvent, survivalEvent]

theorem measurableSet_noDropEvent (B : AffineBlock) (π : ScanRule) :
    MeasurableSet (noDropEvent B π) := by
  rw [noDropEvent_eq_iInter]
  exact MeasurableSet.iInter (measurableSet_survivalEvent B π)

/-- No loss of full rank is exactly the absence of every finite strict rank decrease. -/
theorem mem_noDropEvent_iff_no_strict_rank_drop (B : AffineBlock) (π : ScanRule)
    (X : Cantor) :
    X ∈ noDropEvent B π ↔
      ∀ n, ¬B.remainingRank π (π.transcript X (n + 1)) <
        B.remainingRank π (π.transcript X n) := by
  constructor
  · intro h n
    rw [(B.unreadFullRank_iff_remainingRank π _).mp (h (n + 1)),
      (B.unreadFullRank_iff_remainingRank π _).mp (h n)]
    exact lt_irrefl _
  · intro h n
    exact (B.unreadFullRank_iff_remainingRank π _).mpr
      (B.remainingRank_eq_rank_of_no_drop π X n (fun k _ => h k))

/-- This is the event `T = ∞`: no finite first rank drop occurs. -/
theorem noDropEvent_eq_compl_rankDropTailEvent (B : AffineBlock) (π : ScanRule) :
    noDropEvent B π = (rankDropTailEvent B π 0)ᶜ := by
  classical
  rw [← unionEvent_rankDropTriggerTail]
  have htail : firstTriggerTail (rankDropTrigger B π) 0 =
      firstTrigger (rankDropTrigger B π) := by
    ext v
    simp [firstTriggerTail]
  rw [htail]
  ext X
  change (∀ n, B.UnreadFullRank π (π.transcript X n)) ↔
    X ∉ unionEvent π (firstTrigger (rankDropTrigger B π))
  rw [mem_unionEvent_firstTrigger_iff]
  constructor
  · intro h ⟨n, hn⟩
    exact ((rankDropTrigger_transcript_iff B π X n).mp hn).2 (h (n + 1))
  · intro h n
    induction n with
    | zero => simpa using B.unreadFullRank_nil π
    | succ n ih =>
      by_contra hbad
      exact h ⟨n, (rankDropTrigger_transcript_iff B π X n).mpr ⟨ih, hbad⟩⟩

/-- The actual old and new stage laws agree on every finite-horizon surviving cylinder. -/
theorem nextStage_inputEvent_inter_survival {κ : Type*} [Finite κ]
    (old : κ → AffineBlock) (B : AffineBlock)
    (hold : Pairwise (fun i j => Disjoint (old i).support (old j).support))
    (hnew : ∀ k, Disjoint (old k).support B.support)
    (π : ScanRule) (v : List Bool) (n : ℕ) (hn : v.length ≤ n) :
    (cond fairCoin (AffineBlock.familyEvent old ∩ B.event))
        (inputEvent π v ∩ survivalEvent B π n) =
      (AffineBlock.finiteStageLaw old) (inputEvent π v ∩ survivalEvent B π n) := by
  rw [inputEvent_inter_survival_eq_union B π v n hn]
  exact nextStage_unionEvent old B hold hnew π
    (survivingExtensions_prefixFree B π v n) (fun _ hw => hw.2.2)

/-- The no-drop part of a cylinder is the decreasing limit of its surviving refinements. -/
theorem inputEvent_inter_noDrop_eq_iInter (B : AffineBlock) (π : ScanRule) (v : List Bool) :
    inputEvent π v ∩ noDropEvent B π =
      ⋂ n, inputEvent π v ∩ survivalEvent B π (n + v.length) := by
  ext X
  constructor
  · rintro ⟨hv, hfull⟩
    exact Set.mem_iInter.mpr (fun n => ⟨hv, hfull _⟩)
  · intro h
    have h' := Set.mem_iInter.mp h
    refine ⟨(h' 0).1, ?_⟩
    intro n
    exact survivalEvent_antitone B π (Nat.le_add_right n v.length) (h' n).2

/-- Continuity from above extends the finite-stage identity to each no-drop cylinder. -/
theorem nextStage_inputEvent_inter_noDrop {κ : Type*} [Finite κ]
    (old : κ → AffineBlock) (B : AffineBlock)
    (hold : Pairwise (fun i j => Disjoint (old i).support (old j).support))
    (hnew : ∀ k, Disjoint (old k).support B.support)
    (π : ScanRule) (v : List Bool) :
    (cond fairCoin (AffineBlock.familyEvent old ∩ B.event))
        (inputEvent π v ∩ noDropEvent B π) =
      (AffineBlock.finiteStageLaw old) (inputEvent π v ∩ noDropEvent B π) := by
  have ha : Antitone (fun n => inputEvent π v ∩ survivalEvent B π (n + v.length)) := by
    intro m n h X hX
    exact ⟨hX.1, survivalEvent_antitone B π (Nat.add_le_add_right h _) hX.2⟩
  have hm (n : ℕ) : MeasurableSet (inputEvent π v ∩ survivalEvent B π (n + v.length)) :=
    (measurableSet_inputEvent π v).inter (measurableSet_survivalEvent B π _)
  let : IsFiniteMeasure (AffineBlock.finiteStageLaw old) := by
    unfold AffineBlock.finiteStageLaw
    infer_instance
  rw [inputEvent_inter_noDrop_eq_iInter,
    ha.measure_iInter (fun n => (hm n).nullMeasurableSet) ⟨0, measure_ne_top _ _⟩,
    ha.measure_iInter (fun n => (hm n).nullMeasurableSet) ⟨0, measure_ne_top _ _⟩]
  exact iInf_congr fun n => nextStage_inputEvent_inter_survival old B hold hnew π v
    (n + v.length) (Nat.le_add_left _ _)

/-- Push forward the actual input measure after restricting it to inputs with no rank drop. -/
noncomputable def restrictedTranscriptLaw (μ : Measure Cantor) (B : AffineBlock)
    (π : ScanRule) : Measure Cantor :=
  (μ.restrict (noDropEvent B π)).map π.observationMap

instance (μ : Measure Cantor) [IsFiniteMeasure μ] (B : AffineBlock) (π : ScanRule) :
    IsFiniteMeasure (restrictedTranscriptLaw μ B π) := by
  unfold restrictedTranscriptLaw
  infer_instance

/-- The no-drop restriction can equivalently be taken after pushing forward to transcripts. -/
theorem restrictedTranscriptLaw_eq_restrict_map (μ : Measure Cantor) (B : AffineBlock)
    (π : ScanRule) :
    restrictedTranscriptLaw μ B π =
      (μ.map π.observationMap).restrict (noDropTranscripts B π) := by
  rw [Measure.restrict_map π.measurable_observationMap (measurableSet_noDropTranscripts B π),
    observationMap_preimage_noDropTranscripts]
  rfl

theorem restrictedTranscriptLaw_apply (μ : Measure Cantor) (B : AffineBlock)
    (π : ScanRule) {F : Set Cantor} (hF : MeasurableSet F) :
    restrictedTranscriptLaw μ B π F = μ (π.observationMap ⁻¹' F ∩ noDropEvent B π) := by
  rw [restrictedTranscriptLaw, Measure.map_apply π.measurable_observationMap hF,
    Measure.restrict_apply (π.measurable_observationMap hF)]

/-- Equality of the two finite-stage transcript measures restricted to `T = ∞`.
The identity on cylinders is derived from the block rank condition, not assumed. -/
theorem nextStage_restrictedTranscriptLaw {κ : Type*} [Finite κ]
    (old : κ → AffineBlock) (B : AffineBlock)
    (hold : Pairwise (fun i j => Disjoint (old i).support (old j).support))
    (hnew : ∀ k, Disjoint (old k).support B.support) (π : ScanRule) :
    restrictedTranscriptLaw (cond fairCoin (AffineBlock.familyEvent old ∩ B.event)) B π =
      restrictedTranscriptLaw (AffineBlock.finiteStageLaw old) B π := by
  apply measure_eq_of_cylinders
  intro v
  rw [restrictedTranscriptLaw_apply _ _ _ (measurableSet_cylinder v),
    restrictedTranscriptLaw_apply _ _ _ (measurableSet_cylinder v),
    π.observationMap_preimage_cylinder]
  exact nextStage_inputEvent_inter_noDrop old B hold hnew π v

/-- The Section 6 no-drop identity as equality of restrictions of the two actual
infinite transcript laws. -/
theorem nextStage_map_restrict_noDrop {κ : Type*} [Finite κ]
    (old : κ → AffineBlock) (B : AffineBlock)
    (hold : Pairwise (fun i j => Disjoint (old i).support (old j).support))
    (hnew : ∀ k, Disjoint (old k).support B.support) (π : ScanRule) :
    ((cond fairCoin (AffineBlock.familyEvent old ∩ B.event)).map π.observationMap).restrict
        (noDropTranscripts B π) =
      ((AffineBlock.finiteStageLaw old).map π.observationMap).restrict (noDropTranscripts B π) := by
  rw [← restrictedTranscriptLaw_eq_restrict_map, ← restrictedTranscriptLaw_eq_restrict_map]
  exact nextStage_restrictedTranscriptLaw old B hold hnew π

/-- For every Borel transcript event `F`, the old and new stage laws give the same mass
to `F ∩ {T = ∞}`, interpreted through the actual infinite transcript map. -/
theorem nextStage_noDrop_borel {κ : Type*} [Finite κ]
    (old : κ → AffineBlock) (B : AffineBlock)
    (hold : Pairwise (fun i j => Disjoint (old i).support (old j).support))
    (hnew : ∀ k, Disjoint (old k).support B.support) (π : ScanRule)
    {F : Set Cantor} (hF : MeasurableSet F) :
    (cond fairCoin (AffineBlock.familyEvent old ∩ B.event))
        (π.observationMap ⁻¹' F ∩ noDropEvent B π) =
      (AffineBlock.finiteStageLaw old) (π.observationMap ⁻¹' F ∩ noDropEvent B π) := by
  have h := congrArg (fun μ : Measure Cantor => μ F)
    (nextStage_restrictedTranscriptLaw old B hold hnew π)
  simpa only [restrictedTranscriptLaw_apply _ _ _ hF] using h

end NoDrop

end Klr

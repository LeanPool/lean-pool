-- Modified for Lean Pool.

module

public import LeanPool.KLRandomness.Cantor
public import Mathlib.Computability.RE

/-!
# Effectively open classes

The effectiveness condition is Mathlib's `REPred`, i.e. the domain of a partial
recursive function. A single program on pairs `(n,s)` gives a uniformly
effectively open sequence; separate programs with no uniformity are insufficient.
-/

@[expose] public section

namespace Klr

open MeasureTheory

/-- The open class generated by a collection of finite binary strings. -/
def cylinderUnion (W : List Bool → Prop) : Set Cantor :=
  {X | ∃ s, W s ∧ X ∈ cylinder s}

theorem cylinderUnion_eq_iUnion (W : List Bool → Prop) :
    cylinderUnion W = ⋃ s, ⋃ (_ : W s), cylinder s := by
  ext X
  simp [cylinderUnion]

theorem isOpen_cylinderUnion (W : List Bool → Prop) : IsOpen (cylinderUnion W) := by
  rw [cylinderUnion_eq_iUnion]
  exact isOpen_iUnion fun s => isOpen_iUnion fun _ => isOpen_cylinder s

theorem measurableSet_cylinderUnion (W : List Bool → Prop) :
    MeasurableSet (cylinderUnion W) := by
  rw [cylinderUnion_eq_iUnion]
  exact MeasurableSet.iUnion fun s => MeasurableSet.iUnion fun _ => measurableSet_cylinder s

/-- A `Σ⁰₁` class: a union of cylinders from a computably enumerable set of strings. -/
def IsEffectivelyOpen (U : Set Cantor) : Prop :=
  ∃ W : List Bool → Prop, REPred W ∧ U = cylinderUnion W

theorem IsEffectivelyOpen.isOpen {U : Set Cantor} (hU : IsEffectivelyOpen U) :
    IsOpen U := by
  obtain ⟨W, _, rfl⟩ := hU
  exact isOpen_cylinderUnion W

theorem IsEffectivelyOpen.measurableSet {U : Set Cantor} (hU : IsEffectivelyOpen U) :
    MeasurableSet U := by
  obtain ⟨W, _, rfl⟩ := hU
  exact measurableSet_cylinderUnion W

/-- One c.e. predicate enumerates the cylinders of every level. -/
def IsUniformlyEffectivelyOpen (U : ℕ → Set Cantor) : Prop :=
  ∃ W : ℕ × List Bool → Prop, REPred W ∧
    ∀ n, U n = cylinderUnion (fun s => W (n, s))

theorem IsUniformlyEffectivelyOpen.level {U : ℕ → Set Cantor}
    (hU : IsUniformlyEffectivelyOpen U) (n : ℕ) : IsEffectivelyOpen (U n) := by
  obtain ⟨W, hW, hU⟩ := hU
  exact ⟨fun s => W (n, s), hW.comp ((Computable.const n).pair Computable.id), hU n⟩

/-- The c.e. predicate recognized by a program, using the standard encoding. -/
def programAccepts {α : Type*} [Primcodable α] (c : Nat.Partrec.Code) (a : α) : Prop :=
  (c.eval (Encodable.encode a)).Dom

theorem programAccepts_re {α : Type*} [Primcodable α] (c : Nat.Partrec.Code) :
    REPred (programAccepts (α := α) c) :=
  (Nat.Partrec.Code.eval_part.comp (Computable.const c) Computable.encode).dom_re

/-- Every c.e. predicate has a program recognizing exactly its members. -/
theorem exists_programAccepts {α : Type*} [Primcodable α] {W : α → Prop}
    (hW : REPred W) : ∃ c : Nat.Partrec.Code, ∀ a, programAccepts c a ↔ W a := by
  obtain ⟨c, hc⟩ := Nat.Partrec.Code.exists_code.mp hW
  refine ⟨c, fun a => ?_⟩
  simp [programAccepts, hc, Part.assert]

/-- The uniformly effectively open sequence enumerated by a single program. -/
def programOpen (c : Nat.Partrec.Code) (n : ℕ) : Set Cantor :=
  cylinderUnion (fun s => programAccepts c (n, s))

theorem programOpen_uniform (c : Nat.Partrec.Code) :
    IsUniformlyEffectivelyOpen (programOpen c) :=
  ⟨programAccepts c, programAccepts_re c, fun _ => rfl⟩

/-- Program codes represent every uniformly c.e. family, not just a selected subclass. -/
theorem isUniformlyEffectivelyOpen_iff_exists_program (U : ℕ → Set Cantor) :
    IsUniformlyEffectivelyOpen U ↔
      ∃ c : Nat.Partrec.Code, ∀ n, U n = programOpen c n := by
  constructor
  · rintro ⟨W, hW, hU⟩
    obtain ⟨c, hc⟩ := exists_programAccepts hW
    refine ⟨c, fun n => ?_⟩
    rw [hU n]
    ext X
    simp only [programOpen, cylinderUnion, Set.mem_ofPred_eq, hc]
  · rintro ⟨c, hU⟩
    exact ⟨programAccepts c, programAccepts_re c, hU⟩

end Klr

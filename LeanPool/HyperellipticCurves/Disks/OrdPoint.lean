-- Import paths adapted for Lean Pool; local option overrides removed.

public import LeanPool.HyperellipticCurves.Disks.CanonDeg

import LeanPool.HyperellipticCurves.ForMathlib.Finprod
import LeanPool.HyperellipticCurves.ForMathlib.Polynomial

/-!
# The order of `ω_bar` at a point of the residue curve, and the total budget

`ChabautyColeman.ordPoint` is the number `m_P_bar = ord_P_bar(ω_bar)` of blueprint `thm:disk-bound`,
for
`ω_bar = h_bar dx/y` on the residue curve: the point-ideal multiplicity of `h_bar` at an affine
point,
and `2g-2-2·deg h_bar` at infinity.

Its total over the curve is the point-sum of `ChabautyColeman.sum_ord_le` — that is
`ChabautyColeman.finsum_ordPoint`, which splits a sum over `ChabautyColeman.CurvePoint` into
the affine solutions of `y² = f(x)` and the term at infinity (via
`ChabautyColeman.CurvePoint.equivOption`). The residue field is *not* assumed finite: for
`h_bar ≠ 0` the order vanishes away from the roots of `h_bar`
(`ChabautyColeman.ordAffine_eq_zero`), so `ω_bar` has finitely many zeros
(`ChabautyColeman.finite_support_ordPoint`) and all the sums are genuine finite sums. Hence
the budget bounds the sum over *any* finite set of points
(`ChabautyColeman.sum_ordPoint_le`), which is the form in which blueprint `thm:main-count` sums
the per-disk bounds.

By the two charts the order is the root multiplicity of `h_bar` at a generic point and twice it
at a Weierstrass point (`ChabautyColeman.ordAffine_generic`,
`ChabautyColeman.ordAffine_weierstrass`), hence monotone in that multiplicity
(`ChabautyColeman.ordAffine_le_ordAffine`). Leaving the point at infinity out of the sum
gives the affine budget `2·deg h_bar` (`ChabautyColeman.sum_ordPoint_le_two_mul_natDegree`) —
the form in which `LeanPool.HyperellipticCurves.Disks.OrdSpace` lets each point pick its own
differential.

Blueprint node: `cor:sum-ord`.
-/

@[expose] public section

open Polynomial

namespace ChabautyColeman

variable {κ : Type*} [Field κ] {f : κ[X]}

/-- The order of `ω_bar = h_bar dx/y` at the affine point `(x, y)`: the multiplicity of the point
ideal in `(h_bar)`. Total in `x`, `y` — the curve equation is not needed to state it. -/
noncomputable def ordAffine (f h : κ[X]) (x y : κ) : ℕ :=
  (emultiplicity (pointIdeal f x y) (Ideal.span {algebraMap κ[X] (HypRing κ f) h})).toNat

/-- The order of `ω_bar = h_bar dx/y` at infinity: `ord_∞(h_bar) + (2g-2) = 2g-2-2·deg h_bar`. -/
def ordInf (f h : κ[X]) : ℕ := 2 * (genus f - 1) - 2 * h.natDegree

/-- **The order `m_P_bar` of `ω_bar = h_bar dx/y` at a point of the residue curve** (blueprint
`thm:disk-bound`), by the two charts. The order of the disk expansion at `P_bar`, which is what
the per-disk bound counts with, is the same number — blueprint `lem:ord-match`. -/
noncomputable def ordPoint (f h : κ[X]) : CurvePoint κ f → ℕ
  | .affine x y _ => ordAffine f h x y
  | .infinity => ordInf f h

theorem ordAffine_eq (f h : κ[X]) (x y : κ) :
    ordAffine f h x y
      = (emultiplicity (pointIdeal f x y)
          (Ideal.span {algebraMap κ[X] (HypRing κ f) h})).toNat :=
  rfl

theorem ordInf_eq (f h : κ[X]) : ordInf f h = 2 * (genus f - 1) - 2 * h.natDegree := rfl

@[simp] theorem ordPoint_affine (f h : κ[X]) (x y : κ) (hxy : y ^ 2 = f.eval x) :
    ordPoint f h (.affine x y hxy) = ordAffine f h x y := rfl

@[simp] theorem ordPoint_infinity (f h : κ[X]) :
    ordPoint f h (.infinity : CurvePoint κ f) = ordInf f h := rfl

variable {h : κ[X]} [NeZero (2 : κ)] [Fact (Odd f.natDegree)] [Fact (Squarefree f)]

/-- Away from the roots of `h_bar` the differential `ω_bar = h_bar dx/y` has no zero. -/
theorem ordAffine_eq_zero {x₀ y₀ : κ} (hb : y₀ ^ 2 = f.eval x₀) (hx : h.eval x₀ ≠ 0) :
    ordAffine f h x₀ y₀ = 0 := by
  rw [ordAffine_eq, emultiplicity_pointIdeal_eq_zero hb hx]
  rfl

/-- **At a generic affine point the order of `ω_bar = h_bar dx/y` is the root multiplicity of
`h_bar`** — the point ideal is generated by `x - x₀` there. -/
theorem ordAffine_generic {x₀ y₀ : κ} (hb : y₀ ^ 2 = f.eval x₀) (hy : y₀ ≠ 0) (hh : h ≠ 0) :
    ordAffine f h x₀ y₀ = rootMultiplicity x₀ h := by
  rw [ordAffine_eq, emultiplicity_pointIdeal_generic hb hy hh]
  rfl

/-- **At a Weierstrass point the order of `ω_bar = h_bar dx/y` is twice the root multiplicity**:
there `x - x₀` has a double zero. -/
theorem ordAffine_weierstrass {x₀ : κ} (hb : (0 : κ) ^ 2 = f.eval x₀) (hh : h ≠ 0) :
    ordAffine f h x₀ 0 = 2 * rootMultiplicity x₀ h := by
  rw [ordAffine_eq, emultiplicity_pointIdeal_weierstrass hb hh, nsmul_eq_mul]
  simp [mul_comm]

/-- The order of `ω_bar = h_bar dx/y` at an affine point is monotone in the root multiplicity of
`h_bar` — by `ordAffine_generic` and `ordAffine_weierstrass` it is the multiplicity or twice it. -/
theorem ordAffine_le_ordAffine {x₀ y₀ : κ} (hb : y₀ ^ 2 = f.eval x₀) {h' : κ[X]} (hh : h ≠ 0)
    (hh' : h' ≠ 0) (hle : rootMultiplicity x₀ h ≤ rootMultiplicity x₀ h') :
    ordAffine f h x₀ y₀ ≤ ordAffine f h' x₀ y₀ := by
  rcases eq_or_ne y₀ 0 with rfl | hy
  · rw [ordAffine_weierstrass hb hh, ordAffine_weierstrass hb hh']
    lia
  · rw [ordAffine_generic hb hy hh, ordAffine_generic hb hy hh']
    exact hle

/-- The affine points of nonzero order lie above the roots of `h_bar`, and each `x`-fiber is
finite, so there are finitely many of them. -/
theorem finite_setOf_ordAffine_ne_zero (hh : h ≠ 0) :
    {p : κ × κ | p.2 ^ 2 = f.eval p.1 ∧ ordAffine f h p.1 p.2 ≠ 0}.Finite := by
  classical
  refine Set.Finite.subset (Set.Finite.biUnion h.roots.toFinset.finite_toSet
    fun x _ ↦ (finite_setOf_pow_eq two_pos (f.eval x)).image (Prod.mk x)) fun p hp ↦ ?_
  refine Set.mem_biUnion (Finset.mem_coe.mpr (Multiset.mem_toFinset.mpr ?_)) ⟨p.2, hp.1, rfl⟩
  exact (mem_roots hh).mpr (by_contra fun hx ↦ hp.2 (ordAffine_eq_zero hp.1 hx))

/-- The same finiteness on the subtype of affine curve points — the form in which the
point-sum below splits off the term at infinity. -/
theorem finite_support_ordAffine (hh : h ≠ 0) :
    (Function.support fun p : {p : κ × κ // p.2 ^ 2 = f.eval p.1} ↦
      ordAffine f h p.1.1 p.1.2).Finite :=
  Set.Finite.subset (Set.Finite.preimage Subtype.val_injective.injOn
    (finite_setOf_ordAffine_ne_zero hh)) fun p hp ↦ ⟨p.2, hp⟩

/-- **`ω_bar = h_bar dx/y` has finitely many zeros**, so the point-sums below are genuine finite
sums over any residue field. -/
theorem finite_support_ordPoint (hh : h ≠ 0) :
    (Function.support (ordPoint f h)).Finite := by
  refine Set.Finite.subset (((finite_support_ordAffine hh).image
    fun p ↦ CurvePoint.affine p.1.1 p.1.2 p.2).insert CurvePoint.infinity) fun P hP ↦ ?_
  cases P with
  | infinity => exact Set.mem_insert _ _
  | affine x y hxy => exact Set.mem_insert_of_mem _ ⟨⟨(x, y), hxy⟩, hP, rfl⟩

/-- Summing `ord_P_bar(ω_bar)` over the curve is summing over the affine solutions of `y² = f(x)`
and adding the term at infinity. -/
theorem finsum_ordPoint (hh : h ≠ 0) :
    ∑ᶠ P : CurvePoint κ f, ordPoint f h P
      = (∑ᶠ x₀ : κ, ∑ᶠ y₀ ∈ {y : κ | y ^ 2 = f.eval x₀}, ordAffine f h x₀ y₀)
        + ordInf f h := by
  have hAsupp : Function.HasFiniteSupport
      ((fun o : Option {p : κ × κ // p.2 ^ 2 = f.eval p.1} ↦
        ordPoint f h (CurvePoint.equivOption.symm o)) ∘ some) := finite_support_ordAffine hh
  rw [← finsum_comp_equiv (CurvePoint.equivOption (f := f)).symm, finsum_option hAsupp, add_comm]
  congr 1
  refine (finsum_subtype_eq_finsum_cond (f := fun p : κ × κ ↦ ordAffine f h p.1 p.2) _).trans
    (finsum_mem_curry (fun x ↦ {y : κ | y ^ 2 = f.eval x}) (ordAffine f h) ?_)
  exact finite_setOf_ordAffine_ne_zero hh

/-- A sum over a finite set of points is at most the total over the curve. -/
theorem sum_ordPoint_le_finsum (hh : h ≠ 0) (T : Finset (CurvePoint κ f)) :
    ∑ P ∈ T, ordPoint f h P ≤ ∑ᶠ P : CurvePoint κ f, ordPoint f h P := by
  classical
  exact le_of_le_of_eq (Finset.sum_le_sum_of_subset Finset.subset_union_right)
    (finsum_eq_finsetSum_of_support_subset (s := (finite_support_ordPoint hh).toFinset ∪ T) _
      (by simp)).symm

/-- **The affine vanishing budget**: over a finite set of points *not containing infinity*,
the orders of `ω_bar = h_bar dx/y` sum to at most `2·deg h_bar`. Adding back the point at infinity
gives `ChabautyColeman.sum_ordPoint_le`; keeping it out is what leaves room for the term at
infinity of a *different* differential. -/
theorem sum_ordPoint_le_two_mul_natDegree (T : Finset (CurvePoint κ f)) (hh : h ≠ 0)
    (hT : CurvePoint.infinity ∉ T) :
    ∑ P ∈ T, ordPoint f h P ≤ 2 * h.natDegree := by
  classical
  have hle : ordInf f h + ∑ P ∈ T, ordPoint f h P ≤ 2 * h.natDegree + ordInf f h := by
    calc ordInf f h + ∑ P ∈ T, ordPoint f h P
        = ∑ P ∈ insert CurvePoint.infinity T, ordPoint f h P := by
          rw [Finset.sum_insert hT, ordPoint_infinity]
      _ ≤ ∑ᶠ P : CurvePoint κ f, ordPoint f h P := sum_ordPoint_le_finsum hh _
      _ = (∑ᶠ x₀ : κ, ∑ᶠ y₀ ∈ {y : κ | y ^ 2 = f.eval x₀}, ordAffine f h x₀ y₀) + ordInf f h :=
          finsum_ordPoint hh
      _ ≤ 2 * h.natDegree + ordInf f h := by gcongr; exact finsum_fiber_sum_le hh
  lia

/-- **Total vanishing budget over the points of the curve** (`cor:sum-ord`):
`∑_P_bar ord_P_bar(ω_bar) ≤ 2g-2`. -/
theorem finsum_ordPoint_le (hh : h ≠ 0) (hdeg : h.natDegree ≤ genus f - 1) :
    ∑ᶠ P : CurvePoint κ f, ordPoint f h P ≤ 2 * genus f - 2 :=
  (finsum_ordPoint hh).le.trans (sum_ord_le hh hdeg)

/-- The vanishing budget bounds the sum over any finite set of points. This is the classical
`2g - 2`; blueprint `thm:main-count` sums the sharper per-point budget of
`ChabautyColeman.sum_ordSpace_le`, of which this is the case `r = g - 1`. -/
theorem sum_ordPoint_le (T : Finset (CurvePoint κ f)) (hh : h ≠ 0)
    (hdeg : h.natDegree ≤ genus f - 1) :
    ∑ P ∈ T, ordPoint f h P ≤ 2 * genus f - 2 :=
  (sum_ordPoint_le_finsum hh T).trans (finsum_ordPoint_le hh hdeg)

end ChabautyColeman

end

import Mathlib.RingTheory.AdjoinRoot
import Mathlib.RingTheory.Henselian

/-!
# The disk chart around a Mumford datum (blueprint `def:chart`)

Chart coordinates near a degree-`n` Mumford datum `(u, v)` on `y² = f(x)`: the `n`
coefficients of `u' - u` become the variables of `O'' := MvPowerSeries (Fin n) O`, the
perturbed `u`-polynomial is `ChabautyColeman.chartU`, and the chart square root is a
`V ∈ O''[x]` of degree `< n` with `chartU u n ∣ V² - f` and center `V(0) = v`
(`ChabautyColeman.exists_chartV`; packaged as `ChabautyColeman.chartV`). The chart point of
`X` is then the Mumford datum `(chartU, chartV)`.

The construction is a **single quadratic Hensel root**: `T² = f` in
`AdjoinRoot (chartU u n)`, a finite free `O''`-algebra, which is Henselian with respect to
the ideal extended from `(X₁, …, Xₙ)` — Mathlib's `(X)`-adic completeness of
`MvPowerSeries` transferred along the power basis (`Module.Basis.isAdicComplete`,
`IsAdicComplete.map_algebraMap_iff`). Consequently **no topology or completeness on `O` is
needed**; in certificate-passing style the inputs are the cofactor identity
`v² - f = u·w` and a Bézout certificate `c₁·u + c₂·(2v) = 1` (the Jacobian unit; over a
local ring it is produced from good position by
`ChabautyColeman.GoodPosition.isCoprime_two_mul_right` and
`ChabautyColeman.exists_bezout_lift`-style Nakayama lifting).
-/

@[expose] public section

open Polynomial

section Chart

namespace MvPowerSeries

/-- Taking constant coefficients kills the ideal generated by the variables. -/
theorem map_constantCoeff_span_range_X {σ R : Type*} [CommRing R] :
    Ideal.map (constantCoeff : MvPowerSeries σ R →+* R)
      (Ideal.span (Set.range (X : σ → MvPowerSeries σ R))) = ⊥ := by
  rw [Ideal.map_span]
  refine le_bot_iff.mp (Ideal.span_le.mpr ?_)
  rintro x ⟨y, ⟨i, rfl⟩, rfl⟩
  simp [constantCoeff_X]

end MvPowerSeries

namespace ChabautyColeman

variable {O : Type*} [CommRing O] {n : ℕ}

/-- The perturbed `u`-polynomial of the chart. -/
noncomputable def chartU (u : O[X]) (n : ℕ) : Polynomial (MvPowerSeries (Fin n) O) :=
  u.map (MvPowerSeries.C : O →+* MvPowerSeries (Fin n) O)
    + ∑ i : Fin n, Polynomial.C (MvPowerSeries.X i) * Polynomial.X ^ (i : ℕ)

theorem chartU_map_constantCoeff {u : O[X]} :
    (chartU u n).map (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) O →+* O) = u := by
  rw [chartU, Polynomial.map_add, Polynomial.map_map, MvPowerSeries.constantCoeff_comp_C,
    Polynomial.map_id, Polynomial.map_sum]
  simp [MvPowerSeries.constantCoeff_X]

/-- The `i`-th coefficient of the chart datum after base change: the `u`-coefficient plus
the image of the `i`-th coordinate. -/
theorem coeff_map_chartU {S : Type*} [CommRing S] (ρ : MvPowerSeries (Fin n) O →+* S)
    {χ : O →+* S} (hχ : ρ.comp MvPowerSeries.C = χ) (u : O[X]) (i : Fin n) :
    ((chartU u n).map ρ).coeff (i : ℕ) = (u.map χ).coeff (i : ℕ) + ρ (MvPowerSeries.X i) := by
  rw [chartU, Polynomial.coeff_map_add_sum_C_mul_X_pow, Polynomial.map_map, hχ]

/-- The ideal of the chart algebra generated by the chart coordinates: the algebra is
Henselian along it, and reducing modulo it is taking constant coefficients. -/
private noncomputable def chartIdeal (u : O[X]) (n : ℕ) :
    Ideal (AdjoinRoot (chartU u n)) :=
  (Ideal.span (Set.range MvPowerSeries.X)).map
    (algebraMap (MvPowerSeries (Fin n) O) (AdjoinRoot (chartU u n)))

private theorem mk_map_C_mem_chartIdeal {u : O[X]} :
    AdjoinRoot.mk (chartU u n) (u.map (MvPowerSeries.C : O →+* MvPowerSeries (Fin n) O))
      ∈ chartIdeal u n := by
  have h0 : AdjoinRoot.mk (chartU u n)
        (u.map (MvPowerSeries.C : O →+* MvPowerSeries (Fin n) O))
      + AdjoinRoot.mk (chartU u n)
        (∑ i : Fin n, Polynomial.C (MvPowerSeries.X i) * Polynomial.X ^ (i : ℕ)) = 0 := by
    rw [← map_add]
    exact AdjoinRoot.mk_self
  rw [eq_neg_of_add_eq_zero_left h0, map_sum]
  refine neg_mem (Submodule.sum_mem _ fun i _ ↦ ?_)
  rw [map_mul, AdjoinRoot.mk_C, ← AdjoinRoot.algebraMap_eq]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩))

variable [Nontrivial O]

theorem degree_perturb_lt {u : O[X]} (hu : u.Monic) (hn : n ≤ u.natDegree) :
    (∑ i : Fin n, Polynomial.C (MvPowerSeries.X (R := O) i) * Polynomial.X ^ (i : ℕ)).degree
      < (u.map (MvPowerSeries.C : O →+* MvPowerSeries (Fin n) O)).degree := by
  have hmap : (u.map (MvPowerSeries.C : O →+* MvPowerSeries (Fin n) O)).degree
      = (u.natDegree : WithBot ℕ) := by
    rw [degree_map_eq_of_leadingCoeff_ne_zero _ (by rw [hu.leadingCoeff]; exact one_ne_zero),
      degree_eq_natDegree hu.ne_zero]
  rw [hmap]
  refine (degree_sum_le _ _).trans_lt ((Finset.sup_lt_iff (WithBot.bot_lt_coe _)).mpr fun i _ ↦ ?_)
  exact (degree_C_mul_X_pow_le _ _).trans_lt (Nat.cast_lt.mpr (lt_of_lt_of_le i.2 hn))

theorem chartU_monic {u : O[X]} (hu : u.Monic) (hn : n ≤ u.natDegree) :
    (chartU u n).Monic :=
  (hu.map _).add_of_left (degree_perturb_lt hu hn)

theorem chartU_degree {u : O[X]} (hu : u.Monic) (hn : n ≤ u.natDegree) :
    (chartU u n).degree = u.degree := by
  rw [chartU, degree_add_eq_left_of_degree_lt (degree_perturb_lt hu hn),
    degree_map_eq_of_leadingCoeff_ne_zero _ (by rw [hu.leadingCoeff]; exact one_ne_zero)]

/-- The chart algebra is Henselian along the ideal of the chart coordinates: it is a finite
free module over `MvPowerSeries (Fin n) O`, which is `(X)`-adically complete. -/
private theorem henselianRing_chartIdeal {u : O[X]} (hu : u.Monic) (hn : n ≤ u.natDegree) :
    HenselianRing (AdjoinRoot (chartU u n)) (chartIdeal u n) := by
  have hAC : IsAdicComplete (Ideal.span (Set.range MvPowerSeries.X))
      (AdjoinRoot (chartU u n)) :=
    (AdjoinRoot.powerBasis' (chartU_monic hu hn)).basis.isAdicComplete
  have : IsAdicComplete (chartIdeal u n) (AdjoinRoot (chartU u n)) :=
    (IsAdicComplete.map_algebraMap_iff _ _).mpr hAC
  exact IsAdicComplete.henselianRing _ _

/-- **Reduction modulo the chart ideal is taking constant coefficients**: a reduced
polynomial congruent to `v` in the chart algebra has constant coefficients `v`. -/
private theorem map_constantCoeff_modByMonic_eq {u v : O[X]} (hu : u.Monic)
    (hn : n ≤ u.natDegree) (hv : v.degree < u.degree)
    (p : Polynomial (MvPowerSeries (Fin n) O))
    (hp : AdjoinRoot.mk (chartU u n) (p %ₘ chartU u n)
        - AdjoinRoot.mk (chartU u n)
          (v.map (MvPowerSeries.C : O →+* MvPowerSeries (Fin n) O)) ∈ chartIdeal u n) :
    (p %ₘ chartU u n).map (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) O →+* O)
      = v := by
  set ε : MvPowerSeries (Fin n) O →+* O := MvPowerSeries.constantCoeff with hε
  set U := chartU u n with hU
  have hUmonic : U.Monic := chartU_monic hu hn
  -- the congruence lifts to a decomposition over the chart algebra
  have hIψ : chartIdeal u n = (((Ideal.span (Set.range MvPowerSeries.X)).map
      (Polynomial.C : MvPowerSeries (Fin n) O →+* Polynomial (MvPowerSeries (Fin n) O))).map
        (AdjoinRoot.mk U)) := by
    rw [chartIdeal, Ideal.map_map]
    congr 1
  rw [hIψ, ← map_sub] at hp
  obtain ⟨y, hy, hyeq⟩ :=
    (Ideal.mem_map_iff_of_surjective _ AdjoinRoot.mk_surjective).mp hp
  obtain ⟨q, hq⟩ : U ∣ p %ₘ U - v.map MvPowerSeries.C - y := by
    rw [← AdjoinRoot.mk_eq_zero (f := U), map_sub, hyeq, map_sub]
    ring
  -- reduce the decomposition coefficientwise
  have hεφ (r : O[X]) : (r.map (MvPowerSeries.C : O →+* MvPowerSeries (Fin n) O)).map ε = r := by
    rw [Polynomial.map_map, hε, MvPowerSeries.constantCoeff_comp_C, Polynomial.map_id]
  have hεy : y.map ε = 0 := by
    have hymem : (Polynomial.mapRingHom ε) y ∈ ((Ideal.span (Set.range MvPowerSeries.X)).map
        (Polynomial.C : MvPowerSeries (Fin n) O →+* Polynomial (MvPowerSeries (Fin n) O))).map
          (Polynomial.mapRingHom ε) := Ideal.mem_map_of_mem _ hy
    have hcomp : (Polynomial.mapRingHom ε).comp (Polynomial.C :
        MvPowerSeries (Fin n) O →+* Polynomial (MvPowerSeries (Fin n) O))
        = (Polynomial.C : O →+* O[X]).comp ε := by
      ext s
      simp
    rw [Ideal.map_map, hcomp, ← Ideal.map_map, hε,
      MvPowerSeries.map_constantCoeff_span_range_X, Ideal.map_bot] at hymem
    simpa using hymem
  have happ := congrArg (Polynomial.map ε) hq
  rw [Polynomial.map_sub, Polynomial.map_sub, hεy, sub_zero, Polynomial.map_mul, hεφ v, hU,
    chartU_map_constantCoeff] at happ
  -- the quotient must vanish for degree reasons
  have hdeg2 : ((p %ₘ U).map ε - v).degree < u.degree :=
    (degree_sub_le _ _).trans_lt (max_lt
      (degree_map_le.trans_lt ((degree_modByMonic_lt p hUmonic).trans_eq
        (chartU_degree hu hn))) hv)
  have hq0 : q.map ε = 0 := by
    by_contra hq0
    have hge : u.degree ≤ (u * q.map ε).degree := by
      rw [mul_comm, hu.degree_mul]
      exact le_add_of_nonneg_left (zero_le_degree_iff.mpr hq0)
    rw [← happ] at hge
    exact absurd (hdeg2.trans_le hge) (lt_irrefl _)
  rw [hq0, mul_zero] at happ
  exact sub_eq_zero.mp happ

/-- **Existence of the chart square root** (blueprint `def:chart`): a single quadratic
Hensel root over the chart algebra. -/
theorem exists_chartV {f u v w c₁ c₂ : O[X]} (hu : u.Monic) (hn : n ≤ u.natDegree)
    (hv : v.degree < u.degree) (hw : v ^ 2 - f = u * w)
    (hbez : c₁ * u + c₂ * (2 * v) = 1) :
    ∃ V : Polynomial (MvPowerSeries (Fin n) O),
      V.degree < u.degree ∧
      chartU u n ∣ V ^ 2 - f.map (MvPowerSeries.C : O →+* MvPowerSeries (Fin n) O) ∧
      V.map (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) O →+* O) = v := by
  set φ : O →+* MvPowerSeries (Fin n) O := MvPowerSeries.C
  set U := chartU u n
  have hUmonic : U.Monic := chartU_monic hu hn
  set ψ : Polynomial (MvPowerSeries (Fin n) O) →+* AdjoinRoot U := AdjoinRoot.mk U with hψ
  have hψΦu : ψ (u.map φ) ∈ chartIdeal u n := mk_map_C_mem_chartIdeal
  -- the quadratic and its approximate root
  set g : Polynomial (AdjoinRoot U) := Polynomial.X ^ 2 - Polynomial.C (ψ (f.map φ)) with hg
  have heval : g.eval (ψ (v.map φ)) ∈ chartIdeal u n := by
    have hev : g.eval (ψ (v.map φ)) = ψ (u.map φ) * ψ (w.map φ) := by
      rw [hg, eval_sub, eval_pow, eval_X, eval_C, ← map_pow, ← Polynomial.map_pow, ← map_sub,
        ← Polynomial.map_sub, hw, Polynomial.map_mul, map_mul]
    rw [hev]
    exact Ideal.mul_mem_right _ _ hψΦu
  have hderiv : IsUnit (Ideal.Quotient.mk (chartIdeal u n)
      (g.derivative.eval (ψ (v.map φ)))) := by
    have hde : g.derivative.eval (ψ (v.map φ)) = ψ ((2 * v).map φ) := by
      rw [hg, derivative_sub, derivative_C, sub_zero, derivative_X_pow, Polynomial.map_mul,
        map_mul]
      simp [map_ofNat]
    rw [hde]
    refine IsUnit.of_mul_eq_one (Ideal.Quotient.mk (chartIdeal u n) (ψ (c₂.map φ))) ?_
    have hb := congrArg (fun q ↦ Ideal.Quotient.mk (chartIdeal u n) (ψ (q.map φ))) hbez
    simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_one, map_add, map_mul,
      map_one] at hb
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hψΦu, mul_zero, zero_add] at hb
    rw [Polynomial.map_mul, map_mul, map_mul]
    linear_combination hb
  -- the Hensel root, and its reduced representative
  have := henselianRing_chartIdeal hu hn
  obtain ⟨z, hz1, hz2⟩ :=
    HenselianRing.is_henselian g (monic_X_pow_sub_C _ two_ne_zero) (ψ (v.map φ)) heval hderiv
  obtain ⟨p, hp⟩ := AdjoinRoot.mk_surjective z
  have hmk : ψ (p %ₘ U) = z := by
    rw [← hp, hψ, AdjoinRoot.mk_eq_mk]
    exact dvd_modByMonic_sub p U
  refine ⟨p %ₘ U, (degree_modByMonic_lt p hUmonic).trans_eq (chartU_degree hu hn), ?_,
    map_constantCoeff_modByMonic_eq hu hn hv p (hmk ▸ hz2)⟩
  rw [← AdjoinRoot.mk_eq_zero (f := U), map_sub, map_pow, hmk]
  rwa [IsRoot, hg, eval_sub, eval_pow, eval_X, eval_C] at hz1

/-- The chart square root `V(X)` (blueprint `def:chart`): the polynomial over
`MvPowerSeries (Fin n) O` of degree `< deg u` with `chartU u n ∣ V² - f` and center
`V(0) = v`, obtained by Hensel's lemma from the certificates. -/
noncomputable def chartV {f u v w c₁ c₂ : O[X]} (hu : u.Monic) (hn : n ≤ u.natDegree)
    (hv : v.degree < u.degree) (hw : v ^ 2 - f = u * w)
    (hbez : c₁ * u + c₂ * (2 * v) = 1) : Polynomial (MvPowerSeries (Fin n) O) :=
  (exists_chartV hu hn hv hw hbez).choose

theorem chartV_degree_lt {f u v w c₁ c₂ : O[X]} (hu : u.Monic) (hn : n ≤ u.natDegree)
    (hv : v.degree < u.degree) (hw : v ^ 2 - f = u * w)
    (hbez : c₁ * u + c₂ * (2 * v) = 1) :
    (chartV hu hn hv hw hbez).degree < u.degree :=
  (exists_chartV hu hn hv hw hbez).choose_spec.1

theorem chartU_dvd_chartV_sq_sub {f u v w c₁ c₂ : O[X]} (hu : u.Monic)
    (hn : n ≤ u.natDegree) (hv : v.degree < u.degree) (hw : v ^ 2 - f = u * w)
    (hbez : c₁ * u + c₂ * (2 * v) = 1) :
    chartU u n ∣ chartV hu hn hv hw hbez ^ 2
      - f.map (MvPowerSeries.C : O →+* MvPowerSeries (Fin n) O) :=
  (exists_chartV hu hn hv hw hbez).choose_spec.2.1

/-- The chart datum stays a square root of `f` under any base change: `χ` is the induced
map on constants. -/
theorem chartU_map_dvd_chartV_map_sq_sub {f u v w c₁ c₂ : O[X]} (hu : u.Monic)
    (hn : n ≤ u.natDegree) (hv : v.degree < u.degree) (hw : v ^ 2 - f = u * w)
    (hbez : c₁ * u + c₂ * (2 * v) = 1) {S : Type*} [CommRing S]
    {φ : MvPowerSeries (Fin n) O →+* S} {χ : O →+* S}
    (hφ : φ.comp MvPowerSeries.C = χ) :
    (chartU u n).map φ ∣ ((chartV hu hn hv hw hbez).map φ) ^ 2 - f.map χ := by
  have h := Polynomial.map_dvd φ (chartU_dvd_chartV_sq_sub hu hn hv hw hbez)
  rwa [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_map, hφ] at h

/-- The center of the chart: `V(0) = v`. -/
theorem chartV_map_constantCoeff {f u v w c₁ c₂ : O[X]} (hu : u.Monic)
    (hn : n ≤ u.natDegree) (hv : v.degree < u.degree) (hw : v ^ 2 - f = u * w)
    (hbez : c₁ * u + c₂ * (2 * v) = 1) :
    (chartV hu hn hv hw hbez).map
      (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) O →+* O) = v :=
  (exists_chartV hu hn hv hw hbez).choose_spec.2.2

end ChabautyColeman

end Chart

end

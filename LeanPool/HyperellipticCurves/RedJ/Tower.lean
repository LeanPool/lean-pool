/-!
# The reduction homomorphism on the Jacobian: setting and bookkeeping

This file sets up the tower of finite extensions over which the reduction map on the
Jacobian (`def:redJ`) is assembled: for a complete DVR `O` with algebraically closed residue
field and fraction field `K` of characteristic `0`, the finite extensions of `K` are the
finite-dimensional `L : IntermediateField K (AlgebraicClosure K)`; the integral closure of
`O` in each is a complete DVR with the *same* residue field
(`LeanPool.HyperellipticCurves.RedJ.DVRExtensionResidue`).

Here we provide the instances making the disk machinery run over each such `L` (algebra
structures, the DVR properties of the integral closures, and the transport of the
`Fact`-instances on `f` along all the base changes), and the polynomial index equalities
used to glue the levels — together with the two notions the reduction map is assembled
from and the existence results feeding it.

## Main definitions

* `ChabautyColeman.SplitSupported`: an ideal whose nonzero prime divisors are all maximal
  ideals of rational points — the condition making a reduction stable under further base
  change;
* `ChabautyColeman.redIdealBar`: the reduction of an ideal over `L` to the *fixed* residue
  curve of `O`, obtained by running `ChabautyColeman.redIdeal` over the integral closure
  `O_L` and identifying the residue fields (`ChabautyColeman.toClosureIndex`,
  `ChabautyColeman.fromClosureResidue`).

## Main statements

* `ChabautyColeman.splitSupported_mumfordIdeal`: Mumford ideals with split `u` are
  split-supported;
* `ChabautyColeman.exists_finset_maxPowDividing`: the height-one factorization of a nonzero
  ideal;
* `ChabautyColeman.finiteDimensional_adjoin_rootSet`, `splits_map_adjoin_rootSet`: the field
  generated by the roots of `u` is finite over `K` and splits `u`;
* `ChabautyColeman.exists_intermediateField_splits`: existence of a splitting tower, with
  square `g`-values at all roots.
-/

@[expose] public section

open Polynomial IsLocalRing

namespace ChabautyColeman

/-! ### Squarefreeness under base change -/

/-- Squarefreeness of polynomials over a perfect field is preserved by any field embedding
(via separability). -/
theorem squarefree_map_of_perfectField {F F' : Type*} [Field F] [Field F'] [PerfectField F]
    (φ : F →+* F') {p : F[X]} (hp : Squarefree p) : Squarefree (p.map φ) :=
  ((PerfectField.separable_iff_squarefree.mpr hp).map).squarefree

instance instFactSquarefreeMap {F F' : Type*} [Field F] [Field F'] [Algebra F F']
    [PerfectField F] {p : F[X]} [hp : Fact (Squarefree p)] :
    Fact (Squarefree (p.map (algebraMap F F'))) :=
  ⟨squarefree_map_of_perfectField _ hp.out⟩

/-! ### The tower of finite extensions and their integral closures -/

section TowerAlgebra

variable (O : Type*) [CommRing O] {K : Type*} [Field K] [Algebra O K]

/-- The `O`-algebra structure on an intermediate field of the algebraic closure of the
fraction field. The priority is low so that it can never shadow the canonical
`Algebra K L` instance (with which it is not definitionally compatible at `O = K`). -/
noncomputable instance (priority := 50) instAlgebraIntermediateField
    (L : IntermediateField K (AlgebraicClosure K)) : Algebra O L :=
  ((algebraMap K L).comp (algebraMap O K)).toAlgebra

instance instIsScalarTowerIntermediateField (L : IntermediateField K (AlgebraicClosure K)) :
    IsScalarTower O K L :=
  .of_algebraMap_eq fun _ ↦ rfl

end TowerAlgebra

section TowerClosure

universe u

variable (O : Type u) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
  [IsAdicComplete (maximalIdeal O) O]
  {K : Type u} [Field K] [Algebra O K] [IsFractionRing O K] [CharZero K]
  (L : IntermediateField K (AlgebraicClosure K)) [FiniteDimensional K L]

instance instIsLocalRingIntegralClosure : IsLocalRing (integralClosure O L) :=
  integralClosure_isLocalRing O K L

instance instIsDVRIntegralClosure : IsDiscreteValuationRing (integralClosure O L) :=
  integralClosure_isDiscreteValuationRing O K L

instance instIsFractionRingIntegralClosure : IsFractionRing (integralClosure O L) L :=
  integralClosure.isFractionRing_of_finite_extension K L

instance instIsAlgClosedResidueIntegralClosure [IsAlgClosed (ResidueField O)] :
    IsAlgClosed (ResidueField (integralClosure O L)) :=
  isAlgClosed_residueField_integralClosure O L

instance instNeZeroTwoResidueIntegralClosure [IsAlgClosed (ResidueField O)]
    [NeZero (2 : ResidueField O)] :
    NeZero (2 : ResidueField (integralClosure O L)) :=
  neZero_two_residueField_integralClosure O L

/-- The residue field of `O_L` as an algebra over the fixed residue field of `O`, via the
inverse of the canonical identification. -/
noncomputable instance instAlgebraResidueIntegralClosure [IsAlgClosed (ResidueField O)] :
    Algebra (ResidueField (integralClosure O L)) (ResidueField O) :=
  ((integralClosureResidueEquiv O L).symm :
    ResidueField (integralClosure O L) →+* ResidueField O).toAlgebra

end TowerClosure

/-! ### Polynomial index equalities and transported `Fact`s -/

section IndexBase

variable {O : Type*} [CommRing O] {K : Type*} [Field K] [Algebra O K]
  (f : O[X]) (L : IntermediateField K (AlgebraicClosure K))

/-- The base change of `f` to `L` through `K` agrees with the one through the integral
closure `O_L`. -/
theorem map_algebraMap_integralClosure_eq :
    (f.map (algebraMap O K)).map (algebraMap K L)
      = (f.map (algebraMap O (integralClosure O L))).map
          (algebraMap (integralClosure O L) L) := by
  rw [map_map, map_map, ← IsScalarTower.algebraMap_eq, ← IsScalarTower.algebraMap_eq]

instance instFactOddIntegralClosureFraction
    [Fact (Odd (f.map (algebraMap O K)).natDegree)] :
    Fact (Odd ((f.map (algebraMap O (integralClosure O L))).map
      (algebraMap (integralClosure O L) L)).natDegree) := by
  refine ⟨?_⟩
  rw [← map_algebraMap_integralClosure_eq f L, natDegree_map]
  exact Fact.out

instance instFactSquarefreeIntegralClosureFraction [CharZero K]
    [Fact (Squarefree (f.map (algebraMap O K)))] :
    Fact (Squarefree ((f.map (algebraMap O (integralClosure O L))).map
      (algebraMap (integralClosure O L) L))) :=
  ⟨map_algebraMap_integralClosure_eq f L ▸
    squarefree_map_of_perfectField _ (Fact.out : Squarefree (f.map (algebraMap O K)))⟩

/-- On the curve `y² = f(x)`, the second coordinate of an integral point is integral. -/
theorem isIntegral_of_curve {x y : L}
    (hxy : y ^ 2 = ((f.map (algebraMap O K)).map (algebraMap K L)).eval x)
    (hx : IsIntegral O x) : IsIntegral O y := by
  refine IsIntegral.of_pow two_pos ?_
  rw [hxy, map_map, ← IsScalarTower.algebraMap_eq, eval_map_algebraMap]
  exact Algebra.adjoin_le
    (Set.singleton_subset_iff.mpr (show x ∈ integralClosure O L from hx))
    (Polynomial.aeval_mem_adjoin_singleton _ _)

/-- Change of polynomial index: the coordinate ring over `L` of the base change of `f`
through `K` maps to the one through `O_L` (identical components). -/
noncomputable def toClosureIndex :
    HypRing L ((f.map (algebraMap O K)).map (algebraMap K L)) →+*
      HypRing L ((f.map (algebraMap O (integralClosure O L))).map
        (algebraMap (integralClosure O L) L)) :=
  HypRing.baseChangeTo _ (by
    rw [Algebra.algebraMap_self, Polynomial.map_id]
    exact map_algebraMap_integralClosure_eq f L)

@[simp] theorem re_toClosureIndex
    (w : HypRing L ((f.map (algebraMap O K)).map (algebraMap K L))) :
    (toClosureIndex f L w).re = w.re := by
  rw [toClosureIndex, HypRing.re_baseChangeTo, Algebra.algebraMap_self, Polynomial.map_id]

@[simp] theorem im_toClosureIndex
    (w : HypRing L ((f.map (algebraMap O K)).map (algebraMap K L))) :
    (toClosureIndex f L w).im = w.im := by
  rw [toClosureIndex, HypRing.im_baseChangeTo, Algebra.algebraMap_self, Polynomial.map_id]

theorem map_toClosureIndex_pointIdeal (x y : L) :
    (pointIdeal ((f.map (algebraMap O K)).map (algebraMap K L)) x y).map (toClosureIndex f L)
      = pointIdeal ((f.map (algebraMap O (integralClosure O L))).map
        (algebraMap (integralClosure O L) L)) x y := by
  rw [toClosureIndex, pointIdeal_baseChangeTo, Algebra.algebraMap_self_apply,
    Algebra.algebraMap_self_apply]

end IndexBase

section IndexResidue

universe u

variable {O : Type u} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
  [IsAdicComplete (maximalIdeal O) O]
  {K : Type u} [Field K] [Algebra O K] [IsFractionRing O K] [CharZero K]
  [IsAlgClosed (ResidueField O)]
  (f : O[X]) (L : IntermediateField K (AlgebraicClosure K)) [FiniteDimensional K L]

/-- The reduction of `f` over `O_L`, pulled back along the residue-field identification,
agrees with the reduction of `f` over `O`. -/
theorem map_residue_integralClosure_eq :
    ((f.map (algebraMap O (integralClosure O L))).map (residue (integralClosure O L))).map
        ((integralClosureResidueEquiv O L).symm : ResidueField (integralClosure O L) →+*
          ResidueField O)
      = f.map (residue O) := by
  rw [map_map, map_map]
  congr 1
  ext a
  simp only [RingHom.comp_apply, RingHom.coe_coe]
  rw [← integralClosureResidueEquiv_residue O L a, RingEquiv.symm_apply_apply]

/-- The reduction of `f` over `O_L` is the base change of its reduction over `O` along the
residue-field identification. -/
theorem map_residue_integralClosure_eq' :
    (f.map (residue O)).map
        ((integralClosureResidueEquiv O L : ResidueField O →+*
          ResidueField (integralClosure O L)))
      = (f.map (algebraMap O (integralClosure O L))).map (residue (integralClosure O L)) := by
  rw [map_map, map_map]
  congr 1

instance instFactOddResidueIntegralClosure [Fact (Odd (f.map (residue O)).natDegree)] :
    Fact (Odd ((f.map (algebraMap O (integralClosure O L))).map
      (residue (integralClosure O L))).natDegree) := by
  refine ⟨?_⟩
  rw [← map_residue_integralClosure_eq' f L, natDegree_map]
  exact Fact.out

instance instFactSquarefreeResidueIntegralClosure [Fact (Squarefree (f.map (residue O)))] :
    Fact (Squarefree ((f.map (algebraMap O (integralClosure O L))).map
      (residue (integralClosure O L)))) :=
  ⟨map_residue_integralClosure_eq' f L ▸ squarefree_map_of_perfectField _
    (Fact.out : Squarefree (f.map (residue O)))⟩

end IndexResidue

/-! ### Split-supported ideals -/

section SplitSupported

variable {F : Type*} [Field F] {g : F[X]}

/-- An ideal of the coordinate ring is *split-supported* if all its nonzero prime divisors
are maximal ideals of rational points. Over a splitting field this holds for the Mumford
representatives of ideal classes (`ChabautyColeman.splitSupported_mumfordIdeal`), and the
notion is what makes reductions of ideals stable under further base change. -/
def SplitSupported (I : Ideal (HypRing F g)) : Prop :=
  ∀ Q : Ideal (HypRing F g), Q.IsPrime → Q ≠ ⊥ → I ≤ Q →
    ∃ (x y : F) (_ : y ^ 2 = g.eval x), Q = pointIdeal g x y

theorem SplitSupported.mul {I J : Ideal (HypRing F g)} (hI : SplitSupported I)
    (hJ : SplitSupported J) : SplitSupported (I * J) := fun Q hQ hQ0 hle ↦
  (hQ.mul_le.mp hle).elim (hI Q hQ hQ0) (hJ Q hQ hQ0)

/-- A Mumford ideal with split `u` is split-supported: its prime divisors are the maximal
ideals of the points `(a, v(a))` over roots `a` of `u`. -/
theorem splitSupported_mumfordIdeal {u v : F[X]} (hu : u ≠ 0) (hdvd : u ∣ v ^ 2 - g)
    (hsplit : u.Splits) : SplitSupported (mumfordIdeal g u v) := by
  intro Q hQ hQ0 hle
  obtain ⟨m, hm⟩ := splits_iff_exists_multiset.mp hsplit
  -- some linear factor of `u` lies in `Q`
  have huQ : algebraMap F[X] (HypRing F g) u ∈ Q := hle (algebraMap_mem_mumfordIdeal g u v)
  rw [hm, map_mul, map_multiset_prod, Multiset.map_map] at huQ
  have hprod : (m.map fun a ↦ algebraMap F[X] (HypRing F g) (X - C a)).prod ∈ Q := by
    rcases hQ.mem_or_mem huQ with h | h
    · refine absurd (Q.eq_top_of_isUnit_mem h ?_) hQ.ne_top
      rw [← HypRing.algebraMap_eq_C]
      exact (Ne.isUnit (leadingCoeff_ne_zero.mpr hu)).map _
    · exact h
  obtain ⟨w, hwm, hwQ⟩ := (hQ.multiset_prod_mem_iff_exists_mem _).mp hprod
  obtain ⟨a, ham, rfl⟩ := Multiset.mem_map.mp hwm
  -- the point `(a, v(a))` lies on the curve
  have hlin : X - C a ∣ u := by
    rw [hm]
    exact (Multiset.dvd_prod (Multiset.mem_map_of_mem _ ham)).mul_left _
  have honc : v.eval a ^ 2 = g.eval a := by
    have h0 : (v ^ 2 - g).eval a = 0 :=
      eval_eq_zero_of_dvd_of_eval_eq_zero (hlin.trans hdvd) (by simp)
    simpa [sub_eq_zero] using h0
  -- the point ideal is contained in `Q`, hence equals it by maximality
  have hgen2 : HypRing.y g - algebraMap F (HypRing F g) (v.eval a) ∈ Q := by
    have h1 : HypRing.y g - algebraMap F[X] (HypRing F g) v ∈ Q :=
      hle (y_sub_mem_mumfordIdeal g u v)
    have h2 : algebraMap F[X] (HypRing F g) (v - C (v.eval a)) ∈ Q :=
      Q.mem_of_dvd (_root_.map_dvd _ (X_sub_C_dvd_sub_C_eval (a := a) (p := v))) hwQ
    have h3 := Ideal.add_mem _ h1 h2
    rwa [map_sub, sub_add_sub_cancel, ← HypRing.algebraMap_eq_C] at h3
  have hpt : pointIdeal g a (v.eval a) ≤ Q := by
    rw [pointIdeal, Ideal.span_le]
    rintro w (rfl | rfl)
    · exact hwQ
    · exact hgen2
  exact ⟨a, v.eval a, honc, ((pointIdeal_isMaximal honc).eq_of_le hQ.ne_top hpt).symm⟩

end SplitSupported

/-! ### Height-one factorization of a nonzero ideal -/

section Factorization

variable {F : Type*} [Field F] {g : F[X]} [NeZero (2 : F)] [Fact (Odd g.natDegree)]
  [Fact (Squarefree g)]

/-- Height-one factorization data of a nonzero ideal of a coordinate ring: a finite set `s` of
height-one primes with `I = ∏ v ∈ s, v.maxPowDividing I`, each factor nonzero and `I ≤ v.asIdeal`.
This packages the skeleton shared by the base-change stability and equivariance proofs of
`ChabautyColeman.redIdealBar`. -/
theorem exists_finset_maxPowDividing {I : Ideal (HypRing F g)} (hI : I ≠ 0) :
    ∃ s : Finset (IsDedekindDomain.HeightOneSpectrum (HypRing F g)),
      (∏ v ∈ s, v.maxPowDividing I = I) ∧ (∀ v ∈ s, v.maxPowDividing I ≠ 0) ∧
        (∀ v ∈ s, I ≤ v.asIdeal) := by
  have hfin := Ideal.hasFiniteMulSupport hI
  refine ⟨hfin.toFinset, ?_, fun v _ ↦ ?_, fun v hv ↦ ?_⟩
  · rw [← finprod_eq_prod _ hfin, Ideal.finprod_heightOneSpectrum_factorization hI]
  · rw [IsDedekindDomain.HeightOneSpectrum.maxPowDividing, Ne, Submodule.zero_eq_bot]
    exact pow_ne_zero _ v.ne_bot
  · replace hv := Function.mem_mulSupport.mp ((Set.Finite.mem_toFinset hfin).mp hv)
    have hc : (Associates.mk v.asIdeal).count (Associates.mk I).factors ≠ 0 := fun h0 ↦ hv (by
      rw [IsDedekindDomain.HeightOneSpectrum.maxPowDividing, h0, pow_zero])
    exact Ideal.dvd_iff_le.mp ((Associates.count_ne_zero_iff_dvd hI v.irreducible).mp hc)

end Factorization

/-! ### Existence of splitting towers -/

section SplittingTower

universe u

variable {K : Type u} [Field K]

private theorem isSplittingField_adjoin_rootSet (u : K[X]) :
    u.IsSplittingField K (IntermediateField.adjoin K (u.rootSet (AlgebraicClosure K))) :=
  IntermediateField.adjoin_rootSet_isSplittingField (IsAlgClosed.splits _)

/-- The field generated by the roots of `u` in the algebraic closure is finite-dimensional. -/
theorem finiteDimensional_adjoin_rootSet (u : K[X]) :
    FiniteDimensional K (IntermediateField.adjoin K (u.rootSet (AlgebraicClosure K))) :=
  have := isSplittingField_adjoin_rootSet u
  IsSplittingField.finiteDimensional _ u

/-- The polynomial `u` splits over the field generated by its roots in the algebraic
closure. -/
theorem splits_map_adjoin_rootSet (u : K[X]) :
    (u.map (algebraMap K
      (IntermediateField.adjoin K (u.rootSet (AlgebraicClosure K))))).Splits :=
  have := isSplittingField_adjoin_rootSet u
  IsSplittingField.splits _ u

/-- **Existence of a splitting tower**: any nonzero polynomial over a finite intermediate
field `L` splits, with square `g`-values available at all its roots, over some larger finite
intermediate field. -/
theorem exists_intermediateField_splits {L : IntermediateField K (AlgebraicClosure K)}
    [FiniteDimensional K L] (N g : L[X]) (hN : N ≠ 0) :
    ∃ (L' : IntermediateField K (AlgebraicClosure K)) (hle : L ≤ L'),
      FiniteDimensional K L' ∧
      (N.map (IntermediateField.inclusion hle : L →ₐ[K] L').toRingHom).Splits ∧
      ∀ x : L', (N.map (IntermediateField.inclusion hle).toRingHom).eval x = 0 →
        ∃ b : L', b ^ 2 = (g.map (IntermediateField.inclusion hle).toRingHom).eval x := by
  classical
  set E := AlgebraicClosure K
  have hsqex : ∀ a : E, ∃ s : E, s ^ 2 = (g.map (algebraMap L E)).eval a := fun a ↦
    IsAlgClosed.exists_pow_nat_eq _ two_pos
  set S₂ : Set E := (fun a ↦ (hsqex a).choose) '' (N.rootSet E)
  have hfin : (N.rootSet E ∪ S₂).Finite :=
    (N.rootSet_finite E).union ((N.rootSet_finite E).image _)
  have halg : ∀ x ∈ N.rootSet E ∪ S₂, IsIntegral K x := fun x _ ↦
    (Algebra.IsAlgebraic.isAlgebraic x).isIntegral
  set L' := L ⊔ IntermediateField.adjoin K (N.rootSet E ∪ S₂)
  have hmem : ∀ x ∈ N.rootSet E ∪ S₂, x ∈ L' := fun x hx ↦
    (le_sup_right : IntermediateField.adjoin K (N.rootSet E ∪ S₂) ≤ L')
      (IntermediateField.subset_adjoin K _ hx)
  have hcomp : (algebraMap L' E).comp
      (IntermediateField.inclusion (le_sup_left : L ≤ L')).toRingHom = algebraMap L E := by
    ext c
    exact IntermediateField.coe_inclusion (le_sup_left : L ≤ L') c
  have hpush : ∀ p : L[X],
      (p.map (IntermediateField.inclusion (le_sup_left : L ≤ L')).toRingHom).map
        (algebraMap L' E) = p.map (algebraMap L E) := fun p ↦ by
    rw [map_map, hcomp]
  refine ⟨L', le_sup_left, ?_, ?_, ?_⟩
  · have : FiniteDimensional K (IntermediateField.adjoin K (N.rootSet E ∪ S₂)) := by
      have := hfin.to_subtype
      exact IntermediateField.finiteDimensional_adjoin halg
    infer_instance
  · refine Splits.of_splits_map (algebraMap L' E) ?_ ?_
    · rw [hpush]
      exact IsAlgClosed.splits _
    · intro x hx
      rw [hpush] at hx
      have hx' : x ∈ N.rootSet E := by
        rwa [Polynomial.rootSet, Finset.mem_coe, Multiset.mem_toFinset]
      exact RingHom.mem_range.mpr ⟨⟨x, hmem x (Or.inl hx')⟩, rfl⟩
  · intro x hx
    have hxE : (x : E) ∈ N.rootSet E := by
      have h1 : ((N.map (IntermediateField.inclusion (le_sup_left : L ≤ L')).toRingHom).map
          (algebraMap L' E)).eval (algebraMap L' E x) = 0 := by
        rw [eval_map_apply, hx, map_zero]
      rw [hpush] at h1
      rw [Polynomial.rootSet, Finset.mem_coe, Multiset.mem_toFinset]
      exact Polynomial.mem_roots'.mpr ⟨by
        simpa [Polynomial.map_eq_zero_iff (algebraMap L E).injective] using hN, h1⟩
    refine ⟨⟨(hsqex x).choose, hmem _ (Or.inr ⟨(x : E), hxE, rfl⟩)⟩, ?_⟩
    have hs := (hsqex (x : E)).choose_spec
    have h2 : (g.map (algebraMap (↥L) E)).eval ((x : L') : E)
        = (((g.map (IntermediateField.inclusion
            (le_sup_left : L ≤ L')).toRingHom).eval x : L') : E) := by
      rw [← hpush g]
      exact eval_map_apply (algebraMap L' E) _
    refine Subtype.val_injective ?_
    rw [SubmonoidClass.coe_pow]
    change (hsqex (x : E)).choose ^ 2 = (((g.map (IntermediateField.inclusion
      (le_sup_left : L ≤ L')).toRingHom).eval x : L') : E)
    rwa [hs]

end SplittingTower

/-! ### Nonzeroness of images of ideals -/

/-- The image of a nonzero ideal under a ring isomorphism is nonzero. -/
theorem map_ringEquiv_ne_zero {R S : Type*} [CommRing R] [CommRing S] (e : R ≃+* S)
    {I : Ideal R} (hI : I ≠ 0) : I.map (e : R →+* S) ≠ 0 := by
  rw [Ne, Submodule.zero_eq_bot, Ideal.map_eq_bot_iff_of_injective (f := (e : R →+* S))
    e.injective, ← Submodule.zero_eq_bot]
  exact hI

/-- The image of a nonzero ideal under a target-flexible base change is nonzero (the `≠ 0`
form of `ChabautyColeman.map_baseChangeTo_ne_bot`). -/
theorem map_baseChangeTo_ne_zero {F F' : Type*} [Field F] [Field F'] [Algebra F F'] (g : F[X])
    {g' : F'[X]} (hg : g.map (algebraMap F F') = g') {I : Ideal (HypRing F g)} (hI : I ≠ 0) :
    I.map (HypRing.baseChangeTo g hg) ≠ 0 := by
  rw [Ne, Submodule.zero_eq_bot]
  exact map_baseChangeTo_ne_bot g hg (by rwa [← Submodule.zero_eq_bot])

/-! ### The reduction of ideals over the tower to the fixed residue curve -/

section RedIdealBar

universe u

variable {O : Type u} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
  [IsAdicComplete (maximalIdeal O) O]
  {K : Type u} [Field K] [Algebra O K] [IsFractionRing O K] [CharZero K]
  [IsAlgClosed (ResidueField O)]
  (f : O[X])
  (L : IntermediateField K (AlgebraicClosure K)) [FiniteDimensional K L]

/-- The residue-side change: from the residue curve of `O_L` back to the fixed residue
curve of `O`. -/
noncomputable def fromClosureResidue :
    HypRing (ResidueField (integralClosure O L))
        ((f.map (algebraMap O (integralClosure O L))).map (residue (integralClosure O L)))
      →+* HypRing (ResidueField O) (f.map (residue O)) :=
  HypRing.baseChangeTo _ (map_residue_integralClosure_eq f L)

/-- The reduction of an ideal of the coordinate ring over `L` to the fixed residue curve:
run `ChabautyColeman.redIdeal` over the complete DVR `O_L` and identify the residue
fields. -/
noncomputable def redIdealBar
    (I : Ideal (HypRing L ((f.map (algebraMap O K)).map (algebraMap K L)))) :
    Ideal (HypRing (ResidueField O) (f.map (residue O))) :=
  (redIdeal (f.map (algebraMap O (integralClosure O L)))
    (I.map (toClosureIndex f L))).map (fromClosureResidue f L)

theorem redIdealBar_ne_zero [Fact (Odd (f.map (residue O)).natDegree)]
    (I : Ideal (HypRing L ((f.map (algebraMap O K)).map (algebraMap K L)))) :
    redIdealBar f L I ≠ 0 := by
  rw [redIdealBar]
  exact map_baseChangeTo_ne_zero _ _ (redIdeal_ne_zero _)

theorem redIdealBar_mul [Fact (Odd (f.map (algebraMap O K)).natDegree)]
    [Fact (Squarefree (f.map (algebraMap O K)))]
    {I J : Ideal (HypRing L ((f.map (algebraMap O K)).map (algebraMap K L)))}
    (hI : I ≠ 0) (hJ : J ≠ 0) :
    redIdealBar f L (I * J) = redIdealBar f L I * redIdealBar f L J := by
  rw [redIdealBar, redIdealBar, redIdealBar, Ideal.map_mul, redIdeal_mul, Ideal.map_mul]
  · exact map_baseChangeTo_ne_zero _ _ hI
  · exact map_baseChangeTo_ne_zero _ _ hJ

/-- **Reduction of a point class is the class of the reduced point**, over the tower: the
reduction of the maximal ideal of an integral point of the curve over `L` is the maximal
ideal of its `redres`-reduction on the fixed residue curve. -/
theorem redIdealBar_pointIdeal [Fact (Odd (f.map (algebraMap O K)).natDegree)]
    [Fact (Squarefree (f.map (algebraMap O K)))] {x y : L}
    (hxy : y ^ 2 = ((f.map (algebraMap O K)).map (algebraMap K L)).eval x)
    (hx : IsIntegral O x) :
    redIdealBar f L (pointIdeal ((f.map (algebraMap O K)).map (algebraMap K L)) x y)
      = pointIdeal (f.map (residue O)) (redres O L x) (redres O L y) := by
  have h1 : (pointIdeal ((f.map (algebraMap O K)).map (algebraMap K L)) x y).map
      (toClosureIndex f L) = pointIdeal ((f.map (algebraMap O (integralClosure O L))).map
        (algebraMap (integralClosure O L) L)) x y := map_toClosureIndex_pointIdeal f L x y
  have hxy' : y ^ 2 = ((f.map (algebraMap O (integralClosure O L))).map
      (algebraMap (integralClosure O L) L)).eval x := by
    rw [← map_algebraMap_integralClosure_eq f L]; exact hxy
  have hy : IsIntegral O y := isIntegral_of_curve f L hxy hx
  have hvx : (IsDiscreteValuationRing.maximalIdeal (integralClosure O L)).valuation L x
      ≤ 1 := by
    obtain ⟨t, ht⟩ : ∃ t : integralClosure O L,
        algebraMap (integralClosure O L) L t = x := ⟨⟨x, hx⟩, rfl⟩
    exact ht ▸ (IsDiscreteValuationRing.maximalIdeal _).valuation_le_one t
  have hvy : (IsDiscreteValuationRing.maximalIdeal (integralClosure O L)).valuation L y
      ≤ 1 := by
    obtain ⟨s, hs⟩ : ∃ s : integralClosure O L,
        algebraMap (integralClosure O L) L s = y := ⟨⟨y, hy⟩, rfl⟩
    exact hs ▸ (IsDiscreteValuationRing.maximalIdeal _).valuation_le_one s
  rw [redIdealBar, h1,
    redIdeal_pointIdeal_of_redPoint_eq hxy' (redPoint_affine hxy' hvx hvy),
    fromClosureResidue, pointIdeal_baseChangeTo]
  rfl

/-- A point of the curve over `L` with non-integral `x`-coordinate reduces to `∞_bar`: its
maximal ideal contributes trivially. -/
theorem redIdealBar_pointIdeal_of_not_isIntegral
    [Fact (Odd (f.map (algebraMap O K)).natDegree)]
    [Fact (Squarefree (f.map (algebraMap O K)))] {x y : L}
    (hxy : y ^ 2 = ((f.map (algebraMap O K)).map (algebraMap K L)).eval x)
    (hx : ¬IsIntegral O x) :
    redIdealBar f L (pointIdeal ((f.map (algebraMap O K)).map (algebraMap K L)) x y)
      = ⊤ := by
  have h1 : (pointIdeal ((f.map (algebraMap O K)).map (algebraMap K L)) x y).map
      (toClosureIndex f L) = pointIdeal ((f.map (algebraMap O (integralClosure O L))).map
        (algebraMap (integralClosure O L) L)) x y := map_toClosureIndex_pointIdeal f L x y
  have hxy' : y ^ 2 = ((f.map (algebraMap O (integralClosure O L))).map
      (algebraMap (integralClosure O L) L)).eval x := by
    rw [← map_algebraMap_integralClosure_eq f L]; exact hxy
  have hvx : ¬(IsDiscreteValuationRing.maximalIdeal (integralClosure O L)).valuation L x
      ≤ 1 := by
    intro hle
    obtain ⟨t, ht⟩ := IsDiscreteValuationRing.exists_lift_of_le_one hle
    exact hx (ht ▸ (t.2 : IsIntegral O (t : L)))
  rw [redIdealBar, h1, redIdeal_pointIdeal_of_redPoint_eq_infinity hxy'
    (redPoint_eq_infinity_of_lt hxy' (not_le.mp hvx)), Ideal.map_top]

end RedIdealBar


module

-- Import paths adapted for Lean Pool; local option overrides removed.

public import Mathlib.Algebra.Polynomial.Derivative
public import Mathlib.RingTheory.Adjoin.Polynomial.Basic
public import Mathlib.RingTheory.Ideal.Maps

import Mathlib.Algebra.Polynomial.FieldDivision
import Mathlib.Tactic.LinearCombination

/-!
# The corner of an algebra at a simple root splits off

Let `B` be a commutative algebra over a field `F`, generated by a single element `t`, and let
`ρ : B →ₐ[F] F` be an `F`-point of `B`. If `t` satisfies a polynomial `m ∈ F[X]` whose
derivative does not vanish at `ρ t` — the image `ρ t` is a *simple* root of `m` — then the
kernel of `ρ` is generated by an idempotent (`exists_isIdempotentElem_ker_eq_span`): the corner
of `B` at `ρ` is a direct ring factor.

This is the splitting principle behind unramified base change: for a finite separable field
extension `k'/k` and an embedding `σ : k' → Ω`, the multiplication map
`Ω ⊗ₖ k' → Ω` has idempotent-generated kernel, because `k'` is generated by an element whose
minimal polynomial is separable.

## Main statements

* `exists_isIdempotentElem_ker_eq_span`: the kernel of an `F`-point `ρ` of an `F`-algebra
  generated by a single element `t` is generated by an idempotent, provided `t` satisfies a
  polynomial having `ρ t` as a simple root.
* `exists_isIdempotentElem_ker_eq_span_of_ringHom`: the same statement with the algebra
  structure replaced by a ring homomorphism `φ : F →+* B` with retraction `ρ`. This is the form
  the application uses, where `F` acts through an explicit homomorphism into a quotient ring
  rather than through a registered `Algebra` instance.
-/

@[expose] public section

open Polynomial

variable {F B : Type*} [Field F] [CommRing B]

section
variable [Algebra F B]

/-- **The corner at a simple root splits off.** If the `F`-algebra `B` is generated by `t`,
and `t` satisfies a polynomial `m` whose derivative does not vanish at `ρ t` for an `F`-point
`ρ : B →ₐ[F] F`, then `ker ρ` is generated by an idempotent. -/
theorem exists_isIdempotentElem_ker_eq_span (ρ : B →ₐ[F] F) {t : B}
    (hgen : Algebra.adjoin F {t} = ⊤) {m : F[X]} (hm : aeval t m = 0)
    (hm' : m.derivative.eval (ρ t) ≠ 0) :
    ∃ γ : B, IsIdempotentElem γ ∧ RingHom.ker ρ = Ideal.span {1 - γ} := by
  set α := ρ t
  have hev (g : F[X]) : ρ (aeval t g) = g.eval α := by
    rw [← aeval_algHom_apply]; exact congrFun (coe_aeval_eq_eval α) g
  have hroot : m.eval α = 0 := by rw [← hev, hm, map_zero]
  -- factor `m` at the root; the cofactor is coprime to `X - C α` since the root is simple
  obtain ⟨u, v, huv⟩ := isCoprime_of_is_root_of_eval_derivative_ne_zero m α hm'
  set q := m /ₘ (X - C α)
  have hfac : m = (X - C α) * q := (mul_divByMonic_eq_iff_isRoot.mpr hroot).symm
  refine ⟨aeval t (v * q), ?_, ?_⟩
  · -- idempotency: `(vq)² - vq = -uv·(X - Cα)q = -uv·m`, which `t` kills
    have hid : v * q * (v * q) - v * q = -(u * v) * m := by
      rw [hfac]
      linear_combination (v * q : F[X]) * huv
    have h0 : aeval t (v * q) * aeval t (v * q) - aeval t (v * q) = 0 := by
      rw [← map_mul, ← map_sub, hid, map_mul, hm, mul_zero]
    exact sub_eq_zero.mp h0
  · -- the kernel: both inclusions through the factorization
    have hγ : (1 : B) - aeval t (v * q) = aeval t (1 - v * q) := by rw [map_sub, map_one]
    have hδ : (1 - aeval t (v * q)) * aeval t (X - C α) = aeval t (X - C α) := by
      have hpoly : (1 - v * q) * (X - C α) = (X - C α) - v * m := by rw [hfac]; ring
      rw [hγ, ← map_mul, hpoly, map_sub, map_mul, hm, mul_zero, sub_zero]
    refine le_antisymm (fun z hz ↦ ?_) (Ideal.span_le.mpr ?_)
    · -- `z = aeval t g` with `g(α) = 0`, so `(X - C α) ∣ g` and `z ∈ (1 - γ)`
      obtain ⟨g, rfl⟩ : ∃ g : F[X], aeval t g = z := by
        rw [← AlgHom.mem_range, ← Algebra.adjoin_singleton_eq_range_aeval, hgen]
        exact Algebra.mem_top
      have hgα : g.eval α = 0 := by rw [← hev]; exact hz
      obtain ⟨h, hh⟩ := (dvd_iff_isRoot.mpr hgα : X - C α ∣ g)
      have hmem : aeval t (X - C α) ∈ Ideal.span {1 - aeval t (v * q)} := by
        rw [← hδ]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
      rw [hh, show aeval t ((X - C α) * h) = aeval t (X - C α) * aeval t h from map_mul ..]
      exact Ideal.mul_mem_right _ _ hmem
    · -- `ρ (1 - γ) = (u(X - Cα))(α) = 0`
      intro x hx
      rw [Set.mem_singleton_iff.mp hx, SetLike.mem_coe, RingHom.mem_ker, hγ, hev,
        show (1 : F[X]) - v * q = u * (X - C α) by linear_combination -huv]
      simp

end

section Unbundled

/-- **The corner at a simple root splits off, unbundled form**: instead of an algebra
structure, take a homomorphism `φ : F →+* B` with retraction `ρ`, and generation of `B` by
`t` in the form "every element is a polynomial in `t` with coefficients via `φ`". -/
theorem exists_isIdempotentElem_ker_eq_span_of_ringHom (φ : F →+* B) (ρ : B →+* F)
    (hρφ : ∀ x, ρ (φ x) = x) {t : B}
    (hgen : ∀ b : B, ∃ g : F[X], eval₂ φ t g = b) {m : F[X]}
    (hm : eval₂ φ t m = 0) (hm' : m.derivative.eval (ρ t) ≠ 0) :
    ∃ γ : B, IsIdempotentElem γ ∧ RingHom.ker ρ = Ideal.span {1 - γ} := by
  let : Algebra F B := φ.toAlgebra
  let ρalg : B →ₐ[F] F := { ρ with commutes' := hρφ }
  have hgen' : Algebra.adjoin F {t} = ⊤ := by
    rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.range_eq_top]
    exact hgen
  exact exists_isIdempotentElem_ker_eq_span ρalg hgen' hm hm'

end Unbundled

end

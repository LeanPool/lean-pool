module

-- Import paths adapted for Lean Pool; local option overrides removed.

public import Mathlib.RingTheory.DedekindDomain.Basic
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Ideal.Quotient.Operations

import Mathlib.RingTheory.DedekindDomain.Ideal.Lemmas

/-!
# Complements on ideals

* `Ideal.mapMulEquiv`: a ring isomorphism induces a multiplicative isomorphism of the
  monoids of ideals. Mathlib has `Ideal.map_of_equiv` and `Ideal.map_mul` but assembles
  neither into a bundled equivalence, which is what the transport of a multiplicative
  invariant of ideals (multiplicity, nonzero-divisor status, the class group) needs.
* `Ideal.exists_mem_mk_eq_of_sup_eq_top`: an ideal coprime to `I` meets every class of `R ⧸ I`.
* `Ideal.ker_eq_sup_of_ker_quotient_lift`: the kernel of a map factoring through `R ⧸ I`,
  computed from the kernel of the induced map on the quotient (the converse direction of
  `Ideal.ker_quotient_lift`).
* `Ideal.sup_span_singleton_eq_of_sub_mem`: adjoining `x` or `y` to `I` gives the same ideal
  once `x - y ∈ I`.
* `Ideal.exists_span_singleton_eq_mul_of_ne_bot`: a uniformizer certificate at a nonzero maximal
  ideal `P` of a Dedekind domain, in the form of the factorization of the principal ideal
  generated by an element of `P ∖ P ^ 2`.
-/

@[expose] public section

variable {R S : Type*} [CommRing R] [CommRing S]

/-- A ring isomorphism induces a multiplicative isomorphism of the monoids of ideals. -/
def Ideal.mapMulEquiv (e : R ≃+* S) : Ideal R ≃* Ideal S where
  toFun I := I.map (e : R →+* S)
  invFun I := I.map (e.symm : S →+* R)
  left_inv _ := Ideal.map_of_equiv e
  right_inv I := by simpa using Ideal.map_of_equiv (I := I) e.symm
  map_mul' _ _ := Ideal.map_mul _ _ _

/-- An ideal coprime to `I` maps onto the whole quotient ring `R ⧸ I`. -/
theorem Ideal.map_mk_eq_top_of_sup_eq_top {I J : Ideal R} (h : I ⊔ J = ⊤) :
    J.map (Ideal.Quotient.mk I) = ⊤ := by
  rw [← Ideal.map_top (Ideal.Quotient.mk I), ← h, Ideal.map_sup, Ideal.map_quotient_self,
    bot_sup_eq]

/-- An ideal coprime to `I` contains a representative of every class of `R ⧸ I`. -/
theorem Ideal.exists_mem_mk_eq_of_sup_eq_top {I J : Ideal R} (h : I ⊔ J = ⊤) (γ : R ⧸ I) :
    ∃ c ∈ J, Ideal.Quotient.mk I c = γ :=
  Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective |>.mp
    (by rw [Ideal.map_mk_eq_top_of_sup_eq_top h]; trivial)

/-- The kernel of a map `f` vanishing on `I`, read off from the kernel of the induced map on
`R ⧸ I`; the converse direction of `Ideal.ker_quotient_lift`. -/
theorem Ideal.ker_eq_sup_of_ker_quotient_lift {I : Ideal R} (f : R →+* S) (h : ∀ a ∈ I, f a = 0)
    {K : Ideal R} (hk : RingHom.ker (Ideal.Quotient.lift I f h) = K.map (Ideal.Quotient.mk I)) :
    RingHom.ker f = I ⊔ K := by
  have hI : I ≤ RingHom.ker f := fun a ha ↦ RingHom.mem_ker.mpr (h a ha)
  have := congrArg (Ideal.comap (Ideal.Quotient.mk I))
    ((Ideal.ker_quotient_lift f h).symm.trans hk)
  rwa [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
    Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
    Ideal.mk_ker, sup_of_le_left hI, sup_comm] at this

/-- Adjoining `x` or `y` to `I` gives the same ideal as soon as `x - y ∈ I`. -/
theorem Ideal.sup_span_singleton_eq_of_sub_mem {I : Ideal R} {x y : R} (h : x - y ∈ I) :
    I ⊔ Ideal.span {x} = I ⊔ Ideal.span {y} := by
  have key (u v : R) (huv : u - v ∈ I) : I ⊔ Ideal.span {u} ≤ I ⊔ Ideal.span {v} := by
    refine sup_le le_sup_left ?_
    rw [Ideal.span_le, Set.singleton_subset_iff, show u = v + (u - v) by ring]
    exact Submodule.add_mem _ (Ideal.mem_sup_right (Ideal.mem_span_singleton_self _))
      (Ideal.mem_sup_left huv)
  exact le_antisymm (key x y h) (key y x (by simpa using neg_mem h))

/-- A uniformizer certificate at a nonzero maximal ideal `P` of a Dedekind domain: an element
`ϖ ∈ P ∖ P ^ 2`, recorded through the factorization `span {ϖ} = P * C` with `C ⊄ P` of the
principal ideal it generates. -/
theorem Ideal.exists_span_singleton_eq_mul_of_ne_bot [IsDedekindDomain R] (P : Ideal R)
    [P.IsMaximal] (hP : P ≠ ⊥) :
    ∃ (ϖ : R) (C : Ideal R), Ideal.span {ϖ} = P * C ∧ ¬ C ≤ P := by
  obtain ⟨ϖ, hϖ, hϖ2⟩ :=
    IsConcreteLE.exists_of_lt (Ideal.pow_lt_self P hP (Ideal.IsMaximal.ne_top ‹_›) 2 le_rfl)
  obtain ⟨C, hC⟩ : P ∣ Ideal.span {ϖ} :=
    Ideal.dvd_iff_le.mpr (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hϖ))
  refine ⟨ϖ, C, hC, fun hle ↦ hϖ2 ?_⟩
  obtain ⟨C', hC'⟩ := Ideal.dvd_iff_le.mpr hle
  exact Ideal.le_of_dvd ⟨C', by rw [hC, hC', sq, mul_assoc]⟩ (Ideal.mem_span_singleton_self ϖ)

end

module

public import LeanPool.NairTenenbaum.Arithmetic.PrimePowerRoots
public import Mathlib.RingTheory.Polynomial.Resultant.Basic

/-! # The discriminant and simple residue roots

For a polynomial of degree at least two the discriminant belongs to the ideal
generated by the polynomial and its derivative. The modified Sylvester matrix
gives this without assuming that the leading coefficient is invertible.
-/

@[expose] public section

namespace NairTenenbaum

open Polynomial Matrix

theorem exists_mul_add_mul_eq_C_discr {R : Type*} [CommRing R] (Q : R[X])
    (hdeg : 2 ≤ Q.natDegree) : ∃ U V : R[X], Q * U + Q.derivative * V = C Q.discr := by
  classical
  let d := Q.natDegree - 1 + Q.natDegree
  have hd : 0 < d := by dsimp [d]; omega
  let z : Fin d := ⟨0, hd⟩
  let last : Fin d := ⟨2 * Q.natDegree - 2, by dsimp [d]; omega⟩
  have hlz : last ≠ z := by
    intro h
    have := congrArg Fin.val h
    dsimp [last, z] at this
    omega
  let M := Q.sylvesterDeriv
  let e : Fin d → R := Pi.single z 1
  let c : Fin d → R := M.adjugate *ᵥ e
  have hmc : M *ᵥ c = M.det • e := by
    change M *ᵥ (M.adjugate *ᵥ e) = _
    rw [Matrix.mulVec_mulVec, Matrix.mul_adjugate]
    rw [Matrix.smul_mulVec, Matrix.one_mulVec]
  have hrow : M last ⬝ᵥ c = 0 := by
    have := congrFun hmc last
    simpa [Matrix.mulVec, e, hlz, Ne.symm hlz] using this
  have hsc : Q.derivative.sylvester Q (Q.natDegree - 1) Q.natDegree *ᵥ c = M.det • e := by
    rw [← Q.sylvesterDeriv_updateRow (by omega), Matrix.updateRow_mulVec]
    change Function.update (M *ᵥ c) last ((Q.leadingCoeff • M last) ⬝ᵥ c) = _
    rw [smul_dotProduct, hrow, smul_zero, hmc]
    apply Function.update_eq_self_iff.mpr
    simp [e, hlz]
  let b₁ := degreeLT.basisProd R (Q.natDegree - 1) Q.natDegree
  let b₂ := degreeLT.basis R d
  let pq := b₁.equivFun.symm c
  let L := sylvesterMap Q.derivative Q (natDegree_derivative_le Q) le_rfl
  let t : R[X]_d := ⟨C M.det, mem_degreeLT.mpr
    (degree_C_le.trans_lt (by exact_mod_cast hd))⟩
  have hc : (b₁.repr pq : Fin d → R) = c := b₁.equivFun.apply_symm_apply c
  have ht : (b₂.repr t : Fin d → R) = M.det • e := by
    ext i
    simp only [b₂, degreeLT.basis_repr, t, coeff_C, Pi.smul_apply, smul_eq_mul,
      e, Pi.single_apply, z, Fin.ext_iff]
    split_ifs <;> simp_all
  have hL : L pq = t := by
    apply b₂.equivFun.injective
    change (b₂.repr (L pq) : Fin d → R) = b₂.repr t
    rw [← LinearMap.toMatrix_mulVec_repr b₁ b₂, hc, ht]
    have hmat : LinearMap.toMatrix b₁ b₂ L =
        Q.derivative.sylvester Q (Q.natDegree - 1) Q.natDegree :=
      toMatrix_sylvesterMap' _ _ _ _
    rw [hmat]
    exact hsc
  have hbez : Q * (pq.1 : R[X]) + Q.derivative * (pq.2 : R[X]) = C M.det := by
    have := congrArg (fun f : R[X]_d => (f : R[X])) hL
    change Q.derivative * (pq.2 : R[X]) + Q * (pq.1 : R[X]) = C M.det at this
    exact (add_comm _ _).trans this
  let s : R := (-1) ^ (Q.natDegree * (Q.natDegree - 1) / 2)
  refine ⟨pq.1 * C s, pq.2 * C s, ?_⟩
  rw [← mul_assoc, ← mul_assoc, ← add_mul, hbez, ← map_mul]
  rfl

/-- In degree at most one, a nonzero polynomial cannot have a multiple root. -/
theorem eval_derivative_ne_zero_of_degree_le_one {K : Type*} [Field K] {Q : K[X]}
    (hQ : Q ≠ 0) (hdeg : Q.natDegree ≤ 1) {a : K} (ha : Q.eval a = 0) :
    Q.derivative.eval a ≠ 0 := by
  obtain ⟨b, c, rfl⟩ := exists_eq_X_add_C_of_natDegree_le_one hdeg
  intro hz
  simp only [derivative_add, derivative_mul, derivative_C, derivative_X, zero_mul,
    mul_one, zero_add, add_zero, eval_C] at hz
  simp only [eval_add, eval_mul, eval_C, eval_X, hz, zero_mul, zero_add] at ha
  exact hQ (by simp [hz, ha])

theorem discr_eq_one_of_natDegree_le_one {R : Type*} [CommRing R] {Q : R[X]}
    (hdeg : Q.natDegree ≤ 1) : Q.discr = 1 := by
  rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hdeg with hz | ho
  · rw [eq_C_of_natDegree_eq_zero hz, discr_C]
  · apply discr_of_degree_eq_one
    rwa [← Nat.cast_one, degree_eq_iff_natDegree_eq_of_pos one_pos]

/-- A prime not dividing the discriminant gives only simple residue roots.
The no-fixed-prime condition also covers polynomials of degree zero or one. -/
theorem simple_roots_of_discr {Q : ℤ[X]} (hQ : NoFixedPrimeDivisor Q)
    {p : ℕ} (hp : p.Prime) (hD : (Q.discr : ZMod p) ≠ 0) (a : ResidueRoots Q p) :
    Q.derivative.eval₂ (Int.castRingHom (ZMod p)) (a : ZMod p) ≠ 0 := by
  let : Fact p.Prime := ⟨hp⟩
  by_cases hdeg : 2 ≤ Q.natDegree
  · obtain ⟨U, V, hbez⟩ := exists_mul_add_mul_eq_C_discr Q hdeg
    intro hz
    have h := congrArg (fun f : ℤ[X] => f.eval₂ (Int.castRingHom (ZMod p)) (a : ZMod p)) hbez
    simp only [eval₂_add, eval₂_mul, a.property, hz, zero_mul, zero_add, eval₂_C] at h
    exact hD h.symm
  · have hdeg' : (Q.map (Int.castRingHom (ZMod p))).natDegree ≤ 1 :=
      natDegree_map_le.trans (by omega)
    have h := eval_derivative_ne_zero_of_degree_le_one (hQ.map_ne_zero hp) hdeg'
      (a := (a : ZMod p)) (by simpa only [Polynomial.eval_map] using a.property)
    simpa only [derivative_map, Polynomial.eval_map] using h

theorem simple_roots_of_dvd_discr {Q T : ℤ[X]} (hT : NoFixedPrimeDivisor T)
    (hQT : Q ∣ T) {p : ℕ} (hp : p.Prime) (hD : (T.discr : ZMod p) ≠ 0)
    (a : ResidueRoots Q p) :
    Q.derivative.eval₂ (Int.castRingHom (ZMod p)) (a : ZMod p) ≠ 0 := by
  obtain ⟨S, rfl⟩ := hQT
  have ha : (Q * S).eval₂ (Int.castRingHom (ZMod p)) (a : ZMod p) = 0 := by
    rw [eval₂_mul, a.property, zero_mul]
  have hsimple := simple_roots_of_discr hT hp hD ⟨a, ha⟩
  intro hz
  apply hsimple
  simp only [derivative_mul, eval₂_add, eval₂_mul, hz, a.property, zero_mul, zero_add]

theorem rootCount_prime_pow_le_of_dvd_discr {Q T : ℤ[X]} (hT : NoFixedPrimeDivisor T)
    (hQT : Q ∣ T) {p ν : ℕ} (hp : p.Prime) (hν : ν ≠ 0)
    (hD : ¬ p ∣ T.discr.natAbs) : rootCount Q (p ^ ν) ≤ rootCount Q p := by
  apply rootCount_prime_pow_le_of_simple hp hν
  apply simple_roots_of_dvd_discr hT hQT hp
  simpa only [ne_eq, ZMod.intCast_zmod_eq_zero_iff_dvd, Int.natCast_dvd] using hD

/-- Common divisors of the value and derivative divide the discriminant. -/
theorem dvd_discr_of_dvd_eval_and_derivative {Q : ℤ[X]} (hdeg : 2 ≤ Q.natDegree)
    {d n : ℤ} (hQ : d ∣ Q.eval n) (hQ' : d ∣ Q.derivative.eval n) : d ∣ Q.discr := by
  obtain ⟨U, V, hbez⟩ := exists_mul_add_mul_eq_C_discr Q hdeg
  have h := congrArg (fun f : ℤ[X] => f.eval n) hbez
  simp only [eval_add, eval_mul, eval_C] at h
  rw [← h]
  exact dvd_add (dvd_mul_of_dvd_left hQ _) (dvd_mul_of_dvd_left hQ' _)

/-- Two polynomial factors with a common value-divisor force that divisor into
the discriminant of their product (or any polynomial divisible by the product). -/
theorem dvd_discr_of_dvd_two_factors {Q R S : ℤ[X]} (hdeg : 2 ≤ Q.natDegree)
    (hRS : R * S ∣ Q) {d n : ℤ} (hR : d ∣ R.eval n) (hS : d ∣ S.eval n) :
    d ∣ Q.discr := by
  obtain ⟨T, rfl⟩ := hRS
  apply dvd_discr_of_dvd_eval_and_derivative hdeg
  · simp only [eval_mul]
    exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_left hR _) _
  · simp only [derivative_mul, eval_add, eval_mul]
    apply dvd_add
    · apply dvd_mul_of_dvd_left
      exact dvd_add (dvd_mul_of_dvd_right hS _) (dvd_mul_of_dvd_left hR _)
    · exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_left hR _) _

end NairTenenbaum

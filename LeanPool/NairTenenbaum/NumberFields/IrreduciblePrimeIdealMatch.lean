-- Modified for Lean Pool integration and compatibility maintenance.
module

public import LeanPool.NairTenenbaum.NumberFields.NumberFieldPrimeNormRoots
public import LeanPool.NairTenenbaum.NumberFields.RootNormalizationEquality

/-! # Eventual equality of prime root counts and prime-norm ideal counts

The field generated by a root of an irreducible polynomial supplies the ideal
counts. Integral normalization and the conductor exclude only finitely many primes.
-/

@[expose] public section

namespace NairTenenbaum

open NumberField Polynomial

theorem exists_irreducible_prime_ideal_match {Q : ℤ[X]}
    [h : Fact (Irreducible (Q.map (Int.castRingHom ℚ)))] :
    ∃ N : ℕ, ∀ p : ℕ, p.Prime → N < p →
      rootCount Q p = idealNormCount (AdjoinRoot (Q.map (Int.castRingHom ℚ))) p := by
  have hirr := h.out
  have hQ0 : Q ≠ 0 := by intro h; simp [h] at hirr
  let B : PowerBasis ℚ (AdjoinRoot (Q.map (Int.castRingHom ℚ))) := AdjoinRoot.powerBasis
      hirr.ne_zero
  have hroot : aeval B.gen Q = 0 := by
    rw [← aeval_map_algebraMap ℚ]
    change aeval (AdjoinRoot.root (Q.map (Int.castRingHom ℚ))) (Q.map (Int.castRingHom ℚ)) = 0
    exact (AdjoinRoot.aeval_eq (f := Q.map (Int.castRingHom ℚ)) _).trans AdjoinRoot.mk_self
  have hdeg : Q.natDegree = B.dim := by
    exact (natDegree_map_eq_of_injective (f := Int.castRingHom ℚ) Int.cast_injective Q).symm
  obtain ⟨θ, B', hB', hmin⟩ := exists_integralGenerator_of_polynomial hQ0 B hroot hdeg
  have hdegpos : 1 ≤ Q.natDegree := by
    rw [← natDegree_map_eq_of_injective (f := Int.castRingHom ℚ) Int.cast_injective Q]
    exact hirr.natDegree_pos
  have hc0 : Q.leadingCoeff.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr (leadingCoeff_ne_zero.mpr hQ0)
  have he0 := conductor_exponent_ne_zero θ B' hB'
  refine ⟨max Q.leadingCoeff.natAbs (RingOfIntegers.exponent θ), ?_⟩
  intro p hp hpN
  have hpc : Q.leadingCoeff.natAbs < p := (le_max_left _ _).trans_lt hpN
  have hpe : RingOfIntegers.exponent θ < p := (le_max_right _ _).trans_lt hpN
  have hgood : ¬p ∣ Q.leadingCoeff.natAbs :=
    fun hd => (not_le_of_gt hpc) (Nat.le_of_dvd (Nat.pos_of_ne_zero hc0) hd)
  have hcop : p.Coprime (RingOfIntegers.exponent θ) := hp.coprime_iff_not_dvd.mpr
    (fun hd => (not_le_of_gt hpe) (Nat.le_of_dvd (Nat.pos_of_ne_zero he0) hd))
  rw [← rootCount_integralNormalization_eq hdegpos hp hgood, ← hmin]
  exact rootCount_minpoly_eq_idealNormCount θ hp hcop

end NairTenenbaum

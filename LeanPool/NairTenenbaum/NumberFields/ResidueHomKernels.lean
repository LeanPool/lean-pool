-- Modified for Lean Pool integration and compatibility maintenance.
module

public import LeanPool.NairTenenbaum.Polynomials.RootCount
public import Mathlib.RingTheory.Ideal.Norm.AbsNorm

/-! # Kernels of homomorphisms to residue rings

A map to `ZMod n` is determined by its kernel, since the residue ring is
generated by the image of the integers. This gives a convenient way to
distinguish the ideals arising from different polynomial residue roots.
-/

@[expose] public section

namespace NairTenenbaum

theorem zmod_ringHom_ker_injective {R : Type*} [CommRing R] (n : ℕ) :
    Function.Injective (fun f : R →+* ZMod n => RingHom.ker f) := by
  intro f g h
  change RingHom.ker f = RingHom.ker g at h
  apply RingHom.ext
  intro x
  have hx : x - ZMod.cast (f x) ∈ RingHom.ker f := by
    simp only [RingHom.mem_ker, map_sub, ZMod.ringHom_map_cast, sub_self]
  rw [h] at hx
  have H : g x - f x = 0 := by
    simpa only [RingHom.mem_ker, map_sub, ZMod.ringHom_map_cast] using hx
  exact (sub_eq_zero.mp H).symm

theorem cardQuot_ker_zmod {R : Type*} [CommRing R] {n : ℕ} (f : R →+* ZMod n) :
    Submodule.cardQuot (RingHom.ker f) = n := by
  rw [Submodule.cardQuot_apply]
  calc
    _ = Nat.card (ZMod n) := Nat.card_congr
      (RingHom.quotientKerEquivOfRightInverse (ZMod.ringHom_rightInverse f)).toEquiv
    _ = _ := by simp

end NairTenenbaum

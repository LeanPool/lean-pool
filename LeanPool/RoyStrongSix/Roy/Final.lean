module

public import Mathlib.Tactic.Common
public import Mathlib.Tactic.Ring
public import LeanPool.RoyStrongSix.Roy.Core

/-!
# Waldschmidt's Theorem 1 implies Roy's strong six exponentials theorem

`strongSix_of_theorem1 : WaldschmidtTheorem1 → StrongSixExponentials`.

From `xᵢ yⱼ = β⁽ⁱʲ⁾₀ + ∑_r β⁽ⁱʲ⁾_{r+1} ℓ⁽ⁱʲ⁾_r`, let `K = ℚ(all β)` with `ℚ`-basis `ω₁, …, ω_m`.
Writing `ω_k β = ∑_{k'} c_{k'} ω_{k'}` with `c ∈ ℚ` gives lifts
`ℓ_{kj} = (ω_k β⁽·ʲ⁾₀, (∑_r c ℓ_r)_{k', ·}) ∈ Qbar² × 𝓛^{2m}` with `φ(ℓ_{kj}) = ω_k y_j x`,
which contradicts `strong_six_core`.
-/

@[expose] public section

namespace LeanPool

open Module Submodule

noncomputable section

namespace StrongSix.Roy

/-- **Roy's strong six exponentials theorem, conditional on Waldschmidt's Theorem 1.** -/
theorem strongSix_of_theorem1 (hT1 : WaldschmidtTheorem1) : StrongSixExponentials := by
  intro x y hx hy
  by_contra hcon
  push Not at hcon
  choose n β ℓ hβ hℓ hxy using hcon
  -- the number field generated by all the `β`
  set B : Set ℂ := ⋃ i, ⋃ j, Set.range (β i j) with hB
  have hBfin : B.Finite := Set.finite_iUnion fun i => Set.finite_iUnion fun j => Set.finite_range _
  have : Finite B := hBfin.to_subtype
  set K := IntermediateField.adjoin ℚ B with hK
  have hint : ∀ z ∈ B, IsIntegral ℚ z := by
    intro z hz
    simp only [hB, Set.mem_iUnion, Set.mem_range] at hz
    obtain ⟨i, j, r, rfl⟩ := hz
    exact (hβ i j r).isIntegral
  have : FiniteDimensional ℚ K := IntermediateField.finiteDimensional_adjoin hint
  have hβK : ∀ i j r, β i j r ∈ K := fun i j r =>
    IntermediateField.subset_adjoin ℚ B (Set.mem_iUnion.mpr ⟨i, Set.mem_iUnion.mpr ⟨j, r, rfl⟩⟩)
  set m := finrank ℚ K with hmdef
  let ωb := Module.finBasis ℚ K
  let ω : Fin m → ℂ := fun k => ((ωb k : K) : ℂ)
  have hm : 1 ≤ m := Module.finrank_pos
  have hωalg : ∀ k, IsAlgebraic ℚ (ω k) := fun k =>
    (IsIntegral.map K.val (Algebra.IsIntegral.isIntegral (ωb k))).isAlgebraic
  have hωind : LinearIndependent ℚ ω :=
    ωb.linearIndependent.map' (K.val.toLinearMap.restrictScalars ℚ)
      (LinearMap.ker_eq_bot.mpr K.val.injective)
  -- coefficients `ω_k β_{r+1} = ∑_{k'} c ω_{k'}`
  let c : ∀ (i : Fin 2) (j : Fin 3), Fin m → Fin (n i j) → Fin m → ℚ := fun i j k r k' =>
    ωb.repr (ωb k * ⟨β i j r.succ, hβK i j r.succ⟩) k'
  have hc : ∀ i j k r, ω k * β i j r.succ = ∑ k', (c i j k r k' : ℂ) * ω k' := by
    intro i j k r
    have h := congrArg (fun z : K => (z : ℂ))
      (ωb.sum_repr (ωb k * ⟨β i j r.succ, hβK i j r.succ⟩))
    rw [IntermediateField.coe_sum] at h
    rw [show ω k * β i j r.succ = ((ωb k * ⟨β i j r.succ, hβK i j r.succ⟩ : K) : ℂ) from rfl, ← h]
    refine Finset.sum_congr rfl fun k' _ => ?_
    rw [← Rat.smul_def]
    rfl
  -- the lifts
  let G : Fin m × Fin 3 → Fin m × Fin 2 → ℂ := fun p q =>
    ∑ r, (c q.2 p.2 p.1 r q.1 : ℂ) * ℓ q.2 p.2 r
  have hGlog : ∀ p q, G p q ∈ logAlg := fun p q =>
    Submodule.sum_mem logAlgSub fun r _ => logAlg_rat_mul (hℓ _ _ r) _
  let lift : Fin m × Fin 3 → E 2 (m * 2) := fun p =>
    (fun i => ω p.1 * β i p.2 0, fun l => G p (finProdFinEquiv.symm l))
  have hliftalg : ∀ p, AlgVec (lift p).1 ∧ ∀ l, (lift p).2 l ∈ logAlg := by
    intro p
    exact ⟨fun i => (hωalg p.1).mul (hβ i p.2 0), fun l => hGlog p _⟩
  have hlift : ∀ p, phiω ω (lift p) = (ω p.1 * y p.2) • x := by
    intro p
    funext i
    rw [phiω_apply]
    change ω p.1 * β i p.2 0 + ∑ k', ω k' * G p (finProdFinEquiv.symm (finProdFinEquiv (k', i))) =
      (ω p.1 * y p.2) * x i
    simp only [Equiv.symm_apply_apply, G]
    -- `∑_{k'} ω_{k'} ∑_r c ℓ_r = ∑_r (∑_{k'} c ω_{k'}) ℓ_r = ∑_r ω_k β_{r+1} ℓ_r`
    have hswap : ∑ k', ω k' * ∑ r, (c i p.2 p.1 r k' : ℂ) * ℓ i p.2 r =
        ∑ r, (ω p.1 * β i p.2 r.succ) * ℓ i p.2 r := by
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [hc i p.2 p.1 r, Finset.sum_mul]
      refine Finset.sum_congr rfl fun k' _ => ?_
      ring
    rw [hswap, show ω p.1 * y p.2 * x i = ω p.1 * (x i * y p.2) by ring, hxy i p.2, mul_add,
      Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun r _ => ?_
    ring
  exact strong_six_core ω hT1 hm hωalg hωind hx hy lift hliftalg hlift

end StrongSix.Roy

end

end LeanPool

    rw [show (-1 : ℝ) ^ 3 = -1 by norm_num, neg_one_smul] at h1
    exact neg_inj.mp h1
  -- bounds on the inputs
  set! Mf : ℝ := max B₀ (max (SchwartzMap.seminorm ℝ 0 0 f₁) (max (SchwartzMap.seminorm ℝ 0 0 f₂)
    (SchwartzMap.seminorm ℝ 0 0 f₃)))
  set! Md : ℝ := max (SchwartzMap.seminorm ℝ 0 0 (SchwartzMap.derivCLM ℝ ℂ f₁))
    (max (SchwartzMap.seminorm ℝ 0 0 (SchwartzMap.derivCLM ℝ ℂ f₂))
      (SchwartzMap.seminorm ℝ 0 0 (SchwartzMap.derivCLM ℝ ℂ f₃)))
  have hfb : ∀ i x, ‖f i x‖ ≤ Mf := by
    intro i x
    fin_cases i
    · exact (hf₀b x).trans (le_max_left _ _)
    · exact (SchwartzMap.norm_le_seminorm ℝ f₁ x).trans
        ((le_max_left _ _).trans (le_max_right _ _))
    · exact (SchwartzMap.norm_le_seminorm ℝ f₂ x).trans
        (((le_max_left _ _).trans (le_max_right _ _)).trans (le_max_right _ _))
    · exact (SchwartzMap.norm_le_seminorm ℝ f₃ x).trans
        (((le_max_right _ _).trans (le_max_right _ _)).trans (le_max_right _ _))
  have hfd : ∀ j : Fin 3, Differentiable ℝ (f j.succ) := by
    intro j; fin_cases j
    · exact f₁.differentiable
    · exact f₂.differentiable
    · exact f₃.differentiable
  have hfd' : ∀ j : Fin 3, ∀ x, ‖deriv (f j.succ) x‖ ≤ max Mf Md := by
    intro j x; fin_cases j
    · exact (SchwartzMap.norm_le_seminorm ℝ (SchwartzMap.derivCLM ℝ ℂ f₁) x).trans
        ((le_max_left _ _).trans (le_max_right _ _))
    · exact (SchwartzMap.norm_le_seminorm ℝ (SchwartzMap.derivCLM ℝ ℂ f₂) x).trans
        (((le_max_left _ _).trans (le_max_right _ _)).trans (le_max_right _ _))
    · exact (SchwartzMap.norm_le_seminorm ℝ (SchwartzMap.derivCLM ℝ ℂ f₃) x).trans
        (((le_max_right _ _).trans (le_max_right _ _)).trans (le_max_right _ _))
  have hfm : ∀ i, Measurable (f i) := by
    intro i; fin_cases i
    · exact hf₀m
    · exact f₁.continuous.measurable
    · exact f₂.continuous.measurable
    · exact f₃.continuous.measurable
  have hf0 : ∀ x, T < |x| → f 0 x = 0 := hf₀T
  obtain ⟨hPi, hQi⟩ := progression_odd_quotient_integrable f hf₀m
    (fun i x => (hfb i x).trans (le_max_left Mf Md)) hf0 hfd hfd' f₁.integrable
  -- the explicit kernels
  set! K : ℕ → ℝ × ℝ → ℂ := fun n z => (ψ (z.2 * n) - ψ (z.2 / n)) / (z.2 : ℂ)
  have hKz : ∀ n : ℕ, 1 ≤ n → ∀ z : ℝ × ℝ, R * n < |z.2| → K n z = 0 := by
    intro n hn z hz
    have hn' : (1 : ℝ) ≤ n := by exact_mod_cast hn
    have hn0 : (0 : ℝ) < n := by linarith only [hn']
    have h1 : R < |z.2 / n| := by
      rw [abs_div, Nat.abs_cast, lt_div_iff₀ hn0]; linarith only [hz]
    have h2 : R < |z.2 * n| := by
      rw [abs_mul, Nat.abs_cast]
      have : |z.2| ≤ |z.2| * n := le_mul_of_one_le_right (abs_nonneg _) hn'
      have : R ≤ R * n := le_mul_of_one_le_right hR hn'
      linarith
    have e1 : ψ (z.2 / n) = 0 := hψs _ h1
    have e2 : ψ (z.2 * n) = 0 := hψs _ h2
    simp only [K]
    rw [e1, e2, sub_self, zero_div]
  -- truncated inputs
  set! S : ℕ → ℝ := fun n => T + 3 * (R * n)
  set! ft : ℕ → Fin 4 → ℝ → ℂ := fun n i => (Set.Icc (-S n) (S n)).indicator (f i)
  set! P : (Fin 4 → ℝ → ℂ) → ℝ × ℝ → ℂ := fun g z => ∏ j, g j (realProgressionCoordinate j z)
  have htrunc : ∀ n : ℕ, 1 ≤ n → ∀ z, K n z * P (ft n) z = K n z * P f z := by
    intro n hn z
    by_cases hK : K n z = 0
    · rw [hK, zero_mul, zero_mul]
    have ht : |z.2| ≤ R * n := by by_contra h; push Not at h; exact hK (hKz n hn z h)
    by_cases hx : T < |z.1|
    · have e1 : P (ft n) z = 0 := Finset.prod_eq_zero (Finset.mem_univ 0) (by
        simp [ft, realProgressionCoordinate, Set.indicator_apply, hf0 _ hx])
      have e2 : P f z = 0 := Finset.prod_eq_zero (Finset.mem_univ 0) (by
        simp [realProgressionCoordinate, hf0 _ hx])
      rw [e1, e2]
    push Not at hx
    congr 1
    apply Finset.prod_congr rfl
    intro j _
    apply Set.indicator_of_mem
    have hj : (j : ℝ) ≤ 3 := by exact_mod_cast Nat.le_of_lt_succ j.isLt
    have hj0 : (0 : ℝ) ≤ j := Nat.cast_nonneg _
    have : |realProgressionCoordinate j z| ≤ S n := by
      simp only [realProgressionCoordinate, S]
      calc |z.1 + (j : ℝ) * z.2| ≤ |z.1| + |(j : ℝ) * z.2| := abs_add_le _ _
        _ = |z.1| + j * |z.2| := by rw [abs_mul, abs_of_nonneg hj0]
        _ ≤ T + 3 * (R * n) := by nlinarith only [abs_nonneg z.2, ht, hx, hj]
    exact abs_le.mp this
  -- the bound for each truncation
  set Y := 3 * ((D + 1 : ℕ) * (ENNReal.ofReal Cst * (ENNReal.ofReal B₀ *
    ∏ j : Fin 3, (2 ^ (1 / q) * hlMaximalConst 3 (3 / q) ^ (1 / q) *
      (∫⁻ x, ‖f j.succ x‖ₑ ^ (3 : ℝ)) ^ (1 / (3 : ℝ))))))
  have hbound : ∀ n : ℕ, 1 ≤ n → ‖∫ z : ℝ × ℝ, K n z * P f z‖ₑ ≤ Y := by
    intro n hn
    have hn' : (1 : ℝ) ≤ n := by exact_mod_cast hn
    have hn0 : (0 : ℝ) < n := by linarith only [hn']
    have hSn : 0 ≤ S n := by simp only [S]; positivity
    have hftm : ∀ i, Measurable (ft n i) := fun i => (hfm i).indicator measurableSet_Icc
    have hftb : ∀ i x, ‖ft n i x‖ ≤ Mf := fun i x => by
      simp only [ft, Set.indicator_apply]
      split_ifs
      · exact hfb i x
      · rw [norm_zero]; exact (norm_nonneg _).trans (hfb 0 0)
    have hft0 : ∀ x, T < |x| → ft n 0 x = 0 := fun x hx => by
      simp only [ft, Set.indicator_apply, hf0 x hx, ite_self]
    have hftL : ∀ i, MemLp (ft n i) (ENNReal.ofReal q) volume := by
      intro i
      have : IsFiniteMeasure (volume.restrict (Set.Icc (-S n) (S n))) :=
        isFiniteMeasure_restrict.mpr (by simp)
      exact (memLp_indicator_iff_restrict measurableSet_Icc).mpr
        (MemLp.of_bound (hfm i).aestronglyMeasurable Mf
          (Filter.Eventually.of_forall (hfb i)))
    have hftc : ∀ i, HasCompactSupport (ft n i) := fun i =>
      HasCompactSupport.intro isCompact_Icc fun x hx => Set.indicator_of_notMem hx _
    have hform := integrated_scale_form_bound hω hsupp hsum hωc hφ hφc hR hωs hφs hC₀ hD hDR
      hωG hφG hq hCst (ft n) hftm hftb hT hft0 hftL hftc (A := (n : ℝ)⁻¹) (B := n)
      (inv_pos.mpr hn0) (inv_le_one_of_one_le₀ hn' |>.trans hn')
    rw [integrated_kernel_form_eq hd hψdc (inv_pos.mpr hn0)
      (inv_le_one_of_one_le₀ hn' |>.trans hn')] at hform
    simp only [div_inv_eq_mul] at hform
    have heq : ∫ z : ℝ × ℝ, K n z * P f z = ∫ z : ℝ × ℝ, K n z * P (ft n) z := by
      congr 1; funext z; rw [htrunc n hn z]
    rw [heq]
    refine hform.trans ?_
    have hmax := maximal_product_bound (by linarith only [hq]) hq3 (ft n) hftm hB₀
      (fun y => by
        simp only [ft, Set.indicator_apply]
        split_ifs
        · exact hf₀b y
        · rw [norm_zero]; exact hB₀)
    simp only [Y]
    gcongr
    refine hmax.trans ?_
    gcongr with j x
    simp only [ft]
    rw [enorm_indicator_eq_indicator_enorm]
    exact Set.indicator_le_self _ _ x
  -- the limit
  have hlim := explicit_kernel_tendsto hd hψb hdb hψs hψeven hPi hQi
  rw [odd_quotient_integral_eq f hQi] at hlim
  have hval : -ψ 0 / 2 * (-2 * ∫ x, f 0 x * ∫ t in Set.Ioi 0,
      (f 1 (x - t) * f 2 (x - 2 * t) * f 3 (x - 3 * t) -
        f 1 (x - -t) * f 2 (x - 2 * -t) * f 3 (x - 3 * -t)) / t) =
      -(ψ 0 * ∫ x, f₀ x * TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃] x) := by
    change -ψ 0 / 2 * (-2 * ∫ x, f₀ x * ∫ t in Set.Ioi 0,
      (f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) -
        f₁ (x - -t) * f₂ (x - 2 * -t) * f₃ (x - 3 * -t)) / t) = _
    simp only [T_eq_neg_integral, mul_neg, integral_neg]
    ring
  rw [hval] at hlim
  rw [← enorm_neg]
  exact le_of_tendsto ((continuous_enorm.tendsto _).comp hlim)
    (Filter.eventually_atTop.mpr ⟨1, fun n hn => hbound n hn⟩)

/-! ### The `L¹` bound by duality (thm:main, blueprint lines 2996-2999) -/

/-- Blueprint lines 2996-2999 (duality): a bounded measurable `g` whose pairings with all
measurable tests `|f₀| ≤ 1` supported in compact intervals are bounded by `Y` satisfies
`∫ |g| ≤ Y`. The test `f₀ = 1_{[-R,R]} conj(g)/|g|` gives `∫_{[-R,R]} |g|`, and monotone
convergence lets `R → ∞`. -/
theorem lintegral_enorm_le_of_duality {g : ℝ → ℂ} (hg : Measurable g) {Mg : ℝ}
    (hgb : ∀ x, ‖g x‖ ≤ Mg) {Y : ℝ≥0∞}
    (h : ∀ (f₀ : ℝ → ℂ) (T : ℝ), Measurable f₀ → (∀ x, ‖f₀ x‖ ≤ 1) → 0 ≤ T →
      (∀ x, T < |x| → f₀ x = 0) → ‖∫ x, f₀ x * g x‖ₑ ≤ Y) :
    ∫⁻ x, ‖g x‖ₑ ≤ Y := by
  set F : ℕ → ℝ → ℝ≥0∞ := fun n => (Set.Icc (-(n : ℝ)) n).indicator fun x => ‖g x‖ₑ
  have hFm : ∀ n, Measurable (F n) := fun n =>
    hg.enorm.indicator measurableSet_Icc
  have hFmono : Monotone F := by
    intro m n hmn x
    apply Set.indicator_le_indicator_of_subset _ (fun _ => bot_le)
    have : (m : ℝ) ≤ n := by exact_mod_cast hmn
    exact Set.Icc_subset_Icc (by linarith only [this]) this
  have hsup : ∀ x, ⨆ n, F n x = ‖g x‖ₑ := by
    intro x
    apply le_antisymm (iSup_le fun n => Set.indicator_le_self _ _ x)
    refine le_iSup_of_le ⌈|x|⌉₊ (le_of_eq ?_)
    have hx := Nat.le_ceil |x|
    exact (Set.indicator_of_mem
      (show x ∈ Set.Icc (-(⌈|x|⌉₊ : ℝ)) ⌈|x|⌉₊ from abs_le.mp hx)
        (fun y => ‖g y‖ₑ)).symm
  calc ∫⁻ x, ‖g x‖ₑ = ∫⁻ x, ⨆ n, F n x := by simp_rw [hsup]
    _ = ⨆ n, ∫⁻ x, F n x := lintegral_iSup hFm hFmono
    _ ≤ Y := by
      refine iSup_le fun n => ?_
      set s : Set ℝ := Set.Icc (-(n : ℝ)) n
      have hgi : IntegrableOn g s := by
        have : IsFiniteMeasure (volume.restrict s) := isFiniteMeasure_restrict.mpr (by simp [s])
        exact Integrable.of_bound hg.aestronglyMeasurable Mg (Filter.Eventually.of_forall hgb)
      set f₀ : ℝ → ℂ := s.indicator fun x => (starRingEnd ℂ) (g x) / (‖g x‖ : ℂ)
      have hf₀m : Measurable f₀ :=
        ((Complex.continuous_conj.measurable.comp hg).div
          (Complex.measurable_ofReal.comp hg.norm)).indicator measurableSet_Icc
      have hf₀b : ∀ x, ‖f₀ x‖ ≤ 1 := by
        intro x
        simp only [f₀, Set.indicator_apply]
        split_ifs
        · rcases eq_or_ne (g x) 0 with h0 | h0
          · simp [h0]
          · rw [norm_div, Complex.norm_conj, Complex.norm_real, Real.norm_eq_abs,
              abs_of_nonneg (norm_nonneg _), div_self (norm_ne_zero_iff.mpr h0)]
        · simp
      have hf₀T : ∀ x, (n : ℝ) < |x| → f₀ x = 0 := by
        intro x hx
        apply Set.indicator_of_notMem
        intro hmem
        exact absurd (abs_le.mpr hmem) (not_le.mpr hx)
      have hprod : ∀ x, f₀ x * g x = s.indicator (fun x => ((‖g x‖ : ℝ) : ℂ)) x := by
        intro x
        simp only [f₀, Set.indicator_apply]
        split_ifs
        · rcases eq_or_ne (g x) 0 with h0 | h0
          · simp [h0]
          · have hn : ((‖g x‖ : ℝ) : ℂ) ≠ 0 := by exact_mod_cast norm_ne_zero_iff.mpr h0
            rw [div_mul_eq_mul_div, mul_comm, Complex.mul_conj, Complex.normSq_eq_norm_sq]
            field_simp
            push_cast
            ring
        · simp
      have hpair := h f₀ n hf₀m hf₀b (Nat.cast_nonneg n) hf₀T
      simp_rw [hprod] at hpair
      rw [integral_indicator measurableSet_Icc, integral_complex_ofReal,
        ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (setIntegral_nonneg measurableSet_Icc fun _ _ => norm_nonneg _),
        ofReal_integral_norm_eq_lintegral_enorm hgi] at hpair
      rw [lintegral_indicator measurableSet_Icc]
      exact hpair

/-- Blueprint lines 2984-2989, uniformly in `x`: the odd part of the progression product along
`x - jt` is at most `12 M³ |t|` when the inputs and their derivatives are bounded by `M`. -/
theorem progression_odd_diff_le {f₁ f₂ f₃ : ℝ → ℂ} {M : ℝ}
    (hd : ∀ i, i ∈ [f₁, f₂, f₃] → Differentiable ℝ i)
    (hb : ∀ i, i ∈ [f₁, f₂, f₃] → ∀ x, ‖i x‖ ≤ M)
    (hb' : ∀ i, i ∈ [f₁, f₂, f₃] → ∀ x, ‖deriv i x‖ ≤ M) (x t : ℝ) :
    ‖f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) -
        f₁ (x - -t) * f₂ (x - 2 * -t) * f₃ (x - 3 * -t)‖ ≤ 12 * M ^ 3 * |t| := by
  have hM : 0 ≤ M := (norm_nonneg _).trans (hb f₁ (by simp) 0)
  have hlip : ∀ i, i ∈ [f₁, f₂, f₃] → ∀ a b, ‖i a - i b‖ ≤ M * |a - b| := by
    intro i hi a b
    have := (convex_univ (𝕜 := ℝ) (E := ℝ)).norm_image_sub_le_of_norm_deriv_le
      (f := i) (fun x _ => (hd i hi x)) (fun x _ => hb' i hi x) (Set.mem_univ b)
      (Set.mem_univ a)
    rwa [Real.norm_eq_abs] at this
  rw [three_term_telescope]
  have l1 := hlip f₁ (by simp) (x - t) (x - -t)
  have l2 := hlip f₂ (by simp) (x - 2 * t) (x - 2 * -t)
  have l3 := hlip f₃ (by simp) (x - 3 * t) (x - 3 * -t)
  have e1 : |x - t - (x - -t)| = 2 * |t| := by
    rw [show x - t - (x - -t) = -2 * t by ring, abs_mul]; norm_num
  have e2 : |x - 2 * t - (x - 2 * -t)| = 4 * |t| := by
    rw [show x - 2 * t - (x - 2 * -t) = -4 * t by ring, abs_mul]; norm_num
  have e3 : |x - 3 * t - (x - 3 * -t)| = 6 * |t| := by
    rw [show x - 3 * t - (x - 3 * -t) = -6 * t by ring, abs_mul]; norm_num
  rw [e1] at l1; rw [e2] at l2; rw [e3] at l3
  have b1 := hb f₁ (by simp) (x - -t); have b2 := hb f₂ (by simp) (x - 2 * t)
  have b3 := hb f₃ (by simp) (x - 3 * t); have b2' := hb f₂ (by simp) (x - 2 * -t)
  have ht := abs_nonneg t
  calc _ ≤ ‖(f₁ (x - t) - f₁ (x - -t)) * f₂ (x - 2 * t) * f₃ (x - 3 * t)‖ +
        ‖f₁ (x - -t) * (f₂ (x - 2 * t) - f₂ (x - 2 * -t)) * f₃ (x - 3 * t)‖ +
        ‖f₁ (x - -t) * f₂ (x - 2 * -t) * (f₃ (x - 3 * t) - f₃ (x - 3 * -t))‖ :=
        norm_add₃_le
    _ ≤ M * (2 * |t|) * M * M + M * (M * (4 * |t|)) * M + M * M * (M * (6 * |t|)) := by
        simp only [norm_mul]
        gcongr
    _ = 12 * M ^ 3 * |t| := by ring

/-- The integrable majorant `12 M³ 1_{(0,1]}(t) + M² (|f₁(x - t)| + |f₁(x + t)|)` of the odd part
`(g(t) - g(-t))/t` of the progression product. -/
noncomputable def oddIntegrandMajorant (f₁ : ℝ → ℂ) (M x t : ℝ) : ℝ :=
  (Set.Ioc (0 : ℝ) 1).indicator (fun _ => 12 * M ^ 3) t + M ^ 2 * (‖f₁ (x - t)‖ + ‖f₁ (x + t)‖)

theorem oddIntegrandMajorant_integrable {f₁ : ℝ → ℂ} (hi : Integrable f₁) (M x : ℝ) :
    Integrable (oddIntegrandMajorant f₁ M x) := by
  refine Integrable.add ?_ (((hi.comp_sub_left x).norm.add (hi.comp_add_left x).norm).const_mul _)
  exact (integrable_indicator_iff measurableSet_Ioc).mpr (integrableOn_const (by simp))

/-- Blueprint lines 2984-2992, uniformly in `x`: for `t > 0` the odd part of the progression
product divided by `t` is dominated by `oddIntegrandMajorant`. -/
theorem oddIntegrand_le {f₁ f₂ f₃ : ℝ → ℂ} {M : ℝ}
    (hd : ∀ i, i ∈ [f₁, f₂, f₃] → Differentiable ℝ i)
    (hb : ∀ i, i ∈ [f₁, f₂, f₃] → ∀ x, ‖i x‖ ≤ M)
    (hb' : ∀ i, i ∈ [f₁, f₂, f₃] → ∀ x, ‖deriv i x‖ ≤ M) (x : ℝ) {t : ℝ} (htp : 0 < t) :
    ‖(f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) -
        f₁ (x - -t) * f₂ (x - 2 * -t) * f₃ (x - 3 * -t)) / (t : ℂ)‖ ≤
      oddIntegrandMajorant f₁ M x t := by
  have hM : 0 ≤ M := (norm_nonneg _).trans (hb f₁ (by simp) 0)
  have hg : ∀ t, ‖f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t)‖ ≤ M ^ 2 * ‖f₁ (x - t)‖ := by
    intro t
    simp only [norm_mul]
    have := hb f₂ (by simp) (x - 2 * t); have := hb f₃ (by simp) (x - 3 * t)
    calc ‖f₁ (x - t)‖ * ‖f₂ (x - 2 * t)‖ * ‖f₃ (x - 3 * t)‖ ≤ ‖f₁ (x - t)‖ * M * M := by gcongr
      _ = _ := by ring
  rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos htp, div_le_iff₀ htp]
  have hb0 : 0 ≤ M ^ 2 * (‖f₁ (x - t)‖ + ‖f₁ (x + t)‖) := by positivity
  by_cases h1 : t ≤ 1
  · have := progression_odd_diff_le hd hb hb' x t
    rw [abs_of_pos htp] at this
    simp only [oddIntegrandMajorant,
      Set.indicator_of_mem (show t ∈ Set.Ioc (0 : ℝ) 1 from ⟨htp, h1⟩)]
    nlinarith only [htp, hb0, this]
  · push Not at h1
    simp only [oddIntegrandMajorant, Set.indicator_of_notMem (show t ∉ Set.Ioc (0 : ℝ) 1 from
      fun h => by linarith [h.2]), zero_add]
    have h2 := hg t
    have h3 : ‖f₁ (x - -t) * f₂ (x - 2 * -t) * f₃ (x - 3 * -t)‖ ≤
        M ^ 2 * ‖f₁ (x + t)‖ := (hg (-t)).trans_eq (by rw [show x - -t = x + t by ring])
    have := norm_sub_le (f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t))
      (f₁ (x - -t) * f₂ (x - 2 * -t) * f₃ (x - 3 * -t))
    have h4 : M ^ 2 * (‖f₁ (x - t)‖ + ‖f₁ (x + t)‖) * 1 ≤
        M ^ 2 * (‖f₁ (x - t)‖ + ‖f₁ (x + t)‖) * t := mul_le_mul_of_nonneg_left h1.le hb0
    nlinarith only [hb0, h1, h2, h3, this]

/-- The odd-part integrand `(g(t) - g(-t))/t` of the progression product is integrable on
`(0, ∞)`. -/
theorem oddIntegrand_integrableOn {f₁ f₂ f₃ : ℝ → ℂ} {M : ℝ}
    (hd : ∀ i, i ∈ [f₁, f₂, f₃] → Differentiable ℝ i)
    (hb : ∀ i, i ∈ [f₁, f₂, f₃] → ∀ x, ‖i x‖ ≤ M)
    (hb' : ∀ i, i ∈ [f₁, f₂, f₃] → ∀ x, ‖deriv i x‖ ≤ M) (hi : Integrable f₁) (x : ℝ) :
    IntegrableOn (fun t : ℝ => (f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) -
        f₁ (x - -t) * f₂ (x - 2 * -t) * f₃ (x - 3 * -t)) / (t : ℂ)) (Set.Ioi 0) := by
  have c₁ := (hd f₁ (by simp)).continuous
  have c₂ := (hd f₂ (by simp)).continuous
  have c₃ := (hd f₃ (by simp)).continuous
  have hm : Measurable fun t : ℝ => (f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) -
      f₁ (x - -t) * f₂ (x - 2 * -t) * f₃ (x - 3 * -t)) / (t : ℂ) := by
    have hc : Continuous fun t : ℝ => f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) -
        f₁ (x - -t) * f₂ (x - 2 * -t) * f₃ (x - 3 * -t) := by fun_prop
    exact hc.measurable.div Complex.measurable_ofReal
  refine Integrable.mono' (oddIntegrandMajorant_integrable hi M x).integrableOn
    hm.aestronglyMeasurable ?_
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
  exact oddIntegrand_le hd hb hb' x ht

/-- The odd-part integral is uniformly bounded:
`|∫_{t > 0} (g(t) - g(-t))/t dt| ≤ 12 M³ + 2 M² ‖f₁‖₁`. -/
theorem oddIntegral_bound {f₁ f₂ f₃ : ℝ → ℂ} {M : ℝ}
    (hd : ∀ i, i ∈ [f₁, f₂, f₃] → Differentiable ℝ i)
    (hb : ∀ i, i ∈ [f₁, f₂, f₃] → ∀ x, ‖i x‖ ≤ M)
    (hb' : ∀ i, i ∈ [f₁, f₂, f₃] → ∀ x, ‖deriv i x‖ ≤ M) (hi : Integrable f₁) (x : ℝ) :
    ‖∫ t in Set.Ioi 0, (f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) -
        f₁ (x - -t) * f₂ (x - 2 * -t) * f₃ (x - 3 * -t)) / t‖ ≤
      12 * M ^ 3 + 2 * (M ^ 2 * ∫ y, ‖f₁ y‖) := by
  have hM : 0 ≤ M := (norm_nonneg _).trans (hb f₁ (by simp) 0)
  have hbi := oddIntegrandMajorant_integrable hi M x
  calc _ ≤ ∫ t in Set.Ioi 0, oddIntegrandMajorant f₁ M x t := by
        apply norm_integral_le_of_norm_le hbi.integrableOn
        filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
        exact oddIntegrand_le hd hb hb' x ht
    _ ≤ ∫ t, oddIntegrandMajorant f₁ M x t := by
        apply setIntegral_le_integral hbi
        exact Filter.Eventually.of_forall fun t => by
          simp only [oddIntegrandMajorant]
          have : 0 ≤ (Set.Ioc (0 : ℝ) 1).indicator (fun _ => 12 * M ^ 3) t :=
            Set.indicator_nonneg (fun _ _ => by positivity) t
          positivity
    _ = 12 * M ^ 3 + 2 * (M ^ 2 * ∫ y, ‖f₁ y‖) := by
        simp only [oddIntegrandMajorant]
        have h3 : Integrable fun t => ‖f₁ (x - t)‖ + ‖f₁ (x + t)‖ :=
          (hi.comp_sub_left x).norm.add (hi.comp_add_left x).norm
        have h2 : Integrable fun t => M ^ 2 * (‖f₁ (x - t)‖ + ‖f₁ (x + t)‖) := h3.const_mul _
        rw [integral_add ((integrable_indicator_iff measurableSet_Ioc).mpr
          (integrableOn_const (by simp))) h2, integral_const_mul,
          integral_add (hi.comp_sub_left x).norm (hi.comp_add_left x).norm,
          integral_indicator measurableSet_Ioc, setIntegral_const, Real.volume_real_Ioc,
          integral_sub_left_eq_self (fun y => ‖f₁ y‖), integral_add_left_eq_self (fun y => ‖f₁ y‖)]
        norm_num
        ring

/-- The odd-part integral of continuous inputs is measurable in `x`. -/
theorem oddIntegral_measurable {f₁ f₂ f₃ : ℝ → ℂ} (h₁ : Continuous f₁) (h₂ : Continuous f₂)
    (h₃ : Continuous f₃) : Measurable fun x => ∫ t in Set.Ioi 0,
      (f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) -
        f₁ (x - -t) * f₂ (x - 2 * -t) * f₃ (x - 3 * -t)) / t := by
  have hH : Measurable fun p : ℝ × ℝ => (f₁ (p.1 - p.2) * f₂ (p.1 - 2 * p.2) *
      f₃ (p.1 - 3 * p.2) - f₁ (p.1 - -p.2) * f₂ (p.1 - 2 * -p.2) * f₃ (p.1 - 3 * -p.2)) /
        (p.2 : ℂ) := by
    have hc : Continuous fun p : ℝ × ℝ => f₁ (p.1 - p.2) * f₂ (p.1 - 2 * p.2) *
        f₃ (p.1 - 3 * p.2) - f₁ (p.1 - -p.2) * f₂ (p.1 - 2 * -p.2) * f₃ (p.1 - 3 * -p.2) := by
      fun_prop
    exact hc.measurable.div (Complex.measurable_ofReal.comp measurable_snd)
  exact (hH.stronglyMeasurable.integral_prod_right'
    (ν := volume.restrict (Set.Ioi (0 : ℝ)))).measurable

/-- `TrilinearHT.T` of Schwartz inputs as a function: minus the odd-part integral. -/
theorem T_eq_neg_integral_fun (f₁ f₂ f₃ : SchwartzMap ℝ ℂ) :
    TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃] = fun x => -∫ t in Set.Ioi 0,
      (f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) -
        f₁ (x - -t) * f₂ (x - 2 * -t) * f₃ (x - 3 * -t)) / t :=
  funext (T_eq_neg_integral f₁ f₂ f₃)

/-- `TrilinearHT.T` of Schwartz inputs is measurable. -/
theorem T_measurable (f₁ f₂ f₃ : SchwartzMap ℝ ℂ) :
    Measurable (TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃]) := by
  rw [T_eq_neg_integral_fun]
  exact (oddIntegral_measurable f₁.continuous f₂.continuous f₃.continuous).neg

/-- `TrilinearHT.T` of Schwartz inputs is uniformly bounded:
`|T(f₁, f₂, f₃)(x)| ≤ 12 M³ + 2 M² ‖f₁‖₁`. -/
theorem T_bound {f₁ f₂ f₃ : SchwartzMap ℝ ℂ} {M : ℝ}
    (hd : ∀ i, i ∈ [⇑f₁, ⇑f₂, ⇑f₃] → Differentiable ℝ i)
    (hb : ∀ i, i ∈ [⇑f₁, ⇑f₂, ⇑f₃] → ∀ x, ‖i x‖ ≤ M)
    (hb' : ∀ i, i ∈ [⇑f₁, ⇑f₂, ⇑f₃] → ∀ x, ‖deriv i x‖ ≤ M) (x : ℝ) :
    ‖TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃] x‖ ≤ 12 * M ^ 3 + 2 * (M ^ 2 * ∫ y, ‖f₁ y‖) := by
  rw [T_eq_neg_integral, norm_neg]
  exact oddIntegral_bound hd hb hb' f₁.integrable x

open TrilinearHT.Auto.ClassicalMaximal in
/-- Blueprint `thm:main`, lines 2955-2999: for Schwartz `f₁, f₂, f₃`,
`‖T(f₁, f₂, f₃)‖₁ ≤ |φ'''(0)|⁻¹ 3 (D + 1) C Π_j 2^{1/q} K^{1/q} ‖f_j‖₃`, whenever all finite-depth
constants of the fixed admissible class built from `ω`, `φ` are at most `C`. -/
theorem T_lintegral_le {ω φ : ℝ → ℝ} (hω : ContDiff ℝ (⊤ : ℕ∞) ω)
    (hsupp : ∀ x, 3 / 4 ≤ |x| → ω x = 0) (hsum : ∀ x, ∑' k : ℤ, ω (x - k) = 1)
    (hωc : HasCompactSupport ω) (hφ : ContDiff ℝ (⊤ : ℕ∞) φ) (hφc : HasCompactSupport φ)
    (hφodd : ∀ s, φ (-s) = -φ s) (hφ0 : iteratedDeriv 3 (fun y => (φ y : ℂ)) 0 ≠ 0)
    {R : ℝ} (hR : 0 ≤ R) (hωs : tsupport (fun y => (ω y : ℂ)) ⊆ Set.Icc (-1) 1)
    (hφs : tsupport (fun y => (φ y : ℂ)) ⊆ Set.Icc (-R) R) {C₀ D : ℕ} (hC₀ : 1 ≤ C₀)
    (hD : 1 ≤ D) (hDR : 8 + 24 * R < D)
    (hωG : ∀ j x, ‖iteratedDeriv j (fun y => (ω y : ℂ)) x‖ ≤
      ((C₀ : ℝ) * ((j : ℝ) + 1)) ^ (C₀ * (j + 1)))
    (hφG : ∀ j x, ‖iteratedDeriv j (fun y => (φ y : ℂ)) x‖ ≤
      ((C₀ : ℝ) * ((j : ℝ) + 1)) ^ (C₀ * (j + 1)))
    {q : ℝ} (hq : 2 ≤ q) (hq3 : q < 3) {Cst : ℝ}
    (hCst : ∀ N, finiteDepthConstant
      (kernelClassOf (1 / 24) (by norm_num) (3 * C₀ + 34 + D) (by omega)) q N ≤ Cst)
    (f₁ f₂ f₃ : SchwartzMap ℝ ℂ) :
    ∫⁻ x, ‖TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃] x‖ₑ ≤
      3 * ((D + 1 : ℕ) * (ENNReal.ofReal Cst *
        ∏ j : Fin 3, (2 ^ (1 / q) * hlMaximalConst 3 (3 / q) ^ (1 / q) *
          eLpNorm ((![⇑f₁, ⇑f₂, ⇑f₃] : Fin 3 → ℝ → ℂ) j) 3 volume))) /
        ‖iteratedDeriv 3 (fun y => (φ y : ℂ)) 0‖ₑ := by
  set ψ0 := iteratedDeriv 3 (fun y => (φ y : ℂ)) 0
  set! Mf : ℝ := max (SchwartzMap.seminorm ℝ 0 0 f₁) (max (SchwartzMap.seminorm ℝ 0 0 f₂)
    (SchwartzMap.seminorm ℝ 0 0 f₃))
  set! Md : ℝ := max (SchwartzMap.seminorm ℝ 0 0 (SchwartzMap.derivCLM ℝ ℂ f₁))
    (max (SchwartzMap.seminorm ℝ 0 0 (SchwartzMap.derivCLM ℝ ℂ f₂))
      (SchwartzMap.seminorm ℝ 0 0 (SchwartzMap.derivCLM ℝ ℂ f₃)))
  have hlist : ∀ i, i ∈ [⇑f₁, ⇑f₂, ⇑f₃] → ∃ g : SchwartzMap ℝ ℂ, ⇑g = i ∧
      SchwartzMap.seminorm ℝ 0 0 g ≤ max Mf Md ∧
      SchwartzMap.seminorm ℝ 0 0 (SchwartzMap.derivCLM ℝ ℂ g) ≤ max Mf Md := by
    intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl
    · exact ⟨f₁, rfl, (le_max_left _ _).trans (le_max_left _ _),
        (le_max_left _ _).trans (le_max_right _ _)⟩
    · exact ⟨f₂, rfl, ((le_max_left _ _).trans (le_max_right _ _)).trans (le_max_left _ _),
        ((le_max_left _ _).trans (le_max_right _ _)).trans (le_max_right _ _)⟩
    · exact ⟨f₃, rfl, ((le_max_right _ _).trans (le_max_right _ _)).trans (le_max_left _ _),
        ((le_max_right _ _).trans (le_max_right _ _)).trans (le_max_right _ _)⟩
  have hd : ∀ i, i ∈ [⇑f₁, ⇑f₂, ⇑f₃] → Differentiable ℝ i := by
    intro i hi
    obtain ⟨g, rfl, -, -⟩ := hlist i hi
    exact g.differentiable
  have hb : ∀ i, i ∈ [⇑f₁, ⇑f₂, ⇑f₃] → ∀ x, ‖i x‖ ≤ max Mf Md := by
    intro i hi x
    obtain ⟨g, rfl, h1, -⟩ := hlist i hi
    exact (SchwartzMap.norm_le_seminorm ℝ g x).trans h1
  have hb' : ∀ i, i ∈ [⇑f₁, ⇑f₂, ⇑f₃] → ∀ x, ‖deriv i x‖ ≤ max Mf Md := by
    intro i hi x
    obtain ⟨g, rfl, -, h2⟩ := hlist i hi
    exact (SchwartzMap.norm_le_seminorm ℝ (SchwartzMap.derivCLM ℝ ℂ g) x).trans h2
  have hψ0 : ‖ψ0‖ₑ ≠ 0 := enorm_ne_zero.mpr hφ0
  apply lintegral_enorm_le_of_duality (T_measurable f₁ f₂ f₃) (T_bound hd hb hb')
  intro f₀ T hf₀m hf₀b hT hf₀T
  have h := pv_form_bound hω hsupp hsum hωc hφ hφc hφodd hR hωs hφs hC₀ hD hDR hωG hφG hq hq3
    hCst hf₀m zero_le_one hf₀b hT hf₀T f₁ f₂ f₃
  rw [enorm_mul, ENNReal.ofReal_one, one_mul] at h
  rw [ENNReal.le_div_iff_mul_le (Or.inl hψ0) (Or.inl enorm_ne_top), mul_comm]
  refine h.trans (le_of_eq ?_)
  congr 3
  apply Finset.prod_congr rfl
  intro j _
  have hm : AEStronglyMeasurable ((![⇑f₁, ⇑f₂, ⇑f₃] : Fin 3 → ℝ → ℂ) j) volume := by
    fin_cases j
    · exact f₁.continuous.aestronglyMeasurable
    · exact f₂.continuous.aestronglyMeasurable
    · exact f₃.continuous.aestronglyMeasurable
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num) hm]
  norm_num


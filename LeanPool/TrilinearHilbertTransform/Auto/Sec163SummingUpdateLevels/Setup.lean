/-- Blueprint lines 2990-2995 (pairing `t` with `-t` and reflecting): if the odd quotient
`Q(x,t) = (P(x,t) - P(x,-t))/t` of the progression product `P(x,t) = Π_j f_j(x + jt)` is
integrable, then `∫ Q = -2 ∫ f₀(x) I(x) dx`, where
`I(x) = ∫_{t > 0} (g(t) - g(-t))/t dt` for `g(t) = f₁(x - t) f₂(x - 2t) f₃(x - 3t)` is the odd-part
integral (`T = -I` on Schwartz inputs, `T_eq_neg_integral`). -/
theorem odd_quotient_integral_eq (f : Fin 4 → ℝ → ℂ)
    (hQi : Integrable fun z : ℝ × ℝ => (∏ j, f j (realProgressionCoordinate j z) -
        ∏ j, f j (realProgressionCoordinate j (z.1, -z.2))) / (z.2 : ℂ)) :
    ∫ z : ℝ × ℝ, (∏ j, f j (realProgressionCoordinate j z) -
        ∏ j, f j (realProgressionCoordinate j (z.1, -z.2))) / (z.2 : ℂ) =
      -2 * ∫ x, f 0 x * ∫ t in Set.Ioi 0, (f 1 (x - t) * f 2 (x - 2 * t) * f 3 (x - 3 * t) -
        f 1 (x - -t) * f 2 (x - 2 * -t) * f 3 (x - 3 * -t)) / t := by
  set G : ℝ → ℝ → ℂ := fun x t => f 1 (x + t) * f 2 (x + 2 * t) * f 3 (x + 3 * t)
  have hP : ∀ z : ℝ × ℝ, ∏ j, f j (realProgressionCoordinate j z) = f 0 z.1 * G z.1 z.2 := by
    intro z
    simp only [Fin.prod_univ_four, realProgressionCoordinate, G]
    norm_num; ring
  set h : ℝ → ℝ → ℂ := fun x t => (G x t - G x (-t)) / (t : ℂ)
  have hQ : ∀ z : ℝ × ℝ, (∏ j, f j (realProgressionCoordinate j z) -
      ∏ j, f j (realProgressionCoordinate j (z.1, -z.2))) / (z.2 : ℂ) = f 0 z.1 * h z.1 z.2 := by
    intro z
    rw [hP, hP]
    simp only [h]
    ring
  have hQi' := hQi
  rw [Measure.volume_eq_prod] at hQi'
  rw [Measure.volume_eq_prod, integral_prod _ hQi', ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [hQi'.prod_right_ae] with x hx
  simp only [hQ] at hx ⊢
  rw [integral_const_mul]
  by_cases h0 : f 0 x = 0
  · simp [h0]
  have hhi : Integrable (h x) := by
    have := hx.const_mul (f 0 x)⁻¹
    refine this.congr (Filter.Eventually.of_forall fun t => ?_)
    simp only
    rw [← mul_assoc, inv_mul_cancel₀ h0, one_mul]
  have heven : ∀ t, h x (-t) = h x t := by
    intro t
    simp only [h, neg_neg]
    push_cast
    rw [div_neg, ← neg_div, neg_sub]
  have hsplit : ∫ t, h x t = 2 * ∫ t in Set.Ioi 0, h x t := by
    rw [← integral_add_compl measurableSet_Ioi hhi, Set.compl_Ioi, ← neg_zero,
      ← integral_comp_neg_Ioi, neg_zero]
    simp only [heven]
    ring
  have hpv : ∫ t in Set.Ioi 0, h x t = -∫ t in Set.Ioi 0, (f 1 (x - t) * f 2 (x - 2 * t) *
      f 3 (x - 3 * t) - f 1 (x - -t) * f 2 (x - 2 * -t) * f 3 (x - 3 * -t)) / t := by
    rw [← integral_neg]
    apply setIntegral_congr_fun measurableSet_Ioi
    intro t _
    simp only [h, G]
    rw [← neg_div]
    congr 1
    simp only [sub_eq_add_neg, neg_neg, mul_neg]
    ring
  rw [hsplit, hpv]
  ring

/-- The set `{t = 0}` is null in `ℝ²`. -/
theorem ae_snd_ne_zero : ∀ᵐ z : ℝ × ℝ, z.2 ≠ 0 := by
  rw [Filter.Eventually, mem_ae_iff]
  have : {z : ℝ × ℝ | z.2 ≠ 0}ᶜ = Set.univ ×ˢ {0} := by
    ext z; simp
  rw [this, Measure.volume_eq_prod, Measure.prod_prod, measure_singleton, mul_zero]

/-- Blueprint `eq:kernel-reconstruction` inside the four-linear form: for `0 < A ≤ B`, the
integrated kernel `∫_A^B ψ'(t/a) a⁻² da` may be replaced by `(ψ(t/A) - ψ(t/B))/t`. -/
theorem integrated_kernel_form_eq {ψ ψ' : ℝ → ℂ} (hd : ∀ x, HasDerivAt ψ (ψ' x) x)
    (hψ' : Continuous ψ') {A B : ℝ} (hA : 0 < A) (hAB : A ≤ B) (P : ℝ × ℝ → ℂ) :
    ∫ z : ℝ × ℝ, (∫ a in A..B, ψ' (z.2 / a) * ((a ^ 2)⁻¹ : ℝ)) * P z =
      ∫ z : ℝ × ℝ, (ψ (z.2 / A) - ψ (z.2 / B)) / (z.2 : ℂ) * P z := by
  apply integral_congr_ae
  filter_upwards [ae_snd_ne_zero] with z hz
  rw [scale_kernel_integral hd hψ' hz hA hAB]

/-- The `k`-th derivative of a smooth function supported in `[-R, R]` is bounded and vanishes
outside `[-R, R]`. -/
theorem iteratedDeriv_bound_support {φ : ℝ → ℂ} (hφ : ContDiff ℝ (⊤ : ℕ∞) φ) {R : ℝ}
    (hφs : tsupport φ ⊆ Set.Icc (-R) R) (k : ℕ) :
    (∀ s, R < |s| → iteratedDeriv k φ s = 0) ∧ ∃ B, ∀ s, ‖iteratedDeriv k φ s‖ ≤ B := by
  have hc : Continuous (iteratedDeriv k φ) := hφ.continuous_iteratedDeriv k (by simp)
  have hz : ∀ s, R < |s| → iteratedDeriv k φ s = 0 := by
    intro s hs
    have hx : s ∉ tsupport φ := fun h => by
      have := hφs h
      exact absurd (abs_le.mpr ⟨this.1, this.2⟩) (not_le.mpr hs)
    rw [iteratedDeriv_eq_iteratedFDeriv]
    have : s ∉ Function.support (iteratedFDeriv ℝ k φ) := fun h =>
      hx (support_iteratedFDeriv_subset k h)
    rw [Function.notMem_support.mp this]
    rfl
  refine ⟨hz, ?_⟩
  obtain ⟨B, hB⟩ := (isCompact_Icc (a := -R) (b := R)).exists_bound_of_continuousOn
    hc.continuousOn
  refine ⟨max B 0, fun s => ?_⟩
  by_cases hs : R < |s|
  · rw [hz s hs, norm_zero]; exact le_max_right _ _
  · push Not at hs
    exact (hB s (abs_le.mp hs)).trans (le_max_left _ _)


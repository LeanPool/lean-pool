    (Y : ℕ → ℕ → ℝ) (hY0 : ∀ u t, 0 ≤ Y u t)
    (hX : ∀ T, X ≤ E T + ∑ u ∈ Finset.Icc 1 T, ∑ t ∈ Finset.Ioc u T, Y u t)
    (hinit : ∀ u t, t < 12 → Y u t ≤ A₀) (b : ℕ → ℝ) (hb0 : ∀ t, 0 ≤ b t)
    (hb : ∀ u t, 12 ≤ t → u < t → Y u t ≤ b t) (hbs : Summable fun t : ℕ => (t : ℝ) * b t) :
    X ≤ 55 * A₀ + ∑' t : ℕ, (t : ℝ) * b t := by

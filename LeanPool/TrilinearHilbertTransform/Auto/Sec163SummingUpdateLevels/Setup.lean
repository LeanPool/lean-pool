/-- Blueprint lines 2927-2931 (absorption): from `C_N ≤ 1 + C A + C c C_N` with `C c ≤ 1/2`,
`C_N ≤ 2 + 2 C A`. -/
theorem uniform_constant_absorption {CN C A c : ℝ} (h : CN ≤ 1 + C * A + C * c * CN)
    (hc : C * c ≤ 1 / 2) (hCN : 0 ≤ CN) : CN ≤ 2 + 2 * C * A := by
  have : C * c * CN ≤ CN / 2 := by nlinarith only [hc, hCN]
  linarith only [h, this]

/-! ### The main theorem: kernel reconstruction and lattices (blueprint lines 2935-3010) -/

/-- Blueprint line 2985: the three-term telescoping product identity. -/
theorem three_term_telescope {R : Type*} [CommRing R] (a₁ a₂ a₃ b₁ b₂ b₃ : R) :
    a₁ * a₂ * a₃ - b₁ * b₂ * b₃ =
      (a₁ - b₁) * a₂ * a₃ + b₁ * (a₂ - b₂) * a₃ + b₁ * b₂ * (a₃ - b₃) := by
  ring

/-! ### Pointwise principal value on Schwartz inputs (blueprint lines 2984-2992) -/

/-- The truncation `TrilinearHT.truncatedTransform` in the blueprint's reflected form
`-∫_{|t| > ε} f₀(x - t) f₁(x - 2t) f₂(x - 3t) dt/t` (substitution `t ↦ -t`). -/
theorem truncatedTransform_eq_neg (f : Fin 3 → ℝ → ℂ) (x ε : ℝ) :
    TrilinearHT.truncatedTransform f x ε =
      -∫ t in {t : ℝ | ε < |t|}, f 0 (x - t) * f 1 (x - 2 * t) * f 2 (x - 3 * t) / t := by
  have hmeas : MeasurableSet {t : ℝ | ε < |t|} :=
    measurableSet_lt measurable_const continuous_abs.measurable
  rw [TrilinearHT.truncatedTransform, ← integral_neg, ← integral_indicator hmeas,
    ← integral_indicator hmeas, ← integral_neg_eq_self]
  congr 1
  funext t
  simp only [Set.indicator_apply, Set.mem_ofPred_eq, abs_neg, Fin.prod_univ_three]
  split_ifs
  · push_cast
    norm_num
    ring_nf
  · simp

/-- The product `g(t) = f₁(x - t) f₂(x - 2t) f₃(x - 3t)` of three Schwartz functions along the
progression is integrable in `t`. -/
theorem progression_product_integrable (f₁ f₂ f₃ : SchwartzMap ℝ ℂ) (x : ℝ) :
    Integrable fun t : ℝ => f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) := by
  have h₁ : Integrable fun t : ℝ => f₁ (x - t) := f₁.integrable.comp_sub_left x
  have m₂ : Continuous fun t : ℝ => f₂ (x - 2 * t) := f₂.continuous.comp (by fun_prop)
  have m₃ : Continuous fun t : ℝ => f₃ (x - 3 * t) := f₃.continuous.comp (by fun_prop)
  exact (h₁.mul_bdd m₂.aestronglyMeasurable (Filter.Eventually.of_forall fun t =>
    SchwartzMap.norm_le_seminorm ℝ f₂ _)).mul_bdd m₃.aestronglyMeasurable
    (Filter.Eventually.of_forall fun t => SchwartzMap.norm_le_seminorm ℝ f₃ _)

/-- Blueprint lines 2984-2989: the symmetric difference `g(t) - g(-t)` of the progression product
is at most `C |t|` for `|t| ≤ 1` (mean value theorem). -/
theorem progression_product_odd_part_le (f₁ f₂ f₃ : SchwartzMap ℝ ℂ) (x : ℝ) :
    ∃ C : ℝ, ∀ t ∈ Set.Icc (0 : ℝ) 1,
      ‖f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) -
        f₁ (x - -t) * f₂ (x - 2 * -t) * f₃ (x - 3 * -t)‖ ≤ C * t := by
  set g : ℝ → ℂ := fun t => f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t)
  have s₁ : ContDiff ℝ 1 f₁ := f₁.smooth 1
  have s₂ : ContDiff ℝ 1 f₂ := f₂.smooth 1
  have s₃ : ContDiff ℝ 1 f₃ := f₃.smooth 1
  have hgC : ContDiff ℝ 1 g := by simp only [g]; fun_prop
  have hg : Differentiable ℝ g := hgC.differentiable one_ne_zero
  have hg' : Continuous (deriv g) := hgC.continuous_deriv le_rfl
  obtain ⟨C, hC⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    hg'.continuousOn
  refine ⟨2 * C, fun t ht => ?_⟩
  have hmv := (convex_Icc (-1 : ℝ) 1).norm_image_sub_le_of_norm_deriv_le
    (fun y _ => hg.differentiableAt) (fun y hy => hC y hy)
    (show -t ∈ Set.Icc (-1 : ℝ) 1 by constructor <;> linarith [ht.1, ht.2])
    (show t ∈ Set.Icc (-1 : ℝ) 1 by constructor <;> linarith [ht.1, ht.2])
  calc _ = ‖g t - g (-t)‖ := rfl
    _ ≤ C * ‖t - -t‖ := hmv
    _ = 2 * C * t := by
        rw [Real.norm_eq_abs, show t - -t = 2 * t by ring, abs_of_nonneg (by linarith [ht.1])]
        ring

/-- Blueprint `thm:main`, lines 2989-2992: for Schwartz inputs the symmetric principal value
`p.v. ∫ f₁(x - t) f₂(x - 2t) f₃(x - 3t) dt/t` exists at every real `x` and equals the absolutely
convergent one-sided integral of the odd part `∫_{t > 0} (g(t) - g(-t))/t dt`. -/
theorem progression_truncated_tendsto (f₁ f₂ f₃ : SchwartzMap ℝ ℂ) (x : ℝ) :
    Filter.Tendsto
      (fun ε => ∫ t in {t : ℝ | ε < |t|}, f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) / t)
      (nhdsWithin 0 (Set.Ioi 0))
      (nhds (∫ t in Set.Ioi 0, (f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) -
        f₁ (x - -t) * f₂ (x - 2 * -t) * f₃ (x - 3 * -t)) / t)) := by
  set g : ℝ → ℂ := fun t => f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) with hgdef
  set h : ℝ → ℂ := fun t => (g t - g (-t)) / t
  have hgi : Integrable g := progression_product_integrable f₁ f₂ f₃ x
  have hgc : Continuous g := by
    have c₁ := f₁.continuous; have c₂ := f₂.continuous; have c₃ := f₃.continuous
    simp only [g]; fun_prop
  -- `g(t)/t` is integrable away from zero
  have hdiv : ∀ ε > 0, IntegrableOn (fun t : ℝ => g t / t) {t : ℝ | ε < |t|} := by
    intro ε hε
    have hmeas : MeasurableSet {t : ℝ | ε < |t|} :=
      measurableSet_lt measurable_const continuous_abs.measurable
    have hb : ∀ᵐ t : ℝ ∂(volume.restrict {t : ℝ | ε < |t|}), ‖((t : ℂ))⁻¹‖ ≤ ε⁻¹ := by
      filter_upwards [ae_restrict_mem hmeas] with t ht
      have ht' : ε < |t| := ht
      rw [norm_inv, Complex.norm_real, Real.norm_eq_abs]
      exact inv_anti₀ hε ht'.le
    have := (hgi.integrableOn (s := {t : ℝ | ε < |t|})).mul_bdd
      (Complex.measurable_ofReal.inv.aestronglyMeasurable) hb
    refine this.congr (Filter.Eventually.of_forall fun t => ?_)
    simp [div_eq_mul_inv]
  -- the truncation as a one-sided integral of the odd part
  have hsplit : ∀ ε > 0, ∫ t in {t : ℝ | ε < |t|},
      f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) / t = ∫ t in Set.Ioi ε, h t := by
    intro ε hε
    have hset : {t : ℝ | ε < |t|} = Set.Ioi ε ∪ Set.Iio (-ε) := by
      ext t; simp only [Set.mem_ofPred_eq, Set.mem_union, Set.mem_Ioi, Set.mem_Iio, lt_abs]
      constructor <;> rintro (h | h) <;> [left; right; left; right] <;> linarith
    have hIoi : IntegrableOn (fun t : ℝ => g t / t) (Set.Ioi ε) :=
      (hdiv ε hε).mono_set fun t ht => by
        change ε < |t|; exact lt_of_lt_of_le ht (le_abs_self t)
    have hIio : IntegrableOn (fun t : ℝ => g t / t) (Set.Iio (-ε)) :=
      (hdiv ε hε).mono_set fun t ht => by
        change ε < |t|; have : t < -ε := ht; rw [lt_abs]; right; linarith
    have hneg : ∫ t in Set.Iio (-ε), g t / t = ∫ t in Set.Ioi ε, g (-t) / ((-t : ℝ) : ℂ) := by
      rw [← integral_Iic_eq_integral_Iio, ← integral_comp_neg_Ioi]
    have hIoi' : IntegrableOn (fun t : ℝ => g (-t) / ((-t : ℝ) : ℂ)) (Set.Ioi ε) := by
      have := hIio.comp_neg
      rw [Set.neg_Iio, neg_neg] at this
      exact this
    rw [hset, setIntegral_union (Set.disjoint_left.mpr fun t h₁ h₂ => by
      simp only [Set.mem_Ioi, Set.mem_Iio] at h₁ h₂; linarith only [hε, h₁,
          h₂]) measurableSet_Iio hIoi hIio]
    change (∫ t in Set.Ioi ε, g t / t) + ∫ t in Set.Iio (-ε), g t / t = _
    rw [hneg, ← integral_add hIoi hIoi']
    apply setIntegral_congr_fun measurableSet_Ioi
    intro t _
    simp only [h]
    push_cast
    rw [div_neg, ← sub_eq_add_neg, sub_div]
  -- the odd part is integrable on `(0, ∞)`
  have hmeasH : AEStronglyMeasurable h (volume.restrict (Set.Ioi 0)) := by
    apply ContinuousOn.aestronglyMeasurable _ measurableSet_Ioi
    intro t ht
    have ht0 : (t : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt ht)
    apply ContinuousAt.continuousWithinAt
    simp only [h]
    exact ((hgc.comp continuous_neg |> hgc.sub).continuousAt).div
      Complex.continuous_ofReal.continuousAt ht0
  obtain ⟨C, hC⟩ := progression_product_odd_part_le f₁ f₂ f₃ x
  have hnear : IntegrableOn h (Set.Ioc 0 1) := by
    refine Integrable.mono' (g := fun _ => C) (integrableOn_const (by simp) (by simp))
      (hmeasH.mono_measure (Measure.restrict_mono Set.Ioc_subset_Ioi_self le_rfl)) ?_
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    have htp : 0 < t := ht.1
    have := hC t ⟨htp.le, ht.2⟩
    simp only [h, norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos htp]
    rw [div_le_iff₀ htp]
    exact this
  have hfar : IntegrableOn h (Set.Ioi 1) := by
    have h1 := (hdiv 1 one_pos).mono_set (s := Set.Ioi 1) fun t ht => by
      change (1 : ℝ) < |t|; exact lt_of_lt_of_le ht (le_abs_self t)
    have h2 : IntegrableOn (fun t : ℝ => g (-t) / t) (Set.Ioi 1) := by
      have := ((hdiv 1 one_pos).comp_neg).mono_set (s := Set.Ioi 1) fun t ht => by
        change (1 : ℝ) < |-t|; rw [abs_neg]; exact lt_of_lt_of_le ht (le_abs_self t)
      refine (this.neg).congr (Filter.Eventually.of_forall fun t => ?_)
      simp only [Pi.neg_apply]; push_cast; rw [div_neg, neg_neg]
    refine (h1.sub h2).congr (Filter.Eventually.of_forall fun t => ?_)
    simp only [h, Pi.sub_apply, sub_div]
  have hint : IntegrableOn h (Set.Ioi 0) := by
    rw [← Set.Ioc_union_Ioi_eq_Ioi zero_le_one]
    exact hnear.union hfar
  -- dominated convergence as `ε → 0⁺`
  change Filter.Tendsto _ _ (nhds (∫ t in Set.Ioi 0, h t))
  have hlim : Filter.Tendsto (fun ε => ∫ t in Set.Ioi 0, (Set.Ioi ε).indicator h t)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds (∫ t in Set.Ioi 0, h t)) := by
    apply tendsto_integral_filter_of_dominated_convergence (fun t => ‖h t‖)
    · exact Filter.Eventually.of_forall fun ε =>
        hmeasH.indicator measurableSet_Ioi
    · exact Filter.Eventually.of_forall fun ε => Filter.Eventually.of_forall fun t => by
        exact norm_indicator_le_norm_self _ _
    · exact hint.norm
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      apply tendsto_const_nhds.congr'
      filter_upwards [Ioo_mem_nhdsGT (show (0 : ℝ) < t from ht)] with ε hε
      rw [Set.indicator_of_mem (show t ∈ Set.Ioi ε from hε.2)]
  refine hlim.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with ε hε
  rw [hsplit ε hε, setIntegral_indicator measurableSet_Ioi,
    Set.inter_eq_right.mpr (Set.Ioi_subset_Ioi (le_of_lt hε))]

/-- Blueprint `thm:main`, lines 2989-2992, for `TrilinearHT.truncatedTransform`:
on Schwartz inputs the truncations converge to minus the odd-part integral of the blueprint's progression product. -/
theorem truncatedTransform_tendsto_neg_integral (f₁ f₂ f₃ : SchwartzMap ℝ ℂ) (x : ℝ) :
    Filter.Tendsto (TrilinearHT.truncatedTransform ![⇑f₁, ⇑f₂, ⇑f₃] x) (nhdsWithin 0 (Set.Ioi 0))
      (nhds (-∫ t in Set.Ioi 0, (f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) -
        f₁ (x - -t) * f₂ (x - 2 * -t) * f₃ (x - 3 * -t)) / t)) := by
  refine (progression_truncated_tendsto f₁ f₂ f₃ x).neg.congr fun ε => ?_
  rw [truncatedTransform_eq_neg]
  rfl

/-- On Schwartz inputs `TrilinearHT.T` is minus the absolutely convergent odd-part integral
`∫_{t > 0} (g(t) - g(-t))/t dt` of `g(t) = f₁(x - t) f₂(x - 2t) f₃(x - 3t)`. -/
theorem T_eq_neg_integral (f₁ f₂ f₃ : SchwartzMap ℝ ℂ) (x : ℝ) :
    TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃] x =
      -∫ t in Set.Ioi 0, (f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) -
        f₁ (x - -t) * f₂ (x - 2 * -t) * f₃ (x - 3 * -t)) / t :=
  (truncatedTransform_tendsto_neg_integral f₁ f₂ f₃ x).limUnder_eq

/-- Blueprint `thm:main`, lines 2989-2992: for Schwartz `f₁, f₂, f₃` the truncations
`TrilinearHT.truncatedTransform` converge to `TrilinearHT.T` at every real `x`. -/
theorem tendsto_truncatedTransform_three (f₁ f₂ f₃ : SchwartzMap ℝ ℂ) (x : ℝ) :
    Filter.Tendsto (TrilinearHT.truncatedTransform ![⇑f₁, ⇑f₂, ⇑f₃] x) (nhdsWithin 0 (Set.Ioi 0))
      (nhds (TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃] x)) := by
  rw [T_eq_neg_integral]
  exact truncatedTransform_tendsto_neg_integral f₁ f₂ f₃ x

/-- A triple of Schwartz functions, coerced to functions, as a vector literal. -/
theorem schwartz_triple_eq_vecCons (f : Fin 3 → SchwartzMap ℝ ℂ) :
    (fun i => ⇑(f i)) = ![⇑(f 0), ⇑(f 1), ⇑(f 2)] := by
  funext i
  fin_cases i <;> rfl

open scoped SchwartzMap Topology in
/-- Blueprint `thm:main`, lines 2989-2992: for Schwartz functions `f` the principal value limit
defining `TrilinearHT.T` exists at every real `x`:
`truncatedTransform f x ε → T f x` as `ε → 0⁺`. -/
theorem tendsto_truncatedTransform (f : Fin 3 → 𝓢(ℝ, ℂ)) (x : ℝ) :
    Filter.Tendsto (TrilinearHT.truncatedTransform (fun i ↦ f i) x) (𝓝[>] 0)
      (𝓝 (TrilinearHT.T (fun i ↦ f i) x)) := by
  rw [schwartz_triple_eq_vecCons]
  exact tendsto_truncatedTransform_three (f 0) (f 1) (f 2) x

section TrilinearExtension
variable {𝕜 E V W : Type*} [NontriviallyNormedField 𝕜] [AddCommGroup E] [Module 𝕜 E]
  [NormedAddCommGroup V] [NormedSpace 𝕜 V] [NormedAddCommGroup W] [NormedSpace 𝕜 W]
  [CompleteSpace W]

/-! ### Unique bounded extension (blueprint lines 2999-3009) -/

/-- Bilinear step of the extension in blueprint lines 2999-3009: a bilinear map bounded by
`C ‖e a‖ ‖e b‖` along a dense linear map `e` extends to a bounded bilinear map with
`‖B' x‖ ≤ C ‖x‖`. -/
theorem bilinear_dense_extension (e : E →ₗ[𝕜] V) (hd : DenseRange e)
    (B : E →ₗ[𝕜] E →ₗ[𝕜] W) {C : ℝ} (hC : 0 ≤ C)
    (hB : ∀ a b, ‖B a b‖ ≤ C * ‖e a‖ * ‖e b‖) :
    ∃ B' : V →L[𝕜] V →L[𝕜] W, (∀ a b, B' (e a) (e b) = B a b) ∧ ∀ x, ‖B' x‖ ≤ C * ‖x‖ := by
  have hb₂ : ∀ a b, ‖B a b‖ ≤ (C * ‖e a‖) * ‖e b‖ := hB
  let B₁ : E →ₗ[𝕜] (V →L[𝕜] W) :=
    { toFun := fun a => (B a).extendOfNorm e
      map_add' := fun a a' => by
        apply LinearMap.extendOfNorm_unique hd (C * ‖e (a + a')‖) (hb₂ (a + a'))
        ext b
        simp [LinearMap.extendOfNorm_eq hd ⟨_, hb₂ a⟩, LinearMap.extendOfNorm_eq hd ⟨_, hb₂ a'⟩]
      map_smul' := fun r a => by
        apply LinearMap.extendOfNorm_unique hd (C * ‖e (r • a)‖) (hb₂ (r • a))
        ext b
        simp [LinearMap.extendOfNorm_eq hd ⟨_, hb₂ a⟩] }
  have hB₁ : ∀ a b, B₁ a (e b) = B a b := fun a b => LinearMap.extendOfNorm_eq hd ⟨_, hb₂ a⟩ b
  have hb₁ : ∀ a, ‖B₁ a‖ ≤ C * ‖e a‖ := fun a =>
    LinearMap.opNorm_extendOfNorm_le hd (by positivity) (hb₂ a)
  refine ⟨B₁.extendOfNorm e, fun a b => ?_, LinearMap.norm_extendOfNorm_apply_le hd C hb₁⟩
  rw [LinearMap.extendOfNorm_eq hd ⟨_, hb₁⟩ a, hB₁]

/-- Blueprint `thm:main`, lines 2999-3009: a trilinear map on a space `E` with a dense linear
map `e : E → V` (Schwartz functions in `L³`), bounded by `C ‖e a‖ ‖e b‖ ‖e c‖` with values in a
complete space (`L¹`), has a unique bounded trilinear extension to `V`, with the same bound. -/
theorem trilinear_dense_extension (e : E →ₗ[𝕜] V) (hd : DenseRange e)
    (T : E →ₗ[𝕜] E →ₗ[𝕜] E →ₗ[𝕜] W) {C : ℝ} (hC : 0 ≤ C)
    (hT : ∀ a b c, ‖T a b c‖ ≤ C * ‖e a‖ * ‖e b‖ * ‖e c‖) :
    ∃ T' : V →L[𝕜] V →L[𝕜] V →L[𝕜] W,
      (∀ a b c, T' (e a) (e b) (e c) = T a b c) ∧
      (∀ x y z, ‖T' x y z‖ ≤ C * ‖x‖ * ‖y‖ * ‖z‖) ∧
      ∀ S : V →L[𝕜] V →L[𝕜] V →L[𝕜] W, (∀ a b c, S (e a) (e b) (e c) = T a b c) → S = T' := by
  -- extension in the last variable
  have hb₃ : ∀ a b c, ‖T a b c‖ ≤ (C * ‖e a‖ * ‖e b‖) * ‖e c‖ := hT
  have hT₁e : ∀ a b c, (T a b).extendOfNorm e (e c) = T a b c := fun a b c =>
    LinearMap.extendOfNorm_eq hd ⟨_, hb₃ a b⟩ c
  let T₁ : E →ₗ[𝕜] E →ₗ[𝕜] (V →L[𝕜] W) := LinearMap.mk₂ 𝕜
    (fun a b => (T a b).extendOfNorm e)
    (fun a a' b => by
      apply LinearMap.extendOfNorm_unique hd (C * ‖e (a + a')‖ * ‖e b‖) (hb₃ (a + a') b)
      ext c; simp [hT₁e])
    (fun r a b => by
      apply LinearMap.extendOfNorm_unique hd (C * ‖e (r • a)‖ * ‖e b‖) (hb₃ (r • a) b)
      ext c; simp [hT₁e])
    (fun a b b' => by
      apply LinearMap.extendOfNorm_unique hd (C * ‖e a‖ * ‖e (b + b')‖) (hb₃ a (b + b'))
      ext c; simp [hT₁e])
    (fun r a b => by
      apply LinearMap.extendOfNorm_unique hd (C * ‖e a‖ * ‖e (r • b)‖) (hb₃ a (r • b))
      ext c; simp [hT₁e])
  have hT₁ : ∀ a b c, T₁ a b (e c) = T a b c := hT₁e
  have hb₂ : ∀ a b, ‖T₁ a b‖ ≤ C * ‖e a‖ * ‖e b‖ := fun a b =>
    LinearMap.opNorm_extendOfNorm_le hd (by positivity) (hb₃ a b)
  obtain ⟨T', hT', hT'n⟩ := bilinear_dense_extension e hd T₁ hC hb₂
  refine ⟨T', fun a b c => by rw [hT', hT₁], fun x y z => ?_, fun S hS => ?_⟩
  · calc ‖T' x y z‖ ≤ ‖T' x y‖ * ‖z‖ := (T' x y).le_opNorm z
      _ ≤ ‖T' x‖ * ‖y‖ * ‖z‖ := by gcongr; exact (T' x).le_opNorm y
      _ ≤ C * ‖x‖ * ‖y‖ * ‖z‖ := by gcongr; exact hT'n x
  · -- uniqueness by density in each variable
    have h₃ : ∀ a b, S (e a) (e b) = T' (e a) (e b) := fun a b =>
      ContinuousLinearMap.ext fun z => congrFun (hd.equalizer (S (e a) (e b)).continuous
        (T' (e a) (e b)).continuous (funext fun c => by simp [hS, hT', hT₁])) z
    have h₂ : ∀ a, S (e a) = T' (e a) := fun a =>
      ContinuousLinearMap.ext fun y => congrFun (hd.equalizer (S (e a)).continuous
        (T' (e a)).continuous (funext fun b => h₃ a b)) y
    exact ContinuousLinearMap.ext fun x => congrFun (hd.equalizer S.continuous T'.continuous
      (funext fun a => h₂ a)) x

end TrilinearExtension

/-- `L³` is a normed space: `1 ≤ 3`. -/
instance fact_one_le_three_ennreal : Fact ((1 : ℝ≥0∞) ≤ 3) := ⟨by norm_num⟩

/-- Blueprint `thm:main`, lines 2999-3009, specialized: a trilinear operator on Schwartz triples
with values in `L¹(ℝ)` and the bound `‖T(f₁, f₂, f₃)‖₁ ≤ C Π ‖f_j‖₃` has a unique bounded
trilinear extension to `L³(ℝ)³` (Schwartz functions are dense in `L³`,
`SchwartzMap.denseRange_toLpCLM`). -/
theorem schwartz_L3_unique_extension
    (T : SchwartzMap ℝ ℂ →ₗ[ℂ] SchwartzMap ℝ ℂ →ₗ[ℂ] SchwartzMap ℝ ℂ →ₗ[ℂ]
      Lp ℂ 1 (volume : Measure ℝ))
    {C : ℝ} (hC : 0 ≤ C)
    (hT : ∀ f₁ f₂ f₃, ‖T f₁ f₂ f₃‖ ≤ C * ‖f₁.toLp 3 (volume : Measure ℝ)‖ *
      ‖f₂.toLp 3 (volume : Measure ℝ)‖ * ‖f₃.toLp 3 (volume : Measure ℝ)‖) :
    ∃ T' : Lp ℂ 3 (volume : Measure ℝ) →L[ℂ] Lp ℂ 3 (volume : Measure ℝ) →L[ℂ]
        Lp ℂ 3 (volume : Measure ℝ) →L[ℂ] Lp ℂ 1 (volume : Measure ℝ),
      (∀ f₁ f₂ f₃, T' (f₁.toLp 3 (volume : Measure ℝ)) (f₂.toLp 3 (volume : Measure ℝ))
        (f₃.toLp 3 (volume : Measure ℝ)) = T f₁ f₂ f₃) ∧
      (∀ x y z, ‖T' x y z‖ ≤ C * ‖x‖ * ‖y‖ * ‖z‖) ∧
      ∀ S : Lp ℂ 3 (volume : Measure ℝ) →L[ℂ] Lp ℂ 3 (volume : Measure ℝ) →L[ℂ]
        Lp ℂ 3 (volume : Measure ℝ) →L[ℂ] Lp ℂ 1 (volume : Measure ℝ),
        (∀ f₁ f₂ f₃, S (f₁.toLp 3 (volume : Measure ℝ)) (f₂.toLp 3 (volume : Measure ℝ))
          (f₃.toLp 3 (volume : Measure ℝ)) = T f₁ f₂ f₃) → S = T' := by
  have hd : DenseRange (SchwartzMap.toLpCLM ℂ ℂ (3 : ℝ≥0∞) (volume : Measure ℝ)).toLinearMap :=
    SchwartzMap.denseRange_toLpCLM (F := ℂ) (by norm_num)
  exact trilinear_dense_extension _ hd T hC hT

/-! ### The uniform local estimate from normalized absorption (thm:uniform-local) -/

/-- The cells of the rooted subtree spanned by a finite cell collection under a root: dyadic
cells inside the root that contain some used cell (blueprint `prop:normalized`, line 2831). -/
def dyadicHullCells (G : RealDyadicGrid) (cells : Finset (ℤ × ℤ)) (root : ℤ × ℤ) :
    Set (ℤ × ℤ) :=
  {K | dyadicGridCell G K.1 K.2 ⊆ dyadicGridCell G root.1 root.2 ∧
    ∃ I ∈ cells, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G K.1 K.2}

/-- The normalized local `L^q` norm `‖f‖_{q,I}` on the dyadic cell `(s, m)`. -/
noncomputable def cellLqNorm (G : RealDyadicGrid) (q : ℝ) (f : ℝ → ℂ) (K : ℤ × ℤ) : ℝ≥0∞ :=
  eLpNorm f (ENNReal.ofReal q) (normalizedIntervalMeasure (dyadicGridLeft G K.1 K.2)
    (dyadicGridLength G K.1))

/-- Blueprint `prop:normalized`, `eq:normalized` (lines 2827-2833), for fixed constants `A, c`:
on every finite rooted dyadic subtree with root `I_*` whose used cells lie in at most `N`
consecutive depths and with `‖f_j‖_{q,I} ≤ 1` on all its cells,
`Σ_{I used} |I| |H_I(f)| ≤ (A + c C_N) |I_*|`. -/
def NormalizedAbsorption (κ : LocalKernelClass) (q : ℝ) (N : ℕ) (A c : ℝ) : Prop :=
  ∀ (D : FiniteDepthLocalData κ q N) (root : ℤ × ℤ),
    (∀ I ∈ D.cells, dyadicGridCell D.grid I.1 I.2 ⊆ dyadicGridCell D.grid root.1 root.2) →
    (∀ K ∈ dyadicHullCells D.grid D.cells root, ∀ j, cellLqNorm D.grid q (D.input j) K ≤ 1) →
    finiteDepthNumerator D ≤ (A + c * finiteDepthConstant κ q N) * dyadicGridLength D.grid root.1

section StoppingGenerations
variable {α : Type*} [DecidableEq α] (C : Finset α) (cell : α → Set ℝ)
  (bad : α → α → Prop) [∀ J K, Decidable (bad J K)]
variable {C cell bad}

omit [DecidableEq α] in
/-- Every violating cell lies in a first stop (finite maximality). -/
theorem exists_firstStop_above {J K : α} (hK : K ∈ C) (hKJ : cell K ⊂ cell J) (hb : bad J K) :
    ∃ L ∈ firstStops C cell bad J, cell K ⊆ cell L := by
  classical
  -- a maximal violator above `K` by strong induction on the number of strict violators above
  have key : ∀ n : ℕ, ∀ K ∈ C, cell K ⊂ cell J → bad J K →
      ((C.filter fun L => cell K ⊂ cell L ∧ cell L ⊂ cell J ∧ bad J L).card ≤ n) →
      ∃ L ∈ firstStops C cell bad J, cell K ⊆ cell L := by
    intro n
    induction n with
    | zero =>
      intro K hK hKJ hb hn
      refine ⟨K, mem_firstStops.mpr ⟨⟨hK, hKJ, hb⟩, ?_⟩, le_rfl⟩
      rintro ⟨L, hL, h1, h2, h3⟩
      have : L ∈ C.filter fun L => cell K ⊂ cell L ∧ cell L ⊂ cell J ∧ bad J L :=
        Finset.mem_filter.mpr ⟨hL, h1, h2, h3⟩
      have := Finset.card_pos.mpr ⟨L, this⟩
      omega
    | succ n ih =>
      intro K hK hKJ hb hn
      by_cases hmax : ∃ L ∈ C, cell K ⊂ cell L ∧ cell L ⊂ cell J ∧ bad J L
      · obtain ⟨L, hL, h1, h2, h3⟩ := hmax
        obtain ⟨M, hM, hLM⟩ := ih L hL h2 h3 (by
          have hsub : (C.filter fun M => cell L ⊂ cell M ∧ cell M ⊂ cell J ∧ bad J M) ⊂
              (C.filter fun M => cell K ⊂ cell M ∧ cell M ⊂ cell J ∧ bad J M) := by
            refine Finset.ssubset_iff_of_subset ?_ |>.mpr ⟨L, ?_, ?_⟩
            · intro M hM
              obtain ⟨hMC, m1, m2, m3⟩ := Finset.mem_filter.mp hM
              exact Finset.mem_filter.mpr ⟨hMC, h1.trans m1, m2, m3⟩
            · exact Finset.mem_filter.mpr ⟨hL, h1, h2, h3⟩
            · intro hLL
              exact (Finset.mem_filter.mp hLL).2.1.ne rfl
          have := Finset.card_lt_card hsub
          omega)
        exact ⟨M, hM, h1.subset.trans hLM⟩
      · exact ⟨K, mem_firstStops.mpr ⟨⟨hK, hKJ, hb⟩, hmax⟩, le_rfl⟩
  exact key _ K hK hKJ hb le_rfl

theorem stopGen_parent {roots : Finset α} {k : ℕ} {K : α}
    (hK : K ∈ stopGen C cell bad roots (k + 1)) :
    ∃ P ∈ stopGen C cell bad roots k, K ∈ firstStops C cell bad P :=
  Finset.mem_biUnion.mp hK

/-- Each stopping generation consists of pairwise disjoint cells. -/
theorem stopGen_disjoint {roots : Finset α} (hr : roots ⊆ C)
    (hlam : ∀ K ∈ C, ∀ L ∈ C, cell K ⊆ cell L ∨ cell L ⊆ cell K ∨ Disjoint (cell K) (cell L))
    (hinj : ∀ K ∈ C, ∀ L ∈ C, cell K = cell L → K = L)
    (hroots : ∀ R ∈ roots, ∀ R' ∈ roots, R ≠ R' → Disjoint (cell R) (cell R')) :
    ∀ k, ∀ J ∈ stopGen C cell bad roots k, ∀ J' ∈ stopGen C cell bad roots k, J ≠ J' →
      Disjoint (cell J) (cell J')
  | 0 => hroots
  | k + 1 => by
    intro J hJ J' hJ' hne
    obtain ⟨P, hP, hJP⟩ := stopGen_parent hJ
    obtain ⟨P', hP', hJP'⟩ := stopGen_parent hJ'
    have hJ1 := mem_firstStops.mp hJP
    have hJ2 := mem_firstStops.mp hJP'
    by_cases hPP : P = P'
    · subst hPP
      rcases hlam J hJ1.1.1 J' hJ2.1.1 with h | h | h
      · exfalso
        have hss : cell J ⊂ cell J' := LE.le.ssubset_of_ne h
          (fun he => hne (hinj J hJ1.1.1 J' hJ2.1.1 he))
        exact hJ1.2 ⟨J', hJ2.1.1, hss, hJ2.1.2.1, hJ2.1.2.2⟩
      · exfalso
        have hss : cell J' ⊂ cell J := LE.le.ssubset_of_ne h
          (fun he => hne (hinj J' hJ2.1.1 J hJ1.1.1 he).symm)
        exact hJ2.2 ⟨J, hJ1.1.1, hss, hJ1.1.2.1, hJ1.1.2.2⟩
      · exact h
    · exact (stopGen_disjoint hr hlam hinj hroots k P hP P' hP' hPP).mono
        hJ1.1.2.1.subset hJ2.1.2.1.subset

/-- Ancestors in earlier generations. -/
theorem stopGen_ancestor {roots : Finset α} (k : ℕ) :
    ∀ d, ∀ K ∈ stopGen C cell bad roots (k + d),
      ∃ A ∈ stopGen C cell bad roots k, cell K ⊆ cell A
  | 0 => fun K hK => ⟨K, hK, le_rfl⟩
  | d + 1 => fun K hK => by
    obtain ⟨P, hP, hKP⟩ := stopGen_parent (k := k + d) hK
    obtain ⟨A, hA, hPA⟩ := stopGen_ancestor k d P hP
    exact ⟨A, hA, (mem_firstStops.mp hKP).1.2.1.subset.trans hPA⟩

/-- A later-generation cell lies in a first stop of its ancestor. -/
theorem stopGen_ancestor_stop {roots : Finset α} (k d : ℕ) {K : α}
    (hK : K ∈ stopGen C cell bad roots (k + 1 + d)) :
    ∃ A ∈ stopGen C cell bad roots k, ∃ B ∈ firstStops C cell bad A, cell K ⊆ cell B := by
  obtain ⟨B, hB, hKB⟩ := stopGen_ancestor (k + 1) d K hK
  obtain ⟨A, hA, hBA⟩ := stopGen_parent hB
  exact ⟨A, hA, B, hBA, hKB⟩

/-- Blueprint lines 2919-2921: every stopping cell strictly inside a stopping cell `J` lies
inside a first stop of `J`. -/
theorem stop_inside_firstStop {roots : Finset α} (hr : roots ⊆ C)
    (hlam : ∀ K ∈ C, ∀ L ∈ C, cell K ⊆ cell L ∨ cell L ⊆ cell K ∨ Disjoint (cell K) (cell L))
    (hinj : ∀ K ∈ C, ∀ L ∈ C, cell K = cell L → K = L)
    (hroots : ∀ R ∈ roots, ∀ R' ∈ roots, R ≠ R' → Disjoint (cell R) (cell R'))
    (hne : ∀ K, (cell K).Nonempty) {k k' : ℕ} {J J' : α}
    (hJ : J ∈ stopGen C cell bad roots k) (hJ' : J' ∈ stopGen C cell bad roots k')
    (hss : cell J' ⊂ cell J) : ∃ B ∈ firstStops C cell bad J, cell J' ⊆ cell B := by
  have hdis := stopGen_disjoint (bad := bad) hr hlam hinj hroots
  rcases le_or_gt k' k with hk | hk
  · exfalso
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hk
    obtain ⟨A, hA, hJA⟩ := stopGen_ancestor k' d J hJ
    by_cases hAJ : A = J'
    · subst hAJ; exact hss.2 hJA
    · obtain ⟨x, hx⟩ := hne J'
      exact Set.disjoint_left.mp (hdis k' A hA J' hJ' hAJ) (hJA (hss.subset hx)) hx
  · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_lt hk
    obtain ⟨A, hA, B, hB, hJ'B⟩ :=
      stopGen_ancestor_stop k d (by rwa [show k + 1 + d = k + d + 1 by omega])
    by_cases hAJ : A = J
    · subst hAJ; exact ⟨B, hB, hJ'B⟩
    · exfalso
      obtain ⟨x, hx⟩ := hne J'
      have hBA := (mem_firstStops.mp hB).1.2.1.subset
      exact Set.disjoint_left.mp (hdis k A hA J hJ hAJ) (hBA (hJ'B hx)) (hss.subset hx)

/-- The stopping cells: members of some generation. -/
noncomputable def stopCells (C : Finset α) (cell : α → Set ℝ) (bad : α → α → Prop)
    [∀ J K, Decidable (bad J K)] (roots : Finset α) : Finset α := by
  classical exact C.filter fun J => ∃ k, J ∈ stopGen C cell bad roots k

/-- The sparse remainder `E_J = J ∖ ⋃ first stops`. -/
def stopRemainder (C : Finset α) (cell : α → Set ℝ) (bad : α → α → Prop)
    [∀ J K, Decidable (bad J K)] (J : α) : Set ℝ := cell J \ ⋃ B ∈ firstStops C cell bad J, cell B

/-- Blueprint lines 2919-2921: the remainders of distinct stopping cells are disjoint. -/
theorem stopRemainder_disjoint {roots : Finset α} (hr : roots ⊆ C)
    (hlam : ∀ K ∈ C, ∀ L ∈ C, cell K ⊆ cell L ∨ cell L ⊆ cell K ∨ Disjoint (cell K) (cell L))
    (hinj : ∀ K ∈ C, ∀ L ∈ C, cell K = cell L → K = L)
    (hroots : ∀ R ∈ roots, ∀ R' ∈ roots, R ≠ R' → Disjoint (cell R) (cell R'))
    (hne : ∀ K, (cell K).Nonempty) :
    Set.PairwiseDisjoint (stopCells C cell bad roots : Set α)
      (stopRemainder C cell bad) := by
  classical
  intro J hJ J' hJ' hJJ
  simp only [stopCells, Finset.coe_filter, Set.mem_ofPred_eq] at hJ hJ'
  obtain ⟨hJC, k, hk⟩ := hJ
  obtain ⟨hJ'C, k', hk'⟩ := hJ'
  have hin : ∀ {J J' : α} {k k' : ℕ}, J ∈ stopGen C cell bad roots k →
      J' ∈ stopGen C cell bad roots k' → J ∈ C → J' ∈ C → J ≠ J' → cell J' ⊆ cell J →
      Disjoint (stopRemainder C cell bad J)
        (stopRemainder C cell bad J') := by
    intro J J' k k' hk hk' hJC hJ'C hJJ hsub
    have hss : cell J' ⊂ cell J := LE.le.ssubset_of_ne hsub
      (fun he => hJJ (hinj J' hJ'C J hJC he).symm)
    obtain ⟨B, hB, hJ'B⟩ := stop_inside_firstStop hr hlam hinj hroots hne hk hk' hss
    rw [Set.disjoint_left]
    intro x hx hx'
    exact hx.2 (Set.mem_biUnion hB (hJ'B hx'.1))
  rcases hlam J hJC J' hJ'C with h | h | h
  · exact (hin hk' hk hJ'C hJC (Ne.symm hJJ) h).symm
  · exact hin hk hk' hJC hJ'C hJJ h
  · exact h.mono Set.sdiff_subset Set.sdiff_subset

/-- Blueprint lines 2919-2924 (sparse bound): if the first stops of every stopping cell cover at
most a quarter of it, and `v_J ≤ F` on `J`, then `Σ_J |J| v_J ≤ (4/3) ∫ F`. -/
theorem stop_sparse_bound {roots : Finset α} (hr : roots ⊆ C)
    (hlam : ∀ K ∈ C, ∀ L ∈ C, cell K ⊆ cell L ∨ cell L ⊆ cell K ∨ Disjoint (cell K) (cell L))
    (hinj : ∀ K ∈ C, ∀ L ∈ C, cell K = cell L → K = L)
    (hroots : ∀ R ∈ roots, ∀ R' ∈ roots, R ≠ R' → Disjoint (cell R) (cell R'))
    (hne : ∀ K, (cell K).Nonempty) (hmeas : ∀ K, MeasurableSet (cell K))
    (hfin : ∀ K, volume (cell K) ≠ ∞)
    (hquarter : ∀ J ∈ stopCells C cell bad roots,
      4 * volume (⋃ B ∈ firstStops C cell bad J, cell B) ≤ volume (cell J))
    (F : ℝ → ℝ≥0∞) (v : α → ℝ≥0∞)
    (hv : ∀ J ∈ stopCells C cell bad roots, ∀ x ∈ cell J, v J ≤ F x) :
    ∑ J ∈ stopCells C cell bad roots, volume (cell J) * v J ≤ (4 / 3) * ∫⁻ x, F x := by
  classical
  set S := stopCells C cell bad roots
  have hEmeas : ∀ J, MeasurableSet (stopRemainder C cell bad J) :=
    fun J => (hmeas J).diff (Finset.measurableSet_biUnion _ fun B _ => hmeas B)
  -- `|J| ≤ (4/3) |E_J|`
  have hE : ∀ J ∈ S, volume (cell J) ≤ (4 / 3) *
      volume (stopRemainder C cell bad J) := by
    intro J hJ
    set U := ⋃ B ∈ firstStops C cell bad J, cell B
    have hU : volume (cell J) ≤ volume (stopRemainder C cell bad J) +
        volume U := by
      calc volume (cell J) ≤ volume (stopRemainder C cell bad J ∪ U) :=
            measure_mono (fun x hx => by
              by_cases hxU : x ∈ U
              · exact Or.inr hxU
              · exact Or.inl ⟨hx, hxU⟩)
        _ ≤ _ := measure_union_le _ _
    have h4 := hquarter J hJ
    have hfJ := hfin J
    have hUf : volume U ≠ ∞ := ne_top_of_le_ne_top hfJ (by
      calc volume U ≤ 4 * volume U := le_mul_of_one_le_left bot_le (by norm_num)
        _ ≤ _ := h4)
    set e := volume (stopRemainder C cell bad J)
    set c := volume (cell J)
    set u := volume U
    have hef : e ≠ ∞ := ne_top_of_le_ne_top hfJ (measure_mono Set.sdiff_subset)
    -- real arithmetic
    have hc : c.toReal ≤ e.toReal + u.toReal := by
      rw [← ENNReal.toReal_add hef hUf]
      exact ENNReal.toReal_mono (ENNReal.add_ne_top.mpr ⟨hef, hUf⟩) hU
    have h4r : 4 * u.toReal ≤ c.toReal := by
      have := ENNReal.toReal_mono hfJ h4
      rwa [ENNReal.toReal_mul] at this
    have hr' : c.toReal ≤ 4 / 3 * e.toReal := by norm_num at h4r ⊢; linarith only [hc, h4r]
    rw [← ENNReal.ofReal_toReal hfJ, ← ENNReal.ofReal_toReal hef,
      show (4 / 3 : ℝ≥0∞) = ENNReal.ofReal (4 / 3) by
        rw [ENNReal.ofReal_div_of_pos (by norm_num)]; norm_num,
      ← ENNReal.ofReal_mul (by norm_num)]
    exact ENNReal.ofReal_le_ofReal hr'
  calc ∑ J ∈ S, volume (cell J) * v J ≤
      ∑ J ∈ S, (4 / 3) * (volume (stopRemainder C cell bad J) * v J) := by
        apply Finset.sum_le_sum; intro J hJ
        rw [← mul_assoc]; gcongr; exact hE J hJ
    _ ≤ ∑ J ∈ S, (4 / 3) * ∫⁻ x in stopRemainder C cell bad J, F x := by
        apply Finset.sum_le_sum; intro J hJ
        gcongr
        rw [mul_comm, ← setLIntegral_const]
        apply setLIntegral_mono' (hEmeas J)
        intro x hx; exact hv J hJ x hx.1
    _ = (4 / 3) * ∫⁻ x in ⋃ J ∈ S, stopRemainder C cell bad J, F x := by
        rw [← Finset.mul_sum, lintegral_biUnion_finset
          (stopRemainder_disjoint hr hlam hinj hroots hne) (fun J _ => hEmeas J)]
    _ ≤ (4 / 3) * ∫⁻ x, F x := mul_le_mul_right (setLIntegral_le_lintegral _ _) _

end StoppingGenerations

/-- Blueprint lines 2911-2915: disjoint subcells `B ⊆ J` on which the average of `g = |f|^q`
exceeds `16` times its average on `J` have total length at most `|J|/16`:
`16 a_J^q Σ |B| < Σ ∫_B |f|^q ≤ a_J^q |J|`. -/
theorem stops_measure_le {ι : Type*} (J : Set ℝ) (s : Finset ι) (B : ι → Set ℝ)
    (hBJ : ∀ i ∈ s, B i ⊆ J) (hdisj : Set.PairwiseDisjoint (s : Set ι) B)
    (hmeas : ∀ i ∈ s, MeasurableSet (B i)) (g : ℝ → ℝ≥0∞)
    (hJ0 : volume J ≠ 0) (hJfin : volume J ≠ ∞) (hint : ∫⁻ x in J, g x ≠ ∞)
    (hBfin : ∀ i ∈ s, volume (B i) ≠ ∞)
    (hbad : ∀ i ∈ s, 16 * ((volume J)⁻¹ * ∫⁻ x in J, g x) <
      (volume (B i))⁻¹ * ∫⁻ x in B i, g x) :
    16 * ∑ i ∈ s, volume (B i) ≤ volume J := by
  classical
  set a := (volume J)⁻¹ * ∫⁻ x in J, g x
  have ha_top : a ≠ ∞ := ENNReal.mul_ne_top (ENNReal.inv_ne_top.mpr hJ0) hint
  have hBint : ∀ i ∈ s, 16 * a * volume (B i) ≤ ∫⁻ x in B i, g x := by
    intro i hi
    have h := (hbad i hi).le
    by_cases hB0 : volume (B i) = 0
    · rw [hB0, mul_zero]; exact bot_le
    calc 16 * a * volume (B i) ≤ (volume (B i))⁻¹ * (∫⁻ x in B i, g x) * volume (B i) := by
          gcongr
      _ = ∫⁻ x in B i, g x := by
          rw [mul_comm, ← mul_assoc, ENNReal.mul_inv_cancel hB0 (hBfin i hi), one_mul]
  have hsum : 16 * a * ∑ i ∈ s, volume (B i) ≤ ∫⁻ x in J, g x := by
    rw [Finset.mul_sum]
    calc ∑ i ∈ s, 16 * a * volume (B i) ≤ ∑ i ∈ s, ∫⁻ x in B i, g x :=
          Finset.sum_le_sum hBint
      _ = ∫⁻ x in ⋃ i ∈ s, B i, g x := (lintegral_biUnion_finset hdisj hmeas g).symm
      _ ≤ ∫⁻ x in J, g x := lintegral_mono_set (Set.iUnion₂_subset hBJ)
  rcases s.eq_empty_or_nonempty with hs | ⟨i₀, hi₀⟩
  · simp [hs]
  have hJint0 : ∫⁻ x in J, g x ≠ 0 := by
    intro hJint
    have h := hbad i₀ hi₀
    have hzero : ∫⁻ x in B i₀, g x = 0 :=
      le_antisymm (hJint ▸ lintegral_mono_set (hBJ i₀ hi₀)) bot_le
    have ha : a = 0 := by simp only [a, hJint, mul_zero]
    rw [hzero, mul_zero, ha, mul_zero] at h
    exact lt_irrefl _ h
  have ha0 : a ≠ 0 := mul_ne_zero (ENNReal.inv_ne_zero.mpr hJfin) hJint0
  have hJ : ∫⁻ x in J, g x = a * volume J := by
    simp only [a]
    rw [mul_comm, ← mul_assoc, ENNReal.mul_inv_cancel hJ0 hJfin, one_mul]
  rw [hJ] at hsum
  calc 16 * ∑ i ∈ s, volume (B i) = a⁻¹ * (16 * a * ∑ i ∈ s, volume (B i)) := by
        rw [mul_comm 16 a, mul_assoc, ← mul_assoc a⁻¹, ENNReal.inv_mul_cancel ha0 ha_top,
          one_mul]
    _ ≤ a⁻¹ * (a * volume J) := by gcongr
    _ = volume J := by rw [← mul_assoc, ENNReal.inv_mul_cancel ha0 ha_top, one_mul]

section ConcreteHull

/-- The index of the depth-`s` ancestor of the cell `I` (junk when `s > I.1`). -/
noncomputable def dyadicAncestorIndex (G : RealDyadicGrid) (I : ℤ × ℤ) (s : ℤ) : ℤ := by
  classical exact
    if h : s ≤ I.1 then Classical.choose (dyadicGridCell_ancestor G h I.2) else I.2

theorem dyadicAncestorIndex_spec (G : RealDyadicGrid) (I : ℤ × ℤ) {s : ℤ} (h : s ≤ I.1) :
    dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G s (dyadicAncestorIndex G I s) := by
  unfold dyadicAncestorIndex
  simp only [h, ↓reduceDIte]
  exact Classical.choose_spec (dyadicGridCell_ancestor G h I.2)

/-- A cell containing `I` at depth `s` is the ancestor of `I` at depth `s`. -/
theorem dyadicAncestorIndex_eq (G : RealDyadicGrid) {K I : ℤ × ℤ}
    (h : dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G K.1 K.2) :
    K.2 = dyadicAncestorIndex G I K.1 := by
  have hle := dyadicGridCell_depth_le_of_subset G I K h
  have hx := dyadicGridCell_left_mem G I.1 I.2
  exact dyadicGridCell_sameDepth_common_point G K.1 _ _ (h hx)
    (dyadicAncestorIndex_spec G I hle hx)

/-- The candidate cells: dyadic cells of depth at least `s₀` containing a used cell. -/
noncomputable def dyadicHullFamily (G : RealDyadicGrid) (cells : Finset (ℤ × ℤ)) (s₀ : ℤ) :
    Finset (ℤ × ℤ) :=
  cells.biUnion fun I => (Finset.Icc s₀ I.1).image fun s => (s, dyadicAncestorIndex G I s)

theorem mem_dyadicHullFamily (G : RealDyadicGrid) (cells : Finset (ℤ × ℤ)) (s₀ : ℤ)
    (K : ℤ × ℤ) : K ∈ dyadicHullFamily G cells s₀ ↔
      s₀ ≤ K.1 ∧ ∃ I ∈ cells, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G K.1 K.2 := by
  constructor
  · intro hK
    obtain ⟨I, hI, hK⟩ := Finset.mem_biUnion.mp hK
    obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hK
    obtain ⟨hs₀, hsI⟩ := Finset.mem_Icc.mp hs
    exact ⟨hs₀, I, hI, dyadicAncestorIndex_spec G I hsI⟩
  · rintro ⟨hs₀, I, hI, hIK⟩
    apply Finset.mem_biUnion.mpr
    refine ⟨I, hI, Finset.mem_image.mpr ⟨K.1, Finset.mem_Icc.mpr
      ⟨hs₀, dyadicGridCell_depth_le_of_subset G I K hIK⟩, ?_⟩⟩
    rw [← dyadicAncestorIndex_eq G hIK]

end ConcreteHull

/-- The average of `|f|^q` over the dyadic cell `K`. -/
noncomputable def cellPowAverage (G : RealDyadicGrid) (q : ℝ) (f : ℝ → ℂ) (K : ℤ × ℤ) : ℝ≥0∞ :=
  (volume (dyadicGridCell G K.1 K.2))⁻¹ * ∫⁻ x in dyadicGridCell G K.1 K.2, ‖f x‖ₑ ^ q

/-- `‖f‖_{q,K} = (avg_K |f|^q)^{1/q}`. -/
theorem cellLqNorm_eq (G : RealDyadicGrid) {q : ℝ} (hq : 0 < q) (f : ℝ → ℂ)
    (hf : Measurable f) (K : ℤ × ℤ) :
    cellLqNorm G q f K = cellPowAverage G q f K ^ (1 / q) := by
  have hr := dyadicGridLength_pos G K.1
  rw [cellLqNorm, eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ne_of_gt (ENNReal.ofReal_pos.mpr hq)) ENNReal.ofReal_ne_top hf.aestronglyMeasurable,
    ENNReal.toReal_ofReal hq.le, cellPowAverage, dyadicGridCell_volume]
  congr 1
  simp only [normalizedIntervalMeasure, lintegral_smul_measure, smul_eq_mul]
  rw [ENNReal.ofReal_inv_of_pos hr]
  congr 1
  rw [dyadicGridCell]
  exact (setLIntegral_congr Ico_ae_eq_Icc).symm

/-- Finite data restricted to a subset of its cells, with rescaled inputs. -/
noncomputable def FiniteDepthLocalData.restrictScale {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) (S : Finset (ℤ × ℤ)) (hS : S ⊆ D.cells)
    (c : Fin 4 → ℂ) : FiniteDepthLocalData κ q N where
  grid := D.grid
  cells := S
  firstDepth := D.firstDepth
  depths := fun I hI => D.depths I (hS hI)
  kernel := D.kernel
  admissible := fun I hI => D.admissible I (hS hI)
  input := fun j => c j • D.input j
  measurable_input := fun j => (D.measurable_input j).const_smul (c j)
  memLp_input := fun j => (D.memLp_input j).const_smul (c j)
  compact_input := fun j => (D.compact_input j).smul_left

theorem FiniteDepthLocalData.restrictScale_numerator {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) (S : Finset (ℤ × ℤ)) (hS : S ⊆ D.cells)
    (c : Fin 4 → ℂ) :
    finiteDepthNumerator (D.restrictScale S hS c) = ‖∏ j, c j‖ *
      ∑ I ∈ S, dyadicGridLength D.grid I.1 *
        ‖localProgressionForm (dyadicGridLength D.grid I.1) (D.kernel I) D.input‖ := by
  simp only [finiteDepthNumerator, FiniteDepthLocalData.restrictScale, Finset.mul_sum]
  apply Finset.sum_congr rfl; intro I _
  rw [show (fun j => c j • D.input j) = (fun j => c j • D.input j) from rfl,
    localProgressionForm_smul, norm_mul]
  ring

/-- Blueprint lines 2916-2918 (piece bound): if every cell of the subtree spanned by `S` under
`J` has `‖f_j‖_{q,K} ≤ b_j`, then normalized absorption applied to `f_j/(b_j + ε)` gives
`Σ_{I ∈ S} |I| |H_I(f)| ≤ (Π b_j) (A + c C_N) |J|`. -/
theorem piece_bound_of_normalized {κ : LocalKernelClass} {q : ℝ} {N : ℕ} {A c : ℝ}
    (hnorm : NormalizedAbsorption κ q N A c)
    (D : FiniteDepthLocalData κ q N) (S : Finset (ℤ × ℤ)) (hS : S ⊆ D.cells) (J : ℤ × ℤ)
    (hSJ : ∀ I ∈ S, dyadicGridCell D.grid I.1 I.2 ⊆ dyadicGridCell D.grid J.1 J.2)
    (b : Fin 4 → ℝ) (hb : ∀ j, 0 ≤ b j)
    (hloc : ∀ K ∈ dyadicHullCells D.grid S J, ∀ j,
      cellLqNorm D.grid q (D.input j) K ≤ ENNReal.ofReal (b j)) :
    ∑ I ∈ S, dyadicGridLength D.grid I.1 *
        ‖localProgressionForm (dyadicGridLength D.grid I.1) (D.kernel I) D.input‖ ≤
      (∏ j, b j) * (A + c * finiteDepthConstant κ q N) * dyadicGridLength D.grid J.1 := by
  set X := A + c * finiteDepthConstant κ q N
  set Spc := ∑ I ∈ S, dyadicGridLength D.grid I.1 *
        ‖localProgressionForm (dyadicGridLength D.grid I.1) (D.kernel I) D.input‖
  have hbound : ∀ ε : ℝ, 0 < ε → Spc ≤ (∏ j, (b j + ε)) * X * dyadicGridLength D.grid J.1 := by
    intro ε hε
    have ht : ∀ j, 0 < b j + ε := fun j => by linarith [hb j]
    set D' := D.restrictScale S hS (fun j => (((b j + ε)⁻¹ : ℝ) : ℂ))
    have hnum := D.restrictScale_numerator S hS (fun j => (((b j + ε)⁻¹ : ℝ) : ℂ))
    have hD' := hnorm D' J hSJ (fun K hK j => by
      change cellLqNorm D.grid q ((((b j + ε)⁻¹ : ℝ) : ℂ) • D.input j) K ≤ 1
      rw [cellLqNorm, eLpNorm_const_smul, ← cellLqNorm]
      calc ‖(((b j + ε)⁻¹ : ℝ) : ℂ)‖ₑ * cellLqNorm D.grid q (D.input j) K ≤
          ENNReal.ofReal (b j + ε)⁻¹ * ENNReal.ofReal (b j) := by
            gcongr
            · rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg (inv_nonneg.mpr (ht j).le)]
            · exact hloc K hK j
        _ ≤ 1 := by
            rw [← ENNReal.ofReal_mul (inv_nonneg.mpr (ht j).le)]
            apply ENNReal.ofReal_le_one.mpr
            rw [inv_mul_le_iff₀ (ht j)]; linarith only [hε])
    rw [hnum] at hD'
    have hprod : ‖∏ j, (((b j + ε)⁻¹ : ℝ) : ℂ)‖ = (∏ j, (b j + ε))⁻¹ := by
      rw [norm_prod]
      simp only [Complex.norm_real, Real.norm_eq_abs, abs_inv]
      rw [← Finset.prod_inv_distrib]
      apply Finset.prod_congr rfl; intro j _
      rw [abs_of_pos (ht j)]
    rw [hprod] at hD'
    have hP : 0 < ∏ j, (b j + ε) := Finset.prod_pos fun j _ => ht j
    rw [inv_mul_le_iff₀ hP] at hD'
    calc Spc ≤ (∏ j, (b j + ε)) * (X * dyadicGridLength D.grid J.1) := hD'
      _ = _ := by ring
  -- let `ε → 0`
  have hcont : Filter.Tendsto (fun ε : ℝ => (∏ j, (b j + ε)) * X * dyadicGridLength D.grid J.1)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds ((∏ j, b j) * X * dyadicGridLength D.grid J.1)) := by
    apply tendsto_nhdsWithin_of_tendsto_nhds
    have : Continuous fun ε : ℝ => (∏ j, (b j + ε)) * X * dyadicGridLength D.grid J.1 := by
      fun_prop
    simpa using this.tendsto 0
  exact ge_of_tendsto hcont (Filter.eventually_of_mem self_mem_nhdsWithin fun ε hε => hbound ε hε)

/-- The first stops of a cell are pairwise disjoint. -/
theorem firstStops_pairwiseDisjoint {α : Type*} {C : Finset α} {cell : α → Set ℝ}
    {bad : α → α → Prop} [∀ J K, Decidable (bad J K)]
    (hlam : ∀ K ∈ C, ∀ L ∈ C, cell K ⊆ cell L ∨ cell L ⊆ cell K ∨ Disjoint (cell K) (cell L))
    (hinj : ∀ K ∈ C, ∀ L ∈ C, cell K = cell L → K = L) (J : α) :
    Set.PairwiseDisjoint (firstStops C cell bad J : Set α) cell := by
  intro K hK L hL hKL
  have h1 := mem_firstStops.mp hK
  have h2 := mem_firstStops.mp hL
  rcases hlam K h1.1.1 L h2.1.1 with h | h | h
  · exfalso
    exact h1.2 ⟨L, h2.1.1, LE.le.ssubset_of_ne h (fun he => hKL (hinj K h1.1.1 L h2.1.1 he)),
      h2.1.2.1, h2.1.2.2⟩
  · exfalso
    exact h2.2 ⟨K, h1.1.1, LE.le.ssubset_of_ne h
      (fun he => hKL (hinj L h2.1.1 K h1.1.1 he).symm), h1.1.2.1, h1.1.2.2⟩
  · exact h

/-- The `q`-th power integral of a finite-depth input is finite. -/
theorem finiteDepth_input_lintegral_ne_top {κ : LocalKernelClass} {q : ℝ} {N : ℕ} (hq : 0 < q)
    (D : FiniteDepthLocalData κ q N) (j : Fin 4) (s : Set ℝ) :
    ∫⁻ x in s, ‖D.input j x‖ₑ ^ q ≠ ∞ := by
  have h := lintegral_rpow_enorm_lt_top_of_eLpNorm_lt_top
    (ne_of_gt (ENNReal.ofReal_pos.mpr hq)) ENNReal.ofReal_ne_top (D.memLp_input j)
  rw [ENNReal.toReal_ofReal hq.le] at h
  exact ne_top_of_le_ne_top h.ne (setLIntegral_le_lintegral _ _)

theorem cellPowAverage_ne_top {κ : LocalKernelClass} {q : ℝ} {N : ℕ} (hq : 0 < q)
    (D : FiniteDepthLocalData κ q N) (j : Fin 4) (K : ℤ × ℤ) :
    cellPowAverage D.grid q (D.input j) K ≠ ∞ := by
  apply ENNReal.mul_ne_top _ (finiteDepth_input_lintegral_ne_top hq D j _)
  rw [dyadicGridCell_volume]
  exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_pos.mpr (dyadicGridLength_pos _ _)).ne'

theorem cellLqNorm_ne_top {κ : LocalKernelClass} {q : ℝ} {N : ℕ} (hq : 0 < q)
    (D : FiniteDepthLocalData κ q N) (j : Fin 4) (K : ℤ × ℤ) :
    cellLqNorm D.grid q (D.input j) K ≠ ∞ := by
  rw [cellLqNorm_eq D.grid hq _ (D.measurable_input j)]
  exact ENNReal.rpow_ne_top_of_nonneg (by positivity) (cellPowAverage_ne_top hq D j K)

/-- Blueprint `thm:uniform-local`, lines 2910-2925: normalized absorption implies, for every
finite-depth datum, `Σ_I |I| |H_I(f)| ≤ (4/3) 16^{4/q} (A + c C_N) ∫ Π_j M_q f_j`. -/
theorem numerator_le_of_normalized {κ : LocalKernelClass} {q : ℝ} {N : ℕ} {A c : ℝ}
    (hq : 2 ≤ q) (hnorm : NormalizedAbsorption κ q N A c)
    (hX : 0 ≤ A + c * finiteDepthConstant κ q N) (D : FiniteDepthLocalData κ q N) :
    ENNReal.ofReal (finiteDepthNumerator D) ≤
      ENNReal.ofReal (4 / 3 * 16 ^ (4 / q) * (A + c * finiteDepthConstant κ q N)) *
        finiteDepthDenominator D := by
  classical
  have hq0 : 0 < q := by linarith
  set G := D.grid
  set f := D.input
  set X := A + c * finiteDepthConstant κ q N
  set cellS : ℤ × ℤ → Set ℝ := fun K => dyadicGridCell G K.1 K.2
  set Cf := dyadicHullFamily G D.cells D.firstDepth
  set roots := Cf.filter fun K => K.1 = D.firstDepth
  set bad : ℤ × ℤ → ℤ × ℤ → Prop := fun J K =>
    ∃ j, 16 * cellPowAverage G q (f j) J < cellPowAverage G q (f j) K
  set Sset := stopCells Cf cellS bad roots
  -- structural facts
  have hlam : ∀ K ∈ Cf, ∀ L ∈ Cf, cellS K ⊆ cellS L ∨ cellS L ⊆ cellS K ∨
      Disjoint (cellS K) (cellS L) := by
    intro K _ L _
    rcases dyadicGridCell_laminar G K L with h | h | h
    · exact Or.inr (Or.inr h)
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
  have hinj : ∀ K ∈ Cf, ∀ L ∈ Cf, cellS K = cellS L → K = L :=
    fun K _ L _ h => dyadicGridCell_injective G h
  have hroots : ∀ R ∈ roots, ∀ R' ∈ roots, R ≠ R' → Disjoint (cellS R) (cellS R') := by
    intro R hR R' hR' hne
    have h1 := (Finset.mem_filter.mp hR).2
    have h2 := (Finset.mem_filter.mp hR').2
    have h2' : R.2 ≠ R'.2 := fun h => hne (Prod.ext (h1.trans h2.symm) h)
    have := dyadicGridCell_pairwiseDisjoint G R.1 h2'
    simpa [cellS, h1, h2] using this
  have hne : ∀ K, (cellS K).Nonempty := fun K => ⟨_, dyadicGridCell_left_mem G K.1 K.2⟩
  have hmeas : ∀ K, MeasurableSet (cellS K) := fun K => dyadicGridCell_measurable G K.1 K.2
  have hfin : ∀ K, volume (cellS K) ≠ ∞ := fun K => by
    simp only [cellS, dyadicGridCell_volume]; exact ENNReal.ofReal_ne_top
  have hrC : roots ⊆ Cf := Finset.filter_subset _ _
  have hS_mem : ∀ J, J ∈ Sset ↔ J ∈ Cf ∧ ∃ k, J ∈ stopGen Cf cellS bad roots k := by
    intro J; simp [Sset, stopCells]
  have hstops_S : ∀ J ∈ Sset, firstStops Cf cellS bad J ⊆ Sset := by
    intro J hJ B hB
    obtain ⟨-, k, hk⟩ := (hS_mem J).mp hJ
    exact (hS_mem B).mpr ⟨firstStops_subset J hB, k + 1, Finset.mem_biUnion.mpr ⟨J, hk, hB⟩⟩
  -- every used cell has a root and a deepest stopping ancestor
  have hrootsS : roots ⊆ Sset := fun R hR => (hS_mem R).mpr ⟨hrC hR, 0, hR⟩
  have hroot : ∀ I ∈ D.cells, ∃ R ∈ roots, cellS I ⊆ cellS R := by
    intro I hI
    have hle := (D.depths I hI).1
    refine ⟨(D.firstDepth, dyadicAncestorIndex G I D.firstDepth), Finset.mem_filter.mpr
      ⟨(mem_dyadicHullFamily G D.cells D.firstDepth _).mpr
        ⟨le_rfl, I, hI, dyadicAncestorIndex_spec G I hle⟩, rfl⟩,
      dyadicAncestorIndex_spec G I hle⟩
  have htop : ∀ I ∈ D.cells, ∃ J ∈ Sset, cellS I ⊆ cellS J ∧
      ∀ J' ∈ Sset, cellS I ⊆ cellS J' → J'.1 ≤ J.1 := by
    intro I hI
    obtain ⟨R, hR, hIR⟩ := hroot I hI
    obtain ⟨J, hJ, hmax⟩ := (Sset.filter fun J => cellS I ⊆ cellS J).exists_max_image
      (fun J => J.1) ⟨R, Finset.mem_filter.mpr ⟨hrootsS hR, hIR⟩⟩
    obtain ⟨hJS, hIJ⟩ := Finset.mem_filter.mp hJ
    exact ⟨J, hJS, hIJ, fun J' hJ' hIJ' => hmax J' (Finset.mem_filter.mpr ⟨hJ', hIJ'⟩)⟩
  choose! top htopS htopI htopmax using htop
  have hnostrict : ∀ I ∈ D.cells, ∀ L ∈ Sset, cellS I ⊆ cellS L → ¬cellS L ⊂ cellS (top I) := by
    intro I hI L hL hIL hss
    have h1 := dyadicGridCell_depth_le_of_subset G L (top I) hss.subset
    have h2 := htopmax I hI L hL hIL
    have heq : L.1 = (top I).1 := le_antisymm h2 h1
    have hx := dyadicGridCell_left_mem G I.1 I.2
    have h3 : L.2 = (top I).2 := dyadicGridCell_sameDepth_common_point G L.1 _ _ (hIL hx)
      (by rw [heq]; exact htopI I hI hx)
    exact hss.2 (by rw [show L = top I from Prod.ext heq h3])
  have hnotbad : ∀ I ∈ D.cells, ∀ K ∈ Cf, cellS I ⊆ cellS K → cellS K ⊂ cellS (top I) →
      ¬bad (top I) K := by
    intro I hI K hK hIK hKJ hb
    obtain ⟨L, hL, hKL⟩ := exists_firstStop_above (C := Cf) (cell := cellS) hK hKJ hb
    have hLm := mem_firstStops.mp hL
    exact hnostrict I hI L (hstops_S _ (htopS I hI) hL) (hIK.trans hKL) hLm.1.2.1
  -- the first stops cover at most a quarter of each stopping cell
  have hquarter : ∀ J ∈ Sset,
      4 * volume (⋃ B ∈ firstStops Cf cellS bad J, cellS B) ≤ volume (cellS J) := by
    intro J hJ
    set St := firstStops Cf cellS bad J
    have hwit : ∀ B ∈ St, ∃ j, 16 * cellPowAverage G q (f j) J < cellPowAverage G q (f j) B :=
      fun B hB => (mem_firstStops.mp hB).1.2.2
    choose! w hw using hwit
    have hV0 : volume (cellS J) ≠ 0 := by
      simp only [cellS, dyadicGridCell_volume]
      exact (ENNReal.ofReal_pos.mpr (dyadicGridLength_pos G _)).ne'
    have hdisj := firstStops_pairwiseDisjoint (bad := bad) hlam hinj J
    have hpart : ∀ j : Fin 4, ∑ B ∈ St.filter (fun B => w B = j), volume (cellS B) ≤
        volume (cellS J) / 16 := by
      intro j
      rw [ENNReal.le_div_iff_mul_le (Or.inl (by norm_num)) (Or.inl (by norm_num)), mul_comm]
      apply stops_measure_le (cellS J) _ cellS
        (fun B hB => (mem_firstStops.mp (Finset.mem_filter.mp hB).1).1.2.1.subset)
        (hdisj.subset (fun B hB => (Finset.mem_filter.mp hB).1)) (fun B _ => hmeas B)
        (fun x => ‖f j x‖ₑ ^ q) hV0 (hfin J)
        (finiteDepth_input_lintegral_ne_top hq0 D j _) (fun B _ => hfin B)
      intro B hB
      obtain ⟨hBS, hBj⟩ := Finset.mem_filter.mp hB
      have := hw B hBS
      rw [hBj] at this
      exact this
    calc 4 * volume (⋃ B ∈ St, cellS B) ≤ 4 * ∑ B ∈ St, volume (cellS B) := by
          gcongr; exact measure_biUnion_finset_le _ _
      _ = 4 * ∑ j : Fin 4, ∑ B ∈ St.filter (fun B => w B = j), volume (cellS B) := by
          rw [Finset.sum_fiberwise]
      _ ≤ 4 * ∑ _j : Fin 4, volume (cellS J) / 16 := by gcongr with j; exact hpart j
      _ = volume (cellS J) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, ← mul_assoc,
            show (4 : ℝ≥0∞) * (4 : ℕ) = 16 by norm_num,
            ENNReal.mul_div_cancel (by norm_num) (by norm_num)]
  -- local sizes `a_{j,J}` and the piece bound
  set! a : Fin 4 → ℤ × ℤ → ℝ := fun j J => (cellLqNorm G q (f j) J).toReal
  have ha0 : ∀ j J, 0 ≤ a j J := fun j J => ENNReal.toReal_nonneg
  have h16 : (0 : ℝ) ≤ 16 ^ (1 / q) := by positivity
  have hSC : ∀ J ∈ Sset, J ∈ Cf := fun J hJ => ((hS_mem J).mp hJ).1
  have hpiece : ∀ J ∈ Sset,
      ∑ I ∈ D.cells.filter (fun I => top I = J), dyadicGridLength G I.1 *
        ‖localProgressionForm (dyadicGridLength G I.1) (D.kernel I) f‖ ≤
      (∏ j, (16 ^ (1 / q) * a j J)) * X * dyadicGridLength G J.1 := by
    intro J hJ
    apply piece_bound_of_normalized hnorm D _ (Finset.filter_subset _ _) J
    · intro I hI
      obtain ⟨hIc, hIJ⟩ := Finset.mem_filter.mp hI
      rw [← hIJ]; exact htopI I hIc
    · intro j; exact mul_nonneg h16 (ha0 j J)
    · rintro K ⟨hKJ, I, hI, hIK⟩ j
      obtain ⟨hIc, hIJ⟩ := Finset.mem_filter.mp hI
      have hKC : K ∈ Cf := by
        refine (mem_dyadicHullFamily G D.cells D.firstDepth K).mpr ⟨?_, I, hIc, hIK⟩
        have h1 := ((mem_dyadicHullFamily G D.cells D.firstDepth J).mp (hSC J hJ)).1
        exact h1.trans (dyadicGridCell_depth_le_of_subset G K J hKJ)
      have havg : cellPowAverage G q (f j) K ≤ 16 * cellPowAverage G q (f j) J := by
        by_cases hKeq : K = J
        · rw [hKeq]; exact le_mul_of_one_le_left bot_le (by norm_num)
        · have hss : cellS K ⊂ cellS (top I) := by
            rw [hIJ]
            exact LE.le.ssubset_of_ne hKJ (fun he => hKeq (dyadicGridCell_injective G he))
          have hnb := hnotbad I hIc K hKC hIK hss
          rw [hIJ] at hnb
          by_contra hlt
          exact hnb ⟨j, lt_of_not_ge hlt⟩
      rw [cellLqNorm_eq G hq0 _ (D.measurable_input j)]
      have hfinJ := cellLqNorm_ne_top hq0 D j J
      calc cellPowAverage G q (f j) K ^ (1 / q) ≤ (16 * cellPowAverage G q (f j) J) ^ (1 / q) :=
            ENNReal.rpow_le_rpow havg (by positivity)
        _ = ENNReal.ofReal (16 ^ (1 / q)) * cellLqNorm G q (f j) J := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
              cellLqNorm_eq G hq0 _ (D.measurable_input j),
              ← ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by positivity)]
            norm_num
            rfl
        _ = ENNReal.ofReal (16 ^ (1 / q) * a j J) := by
            rw [ENNReal.ofReal_mul h16, ENNReal.ofReal_toReal hfinJ]
  -- sum the pieces over the stopping cells
  have hprod16 : ∀ J, ∏ j, (16 ^ (1 / q) * a j J) = 16 ^ (4 / q) * ∏ j, a j J := by
    intro J
    rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
      ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 16)]
    congr 2
    push_cast
    ring
  have hreal : finiteDepthNumerator D ≤
      16 ^ (4 / q) * X * ∑ J ∈ Sset, dyadicGridLength G J.1 * ∏ j, a j J := by
    unfold finiteDepthNumerator
    rw [← Finset.sum_fiberwise_of_maps_to (g := top) (fun I hI => htopS I hI)]
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum; intro J hJ
    refine (hpiece J hJ).trans (le_of_eq ?_)
    rw [hprod16]; ring
  -- the sparse bound
  have hsparse := stop_sparse_bound hrC hlam hinj hroots hne hmeas hfin hquarter
    (fun x => ∏ j, scalarMaximalQ q (f j) x) (fun J => ENNReal.ofReal (∏ j, a j J))
    (by
      intro J _ x hx
      rw [ENNReal.ofReal_prod_of_nonneg (fun j _ => ha0 j J)]
      apply Finset.prod_le_prod
      intro j _
      rw [ENNReal.ofReal_toReal (cellLqNorm_ne_top hq0 D j J)]
      exact localLpNorm_le_scalarMaximalQ (dyadicGridLength_pos G J.1) hq0
        (Set.Ico_subset_Icc_self hx) (f j) (D.measurable_input j))
  have hsum_eq : ENNReal.ofReal (∑ J ∈ Sset, dyadicGridLength G J.1 * ∏ j, a j J) =
      ∑ J ∈ Sset, volume (cellS J) * ENNReal.ofReal (∏ j, a j J) := by
    rw [ENNReal.ofReal_sum_of_nonneg (fun J _ => mul_nonneg (dyadicGridLength_pos G _).le
      (Finset.prod_nonneg fun j _ => ha0 j J))]
    apply Finset.sum_congr rfl; intro J _
    rw [ENNReal.ofReal_mul (dyadicGridLength_pos G _).le]
    simp only [cellS, dyadicGridCell_volume]
  have hC0 : (0 : ℝ) ≤ 16 ^ (4 / q) * X := mul_nonneg (by positivity) hX
  calc ENNReal.ofReal (finiteDepthNumerator D) ≤
      ENNReal.ofReal (16 ^ (4 / q) * X * ∑ J ∈ Sset, dyadicGridLength G J.1 * ∏ j, a j J) :=
        ENNReal.ofReal_le_ofReal hreal
    _ = ENNReal.ofReal (16 ^ (4 / q) * X) *
        ∑ J ∈ Sset, volume (cellS J) * ENNReal.ofReal (∏ j, a j J) := by
        rw [ENNReal.ofReal_mul hC0, hsum_eq]
    _ ≤ ENNReal.ofReal (16 ^ (4 / q) * X) * ((4 / 3) * finiteDepthDenominator D) := by
        gcongr
        exact hsparse
    _ = ENNReal.ofReal (4 / 3 * 16 ^ (4 / q) * X) * finiteDepthDenominator D := by
        rw [show (4 / 3 : ℝ≥0∞) = ENNReal.ofReal (4 / 3) by
          rw [ENNReal.ofReal_div_of_pos (by norm_num)]; norm_num, ← mul_assoc,
          ← ENNReal.ofReal_mul hC0]
        congr 2; ring

/-- Blueprint `thm:uniform-local` (lines 2906-2932), from `prop:normalized`: if normalized
absorption holds at every depth `N` with constants `A, c` independent of `N` and
`C c ≤ 1/2` for `C = (4/3) 16^{4/q}`, then `C_N(q) ≤ 2 + 2 C A` for every `N`. -/
theorem uniform_local_of_normalized (κ : LocalKernelClass) {q : ℝ} (hq : 2 ≤ q) {A c : ℝ}
    (hA : 0 ≤ A) (hc : 0 ≤ c) (hsmall : 4 / 3 * 16 ^ (4 / q) * c ≤ 1 / 2)
    (hnorm : ∀ N, NormalizedAbsorption κ q N A c) (N : ℕ) :
    finiteDepthConstant κ q N ≤ 2 + 2 * (4 / 3 * 16 ^ (4 / q)) * A := by
  set CN := finiteDepthConstant κ q N
  set K : ℝ := 4 / 3 * 16 ^ (4 / q)
  have hK : 0 ≤ K := by positivity
  have hCN1 : 1 ≤ CN := (finiteDepthConstant_bounds κ hq N).1
  have hX : 0 ≤ A + c * CN := by positivity
  have hle : CN ≤ 1 + K * (A + c * CN) := by
    apply finiteDepthConstant_least (by nlinarith only [mul_nonneg hK hX])
    intro D
    refine (numerator_le_of_normalized hq (hnorm N) hX D).trans ?_
    gcongr
    change K * (A + c * CN) ≤ 1 + K * (A + c * CN)
    linarith only
  exact uniform_constant_absorption (C := K) (by nlinarith only [hle]) hsmall
    (by linarith only [hCN1])

/-! ### The kernel with four zero marginals (thm:main, blueprint lines 2944-2950) -/

/-- The derivative `(∂_S - j ∂_X) g`, i.e. along the direction `(-j, 1)`. -/
noncomputable def progDeriv (j : ℝ) (g : ℝ × ℝ → ℂ) (p : ℝ × ℝ) : ℂ :=
  fderiv ℝ g p (-j, 1)

theorem progDeriv_contDiff {j : ℝ} {g : ℝ × ℝ → ℂ} (hg : ContDiff ℝ (⊤ : ℕ∞) g) :
    ContDiff ℝ (⊤ : ℕ∞) (progDeriv j g) := by
  have := hg.fderiv_right (m := (⊤ : ℕ∞)) le_rfl
  exact this.clm_apply contDiff_const

theorem progDeriv_hasCompactSupport {j : ℝ} {g : ℝ × ℝ → ℂ} (hg : HasCompactSupport g) :
    HasCompactSupport (progDeriv j g) :=
  (hg.fderiv (𝕜 := ℝ)).mono' fun p hp => by
    by_contra h
    apply hp
    simp [progDeriv, image_eq_zero_of_notMem_tsupport h]

/-- The directional derivatives commute on smooth functions (symmetric second derivative). -/
theorem progDeriv_comm (a b : ℝ) {g : ℝ × ℝ → ℂ} (hg : ContDiff ℝ (⊤ : ℕ∞) g) :
    progDeriv a (progDeriv b g) = progDeriv b (progDeriv a g) := by
  funext p
  have hd : ∀ v : ℝ × ℝ, fderiv ℝ (fun q => fderiv ℝ g q v) p =
      (fderiv ℝ (fderiv ℝ g) p).flip v := by
    intro v
    have h1 : DifferentiableAt ℝ (fderiv ℝ g) p :=
      (hg.fderiv_right (m := 1) (by norm_cast)).differentiable
        (by norm_num) p
    rw [fderiv_clm_apply h1 (differentiableAt_const v)]
    simp
  simp only [progDeriv]
  change fderiv ℝ (fun q => fderiv ℝ g q (-b, 1)) p (-a, 1) =
    fderiv ℝ (fun q => fderiv ℝ g q (-a, 1)) p (-b, 1)
  rw [hd, hd]
  simp only [ContinuousLinearMap.flip_apply]
  have hs := (hg.contDiffAt (x := p)).isSymmSndFDerivAt (n := (⊤ : ℕ∞))
    (by simp)
  exact hs _ _

/-- Blueprint line 2947: `∫ ((∂_S - j ∂_X) g)(u - jS, S) dS = 0` for compactly supported `C¹`
functions, since the integrand is the derivative of `S ↦ g(u - jS, S)`. -/
theorem integral_progDeriv_eq_zero (j u : ℝ) {g : ℝ × ℝ → ℂ} (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hgc : HasCompactSupport g) : ∫ S : ℝ, progDeriv j g (u - j * S, S) = 0 := by
  set γ : ℝ → ℝ × ℝ := fun S => (u - j * S, S)
  have hγ : ∀ S, HasDerivAt γ (-j, 1) S := by
    intro S
    have h1 : HasDerivAt (fun S : ℝ => u - j * S) (-j) S := by
      simpa using ((hasDerivAt_id S).const_mul j).const_sub u
    exact h1.prodMk (hasDerivAt_id S)
  have hderiv : ∀ S, HasDerivAt (fun S => g (γ S)) (progDeriv j g (γ S)) S := by
    intro S
    have := (hg.differentiable (by simp)).differentiableAt.hasFDerivAt.comp_hasDerivAt S (hγ S)
    exact this
  -- compact supports of the restrictions to the line
  have hcomp : ∀ h : ℝ × ℝ → ℂ, HasCompactSupport h → Continuous h →
      Integrable fun S => h (γ S) := by
    intro h hhc hcont
    have hγc : Continuous γ := by fun_prop
    apply Continuous.integrable_of_hasCompactSupport (hcont.comp hγc)
    refine HasCompactSupport.intro (hhc.isCompact.image continuous_snd) fun S hS => ?_
    by_contra hne
    exact hS ⟨γ S, subset_tsupport _ hne, rfl⟩
  have hint' := hcomp _ (progDeriv_hasCompactSupport hgc)
    (progDeriv_contDiff (j := j) hg).continuous
  have hint := hcomp g hgc hg.continuous
  exact integral_eq_zero_of_hasDerivAt_of_integrable hderiv hint' hint

/-- Blueprint line 2944: `W = Π_{j=0}^3 (∂_S - j ∂_X) g`. -/
noncomputable def fourMarginalKernel (g : ℝ × ℝ → ℂ) : ℝ × ℝ → ℂ :=
  progDeriv 0 (progDeriv 1 (progDeriv 2 (progDeriv 3 g)))

/-- Blueprint lines 2945-2950: for a smooth compactly supported `g`, the kernel
`W = Π_j (∂_S - j ∂_X) g` has the four zero marginals `∫ W(u - jS, S) dS = 0`, `j = 0, 1, 2, 3`
(the constant-coefficient derivatives commute, so each factor can be taken outermost). -/
theorem fourMarginalKernel_marginal {g : ℝ × ℝ → ℂ} (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hgc : HasCompactSupport g) (u : ℝ) (j : Fin 4) :
    ∫ S : ℝ, fourMarginalKernel g (u - (j : ℝ) * S, S) = 0 := by
  have s : ∀ (a : ℝ) {h : ℝ × ℝ → ℂ}, ContDiff ℝ (⊤ : ℕ∞) h →
      ContDiff ℝ (⊤ : ℕ∞) (progDeriv a h) := fun a _ hh => progDeriv_contDiff hh
  have c : ∀ (a : ℝ) {h : ℝ × ℝ → ℂ}, HasCompactSupport h →
      HasCompactSupport (progDeriv a h) := fun a _ hh => progDeriv_hasCompactSupport hh
  fin_cases j
  · simpa [fourMarginalKernel] using
      integral_progDeriv_eq_zero 0 u (s 1 (s 2 (s 3 hg))) (c 1 (c 2 (c 3 hgc)))
  · have e : fourMarginalKernel g = progDeriv 1 (progDeriv 0 (progDeriv 2 (progDeriv 3 g))) := by
      unfold fourMarginalKernel
      rw [progDeriv_comm 0 1 (s 2 (s 3 hg))]
    rw [e]
    simpa using integral_progDeriv_eq_zero 1 u (s 0 (s 2 (s 3 hg))) (c 0 (c 2 (c 3 hgc)))
  · have e : fourMarginalKernel g = progDeriv 2 (progDeriv 0 (progDeriv 1 (progDeriv 3 g))) := by
      unfold fourMarginalKernel
      rw [progDeriv_comm 1 2 (s 3 hg), progDeriv_comm 0 2 (s 1 (s 3 hg))]
    rw [e]
    simpa using integral_progDeriv_eq_zero 2 u (s 0 (s 1 (s 3 hg))) (c 0 (c 1 (c 3 hgc)))
  · have e : fourMarginalKernel g = progDeriv 3 (progDeriv 0 (progDeriv 1 (progDeriv 2 g))) := by
      unfold fourMarginalKernel
      rw [progDeriv_comm 2 3 hg, progDeriv_comm 1 3 (s 2 hg), progDeriv_comm 0 3 (s 1 (s 2 hg))]
    rw [e]
    simpa using integral_progDeriv_eq_zero 3 u (s 0 (s 1 (s 2 hg))) (c 0 (c 1 (c 2 hgc)))

/-! ### The partition sum of the kernel (thm:main, blueprint lines 2951-2955) -/

theorem progDeriv_eventuallyEq {j : ℝ} {f g : ℝ × ℝ → ℂ} {p : ℝ × ℝ} (h : f =ᶠ[nhds p] g) :
    progDeriv j f =ᶠ[nhds p] progDeriv j g :=
  (h.fderiv (𝕜 := ℝ)).mono fun q hq => by simp only [progDeriv, hq]

theorem fourMarginalKernel_eventuallyEq {f g : ℝ × ℝ → ℂ} {p : ℝ × ℝ}
    (h : f =ᶠ[nhds p] g) : fourMarginalKernel f p = fourMarginalKernel g p :=
  (progDeriv_eventuallyEq (progDeriv_eventuallyEq (progDeriv_eventuallyEq
    (progDeriv_eventuallyEq h)))).eq_of_nhds

theorem progDeriv_sum {ι : Type*} (s : Finset ι) (g : ι → ℝ × ℝ → ℂ) (j : ℝ)
    (hg : ∀ i ∈ s, Differentiable ℝ (g i)) :
    progDeriv j (fun p => ∑ i ∈ s, g i p) = fun p => ∑ i ∈ s, progDeriv j (g i) p := by
  funext p
  simp only [progDeriv]
  rw [fderiv_fun_sum (fun i hi => (hg i hi).differentiableAt)]
  simp

theorem fourMarginalKernel_sum {ι : Type*} (s : Finset ι) (g : ι → ℝ × ℝ → ℂ)
    (hg : ∀ i ∈ s, ContDiff ℝ (⊤ : ℕ∞) (g i)) :
    fourMarginalKernel (fun p => ∑ i ∈ s, g i p) =
      fun p => ∑ i ∈ s, fourMarginalKernel (g i) p := by
  have d : ∀ (a : ℝ) {h : ℝ × ℝ → ℂ}, ContDiff ℝ (⊤ : ℕ∞) h → Differentiable ℝ h :=
    fun _ _ hh => hh.differentiable (by simp)
  have sm : ∀ (a : ℝ) {h : ℝ × ℝ → ℂ}, ContDiff ℝ (⊤ : ℕ∞) h →
      ContDiff ℝ (⊤ : ℕ∞) (progDeriv a h) := fun a _ hh => progDeriv_contDiff hh
  unfold fourMarginalKernel
  rw [progDeriv_sum s g 3 (fun i hi => d 0 (hg i hi)),
    progDeriv_sum s _ 2 (fun i hi => d 0 (sm 3 (hg i hi))),
    progDeriv_sum s _ 1 (fun i hi => d 0 (sm 2 (sm 3 (hg i hi)))),
    progDeriv_sum s _ 0 (fun i hi => d 0 (sm 1 (sm 2 (sm 3 (hg i hi)))))]

/-- On functions of `S` alone, `∂_S - j ∂_X` is `d/dS`. -/
theorem progDeriv_snd {j : ℝ} {φ : ℝ → ℂ} (hφ : Differentiable ℝ φ) :
    progDeriv j (fun p : ℝ × ℝ => φ p.2) = fun p => deriv φ p.2 := by
  funext p
  simp only [progDeriv]
  have h : HasFDerivAt (fun p : ℝ × ℝ => φ p.2)
      ((ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) (deriv φ p.2)).comp
        (ContinuousLinearMap.snd ℝ ℝ ℝ)) p :=
    (hφ p.2).hasDerivAt.hasFDerivAt.comp p hasFDerivAt_snd
  rw [h.fderiv]
  simp

theorem fourMarginalKernel_snd {φ : ℝ → ℂ} (hφ : ContDiff ℝ (⊤ : ℕ∞) φ) :
    fourMarginalKernel (fun p : ℝ × ℝ => φ p.2) = fun p => iteratedDeriv 4 φ p.2 := by
  have d : ∀ n : ℕ, Differentiable ℝ (iteratedDeriv n φ) := fun n =>
    hφ.differentiable_iteratedDeriv n (WithTop.coe_lt_coe.mpr (ENat.natCast_lt_top n))
  unfold fourMarginalKernel
  rw [progDeriv_snd (by simpa using d 0),
    show deriv φ = iteratedDeriv 1 φ by simp,
    progDeriv_snd (d 1), ← iteratedDeriv_succ,
    progDeriv_snd (d 2), ← iteratedDeriv_succ,
    progDeriv_snd (d 3), ← iteratedDeriv_succ]

theorem fourMarginalKernel_zero : fourMarginalKernel (fun _ : ℝ × ℝ => (0 : ℂ)) = 0 := by
  have h : ∀ j : ℝ, progDeriv j (fun _ : ℝ × ℝ => (0 : ℂ)) = fun _ => 0 := by
    intro j; funext p; simp [progDeriv]
  unfold fourMarginalKernel
  rw [h, h, h, h]; rfl

/-- Blueprint lines 2951-2955: for a smooth integer partition of unity `ω` supported in
`(-1, 1)` and smooth `φ`, the translates of `W = Π_j (∂_S - j∂_X)[ω(X) φ(S)]` sum to
`Σ_m W(x - m, s) = φ⁽⁴⁾(s)` (a locally finite sum). -/
theorem fourMarginalKernel_partition_sum {ω : ℝ → ℝ} (hω : ContDiff ℝ (⊤ : ℕ∞) ω)
    (hsupp : ∀ x, 1 ≤ |x| → ω x = 0) (hsum : ∀ x, ∑' k : ℤ, ω (x - k) = 1) {φ : ℝ → ℂ}
    (hφ : ContDiff ℝ (⊤ : ℕ∞) φ) (x s : ℝ) :
    ∑' m : ℤ, fourMarginalKernel (fun p => (ω (p.1 - m) : ℂ) * φ p.2) (x, s) =
      iteratedDeriv 4 φ s := by
  classical
  set g : ℤ → ℝ × ℝ → ℂ := fun m p => (ω (p.1 - m) : ℂ) * φ p.2
  set F := Finset.Icc (⌊x⌋ - 2) (⌊x⌋ + 2)
  have hfl := Int.floor_le x
  have hfl' := Int.lt_floor_add_one x
  -- terms outside `F` vanish near the point
  have hfar : ∀ m ∉ F, ∀ X : ℝ, |X - x| < 1 → ω (X - m) = 0 := by
    intro m hm X hX
    apply hsupp
    simp only [F, Finset.mem_Icc, not_and_or, not_le] at hm
    rw [abs_lt] at hX
    rcases hm with hm | hm
    · have : (m : ℝ) + 3 ≤ ⌊x⌋ := by exact_mod_cast (show m + 3 ≤ ⌊x⌋ by omega)
      rw [le_abs]; left; linarith
    · have : (⌊x⌋ : ℝ) + 3 ≤ m := by exact_mod_cast (show ⌊x⌋ + 3 ≤ m by omega)
      rw [le_abs]; right; linarith
  have hnear : ∀ᶠ p in nhds (x, s), |p.1 - x| < 1 := by
    have : Continuous fun p : ℝ × ℝ => |p.1 - x| := by fun_prop
    exact this.continuousAt.eventually_lt continuousAt_const (by simp)
  have hsmooth : ∀ m, ContDiff ℝ (⊤ : ℕ∞) (g m) := by
    intro m
    have h1 : ContDiff ℝ (⊤ : ℕ∞) fun p : ℝ × ℝ => ω (p.1 - m) :=
      hω.comp (contDiff_fst.sub contDiff_const)
    exact (Complex.ofRealCLM.contDiff.comp h1).mul (hφ.comp contDiff_snd)
  -- the tsum is a finite sum
  have htsum : ∑' m : ℤ, fourMarginalKernel (g m) (x, s) =
      ∑ m ∈ F, fourMarginalKernel (g m) (x, s) := by
    apply tsum_eq_sum
    intro m hm
    have he : g m =ᶠ[nhds (x, s)] fun _ => 0 := by
      filter_upwards [hnear] with p hp
      simp [g, hfar m hm p.1 hp]
    rw [fourMarginalKernel_eventuallyEq he, fourMarginalKernel_zero]; rfl
  -- near the point the finite sum of the `g m` is `φ(S)`
  have hloc : (fun p => ∑ m ∈ F, g m p) =ᶠ[nhds (x, s)] fun p => φ p.2 := by
    filter_upwards [hnear] with p hp
    have h1 : ∑' k : ℤ, ω (p.1 - k) = ∑ k ∈ F, ω (p.1 - k) :=
      tsum_eq_sum fun k hk => hfar k hk p.1 hp
    have h2 : ∑ k ∈ F, ω (p.1 - k) = 1 := by rw [← h1]; exact hsum p.1
    simp only [g, ← Finset.sum_mul]
    rw [← Complex.ofReal_sum, h2]; simp
  have hsumF := congrFun (fourMarginalKernel_sum F g (fun m _ => hsmooth m)) (x, s)
  rw [htsum, ← hsumF, fourMarginalKernel_eventuallyEq hloc, fourMarginalKernel_snd hφ]

/-! ### Three interlacing lattices (thm:main, blueprint lines 2963-2967) -/

/-- Blueprint lines 2963-2967: at one depth the boundaries `r(ℤ + σ j/3)`, `j ∈ {-1, 0, 1}`,
`σ = ±1`, of the three lattices interlace with spacing `r/3`, so an interval of length less than
`r/3` contains boundary points of at most one lattice. -/
theorem interlacing_boundaries {r α L : ℝ} (hr : 0 < r) (hL : L < r / 3) (σ : ℤ)
    (hσ : σ = 1 ∨ σ = -1) {j j' : ℤ} {n n' : ℤ}
    (hj : j ∈ Set.Icc (-1 : ℤ) 1) (hj' : j' ∈ Set.Icc (-1 : ℤ) 1)
    (h : r * (n + σ * j / 3) ∈ Set.Icc α (α + L))
    (h' : r * (n' + σ * j' / 3) ∈ Set.Icc α (α + L)) : j = j' := by
  -- both points lie in `(r/3) ℤ`, at indices `3n + σj` and `3n' + σj'`
  have hk : |((3 * n + σ * j : ℤ) : ℝ) - (3 * n' + σ * j' : ℤ)| < 1 := by
    have hd : |r * (n + σ * j / 3) - r * (n' + σ * j' / 3)| ≤ L := by
      rw [abs_le]; constructor <;> linarith only [h.1, h.2, h'.1, h'.2]
    have he : r * (n + σ * j / 3) - r * (n' + σ * j' / 3) =
        r / 3 * (((3 * n + σ * j : ℤ) : ℝ) - (3 * n' + σ * j' : ℤ)) := by
      push_cast; ring
    rw [he, abs_mul, abs_of_pos (by positivity)] at hd
    by_contra hge
    push Not at hge
    have : r / 3 * 1 ≤ r / 3 * |((3 * n + σ * j : ℤ) : ℝ) - (3 * n' + σ * j' : ℤ)| :=
      mul_le_mul_of_nonneg_left hge (by positivity)
    linarith only [hL, hd, this]
  have hk' : 3 * n + σ * j = 3 * n' + σ * j' := by
    rw [← Int.cast_sub, ← Int.cast_abs] at hk
    have : |3 * n + σ * j - (3 * n' + σ * j')| < 1 := by exact_mod_cast hk
    have := abs_lt.mp this
    omega
  obtain ⟨hj1, hj2⟩ := hj
  obtain ⟨hj1', hj2'⟩ := hj'
  rcases hσ with rfl | rfl <;> omega

/-! ### The kernel of a product (thm:main, blueprint line 2944) -/

/-- The tensor product `(X, S) ↦ A(X) B(S)`. -/
def tensorKernel (A B : ℝ → ℂ) : ℝ × ℝ → ℂ := fun p => A p.1 * B p.2

theorem tensorKernel_differentiable {A B : ℝ → ℂ} (hA : Differentiable ℝ A)
    (hB : Differentiable ℝ B) : Differentiable ℝ (tensorKernel A B) :=
  (hA.comp differentiable_fst).mul (hB.comp differentiable_snd)

/-- `(∂_S - j ∂_X)(A ⊗ B) = A ⊗ B' - j A' ⊗ B`. -/
theorem progDeriv_tensor (j : ℝ) {A B : ℝ → ℂ} (hA : Differentiable ℝ A)
    (hB : Differentiable ℝ B) :
    progDeriv j (tensorKernel A B) =
      fun p => tensorKernel A (deriv B) p - (j : ℂ) * tensorKernel (deriv A) B p := by
  funext p
  have h1 : HasFDerivAt (fun q : ℝ × ℝ => A q.1)
      ((ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) (deriv A p.1)).comp
        (ContinuousLinearMap.fst ℝ ℝ ℝ)) p :=
    (hA p.1).hasDerivAt.hasFDerivAt.comp p hasFDerivAt_fst
  have h2 : HasFDerivAt (fun q : ℝ × ℝ => B q.2)
      ((ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) (deriv B p.2)).comp
        (ContinuousLinearMap.snd ℝ ℝ ℝ)) p :=
    (hB p.2).hasDerivAt.hasFDerivAt.comp p hasFDerivAt_snd
  have h3 : HasFDerivAt (tensorKernel A B) _ p := h1.mul h2
  simp only [progDeriv]
  rw [h3.fderiv]
  simp [tensorKernel]
  ring

/-- Linearity of `∂_S - j ∂_X` on finite combinations. -/
theorem progDeriv_comb (j : ℝ) {ι : Type*} (s : Finset ι) (c : ι → ℂ) (f : ι → ℝ × ℝ → ℂ)
    (hf : ∀ i, Differentiable ℝ (f i)) :
    progDeriv j (fun p => ∑ i ∈ s, c i * f i p) =
      fun p => ∑ i ∈ s, c i * progDeriv j (f i) p := by
  funext p
  simp only [progDeriv]
  rw [fderiv_fun_sum (fun i _ => ((hf i) p).const_mul (c i))]
  simp only [FunLike.coe_sum, Finset.sum_apply]
  apply Finset.sum_congr rfl; intro i _
  rw [fderiv_const_mul (hf i p)]
  simp

/-- Blueprint line 2944 for a product: with `a = ∂_S`, `b = ∂_X`,
`a(a - b)(a - 2b)(a - 3b) = a⁴ - 6a³b + 11a²b² - 6ab³`, so
`W = ω φFourth - 6 ω' φ''' + 11 ω'' φ'' - 6 ω''' φ'`. -/
theorem fourMarginalKernel_tensor {ω φ : ℝ → ℂ} (hω : ContDiff ℝ (⊤ : ℕ∞) ω)
    (hφ : ContDiff ℝ (⊤ : ℕ∞) φ) :
    fourMarginalKernel (tensorKernel ω φ) = fun p =>
      tensorKernel ω (iteratedDeriv 4 φ) p - 6 * tensorKernel (iteratedDeriv 1 ω)
        (iteratedDeriv 3 φ) p + 11 * tensorKernel (iteratedDeriv 2 ω) (iteratedDeriv 2 φ) p -
        6 * tensorKernel (iteratedDeriv 3 ω) (iteratedDeriv 1 φ) p := by
  set F : ℕ → ℕ → ℝ × ℝ → ℂ := fun m n => tensorKernel (iteratedDeriv m ω) (iteratedDeriv n φ)
  have dω : ∀ m, Differentiable ℝ (iteratedDeriv m ω) := fun m =>
    hω.differentiable_iteratedDeriv m (WithTop.coe_lt_coe.mpr (ENat.natCast_lt_top m))
  have dφ : ∀ n, Differentiable ℝ (iteratedDeriv n φ) := fun n =>
    hφ.differentiable_iteratedDeriv n (WithTop.coe_lt_coe.mpr (ENat.natCast_lt_top n))
  have hd : ∀ m n, Differentiable ℝ (F m n) := fun m n => tensorKernel_differentiable (dω m) (dφ n)
  have hF : ∀ (j : ℝ) m n, progDeriv j (F m n) =
      fun p => F m (n + 1) p - (j : ℂ) * F (m + 1) n p := by
    intro j m n
    simp only [F]
    rw [progDeriv_tensor j (dω m) (dφ n), ← iteratedDeriv_succ, ← iteratedDeriv_succ]
  have h0 : tensorKernel ω φ = F 0 0 := by simp [F]
  -- stage by stage
  have s3 : progDeriv 3 (F 0 0) = fun p => ∑ i : Fin 2, ![1, -3] i * ![F 0 1, F 1 0] i p := by
    rw [hF]; funext p; simp [Fin.sum_univ_two]; ring
  have s2 : progDeriv 2 (fun p => ∑ i : Fin 2, ![1, -3] i * ![F 0 1, F 1 0] i p) =
      fun p => ∑ i : Fin 3, ![1, -5, 6] i * ![F 0 2, F 1 1, F 2 0] i p := by
    rw [progDeriv_comb 2 _ _ _ (fun i => by fin_cases i <;> exact hd _ _)]
    funext p; simp [Fin.sum_univ_two, Fin.sum_univ_three, hF]; ring
  have s1 : progDeriv 1 (fun p => ∑ i : Fin 3, ![1, -5, 6] i * ![F 0 2, F 1 1, F 2 0] i p) =
      fun p => ∑ i : Fin 4, ![1, -6, 11, -6] i * ![F 0 3, F 1 2, F 2 1, F 3 0] i p := by
    rw [progDeriv_comb 1 _ _ _ (fun i => by fin_cases i <;> exact hd _ _)]
    funext p; simp [Fin.sum_univ_three, Fin.sum_univ_four, hF]; ring
  have s0 : progDeriv 0
      (fun p => ∑ i : Fin 4, ![1, -6, 11, -6] i * ![F 0 3, F 1 2, F 2 1, F 3 0] i p) =
      fun p => F 0 4 p - 6 * F 1 3 p + 11 * F 2 2 p - 6 * F 3 1 p := by
    rw [progDeriv_comb 0 _ _ _ (fun i => by fin_cases i <;> exact hd _ _)]
    funext p; simp [Fin.sum_univ_four, hF]; ring
  unfold fourMarginalKernel
  rw [h0, s3, s2, s1, s0]
  funext p; simp [F]

/-! ### Derivatives of rescaled kernels (thm:main, blueprint lines 2970-2974) -/

/-- Partial derivatives of a finite sum of tensors `Σ_k c_k A_k(x) B_k(t)`. -/
theorem localKernelPartial_tensorSum {ι : Type*} (s : Finset ι) (c : ι → ℂ)
    (A B : ι → ℝ → ℂ) (hA : ∀ k, ContDiff ℝ (⊤ : ℕ∞) (A k))
    (hB : ∀ k, ContDiff ℝ (⊤ : ℕ∞) (B k)) (m n : ℕ) (z : ℝ × ℝ) :
    localKernelPartial m n (fun p => ∑ k ∈ s, c k * A k p.1 * B k p.2) z =
      ∑ k ∈ s, c k * iteratedDeriv m (A k) z.1 * iteratedDeriv n (B k) z.2 := by
  have cA : ∀ k (j : ℕ) x, ContDiffAt ℝ j (A k) x := fun k j x =>
    ((hA k).of_le (by exact_mod_cast le_top)).contDiffAt
  have cB : ∀ k (j : ℕ) x, ContDiffAt ℝ j (B k) x := fun k j x =>
    ((hB k).of_le (by exact_mod_cast le_top)).contDiffAt
  have hin : (fun x => iteratedDeriv n (fun t => (fun p : ℝ × ℝ =>
      ∑ k ∈ s, c k * A k p.1 * B k p.2) (x, t)) z.2) =
      fun x => ∑ k ∈ s, c k * A k x * iteratedDeriv n (B k) z.2 := by
    funext x
    simp only
    rw [iteratedDeriv_fun_sum (fun k _ => contDiffAt_const.mul (cB k n z.2))]
    apply Finset.sum_congr rfl; intro k _
    rw [show (fun t => c k * A k x * B k t) = fun t => (c k * A k x) * B k t from rfl,
      iteratedDeriv_const_mul_field]
  unfold localKernelPartial
  rw [hin, iteratedDeriv_fun_sum (fun k _ =>
    (contDiffAt_const.mul (cA k m z.1)).mul contDiffAt_const)]
  apply Finset.sum_congr rfl; intro k _
  rw [show (fun x => c k * A k x * iteratedDeriv n (B k) z.2) =
    fun x => c k * (A k x * iteratedDeriv n (B k) z.2) by funext x; ring,
    iteratedDeriv_const_mul_field, iteratedDeriv_mul_const_field]
  ring

/-- Affine rescaling for complex-valued functions: `(f(c x + a))⁽ⁿ⁾ = cⁿ f⁽ⁿ⁾(c x + a)`. -/
theorem iteratedDeriv_affine_complex (n : ℕ) {f : ℝ → ℂ} (hf : ContDiff ℝ (⊤ : ℕ∞) f)
    (c a : ℝ) :
    iteratedDeriv n (fun x => f (c * x + a)) =
      fun x => (c : ℂ) ^ n * iteratedDeriv n f (c * x + a) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [iteratedDeriv_succ, ih]
    funext x
    have hd : HasDerivAt (iteratedDeriv n f) (iteratedDeriv (n + 1) f (c * x + a))
        (c * x + a) := by
      rw [iteratedDeriv_succ]
      exact ((hf.differentiable_iteratedDeriv n
        (WithTop.coe_lt_coe.mpr (ENat.natCast_lt_top n))) _).hasDerivAt
    have hl : HasDerivAt (fun x : ℝ => c * x + a) c x := by
      simpa using ((hasDerivAt_id x).const_mul c).add_const a
    have h2 : HasDerivAt (fun y => (c : ℂ) ^ n * iteratedDeriv n f (c * y + a))
        ((c : ℂ) ^ n * (c • iteratedDeriv (n + 1) f (c * x + a))) x :=
      (hd.scomp x hl).const_mul _
    rw [h2.deriv]
    simp [pow_succ]
    ring

/-- Derivatives commute with the real-to-complex cast. -/
theorem iteratedDeriv_ofReal (n : ℕ) {f : ℝ → ℝ} (hf : ContDiff ℝ (⊤ : ℕ∞) f) :
    iteratedDeriv n (fun x => (f x : ℂ)) = fun x => ((iteratedDeriv n f x : ℝ) : ℂ) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [iteratedDeriv_succ, ih, iteratedDeriv_succ]
    funext x
    have hd := ((hf.differentiable_iteratedDeriv n
      (WithTop.coe_lt_coe.mpr (ENat.natCast_lt_top n))) x).hasDerivAt
    exact hd.ofReal_comp.deriv

/-- The rescaled kernel `w(x, t) = (r/a) W(x/a - m₀, t/a)`. -/
noncomputable def rescaledKernel (W : ℝ × ℝ → ℂ) (a r m₀ : ℝ) : ℝ × ℝ → ℂ :=
  fun p => ((r / a : ℝ) : ℂ) * W (p.1 / a - m₀, p.2 / a)

/-- Blueprint lines 2970-2974: if `W = Σ_k c_k A_k(X) B_k(S)` with smooth factors whose
derivatives are bounded by `GA k i`, `GB k i`, then the rescaled kernel has
`|∂_x^m ∂_t^n w| ≤ (r/a) a^{-(m+n)} Σ_k |c_k| GA k m GB k n`. -/
theorem rescaledKernel_partial_le {ι : Type*} (s : Finset ι) (c : ι → ℂ) (A B : ι → ℝ → ℂ)
    (hA : ∀ k, ContDiff ℝ (⊤ : ℕ∞) (A k)) (hB : ∀ k, ContDiff ℝ (⊤ : ℕ∞) (B k))
    (GA GB : ι → ℕ → ℝ) (hGA : ∀ k i x, ‖iteratedDeriv i (A k) x‖ ≤ GA k i)
    (hGB : ∀ k i x, ‖iteratedDeriv i (B k) x‖ ≤ GB k i) {a r : ℝ} (ha : 0 < a) (hr : 0 ≤ r)
    (m₀ : ℝ) (m n : ℕ) (z : ℝ × ℝ) :
    ‖localKernelPartial m n (rescaledKernel (fun p => ∑ k ∈ s, c k * A k p.1 * B k p.2)
        a r m₀) z‖ ≤ r / a * a⁻¹ ^ (m + n) * ∑ k ∈ s, ‖c k‖ * GA k m * GB k n := by
  set A' : ι → ℝ → ℂ := fun k x => A k (a⁻¹ * x + -m₀)
  set B' : ι → ℝ → ℂ := fun k t => B k (a⁻¹ * t + 0)
  have hA' : ∀ k, ContDiff ℝ (⊤ : ℕ∞) (A' k) := fun k =>
    (hA k).comp ((contDiff_const.mul contDiff_id).add contDiff_const)
  have hB' : ∀ k, ContDiff ℝ (⊤ : ℕ∞) (B' k) := fun k =>
    (hB k).comp ((contDiff_const.mul contDiff_id).add contDiff_const)
  have heq : rescaledKernel (fun p => ∑ k ∈ s, c k * A k p.1 * B k p.2) a r m₀ =
      fun p => ∑ k ∈ s, (((r / a : ℝ) : ℂ) * c k) * A' k p.1 * B' k p.2 := by
    funext p
    simp only [rescaledKernel, A', B', Finset.mul_sum]
    apply Finset.sum_congr rfl; intro k _
    rw [show p.1 / a - m₀ = a⁻¹ * p.1 + -m₀ by ring, show p.2 / a = a⁻¹ * p.2 + 0 by ring]
    ring
  rw [heq, localKernelPartial_tensorSum s _ A' B' hA' hB' m n z]
  have hdA : ∀ k, iteratedDeriv m (A' k) z.1 = (a⁻¹ : ℂ) ^ m * iteratedDeriv m (A k)
      (a⁻¹ * z.1 + -m₀) := fun k => by
    rw [iteratedDeriv_affine_complex m (hA k) a⁻¹ (-m₀)]; push_cast; ring
  have hdB : ∀ k, iteratedDeriv n (B' k) z.2 = (a⁻¹ : ℂ) ^ n * iteratedDeriv n (B k)
      (a⁻¹ * z.2 + 0) := fun k => by
    rw [iteratedDeriv_affine_complex n (hB k) a⁻¹ 0]; push_cast; ring
  calc ‖∑ k ∈ s, ((r / a : ℝ) : ℂ) * c k * iteratedDeriv m (A' k) z.1 *
        iteratedDeriv n (B' k) z.2‖ ≤
      ∑ k ∈ s, r / a * a⁻¹ ^ (m + n) * (‖c k‖ * GA k m * GB k n) := by
        refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun k _ => ?_)
        rw [hdA, hdB]
        simp only [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, norm_inv,
          abs_of_nonneg (div_nonneg hr ha.le), abs_of_pos ha]
        have h1 := hGA k m (a⁻¹ * z.1 + -m₀)
        have h2 := hGB k n (a⁻¹ * z.2 + 0)
        calc r / a * ‖c k‖ * (a⁻¹ ^ m * ‖iteratedDeriv m (A k) (a⁻¹ * z.1 + -m₀)‖) *
            (a⁻¹ ^ n * ‖iteratedDeriv n (B k) (a⁻¹ * z.2 + 0)‖) =
            r / a * a⁻¹ ^ (m + n) * (‖c k‖ * ‖iteratedDeriv m (A k) (a⁻¹ * z.1 + -m₀)‖ *
              ‖iteratedDeriv n (B k) (a⁻¹ * z.2 + 0)‖) := by ring
          _ ≤ r / a * a⁻¹ ^ (m + n) * (‖c k‖ * GA k m * GB k n) := by
              gcongr
              all_goals exact mul_nonneg (norm_nonneg _) ((norm_nonneg _).trans h1)
    _ = _ := by rw [Finset.mul_sum]

/-- Blueprint line 2974: the products of Gevrey bounds `G(j) = (C₀(j+1))^{C₀(j+1)}` occurring in
`W`, together with the factor `34 D^{u+1}`, are absorbed by `(C(u+2))^{C(u+2)}` for
`C = 3C₀ + 34 + D`. -/
theorem gevrey_kernel_absorb {C₀ D : ℕ} (hC₀ : 1 ≤ C₀) (hD : 1 ≤ D) (m n k : ℕ) (hk : k ≤ 4) :
    (D : ℝ) ^ (m + n + 1) * 34 *
        (((C₀ : ℝ) * ((k + m : ℕ) + 1)) ^ (C₀ * ((k + m) + 1)) *
          ((C₀ : ℝ) * ((4 - k + n : ℕ) + 1)) ^ (C₀ * ((4 - k + n) + 1))) ≤
      (((3 * C₀ + 34 + D : ℕ) : ℝ) * ((m + n : ℕ) + 2)) ^ ((3 * C₀ + 34 + D) * (m + n + 2)) := by
  set u := m + n
  set C := 3 * C₀ + 34 + D
  set B : ℝ := (C : ℝ) * ((u : ℕ) + 2)
  have hu : (0 : ℝ) ≤ u := Nat.cast_nonneg _
  have hC : (C : ℝ) = 3 * C₀ + 34 + D := by simp [C]
  have hC₀r : (1 : ℝ) ≤ C₀ := by exact_mod_cast hC₀
  have hDr : (1 : ℝ) ≤ D := by exact_mod_cast hD
  have hB1 : (1 : ℝ) ≤ B := by simp only [B]; rw [hC]; nlinarith only
  have hB34 : (34 : ℝ) ≤ B := by simp only [B]; rw [hC]; nlinarith only
  have hBD : (D : ℝ) ≤ B := by simp only [B]; rw [hC]; nlinarith only
  have hbase : ∀ j : ℕ, j ≤ u + 4 → (C₀ : ℝ) * ((j : ℕ) + 1) ≤ B := by
    intro j hj
    have : (j : ℝ) ≤ u + 4 := by exact_mod_cast hj
    simp only [B]; rw [hC]; nlinarith only [this]
  have hpow : ∀ j : ℕ, j ≤ u + 4 →
      ((C₀ : ℝ) * ((j : ℕ) + 1)) ^ (C₀ * (j + 1)) ≤ B ^ (C₀ * (j + 1)) := fun j hj =>
    pow_le_pow_left₀ (by positivity) (hbase j hj) _
  have h1 := hpow (k + m) (by omega)
  have h2 := hpow (4 - k + n) (by omega)
  calc (D : ℝ) ^ (u + 1) * 34 * (((C₀ : ℝ) * ((k + m : ℕ) + 1)) ^ (C₀ * ((k + m) + 1)) *
        ((C₀ : ℝ) * ((4 - k + n : ℕ) + 1)) ^ (C₀ * ((4 - k + n) + 1))) ≤
      B ^ (u + 1) * B * (B ^ (C₀ * ((k + m) + 1)) * B ^ (C₀ * ((4 - k + n) + 1))) := by
        gcongr
    _ = B ^ (u + 2 + C₀ * (u + 6)) := by
        rw [← pow_add, ← pow_succ, ← pow_add]
        congr 1
        have : k + m + 1 + (4 - k + n + 1) = u + 6 := by omega
        rw [← Nat.mul_add, this]
    _ ≤ B ^ (C * (u + 2)) := by
        apply pow_le_pow_right₀ hB1
        simp only [C]; nlinarith only

theorem iteratedDeriv_iteratedDeriv_add (i k : ℕ) (f : ℝ → ℂ) :
    iteratedDeriv i (iteratedDeriv k f) = iteratedDeriv (i + k) f := by
  rw [iteratedDeriv_eq_iterate, iteratedDeriv_eq_iterate, iteratedDeriv_eq_iterate]
  funext x
  rw [Function.iterate_add_apply]

/-- Blueprint lines 2970-2974: for `ω, φ` with Gevrey bounds `‖g⁽ʲ⁾‖ ≤ (C₀(j+1))^{C₀(j+1)}`
and `r = D a`, the rescaled kernel `w(x,t) = (r/a) W(x/a - m₀, t/a)` of
`W = Π_j (∂_S - j∂_X)[ω φ]` satisfies `|∂_x^m ∂_t^n w| ≤ r^{-u} (C(u+2))^{C(u+2)}`,
`u = m + n`, with `C = 3C₀ + 34 + D` independent of `a`, `m₀` and the point. -/
theorem rescaledW_derivative_bound {ω φ : ℝ → ℂ} (hω : ContDiff ℝ (⊤ : ℕ∞) ω)
    (hφ : ContDiff ℝ (⊤ : ℕ∞) φ) {C₀ D : ℕ} (hC₀ : 1 ≤ C₀) (hD : 1 ≤ D)
    (hωG : ∀ j x, ‖iteratedDeriv j ω x‖ ≤ ((C₀ : ℝ) * ((j : ℝ) + 1)) ^ (C₀ * (j + 1)))
    (hφG : ∀ j x, ‖iteratedDeriv j φ x‖ ≤ ((C₀ : ℝ) * ((j : ℝ) + 1)) ^ (C₀ * (j + 1)))
    {a : ℝ} (ha : 0 < a) (m₀ : ℝ) (m n : ℕ) (z : ℝ × ℝ) :
    ‖localKernelPartial m n (rescaledKernel (fourMarginalKernel (tensorKernel ω φ)) a
        (D * a) m₀) z‖ ≤
      (D * a)⁻¹ ^ (m + n) *
        (((3 * C₀ + 34 + D : ℕ) : ℝ) * ((m + n : ℕ) + 2)) ^ ((3 * C₀ + 34 + D) * (m + n + 2)) := by
  set c : Fin 4 → ℂ := ![1, -6, 11, -6]
  set A : Fin 4 → ℝ → ℂ := fun k => iteratedDeriv k ω
  set B : Fin 4 → ℝ → ℂ := fun k => iteratedDeriv (4 - k) φ
  have hsmooth : ∀ (g : ℝ → ℂ), ContDiff ℝ (⊤ : ℕ∞) g → ∀ j,
      ContDiff ℝ (⊤ : ℕ∞) (iteratedDeriv j g) := fun g hg j => by
    rw [iteratedDeriv_eq_iterate]; exact hg.iterate_deriv j
  have hW : fourMarginalKernel (tensorKernel ω φ) =
      fun p => ∑ k : Fin 4, c k * A k p.1 * B k p.2 := by
    rw [fourMarginalKernel_tensor hω hφ]
    funext p
    simp [Fin.sum_univ_four, tensorKernel, c, A, B]
    ring
  set G : ℕ → ℝ := fun j => ((C₀ : ℝ) * ((j : ℝ) + 1)) ^ (C₀ * (j + 1))
  have hbound := rescaledKernel_partial_le (r := D * a) Finset.univ c A B (fun k => hsmooth ω hω k)
    (fun k => hsmooth φ hφ (4 - k)) (fun k i => G (i + k)) (fun k i => G (i + (4 - k)))
    (fun k i x => by simp only [A]; rw [iteratedDeriv_iteratedDeriv_add]; exact hωG _ x)
    (fun k i x => by simp only [B]; rw [iteratedDeriv_iteratedDeriv_add]; exact hφG _ x)
    ha (by positivity) m₀ m n z
  rw [hW]
  refine hbound.trans ?_
  set Bp : ℝ :=
    (((3 * C₀ + 34 + D : ℕ) : ℝ) * ((m + n : ℕ) + 2)) ^ ((3 * C₀ + 34 + D) * (m + n + 2))
  have hk : ∀ k : Fin 4, (D : ℝ) ^ (m + n + 1) * (G (m + k) * G (n + (4 - k))) ≤ Bp / 34 := by
    intro k
    have h := gevrey_kernel_absorb hC₀ hD m n k (by omega)
    rw [le_div_iff₀ (by norm_num)]
    have e1 : G (m + k) = ((C₀ : ℝ) * ((k + m : ℕ) + 1)) ^ (C₀ * ((k + m) + 1)) := by
      simp only [G]; rw [add_comm m]
    have e2 : G (n + (4 - k)) =
        ((C₀ : ℝ) * ((4 - k + n : ℕ) + 1)) ^ (C₀ * ((4 - k + n) + 1)) := by
      simp only [G]; rw [add_comm n]
    rw [e1, e2]; linarith only [h]
  have hDa : (0 : ℝ) < D * a := by positivity
  have hD0 : (0 : ℝ) < D := by exact_mod_cast hD
  have hsplit : D * a / a * a⁻¹ ^ (m + n) = (D * a)⁻¹ ^ (m + n) * (D : ℝ) ^ (m + n + 1) := by
    rw [mul_div_assoc, div_self ha.ne', mul_one, mul_inv, mul_pow, pow_succ]
    have : (D : ℝ) ^ (m + n) ≠ 0 := by positivity
    field_simp
    rw [one_div, inv_pow, inv_mul_cancel₀ this]
  rw [hsplit, mul_assoc]
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  rw [Finset.mul_sum]
  calc ∑ k : Fin 4, (D : ℝ) ^ (m + n + 1) * (‖c k‖ * G (m + k) * G (n + (4 - k))) ≤
      ∑ k : Fin 4, ‖c k‖ * (Bp / 34) := by
        apply Finset.sum_le_sum; intro k _
        have := mul_le_mul_of_nonneg_left (hk k) (norm_nonneg (c k))
        nlinarith only [this]
    _ = 24 / 34 * Bp := by
        simp [Fin.sum_univ_four, c]; norm_num; ring
    _ ≤ Bp := by
        have : 0 ≤ Bp := by positivity
        linarith only [this]

/-! ### Gevrey bound for `φ(S) = S³ χ(S)` (thm:main, blueprint line 2935) -/

theorem iteratedDeriv_eq_zero_of_notMem_tsupport {f : ℝ → ℝ} {x : ℝ} (hx : x ∉ tsupport f)
    (n : ℕ) : iteratedDeriv n f x = 0 := by
  rw [iteratedDeriv_eq_iteratedFDeriv]
  have : x ∉ Function.support (iteratedFDeriv ℝ n f) := fun h =>
    hx (support_iteratedFDeriv_subset n h)
  rw [Function.notMem_support.mp this]
  rfl

/-- Blueprint line 2935: if `χ` is a smooth cutoff supported in `[-R, R]` with Gevrey bounds
`|χ⁽ᵏ⁾| ≤ (C(k+1))^{C(k+1)}`, then `φ(S) = S³ χ(S)` has Gevrey bounds with a larger constant. -/
theorem cubic_cutoff_gevrey {χ : ℝ → ℝ} (hχ : ContDiff ℝ (⊤ : ℕ∞) χ) {R : ℝ} (hR : 0 ≤ R)
    (hsupp : tsupport χ ⊆ Set.Icc (-R) R) {Cχ : ℕ} (hCχ : 1 ≤ Cχ)
    (hG : ∀ k x, |iteratedDeriv k χ x| ≤ ((Cχ : ℝ) * ((k : ℝ) + 1)) ^ (Cχ * (k + 1))) :
    ∃ C₀ : ℕ, 1 ≤ C₀ ∧ ∀ n x, |iteratedDeriv n (fun S => S ^ 3 * χ S) x| ≤
      ((C₀ : ℝ) * ((n : ℝ) + 1)) ^ (C₀ * (n + 1)) := by
  set K : ℕ := ⌈6 * (R + 1) ^ 3⌉₊ + 2
  refine ⟨Cχ + K, by omega, fun n x => ?_⟩
  by_cases hx : x ∈ tsupport χ
  · have hxR := hsupp hx
    have habs : |x| ≤ R + 1 := by rw [abs_le]; constructor <;> linarith [hxR.1, hxR.2]
    -- derivatives of the cubic are at most `6 (R+1)³` at `x`
    have hcub : ∀ i, |iteratedDeriv i (fun S : ℝ => S ^ 3) x| ≤ 6 * (R + 1) ^ 3 := by
      intro i
      rw [iteratedDeriv_pow]
      rw [abs_mul, Nat.abs_cast, abs_pow]
      have hR1 : 1 ≤ R + 1 := by linarith
      have hp : |x| ^ (3 - i) ≤ (R + 1) ^ 3 :=
        (pow_le_pow_left₀ (abs_nonneg x) habs _).trans
          (pow_le_pow_right₀ hR1 (Nat.sub_le 3 i))
      have hd : ((Nat.descFactorial 3 i : ℕ) : ℝ) ≤ 6 := by
        have : Nat.descFactorial 3 i ≤ 6 := by
          rcases Nat.lt_or_ge i 4 with h | h
          · interval_cases i <;> decide
          · rw [Nat.descFactorial_eq_zero_iff_lt.mpr (by omega)]; omega
        exact_mod_cast this
      exact mul_le_mul hd hp (by positivity) (by norm_num)
    have hGm : ∀ k ≤ n, |iteratedDeriv k χ x| ≤
        ((Cχ : ℝ) * ((n : ℝ) + 1)) ^ (Cχ * (n + 1)) := by
      intro k hk
      refine (hG k x).trans ?_
      have hk' : (k : ℝ) ≤ n := by exact_mod_cast hk
      have h1 : (1 : ℝ) ≤ (Cχ : ℝ) * ((k : ℝ) + 1) := by
        have : (1 : ℝ) ≤ Cχ := by exact_mod_cast hCχ
        nlinarith only [(Nat.cast_nonneg k : (0 : ℝ) ≤ k), this]
      calc ((Cχ : ℝ) * ((k : ℝ) + 1)) ^ (Cχ * (k + 1)) ≤
          ((Cχ : ℝ) * ((n : ℝ) + 1)) ^ (Cχ * (k + 1)) := by gcongr
        _ ≤ _ := pow_le_pow_right₀ (h1.trans (by gcongr)) (by gcongr)
    set Gn := ((Cχ : ℝ) * ((n : ℝ) + 1)) ^ (Cχ * (n + 1))
    have hsc : ContDiffAt ℝ n (fun S : ℝ => S ^ 3) x := (contDiff_id.pow 3).contDiffAt
    have hχc : ContDiffAt ℝ n χ x := (hχ.of_le (by exact_mod_cast le_top)).contDiffAt
    rw [iteratedDeriv_fun_mul hsc hχc]
    have hsum : |∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
        iteratedDeriv i (fun S : ℝ => S ^ 3) x * iteratedDeriv (n - i) χ x| ≤
        2 ^ n * (6 * (R + 1) ^ 3) * Gn := by
      refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      calc ∑ i ∈ Finset.range (n + 1), |(n.choose i : ℝ) *
            iteratedDeriv i (fun S : ℝ => S ^ 3) x * iteratedDeriv (n - i) χ x| ≤
          ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * (6 * (R + 1) ^ 3 * Gn) := by
            apply Finset.sum_le_sum; intro i _
            rw [abs_mul, abs_mul, Nat.abs_cast, mul_assoc]
            gcongr
            · exact hcub i
            · exact hGm _ (Nat.sub_le _ _)
        _ = 2 ^ n * (6 * (R + 1) ^ 3) * Gn := by
            rw [← Finset.sum_mul]
            have : ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) = 2 ^ n := by
              exact_mod_cast Nat.sum_range_choose n
            rw [this]; ring
    refine hsum.trans ?_
    -- absorb into one Gevrey constant
    set B : ℝ := ((Cχ + K : ℕ) : ℝ) * ((n : ℝ) + 1)
    have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    have hK6 : 6 * (R + 1) ^ 3 ≤ (K : ℝ) := by
      have := Nat.le_ceil (6 * (R + 1) ^ 3); simp only [K]; push_cast; linarith only [this]
    have hK2 : (2 : ℝ) ≤ K := by
      have hc : (0 : ℝ) ≤ (⌈6 * (R + 1) ^ 3⌉₊ : ℕ) := Nat.cast_nonneg _
      simp only [K]; push_cast; linarith only
    have hKB : (K : ℝ) ≤ B := by
      simp only [B]; push_cast; nlinarith only [Nat.cast_nonneg (α := ℝ) Cχ]
    have hCB : (Cχ : ℝ) * ((n : ℝ) + 1) ≤ B := by
      simp only [B]; push_cast; nlinarith only [Nat.cast_nonneg (α := ℝ) K]
    have hB1 : (1 : ℝ) ≤ B := by linarith only [hK2, hKB]
    calc 2 ^ n * (6 * (R + 1) ^ 3) * Gn ≤ B ^ n * B * B ^ (Cχ * (n + 1)) := by
          gcongr
          · linarith only [hK2, hKB]
          · linarith only [hK6, hKB]
          · exact pow_le_pow_left₀ (by positivity) hCB _
      _ = B ^ (n + 1 + Cχ * (n + 1)) := by rw [← pow_succ, ← pow_add]
      _ ≤ B ^ ((Cχ + K) * (n + 1)) := by
          apply pow_le_pow_right₀ hB1
          have : 2 ≤ K := by simp only [K]; omega
          nlinarith only [this]
  · have hz : ∀ k, iteratedDeriv k χ x = 0 := fun k =>
      iteratedDeriv_eq_zero_of_notMem_tsupport hx k
    have hsc : ContDiffAt ℝ n (fun S : ℝ => S ^ 3) x := (contDiff_id.pow 3).contDiffAt
    have hχc : ContDiffAt ℝ n χ x := (hχ.of_le (by exact_mod_cast le_top)).contDiffAt
    rw [iteratedDeriv_fun_mul hsc hχc]
    simp only [hz, mul_zero, Finset.sum_const_zero, abs_zero]
    positivity

/-! ### Support and marginals of the rescaled kernel (thm:main, lines 2966-2970) -/

theorem tsupport_progDeriv_subset (j : ℝ) (g : ℝ × ℝ → ℂ) :
    tsupport (progDeriv j g) ⊆ tsupport g := by
  apply closure_minimal _ (isClosed_tsupport g)
  intro p hp
  by_contra h
  apply hp
  simp [progDeriv, image_eq_zero_of_notMem_tsupport (f := fderiv ℝ g)
    (fun h' => h (tsupport_fderiv_subset ℝ h'))]

theorem support_fourMarginalKernel_subset (g : ℝ × ℝ → ℂ) :
    Function.support (fourMarginalKernel g) ⊆ tsupport g :=
  subset_tsupport _ |>.trans ((tsupport_progDeriv_subset _ _).trans
    ((tsupport_progDeriv_subset _ _).trans ((tsupport_progDeriv_subset _ _).trans
      (tsupport_progDeriv_subset _ _))))

theorem tsupport_tensorKernel_subset (A B : ℝ → ℂ) :
    tsupport (tensorKernel A B) ⊆ tsupport A ×ˢ tsupport B := by
  apply closure_minimal _ ((isClosed_tsupport A).prod (isClosed_tsupport B))
  intro p hp
  simp only [tensorKernel, Function.mem_support, mul_ne_zero_iff] at hp
  exact ⟨subset_tsupport _ hp.1, subset_tsupport _ hp.2⟩

/-- Blueprint lines 2966-2968: if `ω` is supported in `[-1, 1]` and `φ` in `[-R, R]`, the
progression coordinates `x + j t` on the support of the rescaled kernel
`(r/a) W(x/a - m₀, t/a)` lie in `[a(m₀ - 1 - 3R), a(m₀ + 1 + 3R)]`. -/
theorem rescaledW_support {ω φ : ℝ → ℂ} {R : ℝ} (hR : 0 ≤ R)
    (hω : tsupport ω ⊆ Set.Icc (-1) 1) (hφ : tsupport φ ⊆ Set.Icc (-R) R) {a r m₀ : ℝ}
    (ha : 0 < a) (z : ℝ × ℝ)
    (hz : rescaledKernel (fourMarginalKernel (tensorKernel ω φ)) a r m₀ z ≠ 0) (j : Fin 4) :
    realProgressionCoordinate j z ∈ Set.Icc (a * (m₀ - 1 - 3 * R)) (a * (m₀ + 1 + 3 * R)) := by
  have hW : fourMarginalKernel (tensorKernel ω φ) (z.1 / a - m₀, z.2 / a) ≠ 0 := by
    intro h; apply hz; simp [rescaledKernel, h]
  have hs := tsupport_tensorKernel_subset ω φ (support_fourMarginalKernel_subset _ hW)
  obtain ⟨hX, hS⟩ := hs
  have hX' := hω hX
  have hS' := hφ hS
  simp only [Set.mem_Icc] at hX' hS'
  have hj0 : (0 : ℝ) ≤ (j : ℕ) := Nat.cast_nonneg _
  have hj3 : ((j : ℕ) : ℝ) ≤ 3 := by exact_mod_cast (show (j : ℕ) ≤ 3 by omega)
  have ex : z.1 = a * (z.1 / a - m₀) + a * m₀ := by field_simp; ring
  have et : z.2 = a * (z.2 / a) := by field_simp
  simp only [realProgressionCoordinate, Set.mem_Icc]
  rw [ex, et]
  constructor
  · have h1 : -(R * 3) ≤ ((j : ℕ) : ℝ) * (z.2 / a) := by nlinarith
    nlinarith
  · have h1 : ((j : ℕ) : ℝ) * (z.2 / a) ≤ R * 3 := by nlinarith
    nlinarith

/-- Blueprint line 2970: rescaling preserves the four zero marginals:
`∫ w(u - j t, t) dt = 0` for `w(x, t) = (r/a) W(x/a - m₀, t/a)`. -/
theorem rescaledW_marginal {g : ℝ × ℝ → ℂ} (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hgc : HasCompactSupport g) {a r m₀ : ℝ} (ha : 0 < a) (u : ℝ) (j : Fin 4) :
    ∫ t : ℝ, rescaledKernel (fourMarginalKernel g) a r m₀ (u - (j : ℝ) * t, t) = 0 := by
  simp only [rescaledKernel]
  rw [integral_const_mul]
  have h := fourMarginalKernel_marginal hg hgc (u / a - m₀) j
  have hsub : ∫ t : ℝ, fourMarginalKernel g ((u - (j : ℝ) * t) / a - m₀, t / a) =
      a * ∫ s : ℝ, fourMarginalKernel g (u / a - m₀ - (j : ℝ) * s, s) := by
    have := MeasureTheory.Measure.integral_comp_mul_left
      (fun s : ℝ => fourMarginalKernel g (u / a - m₀ - (j : ℝ) * s, s)) a⁻¹
    simp only [abs_of_pos ha, inv_inv, Complex.real_smul] at this
    rw [← this]
    congr 1; funext t
    congr 2
    · field_simp; ring
    · field_simp
  rw [hsub, h, mul_zero, mul_zero]

/-- The admissible kernel class with margin `μ` and derivative constant `C`. -/
noncomputable def kernelClassOf (μ : ℝ) (hμ : 0 < μ) (C : ℕ) (hC : 1 ≤ C) : LocalKernelClass where
  margin := μ
  margin_pos := hμ
  derivativeConstant := C
  one_le_derivativeConstant := by exact_mod_cast hC

/-- Blueprint lines 2966-2974: the rescaled translate `w(x,t) = (r/a) W(x/a - m₀, t/a)`,
`r = D a`, of the kernel `W` built from Gevrey `ω` (support `[-1,1]`) and `φ` (support
`[-R,R]`), is an admissible local kernel on any cell `[c, c + r]` whose margin `μ r` interior
contains `[a(m₀ - 1 - 3R), a(m₀ + 1 + 3R)]`, with derivative constant `3C₀ + 34 + D`. -/
theorem rescaledW_admissible {ω φ : ℝ → ℂ} (hω : ContDiff ℝ (⊤ : ℕ∞) ω)
    (hφ : ContDiff ℝ (⊤ : ℕ∞) φ) {R : ℝ} (hR : 0 ≤ R) (hωs : tsupport ω ⊆ Set.Icc (-1) 1)
    (hφs : tsupport φ ⊆ Set.Icc (-R) R) {C₀ D : ℕ} (hC₀ : 1 ≤ C₀) (hD : 1 ≤ D)
    (hωG : ∀ j x, ‖iteratedDeriv j ω x‖ ≤ ((C₀ : ℝ) * ((j : ℝ) + 1)) ^ (C₀ * (j + 1)))
    (hφG : ∀ j x, ‖iteratedDeriv j φ x‖ ≤ ((C₀ : ℝ) * ((j : ℝ) + 1)) ^ (C₀ * (j + 1)))
    {μ : ℝ} (hμ : 0 < μ) {a m₀ c : ℝ} (ha : 0 < a)
    (hcell : c + μ * (D * a) ≤ a * (m₀ - 1 - 3 * R) ∧
      a * (m₀ + 1 + 3 * R) ≤ c + D * a - μ * (D * a)) :
    IsAdmissibleLocalKernel (kernelClassOf μ hμ (3 * C₀ + 34 + D) (by omega)) c (D * a)
      (rescaledKernel (fourMarginalKernel (tensorKernel ω φ)) a (D * a) m₀) := by
  have hg : ContDiff ℝ (⊤ : ℕ∞) (tensorKernel ω φ) :=
    (hω.comp contDiff_fst).mul (hφ.comp contDiff_snd)
  have hgc : HasCompactSupport (tensorKernel ω φ) := by
    apply HasCompactSupport.of_support_subset_isCompact
      ((isCompact_Icc (a := (-1 : ℝ)) (b := 1)).prod (isCompact_Icc (a := -R) (b := R)))
    intro p hp
    have := tsupport_tensorKernel_subset ω φ (subset_tsupport _ hp)
    exact ⟨hωs this.1, hφs this.2⟩
  have hW : ContDiff ℝ (⊤ : ℕ∞) (fourMarginalKernel (tensorKernel ω φ)) :=
    progDeriv_contDiff (progDeriv_contDiff (progDeriv_contDiff (progDeriv_contDiff hg)))
  refine ⟨?_, ?_, ?_, ?_⟩
  · -- smoothness
    have h1 : ContDiff ℝ (⊤ : ℕ∞) fun p : ℝ × ℝ => (p.1 / a - m₀, p.2 / a) := by fun_prop
    exact contDiff_const.mul (hW.comp h1)
  · intro z hz j
    have := rescaledW_support hR hωs hφs ha z hz j
    simp only [kernelClassOf]
    constructor <;> linarith [this.1, this.2, hcell.1, hcell.2]
  · intro u j
    exact rescaledW_marginal hg hgc ha u j
  · intro m n z
    have h := rescaledW_derivative_bound hω hφ hC₀ hD hωG hφG ha m₀ m n z
    refine h.trans (le_of_eq ?_)
    simp only [kernelClassOf]
    congr 1
    set X : ℝ := ((3 * C₀ + 34 + D : ℕ) : ℝ) * (((m + n : ℕ) : ℝ) + 2)
    rw [← Real.rpow_natCast]
    congr 1
    simp only [X]
    push_cast
    ring

/-- A closed interval avoiding the boundaries `r(ℤ + θ)` lies inside one cell `[c, c + r)`. -/
theorem interval_in_cell_of_no_boundary {r θ α β : ℝ} (hr : 0 < r)
    (hno : ∀ n : ℤ, r * (n + θ) ∉ Set.Icc α β) :
    ∃ n : ℤ, r * (n + θ) ≤ α ∧ β < r * (n + θ) + r := by
  set n : ℤ := ⌊α / r - θ⌋
  have h1 : (n : ℝ) ≤ α / r - θ := Int.floor_le _
  have h2 : α / r - θ < n + 1 := Int.lt_floor_add_one _
  refine ⟨n, ?_, ?_⟩
  · have : (n + θ) ≤ α / r := by linarith only [h1]
    calc r * (n + θ) ≤ r * (α / r) := by gcongr
      _ = α := by field_simp
  · have hlt : α < r * ((n + 1 : ℤ) + θ) := by
      push_cast
      have : α / r < n + 1 + θ := by linarith only [h2]
      calc α = r * (α / r) := by field_simp
        _ < r * (n + 1 + θ) := by gcongr
    by_contra hge
    push Not at hge
    apply hno (n + 1)
    refine ⟨hlt.le, ?_⟩
    push_cast at hge ⊢
    linarith only [hge]

/-- Blueprint lines 2966-2968: if `β - α + r/12 < r/3`, then in one of the lattices with
boundaries `r(ℤ + σ j/3)`, `j ∈ {0, 1}`, the interval `[α, β]` lies in a single cell with margin
`r/24`. -/
theorem exists_lattice_cell_with_margin {r α β : ℝ} (hr : 0 < r)
    (hlen : β - α + r / 12 < r / 3) (σ : ℤ) (hσ : σ = 1 ∨ σ = -1) :
    ∃ j : ℤ, j ∈ Set.Icc (-1 : ℤ) 1 ∧ ∃ n : ℤ,
      r * (n + σ * j / 3) + r / 24 ≤ α ∧ β ≤ r * (n + σ * j / 3) + r - r / 24 := by
  have key : ∀ j : ℤ, j ∈ Set.Icc (-1 : ℤ) 1 →
      (∀ n : ℤ, r * (n + σ * j / 3) ∉ Set.Icc (α - r / 24) (β + r / 24)) →
      ∃ n : ℤ, r * (n + σ * j / 3) + r / 24 ≤ α ∧ β ≤ r * (n + σ * j / 3) + r - r / 24 := by
    intro j _ hno
    obtain ⟨n, h1, h2⟩ := interval_in_cell_of_no_boundary hr hno
    exact ⟨n, by linarith only [h1], by linarith only [h2]⟩
  by_cases h0 : ∀ n : ℤ, r * (n + σ * (0 : ℤ) / 3) ∉ Set.Icc (α - r / 24) (β + r / 24)
  · exact ⟨0, ⟨by norm_num, by norm_num⟩, key 0 ⟨by norm_num, by norm_num⟩ h0⟩
  · refine ⟨1, ⟨by norm_num, by norm_num⟩, key 1 ⟨by norm_num, by norm_num⟩ ?_⟩
    intro n' hn'
    push Not at h0
    obtain ⟨n, hn⟩ := h0
    have := interlacing_boundaries (α := α - r / 24) (L := β - α + r / 12) hr
      (by linarith only [hlen]) σ hσ (j := 0) (j' := 1) ⟨by norm_num, by norm_num⟩
      ⟨by norm_num, by norm_num⟩
      (by rw [show α - r / 24 + (β - α + r / 12) = β + r / 24 by ring]; exact hn)
      (by rw [show α - r / 24 + (β - α + r / 12) = β + r / 24 by ring]; exact hn')
    norm_num at this

/-! ### The three lattices as dyadic grids (thm:main, blueprint lines 2962-2965) -/

theorem neg_one_pow_natAbs_succ (s : ℤ) :
    (-1 : ℝ) ^ (s + 1).natAbs = -(-1 : ℝ) ^ s.natAbs := by
  rcases Int.even_or_odd s with hs | hs
  · have h1 : Odd (s + 1).natAbs := Int.natAbs_odd.mpr (hs.add_one)
    rw [h1.neg_one_pow, (Int.natAbs_even.mpr hs).neg_one_pow]
  · have h1 : Even (s + 1).natAbs := Int.natAbs_even.mpr (hs.add_one)
    rw [h1.neg_one_pow, (Int.natAbs_odd.mpr hs).neg_one_pow, neg_neg]

/-- Blueprint lines 2962-2965: the lattice with boundaries `r_s(ℤ + (-1)^s j/3)`,
`r_s = r_* 2^{-s}`, `j ∈ {-1, 0, 1}`, is a real dyadic grid: consecutive boundaries are
nested since `2(-1)^s j/3 - (-1)^{s+1} j/3 = (-1)^s j` is an integer. -/
noncomputable def interlacedGrid (r₀ : ℝ) (hr₀ : 0 < r₀) (j : ℤ) : RealDyadicGrid where
  baseLength := r₀
  baseLength_pos := hr₀
  origin := fun s => r₀ * (2 : ℝ) ^ (-s) * ((-1 : ℝ) ^ s.natAbs * j / 3)
  alignment := by
    intro s
    refine ⟨(-1 : ℤ) ^ s.natAbs * j, ?_⟩
    rw [neg_one_pow_natAbs_succ]
    have h2 : (2 : ℝ) ^ (-s) = 2 * (2 : ℝ) ^ (-(s + 1)) := by
      rw [show -s = -(s + 1) + 1 by ring, zpow_add₀ (by norm_num), zpow_one]; ring
    rw [h2]
    push_cast
    ring

theorem interlacedGrid_left (r₀ : ℝ) (hr₀ : 0 < r₀) (j s m : ℤ) :
    dyadicGridLeft (interlacedGrid r₀ hr₀ j) s m =
      dyadicGridLength (interlacedGrid r₀ hr₀ j) s * (m + (-1 : ℝ) ^ s.natAbs * j / 3) := by
  simp only [dyadicGridLeft, dyadicGridLength, interlacedGrid]
  ring

/-- Blueprint lines 2968-2969: integers in an interval of length `L` number at most `L + 1`;
hence a cell of length `r = D a` receives at most `D + 1` translates `m a`. -/
theorem card_int_le_of_interval (S : Finset ℤ) {α L : ℝ} (hL : 0 ≤ L)
    (h : ∀ m ∈ S, α ≤ (m : ℝ) ∧ (m : ℝ) ≤ α + L) : (S.card : ℝ) ≤ L + 1 := by
  rcases S.eq_empty_or_nonempty with hS | ⟨m₁, hm₁⟩
  · simp [hS]; linarith only [hL]
  have hsub : S ⊆ Finset.Icc ⌈α⌉ ⌊α + L⌋ := by
    intro m hm
    obtain ⟨h1, h2⟩ := h m hm
    exact Finset.mem_Icc.mpr ⟨Int.ceil_le.mpr h1, Int.le_floor.mpr h2⟩
  have hc := Finset.card_le_card hsub
  rw [Int.card_Icc] at hc
  have h1 := Int.le_ceil α
  have h2 := Int.floor_le (α + L)
  have hle : ⌈α⌉ ≤ ⌊α + L⌋ + 1 := by
    obtain ⟨a1, a2⟩ := h m₁ hm₁
    have : ⌈α⌉ ≤ m₁ := Int.ceil_le.mpr a1
    have : m₁ ≤ ⌊α + L⌋ := Int.le_floor.mpr a2
    omega
  have hcast : ((⌊α + L⌋ + 1 - ⌈α⌉).toNat : ℝ) = (⌊α + L⌋ : ℝ) + 1 - ⌈α⌉ := by
    have hx : (((⌊α + L⌋ + 1 - ⌈α⌉).toNat : ℕ) : ℤ) = ⌊α + L⌋ + 1 - ⌈α⌉ :=
      Int.toNat_of_nonneg (by omega)
    have : (((⌊α + L⌋ + 1 - ⌈α⌉).toNat : ℕ) : ℝ) = ((⌊α + L⌋ + 1 - ⌈α⌉ : ℤ) : ℝ) := by
      exact_mod_cast hx
    rw [this]; push_cast; ring
  calc (S.card : ℝ) ≤ ((⌊α + L⌋ + 1 - ⌈α⌉).toNat : ℝ) := by exact_mod_cast hc
    _ = (⌊α + L⌋ : ℝ) + 1 - ⌈α⌉ := hcast
    _ ≤ L + 1 := by linarith only [h1, h2]

/-! ### Families of local kernels on one grid (thm:main, blueprint lines 2971-2976) -/

/-- The local sum `Σ_p |I_p| |H_{I_p}(f)|` of a family of kernels placed on grid cells. -/
noncomputable def familyLocalSum {ι : Type*} (G : RealDyadicGrid) (R : Finset ι)
    (cell : ι → ℤ × ℤ) (w : ι → ℝ × ℝ → ℂ) (f : Fin 4 → ℝ → ℂ) : ℝ :=
  ∑ p ∈ R, dyadicGridLength G (cell p).1 *
    ‖localProgressionForm (dyadicGridLength G (cell p).1) (w p) f‖

/-- A family of admissible kernels with distinct cells in `N` consecutive depths of one grid is
a finite-depth datum, so its local sum is at most `C_N ∫ Π M_q f_j`. -/
theorem familyLocalSum_le_of_injective {κ : LocalKernelClass} {q : ℝ} (hq : 2 ≤ q) {N : ℕ}
    {ι : Type*} (G : RealDyadicGrid) (R : Finset ι) (cell : ι → ℤ × ℤ)
    (w : ι → ℝ × ℝ → ℂ) (s₀ : ℤ) (hdepth : ∀ p ∈ R, s₀ ≤ (cell p).1 ∧ (cell p).1 < s₀ + N)
    (hadm : ∀ p ∈ R, IsAdmissibleLocalKernel κ (dyadicGridLeft G (cell p).1 (cell p).2)
      (dyadicGridLength G (cell p).1) (w p))
    (hinj : Set.InjOn cell R) (f : Fin 4 → ℝ → ℂ) (hfm : ∀ i, Measurable (f i))
    (hfL : ∀ i, MemLp (f i) (ENNReal.ofReal q) volume) (hfc : ∀ i, HasCompactSupport (f i)) :
    ENNReal.ofReal (familyLocalSum G R cell w f) ≤
      ENNReal.ofReal (finiteDepthConstant κ q N) * ∫⁻ x, ∏ i, scalarMaximalQ q (f i) x := by
  classical
  have hsec : ∀ c ∈ R.image cell, ∃ p ∈ R, cell p = c := fun c hc => by
    simpa using Finset.mem_image.mp hc
  set ker : ℤ × ℤ → ℝ × ℝ → ℂ := fun c =>
    if h : ∃ p ∈ R, cell p = c then w (Classical.choose h) else 0
  have hker : ∀ p ∈ R, ker (cell p) = w p := by
    intro p hp
    have h : ∃ p' ∈ R, cell p' = cell p := ⟨p, hp, rfl⟩
    simp only [ker, h, ↓reduceDIte]
    obtain ⟨hmem, heq⟩ := Classical.choose_spec h
    rw [hinj hmem hp heq]
  let D : FiniteDepthLocalData κ q N :=
    { grid := G
      cells := R.image cell
      firstDepth := s₀
      depths := fun c hc => by
        obtain ⟨p, hp, rfl⟩ := hsec c hc
        exact hdepth p hp
      kernel := ker
      admissible := fun c hc => by
        obtain ⟨p, hp, rfl⟩ := hsec c hc
        rw [hker p hp]; exact hadm p hp
      input := f
      measurable_input := hfm
      memLp_input := hfL
      compact_input := hfc }
  have hnum : finiteDepthNumerator D = familyLocalSum G R cell w f := by
    simp only [finiteDepthNumerator, D, familyLocalSum]
    rw [Finset.sum_image (fun p hp p' hp' h => hinj hp hp' h)]
    apply Finset.sum_congr rfl; intro p hp
    rw [hker p hp]
  have := finiteDepthConstant_spec hq D
  rwa [hnum] at this

theorem familyLocalSum_nonneg {ι : Type*} (G : RealDyadicGrid) (R : Finset ι)
    (cell : ι → ℤ × ℤ) (w : ι → ℝ × ℝ → ℂ) (f : Fin 4 → ℝ → ℂ) :
    0 ≤ familyLocalSum G R cell w f :=
  Finset.sum_nonneg fun _ _ => mul_nonneg (dyadicGridLength_pos G _).le (norm_nonneg _)

/-- Blueprint lines 2968-2976: if at most `M` kernels of the family share a cell, the family
splits into `M` subfamilies with distinct cells, so its local sum is at most
`M C_N ∫ Π M_q f_j`. -/
theorem familyLocalSum_le_of_multiplicity {κ : LocalKernelClass} {q : ℝ} (hq : 2 ≤ q) {N : ℕ}
    {ι : Type*} (G : RealDyadicGrid) (cell : ι → ℤ × ℤ)
    (w : ι → ℝ × ℝ → ℂ) (s₀ : ℤ) (f : Fin 4 → ℝ → ℂ) (hfm : ∀ i, Measurable (f i))
    (hfL : ∀ i, MemLp (f i) (ENNReal.ofReal q) volume) (hfc : ∀ i, HasCompactSupport (f i)) :
    ∀ (M : ℕ) (R : Finset ι), (∀ c, (R.filter fun p => cell p = c).card ≤ M) →
      (∀ p ∈ R, s₀ ≤ (cell p).1 ∧ (cell p).1 < s₀ + N) →
      (∀ p ∈ R, IsAdmissibleLocalKernel κ (dyadicGridLeft G (cell p).1 (cell p).2)
        (dyadicGridLength G (cell p).1) (w p)) →
      ENNReal.ofReal (familyLocalSum G R cell w f) ≤
        M * (ENNReal.ofReal (finiteDepthConstant κ q N) * ∫⁻ x, ∏ i, scalarMaximalQ q (f i) x) := by
  classical
  intro M
  induction M with
  | zero =>
    intro R hM _ _
    have hR : R = ∅ := by
      by_contra hne
      obtain ⟨p, hp⟩ := Finset.nonempty_iff_ne_empty.mpr hne
      have := hM (cell p)
      have hpos : 0 < (R.filter fun p' => cell p' = cell p).card :=
        Finset.card_pos.mpr ⟨p, Finset.mem_filter.mpr ⟨hp, rfl⟩⟩
      omega
    simp [hR, familyLocalSum]
  | succ M ih =>
    intro R hM hdepth hadm
    have hsec : ∀ c ∈ R.image cell, ∃ p ∈ R, cell p = c := fun c hc => by
      simpa using Finset.mem_image.mp hc
    -- one representative per occupied cell
    let rep : (R.image cell) → ι := fun c => Classical.choose (hsec c.1 c.2)
    have hrep : ∀ c, rep c ∈ R ∧ cell (rep c) = c.1 := fun c =>
      Classical.choose_spec (hsec c.1 c.2)
    set S := (R.image cell).attach.image rep
    have hSR : S ⊆ R := by
      intro p hp
      obtain ⟨c, -, rfl⟩ := Finset.mem_image.mp hp
      exact (hrep c).1
    have hSinj : Set.InjOn cell S := by
      intro p hp p' hp' h
      obtain ⟨c, -, rfl⟩ := Finset.mem_image.mp hp
      obtain ⟨c', -, rfl⟩ := Finset.mem_image.mp hp'
      rw [(hrep c).2, (hrep c').2] at h
      rw [Subtype.ext h]
    have hS := familyLocalSum_le_of_injective hq G S cell w s₀
      (fun p hp => hdepth p (hSR hp)) (fun p hp => hadm p (hSR hp)) hSinj f hfm hfL hfc
    -- the remaining kernels have multiplicity at most `M`
    have hrest : ∀ c, ((R \ S).filter fun p => cell p = c).card ≤ M := by
      intro c
      by_cases hc : c ∈ R.image cell
      · set r := rep ⟨c, hc⟩
        have hr := hrep ⟨c, hc⟩
        have hsub : ((R \ S).filter fun p => cell p = c) ⊆
            (R.filter fun p => cell p = c).erase r := by
          intro p hp
          obtain ⟨hpRS, hpc⟩ := Finset.mem_filter.mp hp
          obtain ⟨hpR, hpS⟩ := Finset.mem_sdiff.mp hpRS
          refine Finset.mem_erase.mpr ⟨?_, Finset.mem_filter.mpr ⟨hpR, hpc⟩⟩
          rintro rfl
          exact hpS (Finset.mem_image.mpr ⟨⟨c, hc⟩, Finset.mem_attach _ _, rfl⟩)
        have hmem : r ∈ R.filter fun p => cell p = c := Finset.mem_filter.mpr ⟨hr.1, hr.2⟩
        have := Finset.card_le_card hsub
        rw [Finset.card_erase_of_mem hmem] at this
        have := hM c
        omega
      · have : ((R \ S).filter fun p => cell p = c) = ∅ := by
          ext p
          simp only [Finset.mem_filter, Finset.mem_sdiff, Finset.notMem_empty, iff_false,
            not_and]
          intro ⟨hpR, _⟩ hpc
          exact hc (Finset.mem_image.mpr ⟨p, hpR, hpc⟩)
        rw [this]; simp
    have hR' := ih (R \ S) hrest (fun p hp => hdepth p (Finset.mem_sdiff.mp hp).1)
      (fun p hp => hadm p (Finset.mem_sdiff.mp hp).1)
    have hsplit : familyLocalSum G R cell w f =
        familyLocalSum G S cell w f + familyLocalSum G (R \ S) cell w f := by
      simp only [familyLocalSum]
      rw [add_comm, Finset.sum_sdiff hSR]
    rw [hsplit, ENNReal.ofReal_add (familyLocalSum_nonneg _ _ _ _ _)
      (familyLocalSum_nonneg _ _ _ _ _)]
    calc _ ≤ (ENNReal.ofReal (finiteDepthConstant κ q N) * ∫⁻ x, ∏ i, scalarMaximalQ q (f i) x) +
          M * (ENNReal.ofReal (finiteDepthConstant κ q N) * ∫⁻ x, ∏ i, scalarMaximalQ q (f i) x) :=
          add_le_add hS hR'
      _ = _ := by push_cast; ring

/-- The scale-`a` translate-`m` term `∫ a⁻¹ W(x/a - m, t/a) Π_j f_j(x + jt) dx dt` of the
integrated kernel (blueprint lines 2957-2960). -/
noncomputable def scaleTranslateTerm (W : ℝ × ℝ → ℂ) (a m : ℝ) (f : Fin 4 → ℝ → ℂ) : ℂ :=
  ∫ z : ℝ × ℝ, ((a⁻¹ : ℝ) : ℂ) * W (z.1 / a - m, z.2 / a) *
    ∏ j, f j (realProgressionCoordinate j z)

/-- Blueprint lines 2957-2960: the term equals `|I| H_I(f)` for the rescaled kernel on a cell
of length `r = D a`. -/
theorem scaleTranslateTerm_eq (W : ℝ × ℝ → ℂ) {a r : ℝ} (ha : 0 < a) (hr : 0 < r) (m : ℝ)
    (f : Fin 4 → ℝ → ℂ) :
    scaleTranslateTerm W a m f = (r : ℂ) * localProgressionForm r (rescaledKernel W a r m) f := by
  simp only [scaleTranslateTerm, localProgressionForm, rescaledKernel]
  have hr0 : (r : ℂ) ≠ 0 := by exact_mod_cast hr.ne'
  have ha0 : (a : ℂ) ≠ 0 := by exact_mod_cast ha.ne'
  rw [show (fun z : ℝ × ℝ => ((r / a : ℝ) : ℂ) * W (z.1 / a - m, z.2 / a) *
      ∏ j, f j (realProgressionCoordinate j z)) =
      fun z => ((r : ℂ) * (r : ℂ)) * (((a⁻¹ : ℝ) : ℂ) * W (z.1 / a - m, z.2 / a) *
        ∏ j, f j (realProgressionCoordinate j z)) / r by
      funext z; push_cast; field_simp]
  rw [integral_div, integral_const_mul]
  field_simp

theorem interlacedGrid_length (r₀ : ℝ) (hr₀ : 0 < r₀) (j n : ℤ) :
    dyadicGridLength (interlacedGrid r₀ hr₀ j) (-n) = r₀ * (2 : ℝ) ^ n := by
  simp [dyadicGridLength, interlacedGrid]

/-- Blueprint lines 2957-2976, for one value of `b`: for any finite set `P` of scales `n` (in
`N` consecutive values) and translates `m`, with `a = b 2ⁿ` and `D > 8 + 24R`,
`Σ_{(n,m) ∈ P} |∫ a⁻¹ W(x/a - m, t/a) Π f_j| ≤ 3 (D + 1) C_N ∫ Π M_q f_j`, where `C_N` is the
finite-depth constant of the fixed admissible class. -/
theorem truncated_scale_sum_bound {ω φ : ℝ → ℂ} (hω : ContDiff ℝ (⊤ : ℕ∞) ω)
    (hφ : ContDiff ℝ (⊤ : ℕ∞) φ) {R : ℝ} (hR : 0 ≤ R) (hωs : tsupport ω ⊆ Set.Icc (-1) 1)
    (hφs : tsupport φ ⊆ Set.Icc (-R) R) {C₀ D : ℕ} (hC₀ : 1 ≤ C₀) (hD : 1 ≤ D)
    (hDR : 8 + 24 * R < D)
    (hωG : ∀ j x, ‖iteratedDeriv j ω x‖ ≤ ((C₀ : ℝ) * ((j : ℝ) + 1)) ^ (C₀ * (j + 1)))
    (hφG : ∀ j x, ‖iteratedDeriv j φ x‖ ≤ ((C₀ : ℝ) * ((j : ℝ) + 1)) ^ (C₀ * (j + 1)))
    {q : ℝ} (hq : 2 ≤ q) (N : ℕ) {b : ℝ} (hb : 0 < b) (n₁ : ℤ) (P : Finset (ℤ × ℤ))
    (hP : ∀ p ∈ P, n₁ ≤ p.1 ∧ p.1 < n₁ + N) (f : Fin 4 → ℝ → ℂ)
    (hfm : ∀ i, Measurable (f i)) (hfL : ∀ i, MemLp (f i) (ENNReal.ofReal q) volume)
    (hfc : ∀ i, HasCompactSupport (f i)) :
    ENNReal.ofReal (∑ p ∈ P, ‖scaleTranslateTerm (fourMarginalKernel (tensorKernel ω φ))
        (b * (2 : ℝ) ^ p.1) p.2 f‖) ≤
      3 * ((D + 1 : ℕ) * (ENNReal.ofReal (finiteDepthConstant
        (kernelClassOf (1 / 24) (by norm_num) (3 * C₀ + 34 + D) (by omega)) q N) *
        ∫⁻ x, ∏ i, scalarMaximalQ q (f i) x)) := by
  classical
  set W := fourMarginalKernel (tensorKernel ω φ)
  set κ := kernelClassOf (1 / 24) (by norm_num) (3 * C₀ + 34 + D) (by omega)
  have hDb : (0 : ℝ) < D * b := by positivity
  set! a : ℤ × ℤ → ℝ := fun p => b * (2 : ℝ) ^ p.1
  have ha : ∀ p, 0 < a p := fun p => by positivity
  -- the lattice sign at depth `-n`
  set! σ : ℤ × ℤ → ℤ := fun p => (-1) ^ (-p.1).natAbs
  have hσ : ∀ p, σ p = 1 ∨ σ p = -1 := fun p => by
    rcases Nat.even_or_odd (-p.1).natAbs with h | h
    · left; exact h.neg_one_pow
    · right; exact h.neg_one_pow
  have hσr : ∀ p, ((σ p : ℤ) : ℝ) = (-1 : ℝ) ^ (-p.1).natAbs := fun p => by
    simp [σ]
  -- choose a lattice and a cell for every term
  have hex : ∀ p : ℤ × ℤ, ∃ j : ℤ, j ∈ Set.Icc (-1 : ℤ) 1 ∧ ∃ n' : ℤ,
      D * a p * (n' + σ p * j / 3) + D * a p / 24 ≤ a p * (p.2 - 1 - 3 * R) ∧
      a p * (p.2 + 1 + 3 * R) ≤ D * a p * (n' + σ p * j / 3) + D * a p - D * a p / 24 := by
    intro p
    have hap := ha p
    apply exists_lattice_cell_with_margin (by positivity) _ (σ p) (hσ p)
    have hD' : (8 : ℝ) + 24 * R < D := hDR
    nlinarith only [hDR, hap]
  choose J hJ Nc hNc using hex
  set! G : ℤ → RealDyadicGrid := fun j => interlacedGrid (D * b) hDb j
  set! cell : ℤ × ℤ → ℤ × ℤ := fun p => (-p.1, Nc p)
  set! w : ℤ × ℤ → ℝ × ℝ → ℂ := fun p => rescaledKernel W (a p) (D * a p) p.2
  have hlen : ∀ j p, dyadicGridLength (G j) (cell p).1 = D * a p := fun j p => by
    simp only [G, cell, a]; rw [interlacedGrid_length]; ring
  have hleft : ∀ p, dyadicGridLeft (G (J p)) (cell p).1 (cell p).2 =
      D * a p * (Nc p + σ p * J p / 3) := fun p => by
    simp only [G]
    rw [interlacedGrid_left, ← hσr p]
    simp only [cell]
    rw [show dyadicGridLength (interlacedGrid (D * b) hDb (J p)) (-p.1) = D * a p from
      hlen (J p) p]
  -- each term is a local form on its cell
  have hterm : ∀ p, ‖scaleTranslateTerm W (a p) p.2 f‖ =
      dyadicGridLength (G (J p)) (cell p).1 *
        ‖localProgressionForm (dyadicGridLength (G (J p)) (cell p).1) (w p) f‖ := by
    intro p
    have hr : (0 : ℝ) < D * a p := by have := ha p; positivity
    rw [hlen, scaleTranslateTerm_eq W (ha p) hr p.2 f, norm_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hr]
  -- admissibility
  have hadm : ∀ p, IsAdmissibleLocalKernel κ (dyadicGridLeft (G (J p)) (cell p).1 (cell p).2)
      (dyadicGridLength (G (J p)) (cell p).1) (w p) := by
    intro p
    rw [hleft, hlen]
    obtain ⟨h1, h2⟩ := hNc p
    exact rescaledW_admissible hω hφ hR hωs hφs hC₀ hD hωG hφG (by norm_num) (ha p)
      ⟨by linarith only [h1], by linarith only [h2]⟩
  set X := ENNReal.ofReal (finiteDepthConstant κ q N) * ∫⁻ x, ∏ i, scalarMaximalQ q (f i) x
  -- multiplicity at most `D + 1` per cell
  have hmult : ∀ j c, (((P.filter fun p => J p = j).filter fun p => cell p = c)).card ≤ D + 1 := by
    intro j c
    set F := (P.filter fun p => J p = j).filter fun p => cell p = c
    have hfst : ∀ p ∈ F, p.1 = -c.1 := by
      intro p hp
      have := (Finset.mem_filter.mp hp).2
      rw [← this]; simp [cell]
    have hinj : Set.InjOn Prod.snd (F : Set (ℤ × ℤ)) := by
      intro p hp p' hp' h
      exact Prod.ext ((hfst p hp).trans (hfst p' hp').symm) h
    set! α : ℝ := D * (c.2 + σ (-c.1, 0) * j / 3) + D / 24 + 1 + 3 * R
    have hrange : ∀ m ∈ F.image Prod.snd, α ≤ (m : ℝ) ∧ (m : ℝ) ≤ α + D := by
      intro m hm
      obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hm
      obtain ⟨hpP, hpc⟩ := Finset.mem_filter.mp hp
      have hpj := (Finset.mem_filter.mp hpP).2
      have hp1 : p.1 = -c.1 := hfst p hp
      have hNcp : Nc p = c.2 := by rw [← hpc]
      have hσp : σ p = σ (-c.1, 0) := by simp [σ, hp1]
      obtain ⟨h1, h2⟩ := hNc p
      rw [hNcp, hσp, hpj] at h1 h2
      have hap := ha p
      constructor
      · have : a p * (D * (c.2 + σ (-c.1, 0) * j / 3) + D / 24 + 1 + 3 * R) ≤ a p * p.2 := by
          nlinarith only [h1]
        exact le_of_mul_le_mul_left this hap
      · have : a p * p.2 ≤ a p * (α + D) := by simp only [α]; nlinarith only [hR, hDR, h1, h2]
        exact le_of_mul_le_mul_left this hap
    have hcard := card_int_le_of_interval (F.image Prod.snd) (by positivity) hrange
    rw [Finset.card_image_of_injOn hinj] at hcard
    exact_mod_cast hcard
  -- sum over the lattice indices
  have hsplit : ∑ p ∈ P, ‖scaleTranslateTerm W (a p) p.2 f‖ =
      ∑ j ∈ Finset.Icc (-1 : ℤ) 1, familyLocalSum (G j) (P.filter fun p => J p = j) cell w f := by
    rw [← Finset.sum_fiberwise_of_maps_to (g := J) (fun p _ => Finset.mem_Icc.mpr (hJ p))]
    apply Finset.sum_congr rfl; intro j _
    simp only [familyLocalSum]
    apply Finset.sum_congr rfl; intro p hp
    rw [hterm, (Finset.mem_filter.mp hp).2]
  have hfam : ∀ j, ENNReal.ofReal (familyLocalSum (G j) (P.filter fun p => J p = j) cell w f) ≤
      (D + 1 : ℕ) * X := by
    intro j
    apply familyLocalSum_le_of_multiplicity hq (G j) cell w (-(n₁ + N - 1)) f hfm hfL hfc
      (D + 1) _ (hmult j)
    · intro p hp
      have := hP p (Finset.mem_filter.mp hp).1
      simp only [cell]; omega
    · intro p hp
      have hj := (Finset.mem_filter.mp hp).2
      rw [← hj]; exact hadm p
  change ENNReal.ofReal (∑ p ∈ P, ‖scaleTranslateTerm W (a p) p.2 f‖) ≤ 3 * ((D + 1 : ℕ) * X)
  rw [hsplit, ENNReal.ofReal_sum_of_nonneg (fun j _ => familyLocalSum_nonneg _ _ _ _ _)]
  calc ∑ j ∈ Finset.Icc (-1 : ℤ) 1,
        ENNReal.ofReal (familyLocalSum (G j) (P.filter fun p => J p = j) cell w f) ≤
      ∑ _j ∈ Finset.Icc (-1 : ℤ) 1, (D + 1 : ℕ) * X := Finset.sum_le_sum fun j _ => hfam j
    _ = 3 * ((D + 1 : ℕ) * X) := by simp

/-! ### The maximal-function bound (thm:main, blueprint lines 2976-2980) -/

open TrilinearHT.Auto.ClassicalMaximal in
/-- The uncentered powered maximal function is at most `2^{1/q}` times the centered one. -/
theorem scalarMaximalQ_le_hl {q : ℝ} (hq : 0 < q) (f : ℝ → ℂ) (x : ℝ) :
    scalarMaximalQ q f x ≤
      2 ^ (1 / q) * hlMaximal volume (fun y => ‖f y‖ ^ q) x ^ (1 / q) := by
  unfold scalarMaximalQ maximalQ
  rw [← ENNReal.mul_rpow_of_nonneg _ _ (by positivity)]
  exact ENNReal.rpow_le_rpow (uncenteredRealMaximal_le_two_centered _ x) (by positivity)

open TrilinearHT.Auto.ClassicalMaximal in
theorem scalarMaximalQ_le_of_bound {q : ℝ} (hq : 0 < q) {f : ℝ → ℂ} {B : ℝ} (hB : 0 ≤ B)
    (hf : ∀ y, ‖f y‖ ≤ B) (x : ℝ) : scalarMaximalQ q f x ≤ ENNReal.ofReal B := by
  change uncenteredRealMaximal (fun y => ‖f y‖ ^ q) x ^ (1 / q) ≤ ENNReal.ofReal B
  have hbound : uncenteredRealMaximal (fun y => ‖f y‖ ^ q) x ≤ ENNReal.ofReal (B ^ q) := by
    refine iSup_le fun a => iSup_le fun b => iSup_le fun hab => iSup_le fun _ => ?_
    have hpt : ∀ y, ‖‖f y‖ ^ q‖ₑ ≤ ENNReal.ofReal (B ^ q) := fun y => by
      rw [Real.enorm_eq_ofReal (by positivity)]
      exact ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow (norm_nonneg _) (hf y) hq.le)
    calc (ENNReal.ofReal (b - a))⁻¹ * ∫⁻ y in Set.Icc a b, ‖‖f y‖ ^ q‖ₑ ≤
        (ENNReal.ofReal (b - a))⁻¹ * ∫⁻ _ in Set.Icc a b, ENNReal.ofReal (B ^ q) := by
          gcongr with y; exact hpt y
      _ = ENNReal.ofReal (B ^ q) := by
          rw [setLIntegral_const, Real.volume_Icc, mul_comm, mul_assoc,
            ENNReal.mul_inv_cancel (by simpa using hab) ENNReal.ofReal_ne_top, mul_one]
  calc uncenteredRealMaximal (fun y => ‖f y‖ ^ q) x ^ (1 / q) ≤
      ENNReal.ofReal (B ^ q) ^ (1 / q) := ENNReal.rpow_le_rpow hbound (by positivity)
    _ = ENNReal.ofReal B := by
        rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity), ← Real.rpow_mul hB,
          mul_one_div_cancel hq.ne', Real.rpow_one]

open TrilinearHT.Auto.ClassicalMaximal in
/-- The Hardy–Littlewood maximal theorem on `ℝ` (doubling constant `3`). -/
theorem eLpNorm_hlMaximal_le_real {p : ℝ} (hp : 1 < p) {h : ℝ → ℝ}
    (hh : AEStronglyMeasurable h volume) :
    eLpNorm (hlMaximal volume h) (ENNReal.ofReal p) volume ≤
      hlMaximalConst 3 p * eLpNorm h (ENNReal.ofReal p) volume := by
  apply eLpNorm_hlMaximal_le (fun _ _ => measure_closedBall_lt_top.ne) _ hp hh
  intro x r hr
  rw [Real.volume_closedBall, Real.volume_closedBall,
    show (2 : ℝ) * (3 * r) = 3 * (2 * r) by ring, ENNReal.ofReal_mul (by norm_num)]
  simp

open TrilinearHT.Auto.ClassicalMaximal in
/-- The `L³` norm of the centered powered maximal function, for `q < 3`:
`∫ (M (|f|^q))^{3/q} ≤ K^{3/q} ∫ |f|³` with `K = hlMaximalConst 3 (3/q)`. -/
theorem lintegral_hlMaximal_pow_le {q : ℝ} (hq : 0 < q) (hq3 : q < 3) {f : ℝ → ℂ}
    (hf : Measurable f) :
    ∫⁻ x, hlMaximal volume (fun y => ‖f y‖ ^ q) x ^ (3 / q) ≤
      hlMaximalConst 3 (3 / q) ^ (3 / q) * ∫⁻ x, ‖f x‖ₑ ^ (3 : ℝ) := by
  have hp : 1 < 3 / q := by rw [lt_div_iff₀ hq]; linarith
  have hp0 : 0 < 3 / q := by positivity
  have hh : AEStronglyMeasurable (fun y => ‖f y‖ ^ q) volume :=
    (hf.norm.pow_const q).aestronglyMeasurable
  have h := eLpNorm_hlMaximal_le_real hp hh
  have hM : Measurable (hlMaximal volume (fun y => ‖f y‖ ^ q)) :=
    measurable_hlMaximal (fun _ _ => measure_closedBall_lt_top.ne) hh
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by positivity) ENNReal.ofReal_ne_top
      hM.aestronglyMeasurable,
    eLpNorm_eq_lintegral_rpow_enorm_toReal (by positivity) ENNReal.ofReal_ne_top hh,
    ENNReal.toReal_ofReal hp0.le] at h
  have hpow := ENNReal.rpow_le_rpow h hp0.le
  rw [← ENNReal.rpow_mul, one_div_mul_cancel hp0.ne', ENNReal.rpow_one,
    ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul, one_div_mul_cancel hp0.ne',
    ENNReal.rpow_one] at hpow
  simp only [enorm_eq_self] at hpow
  refine hpow.trans (le_of_eq ?_)
  congr 1
  apply lintegral_congr; intro y
  rw [Real.enorm_eq_ofReal (by positivity), ← ofReal_norm,
    ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hq.le, ← ENNReal.rpow_mul]
  congr 1; field_simp

open TrilinearHT.Auto.ClassicalMaximal in
/-- Blueprint lines 2976-2980: for `0 < q < 3`, `|f₀| ≤ B` and measurable `f₁, f₂, f₃`,
`∫ Π_j M_q f_j ≤ B Π_{j=1}^3 2^{1/q} K^{1/q} ‖f_j‖_3`, by Hölder in three `L³` factors and the
Hardy–Littlewood maximal theorem in `L^{3/q}`. -/
theorem maximal_product_bound {q : ℝ} (hq : 0 < q) (hq3 : q < 3) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ i, Measurable (f i)) {B : ℝ} (hB : 0 ≤ B) (h0 : ∀ y, ‖f 0 y‖ ≤ B) :
    ∫⁻ x, ∏ i, scalarMaximalQ q (f i) x ≤ ENNReal.ofReal B *
      ∏ j : Fin 3, (2 ^ (1 / q) * hlMaximalConst 3 (3 / q) ^ (1 / q) *
        (∫⁻ x, ‖f j.succ x‖ₑ ^ (3 : ℝ)) ^ (1 / (3 : ℝ))) := by
  set K := hlMaximalConst 3 (3 / q)
  set g : Fin 3 → ℝ → ℝ≥0∞ := fun j x =>
    2 ^ (1 / q) * hlMaximal volume (fun y => ‖f j.succ y‖ ^ q) x ^ (1 / q)
  have hgm : ∀ j, Measurable (g j) := fun j => by
    have := measurable_hlMaximal (μ := volume) (fun _ _ => measure_closedBall_lt_top.ne)
      (((hf j.succ).norm.pow_const q).aestronglyMeasurable)
    exact measurable_const.mul (this.pow_const _)
  have hpt : ∀ x, ∏ i, scalarMaximalQ q (f i) x ≤ ENNReal.ofReal B * ∏ j, g j x := by
    intro x
    rw [Fin.prod_univ_succ]
    gcongr with j
    · exact scalarMaximalQ_le_of_bound hq hB h0 x
    · exact scalarMaximalQ_le_hl hq _ x
  have hHolder : ∫⁻ x, ∏ j, g j x ≤ ∏ j, (∫⁻ x, g j x ^ (3 : ℝ)) ^ (1 / (3 : ℝ)) := by
    have h := ENNReal.lintegral_prod_norm_pow_le (μ := volume) Finset.univ
      (f := fun j x => g j x ^ (3 : ℝ)) (fun j _ => ((hgm j).pow_const _).aemeasurable)
      (p := fun _ => 1 / 3) (by simp) (fun _ _ => by norm_num)
    refine le_trans (le_of_eq ?_) h
    congr 1; funext x
    apply Finset.prod_congr rfl; intro j _
    rw [← ENNReal.rpow_mul]; norm_num
  have hpow : ∀ j, ∫⁻ x, g j x ^ (3 : ℝ) ≤
      2 ^ (3 / q) * (K ^ (3 / q) * ∫⁻ x, ‖f j.succ x‖ₑ ^ (3 : ℝ)) := by
    intro j
    have e : ∀ x, g j x ^ (3 : ℝ) =
        2 ^ (3 / q) * hlMaximal volume (fun y => ‖f j.succ y‖ ^ q) x ^ (3 / q) := by
      intro x
      simp only [g]
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
      congr 2 <;> ring
    simp_rw [e]
    rw [lintegral_const_mul _ ((measurable_hlMaximal (fun _ _ => measure_closedBall_lt_top.ne)
      (((hf j.succ).norm.pow_const q).aestronglyMeasurable)).pow_const _)]
    gcongr
    exact lintegral_hlMaximal_pow_le hq hq3 (hf j.succ)
  calc ∫⁻ x, ∏ i, scalarMaximalQ q (f i) x ≤ ∫⁻ x, ENNReal.ofReal B * ∏ j, g j x :=
        lintegral_mono hpt
    _ = ENNReal.ofReal B * ∫⁻ x, ∏ j, g j x := lintegral_const_mul _
          (Finset.measurable_prod _ fun j _ => hgm j)
    _ ≤ ENNReal.ofReal B * ∏ j, (∫⁻ x, g j x ^ (3 : ℝ)) ^ (1 / (3 : ℝ)) := by gcongr
    _ ≤ ENNReal.ofReal B * ∏ j : Fin 3, (2 ^ (3 / q) * (K ^ (3 / q) *
          ∫⁻ x, ‖f j.succ x‖ₑ ^ (3 : ℝ))) ^ (1 / (3 : ℝ)) := by
        gcongr with j
        exact hpow j
    _ = _ := by
        congr 1
        apply Finset.prod_congr rfl; intro j _
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num),
          ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
          ← mul_assoc]
        congr 3 <;> ring

/-! ### The scale-truncated kernel (thm:main, blueprint lines 2955-2958 and 2982-2995) -/

/-- Blueprint `eq:kernel-reconstruction`, truncated in scale: for `ψ = φ'''` with continuous
derivative `ψ' = φ⁽⁴⁾`, `t ≠ 0` and `0 < A ≤ B`,
`∫_A^B ψ'(t/a) a⁻² da = (ψ(t/A) - ψ(t/B))/t`. -/
theorem scale_kernel_integral {ψ ψ' : ℝ → ℂ} (hd : ∀ x, HasDerivAt ψ (ψ' x) x)
    (hψ' : Continuous ψ') {t A B : ℝ} (ht : t ≠ 0) (hA : 0 < A) (hAB : A ≤ B) :
    ∫ a in A..B, ψ' (t / a) * ((a ^ 2)⁻¹ : ℝ) = (ψ (t / A) - ψ (t / B)) / t := by
  have hderiv : ∀ a ∈ Set.uIcc A B, HasDerivAt (fun a : ℝ => -(ψ (t / a)) * ((t : ℂ))⁻¹)
      (ψ' (t / a) * ((a ^ 2)⁻¹ : ℝ)) a := by
    intro a ha
    rw [Set.uIcc_of_le hAB] at ha
    have ha0 : a ≠ 0 := (hA.trans_le ha.1).ne'
    have h1 : HasDerivAt (fun a : ℝ => t / a) (-(t / a ^ 2)) a := by
      have := (hasDerivAt_inv ha0).const_mul t
      simpa [div_eq_mul_inv] using this
    have h2 : HasDerivAt (fun a : ℝ => -(ψ (t / a)) * ((t : ℂ))⁻¹)
        (-(-(t / a ^ 2) • ψ' (t / a)) * ((t : ℂ))⁻¹) a :=
      ((hd (t / a)).scomp a h1).neg.mul_const ((t : ℂ))⁻¹
    convert h2 using 1
    have ht' : (t : ℂ) ≠ 0 := by exact_mod_cast ht
    have ha' : (a : ℂ) ≠ 0 := by exact_mod_cast ha0
    rw [Complex.real_smul]
    push_cast
    field_simp
  have hcont : ContinuousOn (fun a : ℝ => ψ' (t / a) * ((a ^ 2)⁻¹ : ℝ)) (Set.uIcc A B) := by
    rw [Set.uIcc_of_le hAB]
    intro a ha
    have ha0 : a ≠ 0 := (hA.trans_le ha.1).ne'
    apply ContinuousAt.continuousWithinAt
    apply ContinuousAt.mul
    · exact hψ'.continuousAt.comp (continuousAt_const.div continuousAt_id ha0)
    · exact Complex.continuous_ofReal.continuousAt.comp
        ((continuousAt_id.pow 2).inv₀ (pow_ne_zero 2 ha0))
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv
    (hcont.intervalIntegrable)]
  field_simp
  ring

/-- The kernel of a translated product is the translated kernel. -/
theorem fourMarginalKernel_translate {ω φ : ℝ → ℂ} (hω : ContDiff ℝ (⊤ : ℕ∞) ω)
    (hφ : ContDiff ℝ (⊤ : ℕ∞) φ) (m : ℝ) (p : ℝ × ℝ) :
    fourMarginalKernel (fun p : ℝ × ℝ => ω (p.1 - m) * φ p.2) p =
      fourMarginalKernel (tensorKernel ω φ) (p.1 - m, p.2) := by
  have hωm : ContDiff ℝ (⊤ : ℕ∞) fun X => ω (X - m) := hω.comp (contDiff_id.sub contDiff_const)
  have e : (fun p : ℝ × ℝ => ω (p.1 - m) * φ p.2) = tensorKernel (fun X => ω (X - m)) φ := rfl
  have hk : ∀ k : ℕ, iteratedDeriv k (fun X => ω (X - m)) =
      fun X => iteratedDeriv k ω (X - m) := by
    intro k
    have := iteratedDeriv_affine_complex k hω 1 (-m)
    simp only [one_mul, Complex.ofReal_one, one_pow] at this
    simpa [sub_eq_add_neg] using this
  rw [e, fourMarginalKernel_tensor hωm hφ, fourMarginalKernel_tensor hω hφ]
  simp only [tensorKernel, hk]

/-- Blueprint line 2952 at scale `a`: if `ω` is a smooth partition of unity supported in
`[-3/4, 3/4]`, then for every `x, t` and every finite set `F ⊇ {m : |x/a - m| < 1}`,
`Σ_{m ∈ F} W(x/a - m, t/a) = φ⁽⁴⁾(t/a)`. -/
theorem partition_sum_finite {ω φ : ℝ → ℝ} (hω : ContDiff ℝ (⊤ : ℕ∞) ω)
    (hsupp : ∀ x, 3 / 4 ≤ |x| → ω x = 0) (hsum : ∀ x, ∑' k : ℤ, ω (x - k) = 1)
    (hφ : ContDiff ℝ (⊤ : ℕ∞) φ) (X S : ℝ) (F : Finset ℤ)
    (hF : ∀ m : ℤ, |X - m| < 1 → m ∈ F) :
    ∑ m ∈ F, fourMarginalKernel (tensorKernel (fun y => (ω y : ℂ)) (fun y => (φ y : ℂ)))
      (X - m, S) = iteratedDeriv 4 (fun y => (φ y : ℂ)) S := by
  have hωc : ContDiff ℝ (⊤ : ℕ∞) fun y => (ω y : ℂ) := Complex.ofRealCLM.contDiff.comp hω
  have hφc : ContDiff ℝ (⊤ : ℕ∞) fun y => (φ y : ℂ) := Complex.ofRealCLM.contDiff.comp hφ
  have hfull := fourMarginalKernel_partition_sum hω
    (fun x hx => hsupp x (by linarith only [hx])) hsum hφc X S
  rw [← hfull, tsum_eq_sum (s := F)]
  · apply Finset.sum_congr rfl; intro m _
    rw [fourMarginalKernel_translate hωc hφc]
  · intro m hm
    have hfar : 1 ≤ |X - m| := by
      by_contra h; push Not at h; exact hm (hF m h)
    -- the kernel vanishes near `(X, S)`
    have hnear : ∀ᶠ p in nhds (X, S), |p.1 - X| < 1 / 4 := by
      have : Continuous fun p : ℝ × ℝ => |p.1 - X| := by fun_prop
      exact this.continuousAt.eventually_lt continuousAt_const (by simp)
    have he : (fun p : ℝ × ℝ => (ω (p.1 - m) : ℂ) * (φ p.2 : ℂ)) =ᶠ[nhds (X, S)]
        fun _ => 0 := by
      filter_upwards [hnear] with p hp
      have : 3 / 4 ≤ |p.1 - m| := by
        have := abs_sub_abs_le_abs_sub (X - m) (p.1 - m)
        rw [show X - m - (p.1 - m) = -(p.1 - X) by ring, abs_neg] at this
        linarith only [hfar, hp, this]
      simp [hsupp _ this]
    rw [fourMarginalKernel_eventuallyEq he, fourMarginalKernel_zero]; rfl

/-- A continuous compactly supported kernel composed with the affine map
`z ↦ (z.1/a - m, z.2/a)` is integrable. -/
theorem integrable_rescaled_kernel {W : ℝ × ℝ → ℂ} (hW : Continuous W)
    (hWc : HasCompactSupport W) {a : ℝ} (ha : 0 < a) (m : ℝ) :
    Integrable fun z : ℝ × ℝ => W (z.1 / a - m, z.2 / a) := by
  have hg : Continuous fun z : ℝ × ℝ => (z.1 / a - m, z.2 / a) := by fun_prop
  apply (hW.comp hg).integrable_of_hasCompactSupport
  have hh : Continuous fun p : ℝ × ℝ => (a * (p.1 + m), a * p.2) := by fun_prop
  refine HasCompactSupport.intro (hWc.isCompact.image hh) fun z hz => ?_
  by_contra hne
  apply hz
  refine ⟨(z.1 / a - m, z.2 / a), subset_tsupport _ hne, ?_⟩
  ext <;> simp <;> field_simp

/-- Blueprint lines 2951-2958 at scale `a`: if `f₀` vanishes outside `[-T, T]` and `F` contains
all `m` with `|m| ≤ T/a + 1`, then `Σ_{m ∈ F} ∫ a⁻¹ W(x/a - m, t/a) Π f_j = ∫ a⁻¹ φ⁽⁴⁾(t/a) Π f_j`.
-/
theorem sum_scaleTranslateTerm {ω φ : ℝ → ℝ} (hω : ContDiff ℝ (⊤ : ℕ∞) ω)
    (hsupp : ∀ x, 3 / 4 ≤ |x| → ω x = 0) (hsum : ∀ x, ∑' k : ℤ, ω (x - k) = 1)
    (hωc : HasCompactSupport ω) (hφ : ContDiff ℝ (⊤ : ℕ∞) φ) (hφc : HasCompactSupport φ)
    {a T : ℝ} (ha : 0 < a) (f : Fin 4 → ℝ → ℂ) (hfm : ∀ i, Measurable (f i)) {Bf : ℝ}
    (hfb : ∀ i x, ‖f i x‖ ≤ Bf) (hf0 : ∀ x, T < |x| → f 0 x = 0) (F : Finset ℤ)
    (hF : ∀ m : ℤ, |(m : ℝ)| ≤ T / a + 1 → m ∈ F) :
    ∑ m ∈ F, scaleTranslateTerm
        (fourMarginalKernel (tensorKernel (fun y => (ω y : ℂ)) (fun y => (φ y : ℂ)))) a m f =
      ∫ z : ℝ × ℝ, ((a⁻¹ : ℝ) : ℂ) * iteratedDeriv 4 (fun y => (φ y : ℂ)) (z.2 / a) *
        ∏ j, f j (realProgressionCoordinate j z) := by
  set W := fourMarginalKernel (tensorKernel (fun y => (ω y : ℂ)) (fun y => (φ y : ℂ)))
  have hωC : ContDiff ℝ (⊤ : ℕ∞) fun y => (ω y : ℂ) := Complex.ofRealCLM.contDiff.comp hω
  have hφC : ContDiff ℝ (⊤ : ℕ∞) fun y => (φ y : ℂ) := Complex.ofRealCLM.contDiff.comp hφ
  have hg : ContDiff ℝ (⊤ : ℕ∞) (tensorKernel (fun y => (ω y : ℂ)) (fun y => (φ y : ℂ))) :=
    (hωC.comp contDiff_fst).mul (hφC.comp contDiff_snd)
  have hgc : HasCompactSupport (tensorKernel (fun y => (ω y : ℂ)) (fun y => (φ y : ℂ))) := by
    have h1 : HasCompactSupport fun y => (ω y : ℂ) := hωc.comp_left Complex.ofReal_zero
    have h2 : HasCompactSupport fun y => (φ y : ℂ) := hφc.comp_left Complex.ofReal_zero
    refine HasCompactSupport.intro (h1.isCompact.prod h2.isCompact) fun p hp => ?_
    simp only [tensorKernel]
    rcases not_and_or.mp hp with h | h
    · rw [image_eq_zero_of_notMem_tsupport h, zero_mul]
    · rw [image_eq_zero_of_notMem_tsupport h, mul_zero]
  have hWs : ContDiff ℝ (⊤ : ℕ∞) W :=
    progDeriv_contDiff (progDeriv_contDiff (progDeriv_contDiff (progDeriv_contDiff hg)))
  have hWc : HasCompactSupport W :=
    progDeriv_hasCompactSupport (progDeriv_hasCompactSupport (progDeriv_hasCompactSupport
      (progDeriv_hasCompactSupport hgc)))
  have hprodm : Measurable fun z : ℝ × ℝ => ∏ j, f j (realProgressionCoordinate j z) :=
    Finset.measurable_prod _ fun j _ =>
      (hfm j).comp (continuous_realProgressionCoordinate j).measurable
  have hprodb : ∀ z : ℝ × ℝ, ‖∏ j, f j (realProgressionCoordinate j z)‖ ≤ Bf ^ 4 := by
    intro z
    rw [norm_prod]
    calc ∏ j, ‖f j (realProgressionCoordinate j z)‖ ≤ ∏ _j : Fin 4, Bf :=
          Finset.prod_le_prod₀ (fun j _ => norm_nonneg _) (fun j _ => hfb j _)
      _ = Bf ^ 4 := by simp
  have hint : ∀ m ∈ F, Integrable fun z : ℝ × ℝ => ((a⁻¹ : ℝ) : ℂ) *
      W (z.1 / a - m, z.2 / a) * ∏ j, f j (realProgressionCoordinate j z) := by
    intro m _
    have h1 := (integrable_rescaled_kernel hWs.continuous hWc ha m).const_mul ((a⁻¹ : ℝ) : ℂ)
    refine h1.mul_bdd hprodm.aestronglyMeasurable (Filter.Eventually.of_forall hprodb)
  simp only [scaleTranslateTerm]
  rw [← integral_finsetSum _ hint]
  congr 1; funext z
  rw [← Finset.sum_mul, ← Finset.mul_sum]
  by_cases hz : f 0 z.1 = 0
  · have : ∏ j, f j (realProgressionCoordinate j z) = 0 := by
      apply Finset.prod_eq_zero (Finset.mem_univ 0)
      simpa [realProgressionCoordinate] using hz
    rw [this, mul_zero, mul_zero]
  · have hzT : |z.1| ≤ T := by by_contra h; push Not at h; exact hz (hf0 _ h)
    have hFz : ∀ m : ℤ, |z.1 / a - m| < 1 → m ∈ F := by
      intro m hm
      apply hF
      have h1 : |(m : ℝ)| ≤ |z.1 / a| + |z.1 / a - m| := by
        have := abs_sub (z.1 / a) (z.1 / a - m)
        rwa [show z.1 / a - (z.1 / a - m) = m by ring] at this
      have h2 : |z.1 / a| ≤ T / a := by
        rw [abs_div, abs_of_pos ha]; exact div_le_div_of_nonneg_right hzT ha.le
      linarith only [hm, h1, h2]
    rw [partition_sum_finite hω hsupp hsum hφ (z.1 / a) (z.2 / a) F hFz]

/-- Blueprint lines 2955-2958 (Fubini in the scale): for `0 < A ≤ B`, inputs bounded by `Bf`
with `f₀` supported in `[-T, T]`, and `ψ' = φ⁽⁴⁾` bounded by `Bψ` and supported in `[-R, R]`,
`∫_A^B (∫ a⁻¹ ψ'(t/a) Π f) a⁻¹ da = ∫ (∫_A^B ψ'(t/a) a⁻² da) Π f`. -/
theorem scale_fubini {ψ' : ℝ → ℂ} (hψ' : Continuous ψ') {R Bψ : ℝ}
    (hψb : ∀ s, ‖ψ' s‖ ≤ Bψ) (hψs : ∀ s, R < |s| → ψ' s = 0) (f : Fin 4 → ℝ → ℂ)
    (hfm : ∀ i, Measurable (f i)) {Bf T : ℝ} (hfb : ∀ i x, ‖f i x‖ ≤ Bf)
    (hf0 : ∀ x, T < |x| → f 0 x = 0) {A B : ℝ} (hA : 0 < A) (hAB : A ≤ B) :
    ∫ a in A..B, (∫ z : ℝ × ℝ, ((a⁻¹ : ℝ) : ℂ) * ψ' (z.2 / a) *
        ∏ j, f j (realProgressionCoordinate j z)) * ((a⁻¹ : ℝ) : ℂ) =
      ∫ z : ℝ × ℝ, (∫ a in A..B, ψ' (z.2 / a) * ((a ^ 2)⁻¹ : ℝ)) *
        ∏ j, f j (realProgressionCoordinate j z) := by
  set P : ℝ × ℝ → ℂ := fun z => ∏ j, f j (realProgressionCoordinate j z)
  have hPm : Measurable P := Finset.measurable_prod _ fun j _ =>
    (hfm j).comp (continuous_realProgressionCoordinate j).measurable
  have hPb : ∀ z, ‖P z‖ ≤ Bf ^ 4 := by
    intro z
    simp only [P]; rw [norm_prod]
    calc ∏ j, ‖f j (realProgressionCoordinate j z)‖ ≤ ∏ _j : Fin 4, Bf :=
          Finset.prod_le_prod₀ (fun j _ => norm_nonneg _) (fun j _ => hfb j _)
      _ = Bf ^ 4 := by simp
  -- the integrand on `[A, B] × ℝ²`
  set G : ℝ × (ℝ × ℝ) → ℂ := fun p => ψ' (p.2.2 / p.1) * ((p.1 ^ 2)⁻¹ : ℝ) * P p.2
  have hGm : Measurable G := by
    have h1 : Measurable fun p : ℝ × (ℝ × ℝ) => ψ' (p.2.2 / p.1) :=
      hψ'.measurable.comp (measurable_snd.snd.div measurable_fst)
    have h2 : Measurable fun p : ℝ × (ℝ × ℝ) => (((p.1 ^ 2)⁻¹ : ℝ) : ℂ) :=
      Complex.measurable_ofReal.comp ((measurable_fst.pow_const 2).inv)
    exact (h1.mul h2).mul (hPm.comp measurable_snd)
  -- `G` is supported in a bounded box and bounded there
  set box : Set (ℝ × (ℝ × ℝ)) :=
    Set.Icc A B ×ˢ (Set.Icc (-T) T ×ˢ Set.Icc (-(B * R)) (B * R))
  have hbox : MeasurableSet box := measurableSet_Icc.prod (measurableSet_Icc.prod measurableSet_Icc)
  have hboxf : volume box ≠ ⊤ := by
    simp only [box, Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Icc]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top)
  set Cb : ℝ := Bψ * (A ^ 2)⁻¹ * Bf ^ 4
  have hGbound : ∀ p : ℝ × (ℝ × ℝ), p.1 ∈ Set.Ioc A B →
      ‖G p‖ ≤ box.indicator (fun _ => Cb) p := by
    intro p hp
    have hp1 : 0 < p.1 := hA.trans hp.1
    by_cases hb : p ∈ box
    · rw [Set.indicator_of_mem hb]
      simp only [G, norm_mul, Complex.norm_real, Real.norm_eq_abs]
      have h1 := hψb (p.2.2 / p.1)
      have h2 := hPb p.2
      have h3 : |(p.1 ^ 2)⁻¹| ≤ (A ^ 2)⁻¹ := by
        rw [abs_of_pos (by positivity)]
        exact inv_anti₀ (by positivity) (pow_le_pow_left₀ hA.le hp.1.le 2)
      have hB0 : 0 ≤ Bψ := (norm_nonneg _).trans h1
      rw [show Cb = Bψ * (A ^ 2)⁻¹ * Bf ^ 4 from rfl]
      gcongr
    · rw [Set.indicator_of_notMem hb]
      have hG0 : G p = 0 := by
        simp only [box, Set.mem_prod, Set.mem_Icc, not_and_or, not_le] at hb
        rcases hb with h | h | h
        · exfalso; rcases h with h | h <;> linarith [hp.1, hp.2]
        · -- `f₀` vanishes
          have : |p.2.1| > T := by
            rcases h with h | h
            · exact lt_abs.mpr (Or.inr (by linarith))
            · exact lt_abs.mpr (Or.inl h)
          have hf : P p.2 = 0 := by
            apply Finset.prod_eq_zero (Finset.mem_univ 0)
            simpa [realProgressionCoordinate] using hf0 _ this
          simp [G, hf]
        · -- `ψ'` vanishes
          have hR : R < |p.2.2 / p.1| := by
            rw [abs_div, abs_of_pos hp1, lt_div_iff₀ hp1]
            have hBR : p.1 * R ≤ B * R ∨ R < 0 := by
              by_cases hR0 : R < 0
              · right; exact hR0
              · left; push Not at hR0; exact mul_le_mul_of_nonneg_right hp.2 hR0
            rcases hBR with hBR | hR0
            · rcases h with h | h
              · exact lt_abs.mpr (Or.inr (by linarith only [hBR, h]))
              · exact lt_abs.mpr (Or.inl (by linarith))
            · nlinarith only [abs_nonneg p.2.2, hp1, hR0]
          simp [G, hψs _ hR]
      rw [hG0, norm_zero]
  have hGint : Integrable G ((volume.restrict (Set.Ioc A B)).prod volume) := by
    have hmeas_eq : (volume.restrict (Set.Ioc A B)).prod (volume : Measure (ℝ × ℝ)) =
        ((volume : Measure ℝ).prod (volume : Measure (ℝ × ℝ))).restrict
          (Set.Ioc A B ×ˢ Set.univ) := by
      rw [← Measure.prod_restrict, Measure.restrict_univ]
    rw [hmeas_eq]
    refine Integrable.mono' (g := box.indicator fun _ => Cb) ?_ hGm.aestronglyMeasurable ?_
    · apply Integrable.integrableOn
      exact (integrable_indicator_iff hbox).mpr (integrableOn_const hboxf)
    · filter_upwards [ae_restrict_mem (measurableSet_Ioc.prod MeasurableSet.univ)] with p hp
      exact hGbound p hp.1
  rw [intervalIntegral.integral_of_le hAB]
  have hL : ∀ a : ℝ, (∫ z : ℝ × ℝ, ((a⁻¹ : ℝ) : ℂ) * ψ' (z.2 / a) * P z) * ((a⁻¹ : ℝ) : ℂ) =
      ∫ z : ℝ × ℝ, G (a, z) := by
    intro a
    rw [← integral_mul_const]
    congr 1; funext z
    simp only [G]; push_cast; ring
  have hR : ∀ z : ℝ × ℝ, (∫ a in A..B, ψ' (z.2 / a) * ((a ^ 2)⁻¹ : ℝ)) * P z =
      ∫ a in Set.Ioc A B, G (a, z) := by
    intro z
    rw [intervalIntegral.integral_of_le hAB, ← integral_mul_const]
  change ∫ a in Set.Ioc A B, (∫ z : ℝ × ℝ, ((a⁻¹ : ℝ) : ℂ) * ψ' (z.2 / a) * P z) *
      ((a⁻¹ : ℝ) : ℂ) = ∫ z : ℝ × ℝ, (∫ a in A..B, ψ' (z.2 / a) * ((a ^ 2)⁻¹ : ℝ)) * P z
  simp_rw [hL, hR]
  exact integral_integral_swap (f := fun a z => G (a, z)) hGint

/-- Rescaling a dyadic scale block: for `c > 0`,
`∫⁻_{[c, 2c)} H = c ∫⁻_{[1, 2)} H(c b) db` (no measurability of `H` is needed). -/
theorem setLIntegral_Ico_scale (H : ℝ → ℝ≥0∞) {c : ℝ} (hc : 0 < c) :
    ∫⁻ a in Set.Ico c (2 * c), H a = ENNReal.ofReal c * ∫⁻ b in Set.Ico 1 2, H (c * b) := by
  set e : ℝ ≃ᵐ ℝ := (Homeomorph.mulLeft₀ c hc.ne').toMeasurableEquiv
  have hmap : Measure.map e volume = ENNReal.ofReal |c⁻¹| • volume := by
    rw [← Real.map_volume_mul_left hc.ne']; rfl
  have h1 : ∫⁻ b in Set.Ico 1 2, H (c * b) =
      ∫⁻ b, (Set.Ico c (2 * c)).indicator H (e b) := by
    rw [← lintegral_indicator measurableSet_Ico]
    congr 1; funext b
    change _ = (Set.Ico c (2 * c)).indicator H (c * b)
    by_cases hb : b ∈ Set.Ico (1 : ℝ) 2
    · have : c * b ∈ Set.Ico c (2 * c) := ⟨by nlinarith only [hb.1, hc], by nlinarith [hb.2]⟩
      rw [Set.indicator_of_mem hb, Set.indicator_of_mem this]
    · have : c * b ∉ Set.Ico c (2 * c) := fun h => hb
        ⟨by nlinarith [h.1], by nlinarith [h.2]⟩
      rw [Set.indicator_of_notMem hb, Set.indicator_of_notMem this]
  rw [h1, ← lintegral_map_equiv, hmap, lintegral_smul_measure,
    lintegral_indicator measurableSet_Ico, smul_eq_mul, ← mul_assoc, ← ENNReal.ofReal_mul hc.le,
    abs_of_pos (inv_pos.mpr hc), mul_inv_cancel₀ hc.ne', ENNReal.ofReal_one, one_mul]

/-- Blueprint lines 2955-2957 (`a = b 2ⁿ`): the scale integral over `[2^{n₁}, 2^{n₂})` is
at most `∫⁻_{[1,2)} Σ_{n₁ ≤ n < n₂} 2ⁿ H(2ⁿ b) db`. -/
theorem lintegral_dyadic_blocks_le (H : ℝ → ℝ≥0∞) (n₁ : ℤ) :
    ∀ n₂ : ℤ, n₁ ≤ n₂ → ∫⁻ a in Set.Ico ((2 : ℝ) ^ n₁) ((2 : ℝ) ^ n₂), H a ≤
      ∫⁻ b in Set.Ico 1 2, ∑ n ∈ Finset.Ico n₁ n₂,
        ENNReal.ofReal ((2 : ℝ) ^ n) * H ((2 : ℝ) ^ n * b) := by
  intro n₂ h
  induction n₂, h using Int.leInduction with
  | base => simp
  | succ n hn ih =>
    have h2 : (2 : ℝ) ^ (n + 1) = 2 * 2 ^ n := by
      rw [zpow_add_one₀ (by norm_num)]; ring
    have hsplit : Set.Ico ((2 : ℝ) ^ n₁) (2 ^ (n + 1)) =
        Set.Ico ((2 : ℝ) ^ n₁) (2 ^ n) ∪ Set.Ico ((2 : ℝ) ^ n) (2 * 2 ^ n) := by
      rw [h2, Set.Ico_union_Ico_eq_Ico (zpow_le_zpow_right₀ (by norm_num) hn)
        (by linarith only [zpow_pos (show (0 : ℝ) < 2 by norm_num) n])]
    rw [hsplit, lintegral_union measurableSet_Ico (Set.Ico_disjoint_Ico_same),
      setLIntegral_Ico_scale H (zpow_pos (by norm_num) n),
      ← Finset.insert_Ico_right_eq_Ico_add_one hn]
    simp_rw [Finset.sum_insert Finset.right_notMem_Ico]
    calc _ ≤ (∫⁻ b in Set.Ico 1 2, ENNReal.ofReal ((2 : ℝ) ^ n) * H ((2 : ℝ) ^ n * b)) +
        ∫⁻ b in Set.Ico 1 2, ∑ k ∈ Finset.Ico n₁ n,
          ENNReal.ofReal ((2 : ℝ) ^ k) * H ((2 : ℝ) ^ k * b) := by
          rw [add_comm, lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
          gcongr
      _ ≤ _ := le_lintegral_add _ _

/-- Blueprint lines 2955-2980, before the scale limit: the four-linear form with the integrated
scale kernel `K_{A,B}(t) = ∫_A^B φ⁽⁴⁾(t/a) a⁻² da` is bounded by `3 (D + 1) C ∫ Π M_q f_j`,
uniformly in `0 < A ≤ B`, whenever all finite-depth constants of the fixed admissible class are
at most `C`. -/
theorem integrated_scale_form_bound {ω φ : ℝ → ℝ} (hω : ContDiff ℝ (⊤ : ℕ∞) ω)
    (hsupp : ∀ x, 3 / 4 ≤ |x| → ω x = 0) (hsum : ∀ x, ∑' k : ℤ, ω (x - k) = 1)
    (hωc : HasCompactSupport ω) (hφ : ContDiff ℝ (⊤ : ℕ∞) φ) (hφc : HasCompactSupport φ) {R : ℝ}
    (hR : 0 ≤ R)
    (hωs : tsupport (fun y => (ω y : ℂ)) ⊆ Set.Icc (-1) 1)
    (hφs : tsupport (fun y => (φ y : ℂ)) ⊆ Set.Icc (-R) R) {C₀ D : ℕ} (hC₀ : 1 ≤ C₀)
    (hD : 1 ≤ D) (hDR : 8 + 24 * R < D)
    (hωG : ∀ j x, ‖iteratedDeriv j (fun y => (ω y : ℂ)) x‖ ≤
      ((C₀ : ℝ) * ((j : ℝ) + 1)) ^ (C₀ * (j + 1)))
    (hφG : ∀ j x, ‖iteratedDeriv j (fun y => (φ y : ℂ)) x‖ ≤
      ((C₀ : ℝ) * ((j : ℝ) + 1)) ^ (C₀ * (j + 1)))
    {q : ℝ} (hq : 2 ≤ q) {Cst : ℝ}
    (hCst : ∀ N, finiteDepthConstant
      (kernelClassOf (1 / 24) (by norm_num) (3 * C₀ + 34 + D) (by omega)) q N ≤ Cst)
    (f : Fin 4 → ℝ → ℂ) (hfm : ∀ i, Measurable (f i)) {Bf T : ℝ}
    (hfb : ∀ i x, ‖f i x‖ ≤ Bf) (hT : 0 ≤ T) (hf0 : ∀ x, T < |x| → f 0 x = 0)
    (hfL : ∀ i, MemLp (f i) (ENNReal.ofReal q) volume) (hfc : ∀ i, HasCompactSupport (f i))
    {A B : ℝ} (hA : 0 < A) (hAB : A ≤ B) :
    ‖∫ z : ℝ × ℝ, (∫ a in A..B, iteratedDeriv 4 (fun y => (φ y : ℂ)) (z.2 / a) *
        ((a ^ 2)⁻¹ : ℝ)) * ∏ j, f j (realProgressionCoordinate j z)‖ₑ ≤
      3 * ((D + 1 : ℕ) * (ENNReal.ofReal Cst * ∫⁻ x, ∏ i, scalarMaximalQ q (f i) x)) := by
  classical
  set φC : ℝ → ℂ := fun y => (φ y : ℂ)
  set ψ' := iteratedDeriv 4 φC
  set! W := fourMarginalKernel (tensorKernel (fun y => (ω y : ℂ)) φC)
  have hφC : ContDiff ℝ (⊤ : ℕ∞) φC := Complex.ofRealCLM.contDiff.comp hφ
  have hψc : Continuous ψ' := hφC.continuous_iteratedDeriv 4 (by simp)
  have hψs : ∀ s, R < |s| → ψ' s = 0 := by
    intro s hs
    have hx : s ∉ tsupport φC := fun h => by
      have := hφs h
      exact absurd (abs_le.mpr ⟨this.1, this.2⟩) (not_le.mpr hs)
    simp only [ψ']
    rw [iteratedDeriv_eq_iteratedFDeriv]
    have : s ∉ Function.support (iteratedFDeriv ℝ 4 φC) := fun h =>
      hx (support_iteratedFDeriv_subset 4 h)
    rw [Function.notMem_support.mp this]
    rfl
  obtain ⟨Bψ, hBψ⟩ := (isCompact_Icc (a := -R) (b := R)).exists_bound_of_continuousOn
    hψc.continuousOn
  have hψb : ∀ s, ‖ψ' s‖ ≤ max Bψ 0 := by
    intro s
    by_cases hs : R < |s|
    · rw [hψs s hs, norm_zero]; exact le_max_right _ _
    · push Not at hs
      exact (hBψ s (abs_le.mp hs)).trans (le_max_left _ _)
  -- Fubini in the scale
  rw [← scale_fubini hψc hψb hψs f hfm hfb hf0 hA hAB, intervalIntegral.integral_of_le hAB]
  -- the translate set
  set! M : ℕ := ⌈T / A⌉₊ + 1
  set! F : Finset ℤ := Finset.Icc (-(M : ℤ)) M
  have hF : ∀ a ∈ Set.Ioc A B, ∀ m : ℤ, |(m : ℝ)| ≤ T / a + 1 → m ∈ F := by
    intro a ha m hm
    have ha0 : 0 < a := hA.trans ha.1
    have h1 : T / a ≤ T / A := div_le_div_of_nonneg_left hT hA ha.1.le
    have h2 : T / A ≤ ⌈T / A⌉₊ := Nat.le_ceil _
    have h3 : |(m : ℝ)| ≤ M := by simp only [M]; push_cast; linarith only [hm, h1, h2]
    have h4 : |m| ≤ (M : ℤ) := by exact_mod_cast h3
    exact Finset.mem_Icc.mpr (abs_le.mp h4)
  have hsumF : ∀ a ∈ Set.Ioc A B,
      (∫ z : ℝ × ℝ, ((a⁻¹ : ℝ) : ℂ) * ψ' (z.2 / a) * ∏ j, f j (realProgressionCoordinate j z)) =
        ∑ m ∈ F, scaleTranslateTerm W a m f := fun a ha =>
    (sum_scaleTranslateTerm hω hsupp hsum hωc hφ hφc (hA.trans ha.1) f hfm hfb hf0 F
      (hF a ha)).symm
  -- the scale weight
  set! H : ℝ → ℝ≥0∞ := fun a =>
    ENNReal.ofReal (∑ m ∈ F, ‖scaleTranslateTerm W a m f‖) * ENNReal.ofReal a⁻¹
  -- dyadic range
  obtain ⟨n₁, hn₁⟩ := exists_mem_Ico_zpow hA (show (1 : ℝ) < 2 by norm_num)
  obtain ⟨n₀, hn₀⟩ := exists_mem_Ico_zpow (hA.trans_le hAB) (show (1 : ℝ) < 2 by norm_num)
  set n₂ := n₀ + 1
  have hn12 : n₁ ≤ n₂ := by
    have : (2 : ℝ) ^ n₁ < 2 ^ n₂ := hn₁.1.trans_lt (hAB.trans_lt hn₀.2)
    exact ((zpow_lt_zpow_iff_right₀ (by norm_num)).mp this).le
  set! N : ℕ := (n₂ - n₁).toNat
  set! P : Finset (ℤ × ℤ) := Finset.Ico n₁ n₂ ×ˢ F
  have hP : ∀ p ∈ P, n₁ ≤ p.1 ∧ p.1 < n₁ + N := by
    intro p hp
    obtain ⟨h1, h2⟩ := Finset.mem_Ico.mp (Finset.mem_product.mp hp).1
    refine ⟨h1, ?_⟩
    simp only [N]; omega
  set X := 3 * ((D + 1 : ℕ) * (ENNReal.ofReal Cst * ∫⁻ x, ∏ i, scalarMaximalQ q (f i) x))
  have hblock : ∀ b ∈ Set.Ico (1 : ℝ) 2, ∑ n ∈ Finset.Ico n₁ n₂,
      ENNReal.ofReal ((2 : ℝ) ^ n) * H ((2 : ℝ) ^ n * b) ≤ X := by
    intro b hb
    have hb0 : 0 < b := by linarith only [hb.1]
    have hstep : ∀ n ∈ Finset.Ico n₁ n₂, ENNReal.ofReal ((2 : ℝ) ^ n) * H ((2 : ℝ) ^ n * b) ≤
        ENNReal.ofReal (∑ m ∈ F, ‖scaleTranslateTerm W (b * (2 : ℝ) ^ n) m f‖) := by
      intro n _
      have h2n : (0 : ℝ) < 2 ^ n := zpow_pos (by norm_num) n
      simp only [H]
      rw [mul_comm ((2 : ℝ) ^ n) b, mul_left_comm, ← ENNReal.ofReal_mul h2n.le]
      have : (2 : ℝ) ^ n * (b * 2 ^ n)⁻¹ = b⁻¹ := by field_simp
      rw [this]
      calc _ ≤ ENNReal.ofReal (∑ m ∈ F,
            ‖scaleTranslateTerm W (b * (2 : ℝ) ^ n) m f‖) * ENNReal.ofReal 1 := by
            gcongr; exact inv_le_one_of_one_le₀ hb.1
        _ = _ := by rw [ENNReal.ofReal_one, mul_one]
    calc _ ≤ ∑ n ∈ Finset.Ico n₁ n₂,
          ENNReal.ofReal (∑ m ∈ F, ‖scaleTranslateTerm W (b * (2 : ℝ) ^ n) m f‖) :=
          Finset.sum_le_sum hstep
      _ = ENNReal.ofReal (∑ p ∈ P, ‖scaleTranslateTerm W (b * (2 : ℝ) ^ p.1) p.2 f‖) := by
          rw [← ENNReal.ofReal_sum_of_nonneg (fun n _ => Finset.sum_nonneg fun m _ =>
            norm_nonneg _), Finset.sum_product]
      _ ≤ 3 * ((D + 1 : ℕ) * (ENNReal.ofReal (finiteDepthConstant
            (kernelClassOf (1 / 24) (by norm_num) (3 * C₀ + 34 + D) (by omega)) q N) *
            ∫⁻ x, ∏ i, scalarMaximalQ q (f i) x)) :=
          truncated_scale_sum_bound (Complex.ofRealCLM.contDiff.comp hω) hφC hR hωs hφs hC₀ hD
            hDR hωG hφG hq N hb0 n₁ P hP f hfm hfL hfc
      _ ≤ X := by simp only [X]; gcongr; exact hCst N
  calc ‖∫ a in Set.Ioc A B, (∫ z : ℝ × ℝ, ((a⁻¹ : ℝ) : ℂ) * ψ' (z.2 / a) *
          ∏ j, f j (realProgressionCoordinate j z)) * ((a⁻¹ : ℝ) : ℂ)‖ₑ
      ≤ ∫⁻ a in Set.Ioc A B, ‖(∫ z : ℝ × ℝ, ((a⁻¹ : ℝ) : ℂ) * ψ' (z.2 / a) *
          ∏ j, f j (realProgressionCoordinate j z)) * ((a⁻¹ : ℝ) : ℂ)‖ₑ :=
        enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ a in Set.Ioc A B, H a := by
        apply lintegral_mono_ae
        filter_upwards [ae_restrict_mem measurableSet_Ioc] with a ha
        have ha0 : 0 < a := hA.trans ha.1
        rw [hsumF a ha, enorm_mul, ← ofReal_norm ((a⁻¹ : ℝ) : ℂ), Complex.norm_real,
          Real.norm_eq_abs, abs_of_pos (inv_pos.mpr ha0), ← ofReal_norm]
        exact mul_le_mul_left (ENNReal.ofReal_le_ofReal (norm_sum_le _ _)) _
    _ ≤ ∫⁻ a in Set.Ico ((2 : ℝ) ^ n₁) ((2 : ℝ) ^ n₂), H a := by
        apply lintegral_mono_set
        intro a ha
        exact ⟨hn₁.1.trans ha.1.le, ha.2.trans_lt hn₀.2⟩
    _ ≤ ∫⁻ b in Set.Ico 1 2, ∑ n ∈ Finset.Ico n₁ n₂,
          ENNReal.ofReal ((2 : ℝ) ^ n) * H ((2 : ℝ) ^ n * b) :=
        lintegral_dyadic_blocks_le H n₁ n₂ hn12
    _ ≤ ∫⁻ _ in Set.Ico (1 : ℝ) 2, X := by
        apply lintegral_mono_ae
        filter_upwards [ae_restrict_mem measurableSet_Ico] with b hb
        exact hblock b hb
    _ = X := by rw [setLIntegral_const, Real.volume_Ico]; norm_num

/-! ### The scale limit (thm:main, blueprint lines 2982-2995) -/

/-- The explicit truncated kernel `(ψ(nt) - ψ(t/n))/t` is bounded by `2 B_ψ + B' n` when `ψ` is
bounded by `B_ψ` with derivative bounded by `B'`. -/
theorem explicit_kernel_bound {ψ ψd : ℝ → ℂ} (hd : ∀ x, HasDerivAt ψ (ψd x) x) {Bψ Bd : ℝ}
    (hψb : ∀ s, ‖ψ s‖ ≤ Bψ) (hdb : ∀ s, ‖ψd s‖ ≤ Bd) {n : ℝ} (hn : 1 ≤ n) (t : ℝ) :
    ‖(ψ (t * n) - ψ (t / n)) / (t : ℂ)‖ ≤ 2 * Bψ + Bd * n := by
  have hB0 : 0 ≤ Bψ := (norm_nonneg _).trans (hψb 0)
  have hd0 : 0 ≤ Bd := (norm_nonneg _).trans (hdb 0)
  have hn0 : 0 < n := by linarith
  rw [norm_div, Complex.norm_real, Real.norm_eq_abs]
  rcases eq_or_ne t 0 with rfl | ht
  · simp only [abs_zero, div_zero]; positivity
  have ht' : 0 < |t| := abs_pos.mpr ht
  rw [div_le_iff₀ ht']
  by_cases h1 : 1 ≤ |t|
  · calc ‖ψ (t * n) - ψ (t / n)‖ ≤ ‖ψ (t * n)‖ + ‖ψ (t / n)‖ := norm_sub_le _ _
      _ ≤ 2 * Bψ := by linarith only [hψb (t * n), hψb (t / n)]
      _ ≤ (2 * Bψ + Bd * n) * |t| := by nlinarith only [mul_nonneg hd0 hn0.le, hB0, h1]
  · push Not at h1
    have hmv := (convex_univ (𝕜 := ℝ) (E := ℝ)).norm_image_sub_le_of_norm_hasDerivWithin_le
      (f := ψ) (fun x _ => (hd x).hasDerivWithinAt) (fun x _ => hdb x) (Set.mem_univ (t / n))
      (Set.mem_univ (t * n))
    have hdiff : ‖t * n - t / n‖ ≤ n * |t| := by
      rw [Real.norm_eq_abs, show t * n - t / n = t * (n - 1 / n) by ring, abs_mul,
        mul_comm]
      gcongr
      rw [abs_of_nonneg (by
        have : 1 / n ≤ 1 := by rw [div_le_one hn0]; exact hn
        linarith only [hn, this])]
      have : 0 < 1 / n := by positivity
      linarith
    calc ‖ψ (t * n) - ψ (t / n)‖ ≤ Bd * ‖t * n - t / n‖ := hmv
      _ ≤ Bd * (n * |t|) := by gcongr
      _ ≤ (2 * Bψ + Bd * n) * |t| := by nlinarith only [mul_nonneg hB0 ht'.le]

/-- Blueprint lines 2982-2995 (dominated convergence in the scale range `[1/n, n]`): for an even
`C¹` profile `ψ = φ'''` supported in `[-R, R]` and an integrable `P` whose odd quotient
`Q(x,t) = (P(x,t) - P(x,-t))/t` is integrable,
`∫ (ψ(nt) - ψ(t/n))/t · P → -ψ(0)/2 · ∫ Q`. -/
theorem explicit_kernel_tendsto {ψ ψd : ℝ → ℂ} (hd : ∀ x, HasDerivAt ψ (ψd x) x) {Bψ Bd R : ℝ}
    (hψb : ∀ s, ‖ψ s‖ ≤ Bψ) (hdb : ∀ s, ‖ψd s‖ ≤ Bd) (hψs : ∀ s, R < |s| → ψ s = 0)
    (heven : ∀ s, ψ (-s) = ψ s) {P : ℝ × ℝ → ℂ} (hPi : Integrable P)
    (hQi : Integrable fun z : ℝ × ℝ => (P z - P (z.1, -z.2)) / (z.2 : ℂ)) :
    Filter.Tendsto (fun n : ℕ => ∫ z : ℝ × ℝ, (ψ (z.2 * n) - ψ (z.2 / n)) / (z.2 : ℂ) * P z)
      Filter.atTop (nhds (-ψ 0 / 2 * ∫ z : ℝ × ℝ, (P z - P (z.1, -z.2)) / (z.2 : ℂ))) := by
  set Q : ℝ × ℝ → ℂ := fun z => (P z - P (z.1, -z.2)) / (z.2 : ℂ)
  have hψc : Continuous ψ := continuous_iff_continuousAt.mpr fun x => (hd x).continuousAt
  -- the reflection `(x, t) ↦ (x, -t)`
  set σ : ℝ × ℝ ≃ᵐ ℝ × ℝ := (MeasurableEquiv.refl ℝ).prodCongr (MeasurableEquiv.neg ℝ)
  have hσ : MeasurePreserving σ (volume : Measure (ℝ × ℝ)) volume := by
    rw [Measure.volume_eq_prod]
    exact (MeasurePreserving.id volume).prod (Measure.measurePreserving_neg volume)
  have hσapp : ∀ z : ℝ × ℝ, σ z = (z.1, -z.2) := fun z => rfl
  set K : ℕ → ℝ × ℝ → ℂ := fun n z => (ψ (z.2 * n) - ψ (z.2 / n)) / (z.2 : ℂ)
  have hKm : ∀ n, Measurable (K n) := fun n => by
    have h1 : Measurable fun z : ℝ × ℝ => ψ (z.2 * n) :=
      hψc.measurable.comp (measurable_snd.mul_const _)
    have h2 : Measurable fun z : ℝ × ℝ => ψ (z.2 / n) :=
      hψc.measurable.comp (measurable_snd.div_const _)
    exact (h1.sub h2).div (Complex.measurable_ofReal.comp measurable_snd)
  have hKodd : ∀ n z, K n (σ z) = -K n z := fun n z => by
    simp only [K, hσapp]
    rw [show -z.2 * (n : ℝ) = -(z.2 * n) by ring, show -z.2 / (n : ℝ) = -(z.2 / n) by ring,
      heven, heven]
    push_cast
    rw [div_neg]
  -- the symmetrized form
  have hsym : ∀ n : ℕ, 1 ≤ n → ∫ z : ℝ × ℝ, K n z * P z =
      ∫ z : ℝ × ℝ, (ψ (z.2 * n) - ψ (z.2 / n)) * Q z / 2 := by
    intro n hn
    have hn' : (1 : ℝ) ≤ n := by exact_mod_cast hn
    have hKb : ∀ z, ‖K n z‖ ≤ 2 * Bψ + Bd * n := fun z =>
      explicit_kernel_bound hd hψb hdb hn' z.2
    have hI1 : Integrable fun z => K n z * P z :=
      hPi.bdd_mul (hKm n).aestronglyMeasurable (Filter.Eventually.of_forall hKb)
    have hPσ : Integrable fun z => P (σ z) :=
      (hσ.integrable_comp_emb σ.measurableEmbedding).mpr hPi
    have hI2 : Integrable fun z => K n z * P (σ z) :=
      hPσ.bdd_mul (hKm n).aestronglyMeasurable (Filter.Eventually.of_forall hKb)
    have hrefl : ∫ z : ℝ × ℝ, K n z * P z = -∫ z : ℝ × ℝ, K n z * P (σ z) := by
      rw [← hσ.integral_comp' (g := fun z => K n z * P z), ← integral_neg]
      congr 1; funext z
      rw [hKodd]; ring
    have h2 : 2 * ∫ z : ℝ × ℝ, K n z * P z = ∫ z : ℝ × ℝ, (ψ (z.2 * n) - ψ (z.2 / n)) * Q z := by
      rw [two_mul]
      nth_rewrite 2 [hrefl]
      rw [← sub_eq_add_neg, ← integral_sub hI1 hI2]
      congr 1; funext z
      simp only [K, Q, hσapp]
      ring
    rw [integral_div, ← h2]; ring
  -- dominated convergence
  have hQm : AEStronglyMeasurable Q volume := hQi.aestronglyMeasurable
  have hlim : Filter.Tendsto (fun n : ℕ => ∫ z : ℝ × ℝ, (ψ (z.2 * n) - ψ (z.2 / n)) * Q z / 2)
      Filter.atTop (nhds (∫ z : ℝ × ℝ, (0 - ψ 0) * Q z / 2)) := by
    apply tendsto_integral_of_dominated_convergence (fun z => Bψ * ‖Q z‖)
    · intro n
      have h1 : Continuous fun z : ℝ × ℝ => ψ (z.2 * n) - ψ (z.2 / n) := by fun_prop
      refine (((h1.aestronglyMeasurable).mul hQm).mul_const ((2 : ℂ)⁻¹)).congr
        (Filter.Eventually.of_forall fun z => ?_)
      simp [div_eq_mul_inv]
    · exact hQi.norm.const_mul _
    · intro n
      refine Filter.Eventually.of_forall fun z => ?_
      rw [norm_div, norm_mul, Complex.norm_ofNat]
      have := norm_sub_le (ψ (z.2 * n)) (ψ (z.2 / n))
      have h1 := hψb (z.2 * n); have h2 := hψb (z.2 / n)
      have : ‖ψ (z.2 * n) - ψ (z.2 / n)‖ * ‖Q z‖ ≤ (2 * Bψ) * ‖Q z‖ :=
        mul_le_mul_of_nonneg_right (by linarith only [this, h1, h2]) (norm_nonneg _)
      linarith only [this]
    · refine Filter.Eventually.of_forall fun z => ?_
      rcases eq_or_ne z.2 0 with h | h
      · have hQ0 : Q z = 0 := by simp [Q, h]
        simp only [hQ0, mul_zero, zero_div]
        exact tendsto_const_nhds
      apply Filter.Tendsto.div_const
      apply Filter.Tendsto.mul_const
      apply Filter.Tendsto.sub
      · apply tendsto_const_nhds.congr'
        have hz : 0 < |z.2| := abs_pos.mpr h
        filter_upwards [Filter.eventually_gt_atTop ⌈R / |z.2|⌉₊] with n hn
        symm
        apply hψs
        rw [abs_mul, Nat.abs_cast]
        have : R / |z.2| < n := (Nat.le_ceil _).trans_lt (by exact_mod_cast hn)
        rw [div_lt_iff₀ hz] at this
        linarith only [this]
      · have : Filter.Tendsto (fun n : ℕ => z.2 / (n : ℝ)) Filter.atTop (nhds 0) :=
          tendsto_const_div_atTop_nhds_zero_nat z.2
        exact (hψc.tendsto 0).comp this
  have hval : ∫ z : ℝ × ℝ, (0 - ψ 0) * Q z / 2 = -ψ 0 / 2 * ∫ z : ℝ × ℝ, Q z := by
    rw [← integral_const_mul]; congr 1; funext z; ring
  rw [hval] at hlim
  refine hlim.congr' ?_
  filter_upwards [Filter.eventually_ge_atTop 1] with n hn
  exact (hsym n hn).symm

/-- A strip-cut shifted integrable function: `(x, t) ↦ 1_{[-T,T]}(x) ‖u(x + c t)‖` is integrable on
`ℝ²` for `c ≠ 0`. -/
theorem integrable_strip_shift {u : ℝ → ℂ} (hu : Integrable u) (huc : Continuous u) (T : ℝ)
    {c : ℝ} (hc : c ≠ 0) :
    Integrable fun z : ℝ × ℝ =>
      (Set.Icc (-T) T).indicator (fun _ => (1 : ℝ)) z.1 * ‖u (z.1 + c * z.2)‖ := by
  rw [Measure.volume_eq_prod, integrable_prod_iff]
  · constructor
    · refine Filter.Eventually.of_forall fun x => ?_
      have h1 : Integrable fun t : ℝ => u (x + c * t) :=
        (hu.comp_add_left x).comp_mul_left' hc
      exact (h1.norm.const_mul ((Set.Icc (-T) T).indicator (fun _ => (1 : ℝ)) x)).congr
        (Filter.Eventually.of_forall fun t => rfl)
    · have hsec : ∀ x : ℝ, ∫ t : ℝ, ‖(Set.Icc (-T) T).indicator (fun _ => (1 : ℝ)) x *
          ‖u (x + c * t)‖‖ = (Set.Icc (-T) T).indicator (fun _ => (1 : ℝ)) x *
            (|c⁻¹| * ∫ s : ℝ, ‖u s‖) := by
        intro x
        have hi : 0 ≤ (Set.Icc (-T) T).indicator (fun _ => (1 : ℝ)) x :=
          Set.indicator_nonneg (fun _ _ => zero_le_one) x
        simp_rw [norm_mul, norm_norm, Real.norm_eq_abs, abs_of_nonneg hi]
        rw [integral_const_mul]
        congr 1
        have := Measure.integral_comp_mul_left (fun s => ‖u (x + s)‖) c
        rw [this, integral_add_left_eq_self (fun s => ‖u s‖), smul_eq_mul]
      simp_rw [hsec]
      refine Integrable.mul_const ?_ _
      exact (integrable_indicator_iff measurableSet_Icc).mpr

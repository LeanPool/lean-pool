/-- Gevrey bounds are monotone in the constant. -/
theorem gevrey_bound_mono {C C' : ℕ} (hC : 1 ≤ C) (hCC' : C ≤ C') (j : ℕ) :
    ((C : ℝ) * ((j : ℝ) + 1)) ^ (C * (j + 1)) ≤ ((C' : ℝ) * ((j : ℝ) + 1)) ^ (C' * (j + 1)) := by
  have h1 : (1 : ℝ) ≤ (C : ℝ) * ((j : ℝ) + 1) := by
    have : (1 : ℝ) ≤ C := by exact_mod_cast hC
    nlinarith only [(Nat.cast_nonneg j : (0 : ℝ) ≤ j), this]
  calc ((C : ℝ) * ((j : ℝ) + 1)) ^ (C * (j + 1)) ≤ ((C : ℝ) * ((j : ℝ) + 1)) ^ (C' * (j + 1)) :=
        pow_le_pow_right₀ h1 (Nat.mul_le_mul_right _ hCC')
    _ ≤ _ := by
        apply pow_le_pow_left₀ (by linarith only [h1])
        gcongr

/-- The even cutoff `χ = 1` on `[-1, 1]`, supported in `(-2, 2)`. -/
theorem gevreyIntervalCutoff_even (x : ℝ) :
    gevreyIntervalCutoff (-2) (-1) 1 2 (-x) = gevreyIntervalCutoff (-2) (-1) 1 2 x := by
  unfold gevreyIntervalCutoff
  ring_nf

/-- Blueprint lines 2934-2936: the profile `φ(S) = S³ χ(S)`, with `χ` an even Gevrey cutoff equal to
one near zero, is smooth, odd, supported in `[-2, 2]`, Gevrey, and `φ'''(0) = 6`. -/
theorem cubic_profile_exists :
    ∃ φ : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) φ ∧ HasCompactSupport φ ∧ (∀ s, φ (-s) = -φ s) ∧
      iteratedDeriv 3 (fun y => (φ y : ℂ)) 0 = 6 ∧
      tsupport (fun y => (φ y : ℂ)) ⊆ Set.Icc (-2) 2 ∧
      ∃ C : ℕ, 1 ≤ C ∧ ∀ j x, ‖iteratedDeriv j (fun y => (φ y : ℂ)) x‖ ≤
        ((C : ℝ) * ((j : ℝ) + 1)) ^ (C * (j + 1)) := by
  set χ := gevreyIntervalCutoff (-2) (-1) 1 2
  have hab : (-2 : ℝ) < -1 := by norm_num
  have hcd : (1 : ℝ) < 2 := by norm_num
  have hχ : ContDiff ℝ (⊤ : ℕ∞) χ := contDiff_infty.mpr fun n =>
    gevreyIntervalCutoff_contDiff n _ _ _ _
  have hχs : tsupport χ ⊆ Set.Icc (-2) 2 := fun x hx => by
    have := gevreyIntervalCutoff_tsupport_subset_open hab hcd hx
    exact ⟨this.1.le, this.2.le⟩
  obtain ⟨Cχ, hCχ, hχG⟩ := gevreyIntervalCutoff_exists_derivative_bound (-2) (-1) 1 2
  obtain ⟨C, hC, hG⟩ := cubic_cutoff_gevrey hχ (by norm_num) hχs hCχ hχG
  set φ : ℝ → ℝ := fun S => S ^ 3 * χ S
  have hφ : ContDiff ℝ (⊤ : ℕ∞) φ := (contDiff_id.pow 3).mul hχ
  have hφts : tsupport φ ⊆ tsupport χ := by
    change tsupport ((fun S : ℝ => S ^ 3) * χ) ⊆ _
    exact tsupport_mul_subset_right
  have hφC : tsupport (fun y => (φ y : ℂ)) ⊆ tsupport φ :=
    tsupport_comp_subset Complex.ofReal_zero φ
  refine ⟨φ, hφ, ?_, ?_, ?_, hφC.trans (hφts.trans hχs), C, hC, fun j x => ?_⟩
  · exact (gevreyIntervalCutoff_hasCompactSupport hab hcd).mono'
      (fun x hx => subset_tsupport _ (Function.support_mul_subset_right _ _ hx))
  · intro s
    have hχe : ∀ s, χ (-s) = χ s := gevreyIntervalCutoff_even
    simp only [φ, hχe]
    ring
  · have heq : (fun y => (φ y : ℂ)) =ᶠ[nhds 0] fun y => ((y ^ 3 : ℝ) : ℂ) := by
      filter_upwards [Ioo_mem_nhds (show (-1 : ℝ) < 0 by norm_num)
        (show (0 : ℝ) < 1 by norm_num)] with y hy
      simp only [φ, χ, gevreyIntervalCutoff_eq_one hab hcd ⟨hy.1.le, hy.2.le⟩, mul_one]
    rw [heq.iteratedDeriv_eq, iteratedDeriv_ofReal 3 (f := fun y : ℝ => y ^ 3) (by fun_prop)]
    simp only [iteratedDeriv_fun_pow_zero]
    norm_num
  · rw [iteratedDeriv_ofReal j hφ, Complex.norm_real, Real.norm_eq_abs]
    exact hG j x

/-- The Gevrey partition `ω` in complex form: smooth, supported in `[-1, 1]`, Gevrey. -/
theorem gevreyPartition_complex :
    tsupport (fun y => (gevreyPartition y : ℂ)) ⊆ Set.Icc (-1) 1 ∧
      ∃ C : ℕ, 1 ≤ C ∧ ∀ j x, ‖iteratedDeriv j (fun y => (gevreyPartition y : ℂ)) x‖ ≤
        ((C : ℝ) * ((j : ℝ) + 1)) ^ (C * (j + 1)) := by
  obtain ⟨C, hC, hG⟩ := gevreyPartition_exists_derivative_bound
  refine ⟨fun x hx => ?_, C, hC, fun j x => ?_⟩
  · have := gevreyPartition_tsupport_subset
      (tsupport_comp_subset Complex.ofReal_zero gevreyPartition hx)
    exact ⟨by linarith only [this.1], by linarith only [this.2]⟩
  · rw [iteratedDeriv_ofReal j gevreyPartition_smooth, Complex.norm_real, Real.norm_eq_abs]
    exact hG j x

/-- Blueprint `thm:main`, lines 2934-2999, given `thm:uniform-local`: if every admissible class has
uniformly bounded finite-depth constants for some `q ∈ [2, 3)`, then
`‖T(f₁, f₂, f₃)‖₁ ≤ C Π_j ‖f_j‖₃` for Schwartz inputs, with one finite `C`. -/
theorem T_L1_bound_of_uniform
    (huni : ∀ κ : LocalKernelClass, ∃ q, 2 ≤ q ∧ q < 3 ∧ ∃ Cst : ℝ,
      ∀ N, finiteDepthConstant κ q N ≤ Cst) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ f₁ f₂ f₃ : SchwartzMap ℝ ℂ,
      ∫⁻ x, ‖TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃] x‖ₑ ≤
      ENNReal.ofReal C * (eLpNorm f₁ 3 volume * eLpNorm f₂ 3 volume * eLpNorm f₃ 3 volume) := by
  obtain ⟨hωs, Cω, hCω, hωG⟩ := gevreyPartition_complex
  obtain ⟨φ, hφ, hφc, hφodd, hφ0, hφs, Cφ, hCφ, hφG⟩ := cubic_profile_exists
  set C₀ := max Cω Cφ
  have hC₀ : 1 ≤ C₀ := le_max_of_le_left hCω
  obtain ⟨q, hq, hq3, Cst, hCst⟩ :=
    huni (kernelClassOf (1 / 24) (by norm_num) (3 * C₀ + 34 + 57) (by omega))
  have hωG' : ∀ j x, ‖iteratedDeriv j (fun y => (gevreyPartition y : ℂ)) x‖ ≤
      ((C₀ : ℝ) * ((j : ℝ) + 1)) ^ (C₀ * (j + 1)) := fun j x =>
    (hωG j x).trans (gevrey_bound_mono hCω (le_max_left _ _) j)
  have hφG' : ∀ j x, ‖iteratedDeriv j (fun y => (φ y : ℂ)) x‖ ≤
      ((C₀ : ℝ) * ((j : ℝ) + 1)) ^ (C₀ * (j + 1)) := fun j x =>
    (hφG j x).trans (gevrey_bound_mono hCφ (le_max_right _ _) j)
  have hsupp : ∀ x, 3 / 4 ≤ |x| → gevreyPartition x = 0 := by
    intro x hx
    rcases le_abs'.mp hx with h | h
    · exact gevreyPartition_zero_left (by linarith only [h])
    · exact gevreyPartition_zero_right h
  set c : ℝ≥0∞ := 2 ^ (1 / q) * TrilinearHT.Auto.ClassicalMaximal.hlMaximalConst 3 (3 / q) ^ (1 / q)
  have hc : c ≠ ∞ := by
    apply ENNReal.mul_ne_top
    · exact ENNReal.rpow_ne_top_of_nonneg (by positivity) (by simp)
    · exact ENNReal.rpow_ne_top_of_nonneg (by positivity)
        (TrilinearHT.Auto.ClassicalMaximal.hlMaximalConst_ne_top 3 (by positivity))
  set K : ℝ≥0∞ := 3 * (((57 : ℕ) + 1 : ℕ) * (ENNReal.ofReal Cst * c ^ 3)) /
    ‖iteratedDeriv 3 (fun y => (φ y : ℂ)) 0‖ₑ
  have hK : K ≠ ∞ := by
    apply ENNReal.div_ne_top _ (by rw [hφ0]; simp)
    apply ENNReal.mul_ne_top (by simp)
    apply ENNReal.mul_ne_top (by simp)
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top (ENNReal.pow_ne_top hc)
  refine ⟨K.toReal, ENNReal.toReal_nonneg, fun f₁ f₂ f₃ => ?_⟩
  have h := T_lintegral_le gevreyPartition_smooth hsupp gevreyPartition_tsum
    gevreyPartition_hasCompactSupport hφ hφc hφodd (by rw [hφ0]; norm_num) (R := 2)
    (by norm_num) hωs hφs hC₀ (by norm_num : 1 ≤ 57) (by norm_num) hωG' hφG' hq hq3 hCst
    f₁ f₂ f₃
  refine h.trans (le_of_eq ?_)
  rw [ENNReal.ofReal_toReal hK]
  simp only [K, c, Fin.prod_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, div_eq_mul_inv]
  ring

/-- The bounds needed for `TrilinearHT.T` on Schwartz inputs: differentiability and uniform
bounds on the functions and their derivatives. -/
theorem schwartz_triple_bounds (f₁ f₂ f₃ : SchwartzMap ℝ ℂ) :
    ∃ M : ℝ, (∀ i, i ∈ [⇑f₁, ⇑f₂, ⇑f₃] → Differentiable ℝ i) ∧
      (∀ i, i ∈ [⇑f₁, ⇑f₂, ⇑f₃] → ∀ x, ‖i x‖ ≤ M) ∧
      (∀ i, i ∈ [⇑f₁, ⇑f₂, ⇑f₃] → ∀ x, ‖deriv i x‖ ≤ M) := by
  set s : SchwartzMap ℝ ℂ → ℝ := fun g =>
    SchwartzMap.seminorm ℝ 0 0 g + SchwartzMap.seminorm ℝ 0 0 (SchwartzMap.derivCLM ℝ ℂ g)
  have hs0 : ∀ g : SchwartzMap ℝ ℂ, 0 ≤ SchwartzMap.seminorm ℝ 0 0 g := fun g => apply_nonneg _ _
  refine ⟨s f₁ + s f₂ + s f₃, ?_, ?_, ?_⟩
  · intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl
    · exact f₁.differentiable
    · exact f₂.differentiable
    · exact f₃.differentiable
  · intro i hi x
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    have h1 := hs0 f₁; have h2 := hs0 f₂; have h3 := hs0 f₃
    have d1 := hs0 (SchwartzMap.derivCLM ℝ ℂ f₁); have d2 := hs0 (SchwartzMap.derivCLM ℝ ℂ f₂)
    have d3 := hs0 (SchwartzMap.derivCLM ℝ ℂ f₃)
    rcases hi with rfl | rfl | rfl
    · have := SchwartzMap.norm_le_seminorm ℝ f₁ x; simp only [s]; linarith only [h2, h3, d1, d2,
        d3, this]
    · have := SchwartzMap.norm_le_seminorm ℝ f₂ x; simp only [s]; linarith only [h1, h3, d1, d2,
        d3, this]
    · have := SchwartzMap.norm_le_seminorm ℝ f₃ x; simp only [s]; linarith
  · intro i hi x
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    have h1 := hs0 f₁; have h2 := hs0 f₂; have h3 := hs0 f₃
    have d1 := hs0 (SchwartzMap.derivCLM ℝ ℂ f₁); have d2 := hs0 (SchwartzMap.derivCLM ℝ ℂ f₂)
    have d3 := hs0 (SchwartzMap.derivCLM ℝ ℂ f₃)
    rcases hi with rfl | rfl | rfl
    · have := SchwartzMap.norm_le_seminorm ℝ (SchwartzMap.derivCLM ℝ ℂ f₁) x
      rw [SchwartzMap.derivCLM_apply] at this; simp only [s]; linarith
    · have := SchwartzMap.norm_le_seminorm ℝ (SchwartzMap.derivCLM ℝ ℂ f₂) x
      rw [SchwartzMap.derivCLM_apply] at this; simp only [s]; linarith
    · have := SchwartzMap.norm_le_seminorm ℝ (SchwartzMap.derivCLM ℝ ℂ f₃) x
      rw [SchwartzMap.derivCLM_apply] at this; simp only [s]; linarith

theorem oddIntegrand_schwartz_integrableOn (f₁ f₂ f₃ : SchwartzMap ℝ ℂ) (x : ℝ) :
    IntegrableOn (fun t : ℝ => (f₁ (x - t) * f₂ (x - 2 * t) * f₃ (x - 3 * t) -
        f₁ (x - -t) * f₂ (x - 2 * -t) * f₃ (x - 3 * -t)) / (t : ℂ)) (Set.Ioi 0) := by
  obtain ⟨M, hd, hb, hb'⟩ := schwartz_triple_bounds f₁ f₂ f₃
  exact oddIntegrand_integrableOn hd hb hb' f₁.integrable x

/-- `TrilinearHT.T` is additive in each Schwartz argument. -/
theorem T_add (f₁ g₁ f₂ g₂ f₃ g₃ : SchwartzMap ℝ ℂ) (x : ℝ) :
    TrilinearHT.T ![⇑(f₁ + g₁), ⇑f₂, ⇑f₃] x =
        TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃] x + TrilinearHT.T ![⇑g₁, ⇑f₂, ⇑f₃] x ∧
      TrilinearHT.T ![⇑f₁, ⇑(f₂ + g₂), ⇑f₃] x =
        TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃] x + TrilinearHT.T ![⇑f₁, ⇑g₂, ⇑f₃] x ∧
      TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑(f₃ + g₃)] x =
        TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃] x + TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑g₃] x := by
  refine ⟨?_, ?_, ?_⟩ <;> simp only [T_eq_neg_integral] <;>
    rw [← neg_add, ← integral_add (oddIntegrand_schwartz_integrableOn _ _ _ x)
      (oddIntegrand_schwartz_integrableOn _ _ _ x)] <;> congr 2 <;> funext t <;>
    simp only [add_apply] <;> ring

/-- `TrilinearHT.T` is homogeneous in each Schwartz argument. -/
theorem T_smul (c : ℂ) (f₁ f₂ f₃ : SchwartzMap ℝ ℂ) (x : ℝ) :
    TrilinearHT.T ![⇑(c • f₁), ⇑f₂, ⇑f₃] x = c • TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃] x ∧
      TrilinearHT.T ![⇑f₁, ⇑(c • f₂), ⇑f₃] x = c • TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃] x ∧
      TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑(c • f₃)] x = c • TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃] x := by
  refine ⟨?_, ?_, ?_⟩ <;> simp only [T_eq_neg_integral] <;>
    rw [smul_neg, smul_eq_mul, ← integral_const_mul] <;>
    congr 2 <;> funext t <;> simp only [smul_apply, smul_eq_mul] <;> ring

/-- Blueprint `thm:main` (lines 2934-3009), given `thm:uniform-local` in the form of uniformly
bounded finite-depth constants for every admissible class: for Schwartz inputs the principal value
`T(f₁, f₂, f₃)(x) = p.v. ∫ f₁(x - t) f₂(x - 2t) f₃(x - 3t) dt/t` exists at every `x`, lies in `L¹`
with `‖T(f₁, f₂, f₃)‖₁ ≤ C Π_j ‖f_j‖₃`, and `T` has a unique bounded trilinear extension
`L³ × L³ × L³ → L¹`. -/
theorem tht_main_of_uniform
    (huni : ∀ κ : LocalKernelClass, ∃ q, 2 ≤ q ∧ q < 3 ∧ ∃ Cst : ℝ,
      ∀ N, finiteDepthConstant κ q N ≤ Cst) :
    ∃ C : ℝ, 0 ≤ C ∧
      (∀ f₁ f₂ f₃ : SchwartzMap ℝ ℂ,
        (∀ x, Filter.Tendsto (TrilinearHT.truncatedTransform ![⇑f₁, ⇑f₂, ⇑f₃] x)
          (nhdsWithin 0 (Set.Ioi 0)) (nhds (TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃] x))) ∧
        MemLp (TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃]) 1 volume ∧
        ∫⁻ x, ‖TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃] x‖ₑ ≤
          ENNReal.ofReal C * (eLpNorm f₁ 3 volume * eLpNorm f₂ 3 volume * eLpNorm f₃ 3 volume)) ∧
      ∃ T' : Lp ℂ 3 (volume : Measure ℝ) →L[ℂ] Lp ℂ 3 (volume : Measure ℝ) →L[ℂ]
          Lp ℂ 3 (volume : Measure ℝ) →L[ℂ] Lp ℂ 1 (volume : Measure ℝ),
        (∀ f₁ f₂ f₃ : SchwartzMap ℝ ℂ, ⇑(T' (f₁.toLp 3 (volume : Measure ℝ))
          (f₂.toLp 3 (volume : Measure ℝ)) (f₃.toLp 3 (volume : Measure ℝ))) =ᵐ[volume]
            TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃]) ∧
        (∀ x y z, ‖T' x y z‖ ≤ C * ‖x‖ * ‖y‖ * ‖z‖) ∧
        ∀ S : Lp ℂ 3 (volume : Measure ℝ) →L[ℂ] Lp ℂ 3 (volume : Measure ℝ) →L[ℂ]
            Lp ℂ 3 (volume : Measure ℝ) →L[ℂ] Lp ℂ 1 (volume : Measure ℝ),
          (∀ f₁ f₂ f₃ : SchwartzMap ℝ ℂ, ⇑(S (f₁.toLp 3 (volume : Measure ℝ))
            (f₂.toLp 3 (volume : Measure ℝ)) (f₃.toLp 3 (volume : Measure ℝ))) =ᵐ[volume]
              TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃]) → S = T' := by
  obtain ⟨C, hC, hbound⟩ := T_L1_bound_of_uniform huni
  have hfin : ∀ f₁ f₂ f₃ : SchwartzMap ℝ ℂ,
      ENNReal.ofReal C * (eLpNorm f₁ 3 volume * eLpNorm f₂ 3 volume * eLpNorm f₃ 3 volume) ≠ ∞ :=
    fun f₁ f₂ f₃ => ENNReal.mul_ne_top ENNReal.ofReal_ne_top (ENNReal.mul_ne_top
      (ENNReal.mul_ne_top (f₁.memLp 3 volume).eLpNorm_ne_top (f₂.memLp 3 volume).eLpNorm_ne_top)
      (f₃.memLp 3 volume).eLpNorm_ne_top)
  have hmem : ∀ f₁ f₂ f₃ : SchwartzMap ℝ ℂ, MemLp (TrilinearHT.T ![⇑f₁, ⇑f₂, ⇑f₃]) 1 volume := by
    intro f₁ f₂ f₃
    rw [memLp_iff, eLpNorm_one_eq_lintegral_enorm
      (T_measurable f₁ f₂ f₃).aestronglyMeasurable]
    exact (hbound f₁ f₂ f₃).trans_lt (lt_top_iff_ne_top.mpr (hfin f₁ f₂ f₃))
  -- the trilinear operator into `L¹`
  set! L : SchwartzMap ℝ ℂ → SchwartzMap ℝ ℂ →ₗ[ℂ] SchwartzMap ℝ ℂ →ₗ[ℂ]
      Lp ℂ 1 (volume : Measure ℝ) := fun f₁ =>
    LinearMap.mk₂ ℂ (fun f₂ f₃ => (hmem f₁ f₂ f₃).toLp _)
      (fun m₁ m₂ n => by
        rw [← MemLp.toLp_add]
        exact MemLp.toLp_congr _ _ (Filter.Eventually.of_forall fun x =>
          (T_add f₁ f₁ m₁ m₂ n n x).2.1))
      (fun c m n => by
        rw [← MemLp.toLp_const_smul]
        exact MemLp.toLp_congr _ _ (Filter.Eventually.of_forall fun x =>
          (T_smul c f₁ m n x).2.1))
      (fun m n₁ n₂ => by
        rw [← MemLp.toLp_add]
        exact MemLp.toLp_congr _ _ (Filter.Eventually.of_forall fun x =>
          (T_add f₁ f₁ m m n₁ n₂ x).2.2))
      (fun c m n => by
        rw [← MemLp.toLp_const_smul]
        exact MemLp.toLp_congr _ _ (Filter.Eventually.of_forall fun x =>
          (T_smul c f₁ m n x).2.2))
  have hL : ∀ f₁ f₂ f₃, L f₁ f₂ f₃ = (hmem f₁ f₂ f₃).toLp _ := fun _ _ _ => rfl
  set! T : SchwartzMap ℝ ℂ →ₗ[ℂ] SchwartzMap ℝ ℂ →ₗ[ℂ] SchwartzMap ℝ ℂ →ₗ[ℂ]
      Lp ℂ 1 (volume : Measure ℝ) :=
    { toFun := L
      map_add' := fun a b => LinearMap.ext₂ fun f₂ f₃ => by
        rw [LinearMap.add_apply, LinearMap.add_apply, hL, hL, hL, ← MemLp.toLp_add]
        exact MemLp.toLp_congr _ _ (Filter.Eventually.of_forall fun x =>
          (T_add a b f₂ f₂ f₃ f₃ x).1)
      map_smul' := fun c a => LinearMap.ext₂ fun f₂ f₃ => by
        rw [RingHom.id_apply, LinearMap.smul_apply, LinearMap.smul_apply, hL, hL,
          ← MemLp.toLp_const_smul]
        exact MemLp.toLp_congr _ _ (Filter.Eventually.of_forall fun x =>
          (T_smul c a f₂ f₃ x).1) }
  have hT : ∀ f₁ f₂ f₃, T f₁ f₂ f₃ = (hmem f₁ f₂ f₃).toLp _ := fun _ _ _ => rfl
  have hTb : ∀ f₁ f₂ f₃ : SchwartzMap ℝ ℂ, ‖T f₁ f₂ f₃‖ ≤
      C * ‖f₁.toLp 3 (volume : Measure ℝ)‖ * ‖f₂.toLp 3 (volume : Measure ℝ)‖ *
        ‖f₃.toLp 3 (volume : Measure ℝ)‖ := by
    intro f₁ f₂ f₃
    rw [hT, Lp.norm_toLp, SchwartzMap.norm_toLp, SchwartzMap.norm_toLp, SchwartzMap.norm_toLp,
      eLpNorm_one_eq_lintegral_enorm
        (T_measurable f₁ f₂ f₃).aestronglyMeasurable]
    refine (ENNReal.toReal_mono (hfin f₁ f₂ f₃) (hbound f₁ f₂ f₃)).trans (le_of_eq ?_)
    rw [ENNReal.toReal_mul, ENNReal.toReal_mul, ENNReal.toReal_mul, ENNReal.toReal_ofReal hC]
    ring
  obtain ⟨T', hT'eq, hT'b, hT'u⟩ := schwartz_L3_unique_extension T hC hTb
  refine ⟨C, hC, fun f₁ f₂ f₃ => ⟨fun x => tendsto_truncatedTransform_three f₁ f₂ f₃ x,
    hmem f₁ f₂ f₃, hbound f₁ f₂ f₃⟩, T', fun f₁ f₂ f₃ => ?_, hT'b, fun S hS => ?_⟩
  · rw [hT'eq, hT]
    exact MemLp.coeFn_toLp _
  · apply hT'u S
    intro f₁ f₂ f₃
    rw [hT]
    exact Lp.ext ((hS f₁ f₂ f₃).trans (MemLp.coeFn_toLp _).symm)

/-- `thm:uniform-local` from `prop:normalized` for every admissible class. -/
theorem uniform_of_normalized
    (hnorm : ∀ κ : LocalKernelClass, ∃ q, 2 ≤ q ∧ q < 3 ∧ ∃ A c : ℝ, 0 ≤ A ∧ 0 ≤ c ∧
      4 / 3 * 16 ^ (4 / q) * c ≤ 1 / 2 ∧ ∀ N, NormalizedAbsorption κ q N A c) :
    ∀ κ : LocalKernelClass, ∃ q, 2 ≤ q ∧ q < 3 ∧ ∃ Cst : ℝ,
      ∀ N, finiteDepthConstant κ q N ≤ Cst := by
  intro κ
  obtain ⟨q, hq, hq3, A, c, hA, hc, hsmall, hN⟩ := hnorm κ
  exact ⟨q, hq, hq3, _, uniform_local_of_normalized κ hq hA hc hsmall hN⟩

/-- The zero kernel is admissible (it carries the unused cells of a finite tree). -/
theorem isAdmissibleLocalKernel_zero (κ : LocalKernelClass) (a : ℝ) {r : ℝ} (hr : 0 < r) :
    IsAdmissibleLocalKernel κ a r 0 where
  smooth := contDiff_const
  support := fun z hz => absurd rfl hz
  marginal := fun u j => by simp
  derivativeBound := fun m n z => by
    have h0 : localKernelPartial m n (0 : ℝ × ℝ → ℂ) z = 0 := by
      unfold localKernelPartial
      simp
    rw [h0, norm_zero]
    have h1 : (1 : ℝ) ≤ κ.derivativeConstant * ((m + n : ℕ) + 2) := by
      have := κ.one_le_derivativeConstant
      have : (2 : ℝ) ≤ ((m + n : ℕ) : ℝ) + 2 := by linarith [Nat.cast_nonneg (α := ℝ) (m + n)]
      nlinarith
    exact mul_nonneg (pow_nonneg (inv_nonneg.mpr hr.le) _) (Real.rpow_nonneg (by linarith) _)

/-- Blueprint lines 2893-2904 (the expansion at a finite cutoff `T`): on a finite tree whose
kernel-hull cells carry stagger cells, the length-weighted sum of `|H_I(f)|` is at most the
remainders `(T+1) 32 e^{-k_{T-3}}` per unit length plus the tuple sums over the update pairs
`1 ≤ u < t ≤ T` in distinct positions. -/
theorem tree_expansion_bound {κ : LocalKernelClass} {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ}
    {w : ℤ × ℤ → ℝ × ℝ → ℂ} {f : Fin 4 → ℝ → ℂ} {g : ℕ → ℤ × ℤ → ℝ → ℂ} {kk : ℕ → ℕ}
    (hcells : ∀ I ∈ dyadicFiniteTree G J N, kernelHull G J N w I → ∃ D : StaggerCell κ,
      D.r = dyadicGridLength G I.1 ∧ D.w = w I ∧ D.f = f ∧ (∀ t, D.g t = g t I) ∧
      (∀ T, D.H D.f = D.H (D.tail T) + ∑ u ∈ Finset.Icc 1 T,
        (D.H (Function.update (D.tail T) (stagPos u) (D.incr u)) +
          ∑ t ∈ Finset.Ioc u T, if stagPos t ≠ stagPos u then D.H (D.tuple u t) else 0)) ∧
      (∀ T, 4 ≤ T → ‖D.H (D.tail T)‖ ≤ 32 * Real.exp (-(kk (T - 3) : ℝ)) ∧
        ∀ u, ‖D.H (Function.update (D.tail T) (stagPos u) (D.incr u))‖ ≤
          32 * Real.exp (-(kk (T - 3) : ℝ))))
    (T : ℕ) (hT : 4 ≤ T) :
    ∑ I ∈ dyadicFiniteTree G J N, dyadicGridLength G I.1 *
        ‖localProgressionForm (dyadicGridLength G I.1) (w I) f‖ ≤
      ((T : ℝ) + 1) * (32 * Real.exp (-(kk (T - 3) : ℝ))) *
          ∑ I ∈ dyadicFiniteTree G J N, dyadicGridLength G I.1 +
        ∑ u ∈ Finset.Icc 1 T, ∑ t ∈ Finset.Ioc u T, (if stagPos t ≠ stagPos u then
          ∑ I ∈ dyadicFiniteTree G J N, dyadicGridLength G I.1 *
            ‖localProgressionForm (dyadicGridLength G I.1) (w I) (stagTuple f g u t I)‖
          else 0) := by
  classical
  set e := 32 * Real.exp (-(kk (T - 3) : ℝ)) with he
  have he0 : 0 ≤ e := by positivity
  -- the per-cell bound
  have hcell : ∀ I ∈ dyadicFiniteTree G J N,
      ‖localProgressionForm (dyadicGridLength G I.1) (w I) f‖ ≤
        ((T : ℝ) + 1) * e + ∑ u ∈ Finset.Icc 1 T, ∑ t ∈ Finset.Ioc u T,
          (if stagPos t ≠ stagPos u then
            ‖localProgressionForm (dyadicGridLength G I.1) (w I) (stagTuple f g u t I)‖
            else 0) := by
    intro I hI
    have hrhs : 0 ≤ ((T : ℝ) + 1) * e + ∑ u ∈ Finset.Icc 1 T, ∑ t ∈ Finset.Ioc u T,
        (if stagPos t ≠ stagPos u then
          ‖localProgressionForm (dyadicGridLength G I.1) (w I) (stagTuple f g u t I)‖ else 0) := by
      refine add_nonneg (by positivity) (Finset.sum_nonneg fun u _ =>
        Finset.sum_nonneg fun t _ => ?_)
      split_ifs <;> positivity
    by_cases hH : kernelHull G J N w I
    · obtain ⟨D, hr, hw, hf, hg, hexp, hbd⟩ := hcells I hI hH
      have hD : ∀ u t, D.H (D.tuple u t) =
          localProgressionForm (dyadicGridLength G I.1) (w I) (stagTuple f g u t I) := by
        intro u t
        rw [StaggerCell.tuple_eq_stagTuple D hf hg]
        simp only [StaggerCell.H, hr, hw]
      have hDf : D.H D.f = localProgressionForm (dyadicGridLength G I.1) (w I) f := by
        simp only [StaggerCell.H, hr, hw, hf]
      rw [← hDf, hexp T]
      obtain ⟨htail, hupd⟩ := hbd T hT
      calc ‖D.H (D.tail T) + ∑ u ∈ Finset.Icc 1 T,
            (D.H (Function.update (D.tail T) (stagPos u) (D.incr u)) +
              ∑ t ∈ Finset.Ioc u T, if stagPos t ≠ stagPos u then D.H (D.tuple u t) else 0)‖
          ≤ e + ∑ u ∈ Finset.Icc 1 T, (e + ∑ t ∈ Finset.Ioc u T,
              (if stagPos t ≠ stagPos u then
                ‖localProgressionForm (dyadicGridLength G I.1) (w I) (stagTuple f g u t I)‖
                else 0)) := by
            refine (norm_add_le _ _).trans (add_le_add htail ((norm_sum_le _ _).trans
              (Finset.sum_le_sum fun u _ => (norm_add_le _ _).trans
                (add_le_add (hupd u) ((norm_sum_le _ _).trans
                  (Finset.sum_le_sum fun t _ => ?_))))))
            split_ifs
            · rw [hD]
            · simp
        _ = ((T : ℝ) + 1) * e + ∑ u ∈ Finset.Icc 1 T, ∑ t ∈ Finset.Ioc u T,
              (if stagPos t ≠ stagPos u then
                ‖localProgressionForm (dyadicGridLength G I.1) (w I) (stagTuple f g u t I)‖
                else 0) := by
            rw [Finset.sum_add_distrib, Finset.sum_const, Nat.card_Icc, nsmul_eq_mul]
            push_cast; ring
    · have h0 : localProgressionForm (dyadicGridLength G I.1) (w I) f = 0 := by
        rw [eq_zero_of_not_kernelHull hI hH, localProgressionForm_zero_kernel]
      rw [h0, norm_zero]
      exact hrhs
  calc ∑ I ∈ dyadicFiniteTree G J N, dyadicGridLength G I.1 *
        ‖localProgressionForm (dyadicGridLength G I.1) (w I) f‖
      ≤ ∑ I ∈ dyadicFiniteTree G J N, dyadicGridLength G I.1 *
          (((T : ℝ) + 1) * e + ∑ u ∈ Finset.Icc 1 T, ∑ t ∈ Finset.Ioc u T,
            (if stagPos t ≠ stagPos u then
              ‖localProgressionForm (dyadicGridLength G I.1) (w I) (stagTuple f g u t I)‖
              else 0)) :=
        Finset.sum_le_sum fun I hI =>
          mul_le_mul_of_nonneg_left (hcell I hI) (dyadicGridLength_pos G I.1).le
    _ = _ := by
        simp only [mul_add, Finset.sum_add_distrib, Finset.mul_sum]
        congr 1
        · exact Finset.sum_congr rfl fun I _ => by ring
        · rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun u _ => ?_
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun t _ => ?_
          split_ifs
          · rfl
          · simp

/-- The properties of the active setups of a noninitial level produced by
`activeCellReduction`, at accuracy `k`, complexity exponent `C_b` and pair bound `η₀`, including
the sub-root properties used by restarts. -/
def ActiveSetup.LevelProps {κ : LocalKernelClass} {c₀ : ℕ} (B : ActiveSetup κ c₀) (k Cb : ℕ)
    (η₀ : ℝ) : Prop :=
  (∀ I ∈ B.cells, ∀ J' : ℤ × ℤ, dyadicGridCell B.G I.1 I.2 ⊆ dyadicGridCell B.G J'.1 J'.2 →
    dyadicGridCell B.G J'.1 J'.2 ⊆ dyadicGridCell B.G B.R.1 B.R.2 → J' ∈ B.cells) ∧
  1 ≤ B.H ∧ B.H ≤ Real.exp ((k : ℝ) ^ Cb) ∧ B.Dc ≤ Real.exp ((k : ℝ) ^ Cb) ∧
  (Fintype.card B.L : ℝ) ≤ Real.exp ((k : ℝ) ^ Cb) ∧ B.S = 2 ∧ B.η = 4 * η₀ ∧
  (∀ I ∈ B.cells, ∀ s s', s ≠ s' → PairSmall (dyadicGridLeft B.G I.1 I.2)
    (dyadicGridLength B.G I.1) (B.w I) s s' (B.Y I s) (B.Y I s') (2 * η₀)) ∧
  (∀ I ∈ B.cells, ∀ l, (eLpNorm (B.Y I l) 2 (B.μ I)).toReal ≤ 2) ∧
  (∀ l, ∑ I ∈ B.cells, dyadicGridLength B.G I.1 * (eLpNorm (B.U l I) 2 (B.μ I)).toReal ^ 2 ≤
    (k : ℝ) ^ Cb * dyadicGridLength B.G B.R.1) ∧
  ∑ I ∈ B.cells, dyadicGridLength B.G I.1 * ‖B.Hf I (B.z 3 I)‖ ≤
    η₀ * ((k : ℝ) ^ Cb * dyadicGridLength B.G B.R.1) ∧
  B.HasColumnRep 1 ∧ B.SubRootProps η₀ ((k : ℝ) ^ Cb)

/-- Blueprint `eq:active-final` (prop:normalized, lines 2885-2888) as a statement about the
active setups of the base reduction: for every complexity order `c'`, exponent `C_b` and pair
exponent `θ₀`, there are `q ∈ (2, 3)`, `c_* > 0` and `C` such that, at every large accuracy `k`,
every active setup with the level properties at `η₀ = e^{-2 k^{θ₀}}` whose nonzero kernels lie in
`N` consecutive depths satisfies
`Σ_I |I| |H_I(Y)| ≤ (C η₀^{c_*} (1 + C_N(q)) + e^{-k}) |R|`. -/
def ActiveFinal (κ : LocalKernelClass) : Prop :=
  ∀ (c' Cb : ℕ) (θ₀ : ℝ), 1 ≤ c' → 0 < θ₀ → θ₀ ≤ 1 → ∃ q : ℝ, 2 < q ∧ q < 3 ∧
    ∃ cs Cfin : ℝ, 0 < cs ∧ 0 ≤ Cfin ∧ ∃ K : ℕ, ∀ k : ℕ, K ≤ k → ∀ (N : ℕ) (d₀ : ℤ)
      (B : ActiveSetup κ c'), (∀ I ∈ B.cells, B.w I ≠ 0 → d₀ ≤ I.1 ∧ I.1 < d₀ + N) →
      B.LevelProps k Cb (Real.exp (-2 * (k : ℝ) ^ θ₀)) →
      ∑ I ∈ B.cells, dyadicGridLength B.G I.1 * ‖B.Hf I (B.Y I)‖ ≤
        (Cfin * Real.exp (-2 * (k : ℝ) ^ θ₀) ^ cs * (1 + finiteDepthConstant κ q N) +
          Real.exp (-(k : ℝ))) * dyadicGridLength B.G B.R.1

theorem StaggerCell.tuple_measurable {κ : LocalKernelClass} (C : StaggerCell κ) (u t : ℕ)
    (l : Fin 4) : Measurable (C.tuple u t l) := by
  have hg : ∀ s, Measurable (C.g s) := C.g_meas
  have hprev : ∀ s, Measurable (C.prevProj s) := fun s => by
    unfold StaggerCell.prevProj; split_ifs
    · exact measurable_const
    · exact hg _
  have hlast : ∀ l s, Measurable (C.lastProj l s) := fun l s => by
    unfold StaggerCell.lastProj; split_ifs
    · exact hg _
    · exact measurable_const
  unfold StaggerCell.tuple StaggerCell.incr
  split_ifs
  · exact (hg u).sub (hprev u)
  · exact (hg t).sub (hprev t)
  · exact (C.f_meas l).sub (hlast l t)

/-- The cutoff remainders vanish: if `k_t ≥ t` for `t ≥ 1`, then `(T+1) e^{-k_{T-3}} → 0`. -/
theorem tendsto_cutoff_remainder {kk : ℕ → ℕ} (hkk : ∀ t : ℕ, 1 ≤ t → (t : ℝ) ≤ kk t) (S : ℝ) :
    Filter.Tendsto (fun T : ℕ => ((T : ℝ) + 1) * (32 * Real.exp (-(kk (T - 3) : ℝ))) * S)
      Filter.atTop (nhds 0) := by
  have h1 : Filter.Tendsto (fun T : ℕ => ((T : ℝ) + 1) * Real.exp (-(T : ℝ))) Filter.atTop
      (nhds 0) := by
    have ha := (Real.tendsto_pow_mul_exp_neg_atTop_nhds_zero 1).comp
      tendsto_natCast_atTop_atTop
    have hb := Real.tendsto_exp_neg_atTop_nhds_zero.comp
      (tendsto_natCast_atTop_atTop (R := ℝ))
    have := ha.add hb
    simp only [pow_one, add_zero] at this
    refine this.congr fun T => ?_
    simp only [Function.comp_apply]; ring
  have h2 : Filter.Tendsto (fun T : ℕ => ((T : ℝ) + 1) * Real.exp (-(T : ℝ)) *
      (32 * Real.exp 4 * |S|)) Filter.atTop (nhds 0) := by
    simpa using h1.mul_const (32 * Real.exp 4 * |S|)
  refine squeeze_zero_norm' ?_ h2
  filter_upwards [Filter.eventually_ge_atTop 4] with T hT
  have hk : ((T : ℝ) - 4) ≤ (kk (T - 3) : ℝ) := by
    have := hkk (T - 3) (by omega)
    have e : ((T - 3 : ℕ) : ℝ) = (T : ℝ) - 3 := by
      rw [Nat.cast_sub (by omega : 3 ≤ T)]; norm_num
    rw [e] at this; linarith only [this]
  have hexp : Real.exp (-(kk (T - 3) : ℝ)) ≤ Real.exp 4 * Real.exp (-(T : ℝ)) := by
    rw [← Real.exp_add, Real.exp_le_exp]; linarith
  rw [norm_mul, norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, Real.norm_eq_abs,
    abs_of_nonneg (by positivity : (0 : ℝ) ≤ (T : ℝ) + 1),
    abs_of_nonneg (by positivity : (0 : ℝ) ≤ 32 * Real.exp (-(kk (T - 3) : ℝ)))]
  have hT0 : (0 : ℝ) ≤ (T : ℝ) + 1 := by positivity
  calc ((T : ℝ) + 1) * (32 * Real.exp (-(kk (T - 3) : ℝ))) * |S|
      ≤ ((T : ℝ) + 1) * (32 * (Real.exp 4 * Real.exp (-(T : ℝ)))) * |S| := by gcongr
    _ = ((T : ℝ) + 1) * Real.exp (-(T : ℝ)) * (32 * Real.exp 4 * |S|) := by ring

/-- The length-weighted sum of the forms of one level, over a finite tree with kernels `w`. -/
noncomputable def levelSum (G : RealDyadicGrid) (J : ℤ × ℤ) (N : ℕ) (w : ℤ × ℤ → ℝ × ℝ → ℂ)
    (f : Fin 4 → ℝ → ℂ) (g : ℕ → ℤ × ℤ → ℝ → ℂ) (u t : ℕ) : ℝ := by
  classical
  exact if 1 ≤ u ∧ u < t ∧ stagPos t ≠ stagPos u then
    ∑ I ∈ dyadicFiniteTree G J N, dyadicGridLength G I.1 *
      ‖localProgressionForm (dyadicGridLength G I.1) (w I) (stagTuple f g u t I)‖ else 0

theorem levelSum_nonneg (G : RealDyadicGrid) (J : ℤ × ℤ) (N : ℕ) (w : ℤ × ℤ → ℝ × ℝ → ℂ)
    (f : Fin 4 → ℝ → ℂ) (g : ℕ → ℤ × ℤ → ℝ → ℂ) (u t : ℕ) : 0 ≤ levelSum G J N w f g u t := by
  unfold levelSum
  split_ifs
  · exact Finset.sum_nonneg fun I _ =>
      mul_nonneg (dyadicGridLength_pos G I.1).le (norm_nonneg _)
  · exact le_rfl

/-- Over the update pairs of a cutoff, the tuple sums are the level sums. -/
theorem sum_levelSum (G : RealDyadicGrid) (J : ℤ × ℤ) (N : ℕ) (w : ℤ × ℤ → ℝ × ℝ → ℂ)
    (f : Fin 4 → ℝ → ℂ) (g : ℕ → ℤ × ℤ → ℝ → ℂ) (T : ℕ) :
    ∑ u ∈ Finset.Icc 1 T, ∑ t ∈ Finset.Ioc u T, (if stagPos t ≠ stagPos u then
      ∑ I ∈ dyadicFiniteTree G J N, dyadicGridLength G I.1 *
        ‖localProgressionForm (dyadicGridLength G I.1) (w I) (stagTuple f g u t I)‖ else 0) =
      ∑ u ∈ Finset.Icc 1 T, ∑ t ∈ Finset.Ioc u T, levelSum G J N w f g u t := by
  classical
  refine Finset.sum_congr rfl fun u hu => Finset.sum_congr rfl fun t ht => ?_
  have hu1 := (Finset.mem_Icc.mp hu).1
  have hut := (Finset.mem_Ioc.mp ht).1
  unfold levelSum
  by_cases hp : stagPos t ≠ stagPos u
  · simp only [hp, hu1, hut, ne_eq, not_false_eq_true, and_self, ↓reduceIte]
  · simp only [hp, ↓reduceIte, and_false]




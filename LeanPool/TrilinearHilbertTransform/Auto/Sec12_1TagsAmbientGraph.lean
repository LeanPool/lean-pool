/-- The conclusion `eq:weyl-splitting` of `lem:weyl` (one time variable) for horizontal data `V`,
rational matrix `C` and quadratic `Λ`, with projection heights and sizes at most `B`. -/
def WeylSplitData (B : ℝ) {d : ℕ} (V : Matrix (Fin d) (Fin 1) ℝ) (C : Matrix (Fin d) (Fin d) ℚ)
    (Λ : Matrix (Fin 1) (Fin 1) ℝ) : Prop :=
  ∃ (U : Submodule ℝ (EuclideanSpace ℝ (Fin d))) (Q : Matrix (Fin d) (Fin d) ℚ),
    realMatrixOperator (Q.map (fun q => (q : ℝ))) = Uᗮ.starProjection ∧
    realMatrixOperator ((1 - Q).map (fun q => (q : ℝ))) = U.starProjection ∧
    (∀ x ∈ U, ∀ y ∈ U, inner ℝ y
      (realMatrixOperator ((C.map (fun q => (q : ℝ))) - (C.map (fun q => (q : ℝ))).transpose) x)
        = 0) ∧
    (∀ i j, (rationalHeight (Q i j) : ℝ) ≤ B) ∧
    (∀ i j, (rationalHeight ((1 - Q) i j) : ℝ) ≤ B) ∧
    ‖realMatrixOperator (Q.map (fun q => (q : ℝ)) * V)‖ ≤ B ∧
    ‖realMatrixOperator (effectiveReturnQuadratic (C.map (fun q => (q : ℝ))) Λ V
      ((1 - Q).map (fun q => (q : ℝ)) * V) (Q.map (fun q => (q : ℝ)) * V))‖ ≤ B

theorem WeylSplitData.mono {B B' : ℝ} {d : ℕ} {V : Matrix (Fin d) (Fin 1) ℝ}
    {C : Matrix (Fin d) (Fin d) ℚ} {Λ : Matrix (Fin 1) (Fin 1) ℝ} (h : WeylSplitData B V C Λ)
    (hB : B ≤ B') : WeylSplitData B' V C Λ := by
  obtain ⟨U, Q, h1, h2, h3, h4, h5, h6, h7⟩ := h
  exact ⟨U, Q, h1, h2, h3, fun i j => (h4 i j).trans hB, fun i j => (h5 i j).trans hB,
    h6.trans hB, h7.trans hB⟩

theorem realSymmetricPart_smul {d : ℕ} (c : ℝ) (C : Matrix (Fin d) (Fin d) ℝ) :
    realSymmetricPart (c • C) = c • realSymmetricPart C := by
  unfold realSymmetricPart; rw [Matrix.transpose_smul]; module

theorem realSkewPart_smul {d : ℕ} (c : ℝ) (C : Matrix (Fin d) (Fin d) ℝ) :
    realSkewPart (c • C) = c • realSkewPart C := by
  unfold realSkewPart; rw [Matrix.transpose_smul]; module

theorem effectiveReturnQuadratic_smul {d k : ℕ} (c : ℝ) (C : Matrix (Fin d) (Fin d) ℝ)
    (Λ : Matrix (Fin k) (Fin k) ℝ) (V F S : Matrix (Fin d) (Fin k) ℝ) :
    effectiveReturnQuadratic (c • C) (c • Λ) V F S = c • effectiveReturnQuadratic C Λ V F S := by
  unfold effectiveReturnQuadratic
  rw [realSymmetricPart_smul, realSkewPart_smul, Matrix.mul_smul, Matrix.smul_mul,
    Matrix.mul_smul, Matrix.smul_mul]
  have : realSymmetricPart (c • (F.transpose * realSkewPart C * S)) =
      c • realSymmetricPart (F.transpose * realSkewPart C * S) := by
    unfold realSymmetricPart; rw [Matrix.transpose_smul]; module
  rw [this]; module

theorem realMatrixOperator_smul {m n : ℕ} (c : ℝ) (A : Matrix (Fin m) (Fin n) ℝ) :
    realMatrixOperator (c • A) = c • realMatrixOperator A := by
  unfold realMatrixOperator
  rw [map_smul, map_smul]

/-- Multiplying the matrix and the quadratic by a nonzero integer slot multiplier (blueprint
lem:graph, proof line 1692: the fixed multiplier `c_i` only changes rational heights by a fixed
power) preserves the splitting. -/
theorem WeylSplitData.of_smul {B : ℝ} {d : ℕ} {V : Matrix (Fin d) (Fin 1) ℝ}
    {C : Matrix (Fin d) (Fin d) ℚ} {Λ : Matrix (Fin 1) (Fin 1) ℝ} {c : ℤ} (hc : c ≠ 0)
    (h : WeylSplitData B V ((c : ℚ) • C) ((c : ℝ) • Λ)) : WeylSplitData B V C Λ := by
  obtain ⟨U, Q, h1, h2, h3, h4, h5, h6, h7⟩ := h
  have hmap : ((c : ℚ) • C).map (fun q => (q : ℝ)) = (c : ℝ) • C.map (fun q => (q : ℝ)) := by
    ext i j; simp
  have hc' : (c : ℝ) ≠ 0 := by exact_mod_cast hc
  have hc1 : 1 ≤ |(c : ℝ)| := by
    rw [← Int.cast_abs]; exact_mod_cast Int.one_le_abs hc
  refine ⟨U, Q, h1, h2, fun x hx y hy => ?_, h4, h5, h6, ?_⟩
  · have := h3 x hx y hy
    rw [hmap, Matrix.transpose_smul, ← smul_sub, realMatrixOperator_smul] at this
    simp only [smul_apply, inner_smul_right] at this
    exact (mul_eq_zero.mp this).resolve_left hc'
  · rw [hmap, effectiveReturnQuadratic_smul] at h7
    have hB0 : 0 ≤ B := le_trans (norm_nonneg _) h6
    refine le_trans ?_ h7
    rw [realMatrixOperator_smul, norm_smul, Real.norm_eq_abs]
    exact le_mul_of_one_le_left (norm_nonneg _) hc1

/-- A normalized tag `(θ_v, C_v, λ_v)` of a column (blueprint §12.1, line 1680): the column's
phase in slot `i` is `c_i (λ_v y² + (θ_v y)ᵀ C_v (θ_v y - n))`; linear modulation is excluded. -/
structure ChartTag where
  dim : ℕ
  θ : Fin dim → ℝ
  C : Matrix (Fin dim) (Fin dim) ℚ
  lam : ℝ

/-- The difference data of two tags at length `r` (blueprint line 1684). -/
def tagDiffV (r : ℝ) (v w : ChartTag) : Matrix (Fin (v.dim + w.dim)) (Fin 1) ℝ :=
  fun i _ => r * Fin.append v.θ w.θ i

def tagDiffC (v w : ChartTag) : Matrix (Fin (v.dim + w.dim)) (Fin (v.dim + w.dim)) ℚ :=
  chartBlockMatrix v.C (-w.C)

def tagDiffΛ (r : ℝ) (v w : ChartTag) : Matrix (Fin 1) (Fin 1) ℝ :=
  fun _ _ => r ^ 2 * (v.lam - w.lam)

/-- The edge relation of the curvature graph at length `r` (blueprint lines 1682-1686): the
difference data admit `eq:weyl-splitting` with heights and sizes at most `B`. -/
def tagEdge (B r : ℝ) (v w : ChartTag) : Prop :=
  WeylSplitData B (tagDiffV r v w) (tagDiffC v w) (tagDiffΛ r v w)

/-- Translation of a chart keeps its tag data (`quadraticChart_translation_closure` with the
horizontal, matrix and quadratic coefficients recorded). -/
theorem quadraticChart_translation_tag {d c₀ : ℕ} {H : ℝ} {A : QuadraticChartData d}
    (hA : QuadraticChartComplexity c₀ H A) (hc : 1 ≤ c₀) (t : ℝ) :
    ∃ A' : QuadraticChartData d, QuadraticChartComplexity c₀ (chartTranslationBudget H) A' ∧
      (IsBoundedQuadraticChart A → IsBoundedQuadraticChart A') ∧
      (∀ y, quadraticChartAtom A' y = quadraticChartAtom A (y + t)) ∧
      A'.horizontal = A.horizontal ∧ A'.matrix = A.matrix ∧ A'.quadratic = A.quadratic := by
  obtain ⟨P, m, a, hP, hPH, hoff, ha, hint⟩ := chart_translation_offset_reduction
    (quadraticChartComplexity_parameter_pos hA).le A.matrix hA.height
    (fun i => A.horizontal i * t)
  refine ⟨translateQuadraticChart A t m a, ?_, fun h => translateQuadraticChart_bounded h t m a
    hoff hint, translateQuadraticChart_atom A t m a hoff hint, rfl, rfl, rfl⟩
  exact quadraticChartComplexity_mono
    (translateQuadraticChart_complexity hA hc (Nat.cast_nonneg P) hPH t m a ha)
    (chartTranslationBase_le_budget hA)

/-- Normalized interval integrals are unit-interval integrals of the rescaled function. -/
theorem integral_normalizedIntervalMeasure_rescale (a₀ : ℝ) {r : ℝ} (hr : 0 < r) (f : ℝ → ℂ) :
    ∫ y, f y ∂(normalizedIntervalMeasure a₀ r) = ∫ z in Set.Ico (0 : ℝ) 1, f (a₀ + r * z) := by
  rw [normalizedIntervalMeasure_eq_intervalProbability a₀ hr, intervalProbabilityMeasure]
  have hemb : MeasurableEmbedding (fun y : ℝ => a₀ + (a₀ + r - a₀) * y) := by
    have : (fun y : ℝ => a₀ + (a₀ + r - a₀) * y) =
        ((Homeomorph.mulLeft₀ r hr.ne').trans (Homeomorph.addLeft a₀)) := by
      funext y; simp
    rw [this]; exact Homeomorph.measurableEmbedding _
  rw [hemb.integral_map]
  simp only [add_sub_cancel_left]
  rfl

/-- The trapezoid cutoff of the unit interval with ramps of width `ε`. -/
noncomputable def unitTrapezoid (ε z : ℝ) : ℝ := max 0 (min 1 (min (z / ε) ((1 - z) / ε)))

theorem unitTrapezoid_nonneg (ε z : ℝ) : 0 ≤ unitTrapezoid ε z := le_max_left _ _

theorem unitTrapezoid_le_one (ε z : ℝ) : unitTrapezoid ε z ≤ 1 :=
  max_le zero_le_one (min_le_left _ _)

theorem unitTrapezoid_support {ε z : ℝ} (hε : 0 < ε) (h : unitTrapezoid ε z ≠ 0) :
    0 < z ∧ z < 1 := by
  unfold unitTrapezoid at h
  by_contra hz
  apply h
  apply le_antisymm _ (le_max_left _ _)
  apply max_le le_rfl
  rcases not_and_or.mp hz with h1 | h1
  · rw [not_lt] at h1
    exact (min_le_right _ _).trans ((min_le_left _ _).trans (div_nonpos_of_nonpos_of_nonneg h1
      hε.le))
  · rw [not_lt] at h1
    exact (min_le_right _ _).trans ((min_le_right _ _).trans (div_nonpos_of_nonpos_of_nonneg
      (by linarith only [h1]) hε.le))

theorem unitTrapezoid_eq_one {ε z : ℝ} (hε : 0 < ε) (h1 : ε ≤ z) (h2 : z ≤ 1 - ε) :
    unitTrapezoid ε z = 1 := by
  unfold unitTrapezoid
  have a1 : 1 ≤ z / ε := (one_le_div hε).mpr h1
  have a2 : 1 ≤ (1 - z) / ε := (one_le_div hε).mpr (by linarith only [h2])
  rw [min_eq_left (le_min a1 a2), max_eq_right zero_le_one]

theorem unitTrapezoid_lipschitz {ε : ℝ} (hε : 0 < ε) (x y : ℝ) :
    |unitTrapezoid ε y - unitTrapezoid ε x| ≤ ε⁻¹ * |y - x| := by
  have hq : 0 ≤ ε⁻¹ * |y - x| := by positivity
  unfold unitTrapezoid
  refine (abs_max_sub_max_le_max _ _ _ _).trans (max_le (by rw [sub_self, abs_zero]; exact hq) ?_)
  refine (abs_min_sub_min_le_max _ _ _ _).trans (max_le (by rw [sub_self, abs_zero]; exact hq) ?_)
  refine (abs_min_sub_min_le_max _ _ _ _).trans (max_le ?_ ?_)
  · rw [← sub_div, abs_div, abs_of_pos hε, div_eq_inv_mul]
  · rw [← sub_div, abs_div, abs_of_pos hε, div_eq_inv_mul, show 1 - y - (1 - x) = -(y - x) by
      ring, abs_neg]

theorem unitTrapezoid_continuous (ε : ℝ) : Continuous (unitTrapezoid ε) := by
  unfold unitTrapezoid; fun_prop

/-- The trapezoid differs from the unit-interval indicator on a set of measure at most `2ε`. -/
theorem integral_unitTrapezoid_error {ε : ℝ} (hε : 0 < ε) {Q : ℝ → ℂ} (hQm : Measurable Q)
    (hQ : ∀ z, ‖Q z‖ ≤ 1) :
    ‖(∫ z in Set.Ico (0 : ℝ) 1, Q z) - ∫ z, (unitTrapezoid ε z : ℂ) * Q z‖ ≤ 2 * ε := by
  have hsupp : ∀ z, (unitTrapezoid ε z : ℂ) * Q z =
      (Set.Ico (0 : ℝ) 1).indicator (fun z => (unitTrapezoid ε z : ℂ) * Q z) z := by
    intro z
    by_cases hz : z ∈ Set.Ico (0 : ℝ) 1
    · rw [Set.indicator_of_mem hz]
    · rw [Set.indicator_of_notMem hz]
      have : unitTrapezoid ε z = 0 := by
        by_contra h
        obtain ⟨h1, h2⟩ := unitTrapezoid_support hε h
        exact hz ⟨h1.le, h2⟩
      simp [this]
  have hfin : IsFiniteMeasure (volume.restrict (Set.Ico (0 : ℝ) 1)) :=
    ⟨by simp⟩
  have hint1 : IntegrableOn Q (Set.Ico (0 : ℝ) 1) :=
    Integrable.of_bound hQm.aestronglyMeasurable 1 (Filter.Eventually.of_forall hQ)
  have hint2 : IntegrableOn (fun z => (unitTrapezoid ε z : ℂ) * Q z) (Set.Ico (0 : ℝ) 1) :=
    Integrable.of_bound (((Complex.continuous_ofReal.comp
      (unitTrapezoid_continuous ε)).measurable.mul hQm).aestronglyMeasurable) 1
      (Filter.Eventually.of_forall fun z => by
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg (unitTrapezoid_nonneg ε z)]
        exact (mul_le_mul (unitTrapezoid_le_one ε z) (hQ z) (norm_nonneg _) zero_le_one).trans
          (by norm_num))
  rw [integral_congr_ae (Filter.Eventually.of_forall hsupp), integral_indicator measurableSet_Ico,
    ← integral_sub hint1 hint2]
  -- pointwise bound by the indicator of the two ramps
  set E := Set.Ico (0 : ℝ) ε ∪ Set.Ico (1 - ε) 1
  have hpt : ∀ z ∈ Set.Ico (0 : ℝ) 1, ‖Q z - (unitTrapezoid ε z : ℂ) * Q z‖ ≤ E.indicator 1 z := by
    intro z hz
    by_cases hE : z ∈ E
    · rw [Set.indicator_of_mem hE, Pi.one_apply]
      rw [show Q z - (unitTrapezoid ε z : ℂ) * Q z = ((1 - unitTrapezoid ε z : ℝ) : ℂ) * Q z by
        push_cast; ring, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (by linarith [unitTrapezoid_le_one ε z])]
      exact (mul_le_mul (by linarith [unitTrapezoid_nonneg ε z]) (hQ z) (norm_nonneg _)
        zero_le_one).trans (by norm_num)
    · rw [Set.indicator_of_notMem hE]
      have h1 : ε ≤ z := by
        by_contra h; exact hE (Or.inl ⟨hz.1, lt_of_not_ge h⟩)
      have h2 : z ≤ 1 - ε := by
        by_contra h; exact hE (Or.inr ⟨(lt_of_not_ge h).le, hz.2⟩)
      rw [unitTrapezoid_eq_one hε h1 h2]; simp
  calc ‖∫ z in Set.Ico (0 : ℝ) 1, (Q z - (unitTrapezoid ε z : ℂ) * Q z)‖
      ≤ ∫ z in Set.Ico (0 : ℝ) 1, ‖Q z - (unitTrapezoid ε z : ℂ) * Q z‖ :=
        norm_integral_le_integral_norm _
    _ ≤ ∫ z in Set.Ico (0 : ℝ) 1, E.indicator 1 z := by
        refine setIntegral_mono_on (hint1.sub hint2).norm ?_ measurableSet_Ico hpt
        exact Integrable.of_bound (measurable_one.indicator
          ((measurableSet_Ico).union measurableSet_Ico)).aestronglyMeasurable 1
          (Filter.Eventually.of_forall fun z => (norm_indicator_le_norm_self 1 z).trans
            (by simp))
    _ ≤ ∫ z, E.indicator 1 z := by
        refine setIntegral_le_integral ?_ (Filter.Eventually.of_forall fun z => ?_)
        · rw [integrable_indicator_iff ((measurableSet_Ico).union measurableSet_Ico)]
          exact (integrableOn_const (by
            refine ((measure_union_le (μ := volume) (Set.Ico (0 : ℝ) ε)
              (Set.Ico (1 - ε) 1)).trans_lt ?_).ne
            rw [Real.volume_Ico, Real.volume_Ico]
            exact ENNReal.add_lt_top.mpr ⟨ENNReal.ofReal_lt_top, ENNReal.ofReal_lt_top⟩)).mono_set
              le_rfl
        · exact Set.indicator_nonneg (fun _ _ => zero_le_one) z
    _ = (volume E).toReal := by
        rw [integral_indicator ((measurableSet_Ico).union measurableSet_Ico)]
        simp only [Pi.one_apply, integral_const, smul_eq_mul, mul_one, Measure.restrict_apply_univ,
          measureReal_def]
        rfl
    _ ≤ 2 * ε := by
        have h1 := measure_union_le (μ := volume) (Set.Ico (0 : ℝ) ε) (Set.Ico (1 - ε) 1)
        rw [Real.volume_Ico, Real.volume_Ico] at h1
        have h2 : volume E ≤ ENNReal.ofReal (2 * ε) := by
          refine h1.trans ?_
          rw [← ENNReal.ofReal_add (by linarith) (by linarith)]
          exact ENNReal.ofReal_le_ofReal (by linarith)
        exact (ENNReal.toReal_le_of_le_ofReal (by linarith) h2)

theorem integral_fin_one_eq {G : ℝ → ℂ} :
    ∫ z : Fin 1 → ℝ, G (z 0) = ∫ x, G x := by

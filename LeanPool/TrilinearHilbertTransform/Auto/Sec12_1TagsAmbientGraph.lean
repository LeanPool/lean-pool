/-- Blueprint lem:graph (distinct slots): pure columns of two tags in distinct slots `i, k`
(multipliers `c_i, c_k`) whose tags are not joined by an edge at length `r` have form norm at
most `τ` against arbitrary normalized `L²` spectators. -/
theorem graph_distinctSlot_tag (κ : LocalKernelClass) (c₀ : ℕ) (hc : 1 ≤ c₀) :
    ∃ D : ℕ, 1 ≤ D ∧ ∀ (H τ : ℝ), Real.exp 2 ≤ H → 0 < τ → τ ≤ 1 →
    ∀ (v w : ChartTag) {a i k b : Fin 4}, a ≠ i → a ≠ k → a ≠ b → i ≠ k → i ≠ b → k ≠ b →
    1 ≤ v.dim → 1 ≤ w.dim →
    ∀ (A : QuadraticChartData v.dim) (A' : QuadraticChartData w.dim),
    QuadraticChartComplexity c₀ H A → QuadraticChartComplexity c₀ H A' →
    IsBoundedQuadraticChart A → IsBoundedQuadraticChart A' →
    A.horizontal = v.θ → A.matrix = (slotCoeff i : ℚ) • v.C → A.quadratic = slotCoeff i * v.lam →
    A'.horizontal = w.θ → A'.matrix = (slotCoeff k : ℚ) • w.C →
    A'.quadratic = slotCoeff k * w.lam →
    ∀ {a₀ r : ℝ}, 0 < r → ∀ {wI : ℝ × ℝ → ℂ}, IsAdmissibleLocalKernel κ a₀ r wI →
    ¬ tagEdge (Real.exp (D * (1 + Real.log H + Real.log τ⁻¹) ^ D)) r v w →
    PairSmall a₀ r wI i k (quadraticChartAtom A) (quadraticChartAtom A') τ := by
  obtain ⟨c₁, D, hc₁, hD, hcore⟩ := graph_distinct_core κ c₀ hc
  obtain ⟨Dw, hDw, hweyl⟩ := weylSplit_of_oneVar c₁ hc₁ 2 (by norm_num)
  set D' := Dw * (1 + 2 * D) ^ Dw + D * Dw with hD'
  refine ⟨D', by nlinarith only [Nat.one_le_pow Dw (1 + 2 * D) (by omega), Nat.zero_le (D * Dw),
      hDw, hD'], ?_⟩
  intro H τ hH hτ hτ1 v w a i k b hai hak hab hik hib hkb hv hw A A' hA hA' hAb hA'b hAh hAm hAq
    hA'h hA'm hA'q a₀ r hr wI hwI hne
  by_contra hns
  obtain ⟨Φ, hΦc, hΦh, hΦm, hΦq, hΦF⟩ := hcore H τ hH hτ hτ1 A A' hv hw hA hA' hAb hA'b hai hak
    hab hik hib hkb hr hwI hns
  set Y := 1 + Real.log H + Real.log τ⁻¹ with hY
  set E := Real.exp (D * Y ^ D) with hE
  have hlogH : 2 ≤ Real.log H := by
    rw [← Real.log_exp 2]; exact Real.log_le_log (Real.exp_pos 2) hH
  have hlτ : 0 ≤ Real.log τ⁻¹ := Real.log_nonneg (one_le_inv₀ hτ |>.mpr hτ1)
  have hY1 : 1 ≤ Y := by linarith only [hlogH, hlτ]
  have hE1 : 1 ≤ E := Real.one_le_exp (by positivity)
  -- the Weyl alternative for the time factor
  have hsplit := hweyl E E⁻¹ r Φ hΦc (fun u => (plateauTwo u : ℂ))
    (Complex.continuous_ofReal.comp plateauTwo_continuous).measurable
    (fun u => by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (plateauTwo_nonneg u)]
      exact (plateauTwo_le_one u).trans hE1)
    (fun u v => by
      rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
      exact (plateauTwo_lipschitz u v).trans (le_mul_of_one_le_left (abs_nonneg _) hE1))
    (fun u hu => plateauTwo_support (fun h => hu (by simp [h])))
    (inv_pos.mpr (by linarith)) hΦF
  -- the coefficient identity
  obtain ⟨hσ, hσ0⟩ := slotCoeff_time_identity i k a b hik hab hai hak hib.symm hkb.symm
  set σ : ℤ := slotCoeff i * (((i : ℕ) : ℤ) - (a : ℕ)) * (((i : ℕ) : ℤ) - (b : ℕ)) with hσdef
  apply hne
  refine WeylSplitData.of_smul hσ0 ?_
  have hV : (fun j (_ : Fin 1) => Φ.horizontal j * r) = tagDiffV r v w := by
    funext j l; rw [hΦh, hAh, hA'h, tagDiffV, mul_comm]
  have hC : Φ.matrix = (σ : ℚ) • tagDiffC v w := by
    rw [hΦm, hAm, hA'm, smul_smul, smul_smul, tagDiffC, ← chartBlockMatrix_smul, smul_neg]
    congr 1
    · congr 1; rw [hσdef]; push_cast; ring
    · rw [← neg_smul]; congr 1
      have : ((slotCoeff k * (((k : ℕ) : ℤ) - (a : ℕ)) * (((k : ℕ) : ℤ) - (b : ℕ)) : ℤ) : ℚ) =
          -(σ : ℚ) := by rw [hσ]; push_cast; ring
      rw [← this]; push_cast; ring
  have hΛ : (fun (_ _ : Fin 1) => Φ.quadratic * r ^ 2) = (σ : ℝ) • tagDiffΛ r v w := by
    funext j l
    rw [hΦq, hAq, hA'q, Matrix.smul_apply, tagDiffΛ, smul_eq_mul]
    have : ((slotCoeff k * (((k : ℕ) : ℤ) - (a : ℕ)) * (((k : ℕ) : ℤ) - (b : ℕ)) : ℤ) : ℝ) =
        -(σ : ℝ) := by rw [hσ]; push_cast; ring
    rw [hσdef] at this ⊢
    push_cast at this ⊢
    linear_combination r ^ 2 * w.lam * this
  rw [hV, hC, hΛ] at hsplit
  refine WeylSplitData.mono hsplit ?_
  -- the quasipolynomial budget
  rw [max_eq_right (by rw [inv_inv]; exact hE1), inv_inv, hE, Real.log_exp]
  apply Real.exp_le_exp.mpr
  have hYD : 1 ≤ Y ^ D := one_le_pow₀ hY1
  have h1 : 1 + D * Y ^ D + D * Y ^ D ≤ (1 + 2 * D) * Y ^ D := by nlinarith only [hYD]
  have h2 : (1 + D * Y ^ D + D * Y ^ D) ^ Dw ≤ (1 + 2 * D) ^ Dw * Y ^ (D * Dw) := by
    rw [pow_mul, ← mul_pow]
    exact pow_le_pow_left₀ (by positivity) h1 Dw
  have hDw0 : (0 : ℝ) ≤ Dw := Nat.cast_nonneg _
  calc (Dw : ℝ) * (1 + D * Y ^ D + D * Y ^ D) ^ Dw
      ≤ Dw * ((1 + 2 * D) ^ Dw * Y ^ (D * Dw)) := mul_le_mul_of_nonneg_left h2 hDw0
    _ ≤ (D' : ℝ) * Y ^ D' := by
        rw [← mul_assoc]
        apply mul_le_mul _ (pow_le_pow_right₀ hY1 (by rw [hD']; omega)) (by positivity)
          (by positivity)
        rw [hD']; push_cast; nlinarith only [Nat.zero_le (D * Dw)]


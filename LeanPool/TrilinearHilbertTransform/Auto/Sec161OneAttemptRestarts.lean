open Classical in
/-- The squared norm of the physical error of a basic slot at a cell is the integral over the cell
of its physical coordinate (the error is a difference of physical parts). -/
theorem errAt_sq_le (q : ℕ) (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md)
    (l : Fin 4) (G : bf.Grp) (I : ℤ × ℤ) :
    ‖(D.withQ0 q).errAt L l G I‖ ^ 2 ≤ ∫ y in dyadicGridCell A.G I.1 I.2,
      ‖(fp.physError (D.Ms l G) (L l G) l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l)
        D.S.K (A.blkStart D.S.K I.1) : ℝ → ColumnHilbert (bf.Lab ⊕ Fin fp.Mc)) y none‖ ^ 2 := by
  unfold errAt
  change ‖(if D.u = some l then 0 else _ : ColumnL2 (bf.Lab ⊕ Fin fp.Mc))‖ ^ 2 ≤ _
  split_ifs with hu
  · rw [norm_zero, zero_pow two_ne_zero]
    exact MeasureTheory.setIntegral_nonneg (dyadicGridCell_measurable A.G I.1 I.2)
      fun y _ => sq_nonneg _
  refine le_of_eq ?_
  change ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
    (fp.physError (D.Ms l G) (L l G) l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l) D.S.K
      (A.blkStart D.S.K I.1))‖ ^ 2 = _
  rw [columnL2Restriction_norm_sq]
  refine MeasureTheory.integral_congr_ae ?_
  unfold physError
  filter_upwards [ae_restrict_of_ae (Lp.coeFn_sub (fp.physMain (bf.Lab ⊕ Fin fp.Mc)
      (fp.frozenZ l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l)
        (A.blkStart D.S.K I.1 - 4 * D.S.K)))
      (fp.physMain (D.Ms l G).Md (fp.frozenLift (L l G) l (D.cat l) (D.mbs l) G (D.Lf.role l)
        (D.Lf.layers l) (A.blkStart D.S.K I.1) D.S.K))),
    ae_restrict_of_ae (physEmbed_coeFn (W := bf.Lab ⊕ Fin fp.Mc) (fp.frozenZ l (D.cat l)
      (D.mbs l) G (D.Lf.role l) (D.Lf.layers l) (A.blkStart D.S.K I.1 - 4 * D.S.K))),
    ae_restrict_of_ae (physEmbed_coeFn (W := bf.Lab ⊕ Fin fp.Mc) (fp.frozenLift (L l G) l
      (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l) (A.blkStart D.S.K I.1) D.S.K))]
    with y h1 h2 h3
  rw [h1, Pi.sub_apply, h2, h3, ← sub_smul]
  simp [norm_smul]

open Classical in
/-- Blueprint `eq:physical-error` on the leaf: the physical errors of the retained cells, summed
over their groups and slots, are bounded by the physical errors of the actual uses of
`exists_leaf_modes` (the uses `I ∈ S` with `G ∈ gs I`). -/
theorem errAt_energy_le (qG : bf.Grp → ℕ) (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md)
    (S : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset bf.Grp) (gset : Finset bf.Grp)
    (hgs : ∀ I ∈ S, gs I ⊆ gset) {E : ℝ}
    (hE : ∑ l, ∑ G ∈ gset, ∑ I ∈ S.filter (fun I => G ∈ gs I), ∫ y in dyadicGridCell A.G I.1 I.2,
      ‖(fp.physError (D.Ms l G) (L l G) l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l)
        D.S.K (A.blkStart D.S.K I.1) : ℝ → ColumnHilbert (bf.Lab ⊕ Fin fp.Mc)) y none‖ ^ 2 ≤ E) :
    ∑ I ∈ S, ∑ G ∈ gs I, ∑ l, ‖(D.withQ0 (qG G)).errAt L l G I‖ ^ 2 ≤ E := by
  set! f : Fin 4 → bf.Grp → ℤ × ℤ → ℝ := fun l G I => ∫ y in dyadicGridCell A.G I.1 I.2,
    ‖(fp.physError (D.Ms l G) (L l G) l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l)
      D.S.K (A.blkStart D.S.K I.1) : ℝ → ColumnHilbert (bf.Lab ⊕ Fin fp.Mc)) y none‖ ^ 2
    with hf
  have hcomm : ∑ I ∈ S, ∑ G ∈ gs I, ∑ l, f l G I =
      ∑ l, ∑ G ∈ gset, ∑ I ∈ S.filter (fun I => G ∈ gs I), f l G I := by
    rw [Finset.sum_comm' (t' := gset) (s' := fun G => S.filter (fun I => G ∈ gs I))
      (fun I G => ⟨fun ⟨hI, hG⟩ => ⟨Finset.mem_filter.mpr ⟨hI, hG⟩, hgs I hI hG⟩,
        fun ⟨hI, _⟩ => ⟨(Finset.mem_filter.mp hI).1, (Finset.mem_filter.mp hI).2⟩⟩)]
    rw [← Finset.sum_comm]
    refine Finset.sum_congr rfl fun G _ => ?_
    exact Finset.sum_comm
  calc ∑ I ∈ S, ∑ G ∈ gs I, ∑ l, ‖(D.withQ0 (qG G)).errAt L l G I‖ ^ 2
      ≤ ∑ I ∈ S, ∑ G ∈ gs I, ∑ l, f l G I :=
        Finset.sum_le_sum fun I _ => Finset.sum_le_sum fun G _ => Finset.sum_le_sum fun l _ =>
          D.errAt_sq_le (qG G) L l G I
    _ = _ := hcomm
    _ ≤ E := hE


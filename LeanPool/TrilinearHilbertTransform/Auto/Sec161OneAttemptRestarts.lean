  q_sum := fun _ => by simp
  εM_nonneg := fun m => m.elim
  weights := fun _ _ => by simp

/-- The mode system without modes (for groups without an actual use, which never enter a sum). -/
noncomputable def ModeSystem.empty (Gd : RealDyadicGrid) (Mc : ℕ) : ModeSystem Gd Mc where
  Md := Empty
  L := LiftData.empty (Fin Mc)
  zc := ⟨0, Fin.elim0, 0, 0⟩
  δc := 1

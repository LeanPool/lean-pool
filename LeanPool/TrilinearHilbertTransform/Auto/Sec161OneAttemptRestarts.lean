open Classical in
/-- A group with an actual use has a center with nonnegative top score (blueprint line 1934). -/
theorem center_of_actualUse {G : bf.Grp} {I : ℤ × ℤ} (h : fp.ActualUse G I) :
    ∃ ρ₀ z g, G.2.1 = some (ρ₀, z, g) ∧ 0 ≤ g := by
  obtain ⟨-, x, hx, hs, hG⟩ := h
  obtain ⟨ρ, z, g, m, l, n, ρ', a, g₂, hc, -⟩ := hs
  have h1 : (fp.K.grp bf.admT A.famVtxBound (bf.admAt I) x).2.1 = some (ρ, z, g) := by
    change (fp.K.colorData (bf.admT.st (bf.admAt I)) x).1 = _
    rw [hc]
  refine ⟨ρ, z, g, ?_, fp.K.grp_top_nonneg bf.admT hx h1⟩
  rw [← hG]; exact h1

/-- The curvature bound `B = exp(D X^D)` of the modes of a group with top score `g` at the ball
level `j` (`exists_mainModeSystem`). -/
noncomputable def modeBd (D dB : ℕ) (H : ℝ) (g : ℤ) (j : ℕ) : ℝ :=
  Real.exp (D * (1 + Real.log (chartTranslationBudget (H ^ 6)) +
    Real.log (3 * fp.ballEdgeH dB (fp.ballRadius g (fp.bbase j + fp.P)))) ^ D)

open Classical in
/-- The exports of `exists_mainModeSystem` for the role `l` (catalog `s`, ball level `j`) and the
group `G` (center `z`, top score `g`), at the cutoff width `δ`, the correction size `δ_c` and an
offset in the unit cube (blueprint lines 1932-1940 and 1971-1975). -/
def ModeExports (l : Fin 4) (s : List (CatCol bf.Vtx)) (G : bf.Grp) (j : ℕ) (d : bf.Vtx)
    (D dB : ℕ) (H δ δc N : ℝ) {n : ℕ} (Ms : ModeSystem A.G n)
    (L : LiftData (bf.Lab ⊕ Fin fp.Mc) Ms.Md) : Prop :=
  ∃ ρ₀ z g, G.2.1 = some (ρ₀, z, g) ∧ 0 ≤ g ∧
    fp.MainLiftExports l s G j d D dB H g L Ms.wave Ms.cellOf ∧
    (∀ m, L.εM m = Ms.L.εM m) ∧ (∀ m m', Ms.L.own m = Ms.L.own m' ↔ L.own m = L.own m') ∧
    L.δ = δc ∧
    (∃ ρ : Fin (bf.vtag z).dim → ℝ, (∀ i, ρ i ∈ Set.Icc (0 : ℝ) 1) ∧
      ∀ y, L.s y = ((centerCut (bf.vtag z) δ ρ y : ℝ) : ℂ) ^ 2) ∧
    (∀ y, ∑ Φ, ‖L.q Φ y‖ ^ 2 / L.εP Φ ≤ δc ^ 2 * N * A.colBudget ^ 2) ∧
    Ms.zc = bf.vtag z ∧ Ms.δc = δ ∧ Ms.cl = slotCoeff l ∧ (∀ i, Ms.ρ i ∈ Set.Icc (0 : ℝ) 1) ∧
    Ms.Λ = fp.modeBd D dB H g j ∧
    Ms.Bσ = max 1 (fp.modeBd D dB H g j * (1 + 4 * (2 * dB + 1) *
      max 1 (4 * fp.modeBd D dB H g j / δc))) ∧ (∀ p, Ms.dvOf p ≤ dB) ∧
    (∀ m, (Ms.L.εM m)⁻¹ ≤ A.colBudget ^ 2 * (fp.modeBd D dB H g j ^ 2 + 1)) ∧
    (∀ y, ((Finset.univ.filter fun m =>
        y ∈ dyadicGridCell A.G (Ms.cellOf m).1 (Ms.cellOf m).2).card : ℝ) ≤
      N * (fp.modeBd D dB H g j *
        (4 * max 1 (4 * fp.modeBd D dB H g j / δc) + 1) ^ (4 * dB))) ∧
    ∀ U : ℤ × ℤ, ((Ms.alive U).card : ℝ) ≤
      N * (fp.modeBd D dB H g j * (4 * max 1 (4 * fp.modeBd D dB H g j / δc) + 1) ^ (4 * dB))

end ActiveSetup.BasicFamilies.FamParams

open Classical in
/-- Blueprint line 2839 (the offsets, by the measurable majorant on pre-existing main uses; the
corresponding fixed modes), with lines 2135-2156: on one search leaf (catalogs `cat l` with main
budgets, ball levels `j_l` and shared histories of the four roles) and a finite set of groups with
actual uses, whose actual main uses `U_{l,G}` (fixed before the offsets) have at most `N_use`
members through each point, there are mode systems and lifts of every role and group such that
each group of the set has the exports of `exists_mainModeSystem` at one common offset per role and
group, chosen by the explicit majorant of `physical_error_used`, and the physical errors of
`eq:physical-error` satisfy
`Σ_l Σ_G Σ_{I ∈ U_{l,G}} ∫_I |E_{l,G,b(I)}|² ≤ (8 d_B δ + 2 δ_c²) 4 N colBudget² C_F N_use |R|`.
Classical choice is used only after the offsets are selected; groups outside the set get the empty
mode system. -/
theorem exists_leaf_modes (κ : LocalKernelClass) (c₀ : ℕ) :
    ∃ D : ℕ, 1 ≤ D ∧ ∀ (A : ActiveSetup κ c₀) (bf : A.BasicFamilies) (fp : bf.FamParams)
      (cat : Fin 4 → List (CatCol bf.Vtx))
      (_hT : ∀ l, ∀ e ∈ cat l, ∃ R ∈ residueBox (bf.vtag e.tag).dim 9, ∃ γ : ℝ,
        e = templateCol (bf.vtag e.tag) l R γ e.birth e.rank e.tag)
      (_htag : ∀ l, ∀ e ∈ cat l, bf.occAvail e.tag.2.1 e.tag.1)
      (mbs : ∀ l, bf.MainBudget (cat l)) (jj : Fin 4 → ℕ) (lsi : Fin 4 → List (ℕ × Bool))
      (d : bf.Vtx) (gset : Finset bf.Grp) (_hgset : ∀ G ∈ gset, ∃ I, fp.ActualUse G I)
      (_hanc : A.AncClosed) {K : ℕ} (blk : ℤ × ℤ → ℤ)
      (_hblk : ∀ I : ℤ × ℤ, blk I ≤ I.1 ∧ I.1 < blk I + K)
      (U : Fin 4 → bf.Grp → Finset (ℤ × ℤ)) (_hU : ∀ l G, ∀ I ∈ U l G, fp.ActualUse G I)
      {Nuse : ℕ} (_hpath : ∀ y, ∑ l, ∑ G ∈ gset,
        ((U l G).filter fun I : ℤ × ℤ => y ∈ dyadicGridCell A.G I.1 I.2).card ≤ Nuse)
      (_hHed : 2 ≤ fp.Hed) {dB : ℕ} (_hdim : ∀ w : bf.Vtx, (bf.vtag w).dim ≤ dB)
      (_hC : ∀ (w : bf.Vtx) a c, (rationalHeight ((bf.vtag w).C a c) : ℝ) ≤ fp.Hed)
      {δ : ℝ} (_hδ : 0 < δ) (_hδ' : δ ≤ 1 / 8) (_hdδ : 8 * dB * δ ≤ 1) {H : ℝ}
      (_hHs : A.Hsrc ≤ H) (_hdz : (dB : ℝ) ≤ Real.log H)
      (_hCz : ∀ (w : bf.Vtx) (l : Fin 4) i k,
        (chartRationalHeight ((((-slotCoeff l : ℤ) : ℚ) • (bf.vtag w).C) i k) : ℝ) ≤ H)
      (_hHδ : (dB : ℝ) * (bumpConst * 8 ^ 32 * (2 / δ)) ≤ H) {δc : ℝ} (_hδc : 0 < δc)
      {N CF : ℝ} (_hN0 : 0 ≤ N) (_hCF : 0 ≤ CF)
      (_hN : ∀ l, ∀ I ∈ A.cells,
        ((mainLabels A.G fp.Mc (bf.origCols l) (cat l) I (fp.brank (jj l))).card : ℝ) ≤ N)
      (_hδcN : δc ^ 2 * N * A.colBudget ^ 2 ≤ 1)
      (_hnorm : ∀ (l : Fin 4) (jb : Fin 2), ∀ V ∈ A.cells, ‖columnL2Restriction
        (dyadicGridCell A.G V.1 V.2) (dyadicGridCell_measurable A.G V.1 V.2) (bf.P l jb).Z‖ ^ 2 ≤
          CF * dyadicGridLength A.G V.1),
      ∃ (Ms : Fin 4 → bf.Grp → ModeSystem A.G (Fintype.card (bf.Lab ⊕ Fin fp.Mc)))
        (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (Ms l G).Md),
        (∀ l, ∀ G ∈ gset, fp.ModeExports l (cat l) G (jj l) d D dB H δ δc N (Ms l G) (L l G)) ∧
        (∀ l G, G ∉ gset → (∀ p, (Ms l G).dvOf p + (Ms l G).zc.dim ≤ 2 * dB + 2) ∧
          (Ms l G).Bσ = 1 ∧ ∀ V : ℤ × ℤ, (Ms l G).alive V = ∅) ∧
        ∑ l, ∑ G ∈ gset, ∑ I ∈ U l G, ∫ y in dyadicGridCell A.G I.1 I.2,
            ‖(fp.physError (Ms l G) (L l G) l (cat l) (mbs l) G (jj l) (lsi l) K (blk I) :
              ℝ → ColumnHilbert (bf.Lab ⊕ Fin fp.Mc)) y none‖ ^ 2 ≤
          (8 * dB * δ + 2 * δc ^ 2) * (4 * N * A.colBudget ^ 2 * CF) * Nuse *
            dyadicGridLength A.G A.R.1 := by
  obtain ⟨D, hD, hex⟩ := exists_mainModeSystem κ c₀
  refine ⟨D, hD, ?_⟩
  intro A bf fp cat hT htag mbs jj lsi d gset hgset hanc K blk hblk U hU Nuse hpath hHed dB hdim
    hC δ hδ hδ' hdδ H hHs hdz hCz hHδ δc hδc N CF hN0 hCF hN hδcN hnorm
  set n := Fintype.card (bf.Lab ⊕ Fin fp.Mc)
  -- the offsets, by the majorant of the physical errors
  set! zc : Fin 4 × gset → ChartTag := fun i => bf.vtag (bf.grpCenter d i.2.1) with hzc
  have hpath' : ∀ y, ∑ i : Fin 4 × gset, ((U i.1 i.2.1).filter fun I : ℤ × ℤ =>
      y ∈ dyadicGridCell A.G I.1 I.2).card ≤ Nuse := fun y => by
    rw [Fintype.sum_prod_type]
    refine le_of_eq_of_le (Finset.sum_congr rfl fun l _ => ?_) (hpath y)
    exact Finset.sum_coe_sort gset (fun G => ((U l G).filter fun I : ℤ × ℤ =>
      y ∈ dyadicGridCell A.G I.1 I.2).card)
  obtain ⟨ρ, hρ, herr⟩ := fp.physical_error_used (ι := Fin 4 × gset) (fun i => i.1)
    (fun i => cat i.1) (fun i => mbs i.1) (fun i => i.2.1) (fun i => jj i.1) (fun i => lsi i.1)
    (fun _ => d) zc hanc blk hblk (fun i => U i.1 i.2.1) (fun i I hI => hU i.1 i.2.1 I hI)
    hpath' hδ hδ'
    (dmax := dB) (fun i => hdim _) hdδ hN0 hCF (fun i I hI => hN i.1 I hI) hnorm
  -- the mode systems at the selected offsets
  have hone : ∀ (l : Fin 4) (G : bf.Grp) (hG : G ∈ gset),
      ∃ p : Σ Ms : ModeSystem A.G n, LiftData (bf.Lab ⊕ Fin fp.Mc) Ms.Md,
        fp.ModeExports l (cat l) G (jj l) d D dB H δ δc N p.1 p.2 ∧
        (∀ m, p.2.εP m = mainWeight fp.Mc (bf.origCols l) m) ∧ p.2.δ = δc ∧
        ∀ y, p.2.s y = ((centerCut (zc (l, ⟨G, hG⟩)) δ (ρ (l, ⟨G, hG⟩)) y : ℝ) : ℂ) ^ 2 := by
    intro l G hG
    obtain ⟨I, hI⟩ := hgset G hG
    obtain ⟨ρ₀, z, g, hGz, hg⟩ := fp.center_of_actualUse hI
    have hz : bf.grpCenter d G = z := by simp [ActiveSetup.BasicFamilies.grpCenter, hGz]
    subst hz
    have hdz' : ((bf.vtag (bf.grpCenter d G)).dim : ℝ) ≤ Real.log H :=
      le_trans (by exact_mod_cast hdim _) hdz
    have hHδ' : ((bf.vtag (bf.grpCenter d G)).dim : ℝ) * (bumpConst * 8 ^ 32 * (2 / δ)) ≤ H := by
      refine le_trans ?_ hHδ
      have := one_le_bumpConst
      gcongr
      exact_mod_cast hdim _
    obtain ⟨Ms, L, hexp, hεM, hown, hLδ, hs, hq, hzc', hδc', hcl, hρM, hΛ, hBσ, hdv, hεinv, hpt,
      hal⟩ :=
      hex A bf fp l (cat l) (hT l) (htag l) d (G := G) (j := jj l) hGz hg hHed hdim hC hδ
        (by linarith) (ρ (l, ⟨G, hG⟩)) (hρ (l, ⟨G, hG⟩)) hHs hdz' (hCz _ l) hHδ' hδc hN0
        (hN l) hδcN
    exact ⟨⟨Ms, L⟩, ⟨ρ₀, bf.grpCenter d G, g, hGz, hg, hexp, hεM, hown, hLδ,
      ⟨ρ (l, ⟨G, hG⟩), hρ (l, ⟨G, hG⟩), hs⟩, hq, hzc', hδc', hcl, hρM, hΛ, hBσ, hdv, hεinv, hpt,
      hal⟩,
      hexp.εP_eq, hLδ, hs⟩
  choose P hP using hone
  let MsL : Fin 4 → bf.Grp → Σ Ms : ModeSystem A.G n, LiftData (bf.Lab ⊕ Fin fp.Mc) Ms.Md :=
    fun l G => if hG : G ∈ gset then P l G hG else
      ⟨ModeSystem.empty A.G n, LiftData.empty (bf.Lab ⊕ Fin fp.Mc)⟩
  have hMsL : ∀ l G (hG : G ∈ gset), MsL l G = P l G hG := fun l G hG => dite_eq_left hG
  refine ⟨fun l G => (MsL l G).1, fun l G => (MsL l G).2, fun l G hG => ?_, fun l G hG => ?_, ?_⟩
  · change fp.ModeExports l (cat l) G (jj l) d D dB H δ δc N (MsL l G).1 (MsL l G).2
    rw [hMsL l G hG]
    exact (hP l G hG).1
  · have e : MsL l G = ⟨ModeSystem.empty A.G n, LiftData.empty (bf.Lab ⊕ Fin fp.Mc)⟩ :=
      dite_eq_right hG
    have key : ∀ x : (Σ Ms : ModeSystem A.G n, LiftData (bf.Lab ⊕ Fin fp.Mc) Ms.Md),
        x = ⟨ModeSystem.empty A.G n, LiftData.empty (bf.Lab ⊕ Fin fp.Mc)⟩ →
        (∀ p, x.1.dvOf p + x.1.zc.dim ≤ 2 * dB + 2) ∧ x.1.Bσ = 1 ∧
          ∀ V : ℤ × ℤ, x.1.alive V = ∅ := by
      rintro _ rfl
      exact ⟨fun p => p.elim, rfl,
        fun V => Finset.eq_empty_of_forall_notMem fun m _ => Empty.elim m⟩
    exact key _ e
  · have h := herr (fun i => (MsL i.1 i.2.1).1) (fun i => (MsL i.1 i.2.1).2)
      (fun i m => by
        rw [hMsL i.1 i.2.1 i.2.2]
        exact (hP i.1 i.2.1 i.2.2).2.1 m)
      (fun i y => by
        rw [hMsL i.1 i.2.1 i.2.2]
        exact (hP i.1 i.2.1 i.2.2).2.2.2 y)
      (fun i => by
        rw [hMsL i.1 i.2.1 i.2.2]
        exact (hP i.1 i.2.1 i.2.2).2.2.1)
    rw [Fintype.sum_prod_type] at h
    refine le_of_eq_of_le (Finset.sum_congr rfl fun l _ => ?_) h
    exact (Finset.sum_coe_sort gset (fun G => ∑ I ∈ U l G, ∫ y in dyadicGridCell A.G I.1 I.2,
      ‖(fp.physError (MsL l G).1 (MsL l G).2 l (cat l) (mbs l) G (jj l) (lsi l) K (blk I) :
        ℝ → ColumnHilbert (bf.Lab ⊕ Fin fp.Mc)) y none‖ ^ 2)).symm

/-- An image of a finite set is not larger than a second image when the second map determines the
first on the set. -/
theorem card_image_le_of_factor {α β γ : Type*} [DecidableEq β] [DecidableEq γ] (s : Finset α)
    (f : α → β) (g : α → γ) (h : ∀ a ∈ s, ∀ b ∈ s, g a = g b → f a = f b) :
    (s.image f).card ≤ (s.image g).card := by
  rcases s.eq_empty_or_nonempty with h0 | ⟨a₀, -⟩
  · simp [h0]
  have : Nonempty α := ⟨a₀⟩
  have hw : ∀ b ∈ s.image f, ∃ a ∈ s, f a = b := fun b hb => Finset.mem_image.mp hb
  choose! w hws hwf using hw
  refine Finset.card_le_card_of_injOn (fun b => g (w b))
    (fun b hb => Finset.mem_image_of_mem g (hws b hb)) ?_
  intro b hb b' hb' heq
  rw [← hwf b hb, ← hwf b' hb']
  exact h _ (hws b hb) _ (hws b' hb') heq

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

open Classical in
/-- The keys of the modes alive on a cell number at most `N`, the number of main labels of the
role at every active cell: a key is determined by the primary and the first-match cell of its
modes, the first-match cells of one primary are disjoint, and all these primaries are primaries at
the deepest of these first-match cells (`primaries_of_firstCell`, blueprint line 1888: "the mode
lists, including primaries whose coefficients are zero, are nested"). -/
theorem alive_keys_le {l : Fin 4} {s : List (CatCol bf.Vtx)} {G : bf.Grp} {j : ℕ} {d : bf.Vtx}
    {D dB : ℕ} {H : ℝ} {g : ℤ} {n : ℕ} {Ms : ModeSystem A.G n}
    {L : LiftData (bf.Lab ⊕ Fin fp.Mc) Ms.Md}
    (hex : fp.MainLiftExports l s G j d D dB H g L Ms.wave Ms.cellOf)
    (hown : ∀ m m', Ms.L.own m = Ms.L.own m' ↔ L.own m = L.own m') {N : ℝ} (hN0 : 0 ≤ N)
    (hN : ∀ I ∈ A.cells,
      ((mainLabels A.G fp.Mc (bf.origCols l) s I (fp.brank j)).card : ℝ) ≤ N)
    (U : ℤ × ℤ) : (((Ms.alive U).image Ms.keyOf).card : ℝ) ≤ N := by
  rcases (Ms.alive U).eq_empty_or_nonempty with h0 | hne
  · rw [h0]; simpa using hN0
  obtain ⟨m₀, hm₀, hmax⟩ := Finset.exists_max_image (Ms.alive U) (fun m => (Ms.cellOf m).1) hne
  have hfirst := hex.first
  have hI₀ : Ms.cellOf m₀ ∈ A.cells :=
    (Finset.mem_filter.mp (mem_maxCells.mp (hfirst m₀)).1).1
  have hy := dyadicGridCell_left_mem A.G U.1 U.2
  have hprim : ∀ m ∈ Ms.alive U, L.own m ∈ fp.primaries l s G j d (Ms.cellOf m₀) := by
    intro m hm
    have hsub := dyadicGridCell_subset_of_common_point A.G (Ms.mem_alive.mp hm₀ hy)
      (Ms.mem_alive.mp hm hy) (hmax m hm)
    exact fp.primaries_of_firstCell A.cells subset_rfl l s G j d (hfirst m) hI₀ hsub
  have hkey : ∀ m ∈ Ms.alive U, ∀ m' ∈ Ms.alive U, L.own m = L.own m' →
      Ms.keyOf m = Ms.keyOf m' := by
    intro m hm m' hm' h
    have h' : Ms.cellOf m' ∈ fp.firstCells A.cells l s G j d (L.own m) := by
      rw [h]; exact hfirst m'
    have hc := fp.firstCell_unique A.cells l s G j d (hfirst m) h' (Ms.mem_alive.mp hm hy)
      (Ms.mem_alive.mp hm' hy)
    exact Ms.own_cell_key m m' ((hown m m').mpr h) hc
  have h1 := card_image_le_of_factor (Ms.alive U) Ms.keyOf L.own hkey
  have h2 : ((Ms.alive U).image L.own).card ≤
      (mainLabels A.G fp.Mc (bf.origCols l) s (Ms.cellOf m₀) (fp.brank j)).card := by
    refine Finset.card_le_card fun v hv => ?_
    obtain ⟨m, hm, rfl⟩ := Finset.mem_image.mp hv
    exact mainLabelsM_subset _ _ _ _ _ (hprim m hm)
  exact le_trans (by exact_mod_cast h1.trans h2) (hN _ hI₀)

open Classical in
/-- The schedule conditions on the mode systems of one attempt (blueprint lines 1934 and 1944): for
the exports of a role and group at a ball level `j ≤ 4`, the dimensions are at most
`d_max = 2 d_B + 2`; the enlarged budget `D_* = modeStarG` bounds the curvature bound, the gauge
norm `(ζ^ρ)²`, the inverse private weights and the alive modes; the truncation exponent `K_*`
makes the gauge tails at most `D_*^(-300)`; and the keys alive on a cell number at most `N`. -/
theorem ModeExports.sched {l : Fin 4} {s : List (CatCol bf.Vtx)} {G : bf.Grp} {j : ℕ}
    (hj : j ≤ 4) {d : bf.Vtx} {D dB : ℕ} {H δ δc N : ℝ} (k : ℝ) {n : ℕ} {Ms : ModeSystem A.G n}
    {L : LiftData (bf.Lab ⊕ Fin fp.Mc) Ms.Md}
    (hE : fp.ModeExports l s G j d D dB H δ δc N Ms L) (hδ : 0 < δ) (hδ1 : δ ≤ 1)
    (hHed : 2 ≤ fp.Hed) (hH : 1 ≤ H) (hδc : 0 < δc) (hN0 : 0 ≤ N)
    (hdim : ∀ w : bf.Vtx, (bf.vtag w).dim ≤ dB)
    (hN : ∀ I ∈ A.cells,
      ((mainLabels A.G fp.Mc (bf.origCols l) s I (fp.brank j)).card : ℝ) ≤ N) :
    (∀ p, Ms.dvOf p + Ms.zc.dim ≤ 2 * dB + 2) ∧
      Ms.Λ ≤ fp.modeStarG D dB H δc N k δ ∧
      gaugeSqNorm Ms.zc.dim Ms.δc ≤ fp.modeStarG D dB H δc N k δ ∧
      2 * gaugeTail Ms.zc.dim Ms.δc / 2 ^ fp.Kstar D dB H δc N k δ *
        fp.modeStarG D dB H δc N k δ ^ 300 ≤ 1 ∧
      (∀ m, (fp.modeStarG D dB H δc N k δ)⁻¹ ≤ Ms.L.εM m) ∧
      (∀ U : ℤ × ℤ, ((Ms.alive U).card : ℝ) ≤ fp.modeStarG D dB H δc N k δ) ∧
      ∀ U : ℤ × ℤ, (((Ms.alive U).image Ms.keyOf).card : ℝ) ≤ N := by
  obtain ⟨ρ₀, z, g, hGz, hg, hexp, -, hown, -, -, -, hzc, hδc', -, -, hΛ, -, hdv, hεinv, -, hal⟩ :=
    hE
  obtain ⟨-, hB, -, -, -, hcol, -, hNB, -⟩ := fp.le_modeStar D dB k hHed hH hδc hN0 hg hj
  obtain ⟨-, hst, -, hgs, -⟩ := fp.le_modeStarG D dB k hδ hHed hH hδc hN0
  have hzd : Ms.zc.dim ≤ dB := by rw [hzc]; exact hdim z
  have hBe : fp.modeBd D dB H g j = Real.exp (D * (1 + Real.log (chartTranslationBudget (H ^ 6)) +
      Real.log (3 * fp.ballEdgeH dB (fp.ballRadius g (fp.bbase j + fp.P)))) ^ D) := rfl
  have hDs : 0 < fp.modeStarG D dB H δc N k δ :=
    lt_of_lt_of_le (Real.exp_pos k) (fp.le_modeStarG D dB k hδ hHed hH hδc hN0).1
  refine ⟨fun p => by have := hdv p; omega, ?_, ?_, ?_, fun m => ?_, fun U => ?_,
    fp.alive_keys_le hexp hown hN0 hN⟩
  · rw [hΛ, hBe]; exact hB.trans hst
  · rw [hδc']
    exact (gaugeSqNorm_mono hδ hδ1 hzd).trans hgs
  · rw [hδc']
    have hT0 := gaugeTail_nonneg Ms.zc.dim hδ
    have hT : gaugeTail Ms.zc.dim δ ≤ fp.tailStar dB δ := by
      unfold tailStar
      have := gaugeMultTail_nonneg dB (Q0 := fp.Hed ^ (dB * dB)) (Cm := fp.Hed) (half_pos hδ)
        (pow_nonneg (by linarith) _) (by linarith)
      linarith [gaugeTail_mono hδ hδ1 hzd]
    have h := fp.tail_le_Kstar D dB k hδ hHed hH hδc hN0 hT0 hT
    have hp : 0 < fp.modeStarG D dB H δc N k δ ^ 300 := pow_pos hDs 300
    calc 2 * gaugeTail Ms.zc.dim δ / 2 ^ fp.Kstar D dB H δc N k δ *
          fp.modeStarG D dB H δc N k δ ^ 300
        ≤ (fp.modeStarG D dB H δc N k δ ^ 300)⁻¹ * fp.modeStarG D dB H δc N k δ ^ 300 :=
          mul_le_mul_of_nonneg_right h hp.le
      _ = 1 := inv_mul_cancel₀ hp.ne'
  · have hε := Ms.εM_pos m
    have h1 : (Ms.L.εM m)⁻¹ ≤ fp.modeStarG D dB H δc N k δ := by
      refine (hεinv m).trans ?_
      rw [hBe]; exact hcol.trans hst
    rw [inv_le_comm₀ hDs hε]
    exact h1
  · refine (hal U).trans ?_
    rw [hBe]; exact hNB.trans hst

end ActiveSetup.BasicFamilies.FamParams

/-- An ancestor of a cell in the admission tree contains it (the converse of `admTree_anc`). -/
theorem admTree_anc_cell {G : RealDyadicGrid} {R : ℤ × ℤ} {N : ℕ} {Λ : Type*} [Fintype Λ]
    (av : ℤ × ℤ → Λ → Prop) {I J : AdmCell G R N} (h : (admTree av).Anc (some J) (some I)) :
    dyadicGridCell G I.1.1 I.1.2 ⊆ dyadicGridCell G J.1.1 J.1.2 := by
  obtain ⟨n, hn⟩ := h
  induction n generalizing I with
  | zero =>
    have hIJ : I = J := Option.some_injective _ hn
    rw [hIJ]
  | succ n ih =>
    change (admTree av).par^[n] ((admTree av).par (some I)) = some J at hn
    by_cases hIR : I.1 = R
    · have hpar : (admTree av).par (some I) = (none : Option (AdmCell G R N)) := by
        change admPar (some I) = none
        simp only [admPar, hIR, ↓reduceDIte]
      have hfix : (admTree av).par (none : Option (AdmCell G R N)) = none := rfl
      rw [hpar, Function.iterate_fixed hfix] at hn
      exact absurd hn (by simp)
    · set P : AdmCell G R N := ⟨dyadicParent G I.1, admParent_mem I hIR⟩ with hP
      have hpar : (admTree av).par (some I) = some P := by
        change admPar (some I) = some P
        simp only [admPar, hIR, ↓reduceDIte]
        rfl
      rw [hpar] at hn
      exact (dyadicParent_subset G I.1).trans (ih hn)

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

open Classical in
/-- A group with a mode through a point has a present central vertex at an active cell containing
the point: the primary of the mode lies in the group's ball mask at its first-match cell, and the
central vertices of a mask are historical (blueprint lines 1807-1808 and 1934). -/
theorem grp_mem_path_of_mode (hanc : A.AncClosed) {l : Fin 4} {s : List (CatCol bf.Vtx)}
    {G : bf.Grp} {j : ℕ} {d : bf.Vtx} {D dB : ℕ} {H : ℝ} {g : ℤ} {n : ℕ}
    {Ms : ModeSystem A.G n} {L : LiftData (bf.Lab ⊕ Fin fp.Mc) Ms.Md}
    (hex : fp.MainLiftExports l s G j d D dB H g L Ms.wave Ms.cellOf) {y : ℝ} {m : Ms.Md}
    (hm : m ∈ Ms.ptSet y) :
    G ∈ ((((A.cells.filter fun I => y ∈ dyadicGridCell A.G I.1 I.2).image bf.admAt) ×ˢ
      (Finset.univ : Finset bf.Vtx)).filter (fun p => p.2 ∈ bf.admT.X p.1)).image
        (fun p => fp.K.grp bf.admT A.famVtxBound p.1 p.2) := by
  have hy := Ms.mem_ptSet.mp hm
  obtain ⟨hI₀, hprim⟩ := Finset.mem_filter.mp (mem_maxCells.mp (hex.first m)).1
  obtain ⟨-, hmask⟩ := mem_mainLabelsM.mp hprim
  obtain ⟨-, c₀, hanc₀, v₀, hv₀, hgrp, -⟩ := hmask
  rw [bf.admAt_of_mem hI₀] at hanc₀
  cases c₀ with
  | none => exact absurd hv₀ (Finset.notMem_empty v₀)
  | some J =>
    have hJ := admTree_anc_cell (G := A.G) (R := A.R) (N := A.treeDepth) bf.occAvail hanc₀
    have hJc : J.1 ∈ A.cells := hanc _ hI₀ J.1 hJ (admCell_sub J)
    refine Finset.mem_image.mpr ⟨(some J, v₀), Finset.mem_filter.mpr
      ⟨Finset.mem_product.mpr ⟨Finset.mem_image.mpr ⟨J.1, Finset.mem_filter.mpr
        ⟨hJc, hJ hy⟩, ?_⟩, Finset.mem_univ _⟩, hv₀⟩, hgrp⟩
    rw [bf.admAt_of_mem hJc]

open Classical in
/-- Blueprint line 1934 ("all modes ... along a path across groups"): for the mode systems of the
groups of a finite set at one role and ball level `j ≤ 4`, the modes through any point number at
most `D_* = modeStarG`: at most `D (potMax + 1)` groups have a central vertex on the path
(`card_groups_path_le`), and each has at most `N B (4 max(1, 4B/δ_c) + 1)^(4 d_B)` modes through
the point, `B ≤ exp(D X_max^D)`. -/
theorem modes_path_le (hanc : A.AncClosed) {l : Fin 4} {s : List (CatCol bf.Vtx)} {j : ℕ}
    (hj : j ≤ 4) {d : bf.Vtx} {D dB : ℕ} {H δ δc N : ℝ} (k : ℝ) (gset : Finset bf.Grp) {n : ℕ}
    (Ms : bf.Grp → ModeSystem A.G n) (L : ∀ G, LiftData (bf.Lab ⊕ Fin fp.Mc) (Ms G).Md)
    (hE : ∀ G ∈ gset, fp.ModeExports l s G j d D dB H δ δc N (Ms G) (L G))
    (hδ : 0 < δ) (hHed : 2 ≤ fp.Hed) (hH : 1 ≤ H) (hδc : 0 < δc) (hN0 : 0 ≤ N) (y : ℝ) :
    (∑ G ∈ gset, ((Ms G).ptSet y).card : ℝ) ≤ fp.modeStarG D dB H δc N k δ := by
  set! Gy := ((((A.cells.filter fun I => y ∈ dyadicGridCell A.G I.1 I.2).image bf.admAt) ×ˢ
      (Finset.univ : Finset bf.Vtx)).filter (fun p => p.2 ∈ bf.admT.X p.1)).image
        (fun p => fp.K.grp bf.admT A.famVtxBound p.1 p.2) with hGy
  have hcard := fp.card_groups_path_le y
  set! Bm := Real.exp (D * fp.Xmax dB H ^ D) with hBm
  set! Mb := N * (Bm * (4 * max 1 (4 * Bm / δc) + 1) ^ (4 * dB)) with hMb
  have hper : ∀ G ∈ gset, (((Ms G).ptSet y).card : ℝ) ≤ Mb := by
    intro G hG
    obtain ⟨ρ₀, z, g, -, hg, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hpt, -⟩ := hE G hG
    refine (hpt y).trans ?_
    have hX1 := fp.one_le_X hHed dB hH (fp.ballRadius g (fp.bbase j + fp.P))
    have hXm := fp.X_le_Xmax hHed dB H hg hj
    have hBB : fp.modeBd D dB H g j ≤ Bm := by
      unfold modeBd
      exact Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (by linarith) hXm D) (Nat.cast_nonneg _))
    have hB0 : 0 ≤ fp.modeBd D dB H g j := (Real.exp_pos _).le
    rw [hMb]
    gcongr
  have hsupp : ∀ G ∈ gset, (((Ms G).ptSet y).card : ℝ) ≠ 0 → G ∈ Gy := by
    intro G hG h0
    obtain ⟨m, hm⟩ := Finset.card_ne_zero.mp (by exact_mod_cast h0)
    obtain ⟨ρ₀, z, g, -, -, hexp, -⟩ := hE G hG
    exact fp.grp_mem_path_of_mode hanc hexp hm
  have hMb0 : 0 ≤ Mb := by positivity
  have hstar : (A.famVtxBound : ℝ) * (fp.K.potMax A.famVtxBound + 1) * Mb ≤
      fp.modeStar D dB H δc N k := by
    have hmax : 0 ≤ max 1 (4 * Bm / δc) := le_trans zero_le_one (le_max_left _ _)
    have h1 : (A.famVtxBound : ℝ) * (fp.K.potMax A.famVtxBound + 1) * Mb ≤
        A.famVtxBound * (fp.K.potMax A.famVtxBound + 1) * (N + 1) *
          (Bm * (4 * max 1 (4 * Bm / δc) + 1) ^ (4 * dB)) := by
      rw [hMb]
      have : (0 : ℝ) ≤ A.famVtxBound * (fp.K.potMax A.famVtxBound + 1) := by positivity
      have : (0 : ℝ) ≤ Bm * (4 * max 1 (4 * Bm / δc) + 1) ^ (4 * dB) := by positivity
      nlinarith
    have hcb := two_le_colBudget (A := A)
    unfold modeStar
    have : (0 : ℝ) ≤ Bm * (1 + 4 * (2 * dB + 1) * max 1 (4 * Bm / δc)) := by positivity
    have : (0 : ℝ) ≤ A.colBudget ^ 2 * (Bm ^ 2 + 1) := by positivity
    have : (0 : ℝ) ≤ (Real.sqrt N + 1) * A.colBudget * Bm := by positivity
    have : (0 : ℝ) ≤ fp.Hed ^ (dB * dB) := pow_nonneg (by linarith) _
    have := Real.exp_pos k
    linarith
  obtain ⟨-, hst, -, -, -⟩ := fp.le_modeStarG D dB k hδ hHed hH hδc hN0
  calc (∑ G ∈ gset, ((Ms G).ptSet y).card : ℝ)
      = ∑ G ∈ gset.filter (· ∈ Gy), (((Ms G).ptSet y).card : ℝ) := by
        exact (Finset.sum_filter_of_ne fun G hG h0 => hsupp G hG h0).symm
    _ ≤ ∑ _G ∈ gset.filter (· ∈ Gy), Mb :=
        Finset.sum_le_sum fun G hG => hper G (Finset.mem_filter.mp hG).1
    _ = (gset.filter (· ∈ Gy)).card * Mb := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ (A.famVtxBound * (fp.K.potMax A.famVtxBound + 1) : ℕ) * Mb := by
        refine mul_le_mul_of_nonneg_right ?_ hMb0
        exact_mod_cast (Finset.card_le_card fun G hG => (Finset.mem_filter.mp hG).2).trans hcard
    _ ≤ fp.modeStar D dB H δc N k := by push_cast; exact hstar
    _ ≤ fp.modeStarG D dB H δc N k δ := hst

/-- The clearing bound is at most `H_ed^(d_B²) + 1`. -/
theorem Q0bd_le (dB : ℕ) (hHed : 2 ≤ fp.Hed) : (fp.Q0bd dB : ℝ) ≤ fp.Hed ^ (dB * dB) + 1 := by
  unfold Q0bd
  exact (Nat.ceil_lt_add_one (pow_nonneg (by linarith) _)).le

open Classical in
/-- The heights of the rescaled differences of mode differences are covered by the enlarged budget
(blueprint line 1934): for the exports of a role and group at a ball level `j ≤ 4` and a clearing
integer `Q ≤ H_ed^(d_B²) + 1`, `2 (Q (3 B_σ²)²)² ≤ ⌊D_*⌋` (the hypothesis `hBσ` of the
representatives and first top counts). -/
theorem ModeExports.hBσ_le {l : Fin 4} {s : List (CatCol bf.Vtx)} {G : bf.Grp} {j : ℕ}
    (hj : j ≤ 4) {d : bf.Vtx} {D dB : ℕ} {H δ δc N : ℝ} (k : ℝ) {n : ℕ} {Ms : ModeSystem A.G n}
    {L : LiftData (bf.Lab ⊕ Fin fp.Mc) Ms.Md}
    (hE : fp.ModeExports l s G j d D dB H δ δc N Ms L) (hδ : 0 < δ) (hHed : 2 ≤ fp.Hed)
    (hH : 1 ≤ H) (hδc : 0 < δc) (hN0 : 0 ≤ N) {Q : ℝ} (hQ0 : 0 ≤ Q)
    (hQ : Q ≤ fp.Hed ^ (dB * dB) + 1) :
    2 * (Q * (3 * (Ms.Bσ * Ms.Bσ) ^ 2)) ^ 2 ≤ (⌊fp.modeStarG D dB H δc N k δ⌋₊ : ℝ) := by
  obtain ⟨ρ₀, z, g, -, hg, -, -, -, -, -, -, -, -, -, -, -, hBσ, -⟩ := hE
  have hX1 := fp.one_le_X hHed dB hH (fp.ballRadius g (fp.bbase j + fp.P))
  have hXm := fp.X_le_Xmax hHed dB H hg hj
  have hBB : fp.modeBd D dB H g j ≤ Real.exp (D * fp.Xmax dB H ^ D) := by
    unfold modeBd
    exact Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ (by linarith) hXm D) (Nat.cast_nonneg _))
  have hB0 : 0 ≤ fp.modeBd D dB H g j := (Real.exp_pos _).le
  have hBk : Ms.Bσ ≤ fp.keyHgt D dB H δc := by
    rw [hBσ]; unfold keyHgt
    gcongr
  have h1 := Ms.one_le_Bσ
  have hstep : 2 * (Q * (3 * (Ms.Bσ * Ms.Bσ) ^ 2)) ^ 2 ≤ fp.hgtStar D dB H δc - 1 := by
    unfold hgtStar
    have : Q * (3 * (Ms.Bσ * Ms.Bσ) ^ 2) ≤ (fp.Hed ^ (dB * dB) + 1) *
        (3 * (fp.keyHgt D dB H δc * fp.keyHgt D dB H δc) ^ 2) := by
      have := fp.one_le_keyHgt D dB H δc
      gcongr
    have h0 : 0 ≤ Q * (3 * (Ms.Bσ * Ms.Bσ) ^ 2) := by positivity
    have := pow_le_pow_left₀ h0 this 2
    linarith
  obtain ⟨-, -, -, -, hD⟩ := fp.le_modeStarG D dB k hδ hHed hH hδc hN0
  have hfl := (Nat.sub_one_lt_floor (fp.modeStarG D dB H δc N k δ)).le
  linarith

/-- The block start of a cell below the root in block `β < B_n` is one of the block starts
`R + K β`, `β < B_n`. -/
theorem blkStart_mem_blocks {K : ℕ} (hK : 1 ≤ K) {I : ℤ × ℤ} (hIR : A.R.1 ≤ I.1) {Bn : ℕ}
    (hbk : ((I.1 - A.R.1) / K).toNat < Bn) :
    A.blkStart K I.1 ∈ (Finset.range Bn).image (fun β : ℕ => A.R.1 + ((K * β : ℕ) : ℤ)) := by
  have hK0 : (0 : ℤ) < K := by exact_mod_cast hK
  have hq : 0 ≤ (I.1 - A.R.1) / K := Int.ediv_nonneg (by omega) hK0.le
  refine Finset.mem_image.mpr ⟨((I.1 - A.R.1) / K).toNat, Finset.mem_range.mpr hbk, ?_⟩
  unfold ActiveSetup.blkStart
  push_cast
  rw [Int.toNat_of_nonneg hq]

namespace SideInput
variable {fp}

open Classical in
/-- The frozen coefficients of a family of groups give `RepAt` at every cell whose block start is a
block of the family (the first export of `first_top_count_main`, per group with its clearing
integer). -/
theorem repAt_of_family (D : fp.SideInput) (qG : bf.Grp → ℕ)
    (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md) (l : Fin 4) (gset : Finset bf.Grp)
    (Bs : Finset ℤ) (c : ∀ G : gset, ℤ → ℤ × ℤ → (D.Ms l G.1).Md → ℂ)
    (hc : ∀ G (hG : G ∈ gset), D.c l G = c ⟨G, hG⟩)
    (hrep : ∀ G : gset, ∀ b ∈ Bs, ∀ J ∈ fp.retainedV G.1 b D.S.K,
      (D.Ms l G.1).frozenEval (D.S.withQ0 (qG G.1)) b J (c G b J) =
        columnL2Restriction (dyadicGridCell A.G J.1 J.2) (dyadicGridCell_measurable A.G J.1 J.2)
          ((L l G.1).op (fp.frozenZ l (D.cat l) (D.mbs l) G.1 (D.Lf.role l) (D.Lf.layers l)
            (b - 4 * D.S.K))))
    {G : bf.Grp} (hG : G ∈ gset) {I : ℤ × ℤ} (hI : A.blkStart D.S.K I.1 ∈ Bs) :
    (D.withQ0 (qG G)).RepAt L l G I := by
  intro J hJ
  change (D.Ms l G).frozenEval (D.S.withQ0 (qG G)) (A.blkStart D.S.K I.1) J
    (D.c l G (A.blkStart D.S.K I.1) J) = _
  rw [hc G hG]
  exact hrep ⟨G, hG⟩ _ hI J hJ

open Classical in
/-- The linear-side bound of a family of groups over the blocks `R + K β`, `β < B_n`, in the form of
the side input (the hypothesis `hlin` of `core_reduction_leaf`). -/
theorem hlin_of_family (D : fp.SideInput) (qG : bf.Grp → ℕ) (l : Fin 4) (gset : Finset bf.Grp)
    (Bn : ℕ) (c : ∀ G : gset, ℤ → ℤ × ℤ → (D.Ms l G.1).Md → ℂ)
    (hc : ∀ G (hG : G ∈ gset), D.c l G = c ⟨G, hG⟩) {V : ℝ}
    (hVE : ∑ G : gset, ∑ b ∈ (Finset.range Bn).image (fun β : ℕ => A.R.1 + ((D.S.K * β : ℕ) : ℤ)),
      ‖(D.Ms l G.1).blockSide (D.S.withQ0 (qG G.1)) D.hA D.SP b (fp.retainedV G.1 b D.S.K)
        (c G b)‖ ^ 2 ≤ V) :
    ∑ G ∈ gset, ∑ β ∈ Finset.range Bn, ‖(D.Ms l G).blockSide (D.S.withQ0 (qG G)) D.hA D.SP
        (A.R.1 + ((D.S.K * β : ℕ) : ℤ)) (fp.retainedV G (A.R.1 + ((D.S.K * β : ℕ) : ℤ)) D.S.K)
        (D.c l G (A.R.1 + ((D.S.K * β : ℕ) : ℤ)))‖ ^ 2 ≤ V := by
  have hinj : Set.InjOn (fun β : ℕ => A.R.1 + ((D.S.K * β : ℕ) : ℤ)) ↑(Finset.range Bn) := by
    intro β _ β' _ h
    have hK := D.hK
    simp only at h
    have : ((D.S.K * β : ℕ) : ℤ) = ((D.S.K * β' : ℕ) : ℤ) := by linarith
    have h2 : D.S.K * β = D.S.K * β' := by exact_mod_cast this
    exact Nat.eq_of_mul_eq_mul_left (by omega) h2
  refine le_trans (le_of_eq ?_) hVE
  rw [← Finset.sum_coe_sort gset]
  refine Finset.sum_congr rfl fun G _ => ?_
  rw [Finset.sum_image fun β hβ β' hβ' h => hinj hβ hβ' h, hc G.1 G.2]


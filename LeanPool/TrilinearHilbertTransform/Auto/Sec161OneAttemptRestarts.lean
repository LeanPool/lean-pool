namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}

open Classical in
/-- Blueprint lines 2167-2169 with line 1828 ("there are `L + 5` ranks, so the resulting global
trial cap `T = n_{L+5}`"), the helper catalogs of one attempt on the closure counts of its main
catalogs: with the attempt's named-test bound `K_t`, path counts `n_r` (one sequence for the main
ranks `≤ L + 4` and the helper rank `L + 5`) and trial cap `T_max` (`exists_attempt`), the helper
tests of rank `L + 5` on the whole side states close with helper templates such that the main
tests still pass, the ball and cumulative filters are unchanged, and the helper insertions per
active cell number at most `n_{L+5}` (`helper_instantiation_main`, as in `helper_sides`). -/
theorem helper_sides_closure (Dst : ℕ) (fp : bf.FamParams) (Tc : Finset (ℤ × ℤ))
    (hTc : Tc ⊆ A.cells) {cS : ℕ} (hst : SameTagBound κ cS Dst) {HS τ₃ : ℝ} {Mp : ℕ}
    (ι : Type) [Fintype ι] (cat : Fin 4 → List (CatCol bf.Vtx))
    (st : Fin 4 → ι → ℤ × ℤ → ColumnL2 (bf.Lab ⊕ Fin fp.Mc))
    (hside : ∀ l G (I : ℤ × ℤ), MainFresh fp.Mc (cat l).length (columnL2Restriction
      (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2) (st l G I)))
    {Wm : Type} (main : Wm → Fin 4 × (ℤ × ℤ) × MainTest bf.Vtx bf.Lab fp.Mc)
    (hmain : ∀ i, (main i).2.2.r ≤ fp.Lc + 4 ∧ ∀ l < (main i).2.2.m, (main i).2.2.hr l ≤ fp.Lc + 4)
    (τm : Wm → ℝ)
    (hpass : ∀ i, (main i).2.2.Pass A.G (bf.origCols (main i).1) (main i).2.1 cS HS bf.vtag
      (A.w (main i).2.1) (τm i) fp.mH (cat (main i).1))
    (hHS : Real.exp 2 ≤ HS) (hτ : 0 < τ₃) (hMp1 : 1 ≤ Mp) {Kt : ℕ} {n : ℕ → ℝ} {Tmax : ℕ}
    (hKh : ∀ I, Fintype.card (fp.HelperName I ι) ≤ Kt) (hn0 : 2 * A.colBudget ≤ n 0)
    (hgrow : ∀ r, (1 + (fp.Lc + 6) * Mp * closureRatio A.famVtxBound Kt fp.mH Tmax
      (Real.exp (Dst * (1 + Real.log HS) ^ Dst)) τ₃) * n r ≤ n (r + 1))
    (hcapH : closureRatio A.famVtxBound Kt fp.mH Tmax (Real.exp (Dst * (1 + Real.log HS) ^ Dst))
      τ₃ * n (fp.Lc + 4) < Tmax)
    (hMc : ∀ l, (cat l).length + Tc.card * Tmax ≤ fp.Mc) :
    ∃ hcat : Fin 4 → List (CatCol bf.Vtx),
      (∀ l, ∀ I ∈ Tc, ∀ w : fp.HelperName I ι,
        (fp.helperOf l I (fun G => columnL2Restriction (dyadicGridCell A.G I.1 I.2)
          (dyadicGridCell_measurable A.G I.1 I.2) (st l G I)) w).Pass A.G (bf.origCols l) I cS HS
          bf.vtag (A.w I) (catThreshold A.famVtxBound τ₃ n (fp.Lc + 5)) fp.mH
          (cat l ++ hcat l)) ∧
      (∀ i, (main i).2.2.Pass A.G (bf.origCols (main i).1) (main i).2.1 cS HS bf.vtag
        (A.w (main i).2.1) (τm i) fp.mH (cat (main i).1 ++ hcat (main i).1)) ∧
      (∀ l I G j, j ≤ 4 → fp.ballFilt l (cat l ++ hcat l) I G j = fp.ballFilt l (cat l) I G j) ∧
      (∀ l I m, fp.cumFilt l (cat l ++ hcat l) I m = fp.cumFilt l (cat l) I m) ∧
      (∀ l, ∀ I ∈ Tc,
        (((hcat l).filter (fun d => decide (d.birth = I))).length : ℝ) ≤ n (fp.Lc + 5)) ∧
      (∀ l, ∀ d ∈ hcat l, d.birth ∈ Tc ∧ d.rank = fp.Lc + 5 ∧
        (∃ M : fp.MaskName d.birth, fp.maskOf d.birth M d.tag) ∧
        ∃ R ∈ residueBox (bf.vtag d.tag).dim 9, ∃ γ : ℝ,
          d = templateCol (bf.vtag d.tag) l R γ d.birth d.rank d.tag) := by
  have hcol := A.two_le_colBudget
  have hR0 : 0 ≤ closureRatio A.famVtxBound Kt fp.mH Tmax
      (Real.exp (Dst * (1 + Real.log HS) ^ Dst)) τ₃ := closureRatio_nonneg _ _ _ _ _ _
  have hfac : (1 : ℝ) ≤ 1 + (fp.Lc + 6) * Mp * closureRatio A.famVtxBound Kt fp.mH Tmax
      (Real.exp (Dst * (1 + Real.log HS) ^ Dst)) τ₃ := by
    have : (0 : ℝ) ≤ (fp.Lc + 6) * Mp * closureRatio A.famVtxBound Kt fp.mH Tmax
        (Real.exp (Dst * (1 + Real.log HS) ^ Dst)) τ₃ := by positivity
    linarith
  have hpos : ∀ r, 0 < n r := by
    intro r
    induction r with
    | zero => linarith
    | succ r ih =>
      have h1 := le_mul_of_one_le_left ih.le hfac
      exact lt_of_lt_of_le (lt_of_lt_of_le ih h1) (hgrow r)
  have hbase : ∀ l, ∀ I ∈ Tc, ∀ w : fp.HelperName I ι,
      MainFresh fp.Mc (cat l).length (fp.helperOf l I (fun G => columnL2Restriction
        (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2) (st l G I)) w).base ∧
      ∀ᵐ y ∂volume, y ∉ dyadicGridCell A.G I.1 I.2 →
        ((fp.helperOf l I (fun G => columnL2Restriction (dyadicGridCell A.G I.1 I.2)
          (dyadicGridCell_measurable A.G I.1 I.2) (st l G I)) w).base :
            ℝ → ColumnHilbert (bf.Lab ⊕ Fin fp.Mc)) y = 0 := by
    intro l I _ w
    simp only [helperOf]
    refine ⟨hside l w.2.2 I, ?_⟩
    filter_upwards [columnL2Restriction_coeFn (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (st l w.2.2 I)] with y hy hyI
    rw [hy, Set.indicator_of_notMem hyI]
  obtain ⟨hcat, hh1, hh2, hh3, hh4, hh5, hh6⟩ := fp.helper_instantiation_main Tc hTc hst hHS cat
    (fun l I => fp.HelperName I ι)
    (fun l I w => fp.helperOf l I (fun G => columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (st l G I)) w)
    (fun _ _ _ => rfl) (fun _ _ _ => rfl) hbase (fun _ I => hKh I) hτ n (hpos _) hcapH hMc
    main hmain τm hpass
  refine ⟨hcat, hh1, hh2, hh3, hh4, fun l I hI => (hh5 l I hI).trans ?_,
    fun l d hd => ?_⟩
  swap
  · obtain ⟨h1, h2, ⟨w, hw⟩, h4⟩ := hh6 l d hd
    exact ⟨h1, h2, ⟨w.1, hw⟩, h4⟩
  have hg := hgrow (fp.Lc + 4)
  have hn4 := (hpos (fp.Lc + 4)).le
  have hLM : (1 : ℝ) ≤ (fp.Lc + 6) * Mp := by
    have h1 : (1 : ℝ) ≤ fp.Lc + 6 := by linarith [(Nat.cast_nonneg fp.Lc : (0 : ℝ) ≤ fp.Lc)]
    have h2 : (1 : ℝ) ≤ Mp := by exact_mod_cast hMp1
    nlinarith
  have : closureRatio A.famVtxBound Kt fp.mH Tmax (Real.exp (Dst * (1 + Real.log HS) ^ Dst)) τ₃ *
      n (fp.Lc + 4) ≤ (1 + (fp.Lc + 6) * Mp * closureRatio A.famVtxBound Kt fp.mH Tmax
        (Real.exp (Dst * (1 + Real.log HS) ^ Dst)) τ₃) * n (fp.Lc + 4) := by
    refine mul_le_mul_of_nonneg_right ?_ hn4
    nlinarith
  exact this.trans hg

end ActiveSetup.BasicFamilies.FamParams

namespace ActiveSetup
variable {κ : LocalKernelClass} {c₀ : ℕ}

/-- The setup with its coefficient bound raised to at least `M ≥ 0`. All other data are unchanged,
so the column budget is at least `M` when there is a label. The vertex bound `D` of an attempt
can then be taken as large as required (blueprint line 1745: the failure bound of the colors
"tends to zero as `D` grows"). -/
def padDc (A : ActiveSetup κ c₀) (M : ℝ) (hM : 0 ≤ M) : ActiveSetup κ c₀ where
  G := A.G
  R := A.R
  cells := A.cells
  sub := A.sub
  w := A.w
  adm := A.adm
  L := A.L
  fin := A.fin
  φ := A.φ
  φ_meas := A.φ_meas
  φ_bound := A.φ_bound
  H := A.H
  coef := A.coef
  path_chart := A.path_chart
  nested_chart := A.nested_chart
  nested_cons := A.nested_cons
  Dc := max A.Dc M
  Dc_nonneg := le_max_of_le_right hM
  coef_le := fun l I v => (A.coef_le l I v).trans (le_max_left _ _)
  a := A.a
  b := A.b
  hab := A.hab
  U := A.U
  U_meas := A.U_meas
  S := A.S
  U_L2 := A.U_L2
  U_le := A.U_le
  η := A.η
  small := A.small

variable (A : ActiveSetup κ c₀) {M : ℝ} (hM : 0 ≤ M)

theorem colBudget_le_padDc : A.colBudget ≤ (A.padDc M hM).colBudget := by
  change 2 + Fintype.card A.L * (1 + A.Dc) ≤ 2 + Fintype.card A.L * (1 + max A.Dc M)
  have h1 : A.Dc ≤ max A.Dc M := le_max_left _ _
  gcongr

theorem le_colBudget_padDc (hL : 1 ≤ Fintype.card A.L) : M ≤ (A.padDc M hM).colBudget := by
  change M ≤ 2 + Fintype.card A.L * (1 + max A.Dc M)
  have h1 : M ≤ max A.Dc M := le_max_right _ _
  have h2 : (1 : ℝ) ≤ Fintype.card A.L := by exact_mod_cast hL
  have h3 : 0 ≤ max A.Dc M := le_max_of_le_right hM
  nlinarith

theorem colBudget_padDc_le :
    (A.padDc M hM).colBudget ≤ 2 + Fintype.card A.L * (1 + A.Dc + M) := by
  change 2 + Fintype.card A.L * (1 + max A.Dc M) ≤ 2 + Fintype.card A.L * (1 + A.Dc + M)
  have h1 : max A.Dc M ≤ A.Dc + M := max_le (by linarith) (by linarith [A.Dc_nonneg])
  have h2 : 1 + max A.Dc M ≤ 1 + A.Dc + M := by linarith
  have h3 := mul_le_mul_of_nonneg_left h2 (Nat.cast_nonneg (α := ℝ) (Fintype.card A.L))
  linarith

variable {A} in
theorem HasColumnRep.padDc {CF : ℝ} (h : A.HasColumnRep CF) :
    (A.padDc M hM).HasColumnRep CF := fun l => by
  obtain ⟨P₁, P₂, h₁, h₂, c₁, c₂, e₁, e₂, hP⟩ := h l
  exact ⟨P₁, P₂, h₁.trans (A.colBudget_le_padDc hM), h₂.trans (A.colBudget_le_padDc hM), c₁, c₂,
    e₁, e₂, hP⟩

variable {A} in
theorem SubRootProps.padDc {η₀ E : ℝ} (h : A.SubRootProps η₀ E) :
    (A.padDc M hM).SubRootProps η₀ E := fun R' hR' => by
  obtain ⟨h1, h2, h3⟩ := h R' hR'
  refine ⟨h1, h2, fun l => ?_⟩
  obtain ⟨P₁, P₂, h₁, h₂, c₁, c₂, e₁, e₂, hP⟩ := h3 l
  exact ⟨P₁, P₂, h₁.trans (A.colBudget_le_padDc hM), h₂.trans (A.colBudget_le_padDc hM), c₁, c₂,
    e₁, e₂, hP⟩

/-- Without labels no cell is active. -/
theorem not_active_of_card_eq_zero (hL : Fintype.card A.L = 0) (δ : ℝ) (I : ℤ × ℤ) :
    ¬ A.active δ I := by
  rintro ⟨m, v₀, -, -, -, -⟩
  exact (Fintype.card_eq_zero_iff.mp hL).elim v₀

end ActiveSetup

namespace ActiveSetup
variable {κ : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ c₀)

/-- The attempt parameters of a setup whose height and column budget are at most `e^Y`, `Y ≥ 1`,
are polynomial in `Y`: the vertex bound is at most `e^{Y+3}`, the colour degree `d₀` at most
`5000 Y`, the colour count `L = d₀^{30} + 1` at most `5000^{30} Y^{30} + 1`, `2^{fuel} ≤ 4 L`, and
`log H_src` and `log max(H, padW)` are at most `Y` plus constants. -/
theorem attempt_param_bounds {Y : ℝ} (hY : 1 ≤ Y) (hH : A.H ≤ Real.exp Y)
    (hcb : A.colBudget ≤ Real.exp Y) :
    (A.famVtxBound : ℝ) ≤ Real.exp (Y + 3) ∧ (A.fcd0 : ℝ) ≤ 6000 * Y ∧
    (A.famLc : ℝ) ≤ 6000 ^ 30 * Y ^ 30 + 1 ∧ (2 : ℝ) ^ A.famFuel ≤ 4 * A.famLc ∧
    Real.log (max A.H padW) ≤ Real.log padW + Y ∧
    Real.log A.Hsrc ≤ Real.log ((tagKρ : ℝ) ^ (2 * tagKρ) + 20) + 2 * (Real.log padW + Y) := by
  have hcb2 := two_le_colBudget (A := A)
  -- the vertex bound
  have hV : (A.famVtxBound : ℝ) ≤ Real.exp (Y + 3) := by
    have h1 : (A.famVtxBound : ℝ) ≤ 8 * A.colBudget + 1 := by
      unfold famVtxBound
      push_cast
      have := Nat.floor_le (by linarith : (0 : ℝ) ≤ 8 * A.colBudget)
      linarith
    have he3 : (9 : ℝ) ≤ Real.exp 3 := by
      have h2 : Real.exp 3 = Real.exp 1 * Real.exp 1 * Real.exp 1 := by
        rw [← Real.exp_add, ← Real.exp_add]; norm_num
      have h3 : (2.7 : ℝ) ≤ Real.exp 1 := by linarith [Real.exp_one_gt_d9]
      rw [h2]
      have h5 : (2.7 : ℝ) * 2.7 ≤ Real.exp 1 * Real.exp 1 := mul_le_mul h3 h3 (by norm_num)
        (by linarith)
      nlinarith
    rw [Real.exp_add]
    have hY0 : 1 ≤ Real.exp Y := Real.one_le_exp (by linarith)
    nlinarith
  have hV1 : (1 : ℝ) ≤ A.famVtxBound := by exact_mod_cast A.one_le_famVtxBound
  -- the colour degree
  have hd0 : (A.fcd0 : ℝ) ≤ 6000 * Y := by
    unfold fcd0 colorDegree
    have hpos : 0 ≤ 1000 * Real.log (2 * A.famVtxBound) :=
      mul_nonneg (by norm_num) (Real.log_nonneg (by linarith))
    have h1 := Nat.ceil_lt_add_one hpos
    have h2 : Real.log (2 * A.famVtxBound) ≤ Real.log 2 + (Y + 3) := by
      rw [Real.log_mul (by norm_num) (by linarith)]
      have := Real.log_le_log (by linarith) hV
      rw [Real.log_exp] at this
      linarith
    have hl2 : Real.log 2 ≤ 1 := by linarith [Real.log_two_lt_d9]
    nlinarith
  have hd00 : (0 : ℝ) ≤ A.fcd0 := Nat.cast_nonneg _
  -- the colour count and the fuel
  have hLc : (A.famLc : ℝ) ≤ 6000 ^ 30 * Y ^ 30 + 1 := by
    unfold famLc
    push_cast
    have := pow_le_pow_left₀ hd00 hd0 30
    rw [mul_pow] at this
    linarith
  have hfuel : (2 : ℝ) ^ A.famFuel ≤ 4 * A.famLc := by
    unfold famFuel
    have hL1 : 1 ≤ A.famLc := by unfold famLc; omega
    have h1 : 2 ^ Nat.clog 2 A.famLc < 2 * A.famLc := by
      rcases Nat.lt_or_ge 1 A.famLc with h | h
      · have h0 := Nat.pow_pred_clog_lt_self one_lt_two h
        rw [Nat.pred_eq_sub_one] at h0
        have hc : 1 ≤ Nat.clog 2 A.famLc := Nat.clog_pos one_lt_two h
        have e : 2 ^ Nat.clog 2 A.famLc = 2 * 2 ^ (Nat.clog 2 A.famLc - 1) := by
          rw [← pow_succ']; congr 1; omega
        omega
      · have hL : A.famLc = 1 := le_antisymm h hL1
        rw [hL]; simp
    have h2 : 2 ^ (Nat.clog 2 A.famLc + 1) ≤ 4 * A.famLc := by rw [pow_succ]; omega
    exact_mod_cast h2
  -- the heights
  have hW1 : 1 ≤ padW := le_trans (by linarith [Real.add_one_le_exp (2 : ℝ)]) (le_max_left _ _)
  have hmax : Real.log (max A.H padW) ≤ Real.log padW + Y := by
    rcases le_total A.H padW with h | h
    · rw [max_eq_right h]; linarith
    · rw [max_eq_left h]
      have := Real.log_le_log (by linarith) hH
      rw [Real.log_exp] at this
      have := Real.log_nonneg hW1
      linarith
  have hHs : Real.log A.Hsrc ≤ Real.log ((tagKρ : ℝ) ^ (2 * tagKρ) + 20) +
      2 * (Real.log padW + Y) := by
    unfold Hsrc Hm
    have h0 : (0 : ℝ) < (tagKρ : ℝ) ^ (2 * tagKρ) + 20 := by positivity
    have hm0 : (0 : ℝ) < max A.H padW := lt_of_lt_of_le one_pos (hW1.trans (le_max_right _ _))
    rw [Real.log_mul h0.ne' (by positivity), Real.log_pow]
    push_cast
    linarith
  exact ⟨hV, hd0, hLc, hfuel, hmax, hHs⟩

end ActiveSetup


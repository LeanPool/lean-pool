/-- The side input with the slot catalogs extended by the helper templates `t`, with main budgets
of the extended catalogs (blueprint lines 2167-2169); all other data are those of `D`. -/
def appendCat (D : fp.SideInput) (t : Fin 4 → List (CatCol bf.Vtx))
    (mb' : ∀ l, bf.MainBudget (D.cat l ++ t l)) : fp.SideInput :=
  { D with cat := fun l => D.cat l ++ t l, mbs := mb' }

variable (D : fp.SideInput) (t : Fin 4 → List (CatCol bf.Vtx))
  (mb' : ∀ l, bf.MainBudget (D.cat l ++ t l))

open Classical in
/-- Blueprint line 2168: the side values of the leaf are unchanged by the helper templates on the
active cells (`sideState_restrict_append`; the whole outputs of the basic `U` slot by the
unchanged filters). -/
theorem toLeafQ_sv_appendCat (hanc : A.AncClosed) (ht : ∀ l, ∀ d ∈ t l, fp.hrank ≤ d.rank)
    (hrole : ∀ l, D.Lf.role l ≤ 4) (qG : bf.Grp → ℕ) (l : Fin 4) (G : bf.Grp) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) :
    ((D.appendCat t mb').toLeafQ qG).sv l G I = (D.toLeafQ qG).sv l G I := by
  rw [toLeafQ_sv, toLeafQ_sv]
  by_cases hu : D.u = some l
  · rw [((D.appendCat t mb').withQ0 (qG G)).toLeaf_sv_U hu G I,
      (D.withQ0 (qG G)).toLeaf_sv_U hu G I]
    change fp.ballFilt l (D.cat l ++ t l) I G (D.Lf.role l)
        (layerOp (fun m => fp.cumFilt l (D.cat l ++ t l) I m) (D.Lf.layers l)
          (bf.Ucol fp.Mc l I)) = fp.ballFilt l (D.cat l) I G (D.Lf.role l)
        (layerOp (fun m => fp.cumFilt l (D.cat l) I m) (D.Lf.layers l) (bf.Ucol fp.Mc l I))
    rw [fp.ballFilt_append_helper l (D.cat l) (t l) I G (hrole l) (ht l)]
    have hc : (fun m => fp.cumFilt l (D.cat l ++ t l) I m) = fun m => fp.cumFilt l (D.cat l) I m :=
      funext fun m => fp.cumFilt_append_helper l (D.cat l) (t l) I m (ht l)
    rw [hc]
  · rw [((D.appendCat t mb').withQ0 (qG G)).toLeaf_sv_basic hu G I,
      (D.withQ0 (qG G)).toLeaf_sv_basic hu G I]
    have hb := blkStart_bounds D.hK I.1 (A := A)
    have hb' : A.blkStart D.S.K I.1 - 4 * (D.S.K : ℤ) ≤ I.1 := by
      have : (0 : ℤ) ≤ D.S.K := Nat.cast_nonneg _
      omega
    exact fp.sideState_restrict_append hanc (D.Ms l G) l (D.cat l) (t l) (D.mbs l) (mb' l) G
      (hrole l) (D.Lf.layers l) (D.S.withQ0 (qG G)) D.hA D.SP _ (ht l) hI hb'

/-- The whole leaf outputs are unchanged by the helper templates (unchanged filters). -/
theorem toLeafQ_out_appendCat (ht : ∀ l, ∀ d ∈ t l, fp.hrank ≤ d.rank)
    (hrole : ∀ l, D.Lf.role l ≤ 4) (qG : bf.Grp → ℕ) (l : Fin 4) (G : bf.Grp) (I : ℤ × ℤ) :
    ((D.appendCat t mb').toLeafQ qG).out l G I = (D.toLeafQ qG).out l G I := by
  unfold SideLeafM.out
  change fp.ballFilt l (D.cat l ++ t l) I G (D.Lf.role l)
      (layerOp (fun m => fp.cumFilt l (D.cat l ++ t l) I m) (D.Lf.layers l)
        ((D.toLeafQ qG).xin l I)) = fp.ballFilt l (D.cat l) I G (D.Lf.role l)
      (layerOp (fun m => fp.cumFilt l (D.cat l) I m) (D.Lf.layers l) ((D.toLeafQ qG).xin l I))
  rw [fp.ballFilt_append_helper l (D.cat l) (t l) I G (hrole l) (ht l)]
  have hc : (fun m => fp.cumFilt l (D.cat l ++ t l) I m) = fun m => fp.cumFilt l (D.cat l) I m :=
    funext fun m => fp.cumFilt_append_helper l (D.cat l) (t l) I m (ht l)
  rw [hc]

open Classical in
/-- The frozen representation `RepAt` is unchanged by the helper templates: the frozen outputs on
the retained (active) `v_b`-cells are unchanged, and the lift commutes with restrictions. -/
theorem repAt_appendCat (hanc : A.AncClosed) (ht : ∀ l, ∀ d ∈ t l, fp.hrank ≤ d.rank)
    (hrole : ∀ l, D.Lf.role l ≤ 4) (q : ℕ)
    (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md) (l : Fin 4) (G : bf.Grp)
    (I : ℤ × ℤ) :
    ((D.appendCat t mb').withQ0 q).RepAt L l G I ↔ (D.withQ0 q).RepAt L l G I := by
  have key : ∀ J ∈ fp.retainedV G (A.blkStart D.S.K I.1) D.S.K,
      columnL2Restriction (dyadicGridCell A.G J.1 J.2) (dyadicGridCell_measurable A.G J.1 J.2)
        ((L l G).op (fp.frozenZ l (D.cat l ++ t l) (mb' l) G (D.Lf.role l) (D.Lf.layers l)
          (A.blkStart D.S.K I.1 - 4 * D.S.K))) =
      columnL2Restriction (dyadicGridCell A.G J.1 J.2) (dyadicGridCell_measurable A.G J.1 J.2)
        ((L l G).op (fp.frozenZ l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l)
          (A.blkStart D.S.K I.1 - 4 * D.S.K))) := by
    intro J hJ
    have hJc := fp.mem_cells_of_retainedV hanc hJ
    have hJd : J.1 = A.blkStart D.S.K I.1 - 2 * D.S.K := ((fp.mem_retainedV).mp hJ).2.1
    have hu : A.blkStart D.S.K I.1 - 4 * (D.S.K : ℤ) ≤ J.1 := by
      have : (0 : ℤ) ≤ D.S.K := Nat.cast_nonneg _
      omega
    rw [← LiftData.op_restrict, ← LiftData.op_restrict,
      fp.frozenZ_restrict_append hanc l (D.cat l) (t l) (D.mbs l) (mb' l) G (hrole l)
        (D.Lf.layers l) (ht l) hJc hu]
  constructor
  · intro h J hJ
    have h1 := h J hJ
    change (D.Ms l G).frozenEval (D.S.withQ0 q) (A.blkStart D.S.K I.1) J
      (D.c l G (A.blkStart D.S.K I.1) J) = columnL2Restriction _ _ ((L l G).op
        (fp.frozenZ l (D.cat l ++ t l) (mb' l) G (D.Lf.role l) (D.Lf.layers l)
          (A.blkStart D.S.K I.1 - 4 * D.S.K))) at h1
    change (D.Ms l G).frozenEval (D.S.withQ0 q) (A.blkStart D.S.K I.1) J
      (D.c l G (A.blkStart D.S.K I.1) J) = columnL2Restriction _ _ ((L l G).op
        (fp.frozenZ l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l)
          (A.blkStart D.S.K I.1 - 4 * D.S.K)))
    rw [← key J hJ]
    exact h1
  · intro h J hJ
    have h1 := h J hJ
    change (D.Ms l G).frozenEval (D.S.withQ0 q) (A.blkStart D.S.K I.1) J
      (D.c l G (A.blkStart D.S.K I.1) J) = columnL2Restriction _ _ ((L l G).op
        (fp.frozenZ l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l)
          (A.blkStart D.S.K I.1 - 4 * D.S.K))) at h1
    change (D.Ms l G).frozenEval (D.S.withQ0 q) (A.blkStart D.S.K I.1) J

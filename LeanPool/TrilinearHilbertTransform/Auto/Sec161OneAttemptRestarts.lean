/-- A weighted column on a set is fixed by the restriction to the set. -/
theorem restrict_wColumn_self {W : Type*} [Fintype W] (s : Set ℝ) (hs : MeasurableSet s)
    (φ : W → ℝ → ℂ) (ε : W → ℝ) (x : W) :
    columnL2Restriction s hs (wColumn s φ ε x) = wColumn s φ ε x := by
  by_cases h : MemLp (s.indicator (privateColumnValue φ ε x)) 2 volume
  · refine Lp.ext ?_
    filter_upwards [columnL2Restriction_coeFn s hs (wColumn s φ ε x), wColumn_coeFn h]
      with y h1 h2
    rw [h1]
    by_cases hy : y ∈ s
    · rw [Set.indicator_of_mem hy]
    · rw [Set.indicator_of_notMem hy, h2, Set.indicator_of_notMem hy]
  · have h0 : wColumn s φ ε x = 0 := by unfold wColumn; simp only [h, ↓reduceDIte]
    rw [h0, map_zero]

/-- The main range of a cell is fixed by the restriction to the cell (its columns live on the
cell). -/
theorem restrict_mainRange_self {V : Type} [Fintype V] {Tg : Type*} {Gd : RealDyadicGrid}
    {Mc : ℕ} {O : OrigCols V Tg} (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop)
    {x : ColumnL2 (V ⊕ Fin Mc)} (hx : x ∈ mainRange Gd Mc O s I r M) :
    columnL2Restriction (dyadicGridCell Gd I.1 I.2) (dyadicGridCell_measurable Gd I.1 I.2) x =
      x := by
  refine Submodule.span_induction (p := fun x _ => columnL2Restriction (dyadicGridCell Gd I.1 I.2)
    (dyadicGridCell_measurable Gd I.1 I.2) x = x) ?_ ?_ ?_ ?_ hx
  · rintro x (⟨v, -, -, rfl⟩ | ⟨n, -, -, -, -, rfl⟩) <;>
      exact restrict_wColumn_self _ _ _ _ _
  · exact map_zero _
  · intro x y _ _ hx hy
    rw [map_add, hx, hy]
  · intro a x _ hx
    rw [map_smul, hx]

/-- The outputs of a ball filter at a cell live on the cell. -/
theorem restrict_ballFilt_self (l : Fin 4) (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ) (G : bf.Grp)
    (j : ℕ) (x : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) :
    columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (fp.ballFilt l s I G j x) = fp.ballFilt l s I G j x := by
  unfold ballFilt
  rw [opAvg_apply, map_smul, map_sum]
  congr 1
  refine Finset.sum_congr rfl fun p _ => ?_
  exact restrict_mainRange_self s I _ _ (Submodule.starProjection_apply_mem _ x)

/-- The outputs of a ball filter of a catalog avoid the fresh labels of the catalog. -/
theorem ballFilt_fresh (l : Fin 4) (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ) (G : bf.Grp) (j : ℕ)
    (x : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) : MainFresh fp.Mc s.length (fp.ballFilt l s I G j x) := by
  unfold ballFilt
  rw [opAvg_apply]
  refine MainFresh.smul ?_ _
  exact Finset.sum_induction _ (MainFresh fp.Mc s.length) (fun a b ha hb => ha.add hb)
    (mainFresh_zero _) fun p _ => mainProj_fresh s I _ _ x


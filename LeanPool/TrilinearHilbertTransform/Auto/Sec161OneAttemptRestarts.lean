open Classical in
/-- The node of a successful final class at a cell is a node of the successful components of its
(block, pre-cell) pair: its chosen mode is good, its class contains a good core mode (the class of
a core component), and it is the good mode of least index of the class (`goodRep_min`). -/
theorem classNode_mem_succNodes {G : bf.Grp} {I : ℤ × ℤ} {j : Fin 4} {h : ℕ}
    {F : Finset (D.Ms j G).Md} (hF : F ∈ D.goodCls G I j h) {P : Finset (ℤ × (ℤ × ℤ))}
    (hP : (A.blkStart D.S.K I.1, D.preAt I) ∈ P) :
    D.classNode G I j h hF ∈ (D.Ms j G).succNodes D.S D.hA D.SP P h := by
  set C := (D.Ms j G).blockComps D.S D.hA (A.blkStart D.S.K I.1) (D.preAt I) with hC
  have hgr := D.hasGoodRep_of_mem_goodCls hF
  set m := (D.Ms j G).goodRep D.S D.hA D.SP hgr with hm
  obtain ⟨hg, hmF⟩ := (D.Ms j G).goodRep_spec D.S D.hA D.SP hgr
  obtain ⟨K, hK, hKF⟩ := Finset.mem_image.mp hF
  obtain ⟨hKc, x, hKx, hgx⟩ := Finset.mem_filter.mp hK
  have hFx : (C.F h x).map ⟨Subtype.val, Subtype.val_injective⟩ = F := by
    rw [← hKF, hKx]
    exact ((D.Ms j G).compClass_eq D.S D.hA _ _ h x).symm
  have hcore : C.Core D.SP.Δ ((D.Ms j G).goodP D.S D.SP (A.blkStart D.S.K I.1)) D.SP.Jst
      D.SP.δs x := by
    unfold compsAt at hKc
    split_ifs at hKc with hc
    · have hns := (Finset.mem_sdiff.mp hKc).2
      by_contra hnc
      apply hns
      exact Finset.mem_image.mpr ⟨x, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hnc⟩, hKx.symm⟩
    · exact absurd hKc (Finset.notMem_empty _)
  have hxm : x ∈ C.F h m := by
    have h1 : x.1 ∈ F := by
      rw [← hFx]
      exact Finset.mem_map_of_mem _ (C.E_le_F h x (C.E_self h x))
    rw [← hmF] at h1
    obtain ⟨x', hx', hxe⟩ := Finset.mem_map.mp h1
    have : x' = x := Subtype.ext hxe
    rwa [this] at hx'
  rw [ModeSystem.mem_succNodes]
  refine ⟨_, hP, m, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hg, ⟨x, hxm, hcore, hgx⟩,
    fun y hy hgy => ?_⟩, rfl⟩
  have hyF : (C.F h y).map ⟨Subtype.val, Subtype.val_injective⟩ = F := by
    rw [C.F_comp h m y hy, hmF]
  exact (D.Ms j G).goodRep_min D.S D.hA D.SP hgr y hgy hyF

open Classical in
/-- Hereditary representatives of type classes (`RepClass`, as built by `first_top_count_main`)
whose nodes contain the typed class nodes of the cells `Cs` have the properties `RepOK` there:
representatives in the predecessors, and different representatives on comparable nodes of one
type class with predecessors in different later CURRENT components (`RepClass.hsepP`). -/
theorem repOK_of_repClass (G : bf.Grp) (j : Fin 4) (h : ℕ) (Cs : Finset (ℤ × ℤ))
    (R : ℕ → ℕ → (D.Ms j G).RepClass D.S D.hA D.SP 10 h)
    (hsub : ∀ k₁ k₂, D.typedNodes G j h Cs k₁ k₂ ⊆ (R k₁ k₂).Nd) :
    D.RepOK G j h Cs (fun k₁ k₂ => (R k₁ k₂).rep) := by
  refine ⟨fun k₁ k₂ c => (R k₁ k₂).hrep c, fun k₁ k₂ c c' hcc hne z z' hz hz' => ?_⟩
  obtain ⟨hc, hc', hsub', hlt⟩ := hcc
  exact (R k₁ k₂).hsepP c c' ⟨hsub k₁ k₂ hc, hsub k₁ k₂ hc', hsub', hlt⟩ hne z z' hz hz'

end SideInput


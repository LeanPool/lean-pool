/-! ### Strong stack families cost `G₀` (blueprint lines 2393-2420 and line 2839) -/

/-- Blueprint line 2839 ("the strong stack families cost `G₀`") with eq:small-overhead: the jump
constant of a helper product of `n + 1 ≤ c (log k + 1) + 1` layers in the main column tree of a
catalog with `log (2 D_m) ≤ k^c` is at most `(n + 1)² G₀²`, with
`G₀ = exp(1024 (c + 1) (1024 (c + 1) + c + 7) (1 + log 2k)²)` (`compressionC_le_overhead`). -/
theorem bandJumpM_le (s : List (CatCol bf.Vtx)) (mb : bf.MainBudget s) (n c : ℕ) {k : ℝ}
    (hk : 1 ≤ k) (hD : Real.log (2 * mb.B) ≤ k ^ c) (hn : (n : ℝ) ≤ c * (Real.log k + 1)) :
    fp.bandJumpM s mb n ≤ ((n : ℝ) + 1) ^ 2 *
      Real.exp (2 * (1024 * (c + 1) * (1024 * (c + 1) + c + 7) * (1 + Real.log (2 * k)) ^ 2)) := by
  set E := Real.exp (1024 * (c + 1) * (1024 * (c + 1) + c + 7) * (1 + Real.log (2 * k)) ^ 2)
    with hE
  have hD' : Real.log (2 * (bf.mainTree fp.Mc s mb).budget) ≤ k ^ c := hD
  have hm : ∀ m ∈ Finset.range (n + 1), compressionC (bf.mainTree fp.Mc s mb) m ^ 2 ≤ E ^ 2 := by
    intro m hm
    have hmn : m ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hm)
    exact pow_le_pow_left₀ (compressionC_nonneg _ _)
      ((compressionC_mono _ hmn).trans (compressionC_le_overhead _ n c hk hD' hn)) 2
  have hsum : ∑ m ∈ Finset.range (n + 1), compressionC (bf.mainTree fp.Mc s mb) m ^ 2 ≤
      ((n : ℝ) + 1) * E ^ 2 := by
    refine (Finset.sum_le_sum hm).trans (le_of_eq ?_)
    rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    push_cast
    ring
  have hE2 : E ^ 2 = Real.exp (2 * (1024 * (c + 1) * (1024 * (c + 1) + c + 7) *
      (1 + Real.log (2 * k)) ^ 2)) := by
    rw [hE, ← Real.exp_nat_mul]
    push_cast
    ring_nf
  unfold bandJumpM
  have hn0 : (0 : ℝ) ≤ (n : ℝ) + 1 := by positivity
  calc ((n : ℝ) + 1) * ∑ m ∈ Finset.range (n + 1), compressionC (bf.mainTree fp.Mc s mb) m ^ 2
      ≤ ((n : ℝ) + 1) * (((n : ℝ) + 1) * E ^ 2) := mul_le_mul_of_nonneg_left hsum hn0
    _ = ((n : ℝ) + 1) ^ 2 * E ^ 2 := by ring
    _ = _ := by rw [hE2]

/-- Blueprint `eq:stack-energy` with the strong stack families costing `G₀` (line 2839): the banded
stack energy over outer configurations whose helper prefixes have at most `n ≤ c (log k + 1)`
steps, in the main column tree of a catalog with `log (2 D_m) ≤ k^c`, is at most `P + 2` times the
`P`-free quantity of `stackEA_le` with the jump constant `(n + 1)² G₀²` (`bandJumpM_le`). -/
theorem stackEA_le_G0 {Ω : Type*} (Os : Finset Ω) (sA : List (CatCol bf.Vtx))
    (mbA : bf.MainBudget sA) (D : Ω → List (Bool × ℕ × Option ℕ)) (N : ℕ) {B EW : ℝ}
    (hB : 0 ≤ B) (hEW : 0 ≤ EW) (n c : ℕ) {k : ℝ} (hk : 1 ≤ k)
    (hD : Real.log (2 * mbA.B) ≤ k ^ c) (hn : (n : ℝ) ≤ c * (Real.log k + 1))
    (hlen : ∀ ω ∈ Os, (D ω).length ≤ n) :
    let Cj := ((n : ℝ) + 1) ^ 2 *
      Real.exp (2 * (1024 * (c + 1) * (1024 * (c + 1) + c + 7) * (1 + Real.log (2 * k)) ^ 2))
    fp.stackEA Os sA mbA D N B EW ≤
      (fp.P + 2) * (Os.card * (N * (2 * B + 16 * (Cj * EW) + 16 * (N * (Cj * (N * B)))) + EW)) := by
  intro Cj
  refine fp.stackEA_le Os sA mbA D N hB hEW fun ω hω => ?_
  have hl := hlen ω hω
  have hl' : ((D ω).length : ℝ) ≤ c * (Real.log k + 1) :=
    le_trans (by exact_mod_cast hl) hn
  refine (fp.bandJumpM_le sA mbA (D ω).length c hk hD hl').trans ?_
  have h1 : ((D ω).length : ℝ) + 1 ≤ (n : ℝ) + 1 := by
    have : ((D ω).length : ℝ) ≤ n := by exact_mod_cast hl
    linarith
  have h0 : (0 : ℝ) ≤ ((D ω).length : ℝ) + 1 := by positivity
  exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ h0 h1 2) (Real.exp_pos _).le

namespace SideLeafM
variable {fp} (T : fp.SideLeafM)

/-- The positive chains of a slot of a search leaf number at most `2^fuel`. -/
theorem pe_length_le {fuel : ℕ} {up₀ : Fin 4} {s : ℕ} (hLf : T.Lf = leafAt fuel fp.Lc up₀ s)
    (l : Fin 4) : (T.pe l).length ≤ 2 ^ fuel := by
  unfold pe
  rw [hLf]
  refine (posExpand_length_le _).trans (Nat.pow_le_pow_right (by norm_num) ?_)
  rw [List.length_reverse]
  exact leafAt_layers_length_le fuel fp.Lc up₀ s l

/-- Every positive chain of a slot of a search leaf has at most `fuel` steps. -/
theorem tOf_length_le {fuel : ℕ} {up₀ : Fin 4} {s : ℕ} (hLf : T.Lf = leafAt fuel fp.Lc up₀ s)
    (l : Fin 4) (i : ℕ) : (T.tOf l i).length ≤ fuel := by
  unfold tOf
  by_cases hi : i < (T.pe l).length
  · rw [List.getD_eq_getElem _ _ hi]
    have h1 := posExpand_mem_length _ _ (List.getElem_mem hi)
    rw [List.length_reverse] at h1
    rw [hLf] at h1
    exact h1.trans (leafAt_layers_length_le fuel fp.Lc up₀ s l)
  · rw [List.getD_eq_default _ _ (by omega)]
    simp

/-- The merged descriptors of two positive chains of a search leaf have at most `2 fuel + 2`
steps. -/
theorem desc_tOf_length_le {fuel : ℕ} {up₀ : Fin 4} {s : ℕ}
    (hLf : T.Lf = leafAt fuel fp.Lc up₀ s) (c d : Fin 4) (i i' : ℕ) :
    (T.desc c d (T.tOf c i) (T.tOf d i')).length ≤ 2 * fuel + 2 := by
  unfold desc mergeDescM slotDescM
  rw [rankMerge_length]
  simp only [List.length_cons, List.length_map]
  have h1 := T.tOf_length_le hLf c i
  have h2 := T.tOf_length_le hLf d i'
  omega

/-- The prefixes of the step descriptors of a search leaf have at most `2 fuel + 2` steps. -/
theorem Dpre_length_le {fuel : ℕ} {up₀ : Fin 4} {s : ℕ}
    (hLf : T.Lf = leafAt fuel fp.Lc up₀ s) (ω : Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) :
    (T.Dpre ω).length ≤ 2 * fuel + 2 := by
  unfold Dpre
  rw [List.length_take]
  exact (min_le_right _ _).trans (T.desc_tOf_length_le hLf _ _ _ _)

end SideLeafM


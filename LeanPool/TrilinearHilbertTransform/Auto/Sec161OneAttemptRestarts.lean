/-- The localization data of the leaf with the catalogs extended by helper templates (of template
form, with available tags and of rank above every ball rank): the ball labels are unchanged. -/
noncomputable def ballDataAppend (t : Fin 4 → List (CatCol bf.Vtx))
    (mb' : ∀ l, bf.MainBudget (D.cat l ++ t l)) (qG : bf.Grp → ℕ) {gset : Finset bf.Grp}
    (B : (D.toLeafQ qG).BallData gset)
    (hT : ∀ l, ∀ e ∈ t l, ∃ R ∈ residueBox (bf.vtag e.tag).dim 9, ∃ γ : ℝ,
      e = templateCol (bf.vtag e.tag) l R γ e.birth e.rank e.tag)
    (htag : ∀ l, ∀ e ∈ t l, bf.occAvail e.tag.2.1 e.tag.1)
    (ht : ∀ l, ∀ e ∈ t l, fp.brank (D.Lf.role l) < e.rank) :
    ((D.appendCat t mb').toLeafQ qG).BallData gset where
  hT := fun l e he => by
    rcases List.mem_append.mp he with h | h
    · exact B.hT l e h
    · exact hT l e h
  htag := fun l e he => by
    rcases List.mem_append.mp he with h | h
    · exact B.htag l e h
    · exact htag l e h
  dv := B.dv
  hPH := B.hPH
  N := B.N
  hN := fun l y => by
    have h := B.hN l y
    refine le_trans (le_of_eq ?_) h
    congr 1
    refine Finset.filter_congr fun q _ => ?_
    change (∃ I ∈ A.cells, (∃ k', fp.Cert k' q.1.1 I) ∧ ∃ p : Fin fp.P,
        y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ mainLabelsM A.G fp.Mc (bf.origCols l) (D.cat l ++ t l) I (fp.brank (D.Lf.role l))
          (fp.bmask I q.1.1 (D.Lf.role l) (p + 1)) (B.dv l)) ↔ (∃ I ∈ A.cells,
        (∃ k', fp.Cert k' q.1.1 I) ∧ ∃ p : Fin fp.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ mainLabelsM A.G fp.Mc (bf.origCols l) (D.cat l) I (fp.brank (D.Lf.role l))
          (fp.bmask I q.1.1 (D.Lf.role l) (p + 1)) (B.dv l))
    simp only [mainLabelsM_append_highRank A.G fp.Mc (bf.origCols l) (D.cat l) (t l) _ _ _ _
      (ht l)]


  key_own := fun m => m.elim
  key_cell := fun m => m.elim
  own_cell_key := fun m => m.elim
  key_lam := fun m => m.elim
  key_diff := fun m => m.elim
  a_ind := fun m => m.elim
  lam_le := fun m => m.elim
  εM_pos := fun m => m.elim


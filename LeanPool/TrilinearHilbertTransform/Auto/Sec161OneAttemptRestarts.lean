    have hIF : I ∈ bf.failedCells Hed b1 b2 ωp ωh :=
      Finset.mem_image.mpr ⟨⟨I, A.cells_mem_tree hI⟩,
        Finset.mem_filter.mpr ⟨Finset.mem_univ _, hfail⟩, rfl⟩
    obtain ⟨d, hd, hId⟩ := maximalDyadicCells_covers A.G _ hIF
    exact hno ⟨d, hd, hId⟩

end ActiveSetup.BasicFamilies

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

/-- The failure roots of an attempt on the original basic columns: the maximal failed cells of
its coloring. -/
noncomputable def failRoots : Finset (ℤ × ℤ) :=
  maximalDyadicCells A.G (bf.failedCells fp.Hed (A.fcb1 fp.Hmax) (cb2 fp.Hmax) fp.ωp fp.ωh)

open Classical in
/-- `failure_cut` for an attempt: for a monotone coloring at the scales of the attempt, the failure
roots are disjoint cells below the root of total length at most `100 · 2001⁷ |R| / D`, and at every
cell of the setup below no failure root all present vertices succeed (blueprint lines 1745,
2839). -/
theorem failure_cut
    (hcol : IsMonotoneColoring bf.admT (bf.tagDist fp.Hed) A.famVtxBound (A.fcb1 fp.Hmax)
      (cb2 fp.Hmax) Finset.univ (admCellSet (G := A.G) (R := A.R) (N := A.treeDepth))
      (dyadicGridCell A.G A.R.1 A.R.2) fp.ωp fp.ωh) :
    (∀ c ∈ fp.failRoots, dyadicGridCell A.G c.1 c.2 ⊆ dyadicGridCell A.G A.R.1 A.R.2) ∧
    (∀ c ∈ fp.failRoots, ∀ c' ∈ fp.failRoots, c ≠ c' →
      Disjoint (dyadicGridCell A.G c.1 c.2) (dyadicGridCell A.G c'.1 c'.2)) ∧
    ∑ c ∈ fp.failRoots, dyadicGridLength A.G c.1 ≤
      100 * 2001 ^ 7 / A.famVtxBound * dyadicGridLength A.G A.R.1 ∧
    ∀ I ∈ A.cells, (¬ ∃ c ∈ fp.failRoots, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G c.1 c.2) →
      ∀ w ∈ bf.admT.X (bf.admAt I), fp.K.Success (fp.K.colorData (bf.admT.st (bf.admAt I)) w) := by
  obtain ⟨h1, h2, h3, h4⟩ := bf.failure_cut fp.Hed (A.fcb1 fp.Hmax) (cb2 fp.Hmax) fp.ωp fp.ωh hcol
  refine ⟨h1, h2, h3, fun I hI hno w hw => ?_⟩
  by_contra hs
  exact h4 I hI hno ⟨w, hw, hs⟩

end ActiveSetup.BasicFamilies.FamParams

/-! ### The slot inputs of a pattern on the main columns (blueprint lines 2838-2839) -/

namespace ActiveSetup
variable {κ : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ c₀)

/-- The slot of the basic side of the pattern `p`: none for the all-basic pattern, the marked
slot otherwise. -/
noncomputable def uslot (p : Fin 3) : Option (Fin 4) := if p = 0 then none else some (A.mslot p)

theorem mslot_mem (p : Fin 3) : A.mslot p = A.a ∨ A.mslot p = A.b := by
  unfold mslot
  split_ifs
  · exact Or.inr rfl
  · exact Or.inl rfl

theorem uslot_ab {p : Fin 3} {l : Fin 4} (h : A.uslot p = some l) : l = A.a ∨ l = A.b := by
  unfold uslot at h
  split_ifs at h with hp
  obtain rfl : A.mslot p = l := Option.some.inj h
  exact A.mslot_mem p

theorem z_of_uslot {p : Fin 3} {l : Fin 4} (h : A.uslot p = some l) (I : ℤ × ℤ) :
    A.z (Fin.castSucc p) I l = A.U l I := by
  unfold uslot at h
  split_ifs at h with hp
  obtain rfl : A.mslot p = l := Option.some.inj h
  fin_cases p
  · exact absurd rfl hp
  · change A.z (Fin.castSucc 1) I (A.mslot 1) = A.U (A.mslot 1) I
    rw [show A.mslot 1 = A.a from ite_eq_right (by decide), z_one, Function.update_self]
  · change A.z (Fin.castSucc 2) I (A.mslot 2) = A.U (A.mslot 2) I
    rw [show A.mslot 2 = A.b from ite_eq_left rfl, z_two, Function.update_self]

theorem z_of_not_uslot {p : Fin 3} {l : Fin 4} (h : A.uslot p ≠ some l) (I : ℤ × ℤ) :
    A.z (Fin.castSucc p) I l = A.B l I := by
  by_cases hp : p = 0
  · subst hp; rfl
  · have hl : l ≠ A.mslot p := fun e => h (by unfold uslot; rw [ite_eq_right hp, e])
    obtain ⟨i, rfl⟩ := Fin.exists_succAbove_eq hl
    exact (A.pattern_data I p).2.2.2 i

end ActiveSetup

namespace ActiveSetup.BasicFamilies
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} (bf : A.BasicFamilies)

open Classical in
/-- The slot inputs of the pattern `p` on the main columns (blueprint lines 1607-1623 and
2838-2839, the noninitial base tuple of an active pattern): the basic side `U` in the marked slot of
a side pattern, the basic inputs `B` elsewhere. -/
noncomputable def patIn (Mc : ℕ) (p : Fin 3) (I : ℤ × ℤ) (l : Fin 4) :
    ColumnL2 (bf.Lab ⊕ Fin Mc) :=
  if A.uslot p = some l then bf.Ucol Mc l I else bf.basicIn Mc l I

/-- On a cell of the setup the physical parts of the pattern inputs are the slot arguments of the
pattern. -/
theorem patIn_phys (Mc : ℕ) (p : Fin 3) {I : ℤ × ℤ} (hI : I ∈ A.cells) (l : Fin 4) :
    ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
      augPhys (bf.patIn Mc p I l) y = A.z (Fin.castSucc p) I l y := by
  unfold patIn
  split_ifs with h
  · have hl := A.uslot_ab h
    filter_upwards [augPhys_cellLp_gen (V := bf.Lab ⊕ Fin Mc) (A.U_L2 l I)] with y hy hyI
    unfold Ucol
    rw [ite_eq_left hl, hy hyI, A.z_of_uslot h]
  · filter_upwards [bf.basicIn_phys Mc l hI] with y hy hyI
    rw [hy, Set.indicator_of_mem hyI, A.z_of_not_uslot h]

/-- The pattern inputs have no template coordinates. -/
theorem patIn_fresh (Mc : ℕ) (p : Fin 3) (I : ℤ × ℤ) (l : Fin 4) :
    MainFresh Mc 0 (bf.patIn Mc p I l) := by
  unfold patIn
  split_ifs
  · intro m _
    unfold Ucol
    filter_upwards [physicalColumnInput_coeFn (V := bf.Lab ⊕ Fin Mc)
      (cellLp A.G I (if l = A.a ∨ l = A.b then A.U l I else 0))] with y hy
    rw [hy]
    simp
  · exact bf.basicIn_fresh Mc l I

/-- The pattern inputs vanish off their cell. -/
theorem patIn_support (Mc : ℕ) (p : Fin 3) (I : ℤ × ℤ) (l : Fin 4) :
    ∀ᵐ y ∂volume, y ∉ dyadicGridCell A.G I.1 I.2 →
      (bf.patIn Mc p I l : ℝ → ColumnHilbert (bf.Lab ⊕ Fin Mc)) y = 0 := by
  unfold patIn
  split_ifs
  · unfold Ucol
    exact physicalColumnInput_cellLp_vanish' _ _ _
  · exact bf.basicIn_support Mc l I

/-- The pattern inputs have normalized size at most `max 2 S` on the cells of the setup. -/
theorem norm_patIn_le (Mc : ℕ) (p : Fin 3) {I : ℤ × ℤ} (hI : I ∈ A.cells) (l : Fin 4) :
    ‖bf.patIn Mc p I l‖ ≤ max 2 A.S * Real.sqrt (dyadicGridLength A.G I.1) := by
  unfold patIn
  split_ifs
  · exact (bf.norm_Ucol_le Mc l I).trans
      (mul_le_mul_of_nonneg_right (le_max_right _ _) (Real.sqrt_nonneg _))
  · have h := bf.norm_basicIn_le Mc l hI zero_le_one (fun jb => bf.normF l jb hI)
    rw [Real.sqrt_one, mul_one] at h
    exact h.trans (mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.sqrt_nonneg _))

end ActiveSetup.BasicFamilies

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

/-- The cell forms of the pattern inputs on the main columns are the local forms of the pattern
(blueprint lines 2838-2839: the attempt acts on the noninitial base tuple of the active pattern). -/
theorem Λc_patIn (p : Fin 3) {I : ℤ × ℤ} (hI : I ∈ A.cells) :
    fp.Λc I (bf.patIn fp.Mc p I) = A.Hf I (A.z (Fin.castSucc p) I) := by
  rw [fp.Λc_apply hI]
  exact localProgressionForm_congr_cell (A.adm I hI) fun l => bf.patIn_phys fp.Mc p hI l

open Classical in
/-- Blueprint lines 1850, 1863 and 1876 on the main columns: at a cell of the setup whose present
vertices all succeed (a retained cell, below no failure root by `failure_cut`), every current
group of color `k` has a certificate and an actual use at the cell. -/
theorem groupsAt_cert_use {I : ℤ × ℤ} (hI : I ∈ A.cells) {k : ℕ} {G : bf.Grp}
    (hG : G ∈ fp.groupsAt I k)
    (hS : ∀ w ∈ bf.admT.X (bf.admAt I),
      fp.K.Success (fp.K.colorData (bf.admT.st (bf.admAt I)) w)) :
    fp.Cert k G I ∧ fp.ActualUse G I := by
  obtain ⟨w, hw, hk, rfl⟩ := fp.mem_groupsAt hG
  exact ⟨⟨I, hI, subset_rfl, w, hw, hS w hw, hk, rfl⟩, hI, w, hw, hS w hw, rfl⟩

end ActiveSetup.BasicFamilies.FamParams

/-! ### The parameters of an attempt on the main columns (blueprint lines 1800-1830, 2838-2839) -/

namespace ActiveSetup
variable {κ : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ c₀)

/-- The number of colors `L = d₀^{30} + 1` of an attempt on the main columns (blueprint line 1734:
the colors are at most `d₀^{30}`). -/
noncomputable def famLc : ℕ := A.fcd0 ^ 30 + 1

/-- The search fuel `⌈log₂ L⌉ + 1` of an attempt (blueprint line 1850: `O(log L)` binary
steps). -/
noncomputable def famFuel : ℕ := Nat.clog 2 A.famLc + 1

/-- The pad bound `H_max = 20 P (L + 1) + 40 P` of an attempt with `P` pads (blueprint line 1808:
all neighbor enlargements of the pads lie below `H_max`). -/
noncomputable def famHmax (P : ℕ) : ℕ := 20 * P * (A.famLc + 1) + 40 * P

theorem uslot_ne_basicSlot (p : Fin 3) : A.uslot p ≠ some (A.basicSlot p) := by
  unfold uslot
  split_ifs
  · simp
  · intro h
    exact A.basicSlot_ne p (Option.some.inj h).symm

end ActiveSetup

namespace ActiveSetup.BasicFamilies
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} (bf : A.BasicFamilies)

/-- The parameters of an attempt on the main columns with `P` pads, edge threshold `H_ed`, delay
arrays `ω_p, ω_h` and `M_c` main labels: `L = d₀^{30} + 1`, `m_H = 2 fuel + 2`,
`H_max = 20 P (L + 1) + 40 P`. -/
noncomputable def attemptFam (P : ℕ) (hP : 0 < P) (Hed : ℝ)
    (ωp ωh : Fin A.fcd0 → bf.Vtx → Fin (A.fcd0 + 1)) (Mc : ℕ) : bf.FamParams where
  Hed := Hed
  Hmax := A.famHmax P
  ωp := ωp
  ωh := ωh
  P := P
  hP := hP
  Lc := A.famLc
  Mc := Mc
  mH := 2 * A.famFuel + 2
  pads_le := by
    unfold ActiveSetup.famHmax
    generalize 20 * P * (A.famLc + 1) = X
    omega

theorem patIn_of_ne (Mc : ℕ) (p : Fin 3) (I : ℤ × ℤ) {l : Fin 4} (h : A.uslot p ≠ some l) :
    bf.patIn Mc p I l = bf.basicIn Mc l I := by
  simp [patIn, h]

open Classical in
/-- Blueprint lines 2838-2839 with lines 1800-1856 (one attempt on the noninitial base tuple of an
active pattern, on the main columns): with `P` pads, `L = d₀^{30} + 1` colors, fuel
`⌈log₂ L⌉ + 1` and `m_H = 2 fuel + 2`, the closure counts are fixed first (`closure_poly`; they
do not involve `H_ed`, line 1830), then the edge threshold `H_ed` above any prescribed function of
these counts and above the localization threshold, then the delays of the coloring and the label
room `M_c`. The main catalogs, closed on the test cells `T_c` of path multiplicity at most `M_p`,
then localize the weighted minima of the pattern forms on every set of test cells below no failure
root to the leaves of the guarded search, up to `Σ |I| · #leaves · 9 (D + 1) τ₃ S⁴`. -/
theorem exists_attempt (c Dst : ℕ) :
    ∃ C : ℕ, ∃ k₀ : ℝ, 2 ≤ k₀ ∧ ∀ {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀}
      (bf : A.BasicFamilies) {k : ℝ}, k₀ ≤ k → ∀ (_ : SameTagBound κ A.csrc Dst)
      (p : Fin 3) (Tc : Finset (ℤ × ℤ)), Tc ⊆ A.cells → ∀ (_ : bf.Vtx) (P : ℕ) (_ : 0 < P)
      {τ₃ : ℝ} {Mp : ℕ} (Bh : Type) [Fintype Bh] (Hlow : ℕ → (ℕ → ℝ) → ℕ → ℝ)
      (Mx : ℕ → (ℕ → ℝ) → ℕ → ℕ),
      (A.famLc + 6 : ℝ) ≤ k ^ c → (A.famVtxBound : ℝ) ≤ Real.exp (k ^ c) →
      (A.famHmax P + 1 : ℝ) ≤ Real.exp (k ^ c) →
      ((2 * A.famFuel + 2 : ℕ) : ℝ) ≤ c * (Real.log k + 1) → Real.log A.Hsrc ≤ k ^ c →
      0 < τ₃ → τ₃ ≤ 1 → τ₃⁻¹ ≤ Real.exp (k ^ c) → 1 ≤ Mp → (Mp : ℝ) ≤ Real.exp (k ^ c) →
      2 * A.colBudget ≤ Real.exp (k ^ c) → (Fintype.card Bh : ℝ) ≤ Real.exp (k ^ c) →
      (∀ I : ℤ × ℤ, (Tc.filter fun I' : ℤ × ℤ =>
        dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G I'.1 I'.2).card ≤ Mp) →
      ∃ (fp : bf.FamParams) (cat : Fin 4 → List (CatCol bf.Vtx)) (Kt : ℕ) (n : ℕ → ℝ)
        (Tmax : ℕ),
        fp.P = P ∧ fp.Lc = A.famLc ∧ fp.mH = 2 * A.famFuel + 2 ∧ fp.Hmax = A.famHmax P ∧
        fp.Mc = Tc.card * Tmax + Mx Kt n Tmax ∧
        fp.Hed = max (Hlow Kt n Tmax) (max 2 (Real.exp (A.Dg * (1 + Real.log A.Hsrc +
          Real.log (τ₃ / ((A.famVtxBound : ℝ) ^ 2 * n (A.famLc + 1)))⁻¹) ^ A.Dg))) ∧
        IsMonotoneColoring bf.admT (bf.tagDist fp.Hed) A.famVtxBound (A.fcb1 fp.Hmax)
          (cb2 fp.Hmax) Finset.univ (admCellSet (G := A.G) (R := A.R) (N := A.treeDepth))
          (dyadicGridCell A.G A.R.1 A.R.2) fp.ωp fp.ωh ∧
        (∀ I, Fintype.card (fp.TestName I Unit) ≤ Kt) ∧
        (∀ I, Fintype.card (fp.HelperName I Bh) ≤ Kt) ∧ Real.log Kt ≤ k ^ C ∧
        2 * A.colBudget ≤ n 0 ∧
        (∀ r, (1 + (fp.Lc + 6) * Mp * closureRatio A.famVtxBound Kt fp.mH Tmax
          (Real.exp (Dst * (1 + Real.log A.Hsrc) ^ Dst)) τ₃) * n r ≤ n (r + 1)) ∧
        n (fp.Lc + 5) ≤ Tmax ∧
        closureRatio A.famVtxBound Kt fp.mH Tmax (Real.exp (Dst * (1 + Real.log A.Hsrc) ^ Dst))
          τ₃ * n (fp.Lc + 4) < Tmax ∧
        Real.log (n (fp.Lc + 5)) ≤ k ^ C ∧ Real.log Tmax ≤ k ^ C ∧
        (∀ l, (∀ I ∈ Tc, ∀ w : fp.TestName I Unit,
            (fp.testOf l I (fun _ : Unit => bf.patIn fp.Mc p I l) w).Pass A.G (bf.origCols l) I
              A.csrc A.Hsrc bf.vtag (A.w I) (catThreshold A.famVtxBound τ₃ n
                (fp.testOf l I (fun _ : Unit => bf.patIn fp.Mc p I l) w).r) fp.mH (cat l)) ∧
          (∀ e ∈ cat l, e.birth ∈ Tc ∧ e.rank ≤ fp.Lc + 5 ∧
            ∃ R ∈ residueBox (bf.vtag e.tag).dim 9, ∃ γ : ℝ,
              e = templateCol (bf.vtag e.tag) l R γ e.birth e.rank e.tag) ∧
          (∀ e ∈ cat l, bf.occAvail e.tag.2.1 e.tag.1) ∧
          (∀ I, ∀ r ≤ fp.Lc + 5,
            ((mainLabels A.G fp.Mc (bf.origCols l) (cat l) I r).card : ℝ) ≤ n r) ∧
          (cat l).length ≤ Tc.card * Tmax) ∧
        ∀ cs ⊆ Tc, (∀ I ∈ cs, ¬ ∃ e ∈ fp.failRoots,
            dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e.1 e.2) → ∀ {η : ℝ}, 0 ≤ η →
          ∑ I ∈ cs, dyadicGridLength A.G I.1 * min η ‖A.Hf I (A.z (Fin.castSucc p) I)‖ ≤
            ∑ s ∈ Finset.range (searchList A.famFuel fp.Lc (A.basicSlot p)).length, ∑ I ∈ cs,
              dyadicGridLength A.G I.1 * min η ‖∑ G ∈ fp.groupsAt I
                  (leafAt A.famFuel fp.Lc (A.basicSlot p) s).k,
                fp.Λc I (fun l => fp.ballFilt l (cat l) I G
                  ((leafAt A.famFuel fp.Lc (A.basicSlot p) s).role l)
                  (fp.inputL cat I (bf.patIn fp.Mc p I)
                    (leafAt A.famFuel fp.Lc (A.basicSlot p) s).layers l))‖ +
              (∑ I ∈ cs, dyadicGridLength A.G I.1) *
                ((searchList A.famFuel fp.Lc (A.basicSlot p)).length *
                  (9 * ((A.famVtxBound : ℝ) + 1) * τ₃ * max 2 A.S ^ 4)) := by
  classical
  obtain ⟨C, k₀, hk₀, hpoly⟩ := FamParams.closure_poly c Dst
  refine ⟨C, k₀, hk₀, ?_⟩
  intro κ c₀ A bf k hk hst p Tc hTc d P hP τ₃ Mp Bh _ Hlow Mx hL hDv hH hm hlog hτ hτ1 hτ' hMp1
    hMp hcb hBh hmult
  have hk0 : 0 ≤ k := by linarith
  -- the closure counts on provisional parameters (they do not involve `H_ed`, the delays or `M_c`)
  obtain ⟨Kt, n, Tmax, hKtn, hKth, hlogKt, hn0, hgrow, hnT, hcapH, hlogn, hlogT⟩ :=
    hpoly hk (bf.attemptFam P hP 0 (fun _ _ => 0) (fun _ _ => 0) 0) (HS := A.Hsrc) (τ₃ := τ₃)
      (Mp := Mp) Unit Bh hL hDv hH hm A.exp_two_le_Hsrc hlog hτ hτ' hMp1 hMp hcb
      (by rw [Fintype.card_unit, Nat.cast_one]; exact Real.one_le_exp (by positivity)) hBh
  -- the edge threshold, the delays and the label room
  set! Hloc := Real.exp (A.Dg * (1 + Real.log A.Hsrc +
    Real.log (τ₃ / ((A.famVtxBound : ℝ) ^ 2 * n (A.famLc + 1)))⁻¹) ^ A.Dg) with hHloc
  set! Hed := max (Hlow Kt n Tmax) (max 2 Hloc) with hHed
  obtain ⟨ωp, ωh, hcol⟩ := bf.coloring Hed (A.fcb1 (A.famHmax P)) (cb2 (A.famHmax P))
  set! fp := bf.attemptFam P hP Hed ωp ωh (Tc.card * Tmax + Mx Kt n Tmax) with hfp
  have hfuel : fp.Lc - 1 < 2 ^ A.famFuel :=
    (Nat.sub_le _ _).trans_lt ((Nat.le_pow_clog one_lt_two A.famLc).trans_lt
      (Nat.pow_lt_pow_right one_lt_two (Nat.lt_succ_self _)))
  obtain ⟨cat, hcat, hloc⟩ := fp.attempt_localization Tc hTc hst
    (fun I l => bf.patIn fp.Mc p I l)
    (fun l I _ => ⟨bf.patIn_fresh fp.Mc p I l, bf.patIn_support fp.Mc p I l⟩)
    (Kt := Kt) (fun I => hKtn I) hMp1 hτ hτ1 n hn0 hgrow hnT
    (by change Tc.card * Tmax ≤ Tc.card * Tmax + Mx Kt n Tmax; omega)
    (fuel := A.famFuel) (up₀ := A.basicSlot p)
    (by change 1 ≤ A.famLc; unfold ActiveSetup.famLc; omega) hfuel
    (by change A.famFuel ≤ 2 * A.famFuel + 2; omega)
    (le_trans (le_max_right _ _) (le_max_right _ _)) d
  refine ⟨fp, cat, Kt, n, Tmax, rfl, rfl, rfl, rfl, rfl, rfl, hcol, hKtn, hKth, hlogKt, hn0,
    hgrow, hnT, hcapH, hlogn, hlogT,
    fun l => ⟨(hcat l).1, (hcat l).2.1, (hcat l).2.2.1,
      fun I r hr => (hcat l).2.2.2.1 I (hmult I) r hr, (hcat l).2.2.2.2⟩, ?_⟩
  intro cs hcs hno η hη
  have hsucc := (fp.failure_cut hcol).2.2.2
  have hSz : (0 : ℝ) < max 2 A.S := lt_of_lt_of_le two_pos (le_max_left _ _)
  have h := hloc cs hcs (fun I _ => hmult I)
    (fun I hI => hsucc I (hTc (hcs hI)) (hno I hI))
    (fun I _ w hw => ((hcol.2.2.1 (bf.admAt I) w hw).2.trans hcol.2.1).trans (Nat.le_succ _))
    (fun I hI => by
      rw [bf.patIn_of_ne fp.Mc p I (A.uslot_ne_basicSlot p)]
      exact bf.basicIn_comb fp.Mc [] (A.basicSlot p) (hTc (hcs hI)))
    (Sz := max 2 A.S) hη hSz
    (fun I hI l => (div_le_iff₀ (Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1))).mpr
      (bf.norm_patIn_le fp.Mc p (hTc (hcs hI)) l))
  refine le_of_eq_of_le (Finset.sum_congr rfl fun I hI => ?_) h
  rw [fp.Λc_patIn p (hTc (hcs hI))]

end ActiveSetup.BasicFamilies

/-- The packet width `packetW` dominates the width of lem:height at height `H` in the form used
by the linear sides: `8 (d_max + 1)^3 log(2H) / log 2 ≤ packetW d_max H`. -/
theorem packetW_ge (dmax : ℕ) {H : ℝ} (hH : 0 < H) :
    8 * ((dmax : ℝ) + 1) ^ 3 * Real.log (2 * H) / Real.log 2 ≤ packetW dmax H := by
  unfold packetW
  have hl2 : (1 / 2 : ℝ) < Real.log 2 := by linarith [Real.log_two_gt_d9]
  have hm : 0 < 2 * max 2 H := by positivity
  have hd0 : (0 : ℝ) ≤ dmax := Nat.cast_nonneg _
  have hp : 0 ≤ (2 * (dmax : ℝ) + 1) ^ 3 := by positivity
  have hlm : 0 ≤ Real.log (2 * max 2 H) := Real.log_nonneg (by
    have := le_max_left 2 H; linarith)
  rcases le_or_gt (Real.log (2 * H)) 0 with h | h
  · have : 8 * ((dmax : ℝ) + 1) ^ 3 * Real.log (2 * H) / Real.log 2 ≤ 0 :=
      div_nonpos_of_nonpos_of_nonneg (mul_nonpos_of_nonneg_of_nonpos (by positivity) h)
        (by linarith)
    have : 0 ≤ 16 * (2 * (dmax : ℝ) + 1) ^ 3 * Real.log (2 * max 2 H) := by positivity
    linarith
  · have hlog : Real.log (2 * H) ≤ Real.log (2 * max 2 H) :=
      Real.log_le_log (by positivity) (by have := le_max_right 2 H; linarith)
    have hd : ((dmax : ℝ) + 1) ^ 3 ≤ (2 * dmax + 1) ^ 3 :=
      pow_le_pow_left₀ (by positivity) (by linarith) 3
    rw [div_le_iff₀ (by linarith)]
    have h1 : 8 * ((dmax : ℝ) + 1) ^ 3 * Real.log (2 * H) ≤
        8 * (2 * dmax + 1) ^ 3 * Real.log (2 * max 2 H) :=
      mul_le_mul (mul_le_mul_of_nonneg_left hd (by norm_num)) hlog h.le (by positivity)
    have h2 : 0 ≤ (2 * (dmax : ℝ) + 1) ^ 3 * Real.log (2 * max 2 H) := mul_nonneg hp hlm
    nlinarith

namespace ActiveSetup.BasicFamilies.FamParams

theorem eta_power_P_le {ε C₄ η : ℝ} (hε : 0 < ε) (hC₄ : 0 ≤ C₄) (hη0 : 0 < η) (hη1 : η ≤ 1) :
    η ^ ε * (⌈η ^ (-(ε / (4 * (C₄ + 1))))⌉₊ : ℝ) ^ C₄ ≤ 2 ^ C₄ * η ^ (ε / 2) := by
  set α := ε / (4 * (C₄ + 1)) with hα

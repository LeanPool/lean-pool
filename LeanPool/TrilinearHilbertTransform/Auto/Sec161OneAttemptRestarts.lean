theorem eventually_pow_mul_exp_le (C : ℕ) {θ : ℝ} (hθ : 0 < θ) :
    ∃ K : ℕ, ∀ k : ℕ, K ≤ k → (k : ℝ) ^ C * Real.exp (-2 * (k : ℝ) ^ θ) ≤

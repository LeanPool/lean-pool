/-- The full Fourier norm bound of the multiplier of the principal bins is that of
`gaugeMult_star`. -/
theorem multNorm_eq (d : ℕ) (δ : ℝ) (Q0 : ℕ) (Cm : ℝ) :
    multNorm d δ Q0 Cm = gaugeMultNorm d Q0 Cm δ := by
  unfold multNorm gaugeMultNorm gaugeMultTail gaugeMultA
  ring

/-- The truncation error of the multiplier of the principal bins is that of `gaugeMult_star`. -/
theorem multTail_eq (d : ℕ) (δ : ℝ) (Q0 : ℕ) (Cm : ℝ) (K : ℕ) :
    multTail d δ Q0 Cm K = 2 * gaugeMultTail d Q0 Cm δ / 2 ^ K := by
  unfold multTail gaugeMultTail gaugeMultA
  ring

/-- Blueprint lines 1942-1944 for the principal bins of a group center `z`: with its clearing
integer `Q₀ = clearInt C_z` and `C_m = H_ed`, the full Fourier norms of the multiplier (cutoff
`δ/2`) and of the cutoff `ζ` are at most the enlarged budget `D_*`, their truncations at `K_*` are
within `D_*^(-300)`, `|C_{ab}| ≤ H_ed`, and `Q₀ C_z` is integral. -/
theorem center_principal_bounds (D dB : ℕ) {H δc N : ℝ} (k : ℝ) {δ : ℝ} (hδ : 0 < δ)
    (hδ1 : δ ≤ 1) (hHed : 2 ≤ fp.Hed) (hH : 1 ≤ H) (hδc : 0 < δc) (hN0 : 0 ≤ N) (hdB : 1 ≤ dB)
    (hdim : ∀ w : bf.Vtx, (bf.vtag w).dim ≤ dB)
    (hC : ∀ (w : bf.Vtx) a c, (rationalHeight ((bf.vtag w).C a c) : ℝ) ≤ fp.Hed) (z : bf.Vtx) :
    multNorm (bf.vtag z).dim (δ / 2) (clearInt (bf.vtag z).C) fp.Hed ≤
        fp.modeStarG D dB H δc N k δ ∧
      multTail (bf.vtag z).dim (δ / 2) (clearInt (bf.vtag z).C) fp.Hed
        (fp.Kstar D dB H δc N k δ) ≤ (fp.modeStarG D dB H δc N k δ ^ 300)⁻¹ ∧
      cutNorm (bf.vtag z).dim δ ≤ fp.modeStarG D dB H δc N k δ ∧
      cutTail (bf.vtag z).dim δ (fp.Kstar D dB H δc N k δ) ≤
        (fp.modeStarG D dB H δc N k δ ^ 300)⁻¹ ∧
      (∀ a b, |((bf.vtag z).C a b : ℝ)| ≤ fp.Hed) ∧
      ∀ a b, ∃ m : ℤ, (clearInt (bf.vtag z).C : ℝ) * ((bf.vtag z).C a b : ℝ) = m := by
  obtain ⟨-, -, hGM, hGS, -⟩ := fp.le_modeStarG D dB k hδ hHed hH hδc hN0
  have hδ2 : 0 < δ / 2 := half_pos hδ
  have hδ21 : δ / 2 ≤ 1 := by linarith
  have hHed0 : (0 : ℝ) ≤ fp.Hed := by linarith
  have hQ1 : (1 : ℝ) ≤ fp.Hed ^ (dB * dB) := one_le_pow₀ (by linarith)
  have hq0 : (0 : ℝ) ≤ (clearInt (bf.vtag z).C : ℝ) := Nat.cast_nonneg _
  have hq : (clearInt (bf.vtag z).C : ℝ) ≤ fp.Hed ^ (dB * dB) :=
    (clearInt_le (bf.vtag z).C (hC z)).trans
      (pow_le_pow_right₀ (by linarith) (Nat.mul_le_mul (hdim z) (hdim z)))
  have hMT : gaugeMultTail (bf.vtag z).dim (clearInt (bf.vtag z).C) fp.Hed (δ / 2) ≤
      gaugeMultTail dB (fp.Hed ^ (dB * dB)) fp.Hed (δ / 2) :=
    gaugeMultTail_mono hδ2 hδ21 hdB (hdim z) hq0 hq hQ1 hHed0 le_rfl
  have hMN : gaugeMultNorm (bf.vtag z).dim (clearInt (bf.vtag z).C) fp.Hed (δ / 2) ≤
      gaugeMultNorm dB (fp.Hed ^ (dB * dB)) fp.Hed (δ / 2) :=
    gaugeMultNorm_mono hδ2 hδ21 hdB (hdim z) hq0 hq hQ1 hHed0 le_rfl
  have hMT0 : 0 ≤ gaugeMultTail dB (fp.Hed ^ (dB * dB)) fp.Hed (δ / 2) :=
    gaugeMultTail_nonneg dB hδ2 (by linarith) hHed0
  have hGT0 := gaugeTail_nonneg dB hδ
  have hKs := fun (T : ℝ) (hT0 : 0 ≤ T) (hT : T ≤ fp.tailStar dB δ) =>
    fp.tail_le_Kstar D dB k hδ hHed hH hδc hN0 hT0 hT
  refine ⟨?_, ?_, ?_, ?_, fun a b => (abs_rat_le_rationalHeight _).trans (hC z a b),
    fun a b => clearInt_clears _ a b⟩
  · rw [multNorm_eq]; exact hMN.trans hGM
  · rw [multTail_eq]
    refine le_trans ?_ (hKs _ hMT0 (by unfold tailStar; linarith))
    gcongr
  · exact (cutNorm_le_gaugeSqNorm _ hδ).trans ((gaugeSqNorm_mono hδ hδ1 (hdim z)).trans hGS)
  · refine (cutTail_le_gaugeTail _ hδ _).trans ?_
    refine le_trans ?_ (hKs _ hGT0 (by unfold tailStar; linarith))
    gcongr
    exact gaugeTail_mono hδ hδ1 (hdim z)


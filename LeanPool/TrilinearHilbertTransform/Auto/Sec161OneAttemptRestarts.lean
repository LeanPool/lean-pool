  have hP : (⌈η ^ (-α)⌉₊ : ℝ) ≤ 2 * η ^ (-α) := by
    have := Nat.ceil_lt_add_one (show 0 ≤ η ^ (-α) by positivity)
    linarith
  have hP0 : 0 ≤ (⌈η ^ (-α)⌉₊ : ℝ) := Nat.cast_nonneg _
  calc η ^ ε * (⌈η ^ (-α)⌉₊ : ℝ) ^ C₄ ≤ η ^ ε * (2 * η ^ (-α)) ^ C₄ := by gcongr
    _ = 2 ^ C₄ * (η ^ ε * η ^ (-α * C₄)) := by
        rw [Real.mul_rpow (by norm_num) (by positivity), ← Real.rpow_mul hη0.le]; ring
    _ = 2 ^ C₄ * η ^ (ε - α * C₄) := by
        rw [← Real.rpow_add hη0]; ring_nf

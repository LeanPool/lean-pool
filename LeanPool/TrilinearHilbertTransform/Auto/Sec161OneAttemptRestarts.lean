/-- Catalog columns of rank above `r` do not change the main labels of rank at most `r`. -/
theorem mainLabels_append_highRank {V : Type} [Fintype V] {Tg : Type*} (Gd : RealDyadicGrid)
    (Mc : ℕ) (O : OrigCols V Tg) (s t : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ)
    (ht : ∀ d ∈ t, r < d.rank) : mainLabels Gd Mc O (s ++ t) I r = mainLabels Gd Mc O s I r := by
  ext x
  rcases x with v | n
  · simp only [mem_mainLabels, Sum.elim_inl]
  · simp only [mem_mainLabels, Sum.elim_inr]
    constructor
    · rintro ⟨hn, hsub, hr⟩
      by_cases hns : (n : ℕ) < s.length
      · rw [List.getElem_append_left hns] at hsub hr
        exact ⟨hns, hsub, hr⟩
      · exfalso
        have hle : s.length ≤ (n : ℕ) := by omega
        have hmem : (s ++ t)[(n : ℕ)]'hn ∈ t := by
          rw [List.getElem_append_right hle]
          exact List.getElem_mem _
        have := ht _ hmem
        omega
    · rintro ⟨hns, hsub, hr⟩
      have hn : (n : ℕ) < (s ++ t).length := by rw [List.length_append]; omega
      refine ⟨hn, ?_, ?_⟩ <;> rw [List.getElem_append_left hns] <;> assumption

open Classical in
/-- Catalog columns of rank above `r` do not change the masked main labels of rank at most `r`. -/
theorem mainLabelsM_append_highRank {V : Type} [Fintype V] {Tg : Type*} (Gd : RealDyadicGrid)
    (Mc : ℕ) (O : OrigCols V Tg) (s t : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop)
    (d : Tg) (ht : ∀ e ∈ t, r < e.rank) :
    mainLabelsM Gd Mc O (s ++ t) I r M d = mainLabelsM Gd Mc O s I r M d := by
  unfold mainLabelsM
  rw [mainLabels_append_highRank Gd Mc O s t I r ht]
  refine Finset.filter_congr fun v hv => ?_
  rcases v with x | n
  · rfl
  · have hns : (n : ℕ) < s.length := by
      obtain ⟨h, -⟩ := (mem_mainLabels.mp hv : ∃ hn : (n : ℕ) < s.length, _)
      exact h
    have hn : (n : ℕ) < (s ++ t).length := by rw [List.length_append]; omega
    unfold labelTag
    simp only [Sum.elim_inr, hns, hn, ↓reduceDIte, List.getElem_append_left hns]

/-- A present vertex at an active cell is an available occurrence at its admission cell. -/
theorem occAvail_of_mem_X {I : ℤ × ℤ} (hI : I ∈ A.cells) {x : bf.Vtx}
    (hx : x ∈ bf.admT.X (bf.admAt I)) : bf.occAvail x.2.1 x.1 := by
  rw [bf.admAt_of_mem hI] at hx
  change x ∈ admPresent bf.occAvail ⟨I, A.cells_mem_tree hI⟩ at hx
  obtain ⟨hne, hx2⟩ := (mem_admPresent bf.occAvail).mp hx
  have h := (admCellOf_spec bf.occAvail hne).1
  rw [← hx2] at h
  exact ((mem_admAnc bf.occAvail).mp h).2

/-- The vertices of a named mask are present vertices of the cell. -/
theorem maskOf_mem_X (I : ℤ × ℤ) (M : fp.MaskName I) {x : bf.Vtx} (hx : fp.maskOf I M x) :
    x ∈ bf.admT.X (bf.admAt I) := by
  rcases M with ⟨m, h⟩ | ⟨v, h⟩
  · exact hx.1
  · exact hx.1


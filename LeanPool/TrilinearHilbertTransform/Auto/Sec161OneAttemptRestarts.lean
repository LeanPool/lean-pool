      exact ⟨some c', hf, hx⟩
    · rintro ⟨c, hf, hx⟩
      cases c with
      | none => exact absurd hx (Set.notMem_empty x)
      | some c =>
        exact ⟨c.1, Finset.mem_image.mpr ⟨c, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hf⟩, rfl⟩,
          hx⟩

/-! ### Helper templates leave the main objects unchanged (blueprint line 2168) -/

/-- Blueprint line 2168 ("helper ranks exceed every main rank, so their insertion leaves all
previously fixed main projections ... unchanged"): on an active cell of its depth, the basic coarse
output of a catalog extended by templates of the helper rank equals that of the catalog, for any
main budgets (both are the leaf outputs of the cell, `basicOut_restrict`, whose ball and cumulative
filters are unchanged). -/
theorem basicOut_restrict_append (l : Fin 4) (s t : List (CatCol bf.Vtx)) (mb : bf.MainBudget s)
    (mb' : bf.MainBudget (s ++ t)) (G : bf.Grp) {j : ℕ} (hj : j ≤ 4) (ls : List (ℕ × Bool))
    (ht : ∀ d ∈ t, fp.hrank ≤ d.rank) {I : ℤ × ℤ} (hI : I ∈ A.cells) :
    columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (fp.basicOut l (s ++ t) mb' G j ls I.1) =
      columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (fp.basicOut l s mb G j ls I.1) := by
  rw [fp.basicOut_restrict l (s ++ t) mb' G j ls hI, fp.basicOut_restrict l s mb G j ls hI,
    fp.ballFilt_append_helper l s t I G hj ht]
  have hc : (fun m => fp.cumFilt l (s ++ t) I m) = fun m => fp.cumFilt l s I m :=
    funext fun m => fp.cumFilt_append_helper l s t I m ht
  rw [hc]

/-- The frozen output at a depth `u ≤ I.1`, restricted to an active cell `I`, is unchanged by
helper templates: it is the restriction of the output on the active ancestor of depth `u`. -/
theorem frozenZ_restrict_append (hanc : A.AncClosed) (l : Fin 4) (s t : List (CatCol bf.Vtx))
    (mb : bf.MainBudget s) (mb' : bf.MainBudget (s ++ t)) (G : bf.Grp) {j : ℕ} (hj : j ≤ 4)
    (ls : List (ℕ × Bool)) (ht : ∀ d ∈ t, fp.hrank ≤ d.rank) {I : ℤ × ℤ} (hI : I ∈ A.cells)
    {u : ℤ} (hu : u ≤ I.1) :
    columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (fp.frozenZ l (s ++ t) mb' G j ls u) =
      columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (fp.frozenZ l s mb G j ls u) := by
  unfold frozenZ
  split_ifs with hR
  · rfl
  push Not at hR
  set! U := ancAt A.G I u with hU
  have hIU := subset_ancAt A.G I hu
  have hIR := (dyadicFiniteTree_mem_iff A.G A.R I _).mp (A.cells_mem_tree hI)
  have hUR := ancAt_subset hIR.1 hR
  have hUc : U ∈ A.cells := hanc I hI U hIU hUR
  have hU1 : U.1 = u := rfl
  have hcomp := columnL2Restriction_comp_of_subset (V := bf.Lab ⊕ Fin fp.Mc)
    (dyadicGridCell_measurable A.G I.1 I.2) (dyadicGridCell_measurable A.G U.1 U.2) hIU
  rw [← hcomp, ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply]
  have h : columnL2Restriction (dyadicGridCell A.G U.1 U.2) (dyadicGridCell_measurable A.G U.1 U.2)
        (fp.basicOut l (s ++ t) mb' G j ls u) =
      columnL2Restriction (dyadicGridCell A.G U.1 U.2) (dyadicGridCell_measurable A.G U.1 U.2)
        (fp.basicOut l s mb G j ls u) := fp.basicOut_restrict_append l s t mb mb' G hj ls ht hUc
  rw [h]

/-- The side state at the depth of an active cell, restricted to the cell, is unchanged by helper
templates (`eq:sides`: the rolling output, the frozen output at `u_b ≤ I.1` and the
catalog-free side subtotal). -/
theorem sideState_restrict_append (hanc : A.AncClosed) {n : ℕ} (Ms : ModeSystem A.G n)
    (l : Fin 4) (s t : List (CatCol bf.Vtx)) (mb : bf.MainBudget s)
    (mb' : bf.MainBudget (s ++ t)) (G : bf.Grp) {j : ℕ} (hj : j ≤ 4) (ls : List (ℕ × Bool))
    (S : ModeSchedule) (hA : 6 ≤ S.A0) (SP : SideParams) (c : ℤ × ℤ → Ms.Md → ℂ) {b : ℤ}
    (ht : ∀ d ∈ t, fp.hrank ≤ d.rank) {I : ℤ × ℤ} (hI : I ∈ A.cells) (hb : b - 4 * S.K ≤ I.1) :
    columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (fp.sideState Ms l (s ++ t) mb' G j ls S hA SP c b I.1) =
      columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (fp.sideState Ms l s mb G j ls S hA SP c b I.1) := by
  unfold sideState
  simp only [map_add, map_sub]
  simp only [← physEmbed_restrict]
  rw [fp.basicOut_restrict_append l s t mb mb' G hj ls ht hI,
    fp.frozenZ_restrict_append hanc l s t mb mb' G hj ls ht hI hb]

/-- A retained `v_b`-cell is an active cell (it contains an actual use and lies below the root). -/
theorem mem_cells_of_retainedV (hanc : A.AncClosed) {G : bf.Grp} {b : ℤ} {K : ℕ} {J : ℤ × ℤ}
    (hJ : J ∈ fp.retainedV G b K) : J ∈ A.cells := by
  obtain ⟨hJt, -, I, hIJ, -, -, hIc⟩ := (fp.mem_retainedV).mp hJ
  exact hanc I hIc.1 J hIJ ((dyadicFiniteTree_mem_iff A.G A.R J _).mp hJt).1

namespace SideInput

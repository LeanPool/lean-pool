/-- The first stops of `J`: maximal cells of `C` strictly inside `J` violating `J`. -/
noncomputable def firstStops (J : α) : Finset α := by
  classical exact (C.filter fun K => cell K ⊂ cell J ∧ bad J K).filter fun K =>
    ¬∃ L ∈ C, cell K ⊂ cell L ∧ cell L ⊂ cell J ∧ bad J L

/-- The stopping generations, starting from the roots. -/
noncomputable def stopGen (roots : Finset α) : ℕ → Finset α
  | 0 => roots
  | k + 1 => (stopGen roots k).biUnion (firstStops C cell bad)

variable {C cell bad}

omit [DecidableEq α] in
theorem mem_firstStops {J K : α} :
    K ∈ firstStops C cell bad J ↔ (K ∈ C ∧ cell K ⊂ cell J ∧ bad J K) ∧
      ¬∃ L ∈ C, cell K ⊂ cell L ∧ cell L ⊂ cell J ∧ bad J L := by
  classical
  simp only [firstStops, Finset.mem_filter, and_assoc]

omit [DecidableEq α] in
theorem firstStops_subset (J : α) : firstStops C cell bad J ⊆ C := fun _ hK =>
  (mem_firstStops.mp hK).1.1


  have hC : (C : ℝ) * Real.log k ≤ (k : ℝ) ^ θ := by
    have h1 : ((C : ℝ) + 1) * Real.log k ≤ (k : ℝ) ^ θ := by
      have := mul_le_mul_of_nonneg_left hb (show (0 : ℝ) ≤ (C : ℝ) + 1 by positivity)

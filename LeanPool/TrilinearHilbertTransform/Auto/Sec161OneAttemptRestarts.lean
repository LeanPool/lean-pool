/-! ### The uniform first-match and mode parameter bounds of one attempt (blueprint line 2839) -/

/-- The clearing bound of the attempt, `⌈H_ed^(d_B²)⌉`: every group center `z` has its clearing
integer `Q₀(z) = clearInt C_z` at most this bound (blueprint lines 1890 and 1934). It is the `Q₀`
of the leaf schedule; each group uses its own `Q₀(z)` (`SideInput.withQ0`). -/
noncomputable def Q0bd (dB : ℕ) : ℕ := ⌈fp.Hed ^ (dB * dB)⌉₊

/-- The common cutoff `B_* = Q₀ 2^(K_*+1)` of the attempt (blueprint line 1944), with `Q₀` the
clearing bound and `K_*` the truncation exponent of the enlarged budget. -/
noncomputable def Bst (D dB : ℕ) (H δc N k δ : ℝ) : ℝ :=
  fp.Q0bd dB * 2 ^ (fp.Kstar D dB H δc N k δ + 1)

theorem one_le_Q0bd (dB : ℕ) (hHed : 2 ≤ fp.Hed) : 1 ≤ fp.Q0bd dB := by
  unfold Q0bd
  exact Nat.one_le_iff_ne_zero.mpr (Nat.ceil_pos.mpr (pow_pos (by linarith) _)).ne'

/-- Every group center has its clearing integer between `1` and the clearing bound. -/
theorem clearInt_le_Q0bd {dB : ℕ} (hdim : ∀ w : bf.Vtx, (bf.vtag w).dim ≤ dB)
    (hHed : 2 ≤ fp.Hed)
    (hC : ∀ (w : bf.Vtx) a c, (rationalHeight ((bf.vtag w).C a c) : ℝ) ≤ fp.Hed) (z : bf.Vtx) :
    1 ≤ clearInt (bf.vtag z).C ∧ clearInt (bf.vtag z).C ≤ fp.Q0bd dB := by
  refine ⟨clearInt_pos _, ?_⟩
  have h1 := clearInt_le (bf.vtag z).C (hC z)
  have h2 : fp.Hed ^ ((bf.vtag z).dim * (bf.vtag z).dim) ≤ fp.Hed ^ (dB * dB) :=
    pow_le_pow_right₀ (by linarith) (Nat.mul_le_mul (hdim z) (hdim z))
  unfold Q0bd
  exact Nat.cast_le.mp ((h1.trans h2).trans (Nat.le_ceil _))

/-- The enlarged budget `D_*` dominates `d_max = 2 d_B + 2` and the clearing bound. -/
theorem dmax_Q0bd_le_modeStarG (D dB : ℕ) {H δc N : ℝ} (k : ℝ) {δ : ℝ} (hδ : 0 < δ)
    (hHed : 2 ≤ fp.Hed) (hH : 1 ≤ H) (hδc : 0 < δc) (hN0 : 0 ≤ N) :
    ((2 * dB + 2 : ℕ) : ℝ) ≤ fp.modeStarG D dB H δc N k δ ∧
      (fp.Q0bd dB : ℝ) ≤ fp.modeStarG D dB H δc N k δ := by
  obtain ⟨-, hst, -, -, -⟩ := fp.le_modeStarG D dB k hδ hHed hH hδc hN0
  set Bm := Real.exp (D * fp.Xmax dB H ^ D)
  have hX : 1 ≤ fp.Xmax dB H :=
    (fp.one_le_X hHed dB hH _).trans (fp.X_le_Xmax hHed dB H (le_refl (0 : ℤ)) (Nat.zero_le 4))
  have hBm : 1 ≤ Bm := Real.one_le_exp (by positivity)
  have hmax : 1 ≤ max 1 (4 * Bm / δc) := le_max_left _ _
  have hcb := two_le_colBudget (A := A)
  have hd : (0 : ℝ) ≤ dB := Nat.cast_nonneg _
  have hT2 : (8 * dB + 5 : ℝ) ≤ Bm * (1 + 4 * (2 * dB + 1) * max 1 (4 * Bm / δc)) := by
    have h5 : (8 * dB + 5 : ℝ) ≤ 1 + 4 * (2 * dB + 1) * max 1 (4 * Bm / δc) := by nlinarith
    have h6 : 0 ≤ 1 + 4 * (2 * (dB : ℝ) + 1) * max 1 (4 * Bm / δc) := by positivity
    nlinarith
  have hrest : 0 ≤ A.famVtxBound * (fp.K.potMax A.famVtxBound + 1) * (N + 1) *
      (Bm * (4 * max 1 (4 * Bm / δc) + 1) ^ (4 * dB)) := by positivity
  have hcol : 4 ≤ A.colBudget ^ 2 * (Bm ^ 2 + 1) := by nlinarith only [hcb]
  have hsq : 0 ≤ (Real.sqrt N + 1) * A.colBudget * Bm := by positivity
  have hHp : 0 ≤ fp.Hed ^ (dB * dB) := pow_nonneg (by linarith) _
  have he := Real.exp_pos k
  have hms : fp.Hed ^ (dB * dB) + 1 ≤ fp.modeStar D dB H δc N k ∧
      (8 * dB + 5 : ℝ) ≤ fp.modeStar D dB H δc N k := by
    unfold modeStar
    constructor <;> linarith
  have hQ : (fp.Q0bd dB : ℝ) ≤ fp.Hed ^ (dB * dB) + 1 := by
    unfold Q0bd
    exact (Nat.ceil_lt_add_one hHp).le
  refine ⟨?_, hQ.trans (hms.1.trans hst)⟩
  push_cast
  linarith [hms.2]

/-- Blueprint line 2839, the uniform first-match and mode parameter bounds of one attempt
(lines 1934, 1944 and `eq:mode-parameters`): for the absolute constants of the schedule there is
`M` such that, for every attempt with `H_ed ≥ 2`, center dimensions at most `d_B` and center
entries of height at most `H_ed`, and every main budget `D_m ≥ 2`, there is a schedule `S` with
`d_max = 2 d_B + 2`, the enlarged budget `D_* = modeStarG`, the common cutoff
`B_* = Q₀ 2^(K_*+1)`, `D_m`, and the clearing bound `Q₀` as `S.Q0`, satisfying
`eq:mode-parameters` with the packet width of lem:height at the chosen height. Moreover
`d_max ≤ D_*`, `Q₀ ≤ D_*`, every group center has its clearing integer in `[1, Q₀]` (the
per-group `Q₀` of line 1890), the box of `K_*` fits in `B_*`, the width bound used by the linear
sides holds, and `log H`, `log T`, `K` are polynomial in
`Λ = d_max + log D_* + log B_* + log D_m + log Q₀ + 1`. -/
theorem exists_leaf_schedule (Cj CA CT CK : ℕ) {δs : ℝ} (hδs : 0 < δs) (hδs1 : δs ≤ 1) :
    ∃ M : ℝ, 0 < M ∧ ∀ {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀}
      {bf : A.BasicFamilies} (fp : bf.FamParams) (D dB : ℕ) {H δc N : ℝ} (k : ℝ) {δ Dm : ℝ},
      0 < δ → 2 ≤ fp.Hed → 1 ≤ H → 0 < δc → 0 ≤ N → 2 ≤ Dm →
      (∀ w : bf.Vtx, (bf.vtag w).dim ≤ dB) →
      (∀ (w : bf.Vtx) a c, (rationalHeight ((bf.vtag w).C a c) : ℝ) ≤ fp.Hed) →
      let Λ := ((2 * dB + 2 : ℕ) : ℝ) + Real.log (fp.modeStarG D dB H δc N k δ) +
        Real.log (fp.Bst D dB H δc N k δ) + Real.log Dm + Real.log (fp.Q0bd dB) + 1
      ∃ S : ModeSchedule, S.dmax = 2 * dB + 2 ∧ S.Dstar = fp.modeStarG D dB H δc N k δ ∧
        S.Bstar = fp.Bst D dB H δc N k δ ∧ S.Dm = Dm ∧ S.Q0 = fp.Q0bd dB ∧
        S.Valid Cj CA CT CK δs (packetW S.dmax S.H) ∧
        8 * ((S.dmax : ℝ) + 1) ^ 3 * Real.log (2 * S.H) / Real.log 2 ≤ packetW S.dmax S.H ∧
        2 ≤ S.dmax ∧ (S.dmax : ℝ) ≤ S.Dstar ∧ 2 ≤ S.Dstar ∧ 2 ≤ S.Bstar ∧ 1 ≤ S.Q0 ∧
        (S.Q0 : ℝ) ≤ S.Dstar ∧
        (∀ z : bf.Vtx, 1 ≤ clearInt (bf.vtag z).C ∧ clearInt (bf.vtag z).C ≤ S.Q0) ∧
        (S.Q0 : ℝ) * 2 ^ (fp.Kstar D dB H δc N k δ + 1) ≤ S.Bstar ∧
        Real.log S.H ≤ M * Λ ^ 12 ∧ Real.log S.T ≤ M * Λ ^ 16 ∧ (S.K : ℝ) ≤ M * Λ ^ 16 := by
  obtain ⟨M, hM, hsch⟩ := exists_attempt_schedule Cj CA CT CK hδs hδs1
  refine ⟨M, hM, ?_⟩
  intro κ c₀ A bf fp D dB H δc N k δ Dm hδ hHed hH hδc hN0 hDm hdim hC Λ
  obtain ⟨hdD, hQD⟩ := fp.dmax_Q0bd_le_modeStarG D dB k hδ hHed hH hδc hN0
  have hd2 : 2 ≤ 2 * dB + 2 := by omega
  have hD2 : (2 : ℝ) ≤ fp.modeStarG D dB H δc N k δ := by
    refine le_trans ?_ hdD
    push_cast
    have : (0 : ℝ) ≤ dB := Nat.cast_nonneg _
    linarith
  have hQ1 := fp.one_le_Q0bd dB hHed
  have hB2 : (2 : ℝ) ≤ fp.Bst D dB H δc N k δ := by
    unfold Bst
    have h1 : (1 : ℝ) ≤ fp.Q0bd dB := by exact_mod_cast hQ1
    have h2 : (2 : ℝ) ≤ 2 ^ (fp.Kstar D dB H δc N k δ + 1) := by
      calc (2 : ℝ) = 2 ^ 1 := (pow_one 2).symm
        _ ≤ _ := pow_le_pow_right₀ (by norm_num) (by omega)
    nlinarith only [h1, h2]
  have hS := hsch (2 * dB + 2) (fp.modeStarG D dB H δc N k δ) (fp.Bst D dB H δc N k δ) Dm
    (fp.Q0bd dB) hd2 hD2 hB2 hDm hQ1
  obtain ⟨S, h1, h2, h3, h4, h5, hV, hHb, hTb, hKb⟩ := hS
  have hHpos : 0 < S.H := lt_of_le_of_lt (by positivity) hV.H_gt
  have hV' : S.Valid Cj CA CT CK δs (packetW S.dmax S.H) := by rw [h1]; exact hV
  refine ⟨S, h1, h2, h3, h4, h5, hV', packetW_ge S.dmax hHpos, h1 ▸ hd2, ?_, h2 ▸ hD2, h3 ▸ hB2,
    h5 ▸ hQ1, ?_, fun z => h5 ▸ fp.clearInt_le_Q0bd hdim hHed hC z, ?_, hHb, hTb, hKb⟩
  · rw [h1, h2]; exact hdD
  · rw [h5, h2]; exact hQD
  · rw [h5, h3]; unfold Bst; exact le_rfl

end ActiveSetup.BasicFamilies.FamParams


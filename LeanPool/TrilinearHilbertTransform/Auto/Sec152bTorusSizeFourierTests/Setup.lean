      min 1 |D.threeBeta G I xs h' l a| < 2 * D.threeMuBand G I xs h' l a ∧
      D.U0⁻¹ / 2 < D.threeMuBand G I xs h' l a ∧ D.threeMuBand G I xs h' l a ≤ 1 ∧
    D.threeNuBand G I xs h' l a ≤ max 1 |D.threeBeta G I xs h' l a| ∧
      max 1 |D.threeBeta G I xs h' l a| < 2 * D.threeNuBand G I xs h' l a ∧
      1 ≤ D.threeNuBand G I xs h' l a ∧ D.threeNuBand G I xs h' l a ≤ D.U0 := by
  obtain ⟨hne, hin⟩ := hp
  obtain ⟨-, hβ⟩ := D.threeRef_spec hD hne

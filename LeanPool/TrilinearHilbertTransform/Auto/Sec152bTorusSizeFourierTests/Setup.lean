open Classical in
/-- The windows of radius `2^i` inside the windows of radius `2^I` do not depend on `I ≥ i`. -/
theorem windowSet_filter_eq {ν : Type*} (N : Finset ν) (c : ν → ℝ) {i I J : ℕ} (hiI : i ≤ I)
    (hIJ : I ≤ J) :
    (windowSet N c J).filter (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + -c n| ≤ 2 ^ i) =
      (windowSet N c I).filter (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + -c n| ≤ 2 ^ i) := by
  have hmem : ∀ K : ℕ, i ≤ K → ∀ k : ℤ, (∃ n ∈ N, |(k : ℝ) + -c n| ≤ 2 ^ i) →
      k ∈ windowSet N c K := by
    intro K hK k ⟨n, hn, hk⟩
    have h2 : (2 : ℝ) ^ i ≤ 2 ^ K := pow_le_pow_right₀ (by norm_num) hK
    refine Finset.mem_biUnion.mpr ⟨n, hn, Finset.mem_Icc.mpr ⟨?_, ?_⟩⟩
    · exact Int.ceil_le.mpr (by linarith [(abs_le.mp hk).1])
    · exact Int.le_floor.mpr (by linarith [(abs_le.mp hk).2])
  ext k
  simp only [Finset.mem_filter]
  constructor
  · rintro ⟨-, hk⟩; exact ⟨hmem I hiI k hk, hk⟩
  · rintro ⟨-, hk⟩; exact ⟨hmem J (hiI.trans hIJ) k hk, hk⟩

/-- The windows of radius `2^I` around the references contain at most `|N| (2^{I+1} + 1)`
integers. -/
theorem card_windowSet_le {ν : Type*} (N : Finset ν) (c : ν → ℝ) (I : ℕ) :
    ((windowSet N c I).card : ℝ) ≤ N.card * (2 * 2 ^ I + 1) := by
  unfold windowSet
  have h1 := Finset.card_biUnion_le (s := N)
    (t := fun n => Finset.Icc ⌈c n - 2 ^ I⌉ ⌊c n + 2 ^ I⌋)
  have h2 : ∀ n ∈ N, ((Finset.Icc ⌈c n - 2 ^ I⌉ ⌊c n + 2 ^ I⌋).card : ℝ) ≤ 2 * 2 ^ I + 1 := by
    intro n _
    rw [Int.card_Icc]
    have hf : (⌊c n + 2 ^ I⌋ : ℝ) ≤ c n + 2 ^ I := Int.floor_le _
    have hc : c n - 2 ^ I ≤ (⌈c n - 2 ^ I⌉ : ℝ) := Int.le_ceil _
    have hz : ⌊c n + 2 ^ I⌋ + 1 - ⌈c n - 2 ^ I⌉ ≤ 2 * 2 ^ I + 1 := by
      have : ((⌊c n + 2 ^ I⌋ + 1 - ⌈c n - 2 ^ I⌉ : ℤ) : ℝ) ≤ ((2 * 2 ^ I + 1 : ℤ) : ℝ) := by
        push_cast; linarith
      exact_mod_cast this
    have hnn := Int.toNat_le_toNat hz
    have e : ((2 * 2 ^ I + 1 : ℤ)).toNat = 2 * 2 ^ I + 1 := by
      rw [show (2 * 2 ^ I + 1 : ℤ) = ((2 * 2 ^ I + 1 : ℕ) : ℤ) by push_cast; ring,
        Int.toNat_natCast]
    rw [e] at hnn
    exact_mod_cast hnn
  calc ((N.biUnion fun n => Finset.Icc ⌈c n - 2 ^ I⌉ ⌊c n + 2 ^ I⌋).card : ℝ)
      ≤ ∑ n ∈ N, ((Finset.Icc ⌈c n - 2 ^ I⌉ ⌊c n + 2 ^ I⌋).card : ℝ) := by exact_mod_cast h1
    _ ≤ ∑ _n ∈ N, (2 * 2 ^ I + 1 : ℝ) := Finset.sum_le_sum h2
    _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]

/-- The dyadic shells beyond `2^I`: `Σ_{I < i ≤ I'} 2^{-i(A+1)} ≤ 2 · 2^{-(I+1)(A+1)}`. -/
theorem shell_tail_sum (A I I' : ℕ) :
    ∑ i ∈ Finset.Ico (I + 1) (I' + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) ≤
      2 * ((2 : ℝ) ^ (I + 1))⁻¹ ^ (A + 1) := by
  set x : ℝ := ((2 : ℝ)⁻¹) ^ (A + 1) with hx
  have hx0 : 0 ≤ x := by positivity
  have hx1 : x ≤ 1 / 2 := by
    rw [hx, pow_succ]
    have : ((2 : ℝ)⁻¹) ^ A ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
    nlinarith
  have e : ∀ i : ℕ, ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) = x ^ i := fun i => by
    rw [hx, ← pow_mul, ← inv_pow, ← pow_mul, mul_comm]
  simp_rw [e]
  refine (geom_sum_Ico_le_of_lt_one hx0 (by linarith)).trans ?_
  rw [div_le_iff₀ (by linarith)]
  have h2 : 0 ≤ x ^ (I + 1) := pow_nonneg hx0 _
  nlinarith

section ThreeCoreMainL2
variable {κ : LocalKernelClass} {a₀ r : ℝ} {w : ℝ × ℝ → ℂ}

open Classical in
/-- Blueprint `eq:side-windows` (lines 2549-2560) for the reference terms of a three-core test,
with only `ℓ²` norms: with Haar coefficients `a_n = ⟨D_{m₀}, χ_n⟩` at `1`-separated reference
frequencies `r α_n`, `|Σ_n a_n P(α_n, β₀)|` is at most
`C 2^{A+4} Σ_{Λ = 2^i ≤ 2^I} Λ^{-(A+1)} (W Π_{j ≠ l} ‖g_j‖) b_Λ` plus the shells above `2^I`,
`C 2^{A+5} 2^{-(I+1)(A+1)} (W Π_{j ≠ l} ‖g_j‖) (r ∫_I |S|²)^{1/2}` ("shells above `U₀` are
negligible by the same estimate or ordinary `L²` pairing"), for `A ≥ 1` (`three_core_main` at every
larger shell cutoff, `cell_coeff_bessel`, and the vanishing of its `ℓ¹` remainder). -/
theorem three_core_main_l2 (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4)
    (S : ℝ → ℂ) (hS : IntegrableOn S (Set.Ico a₀ (a₀ + r)))
    (hS2 : MemLp S 2 (volume.restrict (Set.Ioc a₀ (a₀ + r)))) (x₀ : ℝ) {d : ℕ}
    (V : Submodule ℚ (Fin d → ℚ))
    (Rm : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ) (hRm : Continuous Rm) {W : ℝ}
    (hW : 0 ≤ W) (hRb : ∀ z, ‖Rm z‖ ≤ W)
    (g : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℂ)
    (hg : ∀ i, Continuous (g i)) (m₀ : Fin d → ℤ) (N : Finset (Fin d → ℤ))
    (hN : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → n - n' ∉ rationalIntegerIntersection V)
    (αN : (Fin d → ℤ) → ℝ) (β₀ : ℝ)
    (hsep : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → 1 ≤ |-(r * αN n) - -(r * αN n')|) (J A I : ℕ)
    (hA : 1 ≤ A) :
    ‖∑ n ∈ N, (∫ u, dualSlice V Rm l g m₀ u * starRingEnd ℂ (torusCharacter n u)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) *
          anchorP r w l S x₀ (αN n) β₀‖ ≤
      r⁻¹ * entryC κ J A (r * β₀) * 2 ^ (A + 4) * ∑ i ∈ Finset.range (I + 1),
          ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) *
          ((W * ∏ i ∈ Finset.univ.erase l, (eLpNorm (g i) 2
            (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal) *
            Real.sqrt (∑ k ∈ (windowSet N (fun n => r * αN n) I).filter
              (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + -(r * αN n)| ≤ 2 ^ i),
                ‖∫ y in Set.Ico a₀ (a₀ + r), S y *
                  Complex.exp (2 * Real.pi * Complex.I * k * y / r)‖ ^ 2)) +
      r⁻¹ * entryC κ J A (r * β₀) * 2 ^ (A + 4) * (2 * ((2 : ℝ) ^ (I + 1))⁻¹ ^ (A + 1)) *
        ((W * ∏ i ∈ Finset.univ.erase l, (eLpNorm (g i) 2
            (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal) *
          Real.sqrt (r * ∫ y in a₀..a₀ + r, ‖S y‖ ^ 2)) := by
  set Ce := r⁻¹ * entryC κ J A (r * β₀) with hCe
  have hCe0 : 0 ≤ Ce := mul_nonneg (inv_nonneg.mpr hr.le) (entryC_nonneg hr hw J A _)
  set G := W * ∏ i ∈ Finset.univ.erase l, (eLpNorm (g i) 2
    (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal with hG
  have hG0 : 0 ≤ G := mul_nonneg hW (Finset.prod_nonneg fun _ _ => ENNReal.toReal_nonneg)
  set! s : ℤ → ℂ := fun k => ∫ y in Set.Ico a₀ (a₀ + r), S y *
    Complex.exp (2 * Real.pi * Complex.I * k * y / r) with hs
  set B2 := Real.sqrt (r * ∫ y in a₀..a₀ + r, ‖S y‖ ^ 2) with hB2
  have hbes : ∀ K : Finset ℤ, Real.sqrt (∑ k ∈ K, ‖s k‖ ^ 2) ≤ B2 := fun K =>
    Real.sqrt_le_sqrt (cell_coeff_bessel hr S hS2 K)
  set! S1 := ∫ y in Set.Ico a₀ (a₀ + r), ‖S y‖ with hS1
  have hS10 : 0 ≤ S1 := setIntegral_nonneg measurableSet_Ico fun _ _ => norm_nonneg _
  set! aN : (Fin d → ℤ) → ℂ := fun n => ∫ u, dualSlice V Rm l g m₀ u *
    starRingEnd ℂ (torusCharacter n u) ∂torusAnnihilatorHaar (rationalIntegerIntersection V)
  set! SA := ∑ n ∈ N, ‖aN n‖ with hSA
  have hSA0 : 0 ≤ SA := Finset.sum_nonneg fun _ _ => norm_nonneg _
  set c : (Fin d → ℤ) → ℝ := fun n => r * αN n with hc
  set M := Ce * 2 ^ (A + 4) * ∑ i ∈ Finset.range (I + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) *
    (G * Real.sqrt (∑ k ∈ (windowSet N c I).filter
      (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + -c n| ≤ 2 ^ i), ‖s k‖ ^ 2)) with hM
  set T := Ce * 2 ^ (A + 4) * (2 * ((2 : ℝ) ^ (I + 1))⁻¹ ^ (A + 1)) * (G * B2) with hT
  set! C0 := Ce * S1 * SA * (3 * N.card + 12) with hC0
  have hC00 : 0 ≤ C0 := by positivity
  -- the bound at every larger shell cutoff
  have hstep : ∀ I', I ≤ I' → ‖∑ n ∈ N, aN n * anchorP r w l S x₀ (αN n) β₀‖ ≤
      M + T + C0 * ((2 : ℝ) ^ I')⁻¹ := by
    intro I' hII'
    have h := three_core_main hr hw l S hS x₀ V Rm hRm hW hRb g hg m₀ N hN αN β₀ hsep J A I'
    refine h.trans ?_
    -- the window part
    have hsplit : ∑ i ∈ Finset.range (I' + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) *
        (G * Real.sqrt (∑ k ∈ (windowSet N c I').filter
          (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + -c n| ≤ 2 ^ i), ‖s k‖ ^ 2)) ≤
        ∑ i ∈ Finset.range (I + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) *
          (G * Real.sqrt (∑ k ∈ (windowSet N c I).filter
            (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + -c n| ≤ 2 ^ i), ‖s k‖ ^ 2)) +
        (2 * ((2 : ℝ) ^ (I + 1))⁻¹ ^ (A + 1)) * (G * B2) := by
      rw [Finset.range_eq_Ico, Finset.range_eq_Ico,
        ← Finset.sum_Ico_consecutive _ (Nat.zero_le (I + 1)) (by omega : I + 1 ≤ I' + 1)]
      refine add_le_add (le_of_eq (Finset.sum_congr rfl fun i hi => ?_)) ?_
      · rw [windowSet_filter_eq N c (by have := (Finset.mem_Ico.mp hi).2; omega) hII']
      · calc ∑ i ∈ Finset.Ico (I + 1) (I' + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) *
              (G * Real.sqrt (∑ k ∈ (windowSet N c I').filter
                (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + -c n| ≤ 2 ^ i), ‖s k‖ ^ 2))
            ≤ ∑ i ∈ Finset.Ico (I + 1) (I' + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) * (G * B2) :=
              Finset.sum_le_sum fun i _ => mul_le_mul_of_nonneg_left
                (mul_le_mul_of_nonneg_left (hbes _) hG0) (by positivity)
          _ = (∑ i ∈ Finset.Ico (I + 1) (I' + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 1)) * (G * B2) := by
              rw [Finset.sum_mul]
          _ ≤ _ := mul_le_mul_of_nonneg_right (shell_tail_sum A I I')
              (mul_nonneg hG0 (Real.sqrt_nonneg _))
    -- the remainders
    have hW' : ∑ k ∈ windowSet N c I', ‖s k‖ ≤ N.card * (2 * 2 ^ I' + 1) * S1 := by
      calc ∑ k ∈ windowSet N c I', ‖s k‖ ≤ ∑ _k ∈ windowSet N c I', S1 :=
            Finset.sum_le_sum fun k _ => norm_cellCoeff_le S k
        _ = (windowSet N c I').card * S1 := by rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ _ := mul_le_mul_of_nonneg_right (card_windowSet_le N c I') hS10
    have h2I : (0 : ℝ) < 2 ^ I' := by positivity
    have hq : ((2 : ℝ) ^ I')⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (one_le_pow₀ (by norm_num))
    have hq0 : 0 ≤ ((2 : ℝ) ^ I')⁻¹ := by positivity
    have hr1 : Ce * ((2 : ℝ) ^ I')⁻¹ ^ (A + 2) * (SA * ∑ k ∈ windowSet N c I', ‖s k‖) ≤
        Ce * S1 * SA * (3 * N.card) * ((2 : ℝ) ^ I')⁻¹ := by
      have h1 : ((2 : ℝ) ^ I')⁻¹ ^ (A + 2) * (2 * 2 ^ I' + 1) ≤ 3 * ((2 : ℝ) ^ I')⁻¹ := by
        have hX1 : ((2 : ℝ) ^ I')⁻¹ * 2 ^ I' = 1 := inv_mul_cancel₀ (by positivity)
        have e : ((2 : ℝ) ^ I')⁻¹ ^ (A + 2) * (2 * 2 ^ I' + 1) =
            ((2 : ℝ) ^ I')⁻¹ ^ A * (((2 : ℝ) ^ I')⁻¹ * (2 + ((2 : ℝ) ^ I')⁻¹)) := by
          calc ((2 : ℝ) ^ I')⁻¹ ^ (A + 2) * (2 * 2 ^ I' + 1) =
              ((2 : ℝ) ^ I')⁻¹ ^ A * (((2 : ℝ) ^ I')⁻¹ * (2 * (((2 : ℝ) ^ I')⁻¹ * 2 ^ I') +
                ((2 : ℝ) ^ I')⁻¹)) := by ring
            _ = _ := by rw [hX1]; ring
        rw [e]
        have hA' : ((2 : ℝ) ^ I')⁻¹ ^ A ≤ 1 := pow_le_one₀ hq0 hq
        have : ((2 : ℝ) ^ I')⁻¹ * (2 + ((2 : ℝ) ^ I')⁻¹) ≤ 3 * ((2 : ℝ) ^ I')⁻¹ := by
          nlinarith only [hq, hq0]
        calc ((2 : ℝ) ^ I')⁻¹ ^ A * (((2 : ℝ) ^ I')⁻¹ * (2 + ((2 : ℝ) ^ I')⁻¹)) ≤
            1 * (3 * ((2 : ℝ) ^ I')⁻¹) := mul_le_mul hA' this (by positivity) (by norm_num)
          _ = _ := one_mul _
      calc Ce * ((2 : ℝ) ^ I')⁻¹ ^ (A + 2) * (SA * ∑ k ∈ windowSet N c I', ‖s k‖) ≤
          Ce * ((2 : ℝ) ^ I')⁻¹ ^ (A + 2) * (SA * (N.card * (2 * 2 ^ I' + 1) * S1)) := by
            gcongr
        _ = Ce * S1 * SA * N.card * (((2 : ℝ) ^ I')⁻¹ ^ (A + 2) * (2 * 2 ^ I' + 1)) := by ring
        _ ≤ Ce * S1 * SA * N.card * (3 * ((2 : ℝ) ^ I')⁻¹) := by gcongr
        _ = _ := by ring
    have hr2 : 12 * (Ce * ((2 : ℝ) ^ I')⁻¹ ^ A) * S1 * SA ≤
        Ce * S1 * SA * 12 * ((2 : ℝ) ^ I')⁻¹ := by
      have hA' : ((2 : ℝ) ^ I')⁻¹ ^ A ≤ ((2 : ℝ) ^ I')⁻¹ := by
        calc ((2 : ℝ) ^ I')⁻¹ ^ A ≤ ((2 : ℝ) ^ I')⁻¹ ^ 1 := pow_le_pow_of_le_one hq0 hq hA
          _ = _ := pow_one _
      have : 0 ≤ Ce * S1 * SA := by positivity
      nlinarith only [hC0, hC00, hA']
    have hmain : Ce * 2 ^ (A + 4) * ∑ i ∈ Finset.range (I' + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) *
        (G * Real.sqrt (∑ k ∈ (windowSet N c I').filter
          (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + -c n| ≤ 2 ^ i), ‖s k‖ ^ 2)) ≤ M + T := by
      have h0 : 0 ≤ Ce * 2 ^ (A + 4) := by positivity
      calc _ ≤ Ce * 2 ^ (A + 4) * (∑ i ∈ Finset.range (I + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) *
            (G * Real.sqrt (∑ k ∈ (windowSet N c I).filter
              (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + -c n| ≤ 2 ^ i), ‖s k‖ ^ 2)) +
            (2 * ((2 : ℝ) ^ (I + 1))⁻¹ ^ (A + 1)) * (G * B2)) :=
            mul_le_mul_of_nonneg_left hsplit h0
        _ = M + T := by rw [hM, hT]; ring
    have e : C0 * ((2 : ℝ) ^ I')⁻¹ = Ce * S1 * SA * (3 * N.card) * ((2 : ℝ) ^ I')⁻¹ +
        Ce * S1 * SA * 12 * ((2 : ℝ) ^ I')⁻¹ := by rw [hC0]; ring
    rw [e]
    linarith only [hr1, hr2, hmain]
  -- letting the shell cutoff tend to infinity
  refine le_of_forall_pos_lt_add fun ε hε => ?_
  obtain ⟨K, hK⟩ := exists_pow_lt_of_lt_one (show 0 < ε / (C0 + 1) by positivity)
    (show (1 / 2 : ℝ) < 1 by norm_num)
  have hI' := hstep (I + K) (by omega)
  have hpow : ((2 : ℝ) ^ (I + K))⁻¹ ≤ (1 / 2 : ℝ) ^ K := by
    rw [one_div, inv_pow]
    exact inv_anti₀ (by positivity) (pow_le_pow_right₀ (by norm_num) (by omega))
  have hC1 : C0 * ((2 : ℝ) ^ (I + K))⁻¹ < ε := by
    calc C0 * ((2 : ℝ) ^ (I + K))⁻¹ ≤ (C0 + 1) * ((1 / 2 : ℝ) ^ K) :=
          mul_le_mul (by linarith) hpow (by positivity) (by positivity)
      _ < (C0 + 1) * (ε / (C0 + 1)) := mul_lt_mul_of_pos_left hK (by positivity)
      _ = ε := by field_simp
  linarith

end ThreeCoreMainL2

section ThreeCoreAnchoredL2
variable {κ : LocalKernelClass} {a₀ r : ℝ} {w : ℝ × ℝ → ℂ}

open Classical in
/-- `three_core_anchored_bound` with only `ℓ²` norms in its main term (blueprint
`eq:side-windows`, lines 2549-2560): the window bound over the shells `Λ = 2^i ≤ 2^I` plus the
shells above `2^I` bounded by the `L²` norm of the side on the cell (`three_core_main_l2`), plus the
numerical errors `2‖w‖_∞ ε r⁻¹ ‖f_l‖_{L¹}` and the near and far coset terms
`Σ_x |C_x| r⁻¹ ‖f_l‖_{L¹} (nearB(ε₁) + 12 C_J (4/H)^{J-2})`, for `A ≥ 1`. -/
theorem three_core_anchored_bound_l2 (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w)
    (l : Fin 4)
    (Fc : ℝ × ℝ → ℂ) (Sd : ℝ → ℂ) (hfm : AEStronglyMeasurable Sd volume)
    (hfl : IntegrableOn Sd (Set.Icc a₀ (a₀ + r)))
    (hS2 : MemLp Sd 2 (volume.restrict (Set.Ioc a₀ (a₀ + r))))
    (hfi : Integrable (fun z : ℝ × ℝ => w z * (Fc z * Sd (realProgressionCoordinate l z))))
    {x₀ : ℝ} (hx₀ : x₀ ∈ Set.Icc a₀ (a₀ + r)) {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))
    {ι : Type*} (P : Finset ι) (C : ι → ℂ) (fr : ι → (Fin d → ℤ) × (Fin d → ℤ))
    (α β : ι → ℝ) {ε : ℝ} (hε0 : 0 ≤ ε)
    (hε : ∀ z : ℝ × ℝ, w z ≠ 0 → ‖Fc z -
      ∑ x ∈ P, C x * (Real.fourierChar (α x * (realProgressionCoordinate l z - x₀) +
        β x * z.2) : ℂ)‖ ≤ ε)
    (Rm : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ) (hRm : Continuous Rm) {W : ℝ}
    (hW : 0 ≤ W) (hRb : ∀ z, ‖Rm z‖ ≤ W)
    (g : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℂ)
    (hg : ∀ i, Continuous (g i))
    (hexp : ∀ u v, Rm (u, v) * ∏ i ∈ Finset.univ.erase l, g i (u + ((i : ℤ) - (l : ℤ)) • v) =
      ∑ x ∈ P, C x * (torusCharacter (fr x).1 u * torusCharacter (fr x).2 v))
    (m₀ : Fin d → ℤ) (N : Finset (Fin d → ℤ))
    (hN : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → n - n' ∉ rationalIntegerIntersection V)
    (αN : (Fin d → ℤ) → ℝ) (β₀ : ℝ)
    (hsep : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → 1 ≤ |-(r * αN n) - -(r * αN n')|)
    (nref : ι → Fin d → ℤ) {ε₁ H : ℝ} (hε₁ : 0 ≤ ε₁) (hH : 4 ≤ H)
    (hnear : ∀ x ∈ P, (fr x).2 - m₀ ∈ rationalIntegerIntersection V →
      nref x ∈ N ∧ (fr x).1 - nref x ∈ rationalIntegerIntersection V ∧
        |r * α x - r * αN (nref x)| ≤ ε₁ ∧ |r * β x - r * β₀| ≤ ε₁)
    (hfar : ∀ x ∈ P, (fr x).2 - m₀ ∉ rationalIntegerIntersection V → H ≤ |r * β x|)
    {J : ℕ} (hJ : 2 ≤ J) (A I : ℕ) (hA : 1 ≤ A) :
    ‖(r : ℂ)⁻¹ ^ 2 * ∫ z, w z * (Fc z * Sd (realProgressionCoordinate l z))‖ ≤
      2 * localKernelSupBound κ * ε * (r⁻¹ * ∫ y in Set.Icc a₀ (a₀ + r), ‖Sd y‖) +
      (r⁻¹ * entryC κ J A (r * β₀) * 2 ^ (A + 4) * ∑ i ∈ Finset.range (I + 1),
          ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) *
          ((W * ∏ i ∈ Finset.univ.erase l, (eLpNorm (g i) 2
            (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal) *
            Real.sqrt (∑ k ∈ (windowSet N (fun n => r * αN n) I).filter
              (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + -(r * αN n)| ≤ 2 ^ i),
                ‖∫ y in Set.Ico a₀ (a₀ + r), Sd y *
                  Complex.exp (2 * Real.pi * Complex.I * k * y / r)‖ ^ 2)) +
        r⁻¹ * entryC κ J A (r * β₀) * 2 ^ (A + 4) * (2 * ((2 : ℝ) ^ (I + 1))⁻¹ ^ (A + 1)) *
          ((W * ∏ i ∈ Finset.univ.erase l, (eLpNorm (g i) 2
              (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal) *
            Real.sqrt (r * ∫ y in a₀..a₀ + r, ‖Sd y‖ ^ 2))) +
      (∑ x ∈ P, ‖C x‖) * (r⁻¹ * (∫ y in Set.Ico a₀ (a₀ + r), ‖Sd y‖) *
        (nearB κ ε₁ + 12 * (kerC κ J * (4 / H) ^ (J - 2)))) := by
  have hS : IntegrableOn Sd (Set.Ico a₀ (a₀ + r)) := hfl.mono_set Set.Ico_subset_Icc_self
  have happrox := anchoredForm_phase_approx hr hw l Fc Sd hfm hfl hfi P C α β x₀ hε0 hε
  have hcol := three_core_collect r w l Sd x₀ V P C fr α β Rm g hexp m₀ N hN αN β₀ nref
    (fun x hx h => ⟨(hnear x hx h).1, (hnear x hx h).2.1⟩)
  have hmain := three_core_main_l2 hr hw l Sd hS hS2 x₀ V Rm hRm hW hRb g hg m₀ N hN αN β₀ hsep
    J A I hA
  set S1 := ∫ y in Set.Ico a₀ (a₀ + r), ‖Sd y‖
  have hS1 : 0 ≤ S1 := setIntegral_nonneg measurableSet_Ico fun _ _ => norm_nonneg _
  set B := r⁻¹ * S1 * (nearB κ ε₁ + 12 * (kerC κ J * (4 / H) ^ (J - 2)))
  have hnB : 0 ≤ nearB κ ε₁ := by
    unfold nearB
    have := kerC_nonneg hr hw 2
    positivity
  have hfB : 0 ≤ 12 * (kerC κ J * (4 / H) ^ (J - 2)) := by
    have := kerC_nonneg hr hw J
    have : 0 ≤ 4 / H := by positivity
    positivity
  -- near terms
  have hnearT : ∀ x ∈ P.filter (fun x => (fr x).2 - m₀ ∈ rationalIntegerIntersection V),
      ‖C x * (anchorP r w l Sd x₀ (α x) (β x) - anchorP r w l Sd x₀ (αN (nref x)) β₀)‖ ≤
        ‖C x‖ * B := by
    intro x hx
    obtain ⟨hxP, hxn⟩ := Finset.mem_filter.mp hx
    obtain ⟨-, -, hα, hβ⟩ := hnear x hxP hxn
    obtain ⟨hs, hb⟩ := anchorK_near hr hw l hx₀ (α x) (β x) (αN (nref x)) β₀
    rw [norm_mul]
    refine mul_le_mul_of_nonneg_left ((anchorP_sub_le hr hw l Sd hS x₀ _ _ _ _ hs).trans ?_)
      (norm_nonneg _)
    simp only [B]
    refine mul_le_mul_of_nonneg_left (hb.trans ?_) (by positivity)
    have hn : 24 * Real.sqrt (2 * 4 * (2 * 4 * (2 * Real.pi * 4 *
        (4 * |r * α x - r * αN (nref x)| + |r * β x - r * β₀|) * kernelDerivBound κ 0))) *
          Real.sqrt (kerC κ 4) + Real.pi * |r * α x - r * αN (nref x)| * (12 * kerC κ 2) ≤
        nearB κ ε₁ := by
      unfold nearB
      have hA0 : 0 ≤ kernelDerivBound κ 0 :=
        (norm_nonneg _).trans ((unitKernel_bounds hr hw).dx 0 0 0)
      have h2 := kerC_nonneg hr hw 2
      gcongr
    exact hn.trans (le_add_of_nonneg_right hfB)
  -- far terms
  have hfarT : ∀ x ∈ P.filter (fun x => (fr x).2 - m₀ ∉ rationalIntegerIntersection V),
      ‖C x * anchorP r w l Sd x₀ (α x) (β x)‖ ≤ ‖C x‖ * B := by
    intro x hx
    obtain ⟨hxP, hxn⟩ := Finset.mem_filter.mp hx
    have hH' := hfar x hxP hxn
    obtain ⟨hs, hb⟩ := anchorK_far hr hw l hJ x₀ (α x) (β x) (hH.trans hH')
    rw [norm_mul]
    refine mul_le_mul_of_nonneg_left ((anchorP_norm_le hr hw l Sd hS x₀ _ _ hs).trans ?_)
      (norm_nonneg _)
    simp only [B]
    refine mul_le_mul_of_nonneg_left (hb.trans ?_) (by positivity)
    have hdec : kerC κ J * (4 / |r * β x|) ^ (J - 2) ≤ kerC κ J * (4 / H) ^ (J - 2) := by
      have := kerC_nonneg hr hw J
      gcongr
    exact (mul_le_mul_of_nonneg_left hdec (by norm_num)).trans (le_add_of_nonneg_left hnB)
  have hsplit : ∑ x ∈ P.filter (fun x => (fr x).2 - m₀ ∈ rationalIntegerIntersection V),
      ‖C x‖ * B + ∑ x ∈ P.filter (fun x => (fr x).2 - m₀ ∉ rationalIntegerIntersection V),
        ‖C x‖ * B = (∑ x ∈ P, ‖C x‖) * B := by
    rw [Finset.sum_filter_add_sum_filter_not, Finset.sum_mul]
  calc ‖(r : ℂ)⁻¹ ^ 2 * ∫ z, w z * (Fc z * Sd (realProgressionCoordinate l z))‖ ≤
        ‖(r : ℂ)⁻¹ ^ 2 * (∫ z, w z * (Fc z * Sd (realProgressionCoordinate l z))) -
        ∑ x ∈ P, C x * anchorP r w l Sd x₀ (α x) (β x)‖ +
        ‖∑ x ∈ P, C x * anchorP r w l Sd x₀ (α x) (β x)‖ :=
        (norm_le_insert' _ _).trans (le_of_eq (add_comm _ _))
    _ ≤ 2 * localKernelSupBound κ * ε * (r⁻¹ * ∫ y in Set.Icc a₀ (a₀ + r), ‖Sd y‖) +
        (‖∑ n ∈ N, (∫ u, dualSlice V Rm l g m₀ u * starRingEnd ℂ (torusCharacter n u)
          ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) *
            anchorP r w l Sd x₀ (αN n) β₀‖ +
        (∑ x ∈ P.filter (fun x => (fr x).2 - m₀ ∈ rationalIntegerIntersection V), ‖C x‖ * B +
          ∑ x ∈ P.filter (fun x => (fr x).2 - m₀ ∉ rationalIntegerIntersection V),
            ‖C x‖ * B)) := by
        refine add_le_add ?_ ?_
        · exact happrox
        · rw [hcol, add_assoc]
          refine (norm_add_le _ _).trans (add_le_add le_rfl ((norm_add_le _ _).trans
            (add_le_add ((norm_sum_le _ _).trans (Finset.sum_le_sum hnearT))
              ((norm_sum_le _ _).trans (Finset.sum_le_sum hfarT)))))
    _ ≤ _ := by
        rw [hsplit, add_assoc]
        gcongr

end ThreeCoreAnchoredL2

open Classical in
/-- `three_core_Fc_approx` with the Fourier truncations of the cutoffs and of the gauge multiplier
made explicit (`gauge_torus_approx_of`): the phase-corrected coefficients `cc_j(v) = cc0_j(v)
e(v·θ x*)` and `cm(v) = cm0(v) e(v₁·θ x*/Q₀)`. -/
theorem three_core_Fc_approx_of (z : ChartTag) {δ δ'' : ℝ} (hδ : 0 < δ)
    (hδ'' : 0 < δ'') (ρ : Fin 4 → Fin z.dim → ℝ) (hρ : ∀ j a, ρ j a ∈ Set.Icc (0 : ℝ) 1)
    {Q0 : ℕ} (hQ0 : 0 < Q0) (hQ : ∀ a b, ∃ k : ℤ, (Q0 : ℝ) * (z.C a b : ℝ) = k) {Cm : ℝ}
    (hCm : ∀ a b, |(z.C a b : ℝ)| ≤ Cm) {L : ℕ} (hL : 0 < L) (Kt : ℕ)
    (xs : ℝ) (l : Fin 4) (γ : Fin 4 → ℝ) (hγl : γ l = 0) {ι : Fin 4 → Type*}
    (F : ∀ j, Finset (ι j)) (c : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin z.dim → ℤ) {k₀ : ι l}
    (hFl : F l = {k₀}) (hcl : c l k₀ = 1) (hnl : n l k₀ = 0) (f : Fin 4 → ℝ → ℂ)
    (hfl : ∀ y, f l y = (centerCut z δ (ρ l) y : ℂ) *
      (Real.fourierChar (((slotCoeff l : ℤ) : ℝ) * centerPhase z (ρ l) y) : ℂ))
    (lo hi : ℝ) {η : ℝ} (hη : 0 ≤ η)
    (hfa : ∀ j, j ≠ l → ∀ y ∈ Set.Icc lo hi, ‖f j y - ((centerCut z δ (ρ j) y : ℂ) *
      (Real.fourierChar (((slotCoeff j : ℤ) : ℝ) * centerPhase z (ρ j) y) : ℂ)) *
        ((Real.fourierChar (γ j * (y - xs)) : ℂ) * ∑ k ∈ F j, c j k *
          torusCharacter (n j k) (torusMk fun i => z.θ i / (Q0 * L) * (y - xs)))‖ ≤
            η * ∑ k ∈ F j, ‖c j k‖)
    (hfb : ∀ j, j ≠ l → ∀ y ∈ Set.Icc lo hi, ‖f j y‖ ≤ ∑ k ∈ F j, ‖c j k‖)

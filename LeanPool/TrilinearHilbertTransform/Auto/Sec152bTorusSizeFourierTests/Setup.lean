namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

open Classical in
/-- Blueprint lines 2542-2547 on a leaf cell `I` of the side states for a three-core tuple with side
role `l` passing the three-core test (reference `m₀ = threeRef`), with the gap of a good component
of any role `j₀` in the common chart (a successful core component; the side role may be role `0`):
for the anchored expansion of the
transported core data (indices `F_j`, shifts of size at most `D_* E_{h-Δ}`, multiplier and cutoff
indices in the truncation box, chart of role `0`), there are references `N`, one from the box per
horizontal coset modulo `K_B`, in distinct cosets, whose real frequencies `r(Q + n·ξ)` are more than
`1` apart; on the reference vertical coset `m₀ + K_B` every term is within `T⁻¹/L_{h-Δ}` of its
references, and off it the anchored frequency is at least `T/L_{h-Δ} - U₀` (`box_dichotomy64`,
`three_cosets_of_dichotomy`; the slopes `γ_j = ω_{a_j}(x*)` of the core roles, `γ_l = 0`). -/
theorem three_cosets {Cj CA CT CK : ℕ} {δs W : ℝ} (hV : D.S.Valid Cj CA CT CK δs W)
    (hCA : 1 ≤ CA) (hCT : 4 ≤ CT) (hd2 : 2 ≤ D.S.dmax) (hD : 2 ≤ D.S.Dstar) (hB : 2 ≤ D.S.Bstar)
    (hQ : 1 ≤ D.S.Q0) (hSP : D.SP = D.S.sideParams δs) (I : ℤ × ℤ) (G : bf.Grp) (j₀ : Fin 4)
    (hz₀ : (D.Ms j₀ G).zc = (D.Ms 0 G).zc) (hdim : (D.Ms 0 G).zc.dim ≤ D.S.dmax) {h : ℕ}
    (hh : h ≤ D.SP.Jst)

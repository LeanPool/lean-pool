          |r * (∑ j, γ j + ∑ i, (expP1 L QL n x i : ℝ) * ξ i) -
            r * (∑ j, γ j + ∑ i, (nref x i : ℝ) * ξ i)| ≤ ε₁ ∧
          |r * ((∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L QL n x i : ℝ) * ξ i) -
              ((l : ℕ) : ℝ) * (∑ j, γ j + ∑ i, (expP1 L QL n x i : ℝ) * ξ i)) -
            r * (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j - ((l : ℕ) : ℝ) * ∑ j, γ j +
              ∑ i, (m₀ i : ℝ) * ξ i)| ≤ ε₁) ∧
      (∀ x ∈ frequencyBox (d + d) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
          (fun j => frequencyBox d (2 ^ (Kt + 1)) ×ˢ F j),
        expP2 L QL n x - ((l : ℕ) : ℤ) • expP1 L QL n x - m₀ ∉ rationalIntegerIntersection V →
        H - U ≤ |r * ((∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L QL n x i : ℝ) * ξ i) -
            ((l : ℕ) : ℝ) * (∑ j, γ j + ∑ i, (expP1 L QL n x i : ℝ) * ξ i))|) := by
  set K := rationalIntegerIntersection V with hK
  set Bxs := frequencyBox (d + d) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
    (fun j => frequencyBox d (2 ^ (Kt + 1)) ×ˢ F j) with hBxs
  set! P := Bxs.image (expP1 L QL n) with hP
  -- sizes of the expansion frequencies
  have hrole : ∀ x ∈ Bxs, ∀ j i,
      |((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ)| ≤ 2 * B := by
    intro x hx j i
    have hxj := Fintype.mem_piFinset.mp (Finset.mem_product.mp hx).2 j
    obtain ⟨hv, hk⟩ := Finset.mem_product.mp hxj
    have e : ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ) =
        (QL : ℝ) * ((x.2 j).1 i : ℝ) + (n j (x.2 j).2 i : ℝ) := by
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]; push_cast; ring
    rw [e]
    refine (abs_add_le _ _).trans ?_
    linarith [hQLb _ hv i, hn j _ hk i]
  have hP1 : ∀ x ∈ Bxs, ∀ i, |(expP1 L QL n x i : ℝ)| ≤ 9 * B := by
    intro x hx i
    have hv := (Finset.mem_product.mp hx).1
    have e : ((expP1 L QL n x i : ℤ) : ℝ) = (L : ℝ) * (x.1 (Fin.castAdd d i) : ℝ) +
        ∑ j, ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ) := by
      simp only [expP1, Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
      push_cast; ring
    rw [e]
    have h1 := hLb _ hv (Fin.castAdd d i)
    have h2 : |∑ j, ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ)| ≤ 4 * (2 * B) := by
      refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      calc _ ≤ ∑ _j : Fin 4, 2 * B := Finset.sum_le_sum fun j _ => hrole x hx j i
        _ = 4 * (2 * B) := by simp
    have h3 := abs_add_le ((L : ℝ) * (x.1 (Fin.castAdd d i) : ℝ))
      (∑ j, ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ))
    linarith
  have hP2 : ∀ x ∈ Bxs, ∀ i, |(expP2 L QL n x i : ℝ)| ≤ 13 * B := by
    intro x hx i
    have hv := (Finset.mem_product.mp hx).1
    have e : ((expP2 L QL n x i : ℤ) : ℝ) = (L : ℝ) * (x.1 (Fin.natAdd d i) : ℝ) +
        ∑ j : Fin 4, ((j : ℕ) : ℝ) * ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ) := by
      simp only [expP2, Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, sub_zero]
      push_cast; ring
    rw [e]
    have h1 := hLb _ hv (Fin.natAdd d i)
    have h2 : |∑ j : Fin 4, ((j : ℕ) : ℝ) * ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ)|
        ≤ 12 * B := by
      refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      calc ∑ j : Fin 4, |((j : ℕ) : ℝ) * ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ)|
          ≤ ∑ j : Fin 4, ((j : ℕ) : ℝ) * (2 * B) := Finset.sum_le_sum fun j _ => by
            rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
            exact mul_le_mul_of_nonneg_left (hrole x hx j i) (Nat.cast_nonneg _)
        _ = 12 * B := by simp [Fin.sum_univ_four]; ring
    have h3 := abs_add_le ((L : ℝ) * (x.1 (Fin.natAdd d i) : ℝ))
      (∑ j : Fin 4, ((j : ℕ) : ℝ) * ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ))
    linarith
  have hPent : ∀ v ∈ P, ∀ i, |(v i : ℝ)| ≤ 9 * B := fun v hv i => by
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hv
    exact hP1 x hx i
  have hdiffP : ∀ v ∈ P, ∀ v' ∈ P, ∀ i, |((v - v') i : ℝ)| ≤ 64 * B := fun v hv v' hv' i => by
    have e : (((v - v') i : ℤ) : ℝ) = (v i : ℝ) - (v' i : ℝ) := by
      simp only [Pi.sub_apply, Int.cast_sub]
    rw [e]
    refine (abs_sub _ _).trans ?_
    linarith [hPent v hv i, hPent v' hv' i]
  have hl3 : ((l : ℕ) : ℝ) ≤ 3 := by have := l.isLt; exact_mod_cast (by omega : (l : ℕ) ≤ 3)
  have hl0 : (0 : ℝ) ≤ (l : ℕ) := Nat.cast_nonneg _
  have hdiffΔ : ∀ x ∈ Bxs, ∀ i,
      |((expP2 L QL n x - ((l : ℕ) : ℤ) • expP1 L QL n x - m₀) i : ℝ)| ≤ 64 * B := by
    intro x hx i
    have e : (((expP2 L QL n x - ((l : ℕ) : ℤ) • expP1 L QL n x - m₀) i : ℤ) : ℝ) =
        (expP2 L QL n x i : ℝ) - ((l : ℕ) : ℝ) * (expP1 L QL n x i : ℝ) - (m₀ i : ℝ) := by
      simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]; push_cast; ring
    rw [e]
    have h2 := hP2 x hx i; have h1 := hP1 x hx i; have hm := hm₀ i
    have ha := abs_sub ((expP2 L QL n x i : ℝ) - ((l : ℕ) : ℝ) * (expP1 L QL n x i : ℝ))
      (m₀ i : ℝ)
    have hb := abs_sub (expP2 L QL n x i : ℝ) (((l : ℕ) : ℝ) * (expP1 L QL n x i : ℝ))
    rw [abs_mul, abs_of_nonneg hl0] at hb
    have hc : ((l : ℕ) : ℝ) * |(expP1 L QL n x i : ℝ)| ≤ 3 * (9 * B) :=
      mul_le_mul hl3 h1 (abs_nonneg _) (by norm_num)
    linarith
  have hfd : ∀ (c : ℝ) (v v' : Fin d → ℤ), (c + ∑ i, (v i : ℝ) * ξ i) -
      (c + ∑ i, (v' i : ℝ) * ξ i) = ∑ i, ((v - v') i : ℝ) * ξ i := fun c v v' => by
    simp only [Pi.sub_apply, Int.cast_sub, sub_mul, Finset.sum_sub_distrib]; ring
  have key : ∀ e1 e2 : Fin d → ℤ, (∑ i, (e2 i : ℝ) * ξ i) - ((l : ℕ) : ℝ) *
      (∑ i, (e1 i : ℝ) * ξ i) - ∑ i, (m₀ i : ℝ) * ξ i =
      ∑ i, ((e2 - ((l : ℕ) : ℤ) • e1 - m₀) i : ℝ) * ξ i := by
    intro e1 e2
    rw [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Int.cast_sub, Int.cast_mul,
      Int.cast_natCast]
    ring
  refine ⟨P.image (cosetRep K P), fun x => cosetRep K P (expP1 L QL n x), ?_, ?_, ?_, ?_, ?_⟩
  · intro u hu i
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hu
    exact (hPent _ (cosetRep_spec K P hv).1 i).trans (by linarith)
  · intro u hu u' hu' hne
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hu
    obtain ⟨v', hv', rfl⟩ := Finset.mem_image.mp hu'
    exact cosetRep_sub_not_mem K P hv hv' hne
  · intro u hu u' hu' hne
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hu
    obtain ⟨v', hv', rfl⟩ := Finset.mem_image.mp hu'
    have hm := cosetRep_sub_not_mem K P hv hv' hne
    have g := (hdich _ (hdiffP _ (cosetRep_spec K P hv).1 _ (cosetRep_spec K P hv').1)).2 hm
    rw [show -(r * (∑ j, γ j + ∑ i, ((cosetRep K P v) i : ℝ) * ξ i)) -
        -(r * (∑ j, γ j + ∑ i, ((cosetRep K P v') i : ℝ) * ξ i)) =
        -(r * ((∑ j, γ j + ∑ i, ((cosetRep K P v) i : ℝ) * ξ i) -
          (∑ j, γ j + ∑ i, ((cosetRep K P v') i : ℝ) * ξ i))) by ring,
      hfd, abs_neg, abs_mul, abs_of_pos hr]
    linarith
  · intro x hx hΔ
    have hv : expP1 L QL n x ∈ P := Finset.mem_image_of_mem _ hx
    obtain ⟨hrep, hmem⟩ := cosetRep_spec K P hv
    refine ⟨Finset.mem_image_of_mem _ hv, hmem, ?_, ?_⟩
    · have g := (hdich _ (hdiffP _ hv _ hrep)).1 hmem
      rw [← mul_sub, hfd, abs_mul, abs_of_pos hr]
      exact g
    · have g := (hdich _ (hdiffΔ x hx)).1 hΔ
      have k := key (expP1 L QL n x) (expP2 L QL n x)
      rw [show r * ((∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L QL n x i : ℝ) * ξ i) -
          ((l : ℕ) : ℝ) * (∑ j, γ j + ∑ i, (expP1 L QL n x i : ℝ) * ξ i)) -
          r * (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j - ((l : ℕ) : ℝ) * ∑ j, γ j +
            ∑ i, (m₀ i : ℝ) * ξ i) =
          r * ((∑ i, (expP2 L QL n x i : ℝ) * ξ i) - ((l : ℕ) : ℝ) *
            (∑ i, (expP1 L QL n x i : ℝ) * ξ i) - ∑ i, (m₀ i : ℝ) * ξ i) by ring, k,
        abs_mul, abs_of_pos hr]
      exact g
  · intro x hx hΔ
    have g := (hdich _ (hdiffΔ x hx)).2 hΔ
    have k := key (expP1 L QL n x) (expP2 L QL n x)
    set β := ∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j - ((l : ℕ) : ℝ) * ∑ j, γ j +
      ∑ i, (m₀ i : ℝ) * ξ i with hβ
    set X := ∑ i, ((expP2 L QL n x - ((l : ℕ) : ℤ) • expP1 L QL n x - m₀) i : ℝ) * ξ i with hX
    have eT : r * ((∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L QL n x i : ℝ) * ξ i) -
        ((l : ℕ) : ℝ) * (∑ j, γ j + ∑ i, (expP1 L QL n x i : ℝ) * ξ i)) = r * β + r * X := by
      rw [← k, hβ]; ring
    rw [eT]
    have h2 := abs_sub_abs_le_abs_sub (r * X) (-(r * β))
    rw [sub_neg_eq_add, add_comm, abs_neg] at h2
    have h3 : |r * β| ≤ U := by rw [abs_mul, abs_of_pos hr]; exact hU
    have h4 : |r * X| = r * |X| := by rw [abs_mul, abs_of_pos hr]
    linarith

namespace ModeSchedule
variable {S : ModeSchedule} {Cj CA CT CK : ℕ} {δs W : ℝ}

/-- `4 D_* ≤ A₀` (blueprint line 1955: `A₀ ≥ (C_* 6^{R_*} B_* D_*)^{C_A}`). -/
theorem Valid.four_Dstar_le_A0 (hV : S.Valid Cj CA CT CK δs W) (hCA : 1 ≤ CA)
    (hd2 : 2 ≤ S.dmax) (hD : 2 ≤ S.Dstar) (hB : 2 ≤ S.Bstar) : 4 * S.Dstar ≤ S.A0 := by
  have hC := hV.two_le_Cstar hd2 hD
  have h6 : (1 : ℝ) ≤ 6 ^ S.Rht := one_le_pow₀ (by norm_num)
  have h1 : 4 ≤ S.Cstar * 6 ^ S.Rht * S.Bstar := by
    have : 2 ≤ S.Cstar * 6 ^ S.Rht := by nlinarith
    nlinarith
  set X := S.Cstar * 6 ^ S.Rht * S.Bstar * S.Dstar with hX
  have hX4 : 4 * S.Dstar ≤ X := mul_le_mul_of_nonneg_right h1 (by linarith)
  have hX1 : 1 ≤ X := by linarith
  calc 4 * S.Dstar ≤ X := hX4
    _ = X ^ 1 := (pow_one X).symm
    _ ≤ X ^ CA := pow_le_pow_right₀ hX1 hCA
    _ ≤ S.A0 := hV.A0_ge

/-- Sixty-four times the frequency box is below `H` (blueprint lines 2483-2487, "all the boxes
under consideration", including the anchored three-core combinations): `64 D_*^5 E_h < H` for
`h ≤ J_*`. -/
theorem Valid.box64_lt_H (hV : S.Valid Cj CA CT CK δs W) (hCA : 1 ≤ CA) (hd2 : 2 ≤ S.dmax)
    (hD : 2 ≤ S.Dstar) (hB : 2 ≤ S.Bstar) (hQ : 1 ≤ S.Q0) {h : ℕ} (hh : h ≤ S.Jstar) :
    64 * S.Dstar ^ 5 * S.Eh h < S.H := by
  refine lt_of_le_of_lt ?_ (hV.H_ge hd2 hD hB hQ)
  have hA := hV.one_le_A0 hd2 hD hB
  have h4 := hV.four_Dstar_le_A0 hCA hd2 hD hB
  have hE : S.Eh h ≤ S.Eh S.Jstar := pow_le_pow_right₀ hA (by omega)
  have hE1 : S.A0 ≤ S.Eh S.Jstar := by
    unfold Eh
    calc S.A0 = S.A0 ^ 1 := (pow_one _).symm
      _ ≤ S.A0 ^ (S.Jstar + 1) := pow_le_pow_right₀ hA (by omega)
  have hL : (1 : ℝ) ≤ Lh S.Jstar := one_le_pow₀ (by norm_num)
  have hE0 : 0 ≤ S.Eh h := pow_nonneg (by linarith) _
  have hEJ : 0 ≤ S.Eh S.Jstar := le_trans hE0 hE
  have hD4 : 0 ≤ S.Dstar ^ 4 := by positivity
  calc 64 * S.Dstar ^ 5 * S.Eh h = 16 * S.Dstar ^ 4 * ((4 * S.Dstar) * S.Eh h) := by ring
    _ ≤ 16 * S.Dstar ^ 4 * (S.Eh S.Jstar * S.Eh S.Jstar) := by
        gcongr
        linarith
    _ ≤ 27 * S.Dstar ^ 4 * (S.Eh S.Jstar * Lh S.Jstar) ^ 2 := by
        have : S.Eh S.Jstar * S.Eh S.Jstar ≤ (S.Eh S.Jstar * Lh S.Jstar) ^ 2 := by
          nlinarith only [mul_le_mul_of_nonneg_left hL hEJ, hA, hE1]
        nlinarith only [hD4, this]

end ModeSchedule

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

open Classical in
/-- `box_dichotomy` for every integer frequency `n` with `|n|_∞ ≤ 64 D_*^5 E_{h-Δ}` (blueprint
lines 2483-2487, "apply its gap to pure `ϑ` shifts in all the boxes under consideration": the
anchored three-core combinations `P₂ - l P₁ - m₀` reach `41 D_*^5 E_{h-Δ}`). -/
theorem box_dichotomy64 {Cj CA CT CK : ℕ} {δs W : ℝ} (hV : D.S.Valid Cj CA CT CK δs W)
    (hCA : 1 ≤ CA) (hCT : 4 ≤ CT) (hd2 : 2 ≤ D.S.dmax) (hD : 2 ≤ D.S.Dstar) (hB : 2 ≤ D.S.Bstar)
    (hQ : 1 ≤ D.S.Q0) (hSP : D.SP = D.S.sideParams δs) (I : ℤ × ℤ) (l : Fin 4) (G : bf.Grp)
    (hdim : (D.Ms l G).zc.dim ≤ D.S.dmax) {h : ℕ} (hh : h ≤ D.SP.Jst)
    {m : (D.Ms l G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))}
    (hgood : ((D.Ms l G).blockComps D.S D.hA (A.blkStart D.S.K I.1) (D.preAt I)).Good D.SP.Δ
      ((D.Ms l G).goodP D.S D.SP (A.blkStart D.S.K I.1)) h m) :
    ∀ n : Fin (D.Ms l G).zc.dim → ℤ,
      (∀ i, |(n i : ℝ)| ≤ 64 * (D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ))) →
      (n ∈ rationalIntegerIntersection (tinySpan (fun i => (D.Ms l G).zc.θ i / D.S.Q0)
          D.SP.Hn (D.SP.Tt⁻¹ / dyadicGridLength A.G (A.blkStart D.S.K I.1 - 2 * D.S.K))) →
        dyadicGridLength A.G I.1 * |∑ i, (n i : ℝ) * (D.Ms l G).torusξ D.S (h - D.SP.Δ) i| ≤
          D.SP.Tt⁻¹ / ModeSchedule.Lh (h - D.SP.Δ)) ∧
      (n ∉ rationalIntegerIntersection (tinySpan (fun i => (D.Ms l G).zc.θ i / D.S.Q0)
          D.SP.Hn (D.SP.Tt⁻¹ / dyadicGridLength A.G (A.blkStart D.S.K I.1 - 2 * D.S.K))) →
        D.SP.Tt / ModeSchedule.Lh (h - D.SP.Δ) ≤
          dyadicGridLength A.G I.1 * |∑ i, (n i : ℝ) * (D.Ms l G).torusξ D.S (h - D.SP.Δ) i|) := by
  have hHn : D.SP.Hn = ⌊D.S.H⌋₊ := by rw [hSP]; rfl
  have hTt : D.SP.Tt = D.S.T := by rw [hSP]; rfl
  have hJst : D.SP.Jst = D.S.Jstar := by rw [hSP]; rfl
  have hH2 := hV.two_le_H hd2 hD hB hQ
  have hHn1 : 1 ≤ D.SP.Hn := by rw [hHn]; exact Nat.le_floor (by norm_num; linarith)
  have hT : 0 < D.SP.Tt := by rw [hTt]; linarith only [hV.one_le_T (by omega) hd2 hD hB hQ]
  have hL : 0 < ModeSchedule.Lh (h - D.SP.Δ) := by unfold ModeSchedule.Lh; positivity
  obtain ⟨-, -, -, hdich⟩ := D.frequency_dichotomy I l G hgood hHn1 hT
    (D.tinySmall_of_valid hV hCT hd2 hD hB hQ hSP hdim _) hL
  intro n hn
  have hbox := hV.box64_lt_H hCA hd2 hD hB hQ (h := h - D.SP.Δ) (by rw [← hJst]; omega)
  have hnH : vecHeight (fun i => (n i : ℚ)) ≤ D.SP.Hn := by
    have hH1' : 1 ≤ ⌊D.S.H⌋₊ := hHn ▸ hHn1
    rw [hHn]
    refine vecHeight_int_le n hH1' fun i => ?_
    have h1 : |(n i : ℝ)| < D.S.H := (hn i).trans_lt (by linarith)
    have e : ((n i).natAbs : ℝ) = |(n i : ℝ)| := by rw [Nat.cast_natAbs, Int.cast_abs]
    have h2 : (n i).natAbs ≤ ⌊D.S.H⌋₊ := Nat.le_floor (by rw [e]; exact h1.le)
    rw [← e]
    exact_mod_cast h2
  obtain ⟨h1, h2⟩ := hdich n hnH
  have e : ∀ i, (D.Ms l G).torusξ D.S (h - D.SP.Δ) i =
      (D.Ms l G).zc.θ i / D.S.Q0 / ModeSchedule.Lh (h - D.SP.Δ) := fun i => by
    unfold ModeSystem.torusξ; rw [div_div]
  simp_rw [e]
  exact ⟨h1, h2⟩

end SideInput


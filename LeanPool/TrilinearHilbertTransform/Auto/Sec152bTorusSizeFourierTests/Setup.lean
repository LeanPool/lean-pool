  have hGl : ∀ u, ‖coreG (Q0 * L) (2 ^ (Kt + 1)) F c n cc l u‖ ≤ 1 + cutTail z.dim δ Kt := by
    intro u
    have e : coreG (Q0 * L) (2 ^ (Kt + 1)) F c n cc l u =

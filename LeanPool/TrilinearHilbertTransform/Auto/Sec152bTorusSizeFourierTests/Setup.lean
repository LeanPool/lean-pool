/-- A pointwise bound by a bounded measurable function plus a constant bounds the `L²` norm on a
probability space. -/
theorem eLpNorm_two_toReal_le_add {X : Type*} [MeasurableSpace X] {μ : Measure X}
    [IsProbabilityMeasure μ] {f g : X → ℂ} (hf : AEStronglyMeasurable f μ)
    (hg : AEStronglyMeasurable g μ) {B : ℝ} (hgB : ∀ x, ‖g x‖ ≤ B) {c : ℝ} (hc : 0 ≤ c)
    (hfg : ∀ x, ‖f x‖ ≤ ‖g x‖ + c) :
    (eLpNorm f 2 μ).toReal ≤ (eLpNorm g 2 μ).toReal + c := by
  have hgL : MemLp g 2 μ := MemLp.of_bound hg B (Filter.Eventually.of_forall hgB)
  have h1 : eLpNorm f 2 μ ≤ eLpNorm (fun x => ‖g x‖ + c) 2 μ :=
    eLpNorm_mono_real hf hfg
  have h2 : eLpNorm (fun x => ‖g x‖ + c) 2 μ ≤ eLpNorm g 2 μ + ENNReal.ofReal c := by
    have e : (fun x => ‖g x‖ + c) = (fun x => ‖g x‖) + fun _ => c := rfl
    rw [e]
    refine (eLpNorm_add_le (by norm_num)).trans ?_
    rw [eLpNorm_norm, eLpNorm_const _ (by norm_num) (IsProbabilityMeasure.ne_zero μ), measure_univ,
      ENNReal.one_rpow, mul_one, Real.enorm_eq_ofReal hc]
    exact hg
  have hfin : eLpNorm g 2 μ ≠ ⊤ := hgL.eLpNorm_ne_top
  calc (eLpNorm f 2 μ).toReal ≤ (eLpNorm g 2 μ + ENNReal.ofReal c).toReal :=
        ENNReal.toReal_mono (ENNReal.add_ne_top.mpr ⟨hfin, ENNReal.ofReal_ne_top⟩) (h1.trans h2)
    _ = _ := by rw [ENNReal.toReal_add hfin ENNReal.ofReal_ne_top, ENNReal.toReal_ofReal hc]

/-- `cell_average_of_approx` with the pointwise comparison on the half-open cell only. -/
theorem cell_average_of_approx_Ico {P Q : ℝ → ℂ} {η : ℝ} (hP : Continuous P)
    (hQi : IntervalIntegrable (fun t => ‖Q t‖ ^ 2) volume 0 1)
    (h : ∀ t ∈ Set.Ico (0 : ℝ) 1, ‖P t‖ ≤ ‖Q t‖ + η) :
    ∫ t in (0 : ℝ)..1, ‖P t‖ ^ 2 ≤ 2 * (∫ t in (0 : ℝ)..1, ‖Q t‖ ^ 2) + 2 * η ^ 2 := by
  have hne : ∀ᵐ t ∂(volume : Measure ℝ), t ≠ 1 := by
    rw [ae_iff]; simp
  calc ∫ t in (0 : ℝ)..1, ‖P t‖ ^ 2 ≤ ∫ t in (0 : ℝ)..1, (2 * ‖Q t‖ ^ 2 + 2 * η ^ 2) := by
        refine intervalIntegral.integral_mono_ae_restrict zero_le_one
          ((hP.norm.pow 2).intervalIntegrable _ _)
          ((hQi.const_mul 2).add intervalIntegrable_const) ?_
        filter_upwards [ae_restrict_mem measurableSet_Icc, ae_restrict_of_ae hne] with t ht ht1
        have h1 := h t ⟨ht.1, lt_of_le_of_ne ht.2 ht1⟩
        have h0 : 0 ≤ ‖P t‖ := norm_nonneg _
        nlinarith only [sq_nonneg (‖Q t‖ - η), h1, h0]
    _ = _ := by
        rw [intervalIntegral.integral_add (hQi.const_mul 2) intervalIntegrable_const,
          intervalIntegral.integral_const_mul, intervalIntegral.integral_const]
        simp

open Classical in
/-- `torus_size_phys` with the physical comparison on the half-open cell `[a₀, a₀ + r)` only. -/
theorem torus_size_phys_Ico {d : ℕ} (V : Submodule ℚ (Fin d → ℚ)) {ι κ : Type*} (F : Finset ι)
    (c : ι → ℂ) (n : ι → Fin d → ℤ) (ξ : Fin d → ℝ) {a₀ r xs : ℝ} (hr : 0 < r)
    (hxs : xs ∈ Set.Icc a₀ (a₀ + r)) {ε : ℝ} (hε : 0 < ε)
    (htiny : ∀ k ∈ F, ∀ k' ∈ F, n k - n k' ∈ rationalIntegerIntersection V →
      |2 * Real.pi * r * ∑ i, (n k i : ℝ) * ξ i - 2 * Real.pi * r * ∑ i, (n k' i : ℝ) * ξ i| ≤ ε)
    (hhuge : ∀ k ∈ F, ∀ k' ∈ F, n k - n k' ∉ rationalIntegerIntersection V →
      2 / ε ≤ |2 * Real.pi * r * ∑ i, (n k i : ℝ) * ξ i -
        2 * Real.pi * r * ∑ i, (n k' i : ℝ) * ξ i|)
    (Q : ℝ → ℂ) (hQ : Measurable Q) {M : ℝ} (hQb : ∀ y, ‖Q y‖ ≤ M) {e : ℝ}
    (hpt : ∀ y ∈ Set.Ico a₀ (a₀ + r), ‖∑ k ∈ F, c k *
      torusCharacter (n k) (torusMk fun i => ξ i * (y - xs))‖ ≤ ‖Q y‖ + e)
    (s : Finset κ) (A sD : κ → ℝ) (hA : ∀ i ∈ s, 0 ≤ A i) (hs : ∀ i ∈ s, 0 ≤ sD i) {Dst : ℝ}
    (hDst : 1 ≤ Dst) (hcard : (s.card : ℝ) ≤ Dst) (hεD : 2 * ε ≤ Dst ^ (-100 : ℤ))
    (hXA : 2 * (r⁻¹ * ∫ y in a₀..a₀ + r, ‖Q y‖ ^ 2) + 2 * e ^ 2 ≤ 2 * ∑ i ∈ s, A i ^ 2)
    (hc : ∑ k ∈ F, ‖c k‖ ≤ ∑ i ∈ s, sD i) :
    (eLpNorm (fun x : torusAnnihilator (rationalIntegerIntersection V) =>
        ∑ k ∈ F, c k * torusCharacter (n k) x) 2
        (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal ≤
      Real.sqrt 2 * Real.sqrt (∑ i ∈ s, (A i + Dst ^ (-30 : ℤ) * sD i) ^ 2) := by
  set! P : ℝ → ℂ := fun t => ∑ k ∈ F, c k *
    torusCharacter (n k) (torusMk fun i => ξ i * ((a₀ - xs) + r * t))
  have hPc : Continuous P := by
    refine continuous_finsetSum _ fun k _ => continuous_const.mul ?_
    have : (fun t : ℝ => torusCharacter (n k) (torusMk fun i => ξ i * ((a₀ - xs) + r * t))) =
        fun t => (Real.fourierChar ((∑ i, (n k i : ℝ) * ξ i) * ((a₀ - xs) + r * t)) : ℂ) := by
      funext t; exact torusCharacter_mk_line (n k) ξ _
    rw [this]
    exact continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))
  have hQt : IntervalIntegrable (fun t : ℝ => ‖Q (a₀ + r * t)‖ ^ 2) volume 0 1 := by
    refine (intervalIntegrable_const (c := M ^ 2)).mono_fun ?_ (Filter.Eventually.of_forall
      fun t => ?_)
    · exact ((hQ.comp (by fun_prop)).norm.pow_const 2).aestronglyMeasurable
    · change ‖‖Q (a₀ + r * t)‖ ^ 2‖ ≤ ‖M ^ 2‖
      rw [Real.norm_eq_abs, abs_of_nonneg (by positivity), Real.norm_eq_abs,
        abs_of_nonneg (sq_nonneg M)]
      exact pow_le_pow_left₀ (norm_nonneg _) (hQb _) 2
  have happ := cell_average_of_approx_Ico (P := P) (Q := fun t => Q (a₀ + r * t)) (η := e) hPc
    hQt (fun t ht => by
      have hy : a₀ + r * t ∈ Set.Ico a₀ (a₀ + r) :=
        ⟨by nlinarith [ht.1], by nlinarith [ht.2]⟩
      have := hpt _ hy
      simp only [P]
      convert this using 6
      funext i; ring)
  rw [cell_average_change hr (fun y => ‖Q y‖ ^ 2)] at happ
  have hs₀ : |a₀ - xs| ≤ r := by
    rw [abs_le]; constructor <;> linarith [hxs.1, hxs.2]
  exact torus_size_cell V F c n ξ hr hs₀ hε htiny hhuge s A sD hA hs hDst hcard hεD happ hXA hc

/-- `cutoffP_truncate_full` in every dimension, including the zero-dimensional torus (where the
cutoff is constant). -/
theorem cutoffP_truncate_all {d : ℕ} {δ : ℝ} (hδ : 0 < δ) (ρ : Fin d → ℝ) (K : ℕ) :
    ∃ c : (Fin d → ℤ) → ℂ, (∀ v, ‖c v‖ ≤ 1) ∧
      (∀ s : Finset (Fin d → ℤ), ∑ v ∈ s, ‖c v‖ ≤ cutNorm d δ) ∧ ∀ w,
      ‖cutoffP δ ρ w - ∑ v ∈ frequencyBox d (2 ^ (K + 1)),
        c v * (Real.fourierChar (∑ i, (v i : ℝ) * w i) : ℂ)‖ ≤ cutTail d δ K := by
  rcases Nat.eq_zero_or_pos d with rfl | hd
  · refine ⟨fun _ => cutoffP δ ρ 0, fun _ => cutoffP_norm_le δ ρ 0, fun s => ?_, fun w => ?_⟩
    · calc ∑ v ∈ s, ‖cutoffP δ ρ (0 : Fin 0 → ℝ)‖ ≤ ∑ v ∈ s, (1 : ℝ) :=
            Finset.sum_le_sum fun _ _ => cutoffP_norm_le δ ρ 0
        _ = s.card := by simp
        _ ≤ 1 := by exact_mod_cast Finset.card_le_one_of_subsingleton s
        _ = cutNorm 0 δ := by simp [cutNorm]
    · have e : ∀ v : Fin 0 → ℤ, cutoffP δ ρ (0 : Fin 0 → ℝ) *
          (Real.fourierChar (∑ i, (v i : ℝ) * w i) : ℂ) = cutoffP δ ρ w := fun v => by
        rw [Subsingleton.elim w 0]; simp
      simp_rw [e]
      rw [Finset.sum_const, card_frequencyBox, pow_zero, one_smul, sub_self, norm_zero]
      exact cutTail_nonneg 0 hδ K
  · exact cutoffP_truncate_full hd hδ ρ K

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)

/-- The periodic factor `g_j` of `eq:core-torus-form` as a function on the standard torus
(`torusG` is `ℤ^d`-periodic; evaluate it at the representatives in `[0, 1)^d`). -/
noncomputable def torusGT {U : ℤ × ℤ} (h : ℕ) (xs : ℝ) (F : Finset (Ms.alive U))
    (α : Ms.alive U → ℂ) (n : Ms.alive U → Fin Ms.zc.dim → ℤ) (x : StandardTorus Ms.zc.dim) :
    ℂ :=
  Ms.torusG S h xs F α n fun i => (AddCircle.equivIco (1 : ℝ) 0 (x i) : ℝ)

theorem torusGT_mk {U : ℤ × ℤ} (h : ℕ) (xs : ℝ) (F : Finset (Ms.alive U))
    (α : Ms.alive U → ℂ) (n : Ms.alive U → Fin Ms.zc.dim → ℤ) (u : Fin Ms.zc.dim → ℝ) :
    Ms.torusGT S h xs F α n (torusMk u) = Ms.torusG S h xs F α n u := by
  unfold torusGT torusMk
  have e : (fun i => (AddCircle.equivIco (1 : ℝ) 0 ((u i : AddCircle (1 : ℝ))) : ℝ)) =
      u + fun i => ((-⌊u i⌋ : ℤ) : ℝ) := by
    funext i
    rw [AddCircle.coe_equivIco_mk_apply, div_one, mul_one, Int.fract]
    simp only [Pi.add_apply, Int.cast_neg]
    ring
  rw [e, torusG_periodic]

theorem continuous_torusG (hδ : 0 < Ms.δc) {U : ℤ × ℤ} (h : ℕ) (xs : ℝ)
    (F : Finset (Ms.alive U)) (α : Ms.alive U → ℂ) (n : Ms.alive U → Fin Ms.zc.dim → ℤ) :
    Continuous (Ms.torusG S h xs F α n) := by
  have hF : ContDiff ℝ (⊤ : ℕ∞) (cutoffP Ms.δc Ms.ρ) :=
    (chartCoordinateProduct_smooth (d := Ms.zc.dim) (fractProfile_contDiff hδ)).comp
      (contDiff_id.sub contDiff_const)
  unfold torusG
  refine (hF.continuous.comp (by fun_prop)).mul
    (continuous_finsetSum _ fun m _ => continuous_const.mul (continuous_const.mul ?_))
  exact continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))

theorem measurable_torusGT (hδ : 0 < Ms.δc) {U : ℤ × ℤ} (h : ℕ) (xs : ℝ)
    (F : Finset (Ms.alive U)) (α : Ms.alive U → ℂ) (n : Ms.alive U → Fin Ms.zc.dim → ℤ) :
    Measurable (Ms.torusGT S h xs F α n) := by
  unfold torusGT
  refine (Ms.continuous_torusG S hδ h xs F α n).measurable.comp ?_
  refine measurable_pi_iff.mpr fun i => ?_
  exact measurable_subtype_coe.comp
    ((AddCircle.measurableEquivIco (1 : ℝ) 0).measurable.comp (measurable_pi_apply i))

open Classical in
/-- Blueprint lines 2470-2476 for the periodic factor ("use the true cutoff first ... and then its
Fourier truncation"): replacing the true periodic cutoff by its truncation `Σ_v cc_v e(v·w)`
(within `τ`) turns `g_j(u)` into the torus trigonometric polynomial with frequencies
`Q₀ L_h v + n_m`, up to `τ Σ_m |α_m|`. -/
theorem torusG_trunc {U : ℤ × ℤ} (h : ℕ) (xs : ℝ) (F : Finset (Ms.alive U))
    (α : Ms.alive U → ℂ) (n : Ms.alive U → Fin Ms.zc.dim → ℤ) (K : ℕ)
    (cc : (Fin Ms.zc.dim → ℤ) → ℂ) {τ : ℝ}
    (hccT : ∀ w, ‖cutoffP Ms.δc Ms.ρ w - ∑ v ∈ frequencyBox Ms.zc.dim (2 ^ (K + 1)),
      cc v * (Real.fourierChar (∑ i, (v i : ℝ) * w i) : ℂ)‖ ≤ τ) (u : Fin Ms.zc.dim → ℝ) :
    ‖Ms.torusG S h xs F α n u - ∑ p ∈ frequencyBox Ms.zc.dim (2 ^ (K + 1)) ×ˢ F,
        (cc p.1 * (Real.fourierChar (∑ i, (p.1 i : ℝ) * (Ms.zc.θ i * xs)) : ℂ) *
          (α p.2 * (Real.fourierChar (Ms.phase p.2.1 xs) : ℂ))) *
        torusCharacter (((S.Q0 * 6 ^ h : ℕ) : ℤ) • p.1 + n p.2) (torusMk u)‖ ≤
      τ * ∑ x ∈ F, ‖α x‖ := by
  set w : Fin Ms.zc.dim → ℝ := fun i => (S.Q0 * ModeSchedule.Lh h) * u i + Ms.zc.θ i * xs
    with hw
  set Wt : ℂ := ∑ m ∈ F, α m * ((Real.fourierChar (Ms.phase m.1 xs) : ℂ) *
      (Real.fourierChar (∑ i, (n m i : ℝ) * u i) : ℂ)) with hWt
  have hsum : ∑ p ∈ frequencyBox Ms.zc.dim (2 ^ (K + 1)) ×ˢ F,
      (cc p.1 * (Real.fourierChar (∑ i, (p.1 i : ℝ) * (Ms.zc.θ i * xs)) : ℂ) *
        (α p.2 * (Real.fourierChar (Ms.phase p.2.1 xs) : ℂ))) *
      torusCharacter (((S.Q0 * 6 ^ h : ℕ) : ℤ) • p.1 + n p.2) (torusMk u) =
      (∑ v ∈ frequencyBox Ms.zc.dim (2 ^ (K + 1)),
        cc v * (Real.fourierChar (∑ i, (v i : ℝ) * w i) : ℂ)) * Wt := by
    rw [Finset.sum_product, Finset.sum_mul]
    refine Finset.sum_congr rfl fun v _ => ?_
    rw [hWt, Finset.mul_sum]
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [torusCharacter_mk]
    have e1 : ∑ i, ((((S.Q0 * 6 ^ h : ℕ) : ℤ) • v + n m) i : ℝ) * u i =
        ∑ i, (v i : ℝ) * ((S.Q0 * ModeSchedule.Lh h) * u i) + ∑ i, (n m i : ℝ) * u i := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, ModeSchedule.Lh]
      push_cast
      ring
    have e2 : ∑ i, (v i : ℝ) * w i = ∑ i, (v i : ℝ) * ((S.Q0 * ModeSchedule.Lh h) * u i) +
        ∑ i, (v i : ℝ) * (Ms.zc.θ i * xs) := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      simp only [hw]
      ring
    rw [e1, e2, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul, Circle.coe_mul, Circle.coe_mul]
    ring
  have hT : Ms.torusG S h xs F α n u = cutoffP Ms.δc Ms.ρ w * Wt := rfl
  rw [hsum, hT, ← sub_mul, norm_mul]
  refine mul_le_mul (hccT w) ?_ (norm_nonneg _) (le_trans (norm_nonneg _) (hccT w))
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m _ => ?_)
  rw [norm_mul, norm_mul, Circle.norm_coe, Circle.norm_coe, mul_one, mul_one]

section SelComps
variable (hA : 6 ≤ S.A0)

open Classical in
/-- The selected modes `F` grouped by their minimal CURRENT components: the sets `D` of
`eq:torus-size` ("`D` selected"). -/
noncomputable def selComps (b : ℤ) (J : ℤ × ℤ)
    (F : Finset (Ms.alive (ancAt Gd J (b - 4 * S.K)))) : Finset (Finset Ms.Md) :=
  F.image fun x => (F.filter fun y => y ∈ (Ms.blockComps S hA b J).F 0 x).map
    ⟨Subtype.val, Subtype.val_injective⟩

open Classical in
theorem selComps_biUnion (b : ℤ) (J : ℤ × ℤ) (F : Finset (Ms.alive (ancAt Gd J (b - 4 * S.K)))) :
    (Ms.selComps S hA b J F).biUnion id = F.map ⟨Subtype.val, Subtype.val_injective⟩ := by
  set C := Ms.blockComps S hA b J
  ext m
  rw [Finset.mem_biUnion]
  constructor
  · rintro ⟨D, hD, hm⟩
    obtain ⟨x, -, rfl⟩ := Finset.mem_image.mp hD
    obtain ⟨y, hy, rfl⟩ := Finset.mem_map.mp hm
    exact Finset.mem_map.mpr ⟨y, (Finset.mem_filter.mp hy).1, rfl⟩
  · intro hm
    obtain ⟨y, hy, rfl⟩ := Finset.mem_map.mp hm
    exact ⟨_, Finset.mem_image.mpr ⟨y, hy, rfl⟩, Finset.mem_map.mpr ⟨y, Finset.mem_filter.mpr
      ⟨hy, C.E_le_F 0 y (C.E_self 0 y)⟩, rfl⟩⟩

open Classical in
theorem selComps_subset {b : ℤ} {J : ℤ × ℤ} {F : Finset (Ms.alive (ancAt Gd J (b - 4 * S.K)))}
    {D : Finset Ms.Md} (hD : D ∈ Ms.selComps S hA b J F) :
    D ⊆ F.map ⟨Subtype.val, Subtype.val_injective⟩ := by
  rw [← Ms.selComps_biUnion S hA b J F]
  exact Finset.subset_biUnion_of_mem id hD

open Classical in
/-- Modes of two different selected groups lie in different minimal CURRENT components. -/
theorem selComps_not_mem {b : ℤ} {J : ℤ × ℤ} {F : Finset (Ms.alive (ancAt Gd J (b - 4 * S.K)))}
    {D D' : Finset Ms.Md} (hD : D ∈ Ms.selComps S hA b J F) (hD' : D' ∈ Ms.selComps S hA b J F)
    (hne : D ≠ D') {a a' : Ms.alive (ancAt Gd J (b - 4 * S.K))} (ha : a.1 ∈ D)
    (ha' : a'.1 ∈ D') : a' ∉ (Ms.blockComps S hA b J).F 0 a := by
  set C := Ms.blockComps S hA b J
  obtain ⟨x, -, rfl⟩ := Finset.mem_image.mp hD
  obtain ⟨x', -, rfl⟩ := Finset.mem_image.mp hD'
  obtain ⟨y, hy, hya⟩ := Finset.mem_map.mp ha
  obtain ⟨y', hy', hya'⟩ := Finset.mem_map.mp ha'
  have e1 : y = a := Subtype.ext hya
  have e2 : y' = a' := Subtype.ext hya'
  subst e1 e2
  intro hmem
  apply hne
  have hF : C.F 0 x = C.F 0 x' := by
    rw [← C.F_comp 0 x y (Finset.mem_filter.mp hy).2,
      ← C.F_comp 0 x' y' (Finset.mem_filter.mp hy').2, C.F_comp 0 y y' hmem]
  simp only [C, hF]

open Classical in
theorem selComps_disjoint {b : ℤ} {J : ℤ × ℤ} {F : Finset (Ms.alive (ancAt Gd J (b - 4 * S.K)))}
    {D D' : Finset Ms.Md} (hD : D ∈ Ms.selComps S hA b J F) (hD' : D' ∈ Ms.selComps S hA b J F)
    (hne : D ≠ D') : Disjoint D D' := by
  rw [Finset.disjoint_left]
  intro m hm hm'
  obtain ⟨a, -, rfl⟩ := Finset.mem_map.mp (Ms.selComps_subset S hA hD hm)
  exact Ms.selComps_not_mem S hA hD hD' hne hm hm'
    ((Ms.blockComps S hA b J).E_le_F 0 a ((Ms.blockComps S hA b J).E_self 0 a))

open Classical in
theorem card_selComps_le (b : ℤ) (J : ℤ × ℤ) (F : Finset (Ms.alive (ancAt Gd J (b - 4 * S.K)))) :
    (Ms.selComps S hA b J F).card ≤ F.card :=
  Finset.card_image_le

end SelComps

end ModeSystem

/-- The budget of the floors in `eq:torus-size`: with `Σ_D` coefficient sums `s_D`,
`S_α² ≤ D_* Σ_D s_D²`, the torus-form error `D_*^{-150} + τ_c` and the truncation tail
`τ_c ≤ D_*^{-300}` are absorbed by the floors `b_D = D_*^{-30} s_D`. -/
theorem torus_floor_budget {ι : Type*} (s : Finset ι) (sv : ι → ℝ) {Dst τ Sα : ℝ}
    (hD : 1 ≤ Dst) (hτ0 : 0 ≤ τ) (hτ : τ ≤ (Dst ^ 300)⁻¹)
    (hSα : Sα ^ 2 ≤ Dst * ∑ i ∈ s, sv i ^ 2) :
    (((Dst ^ 150)⁻¹ + τ) * Sα) ^ 2 ≤ 4 * ∑ i ∈ s, ((Dst ^ 30)⁻¹ * sv i) ^ 2 ∧
      (τ * Sα) ^ 2 ≤ ∑ i ∈ s, ((Dst ^ 30)⁻¹ * sv i) ^ 2 := by
  have hDp : 0 < Dst := by linarith
  have hsum : ∑ i ∈ s, sv i ^ 2 = Dst ^ 60 * ∑ i ∈ s, ((Dst ^ 30)⁻¹ * sv i) ^ 2 := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [mul_pow, inv_pow, ← pow_mul, ← mul_assoc, mul_inv_cancel₀ (by positivity), one_mul]
  have hB0 : 0 ≤ ∑ i ∈ s, ((Dst ^ 30)⁻¹ * sv i) ^ 2 := Finset.sum_nonneg fun _ _ => sq_nonneg _
  rw [hsum] at hSα
  have hk : ∀ m : ℕ, 61 ≤ m → ((Dst ^ m)⁻¹) ^ 2 * (Dst * Dst ^ 60) ≤ 1 := fun m hm => by
    rw [← pow_succ', inv_pow, ← pow_mul, inv_mul_le_one₀ (by positivity)]
    exact pow_le_pow_right₀ hD (by omega)
  have h300 : (Dst ^ 300)⁻¹ ≤ (Dst ^ 150)⁻¹ :=
    inv_anti₀ (by positivity) (pow_le_pow_right₀ hD (by norm_num))
  have hi150 : 0 < (Dst ^ 150)⁻¹ := by positivity
  constructor
  · have h2 : ((Dst ^ 150)⁻¹ + τ) ^ 2 ≤ 4 * ((Dst ^ 150)⁻¹) ^ 2 := by nlinarith only [hτ0, hτ, h300]
    calc (((Dst ^ 150)⁻¹ + τ) * Sα) ^ 2 = ((Dst ^ 150)⁻¹ + τ) ^ 2 * Sα ^ 2 := by ring
      _ ≤ 4 * ((Dst ^ 150)⁻¹) ^ 2 * (Dst * (Dst ^ 60 * ∑ i ∈ s, ((Dst ^ 30)⁻¹ * sv i) ^ 2)) :=
          mul_le_mul h2 hSα (sq_nonneg _) (by positivity)
      _ = 4 * (((Dst ^ 150)⁻¹) ^ 2 * (Dst * Dst ^ 60)) * ∑ i ∈ s, ((Dst ^ 30)⁻¹ * sv i) ^ 2 := by
          ring
      _ ≤ 4 * 1 * ∑ i ∈ s, ((Dst ^ 30)⁻¹ * sv i) ^ 2 := by
          gcongr; exact hk 150 (by norm_num)
      _ = _ := by ring
  · have h1 : τ ^ 2 ≤ ((Dst ^ 300)⁻¹) ^ 2 := pow_le_pow_left₀ hτ0 hτ 2
    calc (τ * Sα) ^ 2 = τ ^ 2 * Sα ^ 2 := by ring
      _ ≤ ((Dst ^ 300)⁻¹) ^ 2 * (Dst * (Dst ^ 60 * ∑ i ∈ s, ((Dst ^ 30)⁻¹ * sv i) ^ 2)) :=
          mul_le_mul h1 hSα (sq_nonneg _) (by positivity)
      _ = ((Dst ^ 300)⁻¹) ^ 2 * (Dst * Dst ^ 60) * ∑ i ∈ s, ((Dst ^ 30)⁻¹ * sv i) ^ 2 := by ring
      _ ≤ 1 * ∑ i ∈ s, ((Dst ^ 30)⁻¹ * sv i) ^ 2 :=
          mul_le_mul_of_nonneg_right (hk 300 (by norm_num)) hB0
      _ = _ := one_mul _

/-- The final arithmetic of `eq:torus-size`: from
`‖P‖ ≤ √2 (Σ_D (2(a_D + b_D) + (D_*²)^{-30} D_* s_D)²)^{1/2}` and `a' ≤ ‖P‖ + e` with
`e² ≤ Σ_D b_D²` (`b_D = D_*^{-30} s_D`), `a' ≤ 6 (Σ_D (a_D + b_D)²)^{1/2}`. -/
theorem torus_size_final {ι : Type*} (s : Finset ι) (a sv : ι → ℝ) {Dst a' P e : ℝ}
    (hD : 1 ≤ Dst) (ha : ∀ i, 0 ≤ a i) (hs : ∀ i, 0 ≤ sv i) (he0 : 0 ≤ e)
    (hP : P ≤ Real.sqrt 2 * Real.sqrt (∑ i ∈ s,
      (2 * (a i + (Dst ^ 30)⁻¹ * sv i) + (Dst ^ 2) ^ (-30 : ℤ) * (Dst * sv i)) ^ 2))
    (ha' : a' ≤ P + e) (he : e ^ 2 ≤ ∑ i ∈ s, ((Dst ^ 30)⁻¹ * sv i) ^ 2) :
    a' ≤ 6 * Real.sqrt (∑ i ∈ s, (a i + (Dst ^ 30)⁻¹ * sv i) ^ 2) := by
  have hDp : 0 < Dst := by linarith
  set X := ∑ i ∈ s, (a i + (Dst ^ 30)⁻¹ * sv i) ^ 2 with hX
  have hterm : ∀ i ∈ s, (2 * (a i + (Dst ^ 30)⁻¹ * sv i) + (Dst ^ 2) ^ (-30 : ℤ) * (Dst * sv i)) ^ 2
      ≤ 9 * (a i + (Dst ^ 30)⁻¹ * sv i) ^ 2 := by
    intro i _
    have e1 : (Dst ^ 2) ^ (-30 : ℤ) * (Dst * sv i) = (Dst ^ 59)⁻¹ * sv i := by
      rw [← zpow_natCast Dst 2, ← zpow_mul, ← mul_assoc, ← zpow_add_one₀ hDp.ne',
        show ((2 : ℕ) : ℤ) * (-30) + 1 = -((59 : ℕ) : ℤ) by norm_num, zpow_neg, zpow_natCast]
    rw [e1]
    have h1 : (Dst ^ 59)⁻¹ * sv i ≤ (Dst ^ 30)⁻¹ * sv i :=
      mul_le_mul_of_nonneg_right (inv_anti₀ (by positivity) (pow_le_pow_right₀ hD (by norm_num)))
        (hs i)
    have h2 : 0 ≤ (Dst ^ 59)⁻¹ * sv i := mul_nonneg (by positivity) (hs i)
    have h3 : 0 ≤ (Dst ^ 30)⁻¹ * sv i := mul_nonneg (by positivity) (hs i)
    have := ha i
    nlinarith only [h1, h2, this]
  have h9 : Real.sqrt (∑ i ∈ s, (2 * (a i + (Dst ^ 30)⁻¹ * sv i) +
      (Dst ^ 2) ^ (-30 : ℤ) * (Dst * sv i)) ^ 2) ≤ 3 * Real.sqrt X := by
    rw [show 3 * Real.sqrt X = Real.sqrt (9 * X) by
      rw [Real.sqrt_mul (by norm_num), show (9 : ℝ) = 3 ^ 2 by norm_num,
        Real.sqrt_sq (by norm_num)]]
    refine Real.sqrt_le_sqrt ?_
    rw [hX, Finset.mul_sum]
    exact Finset.sum_le_sum hterm
  have hbX : ∑ i ∈ s, ((Dst ^ 30)⁻¹ * sv i) ^ 2 ≤ X := Finset.sum_le_sum fun i _ => by
    have := ha i; have h3 : 0 ≤ (Dst ^ 30)⁻¹ * sv i := mul_nonneg (by positivity) (hs i)
    nlinarith only [this, h3]
  have heX : e ≤ Real.sqrt X := Real.le_sqrt_of_sq_le (he.trans hbX)
  have hs2 : Real.sqrt 2 ≤ 3 / 2 := by
    rw [Real.sqrt_le_left (by norm_num)]; norm_num
  have hsX := Real.sqrt_nonneg X
  have hPX : P ≤ 3 * Real.sqrt 2 * Real.sqrt X := by
    refine hP.trans ?_
    calc Real.sqrt 2 * _ ≤ Real.sqrt 2 * (3 * Real.sqrt X) :=
          mul_le_mul_of_nonneg_left h9 (Real.sqrt_nonneg _)
      _ = _ := by ring
  nlinarith only [he0, ha', heX, hs2, hPX]

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0)

open Classical in
/-- The Haar norm of the periodic factor against that of its truncation (blueprint lines
2470-2476): `‖g‖_{L²(𝓗)} ≤ ‖g_trunc‖_{L²(𝓗)} + τ Σ_m |α_m|` (`torusG_trunc`). -/
theorem torusGT_eLpNorm_le (hδ : 0 < Ms.δc) {U : ℤ × ℤ} (h : ℕ) (xs : ℝ)
    (F : Finset (Ms.alive U)) (α : Ms.alive U → ℂ) (n : Ms.alive U → Fin Ms.zc.dim → ℤ) (K : ℕ)
    (cc : (Fin Ms.zc.dim → ℤ) → ℂ) {τ : ℝ} (hτ0 : 0 ≤ τ)
    (hccT : ∀ w, ‖cutoffP Ms.δc Ms.ρ w - ∑ v ∈ frequencyBox Ms.zc.dim (2 ^ (K + 1)),
      cc v * (Real.fourierChar (∑ i, (v i : ℝ) * w i) : ℂ)‖ ≤ τ)
    (V : Submodule ℚ (Fin Ms.zc.dim → ℚ)) :
    (eLpNorm (fun x : torusAnnihilator (rationalIntegerIntersection V) =>
        Ms.torusGT S h xs F α n x.1) 2
        (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal ≤
      (eLpNorm (fun x : torusAnnihilator (rationalIntegerIntersection V) =>
        ∑ p ∈ frequencyBox Ms.zc.dim (2 ^ (K + 1)) ×ˢ F,
          (cc p.1 * (Real.fourierChar (∑ i, (p.1 i : ℝ) * (Ms.zc.θ i * xs)) : ℂ) *
            (α p.2 * (Real.fourierChar (Ms.phase p.2.1 xs) : ℂ))) *
          torusCharacter (((S.Q0 * 6 ^ h : ℕ) : ℤ) • p.1 + n p.2) x.1) 2
        (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal +
        τ * ∑ x ∈ F, ‖α x‖ := by
  have hg : Continuous fun x : torusAnnihilator (rationalIntegerIntersection V) =>
      ∑ p ∈ frequencyBox Ms.zc.dim (2 ^ (K + 1)) ×ˢ F,
        (cc p.1 * (Real.fourierChar (∑ i, (p.1 i : ℝ) * (Ms.zc.θ i * xs)) : ℂ) *
          (α p.2 * (Real.fourierChar (Ms.phase p.2.1 xs) : ℂ))) *
        torusCharacter (((S.Q0 * 6 ^ h : ℕ) : ℤ) • p.1 + n p.2) x.1 :=
    continuous_finsetSum _ fun p _ => continuous_const.mul
      ((continuous_torusCharacter _).comp continuous_subtype_val)
  refine eLpNorm_two_toReal_le_add
    ((Ms.measurable_torusGT S hδ h xs F α n).comp measurable_subtype_coe).aestronglyMeasurable
    hg.aestronglyMeasurable
    (B := ∑ p ∈ frequencyBox Ms.zc.dim (2 ^ (K + 1)) ×ˢ F,
      ‖cc p.1 * (Real.fourierChar (∑ i, (p.1 i : ℝ) * (Ms.zc.θ i * xs)) : ℂ) *
        (α p.2 * (Real.fourierChar (Ms.phase p.2.1 xs) : ℂ))‖)
    (fun x => (norm_sum_le _ _).trans (Finset.sum_le_sum fun p _ => ?_))
    (mul_nonneg hτ0 (Finset.sum_nonneg fun _ _ => norm_nonneg _)) (fun x => ?_)
  · rw [norm_mul, norm_torusCharacter, mul_one]
  · choose w hw using fun i => QuotientAddGroup.mk_surjective (x.1 i)
    have hx : x.1 = torusMk w := funext fun i => (hw i).symm
    change ‖Ms.torusGT S h xs F α n x.1‖ ≤ _
    rw [hx, torusGT_mk]
    have h1 := (abs_norm_sub_norm_le _ _).trans (Ms.torusG_trunc S h xs F α n K cc hccT w)
    linarith [(abs_le.mp h1).2]

open Classical in
/-- Blueprint lines 2489-2491 ("almost orthogonality of minimal CURRENT components"), the
physical side of `eq:torus-size`: on an actual cell `I ⊆ J` of length at least `r_{t_b}`, the
physical selected sum satisfies `∫_I |Σ_{x ∈ F} α_x ψ_x|² ≤ 2 Σ_D ‖A_D‖²` over the selected groups
`D` (pairings `≤ η |I|` between different minimal CURRENT components, `actualCell_inner_le`). -/
theorem selComps_cell_energy {b : ℤ} {J I : ℤ × ℤ} (hJ : J.1 = b - 2 * S.K)
    (hIJ : dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd J.1 J.2) (hIt : I.1 ≤ b + S.K)
    (hD : 2 ≤ S.Dstar) (hδ : 0 < Ms.δc) (hΛ : Ms.Λ ≤ S.Dstar) (hQ : 1 ≤ S.Q0)
    (hDg : gaugeSqNorm Ms.zc.dim Ms.δc ≤ S.Dstar) {Kf : ℕ}
    (hKf : 2 * gaugeTail Ms.zc.dim Ms.δc / 2 ^ Kf * S.Dstar ^ 300 ≤ 1)
    (hbox : (S.Q0 : ℝ) * 2 ^ (Kf + 1) ≤ S.Eh 0) (hεw : ∀ m, S.Dstar⁻¹ ≤ Ms.L.εM m)
    (hcard : ((Ms.alive (ancAt Gd J (b - 4 * S.K))).card : ℝ) ≤ S.Dstar)
    (F : Finset (Ms.alive (ancAt Gd J (b - 4 * S.K)))) (c : Ms.Md → ℂ) :
    ∫ y in dyadicGridCell Gd I.1 I.2, ‖∑ x ∈ F, c x.1 * Ms.wave x.1 y‖ ^ 2 ≤
      2 * ∑ E ∈ Ms.selComps S hA b J F, ‖∑ m ∈ E, c m • Ms.cellMode I m‖ ^ 2 := by
  have hDp : 0 < S.Dstar := by linarith
  have hΞ : 0 < S.Ξ := pow_pos hDp 1000
  have hr : 0 < dyadicGridLength Gd I.1 := dyadicGridLength_pos Gd I.1
  have hQ0 : 0 < S.Q0 := hQ
  have hdisj : ((Ms.selComps S hA b J F : Finset (Finset Ms.Md)) :
      Set (Finset Ms.Md)).PairwiseDisjoint id :=
    fun E hE E' hE' hne => Ms.selComps_disjoint S hA hE hE' hne
  have hFcard : (F.card : ℝ) ≤ S.Dstar := by
    refine le_trans ?_ hcard
    exact_mod_cast (Finset.card_le_univ F).trans (le_of_eq (Fintype.card_coe _))
  have hscard : ((Ms.selComps S hA b J F).card : ℝ) ≤ S.Dstar :=
    le_trans (by exact_mod_cast Ms.card_selComps_le S hA b J F) hFcard
  obtain ⟨η, hηe⟩ : ∃ η, η = pairConst Ms.zc.dim Ms.δc (S.Ξ / 2) Kf := ⟨_, rfl⟩
  have hη0 : 0 ≤ η := by rw [hηe]; exact pairConst_nonneg _ hδ (by positivity) Kf
  have hη200 : η * S.Dstar ^ 200 ≤ 2 := by rw [hηe]; exact S.pairConst_half_mul_le hD hδ hDg hKf
  have hηD : η * S.Dstar ^ 3 ≤ 1 / 2 := (eta_sched_bounds hD hη0 hη200 le_rfl).1
  have hortho := subtotals_almost_orthogonal (Ms.selComps S hA b J F) id (Ms.cellMode I) c hη0
    hr.le (inv_pos.mpr hDp) hDp.le (fun E hE E' hE' hne m hm m' hm' => ?_)
    (fun E _ => Ms.cellMode_synthesis_ge I E c (inv_pos.mpr hDp).le hεw) hscard
    (fun E hE => ?_)
  rotate_left
  · obtain ⟨z', -, rfl⟩ := Finset.mem_map.mp (Ms.selComps_subset S hA hE hm)
    obtain ⟨z, -, rfl⟩ := Finset.mem_map.mp (Ms.selComps_subset S hA hE' hm')
    rw [hηe]
    exact Ms.actualCell_inner_le S hA hJ hIJ hIt hδ (Ms.sixteen_Λ_le S hD hΛ) hΞ hQ0 Kf hbox
      (Ms.selComps_not_mem S hA hE hE' hne hm hm')
  · rw [sq, ← mul_assoc, inv_mul_cancel₀ hDp.ne', one_mul]
    refine le_trans ?_ hFcard
    have := Finset.card_le_card (Ms.selComps_subset S hA hE)
    rw [Finset.card_map] at this
    exact_mod_cast this
  have hw := Ms.wave_sum_le_cellMode I (F.map ⟨Subtype.val, Subtype.val_injective⟩) c
  have hQ' : ∀ y, ∑ x ∈ F, c x.1 * Ms.wave x.1 y = ∑ m ∈ F.map ⟨Subtype.val, Subtype.val_injective⟩,
      c m * Ms.wave m y := fun y => by rw [Finset.sum_map]; rfl
  simp_rw [hQ']
  refine hw.trans ?_
  rw [← Ms.selComps_biUnion S hA b J F, Finset.sum_biUnion hdisj]
  exact hortho.trans (mul_le_mul_of_nonneg_right (by linarith)
    (Finset.sum_nonneg fun _ _ => sq_nonneg _))

open Classical in
/-- The coefficient sum of the selected modes is the sum over the selected groups. -/
theorem sum_norm_selComps (b : ℤ) (J : ℤ × ℤ) (F : Finset (Ms.alive (ancAt Gd J (b - 4 * S.K))))
    (c : Ms.Md → ℂ) :
    ∑ x ∈ F, ‖c x.1‖ = ∑ E ∈ Ms.selComps S hA b J F, ∑ m ∈ E, ‖c m‖ := by
  have hdisj : ((Ms.selComps S hA b J F : Finset (Finset Ms.Md)) :
      Set (Finset Ms.Md)).PairwiseDisjoint id :=
    fun E hE E' hE' hne => Ms.selComps_disjoint S hA hE hE' hne
  have h1 : ∑ x ∈ F, ‖c x.1‖ = ∑ m ∈ F.map ⟨Subtype.val, Subtype.val_injective⟩, ‖c m‖ := by
    rw [Finset.sum_map]; rfl
  rw [h1, ← Ms.selComps_biUnion S hA b J F, Finset.sum_biUnion hdisj]
  rfl

open Classical in
/-- Blueprint lines 2484-2486 for the truncated periodic factor ("for every character difference
needed below, `r n·ξ` is tiny if `n ∈ K_B` and huge otherwise"): the frequencies `Q₀ L_{h'} v + n_m`
of the truncation (cutoff indices `v` in the Fourier box, shifts `|n_m| ≤ D_* E_{h'}`) lie in the
box `2 D_*^5 E_{h'}`, so the dichotomy on `4 D_*^5 E_{h'}` gives the phase alternatives of
`cell_average_close` with `ε = 2π L_{h'}/T`. -/
theorem trunc_tiny_huge (hA6 : 6 ≤ S.A0) (hBA : S.Bstar ≤ S.A0) {Kf : ℕ}
    (hQB : (S.Q0 : ℝ) * 2 ^ (Kf + 1) ≤ S.Bstar) (hD : 1 ≤ S.Dstar) (h' : ℕ) {U : ℤ × ℤ}
    (F : Finset (Ms.alive U)) (n : Ms.alive U → Fin Ms.zc.dim → ℤ)
    (hn : ∀ x ∈ F, ∀ i, |(n x i : ℝ)| ≤ S.Dstar * S.Eh h')
    (V : Submodule ℚ (Fin Ms.zc.dim → ℚ)) {T r : ℝ} (hT : 0 < T) (hr : 0 < r)
    (hdich : ∀ k : Fin Ms.zc.dim → ℤ, (∀ i, |(k i : ℝ)| ≤ 4 * S.Dstar ^ 5 * S.Eh h') →
      (k ∈ rationalIntegerIntersection V →
        r * |∑ i, (k i : ℝ) * Ms.torusξ S h' i| ≤ T⁻¹ / ModeSchedule.Lh h') ∧
      (k ∉ rationalIntegerIntersection V → T / ModeSchedule.Lh h' ≤
        r * |∑ i, (k i : ℝ) * Ms.torusξ S h' i|)) :
    (∀ k ∈ frequencyBox Ms.zc.dim (2 ^ (Kf + 1)) ×ˢ F,
      ∀ k' ∈ frequencyBox Ms.zc.dim (2 ^ (Kf + 1)) ×ˢ F,
      (((S.Q0 * 6 ^ h' : ℕ) : ℤ) • k.1 + n k.2) - (((S.Q0 * 6 ^ h' : ℕ) : ℤ) • k'.1 + n k'.2) ∈
        rationalIntegerIntersection V →
      |2 * Real.pi * r * ∑ i, (((((S.Q0 * 6 ^ h' : ℕ) : ℤ) • k.1 + n k.2) i : ℤ) : ℝ) *
          Ms.torusξ S h' i -
        2 * Real.pi * r * ∑ i, (((((S.Q0 * 6 ^ h' : ℕ) : ℤ) • k'.1 + n k'.2) i : ℤ) : ℝ) *
          Ms.torusξ S h' i| ≤ 2 * Real.pi * ModeSchedule.Lh h' / T) ∧
    (∀ k ∈ frequencyBox Ms.zc.dim (2 ^ (Kf + 1)) ×ˢ F,
      ∀ k' ∈ frequencyBox Ms.zc.dim (2 ^ (Kf + 1)) ×ˢ F,
      (((S.Q0 * 6 ^ h' : ℕ) : ℤ) • k.1 + n k.2) - (((S.Q0 * 6 ^ h' : ℕ) : ℤ) • k'.1 + n k'.2) ∉
        rationalIntegerIntersection V →
      2 / (2 * Real.pi * ModeSchedule.Lh h' / T) ≤
        |2 * Real.pi * r * ∑ i, (((((S.Q0 * 6 ^ h' : ℕ) : ℤ) • k.1 + n k.2) i : ℤ) : ℝ) *
          Ms.torusξ S h' i -
        2 * Real.pi * r * ∑ i, (((((S.Q0 * 6 ^ h' : ℕ) : ℤ) • k'.1 + n k'.2) i : ℤ) : ℝ) *
          Ms.torusξ S h' i|) := by
  have hL1 : (1 : ℝ) ≤ ModeSchedule.Lh h' := one_le_pow₀ (by norm_num)
  have hL0 : 0 < ModeSchedule.Lh h' := by linarith
  have hA1 : 1 ≤ S.A0 := by linarith
  have hE0 : 0 ≤ S.Eh h' := pow_nonneg (by linarith) _
  obtain ⟨N, hN⟩ : ∃ N : (Fin Ms.zc.dim → ℤ) × Ms.alive U → Fin Ms.zc.dim → ℤ,
      N = fun p => ((S.Q0 * 6 ^ h' : ℕ) : ℤ) • p.1 + n p.2 := ⟨_, rfl⟩
  have hNk : ∀ k, ((S.Q0 * 6 ^ h' : ℕ) : ℤ) • k.1 + n k.2 = N k := fun k => by rw [hN]
  simp only [hNk]
  have hNbd : ∀ p ∈ frequencyBox Ms.zc.dim (2 ^ (Kf + 1)) ×ˢ F, ∀ i,
      |((N p i : ℤ) : ℝ)| ≤ 2 * S.Dstar ^ 5 * S.Eh h' := by
    intro p hp i
    obtain ⟨hv, hx⟩ := Finset.mem_product.mp hp
    have h1 := freqBox_cutoff S hA6 hBA hQB hD hv h' i
    have h2 := hn p.2 hx i
    have h3 : S.Dstar * S.Eh h' ≤ S.Dstar ^ 5 * S.Eh h' := by
      refine mul_le_mul_of_nonneg_right ?_ hE0
      calc S.Dstar = S.Dstar ^ 1 := (pow_one _).symm
        _ ≤ S.Dstar ^ 5 := pow_le_pow_right₀ hD (by norm_num)
    have e : ((N p i : ℤ) : ℝ) = (S.Q0 : ℝ) * ModeSchedule.Lh h' * (p.1 i : ℝ) +
        (n p.2 i : ℝ) := by
      rw [hN]
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, ModeSchedule.Lh]
      push_cast
      ring
    rw [e]
    refine (abs_add_le _ _).trans ?_
    linarith
  have hphase : ∀ k k' : (Fin Ms.zc.dim → ℤ) × Ms.alive U,
      |2 * Real.pi * r * ∑ i, (N k i : ℝ) * Ms.torusξ S h' i -
        2 * Real.pi * r * ∑ i, (N k' i : ℝ) * Ms.torusξ S h' i| =
      2 * Real.pi * (r * |∑ i, ((N k - N k') i : ℝ) * Ms.torusξ S h' i|) := by
    intro k k'
    have e : 2 * Real.pi * r * ∑ i, (N k i : ℝ) * Ms.torusξ S h' i -
        2 * Real.pi * r * ∑ i, (N k' i : ℝ) * Ms.torusξ S h' i =
        2 * Real.pi * (r * ∑ i, ((N k - N k') i : ℝ) * Ms.torusξ S h' i) := by
      simp only [Pi.sub_apply, Int.cast_sub, sub_mul, Finset.sum_sub_distrib]
      ring
    rw [e, abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2 * Real.pi), abs_mul, abs_of_pos hr]
  have hdiff : ∀ k ∈ frequencyBox Ms.zc.dim (2 ^ (Kf + 1)) ×ˢ F,
      ∀ k' ∈ frequencyBox Ms.zc.dim (2 ^ (Kf + 1)) ×ˢ F, ∀ i,
      |((N k - N k') i : ℝ)| ≤ 4 * S.Dstar ^ 5 * S.Eh h' := by
    intro k hk k' hk' i
    have e : (((N k - N k') i : ℤ) : ℝ) = (N k i : ℝ) - (N k' i : ℝ) := by
      simp only [Pi.sub_apply, Int.cast_sub]
    rw [e]
    refine (abs_sub _ _).trans ?_
    linarith [hNbd k hk i, hNbd k' hk' i]
  refine ⟨fun k hk k' hk' hmem => ?_, fun k hk k' hk' hmem => ?_⟩
  · rw [hphase]
    have h1 := (hdich _ (hdiff k hk k' hk')).1 hmem
    have h2 : T⁻¹ / ModeSchedule.Lh h' ≤ ModeSchedule.Lh h' / T :=
      calc T⁻¹ / ModeSchedule.Lh h' ≤ T⁻¹ := div_le_self (inv_nonneg.mpr hT.le) hL1
        _ = 1 * T⁻¹ := (one_mul _).symm
        _ ≤ ModeSchedule.Lh h' * T⁻¹ := mul_le_mul_of_nonneg_right hL1 (inv_nonneg.mpr hT.le)
        _ = ModeSchedule.Lh h' / T := (div_eq_mul_inv _ _).symm
    rw [mul_div_assoc]
    exact mul_le_mul_of_nonneg_left (h1.trans h2) (by positivity)
  · rw [hphase]
    have h1 := (hdich _ (hdiff k hk k' hk')).2 hmem
    have h2 : 2 / (2 * Real.pi * ModeSchedule.Lh h' / T) ≤
        2 * Real.pi * (T / ModeSchedule.Lh h') := by
      have hpos : 0 < T / ModeSchedule.Lh h' := div_pos hT hL0
      have e : 2 / (2 * Real.pi * ModeSchedule.Lh h' / T) = T / ModeSchedule.Lh h' / Real.pi := by
        field_simp
      rw [e, div_le_iff₀ Real.pi_pos]
      have : 1 ≤ 2 * Real.pi * Real.pi := by nlinarith only [Real.pi_gt_three]
      nlinarith only [hpos, this]
    exact h2.trans (mul_le_mul_of_nonneg_left h1 (by positivity))

open Classical in
/-- Blueprint `eq:torus-size` (lines 2489-2496) for one role on an actual cell `I` of the block `b`
with pre-cell `J`: let the selected modes `F` have the torus form `eq:core-torus-form` on `I`
(unimodular phase `φ`, periodic factor `g = torusG` at the height `h'` with integer shifts of size
at most `D_* E_{h'}`, error `D_*^{-150}` times the coefficient sum), and let every integer frequency
`k` with `|k|_∞ ≤ 4 D_*^5 E_{h'}` have `|I| k·ξ` at most `T⁻¹/L_{h'}` if `k ∈ K_B` and at least
`T/L_{h'}` otherwise (`box_dichotomy`), with `T ≥ 4π L_{h'} D_*^{200}`. Then on
`𝓗 = (K_B ∩ ℤ^d)^⊥`,
`‖g‖_{L²(𝓗)} ≤ 6 (Σ_{D selected} (‖A_D‖_{2,I} + D_*^{-30} Σ_{m ∈ D} |α_m|)²)^{1/2}`,
where `D` runs over the selected modes grouped by their minimal CURRENT components and
`A_D = Σ_{m ∈ D} α_m Ψ_{I,m}`.

Proof as in the blueprint: truncate the true cutoff (`cutoffP_truncate_all`, error
`τ_c ≤ D_*^{-300}`, coefficient sum at most `cutNorm ≤ gaugeSqNorm ≤ D_*`, `torusGT_eLpNorm_le`);
the Haar norm of the truncated trigonometric polynomial differs from its cell average by at most
`D_*^{-200}` times its squared coefficient sum (`trunc_tiny_huge`, `torus_size_phys_Ico`); the cell
average is at most twice the physical one plus the torus-form error, and almost orthogonality of
minimal CURRENT components bounds the physical average by `2 Σ_D ‖A_D‖²_{2,I}`
(`selComps_cell_energy`); the errors are absorbed by the floors (`torus_floor_budget`,
`torus_size_final`). -/
theorem torus_size_of_dichotomy {b : ℤ} {J I : ℤ × ℤ} (hJ : J.1 = b - 2 * S.K)
    (hIJ : dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd J.1 J.2) (hIt : I.1 ≤ b + S.K)
    (hD : 2 ≤ S.Dstar) (hδ : 0 < Ms.δc) (hΛ : Ms.Λ ≤ S.Dstar) (hQ : 1 ≤ S.Q0)
    (hDg : gaugeSqNorm Ms.zc.dim Ms.δc ≤ S.Dstar) {Kf : ℕ}
    (hKf : 2 * gaugeTail Ms.zc.dim Ms.δc / 2 ^ Kf * S.Dstar ^ 300 ≤ 1)
    (hQB : (S.Q0 : ℝ) * 2 ^ (Kf + 1) ≤ S.Bstar) (hBA : S.Bstar ≤ S.A0)
    (hεw : ∀ m, S.Dstar⁻¹ ≤ Ms.L.εM m)
    (hcard : ((Ms.alive (ancAt Gd J (b - 4 * S.K))).card : ℝ) ≤ S.Dstar)
    (h' : ℕ) (V : Submodule ℚ (Fin Ms.zc.dim → ℚ)) {T : ℝ} (hT : 0 < T)
    (hTL : 4 * Real.pi * ModeSchedule.Lh h' * S.Dstar ^ 200 ≤ T)
    (hdich : ∀ k : Fin Ms.zc.dim → ℤ, (∀ i, |(k i : ℝ)| ≤ 4 * S.Dstar ^ 5 * S.Eh h') →
      (k ∈ rationalIntegerIntersection V →
        dyadicGridLength Gd I.1 * |∑ i, (k i : ℝ) * Ms.torusξ S h' i| ≤
          T⁻¹ / ModeSchedule.Lh h') ∧
      (k ∉ rationalIntegerIntersection V → T / ModeSchedule.Lh h' ≤
        dyadicGridLength Gd I.1 * |∑ i, (k i : ℝ) * Ms.torusξ S h' i|))
    (Fsel : Finset (Ms.alive (ancAt Gd J (b - 4 * S.K)))) (c : Ms.Md → ℂ)
    (n : Ms.alive (ancAt Gd J (b - 4 * S.K)) → Fin Ms.zc.dim → ℤ)
    (hn : ∀ x ∈ Fsel, ∀ i, |(n x i : ℝ)| ≤ S.Dstar * S.Eh h')
    {xs : ℝ} (hxs : xs ∈ dyadicGridCell Gd I.1 I.2) (ph : ℝ → ℂ) (hph : ∀ y, ‖ph y‖ = 1)
    (hform : ∀ y ∈ dyadicGridCell Gd I.1 I.2,
      ‖∑ x ∈ Fsel, c x.1 * Ms.wave x.1 y - ph y * Ms.torusG S h' xs Fsel (fun x => c x.1) n
        (fun i => Ms.torusξ S h' i * (y - xs))‖ ≤ (S.Dstar ^ 150)⁻¹ * ∑ x ∈ Fsel, ‖c x.1‖) :
    (eLpNorm (fun x : torusAnnihilator (rationalIntegerIntersection V) =>
        Ms.torusGT S h' xs Fsel (fun x => c x.1) n x.1) 2
        (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal ≤
      6 * Real.sqrt (∑ E ∈ Ms.selComps S hA b J Fsel,
        (‖∑ m ∈ E, c m • Ms.cellMode I m‖ / Real.sqrt (dyadicGridLength Gd I.1) +
          (S.Dstar ^ 30)⁻¹ * ∑ m ∈ E, ‖c m‖) ^ 2) := by
  have hDp : 0 < S.Dstar := by linarith
  have hD1 : (1 : ℝ) ≤ S.Dstar := by linarith
  have hr : 0 < dyadicGridLength Gd I.1 := dyadicGridLength_pos Gd I.1
  have hL1 : (1 : ℝ) ≤ ModeSchedule.Lh h' := one_le_pow₀ (by norm_num)
  -- the truncated cutoff
  obtain ⟨cc, -, hccN, hccT⟩ := cutoffP_truncate_all hδ Ms.ρ Kf
  have hτ0 : 0 ≤ cutTail Ms.zc.dim Ms.δc Kf := cutTail_nonneg _ hδ Kf
  have hτ : cutTail Ms.zc.dim Ms.δc Kf ≤ (S.Dstar ^ 300)⁻¹ := cutTail_le_of_Kf _ hδ hDp hKf
  have hcN : cutNorm Ms.zc.dim Ms.δc ≤ S.Dstar := (cutNorm_le_gaugeSqNorm _ hδ).trans hDg
  have hstep1 := Ms.torusGT_eLpNorm_le S hδ h' xs Fsel (fun x => c x.1) n Kf cc hτ0 hccT V
  obtain ⟨htiny, hhuge⟩ := Ms.trunc_tiny_huge S hA hBA hQB hD1 h' Fsel n hn V hT hr hdich
  -- the selected groups
  set s := Ms.selComps S hA b J Fsel with hs_def
  set Sα := ∑ x ∈ Fsel, ‖c x.1‖ with hSα
  have hSαs : Sα = ∑ E ∈ s, ∑ m ∈ E, ‖c m‖ := Ms.sum_norm_selComps S hA b J Fsel c
  have hFcard : (Fsel.card : ℝ) ≤ S.Dstar := by
    refine le_trans ?_ hcard
    exact_mod_cast (Finset.card_le_univ Fsel).trans (le_of_eq (Fintype.card_coe _))
  have hscard : (s.card : ℝ) ≤ S.Dstar :=
    le_trans (by exact_mod_cast Ms.card_selComps_le S hA b J Fsel) hFcard
  have hSα2 : Sα ^ 2 ≤ S.Dstar * ∑ E ∈ s, (∑ m ∈ E, ‖c m‖) ^ 2 := by
    rw [hSαs]
    refine (sq_sum_le_card_mul_sum_sq).trans ?_
    exact mul_le_mul_of_nonneg_right hscard (Finset.sum_nonneg fun _ _ => sq_nonneg _)
  obtain ⟨hfl1, hfl2⟩ := torus_floor_budget s (fun E => ∑ m ∈ E, ‖c m‖) hD1 hτ0 hτ hSα2
  -- the cell data
  set r := dyadicGridLength Gd I.1 with hr_def
  set! a₀ := dyadicGridLeft Gd I.1 I.2 with ha₀
  have hcell : dyadicGridCell Gd I.1 I.2 = Set.Ico a₀ (a₀ + r) := rfl
  have hxs' : xs ∈ Set.Ico a₀ (a₀ + r) := hxs
  have hbox : (S.Q0 : ℝ) * 2 ^ (Kf + 1) ≤ S.Eh 0 := by
    unfold ModeSchedule.Eh; rw [zero_add, pow_one]; linarith
  have hint := Ms.selComps_cell_energy S hA hJ hIJ hIt hD hδ hΛ hQ hDg hKf hbox hεw hcard Fsel c
  rw [hcell] at hint
  -- the pointwise comparison along the cell line
  have hpt : ∀ y ∈ Set.Ico a₀ (a₀ + r), ‖∑ p ∈ frequencyBox Ms.zc.dim (2 ^ (Kf + 1)) ×ˢ Fsel,
      (cc p.1 * (Real.fourierChar (∑ i, (p.1 i : ℝ) * (Ms.zc.θ i * xs)) : ℂ) *
        (c p.2.1 * (Real.fourierChar (Ms.phase p.2.1 xs) : ℂ))) *
      torusCharacter (((S.Q0 * 6 ^ h' : ℕ) : ℤ) • p.1 + n p.2)
        (torusMk fun i => Ms.torusξ S h' i * (y - xs))‖ ≤
      ‖∑ x ∈ Fsel, c x.1 * Ms.wave x.1 y‖ +
        ((S.Dstar ^ 150)⁻¹ + cutTail Ms.zc.dim Ms.δc Kf) * Sα := by
    intro y hy
    have h1 := (abs_norm_sub_norm_le _ _).trans (Ms.torusG_trunc S h' xs Fsel (fun x => c x.1) n
      Kf cc hccT (fun i => Ms.torusξ S h' i * (y - xs)))
    have h2 := hform y hy
    rw [norm_sub_rev] at h2
    have e : ‖Ms.torusG S h' xs Fsel (fun x => c x.1) n (fun i => Ms.torusξ S h' i * (y - xs))‖ =
        ‖ph y * Ms.torusG S h' xs Fsel (fun x => c x.1) n
          (fun i => Ms.torusξ S h' i * (y - xs))‖ := by
      rw [norm_mul, hph, one_mul]
    have h3 := norm_le_insert' (ph y * Ms.torusG S h' xs Fsel (fun x => c x.1) n
      (fun i => Ms.torusξ S h' i * (y - xs))) (∑ x ∈ Fsel, c x.1 * Ms.wave x.1 y)
    rw [← e] at h3
    linarith [(abs_le.mp h1).1]
  -- the cell-average budget
  set! aE : Finset Ms.Md → ℝ := fun E => ‖∑ m ∈ E, c m • Ms.cellMode I m‖ / Real.sqrt r with haE
  have haE0 : ∀ E, 0 ≤ aE E := fun E => div_nonneg (norm_nonneg _) (Real.sqrt_nonneg _)
  have hXA : 2 * (r⁻¹ * ∫ y in a₀..a₀ + r, ‖∑ x ∈ Fsel, c x.1 * Ms.wave x.1 y‖ ^ 2) +
      2 * (((S.Dstar ^ 150)⁻¹ + cutTail Ms.zc.dim Ms.δc Kf) * Sα) ^ 2 ≤
      2 * ∑ E ∈ s, (2 * (aE E + (S.Dstar ^ 30)⁻¹ * ∑ m ∈ E, ‖c m‖)) ^ 2 := by
    have h1 : r⁻¹ * ∫ y in a₀..a₀ + r, ‖∑ x ∈ Fsel, c x.1 * Ms.wave x.1 y‖ ^ 2 ≤
        2 * ∑ E ∈ s, aE E ^ 2 := by
      have haE2 : ∀ E, aE E ^ 2 = ‖∑ m ∈ E, c m • Ms.cellMode I m‖ ^ 2 / r := fun E => by
        simp only [haE]; rw [div_pow, Real.sq_sqrt hr.le]
      simp_rw [haE2]
      rw [intervalIntegral.integral_of_le (by linarith), ← integral_Ico_eq_integral_Ioc,
        ← Finset.sum_div, mul_comm, ← div_eq_mul_inv, mul_div_assoc']
      exact div_le_div_of_nonneg_right hint hr.le
    have h2 : ∑ E ∈ s, (2 * (aE E + (S.Dstar ^ 30)⁻¹ * ∑ m ∈ E, ‖c m‖)) ^ 2 =
        4 * ∑ E ∈ s, aE E ^ 2 + 4 * ∑ E ∈ s, ((S.Dstar ^ 30)⁻¹ * ∑ m ∈ E, ‖c m‖) ^ 2 +
          8 * ∑ E ∈ s, aE E * ((S.Dstar ^ 30)⁻¹ * ∑ m ∈ E, ‖c m‖) := by
      rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib,
        ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun E _ => by ring
    have h3 : 0 ≤ ∑ E ∈ s, aE E * ((S.Dstar ^ 30)⁻¹ * ∑ m ∈ E, ‖c m‖) :=
      Finset.sum_nonneg fun E _ => mul_nonneg (haE0 E)
        (mul_nonneg (by positivity) (Finset.sum_nonneg fun _ _ => norm_nonneg _))
    have h4 : 0 ≤ ∑ E ∈ s, aE E ^ 2 := Finset.sum_nonneg fun E _ => sq_nonneg _
    rw [h2]
    linarith only [hfl1, h1, h3, h4]
  have hcS : ∑ p ∈ frequencyBox Ms.zc.dim (2 ^ (Kf + 1)) ×ˢ Fsel,
      ‖cc p.1 * (Real.fourierChar (∑ i, (p.1 i : ℝ) * (Ms.zc.θ i * xs)) : ℂ) *
        (c p.2.1 * (Real.fourierChar (Ms.phase p.2.1 xs) : ℂ))‖ ≤
      ∑ E ∈ s, S.Dstar * ∑ m ∈ E, ‖c m‖ := by
    rw [← Finset.mul_sum, ← hSαs, Finset.sum_product]
    have e : ∀ v, ∑ x ∈ Fsel, ‖cc v * (Real.fourierChar (∑ i, (v i : ℝ) * (Ms.zc.θ i * xs)) : ℂ) *
        (c x.1 * (Real.fourierChar (Ms.phase x.1 xs) : ℂ))‖ = ‖cc v‖ * Sα := fun v => by
      rw [hSα, Finset.mul_sum]
      refine Finset.sum_congr rfl fun x _ => ?_
      simp only [norm_mul, Circle.norm_coe, mul_one]
    simp_rw [e]
    rw [← Finset.sum_mul]
    exact mul_le_mul_of_nonneg_right ((hccN _).trans hcN)
      (Finset.sum_nonneg fun _ _ => norm_nonneg _)
  have hεD : 2 * (2 * Real.pi * ModeSchedule.Lh h' / T) ≤ (S.Dstar ^ 2) ^ (-100 : ℤ) := by
    have e : (S.Dstar ^ 2) ^ (-100 : ℤ) = (S.Dstar ^ 200)⁻¹ := by
      rw [← zpow_natCast S.Dstar 2, ← zpow_mul,
        show ((2 : ℕ) : ℤ) * (-100) = -((200 : ℕ) : ℤ) by norm_num, zpow_neg, zpow_natCast]
    rw [e, show 2 * (2 * Real.pi * ModeSchedule.Lh h' / T) =
      4 * Real.pi * ModeSchedule.Lh h' / T by ring, div_le_iff₀ hT]
    rw [inv_mul_eq_div, le_div_iff₀ (by positivity)]
    linarith
  have hP := torus_size_phys_Ico V (frequencyBox Ms.zc.dim (2 ^ (Kf + 1)) ×ˢ Fsel)
    (fun p => cc p.1 * (Real.fourierChar (∑ i, (p.1 i : ℝ) * (Ms.zc.θ i * xs)) : ℂ) *
        (c p.2.1 * (Real.fourierChar (Ms.phase p.2.1 xs) : ℂ)))
    (fun p => ((S.Q0 * 6 ^ h' : ℕ) : ℤ) • p.1 + n p.2) (fun i => Ms.torusξ S h' i) hr
    ⟨hxs'.1, hxs'.2.le⟩ (div_pos (mul_pos (by positivity) (by linarith)) hT) htiny hhuge
    (fun y => ∑ x ∈ Fsel, c x.1 * Ms.wave x.1 y)
    (Finset.measurable_sum _ fun x _ => measurable_const.mul (Ms.wave_measurable x.1))
    (M := Sα) (fun y => (norm_sum_le _ _).trans (Finset.sum_le_sum fun x _ => by
      rw [norm_mul]; exact mul_le_of_le_one_right (norm_nonneg _) (Ms.wave_norm_le x.1 y)))
    hpt s (fun E => 2 * (aE E + (S.Dstar ^ 30)⁻¹ * ∑ m ∈ E, ‖c m‖))
    (fun E => S.Dstar * ∑ m ∈ E, ‖c m‖)
    (fun E _ => mul_nonneg (by norm_num) (add_nonneg (haE0 E)
      (mul_nonneg (by positivity) (Finset.sum_nonneg fun _ _ => norm_nonneg _))))
    (fun E _ => mul_nonneg hDp.le (Finset.sum_nonneg fun _ _ => norm_nonneg _))
    (one_le_pow₀ hD1 : (1 : ℝ) ≤ S.Dstar ^ 2) (hscard.trans (by nlinarith only [hD])) hεD hXA hcS
  exact torus_size_final s aE (fun E => ∑ m ∈ E, ‖c m‖) hD1 haE0
    (fun E => Finset.sum_nonneg fun _ _ => norm_nonneg _)
    (mul_nonneg hτ0 (Finset.sum_nonneg fun _ _ => norm_nonneg _)) hP hstep1 hfl2

end ModeSystem

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0) (SP : SideParams)

open Classical in
/-- When the selected modes are exactly the core modes of a union of minimal CURRENT components
inside `F_h(x)` (the masks select entire units, blueprint line 2466), every selected group is the
full core part of its minimal CURRENT component, so the sum of `eq:torus-size` is at most the
component size `σ_F²` of `eq:component-size`. -/
theorem selComps_sum_le_compSizeSq {b : ℤ} {J : ℤ × ℤ} (I : ℤ × ℤ) {h : ℕ}
    {x : Ms.alive (ancAt Gd J (b - 4 * S.K))} (F : Finset (Ms.alive (ancAt Gd J (b - 4 * S.K))))
    (hFh : ∀ y ∈ F, y ∈ (Ms.blockComps S hA b J).F h x)
    (hunit : ∀ y ∈ F, ∀ z ∈ (Ms.blockComps S hA b J).F 0 y, z ∈ F ↔ Ms.IsCoreAt S hA SP b J z.1)
    (c : Ms.Md → ℂ) :
    ∑ E ∈ Ms.selComps S hA b J F,
        (‖∑ m ∈ E, c m • Ms.cellMode I m‖ / Real.sqrt (dyadicGridLength Gd I.1) +
          (S.Dstar ^ 30)⁻¹ * ∑ m ∈ E, ‖c m‖) ^ 2 ≤
      Ms.compSizeSq S hA SP I b J h x c := by
  set C := Ms.blockComps S hA b J
  set f : Finset Ms.Md → ℝ := fun E =>
    (‖∑ m ∈ E, c m • Ms.cellMode I m‖ / Real.sqrt (dyadicGridLength Gd I.1) +
      (S.Dstar ^ 30)⁻¹ * ∑ m ∈ E, ‖c m‖) ^ 2 with hf
  have hsub : Ms.selComps S hA b J F ⊆
      (Ms.minComps S hA b J h x).image fun D => D.filter (Ms.IsCoreAt S hA SP b J) := by
    intro E hE
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hE
    refine Finset.mem_image.mpr ⟨(C.F 0 y).map ⟨Subtype.val, Subtype.val_injective⟩,
      (Ms.mem_minComps S hA).mpr ⟨y, hFh y hy, rfl⟩, ?_⟩
    ext m
    simp only [Finset.mem_filter, Finset.mem_map, Function.Embedding.coeFn_mk]
    constructor
    · rintro ⟨⟨z, hz, rfl⟩, hcore⟩
      exact ⟨z, ⟨(hunit y hy z hz).mpr hcore, hz⟩, rfl⟩
    · rintro ⟨z, ⟨hzF, hz⟩, rfl⟩
      exact ⟨⟨z, hz, rfl⟩, (hunit y hy z hz).mp hzF⟩
  calc ∑ E ∈ Ms.selComps S hA b J F, f E ≤
        ∑ E ∈ (Ms.minComps S hA b J h x).image fun D => D.filter (Ms.IsCoreAt S hA SP b J), f E :=
        Finset.sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ => sq_nonneg _
    _ ≤ ∑ D ∈ Ms.minComps S hA b J h x, f (D.filter (Ms.IsCoreAt S hA SP b J)) :=
        Finset.sum_image_le_of_nonneg fun _ _ => sq_nonneg _
    _ = Ms.compSizeSq S hA SP I b J h x c := rfl

end ModeSystem

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

/-- At the chosen schedule the large threshold dominates the frequency scale:
`4π L_{h'} D_*^{200} ≤ T` for `h' ≤ J_*` (`T > H Ξ`, `H > L_{J_*}`, `Ξ = D_*^{1000}`). -/
theorem Tt_ge_Lh {Cj CA CT CK : ℕ} {δs W : ℝ} (hV : D.S.Valid Cj CA CT CK δs W) (hCT : 4 ≤ CT)
    (hd2 : 2 ≤ D.S.dmax) (hD : 2 ≤ D.S.Dstar) (hB : 2 ≤ D.S.Bstar) (hQ : 1 ≤ D.S.Q0)
    (hSP : D.SP = D.S.sideParams δs) {h' : ℕ} (hh : h' ≤ D.SP.Jst) :
    4 * Real.pi * ModeSchedule.Lh h' * D.S.Dstar ^ 200 ≤ D.SP.Tt := by
  have hTt : D.SP.Tt = D.S.T := by rw [hSP]; rfl
  have hJst : D.SP.Jst = D.S.Jstar := by rw [hSP]; rfl
  rw [hTt]
  have hT := hV.H_mul_Ξ_lt_T (by omega) hd2 hD hB hQ
  have hH := hV.H_ge hd2 hD hB hQ
  have hA := hV.one_le_A0 hd2 hD hB
  have hE : 1 ≤ D.S.Eh D.S.Jstar := one_le_pow₀ hA
  have hLJ : (1 : ℝ) ≤ ModeSchedule.Lh D.S.Jstar := one_le_pow₀ (by norm_num)
  have hL : ModeSchedule.Lh h' ≤ ModeSchedule.Lh D.S.Jstar :=
    pow_le_pow_right₀ (by norm_num) (by rw [← hJst]; exact hh)
  have hL0 : 0 < ModeSchedule.Lh h' := pow_pos (by norm_num) _
  have hD4 : (16 : ℝ) ≤ D.S.Dstar ^ 4 :=
    le_trans (by norm_num) (pow_le_pow_left₀ (by norm_num) hD 4)
  have hD1 : (1 : ℝ) ≤ D.S.Dstar := by linarith
  have hLH : ModeSchedule.Lh D.S.Jstar ≤ D.S.H := by
    have hEL : ModeSchedule.Lh D.S.Jstar ≤ D.S.Eh D.S.Jstar * ModeSchedule.Lh D.S.Jstar :=
      le_mul_of_one_le_left (by linarith) hE
    have h1 : ModeSchedule.Lh D.S.Jstar ≤ (D.S.Eh D.S.Jstar * ModeSchedule.Lh D.S.Jstar) ^ 2 :=
      hEL.trans (le_self_pow₀ (le_trans hLJ hEL) (by norm_num))
    have h2 : 0 ≤ (D.S.Eh D.S.Jstar * ModeSchedule.Lh D.S.Jstar) ^ 2 := sq_nonneg _
    nlinarith only [hH, hLJ, hD4, hEL]
  have hΞ : 4 * Real.pi * D.S.Dstar ^ 200 ≤ D.S.Ξ := by
    have hpi : Real.pi < 4 := Real.pi_lt_four
    have h1 : D.S.Dstar ^ 4 ≤ D.S.Dstar ^ 800 := pow_le_pow_right₀ hD1 (by norm_num)
    have h2 : 0 < D.S.Dstar ^ 200 := by positivity
    unfold ModeSchedule.Ξ
    rw [show (1000 : ℕ) = 800 + 200 from rfl, pow_add]
    nlinarith only [hD4, hpi, h1, h2]
  have hΞ0 : 0 ≤ 4 * Real.pi * D.S.Dstar ^ 200 := by positivity
  calc 4 * Real.pi * ModeSchedule.Lh h' * D.S.Dstar ^ 200 =
        ModeSchedule.Lh h' * (4 * Real.pi * D.S.Dstar ^ 200) := by ring
    _ ≤ D.S.H * D.S.Ξ := mul_le_mul (hL.trans hLH) hΞ hΞ0 (by linarith)
    _ ≤ D.S.T := hT.le

open Classical in
/-- Blueprint `eq:torus-size` (lines 2489-2496) on a leaf cell `I` of the side states, for the
role `l` and group `G`: for a mode `m` good at a final upper height `h ≤ J_*` and any selected
modes `F` with the torus form `eq:core-torus-form` (`core_torus_form`: shifts of size at most
`D_* E_{h-Δ}`, error `D_*^{-150}` times the coefficient sum, `ξ = ϑ/L_{h-Δ}`), the periodic factor
`g = g_j` satisfies on `𝓗 = (K_B ∩ ℤ^d)^⊥`
`a' = ‖g‖_{L²(𝓗)} ≤ 6 (Σ_{D selected} (‖A_D‖_{2,I} + D_*^{-30} Σ_{m ∈ D} |α_m|)²)^{1/2}`,
`D` the selected modes grouped by their minimal CURRENT components, `A_D = Σ_{m ∈ D} α_m Ψ_{I,m}`.
The tiny/huge alternatives come from `box_dichotomy`; the schedule facts are those of
`size_comparison` (`gaugeSqNorm ≤ D_*`, the Fourier cutoff `K_f`, private weights at least
`D_*^{-1}`, at most `D_*` alive modes, `Λ ≤ D_*`). -/
theorem torus_size {Cj CA CT CK : ℕ} {δs W : ℝ} (hV : D.S.Valid Cj CA CT CK δs W)
    (hCA : 1 ≤ CA) (hCT : 4 ≤ CT) (hd2 : 2 ≤ D.S.dmax) (hD : 2 ≤ D.S.Dstar) (hB : 2 ≤ D.S.Bstar)
    (hQ : 1 ≤ D.S.Q0) (hSP : D.SP = D.S.sideParams δs) (I : ℤ × ℤ) (l : Fin 4) (G : bf.Grp)
    (hdim : (D.Ms l G).zc.dim ≤ D.S.dmax) (hδ : 0 < (D.Ms l G).δc)
    (hDg : gaugeSqNorm (D.Ms l G).zc.dim (D.Ms l G).δc ≤ D.S.Dstar) {Kf : ℕ}
    (hKf : 2 * gaugeTail (D.Ms l G).zc.dim (D.Ms l G).δc / 2 ^ Kf * D.S.Dstar ^ 300 ≤ 1)
    (hQB : (D.S.Q0 : ℝ) * 2 ^ (Kf + 1) ≤ D.S.Bstar)
    (hεw : ∀ m, D.S.Dstar⁻¹ ≤ (D.Ms l G).L.εM m)
    (hcard : (((D.Ms l G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card : ℝ) ≤ D.S.Dstar)
    (hΛ : (D.Ms l G).Λ ≤ D.S.Dstar) {h : ℕ} (hh : h ≤ D.SP.Jst)
    {m : (D.Ms l G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))}
    (hgood : ((D.Ms l G).blockComps D.S D.hA (A.blkStart D.S.K I.1) (D.preAt I)).Good D.SP.Δ
      ((D.Ms l G).goodP D.S D.SP (A.blkStart D.S.K I.1)) h m)
    (Fsel : Finset ((D.Ms l G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))))
    (n : (D.Ms l G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K)) →
      Fin (D.Ms l G).zc.dim → ℤ)
    (hn : ∀ x ∈ Fsel, ∀ i, |(n x i : ℝ)| ≤ D.S.Dstar * D.S.Eh (h - D.SP.Δ))
    (a : (D.Ms l G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K)))
    {xs : ℝ} (hxs : xs ∈ dyadicGridCell A.G I.1 I.2)
    (hform : ∀ y ∈ dyadicGridCell A.G I.1 I.2,
      ‖∑ x ∈ Fsel, D.c l G (A.blkStart D.S.K I.1) (D.preAt I) x.1 * (D.Ms l G).wave x.1 y -
        (Real.fourierChar (((D.Ms l G).cl : ℝ) * centerPhase (D.Ms l G).zc (D.Ms l G).ρ y) : ℂ) *
          (Real.fourierChar ((D.Ms l G).slope a.1 xs * (y - xs)) : ℂ) *
          (D.Ms l G).torusG D.S (h - D.SP.Δ) xs Fsel
            (fun x => D.c l G (A.blkStart D.S.K I.1) (D.preAt I) x.1) n
            (fun i => (D.Ms l G).torusξ D.S (h - D.SP.Δ) i * (y - xs))‖ ≤
        (D.S.Dstar ^ 150)⁻¹ *
          ∑ x ∈ Fsel, ‖D.c l G (A.blkStart D.S.K I.1) (D.preAt I) x.1‖) :
    (eLpNorm (fun x : torusAnnihilator (rationalIntegerIntersection
        (tinySpan (fun i => (D.Ms l G).zc.θ i / D.S.Q0) D.SP.Hn
          (D.SP.Tt⁻¹ / dyadicGridLength A.G (A.blkStart D.S.K I.1 - 2 * D.S.K)))) =>
        (D.Ms l G).torusGT D.S (h - D.SP.Δ) xs Fsel
          (fun x => D.c l G (A.blkStart D.S.K I.1) (D.preAt I) x.1) n x.1) 2
        (torusAnnihilatorHaar (rationalIntegerIntersection
          (tinySpan (fun i => (D.Ms l G).zc.θ i / D.S.Q0) D.SP.Hn
            (D.SP.Tt⁻¹ / dyadicGridLength A.G (A.blkStart D.S.K I.1 - 2 * D.S.K)))))).toReal ≤
      6 * Real.sqrt (∑ E ∈ (D.Ms l G).selComps D.S D.hA (A.blkStart D.S.K I.1) (D.preAt I) Fsel,
        (‖∑ m ∈ E, D.c l G (A.blkStart D.S.K I.1) (D.preAt I) m • (D.Ms l G).cellMode I m‖ /
            Real.sqrt (dyadicGridLength A.G I.1) +
          (D.S.Dstar ^ 30)⁻¹ * ∑ m ∈ E, ‖D.c l G (A.blkStart D.S.K I.1) (D.preAt I) m‖) ^ 2) := by
  have hb := blkStart_bounds D.hK I.1 (A := A)
  have hTt : D.SP.Tt = D.S.T := by rw [hSP]; rfl
  have hT : 0 < D.SP.Tt := by
    rw [hTt]; linarith [hV.one_le_T (by omega) hd2 hD hB hQ]
  obtain ⟨-, -, -, hdich⟩ := D.box_dichotomy hV hCA hCT hd2 hD hB hQ hSP I l G hdim hh hgood
  have hE0 : 0 ≤ D.S.Eh (h - D.SP.Δ) := pow_nonneg (by linarith [D.hA]) _
  have h416 : 4 * D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ) ≤ 16 * D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ) :=
    mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (by norm_num) (by positivity)) hE0
  exact (D.Ms l G).torus_size_of_dichotomy D.S D.hA (b := A.blkStart D.S.K I.1)
    (J := D.preAt I) rfl (D.subset_preAt I) (by omega) hD hδ hΛ hQ hDg hKf hQB
    (hV.Bstar_le_A0 hCA hd2 hD hB) hεw hcard (h - D.SP.Δ) _ hT
    (D.Tt_ge_Lh hV hCT hd2 hD hB hQ hSP (le_trans (Nat.sub_le _ _) hh))
    (fun k hk => hdich k fun i => (hk i).trans h416) Fsel _ n hn hxs
    (fun y => (Real.fourierChar (((D.Ms l G).cl : ℝ) *
      centerPhase (D.Ms l G).zc (D.Ms l G).ρ y) : ℂ) *
        (Real.fourierChar ((D.Ms l G).slope a.1 xs * (y - xs)) : ℂ))
    (fun y => by rw [norm_mul, Circle.norm_coe, Circle.norm_coe, one_mul]) hform

open Classical in
/-- Blueprint `eq:torus-size` in the form used for the component bins (line 2582: "for a core role
`σ_j` bins `eq:component-size`"): when the selected modes are exactly the core modes of a union of
minimal CURRENT components inside `F_h(m)` (masks select entire units), `a'_j ≤ 6 σ_F` with
`σ_F² = compSizeSq` the component size of `eq:component-size`. -/
theorem torus_size_compSize {Cj CA CT CK : ℕ} {δs W : ℝ} (hV : D.S.Valid Cj CA CT CK δs W)
    (hCA : 1 ≤ CA) (hCT : 4 ≤ CT) (hd2 : 2 ≤ D.S.dmax) (hD : 2 ≤ D.S.Dstar) (hB : 2 ≤ D.S.Bstar)
    (hQ : 1 ≤ D.S.Q0) (hSP : D.SP = D.S.sideParams δs) (I : ℤ × ℤ) (l : Fin 4) (G : bf.Grp)
    (hdim : (D.Ms l G).zc.dim ≤ D.S.dmax) (hδ : 0 < (D.Ms l G).δc)
    (hDg : gaugeSqNorm (D.Ms l G).zc.dim (D.Ms l G).δc ≤ D.S.Dstar) {Kf : ℕ}
    (hKf : 2 * gaugeTail (D.Ms l G).zc.dim (D.Ms l G).δc / 2 ^ Kf * D.S.Dstar ^ 300 ≤ 1)
    (hQB : (D.S.Q0 : ℝ) * 2 ^ (Kf + 1) ≤ D.S.Bstar)
    (hεw : ∀ m, D.S.Dstar⁻¹ ≤ (D.Ms l G).L.εM m)
    (hcard : (((D.Ms l G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card : ℝ) ≤ D.S.Dstar)
    (hΛ : (D.Ms l G).Λ ≤ D.S.Dstar) {h : ℕ} (hh : h ≤ D.SP.Jst)
    {m : (D.Ms l G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))}
    (hgood : ((D.Ms l G).blockComps D.S D.hA (A.blkStart D.S.K I.1) (D.preAt I)).Good D.SP.Δ
      ((D.Ms l G).goodP D.S D.SP (A.blkStart D.S.K I.1)) h m)
    (Fsel : Finset ((D.Ms l G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))))
    (hFh : ∀ y ∈ Fsel,
      y ∈ ((D.Ms l G).blockComps D.S D.hA (A.blkStart D.S.K I.1) (D.preAt I)).F h m)
    (hunit : ∀ y ∈ Fsel, ∀ z ∈ ((D.Ms l G).blockComps D.S D.hA (A.blkStart D.S.K I.1)
      (D.preAt I)).F 0 y, z ∈ Fsel ↔
        (D.Ms l G).IsCoreAt D.S D.hA D.SP (A.blkStart D.S.K I.1) (D.preAt I) z.1)
    (n : (D.Ms l G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K)) →
      Fin (D.Ms l G).zc.dim → ℤ)
    (hn : ∀ x ∈ Fsel, ∀ i, |(n x i : ℝ)| ≤ D.S.Dstar * D.S.Eh (h - D.SP.Δ))
    (a : (D.Ms l G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K)))
    {xs : ℝ} (hxs : xs ∈ dyadicGridCell A.G I.1 I.2)
    (hform : ∀ y ∈ dyadicGridCell A.G I.1 I.2,
      ‖∑ x ∈ Fsel, D.c l G (A.blkStart D.S.K I.1) (D.preAt I) x.1 * (D.Ms l G).wave x.1 y -
        (Real.fourierChar (((D.Ms l G).cl : ℝ) * centerPhase (D.Ms l G).zc (D.Ms l G).ρ y) : ℂ) *
          (Real.fourierChar ((D.Ms l G).slope a.1 xs * (y - xs)) : ℂ) *
          (D.Ms l G).torusG D.S (h - D.SP.Δ) xs Fsel
            (fun x => D.c l G (A.blkStart D.S.K I.1) (D.preAt I) x.1) n
            (fun i => (D.Ms l G).torusξ D.S (h - D.SP.Δ) i * (y - xs))‖ ≤
        (D.S.Dstar ^ 150)⁻¹ *
          ∑ x ∈ Fsel, ‖D.c l G (A.blkStart D.S.K I.1) (D.preAt I) x.1‖) :
    (eLpNorm (fun x : torusAnnihilator (rationalIntegerIntersection
        (tinySpan (fun i => (D.Ms l G).zc.θ i / D.S.Q0) D.SP.Hn
          (D.SP.Tt⁻¹ / dyadicGridLength A.G (A.blkStart D.S.K I.1 - 2 * D.S.K)))) =>
        (D.Ms l G).torusGT D.S (h - D.SP.Δ) xs Fsel
          (fun x => D.c l G (A.blkStart D.S.K I.1) (D.preAt I) x.1) n x.1) 2
        (torusAnnihilatorHaar (rationalIntegerIntersection
          (tinySpan (fun i => (D.Ms l G).zc.θ i / D.S.Q0) D.SP.Hn
            (D.SP.Tt⁻¹ / dyadicGridLength A.G (A.blkStart D.S.K I.1 - 2 * D.S.K)))))).toReal ≤
      6 * Real.sqrt ((D.Ms l G).compSizeSq D.S D.hA D.SP I (A.blkStart D.S.K I.1) (D.preAt I) h m
        (D.c l G (A.blkStart D.S.K I.1) (D.preAt I))) := by
  refine (D.torus_size hV hCA hCT hd2 hD hB hQ hSP I l G hdim hδ hDg hKf hQB hεw hcard hΛ hh
    hgood Fsel n hn a hxs hform).trans ?_
  exact mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt
    ((D.Ms l G).selComps_sum_le_compSizeSq D.S D.hA D.SP I Fsel hFh hunit _)) (by norm_num)


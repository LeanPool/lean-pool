/-- At the chosen schedule `L_{h'} (U₀ + 4) ≤ T` for `h' ≤ J_*` (as `Tt_ge_U0`, with
`U₀ + 4 ≤ Ξ = D_*^{1000}`): the far cosets of the three-core test are at least `4` away from the
reference (`H ≥ 4` in `three_core_averaged_of`). -/
theorem Tt_ge_U0_four {Cj CA CT CK : ℕ} {δs W : ℝ} (hV : D.S.Valid Cj CA CT CK δs W)
    (hCT : 4 ≤ CT) (hd2 : 2 ≤ D.S.dmax) (hD : 2 ≤ D.S.Dstar) (hB : 2 ≤ D.S.Bstar)
    (hQ : 1 ≤ D.S.Q0) (hSP : D.SP = D.S.sideParams δs) {h' : ℕ} (hh : h' ≤ D.SP.Jst) :
    ModeSchedule.Lh h' * (D.U0 + 4) ≤ D.SP.Tt := by
  have hTt : D.SP.Tt = D.S.T := by rw [hSP]; rfl
  have hJst : D.SP.Jst = D.S.Jstar := by rw [hSP]; rfl
  rw [hTt]
  have hT := hV.H_mul_Ξ_lt_T (by omega) hd2 hD hB hQ
  have hH := hV.H_ge hd2 hD hB hQ
  have hA := hV.one_le_A0 hd2 hD hB
  have hE : 1 ≤ D.S.Eh D.S.Jstar := one_le_pow₀ hA
  have hLJ : (1 : ℝ) ≤ ModeSchedule.Lh D.S.Jstar := one_le_pow₀ (by norm_num)
  have hL : ModeSchedule.Lh h' ≤ ModeSchedule.Lh D.S.Jstar :=
    pow_le_pow_right₀ (by norm_num) (by rw [← hJst]; exact hh)
  have hD1 : (1 : ℝ) ≤ D.S.Dstar := by linarith
  have hLH : ModeSchedule.Lh D.S.Jstar ≤ D.S.H := by
    have hEL : ModeSchedule.Lh D.S.Jstar ≤ D.S.Eh D.S.Jstar * ModeSchedule.Lh D.S.Jstar :=
      le_mul_of_one_le_left (by linarith) hE
    have h1 : ModeSchedule.Lh D.S.Jstar ≤ (D.S.Eh D.S.Jstar * ModeSchedule.Lh D.S.Jstar) ^ 2 :=
      hEL.trans (le_self_pow₀ (le_trans hLJ hEL) (by norm_num))
    have h2 : 0 ≤ (D.S.Eh D.S.Jstar * ModeSchedule.Lh D.S.Jstar) ^ 2 := sq_nonneg _
    have hD4 : (1 : ℝ) ≤ 27 * D.S.Dstar ^ 4 := by
      have : (1 : ℝ) ≤ D.S.Dstar ^ 4 := one_le_pow₀ hD1
      linarith
    have h3 := mul_le_mul_of_nonneg_right hD4 h2
    linarith
  have hΞ : D.U0 + 4 ≤ D.S.Ξ := by
    unfold U0 ModeSchedule.Ξ
    have h1 : (4 : ℝ) ≤ D.S.Dstar ^ 250 :=
      calc (4 : ℝ) = 2 ^ 2 := by norm_num
        _ ≤ D.S.Dstar ^ 2 := pow_le_pow_left₀ (by norm_num) hD 2
        _ ≤ D.S.Dstar ^ 250 := pow_le_pow_right₀ hD1 (by norm_num)
    have h2 : D.S.Dstar ^ 251 ≤ D.S.Dstar ^ 1000 := pow_le_pow_right₀ hD1 (by norm_num)
    rw [pow_succ] at h2
    have h3 : D.S.Dstar ^ 250 * 2 ≤ D.S.Dstar ^ 250 * D.S.Dstar :=
      mul_le_mul_of_nonneg_left hD (by positivity)
    linarith
  have hU0 : 0 ≤ D.U0 + 4 := by unfold U0; positivity
  calc ModeSchedule.Lh h' * (D.U0 + 4) ≤ D.S.H * D.S.Ξ :=
        mul_le_mul (hL.trans hLH) hΞ hU0 (by linarith)
    _ ≤ D.S.T := hT.le

/-- The side windows of a three-core tuple with side role `l` (blueprint lines 2556-2560): the
integers `k` with `|k - r(Q + n·ξ)| ≤ 2Λ` for some integer `n` in the box `|n|_∞ ≤ 16 B'_{h'}`
(`Q = Σ_{j ≠ l} γ_j^*`, `ξ = ϑ/L_{h'}` in the chart of role `0`). The windows use the entire box
and do not depend on the mode masks. -/
noncomputable def threeWin (G : bf.Grp) (I : ℤ × ℤ) (_xs : ℝ) (h' : ℕ) (l : Fin 4)
    (a : Fin 4 → ℝ)
    (Λ : ℝ) : Finset ℤ :=
  (frequencyBox (D.Ms 0 G).zc.dim ⌊16 * (D.S.Dstar ^ 5 * D.S.Eh h')⌋₊).biUnion fun n =>
    Finset.Icc ⌈dyadicGridLength A.G I.1 * (threeQ l a +
        ∑ i, (n i : ℝ) * (D.Ms 0 G).torusξ D.S h' i) - 2 * Λ⌉
      ⌊dyadicGridLength A.G I.1 * (threeQ l a +
        ∑ i, (n i : ℝ) * (D.Ms 0 G).torusξ D.S h' i) + 2 * Λ⌋

theorem mem_threeWin (hD : 0 ≤ D.S.Dstar) {G : bf.Grp} {I : ℤ × ℤ} {xs : ℝ} {h' : ℕ}
    {l : Fin 4}
    {a : Fin 4 → ℝ}
    {Λ : ℝ} {k : ℤ} {n : Fin (D.Ms 0 G).zc.dim → ℤ}
    (hn : ∀ i, |(n i : ℝ)| ≤ 16 * (D.S.Dstar ^ 5 * D.S.Eh h'))
    (hk : |(k : ℝ) - dyadicGridLength A.G I.1 * (threeQ l a +
        ∑ i, (n i : ℝ) * (D.Ms 0 G).torusξ D.S h' i)| ≤ 2 * Λ) :
    k ∈ D.threeWin G I xs h' l a Λ := by
  have hB : 0 ≤ 16 * (D.S.Dstar ^ 5 * D.S.Eh h') :=
    mul_nonneg (by norm_num) (mul_nonneg (pow_nonneg hD 5) (pow_nonneg (by linarith [D.hA]) _))
  obtain ⟨hk1, hk2⟩ := abs_le.mp hk
  unfold threeWin
  refine Finset.mem_biUnion.mpr ⟨n, ?_, Finset.mem_Icc.mpr
    ⟨Int.ceil_le.mpr (by linarith), Int.le_floor.mpr (by linarith)⟩⟩
  unfold frequencyBox
  rw [Fintype.mem_piFinset]
  intro i
  rw [Finset.mem_Icc, ← abs_le, ← Int.natCast_natAbs, Nat.cast_le, Nat.le_floor_iff hB,
    Nat.cast_natAbs, Int.cast_abs]
  exact hn i





namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

/-- The three-core test frequency `Q = Σ_{j ≠ l} γ_j^*` for the side role `l` (blueprint line 2538).
The three-core tests take the tuple `a j = γ_j^* = ω_{a_j}(x_*)` of the slopes at the path point of
the representatives of the core roles (its side entry is not used). -/
noncomputable def threeQ (l : Fin 4) (a : Fin 4 → ℝ) : ℝ :=
  ∑ j ∈ Finset.univ.erase l, a j

/-- The anchored three-core test frequency `T_l = Σ_{j ≠ l} (j - l) γ_j^*` (blueprint line 2538). -/
noncomputable def threeT (l : Fin 4) (a : Fin 4 → ℝ) : ℝ :=
  ∑ j ∈ Finset.univ.erase l, (((j : ℕ) : ℝ) - ((l : ℕ) : ℝ)) * a j

open Classical in
/-- The candidate references of a three-core tuple (blueprint line 2540): integer `m` in the full
box with `|T_l + m·ξ| ≤ U₀ R_s` (`R_s = |I|^{-1}`, `ξ = ϑ/L_{h'}` in the chart of role `0`). -/
noncomputable def threeRefSet (G : bf.Grp) (I : ℤ × ℤ) (_xs : ℝ) (h' : ℕ) (l : Fin 4)
    (a : Fin 4 → ℝ) :
    Finset (Fin (D.Ms 0 G).zc.dim → ℤ) :=
  (D.fullBox _ h').filter fun m => dyadicGridLength A.G I.1 *
    |threeT l a + ∑ i, (m i : ℝ) * (D.Ms 0 G).torusξ D.S h' i| ≤ D.U0

/-- The mask-independent reference of a three-core tuple, chosen by a fixed rule (blueprint line
2540). -/
noncomputable def threeRef (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ) (h' : ℕ) (l : Fin 4)
    (a : Fin 4 → ℝ) :
    Fin (D.Ms 0 G).zc.dim → ℤ :=
  finPick (D.threeRefSet G I xs h' l a)

/-- The normalized anchored reference frequency `β = r (T_l + m·ξ)` (blueprint line 2540). -/
noncomputable def threeBeta (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ) (h' : ℕ) (l : Fin 4)
    (a : Fin 4 → ℝ) :
    ℝ :=
  dyadicGridLength A.G I.1 * (threeT l a +
    ∑ i, ((D.threeRef G I xs h' l a) i : ℝ) * (D.Ms 0 G).torusξ D.S h' i)

/-- The three-core test (blueprint line 2540): a tuple is kept when a reference exists and
`|β| ≥ U₀⁻¹`; otherwise it is discarded. -/
def threePasses (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ) (h' : ℕ) (l : Fin 4)
    (a : Fin 4 → ℝ) :
    Prop :=
  (D.threeRefSet G I xs h' l a).Nonempty ∧ D.U0⁻¹ ≤ |D.threeBeta G I xs h' l a|

/-- The dyadic band `μ ≍ min(1, |β|)` of the three-core test (blueprint line 2540). -/
noncomputable def threeMuBand (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ) (h' : ℕ) (l : Fin 4)
    (a : Fin 4 → ℝ) :
    ℝ :=
  dyadicBand (min 1 |D.threeBeta G I xs h' l a|)

/-- The dyadic band `ν ≍ max(1, |β|)` of the three-core test (blueprint line 2540). -/
noncomputable def threeNuBand (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ) (h' : ℕ) (l : Fin 4)
    (a : Fin 4 → ℝ) :
    ℝ :=
  dyadicBand (max 1 |D.threeBeta G I xs h' l a|)

/-- Blueprint line 2540: the chosen reference of a three-core tuple with a candidate lies in the
full box and has `|β| ≤ U₀`. -/
theorem threeRef_spec (hD : 0 ≤ D.S.Dstar) {G : bf.Grp} {I : ℤ × ℤ} {xs : ℝ} {h' : ℕ}
    {l : Fin 4}
    {a : Fin 4 → ℝ}
    (hne : (D.threeRefSet G I xs h' l a).Nonempty) :
    (∀ i, |((D.threeRef G I xs h' l a) i : ℝ)| ≤ D.S.Dstar ^ 5 * D.S.Eh h') ∧
      |D.threeBeta G I xs h' l a| ≤ D.U0 := by
  classical
  have h' : D.threeRef G I xs h' l a ∈ D.threeRefSet G I xs h' l a := finPick_mem hne
  unfold threeRefSet at h'
  obtain ⟨hbox, hb⟩ := Finset.mem_filter.mp h'
  refine ⟨(D.mem_fullBox hD).mp hbox, ?_⟩
  unfold threeBeta
  rw [abs_mul, abs_of_pos (dyadicGridLength_pos A.G I.1)]
  exact hb

/-- Blueprint line 2540 (the bands of a kept three-core tuple): when `U₀ ≥ 1`, a tuple passing the
test has `μ ≤ min(1, |β|) < 2μ` with `U₀⁻¹/2 < μ ≤ 1`, and `ν ≤ max(1, |β|) < 2ν` with
`1 ≤ ν ≤ U₀`. -/
theorem threeBands_spec (hD : 0 ≤ D.S.Dstar) (hU : 1 ≤ D.U0) {G : bf.Grp} {I : ℤ × ℤ} {xs : ℝ}
    {h' : ℕ} {l : Fin 4}
    {a : Fin 4 → ℝ}

open Classical in
/-- The torus form of `core_torus_form` in the shape of the four-core estimate: along the cell line
`u = ξ(y - x*)` the true periodic cutoff is the chart cutoff at `y`, so the periodic factor is the
gauge cutoff times `Σ_m (α_m e(φ_m(x*))) χ_{n_m}(ξ(y - x*))` with `ξ = θ/(Q₀ 6^h)`. -/
theorem torusG_line_eq {U : ℤ × ℤ} (h : ℕ) (xs : ℝ) (F : Finset (Ms.alive U))
    (α : Ms.alive U → ℂ) (n : Ms.alive U → Fin Ms.zc.dim → ℤ) (hQ : 0 < S.Q0) (s y : ℝ) :
    (Real.fourierChar ((Ms.cl : ℝ) * centerPhase Ms.zc Ms.ρ y) : ℂ) *
        (Real.fourierChar (s * (y - xs)) : ℂ) *
        Ms.torusG S h xs F α n (fun i => Ms.torusξ S h i * (y - xs)) =
      ((centerCut Ms.zc Ms.δc Ms.ρ y : ℂ) *
        (Real.fourierChar ((Ms.cl : ℝ) * centerPhase Ms.zc Ms.ρ y) : ℂ)) *
      ((Real.fourierChar (s * (y - xs)) : ℂ) *
        ∑ x ∈ F, (α x * (Real.fourierChar (Ms.phase x.1 xs) : ℂ)) *
          torusCharacter (n x) (torusMk fun i => Ms.zc.θ i / (S.Q0 * (6 ^ h : ℕ)) * (y - xs))) := by
  have hQ' : (0 : ℝ) < S.Q0 := by exact_mod_cast hQ
  have hL : (0 : ℝ) < ModeSchedule.Lh h := pow_pos (by norm_num) h
  have hξ : ∀ i, Ms.torusξ S h i = Ms.zc.θ i / (S.Q0 * (6 ^ h : ℕ)) := fun i => by
    unfold torusξ ModeSchedule.Lh; push_cast; ring
  have hcut : cutoffP Ms.δc Ms.ρ (fun i => (S.Q0 * ModeSchedule.Lh h) *
      (Ms.torusξ S h i * (y - xs)) + Ms.zc.θ i * xs) = (centerCut Ms.zc Ms.δc Ms.ρ y : ℂ) := by
    rw [centerCut_eq_cutoffP]
    congr 1
    funext i
    unfold torusξ
    field_simp
    ring
  unfold torusG
  rw [hcut]
  have hsum : ∑ m ∈ F, α m * ((Real.fourierChar (Ms.phase m.1 xs) : ℂ) *
      (Real.fourierChar (∑ i, (n m i : ℝ) * (Ms.torusξ S h i * (y - xs))) : ℂ)) =
      ∑ x ∈ F, (α x * (Real.fourierChar (Ms.phase x.1 xs) : ℂ)) *
        torusCharacter (n x) (torusMk fun i => Ms.zc.θ i / (S.Q0 * (6 ^ h : ℕ)) * (y - xs)) := by
    refine Finset.sum_congr rfl fun x _ => ?_
    rw [torusCharacter_mk]
    simp_rw [← hξ]
    ring
  rw [hsum]
  ring

open Classical in
/-- The Haar norm of the truncated periodic factor against that of the true one (blueprint lines
2470-2476): `‖g_trunc‖_{L²(𝓗)} ≤ ‖g‖_{L²(𝓗)} + τ Σ_m |α_m|` (`torusG_trunc`). -/
theorem trunc_eLpNorm_le_torusGT (hδ : 0 < Ms.δc) {U : ℤ × ℤ} (h : ℕ) (xs : ℝ)
    (F : Finset (Ms.alive U)) (α : Ms.alive U → ℂ) (n : Ms.alive U → Fin Ms.zc.dim → ℤ) (K : ℕ)
    (cc : (Fin Ms.zc.dim → ℤ) → ℂ) {τ : ℝ} (hτ0 : 0 ≤ τ)
    (hccT : ∀ w, ‖cutoffP Ms.δc Ms.ρ w - ∑ v ∈ frequencyBox Ms.zc.dim (2 ^ (K + 1)),
      cc v * (Real.fourierChar (∑ i, (v i : ℝ) * w i) : ℂ)‖ ≤ τ)
    (V : Submodule ℚ (Fin Ms.zc.dim → ℚ)) :
    (eLpNorm (fun x : torusAnnihilator (rationalIntegerIntersection V) =>
        ∑ p ∈ frequencyBox Ms.zc.dim (2 ^ (K + 1)) ×ˢ F,
          (cc p.1 * (Real.fourierChar (∑ i, (p.1 i : ℝ) * (Ms.zc.θ i * xs)) : ℂ) *
            (α p.2 * (Real.fourierChar (Ms.phase p.2.1 xs) : ℂ))) *
          torusCharacter (((S.Q0 * 6 ^ h : ℕ) : ℤ) • p.1 + n p.2) x.1) 2
        (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal ≤
      (eLpNorm (fun x : torusAnnihilator (rationalIntegerIntersection V) =>
        Ms.torusGT S h xs F α n x.1) 2
        (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal +
        τ * ∑ x ∈ F, ‖α x‖ := by
  have hP : Continuous fun x : torusAnnihilator (rationalIntegerIntersection V) =>
      ∑ p ∈ frequencyBox Ms.zc.dim (2 ^ (K + 1)) ×ˢ F,
        (cc p.1 * (Real.fourierChar (∑ i, (p.1 i : ℝ) * (Ms.zc.θ i * xs)) : ℂ) *
          (α p.2 * (Real.fourierChar (Ms.phase p.2.1 xs) : ℂ))) *
        torusCharacter (((S.Q0 * 6 ^ h : ℕ) : ℤ) • p.1 + n p.2) x.1 :=
    continuous_finsetSum _ fun p _ => continuous_const.mul
      ((continuous_torusCharacter _).comp continuous_subtype_val)
  refine eLpNorm_two_toReal_le_add hP.aestronglyMeasurable
    ((Ms.measurable_torusGT S hδ h xs F α n).comp measurable_subtype_coe).aestronglyMeasurable
    (B := ∑ x ∈ F, ‖α x‖) (fun x => ?_)
    (mul_nonneg hτ0 (Finset.sum_nonneg fun _ _ => norm_nonneg _)) (fun x => ?_)
  · change ‖Ms.torusGT S h xs F α n x.1‖ ≤ _
    unfold torusGT torusG
    rw [norm_mul]
    refine (mul_le_of_le_one_left (norm_nonneg _) (cutoffP_norm_le _ _ _)).trans ?_
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m _ => ?_)
    rw [norm_mul, norm_mul, Circle.norm_coe, Circle.norm_coe, mul_one, mul_one]
  · choose w hw using fun i => QuotientAddGroup.mk_surjective (x.1 i)
    have hx : x.1 = torusMk w := funext fun i => (hw i).symm
    change _ ≤ ‖Ms.torusGT S h xs F α n x.1‖ + _
    rw [hx, torusGT_mk]
    have h1 := (abs_norm_sub_norm_le _ _).trans (Ms.torusG_trunc S h xs F α n K cc hccT w)
    linarith [(abs_le.mp h1).1]

open Classical in
/-- Transport of one role to a common chart tag `z = Ms.zc` (blueprint line 2470: the four roles
of a group share their chart tag): the offsets `ρ'`, the integer shifts `n'`, the torus form along
the cell line in the chart `z`, and the Haar norms of the truncated periodic factors on the
annihilator torus of `z` against the true periodic factor of the role. -/
theorem role_transport (z : ChartTag) (hz : Ms.zc = z) (hδ : 0 < Ms.δc) (hQ : 0 < S.Q0)
    {U : ℤ × ℤ} (h : ℕ) (xs : ℝ) (F : Finset (Ms.alive U)) (α : Ms.alive U → ℂ)
    (n : Ms.alive U → Fin Ms.zc.dim → ℤ) (K Hn : ℕ) (thr : ℝ) :
    ∃ ρ' : Fin z.dim → ℝ, ∃ n' : Ms.alive U → Fin z.dim → ℤ,
      (∀ i, ∃ k, ρ' i = Ms.ρ k) ∧ (∀ x i, ∃ k, n' x i = n x k) ∧
      (∀ s y, (Real.fourierChar ((Ms.cl : ℝ) * centerPhase Ms.zc Ms.ρ y) : ℂ) *
          (Real.fourierChar (s * (y - xs)) : ℂ) *
          Ms.torusG S h xs F α n (fun i => Ms.torusξ S h i * (y - xs)) =
        ((centerCut z Ms.δc ρ' y : ℂ) *
          (Real.fourierChar ((Ms.cl : ℝ) * centerPhase z ρ' y) : ℂ)) *
        ((Real.fourierChar (s * (y - xs)) : ℂ) *
          ∑ x ∈ F, (α x * (Real.fourierChar (Ms.phase x.1 xs) : ℂ)) *
            torusCharacter (n' x) (torusMk fun i => z.θ i / (S.Q0 * (6 ^ h : ℕ)) * (y - xs)))) ∧
      ∀ cc0 : (Fin z.dim → ℤ) → ℂ,
        (∀ w, ‖cutoffP Ms.δc ρ' w - ∑ v ∈ frequencyBox z.dim (2 ^ (K + 1)),
          cc0 v * (Real.fourierChar (∑ i, (v i : ℝ) * w i) : ℂ)‖ ≤ cutTail z.dim Ms.δc K) →
        (eLpNorm (fun u : torusAnnihilator (rationalIntegerIntersection
            (tinySpan (fun i => z.θ i / S.Q0) Hn thr)) =>
          ∑ p ∈ frequencyBox z.dim (2 ^ (K + 1)) ×ˢ F,
            (cc0 p.1 * (Real.fourierChar (∑ i, (p.1 i : ℝ) * (z.θ i * xs)) : ℂ) *
              (α p.2 * (Real.fourierChar (Ms.phase p.2.1 xs) : ℂ))) *
            torusCharacter (((S.Q0 * 6 ^ h : ℕ) : ℤ) • p.1 + n' p.2) u.1) 2
          (torusAnnihilatorHaar (rationalIntegerIntersection
            (tinySpan (fun i => z.θ i / S.Q0) Hn thr)))).toReal ≤
        (eLpNorm (fun u : torusAnnihilator (rationalIntegerIntersection
            (tinySpan (fun i => Ms.zc.θ i / S.Q0) Hn thr)) =>
          Ms.torusGT S h xs F α n u.1) 2
          (torusAnnihilatorHaar (rationalIntegerIntersection
            (tinySpan (fun i => Ms.zc.θ i / S.Q0) Hn thr)))).toReal +
          cutTail z.dim Ms.δc K * ∑ x ∈ F, ‖α x‖ := by
  subst hz
  exact ⟨Ms.ρ, n, fun i => ⟨i, rfl⟩, fun x i => ⟨i, rfl⟩,
    fun s y => Ms.torusG_line_eq S h xs F α n hQ s y,
    fun cc0 hccT => Ms.trunc_eLpNorm_le_torusGT S hδ h xs F α n K cc0
      (cutTail_nonneg _ hδ K) hccT _⟩

end ModeSystem

/-- A role input on the closed cell `[a₀, a₀ + r]`: the selected sum `Q` on the half-open cell,
patched at the right endpoint by its torus approximation `P` (the local form only sees the cell
a.e.). -/
theorem cell_input_patch {a₀ r : ℝ} (Q P : ℝ → ℂ) (hQ : Measurable Q) {η M : ℝ} (hη : 0 ≤ η)
    (happ : ∀ y ∈ Set.Ico a₀ (a₀ + r), ‖Q y - P y‖ ≤ η) (hQb : ∀ y, ‖Q y‖ ≤ M)
    (hPb : ‖P (a₀ + r)‖ ≤ M) :
    ∃ f : ℝ → ℂ, Measurable f ∧ (∀ y ∈ Set.Icc a₀ (a₀ + r), ‖f y - P y‖ ≤ η) ∧
      (∀ y ∈ Set.Icc a₀ (a₀ + r), ‖f y‖ ≤ M) ∧
      (Set.Ico a₀ (a₀ + r)).indicator f = (Set.Ico a₀ (a₀ + r)).indicator Q := by
  classical
  refine ⟨fun y => if y = a₀ + r then P (a₀ + r) else Q y,
    Measurable.ite (measurableSet_singleton _) measurable_const hQ, fun y hy => ?_,
    fun y hy => ?_, ?_⟩
  · by_cases hyr : y = a₀ + r
    · subst hyr; simp only [↓reduceIte, sub_self, norm_zero]; exact hη
    · simp only [hyr, ↓reduceIte]; exact happ y ⟨hy.1, lt_of_le_of_ne hy.2 hyr⟩
  · by_cases hyr : y = a₀ + r
    · subst hyr; simp only [↓reduceIte]; exact hPb
    · simp only [hyr, ↓reduceIte]; exact hQb y
  · funext y
    by_cases hy : y ∈ Set.Ico a₀ (a₀ + r)
    · have hyr : y ≠ a₀ + r := ne_of_lt hy.2
      simp only [Set.indicator_of_mem hy, hyr, ↓reduceIte]
    · simp only [Set.indicator_of_notMem hy]

/-- The full Fourier norm bound of the gauge multiplier of `eq:gauge-cancel`. -/
noncomputable def multNorm (d : ℕ) (δ : ℝ) (Q0 : ℕ) (Cm : ℝ) : ℝ :=
  5 ^ (d + d) * 1 + 2 * ((7 : ℝ) ^ (d + d) * (3 ^ (4 * d) *
    (4 * (4 * Q0 * (d * profR δ (d + d + 1))) +
      2 * Real.pi * (8 * ((d : ℝ) * ((d : ℝ) * (Cm * 18 * (4 * Q0)))))) ^ (d + d + 1)) *
      Real.sqrt (d + d : ℕ) ^ (d + d + 1))

/-- `gaugeMult_truncate` in every dimension (including the zero-dimensional chart), with the full
absolute coefficient bound `multNorm` (blueprint line 2476: "absolute Fourier costs ... are fixed
powers of `D_*`"). -/
theorem gaugeMult_truncate_all {d : ℕ} {δ : ℝ} (hδ : 0 < δ) (Q0 : ℕ) (l' : Fin 4)
    (C : Matrix (Fin d) (Fin d) ℚ) (ρ : Fin 4 → Fin d → ℝ)
    (hρ : ∀ j a, ρ j a ∈ Set.Icc (0 : ℝ) 1) (hQ : ∀ a b, ∃ z : ℤ, (Q0 : ℝ) * (C a b : ℝ) = z)
    {Cm : ℝ} (hCm0 : 0 ≤ Cm) (hCm : ∀ a b, |(C a b : ℝ)| ≤ Cm) (K : ℕ) :
    ∃ c : (Fin (d + d) → ℤ) → ℂ, (∀ v, ‖c v‖ ≤ 1) ∧
      (∀ s : Finset (Fin (d + d) → ℤ), ∑ v ∈ s, ‖c v‖ ≤ multNorm d δ Q0 Cm) ∧ ∀ w,
      ‖gaugeMult δ Q0 l' C ρ w - ∑ v ∈ frequencyBox (d + d) (2 ^ (K + 1)),
        c v * (Real.fourierChar (∑ i, (v i : ℝ) * w i) : ℂ)‖ ≤ multTail d δ Q0 Cm K := by
  have hT0 : ∀ d' : ℕ, 0 ≤ multTail d' δ Q0 Cm K := fun d' => by
    unfold multTail; have := profR_nonneg hδ (d' + d' + 1); positivity
  rcases Nat.eq_zero_or_pos d with rfl | hd
  · have : IsEmpty (Fin (0 + 0)) := inferInstanceAs (IsEmpty (Fin 0))
    refine ⟨fun _ => gaugeMult δ Q0 l' C ρ 0, fun _ => gaugeMult_norm_le δ Q0 l' C ρ 0,
      fun s => ?_, fun w => ?_⟩
    · calc ∑ v ∈ s, ‖gaugeMult δ Q0 l' C ρ 0‖ ≤ ∑ v ∈ s, (1 : ℝ) :=
            Finset.sum_le_sum fun _ _ => gaugeMult_norm_le δ Q0 l' C ρ 0
        _ = s.card := by simp
        _ ≤ 1 := by exact_mod_cast Finset.card_le_one_of_subsingleton s
        _ = multNorm 0 δ Q0 Cm := by simp [multNorm]
    · have e : ∀ v : Fin (0 + 0) → ℤ, gaugeMult δ Q0 l' C ρ 0 *
          (Real.fourierChar (∑ i, (v i : ℝ) * w i) : ℂ) = gaugeMult δ Q0 l' C ρ w := fun v => by
        rw [Subsingleton.elim w 0]; simp
      simp_rw [e]
      rw [Finset.sum_const, card_frequencyBox, pow_zero, one_smul, sub_self, norm_zero]
      exact hT0 0
  · have h := periodic_truncate_full (d := d + d) (by omega) (gaugeMult δ Q0 l' C ρ)
      (gaugeMult_contDiff hδ Q0 l' C ρ) (gaugeMult_periodic δ Q0 l' C ρ hQ)
      (A := 3 ^ (4 * d) * (4 * (4 * Q0 * (d * profR δ (d + d + 1))) +
          2 * Real.pi * (8 * ((d : ℝ) * ((d : ℝ) * (Cm * 18 * (4 * Q0)))))) ^ (d + d + 1))
      (by have := profR_nonneg hδ (d + d + 1); positivity)
      (fun x => gaugeMult_deriv_le hδ Q0 l' C ρ hρ hCm0 hCm (d + d + 1) x)
      (gaugeMult_norm_le δ Q0 l' C ρ) K
    refine ⟨_, h.1, fun s => (h.2.1 s).trans (le_of_eq ?_), fun w => (h.2.2 w).trans (le_of_eq ?_)⟩
    · unfold multNorm; ring
    · unfold multTail; ring

open Classical in
/-- The absolute coefficient sum of the four-core expansion factors: the multiplier sum times the
products of the truncated cutoff sums and the mode coefficient sums. -/
theorem expansion_coeff_sum {d : ℕ} {ι : Fin 4 → Type*} (B : ℕ) (F : ∀ j, Finset (ι j))
    (cm : (Fin (d + d) → ℤ) → ℂ) (cc : Fin 4 → (Fin d → ℤ) → ℂ) (c : ∀ j, ι j → ℂ) :
    ∑ x ∈ frequencyBox (d + d) B ×ˢ Fintype.piFinset (fun j => frequencyBox d B ×ˢ F j),
        ‖cm x.1 * ∏ j, (cc j (x.2 j).1 * c j (x.2 j).2)‖ =
      (∑ v ∈ frequencyBox (d + d) B, ‖cm v‖) *
        ∏ j, ((∑ v ∈ frequencyBox d B, ‖cc j v‖) * ∑ k ∈ F j, ‖c j k‖) := by
  rw [Finset.sum_product, Finset.sum_mul]
  refine Finset.sum_congr rfl fun v _ => ?_
  simp_rw [norm_mul, norm_prod, norm_mul]
  rw [← Finset.mul_sum]
  congr 1
  have e : ∀ j, (∑ v ∈ frequencyBox d B, ‖cc j v‖) * ∑ k ∈ F j, ‖c j k‖ =
      ∑ p ∈ frequencyBox d B ×ˢ F j, ‖cc j p.1‖ * ‖c j p.2‖ := fun j => by
    rw [Finset.sum_product, Finset.sum_mul_sum]
  simp_rw [e]
  rw [Finset.prod_univ_sum]

open Classical in
/-- Blueprint lines 2523-2526 (the coset hypotheses of the four-core test from the gap): if every
integer frequency of size at most `16 B` is tiny (`≤ ε₁`) in `K_B` and huge (`≥ H`) outside, the
multiplier, cutoff and shift indices are at most `B` and the reference is at most `B`, then the
expansion frequencies of the four-core test satisfy the near/far hypotheses of
`four_core_principal_of` around the reference. -/
theorem expansion_near_far {d : ℕ} (V : Submodule ℚ (Fin d → ℚ)) (ξ : Fin d → ℝ) {r ε₁ H B : ℝ}
    (hB : 0 ≤ B)
    (hdich : ∀ k : Fin d → ℤ, (∀ i, |(k i : ℝ)| ≤ 16 * B) →
      (k ∈ rationalIntegerIntersection V → r * |∑ i, (k i : ℝ) * ξ i| ≤ ε₁) ∧
      (k ∉ rationalIntegerIntersection V → H ≤ r * |∑ i, (k i : ℝ) * ξ i|))
    {ι : Fin 4 → Type*} (L QL Kt : ℕ) (F : ∀ j, Finset (ι j)) (n : ∀ j, ι j → Fin d → ℤ)
    (hLb : ∀ v ∈ frequencyBox (d + d) (2 ^ (Kt + 1)), ∀ i, |(L : ℝ) * (v i : ℝ)| ≤ B)
    (hQLb : ∀ v ∈ frequencyBox d (2 ^ (Kt + 1)), ∀ i, |(QL : ℝ) * (v i : ℝ)| ≤ B)
    (hn : ∀ j, ∀ k ∈ F j, ∀ i, |(n j k i : ℝ)| ≤ B)
    (p₀ : (Fin d → ℤ) × (Fin d → ℤ)) (hp₁ : ∀ i, |(p₀.1 i : ℝ)| ≤ B)
    (hp₂ : ∀ i, |(p₀.2 i : ℝ)| ≤ B) (cA cB : ℝ) :
    (∀ x ∈ frequencyBox (d + d) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
        (fun j => frequencyBox d (2 ^ (Kt + 1)) ×ˢ F j),
      (expP1 L QL n x - p₀.1 ∈ rationalIntegerIntersection V ∧
        expP2 L QL n x - p₀.2 ∈ rationalIntegerIntersection V) →
      r * |(cA + ∑ i, (expP1 L QL n x i : ℝ) * ξ i) - (cA + ∑ i, (p₀.1 i : ℝ) * ξ i)| ≤ ε₁ ∧
      r * |(cB + ∑ i, (expP2 L QL n x i : ℝ) * ξ i) - (cB + ∑ i, (p₀.2 i : ℝ) * ξ i)| ≤ ε₁) ∧
    (∀ x ∈ frequencyBox (d + d) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
        (fun j => frequencyBox d (2 ^ (Kt + 1)) ×ˢ F j),
      ¬ (expP1 L QL n x - p₀.1 ∈ rationalIntegerIntersection V ∧
        expP2 L QL n x - p₀.2 ∈ rationalIntegerIntersection V) →
      H ≤ r * |(cA + ∑ i, (expP1 L QL n x i : ℝ) * ξ i) - (cA + ∑ i, (p₀.1 i : ℝ) * ξ i)| ∨
      H ≤ r * |(cB + ∑ i, (expP2 L QL n x i : ℝ) * ξ i) - (cB + ∑ i, (p₀.2 i : ℝ) * ξ i)|) := by
  have hdiff : ∀ (c : ℝ) (P p : Fin d → ℤ),
      (c + ∑ i, (P i : ℝ) * ξ i) - (c + ∑ i, (p i : ℝ) * ξ i) = ∑ i, ((P - p) i : ℝ) * ξ i :=
    fun c P p => by
      simp only [Pi.sub_apply, Int.cast_sub, sub_mul, Finset.sum_sub_distrib]
      ring
  -- the sizes of the expansion frequencies
  have hrole : ∀ x ∈ frequencyBox (d + d) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
      (fun j => frequencyBox d (2 ^ (Kt + 1)) ×ˢ F j), ∀ j i,
      |((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ)| ≤ 2 * B := by
    intro x hx j i
    have hxj := Fintype.mem_piFinset.mp (Finset.mem_product.mp hx).2 j
    obtain ⟨hv, hk⟩ := Finset.mem_product.mp hxj
    have e : ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ) =
        (QL : ℝ) * ((x.2 j).1 i : ℝ) + (n j (x.2 j).2 i : ℝ) := by
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]; push_cast; ring
    rw [e]
    refine (abs_add_le _ _).trans ?_
    linarith [hQLb _ hv i, hn j _ hk i]
  have hP1 : ∀ x ∈ frequencyBox (d + d) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
      (fun j => frequencyBox d (2 ^ (Kt + 1)) ×ˢ F j), ∀ i,
      |((expP1 L QL n x - p₀.1) i : ℝ)| ≤ 16 * B := by
    intro x hx i
    have hv := (Finset.mem_product.mp hx).1
    have e : (((expP1 L QL n x - p₀.1) i : ℤ) : ℝ) = (L : ℝ) * (x.1 (Fin.castAdd d i) : ℝ) +
        ∑ j, ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ) - (p₀.1 i : ℝ) := by
      simp only [expP1, Pi.sub_apply, Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
      push_cast; ring
    rw [e]
    have h1 := hLb _ hv (Fin.castAdd d i)
    have h2 : |∑ j, ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ)| ≤ 4 * (2 * B) := by
      refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      calc _ ≤ ∑ _j : Fin 4, 2 * B := Finset.sum_le_sum fun j _ => hrole x hx j i
        _ = 4 * (2 * B) := by simp
    have h3 := hp₁ i
    have h4 := abs_sub ((L : ℝ) * (x.1 (Fin.castAdd d i) : ℝ) +
      ∑ j, ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ)) (p₀.1 i : ℝ)
    have h5 := abs_add_le ((L : ℝ) * (x.1 (Fin.castAdd d i) : ℝ))
      (∑ j, ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ))
    linarith
  have hP2 : ∀ x ∈ frequencyBox (d + d) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
      (fun j => frequencyBox d (2 ^ (Kt + 1)) ×ˢ F j), ∀ i,
      |((expP2 L QL n x - p₀.2) i : ℝ)| ≤ 16 * B := by
    intro x hx i
    have hv := (Finset.mem_product.mp hx).1
    have e : (((expP2 L QL n x - p₀.2) i : ℤ) : ℝ) = (L : ℝ) * (x.1 (Fin.natAdd d i) : ℝ) +
        ∑ j : Fin 4, ((j : ℕ) : ℝ) * ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ) -
          (p₀.2 i : ℝ) := by
      simp only [expP2, Pi.sub_apply, Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
        sub_zero]
      push_cast; ring
    rw [e]
    have h1 := hLb _ hv (Fin.natAdd d i)
    have h2 : |∑ j : Fin 4, ((j : ℕ) : ℝ) * ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ)|
        ≤ 12 * B := by
      refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      calc ∑ j : Fin 4, |((j : ℕ) : ℝ) * ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ)|
          ≤ ∑ j : Fin 4, ((j : ℕ) : ℝ) * (2 * B) := Finset.sum_le_sum fun j _ => by
            rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
            exact mul_le_mul_of_nonneg_left (hrole x hx j i) (Nat.cast_nonneg _)
        _ = 12 * B := by simp [Fin.sum_univ_four]; ring
    have h3 := hp₂ i
    have h4 := abs_sub ((L : ℝ) * (x.1 (Fin.natAdd d i) : ℝ) +
      ∑ j : Fin 4, ((j : ℕ) : ℝ) * ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ))
      (p₀.2 i : ℝ)
    have h5 := abs_add_le ((L : ℝ) * (x.1 (Fin.natAdd d i) : ℝ))
      (∑ j : Fin 4, ((j : ℕ) : ℝ) * ((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ))
    linarith
  refine ⟨fun x hx hm => ?_, fun x hx hm => ?_⟩
  · rw [hdiff, hdiff]
    exact ⟨(hdich _ (hP1 x hx)).1 hm.1, (hdich _ (hP2 x hx)).1 hm.2⟩
  · rw [hdiff, hdiff]
    by_cases h1 : expP1 L QL n x - p₀.1 ∈ rationalIntegerIntersection V
    · right
      exact (hdich _ (hP2 x hx)).2 fun h2 => hm ⟨h1, h2⟩
    · left
      exact (hdich _ (hP1 x hx)).2 h1

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)

open Classical in
/-- One core role of a four-core tuple on a cell `[a₀, a₀ + r)` in a common chart `z = Ms.zc`
(blueprint lines 2466-2476): from the torus form of the selected modes (`core_torus_form`), the
role input on the closed cell (patched at the right end, `cell_input_patch`) satisfies the
hypotheses of `four_core_principal_of` with offsets `ρ'`, shifts `n'` and coefficients
`α_m e(φ_m(x*))`, and the truncated periodic factors in the chart `z` have Haar norms at most
that of the true periodic factor of the role plus the truncation tail (`role_transport`). -/
theorem role_four_input (z : ChartTag) (hz : Ms.zc = z) (hδ : 0 < Ms.δc) (hQ : 0 < S.Q0)
    {U : ℤ × ℤ} (h : ℕ) (xs : ℝ) (F : Finset (Ms.alive U)) (α : Ms.alive U → ℂ)
    (n : Ms.alive U → Fin Ms.zc.dim → ℤ) (K Hn : ℕ) (thr : ℝ) {a₀ r η : ℝ} (hη : 0 ≤ η)
    (s : ℝ)
    (hform : ∀ y ∈ Set.Ico a₀ (a₀ + r),
      ‖∑ x ∈ F, α x * Ms.wave x.1 y -
        (Real.fourierChar ((Ms.cl : ℝ) * centerPhase Ms.zc Ms.ρ y) : ℂ) *
          (Real.fourierChar (s * (y - xs)) : ℂ) *
          Ms.torusG S h xs F α n (fun i => Ms.torusξ S h i * (y - xs))‖ ≤
        η * ∑ x ∈ F, ‖α x‖) :
    ∃ ρ' : Fin z.dim → ℝ, ∃ n' : Ms.alive U → Fin z.dim → ℤ, ∃ f : ℝ → ℂ,
      (∀ i, ∃ k, ρ' i = Ms.ρ k) ∧ (∀ x i, ∃ k, n' x i = n x k) ∧ Measurable f ∧
      (∀ y ∈ Set.Icc a₀ (a₀ + r), ‖f y - ((centerCut z Ms.δc ρ' y : ℂ) *
        (Real.fourierChar ((Ms.cl : ℝ) * centerPhase z ρ' y) : ℂ)) *
          ((Real.fourierChar (s * (y - xs)) : ℂ) *
            ∑ x ∈ F, (α x * (Real.fourierChar (Ms.phase x.1 xs) : ℂ)) *
              torusCharacter (n' x) (torusMk fun i => z.θ i / (S.Q0 * (6 ^ h : ℕ)) * (y - xs)))‖ ≤
        η * ∑ x ∈ F, ‖α x * (Real.fourierChar (Ms.phase x.1 xs) : ℂ)‖) ∧
      (∀ y ∈ Set.Icc a₀ (a₀ + r),
        ‖f y‖ ≤ ∑ x ∈ F, ‖α x * (Real.fourierChar (Ms.phase x.1 xs) : ℂ)‖) ∧
      (Set.Ico a₀ (a₀ + r)).indicator f =
        (Set.Ico a₀ (a₀ + r)).indicator (fun y => ∑ x ∈ F, α x * Ms.wave x.1 y) ∧
      ∀ cc0 : (Fin z.dim → ℤ) → ℂ,
        (∀ w, ‖cutoffP Ms.δc ρ' w - ∑ v ∈ frequencyBox z.dim (2 ^ (K + 1)),
          cc0 v * (Real.fourierChar (∑ i, (v i : ℝ) * w i) : ℂ)‖ ≤ cutTail z.dim Ms.δc K) →
        (eLpNorm (fun u : torusAnnihilator (rationalIntegerIntersection
            (tinySpan (fun i => z.θ i / S.Q0) Hn thr)) =>
          ∑ p ∈ frequencyBox z.dim (2 ^ (K + 1)) ×ˢ F,
            (cc0 p.1 * (Real.fourierChar (∑ i, (p.1 i : ℝ) * (z.θ i * xs)) : ℂ) *
              (α p.2 * (Real.fourierChar (Ms.phase p.2.1 xs) : ℂ))) *
            torusCharacter (((S.Q0 * 6 ^ h : ℕ) : ℤ) • p.1 + n' p.2) u.1) 2
          (torusAnnihilatorHaar (rationalIntegerIntersection
            (tinySpan (fun i => z.θ i / S.Q0) Hn thr)))).toReal ≤
        (eLpNorm (fun u : torusAnnihilator (rationalIntegerIntersection
            (tinySpan (fun i => Ms.zc.θ i / S.Q0) Hn thr)) =>
          Ms.torusGT S h xs F α n u.1) 2
          (torusAnnihilatorHaar (rationalIntegerIntersection
            (tinySpan (fun i => Ms.zc.θ i / S.Q0) Hn thr)))).toReal +
          cutTail z.dim Ms.δc K * ∑ x ∈ F, ‖α x‖ := by
  obtain ⟨ρ', n', hρ', hn', hline, hnorm⟩ := Ms.role_transport S z hz hδ hQ h xs F α n K Hn thr
  have hnα : ∀ x : Ms.alive U, ‖α x * (Real.fourierChar (Ms.phase x.1 xs) : ℂ)‖ = ‖α x‖ :=
    fun x => by rw [norm_mul, Circle.norm_coe, mul_one]
  have hS0 : 0 ≤ ∑ x ∈ F, ‖α x‖ := Finset.sum_nonneg fun _ _ => norm_nonneg _
  have hPb : ∀ y, ‖((centerCut z Ms.δc ρ' y : ℂ) *
      (Real.fourierChar ((Ms.cl : ℝ) * centerPhase z ρ' y) : ℂ)) *
        ((Real.fourierChar (s * (y - xs)) : ℂ) *
          ∑ x ∈ F, (α x * (Real.fourierChar (Ms.phase x.1 xs) : ℂ)) *
            torusCharacter (n' x) (torusMk fun i => z.θ i / (S.Q0 * (6 ^ h : ℕ)) * (y - xs)))‖ ≤
      ∑ x ∈ F, ‖α x‖ := fun y => by
    have hc := centerCut_mem z Ms.δc ρ' y
    rw [norm_mul, norm_mul, norm_mul, Circle.norm_coe, Circle.norm_coe, mul_one, one_mul,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hc.1]
    refine (mul_le_of_le_one_left (norm_nonneg _) hc.2).trans ?_
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun x _ => ?_)
    rw [norm_mul, norm_torusCharacter, mul_one, hnα]
  obtain ⟨f, hfm, hfa, hfb, hind⟩ := cell_input_patch (a₀ := a₀) (r := r)
    (fun y => ∑ x ∈ F, α x * Ms.wave x.1 y) _
    (Finset.measurable_sum _ fun x _ => measurable_const.mul (Ms.wave_measurable x.1))
    (mul_nonneg hη hS0) (fun y hy => by
      have h1 := hform y hy
      rw [hline s y] at h1
      exact h1)
    (fun y => (norm_sum_le _ _).trans (Finset.sum_le_sum fun x _ => by
      rw [norm_mul]; exact mul_le_of_le_one_right (norm_nonneg _) (Ms.wave_norm_le x.1 y)))
    (hPb (a₀ + r))
  refine ⟨ρ', n', f, hρ', hn', hfm, fun y hy => ?_, fun y hy => ?_, hind, hnorm⟩
  · simp_rw [hnα]; exact hfa y hy
  · simp_rw [hnα]; exact hfb y hy

end ModeSystem

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

/-- At the chosen schedule `L_{h'} (U₀ + 1) ≤ T` for `h' ≤ J_*` (`T > H Ξ`, `H > L_{J_*}`,
`U₀ + 1 = D_*^{250} + 1 ≤ Ξ`): the far cosets of the four-core test are separated by more than
one from the reference (`H - U ≥ 1` in `fourK_reference`). -/
theorem Tt_ge_U0 {Cj CA CT CK : ℕ} {δs W : ℝ} (hV : D.S.Valid Cj CA CT CK δs W) (hCT : 4 ≤ CT)
    (hd2 : 2 ≤ D.S.dmax) (hD : 2 ≤ D.S.Dstar) (hB : 2 ≤ D.S.Bstar) (hQ : 1 ≤ D.S.Q0)
    (hSP : D.SP = D.S.sideParams δs) {h' : ℕ} (hh : h' ≤ D.SP.Jst) :
    ModeSchedule.Lh h' * (D.U0 + 1) ≤ D.SP.Tt := by
  have hTt : D.SP.Tt = D.S.T := by rw [hSP]; rfl
  have hJst : D.SP.Jst = D.S.Jstar := by rw [hSP]; rfl
  rw [hTt]
  have hT := hV.H_mul_Ξ_lt_T (by omega) hd2 hD hB hQ
  have hH := hV.H_ge hd2 hD hB hQ
  have hA := hV.one_le_A0 hd2 hD hB
  have hE : 1 ≤ D.S.Eh D.S.Jstar := one_le_pow₀ hA
  have hLJ : (1 : ℝ) ≤ ModeSchedule.Lh D.S.Jstar := one_le_pow₀ (by norm_num)
  have hL : ModeSchedule.Lh h' ≤ ModeSchedule.Lh D.S.Jstar :=
    pow_le_pow_right₀ (by norm_num) (by rw [← hJst]; exact hh)
  have hL0 : 0 < ModeSchedule.Lh h' := pow_pos (by norm_num) _
  have hD1 : (1 : ℝ) ≤ D.S.Dstar := by linarith
  have hLH : ModeSchedule.Lh D.S.Jstar ≤ D.S.H := by
    have hEL : ModeSchedule.Lh D.S.Jstar ≤ D.S.Eh D.S.Jstar * ModeSchedule.Lh D.S.Jstar :=
      le_mul_of_one_le_left (by linarith) hE
    have h1 : ModeSchedule.Lh D.S.Jstar ≤ (D.S.Eh D.S.Jstar * ModeSchedule.Lh D.S.Jstar) ^ 2 :=
      hEL.trans (le_self_pow₀ (le_trans hLJ hEL) (by norm_num))
    have h2 : 0 ≤ (D.S.Eh D.S.Jstar * ModeSchedule.Lh D.S.Jstar) ^ 2 := sq_nonneg _
    have hD4 : (1 : ℝ) ≤ 27 * D.S.Dstar ^ 4 := by
      have : (1 : ℝ) ≤ D.S.Dstar ^ 4 := one_le_pow₀ hD1
      linarith
    have h3 := mul_le_mul_of_nonneg_right hD4 h2
    linarith
  have hΞ : D.U0 + 1 ≤ D.S.Ξ := by
    unfold U0 ModeSchedule.Ξ
    have h1 : (1 : ℝ) ≤ D.S.Dstar ^ 250 := one_le_pow₀ hD1
    have h2 : D.S.Dstar ^ 251 ≤ D.S.Dstar ^ 1000 := pow_le_pow_right₀ hD1 (by norm_num)
    rw [pow_succ] at h2
    nlinarith only [hD, h1, h2]
  have hU0 : 0 ≤ D.U0 + 1 := by unfold U0; positivity
  calc ModeSchedule.Lh h' * (D.U0 + 1) ≤ D.S.H * D.S.Ξ :=
        mul_le_mul (hL.trans hLH) hΞ hU0 (by linarith)
    _ ≤ D.S.T := hT.le

end SideInput

end ActiveSetup.BasicFamilies.FamParams

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}

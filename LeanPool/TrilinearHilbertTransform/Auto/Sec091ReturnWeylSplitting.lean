namespace TrilinearHT.Auto
open Filter MeasureTheory
open scoped Topology ENNReal

instance euclideanDualLattice_span_discrete {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) :
    DiscreteTopology (euclideanDualLattice (Submodule.span ℤ (Set.range b))) := by
  rw [euclideanDualLattice_span]
  infer_instance

instance euclideanDualLattice_span_isZLattice {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) :
    IsZLattice ℝ (euclideanDualLattice (Submodule.span ℤ (Set.range b))) := by
  constructor
  simpa only [euclideanDualLattice_span] using
    (IsZLattice.span_top (K := ℝ) (L := Submodule.span ℤ (Set.range (euclideanDualBasis b))))

open scoped Pointwise

/-- Basis-free version of attainment for every full lattice. -/
theorem successiveMinimum_attained_fullLattice {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) (L : Submodule ℤ E) [DiscreteTopology L]
    [IsZLattice ℝ L] {j : ℕ} (hj : 0 < j) (hjn : j ≤ Module.finrank ℝ E) :
    0 < successiveMinimum K L j ∧ ∃ w : Fin j → E,
      IndependentLatticeTuple L w ∧ ∀ i, w i ∈ successiveMinimum K L j • K := by
  let := ZLattice.module_finite ℝ L
  let := ZLattice.module_free ℝ L
  let b := (Module.finBasis ℤ L).ofZLatticeBasis ℝ L
  have hjb : j ≤ Module.finrank ℤ L := by rwa [ZLattice.rank ℝ L]
  have h := successiveMinimum_attained hK b hj hjb
  simpa only [b, Module.Basis.ofZLatticeBasis_span] using h

/-- Coordinate cube with every Euclidean coordinate between minus one and one. -/
def euclideanCoordinateCube (d : ℕ) : Set (EuclideanSpace ℝ (Fin d)) :=
  WithLp.toLp 2 '' Set.Icc (fun _ : Fin d => (-1 : ℝ)) (fun _ => 1)

theorem mem_euclideanCoordinateCube {d : ℕ} (x : EuclideanSpace ℝ (Fin d)) :
    x ∈ euclideanCoordinateCube d ↔ ∀ i, |x i| ≤ 1 := by
  constructor
  · rintro ⟨v, hv, rfl⟩ i
    exact abs_le.mpr ⟨hv.1 i, hv.2 i⟩
  · intro hx
    exact ⟨x.ofLp, ⟨fun i => (abs_le.mp (hx i)).1, fun i => (abs_le.mp (hx i)).2⟩, rfl⟩

theorem euclideanCoordinateCube_compact (d : ℕ) :
    IsCompact (euclideanCoordinateCube d) :=
  isCompact_Icc.image (PiLp.continuous_toLp 2 (fun _ : Fin d => ℝ))

theorem euclideanCoordinateCube_convex (d : ℕ) :
    Convex ℝ (euclideanCoordinateCube d) :=
  (convex_Icc (fun _ : Fin d => (-1 : ℝ)) (fun _ => 1)).linear_image
    (WithLp.linearEquiv 2 ℝ (Fin d → ℝ)).symm.toLinearMap

theorem euclideanCoordinateCube_zero (d : ℕ) : 0 ∈ euclideanCoordinateCube d := by
  rw [mem_euclideanCoordinateCube]
  simp

theorem euclideanCoordinateCube_neg {d : ℕ} {x : EuclideanSpace ℝ (Fin d)}
    (hx : x ∈ euclideanCoordinateCube d) : -x ∈ euclideanCoordinateCube d := by
  rw [mem_euclideanCoordinateCube] at hx ⊢
  simpa only [PiLp.neg_apply, abs_neg] using hx

theorem euclideanCoordinateCube_zero_interior (d : ℕ) :
    (0 : EuclideanSpace ℝ (Fin d)) ∈ interior (euclideanCoordinateCube d) := by
  have hs : Metric.ball (0 : EuclideanSpace ℝ (Fin d)) 1 ⊆ euclideanCoordinateCube d := by
    intro x hx
    rw [mem_euclideanCoordinateCube]
    intro i
    have hxi := PiLp.norm_apply_le x i
    have hn : ‖x‖ < 1 := by simpa only [Metric.mem_ball, dist_zero_right] using hx
    simpa only [Real.norm_eq_abs] using hxi.trans hn.le
  exact mem_interior_iff_mem_nhds.mpr
    (Filter.mem_of_superset (Metric.ball_mem_nhds 0 (by norm_num : (0 : ℝ) < 1)) hs)

/-- Minkowski sum of the scaled image cube and the ambient coordinate cube. -/
noncomputable def shortReturnBody {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d)) (P : ℝ) :
    Set (EuclideanSpace ℝ (Fin d)) :=
  ((P⁻¹ • V) '' euclideanCoordinateCube k) + euclideanCoordinateCube d

theorem shortReturnBody_cube_subset {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d)) (P : ℝ) :
    euclideanCoordinateCube d ⊆ shortReturnBody V P := by
  intro w hw
  exact ⟨0, ⟨0, euclideanCoordinateCube_zero k, map_zero _⟩, w, hw, zero_add _⟩

/-- Blueprint lem:return-splitting, lines 1271-1275: the sum of the image
of the coordinate cube and the ambient coordinate cube is a symmetric
compact convex body with the origin in its interior. -/
theorem shortReturnBody_symmetricConvexBody {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d)) (P : ℝ) :
    IsSymmetricConvexBody (shortReturnBody V P) where
  compact := ((euclideanCoordinateCube_compact k).image (P⁻¹ • V).continuous).add
    (euclideanCoordinateCube_compact d)
  convex := ((euclideanCoordinateCube_convex k).linear_image
    (P⁻¹ • V).toLinearMap).add (euclideanCoordinateCube_convex d)
  neg_mem := by
    rintro z ⟨x, ⟨h, hh, rfl⟩, w, hw, rfl⟩
    refine ⟨(P⁻¹ • V) (-h), ⟨-h, euclideanCoordinateCube_neg hh, rfl⟩,
      -w, euclideanCoordinateCube_neg hw, ?_⟩
    simp [add_comm]
  interior_nonempty := ⟨0, interior_mono (shortReturnBody_cube_subset V P)
    (euclideanCoordinateCube_zero_interior d)⟩

theorem mem_shortReturnBody {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d)) (P : ℝ)
    (x : EuclideanSpace ℝ (Fin d)) :
    x ∈ shortReturnBody V P ↔
      ∃ (h : EuclideanSpace ℝ (Fin k)) (w : EuclideanSpace ℝ (Fin d)),
        (∀ j, |h j| ≤ 1) ∧ (∀ i, |w i| ≤ 1) ∧ P⁻¹ • V h + w = x := by
  constructor
  · rintro ⟨z, ⟨h, hh, rfl⟩, w, hw, he⟩
    exact ⟨h, w, (mem_euclideanCoordinateCube h).mp hh,
      (mem_euclideanCoordinateCube w).mp hw, he⟩
  · rintro ⟨h, w, hh, hw, he⟩
    exact ⟨(P⁻¹ • V) h, ⟨h, (mem_euclideanCoordinateCube h).mpr hh, rfl⟩,
      w, (mem_euclideanCoordinateCube w).mpr hw, he⟩

theorem finite_list_interval_gap {d : ℕ} (x : Fin d → ℝ) (b : ℕ → ℝ)
    (hb : Antitone b) :
    ∃ j : Fin (d + 1), ∀ i, x i ∉ Set.Ioc (b (j.val + 1)) (b j.val) := by
  classical
  by_contra hn
  push Not at hn
  choose f hf using hn
  have hcard : Fintype.card (Fin d) < Fintype.card (Fin (d + 1)) := by simp
  obtain ⟨j, j', hne, he⟩ := Fintype.exists_ne_map_eq_of_card_lt f hcard
  have hsep (u v : Fin (d + 1)) (huv : u < v) (heq : f u = f v) : False := by
    have hv := (hf v).2
    have hu := (hf u).1
    have hle := hb (show u.val + 1 ≤ v.val by omega)
    rw [← heq] at hv
    linarith only [hv, hu, hle]
  rcases lt_or_gt_of_ne hne with hlt | hgt
  · exact hsep j j' hlt he
  · exact hsep j' j hgt he.symm

theorem geometric_interval_gap {d : ℕ} (x : Fin d → ℝ) {B L : ℝ}
    (hB : 0 < B) (hL : 1 < L) :
    ∃ b : ℝ, 0 < b ∧ b ≤ B ∧ b⁻¹ ≤ B⁻¹ * L ^ (d + 1) ∧
      ∀ i, x i ≤ b ∨ L * b < x i := by
  have hLp : 0 < L := lt_trans zero_lt_one hL
  have hanti : Antitone (fun j : ℕ => B / L ^ j) := by
    intro i j hij
    exact div_le_div_of_nonneg_left hB.le (pow_pos hLp i)
      (pow_le_pow_right₀ hL.le hij)
  obtain ⟨j, hj⟩ := finite_list_interval_gap x (fun j => B / L ^ j) hanti
  refine ⟨B / L ^ (j.val + 1), div_pos hB (pow_pos hLp _), ?_, ?_, ?_⟩
  · exact (div_le_self hB.le (one_le_pow₀ hL.le)).trans le_rfl
  · rw [inv_div]
    have hp : L ^ (j.val + 1) ≤ L ^ (d + 1) :=
      pow_le_pow_right₀ hL.le (by omega)
    have hh := mul_le_mul_of_nonneg_left hp (inv_nonneg.mpr hB.le)
    simpa only [div_eq_mul_inv, mul_comm] using hh
  · intro i
    have he : L * (B / L ^ (j.val + 1)) = B / L ^ j.val := by
      rw [pow_succ]
      field_simp
    have hn := hj i
    rw [Set.mem_Ioc, not_and_or, not_lt, not_le] at hn
    simpa only [he] using hn

/-- Blueprint lem:return-splitting, lines 1275-1279: one geometric interval
avoids all successive minima up to index d, with a controlled reciprocal scale. -/
theorem successiveMinimum_geometric_gap {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] (K : Set E) (Λ : Submodule ℤ E) (d : ℕ)
    {B L : ℝ} (hB : 0 < B) (hL : 1 < L) :
    ∃ b : ℝ, 0 < b ∧ b ≤ B ∧ b⁻¹ ≤ B⁻¹ * L ^ (d + 1) ∧
      ∀ j : ℕ, 0 < j → j ≤ d →
        successiveMinimum K Λ j ≤ b ∨ L * b < successiveMinimum K Λ j := by
  obtain ⟨b, hb, hbB, hrecip, hgap⟩ :=
    geometric_interval_gap (fun i : Fin d => successiveMinimum K Λ (i.val + 1)) hB hL
  refine ⟨b, hb, hbB, hrecip, ?_⟩
  intro j hj hjd
  have hh := hgap ⟨j - 1, by omega⟩
  simpa only [show j - 1 + 1 = j by omega] using hh

theorem mem_smul_shortReturnBody_representation {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (P : ℝ) {s : ℝ} (hs : 0 ≤ s) {x : EuclideanSpace ℝ (Fin d)}
    (hx : x ∈ s • shortReturnBody V P) :
    ∃ (h : EuclideanSpace ℝ (Fin k)) (w : EuclideanSpace ℝ (Fin d)),
      (∀ j, |h j| ≤ s) ∧ (∀ i, |w i| ≤ s) ∧ P⁻¹ • V h + w = x := by
  obtain ⟨y, hy, rfl⟩ := Set.mem_smul_set.mp hx
  obtain ⟨h, w, hh, hw, rfl⟩ := (mem_shortReturnBody V P y).mp hy
  refine ⟨s • h, s • w, ?_, ?_, ?_⟩
  · intro j
    simp only [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_nonneg hs]
    exact mul_le_of_le_one_right hs (hh j)
  · intro i
    simp only [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_nonneg hs]
    exact mul_le_of_le_one_right hs (hw i)
  · rw [map_smul, smul_add, smul_comm P⁻¹ s]

theorem euclidean_norm_le_coordinate_bound {d : ℕ} (x : EuclideanSpace ℝ (Fin d))
    {s : ℝ} (hx : ∀ i, |x i| ≤ s) : ‖x‖ ≤ (d : ℝ) * s := by
  calc
    ‖x‖ ≤ ∑ i, ‖x i‖ := euclidean_norm_le_sum_coordinates x
    _ ≤ ∑ _i : Fin d, s := Finset.sum_le_sum fun i _ => by simpa only [Real.norm_eq_abs] using hx i
    _ = _ := by simp

theorem scaled_shortReturnBody_gives_return {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    {P s : ℝ} (hP : 0 < P) (hs : 0 ≤ s) {x : EuclideanSpace ℝ (Fin d)}
    (hx : x ∈ s • shortReturnBody V P) :
    ∃ h : EuclideanSpace ℝ (Fin k),
      ‖h‖ + ‖V h - P • x‖ ≤ ((k : ℝ) + P * d) * s := by
  obtain ⟨h, w, hh, hw, he⟩ := mem_smul_shortReturnBody_representation V P hs hx
  have hd : V h - P • x = -(P • w) := by
    rw [← he, smul_add, smul_smul, mul_inv_cancel₀ hP.ne', one_smul]
    abel
  have hhn := euclidean_norm_le_coordinate_bound h hh
  have hwn := euclidean_norm_le_coordinate_bound w hw
  refine ⟨h, ?_⟩
  rw [hd, norm_neg, norm_smul, Real.norm_eq_abs, abs_of_pos hP]
  have hm := mul_le_mul_of_nonneg_left hwn hP.le
  nlinarith only [hhn, hm]

/-- Integer span of the standard Euclidean coordinate basis. -/
noncomputable def coordinateIntegerLattice (d : ℕ) : Submodule ℤ (EuclideanSpace ℝ (Fin d)) :=
  Submodule.span ℤ (Set.range (EuclideanSpace.basisFun (Fin d) ℝ).toBasis)

theorem mem_coordinateIntegerLattice {d : ℕ} (x : EuclideanSpace ℝ (Fin d)) :
    x ∈ coordinateIntegerLattice d ↔ ∀ i, ∃ n : ℤ, (n : ℝ) = x i := by
  simpa [coordinateIntegerLattice, OrthonormalBasis.coe_toBasis_repr_apply,
    EuclideanSpace.basisFun_repr, Set.mem_range] using
      (EuclideanSpace.basisFun (Fin d) ℝ).toBasis.mem_span_iff_repr_mem ℤ x

theorem coordinateIntegerLattice_coordinates {d : ℕ} {x : EuclideanSpace ℝ (Fin d)}
    (hx : x ∈ coordinateIntegerLattice d) :
    ∃ n : Fin d → ℤ, x = WithLp.toLp 2 (fun i => (n i : ℝ)) := by
  classical
  choose n hn using (mem_coordinateIntegerLattice x).mp hx
  refine ⟨n, ?_⟩
  ext i
  exact (hn i).symm

theorem bilinear_vanishes_on_span {E : Type*} [AddCommGroup E] [Module ℝ E]
    (B : E →ₗ[ℝ] E →ₗ[ℝ] ℝ) (S : Set E)
    (hB : ∀ x ∈ S, ∀ y ∈ S, B x y = 0) :
    ∀ x ∈ Submodule.span ℝ S, ∀ y ∈ Submodule.span ℝ S, B x y = 0 := by
  have hl (y : E) (hy : y ∈ S) : Submodule.span ℝ S ≤ LinearMap.ker (B.flip y) :=
    Submodule.span_le.mpr (fun x hx => hB x hx y hy)
  intro x hx
  have hr : Submodule.span ℝ S ≤ LinearMap.ker (B x) :=
    Submodule.span_le.mpr (fun y hy => hl y hy hx)
  exact fun y hy => hr hy

/-- Real span of integer lattice points inside the scaled short-return body. -/
noncomputable def shortReturnLatticeSpan {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d)) (P s : ℝ) :
    Submodule ℝ (EuclideanSpace ℝ (Fin d)) :=
  Submodule.span ℝ ((coordinateIntegerLattice d : Set (EuclideanSpace ℝ (Fin d))) ∩
    s • shortReturnBody V P)

theorem shortReturnLatticeSpan_isotropic_of_returns {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (B : EuclideanSpace ℝ (Fin d) →ₗ[ℝ] EuclideanSpace ℝ (Fin d) →ₗ[ℝ] ℝ)
    {P s r : ℝ} (hP : 0 < P) (hs : 0 ≤ s)
    (hscale : ((k : ℝ) + P * d) * s ≤ r)
    (hiso : ∀ (h h' : EuclideanSpace ℝ (Fin k)) (n n' : Fin d → ℤ),
      ‖h‖ + ‖V h - P • WithLp.toLp 2 (fun i => (n i : ℝ))‖ ≤ r →
      ‖h'‖ + ‖V h' - P • WithLp.toLp 2 (fun i => (n' i : ℝ))‖ ≤ r →
      B (P • WithLp.toLp 2 (fun i => (n i : ℝ)))
        (P • WithLp.toLp 2 (fun i => (n' i : ℝ))) = 0) :
    ∀ x ∈ shortReturnLatticeSpan V P s, ∀ y ∈ shortReturnLatticeSpan V P s,
      B x y = 0 := by
  apply bilinear_vanishes_on_span
  intro x hx y hy
  obtain ⟨h, hh⟩ := scaled_shortReturnBody_gives_return V hP hs hx.2
  obtain ⟨h', hh'⟩ := scaled_shortReturnBody_gives_return V hP hs hy.2
  obtain ⟨n, rfl⟩ := coordinateIntegerLattice_coordinates hx.1
  obtain ⟨n', rfl⟩ := coordinateIntegerLattice_coordinates hy.1
  have hb := hiso h h' n n' (hh.trans hscale) (hh'.trans hscale)
  simpa only [map_smul, LinearMap.smul_apply, smul_eq_mul, mul_eq_zero,
    hP.ne', false_or] using hb

theorem shortReturn_scale_bound (d k : ℕ) {P s r : ℝ} (hP : 1 ≤ P) (hs : 0 ≤ s)
    (hb : s ≤ r / (100 * P * (d + k + 1))) :
    ((k : ℝ) + P * d) * s ≤ r := by
  have hden : 0 < 100 * P * (d + k + 1 : ℝ) := by positivity
  have hm := (le_div_iff₀ hden).mp hb
  have hcoef : (k : ℝ) + P * d ≤ 100 * P * (d + k + 1) := by
    have hk := mul_nonneg (sub_nonneg.mpr hP) (Nat.cast_nonneg k)
    have hd := mul_nonneg (show 0 ≤ P by linarith) (Nat.cast_nonneg d)
    nlinarith only [hk, hd, hP]
  exact (mul_le_mul_of_nonneg_right hcoef hs).trans (by simpa only [mul_comm] using hm)

/-- Blueprint lem:return-splitting, lines 1279-1281: the real span of the
integer points in the chosen return body is isotropic for C-C^T. -/
theorem shortReturnLatticeSpan_isotropic {d k : ℕ}
    (C : Matrix (Fin d) (Fin d) ℝ) (V : Matrix (Fin d) (Fin k) ℝ)
    (Λ : Matrix (Fin k) (Fin k) ℝ) (hΛ : Λ.IsSymm)
    (P : ℤ) (hP : 1 ≤ P) (hC : ∀ i j, ∃ z : ℤ, (P : ℝ) * C i j = z)
    {a M s : ℝ} (ha : 0 < a) (hM : 0 ≤ M) (hs : 0 ≤ s)
    (hΩ : ∀ (h : Fin k → ℝ) (n : Fin d → ℤ),
      ‖WithLp.toLp 2 h‖ +
        ‖WithLp.toLp 2 (V.mulVec h - fun i => (P : ℝ) * n i)‖ ≤ a →
      ‖WithLp.toLp 2 ((2 • Λ + V.transpose * C * V).mulVec h -
        (V.transpose * (C - C.transpose)).mulVec (fun i => (P : ℝ) * n i))‖ ≤ M) :
    let r := min a
      (100 * (M + ‖(Matrix.toEuclideanLin (C - C.transpose)).toContinuousLinearMap‖ + 1))⁻¹
    s ≤ r / (100 * (P : ℝ) * (d + k + 1)) →
    ∀ x ∈ shortReturnLatticeSpan (Matrix.toEuclideanLin V).toContinuousLinearMap P s,
      ∀ y ∈ shortReturnLatticeSpan (Matrix.toEuclideanLin V).toContinuousLinearMap P s,
        dotProduct y.ofLp ((C - C.transpose).mulVec x.ofLp) = 0 := by
  intro r hsmall
  let W := (Matrix.toEuclideanLin V).toContinuousLinearMap
  let B := (innerₗ (EuclideanSpace ℝ (Fin d))).comp (Matrix.toEuclideanLin (C - C.transpose))
  have hPr : (1 : ℝ) ≤ P := by exact_mod_cast hP
  have hPpos : (0 : ℝ) < P := by linarith only [hPr]
  have hret := quadratic_short_returns_isotropic C V Λ hΛ P hC ha hM hΩ
  have hiso : ∀ x ∈ shortReturnLatticeSpan W P s,
      ∀ y ∈ shortReturnLatticeSpan W P s, B x y = 0 := by
    apply shortReturnLatticeSpan_isotropic_of_returns W B hPpos hs
      (shortReturn_scale_bound d k hPr hs hsmall)
    intro h h' n n' hh hh'
    have ht := hret h.ofLp h'.ofLp n n' hh hh'
    simp only [B, LinearMap.comp_apply, innerₗ_apply_apply,
      EuclideanSpace.inner_eq_star_dotProduct, star_trivial] at ⊢
    exact ht
  intro x hx y hy
  have ht := hiso x hx y hy
  simp only [B, LinearMap.comp_apply, innerₗ_apply_apply,
    EuclideanSpace.inner_eq_star_dotProduct, star_trivial] at ht
  exact ht

/-- Real span of lattice points in the dilation `b • K`. -/
noncomputable def latticeBodySpan {E : Type*} [AddCommGroup E] [Module ℝ E]
    (K : Set E) (L : Submodule ℤ E) (b : ℝ) : Submodule ℝ E :=
  Submodule.span ℝ ((L : Set E) ∩ b • K)

theorem latticeBodySpan_successiveMinimum_gt {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) (L : Submodule ℤ E) [DiscreteTopology L]
    [IsZLattice ℝ L] {b : ℝ} (hb : 0 < b)
    (hr : Module.finrank ℝ (latticeBodySpan K L b) < Module.finrank ℝ E) :
    b < successiveMinimum K L (Module.finrank ℝ (latticeBodySpan K L b) + 1) := by
  let U := latticeBodySpan K L b
  obtain ⟨hp, v, hv, hvmem⟩ := successiveMinimum_attained_fullLattice hK L
    (Nat.succ_pos (Module.finrank ℝ U)) (by dsimp [U]; omega)
  by_contra hn
  have hle := le_of_not_gt hn
  have hsub : Submodule.span ℝ (Set.range v) ≤ U := by
    apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    apply Submodule.subset_span
    refine ⟨hv.2 i, ?_⟩
    exact (symmetricConvexBody_gauge_le hK (v i) hb).mp
      (((symmetricConvexBody_gauge_le hK (v i) hp).mpr (hvmem i)).trans hle)
  have hd := Submodule.finrank_mono hsub
  have he : Module.finrank ℝ (Submodule.span ℝ (Set.range v)) =
      Module.finrank ℝ U + 1 := by
    simpa only [Fintype.card_fin] using finrank_span_eq_card hv.1
  omega

theorem latticeBodySpan_rank_gap {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) (L : Submodule ℤ E) [DiscreteTopology L]
    [IsZLattice ℝ L] {b A : ℝ} (hb : 0 < b)
    (hgap : ∀ j : ℕ, 0 < j → j ≤ Module.finrank ℝ E →
      successiveMinimum K L j ≤ b ∨ A * b < successiveMinimum K L j)
    (hr : Module.finrank ℝ (latticeBodySpan K L b) < Module.finrank ℝ E) :
    A * b < successiveMinimum K L (Module.finrank ℝ (latticeBodySpan K L b) + 1) := by
  have hgt := latticeBodySpan_successiveMinimum_gt hK L hb hr
  exact (hgap _ (by omega) (by omega)).resolve_left (not_le_of_gt hgt)

theorem short_dual_vector_mem_orthogonal {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] (K : Set E) (L : Submodule ℤ E) {b t : ℝ}
    (hb : 0 ≤ b) (ht : 0 ≤ t) (hbt : b * t < 1) {q : E}
    (hq : q ∈ euclideanDualLattice L) (hqt : q ∈ t • euclideanPolar K) :
    q ∈ (latticeBodySpan K L b)ᗮ := by
  apply ((latticeBodySpan K L b).mem_orthogonal' q).mpr
  have hker : latticeBodySpan K L b ≤ (innerₗ E q).ker := by
    apply Submodule.span_le.mpr
    rintro x ⟨hxL, hxb⟩
    obtain ⟨z, hz⟩ := (mem_euclideanDualLattice L q).mp hq x hxL
    have hbound := (inner_le_of_mem_dilate_polar hb ht hxb hqt).trans_lt hbt
    rw [real_inner_comm, ← hz] at hbound
    have hz0 : z = 0 := by
      have hh := abs_lt.mp hbound
      have hlo : (-1 : ℤ) < z := by exact_mod_cast hh.1
      have hhi : z < (1 : ℤ) := by exact_mod_cast hh.2
      omega
    change inner ℝ q x = 0
    rw [← hz, hz0, Int.cast_zero]
  exact fun x hx => hker hx

/-- A gap in the primal minima produces a short dual basis for the orthogonal
complement of the span of the small primal lattice points. -/
theorem latticeBodySpan_small_dual_basis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) {n : ℕ} (v : Module.Basis (Fin n) ℝ E)
    {b C A : ℝ} (hb : 0 < b)
    (hC : (n : ℝ) * (16 : ℝ) ^ n ≤ C) (hCA : C < A)
    (hgap : ∀ j : ℕ, 0 < j → j ≤ n →
      successiveMinimum K (Submodule.span ℤ (Set.range v)) j ≤ b ∨
        A * b < successiveMinimum K (Submodule.span ℤ (Set.range v)) j)
    (hr : Module.finrank ℝ (latticeBodySpan K (Submodule.span ℤ (Set.range v)) b) < n) :
    let U := latticeBodySpan K (Submodule.span ℤ (Set.range v)) b
    ∃ q : Fin (n - Module.finrank ℝ U) → E,
      LinearIndependent ℝ q ∧
      (∀ i, q i ∈ euclideanDualLattice (Submodule.span ℤ (Set.range v))) ∧
      (∀ i, q i ∈ (C / (A * b)) • euclideanPolar K) ∧
      Submodule.span ℝ (Set.range q) = Uᗮ := by
  intro U
  let L := Submodule.span ℤ (Set.range v)
  let r := Module.finrank ℝ U
  have hdim : Module.finrank ℝ E = n := by
    simpa only [Fintype.card_fin] using Module.finrank_eq_card_basis v
  have hn : 0 < n := by omega
  have hCp : 0 < C := lt_of_lt_of_le (by positivity) hC
  have hAp : 0 < A := hCp.trans hCA
  have hAb : 0 < A * b := mul_pos hAp hb
  have hgt : A * b < successiveMinimum K L (r + 1) := by
    apply latticeBodySpan_rank_gap hK L hb
    · simpa only [hdim] using hgap
    · simpa only [hdim] using hr
  obtain ⟨hp, q, hq, hqm⟩ := successiveMinimum_attained_fullLattice
    (symmetricConvexBody_polar hK) (euclideanDualLattice L)
    (show 0 < n - r by dsimp [r, U]; omega) (by rw [hdim]; omega)
  have hprod := (successiveMinimum_product_upper hK v
    (show 0 < r + 1 by omega) (show r + 1 ≤ n by dsimp [r, U]; omega)).trans hC
  have he : n + 1 - (r + 1) = n - r := by omega
  rw [he] at hprod
  have hscale : successiveMinimum (euclideanPolar K) (euclideanDualLattice L) (n-r) ≤
      C / (A * b) := by
    apply (le_div_iff₀ hAb).mpr
    have hm := (mul_le_mul_of_nonneg_right hgt.le hp.le).trans hprod
    simpa only [mul_comm] using hm
  have ht : 0 < C / (A * b) := div_pos hCp hAb
  have hqt : ∀ i, q i ∈ (C / (A * b)) • euclideanPolar K := by
    intro i
    exact (symmetricConvexBody_gauge_le (symmetricConvexBody_polar hK) (q i) ht).mp
      (((symmetricConvexBody_gauge_le (symmetricConvexBody_polar hK) (q i) hp).mpr
        (hqm i)).trans hscale)
  have hbt : b * (C / (A * b)) < 1 := by
    have heq : b * (C / (A * b)) = C / A := by field_simp
    rw [heq]
    exact (div_lt_one hAp).mpr hCA
  have hsub : Submodule.span ℝ (Set.range q) ≤ Uᗮ := by
    apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact short_dual_vector_mem_orthogonal K L hb.le ht.le hbt (hq.2 i) (hqt i)
  refine ⟨q, hq.1, hq.2, hqt, Submodule.eq_of_le_of_finrank_eq hsub ?_⟩
  have hqdim : Module.finrank ℝ (Submodule.span ℝ (Set.range q)) = n - r := by
    simpa only [Fintype.card_fin] using finrank_span_eq_card hq.1
  have hu := U.finrank_add_finrank_orthogonal
  rw [hdim] at hu
  dsimp [r] at hqdim
  omega

theorem coordinateIntegerLattice_dual (d : ℕ) :
    euclideanDualLattice (coordinateIntegerLattice d) = coordinateIntegerLattice d := by
  apply le_antisymm
  · intro x hx
    apply (mem_coordinateIntegerLattice x).mpr
    intro i
    have hi : (EuclideanSpace.basisFun (Fin d) ℝ) i ∈ coordinateIntegerLattice d :=
      Submodule.subset_span ⟨i, rfl⟩
    obtain ⟨z, hz⟩ := (mem_euclideanDualLattice _ x).mp hx _ hi
    exact ⟨z, by simpa only [EuclideanSpace.inner_basisFun_real] using hz⟩
  · intro x hx
    apply (mem_euclideanDualLattice _ x).mpr
    intro y hy
    obtain ⟨n, rfl⟩ := coordinateIntegerLattice_coordinates hx
    obtain ⟨m, rfl⟩ := coordinateIntegerLattice_coordinates hy
    refine ⟨∑ i, m i * n i, ?_⟩
    simp [EuclideanSpace.inner_eq_star_dotProduct, dotProduct]

/-- The short dual vectors in the return-splitting proof span precisely the
orthogonal complement of the short-return subspace. -/
theorem shortReturnLatticeSpan_dual_basis {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (P : ℝ) {b : ℝ} (hb : 0 < b)
    (hgap : ∀ j : ℕ, 0 < j → j ≤ d →
      successiveMinimum (shortReturnBody V P) (coordinateIntegerLattice d) j ≤ b ∨
        (16 * (100 * (d : ℝ)) ^ (10 * d)) * b <
          successiveMinimum (shortReturnBody V P) (coordinateIntegerLattice d) j)
    (hr : Module.finrank ℝ (shortReturnLatticeSpan V P b) < d) :
    ∃ q : Fin (d - Module.finrank ℝ (shortReturnLatticeSpan V P b)) →
        EuclideanSpace ℝ (Fin d),
      LinearIndependent ℝ q ∧
      (∀ i, q i ∈ coordinateIntegerLattice d) ∧
      (∀ i, q i ∈ ((100 * (d : ℝ)) ^ (10 * d) /
        ((16 * (100 * (d : ℝ)) ^ (10 * d)) * b)) • euclideanPolar (shortReturnBody V P)) ∧
      Submodule.span ℝ (Set.range q) = (shortReturnLatticeSpan V P b)ᗮ := by
  have hd : 0 < d := by omega
  have hC : 0 < (100 * (d : ℝ)) ^ (10 * d) := by positivity
  have hh := latticeBodySpan_small_dual_basis (shortReturnBody_symmetricConvexBody V P)
    (EuclideanSpace.basisFun (Fin d) ℝ).toBasis hb (transference_constant_bound hd)
    (show (100 * (d : ℝ)) ^ (10 * d) < 16 * (100 * (d : ℝ)) ^ (10 * d) by linarith only [hC])
    hgap hr
  obtain ⟨q, hq, hqL, hqt, hspan⟩ := hh
  refine ⟨q, hq, ?_, hqt, hspan⟩
  intro i
  have hi : q i ∈ euclideanDualLattice (coordinateIntegerLattice d) := hqL i
  rwa [coordinateIntegerLattice_dual] at hi

theorem euclideanCoordinateCube_basis_mem {d : ℕ} (i : Fin d) :
    EuclideanSpace.basisFun (Fin d) ℝ i ∈ euclideanCoordinateCube d := by
  apply (mem_euclideanCoordinateCube _).mpr
  intro j
  simp [EuclideanSpace.basisFun_apply]
  split_ifs <;> norm_num

theorem shortReturnBody_scaled_image_mem {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (P : ℝ) {h : EuclideanSpace ℝ (Fin k)} (hh : h ∈ euclideanCoordinateCube k) :
    P⁻¹ • V h ∈ shortReturnBody V P := by
  exact ⟨P⁻¹ • V h, ⟨h, hh, rfl⟩, 0, euclideanCoordinateCube_zero d, add_zero _⟩

theorem shortReturnBody_polar_coordinates {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    {P t : ℝ} (hP : 0 < P) (ht : 0 ≤ t) {q : EuclideanSpace ℝ (Fin d)}
    (hq : q ∈ t • euclideanPolar (shortReturnBody V P)) :
    (∀ i, |q i| ≤ t) ∧
    (∀ j, |inner ℝ q (V (EuclideanSpace.basisFun (Fin k) ℝ j))| ≤ P * t) := by
  constructor
  · intro i
    have hx := shortReturnBody_cube_subset V P (euclideanCoordinateCube_basis_mem i)
    have hh := inner_le_of_mem_dilate_polar (show (0 : ℝ) ≤ 1 by norm_num) ht
      (show EuclideanSpace.basisFun (Fin d) ℝ i ∈ (1 : ℝ) • shortReturnBody V P by
        simpa using hx) hq
    simpa only [one_mul, EuclideanSpace.basisFun_inner] using hh
  · intro j
    have hx := shortReturnBody_scaled_image_mem V P (euclideanCoordinateCube_basis_mem j)
    have hh := inner_le_of_mem_dilate_polar (show (0 : ℝ) ≤ 1 by norm_num) ht
      (show P⁻¹ • V (EuclideanSpace.basisFun (Fin k) ℝ j) ∈
        (1 : ℝ) • shortReturnBody V P by simpa using hx) hq
    rw [one_mul, real_inner_smul_left, abs_mul, abs_of_pos (inv_pos.mpr hP),
      real_inner_comm] at hh
    have hm := mul_le_mul_of_nonneg_left hh hP.le
    simpa only [← mul_assoc, mul_inv_cancel₀ hP.ne', one_mul] using hm

/-- Finite torus pigeonholing with an explicit cubical grid. -/
theorem finite_torus_close_pair {d N : ℕ} (hN : 0 < N)
    (x : Fin (N ^ d + 1) → Fin d → ℝ) :
    ∃ i j : Fin (N ^ d + 1), i < j ∧
      ∀ l, |Int.fract (x j l) - Int.fract (x i l)| ≤ 1 / (N : ℝ) := by
  classical
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  let box : Fin (N ^ d + 1) → Fin d → Fin N := fun i l =>
    ⟨⌊(N : ℝ) * Int.fract (x i l)⌋₊, (Nat.floor_lt (by positivity)).mpr
      (by nlinarith only [Int.fract_lt_one (x i l), hNr])⟩
  have hcard : Fintype.card (Fin d → Fin N) < Fintype.card (Fin (N ^ d + 1)) := by
    simp
  obtain ⟨i, j, hij, hbox⟩ := Fintype.exists_ne_map_eq_of_card_lt box hcard
  have hclose (u v : Fin (N ^ d + 1)) (he : box u = box v) (l : Fin d) :
      |Int.fract (x v l) - Int.fract (x u l)| ≤ 1 / (N : ℝ) := by
    have heq := congrArg Fin.val (congrFun he l)
    change ⌊(N : ℝ) * Int.fract (x u l)⌋₊ = ⌊(N : ℝ) * Int.fract (x v l)⌋₊ at heq
    have hul := Nat.floor_le (show 0 ≤ (N : ℝ) * Int.fract (x u l) by positivity)
    have huv := Nat.lt_floor_add_one ((N : ℝ) * Int.fract (x u l))
    have hvl := Nat.floor_le (show 0 ≤ (N : ℝ) * Int.fract (x v l) by positivity)
    have hvv := Nat.lt_floor_add_one ((N : ℝ) * Int.fract (x v l))
    rw [heq] at hul huv
    apply abs_le.mpr
    constructor
    · have hh : (Int.fract (x v l) - Int.fract (x u l)) * N ≥ -1 := by
        nlinarith only [huv, hvl]
      have hd := (le_div_iff₀ hNr).mpr (show
        (-(Int.fract (x v l) - Int.fract (x u l))) * N ≤ 1 by linarith only [hh])
      linarith only [hd]
    · apply (le_div_iff₀ hNr).mpr
      nlinarith only [hvv, hul]
  rcases lt_or_gt_of_ne hij with hlt | hgt
  · exact ⟨i, j, hlt, hclose i j hbox⟩
  · exact ⟨j, i, hgt, hclose j i hbox.symm⟩

theorem finite_grid_line_return {d N : ℕ} (hN : 0 < N)
    (v : Fin d → ℝ) {b : ℝ} (hb : 0 < b) :
    ∃ (t : ℝ) (n : Fin d → ℤ),
      b / (N : ℝ) ^ d ≤ t ∧ t ≤ b ∧
      ∀ l, |t * v l - (n l : ℝ)| ≤ 1 / (N : ℝ) := by
  let x : Fin (N ^ d + 1) → Fin d → ℝ :=
    fun i l => (b / (N : ℝ) ^ d) * (i.val : ℝ) * v l
  obtain ⟨i, j, hij, hclose⟩ := finite_torus_close_pair hN x
  let t := (b / (N : ℝ) ^ d) * ((j.val : ℝ) - i.val)
  let n : Fin d → ℤ := fun l => ⌊x j l⌋ - ⌊x i l⌋
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  have hpow : 0 < (N : ℝ) ^ d := pow_pos hNr d
  have hstep : 0 < b / (N : ℝ) ^ d := div_pos hb hpow
  have hlo : (1 : ℝ) ≤ (j.val : ℝ) - i.val := by
    have hh : (i.val : ℝ) + 1 ≤ j.val := by exact_mod_cast hij
    linarith only [hh]
  have hhi : (j.val : ℝ) - i.val ≤ (N : ℝ) ^ d := by
    have hj : (j.val : ℝ) ≤ (N : ℝ) ^ d := by
      exact_mod_cast (show j.val ≤ N ^ d by omega)
    linarith only [hj, Nat.cast_nonneg (α := ℝ) i.val]
  refine ⟨t, n, ?_, ?_, ?_⟩
  · exact le_mul_of_one_le_right hstep.le hlo
  · calc
      t ≤ (b / (N : ℝ) ^ d) * (N : ℝ) ^ d :=
        mul_le_mul_of_nonneg_left hhi hstep.le
      _ = b := div_mul_cancel₀ b hpow.ne'
  · intro l
    have he : t * v l - (n l : ℝ) = Int.fract (x j l) - Int.fract (x i l) := by
      simp only [Int.fract, n, Int.cast_sub, t, x]
      ring
    rw [he]
    exact hclose l

theorem small_line_lattice_return {d : ℕ} (v : Fin d → ℝ) {b : ℝ} (hb : 0 < b) :
    ∃ (M : ℕ) (t : ℝ) (n : Fin d → ℤ), 0 < M ∧
      (M : ℝ) ≤ (1 + 4 / b) ^ d ∧ b / M ≤ t ∧ t ≤ b ∧
      ∀ l, |t * v l - (n l : ℝ)| ≤ b / 4 := by
  let N := ⌈4 / b⌉₊
  have hfrac : 0 < 4 / b := div_pos (by norm_num) hb
  have hN : 0 < N := Nat.one_le_ceil_iff.mpr hfrac
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  obtain ⟨t, n, htlo, hthi, hn⟩ := finite_grid_line_return hN v hb
  refine ⟨N ^ d, t, n, pow_pos hN d, ?_, ?_, hthi, ?_⟩
  · have hceil : (N : ℝ) ≤ 1 + 4 / b := by
      simpa only [add_comm] using (Nat.ceil_lt_add_one hfrac.le).le
    simpa only [Nat.cast_pow] using pow_le_pow_left₀ hNr.le hceil d
  · simpa only [Nat.cast_pow] using htlo
  · intro l
    apply (hn l).trans
    have hceil : 4 / b ≤ (N : ℝ) := Nat.le_ceil _
    have hm : 4 ≤ (N : ℝ) * b := (div_le_iff₀ hb).mp hceil
    apply (div_le_iff₀ hNr).mpr
    nlinarith only [hm]

theorem mem_smul_shortReturnBody_of_representation {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (P : ℝ) {b : ℝ} (hb : 0 < b) {x : EuclideanSpace ℝ (Fin d)}
    (h : EuclideanSpace ℝ (Fin k)) (w : EuclideanSpace ℝ (Fin d))
    (hh : ∀ j, |h j| ≤ b) (hw : ∀ i, |w i| ≤ b)
    (he : P⁻¹ • V h + w = x) :
    x ∈ b • shortReturnBody V P := by
  apply Set.mem_smul_set.mpr
  refine ⟨b⁻¹ • x, ?_, ?_⟩
  · apply (mem_shortReturnBody V P _).mpr
    refine ⟨b⁻¹ • h, b⁻¹ • w, ?_, ?_, ?_⟩
    · intro j
      have hm := mul_le_mul_of_nonneg_left (hh j) (inv_nonneg.mpr hb.le)
      simpa only [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_pos (inv_pos.mpr hb),
        inv_mul_cancel₀ hb.ne'] using hm
    · intro i
      have hm := mul_le_mul_of_nonneg_left (hw i) (inv_nonneg.mpr hb.le)
      simpa only [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_pos (inv_pos.mpr hb),
        inv_mul_cancel₀ hb.ne'] using hm
    · rw [map_smul, smul_comm P⁻¹ b⁻¹, ← smul_add, he]
  · rw [smul_smul, mul_inv_cancel₀ hb.ne', one_smul]

/-- Quantitative returns along every coordinate axis, with the returning
integer vector in the short-return span. -/
theorem shortReturnBody_coordinate_return {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    {P b : ℝ} (hP : 0 < P) (hb : 0 < b) (j : Fin k) :
    ∃ (M : ℕ) (t : ℝ) (n : Fin d → ℤ),
      0 < M ∧ (M : ℝ) ≤ (1 + 4 / b) ^ d ∧ b / M ≤ t ∧ t ≤ b ∧
      WithLp.toLp 2 (fun i => (n i : ℝ)) ∈ b • shortReturnBody V P ∧
      P • WithLp.toLp 2 (fun i => (n i : ℝ)) ∈ shortReturnLatticeSpan V P b ∧
      (∀ i, |(V (t • EuclideanSpace.basisFun (Fin k) ℝ j) -
        P • WithLp.toLp 2 (fun i => (n i : ℝ))) i| ≤ P * b / 4) ∧
      ‖t • EuclideanSpace.basisFun (Fin k) ℝ j‖ +
        ‖V (t • EuclideanSpace.basisFun (Fin k) ℝ j) -
          P • WithLp.toLp 2 (fun i => (n i : ℝ))‖ ≤ (1 + P * d) * b := by
  let e := EuclideanSpace.basisFun (Fin k) ℝ j
  let v := P⁻¹ • V e
  obtain ⟨M, t, n, hM, hMb, htlo, hthi, hn⟩ := small_line_lattice_return v.ofLp hb
  have hMr : (0 : ℝ) < M := by exact_mod_cast hM
  have ht : 0 < t := (div_pos hb hMr).trans_le htlo
  let h := t • e
  let z : EuclideanSpace ℝ (Fin d) := WithLp.toLp 2 (fun i => (n i : ℝ))
  let w := z - P⁻¹ • V h
  have hw (i : Fin d) : |w i| ≤ b / 4 := by
    have he : w i = -(t * v i - (n i : ℝ)) := by
      simp only [w, z, h, v, map_smul, PiLp.sub_apply, PiLp.smul_apply,
        smul_eq_mul]
      ring
    rw [he, abs_neg]
    exact hn i
  have hcoord : ∀ l, |h l| ≤ b := by
    intro l
    have he := (mem_euclideanCoordinateCube e).mp (euclideanCoordinateCube_basis_mem j) l
    calc
      |h l| = t * |e l| := by simp only [h, PiLp.smul_apply, smul_eq_mul, abs_mul,
        abs_of_pos ht]
      _ ≤ t := mul_le_of_le_one_right ht.le he
      _ ≤ b := hthi
  have hz : z ∈ b • shortReturnBody V P := by
    apply mem_smul_shortReturnBody_of_representation V P hb h w hcoord
      (fun i => (hw i).trans (by linarith only [hb]))
    dsimp [w]
    abel
  have hzL : z ∈ coordinateIntegerLattice d :=
    (mem_coordinateIntegerLattice z).mpr (fun i => ⟨n i, rfl⟩)
  have hzU : P • z ∈ shortReturnLatticeSpan V P b :=
    Submodule.smul_mem _ P (Submodule.subset_span ⟨hzL, hz⟩)
  have hd : V h - P • z = -(P • w) := by
    simp only [w, smul_sub, smul_smul, mul_inv_cancel₀ hP.ne', one_smul]
    abel
  have hdef (i : Fin d) : |(V h - P • z) i| ≤ P * b / 4 := by
    rw [hd]
    simp only [PiLp.neg_apply, PiLp.smul_apply, smul_eq_mul, abs_neg, abs_mul,
      abs_of_pos hP]
    have hh := mul_le_mul_of_nonneg_left (hw i) hP.le
    simpa only [mul_div_assoc] using hh
  refine ⟨M, t, n, hM, hMb, htlo, hthi, hz, hzU, hdef, ?_⟩
  have hhn : ‖h‖ = t := by
    simp [h, e, norm_smul, abs_of_pos ht, EuclideanSpace.basisFun_apply]
  have hdn := euclidean_norm_le_coordinate_bound (V h - P • z) hdef
  change ‖h‖ + ‖V h - P • z‖ ≤ _
  rw [hhn]
  have hnonneg : 0 ≤ P * (d : ℝ) * b := by positivity
  nlinarith only [hdn, hthi, hnonneg]

/-- Integer generators of the orthogonal complement of the short-return span,
including the full-rank case. Coordinate and velocity-pairing bounds depend
only on the reciprocal return scale. -/
theorem shortReturnLatticeSpan_dual_coordinates {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    {P b : ℝ} (hP : 0 < P) (hb : 0 < b)
    (hgap : ∀ j : ℕ, 0 < j → j ≤ d →
      successiveMinimum (shortReturnBody V P) (coordinateIntegerLattice d) j ≤ b ∨
        (16 * (100 * (d : ℝ)) ^ (10 * d)) * b <
          successiveMinimum (shortReturnBody V P) (coordinateIntegerLattice d) j) :
    ∃ r ≤ d, ∃ q : Fin r → EuclideanSpace ℝ (Fin d),
      LinearIndependent ℝ q ∧
      (∀ i, q i ∈ coordinateIntegerLattice d) ∧
      (∀ i j, |q i j| ≤ b⁻¹) ∧
      (∀ i j, |inner ℝ (q i) (V (EuclideanSpace.basisFun (Fin k) ℝ j))| ≤ P * b⁻¹) ∧
      Submodule.span ℝ (Set.range q) = (shortReturnLatticeSpan V P b)ᗮ := by
  classical
  by_cases hr : Module.finrank ℝ (shortReturnLatticeSpan V P b) < d
  · obtain ⟨q, hq, hqL, hqt, hspan⟩ := shortReturnLatticeSpan_dual_basis V P hb hgap hr
    have hd : 0 < d := by omega
    have hC : 0 < (100 * (d : ℝ)) ^ (10 * d) := by positivity
    have he : (100 * (d : ℝ)) ^ (10 * d) /
        ((16 * (100 * (d : ℝ)) ^ (10 * d)) * b) = b⁻¹ / 16 := by
      field_simp
    have hs : 0 ≤ b⁻¹ / 16 := by positivity
    have hsle : b⁻¹ / 16 ≤ b⁻¹ := by have := inv_pos.mpr hb; linarith
    refine ⟨d - Module.finrank ℝ (shortReturnLatticeSpan V P b),
      Nat.sub_le _ _, q, hq, hqL, ?_, ?_, hspan⟩
    · intro i j
      have hi := hqt i
      rw [he] at hi
      exact ((shortReturnBody_polar_coordinates V hP hs hi).1 j).trans hsle
    · intro i j
      have hi := hqt i
      rw [he] at hi
      exact ((shortReturnBody_polar_coordinates V hP hs hi).2 j).trans
        (mul_le_mul_of_nonneg_left hsle hP.le)
  · have htop : shortReturnLatticeSpan V P b = ⊤ := by
      apply Submodule.eq_top_of_finrank_eq
      have hle := (shortReturnLatticeSpan V P b).finrank_le
      simp only [finrank_euclideanSpace, Fintype.card_fin] at hle ⊢
      omega
    refine ⟨0, Nat.zero_le _, Fin.elim0, linearIndependent_empty_type, ?_, ?_, ?_, ?_⟩
    · intro i; exact Fin.elim0 i
    · intro i; exact Fin.elim0 i
    · intro i; exact Fin.elim0 i
    · simp [htop]

end TrilinearHT.Auto

end

section

namespace TrilinearHT.Auto
open Filter Polynomial MeasureTheory AddCircle
open scoped Topology ComplexConjugate FourierTransform ENNReal BigOperators

theorem shortReturnSplittingBudget_quasipolynomial :
    QuasipolynomialBound shortReturnSplittingBudget :=
  quasipolynomialBound_add
    (quasipolynomialBound_add
      (quasipolynomialBound_add (quasipolynomialBound_const (by norm_num))
        shortReturnProjectionBudget_quasipolynomial) shortReturnSlowBudget_quasipolynomial)
    shortReturnQuadraticBudget_quasipolynomial

theorem shortReturnRowBudget_two_le {t : ℝ} (ht : 2 ≤ t) :
    2 ≤ shortReturnRowBudget t := by
  have hh := quasipolynomialBound_nonneg shortReturnScaleBudget_quasipolynomial ht
  dsimp [shortReturnRowBudget]
  linarith only [hh]

theorem shortReturnGramBudget_two_le {t : ℝ} (ht : 2 ≤ t) :
    2 ≤ shortReturnGramBudget t := by
  have hh := one_le_logarithmicSize ht
  dsimp [shortReturnGramBudget]
  exact le_add_of_nonneg_right (by positivity)

theorem shortReturnSlowBudget_two_le {t : ℝ} (ht : 2 ≤ t) :
    2 ≤ shortReturnSlowBudget t := by
  have hL := one_le_logarithmicSize ht
  have hB := shortReturnRowBudget_two_le ht
  have hG := shortReturnGramBudget_two_le ht
  unfold shortReturnSlowBudget
  exact le_add_of_nonneg_right (by positivity)

theorem shortReturnRadius_reciprocal_bound {t a M N : ℝ} (ht : 2 ≤ t)
    (ha : 0 < a) (hM0 : 0 ≤ M) (hN0 : 0 ≤ N)
    (haT : a⁻¹ ≤ t) (hM : M ≤ t) (hN : N ≤ shortReturnAlternatingBudget t) :
    let r := min a (100 * (M + N + 1))⁻¹
    0 < r ∧ r ≤ a ∧ r⁻¹ ≤ shortReturnRadiusBudget t := by
  intro r
  have hp : 0 < 100 * (M + N + 1) := by positivity
  refine ⟨lt_min ha (inv_pos.mpr hp), min_le_left _ _, ?_⟩
  have hA0 := quasipolynomialBound_nonneg shortReturnAlternatingBudget_quasipolynomial ht
  by_cases hh : a ≤ (100 * (M + N + 1))⁻¹
  · dsimp [r]
    rw [min_eq_left hh]
    exact haT.trans (by
      unfold shortReturnRadiusBudget
      exact le_add_of_nonneg_right (by positivity))
  · dsimp [r]
    rw [min_eq_right (le_of_not_ge hh), inv_inv]
    unfold shortReturnRadiusBudget
    linarith only [hM, hN, ht]

theorem shortReturnInitialScale_reciprocal_bound {t P r : ℝ} (ht : 2 ≤ t)
    (hP : 0 < P) (hr : 0 < r) (hPt : P ≤ t)
    (hrT : r⁻¹ ≤ shortReturnRadiusBudget t) {d k : ℕ}
    (hd : (d : ℝ) ≤ logarithmicSize t) (hk : k ≤ 3) :
    let b := min (1 / 100 : ℝ) (r / (100 * P * (d + k + 1)))
    0 < b ∧ b⁻¹ ≤ shortReturnInitialScaleBudget t := by
  intro b
  have hden : 0 < 100 * P * (d + k + 1 : ℝ) := by positivity
  have hL := one_le_logarithmicSize ht
  have hR := quasipolynomialBound_nonneg shortReturnRadiusBudget_quasipolynomial ht
  have hkr : (k : ℝ) ≤ 3 := by exact_mod_cast hk
  refine ⟨lt_min (by norm_num) (div_pos hr hden), ?_⟩
  by_cases hh : (1 / 100 : ℝ) ≤ r / (100 * P * (d + k + 1))
  · dsimp [b]
    rw [min_eq_left hh]
    norm_num
    unfold shortReturnInitialScaleBudget
    exact le_add_of_nonneg_right (by positivity)
  · dsimp [b]
    rw [min_eq_right (le_of_not_ge hh), inv_div, div_eq_mul_inv]
    have hdim : (d + k + 1 : ℝ) ≤ logarithmicSize t + 4 := by linarith only [hd, hkr]
    have hm : 100 * P * (d + k + 1 : ℝ) * r⁻¹ ≤
        100 * t * (logarithmicSize t + 4) * shortReturnRadiusBudget t := by
      gcongr
    exact hm.trans (by unfold shortReturnInitialScaleBudget; linarith)

theorem shortReturnGapBudget_one_le {t : ℝ} (ht : 2 ≤ t) :
    1 ≤ shortReturnGapBudget t := by
  have hL := one_le_logarithmicSize ht
  have hb : 1 ≤ 100 * (logarithmicSize t + 1) := by linarith only [hL]
  have he : 0 ≤ 10 * (logarithmicSize t + 1) := by positivity
  have hh := Real.one_le_rpow hb he
  unfold shortReturnGapBudget
  linarith only [hh]

theorem shortReturnGapBudget_bound {t : ℝ} (ht : 2 ≤ t) {d : ℕ}
    (hd : (d : ℝ) ≤ logarithmicSize t) :
    16 * (100 * (d : ℝ)) ^ (10 * d) ≤ shortReturnGapBudget t := by
  have hL := one_le_logarithmicSize ht
  have hb : 1 ≤ 100 * (logarithmicSize t + 1) := by linarith only [hL]
  unfold shortReturnGapBudget
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  calc
    (100 * (d : ℝ)) ^ (10 * d) =
        (100 * (d : ℝ)) ^ (10 * (d : ℝ)) := by
      rw [← Real.rpow_natCast]
      norm_cast
    _ ≤ (100 * (logarithmicSize t + 1)) ^ (10 * (d : ℝ)) :=
      Real.rpow_le_rpow (by positivity) (by linarith only [hd]) (by positivity)
    _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hb (by linarith only [hd])

theorem shortReturnScale_reciprocal_bound {t c g b : ℝ} (ht : 2 ≤ t)
    (hg0 : 0 ≤ g) {d : ℕ} (hd : (d : ℝ) ≤ logarithmicSize t)
    (hcT : c⁻¹ ≤ shortReturnInitialScaleBudget t)
    (hgT : g ≤ shortReturnGapBudget t)
    (hb : b⁻¹ ≤ c⁻¹ * g ^ (d + 1)) :
    b⁻¹ ≤ shortReturnScaleBudget t := by
  have hL := one_le_logarithmicSize ht
  have hR := quasipolynomialBound_nonneg shortReturnRadiusBudget_quasipolynomial ht
  have hI : 0 ≤ shortReturnInitialScaleBudget t := by
    unfold shortReturnInitialScaleBudget
    positivity
  have hp : g ^ (d + 1) ≤
      shortReturnGapBudget t ^ (logarithmicSize t + 1) := by
    calc
      g ^ (d + 1) = g ^ ((d : ℝ) + 1) := by
        rw [← Real.rpow_natCast]
        norm_cast
      _ ≤ shortReturnGapBudget t ^ ((d : ℝ) + 1) :=
        Real.rpow_le_rpow hg0 hgT (by positivity)
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le (shortReturnGapBudget_one_le ht)
        (add_le_add hd le_rfl)
  exact hb.trans (mul_le_mul hcT hp (pow_nonneg hg0 _) hI)

theorem shortReturnProjectionBudget_bound {t B : ℝ} (ht : 2 ≤ t) (hB : 2 ≤ B)
    (hBT : B ≤ shortReturnRowBudget t) {d : ℕ}
    (hd : (d : ℝ) ≤ logarithmicSize t) :
    Real.exp (8 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B)) ≤
      shortReturnProjectionBudget t := by
  have hR := shortReturnRowBudget_two_le ht
  have hL := one_le_logarithmicSize ht
  have hlog : 0 ≤ Real.log (2 * B) := Real.log_nonneg (by linarith only [hB])
  have hl := Real.log_le_log (show 0 < 2 * B by linarith only [hB])
    (show 2 * B ≤ 2 * shortReturnRowBudget t by linarith only [hBT])
  unfold shortReturnProjectionBudget
  rw [Real.rpow_def_of_pos (by positivity)]
  apply Real.exp_le_exp.mpr
  calc
    _ ≤ 8 * (logarithmicSize t + 1) ^ 4 * Real.log (2 * shortReturnRowBudget t) := by
      gcongr
    _ = _ := by ring

theorem shortReturnGramBudget_bound {t : ℝ} (ht : 2 ≤ t) {d : ℕ}
    (hd : (d : ℝ) ≤ logarithmicSize t) :
    max 2 ((d : ℝ) * shortReturnRowBudget t ^ 2) ≤ shortReturnGramBudget t := by
  apply max_le (shortReturnGramBudget_two_le ht)
  have hh := mul_le_mul_of_nonneg_right hd (sq_nonneg (shortReturnRowBudget t))
  exact hh.trans (le_add_of_nonneg_left (by norm_num))

theorem shortReturnGram_exponential_bound {t : ℝ} (ht : 2 ≤ t) {r d : ℕ}
    (hr : r ≤ d) (hd : (d : ℝ) ≤ logarithmicSize t) :
    Real.exp (2 * (r + 1 : ℝ) ^ 4 *
      Real.log (2 * max 2 ((d : ℝ) * shortReturnRowBudget t ^ 2))) ≤
      (2 * shortReturnGramBudget t) ^ (2 * (logarithmicSize t + 1) ^ (4 : ℕ)) := by
  have hG := shortReturnGramBudget_two_le ht
  have hL := one_le_logarithmicSize ht
  have hrR : (r : ℝ) ≤ logarithmicSize t := (by exact_mod_cast hr : (r : ℝ) ≤ d).trans hd
  have hm := shortReturnGramBudget_bound ht hd
  have hmax : (2 : ℝ) ≤ max 2 ((d : ℝ) * shortReturnRowBudget t ^ 2) := le_max_left _ _
  have hlog : 0 ≤ Real.log (2 * max 2 ((d : ℝ) * shortReturnRowBudget t ^ 2)) :=
    Real.log_nonneg (by linarith only [hmax])
  have hl := Real.log_le_log (show 0 < 2 * max 2 ((d : ℝ) * shortReturnRowBudget t ^ 2) by
    linarith only [hmax]) (show
      2 * max 2 ((d : ℝ) * shortReturnRowBudget t ^ 2) ≤ 2 * shortReturnGramBudget t by
        linarith only [hm])
  rw [Real.rpow_def_of_pos (by positivity)]
  apply Real.exp_le_exp.mpr
  calc
    _ ≤ 2 * (logarithmicSize t + 1) ^ 4 * Real.log (2 * shortReturnGramBudget t) := by
      gcongr
    _ = _ := by ring

theorem shortReturnSlowBudget_bound {t : ℝ} (ht : 2 ≤ t) {r d k : ℕ}
    (hr : r ≤ d) (hd : (d : ℝ) ≤ logarithmicSize t) (hk : k ≤ 3) :
    ((d : ℝ) * r * shortReturnRowBudget t) *
      (((r : ℝ) * r * Real.exp (2 * (r + 1 : ℝ) ^ 4 *
        Real.log (2 * max 2 ((d : ℝ) * shortReturnRowBudget t ^ 2)))) *
          ((r : ℝ) * k * (t * shortReturnRowBudget t))) ≤ shortReturnSlowBudget t := by
  have hL := one_le_logarithmicSize ht
  have hR := shortReturnRowBudget_two_le ht
  have hG := shortReturnGramBudget_two_le ht
  have hrR : (r : ℝ) ≤ logarithmicSize t := (by exact_mod_cast hr : (r : ℝ) ≤ d).trans hd
  have hkR : (k : ℝ) ≤ 3 := by exact_mod_cast hk
  have hE := shortReturnGram_exponential_bound ht hr hd
  calc
    _ ≤ (logarithmicSize t * logarithmicSize t * shortReturnRowBudget t) *
        ((logarithmicSize t * logarithmicSize t *
          (2 * shortReturnGramBudget t) ^ (2 * (logarithmicSize t + 1) ^ (4 : ℕ))) *
            (logarithmicSize t * 3 * (t * shortReturnRowBudget t))) := by
      gcongr
    _ = shortReturnSlowBudget t - 2 := by unfold shortReturnSlowBudget; ring
    _ ≤ shortReturnSlowBudget t := by linarith

theorem shortReturnTimeInverseBudget_bound {t b : ℝ} (ht : 2 ≤ t) (hb : 0 < b)
    (hbT : b⁻¹ ≤ shortReturnScaleBudget t) {d : ℕ}
    (hd : (d : ℝ) ≤ logarithmicSize t) :
    (1 + 4 / b) ^ d / b ≤ shortReturnTimeInverseBudget t := by
  have hQ := quasipolynomialBound_nonneg shortReturnScaleBudget_quasipolynomial ht
  have hL := one_le_logarithmicSize ht
  have hbase : 1 ≤ 1 + 4 * shortReturnScaleBudget t := by linarith only [hQ]
  have hp : (1 + 4 / b) ^ d ≤
      (1 + 4 * shortReturnScaleBudget t) ^ logarithmicSize t := by
    calc
      (1 + 4 / b) ^ d = (1 + 4 / b) ^ (d : ℝ) := (Real.rpow_natCast _ _).symm
      _ ≤ (1 + 4 * shortReturnScaleBudget t) ^ (d : ℝ) :=
        Real.rpow_le_rpow (by positivity) (by
          rw [div_eq_mul_inv]
          linarith only [hbT]) (Nat.cast_nonneg _)
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hbase hd
  rw [div_eq_mul_inv]
  exact mul_le_mul hp hbT (inv_nonneg.mpr hb.le) (by positivity)

theorem shortReturnQuadraticBudget_bound {t a M s : ℝ} (ht : 2 ≤ t)
    (ha : 0 ≤ a) (ha1 : a ≤ 1) (hM : 0 ≤ M) (hMt : M ≤ t)
    (hs : 0 < s) (hsT : s⁻¹ ≤ shortReturnTimeInverseBudget t)
    {d k : ℕ} (hd : (d : ℝ) ≤ logarithmicSize t) (hk : k ≤ 3) :
    (k : ℝ) * k *
      ((M + (k : ℝ) * d * shortReturnSlowBudget t *
        (shortReturnAlternatingBudget t * (shortReturnSlowBudget t * a)) +
          (k : ℝ) * d * shortReturnSlowBudget t * (shortReturnAlternatingBudget t * a)) / s) ≤
      shortReturnQuadraticBudget t := by
  have hL := one_le_logarithmicSize ht
  have hS := shortReturnSlowBudget_two_le ht
  have hA := quasipolynomialBound_nonneg shortReturnAlternatingBudget_quasipolynomial ht
  have hT := quasipolynomialBound_nonneg shortReturnTimeInverseBudget_quasipolynomial ht
  have hkR : (k : ℝ) ≤ 3 := by exact_mod_cast hk
  have hnum :
      M + (k : ℝ) * d * shortReturnSlowBudget t *
        (shortReturnAlternatingBudget t * (shortReturnSlowBudget t * a)) +
          (k : ℝ) * d * shortReturnSlowBudget t * (shortReturnAlternatingBudget t * a) ≤
      t + 3 * logarithmicSize t * shortReturnSlowBudget t *
        (shortReturnAlternatingBudget t * (shortReturnSlowBudget t * 1)) +
          3 * logarithmicSize t * shortReturnSlowBudget t *
            (shortReturnAlternatingBudget t * 1) := by
    gcongr
  rw [div_eq_mul_inv]
  calc
    _ ≤ 3 * 3 *
        (t + 3 * logarithmicSize t * shortReturnSlowBudget t *
          (shortReturnAlternatingBudget t * (shortReturnSlowBudget t * 1)) +
            3 * logarithmicSize t * shortReturnSlowBudget t *
              (shortReturnAlternatingBudget t * 1)) * shortReturnTimeInverseBudget t := by
      calc
        _ = ((k : ℝ) * k *
            (M + (k : ℝ) * d * shortReturnSlowBudget t *
              (shortReturnAlternatingBudget t * (shortReturnSlowBudget t * a)) +
                (k : ℝ) * d * shortReturnSlowBudget t *
                  (shortReturnAlternatingBudget t * a))) * s⁻¹ := by ring
        _ ≤ _ := by gcongr
    _ = _ := by unfold shortReturnQuadraticBudget; ring

theorem shortReturnSplittingBudget_dominates {t : ℝ} (ht : 2 ≤ t) :
    shortReturnProjectionBudget t ≤ shortReturnSplittingBudget t ∧
    shortReturnSlowBudget t ≤ shortReturnSplittingBudget t ∧
    shortReturnQuadraticBudget t ≤ shortReturnSplittingBudget t := by
  have hP := quasipolynomialBound_nonneg shortReturnProjectionBudget_quasipolynomial ht
  have hS := quasipolynomialBound_nonneg shortReturnSlowBudget_quasipolynomial ht
  have hQ := quasipolynomialBound_nonneg shortReturnQuadraticBudget_quasipolynomial ht
  unfold shortReturnSplittingBudget
  constructor
  · linarith only [hS, hQ]
  constructor
  · linarith only [hP, hQ]
  · linarith only [hP, hS]

theorem shortReturnParameter_product_bounds {H P a M : ℝ}
    (hH : 2 ≤ H) (hP : 1 ≤ P) (ha : 0 < a) (ha1 : a ≤ 1) (hM : 1 ≤ M) :
    let t := H * P * a⁻¹ * M
    2 ≤ t ∧ H ≤ t ∧ P ≤ t ∧ a⁻¹ ≤ t ∧ M ≤ t ∧
      logarithmicSize t = 1 + Real.log H + Real.log P + Real.log (1 / a) + Real.log M := by
  intro t
  have hH1 : 1 ≤ H := by linarith only [hH]
  have hH0 : 0 ≤ H := by linarith only [hH]
  have hP0 : 0 ≤ P := by linarith only [hP]
  have hM0 : 0 ≤ M := by linarith only [hM]
  have haI : 1 ≤ a⁻¹ := (one_le_inv₀ ha).mpr ha1
  have haI0 : 0 ≤ a⁻¹ := inv_nonneg.mpr ha.le
  have hHP : 1 ≤ H * P := by
    simpa using mul_le_mul hH1 hP zero_le_one hH0
  have hHPA : 1 ≤ H * P * a⁻¹ := by
    simpa using mul_le_mul hHP haI zero_le_one (mul_nonneg hH0 hP0)
  have htail : H * P ≤ t :=
    (le_mul_of_one_le_right (mul_nonneg hH0 hP0) haI).trans
      (le_mul_of_one_le_right (by positivity) hM)
  have hh : H ≤ t := (le_mul_of_one_le_right hH0 hP).trans htail
  have hp : P ≤ t := (le_mul_of_one_le_left hP0 hH1).trans htail
  have hi : a⁻¹ ≤ t := (le_mul_of_one_le_left haI0 hHP).trans
    (le_mul_of_one_le_right (by positivity) hM)
  have hm : M ≤ t := le_mul_of_one_le_left hM0 hHPA
  refine ⟨hH.trans hh, hh, hp, hi, hm, ?_⟩
  dsimp [t, logarithmicSize]
  rw [Real.log_mul (by positivity) (by positivity),
    Real.log_mul (by positivity) (by positivity),
    Real.log_mul (by positivity) (by positivity)]
  simp only [one_div]
  ring

theorem shortReturnSplittingBudget_uniform :
    ∃ D : ℕ, 1 ≤ D ∧ ∀ H P a M : ℝ,
      2 ≤ H → 1 ≤ P → 0 < a → a ≤ 1 → 1 ≤ M →
      shortReturnSplittingBudget (H * P * a⁻¹ * M) ≤
        Real.exp ((D : ℝ) *
          (1 + Real.log H + Real.log P + Real.log (1 / a) + Real.log M) ^ D) := by
  obtain ⟨C, hC, e, he, hbudget⟩ := shortReturnSplittingBudget_quasipolynomial
  obtain ⟨D, hD, heD, hCD, henv⟩ := monomial_uniform_natural_envelope C e
  refine ⟨D, hD, ?_⟩
  intro H P a M hH hP ha ha1 hM
  obtain ⟨ht, _, _, _, _, hlog⟩ := shortReturnParameter_product_bounds hH hP ha ha1 hM
  have hh := (hbudget _ ht).2.trans
    (Real.exp_le_exp.mpr (henv _ (one_le_logarithmicSize ht)))
  simpa only [hlog] using hh

/-- Bilinear matrix phase in dot-product notation. -/
theorem chartMatrixPhase_eq_dotProduct {d : ℕ}
    (C : Matrix (Fin d) (Fin d) ℚ) (u w : Fin d → ℝ) :
    chartMatrixPhase C u w = dotProduct u ((C.map (fun q => (q : ℝ))).mulVec w) := by
  simp [chartMatrixPhase, dotProduct, Matrix.mulVec, Finset.mul_sum, mul_assoc]

/-- The complete phase of one lattice summand of a several-variable chart. -/
noncomputable def multivariableChartPhase {k d : ℕ}
    (A : MultivariableQuadraticChartData k d) (z : Fin k → ℝ) (n : Fin d → ℤ) : ℝ :=
  dotProduct z (A.quadratic.mulVec z) + dotProduct A.linear z +
    chartMatrixPhase A.matrix (A.horizontal.mulVec z)
      (A.horizontal.mulVec z - fun i => (n i : ℝ))

theorem multivariableQuadraticChartAtom_eq_tsum {k d : ℕ}
    (A : MultivariableQuadraticChartData k d) (z : Fin k → ℝ) :
    multivariableQuadraticChartAtom A z =
      ∑' n : Fin d → ℤ, A.amplitude (A.horizontal.mulVec z - fun i => (n i : ℝ)) *
        (Real.fourierChar (multivariableChartPhase A z n) : ℂ) := by
  have he : dotProduct z (A.quadratic.mulVec z) =
      ∑ i, ∑ j, z i * A.quadratic i j * z j := by
    simp [dotProduct, Matrix.mulVec, Finset.mul_sum, mul_assoc]
  unfold multivariableQuadraticChartAtom multivariableChartPhase
  rw [← tsum_mul_left]
  apply tsum_congr
  intro n
  rw [he]
  simp only [dotProduct, AddChar.map_add_eq_mul, Circle.coe_mul]
  ring

/-- Exact reindexing and modulation for a chart return. The residual amplitude
is shifted only by the return defect; its phase involves that defect rather
than the unrestricted horizontal velocity. Source: lem:weyl, lines 1321–1331. -/
theorem multivariableQuadraticChart_return_identity {k d : ℕ}
    (A : MultivariableQuadraticChartData k d) (z h : Fin k → ℝ) (m : Fin d → ℤ)
    (hint : ∀ i j, ∃ q : ℤ, (q : ℝ) = (m i : ℝ) * (A.matrix i j : ℝ)) :
    let e := A.horizontal.mulVec h - fun i => (m i : ℝ)
    let C := A.matrix.map (fun q => (q : ℝ))
    let ω := (2 • A.quadratic + A.horizontal.transpose * C * A.horizontal).mulVec h -
      (A.horizontal.transpose * (C - C.transpose)).mulVec (fun i => (m i : ℝ))
    let c := dotProduct h (A.quadratic.mulVec h) + dotProduct A.linear h +
      chartMatrixPhase A.matrix (A.horizontal.mulVec h) e
    multivariableQuadraticChartAtom A (z + h) =
      (Real.fourierChar (c + dotProduct z ω) : ℂ) *
        ∑' n : Fin d → ℤ,
          A.amplitude (A.horizontal.mulVec z - (fun i => (n i : ℝ)) + e) *
          (Real.fourierChar (chartMatrixPhase A.matrix e
            (A.horizontal.mulVec z - fun i => (n i : ℝ))) : ℂ) *
          (Real.fourierChar (multivariableChartPhase A z n) : ℂ) := by
  classical
  intro e C ω c
  rw [multivariableQuadraticChartAtom_eq_tsum]
  rw [show (∑' n : Fin d → ℤ,
      A.amplitude (A.horizontal.mulVec (z + h) - fun i => (n i : ℝ)) *
        (Real.fourierChar (multivariableChartPhase A (z + h) n) : ℂ)) =
      ∑' n : Fin d → ℤ,
        A.amplitude (A.horizontal.mulVec (z + h) - fun i => ((n + m) i : ℝ)) *
          (Real.fourierChar (multivariableChartPhase A (z + h) (n + m)) : ℂ) from
    ((Equiv.addRight m).tsum_eq _).symm, ← tsum_mul_left]
  apply tsum_congr
  intro n
  have hw : A.horizontal.mulVec (z + h) - (fun i => ((n + m) i : ℝ)) =
      A.horizontal.mulVec z - (fun i => (n i : ℝ)) + e := by
    rw [Matrix.mulVec_add]
    ext i
    simp only [Pi.sub_apply, Pi.add_apply, Int.cast_add, e]
    ring
  have hp := quadratic_lattice_return_phase C A.horizontal A.quadratic A.symmetric
    A.linear z h (fun i => (n i : ℝ)) (fun i => (m i : ℝ))
  have hn : (fun i => ((n + m) i : ℝ)) =
      (fun i => (n i : ℝ)) + (fun i => (m i : ℝ)) := by ext i; simp
  have hp' : multivariableChartPhase A (z + h) (n + m) +
      chartMatrixPhase A.matrix (fun i => (m i : ℝ)) (fun i => (n i : ℝ)) =
      (c + dotProduct z ω) + chartMatrixPhase A.matrix e
        (A.horizontal.mulVec z - fun i => (n i : ℝ)) + multivariableChartPhase A z n := by
    simp only [multivariableChartPhase, chartMatrixPhase_eq_dotProduct, hn]
    dsimp [c, ω, e, C] at hp ⊢
    simp only [chartMatrixPhase_eq_dotProduct, quadraticReturnFrequency] at hp ⊢
    linear_combination hp
  obtain ⟨q, hq⟩ := chartMatrixPhase_integer_of_coefficients A.matrix m n hint
  have hchar := congrArg (fun r : ℝ => (Real.fourierChar r : ℂ)) hp'
  rw [← hq, chart_fourierChar_add_int] at hchar
  rw [hw, hchar]
  simp only [AddChar.map_add_eq_mul, Circle.coe_mul]
  ring

/-- A clearing period makes every lattice return eligible for exact reindexing. -/
theorem chart_integer_period_coefficients {d : ℕ}
    (C : Matrix (Fin d) (Fin d) ℚ) (P : ℤ)
    (hPC : ∀ i j, ∃ z : ℤ, (P : ℚ) * C i j = z) (n : Fin d → ℤ) :
    ∀ i j, ∃ z : ℤ, (z : ℝ) = ((P * n i : ℤ) : ℝ) * (C i j : ℝ) := by
  intro i j
  obtain ⟨z, hz⟩ := hPC i j
  have hr : (P : ℝ) * (C i j : ℝ) = z := by exact_mod_cast hz
  refine ⟨n i * z, ?_⟩
  push_cast
  rw [← hr]
  ring

theorem chart_fourierChar_sub_one_norm_le (x : ℝ) :
    ‖(Real.fourierChar x : ℂ) - 1‖ ≤ 2 * Real.pi * |x| := by
  have hh := Real.norm_exp_I_mul_ofReal_sub_one_le (x := 2 * Real.pi * x)
  simpa [Real.fourierChar_apply, mul_comm Complex.I, Real.norm_eq_abs,
    abs_mul, abs_of_pos Real.pi_pos] using hh

/-- A global first-derivative estimate for the actual chart cutoff. -/
theorem multivariableChart_amplitude_difference {k d c₀ : ℕ} {H : ℝ}
    {A : MultivariableQuadraticChartData k d}
    (hA : MultivariableQuadraticChartComplexity c₀ H A) (hc : 1 ≤ c₀)
    (x y : Fin d → ℝ) :
    ‖A.amplitude y - A.amplitude x‖ ≤
      (H ^ (4 * c₀) * (2 : ℝ) ^ (2 * c₀)) * ‖y - x‖ := by
  have hder (z : Fin d → ℝ) : ‖fderiv ℝ A.amplitude z‖ ≤
      H ^ (4 * c₀) * (2 : ℝ) ^ (2 * c₀) := by
    have hh := chart_cutoff_iteratedFDeriv_bound hA hc 1 z
    simpa only [norm_iteratedFDeriv_one, multivariableChartAlongLine,
      Nat.reduceAdd, Nat.cast_one, one_add_one_eq_two,
      show 2 * c₀ * 2 = 4 * c₀ by omega, show c₀ * 2 = 2 * c₀ by omega] using hh
  exact (convex_univ : Convex ℝ (Set.univ : Set (Fin d → ℝ))).norm_image_sub_le_of_norm_fderiv_le
    (fun z _ => A.smooth.differentiable (by simp) z) (fun z _ => hder z)
    (Set.mem_univ x) (Set.mem_univ y)

/-- Shifting a compact amplitude and multiplying by the small defect phase
costs linearly in the defect, uniformly in the horizontal location. -/
theorem chart_modulated_amplitude_error {d : ℕ}
    (C : Matrix (Fin d) (Fin d) ℚ) (χ : (Fin d → ℝ) → ℂ)
    {B K L R : ℝ} (hB : 0 ≤ B) (hK : 0 ≤ K) (hR : 0 ≤ R)
    (hC : ∀ i j, |(C i j : ℝ)| ≤ B)
    (hχ : ∀ w, ‖χ w‖ ≤ K) (hsupp : ∀ w, χ w ≠ 0 → ‖w‖ ≤ R)
    (hLip : ∀ x y, ‖χ y - χ x‖ ≤ L * ‖y - x‖) (w e : Fin d → ℝ) :
    ‖χ (w + e) * (Real.fourierChar (chartMatrixPhase C e w) : ℂ) - χ w‖ ≤
      (L + K * (2 * Real.pi * (d : ℝ) ^ 2 * B * R)) * ‖e‖ := by
  let p : ℂ := Real.fourierChar (chartMatrixPhase C e w)
  have hp : ‖p‖ = 1 := Circle.norm_coe _
  have he : ‖χ (w + e) - χ w‖ ≤ L * ‖e‖ := by
    simpa only [add_sub_cancel_left] using hLip w (w + e)
  have hphase : ‖χ w * (p - 1)‖ ≤
      K * (2 * Real.pi * (d : ℝ) ^ 2 * B * R) * ‖e‖ := by
    by_cases hz : χ w = 0
    · simp only [hz, zero_mul, norm_zero]
      positivity
    have hn := chartMatrixLeftLinear_norm_le C e hB (norm_nonneg e) hC
      (fun i => by simpa only [Real.norm_eq_abs] using norm_le_pi_norm e i)
    have hval : |chartMatrixPhase C e w| ≤ ((d : ℝ) ^ 2 * ‖e‖ * B) * R := by
      rw [← chartMatrixLeftLinear_apply, ← Real.norm_eq_abs]
      exact (chartMatrixLeftLinear C e).le_of_opNorm_le_of_le hn (hsupp w hz)
    rw [norm_mul]
    calc
      _ ≤ K * (2 * Real.pi * (((d : ℝ) ^ 2 * ‖e‖ * B) * R)) :=
        mul_le_mul (hχ w) ((chart_fourierChar_sub_one_norm_le _).trans
          (mul_le_mul_of_nonneg_left hval (by positivity))) (norm_nonneg _) hK
      _ = _ := by ring
  calc
    _ = ‖(χ (w + e) - χ w) * p + χ w * (p - 1)‖ := by congr 1; dsimp [p]; ring
    _ ≤ ‖(χ (w + e) - χ w) * p‖ + ‖χ w * (p - 1)‖ := norm_add_le _ _
    _ ≤ L * ‖e‖ + K * (2 * Real.pi * (d : ℝ) ^ 2 * B * R) * ‖e‖ := by
      rw [norm_mul, hp, mul_one]
      exact add_le_add he hphase
    _ = _ := by ring

/-- A lattice sum inherits the defect estimate with only the uniform number
of terms meeting the original or shifted amplitude support. -/
theorem chart_lattice_modulation_error {d : ℕ}
    (C : Matrix (Fin d) (Fin d) ℚ) (χ : (Fin d → ℝ) → ℂ)
    {B K L R : ℝ} (hB : 0 ≤ B) (hK : 0 ≤ K) (hL : 0 ≤ L) (hR : 0 ≤ R)
    (hC : ∀ i j, |(C i j : ℝ)| ≤ B)
    (hχ : ∀ w, ‖χ w‖ ≤ K)
    (hsupp : ∀ w, χ w ≠ 0 → ∀ i, |w i| ≤ R)
    (hLip : ∀ x y, ‖χ y - χ x‖ ≤ L * ‖y - x‖)
    (u e : Fin d → ℝ) (φ : (Fin d → ℤ) → ℂ) (hφ : ∀ n, ‖φ n‖ ≤ 1) :
    ‖(∑' n : Fin d → ℤ, χ (u - (fun i => (n i : ℝ)) + e) *
        (Real.fourierChar (chartMatrixPhase C e (u - fun i => (n i : ℝ))) : ℂ) * φ n) -
      ∑' n : Fin d → ℤ, χ (u - fun i => (n i : ℝ)) * φ n‖ ≤
      (2 * (2 * R + 3) ^ d) * (L + K * (2 * Real.pi * (d : ℝ) ^ 2 * B * R)) * ‖e‖ := by
  classical
  let S := chartLatticeBox R u ∪ chartLatticeBox R (u + e)
  let T := (L + K * (2 * Real.pi * (d : ℝ) ^ 2 * B * R)) * ‖e‖
  have hT : 0 ≤ T := by dsimp [T]; positivity
  have hz (v : Fin d → ℝ) (n : Fin d → ℤ) (hn : n ∉ chartLatticeBox R v) :
      χ (v - fun i => (n i : ℝ)) = 0 := by
    by_contra hh
    exact hn (mem_chartLatticeBox_of_bound (hsupp _ hh))
  have hshift (n : Fin d → ℤ) :
      u - (fun i => (n i : ℝ)) + e = (u + e) - (fun i => (n i : ℝ)) := by abel
  rw [tsum_eq_sum (s := S) (fun n hn => by
    rw [hshift, hz (u + e) n (fun h => hn (Finset.mem_union_right _ h))]
    simp),
    tsum_eq_sum (s := S) (fun n hn => by
      rw [hz u n (fun h => hn (Finset.mem_union_left _ h))]
      simp), ← Finset.sum_sub_distrib]
  have hcard : (S.card : ℝ) ≤ 2 * (2 * R + 3) ^ d := by
    have hh : (S.card : ℝ) ≤
        (chartLatticeBox R u).card + (chartLatticeBox R (u + e)).card := by
      exact_mod_cast Finset.card_union_le (chartLatticeBox R u) (chartLatticeBox R (u + e))
    linarith only [hh, chartLatticeBox_card_le hR u, chartLatticeBox_card_le hR (u + e)]
  calc
    _ ≤ ∑ n ∈ S, ‖χ (u - (fun i => (n i : ℝ)) + e) *
        (Real.fourierChar (chartMatrixPhase C e (u - fun i => (n i : ℝ))) : ℂ) * φ n -
        χ (u - fun i => (n i : ℝ)) * φ n‖ := norm_sum_le _ _
    _ ≤ ∑ _n ∈ S, T := by
      apply Finset.sum_le_sum
      intro n _
      rw [← sub_mul, norm_mul]
      exact (mul_le_mul (chart_modulated_amplitude_error C χ hB hK hR hC hχ
        (fun w hw => (pi_norm_le_iff_of_nonneg hR).mpr
          (fun i => by simpa only [Real.norm_eq_abs] using hsupp w hw i))
        hLip _ e) (hφ n) (norm_nonneg _) hT).trans_eq (mul_one T)
    _ = (S.card : ℝ) * T := by simp
    _ ≤ (2 * (2 * R + 3) ^ d) * T := mul_le_mul_of_nonneg_right hcard hT
    _ = _ := by dsimp [T]; ring

theorem multivariableQuadraticChart_norm_le {k d c₀ : ℕ} {H : ℝ}
    {A : MultivariableQuadraticChartData k d}
    (hA : MultivariableQuadraticChartComplexity c₀ H A) (z : Fin k → ℝ) :
    ‖multivariableQuadraticChartAtom A z‖ ≤ (2 * H + 3) ^ d * H ^ c₀ := by
  have hh := quadraticChartAtom_norm_le (multivariableChartAlongLine_complexity hA z) 1
  simpa only [multivariableChartAlongLine_atom, one_smul] using hh

/-- The return error for the actual several-variable atom is uniform in the
horizontal and ordinary quadratic parameters. Source: eq:return. -/
theorem multivariableQuadraticChart_return_error {k d c₀ : ℕ} {H : ℝ}
    {A : MultivariableQuadraticChartData k d}
    (hA : MultivariableQuadraticChartComplexity c₀ H A) (hc : 1 ≤ c₀)
    (z h : Fin k → ℝ) (m : Fin d → ℤ)
    (hint : ∀ i j, ∃ q : ℤ, (q : ℝ) = (m i : ℝ) * (A.matrix i j : ℝ)) :
    let e := A.horizontal.mulVec h - fun i => (m i : ℝ)
    let C := A.matrix.map (fun q => (q : ℝ))
    let ω := (2 • A.quadratic + A.horizontal.transpose * C * A.horizontal).mulVec h -
      (A.horizontal.transpose * (C - C.transpose)).mulVec (fun i => (m i : ℝ))
    let c := dotProduct h (A.quadratic.mulVec h) + dotProduct A.linear h +
      chartMatrixPhase A.matrix (A.horizontal.mulVec h) e
    ‖multivariableQuadraticChartAtom A (z + h) -
      (Real.fourierChar (c + dotProduct z ω) : ℂ) * multivariableQuadraticChartAtom A z‖ ≤
      (2 * (2 * H + 3) ^ d) *
        (H ^ (4 * c₀) * (2 : ℝ) ^ (2 * c₀) +
          H ^ c₀ * (2 * Real.pi * (d : ℝ) ^ 2 * H * H)) * ‖e‖ := by
  intro e C ω c
  have hH := (quadraticChartComplexity_parameter_pos hA).le
  have hC (i j) : |(A.matrix i j : ℝ)| ≤ H := by
    have hh : |(A.matrix i j : ℝ)| ≤ (chartRationalHeight (A.matrix i j) : ℝ) := by
      exact_mod_cast rational_abs_le_height (A.matrix i j)
    exact hh.trans (hA.height i j)
  rw [multivariableQuadraticChart_return_identity A z h m hint,
    multivariableQuadraticChartAtom_eq_tsum, ← mul_sub, norm_mul, Circle.norm_coe, one_mul]
  exact chart_lattice_modulation_error A.matrix A.amplitude hH (pow_nonneg hH _)
    (by positivity) hH hC (quadraticChartComplexity_amplitude_bound hA) hA.support
    (multivariableChart_amplitude_difference hA hc) (A.horizontal.mulVec z) e
    (fun n => (Real.fourierChar (multivariableChartPhase A z n) : ℂ))
    (fun n => (Circle.norm_coe _).le)

theorem multivariableQuadraticChartAtom_measurable {k d : ℕ}
    (A : MultivariableQuadraticChartData k d) :
    Measurable (multivariableQuadraticChartAtom A) := by
  unfold multivariableQuadraticChartAtom
  apply Measurable.mul
  · fun_prop
  · apply Measurable.tsum
    intro n
    apply Measurable.mul
    · exact A.smooth.continuous.measurable.comp (by fun_prop)
    · unfold chartMatrixPhase
      fun_prop

/-- Localization adds only the cutoff's translation error to a modulation error. -/
theorem localized_modulation_error {E : Type*} [NormedAddCommGroup E]
    (θ Q : E → ℂ) (z h : E) (p : ℂ) {K L B D η : ℝ}
    (hK : 0 ≤ K) (hL : 0 ≤ L) (hB : 0 ≤ B) (hD : 0 ≤ D) (hη : 0 ≤ η)
    (hθ : ‖θ z‖ ≤ K) (hθh : ‖θ (z + h) - θ z‖ ≤ L * ‖h‖)
    (hQ : ‖Q (z + h)‖ ≤ B) (herr : ‖Q (z + h) - p * Q z‖ ≤ D * η) :
    ‖θ (z + h) * Q (z + h) - p * (θ z * Q z)‖ ≤
      (L * B + K * D) * (‖h‖ + η) := by
  calc
    _ = ‖(θ (z + h) - θ z) * Q (z + h) +
        θ z * (Q (z + h) - p * Q z)‖ := by congr 1; ring
    _ ≤ ‖(θ (z + h) - θ z) * Q (z + h)‖ +
        ‖θ z * (Q (z + h) - p * Q z)‖ := norm_add_le _ _
    _ ≤ (L * ‖h‖) * B + K * (D * η) := by
      simp only [norm_mul]
      exact add_le_add (mul_le_mul hθh hQ (norm_nonneg _) (by positivity))
        (mul_le_mul hθ herr (norm_nonneg _) hK)
    _ ≤ _ := by nlinarith [mul_nonneg (mul_nonneg hL hB) hη,
      mul_nonneg (mul_nonneg hK hD) (norm_nonneg h)]

/-- An explicitly bounded measurable function supported in a finite-measure
set is integrable, with its L1 norm bounded by size times measure. -/
theorem bounded_supported_integral_norm {X : Type*} [MeasurableSpace X]
    {μ : Measure X} {f : X → ℂ} {S : Set X} {B : ℝ}
    (hf : AEStronglyMeasurable f μ) (hS : MeasurableSet S) (hSf : μ S ≠ ⊤)
    (hbound : ∀ x, ‖f x‖ ≤ B) (hsupp : ∀ x, x ∉ S → f x = 0) :
    Integrable f μ ∧ (∫ x, ‖f x‖ ∂μ) ≤ μ.real S * B := by
  have hg : Integrable (S.indicator (fun _ : X => B)) μ :=
    (integrable_indicator_iff hS).mpr (integrableOn_const (C := B) hSf)
  have hb (x) : ‖f x‖ ≤ S.indicator (fun _ : X => B) x := by
    by_cases hx : x ∈ S
    · simpa only [Set.indicator_of_mem hx] using hbound x
    · simp [Set.indicator_of_notMem hx, hsupp x hx]
  have hfi : Integrable f μ := hg.mono' hf (Filter.Eventually.of_forall hb)
  refine ⟨hfi, ?_⟩
  exact (integral_mono hfi.norm hg hb).trans_eq (by
    rw [integral_indicator_const B hS]
    rfl)

/-- The preceding bound with the exact volume of a coordinate box. -/
theorem bounded_box_integral_norm {k : ℕ} {f : (Fin k → ℝ) → ℂ} {R B : ℝ}
    (hf : Measurable f) (hR : 0 ≤ R)
    (hbound : ∀ x, ‖f x‖ ≤ B)
    (hsupp : ∀ x, f x ≠ 0 → ∀ i, |x i| ≤ R) :
    Integrable f ∧ (∫ x, ‖f x‖) ≤ (2 * R) ^ k * B := by
  let S := Set.Icc (fun _ : Fin k => -R) (fun _ : Fin k => R)
  have hSf : volume S ≠ ⊤ := (isCompact_Icc : IsCompact S).measure_ne_top
  have hz (x) (hx : x ∉ S) : f x = 0 := by
    by_contra hh
    exact hx ⟨fun i => (abs_le.mp (hsupp x hh i)).1,
      fun i => (abs_le.mp (hsupp x hh i)).2⟩
  obtain ⟨hfi, hb⟩ := bounded_supported_integral_norm hf.aestronglyMeasurable
    measurableSet_Icc hSf hbound hz
  have hvol : volume.real S = (2 * R) ^ k := by
    change (volume S).toReal = _
    rw [Real.volume_Icc_pi_toReal (fun i => by linarith only [hR])]
    simp [sub_neg_eq_add, ← two_mul]
  change (∫ x, ‖f x‖) ≤ volume.real S * B at hb
  exact ⟨hfi, by simpa only [hvol] using hb⟩

/-- Explicit defect constant in the chart return estimate. -/
noncomputable def chartReturnErrorConstant (c₀ d : ℕ) (H : ℝ) : ℝ :=
  (2 * (2 * H + 3) ^ d) *
    (H ^ (4 * c₀) * (2 : ℝ) ^ (2 * c₀) +
      H ^ c₀ * (2 * Real.pi * (d : ℝ) ^ 2 * H * H))

/-- The localization constant includes the volume of the enlarged fixed box. -/
noncomputable def localizedReturnErrorConstant (c₀ d k : ℕ) (H R : ℝ) : ℝ :=
  (1 + (2 * (R + 1)) ^ k) *
    (H * ((2 * H + 3) ^ d * H ^ c₀) + H * chartReturnErrorConstant c₀ d H)

/-- Blueprint eq:return: the genuine localized error is integrable and its
L1 norm plus every pointwise norm is bounded linearly in the return size.
The constant has no dependence on the unrestricted velocity or phase. -/
theorem localized_multivariableChart_return_error {k d c₀ : ℕ} {H R : ℝ}
    {A : MultivariableQuadraticChartData k d}
    (hA : MultivariableQuadraticChartComplexity c₀ H A) (hc : 1 ≤ c₀)
    (θ : (Fin k → ℝ) → ℂ) (hθm : Measurable θ) (hR : 0 ≤ R)
    (hθ : ∀ z, ‖θ z‖ ≤ H)
    (hθLip : ∀ x y, ‖θ y - θ x‖ ≤ H * ‖y - x‖)
    (hθsupp : ∀ z, θ z ≠ 0 → ∀ i, |z i| ≤ R)
    (h : Fin k → ℝ) (hh : ‖h‖ ≤ 1) (m : Fin d → ℤ)
    (hint : ∀ i j, ∃ q : ℤ, (q : ℝ) = (m i : ℝ) * (A.matrix i j : ℝ)) :
    let e := A.horizontal.mulVec h - fun i => (m i : ℝ)
    let C := A.matrix.map (fun q => (q : ℝ))
    let ω := (2 • A.quadratic + A.horizontal.transpose * C * A.horizontal).mulVec h -
      (A.horizontal.transpose * (C - C.transpose)).mulVec (fun i => (m i : ℝ))
    let c := dotProduct h (A.quadratic.mulVec h) + dotProduct A.linear h +
      chartMatrixPhase A.matrix (A.horizontal.mulVec h) e
    let E := fun z => θ (z + h) * multivariableQuadraticChartAtom A (z + h) -
      (Real.fourierChar (c + dotProduct z ω) : ℂ) * (θ z * multivariableQuadraticChartAtom A z)
    Integrable E ∧ ∀ z, (∫ x, ‖E x‖) + ‖E z‖ ≤
      localizedReturnErrorConstant c₀ d k H R * (‖h‖ + ‖e‖) := by
  intro e C ω c E
  have hH := (quadraticChartComplexity_parameter_pos hA).le
  let K := H * ((2 * H + 3) ^ d * H ^ c₀) + H * chartReturnErrorConstant c₀ d H
  have hD : 0 ≤ chartReturnErrorConstant c₀ d H := by
    unfold chartReturnErrorConstant
    positivity
  have hEm : Measurable E := by
    have hQm := multivariableQuadraticChartAtom_measurable A
    dsimp [E]
    apply Measurable.sub
    · exact (hθm.comp (by fun_prop)).mul (hQm.comp (by fun_prop))
    · apply Measurable.mul
      · unfold dotProduct
        fun_prop
      · exact hθm.mul hQm
  have hEb (z) : ‖E z‖ ≤ K * (‖h‖ + ‖e‖) := by
    exact localized_modulation_error θ (multivariableQuadraticChartAtom A) z h
      (Real.fourierChar (c + dotProduct z ω)) hH hH (by positivity) hD (norm_nonneg e)
      (hθ z) (by simpa only [add_sub_cancel_left] using hθLip z (z + h))
      (multivariableQuadraticChart_norm_le hA (z + h))
      (multivariableQuadraticChart_return_error hA hc z h m hint)
  have hEs (z) (hz : E z ≠ 0) : ∀ i, |z i| ≤ R + 1 := by
    intro i
    by_cases hθz : θ z = 0
    · have hθzh : θ (z + h) ≠ 0 := by
        intro hh0
        exact hz (by simp [E, hθz, hh0])
      have hi0 : |h i| ≤ ‖h‖ := by
        simpa only [Real.norm_eq_abs] using norm_le_pi_norm h i
      have hi : |h i| ≤ 1 := hi0.trans hh
      have hz' : z i = (z + h) i - h i := by simp
      rw [hz']
      exact (abs_sub _ _).trans (add_le_add (hθsupp (z + h) hθzh i) hi)
    · exact (hθsupp z hθz i).trans (by linarith)
  obtain ⟨hEi, hEL⟩ := bounded_box_integral_norm hEm (by positivity) hEb hEs
  refine ⟨hEi, ?_⟩
  intro z
  calc
    _ ≤ (2 * (R + 1)) ^ k * (K * (‖h‖ + ‖e‖)) + K * (‖h‖ + ‖e‖) :=
      add_le_add hEL (hEb z)
    _ = _ := by dsimp [localizedReturnErrorConstant, K]; ring

/-- A bounded box-supported function has explicit L2 mass and first-moment
bounds, as needed before the Weyl Fourier argument. -/
theorem bounded_box_L2_and_moment {k : ℕ} {f : (Fin k → ℝ) → ℂ} {R B : ℝ}
    (hf : Measurable f) (hR : 0 ≤ R) (hB : 0 ≤ B)
    (hbound : ∀ x, ‖f x‖ ≤ B)
    (hsupp : ∀ x, f x ≠ 0 → ∀ i, |x i| ≤ R) :
    MemLp f 2 ∧ (∫ x, ‖f x‖ ^ 2) ≤ (2 * R) ^ k * B ^ 2 ∧
      Integrable (fun x => ‖x‖ * ‖f x‖) ∧
      (∫ x, ‖x‖ * ‖f x‖) ≤ (2 * R) ^ k * R * B := by
  obtain ⟨hfi, hL1⟩ := bounded_box_integral_norm hf hR hbound hsupp
  have hsq (x) : ‖f x‖ ^ 2 ≤ B * ‖f x‖ := by
    simpa only [pow_two] using mul_le_mul_of_nonneg_right (hbound x) (norm_nonneg (f x))
  have hsqi : Integrable (fun x => ‖f x‖ ^ 2) :=
    (hfi.norm.const_mul B).mono' (by fun_prop) (Filter.Eventually.of_forall fun x => by
      simpa only [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg ‖f x‖)] using hsq x)
  have hmoment (x) : ‖x‖ * ‖f x‖ ≤ R * ‖f x‖ := by
    by_cases hz : f x = 0
    · simp [hz]
    have hx : ‖x‖ ≤ R := (pi_norm_le_iff_of_nonneg hR).mpr
      (fun i => by simpa only [Real.norm_eq_abs] using hsupp x hz i)
    exact mul_le_mul_of_nonneg_right hx (norm_nonneg _)
  have hmi : Integrable (fun x => ‖x‖ * ‖f x‖) :=
    (hfi.norm.const_mul R).mono' (by fun_prop) (Filter.Eventually.of_forall fun x => by
      simpa only [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (norm_nonneg x) (norm_nonneg (f x)))]
        using hmoment x)
  refine ⟨(memLp_two_iff_integrable_sq_norm hf.aestronglyMeasurable).mpr hsqi, ?_, hmi, ?_⟩
  · calc
      _ ≤ ∫ x, B * ‖f x‖ := integral_mono hsqi (hfi.norm.const_mul B) hsq
      _ = B * ∫ x, ‖f x‖ := integral_const_mul _ _
      _ ≤ B * ((2 * R) ^ k * B) := mul_le_mul_of_nonneg_left hL1 hB
      _ = _ := by ring
  · calc
      _ ≤ ∫ x, R * ‖f x‖ := integral_mono hmi (hfi.norm.const_mul R) hmoment
      _ = R * ∫ x, ‖f x‖ := integral_const_mul _ _
      _ ≤ R * ((2 * R) ^ k * B) := mul_le_mul_of_nonneg_left hL1 hR
      _ = _ := by ring

/-- All analytic size assumptions on F=θQ in the Weyl proof follow from the
actual chart complexity and the fixed support box of θ. -/
theorem localized_multivariableChart_size {k d c₀ : ℕ} {H R : ℝ}
    {A : MultivariableQuadraticChartData k d}
    (hA : MultivariableQuadraticChartComplexity c₀ H A)
    (θ : (Fin k → ℝ) → ℂ) (hθm : Measurable θ) (hR : 0 ≤ R)
    (hθ : ∀ z, ‖θ z‖ ≤ H)
    (hθsupp : ∀ z, θ z ≠ 0 → ∀ i, |z i| ≤ R) :
    let F := fun z => θ z * multivariableQuadraticChartAtom A z
    let B := H * ((2 * H + 3) ^ d * H ^ c₀)
    Measurable F ∧ (∀ z, ‖F z‖ ≤ B) ∧
      (∀ z, F z ≠ 0 → ∀ i, |z i| ≤ R) ∧
      Integrable F ∧ (∫ z, ‖F z‖) ≤ (2 * R) ^ k * B ∧
      MemLp F 2 ∧ (∫ z, ‖F z‖ ^ 2) ≤ (2 * R) ^ k * B ^ 2 ∧
      Integrable (fun z => ‖z‖ * ‖F z‖) ∧
      (∫ z, ‖z‖ * ‖F z‖) ≤ (2 * R) ^ k * R * B := by
  intro F B
  have hH := (quadraticChartComplexity_parameter_pos hA).le
  have hm : Measurable F := hθm.mul (multivariableQuadraticChartAtom_measurable A)
  have hb (z) : ‖F z‖ ≤ B := by
    exact (norm_mul _ _).le.trans
      (mul_le_mul (hθ z) (multivariableQuadraticChart_norm_le hA z) (norm_nonneg _) hH)
  have hs (z) (hz : F z ≠ 0) : ∀ i, |z i| ≤ R :=
    hθsupp z (mul_ne_zero_iff.mp hz).1
  obtain ⟨hi, hL1⟩ := bounded_box_integral_norm hm hR hb hs
  obtain ⟨hL2, hsq, hmi, hmb⟩ := bounded_box_L2_and_moment hm hR (by dsimp [B]; positivity) hb hs
  exact ⟨hm, hb, hs, hi, hL1, hL2, hsq, hmi, hmb⟩

/-- Coordinate sup norm and Euclidean norm comparisons, including dimension zero. -/
theorem euclidean_norm_le_dimension_mul_pi_norm {k : ℕ} (x : Fin k → ℝ) :
    ‖WithLp.toLp 2 x‖ ≤ (k : ℝ) * ‖x‖ := by
  calc
    _ ≤ ∑ i, ‖x i‖ := euclidean_norm_le_sum_coordinates _
    _ ≤ ∑ _i : Fin k, ‖x‖ := Finset.sum_le_sum fun i _ => norm_le_pi_norm x i
    _ = _ := by simp

/-- Passing from coordinate functions to Euclidean space preserves volume and
costs at most the dimension in the first absolute moment. -/
theorem coordinate_lift_first_moment {k : ℕ} {f : (Fin k → ℝ) → ℂ}
    (hf : Measurable f) (hm : Integrable (fun x => ‖x‖ * ‖f x‖)) :
    Integrable (fun x : EuclideanSpace ℝ (Fin k) => ‖x‖ * ‖f x.ofLp‖) ∧
      (∫ x : EuclideanSpace ℝ (Fin k), ‖x‖ * ‖f x.ofLp‖) ≤
        (k : ℝ) * ∫ x : Fin k → ℝ, ‖x‖ * ‖f x‖ := by
  have hp : MeasurePreserving (fun x : EuclideanSpace ℝ (Fin k) => x.ofLp) := by
    convert! PiLp.volume_preserving_ofLp (Fin k)
  let g := fun x : EuclideanSpace ℝ (Fin k) => (k : ℝ) * (‖x.ofLp‖ * ‖f x.ofLp‖)
  have hgi : Integrable g :=
    (hp.integrable_comp_of_integrable hm).const_mul (k : ℝ)
  have hb (x : EuclideanSpace ℝ (Fin k)) : ‖x‖ * ‖f x.ofLp‖ ≤ g x := by
    have hh := euclidean_norm_le_dimension_mul_pi_norm x.ofLp
    have ht := mul_le_mul_of_nonneg_right hh (norm_nonneg (f x.ofLp))
    simpa only [WithLp.toLp_ofLp, mul_assoc] using ht
  have hfi : Integrable (fun x : EuclideanSpace ℝ (Fin k) => ‖x‖ * ‖f x.ofLp‖) := by
    apply hgi.mono' (by fun_prop)
    exact Filter.Eventually.of_forall fun x => by
      simpa only [Real.norm_eq_abs,
        abs_of_nonneg (mul_nonneg (norm_nonneg x) (norm_nonneg (f x.ofLp)))] using hb x
  refine ⟨hfi, (integral_mono hfi hgi hb).trans_eq ?_⟩
  rw [show g = fun x : EuclideanSpace ℝ (Fin k) =>
      (k : ℝ) * (‖x.ofLp‖ * ‖f x.ofLp‖) from rfl, integral_const_mul]
  congr 1
  convert! hp.integral_comp
    (MeasurableEquiv.toLp 2 (Fin k → ℝ)).symm.measurableEmbedding
    (fun x : Fin k → ℝ => ‖x‖ * ‖f x‖)

/-- The analytic input to the Weyl argument on Euclidean space, with the
standard Lebesgue measure and the Euclidean first absolute moment. -/
theorem localized_multivariableChart_euclidean_size {k d c₀ : ℕ} {H R : ℝ}
    {A : MultivariableQuadraticChartData k d}
    (hA : MultivariableQuadraticChartComplexity c₀ H A)
    (θ : (Fin k → ℝ) → ℂ) (hθm : Measurable θ) (hR : 0 ≤ R)
    (hθ : ∀ z, ‖θ z‖ ≤ H)
    (hθsupp : ∀ z, θ z ≠ 0 → ∀ i, |z i| ≤ R) :
    let F := fun z : EuclideanSpace ℝ (Fin k) =>
      θ z.ofLp * multivariableQuadraticChartAtom A z.ofLp
    let B := H * ((2 * H + 3) ^ d * H ^ c₀)
    Measurable F ∧ (∀ z, ‖F z‖ ≤ B) ∧
      Integrable F ∧ (∫ z, ‖F z‖) ≤ (2 * R) ^ k * B ∧
      MemLp F 2 ∧ (∫ z, ‖F z‖ ^ 2) ≤ (2 * R) ^ k * B ^ 2 ∧
      Integrable (fun z => ‖z‖ * ‖F z‖) ∧
      (∫ z, ‖z‖ * ‖F z‖) ≤ (k : ℝ) * ((2 * R) ^ k * R * B) := by
  intro F B
  let f := fun z => θ z * multivariableQuadraticChartAtom A z
  obtain ⟨hfm, hfb, _, hfi, hL1, hL2, hsq, hmi, hmb⟩ :=
    localized_multivariableChart_size hA θ hθm hR hθ hθsupp
  have hp : MeasurePreserving (fun x : EuclideanSpace ℝ (Fin k) => x.ofLp) := by
    convert! PiLp.volume_preserving_ofLp (Fin k)
  have he (g : (Fin k → ℝ) → ℝ) :
      (∫ z : EuclideanSpace ℝ (Fin k), g z.ofLp) = ∫ z : Fin k → ℝ, g z :=
    by convert! hp.integral_comp
        (MeasurableEquiv.toLp 2 (Fin k → ℝ)).symm.measurableEmbedding g
  obtain ⟨hFm, hFM⟩ := coordinate_lift_first_moment hfm hmi
  refine ⟨hfm.comp hp.measurable, fun z => hfb z.ofLp, hp.integrable_comp_of_integrable hfi,
    ?_, hL2.comp_measurePreserving hp, ?_, hFm, ?_⟩
  · change (∫ z : EuclideanSpace ℝ (Fin k), ‖f z.ofLp‖) ≤ _
    rw [he (fun z => ‖f z‖)]
    exact hL1
  · change (∫ z : EuclideanSpace ℝ (Fin k), ‖f z.ofLp‖ ^ 2) ≤ _
    rw [he (fun z => ‖f z‖ ^ 2)]
    exact hsq
  · exact hFM.trans (mul_le_mul_of_nonneg_left hmb (Nat.cast_nonneg k))

/-- The localized chart Fourier transform is quantitatively Lipschitz,
without any bound on its unrestricted horizontal or quadratic parameters. -/
theorem localized_multivariableChart_fourier_lipschitz {k d c₀ : ℕ} {H R : ℝ}
    {A : MultivariableQuadraticChartData k d}
    (hA : MultivariableQuadraticChartComplexity c₀ H A)
    (θ : (Fin k → ℝ) → ℂ) (hθm : Measurable θ) (hR : 0 ≤ R)
    (hθ : ∀ z, ‖θ z‖ ≤ H)
    (hθsupp : ∀ z, θ z ≠ 0 → ∀ i, |z i| ≤ R)
    (ξ η : EuclideanSpace ℝ (Fin k)) :
    let F := fun z : EuclideanSpace ℝ (Fin k) =>
      θ z.ofLp * multivariableQuadraticChartAtom A z.ofLp
    ‖𝓕 F ξ - 𝓕 F η‖ ≤
      (2 * Real.pi * ((k : ℝ) *
        ((2 * R) ^ k * R * (H * ((2 * H + 3) ^ d * H ^ c₀))))) * ‖ξ - η‖ := by
  intro F
  obtain ⟨_, _, hi, _, _, _, hmi, hmb⟩ :=
    localized_multivariableChart_euclidean_size hA θ hθm hR hθ hθsupp
  exact (fourier_first_moment_lipschitz hi hmi ξ η).trans
    (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left hmb (by positivity)) (norm_nonneg _))

/-- The actual chart return error propagates Fourier magnitude by one return
frequency. This is the quantitative input for the multiple-return argument. -/
theorem localized_multivariableChart_fourier_return_lower {k d c₀ : ℕ} {H R : ℝ}
    {A : MultivariableQuadraticChartData k d}
    (hA : MultivariableQuadraticChartComplexity c₀ H A) (hc : 1 ≤ c₀)
    (θ : (Fin k → ℝ) → ℂ) (hθm : Measurable θ) (hR : 0 ≤ R)
    (hθ : ∀ z, ‖θ z‖ ≤ H)
    (hθLip : ∀ x y, ‖θ y - θ x‖ ≤ H * ‖y - x‖)
    (hθsupp : ∀ z, θ z ≠ 0 → ∀ i, |z i| ≤ R)
    (h : Fin k → ℝ) (hh : ‖h‖ ≤ 1) (m : Fin d → ℤ)
    (hint : ∀ i j, ∃ q : ℤ, (q : ℝ) = (m i : ℝ) * (A.matrix i j : ℝ))
    (ξ : EuclideanSpace ℝ (Fin k)) :
    let e := A.horizontal.mulVec h - fun i => (m i : ℝ)
    let C := A.matrix.map (fun q => (q : ℝ))
    let ω := (2 • A.quadratic + A.horizontal.transpose * C * A.horizontal).mulVec h -
      (A.horizontal.transpose * (C - C.transpose)).mulVec (fun i => (m i : ℝ))
    let F := fun z : EuclideanSpace ℝ (Fin k) =>
      θ z.ofLp * multivariableQuadraticChartAtom A z.ofLp
    ‖𝓕 F ξ‖ - localizedReturnErrorConstant c₀ d k H R * (‖h‖ + ‖e‖) ≤
      ‖𝓕 F (ξ - WithLp.toLp 2 ω)‖ := by
  intro e C ω F
  let c := dotProduct h (A.quadratic.mulVec h) + dotProduct A.linear h +
    chartMatrixPhase A.matrix (A.horizontal.mulVec h) e
  let E := fun z => θ (z + h) * multivariableQuadraticChartAtom A (z + h) -
    (Real.fourierChar (c + dotProduct z ω) : ℂ) * (θ z * multivariableQuadraticChartAtom A z)
  obtain ⟨_, herror⟩ :=
    localized_multivariableChart_return_error hA hc θ hθm hR hθ hθLip hθsupp h hh m hint
  have hEL : (∫ z, ‖E z‖) ≤ localizedReturnErrorConstant c₀ d k H R * (‖h‖ + ‖e‖) := by
    have hb := herror 0
    have hz := norm_nonneg (E 0)
    change (∫ z, ‖E z‖) + ‖E 0‖ ≤ _ at hb
    linarith only [hb, hz]
  obtain ⟨_, _, hFi, _, _, _, _, _⟩ :=
    localized_multivariableChart_euclidean_size hA θ hθm hR hθ hθsupp
  have hpair (z : EuclideanSpace ℝ (Fin k)) :
      inner ℝ z (WithLp.toLp 2 ω) = dotProduct z.ofLp ω := by
    simp only [EuclideanSpace.inner_eq_star_dotProduct, star_trivial,
      dotProduct_comm]
  have he : (fun z : EuclideanSpace ℝ (Fin k) => F (z + WithLp.toLp 2 h) -
      (Real.fourierChar (c + inner ℝ z (WithLp.toLp 2 ω)) : ℂ) * F z) =
      fun z => E z.ofLp := by
    funext z
    rw [hpair]
    rfl
  have hp : MeasurePreserving (fun z : EuclideanSpace ℝ (Fin k) => z.ofLp) := by
    convert! PiLp.volume_preserving_ofLp (Fin k)
  have hmeasure : (∫ z : EuclideanSpace ℝ (Fin k), ‖E z.ofLp‖) = ∫ z, ‖E z‖ := by
    convert! hp.integral_comp
      (MeasurableEquiv.toLp 2 (Fin k → ℝ)).symm.measurableEmbedding (fun z => ‖E z‖)
  have hhF := fourier_return_lower hFi (WithLp.toLp 2 h) (WithLp.toLp 2 ω) ξ c
  change ‖𝓕 F ξ‖ - (∫ z, ‖F (z + WithLp.toLp 2 h) -
    (Real.fourierChar (c + inner ℝ z (WithLp.toLp 2 ω)) : ℂ) * F z‖) ≤ _ at hhF
  have hfun : (fun z : EuclideanSpace ℝ (Fin k) => ‖F (z + WithLp.toLp 2 h) -
      (Real.fourierChar (c + inner ℝ z (WithLp.toLp 2 ω)) : ℂ) * F z‖) =
      fun z => ‖E z.ofLp‖ := congrArg (fun f => fun z => ‖f z‖) he
  rw [hfun, hmeasure] at hhF
  linarith only [hhF, hEL]

/-- The source progression of large Fourier values follows by iterating the
verified one-return estimate; no new return hypotheses are assumed. -/
theorem localized_multivariableChart_fourier_progression {k d c₀ : ℕ} {H R : ℝ}
    {A : MultivariableQuadraticChartData k d}
    (hA : MultivariableQuadraticChartComplexity c₀ H A) (hc : 1 ≤ c₀)
    (θ : (Fin k → ℝ) → ℂ) (hθm : Measurable θ) (hR : 0 ≤ R)
    (hθ : ∀ z, ‖θ z‖ ≤ H)
    (hθLip : ∀ x y, ‖θ y - θ x‖ ≤ H * ‖y - x‖)
    (hθsupp : ∀ z, θ z ≠ 0 → ∀ i, |z i| ≤ R)
    (h : Fin k → ℝ) (hh : ‖h‖ ≤ 1) (m : Fin d → ℤ)
    (hint : ∀ i j, ∃ q : ℤ, (q : ℝ) = (m i : ℝ) * (A.matrix i j : ℝ))
    (ξ : EuclideanSpace ℝ (Fin k)) (j : ℕ) :
    let e := A.horizontal.mulVec h - fun i => (m i : ℝ)
    let C := A.matrix.map (fun q => (q : ℝ))
    let ω := (2 • A.quadratic + A.horizontal.transpose * C * A.horizontal).mulVec h -
      (A.horizontal.transpose * (C - C.transpose)).mulVec (fun i => (m i : ℝ))
    let F := fun z : EuclideanSpace ℝ (Fin k) =>
      θ z.ofLp * multivariableQuadraticChartAtom A z.ofLp
    ‖𝓕 F ξ‖ - (j : ℝ) *
      (localizedReturnErrorConstant c₀ d k H R * (‖h‖ + ‖e‖)) ≤
        ‖𝓕 F (ξ - j • WithLp.toLp 2 ω)‖ := by
  intro e C ω F
  exact fourier_progression_lower (𝓕 F) (WithLp.toLp 2 ω)
    (localizedReturnErrorConstant c₀ d k H R * (‖h‖ + ‖e‖))
    (fun η => localized_multivariableChart_fourier_return_lower
      hA hc θ hθm hR hθ hθLip hθsupp h hh m hint η) ξ j

end TrilinearHT.Auto

end


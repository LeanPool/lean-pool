open Classical in
/-- The vertex of an original column is the same at every cell of the setup below a cell where
the column is available: its admission cell is its shallowest available ancestor. -/
theorem vtxAt_eq_of_sub {I J : ℤ × ℤ} (hI : I ∈ A.cells) (hJ : J ∈ A.cells)
    (hJI : dyadicGridCell A.G J.1 J.2 ⊆ dyadicGridCell A.G I.1 I.2) {x : bf.Lab}
    (hx : bf.occAvail I x) : bf.vtxAt J x = bf.vtxAt I x := by
  unfold vtxAt
  rw [dite_eq_left hJ, dite_eq_left hI]
  congr 1
  set CI : AdmCell A.G A.R A.treeDepth := ⟨I, A.cells_mem_tree hI⟩
  have hCI : CI ∈ admAnc (G := A.G) (R := A.R) (N := A.treeDepth) bf.occAvail CI x :=
    (mem_admAnc bf.occAvail).mpr ⟨subset_rfl, hx⟩
  obtain ⟨h1, h2⟩ := admCellOf_spec bf.occAvail ⟨CI, hCI⟩
  refine admCellOf_eq bf.occAvail ?_ ?_
  · obtain ⟨hsub, hav⟩ := (mem_admAnc bf.occAvail).mp h1
    exact (mem_admAnc bf.occAvail).mpr ⟨hJI.trans hsub, hav⟩
  · intro J' hJ'
    obtain ⟨hsub', hav'⟩ := (mem_admAnc bf.occAvail).mp hJ'
    rcases le_total J'.1.1 I.1 with hle | hle
    · rcases dyadicGridCell_nested_or_disjoint_of_le A.G hle J'.1.2 I.2 with hd | hs
      · exact absurd (hsub' (dyadicGridCell_left_mem A.G J.1 J.2))
          (Set.disjoint_right.mp hd (hJI (dyadicGridCell_left_mem A.G J.1 J.2)))
      · exact h2 J' ((mem_admAnc bf.occAvail).mpr ⟨hs, hav'⟩)
    · exact (h2 CI hCI).trans hle

/-- The tag of a main label is the same at every cell of the setup below a cell where it is a
main label. -/
theorem labelTag_eq_of_sub (l : Fin 4) {Mc : ℕ} (s : List (CatCol bf.Vtx)) (d : bf.Vtx)
    {I J : ℤ × ℤ} (hI : I ∈ A.cells) (hJ : J ∈ A.cells)
    (hJI : dyadicGridCell A.G J.1 J.2 ⊆ dyadicGridCell A.G I.1 I.2) {r : ℕ}
    {v : bf.Lab ⊕ Fin Mc} (hv : v ∈ mainLabels A.G Mc (bf.origCols l) s I r) :
    labelTag (bf.origCols l) s J d v = labelTag (bf.origCols l) s I d v := by
  rcases v with x | n
  · have hav : (bf.origCols l).avail I x := mem_mainLabels.mp hv
    exact bf.vtxAt_eq_of_sub hI hJ hJI hav.2
  · rfl

open Classical in
/-- At most eight column budgets of original columns and the template path count of main labels
occur at the cells of the setup containing a point. -/
theorem card_pathLabels_le (l : Fin 4) {Mc : ℕ} (s : List (CatCol bf.Vtx)) (r : ℕ) (y : ℝ) :
    (((Finset.univ : Finset (bf.Lab ⊕ Fin Mc)).filter fun v =>
      ∃ I ∈ A.cells, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        v ∈ mainLabels A.G Mc (bf.origCols l) s I r).card : ℝ) ≤
      8 * A.colBudget + bf.tmplPath s y := by
  set X : Finset bf.Lab := Finset.univ.filter fun x =>
    ∃ I ∈ A.cells, y ∈ dyadicGridCell A.G I.1 I.2 ∧ (bf.origCols l).avail I x
  set Y : Finset (Fin Mc) := Finset.univ.filter fun n =>
    ∃ h : (n : ℕ) < s.length, y ∈ dyadicGridCell A.G (s[(n : ℕ)]).birth.1 (s[(n : ℕ)]).birth.2
  have hsub : ((Finset.univ : Finset (bf.Lab ⊕ Fin Mc)).filter fun v =>
      ∃ I ∈ A.cells, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        v ∈ mainLabels A.G Mc (bf.origCols l) s I r) ⊆ X.disjSum Y := by
    rintro (x | n) hv
    · obtain ⟨-, I, hI, hy, hm⟩ := Finset.mem_filter.mp hv
      exact Finset.inl_mem_disjSum.mpr
        (Finset.mem_filter.mpr ⟨Finset.mem_univ _, I, hI, hy, mem_mainLabels.mp hm⟩)
    · obtain ⟨-, I, hI, hy, hm⟩ := Finset.mem_filter.mp hv
      obtain ⟨hn, hIb, -⟩ := (mem_mainLabels.mp hm :
        ∃ hn : (n : ℕ) < s.length, dyadicGridCell A.G I.1 I.2 ⊆
          dyadicGridCell A.G (s[(n : ℕ)]).birth.1 (s[(n : ℕ)]).birth.2 ∧ (s[(n : ℕ)]).rank ≤ r)
      exact Finset.inr_mem_disjSum.mpr (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hn, hIb hy⟩)
  have hY : Y.card ≤ bf.tmplPath s y := by
    unfold tmplPath
    refine Finset.card_le_card_of_injOn (fun n => (n : ℕ)) (fun n hn => ?_)
      (fun n _ n' _ h => Fin.ext h)
    obtain ⟨-, h, hy⟩ := Finset.mem_filter.mp hn
    exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr h, h, hy⟩
  set T : Finset (Σ lj : Fin 4 × Fin 2, (bf.P lj.1 lj.2).V) := Finset.univ.sigma fun lj =>
    Finset.univ.filter fun w : (bf.P lj.1 lj.2).V =>
      y ∈ dyadicGridCell A.G ((bf.P lj.1 lj.2).Ψ.D.birth w).1 ((bf.P lj.1 lj.2).Ψ.D.birth w).2
  have hX : X.card ≤ T.card := by
    refine Finset.card_le_card_of_injOn
      (fun x => (⟨(x.1, x.2.1), x.2.2⟩ : Σ lj : Fin 4 × Fin 2, (bf.P lj.1 lj.2).V))
      (fun x hx => ?_) (fun x _ x' _ h => ?_)
    · obtain ⟨-, I, hI, hy, -, hIc, hlab⟩ := Finset.mem_filter.mp hx
      obtain ⟨hID, -, -⟩ := bf.charts x.1 x.2.1 I hI
      have hav := (bf.P x.1 x.2.1).Ψ.A.available I hID x.2.2 hlab
      rw [(bf.P x.1 x.2.1).grid] at hav
      exact Finset.mem_sigma.mpr ⟨Finset.mem_univ _, Finset.mem_filter.mpr
        ⟨Finset.mem_univ _, hav hy⟩⟩
    · obtain ⟨l₁, j₁, w₁⟩ := x
      obtain ⟨l₂, j₂, w₂⟩ := x'
      simp only [Sigma.mk.injEq, Prod.mk.injEq] at h
      obtain ⟨⟨rfl, rfl⟩, h⟩ := h
      rw [heq_eq_eq] at h
      subst h
      rfl
  have hT : (T.card : ℝ) ≤ 8 * A.colBudget := by
    rw [Finset.card_sigma]
    push_cast
    calc ∑ lj : Fin 4 × Fin 2, (((Finset.univ.filter fun w : (bf.P lj.1 lj.2).V =>
          y ∈ dyadicGridCell A.G ((bf.P lj.1 lj.2).Ψ.D.birth w).1
            ((bf.P lj.1 lj.2).Ψ.D.birth w).2).card : ℕ) : ℝ)
        ≤ ∑ _lj : Fin 4 × Fin 2, A.colBudget := by
          refine Finset.sum_le_sum fun lj _ => ?_
          have h := (bf.P lj.1 lj.2).Ψ.D.path_count y
          rw [(bf.P lj.1 lj.2).grid] at h
          exact h.trans (bf.budget lj.1 lj.2)
      _ = 8 * A.colBudget := by simp
  calc _ ≤ ((X.disjSum Y).card : ℝ) := Nat.cast_le.mpr (Finset.card_le_card hsub)
    _ = X.card + Y.card := by rw [Finset.card_disjSum]; push_cast; ring
    _ ≤ 8 * A.colBudget + bf.tmplPath s y := by
        have h1 : (X.card : ℝ) ≤ T.card := Nat.cast_le.mpr hX
        have h2 : (Y.card : ℝ) ≤ bf.tmplPath s y := Nat.cast_le.mpr hY
        linarith only [hT, h1, h2]


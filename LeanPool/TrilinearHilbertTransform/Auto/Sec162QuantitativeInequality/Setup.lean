          Real.sqrt_le_sqrt (physSq_le ((D.toLeafQ qG).sv l G I) _ _ hr)
      _ = ‖(D.toLeafQ qG).sv l G I‖ / Real.sqrt (dyadicGridLength A.G I.1) :=

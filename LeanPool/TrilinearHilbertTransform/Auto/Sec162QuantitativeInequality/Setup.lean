/-- Without alive modes of the role `l` at the decision cell of `I` there are no core components
of the role at `I`. -/
theorem compsAt_eq_empty {l : Fin 4} {G : bf.Grp} {I : ℤ × ℤ}
    (h : ¬ ((D.Ms l G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).Nonempty) :
    D.compsAt l G I = ∅ := by
  unfold compsAt
  split_ifs
  · have : IsEmpty ((D.Ms l G).alive (ancAt A.G (D.preAt I)
        (A.blkStart D.S.K I.1 - 4 * D.S.K))) := ⟨fun x => h ⟨x.1, x.2⟩⟩
    unfold ModeSystem.coreComps ModeSystem.allComps
    rw [Finset.univ_eq_empty, Finset.image_empty, Finset.empty_sdiff]
  · rfl

/-- Without alive modes of the role `l` at the decision cell of `I` the core of the role at `I`
vanishes. -/
theorem coreAt_eq_zero {l : Fin 4} {G : bf.Grp} {I : ℤ × ℤ}
    (h : ¬ ((D.Ms l G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).Nonempty) :
    D.coreAt l G I = 0 := by
  rw [D.coreAt_eq_comps, D.compsAt_eq_empty h, Finset.sum_empty]

/-- A pattern form with a core slot whose core vanishes is zero. -/
theorem form_pattern_zero (I : ℤ × ℤ) (a s e : Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc))
    (τ : Fin 4 → Fin 3) {l : Fin 4} (hτ : τ l = 0) (ha : a l = 0) :
    fp.Λc I (patternPiece a s e τ) = 0 :=
  (fp.Λc I).map_coord_zero l (by simp [patternPiece, hτ, ha])

/-- Blueprint lines 2467-2470: without anchors (some role has no alive mode at the decision cell)
the four-core pattern form vanishes. -/
theorem four_form_zero {G : bf.Grp} {I : ℤ × ℤ} (hA : ¬ D.AncNe G I)
    (s e : Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) :
    fp.Λc I (patternPiece (fun l => D.coreAt l G I) s e (fun _ => 0)) = 0 := by
  unfold AncNe at hA
  push Not at hA
  obtain ⟨j, hj⟩ := hA
  exact form_pattern_zero I _ s e _ (l := j) rfl (D.coreAt_eq_zero (by
    rw [Finset.not_nonempty_iff_eq_empty]; exact hj))

/-- Without anchors of the core roles the three-core pattern form with side role `l` vanishes. -/
theorem three_form_zero {G : bf.Grp} {I : ℤ × ℤ} {l : Fin 4} (hA : ¬ D.AncNe3 G I l)
    (s e : Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) :
    fp.Λc I (patternPiece (fun l => D.coreAt l G I) s e (fun k => if k = l then 1 else 0)) =
      0 := by
  unfold AncNe3 at hA
  push Not at hA
  obtain ⟨j, hjl, hj⟩ := hA
  exact form_pattern_zero I _ s e _ (l := j) (by simp [hjl]) (D.coreAt_eq_zero (by
    rw [Finset.not_nonempty_iff_eq_empty]; exact hj))


      ∀ κ i, ∑ G ∈ pathGroups (A := A) T gs y,
        (((D.withQ0 (qG G)).fourUsedReps G h y (pathCell A.G T y)
          (fun s => anc (pathCell A.G T y s) G) c κ
          (pathDepths (A := A) T gs y G) i).card : ℝ) ≤ K * c.2.2 i ^ (-2 : ℝ))
    (hq : 4 * (2 * D.SP.δs) ^ (1 / (4 : ℝ)) < 1)
    (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md)
    (hPB : ∀ I ∈ T, ∀ G ∈ gs I, ∀ hA : D.AncNe G I, ∀ y ∈ dyadicGridCell A.G I.1 I.2,
      ‖fp.Λc I (patternPiece (fun l => (D.withQ0 (qG G)).coreAt l G I)

/-- The single-side patterns: the side in the slot `l`, cores elsewhere. -/
def sidePat (l : Fin 4) : Fin 4 → Fin 3 := fun k => if k = l then 1 else 0

theorem sidePat_injective : Function.Injective sidePat := by
  unfold sidePat
  decide

theorem sidePat_ne_zero (l : Fin 4) : sidePat l ≠ fun _ => 0 := fun h => by
  have := congrFun h l
  simp [sidePat] at this

open Classical in
/-- The patterns with at least three cores and no error are the four-core pattern and the four
single-side patterns (`core_pattern_cases`). -/
theorem corePats_subset :
    (Finset.univ.filter fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧ 3 ≤ patternCount τ 0) ⊆
      insert (fun _ => 0) (Finset.univ.image sidePat) := by
  intro τ hτ
  obtain ⟨h2, h3⟩ := (Finset.mem_filter.mp hτ).2
  rcases core_pattern_cases τ h2 h3 with rfl | ⟨l, rfl⟩
  · exact Finset.mem_insert_self _ _
  · exact Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ (Finset.mem_univ l))

open Classical in
/-- Blueprint lines 2820-2822 (declaration `core-estimate`) on one leaf: the weighted active minimum
of the patterns with at least three cores is at most the sum of the bounds of `eq:core-final` for
the four-core pattern and the four three-core patterns (`core_final_patterns`, the triangle
inequality over the patterns and groups). -/
theorem core_leaf_patterns (Gd : RealDyadicGrid) (R : ℤ × ℤ) (T : Finset (ℤ × ℤ)) {γ : Type*}
    (gs : ℤ × ℤ → Finset γ) (F : (Fin 4 → Fin 3) → ℤ × ℤ → γ → ℂ) {η : ℝ} (hη : 0 ≤ η)
    (M4 : ℝ) (M3 : Fin 4 → ℝ) (E4 : ℤ × ℤ → ℝ) (E3 : Fin 4 → ℤ × ℤ → ℝ)
    (h4 : ∑ I ∈ T, dyadicGridLength Gd I.1 * min η (∑ g ∈ gs I, ‖F (fun _ => 0) I g‖) ≤
      η ^ (1 - (1 - (1 / 300 : ℝ) / 4)) * (dyadicGridLength Gd R.1 * M4) +
        ∑ I ∈ T, dyadicGridLength Gd I.1 * E4 I)
    (h3 : ∀ l, ∑ I ∈ T, dyadicGridLength Gd I.1 *
        min η (∑ g ∈ gs I, ‖F (fun k => if k = l then 1 else 0) I g‖) ≤
      η ^ (1 - (1 - (1 / 300 : ℝ) / 4)) * (dyadicGridLength Gd R.1 * M3 l) +
        ∑ I ∈ T, dyadicGridLength Gd I.1 * E3 l I) :
    ∑ I ∈ T, dyadicGridLength Gd I.1 * min η ‖∑ τ ∈ Finset.univ.filter
        (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧ 3 ≤ patternCount τ 0), ∑ g ∈ gs I, F τ I g‖ ≤
      η ^ (1 / 1200 : ℝ) * (dyadicGridLength Gd R.1 * (M4 + ∑ l, M3 l)) +
        ∑ I ∈ T, dyadicGridLength Gd I.1 * (E4 I + ∑ l, E3 l I) := by
  set P := Finset.univ.filter
    (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧ 3 ≤ patternCount τ 0) with hP
  set x : (Fin 4 → Fin 3) → ℤ × ℤ → ℝ := fun τ I => ∑ g ∈ gs I, ‖F τ I g‖ with hx
  have hx0 : ∀ τ I, 0 ≤ x τ I := fun τ I => Finset.sum_nonneg fun g _ => norm_nonneg _
  have hcf := core_final_patterns Gd T P x (fun τ _ I _ => hx0 τ I)
    (fun I => ‖∑ τ ∈ P, ∑ g ∈ gs I, F τ I g‖)
    (fun I _ => (norm_sum_le _ _).trans (Finset.sum_le_sum fun τ _ => norm_sum_le _ _)) hη
  set f : (Fin 4 → Fin 3) → ℝ := fun τ =>
    ∑ I ∈ T, dyadicGridLength Gd I.1 * min η (x τ I) with hf
  have hf0 : ∀ τ, 0 ≤ f τ := fun τ => Finset.sum_nonneg fun I _ =>
    mul_nonneg (dyadicGridLength_pos Gd I.1).le (le_min hη (hx0 τ I))
  have hsub : ∑ τ ∈ P, f τ ≤ f (fun _ => 0) + ∑ l, f (sidePat l) := by
    refine (Finset.sum_le_sum_of_subset_of_nonneg corePats_subset
      fun τ _ _ => hf0 τ).trans (le_of_eq ?_)
    rw [Finset.sum_insert, Finset.sum_image fun a _ b _ h => sidePat_injective h]
    intro hmem
    obtain ⟨l, -, hl⟩ := Finset.mem_image.mp hmem
    exact sidePat_ne_zero l hl
  refine hcf.trans (hsub.trans ?_)
  have e : (1 - (1 - (1 / 300 : ℝ) / 4)) = 1 / 1200 := by norm_num
  rw [e] at h4 h3
  calc f (fun _ => 0) + ∑ l, f (sidePat l)
      ≤ (η ^ (1 / 1200 : ℝ) * (dyadicGridLength Gd R.1 * M4) +
          ∑ I ∈ T, dyadicGridLength Gd I.1 * E4 I) +
        ∑ l, (η ^ (1 / 1200 : ℝ) * (dyadicGridLength Gd R.1 * M3 l) +
          ∑ I ∈ T, dyadicGridLength Gd I.1 * E3 l I) :=
        add_le_add h4 (Finset.sum_le_sum fun l _ => h3 l)
    _ = _ := by
        rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum, Finset.sum_comm]
        simp only [mul_add, Finset.mul_sum, Finset.sum_add_distrib]
        ring

open MeasureTheory in
/-- The normalized physical square of a column on an interval is at most its normalized square
norm. -/
theorem physSq_le {V : Type*} [Fintype V] (x : ColumnL2 V) (a r : ℝ) (hr : 0 < r) :
    r⁻¹ * ∫ y in a..a + r, ‖augPhys x y‖ ^ 2 ≤ (‖x‖ / Real.sqrt r) ^ 2 := by
  have hm : MemLp (augPhys x) 2 volume := memLp_column_coord x none
  have hint : Integrable (fun y => ‖augPhys x y‖ ^ 2) := hm.integrable_norm_pow two_ne_zero
  rw [div_pow, Real.sq_sqrt hr.le, div_eq_inv_mul]
  refine mul_le_mul_of_nonneg_left ?_ (inv_nonneg.mpr hr.le)
  rw [intervalIntegral.integral_of_le (by linarith only [hr])]
  refine (setIntegral_le_integral hint
    (Filter.Eventually.of_forall fun y => by positivity)).trans ?_
  have h := lintegral_augPhys_sq_le x
  rw [← ofReal_integral_eq_lintegral_ofReal hint
    (Filter.Eventually.of_forall fun y => by positivity)] at h
  exact (ENNReal.ofReal_le_ofReal_iff (sq_nonneg _)).mp h


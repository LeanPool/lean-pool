open Classical in
/-- The data of one attempt on the main columns for the pattern `p` (blueprint lines 2838-2839,
`exists_attempt`): the attempt parameters `fp` with their monotone coloring, the main catalogs
closed on the active test cells `T_c` of path multiplicity at most `M_p`, the closure counts
`K_t, n_r, T_max` at the threshold scale `τ₃` (with the helper names on `famVtxBound` base names
per cell), and the edge threshold above the graph thresholds of the helper residuals (`τ₂`) and
of the joint ball variation (`τ'`). -/
structure AttemptData (p : Fin 3) where
  /-- Catalog and coloring parameters of the basic-family attempt. -/
  fp : bf.FamParams
  /-- Chart catalog in each slot of the attempt. -/
  cat : Fin 4 → List (CatCol bf.Vtx)
  /-- Finite collection of certified cells used by the attempt. -/
  Tc : Finset (ℤ × ℤ)
  hTc : Tc ⊆ A.cells
  /-- Maximum number of certified ancestors containing a given cell. -/
  Mp : ℕ
  hMp1 : 1 ≤ Mp
  hmult : ∀ I : ℤ × ℤ, (Tc.filter fun I' : ℤ × ℤ =>
    dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G I'.1 I'.2).card ≤ Mp
  /-- Exponent in the same-tag counting bound used by the attempt. -/
  Dst : ℕ
  hst : SameTagBound κ A.csrc Dst
  /-- Positive catalog-test threshold, at most one. -/
  τ₃ : ℝ
  hτ₃ : 0 < τ₃
  hτ₃1 : τ₃ ≤ 1
  /-- Dyadic truncation parameter used by the attempt's mode expansions. -/
  Kt : ℕ
  /-- Monotone path-count budget as a function of catalog rank. -/
  n : ℕ → ℝ
  /-- Uniform upper bound for the number of catalog entries contributed at one cell. -/
  Tmax : ℕ
  hLc : fp.Lc = A.famLc
  hmH : fp.mH = 2 * A.famFuel + 2
  hMc : fp.Mc = Tc.card * Tmax + Tc.card * Tmax
  hcol : IsMonotoneColoring bf.admT (bf.tagDist fp.Hed) A.famVtxBound (A.fcb1 fp.Hmax)
    (cb2 fp.Hmax) Finset.univ (admCellSet (G := A.G) (R := A.R) (N := A.treeDepth))
    (dyadicGridCell A.G A.R.1 A.R.2) fp.ωp fp.ωh
  hKh : ∀ I, Fintype.card (fp.HelperName I (Fin A.famVtxBound)) ≤ Kt
  hn0 : 2 * A.colBudget ≤ n 0
  hgrow : ∀ r, (1 + (fp.Lc + 6) * Mp * closureRatio A.famVtxBound Kt fp.mH Tmax
    (Real.exp (Dst * (1 + Real.log A.Hsrc) ^ Dst)) τ₃) * n r ≤ n (r + 1)
  hcapH : closureRatio A.famVtxBound Kt fp.mH Tmax (Real.exp (Dst * (1 + Real.log A.Hsrc) ^ Dst))
    τ₃ * n (fp.Lc + 4) < Tmax
  hpassM : ∀ l, ∀ I ∈ Tc, ∀ w : fp.TestName I Unit,
    (fp.testOf l I (fun _ : Unit => bf.patIn fp.Mc p I l) w).Pass A.G (bf.origCols l) I
      A.csrc A.Hsrc bf.vtag (A.w I) (catThreshold A.famVtxBound τ₃ n
        (fp.testOf l I (fun _ : Unit => bf.patIn fp.Mc p I l) w).r) fp.mH (cat l)
  hT : ∀ l, ∀ e ∈ cat l, e.birth ∈ Tc ∧ e.rank ≤ fp.Lc + 5 ∧
    ∃ R ∈ residueBox (bf.vtag e.tag).dim 9, ∃ γ : ℝ,
      e = templateCol (bf.vtag e.tag) l R γ e.birth e.rank e.tag
  htag : ∀ l, ∀ e ∈ cat l, bf.occAvail e.tag.2.1 e.tag.1
  hlab : ∀ l, ∀ I, ∀ r ≤ fp.Lc + 5,
    ((mainLabels A.G fp.Mc (bf.origCols l) (cat l) I r).card : ℝ) ≤ n r
  hlen : ∀ l, (cat l).length ≤ Tc.card * Tmax
  hHedV : 18 * max A.H ActiveSetup.padW ^ 2 ≤ fp.Hed
  hHed2 : 2 ≤ fp.Hed
  hHedτ₂ : Real.exp (A.Dg * (1 + Real.log A.Hsrc +
    Real.log (τ₃ / (1 + A.colBudget * Real.sqrt (n (fp.Lc + 4)) *
      (A.colBudget * Real.sqrt (2 * A.colBudget + (1 + Mp) * n (fp.Lc + 5)))))⁻¹) ^ A.Dg) ≤
    fp.Hed
  hHedτ' : Real.exp (A.Dg * (1 + Real.log A.Hsrc +
    Real.log (1 + (⌈8 * A.colBudget + n (fp.Lc + 5)⌉₊ : ℝ) * A.colBudget ^ 2)) ^ A.Dg) ≤ fp.Hed


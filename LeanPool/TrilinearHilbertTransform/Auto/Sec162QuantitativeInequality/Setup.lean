      _ ≤ U := hUT
  have hside : ∀ y, ∑ I ∈ S₂ with y ∈ dyadicGridCell A.G I.1 I.2, ∑ G ∈ gs I,
      (D.toLeafQ qG).s2 G I ≤ D.Tside qG Lp Jm CF E cc kk Vl ρ := fun y =>

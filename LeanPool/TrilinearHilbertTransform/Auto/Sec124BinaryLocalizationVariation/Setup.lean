/-! ### Fixed stacks for the attempt histories (`eq:stack-energy`, blueprint lines 2394-2423) -/

theorem globHist_norm_le (Ψ : ColumnDepthFamily V) {P : ℕ} (hP : 0 < P)
    (Am : ℕ → Fin P → InheritedColumnMask Ψ.D) (ls : List (ℕ × Bool)) (h : ℤ) (z : ColumnL2 V) :
    ‖globHist Ψ Am ls h z‖ ≤ ‖z‖ := by
  unfold globHist
  refine norm_layerOp_apply_le _ (fun m x => ?_) (fun m x => ?_) _ _
  · exact norm_opAvg_apply_le _ (fun p y => starProjection_norm_apply_le _

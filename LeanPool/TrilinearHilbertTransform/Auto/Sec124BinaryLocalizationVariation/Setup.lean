section MaskedExpansion
variable {V : Type} [Fintype V] {Tg : Type*} {G : RealDyadicGrid} {Mc : ℕ} {O : OrigCols V Tg}

/-- The tag of a main label at a cell: the vertex of an original column, the tag of a template
(a default tag beyond the catalog). -/
noncomputable def labelTag (O : OrigCols V Tg) (s : List (CatCol Tg)) (I : ℤ × ℤ) (d : Tg) :
    V ⊕ Fin Mc → Tg :=
  Sum.elim (fun v => O.tag I v) (fun n => if h : (n : ℕ) < s.length then (s[(n : ℕ)]).tag else d)

open scoped Classical in
/-- The main labels of rank at most `r` at the cell whose tag lies in the mask `M`. -/
noncomputable def mainLabelsM (G : RealDyadicGrid) (Mc : ℕ) (O : OrigCols V Tg)
    (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) (d : Tg) : Finset (V ⊕ Fin Mc) :=
  (mainLabels G Mc O s I r).filter fun v => M (labelTag O s I d v)

theorem mem_mainLabels {s : List (CatCol Tg)} {I : ℤ × ℤ} {r : ℕ} {v : V ⊕ Fin Mc} :
    v ∈ mainLabels G Mc O s I r ↔ Sum.elim (fun v => O.avail I v) (fun n : Fin Mc =>
      ∃ hn : (n : ℕ) < s.length, dyadicGridCell G I.1 I.2 ⊆
        dyadicGridCell G (s[(n : ℕ)]).birth.1 (s[(n : ℕ)]).birth.2 ∧ (s[(n : ℕ)]).rank ≤ r) v := by
  classical
  unfold mainLabels
  rw [Finset.mem_filter]
  exact ⟨fun h => h.2, fun h => ⟨Finset.mem_univ _, h⟩⟩

theorem mem_mainLabelsM {s : List (CatCol Tg)} {I : ℤ × ℤ} {r : ℕ} {M : Tg → Prop} {d : Tg}
    {v : V ⊕ Fin Mc} :
    v ∈ mainLabelsM G Mc O s I r M d ↔
      v ∈ mainLabels G Mc O s I r ∧ M (labelTag O s I d v) := by
  classical
  unfold mainLabelsM
  exact Finset.mem_filter

theorem mainLabelsM_subset (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) (d : Tg) :
    mainLabelsM G Mc O s I r M d ⊆ mainLabels G Mc O s I r := fun _ hv =>
  (mem_mainLabelsM.mp hv).1

theorem mainLabelsM_mono (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) {M M' : Tg → Prop}
    (hM : ∀ x, M x → M' x) (d : Tg) :
    mainLabelsM G Mc O s I r M d ⊆ mainLabelsM G Mc O s I r M' d := fun _ hv =>
  mem_mainLabelsM.mpr ⟨(mem_mainLabelsM.mp hv).1, hM _ (mem_mainLabelsM.mp hv).2⟩

open scoped Classical in
/-- Every vector of a main range is a combination of the columns of the main labels of the
mask. -/
theorem mainRange_exists_coeffM {s : List (CatCol Tg)} {I : ℤ × ℤ} {r : ℕ} {M : Tg → Prop}
    (d : Tg) {x : ColumnL2 (V ⊕ Fin Mc)} (hx : x ∈ mainRange G Mc O s I r M) :
    ∃ c : V ⊕ Fin Mc → ℂ,
      x = ∑ v ∈ mainLabelsM G Mc O s I r M d, c v • mainCol G Mc O s I v := by
  refine Submodule.span_induction (R := ℂ) (M := ColumnL2 (V ⊕ Fin Mc)) (p := fun x _ =>
    ∃ c : V ⊕ Fin Mc → ℂ,
      x = ∑ v ∈ mainLabelsM G Mc O s I r M d, c v • mainCol G Mc O s I v) ?_ ?_ ?_ ?_ hx
  · rintro x (⟨v, h1, h2, rfl⟩ | ⟨n, hn, h1, h2, h3, rfl⟩)
    · refine ⟨Pi.single (Sum.inl v) (1 : ℂ), ?_⟩
      have hmem : (Sum.inl v : V ⊕ Fin Mc) ∈ mainLabelsM G Mc O s I r M d :=
        mem_mainLabelsM.mpr ⟨mem_mainLabels.mpr h1, h2⟩
      rw [Finset.sum_eq_single (Sum.inl v)]
      · simp
      · intro b _ hb; simp [hb]
      · intro h; exact absurd hmem h
    · refine ⟨Pi.single (Sum.inr n) (1 : ℂ), ?_⟩
      have hmem : (Sum.inr n : V ⊕ Fin Mc) ∈ mainLabelsM G Mc O s I r M d := by
        refine mem_mainLabelsM.mpr ⟨mem_mainLabels.mpr ⟨hn, h1, h2⟩, ?_⟩
        simp only [labelTag, Sum.elim_inr, hn, ↓reduceDIte]
        exact h3
      rw [Finset.sum_eq_single (Sum.inr n)]
      · simp
      · intro b _ hb; simp [hb]
      · intro h; exact absurd hmem h
  · exact ⟨0, by simp⟩
  · rintro x y _ _ ⟨c, rfl⟩ ⟨c', rfl⟩
    exact ⟨c + c', by simp [add_smul, Finset.sum_add_distrib]⟩
  · rintro a x _ ⟨c, rfl⟩
    exact ⟨a • c, by simp [Finset.smul_sum, smul_smul]⟩

end MaskedExpansion

namespace ActiveSetup.BasicFamilies
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} (bf : A.BasicFamilies)

/-- The groups of the attempt: a color with its complete color data. -/
abbrev Grp : Type :=
  ℕ × (Option (Fin A.fcd0 × bf.Vtx × ℤ) × ℕ × (ℕ × ℕ) × Option (Fin A.fcd0 × bf.Vtx × ℤ))

open scoped Classical in
/-- Blueprint line 1835 for an averaged main filter: the average over the pads of rank-`r`
main projections with masks `M p` inside `Mtop`, applied to an input of the slot `l`, is a
combination of the columns of the main labels of the mask `Mtop` whose coefficients have
absolute sum at most `colBudget √N ‖z‖ / √|I|`, `N` the number of these labels. -/
theorem avg_expansion (l : Fin 4) {Mc : ℕ} (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ) (r : ℕ)
    {P : ℕ} (hP : 0 < P) (M : Fin P → bf.Vtx → Prop) (Mtop : bf.Vtx → Prop)
    (hM : ∀ p x, M p x → Mtop x) (d : bf.Vtx) (z : ColumnL2 (bf.Lab ⊕ Fin Mc)) :
    ∃ c : bf.Lab ⊕ Fin Mc → ℂ,
      opAvg (fun p => mainProj A.G Mc (bf.origCols l) s I r (M p)) z =
        ∑ v ∈ mainLabelsM A.G Mc (bf.origCols l) s I r Mtop d,
          c v • mainCol A.G Mc (bf.origCols l) s I v ∧
      ∑ v ∈ mainLabelsM A.G Mc (bf.origCols l) s I r Mtop d, ‖c v‖ ≤
        A.colBudget * Real.sqrt (mainLabelsM A.G Mc (bf.origCols l) s I r Mtop d).card * ‖z‖ /
          Real.sqrt (dyadicGridLength A.G I.1) := by
  set F := mainLabelsM A.G Mc (bf.origCols l) s I r Mtop d
  have hexp := fun p : Fin P => mainRange_exists_coeffM (G := A.G) (O := bf.origCols l)
    (s := s) (I := I) (r := r) (M := M p) d (Submodule.starProjection_apply_mem _ z)
  choose c hc using hexp
  set! c' : Fin P → bf.Lab ⊕ Fin Mc → ℂ := fun p v =>
    if v ∈ mainLabelsM A.G Mc (bf.origCols l) s I r (M p) d then c p v else 0
  have hsub : ∀ p, mainLabelsM A.G Mc (bf.origCols l) s I r (M p) d ⊆ F := fun p =>
    mainLabelsM_mono s I r (hM p) d
  have hc' : ∀ p, mainProj A.G Mc (bf.origCols l) s I r (M p) z =
      ∑ v ∈ F, c' p v • mainCol A.G Mc (bf.origCols l) s I v := by
    intro p
    change (mainRange A.G Mc (bf.origCols l) s I r (M p)).starProjection z = _
    rw [hc p]
    refine Finset.sum_subset_zero_on_sdiff (hsub p) (fun v hv => ?_) (fun v hv => ?_)
    · have : v ∉ mainLabelsM A.G Mc (bf.origCols l) s I r (M p) d := (Finset.mem_sdiff.mp hv).2
      simp only [c', this, ↓reduceIte, zero_smul]
    · simp only [c', hv, ↓reduceIte]
  have hcb : (0 : ℝ) ≤ A.colBudget := by
    have := A.Dc_nonneg; unfold ActiveSetup.colBudget; positivity
  have hF : ∀ v ∈ F, v ∈ mainLabels A.G Mc (bf.origCols l) s I r := fun v hv =>
    mainLabelsM_subset s I r Mtop d hv
  have hbound : ∀ p, ∑ v ∈ F, ‖c' p v‖ ≤
      A.colBudget * Real.sqrt F.card * ‖z‖ / Real.sqrt (dyadicGridLength A.G I.1) := by
    intro p
    have h := mainCoeff_sum_le s I F (c' p) (fun v hv => bf.mainLabel_memLp l s I r (hF v hv))
      hcb (fun v _ => bf.inv_mainWeight_le l v)
    rw [← hc' p] at h
    refine h.trans ?_
    have hP' : ‖mainProj A.G Mc (bf.origCols l) s I r (M p) z‖ ≤ ‖z‖ :=
      Submodule.norm_starProjection_apply_le _ z
    have hsr : 0 < Real.sqrt (dyadicGridLength A.G I.1) :=
      Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
    rw [div_le_div_iff_of_pos_right hsr]
    calc Real.sqrt F.card * A.colBudget * ‖mainProj A.G Mc (bf.origCols l) s I r (M p) z‖
        ≤ Real.sqrt F.card * A.colBudget * ‖z‖ := mul_le_mul_of_nonneg_left hP' (by positivity)
      _ = A.colBudget * Real.sqrt F.card * ‖z‖ := by ring
  have hPr : (0 : ℝ) < P := by exact_mod_cast hP
  refine ⟨fun v => (P : ℂ)⁻¹ * ∑ p, c' p v, ?_, ?_⟩
  · unfold opAvg
    rw [smul_apply, sum_apply]
    simp only [hc']
    rw [Finset.sum_comm, Finset.smul_sum]
    refine Finset.sum_congr rfl fun v _ => ?_
    rw [← Finset.sum_smul, smul_smul]
  · calc ∑ v ∈ F, ‖(P : ℂ)⁻¹ * ∑ p, c' p v‖ ≤ ∑ v ∈ F, (P : ℝ)⁻¹ * ∑ p, ‖c' p v‖ := by
          refine Finset.sum_le_sum fun v _ => ?_
          rw [norm_mul, norm_inv, Complex.norm_natCast]
          exact mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)
      _ = (P : ℝ)⁻¹ * ∑ p, ∑ v ∈ F, ‖c' p v‖ := by
          rw [← Finset.mul_sum, Finset.sum_comm]
      _ ≤ (P : ℝ)⁻¹ * ∑ _p : Fin P, A.colBudget * Real.sqrt F.card * ‖z‖ /
            Real.sqrt (dyadicGridLength A.G I.1) :=
          mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun p _ => hbound p) (by positivity)
      _ = _ := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, ← mul_assoc,
            inv_mul_cancel₀ hPr.ne', one_mul]

/-- A main label of the mask at a cell is a pure source of its tag in the slot: an available
original column is the chart of its vertex, a template of the catalog is the chart of its
template (blueprint lines 1676, 1798). -/
theorem mainLabel_source (l : Fin 4) {Mc : ℕ} (s : List (CatCol bf.Vtx))
    (hT : ∀ e ∈ s, ∃ R ∈ residueBox (bf.vtag e.tag).dim 9, ∃ γ : ℝ,
      e = templateCol (bf.vtag e.tag) l R γ e.birth e.rank e.tag)
    (htag : ∀ e ∈ s, bf.occAvail e.tag.2.1 e.tag.1) (I : ℤ × ℤ) (r : ℕ) (M : bf.Vtx → Prop)
    (d : bf.Vtx) {v : bf.Lab ⊕ Fin Mc} (hv : v ∈ mainLabelsM A.G Mc (bf.origCols l) s I r M d) :
    M (labelTag (bf.origCols l) s I d v) ∧
      ∃ A' : QuadraticChartData (bf.vtag (labelTag (bf.origCols l) s I d v)).dim,
        QuadraticChartComplexity A.csrc A.Hsrc A' ∧ IsBoundedQuadraticChart A' ∧
        A'.horizontal = (bf.vtag (labelTag (bf.origCols l) s I d v)).θ ∧
        A'.matrix = (slotCoeff l : ℚ) • (bf.vtag (labelTag (bf.origCols l) s I d v)).C ∧
        A'.quadratic = slotCoeff l * (bf.vtag (labelTag (bf.origCols l) s I d v)).lam ∧
        ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
          augPhys (mainCol A.G Mc (bf.origCols l) s I v) y = quadraticChartAtom A' y := by
  classical
  obtain ⟨hvL, hvM⟩ := mem_mainLabelsM.mp hv
  refine ⟨hvM, ?_⟩
  have hmem := bf.mainLabel_memLp l s I r hvL
  have hphys : ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
      augPhys (mainCol A.G Mc (bf.origCols l) s I v) y = mainScalar Mc (bf.origCols l) s v y := by
    filter_upwards [wColumn_coeFn hmem] with y hy hyI
    simp only [augPhys, mainCol]
    rw [hy, Set.indicator_of_mem hyI, privateColumnValue_physical]
  rcases v with x | n
  · have hvL' : (bf.origCols l).avail I x := mem_mainLabels.mp hvL
    obtain ⟨hc, hb, hθ, hM, hq, he⟩ := bf.origCol_source l hvL'
    refine ⟨(bf.vchart (bf.vtxAt I x)).2, hc, hb, hθ, hM, hq, ?_⟩
    filter_upwards [hphys] with y hy hyI
    rw [hy hyI]
    exact he y hyI
  · obtain ⟨hn, -, -⟩ := (mem_mainLabels.mp hvL : ∃ hn : (n : ℕ) < s.length, _)
    set! e := s[(n : ℕ)]
    have he : e ∈ s := List.getElem_mem _
    obtain ⟨R, hR, γ, hde⟩ := hT e he
    have htg : labelTag (bf.origCols l) s I d (Sum.inr n : bf.Lab ⊕ Fin Mc) = e.tag := by
      simp only [labelTag, Sum.elim_inr, hn, ↓reduceDIte]; rfl
    rw [htg]
    obtain ⟨A', hA', hθ, hM, hq, hatom⟩ := bf.templateCol_source (htag e he) l hR γ e.birth e.rank
    have hatom' : e.atom = quadraticChartAtom A' := by
      rw [← hatom]; exact congrArg CatCol.atom hde
    refine ⟨A', hA', fun y => by rw [← hatom']; exact e.bound y, hθ, hM, hq, ?_⟩
    filter_upwards [hphys] with y hy hyI
    rw [hy hyI]
    simp only [mainScalar, Sum.elim_inr, catAtom, hn, ↓reduceDIte]
    exact congrFun hatom' y


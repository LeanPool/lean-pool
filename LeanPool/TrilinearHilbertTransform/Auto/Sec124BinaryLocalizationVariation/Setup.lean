variable {V : Type*} [Fintype V]

theorem columnL2Restriction_comp_disjoint {s t : Set ℝ} (hs : MeasurableSet s)
    (ht : MeasurableSet t) (hst : Disjoint s t) :
    (columnL2Restriction (V := V) s hs).comp (columnL2Restriction t ht) = 0 := by
  refine ContinuousLinearMap.ext fun w => Lp.ext ?_
  simp only [ContinuousLinearMap.comp_apply, zero_apply]
  change (columnL2Indicator s hs (columnL2Indicator t ht w) : ℝ → ColumnHilbert V) =ᵐ[volume] _
  filter_upwards [columnL2Indicator_coeFn s hs (columnL2Indicator t ht w),
    columnL2Indicator_coeFn t ht w, Lp.coeFn_zero (ColumnHilbert V) 2 volume] with y h1 h2 h3
  rw [h1, h3]
  by_cases hy : y ∈ s
  · rw [Set.indicator_of_mem hy, h2, Set.indicator_of_notMem (Set.disjoint_left.mp hst hy)]
    rfl
  · rw [Set.indicator_of_notMem hy]; rfl

theorem columnL2Restriction_comp_of_subset' {s t : Set ℝ} (hs : MeasurableSet s)
    (ht : MeasurableSet t) (hst : s ⊆ t) :
    (columnL2Restriction (V := V) t ht).comp (columnL2Restriction s hs) =
      columnL2Restriction s hs := by
  have h := congrArg ContinuousLinearMap.adjoint (columnL2Restriction_comp_of_subset (V := V)
    hs ht hst)
  rwa [ContinuousLinearMap.adjoint_comp, columnL2Restriction_adjoint,
    columnL2Restriction_adjoint] at h


namespace Auto
open MeasureTheory Metric
open scoped FourierTransform ComplexConjugate ENNReal

/-! ## Far bands on the main columns (blueprint lines 2252-2258) -/

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

/-- A band of a pad family of main projections with pad-monotone masks lies in the main range of
its pad mask and has norm at most twice the input. -/
theorem padBand_mainRange (l : Fin 4) (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ) (r : ℕ)
    (M : Fin fp.P → bf.Vtx → Prop) (hMm : ∀ i j : Fin fp.P, i ≤ j → ∀ x, M i x → M j x)
    {q : ℕ} (hq : q < fp.P) (v : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) :
    padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols l) s I r (M k)) (q + 1) v -
        padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols l) s I r (M k)) q v ∈
      mainRange A.G fp.Mc (bf.origCols l) s I r (M ⟨q, hq⟩) ∧
    ‖padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols l) s I r (M k)) (q + 1) v -
        padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols l) s I r (M k)) q v‖ ≤
      2 * ‖v‖ := by
  rw [padFam_succ _ hq]
  rcases q with _ | q
  · rw [padFam_zero]
    simp only [ContinuousLinearMap.coe_coe, LinearMap.zero_apply, sub_zero]
    exact ⟨Submodule.starProjection_apply_mem _ v,
      (Submodule.norm_starProjection_apply_le _ v).trans (by linarith [norm_nonneg v])⟩
  · rw [padFam_succ _ (by omega)]
    simp only [ContinuousLinearMap.coe_coe]
    refine ⟨Submodule.sub_mem _ (Submodule.starProjection_apply_mem _ v)
      (mainRange_mono A.G fp.Mc (bf.origCols l) s I le_rfl (hMm ⟨q, by omega⟩ ⟨q + 1, hq⟩
        (Fin.mk_le_mk.mpr (Nat.le_succ q)))
        (Submodule.starProjection_apply_mem _ v)), ?_⟩
    refine (norm_sub_le _ _).trans ?_
    have h1 : ‖mainProj A.G fp.Mc (bf.origCols l) s I r (M ⟨q + 1, hq⟩) v‖ ≤ ‖v‖ :=
      Submodule.norm_starProjection_apply_le _ v
    have h2 : ‖mainProj A.G fp.Mc (bf.origCols l) s I r (M ⟨q, by omega⟩) v‖ ≤ ‖v‖ :=
      Submodule.norm_starProjection_apply_le _ v
    linarith

open Classical in
/-- Blueprint lines 2253-2254 on the main columns (a far band pair with the helper band higher:
"expand the lower `c` band into its main pure sources; their tags lie in both masks writing the
higher helper band as a difference of residuals, and their ranks are lower than the helper rank.
The helper test applies with arbitrary `L²` spectators"): at an active cell, the cell form with
the helper band `Q_{a,p+1} - Q_{a,p}` of a side value in slot `a`, a lower main band
`Q_{u,q+1} - Q_{u,q}` (`q + 2 < p`) in slot `u` and two spectators is at most
`(D √N (2 ‖v‖) / √|I|) (2 β) S_o S_b`, where `β` is the level of the helper residuals, `D` the
column budget and `N` the number of main labels of the lower band's mask. -/
theorem far_helper_main {I : ℤ × ℤ} (hI : I ∈ A.cells) {a u o b : Fin 4} (hua : u ≠ a)
    (huo : u ≠ o) (hub : u ≠ b) (hao : a ≠ o) (hab : a ≠ b) (hob : o ≠ b)
    (catu : List (CatCol bf.Vtx))
    (hT : ∀ e ∈ catu, ∃ R ∈ residueBox (bf.vtag e.tag).dim 9, ∃ γ : ℝ,
      e = templateCol (bf.vtag e.tag) u R γ e.birth e.rank e.tag)
    (htag : ∀ e ∈ catu, bf.occAvail e.tag.2.1 e.tag.1)
    (r : ℕ) (M : Fin fp.P → bf.Vtx → Prop) (hMm : ∀ i j : Fin fp.P, i ≤ j → ∀ x, M i x → M j x)
    (cata : List (CatCol bf.Vtx)) (rH : ℕ) (xa v : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) {β : ℝ}
    (hpass : ∀ k : Fin fp.P, CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag a (M k)
      (xa - mainProj A.G fp.Mc (bf.origCols a) cata I rH (M k) xa) β) (hβ : 0 ≤ β)
    {p q : ℕ} (hpq : q + 2 < p) (hpP : p ≤ fp.P) (X : Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc))
    (hXa : X a = padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols a) cata I rH (M k))
        (p + 1) xa -
      padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols a) cata I rH (M k)) p xa)
    (hXu : X u = padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols u) catu I r (M k))
        (q + 1) v -
      padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols u) catu I r (M k)) q v)
    {So Sb : ℝ} (hSo : 0 < So) (hSb : 0 < Sb)
    (hXo : eLpNorm (augPhys (X o)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal So)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb) (d : bf.Vtx) :
    ‖fp.Λc I X‖ ≤ A.colBudget * Real.sqrt (mainLabelsM A.G fp.Mc (bf.origCols u) catu I r
        (M ⟨q, by omega⟩) d).card * (2 * ‖v‖) / Real.sqrt (dyadicGridLength A.G I.1) *
      ((β + β) * So * Sb) := by
  have hqP : q < fp.P := by omega
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  have hcb : (0 : ℝ) ≤ A.colBudget := by linarith [A.two_le_colBudget]
  obtain ⟨hmem, hnorm⟩ := fp.padBand_mainRange u catu I r M hMm hqP v
  set F := mainLabelsM A.G fp.Mc (bf.origCols u) catu I r (M ⟨q, hqP⟩) d with hF
  obtain ⟨c, hc⟩ := mainRange_exists_coeffM (G := A.G) (O := bf.origCols u) d hmem
  -- the coefficient bound of the lower band
  have hcs : ∑ m ∈ F, ‖c m‖ ≤ A.colBudget * Real.sqrt F.card * (2 * ‖v‖) /
      Real.sqrt (dyadicGridLength A.G I.1) := by
    have h := mainCoeff_sum_le catu I F c
      (fun m hm => bf.mainLabel_memLp u catu I r (mainLabelsM_subset catu I r _ d hm)) hcb
      (fun m _ => bf.inv_mainWeight_le u m)
    rw [← hc] at h
    refine h.trans ?_
    rw [div_le_div_iff_of_pos_right hsq]
    calc Real.sqrt F.card * A.colBudget * ‖padFam (fun k : Fin fp.P =>
          mainProj A.G fp.Mc (bf.origCols u) catu I r (M k)) (q + 1) v -
          padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols u) catu I r (M k)) q v‖
        ≤ Real.sqrt F.card * A.colBudget * (2 * ‖v‖) :=
          mul_le_mul_of_nonneg_left hnorm (by positivity)
      _ = A.colBudget * Real.sqrt F.card * (2 * ‖v‖) := by ring
  -- the helper band as a difference of passing residuals
  obtain ⟨p', rfl⟩ : ∃ p', p = p' + 1 := ⟨p - 1, by omega⟩
  have hp1 : p' + 1 - 1 < fp.P := by omega
  obtain ⟨M₁, R₁, β₁, h₁, hβ₁, hβ₁0, hM₁, hXa'⟩ : ∃ (M₁ : bf.Vtx → Prop)
      (R₁ : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) (β₁ : ℝ),
      CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag a M₁ R₁ β₁ ∧ β₁ ≤ β ∧ 0 ≤ β₁ ∧
      (∀ x, M ⟨q, hqP⟩ x → M₁ x) ∧
      X a = (xa - mainProj A.G fp.Mc (bf.origCols a) cata I rH (M ⟨p' + 1 - 1, hp1⟩) xa) - R₁ := by
    have hpad : padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols a) cata I rH (M k))
        (p' + 1) xa = mainProj A.G fp.Mc (bf.origCols a) cata I rH (M ⟨p' + 1 - 1, hp1⟩) xa := by
      have hp1' : p' < fp.P := by omega
      rw [padFam_succ _ hp1']
      rfl
    rcases Nat.lt_or_ge (p' + 1) fp.P with hpl | hpl
    · refine ⟨M ⟨p' + 1, hpl⟩, xa - mainProj A.G fp.Mc (bf.origCols a) cata I rH (M ⟨p' + 1, hpl⟩)
        xa, β, hpass ⟨p' + 1, hpl⟩, le_rfl, hβ, hMm _ _ (Fin.mk_le_mk.mpr (by omega)), ?_⟩
      rw [hXa, hpad, padFam_succ _ hpl]
      simp only [ContinuousLinearMap.coe_coe]
      abel
    · have hpe : p' + 1 = fp.P := le_antisymm hpP hpl
      refine ⟨M ⟨p' + 1 - 1, hp1⟩, 0, 0, CellPass.zero _ _ _ _ _ _, hβ, le_rfl,
        hMm _ _ (Fin.mk_le_mk.mpr (by omega)), ?_⟩
      have htop : padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols a) cata I rH (M k))
          (p' + 1 + 1) = LinearMap.id := by
        rw [show p' + 1 + 1 = fp.P + 1 by omega]; exact padFam_top _
      rw [hXa, hpad, htop]
      simp
  have hsrc := fun m (hm : m ∈ F) => (bf.mainLabel_source u catu hT htag I r (M ⟨q, hqP⟩) d hm)
  rw [fp.Λc_of_mem hI]
  have h := CellPass.form_band_le (A.adm I hI) (hpass ⟨p' + 1 - 1, hp1⟩) h₁ hua huo hub hao hab
    hob F c
    (fun m => mainCol A.G fp.Mc (bf.origCols u) catu I m)
    (fun m => labelTag (bf.origCols u) catu I d m)
    (fun m hm => ⟨hMm _ _ (Fin.mk_le_mk.mpr (by omega)) _ (hsrc m hm).1, hM₁ _ (hsrc m hm).1⟩)
    (fun m hm => by
      obtain ⟨-, A', hA', -, hθ, hMat, hq', he⟩ := hsrc m hm
      exact ⟨A', hA', hθ, hMat, hq', he⟩)
    X (hXu.trans hc) hXa' hSo hSb hXo hXb
  refine h.trans ?_
  have hb0 : 0 ≤ (β + β₁) * So * Sb := by positivity
  calc (∑ m ∈ F, ‖c m‖) * ((β + β₁) * So * Sb)
      ≤ (A.colBudget * Real.sqrt F.card * (2 * ‖v‖) / Real.sqrt (dyadicGridLength A.G I.1)) *
          ((β + β₁) * So * Sb) := mul_le_mul_of_nonneg_right hcs hb0
    _ ≤ (A.colBudget * Real.sqrt F.card * (2 * ‖v‖) / Real.sqrt (dyadicGridLength A.G I.1)) *
          ((β + β) * So * Sb) := by
        refine mul_le_mul_of_nonneg_left ?_ (by positivity)
        have : (β + β₁) * So ≤ (β + β) * So := mul_le_mul_of_nonneg_right (by linarith) hSo.le
        exact mul_le_mul_of_nonneg_right this hSb.le

/-- A band strictly inside a pad family of main projections is a difference of two residuals. -/
theorem padBand_resid_lt_main (l : Fin 4) (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ) (r : ℕ)
    (M : Fin fp.P → bf.Vtx → Prop) {q : ℕ} (hq1 : 1 ≤ q) (hq : q < fp.P)
    (v : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) :
    padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols l) s I r (M k)) (q + 1) v -
        padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols l) s I r (M k)) q v =
      (v - mainProj A.G fp.Mc (bf.origCols l) s I r (M ⟨q - 1, by omega⟩) v) -
        (v - mainProj A.G fp.Mc (bf.origCols l) s I r (M ⟨q, hq⟩) v) := by
  rw [padFam_succ _ hq]
  obtain ⟨q', rfl⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
  rw [padFam_succ _ (by omega)]
  simp only [ContinuousLinearMap.coe_coe, Nat.add_sub_cancel]
  abel

/-- The top band of a pad family of main projections is a single residual. -/
theorem padBand_resid_top_main (l : Fin 4) (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ) (r : ℕ)
    (M : Fin fp.P → bf.Vtx → Prop) (v : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) :
    padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols l) s I r (M k)) (fp.P + 1) v -
        padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols l) s I r (M k)) fp.P v =
      (v - mainProj A.G fp.Mc (bf.origCols l) s I r (M ⟨fp.P - 1, by have := fp.hP; omega⟩) v) -
        0 := by
  rw [padFam_top, sub_zero]
  have e2 : padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols l) s I r (M k)) fp.P =
      (mainProj A.G fp.Mc (bf.origCols l) s I r (M ⟨fp.P - 1, by have := fp.hP; omega⟩) :
        ColumnL2 (bf.Lab ⊕ Fin fp.Mc) →ₗ[ℂ] ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) := by
    have := fp.hP
    unfold padFam
    split_ifs with h1 h2
    · omega
    · rfl
    · omega
  rw [e2]
  rfl

/-- The normalized size of a band of a pad family of main projections. -/
theorem padBand_size_main (l : Fin 4) (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ) (r : ℕ)
    (M : Fin fp.P → bf.Vtx → Prop) (hMm : ∀ i j : Fin fp.P, i ≤ j → ∀ x, M i x → M j x)
    {q : ℕ} (hq : q ≤ fp.P) (v : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) {S : ℝ}
    (hS : 2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ S) :
    eLpNorm (augPhys (padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols l) s I r (M k))
        (q + 1) v -
        padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols l) s I r (M k)) q v)) 2
      (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1)) ≤
      ENNReal.ofReal S := by
  refine (augPhys_normalized_le A.G I _).trans (ENNReal.ofReal_le_ofReal ?_)
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  refine le_trans (div_le_div_of_nonneg_right ?_ hsq.le) hS
  rcases Nat.lt_or_ge q fp.P with hq' | hq'
  · exact (fp.padBand_mainRange l s I r M hMm hq' v).2
  · have hqe : q = fp.P := by omega
    subst hqe
    rw [fp.padBand_resid_top_main l s I r M v, sub_zero]
    refine (norm_sub_le _ _).trans ?_
    have : ‖mainProj A.G fp.Mc (bf.origCols l) s I r (M ⟨fp.P - 1, by have := fp.hP; omega⟩) v‖ ≤
        ‖v‖ := Submodule.norm_starProjection_apply_le _ v
    linarith only [this]

/-- Blueprint lines 2255-2256 ("for a far source, expand the helper primal and use the
different-tag pair estimate") on the main columns: pure charts, in two different slots, of two
vertices at graph distance greater than one at an active cell are pair-separated (`PairSmall`
with `τ₂`). -/
theorem far_pair_main {I : ℤ × ℤ} (hI : I ∈ A.cells) {o a : Fin 4} (hoa : o ≠ a) {x y : bf.Vtx}
    (hfar : ¬ (bf.tagDist fp.Hed).d (bf.admT.depth (bf.admAt I)) x y ≤ 1)
    (Ax : QuadraticChartData (bf.vtag x).dim) (hAx : QuadraticChartComplexity A.csrc A.Hsrc Ax)
    (hAxb : IsBoundedQuadraticChart Ax) (hθ : Ax.horizontal = (bf.vtag x).θ)
    (hM : Ax.matrix = (slotCoeff o : ℚ) • (bf.vtag x).C)
    (hq : Ax.quadratic = slotCoeff o * (bf.vtag x).lam)
    (Ay : QuadraticChartData (bf.vtag y).dim) (hAy : QuadraticChartComplexity A.csrc A.Hsrc Ay)
    (hAyb : IsBoundedQuadraticChart Ay) (hθ' : Ay.horizontal = (bf.vtag y).θ)
    (hM' : Ay.matrix = (slotCoeff a : ℚ) • (bf.vtag y).C)
    (hq' : Ay.quadratic = slotCoeff a * (bf.vtag y).lam)
    {τ₂ : ℝ} (hτ₂ : 0 < τ₂) (hτ₂1 : τ₂ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ₂⁻¹) ^ A.Dg) ≤ fp.Hed) :
    PairSmall (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1) (A.w I) o a
      (quadraticChartAtom Ax) (quadraticChartAtom Ay) τ₂ := by
  have hnE := bf.not_tagEdge_of_dist fp.Hed hfar
  rw [bf.depth_admAt hI] at hnE
  obtain ⟨b₁, b₂, hb, hb₁o, hb₁a, hb₂o, hb₂a, -⟩ := fin4_other_two o a hoa
  exact A.Dg_sep A.Hsrc τ₂ A.exp_two_le_Hsrc hτ₂ hτ₂1 (bf.vtag x) (bf.vtag y)
    hb₁o hb₁a hb hoa hb₂o.symm hb₂a.symm (bf.one_le_vchart_dim x) (bf.one_le_vchart_dim y) Ax Ay
    (quadraticChartComplexity_mono_order hAx (by omega))
    (quadraticChartComplexity_mono_order hAy (by omega)) hAxb hAyb hθ hM hq hθ' hM' hq'
    (dyadicGridLength_pos A.G I.1) (A.adm I hI) (fun hE => hnE (tagEdge_mono hE hHed))

end ActiveSetup.BasicFamilies.FamParams

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

open Classical in
/-- Blueprint lines 2254-2256 on the main columns (a far band pair with the complement band higher:
"expand instead the lower-rank primal source in position `d` ... Neighbor closure puts a near
source into pad `p + 1` and hence into both masks of the higher `c` residual band. The main test
applies, keeping the entire lower helper band as an `L²` spectator. For a far source, expand the
helper primal and use the different-tag pair estimate"): at an active cell, with the band
`Q_{u,q+1} - Q_{u,q}` of a complement value `v` in slot `u` (`p + 2 < q`), the helper band of a
side value in slot `a`, a combination of pure sources in slot `o` and a spectator in slot `b`, the
form is at most the near part `(Σ|c|) (2 β) S_a S_b` plus the far part
`τ₂ S_v S_b (Σ|c|) D √N_a S_a` (`N_a` the labels of the helper band's mask). -/
theorem far_main_main {I : ℤ × ℤ} (hI : I ∈ A.cells) {a u o b : Fin 4} (hua : u ≠ a)
    (huo : u ≠ o) (hub : u ≠ b) (hao : a ≠ o) (hab : a ≠ b) (hob : o ≠ b)
    (catu : List (CatCol bf.Vtx)) (r : ℕ) (M : Fin fp.P → bf.Vtx → Prop)
    (hMm : ∀ i j : Fin fp.P, i ≤ j → ∀ x, M i x → M j x) (v : ColumnL2 (bf.Lab ⊕ Fin fp.Mc))
    {βm : ℝ}
    (hmain : ∀ k : Fin fp.P, CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag u (M k)
      (v - mainProj A.G fp.Mc (bf.origCols u) catu I r (M k) v) βm) (hβm : 0 ≤ βm)
    (cata : List (CatCol bf.Vtx)) (rH : ℕ) (xa : ColumnL2 (bf.Lab ⊕ Fin fp.Mc))
    {ι : Type*} (Fo : Finset ι) (co : ι → ℂ) (src : ι → ColumnL2 (bf.Lab ⊕ Fin fp.Mc))
    (tago : ι → bf.Vtx) (Ys : ι → ℝ → ℂ)
    (hsrc : ∀ m ∈ Fo, ∃ A' : QuadraticChartData (bf.vtag (tago m)).dim,
      QuadraticChartComplexity A.csrc A.Hsrc A' ∧ A'.horizontal = (bf.vtag (tago m)).θ ∧
      A'.matrix = (slotCoeff o : ℚ) • (bf.vtag (tago m)).C ∧
      A'.quadratic = slotCoeff o * (bf.vtag (tago m)).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → augPhys (src m) y = quadraticChartAtom A' y)
    (hYs : ∀ m ∈ Fo, ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → augPhys (src m) y = Ys m y)
    {p q : ℕ} (hpq : p + 2 < q) (hqP : q ≤ fp.P) (near : ι → Prop)
    (hnear : ∀ m ∈ Fo, near m → ∀ k : Fin fp.P, q - 1 ≤ k → M k (tago m)) (d : bf.Vtx)
    (Yh : bf.Lab ⊕ Fin fp.Mc → ℝ → ℂ)
    (hYh : ∀ n ∈ mainLabelsM A.G fp.Mc (bf.origCols a) cata I rH (M ⟨p, by omega⟩) d,
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
        augPhys (mainCol A.G fp.Mc (bf.origCols a) cata I n) y = Yh n y)
    {τ₂ : ℝ} (hτ₂ : 0 ≤ τ₂) (hfar : ∀ m ∈ Fo, ¬ near m →
      ∀ n ∈ mainLabelsM A.G fp.Mc (bf.origCols a) cata I rH (M ⟨p, by omega⟩) d,
        PairSmall (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1) (A.w I) o a (Ys m)
          (Yh n) τ₂)
    (X : Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc))
    (hXa : X a = padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols a) cata I rH (M k))
        (p + 1) xa -
      padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols a) cata I rH (M k)) p xa)
    (hXu : X u = padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols u) catu I r (M k))
        (q + 1) v -
      padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols u) catu I r (M k)) q v)
    (hXo : X o = ∑ m ∈ Fo, co m • src m)
    {Sa Sv Sb : ℝ} (hSa : 0 < Sa) (hSv : 0 < Sv) (hSb : 0 < Sb)
    (hSa' : 2 * ‖xa‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sa)
    (hSv' : 2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sv)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖fp.Λc I X‖ ≤ (∑ m ∈ Fo, ‖co m‖) * ((βm + βm) * Sa * Sb) +
      τ₂ * Sv * Sb * (∑ m ∈ Fo, ‖co m‖) * (A.colBudget * Real.sqrt
        (mainLabelsM A.G fp.Mc (bf.origCols a) cata I rH (M ⟨p, by omega⟩) d).card * Sa) := by
  classical
  have hpP : p < fp.P := by omega
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  have hcb : (0 : ℝ) ≤ A.colBudget := by linarith [A.two_le_colBudget]
  rw [fp.Λc_of_mem hI]
  set Λ := cellForm (dyadicGridLength_pos A.G I.1) (A.adm I hI) (bf.Lab ⊕ Fin fp.Mc)
  -- the spectator sizes
  have hsa : eLpNorm (augPhys (X a)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sa := by
    rw [hXa]; exact fp.padBand_size_main a cata I rH M hMm hpP.le xa hSa'
  have hsv : eLpNorm (augPhys (X u)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sv := by
    rw [hXu]; exact fp.padBand_size_main u catu I r M hMm hqP v hSv'
  -- the near/far split of the sources
  set! Fn := Fo.filter near
  set! Ff := Fo.filter fun m => ¬ near m
  have hsplit : X o = (∑ m ∈ Fn, co m • src m) + ∑ m ∈ Ff, co m • src m := by
    rw [hXo, Finset.sum_filter_add_sum_filter_not]
  have hΛ : Λ X = Λ (Function.update X o (∑ m ∈ Fn, co m • src m)) +
      Λ (Function.update X o (∑ m ∈ Ff, co m • src m)) := by
    rw [← Λ.map_update_add, ← hsplit, Function.update_eq_self]
  rw [hΛ]
  refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
  · -- near sources: the main test of slot `u`
    set Y := Function.update X o (∑ m ∈ Fn, co m • src m)
    have hYo : Y o = ∑ m ∈ Fn, co m • src m := Function.update_self _ _ _
    have hYa : Y a = X a := Function.update_of_ne hao _ _
    have hYb : Y b = X b := Function.update_of_ne hob.symm _ _
    have hYu : Y u = X u := Function.update_of_ne huo _ _
    have hFn : ∑ m ∈ Fn, ‖co m‖ ≤ ∑ m ∈ Fo, ‖co m‖ :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
        fun _ _ _ => norm_nonneg _
    have hsrcn : ∀ m ∈ Fn, _ := fun m hm => hsrc m (Finset.mem_filter.mp hm).1
    rcases Nat.lt_or_ge q fp.P with hq | hq
    · have hYu' : Y u = (v - mainProj A.G fp.Mc (bf.origCols u) catu I r
          (M ⟨q - 1, by omega⟩) v) -
          (v - mainProj A.G fp.Mc (bf.origCols u) catu I r (M ⟨q, hq⟩) v) := by
        rw [hYu, hXu]; exact fp.padBand_resid_lt_main u catu I r M (by omega) hq v
      have h := CellPass.form_band_le (A.adm I hI) (hmain ⟨q - 1, by omega⟩) (hmain ⟨q, hq⟩)
        huo.symm hao.symm hob hua hub hab Fn co src tago
        (fun m hm => ⟨hnear m (Finset.mem_filter.mp hm).1 (Finset.mem_filter.mp hm).2 _
          (by simp), hnear m (Finset.mem_filter.mp hm).1 (Finset.mem_filter.mp hm).2 _
          (by simp)⟩)
        hsrcn Y hYo hYu' hSa hSb (by rw [hYa]; exact hsa) (by rw [hYb]; exact hXb)
      exact h.trans (mul_le_mul_of_nonneg_right hFn (by positivity))
    · have hqe : q = fp.P := by omega
      have hYu' : Y u = (v - mainProj A.G fp.Mc (bf.origCols u) catu I r
          (M ⟨fp.P - 1, by have := fp.hP; omega⟩) v) - 0 := by
        rw [hYu, hXu, hqe]; exact fp.padBand_resid_top_main u catu I r M v
      have h := CellPass.form_band_le (A.adm I hI) (hmain ⟨fp.P - 1, by have := fp.hP; omega⟩)
        (CellPass.zero (A.adm I hI) A.csrc A.Hsrc bf.vtag u
          (M ⟨fp.P - 1, by have := fp.hP; omega⟩))
        huo.symm hao.symm hob hua hub hab Fn co src tago
        (fun m hm => ⟨hnear m (Finset.mem_filter.mp hm).1 (Finset.mem_filter.mp hm).2 _
          (by simp; omega), hnear m (Finset.mem_filter.mp hm).1 (Finset.mem_filter.mp hm).2 _
          (by simp; omega)⟩)
        hsrcn Y hYo hYu' hSa hSb (by rw [hYa]; exact hsa) (by rw [hYb]; exact hXb)
      refine h.trans ?_
      calc (∑ m ∈ Fn, ‖co m‖) * ((βm + 0) * Sa * Sb)
          ≤ (∑ m ∈ Fn, ‖co m‖) * ((βm + βm) * Sa * Sb) :=
            mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right
              (by linarith) hSa.le) hSb.le) (Finset.sum_nonneg fun _ _ => norm_nonneg _)
        _ ≤ _ := mul_le_mul_of_nonneg_right hFn (by positivity)
  · -- far sources: the pair estimate against the helper columns
    set Y := Function.update X o (∑ m ∈ Ff, co m • src m)
    have hYo : Y o = ∑ m ∈ Ff, co m • src m := Function.update_self _ _ _
    have hYa : Y a = X a := Function.update_of_ne hao _ _
    have hYb : Y b = X b := Function.update_of_ne hob.symm _ _
    have hYu : Y u = X u := Function.update_of_ne huo _ _
    obtain ⟨hmem, hnorm⟩ := fp.padBand_mainRange a cata I rH M hMm hpP xa
    set Fa := mainLabelsM A.G fp.Mc (bf.origCols a) cata I rH (M ⟨p, hpP⟩) d
    obtain ⟨c', hce⟩ := mainRange_exists_coeffM (G := A.G) (O := bf.origCols a) d hmem
    have hYa' : Y a = ∑ n ∈ Fa, c' n • mainCol A.G fp.Mc (bf.origCols a) cata I n := by
      rw [hYa, hXa, hce]
    have h := cellForm_pairs_le (A.adm I hI) hao.symm huo.symm hob hua.symm hab hub Ff co src
      Ys (fun m hm => hYs m (Finset.mem_filter.mp hm).1) Fa c'
      (fun n => mainCol A.G fp.Mc (bf.origCols a) cata I n) Yh hYh
      (fun m hm n hn => hfar m (Finset.mem_filter.mp hm).1 (Finset.mem_filter.mp hm).2 n hn)
      Y hYo hYa' hSv hSb (by rw [hYu]; exact hsv) (by rw [hYb]; exact hXb)
    refine h.trans ?_
    have hFf : ∑ m ∈ Ff, ‖co m‖ ≤ ∑ m ∈ Fo, ‖co m‖ :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
        fun _ _ _ => norm_nonneg _
    have hFa : ∑ n ∈ Fa, ‖c' n‖ ≤ A.colBudget * Real.sqrt Fa.card * Sa := by
      have hc2 := mainCoeff_sum_le cata I Fa c'
        (fun n hn => bf.mainLabel_memLp a cata I rH (mainLabelsM_subset cata I rH _ d hn)) hcb
        (fun n _ => bf.inv_mainWeight_le a n)
      rw [← hce] at hc2
      refine hc2.trans ?_
      have hSa2 : 2 * ‖xa‖ ≤ Sa * Real.sqrt (dyadicGridLength A.G I.1) := by
        rw [div_le_iff₀ hsq] at hSa'; exact hSa'
      have h2 := hnorm.trans hSa2
      rw [div_le_iff₀ hsq]
      calc Real.sqrt Fa.card * A.colBudget * ‖padFam (fun k : Fin fp.P =>
            mainProj A.G fp.Mc (bf.origCols a) cata I rH (M k)) (p + 1) xa -
            padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols a) cata I rH (M k)) p xa‖
          ≤ Real.sqrt Fa.card * A.colBudget * (Sa * Real.sqrt (dyadicGridLength A.G I.1)) :=
            mul_le_mul_of_nonneg_left h2 (by positivity)
        _ = A.colBudget * Real.sqrt Fa.card * Sa * Real.sqrt (dyadicGridLength A.G I.1) := by
            ring
    have h0 : 0 ≤ ∑ m ∈ Ff, ‖co m‖ := Finset.sum_nonneg fun _ _ => norm_nonneg _
    have h0' : 0 ≤ ∑ n ∈ Fa, ‖c' n‖ := Finset.sum_nonneg fun _ _ => norm_nonneg _
    have hτSvSb : 0 ≤ τ₂ * Sv * Sb := by positivity
    calc τ₂ * Sv * Sb * (∑ m ∈ Ff, ‖co m‖) * ∑ n ∈ Fa, ‖c' n‖
        ≤ τ₂ * Sv * Sb * (∑ m ∈ Fo, ‖co m‖) * (A.colBudget * Real.sqrt Fa.card * Sa) := by
          gcongr

end ActiveSetup.BasicFamilies.FamParams

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

open Classical in
/-- Blueprint lines 2252-2258 for one transfer step on the main columns: the step moves a filter
with pad masks `M` (monotone in the pad, consisting of present vertices, with neighbor closure)
of rank `r` from the complement slot `u` to helper projections of rank `r_H` on the identical masks
in the side slot `a`; the remaining other complement in slot `o` is a combination of pure sources
of present vertices with coefficient sum at most `C_o`. Then every far band pair `|p - q| > 2` of
the step has form at most `D √N_u S_v (2 β_H) S_o S_b + C_o (2 β_m) S_a S_b +
τ₂ S_v S_b C_o D √N_H S_a`, where `β_m`, `β_H` are the levels of the main and helper residuals and
`N_u`, `N_H` bound the labels of the masks. -/
theorem far_term_main {I : ℤ × ℤ} (hI : I ∈ A.cells) {a u o b : Fin 4} (hua : u ≠ a)
    (huo : u ≠ o) (hub : u ≠ b) (hao : a ≠ o) (hab : a ≠ b) (hob : o ≠ b)
    (catu : List (CatCol bf.Vtx))
    (hTu : ∀ e ∈ catu, ∃ R ∈ residueBox (bf.vtag e.tag).dim 9, ∃ γ : ℝ,
      e = templateCol (bf.vtag e.tag) u R γ e.birth e.rank e.tag)
    (htagu : ∀ e ∈ catu, bf.occAvail e.tag.2.1 e.tag.1)
    (cata : List (CatCol bf.Vtx))
    (hTa : ∀ e ∈ cata, ∃ R ∈ residueBox (bf.vtag e.tag).dim 9, ∃ γ : ℝ,
      e = templateCol (bf.vtag e.tag) a R γ e.birth e.rank e.tag)
    (htaga : ∀ e ∈ cata, bf.occAvail e.tag.2.1 e.tag.1)
    (r rH : ℕ) (M : Fin fp.P → bf.Vtx → Prop)
    (hMm : ∀ i j : Fin fp.P, i ≤ j → ∀ x, M i x → M j x)
    (hMn : ∀ (k : Fin fp.P) (hk : (k : ℕ) + 1 < fp.P) (w y : bf.Vtx), M k w →
      y ∈ bf.admT.X (bf.admAt I) →
      (bf.tagDist fp.Hed).d (bf.admT.depth (bf.admAt I)) w y ≤ 1 → M ⟨k + 1, hk⟩ y)
    (v xa : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) {βm βH : ℝ} (hβm : 0 ≤ βm) (hβH : 0 ≤ βH)
    (hmain : ∀ k : Fin fp.P, CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag u (M k)
      (v - mainProj A.G fp.Mc (bf.origCols u) catu I r (M k) v) βm)
    (hhelp : ∀ k : Fin fp.P, CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag a (M k)
      (xa - mainProj A.G fp.Mc (bf.origCols a) cata I rH (M k) xa) βH)
    {ι : Type*} (Fo : Finset ι) (co : ι → ℂ) (src : ι → ColumnL2 (bf.Lab ⊕ Fin fp.Mc))
    (tago : ι → bf.Vtx) (hpres : ∀ m ∈ Fo, tago m ∈ bf.admT.X (bf.admAt I))
    (hsrc : ∀ m ∈ Fo, ∃ Ay : QuadraticChartData (bf.vtag (tago m)).dim,
      QuadraticChartComplexity A.csrc A.Hsrc Ay ∧ IsBoundedQuadraticChart Ay ∧
      Ay.horizontal = (bf.vtag (tago m)).θ ∧ Ay.matrix = (slotCoeff o : ℚ) • (bf.vtag (tago m)).C ∧
      Ay.quadratic = slotCoeff o * (bf.vtag (tago m)).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → augPhys (src m) y = quadraticChartAtom Ay y)
    {Co : ℝ} (hCo : ∑ m ∈ Fo, ‖co m‖ ≤ Co)
    {τ₂ : ℝ} (hτ₂ : 0 < τ₂) (hτ₂1 : τ₂ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ₂⁻¹) ^ A.Dg) ≤ fp.Hed)
    (d : bf.Vtx) {Nu NH : ℝ}
    (hNu : ∀ k, ((mainLabelsM A.G fp.Mc (bf.origCols u) catu I r (M k) d).card : ℝ) ≤ Nu)
    (hNH : ∀ k, ((mainLabelsM A.G fp.Mc (bf.origCols a) cata I rH (M k) d).card : ℝ) ≤ NH)
    {p q : ℕ} (hp : p ≤ fp.P) (hq : q ≤ fp.P) (hfar : q + 2 < p ∨ p + 2 < q)
    (X : Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc))
    (hXa : X a = padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols a) cata I rH (M k))
        (p + 1) xa -
      padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols a) cata I rH (M k)) p xa)
    (hXu : X u = padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols u) catu I r (M k))
        (q + 1) v -
      padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols u) catu I r (M k)) q v)
    (hXo : X o = ∑ m ∈ Fo, co m • src m)
    {So Sa Sv Sb : ℝ} (hSo : 0 < So) (hSa : 0 < Sa) (hSv : 0 < Sv) (hSb : 0 < Sb)
    (hSa' : 2 * ‖xa‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sa)
    (hSv' : 2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sv)
    (hXo' : eLpNorm (augPhys (X o)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal So)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖fp.Λc I X‖ ≤ A.colBudget * Real.sqrt Nu * Sv * ((βH + βH) * So * Sb) +
      (Co * ((βm + βm) * Sa * Sb) + τ₂ * Sv * Sb * Co * (A.colBudget * Real.sqrt NH * Sa)) := by
  have hNu0 : 0 ≤ Nu := le_trans (Nat.cast_nonneg _) (hNu ⟨0, fp.hP⟩)
  have hNH0 : 0 ≤ NH := le_trans (Nat.cast_nonneg _) (hNH ⟨0, fp.hP⟩)
  have hCo0 : 0 ≤ Co := le_trans (Finset.sum_nonneg fun _ _ => norm_nonneg _) hCo
  have hcb : (0 : ℝ) ≤ A.colBudget := by linarith [A.two_le_colBudget]
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  have hA : 0 ≤ A.colBudget * Real.sqrt Nu * Sv * ((βH + βH) * So * Sb) := by positivity
  have hB : 0 ≤ Co * ((βm + βm) * Sa * Sb) +
      τ₂ * Sv * Sb * Co * (A.colBudget * Real.sqrt NH * Sa) := by positivity
  rcases hfar with hpq | hpq
  · -- the helper band is higher
    have h := fp.far_helper_main hI hua huo hub hao hab hob catu hTu htagu r M hMm cata rH xa v
      hhelp hβH hpq hp X hXa hXu hSo hSb hXo' hXb d
    refine (h.trans ?_).trans (le_add_of_nonneg_right hB)
    have hs := Real.sqrt_le_sqrt (hNu ⟨q, by omega⟩)
    have hv : A.colBudget * Real.sqrt (mainLabelsM A.G fp.Mc (bf.origCols u) catu I r
        (M ⟨q, by omega⟩) d).card * (2 * ‖v‖) / Real.sqrt (dyadicGridLength A.G I.1) ≤
        A.colBudget * Real.sqrt Nu * Sv := by
      rw [mul_div_assoc]
      exact mul_le_mul (mul_le_mul_of_nonneg_left hs hcb) hSv' (by positivity) (by positivity)
    exact mul_le_mul_of_nonneg_right hv (by positivity)
  · -- the complement band is higher
    have hpP : p + 1 < fp.P := by omega
    set! Ys : ι → ℝ → ℂ := fun m => if h : m ∈ Fo then quadraticChartAtom (hsrc m h).choose else 0
    have hYs_eq : ∀ m (h : m ∈ Fo), Ys m = quadraticChartAtom (hsrc m h).choose := fun m h =>
      dite_eq_left_of_eq_true (eq_true h)
    have hsrc' : ∀ m ∈ Fo, ∃ A' : QuadraticChartData (bf.vtag (tago m)).dim,
        QuadraticChartComplexity A.csrc A.Hsrc A' ∧ A'.horizontal = (bf.vtag (tago m)).θ ∧
        A'.matrix = (slotCoeff o : ℚ) • (bf.vtag (tago m)).C ∧
        A'.quadratic = slotCoeff o * (bf.vtag (tago m)).lam ∧
        ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
          augPhys (src m) y = quadraticChartAtom A' y := fun m hm => by
      obtain ⟨Ay, h1, -, h3, h4, h5, h6⟩ := hsrc m hm
      exact ⟨Ay, h1, h3, h4, h5, h6⟩
    have hYs : ∀ m ∈ Fo, ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
        augPhys (src m) y = Ys m y := fun m hm => by
      rw [hYs_eq m hm]
      exact (hsrc m hm).choose_spec.2.2.2.2.2
    -- the helper columns of the lower band and their charts
    set! Fa := mainLabelsM A.G fp.Mc (bf.origCols a) cata I rH (M ⟨p, by omega⟩) d
    have hlab := fun n (hn : n ∈ Fa) =>
      bf.mainLabel_source a cata hTa htaga I rH (M ⟨p, by omega⟩) d hn
    set! Yh : bf.Lab ⊕ Fin fp.Mc → ℝ → ℂ := fun n =>
      if h : n ∈ Fa then quadraticChartAtom (hlab n h).2.choose else 0
    have hYh_eq : ∀ n (h : n ∈ Fa), Yh n = quadraticChartAtom (hlab n h).2.choose := fun n h =>
      dite_eq_left_of_eq_true (eq_true h)
    have hYh : ∀ n ∈ Fa, ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
        augPhys (mainCol A.G fp.Mc (bf.origCols a) cata I n) y = Yh n y := fun n hn => by
      rw [hYh_eq n hn]
      exact (hlab n hn).2.choose_spec.2.2.2.2.2
    set! near : ι → Prop := fun m => ∃ w, M ⟨p, by omega⟩ w ∧
      (bf.tagDist fp.Hed).d (bf.admT.depth (bf.admAt I)) w (tago m) ≤ 1
    have hnear : ∀ m ∈ Fo, near m → ∀ k : Fin fp.P, q - 1 ≤ k → M k (tago m) := by
      intro m hm ⟨w, hw, hd⟩ k hk
      have h1 := hMn ⟨p, by omega⟩ hpP w (tago m) hw (hpres m hm) hd
      exact hMm _ _ (Fin.mk_le_mk.mpr (by simp only at hk ⊢; omega)) _ h1
    have hfar' : ∀ m ∈ Fo, ¬ near m → ∀ n ∈ Fa,
        PairSmall (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1) (A.w I) o a (Ys m)
          (Yh n) τ₂ := by
      intro m hm hnm n hn
      have hMw := (hlab n hn).1
      have hfd : ¬ (bf.tagDist fp.Hed).d (bf.admT.depth (bf.admAt I)) (tago m)
          (labelTag (bf.origCols a) cata I d n) ≤ 1 := fun hd' => hnm ⟨_, hMw, by
        rw [(bf.tagDist fp.Hed).symm]; exact hd'⟩
      obtain ⟨h1, h2, h3, h4, h5, -⟩ := (hsrc m hm).choose_spec
      obtain ⟨g1, g2, g3, g4, g5, -⟩ := (hlab n hn).2.choose_spec
      rw [hYs_eq m hm, hYh_eq n hn]
      exact fp.far_pair_main hI hao.symm hfd (hsrc m hm).choose h1 h2 h3 h4 h5
        (hlab n hn).2.choose g1 g2 g3 g4 g5 hτ₂ hτ₂1 hHed
    have h := fp.far_main_main hI hua huo hub hao hab hob catu r M hMm v hmain hβm cata rH xa Fo
      co src tago Ys hsrc' hYs hpq hq near hnear d Yh hYh hτ₂.le hfar' X hXa hXu hXo hSa hSv hSb
      hSa' hSv' hXb
    refine (h.trans ?_).trans (le_add_of_nonneg_left hA)
    have hs := Real.sqrt_le_sqrt (hNH ⟨p, by omega⟩)
    gcongr

end ActiveSetup.BasicFamilies.FamParams


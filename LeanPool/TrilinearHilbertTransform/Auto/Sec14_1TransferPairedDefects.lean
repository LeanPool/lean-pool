section TransferStep
variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-- A four-linear form as a bilinear form in two distinct slots, the other slots fixed. -/
def bilinTwo (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {a c : Fin 4}
    (hac : a ≠ c) (x : Fin 4 → E) : E →ₗ[ℂ] E →ₗ[ℂ] ℂ :=
  LinearMap.mk₂ ℂ (fun u v => Λ (Function.update (Function.update x a u) c v))
    (fun u u' v => by
      have h := Λ.map_update_add (Function.update x c v) a u u'
      simp [Function.update_comm hac])
    (fun t u v => by
      have h := Λ.map_update_smul (Function.update x c v) a t u
      simp [Function.update_comm hac])
    (fun u v v' => Λ.map_update_add (Function.update x a u) c v v')
    (fun t u v => Λ.map_update_smul (Function.update x a u) c t v)

theorem bilinTwo_apply (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {a c : Fin 4}
    (hac : a ≠ c) (x : Fin 4 → E) (u v : E) :
    bilinTwo Λ hac x u v = Λ (Function.update (Function.update x a u) c v) := rfl

/-- Blueprint `eq:transfer` (line 2252) for a four-linear form: transferring the averaged filter
of the complement slot `c` to the helper average on the side slot `a` changes the form by the band
sum `Σ_{p,q} ((p - q)/P) H(A_p^a x_a, A_q^c x_c)`. -/
theorem transfer_step (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {a c : Fin 4} (hac : a ≠ c)
    (x : Fin 4 → E) (Qa Qc : ℕ → E →ₗ[ℂ] E) {P : ℕ} (hP : 0 < P)
    (ha0 : Qa 0 = 0) (hc0 : Qc 0 = 0) (haP : Qa (P + 1) = LinearMap.id)
    (hcP : Qc (P + 1) = LinearMap.id) :
    Λ (Function.update x c ((P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Qc (p + 1) (x c))) -
        Λ (Function.update x a ((P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Qa (p + 1) (x a))) =
      ∑ p ∈ Finset.range (P + 1), ∑ q ∈ Finset.range (P + 1),
        (((p : ℂ) - q) / P) * Λ (Function.update (Function.update x a
          (Qa (p + 1) (x a) - Qa p (x a))) c (Qc (q + 1) (x c) - Qc q (x c))) := by
  have h := transfer_identity (bilinTwo Λ hac x) Qa Qc hP ha0 hc0 haP hcP (x a) (x c)
  simp only [bilinTwo_apply] at h
  rw [← h]
  congr 1
  · congr 1
    funext l
    by_cases hl : l = c
    · subst hl; simp
    · rw [Function.update_of_ne hl, Function.update_of_ne hl]
      by_cases hla : l = a
      · subst hla; simp
      · rw [Function.update_of_ne hla]
  · congr 1
    funext l
    by_cases hl : l = c
    · subst hl; simp only [Function.update_self]; exact Function.update_of_ne (Ne.symm hac) _ _
    · rw [Function.update_of_ne hl]

end TransferStep

section TransferChain
variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-- The average `P⁻¹ Σ_{p=1}^P Q_p` of a filter family. -/
noncomputable def filterAvg (P : ℕ) (Q : ℕ → E →ₗ[ℂ] E) : E →ₗ[ℂ] E :=
  (P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Q (p + 1)

theorem filterAvg_apply (P : ℕ) (Q : ℕ → E →ₗ[ℂ] E) (x : E) :
    filterAvg P Q x = (P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Q (p + 1) x := by
  simp [filterAvg, LinearMap.sum_apply]

/-- One transfer step: the slot it acts on (`true` for `c`, `false` for `d`), the helper filters
on the side slot and the filters of the complement slot. -/
abbrev TransferStep (E : Type*) [AddCommGroup E] [Module ℂ E] :=
  Bool × (ℕ → E →ₗ[ℂ] E) × (ℕ → E →ₗ[ℂ] E)

/-- The complement value of slot `c` (`v = true`) or `d` (`v = false`): the averaged filters of
its steps, outermost first, applied to the base. -/
noncomputable def chainVal (P : ℕ) (v : Bool) : List (TransferStep E) → E → E
  | [], y => y
  | st :: rest, y => if st.1 = v then filterAvg P st.2.2 (chainVal P v rest y)
      else chainVal P v rest y

/-- The side value after all transfers: the helper averages applied in step order. -/
noncomputable def chainSide (P : ℕ) : List (TransferStep E) → E → E
  | [], x => x
  | st :: rest, x => chainSide P rest (filterAvg P st.2.1 x)

/-- The band defects of all transfer steps. -/
noncomputable def chainDefect (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) (P : ℕ)
    (a c d : Fin 4) (x : Fin 4 → E) (yc yd : E) : List (TransferStep E) → E → ℂ
  | [], _ => 0
  | st :: rest, xa =>
      (∑ p ∈ Finset.range (P + 1), ∑ q ∈ Finset.range (P + 1),
        (((p : ℂ) - q) / P) * Λ (Function.update (Function.update (Function.update
          (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
            (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
              (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd))))) +
        chainDefect Λ P a c d x yc yd rest (filterAvg P st.2.1 xa)

/-- Blueprint lines 2241-2268 ("after all transfers the main term is `H(D_{a,s} S_a, S_b, B_c,
B_d)`"): transferring the averaged filters of the two complement slots one at a time, each to a
helper average on the side slot, the form of the side and the two complement chains is the form of
the transferred side and the two bases plus the band defects of the steps. -/
theorem transfer_chain (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {P : ℕ} (hP : 0 < P)
    {a c d : Fin 4} (hac : a ≠ c) (had : a ≠ d) (hcd : c ≠ d) (x : Fin 4 → E) (yc yd : E) :
    ∀ (steps : List (TransferStep E)), (∀ st ∈ steps, st.2.1 0 = 0 ∧ st.2.2 0 = 0 ∧
        st.2.1 (P + 1) = LinearMap.id ∧ st.2.2 (P + 1) = LinearMap.id) → ∀ xa : E,
      Λ (Function.update (Function.update (Function.update x c (chainVal P true steps yc)) d
          (chainVal P false steps yd)) a xa) =
        Λ (Function.update (Function.update (Function.update x c yc) d yd) a
            (chainSide P steps xa)) + chainDefect Λ P a c d x yc yd steps xa
  | [], _, xa => by simp [chainVal, chainSide, chainDefect]
  | st :: rest, hst, xa => by
    obtain ⟨h1, h2, h3, h4⟩ := hst st (List.mem_cons_self ..)
    have ih := transfer_chain Λ hP hac had hcd x yc yd rest
      (fun s hs => hst s (List.mem_cons_of_mem _ hs)) (filterAvg P st.2.1 xa)
    -- the state before the step
    set zc := chainVal P true rest yc
    set zd := chainVal P false rest yd
    set! X := Function.update (Function.update (Function.update x c zc) d zd) a xa
    obtain ⟨v, Qa, Qs⟩ := st
    cases v with
    | true =>
      have hstep := sub_eq_iff_eq_add.mp (transfer_step Λ hac X Qa Qs hP h1 h2 h3 h4)
      have eXc : X c = zc := by
        simp only [X, Function.update_apply]; simp [hac.symm, hcd]
      have eXa : X a = xa := by simp [X]
      rw [eXc, eXa] at hstep
      have hL : Function.update (Function.update (Function.update x c
            (chainVal P true ((true, Qa, Qs) :: rest) yc)) d
              (chainVal P false ((true, Qa, Qs) :: rest) yd)) a xa =
          Function.update X c ((P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Qs (p + 1) zc) := by
        funext l
        simp only [chainVal, X, zc, zd, filterAvg_apply, Function.update_apply]
        split_ifs <;> simp_all
      have hR : Function.update X a ((P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Qa (p + 1) xa) =
          Function.update (Function.update (Function.update x c zc) d zd) a
            (filterAvg P Qa xa) := by
        simp only [X, Function.update_idem, filterAvg_apply]
      rw [hL, hstep, hR, ih]
      simp only [chainSide, chainDefect, X, zc, zd, ite_true, Function.update_idem]
      ring
    | false =>
      have hstep := sub_eq_iff_eq_add.mp (transfer_step Λ had X Qa Qs hP h1 h2 h3 h4)
      have eXd : X d = zd := by
        simp only [X, Function.update_apply]; simp [had.symm]
      have eXa : X a = xa := by simp [X]
      rw [eXd, eXa] at hstep
      have hL : Function.update (Function.update (Function.update x c
            (chainVal P true ((false, Qa, Qs) :: rest) yc)) d
              (chainVal P false ((false, Qa, Qs) :: rest) yd)) a xa =
          Function.update X d ((P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Qs (p + 1) zd) := by
        funext l
        simp only [chainVal, X, zc, zd, filterAvg_apply, Function.update_apply]
        split_ifs <;> simp_all
      have hR : Function.update X a ((P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Qa (p + 1) xa) =
          Function.update (Function.update (Function.update x c zc) d zd) a
            (filterAvg P Qa xa) := by
        simp only [X, Function.update_idem, filterAvg_apply]
      rw [hL, hstep, hR, ih]
      simp only [chainSide, chainDefect, X, zc, zd, Function.update_idem, Bool.false_eq_true,
        ite_false]
      ring

end TransferChain

section ComplementExpansion
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

theorem comp_list_sum (A : E →L[ℂ] E) (L : List (E →L[ℂ] E)) :
    A.comp L.sum = (L.map fun T => A.comp T).sum := by
  induction L with
  | nil => simp
  | cons T L ih => simp [ContinuousLinearMap.comp_add, ih]

theorem neg_list_sum (L : List (E →L[ℂ] E)) : -L.sum = (L.map fun T => -T).sum := by
  induction L with
  | nil => simp
  | cons T L ih => simp [ih]; abel

/-- Blueprint line 2241 ("expand complements in the latter two histories as identity minus a
positive average; there are only `2^{O(log L)}` products"): a layered history is the signed sum
of its positive chains. -/
theorem layerOp_eq_posExpand (Cum : ℕ → E →L[ℂ] E) :
    ∀ ls : List (ℕ × Bool), layerOp Cum ls =
      ((posExpand ls.reverse).map fun t => (t.1 : ℂ) • chainOp Cum t.2).sum := by
  intro ls
  induction ls using List.reverseRecOn with
  | nil => simp [layerOp_nil, posExpand, chainOp]
  | append_singleton l x ih =>
    rw [layerOp_append, ih, List.reverse_append, List.reverse_singleton, List.singleton_append]
    obtain ⟨m, b⟩ := x
    cases b with
    | false =>
      simp only [Bool.false_eq_true, ↓reduceIte, posExpand, List.map_map]
      rw [comp_list_sum, List.map_map]
      congr 1
      refine List.map_congr_left fun t _ => ?_
      simp [chainOp]
    | true =>
      simp only [↓reduceIte, posExpand, List.map_append, List.sum_append, List.map_map]
      rw [ContinuousLinearMap.sub_comp, ContinuousLinearMap.id_comp, comp_list_sum,
        List.map_map, sub_eq_add_neg, neg_list_sum, List.map_map]
      congr 1
      congr 1
      refine List.map_congr_left fun t _ => ?_
      simp [chainOp]

end ComplementExpansion

section ChainExpansion
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- A multilinear form is additive over a list sum in one slot. -/
theorem multilinear_update_list_sum (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ)
    (x : Fin 4 → E) (c : Fin 4) (L : List E) :
    Λ (Function.update x c L.sum) = (L.map fun v => Λ (Function.update x c v)).sum := by
  induction L with
  | nil => simp [Λ.map_update_zero]
  | cons v L ih => rw [List.sum_cons, Λ.map_update_add, ih, List.map_cons, List.sum_cons]

/-- The value of a list sum of scaled operators. -/
theorem list_sum_smul_apply {ι : Type*} (L : List ι) (w : ι → ℂ) (T : ι → E →L[ℂ] E) (y : E) :
    (L.map fun t => w t • T t).sum y = (L.map fun t => w t • T t y).sum := by
  induction L with
  | nil => simp
  | cons t L ih => simp [ih]

/-- A layered output is the signed sum of its positive-chain outputs. -/
theorem apply_layerOp_eq (B : E →L[ℂ] E) (C : ℕ → E →L[ℂ] E) (ls : List (ℕ × Bool)) (y : E) :
    B (layerOp C ls y) =
      ((posExpand ls.reverse).map fun t => (t.1 : ℂ) • B (chainOp C t.2 y)).sum := by
  rw [layerOp_eq_posExpand C ls, list_sum_smul_apply, map_list_sum, List.map_map]
  refine congrArg List.sum (List.map_congr_left fun t _ => ?_)
  simp [map_smul]

/-- A multilinear form is biadditive over list sums in two distinct slots. -/
theorem multilinear_update_two_sums (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {c d : Fin 4}
    (hcd : c ≠ d) (x : Fin 4 → E) {α β : Type*} (Lc : List α) (Ld : List β) (f : α → E)
    (g : β → E) :
    Λ (Function.update (Function.update x c (Lc.map f).sum) d (Ld.map g).sum) =
      (Ld.map fun t' => (Lc.map fun t =>
        Λ (Function.update (Function.update x c (f t)) d (g t'))).sum).sum := by
  rw [multilinear_update_list_sum, List.map_map]
  refine congrArg List.sum (List.map_congr_left fun t' _ => ?_)
  simp only [Function.comp_apply]
  rw [Function.update_comm hcd, multilinear_update_list_sum, List.map_map]
  refine congrArg List.sum (List.map_congr_left fun t _ => ?_)
  simp only [Function.comp_apply]
  rw [Function.update_comm hcd]

/-- Blueprint line 2241 ("expand complements in the latter two histories as identity minus a
positive average; there are only `2^{O(log L)}` products"): the form with whole layered outputs
`B_c(ℬ_c y_c)`, `B_d(ℬ_d y_d)` in two slots is the signed sum, over the pairs of positive chains of
the two histories, of the forms with the chain outputs. -/
theorem form_layer_chains (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {c d : Fin 4}
    (hcd : c ≠ d) (x : Fin 4 → E) (Bc Bd : E →L[ℂ] E) (Cc Cd : ℕ → E →L[ℂ] E)
    (lc ld : List (ℕ × Bool)) (yc yd : E) :
    Λ (Function.update (Function.update x c (Bc (layerOp Cc lc yc))) d
        (Bd (layerOp Cd ld yd))) =
      ((posExpand ld.reverse).map fun t' => ((posExpand lc.reverse).map fun t =>
        ((t.1 : ℂ) * t'.1) * Λ (Function.update (Function.update x c (Bc (chainOp Cc t.2 yc))) d
          (Bd (chainOp Cd t'.2 yd)))).sum).sum := by
  rw [apply_layerOp_eq Bc Cc lc yc, apply_layerOp_eq Bd Cd ld yd,
    multilinear_update_two_sums Λ hcd]
  refine congrArg List.sum (List.map_congr_left fun t' _ => ?_)
  refine congrArg List.sum (List.map_congr_left fun t _ => ?_)
  rw [Λ.map_update_smul, Function.update_comm hcd, Λ.map_update_smul, Function.update_comm hcd,
    smul_eq_mul, smul_eq_mul]
  ring

end ChainExpansion

/-- Blueprint line 2241 ("the ranks are distinct: a cumulative rank was inserted in just one
slot at its binary split"): along the guarded search, if the layers so far avoid the open color
range `[ℓ, h)` and have distinct indices in distinct slots, every leaf has distinct layer indices
in distinct slots. -/
theorem searchLeaves_layers_distinct :
    ∀ (fuel ℓ h : ℕ) (up : Fin 4) (low : Option (Fin 4)) (ls : Fin 4 → List (ℕ × Bool)),
      (∀ l, ∀ x ∈ ls l, x.1 ∉ Finset.Ico ℓ h) →
      (∀ l l', l ≠ l' → ∀ x ∈ ls l, ∀ y ∈ ls l', x.1 ≠ y.1) →
      ∀ L ∈ searchLeaves fuel ℓ h up low ls,
        ∀ l l', l ≠ l' → ∀ x ∈ L.layers l, ∀ y ∈ L.layers l', x.1 ≠ y.1 := by
  intro fuel
  induction fuel with
  | zero =>
    intro ℓ h up low ls _ hd L hL
    simp only [searchLeaves, List.mem_singleton] at hL
    subst hL; exact hd
  | succ fuel ih =>
    intro ℓ h up low ls hout hd L hL
    simp only [searchLeaves] at hL
    split_ifs at hL with hlt
    · set t := thirdSlot up low
      set m := (ℓ + h) / 2
      have hm1 : ℓ ≤ m := by omega
      have hm2 : m < h := by omega
      -- the updated layer lists
      have hmem : ∀ (b : Bool) l, ∀ x ∈ Function.update ls t (ls t ++ [(m, b)]) l,
          x ∈ ls l ∨ (l = t ∧ x = (m, b)) := by
        intro b l x hx
        by_cases hl : l = t
        · subst hl
          rw [Function.update_self, List.mem_append, List.mem_singleton] at hx
          rcases hx with hx | hx
          · exact Or.inl hx
          · exact Or.inr ⟨rfl, hx⟩
        · rw [Function.update_of_ne hl] at hx; exact Or.inl hx
      have hdist : ∀ b : Bool, ∀ l l', l ≠ l' → ∀ x ∈ Function.update ls t (ls t ++ [(m, b)]) l,
          ∀ y ∈ Function.update ls t (ls t ++ [(m, b)]) l', x.1 ≠ y.1 := by
        intro b l l' hll x hx y hy
        rcases hmem b l x hx with hx | ⟨hl, rfl⟩ <;> rcases hmem b l' y hy with hy | ⟨hl', rfl⟩
        · exact hd l l' hll x hx y hy
        · intro he
          exact hout l x hx (Finset.mem_Ico.mpr (by simp only at he; omega))
        · intro he
          exact hout l' y hy (Finset.mem_Ico.mpr (by simp only at he; omega))
        · exact absurd (hl.trans hl'.symm) hll
      rcases List.mem_append.mp hL with hL | hL
      · refine ih ℓ m t low _ (fun l x hx => ?_) (hdist false) L hL
        rcases hmem false l x hx with hx | ⟨-, rfl⟩
        · intro hI; exact hout l x hx (Finset.mem_Ico.mpr (by
            have := Finset.mem_Ico.mp hI; omega))
        · simp
      · refine ih (m + 1) h up (some t) _ (fun l x hx => ?_) (hdist true) L hL
        rcases hmem true l x hx with hx | ⟨-, rfl⟩
        · intro hI; exact hout l x hx (Finset.mem_Ico.mpr (by
            have := Finset.mem_Ico.mp hI; omega))
        · simp
    · simp only [List.mem_singleton] at hL
      subst hL; exact hd

/-- The leaves of the attempt search have distinct cumulative indices in distinct slots. -/
theorem leafAt_layers_distinct (fuel Lc : ℕ) (up₀ : Fin 4) (s : ℕ) :
    ∀ l l', l ≠ l' → ∀ x ∈ (leafAt fuel Lc up₀ s).layers l,
      ∀ y ∈ (leafAt fuel Lc up₀ s).layers l', x.1 ≠ y.1 := by
  unfold leafAt
  by_cases hs : s < (searchList fuel Lc up₀).length
  · rw [List.getD_eq_getElem _ _ hs]
    exact searchLeaves_layers_distinct fuel 1 Lc up₀ none (fun _ => []) (by simp) (by simp) _
      (List.getElem_mem hs)
  · rw [List.getD_eq_default _ _ (by omega)]
    simp [dfltLeaf]

section PadBands
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- Blueprint lines 2243-2247: the pad family `Q_0 = 0`, `Q_p` the pad-`p` projection for
`1 ≤ p ≤ P`, and `Q_p = 1` beyond (`Q_{P+1} = 1`). -/
noncomputable def padFam {P : ℕ} (Q : Fin P → E →L[ℂ] E) (p : ℕ) : E →ₗ[ℂ] E :=
  if p = 0 then 0 else if h : p - 1 < P then (Q ⟨p - 1, h⟩ : E →ₗ[ℂ] E) else LinearMap.id

theorem padFam_zero {P : ℕ} (Q : Fin P → E →L[ℂ] E) : padFam Q 0 = 0 := by
  simp [padFam]

theorem padFam_top {P : ℕ} (Q : Fin P → E →L[ℂ] E) : padFam Q (P + 1) = LinearMap.id := by
  simp [padFam]

theorem padFam_succ {P : ℕ} (Q : Fin P → E →L[ℂ] E) {p : ℕ} (hp : p < P) :
    padFam Q (p + 1) = (Q ⟨p, hp⟩ : E →ₗ[ℂ] E) := by
  simp [padFam, hp]

/-- The average of the pad family is the operator average of the pad projections:
`Q̄ = P⁻¹ Σ_{p=1}^P Q_p`. -/
theorem filterAvg_padFam {P : ℕ} (Q : Fin P → E →L[ℂ] E) (x : E) :
    filterAvg P (padFam Q) x = opAvg Q x := by
  rw [filterAvg_apply, opAvg, smul_apply, FunLike.coe_sum, Finset.sum_apply]
  congr 1
  rw [← Fin.sum_univ_eq_sum_range]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [padFam_succ Q p.2]
  rfl

/-- Blueprint lines 2243-2252 with `transfer_chain` on a four-linear form: for a list of transfer
steps given by pad projections of complement filters (slot `c` or `d`) and helper projections on
the identical masks (side slot `a`), the form of the side and the two averaged complement chains
equals the form of the transferred side and the two bases plus the band defects. -/
theorem pad_transfer_chain (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {P : ℕ} (hP : 0 < P)
    {a c d : Fin 4} (hac : a ≠ c) (had : a ≠ d) (hcd : c ≠ d) (x : Fin 4 → E) (yc yd : E)
    (steps : List (Bool × (Fin P → E →L[ℂ] E) × (Fin P → E →L[ℂ] E))) (xa : E) :
    Λ (Function.update (Function.update (Function.update x c
        (chainVal P true (steps.map fun st => (st.1, padFam st.2.1, padFam st.2.2)) yc)) d
          (chainVal P false (steps.map fun st => (st.1, padFam st.2.1, padFam st.2.2)) yd)) a
            xa) =
      Λ (Function.update (Function.update (Function.update x c yc) d yd) a
          (chainSide P (steps.map fun st => (st.1, padFam st.2.1, padFam st.2.2)) xa)) +
        chainDefect Λ P a c d x yc yd (steps.map fun st => (st.1, padFam st.2.1, padFam st.2.2))
          xa :=
  transfer_chain Λ hP hac had hcd x yc yd _ (fun st hst => by
    obtain ⟨st', -, rfl⟩ := List.mem_map.mp hst
    exact ⟨padFam_zero st'.2.1, padFam_zero st'.2.2, padFam_top st'.2.1, padFam_top st'.2.2⟩) xa

end PadBands

section Restoration
variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-- Blueprint lines 2261-2262 ("restoring `B_c, B_d` to `Y_c, Y_d` gives the pair-small main term;
each correction has an additional basic side `U`"): with `Y = B + U` in two slots, the
transferred main term is the form of the full pair minus the three corrections containing a
basic side. -/
theorem restore_two (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {c d : Fin 4} (hcd : c ≠ d)
    (x : Fin 4 → E) (Bc Bd Uc Ud : E) :
    Λ (Function.update (Function.update x c Bc) d Bd) =
      Λ (Function.update (Function.update x c (Bc + Uc)) d (Bd + Ud)) -
        (Λ (Function.update (Function.update x c Uc) d Bd) +
          Λ (Function.update (Function.update x c Bc) d Ud) +
          Λ (Function.update (Function.update x c Uc) d Ud)) := by
  have h1 := Λ.map_update_add (Function.update x c (Bc + Uc)) d Bd Ud
  have h2 : ∀ v : E, Λ (Function.update (Function.update x c (Bc + Uc)) d v) =
      Λ (Function.update (Function.update x c Bc) d v) +
        Λ (Function.update (Function.update x c Uc) d v) := by
    intro v
    rw [Function.update_comm hcd, Λ.map_update_add, Function.update_comm hcd.symm,
      Function.update_comm hcd.symm]
  rw [h1, h2, h2]
  ring

end Restoration


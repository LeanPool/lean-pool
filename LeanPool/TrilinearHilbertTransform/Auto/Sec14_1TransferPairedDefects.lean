/-! ## Generic band defect bounds (blueprint lines 2252-2258) -/

/-- The average of a constant family of operators is the operator. -/
theorem opAvg_const {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] {P : ℕ}
    (hP : 0 < P) (T : E →L[ℂ] E) : opAvg (fun _ : Fin P => T) = T := by
  unfold opAvg
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, ← Nat.cast_smul_eq_nsmul ℂ,
    smul_smul, inv_mul_cancel₀ (by exact_mod_cast hP.ne'), one_smul]

section DefectSplit
variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-! ### Near and far parts of the transfer defects (blueprint lines 2252-2258) -/

/-- The band defects of the transfer steps restricted to the band pairs `(p, q)` selected by
`sel` (the near pairs `|p - q| ≤ 2` or the far pairs). -/
noncomputable def chainDefectSel (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) (P : ℕ)
    (a c d : Fin 4) (x : Fin 4 → E) (yc yd : E) (sel : ℕ → ℕ → Prop) [DecidableRel sel] :
    List (TransferStep E) → E → ℂ
  | [], _ => 0
  | st :: rest, xa =>
      (∑ p ∈ Finset.range (P + 1), ∑ q ∈ (Finset.range (P + 1)).filter (sel p),
        (((p : ℂ) - q) / P) * Λ (Function.update (Function.update (Function.update
          (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
            (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
              (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd))))) +
        chainDefectSel Λ P a c d x yc yd sel rest (filterAvg P st.2.1 xa)

end DefectSplit

section DefectBound
variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-- If every selected band term of every step (with the side value of the earlier steps) is at
most `B`, the selected defects are at most `#steps (P + 1)² B` (the transfer coefficients
`(p - q) / P` have modulus at most one). -/
theorem chainDefectSel_le (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {P : ℕ} (hP : 0 < P)
    (a c d : Fin 4) (x : Fin 4 → E) (yc yd : E) (sel : ℕ → ℕ → Prop) [DecidableRel sel]
    {B : ℝ} (hB0 : 0 ≤ B) :
    ∀ (steps : List (TransferStep E)) (xa : E),
      (∀ pre st rest, steps = pre ++ st :: rest → ∀ p ≤ P, ∀ q ≤ P, sel p q →
        ‖Λ (Function.update (Function.update (Function.update
          (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
            (st.2.1 (p + 1) (chainSide P pre xa) - st.2.1 p (chainSide P pre xa)))
              (if st.1 then c else d)
              (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd))))‖ ≤ B) →
      ‖chainDefectSel Λ P a c d x yc yd sel steps xa‖ ≤ steps.length * ((P + 1) ^ 2 * B)
  | [], xa, _ => by simp [chainDefectSel]
  | st :: rest, xa, hB => by
    rw [chainDefectSel]
    have ih := chainDefectSel_le Λ hP a c d x yc yd sel hB0 rest (filterAvg P st.2.1 xa)
      (fun pre st' rest' he p hp q hq hs => by
        have := hB (st :: pre) st' rest' (by rw [he]; rfl) p hp q hq hs
        simpa [chainSide] using this)
    have hP' : (0 : ℝ) < P := by exact_mod_cast hP
    have hhead : ‖∑ p ∈ Finset.range (P + 1), ∑ q ∈ (Finset.range (P + 1)).filter (sel p),
        (((p : ℂ) - q) / P) * Λ (Function.update (Function.update (Function.update
          (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
            (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
              (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd))))‖ ≤
        (P + 1) ^ 2 * B := by
      refine (norm_sum_le _ _).trans ?_
      calc ∑ p ∈ Finset.range (P + 1), ‖∑ q ∈ (Finset.range (P + 1)).filter (sel p),
            (((p : ℂ) - q) / P) * Λ (Function.update (Function.update (Function.update
              (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
                (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
                  (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                    st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd))))‖
          ≤ ∑ _p ∈ Finset.range (P + 1), ∑ _q ∈ Finset.range (P + 1), B := by
            refine Finset.sum_le_sum fun p hp => (norm_sum_le _ _).trans ?_
            refine le_trans (Finset.sum_le_sum fun q hq => ?_)
              (Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
                fun _ _ _ => hB0)
            obtain ⟨hq1, hsel⟩ := Finset.mem_filter.mp hq
            have hpP := Finset.mem_range.mp hp
            have hqP := Finset.mem_range.mp hq1
            rw [norm_mul]
            have hc : ‖((p : ℂ) - q) / P‖ ≤ 1 := by
              have e : ((p : ℂ) - q) / P = (((p : ℝ) - q) / P : ℝ) := by push_cast; ring
              rw [e, Complex.norm_real, Real.norm_eq_abs, abs_div, abs_of_pos hP',
                div_le_one hP', abs_sub_le_iff]
              have h1 : (p : ℝ) ≤ P := by exact_mod_cast Nat.lt_succ_iff.mp hpP
              have h2 : (q : ℝ) ≤ P := by exact_mod_cast Nat.lt_succ_iff.mp hqP
              have h3 : (0 : ℝ) ≤ p := Nat.cast_nonneg _
              have h4 : (0 : ℝ) ≤ q := Nat.cast_nonneg _
              constructor <;> linarith
            have hΛ := hB [] st rest rfl p (Nat.lt_succ_iff.mp hpP) q (Nat.lt_succ_iff.mp hqP) hsel
            calc _ ≤ 1 * B := mul_le_mul hc hΛ (norm_nonneg _) zero_le_one
              _ = B := one_mul B
        _ = (P + 1) ^ 2 * B := by
            rw [Finset.sum_const, Finset.sum_const, Finset.card_range, nsmul_eq_mul,
              nsmul_eq_mul]
            push_cast; ring
    rw [List.length_cons]
    push_cast
    calc _ ≤ _ := norm_add_le _ _
      _ ≤ (P + 1) ^ 2 * B + rest.length * ((P + 1) ^ 2 * B) := add_le_add hhead ih
      _ = _ := by ring

end DefectBound

/-! ## Transfer steps of rank-merged main filters (blueprint lines 2240-2252) -/

/-- A positive product of `n + 1` factors is the product of the shifted factors after the first
factor. -/
theorem operatorComplementProduct_succ_shift {H : Type*} [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] (B : ℕ → H →L[ℂ] H) :
    ∀ (n : ℕ) (x : H), operatorComplementProduct B (fun _ => false) (n + 1) x =
      operatorComplementProduct (fun l => B (l + 1)) (fun _ => false) n (B 0 x)
  | 0, x => rfl
  | n + 1, x => by
    change B (n + 1) (operatorComplementProduct B (fun _ => false) (n + 1) x) =
      B (n + 1) (operatorComplementProduct (fun l => B (l + 1)) (fun _ => false) n (B 0 x))
    rw [operatorComplementProduct_succ_shift B n x]

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

/-- The averaged main filter of a rank and pad masks on the catalog `s` of the slot `l`. -/
noncomputable def filtAvgM (l : Fin 4) (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ)
    (f : ℕ × (Fin fp.P → bf.Vtx → Prop)) :
    ColumnL2 (bf.Lab ⊕ Fin fp.Mc) →ₗ[ℂ] ColumnL2 (bf.Lab ⊕ Fin fp.Mc) :=
  filterAvg fp.P (padFam fun p => mainProj A.G fp.Mc (bf.origCols l) s I f.1 (f.2 p))

theorem filtAvgM_apply (l : Fin 4) (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ)
    (f : ℕ × (Fin fp.P → bf.Vtx → Prop)) (y : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) :
    fp.filtAvgM l s I f y = opAvg (fun p => mainProj A.G fp.Mc (bf.origCols l) s I f.1 (f.2 p)) y :=
  filterAvg_padFam _ y

/-- The averaged main filters along a list are contractions. -/
theorem norm_applyAll_filtAvgM_le (l : Fin 4) (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ) :
    ∀ (L : List (ℕ × (Fin fp.P → bf.Vtx → Prop))) (y : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)),
      ‖applyAll (L.map (fp.filtAvgM l s I)) y‖ ≤ ‖y‖
  | [], y => le_rfl
  | f :: L, y => by
    rw [List.map_cons, applyAll, fp.filtAvgM_apply]
    exact (norm_opAvg_apply_le _ (fun _ z => Submodule.norm_starProjection_apply_le _ z) _).trans
      (norm_applyAll_filtAvgM_le l s I L y)

/-- The transfer step of a merged filter on the main columns: helper pads of rank `r_H` on the
catalog of the side slot `a`, and main pads of the filter rank on the catalog of its complement
slot (`c` for `true`, `d` for `false`). -/
noncomputable def toStepM (cat : Fin 4 → List (CatCol bf.Vtx)) (a c d : Fin 4) (rH : ℕ)
    (I : ℤ × ℤ) (e : Bool × (ℕ × (Fin fp.P → bf.Vtx → Prop))) :
    Bool × (Fin fp.P → ColumnL2 (bf.Lab ⊕ Fin fp.Mc) →L[ℂ] ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) ×
      (Fin fp.P → ColumnL2 (bf.Lab ⊕ Fin fp.Mc) →L[ℂ] ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) :=
  (e.1, fun p => mainProj A.G fp.Mc (bf.origCols a) (cat a) I rH (e.2.2 p),
    fun p => mainProj A.G fp.Mc (bf.origCols (if e.1 then c else d)) (cat (if e.1 then c else d))
      I e.2.1 (e.2.2 p))

/-- The transfer steps of two filter lists merged by rank, on the main columns. -/
noncomputable def mergeStepsM (cat : Fin 4 → List (CatCol bf.Vtx)) (a c d : Fin 4) (rH : ℕ)
    (I : ℤ × ℤ) (xs ys : List (ℕ × (Fin fp.P → bf.Vtx → Prop))) :
    List (TransferStep (ColumnL2 (bf.Lab ⊕ Fin fp.Mc))) :=
  ((rankMerge Prod.fst xs ys).map (fp.toStepM cat a c d rH I)).map
    fun st => (st.1, padFam st.2.1, padFam st.2.2)

/-- The slot `c` value of merged steps is the composition of the `c` filters. -/
theorem chainVal_mergeStepsM_c (cat : Fin 4 → List (CatCol bf.Vtx)) (a c d : Fin 4) (rH : ℕ)
    (I : ℤ × ℤ) (xs ys : List (ℕ × (Fin fp.P → bf.Vtx → Prop)))
    (y : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) :
    chainVal fp.P true (fp.mergeStepsM cat a c d rH I xs ys) y =
      applyAll (xs.map (fp.filtAvgM c (cat c) I)) y := by
  rw [chainVal_eq_applyAll]
  unfold mergeStepsM
  rw [List.filter_map, List.filter_map, List.map_map, List.map_map]
  have e : ((rankMerge Prod.fst xs ys).filter
      (((fun st : TransferStep (ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) => decide (st.1 = true)) ∘
        (fun st => (st.1, padFam st.2.1, padFam st.2.2))) ∘ fp.toStepM cat a c d rH I)) =
      (rankMerge Prod.fst xs ys).filter (fun e => decide (e.1 = true)) := by
    congr 1
  rw [e, rankMerge_filter_c, List.map_map]
  rfl

/-- The slot `d` value of merged steps is the composition of the `d` filters. -/
theorem chainVal_mergeStepsM_d (cat : Fin 4 → List (CatCol bf.Vtx)) (a c d : Fin 4) (rH : ℕ)
    (I : ℤ × ℤ) (xs ys : List (ℕ × (Fin fp.P → bf.Vtx → Prop)))
    (y : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) :
    chainVal fp.P false (fp.mergeStepsM cat a c d rH I xs ys) y =
      applyAll (ys.map (fp.filtAvgM d (cat d) I)) y := by
  rw [chainVal_eq_applyAll]
  unfold mergeStepsM
  rw [List.filter_map, List.filter_map, List.map_map, List.map_map]
  have e : ((rankMerge Prod.fst xs ys).filter
      (((fun st : TransferStep (ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) => decide (st.1 = false)) ∘
        (fun st => (st.1, padFam st.2.1, padFam st.2.2))) ∘ fp.toStepM cat a c d rH I)) =
      (rankMerge Prod.fst xs ys).filter (fun e => decide (e.1 = false)) := by
    congr 1
  rw [e, rankMerge_filter_d, List.map_map]
  rfl

/-- The side value after merged steps is the product of the averaged helper filters of the
steps, innermost first. -/
theorem chainSide_mergeStepsM (cat : Fin 4 → List (CatCol bf.Vtx)) (a c d : Fin 4) (rH : ℕ)
    (I : ℤ × ℤ) :
    ∀ (pre : List (Bool × (ℕ × (Fin fp.P → bf.Vtx → Prop)))) (x : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)),
      chainSide fp.P (((pre.map (fp.toStepM cat a c d rH I)).map
          fun st => (st.1, padFam st.2.1, padFam st.2.2))) x =
        operatorComplementProduct (fun l => opAvg fun p =>
          mainProj A.G fp.Mc (bf.origCols a) (cat a) I rH
            ((pre.getD l (true, 0, fun _ _ => False)).2.2 p))
          (fun _ => false) pre.length x
  | [], x => rfl
  | e :: pre, x => by
    rw [List.map_cons, List.map_cons, chainSide, chainSide_mergeStepsM cat a c d rH I pre,
      List.length_cons, operatorComplementProduct_succ_shift]
    congr 1
    change filterAvg fp.P (padFam fun p => mainProj A.G fp.Mc (bf.origCols a) (cat a) I rH
      (e.2.2 p)) x = _
    rw [filterAvg_padFam]
    rfl

/-- The side value after merged steps is a contraction of the side state. -/
theorem norm_chainSide_mergeStepsM_le (cat : Fin 4 → List (CatCol bf.Vtx)) (a c d : Fin 4)
    (rH : ℕ) (I : ℤ × ℤ) :
    ∀ (pre : List (Bool × (ℕ × (Fin fp.P → bf.Vtx → Prop)))) (x : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)),
      ‖chainSide fp.P (((pre.map (fp.toStepM cat a c d rH I)).map
          fun st => (st.1, padFam st.2.1, padFam st.2.2))) x‖ ≤ ‖x‖
  | [], x => le_rfl
  | e :: pre, x => by
    rw [List.map_cons, List.map_cons, chainSide]
    refine (norm_chainSide_mergeStepsM_le cat a c d rH I pre _).trans ?_
    change ‖filterAvg fp.P (padFam fun p => mainProj A.G fp.Mc (bf.origCols a) (cat a) I rH
      (e.2.2 p)) x‖ ≤ _
    rw [filterAvg_padFam]
    exact norm_opAvg_apply_le _ (fun _ z => Submodule.norm_starProjection_apply_le _ z) x

/-- A step of merged transfer steps comes from a merge element: the earlier steps are those of the
merge prefix and the later steps are the merge of the remaining suffixes. -/
theorem mergeStepsM_decomp (cat : Fin 4 → List (CatCol bf.Vtx)) (a c d : Fin 4) (rH : ℕ)
    (I : ℤ × ℤ) (xs ys : List (ℕ × (Fin fp.P → bf.Vtx → Prop)))
    (pre : List (TransferStep (ColumnL2 (bf.Lab ⊕ Fin fp.Mc))))
    (st : TransferStep (ColumnL2 (bf.Lab ⊕ Fin fp.Mc)))
    (rest : List (TransferStep (ColumnL2 (bf.Lab ⊕ Fin fp.Mc))))
    (h : fp.mergeStepsM cat a c d rH I xs ys = pre ++ st :: rest) :
    ∃ (preM : List (Bool × (ℕ × (Fin fp.P → bf.Vtx → Prop))))
      (e : Bool × (ℕ × (Fin fp.P → bf.Vtx → Prop)))
      (xs' ys' : List (ℕ × (Fin fp.P → bf.Vtx → Prop))),
      pre = (preM.map (fp.toStepM cat a c d rH I)).map
        (fun st => (st.1, padFam st.2.1, padFam st.2.2)) ∧
      st = ((fp.toStepM cat a c d rH I e).1, padFam (fp.toStepM cat a c d rH I e).2.1,
        padFam (fp.toStepM cat a c d rH I e).2.2) ∧
      rest = fp.mergeStepsM cat a c d rH I xs' ys' ∧
      rankMerge Prod.fst xs ys = preM ++ e :: rankMerge Prod.fst xs' ys' ∧
      ((e.1 = true ∧ (e.2 :: xs') <:+ xs ∧ ys' <:+ ys ∧ ∀ y ∈ ys'.head?, y.1 < e.2.1) ∨
       (e.1 = false ∧ xs' <:+ xs ∧ (e.2 :: ys') <:+ ys ∧ ∀ x ∈ xs'.head?, x.1 ≤ e.2.1)) := by
  unfold mergeStepsM at h
  rw [List.map_map] at h
  obtain ⟨l₁, l₂, hl, hpre, hrest⟩ := List.map_eq_append_iff.mp h
  obtain ⟨e, restM, rfl, hst, hrest'⟩ := List.map_eq_cons_iff.mp hrest
  obtain ⟨xs', ys', hr, hcase⟩ := rankMerge_decomp Prod.fst xs ys l₁ e restM hl
  refine ⟨l₁, e, xs', ys', by rw [← hpre, List.map_map], hst.symm, ?_, by rw [hl, hr], hcase⟩
  rw [← hrest', hr]
  unfold mergeStepsM
  rw [List.map_map]

end ActiveSetup.BasicFamilies.FamParams

/-! ## The far band defects of rank-merged main filters (blueprint lines 2252-2258) -/

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

/-- The source data of a slot value used by the far band estimate on the main columns: a
combination of bounded pure sources of present vertices in the slot `o` with coefficient sum at
most `C_o`. -/
def SrcDataM (o : Fin 4) (I : ℤ × ℤ) (w : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) (Co : ℝ) : Prop :=
  ∃ (ι : Type) (Fo : Finset ι) (co : ι → ℂ) (src : ι → ColumnL2 (bf.Lab ⊕ Fin fp.Mc))
    (tago : ι → bf.Vtx), w = ∑ m ∈ Fo, co m • src m ∧ ∑ m ∈ Fo, ‖co m‖ ≤ Co ∧
    (∀ m ∈ Fo, tago m ∈ bf.admT.X (bf.admAt I)) ∧
    ∀ m ∈ Fo, ∃ Ay : QuadraticChartData (bf.vtag (tago m)).dim,
      QuadraticChartComplexity A.csrc A.Hsrc Ay ∧ IsBoundedQuadraticChart Ay ∧
      Ay.horizontal = (bf.vtag (tago m)).θ ∧ Ay.matrix = (slotCoeff o : ℚ) • (bf.vtag (tago m)).C ∧
      Ay.quadratic = slotCoeff o * (bf.vtag (tago m)).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → augPhys (src m) y = quadraticChartAtom Ay y

/-- The mask conditions of a removed filter (blueprint lines 2254-2256): its pad masks grow with
the pad and have neighbor closure among present vertices. -/
def FiltOK (I : ℤ × ℤ) (f : ℕ × (Fin fp.P → bf.Vtx → Prop)) : Prop :=
  (∀ i j : Fin fp.P, i ≤ j → ∀ x, f.2 i x → f.2 j x) ∧
  ∀ (k : Fin fp.P) (hk : (k : ℕ) + 1 < fp.P) (w y : bf.Vtx), f.2 k w →
    y ∈ bf.admT.X (bf.admAt I) →
    (bf.tagDist fp.Hed).d (bf.admT.depth (bf.admAt I)) w y ≤ 1 → f.2 ⟨k + 1, hk⟩ y

open Classical in
/-- Blueprint lines 2252-2258 for one step of a merged transfer on the main columns: the step
removes the filter `f` from the slot `u`, whose inner value (the inner filters `xs'` applied to the
argument `y_u`) passes the main tests of the pads at level `β_m`; the side value `x_a` passes the
helper tests at level `β_H`; the other complement (the filters `ys'` applied to `y_o`) has source
data with coefficient sum `C_o`. Then every far band pair of the step has form at most
`D √N_m (2 S_z) (2 β_H) S_z S_b + C_o (2 β_m) S_a S_b + τ₂ (2 S_z) S_b C_o D √N_H S_a`. -/
theorem far_stepM (cat : Fin 4 → List (CatCol bf.Vtx))
    (hT : ∀ l, ∀ e ∈ cat l, ∃ R ∈ residueBox (bf.vtag e.tag).dim 9, ∃ γ : ℝ,
      e = templateCol (bf.vtag e.tag) l R γ e.birth e.rank e.tag)
    (htag : ∀ l, ∀ e ∈ cat l, bf.occAvail e.tag.2.1 e.tag.1)
    {I : ℤ × ℤ} (hI : I ∈ A.cells) {a u o b : Fin 4} (hua : u ≠ a) (huo : u ≠ o) (hub : u ≠ b)
    (hao : a ≠ o) (hab : a ≠ b) (hob : o ≠ b) (rH : ℕ)
    (f : ℕ × (Fin fp.P → bf.Vtx → Prop)) (hf : fp.FiltOK I f)
    (yu yo : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) (xs' ys' : List (ℕ × (Fin fp.P → bf.Vtx → Prop)))
    {βm : ℝ} (hβm : 0 ≤ βm)
    (hmain : ∀ k : Fin fp.P, CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag u (f.2 k)
      (applyAll (xs'.map (fp.filtAvgM u (cat u) I)) yu -
        mainProj A.G fp.Mc (bf.origCols u) (cat u) I f.1 (f.2 k)
          (applyAll (xs'.map (fp.filtAvgM u (cat u) I)) yu)) βm)
    {Co Sz : ℝ} (hSz : 0 < Sz)
    (hsrc : fp.SrcDataM o I (applyAll (ys'.map (fp.filtAvgM o (cat o) I)) yo) Co)
    (hyu : ‖yu‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sz)
    (hyo : ‖yo‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sz)
    (xa : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) {βH : ℝ} (hβH : 0 ≤ βH)
    (hhelp : ∀ k : Fin fp.P, CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag a (f.2 k)
      (xa - mainProj A.G fp.Mc (bf.origCols a) (cat a) I rH (f.2 k) xa) βH)
    (d₀ : bf.Vtx) {Nm NH : ℝ}
    (hNm : ∀ k, ((mainLabelsM A.G fp.Mc (bf.origCols u) (cat u) I f.1 (f.2 k) d₀).card : ℝ) ≤ Nm)
    (hNH : ∀ k, ((mainLabelsM A.G fp.Mc (bf.origCols a) (cat a) I rH (f.2 k) d₀).card : ℝ) ≤ NH)
    {τ₂ : ℝ} (hτ₂ : 0 < τ₂) (hτ₂1 : τ₂ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ₂⁻¹) ^ A.Dg) ≤ fp.Hed)
    (X : Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) {p q : ℕ} (hp : p ≤ fp.P) (hq : q ≤ fp.P)
    (hfar : q + 2 < p ∨ p + 2 < q)
    (hXa : X a = padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols a) (cat a) I rH
        (f.2 k)) (p + 1) xa -
      padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols a) (cat a) I rH (f.2 k)) p xa)
    (hXu : X u = padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols u) (cat u) I f.1
        (f.2 k)) (q + 1) (applyAll (xs'.map (fp.filtAvgM u (cat u) I)) yu) -
      padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols u) (cat u) I f.1 (f.2 k)) q
        (applyAll (xs'.map (fp.filtAvgM u (cat u) I)) yu))
    (hXo : X o = applyAll (ys'.map (fp.filtAvgM o (cat o) I)) yo)
    {Sa Sb : ℝ} (hSa : 0 < Sa) (hSa' : 2 * ‖xa‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sa)
    (hSb : 0 < Sb)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖fp.Λc I X‖ ≤ A.colBudget * Real.sqrt Nm * (2 * Sz) * ((βH + βH) * Sz * Sb) +
      (Co * ((βm + βm) * Sa * Sb) +
        τ₂ * (2 * Sz) * Sb * Co * (A.colBudget * Real.sqrt NH * Sa)) := by
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  set v := applyAll (xs'.map (fp.filtAvgM u (cat u) I)) yu
  have hv : ‖v‖ ≤ ‖yu‖ := fp.norm_applyAll_filtAvgM_le u (cat u) I xs' yu
  have hSv' : 2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ 2 * Sz := by
    rw [mul_div_assoc]
    exact mul_le_mul_of_nonneg_left ((div_le_div_of_nonneg_right hv hsq.le).trans hyu)
      (by norm_num)
  have hSo : eLpNorm (augPhys (X o)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sz := by
    rw [hXo]
    exact augPhys_size_le A.G I (fp.norm_applyAll_filtAvgM_le o (cat o) I ys' yo) hyo
  obtain ⟨ι, Fo, co, src, tago, hXo', hCo, hpres, hsrcs⟩ := hsrc
  exact fp.far_term_main hI hua huo hub hao hab hob (cat u) (hT u) (htag u) (cat a) (hT a)
    (htag a) f.1 rH f.2 hf.1 hf.2 v xa hβm hβH hmain hhelp Fo co src tago hpres hsrcs hCo hτ₂
    hτ₂1 hHed d₀ hNm hNH hp hq hfar X hXa hXu (hXo.trans hXo') hSz hSa (by positivity) hSb hSa'
    hSv' hSo hXb

/-- The rank of the outermost filter of a filter list (zero for the unfiltered argument). -/
def headRank {α : Type*} (l : List (ℕ × α)) : ℕ := (l.head?.map Prod.fst).getD 0

open Classical in
/-- Blueprint lines 2252-2258 ("the far terms cost at most ... per cell and group") for two lists
of filters of the complement slots `c, d` with distinct positive ranks, merged by rank: if every
removed filter has the mask conditions and its inner value passes the main tests of its pads at
the level `β_m` of its rank, every remaining complement has source data with the coefficient sum
`C_o` of its outer rank (rank zero when unfiltered), and the side value of every step passes the
helper tests at level `β_H`, then the far band defects of the merged transfer steps are at most
`#steps (P + 1)² B`, whenever `B` bounds the step bound of `far_stepM` for every removed rank and
every strictly lower outer rank of the other complement ("the other complementary argument always
has a strictly lower-rank outer primal source"). -/
theorem chainPair_farM (cat : Fin 4 → List (CatCol bf.Vtx))
    (hT : ∀ l, ∀ e ∈ cat l, ∃ R ∈ residueBox (bf.vtag e.tag).dim 9, ∃ γ : ℝ,
      e = templateCol (bf.vtag e.tag) l R γ e.birth e.rank e.tag)
    (htag : ∀ l, ∀ e ∈ cat l, bf.occAvail e.tag.2.1 e.tag.1)
    {I : ℤ × ℤ} (hI : I ∈ A.cells) {a b c d : Fin 4} (hca : c ≠ a) (hcd : c ≠ d) (hcb : c ≠ b)
    (hda : d ≠ a) (hdb : d ≠ b) (hab : a ≠ b) (rH : ℕ)
    (xs ys : List (ℕ × (Fin fp.P → bf.Vtx → Prop))) (yc yd : ColumnL2 (bf.Lab ⊕ Fin fp.Mc))
    (βm : ℕ → ℝ) (hβm : ∀ r, 0 ≤ βm r)
    (hxs : ∀ f xs', (f :: xs') <:+ xs → fp.FiltOK I f ∧ ∀ k : Fin fp.P,
      CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag c (f.2 k)
        (applyAll (xs'.map (fp.filtAvgM c (cat c) I)) yc -
          mainProj A.G fp.Mc (bf.origCols c) (cat c) I f.1 (f.2 k)
            (applyAll (xs'.map (fp.filtAvgM c (cat c) I)) yc)) (βm f.1))
    (hys : ∀ f ys', (f :: ys') <:+ ys → fp.FiltOK I f ∧ ∀ k : Fin fp.P,
      CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag d (f.2 k)
        (applyAll (ys'.map (fp.filtAvgM d (cat d) I)) yd -
          mainProj A.G fp.Mc (bf.origCols d) (cat d) I f.1 (f.2 k)
            (applyAll (ys'.map (fp.filtAvgM d (cat d) I)) yd)) (βm f.1))
    (hdist : ∀ f ∈ xs, ∀ g ∈ ys, f.1 ≠ g.1) (hposc : ∀ f ∈ xs, 0 < f.1)
    (hposd : ∀ g ∈ ys, 0 < g.1)
    (Co : ℕ → ℝ) {Sz : ℝ} (hSz : 0 < Sz)
    (hsc : ∀ xs', xs' <:+ xs → fp.SrcDataM c I (applyAll (xs'.map (fp.filtAvgM c (cat c) I)) yc)
      (Co (headRank xs')))
    (hsd : ∀ ys', ys' <:+ ys → fp.SrcDataM d I (applyAll (ys'.map (fp.filtAvgM d (cat d) I)) yd)
      (Co (headRank ys')))
    (hyc : ‖yc‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sz)
    (hyd : ‖yd‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sz)
    (x : Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) {βH : ℝ} (hβH : 0 ≤ βH)
    (hhelp : ∀ preM e restM, rankMerge Prod.fst xs ys = preM ++ e :: restM → ∀ k : Fin fp.P,
      CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag a (e.2.2 k)
        (operatorComplementProduct (fun l => opAvg fun p =>
            mainProj A.G fp.Mc (bf.origCols a) (cat a) I rH
              ((preM.getD l (true, 0, fun _ _ => False)).2.2 p)) (fun _ => false) preM.length
              (x a) -
          mainProj A.G fp.Mc (bf.origCols a) (cat a) I rH (e.2.2 k)
            (operatorComplementProduct (fun l => opAvg fun p =>
              mainProj A.G fp.Mc (bf.origCols a) (cat a) I rH
                ((preM.getD l (true, 0, fun _ _ => False)).2.2 p)) (fun _ => false) preM.length
                (x a))) βH)
    (d₀ : bf.Vtx) {Nm NH : ℝ}
    (hNmc : ∀ f ∈ xs, ∀ M : bf.Vtx → Prop,
      ((mainLabelsM A.G fp.Mc (bf.origCols c) (cat c) I f.1 M d₀).card : ℝ) ≤ Nm)
    (hNmd : ∀ g ∈ ys, ∀ M : bf.Vtx → Prop,
      ((mainLabelsM A.G fp.Mc (bf.origCols d) (cat d) I g.1 M d₀).card : ℝ) ≤ Nm)
    (hNH : ∀ M : bf.Vtx → Prop,
      ((mainLabelsM A.G fp.Mc (bf.origCols a) (cat a) I rH M d₀).card : ℝ) ≤ NH)
    {τ₂ : ℝ} (hτ₂ : 0 < τ₂) (hτ₂1 : τ₂ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ₂⁻¹) ^ A.Dg) ≤ fp.Hed)
    {Sa Sb : ℝ} (hSa : 0 < Sa) (hSa' : 2 * ‖x a‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sa)
    (hSb : 0 < Sb)
    (hXb : eLpNorm (augPhys (x b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb)
    {B : ℝ} (hB0 : 0 ≤ B)
    (hB : ∀ Rf, ((∃ f ∈ xs, f.1 = Rf) ∨ (∃ g ∈ ys, g.1 = Rf)) → ∀ Ro < Rf,
      A.colBudget * Real.sqrt Nm * (2 * Sz) * ((βH + βH) * Sz * Sb) +
        (Co Ro * ((βm Rf + βm Rf) * Sa * Sb) +
          τ₂ * (2 * Sz) * Sb * Co Ro * (A.colBudget * Real.sqrt NH * Sa)) ≤ B) :
    ‖chainDefectSel (fp.Λc I) fp.P a c d x yc yd (fun p q => q + 2 < p ∨ p + 2 < q)
        (fp.mergeStepsM cat a c d rH I xs ys) (x a)‖ ≤
      (fp.mergeStepsM cat a c d rH I xs ys).length * ((fp.P + 1) ^ 2 * B) := by
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  refine chainDefectSel_le (fp.Λc I) fp.hP a c d x _ _ _ hB0 _ (x a)
    fun pre st rest h p hp q hq hsel => ?_
  obtain ⟨preM, e, xs', ys', rfl, rfl, rfl, hrm, hcase⟩ :=
    fp.mergeStepsM_decomp cat a c d rH I xs ys _ _ _ h
  rw [fp.chainSide_mergeStepsM]
  have hxa : ‖operatorComplementProduct (fun l => opAvg fun p =>
      mainProj A.G fp.Mc (bf.origCols a) (cat a) I rH
        ((preM.getD l (true, 0, fun _ _ => False)).2.2 p)) (fun _ => false) preM.length (x a)‖ ≤
      ‖x a‖ := by
    rw [← fp.chainSide_mergeStepsM cat a c d rH I preM (x a)]
    exact fp.norm_chainSide_mergeStepsM_le _ _ _ _ _ _ _ _
  have hSa'' : 2 * ‖operatorComplementProduct (fun l => opAvg fun p =>
      mainProj A.G fp.Mc (bf.origCols a) (cat a) I rH
        ((preM.getD l (true, 0, fun _ _ => False)).2.2 p)) (fun _ => false) preM.length (x a)‖ /
      Real.sqrt (dyadicGridLength A.G I.1) ≤ Sa :=
    le_trans (div_le_div_of_nonneg_right (by linarith) hsq.le) hSa'
  rcases hcase with ⟨he1, hxs', hys', hlt⟩ | ⟨he1, hxs', hys', hle⟩
  · -- a filter of slot `c` is removed
    obtain ⟨e1, e2⟩ := e
    simp only at he1 hlt
    subst he1
    simp only [toStepM, ite_true]
    rw [fp.chainVal_mergeStepsM_c, fp.chainVal_mergeStepsM_d]
    obtain ⟨hok, hmain⟩ := hxs e2 xs' hxs'
    have he2 : e2 ∈ xs := hxs'.subset (by simp)
    have hro : headRank ys' < e2.1 := by
      rcases ys' with _ | ⟨g, ys''⟩
      · exact hposc e2 he2
      · exact hlt g rfl
    refine (fp.far_stepM cat hT htag hI hca hcd hcb hda.symm hab hdb rH e2 hok yc yd xs' ys'
      (hβm _) hmain hSz (hsd ys' hys') hyc hyd _ hβH (hhelp preM _ _ hrm) d₀
      (fun k => hNmc e2 he2 _) (fun k => hNH _) hτ₂ hτ₂1 hHed _ hp hq hsel
      (by rw [Function.update_of_ne hca.symm, Function.update_self])
      (Function.update_self _ _ _)
      (by rw [Function.update_of_ne hcd.symm, Function.update_of_ne hda,
        Function.update_self])
      hSa hSa'' hSb
      (by rw [Function.update_of_ne hcb.symm, Function.update_of_ne hab.symm,
        Function.update_of_ne hdb.symm, Function.update_of_ne hcb.symm]; exact hXb)).trans ?_
    exact hB e2.1 (Or.inl ⟨e2, he2, rfl⟩) _ hro
  · -- a filter of slot `d` is removed
    obtain ⟨e1, e2⟩ := e
    simp only at he1 hle
    subst he1
    simp only [toStepM, Bool.false_eq_true, ite_false]
    rw [fp.chainVal_mergeStepsM_c, fp.chainVal_mergeStepsM_d]
    obtain ⟨hok, hmain⟩ := hys e2 ys' hys'
    have he2 : e2 ∈ ys := hys'.subset (by simp)
    have hro : headRank xs' < e2.1 := by
      rcases xs' with _ | ⟨g, xs''⟩
      · exact hposd e2 he2
      · have hg : g ∈ xs := hxs'.subset (by simp)
        exact lt_of_le_of_ne (hle g rfl) (hdist g hg e2 he2)
    refine (fp.far_stepM cat hT htag hI hda hcd.symm hdb hca.symm hab hcb rH e2 hok yd yc ys' xs'
      (hβm _) hmain hSz (hsc xs' hxs') hyd hyc _ hβH (hhelp preM _ _ hrm) d₀
      (fun k => hNmd e2 he2 _) (fun k => hNH _) hτ₂ hτ₂1 hHed _ hp hq hsel
      (by rw [Function.update_of_ne hda.symm, Function.update_self])
      (Function.update_self _ _ _)
      (by rw [Function.update_of_ne hcd, Function.update_of_ne hca, Function.update_of_ne hcd,
        Function.update_self])
      hSa hSa'' hSb
      (by rw [Function.update_of_ne hdb.symm, Function.update_of_ne hab.symm,
        Function.update_of_ne hdb.symm, Function.update_of_ne hcb.symm]; exact hXb)).trans ?_
    exact hB e2.1 (Or.inr ⟨e2, he2, rfl⟩) _ hro


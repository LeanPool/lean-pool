/-! ## The transfer at a leaf on the main columns and its far defects (blueprint lines 2240-2258) -/

section DefectNearFar
variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-- Blueprint line 2252 ("only `|p - q| ≤ 2` must be retained"): the band defects split into the
band pairs selected by `sel` and the remaining ones. -/
theorem chainDefect_split (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) (P : ℕ)
    (a c d : Fin 4) (x : Fin 4 → E) (yc yd : E) (sel : ℕ → ℕ → Prop) [DecidableRel sel] :
    ∀ (steps : List (TransferStep E)) (xa : E),
      chainDefect Λ P a c d x yc yd steps xa =
        chainDefectSel Λ P a c d x yc yd sel steps xa +
          chainDefectSel Λ P a c d x yc yd (fun p q => ¬ sel p q) steps xa
  | [], xa => by simp [chainDefect, chainDefectSel]
  | st :: rest, xa => by
    rw [chainDefect, chainDefectSel, chainDefectSel,
      chainDefect_split Λ P a c d x yc yd sel rest (filterAvg P st.2.1 xa)]
    have h : ∀ p ∈ Finset.range (P + 1), ∑ q ∈ Finset.range (P + 1),
        (((p : ℂ) - q) / P) * Λ (Function.update (Function.update (Function.update
          (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
            (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
              (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd)))) =
        ∑ q ∈ (Finset.range (P + 1)).filter (sel p),
          (((p : ℂ) - q) / P) * Λ (Function.update (Function.update (Function.update
            (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
              (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
                (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                  st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd)))) +
        ∑ q ∈ (Finset.range (P + 1)).filter (fun q => ¬ sel p q),
          (((p : ℂ) - q) / P) * Λ (Function.update (Function.update (Function.update
            (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
              (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
                (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                  st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd)))) :=
      fun p _ => (Finset.sum_filter_add_sum_filter_not _ _ _).symm
    rw [Finset.sum_congr rfl h, Finset.sum_add_distrib]
    ring

end DefectNearFar

/-- The signed positive chains are no longer than the layer list. -/
theorem posExpand_mem_length : ∀ (ls : List (ℕ × Bool)), ∀ t ∈ posExpand ls,
    t.2.length ≤ ls.length
  | [], t, ht => by simp only [posExpand, List.mem_singleton] at ht; subst ht; simp
  | (m, false) :: rest, t, ht => by
    simp only [posExpand, List.mem_map] at ht
    obtain ⟨t', ht', rfl⟩ := ht
    simp only [List.length_cons]
    have := posExpand_mem_length rest t' ht'; omega
  | (m, true) :: rest, t, ht => by
    simp only [posExpand, List.mem_append, List.mem_map] at ht
    rcases ht with ht | ⟨t', ht', rfl⟩
    · have := posExpand_mem_length rest t ht; simp only [List.length_cons]; omega
    · simp only [List.length_cons]
      have := posExpand_mem_length rest t' ht'; omega

/-- The splits of a signed positive chain are splits of the layer list. -/
theorem posExpand_mem_sub : ∀ (ls : List (ℕ × Bool)), ∀ t ∈ posExpand ls, ∀ m ∈ t.2,
    ∃ b : Bool, (m, b) ∈ ls
  | [], t, ht, m, hm => by
    simp only [posExpand, List.mem_singleton] at ht; subst ht; simp at hm
  | (m', false) :: rest, t, ht, m, hm => by
    simp only [posExpand, List.mem_map] at ht
    obtain ⟨t', ht', rfl⟩ := ht
    rcases List.mem_cons.mp hm with rfl | hm
    · exact ⟨false, List.mem_cons_self⟩
    · obtain ⟨b, hb⟩ := posExpand_mem_sub rest t' ht' m hm
      exact ⟨b, List.mem_cons_of_mem _ hb⟩
  | (m', true) :: rest, t, ht, m, hm => by
    simp only [posExpand, List.mem_append, List.mem_map] at ht
    rcases ht with ht | ⟨t', ht', rfl⟩
    · obtain ⟨b, hb⟩ := posExpand_mem_sub rest t ht m hm
      exact ⟨b, List.mem_cons_of_mem _ hb⟩
    · rcases List.mem_cons.mp hm with rfl | hm
      · exact ⟨true, List.mem_cons_self⟩
      · obtain ⟨b, hb⟩ := posExpand_mem_sub rest t' ht' m hm
        exact ⟨b, List.mem_cons_of_mem _ hb⟩

/-- The layers of the guarded search only split at colors at least the initial lower end. -/
theorem searchLeaves_layers_ge (B : ℕ) :
    ∀ (fuel ℓ h : ℕ) (up : Fin 4) (low : Option (Fin 4)) (ls : Fin 4 → List (ℕ × Bool)),
      B ≤ ℓ → (∀ l, ∀ e ∈ ls l, B ≤ e.1) → ∀ L ∈ searchLeaves fuel ℓ h up low ls,
        ∀ l, ∀ e ∈ L.layers l, B ≤ e.1 := by
  intro fuel
  induction fuel with
  | zero =>
    intro ℓ h up low ls _ hls L hL
    simp only [searchLeaves, List.mem_singleton] at hL
    subst hL
    exact hls
  | succ fuel ih =>
    intro ℓ h up low ls hℓ hls L hL
    simp only [searchLeaves] at hL
    split_ifs at hL with hlt
    · have key : ∀ b : Bool, ∀ l, ∀ e ∈ Function.update ls (thirdSlot up low)
          (ls (thirdSlot up low) ++ [((ℓ + h) / 2, b)]) l, B ≤ e.1 := by
        intro b l e he
        by_cases hl : l = thirdSlot up low
        · subst hl
          rw [Function.update_self] at he
          rcases List.mem_append.mp he with he | he
          · exact hls _ e he
          · rw [List.mem_singleton] at he; subst he; simp only; omega
        · rw [Function.update_of_ne hl] at he; exact hls l e he
      rcases List.mem_append.mp hL with hL | hL
      · exact ih _ _ _ _ _ hℓ (key false) L hL
      · exact ih _ _ _ _ _ (by omega) (key true) L hL
    · rw [List.mem_singleton] at hL
      subst hL
      exact hls

/-- The cumulative splits of the leaves are colors at least one. -/
theorem leafAt_layers_ge {fuel Lc : ℕ} {up₀ : Fin 4} (s : ℕ) (l : Fin 4) :
    ∀ e ∈ (leafAt fuel Lc up₀ s).layers l, 1 ≤ e.1 := by
  unfold leafAt
  by_cases hs : s < (searchList fuel Lc up₀).length
  · rw [List.getD_eq_getElem _ _ hs]
    exact searchLeaves_layers_ge 1 fuel 1 Lc up₀ none _ le_rfl (fun _ e he => by simp at he)
      _ (List.getElem_mem hs) l
  · rw [List.getD_eq_default _ _ (by omega)]
    intro e he
    simp [dfltLeaf] at he

theorem role_ne_aux : ∀ (up : Fin 4) (low : Option (Fin 4)) (l l' : Fin 4), l ≠ l' →
    (if l = thirdSlot up low then 1 else if l = up then 2
      else if l = (otherTwo up (thirdSlot up low)).1 then 3 else 4) ≠
    (if l' = thirdSlot up low then 1 else if l' = up then 2
      else if l' = (otherTwo up (thirdSlot up low)).1 then 3 else 4) := by
  decide

/-- Blueprint line 2241 ("the four ball ranks are distinct"): distinct slots of a leaf have
distinct ball levels. -/
theorem SearchLeaf.role_injective (L : SearchLeaf) {l l' : Fin 4} (h : l ≠ l') :
    L.role l ≠ L.role l' :=
  role_ne_aux L.up L.low l l' h

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

open Classical in
/-- Blueprint lines 2240-2252 (transfer and its paired defects) at a leaf, a cell and a group on
the main columns: with sides in the slots `a, b` and whole leaf outputs (the ball filter of the
role level after the layered cumulative history of the basic input) in the slots `c, d`, the form
is the signed sum over the pairs of positive chains of the two complement histories of the
transferred main term (helper averages of rank `L + 5` on the side `a`, the basic inputs in `c, d`)
plus the band defects of the rank-ordered steps. -/
theorem leaf_transferM (cat : Fin 4 → List (CatCol bf.Vtx)) (Lf : SearchLeaf) {a c d : Fin 4}
    (hac : a ≠ c) (had : a ≠ d) (hcd : c ≠ d) (G : bf.Grp) (I : ℤ × ℤ)
    (x : Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) :
    fp.Λc I (Function.update (Function.update x c
        (fp.ballFilt c (cat c) I G (Lf.role c)
          (layerOp (fun m => fp.cumFilt c (cat c) I m) (Lf.layers c) (bf.basicIn fp.Mc c I)))) d
        (fp.ballFilt d (cat d) I G (Lf.role d)
          (layerOp (fun m => fp.cumFilt d (cat d) I m) (Lf.layers d) (bf.basicIn fp.Mc d I)))) =
      ((posExpand (Lf.layers d).reverse).map fun t' =>
        ((posExpand (Lf.layers c).reverse).map fun t =>
          ((t.1 : ℂ) * t'.1) *
            (fp.Λc I (Function.update (Function.update (Function.update x c
                (bf.basicIn fp.Mc c I)) d (bf.basicIn fp.Mc d I)) a
                  (chainSide fp.P (fp.mergeStepsM cat a c d (fp.Lc + 5) I
                    (fp.slotFiltM G (Lf.role c) I t.2) (fp.slotFiltM G (Lf.role d) I t'.2))
                    (x a))) +
              chainDefect (fp.Λc I) fp.P a c d x (bf.basicIn fp.Mc c I) (bf.basicIn fp.Mc d I)
                (fp.mergeStepsM cat a c d (fp.Lc + 5) I
                  (fp.slotFiltM G (Lf.role c) I t.2) (fp.slotFiltM G (Lf.role d) I t'.2))
                (x a))).sum).sum := by
  rw [form_layer_chains (fp.Λc I) hcd x]
  refine congrArg List.sum (List.map_congr_left fun t' _ => ?_)
  refine congrArg List.sum (List.map_congr_left fun t _ => ?_)
  congr 1
  rw [← fp.applyAll_slotFiltM c (cat c) G (Lf.role c) I t.2,
    ← fp.applyAll_slotFiltM d (cat d) G (Lf.role d) I t'.2,
    ← fp.chainVal_mergeStepsM_c cat a c d (fp.Lc + 5) I (fp.slotFiltM G (Lf.role c) I t.2)
      (fp.slotFiltM G (Lf.role d) I t'.2),
    ← fp.chainVal_mergeStepsM_d cat a c d (fp.Lc + 5) I (fp.slotFiltM G (Lf.role c) I t.2)
      (fp.slotFiltM G (Lf.role d) I t'.2)]
  set steps := fp.mergeStepsM cat a c d (fp.Lc + 5) I (fp.slotFiltM G (Lf.role c) I t.2)
    (fp.slotFiltM G (Lf.role d) I t'.2)
  have hxa : Function.update (Function.update x c (chainVal fp.P true steps
      (bf.basicIn fp.Mc c I))) d (chainVal fp.P false steps (bf.basicIn fp.Mc d I)) =
      Function.update (Function.update (Function.update x c (chainVal fp.P true steps
        (bf.basicIn fp.Mc c I))) d (chainVal fp.P false steps (bf.basicIn fp.Mc d I))) a
          (x a) := by
    symm
    rw [Function.update_eq_self_iff, Function.update_of_ne had, Function.update_of_ne hac]
  rw [hxa]
  exact pad_transfer_chain (fp.Λc I) fp.hP hac had hcd x _ _
    ((rankMerge Prod.fst (fp.slotFiltM G (Lf.role c) I t.2)
      (fp.slotFiltM G (Lf.role d) I t'.2)).map (fp.toStepM cat a c d (fp.Lc + 5) I)) (x a)

open Classical in
/-- Blueprint lines 2252-2258 at a leaf of the guarded search on the main columns: for every pair
of signed positive chains of the complement histories of the slots `c, d` (in the transfer
identity `leaf_transferM`) and every group of a successful present vertex, the far band defects of
the rank-ordered transfer steps are at most `#steps (P + 1)² 8 τ₃ S_z² S_a S_b` (the chain
conditions of `leaf_farM` hold at the leaves: splits in `[1, L]`, distinct across slots, distinct
ball levels, histories within the main budget). -/
theorem leaf_far_search (cat : Fin 4 → List (CatCol bf.Vtx))
    (hT : ∀ l, ∀ e ∈ cat l, ∃ R ∈ residueBox (bf.vtag e.tag).dim 9, ∃ γ : ℝ,
      e = templateCol (bf.vtag e.tag) l R γ e.birth e.rank e.tag)
    (htag : ∀ l, ∀ e ∈ cat l, bf.occAvail e.tag.2.1 e.tag.1)
    {I : ℤ × ℤ} (hI : I ∈ A.cells) {a b c d : Fin 4} (hca : c ≠ a) (hcd : c ≠ d) (hcb : c ≠ b)
    (hda : d ≠ a) (hdb : d ≠ b) (hab : a ≠ b) {τ : ℕ → ℝ}
    (hpass : ∀ l, (l = c ∨ l = d) → ∀ w : fp.TestName I Unit, fp.MainRk w →
      (fp.testOf l I (fun _ => bf.basicIn fp.Mc l I) w).Pass A.G (bf.origCols l) I A.csrc A.Hsrc
        bf.vtag (A.w I) (τ (fp.testOf l I (fun _ => bf.basicIn fp.Mc l I) w).r) fp.mH (cat l))
    {Bh : Type} (base : Bh → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) (b₀ : Bh) {τH : ℝ} (hτH : 0 ≤ τH)
    (hhpass : ∀ w : fp.HelperName I Bh, (fp.helperOf a I base w).Pass A.G (bf.origCols a) I
      A.csrc A.Hsrc bf.vtag (A.w I) τH fp.mH (cat a))
    (x : Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) (hxa : x a = base b₀)
    {v₀ : bf.Vtx} (hv₀ : v₀ ∈ bf.admT.X (bf.admAt I))
    (hs₀ : fp.K.Success (fp.K.colorData (bf.admT.st (bf.admAt I)) v₀))
    {fuel : ℕ} {up₀ : Fin 4} (s : ℕ) (hmH : 2 * fuel + 2 ≤ fp.mH)
    {t t' : ℤ × List ℕ}
    (ht : t ∈ posExpand ((leafAt fuel fp.Lc up₀ s).layers c).reverse)
    (ht' : t' ∈ posExpand ((leafAt fuel fp.Lc up₀ s).layers d).reverse)
    {τ₃ Sz : ℝ} (hτ0 : ∀ R, 0 ≤ τ R) (n : ℕ → ℝ) (hn : Monotone n)
    (hn0 : 2 * A.colBudget ≤ n 0)
    (hτ : ∀ R, 1 ≤ R → R ≤ fp.Lc + 4 → τ R * (A.colBudget * Real.sqrt (n (R - 1))) ≤ τ₃)
    (hτH' : τH * (A.colBudget * Real.sqrt (n (fp.Lc + 4))) ≤ τ₃) (hSz : 0 < Sz)
    (hSzl : ∀ l, ‖bf.basicIn fp.Mc l I‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sz)
    (d₀ : bf.Vtx) {NH : ℝ}
    (hNl : ∀ l, ∀ r ≤ fp.Lc + 4, ∀ M : bf.Vtx → Prop,
      ((mainLabelsM A.G fp.Mc (bf.origCols l) (cat l) I r M d₀).card : ℝ) ≤ n r)
    (hNH : ∀ M : bf.Vtx → Prop,
      ((mainLabelsM A.G fp.Mc (bf.origCols a) (cat a) I (fp.Lc + 5) M d₀).card : ℝ) ≤ NH)
    {τ₂ : ℝ} (hτ₂ : 0 < τ₂) (hτ₂1 : τ₂ ≤ 1)
    (hτ₂' : τ₂ * (A.colBudget * Real.sqrt (n (fp.Lc + 4)) * (A.colBudget * Real.sqrt NH)) ≤ τ₃)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ₂⁻¹) ^ A.Dg) ≤ fp.Hed)
    {Sa Sb : ℝ} (hSa : 0 < Sa) (hSa' : 2 * ‖x a‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sa)
    (hSb : 0 < Sb)
    (hXb : eLpNorm (augPhys (x b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖chainDefectSel (fp.Λc I) fp.P a c d x (bf.basicIn fp.Mc c I) (bf.basicIn fp.Mc d I)
        (fun p q => q + 2 < p ∨ p + 2 < q)
        (fp.mergeStepsM cat a c d (fp.Lc + 5) I
          (fp.slotFiltM (fp.K.grp bf.admT A.famVtxBound (bf.admAt I) v₀)
            ((leafAt fuel fp.Lc up₀ s).role c) I t.2)
          (fp.slotFiltM (fp.K.grp bf.admT A.famVtxBound (bf.admAt I) v₀)
            ((leafAt fuel fp.Lc up₀ s).role d) I t'.2)) (x a)‖ ≤
      (fp.mergeStepsM cat a c d (fp.Lc + 5) I
          (fp.slotFiltM (fp.K.grp bf.admT A.famVtxBound (bf.admAt I) v₀)
            ((leafAt fuel fp.Lc up₀ s).role c) I t.2)
          (fp.slotFiltM (fp.K.grp bf.admT A.famVtxBound (bf.admAt I) v₀)
            ((leafAt fuel fp.Lc up₀ s).role d) I t'.2)).length *
        ((fp.P + 1) ^ 2 * (8 * τ₃ * Sz ^ 2 * Sa * Sb)) := by

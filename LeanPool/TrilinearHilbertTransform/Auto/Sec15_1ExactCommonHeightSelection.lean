  have hY : 0 ≤ Y := by positivity
  have hpow : Y ^ (d + 1) ≤ (2 * Y) ^ (d + 1) := pow_le_pow_left₀ hY (by linarith) (d + 1)
  have h7 : (0 : ℝ) ≤ 7 ^ d := by positivity
  have hs : (0 : ℝ) ≤ Real.sqrt d ^ (d + 1) := by positivity
  gcongr


open Classical in
/-- Before the attempt there are no retained `v_b`-cells. -/
theorem retainedV_eq_empty (G : bf.Grp) {b : ℤ} {K : ℕ} (hb : b - 2 * K < A.R.1) :
    fp.retainedV G b K = ∅ := by
  refine Finset.eq_empty_of_forall_notMem fun J hJ => ?_
  obtain ⟨hJt, hJ1, -⟩ := (fp.mem_retainedV).mp hJ
  have h := ((dyadicFiniteTree_mem_iff A.G A.R J _).mp hJt).1
  have := dyadicGridCell_depth_le_of_subset A.G J A.R h
  omega

open Classical in
/-- Before the attempt the physical error vanishes (the frozen output is zero). -/
theorem physError_eq_zero {n : ℕ} (Ms : ModeSystem A.G n)
    (L : LiftData (bf.Lab ⊕ Fin fp.Mc) Ms.Md) (l : Fin 4) (s : List (CatCol bf.Vtx))
    (mb : bf.MainBudget s) (G : bf.Grp) (j : ℕ) (ls : List (ℕ × Bool)) {K : ℕ} {b : ℤ}
    (hb : b - 4 * K < A.R.1) : fp.physError Ms L l s mb G j ls K b = 0 := by
  have hz : fp.frozenZ l s mb G j ls (b - 4 * K) = 0 := by simp [frozenZ, hb]
  unfold physError frozenLift
  rw [hz, map_zero, map_zero, map_zero, map_zero, sub_zero]


    (fun w j => cutoffP_periodic δ ρ w j) (by positivity) hD (cutoffP_norm_le δ ρ) K
  refine ⟨periodicFourierCoeff (cutoffP δ ρ), h1, fun s => (h2 s).trans (le_of_eq ?_),
    fun w => (h3 w).trans (le_of_eq ?_)⟩
  · unfold cutNorm; ring
  · unfold cutTail; ring


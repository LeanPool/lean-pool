  -- the cell inequality
  set! E : ℤ × ℤ → ℝ := fun I => ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => ∃ l, τ l = 2),
    ‖∑ G ∈ gs I, fp.Λc I (patternPiece (fun l => (D.withQ0 (qG G)).coreAt l G I)

open Classical in
/-- The physical function of a combination of cell modes on `J`: a.e. the combination of the
waves on `J`. -/
theorem cellMode_sum_none (J : ℤ × ℤ) (E : Finset Ms.Md) (α : Ms.Md → ℂ) :
    ∀ᵐ y ∂volume, y ∈ dyadicGridCell Gd J.1 J.2 →
      ((∑ m ∈ E, α m • Ms.cellMode J m : ColumnL2 Ms.Md) : ℝ → ColumnHilbert Ms.Md) y none =
        ∑ m ∈ E, α m * Ms.wave m y := by
  set! Ψ : Ms.Md → ColumnL2 Ms.Md := fun m => Ms.cellMode J m
  have hsum : ((∑ m ∈ E, α m • Ψ m : ColumnL2 Ms.Md) : ℝ → ColumnHilbert Ms.Md) =ᵐ[volume]
      fun y => ∑ m ∈ E, α m •
        augMode (dyadicGridCell Gd J.1 J.2) (Ms.wave m) (Ms.L.εM m) m y := by
    refine (Lp.coeFn_fun_finsetSum _ _).trans ?_
    have hall : ∀ᵐ y ∂volume, ∀ m ∈ E,
        ((α m • Ψ m : ColumnL2 Ms.Md) : ℝ → ColumnHilbert Ms.Md) y =
          α m • augMode (dyadicGridCell Gd J.1 J.2) (Ms.wave m) (Ms.L.εM m) m y := by
      rw [Filter.eventually_all_finset]
      intro m _
      filter_upwards [Lp.coeFn_smul (α m) (Ψ m),
        MemLp.coeFn_toLp (augMode_memLp (dyadicGridCell_measurable Gd J.1 J.2)
          (dyadicGridCell_volume_ne_top Gd J) (Ms.wave_measurable m) (Ms.wave_norm_le m)
          (Ms.L.εM m) m)] with y h1 h2
      rw [h1, Pi.smul_apply]
      congr 1
    filter_upwards [hall] with y hy
    exact Finset.sum_congr rfl hy
  filter_upwards [hsum] with y hy hyJ
  rw [hy]
  exact augMode_sum_none _ (fun m => Ms.wave m) Ms.L.εM E α y hyJ

end ModeSystem

open Classical in
/-- The truncated multiplier is bounded by the number of its frequencies (blueprint line 2476:
absolute Fourier costs are fixed powers of `D_*`). -/
theorem truncMult_le_card {d : ℕ} (B L : ℕ) (cm : (Fin (d + d) → ℤ) → ℂ) (hcm : ∀ v, ‖cm v‖ ≤ 1)
    (u v : StandardTorus d) :
    ‖∑ q ∈ frequencyBox (d + d) B, cm q *
      (torusCharacter ((L : ℤ) • fun a => q (Fin.castAdd d a)) u *
        torusCharacter ((L : ℤ) • fun a => q (Fin.natAdd d a)) v)‖ ≤
      (frequencyBox (d + d) B).card := by
  refine (norm_sum_le _ _).trans ?_
  have h1 : ∀ q, ‖cm q * (torusCharacter ((L : ℤ) • fun a => q (Fin.castAdd d a)) u *
      torusCharacter ((L : ℤ) • fun a => q (Fin.natAdd d a)) v)‖ ≤ 1 := by
    intro q
    rw [norm_mul, norm_mul]
    simp only [torusCharacter, fourier_apply, Circle.norm_coe, mul_one]
    exact hcm q
  calc ∑ q ∈ frequencyBox (d + d) B, _ ≤ ∑ _q ∈ frequencyBox (d + d) B, (1 : ℝ) :=
        Finset.sum_le_sum fun q _ => h1 q
    _ = _ := by rw [Finset.sum_const, nsmul_eq_mul, mul_one]


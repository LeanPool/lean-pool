/-- Four cell terms under one minimum. -/
theorem min_four_le {η a e t c : ℝ} (hη : 0 ≤ η) (ha : 0 ≤ a) (he : 0 ≤ e) (ht : 0 ≤ t)
    (hc : 0 ≤ c) :
    min η (a + 82 * e + 82 * t + c) ≤ min η a + 82 * e + 82 * min η t + min η c := by
  simp only [min_def]
  split_ifs <;> linarith

/-- The core size bound `√5 (B₀ + √T) + √T` on retained cells (blueprint line 2164). -/
noncomputable def coreBd (B₀ T : ℝ) : ℝ := Real.sqrt 5 * (B₀ + Real.sqrt T) + Real.sqrt T

/-- The error size bound `(1 + √5)(B₀ + √T)` on retained cells (blueprint line 2164). -/
noncomputable def errBd (B₀ T : ℝ) : ℝ := (1 + Real.sqrt 5) * (B₀ + Real.sqrt T)

namespace ActiveSetup.BasicFamilies.FamParams

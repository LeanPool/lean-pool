      ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        ((D.withQ0 (qG G)).pV l G I.1)‖ ≤ Real.sqrt T₂ * Real.sqrt (dyadicGridLength A.G I.1) := by
    intro I hI G hG l hl

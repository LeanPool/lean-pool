      ((hZm i k).comp measurable_snd) |>.add measurable_const
  set G : ∀ i, (Fin (zc i).dim → ℝ) → ENNReal := fun i ρ =>
    ∑ k ∈ U i, ∫⁻ y in Iset i k, F i k ρ y

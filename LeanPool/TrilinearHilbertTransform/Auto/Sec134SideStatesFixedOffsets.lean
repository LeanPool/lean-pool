/-! ### Side caps from integrated budgets (blueprint lines 2159-2166, `eq:side-cap`) -/

/-- Blueprint `eq:side-cap` via `lem:cuts`: finitely many families of nonnegative cell weights with
integrated budgets `Σ_I |I| a_ν(I) ≤ A_ν |R|` are capped simultaneously by one first-crossing cut
at `(Σ_ν A_ν)/ρ`, of total length at most `ρ |R|`. -/
theorem side_caps_of_budgets (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) {ν : Type*} [Fintype ν]
    (a : ν → ℤ × ℤ → ℝ) (ha : ∀ v, ∀ c ∈ S, 0 ≤ a v c) (root : ℤ × ℤ)
    (hroot : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    (A : ν → ℝ) (hW : ∀ v, dyadicWeightedMass G S (a v) ≤ A v * dyadicGridLength G root.1)
    {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    dyadicRootLength G (dyadicFirstCrossings G S (fun c => ∑ v, a v c) ((∑ v, A v) / ρ)) ≤
        ρ * dyadicGridLength G root.1 ∧
      ∀ x : ℝ, dyadicRealPathSum G (dyadicRetainedCells G S (fun c => ∑ v, a v c)
        ((∑ v, A v) / ρ)) (fun c => ∑ v, a v c) x ≤ (∑ v, A v) / ρ := by
  refine dyadicFirstCrossingCuts G S _ (fun c hc => Finset.sum_nonneg fun v _ => ha v c hc) root
    hroot hρ hρ1 ?_
  calc dyadicWeightedMass G S (fun c => ∑ v, a v c) = ∑ v, dyadicWeightedMass G S (a v) := by
        unfold dyadicWeightedMass
        simp_rw [Finset.mul_sum]
        exact Finset.sum_comm
    _ ≤ ∑ v, A v * dyadicGridLength G root.1 := Finset.sum_le_sum fun v _ => hW v
    _ = (∑ v, A v) * dyadicGridLength G root.1 := by rw [Finset.sum_mul]


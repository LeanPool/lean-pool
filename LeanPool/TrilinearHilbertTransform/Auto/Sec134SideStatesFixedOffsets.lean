  rw [lintegral_lintegral_swap ((hF i k).aemeasurable)]
  refine setLIntegral_mono' (hI i k) fun y _ => ?_
  exact majorant_offset_lintegral hδ (hdδ i) hδ' _ (hZ0 i k y) hK


(by `offsetMean`). -/
theorem majorant_offset_mean {d : ℕ} {δ : ℝ} (hδ : 0 < δ) (hdδ : 8 * d * δ ≤ 1)
    (hδ' : δ ≤ 1 / 8) (u : Fin d → ℝ) (Z K : ℝ) :
    ∫ ρ, (2 * |1 - branchCutoffValue δ ρ u ^ 2| ^ 2 * Z + 2 * δ ^ 2 * K) ∂(offsetMeasure d) ≤
      8 * d * δ * |Z| + 2 * δ ^ 2 * K := by
  have hmeas : Measurable fun ρ => branchCutoffValue δ ρ u := by
    unfold branchCutoffValue
    apply Finset.measurable_prod; intro i _

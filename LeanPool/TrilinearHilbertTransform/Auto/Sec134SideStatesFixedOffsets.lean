/-- Blueprint line 2133: the physical error `E = (1 - ζ²) Z_phys - Σ_Φ β_Φ q_Φ` with
`|q_Φ| ≤ δ_c` and `Σ |β_Φ| ≤ S` satisfies `|E|² ≤ 2 |1 - ζ²|² |Z_phys|² + 2 δ_c² S²`. -/
theorem physical_error_sq_le {ι : Type*} (s : Finset ι) (z : ℝ) (Zp : ℂ) (β q : ι → ℂ)
    {δ S : ℝ} (hq : ∀ i ∈ s, ‖q i‖ ≤ δ) (hβ : ∑ i ∈ s, ‖β i‖ ≤ S) (hδ : 0 ≤ δ) :
    ‖((1 - z ^ 2 : ℝ) : ℂ) * Zp - ∑ i ∈ s, β i * q i‖ ^ 2 ≤
      2 * |1 - z ^ 2| ^ 2 * ‖Zp‖ ^ 2 + 2 * δ ^ 2 * S ^ 2 := by
  have hsum : ‖∑ i ∈ s, β i * q i‖ ≤ δ * S := by
    calc ‖∑ i ∈ s, β i * q i‖ ≤ ∑ i ∈ s, ‖β i‖ * δ := by
          refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun i hi => ?_)
          rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hq i hi) (norm_nonneg _)
      _ = (∑ i ∈ s, ‖β i‖) * δ := by rw [Finset.sum_mul]
      _ ≤ S * δ := mul_le_mul_of_nonneg_right hβ hδ
      _ = δ * S := mul_comm _ _
  have h1 : ‖((1 - z ^ 2 : ℝ) : ℂ) * Zp‖ = |1 - z ^ 2| * ‖Zp‖ := by
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
  have htri := norm_sub_le (((1 - z ^ 2 : ℝ) : ℂ) * Zp) (∑ i ∈ s, β i * q i)
  rw [h1] at htri
  have hn := norm_nonneg (((1 - z ^ 2 : ℝ) : ℂ) * Zp - ∑ i ∈ s, β i * q i)
  have ha : 0 ≤ |1 - z ^ 2| * ‖Zp‖ := by positivity
  have hb : 0 ≤ ‖∑ i ∈ s, β i * q i‖ := norm_nonneg _
  nlinarith only [sq_nonneg (|1 - z ^ 2| * ‖Zp‖ - ‖∑ i ∈ s, β i * q i‖), hsum, htri, hn, hb]


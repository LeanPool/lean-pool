/-- Blueprint lines 2711-2712 (pair determination): if two label differences `u, v` satisfy
`a u + b v = s₁ + e₁`, `c u + d v = s₂ + e₂` with integer coefficients, nonzero determinant
`D = ad - bc`, shifts with `d s₁ - b s₂ = D w` (the reserved shifts are divisible by the
denominators `1, 2, 3`) and errors at most `ε`, then `|u - w| ≤ (|d| + |b|) ε`. -/
theorem pair_determination {u v s₁ s₂ e₁ e₂ w ε : ℝ} {a b c d : ℤ}
    (h₁ : a * u + b * v = s₁ + e₁) (h₂ : c * u + d * v = s₂ + e₂) (hD : a * d - b * c ≠ 0)
    (hw : (d : ℝ) * s₁ - b * s₂ = ((a * d - b * c : ℤ) : ℝ) * w) (he₁ : |e₁| ≤ ε)
    (he₂ : |e₂| ≤ ε) : |u - w| ≤ (|(d : ℝ)| + |(b : ℝ)|) * ε := by
  have hDu : ((a * d - b * c : ℤ) : ℝ) * (u - w) = d * e₁ - b * e₂ := by
    push_cast at hw ⊢
    linear_combination (d : ℝ) * h₁ - (b : ℝ) * h₂ + hw
  have hD1 : (1 : ℝ) ≤ |((a * d - b * c : ℤ) : ℝ)| := by
    rw [← Int.cast_abs]; exact_mod_cast Int.one_le_abs hD
  have hrhs : |(d : ℝ) * e₁ - b * e₂| ≤ (|(d : ℝ)| + |(b : ℝ)|) * ε := by
    calc |(d : ℝ) * e₁ - b * e₂| ≤ |(d : ℝ) * e₁| + |(b : ℝ) * e₂| := abs_sub _ _
      _ = |(d : ℝ)| * |e₁| + |(b : ℝ)| * |e₂| := by rw [abs_mul, abs_mul]
      _ ≤ |(d : ℝ)| * ε + |(b : ℝ)| * ε := by gcongr
      _ = _ := by ring
  have := congrArg abs hDu
  rw [abs_mul] at this
  calc |u - w| ≤ |((a * d - b * c : ℤ) : ℝ)| * |u - w| :=
        le_mul_of_one_le_left (abs_nonneg _) hD1
    _ = _ := this
    _ ≤ _ := hrhs


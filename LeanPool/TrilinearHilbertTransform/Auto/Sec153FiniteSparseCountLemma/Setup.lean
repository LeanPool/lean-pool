/-- Blueprint lines 2608-2609 (many four-step paths): in a bipartite graph with parts of size
at most `M` and at least `η M²` edges, some subset `B₀` of the first part with
`|B₀| ≥ η M / 3` has at least `η⁵ M³ / 160000` four-step paths between any two of its vertices
(repetitions allowed). -/
theorem many_four_paths (P : Finset X) (Q : Finset Y) (E : Finset (X × Y))
    (hE : E ⊆ P ×ˢ Q) {M η : ℝ} (hM : 0 < M) (hPM : (P.card : ℝ) ≤ M) (hQM : (Q.card : ℝ) ≤ M)
    (hη : 0 < η) (hEη : η * M ^ 2 ≤ E.card) :
    ∃ B₀ ⊆ P, η * M / 3 ≤ B₀.card ∧ ∀ a ∈ B₀, ∀ a' ∈ B₀,
      η ^ 5 * M ^ 3 / 160000 ≤ ((bipFourPaths P Q E a a').card : ℝ) := by
  classical
  set c₀ : ℝ := 1 / 200
  set bad : X → X → Prop := fun x x' => (bipCodeg Q E x x' : ℝ) < c₀ * η ^ 2 * M
  set nb := bipNbhd P E
  set badY : Y → ℕ := fun y => ((nb y ×ˢ nb y).filter fun p => bad p.1 p.2).card
  -- the second part is nonempty
  have hQ0 : 0 < Q.card := by
    rcases Nat.eq_zero_or_pos Q.card with h | h
    · have : E = ∅ := by
        rw [Finset.card_eq_zero.mp h, Finset.product_empty] at hE
        exact Finset.subset_empty.mp hE
      rw [this] at hEη; simp at hEη; nlinarith only [sq_nonneg M, mul_pos hη (pow_pos hM 2), hEη]
    · exact h
  have hQ0' : (0 : ℝ) < Q.card := by exact_mod_cast hQ0
  -- second moment of neighborhood sizes
  have hsum1 : ∑ y ∈ Q, ((nb y).card : ℝ) = E.card := by
    exact_mod_cast sum_card_bipNbhd P Q E hE
  have hsq : (E.card : ℝ) ^ 2 ≤ Q.card * ∑ y ∈ Q, ((nb y).card : ℝ) ^ 2 := by
    rw [← hsum1]; exact sq_sum_le_card_mul_sum_sq
  have hsum2 : η ^ 2 * M ^ 3 ≤ ∑ y ∈ Q, ((nb y).card : ℝ) ^ 2 := by
    have h1 : (η * M ^ 2) ^ 2 ≤ (E.card : ℝ) ^ 2 := pow_le_pow_left₀ (by positivity) hEη 2
    have h2 : Q.card * ∑ y ∈ Q, ((nb y).card : ℝ) ^ 2 ≤ M * ∑ y ∈ Q, ((nb y).card : ℝ) ^ 2 :=
      mul_le_mul_of_nonneg_right hQM (Finset.sum_nonneg fun _ _ => by positivity)
    have : η ^ 2 * M ^ 3 * M ≤ M * ∑ y ∈ Q, ((nb y).card : ℝ) ^ 2 := by nlinarith
    nlinarith only [hM, hsq, h1, h2]
  -- expected number of bad pairs
  have hbad : ∑ y ∈ Q, (badY y : ℝ) ≤ c₀ * η ^ 2 * M ^ 3 := by
    have e := sum_card_pairs_bipNbhd P Q E bad
    have e' : ∑ y ∈ Q, (badY y : ℝ) = ∑ p ∈ (P ×ˢ P).filter (fun p => bad p.1 p.2),
        (bipCodeg Q E p.1 p.2 : ℝ) := by exact_mod_cast e
    rw [e']
    calc ∑ p ∈ (P ×ˢ P).filter (fun p => bad p.1 p.2), (bipCodeg Q E p.1 p.2 : ℝ)
        ≤ ∑ p ∈ (P ×ˢ P).filter (fun p => bad p.1 p.2), c₀ * η ^ 2 * M :=
          Finset.sum_le_sum fun p hp => (Finset.mem_filter.mp hp).2.le
      _ ≤ ∑ _p ∈ P ×ˢ P, c₀ * η ^ 2 * M :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
            fun _ _ _ => by positivity
      _ = (P.card : ℝ) ^ 2 * (c₀ * η ^ 2 * M) := by
          rw [Finset.sum_const, Finset.card_product, nsmul_eq_mul]; push_cast; ring
      _ ≤ M ^ 2 * (c₀ * η ^ 2 * M) := by gcongr
      _ = c₀ * η ^ 2 * M ^ 3 := by ring
  -- choose a good neighborhood
  obtain ⟨y, hyQ, hy⟩ : ∃ y ∈ Q, η ^ 2 * M ^ 2 / 2 ≤
      ((nb y).card : ℝ) ^ 2 - 100 * badY y := by
    by_contra hcon
    push Not at hcon
    have : ∑ y ∈ Q, (((nb y).card : ℝ) ^ 2 - 100 * badY y) <
        ∑ _y ∈ Q, η ^ 2 * M ^ 2 / 2 := Finset.sum_lt_sum_of_nonempty
          (Finset.card_pos.mp hQ0) hcon
    rw [Finset.sum_sub_distrib, ← Finset.mul_sum, Finset.sum_const, nsmul_eq_mul] at this
    have : (Q.card : ℝ) * (η ^ 2 * M ^ 2 / 2) ≤ M * (η ^ 2 * M ^ 2 / 2) := by gcongr
    have hb' : 100 * ∑ y ∈ Q, (badY y : ℝ) ≤ η ^ 2 * M ^ 3 / 2 := by
      have := hbad; simp only [c₀] at this; linarith
    nlinarith
  set Yn := nb y
  have hYsq : η ^ 2 * M ^ 2 / 2 ≤ (Yn.card : ℝ) ^ 2 := by
    have : (0 : ℝ) ≤ badY y := by positivity
    linarith
  have hYlow : η * M / 2 ≤ Yn.card := by
    have h0 : 0 ≤ η * M / 2 := by positivity
    nlinarith only [sq_nonneg ((Yn.card : ℝ) - η * M / 2), hy]
  have hbadY : (100 : ℝ) * badY y ≤ (Yn.card : ℝ) ^ 2 := by
    have : 0 ≤ η ^ 2 * M ^ 2 / 2 := by positivity
    linarith
  -- delete vertices with many bad partners
  set! partners : X → ℕ := fun x => (Yn.filter fun x' => bad x x').card
  set! D := Yn.filter fun x => (Yn.card : ℝ) / 4 < partners x
  set! B₀ := Yn \ D
  have hpart_sum : ∑ x ∈ Yn, (partners x : ℝ) = badY y := by
    have : ∑ x ∈ Yn, partners x = badY y := by
      simp only [partners, badY]
      rw [Finset.card_filter, Finset.sum_product]
      refine Finset.sum_congr rfl fun x _ => ?_
      rw [Finset.card_filter]
    exact_mod_cast this
  have hD : (D.card : ℝ) * ((Yn.card : ℝ) / 4) ≤ badY y := by
    rw [← hpart_sum]
    calc (D.card : ℝ) * ((Yn.card : ℝ) / 4) = ∑ _x ∈ D, (Yn.card : ℝ) / 4 := by
          rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ ∑ x ∈ D, (partners x : ℝ) :=
          Finset.sum_le_sum fun x hx => (Finset.mem_filter.mp hx).2.le
      _ ≤ ∑ x ∈ Yn, (partners x : ℝ) :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
            fun _ _ _ => by positivity
  have hYpos : (0 : ℝ) < Yn.card := lt_of_lt_of_le (by positivity) hYlow
  have hDcard : (D.card : ℝ) ≤ Yn.card / 25 := by
    have : (D.card : ℝ) * ((Yn.card : ℝ) / 4) ≤ (Yn.card : ℝ) ^ 2 / 100 := by linarith
    nlinarith only [hy, hD, hYpos]
  have hB₀card : η * M / 3 ≤ B₀.card := by
    have : (B₀.card : ℝ) = Yn.card - D.card := by
      rw [Finset.card_sdiff_of_subset (Finset.filter_subset _ _)]
      push_cast [Finset.card_le_card (Finset.filter_subset _ Yn)]; ring
    rw [this]; nlinarith only [hy, hYlow, hD, hYpos]
  have hYP : Yn ⊆ P := Finset.filter_subset _ _
  refine ⟨B₀, (Finset.sdiff_subset).trans hYP, hB₀card, fun a ha a' ha' => ?_⟩
  -- common good partners
  have hgood : ∀ x ∈ B₀, (partners x : ℝ) ≤ Yn.card / 4 := by
    intro x hx
    have := (Finset.mem_sdiff.mp hx).2
    simp only [D, Finset.mem_filter, not_and, not_lt] at this
    exact this (Finset.mem_sdiff.mp hx).1
  set! Z := Yn.filter fun z => ¬ bad a z ∧ ¬ bad z a'
  have hZ : (Yn.card : ℝ) / 2 ≤ Z.card := by
    have hsub : Yn ⊆ Z ∪ ((Yn.filter fun z => bad a z) ∪ (Yn.filter fun z => bad a' z)) := by
      intro z hz
      by_cases h1 : bad a z
      · exact Finset.mem_union_right _ (Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨hz, h1⟩))
      by_cases h2 : bad z a'
      · refine Finset.mem_union_right _ (Finset.mem_union_right _
          (Finset.mem_filter.mpr ⟨hz, ?_⟩))
        simp only [bad] at h2 ⊢; rwa [bipCodeg_comm]
      · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨hz, h1, h2⟩)
    have h := (Finset.card_le_card hsub).trans ((Finset.card_union_le _ _).trans
      (Nat.add_le_add_left (Finset.card_union_le _ _) _))
    have h' : (Yn.card : ℝ) ≤ Z.card + (partners a + partners a') := by
      exact_mod_cast (show Yn.card ≤ Z.card + (partners a + partners a') by
        simpa [partners] using h)
    linarith [hgood a ha, hgood a' ha']
  rw [card_bipFourPaths]
  push_cast
  calc η ^ 5 * M ^ 3 / 160000 ≤ (Yn.card : ℝ) / 2 * (c₀ * η ^ 2 * M) ^ 2 := by
        have : η * M / 4 ≤ (Yn.card : ℝ) / 2 := by linarith
        have h2 : 0 ≤ (c₀ * η ^ 2 * M) ^ 2 := sq_nonneg _
        calc η ^ 5 * M ^ 3 / 160000 = η * M / 4 * (c₀ * η ^ 2 * M) ^ 2 := by
              simp only [c₀]; ring
          _ ≤ _ := mul_le_mul_of_nonneg_right this h2
    _ ≤ (Z.card : ℝ) * (c₀ * η ^ 2 * M) ^ 2 := by gcongr
    _ = ∑ _z ∈ Z, (c₀ * η ^ 2 * M) * (c₀ * η ^ 2 * M) := by
        rw [Finset.sum_const, nsmul_eq_mul]; ring
    _ ≤ ∑ z ∈ Z, (bipCodeg Q E a z : ℝ) * bipCodeg Q E z a' := by

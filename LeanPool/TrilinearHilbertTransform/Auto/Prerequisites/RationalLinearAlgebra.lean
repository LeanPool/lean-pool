/-- Blueprint `lem:rational-linear`: height is the maximum of the absolute
reduced numerator and the positive reduced denominator. -/
def rationalHeight (q : ℚ) : ℕ := max q.num.natAbs q.den

/-- A finite enumeration containing every rational of height at most `B`. -/
def boundedRationalEnumeration (B : ℕ) : Finset ℚ :=
  ((Finset.Icc (-(B : ℤ)) B) ×ˢ (Finset.Icc 1 B)).image
    (fun p : ℤ × ℕ => (p.1 : ℚ) / p.2)

theorem mem_boundedRationalEnumeration {q : ℚ} {B : ℕ}
    (hq : rationalHeight q ≤ B) : q ∈ boundedRationalEnumeration B := by
  obtain ⟨hn, hd⟩ := max_le_iff.mp hq
  have hn' : |q.num| ≤ (B : ℤ) := by
    simpa only [Int.natCast_natAbs] using (show (q.num.natAbs : ℤ) ≤ B by exact_mod_cast hn)
  apply Finset.mem_image.mpr
  refine ⟨(q.num, q.den), Finset.mem_product.mpr ⟨?_, ?_⟩, q.num_div_den⟩
  · exact Finset.mem_Icc.mpr (abs_le.mp hn')
  · exact Finset.mem_Icc.mpr ⟨q.den_pos, hd⟩

theorem boundedRationalEnumeration_card (B : ℕ) (hB : 1 ≤ B) :
    (boundedRationalEnumeration B).card ≤ 3 * B ^ 2 := by
  calc
    _ ≤ (Finset.Icc (-(B : ℤ)) B).card * (Finset.Icc 1 B).card :=
      Finset.card_image_le.trans_eq (Finset.card_product _ _)
    _ = (2 * B + 1) * B := by
      rw [Int.card_Icc, Nat.card_Icc]
      have h : ((B : ℤ) + 1 - -(B : ℤ)) = (2 * B + 1 : ℕ) := by omega
      rw [h, Int.toNat_natCast]
      simp
    _ ≤ _ := by nlinarith

theorem rational_abs_le_height (q : ℚ) : |q| ≤ (rationalHeight q : ℚ) := by
  calc
    |q| = (q.num.natAbs : ℚ) / q.den := by
      conv_lhs => rw [← q.num_div_den]
      rw [abs_div, abs_of_nonneg (show (0 : ℚ) ≤ q.den from Nat.cast_nonneg _)]
      rw [← Int.cast_abs, ← Int.natCast_natAbs, Int.cast_natCast]
    _ ≤ q.num.natAbs := div_le_self (Nat.cast_nonneg _)
      (by exact_mod_cast q.den_pos)
    _ ≤ _ := by exact_mod_cast le_max_left q.num.natAbs q.den

/-- A common denominator for a finite rational tuple, with exactly one
factor for each entry as in `lem:rational-linear`, line 420. -/
def rationalCommonDenominator {ι : Type*} [Fintype ι] (a : ι → ℚ) : ℕ :=
  ∏ i, (a i).den

theorem rationalCommonDenominator_pos {ι : Type*} [Fintype ι] (a : ι → ℚ) :
    0 < rationalCommonDenominator a :=
  Finset.prod_pos (fun i _ => (a i).den_pos)

theorem rationalCommonDenominator_le {ι : Type*} [Fintype ι] (a : ι → ℚ)
    {B : ℕ} (ha : ∀ i, rationalHeight (a i) ≤ B) :
    rationalCommonDenominator a ≤ B ^ Fintype.card ι := by
  calc
    _ ≤ ∏ _i : ι, B := Finset.prod_le_prod
      (fun i _ => (le_max_right _ _).trans (ha i))
    _ = _ := by simp

/-- Clearing all denominators gives integer coordinates of size at most
`B D`, where `D` is their positive common denominator. -/
theorem rational_clear_denominators {ι : Type*} [Fintype ι] (a : ι → ℚ)
    {B : ℕ} (ha : ∀ i, rationalHeight (a i) ≤ B) :
    ∃ z : ι → ℤ, ∀ i,
      (z i : ℚ) = rationalCommonDenominator a * a i ∧
      (z i).natAbs ≤ B * rationalCommonDenominator a := by
  classical
  have hdvd (i) : (a i).den ∣ rationalCommonDenominator a :=
    Finset.dvd_prod_of_mem (fun j => (a j).den) (Finset.mem_univ i)
  choose k hk using hdvd
  refine ⟨fun i => (a i).num * (k i : ℤ), fun i => ⟨?_, ?_⟩⟩
  · rw [Int.cast_mul, Int.cast_natCast, hk i]
    push_cast
    have hn : ((a i).den : ℚ) ≠ 0 := by exact_mod_cast (a i).den_nz
    rw [(div_eq_iff hn).mp (a i).num_div_den]
    ring
  · have hkbound : k i ≤ rationalCommonDenominator a := by
      rw [hk i]
      exact Nat.le_mul_of_pos_left _ (a i).den_pos
    rw [Int.natAbs_mul, Int.natAbs_natCast]
    exact Nat.mul_le_mul ((le_max_left _ _).trans (ha i)) hkbound

/-- Determinant expansion bound for an integer matrix. This also controls
every square minor by applying the same theorem to its submatrix. -/
theorem integerMatrix_det_bound {n : ℕ} (A : Matrix (Fin n) (Fin n) ℤ)
    {K : ℕ} (hA : ∀ i j, (A i j).natAbs ≤ K) :
    A.det.natAbs ≤ n.factorial * K ^ n := by
  have h : |A.det| ≤ (n.factorial : ℤ) * (K : ℤ) ^ n := by
    simpa only [AbsoluteValue.abs_apply, Fintype.card_fin, nsmul_eq_mul] using
      (Matrix.det_le (abv := AbsoluteValue.abs) (x := (K : ℤ)) (fun i j =>
        show |A i j| ≤ (K : ℤ) by
          simpa only [Int.natCast_natAbs] using
            (show ((A i j).natAbs : ℤ) ≤ K by exact_mod_cast hA i j)))
  simpa only [← Int.natCast_natAbs, ← Nat.cast_pow, ← Nat.cast_mul, Nat.cast_le] using h

theorem rationalHeight_div_int_le (a b : ℤ) (hb : b ≠ 0) :
    rationalHeight ((a : ℚ) / b) ≤ max a.natAbs b.natAbs := by
  obtain ⟨c, hc, hd⟩ := Rat.exists_eq_mul_div_num_and_eq_mul_div_den a hb
  have hc0 : c ≠ 0 := by
    intro h
    apply hb
    simpa only [h, zero_mul] using hd
  have hcp : 0 < c.natAbs := Int.natAbs_pos.mpr hc0
  apply max_le
  · apply le_trans _ (le_max_left _ _)
    conv_rhs => rw [hc, Int.natAbs_mul]
    exact Nat.le_mul_of_pos_left _ hcp
  · apply le_trans _ (le_max_right _ _)
    conv_rhs => rw [hd, Int.natAbs_mul, Int.natAbs_natCast]
    exact Nat.le_mul_of_pos_left _ hcp

/-- Blueprint `lem:rational-linear`, line 420: the product of all matrix
denominators is at most `B^(n²)`, and the cleared integer entries are at most
`B^(n²+1)`. The determinant bound is the one from the source expansion. -/
theorem rationalMatrix_clear_denominators {n B : ℕ}
    (A : Matrix (Fin n) (Fin n) ℚ) (hA : ∀ i j, rationalHeight (A i j) ≤ B) :
    ∃ (D : ℕ) (Z : Matrix (Fin n) (Fin n) ℤ),
      0 < D ∧ D ≤ B ^ (n ^ 2) ∧
      (∀ i j, (Z i j : ℚ) = D * A i j) ∧
      (∀ i j, (Z i j).natAbs ≤ B ^ (n ^ 2 + 1)) ∧
      Z.det.natAbs ≤ n.factorial * B ^ (n * (n ^ 2 + 1)) := by
  let a : Fin n × Fin n → ℚ := fun p => A p.1 p.2
  obtain ⟨z, hz⟩ := rational_clear_denominators a (fun p => hA p.1 p.2)
  let D := rationalCommonDenominator a
  let Z : Matrix (Fin n) (Fin n) ℤ := fun i j => z (i, j)
  have hD : D ≤ B ^ (n ^ 2) := by
    simpa only [Fintype.card_prod, Fintype.card_fin, pow_two] using
      rationalCommonDenominator_le a (fun p => hA p.1 p.2)
  have hZ : ∀ i j, (Z i j).natAbs ≤ B ^ (n ^ 2 + 1) := by
    intro i j
    calc
      _ ≤ B * D := (hz (i, j)).2
      _ ≤ B * B ^ (n ^ 2) := Nat.mul_le_mul_left B hD
      _ = _ := by rw [pow_succ B (n ^ 2), mul_comm]
  refine ⟨D, Z, rationalCommonDenominator_pos a, hD,
    fun i j => (hz (i, j)).1, hZ, ?_⟩
  simpa only [← pow_mul, Nat.mul_comm (n ^ 2 + 1) n] using integerMatrix_det_bound Z hZ

theorem integerMatrix_adjugate_bound {n K : ℕ} (hK : 1 ≤ K)
    (Z : Matrix (Fin n) (Fin n) ℤ) (hZ : ∀ i j, (Z i j).natAbs ≤ K) (i j) :
    (Z.adjugate i j).natAbs ≤ n.factorial * K ^ n := by
  rw [Matrix.adjugate_apply]
  apply integerMatrix_det_bound
  intro k l
  simp only [Matrix.updateRow_apply, Pi.single_apply]
  split_ifs <;> simp_all only [Int.natAbs_one, Int.natAbs_zero, zero_le]

/-- The adjugate formula after clearing denominators, keeping the original
matrix inverse and an integer numerator and denominator. -/
theorem rationalMatrix_inverse_entry {n : ℕ} (A : Matrix (Fin n) (Fin n) ℚ)
    (hA : A.det ≠ 0) {D : ℕ} (hD : 0 < D)
    (Z : Matrix (Fin n) (Fin n) ℤ) (hZ : ∀ i j, (Z i j : ℚ) = D * A i j) :
    Z.det ≠ 0 ∧ ∀ i j, A⁻¹ i j = ((D : ℤ) * Z.adjugate i j : ℤ) / (Z.det : ℚ) := by
  let R : Matrix (Fin n) (Fin n) ℚ := (Int.castRingHom ℚ).mapMatrix Z
  have hR : R = (D : ℚ) • A := by ext i j; exact hZ i j
  have hD0 : (D : ℚ) ≠ 0 := by exact_mod_cast hD.ne'
  have hdet : (Z.det : ℚ) = (D : ℚ) ^ n * A.det := by
    calc
      _ = R.det := (Int.castRingHom ℚ).map_det Z
      _ = _ := by rw [hR, Matrix.det_smul, Fintype.card_fin]
  have hZdet : Z.det ≠ 0 := by
    intro hz
    have ht := mul_ne_zero (pow_ne_zero n hD0) hA
    exact ht (by simpa only [hz, Int.cast_zero] using hdet.symm)
  refine ⟨hZdet, fun i j => ?_⟩
  let : Invertible (D : ℚ) := invertibleOfNonzero hD0
  have hi : A⁻¹ = (D : ℚ) • R⁻¹ := by
    rw [hR, Matrix.inv_smul A _ (isUnit_iff_ne_zero.mpr hA), smul_smul]
    simp only [invOf_eq_inv, mul_inv_cancel₀ hD0, one_smul]
  have hadj : R.adjugate i j = (Z.adjugate i j : ℚ) := by
    exact congrArg (fun M : Matrix (Fin n) (Fin n) ℚ => M i j)
      ((Int.castRingHom ℚ).map_adjugate Z).symm
  have hd : R.det = (Z.det : ℚ) := ((Int.castRingHom ℚ).map_det Z).symm
  rw [hi, Matrix.inv_def, Ring.inverse_eq_inv]
  simp only [Matrix.smul_apply, smul_eq_mul, hadj, hd, Int.cast_mul, Int.cast_natCast]
  ring

/-- The explicit Cramer bound underlying `lem:rational-linear`: inverse
entry heights are bounded by a factorial times a polynomial power of `B`. -/
theorem rationalMatrix_inverse_height_raw {n B : ℕ} (hB : 1 ≤ B)
    (A : Matrix (Fin n) (Fin n) ℚ) (hA : ∀ i j, rationalHeight (A i j) ≤ B)
    (hdet : A.det ≠ 0) (i j) :
    rationalHeight (A⁻¹ i j) ≤ n.factorial * B ^ (n ^ 2 + n * (n ^ 2 + 1)) := by
  obtain ⟨D, Z, hD, hDB, hZ, hZB, hdetB⟩ := rationalMatrix_clear_denominators A hA
  obtain ⟨hZd, hinv⟩ := rationalMatrix_inverse_entry A hdet hD Z hZ
  rw [hinv]
  apply (rationalHeight_div_int_le _ _ hZd).trans
  apply max_le
  · rw [Int.natAbs_mul, Int.natAbs_natCast]
    calc
      _ ≤ B ^ (n ^ 2) * (n.factorial * (B ^ (n ^ 2 + 1)) ^ n) :=
        Nat.mul_le_mul hDB (integerMatrix_adjugate_bound (Nat.one_le_pow _ _ hB) Z hZB i j)
      _ = _ := by rw [← pow_mul, Nat.mul_comm (n ^ 2 + 1) n, pow_add]; ring
  · calc
      _ ≤ n.factorial * B ^ (n * (n ^ 2 + 1)) := hdetB
      _ ≤ _ := Nat.mul_le_mul_left _ (Nat.pow_le_pow_right hB (by omega))

theorem euclidean_norm_le_sum_coordinates {n : ℕ} (x : EuclideanSpace ℝ (Fin n)) :
    ‖x‖ ≤ ∑ i, ‖x i‖ := by
  apply (sq_le_sq₀ (norm_nonneg _) (Finset.sum_nonneg (fun _ _ => norm_nonneg _))).mp
  rw [EuclideanSpace.norm_sq_eq]
  exact Finset.sum_sq_le_sq_sum_of_nonneg (fun _ _ => norm_nonneg _)

/-- An entrywise bound controls the Euclidean operator norm. The harmless
quadratic dimension factor is absorbed in the source exponential bound. -/
theorem realMatrix_operatorNorm_le {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ)
    {K : ℝ} (hK : 0 ≤ K) (hA : ∀ i j, |A i j| ≤ K) :
    ‖Matrix.toEuclideanCLM (𝕜 := ℝ) A‖ ≤ (n : ℝ) ^ 2 * K := by
  apply ContinuousLinearMap.opNorm_le_bound _ (by positivity)
  intro x
  calc
    _ ≤ ∑ i, ‖(Matrix.toEuclideanCLM (𝕜 := ℝ) A x) i‖ := euclidean_norm_le_sum_coordinates _
    _ = ∑ i, ‖∑ j, A i j * x j‖ := rfl
    _ ≤ ∑ i, ∑ j, ‖A i j * x j‖ := Finset.sum_le_sum (fun _ _ => norm_sum_le _ _)
    _ ≤ ∑ _i : Fin n, ∑ _j : Fin n, K * ‖x‖ := by
      apply Finset.sum_le_sum
      intro i _
      apply Finset.sum_le_sum
      intro j _
      rw [norm_mul, Real.norm_eq_abs]
      exact mul_le_mul (hA i j) (PiLp.norm_apply_le x j) (norm_nonneg _) hK
    _ = _ := by simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      nsmul_eq_mul]; ring

theorem rational_inverse_budget (n B : ℕ) (hB : 1 ≤ B) :
    (n + 1) ^ 2 * (n.factorial * B ^ (n ^ 2 + n * (n ^ 2 + 1))) ≤
      (2 * B) ^ (2 * (n + 1) ^ 4) := by
  have hf : n.factorial ≤ 2 ^ (n ^ 2) := by
    calc
      _ ≤ n ^ n := Nat.factorial_le_pow n
      _ ≤ (2 ^ n) ^ n := Nat.pow_le_pow_left Nat.lt_two_pow_self.le n
      _ = _ := by rw [← pow_mul, pow_two]
  have hn : (n + 1) ^ 2 ≤ 2 ^ (2 * (n + 1)) := by
    calc
      _ ≤ (2 ^ (n + 1)) ^ 2 := Nat.pow_le_pow_left Nat.lt_two_pow_self.le 2
      _ = _ := by rw [← pow_mul, Nat.mul_comm]
  have hb2 : 2 ≤ 2 * B := by omega
  have hb : B ≤ 2 * B := by omega
  calc
    _ ≤ (2 * B) ^ (2 * (n + 1)) *
        ((2 * B) ^ (n ^ 2) * (2 * B) ^ (n ^ 2 + n * (n ^ 2 + 1))) :=
      Nat.mul_le_mul (hn.trans (Nat.pow_le_pow_left hb2 _))
        (Nat.mul_le_mul (hf.trans (Nat.pow_le_pow_left hb2 _)) (Nat.pow_le_pow_left hb _))
    _ = (2 * B) ^ (2 * (n + 1) + (n ^ 2 + (n ^ 2 + n * (n ^ 2 + 1)))) := by
      simp only [pow_add]
    _ ≤ _ := Nat.pow_le_pow_right (by omega) (by nlinarith only [Nat.zero_le (n ^ 4)])

/-- Blueprint `lem:rational-linear`, lines 418–420: nonsingular rational
inverses have entry heights and Euclidean operator norm at most
`exp (2 (d+1)^4 log (2B))`, uniformly for dimensions at most `d`. -/
theorem rationalMatrix_inverse_bounds {n d : ℕ} (hnd : n ≤ d)
    {B : ℝ} (hB : 2 ≤ B) (A : Matrix (Fin n) (Fin n) ℚ)
    (hA : ∀ i j, (rationalHeight (A i j) : ℝ) ≤ B) (hdet : A.det ≠ 0) :
    (∀ i j, (rationalHeight (A⁻¹ i j) : ℝ) ≤
      Real.exp (2 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B))) ∧
    ‖Matrix.toEuclideanCLM (𝕜 := ℝ) (A⁻¹.map (fun q => (q : ℝ)))‖ ≤
      Real.exp (2 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B)) := by
  let b := ⌊B⌋₊
  let R := n.factorial * b ^ (n ^ 2 + n * (n ^ 2 + 1))
  have hb : 1 ≤ b := Nat.le_floor (by norm_num; linarith)
  have hheight (i j) : rationalHeight (A⁻¹ i j) ≤ R :=
    rationalMatrix_inverse_height_raw hb A (fun i j => Nat.le_floor (hA i j)) hdet i j
  have htotal : (((n + 1) ^ 2 * R : ℕ) : ℝ) ≤
      Real.exp (2 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B)) := by
    calc
      _ ≤ (2 * (b : ℝ)) ^ (2 * (n + 1) ^ 4) := by
        exact_mod_cast rational_inverse_budget n b hb
      _ ≤ (2 * B) ^ (2 * (n + 1) ^ 4) := by
        apply pow_le_pow_left₀ (by positivity)
        have := Nat.floor_le (show 0 ≤ B by linarith)
        dsimp [b]
        linarith
      _ ≤ (2 * B) ^ (2 * (d + 1) ^ 4) :=
        pow_le_pow_right₀ (by linarith)
          (Nat.mul_le_mul_left 2 (Nat.pow_le_pow_left (Nat.add_le_add_right hnd 1) 4))
      _ = _ := by
        have he : 2 * (d + 1 : ℝ) ^ 4 = ((2 * (d + 1) ^ 4 : ℕ) : ℝ) := by push_cast; rfl
        rw [he, Real.exp_nat_mul, Real.exp_log (by linarith : 0 < 2 * B)]
  constructor
  · intro i j
    apply le_trans _ htotal
    exact_mod_cast (hheight i j).trans
      (Nat.le_mul_of_pos_left R (by positivity : 0 < (n + 1) ^ 2))
  · apply (realMatrix_operatorNorm_le _ (Nat.cast_nonneg R) ?_).trans
      ((show (n : ℝ) ^ 2 * R ≤ (((n + 1) ^ 2 * R : ℕ) : ℝ) by
        push_cast
        exact mul_le_mul_of_nonneg_right
          (by nlinarith [Nat.cast_nonneg (α := ℝ) n]) (Nat.cast_nonneg R)).trans htotal)
    intro i j
    change |(A⁻¹ i j : ℝ)| ≤ (R : ℝ)
    have hh : |A⁻¹ i j| ≤ (R : ℚ) :=
      (rational_abs_le_height _).trans (by exact_mod_cast hheight i j)
    exact_mod_cast hh

/-- Select a basis from a finite rational spanning list. Its size is bounded
by the ambient dimension, independently of the length of the list. -/
theorem rational_spanning_subfamily {m n : ℕ} (v : Fin m → Fin n → ℚ) :
    ∃ (r : ℕ) (_hr : r ≤ n) (e : Fin r ↪ Fin m),
      LinearIndependent ℚ (fun i => v (e i)) ∧
      Submodule.span ℚ (Set.range (fun i => v (e i))) = Submodule.span ℚ (Set.range v) := by
  classical
  obtain ⟨κ, a, ha, hspan, hlin⟩ := exists_linearIndependent' ℚ v
  let : Finite κ := Finite.of_injective a ha
  let : Fintype κ := Fintype.ofFinite κ
  let e : Fin (Fintype.card κ) ↪ Fin m :=
    ⟨a ∘ (Fintype.equivFin κ).symm, ha.comp (Fintype.equivFin κ).symm.injective⟩
  refine ⟨Fintype.card κ, ?_, e, ?_, ?_⟩
  · simpa using hlin.fintype_card_le_finrank
  · exact hlin.comp (Fintype.equivFin κ).symm (Fintype.equivFin κ).symm.injective
  · have hrange : Set.range (fun i => v (e i)) = Set.range (v ∘ a) := by
      change Set.range ((v ∘ a) ∘ (Fintype.equivFin κ).symm) = _
      rw [Set.range_comp, Set.range_eq_univ.mpr (Fintype.equivFin κ).symm.surjective,
        Set.image_univ]
    rw [hrange]
    exact hspan

/-- A full-rank square minor obtained by selecting independent columns and
then independent rows. Its columns span the complete matrix range. -/
theorem rational_pivot_minor {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℚ) :
    ∃ (r : ℕ) (_hrm : r ≤ m) (_hrn : r ≤ n)
      (rows : Fin r ↪ Fin m) (cols : Fin r ↪ Fin n),
      (A.submatrix rows cols).det ≠ 0 ∧
      Submodule.span ℚ (Set.range (fun j => A.col (cols j))) =
        Submodule.span ℚ (Set.range A.col) := by
  obtain ⟨r, hrm, cols, hc, hspan⟩ := rational_spanning_subfamily A.col
  have hrn : r ≤ n := by simpa using Fintype.card_le_of_injective cols cols.injective
  let C : Matrix (Fin m) (Fin r) ℚ := A.submatrix id cols
  obtain ⟨s, hsr, rows, hrows, hrowspan⟩ := rational_spanning_subfamily C.row
  have hrank : C.rank = r := by
    have ht : LinearIndependent ℚ C.transpose.row := hc
    simpa only [Matrix.rank_transpose, Fintype.card_fin] using ht.rank_matrix
  have hs : s = r := by
    have hsmall : (C.submatrix rows id).rank = s := by
      simpa only [Fintype.card_fin] using
        (show LinearIndependent ℚ (C.submatrix rows id).row from hrows).rank_matrix
    have hsame : (C.submatrix rows id).rank = C.rank := by
      rw [Matrix.rank_eq_finrank_span_row, Matrix.rank_eq_finrank_span_row]
      exact congrArg (fun S : Submodule ℚ (Fin r → ℚ) => Module.finrank ℚ S) hrowspan
    omega
  subst s
  refine ⟨r, hrm, hrn, rows, cols, ?_, hspan⟩
  have hunit := Matrix.linearIndependent_rows_iff_isUnit.mp hrows
  exact isUnit_iff_ne_zero.mp ((Matrix.isUnit_iff_isUnit_det _).mp hunit)

/-- Place a small matrix in specified rows and columns, with zero entries
outside them. This is the pivot solution with all other coordinates zero. -/
noncomputable def rationalMatrixZeroExtend {r s m n : ℕ}
    (rows : Fin r ↪ Fin m) (cols : Fin s ↪ Fin n)
    (M : Matrix (Fin r) (Fin s) ℚ) : Matrix (Fin m) (Fin n) ℚ :=
  Function.extend rows (fun i => Function.extend cols (M i) 0) 0

theorem rationalMatrixZeroExtend_apply {r s m n : ℕ}
    (rows : Fin r ↪ Fin m) (cols : Fin s ↪ Fin n)
    (M : Matrix (Fin r) (Fin s) ℚ) (i j) :
    rationalMatrixZeroExtend rows cols M (rows i) (cols j) = M i j := by
  simp only [rationalMatrixZeroExtend, rows.injective.extend_apply, cols.injective.extend_apply]

theorem rationalMatrixZeroExtend_entry {r s m n : ℕ}
    (rows : Fin r ↪ Fin m) (cols : Fin s ↪ Fin n)
    (M : Matrix (Fin r) (Fin s) ℚ) (i j) :
    rationalMatrixZeroExtend rows cols M i j = 0 ∨
      ∃ k l, rationalMatrixZeroExtend rows cols M i j = M k l := by
  classical
  by_cases hi : i ∈ Set.range rows
  · obtain ⟨k, rfl⟩ := hi
    by_cases hj : j ∈ Set.range cols
    · obtain ⟨l, rfl⟩ := hj
      exact Or.inr ⟨k, l, rationalMatrixZeroExtend_apply rows cols M k l⟩
    · left
      simp only [rationalMatrixZeroExtend, rows.injective.extend_apply]
      exact Function.extend_apply' _ _ _ hj
  · left
    simp only [rationalMatrixZeroExtend, Function.extend_apply' _ _ _ hi, Pi.zero_apply]

theorem rational_mulVec_extend {r m n : ℕ} (cols : Fin r ↪ Fin n)
    (A : Matrix (Fin m) (Fin n) ℚ) (v : Fin r → ℚ) :
    A.mulVec (Function.extend cols v 0) = (A.submatrix id cols).mulVec v := by
  classical
  ext i
  change (∑ j, A i j * Function.extend cols v 0 j) = ∑ k, A i (cols k) * v k
  symm
  apply Fintype.sum_of_injective cols cols.injective
  · intro j hj
    rw [Function.extend_apply' _ _ _ hj]
    exact mul_zero _
  · intro k
    rw [cols.injective.extend_apply]

theorem rationalMatrixZeroExtend_mulVec {r s m n : ℕ}
    (rows : Fin r ↪ Fin m) (cols : Fin s ↪ Fin n)
    (M : Matrix (Fin r) (Fin s) ℚ) (v : Fin n → ℚ) :
    (rationalMatrixZeroExtend rows cols M).mulVec v =
      Function.extend rows (M.mulVec (v ∘ cols)) 0 := by
  classical
  ext i
  by_cases hi : i ∈ Set.range rows
  · obtain ⟨k, rfl⟩ := hi
    simp only [Matrix.mulVec, dotProduct, rationalMatrixZeroExtend,
      rows.injective.extend_apply, Function.comp_apply]
    symm
    apply Fintype.sum_of_injective cols cols.injective
    · intro j hj
      rw [Function.extend_apply' _ _ _ hj]
      exact zero_mul _
    · intro l
      rw [cols.injective.extend_apply]
  · simp only [Matrix.mulVec, dotProduct, rationalMatrixZeroExtend,
      Function.extend_apply' _ _ _ hi, Pi.zero_apply, zero_mul, Finset.sum_const_zero]

/-- Solving the pivot subsystem and setting nonpivot coordinates to zero
gives a right inverse on the full range, as in `lem:rational-linear`. -/
theorem rational_pivot_rightInverse {m n r : ℕ}
    (A : Matrix (Fin m) (Fin n) ℚ) (rows : Fin r ↪ Fin m) (cols : Fin r ↪ Fin n)
    (hdet : (A.submatrix rows cols).det ≠ 0)
    (hspan : Submodule.span ℚ (Set.range (fun j => A.col (cols j))) =
      Submodule.span ℚ (Set.range A.col)) :
    ∀ y ∈ LinearMap.range A.mulVecLin,
      A.mulVec ((rationalMatrixZeroExtend cols rows (A.submatrix rows cols)⁻¹).mulVec y) = y := by
  intro y hy
  let C : Matrix (Fin m) (Fin r) ℚ := A.submatrix id cols
  have hyC : y ∈ LinearMap.range C.mulVecLin := by
    rw [Matrix.range_mulVecLin] at hy ⊢
    exact hspan.symm ▸ hy
  obtain ⟨v, rfl⟩ := hyC
  rw [rationalMatrixZeroExtend_mulVec, rational_mulVec_extend]
  have hv : (C.mulVecLin v) ∘ rows = (A.submatrix rows cols).mulVec v := rfl
  rw [hv, Matrix.mulVec_mulVec v (A.submatrix rows cols)⁻¹ (A.submatrix rows cols),
    Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hdet), Matrix.one_mulVec]
  rfl

/-- The real Euclidean operator attached to a possibly rectangular matrix. -/
noncomputable def realMatrixOperator {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) :
    EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin m) :=
  LinearMap.toContinuousLinearMap (Matrix.toEuclideanLin (𝕜 := ℝ) A)

theorem realMatrixOperator_norm_le {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ)
    {K : ℝ} (hK : 0 ≤ K) (hA : ∀ i j, |A i j| ≤ K) :
    ‖realMatrixOperator A‖ ≤ (m : ℝ) * n * K := by
  apply ContinuousLinearMap.opNorm_le_bound _ (by positivity)
  intro x
  calc
    _ ≤ ∑ i, ‖(realMatrixOperator A x) i‖ := euclidean_norm_le_sum_coordinates _
    _ = ∑ i, ‖∑ j, A i j * x j‖ := rfl
    _ ≤ ∑ i, ∑ j, ‖A i j * x j‖ := Finset.sum_le_sum (fun _ _ => norm_sum_le _ _)
    _ ≤ ∑ _i : Fin m, ∑ _j : Fin n, K * ‖x‖ := by
      apply Finset.sum_le_sum
      intro i _
      apply Finset.sum_le_sum
      intro j _
      rw [norm_mul, Real.norm_eq_abs]
      exact mul_le_mul (hA i j) (PiLp.norm_apply_le x j) (norm_nonneg _) hK
    _ = _ := by simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      nsmul_eq_mul]; ring

theorem dimension_sq_le_rational_budget (d : ℕ) {B : ℝ} (hB : 2 ≤ B) :
    (d : ℝ) ^ 2 ≤ Real.exp (2 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B)) := by
  calc
    _ ≤ (2 : ℝ) ^ (2 * d) := by
      have h : d ^ 2 ≤ 2 ^ (2 * d) := by
        calc
          _ ≤ (2 ^ d) ^ 2 := Nat.pow_le_pow_left Nat.lt_two_pow_self.le 2
          _ = _ := by rw [← pow_mul, Nat.mul_comm]
      exact_mod_cast h
    _ ≤ (2 * B) ^ (2 * d) := pow_le_pow_left₀ (by norm_num) (by linarith) _
    _ ≤ (2 * B) ^ (2 * (d + 1) ^ 4) :=
      pow_le_pow_right₀ (by linarith)
        (by nlinarith [Nat.zero_le (d ^ 4), Nat.zero_le (d ^ 3), Nat.zero_le (d ^ 2)])
    _ = _ := by
      have he : 2 * (d + 1 : ℝ) ^ 4 = ((2 * (d + 1) ^ 4 : ℕ) : ℝ) := by push_cast; rfl
      rw [he, Real.exp_nat_mul, Real.exp_log (by linarith : 0 < 2 * B)]

/-- Blueprint `lem:rational-linear`: every rational matrix has a rational
right inverse on its range, with uniformly bounded height and Euclidean
operator norm. The construction uses a pivot minor and zero coordinates. -/
theorem rationalMatrix_rightInverse_bounds {m n d : ℕ} (hm : m ≤ d) (hn : n ≤ d)
    {B : ℝ} (hB : 2 ≤ B) (A : Matrix (Fin m) (Fin n) ℚ)
    (hA : ∀ i j, (rationalHeight (A i j) : ℝ) ≤ B) :
    ∃ U : Matrix (Fin n) (Fin m) ℚ,
      (∀ y ∈ LinearMap.range A.mulVecLin, A.mulVec (U.mulVec y) = y) ∧
      (∀ i j, (rationalHeight (U i j) : ℝ) ≤
        Real.exp (4 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B))) ∧
      ‖realMatrixOperator (U.map (fun q => (q : ℝ)))‖ ≤
        Real.exp (4 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B)) := by
  obtain ⟨r, hrm, _hrn, rows, cols, hd, hspan⟩ := rational_pivot_minor A
  let M := A.submatrix rows cols
  let U := rationalMatrixZeroExtend cols rows M⁻¹
  let E := Real.exp (2 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B))
  have hE : 1 ≤ E := Real.one_le_exp_iff.mpr
    (mul_nonneg (by positivity) (Real.log_nonneg (by linarith)))
  have hE0 : 0 ≤ E := le_trans zero_le_one hE
  have hdouble : E * E = Real.exp (4 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B)) := by
    rw [← Real.exp_add]
    congr 1
    ring
  have hi := (rationalMatrix_inverse_bounds (hrm.trans hm) hB M
    (fun i j => hA (rows i) (cols j)) hd).1
  have hU (i j) : (rationalHeight (U i j) : ℝ) ≤ E := by
    rcases rationalMatrixZeroExtend_entry cols rows M⁻¹ i j with hz | ⟨k, l, he⟩
    · change (rationalHeight (rationalMatrixZeroExtend cols rows M⁻¹ i j) : ℝ) ≤ E
      simpa only [hz, rationalHeight, Rat.num_zero, Rat.den_zero, Int.natAbs_zero,
        max_eq_right (Nat.zero_le 1), Nat.cast_one] using hE
    · change (rationalHeight (rationalMatrixZeroExtend cols rows M⁻¹ i j) : ℝ) ≤ E
      rw [he]
      exact hi k l
  refine ⟨U, rational_pivot_rightInverse A rows cols hd hspan, ?_, ?_⟩
  · intro i j
    rw [← hdouble]
    exact (hU i j).trans (le_mul_of_one_le_right hE0 hE)
  · rw [← hdouble]
    apply (realMatrixOperator_norm_le _ hE0 ?_).trans
    · have hdim : (n : ℝ) * m ≤ E := by
        apply le_trans _ (dimension_sq_le_rational_budget d hB)
        have hm' : (m : ℝ) ≤ d := by exact_mod_cast hm
        have hn' : (n : ℝ) ≤ d := by exact_mod_cast hn
        nlinarith [Nat.cast_nonneg (α := ℝ) m, Nat.cast_nonneg (α := ℝ) n]
      exact mul_le_mul_of_nonneg_right hdim hE0
    · intro i j
      change |(U i j : ℝ)| ≤ E
      have habs : |(U i j : ℝ)| ≤ (rationalHeight (U i j) : ℝ) := by
        exact_mod_cast rational_abs_le_height (U i j)
      exact habs.trans (hU i j)

theorem height_le_rational_budget (d : ℕ) {B : ℝ} (hB : 2 ≤ B) :
    B ≤ Real.exp (2 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B)) := by
  have he : 2 * (d + 1 : ℝ) ^ 4 = ((2 * (d + 1) ^ 4 : ℕ) : ℝ) := by push_cast; rfl
  rw [he, Real.exp_nat_mul, Real.exp_log (by linarith : 0 < 2 * B)]
  exact (show B ≤ 2 * B by linarith).trans
    (le_self_pow₀ (by linarith : 1 ≤ 2 * B) (by positivity))

theorem rational_gram_det_ne_zero {r n : ℕ} (S : Matrix (Fin r) (Fin n) ℚ)
    (hS : LinearIndependent ℚ S.row) : (S * S.transpose).det ≠ 0 := by
  have hc : LinearIndependent ℚ S.transpose.col := hS
  have hk : S.transpose.mulVecLin.ker = ⊥ :=
    LinearMap.ker_eq_bot.mpr (Matrix.mulVec_injective_iff.mpr hc)
  have hg : (S * S.transpose).mulVecLin.ker = ⊥ := by
    simpa only [Matrix.transpose_transpose] using
      (Matrix.ker_mulVecLin_transpose_mul_self S.transpose).trans hk
  exact isUnit_iff_ne_zero.mp ((Matrix.isUnit_iff_isUnit_det _).mp
    (Matrix.mulVec_injective_iff_isUnit.mp (LinearMap.ker_eq_bot.mp hg)))

theorem realMatrixOperator_apply {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ)
    (x : EuclideanSpace ℝ (Fin n)) : (realMatrixOperator A x).ofLp = A.mulVec x.ofLp := rfl

theorem realMatrixOperator_mul_apply {l m n : ℕ}
    (A : Matrix (Fin l) (Fin m) ℝ) (B : Matrix (Fin m) (Fin n) ℝ)
    (x : EuclideanSpace ℝ (Fin n)) :
    realMatrixOperator (A * B) x = realMatrixOperator A (realMatrixOperator B x) := by
  ext i
  exact congrFun (Matrix.mulVec_mulVec x.ofLp A B).symm i

theorem realMatrixOperator_transpose_inner {m n : ℕ}
    (A : Matrix (Fin m) (Fin n) ℝ) (x : EuclideanSpace ℝ (Fin n))
    (y : EuclideanSpace ℝ (Fin m)) :
    inner ℝ (realMatrixOperator A x) y = inner ℝ x (realMatrixOperator A.transpose y) := by
  simp only [EuclideanSpace.inner_eq_star_dotProduct, star_trivial, realMatrixOperator_apply]
  rw [Matrix.dotProduct_mulVec, Matrix.mulVec_transpose]

/-- The Gram inverse formula is the actual orthogonal projection onto the
row space, not merely an idempotent with the same rational dimension. -/
theorem real_gram_projection {r n : ℕ} (S : Matrix (Fin r) (Fin n) ℝ)
    (hS : (S * S.transpose).det ≠ 0) :
    realMatrixOperator (S.transpose * (S * S.transpose)⁻¹ * S) =
      (realMatrixOperator S.transpose).range.starProjection := by
  let P := S.transpose * (S * S.transpose)⁻¹ * S
  have hfix : S * P = S := by
    calc
      _ = ((S * S.transpose) * (S * S.transpose)⁻¹) * S := by
        simp only [P, Matrix.mul_assoc]
      _ = S := by rw [Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hS), Matrix.one_mul]
  apply ContinuousLinearMap.ext
  intro x
  symm
  apply Submodule.eq_starProjection_of_mem_of_inner_eq_zero
  · refine ⟨realMatrixOperator (S * S.transpose)⁻¹ (realMatrixOperator S x), ?_⟩
    simp only [realMatrixOperator_mul_apply]
    rfl
  · rintro w ⟨v, rfl⟩
    change inner ℝ (x - realMatrixOperator P x) (realMatrixOperator S.transpose v) = 0
    rw [← realMatrixOperator_transpose_inner]
    have hz : realMatrixOperator S (x - realMatrixOperator P x) = 0 := by
      rw [map_sub, ← realMatrixOperator_mul_apply, hfix, sub_self]
    rw [hz, inner_zero_left]

/-- The rational matrix in the Gram formula for the orthogonal row-space
projection of `lem:rational-linear`. -/
noncomputable def rationalRowProjection {r n : ℕ} (S : Matrix (Fin r) (Fin n) ℚ) :
    Matrix (Fin n) (Fin n) ℚ := S.transpose * (S * S.transpose)⁻¹ * S

theorem rationalMatrix_cast_inv {n : ℕ} (A : Matrix (Fin n) (Fin n) ℚ)
    (hA : A.det ≠ 0) :
    (A⁻¹).map (fun q => (q : ℝ)) = (A.map (fun q => (q : ℝ)))⁻¹ := by
  let f := Rat.castHom ℝ
  change f.mapMatrix A⁻¹ = (f.mapMatrix A)⁻¹
  symm
  apply Matrix.inv_eq_left_inv
  rw [← map_mul, Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hA), map_one]

/-- The rational Gram formula agrees, after real scalar extension, with
Mathlib's orthogonal projection onto the real row space. -/
theorem rationalRowProjection_eq_starProjection {r n : ℕ}
    (S : Matrix (Fin r) (Fin n) ℚ) (hS : LinearIndependent ℚ S.row) :
    realMatrixOperator ((rationalRowProjection S).map (fun q => (q : ℝ))) =
      (realMatrixOperator (S.transpose.map (fun q => (q : ℝ)))).range.starProjection := by
  let f := Rat.castHom ℝ
  let R := S.map f
  have ht : S.transpose.map f = R.transpose := rfl
  have hmap : (S * S.transpose).map f = R * R.transpose := by
    rw [Matrix.map_mul, ht]
  have hg := rational_gram_det_ne_zero S hS
  have hd : (R * R.transpose).det ≠ 0 := by
    rw [← hmap]
    have he : ((S * S.transpose).map f).det = f (S * S.transpose).det :=
      (f.map_det _).symm
    rw [he]
    change ((S * S.transpose).det : ℝ) ≠ 0
    exact_mod_cast hg
  have hp : (rationalRowProjection S).map f = R.transpose * (R * R.transpose)⁻¹ * R := by
    unfold rationalRowProjection
    rw [Matrix.map_mul, Matrix.map_mul, ht]
    have hi : ((S * S.transpose)⁻¹).map f = ((S * S.transpose).map f)⁻¹ :=
      rationalMatrix_cast_inv _ hg
    rw [hi, hmap]
  change realMatrixOperator ((rationalRowProjection S).map f) = _
  rw [hp]
  exact real_gram_projection R hd

theorem rationalRowProjection_smul {r n : ℕ} (S : Matrix (Fin r) (Fin n) ℚ)
    (hS : (S * S.transpose).det ≠ 0) {c : ℚ} (hc : c ≠ 0) :
    rationalRowProjection (c • S) = rationalRowProjection S := by
  let : Invertible (c * c) := invertibleOfNonzero (mul_ne_zero hc hc)
  have hgram : (c • S) * (c • S).transpose = (c * c) • (S * S.transpose) := by
    simp only [Matrix.transpose_smul, Matrix.smul_mul, Matrix.mul_smul, smul_smul]
  unfold rationalRowProjection
  rw [hgram, Matrix.transpose_smul,
    Matrix.inv_smul _ (c * c) (isUnit_iff_ne_zero.mpr hS)]
  simp only [Matrix.smul_mul, Matrix.mul_smul, smul_smul, invOf_eq_inv]
  convert one_smul ℚ (S.transpose * (S * S.transpose)⁻¹ * S) using 1
  congr 1
  field_simp

theorem integerMatrix_mul_bound {m n p K L : ℕ}
    (A : Matrix (Fin m) (Fin n) ℤ) (B : Matrix (Fin n) (Fin p) ℤ)
    (hA : ∀ i j, (A i j).natAbs ≤ K) (hB : ∀ i j, (B i j).natAbs ≤ L) (i j) :
    ((A * B) i j).natAbs ≤ n * K * L := by
  rw [Matrix.mul_apply]
  calc
    _ ≤ ∑ k, (A i k * B k j).natAbs := Int.natAbs_sum_le _ _
    _ ≤ ∑ _k : Fin n, K * L := Finset.sum_le_sum (fun k _ => by
      rw [Int.natAbs_mul]
      exact Nat.mul_le_mul (hA i k) (hB k j))
    _ = _ := by simp [mul_assoc]

/-- A single integer numerator and denominator represent every entry of
the projection associated with an integer matrix. -/
theorem integerRowProjection_fraction {r n : ℕ} (Z : Matrix (Fin r) (Fin n) ℤ) (i j) :
    rationalRowProjection (Z.map (fun z => (z : ℚ))) i j =
      (((Z.transpose * (Z * Z.transpose).adjugate * Z) i j : ℤ) : ℚ) /
        ((Z * Z.transpose).det : ℚ) := by
  let f := Int.castRingHom ℚ
  let G := Z * Z.transpose
  have hG : Z.map f * (Z.map f).transpose = G.map f := by
    rw [Matrix.map_mul, Matrix.transpose_map]
  have hd : (G.map f).det = f G.det := (f.map_det G).symm
  have ha : (G.map f).adjugate = G.adjugate.map f := (f.map_adjugate G).symm
  change rationalRowProjection (Z.map f) i j = _
  unfold rationalRowProjection
  rw [hG, Matrix.inv_def, Ring.inverse_eq_inv, hd, ha,
    Matrix.mul_smul, Matrix.smul_mul, Matrix.smul_apply]
  have hnum : ((Z.map f).transpose * G.adjugate.map f * Z.map f) i j =
      f ((Z.transpose * G.adjugate * Z) i j) := by
    rw [← Matrix.transpose_map, ← Matrix.map_mul, ← Matrix.map_mul]
    rfl
  rw [hnum]
  change (G.det : ℚ)⁻¹ * _ = _
  rw [div_eq_mul_inv, mul_comm]
  rfl

/-- The common integer denominator and numerator of the Gram projection
have a bound that does not multiply unrelated rational entry heights. -/
theorem integerRowProjection_height {r n K : ℕ} (hK : 1 ≤ K)
    (Z : Matrix (Fin r) (Fin n) ℤ) (hZ : ∀ i j, (Z i j).natAbs ≤ K)
    (hdet : (Z * Z.transpose).det ≠ 0) (i j) :
    rationalHeight (rationalRowProjection (Z.map (fun z => (z : ℚ))) i j) ≤
      (r + 1) ^ 2 * K ^ 2 * (r.factorial * ((n + 1) * K ^ 2) ^ r) := by
  let H := (n + 1) * K ^ 2
  let T := r.factorial * H ^ r
  have hH : 1 ≤ H := by dsimp [H]; nlinarith
  have hG (a b) : ((Z * Z.transpose) a b).natAbs ≤ H := by
    apply (integerMatrix_mul_bound Z Z.transpose hZ (fun i j => hZ j i) a b).trans
    dsimp [H]
    nlinarith
  have hAdj (a b) : ((Z * Z.transpose).adjugate a b).natAbs ≤ T :=
    integerMatrix_adjugate_bound hH _ hG a b
  rw [integerRowProjection_fraction]
  apply (rationalHeight_div_int_le _ _ hdet).trans
  apply max_le
  · have hmid (a b) : ((Z.transpose * (Z * Z.transpose).adjugate) a b).natAbs ≤ r * K * T :=
      integerMatrix_mul_bound Z.transpose _ (fun i j => hZ j i) hAdj a b
    apply (integerMatrix_mul_bound _ Z hmid hZ i j).trans
    change r * (r * K * T) * K ≤ (r + 1) ^ 2 * K ^ 2 * T
    nlinarith [Nat.zero_le (K ^ 2 * T), Nat.zero_le (r * K ^ 2 * T)]
  · apply (integerMatrix_det_bound _ hG).trans
    change T ≤ (r + 1) ^ 2 * K ^ 2 * T
    exact Nat.le_mul_of_pos_left T (by positivity)

theorem rationalRectangularMatrix_clear_denominators {r n B : ℕ}
    (S : Matrix (Fin r) (Fin n) ℚ) (hS : ∀ i j, rationalHeight (S i j) ≤ B) :
    ∃ (D : ℕ) (Z : Matrix (Fin r) (Fin n) ℤ),
      0 < D ∧ D ≤ B ^ (r * n) ∧
      Z.map (fun z => (z : ℚ)) = (D : ℚ) • S ∧
      ∀ i j, (Z i j).natAbs ≤ B ^ (r * n + 1) := by
  let a : Fin r × Fin n → ℚ := fun p => S p.1 p.2
  obtain ⟨z, hz⟩ := rational_clear_denominators a (fun p => hS p.1 p.2)
  let D := rationalCommonDenominator a
  let Z : Matrix (Fin r) (Fin n) ℤ := fun i j => z (i, j)
  have hD : D ≤ B ^ (r * n) := by
    simpa only [Fintype.card_prod, Fintype.card_fin] using
      rationalCommonDenominator_le a (fun p => hS p.1 p.2)
  refine ⟨D, Z, rationalCommonDenominator_pos a, hD, ?_, ?_⟩
  · ext i j
    exact (hz (i, j)).1
  · intro i j
    calc
      _ ≤ B * D := (hz (i, j)).2
      _ ≤ B * B ^ (r * n) := Nat.mul_le_mul_left B hD
      _ = _ := by rw [pow_succ B (r * n), mul_comm]

/-- The shared-denominator height estimate for a rational Gram projection,
before converting its explicit polynomial powers to the source budget. -/
theorem rationalRowProjection_height_raw {r n B : ℕ} (hB : 1 ≤ B)
    (S : Matrix (Fin r) (Fin n) ℚ) (hS : ∀ i j, rationalHeight (S i j) ≤ B)
    (hlin : LinearIndependent ℚ S.row) (i j) :
    rationalHeight (rationalRowProjection S i j) ≤
      (r + 1) ^ 2 * (B ^ (r * n + 1)) ^ 2 *
        (r.factorial * ((n + 1) * (B ^ (r * n + 1)) ^ 2) ^ r) := by
  obtain ⟨D, Z, hD, _hDB, hZS, hZB⟩ := rationalRectangularMatrix_clear_denominators S hS
  have hD0 : (D : ℚ) ≠ 0 := by exact_mod_cast hD.ne'
  have hg := rational_gram_det_ne_zero S hlin
  let f := Int.castRingHom ℚ
  have hmap : (Z * Z.transpose).map f = ((D : ℚ) * D) • (S * S.transpose) := by
    rw [Matrix.map_mul, Matrix.transpose_map]
    change Z.map (fun z => (z : ℚ)) * (Z.map (fun z => (z : ℚ))).transpose = _
    rw [hZS, Matrix.transpose_smul, Matrix.smul_mul, Matrix.mul_smul, smul_smul]
  have he : ((Z * Z.transpose).det : ℚ) = ((D : ℚ) * D) ^ r * (S * S.transpose).det := by
    calc
      _ = ((Z * Z.transpose).map f).det := f.map_det _
      _ = _ := by rw [hmap, Matrix.det_smul, Fintype.card_fin]
  have hdet : (Z * Z.transpose).det ≠ 0 := by
    intro hzero
    have hne := mul_ne_zero (pow_ne_zero r (mul_ne_zero hD0 hD0)) hg
    exact hne (by simpa only [hzero, Int.cast_zero] using he.symm)
  have hp : rationalRowProjection (Z.map (fun z => (z : ℚ))) = rationalRowProjection S := by
    rw [hZS]
    exact rationalRowProjection_smul S hg hD0
  rw [← hp]
  exact integerRowProjection_height (Nat.one_le_pow _ _ hB) Z hZB hdet i j

theorem rational_projection_budget {r n d B : ℕ} (hr : r ≤ d) (hn : n ≤ d) (hB : 1 ≤ B) :
    (r + 1) ^ 2 * (B ^ (r * n + 1)) ^ 2 *
      (r.factorial * ((n + 1) * (B ^ (r * n + 1)) ^ 2) ^ r) ≤
      (2 * B) ^ (4 * (d + 1) ^ 4) := by
  let L := 2 * B
  have hL : 0 < L := by dsimp [L]; omega
  have h2 : 2 ≤ L := by dsimp [L]; omega
  have hb : B ≤ L := by dsimp [L]; omega
  have hf : r.factorial ≤ L ^ (d ^ 2) := by
    calc
      _ ≤ r ^ r := Nat.factorial_le_pow r
      _ ≤ (2 ^ r) ^ r := Nat.pow_le_pow_left Nat.lt_two_pow_self.le _
      _ = 2 ^ (r ^ 2) := by rw [← pow_mul, pow_two]
      _ ≤ L ^ (r ^ 2) := Nat.pow_le_pow_left h2 _
      _ ≤ _ := Nat.pow_le_pow_right hL (Nat.pow_le_pow_left hr 2)
  have hsmall (a : ℕ) (ha : a ≤ d) : a + 1 ≤ L ^ (d + 1) := by
    calc
      _ ≤ 2 ^ (a + 1) := Nat.lt_two_pow_self.le
      _ ≤ L ^ (a + 1) := Nat.pow_le_pow_left h2 _
      _ ≤ _ := Nat.pow_le_pow_right hL (by omega)
  have hr2 : (r + 1) ^ 2 ≤ L ^ (2 * (d + 1)) := by
    simpa only [← pow_mul, Nat.mul_comm (d + 1) 2] using
      Nat.pow_le_pow_left (hsmall r hr) 2
  have hnR : (n + 1) ^ r ≤ L ^ ((d + 1) * d) := by
    calc
      _ ≤ (L ^ (d + 1)) ^ r := Nat.pow_le_pow_left (hsmall n hn) _
      _ = L ^ ((d + 1) * r) := (pow_mul _ _ _).symm
      _ ≤ _ := Nat.pow_le_pow_right hL (Nat.mul_le_mul_left _ hr)
  have hK : (B ^ (r * n + 1)) ^ 2 * ((B ^ (r * n + 1)) ^ 2) ^ r ≤
      L ^ (2 * (d ^ 2 + 1) * (d + 1)) := by
    have he : (r * n + 1) * 2 + (r * n + 1) * 2 * r = 2 * (r * n + 1) * (r + 1) := by ring
    rw [← pow_mul, ← pow_mul, ← pow_add, he]
    apply (Nat.pow_le_pow_left hb _).trans
    apply Nat.pow_le_pow_right hL
    have hprod : r * n ≤ d ^ 2 := by simpa only [pow_two] using Nat.mul_le_mul hr hn
    exact Nat.mul_le_mul (Nat.mul_le_mul_left 2 (Nat.add_le_add_right hprod 1))
      (Nat.add_le_add_right hr 1)
  calc
    _ = (r + 1) ^ 2 * r.factorial * (n + 1) ^ r *
        ((B ^ (r * n + 1)) ^ 2 * ((B ^ (r * n + 1)) ^ 2) ^ r) := by
      rw [mul_pow]
      ring
    _ ≤ L ^ (2 * (d + 1)) * L ^ (d ^ 2) * L ^ ((d + 1) * d) *
        L ^ (2 * (d ^ 2 + 1) * (d + 1)) :=
      Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul hr2 hf) hnR) hK
    _ = L ^ (2 * (d + 1) + d ^ 2 + (d + 1) * d + 2 * (d ^ 2 + 1) * (d + 1)) := by
      simp only [pow_add]
    _ ≤ _ := Nat.pow_le_pow_right hL
      (by nlinarith only [Nat.zero_le (d ^ 4), Nat.zero_le (d ^ 3), Nat.zero_le (d ^ 2)])

/-- Blueprint `lem:rational-linear`: the rational row-space projection has
the stated exponential height bound and Euclidean operator norm at most one. -/
theorem rationalRowProjection_bounds {r n d : ℕ} (hr : r ≤ d) (hn : n ≤ d)
    {B : ℝ} (hB : 2 ≤ B) (S : Matrix (Fin r) (Fin n) ℚ)
    (hS : ∀ i j, (rationalHeight (S i j) : ℝ) ≤ B)
    (hlin : LinearIndependent ℚ S.row) :
    (∀ i j, (rationalHeight (rationalRowProjection S i j) : ℝ) ≤
      Real.exp (4 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B))) ∧
    ‖realMatrixOperator ((rationalRowProjection S).map (fun q => (q : ℝ)))‖ ≤ 1 := by
  have hb : 1 ≤ ⌊B⌋₊ := Nat.le_floor (by norm_num; linarith)
  constructor
  · intro i j
    have hh := (rationalRowProjection_height_raw hb S
      (fun i j => Nat.le_floor (hS i j)) hlin i j).trans (rational_projection_budget hr hn hb)
    calc
      _ ≤ (2 * (⌊B⌋₊ : ℝ)) ^ (4 * (d + 1) ^ 4) := by exact_mod_cast hh
      _ ≤ (2 * B) ^ (4 * (d + 1) ^ 4) := by
        apply pow_le_pow_left₀ (by positivity)
        have := Nat.floor_le (show 0 ≤ B by linarith)
        linarith
      _ = _ := by
        have he : 4 * (d + 1 : ℝ) ^ 4 = ((4 * (d + 1) ^ 4 : ℕ) : ℝ) := by push_cast; rfl
        rw [he, Real.exp_nat_mul, Real.exp_log (by linarith : 0 < 2 * B)]
  · rw [rationalRowProjection_eq_starProjection S hlin]
    exact Submodule.starProjection_norm_le _

/-- Real row space of a rational matrix, in Euclidean coordinates. -/
noncomputable def rationalRealRowSpace {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℚ) :
    Submodule ℝ (EuclideanSpace ℝ (Fin n)) :=
  (realMatrixOperator (A.transpose.map (fun q => (q : ℝ)))).range

theorem rational_rowSpan_factor {m r n : ℕ}
    (A : Matrix (Fin m) (Fin n) ℚ) (S : Matrix (Fin r) (Fin n) ℚ)
    (hspan : Submodule.span ℚ (Set.range A.row) ≤ Submodule.span ℚ (Set.range S.row)) :
    ∃ F : Matrix (Fin m) (Fin r) ℚ, A = F * S := by
  have hv (i : Fin m) : A.row i ∈ S.transpose.mulVecLin.range := by
    rw [Matrix.range_mulVecLin, Matrix.col_transpose]
    exact hspan (Submodule.subset_span (Set.mem_range_self i))
  choose f hf using hv
  refine ⟨f, ?_⟩
  ext i j
  have hij := congrFun (hf i) j
  change A i j = ∑ k, f i k * S k j
  simpa only [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, Matrix.transpose_apply,
    Matrix.row_apply, Matrix.mul_apply, mul_comm] using hij.symm

theorem rationalRealRowSpace_mono {m r n : ℕ}
    (A : Matrix (Fin m) (Fin n) ℚ) (S : Matrix (Fin r) (Fin n) ℚ)
    (hspan : Submodule.span ℚ (Set.range A.row) ≤ Submodule.span ℚ (Set.range S.row)) :
    rationalRealRowSpace A ≤ rationalRealRowSpace S := by
  obtain ⟨F, hF⟩ := rational_rowSpan_factor A S hspan
  intro y hy
  obtain ⟨x, rfl⟩ := hy
  refine ⟨realMatrixOperator (F.transpose.map (fun q => (q : ℝ))) x, ?_⟩
  change realMatrixOperator (S.transpose.map (fun q => (q : ℝ)))
      (realMatrixOperator (F.transpose.map (fun q => (q : ℝ))) x) =
    realMatrixOperator (A.transpose.map (fun q => (q : ℝ))) x
  rw [← realMatrixOperator_mul_apply, hF, Matrix.transpose_mul]
  have hmap : (S.transpose * F.transpose).map (fun q => (q : ℝ)) =
      S.transpose.map (fun q => (q : ℝ)) * F.transpose.map (fun q => (q : ℝ)) :=
    Matrix.map_mul (f := Rat.castHom ℝ)
  rw [hmap]

theorem rationalRealRowSpace_eq {m r n : ℕ}
    (A : Matrix (Fin m) (Fin n) ℚ) (S : Matrix (Fin r) (Fin n) ℚ)
    (hspan : Submodule.span ℚ (Set.range A.row) = Submodule.span ℚ (Set.range S.row)) :
    rationalRealRowSpace A = rationalRealRowSpace S :=
  le_antisymm (rationalRealRowSpace_mono A S hspan.le)
    (rationalRealRowSpace_mono S A hspan.symm.le)

theorem rationalHeight_one_sub (q : ℚ) : rationalHeight (1 - q) ≤ 2 * rationalHeight q := by
  have hd : (q.den : ℤ) ≠ 0 := by exact_mod_cast q.den_nz
  have hfrac : (1 - q : ℚ) = ((q.den : ℤ) - q.num : ℤ) / (q.den : ℚ) := by
    rw [Int.cast_sub, Int.cast_natCast, sub_div,
      div_self (by exact_mod_cast q.den_nz), q.num_div_den]
  rw [hfrac]
  apply (rationalHeight_div_int_le _ _ hd).trans
  apply max_le
  · calc
      _ ≤ (q.den : ℤ).natAbs + q.num.natAbs := Int.natAbs_sub_le _ _
      _ ≤ 2 * rationalHeight q := by simp only [Int.natAbs_natCast, rationalHeight]; omega
  · simp only [Int.natAbs_natCast, rationalHeight]
    omega

theorem rationalHeight_neg (q : ℚ) : rationalHeight (-q) = rationalHeight q := by
  simp [rationalHeight]

theorem rationalMatrix_complement_height {n : ℕ} (P : Matrix (Fin n) (Fin n) ℚ) (i j) :
    rationalHeight ((1 - P) i j) ≤ 2 * rationalHeight (P i j) := by
  by_cases hij : i = j
  · subst j
    simpa using rationalHeight_one_sub (P i i)
  · simpa only [Matrix.sub_apply, Matrix.one_apply, ite_eq_right hij, zero_sub,
      rationalHeight_neg] using (show rationalHeight (P i j) ≤ 2 * rationalHeight (P i j) by omega)

theorem realMatrixOperator_sub {m n : ℕ} (A B : Matrix (Fin m) (Fin n) ℝ) :
    realMatrixOperator (A - B) = realMatrixOperator A - realMatrixOperator B := by
  unfold realMatrixOperator
  rw [map_sub, map_sub]

theorem realMatrixOperator_one (n : ℕ) :
    realMatrixOperator (1 : Matrix (Fin n) (Fin n) ℝ) =
      ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin n)) := by
  ext x i
  exact congrFun (Matrix.one_mulVec x.ofLp) i

/-- Blueprint `lem:rational-linear`, lines 418–420: arbitrary rational
equations determine rational orthogonal projections onto their real row
space and its orthogonal complement. Both have height at most
`exp (8 (d+1)^4 log (2B))` and operator norm at most one. -/
theorem rationalMatrix_projection_bounds {m n d : ℕ} (hn : n ≤ d)
    {B : ℝ} (hB : 2 ≤ B) (A : Matrix (Fin m) (Fin n) ℚ)
    (hA : ∀ i j, (rationalHeight (A i j) : ℝ) ≤ B) :
    ∃ P : Matrix (Fin n) (Fin n) ℚ,
      realMatrixOperator (P.map (fun q => (q : ℝ))) = (rationalRealRowSpace A).starProjection ∧
      realMatrixOperator ((1 - P).map (fun q => (q : ℝ))) =
        (rationalRealRowSpace A)ᗮ.starProjection ∧
      (∀ i j, (rationalHeight (P i j) : ℝ) ≤
        Real.exp (8 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B))) ∧
      (∀ i j, (rationalHeight ((1 - P) i j) : ℝ) ≤
        Real.exp (8 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B))) ∧
      ‖realMatrixOperator (P.map (fun q => (q : ℝ)))‖ ≤ 1 ∧
      ‖realMatrixOperator ((1 - P).map (fun q => (q : ℝ)))‖ ≤ 1 := by
  obtain ⟨r, hr, rows, hlin, hspan⟩ := rational_spanning_subfamily A.row
  let S : Matrix (Fin r) (Fin n) ℚ := A.submatrix rows id
  let P := rationalRowProjection S
  have hlinS : LinearIndependent ℚ S.row := hlin
  have hspace : rationalRealRowSpace S = rationalRealRowSpace A :=
    rationalRealRowSpace_eq S A hspan
  have hp : realMatrixOperator (P.map (fun q => (q : ℝ))) =
      (rationalRealRowSpace A).starProjection := by
    change realMatrixOperator ((rationalRowProjection S).map (fun q => (q : ℝ))) = _
    rw [rationalRowProjection_eq_starProjection S hlinS]
    change (rationalRealRowSpace S).starProjection = _
    rw [hspace]
  have hq : realMatrixOperator ((1 - P).map (fun q => (q : ℝ))) =
      (rationalRealRowSpace A)ᗮ.starProjection := by
    have hmap : (1 - P).map (fun q => (q : ℝ)) = 1 - P.map (fun q => (q : ℝ)) := by
      change (Rat.castHom ℝ).mapMatrix (1 - P) = 1 - (Rat.castHom ℝ).mapMatrix P
      rw [map_sub, map_one]
    rw [hmap, realMatrixOperator_sub, realMatrixOperator_one, hp,
      Submodule.starProjection_orthogonal]
  let E := Real.exp (4 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B))
  have hE : 2 ≤ E := by
    apply (hB.trans (height_le_rational_budget d hB)).trans
    apply Real.exp_le_exp.mpr
    have hl : 0 ≤ Real.log (2 * B) := Real.log_nonneg (by linarith)
    have hn0 : 0 ≤ (d + 1 : ℝ) ^ 4 := by positivity
    nlinarith only [hl, hn0]
  have hdouble : E * E = Real.exp (8 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B)) := by
    rw [← Real.exp_add]
    congr 1
    ring
  have hh := (rationalRowProjection_bounds (hr.trans hn) hn hB S
    (fun i j => hA (rows i) j) hlinS).1
  refine ⟨P, hp, hq, ?_, ?_, ?_, ?_⟩
  · intro i j
    rw [← hdouble]
    exact (hh i j).trans (le_mul_of_one_le_right (by linarith) (by linarith))
  · intro i j
    rw [← hdouble]
    have hc : (rationalHeight ((1 - P) i j) : ℝ) ≤ 2 * rationalHeight (P i j) := by
      exact_mod_cast rationalMatrix_complement_height P i j
    have hPi : (rationalHeight (P i j) : ℝ) ≤ E := hh i j
    nlinarith only [hE, hc, hPi]
  · rw [hp]
    exact Submodule.starProjection_norm_le _
  · rw [hq]
    exact Submodule.starProjection_norm_le _

/-- Blueprint `lem:height`, proof line 617: clearing one vector's
denominators gives integer entries bounded by `B^d`, where `d` is the
number of coordinates. The coordinate's own denominator is canceled
before estimating the product of the remaining denominators. -/
theorem rational_clear_denominators_sharp {ι : Type*} [Fintype ι] (a : ι → ℚ)
    {B : ℕ} (ha : ∀ i, rationalHeight (a i) ≤ B) :
    ∃ z : ι → ℤ, ∀ i,
      (z i : ℚ) = rationalCommonDenominator a * a i ∧
      (z i).natAbs ≤ B ^ Fintype.card ι := by
  classical
  let p := fun i => ∏ j ∈ Finset.univ.erase i, (a j).den
  let z := fun i => (a i).num * (p i : ℤ)
  refine ⟨z, fun i => ⟨?_, ?_⟩⟩
  · have hp : rationalCommonDenominator a = (a i).den * p i :=
      (Finset.mul_prod_erase Finset.univ (fun j => (a j).den) (Finset.mem_univ i)).symm
    have hn : ((a i).num : ℚ) = a i * (a i).den :=
      (div_eq_iff (by exact_mod_cast (a i).den_nz)).mp (a i).num_div_den
    dsimp only [z]
    rw [hp]
    push_cast
    rw [hn]
    ring
  · have hp : p i ≤ B ^ (Finset.univ.erase i).card := by
      calc
        _ ≤ ∏ _j ∈ Finset.univ.erase i, B := Finset.prod_le_prod
          (fun j _ => (le_max_right _ _).trans (ha j))
        _ = _ := by simp
    have hcard : (Finset.univ.erase i).card + 1 = Fintype.card ι := by
      simpa using Finset.card_erase_add_one (Finset.mem_univ i)
    calc
      _ = (a i).num.natAbs * p i := by
        dsimp only [z]
        rw [Int.natAbs_mul, Int.natAbs_natCast]
      _ ≤ B * B ^ (Finset.univ.erase i).card :=
        Nat.mul_le_mul ((le_max_left _ _).trans (ha i)) hp
      _ = B ^ ((Finset.univ.erase i).card + 1) := by rw [pow_succ, mul_comm]
      _ = _ := congrArg (fun n => B ^ n) hcard

/-- Replacement determinants give the sharp Cramer numerator bound
needed in the circuit argument of `lem:height`, proof line 617. -/
theorem integerMatrix_cramer_bound {n K : ℕ}
    (Z : Matrix (Fin n) (Fin n) ℤ) (b : Fin n → ℤ)
    (hZ : ∀ i j, (Z i j).natAbs ≤ K) (hb : ∀ i, (b i).natAbs ≤ K) (j : Fin n) :
    (Z.cramer b j).natAbs ≤ n.factorial * K ^ n := by
  rw [Matrix.cramer_apply]
  apply integerMatrix_det_bound
  intro i k
  simp only [Matrix.updateCol_apply]
  split_ifs
  · exact hb i
  · exact hZ i k

theorem integerMatrix_cramer_cast {n : ℕ}
    (Z : Matrix (Fin n) (Fin n) ℤ) (b : Fin n → ℤ) (i : Fin n) :
    (Z.cramer b i : ℚ) = ((Int.castRingHom ℚ).mapMatrix Z).cramer (fun j => (b j : ℚ)) i := by
  have he : (Int.castRingHom ℚ).mapMatrix (Z.updateCol i b) =
      ((Int.castRingHom ℚ).mapMatrix Z).updateCol i (fun j => (b j : ℚ)) := by
    ext j k
    by_cases h : k = i
    · subst k
      simp
    · simp [h]
  rw [Matrix.cramer_apply, Matrix.cramer_apply]
  exact ((Int.castRingHom ℚ).map_det (Z.updateCol i b)).trans (congrArg Matrix.det he)

/-- A dependent column family has a proper nonsingular pivot minor,
so at least one column remains available for the Cramer dependence. -/
theorem rational_pivot_minor_of_dependent {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℚ)
    (hdep : ¬LinearIndependent ℚ A.col) :
    ∃ (r : ℕ) (_hrm : r ≤ m) (_hrn : r < n)
      (rows : Fin r ↪ Fin m) (cols : Fin r ↪ Fin n),
      (A.submatrix rows cols).det ≠ 0 ∧
      Submodule.span ℚ (Set.range (fun j => A.col (cols j))) =
        Submodule.span ℚ (Set.range A.col) := by
  obtain ⟨r, hrm, hrn, rows, cols, hdet, hspan⟩ := rational_pivot_minor A
  let L : (Fin m → ℚ) →ₗ[ℚ] (Fin r → ℚ) :=
    LinearMap.pi (fun i => LinearMap.proj (rows i))
  have hli : LinearIndependent ℚ (fun j => A.col (cols j)) := by
    apply LinearIndependent.of_comp L
    change LinearIndependent ℚ (A.submatrix rows cols).col
    exact Matrix.linearIndependent_cols_iff_isUnit.mpr
      ((Matrix.isUnit_iff_isUnit_det _).mpr (isUnit_iff_ne_zero.mpr hdet))
  have hrank : r = (Set.range A.col).finrank ℚ := by
    have h := linearIndependent_iff_card_eq_finrank_span.mp hli
    simp only [Fintype.card_fin, Set.finrank] at h ⊢
    rwa [hspan] at h
  have hlt : r < n := by
    by_contra hlt
    have he : r = n := by omega
    apply hdep
    apply linearIndependent_iff_card_eq_finrank_span.mpr
    simpa only [Fintype.card_fin, he] using hrank
  exact ⟨r, hrm, hlt, rows, cols, hdet, hspan⟩

/-- Cramer numerators for a pivot minor reproduce any column after
embedding back into the full row space. -/
theorem rational_pivot_cramer {m n r : ℕ}
    (A : Matrix (Fin m) (Fin n) ℚ) (rows : Fin r ↪ Fin m) (cols : Fin r ↪ Fin n)
    (hdet : (A.submatrix rows cols).det ≠ 0)
    (hspan : Submodule.span ℚ (Set.range (fun j => A.col (cols j))) =
      Submodule.span ℚ (Set.range A.col)) (j : Fin n) :
    (A.submatrix id cols).mulVec ((A.submatrix rows cols).cramer (A.col j ∘ rows)) =
      (A.submatrix rows cols).det • A.col j := by
  have hy : A.col j ∈ LinearMap.range A.mulVecLin := by
    rw [Matrix.range_mulVecLin]
    exact Submodule.subset_span (Set.mem_range_self j)
  have h := rational_pivot_rightInverse A rows cols hdet hspan (A.col j) hy
  rw [rationalMatrixZeroExtend_mulVec, rational_mulVec_extend] at h
  rw [← Matrix.det_smul_inv_mulVec_eq_cramer _ _ (isUnit_iff_ne_zero.mpr hdet),
    Matrix.mulVec_smul, h]

/-- An integer matrix with dependent columns has a nonzero integral
kernel vector with the determinant bound, independent of the number of columns. -/
theorem integerMatrix_small_kernel {m n K : ℕ} (A : Matrix (Fin m) (Fin n) ℤ)
    (hK : 1 ≤ K) (hA : ∀ i j, (A i j).natAbs ≤ K)
    (hdep : ¬LinearIndependent ℚ (A.map (fun z => (z : ℚ))).col) :
    ∃ c : Fin n → ℤ, c ≠ 0 ∧ A.mulVec c = 0 ∧
      ∀ i, (c i).natAbs ≤ m.factorial * K ^ m := by
  classical
  let Q := A.map (fun z => (z : ℚ))
  obtain ⟨r, hrm, hrn, rows, cols, hdet, hspan⟩ :=
    rational_pivot_minor_of_dependent Q hdep
  have hnotsurj : ¬Function.Surjective cols := by
    intro hs
    have hh := Fintype.card_le_of_surjective cols hs
    simp only [Fintype.card_fin] at hh
    omega
  have hex : ∃ j, j ∉ Set.range cols := by
    by_contra hh
    push Not at hh
    exact hnotsurj hh
  obtain ⟨j, hj⟩ := hex
  let S := A.submatrix rows cols
  let b := fun i => A (rows i) j
  let w := S.cramer b
  let c : Fin n → ℤ := Function.extend cols w 0 - Pi.single j S.det
  have hcastdet : (S.det : ℚ) = (Q.submatrix rows cols).det :=
    (Int.castRingHom ℚ).map_det S
  have hdetZ : S.det ≠ 0 := by
    intro hz
    apply hdet
    rw [← hcastdet, hz, Int.cast_zero]
  have hcastw : (fun i => (w i : ℚ)) =
      (Q.submatrix rows cols).cramer (Q.col j ∘ rows) := by
    funext i
    exact integerMatrix_cramer_cast S b i
  have hfull : (A.submatrix id cols).mulVec w = S.det • A.col j := by
    have hh := rational_pivot_cramer Q rows cols hdet hspan j
    rw [← hcastw, ← hcastdet] at hh
    ext i
    apply Int.cast_injective (α := ℚ)
    have he := congrFun hh i
    simpa only [Q, Matrix.map_apply, Matrix.submatrix_apply, Matrix.col_apply,
      Matrix.mulVec, dotProduct, Int.cast_sum, Int.cast_mul,
      Pi.smul_apply, smul_eq_mul] using he
  refine ⟨c, ?_, ?_, ?_⟩
  · intro hc
    have he := congrFun hc j
    have hnj : j ∉ Set.range cols := hj
    simp only [c, Pi.sub_apply, Function.extend_apply' _ _ _ hnj,
      Pi.zero_apply, Pi.single_eq_same, zero_sub] at he
    exact hdetZ (neg_eq_zero.mp he)
  · have hext : A.mulVec (Function.extend cols w 0) =
        (A.submatrix id cols).mulVec w := by
      ext i
      change (∑ k, A i k * Function.extend cols w 0 k) = ∑ k, A i (cols k) * w k
      symm
      apply Fintype.sum_of_injective cols cols.injective
      · intro k hk
        rw [Function.extend_apply' _ _ _ hk]
        exact mul_zero _
      · intro k
        rw [cols.injective.extend_apply]
    dsimp only [c]
    rw [Matrix.mulVec_sub, hext, hfull, Matrix.mulVec_single]
    ext i
    simp [Matrix.col_apply, mul_comm]
  · have hbnd : r.factorial * K ^ r ≤ m.factorial * K ^ m :=
      Nat.mul_le_mul (Nat.factorial_le hrm) (pow_le_pow_right₀ hK hrm)
    intro i
    by_cases hi : i = j
    · subst i
      have hnj : j ∉ Set.range cols := hj
      simpa only [c, Pi.sub_apply, Function.extend_apply' _ _ _ hnj,
        Pi.zero_apply, Pi.single_eq_same, zero_sub, Int.natAbs_neg] using
        (integerMatrix_det_bound S (fun i k => hA (rows i) (cols k))).trans hbnd
    · have hs : (Pi.single j S.det : Fin n → ℤ) i = 0 := Pi.single_eq_of_ne hi _
      simp only [c, Pi.sub_apply, hs, sub_zero]
      by_cases hir : i ∈ Set.range cols
      · obtain ⟨k, rfl⟩ := hir
        rw [cols.injective.extend_apply]
        exact (integerMatrix_cramer_bound S b (fun i k => hA (rows i) (cols k))
          (fun i => hA (rows i) j) k).trans hbnd
      · rw [Function.extend_apply' _ _ _ hir]
        simp

/-- Every dependent bounded-height rational family has an integral
relation with the sharp coefficient budget from `lem:height`. -/
theorem rational_small_dependence {d n B : ℕ} (v : Fin n → Fin d → ℚ)
    (hB : 1 ≤ B) (hv : ∀ i j, rationalHeight (v i j) ≤ B)
    (hdep : ¬LinearIndependent ℚ v) :
    ∃ c : Fin n → ℤ, c ≠ 0 ∧ (∑ i, (c i : ℚ) • v i) = 0 ∧
      ∀ i, (c i).natAbs ≤ d.factorial * B ^ (d ^ 2 + d) := by
  classical
  choose z hz using fun i => rational_clear_denominators_sharp (v i) (hv i)
  let q := fun i => rationalCommonDenominator (v i)
  have hq : ∀ i, (q i : ℚ) ≠ 0 := by
    intro i
    exact_mod_cast (rationalCommonDenominator_pos (v i)).ne'
  let A : Matrix (Fin d) (Fin n) ℤ := fun j i => z i j
  have hA : ∀ j i, (A j i).natAbs ≤ B ^ d := by
    intro j i
    simpa using (hz i j).2
  let u : Fin n → ℚˣ := fun i => Units.mk0 (q i : ℚ) (hq i)
  have hcols : (A.map (fun x => (x : ℚ))).col = u • v := by
    funext i j
    exact (hz i j).1
  have hdepA : ¬LinearIndependent ℚ (A.map (fun x => (x : ℚ))).col := by
    rw [hcols, LinearIndependent.units_smul_iff]
    exact hdep
  obtain ⟨c, hc, hzero, hbound⟩ :=
    integerMatrix_small_kernel A (one_le_pow₀ hB) hA hdepA
  let w := fun i => c i * (q i : ℤ)
  refine ⟨w, ?_, ?_, ?_⟩
  · intro hw
    apply hc
    funext i
    have he := congrFun hw i
    have hqi : (q i : ℤ) ≠ 0 := by exact_mod_cast (rationalCommonDenominator_pos (v i)).ne'
    exact (mul_eq_zero.mp he).resolve_right hqi
  · ext j
    have he := congrFun hzero j
    have heQ := congrArg (fun x : ℤ => (x : ℚ)) he
    simp only [Matrix.mulVec, dotProduct, Int.cast_sum, Int.cast_mul] at heQ
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
    calc
      _ = ∑ i, (A j i : ℚ) * (c i : ℚ) := by
        apply Finset.sum_congr rfl
        intro i _
        rw [show (A j i : ℚ) = (q i : ℚ) * v i j from (hz i j).1]
        dsimp only [w]
        push_cast
        ring
      _ = 0 := heQ
  · intro i
    have hqi : q i ≤ B ^ d := by simpa using rationalCommonDenominator_le (v i) (hv i)
    calc
      (w i).natAbs = (c i).natAbs * q i := by
        dsimp only [w]
        rw [Int.natAbs_mul, Int.natAbs_natCast]
      _ ≤ (d.factorial * (B ^ d) ^ d) * B ^ d := Nat.mul_le_mul (hbound i) hqi
      _ = d.factorial * B ^ (d ^ 2 + d) := by
        rw [mul_assoc, ← pow_mul, ← pow_add, pow_two]

/-- The largest nonzero term prevents cancellation in an integral
linear combination of sufficiently separated real magnitudes. -/
theorem separated_integer_sum_ne_zero {n H : ℕ} {R : ℝ}
    (hR : (n : ℝ) * H < R) (x : Fin n → ℝ) (hx : ∀ i, x i ≠ 0)
    (hsep : ∀ i j, i < j → R * |x i| ≤ |x j|)
    (c : Fin n → ℤ) (hc : c ≠ 0) (hbound : ∀ i, (c i).natAbs ≤ H) :
    (∑ i, (c i : ℝ) * x i) ≠ 0 := by
  classical
  let s := Finset.univ.filter (fun i => c i ≠ 0)
  have hs : s.Nonempty := by
    by_contra hh
    apply hc
    funext i
    by_contra hi
    exact hh ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩⟩
  let j := s.max' hs
  have hj : c j ≠ 0 := (Finset.mem_filter.mp (s.max'_mem hs)).2
  have hmax : ∀ i, c i ≠ 0 → i ≤ j := by
    intro i hi
    exact s.le_max' i (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩)
  have hRpos : 0 < R := lt_of_le_of_lt (by positivity) hR
  have habs : ∀ i, |(c i : ℝ)| ≤ H := by
    intro i
    have hh : ((c i).natAbs : ℝ) ≤ H := by exact_mod_cast hbound i
    simpa [Nat.cast_natAbs, Int.cast_abs] using hh
  have hjone : 1 ≤ |(c j : ℝ)| := by
    have hh : 1 ≤ (c j).natAbs := Nat.one_le_iff_ne_zero.mpr (Int.natAbs_ne_zero.mpr hj)
    have hhR : (1 : ℝ) ≤ (c j).natAbs := by exact_mod_cast hh
    simpa [Nat.cast_natAbs, Int.cast_abs] using hhR
  have hxj : 0 < |x j| := abs_pos.mpr (hx j)
  have hterm : ∀ i ∈ Finset.univ.erase j,
      R * |(c i : ℝ) * x i| ≤ (H : ℝ) * |x j| := by
    intro i hi
    by_cases hci : c i = 0
    · simp only [hci, Int.cast_zero, zero_mul, abs_zero, mul_zero]
      positivity
    · have hij : i < j := lt_of_le_of_ne (hmax i hci) (Finset.ne_of_mem_erase hi)
      calc
        _ = |(c i : ℝ)| * (R * |x i|) := by rw [abs_mul]; ring
        _ ≤ (H : ℝ) * |x j| := mul_le_mul (habs i) (hsep i j hij)
          (by positivity) (by positivity)
  intro hzero
  have hsum : ∑ i ∈ Finset.univ.erase j, (c i : ℝ) * x i = -(c j : ℝ) * x j := by
    have hh := Finset.sum_erase_add Finset.univ (fun i => (c i : ℝ) * x i)
      (Finset.mem_univ j)
    rw [hzero] at hh
    linarith
  have hupper : R * |(c j : ℝ) * x j| ≤ (n : ℝ) * H * |x j| := by
    calc
      _ = R * |∑ i ∈ Finset.univ.erase j, (c i : ℝ) * x i| := by
        rw [hsum, neg_mul, abs_neg]
      _ ≤ R * ∑ i ∈ Finset.univ.erase j, |(c i : ℝ) * x i| :=
        mul_le_mul_of_nonneg_left (Finset.abs_sum_le_sum_abs _ _) hRpos.le
      _ = ∑ i ∈ Finset.univ.erase j, R * |(c i : ℝ) * x i| := Finset.mul_sum _ _ _
      _ ≤ ∑ _i ∈ Finset.univ.erase j, (H : ℝ) * |x j| := Finset.sum_le_sum hterm
      _ ≤ ∑ _i : Fin n, (H : ℝ) * |x j| :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.erase_subset _ _)
          (fun _ _ _ => by positivity)
      _ = (n : ℝ) * H * |x j| := by simp [mul_assoc]
  have hlower : R * |x j| ≤ R * |(c j : ℝ) * x j| := by
    rw [abs_mul]
    exact mul_le_mul_of_nonneg_left (le_mul_of_one_le_left hxj.le hjone) hRpos.le
  have hstrict : (n : ℝ) * H * |x j| < R * |x j| := mul_lt_mul_of_pos_right hR hxj
  exact (not_lt_of_ge (hlower.trans hupper)) hstrict

/-- The geometric separation ratio in the height-bin argument. -/
noncomputable def rationalHeightRatio (d B : ℕ) : ℝ :=
  4 * d * (d.factorial * B ^ (d ^ 2 + d) : ℕ)

theorem rational_separated_independent_of_card {d n B : ℕ} (hd : 0 < d)
    (hn : n ≤ d + 1) (hB : 1 ≤ B) (v : Fin n → Fin d → ℚ)
    (hv : ∀ i j, rationalHeight (v i j) ≤ B) (L : (Fin d → ℚ) →ₗ[ℚ] ℝ)
    (hx : ∀ i, L (v i) ≠ 0)
    (hsep : ∀ i j, i < j → rationalHeightRatio d B * |L (v i)| ≤ |L (v j)|) :
    LinearIndependent ℚ v := by
  by_contra hdep
  obtain ⟨c, hc, hzero, hbound⟩ := rational_small_dependence v hB hv hdep
  have hH : (0 : ℝ) < (d.factorial * B ^ (d ^ 2 + d) : ℕ) := by
    exact_mod_cast Nat.mul_pos (Nat.factorial_pos d) (pow_pos (by omega) _)
  have hdR : (1 : ℝ) ≤ d := by exact_mod_cast hd
  have hnR : (n : ℝ) ≤ d + 1 := by exact_mod_cast hn
  have hR : (n : ℝ) * (d.factorial * B ^ (d ^ 2 + d) : ℕ) <
      rationalHeightRatio d B := by
    unfold rationalHeightRatio
    nlinarith
  have hne := separated_integer_sum_ne_zero hR (fun i => L (v i)) hx hsep c hc hbound
  apply hne
  have he := congrArg L hzero
  simpa only [map_sum, map_smul, map_zero, Rat.smul_def, Rat.cast_intCast] using he

/-- Blueprint `lem:height`, proof line 617: bounded-height rational
vectors with geometrically separated nonzero evaluations are independent. -/
theorem rational_separated_independent_of_pos {d n B : ℕ} (hd : 0 < d)
    (hB : 1 ≤ B) (v : Fin n → Fin d → ℚ)
    (hv : ∀ i j, rationalHeight (v i j) ≤ B) (L : (Fin d → ℚ) →ₗ[ℚ] ℝ)
    (hx : ∀ i, L (v i) ≠ 0)
    (hsep : ∀ i j, i < j → rationalHeightRatio d B * |L (v i)| ≤ |L (v j)|) :
    LinearIndependent ℚ v := by
  by_cases hn : n ≤ d + 1
  · exact rational_separated_independent_of_card hd hn hB v hv L hx hsep
  · have hdn : d + 1 ≤ n := by omega
    let e : Fin (d + 1) → Fin n := Fin.castLE hdn
    have hli := rational_separated_independent_of_card hd (le_refl (d + 1)) hB
      (v ∘ e) (fun i j => hv (e i) j) L (fun i => hx (e i))
      (fun i j hij => hsep (e i) (e j) hij)
    have hh := hli.fintype_card_le_finrank
    simp only [Fintype.card_fin, Module.finrank_pi] at hh
    omega

/-- The same independence statement includes the empty, zero-dimensional case. -/
theorem rational_separated_independent {d n B : ℕ}
    (hB : 1 ≤ B) (v : Fin n → Fin d → ℚ)
    (hv : ∀ i j, rationalHeight (v i j) ≤ B) (L : (Fin d → ℚ) →ₗ[ℚ] ℝ)
    (hx : ∀ i, L (v i) ≠ 0)
    (hsep : ∀ i j, i < j → rationalHeightRatio d B * |L (v i)| ≤ |L (v j)|) :
    LinearIndependent ℚ v := by
  rcases Nat.eq_zero_or_pos d with rfl | hd
  · have hn : n = 0 := by
      by_contra hn
      let i : Fin n := ⟨0, Nat.pos_of_ne_zero hn⟩
      have hv0 : v i = 0 := Subsingleton.elim _ _
      exact hx i (hv0 ▸ map_zero L)
    subst n
    exact linearIndependent_empty_type
  · exact rational_separated_independent_of_pos hd hB v hv L hx hsep

/-- Evaluation of rational vectors against a real frequency. -/
noncomputable def rationalEvaluation {d : ℕ} (ξ : Fin d → ℝ) :
    (Fin d → ℚ) →ₗ[ℚ] ℝ where
  toFun v := ∑ j, (v j : ℝ) * ξ j
  map_add' v w := by simp [add_mul, Finset.sum_add_distrib]
  map_smul' q v := by simp [Rat.smul_def, mul_assoc, Finset.mul_sum]

/-- Greedily covering a finite positive set by multiplicative intervals
produces centers that are separated by more than the interval ratio. -/
theorem finite_positive_geometric_cover (s : Finset ℝ) {R : ℝ} (hR : 1 ≤ R)
    (hs : ∀ x ∈ s, 0 < x) :
    ∃ t : Finset ℝ, t ⊆ s ∧
      (∀ x ∈ s, ∃ a ∈ t, a ≤ x ∧ x ≤ R * a) ∧
      ∀ a ∈ t, ∀ b ∈ t, a < b → R * a < b := by
  classical
  induction s using Finset.strongInductionOn with
  | _ s ih =>
    by_cases hne : s.Nonempty
    · let a := s.min' hne
      have ha : a ∈ s := s.min'_mem hne
      have hapos : 0 < a := hs a ha
      have haR : a ≤ R * a := le_mul_of_one_le_left hapos.le hR
      let u := s.filter (fun x => R * a < x)
      have hus : u ⊆ s := Finset.filter_subset _ _
      have hau : a ∉ u := by
        intro hh
        exact (not_lt_of_ge haR) (Finset.mem_filter.mp hh).2
      have hproper : u ⊂ s := Finset.ssubset_iff_subset_ne.mpr ⟨hus, by
        intro he
        exact hau (he.symm ▸ ha)⟩
      obtain ⟨t, htu, hcover, hsep⟩ := ih u hproper (fun x hx => hs x (hus hx))
      refine ⟨insert a t, Finset.insert_subset ha (htu.trans hus), ?_, ?_⟩
      · intro x hx
        by_cases hax : R * a < x
        · obtain ⟨b, hb, hbx, hxb⟩ := hcover x (Finset.mem_filter.mpr ⟨hx, hax⟩)
          exact ⟨b, Finset.mem_insert_of_mem hb, hbx, hxb⟩
        · exact ⟨a, Finset.mem_insert_self _ _, s.min'_le x hx, le_of_not_gt hax⟩
      · intro b hb c hc hbc
        rcases Finset.mem_insert.mp hb with rfl | hb
        · rcases Finset.mem_insert.mp hc with rfl | hc
          · exact (lt_irrefl _ hbc).elim
          · exact (Finset.mem_filter.mp (htu hc)).2
        · rcases Finset.mem_insert.mp hc with rfl | hc
          · have hab : R * a < b := (Finset.mem_filter.mp (htu hb)).2
            exact (not_lt_of_ge (haR.trans hab.le) hbc).elim
          · exact hsep b hb c hc hbc
    · have he : s = ∅ := Finset.not_nonempty_iff_eq_empty.mp hne
      subst s
      exact ⟨∅, by simp⟩

/-- A finite positive set of bounded-height evaluations is covered by
at most `d` multiplicative intervals. -/
theorem rational_geometric_cover {d B : ℕ} (hB : 1 ≤ B)
    (L : (Fin d → ℚ) →ₗ[ℚ] ℝ) (s : Finset ℝ) (hs : ∀ x ∈ s, 0 < x)
    (hrepr : ∀ x ∈ s, ∃ v : Fin d → ℚ,
      (∀ j, rationalHeight (v j) ≤ B) ∧ |L v| = x)
    {R : ℝ} (hR : 1 ≤ R) (hlarge : rationalHeightRatio d B ≤ R) :
    ∃ t : Finset ℝ, t ⊆ s ∧ t.card ≤ d ∧
      ∀ x ∈ s, ∃ a ∈ t, a ≤ x ∧ x ≤ R * a := by
  classical
  obtain ⟨t, hts, hcover, hsep⟩ := finite_positive_geometric_cover s hR hs
  let e := t.orderEmbOfFin rfl
  have he : ∀ i : Fin t.card, e i ∈ t := t.orderEmbOfFin_mem rfl
  choose v hv hve using fun i : Fin t.card => hrepr (e i) (hts (he i))
  have hx : ∀ i, L (v i) ≠ 0 := by
    intro i
    apply abs_pos.mp
    rw [hve i]
    exact hs (e i) (hts (he i))
  have hsepv : ∀ i j, i < j →
      rationalHeightRatio d B * |L (v i)| ≤ |L (v j)| := by
    intro i j hij
    rw [hve i, hve j]
    exact (mul_le_mul_of_nonneg_right hlarge (hs (e i) (hts (he i))).le).trans
      (hsep (e i) (he i) (e j) (he j) (e.strictMono hij)).le
  have hli := rational_separated_independent hB v hv L hx hsepv
  have hcard : t.card ≤ d := by
    simpa only [Fintype.card_fin, Module.finrank_pi] using hli.fintype_card_le_finrank
  exact ⟨t, hts, hcard, hcover⟩

/-- A finite enumeration of precisely the rational vectors of bounded height. -/
noncomputable def boundedRationalVectors (d B : ℕ) : Finset (Fin d → ℚ) := by
  classical
  exact (Fintype.piFinset (fun _ : Fin d => boundedRationalEnumeration B)).filter
    (fun v => ∀ j, rationalHeight (v j) ≤ B)

theorem mem_boundedRationalVectors {d B : ℕ} {v : Fin d → ℚ} :
    v ∈ boundedRationalVectors d B ↔ ∀ j, rationalHeight (v j) ≤ B := by
  classical
  simp only [boundedRationalVectors, Finset.mem_filter]
  exact ⟨And.right, fun h => ⟨Fintype.mem_piFinset.mpr
    (fun j => mem_boundedRationalEnumeration (h j)), h⟩⟩

/-- The nonzero evaluation magnitudes of all bounded-height vectors. -/
noncomputable def boundedRationalMagnitudes {d : ℕ} (B : ℕ)
    (L : (Fin d → ℚ) →ₗ[ℚ] ℝ) : Finset ℝ := by
  classical
  exact ((boundedRationalVectors d B).image (fun v => |L v|)).erase 0

theorem mem_boundedRationalMagnitudes {d B : ℕ} {L : (Fin d → ℚ) →ₗ[ℚ] ℝ} {x : ℝ} :
    x ∈ boundedRationalMagnitudes B L ↔
      0 < x ∧ ∃ v : Fin d → ℚ, (∀ j, rationalHeight (v j) ≤ B) ∧ |L v| = x := by
  classical
  simp only [boundedRationalMagnitudes, Finset.mem_erase, Finset.mem_image,
    mem_boundedRationalVectors]
  constructor
  · rintro ⟨hne, v, hv, rfl⟩
    exact ⟨lt_of_le_of_ne (abs_nonneg _) (Ne.symm hne), v, hv, rfl⟩
  · rintro ⟨hpos, hv⟩
    exact ⟨hpos.ne', hv⟩

theorem rationalHeightRatio_log_bound (d : ℕ) {B : ℕ} (hB : 2 ≤ B) :
    Real.log (max 1 (rationalHeightRatio d B)) ≤
      8 * (d + 1 : ℝ) ^ 3 * Real.log (2 * B) := by
  have hBR : (2 : ℝ) ≤ B := by exact_mod_cast hB
  have hBP : (0 : ℝ) < B := by linarith
  have hL : 1 ≤ Real.log (2 * B) := by
    have h2 : (1 : ℝ) / 2 ≤ Real.log 2 := by
      have hh := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
      norm_num at hh ⊢
      linarith
    have h4 : (1 : ℝ) ≤ Real.log 4 := by
      rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]
      norm_num
      linarith
    exact h4.trans (Real.log_le_log (by norm_num) (by linarith))
  rcases Nat.eq_zero_or_pos d with rfl | hd
  · simp only [rationalHeightRatio, Nat.cast_zero, mul_zero, zero_mul, max_eq_left zero_le_one,
      Real.log_one]
    positivity
  have hdP : (0 : ℝ) < d := by exact_mod_cast hd
  have hd1 : (1 : ℝ) ≤ d := by exact_mod_cast hd
  have hfP : (0 : ℝ) < d.factorial := by exact_mod_cast Nat.factorial_pos d
  have hH1 : (1 : ℝ) ≤ (d.factorial * B ^ (d ^ 2 + d) : ℕ) := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr
      (Nat.mul_ne_zero (Nat.factorial_ne_zero d) (pow_ne_zero _ (by omega)))
  have hR1 : 1 ≤ rationalHeightRatio d B := by
    unfold rationalHeightRatio
    nlinarith only [hd1, hH1]
  have hfac : Real.log (d.factorial : ℝ) ≤ (d : ℝ) ^ 2 := by
    calc
      _ ≤ Real.log ((d : ℝ) ^ d) := Real.log_le_log hfP (by exact_mod_cast Nat.factorial_le_pow d)
      _ = (d : ℝ) * Real.log d := Real.log_pow _ _
      _ ≤ (d : ℝ) * d := mul_le_mul_of_nonneg_left
        ((Real.log_le_sub_one_of_pos hdP).trans (by linarith)) hdP.le
      _ = _ := by ring
  have hlogd : Real.log (d : ℝ) ≤ d :=
    (Real.log_le_sub_one_of_pos hdP).trans (by linarith)
  have hlog4 : Real.log (4 : ℝ) ≤ 3 := by
    have hh := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 4)
    norm_num at hh
    exact hh
  have hlogB : Real.log (B : ℝ) ≤ Real.log (2 * B) :=
    Real.log_le_log hBP (by linarith)
  have heq : rationalHeightRatio d B =
      4 * (d : ℝ) * (d.factorial : ℝ) * (B : ℝ) ^ (d ^ 2 + d) := by
    unfold rationalHeightRatio
    push_cast
    ring
  rw [max_eq_right hR1, heq, Real.log_mul (by positivity) (by positivity),
    Real.log_mul (by positivity) (by positivity), Real.log_mul (by norm_num) hdP.ne',
    Real.log_pow]
  push_cast
  calc
    _ ≤ 3 + (d : ℝ) + (d : ℝ) ^ 2 + ((d : ℝ) ^ 2 + d) * Real.log (2 * B) :=
      add_le_add (add_le_add (add_le_add hlog4 hlogd) hfac)
        (mul_le_mul_of_nonneg_left hlogB (by positivity))
    _ ≤ 3 * (d + 1 : ℝ) ^ 2 + (d + 1 : ℝ) ^ 2 * Real.log (2 * B) := by
      apply add_le_add
      · nlinarith only
      · apply mul_le_mul_of_nonneg_right _ (by linarith)
        nlinarith only
    _ ≤ 4 * (d + 1 : ℝ) ^ 2 * Real.log (2 * B) := by
      nlinarith only [mul_nonneg (sq_nonneg (d + 1 : ℝ)) (sub_nonneg.mpr hL)]
    _ ≤ 8 * (d + 1 : ℝ) ^ 3 * Real.log (2 * B) := by
      apply mul_le_mul_of_nonneg_right _ (by linarith)
      exact mul_le_mul (by norm_num : (4 : ℝ) ≤ 8)
        (pow_le_pow_right₀ (by linarith : (1 : ℝ) ≤ d + 1) (by omega : 2 ≤ 3))
        (sq_nonneg _) (by norm_num)

/-- Blueprint `lem:height`, lines 603 and 617: the logarithms of all
nonzero bounded-height evaluations lie in at most `d` intervals, each
of length `8 (d+1)^3 log(2B)`. -/
theorem rational_logarithmic_cover_nat {d B : ℕ} (hB : 2 ≤ B)
    (L : (Fin d → ℚ) →ₗ[ℚ] ℝ) :
    ∃ t : Finset ℝ, t.card ≤ d ∧ ∀ v : Fin d → ℚ,
      (∀ j, rationalHeight (v j) ≤ B) → L v ≠ 0 →
      ∃ a ∈ t, Real.log |L v| ∈
        Set.Icc a (a + 8 * (d + 1 : ℝ) ^ 3 * Real.log (2 * B)) := by
  classical
  let s := boundedRationalMagnitudes B L
  let R := max 1 (rationalHeightRatio d B)
  have hR : 1 ≤ R := le_max_left _ _
  have hRP : 0 < R := lt_of_lt_of_le zero_lt_one hR
  have hs : ∀ x ∈ s, 0 < x := fun _ hx => (mem_boundedRationalMagnitudes.mp hx).1
  obtain ⟨t, hts, hcard, hcover⟩ := rational_geometric_cover (by omega) L s hs
    (fun _ hx => (mem_boundedRationalMagnitudes.mp hx).2) hR (le_max_right _ _)
  refine ⟨t.image Real.log, Finset.card_image_le.trans hcard, ?_⟩
  intro v hv hx
  have hxpos : 0 < |L v| := abs_pos.mpr hx
  have hxmem : |L v| ∈ s := mem_boundedRationalMagnitudes.mpr ⟨hxpos, v, hv, rfl⟩
  obtain ⟨a, ha, hax, hxa⟩ := hcover _ hxmem
  have hap : 0 < a := hs a (hts ha)
  refine ⟨Real.log a, Finset.mem_image.mpr ⟨a, ha, rfl⟩,
    Real.log_le_log hap hax, ?_⟩
  calc
    _ ≤ Real.log (R * a) := Real.log_le_log hxpos hxa
    _ = Real.log a + Real.log R := by rw [Real.log_mul hRP.ne' hap.ne', add_comm]
    _ ≤ _ := add_le_add_right (rationalHeightRatio_log_bound d hB) _

/-- Real-valued height budgets are handled by their natural floor,
without enlarging either the dimension or the logarithmic width. -/
theorem rational_logarithmic_cover {d : ℕ} {B : ℝ} (hB : 2 ≤ B)
    (L : (Fin d → ℚ) →ₗ[ℚ] ℝ) :
    ∃ t : Finset ℝ, t.card ≤ d ∧ ∀ v : Fin d → ℚ,
      (∀ j, (rationalHeight (v j) : ℝ) ≤ B) → L v ≠ 0 →
      ∃ a ∈ t, Real.log |L v| ∈
        Set.Icc a (a + 8 * (d + 1 : ℝ) ^ 3 * Real.log (2 * B)) := by
  have hfloor : 2 ≤ ⌊B⌋₊ := Nat.le_floor hB
  obtain ⟨t, ht, hcover⟩ := rational_logarithmic_cover_nat hfloor L
  refine ⟨t, ht, ?_⟩
  intro v hv hx
  obtain ⟨a, ha, hlo, hhi⟩ := hcover v (fun j => Nat.le_floor (hv j)) hx
  refine ⟨a, ha, hlo, hhi.trans ?_⟩
  apply add_le_add_right
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  apply Real.log_le_log
  · have hp : (0 : ℝ) < ⌊B⌋₊ := by exact_mod_cast (by omega : 0 < ⌊B⌋₊)
    positivity
  · exact mul_le_mul_of_nonneg_left (Nat.floor_le (by linarith)) (by norm_num)

/-- The logarithmic cover for the source's dot-product frequencies. -/
theorem rational_frequency_logarithmic_cover {d : ℕ} {B : ℝ} (hB : 2 ≤ B)
    (ξ : Fin d → ℝ) :
    ∃ t : Finset ℝ, t.card ≤ d ∧ ∀ v : Fin d → ℚ,
      (∀ j, (rationalHeight (v j) : ℝ) ≤ B) → (∑ j, (v j : ℝ) * ξ j) ≠ 0 →
      ∃ a ∈ t, Real.log |∑ j, (v j : ℝ) * ξ j| ∈
        Set.Icc a (a + 8 * (d + 1 : ℝ) ^ 3 * Real.log (2 * B)) :=
  rational_logarithmic_cover hB (rationalEvaluation ξ)

/-- Rounding the endpoints of a real interval costs fewer than two
additional integer positions. -/
theorem integer_floor_interval_card_le {a b : ℝ} (hab : a ≤ b) :
    ((Finset.Icc ⌊a⌋ ⌊b⌋).card : ℝ) ≤ b - a + 2 := by
  have hf : ⌊a⌋ ≤ ⌊b⌋ + 1 := (Int.floor_mono hab).trans (by omega)
  have he : ((Finset.Icc ⌊a⌋ ⌊b⌋).card : ℝ) = (⌊b⌋ : ℝ) + 1 - (⌊a⌋ : ℝ) := by
    exact_mod_cast Int.card_Icc_of_le ⌊a⌋ ⌊b⌋ hf
  rw [he]
  linarith [Int.floor_le b, Int.lt_floor_add_one a]

/-- Bins of fixed logarithmic width occupied by a finite magnitude set. -/
noncomputable def logarithmicMagnitudeBins (s : Finset ℝ) (δ : ℝ) : Finset ℤ := by
  classical
  exact s.image (fun x => ⌊Real.log x / δ⌋)

theorem logarithmicMagnitudeBins_card_le (s t : Finset ℝ) {δ W : ℝ}
    (hδ : 0 < δ) (hW : 0 ≤ W)
    (hcover : ∀ x ∈ s, ∃ a ∈ t, Real.log x ∈ Set.Icc a (a + W)) :
    ((logarithmicMagnitudeBins s δ).card : ℝ) ≤ t.card * (W / δ + 2) := by
  classical
  let J := fun a : ℝ => Finset.Icc ⌊a / δ⌋ ⌊(a + W) / δ⌋
  have hsub : logarithmicMagnitudeBins s δ ⊆ t.biUnion J := by
    intro j hj
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hj
    obtain ⟨a, ha, hlo, hhi⟩ := hcover x hx
    exact Finset.mem_biUnion.mpr ⟨a, ha, Finset.mem_Icc.mpr
      ⟨Int.floor_mono (div_le_div_of_nonneg_right hlo hδ.le),
        Int.floor_mono (div_le_div_of_nonneg_right hhi hδ.le)⟩⟩
  have hJ : ∀ a, ((J a).card : ℝ) ≤ W / δ + 2 := by
    intro a
    have hh := integer_floor_interval_card_le
      (div_le_div_of_nonneg_right (show a ≤ a + W by linarith) hδ.le)
    convert hh using 1; ring
  calc
    _ ≤ ((t.biUnion J).card : ℝ) := by exact_mod_cast Finset.card_le_card hsub
    _ ≤ ∑ a ∈ t, ((J a).card : ℝ) := by exact_mod_cast Finset.card_biUnion_le
    _ ≤ ∑ _a ∈ t, (W / δ + 2) := Finset.sum_le_sum (fun a _ => hJ a)
    _ = _ := by simp; ring

/-- The logarithmic bin index agrees with the usual half-open dyadic
magnitude interval. -/
theorem dyadicMagnitudeBin_spec {x : ℝ} (hx : 0 < x) :
    (2 : ℝ) ^ ⌊Real.log x / Real.log 2⌋ ≤ x ∧
      x < (2 : ℝ) ^ (⌊Real.log x / Real.log 2⌋ + 1) := by
  have he : ⌊Real.log x / Real.log 2⌋ = Int.log 2 x :=
    Real.floor_logb_natCast hx.le
  rw [he]
  exact ⟨Int.zpow_log_le_self (by norm_num) hx, Int.lt_zpow_succ_log_self (by norm_num) x⟩

theorem height_log_one_le {B : ℝ} (hB : 2 ≤ B) : 1 ≤ Real.log (2 * B) := by
  have h2 : (1 : ℝ) / 2 ≤ Real.log 2 := by
    have hh := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
    norm_num at hh ⊢
    linarith
  have h4 : (1 : ℝ) ≤ Real.log 4 := by
    rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]
    norm_num
    linarith
  exact h4.trans (Real.log_le_log (by norm_num) (by linarith))

/-- Any finite set of bounded-height evaluation magnitudes occupies
at most the source's polynomial-logarithmic number of dyadic bins. -/
theorem rational_magnitude_bins_card_le {d : ℕ} {B : ℝ} (hB : 2 ≤ B)
    (L : (Fin d → ℚ) →ₗ[ℚ] ℝ) (s : Finset ℝ) (hs : ∀ x ∈ s, 0 < x)
    (hrepr : ∀ x ∈ s, ∃ v : Fin d → ℚ,
      (∀ j, (rationalHeight (v j) : ℝ) ≤ B) ∧ |L v| = x) :
    ((logarithmicMagnitudeBins s (Real.log 2)).card : ℝ) ≤
      32 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B) := by
  obtain ⟨t, ht, hcover⟩ := rational_logarithmic_cover hB L
  have hcov : ∀ x ∈ s, ∃ a ∈ t, Real.log x ∈
      Set.Icc a (a + 8 * (d + 1 : ℝ) ^ 3 * Real.log (2 * B)) := by
    intro x hx
    obtain ⟨v, hv, he⟩ := hrepr x hx
    have hne : L v ≠ 0 := abs_pos.mp (he.symm ▸ hs x hx)
    simpa only [he] using hcover v hv hne
  have hL := height_log_one_le hB
  have h2 : (1 : ℝ) / 2 ≤ Real.log 2 := by
    have hh := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
    norm_num at hh ⊢
    linarith
  have h2p : 0 < Real.log 2 := by linarith
  have hD : (1 : ℝ) ≤ d + 1 := le_add_of_nonneg_left (Nat.cast_nonneg d)
  have hA : 1 ≤ (d + 1 : ℝ) ^ 3 * Real.log (2 * B) := by
    have hp := one_le_pow₀ hD (n := 3)
    nlinarith only [hL, hp]
  have hW : 0 ≤ 8 * (d + 1 : ℝ) ^ 3 * Real.log (2 * B) := by positivity
  have hdiv : 8 * (d + 1 : ℝ) ^ 3 * Real.log (2 * B) / Real.log 2 ≤
      16 * (d + 1 : ℝ) ^ 3 * Real.log (2 * B) := by
    apply (div_le_iff₀ h2p).mpr
    nlinarith only [mul_nonneg (show 0 ≤ (d + 1 : ℝ) ^ 3 * Real.log (2 * B) by linarith)
      (sub_nonneg.mpr h2)]
  calc
    _ ≤ (t.card : ℝ) * (8 * (d + 1 : ℝ) ^ 3 * Real.log (2 * B) / Real.log 2 + 2) :=
      logarithmicMagnitudeBins_card_le s t h2p hW hcov
    _ ≤ (d + 1 : ℝ) * (32 * (d + 1 : ℝ) ^ 3 * Real.log (2 * B)) := by
      apply mul_le_mul
      · have hh : (t.card : ℝ) ≤ d := by exact_mod_cast ht
        linarith
      · nlinarith
      · positivity
      · positivity
    _ = _ := by ring

/-- The exact finite set of dyadic bins occupied by nonzero rational
evaluations with real height budget `B`. -/
noncomputable def rationalMagnitudeBins {d : ℕ} (B : ℝ)
    (L : (Fin d → ℚ) →ₗ[ℚ] ℝ) : Finset ℤ :=
  logarithmicMagnitudeBins (boundedRationalMagnitudes ⌊B⌋₊ L) (Real.log 2)

/-- Blueprint `lem:height`, line 603: all bounded-height frequencies
occupy at most `32 (d+1)^4 log(2B)` dyadic magnitude bins. -/
theorem rationalMagnitudeBins_card_le {d : ℕ} {B : ℝ} (hB : 2 ≤ B)
    (L : (Fin d → ℚ) →ₗ[ℚ] ℝ) :
    ((rationalMagnitudeBins B L).card : ℝ) ≤
      32 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B) := by
  apply rational_magnitude_bins_card_le hB L
  · intro x hx
    exact (mem_boundedRationalMagnitudes.mp hx).1
  · intro x hx
    obtain ⟨_, v, hv, he⟩ := mem_boundedRationalMagnitudes.mp hx
    exact ⟨v, fun k => (Nat.le_floor_iff (by linarith)).mp (hv k), he⟩

/-- Translating logarithmic intervals along an integer grid gives a
finite set of crossing scales with a uniform count. -/
theorem finite_logarithmic_scale_count (s t : Finset ℝ) {δ W A B : ℝ}
    (hδ : 0 < δ) (hW : 0 ≤ W) (hAB : A ≤ B) (v : ℝ)
    (hcover : ∀ x ∈ s, ∃ a ∈ t, Real.log x ∈ Set.Icc a (a + W)) :
    ∃ N : Finset ℤ,
      (∀ n, n ∈ N ↔ ∃ x ∈ s, A ≤ Real.log x + v - δ * n ∧
        Real.log x + v - δ * n ≤ B) ∧
      (N.card : ℝ) ≤ t.card * ((W + B - A) / δ + 2) := by
  classical
  let J := fun a : ℝ => Finset.Icc ⌊(a + v - B) / δ⌋ ⌊(a + W + v - A) / δ⌋
  let U := t.biUnion J
  let P := fun n : ℤ => ∃ x ∈ s, A ≤ Real.log x + v - δ * n ∧
    Real.log x + v - δ * n ≤ B
  have hcontains : ∀ n, P n → n ∈ U := by
    intro n hn
    obtain ⟨x, hx, hlow, hhigh⟩ := hn
    obtain ⟨a, ha, haLow, haHigh⟩ := hcover x hx
    have hlo : (a + v - B) / δ ≤ (n : ℝ) := (div_le_iff₀ hδ).mpr (by nlinarith)
    have hhi : (n : ℝ) ≤ (a + W + v - A) / δ := (le_div_iff₀ hδ).mpr (by nlinarith)
    have hfl : ⌊(a + v - B) / δ⌋ ≤ n := by simpa using Int.floor_mono hlo
    exact Finset.mem_biUnion.mpr ⟨a, ha, Finset.mem_Icc.mpr ⟨hfl, Int.le_floor.mpr hhi⟩⟩
  have hJ : ∀ a, ((J a).card : ℝ) ≤ (W + B - A) / δ + 2 := by
    intro a
    have hh := integer_floor_interval_card_le
      (div_le_div_of_nonneg_right
        (show a + v - B ≤ a + W + v - A by linarith) hδ.le)
    convert hh using 1; ring
  refine ⟨U.filter P, ?_, ?_⟩
  · intro n
    exact ⟨fun hn => (Finset.mem_filter.mp hn).2,
      fun hn => Finset.mem_filter.mpr ⟨hcontains n hn, hn⟩⟩
  · calc
      _ ≤ (U.card : ℝ) := by exact_mod_cast Finset.card_filter_le U P
      _ ≤ ∑ a ∈ t, ((J a).card : ℝ) := by exact_mod_cast Finset.card_biUnion_le
      _ ≤ ∑ _a ∈ t, ((W + B - A) / δ + 2) := Finset.sum_le_sum (fun a _ => hJ a)
      _ = _ := by simp; ring

/-- Uniform translated-scale count for bounded-height evaluations in
logarithmic coordinates; the grid spacing may be any value at least `log 2`. -/
theorem rational_logarithmic_scale_count {d : ℕ} {B : ℝ} (hB : 2 ≤ B)
    (L : (Fin d → ℚ) →ₗ[ℚ] ℝ) {δ : ℝ} (hδ : Real.log 2 ≤ δ)
    (v p q : ℝ) (hpq : p ≤ q) :
    ∃ N : Finset ℤ,
      (∀ n, n ∈ N ↔ ∃ a : Fin d → ℚ,
        (∀ j, (rationalHeight (a j) : ℝ) ≤ B) ∧ L a ≠ 0 ∧
        p ≤ Real.log |L a| + v - δ * n ∧ Real.log |L a| + v - δ * n ≤ q) ∧
      (N.card : ℝ) ≤ 32 * (d + 1 : ℝ) ^ 4 * (Real.log (2 * B) + q - p) := by
  classical
  obtain ⟨t, ht, hcover⟩ := rational_logarithmic_cover hB L
  let s := boundedRationalMagnitudes ⌊B⌋₊ L
  have hcov : ∀ x ∈ s, ∃ a ∈ t, Real.log x ∈
      Set.Icc a (a + 8 * (d + 1 : ℝ) ^ 3 * Real.log (2 * B)) := by
    intro x hx
    obtain ⟨hxpos, a, ha, rfl⟩ := mem_boundedRationalMagnitudes.mp hx
    exact hcover a (fun j => (Nat.le_floor_iff (by linarith)).mp (ha j)) (abs_pos.mp hxpos)
  have hL := height_log_one_le hB
  have hhalf : (1 : ℝ) / 2 ≤ Real.log 2 := by
    have hh := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
    norm_num at hh ⊢
    linarith
  have hδp : 0 < δ := by linarith
  have hW : 0 ≤ 8 * (d + 1 : ℝ) ^ 3 * Real.log (2 * B) := by positivity
  obtain ⟨N, hN, hcard⟩ := finite_logarithmic_scale_count s t hδp hW hpq v hcov
  refine ⟨N, ?_, ?_⟩
  · intro n
    rw [hN n]
    constructor
    · rintro ⟨x, hx, hlo, hhi⟩
      obtain ⟨hxpos, a, ha, rfl⟩ := mem_boundedRationalMagnitudes.mp hx
      exact ⟨a, fun j => (Nat.le_floor_iff (by linarith only [hB])).mp (ha j),
        abs_pos.mp hxpos, hlo, hhi⟩
    · rintro ⟨a, ha, hne, hlo, hhi⟩
      exact ⟨|L a|, mem_boundedRationalMagnitudes.mpr
        ⟨abs_pos.mpr hne, a, fun j => Nat.le_floor (ha j), rfl⟩, hlo, hhi⟩
  · have hD : (1 : ℝ) ≤ d + 1 := le_add_of_nonneg_left (Nat.cast_nonneg d)
    have hD3 : 1 ≤ (d + 1 : ℝ) ^ 3 := one_le_pow₀ hD
    have hM : 1 ≤ Real.log (2 * B) + q - p := by linarith
    have hprod : 1 ≤ (d + 1 : ℝ) ^ 3 * (Real.log (2 * B) + q - p) := by nlinarith only [hpq, hL,
        hD3]
    have hwidth : 8 * (d + 1 : ℝ) ^ 3 * Real.log (2 * B) + q - p ≤
        8 * (d + 1 : ℝ) ^ 3 * (Real.log (2 * B) + q - p) := by
      nlinarith only [mul_nonneg (sub_nonneg.mpr hD3) (sub_nonneg.mpr hpq), hpq]
    have hdiv : (8 * (d + 1 : ℝ) ^ 3 * Real.log (2 * B) + q - p) / δ ≤
        16 * (d + 1 : ℝ) ^ 3 * (Real.log (2 * B) + q - p) := by
      apply (div_le_iff₀ hδp).mpr
      nlinarith only [mul_nonneg
        (show 0 ≤ (d + 1 : ℝ) ^ 3 * (Real.log (2 * B) + q - p) by linarith)
        (show 0 ≤ δ - 1 / 2 by linarith), hpq, hD3]
    calc
      _ ≤ (t.card : ℝ) * ((8 * (d + 1 : ℝ) ^ 3 * Real.log (2 * B) + q - p) / δ + 2) := hcard
      _ ≤ (d + 1 : ℝ) * (32 * (d + 1 : ℝ) ^ 3 * (Real.log (2 * B) + q - p)) := by
        apply mul_le_mul
        · have hh : (t.card : ℝ) ≤ d := by exact_mod_cast ht
          linarith
        · nlinarith only [hpq, hL, hD3, hdiv]
        · apply add_nonneg
          · exact div_nonneg (by linarith) hδp.le
          · norm_num
        · positivity
      _ = _ := by ring

/-- The translated dyadic scale count, uniform in the scale multiplier
and valid for every positive integral dilation exponent. -/
theorem rational_dyadic_scale_count {d u : ℕ} {B α β : ℝ} (hB : 2 ≤ B)
    (hu : 1 ≤ u) (hα : 0 < α) (hαβ : α ≤ β)
    (L : (Fin d → ℚ) →ₗ[ℚ] ℝ) (c : ℝ) :
    ∃ N : Finset ℤ,
      (∀ n, n ∈ N ↔ ∃ a : Fin d → ℚ,
        (∀ j, (rationalHeight (a j) : ℝ) ≤ B) ∧
        α ≤ c * ((2 : ℝ) ^ (-n)) ^ u * |L a| ∧
        c * ((2 : ℝ) ^ (-n)) ^ u * |L a| ≤ β) ∧
      (N.card : ℝ) ≤ 32 * (d + 1 : ℝ) ^ 4 *
        (Real.log (2 * B) + Real.log (2 * β / α)) := by
  have hβ : 0 < β := hα.trans_le hαβ
  have hratio : 0 ≤ Real.log (2 * β / α) := Real.log_nonneg
    ((le_div_iff₀ hα).mpr (by linarith))
  have hL := height_log_one_le hB
  by_cases hc : 0 < c
  · have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
    have huR : (1 : ℝ) ≤ u := by exact_mod_cast hu
    have hδ : Real.log 2 ≤ (u : ℝ) * Real.log 2 :=
      le_mul_of_one_le_left hlog2.le huR
    obtain ⟨N, hN, hcard⟩ := rational_logarithmic_scale_count hB L hδ
      (Real.log c) (Real.log α) (Real.log β) (Real.log_le_log hα hαβ)
    have heq : ∀ (a : Fin d → ℚ) (n : ℤ), L a ≠ 0 →
        Real.log (c * ((2 : ℝ) ^ (-n)) ^ u * |L a|) =
          Real.log |L a| + Real.log c - ((u : ℝ) * Real.log 2) * n := by
      intro a n ha
      have hp : 0 < (2 : ℝ) ^ (-n) := zpow_pos (by norm_num) _
      rw [Real.log_mul (mul_pos hc (pow_pos hp _)).ne' (abs_pos.mpr ha).ne',
        Real.log_mul hc.ne' (pow_pos hp _).ne', Real.log_pow, Real.log_zpow]
      push_cast
      ring
    refine ⟨N, ?_, hcard.trans ?_⟩
    · intro n
      rw [hN n]
      constructor
      · rintro ⟨a, ha, hne, hlo, hhi⟩
        have hp : 0 < c * ((2 : ℝ) ^ (-n)) ^ u * |L a| := by
          exact mul_pos (mul_pos hc (pow_pos (zpow_pos (by norm_num) _) _)) (abs_pos.mpr hne)
        rw [← heq a n hne] at hlo hhi
        exact ⟨a, ha, (Real.log_le_log_iff hα hp).mp hlo,
          (Real.log_le_log_iff hp hβ).mp hhi⟩
      · rintro ⟨a, ha, hlo, hhi⟩
        have hne : L a ≠ 0 := by
          intro hz
          simp only [hz, abs_zero, mul_zero] at hlo
          exact (not_le_of_gt hα) hlo
        refine ⟨a, ha, hne, ?_, ?_⟩
        · rw [← heq a n hne]
          exact Real.log_le_log hα hlo
        · rw [← heq a n hne]
          exact Real.log_le_log (hα.trans_le hlo) hhi
    · apply mul_le_mul_of_nonneg_left _ (by positivity)
      have hh : Real.log β - Real.log α ≤ Real.log (2 * β / α) := by
        rw [← Real.log_div hβ.ne' hα.ne']
        exact Real.log_le_log (div_pos hβ hα)
          (div_le_div_of_nonneg_right (by linarith) hα.le)
      linarith
  · refine ⟨∅, ?_, ?_⟩
    · intro n
      simp only [Finset.notMem_empty, false_iff]
      rintro ⟨a, _, hlo, _⟩
      have hp : 0 ≤ ((2 : ℝ) ^ (-n)) ^ u := pow_nonneg (zpow_nonneg (by norm_num) _) _
      have hnonpos : c * ((2 : ℝ) ^ (-n)) ^ u * |L a| ≤ 0 :=
        mul_nonpos_of_nonpos_of_nonneg
          (mul_nonpos_of_nonpos_of_nonneg (le_of_not_gt hc) hp) (abs_nonneg _)
      linarith
    · simp only [Finset.card_empty, Nat.cast_zero]
      positivity

/-- Blueprint `lem:height`, lines 603-607: the source scale formula
`r_n = r_0 2^(-n)`, for every positive integer exponent (in particular 1 and 2). -/
theorem rational_frequency_scale_count {d u : ℕ} {B α β : ℝ} (hB : 2 ≤ B)
    (hu : 1 ≤ u) (hα : 0 < α) (hαβ : α ≤ β) (ξ : Fin d → ℝ) (r₀ : ℝ) :
    ∃ N : Finset ℤ,
      (∀ n, n ∈ N ↔ ∃ a : Fin d → ℚ,
        (∀ j, (rationalHeight (a j) : ℝ) ≤ B) ∧
        α ≤ (r₀ * (2 : ℝ) ^ (-n)) ^ u * |∑ j, (a j : ℝ) * ξ j| ∧
        (r₀ * (2 : ℝ) ^ (-n)) ^ u * |∑ j, (a j : ℝ) * ξ j| ≤ β) ∧
      (N.card : ℝ) ≤ 32 * (d + 1 : ℝ) ^ 4 *
        (Real.log (2 * B) + Real.log (2 * β / α)) := by
  simpa only [mul_pow, rationalEvaluation, LinearMap.coe_mk, AddHom.coe_mk] using
    rational_dyadic_scale_count hB hu hα hαβ (rationalEvaluation ξ) (r₀ ^ u)

/-- Keep a nonnegative magnitude only when it is below the specified threshold. -/
noncomputable def upperTruncatedMagnitude (ε x : ℝ) : ℝ := if x ≤ ε then x else 0

theorem upperTruncatedMagnitude_nonneg (ε : ℝ) {x : ℝ} (hx : 0 ≤ x) :
    0 ≤ upperTruncatedMagnitude ε x := by
  unfold upperTruncatedMagnitude
  split_ifs <;> positivity

/-- A geometrically decreasing integer sequence contributes at most
twice the cutoff threshold to every finite truncated sum. -/
theorem integer_geometric_truncated_sum_le (q : ℤ → ℝ) {ε : ℝ} (hε : 0 ≤ ε)
    (hdecay : ∀ m n : ℤ, m ≤ n → q n ≤ q m * ((1 : ℝ) / 2) ^ (n - m).toNat)
    (F : Finset ℤ) :
    ∑ n ∈ F, upperTruncatedMagnitude ε (q n) ≤ 2 * ε := by
  classical
  let I := F.filter (fun n => q n ≤ ε)
  have heq : ∑ n ∈ F, upperTruncatedMagnitude ε (q n) = ∑ n ∈ I, q n := by
    simp [I, upperTruncatedMagnitude, Finset.sum_filter]
  rw [heq]
  by_cases hI : I.Nonempty
  · let m := I.min' hI
    have hm : m ∈ I := I.min'_mem hI
    have hqm : q m ≤ ε := (Finset.mem_filter.mp hm).2
    have hmin : ∀ n ∈ I, m ≤ n := fun n hn => I.min'_le n hn
    have hinj : Set.InjOn (fun n : ℤ => (n - m).toNat) (I : Set ℤ) := by
      intro n hn k hk he
      have hn0 : 0 ≤ n - m := sub_nonneg.mpr (hmin n hn)
      have hk0 : 0 ≤ k - m := sub_nonneg.mpr (hmin k hk)
      have hecast := congrArg (fun r : ℕ => (r : ℤ)) he
      dsimp only at hecast
      rw [Int.toNat_of_nonneg hn0, Int.toNat_of_nonneg hk0] at hecast
      omega
    calc
      _ ≤ ∑ n ∈ I, ε * ((1 : ℝ) / 2) ^ (n - m).toNat := by
        apply Finset.sum_le_sum
        intro n hn
        exact (hdecay m n (hmin n hn)).trans
          (mul_le_mul_of_nonneg_right hqm (by positivity))
      _ = ∑ k ∈ I.image (fun n : ℤ => (n - m).toNat), ε * ((1 : ℝ) / 2) ^ k :=
        (Finset.sum_image (f := fun k => ε * ((1 : ℝ) / 2) ^ k) hinj).symm
      _ ≤ ∑' k : ℕ, ε * ((1 : ℝ) / 2) ^ k :=
        (summable_geometric_two.mul_left ε).sum_le_tsum _ (fun _ _ => by positivity)
      _ = 2 * ε := by
        rw [(hasSum_geometric_two.mul_left ε).tsum_eq, mul_comm]
  · have hh : I = ∅ := Finset.not_nonempty_iff_eq_empty.mp hI
    rw [hh, Finset.sum_empty]
    positivity

/-- A dyadically decaying magnitude profile, indexed by every integer scale. -/
noncomputable def dyadicMagnitudeProfile (c : ℝ) (u : ℕ) (n : ℤ) : ℝ :=
  c * ((2 : ℝ) ^ (-n)) ^ u

theorem dyadicMagnitudeProfile_nonneg {c : ℝ} (hc : 0 ≤ c) (u : ℕ) (n : ℤ) :
    0 ≤ dyadicMagnitudeProfile c u n := by
  unfold dyadicMagnitudeProfile
  positivity

theorem dyadicMagnitudeProfile_decay {c : ℝ} (hc : 0 ≤ c) {u : ℕ} (hu : 1 ≤ u)
    (m n : ℤ) (hmn : m ≤ n) :
    dyadicMagnitudeProfile c u n ≤
      dyadicMagnitudeProfile c u m * ((1 : ℝ) / 2) ^ (n - m).toNat := by
  let k := (n - m).toNat
  have hkcast : (k : ℤ) = n - m := Int.toNat_of_nonneg (sub_nonneg.mpr hmn)
  have hn : n = m + (k : ℤ) := by omega
  have hbase : (2 : ℝ) ^ (-n) = (2 : ℝ) ^ (-m) * ((1 : ℝ) / 2) ^ k := by
    rw [hn, neg_add, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_neg (2 : ℝ) (k : ℤ),
      zpow_natCast, ← inv_pow]
    norm_num
  have hk1 : ((1 : ℝ) / 2) ^ k ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
  have hku : (((1 : ℝ) / 2) ^ k) ^ u ≤ ((1 : ℝ) / 2) ^ k := by
    obtain ⟨v, rfl⟩ := Nat.exists_eq_add_of_le hu
    rw [pow_add, pow_one]
    exact mul_le_of_le_one_right (by positivity) (pow_le_one₀ (by positivity) hk1)
  calc
    _ = dyadicMagnitudeProfile c u m * (((1 : ℝ) / 2) ^ k) ^ u := by
      unfold dyadicMagnitudeProfile
      rw [hbase, mul_pow]
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_left hku (dyadicMagnitudeProfile_nonneg hc u m)

theorem dyadicMagnitudeProfile_truncated_sum_le {c ε : ℝ} (hc : 0 ≤ c) (hε : 0 ≤ ε)
    {u : ℕ} (hu : 1 ≤ u) (F : Finset ℤ) :
    ∑ n ∈ F, upperTruncatedMagnitude ε (dyadicMagnitudeProfile c u n) ≤ 2 * ε :=
  integer_geometric_truncated_sum_le _ hε (dyadicMagnitudeProfile_decay hc hu) F

/-- Maximum of the positive scaled magnitudes below `ε`, with the
source convention that an empty maximum is zero. -/
noncomputable def finiteTinyMaximum (s : Finset ℝ) (w ε : ℝ) : ℝ := by
  classical
  exact (insert 0 ((s.image (fun x => w * x)).filter (fun y => 0 < y ∧ y ≤ ε))).max'
    (Finset.insert_nonempty _ _)

theorem finiteTinyMaximum_nonneg (s : Finset ℝ) (w ε : ℝ) :
    0 ≤ finiteTinyMaximum s w ε := by
  classical
  unfold finiteTinyMaximum
  exact Finset.le_max' _ _ (Finset.mem_insert_self _ _)

theorem finiteTinyMaximum_le (s : Finset ℝ) (w ε : ℝ) {M : ℝ} (hM : 0 ≤ M)
    (hs : ∀ x ∈ s, 0 < w * x → w * x ≤ ε → w * x ≤ M) :
    finiteTinyMaximum s w ε ≤ M := by
  classical
  unfold finiteTinyMaximum
  apply Finset.max'_le
  intro y hy
  rcases Finset.mem_insert.mp hy with rfl | hy
  · exact hM
  · obtain ⟨hy, hpos, hsmall⟩ := Finset.mem_filter.mp hy
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hy
    exact hs x hx hpos hsmall

theorem finiteTinyMaximum_eq_zero_of_nonpos (s : Finset ℝ) (ε : ℝ)
    (hs : ∀ x ∈ s, 0 ≤ x) {w : ℝ} (hw : w ≤ 0) :
    finiteTinyMaximum s w ε = 0 := by
  apply le_antisymm _ (finiteTinyMaximum_nonneg s w ε)
  apply finiteTinyMaximum_le s w ε le_rfl
  intro x hx _ _
  exact mul_nonpos_of_nonpos_of_nonneg hw (hs x hx)

/-- In one occupied dyadic bin the small maximum is at most twice
its lower endpoint, provided that endpoint is below the cutoff. -/
theorem finiteTinyMaximum_le_bins (s : Finset ℝ) (hs : ∀ x ∈ s, 0 < x)
    {w : ℝ} (hw : 0 ≤ w) (ε : ℝ) :
    finiteTinyMaximum s w ε ≤
      ∑ j ∈ logarithmicMagnitudeBins s (Real.log 2),
        2 * upperTruncatedMagnitude ε (w * (2 : ℝ) ^ j) := by
  classical
  have hnonneg : ∀ j : ℤ, 0 ≤ 2 * upperTruncatedMagnitude ε (w * (2 : ℝ) ^ j) := by
    intro j
    exact mul_nonneg (by norm_num) (upperTruncatedMagnitude_nonneg ε (by positivity))
  apply finiteTinyMaximum_le s w ε (Finset.sum_nonneg (fun j _ => hnonneg j))
  intro x hx _ hsmall
  let j := ⌊Real.log x / Real.log 2⌋
  have hj : j ∈ logarithmicMagnitudeBins s (Real.log 2) := Finset.mem_image.mpr ⟨x, hx, rfl⟩
  have hbin := dyadicMagnitudeBin_spec (hs x hx)
  have hlow : w * (2 : ℝ) ^ j ≤ ε := (mul_le_mul_of_nonneg_left hbin.1 hw).trans hsmall
  have hhigh : w * x ≤ 2 * (w * (2 : ℝ) ^ j) := by
    have hh := mul_le_mul_of_nonneg_left hbin.2.le hw
    change w * x ≤ w * (2 : ℝ) ^ (j + 1) at hh
    rw [zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_one] at hh
    nlinarith
  calc
    _ ≤ 2 * (w * (2 : ℝ) ^ j) := hhigh
    _ = 2 * upperTruncatedMagnitude ε (w * (2 : ℝ) ^ j) := by
      rw [upperTruncatedMagnitude, ite_eq_left hlow]
    _ ≤ _ := Finset.single_le_sum (fun k _ => hnonneg k) hj

theorem finiteTinyMaximum_dyadic_sum_le (s : Finset ℝ) (hs : ∀ x ∈ s, 0 < x)
    (c : ℝ) {u : ℕ} (hu : 1 ≤ u) {ε : ℝ} (hε : 0 ≤ ε) (F : Finset ℤ) :
    ∑ n ∈ F, finiteTinyMaximum s (dyadicMagnitudeProfile c u n) ε ≤
      4 * (logarithmicMagnitudeBins s (Real.log 2)).card * ε := by
  classical
  by_cases hc : 0 ≤ c
  · have hpoint : ∀ n : ℤ, finiteTinyMaximum s (dyadicMagnitudeProfile c u n) ε ≤
        ∑ j ∈ logarithmicMagnitudeBins s (Real.log 2),
          2 * upperTruncatedMagnitude ε (dyadicMagnitudeProfile (c * (2 : ℝ) ^ j) u n) := by
      intro n
      have hh := finiteTinyMaximum_le_bins s hs (dyadicMagnitudeProfile_nonneg hc u n) ε
      convert hh using 1
      apply Finset.sum_congr rfl
      intro j _
      congr 2
      unfold dyadicMagnitudeProfile
      ring
    calc
      _ ≤ ∑ n ∈ F, ∑ j ∈ logarithmicMagnitudeBins s (Real.log 2),
          2 * upperTruncatedMagnitude ε (dyadicMagnitudeProfile (c * (2 : ℝ) ^ j) u n) :=
        Finset.sum_le_sum (fun n _ => hpoint n)
      _ = ∑ j ∈ logarithmicMagnitudeBins s (Real.log 2), ∑ n ∈ F,
          2 * upperTruncatedMagnitude ε (dyadicMagnitudeProfile (c * (2 : ℝ) ^ j) u n) :=
        Finset.sum_comm
      _ ≤ ∑ _j ∈ logarithmicMagnitudeBins s (Real.log 2), 4 * ε := by
        apply Finset.sum_le_sum
        intro j _
        rw [← Finset.mul_sum]
        have hh := dyadicMagnitudeProfile_truncated_sum_le
          (show 0 ≤ c * (2 : ℝ) ^ j by positivity) hε hu F
        nlinarith
      _ = _ := by simp; ring
  · have hzero : ∀ n, finiteTinyMaximum s (dyadicMagnitudeProfile c u n) ε = 0 := by
      intro n
      apply finiteTinyMaximum_eq_zero_of_nonpos s ε (fun x hx => (hs x hx).le)
      exact mul_nonpos_of_nonpos_of_nonneg (le_of_not_ge hc) (by positivity)
    simp only [hzero, Finset.sum_const_zero]
    positivity

/-- The tiny maxima are summable over all integer scales, with four
times the cutoff threshold per occupied dyadic magnitude bin. -/
theorem finiteTinyMaximum_dyadic_tsum_le (s : Finset ℝ) (hs : ∀ x ∈ s, 0 < x)
    (c : ℝ) {u : ℕ} (hu : 1 ≤ u) {ε : ℝ} (hε : 0 ≤ ε) :
    Summable (fun n : ℤ => finiteTinyMaximum s (dyadicMagnitudeProfile c u n) ε) ∧
      (∑' n : ℤ, finiteTinyMaximum s (dyadicMagnitudeProfile c u n) ε) ≤
        4 * (logarithmicMagnitudeBins s (Real.log 2)).card * ε := by
  have hnonneg : 0 ≤ fun n : ℤ => finiteTinyMaximum s (dyadicMagnitudeProfile c u n) ε :=
    fun n => finiteTinyMaximum_nonneg s _ ε
  have hsum := finiteTinyMaximum_dyadic_sum_le s hs c hu hε
  exact ⟨summable_of_sum_le hnonneg hsum, Real.tsum_le_of_sum_le hnonneg hsum⟩

theorem le_finiteTinyMaximum {s : Finset ℝ} {w ε x : ℝ} (hx : x ∈ s)
    (hpos : 0 < w * x) (hsmall : w * x ≤ ε) :
    w * x ≤ finiteTinyMaximum s w ε := by
  classical
  unfold finiteTinyMaximum
  exact Finset.le_max' _ _ (Finset.mem_insert_of_mem (Finset.mem_filter.mpr
    ⟨Finset.mem_image.mpr ⟨x, hx, rfl⟩, hpos, hsmall⟩))

/-- The exact tiny maximum over all bounded-height rational evaluations. -/
noncomputable def rationalTinyMaximum {d : ℕ} (B : ℝ)
    (L : (Fin d → ℚ) →ₗ[ℚ] ℝ) (c : ℝ) (u : ℕ) (ε : ℝ) (n : ℤ) : ℝ :=
  finiteTinyMaximum (boundedRationalMagnitudes ⌊B⌋₊ L) (dyadicMagnitudeProfile c u n) ε

/-- Blueprint `lem:height`, tiny-sum formula, lines 608-614 and 617:
the exact tiny maxima are summable and bounded by the occupied-bin count. -/
theorem rationalTinyMaximum_tsum_le {d u : ℕ} {B ε : ℝ} (hB : 2 ≤ B)
    (hu : 1 ≤ u) (hε : 0 ≤ ε) (L : (Fin d → ℚ) →ₗ[ℚ] ℝ) (c : ℝ) :
    Summable (rationalTinyMaximum B L c u ε) ∧
      (∑' n : ℤ, rationalTinyMaximum B L c u ε n) ≤
        128 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B) * ε := by
  obtain ⟨hsum, hbound⟩ := finiteTinyMaximum_dyadic_tsum_le
    (boundedRationalMagnitudes ⌊B⌋₊ L)
    (fun _ hx => (mem_boundedRationalMagnitudes.mp hx).1) c hu hε
  refine ⟨hsum, hbound.trans ?_⟩
  have hcard := rationalMagnitudeBins_card_le hB L
  calc
    _ ≤ 4 * (32 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B)) * ε :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hcard (by norm_num)) hε
    _ = _ := by ring

/-- The source tiny-sum estimate with `r_n = r_0 2^(-n)` and dot-product
frequencies, including the empty-maximum convention and actual summability. -/
theorem rational_frequency_tiny_sum {d u : ℕ} {B ε : ℝ} (hB : 2 ≤ B)
    (hu : 1 ≤ u) (hε : 0 ≤ ε) (ξ : Fin d → ℝ) (r₀ : ℝ) :
    Summable (fun n : ℤ => finiteTinyMaximum
      (boundedRationalMagnitudes ⌊B⌋₊ (rationalEvaluation ξ))
      ((r₀ * (2 : ℝ) ^ (-n)) ^ u) ε) ∧
      (∑' n : ℤ, finiteTinyMaximum
        (boundedRationalMagnitudes ⌊B⌋₊ (rationalEvaluation ξ))
        ((r₀ * (2 : ℝ) ^ (-n)) ^ u) ε) ≤
          128 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B) * ε := by
  obtain ⟨hs, hb⟩ := rationalTinyMaximum_tsum_le hB hu hε (rationalEvaluation ξ) (r₀ ^ u)
  constructor
  · convert hs using 1
    funext n
    simp only [rationalTinyMaximum, dyadicMagnitudeProfile, mul_pow]
  · simpa only [rationalTinyMaximum, dyadicMagnitudeProfile, mul_pow] using hb

open Matrix
open scoped Matrix

noncomputable def quadraticReturnFrequency {d k : ℕ}
    (C : Matrix (Fin d) (Fin d) ℝ) (V : Matrix (Fin d) (Fin k) ℝ)
    (Λ : Matrix (Fin k) (Fin k) ℝ) (h : Fin k → ℝ) (m : Fin d → ℝ) : Fin k → ℝ :=
  (2 • Λ + V.transpose * C * V).mulVec h -
    (V.transpose * (C - C.transpose)).mulVec m

theorem realMatrixOperator_range {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) :
    (realMatrixOperator A).range =
      Submodule.span ℝ (Set.range (fun j => WithLp.toLp 2 (A.col j))) := by
  have h := congrArg (Submodule.map (realMatrixOperator A).toLinearMap)
    (EuclideanSpace.basisFun (Fin n) ℝ).toBasis.span_eq
  rw [Submodule.map_span, Submodule.map_top, ← Set.range_comp] at h
  have he : (fun i => (realMatrixOperator A).toLinearMap
      ((EuclideanSpace.basisFun (Fin n) ℝ).toBasis i)) =
      (fun j => WithLp.toLp 2 (A.col j)) := by
    funext i
    ext j
    simp [realMatrixOperator, Matrix.toEuclideanLin, EuclideanSpace.basisFun_apply,
      Matrix.mulVec, dotProduct, Pi.single_apply]
  simp only [Function.comp_def] at h
  rw [he] at h
  exact h.symm

theorem rationalRealRowSpace_eq_span {m n : ℕ} (S : Matrix (Fin m) (Fin n) ℚ) :
    rationalRealRowSpace S =
      Submodule.span ℝ (Set.range (fun i => WithLp.toLp 2 (fun j => (S i j : ℝ)))) := by
  exact realMatrixOperator_range (S.transpose.map (fun q => (q : ℝ)))

theorem rationalHeight_intCast_bound (z : ℤ) {B : ℝ} (hB : 1 ≤ B)
    (hz : |(z : ℝ)| ≤ B) : (rationalHeight (z : ℚ) : ℝ) ≤ B := by
  simpa only [rationalHeight, Rat.num_intCast, Rat.den_intCast, Nat.cast_max,
    Nat.cast_one, Nat.cast_natAbs, Int.cast_abs] using max_le hz hB

/-- A subspace generated by bounded integer vectors has rational orthogonal
projections with a uniform height bound, independent of the list length. -/
theorem integer_span_projection_bounds {m n : ℕ}
    (Z : Matrix (Fin m) (Fin n) ℤ) {B : ℝ} (hB : 2 ≤ B)
    (hZ : ∀ i j, |(Z i j : ℝ)| ≤ B) :
    let U := Submodule.span ℝ
      (Set.range (fun i => WithLp.toLp 2 (fun j => (Z i j : ℝ))))
    ∃ P : Matrix (Fin n) (Fin n) ℚ,
      realMatrixOperator (P.map (fun q => (q : ℝ))) = U.starProjection ∧
      realMatrixOperator ((1 - P).map (fun q => (q : ℝ))) = Uᗮ.starProjection ∧
      (∀ i j, (rationalHeight (P i j) : ℝ) ≤
        Real.exp (8 * (n + 1 : ℝ) ^ 4 * Real.log (2 * B))) ∧
      (∀ i j, (rationalHeight ((1 - P) i j) : ℝ) ≤
        Real.exp (8 * (n + 1 : ℝ) ^ 4 * Real.log (2 * B))) ∧
      ‖realMatrixOperator (P.map (fun q => (q : ℝ)))‖ ≤ 1 ∧
      ‖realMatrixOperator ((1 - P).map (fun q => (q : ℝ)))‖ ≤ 1 := by
  intro U
  let S : Matrix (Fin m) (Fin n) ℚ := Z.map (fun z => (z : ℚ))
  have hs : ∀ i j, (rationalHeight (S i j) : ℝ) ≤ B :=
    fun i j => rationalHeight_intCast_bound (Z i j) (by linarith only [hB]) (hZ i j)
  have hh := rationalMatrix_projection_bounds (le_refl n) hB S hs
  have he : rationalRealRowSpace S = U := by
    rw [rationalRealRowSpace_eq_span]
    simp only [S, Matrix.map_apply, Rat.cast_intCast]
    rfl
  rwa [he] at hh

theorem rational_rows_independent_of_real {r n : ℕ} (S : Matrix (Fin r) (Fin n) ℚ)
    (hS : LinearIndependent ℝ (fun i => WithLp.toLp 2 (fun j => (S i j : ℝ)))) :
    LinearIndependent ℚ S.row := by
  let f : (Fin n → ℚ) →ₗ[ℚ] EuclideanSpace ℝ (Fin n) :=
    { toFun := fun x => WithLp.toLp 2 (fun j => (x j : ℝ))
      map_add' := by intro x y; ext j; simp
      map_smul' := by intro a x; ext j; simp [Rat.smul_def] }
  exact LinearIndependent.of_comp f (hS.restrict_scalars' ℚ)

theorem realMatrixOperator_mul_norm_le {l m n : ℕ}
    (A : Matrix (Fin l) (Fin m) ℝ) (B : Matrix (Fin m) (Fin n) ℝ) :
    ‖realMatrixOperator (A * B)‖ ≤ ‖realMatrixOperator A‖ * ‖realMatrixOperator B‖ := by
  have he : realMatrixOperator (A * B) =
      (realMatrixOperator A).comp (realMatrixOperator B) := by
    apply ContinuousLinearMap.ext
    intro x
    exact realMatrixOperator_mul_apply A B x
  rw [he]
  exact ContinuousLinearMap.opNorm_comp_le _ _

theorem real_matrix_mul_entry_bound {l m n : ℕ}
    (A : Matrix (Fin l) (Fin m) ℝ) (B : Matrix (Fin m) (Fin n) ℝ)
    {R S : ℝ} (hR : 0 ≤ R)
    (hA : ∀ i j, |A i j| ≤ R) (hB : ∀ i j, |B i j| ≤ S) (i j) :
    |(A * B) i j| ≤ (m : ℝ) * R * S := by
  calc
    _ ≤ ∑ k, |A i k * B k j| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _k : Fin m, R * S := Finset.sum_le_sum fun k _ => by
      rw [abs_mul]
      exact mul_le_mul (hA i k) (hB k j) (abs_nonneg _) hR
    _ = _ := by simp; ring

theorem rationalRowProjection_mul_norm_le {r n k : ℕ}
    (S : Matrix (Fin r) (Fin n) ℚ) (V : Matrix (Fin n) (Fin k) ℝ)
    (hlin : LinearIndependent ℚ S.row) {B G W : ℝ}
    (hB : 0 ≤ B) (hG : 2 ≤ G) (hW : 0 ≤ W)
    (hS : ∀ i j, |(S i j : ℝ)| ≤ B)
    (hGram : ∀ i j, (rationalHeight ((S * S.transpose) i j) : ℝ) ≤ G)
    (hSV : ∀ i j, |(S.map (fun q => (q : ℝ)) * V) i j| ≤ W) :
    ‖realMatrixOperator ((rationalRowProjection S).map (fun q => (q : ℝ)) * V)‖ ≤
      ((n : ℝ) * r * B) *
        (((r : ℝ) * r * Real.exp (2 * (r + 1 : ℝ) ^ 4 * Real.log (2 * G))) *
          ((r : ℝ) * k * W)) := by
  let E := Real.exp (2 * (r + 1 : ℝ) ^ 4 * Real.log (2 * G))
  have hE : 0 ≤ E := (Real.exp_pos _).le
  have hgin := (rationalMatrix_inverse_bounds (le_refl r) hG (S * S.transpose)
    hGram (rational_gram_det_ne_zero S hlin)).1
  have hi : ‖realMatrixOperator (((S * S.transpose)⁻¹).map (fun q => (q : ℝ)))‖ ≤
      (r : ℝ) * r * E := by
    apply realMatrixOperator_norm_le _ hE
    intro i j
    have hh : |((S * S.transpose)⁻¹ i j : ℝ)| ≤
        (rationalHeight ((S * S.transpose)⁻¹ i j) : ℝ) := by
      exact_mod_cast rational_abs_le_height ((S * S.transpose)⁻¹ i j)
    exact hh.trans (hgin i j)
  have hs := realMatrixOperator_norm_le (S.transpose.map (fun q => (q : ℝ))) hB
    (fun i j => hS j i)
  have hsv := realMatrixOperator_norm_le _ hW hSV
  have he : (rationalRowProjection S).map (fun q => (q : ℝ)) * V =
      S.transpose.map (fun q => (q : ℝ)) *
        (((S * S.transpose)⁻¹).map (fun q => (q : ℝ)) *
          (S.map (fun q => (q : ℝ)) * V)) := by
    unfold rationalRowProjection
    let f := Rat.castHom ℝ
    change (S.transpose * (S * S.transpose)⁻¹ * S).map f * V =
      S.transpose.map f * (((S * S.transpose)⁻¹).map f * (S.map f * V))
    rw [Matrix.map_mul, Matrix.map_mul]
    simp only [Matrix.mul_assoc]
  rw [he]
  apply (realMatrixOperator_mul_norm_le _ _).trans
  apply mul_le_mul hs _ (norm_nonneg _) (by positivity)
  exact (realMatrixOperator_mul_norm_le _ _).trans
    (mul_le_mul hi hsv (norm_nonneg _) (by positivity))

theorem integer_gram_height_bound {r n : ℕ} (Z : Matrix (Fin r) (Fin n) ℤ)
    {B : ℝ} (hB : 0 ≤ B) (hZ : ∀ i j, |(Z i j : ℝ)| ≤ B) (i j) :
    (rationalHeight (((Z.map (fun z => (z : ℚ))) *
      (Z.map (fun z => (z : ℚ))).transpose) i j) : ℝ) ≤ max 2 ((n : ℝ) * B ^ 2) := by
  let R : Matrix (Fin r) (Fin n) ℝ := Z.map (fun z => (z : ℝ))
  have he : ((Z.map (fun z => (z : ℚ))) *
      (Z.map (fun z => (z : ℚ))).transpose) i j = ((Z * Z.transpose) i j : ℚ) := by
    simp [Matrix.mul_apply]
  rw [he]
  apply rationalHeight_intCast_bound _ (le_trans (by norm_num) (le_max_left _ _))
  have hz : ((Z * Z.transpose) i j : ℝ) = (R * R.transpose) i j := by
    simp [R, Matrix.mul_apply]
  rw [hz]
  have hh := real_matrix_mul_entry_bound R R.transpose hB hZ (fun i j => hZ j i) i j
  have hb : |(R * R.transpose) i j| ≤ (n : ℝ) * B ^ 2 := by
    simpa only [pow_two, mul_assoc] using hh
  exact hb.trans (le_max_right _ _)

theorem integerRowProjection_mul_norm_le {r n k : ℕ}
    (Z : Matrix (Fin r) (Fin n) ℤ) (V : Matrix (Fin n) (Fin k) ℝ)
    (hlin : LinearIndependent ℝ (fun i => WithLp.toLp 2 (fun j => (Z i j : ℝ))))
    {B W : ℝ} (hB : 0 ≤ B) (hW : 0 ≤ W)
    (hZ : ∀ i j, |(Z i j : ℝ)| ≤ B)
    (hZV : ∀ i j, |(Z.map (fun z => (z : ℝ)) * V) i j| ≤ W) :
    ‖realMatrixOperator
      ((rationalRowProjection (Z.map (fun z => (z : ℚ)))).map (fun q => (q : ℝ)) * V)‖ ≤
      ((n : ℝ) * r * B) *
        (((r : ℝ) * r *
          Real.exp (2 * (r + 1 : ℝ) ^ 4 * Real.log (2 * max 2 ((n : ℝ) * B ^ 2)))) *
          ((r : ℝ) * k * W)) := by
  let S := Z.map (fun z => (z : ℚ))
  have hs : LinearIndependent ℚ S.row := rational_rows_independent_of_real S
    (by simpa only [S, Matrix.map_apply, Rat.cast_intCast] using hlin)
  have hsb : ∀ i j, |(S i j : ℝ)| ≤ B := by
    simpa only [S, Matrix.map_apply, Rat.cast_intCast] using hZ
  have hsv : ∀ i j, |(S.map (fun q => (q : ℝ)) * V) i j| ≤ W := by
    simpa only [S, Matrix.map_map, Function.comp_def, Rat.cast_intCast] using hZV
  exact rationalRowProjection_mul_norm_le S V hs hB (le_max_left _ _) hW hsb
    (integer_gram_height_bound Z hB hZ) hsv

/-- The same rational orthogonal projection has controlled height and
controlled composition with a matrix whose products with its integer rows
are bounded. No bound on the input matrix itself is assumed. -/
theorem integer_span_projection_velocity_bounds {r n k : ℕ}
    (Z : Matrix (Fin r) (Fin n) ℤ) (V : Matrix (Fin n) (Fin k) ℝ)
    (hlin : LinearIndependent ℝ (fun i => WithLp.toLp 2 (fun j => (Z i j : ℝ))))
    {B W : ℝ} (hB : 2 ≤ B) (hW : 0 ≤ W)
    (hZ : ∀ i j, |(Z i j : ℝ)| ≤ B)
    (hZV : ∀ i j, |(Z.map (fun z => (z : ℝ)) * V) i j| ≤ W) :
    let U := Submodule.span ℝ
      (Set.range (fun i => WithLp.toLp 2 (fun j => (Z i j : ℝ))))
    ∃ P : Matrix (Fin n) (Fin n) ℚ,
      realMatrixOperator (P.map (fun q => (q : ℝ))) = U.starProjection ∧
      realMatrixOperator ((1 - P).map (fun q => (q : ℝ))) = Uᗮ.starProjection ∧
      (∀ i j, (rationalHeight (P i j) : ℝ) ≤
        Real.exp (8 * (n + 1 : ℝ) ^ 4 * Real.log (2 * B))) ∧
      (∀ i j, (rationalHeight ((1 - P) i j) : ℝ) ≤
        Real.exp (8 * (n + 1 : ℝ) ^ 4 * Real.log (2 * B))) ∧
      ‖realMatrixOperator (P.map (fun q => (q : ℝ)))‖ ≤ 1 ∧
      ‖realMatrixOperator ((1 - P).map (fun q => (q : ℝ)))‖ ≤ 1 ∧
      ‖realMatrixOperator (P.map (fun q => (q : ℝ)) * V)‖ ≤
        ((n : ℝ) * r * B) *
          (((r : ℝ) * r *
            Real.exp (2 * (r + 1 : ℝ) ^ 4 * Real.log (2 * max 2 ((n : ℝ) * B ^ 2)))) *
            ((r : ℝ) * k * W)) := by
  intro U
  obtain ⟨P, hp, hpc, hh, hhc, hn, hnc⟩ := integer_span_projection_bounds Z hB hZ
  refine ⟨P, hp, hpc, hh, hhc, hn, hnc, ?_⟩
  let S := Z.map (fun z => (z : ℚ))
  have hs : LinearIndependent ℚ S.row := rational_rows_independent_of_real S
    (by simpa only [S, Matrix.map_apply, Rat.cast_intCast] using hlin)
  have hc := rationalRowProjection_eq_starProjection S hs
  change realMatrixOperator ((rationalRowProjection S).map (fun q => (q : ℝ))) =
    (rationalRealRowSpace S).starProjection at hc
  have heU : rationalRealRowSpace S = U := by
    rw [rationalRealRowSpace_eq_span]
    simp only [S, Matrix.map_apply, Rat.cast_intCast]
    rfl
  rw [heU] at hc
  have he : realMatrixOperator (P.map (fun q => (q : ℝ)) * V) =
      realMatrixOperator ((rationalRowProjection S).map (fun q => (q : ℝ)) * V) := by
    apply ContinuousLinearMap.ext
    intro x
    rw [realMatrixOperator_mul_apply, realMatrixOperator_mul_apply, hp, hc]
  rw [he]
  exact integerRowProjection_mul_norm_le Z V hlin (by linarith only [hB]) hW hZ hZV

theorem real_matrix_mul_entry_eq_row_inner {r n k : ℕ}
    (S : Matrix (Fin r) (Fin n) ℝ) (V : Matrix (Fin n) (Fin k) ℝ) (i j) :
    (S * V) i j = inner ℝ (WithLp.toLp 2 (S.row i))
      (realMatrixOperator V (EuclideanSpace.basisFun (Fin k) ℝ j)) := by
  simp [EuclideanSpace.inner_eq_star_dotProduct, realMatrixOperator,
    Matrix.toEuclideanLin, EuclideanSpace.basisFun_apply, Matrix.mulVec,
    dotProduct, Matrix.mul_apply, Pi.single_apply, mul_comm]

noncomputable def realSymmetricPart {d : ℕ} (C : Matrix (Fin d) (Fin d) ℝ) :
    Matrix (Fin d) (Fin d) ℝ := (1 / 2 : ℝ) • (C + C.transpose)

noncomputable def realSkewPart {d : ℕ} (C : Matrix (Fin d) (Fin d) ℝ) :
    Matrix (Fin d) (Fin d) ℝ := (1 / 2 : ℝ) • (C - C.transpose)

noncomputable def effectiveReturnQuadratic {d k : ℕ} (C : Matrix (Fin d) (Fin d) ℝ)
    (Λ : Matrix (Fin k) (Fin k) ℝ) (V F S : Matrix (Fin d) (Fin k) ℝ) :
    Matrix (Fin k) (Fin k) ℝ :=
  Λ + (1 / 2 : ℝ) • (V.transpose * realSymmetricPart C * V) +
    realSymmetricPart (F.transpose * realSkewPart C * S)

/-- The exact quadratic identity in blueprint lem:return-splitting. -/
theorem effectiveReturnQuadratic_identity {d k : ℕ}
    (C : Matrix (Fin d) (Fin d) ℝ) (Λ : Matrix (Fin k) (Fin k) ℝ)
    (V F S : Matrix (Fin d) (Fin k) ℝ) (hV : V = F + S)
    (hiso : F.transpose * (C - C.transpose) * F = 0) :
    2 • Λ + V.transpose * C * V - V.transpose * (C - C.transpose) * F =
      2 • effectiveReturnQuadratic C Λ V F S +
        (1 / 2 : ℝ) • (S.transpose * (C - C.transpose) * S) := by
  have hf : F.transpose * (C * F) = F.transpose * (C.transpose * F) := by
    simpa only [Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_assoc, sub_eq_zero] using hiso
  simp only [effectiveReturnQuadratic, realSymmetricPart, realSkewPart, hV,
    Matrix.transpose_add, Matrix.transpose_mul, Matrix.transpose_sub,
    Matrix.transpose_smul, Matrix.transpose_transpose, Matrix.add_mul, Matrix.mul_add,
    Matrix.sub_mul, Matrix.mul_sub, Matrix.smul_mul, Matrix.mul_smul,
    Matrix.mul_assoc]
  rw [hf]
  module

theorem realMatrixOperator_basis_apply {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ)
    (j : Fin n) :
    realMatrixOperator A (EuclideanSpace.basisFun (Fin n) ℝ j) =
      WithLp.toLp 2 (A.col j) := by
  ext i
  simp [realMatrixOperator, Matrix.toEuclideanLin, EuclideanSpace.basisFun_apply,
    Matrix.mulVec, dotProduct, Pi.single_apply]

theorem realMatrix_abs_entry_le_norm {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (i j) :
    |A i j| ≤ ‖realMatrixOperator A‖ := by
  have he := realMatrixOperator_basis_apply A j
  have hh := PiLp.norm_apply_le (realMatrixOperator A (EuclideanSpace.basisFun (Fin n) ℝ j)) i
  rw [he] at hh
  have hn := (realMatrixOperator A).le_opNorm (EuclideanSpace.basisFun (Fin n) ℝ j)
  simp only [he] at hn
  have hb : ‖EuclideanSpace.basisFun (Fin n) ℝ j‖ = 1 := by
    simp [EuclideanSpace.basisFun_apply]
  rw [hb, mul_one] at hn
  exact hh.trans hn

theorem realMatrix_transpose_norm_le {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) :
    ‖realMatrixOperator A.transpose‖ ≤ (n : ℝ) * m * ‖realMatrixOperator A‖ := by
  exact realMatrixOperator_norm_le _ (norm_nonneg _) (fun i j => realMatrix_abs_entry_le_norm A j i)

theorem realMatrix_norm_le_from_scaled_columns {k : ℕ}
    (A : Matrix (Fin k) (Fin k) ℝ) {s R : ℝ} (hs : 0 < s) (hR : 0 ≤ R)
    (hcol : ∀ j, ∃ t : ℝ, s ≤ t ∧
      ‖realMatrixOperator A (t • EuclideanSpace.basisFun (Fin k) ℝ j)‖ ≤ R) :
    ‖realMatrixOperator A‖ ≤ (k : ℝ) * k * (R / s) := by
  apply realMatrixOperator_norm_le _ (div_nonneg hR hs.le)
  intro i j
  obtain ⟨t, hst, ht⟩ := hcol j
  have htp : 0 < t := hs.trans_le hst
  have hc := PiLp.norm_apply_le
    (realMatrixOperator A (t • EuclideanSpace.basisFun (Fin k) ℝ j)) i
  have he : (realMatrixOperator A (t • EuclideanSpace.basisFun (Fin k) ℝ j)) i =
      t * A i j := by
    rw [map_smul, realMatrixOperator_basis_apply]
    rfl
  rw [he, Real.norm_eq_abs, abs_mul, abs_of_pos htp] at hc
  apply (le_div_iff₀ hs).mpr
  have hm := mul_le_mul_of_nonneg_right hst (abs_nonneg (A i j))
  nlinarith only [hm, hc, ht]

theorem effectiveReturnQuadratic_frequency {d k : ℕ}
    (C : Matrix (Fin d) (Fin d) ℝ) (Λ : Matrix (Fin k) (Fin k) ℝ)
    (V F S : Matrix (Fin d) (Fin k) ℝ) (hV : V = F + S)
    (hiso : F.transpose * (C - C.transpose) * F = 0)
    (h : Fin k → ℝ) (m : Fin d → ℝ)
    (hdelta : (F.transpose * (C - C.transpose)).mulVec (m - F.mulVec h) = 0) :
    quadraticReturnFrequency C V Λ h m =
      2 • (effectiveReturnQuadratic C Λ V F S).mulVec h +
        (1 / 2 : ℝ) • (S.transpose * (C - C.transpose) * S).mulVec h -
        (S.transpose * (C - C.transpose)).mulVec (m - F.mulVec h) := by
  have he : quadraticReturnFrequency C V Λ h m =
      (2 • Λ + V.transpose * C * V - V.transpose * (C - C.transpose) * F).mulVec h -
        (V.transpose * (C - C.transpose)).mulVec (m - F.mulVec h) := by
    simp only [quadraticReturnFrequency, Matrix.sub_mulVec, Matrix.mulVec_sub,
      ← Matrix.mulVec_mulVec]
    abel
  have hc : (V.transpose * (C - C.transpose)).mulVec (m - F.mulVec h) =
      (S.transpose * (C - C.transpose)).mulVec (m - F.mulVec h) := by
    rw [hV, Matrix.transpose_add, Matrix.add_mul, Matrix.add_mulVec, hdelta, zero_add]
  rw [he, effectiveReturnQuadratic_identity C Λ V F S hV hiso, hc]
  simp [Matrix.add_mulVec, Matrix.smul_mulVec, two_smul]

theorem isotropic_subspace_transpose_kills {d k : ℕ}
    (A : Matrix (Fin d) (Fin d) ℝ) (F : Matrix (Fin d) (Fin k) ℝ)
    (U : Submodule ℝ (EuclideanSpace ℝ (Fin d)))
    (hF : ∀ x, realMatrixOperator F x ∈ U)
    (hiso : ∀ x ∈ U, ∀ y ∈ U, inner ℝ y (realMatrixOperator A x) = 0)
    {z : EuclideanSpace ℝ (Fin d)} (hz : z ∈ U) :
    realMatrixOperator (F.transpose * A) z = 0 := by
  ext j
  have hh := hiso z hz (realMatrixOperator F (EuclideanSpace.basisFun (Fin k) ℝ j))
    (hF _)
  rw [realMatrixOperator_transpose_inner, EuclideanSpace.basisFun_inner] at hh
  rw [realMatrixOperator_mul_apply]
  exact hh

theorem isotropic_subspace_matrix_zero {d k : ℕ}
    (A : Matrix (Fin d) (Fin d) ℝ) (F : Matrix (Fin d) (Fin k) ℝ)
    (U : Submodule ℝ (EuclideanSpace ℝ (Fin d)))
    (hF : ∀ x, realMatrixOperator F x ∈ U)
    (hiso : ∀ x ∈ U, ∀ y ∈ U, inner ℝ y (realMatrixOperator A x) = 0) :
    F.transpose * A * F = 0 := by
  ext i j
  have hh := isotropic_subspace_transpose_kills A F U hF hiso
    (hF (EuclideanSpace.basisFun (Fin k) ℝ j))
  rw [← realMatrixOperator_mul_apply, realMatrixOperator_basis_apply] at hh
  exact congrArg (fun x : EuclideanSpace ℝ (Fin k) => x i) hh

theorem effectiveReturnQuadratic_frequency_euclidean {d k : ℕ}
    (C : Matrix (Fin d) (Fin d) ℝ) (Λ : Matrix (Fin k) (Fin k) ℝ)
    (V F S : Matrix (Fin d) (Fin k) ℝ) (hV : V = F + S)
    (hiso : F.transpose * (C - C.transpose) * F = 0)
    (h : Fin k → ℝ) (m : Fin d → ℝ)
    (hdelta : (F.transpose * (C - C.transpose)).mulVec (m - F.mulVec h) = 0) :
    WithLp.toLp 2 (quadraticReturnFrequency C V Λ h m) =
      (2 : ℝ) • realMatrixOperator (effectiveReturnQuadratic C Λ V F S) (WithLp.toLp 2 h) +
        (1 / 2 : ℝ) • realMatrixOperator S.transpose
          (realMatrixOperator (C - C.transpose) (realMatrixOperator S (WithLp.toLp 2 h))) -
        realMatrixOperator S.transpose
          (realMatrixOperator (C - C.transpose) (WithLp.toLp 2 (m - F.mulVec h))) := by
  apply WithLp.ofLp_injective
  have hh := effectiveReturnQuadratic_frequency C Λ V F S hV hiso h m hdelta
  simp only [two_smul, WithLp.ofLp_add, WithLp.ofLp_sub, WithLp.ofLp_smul,
    realMatrixOperator_apply]
  simpa only [two_smul, ← Matrix.mulVec_mulVec] using hh

theorem effectiveReturnQuadratic_apply_bound {d k : ℕ}
    (C : Matrix (Fin d) (Fin d) ℝ) (Λ : Matrix (Fin k) (Fin k) ℝ)
    (V F S : Matrix (Fin d) (Fin k) ℝ) (hV : V = F + S)
    (hiso : F.transpose * (C - C.transpose) * F = 0)
    (h : Fin k → ℝ) (m : Fin d → ℝ)
    (hdelta : (F.transpose * (C - C.transpose)).mulVec (m - F.mulVec h) = 0)
    {a B N M : ℝ} (hS : ‖realMatrixOperator S‖ ≤ B)
    (hA : ‖realMatrixOperator (C - C.transpose)‖ ≤ N)
    (hh : ‖WithLp.toLp 2 h‖ ≤ a)
    (hd : ‖WithLp.toLp 2 (m - F.mulVec h)‖ ≤ a)
    (hΩ : ‖WithLp.toLp 2 (quadraticReturnFrequency C V Λ h m)‖ ≤ M) :
    ‖realMatrixOperator (effectiveReturnQuadratic C Λ V F S) (WithLp.toLp 2 h)‖ ≤
      M + ((k : ℝ) * d * B) * (N * (B * a)) + ((k : ℝ) * d * B) * (N * a) := by
  let z := realMatrixOperator (effectiveReturnQuadratic C Λ V F S) (WithLp.toLp 2 h)
  let u := realMatrixOperator S.transpose
    (realMatrixOperator (C - C.transpose) (realMatrixOperator S (WithLp.toLp 2 h)))
  let w := realMatrixOperator S.transpose
    (realMatrixOperator (C - C.transpose) (WithLp.toLp 2 (m - F.mulVec h)))
  have ht : ‖realMatrixOperator S.transpose‖ ≤ (k : ℝ) * d * B :=
    (realMatrix_transpose_norm_le S).trans
      (mul_le_mul_of_nonneg_left hS (by positivity))
  have hu : ‖u‖ ≤ ((k : ℝ) * d * B) * (N * (B * a)) :=
    (realMatrixOperator S.transpose).le_of_opNorm_le_of_le ht
      ((realMatrixOperator (C - C.transpose)).le_of_opNorm_le_of_le hA
        ((realMatrixOperator S).le_of_opNorm_le_of_le hS hh))
  have hw : ‖w‖ ≤ ((k : ℝ) * d * B) * (N * a) :=
    (realMatrixOperator S.transpose).le_of_opNorm_le_of_le ht
      ((realMatrixOperator (C - C.transpose)).le_of_opNorm_le_of_le hA hd)
  have he : (2 : ℝ) • z =
      WithLp.toLp 2 (quadraticReturnFrequency C V Λ h m) - (1 / 2 : ℝ) • u + w := by
    rw [effectiveReturnQuadratic_frequency_euclidean C Λ V F S hV hiso h m hdelta]
    dsimp [z, u, w]
    abel
  have hhalf : ‖(1 / 2 : ℝ) • u‖ ≤ ‖u‖ := by
    rw [norm_smul]
    exact mul_le_of_le_one_left (norm_nonneg _) (by norm_num)
  calc
    ‖z‖ ≤ ‖(2 : ℝ) • z‖ := by
      rw [norm_smul]
      norm_num
      linarith only [norm_nonneg z]
    _ = ‖WithLp.toLp 2 (quadraticReturnFrequency C V Λ h m) - (1 / 2 : ℝ) • u + w‖ :=
      congrArg norm he
    _ ≤ ‖WithLp.toLp 2 (quadraticReturnFrequency C V Λ h m)‖ +
        ‖(1 / 2 : ℝ) • u‖ + ‖w‖ :=
      (norm_add_le _ _).trans (add_le_add (norm_sub_le _ _) le_rfl)
    _ ≤ _ := add_le_add (add_le_add hΩ (hhalf.trans hu)) hw

/-- The effective quadratic form is bounded from coordinate returns in an
isotropic subspace, using only the slow velocity and the return errors. -/
theorem effectiveReturnQuadratic_norm_of_coordinate_returns {d k : ℕ}
    (C : Matrix (Fin d) (Fin d) ℝ) (Λ : Matrix (Fin k) (Fin k) ℝ)
    (V F S : Matrix (Fin d) (Fin k) ℝ) (hV : V = F + S)
    (U : Submodule ℝ (EuclideanSpace ℝ (Fin d)))
    (hproj : ∀ x, realMatrixOperator F x = U.starProjection (realMatrixOperator V x))
    (hiso : ∀ x ∈ U, ∀ y ∈ U,
      inner ℝ y (realMatrixOperator (C - C.transpose) x) = 0)
    {a B N M s : ℝ} (ha : 0 ≤ a) (hM : 0 ≤ M) (hs : 0 < s)
    (hS : ‖realMatrixOperator S‖ ≤ B)
    (hA : ‖realMatrixOperator (C - C.transpose)‖ ≤ N)
    (hreturn : ∀ j : Fin k, ∃ (t : ℝ) (m : EuclideanSpace ℝ (Fin d)),
      s ≤ t ∧ m ∈ U ∧
      ‖t • EuclideanSpace.basisFun (Fin k) ℝ j‖ +
        ‖realMatrixOperator V (t • EuclideanSpace.basisFun (Fin k) ℝ j) - m‖ ≤ a ∧
      ‖WithLp.toLp 2 (quadraticReturnFrequency C V Λ
        (t • EuclideanSpace.basisFun (Fin k) ℝ j).ofLp m.ofLp)‖ ≤ M) :
    ‖realMatrixOperator (effectiveReturnQuadratic C Λ V F S)‖ ≤
      (k : ℝ) * k *
        ((M + ((k : ℝ) * d * B) * (N * (B * a)) +
          ((k : ℝ) * d * B) * (N * a)) / s) := by
  have hF : ∀ x, realMatrixOperator F x ∈ U := by
    intro x
    rw [hproj]
    exact U.starProjection_apply_mem _
  have hmat := isotropic_subspace_matrix_zero (C - C.transpose) F U hF hiso
  have hB : 0 ≤ B := (norm_nonneg _).trans hS
  have hN : 0 ≤ N := (norm_nonneg _).trans hA
  apply realMatrix_norm_le_from_scaled_columns _ hs (by positivity)
  intro j
  obtain ⟨t, m, hst, hm, hsize, hΩ⟩ := hreturn j
  let h := t • EuclideanSpace.basisFun (Fin k) ℝ j
  have hh : ‖h‖ ≤ a := by
    have hn := norm_nonneg (realMatrixOperator V h - m)
    linarith only [hsize, hn]
  have hd : ‖realMatrixOperator V h - m‖ ≤ a := by
    linarith only [hsize, norm_nonneg h]
  have hdm : m - realMatrixOperator F h ∈ U := U.sub_mem hm (hF h)
  have hz := isotropic_subspace_transpose_kills (C - C.transpose) F U hF hiso hdm
  have hdelta : (F.transpose * (C - C.transpose)).mulVec
      (m.ofLp - F.mulVec h.ofLp) = 0 :=
    congrArg WithLp.ofLp hz
  have he : m - realMatrixOperator F h =
      -U.starProjection (realMatrixOperator V h - m) := by
    rw [map_sub, hproj, U.starProjection_eq_self_iff.mpr hm]
    abel
  have hdn : ‖WithLp.toLp 2 (m.ofLp - F.mulVec h.ofLp)‖ ≤ a := by
    change ‖m - realMatrixOperator F h‖ ≤ a
    rw [he, norm_neg]
    exact (U.norm_starProjection_apply_le _).trans hd
  refine ⟨t, hst, ?_⟩
  exact effectiveReturnQuadratic_apply_bound C Λ V F S hV hmat h.ofLp m.ofLp
    hdelta hS hA hh hdn hΩ

end Auto


/-!
# Rademacher–Menshov estimates and nested projection products

This file was automatically generated by Codex.

The finite Rademacher–Menshov argument decomposes variable prefixes into
dyadic blocks and combines orthogonal block energy with the triangle inequality.
We develop its Hilbert-space row formulation, for finite families of bounded
linear maps whose squared output norms sum to at most the squared input norm.
The intended applications are noncommuting products of nested orthogonal
projections and their disjoint-interval jumps, as in blueprint `lem:prefix`.
All statements and local definitions are independent of the column construction.

The classical logarithmic maximal inequality is recorded in Terence Tao,
*247A Lecture Notes 2*, page 31, exercises Q14–Q15:
<https://www.math.ucla.edu/~tao/247a.1.06f/notes2.pdf>.
The exact row/product formulation and constants follow
`blueprint/formalization_blueprint.tex`, lines 508–535.
The explicit logarithmic horizon and numerical restart bounds implement
`lem:compression`, lines 567 and 579, for arbitrary real budgets and layer counts.
-/

@[expose] public section

section

namespace Auto
open scoped BigOperators

/-- The Hilbertian norm of a finite family of outputs, also for normed outputs. -/
noncomputable def finiteRowNorm {ι F : Type*} [Fintype ι] [NormedAddCommGroup F]
    (f : ι → F) : ℝ := ‖WithLp.toLp 2 f‖

theorem finiteRowNorm_nonneg {ι F : Type*} [Fintype ι] [NormedAddCommGroup F]
    (f : ι → F) : 0 ≤ finiteRowNorm f := norm_nonneg _

theorem finiteRowNorm_sq {ι F : Type*} [Fintype ι] [NormedAddCommGroup F]
    (f : ι → F) : finiteRowNorm f ^ 2 = ∑ i, ‖f i‖ ^ 2 :=
  PiLp.norm_sq_eq_of_L2 _ _

theorem finiteRowNorm_add_le {ι F : Type*} [Fintype ι] [NormedAddCommGroup F]
    (f g : ι → F) : finiteRowNorm (f + g) ≤ finiteRowNorm f + finiteRowNorm g :=
  norm_add_le (WithLp.toLp 2 f) (WithLp.toLp 2 g)

/-- Removing rows preserves their square-sum contraction estimate. -/
theorem rowSquareBound_restrict {𝕜 H F ι : Type*} [RCLike 𝕜]
    [NormedAddCommGroup H] [NormedSpace 𝕜 H]
    [NormedAddCommGroup F] [NormedSpace 𝕜 F] [Fintype ι]
    (B : ι → H →L[𝕜] F) (C : ℝ)
    (hB : ∀ h, ∑ i, ‖B i h‖ ^ 2 ≤ C ^ 2 * ‖h‖ ^ 2)
    (p : ι → Prop) [DecidablePred p] :
    ∀ h, ∑ i, ‖(if p i then B i else 0) h‖ ^ 2 ≤ C ^ 2 * ‖h‖ ^ 2 := by
  intro h
  apply le_trans (Finset.sum_le_sum (fun i _ => ?_)) (hB h)
  by_cases hi : p i
  · simp only [ite_eq_left hi]
    exact le_rfl
  · simp only [ite_eq_right hi, zero_apply, norm_zero, zero_pow
      (by norm_num : (2 : ℕ) ≠ 0)]
    exact sq_nonneg _

/-- Finite Pythagoras for the orthogonal vectors used in dyadic blocks. -/
theorem orthogonalBlock_energy {𝕜 H ι : Type*} [RCLike 𝕜]
    [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]
    (s : Finset ι) (v : ι → H)
    (hv : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → inner 𝕜 (v i) (v j) = 0) :
    ‖∑ i ∈ s, v i‖ ^ 2 = ∑ i ∈ s, ‖v i‖ ^ 2 := by
  classical
  have he : inner 𝕜 (∑ i ∈ s, v i) (∑ i ∈ s, v i) =
      ∑ i ∈ s, inner 𝕜 (v i) (v i) := by
    rw [sum_inner]
    apply Finset.sum_congr rfl
    intro i hi
    rw [inner_sum]
    exact Finset.sum_eq_single i (fun j hj hji => hv i hi j hj hji.symm)
      (fun h => (h hi).elim)
  have h := congrArg RCLike.re he
  simpa only [map_sum, inner_self_eq_norm_sq] using h

theorem finiteRowNorm_le_of_sq_le {ι F : Type*} [Fintype ι] [NormedAddCommGroup F]
    (f : ι → F) {C : ℝ} (hC : 0 ≤ C) (h : ∑ i, ‖f i‖ ^ 2 ≤ C ^ 2) :
    finiteRowNorm f ≤ C := by
  apply (sq_le_sq₀ (finiteRowNorm_nonneg f) hC).mp
  rwa [finiteRowNorm_sq]

theorem finiteRowNorm_disjoint_sq {ι F : Type*} [Fintype ι] [NormedAddCommGroup F]
    (f g : ι → F) (h : ∀ i, f i = 0 ∨ g i = 0) :
    finiteRowNorm (f + g) ^ 2 = finiteRowNorm f ^ 2 + finiteRowNorm g ^ 2 := by
  simp only [finiteRowNorm_sq, ← Finset.sum_add_distrib, Pi.add_apply]
  apply Finset.sum_congr rfl
  intro i _
  rcases h i with hi | hi <;> simp [hi]

/-- The two half-prefixes occupy disjoint rows; completing the left half costs
one additional unit of the dyadic logarithmic bound. -/
theorem finiteRowNorm_binary_step {ι F : Type*} [Fintype ι] [NormedAddCommGroup F]
    (f g w : ι → F) {C E₀ E₁ : ℝ} (hC : 0 ≤ C) (hE₀ : 0 ≤ E₀) (hE₁ : 0 ≤ E₁)
    (hd : ∀ i, f i = 0 ∨ g i = 0)
    (hf : finiteRowNorm f ≤ C * Real.sqrt E₀)
    (hg : finiteRowNorm g ≤ C * Real.sqrt E₁)
    (hw : finiteRowNorm w ≤ Real.sqrt E₀) :
    finiteRowNorm (f + g + w) ≤ (C + 1) * Real.sqrt (E₀ + E₁) := by
  have hf' := (sq_le_sq₀ (finiteRowNorm_nonneg f)
    (mul_nonneg hC (Real.sqrt_nonneg _))).mpr hf
  have hg' := (sq_le_sq₀ (finiteRowNorm_nonneg g)
    (mul_nonneg hC (Real.sqrt_nonneg _))).mpr hg
  rw [mul_pow, Real.sq_sqrt hE₀] at hf'
  rw [mul_pow, Real.sq_sqrt hE₁] at hg'
  have hfg : finiteRowNorm (f + g) ≤ C * Real.sqrt (E₀ + E₁) := by
    apply (sq_le_sq₀ (finiteRowNorm_nonneg _)
      (mul_nonneg hC (Real.sqrt_nonneg _))).mp
    rw [finiteRowNorm_disjoint_sq f g hd, mul_pow, Real.sq_sqrt (add_nonneg hE₀ hE₁)]
    nlinarith only [hf', hg']
  calc
    _ ≤ finiteRowNorm (f + g) + finiteRowNorm w := finiteRowNorm_add_le _ _
    _ ≤ C * Real.sqrt (E₀ + E₁) + Real.sqrt E₀ := add_le_add hfg hw
    _ ≤ C * Real.sqrt (E₀ + E₁) + Real.sqrt (E₀ + E₁) := by
      gcongr
      exact le_add_of_nonneg_right hE₁
    _ = _ := by ring

/-- Binary splitting is the recursive form of one dyadic block at each length. -/
theorem prefix_binary_split {H : Type*} [AddCommMonoid H] (v : ℕ → H) (M n : ℕ) :
    (∑ j ∈ Finset.range n, v j) =
      (if n ≤ M then ∑ j ∈ Finset.range n, v j
        else ∑ j ∈ Finset.range (n - M), v (M + j)) +
      (if n ≤ M then 0 else ∑ j ∈ Finset.range M, v j) := by
  by_cases hn : n ≤ M
  · simp [hn]
  · simp only [ite_eq_right hn]
    have he := Finset.sum_range_add v M (n - M)
    rw [Nat.add_sub_of_le (Nat.le_of_not_ge hn)] at he
    exact he.trans (add_comm _ _)

/-- The finite row version of Rademacher–Menshov for a power-of-two horizon.
The binary induction implements the dyadic decomposition in `lem:prefix`. -/
theorem prefixRowBound_pow_two {𝕜 H F ι : Type*} [RCLike 𝕜]
    [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]
    [NormedAddCommGroup F] [NormedSpace 𝕜 F] [Fintype ι]
    (k : ℕ) (v : ℕ → H)
    (hv : ∀ i < 2 ^ k, ∀ j < 2 ^ k, i ≠ j → inner 𝕜 (v i) (v j) = 0)
    (B : ι → H →L[𝕜] F) (hB : ∀ h, ∑ i, ‖B i h‖ ^ 2 ≤ ‖h‖ ^ 2)
    (n : ι → ℕ) (hn : ∀ i, n i ≤ 2 ^ k) :
    finiteRowNorm (fun i => B i (∑ j ∈ Finset.range (n i), v j)) ≤
      ((k : ℝ) + 1) * Real.sqrt (∑ j ∈ Finset.range (2 ^ k), ‖v j‖ ^ 2) := by
  classical
  induction k generalizing v B n with
  | zero =>
    have hs : ∑ i, ‖B i (∑ j ∈ Finset.range (n i), v j)‖ ^ 2 ≤ ‖v 0‖ ^ 2 := by
      apply le_trans (Finset.sum_le_sum (fun i _ => ?_)) (hB (v 0))
      have hni := hn i
      simp only [pow_zero] at hni
      by_cases hi : n i = 0
      · simp [hi]
      · have hi' : n i = 1 := by omega
        simp [hi']
    have h := finiteRowNorm_le_of_sq_le _ (norm_nonneg (v 0)) hs
    simpa only [Nat.cast_zero, zero_add, one_mul, pow_zero, Finset.sum_range_one,
      Real.sqrt_sq (norm_nonneg _)] using h
  | succ k ih =>
    let M := 2 ^ k
    let E₀ := ∑ j ∈ Finset.range M, ‖v j‖ ^ 2
    let E₁ := ∑ j ∈ Finset.range M, ‖v (M + j)‖ ^ 2
    let B₀ : ι → H →L[𝕜] F := fun i => if n i ≤ M then B i else 0
    let B₁ : ι → H →L[𝕜] F := fun i => if n i ≤ M then 0 else B i
    let f : ι → F := fun i => B₀ i (∑ j ∈ Finset.range (min (n i) M), v j)
    let g : ι → F := fun i => B₁ i (∑ j ∈ Finset.range (n i - M), v (M + j))
    let w : ι → F := fun i => B₁ i (∑ j ∈ Finset.range M, v j)
    have hpow : 2 ^ (k + 1) = M + M := by dsimp [M]; rw [pow_succ]; omega
    have hv₀ : ∀ i < M, ∀ j < M, i ≠ j → inner 𝕜 (v i) (v j) = 0 := by
      intro i hi j hj hij
      apply hv i (by rw [hpow]; omega) j (by rw [hpow]; omega) hij
    have hv₁ : ∀ i < M, ∀ j < M, i ≠ j →
        inner 𝕜 (v (M + i)) (v (M + j)) = 0 := by
      intro i hi j hj hij
      apply hv (M + i) (by rw [hpow]; omega) (M + j) (by rw [hpow]; omega)
      omega
    have hB₀ : ∀ h, ∑ i, ‖B₀ i h‖ ^ 2 ≤ ‖h‖ ^ 2 := by
      simpa only [one_pow, one_mul, B₀] using
        rowSquareBound_restrict B 1 (by simpa only [one_pow, one_mul] using hB)
          (fun i => n i ≤ M)
    have hB₁ : ∀ h, ∑ i, ‖B₁ i h‖ ^ 2 ≤ ‖h‖ ^ 2 := by
      simpa only [one_pow, one_mul, ite_not, B₁] using
        rowSquareBound_restrict B 1 (by simpa only [one_pow, one_mul] using hB)
          (fun i => ¬ n i ≤ M)
    have hf : finiteRowNorm f ≤ ((k : ℝ) + 1) * Real.sqrt E₀ :=
      ih v hv₀ B₀ hB₀ (fun i => min (n i) M) (fun i => Nat.min_le_right _ _)
    have hg : finiteRowNorm g ≤ ((k : ℝ) + 1) * Real.sqrt E₁ := by
      apply ih (fun j => v (M + j)) hv₁ B₁ hB₁ (fun i => n i - M)
      intro i
      have hni := hn i
      rw [hpow] at hni
      change n i - M ≤ M
      omega
    have hE₀ : 0 ≤ E₀ := Finset.sum_nonneg (fun _ _ => sq_nonneg _)
    have hE₁ : 0 ≤ E₁ := Finset.sum_nonneg (fun _ _ => sq_nonneg _)
    have hw : finiteRowNorm w ≤ Real.sqrt E₀ := by
      apply finiteRowNorm_le_of_sq_le _ (Real.sqrt_nonneg _)
      rw [Real.sq_sqrt hE₀]
      exact (hB₁ (∑ j ∈ Finset.range M, v j)).trans_eq
        (orthogonalBlock_energy (Finset.range M) v
          (fun i hi j hj hij => hv₀ i (Finset.mem_range.mp hi) j (Finset.mem_range.mp hj) hij))
    have hd : ∀ i, f i = 0 ∨ g i = 0 := by
      intro i
      by_cases hi : n i ≤ M <;> simp [f, g, B₀, B₁, hi]
    have he : (fun i => B i (∑ j ∈ Finset.range (n i), v j)) = f + g + w := by
      funext i
      by_cases hi : n i ≤ M
      · simp [f, g, w, B₀, B₁, hi]
      · have hs := prefix_binary_split v M (n i)
        simp only [ite_eq_right hi] at hs
        simp only [Pi.add_apply, f, g, w, B₀, B₁, ite_eq_right hi, zero_apply, zero_add]
        rw [hs, map_add]
    have hE : (∑ j ∈ Finset.range (2 ^ (k + 1)), ‖v j‖ ^ 2) = E₀ + E₁ := by
      rw [hpow, Finset.sum_range_add]
    rw [he]
    have h := finiteRowNorm_binary_step f g w (by positivity : 0 ≤ (k : ℝ) + 1)
      hE₀ hE₁ hd hf hg hw
    simpa only [Nat.cast_add, Nat.cast_one, hE] using h

/-- Arbitrary finite prefixes have the exact dyadic logarithmic row bound.
Zero-padding to the next power of two leaves every relevant vector and energy unchanged. -/
theorem prefixRowBound {𝕜 H F ι : Type*} [RCLike 𝕜]
    [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]
    [NormedAddCommGroup F] [NormedSpace 𝕜 F] [Fintype ι]
    (N : ℕ) (v : ℕ → H)
    (hv : ∀ i < N, ∀ j < N, i ≠ j → inner 𝕜 (v i) (v j) = 0)
    (B : ι → H →L[𝕜] F) (hB : ∀ h, ∑ i, ‖B i h‖ ^ 2 ≤ ‖h‖ ^ 2)
    (n : ι → ℕ) (hn : ∀ i, n i ≤ N) :
    finiteRowNorm (fun i => B i (∑ j ∈ Finset.range (n i), v j)) ≤
      ((Nat.clog 2 N : ℝ) + 1) * Real.sqrt (∑ j ∈ Finset.range N, ‖v j‖ ^ 2) := by
  classical
  let u : ℕ → H := fun j => if j < N then v j else 0
  have hN := Nat.le_pow_clog (by norm_num : 1 < 2) N
  have hu : ∀ i < 2 ^ Nat.clog 2 N, ∀ j < 2 ^ Nat.clog 2 N,
      i ≠ j → inner 𝕜 (u i) (u j) = 0 := by
    intro i _ j _ hij
    by_cases hi : i < N
    · by_cases hj : j < N
      · simpa only [u, ite_eq_left hi, ite_eq_left hj] using hv i hi j hj hij
      · simp [u, hj]
    · simp [u, hi]
  have h := prefixRowBound_pow_two (Nat.clog 2 N) u hu B hB n
    (fun i => (hn i).trans hN)
  have he : (∑ j ∈ Finset.range (2 ^ Nat.clog 2 N), ‖u j‖ ^ 2) =
      ∑ j ∈ Finset.range N, ‖v j‖ ^ 2 := by
    calc
      _ = ∑ j ∈ Finset.range N, ‖u j‖ ^ 2 := by
        symm
        apply Finset.sum_subset (Finset.range_mono hN)
        intro j _ hj
        have hj' : ¬ j < N := by simpa only [Finset.mem_range] using hj
        simp [u, hj']
      _ = _ := Finset.sum_congr rfl (fun j hj => by
        simp [u, Finset.mem_range.mp hj])
  have hp : ∀ i, (∑ j ∈ Finset.range (n i), u j) = ∑ j ∈ Finset.range (n i), v j := by
    intro i
    apply Finset.sum_congr rfl
    intro j hj
    simp [u, lt_of_lt_of_le (Finset.mem_range.mp hj) (hn i)]
  simpa only [he, hp] using h

/-- Exact identification of the dyadic depth with the ceiling logarithm
used for `L_T` in blueprint `lem:prefix`. -/
theorem prefixRowLog_eq_ceil (N : ℕ) :
    (Nat.clog 2 N : ℝ) + 1 = (⌈Real.logb 2 N⌉₊ : ℝ) + 1 := by
  rw [show Real.logb 2 N = Real.logb (2 : ℕ) N by norm_num,
    Real.natCeil_logb_natCast]

section NestedProjections
variable {𝕜 H : Type*} [RCLike 𝕜] [NormedAddCommGroup H]
  [InnerProductSpace 𝕜 H] [CompleteSpace H]

theorem nestedProjection_comp_reverse (P Q : H →L[𝕜] H)
    (hP : IsStarProjection P) (hQ : IsStarProjection Q) (hPQ : P.comp Q = P) :
    Q.comp P = P := by
  change P * Q = P at hPQ
  change Q * P = P
  have h := congrArg star hPQ
  simpa only [star_mul, hP.isSelfAdjoint.star_eq, hQ.isSelfAdjoint.star_eq] using h

theorem starProjection_norm_apply_le (P : H →L[𝕜] H) (hP : IsStarProjection P) (g : H) :
    ‖P g‖ ≤ ‖g‖ := by
  calc
    _ ≤ ‖P‖ * ‖g‖ := P.le_opNorm g
    _ ≤ 1 * ‖g‖ := mul_le_mul_of_nonneg_right (IsStarProjection.norm_le P hP) (norm_nonneg g)
    _ = _ := one_mul _

/-- The initial projection followed by successive projection differences. -/
noncomputable def projectionIncrement (P : ℕ → H →L[𝕜] H) : ℕ → H →L[𝕜] H
  | 0 => P 0
  | n + 1 => P (n + 1) - P n

omit [CompleteSpace H] in
theorem sum_projectionIncrement (P : ℕ → H →L[𝕜] H) (n : ℕ) :
    (∑ j ∈ Finset.range (n + 1), projectionIncrement P j) = P n := by
  induction n with
  | zero => simp [projectionIncrement]
  | succ n ih =>
    rw [Finset.sum_range_succ, ih, projectionIncrement]
    abel

omit [CompleteSpace H] in
theorem sum_projectionIncrement_apply (P : ℕ → H →L[𝕜] H) (n : ℕ) (g : H) :
    (∑ j ∈ Finset.range (n + 1), projectionIncrement P j g) = P n g := by
  rw [← sum_apply, sum_projectionIncrement]

theorem projectionIncrement_fixed (P : ℕ → H →L[𝕜] H) (T : ℕ)
    (hP : ∀ n ≤ T, IsStarProjection (P n))
    (hnest : ∀ i ≤ T, ∀ j ≤ T, i ≤ j → (P i).comp (P j) = P i)
    {n m : ℕ} (hnm : n ≤ m) (hm : m ≤ T) :
    (P m).comp (projectionIncrement P n) = projectionIncrement P n := by
  cases n with
  | zero =>
    exact nestedProjection_comp_reverse (P 0) (P m) (hP 0 (by omega)) (hP m hm)
      (hnest 0 (by omega) m hm (by omega))
  | succ n =>
    simp only [projectionIncrement, ContinuousLinearMap.comp_sub]
    rw [nestedProjection_comp_reverse (P (n + 1)) (P m)
      (hP (n + 1) (by omega)) (hP m hm) (hnest (n + 1) (by omega) m hm hnm),
      nestedProjection_comp_reverse (P n) (P m)
        (hP n (by omega)) (hP m hm) (hnest n (by omega) m hm (by omega))]

theorem projectionIncrement_inner_eq_zero_of_lt (P : ℕ → H →L[𝕜] H) (T : ℕ)
    (hP : ∀ n ≤ T, IsStarProjection (P n))
    (hnest : ∀ i ≤ T, ∀ j ≤ T, i ≤ j → (P i).comp (P j) = P i)
    {i j : ℕ} (hij : i < j) (hj : j ≤ T) (g h : H) :
    inner 𝕜 (projectionIncrement P i g) (projectionIncrement P j h) = 0 := by
  obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : j ≠ 0)
  have hfix₁ := congrArg (fun L : H →L[𝕜] H => L g)
    (projectionIncrement_fixed P T hP hnest (by omega : i ≤ j + 1) hj)
  have hfix₀ := congrArg (fun L : H →L[𝕜] H => L g)
    (projectionIncrement_fixed P T hP hnest (by omega : i ≤ j) (by omega : j ≤ T))
  change P (j + 1) (projectionIncrement P i g) = projectionIncrement P i g at hfix₁
  change P j (projectionIncrement P i g) = projectionIncrement P i g at hfix₀
  simp only [projectionIncrement, sub_apply, inner_sub_right]
  have hs₁ : inner 𝕜 (P (j + 1) (projectionIncrement P i g)) h =
      inner 𝕜 (projectionIncrement P i g) (P (j + 1) h) :=
    (hP (j + 1) hj).isSelfAdjoint.isSymmetric _ _
  have hs₀ : inner 𝕜 (P j (projectionIncrement P i g)) h =
      inner 𝕜 (projectionIncrement P i g) (P j h) :=
    (hP j (by omega)).isSelfAdjoint.isSymmetric _ _
  change inner 𝕜 (projectionIncrement P i g) (P (j + 1) h) -
    inner 𝕜 (projectionIncrement P i g) (P j h) = 0
  rw [← hs₁, ← hs₀, hfix₁, hfix₀, sub_self]

theorem projectionIncrement_orthogonal (P : ℕ → H →L[𝕜] H) (T : ℕ)
    (hP : ∀ n ≤ T, IsStarProjection (P n))
    (hnest : ∀ i ≤ T, ∀ j ≤ T, i ≤ j → (P i).comp (P j) = P i)
    (g : H) : ∀ i < T + 1, ∀ j < T + 1, i ≠ j →
      inner 𝕜 (projectionIncrement P i g) (projectionIncrement P j g) = 0 := by
  intro i hi j hj hij
  rcases lt_or_gt_of_ne hij with hij | hji
  · exact projectionIncrement_inner_eq_zero_of_lt P T hP hnest hij (by omega) g g
  · apply inner_eq_zero_symm.mp
    exact projectionIncrement_inner_eq_zero_of_lt P T hP hnest hji (by omega) g g

theorem projectionIncrement_energy_le (P : ℕ → H →L[𝕜] H) (T : ℕ)
    (hP : ∀ n ≤ T, IsStarProjection (P n))
    (hnest : ∀ i ≤ T, ∀ j ≤ T, i ≤ j → (P i).comp (P j) = P i) (g : H) :
    ∑ j ∈ Finset.range (T + 1), ‖projectionIncrement P j g‖ ^ 2 ≤ ‖g‖ ^ 2 := by
  calc
    _ = ‖∑ j ∈ Finset.range (T + 1), projectionIncrement P j g‖ ^ 2 :=
      (orthogonalBlock_energy _ _ (fun i hi j hj hij =>
        projectionIncrement_orthogonal P T hP hnest g i (Finset.mem_range.mp hi)
          j (Finset.mem_range.mp hj) hij)).symm
    _ = ‖P T g‖ ^ 2 := by rw [sum_projectionIncrement_apply]
    _ ≤ _ := (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mpr
      (starProjection_norm_apply_le (P T) (hP T le_rfl) g)

/-- The exact constant `L_T = 1 + ceil(log₂(T+1))` in the source. -/
noncomputable def projectionPrefixConstant (T : ℕ) : ℝ := (Nat.clog 2 (T + 1) : ℝ) + 1

theorem projectionPrefixConstant_one_le (T : ℕ) : 1 ≤ projectionPrefixConstant T := by
  unfold projectionPrefixConstant
  have h := Nat.cast_nonneg (α := ℝ) (Nat.clog 2 (T + 1))
  linarith

theorem projectionPrefixConstant_eq_ceil (T : ℕ) :
    projectionPrefixConstant T = 1 + (⌈Real.logb 2 (T + 1)⌉₊ : ℝ) := by
  rw [projectionPrefixConstant, prefixRowLog_eq_ceil]
  push_cast
  ring

/-- The single-layer nested-projection row estimate with arbitrary row times,
the first case of blueprint `eq:prefix`, lines 508–514. -/
theorem nestedProjection_prefix_rows {F ι : Type*} [NormedAddCommGroup F]
    [NormedSpace 𝕜 F] [Fintype ι] (P : ℕ → H →L[𝕜] H) (T : ℕ)
    (hP : ∀ n ≤ T, IsStarProjection (P n))
    (hnest : ∀ i ≤ T, ∀ j ≤ T, i ≤ j → (P i).comp (P j) = P i)
    (B : ι → H →L[𝕜] F) (hB : ∀ h, ∑ i, ‖B i h‖ ^ 2 ≤ ‖h‖ ^ 2)
    (n : ι → ℕ) (hn : ∀ i, n i ≤ T) (g : H) :
    finiteRowNorm (fun i => B i (P (n i) g)) ≤ projectionPrefixConstant T * ‖g‖ := by
  have h := prefixRowBound (T + 1) (fun j => projectionIncrement P j g)
    (projectionIncrement_orthogonal P T hP hnest g) B hB (fun i => n i + 1)
      (fun i => Nat.add_le_add_right (hn i) 1)
  simp only [sum_projectionIncrement_apply] at h
  apply h.trans
  have he : Real.sqrt (∑ j ∈ Finset.range (T + 1), ‖projectionIncrement P j g‖ ^ 2) ≤ ‖g‖ := by
    calc
      _ ≤ Real.sqrt (‖g‖ ^ 2) := Real.sqrt_le_sqrt (projectionIncrement_energy_le P T hP hnest g)
      _ = _ := Real.sqrt_sq (norm_nonneg g)
  exact mul_le_mul_of_nonneg_left he (by positivity)

theorem finiteRowNorm_smul {F ι : Type*} [NormedAddCommGroup F] [NormedSpace 𝕜 F]
    [Fintype ι] (c : 𝕜) (f : ι → F) :
    finiteRowNorm (fun i => c • f i) = ‖c‖ * finiteRowNorm f :=
  norm_smul c (WithLp.toLp 2 f)

/-- Products are ordered with layer zero on the right; different layers need not commute. -/
noncomputable def nestedProjectionProduct (P : ℕ → ℕ → H →L[𝕜] H) : ℕ → ℕ → H →L[𝕜] H
  | 0, _ => ContinuousLinearMap.id 𝕜 H
  | m + 1, n => (P m n).comp (nestedProjectionProduct P m n)

/-- Blueprint `eq:prefix`: the logarithmic row estimate for arbitrary
noncommuting products of nested orthogonal projection layers. -/
theorem nestedProjectionProduct_prefix_rows {F ι : Type*} [NormedAddCommGroup F]
    [NormedSpace 𝕜 F] [Fintype ι] (P : ℕ → ℕ → H →L[𝕜] H) (T m : ℕ)
    (hP : ∀ l < m, ∀ n ≤ T, IsStarProjection (P l n))
    (hnest : ∀ l < m, ∀ i ≤ T, ∀ j ≤ T, i ≤ j → (P l i).comp (P l j) = P l i)
    (B : ι → H →L[𝕜] F) (hB : ∀ h, ∑ i, ‖B i h‖ ^ 2 ≤ ‖h‖ ^ 2)
    (n : ι → ℕ) (hn : ∀ i, n i ≤ T) (g : H) :
    finiteRowNorm (fun i => B i (nestedProjectionProduct P m (n i) g)) ≤
      projectionPrefixConstant T ^ m * ‖g‖ := by
  induction m generalizing B with
  | zero =>
    simpa only [nestedProjectionProduct, ContinuousLinearMap.id_apply, pow_zero, one_mul]
      using finiteRowNorm_le_of_sq_le (fun i => B i g) (norm_nonneg g) (hB g)
  | succ m ih =>
    let L := projectionPrefixConstant T
    have hL : 0 < L := lt_of_lt_of_le zero_lt_one (projectionPrefixConstant_one_le T)
    let B' : ι → H →L[𝕜] F := fun i => ((L⁻¹ : ℝ) : 𝕜) • (B i).comp (P m (n i))
    have hnorm : ∀ h, finiteRowNorm (fun i => B' i h) ≤ ‖h‖ := by
      intro h
      have hb := nestedProjection_prefix_rows (P m) T (hP m (by omega))
        (hnest m (by omega)) B hB n hn h
      calc
        _ = L⁻¹ * finiteRowNorm (fun i => B i (P m (n i) h)) := by
          change finiteRowNorm (fun i => ((L⁻¹ : ℝ) : 𝕜) • B i (P m (n i) h)) = _
          rw [finiteRowNorm_smul, RCLike.norm_ofReal, abs_of_pos (inv_pos.mpr hL)]
        _ ≤ L⁻¹ * (L * ‖h‖) := mul_le_mul_of_nonneg_left hb (inv_nonneg.mpr hL.le)
        _ = _ := by rw [← mul_assoc, inv_mul_cancel₀ hL.ne', one_mul]
    have hB' : ∀ h, ∑ i, ‖B' i h‖ ^ 2 ≤ ‖h‖ ^ 2 := by
      intro h
      rw [← finiteRowNorm_sq]
      exact (sq_le_sq₀ (finiteRowNorm_nonneg _) (norm_nonneg _)).mpr (hnorm h)
    have hb := ih (fun l hl => hP l (by omega)) (fun l hl => hnest l (by omega)) B' hB'
    change finiteRowNorm (fun i => ((L⁻¹ : ℝ) : 𝕜) •
      B i (nestedProjectionProduct P (m + 1) (n i) g)) ≤ L ^ m * ‖g‖ at hb
    rw [finiteRowNorm_smul, RCLike.norm_ofReal, abs_of_pos (inv_pos.mpr hL)] at hb
    have hh := mul_le_mul_of_nonneg_left hb hL.le
    rw [← mul_assoc, mul_inv_cancel₀ hL.ne', one_mul] at hh
    calc
      _ ≤ L * (L ^ m * ‖g‖) := hh
      _ = L ^ (m + 1) * ‖g‖ := by rw [pow_succ]; ring

theorem nestedProjectionProduct_prefix_rows_sq {F ι : Type*} [NormedAddCommGroup F]
    [NormedSpace 𝕜 F] [Fintype ι] (P : ℕ → ℕ → H →L[𝕜] H) (T m : ℕ)
    (hP : ∀ l < m, ∀ n ≤ T, IsStarProjection (P l n))
    (hnest : ∀ l < m, ∀ i ≤ T, ∀ j ≤ T, i ≤ j → (P l i).comp (P l j) = P l i)
    (B : ι → H →L[𝕜] F) (hB : ∀ h, ∑ i, ‖B i h‖ ^ 2 ≤ ‖h‖ ^ 2)
    (n : ι → ℕ) (hn : ∀ i, n i ≤ T) (g : H) :
    ∑ i, ‖B i (nestedProjectionProduct P m (n i) g)‖ ^ 2 ≤
      projectionPrefixConstant T ^ (2 * m) * ‖g‖ ^ 2 := by
  have h := nestedProjectionProduct_prefix_rows P T m hP hnest B hB n hn g
  have hL : 0 ≤ projectionPrefixConstant T :=
    le_trans zero_le_one (projectionPrefixConstant_one_le T)
  have hh := (sq_le_sq₀ (finiteRowNorm_nonneg _)
    (mul_nonneg (pow_nonneg hL _) (norm_nonneg g))).mpr h
  simpa only [finiteRowNorm_sq, mul_pow, ← pow_mul, Nat.mul_comm m 2] using hh

theorem finiteRowNorm_mono {F ι : Type*} [NormedAddCommGroup F] [Fintype ι]
    (f g : ι → F) (h : ∀ i, ‖f i‖ ≤ ‖g i‖) : finiteRowNorm f ≤ finiteRowNorm g := by
  apply (sq_le_sq₀ (finiteRowNorm_nonneg _) (finiteRowNorm_nonneg _)).mp
  simp only [finiteRowNorm_sq]
  exact Finset.sum_le_sum (fun i _ =>
    (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mpr (h i))

omit [CompleteSpace H] in
theorem nestedProjectionProduct_jump_split (P : ℕ → ℕ → H →L[𝕜] H)
    (m r t : ℕ) (g : H) :
    nestedProjectionProduct P (m + 1) t g - nestedProjectionProduct P (m + 1) r g =
      P m t (nestedProjectionProduct P m t g - nestedProjectionProduct P m r g) +
        (P m t - P m r) (nestedProjectionProduct P m r g) := by
  simp only [nestedProjectionProduct, ContinuousLinearMap.comp_apply, map_sub, sub_apply]
  abel

/-- Product telescoping with Bessel difference rows. The dyadic prefix estimate
controls each right-hand product; left-hand factors are contractions. -/
theorem nestedProjectionProduct_jump_rows_of_bessel {ι : Type*} [Fintype ι]
    (P : ℕ → ℕ → H →L[𝕜] H) (T m : ℕ)
    (hP : ∀ l < m, ∀ n ≤ T, IsStarProjection (P l n))
    (hnest : ∀ l < m, ∀ i ≤ T, ∀ j ≤ T, i ≤ j → (P l i).comp (P l j) = P l i)
    (r t : ι → ℕ) (hr : ∀ i, r i ≤ T) (ht : ∀ i, t i ≤ T)
    (hB : ∀ l < m, ∀ h, ∑ i, ‖(P l (t i) - P l (r i)) h‖ ^ 2 ≤ ‖h‖ ^ 2)
    (g : H) :
    finiteRowNorm (fun i => nestedProjectionProduct P m (t i) g -
      nestedProjectionProduct P m (r i) g) ≤
        (∑ l ∈ Finset.range m, projectionPrefixConstant T ^ l) * ‖g‖ := by
  induction m with
  | zero =>
    simp [nestedProjectionProduct, finiteRowNorm]
    rfl
  | succ m ih =>
    have hi := ih (fun l hl => hP l (by omega))
      (fun l hl => hnest l (by omega)) (fun l hl => hB l (by omega))
    have hp := nestedProjectionProduct_prefix_rows P T m
      (fun l hl => hP l (by omega)) (fun l hl => hnest l (by omega))
      (fun i => P m (t i) - P m (r i)) (hB m (by omega)) r hr g
    have he : (fun i => nestedProjectionProduct P (m + 1) (t i) g -
        nestedProjectionProduct P (m + 1) (r i) g) =
        (fun i => P m (t i) (nestedProjectionProduct P m (t i) g -
          nestedProjectionProduct P m (r i) g)) +
        (fun i => (P m (t i) - P m (r i)) (nestedProjectionProduct P m (r i) g)) :=
      funext (fun i => nestedProjectionProduct_jump_split P m (r i) (t i) g)
    rw [he]
    calc
      _ ≤ finiteRowNorm (fun i => P m (t i) (nestedProjectionProduct P m (t i) g -
            nestedProjectionProduct P m (r i) g)) +
          finiteRowNorm (fun i => (P m (t i) - P m (r i))
            (nestedProjectionProduct P m (r i) g)) := finiteRowNorm_add_le _ _
      _ ≤ (∑ l ∈ Finset.range m, projectionPrefixConstant T ^ l) * ‖g‖ +
          projectionPrefixConstant T ^ m * ‖g‖ := by
        apply add_le_add _ hp
        apply le_trans (finiteRowNorm_mono _ _ (fun i =>
          starProjection_norm_apply_le (P m (t i)) (hP m (by omega) (t i) (ht i)) _)) hi
      _ = _ := by rw [Finset.sum_range_succ, add_mul]

theorem projectionPrefixConstant_sum_pow_le (T m : ℕ) :
    (∑ l ∈ Finset.range m, projectionPrefixConstant T ^ l) ≤
      (m : ℝ) * projectionPrefixConstant T ^ (m - 1) := by
  calc
    _ ≤ ∑ _l ∈ Finset.range m, projectionPrefixConstant T ^ (m - 1) := by
      apply Finset.sum_le_sum
      intro l hl
      exact pow_le_pow_right₀ (projectionPrefixConstant_one_le T)
        (by have := Finset.mem_range.mp hl; omega)
    _ = _ := by simp

/-- The exact square-sum jump constant once the layer differences are Bessel rows. -/
theorem nestedProjectionProduct_jump_rows_sq_of_bessel {ι : Type*} [Fintype ι]
    (P : ℕ → ℕ → H →L[𝕜] H) (T m : ℕ)
    (hP : ∀ l < m, ∀ n ≤ T, IsStarProjection (P l n))
    (hnest : ∀ l < m, ∀ i ≤ T, ∀ j ≤ T, i ≤ j → (P l i).comp (P l j) = P l i)
    (r t : ι → ℕ) (hr : ∀ i, r i ≤ T) (ht : ∀ i, t i ≤ T)
    (hB : ∀ l < m, ∀ h, ∑ i, ‖(P l (t i) - P l (r i)) h‖ ^ 2 ≤ ‖h‖ ^ 2)
    (g : H) :
    ∑ i, ‖nestedProjectionProduct P m (t i) g - nestedProjectionProduct P m (r i) g‖ ^ 2 ≤
      (m : ℝ) ^ 2 * projectionPrefixConstant T ^ (2 * (m - 1)) * ‖g‖ ^ 2 := by
  have h := (nestedProjectionProduct_jump_rows_of_bessel P T m hP hnest r t hr ht hB g).trans
    (mul_le_mul_of_nonneg_right (projectionPrefixConstant_sum_pow_le T m) (norm_nonneg g))
  have hL : 0 ≤ projectionPrefixConstant T :=
    le_trans zero_le_one (projectionPrefixConstant_one_le T)
  have hh := (sq_le_sq₀ (finiteRowNorm_nonneg _)
    (mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hL _)) (norm_nonneg g))).mpr h
  simpa only [finiteRowNorm_sq, mul_pow, ← pow_mul, Nat.mul_comm (m - 1) 2] using hh

/-- Successive differences of a nested orthogonal projection family are Bessel rows. -/
theorem projection_successive_differences_bessel (P : ℕ → H →L[𝕜] H) (T : ℕ)
    (hP : ∀ n ≤ T, IsStarProjection (P n))
    (hnest : ∀ i ≤ T, ∀ j ≤ T, i ≤ j → (P i).comp (P j) = P i) (h : H) :
    ∑ n : Fin T, ‖(P (n.val + 1) - P n.val) h‖ ^ 2 ≤ ‖h‖ ^ 2 := by
  rw [Fin.sum_univ_eq_sum_range (fun n => ‖(P (n + 1) - P n) h‖ ^ 2) T]
  have he := projectionIncrement_energy_le P T hP hnest h
  rw [Finset.sum_range_succ'] at he
  have hs : (∑ n ∈ Finset.range T, ‖projectionIncrement P (n + 1) h‖ ^ 2) ≤ ‖h‖ ^ 2 :=
    (le_add_of_nonneg_right (sq_nonneg ‖projectionIncrement P 0 h‖)).trans he
  simpa only [projectionIncrement] using hs

/-- Blueprint `eq:product-jump`, lines 515–519: the square sum of successive
product jumps is at most `m² L_T^(2(m-1))` times the input energy. -/
theorem nestedProjectionProduct_successive_jumps (P : ℕ → ℕ → H →L[𝕜] H) (T m : ℕ)
    (hP : ∀ l < m, ∀ n ≤ T, IsStarProjection (P l n))
    (hnest : ∀ l < m, ∀ i ≤ T, ∀ j ≤ T, i ≤ j → (P l i).comp (P l j) = P l i)
    (g : H) :
    ∑ n : Fin T, ‖nestedProjectionProduct P m (n.val + 1) g -
      nestedProjectionProduct P m n.val g‖ ^ 2 ≤
        (m : ℝ) ^ 2 * projectionPrefixConstant T ^ (2 * (m - 1)) * ‖g‖ ^ 2 := by
  apply nestedProjectionProduct_jump_rows_sq_of_bessel P T m hP hnest
    (fun n : Fin T => n.val) (fun n : Fin T => n.val + 1)
      (fun n => n.isLt.le) (fun n => Nat.succ_le_of_lt n.isLt)
  intro l hl h
  exact projection_successive_differences_bessel (P l) T (hP l hl) (hnest l hl) h

omit [CompleteSpace H] in
theorem orthogonalIndexedBlocks_energy_le {α ι : Type*} [Fintype ι]
    (s : Finset α) (v : α → H)
    (hv : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → inner 𝕜 (v i) (v j) = 0)
    (A : ι → Finset α) (hdis : ∀ i j, i ≠ j → Disjoint (A i) (A j))
    (hsub : ∀ i, A i ⊆ s) :
    ∑ i, ‖∑ j ∈ A i, v j‖ ^ 2 ≤ ∑ j ∈ s, ‖v j‖ ^ 2 := by
  classical
  calc
    _ = ∑ i, ∑ j ∈ A i, ‖v j‖ ^ 2 := by
      apply Finset.sum_congr rfl
      intro i _
      exact orthogonalBlock_energy (A i) v
        (fun j hj k hk hjk => hv j (hsub i hj) k (hsub i hk) hjk)
    _ = ∑ j ∈ Finset.univ.biUnion A, ‖v j‖ ^ 2 :=
      (Finset.sum_biUnion (fun i _ j _ hij => hdis i j hij)).symm
    _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg
      (by simp only [Finset.biUnion_subset]; exact fun i _ => hsub i)
      (fun _ _ _ => sq_nonneg _)

omit [CompleteSpace H] in
theorem sum_projectionIncrement_Ioc (P : ℕ → H →L[𝕜] H) {r t : ℕ}
    (hrt : r ≤ t) (g : H) :
    (∑ j ∈ Finset.Ioc r t, projectionIncrement P j g) = P t g - P r g := by
  rw [← Finset.Ico_add_one_add_one_eq_Ioc,
    Finset.sum_Ico_eq_sub _ (Nat.add_le_add_right hrt 1),
    sum_projectionIncrement_apply, sum_projectionIncrement_apply]

/-- Differences over disjoint index intervals are Bessel rows, including empty intervals. -/
theorem projection_interval_differences_bessel {ι : Type*} [Fintype ι]
    (P : ℕ → H →L[𝕜] H) (T : ℕ)
    (hP : ∀ n ≤ T, IsStarProjection (P n))
    (hnest : ∀ i ≤ T, ∀ j ≤ T, i ≤ j → (P i).comp (P j) = P i)
    (r t : ι → ℕ) (hrt : ∀ i, r i ≤ t i) (ht : ∀ i, t i ≤ T)
    (hdis : ∀ i j, i ≠ j → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r j) (t j)))
    (g : H) : ∑ i, ‖(P (t i) - P (r i)) g‖ ^ 2 ≤ ‖g‖ ^ 2 := by
  calc
    _ = ∑ i, ‖∑ j ∈ Finset.Ioc (r i) (t i), projectionIncrement P j g‖ ^ 2 := by
      apply Finset.sum_congr rfl
      intro i _
      rw [sum_projectionIncrement_Ioc P (hrt i), sub_apply]
    _ ≤ ∑ j ∈ Finset.range (T + 1), ‖projectionIncrement P j g‖ ^ 2 := by
      apply orthogonalIndexedBlocks_energy_le (Finset.range (T + 1))
        (fun j => projectionIncrement P j g)
        (fun i hi j hj hij => projectionIncrement_orthogonal P T hP hnest g
          i (Finset.mem_range.mp hi) j (Finset.mem_range.mp hj) hij)
        (fun i => Finset.Ioc (r i) (t i)) hdis
      intro i j hj
      have hj' := (Finset.mem_Ioc.mp hj).2
      exact Finset.mem_range.mpr (by have := ht i; omega)
    _ ≤ _ := projectionIncrement_energy_le P T hP hnest g

end NestedProjections

/-- A power-sized transition count has a logarithmic prefix constant,
with explicit allowance for both ceiling operations. -/
theorem projectionPrefixConstant_ceil_pow_le {b : ℝ} (hb : 2 ≤ b)
    {p : ℕ} (hp : 1 ≤ p) :
    projectionPrefixConstant (Nat.ceil (b ^ p)) ≤ (p : ℝ) * Real.logb 2 b + 3 := by
  have hb0 : 0 < b := by linarith
  have hb1 : 1 ≤ b := by linarith
  have hp2 : 2 ≤ b ^ p := hb.trans (by simpa using pow_le_pow_right₀ hb1 hp)
  have hceil := (Nat.ceil_lt_add_one (pow_nonneg hb0.le p)).le
  have hT : (Nat.ceil (b ^ p) : ℝ) + 1 ≤ 2 * b ^ p := by linarith
  have hlog := Real.logb_le_logb_of_le (by norm_num : (1 : ℝ) < 2)
    (by positivity : 0 < (Nat.ceil (b ^ p) : ℝ) + 1) hT
  rw [Real.logb_mul (by norm_num : (2 : ℝ) ≠ 0) (pow_ne_zero _ hb0.ne'),
    Real.logb_pow] at hlog
  norm_num at hlog
  have hlog0 : 0 ≤ Real.logb 2 ((Nat.ceil (b ^ p) : ℝ) + 1) :=
    Real.logb_nonneg (by norm_num) (by
      have := Nat.cast_nonneg (α := ℝ) (Nat.ceil (b ^ p))
      linarith)
  have hceilLog := (Nat.ceil_lt_add_one hlog0).le
  rw [projectionPrefixConstant_eq_ceil]
  linarith

/-- The source transition horizon for a real column budget and a natural
number of projection layers (`lem:compression`, lines 567 and 579). -/
noncomputable def projectionRestartTime (D : ℝ) (m : ℕ) : ℕ :=
  Nat.ceil ((2 * D * ((m : ℝ) + 1)) ^ (128 * (m + 1) ^ 2))

/-- The first explicit bound in the source's numerical contraction check. -/
theorem projectionRestartTime_prefix_le {D : ℝ} (hD : 2 ≤ D) {m : ℕ} (hm : 1 ≤ m) :
    projectionPrefixConstant (projectionRestartTime D m) ≤
      129 * ((m : ℝ) + 1) ^ 2 * Real.logb 2 (2 * D * ((m : ℝ) + 1)) := by
  have hmR : (1 : ℝ) ≤ m := by exact_mod_cast hm
  have hb : 2 ≤ 2 * D * ((m : ℝ) + 1) := by nlinarith
  have hlog1 : 1 ≤ Real.logb 2 (2 * D * ((m : ℝ) + 1)) := by
    have h := Real.logb_le_logb_of_le (by norm_num : (1 : ℝ) < 2)
      (by norm_num : (0 : ℝ) < 2) hb
    simpa using h
  have h := projectionPrefixConstant_ceil_pow_le hb
    (show 1 ≤ 128 * (m + 1) ^ 2 from Nat.succ_le_of_lt (by positivity))
  change projectionPrefixConstant (projectionRestartTime D m) ≤ _ at h
  norm_num only [Nat.cast_mul, Nat.cast_ofNat, Nat.cast_pow, Nat.cast_add, Nat.cast_one] at h
  have hrem := mul_nonneg (sq_nonneg ((m : ℝ) + 1)) (sub_nonneg.mpr hlog1)
  nlinarith

/-- A convenient elementary bound for binary logarithms above four. -/
theorem logb_two_le_half {b : ℝ} (hb : 4 ≤ b) : Real.logb 2 b ≤ b / 2 := by
  have hb0 : 0 < b := by linarith
  have hlog2 : (1 / 2 : ℝ) ≤ Real.log 2 := by
    have h := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
    norm_num at h
    exact h
  have hlog := Real.log_le_sub_one_of_pos (by positivity : 0 < b / 4)
  rw [Real.log_div hb0.ne' (by norm_num : (4 : ℝ) ≠ 0)] at hlog
  have hfour : Real.log (4 : ℝ) = 2 * Real.log 2 := by
    rw [show (4 : ℝ) = 2 ^ (2 : ℕ) by norm_num, Real.log_pow]
    norm_num
  rw [hfour] at hlog
  rw [Real.logb, div_le_iff₀ (Real.log_pos (by norm_num : (1 : ℝ) < 2))]
  have hprod := mul_nonneg (sub_nonneg.mpr hb) (sub_nonneg.mpr hlog2)
  nlinarith

/-- The source logarithmic prefix bound is dominated by the fourth power
of `b = 2 D (m+1)`, uniformly for every nonempty product. -/
theorem projectionRestartTime_prefix_le_fourth {D : ℝ} (hD : 2 ≤ D)
    {m : ℕ} (hm : 1 ≤ m) :
    projectionPrefixConstant (projectionRestartTime D m) ≤ (2 * D * ((m : ℝ) + 1)) ^ 4 := by
  let b := 2 * D * ((m : ℝ) + 1)
  have hmR : (1 : ℝ) ≤ m := by exact_mod_cast hm
  have hb8 : 8 ≤ b := by dsimp [b]; nlinarith
  have hb0 : 0 ≤ b := by linarith
  have hs : (m : ℝ) + 1 ≤ b / 4 := by dsimp [b]; nlinarith
  have hlog := logb_two_le_half (show 4 ≤ b by linarith)
  have hlog0 : 0 ≤ Real.logb 2 b := Real.logb_nonneg (by norm_num) (by linarith)
  calc
    _ ≤ 129 * ((m : ℝ) + 1) ^ 2 * Real.logb 2 b := projectionRestartTime_prefix_le hD hm
    _ ≤ 129 * (b / 4) ^ 2 * (b / 2) := by gcongr
    _ = (129 / 32 : ℝ) * b ^ 3 := by ring
    _ ≤ b * b ^ 3 := mul_le_mul_of_nonneg_right (by linarith) (pow_nonneg hb0 3)
    _ = _ := by ring

/-- Blueprint `lem:compression`, line 579: the prescribed transition
horizon makes the common restart contraction factor strictly less than one half. -/
theorem projectionRestartTime_factor_lt_half {D : ℝ} (hD : 2 ≤ D)
    {m : ℕ} (hm : 1 ≤ m) :
    16 * D ^ 32 * (m : ℝ) ^ 2 *
      projectionPrefixConstant (projectionRestartTime D m) ^ (2 * m) /
        (projectionRestartTime D m : ℝ) < 1 / 2 := by
  let b := 2 * D * ((m : ℝ) + 1)
  let p := 128 * (m + 1) ^ 2
  let r := 34 + 8 * m
  have hmR : (1 : ℝ) ≤ m := by exact_mod_cast hm
  have hb8 : 8 ≤ b := by dsimp [b]; nlinarith
  have hb0 : 0 < b := by linarith
  have hb1 : 1 ≤ b := by linarith
  have hDb : D ≤ b := by dsimp [b]; nlinarith
  have hmb : (m : ℝ) ≤ b := by dsimp [b]; nlinarith
  have hL := projectionRestartTime_prefix_le_fourth hD hm
  change projectionPrefixConstant (projectionRestartTime D m) ≤ b ^ 4 at hL
  have hL0 : 0 ≤ projectionPrefixConstant (projectionRestartTime D m) :=
    zero_le_one.trans (projectionPrefixConstant_one_le _)
  have hnum : 16 * D ^ 32 * (m : ℝ) ^ 2 *
      projectionPrefixConstant (projectionRestartTime D m) ^ (2 * m) ≤ 16 * b ^ r := by
    calc
      _ ≤ 16 * b ^ 32 * b ^ 2 * (b ^ 4) ^ (2 * m) := by gcongr
      _ = 16 * (b ^ 32 * b ^ 2 * b ^ (8 * m)) := by
        rw [← pow_mul, show 4 * (2 * m) = 8 * m by omega]
        ring
      _ = _ := by rw [← pow_add, ← pow_add]
  have hsq : m + 1 ≤ (m + 1) ^ 2 := by nlinarith
  have hrp : r + 2 ≤ p := by dsimp [r, p]; omega
  have hbig : 32 * b ^ r < (projectionRestartTime D m : ℝ) := by
    calc
      _ < b ^ 2 * b ^ r :=
        mul_lt_mul_of_pos_right (by nlinarith : (32 : ℝ) < b ^ 2) (pow_pos hb0 r)
      _ = b ^ (r + 2) := by rw [pow_add]; ring
      _ ≤ b ^ p := pow_le_pow_right₀ hb1 hrp
      _ ≤ _ := Nat.le_ceil (b ^ p)
  have hT : 0 < (projectionRestartTime D m : ℝ) := by
    have hn : 0 < projectionRestartTime D m := Nat.ceil_pos.mpr (pow_pos hb0 p)
    exact_mod_cast hn
  apply (div_lt_iff₀ hT).mpr
  nlinarith only [hnum, hbig]

/-- Blueprint `lem:compression`, line 597: the exact restart horizon has
prefix constant at most a cubic layer-count factor times `log (2D)`. -/
theorem projectionRestartTime_prefix_polynomial {D : ℝ} {m : ℕ}
    (hD : 2 ≤ D) (hm : 1 ≤ m) :
    projectionPrefixConstant (projectionRestartTime D m) ≤
      258 * ((m : ℝ) + 1) ^ 3 * Real.log (2 * D) := by
  let s := (m : ℝ) + 1
  have hs : 2 ≤ s := by dsimp [s]; exact_mod_cast Nat.add_le_add_right hm 1
  have hs0 : 0 < s := by linarith
  have hD0 : 0 < 2 * D := by linarith
  have hl2 : (1 / 2 : ℝ) ≤ Real.log 2 := by
    have h := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
    norm_num at h ⊢
    linarith
  have hl20 : 0 < Real.log 2 := by linarith
  have hl4 : 1 ≤ Real.log 4 := by
    have hpow : Real.log (4 : ℝ) = 2 * Real.log 2 := by
      rw [show (4 : ℝ) = 2 ^ (2 : ℕ) by norm_num, Real.log_pow]
      norm_num
    rw [hpow]
    linarith
  have hlD : 1 ≤ Real.log (2 * D) := hl4.trans
    (Real.log_le_log (by norm_num : (0 : ℝ) < 4) (by linarith))
  have hls := Real.log_le_sub_one_of_pos hs0
  have hmul := mul_le_mul_of_nonneg_left hlD (by linarith : 0 ≤ s - 1)
  have hlb : Real.log (2 * D * s) ≤ s * Real.log (2 * D) := by
    rw [Real.log_mul hD0.ne' hs0.ne']
    nlinarith
  have hbase : Real.logb 2 (2 * D * s) ≤ 2 * s * Real.log (2 * D) := by
    rw [Real.logb, div_le_iff₀ hl20]
    have hprod := mul_nonneg (mul_nonneg hs0.le (by linarith : 0 ≤ Real.log (2 * D)))
      (by linarith : 0 ≤ 2 * Real.log 2 - 1)
    nlinarith only [hlb, hprod]
  have hp := projectionRestartTime_prefix_le hD hm
  change projectionPrefixConstant (projectionRestartTime D m) ≤
    129 * s ^ 2 * Real.logb 2 (2 * D * s) at hp
  calc
    _ ≤ 129 * s ^ 2 * Real.logb 2 (2 * D * s) := hp
    _ ≤ 129 * s ^ 2 * (2 * s * Real.log (2 * D)) :=
      mul_le_mul_of_nonneg_left hbase (by positivity)
    _ = _ := by dsimp only [s]; ring

section OperatorComplements
variable {𝕜 H : Type*} [RCLike 𝕜] [NormedAddCommGroup H] [NormedSpace 𝕜 H]

/-- An ordered subproduct, omitting the factors selected as false. -/
noncomputable def operatorSubproduct (P : ℕ → H →L[𝕜] H) (σ : ℕ → Bool) : ℕ → H →L[𝕜] H
  | 0 => ContinuousLinearMap.id 𝕜 H
  | n + 1 => if σ n then (P n).comp (operatorSubproduct P σ n) else operatorSubproduct P σ n

/-- An ordered product with any designated factors replaced by their complements. -/
noncomputable def operatorComplementProduct (P : ℕ → H →L[𝕜] H)
    (θ : ℕ → Bool) : ℕ → H →L[𝕜] H
  | 0 => ContinuousLinearMap.id 𝕜 H
  | n + 1 => (if θ n then ContinuousLinearMap.id 𝕜 H - P n else P n).comp
      (operatorComplementProduct P θ n)

theorem operatorSubproduct_congr (P : ℕ → H →L[𝕜] H) (n : ℕ) {σ τ : ℕ → Bool}
    (h : ∀ j < n, σ j = τ j) : operatorSubproduct P σ n = operatorSubproduct P τ n := by
  induction n generalizing σ τ with
  | zero => rfl
  | succ n ih =>
    simp only [operatorSubproduct]
    rw [h n (by omega), ih (fun j hj => h j (by omega))]

theorem operatorSubproduct_update_prefix (P : ℕ → H →L[𝕜] H) (σ : ℕ → Bool)
    (n : ℕ) (b : Bool) : operatorSubproduct P (Function.update σ n b) n =
      operatorSubproduct P σ n := by
  apply operatorSubproduct_congr
  intro j hj
  simp [Function.update, ne_of_lt hj]

theorem operatorSubproduct_succ_update (P : ℕ → H →L[𝕜] H) (σ : ℕ → Bool)
    (n : ℕ) (b : Bool) : operatorSubproduct P (Function.update σ n b) (n + 1) =
      if b then (P n).comp (operatorSubproduct P σ n) else operatorSubproduct P σ n := by
  simp only [operatorSubproduct, Function.update_self, operatorSubproduct_update_prefix]

theorem finiteRowNorm_sub_le {ι F : Type*} [Fintype ι] [NormedAddCommGroup F]
    (f g : ι → F) : finiteRowNorm (f - g) ≤ finiteRowNorm f + finiteRowNorm g :=
  norm_sub_le (WithLp.toLp 2 f) (WithLp.toLp 2 g)

/-- Blueprint `lem:compression`, line 597: expanding complements costs
at most `2^m` in the finite row norm. Only a uniform bound for all ordered
subproducts is required; no commutation of the factors is assumed. -/
theorem operatorComplementProduct_rows_bound {ι F : Type*} [Fintype ι]
    [NormedAddCommGroup F] [NormedSpace 𝕜 F]
    (P : ι → ℕ → H →L[𝕜] H) (θ : ℕ → Bool) (m : ℕ) (z : H)
    (B : ι → H →L[𝕜] F) {M : ℝ} (hM : 0 ≤ M)
    (hsub : ∀ σ : ℕ → Bool,
      finiteRowNorm (fun i => B i (operatorSubproduct (P i) σ m z)) ≤ M) :
    finiteRowNorm (fun i => B i (operatorComplementProduct (P i) θ m z)) ≤ (2 : ℝ) ^ m * M := by
  induction m generalizing B with
  | zero =>
    simpa only [operatorComplementProduct, operatorSubproduct, pow_zero, one_mul]
      using hsub (fun _ => false)
  | succ m ih =>
    let B' := fun i => (B i).comp (P i m)
    have hsub0 (σ : ℕ → Bool) :
        finiteRowNorm (fun i => B i (operatorSubproduct (P i) σ m z)) ≤ M := by
      have h := hsub (Function.update σ m false)
      simpa only [operatorSubproduct_succ_update, Bool.false_eq_true, ↓reduceIte] using h
    have hsub1 (σ : ℕ → Bool) :
        finiteRowNorm (fun i => B' i (operatorSubproduct (P i) σ m z)) ≤ M := by
      have h := hsub (Function.update σ m true)
      simpa only [operatorSubproduct_succ_update, ↓reduceIte, B', ContinuousLinearMap.comp_apply]
        using h
    have h0 := ih B hsub0
    have h1 := ih B' hsub1
    cases hθ : θ m with
    | false =>
      have he : (fun i => B i (operatorComplementProduct (P i) θ (m + 1) z)) =
          (fun i => B' i (operatorComplementProduct (P i) θ m z)) := by
        funext i
        simp only [operatorComplementProduct, hθ, Bool.false_eq_true, ↓reduceIte,
          ContinuousLinearMap.comp_apply, B']
      rw [he]
      exact h1.trans (mul_le_mul_of_nonneg_right
        (pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) (by omega : m ≤ m + 1)) hM)
    | true =>
      have he : (fun i => B i (operatorComplementProduct (P i) θ (m + 1) z)) =
          (fun i => B i (operatorComplementProduct (P i) θ m z)) -
            (fun i => B' i (operatorComplementProduct (P i) θ m z)) := by
        funext i
        simp only [operatorComplementProduct, hθ, ↓reduceIte, ContinuousLinearMap.comp_apply,
          sub_apply, ContinuousLinearMap.id_apply, map_sub, Pi.sub_apply, B']
      rw [he]
      calc
        _ ≤ finiteRowNorm (fun i => B i (operatorComplementProduct (P i) θ m z)) +
            finiteRowNorm (fun i => B' i (operatorComplementProduct (P i) θ m z)) :=
          finiteRowNorm_sub_le _ _
        _ ≤ (2 : ℝ) ^ m * M + (2 : ℝ) ^ m * M := add_le_add h0 h1
        _ = _ := by rw [pow_succ]; ring

end OperatorComplements


/-!
# Minkowski's integral inequality

This file was automatically generated by Claude.

**Minkowski's integral inequality** states that the `L^p` norm of an integral is at most the
integral of the `L^p` norms: for `1 ≤ p`, a jointly measurable `f : α × β → [0, ∞]`, a σ-finite
measure `μ` on `α` and an s-finite measure `ν` on `β`,
`(∫ (∫ f(x, y) dν(y))^p dμ(x))^{1/p} ≤ ∫ (∫ f(x, y)^p dμ(x))^{1/p} dν(y)`.

The proof is the textbook duality argument: for a truncation `G ≤ F = ∫ f(·, y) dν` with finite
`∫ G^p`, write `∫ G^p ≤ ∫ G^{p-1} F`, exchange the integrals (Tonelli), apply Hölder's
inequality in `x` for each `y`, and divide by `(∫ G^p)^{1 - 1/p}`. The truncations
`G_n = min(F, n) 1_{S_n}` on the spanning sets of `μ` increase to `F`, and monotone convergence
concludes.

References: E. M. Stein, *Singular Integrals and Differentiability Properties of Functions*,
Princeton University Press, 1970, Appendix A.1; G. H. Hardy, J. E. Littlewood, G. Pólya,
*Inequalities*, Cambridge University Press, 2nd ed., 1952, Theorem 202.
The statement and all definitions depend only on Mathlib.
-/

@[expose] public section

namespace Auto

open MeasureTheory
open scoped ENNReal

theorem ennreal_rpow_sub_one_mul_self {p : ℝ} (hp : 1 < p) (x : ℝ≥0∞) :
    x ^ (p - 1) * x = x ^ p := by
  rcases eq_or_ne x 0 with rfl | h0
  · rw [ENNReal.zero_rpow_of_pos (by linarith), ENNReal.zero_rpow_of_pos (by linarith), zero_mul]
  rcases eq_or_ne x ⊤ with rfl | ht
  · rw [ENNReal.top_rpow_of_pos (by linarith), ENNReal.top_rpow_of_pos (by linarith),
      ENNReal.top_mul_top]
  conv_rhs => rw [show p = (p - 1) + 1 by ring, ENNReal.rpow_add _ _ h0 ht, ENNReal.rpow_one]

/-- The truncated duality step of Minkowski's integral inequality: for `G ≤ F = ∫ f(·, y) dν`
with finite `∫ G^p`, `(∫ G^p)^{1/p} ≤ ∫ (∫ f(·, y)^p)^{1/p} dν`. -/
theorem minkowski_truncated {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    {μ : Measure α} {ν : Measure β} [SFinite ν] [SFinite μ] {p : ℝ} (hp : 1 ≤ p)
    {f : α → β → ℝ≥0∞} (hf : Measurable (Function.uncurry f)) {G : α → ℝ≥0∞}
    (hG : Measurable G) (hGF : ∀ x, G x ≤ ∫⁻ y, f x y ∂ν) (hfin : ∫⁻ x, G x ^ p ∂μ ≠ ∞) :
    (∫⁻ x, G x ^ p ∂μ) ^ (1 / p) ≤ ∫⁻ y, (∫⁻ x, f x y ^ p ∂μ) ^ (1 / p) ∂ν := by
  have hp0 : 0 < p := by linarith
  set I := ∫⁻ x, G x ^ p ∂μ
  set R := ∫⁻ y, (∫⁻ x, f x y ^ p ∂μ) ^ (1 / p) ∂ν
  have hmx : ∀ x, Measurable fun y => f x y := fun x =>
    hf.comp (measurable_const.prodMk measurable_id)
  have hmy : ∀ y, Measurable fun x => f x y := fun y =>
    hf.comp (measurable_id.prodMk measurable_const)
  rcases eq_or_ne I 0 with h0 | h0
  · rw [h0, ENNReal.zero_rpow_of_pos (by positivity)]; exact bot_le
  rcases eq_or_lt_of_le hp with h1 | h1
  · -- `p = 1`: Tonelli
    subst h1
    simp only [ENNReal.rpow_one, div_one, I, R]
    calc ∫⁻ x, G x ∂μ ≤ ∫⁻ x, ∫⁻ y, f x y ∂ν ∂μ := lintegral_mono hGF
      _ = ∫⁻ y, ∫⁻ x, f x y ∂μ ∂ν := lintegral_lintegral_swap hf.aemeasurable
  -- `p > 1`: Hölder with the conjugate exponent `q = p / (p - 1)`
  set q : ℝ := p / (p - 1)
  have hpq : p.HolderConjugate q := Real.HolderConjugate.conjExponent h1
  have hq0 : 0 < q := hpq.symm.pos
  have hIq : I ^ (1 / q) ≠ ⊤ := ENNReal.rpow_ne_top_of_nonneg (by positivity) hfin
  have hIq0 : I ^ (1 / q) ≠ 0 :=
    (ENNReal.rpow_pos (pos_iff_ne_zero.mpr h0) hfin).ne'
  have key : I ≤ R * I ^ (1 / q) := by
    calc I = ∫⁻ x, G x ^ (p - 1) * G x ∂μ := by
          refine lintegral_congr fun x => ?_
          rw [ennreal_rpow_sub_one_mul_self h1]
      _ ≤ ∫⁻ x, G x ^ (p - 1) * ∫⁻ y, f x y ∂ν ∂μ := by gcongr with x; exact hGF x
      _ = ∫⁻ x, ∫⁻ y, G x ^ (p - 1) * f x y ∂ν ∂μ := by
          refine lintegral_congr fun x => ?_
          rw [lintegral_const_mul _ (hmx x)]
      _ = ∫⁻ y, ∫⁻ x, f x y * G x ^ (p - 1) ∂μ ∂ν := by
          rw [lintegral_lintegral_swap]
          · simp_rw [mul_comm]
          · exact (((hG.pow_const _).comp measurable_fst).mul hf).aemeasurable
      _ ≤ ∫⁻ y, (∫⁻ x, f x y ^ p ∂μ) ^ (1 / p) *
            (∫⁻ x, (G x ^ (p - 1)) ^ q ∂μ) ^ (1 / q) ∂ν := by
          gcongr with y
          exact ENNReal.lintegral_mul_le_Lp_mul_Lq μ hpq (hmy y).aemeasurable
            (hG.pow_const _).aemeasurable
      _ = R * I ^ (1 / q) := by
          rw [lintegral_mul_const' _ _ ?_]
          · congr 2
            refine lintegral_congr fun x => ?_
            rw [← ENNReal.rpow_mul]
            congr 1
            simp only [q]
            field_simp
          · have : ∫⁻ x, (G x ^ (p - 1)) ^ q ∂μ = I := by
              refine lintegral_congr fun x => ?_
              rw [← ENNReal.rpow_mul]; congr 1; simp only [q]; field_simp
            rw [this]; exact hIq
  have hexp : 1 / p + 1 / q = 1 := by rw [one_div, one_div]; exact hpq.inv_add_inv_eq_one
  have hsplit : I ^ (1 / p) * I ^ (1 / q) = I := by
    rw [← ENNReal.rpow_add _ _ h0 hfin, hexp, ENNReal.rpow_one]
  exact (ENNReal.mul_le_mul_iff_left hIq0 hIq).mp (hsplit.trans_le key)

/-- **Minkowski's integral inequality** for nonnegative functions: for `1 ≤ p`, a jointly
measurable `f : α × β → [0, ∞]`, a σ-finite measure `μ` and an s-finite measure `ν`,
`(∫ (∫ f(x, y) dν(y))^p dμ(x))^{1/p} ≤ ∫ (∫ f(x, y)^p dμ(x))^{1/p} dν(y)`. -/
theorem lintegral_minkowski {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    {μ : Measure α} {ν : Measure β} [SFinite ν] [SigmaFinite μ] {p : ℝ} (hp : 1 ≤ p)
    {f : α → β → ℝ≥0∞} (hf : Measurable (Function.uncurry f)) :
    (∫⁻ x, (∫⁻ y, f x y ∂ν) ^ p ∂μ) ^ (1 / p) ≤ ∫⁻ y, (∫⁻ x, f x y ^ p ∂μ) ^ (1 / p) ∂ν := by
  have hp0 : 0 < p := by linarith
  set F : α → ℝ≥0∞ := fun x => ∫⁻ y, f x y ∂ν
  have hF : Measurable F := hf.lintegral_prod_right'
  -- truncations `G_n = min(F, n) 1_{S_n}` on the spanning sets
  set G : ℕ → α → ℝ≥0∞ := fun n => (spanningSets μ n).indicator fun x => min (F x) n
  have hGm : ∀ n, Measurable (G n) := fun n =>
    (hF.min measurable_const).indicator (measurableSet_spanningSets μ n)
  have hGF : ∀ n x, G n x ≤ F x := fun n x => by
    by_cases hx : x ∈ spanningSets μ n
    · simp only [G, Set.indicator_of_mem hx]; exact min_le_left _ _
    · simp only [G, Set.indicator_of_notMem hx]; exact bot_le
  have hGfin : ∀ n, ∫⁻ x, G n x ^ p ∂μ ≠ ∞ := by
    intro n
    refine ne_top_of_le_ne_top (b := (n : ℝ≥0∞) ^ p * μ (spanningSets μ n)) ?_ ?_
    · exact ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg hp0.le (by simp))
        (measure_spanningSets_lt_top μ n).ne
    · calc ∫⁻ x, G n x ^ p ∂μ ≤ ∫⁻ x, (spanningSets μ n).indicator
            (fun _ => (n : ℝ≥0∞) ^ p) x ∂μ := by
            refine lintegral_mono fun x => ?_
            by_cases hx : x ∈ spanningSets μ n
            · simp only [G, Set.indicator_of_mem hx]
              exact ENNReal.rpow_le_rpow (min_le_right _ _) hp0.le
            · simp only [G, Set.indicator_of_notMem hx, ENNReal.zero_rpow_of_pos hp0, le_refl]
        _ = (n : ℝ≥0∞) ^ p * μ (spanningSets μ n) := by
            rw [lintegral_indicator (measurableSet_spanningSets μ n), setLIntegral_const]
  have hmono : Monotone fun n x => G n x ^ p := by
    intro m n hmn x
    apply ENNReal.rpow_le_rpow _ hp0.le
    by_cases hm : x ∈ spanningSets μ m
    · have hn : x ∈ spanningSets μ n := monotone_spanningSets μ hmn hm
      simp only [G, Set.indicator_of_mem hm, Set.indicator_of_mem hn]
      exact min_le_min le_rfl (by exact_mod_cast hmn)
    · simp only [G, Set.indicator_of_notMem hm]; exact bot_le
  have hsup : ∀ x, ⨆ n, G n x ^ p = F x ^ p := by
    intro x
    apply le_antisymm (iSup_le fun n => ENNReal.rpow_le_rpow (hGF n x) hp0.le)
    obtain ⟨k, hk⟩ := (iUnion_spanningSets μ).symm ▸ Set.mem_univ x |> Set.mem_iUnion.mp
    have hlim : Filter.Tendsto (fun n : ℕ => G n x ^ p) Filter.atTop (nhds (F x ^ p)) := by
      have h1 : Filter.Tendsto (fun n : ℕ => min (F x) (n : ℝ≥0∞)) Filter.atTop (nhds (F x)) := by
        rcases eq_or_ne (F x) ⊤ with htop | htop
        · rw [htop]; simp only [min_eq_right le_top]
          exact ENNReal.tendsto_nat_nhds_top
        · apply tendsto_const_nhds.congr'
          obtain ⟨N, hN⟩ := ENNReal.exists_nat_gt htop
          filter_upwards [Filter.eventually_ge_atTop N] with n hn
          exact (min_eq_left (hN.le.trans (by exact_mod_cast hn))).symm
      have h2 : ∀ᶠ n : ℕ in Filter.atTop, G n x = min (F x) n := by
        filter_upwards [Filter.eventually_ge_atTop k] with n hn
        simp only [G, Set.indicator_of_mem (monotone_spanningSets μ hn hk)]
      exact ((ENNReal.continuous_rpow_const.tendsto _).comp (h1.congr' (h2.mono
        fun n h => h.symm)))
    exact le_of_tendsto' hlim fun n => le_iSup (fun n => G n x ^ p) n
  have hlimI : ∫⁻ x, F x ^ p ∂μ = ⨆ n, ∫⁻ x, G n x ^ p ∂μ := by
    rw [← lintegral_iSup (fun n => (hGm n).pow_const p) hmono]
    simp_rw [hsup]
  rw [hlimI, one_div, ENNReal.rpow_inv_le_iff hp0]
  refine iSup_le fun n => ?_
  rw [← ENNReal.rpow_inv_le_iff hp0, ← one_div]
  exact minkowski_truncated hp hf (hGm n) (hGF n) (hGfin n)

end Auto

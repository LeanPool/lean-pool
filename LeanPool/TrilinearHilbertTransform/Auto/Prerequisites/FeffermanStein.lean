end Auto.ClassicalMaximal

namespace Auto.ClassicalMaximal

open MeasureTheory Metric Set Filter Topology
open scoped ENNReal NNReal
noncomputable section

section Prelim

variable {n : ℕ}

lemma fs_hfin (x : EuclideanSpace ℝ (Fin n)) (r : ℝ) : volume (closedBall x r) ≠ ∞ :=
  measure_closedBall_lt_top.ne

/-- Scaling of the volume of Euclidean balls. -/
lemma fs_volume_closedBall_mul (x : EuclideanSpace ℝ (Fin n)) {c r : ℝ} (hc : 0 ≤ c)
    (hr : 0 ≤ r) :
    volume (closedBall x (c * r)) = ENNReal.ofReal (c ^ n) * volume (closedBall x r) := by
  rw [Measure.addHaar_closedBall _ _ (mul_nonneg hc hr), Measure.addHaar_closedBall _ _ hr,
    finrank_euclideanSpace_fin, mul_pow, ENNReal.ofReal_mul (pow_nonneg hc _), mul_assoc]

lemma fs_doubling (x : EuclideanSpace ℝ (Fin n)) (r : ℝ) (hr : 0 ≤ r) :
    volume (closedBall x (3 * r)) ≤ ((3 ^ n : ℝ≥0) : ℝ≥0∞) * volume (closedBall x r) := by
  rw [fs_volume_closedBall_mul x (by norm_num) hr]
  apply le_of_eq
  congr 1
  rw [ENNReal.ofReal_pow (by norm_num)]
  simp

lemma fs_measurable_maximal {E : Type*} [NormedAddCommGroup E]
    {f : EuclideanSpace ℝ (Fin n) → E} (hf : AEStronglyMeasurable f volume) :
    Measurable (hlMaximal volume f) :=
  measurable_hlMaximal fs_hfin hf

/-- The constant of the Hardy–Littlewood maximal theorem in integral form. -/
def fsK (n : ℕ) (q : ℝ) : ℝ≥0∞ :=
  ENNReal.ofReal (2 ^ q * q * ((3 ^ n : ℝ≥0) : ℝ) / (q - 1))

lemma fsK_ne_top (n : ℕ) (q : ℝ) : fsK n q ≠ ∞ := ENNReal.ofReal_ne_top

/-- The Hardy–Littlewood maximal theorem on `ℝⁿ` in integral form:
`∫ (M f)^q ≤ K ∫ ‖f‖^q` for `1 < q < ∞`. -/
theorem fs_lintegral_maximal_rpow_le {E : Type*} [NormedAddCommGroup E] {q : ℝ} (hq : 1 < q)
    {f : EuclideanSpace ℝ (Fin n) → E} (hf : AEStronglyMeasurable f volume) :
    ∫⁻ x, hlMaximal volume f x ^ q ≤ fsK n q * ∫⁻ x, ‖f x‖ₑ ^ q :=
  lintegral_hlMaximal_rpow_le_of_weak hq
    (fun _ hg t => hlMaximal_weak_one fs_hfin fs_doubling hg t) hf
    (fs_measurable_maximal hf).aemeasurable

end Prelim

section Weighted

variable {n : ℕ} {E : Type*} [NormedAddCommGroup E]

lemma fs_volume_closedBall_eq (x y : EuclideanSpace ℝ (Fin n)) {r : ℝ} (hr : 0 ≤ r) :
    volume (closedBall x r) = volume (closedBall y r) := by
  rw [Measure.addHaar_closedBall _ x hr, Measure.addHaar_closedBall _ y hr]

/-- The ball estimate behind the weighted weak type bound: if the average of `‖f‖` over
`B = B(c,r)` exceeds `τ`, then `w(3B) ≤ 4ⁿ τ⁻¹ ∫_B ‖f‖ M w`. -/
lemma fs_withDensity_closedBall_le {w : EuclideanSpace ℝ (Fin n) → ℝ}
    {f : EuclideanSpace ℝ (Fin n) → E} {c : EuclideanSpace ℝ (Fin n)} {r : ℝ} (hr : 0 < r)
    {τ : ℝ≥0∞} (hτ0 : τ ≠ 0) (hτ : τ < hlBallAverage volume f c r) :
    volume.withDensity (fun x => ‖w x‖ₑ) (closedBall c (3 * r)) ≤
      4 ^ n / τ * ∫⁻ y in closedBall c r, hlMaximal volume w y * ‖f y‖ₑ := by
  set m := volume (closedBall c r)
  have hm0 : m ≠ 0 := (measure_closedBall_pos volume c hr).ne'
  have hmt : m ≠ ∞ := fs_hfin c r
  have hτt : τ ≠ ∞ := ne_top_of_lt hτ
  set I := ∫⁻ y in closedBall c r, ‖f y‖ₑ
  set J := ∫⁻ y in closedBall c r, hlMaximal volume w y * ‖f y‖ₑ
  set ν3 := volume.withDensity (fun x => ‖w x‖ₑ) (closedBall c (3 * r))
  have hν3 : ν3 = ∫⁻ z in closedBall c (3 * r), ‖w z‖ₑ :=
    withDensity_apply _ measurableSet_closedBall
  have hy : ∀ y ∈ closedBall c r, ν3 ≤ 4 ^ n * m * hlMaximal volume w y := by
    intro y hy
    have hsub : closedBall c (3 * r) ⊆ closedBall y (4 * r) := by
      intro z hz
      rw [mem_closedBall] at hz hy ⊢
      have := dist_triangle z c y
      rw [dist_comm c y] at this
      linarith
    have hvol : volume (closedBall y (4 * r)) = 4 ^ n * m := by
      rw [fs_volume_closedBall_mul y (by linarith) hr.le, fs_volume_closedBall_eq y c hr.le,
        ENNReal.ofReal_pow (by linarith)]
      simp [m]
    have hv0 : volume (closedBall y (4 * r)) ≠ 0 := by
      rw [hvol]; exact mul_ne_zero (pow_ne_zero _ (by norm_num)) hm0
    have hvt : volume (closedBall y (4 * r)) ≠ ∞ := fs_hfin y _
    calc ν3 = ∫⁻ z in closedBall c (3 * r), ‖w z‖ₑ := hν3
      _ ≤ ∫⁻ z in closedBall y (4 * r), ‖w z‖ₑ := lintegral_mono_set hsub
      _ = volume (closedBall y (4 * r)) * hlBallAverage volume w y (4 * r) := by
          rw [hlBallAverage, ← mul_assoc, ENNReal.mul_inv_cancel hv0 hvt, one_mul]
      _ ≤ volume (closedBall y (4 * r)) * hlMaximal volume w y :=
          mul_le_mul_right (hlBallAverage_le_hlMaximal _ _ _ _) _
      _ = 4 ^ n * m * hlMaximal volume w y := by rw [hvol]
  have hτm : τ * m ≤ I := by
    have h1 : τ * m ≤ m⁻¹ * I * m := mul_le_mul_left hτ.le _
    rwa [mul_comm m⁻¹ I, mul_assoc, ENNReal.inv_mul_cancel hm0 hmt, mul_one] at h1
  have hmain : m * (τ * ν3) ≤ m * (4 ^ n * J) := by
    calc m * (τ * ν3) = (τ * m) * ν3 := by ring
      _ ≤ I * ν3 := mul_le_mul_left hτm _
      _ ≤ ∫⁻ y in closedBall c r, ‖f y‖ₑ * ν3 := lintegral_mul_const_le _ _
      _ ≤ ∫⁻ y in closedBall c r, ‖f y‖ₑ * (4 ^ n * m * hlMaximal volume w y) :=
          setLIntegral_mono' measurableSet_closedBall fun y hy' => mul_le_mul_right (hy y hy') _
      _ = ∫⁻ y in closedBall c r, (4 ^ n * m) * (hlMaximal volume w y * ‖f y‖ₑ) :=
          lintegral_congr fun y => by ring
      _ = 4 ^ n * m * J :=
          lintegral_const_mul' _ _
            (ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.ofNat_ne_top) hmt)
      _ = m * (4 ^ n * J) := by ring
  have h2 : τ * ν3 ≤ 4 ^ n * J := (ENNReal.mul_le_mul_iff_right hm0 hmt).1 hmain
  calc ν3 = τ⁻¹ * (τ * ν3) := by rw [← mul_assoc, ENNReal.inv_mul_cancel hτ0 hτt, one_mul]
    _ ≤ τ⁻¹ * (4 ^ n * J) := mul_le_mul_right h2 _
    _ = 4 ^ n / τ * J := by rw [div_eq_mul_inv]; ring

/-- **Weighted weak type `(1,1)`** (Fefferman–Stein): for every weight `w` and `τ > 0`,
`w {M f > τ} ≤ 4ⁿ τ⁻¹ ∫ ‖f‖ M w`. -/
theorem fs_weighted_weak {w : EuclideanSpace ℝ (Fin n) → ℝ} {f : EuclideanSpace ℝ (Fin n) → E}
    (hf : AEStronglyMeasurable f volume) {τ : ℝ≥0∞} (hτ0 : τ ≠ 0) :
    volume.withDensity (fun x => ‖w x‖ₑ) {x | τ < hlMaximal volume f x} ≤
      4 ^ n / τ * ∫⁻ y, hlMaximal volume w y * ‖f y‖ₑ := by
  set ν := volume.withDensity (fun x => ‖w x‖ₑ)
  set L := {x | τ < hlMaximal volume f x}
  have hmeas : MeasurableSet L := measurableSet_lt measurable_const (fs_measurable_maximal hf)
  have hq : ∀ x ∈ L, ∃ q : ℚ, 0 < (q : ℝ) ∧ τ < hlBallAverage volume f x q := by
    intro x hx
    obtain ⟨r, hr⟩ := lt_iSup_iff.1 (show τ < hlMaximal volume f x from hx)
    have h0 := (measure_closedBall_le_of_lt_hlBallAverage hr).1
    obtain ⟨q, hq⟩ := lt_iSup_iff.1 (hr.trans_le (hlBallAverage_le_iSup_rat_gt fs_hfin f x r))
    obtain ⟨hrq, hq'⟩ := lt_iSup_iff.1 hq
    exact ⟨q, h0.trans_lt hrq, hq'⟩
  choose! ρ hρpos hρ using hq
  rw [hmeas.measure_eq_iSup_isCompact ν]
  refine iSup_le fun K => iSup_le fun hKL => iSup_le fun hK => ?_
  obtain ⟨F, hFK, hKF⟩ := hK.elim_nhds_subcover (fun x => closedBall x (ρ x))
    fun x hx => closedBall_mem_nhds x (hρpos x (hKL hx))
  obtain ⟨S, hSF, hdisj, hcov⟩ := exists_disjoint_subfamily_closedBall_subset_three_mul F
    (fun x => x) (fun x => (ρ x : ℝ))
  calc ν K ≤ ν (⋃ x ∈ F, closedBall x (ρ x : ℝ)) := measure_mono hKF
    _ ≤ ν (⋃ j ∈ S, closedBall j (3 * (ρ j : ℝ))) := by
        refine measure_mono (iUnion₂_subset fun i hi => ?_)
        obtain ⟨j, hj, -, hsub⟩ := hcov i hi
        exact hsub.trans (subset_biUnion_of_mem (u := fun j => closedBall j (3 * (ρ j : ℝ))) hj)
    _ ≤ ∑ j ∈ S, ν (closedBall j (3 * (ρ j : ℝ))) := measure_biUnion_finset_le S _
    _ ≤ ∑ j ∈ S, 4 ^ n / τ * ∫⁻ y in closedBall j (ρ j : ℝ), hlMaximal volume w y * ‖f y‖ₑ :=
        Finset.sum_le_sum fun j hj => fs_withDensity_closedBall_le
          (hρpos j (hKL (hFK j (hSF hj)))) hτ0 (hρ j (hKL (hFK j (hSF hj))))
    _ = 4 ^ n / τ * ∫⁻ y in ⋃ j ∈ S, closedBall j (ρ j : ℝ), hlMaximal volume w y * ‖f y‖ₑ := by
        rw [← Finset.mul_sum, lintegral_biUnion_finset hdisj fun _ _ => measurableSet_closedBall]
    _ ≤ 4 ^ n / τ * ∫⁻ y, hlMaximal volume w y * ‖f y‖ₑ :=
        mul_le_mul_right (setLIntegral_le_lintegral _ _) _

/-- The constant of the weighted maximal inequality at exponent `q`. -/
def fsKwPow (n : ℕ) (q : ℝ) : ℝ≥0∞ := marcinkiewiczBoundTop 1 q (4 ^ n) (1 / 2)

lemma fsKwPow_ne_top (n : ℕ) (q : ℝ) : fsKwPow n q ≠ ∞ := marcinkiewiczBoundTop_ne_top _ _ _ _

/-- **The Fefferman–Stein weighted inequality**: for every weight `w` (a.e. strongly measurable
and real-valued; only `|w|` matters) and every `f`, `∫ (M f)^q |w| ≤ C ∫ ‖f‖^q M w`, with `C`
for `q > 1`, with the constant depending only on `n` and `q`. -/
theorem fs_weighted_rpow {q : ℝ} (hq : 1 < q) {w : EuclideanSpace ℝ (Fin n) → ℝ}
    (hw : AEStronglyMeasurable w volume)
    {f : EuclideanSpace ℝ (Fin n) → E} (hf : AEStronglyMeasurable f volume) :
    ∫⁻ x, ‖w x‖ₑ * hlMaximal volume f x ^ q ≤
      fsKwPow n q * ∫⁻ x, hlMaximal volume w x * ‖f x‖ₑ ^ q := by
  set ν := volume.withDensity (fun x => ‖w x‖ₑ)
  set μ := volume.withDensity (hlMaximal volume w)
  have hMw := fs_measurable_maximal hw
  have hμac : μ ≪ volume := withDensity_absolutelyContinuous _ _
  set D : Set (EuclideanSpace ℝ (Fin n) → E) := {g | AEStronglyMeasurable g volume} with hDdef
  have hD : IsTruncationClosed D := fun g hg s _ =>
    ⟨aestronglyMeasurable_indicator_lt_norm hg s, aestronglyMeasurable_indicator_norm_le hg s⟩
  have hne : ∀ (N : ℕ) (a : ℝ≥0∞), min a N ≠ ∞ := fun N a =>
    ne_top_of_le_ne_top (ENNReal.natCast_ne_top N) (min_le_right _ _)
  have key : ∀ N : ℕ, ∫⁻ x, min (hlMaximal volume f x) N ^ q ∂ν ≤
      fsKwPow n q * ∫⁻ x, ‖f x‖ₑ ^ q ∂μ := by
    intro N
    have hTA : HasWeakTypeOn (hlMaximalTrunc volume N) D 1 (4 ^ n) μ ν := by
      intro g hg t ht
      have hg' : AEStronglyMeasurable g volume := hg
      unfold distributionFunction
      rw [ENNReal.rpow_one, ENNReal.ofReal_one, eLpNorm_one_eq_lintegral_enorm (hg'.mono_ac hμac),
        lintegral_withDensity_eq_lintegral_mul₀ hMw.aemeasurable hg'.enorm]
      calc ν {x | t < ‖hlMaximalTrunc volume N g x‖ₑ} ≤ ν {x | t < hlMaximal volume g x} := by
            refine measure_mono fun x hx => ?_
            have hx' : t < ‖hlMaximalTrunc volume N g x‖ₑ := hx
            rw [enorm_hlMaximalTrunc] at hx'
            exact hx'.trans_le (min_le_left _ _)
        _ ≤ 4 ^ n / t * ∫⁻ y, hlMaximal volume w y * ‖g y‖ₑ := fs_weighted_weak hg' ht.ne'
        _ = ((4 ^ n : ℝ≥0) : ℝ≥0∞) *
              (∫⁻ y, (hlMaximal volume w * fun y => ‖g y‖ₑ) y) / t := by
            simp only [Pi.mul_apply]
            rw [div_eq_mul_inv, div_eq_mul_inv]
            push_cast
            ring
    have hTB : HasLinftyBoundOn (hlMaximalTrunc volume N) D 1 ν := by
      intro g _ s hs
      refine ae_of_all _ fun y => ?_
      have hs0 : 0 ≤ s := (norm_nonneg _).trans (hs y)
      have hMg : hlMaximal volume g y ≤ ENNReal.ofReal s :=
        hlMaximal_le_of_ae_enorm_le (ae_of_all _ fun z => by
          rw [← ofReal_norm]
          exact ENNReal.ofReal_le_ofReal (hs z)) y
      rw [hlMaximalTrunc, Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg, NNReal.coe_one,
        one_mul]
      exact ENNReal.toReal_le_of_le_ofReal hs0 ((min_le_left _ _).trans hMg)
    have hsub : IsSublinearOn (hlMaximalTrunc volume N) D ν := by
      intro g hg h _
      refine ae_of_all _ fun x => ?_
      simp only [hlMaximalTrunc, Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg]
      rw [← ENNReal.toReal_add (hne _ _) (hne _ _)]
      refine ENNReal.toReal_mono (ENNReal.add_ne_top.2 ⟨hne _ _, hne _ _⟩) ?_
      exact (min_le_min_right _ (hlMaximal_add_le hg x)).trans (min_add_le_add_min_enn _ _ _)
    have hTf : AEStronglyMeasurable (hlMaximalTrunc volume N f) ν :=
      ((fs_measurable_maximal hf).min measurable_const).ennreal_toReal.aestronglyMeasurable
    have := lintegral_rpow_le_of_hasWeakTypeOn_of_linfty (T := hlMaximalTrunc volume N) one_pos
      hq (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num) hTA hTB hsub hD
      (show f ∈ D from hf) (hf.mono_ac hμac) hTf
    simp only [enorm_hlMaximalTrunc] at this
    exact this
  have hpt : ∀ x, hlMaximal volume f x ^ q =
      ⨆ N : ℕ, min (hlMaximal volume f x) N ^ q := fun x => by
    have h1 : ⨆ N : ℕ, min (hlMaximal volume f x) N = hlMaximal volume f x := by
      rw [← inf_iSup_eq, ENNReal.iSup_natCast]
      simp
    conv_lhs => rw [← h1]
    exact Monotone.map_iSup_of_continuousAt ENNReal.continuous_rpow_const.continuousAt
      (ENNReal.monotone_rpow_of_nonneg (by linarith)) (ENNReal.zero_rpow_of_pos (by linarith))
  have hsup : ∫⁻ x, hlMaximal volume f x ^ q ∂ν ≤ fsKwPow n q * ∫⁻ x, ‖f x‖ₑ ^ q ∂μ := by
    simp_rw [hpt]
    rw [lintegral_iSup' (fun N =>
      (((fs_measurable_maximal hf).min measurable_const).pow_const _).aemeasurable)
      (ae_of_all _ fun x N N' h => ENNReal.rpow_le_rpow
        (min_le_min_left _ (Nat.cast_le.2 h)) (by linarith))]
    exact iSup_le key
  rw [lintegral_withDensity_eq_lintegral_mul₀ hw.enorm
      ((fs_measurable_maximal hf).pow_const _).aemeasurable,
    lintegral_withDensity_eq_lintegral_mul₀ hMw.aemeasurable (hf.enorm.pow_const _)] at hsup
  simpa only [Pi.mul_apply, ENNReal.rpow_two] using hsup

end Weighted

end
end Auto.ClassicalMaximal

namespace Auto.ClassicalMaximal

open MeasureTheory Metric Set Filter Topology
open scoped ENNReal NNReal
noncomputable section

/-- Constant supplied by scalar weighted duality. -/
def fsDualConst (n : ℕ) (r : ℝ) (A : ℝ≥0∞) : ℝ≥0∞ :=
  (A * fsK n (r / (r - 1)) ^ (1 / (r / (r - 1)))) ^ r

lemma fsDualConst_ne_top (n : ℕ) {r : ℝ} (hr : 1 < r) {A : ℝ≥0∞} (hA : A ≠ ∞) :
    fsDualConst n r A ≠ ∞ := by
  have hr0 : 0 < r := by linarith
  have hr1 : 0 < r - 1 := by linarith
  exact ENNReal.rpow_ne_top_of_nonneg hr0.le (ENNReal.mul_ne_top hA
    (ENNReal.rpow_ne_top_of_nonneg (by positivity) (fsK_ne_top _ _)))

/-- Finite extended-real cancellation in the duality argument; adapted from
`../lean-variationalsw/VariationalSW/Auto/CalderonZygmund.lean`, lines 422–436. -/
lemma rpow_le_of_le_mul_rpow {p q : ℝ} (hpq : p.HolderConjugate q) {L A : ℝ≥0∞}
    (hL : L ≠ ∞) (h : L ≤ A * L ^ (1 / q)) : L ^ (1 / p) ≤ A := by
  by_cases hL0 : L = 0
  · rw [hL0, ENNReal.zero_rpow_of_pos (by have := hpq.pos; positivity)]
    exact zero_le
  have hsplit : L = L ^ (1 / p) * L ^ (1 / q) := by
    rw [← ENNReal.rpow_add _ _ hL0 hL, one_div, one_div, hpq.inv_add_inv_eq_one,
      ENNReal.rpow_one]
  have hne0 : L ^ (1 / q) ≠ 0 := (ENNReal.rpow_pos (pos_iff_ne_zero.2 hL0) hL).ne'
  have hnet : L ^ (1 / q) ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg (by have := hpq.symm.pos; positivity) hL
  exact (ENNReal.mul_le_mul_iff_left hne0 hnet).1 (hsplit.symm.le.trans h)

/-- Weighted testing against the scalar maximal operator gives an `L^r` estimate.
Bounded compactly supported tests suffice in the proof, even when the integrals are infinite. -/
theorem fs_lintegral_of_weighted {n : ℕ} {r : ℝ} (hr : 1 < r) (A : ℝ≥0∞)
    (G H : EuclideanSpace ℝ (Fin n) → ℝ≥0∞) (hGm : Measurable G)
    (hHm : AEMeasurable H volume)
    (hweight : ∀ w : EuclideanSpace ℝ (Fin n) → ℝ, Measurable w →
      (∫⁻ x, ‖w x‖ₑ * G x) ≤ A * ∫⁻ x, hlMaximal volume w x * H x) :
    (∫⁻ x, G x ^ r) ≤ fsDualConst n r A * ∫⁻ x, H x ^ r := by
  have hr0 : 0 < r := by linarith
  set q := r / (r - 1) with hqdef
  have hrq : r.HolderConjugate q := Real.HolderConjugate.conjExponent hr
  have hq : 1 < q := hrq.symm.lt
  have hr1q : (r - 1) * q = r := by
    rw [hqdef]; field_simp [show r - 1 ≠ 0 by linarith]
  set! GN : ℕ → EuclideanSpace ℝ (Fin n) → ℝ≥0∞ := fun N =>
    (closedBall (0 : EuclideanSpace ℝ (Fin n)) N).indicator (fun x => min (G x) N)
  have hGN_le : ∀ N x, GN N x ≤ min (G x) N := fun N x => by
    by_cases hx : x ∈ closedBall (0 : EuclideanSpace ℝ (Fin n)) N
    · simp only [GN, indicator_of_mem hx, le_refl]
    · simp only [GN, indicator_of_notMem hx, zero_le]
  have hGN_ne_top : ∀ N x, GN N x ≠ ∞ := fun N x =>
    ne_top_of_le_ne_top (ENNReal.natCast_ne_top N) ((hGN_le N x).trans (min_le_right _ _))
  have hGNm : ∀ N, Measurable (GN N) := fun N =>
    (hGm.min measurable_const).indicator measurableSet_closedBall
  set! wN : ℕ → EuclideanSpace ℝ (Fin n) → ℝ := fun N x => (GN N x ^ (r - 1)).toReal
  have hwN : ∀ N x, ‖wN N x‖ₑ = GN N x ^ (r - 1) := fun N x => by
    rw [Real.enorm_eq_ofReal ENNReal.toReal_nonneg, ENNReal.ofReal_toReal
      (ENNReal.rpow_ne_top_of_nonneg (by linarith) (hGN_ne_top N x))]
  have hwNm : ∀ N, Measurable (wN N) := fun N => ((hGNm N).pow_const _).ennreal_toReal
  have key : ∀ N : ℕ, ∫⁻ x, GN N x ^ r ≤ fsDualConst n r A * ∫⁻ x, H x ^ r := by
    intro N
    set X := ∫⁻ x, GN N x ^ r
    have hX : X ≠ ∞ := by
      refine ne_top_of_le_ne_top (b := ∫⁻ x, (closedBall (0 : EuclideanSpace ℝ (Fin n)) N).indicator
        (fun _ => ((N : ℝ≥0∞) ^ r)) x) ?_ (lintegral_mono fun x => ?_)
      · rw [lintegral_indicator_const measurableSet_closedBall]
        exact ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg hr0.le
          (ENNReal.natCast_ne_top N)) (fs_hfin _ _)
      · by_cases hx : x ∈ closedBall (0 : EuclideanSpace ℝ (Fin n)) N
        · rw [indicator_of_mem hx]
          exact ENNReal.rpow_le_rpow ((hGN_le N x).trans (min_le_right _ _)) hr0.le
        · simp only [GN, indicator_of_notMem hx, ENNReal.zero_rpow_of_pos hr0, le_refl]
    set! Mw := hlMaximal volume (wN N)
    have hMwm : Measurable Mw := fs_measurable_maximal (hwNm N).aestronglyMeasurable
    have step1 : X ≤ ∫⁻ x, ‖wN N x‖ₑ * G x := by
      refine lintegral_mono fun x => ?_
      rw [hwN]
      by_cases h0 : GN N x = 0
      · rw [h0, ENNReal.zero_rpow_of_pos hr0]
        exact zero_le
      · calc GN N x ^ r = GN N x ^ (r - 1) * GN N x ^ (1 : ℝ) := by
              rw [← ENNReal.rpow_add _ _ h0 (hGN_ne_top N x)]
              ring_nf
          _ ≤ GN N x ^ (r - 1) * G x := by
              rw [ENNReal.rpow_one]
              exact mul_le_mul_right ((hGN_le N x).trans (min_le_left _ _)) _
    have step2 := hweight (wN N) (hwNm N)
    have step3 : ∫⁻ x, Mw x * H x ≤
        (∫⁻ x, H x ^ r) ^ (1 / r) * (∫⁻ x, Mw x ^ q) ^ (1 / q) := by
      have := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hrq hHm hMwm.aemeasurable
      simp only [Pi.mul_apply] at this
      refine le_trans (le_of_eq (lintegral_congr fun x => mul_comm _ _)) this
    have step4 : ∫⁻ x, Mw x ^ q ≤ fsK n q * X := by
      refine (fs_lintegral_maximal_rpow_le hq (hwNm N).aestronglyMeasurable).trans_eq ?_
      congr 1
      refine lintegral_congr fun x => ?_
      rw [hwN, ← ENNReal.rpow_mul, hr1q]
    set Y := ∫⁻ x, H x ^ r
    have hcomb : X ≤ A * fsK n q ^ (1 / q) * Y ^ (1 / r) * X ^ (1 / q) := by
      calc X ≤ A * ((∫⁻ x, H x ^ r) ^ (1 / r) * (∫⁻ x, Mw x ^ q) ^ (1 / q)) :=
            step1.trans (step2.trans (mul_le_mul_right step3 _))
        _ ≤ A * (Y ^ (1 / r) * (fsK n q * X) ^ (1 / q)) := by
            gcongr
        _ = A * fsK n q ^ (1 / q) * Y ^ (1 / r) * X ^ (1 / q) := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity)]
            ring
    have h5 := rpow_le_of_le_mul_rpow hrq hX hcomb
    have h6 := ENNReal.rpow_le_rpow h5 hr0.le
    rw [← ENNReal.rpow_mul, one_div_mul_cancel hr0.ne', ENNReal.rpow_one,
      ENNReal.mul_rpow_of_nonneg _ _ hr0.le, ← ENNReal.rpow_mul, one_div_mul_cancel hr0.ne',
      ENNReal.rpow_one] at h6
    refine h6.trans_eq ?_
    rfl
  have hpt : ∀ x, G x ^ r = ⨆ N : ℕ, GN N x ^ r := fun x => by
    refine le_antisymm ?_ (iSup_le fun N => ENNReal.rpow_le_rpow
      ((hGN_le N x).trans (min_le_left _ _)) hr0.le)
    have h1 : ⨆ N : ℕ, min (G x) N = G x := by
      rw [← inf_iSup_eq, ENNReal.iSup_natCast]
      simp
    conv_lhs => rw [← h1]
    rw [Monotone.map_iSup_of_continuousAt ENNReal.continuous_rpow_const.continuousAt
      (ENNReal.monotone_rpow_of_nonneg hr0.le) (ENNReal.zero_rpow_of_pos hr0)]
    refine iSup_le fun N => ?_
    set! N' := max N ⌈‖x‖⌉₊
    have hx : x ∈ closedBall (0 : EuclideanSpace ℝ (Fin n)) N' := by
      rw [mem_closedBall, dist_zero_right]
      exact (Nat.le_ceil _).trans (Nat.cast_le.2 (le_max_right _ _))
    refine le_iSup_of_le N' (ENNReal.rpow_le_rpow ?_ hr0.le)
    simp only [GN, indicator_of_mem hx]
    exact min_le_min_left _ (Nat.cast_le.2 (le_max_left _ _))
  have hmono : ∀ x, Monotone fun N => GN N x ^ r := fun x N N' hNN' => by
    refine ENNReal.rpow_le_rpow ?_ hr0.le
    by_cases hx : x ∈ closedBall (0 : EuclideanSpace ℝ (Fin n)) N
    · have hx' : x ∈ closedBall (0 : EuclideanSpace ℝ (Fin n)) N' :=
        closedBall_subset_closedBall (Nat.cast_le.2 hNN') hx
      simp only [GN, indicator_of_mem hx, indicator_of_mem hx']
      exact min_le_min_left _ (Nat.cast_le.2 hNN')
    · simp only [GN, indicator_of_notMem hx, zero_le]
  calc ∫⁻ x, G x ^ r = ∫⁻ x, ⨆ N : ℕ, GN N x ^ r := lintegral_congr hpt
    _ = ⨆ N : ℕ, ∫⁻ x, GN N x ^ r :=
        lintegral_iSup' (fun N => ((hGNm N).pow_const _).aemeasurable) (ae_of_all _ hmono)
    _ ≤ fsDualConst n r A * ∫⁻ x, H x ^ r := iSup_le key

/-- The scalar maximal operator acts in the Euclidean variable only. -/
def mixedMaximal {n : ℕ} {Ω E : Type*} [NormedAddCommGroup E]
    (f : EuclideanSpace ℝ (Fin n) × Ω → E) (p : EuclideanSpace ℝ (Fin n) × Ω) : ℝ≥0∞ :=
  hlMaximal volume (fun y => f (y, p.2)) p.1

theorem measurable_mixedMaximal {n : ℕ} {Ω E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    {f : EuclideanSpace ℝ (Fin n) × Ω → E} (hf : Measurable f) :
    Measurable (mixedMaximal f) := by
  change Measurable (fun p : EuclideanSpace ℝ (Fin n) × Ω =>
    hlMaximal volume (fun y => f (y, p.2)) p.1)
  simp_rw [hlMaximal_eq_iSup_rat fs_hfin]
  apply Measurable.iSup
  intro q
  let S : Set ((EuclideanSpace ℝ (Fin n) × Ω) × EuclideanSpace ℝ (Fin n)) :=
    {p | dist p.2 p.1.1 ≤ (q : ℝ)}
  have hS : MeasurableSet S := measurableSet_le
    (measurable_snd.dist (measurable_fst.comp measurable_fst)) measurable_const
  have hi : Measurable (fun p : EuclideanSpace ℝ (Fin n) × Ω =>
      ∫⁻ y in closedBall p.1 (q : ℝ), ‖f (y, p.2)‖ₑ) := by
    have h := ((hf.comp (measurable_snd.prodMk
      (measurable_snd.comp measurable_fst))).enorm.indicator hS)
        |>.lintegral_prod_right' (ν := volume)
    convert h using 1
    funext p
    rw [← lintegral_indicator measurableSet_closedBall]
    rfl
  have hv : Measurable (fun x : EuclideanSpace ℝ (Fin n) =>
      volume (closedBall x (q : ℝ))) := by
    exact measurable_measure_prodMk_left (measurableSet_le
      (measurable_snd.dist measurable_fst) measurable_const)
  exact ((hv.comp measurable_fst).inv.mul hi)

theorem fs_mixed_weighted {n : ℕ} {Ω E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (ν : Measure Ω) [SFinite ν] {s : ℝ} (hs : 1 < s)
    {f : EuclideanSpace ℝ (Fin n) × Ω → E} (hf : Measurable f)
    (w : EuclideanSpace ℝ (Fin n) → ℝ) (hw : Measurable w) :
    (∫⁻ x, ‖w x‖ₑ * ∫⁻ ω, mixedMaximal f (x, ω) ^ s ∂ν) ≤
      fsKwPow n s * ∫⁻ x, hlMaximal volume w x * ∫⁻ ω, ‖f (x, ω)‖ₑ ^ s ∂ν := by
  have hM := measurable_mixedMaximal hf
  have hMw := fs_measurable_maximal hw.aestronglyMeasurable
  calc (∫⁻ x, ‖w x‖ₑ * ∫⁻ ω, mixedMaximal f (x, ω) ^ s ∂ν)
      = ∫⁻ x, ∫⁻ ω, ‖w x‖ₑ * mixedMaximal f (x, ω) ^ s ∂ν := by
          apply lintegral_congr
          intro x
          exact (lintegral_const_mul _ ((hM.comp measurable_prodMk_left).pow_const s)).symm
    _ = ∫⁻ ω, (∫⁻ x, ‖w x‖ₑ * mixedMaximal f (x, ω) ^ s) ∂ν :=
      lintegral_lintegral_swap (((hw.comp measurable_fst).enorm.mul (hM.pow_const s)).aemeasurable)
    _ ≤ ∫⁻ ω, (fsKwPow n s * ∫⁻ x, hlMaximal volume w x * ‖f (x, ω)‖ₑ ^ s) ∂ν := by
      apply lintegral_mono
      intro ω
      exact fs_weighted_rpow (f := fun x => f (x, ω)) hs hw.aestronglyMeasurable
        (hf.comp (measurable_id.prodMk measurable_const)).aestronglyMeasurable
    _ = fsKwPow n s * ∫⁻ ω, (∫⁻ x, hlMaximal volume w x * ‖f (x, ω)‖ₑ ^ s) ∂ν :=
      lintegral_const_mul _
        ((hMw.comp measurable_snd).mul
          ((hf.comp measurable_swap).enorm.pow_const s)).lintegral_prod_right'
    _ = fsKwPow n s * ∫⁻ x, ∫⁻ ω, hlMaximal volume w x * ‖f (x, ω)‖ₑ ^ s ∂ν := by
      congr 1
      exact lintegral_lintegral_swap
        (((hMw.comp measurable_snd).mul
          ((hf.comp measurable_swap).enorm.pow_const s)).aemeasurable)
    _ = fsKwPow n s * ∫⁻ x, hlMaximal volume w x * ∫⁻ ω, ‖f (x, ω)‖ₑ ^ s ∂ν := by
      congr 1
      apply lintegral_congr
      intro x
      exact lintegral_const_mul _ ((hf.comp measurable_prodMk_left).enorm.pow_const s)

/-- The vector maximal inequality when the outer exponent exceeds the inner exponent,
valid on any sigma-finite inner measure space with a constant independent of that space. -/
theorem fs_mixed_lintegral_of_lt {n : ℕ} {Ω E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (ν : Measure Ω) [SFinite ν] {p s : ℝ} (hs : 1 < s) (hsp : s < p)
    {f : EuclideanSpace ℝ (Fin n) × Ω → E} (hf : Measurable f) :
    (∫⁻ x, (∫⁻ ω, mixedMaximal f (x, ω) ^ s ∂ν) ^ (p / s)) ≤
      fsDualConst n (p / s) (fsKwPow n s) *
        ∫⁻ x, (∫⁻ ω, ‖f (x, ω)‖ₑ ^ s ∂ν) ^ (p / s) := by
  apply fs_lintegral_of_weighted ((lt_div_iff₀ (by linarith : 0 < s)).mpr (by simpa))
    (fsKwPow n s) _ _
    ((measurable_mixedMaximal hf).pow_const s).lintegral_prod_right'
    (hf.enorm.pow_const s).lintegral_prod_right'.aemeasurable
  exact fun w hw => fs_mixed_weighted ν hs hf w hw

/-- Iterated extended `L^p(L^s)` norm of a nonnegative function. -/
def mixedENorm {X Ω : Type*} [MeasurableSpace X] [MeasurableSpace Ω]
    (μ : Measure X) (ν : Measure Ω) (p s : ℝ) (f : X × Ω → ℝ≥0∞) : ℝ≥0∞ :=
  (∫⁻ x, (∫⁻ ω, f (x, ω) ^ s ∂ν) ^ (p / s) ∂μ) ^ (1 / p)

theorem mixedENorm_mono {X Ω : Type*} [MeasurableSpace X] [MeasurableSpace Ω]
    (μ : Measure X) (ν : Measure Ω) {p s : ℝ} (hp : 0 < p) (hs : 0 < s)
    {f g : X × Ω → ℝ≥0∞} (h : ∀ z, f z ≤ g z) :
    mixedENorm μ ν p s f ≤ mixedENorm μ ν p s g := by
  apply ENNReal.rpow_le_rpow _ (by positivity)
  apply lintegral_mono
  intro x
  exact ENNReal.rpow_le_rpow (lintegral_mono fun ω => ENNReal.rpow_le_rpow (h _) hs.le)
    (by positivity)

/-- Hölder's inequality applied in the inner variable and then in the outer variable. -/
theorem mixed_holder {X Ω : Type*} [MeasurableSpace X] [MeasurableSpace Ω]
    (μ : Measure X) (ν : Measure Ω) [SFinite ν] {p p' s s' : ℝ}
    (hp : p.HolderConjugate p') (hs : s.HolderConjugate s')
    (f g : X × Ω → ℝ≥0∞) (hf : Measurable f) (hg : Measurable g) :
    (∫⁻ x, ∫⁻ ω, f (x, ω) * g (x, ω) ∂ν ∂μ) ≤
      mixedENorm μ ν p s f * mixedENorm μ ν p' s' g := by
  let F := fun x => (∫⁻ ω, f (x, ω) ^ s ∂ν) ^ (1 / s)
  let G := fun x => (∫⁻ ω, g (x, ω) ^ s' ∂ν) ^ (1 / s')
  have hF : Measurable F := ((hf.pow_const s).lintegral_prod_right').pow_const _
  have hG : Measurable G := ((hg.pow_const s').lintegral_prod_right').pow_const _
  calc (∫⁻ x, ∫⁻ ω, f (x, ω) * g (x, ω) ∂ν ∂μ) ≤ ∫⁻ x, F x * G x ∂μ := by
        apply lintegral_mono
        intro x
        exact ENNReal.lintegral_mul_le_Lp_mul_Lq ν hs
          (hf.comp measurable_prodMk_left).aemeasurable
          (hg.comp measurable_prodMk_left).aemeasurable
    _ ≤ (∫⁻ x, F x ^ p ∂μ) ^ (1 / p) * (∫⁻ x, G x ^ p' ∂μ) ^ (1 / p') :=
      ENNReal.lintegral_mul_le_Lp_mul_Lq μ hp hF.aemeasurable hG.aemeasurable
    _ = mixedENorm μ ν p s f * mixedENorm μ ν p' s' g := by
      simp only [F, G, mixedENorm, ← ENNReal.rpow_mul, one_div_mul_eq_div]

/-- The optimizing weight for mixed-norm duality; zero inner fibers receive weight zero. -/
def mixedDualWeight {X Ω : Type*} [MeasurableSpace Ω] (ν : Measure Ω)
    (p s : ℝ) (u : X × Ω → ℝ≥0∞) (z : X × Ω) : ℝ≥0∞ :=
  if (∫⁻ ω, u (z.1, ω) ^ s ∂ν) = 0 then 0 else
    u z ^ (s - 1) * (∫⁻ ω, u (z.1, ω) ^ s ∂ν) ^ (p / s - 1)

theorem measurable_mixedDualWeight {X Ω : Type*} [MeasurableSpace X] [MeasurableSpace Ω]
    (ν : Measure Ω) [SFinite ν] (p s : ℝ) {u : X × Ω → ℝ≥0∞} (hu : Measurable u) :
    Measurable (mixedDualWeight ν p s u) := by
  have hB : Measurable (fun z : X × Ω => ∫⁻ ω, u (z.1, ω) ^ s ∂ν) :=
    ((hu.pow_const s).lintegral_prod_right' (ν := ν)).comp measurable_fst
  exact Measurable.ite (measurableSet_eq_fun hB measurable_const) measurable_const
    ((hu.pow_const _).mul (hB.pow_const _))

theorem mixedDualWeight_ne_top {X Ω : Type*} [MeasurableSpace Ω] (ν : Measure Ω)
    {p s : ℝ} (hs : 1 < s) (u : X × Ω → ℝ≥0∞) (hu : ∀ z, u z ≠ ∞)
    (hB : ∀ x, (∫⁻ ω, u (x, ω) ^ s ∂ν) ≠ ∞) (z : X × Ω) :
    mixedDualWeight ν p s u z ≠ ∞ := by
  unfold mixedDualWeight
  split_ifs with h0
  · exact ENNReal.zero_ne_top
  · exact ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg (by linarith) (hu z))
      (ENNReal.rpow_ne_top_of_ne_zero h0 (hB z.1))

theorem mixedDualWeight_pairing {X Ω : Type*} [MeasurableSpace X] [MeasurableSpace Ω]
    (ν : Measure Ω) {p s : ℝ} (hp : 0 < p) (hs : 1 < s)
    (u : X × Ω → ℝ≥0∞) (hu : Measurable u)
    (hB : ∀ x, (∫⁻ ω, u (x, ω) ^ s ∂ν) ≠ ∞) (x : X) :
    (∫⁻ ω, u (x, ω) * mixedDualWeight ν p s u (x, ω) ∂ν) =
      (∫⁻ ω, u (x, ω) ^ s ∂ν) ^ (p / s) := by
  have hs0 : 0 < s := by linarith
  by_cases h0 : (∫⁻ ω, u (x, ω) ^ s ∂ν) = 0
  · simp [mixedDualWeight, h0, ENNReal.zero_rpow_of_pos (div_pos hp hs0)]
  · simp only [mixedDualWeight, h0, ↓reduceIte]
    have hprod (a b : ℝ≥0∞) : a * (a ^ (s - 1) * b) = a ^ s * b := by
      calc a * (a ^ (s - 1) * b) = (a ^ (1 : ℝ) * a ^ (s - 1)) * b := by
              rw [ENNReal.rpow_one, mul_assoc]
        _ = a ^ (1 + (s - 1)) * b := by
              rw [ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by linarith)]
        _ = a ^ s * b := by congr 2; ring
    simp_rw [hprod]
    rw [lintegral_mul_const (μ := ν) (f := fun ω => u (x, ω) ^ s) _
      ((hu.comp measurable_prodMk_left).pow_const s)]
    have he := (ENNReal.rpow_add 1 (p / s - 1) h0 (hB x)).symm
    rw [ENNReal.rpow_one, show 1 + (p / s - 1) = p / s by ring] at he
    exact he

theorem mixedDualWeight_power {X Ω : Type*} [MeasurableSpace X] [MeasurableSpace Ω]
    (ν : Measure Ω) {p p' s s' : ℝ} (hp : p.HolderConjugate p')
    (hs : s.HolderConjugate s') (u : X × Ω → ℝ≥0∞) (hu : Measurable u)
    (hB : ∀ x, (∫⁻ ω, u (x, ω) ^ s ∂ν) ≠ ∞) (x : X) :
    (∫⁻ ω, mixedDualWeight ν p s u (x, ω) ^ s' ∂ν) ^ (p' / s') =
      (∫⁻ ω, u (x, ω) ^ s ∂ν) ^ (p / s) := by
  by_cases h0 : (∫⁻ ω, u (x, ω) ^ s ∂ν) = 0
  · simp [mixedDualWeight, h0, ENNReal.zero_rpow_of_pos hs.symm.pos,
      ENNReal.zero_rpow_of_pos (div_pos hp.symm.pos hs.symm.pos),
      ENNReal.zero_rpow_of_pos (div_pos hp.pos hs.pos)]
  · simp only [mixedDualWeight, h0, ↓reduceIte,
      ENNReal.mul_rpow_of_nonneg _ _ hs.symm.pos.le, ← ENNReal.rpow_mul,
      hs.sub_one_mul_conj]
    rw [lintegral_mul_const (μ := ν) (f := fun ω => u (x, ω) ^ s) _
      ((hu.comp measurable_prodMk_left).pow_const s)]
    have he := (ENNReal.rpow_add 1 ((p / s - 1) * s') h0 (hB x)).symm
    rw [ENNReal.rpow_one] at he
    rw [he, ← ENNReal.rpow_mul]
    congr 1
    rw [hp.conjugate_eq, hs.conjugate_eq]
    field_simp [hp.ne_zero, hs.ne_zero, hp.sub_one_ne_zero, hs.sub_one_ne_zero]
    ring

/-- Mixed dual testing for finite-valued functions with finite inner powers and total norm. -/
theorem mixedENorm_le_of_finite_test {X Ω : Type*}
    [MeasurableSpace X] [MeasurableSpace Ω] (μ : Measure X) (ν : Measure Ω) [SFinite ν]
    {p p' s s' : ℝ} (hp : p.HolderConjugate p') (hs : s.HolderConjugate s')
    (u : X × Ω → ℝ≥0∞) (hu : Measurable u) (hut : ∀ z, u z ≠ ∞)
    (hBt : ∀ x, (∫⁻ ω, u (x, ω) ^ s ∂ν) ≠ ∞)
    (hXt : (∫⁻ x, (∫⁻ ω, u (x, ω) ^ s ∂ν) ^ (p / s) ∂μ) ≠ ∞)
    (A : ℝ≥0∞)
    (htest : ∀ w : X × Ω → ℝ, Measurable w →
      (∫⁻ x, ∫⁻ ω, u (x, ω) * ‖w (x, ω)‖ₑ ∂ν ∂μ) ≤
        A * mixedENorm μ ν p' s' (fun z => ‖w z‖ₑ)) :
    mixedENorm μ ν p s u ≤ A := by
  let w := fun z => (mixedDualWeight ν p s u z).toReal
  have hw : Measurable w := (measurable_mixedDualWeight ν p s hu).ennreal_toReal
  have hn : (fun z => ‖w z‖ₑ) = mixedDualWeight ν p s u := by
    funext z
    exact (Real.enorm_eq_ofReal ENNReal.toReal_nonneg).trans
      (ENNReal.ofReal_toReal (mixedDualWeight_ne_top ν hs.lt u hut hBt z))
  have h := htest w hw
  simp only [congrFun hn] at h
  have hi := lintegral_congr (μ := μ) (mixedDualWeight_pairing ν hp.pos hs.lt u hu hBt)
  have hd : mixedENorm μ ν p' s' (mixedDualWeight ν p s u) =
      (∫⁻ x, (∫⁻ ω, u (x, ω) ^ s ∂ν) ^ (p / s) ∂μ) ^ (1 / p') := by
    unfold mixedENorm
    congr 1
    exact lintegral_congr (mixedDualWeight_power ν hp hs u hu hBt)
  rw [hi, hd] at h
  exact rpow_le_of_le_mul_rpow hp hXt h

/-- Positive powers preserve arbitrary suprema of extended nonnegative numbers. -/
lemma fs_rpow_iSup {ι : Type*} {a : ℝ} (ha : 0 < a) (f : ι → ℝ≥0∞) :
    (⨆ i, f i) ^ a = ⨆ i, f i ^ a :=
  Monotone.map_iSup_of_continuousAt ENNReal.continuous_rpow_const.continuousAt
    (ENNReal.monotone_rpow_of_nonneg ha.le) (ENNReal.zero_rpow_of_pos ha)

theorem mixedENorm_iSup {X Ω : Type*} [MeasurableSpace X] [MeasurableSpace Ω]
    (μ : Measure X) (ν : Measure Ω) [SFinite ν] {p s : ℝ} (hp : 0 < p) (hs : 0 < s)
    (u : ℕ → X × Ω → ℝ≥0∞) (hu : ∀ N, Measurable (u N)) (hmono : Monotone u) :
    mixedENorm μ ν p s (fun z => ⨆ N, u N z) = ⨆ N, mixedENorm μ ν p s (u N) := by
  unfold mixedENorm
  simp_rw [fs_rpow_iSup hs]
  have hi (x : X) : (∫⁻ ω, ⨆ N, u N (x, ω) ^ s ∂ν) =
      ⨆ N, ∫⁻ ω, u N (x, ω) ^ s ∂ν :=
    lintegral_iSup (fun N => ((hu N).comp measurable_prodMk_left).pow_const s)
      (fun N N' h ω => ENNReal.rpow_le_rpow (hmono h _) hs.le)
  simp_rw [hi, fs_rpow_iSup (div_pos hp hs)]
  rw [lintegral_iSup (fun N => ((hu N).pow_const s).lintegral_prod_right'.pow_const _)
    (fun N N' h x => ENNReal.rpow_le_rpow (lintegral_mono fun ω =>
      ENNReal.rpow_le_rpow (hmono h _) hs.le) (div_pos hp hs).le)]
  exact fs_rpow_iSup (one_div_pos.mpr hp) _

/-- Mixed dual testing without finiteness restrictions on the tested function.
The inner measure is finite; truncation in value and the Euclidean variable removes
the hypotheses of `mixedENorm_le_of_finite_test`. -/
theorem mixedENorm_le_of_test {n : ℕ} {Ω : Type*} [MeasurableSpace Ω]
    (ν : Measure Ω) [IsFiniteMeasure ν] {p p' s s' : ℝ}
    (hp : p.HolderConjugate p') (hs : s.HolderConjugate s')
    (u : EuclideanSpace ℝ (Fin n) × Ω → ℝ≥0∞) (hu : Measurable u) (A : ℝ≥0∞)
    (htest : ∀ w : EuclideanSpace ℝ (Fin n) × Ω → ℝ, Measurable w →
      (∫⁻ x, ∫⁻ ω, u (x, ω) * ‖w (x, ω)‖ₑ ∂ν) ≤
        A * mixedENorm volume ν p' s' (fun z => ‖w z‖ₑ)) :
    mixedENorm volume ν p s u ≤ A := by
  let U : ℕ → EuclideanSpace ℝ (Fin n) × Ω → ℝ≥0∞ := fun N =>
    (Prod.fst ⁻¹' closedBall (0 : EuclideanSpace ℝ (Fin n)) N).indicator
      (fun z => min (u z) N)
  have hm (N : ℕ) : Measurable (U N) :=
    (hu.min measurable_const).indicator (measurableSet_closedBall.preimage measurable_fst)
  have hle (N : ℕ) (z) : U N z ≤ min (u z) N := by
    by_cases hz : z.1 ∈ closedBall (0 : EuclideanSpace ℝ (Fin n)) N
    · simp [U, hz]
    · simp [U, hz]
  have hcap (N : ℕ) (z) : U N z ≤ N := (hle N z).trans (min_le_right _ _)
  have ht (N : ℕ) (z) : U N z ≠ ∞ :=
    ne_top_of_le_ne_top (ENNReal.natCast_ne_top N) (hcap N z)
  let C := fun N : ℕ => (N : ℝ≥0∞) ^ s * ν Set.univ
  have hCt (N : ℕ) : C N ≠ ∞ := ENNReal.mul_ne_top
    (ENNReal.rpow_ne_top_of_nonneg hs.pos.le (ENNReal.natCast_ne_top N)) (measure_ne_top _ _)
  have hB (N : ℕ) (x) : (∫⁻ ω, U N (x, ω) ^ s ∂ν) ≤ C N := by
    calc (∫⁻ ω, U N (x, ω) ^ s ∂ν) ≤ ∫⁻ _ : Ω, (N : ℝ≥0∞) ^ s ∂ν :=
          lintegral_mono fun ω => ENNReal.rpow_le_rpow (hcap N _) hs.pos.le
      _ = C N := lintegral_const _
  have hBfin (N : ℕ) (x) : (∫⁻ ω, U N (x, ω) ^ s ∂ν) ≠ ∞ :=
    ne_top_of_le_ne_top (hCt N) (hB N x)
  have hXfin (N : ℕ) : (∫⁻ x, (∫⁻ ω, U N (x, ω) ^ s ∂ν) ^ (p / s)) ≠ ∞ := by
    refine ne_top_of_le_ne_top (b := ∫⁻ x,
      (closedBall (0 : EuclideanSpace ℝ (Fin n)) N).indicator
        (fun _ => C N ^ (p / s)) x) ?_ ?_
    · rw [lintegral_indicator_const measurableSet_closedBall]
      exact ENNReal.mul_ne_top
        (ENNReal.rpow_ne_top_of_nonneg (div_pos hp.pos hs.pos).le (hCt N)) (fs_hfin _ _)
    · apply lintegral_mono
      intro x
      by_cases hx : x ∈ closedBall (0 : EuclideanSpace ℝ (Fin n)) N
      · rw [Set.indicator_of_mem hx]
        exact ENNReal.rpow_le_rpow (hB N x) (div_pos hp.pos hs.pos).le
      · simp [U, Set.indicator, hx, ENNReal.zero_rpow_of_pos hs.pos,
          ENNReal.zero_rpow_of_pos (div_pos hp.pos hs.pos)]
  have hkey (N : ℕ) : mixedENorm volume ν p s (U N) ≤ A := by
    apply mixedENorm_le_of_finite_test volume ν hp hs (U N) (hm N) (ht N)
      (hBfin N) (hXfin N) A
    intro w hw
    refine (lintegral_mono fun x => lintegral_mono fun ω => ?_).trans (htest w hw)
    exact mul_le_mul_left ((hle N (x, ω)).trans (min_le_left _ _)) _
  have hmono : Monotone U := by
    intro N N' h z
    by_cases hz : z.1 ∈ closedBall (0 : EuclideanSpace ℝ (Fin n)) N
    · have hz' := closedBall_subset_closedBall (Nat.cast_le.mpr h) hz
      simpa [U, Set.indicator, hz, hz'] using
        (min_le_min_left (u z) (show (N : ℝ≥0∞) ≤ N' from Nat.cast_le.mpr h))
    · simp [U, Set.indicator, hz]
  have heq : (fun z => ⨆ N, U N z) = u := by
    funext z
    refine le_antisymm (iSup_le fun N => (hle N z).trans (min_le_left _ _)) ?_
    have hsup : (⨆ N : ℕ, min (u z) N) = u z := by
      rw [← inf_iSup_eq, ENNReal.iSup_natCast]
      simp
    rw [← hsup]
    apply iSup_le
    intro N
    let N' := max N ⌈‖z.1‖⌉₊
    have hz : z.1 ∈ closedBall (0 : EuclideanSpace ℝ (Fin n)) N' := by
      rw [mem_closedBall, dist_zero_right]
      exact (Nat.le_ceil _).trans (Nat.cast_le.mpr (le_max_right _ _))
    apply le_iSup_of_le N'
    simpa [U, Set.indicator, hz] using
      (min_le_min_left (u z) (show (N : ℝ≥0∞) ≤ N' from
        Nat.cast_le.mpr (le_max_left _ _)))
  rw [← heq, mixedENorm_iSup volume ν hp.pos hs.pos U hm hmono]
  exact iSup_le hkey

/-- Taking a power of a function rescales both mixed-norm exponents. -/
theorem mixedENorm_rpow_scale {X Ω : Type*} [MeasurableSpace X] [MeasurableSpace Ω]
    (μ : Measure X) (ν : Measure Ω) {p s a : ℝ} (hp : 0 < p) (hs : 0 < s) (ha : 0 < a)
    (u : X × Ω → ℝ≥0∞) :
    mixedENorm μ ν (p / a) (s / a) (fun z => u z ^ a) = mixedENorm μ ν p s u ^ a := by
  simp only [mixedENorm, ← ENNReal.rpow_mul]
  rw [show a * (s / a) = s by field_simp,
    show p / a / (s / a) = p / s by field_simp,
    show 1 / (p / a) = 1 / p * a by field_simp]

def fsUpperConst (n : ℕ) (p s : ℝ) : ℝ≥0∞ :=
  fsDualConst n (p / s) (fsKwPow n s) ^ (1 / p)

lemma fsUpperConst_ne_top (n : ℕ) {p s : ℝ} (hs : 1 < s) (hsp : s < p) :
    fsUpperConst n p s ≠ ∞ := by
  have hs0 : 0 < s := by linarith
  have hp0 : 0 < p := by linarith
  exact ENNReal.rpow_ne_top_of_nonneg (by positivity)
    (fsDualConst_ne_top n ((lt_div_iff₀ hs0).mpr (by simpa)) (fsKwPow_ne_top n s))

theorem fs_mixedENorm_of_lt {n : ℕ} {Ω E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (ν : Measure Ω) [SFinite ν] {p s : ℝ} (hs : 1 < s) (hsp : s < p)
    {f : EuclideanSpace ℝ (Fin n) × Ω → E} (hf : Measurable f) :
    mixedENorm volume ν p s (mixedMaximal f) ≤
      fsUpperConst n p s * mixedENorm volume ν p s (fun z => ‖f z‖ₑ) := by
  have hp0 : 0 < p := by linarith
  have h := ENNReal.rpow_le_rpow (fs_mixed_lintegral_of_lt ν hs hsp hf)
    (one_div_pos.mpr hp0).le
  simpa only [mixedENorm, fsUpperConst,
    ENNReal.mul_rpow_of_nonneg _ _ (one_div_pos.mpr hp0).le] using h

/-- The weighted maximal inequality with a weight depending on both variables. -/
theorem fs_pair_weighted {n : ℕ} {Ω E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (ν : Measure Ω) [SFinite ν] {a : ℝ} (ha : 1 < a)
    {f : EuclideanSpace ℝ (Fin n) × Ω → E} (hf : Measurable f)
    (w : EuclideanSpace ℝ (Fin n) × Ω → ℝ) (hw : Measurable w) :
    (∫⁻ x, ∫⁻ ω, mixedMaximal f (x, ω) ^ a * ‖w (x, ω)‖ₑ ∂ν) ≤
      fsKwPow n a * ∫⁻ x, ∫⁻ ω, ‖f (x, ω)‖ₑ ^ a * mixedMaximal w (x, ω) ∂ν := by
  have hMf := measurable_mixedMaximal hf
  have hMw := measurable_mixedMaximal hw
  calc (∫⁻ x, ∫⁻ ω, mixedMaximal f (x, ω) ^ a * ‖w (x, ω)‖ₑ ∂ν)
      = ∫⁻ ω, (∫⁻ x, mixedMaximal f (x, ω) ^ a * ‖w (x, ω)‖ₑ) ∂ν :=
        lintegral_lintegral_swap (((hMf.pow_const a).mul hw.enorm).aemeasurable)
    _ ≤ ∫⁻ ω, (fsKwPow n a *
        ∫⁻ x, ‖f (x, ω)‖ₑ ^ a * mixedMaximal w (x, ω)) ∂ν := by
      apply lintegral_mono
      intro ω
      have h := fs_weighted_rpow (f := fun x => f (x, ω)) (w := fun x => w (x, ω)) ha
        (hw.comp (measurable_id.prodMk measurable_const)).aestronglyMeasurable
        (hf.comp (measurable_id.prodMk measurable_const)).aestronglyMeasurable
      simpa only [mixedMaximal, mul_comm] using h
    _ = fsKwPow n a *
        ∫⁻ ω, (∫⁻ x, ‖f (x, ω)‖ₑ ^ a * mixedMaximal w (x, ω)) ∂ν :=
      lintegral_const_mul' _ _ (fsKwPow_ne_top n a)
    _ = fsKwPow n a * ∫⁻ x, ∫⁻ ω, ‖f (x, ω)‖ₑ ^ a * mixedMaximal w (x, ω) ∂ν := by
      congr 1
      exact lintegral_lintegral_swap
        ((((hf.enorm.pow_const a).mul hMw).comp measurable_swap).aemeasurable)

lemma fs_conjExponent_lt {r t : ℝ} (hr : 1 < r) (hrt : r < t) :
    Real.conjExponent t < Real.conjExponent r := by
  have ht : 1 < t := hr.trans hrt
  have hrq := Real.HolderConjugate.conjExponent hr
  have htq := Real.HolderConjugate.conjExponent ht
  rw [hrq.conjugate_eq, htq.conjugate_eq]
  apply (div_lt_div_iff₀ htq.sub_one_pos hrq.sub_one_pos).mpr
  nlinarith

/-- A second weighted duality argument handles the outer exponent below the inner one. -/
def fsLowerConst (n : ℕ) (p s a : ℝ) : ℝ≥0∞ :=
  (fsKwPow n a * fsUpperConst n (Real.conjExponent (p / a))
    (Real.conjExponent (s / a))) ^ (1 / a)

lemma fsLowerConst_ne_top (n : ℕ) {p s a : ℝ}
    (ha : 1 < a) (hap : a < p) (hps : p < s) : fsLowerConst n p s a ≠ ∞ := by
  have ha0 : 0 < a := by linarith
  have hr : 1 < p / a := (lt_div_iff₀ ha0).mpr (by simpa)
  have hrt : p / a < s / a := div_lt_div_of_pos_right hps ha0
  have ht := Real.HolderConjugate.conjExponent (hr.trans hrt)
  exact ENNReal.rpow_ne_top_of_nonneg (by positivity) (ENNReal.mul_ne_top
    (fsKwPow_ne_top n a) (fsUpperConst_ne_top n ht.symm.lt (fs_conjExponent_lt hr hrt)))

theorem fs_mixedENorm_of_gt {n : ℕ} {Ω E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (ν : Measure Ω) [IsFiniteMeasure ν] {p s a : ℝ}
    (ha : 1 < a) (hap : a < p) (hps : p < s)
    {f : EuclideanSpace ℝ (Fin n) × Ω → E} (hf : Measurable f) :
    mixedENorm volume ν p s (mixedMaximal f) ≤
      fsLowerConst n p s a * mixedENorm volume ν p s (fun z => ‖f z‖ₑ) := by
  have ha0 : 0 < a := by linarith
  have hp0 : 0 < p := by linarith
  have hs0 : 0 < s := by linarith
  let r := p / a
  let t := s / a
  have hr : 1 < r := (lt_div_iff₀ ha0).mpr (by simpa)
  have hrt : r < t := div_lt_div_of_pos_right hps ha0
  have hrq : r.HolderConjugate (Real.conjExponent r) := .conjExponent hr
  have htq : t.HolderConjugate (Real.conjExponent t) := .conjExponent (hr.trans hrt)
  have hbound : mixedENorm volume ν r t (fun z => mixedMaximal f z ^ a) ≤
      (fsKwPow n a * fsUpperConst n (Real.conjExponent r) (Real.conjExponent t)) *
        mixedENorm volume ν r t (fun z => ‖f z‖ₑ ^ a) := by
    apply mixedENorm_le_of_test ν hrq htq _ ((measurable_mixedMaximal hf).pow_const a)
    intro w hw
    have hhold := mixed_holder volume ν hrq htq (fun z => ‖f z‖ₑ ^ a) (mixedMaximal w)
      (hf.enorm.pow_const a) (measurable_mixedMaximal hw)
    have hMw := fs_mixedENorm_of_lt ν htq.symm.lt (fs_conjExponent_lt hr hrt) hw
    calc (∫⁻ x, ∫⁻ ω, mixedMaximal f (x, ω) ^ a * ‖w (x, ω)‖ₑ ∂ν)
        ≤ fsKwPow n a * ∫⁻ x, ∫⁻ ω, ‖f (x, ω)‖ₑ ^ a * mixedMaximal w (x, ω) ∂ν :=
          fs_pair_weighted ν ha hf w hw
      _ ≤ fsKwPow n a * (mixedENorm volume ν r t (fun z => ‖f z‖ₑ ^ a) *
          mixedENorm volume ν (Real.conjExponent r) (Real.conjExponent t) (mixedMaximal w)) :=
        mul_le_mul_right hhold _
      _ ≤ fsKwPow n a * (mixedENorm volume ν r t (fun z => ‖f z‖ₑ ^ a) *
          (fsUpperConst n (Real.conjExponent r) (Real.conjExponent t) *
            mixedENorm volume ν (Real.conjExponent r) (Real.conjExponent t)
              (fun z => ‖w z‖ₑ))) := mul_le_mul_right (mul_le_mul_right hMw _) _
      _ = _ := by ring
  dsimp only [r, t] at hbound
  rw [mixedENorm_rpow_scale volume ν hp0 hs0 ha0 (mixedMaximal f),
    mixedENorm_rpow_scale volume ν hp0 hs0 ha0 (fun z => ‖f z‖ₑ)] at hbound
  have hfinal := ENNReal.rpow_le_rpow hbound (one_div_pos.mpr ha0).le
  rw [← ENNReal.rpow_mul, mul_one_div_cancel ha0.ne', ENNReal.rpow_one,
    ENNReal.mul_rpow_of_nonneg _ _ (one_div_pos.mpr ha0).le,
    ← ENNReal.rpow_mul, mul_one_div_cancel ha0.ne', ENNReal.rpow_one] at hfinal
  exact hfinal

theorem fs_mixedENorm_same {n : ℕ} {Ω E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (ν : Measure Ω) [SFinite ν] {p : ℝ} (hp : 1 < p)
    {f : EuclideanSpace ℝ (Fin n) × Ω → E} (hf : Measurable f) :
    mixedENorm volume ν p p (mixedMaximal f) ≤
      fsKwPow n p ^ (1 / p) * mixedENorm volume ν p p (fun z => ‖f z‖ₑ) := by
  have hp0 : 0 < p := by linarith
  have h := fs_mixed_weighted ν hp hf (fun _ => 1) measurable_const
  simp only [enorm_one, one_mul] at h
  have hm (x : EuclideanSpace ℝ (Fin n)) :
      hlMaximal volume (fun _ : EuclideanSpace ℝ (Fin n) => (1 : ℝ)) x ≤ 1 :=
    hlMaximal_le_of_ae_enorm_le (ae_of_all _ fun _ => by simp) x
  have h' := h.trans (mul_le_mul_right (lintegral_mono fun x =>
    (mul_le_mul_left (hm x) _).trans_eq (one_mul _)) _)
  have hnorm := ENNReal.rpow_le_rpow h' (one_div_pos.mpr hp0).le
  simpa only [mixedENorm, div_self hp0.ne', ENNReal.rpow_one,
    ENNReal.mul_rpow_of_nonneg _ _ (one_div_pos.mpr hp0).le] using hnorm

/-- A finite constant depending only on Euclidean dimension and the two exponents. -/
def fsMixedConst (n : ℕ) (p s : ℝ) : ℝ≥0∞ :=
  if s < p then fsUpperConst n p s else
    if p = s then fsKwPow n p ^ (1 / p) else fsLowerConst n p s ((1 + p) / 2)

lemma fsMixedConst_ne_top (n : ℕ) {p s : ℝ} (hp : 1 < p) (hs : 1 < s) :
    fsMixedConst n p s ≠ ∞ := by
  unfold fsMixedConst
  split_ifs with hsp heq
  · exact fsUpperConst_ne_top n hs hsp
  · exact ENNReal.rpow_ne_top_of_nonneg (by positivity) (fsKwPow_ne_top n p)
  · have hps : p < s := lt_of_le_of_ne (not_lt.mp hsp) heq
    exact fsLowerConst_ne_top n (by linarith) (by linarith) hps

/-- **Fefferman–Stein vector maximal inequality**, for every `1 < p,s < ∞` and
every finite inner measure space. The maximal function acts only in `ℝ^n`, and
the constant is independent of the inner space and the function.
Reference: Fefferman–Stein, *Some maximal inequalities* (1971), pp. 107–115.
This integral formulation permits either mixed norm to be infinite. -/
theorem feffermanStein_mixed {n : ℕ} {Ω E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (ν : Measure Ω) [IsFiniteMeasure ν] {p s : ℝ} (hp : 1 < p) (hs : 1 < s)
    {f : EuclideanSpace ℝ (Fin n) × Ω → E} (hf : Measurable f) :
    mixedENorm volume ν p s (mixedMaximal f) ≤
      fsMixedConst n p s * mixedENorm volume ν p s (fun z => ‖f z‖ₑ) := by
  unfold fsMixedConst
  split_ifs with hsp heq
  · exact fs_mixedENorm_of_lt ν hs hsp hf
  · subst s
    exact fs_mixedENorm_same ν hp hf
  · have hps : p < s := lt_of_le_of_ne (not_lt.mp hsp) heq
    exact fs_mixedENorm_of_gt ν (by linarith) (by linarith) hps hf
end

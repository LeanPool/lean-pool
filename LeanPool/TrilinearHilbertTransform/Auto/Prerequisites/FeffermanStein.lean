/-! ### Elementary power integrals on the half-line -/

/-- `∫_0^u t^(r-1) dt = u^r / r` for `r > 0`, written with an indicator on `(0, ∞)`. -/
theorem lintegral_Ioi_indicator_Iio_rpow {u r : ℝ} (hu : 0 ≤ u) (hr : 0 < r) :
    ∫⁻ t in Ioi (0 : ℝ), (Iio u).indicator (fun t => ENNReal.ofReal (t ^ (r - 1))) t =
      ENNReal.ofReal (u ^ r / r) := by
  rw [lintegral_indicator measurableSet_Iio, Measure.restrict_restrict measurableSet_Iio,
    Set.inter_comm, Ioi_inter_Iio, setLIntegral_congr Ioo_ae_eq_Ioc]
  have hpow : -1 < r - 1 := by linarith
  have hinterval : IntervalIntegrable (fun t : ℝ => t ^ (r - 1)) volume 0 u :=
    intervalIntegral.intervalIntegrable_rpow' hpow
  have hIoc : IntegrableOn (fun t : ℝ => t ^ (r - 1)) (Ioc 0 u) volume :=
    (intervalIntegrable_iff_integrableOn_Ioc_of_le hu).mp hinterval
  have hnonneg : 0 ≤ᵐ[volume.restrict (Ioc 0 u)] (fun t : ℝ => t ^ (r - 1)) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    exact Real.rpow_nonneg ht.1.le _
  rw [← ofReal_integral_eq_lintegral_ofReal hIoc hnonneg, ← intervalIntegral.integral_of_le hu,
    integral_rpow (Or.inl hpow)]
  rw [show r - 1 + 1 = r by ring, Real.zero_rpow hr.ne']
  simp

/-- `∫_u^∞ t^(-r-1) dt = u^(-r) / r` for `u > 0`, `r > 0`, written with an indicator on
`(0, ∞)`. -/
theorem lintegral_Ioi_indicator_Ici_rpow {u r : ℝ} (hu : 0 < u) (hr : 0 < r) :
    ∫⁻ t in Ioi (0 : ℝ), (Ici u).indicator (fun t => ENNReal.ofReal (t ^ (-r - 1))) t =
      ENNReal.ofReal (u ^ (-r) / r) := by
  rw [lintegral_indicator measurableSet_Ici, Measure.restrict_restrict measurableSet_Ici]
  have hinter : Ici u ∩ Ioi (0 : ℝ) = Ici u :=
    inter_eq_left.mpr fun t ht => hu.trans_le ht
  rw [hinter, ← setLIntegral_congr Ioi_ae_eq_Ici]
  have hpow : -r - 1 < -1 := by linarith
  have hIoi : IntegrableOn (fun t : ℝ => t ^ (-r - 1)) (Ioi u) volume :=
    integrableOn_Ioi_rpow_of_lt hpow hu
  have hnonneg : 0 ≤ᵐ[volume.restrict (Ioi u)] (fun t : ℝ => t ^ (-r - 1)) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact Real.rpow_nonneg (hu.trans ht).le _
  rw [← ofReal_integral_eq_lintegral_ofReal hIoi hnonneg, integral_Ioi_rpow_of_lt hpow hu]
  rw [show -r - 1 + 1 = -r by ring]
  congr 1
  field_simp

/-! ### Tonelli for the truncation integrals -/

section Tonelli

variable {α : Type*} [MeasurableSpace α] {μ : Measure α}

/-- Exchange of the `t`-integral over `(0, ∞)` and the space integral for integrands supported
on a measurable subset `S` of `ℝ × α` (Tonelli). -/
theorem lintegral_Ioi_mul_lintegral_indicator_swap [SFinite μ] (S : Set (ℝ × α))
    (hS : MeasurableSet S) (w : ℝ → ℝ≥0∞) (hw : Measurable w) (v : α → ℝ≥0∞)
    (hv : Measurable v) :
    ∫⁻ t in Ioi (0 : ℝ), w t * ∫⁻ x, S.indicator (fun z => v z.2) (t, x) ∂μ =
      ∫⁻ x, v x * (∫⁻ t in Ioi (0 : ℝ), S.indicator (fun z => w z.1) (t, x)) ∂μ := by
  have hF : Measurable (S.indicator (fun z : ℝ × α => w z.1 * v z.2)) :=
    ((hw.comp measurable_fst).mul (hv.comp measurable_snd)).indicator hS
  have h1 : ∀ t, w t * ∫⁻ x, S.indicator (fun z => v z.2) (t, x) ∂μ =
      ∫⁻ x, S.indicator (fun z : ℝ × α => w z.1 * v z.2) (t, x) ∂μ := by
    intro t
    have hm : Measurable fun x => S.indicator (fun z : ℝ × α => v z.2) (t, x) :=
      ((hv.comp measurable_snd).indicator hS).comp measurable_prodMk_left
    rw [← lintegral_const_mul _ hm]
    congr 1
    funext x
    by_cases h : (t, x) ∈ S <;> simp [h]
  have h2 : ∀ x, v x * ∫⁻ t in Ioi (0 : ℝ), S.indicator (fun z => w z.1) (t, x) =
      ∫⁻ t in Ioi (0 : ℝ), S.indicator (fun z : ℝ × α => w z.1 * v z.2) (t, x) := by
    intro x
    have hm : Measurable fun t => S.indicator (fun z : ℝ × α => w z.1) (t, x) :=
      ((hw.comp measurable_fst).indicator hS).comp measurable_prodMk_right
    rw [← lintegral_const_mul _ hm]
    congr 1
    funext t
    by_cases h : (t, x) ∈ S <;> simp [h, mul_comm]
  simp_rw [h1, h2]
  exact lintegral_lintegral_swap hF.aemeasurable

/-- Measurability in `t` of the truncated space integrals. -/
theorem measurable_lintegral_indicator_section [SFinite μ] (S : Set (ℝ × α))
    (hS : MeasurableSet S) (v : α → ℝ≥0∞) (hv : Measurable v) :
    Measurable fun t : ℝ => ∫⁻ x, S.indicator (fun z => v z.2) (t, x) ∂μ :=
  ((hv.comp measurable_snd).indicator hS).lintegral_prod_right'

/-- The low-truncation Tonelli identity:
`∫_0^∞ t^(r-1) ∫_{c t < φ} φ^q dμ dt = (c^(-r)/r) ∫ φ^(q+r) dμ`. -/
theorem lintegral_Ioi_rpow_mul_lintegral_indicator_lt [SFinite μ] (φ : α → ℝ)
    (hφ : Measurable φ) (hφ0 : ∀ x, 0 ≤ φ x) {c q r : ℝ} (hc : 0 < c) (hq : 0 ≤ q)
    (hr : 0 < r) :
    ∫⁻ t in Ioi (0 : ℝ), ENNReal.ofReal (t ^ (r - 1)) *
        ∫⁻ x, {x | c * t < φ x}.indicator (fun x => ENNReal.ofReal (φ x) ^ q) x ∂μ =
      ENNReal.ofReal (c ^ (-r) / r) * ∫⁻ x, ENNReal.ofReal (φ x) ^ (q + r) ∂μ := by
  have hS : MeasurableSet {z : ℝ × α | c * z.1 < φ z.2} :=
    measurableSet_lt (measurable_const.mul measurable_fst) (hφ.comp measurable_snd)
  have hw : Measurable fun t : ℝ => ENNReal.ofReal (t ^ (r - 1)) :=
    (measurable_id.pow_const _).ennreal_ofReal
  have hv : Measurable fun x => ENNReal.ofReal (φ x) ^ q := hφ.ennreal_ofReal.pow_const q
  have key := lintegral_Ioi_mul_lintegral_indicator_swap (μ := μ) _ hS _ hw _ hv
  refine key.trans ?_
  rw [← lintegral_const_mul _ (hφ.ennreal_ofReal.pow_const _)]
  refine lintegral_congr fun x => ?_
  have hsec : (fun t => {z : ℝ × α | c * z.1 < φ z.2}.indicator
      (fun z => ENNReal.ofReal (z.1 ^ (r - 1))) (t, x)) =
      (Iio (φ x / c)).indicator (fun t => ENNReal.ofReal (t ^ (r - 1))) := by
    funext t
    simp only [Set.indicator_apply, mem_ofPred_eq, mem_Iio, lt_div_iff₀ hc, mul_comm c]
  rw [hsec, lintegral_Ioi_indicator_Iio_rpow (div_nonneg (hφ0 x) hc.le) hr]
  have hreal : (φ x / c) ^ r / r = c ^ (-r) / r * φ x ^ r := by
    rw [Real.div_rpow (hφ0 x) hc.le, Real.rpow_neg hc.le]
    field_simp
  rw [hreal, ENNReal.ofReal_mul (div_nonneg (Real.rpow_nonneg hc.le _) hr.le),
    ← ENNReal.ofReal_rpow_of_nonneg (hφ0 x) hr.le,
    ENNReal.rpow_add_of_nonneg _ _ hq hr.le]
  ring

/-- The high-truncation Tonelli identity:
`∫_0^∞ t^(-r-1) ∫_{φ ≤ c t} φ^q dμ dt = (c^r/r) ∫ φ^(q-r) dμ` for `0 < r < q`. -/
theorem lintegral_Ioi_rpow_mul_lintegral_indicator_le [SFinite μ] (φ : α → ℝ)
    (hφ : Measurable φ) (hφ0 : ∀ x, 0 ≤ φ x) {c q r : ℝ} (hc : 0 < c) (hq : 0 < q)
    (hr : 0 < r) (hrq : r < q) :
    ∫⁻ t in Ioi (0 : ℝ), ENNReal.ofReal (t ^ (-r - 1)) *
        ∫⁻ x, {x | φ x ≤ c * t}.indicator (fun x => ENNReal.ofReal (φ x) ^ q) x ∂μ =
      ENNReal.ofReal (c ^ r / r) * ∫⁻ x, ENNReal.ofReal (φ x) ^ (q - r) ∂μ := by
  have hS : MeasurableSet {z : ℝ × α | φ z.2 ≤ c * z.1} :=
    measurableSet_le (hφ.comp measurable_snd) (measurable_const.mul measurable_fst)
  have hw : Measurable fun t : ℝ => ENNReal.ofReal (t ^ (-r - 1)) :=
    (measurable_id.pow_const _).ennreal_ofReal
  have hv : Measurable fun x => ENNReal.ofReal (φ x) ^ q := hφ.ennreal_ofReal.pow_const q
  have key := lintegral_Ioi_mul_lintegral_indicator_swap (μ := μ) _ hS _ hw _ hv
  refine key.trans ?_
  rw [← lintegral_const_mul _ (hφ.ennreal_ofReal.pow_const _)]
  refine lintegral_congr fun x => ?_
  rcases (hφ0 x).eq_or_lt with h0 | hpos
  · rw [← h0]
    simp [ENNReal.zero_rpow_of_pos hq, ENNReal.zero_rpow_of_pos (sub_pos.mpr hrq)]
  have hsec : (fun t => {z : ℝ × α | φ z.2 ≤ c * z.1}.indicator
      (fun z => ENNReal.ofReal (z.1 ^ (-r - 1))) (t, x)) =
      (Ici (φ x / c)).indicator (fun t => ENNReal.ofReal (t ^ (-r - 1))) := by
    funext t
    simp only [Set.indicator_apply, mem_ofPred_eq, mem_Ici, div_le_iff₀ hc, mul_comm c]
  rw [hsec, lintegral_Ioi_indicator_Ici_rpow (div_pos hpos hc) hr]
  have hreal : (φ x / c) ^ (-r) / r = c ^ r / r * φ x ^ (-r) := by
    rw [Real.div_rpow (hφ0 x) hc.le, Real.rpow_neg hc.le]
    field_simp
  have hne : ENNReal.ofReal (φ x) ≠ 0 := by simpa using hpos
  rw [hreal, ENNReal.ofReal_mul (div_nonneg (Real.rpow_nonneg hc.le _) hr.le),
    ← ENNReal.ofReal_rpow_of_pos hpos, sub_eq_add_neg,
    ENNReal.rpow_add _ _ hne ENNReal.ofReal_ne_top]
  ring

end Tonelli

/-! ### From a split distributional bound to an `Lᵖ` bound -/

section Split

variable {α β E F : Type*} [MeasurableSpace α] [MeasurableSpace β] {μ : Measure α}
  {ν : Measure β} [NormedAddCommGroup E] [NormedAddCommGroup F]

/-- The core of the real interpolation argument. If the distribution function of `g` at every
height `t > 0` is controlled by `K₁ t^(-a) ∫_{‖f‖ > c t} ‖f‖^a + K₂ t^(-b) ∫_{‖f‖ ≤ c t} ‖f‖^b`,
then `∫ ‖g‖^p ≤ p (K₁ c^(a-p)/(p-a) + K₂ c^(b-p)/(b-p)) ∫ ‖f‖^p` for `0 < a < p < b`
(layer-cake formula followed by Tonelli). -/
theorem lintegral_rpow_enorm_le_of_distribution_split [SFinite μ] {g : β → F}
    (hg : AEStronglyMeasurable g ν) {f : α → E} (hf : AEStronglyMeasurable f μ)
    {a b p c K₁ K₂ : ℝ} (ha : 0 < a) (hap : a < p) (hpb : p < b) (hc : 0 < c)
    (hK₁ : 0 ≤ K₁) (hK₂ : 0 ≤ K₂)
    (hsplit : ∀ t : ℝ, 0 < t → ν {x | t < ‖g x‖} ≤
      ENNReal.ofReal K₁ * ENNReal.ofReal (t ^ (-a)) *
          ∫⁻ x, ‖{y | c * t < ‖f y‖}.indicator f x‖ₑ ^ a ∂μ +
        ENNReal.ofReal K₂ * ENNReal.ofReal (t ^ (-b)) *
          ∫⁻ x, ‖{y | ‖f y‖ ≤ c * t}.indicator f x‖ₑ ^ b ∂μ) :
    ∫⁻ x, ‖g x‖ₑ ^ p ∂ν ≤
      ENNReal.ofReal (p * (K₁ * c ^ (a - p) / (p - a) + K₂ * c ^ (b - p) / (b - p))) *
        ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
  have hp : 0 < p := ha.trans hap
  have hb : 0 < b := hp.trans hpb
  -- a measurable nonnegative version `φ` of `‖f‖`
  have ψ : AEMeasurable (fun x => ‖f x‖) μ := hf.norm.aemeasurable
  set! φ : α → ℝ := fun x => max (ψ.mk _ x) 0 with hφdef
  have hφm : Measurable φ := ψ.measurable_mk.max measurable_const
  have hφ0 : ∀ x, 0 ≤ φ x := fun x => le_max_right _ _
  have hφae : ∀ᵐ x ∂μ, φ x = ‖f x‖ := by
    filter_upwards [ψ.ae_eq_mk] with x hx
    simp only [hφdef, ← hx, max_eq_left (norm_nonneg _)]
  have hJ₁ : ∀ t : ℝ, ∫⁻ x, ‖{y | c * t < ‖f y‖}.indicator f x‖ₑ ^ a ∂μ =
      ∫⁻ x, {x | c * t < φ x}.indicator (fun x => ENNReal.ofReal (φ x) ^ a) x ∂μ := by
    intro t
    refine lintegral_congr_ae ?_
    filter_upwards [hφae] with x hx
    by_cases h : c * t < ‖f x‖
    · have h' : c * t < φ x := hx ▸ h
      simp [h, hx]
    · have h' : ¬ c * t < φ x := hx ▸ h
      simp [h, h', ENNReal.zero_rpow_of_pos ha]
  have hJ₂ : ∀ t : ℝ, ∫⁻ x, ‖{y | ‖f y‖ ≤ c * t}.indicator f x‖ₑ ^ b ∂μ =
      ∫⁻ x, {x | φ x ≤ c * t}.indicator (fun x => ENNReal.ofReal (φ x) ^ b) x ∂μ := by
    intro t
    refine lintegral_congr_ae ?_
    filter_upwards [hφae] with x hx
    by_cases h : ‖f x‖ ≤ c * t
    · have h' : φ x ≤ c * t := hx ▸ h
      simp [h, hx]
    · have h' : ¬ φ x ≤ c * t := hx ▸ h
      simp [h, h', ENNReal.zero_rpow_of_pos hb]
  have hIf : ∫⁻ x, ENNReal.ofReal (φ x) ^ p ∂μ = ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
    refine lintegral_congr_ae ?_
    filter_upwards [hφae] with x hx
    simp [hx]
  -- measurability of the two truncated integrals in `t`
  have hS₁ : MeasurableSet {z : ℝ × α | c * z.1 < φ z.2} :=
    measurableSet_lt (measurable_const.mul measurable_fst) (hφm.comp measurable_snd)
  have hS₂ : MeasurableSet {z : ℝ × α | φ z.2 ≤ c * z.1} :=
    measurableSet_le (hφm.comp measurable_snd) (measurable_const.mul measurable_fst)
  have hm₁ : Measurable fun t : ℝ =>
      ∫⁻ x, {x | c * t < φ x}.indicator (fun x => ENNReal.ofReal (φ x) ^ a) x ∂μ :=
    measurable_lintegral_indicator_section (μ := μ) _ hS₁ _ (hφm.ennreal_ofReal.pow_const a)
  have hm₂ : Measurable fun t : ℝ =>
      ∫⁻ x, {x | φ x ≤ c * t}.indicator (fun x => ENNReal.ofReal (φ x) ^ b) x ∂μ :=
    measurable_lintegral_indicator_section (μ := μ) _ hS₂ _ (hφm.ennreal_ofReal.pow_const b)
  -- layer cake
  have hlc := lintegral_rpow_eq_lintegral_meas_lt_mul ν (f := fun x => ‖g x‖)
    (ae_of_all _ fun x => norm_nonneg _) hg.norm.aemeasurable hp
  have hlhs : ∫⁻ x, ‖g x‖ₑ ^ p ∂ν = ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ p) ∂ν := by
    refine lintegral_congr fun x => ?_
    rw [← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp.le, ofReal_norm]
  rw [hlhs, hlc]
  calc ENNReal.ofReal p * ∫⁻ t in Ioi (0 : ℝ), ν {x | t < ‖g x‖} * ENNReal.ofReal (t ^ (p - 1))
      ≤ ENNReal.ofReal p * ∫⁻ t in Ioi (0 : ℝ),
          (ENNReal.ofReal K₁ * (ENNReal.ofReal (t ^ ((p - a) - 1)) *
            ∫⁻ x, {x | c * t < φ x}.indicator (fun x => ENNReal.ofReal (φ x) ^ a) x ∂μ) +
          ENNReal.ofReal K₂ * (ENNReal.ofReal (t ^ (-(b - p) - 1)) *
            ∫⁻ x, {x | φ x ≤ c * t}.indicator (fun x => ENNReal.ofReal (φ x) ^ b) x ∂μ)) := by
        gcongr ENNReal.ofReal p * ?_
        refine setLIntegral_mono' measurableSet_Ioi fun t ht => ?_
        have ht : (0 : ℝ) < t := ht
        have e₁ : ENNReal.ofReal (t ^ (-a)) * ENNReal.ofReal (t ^ (p - 1)) =
            ENNReal.ofReal (t ^ ((p - a) - 1)) := by
          rw [← ENNReal.ofReal_mul (Real.rpow_nonneg ht.le _), ← Real.rpow_add ht]
          ring_nf
        have e₂ : ENNReal.ofReal (t ^ (-b)) * ENNReal.ofReal (t ^ (p - 1)) =
            ENNReal.ofReal (t ^ (-(b - p) - 1)) := by
          rw [← ENNReal.ofReal_mul (Real.rpow_nonneg ht.le _), ← Real.rpow_add ht]
          ring_nf
        calc ν {x | t < ‖g x‖} * ENNReal.ofReal (t ^ (p - 1))
            ≤ (ENNReal.ofReal K₁ * ENNReal.ofReal (t ^ (-a)) *
                  ∫⁻ x, ‖{y | c * t < ‖f y‖}.indicator f x‖ₑ ^ a ∂μ +
                ENNReal.ofReal K₂ * ENNReal.ofReal (t ^ (-b)) *
                  ∫⁻ x, ‖{y | ‖f y‖ ≤ c * t}.indicator f x‖ₑ ^ b ∂μ) *
                ENNReal.ofReal (t ^ (p - 1)) := by
              gcongr
              exact hsplit t ht
          _ = _ := by
              rw [hJ₁, hJ₂, ← e₁, ← e₂]
              ring
    _ = ENNReal.ofReal p * (ENNReal.ofReal K₁ * (ENNReal.ofReal (c ^ (-(p - a)) / (p - a)) *
            ∫⁻ x, ENNReal.ofReal (φ x) ^ (a + (p - a)) ∂μ) +
          ENNReal.ofReal K₂ * (ENNReal.ofReal (c ^ (b - p) / (b - p)) *
            ∫⁻ x, ENNReal.ofReal (φ x) ^ (b - (b - p)) ∂μ)) := by
        rw [lintegral_add_left, lintegral_const_mul, lintegral_const_mul,
          lintegral_Ioi_rpow_mul_lintegral_indicator_lt φ hφm hφ0 hc ha.le (sub_pos.mpr hap),
          lintegral_Ioi_rpow_mul_lintegral_indicator_le φ hφm hφ0 hc hb (sub_pos.mpr hpb)
            (by linarith)]
        · exact ((measurable_id.pow_const _).ennreal_ofReal).mul hm₂
        · exact ((measurable_id.pow_const _).ennreal_ofReal).mul hm₁
        · exact measurable_const.mul (((measurable_id.pow_const _).ennreal_ofReal).mul hm₁)
    _ = _ := by
        rw [add_sub_cancel, sub_sub_cancel, hIf, ENNReal.ofReal_mul hp.le,
          ENNReal.ofReal_add (div_nonneg (mul_nonneg hK₁ (Real.rpow_nonneg hc.le _))
            (sub_pos.mpr hap).le) (div_nonneg (mul_nonneg hK₂ (Real.rpow_nonneg hc.le _))
            (sub_pos.mpr hpb).le),
          mul_div_assoc, mul_div_assoc, ENNReal.ofReal_mul hK₁, ENNReal.ofReal_mul hK₂, neg_sub]
        ring

end Split

/-! ### Distribution functions, weak type, sublinearity -/

section Defs

variable {α β E F : Type*} [MeasurableSpace α] [MeasurableSpace β] [NormedAddCommGroup E]
  [NormedAddCommGroup F]

/-- The distribution function `t ↦ ν {x | t < ‖g x‖}` of `g : β → F`, with `t : ℝ≥0∞`. -/
def distributionFunction (g : β → F) (t : ℝ≥0∞) (ν : Measure β) : ℝ≥0∞ :=
  ν {x | t < ‖g x‖ₑ}

/-- `T` is of weak type `(a, a)` with constant `A` on the class of inputs `D`:
`ν {‖T f‖ > t} ≤ (A ‖f‖_{L^a(μ)} / t)^a` for all `f ∈ D` and all `t > 0`. -/
def HasWeakTypeOn (T : (α → E) → β → F) (D : Set (α → E)) (a : ℝ) (A : ℝ≥0)
    (μ : Measure α) (ν : Measure β) : Prop :=
  ∀ f ∈ D, ∀ t : ℝ≥0∞, 0 < t →
    distributionFunction (T f) t ν ≤ ((A : ℝ≥0∞) * eLpNorm f (ENNReal.ofReal a) μ / t) ^ a

/-- The `L^∞` endpoint hypothesis with constant `B`: if `‖f x‖ ≤ s` for every `x`, then
`‖T f y‖ ≤ B s` for `ν`-almost every `y` (for `f ∈ D`). -/
def HasLinftyBoundOn (T : (α → E) → β → F) (D : Set (α → E)) (B : ℝ≥0) (ν : Measure β) :
    Prop :=
  ∀ f ∈ D, ∀ s : ℝ, (∀ x, ‖f x‖ ≤ s) → ∀ᵐ y ∂ν, ‖T f y‖ ≤ B * s

/-- `T` is subadditive in pointwise norm on `D`: `‖T (f + g)‖ ≤ ‖T f‖ + ‖T g‖` `ν`-a.e. -/
def IsSublinearOn (T : (α → E) → β → F) (D : Set (α → E)) (ν : Measure β) : Prop :=
  ∀ f ∈ D, ∀ g ∈ D, ∀ᵐ x ∂ν, ‖T (f + g) x‖ ≤ ‖T f x‖ + ‖T g x‖

/-- `D` is closed under the two truncations `f 𝟙_{‖f‖ > s}` and `f 𝟙_{‖f‖ ≤ s}`, `s > 0`, used
in the proof of the Marcinkiewicz interpolation theorem. -/
def IsTruncationClosed (D : Set (α → E)) : Prop :=
  ∀ f ∈ D, ∀ s : ℝ, 0 < s →
    {x | s < ‖f x‖}.indicator f ∈ D ∧ {x | ‖f x‖ ≤ s}.indicator f ∈ D

variable {μ : Measure α} {ν : Measure β}

/-- The distribution function at a real height. -/
theorem distributionFunction_ofReal (g : β → F) {t : ℝ} (ht : 0 ≤ t) :
    distributionFunction g (ENNReal.ofReal t) ν = ν {x | t < ‖g x‖} := by
  unfold distributionFunction
  congr 1
  ext x
  simp only [mem_ofPred_eq, ← ofReal_norm, ENNReal.ofReal_lt_ofReal_iff_of_nonneg ht]

/-- `‖f‖_{L^p}^p = ∫ ‖f‖^p` for `0 < p < ∞` and a.e. strongly measurable `f`. -/
theorem eLpNorm_ofReal_rpow_eq_lintegral {f : α → E} (hf : AEStronglyMeasurable f μ) {p : ℝ}
    (hp : 0 < p) :
    eLpNorm f (ENNReal.ofReal p) μ ^ p = ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hp) ENNReal.ofReal_ne_top hf,
    ENNReal.toReal_ofReal hp.le, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hp.ne',
    ENNReal.rpow_one]

/-- `‖f‖_{L^p} = (∫ ‖f‖^p)^(1/p)` for `0 < p < ∞` and a.e. strongly measurable `f`. -/
theorem eLpNorm_ofReal_eq_lintegral_rpow_enorm {f : α → E} (hf : AEStronglyMeasurable f μ) {p : ℝ}
    (hp : 0 < p) :
    eLpNorm f (ENNReal.ofReal p) μ = (∫⁻ x, ‖f x‖ₑ ^ p ∂μ) ^ (1 / p) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hp) ENNReal.ofReal_ne_top hf,
    ENNReal.toReal_ofReal hp.le]

end Defs

/-! ### Truncation and the split of the distribution function -/

section Truncation

variable {α β E F : Type*} [MeasurableSpace α] [MeasurableSpace β] [NormedAddCommGroup E]
  [NormedAddCommGroup F] {μ : Measure α} {ν : Measure β}

/-- The upper truncation `f 𝟙_{‖f‖ > s}` of an a.e. strongly measurable function is a.e.
strongly measurable. -/
theorem aestronglyMeasurable_indicator_lt_norm {f : α → E} (hf : AEStronglyMeasurable f μ)
    (s : ℝ) : AEStronglyMeasurable ({x | s < ‖f x‖}.indicator f) μ :=
  hf.indicator₀ (nullMeasurableSet_lt aemeasurable_const hf.norm.aemeasurable)

/-- The lower truncation `f 𝟙_{‖f‖ ≤ s}` of an a.e. strongly measurable function is a.e.
strongly measurable. -/
theorem aestronglyMeasurable_indicator_norm_le {f : α → E} (hf : AEStronglyMeasurable f μ)
    (s : ℝ) : AEStronglyMeasurable ({x | ‖f x‖ ≤ s}.indicator f) μ :=
  hf.indicator₀ (nullMeasurableSet_le hf.norm.aemeasurable aemeasurable_const)

omit [MeasurableSpace α] in
/-- The two truncations at height `s` add up to `f`. -/
theorem indicator_lt_norm_add_indicator_norm_le (f : α → E) (s : ℝ) :
    {x | s < ‖f x‖}.indicator f + {x | ‖f x‖ ≤ s}.indicator f = f := by
  funext x
  by_cases h : s < ‖f x‖
  · simp [h, not_le.mpr h]
  · simp [h, le_of_not_gt h]

omit [MeasurableSpace α] in
/-- Subadditivity splits the distribution function of `T f` at height `t` into those of the
truncations of `f` at height `s`, each at height `t / 2`. -/
theorem measure_lt_norm_le_of_isSublinearOn {T : (α → E) → β → F} {D : Set (α → E)}
    (hsub : IsSublinearOn T D ν) (hD : IsTruncationClosed D) {f : α → E} (hfD : f ∈ D)
    {s : ℝ} (hs : 0 < s) (t : ℝ) :
    ν {x | t < ‖T f x‖} ≤ ν {x | t / 2 < ‖T ({y | s < ‖f y‖}.indicator f) x‖} +
      ν {x | t / 2 < ‖T ({y | ‖f y‖ ≤ s}.indicator f) x‖} := by
  obtain ⟨h₁, h₂⟩ := hD f hfD s hs
  have hae := hsub _ h₁ _ h₂
  rw [indicator_lt_norm_add_indicator_norm_le] at hae
  refine (measure_mono_ae (hae.mono fun x hx hxt => ?_)).trans (measure_union_le _ _)
  have hxt' : t < ‖T f x‖ := hxt
  by_contra hc
  simp only [mem_union, mem_ofPred_eq, not_or, not_lt] at hc
  linarith [hc.1, hc.2]

/-- A weak-type `(a, a)` bound at height `t / 2`, written in the normalized form used in the
interpolation argument. -/
theorem HasWeakTypeOn.measure_half_lt_le {T : (α → E) → β → F} {D : Set (α → E)} {a : ℝ}
    {A : ℝ≥0} (h : HasWeakTypeOn T D a A μ ν) (ha : 0 < a) {g : α → E} (hgD : g ∈ D)
    (hg : AEStronglyMeasurable g μ) {t : ℝ} (ht : 0 < t) :
    ν {x | t / 2 < ‖T g x‖} ≤
      ENNReal.ofReal (2 ^ a * (A : ℝ) ^ a) * ENNReal.ofReal (t ^ (-a)) *
        ∫⁻ x, ‖g x‖ₑ ^ a ∂μ := by
  have ht2 : 0 < t / 2 := half_pos ht
  have hw := h g hgD (ENNReal.ofReal (t / 2)) (ENNReal.ofReal_pos.mpr ht2)
  rw [distributionFunction_ofReal _ ht2.le] at hw
  refine hw.trans (le_of_eq ?_)
  have e : (t / 2)⁻¹ ^ a = 2 ^ a * t ^ (-a) := by
    rw [inv_div, Real.div_rpow two_pos.le ht.le, Real.rpow_neg ht.le, div_eq_mul_inv]
  rw [div_eq_mul_inv, ← ENNReal.ofReal_inv_of_pos ht2, ENNReal.mul_rpow_of_nonneg _ _ ha.le,
    ENNReal.mul_rpow_of_nonneg _ _ ha.le, eLpNorm_ofReal_rpow_eq_lintegral hg ha,
    ENNReal.ofReal_rpow_of_nonneg (inv_nonneg.mpr ht2.le) ha.le, ← ENNReal.ofReal_coe_nnreal,
    ENNReal.ofReal_rpow_of_nonneg A.coe_nonneg ha.le, e,
    ENNReal.ofReal_mul (Real.rpow_nonneg two_pos.le _),
    ENNReal.ofReal_mul (Real.rpow_nonneg two_pos.le _)]
  ring

omit [MeasurableSpace α] in
/-- The `L^∞` endpoint hypothesis makes the distribution function of `T g` vanish at heights
above `B s`, for `‖g‖ ≤ s` everywhere. -/
theorem HasLinftyBoundOn.measure_lt_eq_zero {T : (α → E) → β → F} {D : Set (α → E)}
    {B : ℝ≥0} (h : HasLinftyBoundOn T D B ν) {g : α → E} (hgD : g ∈ D) {s t : ℝ}
    (hbound : ∀ x, ‖g x‖ ≤ s) (hBs : (B : ℝ) * s ≤ t) :
    ν {x | t < ‖T g x‖} = 0 := by
  refine measure_mono_null (fun x hx => ?_) (ae_iff.mp (h g hgD s hbound))
  have hx' : t < ‖T g x‖ := hx
  change ¬ ‖T g x‖ ≤ B * s
  intro hle
  linarith

end Truncation

/-! ### Constants -/

/-- The free-parameter constant `p 2^a A^a c^(a-p)/(p-a)` of the endpoint case `b = ∞`. -/
def marcinkiewiczBoundTop (a p : ℝ) (A : ℝ≥0) (c : ℝ) : ℝ≥0∞ :=
  ENNReal.ofReal (p * (2 ^ a * (A : ℝ) ^ a * c ^ (a - p) / (p - a)))

/-- `marcinkiewiczBoundTop` is finite. -/
theorem marcinkiewiczBoundTop_ne_top (a p : ℝ) (A : ℝ≥0) (c : ℝ) :
    marcinkiewiczBoundTop a p A c ≠ ∞ := ENNReal.ofReal_ne_top

/-! ### The Marcinkiewicz interpolation theorem -/

section Interpolation

variable {α β E F : Type*} [MeasurableSpace α] [MeasurableSpace β] [NormedAddCommGroup E]
  [NormedAddCommGroup F] {μ : Measure α} {ν : Measure β}

/-- **Marcinkiewicz interpolation with an `L^∞` endpoint, free truncation parameter** (the
endpoint estimate in the proof of Blueprint Lemma 2.3 (`lem:interpolation`)): if `T` is
subadditive on a truncation closed class `D`, of weak type `(a, a)` with constant `A`, and
`‖f‖ ≤ s` implies `‖T f‖ ≤ B s` a.e. (for `f ∈ D`), then for `0 < a < p`, every `c > 0` with
`B c ≤ 1/2` and every `f ∈ D`, `∫ ‖T f‖^p ≤ p 2^a A^a c^(a-p)/(p-a) ∫ ‖f‖^p`. -/
theorem lintegral_rpow_le_of_hasWeakTypeOn_of_linfty [SFinite μ] {T : (α → E) → β → F}
    {D : Set (α → E)} {a p c : ℝ} {A B : ℝ≥0} (ha : 0 < a) (hap : a < p) (hc : 0 < c)
    (hBc : (B : ℝ) * c ≤ 1 / 2) (hTA : HasWeakTypeOn T D a A μ ν)
    (hTB : HasLinftyBoundOn T D B ν) (hsub : IsSublinearOn T D ν) (hD : IsTruncationClosed D)
    {f : α → E} (hfD : f ∈ D) (hf : AEStronglyMeasurable f μ)
    (hTf : AEStronglyMeasurable (T f) ν) :
    ∫⁻ x, ‖T f x‖ₑ ^ p ∂ν ≤ marcinkiewiczBoundTop a p A c * ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
  have hsplit : ∀ t : ℝ, 0 < t → ν {x | t < ‖T f x‖} ≤
      ENNReal.ofReal (2 ^ a * (A : ℝ) ^ a) * ENNReal.ofReal (t ^ (-a)) *
          ∫⁻ x, ‖{y | c * t < ‖f y‖}.indicator f x‖ₑ ^ a ∂μ +
        ENNReal.ofReal 0 * ENNReal.ofReal (t ^ (-(p + 1))) *
          ∫⁻ x, ‖{y | ‖f y‖ ≤ c * t}.indicator f x‖ₑ ^ (p + 1) ∂μ := by
    intro t ht
    have hs : 0 < c * t := mul_pos hc ht
    obtain ⟨h₁, h₂⟩ := hD f hfD _ hs
    have hbound : ∀ x, ‖{y | ‖f y‖ ≤ c * t}.indicator f x‖ ≤ c * t := by
      intro x
      by_cases h : ‖f x‖ ≤ c * t
      · simp [h]
      · simp [h, hs.le]
    have hBs : (B : ℝ) * (c * t) ≤ t / 2 := by
      calc (B : ℝ) * (c * t) = (B * c) * t := by ring
        _ ≤ 1 / 2 * t := mul_le_mul_of_nonneg_right hBc ht.le
        _ = t / 2 := by ring
    have hz := hTB.measure_lt_eq_zero h₂ hbound hBs
    rw [ENNReal.ofReal_zero, zero_mul, zero_mul, add_zero]
    refine (measure_lt_norm_le_of_isSublinearOn hsub hD hfD hs t).trans ?_
    rw [hz, add_zero]
    exact hTA.measure_half_lt_le ha h₁ (aestronglyMeasurable_indicator_lt_norm hf _) ht
  refine (lintegral_rpow_enorm_le_of_distribution_split hTf hf ha hap (by linarith) hc
    (by positivity) le_rfl hsplit).trans_eq ?_
  rw [marcinkiewiczBoundTop, zero_mul, zero_div, add_zero]

end Interpolation

end

end Auto.ClassicalMaximal

namespace Auto.ClassicalMaximal

open MeasureTheory Metric Set Filter Topology
open scoped ENNReal NNReal

noncomputable section

section General

variable {X E : Type*} [PseudoMetricSpace X] [MeasurableSpace X] [NormedAddCommGroup E]
  {μ : Measure X}

/-- The average `μ(B(x,r))⁻¹ ∫_{B(x,r)} ‖f‖` of `‖f‖` over the closed ball `B(x,r)`, valued in
`ℝ≥0∞`. With the conventions of `ℝ≥0∞` it vanishes when `μ(B(x,r)) = 0` or `μ(B(x,r)) = ∞`
(in particular for `r < 0`). -/
def hlBallAverage (μ : Measure X) (f : X → E) (x : X) (r : ℝ) : ℝ≥0∞ :=
  (μ (closedBall x r))⁻¹ * ∫⁻ y in closedBall x r, ‖f y‖ₑ ∂μ

/-- The centered Hardy–Littlewood maximal function over closed balls,
`M f(x) = sup_r μ(B(x,r))⁻¹ ∫_{B(x,r)} ‖f‖`, valued in `ℝ≥0∞`. Radii `r < 0` and balls of measure
`0` or `∞` contribute `0`; the radius `r = 0` (the ball `B(x,0)`) is included. -/
def hlMaximal (μ : Measure X) (f : X → E) (x : X) : ℝ≥0∞ :=
  ⨆ r : ℝ, hlBallAverage μ f x r

theorem hlBallAverage_le_hlMaximal (μ : Measure X) (f : X → E) (x : X) (r : ℝ) :
    hlBallAverage μ f x r ≤ hlMaximal μ f x :=
  le_iSup (fun r => hlBallAverage μ f x r) r

omit [MeasurableSpace X] in
/-- A closed ball is contained in its threefold dilate. -/
theorem closedBall_subset_closedBall_three_mul (x : X) (r : ℝ) :
    closedBall x r ⊆ closedBall x (3 * r) := by
  rcases le_or_gt 0 r with hr | hr
  · exact closedBall_subset_closedBall (by linarith)
  · rw [closedBall_eq_empty.2 hr]
    exact empty_subset _

omit [MeasurableSpace X] in
/-- **Finite Vitali covering lemma, largest-first selection** (proof of Blueprint Lemma 2.4
(`lem:maximal`)): every finite family of closed balls `B(c i, r i)`, `i ∈ s`, has a pairwise
disjoint subfamily `S ⊆ s` such that every ball of the family is contained in the threefold
dilate `B(c j, 3 r j)` of a selected ball with `r i ≤ r j`. -/
theorem exists_disjoint_subfamily_closedBall_subset_three_mul {ι : Type*} (s : Finset ι)
    (c : ι → X) (r : ι → ℝ) :
    ∃ S ⊆ s, (S : Set ι).PairwiseDisjoint (fun i => closedBall (c i) (r i)) ∧
      ∀ i ∈ s, ∃ j ∈ S, r i ≤ r j ∧ closedBall (c i) (r i) ⊆ closedBall (c j) (3 * r j) := by
  classical
  induction s using Finset.strongInduction with
  | H s ih =>
  rcases s.eq_empty_or_nonempty with rfl | hs
  · exact ⟨∅, by simp, by simp, by simp⟩
  obtain ⟨i, his, hmax⟩ := s.exists_max_image r hs
  set s' := (s.erase i).filter
    (fun j => Disjoint (closedBall (c j) (r j)) (closedBall (c i) (r i))) with hs'def
  have hs' : s' ⊂ s := (Finset.filter_subset _ _).trans_ssubset (Finset.erase_ssubset his)
  obtain ⟨S', hS's, hS'disj, hS'cov⟩ := ih s' hs'
  refine ⟨insert i S', ?_, ?_, ?_⟩
  · exact Finset.insert_subset his
      (hS's.trans ((Finset.filter_subset _ _).trans (Finset.erase_subset _ _)))
  · rw [Finset.coe_insert]
    refine hS'disj.insert fun j hj _ => ?_
    exact ((Finset.mem_filter.1 (hS's hj)).2).symm
  · intro j hj
    by_cases hji : j = i
    · subst hji
      exact ⟨j, Finset.mem_insert_self _ _, le_rfl, closedBall_subset_closedBall_three_mul _ _⟩
    by_cases hd : Disjoint (closedBall (c j) (r j)) (closedBall (c i) (r i))
    · obtain ⟨k, hk, h1, h2⟩ :=
        hS'cov j (Finset.mem_filter.2 ⟨Finset.mem_erase.2 ⟨hji, hj⟩, hd⟩)
      exact ⟨k, Finset.mem_insert_of_mem hk, h1, h2⟩
    · refine ⟨i, Finset.mem_insert_self _ _, hmax j hj, ?_⟩
      obtain ⟨z, hz1, hz2⟩ := Set.not_disjoint_iff.1 hd
      intro y hy
      rw [mem_closedBall] at hy hz1 hz2 ⊢
      have hji' := hmax j hj
      calc dist y (c i) ≤ dist y (c j) + dist (c j) z + dist z (c i) := dist_triangle4 _ _ _ _
        _ ≤ r j + r j + r i := by
          rw [dist_comm (c j) z]
          gcongr
        _ ≤ 3 * r i := by linarith

variable [OpensMeasurableSpace X]

/-- **Finite covering estimate** (proof of Blueprint Lemma 2.4 (`lem:maximal`)): if `μ` satisfies
the doubling condition `μ(B(x,3r)) ≤ C μ(B(x,r))` and every ball of a finite family satisfies
`μ(B_i) ≤ t⁻¹ ∫_{B_i} ‖f‖`, then `μ(⋃ B_i) ≤ C t⁻¹ ∫ ‖f‖`. -/
theorem measure_biUnion_closedBall_le_of_doubling {C : ℝ≥0}
    (hC : ∀ (x : X) (r : ℝ), 0 ≤ r → μ (closedBall x (3 * r)) ≤ C * μ (closedBall x r))
    {ι : Type*} (s : Finset ι) (c : ι → X) (r : ι → ℝ) (hr : ∀ i ∈ s, 0 ≤ r i) (t : ℝ≥0∞)
    (f : X → E)
    (h : ∀ i ∈ s, μ (closedBall (c i) (r i)) ≤ t⁻¹ * ∫⁻ y in closedBall (c i) (r i), ‖f y‖ₑ ∂μ) :
    μ (⋃ i ∈ s, closedBall (c i) (r i)) ≤ C / t * ∫⁻ y, ‖f y‖ₑ ∂μ := by
  obtain ⟨S, hSs, hdisj, hcov⟩ := exists_disjoint_subfamily_closedBall_subset_three_mul s c r
  calc μ (⋃ i ∈ s, closedBall (c i) (r i))
      ≤ μ (⋃ j ∈ S, closedBall (c j) (3 * r j)) := by
        refine measure_mono (iUnion₂_subset fun i hi => ?_)
        obtain ⟨j, hj, -, hsub⟩ := hcov i hi
        exact hsub.trans (subset_biUnion_of_mem (u := fun j => closedBall (c j) (3 * r j)) hj)
    _ ≤ ∑ j ∈ S, μ (closedBall (c j) (3 * r j)) := measure_biUnion_finset_le S _
    _ ≤ ∑ j ∈ S, (C : ℝ≥0∞) * μ (closedBall (c j) (r j)) :=
        Finset.sum_le_sum fun j hj => hC _ _ (hr j (hSs hj))
    _ = C * ∑ j ∈ S, μ (closedBall (c j) (r j)) := (Finset.mul_sum _ _ _).symm
    _ ≤ C * ∑ j ∈ S, t⁻¹ * ∫⁻ y in closedBall (c j) (r j), ‖f y‖ₑ ∂μ := by
        gcongr with j hj
        exact h j (hSs hj)
    _ = C * (t⁻¹ * ∫⁻ y in ⋃ j ∈ S, closedBall (c j) (r j), ‖f y‖ₑ ∂μ) := by
        rw [← Finset.mul_sum,
          lintegral_biUnion_finset hdisj (fun _ _ => measurableSet_closedBall)]
    _ ≤ C * (t⁻¹ * ∫⁻ y, ‖f y‖ₑ ∂μ) := by
        exact mul_le_mul_right (mul_le_mul_right (setLIntegral_le_lintegral _ _) _) _
    _ = C / t * ∫⁻ y, ‖f y‖ₑ ∂μ := by rw [div_eq_mul_inv, mul_assoc]

omit [OpensMeasurableSpace X] in
/-- If the average over `B(x,r)` exceeds `t`, then `r ≥ 0` and `μ(B(x,r)) ≤ t⁻¹ ∫_{B(x,r)} ‖f‖`. -/
theorem measure_closedBall_le_of_lt_hlBallAverage {f : X → E} {x : X} {r : ℝ} {t : ℝ≥0∞}
    (h : t < hlBallAverage μ f x r) :
    0 ≤ r ∧ μ (closedBall x r) ≤ t⁻¹ * ∫⁻ y in closedBall x r, ‖f y‖ₑ ∂μ := by
  unfold hlBallAverage at h
  set m := μ (closedBall x r)
  set I := ∫⁻ y in closedBall x r, ‖f y‖ₑ ∂μ
  have hne : m⁻¹ * I ≠ 0 := (lt_of_le_of_lt zero_le h).ne'
  obtain ⟨hminv, hI⟩ := mul_ne_zero_iff.1 hne
  have hmtop : m ≠ ∞ := ENNReal.inv_ne_zero.1 hminv
  have hm0 : m ≠ 0 := by
    intro hm
    exact hI (setLIntegral_measure_zero _ _ hm)
  refine ⟨?_, ?_⟩
  · by_contra hr
    exact hm0 (by simp [m, closedBall_eq_empty.2 (not_le.1 hr)])
  have htop : t ≠ ∞ := ne_top_of_lt h
  rcases eq_or_ne t 0 with rfl | ht0
  · rw [ENNReal.inv_zero, ENNReal.top_mul hI]
    exact le_top
  have hmul : t * m ≤ I := by
    calc t * m ≤ m⁻¹ * I * m := mul_le_mul_left h.le _
      _ = I := by rw [mul_comm, ← mul_assoc, ENNReal.mul_inv_cancel hm0 hmtop, one_mul]
  rw [mul_comm, ← div_eq_mul_inv, ENNReal.le_div_iff_mul_le (Or.inl ht0) (Or.inl htop),
    mul_comm]
  exact hmul

omit [OpensMeasurableSpace X] in
/-- Averages are monotone in the pointwise norm (almost everywhere). -/
theorem hlBallAverage_mono {F : Type*} [NormedAddCommGroup F] {f : X → E} {g : X → F}
    (h : ∀ᵐ y ∂μ, ‖f y‖ₑ ≤ ‖g y‖ₑ) (x : X) (r : ℝ) :
    hlBallAverage μ f x r ≤ hlBallAverage μ g x r :=
  mul_le_mul_right (lintegral_mono_ae (ae_restrict_of_ae h)) _

omit [OpensMeasurableSpace X] in
/-- The maximal function is monotone in the pointwise norm (almost everywhere). -/
theorem hlMaximal_mono {F : Type*} [NormedAddCommGroup F] {f : X → E} {g : X → F}
    (h : ∀ᵐ y ∂μ, ‖f y‖ₑ ≤ ‖g y‖ₑ) (x : X) : hlMaximal μ f x ≤ hlMaximal μ g x :=
  iSup_mono fun r => hlBallAverage_mono h x r

omit [OpensMeasurableSpace X] in
/-- The maximal function only depends on the almost everywhere class of the input. -/
theorem hlMaximal_congr_ae {f g : X → E} (h : f =ᵐ[μ] g) : hlMaximal μ f = hlMaximal μ g := by
  funext x
  refine le_antisymm (hlMaximal_mono ?_ x) (hlMaximal_mono ?_ x)
  · filter_upwards [h] with y hy
    rw [hy]
  · filter_upwards [h] with y hy
    rw [hy]

omit [OpensMeasurableSpace X] in
/-- Subadditivity of averages for a.e. strongly measurable inputs. -/
theorem hlBallAverage_add_le {f g : X → E} (hf : AEStronglyMeasurable f μ) (x : X) (r : ℝ) :
    hlBallAverage μ (f + g) x r ≤ hlBallAverage μ f x r + hlBallAverage μ g x r := by
  unfold hlBallAverage
  rw [← mul_add, ← lintegral_add_left' hf.restrict.enorm]
  exact mul_le_mul_right (lintegral_mono fun y => enorm_add_le _ _) _

omit [OpensMeasurableSpace X] in
/-- Subadditivity of the maximal function: `M (f + g) ≤ M f + M g` for a.e. strongly measurable
`f`. -/
theorem hlMaximal_add_le {f g : X → E} (hf : AEStronglyMeasurable f μ) (x : X) :
    hlMaximal μ (f + g) x ≤ hlMaximal μ f x + hlMaximal μ g x :=
  iSup_le fun r => (hlBallAverage_add_le hf x r).trans
    (add_le_add (hlBallAverage_le_hlMaximal _ _ _ _) (hlBallAverage_le_hlMaximal _ _ _ _))

omit [OpensMeasurableSpace X] in
/-- If `‖f‖ ≤ c` almost everywhere, then `M f ≤ c` everywhere. -/
theorem hlMaximal_le_of_ae_enorm_le {f : X → E} {c : ℝ≥0∞} (h : ∀ᵐ y ∂μ, ‖f y‖ₑ ≤ c)
    (x : X) : hlMaximal μ f x ≤ c := by
  refine iSup_le fun r => ?_
  unfold hlBallAverage
  calc (μ (closedBall x r))⁻¹ * ∫⁻ y in closedBall x r, ‖f y‖ₑ ∂μ
      ≤ (μ (closedBall x r))⁻¹ * ∫⁻ _ in closedBall x r, c ∂μ :=
        mul_le_mul_right (lintegral_mono_ae (ae_restrict_of_ae h)) _
    _ = c * ((μ (closedBall x r))⁻¹ * μ (closedBall x r)) := by
        rw [setLIntegral_const]
        ring
    _ ≤ c * 1 := mul_le_mul_right (ENNReal.inv_mul_le_one _) _
    _ = c := mul_one c

/-- Continuity of the ball measure from above, in the form used for the maximal function: the
average over `B(x,r)` is at most the supremum of the averages over `B(x,q)`, `q > r` rational
(if balls have finite measure). -/
theorem hlBallAverage_le_iSup_rat_gt (hfin : ∀ (x : X) (r : ℝ), μ (closedBall x r) ≠ ∞)
    (f : X → E) (x : X) (r : ℝ) :
    hlBallAverage μ f x r ≤ ⨆ (q : ℚ) (_ : r < q), hlBallAverage μ f x q := by
  have hinf : ⨅ q : {q : ℚ // r < q}, μ (closedBall x (q : ℝ)) = μ (closedBall x r) := by
    rw [← Directed.measure_iInter (fun q => measurableSet_closedBall.nullMeasurableSet)]
    · congr 1
      ext y
      simp only [mem_iInter, mem_closedBall, Subtype.forall]
      exact ⟨fun h => le_of_forall_lt_rat_imp_le fun q hq => h q hq,
        fun h q hq => h.trans (le_of_lt hq)⟩
    · intro q₁ q₂
      refine ⟨⟨min q₁.1 q₂.1, ?_⟩, ?_, ?_⟩
      · rw [Rat.cast_min]
        exact lt_min q₁.2 q₂.2
      · exact closedBall_subset_closedBall (by rw [Rat.cast_min]; exact min_le_left _ _)
      · exact closedBall_subset_closedBall (by rw [Rat.cast_min]; exact min_le_right _ _)
    · obtain ⟨q, hq⟩ := exists_rat_gt r
      exact ⟨⟨q, hq⟩, hfin _ _⟩
  unfold hlBallAverage
  calc (μ (closedBall x r))⁻¹ * ∫⁻ y in closedBall x r, ‖f y‖ₑ ∂μ
      = (⨅ q : {q : ℚ // r < q}, μ (closedBall x (q : ℝ)))⁻¹ *
          ∫⁻ y in closedBall x r, ‖f y‖ₑ ∂μ := by rw [hinf]
    _ = ⨆ q : {q : ℚ // r < q}, (μ (closedBall x (q : ℝ)))⁻¹ *
          ∫⁻ y in closedBall x r, ‖f y‖ₑ ∂μ := by rw [ENNReal.inv_iInf, ENNReal.iSup_mul]
    _ ≤ ⨆ q : {q : ℚ // r < q}, (μ (closedBall x (q : ℝ)))⁻¹ *
          ∫⁻ y in closedBall x (q : ℝ), ‖f y‖ₑ ∂μ :=
        iSup_mono fun q => mul_le_mul_right
          (lintegral_mono_set (closedBall_subset_closedBall (le_of_lt q.2))) _
    _ ≤ ⨆ (q : ℚ) (_ : r < q), (μ (closedBall x (q : ℝ)))⁻¹ *
          ∫⁻ y in closedBall x (q : ℝ), ‖f y‖ₑ ∂μ :=
        iSup_le fun q => le_iSup₂_of_le q.1 q.2 le_rfl

/-- Rational radii suffice: `M f(x) = sup_{q ∈ ℚ} μ(B(x,q))⁻¹ ∫_{B(x,q)} ‖f‖` (if balls have
finite measure). -/
theorem hlMaximal_eq_iSup_rat (hfin : ∀ (x : X) (r : ℝ), μ (closedBall x r) ≠ ∞)
    (f : X → E) (x : X) : hlMaximal μ f x = ⨆ q : ℚ, hlBallAverage μ f x q :=
  le_antisymm
    (iSup_le fun r => (hlBallAverage_le_iSup_rat_gt hfin f x r).trans
      (iSup₂_le fun q _ => le_iSup (fun q : ℚ => hlBallAverage μ f x q) q))
    (iSup_le fun q => hlBallAverage_le_hlMaximal μ f x q)

section Measurability

variable [SecondCountableTopology X] [SFinite μ]

/-- For a fixed radius, the average is a measurable function of the center (a measurable
parameter integral). -/
theorem measurable_hlBallAverage {f : X → E} (hf : Measurable fun y => ‖f y‖ₑ) (r : ℝ) :
    Measurable fun x => hlBallAverage μ f x r := by
  set S : Set (X × X) := {p | dist p.2 p.1 ≤ r} with hSdef
  have hS : MeasurableSet S :=
    (isClosed_le (continuous_snd.dist continuous_fst) continuous_const).measurableSet
  have hslice : ∀ x, Prod.mk x ⁻¹' S = closedBall x r := fun x => by
    ext y
    simp [S, mem_closedBall]
  have h1 : Measurable fun x => μ (closedBall x r) := by
    simp_rw [← hslice]
    exact measurable_measure_prodMk_left hS
  have h2 : Measurable fun x => ∫⁻ y in closedBall x r, ‖f y‖ₑ ∂μ := by
    have : (fun x => ∫⁻ y in closedBall x r, ‖f y‖ₑ ∂μ) =
        fun x => ∫⁻ y, S.indicator (fun p => ‖f p.2‖ₑ) (x, y) ∂μ := by
      funext x
      rw [← lintegral_indicator measurableSet_closedBall]
      congr 1
    rw [this]
    exact ((hf.comp measurable_snd).indicator hS).lintegral_prod_right'
  exact h1.inv.mul h2

/-- **Measurability of the maximal function** (proof of Blueprint Lemma 2.4 (`lem:maximal`)):
if balls have finite measure (and `X` is second countable, `μ` s-finite), then `M f` is
measurable for every a.e. strongly measurable `f`; rational radii suffice. -/
theorem measurable_hlMaximal (hfin : ∀ (x : X) (r : ℝ), μ (closedBall x r) ≠ ∞) {f : X → E}
    (hf : AEStronglyMeasurable f μ) : Measurable (hlMaximal μ f) := by
  rw [hlMaximal_congr_ae hf.ae_eq_mk]
  have : hlMaximal μ (hf.mk f) = fun x => ⨆ q : ℚ, hlBallAverage μ (hf.mk f) x q :=
    funext fun x => hlMaximal_eq_iSup_rat hfin _ x
  rw [this]
  exact Measurable.iSup fun q => measurable_hlBallAverage hf.stronglyMeasurable_mk.enorm _

end Measurability

/-- The finite covering estimate applied to balls on which the average exceeds `t`. -/
theorem measure_biUnion_le_of_lt_hlBallAverage {C : ℝ≥0}
    (hC : ∀ (x : X) (r : ℝ), 0 ≤ r → μ (closedBall x (3 * r)) ≤ C * μ (closedBall x r))
    (f : X → E) (t : ℝ≥0∞) (F : Finset X) (ρ : X → ℝ)
    (h : ∀ x ∈ F, t < hlBallAverage μ f x (ρ x)) :
    μ (⋃ x ∈ F, closedBall x (ρ x)) ≤ C / t * ∫⁻ y, ‖f y‖ₑ ∂μ :=
  measure_biUnion_closedBall_le_of_doubling hC F id ρ
    (fun x hx => (measure_closedBall_le_of_lt_hlBallAverage (h x hx)).1) t f
    (fun x hx => (measure_closedBall_le_of_lt_hlBallAverage (h x hx)).2)

/-- **Weak type `(1,1)` on inner regular spaces** (Blueprint Lemma 2.4 (`lem:maximal`), weak bound,
the Euclidean case): let `X` be second countable, `μ` s-finite and inner regular (with respect to
compact sets), with balls of finite measure and `μ(B(x,3r)) ≤ C μ(B(x,r))` for all `x`, `r ≥ 0`.
Then for every a.e. strongly measurable `f` and every `t`, `μ {M f > t} ≤ C t⁻¹ ∫ ‖f‖`
(proved on finite subcovers of compact subsets of the level set). -/
theorem hlMaximal_weak_one [SecondCountableTopology X] [SFinite μ] [μ.InnerRegular]
    (hfin : ∀ (x : X) (r : ℝ), μ (closedBall x r) ≠ ∞) {C : ℝ≥0}
    (hC : ∀ (x : X) (r : ℝ), 0 ≤ r → μ (closedBall x (3 * r)) ≤ C * μ (closedBall x r))
    {f : X → E} (hf : AEStronglyMeasurable f μ) (t : ℝ≥0∞) :
    μ {x | t < hlMaximal μ f x} ≤ C / t * ∫⁻ y, ‖f y‖ₑ ∂μ := by
  set L := {x | t < hlMaximal μ f x} with hLdef
  have hmeas : MeasurableSet L := measurableSet_lt measurable_const (measurable_hlMaximal hfin hf)
  have hq : ∀ x ∈ L, ∃ q : ℚ, 0 < (q : ℝ) ∧ t < hlBallAverage μ f x q := by
    intro x hx
    obtain ⟨r, hr⟩ := lt_iSup_iff.1 (show t < hlMaximal μ f x from hx)
    have h0 := (measure_closedBall_le_of_lt_hlBallAverage hr).1
    obtain ⟨q, hq⟩ := lt_iSup_iff.1 (hr.trans_le (hlBallAverage_le_iSup_rat_gt hfin f x r))
    obtain ⟨hrq, hq'⟩ := lt_iSup_iff.1 hq
    exact ⟨q, h0.trans_lt hrq, hq'⟩
  choose! ρ hρpos hρ using hq
  rw [hmeas.measure_eq_iSup_isCompact]
  refine iSup_le fun K => iSup_le fun hKL => iSup_le fun hK => ?_
  obtain ⟨F, hFK, hKF⟩ := hK.elim_nhds_subcover (fun x => closedBall x (ρ x))
    fun x hx => closedBall_mem_nhds x (hρpos x (hKL hx))
  calc μ K ≤ μ (⋃ x ∈ F, closedBall x (ρ x : ℝ)) := measure_mono hKF
    _ ≤ _ := measure_biUnion_le_of_lt_hlBallAverage hC f t F (fun x => (ρ x : ℝ))
        fun x hx => hρ x (hKL (hFK x hx))

/-! ### Strong type `(p, p)` via Marcinkiewicz interpolation -/

/-- The truncated real-valued maximal function `min (M f) N`: a real-valued, everywhere
subadditive operator to which the Marcinkiewicz interpolation theorem applies. -/
def hlMaximalTrunc (μ : Measure X) (N : ℕ) (f : X → E) (x : X) : ℝ :=
  (min (hlMaximal μ f x) N).toReal

omit [OpensMeasurableSpace X] in
theorem enorm_hlMaximalTrunc (N : ℕ) (f : X → E) (x : X) :
    ‖hlMaximalTrunc μ N f x‖ₑ = min (hlMaximal μ f x) N := by
  rw [hlMaximalTrunc, Real.enorm_eq_ofReal ENNReal.toReal_nonneg, ENNReal.ofReal_toReal]
  exact ne_top_of_le_ne_top (ENNReal.natCast_ne_top N) (min_le_right _ _)

/-- `min (a + b) c ≤ min a c + min b c` in `ℝ≥0∞`. -/
theorem min_add_le_add_min_enn (a b c : ℝ≥0∞) : min (a + b) c ≤ min a c + min b c := by
  by_cases ha : a ≤ c
  · by_cases hb : b ≤ c
    · rw [min_eq_left ha, min_eq_left hb]
      exact min_le_left _ _
    · rw [min_eq_right (not_le.1 hb).le]
      exact (min_le_right _ _).trans le_add_self
  · rw [min_eq_right (not_le.1 ha).le]
    exact (min_le_right _ _).trans le_self_add

/-- The strong type constant `C_p = (2^p p C / (p - 1))^(1/p)` of the Hardy–Littlewood maximal
theorem, for doubling constant `C` and `1 < p < ∞`. -/
def hlMaximalConst (C : ℝ≥0) (p : ℝ) : ℝ≥0∞ :=
  ENNReal.ofReal (2 ^ p * p * C / (p - 1)) ^ (1 / p)

/-- The strong type constant is finite. -/
theorem hlMaximalConst_ne_top (C : ℝ≥0) {p : ℝ} (hp : 0 < p) : hlMaximalConst C p ≠ ∞ :=
  ENNReal.rpow_ne_top_of_nonneg (by positivity) ENNReal.ofReal_ne_top

omit [OpensMeasurableSpace X] in
/-- **Strong type `(p, p)` in integral form, from the weak type `(1, 1)` bound** (proof of
Blueprint Lemma 2.4 (`lem:maximal`)): Marcinkiewicz interpolation between weak `(1,1)` and
`L^∞` gives `∫ (M f)^p ≤ 2^p p C/(p-1) ∫ ‖f‖^p` for `1 < p < ∞`. -/
theorem lintegral_hlMaximal_rpow_le_of_weak [SFinite μ] {C : ℝ≥0} {p : ℝ} (hp : 1 < p)
    (hweak : ∀ g : X → E, AEStronglyMeasurable g μ → ∀ t : ℝ≥0∞,
      μ {x | t < hlMaximal μ g x} ≤ C / t * ∫⁻ y, ‖g y‖ₑ ∂μ)
    {f : X → E} (hf : AEStronglyMeasurable f μ) (hM : AEMeasurable (hlMaximal μ f) μ) :
    ∫⁻ x, hlMaximal μ f x ^ p ∂μ ≤
      ENNReal.ofReal (2 ^ p * p * C / (p - 1)) * ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
  set D : Set (X → E) := {g | AEStronglyMeasurable g μ} with hDdef
  have hD : IsTruncationClosed D := fun g hg s _ =>
    ⟨aestronglyMeasurable_indicator_lt_norm hg s, aestronglyMeasurable_indicator_norm_le hg s⟩
  have hne : ∀ (N : ℕ) (a : ℝ≥0∞), min a N ≠ ∞ := fun N a =>
    ne_top_of_le_ne_top (ENNReal.natCast_ne_top N) (min_le_right _ _)
  have key : ∀ N : ℕ, ∫⁻ x, min (hlMaximal μ f x) N ^ p ∂μ ≤
      ENNReal.ofReal (2 ^ p * p * C / (p - 1)) * ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
    intro N
    have hTA : HasWeakTypeOn (hlMaximalTrunc μ N) D 1 C μ μ := by
      intro g hg t _
      unfold distributionFunction
      rw [ENNReal.rpow_one, ENNReal.ofReal_one, eLpNorm_one_eq_lintegral_enorm hg]
      calc μ {x | t < ‖hlMaximalTrunc μ N g x‖ₑ} ≤ μ {x | t < hlMaximal μ g x} := by
            refine measure_mono fun x hx => ?_
            have hx' : t < ‖hlMaximalTrunc μ N g x‖ₑ := hx
            rw [enorm_hlMaximalTrunc] at hx'
            exact hx'.trans_le (min_le_left _ _)
        _ ≤ C / t * ∫⁻ y, ‖g y‖ₑ ∂μ := hweak g hg t
        _ = C * (∫⁻ y, ‖g y‖ₑ ∂μ) / t := by
            rw [div_eq_mul_inv, div_eq_mul_inv, mul_right_comm]
    have hTB : HasLinftyBoundOn (hlMaximalTrunc μ N) D 1 μ := by
      intro g _ s hs
      refine ae_of_all _ fun y => ?_
      have hs0 : 0 ≤ s := (norm_nonneg _).trans (hs y)
      have hMg : hlMaximal μ g y ≤ ENNReal.ofReal s :=
        hlMaximal_le_of_ae_enorm_le (ae_of_all _ fun z => by
          rw [← ofReal_norm]
          exact ENNReal.ofReal_le_ofReal (hs z)) y
      rw [hlMaximalTrunc, Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg, NNReal.coe_one,
        one_mul]
      exact ENNReal.toReal_le_of_le_ofReal hs0 ((min_le_left _ _).trans hMg)
    have hsub : IsSublinearOn (hlMaximalTrunc μ N) D μ := by
      intro g hg h _
      refine ae_of_all _ fun x => ?_
      simp only [hlMaximalTrunc, Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg]
      rw [← ENNReal.toReal_add (hne _ _) (hne _ _)]
      refine ENNReal.toReal_mono (ENNReal.add_ne_top.2 ⟨hne _ _, hne _ _⟩) ?_
      exact (min_le_min_right _ (hlMaximal_add_le hg x)).trans (min_add_le_add_min_enn _ _ _)
    have hTf : AEStronglyMeasurable (hlMaximalTrunc μ N f) μ :=
      (hM.min aemeasurable_const).ennreal_toReal.aestronglyMeasurable
    have := lintegral_rpow_le_of_hasWeakTypeOn_of_linfty (T := hlMaximalTrunc μ N) one_pos hp
      (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num) hTA hTB hsub hD (show f ∈ D from hf) hf hTf
    simp only [enorm_hlMaximalTrunc] at this
    have hconst : marcinkiewiczBoundTop 1 p C (1 / 2) =
        ENNReal.ofReal (2 ^ p * p * C / (p - 1)) := by
      unfold marcinkiewiczBoundTop
      congr 1
      rw [Real.rpow_one, Real.rpow_one, one_div, Real.inv_rpow (by norm_num),
        ← Real.rpow_neg (by norm_num), neg_sub, Real.rpow_sub_one two_ne_zero]
      ring
    rwa [hconst] at this
  have hpt : ∀ x, hlMaximal μ f x ^ p = ⨆ N : ℕ, min (hlMaximal μ f x) N ^ p := fun x => by
    have h1 : ⨆ N : ℕ, min (hlMaximal μ f x) N = hlMaximal μ f x := by
      rw [← inf_iSup_eq, ENNReal.iSup_natCast]
      simp
    conv_lhs => rw [← h1]
    exact Monotone.map_iSup_of_continuousAt ENNReal.continuous_rpow_const.continuousAt
      (ENNReal.monotone_rpow_of_nonneg (by linarith)) (ENNReal.zero_rpow_of_pos (by linarith))
  simp_rw [hpt]
  rw [lintegral_iSup' (fun N => (hM.min aemeasurable_const).pow_const p)
    (ae_of_all _ fun x N N' hNN' => ENNReal.rpow_le_rpow
      (min_le_min_left _ (Nat.cast_le.2 hNN')) (by linarith))]
  exact iSup_le key

omit [OpensMeasurableSpace X] in
/-- **Strong type `(p, p)`, from the weak type `(1, 1)` bound**: if `M` satisfies the weak
`(1,1)` bound with constant `C` for all a.e. strongly measurable inputs, then
`‖M f‖_p ≤ C_p ‖f‖_p` for `1 < p < ∞`, `C_p = hlMaximalConst C p`. -/
theorem eLpNorm_hlMaximal_le_of_weak [SFinite μ] {C : ℝ≥0} {p : ℝ} (hp : 1 < p)
    (hweak : ∀ g : X → E, AEStronglyMeasurable g μ → ∀ t : ℝ≥0∞,
      μ {x | t < hlMaximal μ g x} ≤ C / t * ∫⁻ y, ‖g y‖ₑ ∂μ)
    {f : X → E} (hf : AEStronglyMeasurable f μ) (hM : AEMeasurable (hlMaximal μ f) μ) :
    eLpNorm (hlMaximal μ f) (ENNReal.ofReal p) μ ≤
      hlMaximalConst C p * eLpNorm f (ENNReal.ofReal p) μ := by
  have hp0 : 0 < p := by linarith
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hp0) ENNReal.ofReal_ne_top
      hM.aestronglyMeasurable, ENNReal.toReal_ofReal hp0.le,
    eLpNorm_ofReal_eq_lintegral_rpow_enorm hf hp0, hlMaximalConst,
    ← ENNReal.mul_rpow_of_nonneg _ _ (by positivity)]
  simp only [enorm_eq_self]
  exact ENNReal.rpow_le_rpow (lintegral_hlMaximal_rpow_le_of_weak hp hweak hf hM)
    (by positivity)

/-- **Hardy–Littlewood maximal theorem, strong type `(p, p)`** (Blueprint Lemma 2.4
(`lem:maximal`), strong bound, the Euclidean case): let `X` be second countable, `μ` s-finite
and inner regular, with balls of finite measure and `μ(B(x,3r)) ≤ C μ(B(x,r))` (`r ≥ 0`). For
`1 < p < ∞` and every a.e. strongly measurable `f`, `‖M f‖_p ≤ C_p ‖f‖_p` with
`C_p = (2^p p C/(p-1))^(1/p)`. -/
theorem eLpNorm_hlMaximal_le [SecondCountableTopology X] [SFinite μ] [μ.InnerRegular]
    (hfin : ∀ (x : X) (r : ℝ), μ (closedBall x r) ≠ ∞) {C : ℝ≥0}
    (hC : ∀ (x : X) (r : ℝ), 0 ≤ r → μ (closedBall x (3 * r)) ≤ C * μ (closedBall x r))
    {p : ℝ} (hp : 1 < p) {f : X → E} (hf : AEStronglyMeasurable f μ) :
    eLpNorm (hlMaximal μ f) (ENNReal.ofReal p) μ ≤
      hlMaximalConst C p * eLpNorm f (ENNReal.ofReal p) μ :=
  eLpNorm_hlMaximal_le_of_weak hp (fun _ hg t => hlMaximal_weak_one hfin hC hg t) hf
    (measurable_hlMaximal hfin hf).aemeasurable

end General


theorem probabilityL2_atomic_closure {X : Type*} [MeasurableSpace X]
    (μ : Measure X) [IsProbabilityMeasure μ] {M σ κ : ℝ}
    (hM : 0 ≤ M) (hσ : 0 < σ) (hcost : σ < M * κ)
    (A : Set (Lp ℂ 2 μ)) (p : Seminorm ℂ (Lp ℂ 2 μ))
    (hinverse : ∀ g : Lp ℂ 2 μ, (∀ᵐ x ∂μ, ‖g x‖ ≤ 1) →
      σ ^ 2 ≤ p g → ∃ a ∈ A, κ ≤ ‖inner ℂ g a‖)
    {f : Lp ℂ 2 μ} (hf : ‖f‖ ≤ 1) :
    f ∈ closure (atomicSeminormSum M σ A p (probabilityL2L1Seminorm μ)) := by
  by_contra hout
  obtain ⟨h, hhf, hinfty, hp, hA⟩ :=
    probabilityL2_atomic_separation μ hM hσ A p hout
  have hhn : 1 < ‖h‖ := by
    have hc := (Complex.re_le_norm (inner ℂ h f)).trans (norm_inner_le_norm h f)
    have hm := mul_le_mul_of_nonneg_left hf (norm_nonneg h)
    nlinarith only [hhf, hc, hm]
  have hph : σ < p h := by
    have hh := hp h
    simp only [inner_self_eq_norm_sq_to_K, norm_pow, RCLike.norm_ofReal, abs_norm] at hh
    have hs : 1 < ‖h‖ ^ 2 := by nlinarith only [hhn]
    have hm := mul_lt_mul_of_pos_left hs hσ
    have hm' : σ < σ * ‖h‖ ^ 2 := by simpa only [mul_one] using hm
    exact hm'.trans_le hh
  let g : Lp ℂ 2 μ := (σ : ℂ) • h
  have hgb : ∀ᵐ x ∂μ, ‖g x‖ ≤ 1 := by
    filter_upwards [Lp.coeFn_smul (σ : ℂ) h, hinfty] with x hx hb
    change ‖((σ : ℂ) • h) x‖ ≤ 1
    rw [hx, Pi.smul_apply, norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hσ]
    calc
      σ * ‖h x‖ ≤ σ * σ⁻¹ := mul_le_mul_of_nonneg_left hb hσ.le
      _ = 1 := mul_inv_cancel₀ (ne_of_gt hσ)
  have hgp : σ ^ 2 ≤ p g := by
    change σ ^ 2 ≤ p ((σ : ℂ) • h)
    rw [map_smul_eq_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hσ]
    nlinarith only [hph, hσ]
  obtain ⟨a, ha, hcorr⟩ := hinverse g hgb hgp
  have hcorr' : κ ≤ σ * ‖inner ℂ h a‖ := by
    simpa only [g, inner_smul_left, norm_mul, Complex.norm_conj, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hσ] using hcorr

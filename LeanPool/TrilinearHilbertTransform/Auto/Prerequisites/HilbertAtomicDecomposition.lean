theorem complexAtomicHull_finite {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {M : ℝ} (hM : 0 ≤ M) {A : Set E} (hA : A.Nonempty)
    {x : E} (hx : x ∈ complexAtomicHull M A) :
    ∃ (ι : Type) (s : Finset ι) (c : ι → ℂ) (a : ι → E),
      (∀ i ∈ s, a i ∈ A) ∧ (∑ i ∈ s, ‖c i‖) ≤ M ∧
      (∑ i ∈ s, c i • a i) = x := by
  classical
  obtain ⟨a0, ha0⟩ := hA
  rw [complexAtomicHull, convexHull_eq] at hx
  obtain ⟨ι, s, w, z, hw, hw1, hz, hsum⟩ := hx
  have hall (i : ι) : ∃ a ∈ A, ∃ c : ℂ, ‖c‖ ≤ M ∧ (i ∈ s → z i = c • a) := by
    by_cases hi : i ∈ s
    · rcases hz i hi with hzero | ⟨a, ha, c, hc, he⟩
      · refine ⟨a0, ha0, 0, ?_, ?_⟩
        · simpa using hM
        · intro _
          simpa using hzero
      · exact ⟨a, ha, c, hc, fun _ => he⟩
    · exact ⟨a0, ha0, 0, by simpa using hM, fun h => (hi h).elim⟩
  choose a ha c hc he using hall
  refine ⟨ι, s, fun i => (w i : ℂ) * c i, a, fun i _ => ha i, ?_, ?_⟩
  · calc
      ∑ i ∈ s, ‖(w i : ℂ) * c i‖ = ∑ i ∈ s, w i * ‖c i‖ := by
        apply Finset.sum_congr rfl
        intro i hi
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hw i hi)]
      _ ≤ ∑ i ∈ s, w i * M := Finset.sum_le_sum fun i hi =>
        mul_le_mul_of_nonneg_left (hc i) (hw i hi)
      _ = M := by rw [← Finset.sum_mul, hw1, one_mul]
  · rw [Finset.centerMass, hw1, inv_one, one_smul] at hsum
    rw [← hsum]
    apply Finset.sum_congr rfl
    intro i hi
    rw [he i hi, mul_smul]
    exact_mod_cast (rfl : (w i : ℂ) • c i • a i = (w i : ℂ) • c i • a i)
theorem probabilityL2_atomic_decomposition {X : Type*} [MeasurableSpace X]
    (μ : Measure X) [IsProbabilityMeasure μ] {M σ κ ε : ℝ}
    (hM : 0 ≤ M) (hσ : 0 < σ) (hε : 0 < ε) (hcost : σ < M * κ)
    (A : Set (Lp ℂ 2 μ)) (hA : A.Nonempty) (p : Seminorm ℂ (Lp ℂ 2 μ))
    (hinverse : ∀ g : Lp ℂ 2 μ, (∀ᵐ x ∂μ, ‖g x‖ ≤ 1) →
      σ ^ 2 ≤ p g → ∃ a ∈ A, κ ≤ ‖inner ℂ g a‖)
    {f : Lp ℂ 2 μ} (hf : ‖f‖ ≤ 1) :
    ∃ (ι : Type) (s : Finset ι) (c : ι → ℂ) (a : ι → Lp ℂ 2 μ)
      (u v : Lp ℂ 2 μ),
      (∀ i ∈ s, a i ∈ A) ∧ (∑ i ∈ s, ‖c i‖) ≤ M ∧
      p u ≤ σ ∧ probabilityL2L1Norm μ v ≤ σ + ε ∧
      f = (∑ i ∈ s, c i • a i) + u + v := by
  have hcl := probabilityL2_atomic_closure μ hM hσ hcost A p hinverse hf
  obtain ⟨z, hz, hdist⟩ := Metric.mem_closure_iff.mp hcl ε hε
  obtain ⟨w, ⟨b, hb, u, hu, rfl⟩, v, hv, rfl⟩ := hz
  obtain ⟨ι, s, c, a, ha, hc, he⟩ := complexAtomicHull_finite hM hA hb
  refine ⟨ι, s, c, a, u, v + (f - (b + u + v)), ha, hc, ?_, ?_, ?_⟩
  · simpa using hu
  · have hv' : (probabilityL2L1Seminorm μ) v ≤ σ := by simpa using hv
    change probabilityL2L1Norm μ v ≤ σ at hv'
    have hr := probabilityL2L1Norm_le_norm μ (f - (b + u + v))
    have hd : ‖f - (b + u + v)‖ < ε := by simpa only [dist_eq_norm] using hdist
    exact (probabilityL2L1Norm_add μ v _).trans
      (by linarith only [hv', hr, hd])
  · rw [he]
    abel

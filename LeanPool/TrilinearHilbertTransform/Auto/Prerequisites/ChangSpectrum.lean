/-- The source Bohr condition, expressed through the quotient-circle norm. -/
noncomputable def finiteBohrSet {G ι : Type*} [Fintype G] [AddCommGroup G]
    (phase : ι → G →+ UnitAddCircle) (ρ : ℝ) : Finset G := by
  classical
  exact Finset.univ.filter (fun x => ∀ i, ‖phase i x‖ < ρ)

theorem mem_finiteBohrSet {G ι : Type*} [Fintype G] [AddCommGroup G]
    (phase : ι → G →+ UnitAddCircle) (ρ : ℝ) (x : G) :
    x ∈ finiteBohrSet phase ρ ↔ ∀ i, ‖phase i x‖ < ρ := by
  classical
  simp [finiteBohrSet]

/-- A half-open equal-length partition of the unit circle. -/
noncomputable def unitCircleBin (N : ℕ) (hN : 0 < N) (x : UnitAddCircle) : Fin N :=
  ⟨⌊(N : ℝ) * (AddCircle.equivIco (1 : ℝ) 0 x : ℝ)⌋₊, by
    have hx := (AddCircle.equivIco (1 : ℝ) 0 x).property
    have hn : (0 : ℝ) < N := by exact_mod_cast hN
    apply (Nat.floor_lt (mul_nonneg hn.le hx.1)).mpr
    nlinarith [hx.2]⟩

/-- Points in one partition interval differ by less than `1/N` in circle norm. -/
theorem unitCircleBin_norm_sub_lt {N : ℕ} (hN : 0 < N) {x y : UnitAddCircle}
    (hbin : unitCircleBin N hN x = unitCircleBin N hN y) :
    ‖x - y‖ < (1 : ℝ) / N := by
  let a : ℝ := AddCircle.equivIco (1 : ℝ) 0 x
  let b : ℝ := AddCircle.equivIco (1 : ℝ) 0 y
  have ha : 0 ≤ a := (AddCircle.equivIco (1 : ℝ) 0 x).property.1
  have hb : 0 ≤ b := (AddCircle.equivIco (1 : ℝ) 0 y).property.1
  have hn : (0 : ℝ) < N := by exact_mod_cast hN
  have he : ⌊(N : ℝ) * a⌋₊ = ⌊(N : ℝ) * b⌋₊ := congrArg Fin.val hbin
  have ha0 := Nat.floor_le (mul_nonneg hn.le ha)
  have hb0 := Nat.floor_le (mul_nonneg hn.le hb)
  have ha1 := Nat.lt_floor_add_one ((N : ℝ) * a)
  have hb1 := Nat.lt_floor_add_one ((N : ℝ) * b)
  rw [he] at ha0 ha1
  have hab : |a - b| < (1 : ℝ) / N := by
    rw [abs_lt]
    constructor
    · have ht : b - a < (1 : ℝ) / N := (lt_div_iff₀ hn).mpr (by nlinarith)
      linarith
    · exact (lt_div_iff₀ hn).mpr (by nlinarith)
  have hcoe : ((a - b : ℝ) : UnitAddCircle) = x - y := by
    rw [AddCircle.coe_sub, AddCircle.coe_equivIco, AddCircle.coe_equivIco]
  rw [← hcoe]
  exact (QuotientAddGroup.norm_mk_le_norm (m := a - b)).trans_lt (by simpa using hab)

/-- The source partition size `ceil(2/rho)` has mesh at most `rho/2`
and at most `3/rho` intervals. -/
theorem bohr_partition_size {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    0 < ⌈2 / ρ⌉₊ ∧ (1 : ℝ) / ⌈2 / ρ⌉₊ ≤ ρ / 2 ∧ (⌈2 / ρ⌉₊ : ℝ) ≤ 3 / ρ := by
  have hpos : 0 < 2 / ρ := by positivity
  have hn : 0 < ⌈2 / ρ⌉₊ := Nat.ceil_pos.mpr hpos
  have hnr : (0 : ℝ) < ⌈2 / ρ⌉₊ := by exact_mod_cast hn
  have hlo := Nat.le_ceil (2 / ρ)
  have hhi := Nat.ceil_lt_add_one hpos.le
  refine ⟨hn, ?_, ?_⟩
  · apply (div_le_iff₀ hnr).mpr
    have h := (div_le_iff₀ hρ).mp hlo
    nlinarith only [h]
  · apply (le_div_iff₀ hρ).mpr
    have h := (mul_lt_mul_iff_left₀ hρ).mpr hhi
    have hid : (2 / ρ + 1) * ρ = 2 + ρ := by field_simp
    rw [hid] at h
    linarith

/-- Blueprint `lem:Chang`, lines 735-748: a Bohr set defined by `d` circle
coordinates has at least `(rho/3)^d` of the group elements. The zero-coordinate
case and repeated or zero homomorphisms are included. -/
theorem finiteBohrSet_card_lower {G ι : Type*} [Fintype G] [AddCommGroup G] [Fintype ι]
    (phase : ι → G →+ UnitAddCircle) {ρ : ℝ} (hρ : 0 < ρ) (hρhalf : ρ < 1 / 2) :
    (ρ / 3) ^ Fintype.card ι * Fintype.card G ≤ ((finiteBohrSet phase ρ).card : ℝ) := by
  classical
  let N : ℕ := ⌈2 / ρ⌉₊
  obtain ⟨hN, hmesh, hsize⟩ := bohr_partition_size hρ (by linarith)
  change 0 < N at hN
  let : NeZero N := ⟨Nat.ne_of_gt hN⟩
  have hn : (0 : ℝ) < N := by exact_mod_cast hN
  have hp : (0 : ℝ) < (N : ℝ) ^ Fintype.card ι := by positivity
  have hg : (0 : ℝ) < Fintype.card G := by exact_mod_cast Fintype.card_pos
  let bins : G → ι → Fin N := fun x i => unitCircleBin N hN (phase i x)
  obtain ⟨b, hb⟩ := Fintype.exists_le_card_fiber_of_nsmul_le_card (M := ℝ) bins
    (b := (Fintype.card G : ℝ) / (N : ℝ) ^ Fintype.card ι) (by
      simp only [nsmul_eq_mul, Fintype.card_fun, Fintype.card_fin, Nat.cast_pow]
      field_simp
      rfl)
  let Y : Finset G := Finset.univ.filter (fun x => bins x = b)
  have hY : (Fintype.card G : ℝ) / (N : ℝ) ^ Fintype.card ι ≤ Y.card := hb
  have hYpos : 0 < Y.card := by exact_mod_cast (div_pos hg hp).trans_le hY
  obtain ⟨x₀, hx₀⟩ := Finset.card_pos.mp hYpos
  have hmaps : Set.MapsTo (fun x => x - x₀) Y (finiteBohrSet phase ρ) := by
    intro x hx
    apply (mem_finiteBohrSet phase ρ _).mpr
    intro i
    rw [map_sub]
    have he : bins x = bins x₀ :=
      (Finset.mem_filter.mp hx).2.trans (Finset.mem_filter.mp hx₀).2.symm
    have hd := unitCircleBin_norm_sub_lt hN (congrFun he i)
    exact hd.trans_le (hmesh.trans (by linarith))
  have hcard : Y.card ≤ (finiteBohrSet phase ρ).card :=
    Finset.card_le_card_of_injOn (fun x => x - x₀) hmaps
      (fun _ _ _ _ he => sub_left_inj.mp he)
  have hbase : ρ / 3 ≤ (1 : ℝ) / N := by
    apply (le_div_iff₀ hn).mpr
    have h := (le_div_iff₀ hρ).mp hsize
    change (N : ℝ) * ρ ≤ 3 at h
    nlinarith
  calc
    _ ≤ ((1 : ℝ) / N) ^ Fintype.card ι * Fintype.card G := by gcongr
    _ = (Fintype.card G : ℝ) / (N : ℝ) ^ Fintype.card ι := by rw [div_pow]; ring
    _ ≤ (Y.card : ℝ) := hY
    _ ≤ _ := by exact_mod_cast hcard

/-! ### Aligned characters and positive Riesz products -/

/-- The probability-normalized average of a character on a finite set. -/
noncomputable def characterMean {G : Type*} [AddCommGroup G]
    (X : Finset G) (ψ : AddChar G ℂ) : ℂ := 𝔼 x ∈ X, ψ x

/-- Rotate a Fourier coefficient so its real part is its norm. -/
theorem characterMean_phase {G : Type*} [AddCommGroup G]
    (X : Finset G) (ψ : AddChar G ℂ) :
    ∃ ω : ℂ, ‖ω‖ = 1 ∧ (𝔼 x ∈ X, (ω * ψ x).re) = ‖characterMean X ψ‖ := by
  obtain ⟨ω, hω, he⟩ := Complex.exists_norm_eq_mul_self (characterMean X ψ)
  refine ⟨ω, hω, ?_⟩
  have hm := map_expect (Complex.reCLM.toLinearMap.restrictScalars ℚ≥0)
    (fun x => ω * ψ x) X
  change (𝔼 x ∈ X, ω * ψ x).re = (𝔼 x ∈ X, (ω * ψ x).re) at hm
  rw [← hm, ← Finset.mul_expect]
  change (ω * characterMean X ψ).re = _
  rw [← he, Complex.ofReal_re]

/-- The real Riesz product for finitely many additive characters. -/
noncomputable def finiteRieszProduct {G : Type*} [AddCommGroup G]
    (Λ : Finset (AddChar G ℂ)) (ω : AddChar G ℂ → ℂ) (t : ℝ) (x : G) : ℝ :=
  ∏ ψ ∈ Λ, (1 + t * (ω ψ * ψ x).re)

theorem character_rotated_re_abs_le {G : Type*} [Finite G] [AddCommGroup G]
    (ψ : AddChar G ℂ) {ω : ℂ} (hω : ‖ω‖ = 1) (x : G) : |(ω * ψ x).re| ≤ 1 := by
  calc
    _ ≤ ‖ω * ψ x‖ := Complex.abs_re_le_norm _
    _ = 1 := by rw [norm_mul, hω, ψ.norm_apply, mul_one]

/-- Every factor in the source product is strictly positive for `0 <= t <= 1/2`. -/
theorem finiteRieszProduct_pos {G : Type*} [Finite G] [AddCommGroup G]
    (Λ : Finset (AddChar G ℂ)) (ω : AddChar G ℂ → ℂ)
    (hω : ∀ ψ ∈ Λ, ‖ω ψ‖ = 1) {t : ℝ} (ht : 0 ≤ t) (ht1 : t ≤ 1 / 2) (x : G) :
    0 < finiteRieszProduct Λ ω t x := by
  apply Finset.prod_pos
  intro ψ hψ
  have h := (abs_le.mp (character_rotated_re_abs_le ψ (hω ψ hψ) x)).1
  nlinarith [mul_nonneg ht (show 0 ≤ (ω ψ * ψ x).re + 1 by linarith)]

/-- Blueprint `lem:Chang`, lines 749-757: dissociation annihilates all
nonconstant terms, so the finite Riesz product has normalized mean one. -/
theorem finiteRieszProduct_mean_one {G : Type*} [Fintype G] [AddCommGroup G]
    (Λ : Finset (AddChar G ℂ)) (hΛ : AddDissociated (Λ : Set (AddChar G ℂ)))
    (ω : AddChar G ℂ → ℂ) (t : ℝ) : (𝔼 x, finiteRieszProduct Λ ω t x) = 1 := by
  classical
  let d : AddChar G ℂ → ℂ := fun ψ => if ψ ∈ Λ then (t : ℂ) * ω ψ else 0
  have hsupport : {ψ | d ψ ≠ 0} ⊆ (Λ : Set (AddChar G ℂ)) := by
    intro ψ hψ
    by_contra hn
    change ψ ∉ Λ at hn
    exact hψ (by simp [d, hn])
  have hd := AddDissociated.subset hsupport hΛ
  have hm := AddDissociated.randomisation (fun _ : AddChar G ℂ => (1 : ℝ)) d hd
  have he (x : G) : (∏ ψ, (1 + (d ψ * ψ x).re)) = finiteRieszProduct Λ ω t x := by
    calc
      _ = ∏ ψ ∈ Λ, (1 + (d ψ * ψ x).re) := by
        symm
        apply Finset.prod_subset (Finset.subset_univ _)
        intro ψ _ hψ
        simp [d, hψ]
      _ = _ := by
        apply Finset.prod_congr rfl
        intro ψ hψ
        simp [d, hψ, mul_assoc]
  simpa only [he, Finset.prod_const_one] using hm

/-! ### The logarithmic estimate and entropy bound -/

/-- The elementary logarithm estimate on the entire source interval. -/
theorem log_one_add_quadratic_lower {v : ℝ} (hv : |v| ≤ 1 / 2) :
    v - v ^ 2 ≤ Real.log (1 + v) := by
  let f : ℝ → ℝ := fun x => Real.log (1 + x) - x + x ^ 2
  have hd (x : ℝ) (hx : -(1 / 2) ≤ x) :
      HasDerivAt f (x * (1 + 2 * x) / (1 + x)) x := by
    have hp : 1 + x ≠ 0 := by linarith
    have h := (((hasDerivAt_id x).const_add 1).log hp).sub (hasDerivAt_id x)
    convert! h.add ((hasDerivAt_id x).pow 2) using 1
    dsimp
    field_simp
    ring
  have hm : MonotoneOn f (Set.Icc (0 : ℝ) (1 / 2)) := by
    apply monotoneOn_of_hasDerivWithinAt_nonneg (f' := fun x => x * (1 + 2 * x) / (1 + x))
      (convex_Icc _ _)
    · intro x hx
      exact (hd x (by linarith [hx.1])).continuousAt.continuousWithinAt
    · intro x hx
      exact (hd x (by linarith [(interior_subset hx).1])).hasDerivWithinAt
    · intro x hx
      have hx0 := (interior_subset hx).1
      positivity
  have ha : AntitoneOn f (Set.Icc (-(1 / 2) : ℝ) 0) := by
    apply antitoneOn_of_hasDerivWithinAt_nonpos (f' := fun x => x * (1 + 2 * x) / (1 + x))
      (convex_Icc _ _)
    · intro x hx
      exact (hd x hx.1).continuousAt.continuousWithinAt
    · intro x hx
      exact (hd x (interior_subset hx).1).hasDerivWithinAt
    · intro x hx
      have hx' := interior_subset hx
      exact div_nonpos_of_nonpos_of_nonneg
        (mul_nonpos_of_nonpos_of_nonneg hx'.2 (by linarith [hx'.1])) (by linarith [hx'.1])
  have hf : 0 ≤ f v := by
    rcases le_total 0 v with hpos | hneg
    · have h := hm (show (0 : ℝ) ∈ Set.Icc 0 (1 / 2) by constructor <;> norm_num)
        ⟨hpos, (abs_le.mp hv).2⟩ hpos
      simpa [f] using h
    · have h := ha ⟨(abs_le.mp hv).1, hneg⟩
        (show (0 : ℝ) ∈ Set.Icc (-(1 / 2)) 0 by constructor <;> norm_num) hneg
      simpa [f] using h
  dsimp [f] at hf
  linarith

/-- Blueprint `lem:Chang`, line 758: `log(1+t*u) >= t*u-t^2`
for `|u| <= 1` and `0 <= t <= 1/2`. -/
theorem log_riesz_factor_lower {u t : ℝ} (hu : |u| ≤ 1) (ht : 0 ≤ t) (ht1 : t ≤ 1 / 2) :
    t * u - t ^ 2 ≤ Real.log (1 + t * u) := by
  have hab : |t * u| ≤ t := by rw [abs_mul, abs_of_nonneg ht]; nlinarith
  have h := log_one_add_quadratic_lower (hab.trans ht1)
  have hs : (t * u) ^ 2 ≤ t ^ 2 := by
    simpa only [sq_abs] using (sq_le_sq₀ (abs_nonneg (t * u)) ht).mpr hab
  linarith

/-- Averaging the source logarithm estimate over a nonempty set. -/
theorem finiteRieszProduct_log_mean_lower {G : Type*} [Finite G] [AddCommGroup G]
    (X : Finset G) (hX : X.Nonempty) (Λ : Finset (AddChar G ℂ))
    (ω : AddChar G ℂ → ℂ) (hω : ∀ ψ ∈ Λ, ‖ω ψ‖ = 1)
    {η : ℝ} (hη : 0 < η) (hη1 : η ≤ 1)
    (halign : ∀ ψ ∈ Λ, η ≤ 𝔼 x ∈ X, (ω ψ * ψ x).re) :
    (Λ.card : ℝ) * η ^ 2 / 4 ≤ 𝔼 x ∈ X, Real.log (finiteRieszProduct Λ ω (η / 2) x) := by
  have ht : 0 ≤ η / 2 := by positivity
  have ht1 : η / 2 ≤ 1 / 2 := by linarith
  have hfactor (ψ : AddChar G ℂ) (hψ : ψ ∈ Λ) (x : G) :
      0 < 1 + η / 2 * (ω ψ * ψ x).re := by
    have hr := (abs_le.mp (character_rotated_re_abs_le ψ (hω ψ hψ) x)).1
    nlinarith [mul_nonneg ht (show 0 ≤ (ω ψ * ψ x).re + 1 by linarith)]
  have hpoint (x : G) :
      (∑ ψ ∈ Λ, (η / 2 * (ω ψ * ψ x).re - (η / 2) ^ 2)) ≤
        Real.log (finiteRieszProduct Λ ω (η / 2) x) := by
    rw [finiteRieszProduct, Real.log_prod (fun ψ hψ => (hfactor ψ hψ x).ne')]
    apply Finset.sum_le_sum
    intro ψ hψ
    exact log_riesz_factor_lower (character_rotated_re_abs_le ψ (hω ψ hψ) x) ht ht1
  calc
    _ = ∑ _ψ ∈ Λ, (η / 2 * η - (η / 2) ^ 2) := by simp; ring
    _ ≤ ∑ ψ ∈ Λ, (𝔼 x ∈ X, (η / 2 * (ω ψ * ψ x).re - (η / 2) ^ 2)) := by
      apply Finset.sum_le_sum
      intro ψ hψ
      rw [Finset.expect_sub_distrib, ← Finset.mul_expect, Finset.expect_const hX]
      exact sub_le_sub_right (mul_le_mul_of_nonneg_left (halign ψ hψ) ht) _
    _ = 𝔼 x ∈ X, (∑ ψ ∈ Λ, (η / 2 * (ω ψ * ψ x).re - (η / 2) ^ 2)) :=
      (Finset.expect_sum_comm _ _ _).symm
    _ ≤ _ := Finset.expect_le_expect (fun x _ => hpoint x)

/-- Finite Jensen in the logarithmic form used by the entropy argument. -/
theorem finite_log_mean_le_log_mean {α : Type*} (X : Finset α) (hX : X.Nonempty)
    (F : α → ℝ) (hF : ∀ x ∈ X, 0 < F x) :
    (𝔼 x ∈ X, Real.log (F x)) ≤ Real.log (𝔼 x ∈ X, F x) := by
  have hn : (0 : ℝ) < X.card := by exact_mod_cast hX.card_pos
  have hj := strictConcaveOn_log_Ioi.concaveOn.le_map_sum
    (t := X) (w := fun _ => (X.card : ℝ)⁻¹) (p := F)
    (fun _ _ => inv_nonneg.mpr hn.le) (by simp [hn.ne']) (fun x hx => hF x hx)
  simpa only [Finset.expect_eq_sum_div_card, div_eq_inv_mul, smul_eq_mul,
    ← Finset.mul_sum] using hj

/-- A positive function of global mean one has mean logarithm on `X` at most
the logarithm of the reciprocal density of `X`. -/
theorem finite_log_mean_le_log_density_inv {G : Type*} [Fintype G]
    (X : Finset G) (hX : X.Nonempty) (F : G → ℝ) (hF : ∀ x, 0 < F x)
    (hmean : (𝔼 x, F x) = 1) :
    (𝔼 x ∈ X, Real.log (F x)) ≤ Real.log ((Fintype.card G : ℝ) / X.card) := by
  have hn : (0 : ℝ) < X.card := by exact_mod_cast hX.card_pos
  have hng : (0 : ℝ) < Fintype.card G := by
    exact_mod_cast hX.card_pos.trans_le (Finset.card_le_univ X)
  have hsum : ∑ x, F x = (Fintype.card G : ℝ) := by
    rw [Fintype.expect_eq_sum_div_card, div_eq_iff hng.ne'] at hmean
    simpa using hmean
  have hbound : (𝔼 x ∈ X, F x) ≤ (Fintype.card G : ℝ) / X.card := by
    rw [Finset.expect_eq_sum_div_card]
    apply div_le_div_of_nonneg_right _ hn.le
    rw [← hsum]
    exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) (fun x _ _ => (hF x).le)
  exact (finite_log_mean_le_log_mean X hX F (fun x _ => hF x)).trans
    (Real.log_le_log (Finset.expect_pos (fun x _ => hF x) hX) hbound)

/-- Blueprint `lem:Chang`, lines 749-763: every dissociated family of
characters with average norm at least `eta` has cardinality at most
`4 eta^(-2) log(1/beta)`, where `beta = |X|/|G|`. -/
theorem dissociated_spectrum_card_bound {G : Type*} [Fintype G] [AddCommGroup G]
    (X : Finset G) (hX : X.Nonempty) (Λ : Finset (AddChar G ℂ))
    (hΛ : AddDissociated (Λ : Set (AddChar G ℂ))) {η : ℝ} (hη : 0 < η) (hη1 : η ≤ 1)
    (hlarge : ∀ ψ ∈ Λ, η ≤ ‖characterMean X ψ‖) :
    (Λ.card : ℝ) ≤ 4 / η ^ 2 * Real.log ((Fintype.card G : ℝ) / X.card) := by
  choose ω hω halign using (fun ψ : AddChar G ℂ => characterMean_phase X ψ)
  have hlower := finiteRieszProduct_log_mean_lower X hX Λ ω (fun ψ _ => hω ψ) hη hη1
    (fun ψ hψ => by rw [halign ψ]; exact hlarge ψ hψ)
  have hupper := finite_log_mean_le_log_density_inv X hX (finiteRieszProduct Λ ω (η / 2))
    (finiteRieszProduct_pos Λ ω (fun ψ _ => hω ψ) (by positivity) (by linarith))
    (finiteRieszProduct_mean_one Λ hΛ ω (η / 2))
  apply (mul_le_mul_iff_left₀ (sq_pos_of_pos hη)).mp
  calc
    _ ≤ 4 * Real.log ((Fintype.card G : ℝ) / X.card) := by linarith
    _ = _ := by field_simp

/-! ### Generating the large spectrum -/

/-- The large spectrum of a uniform finite-set measure, in the character dual. -/
noncomputable def largeCharacterSpectrum {G : Type*} [Fintype G] [AddCommGroup G]
    (X : Finset G) (η : ℝ) : Finset (AddChar G ℂ) := by
  classical
  exact Finset.univ.filter (fun ψ => η ≤ ‖characterMean X ψ‖)

theorem mem_largeCharacterSpectrum {G : Type*} [Fintype G] [AddCommGroup G]
    (X : Finset G) (η : ℝ) (ψ : AddChar G ℂ) :
    ψ ∈ largeCharacterSpectrum X η ↔ η ≤ ‖characterMean X ψ‖ := by
  classical
  simp [largeCharacterSpectrum]

/-- Chang's spectrum-generating conclusion for an arbitrary finite abelian
group. The span is Mathlib's signed span with coefficients in `{-1,0,1}`. -/
theorem characterSpectrum_generators {G : Type*} [Fintype G] [AddCommGroup G]
    (X : Finset G) (hX : X.Nonempty) {η : ℝ} (hη : 0 < η) (hη1 : η ≤ 1) :
    ∃ Λ : Finset (AddChar G ℂ), Λ ⊆ largeCharacterSpectrum X η ∧
      (Λ.card : ℝ) ≤ 4 / η ^ 2 * Real.log ((Fintype.card G : ℝ) / X.card) ∧
      largeCharacterSpectrum X η ⊆ Λ.addSpan := by
  classical
  let B : ℝ := 4 / η ^ 2 * Real.log ((Fintype.card G : ℝ) / X.card)
  have hn : (0 : ℝ) < X.card := by exact_mod_cast hX.card_pos
  have hratio : (1 : ℝ) ≤ (Fintype.card G : ℝ) / X.card := by
    apply (le_div_iff₀ hn).mpr
    simpa using (Nat.cast_le (α := ℝ)).mpr (Finset.card_le_univ X)
  have hB : 0 ≤ B := mul_nonneg (by positivity) (Real.log_nonneg hratio)
  obtain ⟨Λ, hΛS, hΛcard, hspan⟩ :=
    Finset.exists_subset_addSpan_card_le_of_forall_addDissociated
      (s := largeCharacterSpectrum X η) (d := ⌊B⌋₊) (by
        intro Λ hsub hdiss
        apply (Nat.le_floor_iff hB).mpr
        exact dissociated_spectrum_card_bound X hX Λ hdiss hη hη1
          (fun ψ hψ => (mem_largeCharacterSpectrum X η ψ).mp (hsub hψ)))
  refine ⟨Λ, hΛS, ?_, hspan⟩
  exact (show (Λ.card : ℝ) ≤ ⌊B⌋₊ by exact_mod_cast hΛcard).trans (Nat.floor_le hB)

open scoped Pointwise in
/-- Signed spans commute with an additive equivalence. -/
theorem addSpan_image_equiv {G H : Type*} [AddCommGroup G] [AddCommGroup H]
    [Fintype G] [Fintype H] [DecidableEq G] [DecidableEq H]
    (e : G ≃+ H) (S : Finset G) : (S.image e).addSpan = S.addSpan.image e := by
  ext b
  constructor
  · intro hb
    obtain ⟨ε, hε, he⟩ := Finset.mem_addSpan.mp hb
    apply Finset.mem_image.mpr
    refine ⟨∑ a ∈ S, ε (e a) • a, ?_, ?_⟩
    · exact Finset.mem_addSpan.mpr ⟨fun a => ε (e a), fun a => hε (e a), rfl⟩
    · rw [map_sum]
      simp only [map_zsmul]
      rw [Finset.sum_image (fun a _ b _ h => e.injective h)] at he
      exact he
  · rintro hb
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hb
    obtain ⟨ε, hε, rfl⟩ := Finset.mem_addSpan.mp ha
    apply Finset.mem_addSpan.mpr
    refine ⟨fun b => ε (e.symm b), fun b => hε (e.symm b), ?_⟩
    rw [Finset.sum_image (fun a _ b _ h => e.injective h), map_sum]
    simp only [e.symm_apply_apply, map_zsmul]

/-! ### Cyclic frequencies and Bohr sets -/

/-- Identify a cyclic frequency with its negative-exponent Fourier character. -/
noncomputable def cyclicFrequencyEquiv (q : ℕ) [NeZero q] :
    ZMod q ≃+ AddChar (ZMod q) ℂ := by
  let f : ZMod q →+ AddChar (ZMod q) ℂ :=
    { toFun := fun ξ => ZMod.stdAddChar.mulShift (-ξ)
      map_zero' := by ext x; simp
      map_add' := by
        intro ξ ζ
        ext x
        simp only [AddChar.mulShift_apply, AddChar.add_apply, neg_add, add_mul,
          AddChar.map_add_eq_mul] }
  apply AddEquiv.ofBijective f
  apply (Fintype.bijective_iff_injective_and_card _).mpr
  refine ⟨?_, by simp⟩
  intro ξ ζ h
  have he := congrArg (fun ψ : AddChar (ZMod q) ℂ => ψ 1) h
  change ZMod.stdAddChar ((-ξ) * 1) = ZMod.stdAddChar ((-ζ) * 1) at he
  apply neg_injective
  apply ZMod.injective_stdAddChar
  simpa only [mul_one] using he

theorem cyclicFrequencyEquiv_apply (q : ℕ) [NeZero q] (ξ x : ZMod q) :
    cyclicFrequencyEquiv q ξ x = ZMod.stdAddChar (-(ξ * x)) := by
  change ZMod.stdAddChar ((-ξ) * x) = ZMod.stdAddChar (-(ξ * x))
  rw [neg_mul]

/-- The source cyclic Bohr set, using the exact quotient-circle norm of `s*x/q`. -/
noncomputable def cyclicBohrSet {q : ℕ} [NeZero q] (S : Finset (ZMod q)) (ρ : ℝ) :
    Finset (ZMod q) :=
  finiteBohrSet (fun s : S => ZMod.toAddCircle.comp (AddMonoidHom.mulLeft (s : ZMod q))) ρ

theorem mem_cyclicBohrSet {q : ℕ} [NeZero q] (S : Finset (ZMod q)) (ρ : ℝ) (x : ZMod q) :
    x ∈ cyclicBohrSet S ρ ↔ ∀ s ∈ S, ‖ZMod.toAddCircle (s * x)‖ < ρ := by
  rw [cyclicBohrSet, mem_finiteBohrSet]
  change (∀ s : S, ‖ZMod.toAddCircle ((s : ZMod q) * x)‖ < ρ) ↔ _
  simp only [Subtype.forall]

/-- Blueprint `lem:Chang`, first conclusion in its cyclic form. -/
theorem cyclicBohrSet_card_lower {q : ℕ} [NeZero q] (S : Finset (ZMod q))
    {ρ : ℝ} (hρ : 0 < ρ) (hρhalf : ρ < 1 / 2) :
    (ρ / 3) ^ S.card * q ≤ ((cyclicBohrSet S ρ).card : ℝ) := by
  simpa only [cyclicBohrSet, Fintype.card_coe, ZMod.card] using
    finiteBohrSet_card_lower
      (fun s : S => ZMod.toAddCircle.comp (AddMonoidHom.mulLeft (s : ZMod q))) hρ hρhalf


/-!
# The quasipolynomial dense Bogolyubov theorem

This file was automatically generated by Codex.

For a nonempty subset of a finite cyclic group of density alpha, its double
difference set contains a Bohr set of rank O(log^4(1/alpha)), reciprocal
radius O(alpha^(-1) log^4(1/alpha)), and density exp(-O(log^5(1/alpha))).
The proof combines sampling almost periods, Chang's spectrum theorem and
finite Fourier analysis. Statements and local definitions use Mathlib
and local vocabulary; proofs reuse the previously verified sampling and
spectrum prerequisites. Reference: blueprint `lem:dense-Bohr`, lines 786-820.
-/

@[expose] public section

namespace TrilinearHT.Auto

open scoped BigOperators Pointwise ComplexConjugate

/-- The positive source witness `mu_A * mu_A * 1_{-(A+A)}`, expressed using
probability averages on `A` so the normalization is explicit. -/
noncomputable def bogolyubovBaseFunction {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (x : G) : ℝ :=
  𝔼 a ∈ A, 𝔼 b ∈ A, if x - a - b ∈ -(A + A) then 1 else 0

/-- The witness is exactly one at the identity, not merely bounded below. -/
theorem bogolyubovBaseFunction_zero {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (hA : A.Nonempty) : bogolyubovBaseFunction A 0 = 1 := by
  have he : bogolyubovBaseFunction A 0 = 𝔼 _a ∈ A, 𝔼 _b ∈ A, (1 : ℝ) := by
    apply Finset.expect_congr rfl
    intro a ha
    apply Finset.expect_congr rfl
    intro b hb
    apply ite_eq_left
    have h := Finset.neg_mem_neg (Finset.add_mem_add ha hb)
    convert h using 1; abel
  rw [he]
  simp [Finset.expect_const hA]

/-- Every contributing pair in the witness certifies membership in the double difference set. -/
theorem bogolyubov_pair_mem_difference {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) {x a b : G} (ha : a ∈ A) (hb : b ∈ A)
    (h : x - a - b ∈ -(A + A)) : x ∈ 2 • A - 2 • A := by
  obtain ⟨y, hy, hxy⟩ := Finset.mem_neg.mp h
  have hsum : -(x - a - b) ∈ A + A := by rw [← hxy, neg_neg]; exact hy
  obtain ⟨c, hc, d, hd, hcd⟩ := Finset.mem_add.mp hsum
  have hx : x = (a + b) - (c + d) := by rw [hcd]; abel
  rw [hx, two_nsmul]
  exact Finset.sub_mem_sub (Finset.add_mem_add ha hb) (Finset.add_mem_add hc hd)

/-- The witness vanishes outside the actual sum-difference set. -/
theorem bogolyubovBaseFunction_eq_zero_of_notMem {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) {x : G} (hx : x ∉ 2 • A - 2 • A) : bogolyubovBaseFunction A x = 0 := by
  apply Finset.expect_eq_zero
  intro a ha
  apply Finset.expect_eq_zero
  intro b hb
  exact ite_eq_right (fun h => hx (bogolyubov_pair_mem_difference A ha hb h))

/-- Positivity of the witness is sufficient for the desired containment. -/
theorem bogolyubovBaseFunction_pos_mem {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) {x : G} (hx : 0 < bogolyubovBaseFunction A x) : x ∈ 2 • A - 2 • A := by
  by_contra hn
  rw [bogolyubovBaseFunction_eq_zero_of_notMem A hn] at hx
  exact (lt_irrefl 0) hx

/-- Jensen's inequality for the probability average on a nonempty finite set. -/
theorem bogolyubov_expect_norm_rpow_le {G : Type*} (A : Finset G) (hA : A.Nonempty)
    (f : G → ℂ) {p : ℝ} (hp : 1 ≤ p) :
    ‖𝔼 a ∈ A, f a‖ ^ p ≤ 𝔼 a ∈ A, ‖f a‖ ^ p := by
  let : Nonempty A := hA.to_subtype
  have h := uniformMean_norm_rpow_le (fun a : A => f a) hp
  have hs : (∑ a : A, ‖f a‖ ^ p) = ∑ a ∈ A, ‖f a‖ ^ p :=
    A.sum_coe_sort (fun a => ‖f a‖ ^ p)
  simpa only [uniformMean, Fintype.card_coe, Complex.real_smul, Complex.ofReal_inv,
    Complex.ofReal_natCast, smul_eq_mul, hs, Finset.sum_coe_sort,
    Finset.expect_eq_sum_div_card, div_eq_mul_inv, mul_comm] using h

/-- Restricting a nonnegative probability average costs the reciprocal density. -/
theorem bogolyubov_expect_subset_le {G : Type*} [Fintype G]
    (A : Finset G) (f : G → ℝ) (hf : ∀ x, 0 ≤ f x) :
    (𝔼 a ∈ A, f a) ≤ (Fintype.card G : ℝ) / A.card * (𝔼 x, f x) := by
  classical
  by_cases hG : Fintype.card G = 0
  · have : IsEmpty G := Fintype.card_eq_zero_iff.mp hG
    simp [Finset.eq_empty_of_isEmpty A]
  have hG' : (Fintype.card G : ℝ) ≠ 0 := by exact_mod_cast hG
  simp only [Finset.expect_eq_sum_div_card, Finset.card_univ]
  calc
    _ ≤ (∑ x, f x) / A.card := by
      apply div_le_div_of_nonneg_right _ (by positivity)
      exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ A)
        (fun x _ _ => hf x)
    _ = _ := by field_simp

/-- The finite probability-measure Holder estimate used to amplify almost periods. -/
theorem bogolyubov_expect_norm_le {G : Type*} [Fintype G]
    (A : Finset G) (hA : A.Nonempty) (f : G → ℂ) {p : ℝ} (hp : 1 ≤ p) :
    ‖𝔼 a ∈ A, f a‖ ≤ ((Fintype.card G : ℝ) / A.card) ^ (1 / p) *
      (𝔼 x, ‖f x‖ ^ p) ^ (1 / p) := by
  have hp0 : 0 < p := by linarith only [hp]
  have h := (bogolyubov_expect_norm_rpow_le A hA f hp).trans
    (bogolyubov_expect_subset_le A (fun x => ‖f x‖ ^ p) (fun x => by positivity))
  have hr := Real.rpow_le_rpow (by positivity : 0 ≤ ‖𝔼 a ∈ A, f a‖ ^ p)
    h (by positivity : 0 ≤ 1 / p)
  rw [← Real.rpow_mul (norm_nonneg _), mul_one_div_cancel hp0.ne', Real.rpow_one,
    Real.mul_rpow (by positivity) (Finset.expect_nonneg (fun x _ => by positivity))] at hr
  exact hr

/-- Convolution with the uniform probability measure on a finite set. -/
noncomputable def bogolyubovAverage {G : Type*} [AddCommGroup G]
    (A : Finset G) (f : G → ℂ) (x : G) : ℂ := 𝔼 a ∈ A, f (x - a)

/-- A pointwise estimate for averaging an arbitrary function on a translate of `A`. -/
theorem bogolyubovAverage_norm_le {G : Type*} [AddCommGroup G] [Fintype G]
    (A : Finset G) (hA : A.Nonempty) (f : G → ℂ) {p : ℝ} (hp : 1 ≤ p) (x : G) :
    ‖bogolyubovAverage A f x‖ ≤ ((Fintype.card G : ℝ) / A.card) ^ (1 / p) *
      (𝔼 y, ‖f y‖ ^ p) ^ (1 / p) := by
  have he : (𝔼 a, ‖f (x - a)‖ ^ p) = 𝔼 a, ‖f a‖ ^ p :=
    Fintype.expect_equiv (Equiv.subLeft x) _ _ (fun _ => rfl)
  simpa only [bogolyubovAverage, he] using
    bogolyubov_expect_norm_le A hA (fun a => f (x - a)) hp

/-- Convolution turns an `L^p` translation bound into a uniform bound. -/
theorem bogolyubovAverage_translation_le {G : Type*} [AddCommGroup G] [Fintype G]
    (A : Finset G) (hA : A.Nonempty) (f : G → ℂ) {p : ℝ} (hp : 1 ≤ p) (u x : G) :
    ‖bogolyubovAverage A f (x + u) - bogolyubovAverage A f x‖ ≤
      ((Fintype.card G : ℝ) / A.card) ^ (1 / p) *
        (𝔼 y, ‖f (y + u) - f y‖ ^ p) ^ (1 / p) := by
  have he : bogolyubovAverage A f (x + u) - bogolyubovAverage A f x =
      bogolyubovAverage A (fun y => f (y + u) - f y) x := by
    simp only [bogolyubovAverage, Finset.expect_sub_distrib]
    congr 1
    apply Finset.expect_congr rfl
    intro a _
    congr 1
    abel
  rw [he]
  exact bogolyubovAverage_norm_le A hA _ hp x

/-- The density loss is at most `e` for the source's choice of the real exponent. -/
theorem bogolyubov_density_loss_le {α : ℝ} (hα : 0 < α) :
    (1 / α) ^ (1 / max 2 (Real.log (1 / α))) ≤ Real.exp 1 := by
  have hp : 0 < max 2 (Real.log (1 / α)) := lt_of_lt_of_le (by norm_num) (le_max_left _ _)
  rw [Real.rpow_def_of_pos (by positivity), Real.exp_le_exp]
  rw [mul_one_div]
  exact (div_le_one hp).mpr (le_max_right _ _)

/-- Sampling almost periods after the second convolution, for any bounded input. -/
theorem bogolyubov_double_average_almost_periods {G : Type*} [AddCommGroup G]
    [Fintype G] [DecidableEq G] (A : Finset G) (hA : A.Nonempty)
    (f : G → ℂ) (hf : ∀ x, ‖f x‖ ≤ 1) {p ε : ℝ} (hp : 2 ≤ p) (hε : 0 < ε) :
    ∃ X : Finset G, X.Nonempty ∧
      ((A.card : ℝ) / Fintype.card G) ^ (⌈64 * p / ε ^ 2⌉₊) / 2 ≤
        (X.card : ℝ) / Fintype.card G ∧
      ∀ k : ℕ, ∀ u ∈ k • X - k • X, ∀ x : G,
        ‖bogolyubovAverage A (bogolyubovAverage A f) (x + u) -
          bogolyubovAverage A (bogolyubovAverage A f) x‖ ≤
          ((Fintype.card G : ℝ) / A.card) ^ (1 / p) * (2 * k * ε) := by
  have hp0 : 0 < p := by linarith only [hp]
  have hnorm : finiteLpNorm p f ≤ 1 := by
    have hm : uniformMean (fun x => ‖f x‖ ^ p) ≤ 1 := by
      calc
        _ ≤ uniformMean (fun _ : G => (1 : ℝ)) := uniformMean_mono (fun x => by
          simpa using Real.rpow_le_rpow (norm_nonneg _) (hf x) hp0.le)
        _ = 1 := uniformMean_const _
    simpa [finiteLpNorm] using Real.rpow_le_rpow
      (uniformMean_nonneg (fun x => by positivity)) hm (by positivity : 0 ≤ 1 / p)
  have hc (g : G → ℂ) (x : G) :
      finiteConvolution g (finiteSetDensity A) x = bogolyubovAverage A g x := by
    rw [finiteConvolution_setDensity]
    simp only [uniformMean, bogolyubovAverage, Fintype.card_coe, Complex.real_smul,
      Complex.ofReal_inv, Complex.ofReal_natCast,
      Finset.expect_eq_sum_div_card, div_eq_mul_inv, mul_comm]
    rw [A.sum_coe_sort (fun a => g (x - a))]
  have hn (g : G → ℂ) : finiteLpNorm p g = (𝔼 x, ‖g x‖ ^ p) ^ (1 / p) := by
    simp only [finiteLpNorm, uniformMean, smul_eq_mul,
      Fintype.expect_eq_sum_div_card, div_eq_mul_inv, mul_comm]
  obtain ⟨X, hX, hd, ht⟩ := sampling_almost_periods_iterated A hA f hp hε
  refine ⟨X, hX, hd, ?_⟩
  intro k u hu x
  have ht' := ht k u hu
  simp only [hc, hn] at ht'
  have hsmall : (𝔼 y, ‖bogolyubovAverage A f (y + u) -
      bogolyubovAverage A f y‖ ^ p) ^ (1 / p) ≤ 2 * k * ε := by
    apply ht'.trans
    have hh := mul_le_mul_of_nonneg_left hnorm (by positivity : 0 ≤ 2 * (k : ℝ) * ε)
    simpa only [hn, mul_one] using hh
  exact (bogolyubovAverage_translation_le A hA _ (by linarith) u x).trans
    (mul_le_mul_of_nonneg_left hsmall (by positivity))

/-- The real positive witness is the actual double convolution of the indicator. -/
theorem bogolyubovBaseFunction_eq_double_average {G : Type*} [AddCommGroup G]
    [DecidableEq G] (A : Finset G) (x : G) :
    (bogolyubovBaseFunction A x : ℂ) = bogolyubovAverage A
      (bogolyubovAverage A (fun y => if y ∈ -(A + A) then 1 else 0)) x := by
  simp only [bogolyubovBaseFunction, bogolyubovAverage, Finset.expect_eq_sum_div_card,
    Complex.ofReal_div, Complex.ofReal_sum, Complex.ofReal_natCast,
    apply_ite (Complex.ofReal), Complex.ofReal_one, Complex.ofReal_zero]

/-- The source's real exponent, logarithmic number of iterations and tolerance. -/
noncomputable def bogolyubovExponent (α : ℝ) : ℝ := max 2 (Real.log (1 / α))

noncomputable def bogolyubovIterations (α : ℝ) : ℕ :=
  ⌈10 + Real.log (1 / α) / Real.log 2⌉₊

noncomputable def bogolyubovTolerance (α : ℝ) : ℝ :=
  (1000 * Real.exp 1 * bogolyubovIterations α)⁻¹

noncomputable def bogolyubovSampleSize (α : ℝ) : ℕ :=
  ⌈64 * bogolyubovExponent α / bogolyubovTolerance α ^ 2⌉₊

theorem bogolyubovIterations_pos {α : ℝ} (hα : 0 < α) (hα1 : α ≤ 1) :
    0 < bogolyubovIterations α := by
  apply Nat.ceil_pos.mpr
  have hl : 0 ≤ Real.log (1 / α) := Real.log_nonneg ((one_le_div hα).mpr hα1)
  have h2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  positivity

theorem bogolyubovTolerance_pos {α : ℝ} (hα : 0 < α) (hα1 : α ≤ 1) :
    0 < bogolyubovTolerance α := by
  have hk := bogolyubovIterations_pos hα hα1
  unfold bogolyubovTolerance
  positivity

/-- The parameters give the advertised uniform error, with room in the constant. -/
theorem bogolyubov_parameter_error {α : ℝ} (hα : 0 < α) (hα1 : α ≤ 1) :
    (1 / α) ^ (1 / bogolyubovExponent α) *
      (2 * bogolyubovIterations α * bogolyubovTolerance α) ≤ 1 / 100 := by
  have hk : (bogolyubovIterations α : ℝ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (bogolyubovIterations_pos hα hα1).ne'
  have he : Real.exp 1 ≠ 0 := (Real.exp_pos 1).ne'
  calc
    _ ≤ Real.exp 1 * (2 * bogolyubovIterations α * bogolyubovTolerance α) :=
      mul_le_mul_of_nonneg_right (bogolyubov_density_loss_le hα)
        (by have ht := bogolyubovTolerance_pos hα hα1; positivity)
    _ = 1 / 500 := by unfold bogolyubovTolerance; field_simp; ring
    _ ≤ 1 / 100 := by norm_num

/-- The positive witness has uniform almost periods on the required iterated difference set.
This is the displayed estimate in blueprint `lem:dense-Bohr`, lines 801-805. -/
theorem bogolyubov_witness_almost_periods {G : Type*} [AddCommGroup G]
    [Fintype G] [DecidableEq G] (A : Finset G) (hA : A.Nonempty) :
    let α := (A.card : ℝ) / Fintype.card G
    ∃ X : Finset G, X.Nonempty ∧ α ^ bogolyubovSampleSize α / 2 ≤
      (X.card : ℝ) / Fintype.card G ∧
      ∀ u ∈ bogolyubovIterations α • X - bogolyubovIterations α • X, ∀ x : G,
        |bogolyubovBaseFunction A (x + u) - bogolyubovBaseFunction A x| ≤ 1 / 100 := by
  dsimp only
  let α : ℝ := (A.card : ℝ) / Fintype.card G
  have hα : 0 < α := by dsimp [α]; positivity
  have hα1 : α ≤ 1 := by
    dsimp [α]
    apply (div_le_one (by positivity : 0 < (Fintype.card G : ℝ))).mpr
    exact_mod_cast Finset.card_le_univ A
  let f : G → ℂ := fun y => if y ∈ -(A + A) then 1 else 0
  have hf (y : G) : ‖f y‖ ≤ 1 := by dsimp [f]; split_ifs <;> norm_num
  obtain ⟨X, hX, hd, ht⟩ := bogolyubov_double_average_almost_periods A hA f hf
    (le_max_left 2 (Real.log (1 / α))) (bogolyubovTolerance_pos hα hα1)
  refine ⟨X, hX, hd, ?_⟩
  intro u hu x
  have h := ht (bogolyubovIterations α) u hu x
  have hb (y : G) : bogolyubovAverage A (bogolyubovAverage A f) y =
      (bogolyubovBaseFunction A y : ℂ) :=
    (bogolyubovBaseFunction_eq_double_average A y).symm
  have hdensity : (Fintype.card G : ℝ) / A.card = 1 / α := by
    dsimp [α]
    rw [one_div_div]
  simp only [hb, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs,
    hdensity] at h
  exact h.trans (bogolyubov_parameter_error hα hα1)

/-- The chosen sampling length has the source's `O(p epsilon^(-2))` bound. -/
theorem bogolyubovSampleSize_le {α : ℝ} (hα : 0 < α) (hα1 : α ≤ 1) :
    (bogolyubovSampleSize α : ℝ) ≤
      65 * bogolyubovExponent α / bogolyubovTolerance α ^ 2 := by
  have hk : 1 ≤ (bogolyubovIterations α : ℝ) := by
    exact_mod_cast bogolyubovIterations_pos hα hα1
  have he : 1 ≤ Real.exp 1 := Real.one_le_exp (by norm_num)
  have ht0 := bogolyubovTolerance_pos hα hα1
  have ht1 : bogolyubovTolerance α ≤ 1 := by
    unfold bogolyubovTolerance
    apply (inv_le_one₀ (by positivity)).mpr
    nlinarith only [hk, he]
  have hp : 2 ≤ bogolyubovExponent α := le_max_left _ _
  have ht2 : bogolyubovTolerance α ^ 2 ≤ 1 := by nlinarith
  have hratio : 1 ≤ bogolyubovExponent α / bogolyubovTolerance α ^ 2 :=
    (one_le_div (sq_pos_of_pos ht0)).mpr (by linarith)
  calc
    _ ≤ 64 * bogolyubovExponent α / bogolyubovTolerance α ^ 2 + 1 :=
      (Nat.ceil_lt_add_one (by positivity)).le
    _ ≤ _ := by simp only [mul_div_assoc]; linarith

/-- Repeated averaging against the probability law of a difference of two points of `X`. -/
noncomputable def bogolyubovSmooth {G : Type*} [AddCommGroup G]
    (X : Finset G) : ℕ → (G → ℂ) → G → ℂ
  | 0, f, x => f x
  | k + 1, f, x => 𝔼 a ∈ X, 𝔼 b ∈ X, bogolyubovSmooth X k f (x + a - b)

theorem bogolyubovSmooth_sub_const {G : Type*} [AddCommGroup G]
    (X : Finset G) (hX : X.Nonempty) (k : ℕ) (f : G → ℂ) (c : ℂ) (x : G) :
    bogolyubovSmooth X k (fun y => f y - c) x = bogolyubovSmooth X k f x - c := by
  induction k generalizing x with
  | zero => rfl
  | succ k ih => simp only [bogolyubovSmooth, ih, Finset.expect_sub_distrib,
      Finset.expect_const hX]

/-- The averaging law is supported on the actual iterated difference set. -/
theorem bogolyubovSmooth_norm_le {G : Type*} [AddCommGroup G] [DecidableEq G]
    (X : Finset G) (hX : X.Nonempty) (k : ℕ) (f : G → ℂ) (x : G) (C : ℝ)
    (h : ∀ u ∈ k • X - k • X, ‖f (x + u)‖ ≤ C) :
    ‖bogolyubovSmooth X k f x‖ ≤ C := by
  induction k generalizing x with
  | zero => simpa [bogolyubovSmooth] using h 0 (by simp)
  | succ k ih =>
    calc
      _ ≤ 𝔼 a ∈ X, ‖𝔼 b ∈ X, bogolyubovSmooth X k f (x + a - b)‖ :=
        RCLike.norm_expect_le (K := ℂ)
      _ ≤ 𝔼 _a ∈ X, 𝔼 _b ∈ X, C := by
        apply Finset.expect_le_expect
        intro a ha
        apply (RCLike.norm_expect_le (K := ℂ)).trans
        apply Finset.expect_le_expect
        intro b hb
        apply ih
        intro u hu
        obtain ⟨v, hv, w, hw, rfl⟩ := Finset.mem_sub.mp hu
        have hm : (v + a) - (w + b) ∈ (k + 1) • X - (k + 1) • X := by
          rw [add_nsmul, one_nsmul]
          exact Finset.sub_mem_sub (Finset.add_mem_add hv ha) (Finset.add_mem_add hw hb)
        convert h _ hm using 1; congr 2; abel
      _ = C := by simp only [Finset.expect_const hX]

/-- Smoothing changes an almost-invariant function by at most its uniform translation error. -/
theorem bogolyubovSmooth_error_le {G : Type*} [AddCommGroup G] [DecidableEq G]
    (X : Finset G) (hX : X.Nonempty) (k : ℕ) (f : G → ℂ) (δ : ℝ)
    (h : ∀ u ∈ k • X - k • X, ∀ x, ‖f (x + u) - f x‖ ≤ δ) (x : G) :
    ‖bogolyubovSmooth X k f x - f x‖ ≤ δ := by
  rw [← bogolyubovSmooth_sub_const X hX k f (f x) x]
  exact bogolyubovSmooth_norm_le X hX k _ x δ (fun u hu => h u hu x)

/-- Probability-normalized cyclic Fourier transform, with the negative-character convention. -/
noncomputable def bogolyubovFourier {q : ℕ} [NeZero q]
    (f : ZMod q → ℂ) (ξ : ZMod q) : ℂ :=
  𝔼 x, f x * ZMod.stdAddChar (-(ξ * x))

theorem bogolyubovFourier_eq_dft {q : ℕ} [NeZero q]
    (f : ZMod q → ℂ) (ξ : ZMod q) :
    bogolyubovFourier f ξ = (q : ℂ)⁻¹ * ZMod.dft f ξ := by
  simp only [bogolyubovFourier, Fintype.expect_eq_sum_div_card, ZMod.card,
    ZMod.dft_apply, smul_eq_mul, div_eq_mul_inv]
  rw [mul_comm]
  congr 1
  apply Finset.sum_congr rfl
  intro x _
  rw [mul_comm x ξ, mul_comm]

theorem bogolyubovFourier_inversion {q : ℕ} [NeZero q]
    (f : ZMod q → ℂ) (x : ZMod q) :
    f x = ∑ ξ, bogolyubovFourier f ξ * ZMod.stdAddChar (ξ * x) := by
  have h := congrFun (ZMod.dft.symm_apply_apply f) x
  rw [ZMod.invDFT_def] at h
  rw [← h]
  simp only [smul_eq_mul, bogolyubovFourier_eq_dft, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro ξ _
  ring

theorem bogolyubovFourier_expect {q : ℕ} [NeZero q] {I : Type*}
    (S : Finset I) (f : I → ZMod q → ℂ) (ξ : ZMod q) :
    bogolyubovFourier (fun x => 𝔼 a ∈ S, f a x) ξ =
      𝔼 a ∈ S, bogolyubovFourier (f a) ξ := by
  simp only [bogolyubovFourier, Finset.expect_mul]
  exact Finset.expect_comm _ _ (fun x a => f a x * ZMod.stdAddChar (-(ξ * x)))

theorem bogolyubovFourier_translate {q : ℕ} [NeZero q]
    (f : ZMod q → ℂ) (a ξ : ZMod q) :
    bogolyubovFourier (fun x => f (x - a)) ξ =
      ZMod.stdAddChar (-(ξ * a)) * bogolyubovFourier f ξ := by
  unfold bogolyubovFourier
  have he := Fintype.expect_equiv (Equiv.addRight a)
    (fun x => f ((x + a) - a) * ZMod.stdAddChar (-(ξ * (x + a))))
    (fun x => f (x - a) * ZMod.stdAddChar (-(ξ * x))) (fun _ => rfl)
  rw [← he]
  simp only [add_sub_cancel_right, mul_add, neg_add,
    AddChar.map_add_eq_mul]
  simp_rw [← mul_assoc]
  rw [← Finset.expect_mul, mul_comm]

theorem bogolyubov_stdChar_conj {q : ℕ} [NeZero q] (x : ZMod q) :
    conj (ZMod.stdAddChar x) = ZMod.stdAddChar (-x) := by
  simp only [ZMod.stdAddChar_apply, AddChar.map_neg_eq_inv, ← Circle.coe_inv_eq_conj,
    Circle.coe_inv]

theorem bogolyubovFourier_average {q : ℕ} [NeZero q] (A : Finset (ZMod q))
    (f : ZMod q → ℂ) (ξ : ZMod q) :
    bogolyubovFourier (bogolyubovAverage A f) ξ =
      (𝔼 a ∈ A, ZMod.stdAddChar (-(ξ * a))) * bogolyubovFourier f ξ := by
  change bogolyubovFourier (fun x => 𝔼 a ∈ A, f (x - a)) ξ = _
  rw [bogolyubovFourier_expect]
  simp only [bogolyubovFourier_translate, ← Finset.expect_mul]

/-- One smoothing step multiplies each Fourier coefficient by the squared character mean. -/
theorem bogolyubovFourier_smooth_step {q : ℕ} [NeZero q]
    (X : Finset (ZMod q)) (f : ZMod q → ℂ) (ξ : ZMod q) :
    bogolyubovFourier (fun x => 𝔼 a ∈ X, 𝔼 b ∈ X, f (x + a - b)) ξ =
      (‖𝔼 a ∈ X, ZMod.stdAddChar (-(ξ * a))‖ ^ 2 : ℝ) * bogolyubovFourier f ξ := by
  have ht (a b : ZMod q) : bogolyubovFourier (fun x => f (x + a - b)) ξ =
      ZMod.stdAddChar (ξ * a) * ZMod.stdAddChar (-(ξ * b)) * bogolyubovFourier f ξ := by
    have he : (fun x => f (x + a - b)) = fun x => f (x - (b - a)) := by
      funext x
      congr 1
      abel
    rw [he, bogolyubovFourier_translate]
    have hc : -(ξ * (b - a)) = ξ * a + -(ξ * b) := by ring
    rw [hc, AddChar.map_add_eq_mul]
  have hc : (𝔼 a ∈ X, ZMod.stdAddChar (ξ * a)) =
      conj (𝔼 a ∈ X, ZMod.stdAddChar (-(ξ * a))) := by
    rw [map_expect]
    simp only [bogolyubov_stdChar_conj, neg_neg]
  simp only [bogolyubovFourier_expect, ht]
  simp_rw [mul_assoc, ← Finset.mul_expect, ← Finset.expect_mul]
  rw [hc, ← mul_assoc, mul_comm (conj _), Complex.mul_conj, Complex.normSq_eq_norm_sq]

/-- The iterated averaging multiplier in blueprint `lem:dense-Bohr`, line 810. -/
theorem bogolyubovFourier_smooth {q : ℕ} [NeZero q]
    (X : Finset (ZMod q)) (k : ℕ) (f : ZMod q → ℂ) (ξ : ZMod q) :
    bogolyubovFourier (bogolyubovSmooth X k f) ξ =
      (‖𝔼 a ∈ X, ZMod.stdAddChar (-(ξ * a))‖ ^ (2 * k) : ℝ) *
        bogolyubovFourier f ξ := by
  induction k with
  | zero => simp [bogolyubovSmooth]
  | succ k ih =>
    change bogolyubovFourier (fun x => 𝔼 a ∈ X, 𝔼 b ∈ X,
      bogolyubovSmooth X k f (x + a - b)) ξ = _
    rw [bogolyubovFourier_smooth_step, ih]
    simp only [Nat.mul_add, Nat.mul_one, pow_add, Complex.ofReal_mul]
    ring

theorem bogolyubovFourier_pairing {q : ℕ} [NeZero q] (f g : ZMod q → ℂ) :
    (𝔼 x, f x * conj (g x)) =
      ∑ ξ, bogolyubovFourier f ξ * conj (bogolyubovFourier g ξ) := by
  have hg (x : ZMod q) : f x * conj (g x) =
      ∑ ξ, (f x * ZMod.stdAddChar (-(ξ * x))) * conj (bogolyubovFourier g ξ) := by
    conv_lhs => rw [bogolyubovFourier_inversion g x]
    simp only [map_sum, map_mul, bogolyubov_stdChar_conj, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro ξ _
    ring
  simp only [hg, Finset.expect_sum_comm, ← Finset.expect_mul, bogolyubovFourier]

theorem bogolyubovFourier_parseval {q : ℕ} [NeZero q] (f : ZMod q → ℂ) :
    (𝔼 x, ‖f x‖ ^ 2) = ∑ ξ, ‖bogolyubovFourier f ξ‖ ^ 2 := by
  have he (g : ZMod q → ℂ) : (𝔼 x, g x).re = 𝔼 x, (g x).re :=
    map_expect (Complex.reCLM.toLinearMap.restrictScalars ℚ≥0) g Finset.univ
  have h := congrArg Complex.re (bogolyubovFourier_pairing f f)
  simpa only [he, Complex.mul_conj, Complex.normSq_eq_norm_sq,
    Complex.ofReal_re, Complex.re_sum] using h

/-- The probability density of a finite subset, relative to normalized counting measure. -/
noncomputable def bogolyubovDensity {G : Type*} [Fintype G] [DecidableEq G]
    (A : Finset G) (x : G) : ℂ :=
  if x ∈ A then (Fintype.card G : ℂ) / A.card else 0

theorem bogolyubovFourier_density {q : ℕ} [NeZero q]
    (A : Finset (ZMod q)) (ξ : ZMod q) :
    bogolyubovFourier (bogolyubovDensity A) ξ =
      𝔼 a ∈ A, ZMod.stdAddChar (-(ξ * a)) := by
  simp only [bogolyubovFourier, bogolyubovDensity, Finset.expect_eq_sum_div_card,
    Finset.card_univ, ZMod.card, ite_mul, zero_mul]
  rw [Finset.sum_ite_mem, ← Finset.mul_sum]
  simp only [Finset.univ_inter]
  have hq : (q : ℂ) ≠ 0 := by exact_mod_cast (NeZero.ne q)
  field_simp

/-- The squared Fourier mass of a probability density is exactly its reciprocal density. -/
theorem bogolyubov_character_mass {q : ℕ} [NeZero q]
    (A : Finset (ZMod q)) (hA : A.Nonempty) :
    (∑ ξ : ZMod q, ‖𝔼 a ∈ A, ZMod.stdAddChar (-(ξ * a))‖ ^ 2) =
      (q : ℝ) / A.card := by
  simp_rw [← bogolyubovFourier_density]
  rw [← bogolyubovFourier_parseval]
  simp only [Fintype.expect_eq_sum_div_card, bogolyubovDensity,
    apply_ite (norm : ℂ → ℝ), norm_div, Complex.norm_natCast, norm_zero,
    ite_pow, zero_pow (by decide : 2 ≠ 0), ZMod.card]
  rw [Finset.sum_ite_mem]
  simp only [Finset.univ_inter, Finset.sum_const, nsmul_eq_mul]
  have hq : (q : ℝ) ≠ 0 := by exact_mod_cast (NeZero.ne q)
  have ha : (A.card : ℝ) ≠ 0 := by exact_mod_cast hA.card_ne_zero
  field_simp

theorem bogolyubovFourier_norm_le_one {q : ℕ} [NeZero q]
    (f : ZMod q → ℂ) (hf : ∀ x, ‖f x‖ ≤ 1) (ξ : ZMod q) :
    ‖bogolyubovFourier f ξ‖ ≤ 1 := by
  calc
    _ ≤ 𝔼 x, ‖f x * ZMod.stdAddChar (-(ξ * x))‖ := RCLike.norm_expect_le (K := ℂ)
    _ ≤ 𝔼 _x : ZMod q, (1 : ℝ) := by
      apply Finset.expect_le_expect
      intro x _
      simpa only [norm_mul, AddChar.norm_apply, mul_one] using hf x
    _ = 1 := Fintype.expect_const _

/-- The positive witness has Fourier l1 mass at most the reciprocal density of `A`. -/
theorem bogolyubov_witness_fourier_mass {q : ℕ} [NeZero q]
    (A : Finset (ZMod q)) (hA : A.Nonempty) :
    (∑ ξ, ‖bogolyubovFourier (fun x => (bogolyubovBaseFunction A x : ℂ)) ξ‖) ≤
      (q : ℝ) / A.card := by
  rw [← bogolyubov_character_mass A hA]
  apply Finset.sum_le_sum
  intro ξ _
  let f : ZMod q → ℂ := fun y => if y ∈ -(A + A) then 1 else 0
  have hf (y : ZMod q) : ‖f y‖ ≤ 1 := by dsimp [f]; split_ifs <;> norm_num
  have he : (fun x => (bogolyubovBaseFunction A x : ℂ)) =
      bogolyubovAverage A (bogolyubovAverage A f) := by
    funext x
    exact bogolyubovBaseFunction_eq_double_average A x
  rw [he, bogolyubovFourier_average, bogolyubovFourier_average, norm_mul, norm_mul]
  have hh := mul_le_mul_of_nonneg_left (bogolyubovFourier_norm_le_one f hf ξ)
    (sq_nonneg ‖𝔼 a ∈ A, ZMod.stdAddChar (-(ξ * a))‖)
  simpa only [sq, mul_one, mul_assoc] using hh

/-- The circle exponential is Lipschitz for the quotient-circle distance. -/
theorem bogolyubov_circle_distance (x : UnitAddCircle) :
    ‖(AddCircle.toCircle x : ℂ) - 1‖ ≤ 2 * Real.pi * ‖x‖ := by
  obtain ⟨y, rfl⟩ := QuotientAddGroup.mk_surjective x
  have hi : ((round y : ℝ) : UnitAddCircle) = 0 := by
    simpa only [zsmul_eq_mul, mul_one, AddCircle.coe_period, smul_zero] using
      (AddCircle.coe_zsmul (p := (1 : ℝ)) (n := round y) (x := (1 : ℝ)))
  have hz : ((y - round y : ℝ) : UnitAddCircle) = (y : UnitAddCircle) := by
    rw [AddCircle.coe_sub, hi, sub_zero]
  rw [← hz, AddCircle.toCircle_apply_mk, Circle.coe_exp]
  have h := Real.norm_exp_I_mul_ofReal_sub_one_le (x := 2 * Real.pi * (y - round y))
  simp only [div_one] at *
  rw [mul_comm _ Complex.I]
  apply h.trans_eq
  rw [hz, UnitAddCircle.norm_eq, Real.norm_eq_abs, abs_mul,
    abs_of_nonneg (by positivity : 0 ≤ 2 * Real.pi)]

theorem bogolyubov_stdChar_distance {q : ℕ} [NeZero q] (x : ZMod q) :
    ‖ZMod.stdAddChar x - 1‖ ≤ 2 * Real.pi * ‖ZMod.toAddCircle x‖ :=
  bogolyubov_circle_distance (ZMod.toAddCircle x)

/-- A Bohr set, using the quotient norm on the additive circle. -/
noncomputable def bogolyubovBohrSet {q : ℕ} [NeZero q]
    (S : Finset (ZMod q)) (ρ : ℝ) : Finset (ZMod q) := by
  classical
  exact Finset.univ.filter (fun u => ∀ s ∈ S, ‖ZMod.toAddCircle (s * u)‖ < ρ)

theorem mem_bogolyubovBohrSet {q : ℕ} [NeZero q]
    (S : Finset (ZMod q)) (ρ : ℝ) (u : ZMod q) :
    u ∈ bogolyubovBohrSet S ρ ↔ ∀ s ∈ S, ‖ZMod.toAddCircle (s * u)‖ < ρ := by
  classical
  simp [bogolyubovBohrSet]

/-- Every frequency in the signed span has controlled phase on the Bohr set. -/
theorem bogolyubov_span_phase {q : ℕ} [NeZero q]
    (S : Finset (ZMod q)) {ρ : ℝ} (hρ : 0 ≤ ρ) {u ξ : ZMod q}
    (hu : u ∈ bogolyubovBohrSet S ρ) (hξ : ξ ∈ S.addSpan) :
    ‖ZMod.stdAddChar (ξ * u) - 1‖ ≤ 2 * Real.pi * S.card * ρ := by
  have hs := (mem_bogolyubovBohrSet S ρ u).mp hu
  obtain ⟨ε, hε, rfl⟩ := Finset.mem_addSpan.mp hξ
  have hnorm : ‖ZMod.toAddCircle ((∑ s ∈ S, ε s • s) * u)‖ ≤ (S.card : ℝ) * ρ := by
    rw [Finset.sum_mul, map_sum]
    apply (norm_sum_le _ _).trans
    calc
      _ ≤ ∑ _s ∈ S, ρ := by
        apply Finset.sum_le_sum
        intro s hs'
        rcases hε s with he | he | he
        · simpa only [he, neg_one_zsmul, neg_mul, map_neg, norm_neg] using (hs s hs').le
        · simpa only [he, zero_zsmul, zero_mul, map_zero, norm_zero] using hρ
        · simpa only [he, one_zsmul] using (hs s hs').le
      _ = _ := by simp
  apply (bogolyubov_stdChar_distance _).trans
  simpa only [mul_assoc] using
    mul_le_mul_of_nonneg_left hnorm (by positivity : 0 ≤ 2 * Real.pi)

/-- Chang's theorem at threshold one half, in the exact cyclic character convention. -/
theorem bogolyubov_spectrum_generators {q : ℕ} [NeZero q]
    (X : Finset (ZMod q)) (hX : X.Nonempty) :
    ∃ S : Finset (ZMod q), (S.card : ℝ) ≤ 16 * Real.log ((q : ℝ) / X.card) ∧
      ∀ ξ, 1 / 2 ≤ ‖𝔼 a ∈ X, ZMod.stdAddChar (-(ξ * a))‖ → ξ ∈ S.addSpan := by
  classical
  obtain ⟨Λ, _, hcard, hspan⟩ := characterSpectrum_generators X hX
    (show (0 : ℝ) < 1 / 2 by norm_num) (show (1 / 2 : ℝ) ≤ 1 by norm_num)
  let e := cyclicFrequencyEquiv q
  refine ⟨Λ.image e.symm, ?_, ?_⟩
  · simpa only [Finset.card_image_of_injective _ e.symm.injective, ZMod.card,
      show (4 / (1 / 2 : ℝ) ^ 2) = 16 by norm_num] using hcard
  · intro ξ hξ
    rw [addSpan_image_equiv]
    apply Finset.mem_image.mpr
    refine ⟨e ξ, hspan ?_, e.symm_apply_apply ξ⟩
    rw [mem_largeCharacterSpectrum]
    simpa only [characterMean, e, cyclicFrequencyEquiv_apply] using hξ

theorem bogolyubov_character_mean_norm_le {q : ℕ} [NeZero q]
    (X : Finset (ZMod q)) (hX : X.Nonempty) (ξ : ZMod q) :
    ‖𝔼 a ∈ X, ZMod.stdAddChar (-(ξ * a))‖ ≤ 1 := by
  calc
    _ ≤ 𝔼 a ∈ X, ‖ZMod.stdAddChar (-(ξ * a))‖ := RCLike.norm_expect_le (K := ℂ)
    _ = 1 := by simp only [AddChar.norm_apply, Finset.expect_const hX]

/-- Splitting at spectral threshold one half gives the uniform Fourier translation estimate. -/
theorem bogolyubov_spectrum_split {q : ℕ} [NeZero q]
    (X : Finset (ZMod q)) (hX : X.Nonempty) (S : Finset (ZMod q))
    (hS : ∀ ξ, 1 / 2 ≤ ‖𝔼 a ∈ X, ZMod.stdAddChar (-(ξ * a))‖ → ξ ∈ S.addSpan)
    (k : ℕ) (f : ZMod q → ℂ) {M ρ : ℝ} (hρ : 0 ≤ ρ)
    (hM : (∑ ξ, ‖bogolyubovFourier f ξ‖) ≤ M)
    {u : ZMod q} (hu : u ∈ bogolyubovBohrSet S ρ) :
    ‖bogolyubovSmooth X k f u - bogolyubovSmooth X k f 0‖ ≤
      M * (2 * Real.pi * S.card * ρ + 2 * (1 / 2 : ℝ) ^ (2 * k)) := by
  classical
  let B : ℝ := 2 * Real.pi * S.card * ρ
  let T : ℝ := 2 * (1 / 2 : ℝ) ^ (2 * k)
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hT : 0 ≤ T := by dsimp [T]; positivity
  have he : bogolyubovSmooth X k f u - bogolyubovSmooth X k f 0 =
      ∑ ξ, bogolyubovFourier (bogolyubovSmooth X k f) ξ *
        (ZMod.stdAddChar (ξ * u) - 1) := by
    rw [bogolyubovFourier_inversion (bogolyubovSmooth X k f) u,
      bogolyubovFourier_inversion (bogolyubovSmooth X k f) 0,
      ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro ξ _
    simp only [mul_zero, AddChar.map_zero_eq_one, mul_one]
    ring
  have ht (ξ : ZMod q) :
      ‖𝔼 a ∈ X, ZMod.stdAddChar (-(ξ * a))‖ ^ (2 * k) *
        ‖ZMod.stdAddChar (ξ * u) - 1‖ ≤ B + T := by
    by_cases hlarge : 1 / 2 ≤ ‖𝔼 a ∈ X, ZMod.stdAddChar (-(ξ * a))‖
    · have hp := bogolyubov_span_phase S hρ hu (hS ξ hlarge)
      have hc := pow_le_one₀ (norm_nonneg _) (bogolyubov_character_mean_norm_le X hX ξ)
        (n := 2 * k)
      calc
        _ ≤ 1 * B := mul_le_mul hc hp (norm_nonneg _) (by norm_num)
        _ ≤ B + T := by linarith
    · have hc : ‖𝔼 a ∈ X, ZMod.stdAddChar (-(ξ * a))‖ ^ (2 * k) ≤
          (1 / 2 : ℝ) ^ (2 * k) := pow_le_pow_left₀ (norm_nonneg _) (le_of_not_ge hlarge) _
      have hp : ‖ZMod.stdAddChar (ξ * u) - 1‖ ≤ 2 := by
        simpa only [AddChar.norm_apply, norm_one, one_add_one_eq_two] using
          norm_sub_le (ZMod.stdAddChar (ξ * u)) (1 : ℂ)
      calc
        _ ≤ (1 / 2 : ℝ) ^ (2 * k) * 2 :=
          mul_le_mul hc hp (norm_nonneg _) (by positivity)
        _ ≤ B + T := by dsimp [T]; nlinarith
  rw [he]
  calc
    _ ≤ ∑ ξ, ‖bogolyubovFourier (bogolyubovSmooth X k f) ξ *
        (ZMod.stdAddChar (ξ * u) - 1)‖ := norm_sum_le _ _
    _ ≤ ∑ ξ, ‖bogolyubovFourier f ξ‖ * (B + T) := by
      apply Finset.sum_le_sum
      intro ξ _
      rw [norm_mul, bogolyubovFourier_smooth, norm_mul, Complex.norm_real,
        Real.norm_of_nonneg (by positivity)]
      nlinarith [mul_le_mul_of_nonneg_left (ht ξ) (norm_nonneg (bogolyubovFourier f ξ))]
    _ = (∑ ξ, ‖bogolyubovFourier f ξ‖) * (B + T) := (Finset.sum_mul ..).symm
    _ ≤ M * (B + T) := mul_le_mul_of_nonneg_right hM (add_nonneg hB hT)

/-- The logarithmic iteration count suppresses the small spectrum by the required constant. -/
theorem bogolyubov_small_spectrum_error {α : ℝ} (hα : 0 < α) (hα1 : α ≤ 1) :
    (1 / α) * (2 * (1 / 2 : ℝ) ^ (2 * bogolyubovIterations α)) ≤ 1 / 100 := by
  let k := bogolyubovIterations α
  have h2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hk : 10 + Real.log (1 / α) / Real.log 2 ≤ (k : ℝ) := Nat.le_ceil _
  have hl : Real.log (1 / α) + 10 * Real.log 2 ≤ Real.log 2 * k := by
    have hh := mul_le_mul_of_nonneg_right hk h2.le
    rw [add_mul, div_mul_cancel₀ _ h2.ne'] at hh
    nlinarith
  have hb : (1 / α) * (2 : ℝ) ^ 10 ≤ (2 : ℝ) ^ k := by
    have hh := Real.exp_le_exp.mpr hl
    have he10 : Real.exp (10 * Real.log 2) = (2 : ℝ) ^ 10 := by
      rw [mul_comm, Real.exp_mul, Real.exp_log (by norm_num : (0 : ℝ) < 2)]
      norm_num
    rw [Real.exp_add, Real.exp_log (by positivity), he10, Real.exp_mul,
      Real.exp_log (by norm_num : (0 : ℝ) < 2), Real.rpow_natCast] at hh
    exact hh
  have hpow : (0 : ℝ) < 2 ^ k := by positivity
  have hhalf : (1 / 2 : ℝ) ^ k ≤ α / 1024 := by
    rw [div_pow, one_pow]
    apply (div_le_div_iff₀ hpow (by norm_num : (0 : ℝ) < 1024)).mpr
    have hh := mul_le_mul_of_nonneg_left hb hα.le
    norm_num at hh
    field_simp at hh
    nlinarith
  have hdec : (1 / 2 : ℝ) ^ (2 * k) ≤ (1 / 2 : ℝ) ^ k := by
    rw [mul_comm 2 k, pow_mul]
    have hh := pow_le_one₀ (by norm_num : (0 : ℝ) ≤ 1 / 2)
      (by norm_num : (1 / 2 : ℝ) ≤ 1) (n := k)
    nlinarith [pow_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2) k]
  calc
    _ ≤ (1 / α) * (2 * (α / 1024)) := by gcongr; exact hdec.trans hhalf
    _ = 1 / 512 := by field_simp; ring
    _ ≤ 1 / 100 := by norm_num

/-- The source radius balances the large spectrum against reciprocal density. -/
noncomputable def bogolyubovRadius (α : ℝ) (d : ℕ) : ℝ := α / (1000 * (d + 1))

theorem bogolyubov_large_spectrum_error {α : ℝ} (hα : 0 < α) (d : ℕ) :
    (1 / α) * (2 * Real.pi * d * bogolyubovRadius α d) ≤ 1 / 100 := by
  have hd : (0 : ℝ) < (d : ℝ) + 1 := by positivity
  have he : (1 / α) * (2 * Real.pi * d * bogolyubovRadius α d) =
      2 * Real.pi * d / (1000 * (d + 1)) := by
    unfold bogolyubovRadius
    field_simp
  rw [he]
  apply (div_le_iff₀ (by positivity : (0 : ℝ) < 1000 * (d + 1))).mpr
  nlinarith [Real.pi_lt_four, mul_le_mul_of_nonneg_right Real.pi_lt_four.le
    (Nat.cast_nonneg d : (0 : ℝ) ≤ d)]

/-- Sampling and Chang produce a smoothing that is close to the positive witness and nearly
constant on a Bohr set. This completes the spectral estimate of `lem:dense-Bohr`. -/
theorem bogolyubov_smoothing_structure {q : ℕ} [NeZero q]
    (A : Finset (ZMod q)) (hA : A.Nonempty) :
    let α := (A.card : ℝ) / q
    let F := fun x => (bogolyubovBaseFunction A x : ℂ)
    ∃ X S : Finset (ZMod q), X.Nonempty ∧
      α ^ bogolyubovSampleSize α / 2 ≤ (X.card : ℝ) / q ∧
      (S.card : ℝ) ≤ 16 * Real.log ((q : ℝ) / X.card) ∧
      (∀ x, ‖bogolyubovSmooth X (bogolyubovIterations α) F x - F x‖ ≤ 1 / 100) ∧
      ∀ u ∈ bogolyubovBohrSet S (bogolyubovRadius α S.card),
        ‖bogolyubovSmooth X (bogolyubovIterations α) F u -
          bogolyubovSmooth X (bogolyubovIterations α) F 0‖ ≤ 1 / 50 := by
  dsimp only
  let α : ℝ := (A.card : ℝ) / q
  let F : ZMod q → ℂ := fun x => (bogolyubovBaseFunction A x : ℂ)
  have hq : (0 : ℝ) < q := Nat.cast_pos.mpr (NeZero.pos q)
  have hα : 0 < α := by dsimp [α]; positivity
  have hα1 : α ≤ 1 := by
    dsimp [α]
    apply (div_le_one (by positivity : 0 < (q : ℝ))).mpr
    exact_mod_cast (show A.card ≤ q by simpa only [ZMod.card] using Finset.card_le_univ A)
  obtain ⟨X, hX, hd, ht⟩ := bogolyubov_witness_almost_periods A hA
  simp only [ZMod.card] at hd ht
  obtain ⟨S, hcard, hS⟩ := bogolyubov_spectrum_generators X hX
  refine ⟨X, S, hX, hd, hcard, ?_, ?_⟩
  · intro x
    apply bogolyubovSmooth_error_le X hX _ F (1 / 100) _ x
    intro u hu y
    simpa only [F, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs] using ht u hu y
  · intro u hu
    have hρ : 0 ≤ bogolyubovRadius α S.card := by unfold bogolyubovRadius; positivity
    have hmass : (∑ ξ, ‖bogolyubovFourier F ξ‖) ≤ 1 / α := by
      simpa only [α, one_div_div] using bogolyubov_witness_fourier_mass A hA
    have hh := bogolyubov_spectrum_split X hX S hS (bogolyubovIterations α) F hρ hmass hu
    apply hh.trans
    rw [mul_add]
    have hl := bogolyubov_large_spectrum_error hα S.card
    have hs := bogolyubov_small_spectrum_error hα hα1
    linarith

/-- The logarithmic parameter used in the quasipolynomial estimates. -/
noncomputable def bogolyubovLog (α : ℝ) : ℝ := 1 + Real.log (1 / α)

theorem bogolyubovLog_one_le {α : ℝ} (hα : 0 < α) (hα1 : α ≤ 1) :
    1 ≤ bogolyubovLog α := by
  have h := Real.log_nonneg ((one_le_div hα).mpr hα1)
  dsimp [bogolyubovLog]
  linarith

/-- Explicit polynomial logarithmic bounds for the source parameters. -/
theorem bogolyubov_parameters_polynomial {α : ℝ} (hα : 0 < α) (hα1 : α ≤ 1) :
    bogolyubovExponent α ≤ 2 * bogolyubovLog α ∧
    (bogolyubovIterations α : ℝ) ≤ 16 * bogolyubovLog α ∧
    (bogolyubovTolerance α)⁻¹ ≤ 48000 * bogolyubovLog α ∧
    (bogolyubovSampleSize α : ℝ) ≤ 10 ^ 12 * bogolyubovLog α ^ 3 := by
  let L := bogolyubovLog α
  have hL : 1 ≤ L := bogolyubovLog_one_le hα hα1
  have hl : 0 ≤ Real.log (1 / α) := Real.log_nonneg ((one_le_div hα).mpr hα1)
  have h2 : (1 / 2 : ℝ) ≤ Real.log 2 := by linarith [Real.log_two_gt_d9]
  have h2pos : 0 < Real.log 2 := by linarith
  have hp : bogolyubovExponent α ≤ 2 * L := by
    apply max_le <;> dsimp [L, bogolyubovLog] at * <;> linarith
  have hk : (bogolyubovIterations α : ℝ) ≤ 16 * L := by
    have hd : Real.log (1 / α) / Real.log 2 ≤ 2 * Real.log (1 / α) := by
      apply (div_le_iff₀ h2pos).mpr
      nlinarith [mul_nonneg hl (sub_nonneg.mpr h2)]
    have hc := (Nat.ceil_lt_add_one
      (show 0 ≤ 10 + Real.log (1 / α) / Real.log 2 by positivity)).le
    change (bogolyubovIterations α : ℝ) ≤ _ at hc
    dsimp [L, bogolyubovLog] at *
    linarith
  have ht : (bogolyubovTolerance α)⁻¹ ≤ 48000 * L := by
    simp only [bogolyubovTolerance, inv_inv]
    calc
      _ ≤ 1000 * 3 * (16 * L) := by
        gcongr
        exact Real.exp_one_lt_three.le
      _ = _ := by ring
  refine ⟨hp, hk, ht, ?_⟩
  have hp0 : 0 ≤ bogolyubovExponent α := (by norm_num : (0 : ℝ) ≤ 2).trans (le_max_left _ _)
  have ht0 := (bogolyubovTolerance_pos hα hα1).le
  calc
    _ ≤ 65 * bogolyubovExponent α / bogolyubovTolerance α ^ 2 :=
      bogolyubovSampleSize_le hα hα1
    _ = 65 * bogolyubovExponent α * ((bogolyubovTolerance α)⁻¹) ^ 2 := by
      rw [inv_pow, div_eq_mul_inv]
    _ ≤ 65 * (2 * L) * (48000 * L) ^ 2 := by gcongr
    _ ≤ 10 ^ 12 * L ^ 3 := by nlinarith [pow_nonneg (by linarith : 0 ≤ L) 3]

/-- The sampling density costs at most four powers of the logarithmic parameter. -/
theorem bogolyubov_log_density_bound {α β : ℝ} (hα : 0 < α) (hα1 : α ≤ 1)
    (_hβ : 0 < β) (hd : α ^ bogolyubovSampleSize α / 2 ≤ β) :
    Real.log (1 / β) ≤ 2 * 10 ^ 12 * bogolyubovLog α ^ 4 := by
  let L := bogolyubovLog α
  have hL : 1 ≤ L := bogolyubovLog_one_le hα hα1
  have hL0 : 0 ≤ L := by linarith
  have hl := Real.log_le_log (by positivity : 0 < α ^ bogolyubovSampleSize α / 2) hd
  rw [Real.log_div (by positivity) (by norm_num), Real.log_pow] at hl
  have ha : Real.log α = -(L - 1) := by
    dsimp [L, bogolyubovLog]
    rw [one_div, Real.log_inv]
    ring
  have hb : Real.log (1 / β) = -Real.log β := by rw [one_div, Real.log_inv]
  have hn := (bogolyubov_parameters_polynomial hα hα1).2.2.2
  have hp : (bogolyubovSampleSize α : ℝ) * (L - 1) ≤ 10 ^ 12 * L ^ 4 := by
    calc
      _ ≤ (10 ^ 12 * L ^ 3) * L := mul_le_mul hn (by linarith)
        (by linarith) (by positivity)
      _ = _ := by ring
  have hL4 : 1 ≤ L ^ 4 := one_le_pow₀ hL
  have hlog2 : Real.log 2 ≤ 1 := by
    have h := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)
    linarith
  rw [ha] at hl
  rw [hb]
  nlinarith

/-- The quantitative Bohr containment obtained from the positive witness. -/
theorem bogolyubov_bohr_containment {q : ℕ} [NeZero q]
    (A : Finset (ZMod q)) (hA : A.Nonempty) :
    let α := (A.card : ℝ) / q
    ∃ S : Finset (ZMod q), (S.card : ℝ) ≤ 10 ^ 14 * bogolyubovLog α ^ 4 ∧
      bogolyubovBohrSet S (bogolyubovRadius α S.card) ⊆ 2 • A - 2 • A := by
  dsimp only
  let α : ℝ := (A.card : ℝ) / q
  let F : ZMod q → ℂ := fun x => (bogolyubovBaseFunction A x : ℂ)
  have hq : (0 : ℝ) < q := Nat.cast_pos.mpr (NeZero.pos q)
  have hα : 0 < α := by dsimp [α]; positivity
  have hα1 : α ≤ 1 := by
    apply (div_le_one hq).mpr
    exact_mod_cast (show A.card ≤ q by simpa only [ZMod.card] using Finset.card_le_univ A)
  obtain ⟨X, S, hX, hd, hcard, hclose, hflat⟩ := bogolyubov_smoothing_structure A hA
  refine ⟨S, ?_, ?_⟩
  · have hβ : (0 : ℝ) < (X.card : ℝ) / q := by positivity
    have hlog := bogolyubov_log_density_bound hα hα1 hβ hd
    rw [one_div_div] at hlog
    nlinarith [pow_nonneg (le_trans (by norm_num) (bogolyubovLog_one_le hα hα1)) 4]
  · intro u hu
    let F' := bogolyubovSmooth X (bogolyubovIterations α) F
    have hc0 : ‖F' 0 - F 0‖ ≤ 1 / 100 := hclose 0
    have hcu : ‖F u - F' u‖ ≤ 1 / 100 := by rw [norm_sub_rev]; exact hclose u
    have hfu : ‖F' u - F' 0‖ ≤ 1 / 50 := hflat u hu
    have hh : ‖F u - F 0‖ ≤ 1 / 25 := by
      have he : F u - F 0 = (F u - F' u) + (F' u - F' 0) + (F' 0 - F 0) := by abel
      rw [he]
      have h1 := norm_add_le ((F u - F' u) + (F' u - F' 0)) (F' 0 - F 0)
      have h2 := norm_add_le (F u - F' u) (F' u - F' 0)
      linarith
    have hreal : |bogolyubovBaseFunction A u - 1| ≤ 1 / 25 := by
      simpa only [F, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs,
        bogolyubovBaseFunction_zero A hA] using hh
    apply bogolyubovBaseFunction_pos_mem
    have hlow := (abs_le.mp hreal).1
    linarith

/-- The source radius is positive, small, and has a polynomial logarithmic reciprocal. -/
theorem bogolyubov_radius_bounds {α : ℝ} (hα : 0 < α) (hα1 : α ≤ 1) (d : ℕ)
    (hd : (d : ℝ) ≤ 10 ^ 14 * bogolyubovLog α ^ 4) :
    0 < bogolyubovRadius α d ∧ bogolyubovRadius α d < 1 / 2 ∧
      (bogolyubovRadius α d)⁻¹ ≤ 10 ^ 18 * α⁻¹ * bogolyubovLog α ^ 4 := by
  have hL : 1 ≤ bogolyubovLog α := bogolyubovLog_one_le hα hα1
  have hL4 : 1 ≤ bogolyubovLog α ^ 4 := one_le_pow₀ hL
  have hpos : 0 < bogolyubovRadius α d := by unfold bogolyubovRadius; positivity
  refine ⟨hpos, ?_, ?_⟩
  · unfold bogolyubovRadius
    apply (div_lt_iff₀ (by positivity : (0 : ℝ) < 1000 * (d + 1))).mpr
    nlinarith [Nat.cast_nonneg d (α := ℝ)]
  · have he : (bogolyubovRadius α d)⁻¹ = 1000 * ((d : ℝ) + 1) * α⁻¹ := by
      simp only [bogolyubovRadius, div_eq_mul_inv, mul_inv_rev, inv_inv]
    rw [he, mul_assoc (10 ^ 18), mul_comm α⁻¹, ← mul_assoc]
    apply mul_le_mul_of_nonneg_right _ (inv_nonneg.mpr hα.le)
    nlinarith

/-- The logarithm of the inverse radius costs only one more logarithmic factor. -/
theorem bogolyubov_radius_log_bound {α : ℝ} (hα : 0 < α) (hα1 : α ≤ 1) (d : ℕ)
    (hd : (d : ℝ) ≤ 10 ^ 14 * bogolyubovLog α ^ 4) :
    Real.log (3 / bogolyubovRadius α d) ≤ 4 * 10 ^ 18 * bogolyubovLog α := by
  let L := bogolyubovLog α
  have hL : 1 ≤ L := bogolyubovLog_one_le hα hα1
  have hL0 : 0 < L := by linarith
  obtain ⟨hρ, _, hinv⟩ := bogolyubov_radius_bounds hα hα1 d hd
  have hb : 3 / bogolyubovRadius α d ≤ 3 * 10 ^ 18 * α⁻¹ * L ^ 4 := by
    rw [div_eq_mul_inv]
    nlinarith [mul_le_mul_of_nonneg_left hinv (by norm_num : (0 : ℝ) ≤ 3)]
  have hh := Real.log_le_log (by positivity : 0 < 3 / bogolyubovRadius α d) hb
  rw [Real.log_mul (by positivity) (by positivity),
    Real.log_mul (by positivity) (by positivity), Real.log_pow, Real.log_inv] at hh
  have ha : -Real.log α = L - 1 := by
    dsimp [L, bogolyubovLog]
    rw [one_div, Real.log_inv]
    ring
  have hc : Real.log (3 * 10 ^ 18) ≤ 3 * 10 ^ 18 := Real.log_le_self (by positivity)
  have hlogL : Real.log L ≤ L := Real.log_le_self hL0.le
  rw [ha] at hh
  change Real.log (3 / bogolyubovRadius α d) ≤ 4 * 10 ^ 18 * L
  norm_num at hh hc ⊢
  nlinarith

end TrilinearHT.Auto

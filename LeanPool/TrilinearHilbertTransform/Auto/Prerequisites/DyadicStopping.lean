open MeasureTheory Filter
open scoped ENNReal

/-- A real dyadic grid as in blueprint line 364. Each level is a translated
interval partition; the alignment condition makes each coarse boundary a fine boundary. -/
structure RealDyadicGrid where
  baseLength : ℝ
  baseLength_pos : 0 < baseLength
  origin : ℤ → ℝ
  alignment : ∀ s : ℤ, ∃ k : ℤ, origin s = origin (s + 1) +
    (k : ℝ) * (baseLength * (2 : ℝ) ^ (-(s + 1)))

noncomputable def dyadicGridLength (G : RealDyadicGrid) (s : ℤ) : ℝ :=
  G.baseLength * (2 : ℝ) ^ (-s)

theorem dyadicGridLength_pos (G : RealDyadicGrid) (s : ℤ) : 0 < dyadicGridLength G s :=
  mul_pos G.baseLength_pos (zpow_pos (by norm_num) _)

noncomputable def dyadicGridLeft (G : RealDyadicGrid) (s m : ℤ) : ℝ :=
  G.origin s + (m : ℝ) * dyadicGridLength G s

/-- Half-open cells, with integer depth and position, from blueprint line 364. -/
noncomputable def dyadicGridCell (G : RealDyadicGrid) (s m : ℤ) : Set ℝ :=
  Set.Ico (dyadicGridLeft G s m) (dyadicGridLeft G s m + dyadicGridLength G s)

theorem dyadicGridCell_measurable (G : RealDyadicGrid) (s m : ℤ) :
    MeasurableSet (dyadicGridCell G s m) := measurableSet_Ico

theorem dyadicGridCell_volume (G : RealDyadicGrid) (s m : ℤ) :
    volume (dyadicGridCell G s m) = ENNReal.ofReal (dyadicGridLength G s) := by
  simp [dyadicGridCell, Real.volume_Ico]

theorem dyadicGridCell_disjoint_of_lt (G : RealDyadicGrid) (s : ℤ)
    {m n : ℤ} (hmn : m < n) : Disjoint (dyadicGridCell G s m) (dyadicGridCell G s n) := by
  apply Set.disjoint_left.mpr
  intro x hxm hxn
  have hr := dyadicGridLength_pos G s
  have hmn' : (m : ℝ) + 1 ≤ n := by exact_mod_cast (show m + 1 ≤ n by omega)
  have hmul := mul_le_mul_of_nonneg_right hmn' hr.le
  change G.origin s + (m : ℝ) * dyadicGridLength G s ≤ x ∧
    x < G.origin s + (m : ℝ) * dyadicGridLength G s + dyadicGridLength G s at hxm
  change G.origin s + (n : ℝ) * dyadicGridLength G s ≤ x ∧
    x < G.origin s + (n : ℝ) * dyadicGridLength G s + dyadicGridLength G s at hxn
  nlinarith only [hxm.2, hxn.1, hr, hmn']

theorem dyadicGridCell_pairwiseDisjoint (G : RealDyadicGrid) (s : ℤ) :
    Pairwise (fun m n => Disjoint (dyadicGridCell G s m) (dyadicGridCell G s n)) := by
  intro m n hmn
  rcases lt_or_gt_of_ne hmn with h | h
  · exact dyadicGridCell_disjoint_of_lt G s h
  · exact (dyadicGridCell_disjoint_of_lt G s h).symm

theorem dyadicGridCell_covers (G : RealDyadicGrid) (s : ℤ) (x : ℝ) :
    ∃ m : ℤ, x ∈ dyadicGridCell G s m := by
  let r := dyadicGridLength G s
  let t := (x - G.origin s) / r
  have hr : 0 < r := dyadicGridLength_pos G s
  have ht : t * r = x - G.origin s := div_mul_cancel₀ _ hr.ne'
  have hlo := mul_le_mul_of_nonneg_right (Int.floor_le t) hr.le
  have hhi := mul_lt_mul_of_pos_right (Int.lt_floor_add_one t) hr
  refine ⟨⌊t⌋, ?_⟩
  change G.origin s + (⌊t⌋ : ℝ) * r ≤ x ∧
    x < G.origin s + (⌊t⌋ : ℝ) * r + r
  constructor <;> nlinarith

theorem dyadicGridLength_half (G : RealDyadicGrid) (s : ℤ) :
    dyadicGridLength G (s + 1) * 2 = dyadicGridLength G s := by
  unfold dyadicGridLength
  rw [neg_add, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
  norm_num
  ring

/-- Each source grid cell is exactly the union of its two consecutive children. -/
theorem dyadicGridCell_children (G : RealDyadicGrid) (s m : ℤ) :
    ∃ n : ℤ, dyadicGridCell G s m =
      dyadicGridCell G (s + 1) n ∪ dyadicGridCell G (s + 1) (n + 1) := by
  obtain ⟨k, hk⟩ := G.alignment s
  refine ⟨k + 2 * m, ?_⟩
  have hr := dyadicGridLength_pos G (s + 1)
  have hh := dyadicGridLength_half G s
  have hleft : dyadicGridLeft G s m = dyadicGridLeft G (s + 1) (k + 2 * m) := by
    unfold dyadicGridLeft
    rw [hk, ← hh]
    push_cast
    change G.origin (s + 1) + (k : ℝ) * dyadicGridLength G (s + 1) +
      (m : ℝ) * (dyadicGridLength G (s + 1) * 2) = _
    ring
  have hnext : dyadicGridLeft G (s + 1) (k + 2 * m + 1) =
      dyadicGridLeft G (s + 1) (k + 2 * m) + dyadicGridLength G (s + 1) := by
    simp only [dyadicGridLeft, Int.cast_add, Int.cast_one]
    ring
  unfold dyadicGridCell
  rw [hleft, hnext, ← hh]
  have he : dyadicGridLeft G (s + 1) (k + 2 * m) +
      dyadicGridLength G (s + 1) + dyadicGridLength G (s + 1) =
      dyadicGridLeft G (s + 1) (k + 2 * m) + dyadicGridLength G (s + 1) * 2 := by ring
  rw [he, Set.Ico_union_Ico_eq_Ico (by linarith) (by linarith)]

open scoped Classical in
/-- The nonnegative path sum through a finite family of dyadic cells. -/
noncomputable def dyadicPathSum (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ≥0∞) (x : ℝ) : ℝ≥0∞ :=
  ∑ c ∈ S, (dyadicGridCell G c.1 c.2).indicator (fun _ => a c) x

/-- Blueprint `eq:path`, lines 424–428: summing cell length times weight
is exactly the integral of the path sum on a containing root. -/
theorem dyadicPathIntegral (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ≥0∞) (R : Set ℝ)
    (hR : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ R) :
    (∑ c ∈ S, ENNReal.ofReal (dyadicGridLength G c.1) * a c) =
      ∫⁻ x in R, dyadicPathSum G S a x := by
  classical
  unfold dyadicPathSum
  rw [lintegral_finsetSum _ (fun c _ =>
    measurable_const.indicator (dyadicGridCell_measurable G c.1 c.2))]
  apply Finset.sum_congr rfl
  intro c hc
  rw [lintegral_indicator (dyadicGridCell_measurable G c.1 c.2),
    Measure.restrict_restrict_of_subset (hR c hc), setLIntegral_const,
    dyadicGridCell_volume, mul_comm]

/-- The ordinary real-integral form of blueprint `eq:path`. It holds even
for signed real weights, since the cell family is finite. -/
theorem dyadicPathIntegral_real (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (R : Set ℝ)
    (hR : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ R) :
    (∑ c ∈ S, dyadicGridLength G c.1 * a c) =
      ∫ x in R, ∑ c ∈ S, (dyadicGridCell G c.1 c.2).indicator (fun _ => a c) x := by
  classical
  have hi (c) (hc : c ∈ S) : Integrable
      ((dyadicGridCell G c.1 c.2).indicator (fun _ => a c)) (volume.restrict R) := by
    apply (integrable_indicator_iff (dyadicGridCell_measurable G c.1 c.2)).mpr
    change Integrable _ ((volume.restrict R).restrict (dyadicGridCell G c.1 c.2))
    rw [Measure.restrict_restrict_of_subset (hR c hc)]
    exact integrableOn_const (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_ne_top)
  rw [integral_finsetSum _ hi]
  apply Finset.sum_congr rfl
  intro c hc
  rw [integral_indicator (dyadicGridCell_measurable G c.1 c.2),
    Measure.restrict_restrict_of_subset (hR c hc), setIntegral_const,
    Measure.real, dyadicGridCell_volume, ENNReal.toReal_ofReal (dyadicGridLength_pos G c.1).le,
    smul_eq_mul]

theorem finite_union_weight_le {ι α : Type*} [DecidableEq α]
    (T : Finset ι) (F : ι → Finset α) (w : α → ℝ) (hw : ∀ x, 0 ≤ w x) :
    (∑ x ∈ T.biUnion F, w x) ≤ ∑ i ∈ T, ∑ x ∈ F i, w x := by
  classical
  induction T using Finset.induction with
  | empty => simp
  | @insert i T hi ih =>
    rw [Finset.biUnion_insert, Finset.sum_insert hi]
    have hsum := Finset.sum_union_inter (s₁ := F i) (s₂ := T.biUnion F) (f := w)
    have hnonneg : 0 ≤ ∑ x ∈ F i ∩ T.biUnion F, w x := Finset.sum_nonneg (fun x _ => hw x)
    linarith only [ih, hsum, hnonneg]

/-- Blueprint path-packing, line 429: every restart generation loses at
least the fixed fraction `1 - ρ` of total root length. -/
theorem restart_generation_decay (g : ℕ → ℝ) {ρ L : ℝ} (hρ : 0 ≤ ρ)
    (hzero : g 0 ≤ L) (hstep : ∀ k, g (k + 1) ≤ ρ * g k) :
    ∀ k, g k ≤ ρ ^ k * L := by
  intro k
  induction k with
  | zero => simpa using hzero
  | succ k ih =>
    calc
      _ ≤ ρ * g k := hstep k
      _ ≤ ρ * (ρ ^ k * L) := mul_le_mul_of_nonneg_left ih hρ
      _ = _ := by rw [pow_succ]; ring

/-- Blueprint path-packing, line 429: the total length over all restart
generations is summable and at most the initial root length divided by `1-ρ`. -/
theorem restart_total_length (g : ℕ → ℝ) (hg : ∀ k, 0 ≤ g k)
    {ρ L : ℝ} (hρ : 0 ≤ ρ) (hρ1 : ρ < 1)
    (hzero : g 0 ≤ L) (hstep : ∀ k, g (k + 1) ≤ ρ * g k) :
    Summable g ∧ (∑' k, g k) ≤ L / (1 - ρ) := by
  have hmajor := (hasSum_geometric_of_lt_one hρ hρ1).mul_right L
  have hbound := restart_generation_decay g hρ hzero hstep
  have hs : Summable g := Summable.of_nonneg_of_le hg hbound hmajor.summable
  refine ⟨hs, ?_⟩
  calc
    _ ≤ ∑' k, ρ ^ k * L := Summable.tsum_le_tsum hbound hs hmajor.summable
    _ = (1 - ρ)⁻¹ * L := hmajor.tsum_eq
    _ = _ := by rw [div_eq_mul_inv, mul_comm]

/-- Total length of a finite family of dyadic cells. -/
noncomputable def dyadicRootLength (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) : ℝ :=
  ∑ c ∈ S, dyadicGridLength G c.1

open scoped Classical in
/-- Maximal cells of a finite family, ordered by interval containment. -/
noncomputable def maximalDyadicCells (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) :
    Finset (ℤ × ℤ) :=
  S.filter (fun c => ∀ d ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 →
    dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G c.1 c.2)

theorem maximalDyadicCells_subset (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) :
    maximalDyadicCells G S ⊆ S := by
  classical
  exact Finset.filter_subset _ _

theorem maximalDyadicCells_covers (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    {c : ℤ × ℤ} (hc : c ∈ S) :
    ∃ d ∈ maximalDyadicCells G S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 := by
  classical
  let F := fun c : ℤ × ℤ => dyadicGridCell G c.1 c.2
  let T := S.image F
  have hcT : F c ∈ T := Finset.mem_image.mpr ⟨c, hc, rfl⟩
  obtain ⟨I, hcI, hI⟩ := T.finite_toSet.exists_le_maximal hcT
  obtain ⟨d, hd, hdI⟩ := Finset.mem_image.mp hI.1
  refine ⟨d, Finset.mem_filter.mpr ⟨hd, ?_⟩, ?_⟩
  · intro e he hde
    have heT : F e ∈ T := Finset.mem_image.mpr ⟨e, he, rfl⟩
    have hIe : I ⊆ F e := hdI ▸ hde
    change F e ⊆ F d
    rw [hdI]
    exact hI.2 heT hIe
  · change F c ⊆ F d
    rw [hdI]
    exact hcI

/-- Passing to maximal cells preserves exactly the region removed by a
finite stopping family. -/
theorem maximalDyadicCells_union (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) :
    (⋃ c ∈ maximalDyadicCells G S, dyadicGridCell G c.1 c.2) =
      ⋃ c ∈ S, dyadicGridCell G c.1 c.2 := by
  ext x
  simp only [Set.mem_iUnion]
  constructor
  · rintro ⟨c, hc, hx⟩
    exact ⟨c, maximalDyadicCells_subset G S hc, hx⟩
  · rintro ⟨c, hc, hx⟩
    obtain ⟨d, hd, hcd⟩ := maximalDyadicCells_covers G S hc
    exact ⟨d, hd, hcd hx⟩

theorem maximalDyadicCells_length_le (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) :
    dyadicRootLength G (maximalDyadicCells G S) ≤ dyadicRootLength G S :=
  Finset.sum_le_sum_of_subset_of_nonneg (maximalDyadicCells_subset G S)
    (fun c _ _ => (dyadicGridLength_pos G c.1).le)

theorem dyadicGridCell_left_mem (G : RealDyadicGrid) (s m : ℤ) :
    dyadicGridLeft G s m ∈ dyadicGridCell G s m := by
  exact ⟨le_rfl, lt_add_of_pos_right _ (dyadicGridLength_pos G s)⟩

theorem dyadicGridCell_sameDepth_common_point (G : RealDyadicGrid) (s m n : ℤ)
    {x : ℝ} (hm : x ∈ dyadicGridCell G s m) (hn : x ∈ dyadicGridCell G s n) : m = n := by
  by_contra hne
  exact Set.disjoint_left.mp (dyadicGridCell_pairwiseDisjoint G s hne) hm hn

/-- Every child cell belongs to a parent at the preceding depth. -/
theorem dyadicGridCell_parent (G : RealDyadicGrid) (s n : ℤ) :
    ∃ m : ℤ, dyadicGridCell G (s + 1) n ⊆ dyadicGridCell G s m := by
  let x := dyadicGridLeft G (s + 1) n
  have hx : x ∈ dyadicGridCell G (s + 1) n := dyadicGridCell_left_mem G _ _
  obtain ⟨m, hm⟩ := dyadicGridCell_covers G s x
  obtain ⟨k, hk⟩ := dyadicGridCell_children G s m
  refine ⟨m, ?_⟩
  rw [hk] at hm ⊢
  rcases hm with h | h
  · have hn := dyadicGridCell_sameDepth_common_point G (s + 1) n k hx h
    rw [hn]
    exact Set.subset_union_left
  · have hn := dyadicGridCell_sameDepth_common_point G (s + 1) n (k + 1) hx h
    rw [hn]
    exact Set.subset_union_right

theorem dyadicGridCell_ancestor (G : RealDyadicGrid) {s t : ℤ} (hst : s ≤ t) (n : ℤ) :
    ∃ m : ℤ, dyadicGridCell G t n ⊆ dyadicGridCell G s m := by
  obtain ⟨k, rfl⟩ := Int.le.dest hst
  induction k generalizing n with
  | zero => exact ⟨n, by simp⟩
  | succ k ih =>
    obtain ⟨l, hl⟩ := dyadicGridCell_parent G (s + k) n
    obtain ⟨m, hm⟩ := ih l (by omega)
    refine ⟨m, ?_⟩
    have he : s + (k + 1 : ℕ) = (s + (k : ℤ)) + 1 := by omega
    rw [he]
    exact hl.trans hm

theorem dyadicGridCell_nested_or_disjoint_of_le (G : RealDyadicGrid)
    {s t : ℤ} (hst : s ≤ t) (m n : ℤ) :
    Disjoint (dyadicGridCell G s m) (dyadicGridCell G t n) ∨
      dyadicGridCell G t n ⊆ dyadicGridCell G s m := by
  obtain ⟨p, hp⟩ := dyadicGridCell_ancestor G hst n
  by_cases hpm : p = m
  · exact Or.inr (hpm ▸ hp)
  · exact Or.inl ((dyadicGridCell_pairwiseDisjoint G s (fun h => hpm h.symm)).mono_right hp)

/-- Source dyadic cells are laminar: intersecting cells are nested. -/
theorem dyadicGridCell_laminar (G : RealDyadicGrid) (c d : ℤ × ℤ) :
    Disjoint (dyadicGridCell G c.1 c.2) (dyadicGridCell G d.1 d.2) ∨
      dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 ∨
      dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G c.1 c.2 := by
  rcases le_total c.1 d.1 with h | h
  · rcases dyadicGridCell_nested_or_disjoint_of_le G h c.2 d.2 with hd | hs
    · exact Or.inl hd
    · exact Or.inr (Or.inr hs)
  · rcases dyadicGridCell_nested_or_disjoint_of_le G h d.2 c.2 with hd | hs
    · exact Or.inl hd.symm
    · exact Or.inr (Or.inl hs)

theorem dyadicGridLength_strictAnti (G : RealDyadicGrid) : StrictAnti (dyadicGridLength G) := by
  intro s t hst
  apply mul_lt_mul_of_pos_left _ G.baseLength_pos
  exact zpow_lt_zpow_right₀ (by norm_num : (1 : ℝ) < 2) (by omega : -t < -s)

theorem dyadicGridCell_injective (G : RealDyadicGrid) :
    Function.Injective (fun c : ℤ × ℤ => dyadicGridCell G c.1 c.2) := by
  intro c d h
  have hv := congrArg (fun I : Set ℝ => (volume I).toReal) h
  simp only [dyadicGridCell_volume,
    ENNReal.toReal_ofReal (dyadicGridLength_pos G _).le] at hv
  have hs := (dyadicGridLength_strictAnti G).injective hv
  have hx := dyadicGridCell_left_mem G c.1 c.2
  have hy : dyadicGridLeft G c.1 c.2 ∈ dyadicGridCell G c.1 d.2 := by
    have hy0 : dyadicGridLeft G c.1 c.2 ∈ dyadicGridCell G d.1 d.2 := by
      change dyadicGridCell G c.1 c.2 = dyadicGridCell G d.1 d.2 at h
      rw [← h]
      exact hx
    simpa only [← hs] using hy0
  exact Prod.ext hs (dyadicGridCell_sameDepth_common_point G c.1 c.2 d.2 hx hy)

/-- Distinct maximal cells are disjoint, the geometric fact used by the
first-crossing cost estimate in `lem:cuts`. -/
theorem maximalDyadicCells_pairwiseDisjoint (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) :
    Set.PairwiseDisjoint (maximalDyadicCells G S : Set (ℤ × ℤ))
      (fun c => dyadicGridCell G c.1 c.2) := by
  classical
  intro c hc d hd hne
  rcases dyadicGridCell_laminar G c d with hdis | hcd | hdc
  · exact hdis
  · have hdc := (Finset.mem_filter.mp hc).2 d (maximalDyadicCells_subset G S hd) hcd
    exact (hne (dyadicGridCell_injective G (Set.Subset.antisymm hcd hdc))).elim
  · have hcd := (Finset.mem_filter.mp hd).2 c (maximalDyadicCells_subset G S hc) hdc
    exact (hne (dyadicGridCell_injective G (Set.Subset.antisymm hcd hdc))).elim

open scoped Classical in
/-- Sum of original data on ancestors, including the current cell. -/
noncomputable def dyadicAncestorSum (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (c : ℤ × ℤ) : ℝ :=
  ∑ d ∈ S.filter (fun d => dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2), a d

open scoped Classical in
noncomputable def dyadicBadCells (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (T : ℝ) : Finset (ℤ × ℤ) :=
  S.filter (fun c => T < dyadicAncestorSum G S a c)

/-- First crossings are maximal violating cells; the violating value is
excluded before its summand is included in the retained family. -/
noncomputable def dyadicFirstCrossings (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (T : ℝ) : Finset (ℤ × ℤ) :=
  maximalDyadicCells G (dyadicBadCells G S a T)

open scoped Classical in
noncomputable def dyadicRetainedCells (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (T : ℝ) : Finset (ℤ × ℤ) :=
  S.filter (fun c => dyadicAncestorSum G S a c ≤ T)

theorem dyadicAncestorSum_mono (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) {c d : ℤ × ℤ}
    (hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2) :
    dyadicAncestorSum G S a d ≤ dyadicAncestorSum G S a c := by
  classical
  apply Finset.sum_le_sum_of_subset_of_nonneg
  · intro e he
    obtain ⟨heS, hde⟩ := Finset.mem_filter.mp he
    exact Finset.mem_filter.mpr ⟨heS, hcd.trans hde⟩
  · intro e he _
    exact ha e (Finset.mem_filter.mp he).1

theorem dyadicFirstCrossings_mem (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (T : ℝ) {c : ℤ × ℤ} (hc : c ∈ dyadicFirstCrossings G S a T) :
    c ∈ S ∧ T < dyadicAncestorSum G S a c := by
  classical
  exact Finset.mem_filter.mp (maximalDyadicCells_subset G _ hc)

/-- Removing a first crossing removes exactly its cell and all original
descendant summands. The data on earlier ancestors are left unchanged. -/
theorem dyadicRetainedCells_iff (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) (T : ℝ) (c : ℤ × ℤ) :
    c ∈ dyadicRetainedCells G S a T ↔ c ∈ S ∧
      ¬∃ d ∈ dyadicFirstCrossings G S a T,
        dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 := by
  classical
  constructor
  · intro hc
    obtain ⟨hcS, hcT⟩ := Finset.mem_filter.mp hc
    refine ⟨hcS, ?_⟩
    rintro ⟨d, hd, hcd⟩
    have hdT := (dyadicFirstCrossings_mem G S a T hd).2
    exact (not_lt_of_ge hcT) (hdT.trans_le (dyadicAncestorSum_mono G S a ha hcd))
  · rintro ⟨hc, hno⟩
    apply Finset.mem_filter.mpr
    refine ⟨hc, le_of_not_gt ?_⟩
    intro hbad
    have hcB : c ∈ dyadicBadCells G S a T := Finset.mem_filter.mpr ⟨hc, hbad⟩
    exact hno (maximalDyadicCells_covers G _ hcB)

theorem dyadicFirstCrossings_pairwiseDisjoint (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (T : ℝ) :
    Set.PairwiseDisjoint (dyadicFirstCrossings G S a T : Set (ℤ × ℤ))
      (fun c => dyadicGridCell G c.1 c.2) :=
  maximalDyadicCells_pairwiseDisjoint G _

noncomputable def dyadicWeightedMass (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) : ℝ := ∑ c ∈ S, dyadicGridLength G c.1 * a c

theorem dyadicWeightedMass_nonneg (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) : 0 ≤ dyadicWeightedMass G S a :=
  Finset.sum_nonneg (fun c hc => mul_nonneg (dyadicGridLength_pos G c.1).le (ha c hc))

theorem dyadicWeightedMass_ofReal (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) :
    ENNReal.ofReal (dyadicWeightedMass G S a) =
      ∑ c ∈ S, ENNReal.ofReal (dyadicGridLength G c.1) * ENNReal.ofReal (a c) := by
  unfold dyadicWeightedMass
  rw [ENNReal.ofReal_sum_of_nonneg (fun c hc =>
    mul_nonneg (dyadicGridLength_pos G c.1).le (ha c hc))]
  exact Finset.sum_congr rfl (fun c _ => ENNReal.ofReal_mul (dyadicGridLength_pos G c.1).le)

theorem dyadicAncestorSum_le_path (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) {c : ℤ × ℤ} {x : ℝ}
    (hx : x ∈ dyadicGridCell G c.1 c.2) :
    ENNReal.ofReal (dyadicAncestorSum G S a c) ≤
      dyadicPathSum G S (fun d => ENNReal.ofReal (a d)) x := by
  classical
  unfold dyadicAncestorSum dyadicPathSum
  rw [ENNReal.ofReal_sum_of_nonneg (fun d hd => ha d (Finset.mem_filter.mp hd).1),
    Finset.sum_filter]
  apply Finset.sum_le_sum
  intro d _
  split_ifs with hcd
  · rw [Set.indicator_of_mem (hcd hx)]
  · exact bot_le

/-- Integrating over the disjoint first crossings proves the Markov cost
estimate before division by the positive crossing threshold. -/
theorem dyadicFirstCrossings_weighted_cost (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) (R : Set ℝ)
    (hR : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ R) {T : ℝ} (hT : 0 ≤ T) :
    T * dyadicRootLength G (dyadicFirstCrossings G S a T) ≤ dyadicWeightedMass G S a := by
  classical
  let C := dyadicFirstCrossings G S a T
  let f := dyadicPathSum G S (fun d => ENNReal.ofReal (a d))
  have hpoint (c) (hc : c ∈ C) (x) (hx : x ∈ dyadicGridCell G c.1 c.2) :
      ENNReal.ofReal T ≤ f x :=
    (ENNReal.ofReal_le_ofReal (dyadicFirstCrossings_mem G S a T hc).2.le).trans
      (dyadicAncestorSum_le_path G S a ha hx)
  have hsub : (⋃ c ∈ C, dyadicGridCell G c.1 c.2) ⊆ R := by
    intro x hx
    obtain ⟨c, hxc⟩ := Set.mem_iUnion.mp hx
    obtain ⟨hc, hx⟩ := Set.mem_iUnion.mp hxc
    exact hR c (dyadicFirstCrossings_mem G S a T hc).1 hx
  apply (ENNReal.ofReal_le_ofReal_iff (dyadicWeightedMass_nonneg G S a ha)).mp
  calc
    _ = ∑ c ∈ C, ENNReal.ofReal T * ENNReal.ofReal (dyadicGridLength G c.1) := by
      rw [ENNReal.ofReal_mul hT]
      change ENNReal.ofReal T * ENNReal.ofReal (∑ c ∈ C, dyadicGridLength G c.1) = _
      rw [ENNReal.ofReal_sum_of_nonneg (fun c _ => (dyadicGridLength_pos G c.1).le),
        Finset.mul_sum]
    _ = ∑ c ∈ C, ∫⁻ _x in dyadicGridCell G c.1 c.2, ENNReal.ofReal T := by
      apply Finset.sum_congr rfl
      intro c _
      rw [setLIntegral_const, dyadicGridCell_volume]
    _ ≤ ∑ c ∈ C, ∫⁻ x in dyadicGridCell G c.1 c.2, f x :=
      Finset.sum_le_sum (fun c hc =>
        setLIntegral_mono' (dyadicGridCell_measurable G c.1 c.2) (hpoint c hc))
    _ = ∫⁻ x in ⋃ c ∈ C, dyadicGridCell G c.1 c.2, f x :=
      (lintegral_biUnion_finset (dyadicFirstCrossings_pairwiseDisjoint G S a T)
        (fun c _ => dyadicGridCell_measurable G c.1 c.2) f).symm
    _ ≤ ∫⁻ x in R, f x := lintegral_mono_set hsub
    _ = _ := by rw [← dyadicPathIntegral G S _ R hR, ← dyadicWeightedMass_ofReal G S a ha]

theorem dyadicWeights_zero_of_mass_nonpos (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) (hW : dyadicWeightedMass G S a ≤ 0) :
    ∀ c ∈ S, a c = 0 := by
  intro c hc
  have hterm : dyadicGridLength G c.1 * a c ≤ dyadicWeightedMass G S a :=
    Finset.single_le_sum (fun d hd => mul_nonneg (dyadicGridLength_pos G d.1).le (ha d hd)) hc
  have hp := dyadicGridLength_pos G c.1
  have hac := ha c hc
  nlinarith

theorem dyadicAncestorSum_zero_of_mass_nonpos (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) (hW : dyadicWeightedMass G S a ≤ 0)
    (c : ℤ × ℤ) : dyadicAncestorSum G S a c = 0 := by
  classical
  exact Finset.sum_eq_zero (fun d hd => dyadicWeights_zero_of_mass_nonpos G S a ha hW d
    (Finset.mem_filter.mp hd).1)

/-- Blueprint `lem:cuts`, first assertion: first crossings of `A/ρ` cost
at most `ρ` times the root length, including the zero-energy case. -/
theorem dyadicFirstCrossings_cost (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) (root : ℤ × ℤ)
    (hroot : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {A ρ : ℝ} (hρ : 0 < ρ) (_hρ1 : ρ < 1)
    (hW : dyadicWeightedMass G S a ≤ A * dyadicGridLength G root.1) :
    dyadicRootLength G (dyadicFirstCrossings G S a (A / ρ)) ≤
      ρ * dyadicGridLength G root.1 := by
  classical
  have hL := dyadicGridLength_pos G root.1
  have hmass := dyadicWeightedMass_nonneg G S a ha
  have hA : 0 ≤ A := by nlinarith
  by_cases hz : A = 0
  · have hW0 : dyadicWeightedMass G S a ≤ 0 := by simpa only [hz, zero_mul] using hW
    have hC : dyadicFirstCrossings G S a (A / ρ) = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro c hc
      have hb := (dyadicFirstCrossings_mem G S a (A / ρ) hc).2
      rw [dyadicAncestorSum_zero_of_mass_nonpos G S a ha hW0 c, hz, zero_div] at hb
      exact lt_irrefl _ hb
    rw [hC]
    simp only [dyadicRootLength, Finset.sum_empty]
    exact mul_nonneg hρ.le hL.le
  · have hAp : 0 < A := lt_of_le_of_ne hA (Ne.symm hz)
    have hT : 0 < A / ρ := div_pos hAp hρ
    have hc := dyadicFirstCrossings_weighted_cost G S a ha _ hroot hT.le
    apply (mul_le_mul_iff_right₀ hT).mp
    calc
      _ ≤ A * dyadicGridLength G root.1 := hc.trans hW
      _ = (A / ρ) * (ρ * dyadicGridLength G root.1) := by field_simp

open scoped Classical in
/-- Real-valued path sum of the original cell weights. -/
noncomputable def dyadicRealPathSum (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (x : ℝ) : ℝ :=
  ∑ c ∈ S.filter (fun c => x ∈ dyadicGridCell G c.1 c.2), a c

/-- Blueprint `lem:cuts`, first assertion: the retained path sum is bounded
at every point, including points below a removed first-crossing cell. -/
theorem dyadicRetainedPathSum_le (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) {T : ℝ} (hT : 0 ≤ T) (x : ℝ) :
    dyadicRealPathSum G (dyadicRetainedCells G S a T) a x ≤ T := by
  classical
  let U := (dyadicRetainedCells G S a T).filter
    (fun c => x ∈ dyadicGridCell G c.1 c.2)
  change ∑ c ∈ U, a c ≤ T
  by_cases hU : U.Nonempty
  · obtain ⟨c, hc, hmax⟩ := Finset.exists_max_image U (fun c => c.1) hU
    obtain ⟨hcR, hxc⟩ := Finset.mem_filter.mp hc
    obtain ⟨_, hcT⟩ := Finset.mem_filter.mp hcR
    apply le_trans _ hcT
    change ∑ d ∈ U, a d ≤ ∑ d ∈ S.filter
      (fun d => dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2), a d
    apply Finset.sum_le_sum_of_subset_of_nonneg
    · intro d hd
      obtain ⟨hdR, hxd⟩ := Finset.mem_filter.mp hd
      refine Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hdR).1, ?_⟩
      rcases dyadicGridCell_nested_or_disjoint_of_le G (hmax d hd) d.2 c.2 with hdis | hsub
      · exact (Set.disjoint_left.mp hdis hxd hxc).elim
      · exact hsub
    · intro d hd _
      exact ha d (Finset.mem_filter.mp hd).1
  · rw [Finset.not_nonempty_iff_eq_empty.mp hU, Finset.sum_empty]
    exact hT

/-- Blueprint `lem:cuts`, complete first assertion with the specified
first-crossing family and the everywhere retained bound. -/
theorem dyadicFirstCrossingCuts (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) (root : ℤ × ℤ)
    (hroot : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {A ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (hW : dyadicWeightedMass G S a ≤ A * dyadicGridLength G root.1) :
    dyadicRootLength G (dyadicFirstCrossings G S a (A / ρ)) ≤
        ρ * dyadicGridLength G root.1 ∧
      ∀ x : ℝ, dyadicRealPathSum G (dyadicRetainedCells G S a (A / ρ)) a x ≤ A / ρ := by
  have hmass := dyadicWeightedMass_nonneg G S a ha
  have hL := dyadicGridLength_pos G root.1
  have hA : 0 ≤ A := by nlinarith
  exact ⟨dyadicFirstCrossings_cost G S a ha root hroot hρ hρ1 hW,
    dyadicRetainedPathSum_le G S a ha (div_nonneg hA hρ.le)⟩

/-- Average of a nonnegative energy density on a dyadic cell. -/
noncomputable def dyadicEnergyAverage (G : RealDyadicGrid) (g : ℝ → ℝ≥0∞)
    (c : ℤ × ℤ) : ℝ≥0∞ :=
  (∫⁻ x in dyadicGridCell G c.1 c.2, g x) / ENNReal.ofReal (dyadicGridLength G c.1)

open scoped Classical in
/-- Full squared hull maximum, with value zero for an empty hull. The
energy density is fixed, independently of any later stopping cells. -/
noncomputable def dyadicHullMax (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) (x : ℝ) : ℝ≥0∞ :=
  S.sup (fun c => (dyadicGridCell G c.1 c.2).indicator
    (fun _ => dyadicEnergyAverage G g c) x)

theorem dyadicHullMax_measurable (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) : Measurable (dyadicHullMax G S g) := by
  classical
  induction S using Finset.induction_on with
  | empty =>
    change Measurable (fun x : ℝ => (∅ : Finset (ℤ × ℤ)).sup _)
    simp only [Finset.sup_empty]
    exact measurable_const
  | @insert c S hc ih =>
    change Measurable (fun x => (insert c S).sup _)
    simp only [Finset.sup_insert]
    exact (measurable_const.indicator (dyadicGridCell_measurable G c.1 c.2)).sup ih

/-- A positive superlevel set is exactly the union of hull cells whose
fixed energy averages exceed the level. -/
theorem dyadicHullMax_superlevel (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) (t : ℝ≥0∞) :
    {x | t < dyadicHullMax G S g x} =
      ⋃ c ∈ S.filter (fun c => t < dyadicEnergyAverage G g c), dyadicGridCell G c.1 c.2 := by
  classical
  ext x
  simp only [Set.mem_ofPred_eq, dyadicHullMax, Finset.lt_sup_iff, Set.mem_iUnion,
    Finset.mem_filter]
  constructor
  · rintro ⟨c, hc, hlt⟩
    by_cases hx : x ∈ dyadicGridCell G c.1 c.2
    · exact ⟨c, ⟨hc, by simpa only [Set.indicator_of_mem hx] using hlt⟩, hx⟩
    · simp only [Set.indicator_of_notMem hx] at hlt
      exact (not_lt_of_ge bot_le hlt).elim
  · rintro ⟨c, ⟨hc, hlt⟩, hx⟩
    exact ⟨c, hc, by simpa only [Set.indicator_of_mem hx] using hlt⟩

/-- Blueprint `lem:cuts`, lines 453–457: the finite dyadic hull maximal
operator has weak (1,1) constant one, even for extended-valued densities. -/
theorem dyadicHullMax_weak (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) (R : Set ℝ)
    (hR : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ R) (t : ℝ≥0∞) :
    t * volume {x | t < dyadicHullMax G S g x} ≤ ∫⁻ x in R, g x := by
  classical
  let B := S.filter (fun c => t < dyadicEnergyAverage G g c)
  let C := maximalDyadicCells G B
  have hCS (c) (hc : c ∈ C) : c ∈ S :=
    (Finset.mem_filter.mp (maximalDyadicCells_subset G B hc)).1
  have hsub : (⋃ c ∈ C, dyadicGridCell G c.1 c.2) ⊆ R := by
    intro x hx
    obtain ⟨c, hc, hx⟩ := Set.mem_iUnion₂.mp hx
    exact hR c (hCS c hc) hx
  have hcell (c) (hc : c ∈ C) :
      t * ENNReal.ofReal (dyadicGridLength G c.1) ≤
        ∫⁻ x in dyadicGridCell G c.1 c.2, g x := by
    have hav := (Finset.mem_filter.mp (maximalDyadicCells_subset G B hc)).2.le
    exact (ENNReal.le_div_iff_mul_le
      (Or.inl (ne_of_gt (ENNReal.ofReal_pos.mpr (dyadicGridLength_pos G c.1))))
      (Or.inl ENNReal.ofReal_ne_top)).mp hav
  rw [dyadicHullMax_superlevel, ← maximalDyadicCells_union G B]
  change t * volume (⋃ c ∈ C, dyadicGridCell G c.1 c.2) ≤ _
  calc
    _ = ∫⁻ _x in ⋃ c ∈ C, dyadicGridCell G c.1 c.2, t := (setLIntegral_const _ _).symm
    _ = ∑ c ∈ C, ∫⁻ _x in dyadicGridCell G c.1 c.2, t :=
      lintegral_biUnion_finset (maximalDyadicCells_pairwiseDisjoint G B)
        (fun c _ => dyadicGridCell_measurable G c.1 c.2) _
    _ ≤ ∑ c ∈ C, ∫⁻ x in dyadicGridCell G c.1 c.2, g x := by
      apply Finset.sum_le_sum
      intro c hc
      simpa only [setLIntegral_const, dyadicGridCell_volume] using hcell c hc
    _ = ∫⁻ x in ⋃ c ∈ C, dyadicGridCell G c.1 c.2, g x :=
      (lintegral_biUnion_finset (maximalDyadicCells_pairwiseDisjoint G B)
        (fun c _ => dyadicGridCell_measurable G c.1 c.2) g).symm
    _ ≤ _ := lintegral_mono_set hsub

/-- The hull maximum vanishes outside the union of its maximal cells. -/
theorem dyadicHullMax_support_bound (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) (t : ℝ≥0∞) :
    volume {x | t < dyadicHullMax G S g x} ≤
      volume (⋃ c ∈ maximalDyadicCells G S, dyadicGridCell G c.1 c.2) := by
  classical
  rw [dyadicHullMax_superlevel, maximalDyadicCells_union]
  apply measure_mono
  intro x hx
  obtain ⟨c, hc, hx⟩ := Set.mem_iUnion₂.mp hx
  exact Set.mem_iUnion₂.mpr ⟨c, (Finset.mem_filter.mp hc).1, hx⟩

/-- Layer cake for a bounded nonnegative real function, with the level
integral restricted to its finite range. -/
theorem bounded_layercake {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (f : α → ℝ) (hf : Measurable f) {T : ℝ} (hT : 0 ≤ T)
    (hf0 : ∀ x, 0 ≤ f x) (hfT : ∀ x, f x ≤ T) :
    ∫⁻ x, ENNReal.ofReal (f x) ∂μ =
      ∫⁻ t in Set.Ioc 0 T, μ {x | t < f x} := by
  rw [lintegral_eq_lintegral_meas_lt μ (Filter.Eventually.of_forall hf0) hf.aemeasurable,
    ← Set.Ioc_union_Ioi_eq_Ioi hT, lintegral_union measurableSet_Ioi Set.Ioc_disjoint_Ioi_same]
  have hz : (∫⁻ t in Set.Ioi T, μ {x | t < f x}) = 0 := by
    calc
      _ = ∫⁻ _t in Set.Ioi T, (0 : ℝ≥0∞) := by
        apply setLIntegral_congr_fun measurableSet_Ioi
        intro t ht
        have he : {x | t < f x} = ∅ := by
          ext x
          simp only [Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false]
          exact not_lt_of_ge ((hfT x).trans ht.le)
        change μ {x | t < f x} = 0
        rw [he, measure_empty]
      _ = 0 := by simp
  rw [hz, add_zero]

/-- The reciprocal tail in the weak (1,1) distribution integral gives the
logarithm in blueprint `lem:cuts`, lines 458–462. -/
theorem lintegral_ofReal_reciprocal {a T E : ℝ} (ha : 0 < a) (haT : a ≤ T)
    (hE : 0 ≤ E) :
    ∫⁻ t in Set.Ioc a T, ENNReal.ofReal (E / t) =
      ENNReal.ofReal (E * Real.log (T / a)) := by
  have hc : ContinuousOn (fun t : ℝ => E / t) (Set.Icc a T) :=
    continuousOn_const.div continuousOn_id (fun t ht => ne_of_gt (ha.trans_le ht.1))
  have hi : IntegrableOn (fun t : ℝ => E / t) (Set.Ioc a T) :=
    hc.integrableOn_Icc.mono_set Set.Ioc_subset_Icc_self
  rw [← ofReal_integral_eq_lintegral_ofReal hi]
  · rw [← intervalIntegral.integral_of_le haT]
    simp only [div_eq_mul_inv, intervalIntegral.integral_const_mul,
      integral_inv_of_pos ha (ha.trans_le haT)]
  · exact (ae_restrict_iff' measurableSet_Ioc).mpr
      (Filter.Eventually.of_forall (fun t ht => div_nonneg hE (ha.le.trans ht.1.le)))

/-- Integrating a distribution bounded by `min(M,E/t)` up to `T` gives
the logarithmic truncation bound used in `lem:cuts`. -/
theorem weak_distribution_log_integral (F : ℝ → ℝ≥0∞) {E M T : ℝ}
    (hE : 0 < E) (hM : 0 < M) (hT : 0 ≤ T)
    (hsupport : ∀ t, 0 < t → F t ≤ ENNReal.ofReal M)
    (hweak : ∀ t, 0 < t → F t ≤ ENNReal.ofReal (E / t)) :
    ∫⁻ t in Set.Ioc 0 T, F t ≤
      ENNReal.ofReal (E * (1 + Real.log (2 + M * T / E))) := by
  let a := E / M
  have ha : 0 < a := div_pos hE hM
  have hMa : M * a = E := mul_div_cancel₀ E (ne_of_gt hM)
  have hratio : 0 ≤ M * T / E := div_nonneg (mul_nonneg hM.le hT) hE.le
  have hlog : 0 ≤ Real.log (2 + M * T / E) := Real.log_nonneg (by linarith)
  have hlow (b : ℝ) (hb : 0 ≤ b) :
      (∫⁻ t in Set.Ioc 0 b, F t) ≤ ENNReal.ofReal (M * b) := by
    calc
      _ ≤ ∫⁻ _t in Set.Ioc 0 b, ENNReal.ofReal M :=
        setLIntegral_mono' measurableSet_Ioc (fun t ht => hsupport t ht.1)
      _ = _ := by rw [setLIntegral_const, Real.volume_Ioc, sub_zero, ENNReal.ofReal_mul hM.le]
  by_cases hTa : T ≤ a
  · apply (hlow T hT).trans
    apply ENNReal.ofReal_le_ofReal
    have hMT : M * T ≤ E := by nlinarith
    nlinarith
  · have haT : a ≤ T := le_of_not_ge hTa
    have hhigh : (∫⁻ t in Set.Ioc a T, F t) ≤ ENNReal.ofReal (E * Real.log (T / a)) := by
      calc
        _ ≤ ∫⁻ t in Set.Ioc a T, ENNReal.ofReal (E / t) :=
          setLIntegral_mono' measurableSet_Ioc (fun t ht => hweak t (ha.trans ht.1))
        _ = _ := lintegral_ofReal_reciprocal ha haT hE.le
    rw [← Set.Ioc_union_Ioc_eq_Ioc ha.le haT,
      lintegral_union measurableSet_Ioc (Set.Ioc_disjoint_Ioc_of_le le_rfl)]
    calc
      _ ≤ ENNReal.ofReal (M * a) + ENNReal.ofReal (E * Real.log (T / a)) :=
        add_le_add (hlow a ha.le) hhigh
      _ = ENNReal.ofReal (E * (1 + Real.log (T / a))) := by
        rw [hMa, ← ENNReal.ofReal_add hE.le
          (mul_nonneg hE.le (Real.log_nonneg ((le_div_iff₀ ha).mpr (by simpa using haT))))]
        congr 1
        ring
      _ ≤ _ := by
        apply ENNReal.ofReal_le_ofReal
        have hr : T / a = M * T / E := by dsimp [a]; field_simp
        have hl : Real.log (T / a) ≤ Real.log (2 + M * T / E) :=
          Real.log_le_log (div_pos (ha.trans_le haT) ha) (by rw [hr]; linarith)
        nlinarith

theorem weak_distribution_log_integral_nonneg (F : ℝ → ℝ≥0∞) {E M T : ℝ}
    (hE : 0 ≤ E) (hM : 0 ≤ M) (hT : 0 ≤ T)
    (hsupport : ∀ t, 0 < t → F t ≤ ENNReal.ofReal M)
    (hweak : ∀ t, 0 < t → F t ≤ ENNReal.ofReal (E / t)) :
    ∫⁻ t in Set.Ioc 0 T, F t ≤
      ENNReal.ofReal (E * (1 + Real.log (2 + M * T / E))) := by
  by_cases hEp : 0 < E
  · by_cases hMp : 0 < M
    · exact weak_distribution_log_integral F hEp hMp hT hsupport hweak
    · have hMz : M = 0 := le_antisymm (le_of_not_gt hMp) hM
      have hz : (∫⁻ t in Set.Ioc 0 T, F t) ≤ 0 := by
        calc
          _ ≤ ∫⁻ _t in Set.Ioc 0 T, (0 : ℝ≥0∞) :=
            setLIntegral_mono' measurableSet_Ioc (fun t ht => by simpa [hMz] using hsupport t ht.1)
          _ = 0 := by simp
      exact hz.trans bot_le
  · have hEz : E = 0 := le_antisymm (le_of_not_gt hEp) hE
    have hz : (∫⁻ t in Set.Ioc 0 T, F t) ≤ 0 := by
      calc
        _ ≤ ∫⁻ _t in Set.Ioc 0 T, (0 : ℝ≥0∞) :=
          setLIntegral_mono' measurableSet_Ioc (fun t ht => by simpa [hEz] using hweak t ht.1)
        _ = 0 := by simp
    exact hz.trans bot_le

/-- Finite-family layer cake and the weak/support distribution bounds yield
a logarithmic integral estimate, including zero energy and zero support. -/
theorem finite_family_log_integral {α ι : Type*} [MeasurableSpace α]
    (μ : Measure α) (V : Finset ι) (f : ι → α → ℝ)
    (hf : ∀ ν ∈ V, Measurable (f ν)) {E M T : ℝ}
    (hE : 0 ≤ E) (hM : 0 ≤ M) (hT : 0 ≤ T)
    (hf0 : ∀ ν ∈ V, ∀ x, 0 ≤ f ν x) (hfT : ∀ ν ∈ V, ∀ x, f ν x ≤ T)
    (hsupport : ∀ t, 0 < t → ∑ ν ∈ V, μ {x | t < f ν x} ≤ ENNReal.ofReal M)
    (hweak : ∀ t, 0 < t → ∑ ν ∈ V, μ {x | t < f ν x} ≤ ENNReal.ofReal (E / t)) :
    ∑ ν ∈ V, ∫⁻ x, ENNReal.ofReal (f ν x) ∂μ ≤
      ENNReal.ofReal (E * (1 + Real.log (2 + M * T / E))) := by
  calc
    _ = ∑ ν ∈ V, ∫⁻ t in Set.Ioc 0 T, μ {x | t < f ν x} :=
      Finset.sum_congr rfl (fun ν hν => bounded_layercake μ (f ν) (hf ν hν) hT
        (hf0 ν hν) (hfT ν hν))
    _ = ∫⁻ t in Set.Ioc 0 T, ∑ ν ∈ V, μ {x | t < f ν x} := by
      symm
      apply lintegral_finsetSum
      intro ν _
      exact Antitone.measurable (fun s t hst => measure_mono (fun x hx => hst.trans_lt hx))
    _ ≤ _ := weak_distribution_log_integral_nonneg _ hE hM hT hsupport hweak

/-- Logarithmic integral estimate for a finite family of truncated
extended-valued maxima from their summed distribution bound. -/
theorem truncated_family_log_integral {α ι : Type*} [MeasurableSpace α]
    (μ : Measure α) (V : Finset ι) (m : ι → α → ℝ≥0∞)
    (hm : ∀ ν ∈ V, Measurable (m ν)) {E M T : ℝ}
    (hE : 0 ≤ E) (hM : 0 ≤ M) (hT : 0 ≤ T)
    (hdist : ∀ t, 0 < t → ∑ ν ∈ V, μ {x | ENNReal.ofReal t < m ν x} ≤
      min (ENNReal.ofReal M) (ENNReal.ofReal (E / t))) :
    ∑ ν ∈ V, ∫⁻ x, min (m ν x) (ENNReal.ofReal T) ∂μ ≤
      ENNReal.ofReal (E * (1 + Real.log (2 + M * T / E))) := by
  let f := fun ν x => (min (m ν x) (ENNReal.ofReal T)).toReal
  have hfin (ν) (x) : min (m ν x) (ENNReal.ofReal T) ≠ ∞ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top (min_le_right _ _)
  have hsub (ν) (t : ℝ) (ht : 0 < t) :
      {x | t < f ν x} ⊆ {x | ENNReal.ofReal t < m ν x} := by
    intro x hx
    exact ((ENNReal.ofReal_lt_iff_lt_toReal ht.le (hfin ν x)).mpr hx).trans_le (min_le_left _ _)
  have hdis (t) (ht : 0 < t) : ∑ ν ∈ V, μ {x | t < f ν x} ≤
      min (ENNReal.ofReal M) (ENNReal.ofReal (E / t)) :=
    (Finset.sum_le_sum (fun ν _ => measure_mono (hsub ν t ht))).trans (hdist t ht)
  have hb := finite_family_log_integral μ V f
    (fun ν hν => ((hm ν hν).inf measurable_const).ennreal_toReal) hE hM hT
    (fun _ _ _ => ENNReal.toReal_nonneg)
    (fun _ _ _ => ENNReal.toReal_le_of_le_ofReal hT (min_le_right _ _))
    (fun t ht => (hdis t ht).trans (min_le_left _ _))
    (fun t ht => (hdis t ht).trans (min_le_right _ _))
  simpa only [f, ENNReal.ofReal_toReal (hfin _ _)] using hb

/-- Blueprint `lem:cuts`, lines 458–462: the sum of the integrals of
truncated fixed hull maxima is bounded logarithmically by total energy
and total hull support. This unnormalized form includes zero energy. -/
theorem dyadicHullMax_log_integral {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞) (R : Set ℝ)
    (hR : ∀ ν ∈ V, ∀ c ∈ S ν, dyadicGridCell G c.1 c.2 ⊆ R)
    {E M T : ℝ} (hE0 : 0 ≤ E) (hM0 : 0 ≤ M) (hT : 0 ≤ T)
    (hE : ∑ ν ∈ V, ∫⁻ x in R, g ν x ≤ ENNReal.ofReal E)
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (S ν),
      dyadicGridCell G c.1 c.2) ≤ ENNReal.ofReal M) :
    ∑ ν ∈ V, ∫⁻ x, min (dyadicHullMax G (S ν) (g ν) x) (ENNReal.ofReal T) ≤
      ENNReal.ofReal (E * (1 + Real.log (2 + M * T / E))) := by
  apply truncated_family_log_integral volume V (fun ν => dyadicHullMax G (S ν) (g ν))
    (fun ν _ => dyadicHullMax_measurable G (S ν) (g ν)) hE0 hM0 hT
  intro t ht
  apply le_min
  · exact (Finset.sum_le_sum (fun ν _ =>
      dyadicHullMax_support_bound G (S ν) (g ν) (ENNReal.ofReal t))).trans hM
  · rw [ENNReal.ofReal_div_of_pos ht]
    apply (ENNReal.le_div_iff_mul_le
      (Or.inl (ne_of_gt (ENNReal.ofReal_pos.mpr ht))) (Or.inl ENNReal.ofReal_ne_top)).mpr
    rw [mul_comm, Finset.mul_sum]
    exact (Finset.sum_le_sum (fun ν hν =>
      dyadicHullMax_weak G (S ν) (g ν) R (hR ν hν) (ENNReal.ofReal t))).trans hE

open scoped Classical in
/-- Partial squared hull maximum using only ancestors through the current
cell. All energy averages still use the original fixed function. -/
noncomputable def dyadicPartialHullMax (G : RealDyadicGrid) (H : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) (c : ℤ × ℤ) : ℝ≥0∞ :=
  H.sup (fun d => if dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2
    then dyadicEnergyAverage G g d else 0)

theorem dyadicPartialHullMax_mono (G : RealDyadicGrid) (H : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) {c d : ℤ × ℤ}
    (hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2) :
    dyadicPartialHullMax G H g d ≤ dyadicPartialHullMax G H g c := by
  classical
  apply Finset.sup_le
  intro e he
  by_cases hde : dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G e.1 e.2
  · have hh := Finset.le_sup (f := fun e => if dyadicGridCell G c.1 c.2 ⊆
        dyadicGridCell G e.1 e.2 then dyadicEnergyAverage G g e else 0) he
    simpa only [dyadicPartialHullMax, ite_eq_left hde, ite_eq_left (hcd.trans hde)] using hh
  · simp only [ite_eq_right hde]
    exact bot_le

theorem dyadicPartialHullMax_le_full (G : RealDyadicGrid) (H : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) {c : ℤ × ℤ} {x : ℝ}
    (hx : x ∈ dyadicGridCell G c.1 c.2) :
    dyadicPartialHullMax G H g c ≤ dyadicHullMax G H g x := by
  classical
  apply Finset.sup_le
  intro d hd
  by_cases hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2
  · have hh := Finset.le_sup (f := fun d => (dyadicGridCell G d.1 d.2).indicator
        (fun _ => dyadicEnergyAverage G g d) x) hd
    simpa only [dyadicHullMax, ite_eq_left hcd, Set.indicator_of_mem (hcd hx)] using hh
  · simp only [ite_eq_right hcd]
    exact bot_le

theorem dyadicEnergyAverage_le_partial (G : RealDyadicGrid) (H : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) {c : ℤ × ℤ} (hc : c ∈ H) :
    dyadicEnergyAverage G g c ≤ dyadicPartialHullMax G H g c := by
  classical
  have hh := Finset.le_sup (f := fun d => if dyadicGridCell G c.1 c.2 ⊆
      dyadicGridCell G d.1 d.2 then dyadicEnergyAverage G g d else 0) hc
  simpa only [dyadicPartialHullMax, ite_eq_left (Set.Subset.refl _)] using hh

/-- Before any individual threshold is crossed, the partial sum agrees
with its truncated version, as required by `lem:cuts`, line 463. -/
theorem dyadicPartialHullMax_sum_eq_truncated {ι : Type*} (V : Finset ι)
    (G : RealDyadicGrid) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (c : ℤ × ℤ) {T : ℝ≥0∞} (hT : ∀ ν ∈ V, dyadicPartialHullMax G (H ν) (g ν) c ≤ T) :
    ∑ ν ∈ V, dyadicPartialHullMax G (H ν) (g ν) c =
      ∑ ν ∈ V, min (dyadicPartialHullMax G (H ν) (g ν) c) T := by
  exact Finset.sum_congr rfl (fun ν hν => (min_eq_left (hT ν hν)).symm)

/-- A cell is good for both rules if no partial individual maximum exceeds
`T` and the sum of truncated partial maxima does not exceed `U`. -/
def dyadicHullGood {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞) (T U : ℝ≥0∞) (c : ℤ × ℤ) : Prop :=
  (∀ ν ∈ V, dyadicPartialHullMax G (H ν) (g ν) c ≤ T) ∧
    ∑ ν ∈ V, min (dyadicPartialHullMax G (H ν) (g ν) c) T ≤ U

open scoped Classical in
/-- The combined first crossings, chosen as maximal cells violating at
least one of the two partial-max rules. -/
noncomputable def dyadicHullCuts {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (T U : ℝ≥0∞) : Finset (ℤ × ℤ) :=
  maximalDyadicCells G (S.filter (fun c => ¬dyadicHullGood V G H g T U c))

theorem dyadicHullGood_ancestor {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞) (T U : ℝ≥0∞)
    {c d : ℤ × ℤ} (hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2)
    (hc : dyadicHullGood V G H g T U c) : dyadicHullGood V G H g T U d := by
  refine ⟨fun ν hν => (dyadicPartialHullMax_mono G (H ν) (g ν) hcd).trans (hc.1 ν hν), ?_⟩
  exact (Finset.sum_le_sum (fun ν _ => min_le_min_right T
    (dyadicPartialHullMax_mono G (H ν) (g ν) hcd))).trans hc.2

theorem dyadicRootLength_ofReal_eq_volume (G : RealDyadicGrid) (C : Finset (ℤ × ℤ))
    (hC : Set.PairwiseDisjoint (C : Set (ℤ × ℤ)) (fun c => dyadicGridCell G c.1 c.2)) :
    ENNReal.ofReal (dyadicRootLength G C) = volume (⋃ c ∈ C, dyadicGridCell G c.1 c.2) := by
  rw [measure_biUnion_finset hC (fun c _ => dyadicGridCell_measurable G c.1 c.2)]
  unfold dyadicRootLength
  rw [ENNReal.ofReal_sum_of_nonneg (fun c _ => (dyadicGridLength_pos G c.1).le)]
  exact Finset.sum_congr rfl (fun c _ => (dyadicGridCell_volume G c.1 c.2).symm)

/-- Each removed cell lies on its entirety in the union of the full
individual superlevel sets or the full truncated-sum superlevel set. -/
theorem dyadicHullCuts_cover_bad {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞) (T U : ℝ≥0∞) :
    (⋃ c ∈ dyadicHullCuts V G S H g T U, dyadicGridCell G c.1 c.2) ⊆
      (⋃ ν ∈ V, {x | T < dyadicHullMax G (H ν) (g ν) x}) ∪
        {x | U < ∑ ν ∈ V, min (dyadicHullMax G (H ν) (g ν) x) T} := by
  classical
  intro x hx
  obtain ⟨c, hc, hxc⟩ := Set.mem_iUnion₂.mp hx
  have hbad := (Finset.mem_filter.mp (maximalDyadicCells_subset G _ hc)).2
  by_cases hind : ∀ ν ∈ V, dyadicPartialHullMax G (H ν) (g ν) c ≤ T
  · apply Or.inr
    have hsum : U < ∑ ν ∈ V, min (dyadicPartialHullMax G (H ν) (g ν) c) T :=
      lt_of_not_ge (fun hs => hbad ⟨hind, hs⟩)
    exact hsum.trans_le (Finset.sum_le_sum (fun ν _ => min_le_min_right T
      (dyadicPartialHullMax_le_full G (H ν) (g ν) hxc)))
  · push Not at hind
    obtain ⟨ν, hν, hνT⟩ := hind
    exact Or.inl (Set.mem_iUnion₂.mpr ⟨ν, hν,
      hνT.trans_le (dyadicPartialHullMax_le_full G (H ν) (g ν) hxc)⟩)

/-- The combined first-crossing length is bounded by the individual weak
cost plus the truncated-sum Markov cost. This proves both stopping rules
in blueprint `lem:cuts`, lines 458 and 463–465, before choosing thresholds. -/
theorem dyadicHullCuts_cost {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (R : Set ℝ) (hR : ∀ ν ∈ V, ∀ c ∈ H ν, dyadicGridCell G c.1 c.2 ⊆ R)
    {E M T U : ℝ} (hE0 : 0 ≤ E) (hM0 : 0 ≤ M) (hT : 0 < T) (hU : 0 < U)
    (hE : ∑ ν ∈ V, ∫⁻ x in R, g ν x ≤ ENNReal.ofReal E)
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (H ν),
      dyadicGridCell G c.1 c.2) ≤ ENNReal.ofReal M) :
    dyadicRootLength G (dyadicHullCuts V G S H g (ENNReal.ofReal T) (ENNReal.ofReal U)) ≤
      E / T + E * (1 + Real.log (2 + M * T / E)) / U := by
  classical
  let B := E * (1 + Real.log (2 + M * T / E))
  have hB : 0 ≤ B := by
    have hr : 0 ≤ M * T / E := div_nonneg (mul_nonneg hM0 hT.le) hE0
    exact mul_nonneg hE0 (by have := Real.log_nonneg (by linarith : 1 ≤ 2 + M * T / E); linarith)
  let F := fun x => ∑ ν ∈ V, min (dyadicHullMax G (H ν) (g ν) x) (ENNReal.ofReal T)
  have hFm : Measurable F := Finset.measurable_sum V (fun ν _ =>
    (dyadicHullMax_measurable G (H ν) (g ν)).inf measurable_const)
  have hFI : (∫⁻ x, F x) ≤ ENNReal.ofReal B := by
    rw [show (∫⁻ x, F x) = ∑ ν ∈ V, ∫⁻ x,
      min (dyadicHullMax G (H ν) (g ν) x) (ENNReal.ofReal T) from
      lintegral_finsetSum V (fun ν _ =>
        (dyadicHullMax_measurable G (H ν) (g ν)).inf measurable_const)]
    exact dyadicHullMax_log_integral V G H g R hR hE0 hM0 hT.le hE hM
  have hi : ∑ ν ∈ V, volume {x | ENNReal.ofReal T < dyadicHullMax G (H ν) (g ν) x} ≤
      ENNReal.ofReal (E / T) := by
    rw [ENNReal.ofReal_div_of_pos hT]
    apply (ENNReal.le_div_iff_mul_le
      (Or.inl (ne_of_gt (ENNReal.ofReal_pos.mpr hT))) (Or.inl ENNReal.ofReal_ne_top)).mpr
    rw [mul_comm, Finset.mul_sum]
    exact (Finset.sum_le_sum (fun ν hν =>
      dyadicHullMax_weak G (H ν) (g ν) R (hR ν hν) (ENNReal.ofReal T))).trans hE
  have hs : volume {x | ENNReal.ofReal U < F x} ≤ ENNReal.ofReal (B / U) := by
    rw [ENNReal.ofReal_div_of_pos hU]
    calc
      _ ≤ volume {x | ENNReal.ofReal U ≤ F x} :=
        measure_mono (Set.ofPred_subset_ofPred.mpr (fun _ hx => le_of_lt hx))
      _ ≤ (∫⁻ x, F x) / ENNReal.ofReal U := meas_ge_le_lintegral_div hFm.aemeasurable
        (ne_of_gt (ENNReal.ofReal_pos.mpr hU)) ENNReal.ofReal_ne_top
      _ ≤ _ := ENNReal.div_le_div_right hFI _
  apply (ENNReal.ofReal_le_ofReal_iff
    (add_nonneg (div_nonneg hE0 hT.le) (div_nonneg hB hU.le))).mp
  have hC : Set.PairwiseDisjoint
      (dyadicHullCuts V G S H g (ENNReal.ofReal T) (ENNReal.ofReal U) : Set (ℤ × ℤ))
      (fun c => dyadicGridCell G c.1 c.2) := by
    unfold dyadicHullCuts
    exact maximalDyadicCells_pairwiseDisjoint G _
  rw [dyadicRootLength_ofReal_eq_volume G _ hC]
  calc
    _ ≤ volume ((⋃ ν ∈ V, {x | ENNReal.ofReal T < dyadicHullMax G (H ν) (g ν) x}) ∪
        {x | ENNReal.ofReal U < F x}) := measure_mono (dyadicHullCuts_cover_bad V G S H g _ _)
    _ ≤ volume (⋃ ν ∈ V, {x | ENNReal.ofReal T < dyadicHullMax G (H ν) (g ν) x}) +
        volume {x | ENNReal.ofReal U < F x} := measure_union_le _ _
    _ ≤ (∑ ν ∈ V, volume {x | ENNReal.ofReal T < dyadicHullMax G (H ν) (g ν) x}) +
        ENNReal.ofReal (B / U) := add_le_add (measure_biUnion_finset_le _ _) hs
    _ ≤ ENNReal.ofReal (E / T) + ENNReal.ofReal (B / U) := add_le_add hi le_rfl
    _ = _ := (ENNReal.ofReal_add (div_nonneg hE0 hT.le) (div_nonneg hB hU.le)).symm

theorem dyadicHullCuts_cost_normalized {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (root : ℤ × ℤ)
    (hR : ∀ ν ∈ V, ∀ c ∈ H ν, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {E M T U : ℝ} (hE0 : 0 ≤ E) (hM0 : 0 ≤ M) (hT : 0 < T) (hU : 0 < U)
    (hE : ∑ ν ∈ V, ∫⁻ x in dyadicGridCell G root.1 root.2, g ν x ≤
      ENNReal.ofReal (E * dyadicGridLength G root.1))
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (H ν),
      dyadicGridCell G c.1 c.2) ≤ ENNReal.ofReal (M * dyadicGridLength G root.1)) :
    dyadicRootLength G (dyadicHullCuts V G S H g (ENNReal.ofReal T) (ENNReal.ofReal U)) ≤
      (E / T + E * (1 + Real.log (2 + M * T / E)) / U) * dyadicGridLength G root.1 := by
  have hL := dyadicGridLength_pos G root.1
  have hb := dyadicHullCuts_cost V G S H g _ hR (mul_nonneg hE0 hL.le)
    (mul_nonneg hM0 hL.le) hT hU hE hM
  have hr : M * dyadicGridLength G root.1 * T / (E * dyadicGridLength G root.1) = M * T / E := by
    rw [mul_right_comm M _ T, mul_div_mul_right _ _ (ne_of_gt hL)]
  rw [hr] at hb
  exact hb.trans_eq (by ring)

/-- Explicit threshold choices allocate half the cut budget to each rule
in the positive-energy case of `lem:cuts`. -/
theorem dyadicHullCuts_cost_selected_pos {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (root : ℤ × ℤ)
    (hR : ∀ ν ∈ V, ∀ c ∈ H ν, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {E M ρ : ℝ} (hE0 : 0 < E) (hM0 : 0 ≤ M) (hρ : 0 < ρ)
    (hE : ∑ ν ∈ V, ∫⁻ x in dyadicGridCell G root.1 root.2, g ν x ≤
      ENNReal.ofReal (E * dyadicGridLength G root.1))
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (H ν),
      dyadicGridCell G c.1 c.2) ≤ ENNReal.ofReal (M * dyadicGridLength G root.1)) :
    dyadicRootLength G (dyadicHullCuts V G S H g (ENNReal.ofReal (2 * E / ρ))
      (ENNReal.ofReal ((2 * E / ρ) * (1 + Real.log (2 + 2 * M / ρ))))) ≤
      ρ * dyadicGridLength G root.1 := by
  have hlog : 0 < 1 + Real.log (2 + 2 * M / ρ) := by
    have hr : 0 ≤ 2 * M / ρ := div_nonneg (by positivity) hρ.le
    have := Real.log_nonneg (by linarith : 1 ≤ 2 + 2 * M / ρ)
    linarith
  have hT : 0 < 2 * E / ρ := by positivity
  have hb := dyadicHullCuts_cost_normalized V G S H g root hR hE0.le hM0 hT
    (mul_pos hT hlog) hE hM
  have hr : M * (2 * E / ρ) / E = 2 * M / ρ := by field_simp
  rw [hr] at hb
  have heq : E / (2 * E / ρ) +
      E * (1 + Real.log (2 + 2 * M / ρ)) /
        ((2 * E / ρ) * (1 + Real.log (2 + 2 * M / ρ))) = ρ := by
    have halg (l : ℝ) (hl : 0 < l) : E / (2 * E / ρ) + E * l / ((2 * E / ρ) * l) = ρ := by
      field_simp
      ring
    exact halg _ hlog
  rwa [heq] at hb

theorem dyadicPartialHullMax_zero_of_energy {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞) (R : Set ℝ)
    (hR : ∀ ν ∈ V, ∀ c ∈ H ν, dyadicGridCell G c.1 c.2 ⊆ R)
    (hE : ∑ ν ∈ V, ∫⁻ x in R, g ν x ≤ 0) (ν : ι) (hν : ν ∈ V) (c : ℤ × ℤ) :
    dyadicPartialHullMax G (H ν) (g ν) c = 0 := by
  classical
  apply le_antisymm _ bot_le
  apply Finset.sup_le
  intro d hd
  have hz : (∫⁻ x in dyadicGridCell G d.1 d.2, g ν x) = 0 := by
    apply le_antisymm _ bot_le
    exact (lintegral_mono_set (hR ν hν d hd)).trans
      ((Finset.single_le_sum (fun _ _ => bot_le) hν).trans hE)
  simp only [dyadicEnergyAverage, hz, ENNReal.zero_div, ite_self, ENNReal.bot_eq_zero, le_refl]

theorem dyadicHullCuts_empty_of_energy_zero {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞) (R : Set ℝ)
    (hR : ∀ ν ∈ V, ∀ c ∈ H ν, dyadicGridCell G c.1 c.2 ⊆ R)
    (hE : ∑ ν ∈ V, ∫⁻ x in R, g ν x ≤ 0) (T U : ℝ≥0∞) :
    dyadicHullCuts V G S H g T U = ∅ := by
  classical
  apply Finset.eq_empty_iff_forall_notMem.mpr
  intro c hc
  have hb := (Finset.mem_filter.mp (maximalDyadicCells_subset G _ hc)).2
  apply hb
  refine ⟨fun ν hν => ?_, ?_⟩
  · rw [dyadicPartialHullMax_zero_of_energy V G H g R hR hE ν hν c]
    exact bot_le
  · have hz : ∑ ν ∈ V, min (dyadicPartialHullMax G (H ν) (g ν) c) T = 0 := by
      apply Finset.sum_eq_zero
      intro ν hν
      rw [dyadicPartialHullMax_zero_of_energy V G H g R hR hE ν hν c]
      exact min_eq_left bot_le
    exact hz.le.trans bot_le

/-- Blueprint `lem:cuts`: the selected combined first crossings cost at
most `ρ` times the root length, including the zero-energy case. -/
theorem dyadicHullCuts_cost_selected {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (root : ℤ × ℤ)
    (hR : ∀ ν ∈ V, ∀ c ∈ H ν, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {E M ρ : ℝ} (hE0 : 0 ≤ E) (hM0 : 0 ≤ M) (hρ : 0 < ρ)
    (hE : ∑ ν ∈ V, ∫⁻ x in dyadicGridCell G root.1 root.2, g ν x ≤
      ENNReal.ofReal (E * dyadicGridLength G root.1))
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (H ν),
      dyadicGridCell G c.1 c.2) ≤ ENNReal.ofReal (M * dyadicGridLength G root.1)) :
    dyadicRootLength G (dyadicHullCuts V G S H g (ENNReal.ofReal (2 * E / ρ))
      (ENNReal.ofReal ((2 * E / ρ) * (1 + Real.log (2 + 2 * M / ρ))))) ≤
      ρ * dyadicGridLength G root.1 := by
  by_cases hEp : 0 < E
  · exact dyadicHullCuts_cost_selected_pos V G S H g root hR hEp hM0 hρ hE hM
  · have hEz : E = 0 := le_antisymm (le_of_not_gt hEp) hE0
    have hz : ∑ ν ∈ V, ∫⁻ x in dyadicGridCell G root.1 root.2, g ν x ≤ 0 := by
      simpa only [hEz, zero_mul, ENNReal.ofReal_zero] using hE
    rw [dyadicHullCuts_empty_of_energy_zero V G S H g _ hR hz]
    simpa only [dyadicRootLength, Finset.sum_empty] using
      mul_nonneg hρ.le (dyadicGridLength_pos G root.1).le

open scoped Classical in
/-- Retained cells satisfy both partial-max rules; their equivalence with
deleting whole first-crossing subtrees is proved below. -/
noncomputable def dyadicHullRetained {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (T U : ℝ≥0∞) : Finset (ℤ × ℤ) := S.filter (dyadicHullGood V G H g T U)

theorem dyadicHullRetained_iff {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (T U : ℝ≥0∞) (c : ℤ × ℤ) :
    c ∈ dyadicHullRetained V G S H g T U ↔ c ∈ S ∧
      ¬∃ d ∈ dyadicHullCuts V G S H g T U,
        dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 := by
  classical
  constructor
  · intro hc
    obtain ⟨hcS, hcgood⟩ := Finset.mem_filter.mp hc
    refine ⟨hcS, ?_⟩
    rintro ⟨d, hd, hcd⟩
    have hbad := (Finset.mem_filter.mp (maximalDyadicCells_subset G _ hd)).2
    exact hbad (dyadicHullGood_ancestor V G H g T U hcd hcgood)
  · rintro ⟨hcS, hno⟩
    apply Finset.mem_filter.mpr
    refine ⟨hcS, ?_⟩
    by_contra hbad
    exact hno (maximalDyadicCells_covers G _ (Finset.mem_filter.mpr ⟨hcS, hbad⟩))

/-- Blueprint `eq:hull-cap`: the fixed-function maxima on whole retained
hull cells satisfy the sum threshold at every point, even below a cut. -/
theorem dyadicHullRetained_cap {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (hHS : ∀ ν ∈ V, H ν ⊆ S) (T U : ℝ≥0∞) (x : ℝ) :
    ∑ ν ∈ V, dyadicHullMax G (dyadicHullRetained V G (H ν) H g T U) (g ν) x ≤ U := by
  classical
  let P := (dyadicHullRetained V G S H g T U).filter
    (fun c => x ∈ dyadicGridCell G c.1 c.2)
  by_cases hP : P.Nonempty
  · obtain ⟨c, hc, hmax⟩ := Finset.exists_max_image P (fun c => c.1) hP
    obtain ⟨hcR, hxc⟩ := Finset.mem_filter.mp hc
    have hcgood : dyadicHullGood V G H g T U c := (Finset.mem_filter.mp hcR).2
    have hνbound (ν) (hν : ν ∈ V) :
        dyadicHullMax G (dyadicHullRetained V G (H ν) H g T U) (g ν) x ≤
          dyadicPartialHullMax G (H ν) (g ν) c := by
      apply Finset.sup_le
      intro d hd
      obtain ⟨hdH, hdgood⟩ := Finset.mem_filter.mp hd
      by_cases hxd : x ∈ dyadicGridCell G d.1 d.2
      · rw [Set.indicator_of_mem hxd]
        have hdP : d ∈ P := Finset.mem_filter.mpr
          ⟨Finset.mem_filter.mpr ⟨hHS ν hν hdH, hdgood⟩, hxd⟩
        have hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 := by
          rcases dyadicGridCell_nested_or_disjoint_of_le G (hmax d hdP) d.2 c.2 with hdis | hsub
          · exact (Set.disjoint_left.mp hdis hxd hxc).elim
          · exact hsub
        exact (dyadicEnergyAverage_le_partial G (H ν) (g ν) hdH).trans
          (dyadicPartialHullMax_mono G (H ν) (g ν) hcd)
      · rw [Set.indicator_of_notMem hxd]
        exact bot_le
    calc
      _ ≤ ∑ ν ∈ V, dyadicPartialHullMax G (H ν) (g ν) c := Finset.sum_le_sum hνbound
      _ = ∑ ν ∈ V, min (dyadicPartialHullMax G (H ν) (g ν) c) T :=
        dyadicPartialHullMax_sum_eq_truncated V G H g c hcgood.1
      _ ≤ U := hcgood.2
  · have hzero (ν) (hν : ν ∈ V) :
        dyadicHullMax G (dyadicHullRetained V G (H ν) H g T U) (g ν) x = 0 := by
      apply le_antisymm _ bot_le
      apply Finset.sup_le
      intro d hd
      have hxd : x ∉ dyadicGridCell G d.1 d.2 := by
        intro hx
        obtain ⟨hdH, hdgood⟩ := Finset.mem_filter.mp hd
        exact hP ⟨d, Finset.mem_filter.mpr
          ⟨Finset.mem_filter.mpr ⟨hHS ν hν hdH, hdgood⟩, hx⟩⟩
      rw [Set.indicator_of_notMem hxd]
      exact le_rfl
    have hz := Finset.sum_eq_zero hzero
    exact hz.le.trans bot_le

/-- An explicit source-admissible constant depending only on the cut
fraction, for the hull cap in `lem:cuts`. -/
noncomputable def hullCutConstant (ρ : ℝ) : ℝ := (2 / ρ) * (1 + Real.log (2 / ρ))

theorem hullCutConstant_pos {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    0 < hullCutConstant ρ := by
  have hdiv : 1 ≤ 2 / ρ := (le_div_iff₀ hρ).mpr (by linarith)
  have hlog := Real.log_nonneg hdiv
  exact mul_pos (div_pos (by norm_num) hρ) (by linarith)

theorem hullCutThreshold_le {E M ρ : ℝ} (hE : 0 ≤ E) (hM : 0 ≤ M)
    (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    (2 * E / ρ) * (1 + Real.log (2 + 2 * M / ρ)) ≤
      hullCutConstant ρ * E * (1 + Real.log (2 + M)) := by
  have hdiv : 1 ≤ 2 / ρ := (le_div_iff₀ hρ).mpr (by linarith)
  have hlogρ := Real.log_nonneg hdiv
  have hlogM := Real.log_nonneg (by linarith : 1 ≤ 2 + M)
  have hp : 0 < 2 + 2 * M / ρ := by positivity
  have harg : 2 + 2 * M / ρ ≤ (2 / ρ) * (2 + M) := by
    have htwo : 2 ≤ 4 / ρ := (le_div_iff₀ hρ).mpr (by linarith)
    calc
      _ ≤ 4 / ρ + 2 * M / ρ := add_le_add htwo le_rfl
      _ = _ := by ring
  have hl : Real.log (2 + 2 * M / ρ) ≤ Real.log (2 / ρ) + Real.log (2 + M) := by
    have hh := Real.log_le_log hp harg
    rwa [Real.log_mul (ne_of_gt (div_pos (by norm_num) hρ)) (by positivity)] at hh
  have hb : 1 + Real.log (2 + 2 * M / ρ) ≤
      (1 + Real.log (2 / ρ)) * (1 + Real.log (2 + M)) := by
    nlinarith [mul_nonneg hlogρ hlogM]
  calc
    _ ≤ (2 * E / ρ) * ((1 + Real.log (2 / ρ)) * (1 + Real.log (2 + M))) :=
      mul_le_mul_of_nonneg_left hb (by positivity)
    _ = _ := by unfold hullCutConstant; ring

open scoped Classical in
/-- Blueprint `lem:cuts`, hull assertion (`eq:hull-cap`). For fixed energy
densities on finite specified hulls, first-crossing cells of length at most
`ρ |R|` give an everywhere cap `Cρ E (1 + log (2 + M))` on whole retained
hull cells. Only hull summands are removed; the densities are unchanged. -/
theorem dyadicHullFirstCrossingCuts {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (root : ℤ × ℤ) (hHS : ∀ ν ∈ V, H ν ⊆ S)
    (hS : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {E M ρ : ℝ} (hE0 : 0 ≤ E) (hM0 : 0 ≤ M) (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (hE : ∑ ν ∈ V, ∫⁻ x in dyadicGridCell G root.1 root.2, g ν x ≤
      ENNReal.ofReal (E * dyadicGridLength G root.1))
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (H ν),
      dyadicGridCell G c.1 c.2) ≤ ENNReal.ofReal (M * dyadicGridLength G root.1)) :
    ∃ C : Finset (ℤ × ℤ), C ⊆ S ∧
      Set.PairwiseDisjoint (C : Set (ℤ × ℤ)) (fun c => dyadicGridCell G c.1 c.2) ∧
      dyadicRootLength G C ≤ ρ * dyadicGridLength G root.1 ∧
      ∀ x : ℝ, ∑ ν ∈ V, dyadicHullMax G
        ((H ν).filter (fun c => ¬∃ d ∈ C,
          dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2)) (g ν) x ≤
        ENNReal.ofReal (hullCutConstant ρ * E * (1 + Real.log (2 + M))) := by
  classical
  let T := ENNReal.ofReal (2 * E / ρ)
  let U := ENNReal.ofReal ((2 * E / ρ) * (1 + Real.log (2 + 2 * M / ρ)))
  let C := dyadicHullCuts V G S H g T U
  have hR : ∀ ν ∈ V, ∀ c ∈ H ν,
      dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2 :=
    fun ν hν c hc => hS c (hHS ν hν hc)
  refine ⟨C, ?_, ?_, dyadicHullCuts_cost_selected V G S H g root hR hE0 hM0 hρ hE hM, ?_⟩
  · intro c hc
    exact (Finset.mem_filter.mp (maximalDyadicCells_subset G _ hc)).1
  · exact maximalDyadicCells_pairwiseDisjoint G _
  · intro x
    have hfamily (ν) (hν : ν ∈ V) :
        (H ν).filter (fun c => ¬∃ d ∈ C,
          dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2) =
        dyadicHullRetained V G (H ν) H g T U := by
      ext c
      constructor
      · intro hc
        obtain ⟨hcH, hno⟩ := Finset.mem_filter.mp hc
        have hcR := (dyadicHullRetained_iff V G S H g T U c).mpr ⟨hHS ν hν hcH, hno⟩
        exact Finset.mem_filter.mpr ⟨hcH, (Finset.mem_filter.mp hcR).2⟩
      · intro hc
        obtain ⟨hcH, hgood⟩ := Finset.mem_filter.mp hc
        have hcR : c ∈ dyadicHullRetained V G S H g T U :=
          Finset.mem_filter.mpr ⟨hHS ν hν hcH, hgood⟩
        exact Finset.mem_filter.mpr ⟨hcH, ((dyadicHullRetained_iff V G S H g T U c).mp hcR).2⟩
    calc
      _ = ∑ ν ∈ V, dyadicHullMax G (dyadicHullRetained V G (H ν) H g T U) (g ν) x :=
        Finset.sum_congr rfl (fun ν hν => by rw [hfamily ν hν])
      _ ≤ U := dyadicHullRetained_cap V G S H g hHS T U x
      _ ≤ _ := ENNReal.ofReal_le_ofReal (hullCutThreshold_le hE0 hM0 hρ hρ1)

theorem lintegral_enorm_sq_eq_eLpNorm_sq {F : Type*} [NormedAddCommGroup F]
    (f : ℝ → F) (hf : AEStronglyMeasurable f volume) :
    (∫⁻ x, ‖f x‖ₑ ^ (2 : ℕ)) = eLpNorm f 2 volume ^ (2 : ℕ) := by
  rw [eLpNorm_eq_eLpNorm' (by norm_num) (by norm_num) hf]
  simpa only [ENNReal.toReal_ofNat, ENNReal.rpow_two] using
    (lintegral_rpow_enorm_eq_rpow_eLpNorm' (f := f) (μ := volume) (q := (2 : ℝ)) (by norm_num))

open scoped Classical in
/-- The fixed-function L2 version of blueprint `lem:cuts`: total squared
L2 norm and total hull support suffice for the whole-cell retained cap. -/
theorem dyadicHullFirstCrossingCuts_L2 {ι F : Type*} [NormedAddCommGroup F]
    (V : Finset ι) (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (H : ι → Finset (ℤ × ℤ)) (f : ι → ℝ → F)
    (hf : ∀ ν ∈ V, AEStronglyMeasurable (f ν) volume)
    (root : ℤ × ℤ) (hHS : ∀ ν ∈ V, H ν ⊆ S)
    (hS : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {E M ρ : ℝ} (hE0 : 0 ≤ E) (hM0 : 0 ≤ M) (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (hE : ∑ ν ∈ V, eLpNorm (f ν) 2 volume ^ (2 : ℕ) ≤
      ENNReal.ofReal (E * dyadicGridLength G root.1))
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (H ν),
      dyadicGridCell G c.1 c.2) ≤ ENNReal.ofReal (M * dyadicGridLength G root.1)) :
    ∃ C : Finset (ℤ × ℤ), C ⊆ S ∧
      Set.PairwiseDisjoint (C : Set (ℤ × ℤ)) (fun c => dyadicGridCell G c.1 c.2) ∧
      dyadicRootLength G C ≤ ρ * dyadicGridLength G root.1 ∧
      ∀ x : ℝ, ∑ ν ∈ V, dyadicHullMax G
        ((H ν).filter (fun c => ¬∃ d ∈ C,
          dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2)) (fun y => ‖f ν y‖ₑ ^ (2 : ℕ)) x ≤
        ENNReal.ofReal (hullCutConstant ρ * E * (1 + Real.log (2 + M))) := by
  apply dyadicHullFirstCrossingCuts V G S H (fun ν y => ‖f ν y‖ₑ ^ (2 : ℕ)) root
    hHS hS hE0 hM0 hρ hρ1 _ hM
  apply le_trans _ hE
  apply Finset.sum_le_sum
  intro ν hν
  rw [← lintegral_enorm_sq_eq_eLpNorm_sq (f ν) (hf ν hν)]
  exact setLIntegral_le_lintegral _ _

/-- The two children chosen from the grid's exact binary subdivision. -/
noncomputable def dyadicChildren (G : RealDyadicGrid) (c : ℤ × ℤ) : Finset (ℤ × ℤ) :=
  let n := Classical.choose (dyadicGridCell_children G c.1 c.2)
  {(c.1 + 1, n), (c.1 + 1, n + 1)}

theorem dyadicChildren_depth (G : RealDyadicGrid) (c d : ℤ × ℤ)
    (hd : d ∈ dyadicChildren G c) : d.1 = c.1 + 1 := by
  simp only [dyadicChildren, Finset.mem_insert, Finset.mem_singleton] at hd
  rcases hd with rfl | rfl <;> rfl

theorem dyadicChildren_subset (G : RealDyadicGrid) (c d : ℤ × ℤ)
    (hd : d ∈ dyadicChildren G c) : dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G c.1 c.2 := by
  have hc := Classical.choose_spec (dyadicGridCell_children G c.1 c.2)
  simp only [dyadicChildren, Finset.mem_insert, Finset.mem_singleton] at hd
  rcases hd with rfl | rfl
  · exact Set.subset_union_left.trans hc.symm.subset
  · exact Set.subset_union_right.trans hc.symm.subset

theorem dyadicChildren_cover (G : RealDyadicGrid) (c : ℤ × ℤ) {x : ℝ}
    (hx : x ∈ dyadicGridCell G c.1 c.2) :
    ∃ d ∈ dyadicChildren G c, x ∈ dyadicGridCell G d.1 d.2 := by
  rw [Classical.choose_spec (dyadicGridCell_children G c.1 c.2)] at hx
  rcases hx with hx | hx
  · exact ⟨(c.1 + 1, Classical.choose (dyadicGridCell_children G c.1 c.2)),
      by simp [dyadicChildren], hx⟩
  · exact ⟨(c.1 + 1, Classical.choose (dyadicGridCell_children G c.1 c.2) + 1),
      by simp [dyadicChildren], hx⟩

/-- The complete finite generation below a root cell, used for the terminal
completion in blueprint `lem:compression`, line 553. -/
noncomputable def dyadicGeneration (G : RealDyadicGrid) (root : ℤ × ℤ) :
    ℕ → Finset (ℤ × ℤ)
  | 0 => {root}
  | n + 1 => (dyadicGeneration G root n).biUnion (dyadicChildren G)

theorem dyadicGeneration_depth (G : RealDyadicGrid) (root : ℤ × ℤ) (n : ℕ)
    {c : ℤ × ℤ} (hc : c ∈ dyadicGeneration G root n) : c.1 = root.1 + n := by
  induction n generalizing c with
  | zero =>
    have he : c = root := by simpa only [dyadicGeneration, Finset.mem_singleton] using hc
    simp [he]
  | succ n ih =>
    obtain ⟨p, hp, hcp⟩ := Finset.mem_biUnion.mp hc
    rw [dyadicChildren_depth G p c hcp, ih hp]
    push_cast
    ring

theorem dyadicGeneration_subset (G : RealDyadicGrid) (root : ℤ × ℤ) (n : ℕ)
    {c : ℤ × ℤ} (hc : c ∈ dyadicGeneration G root n) :
    dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2 := by
  induction n generalizing c with
  | zero =>
    have he : c = root := by simpa only [dyadicGeneration, Finset.mem_singleton] using hc
    rw [he]
  | succ n ih =>
    obtain ⟨p, hp, hcp⟩ := Finset.mem_biUnion.mp hc
    exact (dyadicChildren_subset G p c hcp).trans (ih hp)

theorem dyadicGeneration_cover (G : RealDyadicGrid) (root : ℤ × ℤ) (n : ℕ) {x : ℝ}
    (hx : x ∈ dyadicGridCell G root.1 root.2) :
    ∃ c ∈ dyadicGeneration G root n, x ∈ dyadicGridCell G c.1 c.2 := by
  induction n with
  | zero => exact ⟨root, Finset.mem_singleton_self _, hx⟩
  | succ n ih =>
    obtain ⟨p, hp, hxp⟩ := ih
    obtain ⟨c, hc, hxc⟩ := dyadicChildren_cover G p hxp
    exact ⟨c, Finset.mem_biUnion.mpr ⟨p, hp, hc⟩, hxc⟩

theorem dyadicGeneration_union (G : RealDyadicGrid) (root : ℤ × ℤ) (n : ℕ) :
    (⋃ c ∈ dyadicGeneration G root n, dyadicGridCell G c.1 c.2) =
      dyadicGridCell G root.1 root.2 := by
  ext x
  simp only [Set.mem_iUnion]
  constructor
  · rintro ⟨c, hc, hx⟩
    exact dyadicGeneration_subset G root n hc hx
  · intro hx
    obtain ⟨c, hc, hxc⟩ := dyadicGeneration_cover G root n hx
    exact ⟨c, hc, hxc⟩

theorem dyadicGeneration_pairwiseDisjoint (G : RealDyadicGrid) (root : ℤ × ℤ) (n : ℕ) :
    (dyadicGeneration G root n : Set (ℤ × ℤ)).PairwiseDisjoint
      (fun c => dyadicGridCell G c.1 c.2) := by
  intro c hc d hd hcd
  have hcs := dyadicGeneration_depth G root n hc
  have hds := dyadicGeneration_depth G root n hd
  have hpos : c.2 ≠ d.2 := by
    intro he
    exact hcd (Prod.ext (hcs.trans hds.symm) he)
  change Disjoint (dyadicGridCell G c.1 c.2) (dyadicGridCell G d.1 d.2)
  rw [hcs, hds]
  exact dyadicGridCell_pairwiseDisjoint G (root.1 + n) hpos

theorem dyadicGeneration_mem_iff (G : RealDyadicGrid) (root c : ℤ × ℤ) (n : ℕ) :
    c ∈ dyadicGeneration G root n ↔ c.1 = root.1 + n ∧
      dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2 := by
  constructor
  · intro hc
    exact ⟨dyadicGeneration_depth G root n hc, dyadicGeneration_subset G root n hc⟩
  · rintro ⟨hcs, hsub⟩
    let x := dyadicGridLeft G c.1 c.2
    have hxc : x ∈ dyadicGridCell G c.1 c.2 := dyadicGridCell_left_mem G _ _
    obtain ⟨d, hd, hxd⟩ := dyadicGeneration_cover G root n (hsub hxc)
    have hds := dyadicGeneration_depth G root n hd
    have hcds : c.1 = d.1 := hcs.trans hds.symm
    have hpos : c.2 = d.2 := dyadicGridCell_sameDepth_common_point G c.1 c.2 d.2 hxc
      (by simpa only [hcds] using hxd)
    exact (Prod.ext hcds hpos).symm ▸ hd

theorem dyadicGridCell_depth_le_of_subset (G : RealDyadicGrid) (c d : ℤ × ℤ)
    (h : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2) : d.1 ≤ c.1 := by
  apply (dyadicGridLength_strictAnti G).le_iff_ge.mp
  have hv : volume (dyadicGridCell G c.1 c.2) ≤ volume (dyadicGridCell G d.1 d.2) :=
    measure_mono h
  rw [dyadicGridCell_volume, dyadicGridCell_volume] at hv
  exact ENNReal.ofReal_le_ofReal_iff (dyadicGridLength_pos G d.1).le |>.mp hv

/-- The complete finite tree through generation `N`, including its root. -/
noncomputable def dyadicFiniteTree (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ) :
    Finset (ℤ × ℤ) :=
  (Finset.range (N + 1)).biUnion (dyadicGeneration G root)

theorem dyadicFiniteTree_mem_iff (G : RealDyadicGrid) (root c : ℤ × ℤ) (N : ℕ) :
    c ∈ dyadicFiniteTree G root N ↔
      dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2 ∧
        c.1 ≤ root.1 + N := by
  constructor
  · intro hc
    obtain ⟨n, hn, hcn⟩ := Finset.mem_biUnion.mp hc
    have hdepth := dyadicGeneration_depth G root n hcn
    exact ⟨dyadicGeneration_subset G root n hcn, by
      have := Finset.mem_range.mp hn
      omega⟩
  · rintro ⟨hsub, hdepth⟩
    have hlow := dyadicGridCell_depth_le_of_subset G c root hsub
    let n := (c.1 - root.1).toNat
    have hn : (n : ℤ) = c.1 - root.1 := Int.toNat_of_nonneg (by omega)
    apply Finset.mem_biUnion.mpr
    refine ⟨n, Finset.mem_range.mpr (by omega), ?_⟩
    exact (dyadicGeneration_mem_iff G root c n).mpr ⟨by omega, hsub⟩

theorem dyadicFiniteTree_root_mem (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ) :
    root ∈ dyadicFiniteTree G root N := by
  apply (dyadicFiniteTree_mem_iff G root root N).mpr
  exact ⟨Set.Subset.rfl, by omega⟩

theorem dyadicFiniteTree_ancestor_mem (G : RealDyadicGrid) (root c d : ℤ × ℤ) (N : ℕ)
    (hc : c ∈ dyadicFiniteTree G root N)
    (hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2)
    (hdr : dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G root.1 root.2) :
    d ∈ dyadicFiniteTree G root N := by
  apply (dyadicFiniteTree_mem_iff G root d N).mpr
  exact ⟨hdr, (dyadicGridCell_depth_le_of_subset G c d hcd).trans
    ((dyadicFiniteTree_mem_iff G root c N).mp hc).2⟩

/-- Any finite family below a root fits strictly above the terminal generation
of a complete finite tree, as required in `lem:compression`, line 553. -/
theorem dyadicFiniteTree_encloses (G : RealDyadicGrid) (root : ℤ × ℤ)
    (S : Finset (ℤ × ℤ))
    (hS : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2) :
    ∃ N : ℕ, S ⊆ dyadicFiniteTree G root N ∧ ∀ c ∈ S, c.1 < root.1 + N := by
  let N := S.sup (fun c => (c.1 - root.1).toNat) + 1
  have hdepth : ∀ c ∈ S, c.1 < root.1 + N := by
    intro c hc
    have hb := Finset.le_sup (f := fun c : ℤ × ℤ => (c.1 - root.1).toNat) hc
    have hlow := dyadicGridCell_depth_le_of_subset G c root (hS c hc)
    have hn := Int.toNat_of_nonneg (by omega : 0 ≤ c.1 - root.1)
    dsimp [N]
    omega
  exact ⟨N, fun c hc => (dyadicFiniteTree_mem_iff G root c N).mpr
    ⟨hS c hc, (hdepth c hc).le⟩, hdepth⟩

/-- Stop at the first marked cells and fill every remaining branch with a
terminal leaf. This is the finite cut partition in `lem:compression`, line 553. -/
noncomputable def dyadicTerminalCuts (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (B : Finset (ℤ × ℤ)) : Finset (ℤ × ℤ) :=
  maximalDyadicCells G (B ∪ dyadicGeneration G root N)

theorem dyadicGeneration_subset_finiteTree (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ) :
    dyadicGeneration G root N ⊆ dyadicFiniteTree G root N := by
  intro c hc
  exact (dyadicFiniteTree_mem_iff G root c N).mpr
    ⟨dyadicGeneration_subset G root N hc, (dyadicGeneration_depth G root N hc).le⟩

theorem dyadicTerminalCuts_subset (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (B : Finset (ℤ × ℤ)) (hB : B ⊆ dyadicFiniteTree G root N) :
    dyadicTerminalCuts G root N B ⊆ dyadicFiniteTree G root N := by
  intro c hc
  rcases Finset.mem_union.mp (maximalDyadicCells_subset G _ hc) with hb | hl
  · exact hB hb
  · exact dyadicGeneration_subset_finiteTree G root N hl

theorem dyadicTerminalCuts_pairwiseDisjoint (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (B : Finset (ℤ × ℤ)) :
    (dyadicTerminalCuts G root N B : Set (ℤ × ℤ)).PairwiseDisjoint
      (fun c => dyadicGridCell G c.1 c.2) :=
  maximalDyadicCells_pairwiseDisjoint G _

theorem dyadicTerminalCuts_union (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (B : Finset (ℤ × ℤ)) (hB : B ⊆ dyadicFiniteTree G root N) :
    (⋃ c ∈ dyadicTerminalCuts G root N B, dyadicGridCell G c.1 c.2) =
      dyadicGridCell G root.1 root.2 := by
  ext x
  simp only [Set.mem_iUnion]
  constructor
  · rintro ⟨c, hc, hx⟩
    exact ((dyadicFiniteTree_mem_iff G root c N).mp
      (dyadicTerminalCuts_subset G root N B hB hc)).1 hx
  · intro hx
    obtain ⟨c, hc, hxc⟩ := dyadicGeneration_cover G root N hx
    obtain ⟨d, hd, hcd⟩ := maximalDyadicCells_covers G (B ∪ dyadicGeneration G root N)
      (Finset.mem_union_right B hc)
    exact ⟨d, hd, hcd hxc⟩

theorem dyadicTerminalCuts_marked_or_terminal (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (B : Finset (ℤ × ℤ)) {c : ℤ × ℤ} (hc : c ∈ dyadicTerminalCuts G root N B) :
    c ∈ B ∨ c.1 = root.1 + N := by
  rcases Finset.mem_union.mp (maximalDyadicCells_subset G _ hc) with hb | hl
  · exact Or.inl hb
  · exact Or.inr (dyadicGeneration_depth G root N hl)

/-- No proper ancestor of a first cut is marked. In particular its parent
satisfies the stopping threshold. -/
theorem dyadicTerminalCuts_ancestor_not_marked (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (B : Finset (ℤ × ℤ)) {c d : ℤ × ℤ} (hc : c ∈ dyadicTerminalCuts G root N B)
    (hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2) (hne : c ≠ d) :
    d ∉ B := by
  classical
  intro hd
  have hmax := (Finset.mem_filter.mp hc).2
  have hdc := hmax d (Finset.mem_union_left _ hd) hcd
  exact hne (dyadicGridCell_injective G (Set.Subset.antisymm hcd hdc))

theorem dyadicTerminalCuts_below_unstopped (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (B : Finset (ℤ × ℤ)) {u c : ℤ × ℤ} (hu : u ∈ dyadicFiniteTree G root N)
    (hstop : ∀ b ∈ B, ¬dyadicGridCell G u.1 u.2 ⊆ dyadicGridCell G b.1 b.2)
    (hc : c ∈ dyadicTerminalCuts G root N B) {x : ℝ}
    (hxu : x ∈ dyadicGridCell G u.1 u.2) (hxc : x ∈ dyadicGridCell G c.1 c.2) :
    dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G u.1 u.2 := by
  rcases dyadicGridCell_laminar G c u with hdis | hsub | hsup
  · exact (Set.disjoint_left.mp hdis hxc hxu).elim
  · exact hsub
  · rcases dyadicTerminalCuts_marked_or_terminal G root N B hc with hb | hdepth
    · exact (hstop c hb hsup).elim
    · have huDepth := ((dyadicFiniteTree_mem_iff G root u N).mp hu).2
      have hcu := dyadicGridCell_depth_le_of_subset G u c hsup
      have he : u.1 = c.1 := by omega
      have hp : u.2 = c.2 := dyadicGridCell_sameDepth_common_point G u.1 u.2 c.2 hxu
        (by simpa only [he] using hxc)
      have hue : u = c := Prod.ext he hp
      rw [hue]

open scoped Classical in
/-- The same terminal partition subdivides every cell before the first stop,
which is the partition identity needed to preserve its column moments. -/
theorem dyadicTerminalCuts_union_below (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (B : Finset (ℤ × ℤ)) (hB : B ⊆ dyadicFiniteTree G root N)
    {u : ℤ × ℤ} (hu : u ∈ dyadicFiniteTree G root N)
    (hstop : ∀ b ∈ B, ¬dyadicGridCell G u.1 u.2 ⊆ dyadicGridCell G b.1 b.2) :
    (⋃ c ∈ (dyadicTerminalCuts G root N B).filter
      (fun c : ℤ × ℤ => dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G u.1 u.2),
      dyadicGridCell G c.1 c.2) = dyadicGridCell G u.1 u.2 := by
  classical
  ext x
  simp only [Set.mem_iUnion, Finset.mem_filter]
  constructor
  · rintro ⟨c, ⟨_, hcu⟩, hx⟩
    exact hcu hx
  · intro hx
    have hxr := ((dyadicFiniteTree_mem_iff G root u N).mp hu).1 hx
    rw [← dyadicTerminalCuts_union G root N B hB] at hxr
    obtain ⟨c, hc, hxc⟩ := Set.mem_iUnion₂.mp hxr
    exact ⟨c, ⟨hc, dyadicTerminalCuts_below_unstopped G root N B hu hstop hc hx hxc⟩, hxc⟩

open scoped Classical in
/-- Cells whose size exceeds the current segment's threshold. -/
noncomputable def dyadicThresholdCells (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) (T : ℝ) : Finset (ℤ × ℤ) :=
  (dyadicFiniteTree G root N).filter (fun c => T < a c)

theorem dyadicThresholdCells_subset (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) (T : ℝ) :
    dyadicThresholdCells G root N a T ⊆ dyadicFiniteTree G root N :=
  Finset.filter_subset _ _

/-- Before the first cut every proper ancestor remains below the threshold.
Applying this to the parent is the first half of the four-times-average bound. -/
theorem dyadicThresholdCuts_ancestor_le (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) (T : ℝ) {c d : ℤ × ℤ}
    (hc : c ∈ dyadicTerminalCuts G root N (dyadicThresholdCells G root N a T))
    (hd : d ∈ dyadicFiniteTree G root N)
    (hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2) (hne : c ≠ d) :
    a d ≤ T := by
  classical
  apply le_of_not_gt
  intro hbad
  exact dyadicTerminalCuts_ancestor_not_marked G root N _ hc hcd hne
    (Finset.mem_filter.mpr ⟨hd, hbad⟩)

/-- Every nonroot cell of a completed finite tree has its parent in that tree. -/
theorem dyadicFiniteTree_parent (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    {c : ℤ × ℤ} (hc : c ∈ dyadicFiniteTree G root N) (hne : c ≠ root) :
    ∃ p ∈ dyadicFiniteTree G root N, c ∈ dyadicChildren G p := by
  obtain ⟨n, hn, hcn⟩ := Finset.mem_biUnion.mp hc
  cases n with
  | zero =>
    have he : c = root := by simpa only [dyadicGeneration, Finset.mem_singleton] using hcn
    exact (hne he).elim
  | succ n =>
    obtain ⟨p, hp, hcp⟩ := Finset.mem_biUnion.mp hcn
    refine ⟨p, Finset.mem_biUnion.mpr ⟨n, ?_, hp⟩, hcp⟩
    have := Finset.mem_range.mp hn
    exact Finset.mem_range.mpr (by omega)

/-- The normalized average on a dyadic cell; spatial compression applies it
to the pointwise norm of the Hilbert-valued input. -/
noncomputable def dyadicCellAverage (G : RealDyadicGrid) (f : ℝ → ℝ) (c : ℤ × ℤ) : ℝ :=
  (∫ x in dyadicGridCell G c.1 c.2, f x) / dyadicGridLength G c.1

theorem dyadicCellAverage_nonneg (G : RealDyadicGrid) (f : ℝ → ℝ)
    (hf : ∀ x, 0 ≤ f x) (c : ℤ × ℤ) : 0 ≤ dyadicCellAverage G f c :=
  div_nonneg (integral_nonneg hf) (dyadicGridLength_pos G c.1).le

/-- A nonnegative function's child average is at most twice its parent average. -/
theorem dyadicCellAverage_child_le (G : RealDyadicGrid) (f : ℝ → ℝ)
    (hf : ∀ x, 0 ≤ f x) (p c : ℤ × ℤ) (hc : c ∈ dyadicChildren G p)
    (hi : IntegrableOn f (dyadicGridCell G p.1 p.2)) :
    dyadicCellAverage G f c ≤ 2 * dyadicCellAverage G f p := by
  have hsub := dyadicChildren_subset G p c hc
  have hint : (∫ x in dyadicGridCell G c.1 c.2, f x) ≤
      ∫ x in dyadicGridCell G p.1 p.2, f x :=
    setIntegral_mono_set hi (Filter.Eventually.of_forall hf) (Filter.Eventually.of_forall hsub)
  have hhalf : dyadicGridLength G c.1 * 2 = dyadicGridLength G p.1 := by
    rw [dyadicChildren_depth G p c hc]
    exact dyadicGridLength_half G p.1
  unfold dyadicCellAverage
  calc
    _ ≤ (∫ x in dyadicGridCell G p.1 p.2, f x) / dyadicGridLength G c.1 :=
      div_le_div_of_nonneg_right hint (dyadicGridLength_pos G c.1).le
    _ = _ := by rw [← hhalf]; field_simp

/-- Every cut of the doubling-average segment has average at most four times
its root average, including terminal leaves (`lem:compression`, line 553). -/
theorem dyadicDoublingCut_average_le (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (f : ℝ → ℝ) (hf : ∀ x, 0 ≤ f x)
    (hi : IntegrableOn f (dyadicGridCell G root.1 root.2))
    {c : ℤ × ℤ} (hc : c ∈ dyadicTerminalCuts G root N
      (dyadicThresholdCells G root N (dyadicCellAverage G f) (2 * dyadicCellAverage G f root))) :
    dyadicCellAverage G f c ≤ 4 * dyadicCellAverage G f root := by
  by_cases he : c = root
  · rw [he]
    have := dyadicCellAverage_nonneg G f hf root
    linarith
  · have hcT := dyadicTerminalCuts_subset G root N _
      (dyadicThresholdCells_subset G root N (dyadicCellAverage G f) _) hc
    obtain ⟨p, hp, hcp⟩ := dyadicFiniteTree_parent G root N hcT he
    have hsub := dyadicChildren_subset G p c hcp
    have hne : c ≠ p := by
      intro h
      have hd := dyadicChildren_depth G p c hcp
      rw [h] at hd
      omega
    have hparent := dyadicThresholdCuts_ancestor_le G root N (dyadicCellAverage G f)
      (2 * dyadicCellAverage G f root) hc hp hsub hne
    have hip := hi.mono_set ((dyadicFiniteTree_mem_iff G root p N).mp hp).1
    have hchild := dyadicCellAverage_child_le G f hf p c hcp hip
    linarith

theorem dyadicGridCell_depth_lt_of_subset_ne (G : RealDyadicGrid) (c d : ℤ × ℤ)
    (hsub : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2) (hne : c ≠ d) :
    d.1 < c.1 := by
  have hle := dyadicGridCell_depth_le_of_subset G c d hsub
  apply lt_of_le_of_ne hle
  intro he
  have hx := dyadicGridCell_left_mem G c.1 c.2
  have hd := hsub hx
  have hp := dyadicGridCell_sameDepth_common_point G c.1 c.2 d.2 hx
    (by simpa only [he] using hd)
  exact hne (Prod.ext he.symm hp)

open scoped Classical in
/-- The next roots are the first descendants exceeding twice the current
root's size (`lem:compression`, line 553). -/
noncomputable def dyadicNextSizeRoots (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (K : ℤ × ℤ) : Finset (ℤ × ℤ) :=
  maximalDyadicCells G (S.filter (fun c : ℤ × ℤ =>
    dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G K.1 K.2 ∧ 2 * a K < a c))

theorem dyadicNextSizeRoots_mem (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (K : ℤ × ℤ) {c : ℤ × ℤ} (hc : c ∈ dyadicNextSizeRoots G S a K) :
    c ∈ S ∧ dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G K.1 K.2 ∧ 2 * a K < a c := by
  classical
  exact Finset.mem_filter.mp (maximalDyadicCells_subset G _ hc)

theorem dyadicNextSizeRoots_depth_lt (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (K : ℤ × ℤ) (hK : 0 ≤ a K) {c : ℤ × ℤ}
    (hc : c ∈ dyadicNextSizeRoots G S a K) : K.1 < c.1 := by
  obtain ⟨_, hsub, hsize⟩ := dyadicNextSizeRoots_mem G S a K hc
  apply dyadicGridCell_depth_lt_of_subset_ne G c K hsub
  intro he
  rw [he] at hsize
  linarith

theorem dyadicNextSizeRoots_pairwiseDisjoint (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (K : ℤ × ℤ) :
    (dyadicNextSizeRoots G S a K : Set (ℤ × ℤ)).PairwiseDisjoint
      (fun c => dyadicGridCell G c.1 c.2) :=
  maximalDyadicCells_pairwiseDisjoint G _

/-- Stopping generations, indexed by number of average doublings rather than
physical depth. -/
noncomputable def dyadicSizeGeneration (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (root : ℤ × ℤ) : ℕ → Finset (ℤ × ℤ)
  | 0 => {root}
  | n + 1 => (dyadicSizeGeneration G S a root n).biUnion (dyadicNextSizeRoots G S a)

theorem dyadicSizeGeneration_subset (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (root : ℤ × ℤ) (hroot : root ∈ S) (n : ℕ) :
    dyadicSizeGeneration G S a root n ⊆ S := by
  cases n with
  | zero => simpa only [dyadicSizeGeneration, Finset.singleton_subset_iff] using hroot
  | succ n =>
    intro c hc
    obtain ⟨K, _, hcK⟩ := Finset.mem_biUnion.mp hc
    exact (dyadicNextSizeRoots_mem G S a K hcK).1

theorem dyadicSizeGeneration_depth (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (root : ℤ × ℤ) (hroot : root ∈ S)
    (ha : ∀ c ∈ S, 0 ≤ a c) (n : ℕ) {c : ℤ × ℤ}
    (hc : c ∈ dyadicSizeGeneration G S a root n) : root.1 + n ≤ c.1 := by
  induction n generalizing c with
  | zero =>
    have he : c = root := by simpa only [dyadicSizeGeneration, Finset.mem_singleton] using hc
    simp [he]
  | succ n ih =>
    obtain ⟨K, hK, hcK⟩ := Finset.mem_biUnion.mp hc
    have hp := ih hK
    have hlt := dyadicNextSizeRoots_depth_lt G S a K
      (ha K (dyadicSizeGeneration_subset G S a root hroot n hK)) hcK
    push_cast
    omega

theorem dyadicSizeGeneration_pairwiseDisjoint (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (root : ℤ × ℤ) (n : ℕ) :
    (dyadicSizeGeneration G S a root n : Set (ℤ × ℤ)).PairwiseDisjoint
      (fun c => dyadicGridCell G c.1 c.2) := by
  induction n with
  | zero => simp [dyadicSizeGeneration, Set.PairwiseDisjoint]
  | succ n ih =>
    intro c hc d hd hne
    obtain ⟨K, hK, hcK⟩ := Finset.mem_biUnion.mp hc
    obtain ⟨L, hL, hdL⟩ := Finset.mem_biUnion.mp hd
    by_cases he : K = L
    · subst L
      exact dyadicNextSizeRoots_pairwiseDisjoint G S a K hcK hdL hne
    · exact (ih hK hL he).mono (dyadicNextSizeRoots_mem G S a K hcK).2.1
        (dyadicNextSizeRoots_mem G S a L hdL).2.1

/-- Finite physical depth forces termination, without an assumed bound on
the number of labels or on the input averages. -/
theorem dyadicSizeGeneration_eq_empty (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ dyadicFiniteTree G root N, 0 ≤ a c)
    (n : ℕ) (hn : N < n) :
    dyadicSizeGeneration G (dyadicFiniteTree G root N) a root n = ∅ := by
  apply Finset.eq_empty_iff_forall_notMem.mpr
  intro c hc
  have hr := dyadicFiniteTree_root_mem G root N
  have hd := dyadicSizeGeneration_depth G _ a root hr ha n hc
  have hT := dyadicSizeGeneration_subset G _ a root hr n hc
  have hupper := ((dyadicFiniteTree_mem_iff G root c N).mp hT).2
  omega

/-- All stopping roots of the completed finite tree. -/
noncomputable def dyadicSizeRoots (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) : Finset (ℤ × ℤ) :=
  (Finset.range (N + 1)).biUnion (dyadicSizeGeneration G (dyadicFiniteTree G root N) a root)

theorem dyadicSizeRoots_root_mem (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) : root ∈ dyadicSizeRoots G root N a :=
  Finset.mem_biUnion.mpr ⟨0, Finset.mem_range.mpr (by omega), Finset.mem_singleton_self _⟩

theorem dyadicSizeRoots_subset (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) : dyadicSizeRoots G root N a ⊆ dyadicFiniteTree G root N := by
  intro c hc
  obtain ⟨n, _, hcn⟩ := Finset.mem_biUnion.mp hc
  exact dyadicSizeGeneration_subset G _ a root (dyadicFiniteTree_root_mem G root N) n hcn

theorem dyadicSizeRoots_closed (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ dyadicFiniteTree G root N, 0 ≤ a c)
    {K c : ℤ × ℤ} (hK : K ∈ dyadicSizeRoots G root N a)
    (hc : c ∈ dyadicNextSizeRoots G (dyadicFiniteTree G root N) a K) :
    c ∈ dyadicSizeRoots G root N a := by
  obtain ⟨n, hn, hKn⟩ := Finset.mem_biUnion.mp hK
  have hcn : c ∈ dyadicSizeGeneration G (dyadicFiniteTree G root N) a root (n + 1) :=
    Finset.mem_biUnion.mpr ⟨K, hKn, hc⟩
  have hbound : n + 1 ≤ N := by
    by_contra h
    rw [dyadicSizeGeneration_eq_empty G root N a ha (n + 1) (by omega)] at hcn
    exact Finset.notMem_empty _ hcn
  exact Finset.mem_biUnion.mpr ⟨n + 1, Finset.mem_range.mpr (by omega), hcn⟩

open scoped Classical in
/-- The cells between a stopping root and its next first crossings. -/
noncomputable def dyadicSizeSegment (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (K : ℤ × ℤ) : Finset (ℤ × ℤ) :=
  S.filter (fun u : ℤ × ℤ => dyadicGridCell G u.1 u.2 ⊆ dyadicGridCell G K.1 K.2 ∧
    ∀ b ∈ dyadicNextSizeRoots G S a K,
      ¬dyadicGridCell G u.1 u.2 ⊆ dyadicGridCell G b.1 b.2)

/-- Every finite-tree cell belongs to the size segment of a deepest stopping
ancestor, exactly as assigned in `lem:compression`, line 553. -/
theorem dyadicSizeSegment_exists (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ dyadicFiniteTree G root N, 0 ≤ a c)
    {u : ℤ × ℤ} (hu : u ∈ dyadicFiniteTree G root N) :
    ∃ K ∈ dyadicSizeRoots G root N a,
      u ∈ dyadicSizeSegment G (dyadicFiniteTree G root N) a K ∧
      ∀ L ∈ dyadicSizeRoots G root N a,
        dyadicGridCell G u.1 u.2 ⊆ dyadicGridCell G L.1 L.2 → L.1 ≤ K.1 := by
  classical
  let A := (dyadicSizeRoots G root N a).filter (fun K : ℤ × ℤ =>
    dyadicGridCell G u.1 u.2 ⊆ dyadicGridCell G K.1 K.2)
  have hA : A.Nonempty := ⟨root, Finset.mem_filter.mpr
    ⟨dyadicSizeRoots_root_mem G root N a, ((dyadicFiniteTree_mem_iff G root u N).mp hu).1⟩⟩
  obtain ⟨K, hK, hmax⟩ := A.exists_max_image (fun c => c.1) hA
  obtain ⟨hKr, huK⟩ := Finset.mem_filter.mp hK
  refine ⟨K, hKr, Finset.mem_filter.mpr ⟨hu, huK, ?_⟩, ?_⟩
  · intro b hb hub
    have hbr := dyadicSizeRoots_closed G root N a ha hKr hb
    have hle := hmax b (Finset.mem_filter.mpr ⟨hbr, hub⟩)
    have hlt := dyadicNextSizeRoots_depth_lt G _ a K
      (ha K (dyadicSizeRoots_subset G root N a hKr)) hb
    omega
  · intro L hL huL
    exact hmax L (Finset.mem_filter.mpr ⟨hL, huL⟩)

/-- No threshold-violating ancestor occurs between a segment cell and its root. -/
theorem dyadicSizeSegment_no_bad_ancestor (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (K : ℤ × ℤ) {u b : ℤ × ℤ}
    (hu : u ∈ dyadicSizeSegment G S a K) (hb : b ∈ S)
    (hbK : dyadicGridCell G b.1 b.2 ⊆ dyadicGridCell G K.1 K.2)
    (hbad : 2 * a K < a b) : ¬dyadicGridCell G u.1 u.2 ⊆ dyadicGridCell G b.1 b.2 := by
  classical
  intro hub
  obtain ⟨d, hd, hbd⟩ := maximalDyadicCells_covers G
    (S.filter (fun c : ℤ × ℤ => dyadicGridCell G c.1 c.2 ⊆
      dyadicGridCell G K.1 K.2 ∧ 2 * a K < a c))
    (Finset.mem_filter.mpr ⟨hb, hbK, hbad⟩)
  exact (Finset.mem_filter.mp hu).2.2 d hd (hub.trans hbd)

/-- The physical generations remaining below a cell in the completed tree. -/
def dyadicRemainingDepth (root : ℤ × ℤ) (N : ℕ) (K : ℤ × ℤ) : ℕ :=
  (root.1 + N - K.1).toNat

theorem dyadicRemainingDepth_endpoint (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    {K : ℤ × ℤ} (hK : K ∈ dyadicFiniteTree G root N) :
    K.1 + dyadicRemainingDepth root N K = root.1 + N := by
  have hupper := ((dyadicFiniteTree_mem_iff G root K N).mp hK).2
  have hn := Int.toNat_of_nonneg (by omega : 0 ≤ root.1 + N - K.1)
  dsimp [dyadicRemainingDepth]
  omega

theorem dyadicFiniteTree_below_iff (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    {K : ℤ × ℤ} (hK : K ∈ dyadicFiniteTree G root N) (c : ℤ × ℤ) :
    c ∈ dyadicFiniteTree G K (dyadicRemainingDepth root N K) ↔
      c ∈ dyadicFiniteTree G root N ∧ dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G K.1 K.2 := by
  rw [dyadicFiniteTree_mem_iff, dyadicFiniteTree_mem_iff, dyadicRemainingDepth_endpoint G root N hK]
  have hKr := ((dyadicFiniteTree_mem_iff G root K N).mp hK).1
  constructor
  · rintro ⟨hcK, hd⟩
    exact ⟨⟨hcK.trans hKr, hd⟩, hcK⟩
  · rintro ⟨⟨_, hd⟩, hcK⟩
    exact ⟨hcK, hd⟩

/-- The first crossings and terminal leaves form the cut partition of a size segment. -/
noncomputable def dyadicSizeSegmentCuts (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) (K : ℤ × ℤ) : Finset (ℤ × ℤ) :=
  dyadicTerminalCuts G K (dyadicRemainingDepth root N K)
    (dyadicThresholdCells G K (dyadicRemainingDepth root N K) a (2 * a K))

theorem dyadicSizeSegmentCuts_subset (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) {K : ℤ × ℤ} (hK : K ∈ dyadicFiniteTree G root N) :
    dyadicSizeSegmentCuts G root N a K ⊆ dyadicFiniteTree G root N := by
  intro c hc
  have hcK := dyadicTerminalCuts_subset G K (dyadicRemainingDepth root N K) _
    (dyadicThresholdCells_subset G K _ a _) hc
  exact ((dyadicFiniteTree_below_iff G root N hK c).mp hcK).1

theorem dyadicSizeSegmentCuts_union (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) (K : ℤ × ℤ) :
    (⋃ c ∈ dyadicSizeSegmentCuts G root N a K, dyadicGridCell G c.1 c.2) =
      dyadicGridCell G K.1 K.2 :=
  dyadicTerminalCuts_union G K _ _ (dyadicThresholdCells_subset G K _ a _)

theorem dyadicSizeSegmentCuts_pairwiseDisjoint (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) (K : ℤ × ℤ) :
    (dyadicSizeSegmentCuts G root N a K : Set (ℤ × ℤ)).PairwiseDisjoint
      (fun c => dyadicGridCell G c.1 c.2) :=
  dyadicTerminalCuts_pairwiseDisjoint G K _ _

open scoped Classical in
/-- Every row cell assigned to a segment is exactly the union of the cuts
below it, the geometric identity behind preserved moments. -/
theorem dyadicSizeSegmentCuts_union_below (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) {K u : ℤ × ℤ} (hK : K ∈ dyadicFiniteTree G root N)
    (hu : u ∈ dyadicSizeSegment G (dyadicFiniteTree G root N) a K) :
    (⋃ c ∈ (dyadicSizeSegmentCuts G root N a K).filter
      (fun c : ℤ × ℤ => dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G u.1 u.2),
      dyadicGridCell G c.1 c.2) = dyadicGridCell G u.1 u.2 := by
  have huData := Finset.mem_filter.mp hu
  have huK := (dyadicFiniteTree_below_iff G root N hK u).mpr ⟨huData.1, huData.2.1⟩
  apply dyadicTerminalCuts_union_below G K (dyadicRemainingDepth root N K) _
    (dyadicThresholdCells_subset G K _ a _) huK
  intro b hb
  obtain ⟨hbK, hbad⟩ := Finset.mem_filter.mp hb
  obtain ⟨hbT, hbsub⟩ := (dyadicFiniteTree_below_iff G root N hK b).mp hbK
  exact dyadicSizeSegment_no_bad_ancestor G _ a K hu hbT hbsub hbad

/-- The sharp local weak estimate integrates the density over the very same
superlevel set. This is the distribution estimate behind the dyadic L2 bound. -/
theorem dyadicHullMax_weak_local (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) (t : ℝ≥0∞) :
    t * volume {x | t < dyadicHullMax G S g x} ≤
      ∫⁻ x in {y | t < dyadicHullMax G S g y}, g x := by
  classical
  let B := S.filter (fun c => t < dyadicEnergyAverage G g c)
  have hR : ∀ c ∈ B, dyadicGridCell G c.1 c.2 ⊆ {x | t < dyadicHullMax G S g x} := by
    intro c hc x hx
    rw [dyadicHullMax_superlevel]
    exact Set.mem_iUnion₂.mpr ⟨c, hc, hx⟩
  have hlevel : {x | t < dyadicHullMax G B g x} = {x | t < dyadicHullMax G S g x} := by
    rw [dyadicHullMax_superlevel, dyadicHullMax_superlevel]
    simp only [B, Finset.filter_filter, and_self]
  have hweak := dyadicHullMax_weak G B g {x | t < dyadicHullMax G S g x} hR t
  rwa [hlevel] at hweak

/-- The layer-cake step in the classical maximal L2 proof: a local weak-type
estimate gives the energy bound `integral M² ≤ 2 integral g M`. The density
may be extended-valued; finiteness is required only in the later cancellation. -/
theorem maximal_layercake_energy {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (M : α → ℝ) (g : α → ℝ≥0∞) (hM : Measurable M) (hM0 : ∀ x, 0 ≤ M x)
    (hg : Measurable g)
    (hweak : ∀ t : ℝ, 0 < t → ENNReal.ofReal t * μ {x | t < M x} ≤
      ∫⁻ x in {y | t < M y}, g x ∂μ) :
    (∫⁻ x, ENNReal.ofReal (M x ^ 2) ∂μ) ≤
      2 * ∫⁻ x, g x * ENNReal.ofReal (M x) ∂μ := by
  let ν := μ.withDensity g
  have hint (r : ℝ) : (∫ t in (0 : ℝ)..r, 2 * t) = r ^ 2 := by
    rw [intervalIntegral.integral_const_mul, integral_id]
    ring
  have hlayer := lintegral_comp_eq_lintegral_meas_lt_mul (f := M) (g := fun t : ℝ => 2 * t)
    μ (Filter.Eventually.of_forall hM0) hM.aemeasurable
    (fun t _ => (continuous_const.mul continuous_id).intervalIntegrable 0 t)
    (by
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      exact mul_nonneg (by norm_num) (le_of_lt ht))
  simp only [hint] at hlayer
  have hνlayer := lintegral_eq_lintegral_meas_lt ν
    (Filter.Eventually.of_forall hM0) hM.aemeasurable
  calc
    _ = ∫⁻ t in Set.Ioi (0 : ℝ), μ {x | t < M x} * ENNReal.ofReal (2 * t) := hlayer
    _ ≤ ∫⁻ t in Set.Ioi (0 : ℝ), 2 * ν {x | t < M x} := by
      apply lintegral_mono_ae
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      have hw := hweak t ht
      have hν : ν {x | t < M x} = ∫⁻ x in {y | t < M y}, g x ∂μ :=
        withDensity_apply g (measurableSet_lt measurable_const hM)
      rw [← hν] at hw
      rw [ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2), ENNReal.ofReal_ofNat]
      calc
        _ = 2 * (ENNReal.ofReal t * μ {x | t < M x}) := by
          simp only [mul_comm, mul_left_comm, mul_assoc]
        _ ≤ _ := by gcongr
    _ = 2 * ∫⁻ t in Set.Ioi (0 : ℝ), ν {x | t < M x} :=
      lintegral_const_mul' 2 _ (by norm_num)
    _ = 2 * ∫⁻ x, ENNReal.ofReal (M x) ∂ν := by rw [hνlayer]
    _ = _ := by
      rw [lintegral_withDensity_eq_lintegral_mul μ hg hM.ennreal_ofReal]
      rfl

theorem dyadicEnergyAverage_ofReal (G : RealDyadicGrid) (f : ℝ → ℝ) (c : ℤ × ℤ)
    (hf : ∀ x, 0 ≤ f x) (hi : IntegrableOn f (dyadicGridCell G c.1 c.2)) :
    dyadicEnergyAverage G (fun x => ENNReal.ofReal (f x)) c =
      ENNReal.ofReal (dyadicCellAverage G f c) := by
  unfold dyadicEnergyAverage dyadicCellAverage
  rw [← ofReal_integral_eq_lintegral_ofReal hi (Filter.Eventually.of_forall hf),
    ENNReal.ofReal_div_of_pos (dyadicGridLength_pos G c.1)]

/-- The ordinary finite dyadic maximal function of a nonnegative density. -/
noncomputable def dyadicRealMax (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (f : ℝ → ℝ) (x : ℝ) : ℝ :=
  (dyadicHullMax G S (fun y => ENNReal.ofReal (f y)) x).toReal

theorem dyadicRealMax_measurable (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℝ → ℝ) :
    Measurable (dyadicRealMax G S f) :=
  (dyadicHullMax_measurable G S _).ennreal_toReal

theorem dyadicRealMax_nonneg (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℝ → ℝ) (x : ℝ) :
    0 ≤ dyadicRealMax G S f x := ENNReal.toReal_nonneg

theorem dyadicHullMax_ofReal_le_sum (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (f : ℝ → ℝ) (hf : ∀ x, 0 ≤ f x)
    (hi : ∀ c ∈ S, IntegrableOn f (dyadicGridCell G c.1 c.2)) (x : ℝ) :
    dyadicHullMax G S (fun y => ENNReal.ofReal (f y)) x ≤
      ENNReal.ofReal (∑ c ∈ S, dyadicCellAverage G f c) := by
  classical
  apply Finset.sup_le
  intro c hc
  by_cases hx : x ∈ dyadicGridCell G c.1 c.2
  · rw [Set.indicator_of_mem hx, dyadicEnergyAverage_ofReal G f c hf (hi c hc)]
    exact ENNReal.ofReal_le_ofReal (Finset.single_le_sum
      (fun d _ => dyadicCellAverage_nonneg G f hf d) hc)
  · rw [Set.indicator_of_notMem hx]
    exact zero_le

theorem dyadicRealMax_ofReal (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (f : ℝ → ℝ) (hf : ∀ x, 0 ≤ f x)
    (hi : ∀ c ∈ S, IntegrableOn f (dyadicGridCell G c.1 c.2)) (x : ℝ) :
    ENNReal.ofReal (dyadicRealMax G S f x) =
      dyadicHullMax G S (fun y => ENNReal.ofReal (f y)) x := by
  apply ENNReal.ofReal_toReal
  exact ne_of_lt ((dyadicHullMax_ofReal_le_sum G S f hf hi x).trans_lt ENNReal.ofReal_lt_top)

theorem dyadicRealMax_le_sum (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (f : ℝ → ℝ) (hf : ∀ x, 0 ≤ f x)
    (hi : ∀ c ∈ S, IntegrableOn f (dyadicGridCell G c.1 c.2)) (x : ℝ) :
    dyadicRealMax G S f x ≤ ∑ c ∈ S, dyadicCellAverage G f c := by
  have h := ENNReal.toReal_mono ENNReal.ofReal_ne_top (dyadicHullMax_ofReal_le_sum G S f hf hi x)
  simpa only [dyadicRealMax, ENNReal.toReal_ofReal (Finset.sum_nonneg
    (fun c _ => dyadicCellAverage_nonneg G f hf c))] using h

theorem dyadicRealMax_eq_zero_off (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (f : ℝ → ℝ) (root : ℤ × ℤ)
    (hS : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {x : ℝ} (hx : x ∉ dyadicGridCell G root.1 root.2) : dyadicRealMax G S f x = 0 := by
  classical
  have hm : dyadicHullMax G S (fun y => ENNReal.ofReal (f y)) x = 0 := by
    apply le_antisymm _ zero_le
    apply Finset.sup_le
    intro c hc
    rw [Set.indicator_of_notMem (fun hxc => hx (hS c hc hxc))]
  simp only [dyadicRealMax, hm, ENNReal.toReal_zero]

theorem dyadicRealMax_memLp (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (f : ℝ → ℝ) (hf : ∀ x, 0 ≤ f x)
    (hi : ∀ c ∈ S, IntegrableOn f (dyadicGridCell G c.1 c.2))
    (root : ℤ × ℤ)
    (hS : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2) :
    MemLp (dyadicRealMax G S f) 2 volume := by
  let R := dyadicGridCell G root.1 root.2
  have hR : MeasurableSet R := dyadicGridCell_measurable G root.1 root.2
  let : IsFiniteMeasure (volume.restrict R) := isFiniteMeasure_restrict.mpr
    (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_ne_top)
  have hm : MemLp (dyadicRealMax G S f) 2 (volume.restrict R) :=
    MemLp.of_bound (dyadicRealMax_measurable G S f).aestronglyMeasurable.restrict
      (∑ c ∈ S, dyadicCellAverage G f c) (Filter.Eventually.of_forall (fun x => by
        rw [Real.norm_of_nonneg (dyadicRealMax_nonneg G S f x)]
        exact dyadicRealMax_le_sum G S f hf hi x))
  have hind := (memLp_indicator_iff_restrict hR).mpr hm
  have heq : R.indicator (dyadicRealMax G S f) = dyadicRealMax G S f := by
    ext x
    by_cases hx : x ∈ R
    · exact Set.indicator_of_mem hx _
    · rw [Set.indicator_of_notMem hx, dyadicRealMax_eq_zero_off G S f root hS hx]
  rwa [heq] at hind

/-- Cauchy–Schwarz closes the weighted maximal energy estimate with the sharp
L2 norm constant two (squared constant four). Finiteness is supplied explicitly
by the two `MemLp` hypotheses before any cancellation is made. -/
theorem maximal_layercake_l2 {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (M f : α → ℝ) (hM : Measurable M) (hf : Measurable f)
    (hM0 : ∀ x, 0 ≤ M x) (hf0 : ∀ x, 0 ≤ f x)
    (hM2 : MemLp M 2 μ) (hf2 : MemLp f 2 μ)
    (hweak : ∀ t : ℝ, 0 < t → ENNReal.ofReal t * μ {x | t < M x} ≤
      ∫⁻ x in {y | t < M y}, ENNReal.ofReal (f x) ∂μ) :
    (∫ x, M x ^ 2 ∂μ) ≤ 4 * ∫ x, f x ^ 2 ∂μ := by
  have hp : Integrable (fun x => f x * M x) μ := hf2.integrable_mul hM2
  have hp0 : ∀ x, 0 ≤ f x * M x := fun x => mul_nonneg (hf0 x) (hM0 x)
  have hA0 : 0 ≤ ∫ x, M x ^ 2 ∂μ := integral_nonneg (fun x => sq_nonneg _)
  have hB0 : 0 ≤ ∫ x, f x ^ 2 ∂μ := integral_nonneg (fun x => sq_nonneg _)
  have hP0 : 0 ≤ ∫ x, f x * M x ∂μ := integral_nonneg hp0
  have he := maximal_layercake_energy μ M (fun x => ENNReal.ofReal (f x)) hM hM0
    hf.ennreal_ofReal hweak
  have heq : (fun x => ENNReal.ofReal (f x) * ENNReal.ofReal (M x)) =
      (fun x => ENNReal.ofReal (f x * M x)) :=
    funext (fun x => (ENNReal.ofReal_mul (hf0 x)).symm)
  rw [heq, ← ofReal_integral_eq_lintegral_ofReal hM2.integrable_sq
    (Filter.Eventually.of_forall (fun x => sq_nonneg (M x))),
    ← ofReal_integral_eq_lintegral_ofReal hp (Filter.Eventually.of_forall hp0)] at he
  have henergy : (∫ x, M x ^ 2 ∂μ) ≤ 2 * ∫ x, f x * M x ∂μ := by
    apply (ENNReal.ofReal_le_ofReal_iff (mul_nonneg (by norm_num) hP0)).mp
    simpa only [ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2), ENNReal.ofReal_ofNat] using he
  have hconj : (2 : ℝ).HolderConjugate 2 := by norm_num [Real.holderConjugate_iff]
  have hcs := integral_mul_le_Lp_mul_Lq_of_nonneg hconj
    (Filter.Eventually.of_forall hf0) (Filter.Eventually.of_forall hM0)
    (by simpa using hf2) (by simpa using hM2)
  simp only [Real.rpow_two, ← Real.sqrt_eq_rpow] at hcs
  have hs : Real.sqrt (∫ x, M x ^ 2 ∂μ) ≤ 2 * Real.sqrt (∫ x, f x ^ 2 ∂μ) := by
    by_contra h
    have hlt := lt_of_not_ge h
    have hpos : 0 < Real.sqrt (∫ x, M x ^ 2 ∂μ) :=
      lt_of_le_of_lt (by positivity) hlt
    have hm := mul_pos hpos (sub_pos.mpr hlt)
    nlinarith [Real.sq_sqrt hA0]
  have hprod := mul_nonneg (sub_nonneg.mpr hs)
    (show 0 ≤ 2 * Real.sqrt (∫ x, f x ^ 2 ∂μ) + Real.sqrt (∫ x, M x ^ 2 ∂μ) by positivity)
  nlinarith [Real.sq_sqrt hA0, Real.sq_sqrt hB0]

/-- The finite dyadic maximal operator has squared L2 bound four, hence
L2 norm bound two, uniformly in the number of cells and physical depth. -/
theorem dyadicRealMax_l2 (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (root : ℤ × ℤ)
    (hS : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    (f : ℝ → ℝ) (hf : Measurable f) (hf0 : ∀ x, 0 ≤ f x) (hf2 : MemLp f 2 volume) :
    (∫ x, dyadicRealMax G S f x ^ 2) ≤ 4 * ∫ x, f x ^ 2 := by
  have hi : ∀ c ∈ S, IntegrableOn f (dyadicGridCell G c.1 c.2) := by
    intro c _
    let : IsFiniteMeasure (volume.restrict (dyadicGridCell G c.1 c.2)) :=
      isFiniteMeasure_restrict.mpr (by
        rw [dyadicGridCell_volume]
        exact ENNReal.ofReal_ne_top)
    exact (hf2.restrict (dyadicGridCell G c.1 c.2)).integrable
      (by norm_num : (1 : ENNReal) ≤ 2)
  apply maximal_layercake_l2 volume (dyadicRealMax G S f) f
    (dyadicRealMax_measurable G S f) hf (dyadicRealMax_nonneg G S f) hf0
    (dyadicRealMax_memLp G S f hf0 hi root hS) hf2
  intro t ht
  have hlevel : {x | t < dyadicRealMax G S f x} =
      {x | ENNReal.ofReal t < dyadicHullMax G S (fun y => ENNReal.ofReal (f y)) x} := by
    ext x
    simp only [Set.mem_ofPred_eq]
    rw [← dyadicRealMax_ofReal G S f hf0 hi x]
    exact (ENNReal.ofReal_lt_ofReal_iff_of_nonneg ht.le).symm
  rw [hlevel]
  exact dyadicHullMax_weak_local G S _ _

theorem dyadicCellAverage_le_max (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (f : ℝ → ℝ) (hf : ∀ x, 0 ≤ f x)
    (hi : ∀ c ∈ S, IntegrableOn f (dyadicGridCell G c.1 c.2))
    {c : ℤ × ℤ} (hc : c ∈ S) {x : ℝ} (hx : x ∈ dyadicGridCell G c.1 c.2) :
    dyadicCellAverage G f c ≤ dyadicRealMax G S f x := by
  classical
  have h : ENNReal.ofReal (dyadicCellAverage G f c) ≤
      dyadicHullMax G S (fun y => ENNReal.ofReal (f y)) x := by
    apply Finset.le_sup_of_le hc
    rw [Set.indicator_of_mem hx, dyadicEnergyAverage_ofReal G f c hf (hi c hc)]
  rw [← dyadicRealMax_ofReal G S f hf hi x] at h
  exact (ENNReal.ofReal_le_ofReal_iff (dyadicRealMax_nonneg G S f x)).mp h

/-- Every later stopping root descends from a root of each earlier stopping
generation, and its size has increased by at least one doubling. -/
theorem dyadicSizeGeneration_ancestor (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (root : ℤ × ℤ) (hroot : root ∈ S)
    (ha : ∀ c ∈ S, 0 ≤ a c) (i j : ℕ) (hij : i ≤ j) {L : ℤ × ℤ}
    (hL : L ∈ dyadicSizeGeneration G S a root j) :
    ∃ K ∈ dyadicSizeGeneration G S a root i,
      dyadicGridCell G L.1 L.2 ⊆ dyadicGridCell G K.1 K.2 ∧
      a K ≤ a L ∧ (i < j → 2 * a K < a L) := by
  induction j generalizing i L with
  | zero =>
    have hi : i = 0 := by omega
    subst i
    exact ⟨L, hL, Set.Subset.rfl, le_rfl, by omega⟩
  | succ j ih =>
    by_cases he : i = j + 1
    · subst i
      exact ⟨L, hL, Set.Subset.rfl, le_rfl, by omega⟩
    · obtain ⟨P, hP, hLP⟩ := Finset.mem_biUnion.mp hL
      obtain ⟨K, hK, hPK, hsize, _⟩ := ih i (by omega) hP
      obtain ⟨_, hLPsub, hdouble⟩ := dyadicNextSizeRoots_mem G S a P hLP
      have hP0 := ha P (dyadicSizeGeneration_subset G S a root hroot j hP)
      exact ⟨K, hK, hLPsub.trans hPK, by linarith, fun _ => by linarith⟩

theorem dyadicSizeGeneration_sameLevel_common_point (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (root : ℤ × ℤ) (n : ℕ) {K L : ℤ × ℤ}
    (hK : K ∈ dyadicSizeGeneration G S a root n)
    (hL : L ∈ dyadicSizeGeneration G S a root n) {x : ℝ}
    (hxK : x ∈ dyadicGridCell G K.1 K.2) (hxL : x ∈ dyadicGridCell G L.1 L.2) : K = L := by
  by_contra hne
  exact Set.disjoint_left.mp (dyadicSizeGeneration_pairwiseDisjoint G S a root n hK hL hne) hxK hxL

/-- Distinct nested stopping roots have strictly doubled sizes, even when
their stopping generations are not consecutive. -/
theorem dyadicSizeRoots_nested_doubling (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ dyadicFiniteTree G root N, 0 ≤ a c)
    {K L : ℤ × ℤ} (hK : K ∈ dyadicSizeRoots G root N a) (hL : L ∈ dyadicSizeRoots G root N a)
    (hLK : dyadicGridCell G L.1 L.2 ⊆ dyadicGridCell G K.1 K.2) (hne : L ≠ K) :
    2 * a K < a L := by
  obtain ⟨i, _, hKi⟩ := Finset.mem_biUnion.mp hK
  obtain ⟨j, _, hLj⟩ := Finset.mem_biUnion.mp hL
  have hr := dyadicFiniteTree_root_mem G root N
  have hxL := dyadicGridCell_left_mem G L.1 L.2
  by_cases hij : i < j
  · obtain ⟨K', hK', hLK', _, hd⟩ :=
      dyadicSizeGeneration_ancestor G _ a root hr ha i j hij.le hLj
    have he : K = K' := dyadicSizeGeneration_sameLevel_common_point G _ a root i
      hKi hK' (hLK hxL) (hLK' hxL)
    simpa only [he] using hd hij
  · obtain ⟨L', hL', hKL', _, _⟩ :=
      dyadicSizeGeneration_ancestor G _ a root hr ha j i (by omega) hKi
    have he : L = L' := dyadicSizeGeneration_sameLevel_common_point G _ a root j
      hLj hL' hxL (hKL' (hLK hxL))
    have hKL : dyadicGridCell G K.1 K.2 ⊆ dyadicGridCell G L.1 L.2 := by
      simpa only [he] using hKL'
    exact (hne (dyadicGridCell_injective G (Set.Subset.antisymm hLK hKL))).elim

/-- A finite geometrically separated family of nonnegative sizes has square
sum at most four thirds of the square of any common upper bound. -/
theorem finite_doubling_square_sum_le {ι : Type*} (S : Finset ι) (a : ι → ℝ)
    (ha : ∀ i ∈ S, 0 ≤ a i)
    (hsep : ∀ i ∈ S, ∀ j ∈ S, i ≠ j → 2 * a i ≤ a j ∨ 2 * a j ≤ a i)
    (M : ℝ) (hM0 : 0 ≤ M) (hM : ∀ i ∈ S, a i ≤ M) :
    ∑ i ∈ S, a i ^ 2 ≤ (4 / 3 : ℝ) * M ^ 2 := by
  classical
  induction S using Finset.strongInductionOn generalizing M with
  | _ S ih =>
    by_cases hS : S.Nonempty
    · obtain ⟨j, hj, hmax⟩ := S.exists_max_image a hS
      have hJ : S.erase j ⊂ S := Finset.erase_ssubset hj
      have hhalf : ∀ i ∈ S.erase j, a i ≤ a j / 2 := by
        intro i hi
        obtain ⟨hij, hiS⟩ := Finset.mem_erase.mp hi
        rcases hsep i hiS j hj hij with h | h
        · linarith
        · have himax := hmax i hiS
          have hi0 := ha i hiS
          have hj0 := ha j hj
          linarith
      have hsum := ih (S.erase j) hJ (fun i hi => ha i (Finset.mem_of_mem_erase hi))
        (fun i hi k hk hik => hsep i (Finset.mem_of_mem_erase hi)
          k (Finset.mem_of_mem_erase hk) hik)
        (a j / 2) (div_nonneg (ha j hj) (by norm_num)) hhalf
      have he := Finset.sum_erase_add S (fun i => a i ^ 2) hj
      have hj0 := ha j hj
      have hjM := hM j hj
      have hsq := sq_le_sq₀ hj0 hM0 |>.mpr hjM
      nlinarith
    · have he : S = ∅ := Finset.not_nonempty_iff_eq_empty.mp hS
      simp only [he, Finset.sum_empty]
      positivity

/-- Blueprint `lem:compression`, lines 561–564: the squared stopping sizes
on a path form a geometric series with exact constant four thirds. -/
theorem dyadicSizeRoots_square_path_le (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ dyadicFiniteTree G root N, 0 ≤ a c)
    (x M : ℝ) (hM0 : 0 ≤ M)
    (hM : ∀ c ∈ dyadicFiniteTree G root N, x ∈ dyadicGridCell G c.1 c.2 → a c ≤ M) :
    dyadicRealPathSum G (dyadicSizeRoots G root N a) (fun c => a c ^ 2) x ≤
      (4 / 3 : ℝ) * M ^ 2 := by
  classical
  let S := (dyadicSizeRoots G root N a).filter (fun c => x ∈ dyadicGridCell G c.1 c.2)
  have he : dyadicRealPathSum G (dyadicSizeRoots G root N a) (fun c => a c ^ 2) x =
      ∑ c ∈ S, a c ^ 2 := by
    simp only [dyadicRealPathSum, S, Finset.sum_filter]
  rw [he]
  apply finite_doubling_square_sum_le S a
    (fun c hc => ha c (dyadicSizeRoots_subset G root N a (Finset.mem_filter.mp hc).1)) _ M hM0
    (fun c hc => hM c (dyadicSizeRoots_subset G root N a (Finset.mem_filter.mp hc).1)
      (Finset.mem_filter.mp hc).2)
  intro c hc d hd hne
  obtain ⟨hcR, hxc⟩ := Finset.mem_filter.mp hc
  obtain ⟨hdR, hxd⟩ := Finset.mem_filter.mp hd
  rcases dyadicGridCell_laminar G c d with hdis | hcd | hdc
  · exact (Set.disjoint_left.mp hdis hxc hxd).elim
  · exact Or.inr (dyadicSizeRoots_nested_doubling G root N a ha hdR hcR hcd hne).le
  · exact Or.inl (dyadicSizeRoots_nested_doubling G root N a ha hcR hdR hdc hne.symm).le

/-- Small geometrically separated sizes have total at most twice their
common upper bound, the small-size estimate in `lem:compression`, line 565. -/
theorem finite_doubling_sum_le {ι : Type*} (S : Finset ι) (a : ι → ℝ)
    (ha : ∀ i ∈ S, 0 ≤ a i)
    (hsep : ∀ i ∈ S, ∀ j ∈ S, i ≠ j → 2 * a i ≤ a j ∨ 2 * a j ≤ a i)
    (M : ℝ) (hM0 : 0 ≤ M) (hM : ∀ i ∈ S, a i ≤ M) : ∑ i ∈ S, a i ≤ 2 * M := by
  classical
  induction S using Finset.strongInductionOn generalizing M with
  | _ S ih =>
    by_cases hS : S.Nonempty
    · obtain ⟨j, hj, hmax⟩ := S.exists_max_image a hS
      have hhalf : ∀ i ∈ S.erase j, a i ≤ a j / 2 := by
        intro i hi
        obtain ⟨hij, hiS⟩ := Finset.mem_erase.mp hi
        rcases hsep i hiS j hj hij with h | h
        · linarith
        · have himax := hmax i hiS
          have hi0 := ha i hiS
          have hj0 := ha j hj
          linarith
      have hsum := ih (S.erase j) (Finset.erase_ssubset hj)
        (fun i hi => ha i (Finset.mem_of_mem_erase hi))
        (fun i hi k hk hik => hsep i (Finset.mem_of_mem_erase hi)
          k (Finset.mem_of_mem_erase hk) hik)
        (a j / 2) (div_nonneg (ha j hj) (by norm_num)) hhalf
      have he := Finset.sum_erase_add S a hj
      have hjM := hM j hj
      linarith
    · have he : S = ∅ := Finset.not_nonempty_iff_eq_empty.mp hS
      simp only [he, Finset.sum_empty]
      positivity

/-- A nonempty separated family with positive lower size has exponentially
large top size as a function of its cardinality. -/
theorem finite_doubling_card_power_le {ι : Type*} (S : Finset ι) (a : ι → ℝ)
    (hS : S.Nonempty)
    (hsep : ∀ i ∈ S, ∀ j ∈ S, i ≠ j → 2 * a i ≤ a j ∨ 2 * a j ≤ a i)
    (m M : ℝ) (hm : 0 < m) (hlo : ∀ i ∈ S, m ≤ a i) (hhi : ∀ i ∈ S, a i ≤ M) :
    (2 : ℝ) ^ (S.card - 1) * m ≤ M := by
  classical
  induction S using Finset.strongInductionOn generalizing m M with
  | _ S ih =>
    obtain ⟨j, hj, hmax⟩ := S.exists_max_image a hS
    have hhalf : ∀ i ∈ S.erase j, a i ≤ a j / 2 := by
      intro i hi
      obtain ⟨hij, hiS⟩ := Finset.mem_erase.mp hi
      rcases hsep i hiS j hj hij with h | h
      · linarith
      · have himax := hmax i hiS
        have hi0 := hlo i hiS
        have hj0 := hlo j hj
        linarith
    by_cases hJ : (S.erase j).Nonempty
    · have hp := ih (S.erase j) (Finset.erase_ssubset hj) hJ
        (fun i hi k hk hik => hsep i (Finset.mem_of_mem_erase hi)
          k (Finset.mem_of_mem_erase hk) hik)
        m (a j / 2) hm (fun i hi => hlo i (Finset.mem_of_mem_erase hi)) hhalf
      have hcard := Finset.card_erase_add_one hj
      have hpos := Finset.card_pos.mpr hJ
      have he : S.card - 1 = ((S.erase j).card - 1) + 1 := by omega
      rw [he, pow_succ]
      have hjM := hhi j hj
      nlinarith
    · have he : S.erase j = ∅ := Finset.not_nonempty_iff_eq_empty.mp hJ
      have hcard := Finset.card_erase_add_one hj
      rw [he, Finset.card_empty] at hcard
      have hcardS : S.card = 1 := by omega
      simp only [hcardS, Nat.sub_self, pow_zero, one_mul]
      exact (hlo j hj).trans (hhi j hj)

/-- The number of geometrically separated sizes in `[m,M]` is at most one
plus the base-two logarithm of `M/m`. -/
theorem finite_doubling_card_le_logb {ι : Type*} (S : Finset ι) (a : ι → ℝ)
    (hsep : ∀ i ∈ S, ∀ j ∈ S, i ≠ j → 2 * a i ≤ a j ∨ 2 * a j ≤ a i)
    (m M : ℝ) (hm : 0 < m) (hmM : m ≤ M)
    (hlo : ∀ i ∈ S, m ≤ a i) (hhi : ∀ i ∈ S, a i ≤ M) :
    (S.card : ℝ) ≤ 1 + Real.logb 2 (M / m) := by
  classical
  by_cases hS : S.Nonempty
  · have hp := finite_doubling_card_power_le S a hS hsep m M hm hlo hhi
    have hratio : (2 : ℝ) ^ (S.card - 1) ≤ M / m := (le_div_iff₀ hm).mpr hp
    have hl : ((S.card - 1 : ℕ) : ℝ) ≤ Real.logb 2 (M / m) := by
      apply (Real.le_logb_iff_rpow_le (by norm_num : (1 : ℝ) < 2)
        (div_pos (hm.trans_le hmM) hm)).mpr
      simpa only [Real.rpow_natCast] using hratio
    have hcard : (S.card : ℝ) = ((S.card - 1 : ℕ) : ℝ) + 1 := by
      exact_mod_cast (Nat.sub_add_cancel (Finset.card_pos.mpr hS)).symm
    linarith
  · have he : S = ∅ := Finset.not_nonempty_iff_eq_empty.mp hS
    have hl := Real.logb_nonneg (by norm_num : (1 : ℝ) < 2)
      ((le_div_iff₀ hm).mpr (by simpa only [one_mul] using hmM))
    simp only [he, Finset.card_empty, Nat.cast_zero]
    linarith

theorem finite_doubling_card_le_ceil_logb {ι : Type*} (S : Finset ι) (a : ι → ℝ)
    (hsep : ∀ i ∈ S, ∀ j ∈ S, i ≠ j → 2 * a i ≤ a j ∨ 2 * a j ≤ a i)
    (m M : ℝ) (hm : 0 < m) (hmM : m ≤ M)
    (hlo : ∀ i ∈ S, m ≤ a i) (hhi : ∀ i ∈ S, a i ≤ M) :
    S.card ≤ 1 + Nat.ceil (Real.logb 2 (M / m)) := by
  have h := finite_doubling_card_le_logb S a hsep m M hm hmM hlo hhi
  have hc := Nat.le_ceil (Real.logb 2 (M / m))
  exact_mod_cast (show (S.card : ℝ) ≤ 1 + (Nat.ceil (Real.logb 2 (M / m)) : ℝ) by linarith)

theorem dyadicSizeRoots_path_separation (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ dyadicFiniteTree G root N, 0 ≤ a c)
    {c d : ℤ × ℤ} (hc : c ∈ dyadicSizeRoots G root N a) (hd : d ∈ dyadicSizeRoots G root N a)
    {x : ℝ} (hxc : x ∈ dyadicGridCell G c.1 c.2) (hxd : x ∈ dyadicGridCell G d.1 d.2)
    (hne : c ≠ d) : 2 * a c < a d ∨ 2 * a d < a c := by
  rcases dyadicGridCell_laminar G c d with hdis | hcd | hdc
  · exact (Set.disjoint_left.mp hdis hxc hxd).elim
  · exact Or.inr (dyadicSizeRoots_nested_doubling G root N a ha hd hc hcd hne)
  · exact Or.inl (dyadicSizeRoots_nested_doubling G root N a ha hc hd hdc hne.symm)

open scoped Classical in
noncomputable def dyadicSmallSizeRoots (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) (x T : ℝ) : Finset (ℤ × ℤ) :=
  (dyadicSizeRoots G root N a).filter (fun K => x ∈ dyadicGridCell G K.1 K.2 ∧ a K < T)

open scoped Classical in
noncomputable def dyadicLargeSizeRoots (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) (x T : ℝ) : Finset (ℤ × ℤ) :=
  (dyadicSizeRoots G root N a).filter (fun K => x ∈ dyadicGridCell G K.1 K.2 ∧ T ≤ a K)

theorem dyadicSmallSizeRoots_sum_le (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ dyadicFiniteTree G root N, 0 ≤ a c)
    (x T : ℝ) (hT : 0 ≤ T) :
    ∑ K ∈ dyadicSmallSizeRoots G root N a x T, a K ≤ 2 * T := by
  classical
  apply finite_doubling_sum_le _ a
    (fun K hK => ha K (dyadicSizeRoots_subset G root N a (Finset.mem_filter.mp hK).1)) _ T hT
    (fun K hK => (Finset.mem_filter.mp hK).2.2.le)
  intro c hc d hd hne
  obtain ⟨hcR, hxc, _⟩ := Finset.mem_filter.mp hc
  obtain ⟨hdR, hxd, _⟩ := Finset.mem_filter.mp hd
  exact (dyadicSizeRoots_path_separation G root N a ha hcR hdR hxc hxd hne).imp LT.lt.le LT.lt.le

/-- At most `1 + ceil(log₂ Q)` stopping roots on a path have size at least
`M/Q`, provided all sizes are at most `M`. At `M = 0`, strict separation
leaves at most one root, so no division by the maximum is assumed. -/
theorem dyadicLargeSizeRoots_card_le (G : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ dyadicFiniteTree G root N, 0 ≤ a c)
    (x M Q : ℝ) (hM0 : 0 ≤ M) (hQ : 1 ≤ Q)
    (hM : ∀ c ∈ dyadicFiniteTree G root N, x ∈ dyadicGridCell G c.1 c.2 → a c ≤ M) :
    (dyadicLargeSizeRoots G root N a x (M / Q)).card ≤ 1 + Nat.ceil (Real.logb 2 Q) := by
  classical
  let S := dyadicLargeSizeRoots G root N a x (M / Q)
  have hhi : ∀ c ∈ S, a c ≤ M := fun c hc => hM c
    (dyadicSizeRoots_subset G root N a (Finset.mem_filter.mp hc).1) (Finset.mem_filter.mp hc).2.1
  have hsep : ∀ c ∈ S, ∀ d ∈ S, c ≠ d → 2 * a c < a d ∨ 2 * a d < a c := by
    intro c hc d hd hne
    obtain ⟨hcR, hxc, _⟩ := Finset.mem_filter.mp hc
    obtain ⟨hdR, hxd, _⟩ := Finset.mem_filter.mp hd
    exact dyadicSizeRoots_path_separation G root N a ha hcR hdR hxc hxd hne
  by_cases hMzero : M = 0
  · have hcard : S.card ≤ 1 := by
      apply Finset.card_le_one.mpr
      intro c hc d hd
      by_contra hne
      have hc0 := ha c (dyadicSizeRoots_subset G root N a (Finset.mem_filter.mp hc).1)
      have hd0 := ha d (dyadicSizeRoots_subset G root N a (Finset.mem_filter.mp hd).1)
      have hcM := hhi c hc
      have hdM := hhi d hd
      rcases hsep c hc d hd hne with h | h <;> rw [hMzero] at hcM hdM <;> linarith
    exact hcard.trans (Nat.le_add_right 1 _)
  · have hMpos : 0 < M := lt_of_le_of_ne hM0 (Ne.symm hMzero)
    have hQpos : 0 < Q := lt_of_lt_of_le (by norm_num) hQ
    have hc := finite_doubling_card_le_ceil_logb S a
      (fun c hc d hd hne => (hsep c hc d hd hne).imp LT.lt.le LT.lt.le)
      (M / Q) M (div_pos hMpos hQpos) (div_le_self hM0 hQ)
      (fun c hc => (Finset.mem_filter.mp hc).2.2) hhi
    have he : M / (M / Q) = Q := by field_simp
    rwa [he] at hc

/-- The logarithmic overlap count used for the large stopping sizes. -/
noncomputable def dyadicLogSizeCount (Q : ℝ) : ℕ := 2 + Nat.ceil (Real.logb 2 Q)

theorem finite_sum_le_sqrt_card_sq_sum {ι : Type*} (S : Finset ι) (b : ι → ℝ) :
    ∑ i ∈ S, b i ≤ Real.sqrt (S.card : ℝ) * Real.sqrt (∑ i ∈ S, b i ^ 2) := by
  simpa using Real.sum_mul_le_sqrt_mul_sqrt S (fun _ => (1 : ℝ)) b

/-- The small/large size split bounds any nonnegative supported values with
amplitude at most `G a_K`; only a logarithmic overlap loss remains. -/
theorem dyadic_stopped_values_sum_bound (grid : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ)
    (a b : ℤ × ℤ → ℝ) (ha : ∀ c ∈ dyadicFiniteTree grid root N, 0 ≤ a c)
    (x M G Q : ℝ) (hM0 : 0 ≤ M) (hG : 0 ≤ G) (hQ : 1 ≤ Q)
    (hM : ∀ c ∈ dyadicFiniteTree grid root N, x ∈ dyadicGridCell grid c.1 c.2 → a c ≤ M)
    (hb0 : ∀ c ∈ dyadicSizeRoots grid root N a, x ∉ dyadicGridCell grid c.1 c.2 → b c = 0)
    (hb : ∀ c ∈ dyadicSizeRoots grid root N a, x ∈ dyadicGridCell grid c.1 c.2 → b c ≤ G * a c) :
    (∑ c ∈ dyadicSizeRoots grid root N a, b c) ≤ (2 * G / Q) * M +
      Real.sqrt (dyadicLogSizeCount Q : ℝ) *
        Real.sqrt (∑ c ∈ dyadicSizeRoots grid root N a, b c ^ 2) := by
  classical
  let small := dyadicSmallSizeRoots grid root N a x (M / Q)
  let large := dyadicLargeSizeRoots grid root N a x (M / Q)
  have hsplit : (∑ c ∈ dyadicSizeRoots grid root N a, b c) =
      (∑ c ∈ small, b c) + ∑ c ∈ large, b c := by
    simp only [small, large, dyadicSmallSizeRoots, dyadicLargeSizeRoots, Finset.sum_filter]
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro c hc
    by_cases hxc : x ∈ dyadicGridCell grid c.1 c.2
    · by_cases hlt : a c < M / Q
      · simp [hxc, hlt, not_le.mpr hlt]
      · simp [hxc, hlt, le_of_not_gt hlt]
    · simp [hxc, hb0 c hc hxc]
  have hsmall : (∑ c ∈ small, b c) ≤ (2 * G / Q) * M := by
    calc
      _ ≤ ∑ c ∈ small, G * a c := Finset.sum_le_sum (fun c hc =>
        hb c (Finset.mem_filter.mp hc).1 (Finset.mem_filter.mp hc).2.1)
      _ = G * ∑ c ∈ small, a c := (Finset.mul_sum _ _ _).symm
      _ ≤ G * (2 * (M / Q)) := mul_le_mul_of_nonneg_left
        (dyadicSmallSizeRoots_sum_le grid root N a ha x (M / Q)
          (div_nonneg hM0 (le_trans (by norm_num) hQ))) hG
      _ = _ := by ring
  have hcard : (large.card : ℝ) ≤ (dyadicLogSizeCount Q : ℝ) := by
    have h := dyadicLargeSizeRoots_card_le grid root N a ha x M Q hM0 hQ hM
    have hn : large.card ≤ dyadicLogSizeCount Q := by dsimp [large, dyadicLogSizeCount]; omega
    exact_mod_cast hn
  have hsq : (∑ c ∈ large, b c ^ 2) ≤ ∑ c ∈ dyadicSizeRoots grid root N a, b c ^ 2 :=
    Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _) (fun c _ _ => sq_nonneg (b c))
  have hlarge : (∑ c ∈ large, b c) ≤ Real.sqrt (dyadicLogSizeCount Q : ℝ) *
      Real.sqrt (∑ c ∈ dyadicSizeRoots grid root N a, b c ^ 2) :=
    (finite_sum_le_sqrt_card_sq_sum large b).trans
      (mul_le_mul (Real.sqrt_le_sqrt hcard) (Real.sqrt_le_sqrt hsq)
        (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))
  rw [hsplit]
  exact add_le_add hsmall hlarge

set_option backward.isDefEq.respectTransparency false in
theorem complexLp_norm_sq_integral {α E : Type*} [MeasurableSpace α]
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (μ : Measure α) (z : Lp E 2 μ) : ‖z‖ ^ 2 = ∫ x, ‖z x‖ ^ 2 ∂μ := by
  apply Complex.ofReal_injective
  calc
    _ = inner ℂ z z := by
      simp only [inner_self_eq_norm_sq_to_K, Complex.ofReal_pow]
      rfl
    _ = ∫ x, inner ℂ (z x) (z x) ∂μ := MeasureTheory.L2.inner_def z z
    _ = _ := by
      rw [← integral_complex_ofReal]
      apply integral_congr_ae
      exact ae_of_all _ (fun x => by
        simp only [inner_self_eq_norm_sq_to_K, Complex.ofReal_pow]
        rfl)

theorem realLp_norm_sq_integral {α : Type*} [MeasurableSpace α]
    (μ : Measure α) (z : Lp ℝ 2 μ) : ‖z‖ ^ 2 = ∫ x, z x ^ 2 ∂μ := by
  calc
    _ = inner ℝ z z := (real_inner_self_eq_norm_sq z).symm
    _ = ∫ x, inner ℝ (z x) (z x) ∂μ := MeasureTheory.L2.inner_def z z
    _ = _ := by simp only [real_inner_self_eq_norm_sq, Real.norm_eq_abs, sq_abs]

/-- Transfer a pointwise finite-family bound to its L2 sum. The square
function has squared L2 norm exactly equal to the sum of the individual energies. -/
theorem finite_L2_sum_norm_bound {α E ι : Type*} [MeasurableSpace α]
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (μ : Measure α) (S : Finset ι) (g : ι → Lp E 2 μ)
    (M : α → ℝ) (hM : MemLp M 2 μ) (hM0 : ∀ x, 0 ≤ M x)
    (c L : ℝ) (hc : 0 ≤ c) (hL : 0 ≤ L)
    (hbound : ∀ᵐ x ∂μ, (∑ i ∈ S, ‖g i x‖) ≤ c * M x +
      L * Real.sqrt (∑ i ∈ S, ‖g i x‖ ^ 2)) :
    ‖∑ i ∈ S, g i‖ ≤ c * Real.sqrt (∫ x, M x ^ 2 ∂μ) +
      L * Real.sqrt (∑ i ∈ S, ‖g i‖ ^ 2) := by
  classical
  let H := fun x => Real.sqrt (∑ i ∈ S, ‖g i x‖ ^ 2)
  have hHm : Measurable H :=
    (Finset.measurable_sum S
      (fun i _ => (Lp.stronglyMeasurable (g i)).norm.measurable.pow_const 2)).sqrt
  have hHsq : ∀ x, H x ^ 2 = ∑ i ∈ S, ‖g i x‖ ^ 2 :=
    fun x => Real.sq_sqrt (Finset.sum_nonneg (fun i _ => sq_nonneg ‖g i x‖))
  have hHi : Integrable (fun x => H x ^ 2) μ := by
    simp only [hHsq]
    exact integrable_finsetSum S (fun i _ => (Lp.memLp (g i)).norm.integrable_sq)
  have hH : MemLp H 2 μ := (memLp_two_iff_integrable_sq hHm.aestronglyMeasurable).mpr hHi
  let m := hM.toLp M
  let h := hH.toLp H
  have hMn : ‖m‖ ^ 2 = ∫ x, M x ^ 2 ∂μ := by
    rw [realLp_norm_sq_integral]
    apply integral_congr_ae
    filter_upwards [MemLp.coeFn_toLp hM] with x hx
    rw [hx]
  have hHn : ‖h‖ ^ 2 = ∑ i ∈ S, ‖g i‖ ^ 2 := by
    calc
      _ = ∫ x, h x ^ 2 ∂μ := realLp_norm_sq_integral μ h
      _ = ∫ x, H x ^ 2 ∂μ := by
        apply integral_congr_ae
        filter_upwards [MemLp.coeFn_toLp hH] with x hx
        rw [hx]
      _ = ∫ x, ∑ i ∈ S, ‖g i x‖ ^ 2 ∂μ := by simp only [hHsq]
      _ = ∑ i ∈ S, ∫ x, ‖g i x‖ ^ 2 ∂μ :=
        integral_finsetSum S (fun i _ => (Lp.memLp (g i)).norm.integrable_sq)
      _ = _ := Finset.sum_congr rfl (fun i _ => (complexLp_norm_sq_integral μ (g i)).symm)
  have hmn : ‖m‖ = Real.sqrt (∫ x, M x ^ 2 ∂μ) := by
    rw [← hMn, Real.sqrt_sq (norm_nonneg m)]
  have hhn : ‖h‖ = Real.sqrt (∑ i ∈ S, ‖g i‖ ^ 2) := by
    rw [← hHn, Real.sqrt_sq (norm_nonneg h)]
  have hn : ‖∑ i ∈ S, g i‖ ≤ ‖c • m + L • h‖ := by
    apply Lp.norm_le_norm_of_ae_le
    filter_upwards [hbound, Lp.coeFn_fun_finsetSum S g, Lp.coeFn_add (c • m) (L • h),
      Lp.coeFn_smul c m, Lp.coeFn_smul L h, MemLp.coeFn_toLp hM, MemLp.coeFn_toLp hH]
      with x hb hsum hadd hcm hLh hm hh
    change m x = M x at hm
    change h x = H x at hh
    rw [hsum, hadd]
    simp only [Pi.add_apply, hcm, hLh, Pi.smul_apply, smul_eq_mul, hm, hh]
    rw [Real.norm_of_nonneg (add_nonneg (mul_nonneg hc (hM0 x))
      (mul_nonneg hL (Real.sqrt_nonneg _)))]
    exact (norm_sum_le S (fun i => g i x)).trans hb
  calc
    _ ≤ ‖c • m + L • h‖ := hn
    _ ≤ ‖c • m‖ + ‖L • h‖ := norm_add_le _ _
    _ = _ := by rw [norm_smul, norm_smul, Real.norm_of_nonneg hc, Real.norm_of_nonneg hL, hmn, hhn]

/-- The abstract logarithmic moment-energy inequality from `lem:compression`,
line 565. Support, pointwise amplitude bounds and projection moment identities
are explicit hypotheses; no size of the entire root family appears in the bound. -/
theorem dyadic_stopped_moment_energy {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E]
    (grid : RealDyadicGrid) (root : ℤ × ℤ) (N : ℕ) (a : ℤ × ℤ → ℝ)
    (ha : ∀ c ∈ dyadicFiniteTree grid root N, 0 ≤ a c)
    (z : Lp E 2 (volume : Measure ℝ)) (g : (ℤ × ℤ) → Lp E 2 (volume : Measure ℝ))
    (M : ℝ → ℝ) (hM2 : MemLp M 2 volume) (hM0 : ∀ x, 0 ≤ M x)
    (G Q : ℝ) (hG : 0 ≤ G) (hQ : 1 ≤ Q)
    (hM : ∀ x c, c ∈ dyadicFiniteTree grid root N →
      x ∈ dyadicGridCell grid c.1 c.2 → a c ≤ M x)
    (hzero : ∀ c ∈ dyadicSizeRoots grid root N a, ∀ᵐ x ∂volume,
      x ∉ dyadicGridCell grid c.1 c.2 → g c x = 0)
    (hbound : ∀ c ∈ dyadicSizeRoots grid root N a, ∀ᵐ x ∂volume, ‖g c x‖ ≤ G * a c)
    (henergy : ∀ c ∈ dyadicSizeRoots grid root N a, ‖g c‖ ^ 2 = (inner ℂ z (g c)).re) :
    (∑ c ∈ dyadicSizeRoots grid root N a, ‖g c‖ ^ 2) ≤
      (2 * G / Q) * ‖z‖ * Real.sqrt (∫ x, M x ^ 2) +
      Real.sqrt (dyadicLogSizeCount Q : ℝ) * ‖z‖ *
        Real.sqrt (∑ c ∈ dyadicSizeRoots grid root N a, ‖g c‖ ^ 2) := by
  classical
  let S := dyadicSizeRoots grid root N a
  have hzall : ∀ᵐ x ∂volume, ∀ c : {c // c ∈ S},
      x ∉ dyadicGridCell grid c.val.1 c.val.2 → g c.val x = 0 :=
    ae_all_iff.mpr (fun c => hzero c.val c.property)
  have hball : ∀ᵐ x ∂volume, ∀ c : {c // c ∈ S}, ‖g c.val x‖ ≤ G * a c.val :=
    ae_all_iff.mpr (fun c => hbound c.val c.property)
  have hp : ∀ᵐ x ∂volume, (∑ c ∈ S, ‖g c x‖) ≤ (2 * G / Q) * M x +
      Real.sqrt (dyadicLogSizeCount Q : ℝ) * Real.sqrt (∑ c ∈ S, ‖g c x‖ ^ 2) := by
    filter_upwards [hzall, hball] with x hz hb
    apply dyadic_stopped_values_sum_bound grid root N a (fun c => ‖g c x‖) ha
      x (M x) G Q (hM0 x) hG hQ (hM x)
    · intro c hc hxc
      rw [hz ⟨c, hc⟩ hxc, norm_zero]
    · intro c hc _
      exact hb ⟨c, hc⟩
  have hc : 0 ≤ 2 * G / Q := div_nonneg (mul_nonneg (by norm_num) hG)
    (le_trans (by norm_num) hQ)
  have hn := finite_L2_sum_norm_bound volume S g M hM2 hM0
    (2 * G / Q) (Real.sqrt (dyadicLogSizeCount Q : ℝ)) hc (Real.sqrt_nonneg _) hp
  have he : (∑ c ∈ S, ‖g c‖ ^ 2) = (inner ℂ z (∑ c ∈ S, g c)).re := by
    rw [inner_sum]
    change (∑ c ∈ S, ‖g c‖ ^ 2) = Complex.reCLM (∑ c ∈ S, inner ℂ z (g c))
    rw [map_sum]
    exact Finset.sum_congr rfl (fun c hc => henergy c hc)
  calc
    _ = (inner ℂ z (∑ c ∈ S, g c)).re := he
    _ ≤ ‖z‖ * ‖∑ c ∈ S, g c‖ := (Complex.re_le_norm _).trans (norm_inner_le_norm _ _)
    _ ≤ ‖z‖ * ((2 * G / Q) * Real.sqrt (∫ x, M x ^ 2) +
        Real.sqrt (dyadicLogSizeCount Q : ℝ) * Real.sqrt (∑ c ∈ S, ‖g c‖ ^ 2)) :=
      mul_le_mul_of_nonneg_left hn (norm_nonneg _)
    _ = _ := by ring

open scoped Classical in
/-- First descendants whose coefficient displacement from the preceding
anchor exceeds a fixed tolerance (`lem:compression`, line 567). -/
noncomputable def dyadicNextAnchors {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (K : ℤ × ℤ) : Finset (ℤ × ℤ) :=
  maximalDyadicCells G (S.filter (fun c : ℤ × ℤ =>
    dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G K.1 K.2 ∧ t < ‖f c - f K‖))

theorem dyadicNextAnchors_mem {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (K : ℤ × ℤ) {c : ℤ × ℤ} (hc : c ∈ dyadicNextAnchors G S f t K) :
    c ∈ S ∧ dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G K.1 K.2 ∧ t < ‖f c - f K‖ := by
  classical
  exact Finset.mem_filter.mp (maximalDyadicCells_subset G _ hc)

theorem dyadicNextAnchors_depth_lt {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (ht : 0 ≤ t) (K : ℤ × ℤ) {c : ℤ × ℤ}
    (hc : c ∈ dyadicNextAnchors G S f t K) : K.1 < c.1 := by
  obtain ⟨_, hsub, hjump⟩ := dyadicNextAnchors_mem G S f t K hc
  apply dyadicGridCell_depth_lt_of_subset_ne G c K hsub
  intro he
  subst c
  simp only [sub_self, norm_zero] at hjump
  exact (not_lt_of_ge ht) hjump

theorem dyadicNextAnchors_pairwiseDisjoint {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E) (t : ℝ) (K : ℤ × ℤ) :
    (dyadicNextAnchors G S f t K : Set (ℤ × ℤ)).PairwiseDisjoint
      (fun c => dyadicGridCell G c.1 c.2) :=
  maximalDyadicCells_pairwiseDisjoint G _

/-- Generations count coefficient transitions, independently of spatial depth. -/
noncomputable def dyadicAnchorGeneration {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) : ℕ → Finset (ℤ × ℤ)
  | 0 => {root}
  | n + 1 => (dyadicAnchorGeneration G S f t root n).biUnion (dyadicNextAnchors G S f t)

theorem dyadicAnchorGeneration_subset {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) (hroot : root ∈ S) (n : ℕ) :
    dyadicAnchorGeneration G S f t root n ⊆ S := by
  cases n with
  | zero => simpa only [dyadicAnchorGeneration, Finset.singleton_subset_iff] using hroot
  | succ n =>
    intro c hc
    obtain ⟨K, _, hcK⟩ := Finset.mem_biUnion.mp hc
    exact (dyadicNextAnchors_mem G S f t K hcK).1

theorem dyadicAnchorGeneration_depth {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (ht : 0 ≤ t) (root : ℤ × ℤ) (n : ℕ) {c : ℤ × ℤ}
    (hc : c ∈ dyadicAnchorGeneration G S f t root n) : root.1 + n ≤ c.1 := by
  induction n generalizing c with
  | zero =>
    have he : c = root := by simpa only [dyadicAnchorGeneration, Finset.mem_singleton] using hc
    simp [he]
  | succ n ih =>
    obtain ⟨K, hK, hcK⟩ := Finset.mem_biUnion.mp hc
    have hp := ih hK
    have hlt := dyadicNextAnchors_depth_lt G S f t ht K hcK
    push_cast
    omega

theorem dyadicAnchorGeneration_below {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) (n : ℕ) {c : ℤ × ℤ}
    (hc : c ∈ dyadicAnchorGeneration G S f t root n) :
    dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2 := by
  induction n generalizing c with
  | zero =>
    have he : c = root := by simpa only [dyadicAnchorGeneration, Finset.mem_singleton] using hc
    subst c
    exact Set.Subset.rfl
  | succ n ih =>
    obtain ⟨K, hK, hcK⟩ := Finset.mem_biUnion.mp hc
    exact (dyadicNextAnchors_mem G S f t K hcK).2.1.trans (ih hK)

theorem dyadicAnchorGeneration_pairwiseDisjoint {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) (n : ℕ) :
    (dyadicAnchorGeneration G S f t root n : Set (ℤ × ℤ)).PairwiseDisjoint
      (fun c => dyadicGridCell G c.1 c.2) := by
  induction n with
  | zero => simp [dyadicAnchorGeneration, Set.PairwiseDisjoint]
  | succ n ih =>
    intro c hc d hd hne
    obtain ⟨K, hK, hcK⟩ := Finset.mem_biUnion.mp hc
    obtain ⟨L, hL, hdL⟩ := Finset.mem_biUnion.mp hd
    by_cases he : K = L
    · subst L
      exact dyadicNextAnchors_pairwiseDisjoint G S f t K hcK hdL hne
    · exact (ih hK hL he).mono (dyadicNextAnchors_mem G S f t K hcK).2.1
        (dyadicNextAnchors_mem G S f t L hdL).2.1

open scoped Classical in
/-- Cells assigned to one anchor before its next coefficient crossing. -/
noncomputable def dyadicAnchorSegment {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (K : ℤ × ℤ) : Finset (ℤ × ℤ) :=
  S.filter (fun u : ℤ × ℤ => dyadicGridCell G u.1 u.2 ⊆ dyadicGridCell G K.1 K.2 ∧
    ∀ b ∈ dyadicNextAnchors G S f t K,
      ¬dyadicGridCell G u.1 u.2 ⊆ dyadicGridCell G b.1 b.2)

theorem dyadicAnchorSegment_error_le {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (K : ℤ × ℤ) {u : ℤ × ℤ} (hu : u ∈ dyadicAnchorSegment G S f t K) :
    ‖f u - f K‖ ≤ t := by
  classical
  obtain ⟨huS, huK, hstop⟩ := Finset.mem_filter.mp hu
  apply le_of_not_gt
  intro hbad
  obtain ⟨b, hb, hub⟩ := maximalDyadicCells_covers G
    (S.filter (fun c : ℤ × ℤ => dyadicGridCell G c.1 c.2 ⊆
      dyadicGridCell G K.1 K.2 ∧ t < ‖f c - f K‖))
    (Finset.mem_filter.mpr ⟨huS, huK, hbad⟩)
  exact hstop b hb hub

/-- After any prescribed number of transitions a cell either lies under a
restart root or has a last anchor of smaller generation, with controlled error.
No assumption on spatial depth or on the coefficient space dimension is used. -/
theorem dyadicAnchorGeneration_assignment {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) {u : ℤ × ℤ} (hu : u ∈ S)
    (hur : dyadicGridCell G u.1 u.2 ⊆ dyadicGridCell G root.1 root.2) (T : ℕ) :
    (∃ R ∈ dyadicAnchorGeneration G S f t root T,
      dyadicGridCell G u.1 u.2 ⊆ dyadicGridCell G R.1 R.2) ∨
    ∃ j < T, ∃ K ∈ dyadicAnchorGeneration G S f t root j,
      u ∈ dyadicAnchorSegment G S f t K := by
  classical
  induction T with
  | zero => exact Or.inl ⟨root, Finset.mem_singleton_self _, hur⟩
  | succ T ih =>
    rcases ih with ⟨K, hK, huK⟩ | ⟨j, hj, K, hK, hseg⟩
    · by_cases h : ∃ R ∈ dyadicNextAnchors G S f t K,
          dyadicGridCell G u.1 u.2 ⊆ dyadicGridCell G R.1 R.2
      · obtain ⟨R, hR, huR⟩ := h
        exact Or.inl ⟨R, Finset.mem_biUnion.mpr ⟨K, hK, hR⟩, huR⟩
      · exact Or.inr ⟨T, by omega, K, hK, Finset.mem_filter.mpr
          ⟨hu, huK, fun R hR huR => h ⟨R, hR, huR⟩⟩⟩
    · exact Or.inr ⟨j, by omega, K, hK, hseg⟩

/-- Restarting the same coefficient rule loses no transitions: generations
compose exactly, with the original coefficient function and tolerance. -/
theorem dyadicAnchorGeneration_add {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) (n k : ℕ) :
    dyadicAnchorGeneration G S f t root (n + k) =
      (dyadicAnchorGeneration G S f t root n).biUnion
        (fun K => dyadicAnchorGeneration G S f t K k) := by
  classical
  induction k with
  | zero => simp [dyadicAnchorGeneration]
  | succ k ih =>
    rw [Nat.add_succ, dyadicAnchorGeneration, ih, Finset.biUnion_biUnion]
    rfl

/-- Attempt roots are every `T`th coefficient-anchor generation. -/
noncomputable def dyadicRestartGeneration {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) (T n : ℕ) : Finset (ℤ × ℤ) :=
  dyadicAnchorGeneration G S f t root (n * T)

theorem dyadicRestartGeneration_succ {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) (T n : ℕ) :
    dyadicRestartGeneration G S f t root T (n + 1) =
      (dyadicRestartGeneration G S f t root T n).biUnion
        (fun R => dyadicAnchorGeneration G S f t R T) := by
  simp only [dyadicRestartGeneration, Nat.add_mul, Nat.one_mul, dyadicAnchorGeneration_add]

/-- A finite attempt assigns every non-restarted cell to a spatial
anchor generation below `T`, and the coefficient error is at most `t`. -/
theorem dyadicAnchorGeneration_retained_assignment {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) {u : ℤ × ℤ} (hu : u ∈ S)
    (hur : dyadicGridCell G u.1 u.2 ⊆ dyadicGridCell G root.1 root.2) (T : ℕ)
    (hretain : ∀ R ∈ dyadicAnchorGeneration G S f t root T,
      ¬dyadicGridCell G u.1 u.2 ⊆ dyadicGridCell G R.1 R.2) :
    ∃ j < T, ∃ K ∈ dyadicAnchorGeneration G S f t root j,
      u ∈ dyadicAnchorSegment G S f t K ∧ ‖f u - f K‖ ≤ t := by
  rcases dyadicAnchorGeneration_assignment G S f t root hu hur T with
    ⟨R, hR, huR⟩ | ⟨j, hj, K, hK, hseg⟩
  · exact (hretain R hR huR).elim
  · exact ⟨j, hj, K, hK, hseg, dyadicAnchorSegment_error_le G S f t K hseg⟩

/-- Complete an anchor generation by retaining terminal leaves on branches
with no anchor at that generation (`lem:compression`, line 569). -/
noncomputable def dyadicAnchorCuts {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) (N n : ℕ) : Finset (ℤ × ℤ) :=
  dyadicTerminalCuts G root N (dyadicAnchorGeneration G S f t root n)

theorem dyadicAnchorGeneration_subset_localTree {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) (N : ℕ) (hroot : root ∈ S)
    (hdepth : ∀ c ∈ S, c.1 ≤ root.1 + N) (n : ℕ) :
    dyadicAnchorGeneration G S f t root n ⊆ dyadicFiniteTree G root N := by
  intro c hc
  exact (dyadicFiniteTree_mem_iff G root c N).mpr
    ⟨dyadicAnchorGeneration_below G S f t root n hc,
      hdepth c (dyadicAnchorGeneration_subset G S f t root hroot n hc)⟩

theorem dyadicAnchorCuts_subset {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) (N : ℕ) (hroot : root ∈ S)
    (hdepth : ∀ c ∈ S, c.1 ≤ root.1 + N) (n : ℕ) :
    dyadicAnchorCuts G S f t root N n ⊆ dyadicFiniteTree G root N :=
  dyadicTerminalCuts_subset G root N _
    (dyadicAnchorGeneration_subset_localTree G S f t root N hroot hdepth n)

theorem dyadicAnchorCuts_pairwiseDisjoint {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) (N n : ℕ) :
    (dyadicAnchorCuts G S f t root N n : Set (ℤ × ℤ)).PairwiseDisjoint
      (fun c => dyadicGridCell G c.1 c.2) :=
  dyadicTerminalCuts_pairwiseDisjoint G root N _

theorem dyadicAnchorCuts_union {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) (N : ℕ) (hroot : root ∈ S)
    (hdepth : ∀ c ∈ S, c.1 ≤ root.1 + N) (n : ℕ) :
    (⋃ c ∈ dyadicAnchorCuts G S f t root N n, dyadicGridCell G c.1 c.2) =
      dyadicGridCell G root.1 root.2 :=
  dyadicTerminalCuts_union G root N _
    (dyadicAnchorGeneration_subset_localTree G S f t root N hroot hdepth n)

/-- Every genuine anchor is an atom of the completed stopping partition;
terminal completion does not discard or enlarge its cell. -/
theorem dyadicAnchorCuts_anchor_mem {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) (N : ℕ) (hroot : root ∈ S)
    (hdepth : ∀ c ∈ S, c.1 ≤ root.1 + N) (n : ℕ) {b : ℤ × ℤ}
    (hb : b ∈ dyadicAnchorGeneration G S f t root n) :
    b ∈ dyadicAnchorCuts G S f t root N n := by
  classical
  refine Finset.mem_filter.mpr ⟨Finset.mem_union_left _ hb, ?_⟩
  intro d hd hbd
  by_cases he : b = d
  · subst d
    exact Set.Subset.rfl
  rcases Finset.mem_union.mp hd with hd | hd
  · have hdis := dyadicAnchorGeneration_pairwiseDisjoint G S f t root n hb hd he
    exact (Set.disjoint_left.mp hdis (dyadicGridCell_left_mem G b.1 b.2)
      (hbd (dyadicGridCell_left_mem G b.1 b.2))).elim
  · have hlt := dyadicGridCell_depth_lt_of_subset_ne G b d hbd he
    have hddepth := dyadicGeneration_depth G root N hd
    have hbdepth := hdepth b (dyadicAnchorGeneration_subset G S f t root hroot n hb)
    omega

/-- Completed anchor partitions refine with the transition index, including
the terminal atoms that have already stopped changing. -/
theorem dyadicAnchorCuts_refines {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) (N : ℕ) {n k : ℕ} (hnk : n ≤ k)
    {c : ℤ × ℤ} (hc : c ∈ dyadicAnchorCuts G S f t root N k) :
    ∃ d ∈ dyadicAnchorCuts G S f t root N n,
      dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 := by
  classical
  rcases Finset.mem_union.mp (maximalDyadicCells_subset G _ hc) with ha | hl
  · have he : k = n + (k - n) := (Nat.add_sub_of_le hnk).symm
    rw [he, dyadicAnchorGeneration_add] at ha
    obtain ⟨b, hb, hcb⟩ := Finset.mem_biUnion.mp ha
    obtain ⟨d, hd, hbd⟩ := maximalDyadicCells_covers G
      (dyadicAnchorGeneration G S f t root n ∪ dyadicGeneration G root N)
      (Finset.mem_union_left _ hb)
    exact ⟨d, hd, (dyadicAnchorGeneration_below G S f t b (k - n) hcb).trans hbd⟩
  · exact maximalDyadicCells_covers G
      (dyadicAnchorGeneration G S f t root n ∪ dyadicGeneration G root N)
      (Finset.mem_union_right _ hl)

open scoped Classical in
/-- Refinement of two finite partitions restricts to an exact partition of
each old atom. This supplies the local range-inclusion argument. -/
theorem dyadicPartition_refinement_cover (G : RealDyadicGrid)
    (B C : Finset (ℤ × ℤ)) (R : Set ℝ)
    (hB : (B : Set (ℤ × ℤ)).PairwiseDisjoint (fun c => dyadicGridCell G c.1 c.2))
    (hC : (⋃ c ∈ C, dyadicGridCell G c.1 c.2) = R)
    (href : ∀ c ∈ C, ∃ d ∈ B, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2)
    {b : ℤ × ℤ} (hb : b ∈ B) (hbR : dyadicGridCell G b.1 b.2 ⊆ R) :
    (⋃ c ∈ C.filter (fun c : ℤ × ℤ =>
      dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G b.1 b.2), dyadicGridCell G c.1 c.2) =
      dyadicGridCell G b.1 b.2 := by
  ext x
  simp only [Set.mem_iUnion]
  constructor
  · rintro ⟨c, hc, hxc⟩
    exact (Finset.mem_filter.mp hc).2 hxc
  · intro hxb
    have hxR := hbR hxb
    rw [← hC] at hxR
    obtain ⟨c, hc, hxc⟩ := Set.mem_iUnion₂.mp hxR
    obtain ⟨d, hd, hcd⟩ := href c hc
    have he : d = b := by
      by_contra hne
      exact Set.disjoint_left.mp (hB hd hb hne) (hcd hxc) hxb
    subst d
    exact ⟨c, Finset.mem_filter.mpr ⟨hc, hcd⟩, hxc⟩

/-- A restart root lies under one genuine transition at every earlier
anchor generation (`lem:compression`, lines 569–572). -/
theorem dyadicAnchorGeneration_jump_ancestors {E : Type*} [NormedAddCommGroup E]
    (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (f : ℤ × ℤ → E)
    (t : ℝ) (root : ℤ × ℤ) {T n : ℕ} (hn : n < T) {r : ℤ × ℤ}
    (hr : r ∈ dyadicAnchorGeneration G S f t root T) :
    ∃ K ∈ dyadicAnchorGeneration G S f t root n,
      ∃ c ∈ dyadicNextAnchors G S f t K,
        dyadicGridCell G r.1 r.2 ⊆ dyadicGridCell G c.1 c.2 := by
  have he : T = (n + 1) + (T - (n + 1)) := (Nat.add_sub_of_le (by omega)).symm
  rw [he, dyadicAnchorGeneration_add] at hr
  obtain ⟨c, hc, hrc⟩ := Finset.mem_biUnion.mp hr
  obtain ⟨K, hK, hcK⟩ := Finset.mem_biUnion.mp hc
  exact ⟨K, hK, c, hcK, dyadicAnchorGeneration_below G S f t c _ hrc⟩

/-- A uniform norm lower bound on a finite disjoint dyadic family charges
its total length to the L2 energy of the same function. -/
theorem dyadic_disjoint_mass_le_L2_energy {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] (G : RealDyadicGrid) (C : Finset (ℤ × ℤ))
    (hdis : (C : Set (ℤ × ℤ)).PairwiseDisjoint (fun c => dyadicGridCell G c.1 c.2))
    (z : Lp E 2 (volume : Measure ℝ)) (δ : ℝ) (hδ : 0 ≤ δ)
    (hbound : ∀ᵐ x ∂volume, ∀ c ∈ C, x ∈ dyadicGridCell G c.1 c.2 → δ ≤ ‖z x‖) :
    δ ^ 2 * (∑ c ∈ C, dyadicGridLength G c.1) ≤ ‖z‖ ^ 2 := by
  classical
  have hpath := dyadicPathIntegral_real G C (fun _ => δ ^ 2) Set.univ
    (fun _ _ => Set.subset_univ _)
  simp only [Measure.restrict_univ] at hpath
  have hpoint : ∀ᵐ x ∂volume,
      (∑ c ∈ C, (dyadicGridCell G c.1 c.2).indicator (fun _ => δ ^ 2) x) ≤ ‖z x‖ ^ 2 := by
    filter_upwards [hbound] with x hx
    by_cases hex : ∃ c ∈ C, x ∈ dyadicGridCell G c.1 c.2
    · obtain ⟨c, hc, hxc⟩ := hex
      rw [Finset.sum_eq_single c]
      · rw [Set.indicator_of_mem hxc]
        exact (sq_le_sq₀ hδ (norm_nonneg _)).mpr (hx c hc hxc)
      · intro d hd hdc
        exact Set.indicator_of_notMem
          (fun hxd => Set.disjoint_left.mp (hdis hd hc hdc) hxd hxc) _
      · exact fun h => (h hc).elim
    · have hz : (∑ c ∈ C, (dyadicGridCell G c.1 c.2).indicator (fun _ => δ ^ 2) x) = 0 := by
        apply Finset.sum_eq_zero
        intro c hc
        exact Set.indicator_of_notMem (fun hxc => hex ⟨c, hc, hxc⟩) _
      rw [hz]
      exact sq_nonneg _
  rw [complexLp_norm_sq_integral]
  calc
    _ = ∑ c ∈ C, dyadicGridLength G c.1 * δ ^ 2 := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun _ _ => mul_comm _ _)
    _ = _ := hpath
    _ ≤ _ := integral_mono_of_nonneg
      (ae_of_all _ (fun x => Finset.sum_nonneg (fun c _ =>
        Set.indicator_nonneg (fun _ _ => sq_nonneg δ) x)))
      (Lp.memLp z).norm.integrable_sq hpoint

/-- Integrating every transition lower bound over the same disjoint
restart roots gives the factor `T` in the source restart budget. -/
theorem dyadic_jump_mass_le_energy {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] (G : RealDyadicGrid) (C : Finset (ℤ × ℤ))
    (hdis : (C : Set (ℤ × ℤ)).PairwiseDisjoint (fun c => dyadicGridCell G c.1 c.2))
    (T : ℕ) (u : Fin T → Lp E 2 (volume : Measure ℝ)) (δ : ℝ) (hδ : 0 ≤ δ)
    (hbound : ∀ n, ∀ᵐ x ∂volume, ∀ c ∈ C, x ∈ dyadicGridCell G c.1 c.2 → δ ≤ ‖u n x‖) :
    (T : ℝ) * δ ^ 2 * (∑ c ∈ C, dyadicGridLength G c.1) ≤ ∑ n, ‖u n‖ ^ 2 := by
  calc
    _ = ∑ _n : Fin T, δ ^ 2 * (∑ c ∈ C, dyadicGridLength G c.1) := by
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      ring
    _ ≤ _ := Finset.sum_le_sum (fun n _ =>
      dyadic_disjoint_mass_le_L2_energy G C hdis (u n) δ hδ (hbound n))

/-- The geometric restart argument for arbitrary nonnegative root costs,
so the same proof applies to both length and restricted L2 energy. -/
theorem restart_weight_packing {α : Type*} [DecidableEq α] (root : α)
    (generation : ℕ → Finset α) (children : ℕ → α → Finset α)
    (w : α → ℝ) (hw : ∀ x, 0 ≤ w x) {ρ : ℝ} (hρ : 0 ≤ ρ) (hρ1 : ρ < 1)
    (hzero : generation 0 = {root})
    (hnext : ∀ n, generation (n + 1) ⊆ (generation n).biUnion (children n))
    (hchild : ∀ n c, c ∈ generation n → (∑ d ∈ children n c, w d) ≤ ρ * w c) :
    Summable (fun n => ∑ c ∈ generation n, w c) ∧
      (∑' n, ∑ c ∈ generation n, w c) ≤ w root / (1 - ρ) := by
  have hz : (∑ c ∈ generation 0, w c) ≤ w root := by simp [hzero]
  have hs (n : ℕ) : (∑ c ∈ generation (n + 1), w c) ≤ ρ * ∑ c ∈ generation n, w c := by
    calc
      _ ≤ ∑ c ∈ (generation n).biUnion (children n), w c :=
        Finset.sum_le_sum_of_subset_of_nonneg (hnext n) (fun c _ _ => hw c)
      _ ≤ ∑ c ∈ generation n, ∑ d ∈ children n c, w d :=
        finite_union_weight_le _ _ w hw
      _ ≤ ∑ c ∈ generation n, ρ * w c := Finset.sum_le_sum (fun c hc => hchild n c hc)
      _ = _ := (Finset.mul_sum ..).symm
  exact restart_total_length _ (fun _ => Finset.sum_nonneg (fun c _ => hw c)) hρ hρ1 hz hs


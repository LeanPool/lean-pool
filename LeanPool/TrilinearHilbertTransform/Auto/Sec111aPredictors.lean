/-- The product of two square-integrable functions, one conjugated, is integrable. -/
theorem integrable_conj_mul_of_memLp {f g : ℝ → ℂ} (hf : MemLp f 2) (hg : MemLp g 2) :
    Integrable (fun x => conj (f x) * g x) := by
  have h := L2.integrable_inner (𝕜 := ℂ) (hf.toLp f) (hg.toLp g)
  refine h.congr ?_
  filter_upwards [MemLp.coeFn_toLp hf, MemLp.coeFn_toLp hg] with x h1 h2
  rw [h1, h2]; simp [mul_comm]


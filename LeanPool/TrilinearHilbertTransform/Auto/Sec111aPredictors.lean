/-- The explicit constant of the final polynomial bound of the band bracket. -/
noncomputable def bsKfin (κ : LocalKernelClass) : ℝ :=
  kernelFourierConst κ * (512 * (8 * bsCCT κ + 175 + bsLConst) + 36288) +
    linearScaleConst κ * (24 * (2 * Real.pi) ^ 2 * 32768 * (4 * bsCCT κ + 90)) +
    4 * localKernelSupBound κ * (243 + 16 * (8 * bsCCT κ + 171)) + 1

theorem bandBracket_le (κ : LocalKernelClass) {d : ℕ} (hLh : 0 ≤ Lh) (hdL : (d : ℝ) ≤ Lh) :
    bandBracket κ d D J1 m Lh ≤ bsKfin κ * bsOmega D J1 m Lh ^ 13 := by
  have hΩ := one_le_bsOmega (D := D) (J1 := J1) (m := m) hLh
  have hKF := kernelFourierConst_nonneg κ
  have hlin := linearScaleConst_nonneg κ
  have hC := localKernelSupBound_nonneg κ
  have t1 := bracket_t1_le (D := D) (J1 := J1) (m := m) κ hLh hdL
  have t2 := bracket_t2_le (D := D) (J1 := J1) (m := m) hLh hdL
  have t3 := bracket_t3_le (D := D) (J1 := J1) (m := m) κ hLh hdL
  have t4 := bracket_t4_le (D := D) (J1 := J1) (m := m) κ hLh hdL
  have h013 : 1 ≤ bsOmega D J1 m Lh ^ 13 := one_le_pow₀ hΩ
  unfold bandBracket bsKfin
  calc _ ≤ kernelFourierConst κ * (512 * (8 * bsCCT κ + 175 + bsLConst) *
          bsOmega D J1 m Lh ^ 13 + 36288 * bsOmega D J1 m Lh ^ 13) +
        linearScaleConst κ * (24 * (2 * Real.pi) ^ 2 * 32768 * (4 * bsCCT κ + 90) *
          bsOmega D J1 m Lh ^ 13) +
        4 * localKernelSupBound κ * ((243 + 16 * (8 * bsCCT κ + 171)) *
          bsOmega D J1 m Lh ^ 13) + bsOmega D J1 m Lh ^ 13 := by
        gcongr
    _ = _ := by ring

/-- The `eq:band-scale-sum` bracket is polynomial in `W = 2 + m + log H`. -/
theorem bandBracket_poly (κ : LocalKernelClass) (D J1 : ℕ) : ∃ C : ℕ, ∀ (d m : ℕ) (Lh : ℝ),
    0 ≤ Lh → (d : ℝ) ≤ Lh → bandBracket κ d D J1 m Lh ≤ C * (2 + m + Lh) ^ C := by
  obtain ⟨C, hC⟩ : ∃ C : ℕ, C = ⌈bsKfin κ * ((D + J1 + 1 : ℕ) : ℝ) ^ 13⌉₊ + 13 * (D + J1 + 1) :=
    ⟨_, rfl⟩
  refine ⟨C, fun d m Lh hLh hdL => ?_⟩
  have h := bandBracket_le (D := D) (J1 := J1) (m := m) κ hLh hdL
  have hW : 1 ≤ 2 + (m : ℝ) + Lh := by have := Nat.cast_nonneg (α := ℝ) m; linarith
  refine h.trans ?_
  have h1 : bsKfin κ * ((D + J1 + 1 : ℕ) : ℝ) ^ 13 ≤ (C : ℝ) := by
    have h2 := Nat.le_ceil (bsKfin κ * ((D + J1 + 1 : ℕ) : ℝ) ^ 13)
    have h3 : (C : ℝ) = (⌈bsKfin κ * ((D + J1 + 1 : ℕ) : ℝ) ^ 13⌉₊ : ℝ) +
        ((13 * (D + J1 + 1) : ℕ) : ℝ) := by rw [hC]; push_cast; ring
    have h4 : (0 : ℝ) ≤ ((13 * (D + J1 + 1) : ℕ) : ℝ) := Nat.cast_nonneg _
    linarith
  have h2 : (2 + (m : ℝ) + Lh) ^ ((D + J1 + 1) * 13) ≤ (2 + (m : ℝ) + Lh) ^ C :=
    pow_le_pow_right₀ hW (by rw [hC]; omega)
  have hK0 : 0 ≤ bsKfin κ := by
    unfold bsKfin
    have := kernelFourierConst_nonneg κ; have := linearScaleConst_nonneg κ
    have := localKernelSupBound_nonneg κ; have := bsCCT_nonneg κ; have := bsLConst_nonneg
    positivity
  unfold bsOmega
  calc bsKfin κ * (((D + J1 + 1 : ℕ) : ℝ) * (2 + (m : ℝ) + Lh) ^ (D + J1 + 1)) ^ 13
      = (bsKfin κ * ((D + J1 + 1 : ℕ) : ℝ) ^ 13) * (2 + (m : ℝ) + Lh) ^ ((D + J1 + 1) * 13) := by
        rw [mul_pow, ← pow_mul]; ring
    _ ≤ (C : ℝ) * (2 + (m : ℝ) + Lh) ^ C := mul_le_mul h1 h2 (by positivity) (by positivity)

end BandBudget

/-- Blueprint lem:predictors, `eq:band-scale-sum`: for one separated time factor
`Q = quadraticChartAtom A`, a bounded chart of complexity `H` (fixed Gevrey order `c₀`), and
admissible opponents with transfer constants `K_a, K_b`, the absolute length-weighted sum
over the cells of the `m`-th Fourier-supremum band `e^{-m-1} < A_{|I|} ≤ e^{-m}` is at most
`e^{-m} C (2 + m + log H)^C K_a K_b ‖1_J F_a‖₂ ‖1_J F_b‖₂`, with `C` depending only on the
Gevrey order and the kernel class. -/
theorem band_scale_sum (c₀ : ℕ) (hc : 1 ≤ c₀) (κ : LocalKernelClass) :
    ∃ C : ℕ, ∀ {d : ℕ} (H : ℝ) (A : QuadraticChartData d), 1 ≤ d →
      QuadraticChartComplexity c₀ H A → IsBoundedQuadraticChart A → ∀ (m : ℕ)
      (G : RealDyadicGrid) (J : ℤ × ℤ) (S : Finset (ℤ × ℤ)),
      (∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2) →
      ∀ (w : ℤ × ℤ → ℝ × ℝ → ℂ), (∀ I ∈ S, IsAdmissibleLocalKernel κ
        (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) (w I)) →
      ∀ {a b : Fin 4}, a ≠ b → ∀ {ψa ψb : ℝ → ℂ}, Measurable ψa → Measurable ψb →
      (∀ y, ‖ψa y‖ ≤ 1) → (∀ y, ‖ψb y‖ ≤ 1) →
      ∀ {Fa Fb : ℝ → ℂ} {za zb : ℤ × ℤ → ℝ → ℂ} {Ka Kb : ℝ}, 0 ≤ Ka → 0 ≤ Kb →
      IsAdmissibleOpponent G J Fa za Ka → IsAdmissibleOpponent G J Fb zb Kb →
      HasDepthEnergy G J Fa za Ka → HasDepthEnergy G J Fb zb Kb →
      (∀ I, Measurable (za I)) → (∀ I, Measurable (zb I)) →
      (∀ I, MemLp (za I) 2 (volume.restrict (dyadicGridCell G I.1 I.2))) →
      (∀ I, MemLp (zb I) 2 (volume.restrict (dyadicGridCell G I.1 I.2))) →
      (∀ I ∈ S, InScaleBand (quadraticChartAtom A) m (dyadicGridLength G I.1)) →
      ∑ I ∈ S, dyadicGridLength G I.1 *
        ‖separatedLocalForm (dyadicGridLength G I.1) (w I) (quadraticChartAtom A) a b
          (fun y => ψa y * za I y) (fun y => ψb y * zb I y)‖ ≤
        Real.exp (-(m : ℝ)) * (C * (2 + m + Real.log H) ^ C) *
          Ka * Kb * Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2) *
          Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2) := by
  obtain ⟨D, J1, hD, hpar⟩ := band_scale_sum_param c₀ hc κ
  obtain ⟨C₀, hC₀⟩ := bandBracket_poly κ D J1
  set c₁ : ℝ := 1 + Real.log (bandLip + 2) with hc₁
  have hL0 := bandLip_spec.1
  have hc₁1 : 1 ≤ c₁ := by
    have := Real.log_nonneg (show (1 : ℝ) ≤ bandLip + 2 by linarith); linarith
  obtain ⟨C, hC⟩ : ∃ C : ℕ, C = ⌈(C₀ : ℝ) * c₁ ^ C₀⌉₊ + C₀ := ⟨_, rfl⟩
  refine ⟨C, ?_⟩
  intro d H A hd hA hAb m G J S hSJ w hw a b hab ψa ψb hψam hψbm hψa hψb Fa Fb za zb Ka Kb
    hKa hKb hza hzb hEa hEb hzam hzbm hza2 hzb2 hband
  have h := hpar H A hd hA hAb m G J S hSJ w hw hab hψam hψbm hψa hψb hKa hKb hza hzb hEa hEb
    hzam hzbm hza2 hzb2 hband
  refine h.trans ?_
  have hH1 : 1 ≤ H := by linarith [hA.lower, Real.add_one_le_exp (2 : ℝ)]
  have hlogH0 : 0 ≤ Real.log H := Real.log_nonneg hH1
  set Lh := Real.log (max H (bandLip + 1)) with hLhd
  have hLh0 : 0 ≤ Lh := Real.log_nonneg (hH1.trans (le_max_left _ _))
  have hdL : (d : ℝ) ≤ Lh :=
    hA.dimension.trans (Real.log_le_log (by linarith) (le_max_left _ _))
  have hLh : Lh ≤ Real.log H + Real.log (bandLip + 2) := by
    rw [← Real.log_mul (by linarith) (by linarith)]
    refine Real.log_le_log (by positivity) (max_le ?_ ?_)
    · nlinarith only [hL0, hH1]
    · nlinarith only [hL0, hH1]
  have hbr := hC₀ d m Lh hLh0 hdL
  set W := 2 + (m : ℝ) + Real.log H with hWd
  have hW1 : 1 ≤ W := by have := Nat.cast_nonneg (α := ℝ) m; linarith
  have hWL : 2 + (m : ℝ) + Lh ≤ c₁ * W := by
    rw [hc₁, hWd]
    have hl := Real.log_nonneg (show (1 : ℝ) ≤ bandLip + 2 by linarith)
    nlinarith only [hc₁1, hlogH0, hLh]
  have hpow : (2 + (m : ℝ) + Lh) ^ C₀ ≤ c₁ ^ C₀ * W ^ C₀ := by
    rw [← mul_pow]
    exact pow_le_pow_left₀ (by positivity) hWL C₀
  have hfin : (C₀ : ℝ) * (2 + (m : ℝ) + Lh) ^ C₀ ≤ (C : ℝ) * W ^ C := by
    have h1 : (C₀ : ℝ) * c₁ ^ C₀ ≤ (C : ℝ) := by
      have h2 := Nat.le_ceil ((C₀ : ℝ) * c₁ ^ C₀)
      have h3 : (C : ℝ) = (⌈(C₀ : ℝ) * c₁ ^ C₀⌉₊ : ℝ) + (C₀ : ℝ) := by rw [hC]; push_cast; ring
      have h4 := Nat.cast_nonneg (α := ℝ) C₀
      linarith
    have h5 : W ^ C₀ ≤ W ^ C := pow_le_pow_right₀ hW1 (by rw [hC]; omega)
    calc (C₀ : ℝ) * (2 + (m : ℝ) + Lh) ^ C₀ ≤ (C₀ : ℝ) * (c₁ ^ C₀ * W ^ C₀) :=
          mul_le_mul_of_nonneg_left hpow (Nat.cast_nonneg _)
      _ = ((C₀ : ℝ) * c₁ ^ C₀) * W ^ C₀ := by ring
      _ ≤ (C : ℝ) * W ^ C := mul_le_mul h1 h5 (by positivity) (by positivity)
  have hK : 0 ≤ Ka * Kb * Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2) *
      Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2) := by positivity
  have hem := (Real.exp_pos (-(m : ℝ))).le
  calc Real.exp (-(m : ℝ)) * bandBracket κ d D J1 m Lh * Ka * Kb *
        Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2) *
        Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2)
      = Real.exp (-(m : ℝ)) * bandBracket κ d D J1 m Lh * (Ka * Kb *
        Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2) *
        Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2)) := by ring
    _ ≤ Real.exp (-(m : ℝ)) * ((C : ℝ) * W ^ C) * (Ka * Kb *
        Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2) *
        Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2)) :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hbr.trans hfin) hem) hK
    _ = _ := by ring

/-- Blueprint lem:predictors, proof line 1543 ("distribute each `e(γt)` between the two
remaining slots"): on the progression `t = (y_b - y_a)/(b - a)`. -/
theorem separatedLocalForm_phase_distribute (r : ℝ) (w : ℝ × ℝ → ℂ) (lam γ : ℝ) {a b : Fin 4}
    (hab : a ≠ b) (Fa Fb : ℝ → ℂ) :
    separatedLocalForm r w (quadPhase lam γ) a b Fa Fb =
      separatedLocalForm r w (fun t => (Real.fourierChar (lam * t ^ 2) : ℂ)) a b
        (fun y => (Real.fourierChar (-(γ / ((b : ℝ) - (a : ℝ)) * y)) : ℂ) * Fa y)
        (fun y => (Real.fourierChar (γ / ((b : ℝ) - (a : ℝ)) * y) : ℂ) * Fb y) := by
  have hd := fin_cast_sub_ne hab
  unfold separatedLocalForm
  congr 2; funext z
  have hph : quadPhase lam γ z.2 = (Real.fourierChar (lam * z.2 ^ 2) : ℂ) *
      ((Real.fourierChar (-(γ / ((b : ℝ) - (a : ℝ)) * realProgressionCoordinate a z)) : ℂ) *
        (Real.fourierChar (γ / ((b : ℝ) - (a : ℝ)) * realProgressionCoordinate b z) : ℂ)) := by
    unfold quadPhase
    rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul, ← Circle.coe_mul,
      ← AddChar.map_add_eq_mul]
    congr 2
    simp only [realProgressionCoordinate]
    field_simp
    ring
  rw [hph]; ring

/-- The Fourier-supremum `A_r = sup_ξ |∫ Q(ru) ζ(u) e(-ξu) du|` of a time factor. -/
noncomputable def bandSup (Q : ℝ → ℂ) (r : ℝ) : ℝ := ⨆ ξ, bandAmplitude Q r ξ

theorem bandAmplitude_le_of_bound {Q : ℝ → ℂ} {c : ℝ}
    (hQ : ∀ t, ‖Q t‖ ≤ c) (r ξ : ℝ) : bandAmplitude Q r ξ ≤ 4 * c := by
  have hc : 0 ≤ c := (norm_nonneg _).trans (hQ 0)
  unfold bandAmplitude
  refine (norm_integral_le_integral_norm _).trans ?_
  have h4 := integral_bandCutoff_le_four
  have hb : ∀ u, ‖Q (r * u) * (bandCutoff u : ℂ) * (Real.fourierChar (-(ξ * u)) : ℂ)‖ ≤
      c * bandCutoff u := fun u => by
    rw [norm_mul, norm_mul, Circle.norm_coe, mul_one, Complex.norm_real,
      Real.norm_of_nonneg (bandCutoff_spec.2.1 u)]
    exact mul_le_mul_of_nonneg_right (hQ _) (bandCutoff_spec.2.1 u)
  calc ∫ u, ‖Q (r * u) * (bandCutoff u : ℂ) * (Real.fourierChar (-(ξ * u)) : ℂ)‖
      ≤ ∫ u, c * bandCutoff u :=
        integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => norm_nonneg _)
          (bandCutoff_integrable.const_mul c) (Filter.Eventually.of_forall hb)
    _ = c * ∫ u, bandCutoff u := integral_const_mul _ _
    _ ≤ c * 4 := mul_le_mul_of_nonneg_left h4 hc
    _ = 4 * c := by ring

theorem bandAmplitude_bddAbove {Q : ℝ → ℂ} {c : ℝ} (hQ : ∀ t, ‖Q t‖ ≤ c)
    (r : ℝ) : BddAbove (Set.range (bandAmplitude Q r)) :=
  ⟨4 * c, by rintro _ ⟨ξ, rfl⟩; exact bandAmplitude_le_of_bound hQ r ξ⟩

theorem bandAmplitude_le_bandSup {Q : ℝ → ℂ} {c : ℝ}
    (hQ : ∀ t, ‖Q t‖ ≤ c) (r ξ : ℝ) : bandAmplitude Q r ξ ≤ bandSup Q r :=
  le_ciSup (bandAmplitude_bddAbove hQ r) ξ

theorem bandSup_nonneg (Q : ℝ → ℂ) (r : ℝ) : 0 ≤ bandSup Q r := by
  unfold bandSup
  exact Real.iSup_nonneg fun ξ => norm_nonneg _

theorem bandSup_le {Q : ℝ → ℂ} {c : ℝ} (hQ : ∀ t, ‖Q t‖ ≤ c) (r : ℝ) :
    bandSup Q r ≤ 4 * c := by
  have hc : 0 ≤ c := (norm_nonneg _).trans (hQ 0)
  unfold bandSup
  exact Real.iSup_le (fun ξ => bandAmplitude_le_of_bound hQ r ξ) (by positivity)

/-- A positive band supremum at most one lies in exactly one band `e^{-m-1} < A_r ≤ e^{-m}`. -/
theorem inScaleBand_of_bandSup {Q : ℝ → ℂ} {c : ℝ}
    (hQ : ∀ t, ‖Q t‖ ≤ c) {r : ℝ} (hpos : 0 < bandSup Q r) (hle : bandSup Q r ≤ 1) :
    InScaleBand Q ⌊-Real.log (bandSup Q r)⌋₊ r := by
  have hlog : 0 ≤ -Real.log (bandSup Q r) := by
    have := Real.log_nonpos hpos.le hle; linarith
  have h1 : ((⌊-Real.log (bandSup Q r)⌋₊ : ℕ) : ℝ) ≤ -Real.log (bandSup Q r) :=
    Nat.floor_le hlog
  have h2 : -Real.log (bandSup Q r) < ((⌊-Real.log (bandSup Q r)⌋₊ : ℕ) : ℝ) + 1 :=
    Nat.lt_floor_add_one _
  refine ⟨fun ξ => (bandAmplitude_le_bandSup hQ r ξ).trans ?_, ?_⟩
  · calc bandSup Q r = Real.exp (Real.log (bandSup Q r)) := (Real.exp_log hpos).symm
      _ ≤ _ := Real.exp_le_exp.mpr (by linarith)
  · have hlt : Real.exp (-(((⌊-Real.log (bandSup Q r)⌋₊ : ℕ) : ℝ) + 1)) < bandSup Q r := by
      calc Real.exp (-(((⌊-Real.log (bandSup Q r)⌋₊ : ℕ) : ℝ) + 1))
          < Real.exp (Real.log (bandSup Q r)) := Real.exp_lt_exp.mpr (by linarith)
        _ = bandSup Q r := Real.exp_log hpos
    obtain ⟨ξ, hξ⟩ := exists_lt_of_lt_ciSup hlt
    exact ⟨ξ, hξ⟩

/-- The separated form vanishes at scales whose band supremum vanishes
(blueprint lem:predictors, line 1495: "the term vanishes when `A_{|I|} = 0`"). -/
theorem separatedLocalForm_eq_zero_of_bandSup {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a b : Fin 4} (hab : a ≠ b)
    {Q : ℝ → ℂ} (hQm : Measurable Q) (hQ1 : ∀ t, ‖Q t‖ ≤ 1) (h0 : bandSup Q r = 0)
    {Fa Fb : ℝ → ℂ} (hFam : Measurable Fa) (hFbm : Measurable Fb)
    (hFa : MemLp Fa 2 (volume.restrict (Set.Ico a₀ (a₀ + r))))
    (hFb : MemLp Fb 2 (volume.restrict (Set.Ico a₀ (a₀ + r)))) :
    separatedLocalForm r w Q a b Fa Fb = 0 := by
  have h := separated_form_le_band hr hw hab hQm hQ1 (M := 0)
    (fun ξ => (bandAmplitude_le_bandSup hQ1 r ξ).trans h0.le) hFam hFbm hFa hFb
  simp only [mul_zero, zero_mul] at h
  exact norm_le_zero_iff.mp h

theorem summable_band_series (C : ℕ) :
    Summable (fun m : ℕ => (1 + (m : ℝ)) ^ C * Real.exp (-(m : ℝ) / 2)) := by
  have h1 := Real.summable_pow_mul_exp_neg_nat_mul C (r := 1 / 2) (by norm_num)
  have h0 := Real.summable_pow_mul_exp_neg_nat_mul 0 (r := 1 / 2) (by norm_num)
  refine ((h1.add h0).mul_left (2 ^ C)).of_nonneg_of_le (fun m => by positivity) (fun m => ?_)
  have he : Real.exp (-(m : ℝ) / 2) = Real.exp (-(1 / 2) * m) := by ring_nf
  rw [he]
  have hm : (1 + (m : ℝ)) ^ C ≤ 2 ^ C * ((m : ℝ) ^ C + 1) := by
    rcases Nat.eq_zero_or_pos m with h | h
    · subst h
      simp only [Nat.cast_zero, add_zero, one_pow, zero_pow_eq]
      have : (1 : ℝ) ≤ 2 ^ C := one_le_pow₀ (by norm_num)
      split_ifs <;> nlinarith
    · have hm1 : (1 : ℝ) ≤ m := by exact_mod_cast h
      calc (1 + (m : ℝ)) ^ C ≤ (2 * m) ^ C := pow_le_pow_left₀ (by positivity) (by linarith) C
        _ = 2 ^ C * (m : ℝ) ^ C := mul_pow _ _ _
        _ ≤ 2 ^ C * ((m : ℝ) ^ C + 1) := by nlinarith [pow_pos (show (0 : ℝ) < 2 by norm_num) C]
  have hp : 0 ≤ Real.exp (-(1 / 2) * m) := (Real.exp_pos _).le
  calc (1 + (m : ℝ)) ^ C * Real.exp (-(1 / 2) * m)
      ≤ 2 ^ C * ((m : ℝ) ^ C + 1) * Real.exp (-(1 / 2) * m) := mul_le_mul_of_nonneg_right hm hp
    _ = 2 ^ C * ((m : ℝ) ^ C * Real.exp (-(1 / 2) * m) +
        (m : ℝ) ^ 0 * Real.exp (-(1 / 2) * m)) := by ring

/-- The constant `Σ_m (1 + m)^C e^{-m/2}` for summing band estimates. -/
noncomputable def bandSeriesConst (C : ℕ) : ℝ :=
  ∑' m : ℕ, (1 + (m : ℝ)) ^ C * Real.exp (-(m : ℝ) / 2)

theorem bandSeriesConst_nonneg (C : ℕ) : 0 ≤ bandSeriesConst C :=
  tsum_nonneg fun m => by positivity

theorem band_series_term_le (C m M₀ : ℕ) (hm : M₀ ≤ m) {L : ℝ} (hL : 0 ≤ L) :
    Real.exp (-(m : ℝ)) * (2 + m + L) ^ C ≤
      Real.exp (-(M₀ : ℝ) / 2) * (2 + L) ^ C * ((1 + (m : ℝ)) ^ C * Real.exp (-(m : ℝ) / 2)) := by
  have h1 : (2 + (m : ℝ) + L) ≤ (2 + L) * (1 + m) := by
    have := Nat.cast_nonneg (α := ℝ) m; nlinarith
  have h2 : (2 + (m : ℝ) + L) ^ C ≤ (2 + L) ^ C * (1 + m) ^ C := by
    rw [← mul_pow]; exact pow_le_pow_left₀ (by positivity) h1 C
  have h3 : Real.exp (-(m : ℝ)) ≤ Real.exp (-(M₀ : ℝ) / 2) * Real.exp (-(m : ℝ) / 2) := by
    rw [← Real.exp_add]
    apply Real.exp_le_exp.mpr
    have : (M₀ : ℝ) ≤ m := by exact_mod_cast hm
    linarith
  calc Real.exp (-(m : ℝ)) * (2 + m + L) ^ C
      ≤ (Real.exp (-(M₀ : ℝ) / 2) * Real.exp (-(m : ℝ) / 2)) * ((2 + L) ^ C * (1 + m) ^ C) :=
        mul_le_mul h3 h2 (by positivity) (by positivity)
    _ = _ := by ring

/-- Finite sums of band estimates above a threshold. -/
theorem band_sum_le (C M₀ : ℕ) (Ms : Finset ℕ) (hMs : ∀ m ∈ Ms, M₀ ≤ m) {L : ℝ} (hL : 0 ≤ L) :
    ∑ m ∈ Ms, Real.exp (-(m : ℝ)) * (2 + m + L) ^ C ≤
      Real.exp (-(M₀ : ℝ) / 2) * (2 + L) ^ C * bandSeriesConst C := by
  calc ∑ m ∈ Ms, Real.exp (-(m : ℝ)) * (2 + m + L) ^ C
      ≤ ∑ m ∈ Ms, Real.exp (-(M₀ : ℝ) / 2) * (2 + L) ^ C *
          ((1 + (m : ℝ)) ^ C * Real.exp (-(m : ℝ) / 2)) :=
        Finset.sum_le_sum fun m hm => band_series_term_le C m M₀ (hMs m hm) hL
    _ = Real.exp (-(M₀ : ℝ) / 2) * (2 + L) ^ C *
          ∑ m ∈ Ms, (1 + (m : ℝ)) ^ C * Real.exp (-(m : ℝ) / 2) := by rw [Finset.mul_sum]
    _ ≤ Real.exp (-(M₀ : ℝ) / 2) * (2 + L) ^ C * bandSeriesConst C :=
        mul_le_mul_of_nonneg_left ((summable_band_series C).sum_le_tsum Ms
          (fun m _ => by positivity)) (by positivity)

theorem quarterChart_bounded {d : ℕ} {A : QuadraticChartData d} (hAb : IsBoundedQuadraticChart A) :
    IsBoundedQuadraticChart (scaleQuadraticChartAmplitude (1 / 4 : ℂ) A) := by
  intro y
  rw [scaleQuadraticChartAmplitude_atom, norm_mul]
  have : ‖(1 / 4 : ℂ)‖ = 1 / 4 := by norm_num
  rw [this]
  have := hAb y
  nlinarith

theorem quarterChart_norm_le {d : ℕ} {A : QuadraticChartData d}
    (hAb : IsBoundedQuadraticChart A) (y : ℝ) :
    ‖quadraticChartAtom (scaleQuadraticChartAmplitude (1 / 4 : ℂ) A) y‖ ≤ 1 / 4 := by
  rw [scaleQuadraticChartAmplitude_atom, norm_mul]
  have : ‖(1 / 4 : ℂ)‖ = 1 / 4 := by norm_num
  rw [this]
  have := hAb y
  nlinarith

/-- Blueprint lem:predictors, proof lines 1544-1546: the band scale sums of one separated
time factor summed over all bands `m ≥ M₀` of the normalized factor `Q/4`. -/
theorem chart_band_range_scale_sum (c₀ : ℕ) (hc : 1 ≤ c₀) (κ : LocalKernelClass) :
    ∃ C : ℕ, ∀ {d : ℕ} (H : ℝ) (A : QuadraticChartData d), 1 ≤ d →
      QuadraticChartComplexity c₀ H A → IsBoundedQuadraticChart A → ∀ (M₀ : ℕ)
      (G : RealDyadicGrid) (J : ℤ × ℤ) (S : Finset (ℤ × ℤ)),
      (∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2) →
      ∀ (w : ℤ × ℤ → ℝ × ℝ → ℂ), (∀ I ∈ S, IsAdmissibleLocalKernel κ
        (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) (w I)) →
      ∀ {a b : Fin 4}, a ≠ b → ∀ {ψa ψb : ℝ → ℂ}, Measurable ψa → Measurable ψb →
      (∀ y, ‖ψa y‖ ≤ 1) → (∀ y, ‖ψb y‖ ≤ 1) →
      ∀ {Fa Fb : ℝ → ℂ} {za zb : ℤ × ℤ → ℝ → ℂ} {Ka Kb : ℝ}, 0 ≤ Ka → 0 ≤ Kb →
      IsAdmissibleOpponent G J Fa za Ka → IsAdmissibleOpponent G J Fb zb Kb →
      HasDepthEnergy G J Fa za Ka → HasDepthEnergy G J Fb zb Kb →
      (∀ I, Measurable (za I)) → (∀ I, Measurable (zb I)) →
      (∀ I, MemLp (za I) 2 (volume.restrict (dyadicGridCell G I.1 I.2))) →
      (∀ I, MemLp (zb I) 2 (volume.restrict (dyadicGridCell G I.1 I.2))) →
      (∀ I ∈ S, bandSup (quadraticChartAtom (scaleQuadraticChartAmplitude (1 / 4 : ℂ) A))
        (dyadicGridLength G I.1) ≤ Real.exp (-(M₀ : ℝ))) →
      ∑ I ∈ S, dyadicGridLength G I.1 *
        ‖separatedLocalForm (dyadicGridLength G I.1) (w I) (quadraticChartAtom A) a b
          (fun y => ψa y * za I y) (fun y => ψb y * zb I y)‖ ≤
        Real.exp (-(M₀ : ℝ) / 2) * (C * (2 + Real.log H) ^ C) *
          Ka * Kb * Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2) *
          Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2) := by
  obtain ⟨Cb, hCb⟩ := band_scale_sum c₀ hc κ
  obtain ⟨C, hC⟩ : ∃ C : ℕ, C = ⌈4 * (Cb : ℝ) * bandSeriesConst Cb⌉₊ + Cb := ⟨_, rfl⟩
  refine ⟨C, ?_⟩
  intro d H A hd hA hAb M₀ G J S hSJ w hw a b hab ψa ψb hψam hψbm hψa hψb Fa Fb za zb Ka Kb
    hKa hKb hza hzb hEa hEb hzam hzbm hza2 hzb2 hband
  classical
  set A' := scaleQuadraticChartAmplitude (1 / 4 : ℂ) A with hA'
  have hA'c : QuadraticChartComplexity c₀ H A' :=
    scaleQuadraticChartAmplitude_complexity hA (by norm_num)
  have hA'b := quarterChart_bounded hAb
  have hQm := quadraticChartAtom_measurable A'
  have hQ4 := quarterChart_norm_le hAb
  set Q' := quadraticChartAtom A' with hQ'
  set Na := Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2)
  set Nb := Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2)
  have hK : 0 ≤ Ka * Kb * Na * Nb := by positivity
  have hH1 : 1 ≤ H := by linarith [hA.lower, Real.add_one_le_exp (2 : ℝ)]
  have hL0 : 0 ≤ Real.log H := Real.log_nonneg hH1
  -- band index
  set! band : ℤ × ℤ → ℕ := fun I => ⌊-Real.log (bandSup Q' (dyadicGridLength G I.1))⌋₊
    with hbandd
  set! Sp := S.filter (fun I => 0 < bandSup Q' (dyadicGridLength G I.1)) with hSp
  have hzero : ∀ I ∈ S, ¬ 0 < bandSup Q' (dyadicGridLength G I.1) →
      separatedLocalForm (dyadicGridLength G I.1) (w I) Q' a b
        (fun y => ψa y * za I y) (fun y => ψb y * zb I y) = 0 := by
    intro I hI hIp
    have h0 : bandSup Q' (dyadicGridLength G I.1) = 0 := by
      have := bandSup_nonneg Q' (dyadicGridLength G I.1)
      by_contra hne
      exact hIp (lt_of_le_of_ne this (Ne.symm hne))
    exact separatedLocalForm_eq_zero_of_bandSup (dyadicGridLength_pos G I.1) (hw I hI) hab hQm
      (fun t => (hQ4 t).trans (by norm_num)) h0 (hψam.mul (hzam I)) (hψbm.mul (hzbm I))
      (memLp_mul_bounded_restrict hψam hψa (hza2 I))
      (memLp_mul_bounded_restrict hψbm hψb (hzb2 I))
  have hmain : ∑ I ∈ S, dyadicGridLength G I.1 * ‖separatedLocalForm (dyadicGridLength G I.1)
      (w I) Q' a b (fun y => ψa y * za I y) (fun y => ψb y * zb I y)‖ ≤
      Real.exp (-(M₀ : ℝ) / 2) * (2 + Real.log H) ^ Cb * bandSeriesConst Cb *
        ((Cb : ℝ) * (Ka * Kb * Na * Nb)) := by
    rw [← Finset.sum_filter_add_sum_filter_not S
      (fun I => 0 < bandSup Q' (dyadicGridLength G I.1))]
    rw [Finset.sum_eq_zero (s := S.filter (fun I => ¬ 0 < bandSup Q' (dyadicGridLength G I.1)))
      (fun I hI => by
        rw [hzero I (Finset.mem_filter.mp hI).1 (Finset.mem_filter.mp hI).2, norm_zero,
          mul_zero]), add_zero]
    rw [← hSp, ← Finset.sum_fiberwise_of_maps_to (g := band) (t := Sp.image band)
      (fun I hI => Finset.mem_image_of_mem _ hI)]
    have hfib : ∀ m ∈ Sp.image band, ∑ I ∈ Sp.filter (fun I => band I = m),
        dyadicGridLength G I.1 * ‖separatedLocalForm (dyadicGridLength G I.1) (w I) Q' a b
          (fun y => ψa y * za I y) (fun y => ψb y * zb I y)‖ ≤
        Real.exp (-(m : ℝ)) * (2 + m + Real.log H) ^ Cb * ((Cb : ℝ) * (Ka * Kb * Na * Nb)) := by
      intro m _
      have hS' : ∀ I ∈ Sp.filter (fun I => band I = m), I ∈ S ∧
          0 < bandSup Q' (dyadicGridLength G I.1) ∧ band I = m := fun I hI =>
        ⟨(Finset.mem_filter.mp (Finset.mem_filter.mp hI).1).1,
          (Finset.mem_filter.mp (Finset.mem_filter.mp hI).1).2, (Finset.mem_filter.mp hI).2⟩
      have h := hCb H A' hd hA'c hA'b m G J (Sp.filter (fun I => band I = m))
        (fun I hI => hSJ I (hS' I hI).1) w (fun I hI => hw I (hS' I hI).1) hab hψam hψbm hψa
        hψb hKa hKb hza hzb hEa hEb hzam hzbm hza2 hzb2 (fun I hI => by
          have hb := inScaleBand_of_bandSup (fun t => hQ4 t) (hS' I hI).2.1
            (bandSup_le (fun t => hQ4 t) _ |>.trans (by norm_num))
          have : band I = m := (hS' I hI).2.2
          rw [hbandd] at this
          simp only at this
          rw [this] at hb
          exact hb)
      refine h.trans (le_of_eq ?_)
      ring
    refine (Finset.sum_le_sum hfib).trans ?_
    rw [← Finset.sum_mul]
    have hge : ∀ m ∈ Sp.image band, M₀ ≤ m := by
      intro m hm
      obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hm
      have hIS := (Finset.mem_filter.mp hI).1
      have hpos := (Finset.mem_filter.mp hI).2
      have hb := hband I hIS
      have hlog : (M₀ : ℝ) ≤ -Real.log (bandSup Q' (dyadicGridLength G I.1)) := by
        have := Real.log_le_log hpos hb
        rw [Real.log_exp] at this
        linarith
      exact Nat.le_floor hlog
    have hbs := band_sum_le Cb M₀ (Sp.image band) hge hL0
    have hCK : 0 ≤ (Cb : ℝ) * (Ka * Kb * Na * Nb) := by positivity
    calc (∑ m ∈ Sp.image band, Real.exp (-(m : ℝ)) * (2 + m + Real.log H) ^ Cb) *
          ((Cb : ℝ) * (Ka * Kb * Na * Nb))
        ≤ (Real.exp (-(M₀ : ℝ) / 2) * (2 + Real.log H) ^ Cb * bandSeriesConst Cb) *
          ((Cb : ℝ) * (Ka * Kb * Na * Nb)) := mul_le_mul_of_nonneg_right hbs hCK
      _ = _ := by ring
  -- the factor `4`
  have hQ : ∀ I, separatedLocalForm (dyadicGridLength G I.1) (w I) (quadraticChartAtom A) a b
      (fun y => ψa y * za I y) (fun y => ψb y * zb I y) =
      4 * separatedLocalForm (dyadicGridLength G I.1) (w I) Q' a b
        (fun y => ψa y * za I y) (fun y => ψb y * zb I y) := by
    intro I
    rw [← separatedLocalForm_const_mul]
    congr 1; funext t
    rw [hQ', hA', scaleQuadraticChartAmplitude_atom]; ring
  have hsum4 : ∑ I ∈ S, dyadicGridLength G I.1 * ‖separatedLocalForm (dyadicGridLength G I.1)
      (w I) (quadraticChartAtom A) a b (fun y => ψa y * za I y) (fun y => ψb y * zb I y)‖ =
      4 * ∑ I ∈ S, dyadicGridLength G I.1 * ‖separatedLocalForm (dyadicGridLength G I.1)
      (w I) Q' a b (fun y => ψa y * za I y) (fun y => ψb y * zb I y)‖ := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun I _ => ?_
    rw [hQ I, norm_mul]
    have : ‖(4 : ℂ)‖ = 4 := by norm_num
    rw [this]; ring
  rw [hsum4]
  have hBS := bandSeriesConst_nonneg Cb
  have hC1 : 4 * (Cb : ℝ) * bandSeriesConst Cb ≤ (C : ℝ) := by
    have h2 := Nat.le_ceil (4 * (Cb : ℝ) * bandSeriesConst Cb)
    have h3 : (C : ℝ) = (⌈4 * (Cb : ℝ) * bandSeriesConst Cb⌉₊ : ℝ) + (Cb : ℝ) := by
      rw [hC]; push_cast; ring
    have h4 := Nat.cast_nonneg (α := ℝ) Cb
    linarith only [h2, h3]
  have hW : 1 ≤ 2 + Real.log H := by linarith
  have hpow : (2 + Real.log H) ^ Cb ≤ (2 + Real.log H) ^ C :=
    pow_le_pow_right₀ hW (by rw [hC]; omega)
  have hem := (Real.exp_pos (-(M₀ : ℝ) / 2)).le
  calc 4 * ∑ I ∈ S, dyadicGridLength G I.1 * ‖separatedLocalForm (dyadicGridLength G I.1)
        (w I) Q' a b (fun y => ψa y * za I y) (fun y => ψb y * zb I y)‖
      ≤ 4 * (Real.exp (-(M₀ : ℝ) / 2) * (2 + Real.log H) ^ Cb * bandSeriesConst Cb *
        ((Cb : ℝ) * (Ka * Kb * Na * Nb))) := mul_le_mul_of_nonneg_left hmain (by norm_num)
    _ = Real.exp (-(M₀ : ℝ) / 2) * ((4 * (Cb : ℝ) * bandSeriesConst Cb) * (2 + Real.log H) ^ Cb) *
        (Ka * Kb * Na * Nb) := by ring
    _ ≤ Real.exp (-(M₀ : ℝ) / 2) * ((C : ℝ) * (2 + Real.log H) ^ C) * (Ka * Kb * Na * Nb) := by
        gcongr
    _ = _ := by ring

/-- The tail multiplicity growth constant at coefficient budget `E`. -/
noncomputable def tailAlpha (d : ℕ) (E : ℝ) : ℝ :=
  24 * (2 * Real.pi) ^ 2 * (4 * (32 * (((d + 1 : ℕ) + 1 : ℝ) + 1) ^ 4 *
    (Real.log 24 + 2 * Real.log E + 2 + Real.log 4)))

/-- The quadratic total at coefficient budget `E`. -/
noncomputable def tailLam (d : ℕ) (E : ℝ) : ℝ :=
  2 * Real.pi * (128 * ((d * d + 1 : ℕ) + 1 : ℝ) ^ 4 * Real.log (2 * (E + 2)) * E)

/-- The catalog tail constant at coefficient budget `E`. -/
noncomputable def tailCT (κ : LocalKernelClass) (d : ℕ) (E : ℝ) : ℝ :=
  linearScaleConst κ * tailAlpha d E + localKernelSupBound κ * tailLam d E

theorem tailCT_nonneg (κ : LocalKernelClass) (d : ℕ) {E : ℝ} (hE : 1 ≤ E) :
    0 ≤ tailCT κ d E := by
  have hlin := linearScaleConst_nonneg κ
  have hC := localKernelSupBound_nonneg κ
  have h24 : 0 ≤ Real.log 24 := Real.log_nonneg (by norm_num)
  have h4 : 0 ≤ Real.log 4 := Real.log_nonneg (by norm_num)
  have hlE : 0 ≤ Real.log E := Real.log_nonneg hE
  have hl : 0 ≤ Real.log (2 * (E + 2)) := Real.log_nonneg (by linarith)
  unfold tailCT tailAlpha tailLam
  positivity

theorem clumpMultiplicity_tail_le' (d : ℕ) {E u : ℝ} (hE : 1 ≤ E) (hu : 1 ≤ u) :
    clumpMultiplicity (d + 1) (6 * (E * u) ^ 2 + 6) ≤ tailAlpha d E * u := by
  have hlE0 : 0 ≤ Real.log E := Real.log_nonneg hE
  have hEu : 1 ≤ E * u := by nlinarith
  have harg : 2 * (6 * (E * u) ^ 2 + 6) ≤ 24 * (E * u) ^ 2 := by nlinarith
  have hlog : Real.log (2 * (6 * (E * u) ^ 2 + 6)) ≤ (Real.log 24 + 2 * Real.log E + 2) * u := by
    have h1 : Real.log (2 * (6 * (E * u) ^ 2 + 6)) ≤ Real.log (24 * (E * u) ^ 2) :=
      Real.log_le_log (by positivity) harg
    have h2 : Real.log (24 * (E * u) ^ 2) = Real.log 24 + 2 * Real.log E + 2 * Real.log u := by
      rw [Real.log_mul (by norm_num) (by positivity), Real.log_pow, Real.log_mul
        (by positivity) (by positivity)]
      push_cast; ring
    have h3 : Real.log u ≤ u := (Real.log_le_sub_one_of_pos (by linarith)).trans (by linarith)
    have h24 : 0 ≤ Real.log 24 := Real.log_nonneg (by norm_num)
    rw [h2] at h1
    nlinarith
  have h4 : 0 ≤ Real.log 4 := Real.log_nonneg (by norm_num)
  unfold clumpMultiplicity heightBandConst tailAlpha
  have hcast : (((d + 1 + 1 : ℕ) : ℝ) + 1) = (((d + 1 : ℕ) : ℝ) + 1) + 1 := by push_cast; ring
  rw [hcast]
  have hc0 : 0 ≤ 24 * (2 * Real.pi) ^ 2 * (4 * (32 * ((((d + 1 : ℕ) : ℝ) + 1) + 1) ^ 4)) := by
    positivity
  have key : Real.log (2 * (6 * (E * u) ^ 2 + 6)) + Real.log 4 ≤
      (Real.log 24 + 2 * Real.log E + 2 + Real.log 4) * u := by nlinarith only [hu, hlog, h4]
  calc 24 * (2 * Real.pi) ^ 2 * (4 * (32 * ((((d + 1 : ℕ) : ℝ) + 1) + 1) ^ 4 *
        (Real.log (2 * (6 * (E * u) ^ 2 + 6)) + Real.log 4)))
      = 24 * (2 * Real.pi) ^ 2 * (4 * (32 * ((((d + 1 : ℕ) : ℝ) + 1) + 1) ^ 4)) *
        (Real.log (2 * (6 * (E * u) ^ 2 + 6)) + Real.log 4) := by ring
    _ ≤ 24 * (2 * Real.pi) ^ 2 * (4 * (32 * ((((d + 1 : ℕ) : ℝ) + 1) + 1) ^ 4)) *
        ((Real.log 24 + 2 * Real.log E + 2 + Real.log 4) * u) :=
        mul_le_mul_of_nonneg_left key hc0
    _ = _ := by ring

/-- Blueprint lem:predictors, proof lines 1519-1523: the pooled chart-expansion tails
outside a finite catalog are small in the absolute scale-sum norm. -/
theorem expansion_catalog_tail (κ : LocalKernelClass) {d : ℕ} (hd : 1 ≤ d)
    (A : QuadraticChartData d) {E E1 : ℝ} (hE : 1 ≤ E) (hE10 : 0 ≤ E1) (K₀ : ℕ)
    (G : RealDyadicGrid) (J : ℤ × ℤ) (S : Finset (ℤ × ℤ))
    (hSJ : ∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2)
    (w : ℤ × ℤ → ℝ × ℝ → ℂ)
    (hw : ∀ I ∈ S, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1) (w I))
    {a b : Fin 4} (hab : a ≠ b) {ψa ψb : ℝ → ℂ} (hψam : Measurable ψa) (hψbm : Measurable ψb)
    (hψa : ∀ y, ‖ψa y‖ ≤ 1) (hψb : ∀ y, ‖ψb y‖ ≤ 1)
    {Fa Fb : ℝ → ℂ} {za zb : ℤ × ℤ → ℝ → ℂ} {Ka Kb : ℝ} (hKa : 0 ≤ Ka) (hKb : 0 ≤ Kb)
    (hza : IsAdmissibleOpponent G J Fa za Ka) (hzb : IsAdmissibleOpponent G J Fb zb Kb)
    (hEa : HasDepthEnergy G J Fa za Ka) (hEb : HasDepthEnergy G J Fb zb Kb)
    (hzam : ∀ I, Measurable (za I)) (hzbm : ∀ I, Measurable (zb I))
    (hza2 : ∀ I, MemLp (za I) 2 (volume.restrict (dyadicGridCell G I.1 I.2)))
    (hzb2 : ∀ I, MemLp (zb I) 2 (volume.restrict (dyadicGridCell G I.1 I.2)))
    (lamf : ℤ → ℝ) (Mf : ℤ → Matrix (Fin d) (Fin d) ℚ)
    (σf : ℤ → ℕ × (Fin (d + d) → ℤ) → Fin d → ℚ) (coeff : ℤ → ℕ × (Fin (d + d) → ℤ) → ℂ)
    (hprops : ∀ s ∈ S.image Prod.fst,
      (∀ i j, (rationalHeight (Mf s i j) : ℝ) ≤ E) ∧
      lamf s = A.quadratic + ∑ i, ∑ j, A.horizontal i * (Mf s i j : ℝ) * A.horizontal j ∧
      |lamf s| * dyadicGridLength G s ^ 2 ≤ E ∧
      (∀ p i, (rationalHeight (σf s p i) : ℝ) ≤ E * (1 + frequencyLength p.2)) ∧
      (∀ p, ⌊E⌋₊ ≤ p.1 → coeff s p = 0) ∧
      ∀ p, ‖coeff s p‖ * (1 + frequencyLength p.2) ^ ((d + 1) ^ 2) ≤ E1) :
    ∑ I ∈ S, dyadicGridLength G I.1 * ∑' p, (if p ∈ (Finset.range ⌊E⌋₊) ×ˢ
      (frequencyTruncationSet (d + d) K₀) then 0 else ‖coeff I.1 p‖ *
        ‖separatedLocalForm (dyadicGridLength G I.1) (w I)
          (quadPhase (lamf I.1) (A.linear + ∑ i, (σf I.1 p i : ℝ) * A.horizontal i)) a b
          (fun y => ψa y * za I y) (fun y => ψb y * zb I y)‖) ≤
      (⌊E⌋₊ : ℝ) * (E1 * tailCT κ d E *
        (2 * 7 ^ (d + d) * (2 * Real.pi) ^ ((d + 1) ^ 2 - 1) / 2 ^ K₀)) *
        Ka * Kb * Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2) *
        Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2) := by
  classical
  set T := S.image Prod.fst with hT
  set N₀ := ⌊E⌋₊ with hN₀
  set P : Finset (ℕ × (Fin (d + d) → ℤ)) :=
    (Finset.range N₀) ×ˢ (frequencyTruncationSet (d + d) K₀) with hP
  set Na := Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2)
  set Nb := Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2)
  have hK : 0 ≤ Ka * Kb * Na * Nb := by positivity
  have hC := localKernelSupBound_nonneg κ
  have hlin := linearScaleConst_nonneg κ
  set! freq : ℤ → ℕ × (Fin (d + d) → ℤ) → ℝ :=
    fun s p => A.linear + ∑ i, (σf s p i : ℝ) * A.horizontal i with hfreq
  obtain ⟨Hf, hHf⟩ : ∃ Hf : ℤ × ℤ → (ℝ → ℂ) → ℂ, Hf = fun I φ =>
      separatedLocalForm (dyadicGridLength G I.1) (w I) φ a b
        (fun y => ψa y * za I y) (fun y => ψb y * zb I y) := ⟨_, rfl⟩
  have eHf : ∀ I φ, separatedLocalForm (dyadicGridLength G I.1) (w I) φ a b
      (fun y => ψa y * za I y) (fun y => ψb y * zb I y) = Hf I φ := fun I φ => by rw [hHf]
  simp only [eHf]
  -- the envelope
  set! env : ℕ × (Fin (d + d) → ℤ) → ℝ := fun p => if p.1 < N₀ then
    E1 * ((1 + frequencyLength p.2) ^ ((d + 1) ^ 2))⁻¹ else 0 with henvd
  have henv0 : ∀ p, 0 ≤ env p := fun p => by
    simp only [henvd]; split_ifs
    · have := frequencyLength_nonneg p.2; positivity
    · exact le_rfl
  have henv : ∀ s ∈ T, ∀ p, ‖coeff s p‖ ≤ env p := by
    intro s hs p
    have hpos : 0 < (1 + frequencyLength p.2) ^ ((d + 1) ^ 2) := by
      have := frequencyLength_nonneg p.2; positivity
    simp only [henvd]
    split_ifs with hp
    · rw [← div_eq_mul_inv, le_div_iff₀ hpos]
      exact (hprops s hs).2.2.2.2.2 p
    · rw [(hprops s hs).2.2.2.2.1 p (not_lt.mp hp), norm_zero]
  -- uniform bound of single forms
  have hphase : ∀ I ∈ S, ∀ φ : ℝ → ℂ, (∀ t, ‖φ t‖ ≤ 1) →
      dyadicGridLength G I.1 * ‖Hf I φ‖ ≤ localKernelSupBound κ *
        (Real.sqrt (∫ y in dyadicGridCell G I.1 I.2, ‖za I y‖ ^ 2) *
          Real.sqrt (∫ y in dyadicGridCell G I.1 I.2, ‖zb I y‖ ^ 2)) := by
    intro I hIS φ hφ
    have hr := dyadicGridLength_pos G I.1
    have hFam : Measurable (fun y => ψa y * za I y) := hψam.mul (hzam I)
    have hFbm : Measurable (fun y => ψb y * zb I y) := hψbm.mul (hzbm I)
    have h := separatedLocalForm_sup_le hr (hw I hIS) hab zero_le_one (fun t _ => hφ t)
      hFam hFbm (memLp_mul_bounded_restrict hψam hψa (hza2 I))
      (memLp_mul_bounded_restrict hψbm hψb (hzb2 I))
    rw [eHf] at h
    have hnorm := cell_normalized_product (X := ∫ y in Set.Ico (dyadicGridLeft G I.1 I.2)
        (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1), ‖ψa y * za I y‖ ^ 2)
      (Y := ∫ y in Set.Ico (dyadicGridLeft G I.1 I.2)
        (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1), ‖ψb y * zb I y‖ ^ 2) hr
    have hXa := setIntegral_mul_bounded_le hψa (hza2 I)
    have hXb := setIntegral_mul_bounded_le hψb (hzb2 I)
    calc dyadicGridLength G I.1 * ‖Hf I φ‖
        ≤ dyadicGridLength G I.1 * (localKernelSupBound κ * 1 *
            Real.sqrt ((dyadicGridLength G I.1)⁻¹ * ∫ y in Set.Ico (dyadicGridLeft G I.1 I.2)
              (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1), ‖ψa y * za I y‖ ^ 2) *
            Real.sqrt ((dyadicGridLength G I.1)⁻¹ * ∫ y in Set.Ico (dyadicGridLeft G I.1 I.2)
              (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1), ‖ψb y * zb I y‖ ^ 2)) :=
          mul_le_mul_of_nonneg_left h hr.le
      _ = localKernelSupBound κ * (dyadicGridLength G I.1 *
            (Real.sqrt ((dyadicGridLength G I.1)⁻¹ * ∫ y in Set.Ico (dyadicGridLeft G I.1 I.2)
              (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1), ‖ψa y * za I y‖ ^ 2) *
            Real.sqrt ((dyadicGridLength G I.1)⁻¹ * ∫ y in Set.Ico (dyadicGridLeft G I.1 I.2)
              (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1), ‖ψb y * zb I y‖ ^ 2))) := by
          ring
      _ ≤ _ := by
          rw [hnorm]
          exact mul_le_mul_of_nonneg_left (mul_le_mul (Real.sqrt_le_sqrt hXa)
            (Real.sqrt_le_sqrt hXb) (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)) hC
  -- per-cell domination by the envelope
  have hgs : ∀ I ∈ S, Summable (fun p => if p ∈ P then 0 else
      env p * (dyadicGridLength G I.1 * ‖Hf I (quadPhase (lamf I.1) (freq I.1 p))‖)) := by
    intro I hI
    have hens0 := (catalog_weighted_tail (N₀ := N₀) (K₀ := K₀) hd hE10 (le_refl 0)
      (fun _ => (0 : ℝ)) (fun _ => le_rfl) (fun p => by simp)).1
    have hens : Summable env := hens0
    have hr := dyadicGridLength_pos G I.1
    have hXY : 0 ≤ localKernelSupBound κ *
        (Real.sqrt (∫ y in dyadicGridCell G I.1 I.2, ‖za I y‖ ^ 2) *
          Real.sqrt (∫ y in dyadicGridCell G I.1 I.2, ‖zb I y‖ ^ 2)) := by positivity
    refine Summable.of_nonneg_of_le (fun p => by
        split_ifs
        · exact le_rfl
        · exact mul_nonneg (henv0 p) (mul_nonneg hr.le (norm_nonneg _)))
      (fun p => ?_) (hens.mul_right (localKernelSupBound κ *
        (Real.sqrt (∫ y in dyadicGridCell G I.1 I.2, ‖za I y‖ ^ 2) *
          Real.sqrt (∫ y in dyadicGridCell G I.1 I.2, ‖zb I y‖ ^ 2))))
    by_cases hp : p ∈ P
    · rw [ite_eq_left hp]; exact mul_nonneg (henv0 p) hXY
    · rw [ite_eq_right hp]
      exact mul_le_mul_of_nonneg_left (hphase I hI (quadPhase (lamf I.1) (freq I.1 p))
        fun t => (norm_quadPhase _ _ t).le) (henv0 p)
  have hcell : ∀ I ∈ S, dyadicGridLength G I.1 * ∑' p, (if p ∈ P then 0 else
      ‖coeff I.1 p‖ * ‖Hf I (quadPhase (lamf I.1) (freq I.1 p))‖) ≤
      ∑' p, (if p ∈ P then 0 else
        env p * (dyadicGridLength G I.1 * ‖Hf I (quadPhase (lamf I.1) (freq I.1 p))‖)) := by
    intro I hI
    rw [← tsum_mul_left]
    have hs1 : Summable (fun p => dyadicGridLength G I.1 * (if p ∈ P then 0 else
        ‖coeff I.1 p‖ * ‖Hf I (quadPhase (lamf I.1) (freq I.1 p))‖)) := by
      refine Summable.of_nonneg_of_le (fun p => by
          split_ifs
          · exact mul_nonneg (dyadicGridLength_pos G I.1).le le_rfl
          · exact mul_nonneg (dyadicGridLength_pos G I.1).le
              (mul_nonneg (norm_nonneg _) (norm_nonneg _))) (fun p => ?_) (hgs I hI)
      split_ifs
      · simp
      · calc dyadicGridLength G I.1 * (‖coeff I.1 p‖ *
              ‖Hf I (quadPhase (lamf I.1) (freq I.1 p))‖)
            = ‖coeff I.1 p‖ * (dyadicGridLength G I.1 *
              ‖Hf I (quadPhase (lamf I.1) (freq I.1 p))‖) := by ring
          _ ≤ _ := mul_le_mul_of_nonneg_right (henv I.1 (Finset.mem_image_of_mem _ hI) p)
              (by have := dyadicGridLength_pos G I.1; positivity)
    refine Summable.tsum_le_tsum (fun p => ?_) hs1 (hgs I hI)
    split_ifs
    · simp
    · calc dyadicGridLength G I.1 * (‖coeff I.1 p‖ *
            ‖Hf I (quadPhase (lamf I.1) (freq I.1 p))‖)
          = ‖coeff I.1 p‖ * (dyadicGridLength G I.1 *
            ‖Hf I (quadPhase (lamf I.1) (freq I.1 p))‖) := by ring
        _ ≤ _ := mul_le_mul_of_nonneg_right (henv I.1 (Finset.mem_image_of_mem _ hI) p)
            (by have := dyadicGridLength_pos G I.1; positivity)
  -- rational centers and the quadratic total
  set! k : ℤ := ((b : ℕ) : ℤ) - ((a : ℕ) : ℤ) with hkd
  have hkR : (k : ℝ) = (b : ℝ) - (a : ℝ) := by rw [hkd]; push_cast; rfl
  have hk0 : k ≠ 0 := by
    rw [hkd]; intro h; apply hab; apply Fin.ext; omega
  have hk3 : |(k : ℝ)| ≤ 3 := by
    rw [hkR]
    have ha := abs_fin_four_le a
    have hb := abs_fin_four_le b
    rw [abs_le] at ha hb ⊢
    constructor <;> linarith [ha.1, ha.2, hb.1, hb.2,
      show (0 : ℝ) ≤ (a : ℝ) by positivity, show (0 : ℝ) ≤ (b : ℝ) by positivity]
  have hB₁2 : 2 ≤ E + 2 := by linarith
  set! Λ := tailLam d E with hΛd
  have hΛ : ∑ s ∈ T, 2 * Real.pi * |lamf s| * dyadicGridLength G s ^ 2 ≤ Λ := by
    have h := band_quadratic_total G A.horizontal A.quadratic T lamf Mf (by linarith) hB₁2
      (fun s hs => (hprops s hs).2.1)
      (fun s hs i j => ((hprops s hs).1 i j).trans (by linarith))
      (fun s hs => (hprops s hs).2.2.1)
    refine h.trans (le_of_eq ?_)
    rw [hΛd, tailLam]
  have hΛ0 : 0 ≤ Λ := by
    rw [hΛd, tailLam]
    have := Real.log_nonneg (show (1 : ℝ) ≤ 2 * (E + 2) by linarith)
    positivity
  set! Mt : ℕ × (Fin (d + d) → ℤ) → ℝ := fun p =>
    clumpMultiplicity (d + 1) (6 * (E * (1 + frequencyLength p.2)) ^ 2 + 6) with hMtd
  have hMt : ∀ p ξ, ∑ x ∈ S.image (fun I => (I.1, freq I.1 p / ((b : ℝ) - (a : ℝ)))),
      bumpMultiplier (dyadicGridLength G x.1 * (ξ - x.2)) ≤ Mt p := by
    intro p ξ
    have hB : 2 ≤ 6 * (E * (1 + frequencyLength p.2)) ^ 2 + 6 := by
      have : 0 ≤ 6 * (E * (1 + frequencyLength p.2)) ^ 2 := by positivity
      linarith
    refine rational_center_multiplicity G (Fin.cons A.linear A.horizontal) hB _
      (fun x hx => ?_) (fun x hx y hy hxy hne => ?_) ξ
    · obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hx
      have hs : I.1 ∈ T := Finset.mem_image_of_mem _ hI
      obtain ⟨h1, h2⟩ := center_rational A.linear A.horizontal (σf I.1 p) hk0 hk3
        ((hprops I.1 hs).2.2.2.1 p)
      refine ⟨_, h1, ?_⟩
      simp only
      rw [← hkR]; exact h2
    · exfalso
      obtain ⟨I, _, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨I', _, rfl⟩ := Finset.mem_image.mp hy
      simp only at hxy
      apply hne
      simp only [hxy]
  have hCT0 := tailCT_nonneg κ d hE
  have hg : ∀ p : ℕ × (Fin (d + d) → ℤ), linearScaleConst κ * Mt p +
      localKernelSupBound κ * Λ ≤ tailCT κ d E * (1 + frequencyLength p.2) := by
    intro p
    have hu : 1 ≤ 1 + frequencyLength p.2 := by have := frequencyLength_nonneg p.2; linarith
    have h1 := clumpMultiplicity_tail_le' d hE hu
    have e1 : linearScaleConst κ * Mt p ≤
        linearScaleConst κ * tailAlpha d E * (1 + frequencyLength p.2) := by
      rw [mul_assoc]; exact mul_le_mul_of_nonneg_left h1 hlin
    have e2 : localKernelSupBound κ * Λ ≤
        localKernelSupBound κ * Λ * (1 + frequencyLength p.2) :=
      le_mul_of_one_le_right (mul_nonneg hC hΛ0) hu
    calc linearScaleConst κ * Mt p + localKernelSupBound κ * Λ
        ≤ linearScaleConst κ * tailAlpha d E * (1 + frequencyLength p.2) +
          localKernelSupBound κ * Λ * (1 + frequencyLength p.2) := add_le_add e1 e2
      _ = tailCT κ d E * (1 + frequencyLength p.2) := by rw [tailCT, hΛd]; ring
  have hg0 : ∀ p, 0 ≤ linearScaleConst κ * Mt p + localKernelSupBound κ * Λ := by
    intro p
    have hM0 : 0 ≤ Mt p := by
      simp only [hMtd, clumpMultiplicity]
      have : 2 ≤ 6 * (E * (1 + frequencyLength p.2)) ^ 2 + 6 := by
        have : 0 ≤ 6 * (E * (1 + frequencyLength p.2)) ^ 2 := by positivity
        linarith
      have := heightBandConst_nonneg (d + 1) this
      positivity
    positivity
  obtain ⟨_, hTs, hTt⟩ := catalog_weighted_tail hd (N₀ := N₀) (K₀ := K₀) hE10 hCT0
    (fun p => linearScaleConst κ * Mt p + localKernelSupBound κ * Λ) hg0 hg
  -- assemble
  refine (Finset.sum_le_sum hcell).trans ?_
  rw [← Summable.tsum_finsetSum hgs]
  have hpt : ∀ p, ∑ I ∈ S, (if p ∈ P then 0 else
      env p * (dyadicGridLength G I.1 * ‖Hf I (quadPhase (lamf I.1) (freq I.1 p))‖)) ≤
      (if p ∈ P then 0 else env p * (linearScaleConst κ * Mt p + localKernelSupBound κ * Λ)) *
        (Ka * Kb * Na * Nb) := by
    intro p
    by_cases hp : p ∈ P
    · simp [hp]
    simp only [hp, ite_false]
    rw [← Finset.mul_sum]
    have hsp := single_phase_scale_sum G κ J S hSJ w hw hab lamf (fun s => freq s p)
      hψam hψbm hψa hψb hKa hKb hza hzb hEa hEb hzam hzbm hza2 hzb2 (M := Mt p)
      (fun ξ => hMt p ξ) (Λ := Λ) hΛ
    simp only [eHf] at hsp
    calc env p * ∑ I ∈ S, dyadicGridLength G I.1 * ‖Hf I (quadPhase (lamf I.1) (freq I.1 p))‖
        ≤ env p * ((linearScaleConst κ * Mt p + localKernelSupBound κ * Λ) * Ka * Kb *
          Na * Nb) := mul_le_mul_of_nonneg_left hsp (henv0 p)
      _ = _ := by ring
  refine (Summable.tsum_le_tsum hpt (summable_sum fun I hI => hgs I hI) (hTs.mul_right _)).trans ?_
  rw [tsum_mul_right]
  calc (∑' p, (if p ∈ P then 0 else
        env p * (linearScaleConst κ * Mt p + localKernelSupBound κ * Λ))) * (Ka * Kb * Na * Nb)
      ≤ ((N₀ : ℝ) * (E1 * tailCT κ d E *
        (2 * 7 ^ (d + d) * (2 * Real.pi) ^ ((d + 1) ^ 2 - 1) / 2 ^ K₀))) * (Ka * Kb * Na * Nb) :=
        mul_le_mul_of_nonneg_right hTt hK
    _ = _ := by ring

/-- Layer-cake form of the separation shell bound: the size-weighted coefficient mass beyond
`T₀` is at most `4 E / T₀^{99}` (blueprint lem:predictors, line 1546). -/
theorem weighted_shell_tail {τ : Type*} [Countable τ] (cf : τ → ℂ) (size : τ → ℝ)
    {Es : ℝ} (hEs : 0 ≤ Es)
    (htail : ∀ T : ℝ, 1 ≤ T → (∑' q, if T ≤ size q then ‖cf q‖ else 0) ≤ Es / T ^ 100)
    (hcs : Summable (fun q => ‖cf q‖)) {T₀ : ℝ} (hT₀ : 1 ≤ T₀) :
    Summable (fun q => if T₀ < size q then ‖cf q‖ * size q else 0) ∧
      (∑' q, if T₀ < size q then ‖cf q‖ * size q else 0) ≤ 4 * Es / T₀ ^ 99 := by
  classical
  have hT0 : 0 < T₀ := by linarith
  set g : ℕ × τ → ℝ := fun x => if (2 : ℝ) ^ x.1 * T₀ ≤ size x.2 then
    ‖cf x.2‖ * ((2 : ℝ) ^ (x.1 + 1) * T₀) else 0 with hg
  have hg0 : ∀ x, 0 ≤ g x := fun x => by simp only [hg]; split_ifs <;> positivity
  -- the inner sums over `τ`
  have hinner : ∀ j : ℕ, Summable (fun q => g (j, q)) ∧
      (∑' q, g (j, q)) ≤ 2 * Es / T₀ ^ 99 * ((1 / 2 : ℝ) ^ 99) ^ j := by
    intro j
    have hT : 1 ≤ (2 : ℝ) ^ j * T₀ := one_le_mul_of_one_le_of_one_le (one_le_pow₀ (by norm_num)) hT₀
    have hs : Summable (fun q => if (2 : ℝ) ^ j * T₀ ≤ size q then ‖cf q‖ else 0) :=
      hcs.of_nonneg_of_le (fun q => by split_ifs <;> positivity) (fun q => by
        split_ifs
        · exact le_rfl
        · exact norm_nonneg _)
    have he : (fun q => g (j, q)) = fun q =>
        (if (2 : ℝ) ^ j * T₀ ≤ size q then ‖cf q‖ else 0) * ((2 : ℝ) ^ (j + 1) * T₀) := by
      funext q; simp only [hg]; split_ifs <;> simp
    rw [he]
    refine ⟨hs.mul_right _, ?_⟩
    rw [tsum_mul_right]
    have h := htail _ hT
    calc (∑' q, if (2 : ℝ) ^ j * T₀ ≤ size q then ‖cf q‖ else 0) * ((2 : ℝ) ^ (j + 1) * T₀)
        ≤ Es / ((2 : ℝ) ^ j * T₀) ^ 100 * ((2 : ℝ) ^ (j + 1) * T₀) :=
          mul_le_mul_of_nonneg_right h (by positivity)
      _ = 2 * Es / T₀ ^ 99 * ((1 / 2 : ℝ) ^ 99) ^ j := by
          have hu : (0 : ℝ) < 2 ^ j := by positivity
          have e1 : ((1 / 2 : ℝ) ^ 99) ^ j = (((2 : ℝ) ^ j)⁻¹) ^ 99 := by
            rw [← pow_mul, mul_comm, pow_mul, one_div, inv_pow]
          rw [e1, pow_succ]
          set u := (2 : ℝ) ^ j
          field_simp
          ring
  have hgeo : Summable (fun j : ℕ => 2 * Es / T₀ ^ 99 * ((1 / 2 : ℝ) ^ 99) ^ j) :=
    (summable_geometric_of_lt_one (by positivity) (by norm_num)).mul_left _
  have hgsum : Summable g := by
    rw [summable_prod_of_nonneg hg0]
    exact ⟨fun j => (hinner j).1, hgeo.of_nonneg_of_le (fun j => tsum_nonneg fun q => hg0 _)
      (fun j => (hinner j).2)⟩
  -- the pointwise layer-cake bound
  have hpt : ∀ q, (if T₀ < size q then ‖cf q‖ * size q else 0) ≤ ∑' j : ℕ, g (j, q) := by
    intro q
    split_ifs with hq
    · have hx : 1 ≤ size q / T₀ := by rw [le_div_iff₀ hT0]; linarith
      obtain ⟨J, hJ1, hJ2⟩ := exists_nat_pow_near hx (by norm_num : (1 : ℝ) < 2)
      have hsJ : Summable (fun j : ℕ => g (j, q)) := hgsum.prod_symm.prod_factor q
      have hle := hsJ.le_tsum J (fun j _ => hg0 _)
      refine le_trans ?_ hle
      simp only [hg]
      rw [ite_eq_left (by rw [← le_div_iff₀ hT0]; exact hJ1)]
      have : size q ≤ (2 : ℝ) ^ (J + 1) * T₀ := by
        have := (div_lt_iff₀ hT0).mp hJ2; linarith
      exact mul_le_mul_of_nonneg_left this (norm_nonneg _)
    · exact tsum_nonneg fun j => hg0 _
  have hu : Summable (Function.uncurry (fun (j : ℕ) (q : τ) => g (j, q))) := hgsum
  have hcomm : ∑' q, ∑' j : ℕ, g (j, q) = ∑' j : ℕ, ∑' q, g (j, q) :=
    hu.tsum_comm' (fun j => (hinner j).1) (fun q => hgsum.prod_symm.prod_factor q)
  have hlhs : Summable (fun q => if T₀ < size q then ‖cf q‖ * size q else 0) :=
    hgsum.prod_symm.prod.of_nonneg_of_le (fun q => by
      split_ifs with h
      · exact mul_nonneg (norm_nonneg _) (by linarith)
      · exact le_rfl) hpt
  refine ⟨hlhs, ?_⟩
  calc (∑' q, if T₀ < size q then ‖cf q‖ * size q else 0)
      ≤ ∑' q, ∑' j : ℕ, g (j, q) := hlhs.tsum_le_tsum hpt hgsum.prod_symm.prod
    _ = ∑' j : ℕ, ∑' q, g (j, q) := hcomm
    _ ≤ ∑' j : ℕ, 2 * Es / T₀ ^ 99 * ((1 / 2 : ℝ) ^ 99) ^ j :=
        (hgsum.prod).tsum_le_tsum (fun j => (hinner j).2) hgeo
    _ = 2 * Es / T₀ ^ 99 * (1 - (1 / 2 : ℝ) ^ 99)⁻¹ := by
        rw [tsum_mul_left, tsum_geometric_of_lt_one (by positivity) (by norm_num)]
    _ ≤ 4 * Es / T₀ ^ 99 := by
        have h1 : (1 - (1 / 2 : ℝ) ^ 99)⁻¹ ≤ 2 := by
          rw [inv_le_comm₀ (by norm_num) (by norm_num)]; norm_num
        have h2 : 0 ≤ 2 * Es / T₀ ^ 99 := by positivity
        calc 2 * Es / T₀ ^ 99 * (1 - (1 / 2 : ℝ) ^ 99)⁻¹ ≤ 2 * Es / T₀ ^ 99 * 2 :=
              mul_le_mul_of_nonneg_left h1 h2
          _ = 4 * Es / T₀ ^ 99 := by ring

/-- Polynomials in `log s` are dominated by `s`: `(a₀ + 6 log s)^C ≤ a₀^C (1 + 6C)^C s`. -/
theorem log_weight_le {a₀ s : ℝ} (ha₀ : 1 ≤ a₀) (hs : 1 ≤ s) (C : ℕ) :
    (a₀ + 6 * Real.log s) ^ C ≤ a₀ ^ C * (1 + 6 * C) ^ C * s := by
  rcases Nat.eq_zero_or_pos C with hC | hC
  · subst hC; simp; linarith
  have hC' : (0 : ℝ) < C := by exact_mod_cast hC
  have hs0 : 0 < s := by linarith
  have hlog0 : 0 ≤ Real.log s := Real.log_nonneg hs
  have h1 : Real.log s ≤ s ^ (1 / (C : ℝ)) / (1 / (C : ℝ)) :=
    Real.log_le_rpow_div hs0.le (by positivity)
  have hsr : 1 ≤ s ^ (1 / (C : ℝ)) := Real.one_le_rpow hs (by positivity)
  have h2 : Real.log s ≤ C * s ^ (1 / (C : ℝ)) := by
    rw [div_div_eq_mul_div, div_one] at h1; linarith
  have h3 : a₀ + 6 * Real.log s ≤ a₀ * (1 + 6 * C) * s ^ (1 / (C : ℝ)) := by
    have : a₀ + 6 * Real.log s ≤ a₀ * (1 + 6 * Real.log s) := by nlinarith
    refine this.trans ?_
    have h4 : 1 + 6 * Real.log s ≤ (1 + 6 * C) * s ^ (1 / (C : ℝ)) := by nlinarith
    calc a₀ * (1 + 6 * Real.log s) ≤ a₀ * ((1 + 6 * C) * s ^ (1 / (C : ℝ))) :=
          mul_le_mul_of_nonneg_left h4 (by linarith)
      _ = _ := by ring
  have h5 : (a₀ + 6 * Real.log s) ^ C ≤ (a₀ * (1 + 6 * C) * s ^ (1 / (C : ℝ))) ^ C :=
    pow_le_pow_left₀ (by positivity) h3 C
  refine h5.trans (le_of_eq ?_)
  rw [mul_pow, mul_pow, ← Real.rpow_natCast (s ^ (1 / (C : ℝ))), ← Real.rpow_mul hs0.le,
    one_div_mul_cancel hC'.ne', Real.rpow_one]

/-- The norm of a tail sum over the complement of a finite set. -/
theorem norm_tsum_compl_le {π : Type*} [DecidableEq π] (P : Finset π) (f : π → ℂ)
    (hf : Summable (fun p => ‖f p‖)) :
    ‖∑' p : ↥((P : Set π)ᶜ), f p‖ ≤ ∑' p, (if p ∈ P then 0 else ‖f p‖) := by
  have hs2 : Summable (fun p : ↥((P : Set π)ᶜ) => ‖f p‖) := hf.subtype _
  refine (norm_tsum_le_tsum_norm hs2).trans (le_of_eq ?_)
  rw [tsum_subtype ((P : Set π)ᶜ) (fun p => ‖f p‖)]
  congr 1; funext p
  by_cases hp : p ∈ P
  · simp [hp]
  · simp [hp]

/-- Blueprint lem:predictors, proof lines 1544-1547, at one cell: the replacement of the
atom-pair form by the retained catalog terms leaves the discarded shells, the discarded
bands and the catalog tails. -/
theorem predictor_cell_bound {τ π : Type*} [Countable τ] [Countable π] [DecidableEq τ]
    [DecidableEq π] (cf : τ → ℂ) (hcs : Summable (fun q => ‖cf q‖)) (sepQ : τ → ℂ) {M : ℝ}
    (hsepQ : ∀ q, ‖sepQ q‖ ≤ M) {LF : ℂ} (hLF : HasSum (fun q => cf q * sepQ q) LF)
    (R : Finset τ) (ret : τ → Prop) [DecidablePred ret] (P : Finset π) (coeff : τ → π → ℂ)
    (sepP : τ → π → ℂ) (hcoeff : ∀ q, Summable (fun p => ‖coeff q p‖)) {M' : ℝ}
    (hsepP : ∀ q p, ‖sepP q p‖ ≤ M')
    (hexp : ∀ q ∈ R, ret q → HasSum (fun p => coeff q p * sepP q p) (sepQ q / 4)) :
    ‖LF - ∑ q ∈ R, (if ret q then 4 * cf q * ∑ p ∈ P, coeff q p * sepP q p else 0)‖ ≤
      (∑' q, if q ∈ R then 0 else ‖cf q‖ * ‖sepQ q‖) +
      ∑ q ∈ R, (if ret q then 0 else ‖cf q‖ * ‖sepQ q‖) +
      ∑ q ∈ R, (if ret q then 4 * ‖cf q‖ *
        ∑' p, (if p ∈ P then 0 else ‖coeff q p‖ * ‖sepP q p‖) else 0) := by
  classical
  have hs : Summable (fun q => cf q * sepQ q) := hLF.summable
  have hsplit := hs.sum_add_tsum_compl (s := R)
  rw [hLF.tsum_eq] at hsplit
  have hfn : Summable (fun q => ‖cf q * sepQ q‖) := by
    refine Summable.of_nonneg_of_le (fun q => norm_nonneg _) (fun q => ?_) (hcs.mul_right M)
    rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hsepQ q) (norm_nonneg _)
  -- the retained catalog identity
  have hq : ∀ q ∈ R, cf q * sepQ q -
      (if ret q then 4 * cf q * ∑ p ∈ P, coeff q p * sepP q p else 0) =
      if ret q then 4 * cf q * ∑' p : ↥((P : Set π)ᶜ), coeff q p * sepP q p
      else cf q * sepQ q := by
    intro q hqR
    split_ifs with hr
    · have he := hexp q hqR hr
      have hs' : Summable (fun p => coeff q p * sepP q p) := he.summable
      have h2 := hs'.sum_add_tsum_compl (s := P)
      rw [he.tsum_eq] at h2
      have : sepQ q = 4 * (sepQ q / 4) := by ring
      rw [this, ← h2]; ring
    · ring
  have hdiff : LF - ∑ q ∈ R, (if ret q then 4 * cf q * ∑ p ∈ P, coeff q p * sepP q p else 0) =
      (∑' q : ↥((R : Set τ)ᶜ), cf q * sepQ q) + ∑ q ∈ R,
        (if ret q then 4 * cf q * ∑' p : ↥((P : Set π)ᶜ), coeff q p * sepP q p
          else cf q * sepQ q) := by
    rw [← hsplit, ← Finset.sum_congr rfl hq, Finset.sum_sub_distrib]; ring
  rw [hdiff]
  refine (norm_add_le _ _).trans ?_
  have h1 : ‖∑' q : ↥((R : Set τ)ᶜ), cf q * sepQ q‖ ≤
      ∑' q, if q ∈ R then 0 else ‖cf q‖ * ‖sepQ q‖ := by
    refine (norm_tsum_compl_le R _ hfn).trans (le_of_eq ?_)
    congr 1; funext q; split_ifs <;> simp
  have h2 : ‖∑ q ∈ R, (if ret q then 4 * cf q * ∑' p : ↥((P : Set π)ᶜ), coeff q p * sepP q p
      else cf q * sepQ q)‖ ≤ ∑ q ∈ R, (if ret q then 0 else ‖cf q‖ * ‖sepQ q‖) +
      ∑ q ∈ R, (if ret q then 4 * ‖cf q‖ *
        ∑' p, (if p ∈ P then 0 else ‖coeff q p‖ * ‖sepP q p‖) else 0) := by
    rw [← Finset.sum_add_distrib]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun q _ => ?_)
    split_ifs with hr
    · rw [zero_add, norm_mul, norm_mul]
      have : ‖(4 : ℂ)‖ = 4 := by norm_num
      rw [this]
      have hsp : Summable (fun p => ‖coeff q p * sepP q p‖) := by
        refine Summable.of_nonneg_of_le (fun p => norm_nonneg _) (fun p => ?_)
          ((hcoeff q).mul_right M')
        rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hsepP q p) (norm_nonneg _)
      have := norm_tsum_compl_le P _ hsp
      refine mul_le_mul_of_nonneg_left (this.trans (le_of_eq ?_)) (by positivity)
      congr 1; funext p; split_ifs <;> simp
    · rw [add_zero, norm_mul]
  linarith

/-- Regrouping the retained catalog terms of all retained separation terms into the finite
predictor list `(q, M, σ)` with scale-dependent coefficients. -/
theorem predictor_grouping {τ π μ ν : Type*} [DecidableEq μ] [DecidableEq ν]
    (R : Finset τ) (Mset : Finset μ) (σset : Finset ν) (P : Finset π) (ret : τ → Prop)
    [DecidablePred ret] (Mq : τ → μ) (σq : τ → π → ν) (cf : τ → ℂ) (coeff : τ → π → ℂ)
    (X : τ → μ → ν → ℂ) (sepP : τ → π → ℂ)
    (hM : ∀ q ∈ R, ret q → Mq q ∈ Mset) (hσ : ∀ q ∈ R, ret q → ∀ p ∈ P, σq q p ∈ σset)
    (hX : ∀ q ∈ R, ret q → ∀ p ∈ P, X q (Mq q) (σq q p) = sepP q p) :
    ∑ ℓ ∈ R ×ˢ (Mset ×ˢ σset), (if ret ℓ.1 ∧ Mq ℓ.1 = ℓ.2.1 then
      4 * cf ℓ.1 * ∑ p ∈ P.filter (fun p => σq ℓ.1 p = ℓ.2.2), coeff ℓ.1 p else 0) *
        X ℓ.1 ℓ.2.1 ℓ.2.2 =
      ∑ q ∈ R, (if ret q then 4 * cf q * ∑ p ∈ P, coeff q p * sepP q p else 0) := by
  classical
  rw [Finset.sum_product]
  refine Finset.sum_congr rfl fun q hq => ?_
  rw [Finset.sum_product]
  by_cases hr : ret q
  · simp only [hr, true_and, ite_true]
    -- only `M = Mq q` contributes
    have h1 : ∑ M ∈ Mset, ∑ σ ∈ σset, (if Mq q = M then 4 * cf q *
        ∑ p ∈ P.filter (fun p => σq q p = σ), coeff q p else 0) * X q M σ =
        ∑ σ ∈ σset, (4 * cf q * ∑ p ∈ P.filter (fun p => σq q p = σ), coeff q p) *
          X q (Mq q) σ := by
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun σ _ => ?_
      rw [Finset.sum_eq_single (Mq q)]
      · simp
      · intro M _ hne; simp [Ne.symm hne]
      · intro h; exact absurd (hM q hq hr) h
    rw [h1]
    have h2 : ∑ σ ∈ σset, (4 * cf q * ∑ p ∈ P.filter (fun p => σq q p = σ), coeff q p) *
        X q (Mq q) σ = 4 * cf q * ∑ σ ∈ σset, ∑ p ∈ P.filter (fun p => σq q p = σ),
          coeff q p * X q (Mq q) (σq q p) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun σ _ => ?_
      rw [mul_assoc, Finset.sum_mul]
      congr 1
      refine Finset.sum_congr rfl fun p hp => ?_
      rw [(Finset.mem_filter.mp hp).2]
    rw [h2, Finset.sum_fiberwise_of_maps_to (g := fun p => σq q p) (fun p hp => hσ q hq hr p hp)]
    congr 1
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [hX q hq hr p hp]
  · simp [hr]

theorem eLpNorm_normalized_ne_top {a r : ℝ} {g : ℝ → ℂ}
    (hg : MemLp g 2 (volume.restrict (Set.Ico a (a + r)))) :
    eLpNorm g 2 (normalizedIntervalMeasure a r) ≠ ⊤ := by
  have hres : volume.restrict (Set.Ico a (a + r)) = volume.restrict (Set.Icc a (a + r)) :=
    Measure.restrict_congr_set Ico_ae_eq_Icc
  rw [hres] at hg
  have h := hg.smul_measure (c := ENNReal.ofReal r⁻¹) ENNReal.ofReal_ne_top
  exact h.eLpNorm_ne_top

theorem eLpNorm_normalized_le_toReal {a r : ℝ} {g : ℝ → ℂ}
    (hg : MemLp g 2 (volume.restrict (Set.Ico a (a + r)))) :
    eLpNorm g 2 (normalizedIntervalMeasure a r) ≤
      ENNReal.ofReal (eLpNorm g 2 (normalizedIntervalMeasure a r)).toReal := by
  rw [ENNReal.ofReal_toReal (eLpNorm_normalized_ne_top hg)]

/-! Explicit parameters of the predictor list (blueprint lem:predictors, lines 1495-1503 and
proof lines 1544-1547). -/

noncomputable def pdX (H : ℝ) : ℝ := 1 + Real.log H

noncomputable def pdEs (Ds : ℕ) (H : ℝ) : ℝ := Real.exp (Ds * pdX H ^ Ds)

noncomputable def pdA0 (Ds : ℕ) (H : ℝ) : ℝ := 2 + 6 * (Ds * pdX H ^ Ds)

noncomputable def pdT0 (Ds Cr : ℕ) (H B : ℝ) : ℝ :=
  12 * Cr * pdA0 Ds H ^ Cr * (1 + 6 * Cr) ^ Cr * pdEs Ds H * Real.exp B + 1

noncomputable def pdH0 (Ds Cr : ℕ) (H B : ℝ) : ℝ :=
  max ((pdEs Ds H * pdT0 Ds Cr H B) ^ 6) (bandLip + 1)

noncomputable def pdM0 (Ds Cr : ℕ) (H B : ℝ) : ℕ :=
  ⌈2 * (B + Real.log (3 * pdEs Ds H * Cr * (2 + Real.log (pdH0 Ds Cr H B)) ^ Cr + 1))⌉₊

noncomputable def pdLE (Ds Cr : ℕ) (H B : ℝ) : ℝ :=
  2 + Real.log (pdH0 Ds Cr H B) + pdM0 Ds Cr H B

noncomputable def pdE (Dc Ds Cr : ℕ) (H B : ℝ) : ℝ := Real.exp (Dc * pdLE Ds Cr H B ^ Dc)

noncomputable def pdE1 (J1 Ds Cr : ℕ) (H B : ℝ) : ℝ := Real.exp (J1 * pdLE Ds Cr H B ^ J1)

noncomputable def pdK0 (κ : LocalKernelClass) (d' Dc J1 Ds Cr : ℕ) (H B : ℝ) : ℕ :=
  ⌈Real.logb 2 (12 * pdEs Ds H * (pdE Dc Ds Cr H B + 1) * pdE1 J1 Ds Cr H B *
    (tailCT κ d' (pdE Dc Ds Cr H B) + 1) * 2 * 7 ^ (d' + d') * (2 * Real.pi) ^ ((d' + 1) ^ 2) *
    Real.exp B)⌉₊

section PredictorBudget
variable {Ds Cr : ℕ} {H B : ℝ}

theorem pdX_nonneg (hH : 1 ≤ H) : 0 ≤ pdX H := by
  unfold pdX; have := Real.log_nonneg hH; linarith

theorem one_le_pdEs (hH : 1 ≤ H) : 1 ≤ pdEs Ds H := by
  unfold pdEs; have := pdX_nonneg hH; exact Real.one_le_exp (by positivity)

theorem one_le_pdA0 (hH : 1 ≤ H) : 1 ≤ pdA0 Ds H := by
  unfold pdA0; have := pdX_nonneg hH
  have : 0 ≤ (Ds : ℝ) * pdX H ^ Ds := by positivity
  linarith

theorem one_le_pdT0 (hH : 1 ≤ H) : 1 ≤ pdT0 Ds Cr H B := by
  unfold pdT0
  have := one_le_pdEs (Ds := Ds) hH
  have := one_le_pdA0 (Ds := Ds) hH
  have : 0 ≤ 12 * (Cr : ℝ) * pdA0 Ds H ^ Cr * (1 + 6 * Cr) ^ Cr * pdEs Ds H * Real.exp B := by
    positivity
  linarith

theorem one_le_pdH0 : 1 ≤ pdH0 Ds Cr H B := by
  unfold pdH0
  have := bandLip_spec.1
  exact le_trans (by linarith) (le_max_right _ _)

/-- The shell budget: the size-weighted tail beyond `T₀` costs at most `e^{-B}/3`. -/
theorem pd_shell_budget (hH : 1 ≤ H) :
    Cr * pdA0 Ds H ^ Cr * (1 + 6 * Cr) ^ Cr * (4 * pdEs Ds H / pdT0 Ds Cr H B ^ 99) ≤
      Real.exp (-B) / 3 := by
  have hT := one_le_pdT0 (Ds := Ds) (Cr := Cr) (B := B) hH
  have hEs := one_le_pdEs (Ds := Ds) hH
  have hA := one_le_pdA0 (Ds := Ds) hH
  set c := (Cr : ℝ) * pdA0 Ds H ^ Cr * (1 + 6 * Cr) ^ Cr with hc
  have hc0 : 0 ≤ c := by positivity
  have hT99 : pdT0 Ds Cr H B ≤ pdT0 Ds Cr H B ^ 99 := le_self_pow₀ hT (by norm_num)
  have hTdef : 12 * c * pdEs Ds H * Real.exp B ≤ pdT0 Ds Cr H B := by
    unfold pdT0; rw [hc]; linarith
  have hem : Real.exp (-B) * Real.exp B = 1 := by rw [← Real.exp_add]; simp
  have hTpos : 0 < pdT0 Ds Cr H B := by linarith
  rw [mul_div_assoc', div_le_div_iff₀ (by positivity) (by norm_num)]
  have h1 : c * (4 * pdEs Ds H) * 3 ≤ Real.exp (-B) * pdT0 Ds Cr H B := by
    have := mul_le_mul_of_nonneg_left hTdef (Real.exp_pos (-B)).le
    calc c * (4 * pdEs Ds H) * 3 = Real.exp (-B) * (12 * c * pdEs Ds H * Real.exp B) := by
          rw [show Real.exp (-B) * (12 * c * pdEs Ds H * Real.exp B) =
            12 * c * pdEs Ds H * (Real.exp (-B) * Real.exp B) by ring, hem]; ring
      _ ≤ _ := this
  calc c * (4 * pdEs Ds H) * 3 ≤ Real.exp (-B) * pdT0 Ds Cr H B := h1
    _ ≤ Real.exp (-B) * pdT0 Ds Cr H B ^ 99 :=
        mul_le_mul_of_nonneg_left hT99 (Real.exp_pos _).le

/-- The band budget: discarding the bands `m > M₀` costs at most `e^{-B}/3`. -/
theorem pd_band_budget (hH : 1 ≤ H) :
    pdEs Ds H * (Real.exp (-(pdM0 Ds Cr H B : ℝ) / 2) *
      (Cr * (2 + Real.log (pdH0 Ds Cr H B)) ^ Cr)) ≤ Real.exp (-B) / 3 := by
  have hEs := one_le_pdEs (Ds := Ds) hH
  have hH0 := one_le_pdH0 (Ds := Ds) (Cr := Cr) (H := H) (B := B)
  have hl : 0 ≤ Real.log (pdH0 Ds Cr H B) := Real.log_nonneg hH0
  set Z := 3 * pdEs Ds H * Cr * (2 + Real.log (pdH0 Ds Cr H B)) ^ Cr with hZ
  have hZ0 : 0 ≤ Z := by positivity
  have hM : 2 * (B + Real.log (Z + 1)) ≤ (pdM0 Ds Cr H B : ℝ) := by
    unfold pdM0; rw [← hZ]; exact Nat.le_ceil _
  have hexp : Real.exp (-(pdM0 Ds Cr H B : ℝ) / 2) ≤ Real.exp (-B) / (Z + 1) := by
    have e : Real.exp (-B) / (Z + 1) = Real.exp (-B - Real.log (Z + 1)) := by
      rw [Real.exp_sub, Real.exp_log (by linarith)]
    rw [e]
    apply Real.exp_le_exp.mpr
    linarith
  have hgoal : pdEs Ds H * (Cr * (2 + Real.log (pdH0 Ds Cr H B)) ^ Cr) = Z / 3 := by
    rw [hZ]; ring
  calc pdEs Ds H * (Real.exp (-(pdM0 Ds Cr H B : ℝ) / 2) *
        (Cr * (2 + Real.log (pdH0 Ds Cr H B)) ^ Cr))
      = Real.exp (-(pdM0 Ds Cr H B : ℝ) / 2) * (Z / 3) := by rw [← hgoal]; ring
    _ ≤ Real.exp (-B) / (Z + 1) * (Z / 3) :=
        mul_le_mul_of_nonneg_right hexp (by positivity)
    _ ≤ Real.exp (-B) / 3 := by
        rw [div_mul_div_comm, div_le_div_iff₀ (by positivity) (by norm_num)]
        have := Real.exp_pos (-B)
        nlinarith only [this]

end PredictorBudget

theorem one_le_pdE (Dc Ds Cr : ℕ) (H B : ℝ) : 1 ≤ pdE Dc Ds Cr H B := by
  unfold pdE pdLE
  have h1 := one_le_pdH0 (Ds := Ds) (Cr := Cr) (H := H) (B := B)
  have := Real.log_nonneg h1
  exact Real.one_le_exp (by positivity)

/-- The catalog budget: the pooled catalog tails cost at most `e^{-B}/3`. -/
theorem pd_catalog_budget (κ : LocalKernelClass) (d' Dc J1 Ds Cr : ℕ) {H B : ℝ} (hH : 1 ≤ H) :
    4 * pdEs Ds H * ((⌊pdE Dc Ds Cr H B⌋₊ : ℝ) * (pdE1 J1 Ds Cr H B *
      tailCT κ d' (pdE Dc Ds Cr H B) *
      (2 * 7 ^ (d' + d') * (2 * Real.pi) ^ ((d' + 1) ^ 2 - 1) /
        2 ^ pdK0 κ d' Dc J1 Ds Cr H B))) ≤ Real.exp (-B) / 3 := by
  have hEs := one_le_pdEs (Ds := Ds) hH
  have hE := one_le_pdE Dc Ds Cr H B
  have hE1 : 0 < pdE1 J1 Ds Cr H B := Real.exp_pos _
  have hCT := tailCT_nonneg κ d' hE
  have hfl : (⌊pdE Dc Ds Cr H B⌋₊ : ℝ) ≤ pdE Dc Ds Cr H B + 1 := by
    have := Nat.floor_le (show 0 ≤ pdE Dc Ds Cr H B by linarith); linarith
  set Z := 12 * pdEs Ds H * (pdE Dc Ds Cr H B + 1) * pdE1 J1 Ds Cr H B *
    (tailCT κ d' (pdE Dc Ds Cr H B) + 1) * 2 * 7 ^ (d' + d') * (2 * Real.pi) ^ ((d' + 1) ^ 2) *
    Real.exp B with hZ
  have hZ0 : 0 < Z := by rw [hZ]; positivity
  have hK : Z ≤ (2 : ℝ) ^ pdK0 κ d' Dc J1 Ds Cr H B := two_pow_ceil_logb_ge hZ0
  have hpi : (2 * Real.pi) ^ ((d' + 1) ^ 2 - 1) ≤ (2 * Real.pi) ^ ((d' + 1) ^ 2) :=
    pow_le_pow_right₀ (by nlinarith only [Real.pi_gt_three]) (Nat.sub_le _ _)
  have hnum : 4 * pdEs Ds H * ((⌊pdE Dc Ds Cr H B⌋₊ : ℝ) * (pdE1 J1 Ds Cr H B *
      tailCT κ d' (pdE Dc Ds Cr H B) * (2 * 7 ^ (d' + d') * (2 * Real.pi) ^ ((d' + 1) ^ 2 - 1)))) ≤
      4 * pdEs Ds H * ((pdE Dc Ds Cr H B + 1) * (pdE1 J1 Ds Cr H B *
      (tailCT κ d' (pdE Dc Ds Cr H B) + 1) * (2 * 7 ^ (d' + d') *
        (2 * Real.pi) ^ ((d' + 1) ^ 2)))) := by
    gcongr; linarith
  have hem : Real.exp (-B) * Real.exp B = 1 := by rw [← Real.exp_add]; simp
  calc 4 * pdEs Ds H * ((⌊pdE Dc Ds Cr H B⌋₊ : ℝ) * (pdE1 J1 Ds Cr H B *
        tailCT κ d' (pdE Dc Ds Cr H B) *
        (2 * 7 ^ (d' + d') * (2 * Real.pi) ^ ((d' + 1) ^ 2 - 1) /
          2 ^ pdK0 κ d' Dc J1 Ds Cr H B)))
      = 4 * pdEs Ds H * ((⌊pdE Dc Ds Cr H B⌋₊ : ℝ) * (pdE1 J1 Ds Cr H B *
        tailCT κ d' (pdE Dc Ds Cr H B) * (2 * 7 ^ (d' + d') *
          (2 * Real.pi) ^ ((d' + 1) ^ 2 - 1)))) / 2 ^ pdK0 κ d' Dc J1 Ds Cr H B := by ring
    _ ≤ 4 * pdEs Ds H * ((pdE Dc Ds Cr H B + 1) * (pdE1 J1 Ds Cr H B *
        (tailCT κ d' (pdE Dc Ds Cr H B) + 1) * (2 * 7 ^ (d' + d') *
          (2 * Real.pi) ^ ((d' + 1) ^ 2)))) / Z := div_le_div₀ (by positivity) hnum hZ0 hK
    _ = Real.exp (-B) / 3 := by
        rw [hZ, div_eq_iff (by positivity)]
        have hem' : Real.exp B * Real.exp (-B) = 1 := by rw [mul_comm]; exact hem
        field_simp
        nlinarith only [hem', Real.exp_pos B]

/-- The cell-summed form of `predictor_cell_bound`. -/
theorem predictor_sum_bound {τ π : Type*} [Countable τ] [Countable π] [DecidableEq τ]
    [DecidableEq π] (S : Finset (ℤ × ℤ)) (len : ℤ × ℤ → ℝ) (hlen : ∀ I, 0 ≤ len I)
    (cf : τ → ℂ) (hcs : Summable (fun q => ‖cf q‖)) (LF : ℤ × ℤ → ℂ) (sepQ : ℤ × ℤ → τ → ℂ)
    (MQ : ℤ × ℤ → ℝ) (hsepQ : ∀ I ∈ S, ∀ q, ‖sepQ I q‖ ≤ MQ I)
    (hLF : ∀ I ∈ S, HasSum (fun q => cf q * sepQ I q) (LF I))
    (R : Finset τ) (ret : τ → ℤ × ℤ → Prop) [∀ q I, Decidable (ret q I)] (P : Finset π)
    (coeff : ℤ × ℤ → τ → π → ℂ) (sepP : ℤ × ℤ → τ → π → ℂ)
    (hcoeff : ∀ I q, Summable (fun p => ‖coeff I q p‖)) (MP : ℤ × ℤ → ℝ)
    (hsepP : ∀ I ∈ S, ∀ q p, ‖sepP I q p‖ ≤ MP I)
    (hexp : ∀ I ∈ S, ∀ q ∈ R, ret q I → HasSum (fun p => coeff I q p * sepP I q p)
      (sepQ I q / 4)) :
    ∑ I ∈ S, len I * ‖LF I - ∑ q ∈ R, (if ret q I then
        4 * cf q * ∑ p ∈ P, coeff I q p * sepP I q p else 0)‖ ≤
      (∑' q, if q ∈ R then 0 else ‖cf q‖ * ∑ I ∈ S, len I * ‖sepQ I q‖) +
      ∑ q ∈ R, ‖cf q‖ * ∑ I ∈ S.filter (fun I => ¬ ret q I), len I * ‖sepQ I q‖ +
      ∑ q ∈ R, 4 * ‖cf q‖ * ∑ I ∈ S.filter (fun I => ret q I), len I *
        ∑' p, (if p ∈ P then 0 else ‖coeff I q p‖ * ‖sepP I q p‖) := by
  classical
  have hcell : ∀ I ∈ S, len I * ‖LF I - ∑ q ∈ R, (if ret q I then
      4 * cf q * ∑ p ∈ P, coeff I q p * sepP I q p else 0)‖ ≤
      len I * ((∑' q, if q ∈ R then 0 else ‖cf q‖ * ‖sepQ I q‖) +
      ∑ q ∈ R, (if ret q I then 0 else ‖cf q‖ * ‖sepQ I q‖) +
      ∑ q ∈ R, (if ret q I then 4 * ‖cf q‖ *
        ∑' p, (if p ∈ P then 0 else ‖coeff I q p‖ * ‖sepP I q p‖) else 0)) := by
    intro I hI
    exact mul_le_mul_of_nonneg_left (predictor_cell_bound cf hcs (sepQ I) (hsepQ I hI)
      (hLF I hI) R (fun q => ret q I) P (coeff I) (sepP I) (hcoeff I) (hsepP I hI)
      (fun q hq hr => hexp I hI q hq hr)) (hlen I)
  refine (Finset.sum_le_sum hcell).trans (le_of_eq ?_)
  simp only [mul_add, Finset.sum_add_distrib]
  refine congr (congrArg HAdd.hAdd (congr (congrArg HAdd.hAdd ?_) ?_)) ?_
  · -- the discarded shells: swap the finite and the infinite sums
    have hsum : ∀ I ∈ S, Summable (fun q => if q ∈ R then 0 else ‖cf q‖ * ‖sepQ I q‖) := by
      intro I hI
      refine Summable.of_nonneg_of_le (fun q => by split_ifs <;> positivity) (fun q => ?_)
        (hcs.mul_right (MQ I))
      split_ifs
      · exact mul_nonneg (norm_nonneg _) ((norm_nonneg _).trans (hsepQ I hI q))
      · exact mul_le_mul_of_nonneg_left (hsepQ I hI q) (norm_nonneg _)
    rw [Finset.sum_congr rfl (fun I hI => (tsum_mul_left).symm), ← Summable.tsum_finsetSum
      (fun I hI => (hsum I hI).mul_left (len I))]
    congr 1; funext q
    split_ifs
    · simp
    · rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun I _ => ?_
      ring
  · simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [Finset.sum_filter]
    refine Finset.sum_congr rfl fun I _ => ?_
    split_ifs <;> ring
  · simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [Finset.sum_filter]
    refine Finset.sum_congr rfl fun I _ => ?_
    split_ifs <;> ring

theorem separatedLocalForm_smul_right (r : ℝ) (w : ℝ × ℝ → ℂ) (Q : ℝ → ℂ) (a b : Fin 4)
    (Fa Fb : ℝ → ℂ) (c : ℂ) :
    separatedLocalForm r w Q a b Fa (fun y => c * Fb y) =
      c * separatedLocalForm r w Q a b Fa Fb := by
  unfold separatedLocalForm
  rw [mul_left_comm, ← integral_const_mul c]
  congr 1; congr 1; funext z; ring

/-- The atom-pair expansion of the local form at one cell, for arbitrary cell-local `L²`
inputs in the remaining slots, with a uniform bound of the separated forms. -/
theorem pair_expansion_cell {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a i k b : Fin 4}
    (hai : a ≠ i) (hak : a ≠ k) (hab : a ≠ b) (hik : i ≠ k) (hib : i ≠ b) (hkb : k ≠ b)
    {R v φ φ' : ℝ → ℂ} (hRm : Measurable R) (hvm : Measurable v)
    (hR2 : MemLp R 2 (volume.restrict (Set.Ico a₀ (a₀ + r))))
    (hv2 : MemLp v 2 (volume.restrict (Set.Ico a₀ (a₀ + r))))
    {τ : Type*} [Countable τ] (cf : τ → ℂ) (ψa ψb Q : τ → ℝ → ℂ)
    (hψam : ∀ q, Measurable (ψa q)) (hψbm : ∀ q, Measurable (ψb q)) (hQm : ∀ q, Measurable (Q q))
    (hψab : ∀ q y, ‖ψa q y‖ ≤ 1) (hψbb : ∀ q y, ‖ψb q y‖ ≤ 1) (hQb : ∀ q y, ‖Q q y‖ ≤ 1)
    (hcs : Summable (fun q => ‖cf q‖))
    (hexp : ∀ x t : ℝ, HasSum (fun q => cf q * ψa q (x + (a : ℝ) * t) *
      ψb q (x + (b : ℝ) * t) * Q q t) (φ (x + (i : ℝ) * t) * φ' (x + (k : ℝ) * t)))
    (f : Fin 4 → ℝ → ℂ) (hfa : f a = R) (hfi : f i = φ) (hfk : f k = φ') (hfb : f b = v) :
    ∃ M : ℝ, HasSum (fun q => cf q * separatedLocalForm r w (Q q) a b
        (fun y => ψa q y * R y) (fun y => ψb q y * v y)) (localProgressionForm r w f) ∧
      ∀ q, ‖separatedLocalForm r w (Q q) a b (fun y => ψa q y * R y)
        (fun y => ψb q y * v y)‖ ≤ M := by
  classical
  set! cv : ℝ := max 1 (eLpNorm v 2 (normalizedIntervalMeasure a₀ r)).toReal with hcv
  have hcv1 : 1 ≤ cv := le_max_left _ _
  have hcv0 : 0 < cv := by linarith
  set! v' : ℝ → ℂ := fun y => ((cv⁻¹ : ℝ) : ℂ) * v y with hv'
  have hv'm : Measurable v' := measurable_const.mul hvm
  have hv'n : eLpNorm v' 2 (normalizedIntervalMeasure a₀ r) ≤ 1 := by
    have hne := eLpNorm_normalized_ne_top hv2
    have h := eLpNorm_const_smul (μ := normalizedIntervalMeasure a₀ r) (p := 2)
      ((cv⁻¹ : ℝ) : ℂ) v
    have he : v' = ((cv⁻¹ : ℝ) : ℂ) • v := by funext y; simp [hv']
    rw [he, h]
    rw [show ‖((cv⁻¹ : ℝ) : ℂ)‖ₑ = ENNReal.ofReal cv⁻¹ by
      rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg (by positivity)]]
    rw [← ENNReal.ofReal_toReal hne, ← ENNReal.ofReal_mul (by positivity)]
    apply ENNReal.ofReal_le_one.mpr
    rw [inv_mul_le_iff₀ hcv0, mul_one]
    exact le_max_right _ _
  set! C₁ := (eLpNorm R 2 (normalizedIntervalMeasure a₀ r)).toReal with hC₁
  have hC₁0 : 0 ≤ C₁ := ENNReal.toReal_nonneg
  have hRn : eLpNorm R 2 (normalizedIntervalMeasure a₀ r) ≤ ENNReal.ofReal C₁ :=
    eLpNorm_normalized_le_toReal hR2
  set! f' := Function.update f b v' with hf'
  have hf'a : f' a = R := by rw [hf', Function.update_of_ne hab]; exact hfa
  have hf'i : f' i = φ := by rw [hf', Function.update_of_ne hib]; exact hfi
  have hf'k : f' k = φ' := by rw [hf', Function.update_of_ne hkb]; exact hfk
  have hf'b : f' b = v' := by rw [hf', Function.update_self]
  obtain ⟨hHS, hXb⟩ := localProgressionForm_pair_expansion hr hw hai hak hab hik hib hkb
    hRm hv'm hC₁0 hRn hv'n cf ψa ψb Q hψam hψbm hQm hψab hψbb hQb hcs hexp f' hf'a hf'i hf'k
    hf'b
  -- undo the normalization of `v`
  have hLF : localProgressionForm r w f' = ((cv⁻¹ : ℝ) : ℂ) * localProgressionForm r w f := by
    have h := localProgressionForm_update_const_smul r w f b ((cv⁻¹ : ℝ) : ℂ) v
    have e1 : Function.update f b (((cv⁻¹ : ℝ) : ℂ) • v) = f' := by
      rw [hf']; congr 1
    have e2 : Function.update f b v = f := by
      rw [← hfb, Function.update_eq_self]
    rw [e1, e2] at h
    exact h
  have hsep : ∀ q, separatedLocalForm r w (Q q) a b (fun y => R y * ψa q y)
      (fun y => v' y * ψb q y) = ((cv⁻¹ : ℝ) : ℂ) *
        separatedLocalForm r w (Q q) a b (fun y => ψa q y * R y) (fun y => ψb q y * v y) := by
    intro q
    rw [← separatedLocalForm_smul_right]
    congr 1
    · funext y; ring
    · funext y; simp only [hv']; ring
  refine ⟨cv * (localFormUniformConstant κ * C₁), ?_, fun q => ?_⟩
  · have h2 := hHS.mul_left ((cv : ℝ) : ℂ)
    rw [hLF] at h2
    have hc : ((cv : ℝ) : ℂ) * (((cv⁻¹ : ℝ) : ℂ) * localProgressionForm r w f) =
        localProgressionForm r w f := by
      rw [← mul_assoc, ← Complex.ofReal_mul, mul_inv_cancel₀ hcv0.ne', Complex.ofReal_one,
        one_mul]
    rw [hc] at h2
    convert h2 using 1
    funext q
    have hcvC : ((cv : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hcv0.ne'
    rw [hsep q, Complex.ofReal_inv]
    field_simp
  · have h := hXb q
    rw [hsep q, norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity)] at h
    rw [← le_div_iff₀' (by positivity : (0 : ℝ) < cv⁻¹)] at h
    calc ‖separatedLocalForm r w (Q q) a b (fun y => ψa q y * R y) (fun y => ψb q y * v y)‖
        ≤ localFormUniformConstant κ * C₁ / cv⁻¹ := h
      _ = cv * (localFormUniformConstant κ * C₁) := by field_simp

/-- A uniform bound of separated forms with bounded time factor and bounded multipliers. -/
theorem separatedLocalForm_bounded_le {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a b : Fin 4} (hab : a ≠ b)
    {K : ℝ → ℂ} (hK : ∀ t, ‖K t‖ ≤ 1) {ψa ψb za zb : ℝ → ℂ} (hψam : Measurable ψa)
    (hψbm : Measurable ψb) (hψa : ∀ y, ‖ψa y‖ ≤ 1) (hψb : ∀ y, ‖ψb y‖ ≤ 1)
    (hzam : Measurable za) (hzbm : Measurable zb)
    (hza : MemLp za 2 (volume.restrict (Set.Ico a₀ (a₀ + r))))
    (hzb : MemLp zb 2 (volume.restrict (Set.Ico a₀ (a₀ + r)))) :
    ‖separatedLocalForm r w K a b (fun y => ψa y * za y) (fun y => ψb y * zb y)‖ ≤
      localKernelSupBound κ * Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖za y‖ ^ 2) *
        Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖zb y‖ ^ 2) := by
  have h := separatedLocalForm_sup_le hr hw hab zero_le_one (fun t _ => hK t)
    (hψam.mul hzam) (hψbm.mul hzbm) (memLp_mul_bounded_restrict hψam hψa hza)
    (memLp_mul_bounded_restrict hψbm hψb hzb)
  refine h.trans ?_
  rw [mul_one]
  have hC := localKernelSupBound_nonneg κ
  have hr' : 0 ≤ r⁻¹ := by positivity
  have ha := Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_left (setIntegral_mul_bounded_le hψa hza) hr')
  have hb := Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_left (setIntegral_mul_bounded_le hψb hzb) hr')
  exact mul_le_mul (mul_le_mul_of_nonneg_left ha hC) hb (Real.sqrt_nonneg _) (by positivity)

theorem pd_shell_log (Ds : ℕ) {H s : ℝ} (hs : 1 ≤ s) :
    2 + Real.log ((pdEs Ds H * s) ^ 6) = pdA0 Ds H + 6 * Real.log s := by
  rw [Real.log_pow, pdEs, Real.log_mul (Real.exp_pos _).ne' (by positivity), Real.log_exp, pdA0]
  push_cast; ring

/-- The size bound of the predictor list. -/
noncomputable def pdCard (κ : LocalKernelClass) (d' Dc J1 Ds Cr : ℕ) (H B : ℝ) : ℝ :=
  Real.exp (10 * pdX H ^ 2) * (3 * pdT0 Ds Cr H B) ^ (3 * d') *
    (3 * (⌊pdE Dc Ds Cr H B⌋₊ : ℝ) ^ 2) ^ (d' * d') *
    (3 * (⌊pdE Dc Ds Cr H B * 2 ^ pdK0 κ d' Dc J1 Ds Cr H B⌋₊ : ℝ) ^ 2) ^ d'

/-- Blueprint lem:predictors, `eq:predictors` with explicit parameters: the product of two
fixed bounded atoms in slots `i, k` of the local form is replaced by a finite list of terms
`ψ_a(y_a) ψ_b(y_b) w_I(x,t) e(λ_* t²)` with scale-dependent coefficients, with absolute
length-weighted error at most `e^{-B} K_a K_b ‖1_J F_a‖ ‖1_J F_b‖`. -/
theorem predictor_list_param (c₀ : ℕ) (hc : 1 ≤ c₀) (κ : LocalKernelClass) :
    ∃ c₁ Ds Cr Dc J1 : ℕ, 1 ≤ c₁ ∧ ∀ {d e : ℕ} (H B : ℝ) (A : QuadraticChartData d)
      (A' : QuadraticChartData e), 1 ≤ d → 1 ≤ e → QuadraticChartComplexity c₀ H A →
      QuadraticChartComplexity c₀ H A' → IsBoundedQuadraticChart A →
      IsBoundedQuadraticChart A' → 1 ≤ B →
      ∀ {a i k b : Fin 4}, a ≠ i → a ≠ k → a ≠ b → i ≠ k → i ≠ b → k ≠ b →
      ∃ (ι : Type) (L : Finset ι) (ψa ψb : ι → QuadraticChartData (d + e)) (lam : ι → ℝ)
        (coef : ι → ℝ → ℂ),
        (L.card : ℝ) ≤ pdCard κ (d + e) Dc J1 Ds Cr H B ∧
        (∀ ℓ ∈ L, IsBoundedQuadraticChart (ψa ℓ) ∧ IsBoundedQuadraticChart (ψb ℓ) ∧
          QuadraticChartComplexity c₁ (pdH0 Ds Cr H B) (ψa ℓ) ∧
          QuadraticChartComplexity c₁ (pdH0 Ds Cr H B) (ψb ℓ)) ∧
        (∀ r, ∑ ℓ ∈ L, ‖coef ℓ r‖ ≤ 4 * pdEs Ds H * pdE Dc Ds Cr H B) ∧
        (∀ ℓ r, coef ℓ r ≠ 0 → |lam ℓ| * r ^ 2 ≤ pdE Dc Ds Cr H B) ∧
        ∀ (G : RealDyadicGrid) (J : ℤ × ℤ) (S : Finset (ℤ × ℤ)),
        (∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2) →
        ∀ (w : ℤ × ℤ → ℝ × ℝ → ℂ), (∀ I ∈ S, IsAdmissibleLocalKernel κ
          (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) (w I)) →
        ∀ {Fa Fb : ℝ → ℂ} {za zb : ℤ × ℤ → ℝ → ℂ} {Ka Kb : ℝ}, 0 ≤ Ka → 0 ≤ Kb →
        IsAdmissibleOpponent G J Fa za Ka → IsAdmissibleOpponent G J Fb zb Kb →
        HasDepthEnergy G J Fa za Ka → HasDepthEnergy G J Fb zb Kb →
        (∀ I, Measurable (za I)) → (∀ I, Measurable (zb I)) →
        (∀ I, MemLp (za I) 2 (volume.restrict (dyadicGridCell G I.1 I.2))) →
        (∀ I, MemLp (zb I) 2 (volume.restrict (dyadicGridCell G I.1 I.2))) →
        ∀ (f : ℤ × ℤ → Fin 4 → ℝ → ℂ), (∀ I, f I a = za I) →
        (∀ I, f I i = quadraticChartAtom A) → (∀ I, f I k = quadraticChartAtom A') →
        (∀ I, f I b = zb I) →
        ∑ I ∈ S, dyadicGridLength G I.1 *
          ‖localProgressionForm (dyadicGridLength G I.1) (w I) (f I) -
            ∑ ℓ ∈ L, coef ℓ (dyadicGridLength G I.1) *
              separatedLocalForm (dyadicGridLength G I.1) (w I)
                (fun t => (Real.fourierChar (lam ℓ * t ^ 2) : ℂ)) a b
                (fun y => za I y * quadraticChartAtom (ψa ℓ) y)
                (fun y => zb I y * quadraticChartAtom (ψb ℓ) y)‖ ≤
          Real.exp (-B) * Ka * Kb * Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2) *
            Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2) := by
  obtain ⟨c₁, Ds, hc₁, hDs, hsep⟩ := progressionSeparation c₀ hc
  obtain ⟨Cr, hCr⟩ := chart_band_range_scale_sum c₁ hc₁ κ
  obtain ⟨Dc, hDc, DJ, hexpand⟩ := chart_depth_expansion c₁ hc₁
  refine ⟨c₁, Ds, Cr, Dc, DJ 1, hc₁, ?_⟩
  intro d e H B A A' hd he hA hA' hAb hA'b hB a i k b h1 h2 h3 h4 h5 h6
  classical
  have hH1 : 1 ≤ H := by linarith [hA.lower, Real.add_one_le_exp (2 : ℝ)]
  have hB0 : 0 ≤ B := by linarith
  -- the separation of the atom pair
  have hab : ((a : ℕ) : ℤ) ≠ ((b : ℕ) : ℤ) := by
    intro h; apply h3; exact Fin.ext (by exact_mod_cast h)
  obtain ⟨τ, hτc, cf, φa, φb, φt, size, hexpS, hbdd, hsize1, hcs, hcsum, htail, hcomp, hcount,
    -⟩ :=
    hsep H A A' hd he hA hA' ((i : ℕ) : ℤ) ((k : ℕ) : ℤ) ((a : ℕ) : ℤ) ((b : ℕ) : ℤ) hab
      (abs_fin_int_le i) (abs_fin_int_le k) (abs_fin_int_le a) (abs_fin_int_le b)
  set Es := pdEs Ds H with hEs
  have hEsdef : Real.exp (Ds * (1 + Real.log H) ^ Ds) = Es := by rw [hEs, pdEs, pdX]
  rw [hEsdef] at hcsum htail hcomp
  set! T₀ := pdT0 Ds Cr H B with hT₀
  have hT₀1 : 1 ≤ T₀ := one_le_pdT0 hH1
  obtain ⟨Qs, hQs, hQscard⟩ := hcount T₀ hT₀1
  set! R := Qs.filter (fun q => size q ≤ T₀) with hR
  have hnotR : ∀ q, q ∉ R → T₀ < size q := by
    intro q hq
    by_contra hle
    push Not at hle
    exact hq (Finset.mem_filter.mpr ⟨hQs q hle, hle⟩)
  set H₀ := pdH0 Ds Cr H B with hH₀
  have hH₀1 : 1 ≤ H₀ := one_le_pdH0
  have hcompR : ∀ q ∈ R, QuadraticChartComplexity c₁ H₀ (φt q) ∧
      QuadraticChartComplexity c₁ H₀ (φa q) ∧ QuadraticChartComplexity c₁ H₀ (φb q) := by
    intro q hq
    have hs := (Finset.mem_filter.mp hq).2
    have hle : (Es * size q) ^ 6 ≤ H₀ := by
      rw [hH₀, pdH0]
      refine le_trans ?_ (le_max_left _ _)
      have := hsize1 q
      have hE1 : 1 ≤ Es := one_le_pdEs hH1
      exact pow_le_pow_left₀ (by positivity) (mul_le_mul_of_nonneg_left hs (by linarith)) 6
    exact ⟨quadraticChartComplexity_mono (hcomp q).2.2 hle,
      quadraticChartComplexity_mono (hcomp q).1 hle,
      quadraticChartComplexity_mono (hcomp q).2.1 hle⟩
  -- the band precision and the retained scales
  set! M₀ := pdM0 Ds Cr H B with hM₀
  set! δ := Real.exp (-((M₀ : ℝ) + 1)) with hδ
  have hδ0 : 0 < δ := Real.exp_pos _
  have hlogδ : Real.log (max 1 δ⁻¹) = (M₀ : ℝ) + 1 := by
    rw [hδ, ← Real.exp_neg, neg_neg, max_eq_right (Real.one_le_exp (by positivity)),
      Real.log_exp]
  have hLE : 1 + Real.log H₀ + Real.log (max 1 δ⁻¹) = pdLE Ds Cr H B := by
    rw [hlogδ, pdLE, hH₀]; ring
  set! A4 : τ → QuadraticChartData (d + e) := fun q => scaleQuadraticChartAmplitude (1 / 4 : ℂ) (φt
      q)
    with hA4
  have hA4c : ∀ q ∈ R, QuadraticChartComplexity c₁ H₀ (A4 q) := fun q hq =>
    scaleQuadraticChartAmplitude_complexity (hcompR q hq).1 (by norm_num)
  have hA4b : ∀ q t, ‖quadraticChartAtom (A4 q) t‖ ≤ 1 / 4 := fun q t =>
    quarterChart_norm_le (hbdd q).2.2 t
  set! ret : τ → ℝ → Prop := fun q r => δ < bandSup (quadraticChartAtom (A4 q)) r with hret
  have hζb : ∀ u, ‖(bandCutoff u : ℂ)‖ ≤ H₀ := fun u => by
    rw [Complex.norm_real, Real.norm_of_nonneg (bandCutoff_spec.2.1 u)]
    exact (bandCutoff_spec.2.2.1 u).trans hH₀1
  have hζL : ∀ u v, ‖(bandCutoff v : ℂ) - (bandCutoff u : ℂ)‖ ≤ H₀ * |v - u| := by
    intro u v
    rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
    refine (bandLip_spec.2 u v).trans (mul_le_mul_of_nonneg_right ?_ (abs_nonneg _))
    rw [hH₀, pdH0]; exact (le_add_of_nonneg_right zero_le_one).trans (le_max_right _ _)
  -- the per-(term, scale) chart expansions
  set E := pdE Dc Ds Cr H B with hE
  set! E1 := pdE1 (DJ 1) Ds Cr H B with hE1d
  have hEdef : Real.exp (Dc * (1 + Real.log H₀ + Real.log (max 1 δ⁻¹)) ^ Dc) = E := by
    rw [hLE, hE, pdE]
  have hE1def : Real.exp ((DJ 1 : ℕ) * (1 + Real.log H₀ + Real.log (max 1 δ⁻¹)) ^ (DJ 1)) =
      E1 := by rw [hLE, hE1d, pdE1]
  have hexpq : ∀ (q : τ) (r : ℝ), ∃ (lam : ℝ) (M : Matrix (Fin (d + e)) (Fin (d + e)) ℚ)
      (σ : ℕ × (Fin ((d + e) + (d + e)) → ℤ) → Fin (d + e) → ℚ)
      (coef : ℕ × (Fin ((d + e) + (d + e)) → ℤ) → ℂ),
      q ∈ R → 0 < r → ret q r →
        (∀ i j, (rationalHeight (M i j) : ℝ) ≤ E) ∧
        lam = (φt q).quadratic + ∑ i, ∑ j, (φt q).horizontal i * (M i j : ℝ) *
          (φt q).horizontal j ∧
        |lam| * r ^ 2 ≤ E ∧
        (∀ p i, (rationalHeight (σ p i) : ℝ) ≤ E * (1 + frequencyLength p.2)) ∧
        (∀ t, |t| ≤ 2 * r → HasSum (fun p => coef p *
          quadPhase lam ((φt q).linear + ∑ i, (σ p i : ℝ) * (φt q).horizontal i) t)
            (quadraticChartAtom (A4 q) t)) ∧
        Summable (fun p => ‖coef p‖) ∧ (∑' p, ‖coef p‖) ≤ E ∧
        (∀ p, ⌊E⌋₊ ≤ p.1 → coef p = 0) ∧
        ∀ p, ‖coef p‖ * (1 + frequencyLength p.2) ^ ((d + e + 1) ^ 2) ≤ E1 := by
    intro q r
    by_cases hall : q ∈ R ∧ 0 < r ∧ ret q r
    · obtain ⟨hqR, hr, hret'⟩ := hall
      have hlow : ∃ ξ, δ < bandAmplitude (quadraticChartAtom (A4 q)) r ξ := by
        obtain ⟨ξ, hξ⟩ := exists_lt_of_lt_ciSup hret'
        exact ⟨ξ, hξ⟩
      obtain ⟨lam, M, σ, coef, g1, g2, g3, g4, g5, g6, g7, g8, g9⟩ :=
        hexpand H₀ δ r (A4 q) (hA4c q hqR) hr hδ0 hζb hζL hlow
      rw [hEdef] at g1 g3 g4 g7 g8
      rw [hE1def] at g9
      exact ⟨lam, M, σ, coef, fun _ _ _ => ⟨g1, g2, g3, g4, g5, g6, g7, g8, g9⟩⟩
    · exact ⟨0, 0, 0, 0, fun hq hr hrt => absurd ⟨hq, hr, hrt⟩ hall⟩
  choose lamf Mf σf coeff hprops using hexpq
  -- the catalog and the list
  set! K₀ := pdK0 κ (d + e) Dc (DJ 1) Ds Cr H B with hK₀
  set! P : Finset (ℕ × (Fin ((d + e) + (d + e)) → ℤ)) :=
    (Finset.range ⌊E⌋₊) ×ˢ frequencyTruncationSet ((d + e) + (d + e)) K₀ with hP
  set! Bσ := E * 2 ^ K₀ with hBσ
  set! Mset : Finset (Matrix (Fin (d + e)) (Fin (d + e)) ℚ) :=
    Fintype.piFinset (fun _ => Fintype.piFinset (fun _ => boundedRationalEnumeration ⌊E⌋₊))
    with hMset
  set! σset : Finset (Fin (d + e) → ℚ) :=
    Fintype.piFinset (fun _ => boundedRationalEnumeration ⌊Bσ⌋₊) with hσset
  set! lamℓ : τ × (Matrix (Fin (d + e)) (Fin (d + e)) ℚ × (Fin (d + e) → ℚ)) → ℝ := fun ℓ =>
    (φt ℓ.1).quadratic + ∑ i, ∑ j, (φt ℓ.1).horizontal i * (ℓ.2.1 i j : ℝ) *
      (φt ℓ.1).horizontal j with hlamℓ
  set! νℓ : τ × (Matrix (Fin (d + e)) (Fin (d + e)) ℚ × (Fin (d + e) → ℚ)) → ℝ := fun ℓ =>
    ((φt ℓ.1).linear + ∑ i, (ℓ.2.2 i : ℝ) * (φt ℓ.1).horizontal i) / ((b : ℝ) - (a : ℝ))
    with hνℓ
  set! coefℓ : τ × (Matrix (Fin (d + e)) (Fin (d + e)) ℚ × (Fin (d + e) → ℚ)) → ℝ → ℂ :=
    fun ℓ r => if ℓ.1 ∈ R ∧ 0 < r ∧ ret ℓ.1 r ∧ Mf ℓ.1 r = ℓ.2.1 then
      4 * cf ℓ.1 * ∑ p ∈ P.filter (fun p => σf ℓ.1 r p = ℓ.2.2), coeff ℓ.1 r p else 0
    with hcoefℓ
  refine ⟨τ × (Matrix (Fin (d + e)) (Fin (d + e)) ℚ × (Fin (d + e) → ℚ)),
    R ×ˢ (Mset ×ˢ σset), fun ℓ => modulateQuadraticChart (φa ℓ.1) (-νℓ ℓ),
    fun ℓ => modulateQuadraticChart (φb ℓ.1) (νℓ ℓ), lamℓ, coefℓ, ?_, ?_, ?_, ?_, ?_⟩
  · -- the size of the list
    have hE1' : 1 ≤ E := one_le_pdE Dc Ds Cr H B
    have hfE : 1 ≤ ⌊E⌋₊ := Nat.le_floor (by exact_mod_cast hE1')
    have hBσ1 : 1 ≤ Bσ := by
      rw [hBσ]; exact one_le_mul_of_one_le_of_one_le hE1' (one_le_pow₀ (by norm_num))
    have hfB : 1 ≤ ⌊Bσ⌋₊ := Nat.le_floor (by exact_mod_cast hBσ1)
    have hR : (R.card : ℝ) ≤ Real.exp (10 * pdX H ^ 2) * (3 * T₀) ^ (3 * (d + e)) := by
      refine (Nat.cast_le.mpr (Finset.card_filter_le _ _)).trans ?_
      rw [pdX]; exact hQscard
    have hMs : (Mset.card : ℝ) ≤ (3 * (⌊E⌋₊ : ℝ) ^ 2) ^ ((d + e) * (d + e)) := by
      have hc : Mset.card = (boundedRationalEnumeration ⌊E⌋₊).card ^ ((d + e) * (d + e)) := by
        rw [hMset, pow_mul]
        erw [Fintype.card_piFinset]
        simp only [Fintype.card_piFinset, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      rw [hc]
      have h := boundedRationalEnumeration_card ⌊E⌋₊ hfE
      push_cast
      exact pow_le_pow_left₀ (by positivity) (by exact_mod_cast h) _
    have hσs : (σset.card : ℝ) ≤ (3 * (⌊Bσ⌋₊ : ℝ) ^ 2) ^ (d + e) := by
      rw [hσset, Fintype.card_piFinset]
      simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      have h := boundedRationalEnumeration_card ⌊Bσ⌋₊ hfB
      push_cast
      exact pow_le_pow_left₀ (by positivity) (by exact_mod_cast h) _
    rw [Finset.card_product, Finset.card_product]
    push_cast
    unfold pdCard
    rw [← hT₀, ← hE, ← hK₀, ← hBσ]
    calc (R.card : ℝ) * ((Mset.card : ℝ) * (σset.card : ℝ))
        ≤ (Real.exp (10 * pdX H ^ 2) * (3 * T₀) ^ (3 * (d + e))) *
          ((3 * (⌊E⌋₊ : ℝ) ^ 2) ^ ((d + e) * (d + e)) * (3 * (⌊Bσ⌋₊ : ℝ) ^ 2) ^ (d + e)) := by
          gcongr
      _ = _ := by ring
  · -- bounded atoms of controlled complexity
    intro ℓ hℓ
    have hq : ℓ.1 ∈ R := (Finset.mem_product.mp hℓ).1
    exact ⟨modulateQuadraticChart_bounded (hbdd ℓ.1).1 _,
      modulateQuadraticChart_bounded (hbdd ℓ.1).2.1 _,
      modulateQuadraticChart_complexity (hcompR ℓ.1 hq).2.1 _,
      modulateQuadraticChart_complexity (hcompR ℓ.1 hq).2.2 _⟩
  · -- the coefficient norm
    intro r
    have hinner : ∀ q ∈ R, ∑ x ∈ Mset ×ˢ σset, ‖coefℓ (q, x) r‖ ≤ 4 * ‖cf q‖ * E := by
      intro q hq
      by_cases hc : 0 < r ∧ ret q r
      · have hMfix : ∑ x ∈ Mset ×ˢ σset, ‖coefℓ (q, x) r‖ ≤
            ∑ σ ∈ σset, ‖4 * cf q * ∑ p ∈ P.filter (fun p => σf q r p = σ), coeff q r p‖ := by
          rw [Finset.sum_product]
          by_cases hMm : Mf q r ∈ Mset
          · rw [Finset.sum_eq_single (Mf q r)]
            · refine Finset.sum_le_sum fun σ _ => le_of_eq ?_
              simp only [hcoefℓ, hq, hc.1, hc.2, and_self, ite_true]
            · intro M _ hne
              refine Finset.sum_eq_zero fun σ _ => ?_
              simp only [hcoefℓ]
              rw [ite_eq_right (show ¬(q ∈ R ∧ 0 < r ∧ ret q r ∧ Mf q r = M) from
                fun h => hne h.2.2.2.symm), norm_zero]
            · intro h; exact absurd hMm h
          · rw [Finset.sum_eq_zero (fun M hM => Finset.sum_eq_zero fun σ _ => by
                simp only [hcoefℓ]
                rw [ite_eq_right (show ¬(q ∈ R ∧ 0 < r ∧ ret q r ∧ Mf q r = M) from
                  fun h => hMm (h.2.2.2 ▸ hM)), norm_zero])]
            exact Finset.sum_nonneg fun _ _ => norm_nonneg _
        refine hMfix.trans ?_
        have hpsum : ∑ p ∈ P, ‖coeff q r p‖ ≤ E :=
          ((hprops q r hq hc.1 hc.2).2.2.2.2.2.1.sum_le_tsum P
            (fun _ _ => norm_nonneg _)).trans (hprops q r hq hc.1 hc.2).2.2.2.2.2.2.1
        calc ∑ σ ∈ σset, ‖4 * cf q * ∑ p ∈ P.filter (fun p => σf q r p = σ), coeff q r p‖

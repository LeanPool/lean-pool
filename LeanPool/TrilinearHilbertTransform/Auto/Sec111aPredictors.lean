    (F : Lp ℂ 2 (volume : Measure ℝ)) :
    ∫ y, conj (τ y) * F y =
      ∫ ξ, conj (𝓕 τ ξ) * (𝓕 F : Lp ℂ 2 (volume : Measure ℝ)) ξ := by
  have h := Lp.inner_fourier_eq (hτ2.toLp τ) F
  rw [L2.inner_def, L2.inner_def] at h
  have e1 : ∫ y, conj (τ y) * F y =
      ∫ y, inner ℂ ((hτ2.toLp τ : Lp ℂ 2 (volume : Measure ℝ)) y) (F y) := by
    apply integral_congr_ae
    filter_upwards [MemLp.coeFn_toLp hτ2] with y hy
    rw [hy]; simp [mul_comm]
  have e2 : ∫ ξ, conj (𝓕 τ ξ) * (𝓕 F : Lp ℂ 2 (volume : Measure ℝ)) ξ =
      ∫ ξ, inner ℂ ((𝓕 (hτ2.toLp τ) : Lp ℂ 2 (volume : Measure ℝ)) ξ)
        ((𝓕 F : Lp ℂ 2 (volume : Measure ℝ)) ξ) := by
    apply integral_congr_ae
    filter_upwards [fourierLp_ae_eq_fourier hτ1 hτ2] with ξ hξ
    rw [hξ]; simp [mul_comm]
  rw [e1, e2, h]


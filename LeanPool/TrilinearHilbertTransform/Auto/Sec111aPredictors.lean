theorem bracket_t4_le (κ : LocalKernelClass) {d : ℕ} (hLh : 0 ≤ Lh) (hdL : (d : ℝ) ≤ Lh) :
    (((d * d + 1 : ℕ) : ℝ) + 1) ^ 4 * Real.log (2 * bsB1 D m Lh) +

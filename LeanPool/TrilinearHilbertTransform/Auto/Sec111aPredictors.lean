    calc ((bsK0 κ d D J1 m Lh : ℕ) : ℝ) * Real.log 2 ≤ ((bsK0 κ d D J1 m Lh : ℕ) : ℝ) * 1 :=
          mul_le_mul_of_nonneg_left l2 hK0
      _ = _ := mul_one _
  linarith

theorem log_two_bsB2_le (κ : LocalKernelClass) {d : ℕ} (hLh : 0 ≤ Lh) (hdL : (d : ℝ) ≤ Lh) :

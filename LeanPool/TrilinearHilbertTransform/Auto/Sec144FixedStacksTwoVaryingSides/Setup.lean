/-- The uniform probability on a finite type with the discrete σ-algebra. -/
noncomputable def unifMeasure (Ω : Type*) [Fintype Ω] [MeasurableSpace Ω] : Measure Ω :=
  (Fintype.card Ω : ℝ≥0∞)⁻¹ • Measure.count

theorem lintegral_unifMeasure {Ω : Type*} [Fintype Ω] [MeasurableSpace Ω]
    [MeasurableSingletonClass Ω] (f : Ω → ℝ≥0∞) :
    ∫⁻ ω, f ω ∂(unifMeasure Ω) = (Fintype.card Ω : ℝ≥0∞)⁻¹ * ∑ ω, f ω := by
  unfold unifMeasure
  rw [lintegral_smul_measure, lintegral_count, tsum_fintype, smul_eq_mul]

instance {Ω : Type*} [Fintype Ω] [Nonempty Ω] [MeasurableSpace Ω] [MeasurableSingletonClass Ω] :
    IsProbabilityMeasure (unifMeasure Ω) := by
  constructor
  have h := lintegral_unifMeasure (Ω := Ω) (fun _ => 1)
  rw [lintegral_one, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one] at h
  rw [h]
  exact ENNReal.inv_mul_cancel (by simp) (by simp)


/-- Blueprint prop:base, proof lines 1626-1632, for one low pair: apply the predictor
approximation on both sides of the delayed replacement of the input in slot `a` (with the
high system rooted at the pair's joint birth cell `J'`), and lem:delay to each predictor.
The absolute scale sum of the replacement error, with cell coefficients of modulus at most one,
is controlled by the energies on `J'`. -/
theorem predictorDelay_group (κ : LocalKernelClass) {d e : ℕ} {A : QuadraticChartData d}
    {A' : QuadraticChartData e} {a i k b : Fin 4}
    (hai : a ≠ i) (hak : a ≠ k) (hab : a ≠ b) (hik : i ≠ k) (hib : i ≠ b) (hkb : k ≠ b)
    {B Dl ε : ℝ} {ι : Type} {L : Finset ι} {ψa ψb : ι → QuadraticChartData (d + e)}
    {lam : ι → ℝ} {coef : ι → ℝ → ℂ}
    (hP : PredictorApprox κ A A' a i k b B L ψa ψb lam coef) (hDl : 0 ≤ Dl)
    (hcard : (L.card : ℝ) ≤ Dl) (hcoef : ∀ r, ∑ ℓ ∈ L, ‖coef ℓ r‖ ≤ Dl)
    (hlam : ∀ ℓ r, coef ℓ r ≠ 0 → |lam ℓ| * r ^ 2 ≤ Dl)
    (hbdd : ∀ ℓ ∈ L, IsBoundedQuadraticChart (ψa ℓ) ∧ IsBoundedQuadraticChart (ψb ℓ))
    {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {V : Type} [Fintype V]
    (P : PathColumnSystem G J N V) {J' : ℤ × ℤ} (hJ' : J' ∈ dyadicFiniteTree G J N)
    (p : ι → V) (hp : ∀ ℓ ∈ L, p ℓ ∈ P.avail J')
    (hscal : ∀ ℓ ∈ L, ∀ y, P.scalarAt J' (p ℓ) y = conj (quadraticChartAtom (ψa ℓ) y))
    (hε : ∀ ℓ ∈ L, P.weight (p ℓ) ≤ ε)
    (f : Lp ℂ 2 (volume : Measure ℝ)) (K₀ : ℕ) (S' : Finset (ℤ × ℤ))
    (hS' : ∀ I ∈ S', I ∈ pathBelow G J N J') (hK₀ : ∀ I ∈ S', I.1 + K₀ ≤ J.1 + N)
    (w : ℤ × ℤ → ℝ × ℝ → ℂ) (hw : ∀ I ∈ S', IsAdmissibleLocalKernel κ
      (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) (w I))
    {Fb : ℝ → ℂ} {zb : ℤ × ℤ → ℝ → ℂ} {Kb : ℝ} (hKb : 0 ≤ Kb)
    (hzb : IsAdmissibleOpponent G J' Fb zb Kb) (hzbd : HasDepthEnergy G J' Fb zb Kb)
    (hzbm : ∀ I, Measurable (zb I))
    (hzb2 : ∀ I, MemLp (zb I) 2 (volume.restrict (dyadicGridCell G I.1 I.2)))
    (c : ℤ × ℤ → ℂ) (hc : ∀ I, ‖c I‖ ≤ 1) :
    ∑ I ∈ S', dyadicGridLength G I.1 * (‖c I‖ *
      ‖localProgressionForm (dyadicGridLength G I.1) (w I)
          (slots4 a i k (f : ℝ → ℂ) (quadraticChartAtom A) (quadraticChartAtom A') (zb I)) -
        localProgressionForm (dyadicGridLength G I.1) (w I)
          (slots4 a i k ((P.family J' hJ').delayed f K₀ I) (quadraticChartAtom A)
            (quadraticChartAtom A') (zb I))‖) ≤
      (2 * Real.exp (-B) * (2 * (compressionOneConst (P.rooted J') + K₀) + 1) * Kb +
        Dl ^ 2 * (delayConst κ * ((2 : ℝ)⁻¹ ^ K₀ + (1 + K₀) * Real.sqrt ε) * (1 + Dl) ^ 4 * Kb)) *
        Real.sqrt (∫ y in dyadicGridCell G J'.1 J'.2, ‖(f : ℝ → ℂ) y‖ ^ 2) *
        Real.sqrt (∫ y in dyadicGridCell G J'.1 J'.2, ‖Fb y‖ ^ 2) := by
  classical
  set Ψ := P.family J' hJ'
  set Ea := Real.sqrt (∫ y in dyadicGridCell G J'.1 J'.2, ‖(f : ℝ → ℂ) y‖ ^ 2)
  set Eb := Real.sqrt (∫ y in dyadicGridCell G J'.1 J'.2, ‖Fb y‖ ^ 2)
  have hEa : 0 ≤ Ea := Real.sqrt_nonneg _
  have hEb : 0 ≤ Eb := Real.sqrt_nonneg _
  have hsub : ∀ I ∈ S', dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J'.1 J'.2 :=
    fun I hI => ((PathColumnSystem.below_mem_iff hJ' I).mp (hS' I hI)).2
  have hcc : 0 ≤ compressionOneConst (P.rooted J') := by
    unfold compressionOneConst
    exact pow_nonneg (mul_nonneg (by positivity)
      (Real.log_nonneg (by linarith [(P.rooted J').two_le_budget]))) _
  set Kd := 2 * (compressionOneConst (P.rooted J') + K₀) + 1 with hKd
  have hK₀0 : (0 : ℝ) ≤ K₀ := Nat.cast_nonneg _
  have hKd0 : 0 ≤ Kd := by rw [hKd]; positivity
  have hKd1 : (1 : ℝ) ≤ Kd := by rw [hKd]; linarith
  -- the two opponent families in slot `a`
  set! za₁ : ℤ × ℤ → ℝ → ℂ := fun _ => (f : ℝ → ℂ)
  set za₂ : ℤ × ℤ → ℝ → ℂ := Ψ.delayed f K₀
  have hfm : Measurable (f : ℝ → ℂ) := (Lp.stronglyMeasurable f).measurable
  have hadm₁ : IsAdmissibleOpponent G J' (f : ℝ → ℂ) za₁ 1 :=
    isAdmissibleOpponent_fixed G J' ((memLp_indicator_iff_restrict
      (dyadicGridCell_measurable G J'.1 J'.2)).mpr ((Lp.memLp f).restrict _))
  have hdep₁ : HasDepthEnergy G J' (f : ℝ → ℂ) za₁ 1 :=
    hasDepthEnergy_fixed G J' ((Lp.memLp f).integrable_norm_pow two_ne_zero).integrableOn
  have hadm₂ : IsAdmissibleOpponent G J' (f : ℝ → ℂ) za₂ Kd :=
    (Ψ.delayed_admissible f K₀).mono
      (show (0 : ℝ) ≤ 2 * (compressionOneConst (P.rooted J') + K₀) by positivity)
      (show 2 * (compressionOneConst (P.rooted J') + (K₀ : ℝ)) ≤ Kd by rw [hKd]; linarith)
  have hdep₂ : HasDepthEnergy G J' (f : ℝ → ℂ) za₂ Kd :=
    (Ψ.delayed_depthEnergy f K₀).mono zero_le_one hKd1
  have hm₂ : ∀ I, Measurable (za₂ I) := fun I => measurable_column_coord _ none
  have hL₂ : ∀ I, MemLp (za₂ I) 2 (volume.restrict (dyadicGridCell G I.1 I.2)) :=
    fun I => ColumnDepthFamily.memLp_coord_restrict _ _
  set! F₁ : ℤ × ℤ → Fin 4 → ℝ → ℂ := fun I =>
    slots4 a i k (za₁ I) (quadraticChartAtom A) (quadraticChartAtom A') (zb I)
  set! F₂ : ℤ × ℤ → Fin 4 → ℝ → ℂ := fun I =>
    slots4 a i k (za₂ I) (quadraticChartAtom A) (quadraticChartAtom A') (zb I)
  have e1 := hP G J' S' hsub w hw zero_le_one hKb hadm₁ hzb hdep₁ hzbd (fun _ => hfm) hzbm
    (fun I => (Lp.memLp f).restrict _) hzb2 F₁ (fun I => slots4_a _ _ _ _)
    (fun I => slots4_i hai _ _ _ _) (fun I => slots4_k hak hik _ _ _ _)
    (fun I => slots4_b hab hib hkb _ _ _ _)
  have e2 := hP G J' S' hsub w hw hKd0 hKb hadm₂ hzb hdep₂ hzbd hm₂ hzbm hL₂ hzb2 F₂
    (fun I => slots4_a _ _ _ _) (fun I => slots4_i hai _ _ _ _)
    (fun I => slots4_k hak hik _ _ _ _) (fun I => slots4_b hab hib hkb _ _ _ _)
  -- the separated differences
  set! chirp : ι → ℝ → ℂ := fun ℓ t => (Real.fourierChar (lam ℓ * t ^ 2) : ℂ)
  set! sd : ι → ℤ × ℤ → ℂ := fun ℓ I =>
    separatedLocalForm (dyadicGridLength G I.1) (w I) (chirp ℓ) a b
        (fun y => (f : ℝ → ℂ) y * quadraticChartAtom (ψa ℓ) y)
        (fun y => quadraticChartAtom (ψb ℓ) y * zb I y) -
      separatedLocalForm (dyadicGridLength G I.1) (w I) (chirp ℓ) a b
        (fun y => za₂ I y * quadraticChartAtom (ψa ℓ) y)
        (fun y => quadraticChartAtom (ψb ℓ) y * zb I y)
  have hdelay : ∀ ℓ ∈ L, ∑ I ∈ S'.filter (fun I => coef ℓ (dyadicGridLength G I.1) ≠ 0),
      dyadicGridLength G I.1 * ‖sd ℓ I‖ ≤
        delayConst κ * ((2 : ℝ)⁻¹ ^ K₀ + (1 + K₀) * Real.sqrt ε) * (1 + Dl) ^ 4 * Ea * Kb * Eb := by
    intro ℓ hℓ
    have hscal' : ∀ y, Ψ.D.scalar (p ℓ) y = star (quadraticChartAtom (ψa ℓ) y) := fun y =>
      (P.scalar_root hJ' (hp ℓ hℓ) y).trans (hscal ℓ hℓ y)
    have hS₁ : ∀ I ∈ S'.filter (fun I => coef ℓ (dyadicGridLength G I.1) ≠ 0),
        dyadicGridCell Ψ.D.grid I.1 I.2 ⊆ dyadicGridCell Ψ.D.grid Ψ.D.root.1 Ψ.D.root.2 :=
      fun I hI => hsub I (Finset.mem_filter.mp hI).1
    have havail : ∀ I ∈ S'.filter (fun I => coef ℓ (dyadicGridLength G I.1) ≠ 0),
        ∀ c ∈ Ψ.D.cells, dyadicGridCell Ψ.D.grid c.1 c.2 ⊆ dyadicGridCell Ψ.D.grid I.1 I.2 →
          p ℓ ∈ Ψ.A.labels c := by
      intro I hI c hc _
      have hcT := (PathColumnSystem.below_mem_iff hJ' c).mp hc
      exact P.avail_mono c J' hcT.1 hJ' hcT.2 (hp ℓ hℓ)
    have h := delayedPredictorReplacement κ Ψ f (quadraticChartAtom_measurable (ψa ℓ))
      (hbdd ℓ hℓ).1 hscal' (P.weight_le (p ℓ)) _ hS₁ havail w
      (fun I hI => hw I (Finset.mem_filter.mp hI).1) hab (lam ℓ) hDl
      (fun I hI => hlam ℓ _ (Finset.mem_filter.mp hI).2)
      (quadraticChartAtom_measurable (ψb ℓ)) (hbdd ℓ hℓ).2 hKb hzb hzbm (fun I _ => hzb2 I) K₀
      (fun I hI => hK₀ I (Finset.mem_filter.mp hI).1)
    refine h.trans ?_
    have hw' : Real.sqrt (Ψ.D.privateWeight (p ℓ)) ≤ Real.sqrt ε :=
      Real.sqrt_le_sqrt (hε ℓ hℓ)
    have hdc := delayConst_nonneg κ
    have : delayConst κ * ((2 : ℝ)⁻¹ ^ K₀ + (1 + K₀) * Real.sqrt (Ψ.D.privateWeight (p ℓ))) *
        (1 + Dl) ^ 4 ≤
        delayConst κ * ((2 : ℝ)⁻¹ ^ K₀ + (1 + K₀) * Real.sqrt ε) * (1 + Dl) ^ 4 := by
      gcongr
    have hEa' : Ea = Real.sqrt (∫ y in dyadicGridCell Ψ.D.grid Ψ.D.root.1 Ψ.D.root.2,
        ‖(f : ℝ → ℂ) y‖ ^ 2) := rfl
    rw [← hEa']
    have := mul_le_mul_of_nonneg_right this hEa
    have := mul_le_mul_of_nonneg_right this hKb
    exact mul_le_mul_of_nonneg_right this hEb
  -- the per-cell decomposition
  set! T₁ : ℤ × ℤ → ℂ := fun I => localProgressionForm (dyadicGridLength G I.1) (w I) (F₁ I) -
    ∑ ℓ ∈ L, coef ℓ (dyadicGridLength G I.1) * separatedLocalForm (dyadicGridLength G I.1) (w I)
      (chirp ℓ) a b (fun y => za₁ I y * quadraticChartAtom (ψa ℓ) y)
      (fun y => zb I y * quadraticChartAtom (ψb ℓ) y)
  set! T₂ : ℤ × ℤ → ℂ := fun I => localProgressionForm (dyadicGridLength G I.1) (w I) (F₂ I) -
    ∑ ℓ ∈ L, coef ℓ (dyadicGridLength G I.1) * separatedLocalForm (dyadicGridLength G I.1) (w I)
      (chirp ℓ) a b (fun y => za₂ I y * quadraticChartAtom (ψa ℓ) y)
      (fun y => zb I y * quadraticChartAtom (ψb ℓ) y)
  have hcomm : ∀ (ℓ : ι) (I : ℤ × ℤ), (fun y => zb I y * quadraticChartAtom (ψb ℓ) y) =
      fun y => quadraticChartAtom (ψb ℓ) y * zb I y := fun ℓ I => by funext y; ring
  have hdec : ∀ I, localProgressionForm (dyadicGridLength G I.1) (w I) (F₁ I) -
      localProgressionForm (dyadicGridLength G I.1) (w I) (F₂ I) =
        T₁ I - T₂ I + ∑ ℓ ∈ L, coef ℓ (dyadicGridLength G I.1) * sd ℓ I := by
    intro I
    simp only [T₁, T₂, sd, hcomm, za₁]
    have hs : ∀ (u v : ι → ℂ), ∑ ℓ ∈ L, coef ℓ (dyadicGridLength G I.1) * (u ℓ - v ℓ) =
        ∑ ℓ ∈ L, coef ℓ (dyadicGridLength G I.1) * u ℓ -
          ∑ ℓ ∈ L, coef ℓ (dyadicGridLength G I.1) * v ℓ := fun u v => by
      rw [← Finset.sum_sub_distrib]; congr 1; funext ℓ; ring
    rw [hs]
    ring
  have hcell : ∀ I, ‖c I‖ * ‖localProgressionForm (dyadicGridLength G I.1) (w I) (F₁ I) -
      localProgressionForm (dyadicGridLength G I.1) (w I) (F₂ I)‖ ≤
        ‖T₁ I‖ + ‖T₂ I‖ + ∑ ℓ ∈ L, ‖coef ℓ (dyadicGridLength G I.1)‖ * ‖sd ℓ I‖ := by
    intro I
    rw [hdec]
    calc ‖c I‖ * ‖T₁ I - T₂ I + ∑ ℓ ∈ L, coef ℓ (dyadicGridLength G I.1) * sd ℓ I‖
        ≤ 1 * ‖T₁ I - T₂ I + ∑ ℓ ∈ L, coef ℓ (dyadicGridLength G I.1) * sd ℓ I‖ :=
          mul_le_mul_of_nonneg_right (hc I) (norm_nonneg _)
      _ ≤ ‖T₁ I‖ + ‖T₂ I‖ + ∑ ℓ ∈ L, ‖coef ℓ (dyadicGridLength G I.1)‖ * ‖sd ℓ I‖ := by
          rw [one_mul]
          refine (norm_add_le _ _).trans (add_le_add (norm_sub_le _ _) ?_)
          refine (norm_sum_le _ _).trans (le_of_eq ?_)
          simp only [norm_mul]
  -- the separated sums
  have hsep : ∑ I ∈ S', dyadicGridLength G I.1 *
      ∑ ℓ ∈ L, ‖coef ℓ (dyadicGridLength G I.1)‖ * ‖sd ℓ I‖ ≤
        Dl ^ 2 * (delayConst κ * ((2 : ℝ)⁻¹ ^ K₀ + (1 + K₀) * Real.sqrt ε) * (1 + Dl) ^ 4 *
          Ea * Kb * Eb) := by
    have hX : 0 ≤ delayConst κ * ((2 : ℝ)⁻¹ ^ K₀ + (1 + K₀) * Real.sqrt ε) * (1 + Dl) ^ 4 *
        Ea * Kb * Eb := by
      have := delayConst_nonneg κ; positivity
    calc ∑ I ∈ S', dyadicGridLength G I.1 *
          ∑ ℓ ∈ L, ‖coef ℓ (dyadicGridLength G I.1)‖ * ‖sd ℓ I‖
        = ∑ ℓ ∈ L, ∑ I ∈ S', dyadicGridLength G I.1 *
            (‖coef ℓ (dyadicGridLength G I.1)‖ * ‖sd ℓ I‖) := by
          simp only [Finset.mul_sum]; exact Finset.sum_comm
      _ ≤ ∑ ℓ ∈ L, Dl * (delayConst κ * ((2 : ℝ)⁻¹ ^ K₀ + (1 + K₀) * Real.sqrt ε) *
            (1 + Dl) ^ 4 * Ea * Kb * Eb) := by
          refine Finset.sum_le_sum fun ℓ hℓ => ?_
          rw [← Finset.sum_filter_add_sum_filter_not S'
            (fun I => coef ℓ (dyadicGridLength G I.1) ≠ 0)]
          have h0 : ∑ I ∈ S'.filter (fun I => ¬ coef ℓ (dyadicGridLength G I.1) ≠ 0),
              dyadicGridLength G I.1 * (‖coef ℓ (dyadicGridLength G I.1)‖ * ‖sd ℓ I‖) = 0 :=
            Finset.sum_eq_zero fun I hI => by
              rw [not_not.mp (Finset.mem_filter.mp hI).2]; simp
          rw [h0, add_zero]
          calc ∑ I ∈ S'.filter (fun I => coef ℓ (dyadicGridLength G I.1) ≠ 0),
                dyadicGridLength G I.1 * (‖coef ℓ (dyadicGridLength G I.1)‖ * ‖sd ℓ I‖)
              ≤ ∑ I ∈ S'.filter (fun I => coef ℓ (dyadicGridLength G I.1) ≠ 0),
                Dl * (dyadicGridLength G I.1 * ‖sd ℓ I‖) := by
                refine Finset.sum_le_sum fun I _ => ?_
                have hle : ‖coef ℓ (dyadicGridLength G I.1)‖ ≤ Dl :=
                  (Finset.single_le_sum (f := fun ℓ => ‖coef ℓ (dyadicGridLength G I.1)‖)
                    (fun _ _ => norm_nonneg _) hℓ).trans (hcoef _)
                have hL0 := (dyadicGridLength_pos G I.1).le
                nlinarith only [norm_nonneg (sd ℓ I), mul_nonneg hL0 (norm_nonneg (sd ℓ I)), hle]
            _ = Dl * ∑ I ∈ S'.filter (fun I => coef ℓ (dyadicGridLength G I.1) ≠ 0),
                dyadicGridLength G I.1 * ‖sd ℓ I‖ := by rw [Finset.mul_sum]
            _ ≤ _ := mul_le_mul_of_nonneg_left (hdelay ℓ hℓ) hDl
      _ = L.card * (Dl * (delayConst κ * ((2 : ℝ)⁻¹ ^ K₀ + (1 + K₀) * Real.sqrt ε) *
            (1 + Dl) ^ 4 * Ea * Kb * Eb)) := by rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ Dl * (Dl * (delayConst κ * ((2 : ℝ)⁻¹ ^ K₀ + (1 + K₀) * Real.sqrt ε) *
            (1 + Dl) ^ 4 * Ea * Kb * Eb)) :=
          mul_le_mul_of_nonneg_right hcard (mul_nonneg hDl hX)
      _ = _ := by ring
  -- assemble
  have hT₁ : ∑ I ∈ S', dyadicGridLength G I.1 * ‖T₁ I‖ ≤ Real.exp (-B) * 1 * Kb * Ea * Eb := e1
  have hT₂ : ∑ I ∈ S', dyadicGridLength G I.1 * ‖T₂ I‖ ≤ Real.exp (-B) * Kd * Kb * Ea * Eb := e2
  calc ∑ I ∈ S', dyadicGridLength G I.1 * (‖c I‖ *
        ‖localProgressionForm (dyadicGridLength G I.1) (w I) (F₁ I) -
          localProgressionForm (dyadicGridLength G I.1) (w I) (F₂ I)‖)
      ≤ ∑ I ∈ S', (dyadicGridLength G I.1 * ‖T₁ I‖ + dyadicGridLength G I.1 * ‖T₂ I‖ +
          dyadicGridLength G I.1 * ∑ ℓ ∈ L, ‖coef ℓ (dyadicGridLength G I.1)‖ * ‖sd ℓ I‖) := by
        refine Finset.sum_le_sum fun I _ => ?_
        have := mul_le_mul_of_nonneg_left (hcell I) (dyadicGridLength_pos G I.1).le
        linarith
    _ = ∑ I ∈ S', dyadicGridLength G I.1 * ‖T₁ I‖ + ∑ I ∈ S', dyadicGridLength G I.1 * ‖T₂ I‖ +
          ∑ I ∈ S', dyadicGridLength G I.1 *
            ∑ ℓ ∈ L, ‖coef ℓ (dyadicGridLength G I.1)‖ * ‖sd ℓ I‖ := by
        rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
    _ ≤ Real.exp (-B) * 1 * Kb * Ea * Eb + Real.exp (-B) * Kd * Kb * Ea * Eb +
          Dl ^ 2 * (delayConst κ * ((2 : ℝ)⁻¹ ^ K₀ + (1 + K₀) * Real.sqrt ε) * (1 + Dl) ^ 4 *
            Ea * Kb * Eb) := add_le_add (add_le_add hT₁ hT₂) hsep
    _ ≤ _ := by
        have hexp := (Real.exp_pos (-B)).le
        have h1 : Real.exp (-B) * 1 * Kb * Ea * Eb + Real.exp (-B) * Kd * Kb * Ea * Eb ≤
            2 * Real.exp (-B) * Kd * Kb * Ea * Eb := by
          have : Real.exp (-B) * 1 * Kb * Ea * Eb ≤ Real.exp (-B) * Kd * Kb * Ea * Eb := by
            have hK1 : (1 : ℝ) ≤ Kd := hKd1
            have := mul_nonneg (mul_nonneg (mul_nonneg hexp hKb) hEa) hEb
            nlinarith only [hcc, hKd, this]
          linarith
        have h2 : 2 * Real.exp (-B) * Kd * Kb * Ea * Eb + Dl ^ 2 * (delayConst κ *
            ((2 : ℝ)⁻¹ ^ K₀ + (1 + K₀) * Real.sqrt ε) * (1 + Dl) ^ 4 * Ea * Kb * Eb) =
            (2 * Real.exp (-B) * Kd * Kb + Dl ^ 2 * (delayConst κ * ((2 : ℝ)⁻¹ ^ K₀ +
              (1 + K₀) * Real.sqrt ε) * (1 + Dl) ^ 4 * Kb)) * Ea * Eb := by ring
        linarith

namespace PathColumnSystem
variable {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {V : Type} [Fintype V]
  (P : PathColumnSystem G J N V)

/-- On a partition cell, the depth projection of any rooted family is the system projection. -/
theorem family_proj_ae {R Q : ℤ × ℤ} (hR : R ∈ dyadicFiniteTree G J N) (h : ℤ)
    (hQ : Q ∈ ((P.family R hR).partition h).cells) (z : ColumnL2 V) :
    ((P.family R hR).proj h z : ℝ → ColumnHilbert V) =ᵐ[volume.restrict
      (dyadicGridCell G Q.1 Q.2)] (P.proj Q z : ℝ → ColumnHilbert V) := by
  have h1 := (P.family R hR).proj_ae_cell h z hQ
  have h2 : cellColumnProjection (P.family R hR).D (P.family R hR).A
      (((P.family R hR).partition h).subset hQ) = P.proj Q :=
    P.rooted_proj hR (((P.family R hR).partition h).subset hQ)
  rw [h2] at h1
  exact h1

/-- Delayed opponents of two rooted families agree a.e. on common cells. -/
theorem delayed_ae {R R' I : ℤ × ℤ} (hR : R ∈ dyadicFiniteTree G J N)
    (hR' : R' ∈ dyadicFiniteTree G J N) (f : Lp ℂ 2 (volume : Measure ℝ)) (K₀ : ℕ)
    (hIR : I ∈ pathBelow G J N R) (hIR' : I ∈ pathBelow G J N R')
    (hK₀ : I.1 + K₀ ≤ J.1 + N) :
    ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 →
      (P.family R hR).delayed f K₀ I y = (P.family R' hR').delayed f K₀ I y := by
  classical
  set z := physicalColumnInput (V := V) f
  have hI := (below_mem_iff hR I).mp hIR
  have hI' := (below_mem_iff hR' I).mp hIR'
  set gen := dyadicGeneration G I K₀
  have hgenR : ∀ Q ∈ gen, Q ∈ ((P.family R hR).partition (I.1 + K₀)).cells := by
    intro Q hQ
    refine ((P.family R hR).mem_partition _ Q).mpr ⟨?_, (dyadicGeneration_subset G I K₀ hQ).trans
      hI.2⟩
    have := dyadicGeneration_depth G I K₀ hQ
    have hRl := dyadicGridCell_depth_le_of_subset G I R hI.2
    simp only [ColumnDepthFamily.depth, family, rooted]
    omega
  have hgenR' : ∀ Q ∈ gen, Q ∈ ((P.family R' hR').partition (I.1 + K₀)).cells := by
    intro Q hQ
    refine ((P.family R' hR').mem_partition _ Q).mpr ⟨?_,
      (dyadicGeneration_subset G I K₀ hQ).trans hI'.2⟩
    have := dyadicGeneration_depth G I K₀ hQ
    have hRl := dyadicGridCell_depth_le_of_subset G I R' hI'.2
    simp only [ColumnDepthFamily.depth, family, rooted]
    omega
  have hall : ∀ᵐ y ∂volume, ∀ Q ∈ gen, y ∈ dyadicGridCell G Q.1 Q.2 →
      ((P.family R hR).proj (I.1 + K₀) z : ℝ → ColumnHilbert V) y =
        ((P.family R' hR').proj (I.1 + K₀) z : ℝ → ColumnHilbert V) y := by
    refine (Filter.eventually_all_finset gen).mpr fun Q hQ => ?_
    have h1 := P.family_proj_ae hR _ (hgenR Q hQ) z
    have h2 := P.family_proj_ae hR' _ (hgenR' Q hQ) z
    rw [Filter.EventuallyEq, ae_restrict_iff' (dyadicGridCell_measurable _ _ _)] at h1 h2
    filter_upwards [h1, h2] with y hy1 hy2 hyQ
    rw [hy1 hyQ, hy2 hyQ]
  filter_upwards [hall] with y hy hyI
  obtain ⟨Q, hQ, hyQ⟩ := dyadicGeneration_cover G I K₀ hyI
  unfold ColumnDepthFamily.delayed
  rw [hy Q hQ hyQ]

end PathColumnSystem

/-- A low list on the tree below `R` (blueprint prop:base, lines 1626-1630): cellwise
coefficients of modulus at most one on labels available at the cell, availability inherited along
paths, and atoms given by bounded charts fixed below canonical birth cells (each label's birth
cells along different paths are equal or disjoint). -/
structure LowList (G : RealDyadicGrid) (J : ℤ × ℤ) (N : ℕ) (R : ℤ × ℤ) (c₀ : ℕ) (H : ℝ) where
  /-- Finite label type for the low-argument catalog. -/
  Λ : Type
  [fin : Fintype Λ]
  /-- Cell-dependent coefficient of each low catalog atom. -/
  coef : ℤ × ℤ → Λ → ℂ
  coef_le : ∀ I l, ‖coef I l‖ ≤ 1
  /-- Predicate recording which low catalog labels are available at a cell. -/
  avail : ℤ × ℤ → Λ → Prop
  coef_avail : ∀ I l, coef I l ≠ 0 → avail I l
  avail_mono : ∀ c d l, c ∈ dyadicFiniteTree G J N → d ∈ dyadicFiniteTree G J N →
    dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 → avail d l → avail c l
  /-- Birth cell of a catalog label as viewed from the current cell. -/
  birth : ℤ × ℤ → Λ → ℤ × ℤ
  /-- Dimension of the quadratic chart assigned at a birth cell. -/
  dim : ℤ × ℤ → Λ → ℕ
  /-- Quadratic chart realizing the catalog atom at its birth cell. -/
  chart : (K : ℤ × ℤ) → (l : Λ) → QuadraticChartData (dim K l)
  birth_spec : ∀ I l, avail I l →
    dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G (birth I l).1 (birth I l).2 ∧
      birth I l ∈ dyadicFiniteTree G J N ∧
      dyadicGridCell G (birth I l).1 (birth I l).2 ⊆ dyadicGridCell G R.1 R.2
  avail_birth : ∀ I l, avail I l → avail (birth I l) l
  birth_canon' : ∀ I₁ I₂ l, avail I₁ l → avail I₂ l →
    ¬ Disjoint (dyadicGridCell G (birth I₁ l).1 (birth I₁ l).2)
      (dyadicGridCell G (birth I₂ l).1 (birth I₂ l).2) → birth I₁ l = birth I₂ l
  one_le_dim : ∀ K l, 1 ≤ dim K l
  complexity : ∀ K l, QuadraticChartComplexity c₀ H (chart K l)
  bounded : ∀ K l, IsBoundedQuadraticChart (chart K l)

theorem LowList.birth_sub {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {R : ℤ × ℤ} {c₀ : ℕ}
    {H : ℝ} (X : LowList G J N R c₀ H) (I : ℤ × ℤ) (l : X.Λ) (h : X.coef I l ≠ 0) :
    dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G (X.birth I l).1 (X.birth I l).2 ∧
      X.birth I l ∈ dyadicFiniteTree G J N ∧
      dyadicGridCell G (X.birth I l).1 (X.birth I l).2 ⊆ dyadicGridCell G R.1 R.2 :=
  X.birth_spec I l (X.coef_avail I l h)

theorem LowList.birth_canon {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {R : ℤ × ℤ} {c₀ : ℕ}
    {H : ℝ} (X : LowList G J N R c₀ H) (I₁ I₂ : ℤ × ℤ) (l : X.Λ) (h₁ : X.coef I₁ l ≠ 0)
    (h₂ : X.coef I₂ l ≠ 0)
    (hnd : ¬ Disjoint (dyadicGridCell G (X.birth I₁ l).1 (X.birth I₁ l).2)
      (dyadicGridCell G (X.birth I₂ l).1 (X.birth I₂ l).2)) : X.birth I₁ l = X.birth I₂ l :=
  X.birth_canon' I₁ I₂ l (X.coef_avail I₁ l h₁) (X.coef_avail I₂ l h₂) hnd

attribute [instance] LowList.fin

namespace LowList
variable {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {R : ℤ × ℤ} {c₀ : ℕ} {H : ℝ}
  (X : LowList G J N R c₀ H)

/-- The atom of label `l` at the cell `I`. -/
noncomputable def atom (I : ℤ × ℤ) (l : X.Λ) : ℝ → ℂ := quadraticChartAtom (X.chart (X.birth I l) l)

/-- The low argument `X(I) = Σ_l c_{I,l} φ_{I,l}`. -/
noncomputable def val (I : ℤ × ℤ) (y : ℝ) : ℂ := ∑ l, X.coef I l * X.atom I l y

theorem atom_measurable (I : ℤ × ℤ) (l : X.Λ) : Measurable (X.atom I l) :=
  quadraticChartAtom_measurable _

theorem atom_bound (I : ℤ × ℤ) (l : X.Λ) (y : ℝ) : ‖X.atom I l y‖ ≤ 1 := X.bounded _ _ y

theorem val_measurable (I : ℤ × ℤ) : Measurable (X.val I) :=
  Finset.measurable_sum _ fun l _ => measurable_const.mul (X.atom_measurable I l)

end LowList

theorem slots4_update_i {a i k : Fin 4} (hai : a ≠ i) (hik : i ≠ k) (za φ φ' zb : ℝ → ℂ) :
    slots4 a i k za φ φ' zb = Function.update (slots4 a i k za 0 φ' zb) i φ := by
  funext l
  by_cases hl : l = i
  · subst hl; rw [Function.update_self, slots4_i hai]
  · rw [Function.update_of_ne hl]
    simp [slots4, hl]

theorem slots4_update_k {a i k : Fin 4} (hak : a ≠ k) (hik : i ≠ k) (za φ φ' zb : ℝ → ℂ) :
    slots4 a i k za φ φ' zb = Function.update (slots4 a i k za φ 0 zb) k φ' := by
  funext l
  by_cases hl : l = k
  · subst hl; rw [Function.update_self, slots4_k hak hik]
  · rw [Function.update_of_ne hl]
    simp [slots4, hl]

/-- Bilinear expansion of a local form over finite combinations in two slots. -/
theorem localProgressionForm_slots4_expand {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a i k : Fin 4}
    (hai : a ≠ i) (hak : a ≠ k) (hik : i ≠ k)
    {za zb : ℝ → ℂ} (hza : FinL2 a₀ r za) (hzb : FinL2 a₀ r zb)
    {Λ Λ' : Type} [Fintype Λ] [Fintype Λ'] (c : Λ → ℂ) (c' : Λ' → ℂ) (φ : Λ → ℝ → ℂ)
    (φ' : Λ' → ℝ → ℂ) (hφ : ∀ l, FinL2 a₀ r (φ l)) (hφ' : ∀ l, FinL2 a₀ r (φ' l)) :
    localProgressionForm r w (slots4 a i k za (fun y => ∑ l, c l * φ l y)
        (fun y => ∑ l, c' l * φ' l y) zb) =
      ∑ l, ∑ l', c l * c' l' * localProgressionForm r w (slots4 a i k za (φ l) (φ' l') zb) := by
  have hsum : ∀ (Ξ : Type) [Fintype Ξ] (d : Ξ → ℂ) (ψ : Ξ → ℝ → ℂ), (∀ l, FinL2 a₀ r (ψ l)) →
      FinL2 a₀ r (fun y => ∑ l, d l * ψ l y) := by
    intro Ξ _ d ψ hψ
    refine ⟨Finset.measurable_sum _ fun l _ => measurable_const.mul (hψ l).1, ?_⟩
    have hm : MemLp (fun y => ∑ l, d l * ψ l y) 2 (normalizedIntervalMeasure a₀ r) :=
      memLp_finsetSum _ fun l _ => (MemLp.const_mul (show MemLp (ψ l) 2
        (normalizedIntervalMeasure a₀ r) from (hψ l).2.lt_top) (d l))
    exact hm.eLpNorm_ne_top
  have hslots : ∀ (u v : ℝ → ℂ), FinL2 a₀ r u → FinL2 a₀ r v →
      ∀ l, FinL2 a₀ r (slots4 a i k za u v zb l) := by
    intro u v hu hv l
    unfold slots4
    split_ifs
    · exact hza
    · exact hu
    · exact hv
    · exact hzb
  have hX' := hsum Λ' c' φ' hφ'
  rw [slots4_update_i hai hik, localProgressionForm_update_sum hr hw
    (fun l => (hslots 0 _ FinL2.zero hX' l).1) (fun l => (hslots 0 _ FinL2.zero hX' l).2) i
    Finset.univ c φ (fun l => (hφ l).1) (fun l => (hφ l).2)]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [← slots4_update_i hai hik, slots4_update_k hak hik,
    localProgressionForm_update_sum hr hw
      (fun m => (hslots _ 0 (hφ l) FinL2.zero m).1) (fun m => (hslots _ 0 (hφ l) FinL2.zero m).2)
      k Finset.univ c' φ' (fun m => (hφ' m).1) (fun m => (hφ' m).2), Finset.mul_sum]
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [← slots4_update_k hak hik]
  ring

/-! ### Assembly of the delayed replacement over all low pairs -/

theorem sum_sqrt_energy_le {G : RealDyadicGrid} {R : ℤ × ℤ} (T : Finset (ℤ × ℤ))
    (hT : (T : Set (ℤ × ℤ)).PairwiseDisjoint (fun c => dyadicGridCell G c.1 c.2))
    (hTR : ∀ c ∈ T, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G R.1 R.2) {F₁ F₂ : ℝ → ℂ}
    (h₁ : IntegrableOn (fun y => ‖F₁ y‖ ^ 2) (dyadicGridCell G R.1 R.2))
    (h₂ : IntegrableOn (fun y => ‖F₂ y‖ ^ 2) (dyadicGridCell G R.1 R.2)) :
    ∑ c ∈ T, Real.sqrt (∫ y in dyadicGridCell G c.1 c.2, ‖F₁ y‖ ^ 2) *
        Real.sqrt (∫ y in dyadicGridCell G c.1 c.2, ‖F₂ y‖ ^ 2) ≤
      Real.sqrt (∫ y in dyadicGridCell G R.1 R.2, ‖F₁ y‖ ^ 2) *
        Real.sqrt (∫ y in dyadicGridCell G R.1 R.2, ‖F₂ y‖ ^ 2) := by
  have hsum : ∀ {F : ℝ → ℂ}, IntegrableOn (fun y => ‖F y‖ ^ 2) (dyadicGridCell G R.1 R.2) →
      ∑ c ∈ T, ∫ y in dyadicGridCell G c.1 c.2, ‖F y‖ ^ 2 ≤
        ∫ y in dyadicGridCell G R.1 R.2, ‖F y‖ ^ 2 := by
    intro F hF
    rw [← integral_biUnion_finset T (fun c _ => dyadicGridCell_measurable _ _ _) hT
      (fun c hc => hF.mono_set (hTR c hc))]
    exact setIntegral_mono_set hF (Filter.Eventually.of_forall fun _ => by positivity)
      (Filter.Eventually.of_forall (Set.iUnion₂_subset fun c hc => hTR c hc))
  refine (Real.sum_sqrt_mul_sqrt_le T (fun c => integral_nonneg fun _ => by positivity)
    (fun c => integral_nonneg fun _ => by positivity)).trans ?_
  exact mul_le_mul (Real.sqrt_le_sqrt (hsum h₁)) (Real.sqrt_le_sqrt (hsum h₂))
    (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)

theorem finL2_of_memLp_cell {G : RealDyadicGrid} {I : ℤ × ℤ} {g : ℝ → ℂ} (hg : Measurable g)
    (h : MemLp g 2 (volume.restrict (dyadicGridCell G I.1 I.2))) :
    FinL2 (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) g :=
  ⟨hg, eLpNorm_normalized_ne_top h⟩

/-- The joint birth cell of a low pair at `I`: the deeper of the two birth cells. -/
noncomputable def jointBirth {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {R : ℤ × ℤ} {c₀ : ℕ}
    {H : ℝ} (Xi Xk : LowList G J N R c₀ H) (I : ℤ × ℤ) (li : Xi.Λ) (lk : Xk.Λ) : ℤ × ℤ :=
  if (Xi.birth I li).1 ≤ (Xk.birth I lk).1 then Xk.birth I lk else Xi.birth I li

section JointBirth
variable {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {R : ℤ × ℤ} {c₀ : ℕ} {H : ℝ}
  (Xi Xk : LowList G J N R c₀ H)

theorem jointBirth_spec {I : ℤ × ℤ} {li : Xi.Λ} {lk : Xk.Λ} (hi : Xi.coef I li ≠ 0)
    (hk : Xk.coef I lk ≠ 0) :
    dyadicGridCell G I.1 I.2 ⊆
        dyadicGridCell G (jointBirth Xi Xk I li lk).1 (jointBirth Xi Xk I li lk).2 ∧
      jointBirth Xi Xk I li lk ∈ dyadicFiniteTree G J N ∧
      dyadicGridCell G (jointBirth Xi Xk I li lk).1 (jointBirth Xi Xk I li lk).2 ⊆
        dyadicGridCell G (Xi.birth I li).1 (Xi.birth I li).2 ∧
      dyadicGridCell G (jointBirth Xi Xk I li lk).1 (jointBirth Xi Xk I li lk).2 ⊆
        dyadicGridCell G (Xk.birth I lk).1 (Xk.birth I lk).2 := by
  obtain ⟨hIi, hTi, -⟩ := Xi.birth_sub I li hi
  obtain ⟨hIk, hTk, -⟩ := Xk.birth_sub I lk hk
  have hy := dyadicGridCell_left_mem G I.1 I.2
  unfold jointBirth
  split_ifs with h
  · exact ⟨hIk, hTk, dyadicGridCell_subset_of_common_point G (hIk hy) (hIi hy) h, subset_rfl⟩
  · exact ⟨hIi, hTi, subset_rfl,
      dyadicGridCell_subset_of_common_point G (hIi hy) (hIk hy) (by omega)⟩

theorem jointBirth_canon {I₁ I₂ : ℤ × ℤ} {li : Xi.Λ} {lk : Xk.Λ} (hi₁ : Xi.coef I₁ li ≠ 0)
    (hk₁ : Xk.coef I₁ lk ≠ 0) (hi₂ : Xi.coef I₂ li ≠ 0) (hk₂ : Xk.coef I₂ lk ≠ 0)
    (hnd : ¬ Disjoint
      (dyadicGridCell G (jointBirth Xi Xk I₁ li lk).1 (jointBirth Xi Xk I₁ li lk).2)
      (dyadicGridCell G (jointBirth Xi Xk I₂ li lk).1 (jointBirth Xi Xk I₂ li lk).2)) :
    Xi.birth I₁ li = Xi.birth I₂ li ∧ Xk.birth I₁ lk = Xk.birth I₂ lk := by
  obtain ⟨-, -, h1i, h1k⟩ := jointBirth_spec Xi Xk hi₁ hk₁
  obtain ⟨-, -, h2i, h2k⟩ := jointBirth_spec Xi Xk hi₂ hk₂
  obtain ⟨y, hy1, hy2⟩ := Set.not_disjoint_iff.mp hnd
  exact ⟨Xi.birth_canon I₁ I₂ li hi₁ hi₂ (Set.not_disjoint_iff.mpr ⟨y, h1i hy1, h2i hy2⟩),
    Xk.birth_canon I₁ I₂ lk hk₁ hk₂ (Set.not_disjoint_iff.mpr ⟨y, h1k hy1, h2k hy2⟩)⟩

theorem jointBirth_eq_of {I₁ I₂ : ℤ × ℤ} {li : Xi.Λ} {lk : Xk.Λ}
    (h : Xi.birth I₁ li = Xi.birth I₂ li ∧ Xk.birth I₁ lk = Xk.birth I₂ lk) :
    jointBirth Xi Xk I₁ li lk = jointBirth Xi Xk I₂ li lk := by
  unfold jointBirth; rw [h.1, h.2]

end JointBirth

/-- Predictor cover of a low pair: a predictor list for its two charts whose conjugate
predictors are available labels of the high system at the joint birth cell. -/
def PredictorCover (κ : LocalKernelClass) {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {V : Type}
    [Fintype V] (P : PathColumnSystem G J N V) (a i k b : Fin 4) (B Dl ε : ℝ) {d e : ℕ}
    (A : QuadraticChartData d) (A' : QuadraticChartData e) (J' : ℤ × ℤ) : Prop :=
  ∃ (ι : Type) (L : Finset ι) (ψa ψb : ι → QuadraticChartData (d + e)) (lam : ι → ℝ)
    (coef : ι → ℝ → ℂ) (p : ι → V),
    PredictorApprox κ A A' a i k b B L ψa ψb lam coef ∧ (L.card : ℝ) ≤ Dl ∧
    (∀ r, ∑ ℓ ∈ L, ‖coef ℓ r‖ ≤ Dl) ∧ (∀ ℓ r, coef ℓ r ≠ 0 → |lam ℓ| * r ^ 2 ≤ Dl) ∧
    (∀ ℓ ∈ L, IsBoundedQuadraticChart (ψa ℓ) ∧ IsBoundedQuadraticChart (ψb ℓ)) ∧
    (∀ ℓ ∈ L, p ℓ ∈ P.avail J' ∧
      ∀ y, P.scalarAt J' (p ℓ) y = conj (quadraticChartAtom (ψa ℓ) y)) ∧
    ∀ ℓ ∈ L, P.weight (p ℓ) ≤ ε

theorem slots4_update_a {a i k : Fin 4} (za φ φ' zb : ℝ → ℂ) :
    slots4 a i k za φ φ' zb = Function.update (slots4 a i k 0 φ φ' zb) a za := by
  funext l
  by_cases hl : l = a
  · subst hl; rw [Function.update_self, slots4_a]
  · rw [Function.update_of_ne hl]
    simp [slots4, hl]

theorem ae_normalized_of_cell {a r : ℝ} {p : ℝ → Prop}
    (h : ∀ᵐ y ∂volume, y ∈ Set.Ico a (a + r) → p y) :
    ∀ᵐ y ∂normalizedIntervalMeasure a r, p y := by
  unfold normalizedIntervalMeasure
  refine Measure.ae_smul_measure ?_ _
  rw [← Measure.restrict_congr_set Ico_ae_eq_Icc, ae_restrict_iff' measurableSet_Ico]
  exact h




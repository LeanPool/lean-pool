/-- The adaptive fits as opponents (blueprint prop:base, line 1630, and lem:compression): for each
attempt root `K` there is one opponent, equal to the fit on the cells of the segment of `K`, which
is admissible with depth energy one on every tree cell below `K`; it is the physical part of the
current projections `g_I = P_I F` of a column depth family rooted at `K` applied to the input
`F = 1_J f` (blueprint line 1570), whose column budget (eq:columnbudget: inverse square-root
private weights, path counts and column bounds) is at most `Bd` and whose columns available on a
tree cell below `K` are bounded quadratic chart atoms of order `c` and complexity at most `Hc` on
that cell (the fit atoms, line 1575). -/
def IsFitOpponent (G : RealDyadicGrid) (J : ℤ × ℤ) (N : ℕ) (f : ℝ → ℂ)
    (roots : Finset (ℤ × ℤ)) (seg : ℤ × ℤ → ℤ × ℤ) (g : ℤ × ℤ → ℝ → ℂ) (C Bd : ℝ) (c : ℕ)
    (Hc : ℝ) : Prop :=
  ∀ K ∈ roots, ∃ z : ℤ × ℤ → ℝ → ℂ,
    (∀ I, Measurable (z I) ∧ MemLp (z I) 2 (volume.restrict (dyadicGridCell G I.1 I.2))) ∧
    (∀ I ∈ dyadicFiniteTree G J N, seg I = K →
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 → z I y = g I y) ∧
    (∀ J' ∈ dyadicFiniteTree G J N, dyadicGridCell G J'.1 J'.2 ⊆ dyadicGridCell G K.1 K.2 →
      IsAdmissibleOpponent G J' f z C ∧ HasDepthEnergy G J' f z 1) ∧
    ∃ (V : Type) (_ : Fintype V) (Ψ : ColumnDepthFamily V) (F : Lp ℂ 2 (volume : Measure ℝ)),
      Ψ.D.grid = G ∧ Ψ.D.root = K ∧ Ψ.D.budget ≤ Bd ∧
      (∀ c' ∈ dyadicFiniteTree G J N, dyadicGridCell G c'.1 c'.2 ⊆ dyadicGridCell G K.1 K.2 →
        c' ∈ Ψ.D.cells ∧ c'.1 ≤ Ψ.N ∧ ∀ v ∈ Ψ.A.labels c', ∃ (d : ℕ) (Φ : QuadraticChartData d),
          QuadraticChartComplexity c Hc Φ ∧ IsBoundedQuadraticChart Φ ∧
          ∀ y ∈ dyadicGridCell G c'.1 c'.2, Ψ.D.scalar v y = quadraticChartAtom Φ y) ∧
      (∀ I, z I = Ψ.current F I) ∧
      (F : ℝ → ℂ) =ᵐ[volume] (dyadicGridCell G J.1 J.2).indicator f

namespace FitSetup
variable {S : FitSetup}

theorem compressionOneConst_treeData (K R : ℤ × ℤ) :
    compressionOneConst (S.treeData K R) = fitOpponentConst S.M := by
  unfold compressionOneConst fitOpponentConst
  rfl

theorem Hyp.isFitOpponent (h : S.Hyp) :
    IsFitOpponent S.G S.J S.N S.f S.roots S.seg S.g (fitOpponentConst S.M) (max 2 (S.M : ℝ)) S.c₂
      S.B := by
  classical
  intro K hK
  have hKT := h.roots_mem hK
  set Ψ := S.depthFamily K K hKT le_rfl with hΨ
  -- the available columns are the fit atoms of their cells
  have hcharts : ∀ c' ∈ dyadicFiniteTree S.G S.J S.N, S.cell c' ⊆ S.cell K →
      c' ∈ Ψ.D.cells ∧ c'.1 ≤ Ψ.N ∧ ∀ v ∈ Ψ.A.labels c', ∃ (d : ℕ) (Φ : QuadraticChartData d),
        QuadraticChartComplexity S.c₂ S.B Φ ∧ IsBoundedQuadraticChart Φ ∧
        ∀ y ∈ S.cell c', Ψ.D.scalar v y = quadraticChartAtom Φ y := by
    intro c' hc' hc'K
    have hsub : c' ∈ S.sub K := (sub_mem_iff hKT c').mpr ⟨hc', hc'K⟩
    refine ⟨hsub, ((dyadicFiniteTree_mem_iff S.G S.J c' S.N).mp hc').2, fun v hv => ?_⟩
    have hv' : (v : ℕ) < S.count K c' := by
      change v ∈ Finset.univ.filter (fun v : Fin S.M => (v : ℕ) < S.count K c') at hv
      simpa using hv
    obtain ⟨p, h1, h2, h3⟩ := h.atoms_good ((c'.1 - K.1).toNat) c' v hv'
    refine ⟨p.1, p.2, h1, h2, fun y hy => ?_⟩
    change S.scalar K v y = _
    unfold FitSetup.scalar
    simp only [hc'K hy, ↓reduceIte]
    rw [atoms_leaf hKT hsub hy hv']
    change (S.state (c'.1 - K.1).toNat c').1 v y = _
    rw [h3]
  set z : ℤ × ℤ → ℝ → ℂ := fun I => Ψ.current S.input I with hz
  -- the current projections of the attempt rooted at `K` do not depend on the family root
  have hroot : ∀ (J' : ℤ × ℤ) (hJ' : J' ∈ dyadicFiniteTree S.G S.J S.N)
      (hJ'K : S.cell J' ⊆ S.cell K), ∀ I, S.cell I ⊆ S.cell J' →
      (S.depthFamily K J' hJ' (dyadicGridCell_depth_le_of_subset S.G J' K hJ'K)).current
        S.input I = z I := by
    intro J' hJ' hJ'K I hI
    set Ψ' := S.depthFamily K J' hJ' (dyadicGridCell_depth_le_of_subset S.G J' K hJ'K)
    have hm' : Ψ'.anc I ∈ Ψ'.D.cells := Ψ'.anc_mem hI
    have hm : Ψ.anc I ∈ Ψ.D.cells := Ψ.anc_mem (hI.trans hJ'K)
    have hanc : Ψ'.anc I = Ψ.anc I := rfl
    rw [Ψ'.current_of_mem S.input hm']
    change _ = Ψ.current S.input I
    rw [Ψ.current_of_mem S.input hm]
    have e1 : cellColumnProjection Ψ'.D Ψ'.A hm' (physicalColumnInput S.input) =
        fitProj S.M (S.cell (Ψ'.anc I)) (S.atoms K (Ψ'.anc I)) (S.count K (Ψ'.anc I))
          (physicalColumnInput S.input) :=
      treeProjection_eq hKT hJ' hJ'K (dyadicGridCell_depth_le_of_subset S.G J' K hJ'K) hm' _
    have e2 : cellColumnProjection Ψ.D Ψ.A hm (physicalColumnInput S.input) =
        fitProj S.M (S.cell (Ψ.anc I)) (S.atoms K (Ψ.anc I)) (S.count K (Ψ.anc I))
          (physicalColumnInput S.input) := treeProjection_eq hKT hKT subset_rfl le_rfl hm _
    funext y
    rw [e1, e2, hanc]
  refine ⟨z, fun I => ⟨?_, ?_⟩, fun I hI hseg => ?_, fun J' hJ' hJ'K => ?_,
    Fin S.M, inferInstance, Ψ, S.input, rfl, rfl, le_rfl, hcharts, fun I => rfl, h.input_ae⟩
  · change Measurable (Ψ.current S.input I)
    unfold ColumnDepthFamily.current
    split_ifs
    · have hev : Continuous fun x : ColumnHilbert (Fin S.M) => x.ofLp none :=
        (continuous_apply none).comp (PiLp.continuous_ofLp 2 _)
      exact hev.measurable.comp (Lp.stronglyMeasurable _).measurable
    · exact measurable_const
  · change MemLp (Ψ.current S.input I) 2 _
    unfold ColumnDepthFamily.current
    split_ifs
    · exact (memLp_column_coord _ none).restrict _
    · exact MemLp.zero
  · have hIK : S.cell I ⊆ S.cell K := by
      obtain ⟨-, hIK, -, -⟩ := h.seg_spec hI; rw [hseg] at hIK; exact hIK
    have hIsub : I ∈ S.sub K := (sub_mem_iff hKT I).mpr ⟨hI, hIK⟩
    filter_upwards [current_ae_fit hKT hKT subset_rfl le_rfl hIsub] with y hy hyI
    rw [hz]
    simp only
    rw [hy hyI]
    change S.phys I (S.state (I.1 - K.1).toNat I).1 (S.state (I.1 - K.1).toNat I).2 y =
      S.phys I (S.state (I.1 - (S.seg I).1).toNat I).1 (S.state (I.1 - (S.seg I).1).toNat I).2 y
    rw [hseg]
  · set Ψ' := S.depthFamily K J' hJ' (dyadicGridCell_depth_le_of_subset S.G J' K hJ'K)
    have hJ'J : S.cell J' ⊆ S.cell S.J := ((dyadicFiniteTree_mem_iff S.G S.J J' S.N).mp hJ').1
    have hF : ∫ y in S.cell J', ‖(S.input : ℝ → ℂ) y‖ ^ 2 = ∫ y in S.cell J', ‖S.f y‖ ^ 2 := by
      refine integral_congr_ae ?_
      rw [Filter.EventuallyEq, ae_restrict_iff' (dyadicGridCell_measurable _ _ _)]
      filter_upwards [h.input_ae] with y hy hyJ
      rw [hy, Set.indicator_of_mem (hJ'J hyJ)]
    have hzc : ∀ I : ℤ × ℤ, S.cell I ⊆ S.cell J' → z I = Ψ'.current S.input I := fun I hI =>
      (hroot J' hJ' hJ'K I hI).symm
    refine ⟨?_, ?_⟩
    · have hadm := Ψ'.current_admissible S.input
      rw [show Ψ'.D = S.treeData K J' from rfl, compressionOneConst_treeData] at hadm
      exact isAdmissibleOpponent_congr hadm hzc hF
    · exact hasDepthEnergy_congr (Ψ'.current_depthEnergy S.input) hzc hF

end FitSetup

/-- Blueprint §11.2, Declaration adaptive-fit (`THT.Base.inheritedAdaptiveFit`, lines
1567-1579). For accuracy `e^{-k}` and an input normalized by `‖f‖_{q,I} ≤ 1` on every cell `I`
of the complete finite tree of depth `N` below the root `J` (the normalization of
`sec:reduction`, line 418), there are restarted segments (roots with total length
at most `4/3 |J|`) and inherited lists of at most `M ≤ 17 B²` bounded chart atoms of complexity
budget `B = exp(C_q (1 + log 2 + k)^C)`, extending along each segment, whose fitted
combinations `g_I` (coefficient `ℓ²` norm at most one, hence `|g_I| ≤ √M` and
`‖g_I‖_{2,I} ≤ 1`) leave a small residual: `d_{j,I}(f - g_I) ≤ e^{-k}` on every cell. -/
theorem inheritedAdaptiveFit (κ : LocalKernelClass) :
    ∃ (c₂ C : ℕ), 1 ≤ c₂ ∧ 1 ≤ C ∧ ∀ q : ℝ, 2 < q → ∃ Cq : ℝ, 0 < Cq ∧
    ∀ (G : RealDyadicGrid) (J : ℤ × ℤ) (N : ℕ) (w : ℤ × ℤ → ℝ × ℝ → ℂ),
    (∀ I, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) (w I)) →
    ∀ (j : Fin 4) {f : ℝ → ℂ}, Measurable f → (∀ I ∈ dyadicFiniteTree G J N,
      (I = J ∨ kernelHull G J N w I) → eLpNorm f (ENNReal.ofReal q)
        (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)) ≤ 1) →
    ∀ {k : ℕ}, 1 ≤ k →
    ∃ (M : ℕ) (roots : Finset (ℤ × ℤ)) (seg : ℤ × ℤ → ℤ × ℤ) (n : ℤ × ℤ → ℕ)
      (a : ℤ × ℤ → ℕ → ℝ → ℂ) (g : ℤ × ℤ → ℝ → ℂ) (cnt : ℤ × ℤ → ℤ × ℤ → ℕ)
      (atm : ℤ × ℤ → ℤ × ℤ → ℕ → ℝ → ℂ),
      IsAdaptiveFit c₂ (fitBudget Cq C k) G J N w j q f k M roots seg n a g ∧
      IsAttemptData c₂ (fitBudget Cq C k) G J N M roots seg n a cnt atm ∧
      IsFitOpponent G J N f roots seg g (fitOpponentConst M) (max 2 (M : ℝ)) c₂
        (fitBudget Cq C k) := by
  obtain ⟨c₂, C, hc₂, hC, hdet⟩ := fit_detect κ
  refine ⟨c₂, C, hc₂, hC, fun q hq => ?_⟩
  obtain ⟨Cq, hCq, hd⟩ := hdet q hq
  refine ⟨Cq, hCq, fun G J N w hw j f hf hfb k hk => ?_⟩
  set B := fitBudget Cq C k with hBdef
  have hB1 : 1 ≤ B := one_le_fitBudget hCq C k
  let S : FitSetup := ⟨G, J, N, ⌊16 * B ^ 2⌋₊ + 1, f, w, j, q, k, c₂, B⟩
  have h : S.Hyp := by
    have h2q : ∀ c ∈ dyadicFiniteTree G J N, (c = J ∨ kernelHull G J N w c) →
        eLpNorm f 2 (normalizedIntervalMeasure (dyadicGridLeft G c.1 c.2)
          (dyadicGridLength G c.1)) ≤ 1 := by
      intro c hc hcT
      have : IsProbabilityMeasure (normalizedIntervalMeasure (dyadicGridLeft G c.1 c.2)
          (dyadicGridLength G c.1)) :=
        normalizedIntervalMeasure_probability _ (dyadicGridLength_pos G c.1)
      refine le_trans (eLpNorm_le_eLpNorm_of_exponent_le ?_) (hfb c hc hcT)
      rw [show (2 : ENNReal) = ENNReal.ofReal 2 by norm_num]
      exact ENNReal.ofReal_le_ofReal hq.le
    refine ⟨hf, h2q J (dyadicFiniteTree_root_mem _ _ _) (Or.inl rfl),
      fun c hc hcT => h2q c hc (Or.inr hcT), by linarith only [hB1], fun c a n _ hm hl hns => ?_⟩
    obtain ⟨d, Φ, h1, h2, h3⟩ := hd (dyadicGridLength_pos G c.1) (hw c) hm hl hk hns
    exact ⟨⟨d, Φ⟩, h1, h2, h3⟩
  have hM : S.T < S.M := by
    rw [FitSetup.T_eq]
    have := Nat.lt_floor_add_one (16 * B ^ 2)
    change 16 * B ^ 2 < ((⌊16 * B ^ 2⌋₊ + 1 : ℕ) : ℝ)
    push_cast
    exact this
  refine ⟨S.M, S.roots, S.seg, fun I => (S.st I).2, fun I => (S.st I).1, S.g,
    fun K c => (S.state (c.1 - K.1).toNat c).2, fun K c => (S.state (c.1 - K.1).toNat c).1,
    ⟨?_, FitSetup.J_mem_roots, fun K hK => h.roots_mem hK, h.roots_length_le, ?_⟩,
    ⟨fun I _ => ⟨rfl, fun _ => rfl⟩, fun K hK c hc d hd hcd hdK => ?pre,
      fun K hK c hc hcK => ?ch⟩, h.isFitOpponent⟩
  case pre =>
    have hKT := h.roots_mem hK
    have h1 := dyadicGridCell_depth_le_of_subset S.G c d hcd
    have h2 := dyadicGridCell_depth_le_of_subset S.G d K hdK
    have hpre := fitState_fitPrefix S.G S.M S.P S.O (d.1 - K.1).toNat d (c.1 - d.1).toNat c hcd
      (by omega)
    have he : (d.1 - K.1).toNat + (c.1 - d.1).toNat = (c.1 - K.1).toNat := by omega
    rw [he] at hpre
    exact ⟨hpre.1, fun i hi => hpre.2 i hi⟩
  case ch =>
    refine ⟨fitState_count_le _ _ _ _ _ _, fun i hi => ?_⟩
    obtain ⟨p, h1, h2, h3⟩ := h.atoms_good (c.1 - K.1).toNat c i hi
    exact ⟨p.1, p.2, h1, h2, h3⟩
  · have : ((⌊16 * B ^ 2⌋₊ + 1 : ℕ) : ℝ) ≤ 16 * B ^ 2 + 1 := by
      push_cast
      linarith [Nat.floor_le (show (0 : ℝ) ≤ 16 * B ^ 2 by positivity)]
    have : (1 : ℝ) ≤ B ^ 2 := by nlinarith
    change ((⌊16 * B ^ 2⌋₊ + 1 : ℕ) : ℝ) ≤ 17 * B ^ 2
    linarith
  intro I hI
  have hIJ := hI
  obtain ⟨hKr, hIK, _, _⟩ := h.seg_spec hI
  obtain ⟨hlt, hsmall⟩ := h.retained hM hI
  refine ⟨hKr, hIK, hlt.le, fun I' hI' hII' hI'K => ?_, fun i hi => ?_, h.g_coeff hIJ,
    FitSetup.phys_measurable _ _ _, h.g_norm_le hIJ, fun hT => h.phys_sq_le hIJ hT _ _, hsmall⟩
  · obtain ⟨hseg, hpre⟩ := h.inherited hI hI' hII' hI'K
    exact ⟨hseg, hpre.1, fun i hi => (hpre.2 i hi).symm⟩
  · obtain ⟨p, h1, h2, h3⟩ := h.atoms_good (S.depthIn I) I i hi
    exact ⟨p.1, p.2, h1, h2, h3⟩

/-- Blueprint §11.2, Declaration stagger (`THT.Base.twoEarliestIncrements`, lines 1581-1598).
Update the four positions cyclically by the adaptive fits at accuracies `k_t = k_1^{A^{t-1}}`.
On every tree cell the update data form a `StaggerCell`, so `eq:stagger` holds
(`StaggerCell.term_bound`), the expansion at every finite cutoff groups exactly into the tuples
`eq:base-tuple` of the two earliest increments (`StaggerCell.expansion`) with remainders tending
to zero (`StaggerCell.remainder_four`, `StaggerCell.remainder_one`), all tuple factors have
normalized `L²` norm at most `2`, and for `t ≥ 12` every pair of full tuple arguments has bilinear
norm at most `e^{-2 k_t^{θ₀}}`. Unions of finitely many level segment families have total root
length at most their number times `4/3 |J|`. -/
theorem twoEarliestIncrements (κ : LocalKernelClass) :
    ∃ (c₂ C A : ℕ) (θ₀ : ℝ), 1 ≤ c₂ ∧ 1 ≤ C ∧ 2 ≤ A ∧ 0 < θ₀ ∧ θ₀ ≤ 1 ∧
    ∀ q : ℝ, 2 < q → ∃ (Cq : ℝ) (K₁ : ℕ), 0 < Cq ∧ ∀ k₁ : ℕ, K₁ ≤ k₁ →
    ∀ (G : RealDyadicGrid) (J : ℤ × ℤ) (N : ℕ) (w : ℤ × ℤ → ℝ × ℝ → ℂ),
    (∀ I, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) (w I)) →
    ∀ (f : Fin 4 → ℝ → ℂ), (∀ p, Measurable (f p)) →
    (∀ p, ∀ I ∈ dyadicFiniteTree G J N, (I = J ∨ kernelHull G J N w I) →
      eLpNorm (f p) (ENNReal.ofReal q)
        (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)) ≤ 1) →
    ∃ (M : ℕ → ℕ) (roots : ℕ → Finset (ℤ × ℤ)) (seg : ℕ → ℤ × ℤ → ℤ × ℤ)
      (n : ℕ → ℤ × ℤ → ℕ) (a : ℕ → ℤ × ℤ → ℕ → ℝ → ℂ) (g : ℕ → ℤ × ℤ → ℝ → ℂ)
      (cnt : ℕ → ℤ × ℤ → ℤ × ℤ → ℕ) (atm : ℕ → ℤ × ℤ → ℤ × ℤ → ℕ → ℝ → ℂ),
      (∀ t, IsAdaptiveFit c₂ (fitBudget Cq C (stagAcc k₁ A t)) G J N w (stagPos t) q
        (f (stagPos t)) (stagAcc k₁ A t) (M t) (roots t) (seg t) (n t) (a t) (g t) ∧
        IsAttemptData c₂ (fitBudget Cq C (stagAcc k₁ A t)) G J N (M t) (roots t) (seg t) (n t)
          (a t) (cnt t) (atm t) ∧
        IsFitOpponent G J N (f (stagPos t)) (roots t) (seg t) (g t) (fitOpponentConst (M t))
          (max 2 (M t : ℝ)) c₂ (fitBudget Cq C (stagAcc k₁ A t))) ∧
      (∀ L : Finset ℕ, dyadicRootLength G (L.biUnion roots) ≤
        L.card * (4 / 3 * dyadicGridLength G J.1)) ∧
      ∀ I ∈ dyadicFiniteTree G J N, kernelHull G J N w I → ∃ D : StaggerCell κ,
        D.a₀ = dyadicGridLeft G I.1 I.2 ∧ D.r = dyadicGridLength G I.1 ∧ D.w = w I ∧
        D.q = q ∧ D.f = f ∧ (∀ t, D.g t = g t I) ∧ (∀ t, D.k t = stagAcc k₁ A t) ∧
        (∀ u t, 12 ≤ t → 1 ≤ u → u < t → stagPos u ≠ stagPos t → ∀ s s' : Fin 4, s ≠ s' →
          PairSmall D.a₀ D.r D.w s s' (D.tuple u t s) (D.tuple u t s')
            (Real.exp (-2 * (stagAcc k₁ A t : ℝ) ^ θ₀))) ∧
        (∀ T, D.H D.f = D.H (D.tail T) + ∑ u ∈ Finset.Icc 1 T,
          (D.H (Function.update (D.tail T) (stagPos u) (D.incr u)) +
            ∑ t ∈ Finset.Ioc u T, if stagPos t ≠ stagPos u then D.H (D.tuple u t) else 0)) ∧
        (∀ T, 4 ≤ T → ‖D.H (D.tail T)‖ ≤ 32 * Real.exp (-(stagAcc k₁ A (T - 3) : ℝ)) ∧
          ∀ u, ‖D.H (Function.update (D.tail T) (stagPos u) (D.incr u))‖ ≤
            32 * Real.exp (-(stagAcc k₁ A (T - 3) : ℝ))) ∧
        ∀ u t l, eLpNorm (D.tuple u t l) 2 D.μ ≤ 2 := by
  obtain ⟨c₂, C, hc₂, hC, hAF⟩ := inheritedAdaptiveFit κ
  set A := C + 1 with hA
  have hA2 : 2 ≤ A := by omega
  refine ⟨c₂, C, A, 1 / (2 * (A : ℝ) ^ 7), hc₂, hC, hA2, by positivity, ?_, fun q hq => ?_⟩
  · have hA1 : (1 : ℝ) ≤ A := by exact_mod_cast (show 1 ≤ A by omega)
    rw [div_le_one (by positivity)]
    have : (1 : ℝ) ≤ (A : ℝ) ^ 7 := one_le_pow₀ hA1
    linarith
  obtain ⟨Cq, hCq, hfit⟩ := hAF q hq
  refine ⟨Cq, max 16 ⌈4 * Cq * 2 ^ C⌉₊, hCq, fun k₁ hk₁ G J N w hw f hf hfn => ?_⟩
  have hk16 : 16 ≤ k₁ := le_trans (le_max_left _ _) hk₁
  have hkC : 4 * Cq * 2 ^ C ≤ (k₁ : ℝ) :=
    (Nat.le_ceil _).trans (by exact_mod_cast le_trans (le_max_right _ _) hk₁)
  have hacc1 : ∀ t, 1 ≤ stagAcc k₁ A t := fun t => le_trans (by omega) (le_stagAcc (by omega)
    (by omega) t)
  choose M roots seg n a g cnt atm hlev' using fun t => hfit G J N w hw (stagPos t) (hf (stagPos t))
    (hfn (stagPos t)) (hacc1 t)
  have hlev := fun t => (hlev' t).1
  refine ⟨M, roots, seg, n, a, g, cnt, atm, hlev', fun L => ?_, fun I hI hIT => ?_⟩
  · calc dyadicRootLength G (L.biUnion roots) ≤ ∑ t ∈ L, dyadicRootLength G (roots t) :=
          finite_union_weight_le _ _ _ fun c => (dyadicGridLength_pos G c.1).le
      _ ≤ ∑ _t ∈ L, 4 / 3 * dyadicGridLength G J.1 :=
          Finset.sum_le_sum fun t _ => (hlev t).2.2.2.1
      _ = L.card * (4 / 3 * dyadicGridLength G J.1) := by rw [Finset.sum_const, nsmul_eq_mul]
  -- the cell data
  have hcell := fun t => (hlev t).2.2.2.2 I hI
  have hgm : ∀ t, Measurable (g t I) := fun t => (hcell t).2.2.2.2.2.2.1
  have hgsup : ∀ t y, ‖g t I y‖ ≤ Real.sqrt (M t) := fun t => (hcell t).2.2.2.2.2.2.2.1 hIT
  have hgL : ∀ t, ∫ y in dyadicGridCell G I.1 I.2, ‖g t I y‖ ^ 2 ≤ dyadicGridLength G I.1 :=
    fun t => (hcell t).2.2.2.2.2.2.2.2.1 hIT
  have hgsm := fun t => (hcell t).2.2.2.2.2.2.2.2.2
  set! B : ℕ → ℝ := fun t => fitBudget Cq C (stagAcc k₁ A t) with hB
  have hBpos : ∀ t, 0 < B t := fun t => Real.exp_pos _
  have hgS : ∀ t y, ‖g t I y‖ ≤ Real.sqrt 17 * B t := by
    intro t y
    refine (hgsup t y).trans ?_
    calc Real.sqrt (M t) ≤ Real.sqrt (17 * B t ^ 2) := Real.sqrt_le_sqrt (hlev t).1
      _ = Real.sqrt 17 * B t := by
          rw [Real.sqrt_mul (by norm_num), Real.sqrt_sq (hBpos t).le]
  have hgrow : ∀ v h, 1 ≤ v → v < h →
      2 * (stagAcc k₁ A v : ℝ) ≤ stagAcc k₁ A h := by
    intro v h hv hvh
    have h1 := stagAcc_grow (by omega) (by omega) hv hvh (k₁ := k₁) (A := A)
    have h2 : 2 ≤ stagAcc k₁ A v := le_trans (by omega) (le_stagAcc (by omega) (by omega) v)
    have h3 : 2 * stagAcc k₁ A v ≤ stagAcc k₁ A v ^ A := by
      calc 2 * stagAcc k₁ A v ≤ stagAcc k₁ A v * stagAcc k₁ A v := Nat.mul_le_mul_right _ h2
        _ = stagAcc k₁ A v ^ 2 := (sq _).symm
        _ ≤ stagAcc k₁ A v ^ A := Nat.pow_le_pow_right (by omega) hA2
    exact_mod_cast h3.trans h1
  have hSle : ∀ v h, 1 ≤ v → v < h → Real.sqrt 17 * B v ≤ Real.exp ((stagAcc k₁ A h : ℝ) / 2) := by
    intro v h hv hvh
    have hx16 : 16 ≤ stagAcc k₁ A v := hk16.trans (le_stagAcc (by omega) (by omega) v)
    have hxC : 4 * Cq * 2 ^ C ≤ (stagAcc k₁ A v : ℝ) :=
      hkC.trans (by exact_mod_cast le_stagAcc (by omega) (by omega) v)
    refine (budget_le_exp hCq hx16 hxC).trans (Real.exp_le_exp.mpr ?_)
    have := stagAcc_grow (k₁ := k₁) (A := A) (by omega) (by omega) hv hvh
    have : ((stagAcc k₁ A v : ℕ) : ℝ) ^ (C + 1) ≤ (stagAcc k₁ A h : ℝ) := by exact_mod_cast this
    linarith
  let D : StaggerCell κ :=
    { a₀ := dyadicGridLeft G I.1 I.2
      r := dyadicGridLength G I.1
      w := w I
      q := q
      f := f
      g := fun t => g t I
      k := fun t => (stagAcc k₁ A t : ℝ)
      S := fun t => Real.sqrt 17 * B t
      r_pos := dyadicGridLength_pos G I.1
      adm := hw I
      two_le_q := hq.le
      f_meas := hf
      f_norm := fun p => hfn p I hI (Or.inr hIT)
      g_meas := hgm
      S_pos := fun t => mul_pos (Real.sqrt_pos.mpr (by norm_num)) (hBpos t)
      g_bound := hgS
      g_L2 := fun t => eLpNorm_fit_le (hgm t) (hgS t) (hgL t)
      g_small := fun t _ => hgsm t
      k_nonneg := fun t => Nat.cast_nonneg _
      k_grow := hgrow
      S_le := hSle }
  refine ⟨D, rfl, rfl, rfl, rfl, rfl, fun t => rfl, fun t => rfl, ?_, D.expansion, ?_,
    D.tuple_L2⟩
  · intro u t ht hu hut hpos s s' hss
    refine (D.tuple_pairSmall ht hu hut hpos hss).mono ?_
    have hy : (16 : ℝ) ≤ stagAcc k₁ A (t - 7) := by
      exact_mod_cast hk16.trans (le_stagAcc (by omega) (by omega) _)
    have he : (stagAcc k₁ A t : ℝ) ^ (1 / (2 * (A : ℝ) ^ 7)) =
        Real.sqrt (stagAcc k₁ A (t - 7)) := by
      rw [stagAcc_pow (v := t - 7) (h := t) (by omega) (by omega),
        show t - (t - 7) = 7 by omega, Nat.cast_pow, ← Real.rpow_natCast,
        ← Real.rpow_mul (Nat.cast_nonneg _), Real.sqrt_eq_rpow]
      congr 1
      push_cast
      field_simp
    rw [he]
    exact eight_exp_le hy
  · intro T hT
    exact ⟨by have := D.remainder_four hT; linarith, fun u => by
      have := D.remainder_one hT u; linarith⟩

end TrilinearHT.Auto


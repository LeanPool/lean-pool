/-- Blueprint line 2467: the first-success weights `(1 - p)^n p` of words whose first success is
last have total weight exactly one. -/
theorem first_success_weights_sum {p : ℝ} (hp0 : 0 < p) (hp1 : p ≤ 1) :
    HasSum (fun n : ℕ => (1 - p) ^ n * p) 1 := by
  have h := hasSum_geometric_of_lt_one (r := 1 - p) (by linarith only [hp1]) (by linarith)
  have := h.mul_right p
  rwa [show (1 - (1 - p))⁻¹ * p = 1 by rw [sub_sub_cancel, inv_mul_cancel₀ hp0.ne']] at this

/-- Blueprint line 2467 (success probability): if each of `m₀` roles is bad at a proportion at most
`β` of the heights `H`, then all roles are good at a proportion at least `1 - m₀ β`. -/
theorem all_good_proportion {α : Type*} [DecidableEq α] (H : Finset α) {m₀ : ℕ}
    (bad : Fin m₀ → Finset α) {β : ℝ} (hbad : ∀ j, ((bad j ∩ H).card : ℝ) ≤ β * H.card) :
    (1 - m₀ * β) * H.card ≤ ((H.filter fun h => ∀ j, h ∉ bad j).card : ℝ) := by
  classical
  have hsub : H.filter (fun h => ¬∀ j, h ∉ bad j) ⊆ Finset.univ.biUnion fun j => bad j ∩ H := by
    intro h hh
    obtain ⟨hH, hn⟩ := Finset.mem_filter.mp hh
    push Not at hn
    obtain ⟨j, hj⟩ := hn
    exact Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ _, Finset.mem_inter.mpr ⟨hj, hH⟩⟩
  have hc := (Finset.card_le_card hsub).trans Finset.card_biUnion_le
  have hc' : ((H.filter fun h => ¬∀ j, h ∉ bad j).card : ℝ) ≤ m₀ * (β * H.card) := by
    calc _ ≤ ((∑ j : Fin m₀, (bad j ∩ H).card : ℕ) : ℝ) := by exact_mod_cast hc
      _ = ∑ j : Fin m₀, ((bad j ∩ H).card : ℝ) := by push_cast; rfl
      _ ≤ ∑ _j : Fin m₀, β * H.card := Finset.sum_le_sum fun j _ => hbad j
      _ = m₀ * (β * H.card) := by simp
  have hsplit := Finset.card_filter_add_card_filter_not (s := H) (fun h => ∀ j, h ∉ bad j)
  have : (H.card : ℝ) = ((H.filter fun h => ∀ j, h ∉ bad j).card : ℝ) +
      ((H.filter fun h => ¬∀ j, h ∉ bad j).card : ℝ) := by exact_mod_cast hsplit.symm
  nlinarith

end TrilinearHT.Auto


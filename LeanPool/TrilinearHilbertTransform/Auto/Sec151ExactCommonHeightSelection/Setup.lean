section PatternEstimates
variable {W : Type*} [NormedAddCommGroup W] [NormedSpace ℂ W]

open Classical in
/-- A pattern containing an error slot: its form is at most the size cap cubed times the
normalized error size of that slot. -/
theorem pattern_error_le (Λ : MultilinearMap ℂ (fun _ : Fin 4 => W) ℂ) {C r Bs : ℝ}
    (hC : 0 ≤ C) (hr : 0 < r)
    (hΛ : ∀ x : Fin 4 → W, ‖Λ x‖ ≤ C * ∏ l, (‖x l‖ / Real.sqrt r))
    (a s e : Fin 4 → W) (hsize : ∀ l, ‖a l‖ ≤ Bs * Real.sqrt r ∧ ‖s l‖ ≤ Bs * Real.sqrt r ∧
      ‖e l‖ ≤ Bs * Real.sqrt r) (σ : Fin 4 → Fin 3) {l₀ : Fin 4} (hl₀ : σ l₀ = 2) :
    ‖Λ (patternPiece a s e σ)‖ ≤ C * Bs ^ 3 * (‖e l₀‖ / Real.sqrt r) := by
  have hsr := Real.sqrt_pos.mpr hr
  have hpiece : ∀ l, ‖patternPiece a s e σ l‖ / Real.sqrt r ≤ Bs := by
    intro l
    rw [div_le_iff₀ hsr]
    unfold patternPiece
    have h := hsize l
    match σ l with
    | 0 => exact h.1
    | 1 => exact h.2.1
    | 2 => exact h.2.2
  have hl₀' : patternPiece a s e σ l₀ = e l₀ := by unfold patternPiece; rw [hl₀]; rfl
  refine (hΛ _).trans ?_
  rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ l₀), hl₀']
  have hrest : ∏ l ∈ Finset.univ.erase l₀, (‖patternPiece a s e σ l‖ / Real.sqrt r) ≤
      Bs ^ 3 := by
    calc ∏ l ∈ Finset.univ.erase l₀, (‖patternPiece a s e σ l‖ / Real.sqrt r)
        ≤ ∏ _l ∈ Finset.univ.erase l₀, Bs :=
          Finset.prod_le_prod₀ (fun l _ => by positivity) fun l _ => hpiece l
      _ = Bs ^ 3 := by
          rw [Finset.prod_const, Finset.card_erase_of_mem (Finset.mem_univ _)]; simp
  have he0 : 0 ≤ ‖e l₀‖ / Real.sqrt r := by positivity
  calc C * (‖e l₀‖ / Real.sqrt r * ∏ l ∈ Finset.univ.erase l₀,
        (‖patternPiece a s e σ l‖ / Real.sqrt r))
      ≤ C * (‖e l₀‖ / Real.sqrt r * Bs ^ 3) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hrest he0) hC
    _ = C * Bs ^ 3 * (‖e l₀‖ / Real.sqrt r) := by ring

open Classical in
/-- Blueprint line 2461 and line 2166 ("every term containing a physical error is
`O(e^{-k}|R|)`"): the error patterns of all cells and groups are bounded, after Cauchy-Schwarz
over the cells and groups, by `324 C B³ (Σ_I |I| #G_I)^{1/2} (Σ_{I,G,l} ‖E‖²)^{1/2}`. -/
theorem error_patterns_le {ι γ : Type*} (S : Finset ι) (len : ι → ℝ) (hlen : ∀ I ∈ S, 0 < len I)
    (Gs : ι → Finset γ) (Λ : ι → MultilinearMap ℂ (fun _ : Fin 4 => W) ℂ) {C Bs : ℝ}
    (hC : 0 ≤ C) (hBs : 0 ≤ Bs)
    (hΛ : ∀ I ∈ S, ∀ x : Fin 4 → W, ‖Λ I x‖ ≤ C * ∏ l, (‖x l‖ / Real.sqrt (len I)))
    (a s e : ι → γ → Fin 4 → W)
    (hsize : ∀ I ∈ S, ∀ G ∈ Gs I, ∀ l, ‖a I G l‖ ≤ Bs * Real.sqrt (len I) ∧
      ‖s I G l‖ ≤ Bs * Real.sqrt (len I) ∧ ‖e I G l‖ ≤ Bs * Real.sqrt (len I))
    {M Ee : ℝ} (hM : ∑ I ∈ S, len I * (Gs I).card ≤ M)
    (hE : ∑ I ∈ S, ∑ G ∈ Gs I, ∑ l, ‖e I G l‖ ^ 2 ≤ Ee) :
    ∑ I ∈ S, len I * ∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => ∃ l, σ l = 2),
        ‖∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ≤
      81 * (C * Bs ^ 3) * (Real.sqrt (4 * M) * Real.sqrt Ee) := by
  -- one pattern at one cell and group
  have hone : ∀ I ∈ S, ∀ G ∈ Gs I, ∀ σ ∈ Finset.univ.filter
      (fun σ : Fin 4 → Fin 3 => ∃ l, σ l = 2),
      ‖Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ≤
        C * Bs ^ 3 * ∑ l, (‖e I G l‖ / Real.sqrt (len I)) := by
    intro I hI G hG σ hσ
    obtain ⟨l₀, hl₀⟩ := (Finset.mem_filter.mp hσ).2
    refine (pattern_error_le (Λ I) hC (hlen I hI) (hΛ I hI) _ _ _ (hsize I hI G hG) σ
      hl₀).trans ?_
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    exact Finset.single_le_sum (f := fun l => ‖e I G l‖ / Real.sqrt (len I))
      (fun l _ => by positivity) (Finset.mem_univ l₀)
  have hcard : (Finset.univ.filter (fun σ : Fin 4 → Fin 3 => ∃ l, σ l = 2)).card ≤ 81 := by
    refine (Finset.card_filter_le _ _).trans ?_
    simp
  have hcell : ∀ I ∈ S, len I * ∑ σ ∈ Finset.univ.filter
      (fun σ : Fin 4 → Fin 3 => ∃ l, σ l = 2),
        ‖∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ≤
      81 * (C * Bs ^ 3) * ∑ G ∈ Gs I, ∑ l, (Real.sqrt (len I) * ‖e I G l‖) := by
    intro I hI
    have hr := hlen I hI
    have hsr := Real.sqrt_pos.mpr hr
    have hX : 0 ≤ C * Bs ^ 3 * ∑ G ∈ Gs I, ∑ l, (‖e I G l‖ / Real.sqrt (len I)) := by
      have : 0 ≤ ∑ G ∈ Gs I, ∑ l, (‖e I G l‖ / Real.sqrt (len I)) := by positivity
      positivity
    calc len I * ∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => ∃ l, σ l = 2),
          ‖∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖
        ≤ len I * ∑ _σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => ∃ l, σ l = 2),
            C * Bs ^ 3 * ∑ G ∈ Gs I, ∑ l, (‖e I G l‖ / Real.sqrt (len I)) := by
          refine mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun σ hσ => ?_) hr.le
          refine (norm_sum_le _ _).trans ?_
          rw [Finset.mul_sum]
          exact Finset.sum_le_sum fun G hG => hone I hI G hG σ hσ
      _ ≤ len I * (81 * (C * Bs ^ 3 * ∑ G ∈ Gs I, ∑ l, (‖e I G l‖ / Real.sqrt (len I)))) := by
          rw [Finset.sum_const, nsmul_eq_mul]
          refine mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_right (by exact_mod_cast hcard) hX) hr.le
      _ = 81 * (C * Bs ^ 3) * ∑ G ∈ Gs I, ∑ l, (Real.sqrt (len I) * ‖e I G l‖) := by
          simp only [Finset.mul_sum]
          refine Finset.sum_congr rfl fun G _ => Finset.sum_congr rfl fun l _ => ?_
          calc len I * (81 * (C * Bs ^ 3 * (‖e I G l‖ / Real.sqrt (len I))))
              = 81 * (C * Bs ^ 3) * (len I / Real.sqrt (len I) * ‖e I G l‖) := by ring
            _ = _ := by rw [Real.div_sqrt]
  -- Cauchy-Schwarz over cells, groups and slots
  set! T := S.sigma Gs
  have hCS : ∑ I ∈ S, ∑ G ∈ Gs I, ∑ l, (Real.sqrt (len I) * ‖e I G l‖) ≤
      Real.sqrt (4 * M) * Real.sqrt Ee := by
    have h1 : ∑ I ∈ S, ∑ G ∈ Gs I, ∑ l, (Real.sqrt (len I) * ‖e I G l‖) =
        ∑ x ∈ T ×ˢ (Finset.univ : Finset (Fin 4)), Real.sqrt (len x.1.1) * ‖e x.1.1 x.1.2 x.2‖ := by
      rw [Finset.sum_product, Finset.sum_sigma]
    rw [h1]
    refine (Real.sum_mul_le_sqrt_mul_sqrt _ _ _).trans ?_
    have h2 : ∑ x ∈ T ×ˢ (Finset.univ : Finset (Fin 4)), Real.sqrt (len x.1.1) ^ 2 ≤ 4 * M := by
      rw [Finset.sum_product, Finset.sum_sigma]
      calc ∑ I ∈ S, ∑ G ∈ Gs I, ∑ _l : Fin 4, Real.sqrt (len I) ^ 2
          = ∑ I ∈ S, 4 * (len I * (Gs I).card) := by
            refine Finset.sum_congr rfl fun I hI => ?_
            rw [Real.sq_sqrt (hlen I hI).le]
            simp [Finset.sum_const]; ring
        _ ≤ 4 * M := by rw [← Finset.mul_sum]; linarith
    have h3 : ∑ x ∈ T ×ˢ (Finset.univ : Finset (Fin 4)), ‖e x.1.1 x.1.2 x.2‖ ^ 2 ≤ Ee := by
      rw [Finset.sum_product, Finset.sum_sigma]; exact hE
    exact mul_le_mul (Real.sqrt_le_sqrt h2) (Real.sqrt_le_sqrt h3) (Real.sqrt_nonneg _)
      (Real.sqrt_nonneg _)
  calc _ ≤ ∑ I ∈ S, 81 * (C * Bs ^ 3) * ∑ G ∈ Gs I, ∑ l, (Real.sqrt (len I) * ‖e I G l‖) :=
        Finset.sum_le_sum hcell
    _ = 81 * (C * Bs ^ 3) * ∑ I ∈ S, ∑ G ∈ Gs I, ∑ l, (Real.sqrt (len I) * ‖e I G l‖) := by
        rw [Finset.mul_sum]
    _ ≤ _ := mul_le_mul_of_nonneg_left hCS (by positivity)

end PatternEstimates

section PatternEstimates3
variable {W : Type*} [NormedAddCommGroup W] [NormedSpace ℂ W]

open Classical in
/-- Blueprint line 2461 ("for terms with exactly two sides, replace the two core complements by
their whole current `Z` arguments; corrections have at least three sides"): at one cell the
two-core two-side patterns differ from the restored ones by at most `81` times the error and the
three-side pattern sums. -/
theorem two_two_cell_le {γ : Type*} (Gs : Finset γ) (Λ : MultilinearMap ℂ (fun _ : Fin 4 => W) ℂ)
    (a s e : γ → Fin 4 → W) :
    ‖∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
        patternCount σ 0 = 2 ∧ patternCount σ 1 = 2),
        ∑ G ∈ Gs, Λ (patternPiece (a G) (s G) (e G) σ)‖ ≤
      ‖∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
          patternCount σ 0 = 2 ∧ patternCount σ 1 = 2),
          ∑ G ∈ Gs, Λ (fun l => if σ l = 0 then a G l + s G l + e G l else s G l)‖ +
        81 * ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => ∃ l, τ l = 2),
          ‖∑ G ∈ Gs, Λ (patternPiece (a G) (s G) (e G) τ)‖ +
        81 * ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧
          3 ≤ patternCount τ 1), ‖∑ G ∈ Gs, Λ (patternPiece (a G) (s G) (e G) τ)‖ := by
  set P22 := Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
    patternCount σ 0 = 2 ∧ patternCount σ 1 = 2)
  set Perr := Finset.univ.filter (fun τ : Fin 4 → Fin 3 => ∃ l, τ l = 2)
  set P3 := Finset.univ.filter (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧ 3 ≤ patternCount τ 1)
  set f : (Fin 4 → Fin 3) → ℝ := fun τ => ‖∑ G ∈ Gs, Λ (patternPiece (a G) (s G) (e G) τ)‖
  have hrest : ∀ σ ∈ P22, ∑ G ∈ Gs, Λ (patternPiece (a G) (s G) (e G) σ) =
      ∑ G ∈ Gs, Λ (fun l => if σ l = 0 then a G l + s G l + e G l else s G l) -
        ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => τ ≠ σ ∧ ∀ l, σ l = 1 → τ l = 1),
          ∑ G ∈ Gs, Λ (patternPiece (a G) (s G) (e G) τ) := by
    intro σ hσ
    rw [Finset.sum_comm, ← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun G _ =>
      form_restore_cores Λ (a G) (s G) (e G) σ (Finset.mem_filter.mp hσ).2.1
  have hcorr : ∀ σ ∈ P22, ‖∑ τ ∈ Finset.univ.filter
      (fun τ : Fin 4 → Fin 3 => τ ≠ σ ∧ ∀ l, σ l = 1 → τ l = 1),
        ∑ G ∈ Gs, Λ (patternPiece (a G) (s G) (e G) τ)‖ ≤
      ∑ τ ∈ Perr, f τ + ∑ τ ∈ P3, f τ := by
    intro σ hσ
    obtain ⟨hσe, -, hσ1⟩ := (Finset.mem_filter.mp hσ).2
    refine (norm_sum_le _ _).trans ?_
    have hsub : Finset.univ.filter (fun τ : Fin 4 → Fin 3 => τ ≠ σ ∧ ∀ l, σ l = 1 → τ l = 1) ⊆
        Perr ∪ P3 := by
      intro τ hτ
      obtain ⟨hne, hτσ⟩ := (Finset.mem_filter.mp hτ).2
      rcases restore_correction_sides σ τ hσe hne hτσ with h | h
      · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, h⟩)
      · by_cases he : ∃ l, τ l = 2
        · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, he⟩)
        · push Not at he
          exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, he,
            by omega⟩)
    calc ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => τ ≠ σ ∧ ∀ l, σ l = 1 → τ l = 1),
          f τ ≤ ∑ τ ∈ Perr ∪ P3, f τ :=
          Finset.sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ => norm_nonneg _
      _ ≤ ∑ τ ∈ Perr, f τ + ∑ τ ∈ P3, f τ := by
          have h1 := Finset.sum_union_inter (s₁ := Perr) (s₂ := P3) (f := f)
          have h0 : 0 ≤ ∑ τ ∈ Perr ∩ P3, f τ := Finset.sum_nonneg fun _ _ => norm_nonneg _
          linarith
  have hcard : P22.card ≤ 81 := (Finset.card_filter_le _ _).trans (by simp)
  have hX0 : 0 ≤ ∑ τ ∈ Perr, f τ + ∑ τ ∈ P3, f τ := by positivity
  rw [Finset.sum_congr rfl hrest, Finset.sum_sub_distrib]
  refine (norm_sub_le _ _).trans ?_
  have h2 : ‖∑ σ ∈ P22, ∑ τ ∈ Finset.univ.filter
      (fun τ : Fin 4 → Fin 3 => τ ≠ σ ∧ ∀ l, σ l = 1 → τ l = 1),
        ∑ G ∈ Gs, Λ (patternPiece (a G) (s G) (e G) τ)‖ ≤
      81 * (∑ τ ∈ Perr, f τ + ∑ τ ∈ P3, f τ) := by
    refine (norm_sum_le _ _).trans ?_
    calc _ ≤ ∑ _σ ∈ P22, (∑ τ ∈ Perr, f τ + ∑ τ ∈ P3, f τ) := Finset.sum_le_sum hcorr
      _ ≤ 81 * (∑ τ ∈ Perr, f τ + ∑ τ ∈ P3, f τ) := by
          rw [Finset.sum_const, nsmul_eq_mul]
          exact mul_le_mul_of_nonneg_right (by exact_mod_cast hcard) hX0
  linarith

end PatternEstimates3

section PhysicalPart
variable {V V' W : Type*} [Fintype V] [Fintype V'] [Fintype W]

/-- Physical embeddings compose. -/
theorem physEmbed_physEmbed {X : Type*} [Fintype X] (x : ColumnL2 V) :
    physEmbed W X (physEmbed V W x) = physEmbed V X x := by
  classical
  apply Lp.ext
  filter_upwards [physEmbed_coeFn (W := X) (physEmbed V W x), physEmbed_coeFn (W := X) x,
    physEmbed_coeFn_none (W := W) x] with y h1 h2 h3
  rw [h1, h2, h3]

end PhysicalPart


section CoreSideDecomposition
variable {V : Type*} [AddCommGroup V] [Module ℂ V]

open Classical in
/-- Blueprint lines 2461-2462 and 2845-2848: the patterns split into those containing a physical
error, those with at least three cores and no error, those with at least three sides and no
error, and those with exactly two cores and two sides. -/
theorem form_pattern_split (F : (Fin 4 → Fin 3) → ℂ) :
    ∑ σ, F σ = ∑ σ ∈ Finset.univ.filter (fun σ => ∃ l, σ l = 2), F σ +
      ∑ σ ∈ Finset.univ.filter (fun σ => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 0), F σ +
      ∑ σ ∈ Finset.univ.filter (fun σ => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1), F σ +
      ∑ σ ∈ Finset.univ.filter (fun σ => (∀ l, σ l ≠ 2) ∧ patternCount σ 0 = 2 ∧
        patternCount σ 1 = 2), F σ := by
  have hcount : ∀ σ : Fin 4 → Fin 3, (∀ l, σ l ≠ 2) →
      patternCount σ 0 + patternCount σ 1 = 4 := by
    intro σ hσ
    unfold patternCount
    rw [← Finset.card_union_of_disjoint (Finset.disjoint_filter.mpr fun l _ h0 h1 => by
      rw [h0] at h1; exact absurd h1 (by decide))]
    have : Finset.univ.filter (fun l => σ l = 0) ∪ Finset.univ.filter (fun l => σ l = 1) =
        (Finset.univ : Finset (Fin 4)) := by
      ext l
      simp only [Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and, iff_true]
      have h2 : (σ l).val ≠ 2 := fun h => hσ l (Fin.ext h)
      have h3 := (σ l).isLt
      by_cases h0 : (σ l).val = 0
      · left; exact Fin.ext h0
      · right; exact Fin.ext (by simp only [Fin.val_one]; omega)
    rw [this]; rfl
  simp only [Finset.sum_filter, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun σ _ => ?_
  by_cases he : ∃ l, σ l = 2
  · have hne : ¬ ∀ l, σ l ≠ 2 := fun h => by obtain ⟨l, hl⟩ := he; exact h l hl
    simp [he, hne]
  · have hn : ∀ l, σ l ≠ 2 := fun l hl => he ⟨l, hl⟩
    have hc := hcount σ hn
    rw [ite_eq_right_iff.mpr (fun h => absurd h he), zero_add]
    by_cases h0 : 3 ≤ patternCount σ 0
    · have h1 : ¬ 3 ≤ patternCount σ 1 := by omega
      have h2 : ¬ (patternCount σ 0 = 2 ∧ patternCount σ 1 = 2) := by omega
      simp [hn, h0, h1, h2]
    · by_cases h1 : 3 ≤ patternCount σ 1
      · have h2 : ¬ (patternCount σ 0 = 2 ∧ patternCount σ 1 = 2) := by omega
        simp [hn, h0, h1, h2]
      · have h2 : patternCount σ 0 = 2 ∧ patternCount σ 1 = 2 := by omega
        simp [hn, h2]

end CoreSideDecomposition

section CoreSideRestore
variable {V : Type*} [AddCommGroup V] [Module ℂ V]

open Classical in
/-- Blueprint lines 2461-2462 ("for terms with exactly two sides, replace the two core
complements by their whole current `Z` arguments; corrections have at least three sides"): for a
pattern `σ` without errors, the form of its pieces equals the form with the core slots restored
to `Z_l = A_l + S_l + E_l` minus the correction patterns, each of which contains an error or has
more sides than `σ`. -/
theorem form_restore_cores (Λ : MultilinearMap ℂ (fun _ : Fin 4 => V) ℂ) (a s e : Fin 4 → V)
    (σ : Fin 4 → Fin 3) (hσ : ∀ l, σ l ≠ 2) :
    Λ (patternPiece a s e σ) = Λ (fun l => if σ l = 0 then a l + s l + e l else s l) -
      ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => τ ≠ σ ∧ ∀ l, σ l = 1 → τ l = 1),
        Λ (patternPiece a s e τ) := by
  set A : Fin 4 → Finset (Fin 3) := fun l => if σ l = 0 then Finset.univ else {1}
  have hval : (fun l => if σ l = 0 then a l + s l + e l else s l) =
      fun l => ∑ j ∈ A l, ![a l, s l, e l] j := by
    funext l
    simp only [A]
    split_ifs
    · simp [Fin.sum_univ_three, add_assoc]
    · simp
  have hexp : Λ (fun l => if σ l = 0 then a l + s l + e l else s l) =
      ∑ τ ∈ Fintype.piFinset A, Λ (patternPiece a s e τ) := by
    rw [hval, MultilinearMap.map_sum_finset]
    rfl
  have hσmem : σ ∈ Fintype.piFinset A := by
    rw [Fintype.mem_piFinset]
    intro l
    simp only [A]
    split_ifs with h
    · exact Finset.mem_univ _
    · have h2 := hσ l
      have : σ l = 1 := by
        have hl := (σ l).isLt
        exact Fin.ext (by
          have h0 : (σ l).val ≠ 0 := fun hv => h (Fin.ext hv)
          have h2' : (σ l).val ≠ 2 := fun hv => h2 (Fin.ext hv)
          simp only [Fin.val_one]; omega)
      rw [this]; exact Finset.mem_singleton_self _
  have hpi : Fintype.piFinset A = insert σ (Finset.univ.filter fun τ : Fin 4 → Fin 3 =>
      τ ≠ σ ∧ ∀ l, σ l = 1 → τ l = 1) := by
    ext τ
    simp only [Fintype.mem_piFinset, Finset.mem_insert, Finset.mem_filter, Finset.mem_univ,
      true_and, A]
    constructor
    · intro hτ
      by_cases hts : τ = σ
      · exact Or.inl hts
      · refine Or.inr ⟨hts, fun l hl => ?_⟩
        have := hτ l
        rw [hl] at this
        simpa using this
    · rintro (rfl | ⟨-, hτ⟩) l
      · exact (Fintype.mem_piFinset.mp hσmem) l
      · split_ifs with h
        · exact Finset.mem_univ _
        · have h2 := hσ l
          have : σ l = 1 := by
            have hl := (σ l).isLt
            exact Fin.ext (by
              have h0 : (σ l).val ≠ 0 := fun hv => h (Fin.ext hv)
              have h2' : (σ l).val ≠ 2 := fun hv => h2 (Fin.ext hv)
              simp only [Fin.val_one]; omega)
          rw [hτ l this]; exact Finset.mem_singleton_self _
  rw [hexp, hpi, Finset.sum_insert (by simp)]
  ring

open Classical in
/-- The corrections of `form_restore_cores` contain an error or more sides than the pattern. -/
theorem restore_correction_sides (σ τ : Fin 4 → Fin 3) (hσ : ∀ l, σ l ≠ 2) (hne : τ ≠ σ)
    (hτ : ∀ l, σ l = 1 → τ l = 1) :
    (∃ l, τ l = 2) ∨ patternCount σ 1 < patternCount τ 1 := by
  by_cases he : ∃ l, τ l = 2
  · exact Or.inl he
  · right
    push Not at he
    obtain ⟨l, hl⟩ := Function.ne_iff.mp hne
    have hσl : σ l = 0 := by
      have h2 := hσ l
      by_contra h0
      have : σ l = 1 := by
        have hl' := (σ l).isLt
        exact Fin.ext (by
          have h0' : (σ l).val ≠ 0 := fun hv => h0 (Fin.ext hv)
          have h2' : (σ l).val ≠ 2 := fun hv => h2 (Fin.ext hv)
          simp only [Fin.val_one]; omega)
      exact hl (by rw [this, hτ l this])
    have hτl : τ l = 1 := by
      have h2 := he l
      have hl' := (τ l).isLt
      exact Fin.ext (by
        have h0' : (τ l).val ≠ 0 := fun hv => hl (Fin.ext (by rw [hv, hσl]; rfl))
        have h2' : (τ l).val ≠ 2 := fun hv => h2 (Fin.ext hv)
        simp only [Fin.val_one]; omega)
    unfold patternCount
    refine Finset.card_lt_card ⟨fun x hx => ?_, fun hsub => ?_⟩
    · simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx ⊢
      exact hτ x hx
    · have := hsub (Finset.mem_filter.mpr ⟨Finset.mem_univ l, hτl⟩)
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at this
      rw [hσl] at this
      exact absurd this (by decide)


open Classical in
/-- Blueprint lines 2373-2378 (`eq:three-sides` integrated along paths): cell weights `a, b, c ≥ 0`
whose squares have retained path sums at most `C_a, C_b, C_c` everywhere satisfy
`Σ_I |I| (a_I b_I c_I)^p ≤ (C_a C_b C_c)^{p/2} |R|` for `2/3 < p`. -/
theorem power_cost_bound (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (a b c : ℤ × ℤ → ℝ)
    (ha : ∀ I ∈ S, 0 ≤ a I) (hb : ∀ I ∈ S, 0 ≤ b I) (hc : ∀ I ∈ S, 0 ≤ c I) (root : ℤ × ℤ)
    (hR : ∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G root.1 root.2) {Ca Cb Cc : ℝ}
    (hCa : ∀ x, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2), a I ^ 2 ≤ Ca)
    (hCb : ∀ x, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2), b I ^ 2 ≤ Cb)
    (hCc : ∀ x, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2), c I ^ 2 ≤ Cc)
    {p : ℝ} (hp : 2 / 3 < p) :
    ∑ I ∈ S, dyadicGridLength G I.1 * (a I * b I * c I) ^ p ≤
      Ca ^ (p / 2) * Cb ^ (p / 2) * Cc ^ (p / 2) * dyadicGridLength G root.1 := by
  have hp0 : 0 ≤ p / 2 := by linarith only [hp]
  set f : ℝ → ℝ := fun x => ∑ I ∈ S, (dyadicGridCell G I.1 I.2).indicator
    (fun _ => (a I * b I * c I) ^ p) x
  rw [dyadicPathIntegral_real G S _ (dyadicGridCell G root.1 root.2) hR]
  have hpt : ∀ x, f x ≤ Ca ^ (p / 2) * Cb ^ (p / 2) * Cc ^ (p / 2) := by
    intro x
    have hfx : f x = ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2),
        (a I * b I * c I) ^ p := by
      simp only [f, Finset.sum_filter, Set.indicator_apply]
    rw [hfx]
    have hT := three_sides_power (S.filter fun I => x ∈ dyadicGridCell G I.1 I.2) a b c
      (fun I hI => ha I (Finset.mem_filter.mp hI).1) (fun I hI => hb I (Finset.mem_filter.mp hI).1)
      (fun I hI => hc I (Finset.mem_filter.mp hI).1) hp
    refine hT.trans ?_
    have h0a : 0 ≤ ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2), a I ^ 2 :=
      Finset.sum_nonneg fun _ _ => sq_nonneg _
    have h0b : 0 ≤ ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2), b I ^ 2 :=
      Finset.sum_nonneg fun _ _ => sq_nonneg _
    have h0c : 0 ≤ ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2), c I ^ 2 :=
      Finset.sum_nonneg fun _ _ => sq_nonneg _
    have h1 := Real.rpow_le_rpow h0a (hCa x) hp0
    have h2 := Real.rpow_le_rpow h0b (hCb x) hp0
    have h3 := Real.rpow_le_rpow h0c (hCc x) hp0
    have hCa0 : 0 ≤ Ca := h0a.trans (hCa x)
    have hCb0 : 0 ≤ Cb := h0b.trans (hCb x)
    exact mul_le_mul (mul_le_mul h1 h2 (Real.rpow_nonneg h0b _) (Real.rpow_nonneg hCa0 _)) h3
      (Real.rpow_nonneg h0c _) (mul_nonneg (Real.rpow_nonneg hCa0 _) (Real.rpow_nonneg hCb0 _))
  have hint : IntegrableOn f (dyadicGridCell G root.1 root.2) := by
    refine integrable_finsetSum _ fun I hI => ?_
    apply (integrable_indicator_iff (dyadicGridCell_measurable G I.1 I.2)).mpr
    change Integrable _ ((volume.restrict _).restrict (dyadicGridCell G I.1 I.2))
    rw [Measure.restrict_restrict_of_subset (hR I hI)]
    exact integrableOn_const (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_ne_top)
  calc ∫ x in dyadicGridCell G root.1 root.2, f x ≤
      ∫ _x in dyadicGridCell G root.1 root.2, Ca ^ (p / 2) * Cb ^ (p / 2) * Cc ^ (p / 2) :=
        setIntegral_mono_on hint (integrableOn_const (by
          rw [dyadicGridCell_volume]; exact ENNReal.ofReal_ne_top))
          (dyadicGridCell_measurable G root.1 root.2) fun x _ => hpt x
    _ = _ := by
        rw [setIntegral_const, smul_eq_mul, Measure.real, dyadicGridCell_volume,
          ENNReal.toReal_ofReal (dyadicGridLength_pos G root.1).le]
        ring


/-- `ℓ^r ⊆ ℓ²` for `r ≥ 2`: `Σ a_i^r ≤ (Σ a_i²)^{r/2}` for nonnegative `a`. -/
theorem sum_rpow_le_sum_sq_rpow {ι : Type*} (s : Finset ι) (a : ι → ℝ) (ha : ∀ i ∈ s, 0 ≤ a i)
    {r : ℝ} (hr : 2 ≤ r) : ∑ i ∈ s, a i ^ r ≤ (∑ i ∈ s, a i ^ 2) ^ (r / 2) := by
  set S := ∑ i ∈ s, a i ^ 2
  have hS0 : 0 ≤ S := Finset.sum_nonneg fun i _ => sq_nonneg _
  have hai : ∀ i ∈ s, a i ^ 2 ≤ S := fun i hi =>
    Finset.single_le_sum (f := fun i => a i ^ 2) (fun j _ => sq_nonneg _) hi
  have hpt : ∀ i ∈ s, a i ^ r ≤ a i ^ 2 * S ^ ((r - 2) / 2) := by
    intro i hi
    have h0 := ha i hi
    have hsplit : a i ^ r = a i ^ (2 : ℝ) * (a i ^ (2 : ℝ)) ^ ((r - 2) / 2) := by
      rw [← Real.rpow_mul h0, ← Real.rpow_add' h0 (by linarith only [hr])]
      congr 1; ring
    rw [hsplit, Real.rpow_two]
    apply mul_le_mul_of_nonneg_left _ (sq_nonneg _)
    exact Real.rpow_le_rpow (sq_nonneg _) (hai i hi) (by linarith)
  calc ∑ i ∈ s, a i ^ r ≤ ∑ i ∈ s, a i ^ 2 * S ^ ((r - 2) / 2) := Finset.sum_le_sum hpt
    _ = S * S ^ ((r - 2) / 2) := by rw [← Finset.sum_mul]
    _ = S ^ (r / 2) := by
        rcases hS0.eq_or_lt with h | h
        · rw [← h, zero_mul, Real.zero_rpow (by linarith only [hr])]
        · rw [← Real.rpow_one_add' hS0 (by linarith)]; congr 1; ring

/-- Blueprint `eq:three-sides` (line 2380): for `2/3 < p ≤ 1` and nonnegative group sizes,
`Σ_s (a_s b_s c_s)^p ≤ Π_{x = a,b,c} (Σ_s x_s²)^{p/2}`. -/
theorem three_sides_power {ι : Type*} (s : Finset ι) (a b c : ι → ℝ) (ha : ∀ i ∈ s, 0 ≤ a i)
    (hb : ∀ i ∈ s, 0 ≤ b i) (hc : ∀ i ∈ s, 0 ≤ c i) {p : ℝ} (hp : 2 / 3 < p) :
    ∑ i ∈ s, (a i * b i * c i) ^ p ≤
      (∑ i ∈ s, a i ^ 2) ^ (p / 2) * (∑ i ∈ s, b i ^ 2) ^ (p / 2) *
        (∑ i ∈ s, c i ^ 2) ^ (p / 2) := by
  have hp0 : 0 < p := by linarith only [hp]
  set x : ι → ℝ := fun i => a i ^ p
  set y : ι → ℝ := fun i => b i ^ p
  set z : ι → ℝ := fun i => c i ^ p
  have hx : ∀ i ∈ s, 0 ≤ x i := fun i hi => Real.rpow_nonneg (ha i hi) p
  have hy : ∀ i ∈ s, 0 ≤ y i := fun i hi => Real.rpow_nonneg (hb i hi) p
  have hz : ∀ i ∈ s, 0 ≤ z i := fun i hi => Real.rpow_nonneg (hc i hi) p
  have hprod : ∀ i ∈ s, (a i * b i * c i) ^ p = x i * (y i * z i) := by
    intro i hi
    rw [Real.mul_rpow (mul_nonneg (ha i hi) (hb i hi)) (hc i hi),
      Real.mul_rpow (ha i hi) (hb i hi)]
    ring
  -- Hölder with exponents `3` and `3/2`
  have hconj : (3 : ℝ).HolderConjugate (3 / 2) := by
    rw [Real.holderConjugate_iff]; norm_num
  have h1 := Real.inner_le_Lp_mul_Lq_of_nonneg s hconj hx
    (fun i hi => mul_nonneg (hy i hi) (hz i hi))
  -- Cauchy–Schwarz for `Σ y^{3/2} z^{3/2}`
  have hyz : ∑ i ∈ s, (y i * z i) ^ (3 / 2 : ℝ) ≤
      Real.sqrt (∑ i ∈ s, y i ^ (3 : ℝ)) * Real.sqrt (∑ i ∈ s, z i ^ (3 : ℝ)) := by
    have hcs := Real.sum_mul_le_sqrt_mul_sqrt s (fun i => y i ^ (3 / 2 : ℝ))
      (fun i => z i ^ (3 / 2 : ℝ))
    have e1 : ∀ i ∈ s, (y i * z i) ^ (3 / 2 : ℝ) = y i ^ (3 / 2 : ℝ) * z i ^ (3 / 2 : ℝ) :=
      fun i hi => Real.mul_rpow (hy i hi) (hz i hi)
    have e2 : ∀ (w : ι → ℝ), (∀ i ∈ s, 0 ≤ w i) →
        ∑ i ∈ s, (w i ^ (3 / 2 : ℝ)) ^ 2 = ∑ i ∈ s, w i ^ (3 : ℝ) := by
      intro w hw
      apply Finset.sum_congr rfl; intro i hi
      rw [← Real.rpow_natCast, ← Real.rpow_mul (hw i hi)]; norm_num
    rw [Finset.sum_congr rfl e1, ← e2 y hy, ← e2 z hz]
    exact hcs
  have hY0 : 0 ≤ ∑ i ∈ s, y i ^ (3 : ℝ) :=
    Finset.sum_nonneg fun i hi => Real.rpow_nonneg (hy i hi) _
  have hZ0 : 0 ≤ ∑ i ∈ s, z i ^ (3 : ℝ) :=
    Finset.sum_nonneg fun i hi => Real.rpow_nonneg (hz i hi) _
  have hX0 : 0 ≤ ∑ i ∈ s, x i ^ (3 : ℝ) :=
    Finset.sum_nonneg fun i hi => Real.rpow_nonneg (hx i hi) _
  have h2 : (∑ i ∈ s, (y i * z i) ^ (3 / 2 : ℝ)) ^ (1 / (3 / 2 : ℝ)) ≤
      (∑ i ∈ s, y i ^ (3 : ℝ)) ^ (1 / 3 : ℝ) * (∑ i ∈ s, z i ^ (3 : ℝ)) ^ (1 / 3 : ℝ) := by
    have hL0 : 0 ≤ ∑ i ∈ s, (y i * z i) ^ (3 / 2 : ℝ) :=
      Finset.sum_nonneg fun i hi => Real.rpow_nonneg (mul_nonneg (hy i hi) (hz i hi)) _
    calc _ ≤ (Real.sqrt (∑ i ∈ s, y i ^ (3 : ℝ)) * Real.sqrt (∑ i ∈ s, z i ^ (3 : ℝ))) ^
          (1 / (3 / 2 : ℝ)) := Real.rpow_le_rpow hL0 hyz (by norm_num)
      _ = _ := by
          rw [Real.mul_rpow (Real.sqrt_nonneg _) (Real.sqrt_nonneg _), Real.sqrt_eq_rpow,
            Real.sqrt_eq_rpow, ← Real.rpow_mul hY0, ← Real.rpow_mul hZ0]
          norm_num
  -- `ℓ^{3p} ⊆ ℓ²`
  have hmono : ∀ (w : ι → ℝ), (∀ i ∈ s, 0 ≤ w i) →
      (∑ i ∈ s, (w i ^ p) ^ (3 : ℝ)) ^ (1 / 3 : ℝ) ≤ (∑ i ∈ s, w i ^ 2) ^ (p / 2) := by
    intro w hw
    have e : ∀ i ∈ s, (w i ^ p) ^ (3 : ℝ) = w i ^ (3 * p) := fun i hi => by
      rw [← Real.rpow_mul (hw i hi)]; ring_nf
    rw [Finset.sum_congr rfl e]
    have hm := sum_rpow_le_sum_sq_rpow s w hw (r := 3 * p) (by linarith)
    have hW0 : 0 ≤ ∑ i ∈ s, w i ^ (3 * p) :=
      Finset.sum_nonneg fun i hi => Real.rpow_nonneg (hw i hi) _
    calc (∑ i ∈ s, w i ^ (3 * p)) ^ (1 / 3 : ℝ) ≤
        ((∑ i ∈ s, w i ^ 2) ^ (3 * p / 2)) ^ (1 / 3 : ℝ) :=
          Real.rpow_le_rpow hW0 hm (by norm_num)
      _ = _ := by
          rw [← Real.rpow_mul (Finset.sum_nonneg fun i _ => sq_nonneg _)]; ring_nf
  rw [Finset.sum_congr rfl hprod]
  calc ∑ i ∈ s, x i * (y i * z i) ≤ (∑ i ∈ s, x i ^ (3 : ℝ)) ^ (1 / 3 : ℝ) *
        (∑ i ∈ s, (y i * z i) ^ (3 / 2 : ℝ)) ^ (1 / (3 / 2 : ℝ)) := h1
    _ ≤ (∑ i ∈ s, x i ^ (3 : ℝ)) ^ (1 / 3 : ℝ) *
        ((∑ i ∈ s, y i ^ (3 : ℝ)) ^ (1 / 3 : ℝ) * (∑ i ∈ s, z i ^ (3 : ℝ)) ^ (1 / 3 : ℝ)) :=
        mul_le_mul_of_nonneg_left h2 (Real.rpow_nonneg hX0 _)
    _ ≤ (∑ i ∈ s, a i ^ 2) ^ (p / 2) * ((∑ i ∈ s, b i ^ 2) ^ (p / 2) *
        (∑ i ∈ s, c i ^ 2) ^ (p / 2)) := by
        gcongr
        · exact hmono a ha
        · exact hmono b hb
        · exact hmono c hc
    _ = _ := by ring


section DefectIntertwine
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- A selected band defect of cell steps on restricted global inputs is the defect of the global
steps, for a form that sees only the restrictions. -/
theorem defTerm_intertwine (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {P : ℕ}
    (r : E →L[ℂ] E) (hr2 : ∀ y, r (r y) = r y)
    (hloc : ∀ x y : Fin 4 → E, (∀ l, r (x l) = r (y l)) → Λ x = Λ y)
    {a c d : Fin 4} (sel : ℕ → ℕ → Prop)
    [DecidableRel sel] (sg sl : Bool × (Fin P → E →L[ℂ] E) × (Fin P → E →L[ℂ] E))
    (hs : StepRel r sg sl) (gr lr gp lp : List (Bool × (Fin P → E →L[ℂ] E) × (Fin P → E →L[ℂ] E)))
    (hrr : List.Forall₂ (StepRel r) gr lr) (hpp : List.Forall₂ (StepRel r) gp lp)
    (xg xl : Fin 4 → E) (hx : ∀ l, l ≠ a → l ≠ c → l ≠ d → r (xg l) = r (xl l))
    (yc yd xa : E) :
    defTerm Λ P a c d xl (r yc) (r yd) sel (padStep sl) (lr.map padStep)
        (helpPre P (lp.map padStep) (r xa)) =
      defTerm Λ P a c d xg yc yd sel (padStep sg) (gr.map padStep)
        (helpPre P (gp.map padStep) xa) := by
  obtain ⟨vg, Ag, Bg⟩ := sg
  obtain ⟨vl, Al, Bl⟩ := sl
  obtain ⟨hs1, hs2, hs3⟩ := hs
  simp only at hs1 hs2 hs3
  subst hs1
  have hc : ∀ v (y : E), r (chainVal P v (gr.map padStep) y) =
      chainVal P v (lr.map padStep) (r y) := fun v y => chainVal_intertwine r v gr lr hrr y
  have hA : ∀ n, r (padFam Ag n (helpPre P (gp.map padStep) xa)) =
      padFam Al n (r (helpPre P (gp.map padStep) xa)) := fun n =>
    padFam_intertwine r _ _ hs2 n _
  have hB : ∀ n y, r (padFam Bg n y) = padFam Bl n (r y) := fun n y =>
    padFam_intertwine r _ _ hs3 n y
  unfold defTerm
  rw [← helpPre_intertwine r gp lp hpp xa]
  refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
  congr 1
  refine hloc _ _ fun l => ?_
  simp only [padStep]
  cases vg <;>
  · simp only [Bool.false_eq_true, ite_true, ite_false, Function.update_apply]
    split_ifs <;> (try simp only [map_sub, ← hc, ← hB, ← hA, hr2])
    exact (hx l (by assumption) (by assumption) (by assumption)).symm

end DefectIntertwine

section MaskNesting
variable {V : Type*} [Fintype V]

/-! ### Nested pads of one depth (blueprint line 2388, "pad bands are orthogonal at one cell") -/

/-- The cell column ranges are monotone in the mask labels. -/
theorem cellColumnRange_mono_mask (D : ColumnTreeData V) {A₁ A₂ : InheritedColumnMask D}
    {c : ℤ × ℤ} (hc : c ∈ D.cells) (hA : A₁.labels c ⊆ A₂.labels c) :
    cellColumnRange D A₁ hc ≤ cellColumnRange D A₂ hc := by
  unfold cellColumnRange
  refine Submodule.span_mono ?_
  rintro _ ⟨v, rfl⟩
  exact ⟨⟨v.1, hA v.2⟩, rfl⟩

/-- The partition column ranges are monotone in the mask labels. -/
theorem partitionColumnRange_mono_mask (D : ColumnTreeData V) {A₁ A₂ : InheritedColumnMask D}
    (π : ColumnStoppingPartition D) (hA : ∀ c ∈ D.cells, A₁.labels c ⊆ A₂.labels c) :
    partitionColumnRange D A₁ π ≤ partitionColumnRange D A₂ π := by
  unfold partitionColumnRange
  exact iSup_mono fun c => cellColumnRange_mono_mask D (π.subset c.property)
    (hA c.1 (π.subset c.property))

/-- The depth projections with nested masks are nested. -/
theorem ColumnDepthFamily.proj_mask_nested (Ψ : ColumnDepthFamily V)
    {A₁ A₂ : InheritedColumnMask Ψ.D} (hA : ∀ c ∈ Ψ.D.cells, A₁.labels c ⊆ A₂.labels c)
    (h : ℤ) : ((Ψ.withMask A₁).proj h).comp ((Ψ.withMask A₂).proj h) =
      (Ψ.withMask A₁).proj h := by
  have hle := partitionColumnRange_mono_mask Ψ.D (Ψ.partition h) hA
  change (partitionColumnRange Ψ.D A₁ (Ψ.partition h)).starProjection.comp
      (partitionColumnRange Ψ.D A₂ (Ψ.partition h)).starProjection =
    (partitionColumnRange Ψ.D A₁ (Ψ.partition h)).starProjection
  exact Submodule.starProjection_comp_starProjection_of_le hle

end MaskNesting

section PadFamC
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-! ### The pad families of a band step after its helper prefix (blueprint lines 2408-2420) -/

/-- The pad family `Q_0 = 0`, `Q_p` for `1 ≤ p ≤ P`, `Q_p = 1` beyond, as continuous maps. -/
noncomputable def padFamC {P : ℕ} (Q : Fin P → E →L[ℂ] E) (n : ℕ) : E →L[ℂ] E :=
  if n = 0 then 0 else if h : n - 1 < P then Q ⟨n - 1, h⟩ else ContinuousLinearMap.id ℂ E

theorem padFam_apply_eq {P : ℕ} (Q : Fin P → E →L[ℂ] E) (n : ℕ) (y : E) :
    padFam Q n y = padFamC Q n y := by
  unfold padFam padFamC
  split_ifs <;> rfl

/-- The pad family of nested star projections is a nested family of star projections, so its
bands are Bessel. -/
theorem padFamC_bessel [CompleteSpace E] {P : ℕ} (Q : Fin P → E →L[ℂ] E)
    (hQ : ∀ p, IsStarProjection (Q p))
    (hnest : ∀ p p' : Fin P, p ≤ p' → (Q p).comp (Q p') = Q p) (y : E) :
    ∑ p ∈ Finset.range (P + 1), ‖(padFamC Q (p + 1) - padFamC Q p) y‖ ^ 2 ≤ ‖y‖ ^ 2 := by
  refine bands_bessel (padFamC Q) (P + 1) (fun n _ => ?_) (fun i hi j hj hij => ?_) y
  · unfold padFamC
    split_ifs
    · exact IsStarProjection.zero _
    · exact hQ _
    · rw [← ContinuousLinearMap.one_def]; exact IsStarProjection.one _
  · unfold padFamC
    by_cases hi0 : i = 0
    · simp [hi0]
    · have hj0 : j ≠ 0 := by omega
      simp only [hi0, hj0, ite_false]
      by_cases hiP : i - 1 < P
      · by_cases hjP : j - 1 < P
        · simp only [hiP, hjP, ↓reduceDIte]
          exact hnest _ _ (Fin.mk_le_mk.mpr (by omega))
        · simp only [hiP, hjP, ↓reduceDIte]
          exact ContinuousLinearMap.comp_id _
      · have hjP : ¬ j - 1 < P := by omega
        simp only [hiP, hjP, ↓reduceDIte]
        exact ContinuousLinearMap.id_comp _

end PadFamC

section FreezeFour
variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-! ### Frozen complements (blueprint lines 2386-2394) -/

/-- Blueprint lines 2388-2393 (freezing both complements and splitting the unbounded frozen one):
`Λ(Y, F) = Λ(Y_b, F_b) + Λ(Y - Y_b, F) + Λ(Y, F - F_b) - Λ(Y - Y_b, F - F_b)` in two slots. -/
theorem freeze_four (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {e f : Fin 4} (hef : e ≠ f)
    (x : Fin 4 → E) (Yc Yb Fc Fb : E) :
    Λ (Function.update (Function.update x e Yc) f Fc) =
      Λ (Function.update (Function.update x e Yb) f Fb) +
        Λ (Function.update (Function.update x e (Yc - Yb)) f Fc) +
        Λ (Function.update (Function.update x e Yc) f (Fc - Fb)) -
        Λ (Function.update (Function.update x e (Yc - Yb)) f (Fc - Fb)) := by
  have hc : ∀ A B : E, Λ (Function.update (Function.update x e A) f B) =
      Λ (Function.update (Function.update x f B) e A) := fun A B => by
    rw [Function.update_comm hef]
  rw [Λ.map_update_sub, Λ.map_update_sub, hc (Yc - Yb), hc (Yc - Yb), Λ.map_update_sub,
    Λ.map_update_sub, ← hc Yc, ← hc Yb, ← hc Yc, ← hc Yb]
  ring

end FreezeFour

section BandCellBound

/-- Cauchy-Schwarz for a finite sum of products of norms. -/
theorem sum_mul_le_sqrt_mul_sqrt {β : Type*} (u : Finset β) (a b : β → ℝ) :
    ∑ p ∈ u, a p * b p ≤ Real.sqrt (∑ p ∈ u, a p ^ 2) * Real.sqrt (∑ p ∈ u, b p ^ 2) := by
  rw [← Real.sqrt_mul (Finset.sum_nonneg fun _ _ => sq_nonneg _)]
  exact Real.le_sqrt_of_sq_le (Finset.sum_mul_sq_le_sq_mul_sq u a b)

/-- A product over the four slots, for four distinct slots. -/
theorem prod_fin4_distinct {a b e f : Fin 4} (hab : a ≠ b) (hae : a ≠ e) (haf : a ≠ f)
    (hbe : b ≠ e) (hbf : b ≠ f) (hef : e ≠ f) (g : Fin 4 → ℝ) :
    ∏ l, g l = g a * g b * g e * g f := by
  have hu : ({a, b, e, f} : Finset (Fin 4)) = Finset.univ := by
    refine Finset.eq_univ_of_card _ ?_
    rw [Finset.card_insert_of_notMem (by simp [hab, hae, haf]),
      Finset.card_insert_of_notMem (by simp [hbe, hbf]), Finset.card_pair hef]
    rfl
  rw [← hu, Finset.prod_insert (by simp [hab, hae, haf]),
    Finset.prod_insert (by simp [hbe, hbf]), Finset.prod_pair hef]
  ring

end BandCellBound

section DefectRange
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- `chainDefectSel_eq_sum` with the steps indexed by `range` and `getD`. -/
theorem chainDefectSel_eq_sum_range (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) (P : ℕ)
    (a c d : Fin 4) (x : Fin 4 → E) (yc yd : E) (sel : ℕ → ℕ → Prop) [DecidableRel sel]
    (steps : List (TransferStep E)) (xa : E) (dflt : TransferStep E) :
    chainDefectSel Λ P a c d x yc yd sel steps xa =
      ∑ j ∈ Finset.range steps.length, defTerm Λ P a c d x yc yd sel (steps.getD j dflt)
        (steps.drop (j + 1)) (helpPre P (steps.take j) xa) := by
  rw [chainDefectSel_eq_sum, ← Fin.sum_univ_eq_sum_range]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [List.getD_eq_getElem _ _ j.2]
  rfl

end DefectRange

/-! ### Power costs of three strong factors with group sums (blueprint lines 2372-2384) -/

/-- `(Σ t)^p ≤ Σ t^p` for nonnegative terms and `0 ≤ p ≤ 1`. -/
theorem rpow_finsetSum_le {ι : Type*} (s : Finset ι) (t : ι → ℝ) (ht : ∀ i ∈ s, 0 ≤ t i)
    {p : ℝ} (hp : 0 < p) (hp1 : p ≤ 1) : (∑ i ∈ s, t i) ^ p ≤ ∑ i ∈ s, t i ^ p := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    rw [Real.zero_rpow hp.ne']
  | insert a s has ih =>
    rw [Finset.sum_insert has, Finset.sum_insert has]
    have h0 : 0 ≤ ∑ i ∈ s, t i :=
      Finset.sum_nonneg fun i hi => ht i (Finset.mem_insert_of_mem hi)
    refine (Real.rpow_add_le_add_rpow (ht a (Finset.mem_insert_self a s)) h0 hp.le hp1).trans
      ?_
    exact add_le_add le_rfl (ih fun i hi => ht i (Finset.mem_insert_of_mem hi))



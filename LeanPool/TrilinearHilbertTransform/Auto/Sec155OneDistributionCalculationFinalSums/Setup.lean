      K * c.2.2 i ^ (-2 : ℝ)) :
    (∑ G ∈ Gs, ∑ s ∈ S G, (((D.withQ0 (qG G)).fourPathE G h xs cellOf (ancOf G) c κ s).card : ℝ) ^
        (1 - (1 / 300 : ℝ) / 4)) * (∏ i, c.2.2 i) ^ (1 - (1 / 300 : ℝ) / 4) ≤
      16 / 3 * fourMult D.S.dmax (D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ)) c.1 (2 * c.2.1) ^
          (3 / 4 : ℝ) *
        (3 * 10 ^ 11 * (1 + Real.logb 2 (2 + ((D.S.dmax : ℝ) + 1) ^ 2 *

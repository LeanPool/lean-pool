open Classical in
/-- Blueprint `eq:total-count` for three cores in terms of the role counts: for any two distinct
roles (core or side), `Σ_s N_s ≤ L₀ M_i M_j`, and `N_s ≤ M_a M_b` for two distinct core roles. -/
theorem three_total_pair {Cj CA CT CK : ℕ} {δs W : ℝ} (hV : D.S.Valid Cj CA CT CK δs W)
    (hCA : 1 ≤ CA) (hd2 : 2 ≤ D.S.dmax) (hD : 2 ≤ D.S.Dstar) (hB : 2 ≤ D.S.Bstar)
    (hΔ : D.SP.Δ = 10) (G : bf.Grp) (h : ℕ) (hh : 10 ≤ h) (l : Fin 4) (Cs : Finset (ℤ × ℤ))
    (rep : ∀ j, ℕ → ℕ → ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hrep : ∀ j, D.RepOK G j h Cs (rep j)) (hΛ : ∀ j, 8 * (D.Ms j G).Λ ≤ D.S.Ξ) (z : ChartTag)
    (hz : ∀ j, (D.Ms j G).zc = z) {S : Finset ℤ} {cellOf : ℤ → ℤ × ℤ} {xs : ℝ}
    (hpath : ∀ s ∈ S, cellOf s ∈ Cs ∧ xs ∈ dyadicGridCell A.G (cellOf s).1 (cellOf s).2)
    (hcell : ∀ s, (cellOf s).1 = s)
    {ancOf : ∀ s, D.AncNe3 G (cellOf s) l → ℕ → ∀ j, j ≠ l → Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G
      (D.preAt (cellOf s)) (A.blkStart D.S.K (cellOf s).1 - 4 * D.S.K))}
    (hanc : D.ThreePathAnc G h l Cs rep hrep cellOf ancOf S) {Iw : ℕ}
    (hIw : (2 : ℝ) ^ Iw ≤ 2 * D.U0) (c : ℝ × ℝ × ℕ × ℝ × (Fin 4 → ℝ))
    (hc : 0 < c.1 ∧ c.1 ≤ 1 ∧ 1 ≤ c.2.1) (κ : Fin 4 → ℕ × ℕ) :
    (∀ i j, i ≠ j → ∑ s ∈ S, ((D.threePathE G h xs l cellOf ancOf Iw c κ s).card : ℝ) ≤
      threeMult z.dim (D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ)) c.1 (2 * c.2.1) *
        D.threeRoleCount G h xs l cellOf ancOf Iw c κ S i *
        D.threeRoleCount G h xs l cellOf ancOf Iw c κ S j) ∧
    (∀ a b, a ≠ b → a ≠ l → b ≠ l → ∀ s ∈ S,
      ((D.threePathE G h xs l cellOf ancOf Iw c κ s).card : ℝ) ≤
        D.threeRoleCount G h xs l cellOf ancOf Iw c κ S a *
          D.threeRoleCount G h xs l cellOf ancOf Iw c κ S b) := by
  set E := D.threePathE G h xs l cellOf ancOf Iw c κ with hEdef
  set m := D.threeRoleCount G h xs l cellOf ancOf Iw c κ S with hmdef
  set L₀ := threeMult z.dim (D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ)) c.1 (2 * c.2.1) with hL₀
  have hA1 : (1 : ℝ) ≤ D.S.A0 := le_trans (by norm_num) D.hA
  have hB1 : 1 ≤ D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ) := by
    have h1 : (1 : ℝ) ≤ D.S.Dstar ^ 5 := one_le_pow₀ (by linarith)
    have h2 : (1 : ℝ) ≤ D.S.Eh (h - D.SP.Δ) := one_le_pow₀ hA1
    nlinarith
  have hL1 : 1 ≤ L₀ := one_le_threeMult _ hB1 hc.1 (by linarith [hc.2.1, hc.2.2])
  have hm0 : ∀ k, 0 ≤ m k := fun k => by
    rw [hmdef]; unfold threeRoleCount
    split_ifs
    · exact Finset.sum_nonneg fun s _ => D.sideWeight_nonneg G l cellOf _ s
    · exact Nat.cast_nonneg _
  have hmcore : ∀ k, k ≠ l → m k =
      ((S.biUnion fun s => (E s).image fun x => x k).card : ℝ) := fun k hk => by
    rw [hmdef]; unfold threeRoleCount; simp only [hk, ↓reduceIte, hEdef]
  have hmside : m l = ∑ s ∈ S, D.sideWeight G l cellOf c.2.2.2.1 s := by
    rw [hmdef]; unfold threeRoleCount; simp only [↓reduceIte]
  obtain ⟨htot1, htot2, htot3⟩ := D.three_core_total_side hV hCA hd2 hD hB hΔ G h hh l Cs rep hrep
    hΛ z hz hpath hcell hanc hIw c κ
  refine ⟨fun i j hij => ?_, fun a b hab hal hbl s hs => ?_⟩
  · by_cases hil : i = l
    · subst hil
      have hjl : j ≠ i := fun e => hij e.symm
      rw [hmside, hmcore j hjl]
      calc _ ≤ _ := htot2 j hjl
        _ = 1 * ((∑ s ∈ S, D.sideWeight G i cellOf c.2.2.2.1 s) *
            ((S.biUnion fun s => (E s).image fun x => x j).card : ℝ)) := by ring
        _ ≤ L₀ * ((∑ s ∈ S, D.sideWeight G i cellOf c.2.2.2.1 s) *
            ((S.biUnion fun s => (E s).image fun x => x j).card : ℝ)) :=
          mul_le_mul_of_nonneg_right hL1 (mul_nonneg (by rw [← hmside]; exact hm0 _)
            (Nat.cast_nonneg _))
        _ = _ := by ring
    by_cases hjl : j = l
    · subst hjl
      rw [hmside, hmcore i hil]
      calc _ ≤ _ := htot2 i hil
        _ = 1 * (((S.biUnion fun s => (E s).image fun x => x i).card : ℝ) *
            ∑ s ∈ S, D.sideWeight G j cellOf c.2.2.2.1 s) := by ring
        _ ≤ L₀ * (((S.biUnion fun s => (E s).image fun x => x i).card : ℝ) *
            ∑ s ∈ S, D.sideWeight G j cellOf c.2.2.2.1 s) :=
          mul_le_mul_of_nonneg_right hL1 (mul_nonneg (Nat.cast_nonneg _)
            (by rw [← hmside]; exact hm0 _))
        _ = _ := by ring
    rw [hmcore i hil, hmcore j hjl]
    exact htot1 i j hij hil hjl
  · rw [hmcore a hal, hmcore b hbl]
    exact htot3 a b hab hal hbl s hs

open Classical in
/-- Blueprint lines 2783-2800 for three cores with side role `l` on the side states: at a fixed
path, height, core types and bin `c = (μ, ν, i, σ_l, σ)`, the groups' powered counts
(`eq:total-count` for every pair, `M' ≤ Σ_k M_k^G`), the path caps of `eq:top-count` for the core
roles (`Σ_G |A_j^G| ≤ K σ_j^{-2}`) and the side cap `Σ_G M_l^G ≤ K σ_l^{-2}` (`eq:side-cap`,
`M_l^G = σ_l^{-2} Σ_s ‖S_{l,G,s}‖²_{2,I_s}`), and Hölder over the groups give, with `p = 1 - c/4`,
`c = 1/300` and the amplitude tuple `threeAmp = (σ_l, σ_j)`,
`(Σ_G Σ_s (N_s^G)^p) (Π σ)^p ≤ (16/3) L₀^{3/4} (C ℓ L₀^{12})^{1/4} K^{2-c/2}`,
with `L₀, ℓ` taken at the dimension bound `d_max`. -/
theorem three_group_sum_side {Cj CA CT CK : ℕ} {δs W : ℝ} (hV : D.S.Valid Cj CA CT CK δs W)
    (hCA : 1 ≤ CA) (hCT : 4 ≤ CT) (hd2 : 2 ≤ D.S.dmax) (hD : 2 ≤ D.S.Dstar)
    (hB : 2 ≤ D.S.Bstar) (_hQ0 : 1 ≤ D.S.Q0) (hSP : D.SP = D.S.sideParams δs)
    (hdD : (D.S.dmax : ℝ) ≤ D.S.Dstar) (qG : bf.Grp → ℕ) (hqG : ∀ G, 1 ≤ qG G ∧ qG G ≤ D.S.Q0) (Gs :
        Finset bf.Grp) (h : ℕ) (hh : 10 ≤ h)
    (hhJ : h ≤ D.SP.Jst) (l : Fin 4) (Cs : Finset (ℤ × ℤ))
    (rep : ∀ G j, ℕ → ℕ → ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md) (z : bf.Grp → ChartTag)
    (S : bf.Grp → Finset ℤ) {cellOf : ℤ → ℤ × ℤ} {xs : ℝ}
    (hpath : ∀ G ∈ Gs, ∀ s ∈ S G,
      cellOf s ∈ Cs ∧ xs ∈ dyadicGridCell A.G (cellOf s).1 (cellOf s).2)
    (hcell : ∀ s, (cellOf s).1 = s)
    (ancOf : ∀ G s, D.AncNe3 G (cellOf s) l → ℕ → ∀ j, j ≠ l → Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G
      (D.preAt (cellOf s)) (A.blkStart D.S.K (cellOf s).1 - 4 * D.S.K)))
    (hG : ∀ G ∈ Gs, (∀ j, 8 * (D.Ms j G).Λ ≤ D.S.Ξ) ∧ (∀ j, (D.Ms j G).zc = z G) ∧
      (z G).dim ≤ D.S.dmax ∧ ∃ hrep : ∀ j, (D.withQ0 (qG G)).RepOK G j h Cs (rep G j),
        (D.withQ0 (qG G)).ThreePathAnc G h l Cs (rep G) hrep cellOf (ancOf G) (S G))
    {Iw : ℕ} (hIw : (2 : ℝ) ^ Iw ≤ 2 * D.U0) (c : ℝ × ℝ × ℕ × ℝ × (Fin 4 → ℝ))
    (hc : 0 < c.1 ∧ c.1 ≤ 1 ∧ 1 ≤ c.2.1) (hσ : ∀ i, 0 < threeAmp l c i)
    (κ : Fin 4 → ℕ × ℕ) {K : ℝ} (hK : 0 ≤ K)
    (hcap : ∀ i (hi : i ≠ l), ∑ G ∈ Gs,
      (((D.withQ0 (qG G)).threeUsedReps G h xs l cellOf (ancOf G) Iw c κ (S G) i hi).card : ℝ) ≤
        K * threeAmp l c i ^ (-2 : ℝ))
    (hcapl : ∑ G ∈ Gs, ∑ s ∈ S G, (D.withQ0 (qG G)).sideWeight G l cellOf c.2.2.2.1 s ≤
      K * threeAmp l c l ^ (-2 : ℝ)) :
    (∑ G ∈ Gs, ∑ s ∈ S G, (((D.withQ0 (qG G)).threePathE G h xs l cellOf (ancOf G) Iw c κ s).card :
        ℝ) ^
        (1 - (1 / 300 : ℝ) / 4)) * (∏ i, threeAmp l c i) ^ (1 - (1 / 300 : ℝ) / 4) ≤
      16 / 3 * threeMult D.S.dmax (D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ)) c.1 (2 * c.2.1) ^
          (3 / 4 : ℝ) *
        (3 * 10 ^ 11 * (1 + Real.logb 2 (2 + ((D.S.dmax : ℝ) + 1) ^ 2 * ((2 * c.2.1) / c.1))) *
          threeMult D.S.dmax (D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ)) c.1 (2 * c.2.1) ^ 12) ^
          (1 / 4 : ℝ) * K ^ (2 - (1 / 300 : ℝ) / 2) := by
  have hΔ : D.SP.Δ = 10 := by rw [hSP]; rfl
  set! E := fun G => (D.withQ0 (qG G)).threePathE G h xs l cellOf (ancOf G) Iw c κ with hEdef
  set! Mc : Fin 4 → bf.Grp → ℝ := fun i G =>
    (D.withQ0 (qG G)).threeRoleCount G h xs l cellOf (ancOf G) Iw c κ (S G) i with hMc
  set Lm := threeMult D.S.dmax (D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ)) c.1 (2 * c.2.1) with hLm
  set ℓm := 1 + Real.logb 2 (2 + ((D.S.dmax : ℝ) + 1) ^ 2 * ((2 * c.2.1) / c.1)) with hℓm
  have hA1 : (1 : ℝ) ≤ D.S.A0 := le_trans (by norm_num) D.hA
  have hB1 : 1 ≤ D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ) := by
    have h1 : (1 : ℝ) ≤ D.S.Dstar ^ 5 := one_le_pow₀ (by linarith)
    have h2 : (1 : ℝ) ≤ D.S.Eh (h - D.SP.Δ) := one_le_pow₀ hA1
    nlinarith only [h1, h2]
  have hμν : c.1 ≤ 2 * c.2.1 := by linarith [hc.2.1, hc.2.2]
  have hLm1 : 1 ≤ Lm := one_le_threeMult _ hB1 hc.1 hμν
  have hx0 : 0 ≤ (2 * c.2.1) / c.1 := div_nonneg (by linarith [hc.2.2]) hc.1.le
  have hℓm1 : 1 ≤ ℓm := by
    have := Real.logb_nonneg (b := 2) (by norm_num)
      (by nlinarith only [sq_nonneg ((D.S.dmax : ℝ) + 1), hx0] :
        (1 : ℝ) ≤ 2 + ((D.S.dmax : ℝ) + 1) ^ 2 * ((2 * c.2.1) / c.1))
    rw [hℓm]; linarith
  have hm0 : ∀ G k, 0 ≤ Mc k G := fun G k => by
    simp only [hMc]; unfold threeRoleCount
    split_ifs
    · exact Finset.sum_nonneg fun s _ => (D.withQ0 (qG G)).sideWeight_nonneg G l cellOf _ s
    · exact Nat.cast_nonneg _
  set! Gs' := Gs.filter fun G => ∃ s ∈ S G, (E G s).Nonempty with hGs'
  have hzero : ∀ G ∈ Gs, G ∉ Gs' → ∑ s ∈ S G, ((E G s).card : ℝ) ^ (1 - (1 / 300 : ℝ) / 4) = 0 := by
    intro G hG hG'
    have hne : ∀ s ∈ S G, E G s = ∅ := fun s hs => by
      by_contra hne'
      exact hG' (Finset.mem_filter.mpr ⟨hG, s, hs, Finset.nonempty_iff_ne_empty.mpr hne'⟩)
    exact rpow_sum_zero_of_empty (fun s hs => by simp only [hne s hs, Finset.card_empty,

  set Lm := fourMult D.S.dmax (D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ)) c.1 (2 * c.2.1) with hLm
  set ℓm := 1 + Real.logb 2 (2 + ((D.S.dmax : ℝ) + 1) ^ 2 * ((4 * (2 * c.2.1)) / c.1))
    with hℓm
  have hA1 : (1 : ℝ) ≤ D.S.A0 := le_trans (by norm_num) D.hA

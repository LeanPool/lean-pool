    have : 0 ≤ Real.logb 2 (hi / lo) :=
      Real.logb_nonneg (by norm_num) (by rw [le_div_iff₀ hlo]; linarith)
    linarith
  have hne : T.Nonempty := Finset.nonempty_iff_ne_empty.mpr hTe
  set a := T.min' hne
  set b := T.max' hne
  have hsub : T ⊆ Finset.Icc a b := fun k hk =>
    Finset.mem_Icc.mpr ⟨T.min'_le k hk, T.le_max' k hk⟩
  have hcard : (T.card : ℝ) ≤ ((b - a + 1 : ℤ) : ℝ) := by
    have h := Finset.card_le_card hsub
    rw [Int.card_Icc] at h
    have hab : a ≤ b := T.min'_le _ (T.max'_mem hne)
    have : ((b + 1 - a).toNat : ℝ) = ((b - a + 1 : ℤ) : ℝ) := by
      rw [show b + 1 - a = b - a + 1 by ring]
      exact_mod_cast Int.toNat_of_nonneg (by omega)
    rw [← this]; exact_mod_cast h
  have ha := hT a (T.min'_mem hne)
  have hb := hT b (T.max'_mem hne)
  -- `2^(b - a) ≤ hi / lo`
  have hpow : (2 : ℝ) ^ (b - a) ≤ hi / lo := by
    rw [zpow_sub₀ (by norm_num), div_le_div_iff₀ (by positivity) hlo]
    nlinarith [hb.2, ha.1, zpow_pos (by norm_num : (0 : ℝ) < 2) a,
      zpow_pos (by norm_num : (0 : ℝ) < 2) b]
  have hlog : ((b - a : ℤ) : ℝ) ≤ Real.logb 2 (hi / lo) := by
    rw [Real.le_logb_iff_rpow_le (by norm_num) (div_pos (by linarith) hlo), Real.rpow_intCast]
    exact hpow
  calc (T.card : ℝ) ≤ ((b - a + 1 : ℤ) : ℝ) := hcard
    _ = ((b - a : ℤ) : ℝ) + 1 := by push_cast; ring
    _ ≤ Real.logb 2 (hi / lo) + 1 := by linarith


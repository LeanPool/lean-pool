open Classical in
/-- The square of the dyadic band of the component size of a successful class at an actual cell is
at most the node size `σ_F²` of its mode node (`compSizeSq`, the quantity of `prop:tops`). -/
theorem band_sq_le_nodeSize (G : bf.Grp) (I : ℤ × ℤ) (j : Fin 4) (h : ℕ)
    {F : Finset (D.Ms j G).Md} (hF : F ∈ D.goodCls G I j h) (hpos : 0 < D.clsSize G I j F) :
    dyadicBand (D.clsSize G I j F) ^ 2 ≤
      (D.Ms j G).nodeSize D.S D.hA D.SP (D.c j G) h (I, D.classNode G I j h hF) := by
  set m := (D.Ms j G).goodRep D.S D.hA D.SP (D.hasGoodRep_of_mem_goodCls hF) with hm
  have hspec := (D.Ms j G).goodRep_spec D.S D.hA D.SP (D.hasGoodRep_of_mem_goodCls hF)
  have hfin : D.finCls G I j h m = F := hspec.2
  have hns := (D.Ms j G).nodeSize_eq D.S D.hA D.SP (D.c j G) h (p := (I, D.classNode G I j h hF))
    (D.classNode_alive hF)
  have hcs := D.clsSize_finCls G I j h m
  rw [hfin] at hcs
  have e : (⟨(D.classNode G I j h hF).2.2, D.classNode_alive hF⟩ :
      (D.Ms j G).alive (ancAt A.G (D.classNode G I j h hF).2.1
        ((D.classNode G I j h hF).1 - 4 * D.S.K))) = m := rfl
  rw [hns, e]
  have h0 : 0 ≤ (D.Ms j G).compSizeSq D.S D.hA D.SP I (A.blkStart D.S.K I.1) (D.preAt I) h m
      (D.c j G (A.blkStart D.S.K I.1) (D.preAt I)) := by
    unfold ModeSystem.compSizeSq
    exact Finset.sum_nonneg fun _ _ => sq_nonneg _
  have hle := dyadicBand_le hpos
  have hb0 := (dyadicBand_pos (D.clsSize G I j F)).le
  calc dyadicBand (D.clsSize G I j F) ^ 2 ≤ D.clsSize G I j F ^ 2 := pow_le_pow_left₀ hb0 hle 2
    _ = _ := by rw [hcs, Real.sq_sqrt h0]; rfl

open Classical in
/-- Blueprint `eq:top-count` on a four-core path (bridge to `prop:tops`, `first_top_count_main`):
the distinct used representatives `A_j^G` of the role `j` along the path in the bin `c` are values
of the representatives `R.rep` of `first_top_count_main` on use instances `(I, node)` with
`x* ∈ I` and `σ_j² ≤ σ_F²`, provided the representatives of type `κ j` are those of `R` on its
nodes `Nd`, the class nodes of type `κ j` lie in `Nd`, and the path cells are actual-use cells. -/
theorem four_usedReps_subset_tops (G : bf.Grp) (h : ℕ) (xs : ℝ) (cellOf : ℤ → ℤ × ℤ)
    (Cs : Finset (ℤ × ℤ)) (rep : ∀ j, ℕ → ℕ → ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hrep : ∀ j, D.RepOK G j h Cs (rep j)) {S : Finset ℤ}
    (hpath : ∀ s ∈ S, cellOf s ∈ Cs ∧ xs ∈ dyadicGridCell A.G (cellOf s).1 (cellOf s).2)
    {ancOf : ∀ s, D.AncNe G (cellOf s) → ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G
      (D.preAt (cellOf s)) (A.blkStart D.S.K (cellOf s).1 - 4 * D.S.K))}
    (hanc : D.FourPathAnc G h Cs rep hrep cellOf ancOf S) (c : ℝ × ℝ × (Fin 4 → ℝ))
    (κ : Fin 4 → ℕ × ℕ) (j : Fin 4) (Nd : Finset (ℤ × (ℤ × ℤ) × (D.Ms j G).Md))
    (Rrep : ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hR : ∀ nd ∈ Nd, Rrep nd = rep j (κ j).1 (κ j).2 nd)
    (hNd : ∀ s ∈ S, ∀ F (hF : F ∈ D.goodCls G (cellOf s) j h),
      D.classTypeOf G (cellOf s) j h F = κ j → D.classNode G (cellOf s) j h hF ∈ Nd)
    (huse : ∀ s ∈ S, cellOf s ∈ A.cells ∧ fp.ActualUse G (cellOf s)) :
    D.fourUsedReps G h xs cellOf ancOf c κ S j ⊆
      ((fp.useInst G D.S.K Nd).filter fun p => p.1 ∈ Cs ∧ xs ∈ dyadicGridCell A.G p.1.1 p.1.2 ∧
        c.2.2 j ^ 2 ≤ (D.Ms j G).nodeSize D.S D.hA D.SP (D.c j G) h p).image
        fun p => Rrep p.2 := by
  intro m hm
  unfold fourUsedReps at hm
  obtain ⟨s, hs, hm⟩ := Finset.mem_biUnion.mp hm
  split_ifs at hm with hA
  swap
  · exact absurd hm (Finset.notMem_empty _)
  obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hm
  obtain ⟨hpT, hc, hκ⟩ := Finset.mem_filter.mp hp
  have hpT' := hpT
  unfold fourTested fourTestedOf at hpT'
  obtain ⟨hpi, -, hpos⟩ := Finset.mem_filter.mp hpT'
  have hF : p j ∈ D.goodCls G (cellOf s) j h := Fintype.mem_piFinset.mp hpi j
  have htype : D.classTypeOf G (cellOf s) j h (p j) =
      ((D.Ms j G).nodeType1 D.S D.hA 10 h (D.classNode G (cellOf s) j h hF),
        (D.Ms j G).nodeType2 D.S D.hA 10 h (D.classNode G (cellOf s) j h hF)) := by
    unfold classTypeOf
    simp only [hF, ↓reduceDIte]
  have hκj := (hκ j).symm.trans htype
  have hndN := hNd s hs (p j) hF (hκ j)
  have hcj : c.2.2 j = dyadicBand (D.clsSize G (cellOf s) j (p j)) := by rw [← hc]; rfl
  refine Finset.mem_image.mpr ⟨(cellOf s, D.classNode G (cellOf s) j h hF),
    Finset.mem_filter.mpr ⟨?_, (hpath s hs).1, (hpath s hs).2, ?_⟩, ?_⟩
  · unfold useInst
    have hb := blkStart_bounds D.hK (cellOf s).1 (A := A)
    exact Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨(huse s hs).1, hndN⟩, (huse s hs).2,
      D.subset_preAt (cellOf s), hb.1, hb.2⟩
  · rw [hcj]
    exact D.band_sq_le_nodeSize G (cellOf s) j h hF (hpos j)
  · change Rrep (D.classNode G (cellOf s) j h hF) = (ancOf s hA h j (p j)).1
    rw [hR _ hndN, hanc s hs hA j (p j) hF, hκj]
    rfl


open Classical in
/-- Blueprint `eq:top-count` on a three-core path with side role `l` (bridge to `prop:tops`): the
distinct used representatives of a core role `j ≠ l` are values of the representatives `R.rep` on
use instances `(I, node)` with `x* ∈ I` and `σ_j² ≤ σ_F²`. -/
theorem three_usedReps_subset_tops (G : bf.Grp) (h : ℕ) (xs : ℝ) (l : Fin 4)
    (cellOf : ℤ → ℤ × ℤ) (Cs : Finset (ℤ × ℤ))
    (rep : ∀ j, ℕ → ℕ → ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hrep : ∀ j, D.RepOK G j h Cs (rep j)) {S : Finset ℤ}
    (hpath : ∀ s ∈ S, cellOf s ∈ Cs ∧ xs ∈ dyadicGridCell A.G (cellOf s).1 (cellOf s).2)
    {ancOf : ∀ s, D.AncNe3 G (cellOf s) l → ℕ → ∀ j, j ≠ l → Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G
      (D.preAt (cellOf s)) (A.blkStart D.S.K (cellOf s).1 - 4 * D.S.K))}
    (hanc : D.ThreePathAnc G h l Cs rep hrep cellOf ancOf S) (Iw : ℕ)
    (c : ℝ × ℝ × ℕ × ℝ × (Fin 4 → ℝ)) (κ : Fin 4 → ℕ × ℕ) (j : Fin 4) (hj : j ≠ l)
    (Nd : Finset (ℤ × (ℤ × ℤ) × (D.Ms j G).Md))
    (Rrep : ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hR : ∀ nd ∈ Nd, Rrep nd = rep j (κ j).1 (κ j).2 nd)
    (hNd : ∀ s ∈ S, ∀ F (hF : F ∈ D.goodCls G (cellOf s) j h),
      D.classTypeOf G (cellOf s) j h F = κ j → D.classNode G (cellOf s) j h hF ∈ Nd)
    (huse : ∀ s ∈ S, cellOf s ∈ A.cells ∧ fp.ActualUse G (cellOf s)) :
    D.threeUsedReps G h xs l cellOf ancOf Iw c κ S j hj ⊆
      ((fp.useInst G D.S.K Nd).filter fun p => p.1 ∈ Cs ∧ xs ∈ dyadicGridCell A.G p.1.1 p.1.2 ∧
        c.2.2.2.2 j ^ 2 ≤ (D.Ms j G).nodeSize D.S D.hA D.SP (D.c j G) h p).image
        fun p => Rrep p.2 := by
  intro m hm
  unfold threeUsedReps at hm
  obtain ⟨s, hs, hm⟩ := Finset.mem_biUnion.mp hm
  split_ifs at hm with hA
  swap
  · exact absurd hm (Finset.notMem_empty _)
  obtain ⟨q, hq, rfl⟩ := Finset.mem_image.mp hm
  obtain ⟨hqT, hc, hκ⟩ := Finset.mem_filter.mp hq
  have hqT' := hqT
  unfold threeTested threeTestedOf at hqT'
  obtain ⟨hmem, -, -, hpos⟩ := Finset.mem_filter.mp hqT'
  have hF : q.1 j ∈ D.goodCls G (cellOf s) j h := by
    have := Fintype.mem_piFinset.mp (Finset.mem_product.mp hmem).1 j
    simpa only [hj, ↓reduceIte] using this
  have htype : D.classTypeOf G (cellOf s) j h (q.1 j) =
      ((D.Ms j G).nodeType1 D.S D.hA 10 h (D.classNode G (cellOf s) j h hF),
        (D.Ms j G).nodeType2 D.S D.hA 10 h (D.classNode G (cellOf s) j h hF)) := by
    unfold classTypeOf
    simp only [hF, ↓reduceDIte]
  have hκj := (hκ j hj).symm.trans htype
  have hndN := hNd s hs (q.1 j) hF (hκ j hj)
  have hcj : c.2.2.2.2 j = dyadicBand (D.clsSize G (cellOf s) j (q.1 j)) := by rw [← hc]; rfl
  refine Finset.mem_image.mpr ⟨(cellOf s, D.classNode G (cellOf s) j h hF),
    Finset.mem_filter.mpr ⟨?_, (hpath s hs).1, (hpath s hs).2, ?_⟩, ?_⟩
  · unfold useInst
    have hb := blkStart_bounds D.hK (cellOf s).1 (A := A)
    exact Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨(huse s hs).1, hndN⟩, (huse s hs).2,
      D.subset_preAt (cellOf s), hb.1, hb.2⟩
  · rw [hcj]
    exact D.band_sq_le_nodeSize G (cellOf s) j h hF (hpos j hj)
  · change Rrep (D.classNode G (cellOf s) j h hF) = (ancOf s hA h j hj (q.1 j)).1
    rw [hR _ hndN, hanc s hs hA j hj (q.1 j) hF, hκj]
    rfl

end SideInput


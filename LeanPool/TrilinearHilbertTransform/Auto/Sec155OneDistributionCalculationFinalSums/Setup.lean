      rw [← Real.rpow_add hσ1]; ring_nf
    have e3 : σ 3 ^ (-2 * e) * σ 3 ^ (1 - c / 4) = σ 3 ^ (3 * c / 4) := by
      rw [← Real.rpow_add hσ3, he]; ring_nf

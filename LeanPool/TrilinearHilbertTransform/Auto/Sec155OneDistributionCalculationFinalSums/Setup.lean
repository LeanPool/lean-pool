/-- `L₀ = fourMult` is monotone in the dimension. -/
theorem fourMult_mono_dim {d d' : ℕ} (hdd : d ≤ d') {B μ ν : ℝ} (hB : 1 ≤ B) (hμ : 0 < μ)
    (hμν : μ ≤ ν) : fourMult d B μ ν ≤ fourMult d' B μ ν := by
  unfold fourMult
  have h1 : 0 ≤ Real.log (2 * (36 * (4 * B))) := Real.log_nonneg (by linarith)
  have h2 : 0 ≤ Real.log (2 * (4 * ν) / μ) :=
    Real.log_nonneg (by rw [le_div_iff₀ hμ]; linarith)
  have hd : ((4 + d : ℕ) + 1 : ℝ) ≤ ((4 + d' : ℕ) + 1 : ℝ) := by
    have : ((4 + d : ℕ) : ℝ) ≤ ((4 + d' : ℕ) : ℝ) := by exact_mod_cast (by omega : 4 + d ≤ 4 + d')
    linarith
  gcongr

/-- `L₀ = threeMult` is monotone in the dimension. -/
theorem threeMult_mono_dim {d d' : ℕ} (hdd : d ≤ d') {B μ ν : ℝ} (hB : 1 ≤ B) (hμ : 0 < μ)
    (hμν : μ ≤ ν) : threeMult d B μ ν ≤ threeMult d' B μ ν := by
  unfold threeMult
  have h1 : 0 ≤ Real.log (2 * (36 * B)) := Real.log_nonneg (by linarith)
  have h2 : 0 ≤ Real.log (2 * ν / μ) := Real.log_nonneg (by rw [le_div_iff₀ hμ]; linarith)
  have hd : ((4 + d : ℕ) + 1 : ℝ) ≤ ((4 + d' : ℕ) + 1 : ℝ) := by
    have : ((4 + d : ℕ) : ℝ) ≤ ((4 + d' : ℕ) : ℝ) := by exact_mod_cast (by omega : 4 + d ≤ 4 + d')
    linarith
  gcongr

/-- The coefficient `ℓ = 1 + log₂(2 + (d+1)² x)` is monotone in the dimension (`x ≥ 0`). -/
theorem ell_mono_dim {d d' : ℕ} (hdd : d ≤ d') {x : ℝ} (hx : 0 ≤ x) :
    1 + Real.logb 2 (2 + ((d : ℝ) + 1) ^ 2 * x) ≤ 1 + Real.logb 2 (2 + ((d' : ℝ) + 1) ^ 2 * x) := by
  have hd : ((d : ℝ) + 1) ^ 2 ≤ ((d' : ℝ) + 1) ^ 2 :=
    pow_le_pow_left₀ (by positivity) (by have := (Nat.cast_le (α := ℝ)).mpr hdd; linarith) 2
  have : 2 + ((d : ℝ) + 1) ^ 2 * x ≤ 2 + ((d' : ℝ) + 1) ^ 2 * x := by nlinarith
  have hp : 0 < 2 + ((d : ℝ) + 1) ^ 2 * x := by positivity
  linarith [Real.logb_le_logb_of_le (b := 2) (by norm_num) hp this]


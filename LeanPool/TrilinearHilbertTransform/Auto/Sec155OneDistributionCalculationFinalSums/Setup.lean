namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

open Classical in
/-- The groups used at the cells of `T` containing `y`. -/
noncomputable def pathGroups (T : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset bf.Grp) (y : ℝ) :
    Finset bf.Grp :=
  (T.filter fun I => y ∈ dyadicGridCell A.G I.1 I.2).biUnion gs

open Classical in
/-- The depths of the cells of `T` containing `y` at which the group `G` is used. -/
noncomputable def pathDepths (T : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset bf.Grp) (y : ℝ)
    (G : bf.Grp) : Finset ℤ :=
  ((T.filter fun I => y ∈ dyadicGridCell A.G I.1 I.2).filter fun I => G ∈ gs I).image Prod.fst

open Classical in
theorem mem_pathDepths {T : Finset (ℤ × ℤ)} {gs : ℤ × ℤ → Finset bf.Grp} {y : ℝ} {G : bf.Grp}
    {s : ℤ} (hs : s ∈ pathDepths (A := A) T gs y G) :
    pathCell A.G T y s ∈ T ∧ y ∈ dyadicGridCell A.G (pathCell A.G T y s).1
      (pathCell A.G T y s).2 ∧ G ∈ gs (pathCell A.G T y s) := by
  unfold pathDepths at hs
  obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hs
  obtain ⟨hI1, hI2⟩ := Finset.mem_filter.mp hI
  obtain ⟨hIT, hy⟩ := Finset.mem_filter.mp hI1
  rw [pathCell_eq A.G hIT hy]
  exact ⟨hIT, hy, hI2⟩

open Classical in
/-- The retained occupied four-core bins (all amplitudes at least `ε`) at a cell, group and
height. -/
noncomputable def fourRetBins (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ)
    (anc : ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) (h : ℕ)
    (ε : ℝ) : Finset (ℝ × ℝ × (Fin 4 → ℝ)) :=
  ((D.fourTested G I xs anc h).image (D.fourBinOf G I xs anc h)).filter
    fun c => ∀ j, ε ≤ c.2.2 j

open Classical in
/-- The number of tested four-core tuples in the bin `c` with the role types `κ`. -/
noncomputable def fourCnt (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ)
    (anc : ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) (h : ℕ)
    (c : ℝ × ℝ × (Fin 4 → ℝ)) (κ : Fin 4 → ℕ × ℕ) : ℝ :=
  (((D.fourTested G I xs anc h).filter fun p => D.fourBinOf G I xs anc h p = c ∧
    ∀ j, D.classTypeOf G I j h (p j) = κ j).card : ℝ)

open Classical in
/-- The retained occupied four-core bins at a cell and group, with anchors depending on a proof of
`AncNe G I` (the alive sets of the roles at the decision cell are nonempty); empty otherwise (no
anchors, no alive modes, no tested tuples). -/
noncomputable def fourRetBinsA (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ)
    (anc : D.AncNe G I → ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) (h : ℕ)
    (ε : ℝ) : Finset (ℝ × ℝ × (Fin 4 → ℝ)) :=
  if hA : D.AncNe G I then D.fourRetBins G I xs (anc hA) h ε else ∅

open Classical in
/-- The number of tested four-core tuples in the bin `c` with the role types `κ`, with anchors
depending on a proof of `AncNe G I`; zero otherwise. -/
noncomputable def fourCntA (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ)
    (anc : D.AncNe G I → ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) (h : ℕ)
    (c : ℝ × ℝ × (Fin 4 → ℝ)) (κ : Fin 4 → ℕ × ℕ) : ℝ :=
  if hA : D.AncNe G I then D.fourCnt G I xs (anc hA) h c κ else 0

theorem fourCntA_nonneg {G : bf.Grp} {I : ℤ × ℤ} {xs : ℝ}
    {anc : D.AncNe G I → ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))} {h : ℕ}
    {c : ℝ × ℝ × (Fin 4 → ℝ)} {κ : Fin 4 → ℕ × ℕ} : 0 ≤ D.fourCntA G I xs anc h c κ := by
  unfold fourCntA fourCnt
  split_ifs
  · exact Nat.cast_nonneg _
  · exact le_rfl

open Classical in
/-- The four-core bin sum `Σ_c v(c) N_c` of the tested tuples at a cell, group and height (the
principal quantity of `eq:principal-core`), with anchors depending on a proof of `AncNe G I`; zero
otherwise. -/
noncomputable def fourBinSumA (J : ℕ) (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ)
    (anc : D.AncNe G I → ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) (h : ℕ) :
    ℝ :=
  if hA : D.AncNe G I then
    ∑ c ∈ (D.fourTested G I xs (anc hA) h).image (D.fourBinOf G I xs (anc hA) h),
      fourBinVal κ' J c *
        (((D.fourTested G I xs (anc hA) h).filter fun p =>
          D.fourBinOf G I xs (anc hA) h p = c).card : ℝ)
  else 0

open Classical in
/-- Blueprint lines 2783-2806 at one point, height, type tuple and four-core bin `c`: along the path
of `y` through the retained cells `T` (groups `g(I)`, anchors the representatives), the powered
principal quantities `(Q · v(c) · N_{I,G})^p`, `v(c)` the bin value, sum to at most
`(Q C_J 2 · 12⁴ μ ν^{-J})^p · C_c (1 + log(8ν/μ))⁴ · K^{2-c/2}`, given the path caps of
`eq:top-count` at `y` (`four_group_sum_side`, `powered_bin_sum`, `four_coef_sched`). -/
theorem four_path_bin_bound {Cj CA CT CK : ℕ} {δs W : ℝ} (hV : D.S.Valid Cj CA CT CK δs W)
    (hCA : 1 ≤ CA) (hCT : 4 ≤ CT) (hd2 : 2 ≤ D.S.dmax) (hD : 2 ≤ D.S.Dstar)
    (hB : 2 ≤ D.S.Bstar) (hQ0 : 1 ≤ D.S.Q0) (hSP : D.SP = D.S.sideParams δs)
    (hdD : (D.S.dmax : ℝ) ≤ D.S.Dstar) (qG : bf.Grp → ℕ) (hqG : ∀ G, 1 ≤ qG G ∧ qG G ≤ D.S.Q0) (J :
        ℕ)
        (T : Finset (ℤ × ℤ))
    (gs : ℤ × ℤ → Finset bf.Grp) (z : bf.Grp → ChartTag)
    (hGc : ∀ I ∈ T, ∀ G ∈ gs I, (∀ j, 8 * (D.Ms j G).Λ ≤ D.S.Ξ) ∧
      (∀ j, (D.Ms j G).zc = z G) ∧ (z G).dim ≤ D.S.dmax)
    (h : ℕ) (hh : 10 ≤ h) (hhJ : h ≤ D.SP.Jst)
    (rep : ∀ G j, ℕ → ℕ → ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hrep : ∀ I ∈ T, ∀ G ∈ gs I, ∀ j, (D.withQ0 (qG G)).RepOK G j h T (rep G j))
    (anc : ∀ (I : ℤ × ℤ) (G : bf.Grp), D.AncNe G I → ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K)))
    (hanc : ∀ I (hI : I ∈ T), ∀ G (hG : G ∈ gs I), ∀ (hA : D.AncNe G I) j F
      (hF : F ∈ (D.withQ0 (qG G)).goodCls G I j h),
      anc I G hA h j F = (D.withQ0 (qG G)).repAnchor G I j h (rep G j) (hrep I hI G hG j).1 hF)
    (y : ℝ) (c : ℝ × ℝ × (Fin 4 → ℝ)) (hc : 0 < c.1 ∧ c.1 ≤ 1 ∧ 1 ≤ c.2.1)
    (hσ : ∀ i, 0 < c.2.2 i) (κ : Fin 4 → ℕ × ℕ) {K Q : ℝ} (hK : 0 ≤ K) (hQ : 0 ≤ Q)
    (hcap : ∀ i, ∑ G ∈ pathGroups (A := A) T gs y, (((D.withQ0 (qG G)).fourUsedReps G h y
        (pathCell A.G T y)
      (fun s => anc (pathCell A.G T y s) G) c κ (pathDepths (A := A) T gs y G) i).card : ℝ) ≤
        K * c.2.2 i ^ (-2 : ℝ)) :
    ∑ G ∈ pathGroups (A := A) T gs y, ∑ s ∈ pathDepths (A := A) T gs y G,
      (Q * fourBinVal κ' J c * (D.withQ0 (qG G)).fourCntA G (pathCell A.G T y s) y
        (anc (pathCell A.G T y s) G) h c κ) ^ (1 - (1 / 300 : ℝ) / 4) ≤
      (Q * (fourKC κ' J * 2 * 12 ^ 4 * (c.1 * (c.2.1 ^ J)⁻¹))) ^ (1 - (1 / 300 : ℝ) / 4) *
        (16 / 3 * (3 * 10 ^ 11 : ℝ) ^ (1 / 4 : ℝ) * D.multPoly ^ (15 / 4 : ℝ) *
          D.ellPoly ^ (1 / 4 : ℝ) * (1 + Real.log (8 * c.2.1 / c.1)) ^ 4 *
          K ^ (2 - (1 / 300 : ℝ) / 2)) := by
  set p : ℝ := 1 - (1 / 300 : ℝ) / 4 with hp
  set Gy := pathGroups (A := A) T gs y with hGy
  set Sp := pathDepths (A := A) T gs y with hSp
  set cellOf := pathCell A.G T y with hcellOf
  have hpath : ∀ G ∈ Gy, ∀ s ∈ Sp G, cellOf s ∈ T ∧
      y ∈ dyadicGridCell A.G (cellOf s).1 (cellOf s).2 := fun G _ s hs =>
    ⟨(mem_pathDepths hs).1, (mem_pathDepths hs).2.1⟩
  have hcell : ∀ s, (cellOf s).1 = s := pathCell_fst A.G T y
  -- every path group has its data
  have hGdata : ∀ G ∈ Gy, ∃ I ∈ T, G ∈ gs I := fun G hG => by
    obtain ⟨I, hI, hGI⟩ := Finset.mem_biUnion.mp hG
    exact ⟨I, (Finset.mem_filter.mp hI).1, hGI⟩
  have hG : ∀ G ∈ Gy, (∀ j, 8 * (D.Ms j G).Λ ≤ D.S.Ξ) ∧ (∀ j, (D.Ms j G).zc = z G) ∧
      (z G).dim ≤ D.S.dmax ∧ ∃ hrep' : ∀ j, (D.withQ0 (qG G)).RepOK G j h T (rep G j),
        (D.withQ0 (qG G)).FourPathAnc G h T (rep G) hrep' cellOf (fun s => anc (cellOf s) G) (Sp G)
            := by
    intro G hGG
    obtain ⟨I, hIT, hGI⟩ := hGdata G hGG
    obtain ⟨hΛ, hz, hdim⟩ := hGc I hIT G hGI
    refine ⟨hΛ, hz, hdim, hrep I hIT G hGI, fun s hs hA j F hF => ?_⟩
    obtain ⟨hcT, -, hGc'⟩ := mem_pathDepths hs
    exact hanc (cellOf s) hcT G hGc' hA j F hF
  have hgs := D.four_group_sum_side hV hCA hCT hd2 hD hB hQ0 hSP hdD qG hqG Gy h hh hhJ T rep z Sp
    hpath hcell (fun G s => anc (cellOf s) G) hG c hc hσ κ hK hcap
  -- the path label counts are the tested counts
  have hcard : ∀ G ∈ Gy, ∀ s ∈ Sp G, (((D.withQ0 (qG G)).fourPathE G h y cellOf (fun s => anc
      (cellOf s) G)
      c κ s).card : ℝ) = (D.withQ0 (qG G)).fourCntA G (cellOf s) y (anc (cellOf s) G) h c κ := by
    intro G hGG s hs
    obtain ⟨hΛ, -, -, hrep', hanc'⟩ := hG G hGG
    unfold fourCntA
    split_ifs with hA
    · unfold fourCnt
      exact_mod_cast (D.withQ0 (qG G)).fourPathE_card G h T (rep G) hrep' hΛ
        (by simp only [SideInput.withQ0_S, ModeSchedule.withQ0_Dstar]; linarith) (hpath G
          hGG) hanc' c κ hs hA
    · unfold fourPathE
      rw [dite_eq_right hA, Finset.card_empty, Nat.cast_zero]
  have hcoef := D.four_coef_sched hV hd2 hD hB hQ0 hSP hhJ hc.1 hc.2.1 hc.2.2
  have hPi : 0 ≤ ∏ i, c.2.2 i := Finset.prod_nonneg fun i _ => (hσ i).le
  have hV0 : 0 ≤ Q * (fourKC κ' J * 2 * 12 ^ 4 * (c.1 * (c.2.1 ^ J)⁻¹)) := by
    have := fourKC_nonneg κ' J
    have : 0 ≤ (c.2.1 ^ J)⁻¹ := inv_nonneg.mpr (pow_nonneg (by linarith only [hc.2.2]) J)
    have := hc.1.le
    positivity
  calc ∑ G ∈ Gy, ∑ s ∈ Sp G, (Q * fourBinVal κ' J c * (D.withQ0 (qG G)).fourCntA G (cellOf s) y
        (anc (cellOf s) G) h c κ) ^ p
      = ∑ G ∈ Gy, ∑ s ∈ Sp G, (Q * (fourKC κ' J * 2 * 12 ^ 4 * (c.1 * (c.2.1 ^ J)⁻¹)) *
          (∏ i, c.2.2 i) * (((D.withQ0 (qG G)).fourPathE G h y cellOf (fun s => anc (cellOf s) G)
            c κ s).card : ℝ)) ^ p := by
        refine Finset.sum_congr rfl fun G hGG => Finset.sum_congr rfl fun s hs => ?_
        rw [hcard G hGG s hs, fourBinVal_eq]
        ring_nf
    _ ≤ (Q * (fourKC κ' J * 2 * 12 ^ 4 * (c.1 * (c.2.1 ^ J)⁻¹))) ^ p *
        ((∑ G ∈ Gy, ∑ s ∈ Sp G, (((D.withQ0 (qG G)).fourPathE G h y cellOf (fun s => anc (cellOf s)
            G)
          c κ s).card : ℝ) ^ p) * (∏ i, c.2.2 i) ^ p) := by
        rw [Finset.sum_mul, Finset.mul_sum]
        refine Finset.sum_le_sum fun G _ => ?_
        rw [Finset.sum_mul]
        refine le_of_eq ?_
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun s _ => ?_
        rw [Real.mul_rpow (mul_nonneg hV0 hPi) (Nat.cast_nonneg _), Real.mul_rpow hV0 hPi]
        ring
    _ ≤ (Q * (fourKC κ' J * 2 * 12 ^ 4 * (c.1 * (c.2.1 ^ J)⁻¹))) ^ p *
        (16 / 3 * (3 * 10 ^ 11 : ℝ) ^ (1 / 4 : ℝ) * D.multPoly ^ (15 / 4 : ℝ) *
          D.ellPoly ^ (1 / 4 : ℝ) * (1 + Real.log (8 * c.2.1 / c.1)) ^ 4 *
          K ^ (2 - (1 / 300 : ℝ) / 2)) := by
        refine mul_le_mul_of_nonneg_left (hgs.trans ?_) (Real.rpow_nonneg hV0 _)
        have hK' : 0 ≤ K ^ (2 - (1 / 300 : ℝ) / 2) := Real.rpow_nonneg hK _
        calc _ ≤ (16 / 3 * (3 * 10 ^ 11 : ℝ) ^ (1 / 4 : ℝ) * D.multPoly ^ (15 / 4 : ℝ) *
              D.ellPoly ^ (1 / 4 : ℝ) * (1 + Real.log (8 * c.2.1 / c.1)) ^ 4) *
              K ^ (2 - (1 / 300 : ℝ) / 2) := mul_le_mul_of_nonneg_right hcoef hK'
          _ = _ := by ring

end SideInput

end ActiveSetup.BasicFamilies.FamParams

theorem exists_nat_of_zpow_le_one {x : ℝ} (hx : ∃ k : ℤ, x = (2 : ℝ) ^ k) (h1 : x ≤ 1) :
    ∃ u : ℕ, x = (2 : ℝ) ^ (-(u : ℤ)) := by
  obtain ⟨k, rfl⟩ := hx
  have hk : k ≤ 0 := by
    by_contra hk
    push Not at hk
    have : (1 : ℝ) < 2 ^ k := one_lt_zpow₀ (by norm_num) hk
    linarith
  exact ⟨k.natAbs, by rw [Int.natCast_natAbs, abs_of_nonpos hk, neg_neg]⟩

theorem exists_nat_of_one_le_zpow {x : ℝ} (hx : ∃ k : ℤ, x = (2 : ℝ) ^ k) (h1 : 1 ≤ x) :
    ∃ v : ℕ, x = (2 : ℝ) ^ (v : ℤ) := by
  obtain ⟨k, rfl⟩ := hx
  have hk : 0 ≤ k := by
    by_contra hk
    push Not at hk
    have : (2 : ℝ) ^ k < 1 := zpow_lt_one_of_neg₀ (by norm_num) hk
    linarith
  exact ⟨k.toNat, by rw [Int.toNat_of_nonneg hk]⟩

open Classical in
/-- Blueprint lines 2802-2806 (sum over the occupied bins): for a finite set of four-core bins
`c = (μ, ν, σ)` with dyadic bands `μ ≤ 1 ≤ ν` and dyadic amplitudes in `[ε, U]`, the powered kernel
factors with the logarithmic coefficient sum to at most the number `(log₂(U/ε) + 1)⁴` of
amplitude quadruples times the convergent band series. -/
theorem four_bins_sum_le {p : ℝ} (hp : 0 < p) (J : ℕ) (hJ : 1 ≤ J) {ε U : ℝ} (hε : 0 < ε)
    (hεU : ε ≤ U) (B : Finset (ℝ × ℝ × (Fin 4 → ℝ)))
    (hB : ∀ c ∈ B, (∃ k : ℤ, c.1 = (2 : ℝ) ^ k) ∧ c.1 ≤ 1 ∧ (∃ k : ℤ, c.2.1 = (2 : ℝ) ^ k) ∧
      1 ≤ c.2.1 ∧ ∀ j, ε ≤ c.2.2 j ∧ c.2.2 j ≤ U ∧ ∃ k : ℤ, c.2.2 j = (2 : ℝ) ^ k) :
    ∑ c ∈ B, c.1 ^ p * ((c.2.1 ^ J)⁻¹) ^ p * (1 + Real.log (8 * c.2.1 / c.1)) ^ 4 ≤
      (Real.logb 2 (U / ε) + 1) ^ 4 * ∑' t : ℕ × ℕ, ((2 : ℝ) ^ (-p)) ^ t.1 *
        ((2 : ℝ) ^ (-((J : ℝ) * p))) ^ t.2 * (4 ^ 4 * (1 + t.1 + t.2 : ℝ) ^ 4) := by
  have hJ0 : (0 : ℝ) < J := by exact_mod_cast hJ
  set Cb := ∑' t : ℕ × ℕ, ((2 : ℝ) ^ (-p)) ^ t.1 * ((2 : ℝ) ^ (-((J : ℝ) * p))) ^ t.2 *
    (4 ^ 4 * (1 + t.1 + t.2 : ℝ) ^ 4) with hCb
  set f : ℝ × ℝ × (Fin 4 → ℝ) → ℝ := fun c =>
    c.1 ^ p * ((c.2.1 ^ J)⁻¹) ^ p * (1 + Real.log (8 * c.2.1 / c.1)) ^ 4 with hf
  rw [← Finset.sum_fiberwise_of_maps_to (g := fun c => c.2.2) (t := B.image fun c => c.2.2)
    (fun c hc => Finset.mem_image_of_mem _ hc)]
  have hfiber : ∀ σ ∈ B.image (fun c => c.2.2),
      ∑ c ∈ B.filter (fun c => c.2.2 = σ), f c ≤ Cb := by
    intro σ _
    have hinj : Set.InjOn (fun c : ℝ × ℝ × (Fin 4 → ℝ) => (c.1, c.2.1))
        (B.filter fun c => c.2.2 = σ : Set _) := by
      intro c hc d hd hcd
      simp only [Prod.mk.injEq] at hcd
      have h1 := (Finset.mem_filter.mp (Finset.mem_coe.mp hc)).2
      have h2 := (Finset.mem_filter.mp (Finset.mem_coe.mp hd)).2
      exact Prod.ext hcd.1 (Prod.ext hcd.2 (h1.trans h2.symm))
    have hT := dyadic_band_sum_le hp hJ0 ((B.filter fun c => c.2.2 = σ).image
      fun c => (c.1, c.2.1)) (fun x hx => by
        obtain ⟨c, hc, rfl⟩ := Finset.mem_image.mp hx
        obtain ⟨h1, h2, h3, h4, -⟩ := hB c (Finset.mem_filter.mp hc).1
        obtain ⟨u, hu⟩ := exists_nat_of_zpow_le_one h1 h2
        obtain ⟨v, hv⟩ := exists_nat_of_one_le_zpow h3 h4
        exact ⟨u, v, hu, hv⟩)
    rw [Finset.sum_image hinj] at hT
    refine le_trans (le_of_eq (Finset.sum_congr rfl fun c hc => ?_)) hT
    simp only [hf]
    obtain ⟨-, -, -, h4, -⟩ := hB c (Finset.mem_filter.mp hc).1
    rw [← Real.rpow_natCast]
  have hcard : ((B.image fun c => c.2.2).card : ℝ) ≤ (Real.logb 2 (U / ε) + 1) ^ 4 :=
    dyadic_quadruples_card hε hεU _ fun a ha j => by
      obtain ⟨c, hc, rfl⟩ := Finset.mem_image.mp ha
      exact (hB c hc).2.2.2.2 j
  calc ∑ σ ∈ B.image (fun c => c.2.2), ∑ c ∈ B.filter (fun c => c.2.2 = σ), f c
      ≤ ∑ _σ ∈ B.image (fun c => c.2.2), Cb := Finset.sum_le_sum hfiber
    _ = ((B.image fun c => c.2.2).card : ℝ) * Cb := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ (Real.logb 2 (U / ε) + 1) ^ 4 * Cb := by
        refine mul_le_mul_of_nonneg_right hcard ?_
        refine tsum_nonneg fun t => ?_
        positivity

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

open Classical in
/-- Below the height `Δ` there are no good modes, so no tested four-core tuples. -/
theorem fourTested_eq_empty (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ)
    (anc : ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) {h : ℕ}
    (hh : h < D.SP.Δ) : D.fourTested G I xs anc h = ∅ := by
  refine Finset.eq_empty_of_forall_notMem fun p hp => ?_
  unfold fourTested fourTestedOf at hp
  have hF := Fintype.mem_piFinset.mp (Finset.mem_filter.mp hp).1 0
  obtain ⟨m, hm, -⟩ := D.mem_goodCls hF
  exact absurd hm.1 (by omega)

open Classical in
/-- The tested tuples of a bin split by their role types, all in `[0, log₂ D_*]^{2·4}`. -/
theorem card_bin_eq_sum_types (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ)
    (anc : ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) (h : ℕ)
    (hcard : ∀ j, (((D.Ms j G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card : ℝ) ≤ D.S.Dstar)
    (c : ℝ × ℝ × (Fin 4 → ℝ)) :
    (((D.fourTested G I xs anc h).filter fun p => D.fourBinOf G I xs anc h p = c).card : ℝ) =
      ∑ κ ∈ Fintype.piFinset (fun _ : Fin 4 => Finset.range (Nat.log 2 ⌊D.S.Dstar⌋₊ + 1) ×ˢ
          Finset.range (Nat.log 2 ⌊D.S.Dstar⌋₊ + 1)),
        (((D.fourTested G I xs anc h).filter fun p => D.fourBinOf G I xs anc h p = c ∧
          ∀ j, D.classTypeOf G I j h (p j) = κ j).card : ℝ) := by
  rw [Finset.card_eq_sum_card_fiberwise (f := fun p j => D.classTypeOf G I j h (p j))
    (t := Fintype.piFinset (fun _ : Fin 4 => Finset.range (Nat.log 2 ⌊D.S.Dstar⌋₊ + 1) ×ˢ
      Finset.range (Nat.log 2 ⌊D.S.Dstar⌋₊ + 1)))
    (fun p _ => Fintype.mem_piFinset.mpr fun j => D.classTypeOf_mem G I j h _ (hcard j))]
  push_cast
  refine Finset.sum_congr rfl fun κ _ => ?_
  rw [Finset.filter_filter]
  congr 2
  ext p
  simp only [Finset.mem_filter]
  constructor
  · rintro ⟨hp, h1, h2⟩; exact ⟨hp, h1, fun j => congrFun h2 j⟩
  · rintro ⟨hp, h1, h2⟩; exact ⟨hp, h1, funext h2⟩

open Classical in
/-- A retained occupied four-core bin is genuine and dyadic: `μ ≤ 1 ≤ ν` dyadic bands and
amplitudes in `[ε, U]`, dyadic, when the class sizes are at most `U`. -/
theorem fourBin_genuine (hD : 2 ≤ D.S.Dstar) (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ)
    (anc : ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) (h : ℕ)
    {ε U : ℝ} (hU : ∀ j, ∀ F ∈ D.goodCls G I j h, D.clsSize G I j F ≤ U)
    {c : ℝ × ℝ × (Fin 4 → ℝ)}
    (hc : c ∈ ((D.fourTested G I xs anc h).image (D.fourBinOf G I xs anc h)).filter
      (fun c => ∀ j, ε ≤ c.2.2 j)) :
    ((∃ k : ℤ, c.1 = (2 : ℝ) ^ k) ∧ c.1 ≤ 1 ∧ (∃ k : ℤ, c.2.1 = (2 : ℝ) ^ k) ∧ 1 ≤ c.2.1 ∧
      ∀ j, ε ≤ c.2.2 j ∧ c.2.2 j ≤ U ∧ ∃ k : ℤ, c.2.2 j = (2 : ℝ) ^ k) ∧
      0 < c.1 ∧ (∀ i, 0 < c.2.2 i) := by
  obtain ⟨hc1, hcε⟩ := Finset.mem_filter.mp hc
  obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hc1
  have hp' := hp
  unfold fourTested fourTestedOf at hp'
  obtain ⟨hpT, hpass, hpos⟩ := Finset.mem_filter.mp hp'
  have hgood := Fintype.mem_piFinset.mp hpT
  obtain ⟨-, -, hμ3, hμ4, -, -, hν3, -⟩ := D.fourBands_spec (by linarith) (D.one_le_U0 hD) hpass
  have hU0i : 0 < D.U0⁻¹ := inv_pos.mpr (by linarith [D.one_le_U0 hD])
  refine ⟨⟨⟨_, rfl⟩, hμ4, ⟨_, rfl⟩, hν3, fun j => ⟨hcε j, ?_, ⟨_, rfl⟩⟩⟩,
    lt_trans (half_pos hU0i) hμ3, fun i => dyadicBand_pos _⟩
  exact (dyadicBand_le (hpos j)).trans (hU j _ (hgood j))

end SideInput

end ActiveSetup.BasicFamilies.FamParams

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

/-- The role-type tuples `[0, log₂ D_*]^{2·4}`. -/
noncomputable def fourTypes : Finset (Fin 4 → ℕ × ℕ) :=
  Fintype.piFinset fun _ : Fin 4 => Finset.range (Nat.log 2 ⌊D.S.Dstar⌋₊ + 1) ×ˢ
    Finset.range (Nat.log 2 ⌊D.S.Dstar⌋₊ + 1)

open Classical in
/-- The per-cell decomposition of `eq:core-final` for four cores: the principal quantity of a cell
and group at a point is at most the sum, over the heights and role types, of the retained principal
quantities `|H|⁻¹ Σ_{retained bins} v(c) N_{c,κ}`, plus the negligible-amplitude bound. -/
theorem four_principal_split (hD : 2 ≤ D.S.Dstar) (J : ℕ) (G : bf.Grp) (I : ℤ × ℤ) (y : ℝ)
    (anc : ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K)))
    (H : Finset ℕ)
    (hcard : ∀ j, (((D.Ms j G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card : ℝ) ≤ D.S.Dstar)
    {U ε : ℝ} (hU0 : 0 ≤ U) (hε : 0 ≤ ε)
    (hU : ∀ h ∈ H, ∀ j, ∀ F ∈ D.goodCls G I j h, D.clsSize G I j F ≤ U) :
    ∑ h ∈ H, (H.card : ℝ)⁻¹ * ∑ c ∈ (D.fourTested G I y anc h).image
        (D.fourBinOf G I y anc h), fourBinVal κ' J c *
          (((D.fourTested G I y anc h).filter fun p => D.fourBinOf G I y anc h p = c).card : ℝ) ≤
      ∑ h ∈ H, ∑ κ ∈ D.fourTypes, (H.card : ℝ)⁻¹ * ∑ c ∈ D.fourRetBins G I y anc h ε,
        fourBinVal κ' J c * D.fourCnt G I y anc h c κ +
      2 * fourKC κ' J * 12 ^ 4 * ε * U ^ 3 * D.S.Dstar ^ 4 := by
  -- the negligible part (as in `four_negligible_side`)
  set K₀ := 2 * fourKC κ' J * 12 ^ 4 * ε * U ^ 3 with hK₀
  have hK0 : 0 ≤ K₀ := by have := fourKC_nonneg κ' J; positivity
  have hD4 : (0 : ℝ) ≤ D.S.Dstar ^ 4 := by positivity
  have hper : ∀ h ∈ H, ∑ c ∈ ((D.fourTested G I y anc h).image
      (D.fourBinOf G I y anc h)).filter (fun c => ∃ j, c.2.2 j < ε), fourBinVal κ' J c *
        (((D.fourTested G I y anc h).filter fun p => D.fourBinOf G I y anc h p = c).card : ℝ) ≤
      K₀ * D.S.Dstar ^ 4 := fun h hh =>
    (sum_bins_filter_le _ _ _ _ hK0 fun p hp hs => D.fourBinVal_small hD J G I y anc h hε
      (hU h hh) hp hs).trans
      (mul_le_mul_of_nonneg_left (D.card_fourTested_le G I y anc h hcard) hK0)
  have hneg' : ∑ h ∈ H, (H.card : ℝ)⁻¹ * ∑ c ∈ ((D.fourTested G I y anc h).image
      (D.fourBinOf G I y anc h)).filter (fun c => ∃ j, c.2.2 j < ε), fourBinVal κ' J c *
        (((D.fourTested G I y anc h).filter fun p => D.fourBinOf G I y anc h p = c).card : ℝ) ≤
      2 * fourKC κ' J * 12 ^ 4 * ε * U ^ 3 * D.S.Dstar ^ 4 := by
    calc _ ≤ ∑ _h ∈ H, (H.card : ℝ)⁻¹ * (K₀ * D.S.Dstar ^ 4) :=
          Finset.sum_le_sum fun h hh => mul_le_mul_of_nonneg_left (hper h hh)
            (inv_nonneg.mpr (Nat.cast_nonneg _))
      _ = (H.card : ℝ) * (H.card : ℝ)⁻¹ * (K₀ * D.S.Dstar ^ 4) := by
          rw [Finset.sum_const, nsmul_eq_mul]; ring
      _ ≤ 1 * (K₀ * D.S.Dstar ^ 4) := by
          refine mul_le_mul_of_nonneg_right ?_ (mul_nonneg hK0 hD4)
          rcases (Nat.cast_nonneg (α := ℝ) H.card).eq_or_lt with h0 | h0
          · rw [← h0]; norm_num
          · rw [mul_inv_cancel₀ h0.ne']
      _ = _ := by rw [hK₀]; ring
  -- the retained part, split by the role types
  have hret : ∀ h ∈ H, ∑ c ∈ (D.fourTested G I y anc h).image (D.fourBinOf G I y anc h),
      fourBinVal κ' J c *
        (((D.fourTested G I y anc h).filter fun p => D.fourBinOf G I y anc h p = c).card : ℝ) =
      ∑ κ ∈ D.fourTypes, ∑ c ∈ D.fourRetBins G I y anc h ε,
        fourBinVal κ' J c * D.fourCnt G I y anc h c κ +
      ∑ c ∈ ((D.fourTested G I y anc h).image (D.fourBinOf G I y anc h)).filter
        (fun c => ∃ j, c.2.2 j < ε), fourBinVal κ' J c *
          (((D.fourTested G I y anc h).filter fun p =>
            D.fourBinOf G I y anc h p = c).card : ℝ) := by
    intro h _
    rw [← Finset.sum_filter_add_sum_filter_not _ (fun c => ∀ j, ε ≤ c.2.2 j)]
    congr 1
    · rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun c _ => ?_
      rw [D.card_bin_eq_sum_types G I y anc h hcard c, Finset.mul_sum]
      rfl
    · refine Finset.sum_congr ?_ fun _ _ => rfl
      ext c
      simp only [Finset.mem_filter, not_forall, not_le]
  calc _ = ∑ h ∈ H, ((H.card : ℝ)⁻¹ * ∑ κ ∈ D.fourTypes, ∑ c ∈ D.fourRetBins G I y anc h ε,
        fourBinVal κ' J c * D.fourCnt G I y anc h c κ + (H.card : ℝ)⁻¹ *
        ∑ c ∈ ((D.fourTested G I y anc h).image (D.fourBinOf G I y anc h)).filter
          (fun c => ∃ j, c.2.2 j < ε), fourBinVal κ' J c *
            (((D.fourTested G I y anc h).filter fun p =>
              D.fourBinOf G I y anc h p = c).card : ℝ)) :=
        Finset.sum_congr rfl fun h hh => by rw [hret h hh, mul_add]
    _ = _ + _ := Finset.sum_add_distrib
    _ ≤ _ := by
        refine add_le_add (le_of_eq ?_) hneg'
        refine Finset.sum_congr rfl fun h _ => ?_
        rw [Finset.mul_sum]

open Classical in
/-- `four_principal_split` with anchors depending on a proof of `AncNe G I`: without anchors both
principal quantities vanish. -/
theorem four_principal_splitA (hD : 2 ≤ D.S.Dstar) (J : ℕ) (G : bf.Grp) (I : ℤ × ℤ) (y : ℝ)
    (anc : D.AncNe G I → ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K)))
    (H : Finset ℕ)
    (hcard : ∀ j, (((D.Ms j G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card : ℝ) ≤ D.S.Dstar)
    {U ε : ℝ} (hU0 : 0 ≤ U) (hε : 0 ≤ ε)
    (hU : ∀ h ∈ H, ∀ j, ∀ F ∈ D.goodCls G I j h, D.clsSize G I j F ≤ U) :
    ∑ h ∈ H, (H.card : ℝ)⁻¹ * D.fourBinSumA J G I y anc h ≤
      ∑ h ∈ H, ∑ κ ∈ D.fourTypes, (H.card : ℝ)⁻¹ * ∑ c ∈ D.fourRetBinsA G I y anc h ε,
        fourBinVal κ' J c * D.fourCntA G I y anc h c κ +
      2 * fourKC κ' J * 12 ^ 4 * ε * U ^ 3 * D.S.Dstar ^ 4 := by
  by_cases hA : D.AncNe G I
  · simp only [fourBinSumA, fourRetBinsA, fourCntA, dite_eq_left hA]
    exact D.four_principal_split hD J G I y (anc hA) H hcard hU0 hε hU
  · simp only [fourBinSumA, fourRetBinsA, dite_eq_right hA, mul_zero, Finset.sum_const_zero,
      Finset.sum_empty, zero_add]
    have := fourKC_nonneg κ' J
    have : (0 : ℝ) ≤ D.S.Dstar := by linarith
    positivity

end SideInput

end ActiveSetup.BasicFamilies.FamParams

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

/-- The four-core frequency constant `(16/3) C^{1/4} P_w^{15/4} P_ℓ^{1/4}`. -/
noncomputable def fourCc : ℝ :=
  16 / 3 * (3 * 10 ^ 11 : ℝ) ^ (1 / 4 : ℝ) * D.multPoly ^ (15 / 4 : ℝ) * D.ellPoly ^ (1 / 4 : ℝ)

/-- The convergent band series `Σ_{u,v} 2^{-pu} 2^{-Jpv} (4(1+u+v))⁴`. -/
noncomputable def bandC (p : ℝ) (J : ℕ) : ℝ :=
  ∑' t : ℕ × ℕ, ((2 : ℝ) ^ (-p)) ^ t.1 * ((2 : ℝ) ^ (-((J : ℝ) * p))) ^ t.2 *
    (4 ^ 4 * (1 + t.1 + t.2 : ℝ) ^ 4)



end SideInput
end ActiveSetup.BasicFamilies.FamParams
end TrilinearHT.Auto

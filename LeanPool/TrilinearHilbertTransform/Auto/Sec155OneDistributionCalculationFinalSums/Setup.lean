    calc ∑ G ∈ Gs, PG G ≤ ∑ G ∈ Gs, C₀ * ∑ k, (M 0 G ^ (3 / 4 : ℝ) * M 1 G ^ (3 / 4 : ℝ) *
          M k G ^ e) := Finset.sum_le_sum hA
      _ = C₀ * ∑ k, ∑ G ∈ Gs, M 0 G ^ (3 / 4 : ℝ) * M 1 G ^ (3 / 4 : ℝ) * M k G ^ e := by
          rw [← Finset.mul_sum, Finset.sum_comm]

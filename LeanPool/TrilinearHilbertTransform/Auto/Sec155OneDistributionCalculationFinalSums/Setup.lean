open Classical in
/-- The distinct used representatives `A_j^G` of the role `j` along a four-core path (blueprint
`eq:top-count`): the anchor modes of the role `j` of the tested tuples in the bin `c` with the
types `κ` at the scales of the path. -/
noncomputable def fourUsedReps (G : bf.Grp) (h : ℕ) (xs : ℝ) (cellOf : ℤ → ℤ × ℤ)
    (ancOf : ∀ s, D.AncNe G (cellOf s) → ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G
      (D.preAt (cellOf s)) (A.blkStart D.S.K (cellOf s).1 - 4 * D.S.K)))
    (c : ℝ × ℝ × (Fin 4 → ℝ)) (κ : Fin 4 → ℕ × ℕ) (S : Finset ℤ) (j : Fin 4) :
    Finset (D.Ms j G).Md :=
  S.biUnion fun s => if hs : D.AncNe G (cellOf s) then
    ((D.fourTested G (cellOf s) xs (ancOf s hs) h).filter fun p =>
      D.fourBinOf G (cellOf s) xs (ancOf s hs) h p = c ∧
        ∀ j, D.classTypeOf G (cellOf s) j h (p j) = κ j).image fun p => (ancOf s hs h j (p j)).1
  else ∅

open Classical in
/-- The labels of a role along a four-core path are the slopes at `x*` of its distinct used
representatives, so `M_j^G ≤ |A_j^G|`. -/
theorem four_labels_card_le (G : bf.Grp) (h : ℕ) (xs : ℝ) (cellOf : ℤ → ℤ × ℤ)
    (ancOf : ∀ s, D.AncNe G (cellOf s) → ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G
      (D.preAt (cellOf s)) (A.blkStart D.S.K (cellOf s).1 - 4 * D.S.K)))
    (c : ℝ × ℝ × (Fin 4 → ℝ)) (κ : Fin 4 → ℕ × ℕ) (S : Finset ℤ) (j : Fin 4) :
    (S.biUnion fun s => (D.fourPathE G h xs cellOf ancOf c κ s).image fun x => x j).card ≤
      (D.fourUsedReps G h xs cellOf ancOf c κ S j).card := by
  refine le_trans (Finset.card_le_card fun a ha => ?_)
    (Finset.card_image_le (s := D.fourUsedReps G h xs cellOf ancOf c κ S j)
      (f := fun m => (D.Ms j G).slope m xs))
  obtain ⟨s, hs, ha⟩ := Finset.mem_biUnion.mp ha
  obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp ha
  unfold fourPathE at hx
  split_ifs at hx with hA
  · obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hx
    refine Finset.mem_image.mpr ⟨(ancOf s hA h j (p j)).1, Finset.mem_biUnion.mpr
      ⟨s, hs, ?_⟩, rfl⟩
    rw [dite_eq_left hA]
    exact Finset.mem_image.mpr ⟨p, hp, rfl⟩
  · exact absurd hx (Finset.notMem_empty _)

open Classical in
/-- The distinct used representatives `A_j^G` of a core role `j ≠ l` along a three-core path. -/
noncomputable def threeUsedReps (G : bf.Grp) (h : ℕ) (xs : ℝ) (l : Fin 4) (cellOf : ℤ → ℤ × ℤ)
    (ancOf : ∀ s, D.AncNe3 G (cellOf s) l → ℕ → ∀ j, j ≠ l → Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G
      (D.preAt (cellOf s)) (A.blkStart D.S.K (cellOf s).1 - 4 * D.S.K)))
    (Iw : ℕ) (c : ℝ × ℝ × ℕ × ℝ × (Fin 4 → ℝ)) (κ : Fin 4 → ℕ × ℕ) (S : Finset ℤ) (j : Fin 4)
    (hj : j ≠ l) : Finset (D.Ms j G).Md :=
  S.biUnion fun s => if hs : D.AncNe3 G (cellOf s) l then
    ((D.threeTested G (cellOf s) xs l (ancOf s hs) (D.toLeaf.sv l G (cellOf s)) Iw h).filter
      fun q => D.threeBinOf G (cellOf s) xs l (ancOf s hs) (D.toLeaf.sv l G (cellOf s)) h q = c ∧
        ∀ j, j ≠ l → D.classTypeOf G (cellOf s) j h (q.1 j) = κ j).image
      fun q => (ancOf s hs h j hj (q.1 j)).1
  else ∅

open Classical in
/-- The labels of a core role along a three-core path are the slopes at `x*` of its distinct used
representatives, so `M_j^G ≤ |A_j^G|`. -/
theorem three_labels_card_le (G : bf.Grp) (h : ℕ) (xs : ℝ) (l : Fin 4) (cellOf : ℤ → ℤ × ℤ)
    (ancOf : ∀ s, D.AncNe3 G (cellOf s) l → ℕ → ∀ j, j ≠ l → Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G
      (D.preAt (cellOf s)) (A.blkStart D.S.K (cellOf s).1 - 4 * D.S.K)))
    (Iw : ℕ) (c : ℝ × ℝ × ℕ × ℝ × (Fin 4 → ℝ)) (κ : Fin 4 → ℕ × ℕ) (S : Finset ℤ) (j : Fin 4)
    (hj : j ≠ l) :
    (S.biUnion fun s => (D.threePathE G h xs l cellOf ancOf Iw c κ s).image fun x => x j).card ≤
      (D.threeUsedReps G h xs l cellOf ancOf Iw c κ S j hj).card := by
  refine le_trans (Finset.card_le_card fun a ha => ?_)
    (Finset.card_image_le (s := D.threeUsedReps G h xs l cellOf ancOf Iw c κ S j hj)
      (f := fun m => (D.Ms j G).slope m xs))
  obtain ⟨s, hs, ha⟩ := Finset.mem_biUnion.mp ha
  obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp ha
  unfold threePathE at hx
  split_ifs at hx with hA
  · obtain ⟨q, hq, rfl⟩ := Finset.mem_image.mp hx
    refine Finset.mem_image.mpr ⟨(ancOf s hA h j hj (q.1 j)).1, Finset.mem_biUnion.mpr
      ⟨s, hs, ?_⟩, ?_⟩
    · rw [dite_eq_left hA]
      exact Finset.mem_image.mpr ⟨q, hq, rfl⟩
    · simp only [slopes3, hj, ↓reduceDIte]
  · exact absurd hx (Finset.notMem_empty _)


    (hBc : 0 ≤ Bc) (hK : 0 ≤ K) (hσ3 : 0 < σ 3) (h23 : σ 3 ≤ σ 2) (h12 : σ 2 ≤ σ 1)
    (h01 : σ 1 ≤ σ 0) (hM0 : ∀ i, ∀ G ∈ Gs, 0 ≤ M i G)
    (hMx : ∀ G ∈ Gs, 0 ≤ Mx G ∧ Mx G ≤ ∑ i, M i G)

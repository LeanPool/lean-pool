open Classical in
/-- The role counts `M_k^G` along a three-core path in the bin `c` (side role `l`, blueprint
line 2711): the number `|A_k|` of labels for a core role and `M_l^G = Σ_s w_s` for the side. -/
noncomputable def threeRoleCount (G : bf.Grp) (h : ℕ) (xs : ℝ) (l : Fin 4) (cellOf : ℤ → ℤ × ℤ)
    (ancOf : ∀ s, D.AncNe3 G (cellOf s) l → ℕ → ∀ j, j ≠ l → Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G
      (D.preAt (cellOf s)) (A.blkStart D.S.K (cellOf s).1 - 4 * D.S.K)))
    (Iw : ℕ) (c : ℝ × ℝ × ℕ × ℝ × (Fin 4 → ℝ)) (κ : Fin 4 → ℕ × ℕ) (S : Finset ℤ) (k : Fin 4) :
    ℝ :=
  if k = l then ∑ s ∈ S, D.sideWeight G l cellOf c.2.2.2.1 s else
    ((S.biUnion fun s => (D.threePathE G h xs l cellOf ancOf Iw c κ s).image fun x => x k).card : ℝ)

theorem exists_two_core (l : Fin 4) : ∃ a b : Fin 4, a ≠ b ∧ a ≠ l ∧ b ≠ l := by
  revert l; decide


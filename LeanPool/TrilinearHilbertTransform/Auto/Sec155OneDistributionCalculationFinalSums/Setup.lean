theorem path_count_four {κ : Type*} (Gs : Finset κ) (Sc : κ → Finset ℤ) (N : κ → ℤ → ℝ)
    (M : Fin 4 → κ → ℝ) (Mx : κ → ℝ) {σ : Fin 4 → ℝ} {L0 Bc K c : ℝ} (hc0 : 0 < c) (hc1 : c < 1)
    (hL0 : 0 < L0) (hBc : 0 < Bc) (hK : 0 ≤ K) (hσ3 : 0 < σ 3) (h23 : σ 3 ≤ σ 2)
    (h12 : σ 2 ≤ σ 1) (h01 : σ 1 ≤ σ 0) (hM0 : ∀ i, ∀ G ∈ Gs, 0 ≤ M i G)
    (hMx : ∀ G ∈ Gs, 0 < Mx G ∧ Mx G ≤ ∑ i, M i G)
    (hN0 : ∀ G ∈ Gs, ∀ s ∈ Sc G, 0 ≤ N G s)
    (hNM : ∀ G ∈ Gs, ∀ s ∈ Sc G, N G s ≤ Mx G ^ 2)
    (htot : ∀ G ∈ Gs, ∑ s ∈ Sc G, N G s ≤ L0 * M 0 G * M 1 G)
    (hsparse : ∀ G ∈ Gs, ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
      ∑ s ∈ (Sc G).filter (fun s => N G s ≤ δ * Mx G ^ 2), N G s ≤ Bc * δ ^ c * Mx G ^ 2)
    (hsum : ∀ i, ∑ G ∈ Gs, M i G ≤ K * σ i ^ (-2 : ℝ)) :
    (∑ G ∈ Gs, ∑ s ∈ Sc G, N G s ^ (1 - c / 4)) * (∏ i, σ i) ^ (1 - c / 4) ≤
      16 / 3 * L0 ^ (3 / 4 : ℝ) * Bc ^ (1 / 4 : ℝ) * K ^ (2 - c / 2) := by
  refine core_count_groups Gs (fun G => ∑ s ∈ Sc G, N G s ^ (1 - c / 4)) M Mx hc0 hc1 hL0.le
    hBc.le hK hσ3 h23 h12 h01 hM0 (fun G hG => ⟨(hMx G hG).1.le, (hMx G hG).2⟩)
    (fun G hG => ?_) hsum
  by_cases hA : 0 < L0 * M 0 G * M 1 G
  · exact powered_count (Sc G) (N G) (hMx G hG).1 (hN0 G hG) (hNM G hG) (htot G hG) hA hBc
      (hsparse G hG) hc0 hc1
  · have hA0 : L0 * M 0 G * M 1 G = 0 := le_antisymm (not_lt.mp hA)
      (mul_nonneg (mul_nonneg hL0.le (hM0 0 G hG)) (hM0 1 G hG))
    have hz : ∀ s ∈ Sc G, N G s = 0 := fun s hs => by
      have h1 := Finset.single_le_sum (hN0 G hG) hs
      have h2 := htot G hG
      linarith [hN0 G hG s hs]
    have hzero : ∑ s ∈ Sc G, N G s ^ (1 - c / 4) = 0 :=
      Finset.sum_eq_zero fun s hs => by
        rw [hz s hs, Real.zero_rpow (by linarith)]
    rw [hzero]
    have := (hMx G hG).1
    positivity

/-- A permutation ordering four amplitudes decreasingly (blueprint line 2783, "temporarily order the
roles so `σ₁ ≥ σ₂ ≥ σ₃ ≥ σ₄`"). -/
noncomputable def descPerm (σ : Fin 4 → ℝ) : Equiv.Perm (Fin 4) :=
  Fin.revPerm.trans (Tuple.sort σ)

theorem descPerm_antitone (σ : Fin 4 → ℝ) {i j : Fin 4} (hij : i ≤ j) :
    σ (descPerm σ j) ≤ σ (descPerm σ i) := by
  have hm := Tuple.monotone_sort σ
  unfold descPerm
  simp only [Equiv.trans_apply, Fin.revPerm_apply]
  exact hm (Fin.rev_le_rev.mpr hij)

/-- Blueprint lines 2774-2801 with the roles ordered by amplitude: `path_count_four` applied after
the permutation ordering the amplitudes decreasingly, using the total count of the pair of the two
largest amplitudes. -/
theorem path_count_four_sorted {κ : Type*} (Gs : Finset κ) (Sc : κ → Finset ℤ)
    (N : κ → ℤ → ℝ) (M : Fin 4 → κ → ℝ) (Mx : κ → ℝ) {σ : Fin 4 → ℝ} {L0 Bc K c : ℝ}
    (hc0 : 0 < c) (hc1 : c < 1) (hL0 : 0 < L0) (hBc : 0 < Bc) (hK : 0 ≤ K)
    (hσ : ∀ i, 0 < σ i) (hM0 : ∀ i, ∀ G ∈ Gs, 0 ≤ M i G)
    (hMx : ∀ G ∈ Gs, 0 < Mx G ∧ Mx G ≤ ∑ i, M i G)
    (hN0 : ∀ G ∈ Gs, ∀ s ∈ Sc G, 0 ≤ N G s)
    (hNM : ∀ G ∈ Gs, ∀ s ∈ Sc G, N G s ≤ Mx G ^ 2)
    (htot : ∀ G ∈ Gs, ∀ i j, i ≠ j → ∑ s ∈ Sc G, N G s ≤ L0 * M i G * M j G)
    (hsparse : ∀ G ∈ Gs, ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
      ∑ s ∈ (Sc G).filter (fun s => N G s ≤ δ * Mx G ^ 2), N G s ≤ Bc * δ ^ c * Mx G ^ 2)
    (hsum : ∀ i, ∑ G ∈ Gs, M i G ≤ K * σ i ^ (-2 : ℝ)) :
    (∑ G ∈ Gs, ∑ s ∈ Sc G, N G s ^ (1 - c / 4)) * (∏ i, σ i) ^ (1 - c / 4) ≤
      16 / 3 * L0 ^ (3 / 4 : ℝ) * Bc ^ (1 / 4 : ℝ) * K ^ (2 - c / 2) := by
  set π := descPerm σ
  have hprod : ∏ i, σ i = ∏ i, σ (π i) := (Equiv.prod_comp π σ).symm
  rw [hprod]
  have hne : π 0 ≠ π 1 := fun h => by
    have := π.injective h
    exact absurd this (by decide)
  refine path_count_four Gs Sc N (fun i G => M (π i) G) Mx hc0 hc1 hL0 hBc hK (hσ (π 3))
    (descPerm_antitone σ (by decide)) (descPerm_antitone σ (by decide))
    (descPerm_antitone σ (by decide)) (fun i G hG => hM0 (π i) G hG)
    (fun G hG => ⟨(hMx G hG).1, (hMx G hG).2.trans (le_of_eq
      (Equiv.sum_comp π (fun i => M i G)).symm)⟩) hN0 hNM
    (fun G hG => htot G hG (π 0) (π 1) hne) hsparse (fun i => hsum (π i))

/-- A geometric series with a polynomial weight `(1 + n)^C`. -/
theorem summable_one_add_pow_mul_geometric {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) (C : ℕ) :
    Summable fun n : ℕ => r ^ n * (1 + n : ℝ) ^ C := by
  rcases hr0.eq_or_lt with h | h
  · subst h
    refine summable_of_ne_finset_zero (s := {0}) fun n hn => ?_
    rw [Finset.mem_singleton] at hn
    simp [zero_pow hn]
  have hs := (summable_nat_add_iff 1).mpr
    (summable_pow_mul_geometric_of_norm_lt_one C (r := r) (by rwa [Real.norm_of_nonneg hr0]))
  refine (hs.mul_left r⁻¹).congr fun n => ?_
  push_cast
  rw [pow_succ]
  field_simp
  ring

/-! ## Negligible amplitudes on the side states (blueprint lines 2772-2774) -/

/-- A product of four amplitudes in `[0, U]`, one of them below `ε`, is at most `ε U³`. -/
theorem prod_four_le_small {a : Fin 4 → ℝ} {U ε : ℝ} (h0 : ∀ j, 0 ≤ a j) (hU : ∀ j, a j ≤ U)
    (hε : 0 ≤ ε) {j₀ : Fin 4} (hj₀ : a j₀ < ε) : ∏ j, a j ≤ ε * U ^ 3 := by
  rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ j₀)]
  have hrest : ∏ j ∈ Finset.univ.erase j₀, a j ≤ U ^ 3 := by
    have h := Finset.prod_le_prod₀ (s := Finset.univ.erase j₀) (f := a) (g := fun _ => U)
      (fun j _ => h0 j) fun j _ => hU j
    rwa [Finset.prod_const, Finset.card_erase_of_mem (Finset.mem_univ j₀), Finset.card_univ,
      Fintype.card_fin] at h
  exact mul_le_mul hj₀.le hrest (Finset.prod_nonneg fun j _ => h0 j) hε

/-- A sum over the occupied bins of a predicate, weighted by the fibre counts, is at most `K`
times the number of tuples when every such bin has value at most `K`. -/
theorem sum_bins_filter_le {ι β : Type*} [DecidableEq β] (T : Finset ι) (f : ι → β)
    (P : β → Prop) [DecidablePred P] (v : β → ℝ) {K : ℝ} (hK : 0 ≤ K)
    (hv : ∀ p ∈ T, P (f p) → v (f p) ≤ K) :
    ∑ c ∈ (T.image f).filter P, v c * ((T.filter fun p => f p = c).card : ℝ) ≤
      K * T.card := by
  calc ∑ c ∈ (T.image f).filter P, v c * ((T.filter fun p => f p = c).card : ℝ)
      ≤ ∑ c ∈ (T.image f).filter P, K * ((T.filter fun p => f p = c).card : ℝ) := by
        refine Finset.sum_le_sum fun c hc => ?_
        obtain ⟨hc, hPc⟩ := Finset.mem_filter.mp hc
        obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hc
        exact mul_le_mul_of_nonneg_right (hv p hp hPc) (Nat.cast_nonneg _)
    _ ≤ ∑ c ∈ T.image f, K * ((T.filter fun p => f p = c).card : ℝ) :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _) fun _ _ _ =>
          mul_nonneg hK (Nat.cast_nonneg _)
    _ = K * T.card := by
        rw [← Finset.mul_sum, Finset.card_eq_sum_card_image f T]
        push_cast
        rfl

/-- Blueprint line 2774 ("the remaining amplitudes lie in `[D_*^{-B}, P^{C₀}]`; their quadruples
number at most `C (1 + log D_* + log P)^4`"): dyadic amplitude quadruples with entries in
`[ε, U]` number at most `(log₂(U/ε) + 1)⁴`. -/
theorem dyadic_quadruples_card {ε U : ℝ} (hε : 0 < ε) (hεU : ε ≤ U) (T : Finset (Fin 4 → ℝ))
    (hT : ∀ a ∈ T, ∀ j, ε ≤ a j ∧ a j ≤ U ∧ ∃ k : ℤ, a j = (2 : ℝ) ^ k) :
    (T.card : ℝ) ≤ (Real.logb 2 (U / ε) + 1) ^ 4 := by
  classical
  set E : Finset ℤ := T.biUnion fun a => Finset.univ.image fun j => Int.log 2 (a j) with hE
  have hlog : ∀ a ∈ T, ∀ j, (2 : ℝ) ^ Int.log 2 (a j) = a j := by
    intro a ha j
    obtain ⟨-, -, k, hk⟩ := hT a ha j
    have e : Int.log 2 ((2 : ℝ) ^ k) = k := by
      exact_mod_cast Int.log_zpow (R := ℝ) (b := 2) (by norm_num) k
    rw [hk, e]
  have hEb : ∀ k ∈ E, ε ≤ (2 : ℝ) ^ k ∧ (2 : ℝ) ^ k ≤ U := by
    intro k hk
    obtain ⟨a, ha, hk⟩ := Finset.mem_biUnion.mp hk
    obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp hk
    rw [hlog a ha j]
    exact ⟨(hT a ha j).1, (hT a ha j).2.1⟩
  have hEc := dyadic_bins_card hε hεU E hEb
  have hinj : Set.InjOn (fun a : Fin 4 → ℝ => fun j => Int.log 2 (a j)) T := by
    intro a ha b hb hab
    funext j
    have := congrFun hab j
    simp only at this
    rw [← hlog a ha j, ← hlog b hb j, this]
  have hsub : T.image (fun a : Fin 4 → ℝ => fun j => Int.log 2 (a j)) ⊆
      Fintype.piFinset fun _ : Fin 4 => E := by
    intro x hx
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hx
    exact Fintype.mem_piFinset.mpr fun j => Finset.mem_biUnion.mpr
      ⟨a, ha, Finset.mem_image_of_mem _ (Finset.mem_univ j)⟩
  have h1 := Finset.card_le_card hsub
  rw [Finset.card_image_of_injOn hinj, Fintype.card_piFinset, Finset.prod_const,
    Finset.card_univ, Fintype.card_fin] at h1
  calc (T.card : ℝ) ≤ ((E.card ^ 4 : ℕ) : ℝ) := by exact_mod_cast h1
    _ = (E.card : ℝ) ^ 4 := by push_cast; ring
    _ ≤ (Real.logb 2 (U / ε) + 1) ^ 4 := pow_le_pow_left₀ (Nat.cast_nonneg _) hEc 4

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

open Classical in
/-- The successful final classes at one height are final classes of alive modes, so there are at
most `|alive|` of them (blueprint line 2772, "at most `D_*^4` label tuples"). -/
theorem card_goodCls_le (G : bf.Grp) (I : ℤ × ℤ) (j : Fin 4) (h : ℕ) :
    (D.goodCls G I j h).card ≤ ((D.Ms j G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card := by
  calc (D.goodCls G I j h).card ≤ (Finset.univ.image (D.finCls G I j h)).card :=
        Finset.card_le_card fun F hF => by
          obtain ⟨m, -, hm⟩ := D.mem_goodCls hF
          exact Finset.mem_image.mpr ⟨m, Finset.mem_univ _, hm⟩
    _ ≤ Finset.univ.card := Finset.card_image_le
    _ = _ := by rw [Finset.card_univ, Fintype.card_coe]

open Classical in
/-- At most `D_*^4` tested four-core tuples at one cell, group and height. -/
theorem card_fourTested_le (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ)
    (anc : ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) (h : ℕ)
    (hcard : ∀ j, (((D.Ms j G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card : ℝ) ≤ D.S.Dstar) :
    ((D.fourTested G I xs anc h).card : ℝ) ≤ D.S.Dstar ^ 4 := by
  unfold fourTested fourTestedOf
  calc (((Fintype.piFinset fun j => D.goodCls G I j h).filter _).card : ℝ)
      ≤ ((Fintype.piFinset fun j => D.goodCls G I j h).card : ℝ) := by
        exact_mod_cast Finset.card_filter_le _ _
    _ = ∏ j, ((D.goodCls G I j h).card : ℝ) := by
        rw [Fintype.card_piFinset]; push_cast; rfl
    _ ≤ ∏ _j : Fin 4, D.S.Dstar :=
        Finset.prod_le_prod₀ (fun _ _ => Nat.cast_nonneg _) fun j _ =>
          (Nat.cast_le.mpr (D.card_goodCls_le G I j h)).trans (hcard j)
    _ = D.S.Dstar ^ 4 := by simp

open Classical in
/-- At most `D_*^3 (I_w + 1)` tested three-core tuples and shells at one cell, group and height. -/
theorem card_threeTested_le (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ) (l : Fin 4)
    (anc : ℕ → ∀ j, j ≠ l → Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K)))
    (X : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) (Iw h : ℕ)
    (hcard : ∀ j, (((D.Ms j G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card : ℝ) ≤ D.S.Dstar) :
    ((D.threeTested G I xs l anc X Iw h).card : ℝ) ≤ D.S.Dstar ^ 3 * (Iw + 1) := by
  unfold threeTested threeTestedOf
  have hpi : ((Fintype.piFinset fun j => if j = l then {∅} else D.goodCls G I j h).card : ℝ) ≤
      D.S.Dstar ^ 3 := by
    rw [Fintype.card_piFinset]
    push_cast
    calc ∏ j, (((if j = l then {∅} else D.goodCls G I j h) : Finset _).card : ℝ)
        ≤ ∏ j, (if j = l then (1 : ℝ) else D.S.Dstar) := by
          refine Finset.prod_le_prod₀ (fun _ _ => Nat.cast_nonneg _) fun j _ => ?_
          split_ifs with hj
          · simp
          · exact (Nat.cast_le.mpr (D.card_goodCls_le G I j h)).trans (hcard j)
      _ = D.S.Dstar ^ 3 := by
          rw [prod_ite_one_erase, Finset.prod_const, Finset.card_erase_of_mem
            (Finset.mem_univ l), Finset.card_univ, Fintype.card_fin]
  calc ((((Fintype.piFinset fun j => if j = l then {∅} else D.goodCls G I j h) ×ˢ
        Finset.range (Iw + 1)).filter _).card : ℝ)
      ≤ (((Fintype.piFinset fun j => if j = l then {∅} else D.goodCls G I j h) ×ˢ
        Finset.range (Iw + 1)).card : ℝ) := by exact_mod_cast Finset.card_filter_le _ _
    _ = ((Fintype.piFinset fun j => if j = l then {∅} else D.goodCls G I j h).card : ℝ) *
        (Iw + 1) := by rw [Finset.card_product, Finset.card_range]; push_cast; ring
    _ ≤ D.S.Dstar ^ 3 * (Iw + 1) := mul_le_mul_of_nonneg_right hpi (by positivity)

/-- The amplitude tuple of a three-core bin `(μ, ν, i, b_Λ, σ)` with side role `l`: the window
size `b_Λ` in the side role and the core sizes `σ_j` in the core roles. -/
noncomputable def threeAmp (l : Fin 4) (c : ℝ × ℝ × ℕ × ℝ × (Fin 4 → ℝ)) : Fin 4 → ℝ :=
  fun j => if j = l then c.2.2.2.1 else c.2.2.2.2 j

end SideInput

end ActiveSetup.BasicFamilies.FamParams

theorem entryCU_nonneg' (κ : LocalKernelClass) (J A : ℕ) : 0 ≤ entryCU κ J A := by
  have := kernelDerivBound_nonneg κ 0
  have := kernelDerivBound_nonneg κ (J + (A + 2))
  unfold entryCU kerC
  positivity

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

open Classical in
/-- The value of a bin of a tested four-core tuple with some amplitude below `ε` is at most
`2 C_J 12⁴ ε U³` when the class sizes are at most `U` (`μ ≤ 1 ≤ ν`, `σ_j ≤ U`). -/
theorem fourBinVal_small (hD : 2 ≤ D.S.Dstar) (J : ℕ) (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ)
    (anc : ℕ → ∀ j, Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) (h : ℕ)
    {U ε : ℝ} (hε : 0 ≤ ε) (hU : ∀ j, ∀ F ∈ D.goodCls G I j h, D.clsSize G I j F ≤ U)
    {p : ∀ j, Finset (D.Ms j G).Md} (hp : p ∈ D.fourTested G I xs anc h)
    (hsmall : ∃ j, (D.fourBinOf G I xs anc h p).2.2 j < ε) :
    fourBinVal κ' J (D.fourBinOf G I xs anc h p) ≤ 2 * fourKC κ' J * 12 ^ 4 * ε * U ^ 3 := by
  have hp' := hp
  unfold fourTested fourTestedOf at hp'
  obtain ⟨hpT, hpass, hpos⟩ := Finset.mem_filter.mp hp'
  have hgood := Fintype.mem_piFinset.mp hpT
  obtain ⟨-, -, hμ3, hμ4, -, -, hν3, -⟩ := D.fourBands_spec (by linarith) (D.one_le_U0 hD) hpass
  have hU0i : 0 < D.U0⁻¹ := inv_pos.mpr (by linarith [D.one_le_U0 hD])
  set c := D.fourBinOf G I xs anc h p with hc
  have hc1 : c.1 = D.fourMuBand G I xs (h - D.SP.Δ) (fun j => anc h j (p j)) := rfl
  have hc2 : c.2.1 = D.fourNuBand G I xs (h - D.SP.Δ) (fun j => anc h j (p j)) := rfl
  have hc3 : ∀ j, c.2.2 j = dyadicBand (D.clsSize G I j (p j)) := fun j => rfl
  have hσ0 : ∀ j, 0 ≤ c.2.2 j := fun j => by rw [hc3]; exact (dyadicBand_pos _).le
  have hσU : ∀ j, c.2.2 j ≤ U := fun j => by
    rw [hc3]; exact (dyadicBand_le (hpos j)).trans (hU j (p j) (hgood j))
  obtain ⟨j₀, hj₀⟩ := hsmall
  have hprod := prod_four_le_small hσ0 hσU hε hj₀
  have hK := fourKC_nonneg κ' J
  have hμ0 : 0 ≤ 2 * c.1 := by rw [hc1]; linarith
  have hμ2 : 2 * c.1 ≤ 2 := by rw [hc1]; linarith
  have hν : (c.2.1 ^ J)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (one_le_pow₀ (by rw [hc2]; exact hν3))
  have hν0 : 0 ≤ (c.2.1 ^ J)⁻¹ := inv_nonneg.mpr (pow_nonneg (by rw [hc2]; linarith) J)
  have e : ∏ j, (6 * (2 * c.2.2 j)) = 12 ^ 4 * ∏ j, c.2.2 j := by
    rw [Finset.prod_congr rfl fun j _ => (show 6 * (2 * c.2.2 j) = 12 * c.2.2 j by ring),
      Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  unfold fourBinVal
  rw [e]
  have hP0 : 0 ≤ ∏ j, c.2.2 j := Finset.prod_nonneg fun j _ => hσ0 j
  calc fourKC κ' J * (2 * c.1) * (c.2.1 ^ J)⁻¹ * (12 ^ 4 * ∏ j, c.2.2 j)
      ≤ fourKC κ' J * 2 * 1 * (12 ^ 4 * (ε * U ^ 3)) := by
        gcongr
    _ = 2 * fourKC κ' J * 12 ^ 4 * ε * U ^ 3 := by ring

open Classical in
/-- The value of a bin of a tested three-core tuple and shell (side role `l`) with some amplitude
of `threeAmp` below `ε` is at most `8 C_{J,A} 2^{A+4} 12³ ε U³` when the class sizes and the side
size `(r⁻¹ ∫_I |S|²)^{1/2}` are at most `U`. -/
theorem threeBinVal_small (hD : 2 ≤ D.S.Dstar) (J Aw : ℕ) (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ)
    (l : Fin 4) (anc : ℕ → ∀ j, j ≠ l → Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K)))
    (Iw h : ℕ) {U ε : ℝ} (hε : 0 ≤ ε)
    (hU : ∀ j, j ≠ l → ∀ F ∈ D.goodCls G I j h, D.clsSize G I j F ≤ U)
    (hUs : Real.sqrt ((dyadicGridLength A.G I.1)⁻¹ *
      ∫ y in (dyadicGridLeft A.G I.1 I.2)..dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1,
        ‖augPhys (D.toLeaf.sv l G I) y‖ ^ 2) ≤ U)
    {q : (∀ j, Finset (D.Ms j G).Md) × ℕ}
    (hq : q ∈ D.threeTested G I xs l anc (D.toLeaf.sv l G I) Iw h)
    (hsmall : ∃ j, threeAmp l (D.threeBinOf G I xs l anc (D.toLeaf.sv l G I) h q) j < ε) :

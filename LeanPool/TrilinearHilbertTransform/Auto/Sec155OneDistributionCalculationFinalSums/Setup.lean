/-! ## Band coefficients (blueprint lines 2802-2806) -/

/-- Blueprint line 2802 ("the remaining frequency coefficient from `eq:powered-count` is at most
`P^C (1 + log(ν/μ))^C`"), abstract form: if `1 ≤ L ≤ P_w Y` and `ℓ ≤ P_ℓ Y` with `Y ≥ 1`, then
`(16/3) L^{3/4} (C ℓ L^{12})^{1/4} ≤ (16/3) C^{1/4} P_w^{15/4} P_ℓ^{1/4} Y^4`. -/
theorem freq_coef_le {L ℓ Pw Pℓ Y Cc : ℝ} (hL1 : 1 ≤ L) (hL : L ≤ Pw * Y) (hℓ0 : 0 ≤ ℓ)
    (hℓ : ℓ ≤ Pℓ * Y) (hY : 1 ≤ Y) (hC : 0 ≤ Cc) :
    16 / 3 * L ^ (3 / 4 : ℝ) * (Cc * ℓ * L ^ 12) ^ (1 / 4 : ℝ) ≤
      16 / 3 * Cc ^ (1 / 4 : ℝ) * Pw ^ (15 / 4 : ℝ) * Pℓ ^ (1 / 4 : ℝ) * Y ^ 4 := by
  have hY0 : 0 ≤ Y := by linarith
  have hPw : 0 ≤ Pw := by
    by_contra hneg
    push Not at hneg
    nlinarith
  have hPℓ : 0 ≤ Pℓ := by
    by_contra hneg
    push Not at hneg
    have : Pℓ * Y < 0 := mul_neg_of_neg_of_pos hneg (by linarith)
    linarith
  have hL0 : 0 ≤ L := by linarith
  have h1 : L ^ (3 / 4 : ℝ) ≤ (Pw * Y) ^ (3 / 4 : ℝ) := Real.rpow_le_rpow hL0 hL (by norm_num)
  have h12 : L ^ 12 ≤ (Pw * Y) ^ 12 := pow_le_pow_left₀ hL0 hL 12
  have h2 : (Cc * ℓ * L ^ 12) ^ (1 / 4 : ℝ) ≤ (Cc * (Pℓ * Y) * (Pw * Y) ^ 12) ^ (1 / 4 : ℝ) := by
    refine Real.rpow_le_rpow (by positivity) ?_ (by norm_num)
    exact mul_le_mul (mul_le_mul_of_nonneg_left hℓ hC) h12 (by positivity)
      (mul_nonneg hC (mul_nonneg hPℓ hY0))
  have e1 : (Pw * Y) ^ (3 / 4 : ℝ) = Pw ^ (3 / 4 : ℝ) * Y ^ (3 / 4 : ℝ) := Real.mul_rpow hPw hY0
  have e2 : (Cc * (Pℓ * Y) * (Pw * Y) ^ 12) ^ (1 / 4 : ℝ) =
      Cc ^ (1 / 4 : ℝ) * Pℓ ^ (1 / 4 : ℝ) * Y ^ (1 / 4 : ℝ) * (Pw ^ (3 : ℝ) * Y ^ (3 : ℝ)) := by
    rw [Real.mul_rpow (by positivity) (by positivity), Real.mul_rpow hC (by positivity),
      Real.mul_rpow hPℓ hY0, mul_pow, Real.mul_rpow (by positivity) (by positivity)]
    have e3 : ∀ x : ℝ, 0 ≤ x → (x ^ 12) ^ (1 / 4 : ℝ) = x ^ (3 : ℝ) := fun x hx => by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hx]; norm_num
    rw [e3 Pw hPw, e3 Y hY0]
    ring
  have hfin : Pw ^ (3 / 4 : ℝ) * Y ^ (3 / 4 : ℝ) * (Cc ^ (1 / 4 : ℝ) * Pℓ ^ (1 / 4 : ℝ) *
      Y ^ (1 / 4 : ℝ) * (Pw ^ (3 : ℝ) * Y ^ (3 : ℝ))) =
      Cc ^ (1 / 4 : ℝ) * Pw ^ (15 / 4 : ℝ) * Pℓ ^ (1 / 4 : ℝ) * Y ^ 4 := by
    have hw : Pw ^ (3 / 4 : ℝ) * Pw ^ (3 : ℝ) = Pw ^ (15 / 4 : ℝ) := by
      rcases hPw.eq_or_lt with h0 | h0
      · subst h0; simp
      · rw [← Real.rpow_add h0]; norm_num
    have hy : Y ^ (3 / 4 : ℝ) * Y ^ (1 / 4 : ℝ) * Y ^ (3 : ℝ) = Y ^ 4 := by
      have hYp : 0 < Y := by linarith
      rw [← Real.rpow_add hYp, ← Real.rpow_add hYp]
      norm_num
    calc _ = Cc ^ (1 / 4 : ℝ) * (Pw ^ (3 / 4 : ℝ) * Pw ^ (3 : ℝ)) * Pℓ ^ (1 / 4 : ℝ) *
          (Y ^ (3 / 4 : ℝ) * Y ^ (1 / 4 : ℝ) * Y ^ (3 : ℝ)) := by ring
      _ = _ := by rw [hw, hy]
  calc 16 / 3 * L ^ (3 / 4 : ℝ) * (Cc * ℓ * L ^ 12) ^ (1 / 4 : ℝ)
      ≤ 16 / 3 * (Pw * Y) ^ (3 / 4 : ℝ) * (Cc * (Pℓ * Y) * (Pw * Y) ^ 12) ^ (1 / 4 : ℝ) := by
        gcongr
    _ = 16 / 3 * (Pw ^ (3 / 4 : ℝ) * Y ^ (3 / 4 : ℝ) * (Cc ^ (1 / 4 : ℝ) * Pℓ ^ (1 / 4 : ℝ) *
        Y ^ (1 / 4 : ℝ) * (Pw ^ (3 : ℝ) * Y ^ (3 : ℝ)))) := by rw [e1, e2]; ring
    _ = _ := by rw [hfin]; ring

/-- Blueprint lines 2802-2803: the coefficient `ℓ = 1 + log₂(2 + (d+1)² y)` of `eq:applied-sparse`
is at most `P_ℓ (1 + log y)` for `y ≥ 2`, with `P_ℓ = 1 + (log 2 + 2 log(d+1) + 1)/log 2`. -/
theorem ell_le_log (d : ℕ) {y : ℝ} (hy : 2 ≤ y) :
    1 + Real.logb 2 (2 + ((d : ℝ) + 1) ^ 2 * y) ≤
      (1 + (Real.log 2 + 2 * Real.log ((d : ℝ) + 1) + 1) / Real.log 2) * (1 + Real.log y) := by
  have hd1 : (1 : ℝ) ≤ (d : ℝ) + 1 := by have := Nat.cast_nonneg (α := ℝ) d; linarith
  have hy0 : 0 < y := by linarith
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hly : 0 ≤ Real.log y := Real.log_nonneg (by linarith)
  have hld : 0 ≤ Real.log ((d : ℝ) + 1) := Real.log_nonneg hd1
  have hsq : 1 ≤ ((d : ℝ) + 1) ^ 2 := one_le_pow₀ hd1
  have harg : 2 + ((d : ℝ) + 1) ^ 2 * y ≤ 2 * (((d : ℝ) + 1) ^ 2 * y) := by nlinarith
  have hlog : Real.log (2 + ((d : ℝ) + 1) ^ 2 * y) ≤
      Real.log 2 + 2 * Real.log ((d : ℝ) + 1) + Real.log y := by
    calc Real.log (2 + ((d : ℝ) + 1) ^ 2 * y) ≤ Real.log (2 * (((d : ℝ) + 1) ^ 2 * y)) :=
          Real.log_le_log (by positivity) harg
      _ = _ := by
          rw [Real.log_mul (by norm_num) (by positivity), Real.log_mul (by positivity) hy0.ne',
            Real.log_pow]
          push_cast; ring
  have hY : 1 ≤ 1 + Real.log y := by linarith
  have hnum : Real.log 2 + 2 * Real.log ((d : ℝ) + 1) + Real.log y ≤
      (Real.log 2 + 2 * Real.log ((d : ℝ) + 1) + 1) * (1 + Real.log y) := by nlinarith
  rw [Real.logb]
  have hdiv : Real.log (2 + ((d : ℝ) + 1) ^ 2 * y) / Real.log 2 ≤
      (Real.log 2 + 2 * Real.log ((d : ℝ) + 1) + 1) * (1 + Real.log y) / Real.log 2 :=
    div_le_div_of_nonneg_right (hlog.trans hnum) hlog2.le
  calc 1 + Real.log (2 + ((d : ℝ) + 1) ^ 2 * y) / Real.log 2
      ≤ 1 * (1 + Real.log y) + (Real.log 2 + 2 * Real.log ((d : ℝ) + 1) + 1) *
          (1 + Real.log y) / Real.log 2 := by linarith
    _ = _ := by ring

/-- The two-band series `Σ_{u,v ≥ 0} 2^{-pu} 2^{-Jpv} (1 + u + v)^C` converges for `p, Jp > 0`. -/
theorem band_series2_summable {p J : ℝ} (hp : 0 < p) (hJ : 0 < J) (C : ℕ) :
    Summable fun t : ℕ × ℕ => ((2 : ℝ) ^ (-p)) ^ t.1 * ((2 : ℝ) ^ (-(J * p))) ^ t.2 *
      (1 + t.1 + t.2 : ℝ) ^ C := by
  have hr : ∀ a : ℝ, 0 < a → 0 ≤ (2 : ℝ) ^ (-a) ∧ (2 : ℝ) ^ (-a) < 1 := fun a ha =>
    ⟨Real.rpow_nonneg (by norm_num) _, Real.rpow_lt_one_of_one_lt_of_neg (by norm_num)
      (by linarith)⟩
  obtain ⟨h0u, h1u⟩ := hr p hp
  obtain ⟨h0v, h1v⟩ := hr (J * p) (mul_pos hJ hp)
  have hu := summable_one_add_pow_mul_geometric h0u h1u C
  have hv := summable_one_add_pow_mul_geometric h0v h1v C
  have huv := hu.mul_of_nonneg hv (fun n => by positivity) fun n => by positivity
  refine huv.of_nonneg_of_le (fun t => by positivity) fun t => ?_
  have hb : (1 + t.1 + t.2 : ℝ) ^ C ≤ (1 + t.1 : ℝ) ^ C * (1 + t.2 : ℝ) ^ C := by
    rw [← mul_pow]
    refine pow_le_pow_left₀ (by positivity) ?_ C
    nlinarith [(Nat.cast_nonneg t.1 : (0 : ℝ) ≤ t.1), (Nat.cast_nonneg t.2 : (0 : ℝ) ≤ t.2)]
  have h3 : 0 ≤ ((2 : ℝ) ^ (-p)) ^ t.1 * ((2 : ℝ) ^ (-(J * p))) ^ t.2 := by positivity
  calc ((2 : ℝ) ^ (-p)) ^ t.1 * ((2 : ℝ) ^ (-(J * p))) ^ t.2 * (1 + t.1 + t.2 : ℝ) ^ C
      ≤ ((2 : ℝ) ^ (-p)) ^ t.1 * ((2 : ℝ) ^ (-(J * p))) ^ t.2 *
          ((1 + t.1 : ℝ) ^ C * (1 + t.2 : ℝ) ^ C) := mul_le_mul_of_nonneg_left hb h3
    _ = _ := by ring

/-- Blueprint lines 2803-2806 ("extend the actual truncated bands to all `μ = 2^{-u}`, `ν = 2^v`;
their sum is bounded by `C P^C Σ 2^{-pu} 2^{-Jpv} (1+u+v)^C < ∞`"): over any finite set of dyadic
band pairs `μ = 2^{-u} ≤ 1 ≤ ν = 2^v`, the powered kernel factors `μ^p ν^{-Jp}` times
`(1 + log(8ν/μ))^4` sum to at most the convergent series
`Σ_{u,v} 2^{-pu} 2^{-Jpv} (4(1 + u + v))^4`. -/
theorem dyadic_band_sum_le {p J : ℝ} (hp : 0 < p) (hJ : 0 < J) (T : Finset (ℝ × ℝ))
    (hT : ∀ x ∈ T, ∃ u v : ℕ, x.1 = (2 : ℝ) ^ (-(u : ℤ)) ∧ x.2 = (2 : ℝ) ^ (v : ℤ)) :
    ∑ x ∈ T, x.1 ^ p * (x.2 ^ J)⁻¹ ^ p * (1 + Real.log (8 * x.2 / x.1)) ^ 4 ≤
      ∑' t : ℕ × ℕ, ((2 : ℝ) ^ (-p)) ^ t.1 * ((2 : ℝ) ^ (-(J * p))) ^ t.2 *
        (4 ^ 4 * (1 + t.1 + t.2 : ℝ) ^ 4) := by
  classical
  choose! uf vf huv using hT
  set g : ℕ × ℕ → ℝ := fun t => ((2 : ℝ) ^ (-p)) ^ t.1 * ((2 : ℝ) ^ (-(J * p))) ^ t.2 *
    (4 ^ 4 * (1 + t.1 + t.2 : ℝ) ^ 4) with hg
  have hgs : Summable g := by
    have := (band_series2_summable hp hJ 4).mul_left (4 ^ 4)
    refine this.congr fun t => ?_
    simp only [hg]; ring
  have hg0 : ∀ t, 0 ≤ g t := fun t => by simp only [hg]; positivity
  have hinj : Set.InjOn (fun x => (uf x, vf x)) T := by
    intro x hx y hy hxy
    simp only [Prod.mk.injEq] at hxy
    obtain ⟨h1, h2⟩ := huv x hx
    obtain ⟨h3, h4⟩ := huv y hy
    exact Prod.ext (by rw [h1, h3, hxy.1]) (by rw [h2, h4, hxy.2])
  have hterm : ∀ x ∈ T, x.1 ^ p * (x.2 ^ J)⁻¹ ^ p * (1 + Real.log (8 * x.2 / x.1)) ^ 4 ≤
      g (uf x, vf x) := by
    intro x hx
    obtain ⟨h1, h2⟩ := huv x hx
    set u := uf x
    set v := vf x
    have hμ : x.1 ^ p = ((2 : ℝ) ^ (-p)) ^ u := by
      rw [h1, ← Real.rpow_intCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_natCast,
        ← Real.rpow_mul (by norm_num)]
      congr 1; push_cast; ring
    have hν : (x.2 ^ J)⁻¹ ^ p = ((2 : ℝ) ^ (-(J * p))) ^ v := by
      rw [h2, ← Real.rpow_intCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_neg_one,
        ← Real.rpow_mul (by positivity), ← Real.rpow_mul (by positivity), ← Real.rpow_natCast,
        ← Real.rpow_mul (by norm_num)]
      congr 1; push_cast; ring
    have hlog : 1 + Real.log (8 * x.2 / x.1) ≤ 4 * (1 + u + v) := by
      have e : 8 * x.2 / x.1 = (2 : ℝ) ^ ((3 + u + v : ℕ) : ℤ) := by
        rw [h1, h2, div_eq_mul_inv, ← zpow_neg, neg_neg, show (8 : ℝ) = 2 ^ (3 : ℤ) by norm_num,
          ← zpow_add₀ (by norm_num), ← zpow_add₀ (by norm_num)]
        congr 1; push_cast; ring
      rw [e, Real.log_zpow]
      have hl2 : Real.log 2 < 1 := by
        have := Real.log_two_lt_d9; linarith
      have hl0 : 0 < Real.log 2 := Real.log_pos (by norm_num)
      push_cast
      have hu0 : (0 : ℝ) ≤ u := Nat.cast_nonneg _
      have hv0 : (0 : ℝ) ≤ v := Nat.cast_nonneg _
      nlinarith only [hl2]
    have hl0 : 0 ≤ 1 + Real.log (8 * x.2 / x.1) := by
      have : (1 : ℝ) ≤ 8 * x.2 / x.1 := by
        rw [h1, h2, le_div_iff₀ (by positivity), one_mul]
        have : (2 : ℝ) ^ (-(u : ℤ)) ≤ 1 := zpow_le_one_of_nonpos₀ (by norm_num) (by omega)
        have : (1 : ℝ) ≤ (2 : ℝ) ^ (v : ℤ) := one_le_zpow₀ (by norm_num) (by omega)
        linarith
      linarith [Real.log_nonneg this]
    have h4 : (1 + Real.log (8 * x.2 / x.1)) ^ 4 ≤ 4 ^ 4 * (1 + u + v : ℝ) ^ 4 := by
      rw [← mul_pow]; exact pow_le_pow_left₀ hl0 hlog 4
    rw [hμ, hν]
    simp only [hg]
    exact mul_le_mul_of_nonneg_left h4 (by positivity)
  calc ∑ x ∈ T, x.1 ^ p * (x.2 ^ J)⁻¹ ^ p * (1 + Real.log (8 * x.2 / x.1)) ^ 4
      ≤ ∑ x ∈ T, g (uf x, vf x) := Finset.sum_le_sum hterm
    _ = ∑ t ∈ T.image (fun x => (uf x, vf x)), g t := (Finset.sum_image hinj).symm
    _ ≤ ∑' t, g t := hgs.sum_le_tsum _ fun t _ => hg0 t

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

/-- The polynomial factor `P_w = 32 (d_max + 5)⁴ (log(288 D_*^5 H) + log 2 + 1)` of the scale
multiplicity at the schedule (`eq:triple-test`). -/
noncomputable def multPoly : ℝ :=
  32 * ((D.S.dmax : ℝ) + 5) ^ 4 * (Real.log (288 * (D.S.Dstar ^ 5 * D.S.H)) + Real.log 2 + 1)

/-- The polynomial factor `P_ℓ = 1 + (log 2 + 2 log(d_max + 1) + 1)/log 2` of `ℓ`. -/
noncomputable def ellPoly : ℝ :=
  1 + (Real.log 2 + 2 * Real.log ((D.S.dmax : ℝ) + 1) + 1) / Real.log 2

/-- Blueprint line 2802 for four cores on the side states: the frequency coefficient of the group
sum is at most `(16/3) C^{1/4} P_w^{15/4} P_ℓ^{1/4} (1 + log(8ν/μ))^4` for a genuine bin
`0 < μ ≤ 1 ≤ ν` (`P_w, P_ℓ` polynomial in `d_max, log D_*, log H`, i.e. `≤ P^C`). -/
theorem four_coef_sched {Cj CA CT CK : ℕ} {δs W : ℝ} (hV : D.S.Valid Cj CA CT CK δs W)
    (hd2 : 2 ≤ D.S.dmax) (hD : 2 ≤ D.S.Dstar) (hB : 2 ≤ D.S.Bstar) (hQ : 1 ≤ D.S.Q0)
    (hSP : D.SP = D.S.sideParams δs) {h : ℕ} (hhJ : h ≤ D.SP.Jst) {μ ν : ℝ} (hμ : 0 < μ)
    (hμ1 : μ ≤ 1) (hν : 1 ≤ ν) :
    16 / 3 * fourMult D.S.dmax (D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ)) μ (2 * ν) ^ (3 / 4 : ℝ) *
        (3 * 10 ^ 11 * (1 + Real.logb 2 (2 + ((D.S.dmax : ℝ) + 1) ^ 2 * ((4 * (2 * ν)) / μ))) *
          fourMult D.S.dmax (D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ)) μ (2 * ν) ^ 12) ^
          (1 / 4 : ℝ) ≤
      16 / 3 * (3 * 10 ^ 11 : ℝ) ^ (1 / 4 : ℝ) * D.multPoly ^ (15 / 4 : ℝ) *
        D.ellPoly ^ (1 / 4 : ℝ) * (1 + Real.log (8 * ν / μ)) ^ 4 := by
  have hA1 : (1 : ℝ) ≤ D.S.A0 := le_trans (by norm_num) D.hA
  have hB1 : 1 ≤ D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ) := by
    have h1 : (1 : ℝ) ≤ D.S.Dstar ^ 5 := one_le_pow₀ (by linarith)
    have h2 : (1 : ℝ) ≤ D.S.Eh (h - D.SP.Δ) := one_le_pow₀ hA1
    nlinarith
  have hy : (4 * (2 * ν)) / μ = 8 * ν / μ := by ring
  have hy2 : 2 ≤ 8 * ν / μ := by rw [le_div_iff₀ hμ]; linarith
  have hY : 1 ≤ 1 + Real.log (8 * ν / μ) := by
    linarith [Real.log_nonneg (by linarith : (1 : ℝ) ≤ 8 * ν / μ)]
  have hL := D.fourMult_le_sched hV hd2 hD hB hQ hSP hhJ (d := D.S.dmax) le_rfl hμ
    (ν := ν) (by linarith)
  have hL' : fourMult D.S.dmax (D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ)) μ (2 * ν) ≤
      D.multPoly * (1 + Real.log (8 * ν / μ)) := by
    unfold fourMult multPoly
    exact hL
  have hℓ := ell_le_log D.S.dmax hy2
  rw [hy]
  have hℓ0 : 0 ≤ 1 + Real.logb 2 (2 + ((D.S.dmax : ℝ) + 1) ^ 2 * (8 * ν / μ)) := by
    have := Real.logb_nonneg (b := 2) (by norm_num)
      (by nlinarith only [sq_nonneg ((D.S.dmax : ℝ) + 1), hy2] :
        (1 : ℝ) ≤ 2 + ((D.S.dmax : ℝ) + 1) ^ 2 * (8 * ν / μ))
    linarith
  exact freq_coef_le (one_le_fourMult _ hB1 hμ (by linarith)) hL' hℓ0 hℓ hY (by norm_num)

/-- Blueprint line 2802 for three cores on the side states: the frequency coefficient of the
group sum is at most `(16/3) C^{1/4} P_w^{15/4} P_ℓ^{1/4} (1 + log(2ν/μ))^4`. -/
theorem three_coef_sched {Cj CA CT CK : ℕ} {δs W : ℝ} (hV : D.S.Valid Cj CA CT CK δs W)
    (hd2 : 2 ≤ D.S.dmax) (hD : 2 ≤ D.S.Dstar) (hB : 2 ≤ D.S.Bstar) (hQ : 1 ≤ D.S.Q0)
    (hSP : D.SP = D.S.sideParams δs) {h : ℕ} (hhJ : h ≤ D.SP.Jst) {μ ν : ℝ} (hμ : 0 < μ)
    (hμ1 : μ ≤ 1) (hν : 1 ≤ ν) :
    16 / 3 * threeMult D.S.dmax (D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ)) μ (2 * ν) ^ (3 / 4 : ℝ) *
        (3 * 10 ^ 11 * (1 + Real.logb 2 (2 + ((D.S.dmax : ℝ) + 1) ^ 2 * ((2 * ν) / μ))) *
          threeMult D.S.dmax (D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ)) μ (2 * ν) ^ 12) ^
          (1 / 4 : ℝ) ≤
      16 / 3 * (3 * 10 ^ 11 : ℝ) ^ (1 / 4 : ℝ) * D.multPoly ^ (15 / 4 : ℝ) *
        D.ellPoly ^ (1 / 4 : ℝ) * (1 + Real.log (2 * ν / μ)) ^ 4 := by
  have hA1 : (1 : ℝ) ≤ D.S.A0 := le_trans (by norm_num) D.hA
  have hB1 : 1 ≤ D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ) := by
    have h1 : (1 : ℝ) ≤ D.S.Dstar ^ 5 := one_le_pow₀ (by linarith)
    have h2 : (1 : ℝ) ≤ D.S.Eh (h - D.SP.Δ) := one_le_pow₀ hA1
    nlinarith
  have hy2 : 2 ≤ 2 * ν / μ := by rw [le_div_iff₀ hμ]; linarith
  have hY : 1 ≤ 1 + Real.log (2 * ν / μ) := by
    linarith [Real.log_nonneg (by linarith : (1 : ℝ) ≤ 2 * ν / μ)]
  have hd : D.S.dmax ≤ D.S.dmax := le_rfl
  have hL := D.mult_le_sched hV hd2 hD hB hQ hSP hhJ hd hB1 (by linarith) hμ
    (ν := 2 * ν) (by linarith)
  have hL' : threeMult D.S.dmax (D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ)) μ (2 * ν) ≤
      D.multPoly * (1 + Real.log (2 * ν / μ)) := by
    unfold threeMult multPoly
    exact hL
  have hℓ := ell_le_log D.S.dmax hy2
  have hℓ0 : 0 ≤ 1 + Real.logb 2 (2 + ((D.S.dmax : ℝ) + 1) ^ 2 * (2 * ν / μ)) := by
    have := Real.logb_nonneg (b := 2) (by norm_num)
      (by nlinarith only [sq_nonneg ((D.S.dmax : ℝ) + 1), hy2] :
        (1 : ℝ) ≤ 2 + ((D.S.dmax : ℝ) + 1) ^ 2 * (2 * ν / μ))
    linarith
  exact freq_coef_le (one_le_threeMult _ hB1 hμ (by linarith)) hL' hℓ0 hℓ hY (by norm_num)

open Classical in
/-- Blueprint line 2806 ("types have an allowed polynomial cost"): the role type of a successful
final class lies in `[0, log₂ D_*]²` when the role has at most `D_*` alive modes. -/
theorem classTypeOf_mem (G : bf.Grp) (I : ℤ × ℤ) (j : Fin 4) (h : ℕ)
    (F : Finset (D.Ms j G).Md)
    (hcard : (((D.Ms j G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card : ℝ) ≤ D.S.Dstar) :
    D.classTypeOf G I j h F ∈ Finset.range (Nat.log 2 ⌊D.S.Dstar⌋₊ + 1) ×ˢ
      Finset.range (Nat.log 2 ⌊D.S.Dstar⌋₊ + 1) := by
  have hcardN : ((D.Ms j G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card ≤ ⌊D.S.Dstar⌋₊ :=
    Nat.le_floor hcard
  unfold classTypeOf
  split_ifs with hF
  · have hal := D.classNode_alive hF
    have h1 : (D.Ms j G).nodeType1 D.S D.hA 10 h (D.classNode G I j h hF) ≤
        Nat.log 2 ⌊D.S.Dstar⌋₊ := by
      unfold ModeSystem.nodeType1
      simp only [hal, ↓reduceDIte]
      refine Nat.log_mono_right (Finset.card_image_le.trans ((Finset.card_le_univ _).trans ?_))
      rw [Fintype.card_coe]
      exact hcardN
    have h2 : (D.Ms j G).nodeType2 D.S D.hA 10 h (D.classNode G I j h hF) ≤
        Nat.log 2 ⌊D.S.Dstar⌋₊ := by
      unfold ModeSystem.nodeType2
      exact Nat.log_mono_right ((Finset.card_le_card fun x hx =>
        (D.Ms j G).mem_alive_of_mem_predOfMode D.S D.hA 10 h hal hx).trans hcardN)
    exact Finset.mem_product.mpr ⟨Finset.mem_range.mpr (Nat.lt_succ_of_le h1),
      Finset.mem_range.mpr (Nat.lt_succ_of_le h2)⟩
  · exact Finset.mem_product.mpr ⟨Finset.mem_range.mpr (Nat.succ_pos _),
      Finset.mem_range.mpr (Nat.succ_pos _)⟩

end SideInput

end ActiveSetup.BasicFamilies.FamParams

/-! ## The core contribution on the side states (`eq:core-final`) -/

open Classical in
/-- The path of a point `y` through a finite family `T` of dyadic cells: the cell of `T` at the
depth `s` containing `y` (unique when it exists), and `(s, 0)` otherwise. -/
noncomputable def pathCell (G : RealDyadicGrid) (T : Finset (ℤ × ℤ)) (y : ℝ) (s : ℤ) : ℤ × ℤ :=
  if h : ∃ I ∈ T, I.1 = s ∧ y ∈ dyadicGridCell G I.1 I.2 then h.choose else (s, 0)

theorem pathCell_fst (G : RealDyadicGrid) (T : Finset (ℤ × ℤ)) (y : ℝ) (s : ℤ) :
    (pathCell G T y s).1 = s := by
  unfold pathCell
  split_ifs with h
  · exact h.choose_spec.2.1
  · rfl

theorem pathCell_eq (G : RealDyadicGrid) {T : Finset (ℤ × ℤ)} {y : ℝ} {I : ℤ × ℤ} (hI : I ∈ T)
    (hy : y ∈ dyadicGridCell G I.1 I.2) : pathCell G T y I.1 = I := by
  have hex : ∃ J ∈ T, J.1 = I.1 ∧ y ∈ dyadicGridCell G J.1 J.2 := ⟨I, hI, rfl, hy⟩
  have key : ∀ J : ℤ × ℤ, J.1 = I.1 → y ∈ dyadicGridCell G J.1 J.2 → J = I := by
    intro J h1 h2
    obtain ⟨j1, j2⟩ := J
    simp only at h1 h2
    subst h1
    exact Prod.ext rfl (dyadicGridCell_sameDepth_common_point G _ _ _ h2 hy)
  unfold pathCell
  simp only [hex, ↓reduceDIte]
  exact key _ hex.choose_spec.2.1 hex.choose_spec.2.2

open Classical in
/-- Reindexing the cells of a path by their depths (blueprint `eq:path`): for the cells of `T`
containing `y` and their groups, `Σ_{I ∋ y} Σ_{G ∈ g(I)} f(I, G) = Σ_G Σ_{s ∈ S_G} f(I_s, G)`, with
`S_G` the depths of the cells containing `y` at which `G` is used and `I_s = pathCell`. -/
theorem path_sum_reindex {ι : Type*} [DecidableEq ι] (G : RealDyadicGrid) (T : Finset (ℤ × ℤ))
    (gs : ℤ × ℤ → Finset ι) (y : ℝ) (f : ℤ × ℤ → ι → ℝ) :
    ∑ I ∈ T with y ∈ dyadicGridCell G I.1 I.2, ∑ g ∈ gs I, f I g =
      ∑ g ∈ (T.filter fun I => y ∈ dyadicGridCell G I.1 I.2).biUnion gs,
        ∑ s ∈ ((T.filter fun I => y ∈ dyadicGridCell G I.1 I.2).filter fun I => g ∈ gs I).image
          Prod.fst, f (pathCell G T y s) g := by
  set Ty := T.filter fun I => y ∈ dyadicGridCell G I.1 I.2 with hTy
  rw [Finset.sum_comm' (t' := Ty.biUnion gs) (s' := fun g => Ty.filter fun I => g ∈ gs I)
    (fun I g => by
      simp only [Finset.mem_filter, Finset.mem_biUnion]
      constructor
      · rintro ⟨hI, hg⟩; exact ⟨⟨hI, hg⟩, I, hI, hg⟩
      · rintro ⟨⟨hI, hg⟩, -⟩; exact ⟨hI, hg⟩)]
  refine Finset.sum_congr rfl fun g _ => ?_
  have hinj : Set.InjOn Prod.fst (Ty.filter fun I => g ∈ gs I : Set (ℤ × ℤ)) := by
    intro I hI J hJ hIJ
    have hI' := Finset.mem_filter.mp (Finset.mem_filter.mp (Finset.mem_coe.mp hI)).1
    have hJ' := Finset.mem_filter.mp (Finset.mem_filter.mp (Finset.mem_coe.mp hJ)).1
    have hJy : y ∈ dyadicGridCell G I.1 J.2 := by rw [hIJ]; exact hJ'.2
    exact Prod.ext hIJ (dyadicGridCell_sameDepth_common_point G I.1 _ _ hI'.2 hJy)
  rw [Finset.sum_image hinj]
  refine Finset.sum_congr rfl fun I hI => ?_
  have hI' := Finset.mem_filter.mp (Finset.mem_filter.mp hI).1
  rw [pathCell_eq G hI'.1 hI'.2]

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

/-- The four-core bin value factors as `fourKC · 2 · 12⁴ · μ ν^{-J} Π_j σ_j`. -/
theorem fourBinVal_eq (J : ℕ) (c : ℝ × ℝ × (Fin 4 → ℝ)) :
    fourBinVal κ' J c = fourKC κ' J * 2 * 12 ^ 4 * (c.1 * (c.2.1 ^ J)⁻¹) * ∏ j, c.2.2 j := by
  unfold fourBinVal
  rw [Finset.prod_congr rfl fun j _ => (show 6 * (2 * c.2.2 j) = 12 * c.2.2 j by ring),
    Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  ring

end SideInput


  calc ENNReal.ofReal (D.δ / 4) * ((2 : ℝ≥0∞) ^ (1 / 2 : ℝ) * ENNReal.ofReal C4 ^ 2 *
        ∑ m ∈ D.TJ I, D.ewin j m ^ (2 : ℝ))
      ≤ ENNReal.ofReal (D.δ / 4) * ((2 : ℝ≥0∞) ^ (1 / 2 : ℝ) * ENNReal.ofReal C4 ^ 2 *
          ((ENNReal.ofReal (16 * D.δ))⁻¹ * 8 * ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),

  refine (lintegral_mono hinner).trans ?_
  have hO := ENNReal.lintegral_prod_norm_pow_le (μ := volume) Finset.univ
    (f := fun j y => X j y ^ p j) (fun j _ => ((hX j).pow_const _).aemeasurable)
    (p := fun j => 1 / p j) hsum (fun j _ => by have := hp j; positivity)

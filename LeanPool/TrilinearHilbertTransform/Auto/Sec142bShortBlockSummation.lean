/-- Blueprint line 2331 (total mass): `∫_E |z|² ≤ |E|`. -/
theorem leafUnion_mass_le (hdis : (S : Set ι).PairwiseDisjoint (leafInterval aL lL))
    (z : ℝ → ℂ) (hz : ∀ i ∈ S, ∫⁻ x in leafInterval aL lL i, ‖z x‖ₑ ^ 2 ≤ ENNReal.ofReal (lL i)) :
    ∫⁻ x in leafUnion S aL lL, ‖z x‖ₑ ^ 2 ≤ volume (leafUnion S aL lL) := by
  have h := leaf_mass_le hdis z hz Set.univ
  rw [Set.univ_inter] at h
  refine h.trans (measure_mono ?_)
  intro x hx
  simp only [Set.mem_iUnion, Finset.mem_filter] at hx
  obtain ⟨i, ⟨hi, -⟩, hx⟩ := hx
  exact Set.mem_biUnion hi hx

/-- Blueprint lines 2332-2333 (regular slots): leaves of length at most `ρ` meeting an interval
window of length `ℓ` carry mass at most `ℓ + 2ρ`. -/
theorem leaf_window_mass_le (hdis : (S : Set ι).PairwiseDisjoint (leafInterval aL lL))
    (z : ℝ → ℂ) (hz : ∀ i ∈ S, ∫⁻ x in leafInterval aL lL i, ‖z x‖ₑ ^ 2 ≤ ENNReal.ofReal (lL i))
    {ρ : ℝ} (hρ : ∀ i ∈ S, lL i ≤ ρ) (x₀ ℓ : ℝ) :
    ∫⁻ x in Set.Ico x₀ (x₀ + ℓ) ∩ leafUnion S aL lL, ‖z x‖ₑ ^ 2 ≤ ENNReal.ofReal (ℓ + 2 * ρ) := by
  refine (leaf_mass_le hdis z hz _).trans ?_
  calc _ ≤ volume (Set.Ico (x₀ - ρ) (x₀ + ℓ + ρ)) := by
        apply measure_mono
        intro x hx
        simp only [Set.mem_iUnion, Finset.mem_filter] at hx
        obtain ⟨i, ⟨hi, y, hyW, hyL⟩, hx⟩ := hx
        simp only [leafInterval, Set.mem_Ico] at hyW hyL hx ⊢
        have := hρ i hi
        constructor <;> linarith
    _ = _ := by rw [Real.volume_Ico]; congr 1; ring

/-- Blueprint line 2334 (local bound): if every leaf meeting a set `I` lies inside `I`, the mass
on `I` is at most `|I|`. -/
theorem leaf_local_mass_le (hdis : (S : Set ι).PairwiseDisjoint (leafInterval aL lL))
    (z : ℝ → ℂ) (hz : ∀ i ∈ S, ∫⁻ x in leafInterval aL lL i, ‖z x‖ₑ ^ 2 ≤ ENNReal.ofReal (lL i))
    (I : Set ℝ) (hI : ∀ i ∈ S, (I ∩ leafInterval aL lL i).Nonempty → leafInterval aL lL i ⊆ I) :
    ∫⁻ x in I ∩ leafUnion S aL lL, ‖z x‖ₑ ^ 2 ≤ volume I := by
  refine (leaf_mass_le hdis z hz I).trans (measure_mono ?_)
  intro x hx
  simp only [Set.mem_iUnion, Finset.mem_filter] at hx
  obtain ⟨i, ⟨hi, hne⟩, hx⟩ := hx
  exact hI i hi hne hx

end WindowMass

/-- The `δ`-windows `[δ(n + c), δ(n + c + 1))`, `n ∈ ℤ`, tile the line: for every shift `c`,
`Σ_n ∫_{window n} g = ∫ g`. -/
theorem lintegral_window_tiling {δ : ℝ} (hδ : 0 < δ) (c : ℝ) (g : ℝ → ℝ≥0∞) :
    ∑' n : ℤ, ∫⁻ x in Set.Ico (δ * (n + c)) (δ * (n + c + 1)), g x = ∫⁻ x, g x := by
  have hdis : Pairwise (Function.onFun Disjoint
      fun n : ℤ => Set.Ico (δ * (n + c)) (δ * (n + c + 1))) := by
    intro n m hnm
    refine Set.disjoint_left.mpr fun x hx hx' => hnm ?_
    simp only [Set.mem_Ico] at hx hx'
    have h1 : (n : ℝ) < m + 1 := by nlinarith
    have h2 : (m : ℝ) < n + 1 := by nlinarith
    have h1' : n < m + 1 := by exact_mod_cast h1
    have h2' : m < n + 1 := by exact_mod_cast h2
    omega
  have hcov : (⋃ n : ℤ, Set.Ico (δ * (n + c)) (δ * (n + c + 1))) = Set.univ := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true, Set.mem_Ico]
    refine ⟨⌊x / δ - c⌋, ?_, ?_⟩
    · have := Int.floor_le (x / δ - c)
      have h : δ * (⌊x / δ - c⌋ + c) ≤ δ * (x / δ) := by
        apply mul_le_mul_of_nonneg_left (by linarith only [this]) hδ.le
      rwa [mul_div_cancel₀ _ hδ.ne'] at h
    · have := Int.lt_floor_add_one (x / δ - c)
      have h : δ * (x / δ) < δ * (⌊x / δ - c⌋ + c + 1) := by
        apply mul_lt_mul_of_pos_left (by linarith only [this]) hδ
      rwa [mul_div_cancel₀ _ hδ.ne'] at h
  rw [← lintegral_iUnion (fun _ => measurableSet_Ico) hdis, hcov, Measure.restrict_univ]

/-- Windows of `K` consecutive unit lengths cover every point `K` times:
`Σ_n ∫_{[δ(n+c), δ(n+c+K))} g = K ∫ g` (the lift intervals in slots `2, 3`). -/
theorem lintegral_window_sum (K : ℕ) {δ : ℝ} (hδ : 0 < δ) (c : ℝ) (g : ℝ → ℝ≥0∞) :
    ∑' n : ℤ, ∫⁻ x in Set.Ico (δ * (n + c)) (δ * (n + c + K)), g x = K * ∫⁻ x, g x := by
  induction K with
  | zero => simp
  | succ K ih =>
    have hsplit : ∀ n : ℤ, ∫⁻ x in Set.Ico (δ * (n + c)) (δ * (n + c + (K + 1 : ℕ))), g x =
        (∫⁻ x in Set.Ico (δ * (n + c)) (δ * (n + c + K)), g x) +
          ∫⁻ x in Set.Ico (δ * (n + (c + K))) (δ * (n + (c + K) + 1)), g x := by
      intro n
      rw [← lintegral_union measurableSet_Ico]
      · congr 2
        rw [show δ * ((n : ℝ) + (c + K)) = δ * (n + c + K) by ring,
          show δ * ((n : ℝ) + (c + K) + 1) = δ * (n + c + ((K + 1 : ℕ) : ℝ)) by push_cast; ring,
          Set.Ico_union_Ico_eq_Ico]
        · apply mul_le_mul_of_nonneg_left _ hδ.le
          have := (Nat.cast_nonneg K : (0 : ℝ) ≤ K)
          linarith
        · apply mul_le_mul_of_nonneg_left _ hδ.le
          push_cast; linarith
      · rw [show δ * (n + (c + K)) = δ * (n + c + K) by ring]
        exact Set.Ico_disjoint_Ico_same
    simp_rw [hsplit]
    rw [ENNReal.tsum_add, ih, lintegral_window_tiling hδ]
    push_cast; ring

/-- Parseval for fast trigonometric sums on the circle of length `16`:
`(1/16) ∫₀¹⁶ |Σ_m a_m e(m w / 16)|² dw = Σ_m |a_m|²`. -/
theorem fast_parseval (s : Finset ℤ) (a : ℤ → ℂ) :
    (1 / 16) * ∫ w in (0 : ℝ)..16, ‖∑ m ∈ s, a m * ePhase (m * w / 16)‖ ^ 2 =
      ∑ m ∈ s, ‖a m‖ ^ 2 := by
  classical
  have hsq : ∀ w : ℝ, ((‖∑ m ∈ s, a m * ePhase (m * w / 16)‖ ^ 2 : ℝ) : ℂ) =
      ∑ m₁ ∈ s, ∑ m₂ ∈ s, a m₁ * (starRingEnd ℂ) (a m₂) *
        ePhase (((m₁ - m₂ : ℤ) : ℝ) * w / 16) := by
    intro w
    rw [Complex.ofReal_pow, ← Complex.mul_conj', map_sum, Finset.sum_mul_sum]
    refine Finset.sum_congr rfl fun m₁ _ => Finset.sum_congr rfl fun m₂ _ => ?_
    rw [map_mul, ePhase_conj]
    have : ePhase (m₁ * w / 16) * ePhase (-(m₂ * w / 16)) =
        ePhase (((m₁ - m₂ : ℤ) : ℝ) * w / 16) := by
      rw [ePhase_add]; congr 1; push_cast; ring
    rw [← this]; ring
  have hc : ∀ m₁ m₂ : ℤ, Continuous fun w : ℝ =>
      a m₁ * (starRingEnd ℂ) (a m₂) * ePhase (((m₁ - m₂ : ℤ) : ℝ) * w / 16) := by
    intro m₁ m₂; have := continuous_ePhase; fun_prop
  have hint : ((∫ w in (0 : ℝ)..16, ‖∑ m ∈ s, a m * ePhase (m * w / 16)‖ ^ 2 : ℝ) : ℂ) =
      16 * ∑ m ∈ s, ((‖a m‖ ^ 2 : ℝ) : ℂ) := by
    rw [← intervalIntegral.integral_ofReal]
    simp_rw [hsq]
    rw [intervalIntegral.integral_finsetSum fun m₁ _ =>
      (continuous_finsetSum _ fun m₂ _ => hc m₁ m₂).intervalIntegrable _ _, Finset.mul_sum]
    refine Finset.sum_congr rfl fun m₁ hm₁ => ?_
    rw [intervalIntegral.integral_finsetSum fun m₂ _ => (hc m₁ m₂).intervalIntegrable _ _]
    simp_rw [intervalIntegral.integral_const_mul,
      integral_ePhase_int _ (by norm_num : (0 : ℝ) < 16)]
    rw [Finset.sum_eq_single m₁]
    · simp only [sub_self, ↓reduceIte]
      rw [Complex.mul_conj', ← Complex.ofReal_pow]
      push_cast; ring
    · intro m₂ _ hne
      have : m₁ - m₂ ≠ 0 := sub_ne_zero.mpr (Ne.symm hne)
      simp [this]
    · intro h; exact absurd hm₁ h
  have := congrArg Complex.re hint
  simp only [Complex.ofReal_re] at this
  rw [this]
  simp only [Complex.mul_re, Complex.re_ofNat, Complex.im_ofNat, zero_mul, sub_zero]
  rw [Complex.re_sum]
  simp only [Complex.ofReal_re]
  ring

/-- Blueprint line 2330 ("Minkowski and the sign moments"): if a random function `F^σ` on a
window satisfies the pointwise moment bound `(E|F^σ(w)|^a)^{1/a} ≤ C_a Z(w)` with `a ≥ 2`, then
`(E ‖F^σ‖₂^a)^{1/a} ≤ C_a ‖Z‖₂`. -/
theorem random_L2_moment {Ω T : Type*} [MeasurableSpace Ω] [MeasurableSpace T]
    (P : Measure Ω) [SigmaFinite P] (ν : Measure T) [SFinite ν] (F : Ω → T → ℂ)
    (hF : Measurable (Function.uncurry F)) {a : ℝ} (ha : 2 ≤ a) {Z : T → ℝ≥0∞}
    (hZ : Measurable Z) {Ca : ℝ≥0∞}
    (hmom : ∀ w, (∫⁻ σ, ‖F σ w‖ₑ ^ a ∂P) ^ (1 / a) ≤ Ca * Z w) :
    (∫⁻ σ, (∫⁻ w, ‖F σ w‖ₑ ^ (2 : ℝ) ∂ν) ^ (a / 2) ∂P) ^ (1 / a) ≤
      Ca * (∫⁻ w, Z w ^ (2 : ℝ) ∂ν) ^ (1 / 2 : ℝ) := by
  have ha0 : 0 < a := by linarith
  set g : Ω → T → ℝ≥0∞ := fun σ w => ‖F σ w‖ₑ ^ (2 : ℝ)
  have hg : Measurable (Function.uncurry g) := hF.enorm.pow_const _
  have hmink := lintegral_minkowski (μ := P) (ν := ν) (p := a / 2) (by linarith only [ha]) hg
  have hinner : ∀ w, (∫⁻ σ, g σ w ^ (a / 2) ∂P) ^ (1 / (a / 2)) ≤ (Ca * Z w) ^ (2 : ℝ) := by
    intro w
    have e1 : ∀ σ, g σ w ^ (a / 2) = ‖F σ w‖ₑ ^ a := fun σ => by
      simp only [g]; rw [← ENNReal.rpow_mul]; congr 1; ring
    simp_rw [e1]
    calc (∫⁻ σ, ‖F σ w‖ₑ ^ a ∂P) ^ (1 / (a / 2)) =
          ((∫⁻ σ, ‖F σ w‖ₑ ^ a ∂P) ^ (1 / a)) ^ (2 : ℝ) := by
          rw [← ENNReal.rpow_mul]; congr 1; field_simp
      _ ≤ (Ca * Z w) ^ (2 : ℝ) := ENNReal.rpow_le_rpow (hmom w) (by norm_num)
  have h2 : (∫⁻ σ, (∫⁻ w, g σ w ∂ν) ^ (a / 2) ∂P) ^ (1 / (a / 2)) ≤
      Ca ^ (2 : ℝ) * ∫⁻ w, Z w ^ (2 : ℝ) ∂ν := by
    refine hmink.trans ((lintegral_mono hinner).trans (le_of_eq ?_))
    simp_rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 2)]
    exact lintegral_const_mul _ (hZ.pow_const _)
  calc (∫⁻ σ, (∫⁻ w, ‖F σ w‖ₑ ^ (2 : ℝ) ∂ν) ^ (a / 2) ∂P) ^ (1 / a)
      = ((∫⁻ σ, (∫⁻ w, g σ w ∂ν) ^ (a / 2) ∂P) ^ (1 / (a / 2))) ^ (1 / 2 : ℝ) := by
        rw [← ENNReal.rpow_mul]; congr 1; field_simp
    _ ≤ (Ca ^ (2 : ℝ) * ∫⁻ w, Z w ^ (2 : ℝ) ∂ν) ^ (1 / 2 : ℝ) :=
        ENNReal.rpow_le_rpow h2 (by norm_num)
    _ = Ca * (∫⁻ w, Z w ^ (2 : ℝ) ∂ν) ^ (1 / 2 : ℝ) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul]
        norm_num

/-- Blueprint lines 2336-2340 ("Hölder in the random variables"): averaging the mixed absolute
estimate over a random parameter `ω ∈ (Ω, P)` and applying Hölder with four `L⁴(P)` factors,
`E ∫ Π_j g_j^ω(n_j, w_j) ≤ C Π_j (E ‖g_j^ω‖_{L^{p_j}}⁴)^{1/4}`. -/
theorem latticeTorus_random_holder (B : Finset (ℤ × ℤ)) {ε M C : ℝ≥0∞} (hC1 : 1 ≤ C)
    (hB : ε ^ 2 * B.card ≤ C) (hM : ε * M ≤ C)
    (hfib : ∀ j : Fin 4, ∀ m, ((B.filter fun n => latticeCoord j n = m).card : ℝ≥0∞) ≤ M)
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (g : Ω → Fin 4 → ℤ × FastCircle → ℝ≥0∞) (hg : ∀ ω i, Measurable (g ω i))
    (p : Fin 4 → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i) (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2)
    (hgm : ∀ i, AEMeasurable (fun ω => eLpNorm (g ω i) (p i) (latticeCircleMeasure ε)) P) :
    ∫⁻ ω, ∫⁻ x, ∏ i, g ω i (latticeTorusProj i x) ∂latticeTorusMeasure B ε ∂P ≤
      C * ∏ i, (∫⁻ ω, eLpNorm (g ω i) (p i) (latticeCircleMeasure ε) ^ (4 : ℝ) ∂P) ^
        (1 / 4 : ℝ) := by
  set X : Fin 4 → Ω → ℝ≥0∞ := fun i ω => eLpNorm (g ω i) (p i) (latticeCircleMeasure ε)
  calc ∫⁻ ω, ∫⁻ x, ∏ i, g ω i (latticeTorusProj i x) ∂latticeTorusMeasure B ε ∂P
      ≤ ∫⁻ ω, C * ∏ i, X i ω ∂P := lintegral_mono fun ω =>
        latticeTorus_eLpNorm_bound B hC1 hB hM hfib (g ω) (hg ω) p hp hsum
    _ = C * ∫⁻ ω, ∏ i, X i ω ∂P := lintegral_const_mul'' _
        (Finset.aemeasurable_fun_prod _ fun i _ => hgm i)
    _ ≤ C * ∏ i, (∫⁻ ω, X i ω ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) := by
        gcongr
        have h := ENNReal.lintegral_prod_norm_pow_le (μ := P) Finset.univ
          (f := fun i ω => X i ω ^ (4 : ℝ)) (fun i _ => (hgm i).pow_const _)
          (p := fun _ => (1 / 4 : ℝ)) (by simp) (fun _ _ => by norm_num)
        refine le_trans (le_of_eq ?_) h
        congr 1; funext ω
        refine Finset.prod_congr rfl fun i _ => ?_
        rw [← ENNReal.rpow_mul]; norm_num

/-- Cauchy–Schwarz on the normalized fast circle: `∫ h ≤ (∫ h²)^{1/2}`. -/
theorem lintegral_fastHaar_le_sqrt {h : FastCircle → ℝ≥0∞} (hh : Measurable h) :
    ∫⁻ t, h t ∂fastHaar ≤ (∫⁻ t, h t ^ (2 : ℝ) ∂fastHaar) ^ (1 / 2 : ℝ) := by
  have := ENNReal.lintegral_mul_le_Lp_mul_Lq fastHaar (Real.HolderConjugate.two_two)
    hh.aemeasurable (aemeasurable_const (b := (1 : ℝ≥0∞)))
  simpa using this

/-- Blueprint lines 2336-2337 (the heavy slot, "unitarity and Minkowski"): the `L⁴(P)` norm of
the local `L¹` norm is at most `ε Σ_m (E ‖g(m, ·)‖₂⁴)^{1/4}`. -/
theorem heavy_slot_L4_le (ε : ℝ≥0∞) {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [SigmaFinite P] (g : Ω → ℤ × FastCircle → ℝ≥0∞) (hg : Measurable (Function.uncurry g)) :
    (∫⁻ ω, (∫⁻ y, g ω y ∂latticeCircleMeasure ε) ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ε * ∑' m : ℤ, (∫⁻ ω, ((∫⁻ t, g ω (m, t) ^ (2 : ℝ) ∂fastHaar) ^ (1 / 2 : ℝ)) ^ (4 : ℝ) ∂P) ^
        (1 / 4 : ℝ) := by
  have hgω : ∀ ω, Measurable (g ω) := fun ω => hg.comp (measurable_const.prodMk measurable_id)
  set h : Ω → ℤ → ℝ≥0∞ := fun ω m => (∫⁻ t, g ω (m, t) ^ (2 : ℝ) ∂fastHaar) ^ (1 / 2 : ℝ)
  have hhm : Measurable (Function.uncurry h) := by
    apply measurable_from_prod_countable_left
    intro m
    have : Measurable fun p : Ω × FastCircle => g p.1 (m, p.2) ^ (2 : ℝ) :=
      (hg.comp (measurable_fst.prodMk (measurable_const.prodMk measurable_snd))).pow_const _
    exact (this.lintegral_prod_right').pow_const _
  have hpt : ∀ ω, ∫⁻ y, g ω y ∂latticeCircleMeasure ε ≤ ε * ∑' m, h ω m := by
    intro ω
    rw [lintegral_latticeCircleMeasure ε (hgω ω)]
    gcongr with m
    exact lintegral_fastHaar_le_sqrt ((hgω ω).comp measurable_prodMk_left)
  calc (∫⁻ ω, (∫⁻ y, g ω y ∂latticeCircleMeasure ε) ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ)
      ≤ (∫⁻ ω, (ε * ∑' m, h ω m) ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) := by
        gcongr with ω; exact hpt ω
    _ = ε * (∫⁻ ω, (∑' m, h ω m) ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) := by
        simp_rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 4)]
        have hm : Measurable fun ω => (∑' m, h ω m) ^ (4 : ℝ) :=
          (Measurable.tsum fun m =>
            hhm.comp (measurable_id.prodMk measurable_const)).pow_const _
        rw [lintegral_const_mul _ hm, ENNReal.mul_rpow_of_nonneg _ _ (by norm_num),
          ← ENNReal.rpow_mul]
        norm_num
    _ ≤ ε * ∑' m, (∫⁻ ω, h ω m ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) := by
        gcongr
        have := lintegral_minkowski (μ := P) (ν := (Measure.count : Measure ℤ)) (p := 4)
          (by norm_num) hhm
        simpa [lintegral_count] using this

/-- Blueprint line 2338 ("normalized norm monotonicity", regular slots): a function supported on
the windows of finitely many slow points `S` has local `L³` norm at most `(ε |S|)^{1/12}` times
its local `L⁴` norm. -/
theorem regular_slot_L3_le_L4 (ε : ℝ≥0∞) (S : Finset ℤ) {g : ℤ × FastCircle → ℝ≥0∞}
    (hg : Measurable g) (hS : ∀ y, y.1 ∉ S → g y = 0) :
    eLpNorm g 3 (latticeCircleMeasure ε) ≤
      eLpNorm g 4 (latticeCircleMeasure ε) * (ε * S.card) ^ (1 / 12 : ℝ) := by
  set U : Set (ℤ × FastCircle) := (S : Set ℤ) ×ˢ Set.univ
  have hsupp : Function.support g ⊆ U := by
    intro y hy
    refine ⟨?_, Set.mem_univ _⟩
    by_contra h; exact hy (hS y h)
  have hU : latticeCircleMeasure ε U = ε * S.card := by
    rw [latticeCircleMeasure, Measure.prod_prod, measure_univ, mul_one, Measure.smul_apply,
      Measure.count_apply_finset, smul_eq_mul]
  have h := eLpNorm_le_eLpNorm_mul_rpow_measure_univ (μ := (latticeCircleMeasure ε).restrict U)
    (p := 3) (q := 4) (by norm_num) (f := g) hg.aestronglyMeasurable
  rw [eLpNorm_restrict_eq_of_support_subset hg.aestronglyMeasurable hsupp,
    eLpNorm_restrict_eq_of_support_subset hg.aestronglyMeasurable hsupp,
    Measure.restrict_apply_univ, hU] at h
  refine h.trans (le_of_eq ?_)
  congr 2
  norm_num

/-- The fourth power of the local `L⁴` norm: `‖g‖₄⁴ = ε Σ_m ∫ g(m, ·)⁴`. -/
theorem latticeCircle_eLpNorm_four (ε : ℝ≥0∞) {g : ℤ × FastCircle → ℝ≥0∞} (hg : Measurable g) :
    eLpNorm g 4 (latticeCircleMeasure ε) ^ (4 : ℝ) =
      ε * ∑' m : ℤ, ∫⁻ t, g (m, t) ^ (4 : ℝ) ∂fastHaar := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num) hg.aestronglyMeasurable,
    ← ENNReal.rpow_mul]
  norm_num
  rw [lintegral_latticeCircleMeasure ε (hg.pow_const _)]

/-- Haar averages on the fast circle are interval averages over one period. -/
theorem integral_fastHaar_eq (f : FastCircle → ℝ) :
    ∫ t, f t ∂fastHaar = (1 / 16) * ∫ x in (0 : ℝ)..16, f x := by
  rw [AddCircle.integral_haarAddCircle, smul_eq_mul, one_div]
  congr 1
  have := AddCircle.intervalIntegral_preimage (16 : ℝ) 0 f
  rw [zero_add] at this
  exact this.symm

/-- The multiplied fast trigonometric polynomial as a function on the fast circle. -/
noncomputable def fastCircleMultiplied (s : Finset ℤ) (a : ℤ → ℂ) (c : ℤ) (γ : ℝ)
    (t : FastCircle) : ℂ :=
  ∑ m ∈ s, a m * ePhase (γ * (m : ℝ) ^ 2 / c) * fourier m t

theorem fastCircleMultiplied_coe (s : Finset ℤ) (a : ℤ → ℂ) (c : ℤ) (γ x : ℝ) :
    fastCircleMultiplied s a c γ (x : FastCircle) = fastMultiplied s a c γ x := by
  unfold fastCircleMultiplied fastMultiplied
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [fourier_coe_apply, show Complex.exp (2 * Real.pi * Complex.I * m * x / ((16 : ℝ) : ℂ)) =
    ePhase (m * x / 16) by unfold ePhase; congr 1; push_cast; ring, mul_assoc, ePhase_add]

theorem continuous_fastCircleMultiplied (s : Finset ℤ) (a : ℤ → ℂ) (c : ℤ) (γ : ℝ) :
    Continuous (fastCircleMultiplied s a c γ) := by
  unfold fastCircleMultiplied
  exact continuous_finsetSum _ fun m _ => continuous_const.mul (fourier m).continuous

/-- Blueprint `eq:fourth-moment` (lines 2318-2322) on the fast circle with normalized Haar
measure, for finite Fourier sums: `E_γ ∫ |U_γ F|⁴ ≤ 2 ‖F‖₂⁴` with `‖F‖₂² = Σ |a_m|²`. -/
theorem fast_fourth_moment_circle (s : Finset ℤ) (a : ℤ → ℂ) {c : ℤ} (hc0 : c ≠ 0)
    (hc : c ∣ 3) :
    (1 / 3) * ∫ γ in (0 : ℝ)..3, ∫ t, ‖fastCircleMultiplied s a c γ t‖ ^ 4 ∂fastHaar ≤
      2 * (∑ m ∈ s, ‖a m‖ ^ 2) ^ 2 := by
  have h := fast_fourth_moment s a hc0 hc
  refine le_trans (le_of_eq ?_) h
  congr 1
  refine intervalIntegral.integral_congr fun γ _ => ?_
  rw [integral_fastHaar_eq]
  simp only [fastCircleMultiplied_coe]

/-- Unitarity of the fast multipliers (Parseval on the fast circle):
`∫ |U_γ F|² = Σ_m |a_m|²`. -/
theorem fast_circle_parseval (s : Finset ℤ) (a : ℤ → ℂ) (c : ℤ) (γ : ℝ) :
    ∫ t, ‖fastCircleMultiplied s a c γ t‖ ^ 2 ∂fastHaar = ∑ m ∈ s, ‖a m‖ ^ 2 := by
  rw [integral_fastHaar_eq]
  simp only [fastCircleMultiplied_coe]
  have h := fast_parseval s (fun m => a m * ePhase (γ * (m : ℝ) ^ 2 / c))
  have e : ∀ w : ℝ, fastMultiplied s a c γ w =
      ∑ m ∈ s, a m * ePhase (γ * (m : ℝ) ^ 2 / c) * ePhase (m * w / 16) := by
    intro w
    unfold fastMultiplied
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [mul_assoc, ePhase_add]
  simp_rw [e]
  rw [h]
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [norm_mul, norm_ePhase, mul_one]

theorem continuous_fastCircleMultiplied_joint (s : Finset ℤ) (a : ℤ → ℂ) (c : ℤ) :
    Continuous fun p : ℝ × FastCircle => fastCircleMultiplied s a c p.1 p.2 := by
  unfold fastCircleMultiplied
  refine continuous_finsetSum _ fun m _ => ?_
  have := continuous_ePhase
  exact (continuous_const.mul (this.comp (by fun_prop))).mul
    ((fourier m).continuous.comp continuous_snd)

/-- Unitarity in `ℝ≥0∞` form: `∫⁻ |U_γ F|² = Σ |a_m|²`. -/
theorem lintegral_fastCircle_sq (s : Finset ℤ) (a : ℤ → ℂ) (c : ℤ) (γ : ℝ) :
    ∫⁻ t, ‖fastCircleMultiplied s a c γ t‖ₑ ^ (2 : ℝ) ∂fastHaar =
      ENNReal.ofReal (∑ m ∈ s, ‖a m‖ ^ 2) := by
  have hc := continuous_fastCircleMultiplied s a c γ
  rw [← fast_circle_parseval s a c γ, ofReal_integral_eq_lintegral_ofReal]
  · refine lintegral_congr fun t => ?_
    rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num),
      Real.rpow_two]
  · exact (hc.norm.pow 2).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  · exact Filter.Eventually.of_forall fun t => by positivity

/-- `eq:fourth-moment` in `ℝ≥0∞` form with the uniform `γ`-average. -/
theorem lintegral_fastCircle_fourth (s : Finset ℤ) (a : ℤ → ℂ) {c : ℤ} (hc0 : c ≠ 0)
    (hc : c ∣ 3) :
    ∫⁻ γ, ∫⁻ t, ‖fastCircleMultiplied s a c γ t‖ₑ ^ (4 : ℝ) ∂fastHaar ∂gammaMeasure ≤
      ENNReal.ofReal (2 * (∑ m ∈ s, ‖a m‖ ^ 2) ^ 2) := by
  set F : ℝ → ℝ := fun γ => ∫ t, ‖fastCircleMultiplied s a c γ t‖ ^ 4 ∂fastHaar
  have hj := continuous_fastCircleMultiplied_joint s a c
  have hFc : Continuous F := by
    have := continuous_parametric_integral_of_continuous (μ := fastHaar)
      (f := fun γ t => ‖fastCircleMultiplied s a c γ t‖ ^ 4)
      ((hj.norm.pow 4).congr fun p => rfl) isCompact_univ
    simpa only [Measure.restrict_univ] using this
  have hin : ∀ γ, ∫⁻ t, ‖fastCircleMultiplied s a c γ t‖ₑ ^ (4 : ℝ) ∂fastHaar =
      ENNReal.ofReal (F γ) := by
    intro γ
    have hc := continuous_fastCircleMultiplied s a c γ
    rw [ofReal_integral_eq_lintegral_ofReal]
    · refine lintegral_congr fun t => ?_
      rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num),
        show (4 : ℝ) = ((4 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
    · exact (hc.norm.pow 4).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    · exact Filter.Eventually.of_forall fun t => by positivity
  simp_rw [hin]
  have hF0 : ∀ γ, 0 ≤ F γ := fun γ => integral_nonneg fun t => by positivity
  rw [gammaMeasure, lintegral_smul_measure, ← ofReal_integral_eq_lintegral_ofReal
    (hFc.integrableOn_Ioc) (Filter.Eventually.of_forall hF0), smul_eq_mul, ← ENNReal.ofReal_mul
    (by norm_num), ← intervalIntegral.integral_of_le (by norm_num)]
  exact ENNReal.ofReal_le_ofReal (fast_fourth_moment_circle s a hc0 hc)

/-- The random multiplied fast window of slot data `A`: at the random parameter `q = (ω, γ)` and
the point `(m, t)`, `|U_γ F^ω(m, ·)(t)|` with `F^ω(m, ·) = Σ_k A(ω, m, k) e(k t / 16)`. -/
noncomputable def fastWindow {Ω : Type*} (s : Finset ℤ) (A : Ω → ℤ → ℤ → ℂ) (c : ℤ)
    (q : Ω × ℝ) (y : ℤ × FastCircle) : ℝ≥0∞ :=
  ‖fastCircleMultiplied s (A q.1 y.1) c q.2 y.2‖ₑ

theorem measurable_fastWindow {Ω : Type*} [MeasurableSpace Ω] (s : Finset ℤ)
    {A : Ω → ℤ → ℤ → ℂ} (hA : ∀ m k, Measurable fun ω => A ω m k) (c : ℤ) :
    Measurable fun p : (Ω × ℝ) × (ℤ × FastCircle) => fastWindow s A c p.1 p.2 := by
  have h : ∀ m : ℤ, Measurable fun p : (Ω × ℝ) × FastCircle =>
      ‖fastCircleMultiplied s (A p.1.1 m) c p.1.2 p.2‖ₑ := by
    intro m
    unfold fastCircleMultiplied
    refine (Finset.measurable_sum _ fun k _ => ?_).enorm
    have hc : Continuous fun p : ℝ × FastCircle => ePhase (p.1 * (k : ℝ) ^ 2 / c) * fourier k p.2 :=
      (continuous_ePhase.comp (by fun_prop)).mul ((fourier k).continuous.comp continuous_snd)
    have := ((hA m k).comp (measurable_fst.comp measurable_fst)).mul
      (hc.measurable.comp ((measurable_snd.comp measurable_fst).prodMk measurable_snd))
    convert this using 1
    funext p; simp only [Function.comp_apply, Pi.mul_apply]; ring
  have e : (fun p : (Ω × ℝ) × (ℤ × FastCircle) => fastWindow s A c p.1 p.2) =
      fun p => (fun r : ((Ω × ℝ) × FastCircle) × ℤ =>
        ‖fastCircleMultiplied s (A r.1.1.1 r.2) c r.1.1.2 r.1.2‖ₑ) ((p.1, p.2.2), p.2.1) := rfl
  rw [e]
  exact (measurable_from_prod_countable_left (f := fun r : ((Ω × ℝ) × FastCircle) × ℤ =>
      ‖fastCircleMultiplied s (A r.1.1.1 r.2) c r.1.1.2 r.1.2‖ₑ) fun m => h m).comp
    ((measurable_fst.prodMk (measurable_snd.comp measurable_snd)).prodMk
      (measurable_fst.comp measurable_snd))

theorem measurable_fastWindow_section {Ω : Type*} (s : Finset ℤ) (A : Ω → ℤ → ℤ → ℂ) (c : ℤ)
    (q : Ω × ℝ) : Measurable (fastWindow s A c q) := by
  unfold fastWindow
  apply measurable_from_prod_countable_right
  intro m
  exact (continuous_fastCircleMultiplied s (A q.1 m) c q.2).enorm.measurable

theorem fastCircleMultiplied_zero (s : Finset ℤ) (c : ℤ) (γ : ℝ) (t : FastCircle) :
    fastCircleMultiplied s (fun _ => 0) c γ t = 0 := by
  simp [fastCircleMultiplied]

/-- Blueprint lines 2334-2340 (deletion error at one cell): for random multiplied windows built
from fast data `A_j` supported on slow points `S_j`, the expected positive form is at most
`C` times, in the heavy slot `h`, `ε Σ_m (E e_h(m)⁴)^{1/4}`, and in each regular slot,
`((ε|S_j|)^{1/3} ε Σ_m E 2 e_j(m)⁴)^{1/4}` (exponents `(1, 3, 3, 3)`, Hölder in `(ω, γ)`,
Minkowski and unitarity in the heavy slot, `eq:fourth-moment` in the regular slots). -/
theorem per_cell_deletion_bound (B : Finset (ℤ × ℤ)) {ε M C : ℝ≥0∞} (hC1 : 1 ≤ C)
    (hB : ε ^ 2 * B.card ≤ C) (hM : ε * M ≤ C)
    (hfib : ∀ j : Fin 4, ∀ m, ((B.filter fun n => latticeCoord j n = m).card : ℝ≥0∞) ≤ M)
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (s : Finset ℤ)
    (A : Fin 4 → Ω → ℤ → ℤ → ℂ) (hA : ∀ j m k, Measurable fun ω => A j ω m k)
    (S : Fin 4 → Finset ℤ) (hS : ∀ j ω m, m ∉ S j → A j ω m = fun _ => 0) (h : Fin 4) :
    ∫⁻ q, ∫⁻ x, ∏ j, fastWindow s (A j) (fastSlotC j) q (latticeTorusProj j x)
        ∂latticeTorusMeasure B ε ∂(P.prod gammaMeasure) ≤
      C * ∏ j, (if j = h then
        ε * ∑ m ∈ S j, (∫⁻ ω, ENNReal.ofReal (fastMass s (A j) ω m) ^ (2 : ℝ) ∂P) ^ (1 / 4 : ℝ)
      else ((ε * (S j).card) ^ (1 / 3 : ℝ) *
        (ε * ∑ m ∈ S j, ∫⁻ ω, ENNReal.ofReal (2 * fastMass s (A j) ω m ^ 2) ∂P)) ^
          (1 / 4 : ℝ)) := by
  classical
  let g : Ω × ℝ → Fin 4 → ℤ × FastCircle → ℝ≥0∞ := fun q j => fastWindow s (A j) (fastSlotC j) q
  have hgj : ∀ j, Measurable fun p : (Ω × ℝ) × (ℤ × FastCircle) => g p.1 j p.2 := fun j =>
    measurable_fastWindow s (hA j) (fastSlotC j)
  have hg : ∀ q j, Measurable (g q j) := fun q j =>
    measurable_fastWindow_section s (A j) (fastSlotC j) q
  let p : Fin 4 → ℝ≥0∞ := fun j => if j = h then 1 else 3
  have hp : ∀ j, 1 ≤ p j := fun j => by simp only [p]; split_ifs <;> norm_num
  have hp0 : ∀ j, p j ≠ 0 := fun j => (lt_of_lt_of_le one_pos (hp j)).ne'
  have hpt : ∀ j, p j ≠ ⊤ := fun j => by simp only [p]; split_ifs <;> simp
  have hsum : ∑ j, (p j).toReal⁻¹ ≤ 2 := by
    simp only [p]; fin_cases h <;> simp [Fin.sum_univ_four] <;> norm_num
  have hgm : ∀ j, AEMeasurable (fun q => eLpNorm (g q j) (p j) (latticeCircleMeasure ε))
      (P.prod gammaMeasure) := by
    intro j
    have e : (fun q => eLpNorm (g q j) (p j) (latticeCircleMeasure ε)) = fun q =>
        (∫⁻ y, g q j y ^ (p j).toReal ∂latticeCircleMeasure ε) ^ (1 / (p j).toReal) := by
      funext q
      rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (hp0 j) (hpt j) (hg q j).aestronglyMeasurable]
      simp only [enorm_eq_self]
    rw [e]
    exact (((hgj j).pow_const _).lintegral_prod_right').pow_const _ |>.aemeasurable
  refine (latticeTorus_random_holder B hC1 hB hM hfib (P.prod gammaMeasure) g hg p hp hsum
    hgm).trans ?_
  gcongr with j
  -- the zero windows outside the supports
  have hzero : ∀ q y, y.1 ∉ S j → g q j y = 0 := by
    intro q y hy
    simp only [g, fastWindow, hS j q.1 y.1 hy, fastCircleMultiplied_zero, enorm_zero]
  by_cases hjh : j = h
  · -- the heavy slot
    subst hjh
    simp only [↓reduceIte, p]
    have e1 : ∀ q, eLpNorm (g q j) 1 (latticeCircleMeasure ε) =
        ∫⁻ y, g q j y ∂latticeCircleMeasure ε := fun q => by
      rw [eLpNorm_one_eq_lintegral_enorm (hg q j).aestronglyMeasurable]; simp
    simp_rw [e1]
    have hU : Measurable (Function.uncurry fun q => g q j) := hgj j
    refine (heavy_slot_L4_le ε (P.prod gammaMeasure) (fun q => g q j) hU).trans (le_of_eq ?_)
    congr 1
    have hfm : ∀ m, Measurable fun ω => fastMass s (A j) ω m := fun m =>
      Finset.measurable_sum _ fun k _ => (hA j m k).norm.pow_const 2
    have hterm : ∀ m, (∫⁻ q, ((∫⁻ t, g q j (m, t) ^ (2 : ℝ) ∂fastHaar) ^ (1 / 2 : ℝ)) ^ (4 : ℝ)
        ∂(P.prod gammaMeasure)) ^ (1 / 4 : ℝ) =
        (∫⁻ ω, ENNReal.ofReal (fastMass s (A j) ω m) ^ (2 : ℝ) ∂P) ^ (1 / 4 : ℝ) := by
      intro m
      congr 1
      have hin : ∀ q : Ω × ℝ, ((∫⁻ t, g q j (m, t) ^ (2 : ℝ) ∂fastHaar) ^ (1 / 2 : ℝ)) ^
          (4 : ℝ) = ENNReal.ofReal (fastMass s (A j) q.1 m) ^ (2 : ℝ) := by
        intro q
        simp only [g, fastWindow]
        rw [lintegral_fastCircle_sq, ← ENNReal.rpow_mul]
        norm_num; rfl
      simp_rw [hin]
      rw [lintegral_prod (f := fun q : Ω × ℝ => ENNReal.ofReal (fastMass s (A j) q.1 m) ^ (2 : ℝ))
        ((ENNReal.measurable_ofReal.comp ((hfm m).comp measurable_fst)).pow_const _).aemeasurable]
      simp only [lintegral_const, measure_univ, mul_one]
    rw [tsum_congr hterm]
    refine tsum_eq_sum fun m hm => ?_
    have h0 : ∀ ω, fastMass s (A j) ω m = 0 := fun ω => by
      simp [fastMass, hS j ω m hm]
    simp [h0]
  · -- a regular slot
    simp only [hjh, ↓reduceIte, p]
    gcongr
    have hfm : ∀ m, Measurable fun ω => fastMass s (A j) ω m := fun m =>
      Finset.measurable_sum _ fun k _ => (hA j m k).norm.pow_const 2
    -- joint measurability of the fourth powers of the windows at a slow point
    have hF : ∀ m : ℤ, Measurable fun p : (Ω × ℝ) × FastCircle => g p.1 j (m, p.2) ^ (4 : ℝ) :=
      fun m => ((hgj j).comp (measurable_fst.prodMk
        (measurable_const.prodMk measurable_snd))).pow_const _
    have hF4 : ∀ m : ℤ, Measurable fun q : Ω × ℝ => ∫⁻ t, g q j (m, t) ^ (4 : ℝ) ∂fastHaar :=
      fun m => (hF m).lintegral_prod_right'
    calc ∫⁻ q, eLpNorm (g q j) 3 (latticeCircleMeasure ε) ^ (4 : ℝ) ∂(P.prod gammaMeasure)
        ≤ ∫⁻ q, (ε * (S j).card) ^ (1 / 3 : ℝ) *
            (ε * ∑' m : ℤ, ∫⁻ t, g q j (m, t) ^ (4 : ℝ) ∂fastHaar) ∂(P.prod gammaMeasure) := by
          refine lintegral_mono fun q => ?_
          have h3 := regular_slot_L3_le_L4 ε (S j) (hg q j) (hzero q)
          have h4 := latticeCircle_eLpNorm_four ε (hg q j)
          calc eLpNorm (g q j) 3 (latticeCircleMeasure ε) ^ (4 : ℝ)
              ≤ (eLpNorm (g q j) 4 (latticeCircleMeasure ε) * (ε * (S j).card) ^ (1 / 12 : ℝ)) ^
                  (4 : ℝ) := ENNReal.rpow_le_rpow h3 (by norm_num)
            _ = _ := by
                rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), h4, ← ENNReal.rpow_mul,
                  mul_comm]
                norm_num
      _ = (ε * (S j).card) ^ (1 / 3 : ℝ) *
            (ε * ∑' m : ℤ, ∫⁻ q, ∫⁻ t, g q j (m, t) ^ (4 : ℝ) ∂fastHaar
              ∂(P.prod gammaMeasure)) := by
          rw [lintegral_const_mul _ ((Measurable.tsum fun m => hF4 m).const_mul _),
            lintegral_const_mul _ (Measurable.tsum fun m => hF4 m),
            lintegral_tsum fun m => (hF4 m).aemeasurable]
      _ ≤ (ε * (S j).card) ^ (1 / 3 : ℝ) *
            (ε * ∑ m ∈ S j, ∫⁻ ω, ENNReal.ofReal (2 * fastMass s (A j) ω m ^ 2) ∂P) := by
          gcongr
          rw [tsum_eq_sum (s := S j) fun m hm => ?_]
          · refine Finset.sum_le_sum fun m _ => ?_
            rw [lintegral_prod _ (hF4 m).aemeasurable]
            refine lintegral_mono fun ω => ?_
            have := lintegral_fastCircle_fourth s (A j ω m) (fastSlotC_ne_zero j)
              (fastSlotC_dvd j)
            simpa only [g, fastWindow, fastMass] using this
          · have h0 : ∀ q t, g q j (m, t) = 0 := fun q t => hzero q (m, t) hm
            simp [h0]

/-- The interval input `g(y) = Σ_{m ∈ T} G(m) 1_{|y - δ m| < c δ}` of blueprint line 2346. -/
noncomputable def intervalInput (δ c : ℝ) (T : Finset ℤ) (G : ℤ → ℂ) (y : ℝ) : ℂ :=
  ∑ m ∈ T, G m * (if |y - δ * m| < c * δ then 1 else 0)

/-- The cell of the lattice pair `n`: all four progression coordinates within `c δ` of the
centers `δ n_j`. -/
def intervalCell (δ c : ℝ) (n : ℤ × ℤ) : Set (ℝ × ℝ) :=
  {z | ∀ j : Fin 4, |realProgressionCoordinate j z - δ * latticeCoord j n| < c * δ}

open Classical in
/-- Blueprint lines 2347-2349, pointwise: the product of the four interval inputs on a real
progression is the sum over lattice pairs `n` of `Π_j G_j(n_j)` on the cell of `n`. -/
theorem intervalInput_prod {δ c : ℝ} (hδ : 0 < δ) (hc : c < 1 / 7) (T : Fin 4 → Finset ℤ)
    (G : Fin 4 → ℤ → ℂ) (hG : ∀ j m, m ∉ T j → G j m = 0) (z : ℝ × ℝ) :
    ∏ j, intervalInput δ c (T j) (G j) (realProgressionCoordinate j z) =
      ∑ n ∈ T 0 ×ˢ T 1, (∏ j, G j (latticeCoord j n)) *
        (if z ∈ intervalCell δ c n then 1 else 0) := by
  classical
  unfold intervalInput
  rw [Finset.prod_univ_sum]
  -- every nonzero term is indexed by a lattice progression
  have key : ∀ m : Fin 4 → ℤ, (∏ j, G j (m j) * (if |realProgressionCoordinate j z - δ * m j| <
      c * δ then 1 else 0)) = if m = fun j : Fin 4 => latticeCoord j (m 0, m 1) then
        (∏ j, G j (latticeCoord j (m 0, m 1))) *
          (if z ∈ intervalCell δ c (m 0, m 1) then 1 else 0) else 0 := by
    intro m
    by_cases hall : ∀ j, |realProgressionCoordinate j z - δ * m j| < c * δ
    · have hprog : m = fun j : Fin 4 => latticeCoord j (m 0, m 1) :=
        funext fun j => interval_centers_progression hδ hc m z hall j
      rw [ite_eq_left hprog]
      have hcell : z ∈ intervalCell δ c (m 0, m 1) := fun j => by
        rw [← congrFun hprog j]; exact hall j
      rw [ite_eq_left hcell, mul_one]
      refine Finset.prod_congr rfl fun j _ => ?_
      rw [ite_eq_left (hall j), mul_one, ← congrFun hprog j]
    · push Not at hall
      obtain ⟨j, hj⟩ := hall
      have h0 : (∏ j, G j (m j) * (if |realProgressionCoordinate j z - δ * m j| < c * δ then
          (1 : ℂ) else 0)) = 0 :=
        Finset.prod_eq_zero (Finset.mem_univ j) (by rw [ite_eq_right (not_lt.mpr hj), mul_zero])
      rw [h0]
      split_ifs with hprog hcell
      · exfalso; apply not_lt.mpr hj; rw [congrFun hprog j]; exact hcell j
      · rw [mul_zero]
      · rfl
  simp_rw [key]
  set prog : ℤ × ℤ → Fin 4 → ℤ := fun n j => latticeCoord j n
  set F : ℤ × ℤ → ℂ := fun n => (∏ j, G j (latticeCoord j n)) *
    (if z ∈ intervalCell δ c n then 1 else 0)
  have hp0 : ∀ n : ℤ × ℤ, prog n 0 = n.1 := fun n => by simp [prog, latticeCoord]
  have hp1 : ∀ n : ℤ × ℤ, prog n 1 = n.2 := fun n => by simp [prog, latticeCoord]
  have hinj : ∀ (m : Fin 4 → ℤ) (n : ℤ × ℤ), m = prog n → n = (m 0, m 1) := by
    rintro m n rfl; rw [hp0, hp1]
  have hL : ∀ m ∈ Fintype.piFinset T, (if m = prog (m 0, m 1) then F (m 0, m 1) else 0) =
      ∑ n ∈ T 0 ×ˢ T 1, if m = prog n then F n else 0 := by
    intro m hm
    by_cases h : m = prog (m 0, m 1)
    · rw [ite_eq_left h, Finset.sum_eq_single (m 0, m 1)]
      · rw [ite_eq_left h]
      · intro n _ hne
        rw [ite_eq_right fun e => hne (hinj m n e)]
      · intro hn
        exact absurd (Finset.mem_product.mpr ⟨Fintype.mem_piFinset.mp hm 0,
          Fintype.mem_piFinset.mp hm 1⟩) hn
    · rw [ite_eq_right h]
      symm
      refine Finset.sum_eq_zero fun n _ => ite_eq_right fun e => h ?_
      rw [← hinj m n e]; exact e
  change ∑ m ∈ Fintype.piFinset T, (if m = prog (m 0, m 1) then F (m 0, m 1) else 0) =
    ∑ n ∈ T 0 ×ˢ T 1, F n
  rw [Finset.sum_congr rfl hL, Finset.sum_comm]
  refine Finset.sum_congr rfl fun n _ => ?_
  rw [Finset.sum_ite_eq']
  split_ifs with hn
  · rfl
  · -- some coordinate leaves its support, so the product vanishes
    rw [Fintype.mem_piFinset] at hn
    push Not at hn
    obtain ⟨j, hj⟩ := hn
    symm
    simp only [F]
    rw [Finset.prod_eq_zero (Finset.mem_univ j) (hG j _ hj), zero_mul]

/-- The fixed offset polygon `{(u, v) : |u + j v| < c, j = 0, …, 3}` of blueprint line 2350. -/
def offsetPolygon (c : ℝ) : Set (ℝ × ℝ) := {a | ∀ j : Fin 4, |a.1 + (j : ℝ) * a.2| < c}

/-- Each interval cell is the preimage of the offset polygon under `z ↦ δ⁻¹ (z - a_n)`. -/
theorem intervalCell_eq {δ c : ℝ} (hδ : 0 < δ) (n : ℤ × ℤ) :
    intervalCell δ c n = (fun z : ℝ × ℝ => δ⁻¹ • (z + -((δ * n.1, δ * (n.2 - n.1)) : ℝ × ℝ))) ⁻¹'
      offsetPolygon c := by
  ext z
  simp only [intervalCell, offsetPolygon, Set.mem_ofPred_eq, Set.mem_preimage, Prod.smul_fst,
    Prod.smul_snd, Prod.fst_add, Prod.snd_add, Prod.fst_neg, Prod.snd_neg, smul_eq_mul]
  refine forall_congr' fun j => ?_
  rw [show δ⁻¹ * (z.1 + -(δ * n.1)) + (j : ℝ) * (δ⁻¹ * (z.2 + -(δ * (n.2 - n.1)))) =
    (realProgressionCoordinate j z - δ * latticeCoord j n) / δ by
      simp only [realProgressionCoordinate, latticeCoord]; push_cast; field_simp; ring,
    abs_div, abs_of_pos hδ, div_lt_iff₀ hδ]

/-- `|intervalCell| = δ² |offsetPolygon|`. -/
theorem volume_intervalCell {δ c : ℝ} (hδ : 0 < δ) (n : ℤ × ℤ) :
    volume (intervalCell δ c n) = ENNReal.ofReal (δ ^ 2) * volume (offsetPolygon c) := by
  rw [intervalCell_eq hδ]
  set b : ℝ × ℝ := -((δ * n.1, δ * (n.2 - n.1)) : ℝ × ℝ)
  have hpre : (fun z : ℝ × ℝ => δ⁻¹ • (z + b)) ⁻¹' offsetPolygon c =
      (fun z => z + b) ⁻¹' ((fun z : ℝ × ℝ => δ⁻¹ • z) ⁻¹' offsetPolygon c) := rfl
  rw [hpre, measure_preimage_add_right, Measure.addHaar_preimage_smul _ (inv_ne_zero hδ.ne')]
  congr 2
  simp [Module.finrank_prod, abs_of_pos hδ]

theorem measurableSet_intervalCell (δ c : ℝ) (n : ℤ × ℤ) : MeasurableSet (intervalCell δ c n) := by
  have : intervalCell δ c n = ⋂ j : Fin 4,
      {z : ℝ × ℝ | |realProgressionCoordinate j z - δ * latticeCoord j n| < c * δ} := by
    ext z; simp [intervalCell]
  rw [this]
  refine MeasurableSet.iInter fun j => ?_
  exact (isOpen_lt (by unfold realProgressionCoordinate; fun_prop) continuous_const).measurableSet

theorem offsetPolygon_subset (c : ℝ) :
    offsetPolygon c ⊆ Set.Icc (-c) c ×ˢ Set.Icc (-(2 * c)) (2 * c) := by
  intro a ha
  have h0 := ha 0
  have h1 := ha 1
  simp only [Fin.val_zero, Nat.cast_zero, zero_mul, add_zero, Fin.val_one, Nat.cast_one,
    one_mul] at h0 h1
  rw [abs_lt] at h0 h1
  exact ⟨⟨by linarith, by linarith⟩, ⟨by linarith, by linarith⟩⟩

theorem volume_offsetPolygon_lt_top (c : ℝ) : volume (offsetPolygon c) < ⊤ := by
  refine (measure_mono (offsetPolygon_subset c)).trans_lt ?_
  rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Icc, Real.volume_Icc]
  exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top

/-- The rounding to the nearest center: if `|x - δ m| < c δ` with `c ≤ 1/2`, then
`⌊x/δ + 1/2⌋ = m`. -/
theorem round_center {δ c x : ℝ} (hδ : 0 < δ) (hc : c ≤ 1 / 2) {m : ℤ}
    (h : |x - δ * m| < c * δ) : ⌊x / δ + 1 / 2⌋ = m := by
  rw [Int.floor_eq_iff]
  rw [abs_lt] at h
  have h1 : x / δ - m < 1 / 2 := by
    rw [sub_lt_iff_lt_add, div_lt_iff₀ hδ]; nlinarith
  have h2 : -(1 / 2) ≤ x / δ - m := by
    rw [le_sub_iff_add_le, le_div_iff₀ hδ]; nlinarith
  constructor <;> linarith

/-- Blueprint lines 2347-2352 (continuous comparison, sampled kernel): with interval inputs and
the kernel sampled at the rounded centers, the continuous progression form equals
`δ² |offsetPolygon|` times the lattice form `Σ_n K(n) Π_j G_j(n_j)`. -/
theorem interval_form_identity {δ c : ℝ} (hδ : 0 < δ) (hc : c < 1 / 7) (T : Fin 4 → Finset ℤ)
    (G : Fin 4 → ℤ → ℂ) (hG : ∀ j m, m ∉ T j → G j m = 0) (K : ℤ × ℤ → ℂ) :
    ∫ z : ℝ × ℝ, K (⌊z.1 / δ + 1 / 2⌋, ⌊(z.1 + z.2) / δ + 1 / 2⌋) *
        ∏ j, intervalInput δ c (T j) (G j) (realProgressionCoordinate j z) =
      ((δ ^ 2 * (volume (offsetPolygon c)).toReal : ℝ) : ℂ) *
        ∑ n ∈ T 0 ×ˢ T 1, K n * ∏ j, G j (latticeCoord j n) := by
  classical
  have hc2 : c ≤ 1 / 2 := by linarith
  have hfin : ∀ n, volume (intervalCell δ c n) ≠ ⊤ := fun n => by
    rw [volume_intervalCell hδ]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top (volume_offsetPolygon_lt_top c).ne
  have hpt : ∀ z : ℝ × ℝ, K (⌊z.1 / δ + 1 / 2⌋, ⌊(z.1 + z.2) / δ + 1 / 2⌋) *
      ∏ j, intervalInput δ c (T j) (G j) (realProgressionCoordinate j z) =
        ∑ n ∈ T 0 ×ˢ T 1, (intervalCell δ c n).indicator
          (fun _ => K n * ∏ j, G j (latticeCoord j n)) z := by
    intro z
    rw [intervalInput_prod hδ hc T G hG z, Finset.mul_sum]
    refine Finset.sum_congr rfl fun n _ => ?_
    by_cases hz : z ∈ intervalCell δ c n
    · rw [Set.indicator_of_mem hz, ite_eq_left hz, mul_one]
      have e0 := hz 0
      have e1 := hz 1
      simp only [realProgressionCoordinate, latticeCoord, Fin.val_zero, Nat.cast_zero, zero_mul,
        add_zero, Fin.val_one, Nat.cast_one, one_mul, sub_zero, sub_self] at e0 e1
      rw [round_center hδ hc2 (m := n.1) (by simpa using e0),
        round_center hδ hc2 (m := n.2) (by simpa using e1)]
    · rw [Set.indicator_of_notMem hz, ite_eq_right hz, mul_zero, mul_zero]
  simp_rw [hpt]
  rw [integral_finsetSum _ fun n _ =>
    (integrable_indicator_iff (measurableSet_intervalCell δ c n)).mpr
    (integrableOn_const (hfin n))]
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun n _ => ?_
  rw [integral_indicator_const _ (measurableSet_intervalCell δ c n), Measure.real,
    volume_intervalCell hδ, ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity),
    Complex.real_smul]

/-- The kernel sampled at the rounded centers: with `n₀ = ⌊x/δ + 1/2⌋` and
`n₁ = ⌊(x + t)/δ + 1/2⌋`, its value is `w(δ n₀, δ(n₁ - n₀))` (blueprint line 2353). -/
noncomputable def roundSampledKernel (δ : ℝ) (w : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  w (δ * ⌊z.1 / δ + 1 / 2⌋, δ * ⌊(z.1 + z.2) / δ + 1 / 2⌋ - δ * ⌊z.1 / δ + 1 / 2⌋)

theorem roundSampled_offsets {δ : ℝ} (hδ : 0 < δ) (z : ℝ × ℝ) :
    -(δ / 2) ≤ z.1 - δ * ⌊z.1 / δ + 1 / 2⌋ ∧ z.1 - δ * ⌊z.1 / δ + 1 / 2⌋ < δ / 2 ∧
      -(δ / 2) ≤ (z.1 + z.2) - δ * ⌊(z.1 + z.2) / δ + 1 / 2⌋ ∧
        (z.1 + z.2) - δ * ⌊(z.1 + z.2) / δ + 1 / 2⌋ < δ / 2 := by
  have k1 := Int.floor_le (z.1 / δ + 1 / 2)
  have k2 := Int.lt_floor_add_one (z.1 / δ + 1 / 2)
  have k3 := Int.floor_le ((z.1 + z.2) / δ + 1 / 2)
  have k4 := Int.lt_floor_add_one ((z.1 + z.2) / δ + 1 / 2)
  have e1 : z.1 = δ * (z.1 / δ) := by field_simp
  have e2 : z.1 + z.2 = δ * ((z.1 + z.2) / δ) := by field_simp
  refine ⟨by nlinarith only [hδ, k1, e1], by nlinarith only [hδ, k2, e1], by nlinarith,
      by nlinarith⟩

/-- Blueprint lines 2353-2355 (second kernel-sampling error): replacing an admissible kernel on a
cell of length `r` by its values at the rounded centers changes the form by at most
`4 C_κ (δ / r)` times the product of normalized local norms, for `5 δ ≤ μ r`. -/
theorem roundSampled_form_error {κ : LocalKernelClass} {a r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a r w) {δ : ℝ} (hδ : 0 < δ)
    (hδr : 5 * δ ≤ κ.margin * r)
    (f : Fin 4 → ℝ → ℂ) (hf : ∀ i, Measurable (f i))
    (p : Fin 4 → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i) (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    ‖localProgressionForm r (fun z => w z - roundSampledKernel δ w z) f‖ₑ ≤
      ENNReal.ofReal (4 * admissibleLipConst κ * (δ / r)) *
        ∏ i, eLpNorm (f i) (p i) (normalizedIntervalMeasure a r) := by
  set e : ℝ × ℝ → ℂ := fun z => w z - roundSampledKernel δ w z
  have hwc : Continuous w := hw.smooth.continuous
  have hem : Measurable e := by
    have h1 : Measurable fun z : ℝ × ℝ =>
        (δ * ⌊z.1 / δ + 1 / 2⌋, δ * ⌊(z.1 + z.2) / δ + 1 / 2⌋ - δ * ⌊z.1 / δ + 1 / 2⌋) := by
      have m1 : Measurable fun z : ℝ × ℝ => (⌊z.1 / δ + 1 / 2⌋ : ℝ) :=
        measurable_from_top.comp
          (Int.measurable_floor.comp ((measurable_fst.div_const δ).add_const _))
      have m2 : Measurable fun z : ℝ × ℝ => (⌊(z.1 + z.2) / δ + 1 / 2⌋ : ℝ) :=
        measurable_from_top.comp (Int.measurable_floor.comp
          (((measurable_fst.add measurable_snd).div_const δ).add_const _))
      exact (m1.const_mul δ).prodMk ((m2.const_mul δ).sub (m1.const_mul δ))
    exact hwc.measurable.sub (hwc.measurable.comp h1)
  -- pointwise size of the error kernel
  have hsize : ∀ z, ‖e z‖ ≤ 2 * admissibleLipConst κ * (δ / r) := by
    intro z
    obtain ⟨o1, o2, o3, o4⟩ := roundSampled_offsets hδ z
    have := admissible_kernel_lipschitz hw z
      (δ * ⌊z.1 / δ + 1 / 2⌋, δ * ⌊(z.1 + z.2) / δ + 1 / 2⌋ - δ * ⌊z.1 / δ + 1 / 2⌋)
    simp only at this
    have hx : |z.1 - δ * ⌊z.1 / δ + 1 / 2⌋| ≤ δ := by
      rw [abs_le]; constructor <;> linarith only [hδ, o1, o2]
    have ht : |z.2 - (δ * ⌊(z.1 + z.2) / δ + 1 / 2⌋ - δ * ⌊z.1 / δ + 1 / 2⌋)| ≤ δ := by
      rw [abs_le]; constructor <;> linarith
    have hL := admissibleLipConst_nonneg κ
    calc ‖e z‖ ≤ _ := this
      _ ≤ admissibleLipConst κ * r⁻¹ * (δ + δ) := by gcongr
      _ = 2 * admissibleLipConst κ * (δ / r) := by ring
  -- support inside the cell
  have hsupp : HasLocalProgressionSupport a r e := by
    intro z hz j
    have hμ := κ.margin_pos
    by_cases h0 : w z ≠ 0
    · obtain ⟨h1, h2⟩ := hw.support z h0 j
      constructor <;> nlinarith [mul_pos hμ hr]
    · push Not at h0
      have h0' : roundSampledKernel δ w z ≠ 0 := by
        intro h; apply hz; simp only [e, h0, h, sub_self]
      obtain ⟨h1, h2⟩ := hw.support _ h0' j
      obtain ⟨o1, o2, o3, o4⟩ := roundSampled_offsets hδ z
      have hj0 : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg _
      have hj3 : (j : ℝ) ≤ 3 := by exact_mod_cast Nat.le_of_lt_succ j.isLt
      simp only [realProgressionCoordinate] at h1 h2 ⊢
      set X := z.1 - δ * ⌊z.1 / δ + 1 / 2⌋
      set Y := (z.1 + z.2) - δ * ⌊(z.1 + z.2) / δ + 1 / 2⌋
      have hcoord : z.1 + (j : ℝ) * z.2 = (δ * ⌊z.1 / δ + 1 / 2⌋ + (j : ℝ) *
          (δ * ⌊(z.1 + z.2) / δ + 1 / 2⌋ - δ * ⌊z.1 / δ + 1 / 2⌋)) +
            ((1 - (j : ℝ)) * X + (j : ℝ) * Y) := by
        simp only [X, Y]; ring
      have hd1 : |(1 - (j : ℝ)) * X + (j : ℝ) * Y| ≤ 5 * δ := by
        rw [abs_le]; constructor <;> nlinarith only [hj3, o1, o2, o3, o4]
      rw [abs_le] at hd1
      rw [hcoord]
      constructor <;> nlinarith only [mul_pos hμ hr, hδr, h1, hj3, o1, o2, o3, h2, o4]
  -- the form estimate
  have hW : ∀ z, ‖e z‖ₑ ≤ ENNReal.ofReal (2 * admissibleLipConst κ * (δ / r)) := fun z => by
    rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hsize z)
  have habs := localProgression_absoluteNormBound hr e hem hsupp hW f hf p hp hsum
  have hform : ‖localProgressionForm r e f‖ₑ ≤ ENNReal.ofReal r⁻¹ ^ 2 *
      ∫⁻ z : ℝ × ℝ, ‖e z‖ₑ * ∏ i, ‖f i (realProgressionCoordinate i z)‖ₑ := by
    unfold localProgressionForm
    rw [enorm_mul, enorm_pow, ← ofReal_norm, norm_inv, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hr]
    gcongr
    refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
    congr 1; funext z
    rw [enorm_mul]
    simp only [enorm_eq_nnnorm, nnnorm_prod, ENNReal.ofNNReal_finsetProd]
  refine hform.trans (habs.trans (le_of_eq ?_))
  rw [← ENNReal.ofReal_ofNat 2, ← ENNReal.ofReal_mul (by norm_num)]
  congr 2; ring

theorem measurable_intervalInput (δ c : ℝ) (T : Finset ℤ) (G : ℤ → ℂ) :
    Measurable (intervalInput δ c T G) := by
  unfold intervalInput
  refine Finset.measurable_sum _ fun m _ => measurable_const.mul ?_
  refine Measurable.ite ?_ measurable_const measurable_const
  exact (isOpen_lt (by fun_prop) continuous_const).measurableSet

theorem intervalInput_eq_zero {δ c : ℝ} (T : Finset ℤ) (G : ℤ → ℂ) {y : ℝ}
    (hy : ∀ m ∈ T, c * δ ≤ |y - δ * m|) : intervalInput δ c T G y = 0 := by
  unfold intervalInput
  exact Finset.sum_eq_zero fun m hm => by rw [ite_eq_right (not_lt.mpr (hy m hm)), mul_zero]

/-- Interval inputs have compact support. -/
theorem hasCompactSupport_intervalInput (δ c : ℝ) (T : Finset ℤ)
    (G : ℤ → ℂ) : HasCompactSupport (intervalInput δ c T G) := by
  classical
  obtain ⟨B, hB⟩ : ∃ B : ℝ, ∀ m ∈ T, |δ * m| ≤ B :=
    ⟨∑ m ∈ T, |δ * m|, fun m hm => Finset.single_le_sum (f := fun m : ℤ => |δ * (m : ℝ)|)
      (fun _ _ => abs_nonneg _) hm⟩
  refine HasCompactSupport.intro (isCompact_Icc (a := -(B + c * δ)) (b := B + c * δ))
    fun y hy => intervalInput_eq_zero T G fun m hm => ?_
  have hm := hB m hm
  simp only [Set.mem_Icc, not_and_or, not_le] at hy
  rw [abs_le] at hm
  rcases hy with hy | hy
  · rw [abs_sub_comm, le_abs]; left; linarith
  · rw [le_abs]; left; linarith

/-- Interval inputs are bounded by `Σ_m |G(m)|`. -/
theorem norm_intervalInput_le (δ c : ℝ) (T : Finset ℤ) (G : ℤ → ℂ) (y : ℝ) :
    ‖intervalInput δ c T G y‖ ≤ ∑ m ∈ T, ‖G m‖ := by
  unfold intervalInput
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m _ => ?_)
  rw [norm_mul]
  split_ifs <;> simp

/-- Interval inputs lie in every `L^p`. -/
theorem memLp_intervalInput (δ c : ℝ) (T : Finset ℤ) (G : ℤ → ℂ)
    (p : ℝ≥0∞) : MemLp (intervalInput δ c T G) p volume := by
  exact (hasCompactSupport_intervalInput δ c T G).memLp_of_bound
    (measurable_intervalInput δ c T G).aestronglyMeasurable _
    (Filter.Eventually.of_forall (norm_intervalInput_le δ c T G))

/-- Blueprint lines 2355-2357 (`eq:CN` for the interval inputs): for fixed fast and random
parameters the interval inputs are measurable, compactly supported and in every `L^q`, so the
original admissible kernels on the original summation cells (at most `N` consecutive depths)
satisfy `Σ_I |I| |H_I(g)| ≤ C_N ∫ Π_j M_q g_j`. -/
theorem cn_interval_inputs {κ : LocalKernelClass} {q : ℝ} (hq : 2 ≤ q) {N : ℕ}
    (grid : RealDyadicGrid) (cells : Finset (ℤ × ℤ)) (firstDepth : ℤ)
    (depths : ∀ c ∈ cells, firstDepth ≤ c.1 ∧ c.1 < firstDepth + N)
    (kernel : (ℤ × ℤ) → ℝ × ℝ → ℂ)
    (admissible : ∀ c ∈ cells, IsAdmissibleLocalKernel κ (dyadicGridLeft grid c.1 c.2)
      (dyadicGridLength grid c.1) (kernel c))
    (δ c : ℝ) (T : Fin 4 → Finset ℤ) (G : Fin 4 → ℤ → ℂ) :
    ENNReal.ofReal (∑ I ∈ cells, dyadicGridLength grid I.1 *
        ‖localProgressionForm (dyadicGridLength grid I.1) (kernel I)
          (fun j => intervalInput δ c (T j) (G j))‖) ≤
      ENNReal.ofReal (finiteDepthConstant κ q N) *
        ∫⁻ x, ∏ j, scalarMaximalQ q (intervalInput δ c (T j) (G j)) x :=
  finiteDepthConstant_spec hq
    { grid := grid, cells := cells, firstDepth := firstDepth, depths := depths,
      kernel := kernel, admissible := admissible,
      input := fun j => intervalInput δ c (T j) (G j),
      measurable_input := fun j => measurable_intervalInput δ c (T j) (G j),
      memLp_input := fun j => memLp_intervalInput δ c (T j) (G j) _,
      compact_input := fun j => hasCompactSupport_intervalInput δ c (T j) (G j) }

open TrilinearHT.Auto.ClassicalMaximal in
/-- Blueprint lines 2358-2362 ("one Hölder inequality of exponent four in `(γ, σ, u, v)`, then
spatial Hölder"): for exponents `p_j > 0` with `Σ 1/p_j = 1`,
`∫_y E ∫∫ Π_j h_j(y, ω, (1-j)u + jv) ≤ Π_j ‖h_j‖_{L^{p_j}_y L⁴_{ω, w}}`; each map
`(u, v) ↦ (1-j)u + jv` has Haar pushforward, so the inner norm is a single `L⁴` norm. -/
theorem mixed_holder_four {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [SFinite P]
    (h : Fin 4 → ℝ × (Ω × FastCircle) → ℝ≥0∞) (hh : ∀ j, Measurable (h j))
    (p : Fin 4 → ℝ) (hp : ∀ j, 0 < p j) (hsum : ∑ j, 1 / p j = 1) :
    ∫⁻ y, ∫⁻ q, ∏ j, h j (y, (q.1, fastCoord j q.2)) ∂(P.prod (fastHaar.prod fastHaar)) ≤
      ∏ j, mixedENorm volume (P.prod fastHaar) (p j) 4 (h j) := by
  set X : Fin 4 → ℝ → ℝ≥0∞ := fun j y => (∫⁻ z, h j (y, z) ^ (4 : ℝ) ∂(P.prod fastHaar)) ^
    (1 / 4 : ℝ)
  have hX : ∀ j, Measurable (X j) := fun j =>
    (((hh j).pow_const _).lintegral_prod_right').pow_const _
  have hinner : ∀ y, ∫⁻ q, ∏ j, h j (y, (q.1, fastCoord j q.2)) ∂(P.prod (fastHaar.prod fastHaar))
      ≤ ∏ j, X j y := by
    intro y
    have hmj : ∀ j, Measurable fun q : Ω × (FastCircle × FastCircle) =>
        h j (y, (q.1, fastCoord j q.2)) ^ (4 : ℝ) := fun j =>
      ((hh j).comp (measurable_const.prodMk (measurable_fst.prodMk
        ((continuous_fastCoord j).measurable.comp measurable_snd)))).pow_const _
    have hH := ENNReal.lintegral_prod_norm_pow_le (μ := P.prod (fastHaar.prod fastHaar))
      Finset.univ (f := fun j q => h j (y, (q.1, fastCoord j q.2)) ^ (4 : ℝ))
      (fun j _ => (hmj j).aemeasurable) (p := fun _ => (1 / 4 : ℝ)) (by simp)
      (fun _ _ => by norm_num)
    refine le_trans (le_of_eq ?_) (hH.trans (le_of_eq ?_))
    · congr 1; funext q
      refine Finset.prod_congr rfl fun j _ => ?_

/-- The interval inputs with fast/random data `F_n` (blueprint line 2346):
`g(y, z) = Σ_{n ∈ T} F_n(z) 1_{|y - δ n| < c δ}`. -/
noncomputable def fastIntervalInput {Ω : Type*} (δ c : ℝ) (T : Finset ℤ) (F : ℤ → Ω → ℂ)
    (p : ℝ × Ω) : ℂ :=
  ∑ n ∈ T, F n p.2 * (if |p.1 - δ * n| < c * δ then 1 else 0)

/-- For `c ≤ 1/2` the intervals around distinct centers are disjoint. -/
theorem interval_unique {δ c y : ℝ} (hδ : 0 < δ) (hc2 : c ≤ 1 / 2) {m n : ℤ}
    (hm : |y - δ * m| < c * δ) (hn : |y - δ * n| < c * δ) : m = n := by
  by_contra hne
  have h1 : (1 : ℝ) ≤ |(m : ℝ) - n| := by
    have : (1 : ℤ) ≤ |m - n| := Int.one_le_abs (sub_ne_zero.mpr hne)
    exact_mod_cast this
  have h2 : |δ * m - δ * n| ≤ |y - δ * m| + |y - δ * n| := by
    rw [show δ * m - δ * n = (y - δ * n) - (y - δ * m) by ring]
    exact (abs_sub _ _).trans (by rw [add_comm])
  rw [show δ * (m : ℝ) - δ * n = δ * (m - n) by ring, abs_mul, abs_of_pos hδ] at h2
  nlinarith only [hδ, hc2, hm, hn, h1, h2]

open TrilinearHT.Auto.ClassicalMaximal in
/-- Blueprint lines 2362-2364: for `c ≤ 1/2`, the mixed `L^p_y L⁴` norm of an interval input is
`‖g‖^p = Σ_{n ∈ T} 2 c δ (∫ |F_n|⁴)^{p/4}`. -/
theorem mixedENorm_fastIntervalInput_pow {Ω : Type*} [MeasurableSpace Ω] (ν : Measure Ω)
    {δ c : ℝ} (hδ : 0 < δ) (hc2 : c ≤ 1 / 2) (T : Finset ℤ) (F : ℤ → Ω → ℂ)
    {p : ℝ} (hp : 0 < p) :
    mixedENorm volume ν p 4 (fun z => ‖fastIntervalInput δ c T F z‖ₑ) ^ p =
      ∑ n ∈ T, ENNReal.ofReal (2 * (c * δ)) *
        (∫⁻ z, ‖F n z‖ₑ ^ (4 : ℝ) ∂ν) ^ (p / 4) := by
  classical
  set I : ℤ → Set ℝ := fun n => Metric.ball (δ * n) (c * δ)
  have hI : ∀ n y, y ∈ I n ↔ |y - δ * n| < c * δ := fun n y => by
    simp [I, Metric.mem_ball, Real.dist_eq]
  have hpt : ∀ y, (∫⁻ z, ‖fastIntervalInput δ c T F (y, z)‖ₑ ^ (4 : ℝ) ∂ν) ^ (p / 4) =
      ∑ n ∈ T, (I n).indicator (fun _ => (∫⁻ z, ‖F n z‖ₑ ^ (4 : ℝ) ∂ν) ^ (p / 4)) y := by
    intro y
    by_cases hex : ∃ m ∈ T, |y - δ * m| < c * δ
    · obtain ⟨m, hmT, hm⟩ := hex
      have hg : ∀ z, fastIntervalInput δ c T F (y, z) = F m z := by
        intro z
        unfold fastIntervalInput
        rw [Finset.sum_eq_single m]
        · simp only [hm, ↓reduceIte, mul_one]
        · intro n _ hnm
          have : ¬ |y - δ * n| < c * δ := fun hn =>
            hnm (interval_unique hδ hc2 hn hm)
          simp only [this, ↓reduceIte, mul_zero]
        · intro h; exact absurd hmT h
      simp_rw [hg]
      rw [Finset.sum_eq_single m]
      · rw [Set.indicator_of_mem ((hI m y).mpr hm)]
      · intro n _ hnm
        refine Set.indicator_of_notMem (fun hn => hnm ?_) _
        exact interval_unique hδ hc2 ((hI n y).mp hn) hm
      · intro h; exact absurd hmT h
    · push Not at hex
      have hg : ∀ z, fastIntervalInput δ c T F (y, z) = 0 := by
        intro z
        unfold fastIntervalInput
        exact Finset.sum_eq_zero fun n hn => by
          simp only [not_lt.mpr (hex n hn), ↓reduceIte, mul_zero]
      simp_rw [hg, enorm_zero, ENNReal.zero_rpow_of_pos (by norm_num : (0 : ℝ) < 4),
        lintegral_zero, ENNReal.zero_rpow_of_pos (by positivity : 0 < p / 4)]
      symm
      exact Finset.sum_eq_zero fun n hn =>
        Set.indicator_of_notMem (fun h => not_lt.mpr (hex n hn) ((hI n y).mp h)) _
  unfold mixedENorm
  rw [← ENNReal.rpow_mul, one_div_mul_cancel hp.ne', ENNReal.rpow_one]
  simp_rw [hpt]
  rw [lintegral_finsetSum _ fun n _ => (measurable_const.indicator measurableSet_ball)]
  refine Finset.sum_congr rfl fun n _ => ?_
  rw [lintegral_indicator_const measurableSet_ball, Real.volume_ball, mul_comm]

namespace DepthRect

/-! ### Assembly of `eq:shortblock`: the rectangle decomposition (blueprint lines 2290-2296) -/

/-- The per-slot condition of a rectangle; membership is the product of these conditions. -/
def Side : DepthRect → Fin 4 → ℕ → Prop
  | rep S v, j, x => (j ∈ S → x = v) ∧ (j ∉ S → v < x)
  | uniq a S h k, j, x => if j = a then x / 2 ^ h = 2 * k else
      (j ∈ S → x / 2 ^ h = 2 * k + 1) ∧ (j ∉ S → 2 * k + 2 ≤ x / 2 ^ h)

instance (R : DepthRect) (j : Fin 4) (x : ℕ) : Decidable (Side R j x) := by
  cases R <;> unfold Side <;> infer_instance

instance : DecidablePred Valid := fun R => by
  cases R <;> unfold Valid <;> infer_instance

theorem mem_iff_side (R : DepthRect) (d : Fin 4 → ℕ) : Mem R d ↔ ∀ j, Side R j (d j) := by
  cases R with
  | rep S v => rfl
  | uniq a S h k =>
    simp only [Mem, Side]
    constructor
    · rintro ⟨ha, hS⟩ j
      by_cases hj : j = a
      · subst hj; simp [ha]
      · simp only [hj, ↓reduceIte]; exact hS j hj
    · intro h
      refine ⟨by simpa using h a, fun j hj => ?_⟩
      have := h j
      simpa [hj] using this

/-- The finitely many rectangle parameters relevant for depths below `2^m`. -/
noncomputable def upTo (m : ℕ) : Finset DepthRect :=
  ((Finset.univ : Finset (Finset (Fin 4))) ×ˢ Finset.range (2 ^ m)).image
      (fun p => rep p.1 p.2) ∪
    ((Finset.univ : Finset (Fin 4)) ×ˢ (Finset.univ : Finset (Finset (Fin 4))) ×ˢ
      Finset.range m ×ˢ Finset.range (2 ^ m)).image (fun p => uniq p.1 p.2.1 p.2.2.1 p.2.2.2)

theorem mem_upTo_of_mem {m : ℕ} {R : DepthRect} {d : Fin 4 → ℕ} (hd : ∀ j, d j < 2 ^ m)
    (hv : Valid R) (hm : Mem R d) : R ∈ upTo m := by
  unfold upTo
  rw [Finset.mem_union]
  cases R with
  | rep S v =>
    left
    obtain ⟨j, hj⟩ : S.Nonempty := Finset.card_pos.mp (by have : 2 ≤ S.card := hv; omega)
    refine Finset.mem_image.mpr ⟨(S, v), ?_, rfl⟩
    simp only [Finset.mem_product, Finset.mem_univ, Finset.mem_range, true_and]
    rw [← (hm j).1 hj]; exact hd j
  | uniq a S h k =>
    right
    obtain ⟨hhm, hk⟩ := uniq_bounds hv hm hd
    refine Finset.mem_image.mpr ⟨(a, S, h, k), ?_, rfl⟩
    simp only [Finset.mem_product, Finset.mem_univ, Finset.mem_range, true_and]
    refine ⟨hhm, hk.trans_le (Nat.pow_le_pow_right (by norm_num) (by omega))⟩

/-- Blueprint lines 2290-2296 (the rectangles partition the depth tuples), as a partition of
unity: for depths below `2^m`, exactly one valid rectangle of `upTo m` has all four side
conditions. -/
theorem side_partition (m : ℕ) (d : Fin 4 → ℕ) (hd : ∀ j, d j < 2 ^ m) :
    ∑ R ∈ (upTo m).filter Valid, ∏ j, (if Side R j (d j) then (1 : ℂ) else 0) = 1 := by
  classical
  obtain ⟨R, ⟨hv, hm⟩, huniq⟩ := existsUnique_mem d
  rw [Finset.sum_eq_single R]
  · rw [Finset.prod_eq_one fun j _ => ite_eq_left ((mem_iff_side R d).mp hm j)]
  · intro R' hR' hne
    have hv' := (Finset.mem_filter.mp hR').2
    have : ¬ Mem R' d := fun hm' => hne (huniq R' ⟨hv', hm'⟩)
    rw [mem_iff_side] at this
    push Not at this
    obtain ⟨j, hj⟩ := this
    exact Finset.prod_eq_zero (Finset.mem_univ j) (ite_eq_right hj)
  · intro hR
    exact absurd (Finset.mem_filter.mpr ⟨mem_upTo_of_mem hd hv hm, hv⟩) hR

end DepthRect

/-- Blueprint lines 2290-2296 (multilinear splitting along the rectangles): if every point has a
leaf depth below `2^m` (a measurable labelling `dep`), then the local form splits as the sum over
the valid rectangles of the forms with the inputs restricted to the side conditions. -/
theorem localProgressionForm_rect_split (m : ℕ) (dep : ℝ → ℕ) (hdep : Measurable dep)
    (hd : ∀ y, dep y < 2 ^ m) (r : ℝ) (w : ℝ × ℝ → ℂ) (f : Fin 4 → ℝ → ℂ)
    (hint : Integrable fun z : ℝ × ℝ => w z * ∏ j, f j (realProgressionCoordinate j z)) :
    localProgressionForm r w f = ∑ R ∈ (DepthRect.upTo m).filter DepthRect.Valid,
      localProgressionForm r w (fun j y => f j y *
        if DepthRect.Side R j (dep y) then 1 else 0) := by
  classical
  unfold localProgressionForm
  rw [← Finset.mul_sum]
  congr 1
  have hterm : ∀ R : DepthRect, Integrable fun z : ℝ × ℝ => w z *
      ∏ j, (f j (realProgressionCoordinate j z) *
        if DepthRect.Side R j (dep (realProgressionCoordinate j z)) then 1 else 0) := by
    intro R
    refine Integrable.mono' hint.norm ?_ (Filter.Eventually.of_forall fun z => ?_)
    · have hm : ∀ j, Measurable fun z : ℝ × ℝ =>
          (if DepthRect.Side R j (dep (realProgressionCoordinate j z)) then (1 : ℂ) else 0) :=
        fun j => Measurable.ite
          (show MeasurableSet ((dep ∘ realProgressionCoordinate j) ⁻¹'
              {x : ℕ | DepthRect.Side R j x}) from
            measurableSet_preimage (hdep.comp (continuous_realProgressionCoordinate j).measurable)
              (Set.to_countable _).measurableSet)
          measurable_const measurable_const
      refine (hint.aestronglyMeasurable.mul
        (Finset.aestronglyMeasurable_fun_prod Finset.univ fun j _ =>
        (hm j).aestronglyMeasurable)).congr (Filter.Eventually.of_forall fun z => ?_)
      simp only [Pi.mul_apply]
      rw [mul_assoc, ← Finset.prod_mul_distrib]
    · rw [norm_mul, norm_mul, norm_prod, norm_prod]
      gcongr with j
      split_ifs <;> simp
  rw [← integral_finsetSum _ fun R _ => hterm R]
  congr 1; funext z
  rw [← Finset.mul_sum]
  congr 1
  have hp := DepthRect.side_partition m (fun j => dep (realProgressionCoordinate j z))
    fun j => hd _
  symm
  rw [Finset.sum_congr rfl fun R _ => Finset.prod_mul_distrib, ← Finset.mul_sum, hp, mul_one]

/-- The partial sum, as a function, is the unmultiplied fast trigonometric polynomial. -/
theorem coeFn_fast_partial_sum (f : Lp ℂ 2 fastHaar) (s : Finset ℤ) :
    ⇑(∑ m ∈ s, fourierCoeff f m • fourierLp (T := 16) 2 m) =ᵐ[fastHaar]
      fastCircleMultiplied s (fourierCoeff f) 1 0 := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    filter_upwards [Lp.coeFn_zero ℂ 2 fastHaar] with t ht
    simp [fastCircleMultiplied]
  | insert a s ha ih =>
    rw [Finset.sum_insert ha]
    filter_upwards [Lp.coeFn_add (fourierCoeff f a • fourierLp (T := 16) 2 a)
      (∑ m ∈ s, fourierCoeff f m • fourierLp (T := 16) 2 m),
      Lp.coeFn_smul (fourierCoeff f a) (fourierLp (T := 16) 2 a), coeFn_fourierLp 2 a, ih]
      with t h1 h2 h3 h4
    rw [h1, Pi.add_apply, h2, Pi.smul_apply, h3, h4]
    simp [fastCircleMultiplied, Finset.sum_insert ha, ePhase_zero]

/-- Blueprint lines 2324-2325 ("the `L²` progression estimate passes to limits"): the fast form of
one slow tuple is continuous in `L²` of each slot. -/
theorem fast_form_tendsto (g : Fin 4 → FastCircle → ℂ) (gN : ℕ → Fin 4 → FastCircle → ℂ)
    (hg : ∀ j, Measurable (g j)) (hgN : ∀ N j, Measurable (gN N j))
    (hL : ∀ j, MemLp (g j) 2 fastHaar) (hLN : ∀ N j, MemLp (gN N j) 2 fastHaar)
    (hconv : ∀ j, Filter.Tendsto (fun N => eLpNorm (gN N j - g j) 2 fastHaar) Filter.atTop
      (nhds 0)) :
    Filter.Tendsto (fun N => ∫ x, ∏ j : Fin 4, gN N j (fastCoord j x) ∂(fastHaar.prod fastHaar))
      Filter.atTop (nhds (∫ x, ∏ j : Fin 4, g j (fastCoord j x) ∂(fastHaar.prod fastHaar))) := by
  set d : Fin 4 → ℕ → ℝ := fun j N => (eLpNorm (gN N j - g j) 2 fastHaar).toReal
  set b : Fin 4 → ℝ := fun j => (eLpNorm (g j) 2 fastHaar).toReal
  have hd : ∀ j, Filter.Tendsto (d j) Filter.atTop (nhds 0) := fun j => by
    have := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp (hconv j)
    rw [ENNReal.toReal_zero] at this
    exact this
  have hn : ∀ N j, (eLpNorm (gN N j) 2 fastHaar).toReal ≤ d j N + b j := by
    intro N j
    have e : gN N j = (gN N j - g j) + g j := by abel
    have := eLpNorm_add_le (f := gN N j - g j) (g := g j) (μ := fastHaar)
      (by norm_num : (1 : ℝ≥0∞) ≤ 2)
    rw [← e] at this
    rw [← ENNReal.toReal_add ((hLN N j).sub (hL j)).eLpNorm_ne_top (hL j).eLpNorm_ne_top]
    exact ENNReal.toReal_mono (ENNReal.add_ne_top.mpr ⟨((hLN N j).sub (hL j)).eLpNorm_ne_top,
      (hL j).eLpNorm_ne_top⟩) this
  have hb0 : ∀ j, 0 ≤ b j := fun j => ENNReal.toReal_nonneg
  have hd0 : ∀ j N, 0 ≤ d j N := fun j N => ENNReal.toReal_nonneg
  -- the four telescoping terms
  have hbound : ∀ N, ‖(∫ x, ∏ j : Fin 4, gN N j (fastCoord j x) ∂(fastHaar.prod fastHaar)) -
      ∫ x, ∏ j : Fin 4, g j (fastCoord j x) ∂(fastHaar.prod fastHaar)‖ ≤
      d 0 N * (d 1 N + b 1) * (d 2 N + b 2) * (d 3 N + b 3) +
      b 0 * d 1 N * (d 2 N + b 2) * (d 3 N + b 3) + b 0 * b 1 * d 2 N * (d 3 N + b 3) +
      b 0 * b 1 * b 2 * d 3 N := by
    intro N
    have he : ∀ j, Measurable (gN N j - g j) := fun j => (hgN N j).sub (hg j)
    have heL : ∀ j, MemLp (gN N j - g j) 2 fastHaar := fun j => (hLN N j).sub (hL j)
    simp_rw [fast_prod_four]
    have htel : ∀ x : FastCircle × FastCircle,
        gN N 0 (fastCoord 0 x) * gN N 1 (fastCoord 1 x) * gN N 2 (fastCoord 2 x) *
          gN N 3 (fastCoord 3 x) - g 0 (fastCoord 0 x) * g 1 (fastCoord 1 x) *
          g 2 (fastCoord 2 x) * g 3 (fastCoord 3 x) =
        (gN N 0 - g 0) (fastCoord 0 x) * gN N 1 (fastCoord 1 x) * gN N 2 (fastCoord 2 x) *
          gN N 3 (fastCoord 3 x) +
        g 0 (fastCoord 0 x) * (gN N 1 - g 1) (fastCoord 1 x) * gN N 2 (fastCoord 2 x) *
          gN N 3 (fastCoord 3 x) +
        g 0 (fastCoord 0 x) * g 1 (fastCoord 1 x) * (gN N 2 - g 2) (fastCoord 2 x) *
          gN N 3 (fastCoord 3 x) +
        g 0 (fastCoord 0 x) * g 1 (fastCoord 1 x) * g 2 (fastCoord 2 x) *
          (gN N 3 - g 3) (fastCoord 3 x) := by
      intro x; simp only [Pi.sub_apply]; ring
    have I0 := fast_form_integrable4 (he 0) (hgN N 1) (hgN N 2) (hgN N 3) (heL 0) (hLN N 1)
      (hLN N 2) (hLN N 3)
    have I1 := fast_form_integrable4 (hg 0) (he 1) (hgN N 2) (hgN N 3) (hL 0) (heL 1)
      (hLN N 2) (hLN N 3)
    have I2 := fast_form_integrable4 (hg 0) (hg 1) (he 2) (hgN N 3) (hL 0) (hL 1)
      (heL 2) (hLN N 3)
    have I3 := fast_form_integrable4 (hg 0) (hg 1) (hg 2) (he 3) (hL 0) (hL 1) (hL 2) (heL 3)
    rw [← integral_sub (fast_form_integrable4 (hgN N 0) (hgN N 1) (hgN N 2) (hgN N 3)
      (hLN N 0) (hLN N 1) (hLN N 2) (hLN N 3))
      (fast_form_integrable4 (hg 0) (hg 1) (hg 2) (hg 3) (hL 0) (hL 1) (hL 2) (hL 3))]
    simp_rw [htel]
    rw [integral_add ?_ I3, integral_add ?_ I2, integral_add I0 I1]
    rotate_left
    · exact I0.add I1
    · exact (I0.add I1).add I2
    have e0 := norm_fast_form_le4 (he 0) (hgN N 1) (hgN N 2) (hgN N 3) (heL 0) (hLN N 1)
      (hLN N 2) (hLN N 3)
    have e1 := norm_fast_form_le4 (hg 0) (he 1) (hgN N 2) (hgN N 3) (hL 0) (heL 1)
      (hLN N 2) (hLN N 3)
    have e2 := norm_fast_form_le4 (hg 0) (hg 1) (he 2) (hgN N 3) (hL 0) (hL 1)
      (heL 2) (hLN N 3)
    have e3 := norm_fast_form_le4 (hg 0) (hg 1) (hg 2) (he 3) (hL 0) (hL 1) (hL 2) (heL 3)
    have n1 := hn N 1; have n2 := hn N 2; have n3 := hn N 3
    have p1 : 0 ≤ (eLpNorm (gN N 1) 2 fastHaar).toReal := ENNReal.toReal_nonneg
    have p2 : 0 ≤ (eLpNorm (gN N 2) 2 fastHaar).toReal := ENNReal.toReal_nonneg
    have p3 : 0 ≤ (eLpNorm (gN N 3) 2 fastHaar).toReal := ENNReal.toReal_nonneg
    have q0 := hd0 0 N; have q1 := hd0 1 N; have q2 := hd0 2 N; have q3 := hd0 3 N
    have r0 := hb0 0; have r1 := hb0 1; have r2 := hb0 2
    have f0 : d 0 N * (eLpNorm (gN N 1) 2 fastHaar).toReal * (eLpNorm (gN N 2) 2 fastHaar).toReal *
        (eLpNorm (gN N 3) 2 fastHaar).toReal ≤
          d 0 N * (d 1 N + b 1) * (d 2 N + b 2) * (d 3 N + b 3) := by gcongr
    have f1 : b 0 * d 1 N * (eLpNorm (gN N 2) 2 fastHaar).toReal *
        (eLpNorm (gN N 3) 2 fastHaar).toReal ≤ b 0 * d 1 N * (d 2 N + b 2) * (d 3 N + b 3) := by
      gcongr
    have f2 : b 0 * b 1 * d 2 N * (eLpNorm (gN N 3) 2 fastHaar).toReal ≤
        b 0 * b 1 * d 2 N * (d 3 N + b 3) := by gcongr
    refine (norm_add_le _ _).trans (add_le_add ((norm_add_le _ _).trans (add_le_add
      ((norm_add_le _ _).trans (add_le_add (e0.trans f0) (e1.trans f1))) (e2.trans f2))) e3)
  rw [tendsto_iff_norm_sub_tendsto_zero]
  refine squeeze_zero (fun N => norm_nonneg _) hbound ?_
  have h0 := hd 0; have h1 := hd 1; have h2 := hd 2; have h3 := hd 3
  have := ((((h0.mul (h1.add_const (b 1))).mul (h2.add_const (b 2))).mul
    (h3.add_const (b 3))).add (((((tendsto_const_nhds (x := b 0)).mul h1).mul
    (h2.add_const (b 2))).mul (h3.add_const (b 3))))).add
    ((((tendsto_const_nhds (x := b 0 * b 1)).mul h2).mul (h3.add_const (b 3)))) |>.add
    ((tendsto_const_nhds (x := b 0 * b 1 * b 2)).mul h3)
  simpa using this

theorem fourierCoeff_congr_fast {F G : FastCircle → ℂ} (h : F =ᵐ[fastHaar] G) (m : ℤ) :
    fourierCoeff F m = fourierCoeff G m := by
  unfold fourierCoeff
  exact integral_congr_ae (h.mono fun t ht => by simp only [ht])

/-- The symmetric fast partial sums `S_N F = Σ_{|m| ≤ N} F̂(m) e(m ·/16)` of an `L²` function on
the fast circle, as functions. -/
noncomputable def fastPartialSum (N : ℕ) (F : FastCircle → ℂ) : FastCircle → ℂ :=
  fastCircleMultiplied (Finset.Icc (-(N : ℤ)) N) (fourierCoeff F) 1 0

theorem continuous_fastPartialSum (N : ℕ) (F : FastCircle → ℂ) :
    Continuous (fastPartialSum N F) :=
  continuous_fastCircleMultiplied _ _ _ _

/-- `S_N F → F` in `L²` (blueprint lines 2324-2325, limiting route). -/
theorem fastPartialSum_tendsto {F : FastCircle → ℂ} (hF : MemLp F 2 fastHaar) :
    Filter.Tendsto (fun N => eLpNorm (fastPartialSum N F - F) 2 fastHaar) Filter.atTop
      (nhds 0) := by
  have h := fast_partial_sums_tendsto (hF.toLp F)
  rw [Lp.tendsto_Lp_iff_tendsto_eLpNorm (f_lim_ℒp := hF)] at h
  refine h.congr fun N => eLpNorm_congr_ae ?_
  have hc : fourierCoeff (⇑(hF.toLp F)) = fourierCoeff F :=
    funext fun m => fourierCoeff_congr_fast (MemLp.coeFn_toLp hF) m
  filter_upwards [coeFn_fast_partial_sum (hF.toLp F) (Finset.Icc (-(N : ℤ)) N)] with t ht
  simp only [Pi.sub_apply, fastPartialSum]
  rw [ht, hc]

/-- Bessel's inequality for the Fourier coefficients of a function. -/
theorem fast_bessel_fn {F : FastCircle → ℂ} (hF : MemLp F 2 fastHaar) (s : Finset ℤ) :
    ENNReal.ofReal (∑ m ∈ s, ‖fourierCoeff F m‖ ^ 2) ≤ ∫⁻ t, ‖F t‖ₑ ^ (2 : ℝ) ∂fastHaar := by
  have hc : fourierCoeff (⇑(hF.toLp F)) = fourierCoeff F :=
    funext fun m => fourierCoeff_congr_fast (MemLp.coeFn_toLp hF) m
  have hb := fast_bessel (hF.toLp F) s
  rw [hc] at hb
  have hi : ∫ t, ‖(hF.toLp F) t‖ ^ 2 ∂fastHaar = ∫ t, ‖F t‖ ^ 2 ∂fastHaar :=
    integral_congr_ae ((MemLp.coeFn_toLp hF).mono fun t ht => by simp only [ht])
  rw [hi] at hb
  refine (ENNReal.ofReal_le_ofReal hb).trans ?_
  rw [ofReal_integral_eq_lintegral_ofReal]
  · refine le_of_eq (lintegral_congr fun t => ?_)
    rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num),
      Real.rpow_two]
  · exact hF.integrable_norm_pow (by norm_num)
  · exact Filter.Eventually.of_forall fun t => by positivity

theorem memLp_of_continuous_fast {g : FastCircle → ℂ} (hg : Continuous g) (p : ℝ≥0∞) :
    MemLp g p fastHaar := by
  let g' : C(FastCircle, ℂ) := ⟨g, hg⟩
  exact MemLp.of_bound hg.aestronglyMeasurable ‖g'‖
    (Filter.Eventually.of_forall fun t => g'.norm_coe_le_norm t)

theorem memLp_fastPartialSum (N : ℕ) (F : FastCircle → ℂ) :
    MemLp (fastPartialSum N F) 2 fastHaar :=
  memLp_of_continuous_fast (continuous_fastPartialSum N F) 2

/-! ### Measurability of the uncentered maximal function in all variables -/

/-- The uncentered maximal function is a supremum over intervals with rational endpoints containing
the point in their interior. -/
theorem uncenteredRealMaximal_eq_rat {E : Type*} [NormedAddCommGroup E] (g : ℝ → E) (x : ℝ) :
    uncenteredRealMaximal g x = ⨆ p : ℚ × ℚ,
      if (p.1 : ℝ) < p.2 ∧ x ∈ Set.Ioo (p.1 : ℝ) p.2 then
        (ENNReal.ofReal ((p.2 : ℝ) - p.1))⁻¹ * ∫⁻ y in Set.Icc (p.1 : ℝ) p.2, ‖g y‖ₑ
      else 0 := by
  classical
  apply le_antisymm
  · unfold uncenteredRealMaximal
    refine iSup₂_le fun a b => iSup₂_le fun hab hx => ?_
    refine ENNReal.le_of_forall_lt_one_mul_le fun c hc => ?_
    rcases eq_or_ne c 0 with rfl | hc0
    · simp
    have hct : c ≠ ⊤ := ne_top_of_lt hc
    set c' := c.toReal
    have hc'0 : 0 < c' := ENNReal.toReal_pos hc0 hct
    have hc'1 : c' < 1 := by
      have := (ENNReal.toReal_lt_toReal hct ENNReal.one_ne_top).mpr hc
      simpa using this
    have hba : 0 < b - a := sub_pos.mpr hab
    set η := (b - a) * (1 / c' - 1) / 2
    have hη : 0 < η := by
      have : 1 < 1 / c' := by rw [lt_div_iff₀ hc'0]; linarith
      have : 0 < 1 / c' - 1 := by linarith
      positivity
    obtain ⟨a', ha1, ha2⟩ := exists_rat_btwn (show a - η < a by linarith)
    obtain ⟨b', hb1, hb2⟩ := exists_rat_btwn (show b < b + η by linarith)
    have hab' : (a' : ℝ) < b' := by linarith
    have hxin : x ∈ Set.Ioo (a' : ℝ) b' := ⟨by linarith [hx.1], by linarith [hx.2]⟩
    refine le_trans ?_ (le_iSup _ (a', b'))
    simp only [hab', hxin, and_self, ↓reduceIte]
    have hlen : (b' : ℝ) - a' ≤ (b - a) / c' := by
      have : (b - a) / c' = b - a + 2 * η := by
        simp only [η]; field_simp; ring
      rw [this]; linarith
    have hint : ∫⁻ y in Set.Icc a b, ‖g y‖ₑ ≤ ∫⁻ y in Set.Icc (a' : ℝ) b', ‖g y‖ₑ :=
      lintegral_mono_set (Set.Icc_subset_Icc (by linarith) (by linarith))
    calc c * ((ENNReal.ofReal (b - a))⁻¹ * ∫⁻ y in Set.Icc a b, ‖g y‖ₑ)
        = (ENNReal.ofReal ((b - a) / c'))⁻¹ * ∫⁻ y in Set.Icc a b, ‖g y‖ₑ := by
          rw [← mul_assoc]
          congr 1
          rw [ENNReal.ofReal_div_of_pos hc'0, ENNReal.div_eq_inv_mul, ENNReal.mul_inv
            (Or.inr ENNReal.ofReal_ne_top) (Or.inl (by simp [hc'0])), inv_inv,
            ENNReal.ofReal_toReal hct]
      _ ≤ (ENNReal.ofReal ((b' : ℝ) - a'))⁻¹ * ∫⁻ y in Set.Icc (a' : ℝ) b', ‖g y‖ₑ := by
          gcongr
  · refine iSup_le fun p => ?_
    split_ifs with h
    · unfold uncenteredRealMaximal
      exact le_iSup₂_of_le (p.1 : ℝ) (p.2 : ℝ) (le_iSup₂_of_le h.1
        (Set.Ioo_subset_Icc_self h.2) le_rfl)
    · exact zero_le

/-- The source's maximal function `M_q f(y, ω)` of a jointly measurable family is jointly
measurable. -/
theorem measurable_maximalQ {Ω : Type*} [MeasurableSpace Ω] (q : ℝ) {f : ℝ × Ω → ℂ}
    (hf : Measurable f) : Measurable (maximalQ q f) := by
  classical
  unfold maximalQ
  refine Measurable.pow_const ?_ _
  simp_rw [uncenteredRealMaximal_eq_rat]
  refine Measurable.iSup fun p => ?_
  have hI : Measurable fun ω : Ω => ∫⁻ y in Set.Icc (p.1 : ℝ) p.2, ‖‖f (y, ω)‖ ^ q‖ₑ :=
    Measurable.lintegral_prod_left' (((hf.norm.pow_const q)).enorm)
  refine Measurable.ite ?_ (measurable_const.mul (hI.comp measurable_snd)) measurable_const
  by_cases h : (p.1 : ℝ) < p.2
  · simp only [h, true_and]
    exact measurableSet_Ioo.preimage measurable_fst
  · simp only [h, false_and, Set.ofPred_false, MeasurableSet.empty]

/-- Window masses inside an interval: if the windows of all `m ∈ S` lie in `J`, then
`Σ_{m ∈ S} ∫_{window m} g ≤ L_j ∫_J g`. -/
theorem window_sum_le_of_subset {δ : ℝ} (hδ : 0 < δ) (j : Fin 4) (g : ℝ → ℝ≥0∞)
    (S : Finset ℤ) (J : Set ℝ) (hJ : MeasurableSet J)
    (hS : ∀ m ∈ S, Set.Ico (δ * (m + fastLiftLeft j)) (δ * (m + fastLiftLeft j + fastLiftLen j))
      ⊆ J) :
    ∑ m ∈ S, ∫⁻ y in Set.Ico (δ * (m + fastLiftLeft j)) (δ * (m + fastLiftLeft j +
      fastLiftLen j)), g y ≤ (fastLiftLenNat j : ℝ≥0∞) * ∫⁻ y in J, g y := by
  have hsum := lintegral_window_sum (fastLiftLenNat j) hδ (fastLiftLeft j) (J.indicator g)
  rw [lintegral_indicator hJ] at hsum
  rw [← hsum, fastLiftLenNat_cast] at *
  calc ∑ m ∈ S, ∫⁻ y in Set.Ico (δ * (m + fastLiftLeft j)) (δ * (m + fastLiftLeft j +
        fastLiftLen j)), g y
      = ∑ m ∈ S, ∫⁻ y in Set.Ico (δ * (m + fastLiftLeft j)) (δ * (m + fastLiftLeft j +
          fastLiftLen j)), J.indicator g y := by
        refine Finset.sum_congr rfl fun m hm => setLIntegral_congr_fun measurableSet_Ico
          fun y hy => (Set.indicator_of_mem (hS m hm hy) g).symm
    _ ≤ ∑' m : ℤ, ∫⁻ y in Set.Ico (δ * (m + fastLiftLeft j)) (δ * (m + fastLiftLeft j +
          fastLiftLen j)), J.indicator g y := ENNReal.sum_le_tsum S
    _ = _ := rfl

theorem volume_offsetPolygon_pos {c : ℝ} (hc : 0 < c) : 0 < volume (offsetPolygon c) := by
  have hsub : Set.Ioo (-(c / 4)) (c / 4) ×ˢ Set.Ioo (-(c / 4)) (c / 4) ⊆ offsetPolygon c := by
    rintro ⟨a, b⟩ ⟨⟨ha1, ha2⟩, ⟨hb1, hb2⟩⟩ j
    have hj0 : (0 : ℝ) ≤ (j : ℕ) := Nat.cast_nonneg _
    have hj3 : ((j : ℕ) : ℝ) ≤ 3 := by exact_mod_cast Nat.le_of_lt_succ j.isLt
    rw [abs_lt]
    constructor <;> nlinarith
  refine lt_of_lt_of_le ?_ (measure_mono hsub)
  rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Ioo]
  have : 0 < c / 4 - -(c / 4) := by linarith
  positivity

/-- The fourth random moment of a local `L²` norm (blueprint line 2330, "Minkowski and the sign
moments"): `(E ‖z^σ‖_{L²(ν)}⁴)^{1/4} ≤ C₄ ‖Z‖_{L²(ν)}`. -/
theorem random_local_L2 {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [SigmaFinite P]
    (ν : Measure ℝ) [SFinite ν] (z : Ω → ℝ → ℂ) (hz : Measurable (Function.uncurry z))
    (Z : ℝ → ℝ) (hZ : Measurable Z) {C4 : ℝ}
    (hmom : ∀ y, (∫⁻ σ, ‖z σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ENNReal.ofReal (Z y)) :
    (∫⁻ σ, eLpNorm (z σ) 2 ν ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * (∫⁻ y, ENNReal.ofReal (Z y) ^ (2 : ℝ) ∂ν) ^ (1 / 2 : ℝ) := by
  have h := random_L2_moment P ν z hz (a := 4) (by norm_num) (Z := fun y => ENNReal.ofReal (Z y))
    hZ.ennreal_ofReal (Ca := ENNReal.ofReal C4) hmom
  refine le_trans (le_of_eq ?_) h
  congr 1
  refine lintegral_congr fun σ => ?_
  have hm : Measurable (z σ) := hz.comp measurable_prodMk_left
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num) hm.aestronglyMeasurable,
    ← ENNReal.rpow_mul]
  norm_num

namespace BlockData
variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

/-- Distinct cells at one depth are disjoint: their masses add up to at most the total mass. -/
theorem sum_depth_le (s : ℤ) (g : ℝ → ℝ≥0∞) :
    ∑ I ∈ D.cells with I.1 = s, ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I), g y ≤
      ∫⁻ y, g y := by
  have hc : ∀ I : ℤ × ℤ, ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I), g y =
      ∫⁻ y in dyadicGridCell D.grid I.1 I.2, g y := fun I =>
    setLIntegral_congr Ico_ae_eq_Icc.symm
  simp_rw [hc]
  have hdis : Set.PairwiseDisjoint (↑(D.cells.filter fun I => I.1 = s))
      fun I : ℤ × ℤ => dyadicGridCell D.grid I.1 I.2 := by
    intro I hI J hJ hIJ
    have hI' := (Finset.mem_filter.mp hI).2
    have hJ' := (Finset.mem_filter.mp hJ).2
    have hne : I.2 ≠ J.2 := fun e => hIJ (Prod.ext (hI'.trans hJ'.symm) e)
    have := dyadicGridCell_pairwiseDisjoint D.grid s hne
    simp only [Function.onFun]
    rw [hI', hJ']
    exact this
  rw [← lintegral_biUnion_finset hdis (fun I _ => dyadicGridCell_measurable _ _ _)]
  exact setLIntegral_le_lintegral _ _

/-- Blueprint lines 2307-2312 (summed first sampling error): with the local bounds
`∫_I Z_j² ≤ |I|`, the masses `∫ Z_j² ≤ m_j` and `Σ_{s} δ/r_s ≤ 1` over the occurring depths,
`E Σ_I |I| |H_I^{err}(z^σ)| ≤ 4 C_κ C₄⁴ m_a^{1/2} m_b^{1/2}` for any two distinct slots. -/
theorem err1_bound (P : Measure Ω) [IsProbabilityMeasure P] {C4 : ℝ} (hC4 : 0 ≤ C4)
    (hmom : ∀ j y, (∫⁻ σ, ‖D.z j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ENNReal.ofReal (D.Z j y))
    {a b : Fin 4} (hab : a ≠ b) (m : Fin 4 → ℝ)
    (hm : ∀ j, ∫⁻ y, ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) ≤ ENNReal.ofReal (m j))
    (hloc : ∀ I ∈ D.cells, ∀ j, ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
      ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) ≤ ENNReal.ofReal (D.len I))
    (hw : ∑ s ∈ D.cells.image Prod.fst, D.δ / dyadicGridLength D.grid s ≤ 1) :
    ∫⁻ σ, ∑ I ∈ D.cells, ENNReal.ofReal (D.len I) * ‖D.err1 I σ‖ₑ ∂P ≤
      ENNReal.ofReal (4 * admissibleLipConst κ * C4 ^ 4) * ENNReal.ofReal (m a) ^ (1 / 2 : ℝ) *
        ENNReal.ofReal (m b) ^ (1 / 2 : ℝ) := by
  classical
  set ν : ℤ × ℤ → Measure ℝ := fun I => normalizedIntervalMeasure (D.left I) (D.len I)
  set Cκ := admissibleLipConst κ
  have hCκ : 0 ≤ Cκ := admissibleLipConst_nonneg κ
  have : ∀ I, SFinite (ν I) := fun I => by
    simp only [ν, normalizedIntervalMeasure]; infer_instance
  -- the deterministic local masses
  set Y : Fin 4 → ℤ × ℤ → ℝ≥0∞ := fun j I => ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
    ENNReal.ofReal (D.Z j y) ^ (2 : ℝ)
  have hZm : ∀ j, Measurable fun y => ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) := fun j =>
    (D.Z_meas j).ennreal_ofReal.pow_const _
  have hnorm : ∀ j σ, Measurable (D.inp σ j) := fun j σ => D.measurable_inp σ j
  -- measurability of the local norms in `σ`
  have hEm : ∀ I j, Measurable fun σ => eLpNorm (D.inp σ j) 2 (ν I) := by
    intro I j
    have : (fun σ => eLpNorm (D.inp σ j) 2 (ν I)) = fun σ =>
        (∫⁻ y, ‖D.z j σ y‖ₑ ^ (2 : ℝ) ∂(ν I)) ^ (1 / 2 : ℝ) := by
      funext σ
      rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)
        (hnorm j σ).aestronglyMeasurable]
      norm_num; rfl
    rw [this]
    exact (((D.z_meas j).enorm.pow_const _).lintegral_prod_right').pow_const _
  -- pointwise bound by the error estimate
  have hpt : ∀ σ, ∑ I ∈ D.cells, ENNReal.ofReal (D.len I) * ‖D.err1 I σ‖ₑ ≤
      ∑ I ∈ D.cells, ENNReal.ofReal (D.len I) *
        (ENNReal.ofReal (4 * Cκ * (D.δ / D.len I)) * ∏ j, eLpNorm (D.inp σ j) 2 (ν I)) := by
    intro σ
    refine Finset.sum_le_sum fun I hI => ?_
    gcongr
    have hδr : 5 * D.δ ≤ κ.margin * D.len I := by
      have := D.δ_small I hI; have := D.δ_pos; unfold len; linarith
    exact latticeSampled_form_error (D.len_pos I) (D.admissible I hI) D.δ_pos hδr (D.inp σ)
      (hnorm · σ) (fun _ => 2) (fun _ => by norm_num) (by norm_num)
  refine (lintegral_mono hpt).trans ?_
  have hmeas : ∀ I ∈ D.cells, Measurable fun σ => ENNReal.ofReal (D.len I) *
      (ENNReal.ofReal (4 * Cκ * (D.δ / D.len I)) * ∏ j, eLpNorm (D.inp σ j) 2 (ν I)) :=
    fun I _ => measurable_const.mul (measurable_const.mul
      (Finset.measurable_prod _ fun j _ => hEm I j))
  rw [lintegral_finsetSum _ hmeas]
  -- per cell: Hölder in `σ` and the random local `L²` moments
  have hcell : ∀ I ∈ D.cells, ∫⁻ σ, ENNReal.ofReal (D.len I) *
      (ENNReal.ofReal (4 * Cκ * (D.δ / D.len I)) * ∏ j, eLpNorm (D.inp σ j) 2 (ν I)) ∂P ≤
      ENNReal.ofReal (4 * Cκ * C4 ^ 4) * (ENNReal.ofReal (D.δ / D.len I) *
        (Y a I ^ (1 / 2 : ℝ) * Y b I ^ (1 / 2 : ℝ))) := by
    intro I hI
    have hr := D.len_pos I
    rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
      lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    have hH := lintegral_prod_four_le P (fun j σ => eLpNorm (D.inp σ j) 2 (ν I))
      fun j => (hEm I j).aemeasurable
    have hmomI : ∀ j, (∫⁻ σ, eLpNorm (D.inp σ j) 2 (ν I) ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
        ENNReal.ofReal C4 * (ENNReal.ofReal (D.len I)⁻¹ * Y j I) ^ (1 / 2 : ℝ) := by
      intro j
      have := random_local_L2 P (ν I) (D.z j) (D.z_meas j) (D.Z j) (D.Z_meas j) (hmom j)
      simp only [ν, normalizedIntervalMeasure, lintegral_smul_measure, smul_eq_mul] at this
      exact this
    -- the factors outside `a, b` are at most `C₄`
    have hX1 : ∀ j, (ENNReal.ofReal (D.len I)⁻¹ * Y j I) ^ (1 / 2 : ℝ) ≤ 1 := by
      intro j
      refine ENNReal.rpow_le_one ?_ (by norm_num)
      calc ENNReal.ofReal (D.len I)⁻¹ * Y j I ≤ ENNReal.ofReal (D.len I)⁻¹ *
            ENNReal.ofReal (D.len I) := by gcongr; exact hloc I hI j
        _ = 1 := by
          rw [← ENNReal.ofReal_mul (inv_nonneg.mpr hr.le), inv_mul_cancel₀ hr.ne',
            ENNReal.ofReal_one]
    have hprod : ∏ j, (∫⁻ σ, eLpNorm (D.inp σ j) 2 (ν I) ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
        ENNReal.ofReal C4 ^ 4 * ((ENNReal.ofReal (D.len I)⁻¹ * Y a I) ^ (1 / 2 : ℝ) *
          (ENNReal.ofReal (D.len I)⁻¹ * Y b I) ^ (1 / 2 : ℝ)) := by
      calc ∏ j, (∫⁻ σ, eLpNorm (D.inp σ j) 2 (ν I) ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ)
          ≤ ∏ j, (ENNReal.ofReal C4 * (ENNReal.ofReal (D.len I)⁻¹ * Y j I) ^ (1 / 2 : ℝ)) :=
            Finset.prod_le_prod fun j _ => hmomI j
        _ = ENNReal.ofReal C4 ^ 4 * ∏ j, (ENNReal.ofReal (D.len I)⁻¹ * Y j I) ^ (1 / 2 : ℝ) := by
            rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
        _ ≤ ENNReal.ofReal C4 ^ 4 * ∏ j ∈ {a, b},
              (ENNReal.ofReal (D.len I)⁻¹ * Y j I) ^ (1 / 2 : ℝ) := by
            exact mul_le_mul' le_rfl (Finset.prod_le_prod_of_subset_of_le_one
              (Finset.subset_univ _) fun j _ _ => hX1 j)
        _ = _ := by rw [Finset.prod_pair hab]
    calc ENNReal.ofReal (D.len I) * (ENNReal.ofReal (4 * Cκ * (D.δ / D.len I)) *
          ∫⁻ σ, ∏ j, eLpNorm (D.inp σ j) 2 (ν I) ∂P)
        ≤ ENNReal.ofReal (D.len I) * (ENNReal.ofReal (4 * Cκ * (D.δ / D.len I)) *
          (ENNReal.ofReal C4 ^ 4 * ((ENNReal.ofReal (D.len I)⁻¹ * Y a I) ^ (1 / 2 : ℝ) *
            (ENNReal.ofReal (D.len I)⁻¹ * Y b I) ^ (1 / 2 : ℝ)))) := by
          gcongr; exact hH.trans hprod
      _ = ENNReal.ofReal (4 * Cκ * C4 ^ 4) * (ENNReal.ofReal (D.δ / D.len I) *
          (Y a I ^ (1 / 2 : ℝ) * Y b I ^ (1 / 2 : ℝ))) := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num),
            ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
          have e1 : ENNReal.ofReal (D.len I)⁻¹ ^ (1 / 2 : ℝ) *
              ENNReal.ofReal (D.len I)⁻¹ ^ (1 / 2 : ℝ) = ENNReal.ofReal (D.len I)⁻¹ := by
            rw [← ENNReal.rpow_add _ _ (by simp [hr]) ENNReal.ofReal_ne_top]; norm_num
          have e2 : ENNReal.ofReal (D.len I) * ENNReal.ofReal (4 * Cκ * (D.δ / D.len I)) *
              ENNReal.ofReal (D.len I)⁻¹ = ENNReal.ofReal (4 * Cκ * (D.δ / D.len I)) := by
            rw [mul_comm (ENNReal.ofReal (D.len I)), mul_assoc,
              ← ENNReal.ofReal_mul hr.le, mul_inv_cancel₀ hr.ne', ENNReal.ofReal_one, mul_one]
          have e3 : ENNReal.ofReal (4 * Cκ * (D.δ / D.len I)) * ENNReal.ofReal C4 ^ 4 =
              ENNReal.ofReal (4 * Cκ * C4 ^ 4) * ENNReal.ofReal (D.δ / D.len I) := by
            rw [← ENNReal.ofReal_pow hC4, ← ENNReal.ofReal_mul (by
              have := D.δ_pos; positivity), ← ENNReal.ofReal_mul (by positivity)]
            congr 1; ring
          calc _ = (ENNReal.ofReal (D.len I) * ENNReal.ofReal (4 * Cκ * (D.δ / D.len I)) *
                (ENNReal.ofReal (D.len I)⁻¹ ^ (1 / 2 : ℝ) *
                  ENNReal.ofReal (D.len I)⁻¹ ^ (1 / 2 : ℝ))) * ENNReal.ofReal C4 ^ 4 *
                (Y a I ^ (1 / 2 : ℝ) * Y b I ^ (1 / 2 : ℝ)) := by ring
            _ = _ := by rw [e1, ← mul_assoc, e2, e3]; ring
  refine (Finset.sum_le_sum hcell).trans ?_
  rw [← Finset.mul_sum, mul_assoc (ENNReal.ofReal (4 * Cκ * C4 ^ 4))]
  gcongr
  -- group the cells by depth
  rw [← Finset.sum_fiberwise_of_maps_to (g := Prod.fst) (t := D.cells.image Prod.fst)
    (fun I hI => Finset.mem_image_of_mem _ hI)]
  have hdepth : ∀ s ∈ D.cells.image Prod.fst, ∑ I ∈ D.cells with I.1 = s,
      ENNReal.ofReal (D.δ / D.len I) * (Y a I ^ (1 / 2 : ℝ) * Y b I ^ (1 / 2 : ℝ)) ≤
      ENNReal.ofReal (D.δ / dyadicGridLength D.grid s) * (ENNReal.ofReal (m a) ^ (1 / 2 : ℝ) *
        ENNReal.ofReal (m b) ^ (1 / 2 : ℝ)) := by
    intro s _
    have hl : ∀ I ∈ D.cells.filter (fun I => I.1 = s),
        ENNReal.ofReal (D.δ / D.len I) = ENNReal.ofReal (D.δ / dyadicGridLength D.grid s) :=
      fun I hI => by rw [show D.len I = dyadicGridLength D.grid s by
        unfold len; rw [(Finset.mem_filter.mp hI).2]]
    rw [Finset.sum_congr rfl fun I hI => by rw [hl I hI], ← Finset.mul_sum]
    gcongr
    have hCS := ENNReal.inner_le_Lp_mul_Lq (D.cells.filter fun I => I.1 = s)
      (fun I => Y a I ^ (1 / 2 : ℝ)) (fun I => Y b I ^ (1 / 2 : ℝ)) Real.HolderConjugate.two_two
    refine hCS.trans ?_
    have hsq : ∀ j, ∑ I ∈ D.cells with I.1 = s, (Y j I ^ (1 / 2 : ℝ)) ^ (2 : ℝ) ≤
        ENNReal.ofReal (m j) := by
      intro j
      simp_rw [← ENNReal.rpow_mul]
      norm_num
      exact (D.sum_depth_le s _).trans (hm j)
    gcongr
    · exact hsq a
    · exact hsq b
  refine (Finset.sum_le_sum hdepth).trans ?_
  rw [← Finset.sum_mul]
  calc (∑ s ∈ D.cells.image Prod.fst, ENNReal.ofReal (D.δ / dyadicGridLength D.grid s)) *
        (ENNReal.ofReal (m a) ^ (1 / 2 : ℝ) * ENNReal.ofReal (m b) ^ (1 / 2 : ℝ))
      ≤ 1 * (ENNReal.ofReal (m a) ^ (1 / 2 : ℝ) * ENNReal.ofReal (m b) ^ (1 / 2 : ℝ)) := by
        gcongr
        rw [← ENNReal.ofReal_sum_of_nonneg fun s _ => by
          have := D.δ_pos; have := dyadicGridLength_pos D.grid s; positivity]
        exact ENNReal.ofReal_le_one.mpr hw
    _ = _ := one_mul _

end BlockData

/-- Joint measurability of the multiplied partial sums of the lifted random slots. -/
theorem measurable_multiplied_slotLift {Ω : Type*} [MeasurableSpace Ω] {δ : ℝ}
    {z : Fin 4 → Ω → ℝ → ℂ} (hz : ∀ j, Measurable (Function.uncurry (z j))) (j : Fin 4) (m : ℤ)
    (s : Finset ℤ) (c : ℤ) (g : Ω → ℤ → ℂ) (hg : Measurable fun p : Ω × ℤ => g p.1 p.2) :
    Measurable fun p : (Ω × ℝ) × FastCircle =>
      fastCircleMultiplied s (fun k => g p.1.1 m * fourierCoeff
        (slotLift δ (fun i => z i p.1.1) j m) k) c p.1.2 p.2 := by
  unfold fastCircleMultiplied
  refine Finset.measurable_sum _ fun k _ => ?_
  have h1 : Measurable fun p : (Ω × ℝ) × FastCircle => g p.1.1 m :=
    hg.comp ((measurable_fst.comp measurable_fst).prodMk measurable_const)
  have h2 := (measurable_fourierCoeff_slotLift (δ := δ) hz j m k).comp
    (measurable_fst.comp measurable_fst : Measurable fun p : (Ω × ℝ) × FastCircle => p.1.1)
  have h3 : Measurable fun p : (Ω × ℝ) × FastCircle => ePhase (p.1.2 * (k : ℝ) ^ 2 / c) :=
    continuous_ePhase.measurable.comp (by fun_prop)
  have h4 : Measurable fun p : (Ω × ℝ) × FastCircle => fourier k p.2 :=
    (fourier k).continuous.measurable.comp measurable_snd
  exact ((h1.mul h2).mul h3).mul h4

namespace BlockData
variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

/-- Almost every random parameter gives `L²` inputs (fourth moments and finite masses). -/
theorem ae_memLp (P : Measure Ω) [IsProbabilityMeasure P] {C4 : ℝ}
    (hmom : ∀ j y, (∫⁻ σ, ‖D.z j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ENNReal.ofReal (D.Z j y))
    (hfin : ∀ j, ∫⁻ y, ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) < ⊤) :
    ∀ᵐ σ ∂P, ∀ j, MemLp (D.inp σ j) 2 volume := by
  rw [ae_all_iff]
  intro j
  have h := random_local_L2 P volume (D.z j) (D.z_meas j) (D.Z j) (D.Z_meas j) (hmom j)
  have hlt : (∫⁻ σ, eLpNorm (D.z j σ) 2 volume ^ (4 : ℝ) ∂P) < ⊤ := by
    have h2 : (∫⁻ σ, eLpNorm (D.z j σ) 2 volume ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) < ⊤ :=
      h.trans_lt (ENNReal.mul_lt_top ENNReal.ofReal_lt_top
        (ENNReal.rpow_lt_top_of_nonneg (by norm_num) (hfin j).ne))
    by_contra hc
    rw [not_lt, top_le_iff] at hc
    rw [hc, ENNReal.top_rpow_of_pos (by norm_num)] at h2
    exact lt_irrefl _ h2
  have hm0 : Measurable fun σ => eLpNorm (D.z j σ) 2 volume := by
    have : (fun σ => eLpNorm (D.z j σ) 2 volume) = fun σ =>
        (∫⁻ y, ‖D.z j σ y‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ) := by
      funext σ
      have hm' : Measurable (D.z j σ) := D.measurable_inp σ j
      rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)
        hm'.aestronglyMeasurable]
      norm_num
    rw [this]
    exact (((D.z_meas j).enorm.pow_const _).lintegral_prod_right').pow_const _
  have hm := hm0.pow_const (4 : ℝ)
  filter_upwards [ae_lt_top hm hlt.ne] with σ hσ
  rw [memLp_iff]
  change eLpNorm (D.z j σ) 2 volume < ⊤
  by_contra hc
  rw [not_lt, top_le_iff] at hc
  rw [hc, ENNReal.top_rpow_of_pos (by norm_num)] at hσ
  exact lt_irrefl _ hσ

/-- The fast data of the partial sums `S_N F^σ`. -/
noncomputable def partialData (N : ℕ) (σ : Ω) : Fin 4 → ℤ → FastCircle → ℂ :=
  fun j m => fastPartialSum N (slotLift D.δ (D.inp σ) j m)

/-- For `L²` inputs the lattice sums of `S_N F^σ` converge to that of `F^σ` (blueprint
lines 2324-2325). -/
theorem latticeSum_tendsto (ε : ℤ × ℤ → Ω → ℂ) (σ : Ω) (hL : ∀ j, MemLp (D.inp σ j) 2 volume) :
    Filter.Tendsto (fun N => D.latticeSum ε σ (D.partialData N σ)) Filter.atTop
      (nhds (D.latticeSum ε σ (slotLift D.δ (D.inp σ)))) := by
  unfold latticeSum
  refine tendsto_finsetSum _ fun I _ => (tendsto_const_nhds.mul (tendsto_const_nhds.mul
    (tendsto_finsetSum _ fun n _ => tendsto_const_nhds.mul ?_)))
  have hf := D.measurable_inp σ
  exact fast_form_tendsto _ _ (fun j => measurable_slotLift hf j _)
    (fun N j => (continuous_fastPartialSum N _).measurable)
    (fun j => memLp_slotLift D.δ_pos hf hL j _) (fun N j => memLp_fastPartialSum N _)
    (fun j => fastPartialSum_tendsto (memLp_slotLift D.δ_pos hf hL j _))

theorem measurable_fastFormAt_partial (N : ℕ) (n : ℤ × ℤ) :
    Measurable fun σ => fastFormAt (D.partialData N σ) n := by
  unfold fastFormAt partialData
  have hj : ∀ j : Fin 4, Measurable fun p : Ω × (FastCircle × FastCircle) =>
      fastPartialSum N (slotLift D.δ (D.inp p.1) j (latticeCoord j n)) (fastCoord j p.2) :=
    fun j => by
      unfold fastPartialSum fastCircleMultiplied
      refine Finset.measurable_sum _ fun k _ => ?_
      exact (((measurable_fourierCoeff_slotLift (δ := D.δ) D.z_meas j _ k).comp
        measurable_fst).mul measurable_const).mul ((fourier k).continuous.measurable.comp
          ((continuous_fastCoord _).measurable.comp measurable_snd))
  exact ((Finset.measurable_prod _ fun j _ => hj j).stronglyMeasurable.integral_prod_right'
    (ν := fastHaar.prod fastHaar)).measurable

theorem measurable_latticeSum_partial (ε : ℤ × ℤ → Ω → ℂ) (hε : ∀ I, Measurable (ε I)) (N : ℕ) :
    Measurable fun σ => D.latticeSum ε σ (D.partialData N σ) := by
  unfold latticeSum
  exact Finset.measurable_sum _ fun I _ => (measurable_const.mul (hε I)).mul
    (measurable_const.mul (Finset.measurable_sum _ fun n _ =>
      measurable_const.mul (D.measurable_fastFormAt_partial N n)))

/-- Blueprint lines 2324-2325 ("pass to limits"): by Fatou, the expected lattice sum of the lifted
inputs is at most the limit inferior of those of the partial sums. -/
theorem lintegral_latticeSum_le_liminf (P : Measure Ω) [IsProbabilityMeasure P] {C4 : ℝ}
    (hmom : ∀ j y, (∫⁻ σ, ‖D.z j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ENNReal.ofReal (D.Z j y))
    (hfin : ∀ j, ∫⁻ y, ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) < ⊤)
    (ε : ℤ × ℤ → Ω → ℂ) (hε : ∀ I, Measurable (ε I)) :
    ∫⁻ σ, ‖D.latticeSum ε σ (slotLift D.δ (D.inp σ))‖ₑ ∂P ≤
      Filter.liminf (fun N => ∫⁻ σ, ‖D.latticeSum ε σ (D.partialData N σ)‖ₑ ∂P)
        Filter.atTop := by
  have hlim : ∀ᵐ σ ∂P, ‖D.latticeSum ε σ (slotLift D.δ (D.inp σ))‖ₑ =
      Filter.liminf (fun N => ‖D.latticeSum ε σ (D.partialData N σ)‖ₑ) Filter.atTop := by
    filter_upwards [D.ae_memLp P hmom hfin] with σ hσ
    exact ((continuous_enorm.tendsto _).comp (D.latticeSum_tendsto ε σ hσ)).liminf_eq.symm
  rw [lintegral_congr_ae hlim]
  exact lintegral_liminf_le fun N => (D.measurable_latticeSum_partial ε hε N).enorm

end BlockData

theorem continuous_fastMultiplied (s : Finset ℤ) (a : ℤ → ℂ) (c : ℤ) (γ : ℝ) :
    Continuous (fastMultiplied s a c γ) := by
  unfold fastMultiplied
  exact continuous_finsetSum _ fun m _ => continuous_const.mul (continuous_ePhase.comp
    (by fun_prop))

/-- The multiplied fast form on `T₀²` as an iterated integral over `[0, 16]²`. -/
theorem fastForm_multiplied_eq_iter (s : Finset ℤ) (a : Fin 4 → ℤ → ℂ) (γ : ℝ) :
    ∫ x, ∏ j : Fin 4, fastCircleMultiplied s (a j) (fastSlotC j) γ (fastCoord j x)
        ∂(fastHaar.prod fastHaar) =
      (1 / 256 : ℝ) • ∫ u in (0 : ℝ)..16, ∫ v in (0 : ℝ)..16,
        ∏ j : Fin 4, fastMultiplied s (a j) (fastSlotC j) γ ((1 - (j : ℝ)) * u + j * v) := by
  have hc : Continuous fun x : FastCircle × FastCircle =>
      ∏ j : Fin 4, fastCircleMultiplied s (a j) (fastSlotC j) γ (fastCoord j x) :=
    continuous_finsetProd _ fun j _ =>
      (continuous_fastCircleMultiplied s (a j) _ γ).comp (continuous_fastCoord _)
  rw [integral_fastHaar_prod _ hc.aestronglyMeasurable]
  congr 1
  set h : ℝ × ℝ → ℂ := fun u =>
    ∏ j : Fin 4, fastMultiplied s (a j) (fastSlotC j) γ ((1 - (j : ℝ)) * u.1 + j * u.2)
  have hh : Continuous h := continuous_finsetProd _ fun j _ =>
    (continuous_fastMultiplied s (a j) _ γ).comp (by fun_prop)
  have hpt : ∀ u : ℝ × ℝ, ∏ j : Fin 4, fastCircleMultiplied s (a j) (fastSlotC j) γ
      (fastCoord j ((u.1 : FastCircle), (u.2 : FastCircle))) = h u := by
    intro u
    refine Finset.prod_congr rfl fun j _ => ?_
    rw [fastCoord_coe, fastCircleMultiplied_coe]
    push_cast; rfl
  simp_rw [hpt]
  have hint : IntegrableOn h (Set.Ioc (0 : ℝ) 16 ×ˢ Set.Ioc (0 : ℝ) 16) :=
    (hh.continuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)).mono_set
      (Set.prod_mono Set.Ioc_subset_Icc_self Set.Ioc_subset_Icc_self)
  have hrest : ((volume : Measure ℝ).prod volume).restrict
      (Set.Ico (0 : ℝ) 16 ×ˢ Set.Ico (0 : ℝ) 16) =
      ((volume : Measure ℝ).prod volume).restrict
        (Set.Ioc (0 : ℝ) 16 ×ˢ Set.Ioc (0 : ℝ) 16) := by
    rw [← Measure.prod_restrict, ← Measure.prod_restrict,
      Measure.restrict_congr_set (Ico_ae_eq_Icc.trans Ioc_ae_eq_Icc.symm)]
  rw [Measure.volume_eq_prod, hrest, setIntegral_prod _ hint]
  rw [intervalIntegral.integral_of_le (by norm_num)]
  refine setIntegral_congr_fun measurableSet_Ioc fun u _ => ?_
  rw [intervalIntegral.integral_of_le (by norm_num)]

/-- Blueprint lines 2314-2317 on `T₀²`: the multipliers leave the fast form unchanged. -/
theorem fastForm_multiplied_invariant (s : Finset ℤ) (a : Fin 4 → ℤ → ℂ) (γ : ℝ) :
    ∫ x, ∏ j : Fin 4, fastCircleMultiplied s (a j) (fastSlotC j) γ (fastCoord j x)
        ∂(fastHaar.prod fastHaar) =
      ∫ x, ∏ j : Fin 4, fastCircleMultiplied s (a j) (fastSlotC j) 0 (fastCoord j x)
        ∂(fastHaar.prod fastHaar) := by
  rw [fastForm_multiplied_eq_iter, fastForm_multiplied_eq_iter, fast_form_invariance]

namespace BlockData
variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

/-- The multiplied partial sums `U_{j,γ} S_N` of the weighted lifted slots. -/
noncomputable def multWith (N : ℕ) (w : Fin 4 → ℤ → ℂ) (γ : ℝ) (σ : Ω) :
    Fin 4 → ℤ → FastCircle → ℂ :=
  fun j m => fastCircleMultiplied (Finset.Icc (-(N : ℤ)) N)
    (fun k => w j m * fourierCoeff (slotLift D.δ (D.inp σ) j m) k) (fastSlotC j) γ

theorem continuous_multWith (N : ℕ) (w : Fin 4 → ℤ → ℂ) (γ : ℝ) (σ : Ω) (j : Fin 4)
    (m : ℤ) :
    Continuous (D.multWith N w γ σ j m) := continuous_fastCircleMultiplied _ _ _ _

theorem partialData_eq (N : ℕ) (σ : Ω) :
    D.partialData N σ = D.multWith N (fun _ _ => 1) 0 σ := by
  funext j m t
  simp [partialData, multWith, fastPartialSum, fastCircleMultiplied]

theorem fastFormAt_split (N : ℕ) (γ : ℝ) (σ : Ω) (a : Fin 4) (keep : Set ℤ) (n : ℤ × ℤ) :
    fastFormAt (D.multWith N (fun _ _ => 1) γ σ) n =
      fastFormAt (D.multWith N (wRet a keep) γ σ) n +
        fastFormAt (D.multWith N (wDel a keep) γ σ) n := by
  classical
  refine fastFormAt_add_slot _ _ _ a (fun j hj => ?_) (fun j hj => ?_) (fun m t => ?_)
    (D.continuous_multWith N _ γ σ) (D.continuous_multWith N _ γ σ) n
  · funext m; simp [multWith, wRet, hj]
  · funext m; simp [multWith, wDel, hj]
  · simp only [multWith, fastCircleMultiplied, wRet, wDel, true_and]
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun k _ => ?_
    by_cases hm : m ∈ keep <;> simp [hm]

/-- Blueprint lines 2314-2343 (first step of the comparison for fixed `N`): the lattice sum of
`S_N F^σ` equals that of `U_γ S_N F^σ` for every `γ`; splitting the heavy slot into retained
and deleted windows bounds it by the `γ`-average of the two lattice sums. -/
theorem norm_latticeSum_partial_le (ε : ℤ × ℤ → Ω → ℂ) (σ : Ω) (N : ℕ) (a : Fin 4)
    (keep : Set ℤ) :
    ‖D.latticeSum ε σ (D.partialData N σ)‖ₑ ≤ ∫⁻ γ,
      (‖D.latticeSum ε σ (D.multWith N (wRet a keep) γ σ)‖ₑ +
        ‖D.latticeSum ε σ (D.multWith N (wDel a keep) γ σ)‖ₑ) ∂gammaMeasure := by
  have hinv : ∀ γ, D.latticeSum ε σ (D.partialData N σ) =
      D.latticeSum ε σ (D.multWith N (wRet a keep) γ σ) +
        D.latticeSum ε σ (D.multWith N (wDel a keep) γ σ) := by
    intro γ
    rw [← D.latticeSum_add ε σ _ _ _ (D.fastFormAt_split N γ σ a keep), D.partialData_eq]
    unfold latticeSum
    refine Finset.sum_congr rfl fun I _ => ?_
    congr 2
    refine Finset.sum_congr rfl fun n _ => ?_
    congr 1
    exact (fastForm_multiplied_invariant _ _ γ).symm
  calc ‖D.latticeSum ε σ (D.partialData N σ)‖ₑ
      = ∫⁻ _γ, ‖D.latticeSum ε σ (D.partialData N σ)‖ₑ ∂gammaMeasure := by
        rw [lintegral_const, measure_univ, mul_one]
    _ ≤ _ := lintegral_mono fun γ => by rw [hinv γ]; exact enorm_add_le _ _

end BlockData

/-- Bessel's inequality in `ℝ≥0∞` for any measurable function on the fast circle. -/
theorem fast_bessel_enorm {F : FastCircle → ℂ} (hF : Measurable F) (s : Finset ℤ) :
    ENNReal.ofReal (∑ m ∈ s, ‖fourierCoeff F m‖ ^ 2) ≤ ∫⁻ t, ‖F t‖ₑ ^ (2 : ℝ) ∂fastHaar := by
  by_cases hfin : ∫⁻ t, ‖F t‖ₑ ^ (2 : ℝ) ∂fastHaar < ⊤
  · have hL : MemLp F 2 fastHaar := by
      rw [memLp_iff, eLpNorm_two_eq hF.aestronglyMeasurable]
      exact ENNReal.rpow_lt_top_of_nonneg (by norm_num) hfin.ne
    exact fast_bessel_fn hL s
  · rw [not_lt, top_le_iff] at hfin
    rw [hfin]; exact le_top

namespace BlockData
variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

/-- The deterministic fast window size `e_j(m) = ‖Z_j(δ(m + ·))‖_{L²(T₀)}` (blueprint line 2328). -/
noncomputable def ewin (j : Fin 4) (m : ℤ) : ℝ≥0∞ :=
  (∫⁻ t, ‖slotLift D.δ D.Zc j m t‖ₑ ^ (2 : ℝ) ∂fastHaar) ^ (1 / 2 : ℝ)

/-- The window of the slow point `m` in slot `j`. -/
noncomputable def window (j : Fin 4) (m : ℤ) : Set ℝ :=
  Set.Ico (D.δ * (m + fastLiftLeft j)) (D.δ * (m + fastLiftLeft j + fastLiftLen j))

theorem ewin_sq (j : Fin 4) (m : ℤ) :
    D.ewin j m ^ (2 : ℝ) = (ENNReal.ofReal (16 * D.δ))⁻¹ *
      ∫⁻ y in D.window j m, ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) := by
  unfold ewin window
  rw [← ENNReal.rpow_mul, show (1 / 2 : ℝ) * 2 = 1 by norm_num, ENNReal.rpow_one,
    lintegral_slotLift D.δ D.δ_pos D.Zc D.measurable_Zc j m 2 (by norm_num)]
  congr 2
  funext y
  simp only [Zc, enorm_ofReal_of_nonneg (D.Z_nonneg j y)]

/-- Blueprint line 2330 ("Minkowski and the sign moments") at a fast window:
`(E ‖F_j^σ(m, ·)‖₂⁴)^{1/4} ≤ C₄ e_j(m)`. -/
theorem window_moment (P : Measure Ω) [IsProbabilityMeasure P] {C4 : ℝ}
    (hmom : ∀ j y, (∫⁻ σ, ‖D.z j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ENNReal.ofReal (D.Z j y)) (j : Fin 4) (m : ℤ) :
    (∫⁻ σ, (∫⁻ t, ‖slotLift D.δ (D.inp σ) j m t‖ₑ ^ (2 : ℝ) ∂fastHaar) ^ (4 / 2 : ℝ) ∂P) ^
      (1 / 4 : ℝ) ≤ ENNReal.ofReal C4 * D.ewin j m := by
  have hF : Measurable (Function.uncurry fun σ t => slotLift D.δ (D.inp σ) j m t) :=
    measurable_slotLift_joint D.z_meas j m
  have h := random_L2_moment P fastHaar (fun σ t => slotLift D.δ (D.inp σ) j m t) hF
    (a := 4) (by norm_num) (Z := fun t => ‖slotLift D.δ D.Zc j m t‖ₑ)
    (measurable_slotLift D.measurable_Zc j m).enorm (Ca := ENNReal.ofReal C4) ?_
  · exact h
  intro t
  unfold slotLift fastLift
  split_ifs
  · refine (hmom j _).trans (le_of_eq ?_)
    simp only [Zc, enorm_ofReal_of_nonneg (D.Z_nonneg j _)]
  · simp

/-- The kernel support of a cell: the slow pairs with nonzero sampled kernel. -/
noncomputable def supp (I : ℤ × ℤ) : Finset (ℤ × ℤ) := by
  classical
  exact (D.box I).filter fun n => D.kernel I (D.δ * n.1, D.δ * n.2 - D.δ * n.1) ≠ 0

/-- The slow points of slot `j` relevant to the cell `I`. -/
noncomputable def slow (I : ℤ × ℤ) (j : Fin 4) : Finset ℤ := by
  classical
  exact (D.supp I).image (latticeCoord j)

theorem mem_supp {I : ℤ × ℤ} {n : ℤ × ℤ} (hn : n ∈ D.supp I) :
    n ∈ D.box I ∧ D.kernel I (D.δ * n.1, D.δ * n.2 - D.δ * n.1) ≠ 0 := by
  classical
  unfold supp at hn
  exact Finset.mem_filter.mp hn

/-- The sample point of a relevant slow pair has all progression coordinates `δ n_j` in the
interior part `[a + μ r, a + r - μ r]` of the cell. -/
theorem slow_mem {I : ℤ × ℤ} (hI : I ∈ D.cells) {j : Fin 4} {m : ℤ} (hm : m ∈ D.slow I j) :
    D.left I + κ.margin * D.len I ≤ D.δ * m ∧
      D.δ * m ≤ D.left I + D.len I - κ.margin * D.len I := by
  classical
  unfold slow at hm
  obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hm
  have h := (D.admissible I hI).support _ (D.mem_supp hn).2 j
  simp only [realProgressionCoordinate] at h
  have e : D.δ * n.1 + (j : ℕ) * (D.δ * n.2 - D.δ * n.1) = D.δ * (latticeCoord j n : ℤ) := by
    simp only [latticeCoord]; push_cast; ring
  rw [e] at h
  exact h

/-- The windows of relevant slow points lie in the cell. -/
theorem window_subset {I : ℤ × ℤ} (hI : I ∈ D.cells) {j : Fin 4} {m : ℤ} (hm : m ∈ D.slow I j) :
    D.window j m ⊆ Set.Icc (D.left I) (D.left I + D.len I) := by
  intro y hy
  have h := D.slow_mem hI hm
  have hδ : 8 * D.δ ≤ κ.margin * D.len I := D.δ_small I hI
  have hl := fastLiftLeft_bounds j
  have hr := fastLift_right_le j
  have hδ0 := D.δ_pos
  simp only [window, Set.mem_Ico] at hy
  have e1 : D.δ * (m + fastLiftLeft j + fastLiftLen j) ≤ D.δ * m + 4 * D.δ := by nlinarith
  have e2 : D.δ * m - 4 * D.δ ≤ D.δ * (m + fastLiftLeft j) := by nlinarith
  constructor <;> nlinarith [hy.1, hy.2]

end BlockData

theorem card_Icc_ceil_floor_le {a r δ : ℝ} (hδ : 0 < δ) (hr : 0 ≤ r) :
    ((Finset.Icc ⌈a / δ⌉ ⌊(a + r) / δ⌋).card : ℝ) ≤ r / δ + 1 := by
  rw [Int.card_Icc]
  have h1 := Int.floor_le ((a + r) / δ)
  have h2 := Int.le_ceil (a / δ)
  have e : (a + r) / δ = a / δ + r / δ := by rw [add_div]
  rcases le_or_gt (⌊(a + r) / δ⌋ + 1 - ⌈a / δ⌉) 0 with h | h
  · rw [Int.toNat_of_nonpos h]; simp only [Nat.cast_zero]; positivity
  · rw [show (((⌊(a + r) / δ⌋ + 1 - ⌈a / δ⌉).toNat : ℕ) : ℝ) =
        ((⌊(a + r) / δ⌋ + 1 - ⌈a / δ⌉ : ℤ) : ℝ) by exact_mod_cast Int.toNat_of_nonneg h.le]
    push_cast
    linarith

namespace BlockData
variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

/-- The one-dimensional index range of the box. -/
noncomputable def boxRange (I : ℤ × ℤ) : Finset ℤ :=
  Finset.Icc ⌈D.left I / D.δ⌉ ⌊(D.left I + D.len I) / D.δ⌋

theorem card_boxRange (I : ℤ × ℤ) : ((D.boxRange I).card : ℝ) ≤ D.len I / D.δ + 1 :=
  card_Icc_ceil_floor_le D.δ_pos (D.len_pos I).le

theorem card_supp_le (I : ℤ × ℤ) :
    ((D.supp I).card : ℝ) ≤ (D.len I / D.δ + 1) ^ 2 := by
  classical
  have h : (D.supp I).card ≤ (D.box I).card := Finset.card_filter_le _ _
  have hb : (D.box I).card = (D.boxRange I).card ^ 2 := by
    rw [box, Finset.card_product, sq]; rfl
  calc ((D.supp I).card : ℝ) ≤ (D.boxRange I).card ^ 2 := by exact_mod_cast hb ▸ h
    _ ≤ _ := by gcongr; exact D.card_boxRange I

theorem card_fiber_le (I : ℤ × ℤ) (j : Fin 4) (m : ℤ) :
    (((D.supp I).filter fun n => latticeCoord j n = m).card : ℝ) ≤ D.len I / D.δ + 1 := by
  classical
  refine le_trans ?_ (D.card_boxRange I)
  have hsub : ∀ n ∈ (D.supp I).filter (fun n => latticeCoord j n = m),
      n.1 ∈ D.boxRange I ∧ n.2 ∈ D.boxRange I := by
    intro n hn
    have := (D.mem_supp (Finset.mem_filter.mp hn).1).1
    exact Finset.mem_product.mp this
  by_cases hj : (j : ℕ) = 0
  · exact_mod_cast Finset.card_le_card_of_injOn Prod.snd (fun n hn => (hsub n hn).2)
      (fun n hn n' hn' e => by
        have h1 := (Finset.mem_filter.mp hn).2
        have h2 := (Finset.mem_filter.mp hn').2
        simp only [latticeCoord, hj, Nat.cast_zero, sub_zero, one_mul, zero_mul,
          add_zero] at h1 h2
        exact Prod.ext (h1.trans h2.symm) e)
  · exact_mod_cast Finset.card_le_card_of_injOn Prod.fst (fun n hn => (hsub n hn).1)
      (fun n hn n' hn' e => by
        have h1 := (Finset.mem_filter.mp hn).2
        have h2 := (Finset.mem_filter.mp hn').2
        simp only [latticeCoord] at h1 h2
        have hj' : ((j : ℕ) : ℤ) ≠ 0 := by exact_mod_cast hj
        refine Prod.ext e ?_
        have : ((j : ℕ) : ℤ) * n.2 = ((j : ℕ) : ℤ) * n'.2 := by rw [e] at h1; linarith
        exact mul_left_cancel₀ hj' this)

theorem card_slow_le {I : ℤ × ℤ} (hI : I ∈ D.cells) (j : Fin 4) :
    ((D.slow I j).card : ℝ) ≤ D.len I / D.δ + 1 := by
  refine le_trans ?_ (D.card_boxRange I)
  have hμ := κ.margin_pos.le
  have hr := (D.len_pos I).le
  have hδ := D.δ_pos
  have hsub : D.slow I j ⊆ D.boxRange I := fun m hm => by
    have h := D.slow_mem hI hm
    rw [boxRange, Finset.mem_Icc, Int.ceil_le, Int.le_floor, div_le_iff₀ hδ, le_div_iff₀ hδ]
    constructor <;> nlinarith [h.1, h.2]
  exact_mod_cast Finset.card_le_card hsub

/-- The coefficients of the weighted multiplied slots restricted to the relevant slow points of
a cell. -/
noncomputable def cellCoef (w : Fin 4 → ℤ → ℂ) (I : ℤ × ℤ) (j : Fin 4) (σ : Ω) (m k : ℤ) : ℂ := by
  classical
  exact if m ∈ D.slow I j then w j m * fourierCoeff (slotLift D.δ (D.inp σ) j m) k else 0

theorem cellCoef_of_mem (w : Fin 4 → ℤ → ℂ) {I : ℤ × ℤ} {j : Fin 4} (σ : Ω) {m : ℤ}
    (hm : m ∈ D.slow I j) :
    D.cellCoef w I j σ m = fun k => w j m * fourierCoeff (slotLift D.δ (D.inp σ) j m) k := by
  classical
  funext k; simp [cellCoef, hm]

theorem measurable_cellCoef (w : Fin 4 → ℤ → ℂ) (I : ℤ × ℤ) (j : Fin 4) (m k : ℤ) :
    Measurable fun σ => D.cellCoef w I j σ m k := by
  classical
  unfold cellCoef
  split_ifs
  · exact measurable_const.mul (measurable_fourierCoeff_slotLift D.z_meas j m k)
  · exact measurable_const

/-- Blueprint lines 2334-2337 (the lattice form dominates): the lattice sum of weighted multiplied
slots is at most `256 C_κ' Σ_I |I|` times the positive mixed forms of the fast windows on the
kernel supports, with weights `ε = δ / r_I`. -/
theorem norm_latticeSum_le_windows (ε : ℤ × ℤ → Ω → ℂ) (hε1 : ∀ I σ, ‖ε I σ‖ ≤ 1) (N : ℕ)
    (w : Fin 4 → ℤ → ℂ) (γ : ℝ) (σ : Ω) :
    ‖D.latticeSum ε σ (D.multWith N w γ σ)‖ₑ ≤ ∑ I ∈ D.cells,
      ENNReal.ofReal (256 * localKernelSupBound κ * D.len I) *
        ∫⁻ x, ∏ j : Fin 4, fastWindow (Finset.Icc (-(N : ℤ)) N)
          (fun σ' => D.cellCoef w I j σ') (fastSlotC j) (σ, γ) (latticeTorusProj j x)
          ∂latticeTorusMeasure (D.supp I) (ENNReal.ofReal (D.δ / D.len I)) := by
  classical
  unfold latticeSum
  refine (enorm_sum_le _ _).trans (Finset.sum_le_sum fun I hI => ?_)
  have hr := D.len_pos I
  have hδ := D.δ_pos
  have hF : Measurable fun x : (ℤ × ℤ) × (FastCircle × FastCircle) => ∏ j : Fin 4,
      fastWindow (Finset.Icc (-(N : ℤ)) N) (fun σ' => D.cellCoef w I j σ') (fastSlotC j) (σ, γ)
        (latticeTorusProj j x) :=
    Finset.measurable_prod _ fun j _ =>
      (measurable_fastWindow_section _ _ _ _).comp (measurable_latticeTorusProj _)
  rw [lintegral_latticeTorusMeasure _ _ hF]
  -- the sum over the box reduces to the kernel support
  have hsum : ∑ n ∈ D.box I, D.kernel I (D.δ * n.1, D.δ * n.2 - D.δ * n.1) *
      fastFormAt (D.multWith N w γ σ) n = ∑ n ∈ D.supp I, D.kernel I
        (D.δ * n.1, D.δ * n.2 - D.δ * n.1) * fastFormAt (D.multWith N w γ σ) n := by
    unfold supp
    rw [Finset.sum_filter]
    refine Finset.sum_congr rfl fun n _ => ?_
    split_ifs with h
    · rfl
    · push Not at h; rw [h, zero_mul]
  rw [hsum]
  have hpt : ∀ n ∈ D.supp I, ‖D.kernel I (D.δ * n.1, D.δ * n.2 - D.δ * n.1) *
      fastFormAt (D.multWith N w γ σ) n‖ₑ ≤ ENNReal.ofReal (localKernelSupBound κ) *
        ∫⁻ x, ∏ j : Fin 4, fastWindow (Finset.Icc (-(N : ℤ)) N)
          (fun σ' => D.cellCoef w I j σ') (fastSlotC j) (σ, γ) (latticeTorusProj j (n, x))
          ∂(fastHaar.prod fastHaar) := by
    intro n hn
    rw [enorm_mul]
    gcongr
    · rw [← ofReal_norm]
      exact ENNReal.ofReal_le_ofReal (admissibleLocalKernel_norm_le (D.admissible I hI) _)
    · unfold fastFormAt
      refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq (lintegral_congr fun x => ?_))
      rw [enorm_prod_four]
      refine Finset.prod_congr rfl fun j _ => ?_
      have hm : latticeCoord j n ∈ D.slow I j := by
        unfold slow; exact Finset.mem_image_of_mem _ hn
      simp only [fastWindow, latticeTorusProj, D.cellCoef_of_mem w σ hm]
      rfl
  have hS : ‖∑ n ∈ D.supp I, D.kernel I (D.δ * n.1, D.δ * n.2 - D.δ * n.1) *
      fastFormAt (D.multWith N w γ σ) n‖ₑ ≤ ENNReal.ofReal (localKernelSupBound κ) *
        ∑ n ∈ D.supp I, ∫⁻ x, ∏ j : Fin 4, fastWindow (Finset.Icc (-(N : ℤ)) N)
          (fun σ' => D.cellCoef w I j σ') (fastSlotC j) (σ, γ) (latticeTorusProj j (n, x))
          ∂(fastHaar.prod fastHaar) := by
    rw [Finset.mul_sum]
    exact (enorm_sum_le _ _).trans (Finset.sum_le_sum hpt)
  have h1 : ‖(D.len I : ℂ)‖ₑ = ENNReal.ofReal (D.len I) := by
    rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg hr.le]
  have h2 : ‖ε I σ‖ₑ ≤ 1 := by
    rw [← ofReal_norm, ← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (hε1 I σ)
  have h3 : ‖(D.len I : ℂ)⁻¹ ^ 2 * ((D.δ ^ 2 : ℝ) : ℂ) * 256‖ₑ =
      ENNReal.ofReal ((D.δ / D.len I) ^ 2 * 256) := by
    rw [← ofReal_norm]
    congr 1
    rw [show (D.len I : ℂ)⁻¹ ^ 2 * ((D.δ ^ 2 : ℝ) : ℂ) * 256 =
      (((D.δ / D.len I) ^ 2 * 256 : ℝ) : ℂ) by push_cast; ring, Complex.norm_real,
      Real.norm_of_nonneg (by positivity)]
  rw [enorm_mul, enorm_mul, enorm_mul, h1, h3]
  have e : ENNReal.ofReal (D.len I) * 1 * (ENNReal.ofReal ((D.δ / D.len I) ^ 2 * 256) *
      ENNReal.ofReal (localKernelSupBound κ)) =
      ENNReal.ofReal (256 * localKernelSupBound κ * D.len I) *
        ENNReal.ofReal (D.δ / D.len I) ^ 2 := by
    have hC := localKernelSupBound_nonneg κ
    rw [mul_one, ← ENNReal.ofReal_pow (by positivity), ← ENNReal.ofReal_mul (by positivity),
      ← ENNReal.ofReal_mul hr.le, ← ENNReal.ofReal_mul (by positivity)]
    congr 1; ring
  calc ENNReal.ofReal (D.len I) * ‖ε I σ‖ₑ * (ENNReal.ofReal ((D.δ / D.len I) ^ 2 * 256) *
        ‖∑ n ∈ D.supp I, D.kernel I (D.δ * n.1, D.δ * n.2 - D.δ * n.1) *
          fastFormAt (D.multWith N w γ σ) n‖ₑ)
      ≤ ENNReal.ofReal (D.len I) * 1 * (ENNReal.ofReal ((D.δ / D.len I) ^ 2 * 256) *
          (ENNReal.ofReal (localKernelSupBound κ) * ∑ n ∈ D.supp I, ∫⁻ x, ∏ j : Fin 4,
            fastWindow (Finset.Icc (-(N : ℤ)) N) (fun σ' => D.cellCoef w I j σ') (fastSlotC j)
              (σ, γ) (latticeTorusProj j (n, x)) ∂(fastHaar.prod fastHaar))) := by
        gcongr
    _ = _ := by
        rw [← mul_assoc (ENNReal.ofReal ((D.δ / D.len I) ^ 2 * 256)), ← mul_assoc, e,
          mul_assoc, Finset.mul_sum]

/-- The squared fast mass of a lifted random slot. -/
noncomputable def slotMass (σ : Ω) (j : Fin 4) (m : ℤ) : ℝ≥0∞ :=
  ∫⁻ t, ‖slotLift D.δ (D.inp σ) j m t‖ₑ ^ (2 : ℝ) ∂fastHaar

theorem fastMass_cellCoef_le (w : Fin 4 → ℤ → ℂ) {I : ℤ × ℤ} {j : Fin 4} {m : ℤ}
    (hm : m ∈ D.slow I j) (s : Finset ℤ) (σ : Ω) :
    ENNReal.ofReal (fastMass s (fun σ' => D.cellCoef w I j σ') σ m) ≤
      ‖w j m‖ₑ ^ 2 * D.slotMass σ j m := by
  unfold fastMass
  change ENNReal.ofReal (∑ k ∈ s, ‖D.cellCoef w I j σ m k‖ ^ 2) ≤ _
  rw [D.cellCoef_of_mem w σ hm]
  simp only [norm_mul, mul_pow, ← Finset.mul_sum]
  rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]
  gcongr
  exact fast_bessel_enorm (measurable_slotLift (D.measurable_inp σ) j m) s

/-- Fourth moment of the slot masses: `(E X²)^{1/4} ≤ C₄ e_j(m)`. -/
theorem slotMass_moment (P : Measure Ω) [IsProbabilityMeasure P] {C4 : ℝ}
    (hmom : ∀ j y, (∫⁻ σ, ‖D.z j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ENNReal.ofReal (D.Z j y)) (j : Fin 4) (m : ℤ) :
    (∫⁻ σ, D.slotMass σ j m ^ (2 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤ ENNReal.ofReal C4 * D.ewin j m := by
  have h := D.window_moment P hmom j m
  rw [show (4 / 2 : ℝ) = 2 by norm_num] at h
  exact h

/-- The window sum of a cell: `Σ_{m relevant} e_j(m)² ≤ (16 δ)⁻¹ 8 ∫_I Z_j²`. -/
theorem sum_ewin_sq_le {I : ℤ × ℤ} (hI : I ∈ D.cells) (j : Fin 4) :
    ∑ m ∈ D.slow I j, D.ewin j m ^ (2 : ℝ) ≤ (ENNReal.ofReal (16 * D.δ))⁻¹ * 8 *
      ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I), ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) := by
  simp_rw [D.ewin_sq]
  rw [← Finset.mul_sum, mul_assoc]
  gcongr
  refine (window_sum_le_of_subset D.δ_pos j _ (D.slow I j) _ measurableSet_Icc
    fun m hm => D.window_subset hI hm).trans ?_
  gcongr
  unfold fastLiftLenNat; split_ifs <;> norm_num

/-- The heavy factor of the deletion bound at one cell (blueprint lines 2335-2337):
`ε Σ_m (E fastMass²)^{1/4} ≤ C₄ A⁻¹ (2 r_I)⁻¹ ∫_I Z_a²` for the deleted windows `e_a > A`. -/
theorem heavy_factor_le (P : Measure Ω) [IsProbabilityMeasure P] {C4 : ℝ}
    (hmom : ∀ j y, (∫⁻ σ, ‖D.z j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ENNReal.ofReal (D.Z j y)) {I : ℤ × ℤ} (hI : I ∈ D.cells) (a : Fin 4)
    {A : ℝ} (hA : 0 < A) (s : Finset ℤ) :
    ENNReal.ofReal (D.δ / D.len I) * ∑ m ∈ D.slow I a, (∫⁻ σ, ENNReal.ofReal
      (fastMass s (fun σ' => D.cellCoef (wDel a {m | D.ewin a m ≤ ENNReal.ofReal A}) I a σ')
        σ m) ^ (2 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * (ENNReal.ofReal A)⁻¹ * (ENNReal.ofReal (D.len I))⁻¹ *
        ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I), ENNReal.ofReal (D.Z a y) ^ (2 : ℝ) := by
  classical
  have hδ := D.δ_pos
  have hr := D.len_pos I
  set keep : Set ℤ := {m | D.ewin a m ≤ ENNReal.ofReal A}
  have hterm : ∀ m ∈ D.slow I a, (∫⁻ σ, ENNReal.ofReal (fastMass s
      (fun σ' => D.cellCoef (wDel a keep) I a σ') σ m) ^ (2 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ((ENNReal.ofReal A)⁻¹ * D.ewin a m ^ (2 : ℝ)) := by
    intro m hm
    by_cases hk : m ∈ keep
    · have h0 : ∀ σ, ENNReal.ofReal (fastMass s
          (fun σ' => D.cellCoef (wDel a keep) I a σ') σ m) = 0 := by
        intro σ
        refine le_antisymm ((D.fastMass_cellCoef_le _ hm s σ).trans (le_of_eq ?_)) bot_le
        simp [wDel, hk]
      simp_rw [h0]
      simp
    · have hw : ‖wDel a keep a m‖ₑ ^ 2 = 1 := by simp [wDel, hk]
      have hle : ∀ σ, ENNReal.ofReal (fastMass s
          (fun σ' => D.cellCoef (wDel a keep) I a σ') σ m) ≤ D.slotMass σ a m := fun σ =>
        (D.fastMass_cellCoef_le _ hm s σ).trans (by rw [hw, one_mul])
      have hA' : ENNReal.ofReal A < D.ewin a m := not_le.mp hk
      calc (∫⁻ σ, ENNReal.ofReal (fastMass s
            (fun σ' => D.cellCoef (wDel a keep) I a σ') σ m) ^ (2 : ℝ) ∂P) ^ (1 / 4 : ℝ)
          ≤ (∫⁻ σ, D.slotMass σ a m ^ (2 : ℝ) ∂P) ^ (1 / 4 : ℝ) := by
            gcongr with σ; exact hle σ
        _ ≤ ENNReal.ofReal C4 * D.ewin a m := D.slotMass_moment P hmom a m
        _ ≤ ENNReal.ofReal C4 * ((ENNReal.ofReal A)⁻¹ * D.ewin a m ^ (2 : ℝ)) := by
            gcongr
            rw [ENNReal.rpow_two, pow_two]
            calc D.ewin a m = ((ENNReal.ofReal A)⁻¹ * ENNReal.ofReal A) * D.ewin a m := by
                  rw [ENNReal.inv_mul_cancel (by simp [hA]) ENNReal.ofReal_ne_top, one_mul]
              _ ≤ ((ENNReal.ofReal A)⁻¹ * D.ewin a m) * D.ewin a m := by gcongr
              _ = _ := by ring
  calc ENNReal.ofReal (D.δ / D.len I) * ∑ m ∈ D.slow I a, _
      ≤ ENNReal.ofReal (D.δ / D.len I) * ∑ m ∈ D.slow I a,
          ENNReal.ofReal C4 * ((ENNReal.ofReal A)⁻¹ * D.ewin a m ^ (2 : ℝ)) := by
        gcongr with m hm; exact hterm m hm
    _ = ENNReal.ofReal C4 * (ENNReal.ofReal A)⁻¹ * (ENNReal.ofReal (D.δ / D.len I) *
          ∑ m ∈ D.slow I a, D.ewin a m ^ (2 : ℝ)) := by
        rw [← Finset.mul_sum, ← Finset.mul_sum]; ring
    _ ≤ ENNReal.ofReal C4 * (ENNReal.ofReal A)⁻¹ * (ENNReal.ofReal (D.δ / D.len I) *
          ((ENNReal.ofReal (16 * D.δ))⁻¹ * 8 * ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
            ENNReal.ofReal (D.Z a y) ^ (2 : ℝ))) := by
        gcongr; exact D.sum_ewin_sq_le hI a
    _ ≤ _ := by
        have hscal : ENNReal.ofReal (D.δ / D.len I) * ((ENNReal.ofReal (16 * D.δ))⁻¹ * 8) ≤
            (ENNReal.ofReal (D.len I))⁻¹ := by
          rw [← ENNReal.ofReal_inv_of_pos (by positivity : 0 < 16 * D.δ),
            show (8 : ℝ≥0∞) = ENNReal.ofReal 8 by norm_num,
            ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
            ← ENNReal.ofReal_inv_of_pos hr]
          apply ENNReal.ofReal_le_ofReal
          have e : D.δ / D.len I * ((16 * D.δ)⁻¹ * 8) = (D.len I)⁻¹ / 2 := by
            field_simp; ring
          rw [e]
          have := inv_pos.mpr hr
          linarith
        calc ENNReal.ofReal C4 * (ENNReal.ofReal A)⁻¹ * (ENNReal.ofReal (D.δ / D.len I) *
              ((ENNReal.ofReal (16 * D.δ))⁻¹ * 8 * ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
                ENNReal.ofReal (D.Z a y) ^ (2 : ℝ)))
            = ENNReal.ofReal C4 * (ENNReal.ofReal A)⁻¹ * ((ENNReal.ofReal (D.δ / D.len I) *
              ((ENNReal.ofReal (16 * D.δ))⁻¹ * 8)) * ∫⁻ y in Set.Icc (D.left I)
                (D.left I + D.len I), ENNReal.ofReal (D.Z a y) ^ (2 : ℝ)) := by ring
          _ ≤ ENNReal.ofReal C4 * (ENNReal.ofReal A)⁻¹ * ((ENNReal.ofReal (D.len I))⁻¹ *
              ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
                ENNReal.ofReal (D.Z a y) ^ (2 : ℝ)) := by gcongr
          _ = _ := by ring

/-- The regular factor of the deletion bound at one cell (blueprint line 2338):
`((ε|S|)^{1/3} ε Σ_m E 2 fastMass²)^{1/4} ≤ (2^{1/3} · 4 C₄⁴ E₂²)^{1/4}` when `e_j² ≤ E₂`. -/
theorem regular_factor_le (P : Measure Ω) [IsProbabilityMeasure P] {C4 E2 : ℝ}
    (hmom : ∀ j y, (∫⁻ σ, ‖D.z j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ENNReal.ofReal (D.Z j y)) {I : ℤ × ℤ} (hI : I ∈ D.cells) (j : Fin 4)
    (w : Fin 4 → ℤ → ℂ) (hw : ∀ m, ‖w j m‖ₑ ≤ 1)
    (hreg : ∀ m, D.ewin j m ^ (2 : ℝ) ≤ ENNReal.ofReal E2) (s : Finset ℤ) :
    ((ENNReal.ofReal (D.δ / D.len I) * (D.slow I j).card) ^ (1 / 3 : ℝ) *
      (ENNReal.ofReal (D.δ / D.len I) * ∑ m ∈ D.slow I j, ∫⁻ σ, ENNReal.ofReal
        (2 * fastMass s (fun σ' => D.cellCoef w I j σ') σ m ^ 2) ∂P)) ^ (1 / 4 : ℝ) ≤
      ((2 : ℝ≥0∞) ^ (1 / 3 : ℝ) * (4 * ENNReal.ofReal C4 ^ 4 * ENNReal.ofReal E2 ^ 2)) ^
        (1 / 4 : ℝ) := by
  have hδ := D.δ_pos
  have hr := D.len_pos I
  -- `ε |S| ≤ 2`
  have hεS : ENNReal.ofReal (D.δ / D.len I) * (D.slow I j).card ≤ 2 := by
    have hc := D.card_slow_le hI j
    have hδr : D.δ ≤ D.len I := by have := D.δ_le_len I hI; unfold len; linarith
    rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity),
      show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by norm_num]
    apply ENNReal.ofReal_le_ofReal
    have e : D.δ / D.len I * (D.len I / D.δ + 1) = 1 + D.δ / D.len I := by field_simp
    have h1 : D.δ / D.len I ≤ 1 := (div_le_one hr).mpr hδr
    calc D.δ / D.len I * (D.slow I j).card ≤ D.δ / D.len I * (D.len I / D.δ + 1) := by gcongr
      _ = 1 + D.δ / D.len I := e
      _ ≤ 2 := by linarith
  -- each term
  have hterm : ∀ m ∈ D.slow I j, ∫⁻ σ, ENNReal.ofReal
      (2 * fastMass s (fun σ' => D.cellCoef w I j σ') σ m ^ 2) ∂P ≤
      2 * ENNReal.ofReal C4 ^ 4 * ENNReal.ofReal E2 ^ 2 := by
    intro m hm
    have hX : ∀ σ, ENNReal.ofReal (2 * fastMass s (fun σ' => D.cellCoef w I j σ') σ m ^ 2) ≤
        2 * D.slotMass σ j m ^ (2 : ℝ) := by
      intro σ
      have hf := D.fastMass_cellCoef_le w hm s σ
      have hw1 : ‖w j m‖ₑ ^ 2 ≤ 1 := by
        calc ‖w j m‖ₑ ^ 2 ≤ 1 ^ 2 := by gcongr; exact hw m
          _ = 1 := one_pow 2
      rw [ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_pow (by unfold fastMass; positivity),
        ENNReal.rpow_two, ENNReal.ofReal_ofNat]
      gcongr
      exact hf.trans (mul_le_of_le_one_left zero_le hw1)
    have hmo := D.slotMass_moment P hmom j m
    have h4 : ∫⁻ σ, D.slotMass σ j m ^ (2 : ℝ) ∂P ≤ (ENNReal.ofReal C4 * D.ewin j m) ^ (4 : ℝ) := by
      have := ENNReal.rpow_le_rpow hmo (by norm_num : (0 : ℝ) ≤ 4)
      rwa [← ENNReal.rpow_mul, show (1 / 4 : ℝ) * 4 = 1 by norm_num, ENNReal.rpow_one] at this
    calc ∫⁻ σ, ENNReal.ofReal (2 * fastMass s (fun σ' => D.cellCoef w I j σ') σ m ^ 2) ∂P
        ≤ ∫⁻ σ, 2 * D.slotMass σ j m ^ (2 : ℝ) ∂P := lintegral_mono hX
      _ = 2 * ∫⁻ σ, D.slotMass σ j m ^ (2 : ℝ) ∂P := lintegral_const_mul' _ _ (by norm_num)
      _ ≤ 2 * (ENNReal.ofReal C4 * D.ewin j m) ^ (4 : ℝ) := by gcongr
      _ = 2 * ENNReal.ofReal C4 ^ 4 * (D.ewin j m ^ (2 : ℝ)) ^ 2 := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_natCast,
            ← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]
          norm_num; ring
      _ ≤ 2 * ENNReal.ofReal C4 ^ 4 * ENNReal.ofReal E2 ^ 2 := by gcongr; exact hreg m
  have hsum : ENNReal.ofReal (D.δ / D.len I) * ∑ m ∈ D.slow I j, ∫⁻ σ, ENNReal.ofReal
      (2 * fastMass s (fun σ' => D.cellCoef w I j σ') σ m ^ 2) ∂P ≤
      4 * ENNReal.ofReal C4 ^ 4 * ENNReal.ofReal E2 ^ 2 := by
    calc _ ≤ ENNReal.ofReal (D.δ / D.len I) * ∑ m ∈ D.slow I j,
          2 * ENNReal.ofReal C4 ^ 4 * ENNReal.ofReal E2 ^ 2 := by
          gcongr with m hm; exact hterm m hm
      _ = (ENNReal.ofReal (D.δ / D.len I) * (D.slow I j).card) *
          (2 * ENNReal.ofReal C4 ^ 4 * ENNReal.ofReal E2 ^ 2) := by
          rw [Finset.sum_const, nsmul_eq_mul]; ring
      _ ≤ 2 * (2 * ENNReal.ofReal C4 ^ 4 * ENNReal.ofReal E2 ^ 2) := by gcongr
      _ = _ := by ring
  exact ENNReal.rpow_le_rpow (mul_le_mul' (ENNReal.rpow_le_rpow hεS (by norm_num)) hsum)
    (by norm_num)

end BlockData

theorem prod_ite_le_four {a : Fin 4} {g : Fin 4 → ℝ≥0∞} {H R : ℝ≥0∞} (ha : g a ≤ H)
    (hr : ∀ j, j ≠ a → g j ≤ R) : ∏ j, g j ≤ H * R ^ 3 := by
  rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ a)]
  calc g a * ∏ j ∈ Finset.univ.erase a, g j ≤ H * ∏ _j ∈ Finset.univ.erase a, R :=
        mul_le_mul' ha (Finset.prod_le_prod fun j hj => hr j (Finset.ne_of_mem_erase hj))
    _ = H * R ^ 3 := by
        rw [Finset.prod_const, Finset.card_erase_of_mem (Finset.mem_univ a), Finset.card_univ,
          Fintype.card_fin]

theorem measurable_fastWindow_proj {Ω : Type*} [MeasurableSpace Ω] (A : Ω → ℤ → ℤ → ℂ)
    (hA : ∀ m k, Measurable fun ω => A ω m k) (s : Finset ℤ) (j : Fin 4) :
    Measurable fun p : (Ω × ℝ) × ((ℤ × ℤ) × (FastCircle × FastCircle)) =>
      fastWindow s A (fastSlotC j) p.1 (latticeTorusProj j p.2) := by
  have hg : Measurable fun p : (Ω × ℝ) × ((ℤ × ℤ) × (FastCircle × FastCircle)) =>
      (p.1, latticeTorusProj j p.2) :=
    measurable_fst.prodMk ((measurable_latticeTorusProj _).comp measurable_snd)
  have h := (measurable_fastWindow s hA (fastSlotC j)).comp hg
  exact h

namespace BlockData
variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

instance (B : Finset (ℤ × ℤ)) (ε : ℝ≥0∞) : SFinite (latticeTorusMeasure B ε) := by
  unfold latticeTorusMeasure; infer_instance

theorem measurable_cellWindow (w : Fin 4 → ℤ → ℂ) (I : ℤ × ℤ) (s : Finset ℤ) (j : Fin 4) :
    Measurable fun p : (Ω × ℝ) × ((ℤ × ℤ) × (FastCircle × FastCircle)) =>
      fastWindow s (fun σ' => D.cellCoef w I j σ') (fastSlotC j) p.1
        (latticeTorusProj j p.2) :=
  measurable_fastWindow_proj (fun σ' => D.cellCoef w I j σ')
    (fun m k => D.measurable_cellCoef w I j m k) s j

/-- The regular-slot constant of the deletion bound. -/
noncomputable def regConst (C4 E2 : ℝ) : ℝ≥0∞ :=
  ((2 : ℝ≥0∞) ^ (1 / 3 : ℝ) * (4 * ENNReal.ofReal C4 ^ 4 * ENNReal.ofReal E2 ^ 2)) ^ (1 / 4 : ℝ)

/-- Blueprint lines 2334-2343 (deletion of the large heavy windows): deleting in the heavy slot
the slow points with `e_a(m) > A`, the expected lattice sum of the deleted part is at most
`C A⁻¹ Σ_I ∫_I Z_a²` (exponents `(1,3,3,3)`, Hölder in `(σ, γ)`, regular windows `e_j² ≤ E₂`). -/
theorem deletion_bound (P : Measure Ω) [IsProbabilityMeasure P] {C4 E2 : ℝ}
    (hmom : ∀ j y, (∫⁻ σ, ‖D.z j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ENNReal.ofReal (D.Z j y))
    (ε : ℤ × ℤ → Ω → ℂ) (hε1 : ∀ I σ, ‖ε I σ‖ ≤ 1) (N : ℕ) (a : Fin 4) {A : ℝ} (hA : 0 < A)
    (hreg : ∀ j, j ≠ a → ∀ m, D.ewin j m ^ (2 : ℝ) ≤ ENNReal.ofReal E2) :
    ∫⁻ σ, ∫⁻ γ, ‖D.latticeSum ε σ
      (D.multWith N (wDel a {m | D.ewin a m ≤ ENNReal.ofReal A}) γ σ)‖ₑ ∂gammaMeasure ∂P ≤
      4 * ENNReal.ofReal (256 * localKernelSupBound κ) * regConst C4 E2 ^ 3 *
        ENNReal.ofReal C4 * (ENNReal.ofReal A)⁻¹ * ∑ I ∈ D.cells,
          ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I), ENNReal.ofReal (D.Z a y) ^ (2 : ℝ) := by
  classical
  set keep : Set ℤ := {m | D.ewin a m ≤ ENNReal.ofReal A}
  set s := Finset.Icc (-(N : ℤ)) N
  set W : ℤ × ℤ → Ω × ℝ → ℝ≥0∞ := fun I q => ∫⁻ x, ∏ j : Fin 4, fastWindow s
    (fun σ' => D.cellCoef (wDel a keep) I j σ') (fastSlotC j) q (latticeTorusProj j x)
    ∂latticeTorusMeasure (D.supp I) (ENNReal.ofReal (D.δ / D.len I))
  have hWm : ∀ I, Measurable (W I) := by
    intro I
    refine Measurable.lintegral_prod_right' (f := fun p : (Ω × ℝ) ×
      ((ℤ × ℤ) × (FastCircle × FastCircle)) => ∏ j : Fin 4, fastWindow s
        (fun σ' => D.cellCoef (wDel a keep) I j σ') (fastSlotC j) p.1
          (latticeTorusProj j p.2)) ?_
    exact Finset.measurable_prod _ fun j _ => D.measurable_cellWindow _ I s j
  -- pointwise majorant and Tonelli
  have hpt : ∀ σ γ, ‖D.latticeSum ε σ (D.multWith N (wDel a keep) γ σ)‖ₑ ≤
      ∑ I ∈ D.cells, ENNReal.ofReal (256 * localKernelSupBound κ * D.len I) * W I (σ, γ) :=
    fun σ γ => D.norm_latticeSum_le_windows ε hε1 N _ γ σ
  calc ∫⁻ σ, ∫⁻ γ, ‖D.latticeSum ε σ (D.multWith N (wDel a keep) γ σ)‖ₑ ∂gammaMeasure ∂P
      ≤ ∫⁻ σ, ∫⁻ γ, ∑ I ∈ D.cells, ENNReal.ofReal (256 * localKernelSupBound κ * D.len I) *
          W I (σ, γ) ∂gammaMeasure ∂P := lintegral_mono fun σ => lintegral_mono fun γ => hpt σ γ
    _ = ∑ I ∈ D.cells, ENNReal.ofReal (256 * localKernelSupBound κ * D.len I) *
          ∫⁻ q, W I q ∂(P.prod gammaMeasure) := by
        have h1 : ∀ σ, ∫⁻ γ, ∑ I ∈ D.cells, ENNReal.ofReal (256 * localKernelSupBound κ *
            D.len I) * W I (σ, γ) ∂gammaMeasure = ∑ I ∈ D.cells, ENNReal.ofReal
              (256 * localKernelSupBound κ * D.len I) * ∫⁻ γ, W I (σ, γ) ∂gammaMeasure := by
          intro σ
          rw [lintegral_finsetSum (f := fun I γ => ENNReal.ofReal
            (256 * localKernelSupBound κ * D.len I) * W I (σ, γ)) _ fun I _ =>
              measurable_const.mul ((hWm I).comp measurable_prodMk_left)]
          refine Finset.sum_congr rfl fun I _ => ?_
          rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
        simp_rw [h1]
        rw [lintegral_finsetSum (f := fun I σ => ENNReal.ofReal
          (256 * localKernelSupBound κ * D.len I) * ∫⁻ γ, W I (σ, γ) ∂gammaMeasure) _
          fun I _ => measurable_const.mul (hWm I).lintegral_prod_right']
        refine Finset.sum_congr rfl fun I _ => ?_
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
          lintegral_prod _ (hWm I).aemeasurable]
    _ ≤ ∑ I ∈ D.cells, 4 * ENNReal.ofReal (256 * localKernelSupBound κ) * regConst C4 E2 ^ 3 *
          ENNReal.ofReal C4 * (ENNReal.ofReal A)⁻¹ * ∫⁻ y in Set.Icc (D.left I)
            (D.left I + D.len I), ENNReal.ofReal (D.Z a y) ^ (2 : ℝ) := by
        refine Finset.sum_le_sum fun I hI => ?_
        have hδ := D.δ_pos
        have hr := D.len_pos I
        have hδr : D.δ ≤ D.len I := by have := D.δ_le_len I hI; unfold len; linarith
        have hreal : D.δ / D.len I * (D.len I / D.δ + 1) = 1 + D.δ / D.len I := by field_simp
        have h1 : D.δ / D.len I ≤ 1 := (div_le_one hr).mpr hδr
        have hB : ENNReal.ofReal (D.δ / D.len I) ^ 2 * ((D.supp I).card : ℝ≥0∞) ≤ 4 := by
          rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_pow (by positivity),
            ← ENNReal.ofReal_mul (by positivity), show (4 : ℝ≥0∞) = ENNReal.ofReal 4 by norm_num]
          apply ENNReal.ofReal_le_ofReal
          calc (D.δ / D.len I) ^ 2 * ((D.supp I).card : ℝ)
              ≤ (D.δ / D.len I) ^ 2 * (D.len I / D.δ + 1) ^ 2 := by
                gcongr; exact D.card_supp_le I
            _ = (1 + D.δ / D.len I) ^ 2 := by rw [← mul_pow, hreal]
            _ ≤ 2 ^ 2 := by gcongr; linarith
            _ = 4 := by norm_num
        have hM : ENNReal.ofReal (D.δ / D.len I) * ENNReal.ofReal (D.len I / D.δ + 1) ≤ 4 := by
          rw [← ENNReal.ofReal_mul (by positivity), hreal,
            show (4 : ℝ≥0∞) = ENNReal.ofReal 4 by norm_num]
          exact ENNReal.ofReal_le_ofReal (by linarith)
        have hfib : ∀ j : Fin 4, ∀ m, (((D.supp I).filter fun n => latticeCoord j n = m).card :
            ℝ≥0∞) ≤ ENNReal.ofReal (D.len I / D.δ + 1) := fun j m => by
          rw [← ENNReal.ofReal_natCast]; exact ENNReal.ofReal_le_ofReal (D.card_fiber_le I j m)
        have hS : ∀ j σ' m, m ∉ D.slow I j →
            (fun σ' => D.cellCoef (wDel a keep) I j σ') σ' m = fun _ => 0 := by
          intro j σ' m hm; funext k; simp [cellCoef, hm]
        have hcell := per_cell_deletion_bound (D.supp I) (by norm_num : (1 : ℝ≥0∞) ≤ 4) hB hM
          hfib P s (fun j σ' => D.cellCoef (wDel a keep) I j σ')
          (fun j m k => D.measurable_cellCoef _ I j m k) (fun j => D.slow I j) hS a
        have hw : ∀ j m, ‖wDel a keep j m‖ₑ ≤ 1 := by
          intro j m; unfold wDel; split_ifs <;> simp
        have hbound : ∫⁻ q, W I q ∂(P.prod gammaMeasure) ≤ 4 * ((ENNReal.ofReal C4 *
            (ENNReal.ofReal A)⁻¹ * (ENNReal.ofReal (D.len I))⁻¹ * ∫⁻ y in Set.Icc (D.left I)
              (D.left I + D.len I), ENNReal.ofReal (D.Z a y) ^ (2 : ℝ)) *
                regConst C4 E2 ^ 3) := by
          refine hcell.trans ?_
          gcongr
          refine prod_ite_le_four (a := a) ?_ fun j hj => ?_
          · simp only [ite_true]
            exact D.heavy_factor_le P hmom hI a hA s
          · simp only [hj, ite_false]
            exact D.regular_factor_le P hmom hI j _ (hw j) (hreg j hj) s
        calc ENNReal.ofReal (256 * localKernelSupBound κ * D.len I) *
              ∫⁻ q, W I q ∂(P.prod gammaMeasure)
            ≤ ENNReal.ofReal (256 * localKernelSupBound κ * D.len I) *
              (4 * ((ENNReal.ofReal C4 * (ENNReal.ofReal A)⁻¹ * (ENNReal.ofReal (D.len I))⁻¹ *
                ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
                  ENNReal.ofReal (D.Z a y) ^ (2 : ℝ)) * regConst C4 E2 ^ 3)) := by
              gcongr
          _ = _ := by
              have hC := localKernelSupBound_nonneg κ
              rw [ENNReal.ofReal_mul (by positivity)]
              have hl : ENNReal.ofReal (D.len I) * (ENNReal.ofReal (D.len I))⁻¹ = 1 :=
                ENNReal.mul_inv_cancel (by simp [hr]) ENNReal.ofReal_ne_top
              calc ENNReal.ofReal (256 * localKernelSupBound κ) * ENNReal.ofReal (D.len I) *
                    (4 * ((ENNReal.ofReal C4 * (ENNReal.ofReal A)⁻¹ *
                      (ENNReal.ofReal (D.len I))⁻¹ * ∫⁻ y in Set.Icc (D.left I)
                        (D.left I + D.len I), ENNReal.ofReal (D.Z a y) ^ (2 : ℝ)) *
                      regConst C4 E2 ^ 3))
                  = (ENNReal.ofReal (D.len I) * (ENNReal.ofReal (D.len I))⁻¹) *
                    (4 * ENNReal.ofReal (256 * localKernelSupBound κ) * regConst C4 E2 ^ 3 *
                      ENNReal.ofReal C4 * (ENNReal.ofReal A)⁻¹ * ∫⁻ y in Set.Icc (D.left I)
                        (D.left I + D.len I), ENNReal.ofReal (D.Z a y) ^ (2 : ℝ)) := by ring
                _ = _ := by rw [hl, one_mul]
    _ = _ := by rw [Finset.mul_sum]

end BlockData

theorem fastRep_mem (j : Fin 4) (t : FastCircle) :
    fastRep j t ∈ Set.Ico (fastLiftLeft j) (fastLiftLeft j + 16) :=
  (AddCircle.equivIco 16 (fastLiftLeft j) t).2

/-- The rounded-center kernel of a kernel with local progression support on `[a, a + r]` has
local progression support on `[a - 3δ, a + r + 3δ]`. -/
theorem roundSampled_support {w : ℝ × ℝ → ℂ} {a r δ : ℝ} (hδ : 0 < δ)
    (hw : HasLocalProgressionSupport a r w) :
    HasLocalProgressionSupport (a - 3 * δ) (r + 6 * δ) (roundSampledKernel δ w) := by
  intro z hz j
  have h := hw _ hz
  obtain ⟨o1, o2, o3, o4⟩ := roundSampled_offsets hδ z
  have h0 := h 0
  have h1 := h 1
  have hj := h j
  simp only [realProgressionCoordinate, Fin.val_zero, Nat.cast_zero, zero_mul, add_zero,
    Fin.val_one, Nat.cast_one, one_mul, Set.mem_Icc] at h0 h1 hj ⊢
  have hj0 : (0 : ℝ) ≤ (j : ℕ) := Nat.cast_nonneg _
  have hj3 : ((j : ℕ) : ℝ) ≤ 3 := by exact_mod_cast Nat.le_of_lt_succ j.isLt
  have e : z.1 + (j : ℕ) * z.2 = (1 - (j : ℕ)) * z.1 + (j : ℕ) * (z.1 + z.2) := by ring
  set s0 := δ * (⌊z.1 / δ + 1 / 2⌋ : ℝ)
  set s1 := δ * (⌊(z.1 + z.2) / δ + 1 / 2⌋ : ℝ)
  have e' : s0 + (j : ℕ) * (s1 - s0) = (1 - (j : ℕ)) * s0 + (j : ℕ) * s1 := by ring
  rw [e'] at hj
  rw [e]
  constructor <;> rcases le_or_gt ((j : ℕ) : ℝ) 1 with hle | hlt <;> nlinarith

theorem measurable_roundSampledKernel {w : ℝ × ℝ → ℂ} (hw : Measurable w) (δ : ℝ) :
    Measurable (roundSampledKernel δ w) := by
  unfold roundSampledKernel
  have hfl : ∀ {g : ℝ × ℝ → ℝ}, Measurable g → Measurable fun z => ((⌊g z⌋ : ℤ) : ℝ) :=
    fun hg => measurable_from_top.comp (Int.measurable_floor.comp hg)
  have h0 := hfl ((measurable_fst.div_const δ).add_const (1 / 2))
  have h1 := hfl (((measurable_fst.add measurable_snd).div_const δ).add_const (1 / 2))
  exact hw.comp ((measurable_const.mul h0).prodMk
    ((measurable_const.mul h1).sub (measurable_const.mul h0)))

namespace BlockData
variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

/-- The finitely many slow points whose windows can meet the support `[lo, hi]`. -/
noncomputable def T : Finset ℤ := Finset.Icc (⌊D.lo / D.δ⌋ - 8) (⌈D.hi / D.δ⌉ + 8)

theorem slotLift_eq_zero {m : ℤ} (hm : m ∉ D.T) (σ : Ω) (j : Fin 4) :
    slotLift D.δ (D.inp σ) j m = 0 := by
  funext t
  unfold slotLift fastLift
  split_ifs with h
  · refine D.z_supp j σ _ fun hy => hm ?_
    have hr := fastRep_mem j t
    have hl := fastLiftLeft_bounds j
    have hR := fastLift_right_le j
    have hδ := D.δ_pos
    simp only [Set.mem_Ico] at hr
    simp only [Set.mem_Icc] at hy
    have k1 := Int.floor_le (D.lo / D.δ)
    have k2 := Int.le_ceil (D.hi / D.δ)
    have e1 : D.lo / D.δ * D.δ = D.lo := div_mul_cancel₀ _ hδ.ne'
    have e2 : D.hi / D.δ * D.δ = D.hi := div_mul_cancel₀ _ hδ.ne'
    rw [T, Finset.mem_Icc]
    constructor
    · by_contra hc
      push Not at hc
      have : (m : ℝ) ≤ ⌊D.lo / D.δ⌋ - 9 := by
        have : m ≤ ⌊D.lo / D.δ⌋ - 9 := by omega
        exact_mod_cast this
      nlinarith
    · by_contra hc
      push Not at hc
      have : (⌈D.hi / D.δ⌉ : ℝ) + 9 ≤ m := by
        have : ⌈D.hi / D.δ⌉ + 9 ≤ m := by omega
        exact_mod_cast this
      nlinarith
  · rfl

theorem multWith_eq_zero (N : ℕ) (w : Fin 4 → ℤ → ℂ) (γ : ℝ) (σ : Ω) (j : Fin 4) {m : ℤ}
    (hm : m ∉ D.T) : D.multWith N w γ σ j m = 0 := by
  funext t
  simp [multWith, fastCircleMultiplied, D.slotLift_eq_zero hm, fourierCoeff]

/-- The interval inputs of the comparison at the fast point `x ∈ T₀²` (blueprint line 2346), with
`c = 1/8`. -/
noncomputable def gin (N : ℕ) (w : Fin 4 → ℤ → ℂ) (γ : ℝ) (σ : Ω) (x : FastCircle × FastCircle)
    (j : Fin 4) : ℝ → ℂ :=
  intervalInput D.δ (1 / 8) D.T (fun m => D.multWith N w γ σ j m (fastCoord j x))

/-- The second kernel-sampling error at a cell. -/
noncomputable def err2 (I : ℤ × ℤ) (f : Fin 4 → ℝ → ℂ) : ℂ :=
  localProgressionForm (D.len I) (fun w => D.kernel I w - roundSampledKernel D.δ (D.kernel I) w) f

end BlockData

theorem sum_lintegral_le_lintegral_sum {α ι : Type*} [MeasurableSpace α] (μ : Measure α)
    (s : Finset ι) (f : ι → α → ℝ≥0∞) :
    ∑ i ∈ s, ∫⁻ x, f i x ∂μ ≤ ∫⁻ x, ∑ i ∈ s, f i x ∂μ := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert i s hi ih =>
    rw [Finset.sum_insert hi]
    simp_rw [Finset.sum_insert hi]
    exact (add_le_add le_rfl ih).trans (le_lintegral_add _ _)

namespace BlockData
variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

theorem measurable_gin (N : ℕ) (w : Fin 4 → ℤ → ℂ) (γ : ℝ) (σ : Ω)
    (x : FastCircle × FastCircle) (j : Fin 4) : Measurable (D.gin N w γ σ x j) :=
  measurable_intervalInput _ _ _ _

theorem memLp_gin (N : ℕ) (w : Fin 4 → ℤ → ℂ) (γ : ℝ) (σ : Ω)
    (x : FastCircle × FastCircle) (j : Fin 4) : MemLp (D.gin N w γ σ x j) 2 volume :=
  memLp_intervalInput _ _ _ _ _

/-- Blueprint lines 2345-2352 at one cell: the sampled lattice sum of the multiplied slots is
`(256 / |polygon|) ∫_{T₀²} H_I^{round}(g^x)`, the form of the interval inputs with the kernel
sampled at the rounded centers. -/
theorem cell_lattice_eq_interval (N : ℕ) (w : Fin 4 → ℤ → ℂ) (γ : ℝ) (σ : Ω) {I : ℤ × ℤ}
    (hI : I ∈ D.cells) :
    (D.len I : ℂ)⁻¹ ^ 2 * ((D.δ ^ 2 : ℝ) : ℂ) * 256 *
      ∑ n ∈ D.box I, D.kernel I (D.δ * n.1, D.δ * n.2 - D.δ * n.1) *
        fastFormAt (D.multWith N w γ σ) n =
      ((256 / (volume (offsetPolygon (1 / 8))).toReal : ℝ) : ℂ) *
        ∫ x, localProgressionForm (D.len I) (roundSampledKernel D.δ (D.kernel I))
          (D.gin N w γ σ x) ∂(fastHaar.prod fastHaar) := by
  classical
  have hδ := D.δ_pos
  have hr := D.len_pos I
  set P0 := (volume (offsetPolygon (1 / 8 : ℝ))).toReal
  have hP0 : 0 < P0 := ENNReal.toReal_pos (volume_offsetPolygon_pos (by norm_num)).ne'
    (volume_offsetPolygon_lt_top _).ne
  set K : ℤ × ℤ → ℂ := fun n => D.kernel I (D.δ * n.1, D.δ * n.2 - D.δ * n.1)
  set G : FastCircle × FastCircle → Fin 4 → ℤ → ℂ := fun x j m =>
    D.multWith N w γ σ j m (fastCoord j x)
  have hcont : ∀ n : ℤ × ℤ, Continuous fun x : FastCircle × FastCircle =>
      ∏ j : Fin 4, D.multWith N w γ σ j (latticeCoord j n) (fastCoord j x) := fun n =>
    continuous_finsetProd _ fun j _ =>
      (D.continuous_multWith N w γ σ j _).comp (continuous_fastCoord _)
  have hint : ∀ n : ℤ × ℤ, Integrable (fun x : FastCircle × FastCircle =>
      ∏ j : Fin 4, D.multWith N w γ σ j (latticeCoord j n) (fastCoord j x))
        (fastHaar.prod fastHaar) := fun n =>
    (hcont n).integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  -- the lattice sum at a fast point equals the interval form
  have hpt : ∀ x, ∑ n ∈ D.box I, K n * ∏ j : Fin 4, G x j (latticeCoord j n) =
      ((D.δ ^ 2 * P0 : ℝ) : ℂ)⁻¹ * ((D.len I : ℂ) ^ 2 *
        localProgressionForm (D.len I) (roundSampledKernel D.δ (D.kernel I))
          (D.gin N w γ σ x)) := by
    intro x
    have hG : ∀ j m, m ∉ (fun _ : Fin 4 => D.T) j → G x j m = 0 := by
      intro j m hm
      simp only [G, D.multWith_eq_zero N w γ σ j hm, Pi.zero_apply]
    have hid := interval_form_identity hδ (by norm_num : (1 / 8 : ℝ) < 1 / 7)
      (fun _ => D.T) (G x) hG K
    have hsub1 : ∑ n ∈ D.box I, K n * ∏ j : Fin 4, G x j (latticeCoord j n) =
        ∑ n ∈ D.box I ∩ D.T ×ˢ D.T, K n * ∏ j : Fin 4, G x j (latticeCoord j n) := by
      refine (Finset.sum_subset Finset.inter_subset_left fun n hn hn' => ?_).symm
      have : n.1 ∉ D.T ∨ n.2 ∉ D.T := by
        by_contra hc; push Not at hc
        exact hn' (Finset.mem_inter.mpr ⟨hn, Finset.mem_product.mpr hc⟩)
      rcases this with h | h
      · rw [Finset.prod_eq_zero (Finset.mem_univ (0 : Fin 4))
          (hG 0 _ (by simpa [latticeCoord] using h)), mul_zero]
      · rw [Finset.prod_eq_zero (Finset.mem_univ (1 : Fin 4))
          (hG 1 _ (by simpa [latticeCoord] using h)), mul_zero]
    have hsub2 : ∑ n ∈ D.T ×ˢ D.T, K n * ∏ j : Fin 4, G x j (latticeCoord j n) =
        ∑ n ∈ D.box I ∩ D.T ×ˢ D.T, K n * ∏ j : Fin 4, G x j (latticeCoord j n) := by
      refine (Finset.sum_subset Finset.inter_subset_right fun n hn hn' => ?_).symm
      have hK : K n = 0 := by
        by_contra hc
        exact hn' (Finset.mem_inter.mpr ⟨D.mem_box_of_ne hI hc, hn⟩)
      rw [hK, zero_mul]
    rw [hsub1, ← hsub2]
    have hne : ((D.δ ^ 2 * P0 : ℝ) : ℂ) ≠ 0 := by
      have : 0 < D.δ ^ 2 * P0 := by positivity
      exact_mod_cast this.ne'
    rw [eq_inv_mul_iff_mul_eq₀ hne, ← hid]
    unfold localProgressionForm gin
    rw [← mul_assoc, ← mul_pow, mul_inv_cancel₀ (by exact_mod_cast hr.ne'), one_pow, one_mul]
    rfl
  -- assemble
  have hsum : ∑ n ∈ D.box I, K n * fastFormAt (D.multWith N w γ σ) n =
      ∫ x, ∑ n ∈ D.box I, K n * ∏ j : Fin 4, G x j (latticeCoord j n)
        ∂(fastHaar.prod fastHaar) := by
    rw [integral_finsetSum _ fun n _ => (hint n).const_mul (K n)]
    refine Finset.sum_congr rfl fun n _ => ?_
    unfold fastFormAt
    rw [integral_const_mul]
  rw [hsum, integral_congr_ae (Filter.Eventually.of_forall hpt), integral_const_mul,
    integral_const_mul]
  push_cast
  field_simp
  have hne : ((D.len I : ℂ) * D.δ) ≠ 0 :=
    mul_ne_zero (by exact_mod_cast hr.ne') (by exact_mod_cast hδ.ne')
  rw [mul_div_mul_left _ _ hne]

theorem round_form_eq (I : ℤ × ℤ) (hI : I ∈ D.cells) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ j, Measurable (f j)) (hL : ∀ j, MemLp (f j) 2 volume) :
    localProgressionForm (D.len I) (roundSampledKernel D.δ (D.kernel I)) f =
      localProgressionForm (D.len I) (D.kernel I) f - D.err2 I f := by
  have hr := D.len_pos I
  have hw := D.admissible I hI
  have hsupp := admissibleLocalKernel_support hr.le hw
  have hwm : Measurable (D.kernel I) := hw.smooth.continuous.measurable
  have hW := admissibleLocalKernel_norm_le hw
  have h1 := progression_integrable hr hsupp hwm hW f hf hL
  have h2 := progression_integrable (by linarith [D.δ_pos] : 0 < D.len I + 6 * D.δ)
    (roundSampled_support D.δ_pos hsupp) (measurable_roundSampledKernel hwm D.δ)
    (W := localKernelSupBound κ) (fun z => hW _) f hf hL
  unfold err2 localProgressionForm
  rw [← mul_sub, ← integral_sub h1 (by
    convert h1.sub h2 using 1; funext z; simp only [Pi.sub_apply]; ring)]
  congr 1
  refine integral_congr_ae (Filter.Eventually.of_forall fun z => ?_)
  simp only; ring

/-- Blueprint lines 2345-2357 (continuous comparison): for every `σ, γ` the lattice sum of the
multiplied slots is at most `(256/|polygon|) ∫_{T₀²}` of the summed absolute forms of the interval
inputs plus their second sampling errors. -/
theorem norm_latticeSum_interval (ε : ℤ × ℤ → Ω → ℂ) (hε1 : ∀ I σ, ‖ε I σ‖ ≤ 1) (N : ℕ)
    (w : Fin 4 → ℤ → ℂ) (γ : ℝ) (σ : Ω) :
    ‖D.latticeSum ε σ (D.multWith N w γ σ)‖ₑ ≤
      ENNReal.ofReal (256 / (volume (offsetPolygon (1 / 8))).toReal) * ∫⁻ x,
        (ENNReal.ofReal (∑ I ∈ D.cells, D.len I *
          ‖localProgressionForm (D.len I) (D.kernel I) (D.gin N w γ σ x)‖) +
        ∑ I ∈ D.cells, ENNReal.ofReal (D.len I) * ‖D.err2 I (D.gin N w γ σ x)‖ₑ)
          ∂(fastHaar.prod fastHaar) := by
  set c := 256 / (volume (offsetPolygon (1 / 8 : ℝ))).toReal
  have hc : 0 ≤ c := by unfold c; positivity
  unfold latticeSum
  have hcell : ∀ I ∈ D.cells, ‖(D.len I : ℂ) * ε I σ * ((D.len I : ℂ)⁻¹ ^ 2 *
      ((D.δ ^ 2 : ℝ) : ℂ) * 256 * ∑ n ∈ D.box I, D.kernel I (D.δ * n.1, D.δ * n.2 - D.δ * n.1) *
        fastFormAt (D.multWith N w γ σ) n)‖ₑ ≤ ENNReal.ofReal c * ∫⁻ x,
          (ENNReal.ofReal (D.len I) * ‖localProgressionForm (D.len I) (D.kernel I)
            (D.gin N w γ σ x)‖ₑ + ENNReal.ofReal (D.len I) * ‖D.err2 I (D.gin N w γ σ x)‖ₑ)
              ∂(fastHaar.prod fastHaar) := by
    intro I hI
    have hr := D.len_pos I
    rw [D.cell_lattice_eq_interval N w γ σ hI, enorm_mul, enorm_mul, enorm_mul]
    have h1 : ‖(D.len I : ℂ)‖ₑ = ENNReal.ofReal (D.len I) := by
      rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg hr.le]
    have h2 : ‖ε I σ‖ₑ ≤ 1 := by
      rw [← ofReal_norm, ← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (hε1 I σ)
    have h3 : ‖((c : ℝ) : ℂ)‖ₑ = ENNReal.ofReal c := by
      rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg hc]
    rw [h1, h3]
    have hint : ∫⁻ x, ‖localProgressionForm (D.len I) (roundSampledKernel D.δ (D.kernel I))
        (D.gin N w γ σ x)‖ₑ ∂(fastHaar.prod fastHaar) ≤ ∫⁻ x,
          (‖localProgressionForm (D.len I) (D.kernel I) (D.gin N w γ σ x)‖ₑ +
            ‖D.err2 I (D.gin N w γ σ x)‖ₑ) ∂(fastHaar.prod fastHaar) := by
      refine lintegral_mono fun x => ?_
      rw [D.round_form_eq I hI _ (D.measurable_gin N w γ σ x) (D.memLp_gin N w γ σ x)]
      exact enorm_sub_le
    calc ENNReal.ofReal (D.len I) * ‖ε I σ‖ₑ * (ENNReal.ofReal c *
          ‖∫ x, localProgressionForm (D.len I) (roundSampledKernel D.δ (D.kernel I))
            (D.gin N w γ σ x) ∂(fastHaar.prod fastHaar)‖ₑ)
        ≤ ENNReal.ofReal (D.len I) * 1 * (ENNReal.ofReal c * ∫⁻ x,
          (‖localProgressionForm (D.len I) (D.kernel I) (D.gin N w γ σ x)‖ₑ +
            ‖D.err2 I (D.gin N w γ σ x)‖ₑ) ∂(fastHaar.prod fastHaar)) := by
          gcongr
          exact (enorm_integral_le_lintegral_enorm _).trans hint
      _ = _ := by
          rw [mul_one, mul_left_comm, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
          congr 1
          refine lintegral_congr fun x => ?_
          ring
  refine (enorm_sum_le _ _).trans ((Finset.sum_le_sum hcell).trans ?_)
  rw [← Finset.mul_sum]
  gcongr
  refine (sum_lintegral_le_lintegral_sum _ _ _).trans (lintegral_mono fun x => ?_)
  rw [Finset.sum_add_distrib]
  gcongr
  rw [ENNReal.ofReal_sum_of_nonneg fun I _ => by have := D.len_pos I; positivity]
  refine le_of_eq (Finset.sum_congr rfl fun I _ => ?_)
  rw [ENNReal.ofReal_mul (D.len_pos I).le, ofReal_norm]

theorem measurable_multWith_joint (N : ℕ) (w : Fin 4 → ℤ → ℂ) (j : Fin 4) (m : ℤ) :
    Measurable fun z : (Ω × ℝ) × FastCircle => D.multWith N w z.1.2 z.1.1 j m z.2 := by
  have h := measurable_multiplied_slotLift (δ := D.δ) D.z_meas j m (Finset.Icc (-(N : ℤ)) N)
    (fastSlotC j) (fun _ m => w j m) (measurable_from_top.comp measurable_snd)
  exact h

/-- The interval-input family of slot `j`, as a function of `y` and the inner variables
`((σ, γ), w)`. -/
noncomputable def ginFam (N : ℕ) (w : Fin 4 → ℤ → ℂ) (j : Fin 4)
    (p : ℝ × ((Ω × ℝ) × FastCircle)) : ℂ :=
  intervalInput D.δ (1 / 8) D.T (fun m => D.multWith N w p.2.1.2 p.2.1.1 j m p.2.2) p.1

theorem measurable_ginFam (N : ℕ) (w : Fin 4 → ℤ → ℂ) (j : Fin 4) :
    Measurable (D.ginFam N w j) := by
  unfold ginFam intervalInput
  refine Finset.measurable_sum _ fun m _ => ?_
  refine ((D.measurable_multWith_joint N w j m).comp measurable_snd).mul ?_
  refine Measurable.ite ?_ measurable_const measurable_const
  exact measurableSet_lt ((measurable_fst.sub_const _).abs) measurable_const

/-- Blueprint `eq:fourth-moment` with the sign moments (lines 2318-2330): the fourth moment of a
weighted multiplied slot over `(σ, γ, w)` is at most `2 |w|⁴ (C₄ e_j(m))⁴`. -/
theorem multWith_fourth (P : Measure Ω) [IsProbabilityMeasure P] {C4 : ℝ}
    (hmom : ∀ j y, (∫⁻ σ, ‖D.z j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ENNReal.ofReal (D.Z j y))
    (N : ℕ) (w : Fin 4 → ℤ → ℂ) (j : Fin 4) (m : ℤ) :
    ∫⁻ z, ‖D.multWith N w z.1.2 z.1.1 j m z.2‖ₑ ^ (4 : ℝ)
      ∂((P.prod gammaMeasure).prod fastHaar) ≤
      2 * ‖w j m‖ₑ ^ 4 * (ENNReal.ofReal C4 * D.ewin j m) ^ (4 : ℝ) := by
  have hm := (D.measurable_multWith_joint N w j m).enorm.pow_const (4 : ℝ)
  rw [lintegral_prod _ hm.aemeasurable]
  rw [lintegral_prod _ (hm.lintegral_prod_right').aemeasurable]
  have hσ : ∀ σ, ∫⁻ γ, ∫⁻ t, ‖D.multWith N w γ σ j m t‖ₑ ^ (4 : ℝ) ∂fastHaar ∂gammaMeasure ≤
      2 * ‖w j m‖ₑ ^ 4 * D.slotMass σ j m ^ (2 : ℝ) := by
    intro σ
    have h4 := lintegral_fastCircle_fourth (Finset.Icc (-(N : ℤ)) N)
      (fun k => w j m * fourierCoeff (slotLift D.δ (D.inp σ) j m) k)
      (fastSlotC_ne_zero j) (fastSlotC_dvd j)
    refine h4.trans ?_
    have hb := fast_bessel_enorm (measurable_slotLift (δ := D.δ) (D.measurable_inp σ) j m)
      (Finset.Icc (-(N : ℤ)) N)
    simp only [norm_mul, mul_pow, ← Finset.mul_sum]
    have hS : 0 ≤ ∑ i ∈ Finset.Icc (-(N : ℤ)) N,
        ‖fourierCoeff (slotLift D.δ (D.inp σ) j m) i‖ ^ 2 :=
      Finset.sum_nonneg fun _ _ => by positivity
    have e1 : ENNReal.ofReal ((‖w j m‖ ^ 2) ^ 2) = ‖w j m‖ₑ ^ 4 := by
      rw [← pow_mul, ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]
    rw [ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_ofNat,
      ENNReal.ofReal_mul (by positivity), e1, ENNReal.ofReal_pow hS, ENNReal.rpow_two,
      mul_assoc]
    gcongr
    exact hb
  calc ∫⁻ σ, ∫⁻ γ, ∫⁻ t, ‖D.multWith N w γ σ j m t‖ₑ ^ (4 : ℝ) ∂fastHaar ∂gammaMeasure ∂P
      ≤ ∫⁻ σ, 2 * ‖w j m‖ₑ ^ 4 * D.slotMass σ j m ^ (2 : ℝ) ∂P := lintegral_mono hσ
    _ = 2 * ‖w j m‖ₑ ^ 4 * ∫⁻ σ, D.slotMass σ j m ^ (2 : ℝ) ∂P :=
        lintegral_const_mul' _ _ (by simp [ENNReal.mul_eq_top])
    _ ≤ _ := by
        gcongr
        have := ENNReal.rpow_le_rpow (D.slotMass_moment P hmom j m) (by norm_num : (0 : ℝ) ≤ 4)
        rwa [← ENNReal.rpow_mul, show (1 / 4 : ℝ) * 4 = 1 by norm_num, ENNReal.rpow_one] at this

open TrilinearHT.Auto.ClassicalMaximal in
/-- Blueprint lines 2362-2364 for the comparison inputs:
`‖g_j‖^p_{L^p_y L⁴} = Σ_m 2cδ (E ∫ |G_j(m)|⁴)^{p/4} ≤ Σ_m (δ/4) (2 |w|⁴ (C₄ e_j(m))⁴)^{p/4}`. -/
theorem mixed_ginFam_pow (P : Measure Ω) [IsProbabilityMeasure P] {C4 : ℝ}
    (hmom : ∀ j y, (∫⁻ σ, ‖D.z j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ENNReal.ofReal (D.Z j y))
    (N : ℕ) (w : Fin 4 → ℤ → ℂ) (j : Fin 4) {p : ℝ} (hp : 0 < p) :
    mixedENorm volume ((P.prod gammaMeasure).prod fastHaar) p 4
      (fun z => ‖D.ginFam N w j z‖ₑ) ^ p ≤ ∑ m ∈ D.T, ENNReal.ofReal (D.δ / 4) *
        (2 * ‖w j m‖ₑ ^ 4 * (ENNReal.ofReal C4 * D.ewin j m) ^ (4 : ℝ)) ^ (p / 4) := by
  have h := mixedENorm_fastIntervalInput_pow ((P.prod gammaMeasure).prod fastHaar) D.δ_pos
    (by norm_num : (1 / 8 : ℝ) ≤ 1 / 2) D.T
    (fun m z => D.multWith N w z.1.2 z.1.1 j m z.2) hp
  have e : (fun z => ‖D.ginFam N w j z‖ₑ) = fun z => ‖fastIntervalInput D.δ (1 / 8) D.T
      (fun m z => D.multWith N w z.1.2 z.1.1 j m z.2) z‖ₑ := rfl
  rw [e, h]
  refine Finset.sum_le_sum fun m _ => ?_
  rw [show 2 * (1 / 8 * D.δ) = D.δ / 4 by ring]
  gcongr
  exact D.multWith_fourth P hmom N w j m

open TrilinearHT.Auto.ClassicalMaximal in
/-- Blueprint lines 2355-2364 (the main term): `eq:CN` for the interval inputs at every fast and
random parameter, Tonelli, one Hölder inequality of exponent four in `(γ, σ, u, v)` and spatial
Hölder, and the mixed maximal estimate `eq:mixed-Mq` give
`E ∫∫ Σ_I |I| |H_I(g)| ≤ C_N Π_j C_j ‖g_j‖_{L^{p_j}_y L⁴}`. -/
theorem main_bound (P : Measure Ω) [IsProbabilityMeasure P] {q : ℝ} (hq : 2 ≤ q) {Nd : ℕ}
    (first : ℤ) (hdepth : ∀ I ∈ D.cells, first ≤ I.1 ∧ I.1 < first + Nd) (N : ℕ)
    (w : Fin 4 → ℤ → ℂ) (p : Fin 4 → ℝ) (hp : ∀ j, 0 < p j) (hsum : ∑ j, 1 / p j = 1)
    (Cm : Fin 4 → ℝ≥0∞)
    (hCm : ∀ j, ∀ f : ℝ × ((Ω × ℝ) × FastCircle) → ℂ, Measurable f →
      mixedENorm volume ((P.prod gammaMeasure).prod fastHaar) (p j) 4 (maximalQ q f) ≤
        Cm j * mixedENorm volume ((P.prod gammaMeasure).prod fastHaar) (p j) 4
          (fun z => ‖f z‖ₑ)) :
    ∫⁻ σ, ∫⁻ γ, ∫⁻ x, ENNReal.ofReal (∑ I ∈ D.cells, D.len I *
      ‖localProgressionForm (D.len I) (D.kernel I) (D.gin N w γ σ x)‖)
        ∂(fastHaar.prod fastHaar) ∂gammaMeasure ∂P ≤
      ENNReal.ofReal (finiteDepthConstant κ q Nd) * ∏ j, (Cm j *
        mixedENorm volume ((P.prod gammaMeasure).prod fastHaar) (p j) 4
          (fun z => ‖D.ginFam N w j z‖ₑ)) := by
  set h : Fin 4 → ℝ × ((Ω × ℝ) × FastCircle) → ℝ≥0∞ := fun j => maximalQ q (D.ginFam N w j)
  have hh : ∀ j, Measurable (h j) := fun j => measurable_maximalQ q (D.measurable_ginFam N w j)
  set F : ((Ω × ℝ) × (FastCircle × FastCircle)) × ℝ → ℝ≥0∞ := fun p =>
    ∏ j, h j (p.2, (p.1.1, fastCoord j p.1.2))
  have hF : Measurable F := Finset.measurable_prod _ fun j _ => (hh j).comp
    (measurable_snd.prodMk ((measurable_fst.comp measurable_fst).prodMk
      ((continuous_fastCoord _).measurable.comp (measurable_snd.comp measurable_fst))))
  -- pointwise `eq:CN`
  have hpt : ∀ σ γ x, ENNReal.ofReal (∑ I ∈ D.cells, D.len I *
      ‖localProgressionForm (D.len I) (D.kernel I) (D.gin N w γ σ x)‖) ≤
      ENNReal.ofReal (finiteDepthConstant κ q Nd) * ∫⁻ y, F (((σ, γ), x), y) := by
    intro σ γ x
    exact cn_interval_inputs hq D.grid D.cells first hdepth D.kernel D.admissible D.δ (1 / 8)
      (fun _ => D.T) (fun j m => D.multWith N w γ σ j m (fastCoord j x))
  calc ∫⁻ σ, ∫⁻ γ, ∫⁻ x, ENNReal.ofReal (∑ I ∈ D.cells, D.len I *
        ‖localProgressionForm (D.len I) (D.kernel I) (D.gin N w γ σ x)‖)
          ∂(fastHaar.prod fastHaar) ∂gammaMeasure ∂P
      ≤ ∫⁻ σ, ∫⁻ γ, ∫⁻ x, ENNReal.ofReal (finiteDepthConstant κ q Nd) *
          (∫⁻ y, F (((σ, γ), x), y)) ∂(fastHaar.prod fastHaar) ∂gammaMeasure ∂P :=
        lintegral_mono fun σ => lintegral_mono fun γ => lintegral_mono fun x => hpt σ γ x
    _ = ENNReal.ofReal (finiteDepthConstant κ q Nd) *
          ∫⁻ y, ∫⁻ r, F (r, y) ∂((P.prod gammaMeasure).prod (fastHaar.prod fastHaar)) := by
        have hG : Measurable fun r : (Ω × ℝ) × (FastCircle × FastCircle) => ∫⁻ y, F (r, y) :=
          hF.lintegral_prod_right'
        have hFs : AEMeasurable (Function.uncurry fun (y : ℝ) (r : (Ω × ℝ) ×
            (FastCircle × FastCircle)) => F (r, y))
            ((volume : Measure ℝ).prod ((P.prod gammaMeasure).prod (fastHaar.prod fastHaar))) :=
          (hF.comp measurable_swap).aemeasurable
        symm
        rw [lintegral_lintegral_swap hFs, lintegral_prod _ hG.aemeasurable,
          lintegral_prod _ (hG.lintegral_prod_right').aemeasurable,
          ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
        refine lintegral_congr fun σ => ?_
        rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
        refine lintegral_congr fun γ => ?_
        rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    _ ≤ ENNReal.ofReal (finiteDepthConstant κ q Nd) *
          ∏ j, mixedENorm volume ((P.prod gammaMeasure).prod fastHaar) (p j) 4 (h j) := by
        gcongr
        exact mixed_holder_four (P.prod gammaMeasure) h hh p hp hsum
    _ ≤ _ := by
        gcongr with j
        exact hCm j _ (D.measurable_ginFam N w j)

end BlockData

open Classical in
/-- The squared local `L²` mass of an interval input on a set `J`:
`∫_J |g|² ≤ Σ_{m : interval meets J} 2cδ |G(m)|²` for `c ≤ 1/2`. -/
theorem lintegral_intervalInput_sq_le {δ c : ℝ} (hδ : 0 < δ) (hc2 : c ≤ 1 / 2)
    (T : Finset ℤ) (G : ℤ → ℂ) (J : Set ℝ) (hJ : MeasurableSet J) :
    ∫⁻ y in J, ‖intervalInput δ c T G y‖ₑ ^ (2 : ℝ) ≤
      ∑ m ∈ T.filter (fun m : ℤ => (Metric.ball (δ * (m : ℝ)) (c * δ) ∩ J).Nonempty),
        ENNReal.ofReal (2 * (c * δ)) * ‖G m‖ₑ ^ (2 : ℝ) := by
  classical
  set TJ := T.filter (fun m : ℤ => (Metric.ball (δ * (m : ℝ)) (c * δ) ∩ J).Nonempty)
  have hpt : ∀ y ∈ J, ‖intervalInput δ c T G y‖ₑ ^ (2 : ℝ) ≤
      ∑ m ∈ TJ, (Metric.ball (δ * m) (c * δ)).indicator (fun _ => ‖G m‖ₑ ^ (2 : ℝ)) y := by
    intro y hy
    by_cases hex : ∃ m ∈ T, |y - δ * m| < c * δ
    · obtain ⟨m, hmT, hm⟩ := hex
      have hball : y ∈ Metric.ball (δ * m) (c * δ) := by
        rw [Metric.mem_ball, Real.dist_eq]; exact hm
      have hmTJ : m ∈ TJ := Finset.mem_filter.mpr ⟨hmT, ⟨y, hball, hy⟩⟩
      have hg : intervalInput δ c T G y = G m := by
        unfold intervalInput
        rw [Finset.sum_eq_single m]
        · simp only [hm, ↓reduceIte, mul_one]
        · intro n _ hnm
          have : ¬ |y - δ * n| < c * δ := fun hn => hnm (interval_unique hδ hc2 hn hm)
          simp only [this, ↓reduceIte, mul_zero]
        · intro h; exact absurd hmT h
      rw [hg]
      refine le_trans (le_of_eq ?_) (Finset.single_le_sum (f := fun n : ℤ =>
        (Metric.ball (δ * (n : ℝ)) (c * δ)).indicator (fun _ => ‖G n‖ₑ ^ (2 : ℝ)) y)
        (fun _ _ => zero_le) hmTJ)
      rw [Set.indicator_of_mem hball]
    · push Not at hex
      have hg : intervalInput δ c T G y = 0 := by
        unfold intervalInput
        exact Finset.sum_eq_zero fun n hn => by
          simp only [not_lt.mpr (hex n hn), ↓reduceIte, mul_zero]
      rw [hg, enorm_zero, ENNReal.zero_rpow_of_pos (by norm_num)]
      exact zero_le
  calc ∫⁻ y in J, ‖intervalInput δ c T G y‖ₑ ^ (2 : ℝ)
      ≤ ∫⁻ y in J, ∑ m ∈ TJ, (Metric.ball (δ * m) (c * δ)).indicator
          (fun _ => ‖G m‖ₑ ^ (2 : ℝ)) y := setLIntegral_mono' hJ hpt
    _ ≤ ∫⁻ y, ∑ m ∈ TJ, (Metric.ball (δ * m) (c * δ)).indicator
          (fun _ => ‖G m‖ₑ ^ (2 : ℝ)) y := setLIntegral_le_lintegral _ _
    _ = ∑ m ∈ TJ, ENNReal.ofReal (2 * (c * δ)) * ‖G m‖ₑ ^ (2 : ℝ) := by
        rw [lintegral_finsetSum _ fun m _ => measurable_const.indicator measurableSet_ball]
        refine Finset.sum_congr rfl fun m _ => ?_
        rw [lintegral_indicator_const measurableSet_ball, Real.volume_ball, mul_comm]

open Classical in
/-- The normalized local `L²` norm of a localized interval input. -/
theorem eLpNorm_indicator_intervalInput_le {δ c a r : ℝ} (hδ : 0 < δ) (hc2 : c ≤ 1 / 2)
    (T : Finset ℤ) (G : ℤ → ℂ) (J : Set ℝ) (hJ : MeasurableSet J) :
    eLpNorm (J.indicator (intervalInput δ c T G)) 2 (normalizedIntervalMeasure a r) ≤
      (ENNReal.ofReal r⁻¹ * ∑ m ∈ T.filter
        (fun m : ℤ => (Metric.ball (δ * (m : ℝ)) (c * δ) ∩ J).Nonempty),
          ENNReal.ofReal (2 * (c * δ)) * ‖G m‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ) := by
  have hm : Measurable (J.indicator (intervalInput δ c T G)) :=
    (measurable_intervalInput δ c T G).indicator hJ
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num) hm.aestronglyMeasurable]
  simp only [ENNReal.toReal_ofNat]
  gcongr
  unfold normalizedIntervalMeasure
  rw [lintegral_smul_measure, smul_eq_mul]
  gcongr
  calc ∫⁻ y in Set.Icc a (a + r), ‖J.indicator (intervalInput δ c T G) y‖ₑ ^ (2 : ℝ)
      ≤ ∫⁻ y, ‖J.indicator (intervalInput δ c T G) y‖ₑ ^ (2 : ℝ) :=
        setLIntegral_le_lintegral _ _
    _ = ∫⁻ y in J, ‖intervalInput δ c T G y‖ₑ ^ (2 : ℝ) := by
        rw [← lintegral_indicator hJ]
        refine lintegral_congr fun y => ?_
        by_cases hy : y ∈ J
        · simp [hy]
        · simp [hy]
    _ ≤ _ := lintegral_intervalInput_sq_le hδ hc2 T G J hJ

/-- Minkowski's inequality in `L²` for finite sums of nonnegative functions. -/
theorem lintegral_finset_sum_sq_le {α ι : Type*} [MeasurableSpace α] (μ : Measure α)
    (s : Finset ι) (f : ι → α → ℝ≥0∞) (hf : ∀ i, AEMeasurable (f i) μ) :
    (∫⁻ x, (∑ i ∈ s, f i x) ^ (2 : ℝ) ∂μ) ^ (1 / 2 : ℝ) ≤
      ∑ i ∈ s, (∫⁻ x, f i x ^ (2 : ℝ) ∂μ) ^ (1 / 2 : ℝ) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    rw [lintegral_congr fun x => ENNReal.zero_rpow_of_pos (by norm_num), lintegral_zero,
      ENNReal.zero_rpow_of_pos (by norm_num)]
  | insert i s hi ih =>
    simp_rw [Finset.sum_insert hi]
    have hs : AEMeasurable (fun x => ∑ k ∈ s, f k x) μ :=
      Finset.aemeasurable_fun_sum _ fun k _ => hf k
    have h := ENNReal.lintegral_Lp_add_le (hf i) hs (by norm_num : (1 : ℝ) ≤ 2)
    exact h.trans (add_le_add le_rfl ih)

namespace BlockData
variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

/-- The localization interval of the second sampling error at a cell. -/
noncomputable def J (I : ℤ × ℤ) : Set ℝ :=
  Set.Icc (D.left I + κ.margin * D.len I - 3 * D.δ) (D.left I + D.len I - κ.margin * D.len I +
    3 * D.δ)

theorem err2_support {I : ℤ × ℤ} (hI : I ∈ D.cells) (z : ℝ × ℝ)
    (hz : D.kernel I z - roundSampledKernel D.δ (D.kernel I) z ≠ 0) (j : Fin 4) :
    realProgressionCoordinate j z ∈ D.J I := by
  have hw := D.admissible I hI
  have hδ := D.δ_pos
  have hsupp : HasLocalProgressionSupport (D.left I + κ.margin * D.len I)
      (D.len I - 2 * (κ.margin * D.len I)) (D.kernel I) := by
    intro z' hz' j'
    have := hw.support z' hz' j'
    rw [Set.mem_Icc]
    unfold left len
    constructor <;> linarith [this.1, this.2]
  by_cases h1 : D.kernel I z = 0
  · rw [h1, zero_sub, neg_ne_zero] at hz
    have h := roundSampled_support hδ hsupp z hz j
    simp only [J, Set.mem_Icc] at h ⊢
    constructor <;> linarith [h.1, h.2]
  · have h := hsupp z h1 j
    simp only [J, Set.mem_Icc] at h ⊢
    constructor <;> linarith [h.1, h.2]

/-- The second sampling error only sees the inputs on `J_I`. -/
theorem err2_local {I : ℤ × ℤ} (hI : I ∈ D.cells) (f : Fin 4 → ℝ → ℂ) :
    D.err2 I f = D.err2 I (fun j => (D.J I).indicator (f j)) := by
  unfold err2
  refine localProgressionForm_congr_support fun z hz j => ?_
  rw [Set.indicator_of_mem (D.err2_support hI z hz j)]

open Classical in
/-- The slow points whose intervals meet `J_I`. -/
noncomputable def TJ (I : ℤ × ℤ) : Finset ℤ :=
  D.T.filter (fun m : ℤ => (Metric.ball (D.δ * (m : ℝ)) (1 / 8 * D.δ) ∩ D.J I).Nonempty)

/-- The windows of the slow points meeting `J_I` lie in the cell. -/
theorem TJ_window_subset {I : ℤ × ℤ} (hI : I ∈ D.cells) {m : ℤ} (hm : m ∈ D.TJ I)
    (j : Fin 4) : D.window j m ⊆ Set.Icc (D.left I) (D.left I + D.len I) := by
  classical
  obtain ⟨-, y, hy1, hy2⟩ := Finset.mem_filter.mp hm
  intro x hx
  have hδ : 8 * D.δ ≤ κ.margin * D.len I := D.δ_small I hI
  have hδ0 := D.δ_pos
  have hl := fastLiftLeft_bounds j
  have hr := fastLift_right_le j
  rw [Metric.mem_ball, Real.dist_eq, abs_lt] at hy1
  simp only [J, Set.mem_Icc] at hy2
  simp only [window, Set.mem_Ico] at hx
  have e1 : D.δ * (m + fastLiftLeft j + fastLiftLen j) ≤ D.δ * m + 4 * D.δ := by
    nlinarith only [hδ0, hr]
  have e2 : D.δ * m - 4 * D.δ ≤ D.δ * (m + fastLiftLeft j) := by nlinarith
  constructor <;> nlinarith only [hx.1, hx.2, hy1.1, hy1.2, hy2.1, hy2.2, hδ, e2, hr]

/-- The weighted cell sum of `eq:shortblock` (lines 2309-2312): with local masses `Y_j(I)` at
most the total masses `m_j` on each depth and `Σ_s δ / r_s ≤ 1`,
`Σ_I (δ / r_I) Y_a(I)^{1/2} Y_b(I)^{1/2} ≤ m_a^{1/2} m_b^{1/2}`. -/
theorem sum_cells_ab_le (a b : Fin 4) (m : Fin 4 → ℝ)
    (hm : ∀ j, ∫⁻ y, ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) ≤ ENNReal.ofReal (m j))
    (hw : ∑ s ∈ D.cells.image Prod.fst, D.δ / dyadicGridLength D.grid s ≤ 1) :
    ∑ I ∈ D.cells, ENNReal.ofReal (D.δ / D.len I) *
      ((∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I), ENNReal.ofReal (D.Z a y) ^ (2 : ℝ)) ^
        (1 / 2 : ℝ) * (∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
          ENNReal.ofReal (D.Z b y) ^ (2 : ℝ)) ^ (1 / 2 : ℝ)) ≤
      ENNReal.ofReal (m a) ^ (1 / 2 : ℝ) * ENNReal.ofReal (m b) ^ (1 / 2 : ℝ) := by
  classical
  set Y : Fin 4 → ℤ × ℤ → ℝ≥0∞ := fun j I => ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
    ENNReal.ofReal (D.Z j y) ^ (2 : ℝ)
  change ∑ I ∈ D.cells, ENNReal.ofReal (D.δ / D.len I) * (Y a I ^ (1 / 2 : ℝ) *
    Y b I ^ (1 / 2 : ℝ)) ≤ _
  rw [← Finset.sum_fiberwise_of_maps_to (g := Prod.fst) (t := D.cells.image Prod.fst)
    (fun I hI => Finset.mem_image_of_mem _ hI)]
  have hdepth : ∀ s ∈ D.cells.image Prod.fst, ∑ I ∈ D.cells with I.1 = s,
      ENNReal.ofReal (D.δ / D.len I) * (Y a I ^ (1 / 2 : ℝ) * Y b I ^ (1 / 2 : ℝ)) ≤
      ENNReal.ofReal (D.δ / dyadicGridLength D.grid s) * (ENNReal.ofReal (m a) ^ (1 / 2 : ℝ) *
        ENNReal.ofReal (m b) ^ (1 / 2 : ℝ)) := by
    intro s _
    have hl : ∀ I ∈ D.cells.filter (fun I => I.1 = s),
        ENNReal.ofReal (D.δ / D.len I) = ENNReal.ofReal (D.δ / dyadicGridLength D.grid s) :=
      fun I hI => by rw [show D.len I = dyadicGridLength D.grid s by
        unfold len; rw [(Finset.mem_filter.mp hI).2]]
    rw [Finset.sum_congr rfl fun I hI => by rw [hl I hI], ← Finset.mul_sum]
    gcongr
    refine (ENNReal.inner_le_Lp_mul_Lq (D.cells.filter fun I => I.1 = s)
      (fun I => Y a I ^ (1 / 2 : ℝ)) (fun I => Y b I ^ (1 / 2 : ℝ))
        Real.HolderConjugate.two_two).trans ?_
    have hsq : ∀ j, ∑ I ∈ D.cells with I.1 = s, (Y j I ^ (1 / 2 : ℝ)) ^ (2 : ℝ) ≤
        ENNReal.ofReal (m j) := by
      intro j
      simp_rw [← ENNReal.rpow_mul]
      norm_num
      exact (D.sum_depth_le s _).trans (hm j)
    gcongr
    · exact hsq a
    · exact hsq b
  refine (Finset.sum_le_sum hdepth).trans ?_
  rw [← Finset.sum_mul]
  calc (∑ s ∈ D.cells.image Prod.fst, ENNReal.ofReal (D.δ / dyadicGridLength D.grid s)) *
        (ENNReal.ofReal (m a) ^ (1 / 2 : ℝ) * ENNReal.ofReal (m b) ^ (1 / 2 : ℝ))
      ≤ 1 * (ENNReal.ofReal (m a) ^ (1 / 2 : ℝ) * ENNReal.ofReal (m b) ^ (1 / 2 : ℝ)) := by
        gcongr
        rw [← ENNReal.ofReal_sum_of_nonneg fun s _ => by
          have := D.δ_pos; have := dyadicGridLength_pos D.grid s; positivity]
        exact ENNReal.ofReal_le_one.mpr hw
    _ = _ := one_mul _

/-- The localized squared masses of the comparison inputs at a cell. -/
noncomputable def locMass (N : ℕ) (w : Fin 4 → ℤ → ℂ) (I : ℤ × ℤ) (j : Fin 4)
    (z : (Ω × ℝ) × FastCircle) : ℝ≥0∞ :=
  ENNReal.ofReal (D.len I)⁻¹ * ∑ m ∈ D.TJ I, ENNReal.ofReal (D.δ / 4) *
    ‖D.multWith N w z.1.2 z.1.1 j m z.2‖ₑ ^ (2 : ℝ)

theorem measurable_locMass (N : ℕ) (w : Fin 4 → ℤ → ℂ) (I : ℤ × ℤ) (j : Fin 4) :
    Measurable (D.locMass N w I j) := by
  unfold locMass
  exact measurable_const.mul (Finset.measurable_sum _ fun m _ => measurable_const.mul
    ((D.measurable_multWith_joint N w j m).enorm.pow_const _))

/-- Pointwise second sampling error: `‖H_I^{err}(g)‖ ≤ 4 C_κ (δ / r) Π_j X_j^{1/2}`. -/
theorem err2_pointwise {I : ℤ × ℤ} (hI : I ∈ D.cells) (N : ℕ) (w : Fin 4 → ℤ → ℂ) (γ : ℝ)
    (σ : Ω) (x : FastCircle × FastCircle) :
    ‖D.err2 I (D.gin N w γ σ x)‖ₑ ≤ ENNReal.ofReal (4 * admissibleLipConst κ * (D.δ / D.len I)) *
      ∏ j, D.locMass N w I j ((σ, γ), fastCoord j x) ^ (1 / 2 : ℝ) := by
  classical
  have hδr : 5 * D.δ ≤ κ.margin * D.len I := by
    have := D.δ_small I hI; have := D.δ_pos; unfold len; linarith
  rw [D.err2_local hI]
  have hJ : MeasurableSet (D.J I) := measurableSet_Icc
  refine (roundSampled_form_error (D.len_pos I) (D.admissible I hI) D.δ_pos hδr _
    (fun j => (D.measurable_gin N w γ σ x j).indicator hJ) (fun _ => 2) (fun _ => by norm_num)
    (by norm_num)).trans ?_
  gcongr with j
  refine (eLpNorm_indicator_intervalInput_le D.δ_pos (by norm_num) D.T _ (D.J I) hJ).trans
    (le_of_eq ?_)
  unfold locMass TJ
  congr 2
  refine Finset.sum_congr rfl fun m _ => ?_
  congr 1
  rw [show 2 * (1 / 8 * D.δ) = D.δ / 4 by ring]

/-- The window sum over slow points with windows in the cell. -/
theorem sum_ewin_sq_le_of {I : ℤ × ℤ} (j : Fin 4) (S : Finset ℤ)
    (hS : ∀ m ∈ S, D.window j m ⊆ Set.Icc (D.left I) (D.left I + D.len I)) :
    ∑ m ∈ S, D.ewin j m ^ (2 : ℝ) ≤ (ENNReal.ofReal (16 * D.δ))⁻¹ * 8 *
      ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I), ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) := by
  simp_rw [D.ewin_sq]
  rw [← Finset.mul_sum, mul_assoc]
  gcongr
  refine (window_sum_le_of_subset D.δ_pos j _ S _ measurableSet_Icc hS).trans ?_
  gcongr
  unfold fastLiftLenNat; split_ifs <;> norm_num

/-- The `L²` size of the localized masses: `(E ∫ X_j²)^{1/2} ≤ K r⁻¹ ∫_I Z_j²`. -/
theorem locMass_L2 (P : Measure Ω) [IsProbabilityMeasure P] {C4 : ℝ}
    (hmom : ∀ j y, (∫⁻ σ, ‖D.z j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ENNReal.ofReal (D.Z j y))
    (N : ℕ) (w : Fin 4 → ℤ → ℂ) (hw : ∀ j m, ‖w j m‖ₑ ≤ 1) {I : ℤ × ℤ} (hI : I ∈ D.cells)
    (j : Fin 4) :
    (∫⁻ z, D.locMass N w I j z ^ (2 : ℝ) ∂((P.prod gammaMeasure).prod fastHaar)) ^ (1 / 2 : ℝ) ≤
      ENNReal.ofReal (D.len I)⁻¹ * err2Const C4 * ∫⁻ y in Set.Icc (D.left I)
        (D.left I + D.len I), ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) := by
  set ν := (P.prod gammaMeasure).prod fastHaar
  have hδ := D.δ_pos
  have hGm : ∀ m, Measurable fun z : (Ω × ℝ) × FastCircle =>
      ENNReal.ofReal (D.δ / 4) * ‖D.multWith N w z.1.2 z.1.1 j m z.2‖ₑ ^ (2 : ℝ) := fun m =>
    measurable_const.mul ((D.measurable_multWith_joint N w j m).enorm.pow_const _)
  have hsplit : ∀ z, D.locMass N w I j z ^ (2 : ℝ) = ENNReal.ofReal (D.len I)⁻¹ ^ (2 : ℝ) *
      (∑ m ∈ D.TJ I, ENNReal.ofReal (D.δ / 4) *
        ‖D.multWith N w z.1.2 z.1.1 j m z.2‖ₑ ^ (2 : ℝ)) ^ (2 : ℝ) := fun z => by
    unfold locMass; rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
  simp_rw [hsplit]
  rw [lintegral_const_mul' _ _ (by simp), ENNReal.mul_rpow_of_nonneg _ _ (by norm_num),
    ← ENNReal.rpow_mul, show (2 : ℝ) * (1 / 2) = 1 by norm_num, ENNReal.rpow_one, mul_assoc]
  gcongr
  refine (lintegral_finset_sum_sq_le ν (D.TJ I) _ fun m => (hGm m).aemeasurable).trans ?_
  have hterm : ∀ m ∈ D.TJ I, (∫⁻ z, (ENNReal.ofReal (D.δ / 4) *
      ‖D.multWith N w z.1.2 z.1.1 j m z.2‖ₑ ^ (2 : ℝ)) ^ (2 : ℝ) ∂ν) ^ (1 / 2 : ℝ) ≤
      ENNReal.ofReal (D.δ / 4) * ((2 : ℝ≥0∞) ^ (1 / 2 : ℝ) * ENNReal.ofReal C4 ^ 2 *
        D.ewin j m ^ (2 : ℝ)) := by
    intro m _
    have e1 : ∀ z : (Ω × ℝ) × FastCircle, (ENNReal.ofReal (D.δ / 4) *
        ‖D.multWith N w z.1.2 z.1.1 j m z.2‖ₑ ^ (2 : ℝ)) ^ (2 : ℝ) =
        ENNReal.ofReal (D.δ / 4) ^ (2 : ℝ) * ‖D.multWith N w z.1.2 z.1.1 j m z.2‖ₑ ^ (4 : ℝ) := by
      intro z
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul]
      norm_num
    rw [lintegral_congr e1, lintegral_const_mul' _ _ (by simp),
      ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul,
      show (2 : ℝ) * (1 / 2) = 1 by norm_num, ENNReal.rpow_one]
    gcongr
    have h4 := D.multWith_fourth P hmom N w j m
    have hw4 : ‖w j m‖ₑ ^ 4 ≤ 1 := pow_le_one₀ zero_le (hw j m)
    calc (∫⁻ z, ‖D.multWith N w z.1.2 z.1.1 j m z.2‖ₑ ^ (4 : ℝ) ∂ν) ^ (1 / 2 : ℝ)
        ≤ (2 * (ENNReal.ofReal C4 * D.ewin j m) ^ (4 : ℝ)) ^ (1 / 2 : ℝ) := by
          gcongr

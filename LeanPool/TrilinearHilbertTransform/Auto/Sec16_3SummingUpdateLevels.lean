/-- Blueprint line 2985: the three-term telescoping product identity. -/
theorem three_term_telescope {R : Type*} [CommRing R] (a₁ a₂ a₃ b₁ b₂ b₃ : R) :
    a₁ * a₂ * a₃ - b₁ * b₂ * b₃ =
      (a₁ - b₁) * a₂ * a₃ + b₁ * (a₂ - b₂) * a₃ + b₁ * b₂ * (a₃ - b₃) := by
  ring


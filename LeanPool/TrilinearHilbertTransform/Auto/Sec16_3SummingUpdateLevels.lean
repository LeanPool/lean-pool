theorem tht_main :
    ∃ C : ℝ, 0 ≤ C ∧
      (∀ f₁ f₂ f₃ : SchwartzMap ℝ ℂ,
        (∀ x, Filter.Tendsto (TrilinearHT.T_trunc ![⇑f₁, ⇑f₂, ⇑f₃] x)

theorem normalizedAbsorption_of_activeFinal (κ : LocalKernelClass) (hAF : ActiveFinal κ) :
    ∃ q : ℝ, 2 < q ∧ q < 3 ∧ ∀ c : ℝ, 0 < c → ∃ A : ℝ, 0 ≤ A ∧

      (p := fun _ => 1 / 3) (by simp) (fun _ _ => by norm_num)
    refine le_trans (le_of_eq ?_) h
    congr 1; funext x
    apply Finset.prod_congr rfl; intro j _
    rw [← ENNReal.rpow_mul]; norm_num
  have hpow : ∀ j, ∫⁻ x, g j x ^ (3 : ℝ) ≤
      2 ^ (3 / q) * (K ^ (3 / q) * ∫⁻ x, ‖f j.succ x‖ₑ ^ (3 : ℝ)) := by
    intro j
    have e : ∀ x, g j x ^ (3 : ℝ) =

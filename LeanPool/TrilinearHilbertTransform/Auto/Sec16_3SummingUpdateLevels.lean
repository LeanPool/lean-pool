`(P(x,t) - P(x,-t))/t` are integrable on `ℝ²`. -/
theorem progression_odd_quotient_integrable (f : Fin 4 → ℝ → ℂ) (hf0m : Measurable (f 0))
    {M T : ℝ} (hfb : ∀ i x, ‖f i x‖ ≤ M) (hf0 : ∀ x, T < |x| → f 0 x = 0)
    (hfd : ∀ j : Fin 3, Differentiable ℝ (f j.succ))
    (hfd' : ∀ j : Fin 3, ∀ x, ‖deriv (f j.succ) x‖ ≤ M) (hf1 : Integrable (f 1)) :
    Integrable (fun z : ℝ × ℝ => ∏ j, f j (realProgressionCoordinate j z)) ∧
      Integrable fun z : ℝ × ℝ => (∏ j, f j (realProgressionCoordinate j z) -
        ∏ j, f j (realProgressionCoordinate j (z.1, -z.2))) / (z.2 : ℂ) := by
  have hM : 0 ≤ M := (norm_nonneg _).trans (hfb 0 0)
  have hc : ∀ j : Fin 3, Continuous (f j.succ) := fun j => (hfd j).continuous
  have hfm : ∀ i, Measurable (f i) := fun i => by
    refine Fin.cases hf0m (fun j => (hc j).measurable) i
  set G : ℝ → ℝ → ℂ := fun x t => f 1 (x + t) * f 2 (x + 2 * t) * f 3 (x + 3 * t)
  have hP : ∀ z : ℝ × ℝ, ∏ j, f j (realProgressionCoordinate j z) = f 0 z.1 * G z.1 z.2 := by
    intro z
    simp only [Fin.prod_univ_four, realProgressionCoordinate, G]
    norm_num; ring
  set ind : ℝ → ℝ := (Set.Icc (-T) T).indicator (fun _ => (1 : ℝ))
  have hf0ind : ∀ x, ‖f 0 x‖ ≤ M * ind x := by
    intro x
    by_cases hx : x ∈ Set.Icc (-T) T
    · simp only [ind, Set.indicator_of_mem hx, mul_one]; exact hfb 0 x
    · have : T < |x| := by
        simp only [Set.mem_Icc, not_and_or, not_le] at hx
        rcases hx with h | h
        · exact lt_abs.mpr (Or.inr (by linarith))
        · exact lt_abs.mpr (Or.inl h)
      simp [ind, Set.indicator_of_notMem hx, hf0 x this]
  have hind0 : ∀ x, 0 ≤ ind x := fun x => Set.indicator_nonneg (fun _ _ => zero_le_one) x
  have hG : ∀ x t, ‖G x t‖ ≤ M ^ 2 * ‖f 1 (x + t)‖ := by
    intro x t
    simp only [G, norm_mul]
    have := hfb 2 (x + 2 * t); have := hfb 3 (x + 3 * t)
    calc ‖f 1 (x + t)‖ * ‖f 2 (x + 2 * t)‖ * ‖f 3 (x + 3 * t)‖ ≤ ‖f 1 (x + t)‖ * M * M := by
          gcongr
      _ = _ := by ring
  have hlip : ∀ j : Fin 3, ∀ a b, ‖f j.succ a - f j.succ b‖ ≤ M * |a - b| := by
    intro j a b
    have := (convex_univ (𝕜 := ℝ) (E := ℝ)).norm_image_sub_le_of_norm_deriv_le
      (f := f j.succ) (fun x _ => (hfd j x)) (fun x _ => hfd' j x) (Set.mem_univ b)
      (Set.mem_univ a)
    rwa [Real.norm_eq_abs] at this
  have hodd : ∀ x t, ‖G x t - G x (-t)‖ ≤ 12 * M ^ 3 * |t| := by
    intro x t
    simp only [G]
    rw [three_term_telescope]
    have l1 : ‖f 1 (x + t) - f 1 (x + -t)‖ ≤ M * |x + t - (x + -t)| := hlip 0 _ _
    have l2 : ‖f 2 (x + 2 * t) - f 2 (x + 2 * -t)‖ ≤ M * |x + 2 * t - (x + 2 * -t)| :=
      hlip 1 _ _
    have l3 : ‖f 3 (x + 3 * t) - f 3 (x + 3 * -t)‖ ≤ M * |x + 3 * t - (x + 3 * -t)| :=
      hlip 2 _ _
    have e1 : |x + t - (x + -t)| = 2 * |t| := by
      rw [show x + t - (x + -t) = 2 * t by ring, abs_mul]; norm_num
    have e2 : |x + 2 * t - (x + 2 * -t)| = 4 * |t| := by
      rw [show x + 2 * t - (x + 2 * -t) = 4 * t by ring, abs_mul]; norm_num
    have e3 : |x + 3 * t - (x + 3 * -t)| = 6 * |t| := by
      rw [show x + 3 * t - (x + 3 * -t) = 6 * t by ring, abs_mul]; norm_num
    rw [e1] at l1; rw [e2] at l2; rw [e3] at l3
    have b1 := hfb 1 (x + -t); have b2 := hfb 2 (x + 2 * t); have b3 := hfb 3 (x + 3 * t)
    have b2' := hfb 2 (x + 2 * -t)
    have ht := abs_nonneg t
    calc _ ≤ ‖(f 1 (x + t) - f 1 (x + -t)) * f 2 (x + 2 * t) * f 3 (x + 3 * t)‖ +
          ‖f 1 (x + -t) * (f 2 (x + 2 * t) - f 2 (x + 2 * -t)) * f 3 (x + 3 * t)‖ +
          ‖f 1 (x + -t) * f 2 (x + 2 * -t) * (f 3 (x + 3 * t) - f 3 (x + 3 * -t))‖ :=
          norm_add₃_le
      _ ≤ M * (2 * |t|) * M * M + M * (M * (4 * |t|)) * M + M * M * (M * (6 * |t|)) := by
          simp only [norm_mul]
          gcongr
      _ = 12 * M ^ 3 * |t| := by ring
  -- the dominating functions
  have hs1 := integrable_strip_shift hf1 (hc 0) T (c := 1) one_ne_zero
  have hs2 := integrable_strip_shift hf1 (hc 0) T (c := -1) (by norm_num)
  have hbox : Integrable fun z : ℝ × ℝ =>
      (Set.Icc (-T) T ×ˢ Set.Icc (-1 : ℝ) 1).indicator (fun _ => (1 : ℝ)) z := by
    refine (integrable_indicator_iff (measurableSet_Icc.prod measurableSet_Icc)).mpr
      (integrableOn_const ?_ (by simp))
    rw [Measure.volume_eq_prod, Measure.prod_prod]
    simp [Real.volume_Icc, ENNReal.mul_ne_top]
  have hPm : Measurable fun z : ℝ × ℝ => ∏ j, f j (realProgressionCoordinate j z) :=
    Finset.measurable_prod _ fun j _ =>
      (hfm j).comp (continuous_realProgressionCoordinate j).measurable
  constructor
  · refine Integrable.mono' (hs1.const_mul (M * M ^ 2)) hPm.aestronglyMeasurable
      (Filter.Eventually.of_forall fun z => ?_)
    rw [hP, norm_mul]
    calc ‖f 0 z.1‖ * ‖G z.1 z.2‖ ≤ (M * ind z.1) * (M ^ 2 * ‖f 1 (z.1 + z.2)‖) := by
          exact mul_le_mul (hf0ind _) (hG _ _) (norm_nonneg _) (mul_nonneg hM (hind0 _))
      _ = _ := by simp only [ind, one_mul]; ring
  · have hQm : Measurable fun z : ℝ × ℝ => (∏ j, f j (realProgressionCoordinate j z) -
        ∏ j, f j (realProgressionCoordinate j (z.1, -z.2))) / (z.2 : ℂ) := by
      have hσ : Measurable fun z : ℝ × ℝ => (z.1, -z.2) :=
        measurable_fst.prodMk measurable_snd.neg
      exact (hPm.sub (hPm.comp hσ)).div (Complex.measurable_ofReal.comp measurable_snd)
    refine Integrable.mono' (((hbox.const_mul (M * (12 * M ^ 3))).add
      (hs1.const_mul (M * M ^ 2))).add (hs2.const_mul (M * M ^ 2))) hQm.aestronglyMeasurable
      (Filter.Eventually.of_forall fun z => ?_)
    rw [hP, hP]
    simp only
    rw [← mul_sub, mul_div_assoc, norm_mul]
    have i1 : 0 ≤ (Set.Icc (-T) T ×ˢ Set.Icc (-1 : ℝ) 1).indicator (fun _ => (1 : ℝ)) z :=
      Set.indicator_nonneg (fun _ _ => zero_le_one) z
    have i2 : 0 ≤ ind z.1 * ‖f 1 (z.1 + 1 * z.2)‖ := mul_nonneg (hind0 _) (norm_nonneg _)
    have i3 : 0 ≤ ind z.1 * ‖f 1 (z.1 + -1 * z.2)‖ := mul_nonneg (hind0 _) (norm_nonneg _)
    by_cases hx : z.1 ∈ Set.Icc (-T) T
    swap
    · have : ‖f 0 z.1‖ = 0 := by
        have := hf0ind z.1; simp only [ind, Set.indicator_of_notMem hx, mul_zero] at this
        exact le_antisymm this (norm_nonneg _)
      rw [this, zero_mul]
      change 0 ≤ M * (12 * M ^ 3) * _ + M * M ^ 2 * (ind z.1 * _) + M * M ^ 2 * (ind z.1 * _)
      positivity
    have hix : ind z.1 = 1 := by simp only [ind, Set.indicator_of_mem hx]
    have hf0z : ‖f 0 z.1‖ ≤ M := hfb 0 z.1
    by_cases ht : |z.2| ≤ 1
    · have hmem : z ∈ Set.Icc (-T) T ×ˢ Set.Icc (-1 : ℝ) 1 := ⟨hx, abs_le.mp ht⟩
      have hq : ‖(G z.1 z.2 - G z.1 (-z.2)) / (z.2 : ℂ)‖ ≤ 12 * M ^ 3 := by
        rcases eq_or_ne z.2 0 with h0 | h0
        · rw [h0, Complex.ofReal_zero, div_zero, norm_zero]; positivity
        rw [norm_div, Complex.norm_real, Real.norm_eq_abs, div_le_iff₀ (abs_pos.mpr h0)]
        exact hodd _ _
      change ‖f 0 z.1‖ * _ ≤ M * (12 * M ^ 3) * _ + M * M ^ 2 * (ind z.1 * _) +
        M * M ^ 2 * (ind z.1 * _)
      rw [Set.indicator_of_mem hmem]
      have : ‖f 0 z.1‖ * ‖(G z.1 z.2 - G z.1 (-z.2)) / (z.2 : ℂ)‖ ≤ M * (12 * M ^ 3) :=
        mul_le_mul hf0z hq (norm_nonneg _) hM

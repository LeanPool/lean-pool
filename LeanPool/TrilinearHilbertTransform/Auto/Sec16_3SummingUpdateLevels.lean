        lintegral_mono hpt
    _ = ENNReal.ofReal B * ∫⁻ x, ∏ j, g j x := lintegral_const_mul _
          (Finset.measurable_prod _ fun j _ => hgm j)
    _ ≤ ENNReal.ofReal B * ∏ j, (∫⁻ x, g j x ^ (3 : ℝ)) ^ (1 / (3 : ℝ)) := by gcongr
    _ ≤ ENNReal.ofReal B * ∏ j : Fin 3, (2 ^ (3 / q) * (K ^ (3 / q) *

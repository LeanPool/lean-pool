  obtain ⟨hs4, -⟩ := hK₄ k₁ hk₁K₄
  have hexpk : ∀ t, Real.exp (-(kk t : ℝ)) ≤ Real.exp (-1 * (kk t : ℝ) ^ θ₀) := fun t => by
    rw [Real.exp_le_exp]
    have : (kk t : ℝ) ^ θ₀ ≤ (kk t : ℝ) := by

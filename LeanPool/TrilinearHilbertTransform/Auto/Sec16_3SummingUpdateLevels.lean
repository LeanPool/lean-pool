        ∑ t ∈ Finset.Icc 1 T, ∑ u ∈ Finset.Ico 1 t, Y u t := by
      rw [Finset.sum_sigma', Finset.sum_sigma']
      refine Finset.sum_bij' (fun x _ => ⟨x.2, x.1⟩) (fun x _ => ⟨x.2, x.1⟩) ?_ ?_ ?_ ?_ ?_
      · intro x hx
        simp only [Finset.mem_sigma, Finset.mem_Icc, Finset.mem_Ioc, Finset.mem_Ico] at hx ⊢
        omega
      · intro x hx
        simp only [Finset.mem_sigma, Finset.mem_Icc, Finset.mem_Ioc, Finset.mem_Ico] at hx ⊢
        omega
      · intro x _; rfl
      · intro x _; rfl
      · intro x _; rfl

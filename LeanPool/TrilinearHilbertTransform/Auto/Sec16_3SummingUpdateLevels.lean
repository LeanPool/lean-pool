open Auto.ClassicalMaximal in
/-- The uncentered powered maximal function is at most `2^{1/q}` times the centered one. -/
theorem scalarMaximalQ_le_hl {q : ℝ} (hq : 0 < q) (f : ℝ → ℂ) (x : ℝ) :
    scalarMaximalQ q f x ≤
      2 ^ (1 / q) * hlMaximal volume (fun y => ‖f y‖ ^ q) x ^ (1 / q) := by
  unfold scalarMaximalQ maximalQ
  rw [← ENNReal.mul_rpow_of_nonneg _ _ (by positivity)]
  exact ENNReal.rpow_le_rpow (uncenteredRealMaximal_le_two_centered _ x) (by positivity)

open Auto.ClassicalMaximal in
theorem scalarMaximalQ_le_of_bound {q : ℝ} (hq : 0 < q) {f : ℝ → ℂ} {B : ℝ} (hB : 0 ≤ B)
    (hf : ∀ y, ‖f y‖ ≤ B) (x : ℝ) : scalarMaximalQ q f x ≤ ENNReal.ofReal B := by
  change uncenteredRealMaximal (fun y => ‖f y‖ ^ q) x ^ (1 / q) ≤ ENNReal.ofReal B
  have hbound : uncenteredRealMaximal (fun y => ‖f y‖ ^ q) x ≤ ENNReal.ofReal (B ^ q) := by
    refine iSup_le fun a => iSup_le fun b => iSup_le fun hab => iSup_le fun _ => ?_
    have hpt : ∀ y, ‖‖f y‖ ^ q‖ₑ ≤ ENNReal.ofReal (B ^ q) := fun y => by
      rw [Real.enorm_eq_ofReal (by positivity)]
      exact ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow (norm_nonneg _) (hf y) hq.le)
    calc (ENNReal.ofReal (b - a))⁻¹ * ∫⁻ y in Set.Icc a b, ‖‖f y‖ ^ q‖ₑ ≤
        (ENNReal.ofReal (b - a))⁻¹ * ∫⁻ _ in Set.Icc a b, ENNReal.ofReal (B ^ q) := by
          gcongr with y; exact hpt y
      _ = ENNReal.ofReal (B ^ q) := by
          rw [setLIntegral_const, Real.volume_Icc, mul_comm, mul_assoc,
            ENNReal.mul_inv_cancel (by simpa using hab) ENNReal.ofReal_ne_top, mul_one]
  calc uncenteredRealMaximal (fun y => ‖f y‖ ^ q) x ^ (1 / q) ≤
      ENNReal.ofReal (B ^ q) ^ (1 / q) := ENNReal.rpow_le_rpow hbound (by positivity)
    _ = ENNReal.ofReal B := by
        rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity), ← Real.rpow_mul hB,
          mul_one_div_cancel hq.ne', Real.rpow_one]

open Auto.ClassicalMaximal in
/-- The Hardy–Littlewood maximal theorem on `ℝ` (doubling constant `3`). -/
theorem eLpNorm_hlMaximal_le_real {p : ℝ} (hp : 1 < p) {h : ℝ → ℝ}
    (hh : AEStronglyMeasurable h volume) :
    eLpNorm (hlMaximal volume h) (ENNReal.ofReal p) volume ≤
      hlMaximalConst 3 p * eLpNorm h (ENNReal.ofReal p) volume := by
  apply eLpNorm_hlMaximal_le (fun _ _ => measure_closedBall_lt_top.ne) _ hp hh
  intro x r hr
  rw [Real.volume_closedBall, Real.volume_closedBall,
    show (2 : ℝ) * (3 * r) = 3 * (2 * r) by ring, ENNReal.ofReal_mul (by norm_num)]
  simp

open Auto.ClassicalMaximal in
/-- The `L³` norm of the centered powered maximal function, for `q < 3`:
`∫ (M (|f|^q))^{3/q} ≤ K^{3/q} ∫ |f|³` with `K = hlMaximalConst 3 (3/q)`. -/
theorem lintegral_hlMaximal_pow_le {q : ℝ} (hq : 0 < q) (hq3 : q < 3) {f : ℝ → ℂ}
    (hf : Measurable f) :
    ∫⁻ x, hlMaximal volume (fun y => ‖f y‖ ^ q) x ^ (3 / q) ≤
      hlMaximalConst 3 (3 / q) ^ (3 / q) * ∫⁻ x, ‖f x‖ₑ ^ (3 : ℝ) := by
  have hp : 1 < 3 / q := by rw [lt_div_iff₀ hq]; linarith
  have hp0 : 0 < 3 / q := by positivity
  have hh : AEStronglyMeasurable (fun y => ‖f y‖ ^ q) volume :=
    (hf.norm.pow_const q).aestronglyMeasurable
  have h := eLpNorm_hlMaximal_le_real hp hh
  have hM : Measurable (hlMaximal volume (fun y => ‖f y‖ ^ q)) :=
    measurable_hlMaximal (fun _ _ => measure_closedBall_lt_top.ne) hh
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by positivity) ENNReal.ofReal_ne_top
      hM.aestronglyMeasurable,
    eLpNorm_eq_lintegral_rpow_enorm_toReal (by positivity) ENNReal.ofReal_ne_top hh,
    ENNReal.toReal_ofReal hp0.le] at h
  have hpow := ENNReal.rpow_le_rpow h hp0.le
  rw [← ENNReal.rpow_mul, one_div_mul_cancel hp0.ne', ENNReal.rpow_one,
    ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul, one_div_mul_cancel hp0.ne',
    ENNReal.rpow_one] at hpow
  simp only [enorm_eq_self] at hpow
  refine hpow.trans (le_of_eq ?_)
  congr 1
  apply lintegral_congr; intro y
  rw [Real.enorm_eq_ofReal (by positivity), ← ofReal_norm,
    ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hq.le, ← ENNReal.rpow_mul]
  congr 1; field_simp

open Auto.ClassicalMaximal in
/-- Blueprint lines 2976-2980: for `0 < q < 3`, `|f₀| ≤ B` and measurable `f₁, f₂, f₃`,

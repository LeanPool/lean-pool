theorem maximal_product_bound {q : ℝ} (hq : 0 < q) (hq3 : q < 3) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ i, Measurable (f i)) {B : ℝ} (hB : 0 ≤ B) (h0 : ∀ y, ‖f 0 y‖ ≤ B) :
    ∫⁻ x, ∏ i, scalarMaximalQ q (f i) x ≤ ENNReal.ofReal B *
      ∏ j : Fin 3, (2 ^ (1 / q) * hlMaximalConst 3 (3 / q) ^ (1 / q) *
        (∫⁻ x, ‖f j.succ x‖ₑ ^ (3 : ℝ)) ^ (1 / (3 : ℝ))) := by

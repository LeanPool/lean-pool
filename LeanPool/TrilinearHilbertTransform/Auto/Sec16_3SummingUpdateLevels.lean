  set c : ℝ≥0∞ := 2 ^ (1 / q) * Auto.ClassicalMaximal.hlMaximalConst 3 (3 / q) ^ (1 / q)
  have hc : c ≠ ∞ := by
    apply ENNReal.mul_ne_top

  have hA₀c : 0 ≤ A₀c := Finset.sum_nonneg fun t _ => hInit0 t
  set! bn : ℕ → ℝ := fun t => 91 / 3 * (Cfin * Real.exp (-(2 * cs) * (kk t : ℝ) ^ θ₀) +

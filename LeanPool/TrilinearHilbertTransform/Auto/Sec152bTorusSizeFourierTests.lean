noncomputable def maskShift (G : bf.Grp) (I : ℤ × ℤ) (j : Fin 4) {n : ℕ} (asg : Fin n → Fin 4)
    (w : Fin n → ℕ) (h : ℕ) (F : Finset (D.Ms j G).Md) (xs : ℝ)
    (a : (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) :

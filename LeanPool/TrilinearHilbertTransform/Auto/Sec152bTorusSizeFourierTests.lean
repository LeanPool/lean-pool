    intro i hi hg
    exact hmask.2.1 i hi (hg K hKc ((D.Ms j G).subset_F_zero_of_mem D.S D.hA
      ((D.Ms j G).allComps_of_coreComps D.S D.hA D.SP (D.mem_compsAt hKc).1) hyK))
  have hdet : ∀ w ∈ Fintype.piFinset

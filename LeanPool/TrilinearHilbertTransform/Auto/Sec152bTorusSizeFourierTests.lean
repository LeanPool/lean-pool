  have hLh : 0 < ModeSchedule.Lh (h - D.SP.Δ) := pow_pos (by norm_num) _
  have hη : (0 : ℝ) ≤ (D.S.Dstar ^ 150)⁻¹ := by positivity
  have hξ : ∀ i, (D.Ms 0 G).torusξ D.S (h - D.SP.Δ) i =

        (Real.fourierChar (((D.Ms j G).cl : ℝ) * centerPhase (D.Ms j G).zc (D.Ms j G).ρ y) : ℂ) *
          (Real.fourierChar (a j * (y - xs)) : ℂ) *
          (D.Ms j G).torusG D.S (h - D.SP.Δ) xs (Fsel j)

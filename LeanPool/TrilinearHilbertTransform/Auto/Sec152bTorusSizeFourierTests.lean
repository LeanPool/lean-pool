      have e : threeT l a + ∑ i, ((expP2 (6 ^ (h - D.SP.Δ)) (D.S.Q0 * 6 ^ (h - D.SP.Δ))
          (sideOptN nn) x - ((l : ℕ) : ℤ) • expP1 (6 ^ (h - D.SP.Δ))

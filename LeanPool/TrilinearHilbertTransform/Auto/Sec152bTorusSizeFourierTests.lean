    have := gaugeErr_nonneg z.dim hδ hδ''
    have := cutTail_nonneg z.dim hδ Kt
    have : 0 ≤ multTail z.dim δ'' Q0 Cm Kt := (norm_nonneg _).trans (hcmT 0)
    positivity
  have hGl : ∀ u, ‖coreG (Q0 * L) (2 ^ (Kt + 1)) F c n cc l u‖ ≤ 1 + cutTail z.dim δ Kt := by
    intro u
    have e : coreG (Q0 * L) (2 ^ (Kt + 1)) F c n cc l u =
        ∑ v ∈ frequencyBox z.dim (2 ^ (Kt + 1)), cc0 l v *
          (Real.fourierChar (∑ i, (v i : ℝ) * (z.θ i * xs)) : ℂ) *
          torusCharacter (((Q0 * L : ℕ) : ℤ) • v) u := by

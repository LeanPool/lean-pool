open Classical in
/-- Blueprint lines 2537-2560 (the three-core principal estimate at a fixed side offset) with the
Fourier truncations made explicit: the re-anchored multiplier is bounded by `(1 + τ_m)(1 + τ_c)`
(`multTrunc_sup`, `trunc_cut_sup`; no `|box|` factor), and the main term has only `ℓ²` norms
(`three_core_anchored_bound_l2`: windows `Λ = 2^i ≤ 2^I` and the shells above, for `A ≥ 1`). -/
theorem three_core_principal_of {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) (z : ChartTag) {δ δ'' : ℝ}
    (hδ : 0 < δ) (hδ'' : 0 < δ'') (ρ : Fin 4 → Fin z.dim → ℝ)
    (hρ : ∀ j a, ρ j a ∈ Set.Icc (0 : ℝ) 1) {Q0 : ℕ} (hQ0 : 0 < Q0)
    (hQ : ∀ a b, ∃ k : ℤ, (Q0 : ℝ) * (z.C a b : ℝ) = k) {Cm : ℝ}
    (hCm : ∀ a b, |(z.C a b : ℝ)| ≤ Cm) {L : ℕ} (hL : 0 < L) (Kt : ℕ) {xs : ℝ}
    (hxs : xs ∈ Set.Icc a₀ (a₀ + r)) (l : Fin 4) (γ : Fin 4 → ℝ) (hγl : γ l = 0)
    {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j)) (c : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin z.dim → ℤ)
    {k₀ : ι l} (hFl : F l = {k₀}) (hcl : c l k₀ = 1) (hnl : n l k₀ = 0) (f : Fin 4 → ℝ → ℂ)
    (hfm : AEStronglyMeasurable (sideSd z (ρ l) l (f l)) volume)
    (hfl : IntegrableOn (sideSd z (ρ l) l (f l)) (Set.Icc a₀ (a₀ + r)))
    (hS2 : MemLp (sideSd z (ρ l) l (f l)) 2 (volume.restrict (Set.Ioc a₀ (a₀ + r))))
    (hfi : Integrable (fun zz : ℝ × ℝ => w zz * ∏ j, Function.update f l
      (fun y => (centerCut z δ (ρ l) y : ℂ) * f l y) j (realProgressionCoordinate j zz)))
    {η : ℝ} (hη : 0 ≤ η)
    (hfa : ∀ j, j ≠ l → ∀ y ∈ Set.Icc a₀ (a₀ + r), ‖f j y - ((centerCut z δ (ρ j) y : ℂ) *
      (Real.fourierChar (((slotCoeff j : ℤ) : ℝ) * centerPhase z (ρ j) y) : ℂ)) *
        ((Real.fourierChar (γ j * (y - xs)) : ℂ) * ∑ k ∈ F j, c j k *
          torusCharacter (n j k) (torusMk fun i => z.θ i / (Q0 * L) * (y - xs)))‖ ≤
            η * ∑ k ∈ F j, ‖c j k‖)
    (hfb : ∀ j, j ≠ l → ∀ y ∈ Set.Icc a₀ (a₀ + r), ‖f j y‖ ≤ ∑ k ∈ F j, ‖c j k‖)
    (cc0 : Fin 4 → (Fin z.dim → ℤ) → ℂ) (hcc0 : ∀ j v, ‖cc0 j v‖ ≤ 1)
    (hccT : ∀ j w, ‖cutoffP δ (ρ j) w - ∑ v ∈ frequencyBox z.dim (2 ^ (Kt + 1)),
      cc0 j v * (Real.fourierChar (∑ i, (v i : ℝ) * w i) : ℂ)‖ ≤ cutTail z.dim δ Kt)
    (cm0 : (Fin (z.dim + z.dim) → ℤ) → ℂ) (hcm0 : ∀ v, ‖cm0 v‖ ≤ 1)
    (hcmT : ∀ w, ‖gaugeMult δ'' Q0 0 z.C ρ w - ∑ v ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)),
      cm0 v * (Real.fourierChar (∑ i, (v i : ℝ) * w i) : ℂ)‖ ≤ multTail z.dim δ'' Q0 Cm Kt)
    (cc : Fin 4 → (Fin z.dim → ℤ) → ℂ)
    (hccE : ∀ j v, cc j v = cc0 j v * (Real.fourierChar (∑ i, (v i : ℝ) * (z.θ i * xs)) : ℂ))
    (cm : (Fin (z.dim + z.dim) → ℤ) → ℂ)
    (hcmE : ∀ v, cm v = cm0 v *
      (Real.fourierChar (∑ a, (v (Fin.castAdd z.dim a) : ℝ) * (z.θ a * xs / Q0)) : ℂ))
    (V : Submodule ℚ (Fin z.dim → ℚ))
    (m₀ : Fin z.dim → ℤ) (N : Finset (Fin z.dim → ℤ))
    (hN : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → n - n' ∉ rationalIntegerIntersection V)
    (αN : (Fin z.dim → ℤ) → ℝ) (β₀ : ℝ)
    (hsep : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → 1 ≤ |-(r * αN n) - -(r * αN n')|)
    (nref : ((Fin (z.dim + z.dim) → ℤ) × ∀ j, (Fin z.dim → ℤ) × ι j) → Fin z.dim → ℤ)
    {ε₁ H : ℝ} (hε₁ : 0 ≤ ε₁) (hH : 4 ≤ H)
    (hnear : ∀ x ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
        (fun j => frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j),
      expP2 L (Q0 * L) n x - ((l : ℕ) : ℤ) • expP1 L (Q0 * L) n x - m₀ ∈
        rationalIntegerIntersection V →
      nref x ∈ N ∧ expP1 L (Q0 * L) n x - nref x ∈ rationalIntegerIntersection V ∧
        |r * (∑ j, γ j + ∑ i, (expP1 L (Q0 * L) n x i : ℝ) * (z.θ i / (Q0 * L))) -
          r * αN (nref x)| ≤ ε₁ ∧
        |r * ((∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L (Q0 * L) n x i : ℝ) *
            (z.θ i / (Q0 * L))) - ((l : ℕ) : ℝ) * (∑ j, γ j + ∑ i,
              (expP1 L (Q0 * L) n x i : ℝ) * (z.θ i / (Q0 * L)))) - r * β₀| ≤ ε₁)
    (hfar : ∀ x ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
        (fun j => frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j),
      expP2 L (Q0 * L) n x - ((l : ℕ) : ℤ) • expP1 L (Q0 * L) n x - m₀ ∉
        rationalIntegerIntersection V →
      H ≤ |r * ((∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L (Q0 * L) n x i : ℝ) *
            (z.θ i / (Q0 * L))) - ((l : ℕ) : ℝ) * (∑ j, γ j + ∑ i,
              (expP1 L (Q0 * L) n x i : ℝ) * (z.θ i / (Q0 * L))))|)
    {J : ℕ} (hJ : 2 ≤ J) (A I : ℕ) (hA : 1 ≤ A) :
    ‖localProgressionForm r w
        (Function.update f l (fun y => (centerCut z δ (ρ l) y : ℂ) * f l y))‖ ≤
      2 * localKernelSupBound κ * ((4 * η + (gaugeErr z.dim δ δ'' +
          4 * (1 + cutTail z.dim δ Kt) ^ 3 * cutTail z.dim δ Kt +
          (1 + cutTail z.dim δ Kt) ^ 4 * multTail z.dim δ'' Q0 Cm Kt)) *
        ∏ j, ∑ k ∈ F j, ‖c j k‖) *
        (r⁻¹ * ∫ y in Set.Icc a₀ (a₀ + r), ‖sideSd z (ρ l) l (f l) y‖) +
      (r⁻¹ * entryC κ J A (r * β₀) * 2 ^ (A + 4) * ∑ i ∈ Finset.range (I + 1),
          ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) *
          (((1 + multTail z.dim δ'' Q0 Cm Kt) * (1 + cutTail z.dim δ Kt) *
            ∏ i ∈ Finset.univ.erase l, (eLpNorm (fun u : torusAnnihilator
              (rationalIntegerIntersection V) => coreG (Q0 * L) (2 ^ (Kt + 1)) F c n cc i u) 2
            (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal) *
            Real.sqrt (∑ k ∈ (windowSet N (fun n => r * αN n) I).filter
              (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + -(r * αN n)| ≤ 2 ^ i),
                ‖∫ y in Set.Ico a₀ (a₀ + r), sideSd z (ρ l) l (f l) y *
                  Complex.exp (2 * Real.pi * Complex.I * k * y / r)‖ ^ 2)) +
        r⁻¹ * entryC κ J A (r * β₀) * 2 ^ (A + 4) * (2 * ((2 : ℝ) ^ (I + 1))⁻¹ ^ (A + 1)) *
          (((1 + multTail z.dim δ'' Q0 Cm Kt) * (1 + cutTail z.dim δ Kt) *
            ∏ i ∈ Finset.univ.erase l, (eLpNorm (fun u : torusAnnihilator
              (rationalIntegerIntersection V) => coreG (Q0 * L) (2 ^ (Kt + 1)) F c n cc i u) 2
            (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal) *
            Real.sqrt (r * ∫ y in a₀..a₀ + r, ‖sideSd z (ρ l) l (f l) y‖ ^ 2))) +
      (∑ x ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
          (fun j => frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j),
          ‖cm x.1 * ∏ j, (cc j (x.2 j).1 * c j (x.2 j).2)‖) *
        (r⁻¹ * (∫ y in Set.Ico a₀ (a₀ + r), ‖sideSd z (ρ l) l (f l) y‖) *
          (nearB κ ε₁ + 12 * (kerC κ J * (4 / H) ^ (J - 2)))) := by
  set ζ := centerCut z δ (ρ l) with hζ
  set! ph : ℝ → ℝ := fun y => ((slotCoeff l : ℤ) : ℝ) * centerPhase z (ρ l) y with hph
  have hprod :=
    three_core_Fc_approx_of z hδ hδ'' ρ hρ hQ0 hQ hCm
    hL Kt xs l γ hγl F c n hFl hcl hnl
    (Function.update f l (fun y => (ζ y : ℂ) * (Real.fourierChar (ph y) : ℂ)))
    (fun y => by rw [Function.update_self]) a₀ (a₀ + r) hη
    (fun j hj y hy => by rw [Function.update_of_ne hj]; exact hfa j hj y hy)
    (fun j hj y hy => by rw [Function.update_of_ne hj]; exact hfb j hj y hy)
    cc0 hcc0 hccT cm0 hcm0 hcmT cc hccE cm hcmE
  set! Fc : ℝ × ℝ → ℂ := fun zz =>
    (∏ j ∈ Finset.univ.erase l, f j (realProgressionCoordinate j zz)) *
      ((ζ (realProgressionCoordinate l zz) : ℂ) *
        (Real.fourierChar (ph (realProgressionCoordinate l zz)) : ℂ)) with hFc
  have hcan : ∀ y, (Real.fourierChar (ph y) : ℂ) * (Real.fourierChar (-ph y) : ℂ) = 1 := by
    intro y
    rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul, add_neg_cancel, AddChar.map_zero_eq_one,
      Circle.coe_one]
  have hpt : ∀ zz, w zz * ∏ j, Function.update f l (fun y => (ζ y : ℂ) * f l y) j
      (realProgressionCoordinate j zz) =
      w zz * (Fc zz * sideSd z (ρ l) l (f l) (realProgressionCoordinate l zz)) := by
    intro zz
    rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ l), Function.update_self,
      Finset.prod_congr rfl fun j hj => by rw [Function.update_of_ne (Finset.mem_erase.mp hj).1]]
    have := hcan (realProgressionCoordinate l zz)
    simp only [hFc, sideSd]
    rw [show -(((slotCoeff l : ℤ) : ℝ) * centerPhase z (ρ l) (realProgressionCoordinate l zz)) =
      -ph (realProgressionCoordinate l zz) from rfl]
    linear_combination (-(w zz * (ζ (realProgressionCoordinate l zz) : ℂ) *
      f l (realProgressionCoordinate l zz) *
      ∏ j ∈ Finset.univ.erase l, f j (realProgressionCoordinate j zz))) * this
  have hfi' : Integrable (fun zz : ℝ × ℝ =>
      w zz * (Fc zz * sideSd z (ρ l) l (f l) (realProgressionCoordinate l zz))) :=
    hfi.congr (Filter.Eventually.of_forall hpt)
  have hform : localProgressionForm r w
      (Function.update f l (fun y => (centerCut z δ (ρ l) y : ℂ) * f l y)) =
      (r : ℂ)⁻¹ ^ 2 * ∫ zz, w zz * (Fc zz * sideSd z (ρ l) l (f l)

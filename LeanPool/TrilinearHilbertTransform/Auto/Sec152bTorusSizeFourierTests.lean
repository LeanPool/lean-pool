        fourKC κ' 1 * (D.S.Dstar ^ 100)⁻¹ * ∏ j, D.coefSum G I j (Fsel j) := by
      have hU : D.U0⁻¹ = (D.S.Dstar ^ 250)⁻¹ := rfl

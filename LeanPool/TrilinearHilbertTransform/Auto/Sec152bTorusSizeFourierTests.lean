open Classical in
/-- The windows of radius `2^i` inside the windows of radius `2^I` do not depend on `I ≥ i`. -/
theorem windowSet_filter_eq {ν : Type*} (N : Finset ν) (c : ν → ℝ) {i I J : ℕ} (hiI : i ≤ I)
    (hIJ : I ≤ J) :
    (windowSet N c J).filter (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + -c n| ≤ 2 ^ i) =
      (windowSet N c I).filter (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + -c n| ≤ 2 ^ i) := by
  have hmem : ∀ K : ℕ, i ≤ K → ∀ k : ℤ, (∃ n ∈ N, |(k : ℝ) + -c n| ≤ 2 ^ i) →
      k ∈ windowSet N c K := by
    intro K hK k ⟨n, hn, hk⟩
    have h2 : (2 : ℝ) ^ i ≤ 2 ^ K := pow_le_pow_right₀ (by norm_num) hK
    refine Finset.mem_biUnion.mpr ⟨n, hn, Finset.mem_Icc.mpr ⟨?_, ?_⟩⟩
    · exact Int.ceil_le.mpr (by linarith [(abs_le.mp hk).1])
    · exact Int.le_floor.mpr (by linarith [(abs_le.mp hk).2])
  ext k
  simp only [Finset.mem_filter]
  constructor
  · rintro ⟨-, hk⟩; exact ⟨hmem I hiI k hk, hk⟩
  · rintro ⟨-, hk⟩; exact ⟨hmem J (hiI.trans hIJ) k hk, hk⟩

/-- The windows of radius `2^I` around the references contain at most `|N| (2^{I+1} + 1)`
integers. -/
theorem card_windowSet_le {ν : Type*} (N : Finset ν) (c : ν → ℝ) (I : ℕ) :
    ((windowSet N c I).card : ℝ) ≤ N.card * (2 * 2 ^ I + 1) := by
  unfold windowSet
  have h1 := Finset.card_biUnion_le (s := N)
    (t := fun n => Finset.Icc ⌈c n - 2 ^ I⌉ ⌊c n + 2 ^ I⌋)
  have h2 : ∀ n ∈ N, ((Finset.Icc ⌈c n - 2 ^ I⌉ ⌊c n + 2 ^ I⌋).card : ℝ) ≤ 2 * 2 ^ I + 1 := by
    intro n _
    rw [Int.card_Icc]
    have hf : (⌊c n + 2 ^ I⌋ : ℝ) ≤ c n + 2 ^ I := Int.floor_le _
    have hc : c n - 2 ^ I ≤ (⌈c n - 2 ^ I⌉ : ℝ) := Int.le_ceil _
    have hz : ⌊c n + 2 ^ I⌋ + 1 - ⌈c n - 2 ^ I⌉ ≤ 2 * 2 ^ I + 1 := by
      have : ((⌊c n + 2 ^ I⌋ + 1 - ⌈c n - 2 ^ I⌉ : ℤ) : ℝ) ≤ ((2 * 2 ^ I + 1 : ℤ) : ℝ) := by
        push_cast; linarith
      exact_mod_cast this
    have hnn := Int.toNat_le_toNat hz
    have e : ((2 * 2 ^ I + 1 : ℤ)).toNat = 2 * 2 ^ I + 1 := by
      rw [show (2 * 2 ^ I + 1 : ℤ) = ((2 * 2 ^ I + 1 : ℕ) : ℤ) by push_cast; ring,
        Int.toNat_natCast]
    rw [e] at hnn
    exact_mod_cast hnn
  calc ((N.biUnion fun n => Finset.Icc ⌈c n - 2 ^ I⌉ ⌊c n + 2 ^ I⌋).card : ℝ)
      ≤ ∑ n ∈ N, ((Finset.Icc ⌈c n - 2 ^ I⌉ ⌊c n + 2 ^ I⌋).card : ℝ) := by exact_mod_cast h1
    _ ≤ ∑ _n ∈ N, (2 * 2 ^ I + 1 : ℝ) := Finset.sum_le_sum h2
    _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]

/-- The dyadic shells beyond `2^I`: `Σ_{I < i ≤ I'} 2^{-i(A+1)} ≤ 2 · 2^{-(I+1)(A+1)}`. -/
theorem shell_tail_sum (A I I' : ℕ) :
    ∑ i ∈ Finset.Ico (I + 1) (I' + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) ≤
      2 * ((2 : ℝ) ^ (I + 1))⁻¹ ^ (A + 1) := by
  set x : ℝ := ((2 : ℝ)⁻¹) ^ (A + 1) with hx
  have hx0 : 0 ≤ x := by positivity
  have hx1 : x ≤ 1 / 2 := by
    rw [hx, pow_succ]
    have : ((2 : ℝ)⁻¹) ^ A ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
    nlinarith
  have e : ∀ i : ℕ, ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) = x ^ i := fun i => by
    rw [hx, ← pow_mul, ← inv_pow, ← pow_mul, mul_comm]
  simp_rw [e]
  refine (geom_sum_Ico_le_of_lt_one hx0 (by linarith)).trans ?_
  rw [div_le_iff₀ (by linarith)]
  have h2 : 0 ≤ x ^ (I + 1) := pow_nonneg hx0 _
  nlinarith


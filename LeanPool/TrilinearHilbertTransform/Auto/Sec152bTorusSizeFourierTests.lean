    have hPN : ∏ j, (cutNorm (D.Ms 0 G).zc.dim δ * ∑ k ∈ sideOptF l Fsel j,
        ‖sideOptC cα j k‖) = cutNorm (D.Ms 0 G).zc.dim δ * ∏ j ∈ Finset.univ.erase l,

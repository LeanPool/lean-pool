    j (fun w => D.coreSize G I xs (h - D.SP.Δ) j (D.maskSel G I j asg w h (D.finCls G I j h m))
      (ns w)) (fun w => D.coreSize_nonneg _ _ _ _ _ _ _) (by norm_num : (0 : ℝ) ≤ 6) hsize

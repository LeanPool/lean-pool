/-! ## The four-core tests (blueprint `eq:four-tests`, lines 2506-2520) -/

/-- The dyadic band `2^k` of a positive number `x ∈ [2^k, 2^{k+1})` (the fixed endpoint convention
of `eq:four-tests`). -/
noncomputable def dyadicBand (x : ℝ) : ℝ := (2 : ℝ) ^ Int.log 2 x

theorem dyadicBand_pos (x : ℝ) : 0 < dyadicBand x := zpow_pos (by norm_num) _

theorem dyadicBand_le {x : ℝ} (hx : 0 < x) : dyadicBand x ≤ x := by
  have h := Int.zpow_log_le_self (b := 2) (by norm_num) hx
  unfold dyadicBand
  exact_mod_cast h

theorem lt_two_mul_dyadicBand (x : ℝ) : x < 2 * dyadicBand x := by
  have h := Int.lt_zpow_succ_log_self (b := 2) (by norm_num) x
  unfold dyadicBand
  rw [zpow_add_one₀ (by norm_num)] at h
  push_cast at h
  linarith

theorem dyadicBand_mono {x y : ℝ} (hx : 0 < x) (hxy : x ≤ y) : dyadicBand x ≤ dyadicBand y :=
  zpow_le_zpow_right₀ (by norm_num) (Int.log_mono_right hx hxy)

theorem one_le_dyadicBand {x : ℝ} (hx : 1 ≤ x) : 1 ≤ dyadicBand x := by
  have h := dyadicBand_mono one_pos hx
  unfold dyadicBand at h ⊢
  rwa [Int.log_one_right, zpow_zero] at h

/-- The inner minimum `min_{0 ≤ j ≤ 3} r |t' - j q'|` of `eq:four-tests` (`fourMu = min(1, ·)`). -/
noncomputable def fourInner (r A B : ℝ) : ℝ :=
  ((Finset.univ : Finset (Fin 4)).image fun j : Fin 4 => (j : ℝ)).inf'
    ⟨0, Finset.mem_image.mpr ⟨0, Finset.mem_univ _, by simp⟩⟩ fun j => r * |B - j * A|

theorem fourMu_eq (r A B : ℝ) : fourMu r A B = min 1 (fourInner r A B) := rfl

theorem fourMu_le_inner (r A B : ℝ) : fourMu r A B ≤ fourInner r A B := min_le_right _ _

theorem fourNu_le {r A B U : ℝ} (hU : 1 ≤ U) (hA : r * |A| ≤ U) (hB : r * |B| ≤ U) :
    fourNu r A B ≤ U :=
  max_le hU (max_le hA hB)

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

/-- The reference threshold `U₀ = D_*^{250}` (blueprint line 2506). -/
noncomputable def U0 : ℝ := D.S.Dstar ^ 250

/-- The four-core test frequency `Q = Σ_j γ_j^*` (anchor `l' = 0`), `γ_j^* = ω_{a_j}(x_*)` the
slope of the hereditary representative `a_j` at the path point (blueprint lines 2506-2509). -/
noncomputable def fourQ (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ)
    (a : ∀ j, (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) :
    ℝ :=
  ∑ j, (D.Ms j G).slope (a j).1 xs

/-- The four-core test frequency `T = Σ_j j γ_j^*` (blueprint lines 2506-2509). -/
noncomputable def fourT (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ)
    (a : ∀ j, (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) :
    ℝ :=
  ∑ j : Fin 4, ((j : ℕ) : ℝ) * (D.Ms j G).slope (a j).1 xs

/-- The full box `|n|_∞ ≤ B'_{h'} = D_*^5 E_{h'}` of `eq:frequency-box`, as integer vectors. -/
noncomputable def fullBox (d h' : ℕ) : Finset (Fin d → ℤ) :=
  frequencyBox d ⌊D.S.Dstar ^ 5 * D.S.Eh h'⌋₊

theorem mem_fullBox (hD : 0 ≤ D.S.Dstar) {d h' : ℕ} {n : Fin d → ℤ} :
    n ∈ D.fullBox d h' ↔ ∀ i, |(n i : ℝ)| ≤ D.S.Dstar ^ 5 * D.S.Eh h' := by
  have hB : 0 ≤ D.S.Dstar ^ 5 * D.S.Eh h' :=
    mul_nonneg (pow_nonneg hD 5) (pow_nonneg (by linarith [D.hA]) _)
  unfold fullBox frequencyBox
  rw [Fintype.mem_piFinset]
  refine forall_congr' fun i => ?_
  rw [Finset.mem_Icc, ← abs_le, ← Int.natCast_natAbs, Nat.cast_le, Nat.le_floor_iff hB,
    Nat.cast_natAbs, Int.cast_abs]

open Classical in
/-- The candidate references of a four-core tuple (blueprint lines 2510-2513): integer `n, m` in the
full box with `max(|q'|, |t'|) ≤ U₀ R_s`, `q' = Q + n·ξ`, `t' = T + m·ξ`, `R_s = |I|^{-1}`, at the
torus height `h'` (`ξ = ϑ/L_{h'}` in the chart of the anchor role `0`). -/
noncomputable def fourRefSet (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ) (h' : ℕ)
    (a : ∀ j, (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) :
    Finset ((Fin (D.Ms 0 G).zc.dim → ℤ) × (Fin (D.Ms 0 G).zc.dim → ℤ)) :=
  (D.fullBox _ h' ×ˢ D.fullBox _ h').filter fun q =>
    dyadicGridLength A.G I.1 *
        |D.fourQ G I xs a + ∑ i, (q.1 i : ℝ) * (D.Ms 0 G).torusξ D.S h' i| ≤ D.U0 ∧
      dyadicGridLength A.G I.1 *
        |D.fourT G I xs a + ∑ i, (q.2 i : ℝ) * (D.Ms 0 G).torusξ D.S h' i| ≤ D.U0

/-- The reference of a four-core tuple, chosen by a fixed rule from the candidate references
(blueprint line 2514): it depends only on the cell, group, path point, height and representatives,
not on masks or sampling histories. -/
noncomputable def fourRef (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ) (h' : ℕ)
    (a : ∀ j, (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) :
    (Fin (D.Ms 0 G).zc.dim → ℤ) × (Fin (D.Ms 0 G).zc.dim → ℤ) :=
  finPick (D.fourRefSet G I xs h' a)

/-- The reference test frequency `q' = Q + n·ξ`. -/
noncomputable def fourQ' (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ) (h' : ℕ)
    (a : ∀ j, (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) :
    ℝ :=
  D.fourQ G I xs a + ∑ i, ((D.fourRef G I xs h' a).1 i : ℝ) * (D.Ms 0 G).torusξ D.S h' i

/-- The reference test frequency `t' = T + m·ξ`. -/
noncomputable def fourT' (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ) (h' : ℕ)
    (a : ∀ j, (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) :
    ℝ :=
  D.fourT G I xs a + ∑ i, ((D.fourRef G I xs h' a).2 i : ℝ) * (D.Ms 0 G).torusξ D.S h' i

/-- The four-core test (blueprint lines 2519-2520): a tuple is kept when a reference exists and the
inner minimum `min_j |t' - j q'| / R_s` is at least `U₀⁻¹`; otherwise it is discarded. -/
def fourPasses (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ) (h' : ℕ)
    (a : ∀ j, (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) :
    Prop :=
  (D.fourRefSet G I xs h' a).Nonempty ∧
    D.U0⁻¹ ≤ fourInner (dyadicGridLength A.G I.1) (D.fourQ' G I xs h' a) (D.fourT' G I xs h' a)

/-- The dyadic band `μ ≍ min(1, min_j |t' - j q'| / R_s)` of `eq:four-tests`. -/
noncomputable def fourMuBand (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ) (h' : ℕ)
    (a : ∀ j, (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) :
    ℝ :=
  dyadicBand (fourMu (dyadicGridLength A.G I.1) (D.fourQ' G I xs h' a) (D.fourT' G I xs h' a))

/-- The dyadic band `ν ≍ max(1, |q'|/R_s, |t'|/R_s)` of `eq:four-tests`. -/
noncomputable def fourNuBand (G : bf.Grp) (I : ℤ × ℤ) (xs : ℝ) (h' : ℕ)
    (a : ∀ j, (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))) :
    ℝ :=
  dyadicBand (fourNu (dyadicGridLength A.G I.1) (D.fourQ' G I xs h' a) (D.fourT' G I xs h' a))

/-- Blueprint lines 2510-2513: the chosen reference of a tuple with a candidate lies in the full
box and has `r |q'|, r |t'| ≤ U₀` (`max(|q'|, |t'|) ≤ U₀ R_s`). -/
theorem fourRef_spec (hD : 0 ≤ D.S.Dstar) {G : bf.Grp} {I : ℤ × ℤ} {xs : ℝ} {h' : ℕ}
    {a : ∀ j, (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))}
    (hne : (D.fourRefSet G I xs h' a).Nonempty) :
    (∀ i, |((D.fourRef G I xs h' a).1 i : ℝ)| ≤ D.S.Dstar ^ 5 * D.S.Eh h') ∧
    (∀ i, |((D.fourRef G I xs h' a).2 i : ℝ)| ≤ D.S.Dstar ^ 5 * D.S.Eh h') ∧
    dyadicGridLength A.G I.1 * |D.fourQ' G I xs h' a| ≤ D.U0 ∧
    dyadicGridLength A.G I.1 * |D.fourT' G I xs h' a| ≤ D.U0 := by
  classical
  have h := finPick_mem hne
  have h' : D.fourRef G I xs h' a ∈ D.fourRefSet G I xs h' a := h
  unfold fourRefSet at h'
  obtain ⟨hbox, hq, ht⟩ := Finset.mem_filter.mp h'
  obtain ⟨h1, h2⟩ := Finset.mem_product.mp hbox
  exact ⟨(D.mem_fullBox hD).mp h1, (D.mem_fullBox hD).mp h2, hq, ht⟩

/-- Blueprint lines 2514-2520 (the bands of a kept tuple): when `U₀ ≥ 1`, a tuple passing the test
has `μ ≤ min(1, min_j |t' - j q'|/R_s) < 2μ` with `U₀⁻¹/2 < μ ≤ 1`, and
`ν ≤ max(1, |q'|/R_s, |t'|/R_s) < 2ν` with `1 ≤ ν ≤ U₀`. -/
theorem fourBands_spec (hD : 0 ≤ D.S.Dstar) (hU : 1 ≤ D.U0) {G : bf.Grp} {I : ℤ × ℤ} {xs : ℝ}
    {h' : ℕ}
    {a : ∀ j, (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))}
    (hp : D.fourPasses G I xs h' a) :
    D.fourMuBand G I xs h' a ≤ fourMu (dyadicGridLength A.G I.1) (D.fourQ' G I xs h' a)
        (D.fourT' G I xs h' a) ∧
      fourMu (dyadicGridLength A.G I.1) (D.fourQ' G I xs h' a) (D.fourT' G I xs h' a) <
        2 * D.fourMuBand G I xs h' a ∧
      D.U0⁻¹ / 2 < D.fourMuBand G I xs h' a ∧ D.fourMuBand G I xs h' a ≤ 1 ∧
    D.fourNuBand G I xs h' a ≤ fourNu (dyadicGridLength A.G I.1) (D.fourQ' G I xs h' a)
        (D.fourT' G I xs h' a) ∧
      fourNu (dyadicGridLength A.G I.1) (D.fourQ' G I xs h' a) (D.fourT' G I xs h' a) <
        2 * D.fourNuBand G I xs h' a ∧
      1 ≤ D.fourNuBand G I xs h' a ∧ D.fourNuBand G I xs h' a ≤ D.U0 := by
  obtain ⟨hne, hin⟩ := hp
  obtain ⟨-, -, hq, ht⟩ := D.fourRef_spec hD hne
  set μ := fourMu (dyadicGridLength A.G I.1) (D.fourQ' G I xs h' a) (D.fourT' G I xs h' a)
    with hμ
  set ν := fourNu (dyadicGridLength A.G I.1) (D.fourQ' G I xs h' a) (D.fourT' G I xs h' a)
    with hν
  have hU0 : 0 < D.U0⁻¹ := inv_pos.mpr (by linarith)
  have hU1 : D.U0⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hU
  have hμU : D.U0⁻¹ ≤ μ := by rw [hμ, fourMu_eq]; exact le_min hU1 hin
  have hμ0 : 0 < μ := lt_of_lt_of_le hU0 hμU
  have hμ1 : μ ≤ 1 := fourMu_le_one _ _ _
  have hν1 : 1 ≤ ν := one_le_fourNu _ _ _
  have hνU : ν ≤ D.U0 := fourNu_le hU hq ht
  have hbμ : D.fourMuBand G I xs h' a = dyadicBand μ := rfl
  have hbν : D.fourNuBand G I xs h' a = dyadicBand ν := rfl
  rw [hbμ, hbν]
  have hμb := dyadicBand_le hμ0
  have hμb2 := lt_two_mul_dyadicBand μ
  have hνb := dyadicBand_le (lt_of_lt_of_le one_pos hν1)
  have hνb2 := lt_two_mul_dyadicBand ν
  refine ⟨hμb, hμb2, by linarith, hμb.trans hμ1, hνb, hνb2, one_le_dyadicBand hν1,
    hνb.trans hνU⟩

end SideInput


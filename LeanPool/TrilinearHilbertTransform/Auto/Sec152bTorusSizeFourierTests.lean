    by_cases hpass : D.fourPasses G I xs (h - D.SP.Δ) a
    · simp only [hpass, ↓reduceIte]
      rw [hfourErr]
      refine hcomb.trans ?_
      linarith only [h1P]
    · simp only [hpass, ↓reduceIte, zero_add]
      rw [hfourErr]
      have hinner : fourInner (dyadicGridLength A.G I.1) (D.fourQ' G I xs (h - D.SP.Δ) a)

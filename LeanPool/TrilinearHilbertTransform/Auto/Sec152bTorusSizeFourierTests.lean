  set ν := max 1 |D.threeBeta G I xs h' l a| with hν
  have hbμ : D.threeMuBand G I xs h' l a = dyadicBand μ := rfl
  have hbν : D.threeNuBand G I xs h' l a = dyadicBand ν := rfl
  rw [hbμ, hbν]
  have hU0 : 0 < D.U0⁻¹ := inv_pos.mpr (by linarith)
  have hU1 : D.U0⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hU
  have hμU : D.U0⁻¹ ≤ μ := le_min hU1 hin
  have hμ0 : 0 < μ := lt_of_lt_of_le hU0 hμU
  have hμ1 : μ ≤ 1 := min_le_left _ _
  have hν1 : 1 ≤ ν := le_max_left _ _
  have hνU : ν ≤ D.U0 := max_le hU hβ
  have hμb := dyadicBand_le hμ0
  have hμb2 := lt_two_mul_dyadicBand μ
  have hνb := dyadicBand_le (lt_of_lt_of_le one_pos hν1)
  have hνb2 := lt_two_mul_dyadicBand ν
  exact ⟨hμb, hμb2, by linarith, hμb.trans hμ1, hνb, hνb2, one_le_dyadicBand hν1, hνb.trans hνU⟩


  have hRmb : ∀ uv, ‖coreRA V L (Q0 * L) (2 ^ (Kt + 1)) F c n cc cm l uv‖ ≤
      (1 + multTail z.dim δ'' Q0 Cm Kt) * (1 + cutTail z.dim δ Kt) := fun uv => by
    unfold coreRA
    rw [norm_mul]
    exact mul_le_mul (hR _ _) (hGl _) (norm_nonneg _) (by linarith)
  have hε : ∀ zz : ℝ × ℝ, w zz ≠ 0 → ‖Fc zz -
      ∑ x ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
          (fun j => frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j),
        (cm x.1 * ∏ j, (cc j (x.2 j).1 * c j (x.2 j).2)) *
        (Real.fourierChar ((∑ j, γ j + ∑ i, (expP1 L (Q0 * L) n x i : ℝ) * (z.θ i / (Q0 * L))) *

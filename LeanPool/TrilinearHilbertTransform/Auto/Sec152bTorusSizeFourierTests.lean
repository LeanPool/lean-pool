theorem masked_group_coef (G : bf.Grp) (I : ℤ × ℤ) (σ : Fin 4 → Fin 3) {l : Fin 4}
    (hl : σ l = 0) {n : ℕ} (asg : Fin n → Fin 4) (w : Fin n → ℕ) (h : ℕ)
    (F : Finset (D.Ms l G).Md) (s : ℝ) :

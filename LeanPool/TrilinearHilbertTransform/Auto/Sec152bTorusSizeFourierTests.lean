  have hτc : 0 ≤ cutTail z.dim δ Kt := (norm_nonneg _).trans (hccT 0 0)
  have hR : ∀ u v : StandardTorus z.dim, ‖coreR L (2 ^ (Kt + 1)) cm u v‖ ≤

  obtain ⟨nn, hnnj⟩ : ∃ nn : ∀ j, (D.Ms j G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K)) → Fin (D.Ms 0 G).zc.dim → ℤ,

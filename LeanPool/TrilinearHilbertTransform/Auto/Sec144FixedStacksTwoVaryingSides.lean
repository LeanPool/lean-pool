  refine le_trans (Finset.sum_le_sum fun i _ => pow_le_pow_left₀ (norm_nonneg _) (hred i) 2) ?_
  refine le_trans ?_ (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) hz 2)
    (fp.bandJumpM_nonneg sA mbA D.length))

/-! ### Aligned binary prefix positions (blueprint lines 2400-2404) -/

/-- The prefix of `n` above the bit `k` (the bits below `k` cleared). -/
def bitPrefix (n k : ℕ) : ℕ := (n / 2 ^ k) * 2 ^ k

/-- The position of level `k` of the prefix `[0, n]`: the aligned interval
`[bitPrefix n (k+1), bitPrefix n (k+1) + 2^k]` (used when the bit `k` of `n` is set). -/
def posInt (n k : ℕ) : ℕ × ℕ := (bitPrefix n (k + 1), bitPrefix n (k + 1) + 2 ^ k)

theorem bitPrefix_zero (n : ℕ) : bitPrefix n 0 = n := by simp [bitPrefix]

theorem bitPrefix_of_lt {n N : ℕ} (h : n < 2 ^ N) : bitPrefix n N = 0 := by
  simp [bitPrefix, Nat.div_eq_of_lt h]

/-- Consecutive prefixes differ by the bit `k` times `2^k`. -/
theorem bitPrefix_succ (n k : ℕ) :
    bitPrefix n k = bitPrefix n (k + 1) + (if n.testBit k then 2 ^ k else 0) := by
  unfold bitPrefix
  have h1 : n / 2 ^ k = 2 * (n / 2 ^ (k + 1)) + (n / 2 ^ k) % 2 := by
    rw [pow_succ, ← Nat.div_div_eq_div_mul]
    omega
  have h2 : (n / 2 ^ k) % 2 = if n.testBit k then 1 else 0 := by
    rw [Nat.testBit_eq_decide_div_mod_eq]
    have := Nat.mod_two_eq_zero_or_one (n / 2 ^ k)
    rcases this with h | h <;> simp [h]
  rw [h1, h2, pow_succ]
  split_ifs <;> ring

/-- Blueprint lines 2400-2402: `W_{b+n} = W_b + Σ_k [bit k] (W_{b+t_k} - W_{b+r_k})` over the
aligned positions of the levels `k < N` (for `n < 2^N`), at most one interval at each length. -/
theorem prefix_telescope {M : Type*} [AddCommGroup M] (W : ℕ → M) (b n N : ℕ)
    (hn : n < 2 ^ N) :
    W (b + n) = W b + ∑ k ∈ Finset.range N,
      (if n.testBit k then W (b + (posInt n k).2) - W (b + (posInt n k).1) else 0) := by
  have key : ∀ M' ≤ N, W (b + n) = W (b + bitPrefix n M') + ∑ k ∈ Finset.range M',
      (if n.testBit k then W (b + (posInt n k).2) - W (b + (posInt n k).1) else 0) := by
    intro M' hM'
    induction M' with
    | zero => simp [bitPrefix_zero]
    | succ M' ih =>
      rw [ih (by omega), Finset.sum_range_succ, bitPrefix_succ n M']
      unfold posInt
      split_ifs <;> abel_nf
  rw [key N le_rfl, bitPrefix_of_lt hn, add_zero]

/-- The positions lie inside the prefix `[0, n]` when the bit is set. -/
theorem posInt_le {n k : ℕ} (hk : n.testBit k) : (posInt n k).1 ≤ (posInt n k).2 ∧
    (posInt n k).2 ≤ n := by
  refine ⟨Nat.le_add_right _ _, ?_⟩
  have h := bitPrefix_succ n k
  simp only [hk, ite_true] at h
  have h0 : bitPrefix n k ≤ n := Nat.div_mul_le_self n _
  unfold posInt
  omega

/-! ### Configurations of positions (blueprint lines 2402-2404, 2423) -/

/-- The component of level `k ≤ N` of `W_{b+n}`: the base `W_b` at level `N`, otherwise the jump
over the aligned position of level `k` when the bit `k` of `n` is set. -/
def posComp {M : Type*} [AddCommGroup M] (W : ℕ → M) (b n N : ℕ) (k : Fin (N + 1)) : M :=
  if (k : ℕ) = N then W b
  else if n.testBit k then W (b + (posInt n k).2) - W (b + (posInt n k).1) else 0

/-- Blueprint lines 2400-2402: the components of all levels sum to `W_{b+n}` (for `n < 2^N`). -/
theorem sum_posComp {M : Type*} [AddCommGroup M] (W : ℕ → M) (b n N : ℕ) (hn : n < 2 ^ N) :
    ∑ k : Fin (N + 1), posComp W b n N k = W (b + n) := by
  rw [Fin.sum_univ_castSucc, prefix_telescope W b n N hn, add_comm (W b)]
  congr 1
  · rw [Finset.sum_range]
    refine Finset.sum_congr rfl fun k _ => ?_
    unfold posComp
    rw [ite_eq_right_iff.mpr (fun h => absurd h (by simp only [Fin.val_castSucc]; exact k.2.ne))]
    rfl
  · unfold posComp
    simp


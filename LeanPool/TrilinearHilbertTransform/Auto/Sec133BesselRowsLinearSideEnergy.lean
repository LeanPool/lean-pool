      (e.2.2 : Set Ms.Md))).starProjection F‖ ^ 2 =
      ∑ i : Fin 3, ∑ e ∈ ev.filter (fun e => blockClass R₀ S.K e.1 = i), ‖(Submodule.span ℂ
        ((Ms.cellMode e.2.1) '' (e.2.2 : Set Ms.Md))).starProjection F‖ ^ 2 :=

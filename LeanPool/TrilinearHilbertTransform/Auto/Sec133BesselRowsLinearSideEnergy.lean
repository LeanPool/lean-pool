/-- Blueprint lines 2054-2055: a quadratic phase difference whose derivative `2αx + β` exceeds
`θ` at one point of a cell `[a, a + r]`, with slope variation `2|α| r ≤ θ/2`, has normalized
oscillatory integral at most `8/(θ r)` on the cell. -/
theorem cell_cross_pair_le (α β γ : ℝ) {a r θ : ℝ} (hr : 0 < r) (hθ : 0 < θ)
    {x₀ : ℝ} (hx₀ : x₀ ∈ Set.Icc a (a + r)) (hlarge : θ ≤ |2 * α * x₀ + β|)
    (hvar : 2 * |α| * r ≤ θ / 2) :
    r⁻¹ * ‖∫ x in Set.Icc a (a + r), fourierWave 1 (α * x ^ 2 + β * x + γ)‖ ≤ 8 / (θ * r) := by
  have hlower : ∀ x ∈ Set.Icc a (a + r), θ / 2 ≤ |2 * α * x + β| := by
    intro x hx
    have hxx : |x - x₀| ≤ r := by
      rw [abs_le]; constructor <;> linarith only [hx.1, hx.2, hx₀.1, hx₀.2]
    have hd : |(2 * α * x + β) - (2 * α * x₀ + β)| ≤ θ / 2 := by
      rw [show (2 * α * x + β) - (2 * α * x₀ + β) = 2 * α * (x - x₀) by ring, abs_mul,
        abs_mul, abs_two]
      calc 2 * |α| * |x - x₀| ≤ 2 * |α| * r := by gcongr
        _ ≤ θ / 2 := hvar
    have := abs_sub_abs_le_abs_sub (2 * α * x₀ + β) (2 * α * x + β)
    rw [abs_sub_comm] at this
    linarith only [hlarge, hd, this]
  have h := quadratic_oscillatory_integral_bound α β γ (by linarith) (by positivity) hlower
  calc r⁻¹ * ‖∫ x in Set.Icc a (a + r), fourierWave 1 (α * x ^ 2 + β * x + γ)‖ ≤
        r⁻¹ * (4 / (θ / 2)) := by gcongr
    _ = 8 / (θ * r) := by field_simp; ring

/-- `Σ ‖γ_n‖ ≤ √|N| (Σ ‖γ_n‖²)^{1/2}`. -/
theorem sum_norm_le_sqrt_card_mul {ν : Type*} (N : Finset ν) (γ : ν → ℂ) :
    ∑ n ∈ N, ‖γ n‖ ≤ Real.sqrt N.card * Real.sqrt (∑ n ∈ N, ‖γ n‖ ^ 2) := by
  have := Real.sum_mul_le_sqrt_mul_sqrt N (fun _ => (1 : ℝ)) (fun n => ‖γ n‖)
  simpa using this


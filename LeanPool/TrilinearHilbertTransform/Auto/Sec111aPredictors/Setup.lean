      2 * Real.pi * |ξ - c| := by
    intro ξ
    rw [show ((ξ : ℂ) - c) = ((ξ - c : ℝ) : ℂ) by push_cast; ring, norm_mul, norm_mul,
      norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Complex.norm_real,
      Real.norm_of_nonneg Real.pi_pos.le, Real.norm_eq_abs]

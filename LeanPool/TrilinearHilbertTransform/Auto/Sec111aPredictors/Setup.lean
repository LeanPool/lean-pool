    (hM : ∀ ξ, ‖m ξ‖ ≤ M) (G : Lp ℂ 2 (volume : Measure ℝ)) :
    ‖(memLp_two_mul_bounded hm hM G).toLp (fun ξ => m ξ * G ξ)‖ ^ 2 =
      ∫ ξ, ‖m ξ‖ ^ 2 * ‖G ξ‖ ^ 2 := by

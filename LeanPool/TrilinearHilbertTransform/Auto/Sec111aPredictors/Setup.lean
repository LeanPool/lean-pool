    ∑ i ∈ S, r⁻¹ * ‖∫ y, conj ((Real.fourierChar (c * y) : ℂ) * θ i y) * F y‖ ^ 2 ≤
      2 * A ^ 2 * ∫ ξ, bumpMultiplier (r * (ξ - c)) *
        ‖(𝓕 F : Lp ℂ 2 (volume : Measure ℝ)) ξ‖ ^ 2 := by

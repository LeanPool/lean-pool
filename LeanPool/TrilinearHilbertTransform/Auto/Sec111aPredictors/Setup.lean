/-- Parseval for a test function in `L¹ ∩ L²` against an `L²` class. -/
theorem integral_conj_mul_eq_fourier {τ : ℝ → ℂ} (hτ1 : Integrable τ) (hτ2 : MemLp τ 2)
    (F : Lp ℂ 2 (volume : Measure ℝ)) :
    ∫ y, conj (τ y) * F y =
      ∫ ξ, conj (𝓕 τ ξ) * (𝓕 F : Lp ℂ 2 (volume : Measure ℝ)) ξ := by
  have h := Lp.inner_fourier_eq (hτ2.toLp τ) F
  rw [L2.inner_def, L2.inner_def] at h
  have e1 : ∫ y, conj (τ y) * F y =
      ∫ y, inner ℂ ((hτ2.toLp τ : Lp ℂ 2 (volume : Measure ℝ)) y) (F y) := by
    apply integral_congr_ae
    filter_upwards [MemLp.coeFn_toLp hτ2] with y hy
    rw [hy]; simp [mul_comm]
  have e2 : ∫ ξ, conj (𝓕 τ ξ) * (𝓕 F : Lp ℂ 2 (volume : Measure ℝ)) ξ =
      ∫ ξ, inner ℂ ((𝓕 (hτ2.toLp τ) : Lp ℂ 2 (volume : Measure ℝ)) ξ)
        ((𝓕 F : Lp ℂ 2 (volume : Measure ℝ)) ξ) := by
    apply integral_congr_ae
    filter_upwards [fourierLp_ae_eq_fourier hτ1 hτ2] with ξ hξ
    rw [hξ]; simp [mul_comm]
  rw [e1, e2, h]

/-- A bounded measurable multiplier of an `L²` class. -/
theorem memLp_two_mul_bounded {m : ℝ → ℂ} (hm : Measurable m) {M : ℝ}
    (hM : ∀ ξ, ‖m ξ‖ ≤ M) (G : Lp ℂ 2 (volume : Measure ℝ)) :
    MemLp (fun ξ => m ξ * G ξ) 2 volume := by
  have hG := Lp.memLp G
  refine MemLp.of_le (hG.const_mul ((max M 0 : ℝ) : ℂ)) ?_ ?_
  · exact hm.aestronglyMeasurable.mul (Lp.aestronglyMeasurable G)
  · filter_upwards with ξ
    rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_of_nonneg (le_max_right _ _)]
    exact mul_le_mul_of_nonneg_right ((hM ξ).trans (le_max_left _ _)) (norm_nonneg _)


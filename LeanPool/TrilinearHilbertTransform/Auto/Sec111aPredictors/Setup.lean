    if |r * (ξ - c)| ≤ 1 then conj (2 * Real.pi * Complex.I * (ξ - c)) else 0 with hmL
  set mH : ℝ → ℂ := fun ξ =>
    if |r * (ξ - c)| ≤ 1 then 0 else conj ((2 * Real.pi * Complex.I * (ξ - c)) ^ 2)⁻¹ with hmH
  have hlowm : MeasurableSet {ξ : ℝ | |r * (ξ - c)| ≤ 1} :=
    measurableSet_le (by fun_prop) measurable_const

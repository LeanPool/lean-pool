theorem sum_setIntegral_disjoint_le {ι : Type*} (S : Finset ι) (s : ι → Set ℝ)
    (hs : ∀ i, MeasurableSet (s i)) (hdisj : (S : Set ι).PairwiseDisjoint s)
    {g : ℝ → ℝ} (hg0 : ∀ y, 0 ≤ g y) (hgi : Integrable g) :

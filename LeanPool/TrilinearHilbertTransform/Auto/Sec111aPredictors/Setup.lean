  have hpt : ∀ y, ‖conj (g y) * K y‖ =
      (Set.Ico a (a + r)).indicator (fun y => ‖g y‖ * ‖K y‖) y := by
    intro y
    by_cases hy : y ∈ Set.Ico a (a + r)
    · rw [Set.indicator_of_mem hy, norm_mul, RCLike.norm_conj]
    · rw [Set.indicator_of_notMem hy, hgs y hy]; simp
  refine (norm_integral_le_integral_norm _).trans ?_
  simp_rw [hpt]
  rw [integral_indicator measurableSet_Ico]
  have : IsFiniteMeasure (volume.restrict (Set.Ico a (a + r))) := by
    constructor; rw [Measure.restrict_apply_univ]; exact measure_Ico_lt_top
  have hg2 : MemLp g 2 (volume.restrict (Set.Ico a (a + r))) :=
    MemLp.of_bound hgm.aestronglyMeasurable B (Filter.Eventually.of_forall hgb)
  have hK2' : MemLp (K : ℝ → ℂ) 2 (volume.restrict (Set.Ico a (a + r))) :=
    (Lp.memLp K).restrict _
  have hcs := integral_norm_mul_le_sqrt hg2 hK2'
  refine hcs.trans (mul_le_mul_of_nonneg_right ?_ (Real.sqrt_nonneg _))
  have hgsq : ∫ y in Set.Ico a (a + r), ‖g y‖ ^ 2 ≤ B ^ 2 * r := by
    calc ∫ y in Set.Ico a (a + r), ‖g y‖ ^ 2 ≤ ∫ y in Set.Ico a (a + r), B ^ 2 :=
          setIntegral_mono_on (Measure.integrableOn_of_bounded (M := B ^ 2) (by simp)
            (hgm.norm.pow_const 2).aestronglyMeasurable
            (Filter.Eventually.of_forall fun y => by
              rw [Real.norm_of_nonneg (by positivity)]
              exact pow_le_pow_left₀ (norm_nonneg _) (hgb y) 2))
            (integrableOn_const (by simp) (by simp)) measurableSet_Ico
            (fun y _ => pow_le_pow_left₀ (norm_nonneg _) (hgb y) 2)
      _ = B ^ 2 * r := by
          rw [setIntegral_const, smul_eq_mul, Real.volume_real_Ico_of_le (by linarith only [hr])]
          ring

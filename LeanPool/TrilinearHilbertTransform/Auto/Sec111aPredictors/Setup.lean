/-- The frequency weight of the single-scale square function: quadratic vanishing at
the center and fourth-power decay away from it. -/
noncomputable def bumpMultiplier (η : ℝ) : ℝ :=
  if |η| ≤ 1 then (2 * Real.pi * η) ^ 2 else ((2 * Real.pi * η) ^ 2)⁻¹ ^ 2

theorem bumpMultiplier_nonneg (η : ℝ) : 0 ≤ bumpMultiplier η := by
  unfold bumpMultiplier; split_ifs <;> positivity

theorem measurable_bumpMultiplier : Measurable bumpMultiplier := by
  unfold bumpMultiplier
  exact Measurable.ite (measurableSet_le (by fun_prop) measurable_const) (by fun_prop)
    (by fun_prop)


  exact setIntegral_le_integral hgi (Filter.Eventually.of_forall hg0)

/-- Fourier transform of a compactly supported `C¹` derivative. -/
theorem fourier_deriv_compact {Θ : ℝ → ℂ} (hΘ : ContDiff ℝ 1 Θ) (hΘc : HasCompactSupport Θ)
    (η : ℝ) : 𝓕 (deriv Θ) η = (2 * Real.pi * Complex.I * η) * 𝓕 Θ η := by
  have h := Real.fourier_deriv (hΘ.continuous.integrable_of_hasCompactSupport hΘc)
    (hΘ.differentiable one_ne_zero)
    ((hΘ.continuous_deriv le_rfl).integrable_of_hasCompactSupport hΘc.deriv)
  rw [h]; simp [smul_eq_mul]


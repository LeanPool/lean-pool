    have hY0 : 0 ≤ Y := setIntegral_nonneg measurableSet_Ico fun _ _ => by positivity
    set x := A * r * Real.sqrt r * Real.sqrt X with hx
    set z := A / r ^ 2 * Real.sqrt r * Real.sqrt Y with hz
    have hx0 : 0 ≤ x := by positivity
    have hz0 : 0 ≤ z := by positivity
    have hnorm : ‖∫ y, conj (τ y) * F y‖ ≤ x + z := by
      rw [hrow]; exact (norm_add_le _ _).trans (add_le_add hL hH)
    have hx2 : x ^ 2 = A ^ 2 * r ^ 3 * X := by
      rw [hx, mul_pow, mul_pow, mul_pow, Real.sq_sqrt hr.le, Real.sq_sqrt hX0]; ring
    have hz2 : z ^ 2 = A ^ 2 * (r ^ 3)⁻¹ * Y := by
      rw [hz, mul_pow, mul_pow, div_pow, Real.sq_sqrt hr.le, Real.sq_sqrt hY0]
      field_simp
    have hsq : ‖∫ y, conj (τ y) * F y‖ ^ 2 ≤ 2 * (x ^ 2 + z ^ 2) := by
      have := pow_le_pow_left₀ (norm_nonneg _) hnorm 2
      nlinarith only [sq_nonneg (x - z), this]
    change r⁻¹ * ‖∫ y, conj (τ y) * F y‖ ^ 2 ≤ _
    calc r⁻¹ * ‖∫ y, conj (τ y) * F y‖ ^ 2 ≤ r⁻¹ * (2 * (x ^ 2 + z ^ 2)) :=
          mul_le_mul_of_nonneg_left hsq (by positivity)
      _ = 2 * A ^ 2 * (r ^ 2 * X + (r ^ 4)⁻¹ * Y) := by
          rw [hx2, hz2]; field_simp
  -- summing over the disjoint cells
  have hKL2 : Integrable (fun y => ‖KL y‖ ^ 2) := (Lp.memLp KL).integrable_norm_pow two_ne_zero
  have hKH2 : Integrable (fun y => ‖KH y‖ ^ 2) := (Lp.memLp KH).integrable_norm_pow two_ne_zero
  have hsumL := sum_setIntegral_disjoint_le S (fun i => Set.Ico (a i) (a i + r))
    (fun _ => measurableSet_Ico) hdisj (fun y => by positivity) hKL2
  have hsumH := sum_setIntegral_disjoint_le S (fun i => Set.Ico (a i) (a i + r))
    (fun _ => measurableSet_Ico) hdisj (fun y => by positivity) hKH2
  have hnL : ∫ y, ‖KL y‖ ^ 2 = ∫ ξ, ‖mL ξ‖ ^ 2 * ‖Fh ξ‖ ^ 2 := by
    rw [← Lp_norm_sq_eq_integral, ← Lp.norm_fourier_eq KL, hFKL, hKhL,
      norm_sq_toLp_mul hmLm hmLb Fh]
  have hnH : ∫ y, ‖KH y‖ ^ 2 = ∫ ξ, ‖mH ξ‖ ^ 2 * ‖Fh ξ‖ ^ 2 := by
    rw [← Lp_norm_sq_eq_integral, ← Lp.norm_fourier_eq KH, hFKH, hKhH,
      norm_sq_toLp_mul hmHm hmHb Fh]
  have hFh2i : Integrable (fun ξ => ‖Fh ξ‖ ^ 2) := hFh2.integrable_norm_pow two_ne_zero
  have hmLi : Integrable (fun ξ => ‖mL ξ‖ ^ 2 * ‖Fh ξ‖ ^ 2) :=
    hFh2i.bdd_mul (c := (2 * Real.pi / r) ^ 2) (hmLm.norm.pow_const 2).aestronglyMeasurable
      (Filter.Eventually.of_forall fun ξ => by
        rw [Real.norm_of_nonneg (by positivity)]
        exact pow_le_pow_left₀ (norm_nonneg _) (hmLb ξ) 2)
  have hmHi : Integrable (fun ξ => ‖mH ξ‖ ^ 2 * ‖Fh ξ‖ ^ 2) :=
    hFh2i.bdd_mul (c := (r ^ 2) ^ 2) (hmHm.norm.pow_const 2).aestronglyMeasurable
      (Filter.Eventually.of_forall fun ξ => by
        rw [Real.norm_of_nonneg (by positivity)]
        exact pow_le_pow_left₀ (norm_nonneg _) (hmHb ξ) 2)
  have hpw : ∀ ξ, r ^ 2 * ‖mL ξ‖ ^ 2 + (r ^ 4)⁻¹ * ‖mH ξ‖ ^ 2 =
      bumpMultiplier (r * (ξ - c)) := by
    intro ξ
    simp only [hmL, hmH, bumpMultiplier]
    split_ifs with h
    · rw [RCLike.norm_conj, hnorm, norm_zero]
      rw [mul_pow, mul_pow, sq_abs]; ring
    · rw [RCLike.norm_conj, norm_inv, norm_pow, hnorm, norm_zero]
      rw [abs_mul, abs_of_pos hr, not_le] at h
      have hξc : |ξ - c| ≠ 0 := by intro h0; rw [h0, mul_zero] at h; linarith
      rw [mul_pow, mul_pow, mul_pow, sq_abs]
      field_simp
      ring
  calc ∑ i ∈ S, r⁻¹ * ‖∫ y, conj ((Real.fourierChar (c * y) : ℂ) * θ i y) * F y‖ ^ 2
      ≤ ∑ i ∈ S, 2 * A ^ 2 * (r ^ 2 * (∫ y in Set.Ico (a i) (a i + r), ‖KL y‖ ^ 2) +
          (r ^ 4)⁻¹ * ∫ y in Set.Ico (a i) (a i + r), ‖KH y‖ ^ 2) := Finset.sum_le_sum hcell
    _ = 2 * A ^ 2 * (r ^ 2 * (∑ i ∈ S, ∫ y in Set.Ico (a i) (a i + r), ‖KL y‖ ^ 2) +
          (r ^ 4)⁻¹ * ∑ i ∈ S, ∫ y in Set.Ico (a i) (a i + r), ‖KH y‖ ^ 2) := by
        rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib, Finset.mul_sum]
    _ ≤ 2 * A ^ 2 * (r ^ 2 * (∫ y, ‖KL y‖ ^ 2) + (r ^ 4)⁻¹ * ∫ y, ‖KH y‖ ^ 2) := by
        gcongr
    _ = 2 * A ^ 2 * ∫ ξ, bumpMultiplier (r * (ξ - c)) * ‖Fh ξ‖ ^ 2 := by
        rw [hnL, hnH, ← integral_const_mul, ← integral_const_mul, ← integral_add
          (hmLi.const_mul _) (hmHi.const_mul _)]
        congr 2; funext ξ; rw [← hpw ξ]; ring

/-- The dyadic band envelope of `bumpMultiplier`. -/
noncomputable def bumpBandBound (ℓ : ℤ) : ℝ :=
  if ℓ ≤ 0 then (2 * Real.pi) ^ 2 * 4 ^ (ℓ + 1) else ((2 * Real.pi) ^ 4)⁻¹ * (16 : ℝ) ^ (-ℓ)

theorem bumpBandBound_nonneg (ℓ : ℤ) : 0 ≤ bumpBandBound ℓ := by
  unfold bumpBandBound; split_ifs <;> positivity

theorem bumpMultiplier_le_band {η : ℝ} {ℓ : ℤ} (h1 : (2 : ℝ) ^ ℓ ≤ |η|)
    (h2 : |η| < (2 : ℝ) ^ (ℓ + 1)) : bumpMultiplier η ≤ bumpBandBound ℓ := by
  have hπ : 0 < 2 * Real.pi := by positivity
  have hπ1 : 1 ≤ 2 * Real.pi := by nlinarith only [Real.pi_gt_three]
  unfold bumpMultiplier bumpBandBound
  have hη0 : 0 < |η| := lt_of_lt_of_le (zpow_pos (by norm_num) ℓ) h1
  split_ifs with hη hℓ hℓ
  · -- low frequency, nonpositive band
    rw [mul_pow, ← sq_abs η]
    apply mul_le_mul_of_nonneg_left _ (by positivity)
    have : |η| ^ 2 ≤ ((2 : ℝ) ^ (ℓ + 1)) ^ 2 := pow_le_pow_left₀ (abs_nonneg _) h2.le 2
    calc |η| ^ 2 ≤ ((2 : ℝ) ^ (ℓ + 1)) ^ 2 := this
      _ = (4 : ℝ) ^ (ℓ + 1) := by
          rw [← zpow_natCast, ← zpow_mul, show (4 : ℝ) = 2 ^ (2 : ℤ) by norm_num, ← zpow_mul]
          ring_nf
  · -- `|η| ≤ 1` forces `ℓ ≤ 0`
    exfalso
    have : (2 : ℝ) ^ (1 : ℤ) ≤ (2 : ℝ) ^ ℓ := zpow_le_zpow_right₀ (by norm_num) (by omega)
    norm_num at this; linarith
  · -- high frequency in a nonpositive band: only `ℓ = 0`
    have hℓ0 : ℓ = 0 := by
      by_contra h
      have hneg : ℓ + 1 ≤ 0 := by omega
      have : (2 : ℝ) ^ (ℓ + 1) ≤ 1 := zpow_le_one_of_nonpos₀ (by norm_num) hneg
      linarith
    subst hℓ0
    have h1' : 1 < |η| := lt_of_not_ge hη
    have : ((2 * Real.pi * η) ^ 2)⁻¹ ^ 2 ≤ 1 := by
      have hb : 1 ≤ (2 * Real.pi * η) ^ 2 := by
        rw [mul_pow, ← sq_abs η]
        exact one_le_mul_of_one_le_of_one_le (one_le_pow₀ hπ1) (one_le_pow₀ h1'.le)
      exact pow_le_one₀ (by positivity) (inv_le_one_of_one_le₀ hb)
    calc ((2 * Real.pi * η) ^ 2)⁻¹ ^ 2 ≤ 1 := this
      _ ≤ (2 * Real.pi) ^ 2 * 4 ^ ((0 : ℤ) + 1) := by norm_num; nlinarith only [hπ1]
  · -- high frequency, positive band
    set t : ℝ := (2 : ℝ) ^ ℓ with ht
    have ht0 : 0 < t := zpow_pos (by norm_num) ℓ
    have h16' : (16 : ℝ) ^ ℓ = t ^ 4 := by
      rw [ht, ← zpow_natCast, ← zpow_mul, show (16 : ℝ) = 2 ^ (4 : ℤ) by norm_num, ← zpow_mul]
      congr 1; push_cast; ring
    have h16 : (16 : ℝ) ^ (-ℓ) = (t ^ 4)⁻¹ := by rw [zpow_neg, h16']
    rw [h16]
    have h4 : t ^ 4 ≤ η ^ 4 := by
      rw [show η ^ 4 = |η| ^ 4 by rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, pow_mul, sq_abs]]
      exact pow_le_pow_left₀ ht0.le h1 4
    have e : ((2 * Real.pi * η) ^ 2)⁻¹ ^ 2 = ((2 * Real.pi) ^ 4)⁻¹ * (η ^ 4)⁻¹ := by
      rw [← inv_pow, ← pow_mul, mul_pow, mul_inv]
      norm_num
      ring
    rw [e]
    exact mul_le_mul_of_nonneg_left (inv_anti₀ (by positivity) h4) (by positivity)

theorem bumpMultiplier_le (η : ℝ) : bumpMultiplier η ≤ (2 * Real.pi) ^ 2 := by
  have hπ1 : 1 ≤ 2 * Real.pi := by nlinarith only [Real.pi_gt_three]
  unfold bumpMultiplier
  split_ifs with h
  · rw [mul_pow, ← sq_abs η]
    have : |η| ^ 2 ≤ 1 := pow_le_one₀ (abs_nonneg _) h
    nlinarith [sq_nonneg (2 * Real.pi)]
  · have hb : 1 ≤ (2 * Real.pi * η) ^ 2 := by
      rw [mul_pow, ← sq_abs η]
      exact one_le_mul_of_one_le_of_one_le (one_le_pow₀ hπ1)
        (one_le_pow₀ (le_of_lt (lt_of_not_ge h)))
    calc ((2 * Real.pi * η) ^ 2)⁻¹ ^ 2 ≤ 1 :=
          pow_le_one₀ (by positivity) (inv_le_one_of_one_le₀ hb)
      _ ≤ (2 * Real.pi) ^ 2 := one_le_pow₀ hπ1

theorem hasSum_half_pow_natAbs : HasSum (fun ℓ : ℤ => ((1 : ℝ) / 2) ^ ℓ.natAbs) 3 := by
  have h1 : HasSum (fun n : ℕ => ((1 : ℝ) / 2) ^ ((n : ℤ)).natAbs) 2 := by
    simp only [Int.natAbs_natCast]; exact hasSum_geometric_two
  have e : (fun n : ℕ => ((1 : ℝ) / 2) ^ (-((n : ℤ) + 1)).natAbs) =
      fun n : ℕ => (1 / 2 : ℝ) * (1 / 2) ^ n := by
    funext n
    rw [show (-((n : ℤ) + 1)).natAbs = n + 1 by omega, pow_succ, mul_comm]
  have h2 : HasSum (fun n : ℕ => ((1 : ℝ) / 2) ^ (-((n : ℤ) + 1)).natAbs) 1 := by
    rw [e]
    have h := hasSum_geometric_two.mul_left (1 / 2 : ℝ)
    rwa [show (1 / 2 : ℝ) * 2 = 1 by norm_num] at h
  have h3 : HasSum (fun ℓ : ℤ => ((1 : ℝ) / 2) ^ ℓ.natAbs) (2 + 1) :=
    h1.of_nat_of_neg_add_one h2
  rwa [show (2 : ℝ) + 1 = 3 by norm_num] at h3

theorem band_term_le (ℓ : ℤ) :
    (1 + (2 : ℝ) ^ ℓ) * bumpBandBound ℓ ≤ 8 * (2 * Real.pi) ^ 2 * ((1 : ℝ) / 2) ^ ℓ.natAbs := by
  have hπ1 : 1 ≤ 2 * Real.pi := by nlinarith only [Real.pi_gt_three]
  unfold bumpBandBound
  split_ifs with h
  · have h2 : (2 : ℝ) ^ ℓ ≤ 1 := zpow_le_one_of_nonpos₀ (by norm_num) h
    have hhalf : ((1 : ℝ) / 2) ^ ℓ.natAbs = (2 : ℝ) ^ ℓ := by
      have hn : ((ℓ.natAbs : ℕ) : ℤ) = -ℓ := by omega
      rw [one_div, inv_pow, ← zpow_natCast, ← zpow_neg, hn, neg_neg]
    have h4 : (4 : ℝ) ^ (ℓ + 1) ≤ 4 * (2 : ℝ) ^ ℓ := by
      rw [zpow_add₀ (by norm_num), zpow_one, mul_comm]
      apply mul_le_mul_of_nonneg_left _ (by norm_num)
      rw [show (4 : ℝ) = 2 ^ (2 : ℤ) by norm_num, ← zpow_mul]
      exact zpow_le_zpow_right₀ (by norm_num) (by omega)
    rw [hhalf]
    have h20 : 0 ≤ (2 : ℝ) ^ ℓ := by positivity
    have hp : 0 ≤ (2 * Real.pi) ^ 2 := by positivity
    calc (1 + (2 : ℝ) ^ ℓ) * ((2 * Real.pi) ^ 2 * 4 ^ (ℓ + 1))
        ≤ 2 * ((2 * Real.pi) ^ 2 * (4 * (2 : ℝ) ^ ℓ)) := by
          apply mul_le_mul (by linarith) (mul_le_mul_of_nonneg_left h4 hp) (by positivity)
            (by norm_num)
      _ = 8 * (2 * Real.pi) ^ 2 * (2 : ℝ) ^ ℓ := by ring
  · have hℓ : 1 ≤ ℓ := by omega
    have hhalf : ((1 : ℝ) / 2) ^ ℓ.natAbs = (2 : ℝ) ^ (-ℓ) := by
      have hn : ((ℓ.natAbs : ℕ) : ℤ) = ℓ := by omega
      rw [one_div, inv_pow, ← zpow_natCast, ← zpow_neg, hn]
    rw [hhalf]
    have h16 : (16 : ℝ) ^ (-ℓ) = (2 : ℝ) ^ (-ℓ) * (8 : ℝ) ^ (-ℓ) := by
      rw [← mul_zpow]; norm_num
    have h8 : (8 : ℝ) ^ (-ℓ) * (2 : ℝ) ^ ℓ ≤ 1 := by
      rw [zpow_neg, inv_mul_le_iff₀ (by positivity), mul_one]
      exact zpow_le_zpow_left₀ (by omega) (by norm_num) (by norm_num)
    have h8' : (8 : ℝ) ^ (-ℓ) ≤ 1 := zpow_le_one_of_nonpos₀ (by norm_num) (by omega)
    have hinv : ((2 * Real.pi) ^ 4)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (one_le_pow₀ hπ1)
    have hp : 1 ≤ (2 * Real.pi) ^ 2 := one_le_pow₀ hπ1
    have h2l : 0 < (2 : ℝ) ^ (-ℓ) := by positivity
    have h8l : 0 ≤ (8 : ℝ) ^ (-ℓ) := by positivity
    have h2p : 0 ≤ (2 : ℝ) ^ ℓ := by positivity
    rw [h16]
    calc (1 + (2 : ℝ) ^ ℓ) * (((2 * Real.pi) ^ 4)⁻¹ * ((2 : ℝ) ^ (-ℓ) * (8 : ℝ) ^ (-ℓ)))
        ≤ (1 + (2 : ℝ) ^ ℓ) * ((2 : ℝ) ^ (-ℓ) * (8 : ℝ) ^ (-ℓ)) := by
          apply mul_le_mul_of_nonneg_left _ (by positivity)
          calc ((2 * Real.pi) ^ 4)⁻¹ * ((2 : ℝ) ^ (-ℓ) * (8 : ℝ) ^ (-ℓ))
              ≤ 1 * ((2 : ℝ) ^ (-ℓ) * (8 : ℝ) ^ (-ℓ)) :=
                mul_le_mul_of_nonneg_right hinv (by positivity)
            _ = _ := one_mul _
      _ = (2 : ℝ) ^ (-ℓ) * ((8 : ℝ) ^ (-ℓ) + (8 : ℝ) ^ (-ℓ) * (2 : ℝ) ^ ℓ) := by ring
      _ ≤ (2 : ℝ) ^ (-ℓ) * (1 + 1) := by gcongr
      _ ≤ 8 * (2 * Real.pi) ^ 2 * (2 : ℝ) ^ (-ℓ) := by nlinarith

/-- Blueprint lem:predictors, proof line 1531: if every dyadic band
`2^ℓ ≤ |η| < 2^(ℓ+1)` contains at most `N (1 + 2^ℓ)` of the normalized frequency
offsets, then the summed square-function weight is at most a fixed multiple of `N`. -/
theorem sum_bumpMultiplier_le {ι : Type*} (T : Finset ι) (η : ι → ℝ) {N : ℝ} (hN : 0 ≤ N)
    (hband : ∀ ℓ : ℤ, ((T.filter (fun p => (2 : ℝ) ^ ℓ ≤ |η p| ∧
      |η p| < (2 : ℝ) ^ (ℓ + 1))).card : ℝ) ≤ N * (1 + (2 : ℝ) ^ ℓ)) :
    ∑ p ∈ T, bumpMultiplier (η p) ≤ 24 * (2 * Real.pi) ^ 2 * N := by
  classical
  set band : ℤ → ι → Prop := fun ℓ p => (2 : ℝ) ^ ℓ ≤ |η p| ∧ |η p| < (2 : ℝ) ^ (ℓ + 1)
    with hband_def
  set g : ι → ℤ → ℝ := fun p ℓ => if band ℓ p then bumpBandBound ℓ else 0 with hg
  have hg0 : ∀ p ℓ, 0 ≤ g p ℓ := fun p ℓ => by
    simp only [hg]; split_ifs
    · exact bumpBandBound_nonneg ℓ
    · exact le_rfl
  have hdom : Summable (fun ℓ : ℤ => 8 * (2 * Real.pi) ^ 2 * ((1 : ℝ) / 2) ^ ℓ.natAbs) :=
    hasSum_half_pow_natAbs.summable.mul_left _
  have hbb : ∀ ℓ, bumpBandBound ℓ ≤ 8 * (2 * Real.pi) ^ 2 * ((1 : ℝ) / 2) ^ ℓ.natAbs := by
    intro ℓ
    refine le_trans ?_ (band_term_le ℓ)
    have h2 : (0 : ℝ) ≤ (2 : ℝ) ^ ℓ := by positivity
    nlinarith [bumpBandBound_nonneg ℓ]
  have hgs : ∀ p, Summable (g p) := fun p =>
    Summable.of_nonneg_of_le (hg0 p) (fun ℓ => by
      simp only [hg]; split_ifs
      · exact hbb ℓ
      · positivity) hdom
  -- each weight is bounded by its band envelope
  have hpt : ∀ p, bumpMultiplier (η p) ≤ ∑' ℓ, g p ℓ := by
    intro p
    by_cases h0 : η p = 0
    · rw [h0]; simp only [bumpMultiplier, abs_zero, zero_le_one, ↓reduceIte, mul_zero,
        ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow]
      exact tsum_nonneg (hg0 p)
    · obtain ⟨ℓ, hℓ⟩ := exists_mem_Ico_zpow (abs_pos.mpr h0) (by norm_num : (1 : ℝ) < 2)
      have hb : band ℓ p := ⟨hℓ.1, hℓ.2⟩
      calc bumpMultiplier (η p) ≤ bumpBandBound ℓ := bumpMultiplier_le_band hℓ.1 hℓ.2
        _ = g p ℓ := by simp only [hg, hb, ↓reduceIte]
        _ ≤ ∑' ℓ, g p ℓ := (hgs p).le_tsum ℓ (fun j _ => hg0 p j)
  -- exchange the finite sum and the band sum
  have hswap : ∑ p ∈ T, ∑' ℓ, g p ℓ = ∑' ℓ, ∑ p ∈ T, g p ℓ :=
    (Summable.tsum_finsetSum fun p _ => hgs p).symm
  have hcount : ∀ ℓ, ∑ p ∈ T, g p ℓ ≤ 8 * (2 * Real.pi) ^ 2 * ((1 : ℝ) / 2) ^ ℓ.natAbs * N := by
    intro ℓ
    have he : ∑ p ∈ T, g p ℓ = ((T.filter (band ℓ)).card : ℝ) * bumpBandBound ℓ := by
      simp only [hg]
      rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
    rw [he]
    calc ((T.filter (band ℓ)).card : ℝ) * bumpBandBound ℓ
        ≤ N * (1 + (2 : ℝ) ^ ℓ) * bumpBandBound ℓ :=
          mul_le_mul_of_nonneg_right (hband ℓ) (bumpBandBound_nonneg ℓ)
      _ = N * ((1 + (2 : ℝ) ^ ℓ) * bumpBandBound ℓ) := by ring
      _ ≤ N * (8 * (2 * Real.pi) ^ 2 * ((1 : ℝ) / 2) ^ ℓ.natAbs) :=
          mul_le_mul_of_nonneg_left (band_term_le ℓ) hN
      _ = _ := by ring
  have hsum2 : Summable (fun ℓ => ∑ p ∈ T, g p ℓ) := summable_sum fun p _ => hgs p
  calc ∑ p ∈ T, bumpMultiplier (η p) ≤ ∑ p ∈ T, ∑' ℓ, g p ℓ := Finset.sum_le_sum fun p _ => hpt p
    _ = ∑' ℓ, ∑ p ∈ T, g p ℓ := hswap
    _ ≤ ∑' ℓ : ℤ, 8 * (2 * Real.pi) ^ 2 * ((1 : ℝ) / 2) ^ ℓ.natAbs * N :=
        Summable.tsum_le_tsum hcount hsum2 (hdom.mul_right N)
    _ = 24 * (2 * Real.pi) ^ 2 * N := by
        rw [tsum_mul_right, tsum_mul_left, hasSum_half_pow_natAbs.tsum_eq]; ring

/-- Blueprint lem:predictors, proof line 1531: the multi-scale square-function bound.
If the weights of all scale-frequency pairs sum to at most `M` at every frequency, the
modulated mean-zero bump rows over all pairs and cells are jointly Bessel. -/
theorem multiscale_bump_bessel {κ ι : Type*} (T : Finset κ) (r c : κ → ℝ)
    (hr : ∀ p, 0 < r p) (S : κ → Finset ι) (a : κ → ι → ℝ) {A : ℝ} (hA : 0 ≤ A)
    (hdisj : ∀ p, (S p : Set ι).PairwiseDisjoint (fun i => Set.Ico (a p i) (a p i + r p)))
    (θ Θ : κ → ι → ℝ → ℂ) (hΘ : ∀ p i, ContDiff ℝ 1 (Θ p i)) (hθ : ∀ p i, ContDiff ℝ 2 (θ p i))
    (hΘd : ∀ p i, deriv (Θ p i) = θ p i)
    (hΘs : ∀ p i y, y ∉ Set.Ico (a p i) (a p i + r p) → Θ p i y = 0)
    (hθ2s : ∀ p i y, y ∉ Set.Ico (a p i) (a p i + r p) → deriv (deriv (θ p i)) y = 0)
    (hΘb : ∀ p i y, ‖Θ p i y‖ ≤ A * r p)
    (hθ2b : ∀ p i y, ‖deriv (deriv (θ p i)) y‖ ≤ A / r p ^ 2)
    {M : ℝ} (hM : ∀ ξ, ∑ p ∈ T, bumpMultiplier (r p * (ξ - c p)) ≤ M)
    (F : Lp ℂ 2 (volume : Measure ℝ)) :
    ∑ p ∈ T, ∑ i ∈ S p, (r p)⁻¹ *
        ‖∫ y, conj ((Real.fourierChar (c p * y) : ℂ) * θ p i y) * F y‖ ^ 2 ≤
      2 * A ^ 2 * M * ‖F‖ ^ 2 := by
  set Fh : Lp ℂ 2 (volume : Measure ℝ) := 𝓕 F with hFh
  have hFh2i : Integrable (fun ξ => ‖Fh ξ‖ ^ 2) := (Lp.memLp Fh).integrable_norm_pow two_ne_zero
  have hint : ∀ p, Integrable (fun ξ => bumpMultiplier (r p * (ξ - c p)) * ‖Fh ξ‖ ^ 2) :=
    fun p => hFh2i.bdd_mul (c := (2 * Real.pi) ^ 2)
      ((measurable_bumpMultiplier.comp (by fun_prop))).aestronglyMeasurable
      (Filter.Eventually.of_forall fun ξ => by
        rw [Real.norm_of_nonneg (bumpMultiplier_nonneg _)]; exact bumpMultiplier_le _)
  calc ∑ p ∈ T, ∑ i ∈ S p, (r p)⁻¹ *
        ‖∫ y, conj ((Real.fourierChar (c p * y) : ℂ) * θ p i y) * F y‖ ^ 2
      ≤ ∑ p ∈ T, 2 * A ^ 2 * ∫ ξ, bumpMultiplier (r p * (ξ - c p)) * ‖Fh ξ‖ ^ 2 :=
        Finset.sum_le_sum fun p _ => cell_bump_square_function (S p) (a p) (hr p) hA (hdisj p)
          (θ p) (Θ p) (hΘ p) (hθ p) (hΘd p) (hΘs p) (hθ2s p) (hΘb p) (hθ2b p) F
    _ = 2 * A ^ 2 * ∫ ξ, (∑ p ∈ T, bumpMultiplier (r p * (ξ - c p))) * ‖Fh ξ‖ ^ 2 := by
        rw [← Finset.mul_sum, ← integral_finsetSum _ fun p _ => hint p]
        congr 2; funext ξ; rw [Finset.sum_mul]
    _ ≤ 2 * A ^ 2 * ∫ ξ, M * ‖Fh ξ‖ ^ 2 := by
        apply mul_le_mul_of_nonneg_left _ (by positivity)
        apply integral_mono (integrable_finsetSum _ (fun p _ => hint p) |>.congr
          (Filter.Eventually.of_forall fun ξ => by simp only; rw [Finset.sum_mul]))
          (hFh2i.const_mul M)
        intro ξ
        exact mul_le_mul_of_nonneg_right (hM ξ) (by positivity)
    _ = 2 * A ^ 2 * M * ‖F‖ ^ 2 := by
        rw [integral_const_mul, ← Lp_norm_sq_eq_integral, hFh, Lp.norm_fourier_eq]; ring

/-- The primitive of a continuous mean-zero bump supported in a cell is a `C¹`
function supported in the same cell. -/
theorem meanZero_bump_primitive {θ : ℝ → ℂ} (hθ : Continuous θ) {a r : ℝ} (hr : 0 < r)
    (hs : ∀ y, y ∉ Set.Ico a (a + r) → θ y = 0) (hmean : ∫ y, θ y = 0) {B : ℝ}
    (hB : ∀ y, ‖θ y‖ ≤ B) :
    ContDiff ℝ 1 (fun y => ∫ s in a..y, θ s) ∧
      deriv (fun y => ∫ s in a..y, θ s) = θ ∧
      (∀ y, y ∉ Set.Ico a (a + r) → ∫ s in a..y, θ s = 0) ∧
      ∀ y, ‖∫ s in a..y, θ s‖ ≤ B * r := by
  have hderiv : ∀ y, HasDerivAt (fun y => ∫ s in a..y, θ s) (θ y) y := fun y =>
    intervalIntegral.integral_hasDerivAt_right (hθ.intervalIntegrable _ _)
      (hθ.stronglyMeasurableAtFilter _ _) hθ.continuousAt
  have hd : deriv (fun y => ∫ s in a..y, θ s) = θ := funext fun y => (hderiv y).deriv
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB a)
  have hθa : θ a = 0 := by
    have hc : IsClosed {y | θ y = 0} := isClosed_eq hθ continuous_const
    have hsub : Set.Iio a ⊆ {y | θ y = 0} := fun y hy =>
      hs y (fun h => absurd h.1 (not_le.mpr hy))
    have h := hc.closure_subset_iff.mpr hsub
    rw [closure_Iio] at h
    exact h (le_refl a)
  have hleft : ∀ s, s ≤ a → θ s = 0 := by
    intro s hs1
    rcases hs1.lt_or_eq with h | h
    · exact hs s fun h' => by linarith [h'.1]
    · rw [h]; exact hθa
  have hsupp : ∀ y, y ∉ Set.Ico a (a + r) → ∫ s in a..y, θ s = 0 := by
    intro y hy
    rcases lt_or_ge y a with h | h
    · rw [intervalIntegral.integral_symm, intervalIntegral.integral_of_le h.le, neg_eq_zero]
      apply setIntegral_eq_zero_of_forall_eq_zero
      intro s hs'
      exact hleft s hs'.2
    · have hyr : a + r ≤ y := by
        by_contra hc; exact hy ⟨h, lt_of_not_ge hc⟩
      have hsplit := intervalIntegral.integral_add_adjacent_intervals
        (hθ.intervalIntegrable (μ := volume) a (a + r))
        (hθ.intervalIntegrable (μ := volume) (a + r) y)
      rw [← hsplit]
      have h1 : ∫ s in a..a + r, θ s = ∫ s, θ s := by
        rw [intervalIntegral.integral_of_le (by linarith), ← integral_Icc_eq_integral_Ioc]
        exact setIntegral_eq_integral_of_forall_compl_eq_zero fun s hs1 =>
          hs s fun h' => hs1 (Set.Ico_subset_Icc_self h')
      have h2 : ∫ s in a + r..y, θ s = 0 := by
        rw [intervalIntegral.integral_of_le hyr]
        apply setIntegral_eq_zero_of_forall_eq_zero
        intro s hs'
        exact hs s fun h' => by linarith [hs'.1, h'.2]
      rw [h1, h2, hmean, add_zero]
  refine ⟨?_, hd, hsupp, ?_⟩
  · rw [contDiff_one_iff_deriv]
    exact ⟨fun y => (hderiv y).differentiableAt, by rw [hd]; exact hθ⟩
  · intro y
    by_cases hy : y ∈ Set.Ico a (a + r)
    · have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := a) (b := y)
        (fun s _ => hB s)
      refine h.trans ?_
      rw [abs_of_nonneg (by linarith [hy.1])]
      exact mul_le_mul_of_nonneg_left (by linarith [hy.2]) hB0
    · rw [hsupp y hy, norm_zero]; positivity

/-- Blueprint lem:predictors, proof line 1531: the multi-scale square function for
smooth mean-zero bumps supported in disjoint cells, with `‖θ‖ ≤ A` and `‖θ''‖ ≤ A r⁻²`. -/
theorem multiscale_meanZero_bessel {κ ι : Type*} (T : Finset κ) (r c : κ → ℝ)
    (hr : ∀ p, 0 < r p) (S : κ → Finset ι) (a : κ → ι → ℝ) {A : ℝ} (hA : 0 ≤ A)
    (hdisj : ∀ p, (S p : Set ι).PairwiseDisjoint (fun i => Set.Ico (a p i) (a p i + r p)))
    (θ : κ → ι → ℝ → ℂ) (hθ : ∀ p i, ContDiff ℝ 2 (θ p i))
    (hθs : ∀ p i y, y ∉ Set.Ico (a p i) (a p i + r p) → θ p i y = 0)
    (hmean : ∀ p i, ∫ y, θ p i y = 0)
    (hθb : ∀ p i y, ‖θ p i y‖ ≤ A)
    (hθ2b : ∀ p i y, ‖deriv (deriv (θ p i)) y‖ ≤ A / r p ^ 2)
    {M : ℝ} (hM : ∀ ξ, ∑ p ∈ T, bumpMultiplier (r p * (ξ - c p)) ≤ M)
    (F : Lp ℂ 2 (volume : Measure ℝ)) :
    ∑ p ∈ T, ∑ i ∈ S p, (r p)⁻¹ *
        ‖∫ y, conj ((Real.fourierChar (c p * y) : ℂ) * θ p i y) * F y‖ ^ 2 ≤
      2 * A ^ 2 * M * ‖F‖ ^ 2 := by
  have hprim := fun p i => meanZero_bump_primitive (hθ p i).continuous (hr p) (hθs p i)
    (hmean p i) (hθb p i)
  have hθ2s : ∀ p i y, y ∉ Set.Ico (a p i) (a p i + r p) → deriv (deriv (θ p i)) y = 0 := by
    intro p i y hy
    have hcont : Continuous (deriv (deriv (θ p i))) := by
      have h := (hθ p i).continuous_iteratedDeriv 2 le_rfl
      rwa [iteratedDeriv_succ, iteratedDeriv_one] at h
    -- local vanishing away from the closed cell
    have hloc : ∀ z, (z < a p i ∨ a p i + r p < z) → deriv (deriv (θ p i)) z = 0 := by
      intro z hz
      have hev : θ p i =ᶠ[nhds z] fun _ => 0 := by
        rcases hz with hz | hz
        · filter_upwards [Iio_mem_nhds hz] with w hw
          exact hθs p i w fun h => absurd h.1 (not_le.mpr hw)
        · filter_upwards [Ioi_mem_nhds hz] with w hw
          exact hθs p i w fun h => absurd h.2 (not_lt.mpr hw.le)
      have hev' : deriv (θ p i) =ᶠ[nhds z] fun _ => 0 := by
        filter_upwards [hev.eventually_nhds] with w hw
        rw [Filter.EventuallyEq.deriv_eq (f₁ := θ p i) (f := fun _ => (0 : ℂ)) hw]; simp
      rw [hev'.deriv_eq]; simp
    rcases lt_or_ge y (a p i) with h | h
    · exact hloc y (Or.inl h)
    · have hyr : a p i + r p ≤ y := by
        by_contra hc; exact hy ⟨h, lt_of_not_ge hc⟩
      rcases hyr.lt_or_eq with h' | h'
      · exact hloc y (Or.inr h')
      · have hcl : IsClosed {z | deriv (deriv (θ p i)) z = 0} := isClosed_eq hcont continuous_const
        have hsub : Set.Ioi (a p i + r p) ⊆ {z | deriv (deriv (θ p i)) z = 0} :=
          fun z hz => hloc z (Or.inr hz)
        have hc := hcl.closure_subset_iff.mpr hsub
        rw [closure_Ioi] at hc
        rw [← h']; exact hc (Set.mem_Ici.mpr le_rfl)
  exact multiscale_bump_bessel T r c hr S a hA hdisj θ
    (fun p i y => ∫ s in a p i..y, θ p i s) (fun p i => (hprim p i).1) hθ
    (fun p i => (hprim p i).2.1) (fun p i => (hprim p i).2.2.1) hθ2s
    (fun p i y => (hprim p i).2.2.2 y) hθ2b hM F

/-- The derivative envelope of the unit-rescaled admissible kernel at order `m`. -/
noncomputable def kernelUnitEnvelope (κ : LocalKernelClass) (m : ℕ) : ℝ :=
  4 ^ 2 * (16 ^ m * kernelDerivBound κ m)

/-- A fixed unit-scale plateau bump: equal to one on `|u| ≤ 1/2 - m`, supported in
`|u| < 1/2 - m/2`, with bounded derivatives up to order two and positive integral. -/
theorem exists_unit_plateau {m : ℝ} (hm : 0 < m) (hm4 : m ≤ 1 / 4) :
    ∃ (η₁ : ℝ → ℝ) (K I : ℝ), ContDiff ℝ (⊤ : ℕ∞) η₁ ∧ (∀ u, 0 ≤ η₁ u ∧ η₁ u ≤ 1) ∧
      (∀ u, |u| ≤ 1 / 2 - m → η₁ u = 1) ∧ (∀ u, 1 / 2 - m / 2 ≤ |u| → η₁ u = 0) ∧
      0 < I ∧ ∫ u, η₁ u = I ∧ 0 ≤ K ∧
      ∀ u (i : ℕ), i ≤ 2 → ‖iteratedFDeriv ℝ i η₁ u‖ ≤ K := by
  let f : ContDiffBump (0 : ℝ) := ⟨1 / 2 - m, 1 / 2 - m / 2, by linarith, by linarith⟩
  have hfc : ContDiff ℝ (⊤ : ℕ∞) f := f.contDiff
  have hcs : HasCompactSupport (f : ℝ → ℝ) := f.hasCompactSupport
  have hbd : ∀ i : ℕ, ∃ C, ∀ u, ‖iteratedFDeriv ℝ i (f : ℝ → ℝ) u‖ ≤ C := fun i =>
    ((hfc.continuous_iteratedFDeriv (by exact_mod_cast le_top)).bounded_above_of_compact_support
      (hcs.iteratedFDeriv i))
  obtain ⟨C0, hC0⟩ := hbd 0
  obtain ⟨C1, hC1⟩ := hbd 1
  obtain ⟨C2, hC2⟩ := hbd 2
  refine ⟨f, max (max C0 C1) (max C2 0), ∫ u, f u, hfc,
    fun u => ⟨f.nonneg, f.le_one⟩, fun u hu => ?_, fun u hu => ?_,
    f.integral_pos, rfl, le_max_of_le_right (le_max_right _ _), fun u i hi => ?_⟩
  · apply f.one_of_mem_closedBall
    rw [Metric.mem_closedBall, Real.dist_eq, sub_zero]; exact hu
  · apply f.zero_of_le_dist
    rw [Real.dist_eq, sub_zero]; exact hu
  · interval_cases i
    · exact (hC0 u).trans (le_max_of_le_left (le_max_left _ _))
    · exact (hC1 u).trans (le_max_of_le_left (le_max_right _ _))
    · exact (hC2 u).trans (le_max_of_le_right (le_max_left _ _))

/-- The unit plateau transported to the cell `[a₀, a₀ + r)`. -/
noncomputable def plateauAt (η₁ : ℝ → ℝ) (a₀ r y : ℝ) : ℂ := (η₁ ((y - (a₀ + r / 2)) / r) : ℂ)

/-- The mean-zero projection `Π(η e(α ·)) = η e(α ·) - (∫ η e(α ·)) η / ∫ η`. -/
noncomputable def meanZeroWave (η₁ : ℝ → ℝ) (I a₀ r α y : ℝ) : ℂ :=
  plateauAt η₁ a₀ r y * (Real.fourierChar (α * y) : ℂ) -
    (∫ s, plateauAt η₁ a₀ r s * (Real.fourierChar (α * s) : ℂ)) *
      (plateauAt η₁ a₀ r y / ((r * I : ℝ) : ℂ))

section MeanZeroWave
variable {η₁ : ℝ → ℝ} {m K I : ℝ} (hm : 0 < m) (hη : ContDiff ℝ (⊤ : ℕ∞) η₁)
  (hη01 : ∀ u, 0 ≤ η₁ u ∧ η₁ u ≤ 1) (hη0 : ∀ u, 1 / 2 - m / 2 ≤ |u| → η₁ u = 0)
  (hI : 0 < I) (hIη : ∫ u, η₁ u = I) (hK : 0 ≤ K)
  (hKb : ∀ u (i : ℕ), i ≤ 2 → ‖iteratedFDeriv ℝ i η₁ u‖ ≤ K)
include hm hη0

theorem plateauAt_eq_zero {a₀ r : ℝ} (hr : 0 < r) {y : ℝ} (hy : y ∉ Set.Ico a₀ (a₀ + r)) :
    plateauAt η₁ a₀ r y = 0 := by
  unfold plateauAt
  rw [hη0, Complex.ofReal_zero]
  rw [abs_div, abs_of_pos hr, le_div_iff₀ hr]
  simp only [Set.mem_Ico, not_and_or, not_le, not_lt] at hy
  rcases hy with hy | hy
  · rw [abs_of_neg (by linarith)]; nlinarith
  · rw [abs_of_nonneg (by linarith)]; nlinarith

omit hm hη0 in
include hη in
theorem plateauAt_contDiff (a₀ r : ℝ) : ContDiff ℝ (⊤ : ℕ∞) (plateauAt η₁ a₀ r) := by
  unfold plateauAt
  exact Complex.ofRealCLM.contDiff.comp (hη.comp (by fun_prop))

omit hm hη0 in
include hIη in
theorem integral_plateauAt {a₀ r : ℝ} (hr : 0 < r) :
    ∫ y, plateauAt η₁ a₀ r y = ((r * I : ℝ) : ℂ) := by
  unfold plateauAt
  rw [integral_complex_ofReal]
  congr 1
  have h := Measure.integral_comp_div (fun u => η₁ u) r
  have e : ∫ y, η₁ ((y - (a₀ + r / 2)) / r) = ∫ y, η₁ (y / r) :=
    integral_sub_right_eq_self (fun y => η₁ (y / r)) (a₀ + r / 2)
  rw [e, h, hIη, abs_of_pos hr]; ring

omit hm hη0 in
include hη hKb in
/-- Geometric derivative bounds of the transported plateau. -/
theorem plateauAt_geomBound {a₀ r : ℝ} (hr : 0 < r) (y : ℝ) :
    GeomBound (plateauAt η₁ a₀ r) y K (1 / r) 2 := by
  set L : ℝ →L[ℝ] ℝ := (1 / r) • ContinuousLinearMap.id ℝ ℝ with hL
  have hLn : ‖L‖ = 1 / r := by
    rw [hL, norm_smul, ContinuousLinearMap.norm_id, mul_one, Real.norm_of_nonneg (by positivity)]
  have hbase : GeomBound η₁ (L y + -((a₀ + r / 2) / r)) K 1 2 := fun i hi => by
    rw [one_pow, mul_one]; exact hKb _ i hi
  have h := (GeomBound.comp_affine hη L (-((a₀ + r / 2) / r)) hbase).ofReal
    (hη.comp (L.contDiff.add contDiff_const))
  rw [hLn, mul_one] at h
  have he : plateauAt η₁ a₀ r = fun z => ((η₁ (L z + -((a₀ + r / 2) / r)) : ℝ) : ℂ) := by
    funext z; simp only [plateauAt, hL, smul_apply,
      ContinuousLinearMap.id_apply, smul_eq_mul]
    congr 2; field_simp; ring
  rw [he]; exact h

include hη hη01 hI hIη hK hKb in
/-- The mean-zero wave `Π(η e(α ·))` is a smooth mean-zero bump in the cell with
`‖θ‖ ≤ 2` and `‖θ''‖ ≤ 2K (1/r + 6π|α|)²`. -/
theorem meanZeroWave_props {a₀ r : ℝ} (hr : 0 < r) (α : ℝ) :
    ContDiff ℝ (⊤ : ℕ∞) (meanZeroWave η₁ I a₀ r α) ∧
      (∀ y, y ∉ Set.Ico a₀ (a₀ + r) → meanZeroWave η₁ I a₀ r α y = 0) ∧
      (∫ y, meanZeroWave η₁ I a₀ r α y = 0) ∧
      (∀ y, ‖meanZeroWave η₁ I a₀ r α y‖ ≤ 2) ∧
      ∀ y, ‖deriv (deriv (meanZeroWave η₁ I a₀ r α)) y‖ ≤
        2 * K * (1 / r + 6 * Real.pi * |α|) ^ 2 := by
  set P := plateauAt η₁ a₀ r with hP
  set E : ℝ → ℂ := fun y => (Real.fourierChar (α * y) : ℂ) with hE
  have hPc : ContDiff ℝ (⊤ : ℕ∞) P := plateauAt_contDiff hη a₀ r
  have hEc : ContDiff ℝ (⊤ : ℕ∞) E := chart_fourierChar_smooth.comp (contDiff_const.mul contDiff_id)
  have hEn : ∀ y, ‖E y‖ = 1 := fun y => Circle.norm_coe _
  have hPre : ∀ y, P y = ((η₁ ((y - (a₀ + r / 2)) / r) : ℝ) : ℂ) := fun y => rfl
  have hPn : ∀ y, ‖P y‖ ≤ 1 := fun y => by
    rw [hPre, Complex.norm_real, Real.norm_of_nonneg (hη01 _).1]; exact (hη01 _).2
  have hPs : ∀ y, y ∉ Set.Ico a₀ (a₀ + r) → P y = 0 := fun y hy => plateauAt_eq_zero hm hη0 hr hy
  have hPcs : HasCompactSupport P := hasCompactSupport_of_zero_outside_Ico hPs
  have hPi : Integrable P := hPc.continuous.integrable_of_hasCompactSupport hPcs
  have hAi : Integrable (fun y => P y * E y) :=
    (hPc.continuous.mul hEc.continuous).integrable_of_hasCompactSupport hPcs.mul_right
  have hrI : 0 < r * I := mul_pos hr hI
  have hrIc : ((r * I : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hrI.ne'
  set! cA := ∫ s, P s * E s with hcAdef
  have hPint : ∫ y, P y = ((r * I : ℝ) : ℂ) := integral_plateauAt hIη hr
  have hcA : ‖cA‖ ≤ r * I := by
    refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
    have h1 : ∫ s, ‖P s * E s‖ = ∫ s, η₁ ((s - (a₀ + r / 2)) / r) := by
      congr 1; funext s
      rw [norm_mul, hEn, mul_one, hPre, Complex.norm_real, Real.norm_of_nonneg (hη01 _).1]
    rw [h1]
    have h2 : ((∫ s, η₁ ((s - (a₀ + r / 2)) / r) : ℝ) : ℂ) = ((r * I : ℝ) : ℂ) := by
      rw [← hPint, ← integral_complex_ofReal]; rfl
    exact_mod_cast h2
  have hW : meanZeroWave η₁ I a₀ r α = fun y => P y * E y - cA * (P y / ((r * I : ℝ) : ℂ)) := rfl
  rw [hW]
  refine ⟨(hPc.mul hEc).sub (contDiff_const.mul (hPc.div_const _)), fun y hy => ?_, ?_,
    fun y => ?_, fun y => ?_⟩
  · simp [hPs y hy]
  · rw [integral_sub hAi ((hPi.div_const _).const_mul _), integral_const_mul, integral_div,
      hPint, div_self hrIc, mul_one, sub_self]
  · calc ‖P y * E y - cA * (P y / ((r * I : ℝ) : ℂ))‖
        ≤ ‖P y * E y‖ + ‖cA * (P y / ((r * I : ℝ) : ℂ))‖ := norm_sub_le _ _
      _ ≤ 1 + 1 := by
          gcongr
          · rw [norm_mul, hEn, mul_one]; exact hPn y
          · rw [norm_mul, norm_div, Complex.norm_real, Real.norm_of_nonneg hrI.le]
            calc ‖cA‖ * (‖P y‖ / (r * I)) ≤ (r * I) * (1 / (r * I)) :=
                  mul_le_mul hcA (div_le_div_of_nonneg_right (hPn y) hrI.le) (by positivity)
                    hrI.le
              _ = 1 := by field_simp
      _ = 2 := by norm_num
  · have hPg := plateauAt_geomBound hη hKb (a₀ := a₀) hr y
    have hEg : GeomBound E y 1 (3 * (2 * Real.pi) * |α|) 2 := by
      have h := GeomBound.fourierChar_affine (α • ContinuousLinearMap.id ℝ ℝ) 0 y 2
      have hn : ‖α • ContinuousLinearMap.id ℝ ℝ‖ = |α| := by
        rw [norm_smul, ContinuousLinearMap.norm_id, mul_one, Real.norm_eq_abs]
      have he : (fun z => (Real.fourierChar ((α • ContinuousLinearMap.id ℝ ℝ) z + 0) : ℂ)) =
          E := by
        funext z; simp [hE, smul_eq_mul]
      rw [he, hn] at h
      convert h using 2; norm_num
    have hAg := GeomBound.mul hPc hEc (by positivity : (0 : ℝ) ≤ 1 / r) hPg hEg
    have hA2 := hAg 2 le_rfl
    have hP2 := hPg 2 le_rfl
    have hd2 : deriv (deriv (fun y => P y * E y - cA * (P y / ((r * I : ℝ) : ℂ)))) y =
        iteratedDeriv 2 (fun y => P y * E y - cA * (P y / ((r * I : ℝ) : ℂ))) y := by
      rw [iteratedDeriv_succ, iteratedDeriv_one]
    rw [hd2, ← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
    have hsplit : (fun y => P y * E y - cA * (P y / ((r * I : ℝ) : ℂ))) =
        (fun y => P y * E y) - (cA / ((r * I : ℝ) : ℂ)) • P := by
      funext z; simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]; ring
    have hP2c : ContDiff ℝ 2 P := hPc.of_le (by simp)
    have hA2c : ContDiff ℝ 2 (fun y => P y * E y) := (hPc.mul hEc).of_le (by simp)
    rw [hsplit, iteratedFDeriv_sub_apply (f := fun y => P y * E y)
      (g := (cA / ((r * I : ℝ) : ℂ)) • P) hA2c.contDiffAt
      (hP2c.const_smul (cA / ((r * I : ℝ) : ℂ))).contDiffAt,
      iteratedFDeriv_const_smul_apply hP2c.contDiffAt]
    have hc : ‖cA / ((r * I : ℝ) : ℂ)‖ ≤ 1 := by
      rw [norm_div, Complex.norm_real, Real.norm_of_nonneg hrI.le, div_le_one hrI]; exact hcA
    have hpi : 0 ≤ 6 * Real.pi * |α| := by positivity
    calc ‖iteratedFDeriv ℝ 2 (fun y => P y * E y) y -
          (cA / ((r * I : ℝ) : ℂ)) • iteratedFDeriv ℝ 2 P y‖
        ≤ ‖iteratedFDeriv ℝ 2 (fun y => P y * E y) y‖ +
          ‖cA / ((r * I : ℝ) : ℂ)‖ * ‖iteratedFDeriv ℝ 2 P y‖ := by
          refine (norm_sub_le _ _).trans ?_; rw [norm_smul]
      _ ≤ K * 1 * (1 / r + 3 * (2 * Real.pi) * |α|) ^ 2 + 1 * (K * (1 / r) ^ 2) := by
          gcongr
      _ ≤ 2 * K * (1 / r + 6 * Real.pi * |α|) ^ 2 := by
          have h1 : (1 / r) ^ 2 ≤ (1 / r + 6 * Real.pi * |α|) ^ 2 :=
            pow_le_pow_left₀ (by positivity) (by linarith) 2
          have e : 3 * (2 * Real.pi) * |α| = 6 * Real.pi * |α| := by ring
          rw [e]; nlinarith only [hK, h1]

end MeanZeroWave

/-- The local kernel in the coordinates `(y_a, y_b) = (x + a t, x + b t)` of two distinct
slots: `t = (y_b - y_a)/(b - a)` and `x = y_a - a t`. -/
noncomputable def slotPairKernel (w : ℝ × ℝ → ℂ) (a b : Fin 4) (ya yb : ℝ) : ℂ :=
  w (ya - (a : ℝ) * ((yb - ya) / ((b : ℝ) - (a : ℝ))), (yb - ya) / ((b : ℝ) - (a : ℝ)))

theorem fin_cast_sub_ne {a b : Fin 4} (hab : a ≠ b) : (b : ℝ) - (a : ℝ) ≠ 0 := by
  intro h
  have := one_le_abs_fin_sub hab
  rw [h, abs_zero] at this; linarith

theorem slotPairKernel_progression (w : ℝ × ℝ → ℂ) {a b : Fin 4} (hab : a ≠ b) (z : ℝ × ℝ) :
    slotPairKernel w a b (realProgressionCoordinate a z) (realProgressionCoordinate b z) =
      w z := by
  have hd := fin_cast_sub_ne hab
  unfold slotPairKernel realProgressionCoordinate
  have ht : (z.1 + (b : ℝ) * z.2 - (z.1 + (a : ℝ) * z.2)) / ((b : ℝ) - (a : ℝ)) = z.2 := by
    field_simp; ring
  rw [ht]
  congr 1
  ext <;> simp

/-- eq:marginals in the coordinates `(y_a, y_b)`: integration in either variable vanishes. -/
theorem slotPairKernel_marginal {κ : LocalKernelClass} {a₀ r : ℝ} {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) {a b : Fin 4} (hab : a ≠ b) (u : ℝ) :
    (∫ s, slotPairKernel w a b s u) = 0 ∧ (∫ s, slotPairKernel w a b u s) = 0 := by
  have hd := fin_cast_sub_ne hab
  set d := (b : ℝ) - (a : ℝ) with hdd
  constructor
  · have h1 : ∫ t, slotPairKernel w a b (u + (-d) * t) u = ∫ t, w (u - (b : ℝ) * t, t) := by
      congr 1; funext t
      unfold slotPairKernel
      have e1 : (u - (u + -d * t)) / d = t := by field_simp; ring
      rw [e1]
      congr 2
      rw [hdd]; ring
    have h2 := real_integral_affine (fun s => slotPairKernel w a b s u) (c := -d) u
    rw [h1, hw.marginal u b] at h2
    have hne : ((|(-d)⁻¹| : ℝ) : ℂ) ≠ 0 := by simp [hd]
    exact (mul_eq_zero.mp h2.symm).resolve_left hne
  · have h1 : ∫ t, slotPairKernel w a b u (u + d * t) = ∫ t, w (u - (a : ℝ) * t, t) := by
      congr 1; funext t
      unfold slotPairKernel
      have e1 : (u + d * t - u) / d = t := by field_simp; ring
      rw [e1]
    have h2 := real_integral_affine (fun s => slotPairKernel w a b u s) (c := d) u
    rw [h1, hw.marginal u a] at h2
    have hne : ((|d⁻¹| : ℝ) : ℂ) ≠ 0 := by simp [hd]
    exact (mul_eq_zero.mp h2.symm).resolve_left hne

/-- The `y_a` frequency of the `v`-th kernel character in slot coordinates. -/
noncomputable def slotPairFreqA (a b : Fin 4) (r : ℝ) (v : Fin 2 → ℤ) : ℝ :=
  ((v 0 : ℝ) * (b : ℝ) - (v 1 : ℝ)) / (16 * r * ((b : ℝ) - (a : ℝ)))

/-- The `y_b` frequency of the `v`-th kernel character in slot coordinates. -/
noncomputable def slotPairFreqB (a b : Fin 4) (r : ℝ) (v : Fin 2 → ℤ) : ℝ :=
  ((v 1 : ℝ) - (v 0 : ℝ) * (a : ℝ)) / (16 * r * ((b : ℝ) - (a : ℝ)))

/-- The constant phase of the `v`-th kernel character. -/
noncomputable def slotPairPhase (a₀ r : ℝ) (v : Fin 2 → ℤ) : ℝ :=
  -((v 0 : ℝ) * (a₀ + r / 2)) / (16 * r)

theorem slotPairKernel_support {κ : LocalKernelClass} {a₀ r : ℝ}
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a b : Fin 4} (hab : a ≠ b)
    {ya yb : ℝ} (h : slotPairKernel w a b ya yb ≠ 0) :
    a₀ + κ.margin * r ≤ ya ∧ ya ≤ a₀ + r - κ.margin * r ∧
      a₀ + κ.margin * r ≤ yb ∧ yb ≤ a₀ + r - κ.margin * r := by
  have hd := fin_cast_sub_ne hab
  set t := (yb - ya) / ((b : ℝ) - (a : ℝ)) with ht
  set z : ℝ × ℝ := (ya - (a : ℝ) * t, t) with hz
  have hw0 : w z ≠ 0 := h
  have h1 := hw.support z hw0 a
  have h2 := hw.support z hw0 b
  have e1 : realProgressionCoordinate a z = ya := by
    simp only [realProgressionCoordinate, hz]; ring
  have e2 : realProgressionCoordinate b z = yb := by
    simp only [realProgressionCoordinate, hz, ht]; field_simp; ring
  rw [e1] at h1; rw [e2] at h2
  exact ⟨h1.1, h1.2, h2.1, h2.2⟩

/-- Blueprint lem:predictors, proof line 1529: the kernel in slot coordinates is an
absolutely convergent sum of plateau-cut characters `η(y_a) e(α y_a) η(y_b) e(β y_b)`,
valid on the whole plane. -/
theorem slotPairKernel_plateau_expansion {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a b : Fin 4} (hab : a ≠ b)
    {η₁ : ℝ → ℝ} {m : ℝ} (hm : 0 < m) (hmκ : m ≤ κ.margin)
    (hη1 : ∀ u, |u| ≤ 1 / 2 - m → η₁ u = 1) (hη0 : ∀ u, 1 / 2 - m / 2 ≤ |u| → η₁ u = 0) :
    let c := periodicFourierCoeff (cubePeriodization (kernelUnitRescale a₀ r w) 16)
    ∀ ya yb : ℝ, HasSum (fun v => c v * (Real.fourierChar (slotPairPhase a₀ r v) : ℂ) *
        (plateauAt η₁ a₀ r ya * (Real.fourierChar (slotPairFreqA a b r v * ya) : ℂ)) *
        (plateauAt η₁ a₀ r yb * (Real.fourierChar (slotPairFreqB a b r v * yb) : ℂ)))
      (slotPairKernel w a b ya yb) := by
  intro c ya yb
  have hd := fin_cast_sub_ne hab
  set d := (b : ℝ) - (a : ℝ) with hdd
  have hd1 : 1 ≤ |d| := one_le_abs_fin_sub hab
  have hPz : ∀ y, y ∉ Set.Ico a₀ (a₀ + r) → plateauAt η₁ a₀ r y = 0 := fun y hy =>
    plateauAt_eq_zero hm hη0 hr hy
  have hP1 : ∀ y, a₀ + κ.margin * r ≤ y → y ≤ a₀ + r - κ.margin * r →
      plateauAt η₁ a₀ r y = 1 := by
    intro y h1 h2
    unfold plateauAt
    rw [hη1, Complex.ofReal_one]
    rw [abs_div, abs_of_pos hr, div_le_iff₀ hr, abs_le]
    constructor <;> nlinarith
  by_cases hin : ya ∈ Set.Ico a₀ (a₀ + r) ∧ yb ∈ Set.Ico a₀ (a₀ + r)
  · set t := (yb - ya) / d with ht
    set x := ya - (a : ℝ) * t with hx
    have hta : |t| ≤ r := by
      rw [ht, abs_div, div_le_iff₀ (by positivity)]
      have : |yb - ya| ≤ r := by
        rw [abs_le]; constructor <;> linarith [hin.1.1, hin.1.2, hin.2.1, hin.2.2]
      nlinarith
    have ha3 : |(a : ℝ)| ≤ 3 := abs_fin_four_le a
    have hxa : |x - (a₀ + r / 2)| ≤ 8 * r := by
      have h1 : |ya - (a₀ + r / 2)| ≤ r := by
        rw [abs_le]; constructor <;> linarith [hin.1.1, hin.1.2]
      have h2 : |(a : ℝ) * t| ≤ 3 * r := by
        rw [abs_mul]; nlinarith [abs_nonneg t]
      calc |x - (a₀ + r / 2)| = |(ya - (a₀ + r / 2)) - (a : ℝ) * t| := by rw [hx]; ring_nf
        _ ≤ |ya - (a₀ + r / 2)| + |(a : ℝ) * t| := abs_sub _ _
        _ ≤ 8 * r := by linarith
    have h := ((admissibleKernel_fourier_expansion hr hw).2.2 x t hxa (by linarith)).mul_left
      (plateauAt η₁ a₀ r ya * plateauAt η₁ a₀ r yb)
    have hK : plateauAt η₁ a₀ r ya * plateauAt η₁ a₀ r yb * w (x, t) =
        slotPairKernel w a b ya yb := by
      have hKe : w (x, t) = slotPairKernel w a b ya yb := rfl
      rw [hKe]
      by_cases h0 : slotPairKernel w a b ya yb = 0
      · rw [h0, mul_zero]
      · obtain ⟨h1, h2, h3, h4⟩ := slotPairKernel_support hw hab h0
        rw [hP1 ya h1 h2, hP1 yb h3 h4, one_mul, one_mul]
    rw [hK] at h
    convert h using 1
    funext v
    have hphase : (v 0 : ℝ) * ((x - (a₀ + r / 2)) / r / 16) + (v 1 : ℝ) * (t / r / 16) =
        slotPairPhase a₀ r v + slotPairFreqA a b r v * ya + slotPairFreqB a b r v * yb := by
      simp only [slotPairPhase, slotPairFreqA, slotPairFreqB, hx, ht, ← hdd]
      field_simp
      ring
    rw [hphase, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul, Circle.coe_mul, Circle.coe_mul]
    ring
  · have h0 : slotPairKernel w a b ya yb = 0 := by
      by_contra h0
      obtain ⟨h1, h2, h3, h4⟩ := slotPairKernel_support hw hab h0
      have hm0 : 0 < κ.margin * r := mul_pos κ.margin_pos hr
      exact hin ⟨⟨by linarith, by linarith⟩, ⟨by linarith, by linarith⟩⟩
    rw [h0]
    have hz : ∀ v, c v * (Real.fourierChar (slotPairPhase a₀ r v) : ℂ) *
        (plateauAt η₁ a₀ r ya * (Real.fourierChar (slotPairFreqA a b r v * ya) : ℂ)) *
        (plateauAt η₁ a₀ r yb * (Real.fourierChar (slotPairFreqB a b r v * yb) : ℂ)) = 0 := by
      intro v
      rcases not_and_or.mp hin with h | h
      · rw [hPz ya h]; ring
      · rw [hPz yb h]; ring
    simp_rw [hz]
    exact hasSum_zero

/-- Integrating an absolutely convergent expansion term by term. -/
theorem hasSum_integral_of_dominated {ι : Type*} [Countable ι] {f : ι → ℝ → ℂ}
    {g : ℝ → ℂ} (hf : ∀ i, Integrable (f i)) {a : ι → ℝ} (ha : Summable a)
    (hfa : ∀ i, ∫ s, ‖f i s‖ ≤ a i) (hg : ∀ s, HasSum (fun i => f i s) (g s)) :
    HasSum (fun i => ∫ s, f i s) (∫ s, g s) := by
  have hsumm : Summable (fun i => ∫ s, ‖f i s‖) :=
    Summable.of_nonneg_of_le (fun i => integral_nonneg fun _ => norm_nonneg _) hfa ha
  have hint := integral_tsum_of_summable_integral_norm hf hsumm
  have hg' : (fun s => ∑' i, f i s) = g := funext fun s => (hg s).tsum_eq
  rw [hg'] at hint
  rw [← hint]
  refine Summable.hasSum ?_
  exact Summable.of_norm_bounded hsumm (fun i => norm_integral_le_integral_norm _)

/-- Blueprint lem:predictors, proof line 1529: the kernel in slot coordinates is an
absolutely convergent sum of tensor products of smooth mean-zero bumps
`Π(η e(α ·)) ⊗ Π(η e(β ·))`, with the same coefficient magnitudes as the kernel. -/
theorem slotPairKernel_meanZero_tensor {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a b : Fin 4} (hab : a ≠ b)
    {η₁ : ℝ → ℝ} {m I : ℝ} (hm : 0 < m) (hmκ : m ≤ κ.margin) (hη : ContDiff ℝ (⊤ : ℕ∞) η₁)
    (hη01 : ∀ u, 0 ≤ η₁ u ∧ η₁ u ≤ 1)
    (hη1 : ∀ u, |u| ≤ 1 / 2 - m → η₁ u = 1) (hη0 : ∀ u, 1 / 2 - m / 2 ≤ |u| → η₁ u = 0)
    (hI : 0 < I) (hIη : ∫ u, η₁ u = I) :
    let c := periodicFourierCoeff (cubePeriodization (kernelUnitRescale a₀ r w) 16)
    ∀ ya yb : ℝ, HasSum (fun v => c v * (Real.fourierChar (slotPairPhase a₀ r v) : ℂ) *
        meanZeroWave η₁ I a₀ r (slotPairFreqA a b r v) ya *
        meanZeroWave η₁ I a₀ r (slotPairFreqB a b r v) yb)
      (slotPairKernel w a b ya yb) := by
  intro c ya yb
  set P := plateauAt η₁ a₀ r with hP
  set α := slotPairFreqA a b r with hα
  set β := slotPairFreqB a b r with hβ
  set! c' : (Fin 2 → ℤ) → ℂ := fun v => c v * (Real.fourierChar (slotPairPhase a₀ r v) : ℂ)
    with hc'
  set! A : (Fin 2 → ℤ) → ℝ → ℂ := fun v y => P y * (Real.fourierChar (α v * y) : ℂ) with hA
  set! B : (Fin 2 → ℤ) → ℝ → ℂ := fun v y => P y * (Real.fourierChar (β v * y) : ℂ) with hB
  set! ψ₀ : ℝ → ℂ := fun y => P y / ((r * I : ℝ) : ℂ) with hψ₀
  have hexp := slotPairKernel_plateau_expansion hr hw hab hm hmκ hη1 hη0
  have hcs : Summable (fun v => ‖c v‖) := (admissibleKernel_fourier_expansion hr hw).1
  have hc'n : ∀ v, ‖c' v‖ = ‖c v‖ := fun v => by
    simp only [hc', norm_mul, Circle.norm_coe, mul_one]
  -- the plateau and its integrals
  have hPc : ContDiff ℝ (⊤ : ℕ∞) P := plateauAt_contDiff hη a₀ r
  have hPs : ∀ y, y ∉ Set.Ico a₀ (a₀ + r) → P y = 0 := fun y hy => plateauAt_eq_zero hm hη0 hr hy
  have hPcs : HasCompactSupport P := hasCompactSupport_of_zero_outside_Ico hPs
  have hPn : ∀ y, ‖P y‖ ≤ 1 := fun y => by
    simp only [hP, plateauAt, Complex.norm_real, Real.norm_of_nonneg (hη01 _).1]
    exact (hη01 _).2
  have hPnorm : ∫ s, ‖P s‖ = r * I := by
    have h := integral_plateauAt (η₁ := η₁) (a₀ := a₀) hIη hr
    have e : ∫ s, ‖P s‖ = ∫ s, η₁ ((s - (a₀ + r / 2)) / r) := by
      congr 1; funext s
      simp only [hP, plateauAt, Complex.norm_real, Real.norm_of_nonneg (hη01 _).1]
    rw [e]
    have h2 : ((∫ s, η₁ ((s - (a₀ + r / 2)) / r) : ℝ) : ℂ) = ((r * I : ℝ) : ℂ) := by
      rw [← h, ← integral_complex_ofReal]; rfl
    exact_mod_cast h2
  have hEc : ∀ γ : ℝ, Continuous (fun y : ℝ => (Real.fourierChar (γ * y) : ℂ)) := fun γ =>
    continuous_subtype_val.comp (Real.continuous_fourierChar.comp
      (continuous_const.mul continuous_id))
  have hAi : ∀ v, Integrable (A v) := fun v =>
    (hPc.continuous.mul (hEc _)).integrable_of_hasCompactSupport hPcs.mul_right
  have hBi : ∀ v, Integrable (B v) := fun v =>
    (hPc.continuous.mul (hEc _)).integrable_of_hasCompactSupport hPcs.mul_right
  have hAn : ∀ v y, ‖A v y‖ ≤ ‖P y‖ := fun v y => by
    simp only [hA, norm_mul, Circle.norm_coe, mul_one, le_refl]
  have hBn : ∀ v y, ‖B v y‖ ≤ ‖P y‖ := fun v y => by
    simp only [hB, norm_mul, Circle.norm_coe, mul_one, le_refl]
  have hPi : Integrable P := hPc.continuous.integrable_of_hasCompactSupport hPcs
  have hAint : ∀ v, ∫ s, ‖A v s‖ ≤ r * I := fun v =>
    hPnorm ▸ integral_mono (hAi v).norm hPi.norm (hAn v)
  have hBint : ∀ v, ∫ s, ‖B v s‖ ≤ r * I := fun v =>
    hPnorm ▸ integral_mono (hBi v).norm hPi.norm (hBn v)
  have hrI : 0 ≤ r * I := (mul_pos hr hI).le
  have hdom : Summable (fun v => ‖c v‖ * (r * I)) := hcs.mul_right _
  -- (1) the plateau expansion
  have h1 : ∀ y y', HasSum (fun v => c' v * A v y * B v y') (slotPairKernel w a b y y') :=
    fun y y' => hexp y y'
  -- (2) integrating out the first variable
  have h2 : ∀ y', HasSum (fun v => c' v * (∫ s, A v s) * B v y') 0 := by
    intro y'
    have h := hasSum_integral_of_dominated (f := fun v s => c' v * A v s * B v y')
      (g := fun s => slotPairKernel w a b s y')
      (fun v => ((hAi v).const_mul (c' v)).mul_const (B v y')) hdom
      (fun v => by
        have e : ∫ s, ‖c' v * A v s * B v y'‖ = ‖c' v‖ * ‖B v y'‖ * ∫ s, ‖A v s‖ := by
          rw [← integral_const_mul]; congr 1; funext s; rw [norm_mul, norm_mul]; ring
        rw [e, hc'n]
        have hb : ‖B v y'‖ ≤ 1 := (hBn v y').trans (hPn y')
        calc ‖c v‖ * ‖B v y'‖ * ∫ s, ‖A v s‖ ≤ ‖c v‖ * 1 * (r * I) := by
              gcongr
              exact hAint v
          _ = _ := by ring)
      (fun s => h1 s y')
    rw [(slotPairKernel_marginal hw hab y').1] at h
    convert h using 1
    funext v
    rw [integral_mul_const, integral_const_mul]
  -- (3) integrating out the second variable
  have h3 : ∀ y, HasSum (fun v => c' v * A v y * (∫ s, B v s)) 0 := by
    intro y
    have h := hasSum_integral_of_dominated (f := fun v s => c' v * A v y * B v s)
      (g := fun s => slotPairKernel w a b y s)
      (fun v => (hBi v).const_mul (c' v * A v y)) hdom
      (fun v => by
        have e : ∫ s, ‖c' v * A v y * B v s‖ = ‖c' v‖ * ‖A v y‖ * ∫ s, ‖B v s‖ := by
          rw [← integral_const_mul]; congr 1; funext s; rw [norm_mul, norm_mul]
        rw [e, hc'n]
        have hb : ‖A v y‖ ≤ 1 := (hAn v y).trans (hPn y)
        calc ‖c v‖ * ‖A v y‖ * ∫ s, ‖B v s‖ ≤ ‖c v‖ * 1 * (r * I) := by
              gcongr
              exact hBint v
          _ = _ := by ring)
      (fun s => h1 y s)
    rw [(slotPairKernel_marginal hw hab y).2] at h
    convert h using 1
    funext v
    rw [integral_const_mul]
  -- (4) both variables
  have h4 : HasSum (fun v => c' v * (∫ s, A v s) * (∫ s, B v s)) 0 := by
    have h := hasSum_integral_of_dominated (f := fun v s => c' v * (∫ s, A v s) * B v s)
      (g := fun _ => (0 : ℂ))
      (fun v => (hBi v).const_mul (c' v * ∫ s, A v s))
      (hcs.mul_right ((r * I) * (r * I)))
      (fun v => by
        have e : ∫ s, ‖c' v * (∫ s, A v s) * B v s‖ =
            ‖c' v‖ * ‖∫ s, A v s‖ * ∫ s, ‖B v s‖ := by
          have e1 : (fun s => ‖c' v * (∫ s, A v s) * B v s‖) =
              fun s => ‖c' v * ∫ s, A v s‖ * ‖B v s‖ := by
            funext s; rw [norm_mul]
          rw [e1, integral_const_mul, norm_mul]
        rw [e, hc'n]
        have hA' : ‖∫ s, A v s‖ ≤ r * I := (norm_integral_le_integral_norm _).trans (hAint v)
        calc ‖c v‖ * ‖∫ s, A v s‖ * ∫ s, ‖B v s‖ ≤ ‖c v‖ * (r * I) * (r * I) := by
              gcongr
              exact hBint v
          _ = _ := by ring)
      h2
    rw [integral_zero] at h
    convert h using 1
    funext v
    rw [integral_const_mul]
  -- the mean-zero tensor expansion
  have hmz : ∀ γ y, meanZeroWave η₁ I a₀ r γ y =
      P y * (Real.fourierChar (γ * y) : ℂ) -
        (∫ s, P s * (Real.fourierChar (γ * s) : ℂ)) * ψ₀ y := fun γ y => rfl
  have hfin := ((((h1 ya yb).sub ((h2 yb).mul_left (ψ₀ ya))).sub
    ((h3 ya).mul_left (ψ₀ yb))).add (h4.mul_left (ψ₀ ya * ψ₀ yb)))
  simp only [mul_zero, sub_zero, add_zero] at hfin
  convert hfin using 1
  funext v
  rw [hmz, hmz]
  simp only [hA, hB, hc']
  ring

/-- Unit-scale plateau data with margin `m`. -/
structure UnitPlateau (m : ℝ) where
  /-- Smooth plateau function on the unit-scale interval. -/
  η : ℝ → ℝ
  /-- Uniform Lipschitz bound for the plateau function. -/
  K : ℝ
  /-- Integral used to normalize the plateau function. -/
  I : ℝ
  smooth : ContDiff ℝ (⊤ : ℕ∞) η
  bounds : ∀ u, 0 ≤ η u ∧ η u ≤ 1
  one : ∀ u, |u| ≤ 1 / 2 - m → η u = 1
  zero : ∀ u, 1 / 2 - m / 2 ≤ |u| → η u = 0
  I_pos : 0 < I
  integral : ∫ u, η u = I
  K_nonneg : 0 ≤ K
  deriv_bound : ∀ u (i : ℕ), i ≤ 2 → ‖iteratedFDeriv ℝ i η u‖ ≤ K

/-- The plateau margin of a kernel class. -/
noncomputable def kernelPlateauMargin (κ : LocalKernelClass) : ℝ := min κ.margin (1 / 4)

theorem kernelPlateauMargin_pos (κ : LocalKernelClass) : 0 < kernelPlateauMargin κ :=
  lt_min κ.margin_pos (by norm_num)

theorem kernelPlateauMargin_le (κ : LocalKernelClass) : kernelPlateauMargin κ ≤ κ.margin :=
  min_le_left _ _

/-- A fixed plateau for each kernel class. -/
noncomputable def kernelPlateau (κ : LocalKernelClass) : UnitPlateau (kernelPlateauMargin κ) :=
  Classical.choice <| by
    obtain ⟨η, K, I, h1, h2, h3, h4, h5, h6, h7, h8⟩ :=
      exists_unit_plateau (kernelPlateauMargin_pos κ) (min_le_right _ _)
    exact ⟨⟨η, K, I, h1, h2, h3, h4, h5, h6, h7, h8⟩⟩

/-- The mean-zero wave of the kernel class at a cell. -/
noncomputable def classWave (κ : LocalKernelClass) (a₀ r α y : ℝ) : ℂ :=
  meanZeroWave (kernelPlateau κ).η (kernelPlateau κ).I a₀ r α y

theorem classWave_props (κ : LocalKernelClass) {a₀ r : ℝ} (hr : 0 < r) (α : ℝ) :
    ContDiff ℝ (⊤ : ℕ∞) (classWave κ a₀ r α) ∧
      (∀ y, y ∉ Set.Ico a₀ (a₀ + r) → classWave κ a₀ r α y = 0) ∧
      (∫ y, classWave κ a₀ r α y = 0) ∧
      (∀ y, ‖classWave κ a₀ r α y‖ ≤ 2) ∧
      ∀ y, ‖deriv (deriv (classWave κ a₀ r α)) y‖ ≤
        2 * (kernelPlateau κ).K * (1 / r + 6 * Real.pi * |α|) ^ 2 :=
  meanZeroWave_props (kernelPlateauMargin_pos κ) (kernelPlateau κ).smooth
    (kernelPlateau κ).bounds (kernelPlateau κ).zero (kernelPlateau κ).I_pos
    (kernelPlateau κ).integral (kernelPlateau κ).K_nonneg (kernelPlateau κ).deriv_bound hr α

theorem slotPairKernel_classTensor {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a b : Fin 4} (hab : a ≠ b) :
    let c := periodicFourierCoeff (cubePeriodization (kernelUnitRescale a₀ r w) 16)
    ∀ ya yb : ℝ, HasSum (fun v => c v * (Real.fourierChar (slotPairPhase a₀ r v) : ℂ) *
        classWave κ a₀ r (slotPairFreqA a b r v) ya *
        classWave κ a₀ r (slotPairFreqB a b r v) yb)
      (slotPairKernel w a b ya yb) :=
  slotPairKernel_meanZero_tensor hr hw hab (kernelPlateauMargin_pos κ)
    (kernelPlateauMargin_le κ) (kernelPlateau κ).smooth (kernelPlateau κ).bounds
    (kernelPlateau κ).one (kernelPlateau κ).zero (kernelPlateau κ).I_pos
    (kernelPlateau κ).integral

/-- Integrating an absolutely convergent expansion term by term (general measure space). -/
theorem hasSum_integral_of_dominated' {α ι : Type*} [MeasurableSpace α] {μ : Measure α}
    [Countable ι] {f : ι → α → ℂ} {g : α → ℂ} (hf : ∀ i, Integrable (f i) μ) {a : ι → ℝ}
    (ha : Summable a) (hfa : ∀ i, ∫ s, ‖f i s‖ ∂μ ≤ a i)
    (hg : ∀ s, HasSum (fun i => f i s) (g s)) :
    HasSum (fun i => ∫ s, f i s ∂μ) (∫ s, g s ∂μ) := by
  have hsumm : Summable (fun i => ∫ s, ‖f i s‖ ∂μ) :=
    Summable.of_nonneg_of_le (fun i => integral_nonneg fun _ => norm_nonneg _) hfa ha
  have hint := integral_tsum_of_summable_integral_norm hf hsumm
  have hg' : (fun s => ∑' i, f i s) = g := funext fun s => (hg s).tsum_eq
  rw [hg'] at hint
  rw [← hint]
  exact Summable.hasSum (Summable.of_norm_bounded hsumm (fun i => norm_integral_le_integral_norm _))

/-- Blueprint lem:predictors, proof line 1531: for a linear phase `e(γ t)` the separated
form at one cell is a sum over the kernel characters of products of two mean-zero rows,
`|I| |H_I| ≤ |b-a|⁻¹ Σ_v |c_v| |W^a_v| |W^b_v|`, with centers `∓γ/(b-a)`. -/
theorem separated_linear_cell_tensor {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a b : Fin 4} (hab : a ≠ b)
    (γ : ℝ) {Ga Gb : ℝ → ℂ} (hGam : Measurable Ga) (hGbm : Measurable Gb)
    (hGa : Integrable Ga) (hGb : Integrable Gb) :
    let c := periodicFourierCoeff (cubePeriodization (kernelUnitRescale a₀ r w) 16)
    let ν := γ / ((b : ℝ) - (a : ℝ))
    let X := fun v => ∫ y, classWave κ a₀ r (slotPairFreqA a b r v) y *
      (Real.fourierChar ((-ν) * y) : ℂ) * Ga y
    let Y := fun v => ∫ y, classWave κ a₀ r (slotPairFreqB a b r v) y *
      (Real.fourierChar (ν * y) : ℂ) * Gb y
    Summable (fun v => ‖c v‖ * (Real.sqrt r⁻¹ * ‖X v‖) * (Real.sqrt r⁻¹ * ‖Y v‖)) ∧
      r * ‖separatedLocalForm r w (fun t => (Real.fourierChar (γ * t) : ℂ)) a b Ga Gb‖ ≤
        |((b : ℝ) - (a : ℝ))⁻¹| *
          ∑' v, ‖c v‖ * (Real.sqrt r⁻¹ * ‖X v‖) * (Real.sqrt r⁻¹ * ‖Y v‖) := by
  intro c ν X Y
  have hd := fin_cast_sub_ne hab
  set d := (b : ℝ) - (a : ℝ) with hdd
  have hab' : (a : ℝ) ≠ (b : ℝ) := fun h => hd (by rw [hdd, h, sub_self])
  set c' : (Fin 2 → ℤ) → ℂ := fun v => c v * (Real.fourierChar (slotPairPhase a₀ r v) : ℂ)
    with hc'
  have hc'n : ∀ v, ‖c' v‖ = ‖c v‖ := fun v => by
    simp only [hc', norm_mul, Circle.norm_coe, mul_one]
  have hcs : Summable (fun v => ‖c v‖) := (admissibleKernel_fourier_expansion hr hw).1
  have hEc : ∀ g : ℝ, Continuous (fun y : ℝ => (Real.fourierChar (g * y) : ℂ)) := fun g =>
    continuous_subtype_val.comp (Real.continuous_fourierChar.comp
      (continuous_const.mul continuous_id))
  set! fa : (Fin 2 → ℤ) → ℝ → ℂ := fun v y => classWave κ a₀ r (slotPairFreqA a b r v) y *
    (Real.fourierChar ((-ν) * y) : ℂ) * Ga y with hfa
  set! fb : (Fin 2 → ℤ) → ℝ → ℂ := fun v y => classWave κ a₀ r (slotPairFreqB a b r v) y *
    (Real.fourierChar (ν * y) : ℂ) * Gb y with hfb
  have hwa := fun v => classWave_props κ (a₀ := a₀) hr (slotPairFreqA a b r v)
  have hwb := fun v => classWave_props κ (a₀ := a₀) hr (slotPairFreqB a b r v)
  have hfam : ∀ v, Measurable (fa v) := fun v =>
    (((hwa v).1.continuous.mul (hEc _)).measurable).mul hGam
  have hfbm : ∀ v, Measurable (fb v) := fun v =>
    (((hwb v).1.continuous.mul (hEc _)).measurable).mul hGbm
  have hfan : ∀ v y, ‖fa v y‖ ≤ 2 * ‖Ga y‖ := fun v y => by
    simp only [hfa, norm_mul, Circle.norm_coe, mul_one]
    exact mul_le_mul_of_nonneg_right ((hwa v).2.2.2.1 y) (norm_nonneg _)
  have hfbn : ∀ v y, ‖fb v y‖ ≤ 2 * ‖Gb y‖ := fun v y => by
    simp only [hfb, norm_mul, Circle.norm_coe, mul_one]
    exact mul_le_mul_of_nonneg_right ((hwb v).2.2.2.1 y) (norm_nonneg _)
  have hfai : ∀ v, Integrable (fa v) := fun v =>
    (hGa.norm.const_mul 2).mono' (hfam v).aestronglyMeasurable
      (Filter.Eventually.of_forall (hfan v))
  have hfbi : ∀ v, Integrable (fb v) := fun v =>
    (hGb.norm.const_mul 2).mono' (hfbm v).aestronglyMeasurable
      (Filter.Eventually.of_forall (hfbn v))
  -- pointwise expansion of the integrand
  have hpt : ∀ z : ℝ × ℝ, HasSum (fun v => c' v * (fa v (realProgressionCoordinate a z) *
      fb v (realProgressionCoordinate b z)))
      (w z * (Real.fourierChar (γ * z.2) : ℂ) * Ga (realProgressionCoordinate a z) *
        Gb (realProgressionCoordinate b z)) := by
    intro z
    have h := (slotPairKernel_classTensor hr hw hab (realProgressionCoordinate a z)
      (realProgressionCoordinate b z)).mul_right ((Real.fourierChar (γ * z.2) : ℂ) *
        Ga (realProgressionCoordinate a z) * Gb (realProgressionCoordinate b z))
    rw [slotPairKernel_progression w hab z] at h
    have hphase : (Real.fourierChar (γ * z.2) : ℂ) =
        (Real.fourierChar ((-ν) * realProgressionCoordinate a z) : ℂ) *
          (Real.fourierChar (ν * realProgressionCoordinate b z) : ℂ) := by
      rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul]
      congr 2
      simp only [ν, realProgressionCoordinate, ← hdd]
      field_simp; ring
    convert h using 1
    · funext v; rw [hphase]; simp only [hfa, hfb, hc']; ring
    · ring
  -- domination
  obtain ⟨hΦi, hΦ⟩ := real_progression_pair_integral_norm hGam hGbm hGa hGb hab'
  set Φ := ∫ z : ℝ × ℝ, ‖Ga (z.1 + (a : ℝ) * z.2)‖ * ‖Gb (z.1 + (b : ℝ) * z.2)‖ with hΦdef
  have hpair := fun v => real_progression_pair_integral (hfam v) (hfbm v) (hfai v) (hfbi v) hab'
  have hti : ∀ v, Integrable (fun z : ℝ × ℝ => c' v * (fa v (realProgressionCoordinate a z) *
      fb v (realProgressionCoordinate b z))) := fun v => (hpair v).1.const_mul (c' v)
  have htb : ∀ v, ∫ z : ℝ × ℝ, ‖c' v * (fa v (realProgressionCoordinate a z) *
      fb v (realProgressionCoordinate b z))‖ ≤ ‖c v‖ * (4 * Φ) := by
    intro v
    calc ∫ z : ℝ × ℝ, ‖c' v * (fa v (realProgressionCoordinate a z) *
          fb v (realProgressionCoordinate b z))‖
        ≤ ∫ z : ℝ × ℝ, ‖c v‖ * (4 * (‖Ga (z.1 + (a : ℝ) * z.2)‖ *
            ‖Gb (z.1 + (b : ℝ) * z.2)‖)) := by
          apply integral_mono (hti v).norm ((hΦi.const_mul 4).const_mul _)
          intro z
          simp only [norm_mul, hc'n]
          apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
          have h1 := hfan v (realProgressionCoordinate a z)
          have h2 := hfbn v (realProgressionCoordinate b z)
          have h3 := mul_le_mul h1 h2 (norm_nonneg _) (by positivity)
          simp only [realProgressionCoordinate] at h3 ⊢
          linarith
      _ = ‖c v‖ * (4 * Φ) := by rw [integral_const_mul, integral_const_mul]
  have hsum := hasSum_integral_of_dominated' hti (hcs.mul_right (4 * Φ)) htb hpt
  have hval : ∀ v, ∫ z : ℝ × ℝ, c' v * (fa v (realProgressionCoordinate a z) *
      fb v (realProgressionCoordinate b z)) = c' v * (((|d⁻¹| : ℝ) : ℂ) * X v * Y v) := by
    intro v
    rw [integral_const_mul]
    congr 1
    exact (hpair v).2
  simp_rw [hval] at hsum
  -- bounds for the rows
  have hXb : ∀ v, ‖X v‖ ≤ 2 * ∫ y, ‖Ga y‖ := fun v =>
    (norm_integral_le_integral_norm _).trans ((integral_mono (hfai v).norm
      (hGa.norm.const_mul 2) (hfan v)).trans_eq (integral_const_mul _ _))
  have hYb : ∀ v, ‖Y v‖ ≤ 2 * ∫ y, ‖Gb y‖ := fun v =>
    (norm_integral_le_integral_norm _).trans ((integral_mono (hfbi v).norm
      (hGb.norm.const_mul 2) (hfbn v)).trans_eq (integral_const_mul _ _))
  have hsr : 0 ≤ Real.sqrt r⁻¹ := Real.sqrt_nonneg _
  have hsumm : Summable (fun v => ‖c v‖ * (Real.sqrt r⁻¹ * ‖X v‖) *
      (Real.sqrt r⁻¹ * ‖Y v‖)) := by
    refine Summable.of_nonneg_of_le (fun v => by positivity) (fun v => ?_)
      (hcs.mul_right ((Real.sqrt r⁻¹ * (2 * ∫ y, ‖Ga y‖)) *
        (Real.sqrt r⁻¹ * (2 * ∫ y, ‖Gb y‖))))
    rw [mul_assoc]
    exact mul_le_mul_of_nonneg_left (mul_le_mul (mul_le_mul_of_nonneg_left (hXb v) hsr)
      (mul_le_mul_of_nonneg_left (hYb v) hsr) (by positivity) (by positivity)) (norm_nonneg _)
  refine ⟨hsumm, ?_⟩
  have hform : separatedLocalForm r w (fun t => (Real.fourierChar (γ * t) : ℂ)) a b Ga Gb =
      (r : ℂ)⁻¹ ^ 2 * ∑' v, c' v * (((|d⁻¹| : ℝ) : ℂ) * X v * Y v) := by
    unfold separatedLocalForm
    rw [hsum.tsum_eq]
  have hsq : Real.sqrt r⁻¹ * Real.sqrt r⁻¹ = r⁻¹ := Real.mul_self_sqrt (by positivity)
  have hterm : ∀ v, r * (r⁻¹ ^ 2 * ‖c' v * (((|d⁻¹| : ℝ) : ℂ) * X v * Y v)‖) =
      |d⁻¹| * (‖c v‖ * (Real.sqrt r⁻¹ * ‖X v‖) * (Real.sqrt r⁻¹ * ‖Y v‖)) := by
    intro v
    simp only [norm_mul, hc'n, Complex.norm_real, Real.norm_of_nonneg (abs_nonneg _)]
    have e : r * (r⁻¹ ^ 2) = Real.sqrt r⁻¹ * Real.sqrt r⁻¹ := by
      rw [hsq]; field_simp
    calc r * (r⁻¹ ^ 2 * (‖c v‖ * (|d⁻¹| * ‖X v‖ * ‖Y v‖)))
        = (r * r⁻¹ ^ 2) * (‖c v‖ * (|d⁻¹| * ‖X v‖ * ‖Y v‖)) := by ring
      _ = _ := by rw [e]; ring
  have hsum2 : Summable (fun v => ‖c' v * (((|d⁻¹| : ℝ) : ℂ) * X v * Y v)‖) := by
    refine Summable.of_nonneg_of_le (fun v => norm_nonneg _) (fun v => ?_)
      (hcs.mul_right (|d⁻¹| * (2 * ∫ y, ‖Ga y‖) * (2 * ∫ y, ‖Gb y‖)))
    simp only [norm_mul, hc'n, Complex.norm_real, Real.norm_of_nonneg (abs_nonneg _)]
    have h0 : 0 ≤ |d⁻¹| := abs_nonneg _
    calc ‖c v‖ * (|d⁻¹| * ‖X v‖ * ‖Y v‖)
        ≤ ‖c v‖ * (|d⁻¹| * (2 * ∫ y, ‖Ga y‖) * (2 * ∫ y, ‖Gb y‖)) := by
          gcongr
          · exact hXb v
          · exact hYb v
      _ = _ := by ring
  rw [hform, norm_mul, norm_pow, norm_inv, Complex.norm_real, Real.norm_of_nonneg hr.le]
  calc r * (r⁻¹ ^ 2 * ‖∑' v, c' v * (((|d⁻¹| : ℝ) : ℂ) * X v * Y v)‖)
      ≤ r * (r⁻¹ ^ 2 * ∑' v, ‖c' v * (((|d⁻¹| : ℝ) : ℂ) * X v * Y v)‖) := by
        gcongr; exact norm_tsum_le_tsum_norm hsum2
    _ = ∑' v, r * (r⁻¹ ^ 2 * ‖c' v * (((|d⁻¹| : ℝ) : ℂ) * X v * Y v)‖) := by
        rw [← tsum_mul_left, ← tsum_mul_left]
    _ = |d⁻¹| * ∑' v, ‖c v‖ * (Real.sqrt r⁻¹ * ‖X v‖) * (Real.sqrt r⁻¹ * ‖Y v‖) := by
        rw [← tsum_mul_left]; exact tsum_congr hterm

/-- A finite family of local rows `g ↦ ∫ conj(τ_i) g` over dyadic cells of a grid, each
supported in its decision cell, with a joint Bessel bound on `L²(ℝ)`. -/
structure CellRowFamily (G : RealDyadicGrid) (ι : Type) where
  /-- Finite set of row indices used in the cell family. -/
  index : Finset ι
  /-- Dyadic support cell assigned to each row. -/
  cell : ι → ℤ × ℤ
  /-- Measurable scalar test function assigned to each row. -/
  test : ι → ℝ → ℂ
  measurable : ∀ i, Measurable (test i)
  bounded : ∀ i, ∃ C, ∀ y, ‖test i y‖ ≤ C
  local_support : ∀ i y, y ∉ dyadicGridCell G (cell i).1 (cell i).2 → test i y = 0
  /-- Bessel bound controlling the square sum of the row coefficients. -/
  bound : ℝ
  bound_nonneg : 0 ≤ bound
  bessel : ∀ g : Lp ℂ 2 (volume : Measure ℝ),
    ∑ i ∈ index, ‖∫ y, conj (test i y) * g y‖ ^ 2 ≤ bound ^ 2 * ‖g‖ ^ 2

/-- Blueprint sec:base, lines 1482–1485: a cell-dependent opponent `z_I` for the input `F`
on the subtree rooted at `J` is admissible with transfer constant `K` if every local Bessel
row family over cells of `J` applied to the inputs `z_I` is controlled by `K` times its
bound times `‖1_J F‖₂`. -/
def IsAdmissibleOpponent (G : RealDyadicGrid) (J : ℤ × ℤ) (F : ℝ → ℂ)
    (z : ℤ × ℤ → ℝ → ℂ) (K : ℝ) : Prop :=
  ∀ (ι : Type) (R : CellRowFamily G ι),
    (∀ i ∈ R.index, dyadicGridCell G (R.cell i).1 (R.cell i).2 ⊆ dyadicGridCell G J.1 J.2) →
    ∑ i ∈ R.index, ‖∫ y, conj (R.test i y) * z (R.cell i) y‖ ^ 2 ≤
      K ^ 2 * R.bound ^ 2 * ∫ y in dyadicGridCell G J.1 J.2, ‖F y‖ ^ 2

theorem Lp_norm_sq_toLp_indicator {s : Set ℝ} (hs : MeasurableSet s) {F : ℝ → ℂ}
    (hF : MemLp (s.indicator F) 2) :
    ‖hF.toLp (s.indicator F)‖ ^ 2 = ∫ y in s, ‖F y‖ ^ 2 := by
  rw [Lp_norm_sq_eq_integral, ← integral_indicator hs]
  apply integral_congr_ae
  filter_upwards [MemLp.coeFn_toLp hF] with y hy
  rw [hy]
  by_cases h : y ∈ s
  · simp [Set.indicator_of_mem h]
  · simp [Set.indicator_of_notMem h]

theorem integral_conj_test_eq_indicator {G : RealDyadicGrid} {ι : Type}
    (R : CellRowFamily G ι) {s : Set ℝ} (i : ι)
    (hsub : dyadicGridCell G (R.cell i).1 (R.cell i).2 ⊆ s) (F : ℝ → ℂ) :
    ∫ y, conj (R.test i y) * F y = ∫ y, conj (R.test i y) * s.indicator F y := by
  congr 1; funext y
  by_cases h : y ∈ dyadicGridCell G (R.cell i).1 (R.cell i).2
  · rw [Set.indicator_of_mem (hsub h)]
  · rw [R.local_support i y h]; simp

/-- Blueprint sec:base, line 1482: a fixed square-integrable input is an admissible
opponent with transfer constant one. -/
theorem isAdmissibleOpponent_fixed (G : RealDyadicGrid) (J : ℤ × ℤ) {F : ℝ → ℂ}
    (hF : MemLp ((dyadicGridCell G J.1 J.2).indicator F) 2) :
    IsAdmissibleOpponent G J F (fun _ => F) 1 := by
  intro ι R hR
  set g := hF.toLp ((dyadicGridCell G J.1 J.2).indicator F)
  have hb := R.bessel g
  rw [Lp_norm_sq_toLp_indicator (dyadicGridCell_measurable G J.1 J.2) hF] at hb
  rw [one_pow, one_mul]
  refine le_trans (le_of_eq ?_) hb
  apply Finset.sum_congr rfl
  intro i hi
  rw [integral_conj_test_eq_indicator R i (hR i hi) F]
  congr 2
  apply integral_congr_ae
  filter_upwards [MemLp.coeFn_toLp hF] with y hy
  rw [hy]

/-- Blueprint sec:base, lines 1482–1484: a sequence `Z_I` with square energy
`Σ_I ∫_I |Z_I|² ≤ L² ‖1_J F‖²` over every finite collection of cells of `J` is an
admissible opponent with transfer constant `L`. -/
theorem isAdmissibleOpponent_squareEnergy (G : RealDyadicGrid) (J : ℤ × ℤ) {F : ℝ → ℂ}
    (Z : ℤ × ℤ → ℝ → ℂ) {L : ℝ}
    (hZ : ∀ I : ℤ × ℤ, MemLp ((dyadicGridCell G I.1 I.2).indicator (Z I)) 2)
    (henergy : ∀ S : Finset (ℤ × ℤ),
      (∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2) →
      ∑ I ∈ S, ∫ y in dyadicGridCell G I.1 I.2, ‖Z I y‖ ^ 2 ≤
        L ^ 2 * ∫ y in dyadicGridCell G J.1 J.2, ‖F y‖ ^ 2) :
    IsAdmissibleOpponent G J F Z L := by
  classical
  intro ι R hR
  set S := R.index.image R.cell with hS
  have hfiber : ∀ I ∈ S, ∑ i ∈ R.index.filter (fun i => R.cell i = I),
      ‖∫ y, conj (R.test i y) * Z (R.cell i) y‖ ^ 2 ≤
        R.bound ^ 2 * ∫ y in dyadicGridCell G I.1 I.2, ‖Z I y‖ ^ 2 := by
    intro I _
    set g := (hZ I).toLp ((dyadicGridCell G I.1 I.2).indicator (Z I))
    have hb := R.bessel g
    rw [Lp_norm_sq_toLp_indicator (dyadicGridCell_measurable G I.1 I.2) (hZ I)] at hb
    refine le_trans ?_ hb
    calc ∑ i ∈ R.index.filter (fun i => R.cell i = I),
          ‖∫ y, conj (R.test i y) * Z (R.cell i) y‖ ^ 2
        = ∑ i ∈ R.index.filter (fun i => R.cell i = I),
          ‖∫ y, conj (R.test i y) * g y‖ ^ 2 := by
          apply Finset.sum_congr rfl
          intro i hi
          rw [(Finset.mem_filter.mp hi).2]
          have hsub : dyadicGridCell G (R.cell i).1 (R.cell i).2 ⊆
              dyadicGridCell G I.1 I.2 := by
            rw [(Finset.mem_filter.mp hi).2]
          rw [integral_conj_test_eq_indicator R i hsub (Z I)]
          congr 2
          apply integral_congr_ae
          filter_upwards [MemLp.coeFn_toLp (hZ I)] with y hy
          rw [hy]
      _ ≤ ∑ i ∈ R.index, ‖∫ y, conj (R.test i y) * g y‖ ^ 2 :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
            (fun _ _ _ => by positivity)
  have hS' : ∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2 := by
    intro I hI
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hI
    exact hR i hi
  calc ∑ i ∈ R.index, ‖∫ y, conj (R.test i y) * Z (R.cell i) y‖ ^ 2
      = ∑ I ∈ S, ∑ i ∈ R.index.filter (fun i => R.cell i = I),
          ‖∫ y, conj (R.test i y) * Z (R.cell i) y‖ ^ 2 :=
        (Finset.sum_fiberwise_of_maps_to (fun i hi => Finset.mem_image_of_mem _ hi) _).symm
    _ ≤ ∑ I ∈ S, R.bound ^ 2 * ∫ y in dyadicGridCell G I.1 I.2, ‖Z I y‖ ^ 2 :=
        Finset.sum_le_sum hfiber
    _ = R.bound ^ 2 * ∑ I ∈ S, ∫ y in dyadicGridCell G I.1 I.2, ‖Z I y‖ ^ 2 := by
        rw [Finset.mul_sum]
    _ ≤ R.bound ^ 2 * (L ^ 2 * ∫ y in dyadicGridCell G J.1 J.2, ‖F y‖ ^ 2) :=
        mul_le_mul_of_nonneg_left (henergy S hS') (by positivity)
    _ = L ^ 2 * R.bound ^ 2 * ∫ y in dyadicGridCell G J.1 J.2, ‖F y‖ ^ 2 := by ring

/-- The separated form only sees its inputs on the cell. -/
theorem separatedLocalForm_indicator {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (Q : ℝ → ℂ) (a b : Fin 4)
    (Fa Fb : ℝ → ℂ) :
    separatedLocalForm r w Q a b Fa Fb = separatedLocalForm r w Q a b
      ((Set.Ico a₀ (a₀ + r)).indicator Fa) ((Set.Ico a₀ (a₀ + r)).indicator Fb) := by
  unfold separatedLocalForm
  congr 2; funext z
  by_cases hz : w z = 0
  · simp [hz]
  have hm := mul_pos κ.margin_pos hr
  have ha := hw.support z hz a
  have hb := hw.support z hz b
  rw [Set.indicator_of_mem (show realProgressionCoordinate a z ∈ Set.Ico a₀ (a₀ + r) from
      ⟨by linarith [ha.1], by linarith [ha.2]⟩),
    Set.indicator_of_mem (show realProgressionCoordinate b z ∈ Set.Ico a₀ (a₀ + r) from
      ⟨by linarith [hb.1], by linarith [hb.2]⟩)]

/-- The pointwise weighted envelope of admissible-kernel Fourier coefficients. -/
noncomputable def kernelPointEnvelope (κ : LocalKernelClass) (p : ℕ) : ℝ :=
  max (kernelUnitEnvelope κ 0)
    (kernelUnitEnvelope κ (p + 2 + 1) * Real.sqrt (2 : ℕ) ^ (p + 2 + 1) * 2 ^ p)

theorem admissibleKernel_coeff_envelope {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (p : ℕ)
    (v : Fin 2 → ℤ) :
    ‖periodicFourierCoeff (cubePeriodization (kernelUnitRescale a₀ r w) 16) v‖ *
      (1 + frequencyLength v) ^ p ≤ kernelPointEnvelope κ p := by
  set c := periodicFourierCoeff (cubePeriodization (kernelUnitRescale a₀ r w) 16)
  set F := kernelUnitRescale a₀ r w with hFdef
  have hFs : ContDiff ℝ (⊤ : ℕ∞) F := hw.smooth.comp (by fun_prop)
  have hsupp : ∀ u, F u ≠ 0 → ∀ l, |u l| ≤ 4 := fun u hu l => kernelUnitRescale_support hr hw hu l
  set f := cubePeriodization F 16 with hf
  have hfs : ContDiff ℝ (⊤ : ℕ∞) f := cubePeriodization_smooth hFs (by norm_num) (by norm_num) hsupp
  set A : ℕ → ℝ := kernelUnitEnvelope κ with hA
  have hA0' : ∀ m, 0 ≤ A m := fun m => by
    simp only [hA, kernelUnitEnvelope]; have := kernelDerivBound_nonneg κ m; positivity
  have hline (m : ℕ) (i : Fin 2) (x : Fin 1 → ℝ) (t : ℝ) :
      ‖iteratedDeriv m (fun s => f (i.insertNth s x)) t‖ ≤ A m :=
    cubePeriodization_line_le hFs (by norm_num) (by norm_num) hsupp m
      (fun i x t => kernelUnitRescale_line_le hr hw m i x t) i x t
  have hB (y : Fin 2 → ℝ) : ‖f y‖ ≤ A 0 := by
    have h := cubePeriodization_iteratedFDeriv_le hFs (R := 4) (L := 16) (by norm_num)
      (by norm_num) hsupp 0 (A := kernelDerivBound κ 0) (fun u => by
        rw [norm_iteratedFDeriv_zero]
        change ‖w (a₀ + r / 2 + r * u 0, r * u 1)‖ ≤ _
        have hb := hw.derivativeBound 0 0 (a₀ + r / 2 + r * u 0, r * u 1)
        simpa [localKernelPartial, kernelDerivBound, kernelUnitRescale] using hb) y
    rw [norm_iteratedFDeriv_zero] at h
    simpa [hA, kernelUnitEnvelope] using h
  have hexp (m : ℕ) (hm : 1 + 1 < m) := periodic_fourier_expansion (d := 1) hm f hfs.continuous
    (cubePeriodization_periodic F 16)
    (fun i x => (hfs.comp (contDiff_insertNth_line i x)).of_le (by exact_mod_cast le_top))
    (hline m) hB
  have hc0 : ∀ v, ‖c v‖ ≤ A 0 := fun v => (hexp 3 (by norm_num)).2.2.2 v
  have hcm : ∀ m, 2 < m → ∀ v, v ≠ 0 → ‖c v‖ ≤
      A m * (Real.sqrt (2 : ℕ) / (2 * Real.pi * frequencyLength v)) ^ m := by
    intro m hm v hv
    have := (hexp m (by omega)).2.2.1 v hv
    have h2 : Real.sqrt ((1 : ℕ) + 1 : ℝ) = Real.sqrt ((2 : ℕ) : ℝ) := by norm_num
    rw [h2] at this
    exact this
  have hsum : Summable (fun v => ‖c v‖) := (admissibleKernel_fourier_expansion hr hw).1
  exact (fourier_coeff_envelope_bounds c hsum hA0' hc0 hcm).1 p v

/-- Absolute summability of the frequency weight `(1 + |v|)⁻³` on `ℤ²`. -/
theorem summable_frequency_weight_three :
    Summable (fun v : Fin 2 → ℤ => ((1 + frequencyLength v) ^ 3)⁻¹) := by
  have hc : ∀ v : Fin 2 → ℤ, v ≠ 0 → ‖(((1 + frequencyLength v) ^ 3)⁻¹ : ℂ)‖ ≤
      (2 * Real.pi / Real.sqrt (2 : ℕ)) ^ 3 *
        (Real.sqrt (2 : ℕ) / (2 * Real.pi * frequencyLength v)) ^ 3 := by
    intro v hv
    have hL : 1 ≤ frequencyLength v := one_le_frequencyLength hv
    have hs : 0 < Real.sqrt (2 : ℕ) := by positivity
    rw [← mul_pow, show 2 * Real.pi / Real.sqrt (2 : ℕ) *
        (Real.sqrt (2 : ℕ) / (2 * Real.pi * frequencyLength v)) = (frequencyLength v)⁻¹ by
      field_simp]
    rw [norm_inv, norm_pow, ← Complex.ofReal_one, ← Complex.ofReal_add, Complex.norm_real,
      Real.norm_of_nonneg (by linarith), inv_pow]
    exact inv_anti₀ (by positivity) (pow_le_pow_left₀ (by linarith) (by linarith) 3)
  have h := summable_norm_of_frequency_decay (by positivity) (by norm_num : 2 < 3)
    (fun v : Fin 2 → ℤ => (((1 + frequencyLength v) ^ 3)⁻¹ : ℂ)) hc
  refine h.congr fun v => ?_
  rw [norm_inv, norm_pow, ← Complex.ofReal_one, ← Complex.ofReal_add, Complex.norm_real,
    Real.norm_of_nonneg (by have := frequencyLength_nonneg v; linarith)]

/-- The normalized mean-zero wave rows `g ↦ |I|^{-1/2} ∫_I ω_I e(ν_I y) ψ g` of blueprint
lem:predictors, proof lines 1534–1538, written as `∫ conj(test) g`. -/
noncomputable def waveRowTest (G : RealDyadicGrid) (κ : LocalKernelClass) {ι : Type*}
    (cell : ι → ℤ × ℤ) (α ν : ι → ℝ) (ψ : ℝ → ℂ) (I : ι) (y : ℝ) : ℂ :=
  ((Real.sqrt (dyadicGridLength G (cell I).1)⁻¹ : ℝ) : ℂ) *
    conj (classWave κ (dyadicGridLeft G (cell I).1 (cell I).2) (dyadicGridLength G (cell I).1) (α
        I) y *
      (Real.fourierChar (ν I * y) : ℂ) * ψ y)

theorem integral_conj_waveRowTest (G : RealDyadicGrid) (κ : LocalKernelClass) {ι : Type*}
    (cell : ι → ℤ × ℤ) (α ν : ι → ℝ) (ψ : ℝ → ℂ) (I : ι) (g : ℝ → ℂ) :
    ∫ y, conj (waveRowTest G κ cell α ν ψ I y) * g y =
      ((Real.sqrt (dyadicGridLength G (cell I).1)⁻¹ : ℝ) : ℂ) *
        ∫ y, classWave κ (dyadicGridLeft G (cell I).1 (cell I).2) (dyadicGridLength G (cell I).1)
            (α I) y *
          (Real.fourierChar (ν I * y) : ℂ) * ψ y * g y := by
  rw [← integral_const_mul]
  congr 1; funext y
  simp only [waveRowTest, map_mul, Complex.conj_ofReal, RCLike.conj_conj]
  ring

/-- The bound for the second derivative of a class wave in the normalized form `A / r²`. -/
theorem classWave_deriv2_le (κ : LocalKernelClass) {a₀ r : ℝ} (hr : 0 < r) (α : ℝ) {A : ℝ}
    (hA : 2 * (kernelPlateau κ).K * (1 + 6 * Real.pi * (r * |α|)) ^ 2 ≤ A) (y : ℝ) :
    ‖deriv (deriv (classWave κ a₀ r α)) y‖ ≤ A / r ^ 2 := by
  refine ((classWave_props κ hr α).2.2.2.2 y).trans ?_
  rw [le_div_iff₀ (by positivity)]
  have e : 2 * (kernelPlateau κ).K * (1 / r + 6 * Real.pi * |α|) ^ 2 * r ^ 2 =
      2 * (kernelPlateau κ).K * (1 + 6 * Real.pi * (r * |α|)) ^ 2 := by
    field_simp
  rw [e]; exact hA

/-- Blueprint lem:predictors, proof lines 1538–1541: the mean-zero wave rows over a finite
set of grid cells are jointly Bessel, with squared bound `2 A² M B²`, where `M` bounds the
frequency multiplicity of the (scale, center) pairs, `A` the wave derivative constant and
`B` the multiplier `ψ`. -/
theorem waveRow_bessel (G : RealDyadicGrid) (κ : LocalKernelClass) {ι : Type*}
    (cell : ι → ℤ × ℤ) (S : Finset ι) (α ν : ι → ℝ)
    (hinj : Set.InjOn (fun I => (cell I, ν I)) S) {ψ : ℝ → ℂ} (hψm : Measurable ψ) {B : ℝ} (hψ : ∀
        y, ‖ψ y‖ ≤ B)
    {A : ℝ} (hA2 : 2 ≤ A)
    (hA : ∀ I ∈ S, 2 * (kernelPlateau κ).K *
      (1 + 6 * Real.pi * (dyadicGridLength G (cell I).1 * |α I|)) ^ 2 ≤ A)
    {M : ℝ} (hM : ∀ ξ, ∑ p ∈ S.image (fun I => ((cell I).1, ν I)),
      bumpMultiplier (dyadicGridLength G p.1 * (ξ - p.2)) ≤ M)
    (g : Lp ℂ 2 (volume : Measure ℝ)) :
    ∑ I ∈ S, ‖∫ y, conj (waveRowTest G κ cell α ν ψ I y) * g y‖ ^ 2 ≤
      2 * A ^ 2 * M * B ^ 2 * ‖g‖ ^ 2 := by
  classical
  obtain ⟨θ, hθd⟩ : ∃ θ : ℤ × ℝ → ι → ℝ → ℂ, θ = fun p I =>
      if I ∈ S ∧ ((cell I).1, ν I) = p then
        classWave κ (dyadicGridLeft G p.1 (cell I).2) (dyadicGridLength G p.1) (α I) else 0 :=
    ⟨_, rfl⟩
  have hlen : ∀ p : ℤ × ℝ, 0 < dyadicGridLength G p.1 := fun p => dyadicGridLength_pos G p.1
  have hA0 : 0 ≤ A := by linarith
  -- the conjugated input
  have hgs := (Lp.memLp g).star
  set gs := hgs.toLp (star (g : ℝ → ℂ))
  have hcm : Measurable (fun y => conj (ψ y)) := Complex.continuous_conj.measurable.comp hψm
  have hcb : ∀ y, ‖conj (ψ y)‖ ≤ B := fun y => by rw [RCLike.norm_conj]; exact hψ y
  set! F := (memLp_two_mul_bounded hcm hcb gs).toLp (fun y => conj (ψ y) * gs y)
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hψ 0)
  have hF : ‖F‖ ^ 2 ≤ B ^ 2 * ‖g‖ ^ 2 := by
    rw [norm_sq_toLp_mul hcm hcb gs, Lp_norm_sq_eq_integral g, ← integral_const_mul]
    have hint : Integrable (fun y => ‖g y‖ ^ 2) := by
      exact (Lp.memLp g).integrable_norm_pow (by norm_num)
    refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => by positivity)
      (hint.const_mul _) ?_
    filter_upwards [MemLp.coeFn_toLp hgs] with y hy
    rw [hy]
    simp only [Pi.star_apply, RCLike.star_def, RCLike.norm_conj]
    exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (norm_nonneg _) (hψ y) 2)
      (by positivity)
  -- per-cell identity
  have hrow : ∀ I ∈ S, ‖∫ y, conj (waveRowTest G κ cell α ν ψ I y) * g y‖ ^ 2 =
      (dyadicGridLength G (cell I).1)⁻¹ * ‖∫ y, conj ((Real.fourierChar (ν I * y) : ℂ) *
        θ ((cell I).1, ν I) I y) * F y‖ ^ 2 := by
    intro I hI
    have hθI : θ ((cell I).1, ν I) I =
        classWave κ (dyadicGridLeft G (cell I).1 (cell I).2) (dyadicGridLength G (cell I).1) (α
            I) := by
      simp only [hθd, hI, true_and, ↓reduceIte]
    rw [integral_conj_waveRowTest, norm_mul, mul_pow, Complex.norm_real,
      Real.norm_of_nonneg (Real.sqrt_nonneg _),
      Real.sq_sqrt (inv_nonneg.mpr (dyadicGridLength_pos G (cell I).1).le)]
    congr 1
    have h : ∫ y, conj ((Real.fourierChar (ν I * y) : ℂ) * θ ((cell I).1, ν I) I y) * F y =
        conj (∫ y, classWave κ (dyadicGridLeft G (cell I).1 (cell I).2) (dyadicGridLength G (cell
            I).1) (α I) y *
          (Real.fourierChar (ν I * y) : ℂ) * ψ y * g y) := by
      rw [← integral_conj]
      apply integral_congr_ae
      filter_upwards [MemLp.coeFn_toLp (memLp_two_mul_bounded hcm hcb gs),
        MemLp.coeFn_toLp hgs] with y h1 h2
      rw [h1, h2, hθI]
      simp only [Pi.star_apply, RCLike.star_def, map_mul]
      ring
    rw [h, RCLike.norm_conj]
  have hdisj : ∀ p : ℤ × ℝ, ((S.filter (fun I => ((cell I).1, ν I) = p) : Finset ι) :
      Set ι).PairwiseDisjoint (fun I => Set.Ico (dyadicGridLeft G p.1 (cell I).2)
        (dyadicGridLeft G p.1 (cell I).2 + dyadicGridLength G p.1)) := by
    intro p I hI J hJ hIJ
    have hI' := (Finset.mem_filter.mp hI).2
    have hJ' := (Finset.mem_filter.mp hJ).2
    have h1 : (cell I).1 = (cell J).1 := by
      have a1 := congrArg Prod.fst hI'
      have a2 := congrArg Prod.fst hJ'
      rw [a1, a2]
    have h2 : (cell I).2 ≠ (cell J).2 := by
      intro h
      apply hIJ
      have hν : ν I = ν J := by
        have a1 := congrArg Prod.snd hI'
        have a2 := congrArg Prod.snd hJ'
        simp only at a1 a2
        rw [a1, a2]
      exact hinj (Finset.mem_filter.mp hI).1 (Finset.mem_filter.mp hJ).1
        (Prod.ext (Prod.ext h1 h) hν)
    exact dyadicGridCell_pairwiseDisjoint G p.1 h2
  have hθc : ∀ p I, ContDiff ℝ 2 (θ p I) := by
    intro p I; simp only [hθd]; split_ifs
    · exact (classWave_props κ (hlen p) (α I)).1.of_le (by simp)
    · exact contDiff_const
  have hθs : ∀ p I y, y ∉ Set.Ico (dyadicGridLeft G p.1 (cell I).2)
      (dyadicGridLeft G p.1 (cell I).2 + dyadicGridLength G p.1) → θ p I y = 0 := by
    intro p I y hy; simp only [hθd]; split_ifs
    · exact (classWave_props κ (hlen p) (α I)).2.1 y hy
    · rfl
  have hθm : ∀ p I, ∫ y, θ p I y = 0 := by
    intro p I; simp only [hθd]; split_ifs
    · exact (classWave_props κ (hlen p) (α I)).2.2.1
    · simp
  have hθb : ∀ p I y, ‖θ p I y‖ ≤ A := by
    intro p I y; simp only [hθd]; split_ifs
    · exact ((classWave_props κ (hlen p) (α I)).2.2.2.1 y).trans hA2
    · simp only [Pi.zero_apply, norm_zero]; exact hA0
  have hθ2 : ∀ p I y, ‖deriv (deriv (θ p I)) y‖ ≤ A / dyadicGridLength G p.1 ^ 2 := by
    intro p I y; simp only [hθd]; split_ifs with h
    · have hp : p.1 = (cell I).1 := by rw [← h.2]
      refine classWave_deriv2_le κ (hlen p) (α I) ?_ y
      rw [hp]; exact hA I h.1
    · have h0 : deriv (deriv (fun _ : ℝ => (0 : ℂ))) y = 0 := by simp
      rw [show (0 : ℝ → ℂ) = fun _ => 0 from rfl, h0, norm_zero]
      have := hlen p; positivity
  have hbes := multiscale_meanZero_bessel (S.image (fun I => ((cell I).1, ν I)))
    (fun p : ℤ × ℝ => dyadicGridLength G p.1) (fun p => p.2) hlen
    (fun p => S.filter (fun I => ((cell I).1, ν I) = p)) (fun p I => dyadicGridLeft G p.1 (cell
        I).2) hA0
    hdisj
    θ hθc hθs hθm hθb hθ2 hM F
  have hM0 : 0 ≤ M := (Finset.sum_nonneg fun p _ => bumpMultiplier_nonneg _).trans (hM 0)
  calc ∑ I ∈ S, ‖∫ y, conj (waveRowTest G κ cell α ν ψ I y) * g y‖ ^ 2
      = ∑ p ∈ S.image (fun I => ((cell I).1, ν I)), ∑ I ∈ S.filter (fun I => ((cell I).1, ν I) = p),
          ‖∫ y, conj (waveRowTest G κ cell α ν ψ I y) * g y‖ ^ 2 :=
        (Finset.sum_fiberwise_of_maps_to
          (fun I hI => Finset.mem_image_of_mem (fun I => ((cell I).1, ν I)) hI) _).symm
    _ = ∑ p ∈ S.image (fun I => ((cell I).1, ν I)), ∑ I ∈ S.filter (fun I => ((cell I).1, ν I) = p),
          (dyadicGridLength G p.1)⁻¹ *
          ‖∫ y, conj ((Real.fourierChar (p.2 * y) : ℂ) * θ p I y) * F y‖ ^ 2 := by
        refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun I hI => ?_
        obtain ⟨hIS, rfl⟩ := Finset.mem_filter.mp hI
        exact hrow I hIS
    _ ≤ 2 * A ^ 2 * M * ‖F‖ ^ 2 := hbes
    _ ≤ 2 * A ^ 2 * M * (B ^ 2 * ‖g‖ ^ 2) :=
        mul_le_mul_of_nonneg_left hF (by positivity)
    _ = 2 * A ^ 2 * M * B ^ 2 * ‖g‖ ^ 2 := by ring

theorem measurable_waveRowTest (G : RealDyadicGrid) (κ : LocalKernelClass) {ι : Type*}
    (cell : ι → ℤ × ℤ) (α ν : ι → ℝ) {ψ : ℝ → ℂ} (hψm : Measurable ψ) (I : ι) : Measurable
        (waveRowTest G κ cell α ν ψ I) := by
  have hc : Continuous (fun y : ℝ => (Real.fourierChar (ν I * y) : ℂ)) :=
    continuous_subtype_val.comp (Real.continuous_fourierChar.comp
      (continuous_const.mul continuous_id))
  have h := (((classWave_props κ (a₀ := dyadicGridLeft G (cell I).1 (cell I).2)
      (dyadicGridLength_pos G (cell I).1)
    (α I)).1.continuous.mul
    hc).measurable.mul hψm)
  exact measurable_const.mul (Complex.continuous_conj.measurable.comp h)

theorem norm_waveRowTest_le (G : RealDyadicGrid) (κ : LocalKernelClass) {ι : Type*}
    (cell : ι → ℤ × ℤ) (α ν : ι → ℝ) {ψ : ℝ → ℂ} {B : ℝ} (hψ : ∀ y, ‖ψ y‖ ≤ B) (I : ι) (y : ℝ) :
    ‖waveRowTest G κ cell α ν ψ I y‖ ≤ Real.sqrt (dyadicGridLength G (cell I).1)⁻¹ * (2 * B) := by
  simp only [waveRowTest, norm_mul, Complex.norm_real, Real.norm_of_nonneg (Real.sqrt_nonneg _),
    RCLike.norm_conj, Circle.norm_coe, mul_one]
  exact mul_le_mul_of_nonneg_left (mul_le_mul
    ((classWave_props κ (dyadicGridLength_pos G (cell I).1) (α I)).2.2.2.1 y) (hψ y)
    (norm_nonneg _) (by norm_num)) (Real.sqrt_nonneg _)

theorem waveRowTest_local (G : RealDyadicGrid) (κ : LocalKernelClass) {ι : Type*}
    (cell : ι → ℤ × ℤ) (α ν : ι → ℝ) (ψ : ℝ → ℂ) (I : ι) (y : ℝ)
    (hy : y ∉ dyadicGridCell G (cell I).1 (cell I).2) :
    waveRowTest G κ cell α ν ψ I y = 0 := by
  simp only [waveRowTest]
  rw [(classWave_props κ (dyadicGridLength_pos G (cell I).1) (α I)).2.1 y hy]
  simp

/-- The mean-zero wave rows as a local Bessel row family. -/
noncomputable def waveRowFamily (G : RealDyadicGrid) (κ : LocalKernelClass) {ι : Type}
    (cell : ι → ℤ × ℤ) (S : Finset ι) (α ν : ι → ℝ)
    (hinj : Set.InjOn (fun I => (cell I, ν I)) S) {ψ : ℝ → ℂ} (hψm : Measurable ψ) {B : ℝ}
    (hψ : ∀ y, ‖ψ y‖ ≤ B) {A : ℝ} (hA2 : 2 ≤ A)
    (hA : ∀ I ∈ S, 2 * (kernelPlateau κ).K *
      (1 + 6 * Real.pi * (dyadicGridLength G (cell I).1 * |α I|)) ^ 2 ≤ A)
    {M : ℝ} (hM : ∀ ξ, ∑ p ∈ S.image (fun I => ((cell I).1, ν I)),
      bumpMultiplier (dyadicGridLength G p.1 * (ξ - p.2)) ≤ M) :
    CellRowFamily G ι where
  index := S
  cell := cell
  test := waveRowTest G κ cell α ν ψ
  measurable := measurable_waveRowTest G κ cell α ν hψm
  bounded I := ⟨_, norm_waveRowTest_le G κ cell α ν hψ I⟩
  local_support I y hy := waveRowTest_local G κ cell α ν ψ I y hy
  bound := A * B * Real.sqrt (2 * M)
  bound_nonneg := by
    have hB0 : 0 ≤ B := (norm_nonneg _).trans (hψ 0)
    have : 0 ≤ A := by linarith
    positivity
  bessel g := by
    have hM0 : 0 ≤ M := (Finset.sum_nonneg fun p _ => bumpMultiplier_nonneg _).trans (hM 0)
    have h := waveRow_bessel G κ cell S α ν hinj hψm hψ hA2 hA hM g
    refine h.trans (le_of_eq ?_)
    rw [mul_pow, mul_pow, Real.sq_sqrt (by positivity)]
    ring

/-- The slot frequencies of a kernel character are at most `|v|/4` at unit scale. -/
theorem slotPairFreqA_le {a b : Fin 4} (hab : a ≠ b) {r : ℝ} (hr : 0 < r) (v : Fin 2 → ℤ) :
    r * |slotPairFreqA a b r v| ≤ frequencyLength v / 4 := by
  have hd := one_le_abs_fin_sub hab
  have h0 := abs_frequency_coordinate_le v 0
  have h1 := abs_frequency_coordinate_le v 1
  have hb := abs_fin_four_le b
  unfold slotPairFreqA
  rw [abs_div, abs_mul, abs_mul, abs_of_pos hr, abs_of_pos (by norm_num : (0 : ℝ) < 16)]
  rw [show r * (|(v 0 : ℝ) * (b : ℝ) - (v 1 : ℝ)| / (16 * r * |(b : ℝ) - (a : ℝ)|)) =
    |(v 0 : ℝ) * (b : ℝ) - (v 1 : ℝ)| / (16 * |(b : ℝ) - (a : ℝ)|) by field_simp]
  rw [div_le_iff₀ (by positivity)]
  have e1 : |(v 0 : ℝ) * (b : ℝ) - (v 1 : ℝ)| ≤ 3 * frequencyLength v + frequencyLength v := by
    refine (abs_sub _ _).trans (add_le_add ?_ h1)
    rw [abs_mul]
    nlinarith [abs_nonneg (v 0 : ℝ), abs_nonneg (b : ℝ)]
  have hL := frequencyLength_nonneg v
  nlinarith

theorem slotPairFreqB_le {a b : Fin 4} (hab : a ≠ b) {r : ℝ} (hr : 0 < r) (v : Fin 2 → ℤ) :
    r * |slotPairFreqB a b r v| ≤ frequencyLength v / 4 := by
  have hd := one_le_abs_fin_sub hab
  have h0 := abs_frequency_coordinate_le v 0
  have h1 := abs_frequency_coordinate_le v 1
  have ha := abs_fin_four_le a
  unfold slotPairFreqB
  rw [abs_div, abs_mul, abs_mul, abs_of_pos hr, abs_of_pos (by norm_num : (0 : ℝ) < 16)]
  rw [show r * (|(v 1 : ℝ) - (v 0 : ℝ) * (a : ℝ)| / (16 * r * |(b : ℝ) - (a : ℝ)|)) =
    |(v 1 : ℝ) - (v 0 : ℝ) * (a : ℝ)| / (16 * |(b : ℝ) - (a : ℝ)|) by field_simp]
  rw [div_le_iff₀ (by positivity)]
  have e1 : |(v 1 : ℝ) - (v 0 : ℝ) * (a : ℝ)| ≤ frequencyLength v + 3 * frequencyLength v := by
    refine (abs_sub _ _).trans (add_le_add h1 ?_)
    rw [abs_mul]
    nlinarith [abs_nonneg (v 0 : ℝ), abs_nonneg (a : ℝ)]
  have hL := frequencyLength_nonneg v
  nlinarith

/-- The wave derivative constant for a kernel character of length `L`. -/
noncomputable def charWaveConst (κ : LocalKernelClass) (L : ℝ) : ℝ :=
  (2 + 2 * (kernelPlateau κ).K) * 25 * (1 + L) ^ 2

theorem two_le_charWaveConst (κ : LocalKernelClass) {L : ℝ} (hL : 0 ≤ L) :
    2 ≤ charWaveConst κ L := by
  have hK := (kernelPlateau κ).K_nonneg
  unfold charWaveConst
  have : 1 ≤ (1 + L) ^ 2 := one_le_pow₀ (by linarith)
  nlinarith

theorem charWaveConst_ge (κ : LocalKernelClass) {L β : ℝ} (hβ : 0 ≤ β) (hβL : β ≤ L / 4) :
    2 * (kernelPlateau κ).K * (1 + 6 * Real.pi * β) ^ 2 ≤ charWaveConst κ L := by
  have hK := (kernelPlateau κ).K_nonneg
  have hπ := Real.pi_lt_d2
  have h1 : 1 + 6 * Real.pi * β ≤ 5 * (1 + L) := by nlinarith [Real.pi_pos]
  have h2 : (1 + 6 * Real.pi * β) ^ 2 ≤ 25 * (1 + L) ^ 2 := by
    have h0 : 0 ≤ 1 + 6 * Real.pi * β := by positivity
    nlinarith
  unfold charWaveConst
  nlinarith [sq_nonneg (1 + L)]

theorem bumpMultiplier_neg (η : ℝ) : bumpMultiplier (-η) = bumpMultiplier η := by
  unfold bumpMultiplier; simp [abs_neg]

/-- Negating all centers preserves the frequency multiplicity bound. -/
theorem multiplicity_neg (G : RealDyadicGrid) {ι : Type*} (cell : ι → ℤ × ℤ) (S : Finset ι)
    (ν : ι → ℝ) {M : ℝ}
    (hM : ∀ ξ, ∑ p ∈ S.image (fun I => ((cell I).1, ν I)),
      bumpMultiplier (dyadicGridLength G p.1 * (ξ - p.2)) ≤ M) (ξ : ℝ) :
    ∑ p ∈ S.image (fun I => ((cell I).1, -ν I)),
      bumpMultiplier (dyadicGridLength G p.1 * (ξ - p.2)) ≤ M := by
  classical
  have himg : S.image (fun I => ((cell I).1, -ν I)) =
      (S.image (fun I => ((cell I).1, ν I))).image (fun p : ℤ × ℝ => (p.1, -p.2)) := by
    rw [Finset.image_image]; rfl
  have hinj : Set.InjOn (fun p : ℤ × ℝ => (p.1, -p.2))
      (S.image (fun I => ((cell I).1, ν I)) : Set (ℤ × ℝ)) := by
    intro p _ q _ h
    simp only [Prod.mk.injEq, neg_inj] at h
    exact Prod.ext h.1 h.2
  rw [himg, Finset.sum_image hinj]
  refine le_trans (le_of_eq ?_) (hM (-ξ))
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [← bumpMultiplier_neg]
  congr 1; ring

/-- A mean-zero wave annihilates the outside of its cell, so a cell indicator on the input
may be dropped. -/
theorem integral_classWave_indicator (κ : LocalKernelClass) {a₀ r : ℝ} (hr : 0 < r) (α : ℝ)
    (E : ℝ → ℂ) (g : ℝ → ℂ) :
    ∫ y, classWave κ a₀ r α y * E y * (Set.Ico a₀ (a₀ + r)).indicator g y =
      ∫ y, classWave κ a₀ r α y * E y * g y := by
  congr 1; funext y
  by_cases hy : y ∈ Set.Ico a₀ (a₀ + r)
  · rw [Set.indicator_of_mem hy]
  · rw [(classWave_props κ hr α).2.1 y hy]; simp

/-- The constant of the linear-phase scale sum. -/
noncomputable def linearScaleConst (κ : LocalKernelClass) : ℝ :=
  kernelPointEnvelope κ 7 * ((2 + 2 * (kernelPlateau κ).K) * 25) ^ 2 * 2 *
    ∑' v : Fin 2 → ℤ, ((1 + frequencyLength v) ^ 3)⁻¹

theorem integrable_cell_mul {s : Set ℝ} (hs : MeasurableSet s) {ψ z : ℝ → ℂ}
    (hψm : Measurable ψ) (hψ : ∀ y, ‖ψ y‖ ≤ 1) (hzm : Measurable z) (hz : IntegrableOn z s) :
    Integrable (s.indicator (fun y => ψ y * z y)) := by
  rw [integrable_indicator_iff hs]
  refine hz.norm.mono' (hψm.mul hzm).aestronglyMeasurable ?_
  filter_upwards with y
  rw [norm_mul]
  exact mul_le_of_le_one_left (norm_nonneg _) (hψ y)

/-- Blueprint lem:predictors, proof lines 1534–1542: for linear phases `e(γ_I t)` the
length-weighted scale sum of the separated forms against admissible opponents is bounded by
the frequency multiplicity `M` of the (scale, center) pairs times the transfer constants and
the input norms on `J`. -/
theorem linear_phase_scale_sum (G : RealDyadicGrid) (κ : LocalKernelClass) (J : ℤ × ℤ)
    {ι : Type} (cell : ι → ℤ × ℤ) (S : Finset ι)
    (hSJ : ∀ I ∈ S, dyadicGridCell G (cell I).1 (cell I).2 ⊆ dyadicGridCell G J.1 J.2)
    (w : ι → ℝ × ℝ → ℂ)
    (hw : ∀ I ∈ S, IsAdmissibleLocalKernel κ (dyadicGridLeft G (cell I).1 (cell I).2)
      (dyadicGridLength G (cell I).1) (w I))
    {a b : Fin 4} (hab : a ≠ b) (γ : ι → ℝ)
    (hinj : Set.InjOn (fun I => (cell I, γ I / ((b : ℝ) - (a : ℝ)))) S)
    {ψa ψb : ℝ → ℂ} (hψam : Measurable ψa) (hψbm : Measurable ψb)
    (hψa : ∀ y, ‖ψa y‖ ≤ 1) (hψb : ∀ y, ‖ψb y‖ ≤ 1)
    {Fa Fb : ℝ → ℂ} {za zb : ℤ × ℤ → ℝ → ℂ} {Ka Kb : ℝ} (hKa : 0 ≤ Ka) (hKb : 0 ≤ Kb)
    (hza : IsAdmissibleOpponent G J Fa za Ka) (hzb : IsAdmissibleOpponent G J Fb zb Kb)
    (hzam : ∀ I, Measurable (za I)) (hzbm : ∀ I, Measurable (zb I))
    (hzai : ∀ I ∈ S, IntegrableOn (za (cell I)) (dyadicGridCell G (cell I).1 (cell I).2))
    (hzbi : ∀ I ∈ S, IntegrableOn (zb (cell I)) (dyadicGridCell G (cell I).1 (cell I).2))
    {M : ℝ} (hM : ∀ ξ, ∑ p ∈ S.image (fun I => ((cell I).1, γ I / ((b : ℝ) - (a : ℝ)))),
      bumpMultiplier (dyadicGridLength G p.1 * (ξ - p.2)) ≤ M) :
    ∑ I ∈ S, dyadicGridLength G (cell I).1 *
      ‖separatedLocalForm (dyadicGridLength G (cell I).1) (w I)
        (fun t => (Real.fourierChar (γ I * t) : ℂ)) a b (fun y => ψa y * za (cell I) y)
        (fun y => ψb y * zb (cell I) y)‖ ≤
      linearScaleConst κ * M * Ka * Kb *
        Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2) *
        Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2) := by
  classical
  obtain ⟨Na, hNa⟩ : ∃ N : ℝ, N = Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2) :=
    ⟨_, rfl⟩
  obtain ⟨Nb, hNb⟩ : ∃ N : ℝ, N = Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2) :=
    ⟨_, rfl⟩
  rw [← hNa, ← hNb]
  have hNa0 : 0 ≤ Na := hNa ▸ Real.sqrt_nonneg _
  have hNb0 : 0 ≤ Nb := hNb ▸ Real.sqrt_nonneg _
  have hM0 : 0 ≤ M := (Finset.sum_nonneg fun p _ => bumpMultiplier_nonneg _).trans (hM 0)
  have hLn : ∀ v : Fin 2 → ℤ, 0 ≤ frequencyLength v := frequencyLength_nonneg
  obtain ⟨E, hE⟩ : ∃ E, E = kernelPointEnvelope κ 7 := ⟨_, rfl⟩
  obtain ⟨K, hK⟩ : ∃ K, K = (kernelPlateau κ).K := ⟨_, rfl⟩
  -- the rows
  obtain ⟨αA, hαA⟩ : ∃ f : (Fin 2 → ℤ) → ι → ℝ,
      f = fun v I => slotPairFreqA a b (dyadicGridLength G (cell I).1) v := ⟨_, rfl⟩
  obtain ⟨αB, hαB⟩ : ∃ f : (Fin 2 → ℤ) → ι → ℝ,
      f = fun v I => slotPairFreqB a b (dyadicGridLength G (cell I).1) v := ⟨_, rfl⟩
  obtain ⟨x, hx⟩ : ∃ f : (Fin 2 → ℤ) → ι → ℝ, f = fun v I =>
      ‖∫ y, conj (waveRowTest G κ cell (αA v) (fun I => -(γ I / ((b : ℝ) - (a : ℝ)))) ψa I y) *
        za (cell I) y‖ :=
    ⟨_, rfl⟩
  obtain ⟨yv, hyv⟩ : ∃ f : (Fin 2 → ℤ) → ι → ℝ, f = fun v I =>
      ‖∫ y, conj (waveRowTest G κ cell (αB v) (fun I => γ I / ((b : ℝ) - (a : ℝ))) ψb I y) *
        zb (cell I) y‖ :=
    ⟨_, rfl⟩
  have hx0 : ∀ v I, 0 ≤ x v I := fun v I => by rw [hx]; exact norm_nonneg _
  have hy0 : ∀ v I, 0 ≤ yv v I := fun v I => by rw [hyv]; exact norm_nonneg _
  have hAa : ∀ v, ∀ I ∈ S, 2 * (kernelPlateau κ).K *
      (1 + 6 * Real.pi * (dyadicGridLength G (cell I).1 * |αA v I|)) ^ 2 ≤
        charWaveConst κ (frequencyLength v) := fun v I _ => by
    rw [hαA]
    exact charWaveConst_ge κ (mul_nonneg (dyadicGridLength_pos G (cell I).1).le (abs_nonneg _))
      (slotPairFreqA_le hab (dyadicGridLength_pos G (cell I).1) v)
  have hAb : ∀ v, ∀ I ∈ S, 2 * (kernelPlateau κ).K *
      (1 + 6 * Real.pi * (dyadicGridLength G (cell I).1 * |αB v I|)) ^ 2 ≤
        charWaveConst κ (frequencyLength v) := fun v I _ => by
    rw [hαB]
    exact charWaveConst_ge κ (mul_nonneg (dyadicGridLength_pos G (cell I).1).le (abs_nonneg _))
      (slotPairFreqB_le hab (dyadicGridLength_pos G (cell I).1) v)
  have hMa := multiplicity_neg G cell S (fun I => γ I / ((b : ℝ) - (a : ℝ))) hM
  have hinjA : Set.InjOn (fun I => (cell I, -(γ I / ((b : ℝ) - (a : ℝ))))) S := by
    intro i hi j hj h
    simp only [Prod.mk.injEq, neg_inj] at h
    exact hinj hi hj (Prod.ext h.1 h.2)
  -- Bessel bound per character
  set! bd : (Fin 2 → ℤ) → ℝ := fun v =>
    charWaveConst κ (frequencyLength v) * 1 * Real.sqrt (2 * M) with hbd
  have hbd0 : ∀ v, 0 ≤ bd v := fun v => by
    have := two_le_charWaveConst κ (hLn v)
    simp only [hbd]; positivity
  have hxs : ∀ v, ∑ I ∈ S, x v I ^ 2 ≤ Ka ^ 2 * bd v ^ 2 * Na ^ 2 := by
    intro v
    have h := hza ι (waveRowFamily G κ cell S (αA v) (fun I => -(γ I / ((b : ℝ) - (a : ℝ))))
      hinjA hψam hψa
      (two_le_charWaveConst κ (hLn v)) (hAa v) hMa) hSJ
    rw [hNa, Real.sq_sqrt (setIntegral_nonneg (dyadicGridCell_measurable G J.1 J.2)
      fun _ _ => by positivity)]
    rw [hx]; exact h
  have hys : ∀ v, ∑ I ∈ S, yv v I ^ 2 ≤ Kb ^ 2 * bd v ^ 2 * Nb ^ 2 := by
    intro v
    have h := hzb ι (waveRowFamily G κ cell S (αB v) (fun I => γ I / ((b : ℝ) - (a : ℝ))) hinj
      hψbm hψb
      (two_le_charWaveConst κ (hLn v)) (hAb v) hM) hSJ
    rw [hNb, Real.sq_sqrt (setIntegral_nonneg (dyadicGridCell_measurable G J.1 J.2)
      fun _ _ => by positivity)]
    rw [hyv]; exact h
  have hsqrt : ∀ {K' t N : ℝ}, 0 ≤ K' → 0 ≤ t → 0 ≤ N →
      Real.sqrt (K' ^ 2 * t ^ 2 * N ^ 2) = K' * t * N := by
    intro K' t N h1 h2 h3
    rw [show K' ^ 2 * t ^ 2 * N ^ 2 = (K' * t * N) ^ 2 by ring]
    exact Real.sqrt_sq (by positivity)
  have hcs : ∀ v, ∑ I ∈ S, x v I * yv v I ≤ Ka * Kb * bd v ^ 2 * Na * Nb := by
    intro v
    refine (Real.sum_mul_le_sqrt_mul_sqrt S (x v) (yv v)).trans ?_
    calc Real.sqrt (∑ I ∈ S, x v I ^ 2) * Real.sqrt (∑ I ∈ S, yv v I ^ 2)
        ≤ Real.sqrt (Ka ^ 2 * bd v ^ 2 * Na ^ 2) * Real.sqrt (Kb ^ 2 * bd v ^ 2 * Nb ^ 2) :=
          mul_le_mul (Real.sqrt_le_sqrt (hxs v)) (Real.sqrt_le_sqrt (hys v))
            (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
      _ = Ka * Kb * bd v ^ 2 * Na * Nb := by
          rw [hsqrt hKa (hbd0 v) hNa0, hsqrt hKb (hbd0 v) hNb0]; ring
  -- the majorant
  set! U : (Fin 2 → ℤ) → ℝ := fun v =>
    E * ((1 + frequencyLength v) ^ 7)⁻¹ * (Ka * Kb * bd v ^ 2 * Na * Nb) with hU
  set! C0 := E * ((2 + 2 * K) * 25) ^ 2 * 2 * M * Ka * Kb * Na * Nb with hC0
  have hUe : ∀ v, U v = C0 * ((1 + frequencyLength v) ^ 3)⁻¹ := by
    intro v
    have h1 : 0 < 1 + frequencyLength v := by linarith [hLn v]
    simp only [hU, hbd, hC0, charWaveConst, ← hK]
    rw [mul_pow, mul_pow, Real.sq_sqrt (by positivity)]
    field_simp
  have hUs : Summable U := by
    have := summable_frequency_weight_three.mul_left C0
    exact this.congr fun v => (hUe v).symm
  have hE0 : 0 ≤ E := by
    rw [hE]
    refine le_max_of_le_left ?_
    unfold kernelUnitEnvelope; have := kernelDerivBound_nonneg κ 0; positivity
  have hfs : ∀ I ∈ S, Summable (fun v =>
      E * ((1 + frequencyLength v) ^ 7)⁻¹ * (x v I * yv v I)) := by
    intro I hI
    refine Summable.of_nonneg_of_le
      (fun v => by have := hx0 v I; have := hy0 v I; have := hLn v; positivity)
      (fun v => ?_) hUs
    have h1 : x v I * yv v I ≤ ∑ K' ∈ S, x v K' * yv v K' :=
      Finset.single_le_sum (f := fun K' => x v K' * yv v K')
        (fun K' _ => mul_nonneg (hx0 v K') (hy0 v K')) hI
    exact mul_le_mul_of_nonneg_left (h1.trans (hcs v)) (by have := hLn v; positivity)
  have hd1 : |((b : ℝ) - (a : ℝ))⁻¹| ≤ 1 := by
    rw [abs_inv]; exact inv_le_one_of_one_le₀ (one_le_abs_fin_sub hab)
  have hcell : ∀ I ∈ S, dyadicGridLength G (cell I).1 * ‖separatedLocalForm (dyadicGridLength G
      (cell I).1)
      (w I) (fun t => (Real.fourierChar (γ I * t) : ℂ)) a b (fun y => ψa y * za (cell I) y)
        (fun y => ψb y * zb (cell I) y)‖ ≤
      ∑' v, E * ((1 + frequencyLength v) ^ 7)⁻¹ * (x v I * yv v I) := by
    intro I hI
    have hr := dyadicGridLength_pos G (cell I).1
    have hwI := hw I hI
    rw [separatedLocalForm_indicator hr hwI]
    have hGa := integrable_cell_mul (dyadicGridCell_measurable G (cell I).1 (cell I).2)
      hψam hψa (hzam (cell I)) (hzai I hI)
    have hGb := integrable_cell_mul (dyadicGridCell_measurable G (cell I).1 (cell I).2)
      hψbm hψb (hzbm (cell I)) (hzbi I hI)
    have hGam := (hψam.mul (hzam (cell I))).indicator
      (dyadicGridCell_measurable G (cell I).1 (cell I).2)
    have hGbm := (hψbm.mul (hzbm (cell I))).indicator
      (dyadicGridCell_measurable G (cell I).1 (cell I).2)
    obtain ⟨hs, hb⟩ := separated_linear_cell_tensor hr hwI hab (γ I) hGam hGbm hGa hGb
    refine hb.trans ?_
    rw [← tsum_mul_left]
    refine Summable.tsum_le_tsum (fun v => ?_) (hs.mul_left _) (hfs I hI)
    have hXr : Real.sqrt (dyadicGridLength G (cell I).1)⁻¹ * ‖∫ y, classWave κ (dyadicGridLeft G
        (cell I).1 (cell I).2)
        (dyadicGridLength G (cell I).1) (slotPairFreqA a b (dyadicGridLength G (cell I).1) v) y *
        (Real.fourierChar ((-(γ I / ((b : ℝ) - (a : ℝ)))) * y) : ℂ) *
        (dyadicGridCell G (cell I).1 (cell I).2).indicator (ψa * za (cell I)) y‖ = x v I := by
      rw [show dyadicGridCell G (cell I).1 (cell I).2 = Set.Ico (dyadicGridLeft G (cell I).1 (cell
          I).2)
        (dyadicGridLeft G (cell I).1 (cell I).2 + dyadicGridLength G (cell I).1) from rfl,
        integral_classWave_indicator κ hr]
      simp only [hx, hαA, Pi.mul_apply]
      rw [integral_conj_waveRowTest, norm_mul, Complex.norm_real,
        Real.norm_of_nonneg (Real.sqrt_nonneg _)]
      congr 3; funext y; ring
    have hYr : Real.sqrt (dyadicGridLength G (cell I).1)⁻¹ * ‖∫ y, classWave κ (dyadicGridLeft G
        (cell I).1 (cell I).2)
        (dyadicGridLength G (cell I).1) (slotPairFreqB a b (dyadicGridLength G (cell I).1) v) y *
        (Real.fourierChar ((γ I / ((b : ℝ) - (a : ℝ))) * y) : ℂ) *
        (dyadicGridCell G (cell I).1 (cell I).2).indicator (ψb * zb (cell I)) y‖ = yv v I := by
      rw [show dyadicGridCell G (cell I).1 (cell I).2 = Set.Ico (dyadicGridLeft G (cell I).1 (cell
          I).2)
        (dyadicGridLeft G (cell I).1 (cell I).2 + dyadicGridLength G (cell I).1) from rfl,
        integral_classWave_indicator κ hr]
      simp only [hyv, hαB, Pi.mul_apply]
      rw [integral_conj_waveRowTest, norm_mul, Complex.norm_real,
        Real.norm_of_nonneg (Real.sqrt_nonneg _)]
      congr 3; funext y; ring
    simp only at hXr hYr ⊢
    rw [hXr, hYr]
    have hc := admissibleKernel_coeff_envelope hr hwI 7 v
    have hpos : 0 < (1 + frequencyLength v) ^ 7 := by have := hLn v; positivity
    have hc' : ‖periodicFourierCoeff (cubePeriodization (kernelUnitRescale
        (dyadicGridLeft G (cell I).1 (cell I).2) (dyadicGridLength G (cell I).1) (w I)) 16) v‖ ≤
        E * ((1 + frequencyLength v) ^ 7)⁻¹ := by
      rw [hE, ← div_eq_mul_inv, le_div_iff₀ hpos]; exact hc
    have hxy := mul_nonneg (hx0 v I) (hy0 v I)
    calc |((b : ℝ) - (a : ℝ))⁻¹| * (‖periodicFourierCoeff (cubePeriodization (kernelUnitRescale
          (dyadicGridLeft G (cell I).1 (cell I).2) (dyadicGridLength G (cell I).1) (w I)) 16) v‖ *
              x v I * yv v I)
        ≤ 1 * (‖periodicFourierCoeff (cubePeriodization (kernelUnitRescale
          (dyadicGridLeft G (cell I).1 (cell I).2) (dyadicGridLength G (cell I).1) (w I)) 16) v‖ *
              x v I * yv v I) :=
          mul_le_mul_of_nonneg_right hd1 (by rw [mul_assoc]; positivity)
      _ ≤ E * ((1 + frequencyLength v) ^ 7)⁻¹ * (x v I * yv v I) := by
          rw [one_mul, mul_assoc]; exact mul_le_mul_of_nonneg_right hc' hxy
  calc ∑ I ∈ S, dyadicGridLength G (cell I).1 * ‖separatedLocalForm (dyadicGridLength G (cell
      I).1) (w I)
        (fun t => (Real.fourierChar (γ I * t) : ℂ)) a b (fun y => ψa y * za (cell I) y)
        (fun y => ψb y * zb (cell I) y)‖
      ≤ ∑ I ∈ S, ∑' v, E * ((1 + frequencyLength v) ^ 7)⁻¹ * (x v I * yv v I) :=
        Finset.sum_le_sum hcell
    _ = ∑' v, ∑ I ∈ S, E * ((1 + frequencyLength v) ^ 7)⁻¹ * (x v I * yv v I) :=
        (Summable.tsum_finsetSum hfs).symm
    _ ≤ ∑' v, U v := by
        refine Summable.tsum_le_tsum (fun v => ?_) (summable_sum hfs) hUs
        rw [← Finset.mul_sum]
        exact mul_le_mul_of_nonneg_left (hcs v) (by have := hLn v; positivity)
    _ = C0 * ∑' v : Fin 2 → ℤ, ((1 + frequencyLength v) ^ 3)⁻¹ := by
        rw [tsum_congr hUe, tsum_mul_left]
    _ = linearScaleConst κ * M * Ka * Kb * Na * Nb := by
        simp only [hC0, linearScaleConst, hE, hK]; ring

/-- A `1`-separated finite set of real numbers in `[-β, β]` has at most `2β + 2` points. -/
theorem card_le_of_one_separated {ι : Type*} (s : Finset ι) (t : ι → ℝ) {β : ℝ} (hβ : 0 ≤ β)
    (hs : ∀ i ∈ s, |t i| ≤ β)
    (hsep : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → 1 ≤ |t i - t j|) :
    (s.card : ℝ) ≤ 2 * β + 2 := by
  classical
  have hmaps : ∀ i ∈ s, ⌊t i⌋ ∈ Finset.Icc ⌊-β⌋ ⌊β⌋ := by
    intro i hi
    have h := abs_le.mp (hs i hi)
    exact Finset.mem_Icc.mpr ⟨Int.floor_mono h.1, Int.floor_mono h.2⟩
  have hinj : Set.InjOn (fun i => ⌊t i⌋) s := by
    intro i hi j hj hij
    by_contra hne
    have h1 := hsep i hi j hj hne
    have h2 := Int.abs_sub_lt_one_of_floor_eq_floor hij
    linarith
  have hcard := Finset.card_le_card_of_injOn (fun i => ⌊t i⌋) hmaps hinj
  rw [Int.card_Icc] at hcard
  have hnn : 0 ≤ ⌊β⌋ + 1 - ⌊-β⌋ := by
    have := Int.floor_mono (show -β ≤ β by linarith)
    omega
  have hcast : (((⌊β⌋ + 1 - ⌊-β⌋).toNat : ℕ) : ℝ) = (⌊β⌋ : ℝ) + 1 - (⌊-β⌋ : ℝ) := by
    rw [show (((⌊β⌋ + 1 - ⌊-β⌋).toNat : ℕ) : ℝ) = (((⌊β⌋ + 1 - ⌊-β⌋).toNat : ℤ) : ℝ) by
      push_cast; rfl, Int.toNat_of_nonneg hnn]
    push_cast; ring
  have h1 : (s.card : ℝ) ≤ (⌊β⌋ : ℝ) + 1 - (⌊-β⌋ : ℝ) := by
    rw [← hcast]; exact_mod_cast hcard
  have h2 := Int.floor_le β
  have h3 := Int.lt_floor_add_one (-β)
  linarith

/-- The scale-count constant of `lem:height` for one dyadic band of an extended parameter
vector of dimension `d + 1`. -/
noncomputable def heightBandConst (d : ℕ) (B : ℝ) : ℝ :=
  32 * ((d + 1 : ℕ) + 1 : ℝ) ^ 4 * (Real.log (2 * B) + Real.log 4)

/-- Blueprint lem:predictors, proof lines 1539–1541: frequency multiplicity of
bounded-height rational centers. If every center `ν` at scale `s` is a rational evaluation
`a · χ` of height at most `B` of a fixed vector and the centers at one scale are
`1/|I|`-separated, then for every `ξ` the bump weights sum to at most a constant times the
`lem:height` band count. -/
theorem rational_center_multiplicity {d : ℕ} (G : RealDyadicGrid) (χ : Fin d → ℝ) {B : ℝ}
    (hB : 2 ≤ B) (T : Finset (ℤ × ℝ))
    (hrat : ∀ p ∈ T, ∃ a : Fin d → ℚ, (∀ j, (rationalHeight (a j) : ℝ) ≤ B) ∧
      p.2 = ∑ j, (a j : ℝ) * χ j)
    (hsep : ∀ p ∈ T, ∀ q ∈ T, p.1 = q.1 → p ≠ q →
      1 ≤ dyadicGridLength G p.1 * |p.2 - q.2|) (ξ : ℝ) :
    ∑ p ∈ T, bumpMultiplier (dyadicGridLength G p.1 * (ξ - p.2)) ≤
      24 * (2 * Real.pi) ^ 2 * (4 * heightBandConst d B) := by
  classical
  have hlog1 := height_log_one_le hB
  have hC0 : 0 ≤ heightBandConst d B := by
    unfold heightBandConst
    have : 0 ≤ Real.log 4 := Real.log_nonneg (by norm_num)
    positivity
  refine sum_bumpMultiplier_le T _ (by positivity) fun ℓ => ?_
  set F := T.filter (fun p => (2 : ℝ) ^ ℓ ≤ |dyadicGridLength G p.1 * (ξ - p.2)| ∧
    |dyadicGridLength G p.1 * (ξ - p.2)| < (2 : ℝ) ^ (ℓ + 1)) with hF
  have h2l : (0 : ℝ) < (2 : ℝ) ^ ℓ := zpow_pos (by norm_num) ℓ
  have h2l1 : (2 : ℝ) ^ (ℓ + 1) = 2 * (2 : ℝ) ^ ℓ := by
    rw [zpow_add₀ (by norm_num), zpow_one]; ring
  -- the extended parameter vector
  obtain ⟨Ns, hNs, hNcard⟩ := rational_frequency_scale_count (d := d + 1) (u := 1) hB le_rfl
    h2l (show (2 : ℝ) ^ ℓ ≤ (2 : ℝ) ^ (ℓ + 1) by rw [h2l1]; linarith)
    (Fin.cons ξ χ) G.baseLength
  have hsub : F.image Prod.fst ⊆ Ns := by
    intro s hs
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hs
    obtain ⟨hpT, hlo, hhi⟩ := Finset.mem_filter.mp hp
    obtain ⟨a, ha, hpa⟩ := hrat p hpT
    refine (hNs p.1).mpr ⟨Fin.cons 1 (fun j => -a j), fun j => ?_, ?_, ?_⟩
    · refine Fin.cases ?_ (fun j => ?_) j
      · simp only [Fin.cons_zero]
        have : rationalHeight (1 : ℚ) = 1 := by decide
        rw [this]; push_cast; linarith
      · simp only [Fin.cons_succ, rationalHeight_neg]; exact ha j
    all_goals
      have hev : ∑ j, ((Fin.cons 1 (fun j => -a j) : Fin (d + 1) → ℚ) j : ℝ) *
          (Fin.cons ξ χ : Fin (d + 1) → ℝ) j = ξ - p.2 := by
        rw [Fin.sum_univ_succ, hpa]
        simp only [Fin.cons_zero, Fin.cons_succ, Rat.cast_one, one_mul, Rat.cast_neg,
          neg_mul, Finset.sum_neg_distrib]
        ring
      have hlen : dyadicGridLength G p.1 = G.baseLength * (2 : ℝ) ^ (-p.1) := rfl
      rw [hev, pow_one, ← hlen]
    · rw [abs_mul, abs_of_pos (dyadicGridLength_pos G p.1)] at hlo; exact hlo
    · rw [abs_mul, abs_of_pos (dyadicGridLength_pos G p.1)] at hhi; exact hhi.le
  -- fibers over one scale
  have hfib : ∀ s ∈ F.image Prod.fst, ((F.filter (fun p => p.1 = s)).card : ℝ) ≤
      4 * (1 + (2 : ℝ) ^ ℓ) := by
    intro s _
    have h := card_le_of_one_separated (F.filter (fun p => p.1 = s))
      (fun p => dyadicGridLength G p.1 * (ξ - p.2)) (β := (2 : ℝ) ^ (ℓ + 1)) (by positivity)
      (fun p hp => ((Finset.mem_filter.mp (Finset.mem_filter.mp hp).1).2).2.le)
      (fun p hp q hq hpq => by
        have hpT := (Finset.mem_filter.mp (Finset.mem_filter.mp hp).1).1
        have hqT := (Finset.mem_filter.mp (Finset.mem_filter.mp hq).1).1
        have hs : p.1 = q.1 := by
          rw [(Finset.mem_filter.mp hp).2, (Finset.mem_filter.mp hq).2]
        have := hsep p hpT q hqT hs hpq
        rw [← hs, ← mul_sub, abs_mul, abs_of_pos (dyadicGridLength_pos G p.1),
          show ξ - p.2 - (ξ - q.2) = -(p.2 - q.2) by ring, abs_neg]
        exact this)
    rw [h2l1] at h
    linarith
  have hcard : (F.card : ℝ) ≤ (F.image Prod.fst).card * (4 * (1 + (2 : ℝ) ^ ℓ)) := by
    rw [Finset.card_eq_sum_card_fiberwise (f := Prod.fst) (t := F.image Prod.fst)
      (fun p hp => Finset.mem_image_of_mem _ hp)]
    push_cast
    exact (Finset.sum_le_sum hfib).trans (by rw [Finset.sum_const, nsmul_eq_mul])
  have hNs' : ((F.image Prod.fst).card : ℝ) ≤ heightBandConst d B := by
    refine (Nat.cast_le.mpr (Finset.card_le_card hsub)).trans (hNcard.trans (le_of_eq ?_))
    unfold heightBandConst
    rw [show 2 * (2 : ℝ) ^ (ℓ + 1) / (2 : ℝ) ^ ℓ = 4 by rw [h2l1]; field_simp; norm_num]
  calc (F.card : ℝ) ≤ (F.image Prod.fst).card * (4 * (1 + (2 : ℝ) ^ ℓ)) := hcard
    _ ≤ heightBandConst d B * (4 * (1 + (2 : ℝ) ^ ℓ)) :=
        mul_le_mul_of_nonneg_right hNs' (by positivity)
    _ = 4 * heightBandConst d B * (1 + (2 : ℝ) ^ ℓ) := by ring

/-- Cauchy–Schwarz on a set of finite measure: `∫_s |f| ≤ |s|^{1/2} (∫_s |f|²)^{1/2}`. -/
theorem setIntegral_norm_le_sqrt {s : Set ℝ} (hsv : volume s < ⊤) {f : ℝ → ℂ}
    (hf : MemLp f 2 (volume.restrict s)) :
    ∫ y in s, ‖f y‖ ≤ Real.sqrt (volume.real s) * Real.sqrt (∫ y in s, ‖f y‖ ^ 2) := by
  have : IsFiniteMeasure (volume.restrict s) := by
    constructor; rw [Measure.restrict_apply_univ]; exact hsv
  have h2 : ENNReal.ofReal 2 = 2 := by norm_num
  have hf' : MemLp (fun y => ‖f y‖) (ENNReal.ofReal 2) (volume.restrict s) := by
    rw [h2]; exact hf.norm
  have h1 : MemLp (fun _ : ℝ => (1 : ℝ)) (ENNReal.ofReal 2) (volume.restrict s) :=
    memLp_const 1
  have h := integral_mul_le_Lp_mul_Lq_of_nonneg (μ := volume.restrict s)
    Real.HolderConjugate.two_two (Filter.Eventually.of_forall fun y => norm_nonneg (f y))
    (Filter.Eventually.of_forall fun _ => zero_le_one) hf' h1
  simp only [mul_one, Real.one_rpow, integral_const, smul_eq_mul] at h
  rw [Measure.real, Measure.restrict_apply_univ] at h
  rw [Real.sqrt_eq_rpow, Real.sqrt_eq_rpow, mul_comm]
  have e : ∀ y, ‖f y‖ ^ (2 : ℝ) = ‖f y‖ ^ 2 := fun y => by
    rw [← Real.rpow_natCast]; norm_num
  simp only [e] at h
  convert h using 2
  · simp [Measure.real]

/-- The cell of an admissible kernel bounds the time variable: `|t| ≤ r` on its support. -/
theorem admissibleKernel_time_le {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {z : ℝ × ℝ} (hz : w z ≠ 0) :
    |z.2| ≤ r := by
  have h0 := hw.support z hz 0
  have h1 := hw.support z hz 1
  have hm := κ.margin_pos
  have e0 : realProgressionCoordinate 0 z = z.1 := by
    simp [realProgressionCoordinate]
  have e1 : realProgressionCoordinate 1 z = z.1 + z.2 := by
    simp [realProgressionCoordinate]
  rw [e0] at h0
  rw [e1] at h1
  have hmr : 0 ≤ κ.margin * r := by positivity
  rw [abs_le]; constructor <;> linarith [h0.1, h0.2, h1.1, h1.2]

/-- Blueprint lem:predictors, proof lines 1521–1523: an elementary bound for the separated
form with a time modifier bounded by `η` on the allowed range, by the kernel supremum and
the normalized `L²` norms of the two inputs on the cell. -/
theorem separatedLocalForm_sup_le {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a b : Fin 4} (hab : a ≠ b)
    {K : ℝ → ℂ} {η : ℝ} (hη : 0 ≤ η) (hK : ∀ t, |t| ≤ r → ‖K t‖ ≤ η)
    {Fa Fb : ℝ → ℂ} (hFam : Measurable Fa) (hFbm : Measurable Fb)
    (hFa : MemLp Fa 2 (volume.restrict (Set.Ico a₀ (a₀ + r))))
    (hFb : MemLp Fb 2 (volume.restrict (Set.Ico a₀ (a₀ + r)))) :
    ‖separatedLocalForm r w K a b Fa Fb‖ ≤ localKernelSupBound κ * η *
      Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖Fa y‖ ^ 2) *
      Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖Fb y‖ ^ 2) := by
  set s := Set.Ico a₀ (a₀ + r) with hs
  have hsm : MeasurableSet s := measurableSet_Ico
  have hsv : volume s < ⊤ := measure_Ico_lt_top
  have hvol : volume.real s = r := by
    rw [hs, Measure.real, Real.volume_Ico, ENNReal.toReal_ofReal (by linarith)]; ring
  rw [separatedLocalForm_indicator hr hw]
  set Ga := s.indicator Fa
  set Gb := s.indicator Fb
  have hGam : Measurable Ga := hFam.indicator hsm
  have hGbm : Measurable Gb := hFbm.indicator hsm
  have hGa : Integrable Ga := (integrable_indicator_iff hsm).mpr
    (hFa.integrable (by norm_num))
  have hGb : Integrable Gb := (integrable_indicator_iff hsm).mpr
    (hFb.integrable (by norm_num))
  have hd := fin_cast_sub_ne hab
  have hab' : (a : ℝ) ≠ (b : ℝ) := fun h => hd (by rw [h, sub_self])
  obtain ⟨hΦi, hΦ⟩ := real_progression_pair_integral_norm hGam hGbm hGa hGb hab'
  have hC := localKernelSupBound_nonneg κ
  have hpt : ∀ z : ℝ × ℝ, ‖w z * K z.2 * Ga (realProgressionCoordinate a z) *
      Gb (realProgressionCoordinate b z)‖ ≤ localKernelSupBound κ * η *
        (‖Ga (z.1 + (a : ℝ) * z.2)‖ * ‖Gb (z.1 + (b : ℝ) * z.2)‖) := by
    intro z
    by_cases hz : w z = 0
    · rw [hz]; simp only [zero_mul, norm_zero]; positivity
    have ht := admissibleKernel_time_le hr hw hz
    simp only [norm_mul, realProgressionCoordinate]
    have h1 := admissibleLocalKernel_norm_le hw z
    have h2 := hK z.2 ht
    calc ‖w z‖ * ‖K z.2‖ * ‖Ga (z.1 + (a : ℝ) * z.2)‖ * ‖Gb (z.1 + (b : ℝ) * z.2)‖
        = (‖w z‖ * ‖K z.2‖) * (‖Ga (z.1 + (a : ℝ) * z.2)‖ * ‖Gb (z.1 + (b : ℝ) * z.2)‖) := by
          ring
      _ ≤ (localKernelSupBound κ * η) *
          (‖Ga (z.1 + (a : ℝ) * z.2)‖ * ‖Gb (z.1 + (b : ℝ) * z.2)‖) :=
          mul_le_mul_of_nonneg_right (mul_le_mul h1 h2 (norm_nonneg _) hC) (by positivity)
  have hint : ‖∫ z : ℝ × ℝ, w z * K z.2 * Ga (realProgressionCoordinate a z) *
      Gb (realProgressionCoordinate b z)‖ ≤ localKernelSupBound κ * η *
        (|((b : ℝ) - (a : ℝ))⁻¹| * (∫ u, ‖Ga u‖) * ∫ v, ‖Gb v‖) := by
    rw [← hΦ, ← integral_const_mul]
    refine norm_integral_le_of_norm_le (hΦi.const_mul _) (Filter.Eventually.of_forall hpt)
  have hL1 : ∀ {F : ℝ → ℂ}, MemLp F 2 (volume.restrict s) →
      ∫ u, ‖s.indicator F u‖ ≤ Real.sqrt r * Real.sqrt (∫ y in s, ‖F y‖ ^ 2) := by
    intro F hF
    have e : ∫ u, ‖s.indicator F u‖ = ∫ y in s, ‖F y‖ := by
      rw [← integral_indicator hsm]
      congr 1; funext y
      by_cases hy : y ∈ s
      · simp [Set.indicator_of_mem hy]
      · simp [Set.indicator_of_notMem hy]
    rw [e, ← hvol]
    exact setIntegral_norm_le_sqrt hsv hF
  have hd1 : |((b : ℝ) - (a : ℝ))⁻¹| ≤ 1 := by
    rw [abs_inv]; exact inv_le_one_of_one_le₀ (one_le_abs_fin_sub hab)
  have hA := hL1 hFa
  have hB := hL1 hFb
  have hIa : 0 ≤ ∫ u, ‖Ga u‖ := integral_nonneg fun _ => norm_nonneg _
  have hIb : 0 ≤ ∫ u, ‖Gb u‖ := integral_nonneg fun _ => norm_nonneg _
  unfold separatedLocalForm
  rw [norm_mul, norm_pow, norm_inv, Complex.norm_real, Real.norm_of_nonneg hr.le]
  have hsq : ∀ X : ℝ, 0 ≤ X → Real.sqrt (r⁻¹ * X) = (Real.sqrt r)⁻¹ * Real.sqrt X := by
    intro X _
    rw [Real.sqrt_mul (inv_nonneg.mpr hr.le), Real.sqrt_inv]
  have hXa : 0 ≤ ∫ y in s, ‖Fa y‖ ^ 2 := setIntegral_nonneg hsm fun _ _ => by positivity
  have hXb : 0 ≤ ∫ y in s, ‖Fb y‖ ^ 2 := setIntegral_nonneg hsm fun _ _ => by positivity
  rw [hsq _ hXa, hsq _ hXb]
  have hsr : 0 < Real.sqrt r := Real.sqrt_pos.mpr hr
  have hrr : Real.sqrt r ^ 2 = r := Real.sq_sqrt hr.le
  calc r⁻¹ ^ 2 * ‖∫ z : ℝ × ℝ, w z * K z.2 * Ga (realProgressionCoordinate a z) *
        Gb (realProgressionCoordinate b z)‖
      ≤ r⁻¹ ^ 2 * (localKernelSupBound κ * η *
        (|((b : ℝ) - (a : ℝ))⁻¹| * (∫ u, ‖Ga u‖) * ∫ v, ‖Gb v‖)) :=
        mul_le_mul_of_nonneg_left hint (by positivity)
    _ ≤ r⁻¹ ^ 2 * (localKernelSupBound κ * η *
        (1 * (Real.sqrt r * Real.sqrt (∫ y in s, ‖Fa y‖ ^ 2)) *
          (Real.sqrt r * Real.sqrt (∫ y in s, ‖Fb y‖ ^ 2)))) := by
        gcongr
    _ = localKernelSupBound κ * η * ((Real.sqrt r)⁻¹ * Real.sqrt (∫ y in s, ‖Fa y‖ ^ 2)) *
        ((Real.sqrt r)⁻¹ * Real.sqrt (∫ y in s, ‖Fb y‖ ^ 2)) := by
        set q := Real.sqrt r
        rw [← hrr]
        field_simp

/-- Blueprint sec:base, lines 1482–1485, the depth form of admissibility: on every family of
cells of one depth inside `J` the opponent has square energy at most `K² ‖1_J F‖²`
(contraction for fixed inputs and projections, the assumed energy for square-energy
sequences). -/
def HasDepthEnergy (G : RealDyadicGrid) (J : ℤ × ℤ) (F : ℝ → ℂ) (z : ℤ × ℤ → ℝ → ℂ)
    (K : ℝ) : Prop :=
  ∀ (s : ℤ) (S : Finset (ℤ × ℤ)), (∀ I ∈ S, I.1 = s ∧
      dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2) →
    ∑ I ∈ S, ∫ y in dyadicGridCell G I.1 I.2, ‖z I y‖ ^ 2 ≤
      K ^ 2 * ∫ y in dyadicGridCell G J.1 J.2, ‖F y‖ ^ 2

/-- A fixed input has depth energy with constant one, cells of one depth being disjoint. -/
theorem hasDepthEnergy_fixed (G : RealDyadicGrid) (J : ℤ × ℤ) {F : ℝ → ℂ}
    (hF : IntegrableOn (fun y => ‖F y‖ ^ 2) (dyadicGridCell G J.1 J.2)) :
    HasDepthEnergy G J F (fun _ => F) 1 := by
  classical
  intro s S hS
  rw [one_pow, one_mul]
  have hdisj : (S : Set (ℤ × ℤ)).PairwiseDisjoint (fun I => dyadicGridCell G I.1 I.2) := by
    intro I hI I' hI' hne
    have h1 : I.1 = I'.1 := by rw [(hS I hI).1, (hS I' hI').1]
    have h2 : I.2 ≠ I'.2 := fun h => hne (Prod.ext h1 h)
    have := dyadicGridCell_pairwiseDisjoint G I.1 h2
    simpa [Function.onFun, h1] using this
  rw [← integral_biUnion_finset S (fun I _ => dyadicGridCell_measurable G I.1 I.2) hdisj
    (fun I hI => hF.mono_set (hS I hI).2)]
  exact setIntegral_mono_set hF (Filter.Eventually.of_forall fun _ => by positivity)
    (Filter.Eventually.of_forall (Set.iUnion₂_subset fun I hI => (hS I hI).2))

/-- Blueprint lem:predictors, proof line 1523 ("at each depth use contractions and
Cauchy–Schwarz"): a depth-weighted sum of products of cell energies is bounded by the total
depth weight times the opponent constants and input norms. -/
theorem depth_weighted_energy_sum (G : RealDyadicGrid) (J : ℤ × ℤ) (S : Finset (ℤ × ℤ))
    (hSJ : ∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2) (c : ℤ → ℝ)
    (hc : ∀ s, 0 ≤ c s) {Fa Fb : ℝ → ℂ} {za zb : ℤ × ℤ → ℝ → ℂ} {Ka Kb : ℝ}
    (hKa : 0 ≤ Ka) (hKb : 0 ≤ Kb) (hEa : HasDepthEnergy G J Fa za Ka)
    (hEb : HasDepthEnergy G J Fb zb Kb) :
    ∑ I ∈ S, c I.1 * (Real.sqrt (∫ y in dyadicGridCell G I.1 I.2, ‖za I y‖ ^ 2) *
      Real.sqrt (∫ y in dyadicGridCell G I.1 I.2, ‖zb I y‖ ^ 2)) ≤
      (∑ s ∈ S.image Prod.fst, c s) * Ka * Kb *
        Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2) *
        Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2) := by
  classical
  set Na := Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2)
  set Nb := Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2)
  set A : ℤ × ℤ → ℝ := fun I => ∫ y in dyadicGridCell G I.1 I.2, ‖za I y‖ ^ 2
  set B : ℤ × ℤ → ℝ := fun I => ∫ y in dyadicGridCell G I.1 I.2, ‖zb I y‖ ^ 2
  have hA0 : ∀ I, 0 ≤ A I := fun I =>
    setIntegral_nonneg (dyadicGridCell_measurable G I.1 I.2) fun _ _ => by positivity
  have hB0 : ∀ I, 0 ≤ B I := fun I =>
    setIntegral_nonneg (dyadicGridCell_measurable G I.1 I.2) fun _ _ => by positivity
  have hJa : 0 ≤ ∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2 :=
    setIntegral_nonneg (dyadicGridCell_measurable G J.1 J.2) fun _ _ => by positivity
  have hJb : 0 ≤ ∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2 :=
    setIntegral_nonneg (dyadicGridCell_measurable G J.1 J.2) fun _ _ => by positivity
  have hfib : ∀ s ∈ S.image Prod.fst, ∑ I ∈ S.filter (fun I => I.1 = s),
      Real.sqrt (A I) * Real.sqrt (B I) ≤ Ka * Kb * Na * Nb := by
    intro s _
    have hS' : ∀ I ∈ S.filter (fun I => I.1 = s), I.1 = s ∧
        dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2 := fun I hI =>
      ⟨(Finset.mem_filter.mp hI).2, hSJ I (Finset.mem_filter.mp hI).1⟩
    have ha := hEa s _ hS'
    have hb := hEb s _ hS'
    refine (Real.sum_mul_le_sqrt_mul_sqrt _ _ _).trans ?_
    simp only [Real.sq_sqrt (hA0 _), Real.sq_sqrt (hB0 _)]
    calc Real.sqrt (∑ I ∈ S.filter (fun I => I.1 = s), A I) *
          Real.sqrt (∑ I ∈ S.filter (fun I => I.1 = s), B I)
        ≤ Real.sqrt (Ka ^ 2 * ∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2) *
          Real.sqrt (Kb ^ 2 * ∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2) :=
          mul_le_mul (Real.sqrt_le_sqrt ha) (Real.sqrt_le_sqrt hb) (Real.sqrt_nonneg _)
            (Real.sqrt_nonneg _)
      _ = Ka * Kb * Na * Nb := by
          rw [Real.sqrt_mul (sq_nonneg _), Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq hKa,
            Real.sqrt_sq hKb]; ring
  calc ∑ I ∈ S, c I.1 * (Real.sqrt (A I) * Real.sqrt (B I))
      = ∑ s ∈ S.image Prod.fst, ∑ I ∈ S.filter (fun I => I.1 = s),
          c I.1 * (Real.sqrt (A I) * Real.sqrt (B I)) :=
        (Finset.sum_fiberwise_of_maps_to (fun I hI => Finset.mem_image_of_mem _ hI) _).symm
    _ = ∑ s ∈ S.image Prod.fst, c s * ∑ I ∈ S.filter (fun I => I.1 = s),
          Real.sqrt (A I) * Real.sqrt (B I) := by
        refine Finset.sum_congr rfl fun s _ => ?_
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun I hI => ?_
        rw [(Finset.mem_filter.mp hI).2]
    _ ≤ ∑ s ∈ S.image Prod.fst, c s * (Ka * Kb * Na * Nb) :=
        Finset.sum_le_sum fun s hs => mul_le_mul_of_nonneg_left (hfib s hs) (hc s)
    _ = (∑ s ∈ S.image Prod.fst, c s) * Ka * Kb * Na * Nb := by
        rw [← Finset.sum_mul]; ring

/-- The cell-normalized product of two `L²` norms at the cell length. -/
theorem cell_normalized_product {r X Y : ℝ} (hr : 0 < r) :
    r * (Real.sqrt (r⁻¹ * X) * Real.sqrt (r⁻¹ * Y)) = Real.sqrt X * Real.sqrt Y := by
  rw [Real.sqrt_mul (inv_nonneg.mpr hr.le), Real.sqrt_mul (inv_nonneg.mpr hr.le),
    Real.sqrt_inv]
  have hs : 0 < Real.sqrt r := Real.sqrt_pos.mpr hr
  have hrr : Real.sqrt r ^ 2 = r := Real.sq_sqrt hr.le
  set q := Real.sqrt r
  rw [← hrr]
  field_simp

/-- The separated form is additive in the time factor for bounded measurable factors and
cell-local `L²` inputs. -/
theorem separatedLocalForm_add {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a b : Fin 4} (hab : a ≠ b)
    {Q₁ Q₂ : ℝ → ℂ} (hQ₁ : Measurable Q₁) (hQ₂ : Measurable Q₂) {C : ℝ}
    (hQ₁b : ∀ t, ‖Q₁ t‖ ≤ C) (hQ₂b : ∀ t, ‖Q₂ t‖ ≤ C)
    {Fa Fb : ℝ → ℂ} (hFam : Measurable Fa) (hFbm : Measurable Fb)
    (hFa : MemLp Fa 2 (volume.restrict (Set.Ico a₀ (a₀ + r))))
    (hFb : MemLp Fb 2 (volume.restrict (Set.Ico a₀ (a₀ + r)))) :
    separatedLocalForm r w (fun t => Q₁ t + Q₂ t) a b Fa Fb =
      separatedLocalForm r w Q₁ a b Fa Fb + separatedLocalForm r w Q₂ a b Fa Fb := by
  set s := Set.Ico a₀ (a₀ + r)
  have hsm : MeasurableSet s := measurableSet_Ico
  rw [separatedLocalForm_indicator hr hw, separatedLocalForm_indicator hr hw (Q := Q₁),
    separatedLocalForm_indicator hr hw (Q := Q₂)]
  set Ga := s.indicator Fa
  set Gb := s.indicator Fb
  have hGam : Measurable Ga := hFam.indicator hsm
  have hGbm : Measurable Gb := hFbm.indicator hsm
  have hGa : Integrable Ga := (integrable_indicator_iff hsm).mpr (hFa.integrable (by norm_num))
  have hGb : Integrable Gb := (integrable_indicator_iff hsm).mpr (hFb.integrable (by norm_num))
  have hd := fin_cast_sub_ne hab
  have hab' : (a : ℝ) ≠ (b : ℝ) := fun h => hd (by rw [h, sub_self])
  obtain ⟨hΦi, _⟩ := real_progression_pair_integral_norm hGam hGbm hGa hGb hab'
  have hwm : Measurable w := hw.smooth.continuous.measurable
  have hint : ∀ Q : ℝ → ℂ, Measurable Q → (∀ t, ‖Q t‖ ≤ C) →
      Integrable (fun z : ℝ × ℝ => w z * Q z.2 * Ga (realProgressionCoordinate a z) *
        Gb (realProgressionCoordinate b z)) := by
    intro Q hQ hQb
    refine (hΦi.const_mul (localKernelSupBound κ * C)).mono' ?_ ?_
    · exact ((hwm.mul (hQ.comp measurable_snd)).mul
        (hGam.comp (continuous_realProgressionCoordinate a).measurable)).mul
        (hGbm.comp (continuous_realProgressionCoordinate b).measurable) |>.aestronglyMeasurable
    · filter_upwards with z
      simp only [norm_mul, realProgressionCoordinate]
      have h1 := admissibleLocalKernel_norm_le hw z
      have h2 := hQb z.2
      have hC0 : 0 ≤ C := (norm_nonneg _).trans h2
      calc ‖w z‖ * ‖Q z.2‖ * ‖Ga (z.1 + (a : ℝ) * z.2)‖ * ‖Gb (z.1 + (b : ℝ) * z.2)‖
          = (‖w z‖ * ‖Q z.2‖) * (‖Ga (z.1 + (a : ℝ) * z.2)‖ * ‖Gb (z.1 + (b : ℝ) * z.2)‖) := by
            ring
        _ ≤ (localKernelSupBound κ * C) *
            (‖Ga (z.1 + (a : ℝ) * z.2)‖ * ‖Gb (z.1 + (b : ℝ) * z.2)‖) :=
            mul_le_mul_of_nonneg_right (mul_le_mul h1 h2 (norm_nonneg _)
              (localKernelSupBound_nonneg κ)) (by positivity)
  unfold separatedLocalForm
  rw [← mul_add, ← integral_add (hint Q₁ hQ₁ hQ₁b) (hint Q₂ hQ₂ hQ₂b)]
  congr 2; funext z; ring

theorem integrableOn_cell_of_memLp (G : RealDyadicGrid) (I : ℤ × ℤ) {z : ℝ → ℂ}
    (h : MemLp z 2 (volume.restrict (dyadicGridCell G I.1 I.2))) :
    IntegrableOn z (dyadicGridCell G I.1 I.2) := by
  have : IsFiniteMeasure (volume.restrict (dyadicGridCell G I.1 I.2)) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact measure_Ico_lt_top⟩
  exact h.integrable one_le_two

theorem memLp_mul_bounded_restrict {s : Set ℝ} {ψ z : ℝ → ℂ} (hψm : Measurable ψ)
    (hψ : ∀ y, ‖ψ y‖ ≤ 1) (hz : MemLp z 2 (volume.restrict s)) :
    MemLp (fun y => ψ y * z y) 2 (volume.restrict s) :=
  hz.of_le (hψm.aestronglyMeasurable.mul hz.aestronglyMeasurable) (Filter.Eventually.of_forall fun
      y => by
    rw [norm_mul]; exact mul_le_of_le_one_left (norm_nonneg _) (hψ y))

theorem setIntegral_mul_bounded_le {s : Set ℝ} {ψ z : ℝ → ℂ} (hψ : ∀ y, ‖ψ y‖ ≤ 1) (hz : MemLp z 2
    (volume.restrict s)) :
    ∫ y in s, ‖ψ y * z y‖ ^ 2 ≤ ∫ y in s, ‖z y‖ ^ 2 := by
  have hi : Integrable (fun y => ‖z y‖ ^ 2) (volume.restrict s) :=
    hz.integrable_norm_pow (by norm_num)
  refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => by positivity) hi
    (Filter.Eventually.of_forall fun y => ?_)
  simp only [norm_mul]
  have h := hψ y
  have : ‖ψ y‖ * ‖z y‖ ≤ ‖z y‖ := mul_le_of_le_one_left (norm_nonneg _) h
  exact pow_le_pow_left₀ (by positivity) this 2

/-- The phase `e(λ t² + γ t)`. -/
noncomputable def quadPhase (lam γ t : ℝ) : ℂ := (Real.fourierChar (lam * t ^ 2 + γ * t) : ℂ)

theorem quadPhase_split (lam γ t : ℝ) :
    quadPhase lam γ t = (Real.fourierChar (γ * t) : ℂ) +
      ((Real.fourierChar (lam * t ^ 2) : ℂ) - 1) * (Real.fourierChar (γ * t) : ℂ) := by
  unfold quadPhase
  rw [Real.fourierChar.map_add_eq_mul]; push_cast; ring

/-- Blueprint lem:predictors, proof lines 1521–1523 and 1534–1542: the absolute scale sum of
one phase family `e(λ_s t² + γ_s t)` (one phase per depth) against admissible opponents.
The linear part costs the frequency multiplicity `M` of the centers `γ_s/(b-a)`, the
quadratic part the total size `Λ ≥ Σ_s 2π |λ_s| r_s²`. -/
theorem single_phase_scale_sum (G : RealDyadicGrid) (κ : LocalKernelClass) (J : ℤ × ℤ)
    (S : Finset (ℤ × ℤ))
    (hSJ : ∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2)
    (w : ℤ × ℤ → ℝ × ℝ → ℂ)
    (hw : ∀ I ∈ S, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1) (w I))
    {a b : Fin 4} (hab : a ≠ b) (lam γ : ℤ → ℝ)
    {ψa ψb : ℝ → ℂ} (hψam : Measurable ψa) (hψbm : Measurable ψb)
    (hψa : ∀ y, ‖ψa y‖ ≤ 1) (hψb : ∀ y, ‖ψb y‖ ≤ 1)
    {Fa Fb : ℝ → ℂ} {za zb : ℤ × ℤ → ℝ → ℂ} {Ka Kb : ℝ} (hKa : 0 ≤ Ka) (hKb : 0 ≤ Kb)
    (hza : IsAdmissibleOpponent G J Fa za Ka) (hzb : IsAdmissibleOpponent G J Fb zb Kb)
    (hEa : HasDepthEnergy G J Fa za Ka) (hEb : HasDepthEnergy G J Fb zb Kb)
    (hzam : ∀ I, Measurable (za I)) (hzbm : ∀ I, Measurable (zb I))
    (hza2 : ∀ I, MemLp (za I) 2 (volume.restrict (dyadicGridCell G I.1 I.2)))
    (hzb2 : ∀ I, MemLp (zb I) 2 (volume.restrict (dyadicGridCell G I.1 I.2)))
    {M : ℝ} (hM : ∀ ξ, ∑ p ∈ S.image (fun I => (I.1, γ I.1 / ((b : ℝ) - (a : ℝ)))),
      bumpMultiplier (dyadicGridLength G p.1 * (ξ - p.2)) ≤ M)
    {Λ : ℝ} (hΛ : ∑ s ∈ S.image Prod.fst, 2 * Real.pi * |lam s| * dyadicGridLength G s ^ 2 ≤ Λ) :
    ∑ I ∈ S, dyadicGridLength G I.1 *
      ‖separatedLocalForm (dyadicGridLength G I.1) (w I) (quadPhase (lam I.1) (γ I.1)) a b
        (fun y => ψa y * za I y) (fun y => ψb y * zb I y)‖ ≤
      (linearScaleConst κ * M + localKernelSupBound κ * Λ) * Ka * Kb *
        Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2) *
        Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2) := by
  classical
  set Na := Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fa y‖ ^ 2)
  set Nb := Real.sqrt (∫ y in dyadicGridCell G J.1 J.2, ‖Fb y‖ ^ 2)
  have hC := localKernelSupBound_nonneg κ
  have hEc : ∀ g : ℝ, Measurable (fun t : ℝ => (Real.fourierChar (g * t) : ℂ)) := fun g =>
    (continuous_subtype_val.comp (Real.continuous_fourierChar.comp
      (continuous_const.mul continuous_id))).measurable
  have hEq : ∀ g : ℝ, Measurable (fun t : ℝ => (Real.fourierChar (g * t ^ 2) : ℂ)) := fun g =>
    (continuous_subtype_val.comp (Real.continuous_fourierChar.comp
      (continuous_const.mul (continuous_pow 2)))).measurable
  -- linear part
  have hlin := linear_phase_scale_sum G κ J id S hSJ w hw hab (fun I => γ I.1)
    (fun i _ j _ h => by simpa using congrArg Prod.fst h) hψam hψbm hψa hψb hKa hKb hza hzb
    hzam hzbm (fun I _ => integrableOn_cell_of_memLp G I (hza2 I))
    (fun I _ => integrableOn_cell_of_memLp G I (hzb2 I)) hM
  -- quadratic part, cell by cell
  set! X : ℤ × ℤ → ℝ := fun I => ∫ y in dyadicGridCell G I.1 I.2, ‖za I y‖ ^ 2
  set! Y : ℤ × ℤ → ℝ := fun I => ∫ y in dyadicGridCell G I.1 I.2, ‖zb I y‖ ^ 2
  have hcell : ∀ I ∈ S, dyadicGridLength G I.1 *
      ‖separatedLocalForm (dyadicGridLength G I.1) (w I) (quadPhase (lam I.1) (γ I.1)) a b
        (fun y => ψa y * za I y) (fun y => ψb y * zb I y)‖ ≤
      dyadicGridLength G I.1 * ‖separatedLocalForm (dyadicGridLength G I.1) (w I)
        (fun t => (Real.fourierChar (γ I.1 * t) : ℂ)) a b
        (fun y => ψa y * za I y) (fun y => ψb y * zb I y)‖ +
      localKernelSupBound κ * (2 * Real.pi * |lam I.1| * dyadicGridLength G I.1 ^ 2) *
        (Real.sqrt (X I) * Real.sqrt (Y I)) := by
    intro I hI
    have hr := dyadicGridLength_pos G I.1
    have hwI := hw I hI
    have hma := memLp_mul_bounded_restrict hψam hψa (hza2 I)
    have hmb := memLp_mul_bounded_restrict hψbm hψb (hzb2 I)
    have hsplit : quadPhase (lam I.1) (γ I.1) = fun t => (Real.fourierChar (γ I.1 * t) : ℂ) +
        ((Real.fourierChar (lam I.1 * t ^ 2) : ℂ) - 1) * (Real.fourierChar (γ I.1 * t) : ℂ) :=
      funext fun t => quadPhase_split _ _ t
    have hFam : Measurable (fun y => ψa y * za I y) := hψam.mul (hzam I)
    have hFbm : Measurable (fun y => ψb y * zb I y) := hψbm.mul (hzbm I)
    have hQ2m : Measurable (fun t : ℝ => ((Real.fourierChar (lam I.1 * t ^ 2) : ℂ) - 1) *
        (Real.fourierChar (γ I.1 * t) : ℂ)) := ((hEq _).sub measurable_const).mul (hEc _)
    rw [hsplit, separatedLocalForm_add hr hwI hab (hEc _) hQ2m (C := 2)
      (fun t => by rw [Circle.norm_coe]; norm_num)
      (fun t => by
        rw [norm_mul, Circle.norm_coe, mul_one]
        refine (norm_sub_le _ _).trans ?_
        rw [Circle.norm_coe, norm_one]; norm_num)
      hFam hFbm hma hmb]
    have hη : 0 ≤ 2 * Real.pi * |lam I.1| * dyadicGridLength G I.1 ^ 2 := by positivity
    have hq := separatedLocalForm_sup_le hr hwI hab hη (K := fun t =>
        ((Real.fourierChar (lam I.1 * t ^ 2) : ℂ) - 1) * (Real.fourierChar (γ I.1 * t) : ℂ))
      (fun t ht => by
        rw [norm_mul, Circle.norm_coe, mul_one]
        refine (chart_fourierChar_sub_one_norm_le _).trans ?_
        rw [abs_mul, abs_of_nonneg (sq_nonneg t)]
        have h2 : t ^ 2 ≤ dyadicGridLength G I.1 ^ 2 := by
          rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) ht 2
        calc 2 * Real.pi * (|lam I.1| * t ^ 2) = (2 * Real.pi * |lam I.1|) * t ^ 2 := by ring
          _ ≤ (2 * Real.pi * |lam I.1|) * dyadicGridLength G I.1 ^ 2 :=
            mul_le_mul_of_nonneg_left h2 (by positivity))
      hFam hFbm hma hmb
    have hXa := setIntegral_mul_bounded_le hψa
      (hza2 I)
    have hXb := setIntegral_mul_bounded_le hψb
      (hzb2 I)
    have hprod := cell_normalized_product (X := ∫ y in Set.Ico (dyadicGridLeft G I.1 I.2)
        (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1), ‖ψa y * za I y‖ ^ 2)
      (Y := ∫ y in Set.Ico (dyadicGridLeft G I.1 I.2)
        (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1), ‖ψb y * zb I y‖ ^ 2) hr
    refine (mul_le_mul_of_nonneg_left (norm_add_le _ _) hr.le).trans ?_
    rw [mul_add]
    refine add_le_add le_rfl ?_
    calc dyadicGridLength G I.1 * ‖separatedLocalForm (dyadicGridLength G I.1) (w I)
          (fun t => ((Real.fourierChar (lam I.1 * t ^ 2) : ℂ) - 1) *
            (Real.fourierChar (γ I.1 * t) : ℂ)) a b
          (fun y => ψa y * za I y) (fun y => ψb y * zb I y)‖
        ≤ dyadicGridLength G I.1 * (localKernelSupBound κ *
            (2 * Real.pi * |lam I.1| * dyadicGridLength G I.1 ^ 2) *
            Real.sqrt ((dyadicGridLength G I.1)⁻¹ * ∫ y in Set.Ico (dyadicGridLeft G I.1 I.2)
              (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1), ‖ψa y * za I y‖ ^ 2) *
            Real.sqrt ((dyadicGridLength G I.1)⁻¹ * ∫ y in Set.Ico (dyadicGridLeft G I.1 I.2)
              (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1), ‖ψb y * zb I y‖ ^ 2)) :=
          mul_le_mul_of_nonneg_left hq hr.le
      _ = localKernelSupBound κ * (2 * Real.pi * |lam I.1| * dyadicGridLength G I.1 ^ 2) *
            (dyadicGridLength G I.1 * (Real.sqrt ((dyadicGridLength G I.1)⁻¹ *
              ∫ y in Set.Ico (dyadicGridLeft G I.1 I.2)
              (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1), ‖ψa y * za I y‖ ^ 2) *
            Real.sqrt ((dyadicGridLength G I.1)⁻¹ * ∫ y in Set.Ico (dyadicGridLeft G I.1 I.2)
              (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1), ‖ψb y * zb I y‖ ^ 2))) := by
          ring
      _ ≤ localKernelSupBound κ * (2 * Real.pi * |lam I.1| * dyadicGridLength G I.1 ^ 2) *
            (Real.sqrt (X I) * Real.sqrt (Y I)) := by
          rw [hprod]
          exact mul_le_mul_of_nonneg_left (mul_le_mul (Real.sqrt_le_sqrt hXa)
            (Real.sqrt_le_sqrt hXb) (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)) (by positivity)
  have hq := depth_weighted_energy_sum G J S hSJ
    (fun s => localKernelSupBound κ * (2 * Real.pi * |lam s| * dyadicGridLength G s ^ 2))
    (fun s => by positivity) hKa hKb hEa hEb
  have hΛ' : ∑ s ∈ S.image Prod.fst,
      localKernelSupBound κ * (2 * Real.pi * |lam s| * dyadicGridLength G s ^ 2) ≤
      localKernelSupBound κ * Λ := by
    rw [← Finset.mul_sum]; exact mul_le_mul_of_nonneg_left hΛ hC
  have hNa0 : 0 ≤ Na := Real.sqrt_nonneg _
  have hNb0 : 0 ≤ Nb := Real.sqrt_nonneg _
  calc ∑ I ∈ S, dyadicGridLength G I.1 *
        ‖separatedLocalForm (dyadicGridLength G I.1) (w I) (quadPhase (lam I.1) (γ I.1)) a b
          (fun y => ψa y * za I y) (fun y => ψb y * zb I y)‖
      ≤ ∑ I ∈ S, (dyadicGridLength G I.1 * ‖separatedLocalForm (dyadicGridLength G I.1) (w I)
          (fun t => (Real.fourierChar (γ I.1 * t) : ℂ)) a b
          (fun y => ψa y * za I y) (fun y => ψb y * zb I y)‖ +
        localKernelSupBound κ * (2 * Real.pi * |lam I.1| * dyadicGridLength G I.1 ^ 2) *
          (Real.sqrt (X I) * Real.sqrt (Y I))) := Finset.sum_le_sum hcell
    _ = ∑ I ∈ S, dyadicGridLength G I.1 * ‖separatedLocalForm (dyadicGridLength G I.1) (w I)
          (fun t => (Real.fourierChar (γ I.1 * t) : ℂ)) a b
          (fun y => ψa y * za I y) (fun y => ψb y * zb I y)‖ +
        ∑ I ∈ S, localKernelSupBound κ *
          (2 * Real.pi * |lam I.1| * dyadicGridLength G I.1 ^ 2) *
          (Real.sqrt (X I) * Real.sqrt (Y I)) := Finset.sum_add_distrib
    _ ≤ linearScaleConst κ * M * Ka * Kb * Na * Nb +
        (localKernelSupBound κ * Λ) * Ka * Kb * Na * Nb := by
        refine add_le_add hlin (hq.trans ?_)
        gcongr
    _ = (linearScaleConst κ * M + localKernelSupBound κ * Λ) * Ka * Kb * Na * Nb := by ring

/-- The fixed plateau used for the Fourier-supremum bands: the square of the Gevrey plateau
of `exists_plateau_cutoff`, so it is nonnegative, equal to one on `[-1, 1]` and supported in
`[-2, 2]` (blueprint lem:separation, line 1387). -/
noncomputable def bandCutoff (u : ℝ) : ℝ := (Classical.choose exists_plateau_cutoff u) ^ 2

theorem bandCutoff_spec :
    ContDiff ℝ (⊤ : ℕ∞) bandCutoff ∧ (∀ u, 0 ≤ bandCutoff u) ∧ (∀ u, bandCutoff u ≤ 1) ∧
      (∀ u, |u| ≤ 1 → bandCutoff u = 1) ∧ (∀ u, 2 ≤ |u| → bandCutoff u = 0) := by
  obtain ⟨K, -, hs, hb, h1, h0, -⟩ := Classical.choose_spec exists_plateau_cutoff
  refine ⟨hs.pow 2, fun u => sq_nonneg _, fun u => ?_, fun u hu => ?_, fun u hu => ?_⟩
  · have := hb u
    rw [bandCutoff, ← sq_abs]
    exact pow_le_one₀ (abs_nonneg _) this
  · rw [bandCutoff, h1 u hu]; norm_num
  · rw [bandCutoff, h0 u hu]; norm_num

theorem bandCutoff_hasCompactSupport : HasCompactSupport bandCutoff := by
  refine HasCompactSupport.intro (isCompact_Icc (a := -2) (b := 2)) fun u hu => ?_
  apply bandCutoff_spec.2.2.2.2
  by_contra h
  push Not at h
  exact hu (Set.mem_Icc.mpr (abs_le.mp h.le))

theorem bandCutoff_integrable : Integrable bandCutoff :=
  bandCutoff_spec.1.continuous.integrable_of_hasCompactSupport bandCutoff_hasCompactSupport

theorem bandCutoff_lipschitz :
    ∃ L : ℝ, 0 ≤ L ∧ ∀ u v, |bandCutoff v - bandCutoff u| ≤ L * |v - u| := by
  have hd : Continuous (deriv bandCutoff) := bandCutoff_spec.1.continuous_deriv (by simp)
  have hcs : HasCompactSupport (deriv bandCutoff) := bandCutoff_hasCompactSupport.deriv
  obtain ⟨L, hL⟩ := hd.bounded_above_of_compact_support hcs
  refine ⟨max L 0, le_max_right _ _, fun u v => ?_⟩
  have hdiff : Differentiable ℝ bandCutoff := bandCutoff_spec.1.differentiable (by simp)
  have := Convex.norm_image_sub_le_of_norm_deriv_le (𝕜 := ℝ) (f := bandCutoff)
    (s := Set.univ) (fun x _ => hdiff x) (fun x _ => (hL x).trans (le_max_left L 0))
    convex_univ (Set.mem_univ u) (Set.mem_univ v)
  simpa [Real.norm_eq_abs] using this

theorem two_le_integral_bandCutoff : 2 ≤ ∫ u, bandCutoff u := by
  have hmono : ∫ u in Set.Icc (-1 : ℝ) 1, (1 : ℝ) ≤ ∫ u, bandCutoff u := by
    calc ∫ u in Set.Icc (-1 : ℝ) 1, (1 : ℝ) = ∫ u in Set.Icc (-1 : ℝ) 1, bandCutoff u := by
          refine setIntegral_congr_fun measurableSet_Icc fun u hu => ?_
          exact (bandCutoff_spec.2.2.2.1 u (abs_le.mpr hu)).symm
      _ ≤ ∫ u, bandCutoff u :=
          setIntegral_le_integral bandCutoff_integrable
            (Filter.Eventually.of_forall bandCutoff_spec.2.1)
  have h : ∫ u in Set.Icc (-1 : ℝ) 1, (1 : ℝ) = 2 := by
    simp [Measure.real, Real.volume_Icc]; norm_num
  linarith

/-- Fourier decay of the band plateau: `|ζ̂(η)| ≤ C η⁻²`. -/
theorem bandCutoff_fourier_decay : ∃ C : ℝ, 0 ≤ C ∧ ∀ η : ℝ, η ≠ 0 →
    ‖∫ u, (bandCutoff u : ℂ) * (Real.fourierChar (-(η * u)) : ℂ)‖ ≤ C / η ^ 2 := by
  set Θ : ℝ → ℂ := fun u => (bandCutoff u : ℂ) with hΘ
  have hΘs : ContDiff ℝ (⊤ : ℕ∞) Θ := Complex.ofRealCLM.contDiff.comp bandCutoff_spec.1
  have hΘc : HasCompactSupport Θ := bandCutoff_hasCompactSupport.comp_left Complex.ofReal_zero
  have h1 : ContDiff ℝ 1 Θ := hΘs.of_le (by simp)
  have hd1 : ContDiff ℝ 1 (deriv Θ) := by
    have := hΘs.iterate_deriv 1
    simpa using this.of_le (by simp)
  have hd2 : Continuous (deriv (deriv Θ)) := by
    have := hΘs.iterate_deriv 2
    simpa using this.continuous
  have hd2c : HasCompactSupport (deriv (deriv Θ)) := hΘc.deriv.deriv
  set C := ∫ u, ‖deriv (deriv Θ) u‖ with hC
  refine ⟨C / (2 * Real.pi) ^ 2, by positivity, fun η hη => ?_⟩
  have hF1 := fourier_deriv_compact h1 hΘc η
  have hF2 := fourier_deriv_compact hd1 hΘc.deriv η
  have hval : 𝓕 Θ η = ∫ u, (bandCutoff u : ℂ) * (Real.fourierChar (-(η * u)) : ℂ) := by
    rw [Real.fourier_real_eq]
    congr 1; funext u
    rw [Circle.smul_def, smul_eq_mul, mul_comm, mul_comm u η]
  have hb : ‖𝓕 (deriv (deriv Θ)) η‖ ≤ C := by
    rw [Real.fourier_real_eq]
    refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
    congr 1; funext u
    rw [Circle.smul_def, norm_smul, Circle.norm_coe, one_mul]
  rw [hF2, hF1, ← mul_assoc, norm_mul] at hb
  rw [← hval]
  have hn : ‖(2 * Real.pi * Complex.I * η) * (2 * Real.pi * Complex.I * η)‖ =
      (2 * Real.pi) ^ 2 * η ^ 2 := by
    simp only [norm_mul, Complex.norm_ofNat, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos Real.pi_pos, Complex.norm_I, mul_one]
    rw [← sq_abs η]; ring
  rw [hn] at hb
  have hpos : 0 < (2 * Real.pi) ^ 2 * η ^ 2 := by positivity
  rw [div_div, le_div_iff₀ (by positivity)]
  calc ‖𝓕 Θ η‖ * ((2 * Real.pi) ^ 2 * η ^ 2) = (2 * Real.pi) ^ 2 * η ^ 2 * ‖𝓕 Θ η‖ := by ring
    _ ≤ C := hb

/-- The band amplitude `|∫ Q(ru) ζ(u) e(-ξu) du|` of a time factor at scale `r`. -/
noncomputable def bandAmplitude (Q : ℝ → ℂ) (r ξ : ℝ) : ℝ :=
  ‖∫ u, Q (r * u) * (bandCutoff u : ℂ) * (Real.fourierChar (-(ξ * u)) : ℂ)‖

/-- Blueprint lem:predictors, line 1490: the scale `r` lies in the `m`-th Fourier-supremum
band, `e^{-m-1} < A_r ≤ e^{-m}`. -/
def InScaleBand (Q : ℝ → ℂ) (m : ℕ) (r : ℝ) : Prop :=
  (∀ ξ, bandAmplitude Q r ξ ≤ Real.exp (-(m : ℝ))) ∧
    ∃ ξ, Real.exp (-((m : ℝ) + 1)) < bandAmplitude Q r ξ

theorem separatedLocalForm_const_mul (r : ℝ) (w : ℝ × ℝ → ℂ) (c : ℂ) (Q : ℝ → ℂ)
    (a b : Fin 4) (Fa Fb : ℝ → ℂ) :
    separatedLocalForm r w (fun t => c * Q t) a b Fa Fb =
      c * separatedLocalForm r w Q a b Fa Fb := by
  unfold separatedLocalForm
  rw [mul_left_comm, ← integral_const_mul c]
  congr 1; congr 1; funext z; ring

/-- Termwise expansion of the separated form along an absolutely convergent expansion of
the time factor by uniformly bounded measurable terms on the allowed range. -/
theorem separatedLocalForm_hasSum {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a b : Fin 4} (hab : a ≠ b)
    {τ : Type*} [Countable τ] (c : τ → ℂ) (φ : τ → ℝ → ℂ) (hφm : ∀ p, Measurable (φ p))
    (hφ : ∀ p t, ‖φ p t‖ ≤ 1) (hc : Summable (fun p => ‖c p‖)) {Q : ℝ → ℂ}
    (hQ : ∀ t, |t| ≤ r → HasSum (fun p => c p * φ p t) (Q t))
    {Fa Fb : ℝ → ℂ} (hFam : Measurable Fa) (hFbm : Measurable Fb)
    (hFa : MemLp Fa 2 (volume.restrict (Set.Ico a₀ (a₀ + r))))
    (hFb : MemLp Fb 2 (volume.restrict (Set.Ico a₀ (a₀ + r)))) :
    HasSum (fun p => c p * separatedLocalForm r w (φ p) a b Fa Fb)
      (separatedLocalForm r w Q a b Fa Fb) := by
  set s := Set.Ico a₀ (a₀ + r)
  have hsm : MeasurableSet s := measurableSet_Ico
  rw [separatedLocalForm_indicator hr hw (Q := Q)]
  simp_rw [separatedLocalForm_indicator hr hw (Fa := Fa)]
  set Ga := s.indicator Fa
  set Gb := s.indicator Fb
  have hGam : Measurable Ga := hFam.indicator hsm
  have hGbm : Measurable Gb := hFbm.indicator hsm
  have hGa : Integrable Ga := (integrable_indicator_iff hsm).mpr (hFa.integrable (by norm_num))
  have hGb : Integrable Gb := (integrable_indicator_iff hsm).mpr (hFb.integrable (by norm_num))
  have hd := fin_cast_sub_ne hab
  have hab' : (a : ℝ) ≠ (b : ℝ) := fun h => hd (by rw [h, sub_self])
  obtain ⟨hΦi, _⟩ := real_progression_pair_integral_norm hGam hGbm hGa hGb hab'
  set Φ := ∫ z : ℝ × ℝ, ‖Ga (z.1 + (a : ℝ) * z.2)‖ * ‖Gb (z.1 + (b : ℝ) * z.2)‖
  have hwm : Measurable w := hw.smooth.continuous.measurable
  have hC := localKernelSupBound_nonneg κ
  set! f : τ → ℝ × ℝ → ℂ := fun p z => c p * (w z * φ p z.2 *
    Ga (realProgressionCoordinate a z) * Gb (realProgressionCoordinate b z)) with hf
  have hfb : ∀ p z, ‖f p z‖ ≤ ‖c p‖ * (localKernelSupBound κ *
      (‖Ga (z.1 + (a : ℝ) * z.2)‖ * ‖Gb (z.1 + (b : ℝ) * z.2)‖)) := by
    intro p z
    simp only [hf, norm_mul, realProgressionCoordinate]
    apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
    have h1 := admissibleLocalKernel_norm_le hw z
    have h2 := hφ p z.2
    calc ‖w z‖ * ‖φ p z.2‖ * ‖Ga (z.1 + (a : ℝ) * z.2)‖ * ‖Gb (z.1 + (b : ℝ) * z.2)‖
        = (‖w z‖ * ‖φ p z.2‖) * (‖Ga (z.1 + (a : ℝ) * z.2)‖ * ‖Gb (z.1 + (b : ℝ) * z.2)‖) := by
          ring
      _ ≤ (localKernelSupBound κ * 1) *
          (‖Ga (z.1 + (a : ℝ) * z.2)‖ * ‖Gb (z.1 + (b : ℝ) * z.2)‖) :=
          mul_le_mul_of_nonneg_right (mul_le_mul h1 h2 (norm_nonneg _) hC) (by positivity)
      _ = _ := by ring
  have hfm : ∀ p, Measurable (f p) := fun p =>
    measurable_const.mul (((hwm.mul ((hφm p).comp measurable_snd)).mul
      (hGam.comp (continuous_realProgressionCoordinate a).measurable)).mul
      (hGbm.comp (continuous_realProgressionCoordinate b).measurable))
  have hfi : ∀ p, Integrable (f p) := fun p =>
    ((hΦi.const_mul (localKernelSupBound κ)).const_mul ‖c p‖).mono'
      (hfm p).aestronglyMeasurable (Filter.Eventually.of_forall (hfb p))
  have hfn : ∀ p, ∫ z, ‖f p z‖ ≤ ‖c p‖ * (localKernelSupBound κ * Φ) := by
    intro p
    calc ∫ z, ‖f p z‖ ≤ ∫ z : ℝ × ℝ, ‖c p‖ * (localKernelSupBound κ *
          (‖Ga (z.1 + (a : ℝ) * z.2)‖ * ‖Gb (z.1 + (b : ℝ) * z.2)‖)) :=
          integral_mono (hfi p).norm ((hΦi.const_mul _).const_mul _) (hfb p)
      _ = _ := by rw [integral_const_mul, integral_const_mul]
  have hpt : ∀ z : ℝ × ℝ, HasSum (fun p => f p z) (w z * Q z.2 *
      Ga (realProgressionCoordinate a z) * Gb (realProgressionCoordinate b z)) := by
    intro z
    by_cases hz : w z = 0
    · simp only [hf, hz, zero_mul, mul_zero]; exact hasSum_zero
    have h := (hQ z.2 (admissibleKernel_time_le hr hw hz)).mul_left (w z)
    have h2 := (h.mul_right (Ga (realProgressionCoordinate a z))).mul_right
      (Gb (realProgressionCoordinate b z))
    convert h2 using 1
    · funext p; simp only [hf]; ring
  have hsum := hasSum_integral_of_dominated' hfi (hc.mul_right _) hfn hpt
  unfold separatedLocalForm
  have e : ∀ p, c p * ((r : ℂ)⁻¹ ^ 2 * ∫ z, w z * φ p z.2 * Ga (realProgressionCoordinate a z) *
      Gb (realProgressionCoordinate b z)) = (r : ℂ)⁻¹ ^ 2 * ∫ z, f p z := by
    intro p
    simp only [hf]
    rw [integral_const_mul]; ring
  simp_rw [e]
  exact hsum.mul_left _

/-- Blueprint lem:predictors, proof line 1525 (clumps): with a tiny/large dichotomy for the
scaled differences of a finite catalog of frequencies, the catalog splits into clumps of
scaled diameter at most `ε` with representatives separated by at least `L`. -/
theorem exists_clump_representatives {ι : Type*} (P : Finset ι) (γ : ι → ℝ) {r ε L : ℝ}
    (hε : 0 ≤ ε) (h3 : 3 * ε < L)
    (hdich : ∀ p ∈ P, ∀ q ∈ P, r * |γ p - γ q| ≤ ε ∨ L ≤ r * |γ p - γ q|) (hr : 0 ≤ r) :
    ∃ rep : ι → ι, (∀ p ∈ P, rep p ∈ P ∧ r * |γ p - γ (rep p)| ≤ ε) ∧
      ∀ p ∈ P, ∀ q ∈ P, rep p ≠ rep q → L ≤ r * |γ (rep p) - γ (rep q)| := by
  classical
  have hεL : ε < L := by linarith
  set rel : ι → ι → Prop := fun p q => r * |γ p - γ q| ≤ ε with hrel
  have htri : ∀ p q x, r * |γ p - γ x| ≤ r * |γ p - γ q| + r * |γ q - γ x| := by
    intro p q x
    rw [← mul_add]
    exact mul_le_mul_of_nonneg_left (abs_sub_le _ _ _) hr
  have hsymm : ∀ p q, r * |γ p - γ q| = r * |γ q - γ p| := fun p q => by rw [abs_sub_comm]
  -- the class of `p`
  set cls : ι → Set ι := fun p => {q | q ∈ P ∧ rel p q} with hcls
  have hcls_eq : ∀ p ∈ P, ∀ q ∈ P, rel p q → cls p = cls q := by
    intro p hp q hq hpq
    ext x
    simp only [hcls, Set.mem_ofPred_eq, hrel]
    constructor
    · rintro ⟨hx, hpx⟩
      refine ⟨hx, ?_⟩
      rcases hdich q hq x hx with h | h
      · exact h
      · have := htri q p x; rw [hsymm q p] at this; linarith
    · rintro ⟨hx, hqx⟩
      refine ⟨hx, ?_⟩
      rcases hdich p hp x hx with h | h
      · exact h
      · have := htri p q x; linarith
  have hne : ∀ p ∈ P, (cls p).Nonempty := fun p hp =>
    ⟨p, hp, by simp only [hrel, sub_self, abs_zero, mul_zero]; exact hε⟩
  have hwf : WellFounded (WellOrderingRel : ι → ι → Prop) := WellOrderingRel.isWellOrder.wf
  set rep : ι → ι := fun p => if hp : p ∈ P then hwf.min (cls p) (hne p hp) else p with hrep
  have hrep_mem : ∀ p ∈ P, rep p ∈ cls p := by
    intro p hp
    simp only [hrep, hp, dite_true]
    exact hwf.min_mem _ _
  have hrep_eq : ∀ p ∈ P, ∀ q ∈ P, rel p q → rep p = rep q := by
    intro p hp q hq hpq
    simp only [hrep, hp, hq, dite_true]
    have := hcls_eq p hp q hq hpq
    congr 1
  refine ⟨rep, fun p hp => ⟨(hrep_mem p hp).1, (hrep_mem p hp).2⟩, ?_⟩
  intro p hp q hq hpq
  have hcp := hrep_mem p hp
  have hcq := hrep_mem q hq
  have hnot : ¬ rel p q := fun h => hpq (hrep_eq p hp q hq h)
  have hpq' : L ≤ r * |γ p - γ q| := (hdich p hp q hq).resolve_left hnot
  rcases hdich (rep p) hcp.1 (rep q) hcq.1 with h | h
  · exfalso
    have e1 := htri p (rep p) q
    have e2 := htri (rep p) (rep q) q
    have e3 : r * |γ (rep q) - γ q| ≤ ε := by rw [hsymm]; exact hcq.2
    have e4 : r * |γ p - γ (rep p)| ≤ ε := hcp.2
    linarith
  · exact h

theorem integral_bandCutoff_le_four : ∫ u, bandCutoff u ≤ 4 := by
  have h : ∫ u, bandCutoff u = ∫ u in Set.Icc (-2 : ℝ) 2, bandCutoff u := by
    rw [← integral_indicator measurableSet_Icc]
    congr 1; funext u
    by_cases hu : u ∈ Set.Icc (-2 : ℝ) 2
    · rw [Set.indicator_of_mem hu]
    · rw [Set.indicator_of_notMem hu]
      apply bandCutoff_spec.2.2.2.2
      by_contra h
      push Not at h
      exact hu (Set.mem_Icc.mpr (abs_le.mp h.le))
  rw [h]
  calc ∫ u in Set.Icc (-2 : ℝ) 2, bandCutoff u ≤ ∫ u in Set.Icc (-2 : ℝ) 2, (1 : ℝ) :=
        setIntegral_mono_on bandCutoff_integrable.integrableOn
          (integrableOn_const (by simp [Real.volume_Icc]) (by simp)) measurableSet_Icc
          (fun u _ => bandCutoff_spec.2.2.1 u)
    _ = 4 := by simp [Measure.real, Real.volume_Icc]; norm_num

theorem bandCutoff_eq_zero_of_ne {u : ℝ} (hu : bandCutoff u ≠ 0) : |u| < 2 := by
  by_contra h
  push Not at h
  exact hu (bandCutoff_spec.2.2.2.2 u h)

/-- Blueprint lem:predictors, proof line 1525: each combined clump coefficient is controlled
by the band amplitude. Test the expansion against `ζ(u) e(-r γ_C u)`; the clump's own
coefficient is multiplied by `∫ ζ ≥ 2`, separated clumps contribute Fourier tails of `ζ`,
and the uniform approximation error on `|t| ≤ 2r` costs at most `4δ`. -/
theorem clump_coefficient_le {Q : ℝ → ℂ} (hQm : Measurable Q) (hQb : ∀ t, ‖Q t‖ ≤ 1)
    {r : ℝ} (hr : 0 < r) (R : Finset ℝ) (bc : ℝ → ℂ) {L δ A Cζ : ℝ} (hL : 0 < L)
    (hCζ : ∀ η : ℝ, η ≠ 0 →
      ‖∫ u, (bandCutoff u : ℂ) * (Real.fourierChar (-(η * u)) : ℂ)‖ ≤ Cζ / η ^ 2)
    (hCζ0 : 0 ≤ Cζ)
    (hsep : ∀ c ∈ R, ∀ c' ∈ R, c ≠ c' → L ≤ r * |c - c'|)
    (herr : ∀ t, |t| ≤ 2 * r →
      ‖Q t - ∑ c ∈ R, bc c * (Real.fourierChar (c * t) : ℂ)‖ ≤ δ)
    (hA : ∀ ξ, bandAmplitude Q r ξ ≤ A) {c : ℝ} (hc : c ∈ R) :
    ‖bc c‖ ≤ A / 2 + δ + Cζ * (∑ c' ∈ R, ‖bc c'‖) / L ^ 2 := by
  classical
  have hζ2 := two_le_integral_bandCutoff
  have hζ0 := bandCutoff_spec.2.1
  have hζm : Measurable bandCutoff := bandCutoff_spec.1.continuous.measurable
  have hEn : ∀ x : ℝ, ‖(Real.fourierChar x : ℂ)‖ = 1 := fun x => Circle.norm_coe _
  have hEm : ∀ g : ℝ, Measurable (fun u : ℝ => (Real.fourierChar (g * u) : ℂ)) := fun g =>
    (continuous_subtype_val.comp (Real.continuous_fourierChar.comp
      (continuous_const.mul continuous_id))).measurable
  have hEm' : ∀ g : ℝ, Measurable (fun u : ℝ => (Real.fourierChar (-(g * u)) : ℂ)) := fun g =>
    (continuous_subtype_val.comp (Real.continuous_fourierChar.comp
      (continuous_const.mul continuous_id).neg)).measurable
  obtain ⟨S, hS⟩ : ∃ S : ℝ → ℂ,
      S = fun t => ∑ c' ∈ R, bc c' * (Real.fourierChar (c' * t) : ℂ) := ⟨_, rfl⟩
  have hSm : Measurable S := by
    rw [hS]
    exact Finset.measurable_sum R fun c' _ => measurable_const.mul (hEm c')
  have hsumnn : 0 ≤ ∑ c' ∈ R, ‖bc c'‖ := Finset.sum_nonneg fun _ _ => norm_nonneg _
  have hSb : ∀ t, ‖S t‖ ≤ ∑ c' ∈ R, ‖bc c'‖ + 1 := fun t => by
    rw [hS]
    refine (norm_sum_le _ _).trans (le_trans (le_of_eq (Finset.sum_congr rfl fun c' _ => by
      rw [norm_mul, hEn, mul_one])) (by linarith))
  have hint : ∀ F : ℝ → ℂ, Measurable F → (∀ t, ‖F t‖ ≤ ∑ c' ∈ R, ‖bc c'‖ + 1) →
      Integrable (fun u => F (r * u) * (bandCutoff u : ℂ) *
        (Real.fourierChar (-(r * c * u)) : ℂ)) := by
    intro F hF hFb
    refine (bandCutoff_integrable.const_mul (∑ c' ∈ R, ‖bc c'‖ + 1)).mono' ?_ ?_
    · exact (((hF.comp (measurable_const.mul measurable_id)).mul
        (Complex.measurable_ofReal.comp hζm)).mul (hEm' (r * c))).aestronglyMeasurable
    · filter_upwards with u
      rw [norm_mul, norm_mul, hEn, mul_one, Complex.norm_real, Real.norm_of_nonneg (hζ0 u)]
      exact mul_le_mul_of_nonneg_right (hFb _) (hζ0 u)
  have hQi := hint Q hQm (fun t => (hQb t).trans (by linarith))
  have hSi := hint S hSm hSb
  have hDm : Measurable (fun t => Q t - S t) := hQm.sub hSm
  have hDi : Integrable (fun u => (Q (r * u) - S (r * u)) * (bandCutoff u : ℂ) *
      (Real.fourierChar (-(r * c * u)) : ℂ)) := by
    have := hQi.sub hSi
    refine this.congr (Filter.Eventually.of_forall fun u => ?_)
    simp only [Pi.sub_apply]; ring
  -- character products
  have hprod : ∀ c' u : ℝ, (Real.fourierChar (c' * (r * u)) : ℂ) *
      (Real.fourierChar (-(r * c * u)) : ℂ) =
      (Real.fourierChar (-((r * (c - c')) * u)) : ℂ) := by
    intro c' u
    rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul]
    congr 2; ring
  have hcharint : ∀ g : ℝ, Integrable (fun u => (bandCutoff u : ℂ) *
      (Real.fourierChar (-(g * u)) : ℂ)) := fun g =>
    (bandCutoff_integrable.ofReal (𝕜 := ℂ)).norm.mono' ((Complex.measurable_ofReal.comp hζm).mul
      (hEm' g)).aestronglyMeasurable (Filter.Eventually.of_forall fun u => by
        rw [norm_mul, hEn, mul_one]; rfl)
  have hSint : ∫ u, S (r * u) * (bandCutoff u : ℂ) * (Real.fourierChar (-(r * c * u)) : ℂ) =
      ∑ c' ∈ R, bc c' * ∫ u, (bandCutoff u : ℂ) *
        (Real.fourierChar (-((r * (c - c')) * u)) : ℂ) := by
    have e : (fun u => S (r * u) * (bandCutoff u : ℂ) * (Real.fourierChar (-(r * c * u)) : ℂ)) =
        fun u => ∑ c' ∈ R, bc c' * ((bandCutoff u : ℂ) *
          (Real.fourierChar (-((r * (c - c')) * u)) : ℂ)) := by
      funext u
      rw [hS]
      simp only [Finset.sum_mul]
      refine Finset.sum_congr rfl fun c' _ => ?_
      rw [← hprod c' u]; ring
    rw [e, integral_finsetSum]
    · exact Finset.sum_congr rfl fun c' _ => integral_const_mul _ _
    · exact fun c' _ => (hcharint _).const_mul _
  have hown : ∫ u, (bandCutoff u : ℂ) * (Real.fourierChar (-((r * (c - c)) * u)) : ℂ) =
      ((∫ u, bandCutoff u : ℝ) : ℂ) := by
    simp only [sub_self, mul_zero, zero_mul, neg_zero, AddChar.map_zero_eq_one,
      Circle.coe_one, mul_one]
    exact integral_ofReal
  have hrest : ∀ c' ∈ R.erase c, ‖bc c' * ∫ u, (bandCutoff u : ℂ) *
      (Real.fourierChar (-((r * (c - c')) * u)) : ℂ)‖ ≤ ‖bc c'‖ * (Cζ / L ^ 2) := by
    intro c' hc'
    have hne : c' ≠ c := (Finset.mem_erase.mp hc').1
    have hsepc := hsep c hc c' (Finset.mem_erase.mp hc').2 (Ne.symm hne)
    have hη : r * (c - c') ≠ 0 := mul_ne_zero hr.ne' (sub_ne_zero.mpr (Ne.symm hne))
    rw [norm_mul]
    refine mul_le_mul_of_nonneg_left ((hCζ _ hη).trans ?_) (norm_nonneg _)
    apply div_le_div_of_nonneg_left hCζ0 (by positivity)
    have h1 : L ≤ |r * (c - c')| := by rw [abs_mul, abs_of_pos hr]; exact hsepc
    calc L ^ 2 ≤ |r * (c - c')| ^ 2 := pow_le_pow_left₀ hL.le h1 2
      _ = (r * (c - c')) ^ 2 := sq_abs _
  have herrint : ‖∫ u, (Q (r * u) - S (r * u)) * (bandCutoff u : ℂ) *
      (Real.fourierChar (-(r * c * u)) : ℂ)‖ ≤ δ * ∫ u, bandCutoff u := by
    refine (norm_integral_le_integral_norm _).trans ?_
    rw [← integral_const_mul]
    refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => norm_nonneg _)
      (bandCutoff_integrable.const_mul δ) (Filter.Eventually.of_forall fun u => ?_)
    simp only [norm_mul, hEn, mul_one, Complex.norm_real, Real.norm_of_nonneg (hζ0 u)]
    by_cases hu : bandCutoff u = 0
    · rw [hu]; simp
    have hu2 := bandCutoff_eq_zero_of_ne hu
    have ht : |r * u| ≤ 2 * r := by
      rw [abs_mul, abs_of_pos hr]; nlinarith [abs_nonneg u]
    have := herr _ ht
    have hSe : S (r * u) = ∑ c' ∈ R, bc c' * (Real.fourierChar (c' * (r * u)) : ℂ) := by
      rw [hS]
    rw [hSe]
    exact mul_le_mul_of_nonneg_right this (hζ0 u)
  have hsplit : ∫ u, Q (r * u) * (bandCutoff u : ℂ) * (Real.fourierChar (-(r * c * u)) : ℂ) =
      (∫ u, S (r * u) * (bandCutoff u : ℂ) * (Real.fourierChar (-(r * c * u)) : ℂ)) +
        ∫ u, (Q (r * u) - S (r * u)) * (bandCutoff u : ℂ) *
          (Real.fourierChar (-(r * c * u)) : ℂ) := by
    rw [← integral_add hSi hDi]
    congr 1; funext u; ring
  rw [hSint, ← Finset.add_sum_erase R _ hc, hown] at hsplit
  have hamp := hA (r * c)
  unfold bandAmplitude at hamp
  rw [hsplit] at hamp
  set I0 := ∫ u, bandCutoff u
  set Rest := ∑ c' ∈ R.erase c, bc c' * ∫ u, (bandCutoff u : ℂ) *
    (Real.fourierChar (-((r * (c - c')) * u)) : ℂ)
  set Err := ∫ u, (Q (r * u) - S (r * u)) * (bandCutoff u : ℂ) *
    (Real.fourierChar (-(r * c * u)) : ℂ)
  have h3 : ‖Rest‖ ≤ Cζ * (∑ c' ∈ R, ‖bc c'‖) / L ^ 2 := by
    refine (norm_sum_le _ _).trans ((Finset.sum_le_sum hrest).trans ?_)
    rw [← Finset.sum_mul]
    have hsub : ∑ c' ∈ R.erase c, ‖bc c'‖ ≤ ∑ c' ∈ R, ‖bc c'‖ :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.erase_subset _ _)
        (fun _ _ _ => norm_nonneg _)
    calc (∑ c' ∈ R.erase c, ‖bc c'‖) * (Cζ / L ^ 2)
        ≤ (∑ c' ∈ R, ‖bc c'‖) * (Cζ / L ^ 2) :=
          mul_le_mul_of_nonneg_right hsub (by positivity)
      _ = _ := by ring
  have h1 : ‖bc c * (I0 : ℂ)‖ ≤ A + ‖Rest‖ + ‖Err‖ := by
    have e : bc c * (I0 : ℂ) = (bc c * (I0 : ℂ) + Rest + Err) - Rest - Err := by ring
    rw [e]
    have := norm_sub_le (bc c * (I0 : ℂ) + Rest + Err - Rest) Err
    have := norm_sub_le (bc c * (I0 : ℂ) + Rest + Err) Rest
    linarith
  rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (by linarith)] at h1
  have hI0 : 0 < I0 := by linarith
  have hδ0 : 0 ≤ δ := (norm_nonneg _).trans (herr 0 (by simp; linarith))
  have hA0 : 0 ≤ A := (norm_nonneg _).trans (hA 0)
  have hmain : ‖bc c‖ * I0 ≤ A + δ * I0 + Cζ * (∑ c' ∈ R, ‖bc c'‖) / L ^ 2 := by
    linarith
  have hX : 0 ≤ Cζ * (∑ c' ∈ R, ‖bc c'‖) / L ^ 2 := by positivity
  have hb := norm_nonneg (bc c)
  by_contra hcon
  push Not at hcon
  have : (A / 2 + δ + Cζ * (∑ c' ∈ R, ‖bc c'‖) / L ^ 2) * I0 < ‖bc c‖ * I0 :=
    mul_lt_mul_of_pos_right hcon hI0
  nlinarith only [hζ2, herrint, h3, h1, hA0, hX, hcon]

theorem norm_fourierChar_sub_le (x y : ℝ) :
    ‖(Real.fourierChar x : ℂ) - (Real.fourierChar y : ℂ)‖ ≤ 2 * Real.pi * |x - y| := by
  have h : (Real.fourierChar x : ℂ) - (Real.fourierChar y : ℂ) =
      (Real.fourierChar y : ℂ) * ((Real.fourierChar (x - y) : ℂ) - 1) := by
    rw [mul_sub, mul_one, ← Circle.coe_mul, ← AddChar.map_add_eq_mul]
    congr 3; ring
  rw [h, norm_mul, Circle.norm_coe, one_mul]
  exact chart_fourierChar_sub_one_norm_le _

theorem norm_quadPhase (lam γ t : ℝ) : ‖quadPhase lam γ t‖ = 1 := Circle.norm_coe _

theorem measurable_quadPhase (lam γ : ℝ) : Measurable (quadPhase lam γ) :=
  (continuous_subtype_val.comp (Real.continuous_fourierChar.comp
    ((continuous_const.mul (continuous_pow 2)).add (continuous_const.mul
        continuous_id)))).measurable

/-- Blueprint lem:predictors, proof line 1525, at one non-exceptional cell: after the
chart expansion `Q = Σ_p c_p e(λ t² + γ_p t)` on the allowed range, the form splits into
the clump terms with combined coefficients, the replacement errors (quadratic part and
center shift inside a clump) and the tail outside the finite catalog `P`. -/
theorem clump_cell_bound {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a b : Fin 4} (hab : a ≠ b)
    {τ : Type*} [Countable τ] [DecidableEq τ] (c : τ → ℂ) (hc : Summable (fun p => ‖c p‖)) (lam : ℝ)
    (f : τ → ℝ) {Q : ℝ → ℂ}
    (hQ : ∀ t, |t| ≤ r → HasSum (fun p => c p * quadPhase lam (f p) t) (Q t))
    (P : Finset τ) (rep : τ → τ) {β : ℝ} (hβ : ∀ p ∈ P, r * |f p - f (rep p)| ≤ β)
    {Fa Fb : ℝ → ℂ} (hFam : Measurable Fa) (hFbm : Measurable Fb)
    (hFa : MemLp Fa 2 (volume.restrict (Set.Ico a₀ (a₀ + r))))
    (hFb : MemLp Fb 2 (volume.restrict (Set.Ico a₀ (a₀ + r)))) :
    ‖separatedLocalForm r w Q a b Fa Fb‖ ≤
      ∑ x ∈ P.image (fun p => f (rep p)),
          ‖∑ p ∈ P.filter (fun p => f (rep p) = x), c p‖ *
          ‖separatedLocalForm r w (fun t => (Real.fourierChar (x * t) : ℂ)) a b Fa Fb‖ +
        (∑ p ∈ P, ‖c p‖) * (localKernelSupBound κ *
          (2 * Real.pi * (|lam| * r ^ 2 + β)) *
          Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖Fa y‖ ^ 2) *
          Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖Fb y‖ ^ 2)) +
        ∑' p, (if p ∈ P then 0 else
          ‖c p‖ * ‖separatedLocalForm r w (quadPhase lam (f p)) a b Fa Fb‖) := by
  obtain ⟨H, hH⟩ : ∃ H : (ℝ → ℂ) → ℂ, H = fun φ => separatedLocalForm r w φ a b Fa Fb :=
    ⟨_, rfl⟩
  have eH : ∀ φ, separatedLocalForm r w φ a b Fa Fb = H φ := fun φ => by rw [hH]
  set Na := Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖Fa y‖ ^ 2)
  set Nb := Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖Fb y‖ ^ 2)
  have hC := localKernelSupBound_nonneg κ
  have hEc : ∀ g : ℝ, Measurable (fun t : ℝ => (Real.fourierChar (g * t) : ℂ)) := fun g =>
    (continuous_subtype_val.comp (Real.continuous_fourierChar.comp
      (continuous_const.mul continuous_id))).measurable
  have hsum := separatedLocalForm_hasSum hr hw hab c (fun p => quadPhase lam (f p))
    (fun p => measurable_quadPhase _ _) (fun p t => (norm_quadPhase _ _ t).le) hc hQ
    hFam hFbm hFa hFb
  -- uniform bound of each phase form
  simp only [eH] at hsum ⊢
  have hphase : ∀ g : ℝ → ℂ, (∀ t, |t| ≤ r → ‖g t‖ ≤ 1) → ‖H g‖ ≤
      localKernelSupBound κ * 1 * Na * Nb := fun g hg => by
    rw [← eH]; exact separatedLocalForm_sup_le hr hw hab zero_le_one hg hFam hFbm hFa hFb
  have hhs : Summable (fun p => c p * H (quadPhase lam (f p))) := hsum.summable
  have hnorms : Summable (fun p => ‖c p‖ * ‖H (quadPhase lam (f p))‖) := by
    refine Summable.of_nonneg_of_le (fun p => by positivity) (fun p => ?_)
      (hc.mul_right (localKernelSupBound κ * 1 * Na * Nb))
    exact mul_le_mul_of_nonneg_left (hphase _ fun t _ => (norm_quadPhase _ _ t).le)
      (norm_nonneg _)
  -- split the expansion over the catalog
  have hsplit : H Q = ∑ p ∈ P, c p * H (quadPhase lam (f p)) +
      ∑' p : ↥((P : Set τ)ᶜ), c p * H (quadPhase lam (f p)) := by
    rw [← hsum.tsum_eq, ← hhs.sum_add_tsum_compl]
  -- the tail
  have htail : ‖∑' p : ↥((P : Set τ)ᶜ), c p * H (quadPhase lam (f p))‖ ≤
      ∑' p, (if p ∈ P then 0 else ‖c p‖ * ‖H (quadPhase lam (f p))‖) := by
    have hs2 : Summable (fun p : ↥((P : Set τ)ᶜ) => ‖c p * H (quadPhase lam (f p))‖) := by
      have := hnorms.subtype (· ∈ (P : Set τ)ᶜ)
      refine this.congr fun p => ?_
      simp
    refine (norm_tsum_le_tsum_norm hs2).trans (le_of_eq ?_)
    rw [tsum_subtype ((P : Set τ)ᶜ) (fun p => ‖c p * H (quadPhase lam (f p))‖)]
    congr 1; funext p
    by_cases hp : p ∈ P
    · simp [hp]
    · simp [hp]
  -- the catalog part
  have hcat : ∀ p ∈ P, H (quadPhase lam (f p)) =
      H (fun t => (Real.fourierChar (f (rep p) * t) : ℂ)) +
        H (fun t => quadPhase lam (f p) t - (Real.fourierChar (f (rep p) * t) : ℂ)) := by
    intro p _
    have hm : Measurable (fun t => quadPhase lam (f p) t -
        (Real.fourierChar (f (rep p) * t) : ℂ)) :=
      (measurable_quadPhase lam (f p)).sub (hEc (f (rep p)))
    have := separatedLocalForm_add hr hw hab (hEc (f (rep p))) hm (C := 2)
      (fun t => by rw [Circle.norm_coe]; norm_num)
      (fun t => (norm_sub_le _ _).trans (by rw [norm_quadPhase, Circle.norm_coe]; norm_num))
      hFam hFbm hFa hFb
    rw [eH, eH, eH] at this
    rw [← this]
    congr 1; funext t; ring
  have herr : ∀ p ∈ P, ‖H (fun t => quadPhase lam (f p) t -
      (Real.fourierChar (f (rep p) * t) : ℂ))‖ ≤
        localKernelSupBound κ * (2 * Real.pi * (|lam| * r ^ 2 + β)) * Na * Nb := by
    intro p hp
    have hβ0 : 0 ≤ β := (mul_nonneg hr.le (abs_nonneg _)).trans (hβ p hp)
    have hη : 0 ≤ 2 * Real.pi * (|lam| * r ^ 2 + β) := by positivity
    rw [← eH]
    refine separatedLocalForm_sup_le hr hw hab hη (fun t ht => ?_) hFam hFbm hFa hFb
    unfold quadPhase
    rw [show lam * t ^ 2 + f p * t = lam * t ^ 2 + f p * t by rfl]
    have e : (Real.fourierChar (lam * t ^ 2 + f p * t) : ℂ) -
        (Real.fourierChar (f (rep p) * t) : ℂ) =
        ((Real.fourierChar (lam * t ^ 2) : ℂ) - 1) * (Real.fourierChar (f p * t) : ℂ) +
          ((Real.fourierChar (f p * t) : ℂ) - (Real.fourierChar (f (rep p) * t) : ℂ)) := by
      rw [Real.fourierChar.map_add_eq_mul]; push_cast; ring
    rw [e]
    refine (norm_add_le _ _).trans ?_
    rw [norm_mul, Circle.norm_coe, mul_one]
    have h1 := chart_fourierChar_sub_one_norm_le (lam * t ^ 2)
    have h2 := norm_fourierChar_sub_le (f p * t) (f (rep p) * t)
    have ht2 : t ^ 2 ≤ r ^ 2 := by rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) ht 2
    have h3 : |lam * t ^ 2| ≤ |lam| * r ^ 2 := by
      rw [abs_mul, abs_of_nonneg (sq_nonneg t)]
      exact mul_le_mul_of_nonneg_left ht2 (abs_nonneg _)
    have h4 : |f p * t - f (rep p) * t| ≤ β := by
      rw [← sub_mul, abs_mul]
      calc |f p - f (rep p)| * |t| ≤ |f p - f (rep p)| * r :=
            mul_le_mul_of_nonneg_left ht (abs_nonneg _)
        _ = r * |f p - f (rep p)| := by ring
        _ ≤ β := hβ p hp
    have hπ := Real.pi_pos
    nlinarith only [h1, h2, h3, h4, hπ]
  have hfib : ∑ p ∈ P, c p * H (fun t => (Real.fourierChar (f (rep p) * t) : ℂ)) =
      ∑ x ∈ P.image (fun p => f (rep p)), (∑ p ∈ P.filter (fun p => f (rep p) = x), c p) *
        H (fun t => (Real.fourierChar (x * t) : ℂ)) := by
    rw [← Finset.sum_fiberwise_of_maps_to (g := fun p => f (rep p))
      (t := P.image (fun p => f (rep p))) (fun p hp => Finset.mem_image_of_mem _ hp)]
    refine Finset.sum_congr rfl fun x _ => ?_
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [(Finset.mem_filter.mp hp).2]
  have hcatsum : ∑ p ∈ P, c p * H (quadPhase lam (f p)) =
      ∑ p ∈ P, c p * H (fun t => (Real.fourierChar (f (rep p) * t) : ℂ)) +
        ∑ p ∈ P, c p * H (fun t => quadPhase lam (f p) t -
          (Real.fourierChar (f (rep p) * t) : ℂ)) := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [hcat p hp, mul_add]
  rw [hsplit, hcatsum, hfib]
  refine (norm_add_le _ _).trans (add_le_add ((norm_add_le _ _).trans (add_le_add ?_ ?_)) htail)
  · refine (norm_sum_le _ _).trans (le_of_eq ?_)
    refine Finset.sum_congr rfl fun x _ => ?_
    rw [norm_mul]
  · refine (norm_sum_le _ _).trans ?_
    rw [Finset.sum_mul]
    refine Finset.sum_le_sum fun p hp => ?_
    rw [norm_mul]
    have := herr p hp
    calc ‖c p‖ * ‖H (fun t => quadPhase lam (f p) t - (Real.fourierChar (f (rep p) * t) : ℂ))‖
        ≤ ‖c p‖ * (localKernelSupBound κ * (2 * Real.pi * (|lam| * r ^ 2 + β)) * Na * Nb) :=
          mul_le_mul_of_nonneg_left this (norm_nonneg _)
      _ = _ := by ring

theorem kernelFourierConst_nonneg (κ : LocalKernelClass) : 0 ≤ kernelFourierConst κ := by
  unfold kernelFourierConst
  have h0 := kernelDerivBound_nonneg κ 0
  have h3 := kernelDerivBound_nonneg κ 3
  positivity

theorem kernelPointEnvelope_nonneg (κ : LocalKernelClass) (p : ℕ) :
    0 ≤ kernelPointEnvelope κ p := by
  refine le_max_of_le_left ?_
  unfold kernelUnitEnvelope; have := kernelDerivBound_nonneg κ 0; positivity

theorem linearScaleConst_nonneg (κ : LocalKernelClass) : 0 ≤ linearScaleConst κ := by
  unfold linearScaleConst
  have h1 := kernelPointEnvelope_nonneg κ 7
  have h2 : 0 ≤ ∑' v : Fin 2 → ℤ, ((1 + frequencyLength v) ^ 3)⁻¹ :=
    tsum_nonneg fun v => by have := frequencyLength_nonneg v; positivity
  positivity

theorem heightBandConst_nonneg (d : ℕ) {B : ℝ} (hB : 2 ≤ B) : 0 ≤ heightBandConst d B := by
  unfold heightBandConst
  have h1 : 0 ≤ Real.log (2 * B) := Real.log_nonneg (by linarith)
  have h2 : 0 ≤ Real.log 4 := Real.log_nonneg (by norm_num)
  positivity

/-- The single-scale bound of lem:separation on half-open cells with the band plateau. -/
theorem separated_form_le_band {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a b : Fin 4} (hab : a ≠ b)
    {Q : ℝ → ℂ} (hQm : Measurable Q) (hQ1 : ∀ t, ‖Q t‖ ≤ 1) {M : ℝ}
    (hM : ∀ ξ, bandAmplitude Q r ξ ≤ M)
    {Fa Fb : ℝ → ℂ} (hFam : Measurable Fa) (hFbm : Measurable Fb)
    (hFa : MemLp Fa 2 (volume.restrict (Set.Ico a₀ (a₀ + r))))
    (hFb : MemLp Fb 2 (volume.restrict (Set.Ico a₀ (a₀ + r)))) :
    ‖separatedLocalForm r w Q a b Fa Fb‖ ≤ kernelFourierConst κ * M *
      Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖Fa y‖ ^ 2) *
      Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖Fb y‖ ^ 2) := by
  have hres : volume.restrict (Set.Ico a₀ (a₀ + r)) = volume.restrict (Set.Icc a₀ (a₀ + r)) :=
    Measure.restrict_congr_set Ico_ae_eq_Icc
  have h := separated_form_le hr hw a b hab hQm hQ1 bandCutoff_integrable
    (fun u hu => bandCutoff_spec.2.2.2.1 u hu) (M := M) (fun ξ => hM ξ) hFam hFbm
    (hres ▸ hFa) (hres ▸ hFb)
  rw [setIntegral_congr_set Ico_ae_eq_Icc, setIntegral_congr_set Ico_ae_eq_Icc (f := fun y => ‖Fb
      y‖ ^ 2)]
  exact h

theorem clump_coeff_sum_le {τ : Type*} (P : Finset τ) (coef : τ → ℂ)
    (g : τ → ℝ) :
    ∑ x ∈ P.image g, ‖∑ p ∈ P.filter (fun p => g p = x), coef p‖ ≤ ∑ p ∈ P, ‖coef p‖ := by
  classical
  calc ∑ x ∈ P.image g, ‖∑ p ∈ P.filter (fun p => g p = x), coef p‖
      ≤ ∑ x ∈ P.image g, ∑ p ∈ P.filter (fun p => g p = x), ‖coef p‖ :=
        Finset.sum_le_sum fun x _ => norm_sum_le _ _
    _ = ∑ p ∈ P, ‖coef p‖ :=
        Finset.sum_fiberwise_of_maps_to (fun p hp => Finset.mem_image_of_mem _ hp) _

theorem clump_fiber_sum {τ : Type*} (P : Finset τ) (coef : τ → ℂ)
    (g : τ → ℝ) (t : ℝ) :
    ∑ x ∈ P.image g, (∑ p ∈ P.filter (fun p => g p = x), coef p) *
      (Real.fourierChar (x * t) : ℂ) = ∑ p ∈ P, coef p * (Real.fourierChar (g p * t) : ℂ) := by
  classical
  rw [← Finset.sum_fiberwise_of_maps_to (g := g) (t := P.image g)
    (fun p hp => Finset.mem_image_of_mem _ hp)]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [Finset.sum_mul]
  refine Finset.sum_congr rfl fun p hp => ?_
  rw [(Finset.mem_filter.mp hp).2]

/-- Blueprint lem:predictors, proof line 1525: on a non-exceptional depth the clump
replacement approximates the time factor uniformly on `|t| ≤ 2r`. -/
theorem clump_sup_error {τ : Type*} [DecidableEq τ] (coef : τ → ℂ)
    (hc : Summable (fun p => ‖coef p‖)) (lam : ℝ) (f : τ → ℝ) {Q : ℝ → ℂ} {r t : ℝ}
    (ht : |t| ≤ 2 * r)
    (hQt : HasSum (fun p => coef p * quadPhase lam (f p) t) (Q t)) (P : Finset τ)
    (rep : τ → τ) {ε₁ ε₂ : ℝ} (hε₁ : 0 ≤ ε₁) (hε₂ : 0 ≤ ε₂) (hrep : ∀ p ∈ P, r * |f p - f (rep p)|
        ≤ ε₂)
    (hq : |lam| * r ^ 2 ≤ ε₁) {τt Atot : ℝ}
    (htail : ∑' p, (if p ∈ P then 0 else ‖coef p‖) ≤ τt)
    (hAtot : ∑ p ∈ P, ‖coef p‖ ≤ Atot) :
    ‖Q t - ∑ x ∈ P.image (fun p => f (rep p)),
        (∑ p ∈ P.filter (fun p => f (rep p) = x), coef p) * (Real.fourierChar (x * t) : ℂ)‖ ≤
      τt + Atot * (8 * Real.pi * ε₁ + 4 * Real.pi * ε₂) := by
  classical
  rw [clump_fiber_sum]
  have hs : Summable (fun p => coef p * quadPhase lam (f p) t) := hQt.summable
  have hsplit := hs.sum_add_tsum_compl (s := P)
  rw [hQt.tsum_eq] at hsplit
  rw [← hsplit]
  have e : ∑ p ∈ P, coef p * quadPhase lam (f p) t +
      ∑' p : ↥((P : Set τ)ᶜ), coef p * quadPhase lam (f p) t -
      ∑ p ∈ P, coef p * (Real.fourierChar (f (rep p) * t) : ℂ) =
      ∑ p ∈ P, coef p * (quadPhase lam (f p) t - (Real.fourierChar (f (rep p) * t) : ℂ)) +
        ∑' p : ↥((P : Set τ)ᶜ), coef p * quadPhase lam (f p) t := by
    rw [show ∑ p ∈ P, coef p * (quadPhase lam (f p) t -
        (Real.fourierChar (f (rep p) * t) : ℂ)) = ∑ p ∈ P, coef p * quadPhase lam (f p) t -
        ∑ p ∈ P, coef p * (Real.fourierChar (f (rep p) * t) : ℂ) by
      rw [← Finset.sum_sub_distrib]; congr 1; funext p; ring]
    ring
  rw [e]
  have hEn : ∀ x : ℝ, ‖(Real.fourierChar x : ℂ)‖ = 1 := fun x => Circle.norm_coe _
  have hterm : ∀ p ∈ P, ‖quadPhase lam (f p) t - (Real.fourierChar (f (rep p) * t) : ℂ)‖ ≤
      8 * Real.pi * ε₁ + 4 * Real.pi * ε₂ := by
    intro p hp
    have e2 : quadPhase lam (f p) t - (Real.fourierChar (f (rep p) * t) : ℂ) =
        ((Real.fourierChar (lam * t ^ 2) : ℂ) - 1) * (Real.fourierChar (f p * t) : ℂ) +
          ((Real.fourierChar (f p * t) : ℂ) - (Real.fourierChar (f (rep p) * t) : ℂ)) := by
      unfold quadPhase
      rw [Real.fourierChar.map_add_eq_mul]; push_cast; ring
    rw [e2]
    refine (norm_add_le _ _).trans ?_
    rw [norm_mul, hEn, mul_one]
    have h1 := chart_fourierChar_sub_one_norm_le (lam * t ^ 2)
    have h2 := norm_fourierChar_sub_le (f p * t) (f (rep p) * t)
    have ht2 : t ^ 2 ≤ 4 * r ^ 2 := by
      have : t ^ 2 ≤ (2 * r) ^ 2 := by rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) ht 2
      linarith
    have h3 : |lam * t ^ 2| ≤ 4 * ε₁ := by
      rw [abs_mul, abs_of_nonneg (sq_nonneg t)]
      calc |lam| * t ^ 2 ≤ |lam| * (4 * r ^ 2) := mul_le_mul_of_nonneg_left ht2 (abs_nonneg _)
        _ = 4 * (|lam| * r ^ 2) := by ring
        _ ≤ 4 * ε₁ := by linarith
    have h4 : |f p * t - f (rep p) * t| ≤ 2 * ε₂ := by
      rw [← sub_mul, abs_mul]
      calc |f p - f (rep p)| * |t| ≤ |f p - f (rep p)| * (2 * r) :=
            mul_le_mul_of_nonneg_left ht (abs_nonneg _)
        _ = 2 * (r * |f p - f (rep p)|) := by ring
        _ ≤ 2 * ε₂ := by linarith [hrep p hp]
    have hπ := Real.pi_pos
    nlinarith only [h1, h2, h3, h4, hπ]
  have hcat : ‖∑ p ∈ P, coef p * (quadPhase lam (f p) t -
      (Real.fourierChar (f (rep p) * t) : ℂ))‖ ≤
      Atot * (8 * Real.pi * ε₁ + 4 * Real.pi * ε₂) := by
    have hK0 : 0 ≤ 8 * Real.pi * ε₁ + 4 * Real.pi * ε₂ := by positivity
    refine (norm_sum_le _ _).trans ?_
    calc ∑ p ∈ P, ‖coef p * (quadPhase lam (f p) t - (Real.fourierChar (f (rep p) * t) : ℂ))‖
        ≤ ∑ p ∈ P, ‖coef p‖ * (8 * Real.pi * ε₁ + 4 * Real.pi * ε₂) :=
          Finset.sum_le_sum fun p hp => by
            rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hterm p hp) (norm_nonneg _)
      _ = (∑ p ∈ P, ‖coef p‖) * (8 * Real.pi * ε₁ + 4 * Real.pi * ε₂) := by
          rw [Finset.sum_mul]
      _ ≤ Atot * (8 * Real.pi * ε₁ + 4 * Real.pi * ε₂) :=
          mul_le_mul_of_nonneg_right hAtot hK0
  have htl : ‖∑' p : ↥((P : Set τ)ᶜ), coef p * quadPhase lam (f p) t‖ ≤ τt := by
    have hs2 : Summable (fun p : ↥((P : Set τ)ᶜ) => ‖coef p * quadPhase lam (f p) t‖) := by
      have := hc.subtype (· ∈ (P : Set τ)ᶜ)
      refine this.congr fun p => ?_
      simp [norm_quadPhase]
    refine (norm_tsum_le_tsum_norm hs2).trans (le_trans (le_of_eq ?_) htail)
    rw [tsum_subtype ((P : Set τ)ᶜ) (fun p => ‖coef p * quadPhase lam (f p) t‖)]
    congr 1; funext p
    by_cases hp : p ∈ P
    · simp [hp]
    · simp [hp, norm_quadPhase]
  calc _ ≤ _ := norm_add_le _ _
    _ ≤ Atot * (8 * Real.pi * ε₁ + 4 * Real.pi * ε₂) + τt := add_le_add hcat htl
    _ = _ := by ring

/-- The multiplicity constant of the clump representatives. -/
noncomputable def clumpMultiplicity (d : ℕ) (B : ℝ) : ℝ :=
  24 * (2 * Real.pi) ^ 2 * (4 * heightBandConst d B)



end TrilinearHT.Auto

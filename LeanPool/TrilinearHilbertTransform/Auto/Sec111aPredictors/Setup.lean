  have h1 : ((‖u‖ : ℝ) : ℂ) ^ 2 = inner ℂ u u := (inner_self_eq_norm_sq_to_K (𝕜 := ℂ) u).symm
  rw [L2.inner_def] at h1
  have h2 : ∫ ξ, inner ℂ (u ξ) (u ξ) = ∫ ξ, (((‖m ξ‖ ^ 2 * ‖G ξ‖ ^ 2 : ℝ)) : ℂ) := by
    apply integral_congr_ae
    filter_upwards [MemLp.coeFn_toLp (memLp_two_mul_bounded hm hM G)] with ξ hξ
    rw [inner_self_eq_norm_sq_to_K (𝕜 := ℂ), hξ, norm_mul]
    rw [RCLike.ofReal_mul, mul_pow]
    simp
  rw [h2, integral_complex_ofReal] at h1
  exact_mod_cast h1

/-- Modulation by `e(c y)` translates the Fourier transform on the line. -/
theorem fourier_modulation_real (f : ℝ → ℂ) (c ξ : ℝ) :

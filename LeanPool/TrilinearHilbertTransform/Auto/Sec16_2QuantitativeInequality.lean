/-- A downstream use certificate determines the color of its group. -/
theorem cert_color {k : ℕ} {G : bf.Grp} {I : ℤ × ℤ} (h : fp.Cert k G I) : G.1 = k := by
  obtain ⟨u, -, -, x, -, -, hc, hg⟩ := h
  rw [← hg]
  exact hc

open Classical in
/-- Blueprint lem:whole-ranges ("group and label counts on paths"), with lem:masks: along the
path of a point, the main label of a ball range on a certified endpoint cell determines its group
among the groups of one color (the tags of a label agree along a path, and pad masks of distinct
groups of one color on overlapping certified endpoints are separated). Hence the group-label
pairs of the ball ranges at a point number at most the main labels on its path. -/
theorem card_ballPairs_le (l : Fin 4) (s : List (CatCol bf.Vtx)) (d : bf.Vtx) {ι : Type*}
    [Fintype ι] (grp : ι → bf.Grp) (hgrp : Function.Injective grp) (k : ℕ)
    (hcol : ∀ G, (grp G).1 = k) (j : ℕ) (hPH : fp.bbase j + fp.P ≤ fp.Hmax) (y : ℝ) :
    ((Finset.univ : Finset (ι × (bf.Lab ⊕ Fin fp.Mc))).filter fun q =>
      ∃ I ∈ A.cells, (∃ k', fp.Cert k' (grp q.1) I) ∧ ∃ p : Fin fp.P,
        y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ mainLabelsM A.G fp.Mc (bf.origCols l) s I (fp.brank j)
          (fp.bmask I (grp q.1) j (p + 1)) d).card ≤
      ((Finset.univ : Finset (bf.Lab ⊕ Fin fp.Mc)).filter fun v =>
        ∃ I ∈ A.cells, y ∈ dyadicGridCell A.G I.1 I.2 ∧
          v ∈ mainLabels A.G fp.Mc (bf.origCols l) s I (fp.brank j)).card := by
  refine Finset.card_le_card_of_injOn (fun q => q.2) (fun q hq => ?_) (fun q hq q' hq' heq => ?_)
  · obtain ⟨-, I, hI, -, p, hy, hv⟩ := Finset.mem_filter.mp hq
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, I, hI, hy, (Finset.mem_filter.mp hv).1⟩
  obtain ⟨-, I, hI, ⟨k₁, hc₁⟩, p, hy, hv⟩ := Finset.mem_filter.mp (Finset.mem_coe.mp hq)
  obtain ⟨-, I', hI', ⟨k₂, hc₂⟩, p', hy', hv'⟩ := Finset.mem_filter.mp (Finset.mem_coe.mp hq')
  have hk₁ : k₁ = k := (fp.cert_color hc₁).symm.trans (hcol _)
  have hk₂ : k₂ = k := (fp.cert_color hc₂).symm.trans (hcol _)
  rw [hk₁] at hc₁
  rw [hk₂] at hc₂
  have heq' : q.2 = q'.2 := heq
  refine Prod.ext ?_ heq'
  by_contra hne
  have hG : grp q.1 ≠ grp q'.1 := hgrp.ne hne
  obtain ⟨hvL, hvM⟩ := Finset.mem_filter.mp hv
  obtain ⟨hvL', hvM'⟩ := Finset.mem_filter.mp hv'
  rw [← heq'] at hvL' hvM'
  have hp := p.2
  have hp' := p'.2
  have hh : fp.bbase j + (p + 1) ≤ fp.Hmax := by omega
  have hh' : fp.bbase j + (p' + 1) ≤ fp.Hmax := by omega
  rcases le_total I.1 I'.1 with hle | hle
  · rcases dyadicGridCell_nested_or_disjoint_of_le A.G hle I.2 I'.2 with hd | hsub
    · exact Set.disjoint_right.mp hd hy' hy
    · rw [bf.labelTag_eq_of_sub l s d hI hI' hsub hvL] at hvM'
      exact fp.endpoint_sep hG hI hI' hsub hc₁ hc₂ hh hh' hvM hvM'
        (by rw [(bf.tagDist fp.Hed).self]; exact zero_le)
  · rcases dyadicGridCell_nested_or_disjoint_of_le A.G hle I'.2 I.2 with hd | hsub
    · exact Set.disjoint_right.mp hd hy hy'
    · rw [bf.labelTag_eq_of_sub l s d hI' hI hsub hvL'] at hvM
      exact fp.endpoint_sep (Ne.symm hG) hI' hI hsub hc₂ hc₁ hh' hh hvM' hvM
        (by rw [(bf.tagDist fp.Hed).self]; exact zero_le)

end ActiveSetup.BasicFamilies.FamParams

/-- A count of list entries whose key lies in a finite set of keys is at most the sum of the
counts of the single keys. -/
theorem length_filter_le_sum_keys {α β : Type*} [DecidableEq β] (t : List α) (key : α → β)
    (P : α → Bool) (T : Finset β) (hT : ∀ a ∈ t, P a = true → key a ∈ T) :
    (t.filter P).length ≤ ∑ b ∈ T, (t.filter (fun a => decide (key a = b))).length := by
  induction t with
  | nil => simp
  | cons a t ih =>
    have ih' := ih (fun x hx => hT x (List.mem_cons_of_mem a hx))
    by_cases hP : P a = true
    · have hk := hT a List.mem_cons_self hP
      rw [List.filter_cons_of_pos hP, List.length_cons]
      have e : ∀ b, ((a :: t).filter (fun x => decide (key x = b))).length =
          (t.filter (fun x => decide (key x = b))).length + if key a = b then 1 else 0 := by
        intro b
        by_cases h : key a = b
        · rw [List.filter_cons_of_pos (by simpa using h), List.length_cons, ite_eq_left h]
        · rw [List.filter_cons_of_neg (by simpa using h), ite_eq_right h, Nat.add_zero]
      rw [Finset.sum_congr rfl fun b _ => e b, Finset.sum_add_distrib, Finset.sum_ite_eq]
      rw [ite_eq_left hk]
      omega
    · rw [List.filter_cons_of_neg hP]
      refine ih'.trans (Finset.sum_le_sum fun b _ => ?_)
      exact List.Sublist.length_le (List.Sublist.filter _ (List.sublist_cons_self a t))

namespace ActiveSetup.BasicFamilies
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} (bf : A.BasicFamilies)

open Classical in
/-- The template path count is the number of templates whose birth cell contains the point. -/
theorem tmplPath_eq_filter (s : List (CatCol bf.Vtx)) (y : ℝ) :
    bf.tmplPath s y =
      (s.filter (fun e => decide (y ∈ dyadicGridCell A.G e.birth.1 e.birth.2))).length := by
  unfold tmplPath
  convert card_range_filter_getElem s (fun e => y ∈ dyadicGridCell A.G e.birth.1 e.birth.2)

open Classical in
/-- Template path counts are additive under appending catalogs. -/
theorem tmplPath_append (s t : List (CatCol bf.Vtx)) (y : ℝ) :
    bf.tmplPath (s ++ t) y = bf.tmplPath s y + bf.tmplPath t y := by
  rw [tmplPath_eq_filter, tmplPath_eq_filter, tmplPath_eq_filter, List.filter_append,
    List.length_append]

open Classical in
/-- The main labels at a cell are at most two column budgets of original columns and the
templates whose birth cell contains the left end of the cell. -/
theorem card_mainLabels_le_tmpl (l : Fin 4) {Mc : ℕ} (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ)
    (r : ℕ) : ((mainLabels A.G Mc (bf.origCols l) s I r).card : ℝ) ≤
      2 * A.colBudget + bf.tmplPath s (dyadicGridLeft A.G I.1 I.2) := by
  set X : Finset bf.Lab := Finset.univ.filter fun x => (bf.origCols l).avail I x
  set Y : Finset (Fin Mc) := Finset.univ.filter fun n => ∃ h : (n : ℕ) < s.length,
    dyadicGridLeft A.G I.1 I.2 ∈ dyadicGridCell A.G (s[(n : ℕ)]).birth.1 (s[(n : ℕ)]).birth.2
  have hsub : mainLabels A.G Mc (bf.origCols l) s I r ⊆ X.disjSum Y := by
    rintro (x | n) hv
    · exact Finset.inl_mem_disjSum.mpr
        (Finset.mem_filter.mpr ⟨Finset.mem_univ _, mem_mainLabels.mp hv⟩)
    · obtain ⟨hn, hIb, -⟩ := (mem_mainLabels.mp hv :
        ∃ hn : (n : ℕ) < s.length, dyadicGridCell A.G I.1 I.2 ⊆
          dyadicGridCell A.G (s[(n : ℕ)]).birth.1 (s[(n : ℕ)]).birth.2 ∧ (s[(n : ℕ)]).rank ≤ r)
      exact Finset.inr_mem_disjSum.mpr (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hn,
        hIb (dyadicGridCell_left_mem A.G I.1 I.2)⟩)
  have hY : Y.card ≤ bf.tmplPath s (dyadicGridLeft A.G I.1 I.2) := by
    unfold tmplPath
    refine Finset.card_le_card_of_injOn (fun n => (n : ℕ)) (fun n hn => ?_)
      (fun n _ n' _ h => Fin.ext h)
    obtain ⟨-, h, hy⟩ := Finset.mem_filter.mp hn
    exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr h, h, hy⟩
  have hX : (X.card : ℝ) ≤ 2 * A.colBudget := bf.card_avail_le l I
  calc _ ≤ ((X.disjSum Y).card : ℝ) := Nat.cast_le.mpr (Finset.card_le_card hsub)
    _ = X.card + Y.card := by rw [Finset.card_disjSum]; push_cast; ring
    _ ≤ _ := by
        have : (Y.card : ℝ) ≤ bf.tmplPath s (dyadicGridLeft A.G I.1 I.2) := Nat.cast_le.mpr hY
        linarith only [hX, this]

open Classical in
/-- The templates of a catalog born on a family of cells with at most `M_p` members containing
each point and at most `n_b` templates born at each cell have path counts at most `M_p n_b`. -/
theorem tmplPath_le_of_births (t : List (CatCol bf.Vtx)) (Tc : Finset (ℤ × ℤ))
    (hb : ∀ e ∈ t, e.birth ∈ Tc) {Mp : ℕ} {nb : ℝ} (hnb : 0 ≤ nb)
    (hM : ∀ y, (Tc.filter fun I => y ∈ dyadicGridCell A.G I.1 I.2).card ≤ Mp)
    (hn : ∀ J ∈ Tc, ((t.filter (fun e => decide (e.birth = J))).length : ℝ) ≤ nb) (y : ℝ) :
    (bf.tmplPath t y : ℝ) ≤ Mp * nb := by
  rw [tmplPath_eq_filter]
  have h := length_filter_le_sum_keys t (fun e => e.birth)
    (fun e => decide (y ∈ dyadicGridCell A.G e.birth.1 e.birth.2))
    (Tc.filter fun I => y ∈ dyadicGridCell A.G I.1 I.2)
    (fun e he hy => Finset.mem_filter.mpr ⟨hb e he, by simpa using hy⟩)
  calc ((t.filter _).length : ℝ) ≤ ∑ J ∈ Tc.filter (fun I => y ∈ dyadicGridCell A.G I.1 I.2),
        ((t.filter (fun e => decide (e.birth = J))).length : ℝ) := by exact_mod_cast h
    _ ≤ ∑ _J ∈ Tc.filter (fun I => y ∈ dyadicGridCell A.G I.1 I.2), nb :=
        Finset.sum_le_sum fun J hJ => hn J (Finset.mem_filter.mp hJ).1
    _ = (Tc.filter fun I => y ∈ dyadicGridCell A.G I.1 I.2).card * nb := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ Mp * nb := mul_le_mul_of_nonneg_right (by exact_mod_cast hM y) hnb

end ActiveSetup.BasicFamilies

/-- The dyadic thresholds `2^j` in `[ε, U]` (with `j` between `⌊log₂ ε⌋` and `⌈log₂ U⌉`) that are at
least `D⁻¹`. -/
noncomputable def dyThr (ε U Dst : ℝ) : Finset ℝ :=
  ((Finset.Icc ⌊Real.logb 2 ε⌋ ⌈Real.logb 2 U⌉).image fun j : ℤ => (2 : ℝ) ^ j).filter
    fun σ => Dst⁻¹ ≤ σ

/-- The dyadic thresholds between `ε` and `U` above `D⁻¹` form a nonempty set containing every
such power of two, with at most `log₂ U - log₂ ε + 3` elements. -/
theorem dyThr_spec {ε U Dst : ℝ} (hε : 0 < ε) (hεU : ε ≤ U) (hUD : Dst⁻¹ ≤ U) :
    (dyThr ε U Dst).Nonempty ∧ (∀ σ ∈ dyThr ε U Dst, Dst⁻¹ ≤ σ) ∧
    (∀ σ, ε ≤ σ → σ ≤ U → (∃ k : ℤ, σ = (2 : ℝ) ^ k) → Dst⁻¹ ≤ σ → σ ∈ dyThr ε U Dst) ∧
    ((dyThr ε U Dst).card : ℝ) ≤ Real.logb 2 U - Real.logb 2 ε + 3 := by
  have hU : 0 < U := lt_of_lt_of_le hε hεU
  have hpow : ∀ x : ℝ, 0 < x → x ≤ (2 : ℝ) ^ ⌈Real.logb 2 x⌉ := by
    intro x hx
    rw [← Real.rpow_intCast]
    calc x = (2 : ℝ) ^ Real.logb 2 x := (Real.rpow_logb (by norm_num) (by norm_num) hx).symm
      _ ≤ (2 : ℝ) ^ (⌈Real.logb 2 x⌉ : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le (by norm_num) (Int.le_ceil _)
  have hlog : Real.logb 2 ε ≤ Real.logb 2 U := Real.logb_le_logb_of_le (by norm_num) hε hεU
  refine ⟨⟨(2 : ℝ) ^ ⌈Real.logb 2 U⌉, Finset.mem_filter.mpr ⟨Finset.mem_image.mpr
    ⟨⌈Real.logb 2 U⌉, Finset.mem_Icc.mpr ⟨(Int.floor_le_ceil _).trans (Int.ceil_mono hlog),
      le_rfl⟩, rfl⟩, hUD.trans (hpow U hU)⟩⟩, fun σ hσ => (Finset.mem_filter.mp hσ).2,
    fun σ hεσ hσU ⟨j, hj⟩ hDσ => ?_, ?_⟩
  · subst hj
    have h2 : Real.logb 2 ((2 : ℝ) ^ j) = j := by
      rw [← Real.rpow_intCast, Real.logb_rpow (by norm_num) (by norm_num)]
    have hσ0 : 0 < (2 : ℝ) ^ j := zpow_pos (by norm_num) j
    refine Finset.mem_filter.mpr ⟨Finset.mem_image.mpr ⟨j, Finset.mem_Icc.mpr ⟨?_, ?_⟩, rfl⟩, hDσ⟩
    · have := Real.logb_le_logb_of_le (b := 2) (by norm_num) hε hεσ
      rw [h2] at this
      exact (Int.floor_mono this).trans (Int.floor_intCast j).le
    · have := Real.logb_le_logb_of_le (b := 2) (by norm_num) hσ0 hσU
      rw [h2] at this
      exact (Int.ceil_intCast j).symm.le.trans (Int.ceil_mono this)
  · calc ((dyThr ε U Dst).card : ℝ) ≤ (Finset.Icc ⌊Real.logb 2 ε⌋ ⌈Real.logb 2 U⌉).card := by
          exact_mod_cast (Finset.card_filter_le _ _).trans Finset.card_image_le
      _ = ((⌈Real.logb 2 U⌉ + 1 - ⌊Real.logb 2 ε⌋).toNat : ℝ) := by rw [Int.card_Icc]
      _ ≤ Real.logb 2 U - Real.logb 2 ε + 3 := by
          have h1 := Int.ceil_lt_add_one (Real.logb 2 U)
          have h2 := Int.sub_one_lt_floor (Real.logb 2 ε)
          have h3 : (0 : ℤ) ≤ ⌈Real.logb 2 U⌉ + 1 - ⌊Real.logb 2 ε⌋ := by
            have := (Int.floor_le_ceil (Real.logb 2 ε)).trans (Int.ceil_mono hlog)
            omega
          rw [show ((⌈Real.logb 2 U⌉ + 1 - ⌊Real.logb 2 ε⌋).toNat : ℝ) =
            ((⌈Real.logb 2 U⌉ + 1 - ⌊Real.logb 2 ε⌋ : ℤ) : ℝ) by
              exact_mod_cast Int.toNat_of_nonneg h3]
          push_cast
          linarith only [h1, h2]

/-- The joint path cap `T_c` of the side estimate on the side states (`SideInput.Tside`) as an
explicit function of the block length `K`, the basic `U` slot `u` and the number of pads `P`. -/
noncomputable def TsideF {κ : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ c₀) (P K : ℕ)
    (u : Option (Fin 4)) (Lp Jm : ℕ) (CF E : ℝ) (cc : ℕ) (kk : ℝ) (Vl : Fin 4 → ℝ) (ρ : ℝ) : ℝ :=
  let R := dyadicGridLength A.G A.R.1
  let C₀ := 2 * Real.sqrt CF
  let B₀ := max (2 * Real.sqrt CF) A.S
  let G0 := Real.exp ((4096 * (cc + 1) * (1024 * (cc + 1) + cc + 7) + cc ^ 2 + 3) *
    (1 + Real.log (2 * kk)) ^ 2)
  let BU := 4 * E * R
  let Bs := ∑ l, if u = some l then 2 * BU else
    2 * ((K : ℝ) * (20 * G0 + 32) * R) + 2 * ((K : ℝ) * (Vl l * R))
  let Bv := G0 * (4 * R)
  let frz := C₀ ^ 2 * ((64 + 8 * (K : ℝ)) * ((K : ℝ) * Bv + (P : ℝ) * ((K : ℝ) * Bv)) +
    (1 + (K : ℝ)) * ((K : ℝ) * Bv))
  let L0 := localFormUniformConstant κ
  let B3 := 2 * (36 * 256 * 256 * ((Lp : ℝ) ^ 2 * (2 * (1 + 5 * (Jm : ℝ))) *
      ((Lp : ℝ) ^ 2 * (L0 ^ 2 * (8 * B₀ ^ 2 * BU)) +
        (2 / (P : ℝ) * L0) ^ 2 * 6 * ((Lp : ℝ) * Lp * ((Jm : ℝ) * 5) * frz)))) +
    2 * (36 * 256 * 256 * (2 * (L0 * B₀) ^ 2 * Bs +
      (Lp : ℝ) ^ 2 * (2 * (1 + 5 * (Jm : ℝ))) * ((2 / (P : ℝ) * L0) ^ 2 * 6 *
        ((Lp : ℝ) * Lp * ((Jm : ℝ) * 5) * frz))))
  (Bs / R + B3 / R) / ρ

namespace ActiveSetup.BasicFamilies.FamParams.SideInput
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams} (D : fp.SideInput)

/-- The side cap of a side input is its explicit form. -/
theorem Tside_eq_F (qG : bf.Grp → ℕ) (Lp Jm : ℕ) (CF E : ℝ) (cc : ℕ) (kk : ℝ) (Vl : Fin 4 → ℝ)
    (ρ : ℝ) : D.Tside qG Lp Jm CF E cc kk Vl ρ =
      TsideF A fp.P D.S.K D.u Lp Jm CF E cc kk Vl ρ := rfl

end ActiveSetup.BasicFamilies.FamParams.SideInput


/-- The private weights of a column tree are at most the squared budget: the private coordinate
is a component of the column value, which the budget bounds on the birth cell. -/
theorem ColumnTreeData.privateWeight_le {V : Type*} [Fintype V] (D : ColumnTreeData V) (v : V) :
    D.privateWeight v ≤ D.budget ^ 2 := by
  have hne : volume (dyadicGridCell D.grid (D.birth v).1 (D.birth v).2) ≠ 0 := by
    rw [dyadicGridCell_volume]
    exact (ENNReal.ofReal_pos.mpr (dyadicGridLength_pos _ _)).ne'
  have := ae_restrict_neBot.mpr hne
  obtain ⟨y, hy⟩ := (D.column_bound v).exists
  have h := norm_privateColumnValue_sq D.scalar D.privateWeight v y (D.privateWeight_pos v).le
  have hb := pow_le_pow_left₀ (norm_nonneg _) hy 2
  have := sq_nonneg ‖D.scalar v y‖
  linarith only [h, hb, this]

/-- The main weights of the attempt are at most `colBudget²`. -/
theorem ActiveSetup.BasicFamilies.mainWeight_le {κ : LocalKernelClass} {c₀ : ℕ}
    {A : ActiveSetup κ c₀} (bf : A.BasicFamilies) (Mc : ℕ) (l : Fin 4) (Φ : bf.Lab ⊕ Fin Mc) :
    mainWeight Mc (bf.origCols l) Φ ≤ A.colBudget ^ 2 := by
  have hcb := A.two_le_colBudget
  rcases Φ with x | n
  · change (bf.P x.1 x.2.1).Ψ.D.privateWeight x.2.2 ≤ A.colBudget ^ 2
    refine ((bf.P x.1 x.2.1).Ψ.D.privateWeight_le x.2.2).trans ?_
    exact pow_le_pow_left₀ (le_trans (by norm_num) (bf.P x.1 x.2.1).Ψ.D.two_le_budget)
      (bf.budget x.1 x.2.1) 2
  · change (1 : ℝ) ≤ A.colBudget ^ 2
    nlinarith only [hcb]

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc)

/-- The augmented mode of a cell has squared norm at most `(1 + ε_m) |J|`. -/
theorem norm_cellMode_sq_le (J : ℤ × ℤ) (m : Ms.Md) :
    ‖Ms.cellMode J m‖ ^ 2 ≤ (1 + Ms.L.εM m) * dyadicGridLength Gd J.1 := by
  have h := augMode_memLp (dyadicGridCell_measurable Gd J.1 J.2)
    (dyadicGridCell_volume_ne_top Gd J) (Ms.wave_measurable m) (Ms.wave_norm_le m) (Ms.L.εM m) m
  have hε := Ms.L.εM_nonneg m
  have hle : ∀ y, ‖augMode (dyadicGridCell Gd J.1 J.2) (Ms.wave m) (Ms.L.εM m) m y‖ ^ 2 ≤
      (dyadicGridCell Gd J.1 J.2).indicator (fun _ => 1 + Ms.L.εM m) y := by
    intro y
    by_cases hy : y ∈ dyadicGridCell Gd J.1 J.2
    · rw [Set.indicator_of_mem hy]
      simp only [augMode, Set.indicator_of_mem hy]
      rw [EuclideanSpace.norm_sq_eq, Fintype.sum_option]
      simp only [PiLp.add_apply, PiLp.smul_apply, PiLp.single_apply, smul_eq_mul]
      simp
      have hs : ∑ x : Ms.Md, ‖(if x = m then ((Real.sqrt (Ms.L.εM m) : ℝ) : ℂ) else 0)‖ ^ 2 =
          Ms.L.εM m := by
        rw [Finset.sum_eq_single m (fun b _ hb => by simp [hb]) (by simp)]
        simp [Real.sq_sqrt hε]
      have h1 := Ms.wave_norm_le m y
      have h2 : ‖Ms.wave m y‖ ^ 2 ≤ 1 := by
        have := norm_nonneg (Ms.wave m y)
        nlinarith only [h1, this]
      linarith only [hs, h2]
    · simp [augMode, hy]
  unfold cellMode
  rw [columnInput_norm_sq_integral]
  calc ∫ y, ‖(h.toLp _ : ℝ → ColumnHilbert Ms.Md) y‖ ^ 2
      = ∫ y, ‖augMode (dyadicGridCell Gd J.1 J.2) (Ms.wave m) (Ms.L.εM m) m y‖ ^ 2 := by
        refine integral_congr_ae ?_
        filter_upwards [h.coeFn_toLp] with y hy
        rw [hy]
    _ ≤ ∫ y, (dyadicGridCell Gd J.1 J.2).indicator (fun _ => 1 + Ms.L.εM m) y :=
        integral_mono_of_nonneg (Filter.Eventually.of_forall fun y => by positivity)
          ((integrableOn_const (dyadicGridCell_volume_ne_top Gd J)).integrable_indicator
            (dyadicGridCell_measurable Gd J.1 J.2)) (Filter.Eventually.of_forall hle)
    _ = (1 + Ms.L.εM m) * dyadicGridLength Gd J.1 := by
        rw [integral_indicator (dyadicGridCell_measurable Gd J.1 J.2), setIntegral_const,
          smul_eq_mul, mul_comm]
        congr 1
        rw [Measure.real, dyadicGridCell_volume,
          ENNReal.toReal_ofReal (dyadicGridLength_pos Gd J.1).le]

end ModeSystem

namespace ActiveSetup.BasicFamilies.FamParams.SideInput
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams} (D : fp.SideInput)

open Classical in
/-- The component sizes of `eq:component-size` are at most `(√(1 + W) + 1) D_* √C_c` when the
private weights of the modes are at most `W`, the coefficients of the alive modes have squared
sum at most `C_c` and at most `D_*` modes are alive. -/
theorem clsSize_le (G : bf.Grp) (I : ℤ × ℤ) (j : Fin 4) (F : Finset (D.Ms j G).Md) {Cc W : ℝ}
    (hW0 : 0 ≤ W) (hW : ∀ m, (D.Ms j G).L.εM m ≤ W)
    (hcc : ∑ m ∈ (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K)),
      ‖D.c j G (A.blkStart D.S.K I.1) (D.preAt I) m‖ ^ 2 ≤ Cc)
    (hal : (((D.Ms j G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card : ℝ) ≤ D.S.Dstar) (hD : 1 ≤ D.S.Dstar) :
    D.clsSize G I j F ≤ (Real.sqrt (1 + W) + 1) * D.S.Dstar * Real.sqrt Cc := by
  set Al := (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K)) with hAl
  set c := D.c j G (A.blkStart D.S.K I.1) (D.preAt I) with hc
  have hr := dyadicGridLength_pos A.G I.1
  have hsr := Real.sqrt_pos.mpr hr
  have hCc : 0 ≤ Cc := le_trans (Finset.sum_nonneg fun m _ => sq_nonneg _) hcc
  have hD0 : 0 ≤ D.S.Dstar := le_trans zero_le_one hD
  -- the coefficient sum over the alive modes
  set! Sc := ∑ m ∈ Al, ‖c m‖ with hSc
  have hSc0 : 0 ≤ Sc := Finset.sum_nonneg fun m _ => norm_nonneg _
  have hS1 : Sc ≤ Real.sqrt D.S.Dstar * Real.sqrt Cc := by
    have h := sq_sum_le_card_mul_sum_sq (s := Al) (f := fun m => ‖c m‖)
    rw [← Real.sqrt_mul hD0]
    refine Real.le_sqrt_of_sq_le (h.trans ?_)
    exact mul_le_mul hal hcc (Finset.sum_nonneg fun m _ => sq_nonneg _) hD0
  -- the modes
  have hcm : ∀ m, ‖(D.Ms j G).cellMode I m‖ ≤ Real.sqrt (1 + W) * Real.sqrt (dyadicGridLength
      A.G I.1) := by
    intro m
    rw [← Real.sqrt_mul (by linarith only [hW0])]
    refine Real.le_sqrt_of_sq_le ((ModeSystem.norm_cellMode_sq_le _ I m).trans ?_)
    exact mul_le_mul_of_nonneg_right (by linarith [hW m]) hr.le
  -- every unit
  set! X := (Real.sqrt (1 + W) + 1) * Sc with hX
  have hX0 : 0 ≤ X := mul_nonneg (by positivity) hSc0
  have hunit : ∀ U ∈ D.clsUnits G I j F, D.unitSizeSq G I j U ≤ X ^ 2 := by
    intro U hU
    obtain ⟨y, -, rfl⟩ := Finset.mem_image.mp hU
    set! Uc := ((((D.Ms j G).blockComps D.S D.hA (A.blkStart D.S.K I.1) (D.preAt I)).F 0 y).map
      ⟨Subtype.val, Subtype.val_injective⟩).filter
        ((D.Ms j G).IsCoreAt D.S D.hA D.SP (A.blkStart D.S.K I.1) (D.preAt I)) with hUc
    have hsub : Uc ⊆ Al := by
      intro m hm
      obtain ⟨x, -, rfl⟩ := Finset.mem_map.mp (Finset.mem_filter.mp hm).1
      exact x.2
    have hsum : ∑ m ∈ Uc, ‖c m‖ ≤ Sc :=
      Finset.sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ => norm_nonneg _
    have hnorm : ‖∑ m ∈ Uc, c m • (D.Ms j G).cellMode I m‖ ≤
        Real.sqrt (1 + W) * Real.sqrt (dyadicGridLength A.G I.1) * ∑ m ∈ Uc, ‖c m‖ := by
      refine (norm_sum_le _ _).trans ?_
      rw [Finset.mul_sum]
      refine Finset.sum_le_sum fun m _ => ?_
      rw [norm_smul, mul_comm]
      exact mul_le_mul_of_nonneg_right (hcm m) (norm_nonneg _)
    have h1 : ‖∑ m ∈ Uc, c m • (D.Ms j G).cellMode I m‖ /
        Real.sqrt (dyadicGridLength A.G I.1) ≤ Real.sqrt (1 + W) * Sc := by
      rw [div_le_iff₀ hsr]
      calc _ ≤ Real.sqrt (1 + W) * Real.sqrt (dyadicGridLength A.G I.1) * ∑ m ∈ Uc, ‖c m‖ :=
            hnorm
        _ ≤ Real.sqrt (1 + W) * Real.sqrt (dyadicGridLength A.G I.1) * Sc :=
            mul_le_mul_of_nonneg_left hsum (by positivity)
        _ = _ := by ring
    have h2 : (D.S.Dstar ^ 30)⁻¹ * ∑ m ∈ Uc, ‖c m‖ ≤ Sc := by
      have : (D.S.Dstar ^ 30)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (one_le_pow₀ hD)
      calc _ ≤ 1 * ∑ m ∈ Uc, ‖c m‖ :=
            mul_le_mul_of_nonneg_right this (Finset.sum_nonneg fun _ _ => norm_nonneg _)
        _ ≤ Sc := by rw [one_mul]; exact hsum
    have h0 : 0 ≤ ‖∑ m ∈ Uc, c m • (D.Ms j G).cellMode I m‖ /
        Real.sqrt (dyadicGridLength A.G I.1) + (D.S.Dstar ^ 30)⁻¹ * ∑ m ∈ Uc, ‖c m‖ := by
      positivity
    change (‖∑ m ∈ Uc, c m • (D.Ms j G).cellMode I m‖ / Real.sqrt (dyadicGridLength A.G I.1) +
      (D.S.Dstar ^ 30)⁻¹ * ∑ m ∈ Uc, ‖c m‖) ^ 2 ≤ X ^ 2
    refine pow_le_pow_left₀ h0 ?_ 2
    rw [hX]
    linarith only [h1, h2]
  -- the number of units
  have hcard : ((D.clsUnits G I j F).card : ℝ) ≤ D.S.Dstar := by
    refine le_trans ?_ hal
    unfold clsUnits
    refine Nat.cast_le.mpr (Finset.card_image_le.trans ((Finset.card_filter_le _ _).trans ?_))
    rw [Finset.card_univ, Fintype.card_coe]
  unfold clsSize
  calc Real.sqrt (∑ U ∈ D.clsUnits G I j F, D.unitSizeSq G I j U)
      ≤ Real.sqrt (D.S.Dstar * X ^ 2) := by
        refine Real.sqrt_le_sqrt ((Finset.sum_le_sum hunit).trans ?_)
        rw [Finset.sum_const, nsmul_eq_mul]
        exact mul_le_mul_of_nonneg_right hcard (sq_nonneg _)
    _ = Real.sqrt D.S.Dstar * X := by
        rw [Real.sqrt_mul hD0, Real.sqrt_sq hX0]
    _ ≤ Real.sqrt D.S.Dstar * ((Real.sqrt (1 + W) + 1) *
          (Real.sqrt D.S.Dstar * Real.sqrt Cc)) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hS1 (by positivity))
          (Real.sqrt_nonneg _)
    _ = (Real.sqrt (1 + W) + 1) * D.S.Dstar * Real.sqrt Cc := by
        have := Real.mul_self_sqrt hD0
        calc Real.sqrt D.S.Dstar * ((Real.sqrt (1 + W) + 1) * (Real.sqrt D.S.Dstar * Real.sqrt Cc))
            = (Real.sqrt (1 + W) + 1) * (Real.sqrt D.S.Dstar * Real.sqrt D.S.Dstar) *
              Real.sqrt Cc := by ring
          _ = _ := by rw [this]

end ActiveSetup.BasicFamilies.FamParams.SideInput

/-- The catalog threshold of rank `r` times the column budget and the path count of rank `r - 1`
is at most `τ₃` when the vertex bound dominates the column budget. -/
theorem catThreshold_mul_le {Dv : ℕ} {τ₃ cb : ℝ} (n : ℕ → ℝ) (r : ℕ) (hτ : 0 ≤ τ₃)
    (hcb : 0 < cb) (hDv : cb ≤ Dv) (hn : 0 < n (r - 1)) :
    catThreshold Dv τ₃ n r * (cb * Real.sqrt (n (r - 1))) ≤ τ₃ := by
  unfold catThreshold
  have hs := Real.sqrt_pos.mpr hn
  have hDv0 : 0 < (Dv : ℝ) := lt_of_lt_of_le hcb hDv
  rw [div_mul_eq_mul_div, div_le_iff₀ (mul_pos hDv0 hs)]
  exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hDv hs.le) hτ

/-- A dyadic exponent below a number at least one: `2^⌊log₂ x⌋ ≤ x < 2^(⌊log₂ x⌋ + 1)`. -/
theorem two_pow_floor_logb {x : ℝ} (hx : 1 ≤ x) :
    (2 : ℝ) ^ ⌊Real.logb 2 x⌋₊ ≤ x ∧ x < (2 : ℝ) ^ (⌊Real.logb 2 x⌋₊ + 1) := by
  have hx0 : 0 < x := lt_of_lt_of_le one_pos hx
  have hl : 0 ≤ Real.logb 2 x := Real.logb_nonneg (by norm_num) hx
  have e : x = (2 : ℝ) ^ Real.logb 2 x := (Real.rpow_logb (by norm_num) (by norm_num) hx0).symm
  constructor
  · rw [← Real.rpow_natCast]
    calc (2 : ℝ) ^ ((⌊Real.logb 2 x⌋₊ : ℕ) : ℝ) ≤ (2 : ℝ) ^ Real.logb 2 x :=
          Real.rpow_le_rpow_of_exponent_le (by norm_num) (Nat.floor_le hl)
      _ = x := e.symm
  · rw [← Real.rpow_natCast]
    calc x = (2 : ℝ) ^ Real.logb 2 x := e
      _ < (2 : ℝ) ^ (((⌊Real.logb 2 x⌋₊ + 1 : ℕ) : ℕ) : ℝ) := by
          refine Real.rpow_lt_rpow_of_exponent_lt (by norm_num) ?_
          push_cast
          exact Nat.lt_floor_add_one _

/-- The side height step of the schedule of an attempt: `4 (2 δ_*)^{1/4} < 1` at `δ_* = 1/1024`. -/
theorem four_two_delta_quarter_lt_one : 4 * (2 * (1 / 1024 : ℝ)) ^ (1 / (4 : ℝ)) < 1 := by
  have h1 : (2 * (1 / 1024 : ℝ)) < (1 / 4) ^ (4 : ℝ) := by norm_num
  have h2 : (2 * (1 / 1024 : ℝ)) ^ (1 / (4 : ℝ)) < ((1 / 4 : ℝ) ^ (4 : ℝ)) ^ (1 / (4 : ℝ)) :=
    Real.rpow_lt_rpow (by norm_num) h1 (by norm_num)
  rw [← Real.rpow_mul (by norm_num)] at h2
  norm_num at h2
  linarith only [h2]

/-- The upper height threshold of the schedule of an attempt: `⌈4 δ_* J⌉ ≤ J` at `δ_* = 1/1024`. -/
theorem ceil_four_delta_le (J : ℕ) : ⌈4 * (1 / 1024 : ℝ) * J⌉₊ ≤ J :=
  Nat.ceil_le.mpr (by
    have : (0 : ℝ) ≤ J := Nat.cast_nonneg J
    linarith only)

namespace ActiveSetup.BasicFamilies.FamParams.SideInput
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams} (D : fp.SideInput)

open Classical in
/-- The core components of a slot at a cell number at most the alive modes of its pre-cell, and
each of them consists of alive modes. -/
theorem compsAt_card_sub (l : Fin 4) (G : bf.Grp) (I : ℤ × ℤ) :
    (D.compsAt l G I).card ≤ ((D.Ms l G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card ∧
    ∀ K ∈ D.compsAt l G I, K ⊆ (D.Ms l G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K)) := by
  unfold compsAt
  split_ifs with h
  · unfold ModeSystem.coreComps ModeSystem.allComps
    refine ⟨(Finset.card_le_card Finset.sdiff_subset).trans (Finset.card_image_le.trans ?_),
      fun K hK => ?_⟩
    · rw [Finset.card_univ, Fintype.card_coe]
    · obtain ⟨x, -, rfl⟩ := Finset.mem_image.mp (Finset.mem_sdiff.mp hK).1
      intro m hm
      obtain ⟨y, -, rfl⟩ := Finset.mem_map.mp hm
      exact y.2
  · exact ⟨by simp, fun K hK => by simp at hK⟩

open Classical in
/-- The coefficient sum of a core component is at most `√D_* √C_c` when the coefficients of the
alive modes have squared sum at most `C_c` and at most `D_*` modes are alive. -/
theorem compSum_le (l : Fin 4) (G : bf.Grp) (I : ℤ × ℤ) {Cc : ℝ}
    (hcc : ∑ m ∈ (D.Ms l G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K)),
      ‖D.c l G (A.blkStart D.S.K I.1) (D.preAt I) m‖ ^ 2 ≤ Cc)
    (hal : (((D.Ms l G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card : ℝ) ≤ D.S.Dstar) (hD : 0 ≤ D.S.Dstar)
    {K : Finset (D.Ms l G).Md} (hK : K ∈ D.compsAt l G I) :
    ∑ m ∈ K, ‖D.c l G (A.blkStart D.S.K I.1) (D.preAt I) m‖ ≤
      Real.sqrt D.S.Dstar * Real.sqrt Cc := by
  have hsub := (D.compsAt_card_sub l G I).2 K hK
  refine (Finset.sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ => norm_nonneg _).trans ?_
  have h := sq_sum_le_card_mul_sum_sq (s := (D.Ms l G).alive (ancAt A.G (D.preAt I)
    (A.blkStart D.S.K I.1 - 4 * D.S.K))) (f := fun m =>
      ‖D.c l G (A.blkStart D.S.K I.1) (D.preAt I) m‖)
  rw [← Real.sqrt_mul hD]
  refine Real.le_sqrt_of_sq_le (h.trans ?_)
  exact mul_le_mul hal hcc (Finset.sum_nonneg fun m _ => sq_nonneg _) hD

open Classical in
/-- The four-core tuple errors at a cell are at most `C D_*^{-100} (D_* √D_* √C_c)⁴`. -/
theorem fourErr_le (J : ℕ) (G : bf.Grp) (I : ℤ × ℤ) {Cc : ℝ}
    (hD : 1 ≤ D.S.Dstar)
    (hcc : ∀ l, D.compsAt l G I ≠ ∅ → ∑ m ∈ (D.Ms l G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K)), ‖D.c l G (A.blkStart D.S.K I.1) (D.preAt I) m‖ ^ 2 ≤ Cc)
    (hal : ∀ l, (((D.Ms l G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card : ℝ) ≤ D.S.Dstar) :
    D.fourErr J G I ≤ fourErrC κ J * (D.S.Dstar ^ 100)⁻¹ *
      (D.S.Dstar * (Real.sqrt D.S.Dstar * Real.sqrt Cc)) ^ 4 := by
  have hD0 : 0 ≤ D.S.Dstar := le_trans zero_le_one hD
  have hC0 := fourErrC_nonneg κ J
  have hB0 : 0 ≤ Real.sqrt D.S.Dstar * Real.sqrt Cc := by positivity
  unfold fourErr
  by_cases hne : ∀ l, D.compsAt l G I ≠ ∅
  · set B := Real.sqrt D.S.Dstar * Real.sqrt Cc
    have hterm : ∀ r ∈ Fintype.piFinset (compIdx (fun _ => 0) (fun l => D.compsAt l G I)),
        fourErrC κ J * (D.S.Dstar ^ 100)⁻¹ * ∏ l, (r l).elim 1
          (fun K => ∑ m ∈ K, ‖D.c l G (A.blkStart D.S.K I.1) (D.preAt I) m‖) ≤
        fourErrC κ J * (D.S.Dstar ^ 100)⁻¹ * B ^ 4 := by
      intro r hr
      refine mul_le_mul_of_nonneg_left ?_ (by positivity)
      rw [show B ^ 4 = ∏ _l : Fin 4, B by simp]
      refine Finset.prod_le_prod₀ (fun l _ => D.elim_coefSum_nonneg (r l)) fun l _ => ?_
      have hrl := Fintype.mem_piFinset.mp hr l
      simp only [compIdx, ite_true] at hrl
      obtain ⟨K, hK, hKr⟩ := Finset.mem_map.mp hrl
      rw [← hKr]
      exact D.compSum_le l G I (hcc l (hne l)) (hal l) hD0 hK
    refine (Finset.sum_le_sum hterm).trans ?_
    rw [Finset.sum_const, nsmul_eq_mul]
    have hcard : ((Fintype.piFinset (compIdx (fun _ => 0) (fun l => D.compsAt l G I))).card : ℝ)
        ≤ D.S.Dstar ^ 4 := by
      rw [Fintype.card_piFinset]
      push_cast
      rw [show D.S.Dstar ^ 4 = ∏ _l : Fin 4, D.S.Dstar by simp]
      refine Finset.prod_le_prod₀ (fun _ _ => Nat.cast_nonneg _) fun l _ => ?_
      simp only [compIdx, ite_true, Finset.card_map]
      exact (Nat.cast_le.mpr (D.compsAt_card_sub l G I).1).trans (hal l)
    calc ((Fintype.piFinset (compIdx (fun _ => 0) (fun l => D.compsAt l G I))).card : ℝ) *
          (fourErrC κ J * (D.S.Dstar ^ 100)⁻¹ * B ^ 4)
        ≤ D.S.Dstar ^ 4 * (fourErrC κ J * (D.S.Dstar ^ 100)⁻¹ * B ^ 4) :=
          mul_le_mul_of_nonneg_right hcard (by positivity)
      _ = _ := by ring
  · push Not at hne
    obtain ⟨l, hl⟩ := hne
    have he : Fintype.piFinset (compIdx (fun _ => 0) (fun l => D.compsAt l G I)) = ∅ := by
      rw [Fintype.piFinset_eq_empty]
      exact ⟨l, by simp [compIdx, hl]⟩
    rw [he, Finset.sum_empty]
    positivity

open Classical in
/-- The three-core tuple errors at a cell are at most `C D_*^{-100} U_s (D_* (√D_* √C_c + 1))⁴`
when the normalized size of the side slot is at most `U_s`. -/
theorem threeErr_le (J Aw : ℕ) (l : Fin 4) (G : bf.Grp) (I : ℤ × ℤ) {Cc Us : ℝ}
    (hD : 1 ≤ D.S.Dstar)
    (hcc : ∀ l, D.compsAt l G I ≠ ∅ → ∑ m ∈ (D.Ms l G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K)), ‖D.c l G (A.blkStart D.S.K I.1) (D.preAt I) m‖ ^ 2 ≤ Cc)
    (hal : ∀ l, (((D.Ms l G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card : ℝ) ≤ D.S.Dstar)
    (hUs : Real.sqrt ((dyadicGridLength A.G I.1)⁻¹ *
        ∫ y in (dyadicGridLeft A.G I.1 I.2)..dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1,
          ‖augPhys (D.toLeaf.sv l G I) y‖ ^ 2) ≤ Us) :
    D.threeErr J Aw l G I ≤ threeErrC κ J Aw * (D.S.Dstar ^ 100)⁻¹ * Us *
      (D.S.Dstar * (Real.sqrt D.S.Dstar * Real.sqrt Cc + 1)) ^ 4 := by
  have hD0 : 0 ≤ D.S.Dstar := le_trans zero_le_one hD
  have hC0 := threeErrC_nonneg κ J Aw
  have hUs0 : 0 ≤ Us := le_trans (Real.sqrt_nonneg _) hUs
  set B := Real.sqrt D.S.Dstar * Real.sqrt Cc + 1
  have hB1 : 1 ≤ B := by
    have : 0 ≤ Real.sqrt D.S.Dstar * Real.sqrt Cc := by positivity
    linarith only [this]
  unfold threeErr
  have hterm : ∀ r ∈ Fintype.piFinset (compIdx (fun k => if k = l then 1 else 0)
      (fun l => D.compsAt l G I)),
      threeErrC κ J Aw * (D.S.Dstar ^ 100)⁻¹ *
        Real.sqrt ((dyadicGridLength A.G I.1)⁻¹ * ∫ y in (dyadicGridLeft A.G I.1 I.2)..
          dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1,
            ‖augPhys (D.toLeaf.sv l G I) y‖ ^ 2) *
        ∏ k, (r k).elim 1 (fun K => ∑ m ∈ K, ‖D.c k G (A.blkStart D.S.K I.1) (D.preAt I) m‖) ≤
      threeErrC κ J Aw * (D.S.Dstar ^ 100)⁻¹ * Us * B ^ 4 := by
    intro r hr
    refine mul_le_mul (mul_le_mul_of_nonneg_left hUs (by positivity)) ?_
      (Finset.prod_nonneg fun k _ => D.elim_coefSum_nonneg (r k)) (by positivity)
    rw [show B ^ 4 = ∏ _k : Fin 4, B by simp]
    refine Finset.prod_le_prod₀ (fun k _ => D.elim_coefSum_nonneg (r k)) fun k _ => ?_
    rcases hrk : r k with _ | K
    · exact hB1
    · have hmem := Fintype.mem_piFinset.mp hr k
      rw [hrk] at hmem
      by_cases hkl : k = l
      · simp [compIdx, hkl] at hmem
      · simp only [compIdx, hkl, ↓reduceIte, Fin.isValue, Finset.mem_map,
          Function.Embedding.some_apply, Option.some.injEq, exists_eq_right] at hmem
        have hne : D.compsAt k G I ≠ ∅ := Finset.ne_empty_of_mem hmem
        exact (D.compSum_le k G I (hcc k hne) (hal k) hD0 hmem).trans (by linarith only)
  refine (Finset.sum_le_sum hterm).trans ?_
  rw [Finset.sum_const, nsmul_eq_mul]
  have hcard : ((Fintype.piFinset (compIdx (fun k => if k = l then 1 else 0)
      (fun l => D.compsAt l G I))).card : ℝ) ≤ D.S.Dstar ^ 4 := by
    rw [Fintype.card_piFinset]
    push_cast
    rw [show D.S.Dstar ^ 4 = ∏ _k : Fin 4, D.S.Dstar by simp]
    refine Finset.prod_le_prod₀ (fun _ _ => Nat.cast_nonneg _) fun k _ => ?_
    by_cases hkl : k = l
    · simp [compIdx, hkl, hD]
    · simp only [compIdx, hkl, ite_false, ite_true, Finset.card_map]
      exact (Nat.cast_le.mpr (D.compsAt_card_sub k G I).1).trans (hal k)
  calc ((Fintype.piFinset (compIdx (fun k => if k = l then 1 else 0)
        (fun l => D.compsAt l G I))).card : ℝ) *
        (threeErrC κ J Aw * (D.S.Dstar ^ 100)⁻¹ * Us * B ^ 4)
      ≤ D.S.Dstar ^ 4 * (threeErrC κ J Aw * (D.S.Dstar ^ 100)⁻¹ * Us * B ^ 4) :=
        mul_le_mul_of_nonneg_right hcard (by positivity)
    _ = _ := by ring

end ActiveSetup.BasicFamilies.FamParams.SideInput

/-- `SideInput.T2` as an explicit function of the block length `K` and the `U` slot `u`. -/
noncomputable def T2F (K : ℕ) (u : Option (Fin 4)) (cc : ℕ) (kk : ℝ) (Vl : Fin 4 → ℝ)
    (ρ₂ : ℝ) : ℝ :=
  (∑ l, if u = some l then 0 else
    ((K : ℝ) * (20 * Real.exp ((4096 * (cc + 1) * (1024 * (cc + 1) + cc + 7) + cc ^ 2 + 3) *
      (1 + Real.log (2 * kk)) ^ 2) + 32) + (K : ℝ) * Vl l)) / ρ₂

/-- `SideLeafM.nearBnd` of a leaf as an explicit function of the block length `K`, the `U` slot
`u` and the number of pads `P`. -/
noncomputable def nearBndF (κ : LocalKernelClass) {c₀ : ℕ} (A : ActiveSetup κ c₀) {q : ℝ}
    (hq2 : 2 < q) (hq3 : q < 3) (P K : ℕ) (u : Option (Fin 4)) (Nd N Lp Jm : ℕ) (Mp C₀ ρ : ℝ)
    (Γa Γb : Fin 4 → ℝ) (ΓU : ℝ) (a b e : Fin 4) : ℝ :=
  if a ≠ b ∧ a ≠ e ∧ b ≠ e ∧ u ≠ some a then
    (if u = some b then
      4 * (nbCUM κ hq2 hq3 * (1 + finiteDepthConstant κ q Nd) *
          (1 + Real.log ((K : ℝ) + 2)) * ((K : ℝ) + 2) ^ (2 * (q - 2) / (q - 1)) *
          (64 * (2 * C₀) * (2 * C₀))) *
        (hullCutConstant (ρ / 2) * (N + 1 : ℕ) * (1 + Real.log (2 + ((N + 1 : ℕ) : ℝ) *
          ((1 : ℕ) : ℝ) * ((ActiveSetup.BasicFamilies.FamParams.SideLeafM.nOs Lp Jm).card * Mp *
            A.famVtxBound)))) *
        Real.sqrt (Γa a * ΓU) / Real.sqrt P * dyadicGridLength A.G A.R.1
    else
      4 * (nbCM κ hq2 hq3 * (1 + finiteDepthConstant κ q Nd) *
          (1 + Real.log ((K : ℝ) + 2)) * ((K : ℝ) + 2) ^ (2 * (q - 2) / (q - 1)) *
          (64 * (2 * C₀) * (2 * C₀))) *
        (hullCutConstant (ρ / 2) * (N + 1 : ℕ) * (1 + Real.log (2 + ((N + 1 : ℕ) : ℝ) *
          ((N + 1 : ℕ) : ℝ) * ((ActiveSetup.BasicFamilies.FamParams.SideLeafM.nOs Lp Jm).card *
            Mp * A.famVtxBound)))) *
        Real.sqrt (Γa a * Γb b) / Real.sqrt P * dyadicGridLength A.G A.R.1)
  else 0

/-- The role types `[0, log₂ D_*]^{2·4}` of a schedule. -/
noncomputable def fourTypesF (S : ModeSchedule) : Finset (Fin 4 → ℕ × ℕ) :=
  Fintype.piFinset fun _ : Fin 4 => Finset.range (Nat.log 2 ⌊S.Dstar⌋₊ + 1) ×ˢ
    Finset.range (Nat.log 2 ⌊S.Dstar⌋₊ + 1)

/-- The four-core frequency constant of a schedule. -/
noncomputable def fourCcF (S : ModeSchedule) : ℝ :=
  16 / 3 * (3 * 10 ^ 11 : ℝ) ^ (1 / 4 : ℝ) *
    (32 * ((S.dmax : ℝ) + 5) ^ 4 * (Real.log (288 * (S.Dstar ^ 5 * S.H)) + Real.log 2 + 1)) ^
      (15 / 4 : ℝ) *
    (1 + (Real.log 2 + 2 * Real.log ((S.dmax : ℝ) + 1) + 1) / Real.log 2) ^ (1 / 4 : ℝ)

/-- `SideInput.coreM4` as an explicit function of the schedule. -/
noncomputable def coreM4F (κ : LocalKernelClass) (S : ModeSchedule) (δs : ℝ) (J : ℕ)
    (U ε K : ℝ) : ℝ :=
  (ModeComponents.upperHeights S.Jstar δs).card * (fourTypesF S).card *
    ((2 ^ 4 / (1 - 4 * (2 * δs) ^ (1 / (4 : ℝ))) * (fourKC κ J * 2 * 12 ^ 4)) ^
        (1 - (1 / 300 : ℝ) / 4) *
      (fourCcF S * K ^ (2 - (1 / 300 : ℝ) / 2)) *
      ((Real.logb 2 (U / ε) + 1) ^ 4 *
        ActiveSetup.BasicFamilies.FamParams.SideInput.bandC (1 - (1 / 300 : ℝ) / 4) J))

/-- `SideInput.coreM3` as an explicit function of the schedule. -/
noncomputable def coreM3F (κ : LocalKernelClass) (S : ModeSchedule) (δs : ℝ) (J Aw Iw : ℕ)
    (U ε K : ℝ) (l : Fin 4) : ℝ :=
  (ModeComponents.upperHeights S.Jstar δs).card *
    ((fourTypesF S).filter fun κ => κ l = (0, 0)).card *
    ((2 ^ 4 / (1 - 4 * (2 * δs) ^ (1 / (4 : ℝ))) * (8 * entryCU κ J Aw * 2 ^ (Aw + 4) * 12 ^ 3)) ^
        (1 - (1 / 300 : ℝ) / 4) *
      (fourCcF S * K ^ (2 - (1 / 300 : ℝ) / 2)) *
      ((Iw + 1) * ((Real.logb 2 (U / ε) + 1) ^ 4 *
        ActiveSetup.BasicFamilies.FamParams.SideInput.bandC (1 - (1 / 300 : ℝ) / 4) J)))

namespace ActiveSetup.BasicFamilies.FamParams.SideInput
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams} (D : fp.SideInput)

/-- The near-band bound of a leaf is its explicit form. -/
theorem nearBnd_eq_F (qG : bf.Grp → ℕ) {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) (Nd N Lp Jm : ℕ)
    (Mp C₀ ρ : ℝ) (Γa Γb : Fin 4 → ℝ) (ΓU : ℝ) (a b e : Fin 4) :
    (D.toLeafQ qG).nearBnd hq2 hq3 Nd N Lp Jm Mp C₀ ρ Γa Γb ΓU a b e =
      nearBndF κ A hq2 hq3 fp.P D.S.K D.u Nd N Lp Jm Mp C₀ ρ Γa Γb ΓU a b e := rfl

/-- The four-core bound of a side input is its explicit form in the schedule. -/
theorem coreM4_eq_F {δs : ℝ} (hSP : D.SP = D.S.sideParams δs) (J : ℕ) (U ε K : ℝ) :
    D.coreM4 J U ε K = coreM4F κ D.S δs J U ε K := by
  unfold coreM4 K1 fourCc multPoly ellPoly fourTypes
  rw [hSP]
  rfl

/-- The three-core bound of a side input is its explicit form in the schedule. -/
theorem coreM3_eq_F {δs : ℝ} (hSP : D.SP = D.S.sideParams δs) (J Aw Iw : ℕ) (U ε K : ℝ)
    (l : Fin 4) : D.coreM3 J Aw Iw U ε K l = coreM3F κ D.S δs J Aw Iw U ε K l := by
  unfold coreM3 K1 fourCc multPoly ellPoly threeTypes fourTypes
  rw [hSP]
  rfl

end ActiveSetup.BasicFamilies.FamParams.SideInput

/-- The inverses of the slot coefficients have rational height at most `3`. -/
theorem rationalHeight_inv_slotCoeff (l : Fin 4) :
    (rationalHeight ((slotCoeff l : ℚ)⁻¹) : ℝ) ≤ 3 := by
  fin_cases l <;> simp [slotCoeff, rationalHeight] <;> norm_num [Int.sign]

/-- The negated slot coefficients have rational height at most `3`. -/
theorem rationalHeight_neg_slotCoeff (l : Fin 4) :
    (rationalHeight (((-slotCoeff l : ℤ) : ℚ)) : ℝ) ≤ 3 := by
  fin_cases l <;> simp [slotCoeff, rationalHeight]

/-- The dimension bound `d_B = ⌈log max(H, padW)⌉` of the vertex tags of an active setup. -/
noncomputable def ActiveSetup.dBnd {κ : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ c₀) : ℕ :=
  ⌈Real.log (max A.H ActiveSetup.padW)⌉₊

namespace ActiveSetup.BasicFamilies
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} (bf : A.BasicFamilies)

/-- Every vertex tag has dimension at most `d_B` (`vchart_complexity`). -/
theorem vtag_dim_le (w : bf.Vtx) : (bf.vtag w).dim ≤ A.dBnd := by
  have h : ((bf.vtag w).dim : ℝ) ≤ Real.log (max A.H ActiveSetup.padW) :=
    (bf.vchart_complexity w).dimension
  exact Nat.cast_le.mp (h.trans (Nat.le_ceil _))

/-- The entries of every vertex tag matrix have rational height at most `18 (max H padW)²`. -/
theorem vtag_height_le (w : bf.Vtx) (a c : Fin (bf.vtag w).dim) :
    (rationalHeight ((bf.vtag w).C a c) : ℝ) ≤ 18 * max A.H ActiveSetup.padW ^ 2 := by
  have hm : (rationalHeight ((bf.vchart w).2.matrix a c) : ℝ) ≤ max A.H ActiveSetup.padW :=
    (bf.vchart_complexity w).height a c
  have e : (bf.vtag w).C a c = (slotCoeff w.1.1 : ℚ)⁻¹ * (bf.vchart w).2.matrix a c := rfl
  rw [e]
  refine (rationalHeight_mul_le _ _).trans ?_
  have h3 := rationalHeight_inv_slotCoeff w.1.1
  have h0 : (0 : ℝ) ≤ rationalHeight ((slotCoeff w.1.1 : ℚ)⁻¹) := Nat.cast_nonneg _
  have h0' : (0 : ℝ) ≤ rationalHeight ((bf.vchart w).2.matrix a c) := Nat.cast_nonneg _
  have : (rationalHeight ((slotCoeff w.1.1 : ℚ)⁻¹) : ℝ) *
      rationalHeight ((bf.vchart w).2.matrix a c) ≤ 3 * max A.H ActiveSetup.padW :=
    mul_le_mul h3 hm h0' (by norm_num)
  have h2 := pow_le_pow_left₀ (mul_nonneg h0 h0') this 2
  nlinarith only [h2]

/-- The entries of the rescaled vertex tag matrices `-c_l C` have chart height at most
`5832 (max H padW)⁴`. -/
theorem vtag_scaled_height_le (w : bf.Vtx) (l : Fin 4) (a c : Fin (bf.vtag w).dim) :
    (chartRationalHeight ((((-slotCoeff l : ℤ) : ℚ) • (bf.vtag w).C) a c) : ℝ) ≤
      5832 * max A.H ActiveSetup.padW ^ 4 := by
  have e : chartRationalHeight ((((-slotCoeff l : ℤ) : ℚ) • (bf.vtag w).C) a c) =
      rationalHeight ((((-slotCoeff l : ℤ) : ℚ)) * (bf.vtag w).C a c) := rfl
  rw [e]
  refine (rationalHeight_mul_le _ _).trans ?_
  have h3 := rationalHeight_neg_slotCoeff l
  have hm := bf.vtag_height_le w a c
  have h0 : (0 : ℝ) ≤ rationalHeight (((-slotCoeff l : ℤ) : ℚ)) := Nat.cast_nonneg _
  have h0' : (0 : ℝ) ≤ rationalHeight ((bf.vtag w).C a c) := Nat.cast_nonneg _
  have : (rationalHeight (((-slotCoeff l : ℤ) : ℚ)) : ℝ) * rationalHeight ((bf.vtag w).C a c) ≤
      3 * (18 * max A.H ActiveSetup.padW ^ 2) := mul_le_mul h3 hm h0' (by norm_num)
  have h2 := pow_le_pow_left₀ (mul_nonneg h0 h0') this 2
  nlinarith only [h2]

end ActiveSetup.BasicFamilies

open Classical in
/-- A family of cells with at most `M` members above each cell has at most `M` members containing
each point (the cells containing a point are the ancestors of the deepest one). -/
theorem card_cells_mem_le (G : RealDyadicGrid) (T : Finset (ℤ × ℤ)) {M : ℕ}
    (hM : ∀ I : ℤ × ℤ, (T.filter fun I' : ℤ × ℤ =>
      dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G I'.1 I'.2).card ≤ M) (y : ℝ) :
    (T.filter fun I => y ∈ dyadicGridCell G I.1 I.2).card ≤ M := by
  set F := T.filter fun I => y ∈ dyadicGridCell G I.1 I.2
  rcases F.eq_empty_or_nonempty with h | h
  · rw [h, Finset.card_empty]; exact Nat.zero_le _
  obtain ⟨I₀, hI₀, hmax⟩ := F.exists_max_image (fun I => I.1) h
  refine le_trans (Finset.card_le_card fun I hI => ?_) (hM I₀)
  obtain ⟨hIT, hyI⟩ := Finset.mem_filter.mp hI
  obtain ⟨-, hy₀⟩ := Finset.mem_filter.mp hI₀
  refine Finset.mem_filter.mpr ⟨hIT, ?_⟩
  rcases dyadicGridCell_nested_or_disjoint_of_le G (hmax I hI) I.2 I₀.2 with hd | hs
  · exact absurd hy₀ (Set.disjoint_left.mp hd hyI)
  · exact hs

open Classical in
/-- The uses of the groups of a family of cells: at a point, the pairs (group, cell containing the
point) with the group current at the cell number at most `M V` when at most `M` cells contain
the point and at most `V` groups are current at each cell. -/
theorem sum_card_uses_le {α : Type*} [DecidableEq α] (G : RealDyadicGrid) (S0 : Finset (ℤ × ℤ))
    (gs : ℤ × ℤ → Finset α) (gset : Finset α) (y : ℝ) {M V : ℕ}
    (hM : (S0.filter fun I => y ∈ dyadicGridCell G I.1 I.2).card ≤ M)
    (hV : ∀ I ∈ S0, (gs I).card ≤ V) :
    ∑ g ∈ gset, ((S0.filter fun I => g ∈ gs I).filter fun I =>
      y ∈ dyadicGridCell G I.1 I.2).card ≤ M * V := by
  have e : ∀ g ∈ gset, ((S0.filter fun I => g ∈ gs I).filter fun I =>
      y ∈ dyadicGridCell G I.1 I.2).card = (Finset.bipartiteAbove
        (fun g I => g ∈ gs I ∧ y ∈ dyadicGridCell G I.1 I.2) S0 g).card := by
    intro g _
    rw [Finset.filter_filter]
    rfl
  rw [Finset.sum_congr rfl e, Finset.sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow]
  calc ∑ I ∈ S0, (Finset.bipartiteBelow
        (fun g I => g ∈ gs I ∧ y ∈ dyadicGridCell G I.1 I.2) gset I).card
      ≤ ∑ I ∈ S0.filter (fun I => y ∈ dyadicGridCell G I.1 I.2), V := by
        rw [Finset.sum_filter]
        refine Finset.sum_le_sum fun I hI => ?_
        split_ifs with hy
        · refine le_trans (Finset.card_le_card fun g hg => ?_) (hV I hI)
          exact (Finset.mem_filter.mp hg).2.1
        · refine le_of_eq (Finset.card_eq_zero.mpr (Finset.filter_eq_empty_iff.mpr ?_))
          exact fun g _ h => hy h.2
    _ = (S0.filter (fun I => y ∈ dyadicGridCell G I.1 I.2)).card * V := by
        rw [Finset.sum_const, smul_eq_mul]
    _ ≤ M * V := Nat.mul_le_mul_right _ hM

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

/-- The groups of a cell at the color `k` have color `k`. -/
theorem groupsAt_color {I : ℤ × ℤ} {k : ℕ} {G : bf.Grp} (h : G ∈ fp.groupsAt I k) : G.1 = k := by
  obtain ⟨w, -, hk, rfl⟩ := fp.mem_groupsAt h
  exact hk

end ActiveSetup.BasicFamilies.FamParams

/-- The top height of a valid schedule is at most `log H`: `H > A₀^{10(J_*+1)} ≥ 6^{J_*}`. -/
theorem ModeSchedule.Valid.Jstar_le_log_H {S : ModeSchedule} {Cj CA CT CK : ℕ} {δs W : ℝ}
    (hV : S.Valid Cj CA CT CK δs W) (hCA : 1 ≤ CA) (hd2 : 2 ≤ S.dmax) (hD : 2 ≤ S.Dstar)
    (hB : 2 ≤ S.Bstar) (hQ : 1 ≤ S.Q0) : (S.Jstar : ℝ) ≤ Real.log S.H := by
  have hA6 := hV.six_le_A0 hCA hd2 hD hB
  have hC2 := hV.two_le_Cstar hd2 hD
  have hd1 : (1 : ℝ) ≤ S.dmax := by exact_mod_cast (show 1 ≤ S.dmax by omega)
  have hQ1 : (1 : ℝ) ≤ S.Q0 := by exact_mod_cast hQ
  have hΞ : (1 : ℝ) ≤ S.Ξ := one_le_pow₀ (by linarith only [hD])
  have hLh : (1 : ℝ) ≤ ModeSchedule.Lh S.Jstar := one_le_pow₀ (by norm_num)
  have hEh : (6 : ℝ) ^ (S.Jstar + 1) ≤ S.Eh S.Jstar :=
    pow_le_pow_left₀ (by norm_num) hA6 _
  have hEh1 : (1 : ℝ) ≤ S.Eh S.Jstar := le_trans (one_le_pow₀ (by norm_num)) hEh
  set X := S.dmax * S.Cstar * S.Eh S.Jstar * S.Bstar * ModeSchedule.Lh S.Jstar * S.Q0 * S.Ξ
    with hX
  have hXE : S.Eh S.Jstar ≤ X := by
    have h1 : (1 : ℝ) ≤ S.dmax * S.Cstar :=
      one_le_mul_of_one_le_of_one_le hd1 (by linarith only [hC2])
    have h2 : (1 : ℝ) ≤ S.Bstar * ModeSchedule.Lh S.Jstar * S.Q0 * S.Ξ :=
      one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le
        (one_le_mul_of_one_le_of_one_le (by linarith only [hB]) hLh) hQ1) hΞ
    calc S.Eh S.Jstar ≤ (S.dmax * S.Cstar) * S.Eh S.Jstar *
          (S.Bstar * ModeSchedule.Lh S.Jstar * S.Q0 * S.Ξ) := by
          have h0 : 0 ≤ S.Eh S.Jstar := by linarith only [hEh1]
          have := mul_le_mul h1 h2 zero_le_one (by linarith)
          nlinarith only [hEh1, this]
      _ = X := by rw [hX]; ring
  have hX1 : 1 ≤ X := hEh1.trans hXE
  have hX10 : X ≤ X ^ 10 := le_self_pow₀ hX1 (by norm_num)
  have hH : (6 : ℝ) ^ (S.Jstar + 1) < S.H := lt_of_le_of_lt (hEh.trans (hXE.trans hX10)) hV.H_gt
  have hH0 : 0 < S.H := lt_of_lt_of_le (by positivity) hH.le
  rw [Real.le_log_iff_exp_le hH0, ← Real.exp_one_pow]
  refine le_trans ?_ hH.le
  calc Real.exp 1 ^ S.Jstar ≤ 6 ^ S.Jstar :=
        pow_le_pow_left₀ (Real.exp_pos 1).le (by linarith only [Real.exp_one_lt_d9]) _
    _ ≤ 6 ^ (S.Jstar + 1) := pow_le_pow_right₀ (by norm_num) (Nat.le_succ _)

/-- A crude polynomial bound for the side cap `T_c` at `C_F = 1`, `S = 2`:
`T_c ≤ 10¹⁴ (1 + L₀)² L_p⁴ (1 + J_m)² (1 + K)² (G₀ + E + V₀ + 1) / ρ`. -/
theorem TsideF_le {κ : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ c₀) (P K : ℕ)
    (u : Option (Fin 4)) (Lp Jm : ℕ) {E : ℝ} (cc : ℕ) (kk : ℝ) (Vl : Fin 4 → ℝ) {ρ V0 : ℝ}
    (hS : A.S = 2) (hP : 1 ≤ P) (hLp : 1 ≤ Lp) (hE : 0 ≤ E) (hVl : ∀ l, 0 ≤ Vl l ∧ Vl l ≤ V0)
    (hρ : 0 < ρ) :
    TsideF A P K u Lp Jm 1 E cc kk Vl ρ ≤ 10 ^ 14 * (1 + localFormUniformConstant κ) ^ 2 *
      (Lp : ℝ) ^ 4 * (1 + (Jm : ℝ)) ^ 2 * (1 + (K : ℝ)) ^ 2 *
      (Real.exp ((4096 * (cc + 1) * (1024 * (cc + 1) + cc + 7) + cc ^ 2 + 3) *
        (1 + Real.log (2 * kk)) ^ 2) + E + V0 + 1) / ρ := by
  set G0 := Real.exp ((4096 * (cc + 1) * (1024 * (cc + 1) + cc + 7) + cc ^ 2 + 3) *
    (1 + Real.log (2 * kk)) ^ 2) with hG0
  set R := dyadicGridLength A.G A.R.1 with hR
  set L0 := localFormUniformConstant κ with hL0
  have hRp : 0 < R := dyadicGridLength_pos A.G A.R.1
  have hG1 : 1 ≤ G0 := Real.one_le_exp (by positivity)
  have hL00 : 0 ≤ L0 := localFormUniformConstant_nonneg κ
  have hV0 : 0 ≤ V0 := le_trans (hVl 0).1 (hVl 0).2
  have hK0 : (0 : ℝ) ≤ K := Nat.cast_nonneg K
  have hJ0 : (0 : ℝ) ≤ Jm := Nat.cast_nonneg Jm
  have hP1 : (1 : ℝ) ≤ P := by exact_mod_cast hP
  have hLp1 : (1 : ℝ) ≤ Lp := by exact_mod_cast hLp
  set W := G0 + E + V0 + 1 with hW
  have hW1 : 1 ≤ W := by linarith only [hE, hG1, hV0]
  have hEW : E ≤ W := by linarith only [hG1, hV0]
  have hGW : G0 ≤ W := by linarith only [hE, hV0]
  have hVW : V0 ≤ W := by linarith only [hE, hG1]
  have hWR : 0 ≤ W * R := by positivity
  -- the common factor
  set! Y := (1 + L0) ^ 2 * (Lp : ℝ) ^ 4 * (1 + (Jm : ℝ)) ^ 2 * (1 + (K : ℝ)) ^ 2 * W with hY
  have hL1 : 1 ≤ (1 + L0) ^ 2 := one_le_pow₀ (by linarith only [hL00])
  have hLL : L0 ^ 2 ≤ (1 + L0) ^ 2 := pow_le_pow_left₀ hL00 (by linarith only) 2
  have hLp4 : (1 : ℝ) ≤ (Lp : ℝ) ^ 4 := one_le_pow₀ hLp1
  have hLp24 : (Lp : ℝ) ^ 2 ≤ (Lp : ℝ) ^ 4 := pow_le_pow_right₀ hLp1 (by norm_num)
  have hJ1 : 1 ≤ (1 + (Jm : ℝ)) ^ 2 := one_le_pow₀ (by linarith only)
  have hJJ : 1 + (Jm : ℝ) ≤ (1 + (Jm : ℝ)) ^ 2 := le_self_pow₀ (by linarith only) (by norm_num)
  have hK1 : 1 ≤ (1 + (K : ℝ)) ^ 2 := one_le_pow₀ (by linarith only)
  have hKK : 1 + (K : ℝ) ≤ (1 + (K : ℝ)) ^ 2 := le_self_pow₀ (by linarith only) (by norm_num)
  have hY0 : 0 ≤ Y := by positivity
  -- `Y` dominates each of its factors times `W`
  have hYW : W ≤ Y := by
    have : (1 : ℝ) ≤ (1 + L0) ^ 2 * (Lp : ℝ) ^ 4 * (1 + (Jm : ℝ)) ^ 2 * (1 + (K : ℝ)) ^ 2 :=
      one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le
        (one_le_mul_of_one_le_of_one_le hL1 hLp4) hJ1) hK1
    have h := mul_le_mul_of_nonneg_right this (show 0 ≤ W by linarith only [hW1])
    rw [one_mul] at h
    exact h
  -- the side budget
  set! Bs := ∑ l : Fin 4, if u = some l then 2 * (4 * E * R) else
    2 * ((K : ℝ) * (20 * G0 + 32) * R) + 2 * ((K : ℝ) * (Vl l * R)) with hBs
  have hBs1 : Bs ≤ 4 * (200 * (1 + (K : ℝ)) * W * R) := by
    rw [hBs, show 4 * (200 * (1 + (K : ℝ)) * W * R) = ∑ _l : Fin 4, 200 * (1 + (K : ℝ)) * W * R
      by simp]
    refine Finset.sum_le_sum fun l _ => ?_
    have hv := hVl l
    split_ifs
    · have h1 : E * R ≤ W * R := mul_le_mul_of_nonneg_right hEW hRp.le
      have h2 : 0 ≤ (K : ℝ) * (W * R) := mul_nonneg hK0 hWR
      linarith only [h1, h2, hWR]
    · have h1 : (K : ℝ) * (20 * G0 + 32) * R ≤ (K : ℝ) * (52 * W) * R := by
        have : 20 * G0 + 32 ≤ 52 * W := by linarith only [hE, hG1, hV0]
        gcongr
      have h2 : (K : ℝ) * (Vl l * R) ≤ (K : ℝ) * (W * R) := by
        have : Vl l ≤ W := hv.2.trans hVW
        gcongr
      have h3 : 0 ≤ (K : ℝ) * (W * R) := mul_nonneg hK0 hWR
      linarith only [h1, h2, h3, hWR]
  have hBsY : Bs ≤ 800 * Y * R := by
    have h1 : (1 + (K : ℝ)) * W ≤ Y := by
      have : (1 : ℝ) ≤ (1 + L0) ^ 2 * (Lp : ℝ) ^ 4 * (1 + (Jm : ℝ)) ^ 2 * (1 + (K : ℝ)) :=
        by
          have := one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le
            (one_le_mul_of_one_le_of_one_le hL1 hLp4) hJ1) (show (1 : ℝ) ≤ 1 + K by linarith only)
          exact this
      have e : Y = (1 + L0) ^ 2 * (Lp : ℝ) ^ 4 * (1 + (Jm : ℝ)) ^ 2 * (1 + (K : ℝ)) *
          ((1 + (K : ℝ)) * W) := by rw [hY]; ring
      rw [e]

      hX1 hGX hGn0 hceil hce18
  have! hErr : 6642 * localFormUniformConstant κ * (2 * (30000 * B ^ 2 * G) +
      Real.sqrt (cT * B ^ 11 * G)) ^ 3 * (288 * Real.exp (4 * (k : ℝ) ^ cc) * Real.sqrt δ * R) +
      cE ≤

      η ^ (1 - (1 - (1 / 300 : ℝ) / 4)) * (dyadicGridLength Gd R.1 * M4) +
        ∑ I ∈ T, dyadicGridLength Gd I.1 * E4 I)
    (h3 : ∀ l, ∑ I ∈ T, dyadicGridLength Gd I.1 *
        min η (∑ g ∈ gs I, ‖F (fun k => if k = l then 1 else 0) I g‖) ≤
      η ^ (1 - (1 - (1 / 300 : ℝ) / 4)) * (dyadicGridLength Gd R.1 * M3 l) +
        ∑ I ∈ T, dyadicGridLength Gd I.1 * E3 l I) :
    ∑ I ∈ T, dyadicGridLength Gd I.1 * min η ‖∑ τ ∈ Finset.univ.filter
        (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧ 3 ≤ patternCount τ 0), ∑ g ∈ gs I, F τ I g‖ ≤
      η ^ (1 / 1200 : ℝ) * (dyadicGridLength Gd R.1 * (M4 + ∑ l, M3 l)) +
        ∑ I ∈ T, dyadicGridLength Gd I.1 * (E4 I + ∑ l, E3 l I) := by

/-- Blueprint lines 2873-2876: if `G₀ ≤ P^{1/8}`, `K + 2 ≤ C P^{C₅}` with `C ≥ 1`, `q ∈ (2, 3)`
and `2 C₅ (q-2)/(q-1) ≤ 1/8`, then `P^{-1/2} G₀ (K+2)^{2(q-2)/(q-1)} ≤ C P^{-1/4}`, and with
`P ≥ η^{-α}` this is at most `C η^{α/4}`. -/
theorem block_term_le {P G₀ K C C₅ q α η : ℝ} (hP1 : 1 ≤ P) (hG₀ : G₀ ≤ P ^ (1 / 8 : ℝ))
    (hK0 : 0 ≤ K) (hK : K + 2 ≤ C * P ^ C₅) (hC : 1 ≤ C) (hq2 : 2 < q)
    (hq3 : q < 3) (hq : 2 * C₅ * ((q - 2) / (q - 1)) ≤ 1 / 8) (hη0 : 0 < η)
    (hPη : η ^ (-α) ≤ P) :
    P ^ (-(1 / 2) : ℝ) * G₀ * (K + 2) ^ (2 * (q - 2) / (q - 1)) ≤ C * η ^ (α / 4) := by
  set e := 2 * (q - 2) / (q - 1) with he
  have he0 : 0 ≤ e := by rw [he]; apply div_nonneg <;> linarith
  have he1 : e ≤ 1 := by rw [he, div_le_one (by linarith only [hq2])]; linarith only [hq3]
  have hP0 : 0 < P := by linarith only [hP1]
  have hCe : (K + 2) ^ e ≤ C * P ^ (1 / 8 : ℝ) := by
    calc (K + 2) ^ e ≤ (C * P ^ C₅) ^ e := Real.rpow_le_rpow (by linarith only [hK0]) hK he0
      _ = C ^ e * P ^ (C₅ * e) := by
          rw [Real.mul_rpow (by linarith only [hC]) (by positivity), ← Real.rpow_mul hP0.le]
      _ ≤ C * P ^ (1 / 8 : ℝ) := by
          gcongr
          · exact Real.rpow_le_self_of_one_le hC he1
          · rw [he]; have : C₅ * (2 * (q - 2) / (q - 1)) = 2 * C₅ * ((q - 2) / (q - 1)) := by
              ring
            rw [this]; exact hq
  have h1 : P ^ (-(1 / 2) : ℝ) * G₀ * (K + 2) ^ e ≤
      P ^ (-(1 / 2) : ℝ) * P ^ (1 / 8 : ℝ) * (C * P ^ (1 / 8 : ℝ)) := by
    gcongr
  have h2 : P ^ (-(1 / 2) : ℝ) * P ^ (1 / 8 : ℝ) * (C * P ^ (1 / 8 : ℝ)) =
      C * P ^ (-(1 / 4) : ℝ) := by
    rw [mul_comm C, ← mul_assoc, ← Real.rpow_add hP0, ← Real.rpow_add hP0]; norm_num; ring
  have h3 : P ^ (-(1 / 4) : ℝ) ≤ η ^ (α / 4) := by
    have : (η ^ (-α)) ^ (-(1 / 4) : ℝ) = η ^ (α / 4) := by
      rw [← Real.rpow_mul hη0.le]; ring_nf
    rw [← this]
    exact Real.rpow_le_rpow_of_nonpos (by positivity) hPη (by norm_num)
  calc _ ≤ _ := h1
    _ = C * P ^ (-(1 / 4) : ℝ) := h2
    _ ≤ C * η ^ (α / 4) := mul_le_mul_of_nonneg_left h3 (by linarith only [hC])

/-- Blueprint `eq:active-final` from `eq:before-absorption` (lines 2851-2888): a retained-attempt
bound `C_q [η^ε P^{C₄} + (1 + C_N) P^{-1/2} G₀ (K+2)^{2(q-2)/(q-1)}] |R| + e` becomes
`C_q (2^{C₄} + C) η^{c_*} (1 + C_N) |R| + e` with `c_* = min(ε/2, α/4)`, for the choice
`α = ε/(4(C₄+1))`, `P = ⌈η^{-α}⌉` and parameters `G₀ ≤ P^{1/8}`, `K + 2 ≤ C P^{C₅}`. -/
theorem active_final_arith {ε C₄ C₅ q η Cq CN G₀ K C R e X : ℝ} (hε : 0 < ε) (hC₄ : 0 ≤ C₄)
    (hη0 : 0 < η) (hη1 : η ≤ 1) (hCq : 0 ≤ Cq) (hCN : 0 ≤ CN) (hR : 0 ≤ R)
    (hG₀ : G₀ ≤ (⌈η ^ (-(ε / (4 * (C₄ + 1))))⌉₊ : ℝ) ^ (1 / 8 : ℝ)) (hK0 : 0 ≤ K)
    (hK : K + 2 ≤ C * (⌈η ^ (-(ε / (4 * (C₄ + 1))))⌉₊ : ℝ) ^ C₅) (hC : 1 ≤ C)
    (hq2 : 2 < q) (hq3 : q < 3) (hq : 2 * C₅ * ((q - 2) / (q - 1)) ≤ 1 / 8)
    (hX : X ≤ Cq * (η ^ ε * (⌈η ^ (-(ε / (4 * (C₄ + 1))))⌉₊ : ℝ) ^ C₄ + (1 + CN) *
      ((⌈η ^ (-(ε / (4 * (C₄ + 1))))⌉₊ : ℝ) ^ (-(1 / 2) : ℝ) * G₀ *
        (K + 2) ^ (2 * (q - 2) / (q - 1)))) * R + e) :
    X ≤ Cq * (2 ^ C₄ + C) * η ^ (min (ε / 2) (ε / (4 * (C₄ + 1)) / 4)) * (1 + CN) * R + e := by
  set α := ε / (4 * (C₄ + 1)) with hα
  have hα0 : 0 ≤ α := by positivity
  set P : ℝ := (⌈η ^ (-α)⌉₊ : ℝ) with hP
  have hX1 : 1 ≤ η ^ (-α) :=
    Real.one_le_rpow_of_pos_of_le_one_of_nonpos hη0 hη1 (by linarith only [hα0])
  have hPη : η ^ (-α) ≤ P := Nat.le_ceil _
  have hP1 : 1 ≤ P := hX1.trans hPη
  have h1 := eta_power_P_le hε hC₄ hη0 hη1
  have h2 := block_term_le hP1 hG₀ hK0 hK hC hq2 hq3 hq hη0 hPη
  set c := min (ε / 2) (α / 4)
  have hc1 : η ^ (ε / 2) ≤ η ^ c := Real.rpow_le_rpow_of_exponent_ge hη0 hη1 (min_le_left _ _)
  have hc2 : η ^ (α / 4) ≤ η ^ c := Real.rpow_le_rpow_of_exponent_ge hη0 hη1 (min_le_right _ _)
  have hηc : 0 ≤ η ^ c := by positivity
  have hsum : η ^ ε * P ^ C₄ + (1 + CN) * (P ^ (-(1 / 2) : ℝ) * G₀ *
      (K + 2) ^ (2 * (q - 2) / (q - 1))) ≤ (2 ^ C₄ + C) * η ^ c * (1 + CN) := by
    have hCN1 : 1 ≤ 1 + CN := by linarith only [hCN]
    have h2c : 0 ≤ 2 ^ C₄ * η ^ c := by positivity
    calc _ ≤ 2 ^ C₄ * η ^ (ε / 2) + (1 + CN) * (C * η ^ (α / 4)) := by gcongr
      _ ≤ 2 ^ C₄ * η ^ c + (1 + CN) * (C * η ^ c) := by gcongr
      _ ≤ 2 ^ C₄ * η ^ c * (1 + CN) + (1 + CN) * (C * η ^ c) := by nlinarith only [hCN, h2c]
      _ = _ := by ring
  calc X ≤ _ := hX
    _ ≤ Cq * ((2 ^ C₄ + C) * η ^ c * (1 + CN)) * R + e := by gcongr
    _ = _ := by ring


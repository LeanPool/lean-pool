  have! this : (0 : ℝ) ≤ BN * A.colBudget ^ 2 := by positivity
  linarith only [this]

open Classical in
/-- Step `hτbN` of `leaf_estimate`, over the part of its context that it uses. -/
theorem leaf_estimate_hτbN :

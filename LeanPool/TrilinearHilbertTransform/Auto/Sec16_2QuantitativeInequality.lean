    exact sidePat_ne_zero l hl
  refine hcf.trans (hsub.trans ?_)
  have e : (1 - (1 - (1 / 300 : ℝ) / 4)) = 1 / 1200 := by norm_num
  rw [e] at h4 h3
  calc f (fun _ => 0) + ∑ l, f (sidePat l)
      ≤ (η ^ (1 / 1200 : ℝ) * (dyadicGridLength Gd R.1 * M4) +
          ∑ I ∈ T, dyadicGridLength Gd I.1 * E4 I) +

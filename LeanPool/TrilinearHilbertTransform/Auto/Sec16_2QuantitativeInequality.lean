        Real.exp (-kD))) * R + Cl * Real.exp (-(k : ℝ)) * R :=
    leaf_final_hErr κ Msch g cT cm ce ce2 cQ CΛ Cb Cl k cc hcc kD Mp V δ R S Iw U MV ε cE hce hR0

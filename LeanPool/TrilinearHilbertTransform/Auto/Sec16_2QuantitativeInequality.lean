  intro τ hτ
  obtain ⟨h2, h3⟩ := (Finset.mem_filter.mp hτ).2
  rcases core_pattern_cases τ h2 h3 with rfl | ⟨l, rfl⟩
  · exact Finset.mem_insert_self _ _
  · exact Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ (Finset.mem_univ l))


  set! K := max (max 1 Mt) Ks with hKdef
  rewrite [← hKdef] at ⊢
  have hK0 : 0 ≤ K := le_trans zero_le_one (le_trans (le_max_left _ _) (le_max_left _ _))
  have hΔ : D.SP.Δ = 10 := by rw [hSP]; rfl
  set! Ts := Finset.range (Nat.log 2 ⌊D.S.Dstar⌋₊ + 1) ×ˢ

theorem measurable_mulDiff₂ {G : Type*} [AddCommGroup G] [MeasurableSpace G] [MeasurableAdd₂ G]
    {g : G → ℂ} (hg : Measurable g) :
    Measurable (fun p : (G × G) × G => mulDiff (mulDiff g p.1.1) p.1.2 p.2) := by
  unfold mulDiff
  have h1 : Measurable (fun p : (G × G) × G => g p.2 * conj (g (p.2 + p.1.1))) :=
    (hg.comp measurable_snd).mul (Complex.continuous_conj.measurable.comp
      (hg.comp (measurable_snd.add (measurable_fst.comp measurable_fst))))
  have h2 : Measurable (fun p : (G × G) × G =>
      g (p.2 + p.1.2) * conj (g (p.2 + p.1.2 + p.1.1))) :=
    (hg.comp (measurable_snd.add (measurable_snd.comp measurable_fst))).mul
      (Complex.continuous_conj.measurable.comp (hg.comp ((measurable_snd.add
        (measurable_snd.comp measurable_fst)).add (measurable_fst.comp measurable_fst))))
  exact h1.mul (Complex.continuous_conj.measurable.comp h2)

theorem measurable_mulDiff₃ {G : Type*} [AddCommGroup G] [MeasurableSpace G] [MeasurableAdd₂ G]
    {g : G → ℂ} (hg : Measurable g) :
    Measurable (fun p : ((G × G) × G) × G =>
      mulDiff (mulDiff (mulDiff g p.1.1.1) p.1.1.2) p.1.2 p.2) := by

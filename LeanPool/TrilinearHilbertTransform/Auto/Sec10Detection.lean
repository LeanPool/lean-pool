/-- Integer dilations of the increments do not change the cube average when every nonzero
integer multiplication preserves the Haar probability (lem:von-neumann, line 1447). -/
theorem dilatedCube_eq_nested {G : Type*} [AddCommGroup G] [TopologicalSpace G]
    [IsTopologicalAddGroup G] [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G]
    (μ : Measure G) [IsProbabilityMeasure μ]
    (hdil : ∀ n : ℤ, n ≠ 0 → MeasurePreserving (fun h : G => n • h) μ μ)
    {g : G → ℂ} (hg : Measurable g) {a b c : ℤ} (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0) :
    dilatedCube μ g a b c =
      ∫ r, ∫ s, ∫ t, ∫ z, mulDiff (mulDiff (mulDiff g r) s) t z ∂μ ∂μ ∂μ ∂μ := by
  unfold dilatedCube
  rw [integral_comp_measurePreserving_self μ (hdil a ha) (measurable_cube_partial₁ μ hg b c)]
  congr 1; funext r
  rw [integral_comp_measurePreserving_self μ (hdil b hb) (measurable_cube_partial₂ μ hg r c)]
  congr 1; funext s
  rw [integral_comp_measurePreserving_self μ (hdil c hc) (measurable_cube_partial₃ μ hg r s)]

/-- lem:von-neumann, lines 1431–1447, on a compact abelian group whose nonzero integer
multiplications preserve the Haar probability: `|Λ|⁸ ≤ ‖R‖₂⁸ ‖g‖_{U³}⁸` for `|b|,|c| ≤ 1`. -/
theorem vonNeumann_group_U3 {G : Type*} [AddCommGroup G] [TopologicalSpace G]
    [IsTopologicalAddGroup G] [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G]
    (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    (hdil : ∀ n : ℤ, n ≠ 0 → MeasurePreserving (fun h : G => n • h) μ μ)
    {R g b c : G → ℂ} (hRm : Measurable R) (hgm : Measurable g) (hbm : Measurable b)
    (hcm : Measurable c) {MR Mg : ℝ} (hR : ∀ x, ‖R x‖ ≤ MR) (hg : ∀ x, ‖g x‖ ≤ Mg)
    (hb : ∀ x, ‖b x‖ ≤ 1) (hc : ∀ x, ‖c x‖ ≤ 1) {nR ng nb nc : ℤ} (h1 : ng ≠ nR)
    (h2 : ng ≠ nb) (h3 : ng ≠ nc) :
    ‖∫ t, ∫ x, R (x + nR • t) * g (x + ng • t) * b (x + nb • t) * c (x + nc • t) ∂μ ∂μ‖ ^ 8 ≤
      (∫ x, ‖R x‖ ^ 2 ∂μ) ^ 4 * gowersNorm μ 3 g ^ 8 := by
  have h := vonNeumann_group_bounded μ hRm hgm hbm hcm hR hg hb hc nR ng nb nc
  rw [dilatedCube_eq_nested μ hdil hgm (sub_ne_zero.mpr h1) (sub_ne_zero.mpr h2)
    (sub_ne_zero.mpr h3), ← cubeAverage_three_eq_nested μ hgm hg] at h
  have hp := gowersNorm_pow μ (j := 3) (by norm_num) g hgm hg
  norm_num at hp
  rw [hp]
  exact h

theorem addCircle_zsmul_surjective {T : ℝ} [Fact (0 < T)] {n : ℤ} (hn : n ≠ 0) :
    Function.Surjective (fun x : AddCircle T => n • x) := by
  intro x
  induction x using QuotientAddGroup.induction_on with
  | H y =>
    refine ⟨((y / n : ℝ) : AddCircle T), ?_⟩
    simp only
    rw [← AddCircle.coe_zsmul, zsmul_eq_mul]
    congr 1
    field_simp

theorem addCircle_zsmul_measurePreserving {T : ℝ} [Fact (0 < T)] {n : ℤ} (hn : n ≠ 0) :
    MeasurePreserving (fun x : AddCircle T => n • x) AddCircle.haarAddCircle
      AddCircle.haarAddCircle :=
  AddMonoidHom.measurePreserving (μ := AddCircle.haarAddCircle) (ν := AddCircle.haarAddCircle)
    (f := zsmulAddGroupHom n) (continuous_zsmul n) (addCircle_zsmul_surjective hn) rfl

section TorusSixteen

/-- Lifting a function supported in `[0,1)` to the torus of length `16`. -/
noncomputable def torusLift (F : ℝ → ℂ) : AddCircle (16 : ℝ) → ℂ := AddCircle.liftIoc 16 (-8) F

theorem torusLift_coe {F : ℝ → ℂ} {u : ℝ} (hu : u ∈ Set.Ioc (-8 : ℝ) 8) :
    torusLift F (u : AddCircle (16 : ℝ)) = F u :=
  AddCircle.liftIoc_coe_apply (by constructor <;> linarith [hu.1, hu.2])

/-- No wraparound: a nonzero lifted value at `u + s` with `u ∈ [0,1)` forces `s ∈ (-1,1)`. -/
theorem torusLift_ne_zero_shift {F : ℝ → ℂ} (hsupp : ∀ y, F y ≠ 0 → y ∈ Set.Ico (0 : ℝ) 1)
    {u s : ℝ} (hu : u ∈ Set.Ico (0 : ℝ) 1) (hs : s ∈ Set.Ioc (-8 : ℝ) 8)
    (h : torusLift F ((u + s : ℝ) : AddCircle (16 : ℝ)) ≠ 0) :
    |s| < 1 ∧ torusLift F ((u + s : ℝ) : AddCircle (16 : ℝ)) = F (u + s) := by
  set q := (AddCircle.equivIoc (16 : ℝ) (-8) ((u + s : ℝ) : AddCircle (16 : ℝ)) : ℝ) with hq
  have hqF : torusLift F ((u + s : ℝ) : AddCircle (16 : ℝ)) = F q := rfl
  have hq0 : q ∈ Set.Ico (0 : ℝ) 1 := hsupp q (by rw [← hqF]; exact h)
  have hqmem : q ∈ Set.Ioc (-8 : ℝ) (-8 + 16) :=
    (AddCircle.equivIoc (16 : ℝ) (-8) ((u + s : ℝ) : AddCircle (16 : ℝ))).2
  have hcq : ((q : ℝ) : AddCircle (16 : ℝ)) = ((u + s : ℝ) : AddCircle (16 : ℝ)) :=
    AddCircle.coe_equivIoc
  have hqs : q = u + s := by
    by_cases hus : u + s ≤ 8
    · exact (AddCircle.coe_eq_coe_iff_of_mem_Ioc (a := (-8 : ℝ)) hqmem
        (by constructor <;> linarith [hu.1, hs.1])).mp hcq
    · have := (AddCircle.coe_eq_coe_iff_of_mem_Ioc (a := (-1 : ℝ)) (p := (16 : ℝ))
        (x := q) (y := u + s) (by constructor <;> linarith [hq0.1, hq0.2])
        (by constructor <;> linarith [hu.2, hs.2])).mp hcq
      exact this
  refine ⟨?_, by rw [hqF, hqs]⟩
  rw [abs_lt]; constructor <;> linarith [hq0.1, hq0.2, hu.1, hu.2]

theorem coe_add_zsmul_circle (u s : ℝ) (n : ℤ) :
    ((u + (n : ℝ) * s : ℝ) : AddCircle (16 : ℝ)) =
      (u : AddCircle (16 : ℝ)) + n • (s : AddCircle (16 : ℝ)) := by
  rw [AddCircle.coe_add, ← AddCircle.coe_zsmul, zsmul_eq_mul]

/-- On the fundamental box the lifted progression product is the real one. -/
theorem torus_progression_product (F : Fin 4 → ℝ → ℂ)
    (hsupp : ∀ j y, F j y ≠ 0 → y ∈ Set.Ico (0 : ℝ) 1) {u s : ℝ}
    (hu : u ∈ Set.Ioc (-8 : ℝ) 8) (hs : s ∈ Set.Ioc (-8 : ℝ) 8) :
    ∏ j : Fin 4, torusLift (F j) ((u : AddCircle (16 : ℝ)) + ((j : ℕ) : ℤ) • (s : AddCircle
        (16 : ℝ))) =
      ∏ j : Fin 4, F j (u + (j : ℕ) * s) := by
  have hc : ∀ j : Fin 4, (u : AddCircle (16 : ℝ)) + ((j : ℕ) : ℤ) • (s : AddCircle (16 : ℝ)) =
      ((u + (j : ℕ) * s : ℝ) : AddCircle (16 : ℝ)) := fun j => by
    rw [← coe_add_zsmul_circle]; push_cast; rfl
  simp_rw [hc]
  by_cases h0 : F 0 u = 0
  · have hl : torusLift (F 0) ((u + ((0 : Fin 4) : ℕ) * s : ℝ) : AddCircle (16 : ℝ)) = 0 := by
      simp only [Fin.val_zero, Nat.cast_zero, zero_mul, add_zero]
      rw [torusLift_coe hu, h0]
    rw [Finset.prod_eq_zero (Finset.mem_univ 0) hl, Finset.prod_eq_zero (Finset.mem_univ 0)]
    simpa using h0
  have hu01 := hsupp 0 u h0
  by_cases h1 : torusLift (F 1) ((u + ((1 : Fin 4) : ℕ) * s : ℝ) : AddCircle (16 : ℝ)) = 0
  · rw [Finset.prod_eq_zero (Finset.mem_univ 1) h1, Finset.prod_eq_zero (Finset.mem_univ 1)]
    by_contra hne
    have hm := hsupp 1 _ hne
    simp only [Fin.val_one, Nat.cast_one, one_mul] at h1 hm
    rw [torusLift_coe (by constructor <;> linarith [hm.1, hm.2])] at h1
    exact hne (by simpa using h1)
  · have h1' : torusLift (F 1) ((u + s : ℝ) : AddCircle (16 : ℝ)) ≠ 0 := by
      simpa using h1
    obtain ⟨hs1, -⟩ := torusLift_ne_zero_shift (hsupp 1) hu01 hs h1'
    apply Finset.prod_congr rfl
    intro j _
    apply torusLift_coe
    have hj : ((j : ℕ) : ℝ) ≤ 3 := by
      have := j.isLt; exact_mod_cast (by omega : (j : ℕ) ≤ 3)
    have hj0 : (0 : ℝ) ≤ (j : ℕ) := Nat.cast_nonneg _
    have hjs : |((j : ℕ) : ℝ) * s| ≤ 3 := by
      rw [abs_mul, abs_of_nonneg hj0]
      exact (mul_le_mul hj hs1.le (abs_nonneg _) (by norm_num)).trans (by norm_num)
    rw [abs_le] at hjs
    constructor <;> linarith [hu01.1, hu01.2, hjs.1, hjs.2]

theorem integral_haarAddCircle_sixteen {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (φ : AddCircle (16 : ℝ) → E) :
    ∫ t, φ t ∂AddCircle.haarAddCircle = (16 : ℝ)⁻¹ • ∫ a in Set.Ioc (-8 : ℝ) 8, φ
        (a : AddCircle (16 : ℝ)) := by
  rw [AddCircle.integral_haarAddCircle, ← AddCircle.intervalIntegral_preimage (16 : ℝ) (-8),
    intervalIntegral.integral_of_le (by norm_num)]
  norm_num

/-- Blueprint lem:von-neumann, line 1429: the real progression integral of functions
supported in `[0,1)` is `16²` times the progression average on the torus of length `16`. -/
theorem real_progression_eq_torus (F : Fin 4 → ℝ → ℂ)
    (hsupp : ∀ j y, F j y ≠ 0 → y ∈ Set.Ico (0 : ℝ) 1) :
    ∫ s, ∫ u, ∏ j : Fin 4, F j (u + (j : ℕ) * s) =
      (256 : ℝ) • ∫ t, ∫ x, ∏ j : Fin 4, torusLift (F j) (x + ((j : ℕ) : ℤ) • t)
        ∂AddCircle.haarAddCircle ∂AddCircle.haarAddCircle := by
  have hpt : ∀ s ∈ Set.Ioc (-8 : ℝ) 8, ∀ u ∈ Set.Ioc (-8 : ℝ) 8,
      ∏ j : Fin 4, torusLift (F j) ((u : AddCircle (16 : ℝ)) + ((j : ℕ) : ℤ) •
        (s : AddCircle (16 : ℝ))) = ∏ j : Fin 4, F j (u + (j : ℕ) * s) :=
    fun s hs u hu => torus_progression_product F hsupp hu hs
  have hR : ∫ t, ∫ x, ∏ j : Fin 4, torusLift (F j) (x + ((j : ℕ) : ℤ) • t)
      ∂AddCircle.haarAddCircle ∂AddCircle.haarAddCircle =
      (16 : ℝ)⁻¹ • ∫ s in Set.Ioc (-8 : ℝ) 8, (16 : ℝ)⁻¹ •
        ∫ u in Set.Ioc (-8 : ℝ) 8, ∏ j : Fin 4, F j (u + (j : ℕ) * s) := by
    rw [integral_haarAddCircle_sixteen]
    congr 1
    refine setIntegral_congr_fun measurableSet_Ioc (fun s hs => ?_)
    rw [integral_haarAddCircle_sixteen]
    congr 1
    exact setIntegral_congr_fun measurableSet_Ioc (fun u hu => hpt s hs u hu)
  rw [hR]
  -- the real integral lives on the fundamental box
  have hzero : ∀ s u, ∏ j : Fin 4, F j (u + (j : ℕ) * s) ≠ 0 →
      u ∈ Set.Ico (0 : ℝ) 1 ∧ u + s ∈ Set.Ico (0 : ℝ) 1 := by
    intro s u h
    have h0 : F 0 (u + ((0 : Fin 4) : ℕ) * s) ≠ 0 := fun h0 =>
      h (Finset.prod_eq_zero (Finset.mem_univ 0) h0)
    have h1 : F 1 (u + ((1 : Fin 4) : ℕ) * s) ≠ 0 := fun h1 =>
      h (Finset.prod_eq_zero (Finset.mem_univ 1) h1)
    simp only [Fin.val_zero, Fin.val_one, Nat.cast_zero, Nat.cast_one, zero_mul, add_zero,
      one_mul] at h0 h1
    exact ⟨hsupp 0 u h0, hsupp 1 _ h1⟩
  have hinner : ∀ s, ∫ u, ∏ j : Fin 4, F j (u + (j : ℕ) * s) =
      ∫ u in Set.Ioc (-8 : ℝ) 8, ∏ j : Fin 4, F j (u + (j : ℕ) * s) := by
    intro s
    refine (setIntegral_eq_integral_of_forall_compl_eq_zero (fun u hu => ?_)).symm
    by_contra h
    obtain ⟨h0, -⟩ := hzero s u h
    exact hu ⟨by linarith [h0.1], by linarith [h0.2]⟩
  have houter : ∫ s, ∫ u in Set.Ioc (-8 : ℝ) 8, ∏ j : Fin 4, F j (u + (j : ℕ) * s) =
      ∫ s in Set.Ioc (-8 : ℝ) 8, ∫ u in Set.Ioc (-8 : ℝ) 8,
        ∏ j : Fin 4, F j (u + (j : ℕ) * s) := by
    refine (setIntegral_eq_integral_of_forall_compl_eq_zero (fun s hs => ?_)).symm
    apply setIntegral_eq_zero_of_forall_eq_zero
    intro u _
    by_contra h
    obtain ⟨h0, h1⟩ := hzero s u h
    exact hs ⟨by linarith [h0.1, h0.2, h1.1, h1.2], by linarith [h0.1, h0.2, h1.1, h1.2]⟩
  simp_rw [hinner]
  rw [houter, integral_smul, smul_smul, smul_smul]
  norm_num

end TorusSixteen

theorem prod_fin_four_perm {M : Type*} [CommMonoid M] (φ : Fin 4 → M) {a b c d : Fin 4}
    (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) :
    ∏ j, φ j = φ a * φ b * φ c * φ d := by
  have huniv : (Finset.univ : Finset (Fin 4)) = {a, b, c, d} := by
    symm
    apply Finset.eq_of_subset_of_card_le (Finset.subset_univ _)
    rw [Finset.card_univ, Fintype.card_fin, Finset.card_insert_of_notMem (by simp [hab, hac, had]),
      Finset.card_insert_of_notMem (by simp [hbc, hbd]), Finset.card_insert_of_notMem
          (by simp [hcd]),
      Finset.card_singleton]
  rw [huniv, Finset.prod_insert (by simp [hab, hac, had]), Finset.prod_insert (by simp [hbc, hbd]),
    Finset.prod_insert (by simp [hcd]), Finset.prod_singleton]
  simp only [mul_assoc]

section TorusSixteenBound

theorem measurable_torusLift {F : ℝ → ℂ} (hF : Measurable F) : Measurable (torusLift F) :=
  hF.comp (measurable_subtype_coe.comp (AddCircle.measurableEquivIoc (16 : ℝ) (-8)).measurable)

theorem norm_torusLift_le {F : ℝ → ℂ} {M : ℝ} (hF : ∀ y, ‖F y‖ ≤ M) (x : AddCircle (16 : ℝ)) :
    ‖torusLift F x‖ ≤ M := hF _

theorem integral_norm_sq_torusLift {F : ℝ → ℂ} (hsupp : ∀ y, F y ≠ 0 → y ∈ Set.Ico (0 : ℝ) 1) :
    ∫ x, ‖torusLift F x‖ ^ 2 ∂AddCircle.haarAddCircle = (16 : ℝ)⁻¹ * ∫ y, ‖F y‖ ^ 2 := by
  rw [integral_haarAddCircle_sixteen (fun x => ‖torusLift F x‖ ^ 2), smul_eq_mul,
    setIntegral_congr_fun measurableSet_Ioc (fun a ha => by rw [torusLift_coe ha])]
  congr 1
  refine setIntegral_eq_integral_of_forall_compl_eq_zero (fun y hy => ?_)
  by_contra h0
  have hF : F y ≠ 0 := fun h1 => h0 (by simp [h1])
  have := hsupp y hF
  exact hy ⟨by linarith [this.1], by linarith [this.2]⟩

theorem fin_cast_int_ne {a b : Fin 4} (h : a ≠ b) : ((a : ℕ) : ℤ) ≠ ((b : ℕ) : ℤ) := by
  intro h'; exact h (Fin.ext (by exact_mod_cast h'))

/-- One progression term on the unit cell: Plancherel-free von Neumann bound through the torus. -/
theorem progression_term_bound (F : Fin 4 → ℝ → ℂ) (hF : ∀ j, Measurable (F j))
    (hsupp : ∀ j y, F j y ≠ 0 → y ∈ Set.Ico (0 : ℝ) 1) {jR ig kb lc : Fin 4}
    (h1 : jR ≠ ig) (h2 : jR ≠ kb) (h3 : jR ≠ lc) (h4 : ig ≠ kb) (h5 : ig ≠ lc) (h6 : kb ≠ lc)
    {MR Mg : ℝ} (hR : ∀ y, ‖F jR y‖ ≤ MR) (hg : ∀ y, ‖F ig y‖ ≤ Mg) (hb : ∀ y, ‖F kb y‖ ≤ 1)
    (hc : ∀ y, ‖F lc y‖ ≤ 1) :
    ‖∫ s, ∫ u, ∏ j : Fin 4, F j (u + (j : ℕ) * s)‖ ≤
      64 * Real.sqrt (∫ y, ‖F jR y‖ ^ 2) *
        gowersNorm (AddCircle.haarAddCircle : Measure (AddCircle (16 : ℝ))) 3 (torusLift
            (F ig)) := by
  rw [real_progression_eq_torus F hsupp, norm_smul, Real.norm_eq_abs, abs_of_pos (by norm_num)]
  set μ : Measure (AddCircle (16 : ℝ)) := AddCircle.haarAddCircle
  have hperm : ∀ x t : AddCircle (16 : ℝ),
      ∏ j : Fin 4, torusLift (F j) (x + ((j : ℕ) : ℤ) • t) =
        torusLift (F jR) (x + ((jR : ℕ) : ℤ) • t) * torusLift (F ig) (x + ((ig : ℕ) : ℤ) • t) *
          torusLift (F kb) (x + ((kb : ℕ) : ℤ) • t) * torusLift (F lc) (x + ((lc : ℕ) : ℤ) • t) :=
    fun x t => prod_fin_four_perm (fun j => torusLift (F j) (x +
        ((j : ℕ) : ℤ) • t)) h1 h2 h3 h4 h5 h6
  simp_rw [hperm]
  have hvn := vonNeumann_group_U3 μ (fun n hn => addCircle_zsmul_measurePreserving hn)
    (measurable_torusLift (hF jR)) (measurable_torusLift (hF ig)) (measurable_torusLift (hF kb))
    (measurable_torusLift (hF lc)) (norm_torusLift_le hR) (norm_torusLift_le hg)
    (norm_torusLift_le hb) (norm_torusLift_le hc) (fin_cast_int_ne (Ne.symm h1))
    (fin_cast_int_ne h4) (fin_cast_int_ne h5)
  rw [integral_norm_sq_torusLift (hsupp jR)] at hvn
  set P := ‖∫ t, ∫ x, torusLift (F jR) (x + ((jR : ℕ) : ℤ) • t) *
    torusLift (F ig) (x + ((ig : ℕ) : ℤ) • t) * torusLift (F kb) (x + ((kb : ℕ) : ℤ) • t) *
      torusLift (F lc) (x + ((lc : ℕ) : ℤ) • t) ∂μ ∂μ‖ with hP
  set N := ∫ y, ‖F jR y‖ ^ 2 with hN
  set U := gowersNorm μ 3 (torusLift (F ig)) with hU
  have hN0 : 0 ≤ N := integral_nonneg fun y => by positivity
  have hU0 : 0 ≤ U := gowersNorm_nonneg μ (by norm_num) _ (measurable_torusLift (hF ig))
    (norm_torusLift_le hg)
  have hP0 : 0 ≤ P := norm_nonneg _
  have hkey : P ≤ Real.sqrt ((16 : ℝ)⁻¹ * N) * U := by
    have hs0 : 0 ≤ Real.sqrt ((16 : ℝ)⁻¹ * N) * U := by positivity
    have h8 : (Real.sqrt ((16 : ℝ)⁻¹ * N) * U) ^ 8 = ((16 : ℝ)⁻¹ * N) ^ 4 * U ^ 8 := by
      rw [mul_pow, show (8 : ℕ) = 2 * 4 by norm_num, pow_mul, Real.sq_sqrt (by positivity)]
    exact (pow_le_pow_iff_left₀ hP0 hs0 (by norm_num : (8 : ℕ) ≠ 0)).mp (by rw [h8]; exact hvn)
  have hsq : Real.sqrt ((16 : ℝ)⁻¹ * N) = Real.sqrt N / 4 := by
    rw [Real.sqrt_mul (by norm_num), show Real.sqrt (16 : ℝ)⁻¹ = 1 / 4 by
      rw [Real.sqrt_inv, show (16 : ℝ) = 4 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]; norm_num]
    ring
  rw [hsq] at hkey
  calc 256 * P ≤ 256 * (Real.sqrt N / 4 * U) := by gcongr
    _ = 64 * Real.sqrt N * U := by ring

end TorusSixteenBound

/-- Affine rescaling of a progression integral over `ℝ²` to the unit scale. -/
theorem progression_integral_rescale {r : ℝ} (hr : 0 < r) (a₀ : ℝ) (Φ : ℝ × ℝ → ℂ)
    (hΦ : Integrable Φ) :
    ∫ z, Φ z = (r ^ 2 : ℝ) • ∫ s, ∫ u, Φ (a₀ + r * u, r * s) := by
  rw [show (volume : Measure (ℝ × ℝ)) = volume.prod volume from rfl,
    integral_prod_symm Φ hΦ]
  have hinner : ∀ t : ℝ, ∫ x, Φ (x, t) = (r : ℝ) • ∫ u, Φ (a₀ + r * u, t) := by
    intro t
    have h1 := integral_add_left_eq_self (μ := (volume : Measure ℝ)) (fun x => Φ (x, t)) a₀
    have h2 := Measure.integral_comp_mul_left (fun y => Φ (a₀ + y, t)) r
    rw [← h1, h2, smul_smul, abs_inv, abs_of_pos hr, mul_inv_cancel₀ hr.ne', one_smul]
  simp_rw [hinner]
  rw [integral_smul]
  have h3 := Measure.integral_comp_mul_left (fun t => ∫ u, Φ (a₀ + r * u, t)) r
  rw [abs_inv, abs_of_pos hr] at h3
  have h4 : ∫ t, ∫ u, Φ (a₀ + r * u, t) = r • ∫ s, ∫ u, Φ (a₀ + r * u, r * s) := by
    rw [h3, smul_smul, mul_inv_cancel₀ hr.ne', one_smul]
  rw [h4, smul_smul]
  congr 1; ring

/-- A linear phase in `(x,t)` is a product of linear phases in two distinct slots. -/
theorem linear_phase_two_slots (α β x t : ℝ) {p q : ℝ} (hpq : p ≠ q) :
    α * x + β * t = (α - (β - p * α) / (q - p)) * (x + p * t) + ((β - p * α) / (q - p)) *
        (x + q * t) := by
  have hqp : q - p ≠ 0 := sub_ne_zero.mpr hpq.symm
  field_simp
  ring

/-- The slot-modulated, rescaled inputs of one kernel character term. -/
noncomputable def charSlotInput (a₀ r : ℝ) (f : Fin 4 → ℝ → ℂ) (jR kb : Fin 4) (αR αb : ℝ)
    (j : Fin 4) (u : ℝ) : ℂ :=
  (if j = jR then (Real.fourierChar (αR * (a₀ + r * u)) : ℂ)
    else if j = kb then (Real.fourierChar (αb * (a₀ + r * u)) : ℂ) else 1) *
    (Set.Ico (0 : ℝ) 1).indicator (fun y => f j (a₀ + r * y)) u

theorem integrable_progression_four {G : Fin 4 → ℝ → ℂ} (hG : ∀ j, Measurable (G j)) {M : ℝ}
    (hGb : ∀ j y, ‖G j y‖ ≤ M) {a b : ℝ} (hsupp : ∀ j y, G j y ≠ 0 → y ∈ Set.Ico a b) :
    Integrable (fun z : ℝ × ℝ => ∏ j : Fin 4, G j (z.1 + (j : ℕ) * z.2)) := by
  have hM : 0 ≤ M := (norm_nonneg _).trans (hGb 0 0)
  have hset (j : Fin 4) : G j = (Set.Ico a b).indicator (G j) := by
    funext y; by_cases hy : y ∈ Set.Ico a b
    · rw [Set.indicator_of_mem hy]
    · rw [Set.indicator_of_notMem hy]; by_contra h; exact hy (hsupp j y h)
  have hL2 (j : Fin 4) : MemLp (G j) 2 := by
    rw [hset j, memLp_indicator_iff_restrict measurableSet_Ico]
    exact MemLp.of_bound (hG j).aestronglyMeasurable M (Filter.Eventually.of_forall (hGb j))
  have hL1 (j : Fin 4) : Integrable (G j) := by
    rw [hset j, integrable_indicator_iff measurableSet_Ico]
    exact (MemLp.of_bound (hG j).aestronglyMeasurable M
      (Filter.Eventually.of_forall (hGb j))).integrable le_rfl
  have hpair := integrable_progression_pair (hG 0) (hG 1) (hL1 0) (hL2 0) (hL1 1) (hL2 1)
    (a := 0) (b := 1) (by norm_num)
  have hrest : Measurable (fun z : ℝ × ℝ => G 2 (z.1 + 2 * z.2) * G 3 (z.1 + 3 * z.2)) :=
    ((hG 2).comp (measurable_fst.add (measurable_const.mul measurable_snd))).mul
      ((hG 3).comp (measurable_fst.add (measurable_const.mul measurable_snd)))
  have h := hpair.bdd_mul (c := M * M) hrest.aestronglyMeasurable
    (Filter.Eventually.of_forall fun z => by
      rw [norm_mul]; exact mul_le_mul (hGb _ _) (hGb _ _) (norm_nonneg _) hM)
  refine h.congr (Filter.Eventually.of_forall fun z => ?_)
  simp only [Fin.prod_univ_four, Fin.val_zero, Fin.val_one, Fin.val_two, Nat.cast_zero,
    Nat.cast_one, zero_mul, add_zero, one_mul]
  have h3 : ((3 : Fin 4) : ℕ) = 3 := rfl
  rw [h3]; push_cast; ring

theorem fin_four_cover {a b c d : Fin 4} (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) (j : Fin 4) :
    j = a ∨ j = b ∨ j = c ∨ j = d := by
  have huniv : (Finset.univ : Finset (Fin 4)) = {a, b, c, d} := by
    symm
    apply Finset.eq_of_subset_of_card_le (Finset.subset_univ _)
    rw [Finset.card_univ, Fintype.card_fin, Finset.card_insert_of_notMem (by simp [hab, hac, had]),
      Finset.card_insert_of_notMem (by simp [hbc, hbd]), Finset.card_insert_of_notMem
          (by simp [hcd]),
      Finset.card_singleton]
  have hj : j ∈ ({a, b, c, d} : Finset (Fin 4)) := huniv ▸ Finset.mem_univ j
  simpa using hj

theorem charSlotInput_norm_le {a₀ r : ℝ} (hr : 0 < r) (f : Fin 4 → ℝ → ℂ)
    {jR ig kb lc : Fin 4} (h1 : jR ≠ ig) (h2 : jR ≠ kb) (h3 : jR ≠ lc) (h4 : ig ≠ kb)
    (h6 : kb ≠ lc) {MR Mg : ℝ} (hMR : 0 ≤ MR) (hMg : 0 ≤ Mg)
    (hR : ∀ y, ‖f jR y‖ ≤ MR) (hg : ∀ y, ‖f ig y‖ ≤ Mg)
    (hb : ∀ y ∈ Set.Ico a₀ (a₀ + r), ‖f kb y‖ ≤ 1) (hc : ∀ y ∈ Set.Ico a₀ (a₀ + r), ‖f lc y‖ ≤ 1)
    (αR αb : ℝ) (u : ℝ) :
    ‖charSlotInput a₀ r f jR kb αR αb jR u‖ ≤ MR ∧ ‖charSlotInput a₀ r f jR kb αR αb ig u‖ ≤ Mg ∧
      ‖charSlotInput a₀ r f jR kb αR αb kb u‖ ≤ 1 ∧
          ‖charSlotInput a₀ r f jR kb αR αb lc u‖ ≤ 1 := by
  simp only [charSlotInput, norm_mul]
  by_cases hu : u ∈ Set.Ico (0 : ℝ) 1
  · simp only [Set.indicator_of_mem hu]
    have hmem : a₀ + r * u ∈ Set.Ico a₀ (a₀ + r) := ⟨by nlinarith [hu.1], by nlinarith [hu.2]⟩
    refine ⟨?_, ?_, ?_, ?_⟩
    · simp only [ite_true, Circle.norm_coe, one_mul]; exact hR _
    · simp only [h1.symm, h4, ite_false, norm_one, one_mul]; exact hg _
    · simp only [h2.symm, ite_false, ite_true, Circle.norm_coe, one_mul]; exact hb _ hmem
    · simp only [h3.symm, h6.symm, ite_false, norm_one, one_mul]; exact hc _ hmem
  · simp only [Set.indicator_of_notMem hu, norm_zero, mul_zero]
    exact ⟨hMR, hMg, zero_le_one, zero_le_one⟩

theorem indicator_affine_unit {a₀ r : ℝ} (hr : 0 < r) (φ : ℝ → ℂ) (v : ℝ) :
    (Set.Ico a₀ (a₀ + r)).indicator φ (a₀ + r * v) =
      (Set.Ico (0 : ℝ) 1).indicator (fun y => φ (a₀ + r * y)) v := by
  by_cases hv : v ∈ Set.Ico (0 : ℝ) 1
  · rw [Set.indicator_of_mem hv, Set.indicator_of_mem]
    constructor <;> nlinarith [hv.1, hv.2]
  · rw [Set.indicator_of_notMem hv, Set.indicator_of_notMem]
    intro hm; apply hv
    constructor
    · by_contra h; push Not at h; nlinarith [hm.1]
    · by_contra h; push Not at h; nlinarith [hm.2]

theorem char_term_pointwise {a₀ r : ℝ} (hr : 0 < r) (f : Fin 4 → ℝ → ℂ) {jR ig kb lc : Fin 4}
    (h1 : jR ≠ ig) (h2 : jR ≠ kb) (h3 : jR ≠ lc) (h4 : ig ≠ kb) (h5 : ig ≠ lc) (h6 : kb ≠ lc)
    (α β θ u s : ℝ) :
    (Real.fourierChar (θ + α * (a₀ + r * u) + β * (r * s)) : ℂ) *
        ∏ j : Fin 4, (Set.Ico a₀ (a₀ + r)).indicator (f j) (a₀ + r * u + (j : ℕ) * (r * s)) =
      (Real.fourierChar θ : ℂ) * ∏ j : Fin 4, charSlotInput a₀ r f jR kb
        (α - (β - ((jR : ℕ) : ℝ) * α) / (((kb : ℕ) : ℝ) - ((jR : ℕ) : ℝ)))
        ((β - ((jR : ℕ) : ℝ) * α) / (((kb : ℕ) : ℝ) - ((jR : ℕ) : ℝ))) j (u + (j : ℕ) * s) := by
  set p : ℝ := ((jR : ℕ) : ℝ) with hp
  set q : ℝ := ((kb : ℕ) : ℝ) with hq
  have hpq : p ≠ q := by
    intro h; apply h2; apply Fin.ext
    have h' : ((jR : ℕ) : ℝ) = ((kb : ℕ) : ℝ) := h
    exact_mod_cast h'
  set αb := (β - p * α) / (q - p) with hαb
  set αR := α - αb with hαR
  unfold charSlotInput
  rw [Finset.prod_mul_distrib]
  have hind : ∀ j : Fin 4, (Set.Ico (0 : ℝ) 1).indicator (fun y => f j (a₀ + r * y))
      (u + (j : ℕ) * s) = (Set.Ico a₀ (a₀ + r)).indicator (f j)
        (a₀ + r * u + (j : ℕ) * (r * s)) := fun j => by
    rw [← indicator_affine_unit hr]; congr 1; ring
  simp_rw [hind]
  have hχ := prod_fin_four_perm (fun j : Fin 4 => if j = jR then
      (Real.fourierChar (αR * (a₀ + r * (u + (j : ℕ) * s))) : ℂ)
    else if j = kb then (Real.fourierChar (αb * (a₀ + r * (u + (j : ℕ) * s))) : ℂ) else 1)
    h2 (h1) h3 (Ne.symm h4) h6 h5
  rw [hχ]
  simp only [ite_true, h2.symm, ite_false, h1.symm, h4, h3.symm, h6.symm, mul_one]
  have hlin := linear_phase_two_slots α β (a₀ + r * u) (r * s) hpq
  rw [show θ + α * (a₀ + r * u) + β * (r * s) = θ + (α * (a₀ + r * u) + β * (r * s)) by ring,
    hlin, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul, Circle.coe_mul, Circle.coe_mul]
  have e1 : a₀ + r * u + p * (r * s) = a₀ + r * (u + p * s) := by ring
  have e2 : a₀ + r * u + q * (r * s) = a₀ + r * (u + q * s) := by ring
  rw [e1, e2]
  ring

theorem integral_indicator_affine_unit {a₀ r : ℝ} (hr : 0 < r) (g : ℝ → ℝ) :
    ∫ y, (Set.Ico (0 : ℝ) 1).indicator (fun y => g (a₀ + r * y)) y =
      r⁻¹ * ∫ x in Set.Ico a₀ (a₀ + r), g x := by
  have h1 : ∀ y, (Set.Ico (0 : ℝ) 1).indicator (fun y => g (a₀ + r * y)) y =
      (Set.Ico a₀ (a₀ + r)).indicator g (a₀ + r * y) := fun y => by
    by_cases hv : y ∈ Set.Ico (0 : ℝ) 1
    · rw [Set.indicator_of_mem hv, Set.indicator_of_mem]
      constructor <;> nlinarith [hv.1, hv.2]
    · rw [Set.indicator_of_notMem hv, Set.indicator_of_notMem]
      intro hm; apply hv
      constructor
      · by_contra h; push Not at h; nlinarith [hm.1]
      · by_contra h; push Not at h; nlinarith [hm.2]
  simp_rw [h1]
  have h2 := Measure.integral_comp_mul_left
    (fun y => (Set.Ico a₀ (a₀ + r)).indicator g (a₀ + y)) r
  rw [h2, integral_add_left_eq_self (fun y => (Set.Ico a₀ (a₀ + r)).indicator g y) a₀,
    integral_indicator measurableSet_Ico, abs_inv, abs_of_pos hr, smul_eq_mul]

/-- lem:von-neumann, lines 1427–1429: one kernel character term. -/
theorem kernel_character_term_bound {a₀ r : ℝ} (hr : 0 < r) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ j, Measurable (f j)) {jR ig kb lc : Fin 4}
    (h1 : jR ≠ ig) (h2 : jR ≠ kb) (h3 : jR ≠ lc) (h4 : ig ≠ kb) (h5 : ig ≠ lc) (h6 : kb ≠ lc)
    {MR Mg : ℝ} (hR : ∀ y, ‖f jR y‖ ≤ MR) (hg : ∀ y, ‖f ig y‖ ≤ Mg)
    (hb : ∀ y ∈ Set.Ico a₀ (a₀ + r), ‖f kb y‖ ≤ 1) (hc : ∀ y ∈ Set.Ico a₀ (a₀ + r), ‖f lc y‖ ≤ 1)
    (α β θ : ℝ) :
    ‖∫ z : ℝ × ℝ, (Real.fourierChar (θ + α * z.1 + β * z.2) : ℂ) *
        ∏ j : Fin 4, (Set.Ico a₀ (a₀ + r)).indicator (f j) (z.1 + (j : ℕ) * z.2)‖ ≤
      r ^ 2 * (64 * Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖f jR y‖ ^ 2) *
        intervalGowersNorm a₀ (a₀ + r) (f ig)) := by
  set I := Set.Ico a₀ (a₀ + r) with hI
  set p : ℝ := ((jR : ℕ) : ℝ) with hp
  set q : ℝ := ((kb : ℕ) : ℝ) with hq
  have hpq : p ≠ q := by
    intro h; apply h2; apply Fin.ext
    have h' : ((jR : ℕ) : ℝ) = ((kb : ℕ) : ℝ) := h
    exact_mod_cast h'
  set! αb := (β - p * α) / (q - p) with hαb
  set! αR := α - αb with hαR
  set! F := charSlotInput a₀ r f jR kb αR αb with hF
  have hMR : 0 ≤ MR := (norm_nonneg _).trans (hR 0)
  have hMg : 0 ≤ Mg := (norm_nonneg _).trans (hg 0)
  have hind : ∀ (j : Fin 4) (v : ℝ), I.indicator (f j) (a₀ + r * v) =
      (Set.Ico (0 : ℝ) 1).indicator (fun y => f j (a₀ + r * y)) v := by
    intro j v
    by_cases hv : v ∈ Set.Ico (0 : ℝ) 1
    · rw [Set.indicator_of_mem hv, Set.indicator_of_mem]
      constructor <;> nlinarith [hv.1, hv.2]
    · rw [Set.indicator_of_notMem hv, Set.indicator_of_notMem]
      intro hm; apply hv
      constructor
      · by_contra h; push Not at h; nlinarith [hm.1]
      · by_contra h; push Not at h; nlinarith [hm.2]
  have hFb := charSlotInput_norm_le hr f h1 h2 h3 h4 h6 hMR hMg hR hg hb hc αR αb
  have hcov := fin_four_cover h1 h2 h3 h4 h5 h6
  set! M := MR + Mg + 1 with hM
  have hGb : ∀ j y, ‖I.indicator (f j) y‖ ≤ M := by
    intro j y
    by_cases hy : y ∈ I
    · rw [Set.indicator_of_mem hy]
      rcases hcov j with rfl | rfl | rfl | rfl
      · have := hR y; linarith
      · have := hg y; linarith
      · have := hb y hy; linarith
      · have := hc y hy; linarith
    · rw [Set.indicator_of_notMem hy, norm_zero]; linarith
  have hGs : ∀ j y, I.indicator (f j) y ≠ 0 → y ∈ Set.Ico a₀ (a₀ + r) := by
    intro j y h; by_contra hy; exact h (Set.indicator_of_notMem hy _)
  have hP := integrable_progression_four (fun j => (hf j).indicator measurableSet_Ico) hGb hGs
  have hchm : Measurable (fun z : ℝ × ℝ => (Real.fourierChar (θ + α * z.1 + β * z.2) : ℂ)) :=
    (continuous_subtype_val.comp Real.continuous_fourierChar).measurable.comp (by fun_prop)
  have hΦ := hP.bdd_mul (c := 1) hchm.aestronglyMeasurable
    (Filter.Eventually.of_forall fun z => by simp)
  rw [progression_integral_rescale hr a₀ _ hΦ]
  have hpt : ∀ s u : ℝ, (Real.fourierChar (θ + α * (a₀ + r * u) + β * (r * s)) : ℂ) *
      ∏ j : Fin 4, I.indicator (f j) (a₀ + r * u + (j : ℕ) * (r * s)) =
      (Real.fourierChar θ : ℂ) * ∏ j : Fin 4, F j (u + (j : ℕ) * s) :=
    fun s u => char_term_pointwise hr f h1 h2 h3 h4 h5 h6 α β θ u s
  have hI2 : ∫ s, ∫ u, (fun z : ℝ × ℝ => (Real.fourierChar (θ + α * z.1 + β * z.2) : ℂ) *
      ∏ j : Fin 4, I.indicator (f j) (z.1 + (j : ℕ) * z.2)) (a₀ + r * u, r * s) =
      (Real.fourierChar θ : ℂ) * ∫ s, ∫ u, ∏ j : Fin 4, F j (u + (j : ℕ) * s) := by
    rw [← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun s => ?_)
    beta_reduce
    rw [← integral_const_mul]
    exact integral_congr_ae (Filter.Eventually.of_forall fun u => hpt s u)
  rw [hI2]
  rw [norm_smul, norm_mul, Circle.norm_coe, one_mul, Real.norm_eq_abs, abs_of_pos (by positivity)]
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  have hFm : ∀ j, Measurable (F j) := by
    intro j
    simp only [hF]
    refine Measurable.mul ?_ (((hf j).comp (measurable_const.add
      (measurable_const.mul measurable_id))).indicator measurableSet_Ico)
    split_ifs
    · exact (continuous_subtype_val.comp Real.continuous_fourierChar).measurable.comp
        (by fun_prop)
    · exact (continuous_subtype_val.comp Real.continuous_fourierChar).measurable.comp
        (by fun_prop)
    · exact measurable_const
  have hFs : ∀ j u, F j u ≠ 0 → u ∈ Set.Ico (0 : ℝ) 1 := by
    intro j u h; by_contra hu
    apply h
    simp only [hF, charSlotInput, Set.indicator_of_notMem hu, mul_zero]
  have hb := progression_term_bound F hFm hFs h1 h2 h3 h4 h5 h6 (fun u => (hFb u).1)
    (fun u => (hFb u).2.1) (fun u => (hFb u).2.2.1) (fun u => (hFb u).2.2.2)
  have hnorm : ∫ y, ‖F jR y‖ ^ 2 = r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖f jR y‖ ^ 2 := by
    rw [← integral_indicator_affine_unit hr (fun y => ‖f jR y‖ ^ 2)]
    congr 1; funext y
    simp only [hF, charSlotInput, ite_true, norm_mul, Circle.norm_coe, one_mul]
    by_cases hy : y ∈ Set.Ico (0 : ℝ) 1
    · simp [Set.indicator_of_mem hy]
    · simp [Set.indicator_of_notMem hy]
  have hlift : F ig = normalizeIntervalFunction a₀ (a₀ + r) (f ig) := by
    funext y
    simp only [hF, charSlotInput, normalizeIntervalFunction, h1.symm, h4, ite_false, one_mul,
      add_sub_cancel_left]
  rw [hnorm, hlift] at hb
  exact hb

/-- Blueprint lem:von-neumann for bounded inputs: for any ordering of four distinct slots,
`|H_I(R,g,b,c)| ≤ C ‖R‖_{2,I} ‖g‖_{U(I)}` when `|b|,|c| ≤ 1` on `I`, with `C` depending
only on the kernel class. -/
theorem vonNeumann_local_bounded {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ j, Measurable (f j)) {jR ig kb lc : Fin 4}
    (h1 : jR ≠ ig) (h2 : jR ≠ kb) (h3 : jR ≠ lc) (h4 : ig ≠ kb) (h5 : ig ≠ lc) (h6 : kb ≠ lc)
    {MR Mg : ℝ} (hR : ∀ y, ‖f jR y‖ ≤ MR) (hg : ∀ y, ‖f ig y‖ ≤ Mg)
    (hb : ∀ y ∈ Set.Ico a₀ (a₀ + r), ‖f kb y‖ ≤ 1) (hc : ∀ y ∈ Set.Ico a₀ (a₀ + r), ‖f lc y‖ ≤ 1) :
    ‖localProgressionForm r w f‖ ≤ kernelFourierConst κ *
      (64 * Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖f jR y‖ ^ 2) *
        intervalGowersNorm a₀ (a₀ + r) (f ig)) := by
  set I := Set.Ico a₀ (a₀ + r) with hI
  set B := 64 * Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖f jR y‖ ^ 2) *
    intervalGowersNorm a₀ (a₀ + r) (f ig) with hB
  have hMR : 0 ≤ MR := (norm_nonneg _).trans (hR 0)
  have hMg : 0 ≤ Mg := (norm_nonneg _).trans (hg 0)
  -- only the restrictions to the cell matter
  have hrestr : ∀ z : ℝ × ℝ, w z * ∏ j : Fin 4, f j (realProgressionCoordinate j z) =
      w z * ∏ j : Fin 4, I.indicator (f j) (z.1 + (j : ℕ) * z.2) := by
    intro z
    by_cases hz : w z = 0
    · simp [hz]
    congr 1
    apply Finset.prod_congr rfl
    intro j _
    have h := hw.support z hz j
    have hm := mul_pos κ.margin_pos hr
    have hmem : z.1 + ((j : ℕ) : ℝ) * z.2 ∈ I := ⟨by
      have := h.1; unfold realProgressionCoordinate at this; linarith, by
      have := h.2; unfold realProgressionCoordinate at this; linarith⟩
    rw [Set.indicator_of_mem hmem]
    rfl
  unfold localProgressionForm
  simp_rw [hrestr]
  obtain ⟨hcs, hct, hexp⟩ := admissibleKernel_fourier_expansion hr hw
  set c := periodicFourierCoeff (cubePeriodization (kernelUnitRescale a₀ r w) 16) with hcdef
  set c₀ := a₀ + r / 2 with hc₀
  set! Pf : ℝ × ℝ → ℂ := fun z => ∏ j : Fin 4, I.indicator (f j) (z.1 + (j : ℕ) * z.2) with hPf
  set! E : (Fin 2 → ℤ) → ℝ × ℝ → ℂ := fun v z =>
    (Real.fourierChar ((v 0 : ℝ) * ((z.1 - c₀) / r / 16) + (v 1 : ℝ) * (z.2 / r / 16)) : ℂ)
    with hE
  have hpt : ∀ z, HasSum (fun v => c v * (E v z * Pf z)) (w z * Pf z) := by
    intro z
    by_cases h0 : Pf z = 0
    · rw [h0, mul_zero]; simp_rw [mul_zero]; exact hasSum_zero
    have hz0 : I.indicator (f 0) (z.1 + ((0 : Fin 4) : ℕ) * z.2) ≠ 0 := fun h =>
      h0 (Finset.prod_eq_zero (Finset.mem_univ 0) h)
    have hz1 : I.indicator (f 1) (z.1 + ((1 : Fin 4) : ℕ) * z.2) ≠ 0 := fun h =>
      h0 (Finset.prod_eq_zero (Finset.mem_univ 1) h)
    have m0 : z.1 ∈ I := by
      by_contra hn; apply hz0; simp only [Fin.val_zero, Nat.cast_zero, zero_mul, add_zero]
      exact Set.indicator_of_notMem hn _
    have m1 : z.1 + z.2 ∈ I := by
      by_contra hn; apply hz1; simp only [Fin.val_one, Nat.cast_one, one_mul]
      exact Set.indicator_of_notMem hn _
    have hx : |z.1 - c₀| ≤ 8 * r := by
      rw [abs_le, hc₀]; constructor <;> linarith [m0.1, m0.2]
    have ht : |z.2| ≤ 8 * r := by
      rw [abs_le]; constructor <;> linarith [m0.1, m0.2, m1.1, m1.2]
    have h := (hexp z.1 z.2 hx ht).mul_right (Pf z)
    convert h using 1
    funext v; simp only [hE]; ring
  -- integrability and the interchange
  have hcov := fin_four_cover h1 h2 h3 h4 h5 h6
  have hGb : ∀ j y, ‖I.indicator (f j) y‖ ≤ MR + Mg + 1 := by
    intro j y
    by_cases hy : y ∈ I
    · rw [Set.indicator_of_mem hy]
      rcases hcov j with rfl | rfl | rfl | rfl
      · have := hR y; linarith
      · have := hg y; linarith
      · have := hb y hy; linarith
      · have := hc y hy; linarith
    · rw [Set.indicator_of_notMem hy, norm_zero]; linarith
  have hGs : ∀ j y, I.indicator (f j) y ≠ 0 → y ∈ Set.Ico a₀ (a₀ + r) := by
    intro j y h; by_contra hy; exact h (Set.indicator_of_notMem hy _)
  have hPi : Integrable Pf :=
    integrable_progression_four (fun j => (hf j).indicator measurableSet_Ico) hGb hGs
  have hEm (v : Fin 2 → ℤ) : Measurable (E v) :=
    (continuous_subtype_val.comp Real.continuous_fourierChar).measurable.comp (by fun_prop)
  have hEPi (v : Fin 2 → ℤ) : Integrable (fun z => E v z * Pf z) :=
    hPi.bdd_mul (c := 1) (hEm v).aestronglyMeasurable
      (Filter.Eventually.of_forall fun z => by simp [hE])
  have hnorm (v : Fin 2 → ℤ) : ∫ z, ‖c v * (E v z * Pf z)‖ = ‖c v‖ * ∫ z, ‖Pf z‖ := by
    rw [← integral_const_mul]; congr 1; funext z
    rw [norm_mul, norm_mul]; simp [hE]
  have hsumm : Summable (fun v => ∫ z, ‖c v * (E v z * Pf z)‖) := by
    simp_rw [hnorm]; exact hcs.mul_right _
  have hint : ∫ z, w z * Pf z = ∑' v, c v * ∫ z, E v z * Pf z := by
    have h := integral_tsum_of_summable_integral_norm (fun v => (hEPi v).const_mul (c v)) hsumm
    simp_rw [integral_const_mul] at h
    rw [h]; congr 1; funext z; exact (hpt z).tsum_eq.symm
  -- the character terms
  have hterm (v : Fin 2 → ℤ) : ‖∫ z, E v z * Pf z‖ ≤ r ^ 2 * B := by
    have hEe : ∀ z : ℝ × ℝ, E v z = (Real.fourierChar (-((v 0 : ℝ) * c₀ / (16 * r)) +
        (v 0 : ℝ) / (16 * r) * z.1 + (v 1 : ℝ) / (16 * r) * z.2) : ℂ) := fun z => by
      simp only [hE]; congr 2; field_simp; ring
    simp_rw [hEe]
    exact kernel_character_term_bound hr f hf h1 h2 h3 h4 h5 h6 hR hg hb hc _ _ _
  have hB0 : 0 ≤ B := by
    have h0 := (norm_nonneg _).trans (hterm 0)
    exact nonneg_of_mul_nonneg_right (by linarith) (by positivity : (0 : ℝ) < r ^ 2)
  have hsum2 : Summable (fun v => ‖c v * ∫ z, E v z * Pf z‖) :=
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _)
      (fun v => by rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hterm v) (norm_nonneg _))
      (hcs.mul_right _)
  change ‖(r : ℂ)⁻¹ ^ 2 * ∫ z, w z * Pf z‖ ≤ _
  rw [hint, norm_mul, norm_pow, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr]
  calc r⁻¹ ^ 2 * ‖∑' v, c v * ∫ z, E v z * Pf z‖ ≤ r⁻¹ ^ 2 * ∑' v, ‖c v‖ * (r ^ 2 * B) := by
        apply mul_le_mul_of_nonneg_left _ (by positivity)
        refine (norm_tsum_le_tsum_norm hsum2).trans ?_
        exact hsum2.tsum_le_tsum (fun v => by
          rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hterm v) (norm_nonneg _))
          (hcs.mul_right _)
    _ = (∑' v, ‖c v‖) * B := by
        rw [tsum_mul_right]; field_simp
    _ ≤ kernelFourierConst κ * B := mul_le_mul_of_nonneg_right hct hB0

theorem normalizedIntervalMeasure_eq_intervalProbability (a : ℝ) {r : ℝ} (hr : 0 < r) :
    normalizedIntervalMeasure a r = intervalProbabilityMeasure a (a + r) := by
  rw [intervalProbabilityMeasure_eq (by linarith), add_sub_cancel_left, normalizedIntervalMeasure,
    Measure.restrict_congr_set Ico_ae_eq_Icc]

/-- Only the restrictions of the inputs to the cell enter an admissible local form. -/
theorem localProgression_integrand_restrict {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ)
    (z : ℝ × ℝ) : w z * ∏ j, f j (realProgressionCoordinate j z) =
      w z * ∏ j, (Set.Ico a₀ (a₀ + r)).indicator (f j) (realProgressionCoordinate j z) := by
  by_cases hz : w z = 0
  · simp [hz]
  congr 1
  apply Finset.prod_congr rfl
  intro j _
  have h := hw.support z hz j
  have hm := mul_pos κ.margin_pos hr
  rw [Set.indicator_of_mem]
  exact ⟨by linarith [h.1], by linarith [h.2]⟩

/-- An admissible local form vanishes when one input vanishes on the cell. -/
theorem localProgressionForm_eq_zero_of_vanish {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ) (k : Fin 4)
    (hk : ∀ y ∈ Set.Ico a₀ (a₀ + r), f k y = 0) : localProgressionForm r w f = 0 := by
  unfold localProgressionForm
  simp_rw [localProgression_integrand_restrict hr hw f]
  have h0 : ∀ z : ℝ × ℝ, w z * ∏ j, (Set.Ico a₀ (a₀ + r)).indicator (f j)
      (realProgressionCoordinate j z) = 0 := by
    intro z
    rw [Finset.prod_eq_zero (Finset.mem_univ k)]
    · ring
    by_cases hy : realProgressionCoordinate k z ∈ Set.Ico a₀ (a₀ + r)
    · rw [Set.indicator_of_mem hy, hk _ hy]
    · rw [Set.indicator_of_notMem hy]
  simp [h0]

/-- Scaling one input scales the local form. -/
theorem localProgressionForm_update_smul (r : ℝ) (w : ℝ × ℝ → ℂ) (f : Fin 4 → ℝ → ℂ)
    (k : Fin 4) (c : ℂ) :
    localProgressionForm r w (Function.update f k (c • f k)) = c * localProgressionForm r w f := by
  have hp (y : Fin 4 → ℝ) :
      ∏ j, Function.update f k (c • f k) j (y j) = c * ∏ j, f j (y j) := by
    rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ k),
      ← Finset.mul_prod_erase _ (fun j => f j (y j)) (Finset.mem_univ k),
      Finset.prod_congr rfl (fun j hj => by
        rw [Function.update_of_ne (Finset.ne_of_mem_erase hj)])]
    simp [mul_assoc]
  have hp' (z : ℝ × ℝ) : w z * ∏ j, Function.update f k (c • f k) j
      (realProgressionCoordinate j z) = c * (w z * ∏ j, f j (realProgressionCoordinate j z)) := by
    rw [hp (fun j => realProgressionCoordinate j z)]; ring
  unfold localProgressionForm
  simp_rw [hp', integral_const_mul]
  ring

/-- Truncation of a function at a norm level. -/
noncomputable def truncateNorm (n : ℝ) (f : ℝ → ℂ) : ℝ → ℂ := {y | ‖f y‖ ≤ n}.indicator f

theorem truncateNorm_measurable {f : ℝ → ℂ} (hf : Measurable f) (n : ℝ) :
    Measurable (truncateNorm n f) :=
  hf.indicator (measurableSet_le hf.norm measurable_const)

theorem norm_truncateNorm_le_level {n : ℝ} (hn : 0 ≤ n) (f : ℝ → ℂ) (y : ℝ) :
    ‖truncateNorm n f y‖ ≤ n := by
  unfold truncateNorm
  by_cases h : y ∈ {y | ‖f y‖ ≤ n}
  · rw [Set.indicator_of_mem h]; exact h
  · rw [Set.indicator_of_notMem h, norm_zero]; exact hn

theorem norm_truncateNorm_le (n : ℝ) (f : ℝ → ℂ) (y : ℝ) : ‖truncateNorm n f y‖ ≤ ‖f y‖ := by
  unfold truncateNorm
  by_cases h : y ∈ {y | ‖f y‖ ≤ n}
  · rw [Set.indicator_of_mem h]
  · rw [Set.indicator_of_notMem h, norm_zero]; exact norm_nonneg _

theorem tendsto_truncateNorm (f : ℝ → ℂ) (y : ℝ) :
    Filter.Tendsto (fun n : ℕ => truncateNorm n f y) Filter.atTop (nhds (f y)) := by
  apply tendsto_const_nhds.congr'
  filter_upwards [Filter.eventually_ge_atTop ⌈‖f y‖⌉₊] with n hn
  unfold truncateNorm
  rw [Set.indicator_of_mem]
  change ‖f y‖ ≤ (n : ℝ)
  exact (Nat.le_ceil _).trans (by exact_mod_cast hn)

theorem tendsto_eLpNorm_truncateNorm {μ : Measure ℝ} {f : ℝ → ℂ} (hfm : Measurable f)
    (hf : MemLp f 2 μ) :
    Filter.Tendsto (fun n : ℕ => eLpNorm (f - truncateNorm n f) 2 μ) Filter.atTop (nhds 0) := by
  rw [ENNReal.tendsto_atTop_zero]
  intro ε hε
  obtain ⟨M, hM⟩ := hf.eLpNorm_indicator_norm_ge_le hfm.stronglyMeasurable hε
  refine ⟨⌈M⌉₊, fun n hn => le_trans (eLpNorm_mono
    (hfm.sub (truncateNorm_measurable hfm n)).aestronglyMeasurable fun y => ?_) hM⟩
  simp only [Pi.sub_apply, truncateNorm]
  by_cases h : ‖f y‖ ≤ (n : ℝ)
  · rw [Set.indicator_of_mem (show y ∈ {y | ‖f y‖ ≤ (n : ℝ)} from h), sub_self, norm_zero]
    exact norm_nonneg _
  · rw [Set.indicator_of_notMem (show y ∉ {y | ‖f y‖ ≤ (n : ℝ)} from h), sub_zero]
    have hMn : M ≤ ‖f y‖ := (Nat.le_ceil M).trans
      ((by exact_mod_cast hn : (⌈M⌉₊ : ℝ) ≤ n).trans (not_le.mp h).le)
    rw [Set.indicator_of_mem (show y ∈ {x | M ≤ (‖f x‖₊ : ℝ)} from by simpa using hMn)]

/-- Integrability of an admissible local progression integrand whose cell
restrictions have finite normalized norms at exponents allowed by `eq:absolute`. -/
theorem integrable_localProgression {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ j, Measurable (f j)) (p : Fin 4 → ENNReal) (hp : ∀ i, 1 ≤ p i)
    (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2)
    (hfin : ∀ j, eLpNorm ((Set.Ico a₀ (a₀ + r)).indicator (f j)) (p j)
      (normalizedIntervalMeasure a₀ r) ≠ ⊤) :
    Integrable (fun z : ℝ × ℝ => w z * ∏ j, f j (realProgressionCoordinate j z)) := by
  set F : Fin 4 → ℝ → ℂ := fun j => (Set.Ico a₀ (a₀ + r)).indicator (f j) with hF
  have hFm : ∀ j, Measurable (F j) := fun j => (hf j).indicator measurableSet_Ico
  have hwm : Measurable w := hw.smooth.continuous.measurable
  have hcm : ∀ j : Fin 4, Measurable (realProgressionCoordinate j) :=
    fun j => (continuous_realProgressionCoordinate j).measurable
  have he : (fun z : ℝ × ℝ => w z * ∏ j, f j (realProgressionCoordinate j z)) =
      fun z => w z * ∏ j, F j (realProgressionCoordinate j z) :=
    funext (localProgression_integrand_restrict hr hw f)
  rw [he]
  refine ⟨(hwm.mul (Finset.measurable_prod _ fun j _ =>
    (hFm j).comp (hcm j))).aestronglyMeasurable, ?_⟩
  have hW (z : ℝ × ℝ) : ‖w z‖ₑ ≤ ENNReal.ofReal (localKernelSupBound κ) := by
    rw [← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (admissibleLocalKernel_norm_le hw z)
  have hb := localProgression_absoluteNormBound hr w hwm (admissibleLocalKernel_support hr.le hw)
    hW F hFm p hp hsum
  have hn (z : ℝ × ℝ) : ‖w z * ∏ i, F i (realProgressionCoordinate i z)‖ₑ =
      ‖w z‖ₑ * ∏ i, ‖F i (realProgressionCoordinate i z)‖ₑ := by
    simp only [← ofReal_norm, norm_mul, norm_prod,
      ENNReal.ofReal_mul (norm_nonneg _),
      ENNReal.ofReal_prod_of_nonneg (fun _ _ => norm_nonneg _)]
  have hR : (2 * ENNReal.ofReal (localKernelSupBound κ)) *
      ∏ i, eLpNorm (F i) (p i) (normalizedIntervalMeasure a₀ r) ≠ ⊤ :=
    ENNReal.mul_ne_top (ENNReal.mul_ne_top (by norm_num) ENNReal.ofReal_ne_top)
      (ENNReal.prod_ne_top fun j _ => hfin j)
  have h0 : ENNReal.ofReal r⁻¹ ^ 2 ≠ 0 := by
    apply pow_ne_zero; rw [ENNReal.ofReal_ne_zero_iff]; positivity
  unfold HasFiniteIntegral
  simp_rw [hn]
  refine Ne.lt_top fun htop => hR (top_le_iff.mp ?_)
  rw [htop, ENNReal.mul_top h0] at hb
  exact hb

theorem memLp_normalized_indicator {a₀ r : ℝ} {g : ℝ → ℂ}
    (hg : MemLp g 2 (volume.restrict (Set.Ico a₀ (a₀ + r)))) :
    MemLp ((Set.Ico a₀ (a₀ + r)).indicator g) 2 (normalizedIntervalMeasure a₀ r) := by
  have h : MemLp ((Set.Ico a₀ (a₀ + r)).indicator g) 2 volume :=
    (memLp_indicator_iff_restrict measurableSet_Ico).mpr hg
  exact (h.restrict (Set.Icc a₀ (a₀ + r))).smul_measure ENNReal.ofReal_ne_top

theorem eLpNorm_top_indicator_le {a₀ r : ℝ} {g : ℝ → ℂ} (hgm : Measurable g) {M : ℝ}
    (hg : ∀ y ∈ Set.Ico a₀ (a₀ + r), ‖g y‖ ≤ M) (μ : Measure ℝ) :
    eLpNorm ((Set.Ico a₀ (a₀ + r)).indicator g) ⊤ μ ≤ ENNReal.ofReal (max M 0) := by
  rw [eLpNorm_exponent_top (hgm.indicator measurableSet_Ico).aestronglyMeasurable]
  apply eLpNormEssSup_le_of_ae_bound (Filter.Eventually.of_forall fun y => ?_)
  by_cases hy : y ∈ Set.Ico a₀ (a₀ + r)
  · rw [Set.indicator_of_mem hy]; exact (hg y hy).trans (le_max_left _ _)
  · rw [Set.indicator_of_notMem hy, norm_zero]; exact le_max_right _ _

/-- Blueprint lem:von-neumann, line 1447: passage from bounded inputs to `L²`
inputs by truncation, for `|b|, |c| ≤ 1` on the cell. -/
theorem vonNeumann_local_L2_unit {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ j, Measurable (f j)) {jR ig kb lc : Fin 4}
    (h1 : jR ≠ ig) (h2 : jR ≠ kb) (h3 : jR ≠ lc) (h4 : ig ≠ kb) (h5 : ig ≠ lc) (h6 : kb ≠ lc)
    (hR : MemLp (f jR) 2 (volume.restrict (Set.Ico a₀ (a₀ + r))))
    (hg : MemLp (f ig) 2 (volume.restrict (Set.Ico a₀ (a₀ + r))))
    (hb : ∀ y ∈ Set.Ico a₀ (a₀ + r), ‖f kb y‖ ≤ 1)
    (hc : ∀ y ∈ Set.Ico a₀ (a₀ + r), ‖f lc y‖ ≤ 1) :
    ‖localProgressionForm r w f‖ ≤ kernelFourierConst κ *
      (64 * Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖f jR y‖ ^ 2) *
        intervalGowersNorm a₀ (a₀ + r) (f ig)) := by
  set I := Set.Ico a₀ (a₀ + r) with hI
  set μI := intervalProbabilityMeasure a₀ (a₀ + r) with hμI
  have hμIe : μI = ENNReal.ofReal r⁻¹ • volume.restrict I := by
    rw [hμI, intervalProbabilityMeasure_eq (by linarith), add_sub_cancel_left]
  set fn : ℕ → Fin 4 → ℝ → ℂ := fun n j => if j = jR then truncateNorm n (f jR)
    else if j = ig then truncateNorm n (f ig) else f j with hfn
  have hfnR (n : ℕ) : fn n jR = truncateNorm n (f jR) := by simp [hfn]
  have hfng (n : ℕ) : fn n ig = truncateNorm n (f ig) := by simp [hfn, h1.symm]
  have hfno (n : ℕ) (j : Fin 4) (h : j ≠ jR) (h' : j ≠ ig) : fn n j = f j := by
    simp [hfn, h, h']
  have hfnm (n : ℕ) (j : Fin 4) : Measurable (fn n j) := by
    by_cases h : j = jR
    · subst h; rw [hfnR]; exact truncateNorm_measurable (hf _) _
    by_cases h' : j = ig
    · subst h'; rw [hfng]; exact truncateNorm_measurable (hf _) _
    rw [hfno n j h h']; exact hf j
  have hfnle (n : ℕ) (j : Fin 4) (y : ℝ) : ‖fn n j y‖ ≤ ‖f j y‖ := by
    by_cases h : j = jR
    · subst h; rw [hfnR]; exact norm_truncateNorm_le _ _ _
    by_cases h' : j = ig
    · subst h'; rw [hfng]; exact norm_truncateNorm_le _ _ _
    rw [hfno n j h h']
  have hfnt (j : Fin 4) (y : ℝ) :
      Filter.Tendsto (fun n => fn n j y) Filter.atTop (nhds (f j y)) := by
    by_cases h : j = jR
    · subst h; simp_rw [hfnR]; exact tendsto_truncateNorm _ _
    by_cases h' : j = ig
    · subst h'; simp_rw [hfng]; exact tendsto_truncateNorm _ _
    simp_rw [hfno _ j h h']; exact tendsto_const_nhds
  have hK : 0 ≤ kernelFourierConst κ := by
    unfold kernelFourierConst
    have := kernelDerivBound_nonneg κ 0
    have := kernelDerivBound_nonneg κ 3
    positivity
  set S := Real.sqrt (r⁻¹ * ∫ y in I, ‖f jR y‖ ^ 2) with hS
  have hRint : Integrable (fun y => ‖f jR y‖ ^ 2) (volume.restrict I) := by
    have := hR.integrable_norm_rpow two_ne_zero ENNReal.ofNat_ne_top
    simpa using this
  have hgμ : MemLp (f ig) 2 μI := by rw [hμIe]; exact hg.smul_measure ENNReal.ofReal_ne_top
  have htg (n : ℕ) : MemLp (truncateNorm n (f ig)) 2 μI :=
    hgμ.of_le (truncateNorm_measurable (hf ig) n).aestronglyMeasurable
      (Filter.Eventually.of_forall (norm_truncateNorm_le _ _))
  set! U : ℕ → ℝ := fun n => intervalGowersNorm a₀ (a₀ + r) (truncateNorm n (f ig)) with hU
  have hUnn (n : ℕ) : 0 ≤ U n := by
    simp only [hU]
    rw [← intervalL2GowersSeminorm_toLp _ _ (truncateNorm_measurable (hf ig) n) (htg n)]
    exact apply_nonneg _ _
  -- the bounded estimate for the truncations
  have hbound (n : ℕ) :
      ‖localProgressionForm r w (fn n)‖ ≤ kernelFourierConst κ * (64 * S * U n) := by
    have h := vonNeumann_local_bounded hr hw (fn n) (hfnm n) h1 h2 h3 h4 h5 h6
      (MR := n) (Mg := n)
      (fun y => by rw [hfnR]; exact norm_truncateNorm_le_level (Nat.cast_nonneg n) _ _)
      (fun y => by rw [hfng]; exact norm_truncateNorm_le_level (Nat.cast_nonneg n) _ _)
      (fun y hy => by rw [hfno n kb h2.symm h4.symm]; exact hb y hy)
      (fun y hy => by rw [hfno n lc h3.symm h5.symm]; exact hc y hy)
    rw [hfnR, hfng] at h
    refine h.trans (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_left ?_
        (by positivity))) (by norm_num)) (hUnn n)) hK)
    apply integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => by positivity) hRint
      (Filter.Eventually.of_forall fun y => ?_)
    exact pow_le_pow_left₀ (norm_nonneg _) (norm_truncateNorm_le (n : ℝ) (f jR) y) 2
  -- convergence of the forms
  have hΦ : Integrable (fun z : ℝ × ℝ => w z * ∏ j, f j (realProgressionCoordinate j z)) := by
    refine integrable_localProgression hr hw f hf
      (fun j => if j = jR ∨ j = ig then 2 else ⊤) (fun i => ?_) ?_ (fun j => ?_)
    · split_ifs <;> norm_num
    · refine (Finset.sum_le_card_nsmul _ _ (1 / 2) fun i _ => ?_).trans (by norm_num)
      split_ifs <;> norm_num
    · by_cases hj : j = jR ∨ j = ig
      · rw [ite_eq_left_of_eq_true _ _ (eq_true hj)]
        rcases hj with rfl | rfl
        · exact (memLp_normalized_indicator hR).eLpNorm_ne_top
        · exact (memLp_normalized_indicator hg).eLpNorm_ne_top
      · rw [ite_eq_right_of_eq_false _ _ (eq_false hj)]
        simp only [not_or] at hj
        rcases fin_four_cover h1 h2 h3 h4 h5 h6 j with h | h | h | h
        · exact absurd h hj.1
        · exact absurd h hj.2
        · subst h
          exact ne_top_of_le_ne_top ENNReal.ofReal_ne_top (eLpNorm_top_indicator_le (hf _) hb _)
        · subst h
          exact ne_top_of_le_ne_top ENNReal.ofReal_ne_top (eLpNorm_top_indicator_le (hf _) hc _)
  have hint : Filter.Tendsto (fun n => ∫ z, w z * ∏ j, fn n j (realProgressionCoordinate j z))
      Filter.atTop (nhds (∫ z, w z * ∏ j, f j (realProgressionCoordinate j z))) := by
    refine tendsto_integral_of_dominated_convergence
      (fun z => ‖w z * ∏ j, f j (realProgressionCoordinate j z)‖)
      (fun n => ?_) hΦ.norm (fun n => Filter.Eventually.of_forall fun z => ?_)
      (Filter.Eventually.of_forall fun z => ?_)
    · exact (hw.smooth.continuous.measurable.mul (Finset.measurable_prod _ fun j _ =>
        (hfnm n j).comp (continuous_realProgressionCoordinate j).measurable)).aestronglyMeasurable
    · rw [norm_mul, norm_mul, norm_prod, norm_prod]
      exact mul_le_mul_of_nonneg_left (Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _)
        fun j _ => hfnle n j _) (norm_nonneg _)
    · exact tendsto_const_nhds.mul (tendsto_finsetProd _ fun j _ => hfnt j _)
  have hH : Filter.Tendsto (fun n => ‖localProgressionForm r w (fn n)‖) Filter.atTop
      (nhds ‖localProgressionForm r w f‖) := by
    unfold localProgressionForm
    exact (tendsto_const_nhds.mul hint).norm
  -- convergence of the uniformity norms
  have hLp : Filter.Tendsto (fun n => (htg n).toLp (truncateNorm n (f ig))) Filter.atTop
      (nhds (hgμ.toLp (f ig))) := by
    rw [tendsto_iff_norm_sub_tendsto_zero]
    have he (n : ℕ) : ‖(htg n).toLp (truncateNorm n (f ig)) - hgμ.toLp (f ig)‖ =
        (eLpNorm (f ig - truncateNorm n (f ig)) 2 μI).toReal := by
      rw [← MemLp.toLp_sub, Lp.norm_toLp, eLpNorm_sub_comm]
    simp_rw [he]
    have h := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp
      (tendsto_eLpNorm_truncateNorm (hf ig) hgμ)
    rw [ENNReal.toReal_zero] at h
    exact h
  have hcont : Continuous (fun u => intervalL2GowersSeminorm a₀ (a₀ + r) u) := by
    change Continuous (fun u => unitIntervalGowersSeminorm (intervalL2Pullback a₀ (a₀ + r) u))
    exact unitIntervalGowersSeminorm_continuous.comp (intervalL2Pullback a₀ (a₀ + r)).continuous
  have hUt : Filter.Tendsto U Filter.atTop (nhds (intervalGowersNorm a₀ (a₀ + r) (f ig))) := by
    have h := (hcont.tendsto _).comp hLp
    rw [intervalL2GowersSeminorm_toLp _ _ (hf ig) hgμ] at h
    exact h.congr fun n =>
      intervalL2GowersSeminorm_toLp _ _ (truncateNorm_measurable (hf ig) n) (htg n)
  have hRHS : Filter.Tendsto (fun n => kernelFourierConst κ * (64 * S * U n)) Filter.atTop
      (nhds (kernelFourierConst κ * (64 * S * intervalGowersNorm a₀ (a₀ + r) (f ig)))) :=
    tendsto_const_nhds.mul (tendsto_const_nhds.mul hUt)
  exact le_of_tendsto_of_tendsto' hH hRHS hbound

theorem intervalGowersNorm_nonneg_of_memLp {a₀ r : ℝ} (hr : 0 < r) {g : ℝ → ℂ}
    (hgm : Measurable g) (hg : MemLp g 2 (volume.restrict (Set.Ico a₀ (a₀ + r)))) :
    0 ≤ intervalGowersNorm a₀ (a₀ + r) g := by
  have hgμ : MemLp g 2 (intervalProbabilityMeasure a₀ (a₀ + r)) := by
    rw [intervalProbabilityMeasure_eq (by linarith), add_sub_cancel_left]
    exact hg.smul_measure ENNReal.ofReal_ne_top
  rw [← intervalL2GowersSeminorm_toLp _ _ hgm hgμ]
  exact apply_nonneg _ _

/-- Blueprint lem:von-neumann, eq:von-neumann: for any ordering of four distinct
slots, `R, g ∈ L²(I)` and `b, c` bounded on `I`,
`|H_I(R,g,b,c)| ≤ C ‖R‖_{2,I} ‖g‖_{U(I)} ‖b‖_∞ ‖c‖_∞`. -/
theorem vonNeumann_local_L2 {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ j, Measurable (f j)) {jR ig kb lc : Fin 4}
    (h1 : jR ≠ ig) (h2 : jR ≠ kb) (h3 : jR ≠ lc) (h4 : ig ≠ kb) (h5 : ig ≠ lc) (h6 : kb ≠ lc)
    (hR : MemLp (f jR) 2 (volume.restrict (Set.Ico a₀ (a₀ + r))))
    (hg : MemLp (f ig) 2 (volume.restrict (Set.Ico a₀ (a₀ + r))))
    {Mb Mc : ℝ} (hb : ∀ y ∈ Set.Ico a₀ (a₀ + r), ‖f kb y‖ ≤ Mb)
    (hc : ∀ y ∈ Set.Ico a₀ (a₀ + r), ‖f lc y‖ ≤ Mc) :
    ‖localProgressionForm r w f‖ ≤ kernelFourierConst κ *
      (64 * Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖f jR y‖ ^ 2) *
        intervalGowersNorm a₀ (a₀ + r) (f ig)) * Mb * Mc := by
  have ha : a₀ ∈ Set.Ico a₀ (a₀ + r) := ⟨le_rfl, by linarith⟩
  have hMb : 0 ≤ Mb := (norm_nonneg _).trans (hb a₀ ha)
  have hMc : 0 ≤ Mc := (norm_nonneg _).trans (hc a₀ ha)
  rcases hMb.eq_or_lt with hb0 | hbpos
  · rw [localProgressionForm_eq_zero_of_vanish hr hw f kb
      (fun y hy => norm_le_zero_iff.mp (hb0 ▸ hb y hy)), ← hb0]
    simp
  rcases hMc.eq_or_lt with hc0 | hcpos
  · rw [localProgressionForm_eq_zero_of_vanish hr hw f lc
      (fun y hy => norm_le_zero_iff.mp (hc0 ▸ hc y hy)), ← hc0]
    simp
  set g := Function.update f kb (((Mb : ℂ)⁻¹) • f kb) with hgdef
  set! g' := Function.update g lc (((Mc : ℂ)⁻¹) • g lc) with hg'def
  have hH : localProgressionForm r w g' =
      (Mc : ℂ)⁻¹ * ((Mb : ℂ)⁻¹ * localProgressionForm r w f) := by
    rw [hg'def, localProgressionForm_update_smul, hgdef, localProgressionForm_update_smul]
  have hgo (j : Fin 4) (h : j ≠ kb) (h' : j ≠ lc) : g' j = f j := by
    rw [hg'def, Function.update_of_ne h', hgdef, Function.update_of_ne h]
  have hgkb : g' kb = (Mb : ℂ)⁻¹ • f kb := by
    rw [hg'def, Function.update_of_ne h6, hgdef, Function.update_self]
  have hglc : g' lc = (Mc : ℂ)⁻¹ • f lc := by
    rw [hg'def, Function.update_self, hgdef, Function.update_of_ne h6.symm]
  have hgm (j : Fin 4) : Measurable (g' j) := by
    by_cases h : j = kb
    · subst h; rw [hgkb]; exact (hf _).const_smul _
    by_cases h' : j = lc
    · subst h'; rw [hglc]; exact (hf _).const_smul _
    rw [hgo j h h']; exact hf j
  have key := vonNeumann_local_L2_unit hr hw g' hgm h1 h2 h3 h4 h5 h6
    (by rw [hgo jR h2 h3]; exact hR) (by rw [hgo ig h4 h5]; exact hg)
    (fun y hy => by
      rw [hgkb, Pi.smul_apply, smul_eq_mul, norm_mul, norm_inv, Complex.norm_real,
        Real.norm_of_nonneg hMb, inv_mul_le_iff₀ hbpos, mul_one]
      exact hb y hy)
    (fun y hy => by
      rw [hglc, Pi.smul_apply, smul_eq_mul, norm_mul, norm_inv, Complex.norm_real,
        Real.norm_of_nonneg hMc, inv_mul_le_iff₀ hcpos, mul_one]
      exact hc y hy)
  rw [hgo jR h2 h3, hgo ig h4 h5, hH, norm_mul, norm_mul, norm_inv, norm_inv, Complex.norm_real,
    Complex.norm_real, Real.norm_of_nonneg hMb, Real.norm_of_nonneg hMc] at key
  calc ‖localProgressionForm r w f‖ =
        Mb * Mc * (Mc⁻¹ * (Mb⁻¹ * ‖localProgressionForm r w f‖)) := by
        field_simp
    _ ≤ Mb * Mc * (kernelFourierConst κ *
        (64 * Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖f jR y‖ ^ 2) *
          intervalGowersNorm a₀ (a₀ + r) (f ig))) :=
        mul_le_mul_of_nonneg_left key (by positivity)
    _ = _ := by ring

/-- The constant of lem:von-neumann for the fixed admissible kernel class. -/
noncomputable def vonNeumannConst (κ : LocalKernelClass) : ℝ :=
  max (kernelFourierConst κ * 64) (2 * localKernelSupBound κ)

theorem vonNeumannConst_nonneg (κ : LocalKernelClass) : 0 ≤ vonNeumannConst κ :=
  le_max_of_le_right (mul_nonneg (by norm_num) (localKernelSupBound_nonneg κ))

/-- Blueprint lem:von-neumann, the `L¹` assertion: the two-coordinate case of
lem:absolute with `R, g ∈ L¹(I)` and `b, c ∈ L^∞(I)`. -/
theorem vonNeumann_local_L1 {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ j, Measurable (f j)) {jR ig kb lc : Fin 4}
    (h1 : jR ≠ ig) (h2 : jR ≠ kb) (h3 : jR ≠ lc) (h4 : ig ≠ kb) (h5 : ig ≠ lc) (h6 : kb ≠ lc) :
    ‖localProgressionForm r w f‖ₑ ≤ ENNReal.ofReal (vonNeumannConst κ) *
      (eLpNorm (f jR) 1 (normalizedIntervalMeasure a₀ r) *
        eLpNorm (f ig) 1 (normalizedIntervalMeasure a₀ r) *
        eLpNorm (f kb) ⊤ (normalizedIntervalMeasure a₀ r) *
        eLpNorm (f lc) ⊤ (normalizedIntervalMeasure a₀ r)) := by
  have hW (z : ℝ × ℝ) : ‖w z‖ₑ ≤ ENNReal.ofReal (localKernelSupBound κ) := by
    rw [← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (admissibleLocalKernel_norm_le hw z)
  set p : Fin 4 → ENNReal := fun j => if j = jR ∨ j = ig then 1 else ⊤ with hp
  have hp1 : ∀ i, 1 ≤ p i := by
    intro i; simp only [hp]; split_ifs <;> simp
  have hsum : ∑ i, (p i).toReal⁻¹ ≤ 2 := by
    calc ∑ i, (p i).toReal⁻¹ ≤ ∑ i : Fin 4,
          ((if i = jR then (1 : ℝ) else 0) + (if i = ig then (1 : ℝ) else 0)) := by
          apply Finset.sum_le_sum
          intro i _
          simp only [hp]
          by_cases hi : i = jR
          · subst hi; simp [h1]
          by_cases hi' : i = ig
          · subst hi'; simp [hi]
          simp [hi, hi']
      _ = 2 := by
          rw [Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.sum_ite_eq']
          norm_num
  have h := localProgressionForm_enorm_le hr w hw.smooth.continuous.measurable
    (admissibleLocalKernel_support hr.le hw) hW f hf p hp1 hsum
  rw [prod_fin_four_perm (fun i => eLpNorm (f i) (p i) (normalizedIntervalMeasure a₀ r))
    h1 h2 h3 h4 h5 h6] at h
  have hpR : p jR = 1 := by simp [hp]
  have hpg : p ig = 1 := by simp [hp]
  have hpb : p kb = ⊤ := by simp [hp, h2.symm, h4.symm]
  have hpc : p lc = ⊤ := by simp [hp, h3.symm, h5.symm]
  simp only [hpR, hpg, hpb, hpc] at h
  refine h.trans (mul_le_mul_left ?_ _)
  rw [show (2 : ENNReal) = ENNReal.ofReal 2 by norm_num,
    ← ENNReal.ofReal_mul (by norm_num)]
  exact ENNReal.ofReal_le_ofReal (le_max_right _ _)

theorem sum_fin_four_perm {M : Type*} [AddCommMonoid M] (φ : Fin 4 → M) {a b c d : Fin 4}
    (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) :
    ∑ j, φ j = φ a + φ b + φ c + φ d := by
  have huniv : (Finset.univ : Finset (Fin 4)) = {a, b, c, d} := by
    symm
    apply Finset.eq_of_subset_of_card_le (Finset.subset_univ _)
    rw [Finset.card_univ, Fintype.card_fin, Finset.card_insert_of_notMem (by simp [hab, hac, had]),
      Finset.card_insert_of_notMem (by simp [hbc, hbd]), Finset.card_insert_of_notMem
          (by simp [hcd]),
      Finset.card_singleton]
  rw [huniv, Finset.sum_insert (by simp [hab, hac, had]), Finset.sum_insert (by simp [hbc, hbd]),
    Finset.sum_insert (by simp [hcd]), Finset.sum_singleton]
  simp only [add_assoc]

/-- Tail estimate for norm truncation: for `0 < p ≤ q`, the part of `f` above level `B`
has `L^p` norm at most `B^(1 - q/p) ‖f‖_q^(q/p)`. -/
theorem eLpNorm_sub_truncateNorm_le {μ : Measure ℝ} {f : ℝ → ℂ} (hf : Measurable f)
    {p q B : ℝ} (hp : 0 < p) (hpq : p ≤ q) (hB : 0 < B) :
    eLpNorm (f - truncateNorm B f) (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal (B ^ (1 - q / p)) * eLpNorm f (ENNReal.ofReal q) μ ^ (q / p) := by
  have hqp : 0 < q / p := div_pos (hp.trans_le hpq) hp
  have h1 : 1 ≤ q / p := (one_le_div hp).mpr hpq
  have hpt : ∀ y, ‖(f - truncateNorm B f) y‖ ≤ B ^ (1 - q / p) * ‖f y‖ ^ (q / p) := by
    intro y
    simp only [Pi.sub_apply, truncateNorm]
    by_cases h : ‖f y‖ ≤ B
    · rw [Set.indicator_of_mem (show y ∈ {y | ‖f y‖ ≤ B} from h), sub_self, norm_zero]
      positivity
    · rw [Set.indicator_of_notMem (show y ∉ {y | ‖f y‖ ≤ B} from h), sub_zero]
      have hfy : B < ‖f y‖ := not_le.mp h
      have hf0 : 0 < ‖f y‖ := hB.trans hfy
      calc ‖f y‖ = B ^ (1 - q / p) * (B ^ (q / p - 1) * ‖f y‖) := by
            rw [← mul_assoc, ← Real.rpow_add hB]
            simp
        _ ≤ B ^ (1 - q / p) * (‖f y‖ ^ (q / p - 1) * ‖f y‖) := by
            gcongr
        _ = B ^ (1 - q / p) * ‖f y‖ ^ (q / p) := by
            rw [Real.rpow_sub_one hf0.ne']; field_simp
  have hfun : (fun y => B ^ (1 - q / p) * ‖f y‖ ^ (q / p)) =
      (B ^ (1 - q / p)) • (fun y => ‖f y‖ ^ (q / p)) := by
    funext y; simp [smul_eq_mul]
  calc eLpNorm (f - truncateNorm B f) (ENNReal.ofReal p) μ
      ≤ eLpNorm (fun y => B ^ (1 - q / p) * ‖f y‖ ^ (q / p)) (ENNReal.ofReal p) μ :=
        eLpNorm_mono_real ((hf.sub (truncateNorm_measurable hf B)).aestronglyMeasurable) hpt
    _ = ENNReal.ofReal (B ^ (1 - q / p)) * eLpNorm f (ENNReal.ofReal q) μ ^ (q / p) := by
        rw [hfun, eLpNorm_const_smul, eLpNorm_norm_rpow f hf.aestronglyMeasurable hqp,
          Real.enorm_eq_ofReal (by positivity), ← ENNReal.ofReal_mul hp.le,
          mul_div_cancel₀ q hp.ne']

/-- Evaluating a product after replacing one input. -/
theorem prod_update_eval (f : Fin 4 → ℝ → ℂ) (k : Fin 4) (g : ℝ → ℂ) (y : Fin 4 → ℝ) :
    ∏ j, Function.update f k g j (y j) = g (y k) * ∏ j ∈ Finset.univ.erase k, f j (y j) := by
  rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ k), Function.update_self,
    Finset.prod_congr rfl (fun j hj => by rw [Function.update_of_ne (Finset.ne_of_mem_erase hj)])]

/-- Additivity of the local form in one input. -/
theorem localProgressionForm_update_add (r : ℝ) (w : ℝ × ℝ → ℂ) (f : Fin 4 → ℝ → ℂ)
    (k : Fin 4) (g₁ g₂ : ℝ → ℂ)
    (h₁ : Integrable (fun z : ℝ × ℝ => w z * ∏ j, Function.update f k g₁ j
      (realProgressionCoordinate j z)))
    (h₂ : Integrable (fun z : ℝ × ℝ => w z * ∏ j, Function.update f k g₂ j
      (realProgressionCoordinate j z))) :
    localProgressionForm r w (Function.update f k (g₁ + g₂)) =
      localProgressionForm r w (Function.update f k g₁) +
        localProgressionForm r w (Function.update f k g₂) := by
  have hp (z : ℝ × ℝ) : w z * ∏ j, Function.update f k (g₁ + g₂) j
      (realProgressionCoordinate j z) =
      w z * ∏ j, Function.update f k g₁ j (realProgressionCoordinate j z) +
        w z * ∏ j, Function.update f k g₂ j (realProgressionCoordinate j z) := by
    rw [prod_update_eval f k _ (fun j => realProgressionCoordinate j z),
      prod_update_eval f k g₁ (fun j => realProgressionCoordinate j z),
      prod_update_eval f k g₂ (fun j => realProgressionCoordinate j z), Pi.add_apply]
    ring
  unfold localProgressionForm
  simp_rw [hp]
  rw [integral_add h₁ h₂, mul_add]

/-- Integrability of an admissible local integrand with four normalized `L²` inputs. -/
theorem integrable_localProgression_two {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ j, Measurable (f j))
    (hfin : ∀ j, eLpNorm (f j) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤) :
    Integrable (fun z : ℝ × ℝ => w z * ∏ j, f j (realProgressionCoordinate j z)) :=
  integrable_localProgression hr hw f hf (fun _ => 2) (fun _ => by norm_num)
    (by norm_num [Fin.sum_univ_succ])
    (fun j => ne_top_of_le_ne_top (hfin j)
      (eLpNorm_indicator_le _ measurableSet_Ico))

/-- `eq:absolute` with exponents assigned to four distinct slots. -/
theorem localProgressionForm_enorm_le_slots {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ j, Measurable (f j)) {a b c d : Fin 4}
    (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d)
    (pa pb pc pd : ENNReal) (ha : 1 ≤ pa) (hb : 1 ≤ pb) (hc : 1 ≤ pc) (hd : 1 ≤ pd)
    (hsum : pa.toReal⁻¹ + pb.toReal⁻¹ + pc.toReal⁻¹ + pd.toReal⁻¹ ≤ 2) :
    ‖localProgressionForm r w f‖ₑ ≤ ENNReal.ofReal (localFormUniformConstant κ) *
      (eLpNorm (f a) pa (normalizedIntervalMeasure a₀ r) *
        eLpNorm (f b) pb (normalizedIntervalMeasure a₀ r) *
        eLpNorm (f c) pc (normalizedIntervalMeasure a₀ r) *
        eLpNorm (f d) pd (normalizedIntervalMeasure a₀ r)) := by
  have hW (z : ℝ × ℝ) : ‖w z‖ₑ ≤ ENNReal.ofReal (localKernelSupBound κ) := by
    rw [← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (admissibleLocalKernel_norm_le hw z)
  set! p : Fin 4 → ENNReal := fun j =>
    if j = a then pa else if j = b then pb else if j = c then pc else pd with hp
  have hpa : p a = pa := by simp [hp]
  have hpb : p b = pb := by simp [hp, hab.symm]
  have hpc : p c = pc := by simp [hp, hac.symm, hbc.symm]
  have hpd : p d = pd := by simp [hp, had.symm, hbd.symm, hcd.symm]
  have hp1 : ∀ i, 1 ≤ p i := by
    intro i
    rcases fin_four_cover hab hac had hbc hbd hcd i with rfl | rfl | rfl | rfl
    · rw [hpa]; exact ha
    · rw [hpb]; exact hb
    · rw [hpc]; exact hc
    · rw [hpd]; exact hd
  have hs : ∑ i, (p i).toReal⁻¹ ≤ 2 := by
    rw [sum_fin_four_perm (fun i => (p i).toReal⁻¹) hab hac had hbc hbd hcd]
    simpa only [hpa, hpb, hpc, hpd] using hsum
  have h := localProgressionForm_enorm_le hr w hw.smooth.continuous.measurable
    (admissibleLocalKernel_support hr.le hw) hW f hf p hp1 hs
  rw [prod_fin_four_perm (fun i => eLpNorm (f i) (p i) (normalizedIntervalMeasure a₀ r))
    hab hac had hbc hbd hcd, hpa, hpb, hpc, hpd] at h
  have hcst : (2 : ENNReal) * ENNReal.ofReal (localKernelSupBound κ) =
      ENNReal.ofReal (localFormUniformConstant κ) := by
    rw [localFormUniformConstant, ENNReal.ofReal_mul (by norm_num)]
    norm_num
  rw [hcst] at h
  exact h

/-- Clipping every input except the one in slot `k` at height `B`. -/
noncomputable def clipExcept (B : ℝ) (k : Fin 4) (f : Fin 4 → ℝ → ℂ) : Fin 4 → ℝ → ℂ :=
  fun j => if j = k then f j else truncateNorm B (f j)

theorem eLpNorm_update_ne_top {μ : Measure ℝ} {p : ENNReal} {f : Fin 4 → ℝ → ℂ}
    (hf : ∀ j, eLpNorm (f j) p μ ≠ ⊤) (k : Fin 4) {g : ℝ → ℂ} (hg : eLpNorm g p μ ≠ ⊤)
    (j : Fin 4) : eLpNorm (Function.update f k g j) p μ ≠ ⊤ := by
  by_cases h : j = k
  · subst h; rw [Function.update_self]; exact hg
  · rw [Function.update_of_ne h]; exact hf j

theorem measurable_update_slot {f : Fin 4 → ℝ → ℂ} (hf : ∀ j, Measurable (f j)) (k : Fin 4)
    {g : ℝ → ℂ} (hg : Measurable g) (j : Fin 4) : Measurable (Function.update f k g j) := by
  by_cases h : j = k
  · subst h; rw [Function.update_self]; exact hg
  · rw [Function.update_of_ne h]; exact hf j

theorem norm_le_of_enorm_le_four {x : ℂ} {W α β γ ε : ℝ} (hW : 0 ≤ W) (hα : 0 ≤ α)
    (hβ : 0 ≤ β) (hγ : 0 ≤ γ) (hε : 0 ≤ ε) {A B C D : ENNReal}
    (h : ‖x‖ₑ ≤ ENNReal.ofReal W * (A * B * C * D)) (hA : A ≤ ENNReal.ofReal α)
    (hB : B ≤ ENNReal.ofReal β) (hC : C ≤ ENNReal.ofReal γ) (hD : D ≤ ENNReal.ofReal ε) :
    ‖x‖ ≤ W * (α * β * γ * ε) := by
  have h' : ‖x‖ₑ ≤ ENNReal.ofReal (W * (α * β * γ * ε)) := by
    refine h.trans ?_
    rw [ENNReal.ofReal_mul hW, ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul hα]
    gcongr
  rw [← ofReal_norm] at h'
  exact (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp h'

/-- Blueprint lem:detection, lines 1465-1467: clipping the three opponents of `R`
at height `B` changes the local form by at most `3 C C₁ B^{-(q-2)/q}`. -/
theorem detection_clipping {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ j, Measurable (f j)) {jR ih ku lv : Fin 4}
    (h1 : jR ≠ ih) (h2 : jR ≠ ku) (h3 : jR ≠ lv) (h4 : ih ≠ ku) (h5 : ih ≠ lv) (h6 : ku ≠ lv)
    {q C₁ B : ℝ} (hq : 2 < q) (hC₁ : 0 ≤ C₁) (hB1 : 1 ≤ B)
    (hR : eLpNorm (f jR) 2 (normalizedIntervalMeasure a₀ r) ≤ ENNReal.ofReal C₁)
    (hh : eLpNorm (f ih) (ENNReal.ofReal q) (normalizedIntervalMeasure a₀ r) ≤ 1)
    (hu : eLpNorm (f ku) 2 (normalizedIntervalMeasure a₀ r) ≤ 1)
    (hv : eLpNorm (f lv) 2 (normalizedIntervalMeasure a₀ r) ≤ 1) :
    ‖localProgressionForm r w f‖ ≤ ‖localProgressionForm r w (clipExcept B jR f)‖ +
      3 * (localFormUniformConstant κ * (C₁ * B ^ (-(q - 2) / q) * 1 * 1)) := by
  set ν := normalizedIntervalMeasure a₀ r with hν
  have : IsProbabilityMeasure ν := normalizedIntervalMeasure_probability a₀ hr
  set W' := localFormUniformConstant κ with hW'
  have hW0 : 0 ≤ W' := localFormUniformConstant_nonneg κ
  have hB0 : 0 < B := by linarith
  have hq0 : 0 < q := by linarith
  set! q' := q / (q - 1) with hq'
  have hq1 : 0 < q - 1 := by linarith
  have hq'1 : 1 ≤ q' := by rw [hq', le_div_iff₀ hq1]; linarith
  have hq'2 : q' ≤ 2 := by rw [hq', div_le_iff₀ hq1]; linarith
  have hq'0 : 0 < q' := by linarith
  have h2q : (2 : ENNReal) ≤ ENNReal.ofReal q := by
    rw [show (2 : ENNReal) = ENNReal.ofReal 2 by norm_num]
    exact ENNReal.ofReal_le_ofReal hq.le
  set R := f jR
  set h := f ih
  set u := f ku
  set v := f lv
  set! hB := truncateNorm B h
  set! uB := truncateNorm B u
  set! vB := truncateNorm B v
  -- finiteness of all normalized `L²` norms
  have hRt : eLpNorm R 2 ν ≠ ⊤ := ne_top_of_le_ne_top ENNReal.ofReal_ne_top hR
  have hh2 : eLpNorm h 2 ν ≤ 1 := (eLpNorm_le_eLpNorm_of_exponent_le h2q).trans hh
  have hfin : ∀ j, eLpNorm (f j) 2 ν ≠ ⊤ := by
    intro j
    rcases fin_four_cover h1 h2 h3 h4 h5 h6 j with rfl | rfl | rfl | rfl
    · exact hRt
    · exact ne_top_of_le_ne_top ENNReal.one_ne_top hh2
    · exact ne_top_of_le_ne_top ENNReal.one_ne_top hu
    · exact ne_top_of_le_ne_top ENNReal.one_ne_top hv
  have htr (g : ℝ → ℂ) (hg : Measurable g) : eLpNorm (truncateNorm B g) 2 ν ≤ eLpNorm g 2 ν :=
    eLpNorm_mono (truncateNorm_measurable hg B).aestronglyMeasurable
      (fun y => norm_truncateNorm_le B g y)
  have hdf (g : ℝ → ℂ) (hg : Measurable g) :
      eLpNorm (g - truncateNorm B g) 2 ν ≤ eLpNorm g 2 ν := by
    refine eLpNorm_mono (hg.sub (truncateNorm_measurable hg B)).aestronglyMeasurable
      (fun y => ?_)
    rw [Pi.sub_apply]
    unfold truncateNorm
    by_cases hy : y ∈ {y | ‖g y‖ ≤ B}
    · rw [Set.indicator_of_mem hy, sub_self, norm_zero]; exact norm_nonneg _
    · rw [Set.indicator_of_notMem hy, sub_zero]
  have hm := hf
  have hhm : Measurable h := hf ih
  have hum : Measurable u := hf ku
  have hvm : Measurable v := hf lv
  -- the telescoping
  set! f1 := Function.update f ih hB with hf1
  set! e1 := Function.update f ih (h - hB) with he1
  set! f2 := Function.update f1 ku uB with hf2
  set! e2 := Function.update f1 ku (u - uB) with he2
  set! f3 := Function.update f2 lv vB with hf3
  set! e3 := Function.update f2 lv (v - vB) with he3
  have hf1m := measurable_update_slot hf ih (truncateNorm_measurable hhm B)
  have hf2m := measurable_update_slot hf1m ku (truncateNorm_measurable hum B)
  have hf1fin := eLpNorm_update_ne_top hfin ih
    (ne_top_of_le_ne_top (hfin ih) (htr h hhm))
  have hf2fin := eLpNorm_update_ne_top hf1fin ku
    (ne_top_of_le_ne_top (hfin ku) (htr u hum))
  have hf1ku : f1 ku = u := by rw [hf1, Function.update_of_ne h4.symm]
  have hf2lv : f2 lv = v := by
    rw [hf2, Function.update_of_ne h6.symm, hf1, Function.update_of_ne h5.symm]
  have hstep1 : localProgressionForm r w f =
      localProgressionForm r w f1 + localProgressionForm r w e1 := by
    have he : f = Function.update f ih (hB + (h - hB)) := by
      rw [add_sub_cancel, Function.update_eq_self]
    rw [he]
    exact localProgressionForm_update_add r w f ih hB (h - hB)
      (integrable_localProgression_two hr hw _ hf1m hf1fin)
      (integrable_localProgression_two hr hw _
        (measurable_update_slot hf ih (hhm.sub (truncateNorm_measurable hhm B)))
        (eLpNorm_update_ne_top hfin ih (ne_top_of_le_ne_top (hfin ih) (hdf h hhm))))
  have hstep2 : localProgressionForm r w f1 =
      localProgressionForm r w f2 + localProgressionForm r w e2 := by
    have he : f1 = Function.update f1 ku (uB + (u - uB)) := by
      rw [add_sub_cancel, ← hf1ku, Function.update_eq_self]
    rw [he]
    have := localProgressionForm_update_add r w f1 ku uB (u - uB)
      (integrable_localProgression_two hr hw _ hf2m hf2fin)
      (integrable_localProgression_two hr hw _
        (measurable_update_slot hf1m ku (hum.sub (truncateNorm_measurable hum B)))
        (eLpNorm_update_ne_top hf1fin ku (ne_top_of_le_ne_top (hfin ku) (hdf u hum))))
    exact this
  have hstep3 : localProgressionForm r w f2 =
      localProgressionForm r w f3 + localProgressionForm r w e3 := by
    have he : f2 = Function.update f2 lv (vB + (v - vB)) := by
      rw [add_sub_cancel, ← hf2lv, Function.update_eq_self]
    rw [he]
    have := localProgressionForm_update_add r w f2 lv vB (v - vB)
      (integrable_localProgression_two hr hw _
        (measurable_update_slot hf2m lv (truncateNorm_measurable hvm B))
        (eLpNorm_update_ne_top hf2fin lv (ne_top_of_le_ne_top (hfin lv) (htr v hvm))))
      (integrable_localProgression_two hr hw _
        (measurable_update_slot hf2m lv (hvm.sub (truncateNorm_measurable hvm B)))
        (eLpNorm_update_ne_top hf2fin lv (ne_top_of_le_ne_top (hfin lv) (hdf v hvm))))
    exact this
  have hf3eq : f3 = clipExcept B jR f := by
    funext j
    rcases fin_four_cover h1 h2 h3 h4 h5 h6 j with rfl | rfl | rfl | rfl
    · simp [hf3, hf2, hf1, clipExcept, h1, h2, h3]
    · simp [hf3, hf2, hf1, clipExcept, h1.symm, h4, h5, hB, h]
    · simp [hf3, hf2, hf1, clipExcept, h2.symm, h6, uB, u]
    · simp [hf3, hf2, hf1, clipExcept, h3.symm, vB, v]
  -- the three error terms
  have hBe : 0 ≤ B ^ (-(q - 2) / q) := Real.rpow_nonneg hB0.le _
  have hexp1 : B ^ (1 - q / 2) ≤ B ^ (-(q - 2) / q) := by
    apply Real.rpow_le_rpow_of_exponent_le hB1
    rw [div_eq_mul_inv, div_eq_mul_inv]
    have : (q - 2) * q⁻¹ ≤ (q - 2) * 2⁻¹ := by
      apply mul_le_mul_of_nonneg_left _ (by linarith)
      exact inv_anti₀ (by norm_num) hq.le
    linarith
  have hexp2 : B ^ (1 - 2 / q') = B ^ (-(q - 2) / q) := by
    congr 1; rw [hq']; field_simp; ring
  have htail1 : eLpNorm (h - hB) 2 ν ≤ ENNReal.ofReal (B ^ (-(q - 2) / q)) := by
    have t := eLpNorm_sub_truncateNorm_le (μ := ν) hhm (p := 2) (q := q) (by norm_num) hq.le hB0
    rw [ENNReal.ofReal_ofNat] at t
    refine t.trans ?_
    calc ENNReal.ofReal (B ^ (1 - q / 2)) * eLpNorm h (ENNReal.ofReal q) ν ^ (q / 2)
        ≤ ENNReal.ofReal (B ^ (1 - q / 2)) * 1 := by
          gcongr; exact ENNReal.rpow_le_one hh (by positivity)
      _ ≤ _ := by rw [mul_one]; exact ENNReal.ofReal_le_ofReal hexp1
  have htail2 (g : ℝ → ℂ) (hg : Measurable g) (hg2 : eLpNorm g 2 ν ≤ 1) :
      eLpNorm (g - truncateNorm B g) (ENNReal.ofReal q') ν ≤
        ENNReal.ofReal (B ^ (-(q - 2) / q)) := by
    have t := eLpNorm_sub_truncateNorm_le (μ := ν) hg (p := q') (q := 2) hq'0 hq'2 hB0
    rw [ENNReal.ofReal_ofNat, hexp2] at t
    refine t.trans ?_
    calc ENNReal.ofReal (B ^ (-(q - 2) / q)) * eLpNorm g 2 ν ^ (2 / q')
        ≤ ENNReal.ofReal (B ^ (-(q - 2) / q)) * 1 := by
          gcongr; exact ENNReal.rpow_le_one hg2 (by positivity)
      _ = _ := mul_one _
  have hhBq : eLpNorm hB (ENNReal.ofReal q) ν ≤ 1 :=
    (eLpNorm_mono (truncateNorm_measurable hhm B).aestronglyMeasurable
      (fun y => norm_truncateNorm_le B h y)).trans hh
  have huB : eLpNorm uB 2 ν ≤ 1 := (htr u hum).trans hu
  have hsum2 : (2 : ENNReal).toReal⁻¹ + (ENNReal.ofReal q).toReal⁻¹ +
      (ENNReal.ofReal q').toReal⁻¹ + (2 : ENNReal).toReal⁻¹ ≤ 2 := by
    rw [ENNReal.toReal_ofReal hq0.le, ENNReal.toReal_ofReal hq'0.le, hq']
    apply le_of_eq
    norm_num
    field_simp
    ring
  have hsum3 : (2 : ENNReal).toReal⁻¹ + (ENNReal.ofReal q).toReal⁻¹ +
      (2 : ENNReal).toReal⁻¹ + (ENNReal.ofReal q').toReal⁻¹ ≤ 2 := by
    have := hsum2; linarith
  have hq1' : (1 : ENNReal) ≤ ENNReal.ofReal q := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (by linarith)
  have hq'1' : (1 : ENNReal) ≤ ENNReal.ofReal q' := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hq'1
  have he1b : ‖localProgressionForm r w e1‖ ≤
      W' * (C₁ * B ^ (-(q - 2) / q) * 1 * 1) := by
    have hb := localProgressionForm_enorm_le_slots hr hw e1
      (measurable_update_slot hf ih (hhm.sub (truncateNorm_measurable hhm B)))
      h1 h2 h3 h4 h5 h6 2 2 2 2 (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num)
    rw [he1, Function.update_of_ne h1, Function.update_self, Function.update_of_ne h4.symm,
      Function.update_of_ne h5.symm] at hb
    exact norm_le_of_enorm_le_four hW0 hC₁ hBe zero_le_one zero_le_one hb hR htail1
      (hu.trans_eq ENNReal.ofReal_one.symm) (hv.trans_eq ENNReal.ofReal_one.symm)
  have he2b : ‖localProgressionForm r w e2‖ ≤
      W' * (C₁ * 1 * B ^ (-(q - 2) / q) * 1) := by
    have hb := localProgressionForm_enorm_le_slots hr hw e2
      (measurable_update_slot hf1m ku (hum.sub (truncateNorm_measurable hum B)))
      h1 h2 h3 h4 h5 h6 2 (ENNReal.ofReal q) (ENNReal.ofReal q') 2 (by norm_num) hq1' hq'1'
      (by norm_num) hsum2
    rw [he2, Function.update_of_ne h2, Function.update_of_ne h4, Function.update_self,
      Function.update_of_ne h6.symm, hf1, Function.update_of_ne h1, Function.update_self,
      Function.update_of_ne h5.symm] at hb
    exact norm_le_of_enorm_le_four hW0 hC₁ zero_le_one hBe zero_le_one hb hR
      (hhBq.trans_eq ENNReal.ofReal_one.symm) (htail2 u hum hu)
      (hv.trans_eq ENNReal.ofReal_one.symm)
  have he3b : ‖localProgressionForm r w e3‖ ≤
      W' * (C₁ * 1 * 1 * B ^ (-(q - 2) / q)) := by
    have hb := localProgressionForm_enorm_le_slots hr hw e3
      (measurable_update_slot hf2m lv (hvm.sub (truncateNorm_measurable hvm B)))
      h1 h2 h3 h4 h5 h6 2 (ENNReal.ofReal q) 2 (ENNReal.ofReal q') (by norm_num) hq1'
      (by norm_num) hq'1' hsum3
    rw [he3, Function.update_of_ne h3, Function.update_of_ne h5, Function.update_of_ne h6,
      Function.update_self, hf2, Function.update_of_ne h2, Function.update_of_ne h4,
      Function.update_self, hf1, Function.update_of_ne h1, Function.update_self] at hb
    exact norm_le_of_enorm_le_four hW0 hC₁ zero_le_one zero_le_one hBe hb hR
      (hhBq.trans_eq ENNReal.ofReal_one.symm) (huB.trans_eq ENNReal.ofReal_one.symm)
      (htail2 v hvm hv)
  rw [hstep1, hstep2, hstep3, hf3eq]
  calc ‖localProgressionForm r w (clipExcept B jR f) + localProgressionForm r w e3 +
        localProgressionForm r w e2 + localProgressionForm r w e1‖
      ≤ ‖localProgressionForm r w (clipExcept B jR f)‖ + ‖localProgressionForm r w e3‖ +
        ‖localProgressionForm r w e2‖ + ‖localProgressionForm r w e1‖ := norm_add₄_le
    _ ≤ _ := by
        have : W' * (C₁ * 1 * B ^ (-(q - 2) / q) * 1) = W' * (C₁ * B ^ (-(q - 2) / q) * 1 * 1) :=
          by ring
        have : W' * (C₁ * 1 * 1 * B ^ (-(q - 2) / q)) = W' * (C₁ * B ^ (-(q - 2) / q) * 1 * 1) :=
          by ring
        linarith

/-- Homogeneity of the local form in one input. -/
theorem localProgressionForm_update_const_smul (r : ℝ) (w : ℝ × ℝ → ℂ) (f : Fin 4 → ℝ → ℂ)
    (k : Fin 4) (c : ℂ) (g : ℝ → ℂ) :
    localProgressionForm r w (Function.update f k (c • g)) =
      c * localProgressionForm r w (Function.update f k g) := by
  have h := localProgressionForm_update_smul r w (Function.update f k g) k c
  rwa [Function.update_self, Function.update_idem] at h

/-- Additivity in one slot when every input has finite normalized `L²` norm. -/
theorem localProgressionForm_update_add_two {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {f : Fin 4 → ℝ → ℂ}
    (hf : ∀ j, Measurable (f j))
    (hfin : ∀ j, eLpNorm (f j) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤) (k : Fin 4)
    {g₁ g₂ : ℝ → ℂ} (hg₁ : Measurable g₁) (hg₂ : Measurable g₂)
    (hg₁f : eLpNorm g₁ 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hg₂f : eLpNorm g₂ 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤) :
    localProgressionForm r w (Function.update f k (g₁ + g₂)) =
      localProgressionForm r w (Function.update f k g₁) +
        localProgressionForm r w (Function.update f k g₂) :=
  localProgressionForm_update_add r w f k g₁ g₂
    (integrable_localProgression_two hr hw _ (measurable_update_slot hf k hg₁)
      (eLpNorm_update_ne_top hfin k hg₁f))
    (integrable_localProgression_two hr hw _ (measurable_update_slot hf k hg₂)
      (eLpNorm_update_ne_top hfin k hg₂f))

/-- Linearity in one slot over a finite sum of finite-norm inputs. -/
theorem localProgressionForm_update_sum {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {f : Fin 4 → ℝ → ℂ}
    (hf : ∀ j, Measurable (f j))
    (hfin : ∀ j, eLpNorm (f j) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤) (k : Fin 4)
    {ι : Type*} (s : Finset ι) (c : ι → ℂ) (φ : ι → ℝ → ℂ) (hφ : ∀ i, Measurable (φ i))
    (hφf : ∀ i, eLpNorm (φ i) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤) :
    localProgressionForm r w (Function.update f k (fun x => ∑ i ∈ s, c i * φ i x)) =
      ∑ i ∈ s, c i * localProgressionForm r w (Function.update f k (φ i)) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    have h := localProgressionForm_update_const_smul r w f k 0 (fun _ => 0)
    rw [zero_smul, zero_mul] at h
    exact h
  | insert i s hi ih =>
    have hS : Measurable (fun x => ∑ j ∈ s, c j * φ j x) :=
      Finset.measurable_sum _ fun j _ => measurable_const.mul (hφ j)
    have hSf : eLpNorm (fun x => ∑ j ∈ s, c j * φ j x) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤ := by
      have hm : MemLp (fun x => ∑ j ∈ s, c j * φ j x) 2 (normalizedIntervalMeasure a₀ r) :=
        memLp_finsetSum s fun j _ =>
          (MemLp.const_mul (show MemLp (φ j) 2 (normalizedIntervalMeasure a₀ r) from
            (hφf j).lt_top) (c j))
      exact hm.eLpNorm_ne_top
    have hci : Measurable (c i • φ i) := (hφ i).const_smul _
    have hcif : eLpNorm (c i • φ i) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤ := by
      rw [eLpNorm_const_smul]; exact ENNReal.mul_ne_top ENNReal.coe_ne_top (hφf i)
    have he : (fun x => ∑ j ∈ insert i s, c j * φ j x) =
        (c i • φ i) + (fun x => ∑ j ∈ s, c j * φ j x) := by
      funext x; simp [Finset.sum_insert hi]
    rw [he, localProgressionForm_update_add_two hr hw hf hfin k hci hS hcif hSf, ih,
      localProgressionForm_update_const_smul, Finset.sum_insert hi]

/-- The local form only sees an input up to a.e. equality on the cell. -/
theorem localProgressionForm_update_congr_ae {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {f : Fin 4 → ℝ → ℂ}
    (hf : ∀ j, Measurable (f j))
    (hfin : ∀ j, eLpNorm (f j) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤) {a b c d : Fin 4}
    (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d)
    {g₁ g₂ : ℝ → ℂ} (hg₁ : Measurable g₁) (hg₂ : Measurable g₂)
    (hg₁f : eLpNorm g₁ 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hg₂f : eLpNorm g₂ 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hae : g₁ =ᵐ[normalizedIntervalMeasure a₀ r] g₂) :
    localProgressionForm r w (Function.update f a g₁) =
      localProgressionForm r w (Function.update f a g₂) := by
  have hdf : eLpNorm (g₁ - g₂) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤ :=
    (eLpNorm_sub_le (by norm_num)).trans_lt
      (ENNReal.add_lt_top.mpr ⟨hg₁f.lt_top, hg₂f.lt_top⟩) |>.ne
  have hsplit := localProgressionForm_update_add_two hr hw hf hfin a hg₂ (hg₁.sub hg₂) hg₂f hdf
  rw [add_sub_cancel] at hsplit
  rw [hsplit]
  suffices h0 : localProgressionForm r w (Function.update f a (g₁ - g₂)) = 0 by
    rw [h0, add_zero]
  have hb := localProgressionForm_enorm_le_slots hr hw _
    (measurable_update_slot hf a (hg₁.sub hg₂)) hab hac had hbc hbd hcd 1 1 ⊤ ⊤ le_rfl le_rfl
    le_top le_top (by norm_num)
  have hz : eLpNorm (Function.update f a (g₁ - g₂) a) 1 (normalizedIntervalMeasure a₀ r) = 0 := by
    rw [Function.update_self]
    rw [eLpNorm_congr_ae (show g₁ - g₂ =ᵐ[normalizedIntervalMeasure a₀ r] 0 by
      filter_upwards [hae] with x hx; simp [hx]), eLpNorm_zero]
  rw [hz, zero_mul, zero_mul, zero_mul, mul_zero] at hb
  exact enorm_eq_zero.mp (le_antisymm hb zero_le)

/-- Four distinct elements exhaust `Fin 4`. -/
theorem fin4_eq_of_distinct : ∀ jR ig kb lc j : Fin 4, jR ≠ ig → jR ≠ kb → jR ≠ lc → ig ≠ kb →
    ig ≠ lc → kb ≠ lc → j = jR ∨ j = ig ∨ j = kb ∨ j = lc := by
  decide

theorem memLp_Ico_of_normalized {a₀ r : ℝ} (hr : 0 < r) {g : ℝ → ℂ}
    (hg : eLpNorm g 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤) :
    MemLp g 2 (volume.restrict (Set.Ico a₀ (a₀ + r))) := by
  have h : MemLp g 2 (normalizedIntervalMeasure a₀ r) := hg.lt_top
  refine h.of_measure_le_smul (c := ENNReal.ofReal r) ENNReal.ofReal_ne_top ?_
  rw [normalizedIntervalMeasure, smul_smul, ← ENNReal.ofReal_mul hr.le, mul_inv_cancel₀ hr.ne',
    ENNReal.ofReal_one, one_smul]
  exact Measure.restrict_mono Set.Ico_subset_Icc_self le_rfl

theorem sqrt_normalized_le_of_eLpNorm {a₀ r : ℝ} (hr : 0 < r) {g : ℝ → ℂ} {C : ℝ}
    (hC : 0 ≤ C) (hg : eLpNorm g 2 (normalizedIntervalMeasure a₀ r) ≤ ENNReal.ofReal C) :
    Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖g y‖ ^ 2) ≤ C := by
  have hm : MemLp g 2 (normalizedIntervalMeasure a₀ r) :=
    lt_of_le_of_lt hg ENNReal.ofReal_lt_top
  rw [hm.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)] at hg
  have hX : 0 ≤ ∫ a, ‖g a‖ ^ (2 : ENNReal).toReal ∂normalizedIntervalMeasure a₀ r :=
    integral_nonneg fun _ => by positivity
  have h := (ENNReal.ofReal_le_ofReal_iff hC).mp hg
  have heq : ∫ a, ‖g a‖ ^ (2 : ENNReal).toReal ∂normalizedIntervalMeasure a₀ r =
      r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖g y‖ ^ 2 := by
    rw [normalizedIntervalMeasure, integral_smul_measure,
      ENNReal.toReal_ofReal (inv_nonneg.mpr hr.le), smul_eq_mul,
      setIntegral_congr_set Ico_ae_eq_Icc.symm]
    congr 2; funext y; simp
  rw [heq] at h hX
  rw [Real.sqrt_eq_rpow]
  simpa using h

/-- The `L²` von Neumann bound with the class constant and normalized norms. -/
theorem vonNeumann_local_L2_const {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ j, Measurable (f j)) {jR ig kb lc : Fin 4}
    (h1 : jR ≠ ig) (h2 : jR ≠ kb) (h3 : jR ≠ lc) (h4 : ig ≠ kb) (h5 : ig ≠ lc) (h6 : kb ≠ lc)
    {C₁ Mb Mc : ℝ} (hC₁ : 0 ≤ C₁)
    (hR : eLpNorm (f jR) 2 (normalizedIntervalMeasure a₀ r) ≤ ENNReal.ofReal C₁)
    (hg : eLpNorm (f ig) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hb : ∀ y ∈ Set.Ico a₀ (a₀ + r), ‖f kb y‖ ≤ Mb)
    (hc : ∀ y ∈ Set.Ico a₀ (a₀ + r), ‖f lc y‖ ≤ Mc) :
    ‖localProgressionForm r w f‖ ≤
      vonNeumannConst κ * C₁ * intervalGowersNorm a₀ (a₀ + r) (f ig) * Mb * Mc := by
  have hRf : eLpNorm (f jR) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top hR
  have hgL := memLp_Ico_of_normalized hr hg
  have h := vonNeumann_local_L2 hr hw f hf h1 h2 h3 h4 h5 h6
    (memLp_Ico_of_normalized hr hRf) hgL hb hc
  have ha : a₀ ∈ Set.Ico a₀ (a₀ + r) := ⟨le_rfl, by linarith⟩
  have hMb : 0 ≤ Mb := (norm_nonneg _).trans (hb a₀ ha)
  have hMc : 0 ≤ Mc := (norm_nonneg _).trans (hc a₀ ha)
  have hU := intervalGowersNorm_nonneg_of_memLp hr (hf ig) hgL
  have hS := sqrt_normalized_le_of_eLpNorm hr hC₁ hR
  have hK : 0 ≤ kernelFourierConst κ := by
    unfold kernelFourierConst
    have := kernelDerivBound_nonneg κ 0
    have := kernelDerivBound_nonneg κ 3
    positivity
  set S := Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖f jR y‖ ^ 2)
  have hS0 : 0 ≤ S := Real.sqrt_nonneg _
  calc ‖localProgressionForm r w f‖ ≤ _ := h
    _ = (kernelFourierConst κ * 64) * S *
        (intervalGowersNorm a₀ (a₀ + r) (f ig) * Mb * Mc) := by ring
    _ ≤ vonNeumannConst κ * C₁ * (intervalGowersNorm a₀ (a₀ + r) (f ig) * Mb * Mc) := by
        gcongr
        · exact le_trans (by positivity) (le_max_left _ _)
        · exact le_max_left _ _
    _ = _ := by ring

/-- The coefficient functions of a finite sum of `L²` classes. -/
theorem Lp_coeFn_finset_sum_ae {X : Type*} [MeasurableSpace X] {μ : Measure X} {ι : Type*}
    (s : Finset ι) (c : ι → ℂ) (a : ι → Lp ℂ 2 μ) (F : ι → X → ℂ)
    (h : ∀ i ∈ s, (a i : X → ℂ) =ᵐ[μ] F i) :
    ((∑ i ∈ s, c i • a i : Lp ℂ 2 μ) : X → ℂ) =ᵐ[μ] fun x => ∑ i ∈ s, c i * F i x := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    filter_upwards [Lp.coeFn_zero ℂ 2 μ] with x hx
    rw [hx]; rfl
  | insert i s hi ih =>
    simp only [Finset.sum_insert hi]
    filter_upwards [Lp.coeFn_add (c i • a i) (∑ j ∈ s, c j • a j), Lp.coeFn_smul (c i) (a i),
      h i (Finset.mem_insert_self i s),
      ih (fun j hj => h j (Finset.mem_insert_of_mem hj))] with x h1 h2 h3 h4
    rw [h1, Pi.add_apply, h2, h4, Pi.smul_apply, h3, smul_eq_mul]

theorem eLpNorm_two_le_of_bound {a₀ r : ℝ} (hr : 0 < r) {g : ℝ → ℂ} (hg : Measurable g)
    {B : ℝ} (hB : ∀ x, ‖g x‖ ≤ B) :
    eLpNorm g 2 (normalizedIntervalMeasure a₀ r) ≤ ENNReal.ofReal B := by
  have : IsProbabilityMeasure (normalizedIntervalMeasure a₀ r) :=
    normalizedIntervalMeasure_probability a₀ hr
  refine (eLpNorm_le_of_ae_bound hg.aestronglyMeasurable
    (Filter.Eventually.of_forall hB)).trans ?_
  simp

theorem eLpNorm_top_le_of_bound {μ : Measure ℝ} {g : ℝ → ℂ} (hg : Measurable g)
    {B : ℝ} (hB : ∀ x, ‖g x‖ ≤ B) : eLpNorm g ⊤ μ ≤ ENNReal.ofReal B := by
  rw [eLpNorm_exponent_top hg.aestronglyMeasurable]
  exact eLpNormEssSup_le_of_ae_bound (Filter.Eventually.of_forall hB)

/-- Blueprint lem:detection, line 1471, one decomposition step: decomposing a
`B`-bounded input by `eq:decomp` at accuracy `τ` and discarding both errors by
`eq:von-neumann` leaves a single bounded atom in its slot with a large form. -/
theorem detection_structured_slot (κ : LocalKernelClass) :
    ∃ (c₀ : ℕ) (D : ℝ → ℝ), 1 ≤ c₀ ∧ QuasipolynomialBound D ∧
    ∀ {a₀ r : ℝ}, 0 < r → ∀ {w : ℝ × ℝ → ℂ}, IsAdmissibleLocalKernel κ a₀ r w →
    ∀ (f : Fin 4 → ℝ → ℂ), (∀ j, Measurable (f j)) →
    ∀ {k jR b c : Fin 4}, k ≠ jR → k ≠ b → k ≠ c → jR ≠ b → jR ≠ c → b ≠ c →
    ∀ {C₁ B δ' τ : ℝ}, 0 ≤ C₁ → 1 ≤ B → 0 < τ → τ < 1 / 2 →
    eLpNorm (f jR) 2 (normalizedIntervalMeasure a₀ r) ≤ ENNReal.ofReal C₁ →
    (∀ x, ‖f k x‖ ≤ B) → (∀ x, ‖f b x‖ ≤ B) → (∀ x, ‖f c x‖ ≤ B) →
    4 * (vonNeumannConst κ * C₁ * B ^ 3 * τ) ≤ δ' →
    δ' < ‖localProgressionForm r w f‖ →
    ∃ (d : ℕ) (A : QuadraticChartData d), QuadraticChartComplexity c₀ (D (1 / τ)) A ∧
      IsBoundedQuadraticChart A ∧
      δ' / (2 * B * max 1 (D (1 / τ))) <
        ‖localProgressionForm r w (Function.update f k (quadraticChartAtom A))‖ := by
  obtain ⟨c₀, D, hc₀, hD, hdec⟩ := continuous_decomposition
  refine ⟨c₀, D, hc₀, hD, ?_⟩
  intro a₀ r hr w hw f hf k jR b c hkR hkb hkc hRb hRc hbc C₁ B δ' τ hC₁ hB hτ hτ2 hR hgk hgb hgc
    hδτ hδ
  classical
  set ν := normalizedIntervalMeasure a₀ r with hν
  have : IsProbabilityMeasure ν := normalizedIntervalMeasure_probability a₀ hr
  have hνμ : ν = intervalProbabilityMeasure a₀ (a₀ + r) :=
    normalizedIntervalMeasure_eq_intervalProbability a₀ hr
  have hB0 : 0 < B := by linarith
  set Cv := vonNeumannConst κ with hCv
  have hCv0 : 0 ≤ Cv := vonNeumannConst_nonneg κ
  -- the normalized input
  set g := f k with hgdef
  set! g' : ℝ → ℂ := ((B : ℂ)⁻¹) • g with hg'def
  have hgm : Measurable g := hf k
  have hg'm : Measurable g' := hgm.const_smul _
  have hg'b : ∀ x, ‖g' x‖ ≤ 1 := by
    intro x
    rw [hg'def, Pi.smul_apply, smul_eq_mul, norm_mul, norm_inv, Complex.norm_real,
      Real.norm_of_nonneg hB0.le, inv_mul_le_iff₀ hB0, mul_one]
    exact hgk x
  have hg'L : MemLp g' 2 ν := MemLp.of_bound hg'm.aestronglyMeasurable 1
    (Filter.Eventually.of_forall hg'b)
  rw [hνμ] at hg'L
  obtain ⟨ι, s, cc, a, u, v, ha, hcs, hu, hv, he⟩ := hdec a₀ (a₀ + r) (by linarith) τ hτ hτ2
    (hg'L.toLp g') (by
      filter_upwards [MemLp.coeFn_toLp hg'L] with x hx
      rw [hx]; exact hg'b x)
  -- the chosen atoms
  have ha' : ∀ i, ∃ (d : ℕ) (A : QuadraticChartData d), i ∈ s →
      (QuadraticChartComplexity c₀ (D (1 / τ)) A ∧ IsBoundedQuadraticChart A ∧
        (a i : ℝ → ℂ) =ᵐ[intervalProbabilityMeasure a₀ (a₀ + r)] quadraticChartAtom A) := by
    intro i
    by_cases hi : i ∈ s
    · obtain ⟨d, A, h⟩ := ha i hi
      exact ⟨d, A, fun _ => h⟩
    · exact ⟨0, ordinaryQuadraticChart 0 0, fun h => absurd h hi⟩
  choose dd AA hAA using ha'
  set! φ : ι → ℝ → ℂ := fun i => if i ∈ s then quadraticChartAtom (AA i) else 0 with hφdef
  have hφm : ∀ i, Measurable (φ i) := by
    intro i; simp only [hφdef]; split_ifs
    · exact quadraticChartAtom_measurable _
    · exact measurable_const
  have hφb : ∀ i x, ‖φ i x‖ ≤ 1 := by
    intro i x; simp only [hφdef]; split_ifs with hi
    · exact (hAA i hi).2.1 x
    · simp
  have hφf : ∀ i, eLpNorm (φ i) 2 ν ≠ ⊤ := fun i =>
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top (eLpNorm_two_le_of_bound hr (hφm i) (hφb i))
  -- error representatives
  set! U := l2Representative (intervalProbabilityMeasure a₀ (a₀ + r)) u with hUdef
  set! V := l2Representative (intervalProbabilityMeasure a₀ (a₀ + r)) v with hVdef
  have hUm : Measurable U := l2Representative_measurable _ u
  have hVm : Measurable V := l2Representative_measurable _ v
  have hUL : MemLp U 2 ν := by rw [hνμ]; exact l2Representative_memLp _ u
  have hVL : MemLp V 2 ν := by rw [hνμ]; exact l2Representative_memLp _ v
  set! G : ℝ → ℂ := fun x => ∑ i ∈ s, cc i * φ i x with hGdef
  have hGm : Measurable G := Finset.measurable_sum _ fun i _ => measurable_const.mul (hφm i)
  have hGL : MemLp G 2 ν := memLp_finsetSum s fun i _ =>
    (show MemLp (φ i) 2 ν from (hφf i).lt_top).const_mul (cc i)
  -- the almost everywhere decomposition of `g'`
  have hae : g' =ᵐ[ν] G + U + V := by
    rw [hνμ]
    have hsum := Lp_coeFn_finset_sum_ae s cc a φ (fun i hi => by
      have h3 := (hAA i hi).2.2
      filter_upwards [h3] with x hx
      simp only [hφdef, hi, ↓reduceIte]; exact hx)
    have hcong := congrArg (fun F : Lp ℂ 2 (intervalProbabilityMeasure a₀ (a₀ + r)) =>
      (F : ℝ → ℂ)) he
    filter_upwards [MemLp.coeFn_toLp hg'L, Lp.coeFn_add (∑ i ∈ s, cc i • a i + u) v,
      Lp.coeFn_add (∑ i ∈ s, cc i • a i) u, hsum, l2Representative_ae _ u,
      l2Representative_ae _ v, Filter.EventuallyEq.of_eq hcong] with x h1 h2 h3 h4 h5 h6 h7
    rw [← h1, h7, h2, Pi.add_apply, h3, Pi.add_apply, h4, Pi.add_apply, Pi.add_apply, ← h5, ← h6]
  -- finiteness of all inputs
  have hfin : ∀ j, eLpNorm (f j) 2 ν ≠ ⊤ := by
    intro j
    rcases fin_four_cover hkR hkb hkc hRb hRc hbc j with rfl | rfl | rfl | rfl
    · exact ne_top_of_le_ne_top ENNReal.ofReal_ne_top (eLpNorm_two_le_of_bound hr (hf _) hgk)
    · exact ne_top_of_le_ne_top ENNReal.ofReal_ne_top hR
    · exact ne_top_of_le_ne_top ENNReal.ofReal_ne_top (eLpNorm_two_le_of_bound hr (hf _) hgb)
    · exact ne_top_of_le_ne_top ENNReal.ofReal_ne_top (eLpNorm_two_le_of_bound hr (hf _) hgc)
  have hg'f : eLpNorm g' 2 ν ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top (eLpNorm_two_le_of_bound hr hg'm hg'b)
  have hUf : eLpNorm U 2 ν ≠ ⊤ := hUL.eLpNorm_ne_top
  have hVf : eLpNorm V 2 ν ≠ ⊤ := hVL.eLpNorm_ne_top
  have hGf : eLpNorm G 2 ν ≠ ⊤ := hGL.eLpNorm_ne_top
  have hGUf : eLpNorm (G + U) 2 ν ≠ ⊤ := (hGL.add hUL).eLpNorm_ne_top
  have hGUVf : eLpNorm (G + U + V) 2 ν ≠ ⊤ := ((hGL.add hUL).add hVL).eLpNorm_ne_top
  -- expansion of the form
  set! S := ∑ i ∈ s, cc i * localProgressionForm r w (Function.update f k (φ i)) with hSdef
  set! EU := localProgressionForm r w (Function.update f k U) with hEU
  set! EV := localProgressionForm r w (Function.update f k V) with hEV
  have hform : localProgressionForm r w f = (B : ℂ) * (S + EU + EV) := by
    have e1 : f = Function.update f k ((B : ℂ) • g') := by
      rw [hg'def, smul_smul, mul_inv_cancel₀ (by exact_mod_cast hB0.ne'), one_smul,
        Function.update_eq_self]
    conv_lhs => rw [e1]
    rw [localProgressionForm_update_const_smul,
      localProgressionForm_update_congr_ae hr hw hf hfin hkR hkb hkc hRb hRc hbc hg'm
        ((hGm.add hUm).add hVm) hg'f hGUVf hae,
      localProgressionForm_update_add_two hr hw hf hfin k (hGm.add hUm) hVm hGUf hVf,
      localProgressionForm_update_add_two hr hw hf hfin k hGm hUm hGf hUf,
      localProgressionForm_update_sum hr hw hf hfin k s cc φ hφm hφf]
  -- the two error terms
  have hU0 : 0 ≤ intervalGowersNorm a₀ (a₀ + r) U :=
    intervalGowersNorm_nonneg_of_memLp hr hUm (memLp_Ico_of_normalized hr hUf)
  have hUτ : intervalGowersNorm a₀ (a₀ + r) U ≤ τ := by
    have hUL' : MemLp U 2 (intervalProbabilityMeasure a₀ (a₀ + r)) := by rw [← hνμ]; exact hUL
    rw [← intervalL2GowersSeminorm_toLp _ _ hUm hUL']
    have : hUL'.toLp U = u := (MemLp.toLp_congr hUL' (Lp.memLp u)
      (l2Representative_ae _ u)).trans (Lp.toLp_coeFn u (Lp.memLp u))
    rw [this]; exact hu
  have hEUb : ‖EU‖ ≤ Cv * C₁ * τ * B * B := by
    have h := vonNeumann_local_L2_const hr hw (Function.update f k U)
      (measurable_update_slot hf k hUm) hkR.symm hRb hRc hkb hkc hbc hC₁
      (by rw [Function.update_of_ne hkR.symm]; exact hR)
      (by rw [Function.update_self]; exact hUf)
      (fun y _ => by rw [Function.update_of_ne hkb.symm]; exact hgb y)
      (fun y _ => by rw [Function.update_of_ne hkc.symm]; exact hgc y)
    rw [Function.update_self] at h
    refine h.trans ?_
    gcongr
  have hEVb : ‖EV‖ ≤ Cv * (C₁ * τ * B * B) := by
    have h := vonNeumann_local_L1 hr hw (Function.update f k V)
      (measurable_update_slot hf k hVm) hkR.symm hRb hRc hkb hkc hbc
    rw [Function.update_of_ne hkR.symm, Function.update_self, Function.update_of_ne hkb.symm,
      Function.update_of_ne hkc.symm] at h
    have hVint : Integrable V ν := ⟨hVm.aestronglyMeasurable,
      (hVL.integrable (by norm_num)).2⟩
    have hV1 : eLpNorm V 1 ν ≤ ENNReal.ofReal τ := by
      rw [eLpNorm_one_eq_lintegral_enorm hVm.aestronglyMeasurable,
        ← ofReal_integral_norm_eq_lintegral_enorm hVint]
      apply ENNReal.ofReal_le_ofReal
      refine le_trans (le_of_eq ?_) hv
      rw [probabilityL2L1Norm_eq, hνμ]
      exact integral_congr_ae (by
        filter_upwards [l2Representative_ae _ v] with x hx
        exact congrArg norm hx)
    exact norm_le_of_enorm_le_four hCv0 hC₁ hτ.le hB0.le hB0.le h
      ((eLpNorm_le_eLpNorm_of_exponent_le (by norm_num)).trans hR) hV1
      (eLpNorm_top_le_of_bound (hf b) hgb) (eLpNorm_top_le_of_bound (hf c) hgc)
  -- the structured part is large
  have hδ0 : 0 ≤ δ' := le_trans (by positivity) hδτ
  have hSlow : δ' / (2 * B) < ‖S‖ := by
    have hnorm : ‖localProgressionForm r w f‖ = B * ‖S + EU + EV‖ := by
      rw [hform, norm_mul, Complex.norm_real, Real.norm_of_nonneg hB0.le]
    have ht : ‖S + EU + EV‖ ≤ ‖S‖ + ‖EU‖ + ‖EV‖ := norm_add₃_le
    have h2 : 2 * (Cv * C₁ * τ * B * B) * B ≤ δ' / 2 := by nlinarith only [hδτ]
    have hBδ : δ' / B < ‖S + EU + EV‖ := by
      rw [div_lt_iff₀ hB0]; linarith
    have : δ' / (2 * B) + Cv * C₁ * τ * B * B + Cv * (C₁ * τ * B * B) ≤ δ' / B := by
      rw [div_add' _ _ _ (by positivity), div_add' _ _ _ (by positivity),
        div_le_div_iff₀ (by positivity) hB0]
      nlinarith only [hB, hδτ]
    linarith
  -- pigeonhole over the structured list
  set M := max 1 (D (1 / τ)) with hM
  have hM1 : 1 ≤ M := le_max_left _ _
  by_contra hcon
  push Not at hcon
  have hterm : ∀ i ∈ s, ‖localProgressionForm r w (Function.update f k (φ i))‖ ≤
      δ' / (2 * B * M) := by
    intro i hi
    have hφi : φ i = quadraticChartAtom (AA i) := by simp only [hφdef, hi, ↓reduceIte]
    rw [hφi]
    exact hcon (dd i) (AA i) (hAA i hi).1 (hAA i hi).2.1
  have hSle : ‖S‖ ≤ δ' / (2 * B) := by
    calc ‖S‖ ≤ ∑ i ∈ s, ‖cc i * localProgressionForm r w (Function.update f k (φ i))‖ :=
          norm_sum_le _ _
      _ ≤ ∑ i ∈ s, ‖cc i‖ * (δ' / (2 * B * M)) := by
          apply Finset.sum_le_sum; intro i hi
          rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hterm i hi) (norm_nonneg _)
      _ = (∑ i ∈ s, ‖cc i‖) * (δ' / (2 * B * M)) := by rw [Finset.sum_mul]
      _ ≤ M * (δ' / (2 * B * M)) := by
          apply mul_le_mul_of_nonneg_right (hcs.trans (le_max_right _ _)) (by positivity)
      _ = δ' / (2 * B) := by field_simp
  linarith

/-- The quasipolynomial budget shape `a ≤ exp(K Y^K)` used in lem:detection. -/
def QPLe (Y : ℝ) (K : ℕ) (a : ℝ) : Prop := a ≤ Real.exp (K * Y ^ K)

namespace QPLe
variable {Y a b : ℝ} {K L : ℕ}

theorem mono (hY : 1 ≤ Y) (hKL : K ≤ L) (h : QPLe Y K a) : QPLe Y L a :=
  h.trans (exp_poly_le hY hKL (by exact_mod_cast hKL))

theorem of_le (hab : a ≤ b) (h : QPLe Y K b) : QPLe Y K a := hab.trans h

theorem one_le (hY : 1 ≤ Y) : QPLe Y K 1 := by
  unfold QPLe; exact Real.one_le_exp (by positivity)

theorem mul (hY : 1 ≤ Y) (hb0 : 0 ≤ b) (ha : QPLe Y K a) (hb : QPLe Y L b) :
    QPLe Y (K + L) (a * b) := by
  unfold QPLe at *
  refine (mul_le_mul ha hb hb0 (Real.exp_pos _).le).trans ?_
  rw [← Real.exp_add]
  apply Real.exp_le_exp.mpr
  have h1 : Y ^ K ≤ Y ^ (K + L) := pow_le_pow_right₀ hY (by omega)
  have h2 : Y ^ L ≤ Y ^ (K + L) := pow_le_pow_right₀ hY (by omega)
  push_cast
  nlinarith [Nat.cast_nonneg (α := ℝ) K, Nat.cast_nonneg (α := ℝ) L]

theorem pow (hY : 1 ≤ Y) (ha0 : 0 ≤ a) (ha : QPLe Y K a) (n : ℕ) :
    QPLe Y (n * K + K) (a ^ n) := by
  unfold QPLe at *
  refine (pow_le_pow_left₀ ha0 ha n).trans ?_
  rw [← Real.exp_nat_mul]
  apply Real.exp_le_exp.mpr
  have h1 : Y ^ K ≤ Y ^ (n * K + K) := pow_le_pow_right₀ hY (by omega)
  have hK0 : (0 : ℝ) ≤ K := Nat.cast_nonneg K
  have hY0 : 0 ≤ Y ^ K := by positivity
  have hnK : (0 : ℝ) ≤ n * K := by positivity
  have hE0 : 0 ≤ Y ^ (n * K + K) := by positivity
  push_cast
  nlinarith [mul_nonneg hnK (sub_nonneg.mpr h1), mul_nonneg hK0 hE0]

theorem const (hY : 1 ≤ Y) (c : ℝ) : QPLe Y ⌈c⌉₊ c := by
  unfold QPLe
  have h1 : c ≤ ⌈c⌉₊ := Nat.le_ceil c
  have h2 : (⌈c⌉₊ : ℝ) ≤ ⌈c⌉₊ * Y ^ ⌈c⌉₊ := le_mul_of_one_le_right (Nat.cast_nonneg _)
    (one_le_pow₀ hY)
  exact h1.trans (h2.trans (Real.add_one_le_exp _ |>.trans' (by linarith)))

theorem log_le (ha0 : 0 < a) (h : QPLe Y K a) : Real.log a ≤ K * Y ^ K := by
  unfold QPLe at h
  rw [← Real.exp_le_exp, Real.exp_log ha0]; exact h

/-- Composition with a quasipolynomial function of `log a`. -/
theorem compose (hY : 1 ≤ Y) {D : ℕ} (ha1 : 1 ≤ a) (ha : QPLe Y K a) :
    QPLe Y (D * (1 + K) ^ D + K * D) (Real.exp (D * (1 + Real.log a) ^ D)) := by
  have hl := log_le (by linarith) ha
  have hl0 : 0 ≤ Real.log a := Real.log_nonneg ha1
  have hYK : 1 ≤ Y ^ K := one_le_pow₀ hY
  have hXs : 1 + Real.log a ≤ (1 + K) * Y ^ K := by nlinarith
  have h := exp_compose_budget (X := Y) (Dw := K) (Ds := D) (by positivity) hXs
  unfold QPLe
  refine h.trans (exp_poly_le hY (Nat.le_add_left _ _) ?_)
  push_cast
  have : (0 : ℝ) ≤ K * D := by positivity
  linarith

end QPLe

theorem real_integral_affine (G : ℝ → ℂ) {c : ℝ} (u : ℝ) :
    ∫ t : ℝ, G (u + c * t) = |c⁻¹| * ∫ s, G s := by
  have h := Measure.integral_comp_mul_left (fun s => G (u + s)) c
  rw [h, integral_add_left_eq_self, Complex.real_smul]

/-- Two distinct real progression slots: the complex form of
`real_progression_pair_lintegral`, with Jacobian `j - i`. -/
theorem real_progression_pair_integral {F G : ℝ → ℂ} (hFm : Measurable F) (hGm : Measurable G)
    (hF : Integrable F) (hG : Integrable G) {i j : ℝ} (hij : i ≠ j) :
    Integrable (fun z : ℝ × ℝ => F (z.1 + i * z.2) * G (z.1 + j * z.2)) ∧
      ∫ z : ℝ × ℝ, F (z.1 + i * z.2) * G (z.1 + j * z.2) =
        |(j - i)⁻¹| * (∫ u, F u) * ∫ v, G v := by
  have hc : j - i ≠ 0 := sub_ne_zero.mpr hij.symm
  have hΦm : Measurable (fun z : ℝ × ℝ => F (z.1 + i * z.2) * G (z.1 + j * z.2)) :=
    (hFm.comp (measurable_fst.add (measurable_const.mul measurable_snd))).mul
      (hGm.comp (measurable_fst.add (measurable_const.mul measurable_snd)))
  have hΦ : Integrable (fun z : ℝ × ℝ => F (z.1 + i * z.2) * G (z.1 + j * z.2)) := by
    refine ⟨hΦm.aestronglyMeasurable, ?_⟩
    unfold HasFiniteIntegral
    have he : ∀ z : ℝ × ℝ, ‖F (z.1 + i * z.2) * G (z.1 + j * z.2)‖ₑ =
        ‖F (z.1 + i * z.2)‖ₑ * ‖G (z.1 + j * z.2)‖ₑ := fun z => enorm_mul _ _
    simp_rw [he]
    rw [real_progression_pair_lintegral (fun u => ‖F u‖ₑ) (fun v => ‖G v‖ₑ) hFm.enorm
      hGm.enorm hij]
    exact ENNReal.mul_lt_top (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hF.2) hG.2
  refine ⟨hΦ, ?_⟩
  -- Fubini, then a shift in the first variable
  have hΨm : Measurable (fun p : ℝ × ℝ => F p.2 * G (p.2 + (j - i) * p.1)) :=
    (hFm.comp measurable_snd).mul
      (hGm.comp (measurable_snd.add (measurable_const.mul measurable_fst)))
  have hΨ : Integrable (fun p : ℝ × ℝ => F p.2 * G (p.2 + (j - i) * p.1))
      (volume.prod volume) := by
    refine ⟨hΨm.aestronglyMeasurable, ?_⟩
    unfold HasFiniteIntegral
    rw [lintegral_prod_symm _ (hΨm.enorm.aemeasurable)]
    have hin (u : ℝ) : ∫⁻ t : ℝ, ‖F u * G (u + (j - i) * t)‖ₑ =
        ‖F u‖ₑ * (ENNReal.ofReal |(j - i)⁻¹| * ∫⁻ v, ‖G v‖ₑ) := by
      simp_rw [enorm_mul]
      rw [lintegral_const_mul _ (show Measurable (fun t : ℝ => ‖G (u + (j - i) * t)‖ₑ) by
          fun_prop),
        real_lintegral_affine (fun v => ‖G v‖ₑ) hGm.enorm hc u]
    simp only [hin]
    rw [lintegral_mul_const _ hFm.enorm]
    exact ENNReal.mul_lt_top hF.2 (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hG.2)
  calc ∫ z : ℝ × ℝ, F (z.1 + i * z.2) * G (z.1 + j * z.2)
      = ∫ x, ∫ t, F (x + i * t) * G (x + j * t) := by
        rw [Measure.volume_eq_prod]; exact integral_prod _ hΦ
    _ = ∫ t, ∫ x, F (x + i * t) * G (x + j * t) := integral_integral_swap hΦ
    _ = ∫ t, ∫ u, F u * G (u + (j - i) * t) := by
        congr 1; funext t
        rw [← integral_add_right_eq_self (μ := volume)
          (fun u => F u * G (u + (j - i) * t)) (i * t)]
        congr 1; funext x; congr 2; ring
    _ = ∫ u, ∫ t, F u * G (u + (j - i) * t) := integral_integral_swap hΨ
    _ = ∫ u, F u * (|(j - i)⁻¹| * ∫ v, G v) := by
        congr 1; funext u
        rw [integral_const_mul, real_integral_affine G u]
    _ = |(j - i)⁻¹| * (∫ u, F u) * ∫ v, G v := by
        rw [integral_mul_const]; ring

/-- `eq:absolute` for the positive local form, with exponents assigned to four distinct slots. -/
theorem localProgression_absolute_le_slots {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ j, Measurable (f j)) {a b c d : Fin 4}
    (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d)
    (pa pb pc pd : ENNReal) (ha : 1 ≤ pa) (hb : 1 ≤ pb) (hc : 1 ≤ pc) (hd : 1 ≤ pd)
    (hsum : pa.toReal⁻¹ + pb.toReal⁻¹ + pc.toReal⁻¹ + pd.toReal⁻¹ ≤ 2) :
    ENNReal.ofReal r⁻¹ ^ 2 *
      (∫⁻ z : ℝ × ℝ, ‖w z * ∏ j, f j (realProgressionCoordinate j z)‖ₑ) ≤
      ENNReal.ofReal (localFormUniformConstant κ) *
      (eLpNorm (f a) pa (normalizedIntervalMeasure a₀ r) *
        eLpNorm (f b) pb (normalizedIntervalMeasure a₀ r) *
        eLpNorm (f c) pc (normalizedIntervalMeasure a₀ r) *
        eLpNorm (f d) pd (normalizedIntervalMeasure a₀ r)) := by
  have hW (z : ℝ × ℝ) : ‖w z‖ₑ ≤ ENNReal.ofReal (localKernelSupBound κ) := by
    rw [← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (admissibleLocalKernel_norm_le hw z)
  set! p : Fin 4 → ENNReal := fun j =>
    if j = a then pa else if j = b then pb else if j = c then pc else pd with hp
  have hpa : p a = pa := by simp [hp]
  have hpb : p b = pb := by simp [hp, hab.symm]
  have hpc : p c = pc := by simp [hp, hac.symm, hbc.symm]
  have hpd : p d = pd := by simp [hp, had.symm, hbd.symm, hcd.symm]
  have hp1 : ∀ i, 1 ≤ p i := by
    intro i
    rcases fin_four_cover hab hac had hbc hbd hcd i with rfl | rfl | rfl | rfl
    · rw [hpa]; exact ha
    · rw [hpb]; exact hb
    · rw [hpc]; exact hc
    · rw [hpd]; exact hd
  have hs : ∑ i, (p i).toReal⁻¹ ≤ 2 := by
    rw [sum_fin_four_perm (fun i => (p i).toReal⁻¹) hab hac had hbc hbd hcd]
    simpa only [hpa, hpb, hpc, hpd] using hsum
  have h := localProgression_absoluteNormBound hr w hw.smooth.continuous.measurable
    (admissibleLocalKernel_support hr.le hw) hW f hf p hp1 hs
  rw [prod_fin_four_perm (fun i => eLpNorm (f i) (p i) (normalizedIntervalMeasure a₀ r))
    hab hac had hbc hbd hcd, hpa, hpb, hpc, hpd] at h
  have hcst : (2 : ENNReal) * ENNReal.ofReal (localKernelSupBound κ) =
      ENNReal.ofReal (localFormUniformConstant κ) := by
    rw [localFormUniformConstant, ENNReal.ofReal_mul (by norm_num)]
    norm_num
  rw [hcst] at h
  have hn (z : ℝ × ℝ) : ‖w z * ∏ i, f i (realProgressionCoordinate i z)‖ₑ =
      ‖w z‖ₑ * ∏ i, ‖f i (realProgressionCoordinate i z)‖ₑ := by
    simp only [← ofReal_norm, norm_mul, norm_prod,
      ENNReal.ofReal_mul (norm_nonneg _),
      ENNReal.ofReal_prod_of_nonneg (fun _ _ => norm_nonneg _)]
  simp_rw [hn]
  exact h

/-- The separated single-scale form `r⁻² ∫ w Q(t) F_a(y_a) F_b(y_b)`. -/
noncomputable def separatedLocalForm (r : ℝ) (w : ℝ × ℝ → ℂ) (Q : ℝ → ℂ) (a b : Fin 4)
    (Fa Fb : ℝ → ℂ) : ℂ :=
  (r : ℂ)⁻¹ ^ 2 * ∫ z : ℝ × ℝ, w z * Q z.2 * Fa (realProgressionCoordinate a z) *
    Fb (realProgressionCoordinate b z)

/-- Blueprint lem:detection, line 1473: expanding an atom pair by lem:separation
expands the local form into separated forms, each bounded by the absolute estimate. -/
theorem localProgressionForm_pair_expansion {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a i k b : Fin 4}
    (hai : a ≠ i) (hak : a ≠ k) (hab : a ≠ b) (hik : i ≠ k) (hib : i ≠ b) (hkb : k ≠ b)
    {R v φ φ' : ℝ → ℂ} (hRm : Measurable R) (hvm : Measurable v) {C₁ : ℝ}
    (hC₁ : 0 ≤ C₁) (hR : eLpNorm R 2 (normalizedIntervalMeasure a₀ r) ≤ ENNReal.ofReal C₁)
    (hv : eLpNorm v 2 (normalizedIntervalMeasure a₀ r) ≤ 1)
    {τ : Type*} [Countable τ] (cf : τ → ℂ) (ψa ψb Q : τ → ℝ → ℂ) (hψam : ∀ q, Measurable (ψa q))
    (hψbm : ∀ q, Measurable (ψb q)) (hQm : ∀ q, Measurable (Q q))
    (hψab : ∀ q y, ‖ψa q y‖ ≤ 1) (hψbb : ∀ q y, ‖ψb q y‖ ≤ 1) (hQb : ∀ q y, ‖Q q y‖ ≤ 1)
    (hcs : Summable (fun q => ‖cf q‖))
    (hexp : ∀ x t : ℝ, HasSum (fun q => cf q * ψa q (x + (a : ℝ) * t) *
      ψb q (x + (b : ℝ) * t) * Q q t) (φ (x + (i : ℝ) * t) * φ' (x + (k : ℝ) * t)))
    (f : Fin 4 → ℝ → ℂ) (hfa : f a = R) (hfi : f i = φ) (hfk : f k = φ') (hfb : f b = v) :
    HasSum (fun q => cf q * separatedLocalForm r w (Q q) a b (fun y => R y * ψa q y)
        (fun y => v y * ψb q y)) (localProgressionForm r w f) ∧
      ∀ q, ‖separatedLocalForm r w (Q q) a b (fun y => R y * ψa q y)
        (fun y => v y * ψb q y)‖ ≤ localFormUniformConstant κ * C₁ := by
  set ν := normalizedIntervalMeasure a₀ r with hν
  have : IsProbabilityMeasure ν := normalizedIntervalMeasure_probability a₀ hr
  set W' := localFormUniformConstant κ with hW'
  have hW0 : 0 ≤ W' := localFormUniformConstant_nonneg κ
  -- the dominating slot configuration `(R, 1, 1, v)`
  set! g : Fin 4 → ℝ → ℂ := fun j => if j = a then R else if j = b then v else fun _ => 1
    with hg
  have hga : g a = R := by simp [hg]
  have hgb : g b = v := by simp [hg, hab.symm]
  have hgi : g i = fun _ => 1 := by simp [hg, hai.symm, hib]
  have hgk : g k = fun _ => 1 := by simp [hg, hak.symm, hkb]
  have hgm : ∀ j, Measurable (g j) := by
    intro j; simp only [hg]; split_ifs
    · exact hRm
    · exact hvm
    · exact measurable_const
  have hone : eLpNorm (fun _ : ℝ => (1 : ℂ)) 2 ν ≤ 1 := by
    refine (eLpNorm_two_le_of_bound hr measurable_const (fun _ => le_of_eq norm_one)).trans ?_
    simp
  have hgfin : ∀ j, eLpNorm (g j) 2 ν ≠ ⊤ := by
    intro j
    rcases fin_four_cover hai hak hab hik hib hkb j with rfl | rfl | rfl | rfl
    · rw [hga]; exact ne_top_of_le_ne_top ENNReal.ofReal_ne_top hR
    · rw [hgi]; exact ne_top_of_le_ne_top ENNReal.one_ne_top hone
    · rw [hgk]; exact ne_top_of_le_ne_top ENNReal.one_ne_top hone
    · rw [hgb]; exact ne_top_of_le_ne_top ENNReal.one_ne_top hv
  have hΦ := integrable_localProgression_two hr hw g hgm hgfin
  have hdom := hΦ.norm
  have hgprod (z : ℝ × ℝ) : ‖w z * ∏ j, g j (realProgressionCoordinate j z)‖ =
      ‖w z‖ * (‖R (realProgressionCoordinate a z)‖ * ‖v (realProgressionCoordinate b z)‖) := by
    rw [norm_mul, prod_fin_four_perm (fun j => g j (realProgressionCoordinate j z)) hai hak hab
      hik hib hkb, hga, hgi, hgk, hgb]
    simp only [norm_mul, mul_one]
  -- the separated integrands
  set! Y : τ → ℝ × ℝ → ℂ := fun q z => w z * Q q z.2 *
    (R (realProgressionCoordinate a z) * ψa q (realProgressionCoordinate a z)) *
    (v (realProgressionCoordinate b z) * ψb q (realProgressionCoordinate b z)) with hY
  have hYm : ∀ q, Measurable (Y q) := by
    intro q
    have hca := (continuous_realProgressionCoordinate a).measurable
    have hcb := (continuous_realProgressionCoordinate b).measurable
    exact ((hw.smooth.continuous.measurable.mul ((hQm q).comp measurable_snd)).mul
      ((hRm.comp hca).mul ((hψam q).comp hca))).mul ((hvm.comp hcb).mul ((hψbm q).comp hcb))
  have hYb : ∀ q z, ‖Y q z‖ ≤ ‖w z * ∏ j, g j (realProgressionCoordinate j z)‖ := by
    intro q z
    rw [hgprod, hY]
    simp only [norm_mul]
    have h1 := hQb q z.2
    have h2 := hψab q (realProgressionCoordinate a z)
    have h3 := hψbb q (realProgressionCoordinate b z)
    have h4 := norm_nonneg (w z)
    have h5 := norm_nonneg (R (realProgressionCoordinate a z))
    have h6 := norm_nonneg (v (realProgressionCoordinate b z))
    calc ‖w z‖ * ‖Q q z.2‖ * (‖R (realProgressionCoordinate a z)‖ *
          ‖ψa q (realProgressionCoordinate a z)‖) * (‖v (realProgressionCoordinate b z)‖ *
          ‖ψb q (realProgressionCoordinate b z)‖)
        ≤ ‖w z‖ * 1 * (‖R (realProgressionCoordinate a z)‖ * 1) *
          (‖v (realProgressionCoordinate b z)‖ * 1) := by gcongr
      _ = _ := by ring
  have hYi : ∀ q, Integrable (Y q) := fun q =>
    hdom.mono' (hYm q).aestronglyMeasurable (Filter.Eventually.of_forall (hYb q))
  set! M₀ := ∫ z, ‖w z * ∏ j, g j (realProgressionCoordinate j z)‖ with hM₀
  have hYn : ∀ q, ∫ z, ‖Y q z‖ ≤ M₀ := fun q =>
    integral_mono (hYi q).norm hdom (hYb q)
  -- the bound on each separated form
  have hM₀ : r⁻¹ ^ 2 * M₀ ≤ W' * C₁ := by
    have ha := localProgression_absolute_le_slots hr hw g hgm hai hak hab hik hib hkb
      2 ⊤ ⊤ 2 (by norm_num) le_top le_top (by norm_num) (by norm_num)
    rw [hga, hgi, hgk, hgb] at ha
    have hone' : eLpNorm (fun _ : ℝ => (1 : ℂ)) ⊤ ν ≤ ENNReal.ofReal 1 :=
      eLpNorm_top_le_of_bound measurable_const (fun _ => le_of_eq norm_one)
    have hrhs : ENNReal.ofReal W' * (eLpNorm R 2 ν * eLpNorm (fun _ : ℝ => (1 : ℂ)) ⊤ ν *
        eLpNorm (fun _ : ℝ => (1 : ℂ)) ⊤ ν * eLpNorm v 2 ν) ≤ ENNReal.ofReal (W' * C₁) := by
      rw [ENNReal.ofReal_mul hW0]
      gcongr
      calc eLpNorm R 2 ν * eLpNorm (fun _ : ℝ => (1 : ℂ)) ⊤ ν *
            eLpNorm (fun _ : ℝ => (1 : ℂ)) ⊤ ν * eLpNorm v 2 ν
          ≤ ENNReal.ofReal C₁ * ENNReal.ofReal 1 * ENNReal.ofReal 1 * 1 := by gcongr
        _ = _ := by simp
    have hl : ENNReal.ofReal (r⁻¹ ^ 2 * M₀) = ENNReal.ofReal r⁻¹ ^ 2 *
        ∫⁻ z, ‖w z * ∏ j, g j (realProgressionCoordinate j z)‖ₑ := by
      rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_pow (by positivity), hM₀,
        ofReal_integral_norm_eq_lintegral_enorm hΦ]
    have h := (hl.trans_le ha).trans hrhs
    exact (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp h
  have hXb : ∀ q, ‖(r : ℂ)⁻¹ ^ 2 * ∫ z, Y q z‖ ≤ W' * C₁ := by
    intro q
    rw [norm_mul, norm_pow, norm_inv, Complex.norm_real, Real.norm_of_nonneg hr.le]
    calc r⁻¹ ^ 2 * ‖∫ z, Y q z‖ ≤ r⁻¹ ^ 2 * M₀ :=
          mul_le_mul_of_nonneg_left ((norm_integral_le_integral_norm _).trans (hYn q))
            (by positivity)
      _ ≤ W' * C₁ := hM₀
  -- the expansion
  have hsepY : ∀ q, separatedLocalForm r w (Q q) a b (fun y => R y * ψa q y)
      (fun y => v y * ψb q y) = (r : ℂ)⁻¹ ^ 2 * ∫ z, Y q z := fun q => rfl
  simp_rw [hsepY]
  refine ⟨?_, hXb⟩
  have hsumm : Summable (fun q => ∫ z, ‖cf q * Y q z‖) := by
    refine Summable.of_nonneg_of_le (fun _ => integral_nonneg fun _ => norm_nonneg _)
      (fun q => ?_) (hcs.mul_right M₀)
    simp_rw [norm_mul]
    rw [integral_const_mul]
    exact mul_le_mul_of_nonneg_left (hYn q) (norm_nonneg _)
  have hint := integral_tsum_of_summable_integral_norm
    (fun q => (hYi q).const_mul (cf q)) hsumm
  -- the integrand of the full form is the sum of the separated integrands
  have hpt : ∀ z : ℝ × ℝ, ∑' q, cf q * Y q z = w z * ∏ j, f j (realProgressionCoordinate j z) := by
    intro z
    have h := (hexp z.1 z.2).mul_left (w z * R (realProgressionCoordinate a z) *
      v (realProgressionCoordinate b z))
    rw [prod_fin_four_perm (fun j => f j (realProgressionCoordinate j z)) hai hak hab hik hib hkb,
      hfa, hfi, hfk, hfb]
    have e : w z * R (realProgressionCoordinate a z) * v (realProgressionCoordinate b z) *
        (φ (z.1 + (i : ℝ) * z.2) * φ' (z.1 + (k : ℝ) * z.2)) =
        w z * (R (realProgressionCoordinate a z) * φ (realProgressionCoordinate i z) *
          φ' (realProgressionCoordinate k z) * v (realProgressionCoordinate b z)) := by
      unfold realProgressionCoordinate; ring
    rw [← e, ← h.tsum_eq]
    congr 1; funext q
    simp only [hY, realProgressionCoordinate]
    ring
  have hform : localProgressionForm r w f = ∑' q, cf q * ((r : ℂ)⁻¹ ^ 2 * ∫ z, Y q z) := by
    unfold localProgressionForm
    simp_rw [← hpt]
    rw [← hint]
    simp_rw [integral_const_mul]
    rw [← tsum_mul_left]
    congr 1; funext q; ring
  rw [hform]
  refine Summable.hasSum ?_
  refine Summable.of_norm_bounded (hcs.mul_right (W' * C₁)) (fun q => ?_)
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_left (hXb q) (norm_nonneg _)

/-- Blueprint lem:detection, line 1473: after truncating the shells, some retained
term of a large absolutely convergent expansion is large. -/
theorem exists_large_retained_term {τ : Type*} (cf X : τ → ℂ) (size : τ → ℝ)
    {E M δ T : ℝ} (hcs : Summable (fun q => ‖cf q‖)) (hE : (∑' q, ‖cf q‖) ≤ E) (hE0 : 0 < E)
    (hX : ∀ q, ‖X q‖ ≤ M) (hM : 0 ≤ M) (hδ0 : 0 ≤ δ)
    (htail : (∑' q, if T ≤ size q then ‖cf q‖ else 0) * M ≤ δ / 2)
    (hδ : δ < ‖∑' q, cf q * X q‖) :
    ∃ q, size q < T ∧ δ / (2 * E) < ‖X q‖ := by
  by_contra hcon
  push Not at hcon
  set g : τ → ℝ := fun q => if T ≤ size q then ‖cf q‖ * M else ‖cf q‖ * (δ / (2 * E)) with hg
  have hgs : Summable g := by
    refine Summable.of_nonneg_of_le (fun q => by simp only [hg]; split_ifs <;> positivity)
      (fun q => ?_) (hcs.mul_right (M + δ / (2 * E)))
    simp only [hg]; split_ifs
    · exact mul_le_mul_of_nonneg_left (by linarith [div_nonneg hδ0 (by positivity : (0:ℝ) ≤ 2 * E)])
        (norm_nonneg _)
    · exact mul_le_mul_of_nonneg_left (by linarith) (norm_nonneg _)
  have hle : ∀ q, ‖cf q * X q‖ ≤ g q := by
    intro q
    rw [norm_mul]; simp only [hg]; split_ifs with h
    · exact mul_le_mul_of_nonneg_left (hX q) (norm_nonneg _)
    · exact mul_le_mul_of_nonneg_left (hcon q (not_le.mp h)) (norm_nonneg _)
  have hsum1 : Summable (fun q => ‖cf q * X q‖) :=
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hle hgs
  have hsplit : ∑' q, g q = (∑' q, if T ≤ size q then ‖cf q‖ else 0) * M +
      (∑' q, if T ≤ size q then 0 else ‖cf q‖) * (δ / (2 * E)) := by
    have hs1 : Summable (fun q => if T ≤ size q then ‖cf q‖ else 0) :=
      Summable.of_nonneg_of_le (fun q => by split_ifs <;> positivity)
        (fun q => by split_ifs <;> simp) hcs
    have hs2 : Summable (fun q => if T ≤ size q then 0 else ‖cf q‖) :=
      Summable.of_nonneg_of_le (fun q => by split_ifs <;> positivity)
        (fun q => by split_ifs <;> simp) hcs
    rw [← tsum_mul_right, ← tsum_mul_right, ← (hs1.mul_right M).tsum_add (hs2.mul_right _)]
    congr 1; funext q; simp only [hg]; split_ifs <;> ring
  have hrest : (∑' q, if T ≤ size q then 0 else ‖cf q‖) ≤ E := by
    refine le_trans (Summable.tsum_le_tsum (fun q => ?_) ?_ hcs) hE
    · split_ifs <;> simp
    · exact Summable.of_nonneg_of_le (fun q => by split_ifs <;> positivity)
        (fun q => by split_ifs <;> simp) hcs
  have hfin : ‖∑' q, cf q * X q‖ ≤ δ := by
    calc ‖∑' q, cf q * X q‖ ≤ ∑' q, ‖cf q * X q‖ := norm_tsum_le_tsum_norm hsum1
      _ ≤ ∑' q, g q := Summable.tsum_le_tsum hle hsum1 hgs
      _ = _ := hsplit
      _ ≤ δ / 2 + E * (δ / (2 * E)) := by
          gcongr
      _ = δ := by field_simp; ring
  linarith

theorem memLp_Icc_of_normalized {a₀ r : ℝ} (hr : 0 < r) {g : ℝ → ℂ}
    (hg : eLpNorm g 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤) :
    MemLp g 2 (volume.restrict (Set.Icc a₀ (a₀ + r))) := by
  have h : MemLp g 2 (normalizedIntervalMeasure a₀ r) := hg.lt_top
  refine h.of_measure_le_smul (c := ENNReal.ofReal r) ENNReal.ofReal_ne_top ?_
  rw [normalizedIntervalMeasure, smul_smul, ← ENNReal.ofReal_mul hr.le, mul_inv_cancel₀ hr.ne',
    ENNReal.ofReal_one, one_smul]

theorem sqrt_normalized_Icc_le_of_eLpNorm {a₀ r : ℝ} (hr : 0 < r) {g : ℝ → ℂ} {C : ℝ}
    (hC : 0 ≤ C) (hg : eLpNorm g 2 (normalizedIntervalMeasure a₀ r) ≤ ENNReal.ofReal C) :
    Real.sqrt (r⁻¹ * ∫ y in Set.Icc a₀ (a₀ + r), ‖g y‖ ^ 2) ≤ C := by
  have h := sqrt_normalized_le_of_eLpNorm hr hC hg
  rwa [setIntegral_congr_set Ico_ae_eq_Icc] at h

/-- Normalized `L¹` control of a normalized `L²` input on the closed cell. -/
theorem integral_indicator_norm_le_of_eLpNorm {a₀ r : ℝ} (hr : 0 < r) {g : ℝ → ℂ}
    (hgm : Measurable g) {C : ℝ} (hC : 0 ≤ C)
    (hg : eLpNorm g 2 (normalizedIntervalMeasure a₀ r) ≤ ENNReal.ofReal C) :
    Integrable ((Set.Icc a₀ (a₀ + r)).indicator g) ∧
      ∫ y, ‖(Set.Icc a₀ (a₀ + r)).indicator g y‖ ≤ r * C := by
  set ν := normalizedIntervalMeasure a₀ r with hν
  have : IsProbabilityMeasure ν := normalizedIntervalMeasure_probability a₀ hr
  have hmem : MemLp g 2 (volume.restrict (Set.Icc a₀ (a₀ + r))) :=
    memLp_Icc_of_normalized hr (ne_top_of_le_ne_top ENNReal.ofReal_ne_top hg)
  have : IsFiniteMeasure (volume.restrict (Set.Icc a₀ (a₀ + r))) := by
    constructor; rw [Measure.restrict_apply_univ]; exact measure_Icc_lt_top
  have hint : IntegrableOn g (Set.Icc a₀ (a₀ + r)) :=
    ⟨hgm.aestronglyMeasurable, (hmem.integrable (by norm_num)).2⟩
  refine ⟨hint.integrable_indicator measurableSet_Icc, ?_⟩
  have hνi : Integrable g ν := by
    refine ⟨hgm.aestronglyMeasurable, ?_⟩
    have : MemLp g 2 ν := lt_of_le_of_lt hg ENNReal.ofReal_lt_top
    exact (this.integrable (by norm_num)).2
  have h1 : ∫ y, ‖g y‖ ∂ν ≤ C := by
    have hl : ENNReal.ofReal (∫ y, ‖g y‖ ∂ν) ≤ ENNReal.ofReal C := by
      rw [ofReal_integral_norm_eq_lintegral_enorm hνi,
        ← eLpNorm_one_eq_lintegral_enorm hgm.aestronglyMeasurable]
      exact (eLpNorm_le_eLpNorm_of_exponent_le (by norm_num)).trans hg
    exact (ENNReal.ofReal_le_ofReal_iff hC).mp hl
  have h2 : ∫ y, ‖g y‖ ∂ν = r⁻¹ * ∫ y in Set.Icc a₀ (a₀ + r), ‖g y‖ := by
    rw [hν, normalizedIntervalMeasure, integral_smul_measure,
      ENNReal.toReal_ofReal (inv_nonneg.mpr hr.le), smul_eq_mul]
  have h3 : ∫ y, ‖(Set.Icc a₀ (a₀ + r)).indicator g y‖ =
      ∫ y in Set.Icc a₀ (a₀ + r), ‖g y‖ := by
    rw [← integral_indicator measurableSet_Icc]
    congr 1; funext y
    by_cases hy : y ∈ Set.Icc a₀ (a₀ + r)
    · simp [Set.indicator_of_mem hy]
    · simp [Set.indicator_of_notMem hy]
  rw [h3]
  rw [h2] at h1
  rw [inv_mul_le_iff₀ hr] at h1
  exact h1

/-- The positive form of `real_progression_pair_integral`. -/
theorem real_progression_pair_integral_norm {F G : ℝ → ℂ} (hFm : Measurable F)
    (hGm : Measurable G) (hF : Integrable F) (hG : Integrable G) {i j : ℝ} (hij : i ≠ j) :
    Integrable (fun z : ℝ × ℝ => ‖F (z.1 + i * z.2)‖ * ‖G (z.1 + j * z.2)‖) ∧
      ∫ z : ℝ × ℝ, ‖F (z.1 + i * z.2)‖ * ‖G (z.1 + j * z.2)‖ =
        |(j - i)⁻¹| * (∫ u, ‖F u‖) * ∫ v, ‖G v‖ := by
  have h := real_progression_pair_integral (F := fun u => ((‖F u‖ : ℝ) : ℂ))
    (G := fun u => ((‖G u‖ : ℝ) : ℂ)) (Complex.measurable_ofReal.comp hFm.norm)
    (Complex.measurable_ofReal.comp hGm.norm) hF.norm.ofReal hG.norm.ofReal hij
  have hi : Integrable (fun z : ℝ × ℝ => ‖F (z.1 + i * z.2)‖ * ‖G (z.1 + j * z.2)‖) := by
    have := h.1.re
    simpa using this
  refine ⟨hi, ?_⟩
  have h2 := h.2
  simp only [← Complex.ofReal_mul] at h2
  rw [integral_complex_ofReal, integral_complex_ofReal, integral_complex_ofReal] at h2
  exact_mod_cast h2

theorem one_le_abs_fin_sub {a b : Fin 4} (hab : a ≠ b) : 1 ≤ |(b : ℝ) - (a : ℝ)| := by
  have h : (a : ℕ) ≠ (b : ℕ) := fun h => hab (Fin.ext h)
  have h' : ((b : ℕ) : ℤ) - (a : ℕ) ≠ 0 := by omega
  have := Int.one_le_abs h'
  have e : |(b : ℝ) - (a : ℝ)| = ((|((b : ℕ) : ℤ) - (a : ℕ)| : ℤ) : ℝ) := by
    push_cast; rfl
  rw [e]; exact_mod_cast this

theorem abs_fin_four_le (a : Fin 4) : |(a : ℝ)| ≤ 3 := by
  rw [abs_of_nonneg (by positivity)]
  have := a.isLt
  have h : (a : ℕ) ≤ 3 := by omega
  exact_mod_cast h

/-- A plateau cutoff is Lipschitz with a fixed constant. -/
theorem plateau_lipschitz {ψ : ℝ → ℝ} (hψ : ContDiff ℝ (⊤ : ℕ∞) ψ) {Kψ : ℕ}
    (hder : ∀ i x, |iteratedDeriv i ψ x| ≤ ((Kψ : ℝ) * (i + 1 : ℝ)) ^ (Kψ * (i + 1)))
    (u v : ℝ) : |ψ v - ψ u| ≤ ((Kψ : ℝ) * 2) ^ (Kψ * 2) * |v - u| := by
  have hd : Differentiable ℝ ψ := hψ.differentiable (by simp)
  have hb : ∀ x ∈ (Set.univ : Set ℝ), ‖deriv ψ x‖ ≤ ((Kψ : ℝ) * 2) ^ (Kψ * 2) := by
    intro x _
    have := hder 1 x
    rw [iteratedDeriv_one] at this
    rw [Real.norm_eq_abs]
    norm_num at this ⊢
    exact this
  have h := (convex_univ).norm_image_sub_le_of_norm_deriv_le (fun x _ => hd x) hb
    (Set.mem_univ u) (Set.mem_univ v)
  simpa [Real.norm_eq_abs] using h

theorem plateau_integrable {ψ : ℝ → ℝ} (hψ : ContDiff ℝ (⊤ : ℕ∞) ψ)
    (hψ0 : ∀ x, 2 ≤ |x| → ψ x = 0) : Integrable ψ := by
  apply hψ.continuous.integrable_of_hasCompactSupport
  apply HasCompactSupport.intro (isCompact_Icc (a := -2) (b := 2))
  intro x hx
  apply hψ0
  simp only [Set.mem_Icc, not_and_or, not_le] at hx
  rcases hx with hx | hx
  · rw [abs_of_neg (by linarith)]; linarith
  · rw [abs_of_pos (by linarith)]; linarith

/-- Blueprint lem:detection, line 1473: a large separated form forces `A_r` to be large,
its kernel is separated by lem:separation, and one normalized moment of `R` against
`ψ_a e(α ·)` is large. -/
theorem separated_moment_extraction (κ : LocalKernelClass) (c₁ : ℕ) (hc₁ : 1 ≤ c₁) :
    ∃ (Dk : ℕ) (Lζ : ℝ), 1 ≤ Dk ∧ 1 ≤ Lζ ∧
    ∀ {d : ℕ} {a₀ r H₁ C₁ δ₃ Λ : ℝ} (A : QuadraticChartData d),
      QuadraticChartComplexity c₁ H₁ A → IsBoundedQuadraticChart A → 0 < r →
      ∀ {w : ℝ × ℝ → ℂ}, IsAdmissibleLocalKernel κ a₀ r w → ∀ {a b : Fin 4}, a ≠ b →
      ∀ {R v ψa ψb : ℝ → ℂ}, Measurable R → Measurable v → Measurable ψa → Measurable ψb →
      (∀ y, ‖ψa y‖ ≤ 1) → (∀ y, ‖ψb y‖ ≤ 1) → 1 ≤ C₁ →
      eLpNorm R 2 (normalizedIntervalMeasure a₀ r) ≤ ENNReal.ofReal C₁ →
      eLpNorm v 2 (normalizedIntervalMeasure a₀ r) ≤ 1 → 0 < δ₃ →
      δ₃ < ‖separatedLocalForm r w (quadraticChartAtom A) a b (fun y => R y * ψa y)
        (fun y => v y * ψb y)‖ →
      1 ≤ Λ → H₁ ≤ Λ → Lζ ≤ Λ → (kernelFourierConst κ + 1) * C₁ / δ₃ ≤ Λ →
      2 * C₁ / δ₃ ≤ Λ →
      ∃ α : ℝ, δ₃ / (2 * Real.exp (Dk * (1 + 3 * Real.log Λ) ^ Dk)) ≤
        r⁻¹ * ‖∫ y in Set.Icc a₀ (a₀ + r), R y * ψa y * (Real.fourierChar (α * y) : ℂ)‖ := by
  obtain ⟨ψ, Kψ, hKψ, hψ, hψ1', hψ1, hψ0, hψd⟩ := exists_plateau_cutoff
  obtain ⟨Dk, hDk, happrox⟩ := separatedKernelApprox c₁ hc₁ 2 (by norm_num) κ
  refine ⟨Dk, max 1 (((Kψ : ℝ) * 2) ^ (Kψ * 2)), hDk, le_max_left _ _, ?_⟩
  intro d a₀ r H₁ C₁ δ₃ Λ A hA hAb hr w hw a b hab R v ψa ψb hRm hvm hψam hψbm hψab hψbb hC₁
    hR hv hδ₃ hX hΛ1 hHΛ hLΛ hΛ2 hΛ3
  set ν := normalizedIntervalMeasure a₀ r with hν
  have : IsProbabilityMeasure ν := normalizedIntervalMeasure_probability a₀ hr
  set I := Set.Icc a₀ (a₀ + r) with hI
  set K' := kernelFourierConst κ with hK'
  have hK0 : 0 ≤ K' := by
    rw [hK']; unfold kernelFourierConst
    have := kernelDerivBound_nonneg κ 0
    have := kernelDerivBound_nonneg κ 3
    positivity
  have hC0 : 0 < C₁ := by linarith
  -- the cutoff
  set! ζ : ℝ → ℂ := fun u => ((ψ u : ℝ) : ℂ) with hζ
  have hζm : Measurable ζ := Complex.measurable_ofReal.comp hψ.continuous.measurable
  have hζb : ∀ u, ‖ζ u‖ ≤ Λ := fun u => by
    rw [hζ, Complex.norm_real, Real.norm_eq_abs]; exact (hψ1' u).trans hΛ1
  have hζL : ∀ u v, ‖ζ v - ζ u‖ ≤ Λ * |v - u| := by
    intro u v
    rw [hζ, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
    refine (plateau_lipschitz hψ hψd u v).trans ?_
    exact mul_le_mul_of_nonneg_right ((le_max_right _ _).trans hLΛ) (abs_nonneg _)
  have hζs : ∀ u, ζ u ≠ 0 → |u| ≤ 2 := by
    intro u hu
    by_contra h
    exact hu (by simp only [hζ, hψ0 u (not_le.mp h).le, Complex.ofReal_zero])
  -- the two separated inputs
  set Fa : ℝ → ℂ := fun y => R y * ψa y with hFa
  set Fb : ℝ → ℂ := fun y => v y * ψb y with hFb
  have hFam : Measurable Fa := hRm.mul hψam
  have hFbm : Measurable Fb := hvm.mul hψbm
  have hFale : ∀ y, ‖Fa y‖ ≤ ‖R y‖ := fun y => by
    rw [hFa, norm_mul]; simpa using mul_le_mul_of_nonneg_left (hψab y) (norm_nonneg (R y))
  have hFble : ∀ y, ‖Fb y‖ ≤ ‖v y‖ := fun y => by
    rw [hFb, norm_mul]; simpa using mul_le_mul_of_nonneg_left (hψbb y) (norm_nonneg (v y))
  have hFa2 : eLpNorm Fa 2 ν ≤ ENNReal.ofReal C₁ :=
    (eLpNorm_mono hFam.aestronglyMeasurable hFale).trans hR
  have hFb2 : eLpNorm Fb 2 ν ≤ ENNReal.ofReal 1 :=
    ((eLpNorm_mono hFbm.aestronglyMeasurable hFble).trans hv).trans_eq ENNReal.ofReal_one.symm
  -- `A_r` is large
  set! δ₂ := δ₃ / ((K' + 1) * C₁) with hδ₂
  have hδ₂0 : 0 < δ₂ := by positivity
  have hAr : ∀ s < δ₂, ∃ ξ : ℝ, s < ‖∫ u, (Real.fourierChar (-(u * ξ)) : ℂ) *
      (ζ u * quadraticChartAtom A (r * u))‖ := by
    intro s hs
    by_contra hcon
    push Not at hcon
    have hs0 : 0 ≤ s := (norm_nonneg _).trans (hcon 0)
    have hM : ∀ ξ, ‖∫ u, quadraticChartAtom A (r * u) * ((ψ u : ℝ) : ℂ) *
        (Real.fourierChar (-(ξ * u)) : ℂ)‖ ≤ s := by
      intro ξ
      refine le_of_eq_of_le ?_ (hcon ξ)
      congr 1; congr 1; funext u; rw [hζ, mul_comm ξ u]; ring
    have hsep := separated_form_le hr hw a b hab (quadraticChartAtom_measurable A) hAb
      (plateau_integrable hψ hψ0) hψ1 hM hFam hFbm
      (memLp_Icc_of_normalized hr (ne_top_of_le_ne_top ENNReal.ofReal_ne_top hFa2))
      (memLp_Icc_of_normalized hr (ne_top_of_le_ne_top ENNReal.ofReal_ne_top hFb2))
    have hSa := sqrt_normalized_Icc_le_of_eLpNorm hr hC0.le hFa2
    have hSb := sqrt_normalized_Icc_le_of_eLpNorm hr zero_le_one hFb2
    change ‖separatedLocalForm r w (quadraticChartAtom A) a b Fa Fb‖ ≤ _ at hsep
    have h1 : K' * s * Real.sqrt (r⁻¹ * ∫ x in I, ‖Fa x‖ ^ 2) *
        Real.sqrt (r⁻¹ * ∫ x in I, ‖Fb x‖ ^ 2) ≤ K' * δ₂ * C₁ * 1 := by
      gcongr
    have h2 : K' * δ₂ * C₁ * 1 ≤ δ₃ := by
      rw [hδ₂, mul_one]
      have : (K' + 1) * C₁ * (δ₃ / ((K' + 1) * C₁)) = δ₃ := by field_simp
      nlinarith only [div_pos hδ₃ (by positivity : (0 : ℝ) < (K' + 1) * C₁), hC₁, this]
    linarith
  -- uniform separation of the kernel
  set! ε₀ := min 1 (δ₃ / (2 * C₁)) with hε₀
  have hε₀0 : 0 < ε₀ := lt_min one_pos (by positivity)
  have hε₀1 : ε₀ ≤ 1 := min_le_left _ _
  have hε₀C : ε₀ * C₁ ≤ δ₃ / 2 := by
    have := min_le_right 1 (δ₃ / (2 * C₁))
    calc ε₀ * C₁ ≤ δ₃ / (2 * C₁) * C₁ := mul_le_mul_of_nonneg_right this hC0.le
      _ = δ₃ / 2 := by field_simp
  have happ := happrox Λ δ₂ ε₀ r a₀ A (quadraticChartComplexity_mono hA hHΛ) hr w hw ζ hζm
    hζb hζL hζs hδ₂0 hε₀0 hε₀1 hAr (a : ℝ) (b : ℝ) (one_le_abs_fin_sub hab)
    (abs_fin_four_le a)
  obtain ⟨ι', hι', c, α, β, -, hcsum, hpt⟩ := happ
  set Eb := Real.exp (Dk * (1 + 3 * Real.log Λ) ^ Dk) with hEb
  have hlogΛ : 0 ≤ Real.log Λ := Real.log_nonneg hΛ1
  have hE₂ : Real.exp (Dk * (1 + Real.log Λ + Real.log (max 1 δ₂⁻¹) + Real.log ε₀⁻¹) ^ Dk)
      ≤ Eb := by
    apply Real.exp_le_exp.mpr
    apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
    have h1 : Real.log (max 1 δ₂⁻¹) ≤ Real.log Λ := by
      apply Real.log_le_log (lt_of_lt_of_le one_pos (le_max_left _ _))
      apply max_le hΛ1
      rw [hδ₂, inv_div]; exact hΛ2
    have h2 : Real.log ε₀⁻¹ ≤ Real.log Λ := by
      apply Real.log_le_log (inv_pos.mpr hε₀0)
      rw [inv_le_comm₀ hε₀0 (by linarith)]
      apply le_min (inv_le_one_of_one_le₀ hΛ1)
      rw [inv_le_comm₀ (by linarith) (by positivity), inv_div]; exact hΛ3
    have h3 : 0 ≤ Real.log (max 1 δ₂⁻¹) := Real.log_nonneg (le_max_left _ _)
    have h4 : 0 ≤ Real.log ε₀⁻¹ := Real.log_nonneg (one_le_inv₀ hε₀0 |>.mpr hε₀1)
    exact pow_le_pow_left₀ (by positivity) (by linarith) Dk
  have hcsum' : (∑ ν, ‖c ν‖) ≤ Eb := hcsum.trans hE₂
  have hEb0 : 0 < Eb := Real.exp_pos _
  -- restricted inputs
  set! Ga := I.indicator Fa with hGa
  set! Gb := I.indicator Fb with hGb
  have hGam : Measurable Ga := hFam.indicator measurableSet_Icc
  have hGbm : Measurable Gb := hFbm.indicator measurableSet_Icc
  obtain ⟨hGai, hGan⟩ := integral_indicator_norm_le_of_eLpNorm hr hFam hC0.le hFa2
  obtain ⟨hGbi, hGbn⟩ := integral_indicator_norm_le_of_eLpNorm hr hFbm zero_le_one hFb2
  have hab' : (a : ℝ) ≠ (b : ℝ) := by
    intro h; have := one_le_abs_fin_sub hab; rw [h, sub_self, abs_zero] at this; linarith
  obtain ⟨hPi, hPeq⟩ := real_progression_pair_integral_norm hGam hGbm hGai hGbi hab'
  have hjac : |((b : ℝ) - (a : ℝ))⁻¹| ≤ 1 := by
    rw [abs_inv]; exact inv_le_one_of_one_le₀ (one_le_abs_fin_sub hab)
  set! Φ1 : ℝ × ℝ → ℂ := fun z => w z * quadraticChartAtom A z.2 *
    Ga (realProgressionCoordinate a z) * Gb (realProgressionCoordinate b z) with hΦ1
  have hXr : separatedLocalForm r w (quadraticChartAtom A) a b Fa Fb =
      (r : ℂ)⁻¹ ^ 2 * ∫ z, Φ1 z := by
    unfold separatedLocalForm; congr 2; funext z
    by_cases hz : w z = 0
    · simp [hΦ1, hz]
    have hs := admissibleLocalKernel_support hr.le hw z hz
    simp only [hΦ1, hGa, hGb]
    rw [Set.indicator_of_mem (show realProgressionCoordinate a z ∈ I from hs a),
      Set.indicator_of_mem (show realProgressionCoordinate b z ∈ I from hs b)]
  -- the separated approximation
  set! Ap : ℝ × ℝ → ℂ := fun z => ∑ ν, c ν *
    (Real.fourierChar (α ν * realProgressionCoordinate a z) : ℂ) *
    (Real.fourierChar (β ν * realProgressionCoordinate b z) : ℂ) with hAp
  set! Φ2 : ℝ × ℝ → ℂ := fun z => Ap z * Ga (realProgressionCoordinate a z) *
    Gb (realProgressionCoordinate b z) with hΦ2
  have hpw : ∀ z, ‖Φ1 z - Φ2 z‖ ≤ ε₀ * (‖Ga (realProgressionCoordinate a z)‖ *
      ‖Gb (realProgressionCoordinate b z)‖) := by
    intro z
    by_cases hya : realProgressionCoordinate a z ∈ I
    · by_cases hyb : realProgressionCoordinate b z ∈ I
      · have h := hpt _ _ hya hyb
        have ht : (realProgressionCoordinate b z - realProgressionCoordinate a z) /
            ((b : ℝ) - (a : ℝ)) = z.2 := by
          unfold realProgressionCoordinate
          field_simp [sub_ne_zero.mpr hab'.symm]
          ring
        rw [ht] at h
        have hx : realProgressionCoordinate a z - (a : ℝ) * z.2 = z.1 := by
          unfold realProgressionCoordinate; ring
        rw [hx, Prod.mk.eta] at h
        have e : Φ1 z - Φ2 z = (w z * quadraticChartAtom A z.2 - Ap z) *
            (Ga (realProgressionCoordinate a z) * Gb (realProgressionCoordinate b z)) := by
          simp only [hΦ1, hΦ2]; ring
        rw [e, norm_mul, norm_mul]
        exact mul_le_mul_of_nonneg_right h (by positivity)
      · simp [hΦ1, hΦ2, Set.indicator_of_notMem hyb, hGb]
    · simp [hΦ1, hΦ2, Set.indicator_of_notMem hya, hGa]
  -- integrability
  set! S := localKernelSupBound κ with hS
  have hΦ1m : Measurable Φ1 := by
    have hca := (continuous_realProgressionCoordinate a).measurable
    have hcb := (continuous_realProgressionCoordinate b).measurable
    exact ((hw.smooth.continuous.measurable.mul
      ((quadraticChartAtom_measurable A).comp measurable_snd)).mul (hGam.comp hca)).mul
      (hGbm.comp hcb)
  have hΦ1i : Integrable Φ1 := by
    refine (hPi.const_mul S).mono' hΦ1m.aestronglyMeasurable
      (Filter.Eventually.of_forall fun z => ?_)
    simp only [hΦ1, norm_mul]
    have h1 := admissibleLocalKernel_norm_le hw z
    have h2 := hAb z.2
    have h3 := norm_nonneg (Ga (realProgressionCoordinate a z))
    have h4 := norm_nonneg (Gb (realProgressionCoordinate b z))
    have h5 := norm_nonneg (w z)
    calc ‖w z‖ * ‖quadraticChartAtom A z.2‖ * ‖Ga (realProgressionCoordinate a z)‖ *
          ‖Gb (realProgressionCoordinate b z)‖
        ≤ S * 1 * ‖Ga (realProgressionCoordinate a z)‖ * ‖Gb (realProgressionCoordinate b z)‖ := by
          gcongr
          exact localKernelSupBound_nonneg κ
      _ = S * (‖Ga (z.1 + (a : ℝ) * z.2)‖ * ‖Gb (z.1 + (b : ℝ) * z.2)‖) := by
          unfold realProgressionCoordinate; ring
  set! F : ι' → ℝ → ℂ := fun ν y => (Real.fourierChar (α ν * y) : ℂ) * Ga y with hF
  set! G : ι' → ℝ → ℂ := fun ν y => (Real.fourierChar (β ν * y) : ℂ) * Gb y with hG
  have hFm : ∀ ν, Measurable (F ν) := fun ν =>
    ((continuous_subtype_val.comp Real.continuous_fourierChar).measurable.comp
      (measurable_const.mul measurable_id)).mul hGam
  have hGm : ∀ ν, Measurable (G ν) := fun ν =>
    ((continuous_subtype_val.comp Real.continuous_fourierChar).measurable.comp
      (measurable_const.mul measurable_id)).mul hGbm
  have hFn : ∀ ν y, ‖F ν y‖ = ‖Ga y‖ := fun ν y => by simp [hF]
  have hGn : ∀ ν y, ‖G ν y‖ = ‖Gb y‖ := fun ν y => by simp [hG]
  have hFi : ∀ ν, Integrable (F ν) := fun ν =>
    hGai.norm.mono' (hFm ν).aestronglyMeasurable
      (Filter.Eventually.of_forall fun y => le_of_eq (hFn ν y))
  have hGi : ∀ ν, Integrable (G ν) := fun ν =>
    hGbi.norm.mono' (hGm ν).aestronglyMeasurable
      (Filter.Eventually.of_forall fun y => le_of_eq (hGn ν y))
  have hpair := fun ν => real_progression_pair_integral (hFm ν) (hGm ν) (hFi ν) (hGi ν) hab'
  have hΦ2eq : Φ2 = fun z =>
      ∑ ν, c ν * (F ν (z.1 + (a : ℝ) * z.2) * G ν (z.1 + (b : ℝ) * z.2)) := by
    funext z
    simp only [hΦ2, hAp, hF, hG, Finset.sum_mul]
    apply Finset.sum_congr rfl; intro ν _
    unfold realProgressionCoordinate; ring
  have hΦ2i : Integrable Φ2 := by
    rw [hΦ2eq]; exact integrable_finsetSum _ fun ν _ => (hpair ν).1.const_mul (c ν)
  have hΦ2int : ∫ z, Φ2 z = ∑ ν, c ν * (|((b : ℝ) - (a : ℝ))⁻¹| * (∫ y, F ν y) * ∫ y, G ν y) := by
    rw [hΦ2eq, integral_finsetSum _ fun ν _ => (hpair ν).1.const_mul (c ν)]
    apply Finset.sum_congr rfl; intro ν _
    rw [integral_const_mul, (hpair ν).2]
  -- the error of the separated approximation
  have herr : ‖(∫ z, Φ1 z) - ∫ z, Φ2 z‖ ≤ ε₀ * (r * C₁ * (r * 1)) := by
    rw [← integral_sub hΦ1i hΦ2i]
    refine (norm_integral_le_integral_norm _).trans ?_
    have hpw' : ∀ z, ‖(Φ1 - Φ2) z‖ ≤ ε₀ * (‖Ga (z.1 + (a : ℝ) * z.2)‖ *
        ‖Gb (z.1 + (b : ℝ) * z.2)‖) := fun z => hpw z
    refine (integral_mono (hΦ1i.sub hΦ2i).norm (hPi.const_mul ε₀) hpw').trans ?_
    rw [integral_const_mul, hPeq]
    apply mul_le_mul_of_nonneg_left _ hε₀0.le
    have hGa0 : 0 ≤ ∫ u, ‖Ga u‖ := integral_nonneg fun _ => norm_nonneg _
    have hGb0 : 0 ≤ ∫ u, ‖Gb u‖ := integral_nonneg fun _ => norm_nonneg _
    calc |((b : ℝ) - (a : ℝ))⁻¹| * (∫ u, ‖Ga u‖) * ∫ v, ‖Gb v‖
        ≤ 1 * (r * C₁) * (r * 1) := by gcongr
      _ = _ := by ring
  -- the moments
  have hmomF : ∀ ν, ∫ y, F ν y = ∫ y in I, R y * ψa y * (Real.fourierChar (α ν * y) : ℂ) := by
    intro ν
    rw [← integral_indicator measurableSet_Icc]
    congr 1; funext y
    by_cases hy : y ∈ I
    · simp only [hF, hGa, hFa, Set.indicator_of_mem hy]
      rw [Set.indicator_of_mem (show y ∈ Set.Icc a₀ (a₀ + r) from hy)]; ring
    · simp only [hF, hGa, Set.indicator_of_notMem hy, mul_zero]
      rw [Set.indicator_of_notMem (show y ∉ Set.Icc a₀ (a₀ + r) from hy)]
  have hmomG : ∀ ν, r⁻¹ * ‖∫ y, G ν y‖ ≤ 1 := by
    intro ν
    have h : ‖∫ y, G ν y‖ ≤ ∫ y, ‖Gb y‖ :=
      (norm_integral_le_integral_norm (G ν)).trans (le_of_eq (integral_congr_ae
        (Filter.Eventually.of_forall fun y => hGn ν y)))
    rw [inv_mul_le_iff₀ hr]
    linarith
  by_contra hcon
  push Not at hcon
  have hX' : ‖separatedLocalForm r w (quadraticChartAtom A) a b Fa Fb‖ ≤ δ₃ := by
    rw [hXr]
    have hsplit : (r : ℂ)⁻¹ ^ 2 * ∫ z, Φ1 z = (r : ℂ)⁻¹ ^ 2 * (∫ z, Φ2 z) +
        (r : ℂ)⁻¹ ^ 2 * ((∫ z, Φ1 z) - ∫ z, Φ2 z) := by ring
    have hrr : ‖((r : ℂ)⁻¹ ^ 2)‖ = r⁻¹ ^ 2 := by
      rw [norm_pow, norm_inv, Complex.norm_real, Real.norm_of_nonneg hr.le]
    have hmain : ‖(r : ℂ)⁻¹ ^ 2 * ∫ z, Φ2 z‖ ≤ δ₃ / 2 := by
      rw [hΦ2int, Finset.mul_sum]
      refine (norm_sum_le _ _).trans ?_
      have hterm : ∀ ν, ‖(r : ℂ)⁻¹ ^ 2 * (c ν * (|((b : ℝ) - (a : ℝ))⁻¹| * (∫ y, F ν y) *
          ∫ y, G ν y))‖ ≤ ‖c ν‖ * (δ₃ / (2 * Eb)) := by
        intro ν
        have hm := hcon (α ν)
        rw [← hmomF ν] at hm
        have hg := hmomG ν
        rw [norm_mul, hrr, norm_mul, norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_abs]
        have e : r⁻¹ ^ 2 * (‖c ν‖ * (|((b : ℝ) - (a : ℝ))⁻¹| * ‖∫ y, F ν y‖ * ‖∫ y, G ν y‖)) =
            ‖c ν‖ * (|((b : ℝ) - (a : ℝ))⁻¹| * (r⁻¹ * ‖∫ y, F ν y‖) *
              (r⁻¹ * ‖∫ y, G ν y‖)) := by ring
        rw [e]
        apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
        have h0 : 0 ≤ r⁻¹ * ‖∫ y, F ν y‖ := by positivity
        calc |((b : ℝ) - (a : ℝ))⁻¹| * (r⁻¹ * ‖∫ y, F ν y‖) * (r⁻¹ * ‖∫ y, G ν y‖)
            ≤ 1 * (δ₃ / (2 * Eb)) * 1 := by
              gcongr
          _ = _ := by ring
      calc ∑ ν, ‖(r : ℂ)⁻¹ ^ 2 * (c ν * (|((b : ℝ) - (a : ℝ))⁻¹| * (∫ y, F ν y) *
            ∫ y, G ν y))‖ ≤ ∑ ν, ‖c ν‖ * (δ₃ / (2 * Eb)) := Finset.sum_le_sum fun ν _ => hterm ν
        _ = (∑ ν, ‖c ν‖) * (δ₃ / (2 * Eb)) := by rw [Finset.sum_mul]
        _ ≤ Eb * (δ₃ / (2 * Eb)) := by gcongr
        _ = δ₃ / 2 := by field_simp
    have herr' : ‖(r : ℂ)⁻¹ ^ 2 * ((∫ z, Φ1 z) - ∫ z, Φ2 z)‖ ≤ δ₃ / 2 := by
      rw [norm_mul, hrr]
      calc r⁻¹ ^ 2 * ‖(∫ z, Φ1 z) - ∫ z, Φ2 z‖ ≤ r⁻¹ ^ 2 * (ε₀ * (r * C₁ * (r * 1))) :=
            mul_le_mul_of_nonneg_left herr (by positivity)
        _ = ε₀ * C₁ := by field_simp
        _ ≤ δ₃ / 2 := hε₀C
    rw [hsplit]
    refine (norm_add_le _ _).trans ?_
    linarith
  exact absurd hX (not_lt.mpr hX')

/-- The witness chart `conj(ψ_a e(α ·))` of a moment `∫ R ψ_a e(α ·)`. -/
theorem moment_witness_chart {d c₁ : ℕ} {H₁ : ℝ} (A : QuadraticChartData d)
    (hA : QuadraticChartComplexity c₁ H₁ A) (hAb : IsBoundedQuadraticChart A) (hc₁ : 1 ≤ c₁)
    (α : ℝ) :
    ∃ Φ : QuadraticChartData (d + 0), QuadraticChartComplexity c₁ (H₁ ^ 6) Φ ∧
      IsBoundedQuadraticChart Φ ∧ ∀ y, conj (quadraticChartAtom Φ y) =
        quadraticChartAtom A y * (Real.fourierChar (α * y) : ℂ) := by
  refine ⟨conjugateQuadraticChart (productQuadraticChart A (ordinaryQuadraticChart 0 α)),
    conjugateQuadraticChart_complexity (productQuadraticChart_complexity hA
      (ordinaryQuadraticChart_complexity c₁ hA.lower 0 α) hc₁),
    conjugateQuadraticChart_bounded (productQuadraticChart_bounded hAb
      (ordinaryQuadraticChart_bounded 0 α)), fun y => ?_⟩
  rw [conjugateQuadraticChart_atom, productQuadraticChart_atom, ordinaryQuadraticChart_atom]
  simp

theorem intervalIntegral_eq_Icc {a₀ r : ℝ} (hr : 0 < r) (F : ℝ → ℂ) :
    ∫ x in a₀..a₀ + r, F x = ∫ x in Set.Icc a₀ (a₀ + r), F x := by
  rw [intervalIntegral.integral_of_le (by linarith), integral_Icc_eq_integral_Ioc]

theorem qple_max {Y a b : ℝ} {K : ℕ} (ha : QPLe Y K a) (hb : QPLe Y K b) :
    QPLe Y K (max a b) := max_le ha hb

theorem qple_of_exp_Y {Y a : ℝ} (ha : 0 < a) (h : Real.log a ≤ Y) : QPLe Y 1 a := by
  unfold QPLe
  rw [← Real.exp_log ha]; simpa using h

theorem fin_cast_int_real (a : Fin 4) : (((a : ℕ) : ℤ) : ℝ) = (a : ℝ) := by push_cast; rfl

theorem abs_fin_int_le (a : Fin 4) : |((a : ℕ) : ℤ)| ≤ 3 := by
  rw [abs_of_nonneg (by positivity)]
  have := a.isLt
  omega

theorem exp_three_log_le {Λ : ℝ} (hΛ : 1 ≤ Λ) (Dk : ℕ) :
    Real.exp (Dk * (1 + 3 * Real.log Λ) ^ Dk) ≤
      Real.exp ((Dk * 3 ^ Dk : ℕ) * (1 + Real.log Λ) ^ (Dk * 3 ^ Dk)) := by
  apply Real.exp_le_exp.mpr
  have hl : 0 ≤ Real.log Λ := Real.log_nonneg hΛ
  have h1 : (1 + 3 * Real.log Λ) ^ Dk ≤ (3 * (1 + Real.log Λ)) ^ Dk :=
    pow_le_pow_left₀ (by positivity) (by linarith) Dk
  have h2 : (1 + Real.log Λ) ^ Dk ≤ (1 + Real.log Λ) ^ (Dk * 3 ^ Dk) :=
    pow_le_pow_right₀ (by linarith) (Nat.le_mul_of_pos_right _ (by positivity))
  rw [mul_pow] at h1
  push_cast
  have h3 : (0 : ℝ) ≤ Dk := Nat.cast_nonneg _
  have h4 : (0 : ℝ) ≤ 3 ^ Dk := by positivity
  calc (Dk : ℝ) * (1 + 3 * Real.log Λ) ^ Dk ≤ Dk * (3 ^ Dk * (1 + Real.log Λ) ^ Dk) :=
        mul_le_mul_of_nonneg_left h1 h3
    _ ≤ Dk * (3 ^ Dk * (1 + Real.log Λ) ^ (Dk * 3 ^ Dk)) := by gcongr
    _ = _ := by ring


  have qH₁ : QPLe Y k5 H₁ := (qE₁.mul hY (by linarith) qT).pow hY (by positivity) 6
  set! δ₃ := δ₀ / (2 * E₁) with hδ₃
  have hδ₃0 : 0 < δ₃ := by positivity
  have hδ₃inv : δ₃⁻¹ = 2 * E₁ * (1 / δ₀) := by rw [hδ₃]; field_simp
  have qδ : QPLe Y kδ δ₃⁻¹ := by

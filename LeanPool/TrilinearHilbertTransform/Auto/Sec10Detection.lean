  exact hA.mul (Complex.continuous_conj.measurable.comp hB)

theorem measurable_fin_cons_pair {G : Type*} [MeasurableSpace G] {n : ℕ} :
    Measurable (fun p : (Fin n → G) × G => (Fin.cons p.2 p.1 : Fin (n + 1) → G)) := by
  apply measurable_pi_iff.mpr; intro i
  refine Fin.cases ?_ (fun j => ?_) i
  · simpa using measurable_snd
  · simp only [Fin.cons_succ]
    exact (measurable_pi_apply j).comp measurable_fst

theorem diagonalCubeIntegrand_three {G : Type*} [AddCommGroup G] (g : G → ℂ) (r s t x : G) :
    diagonalCubeIntegrand 3 g (Fin.cons t (Fin.cons s (Fin.cons r Fin.elim0))) x =
      mulDiff (mulDiff (mulDiff g r) s) t x := by
  have h1 : ∀ (h : Fin 1 → G) (y : G), diagonalCubeIntegrand 1 g h y = mulDiff g (h 0) y := by
    intro h y
    rw [diagonalCubeIntegrand_succ, diagonalCubeIntegrand_zero, diagonalCubeIntegrand_zero]; rfl
  have h2 : ∀ (h : Fin 2 → G) (y : G), diagonalCubeIntegrand 2 g h y =
      mulDiff (mulDiff g (h 1)) (h 0) y := by
    intro h y
    rw [diagonalCubeIntegrand_succ, h1, h1]; rfl
  rw [diagonalCubeIntegrand_succ, h2, h2]; rfl

/-- The order-three cube average as an iterated integral of multiplicative differences. -/
theorem cubeAverage_three_eq_nested {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] {g : G → ℂ} (hg : Measurable g)
    {M : ℝ} (hgb : ∀ x, ‖g x‖ ≤ M) :
    cubeAverage μ 3 (fun _ => g) =
      ∫ r, ∫ s, ∫ t, ∫ z, mulDiff (mulDiff (mulDiff g r) s) t z ∂μ ∂μ ∂μ ∂μ := by
  have hM : 0 ≤ M := by
    obtain ⟨x⟩ : Nonempty G := nonempty_of_isProbabilityMeasure μ
    exact (norm_nonneg _).trans (hgb x)
  have hcm := measurable_cubeIntegrand (j := 3) (fun _ => g) (fun _ => hg)
  have hcb : ∀ h x, ‖cubeIntegrand (fun _ : Fin 3 → Bool => g) h x‖ ≤ M ^ (2 ^ 3) :=
    fun h x => norm_cubeIntegrand_le (fun _ => g) (fun _ => hgb) h x
  set F : (Fin 3 → G) → ℂ := fun h => ∫ x, cubeIntegrand (fun _ => g) h x ∂μ with hF
  have hFm : Measurable F := hcm.stronglyMeasurable.integral_prod_right.measurable
  have hFb : ∀ h, ‖F h‖ ≤ M ^ (2 ^ 3) := fun h => norm_integral_le_bound μ (hcb h)
  unfold cubeAverage
  change ∫ h, F h ∂Measure.pi (fun _ => μ) = _
  rw [integral_pi_cons μ F hFm hFb]
  set F2 : (Fin 2 → G) → ℂ := fun h => ∫ t, F (Fin.cons t h) ∂μ with hF2
  have hF2m : Measurable F2 := measurable_integral_snd μ
    (F := fun (h : Fin 2 → G) (t : G) => F (Fin.cons t h)) (hFm.comp measurable_fin_cons_pair)
  have hF2b : ∀ h, ‖F2 h‖ ≤ M ^ (2 ^ 3) := fun h => norm_integral_le_bound μ (fun t => hFb _)
  rw [integral_pi_cons μ F2 hF2m hF2b]
  set F1 : (Fin 1 → G) → ℂ := fun h => ∫ s, F2 (Fin.cons s h) ∂μ with hF1
  have hF1m : Measurable F1 := measurable_integral_snd μ
    (F := fun (h : Fin 1 → G) (s : G) => F2 (Fin.cons s h)) (hF2m.comp measurable_fin_cons_pair)
  have hF1b : ∀ h, ‖F1 h‖ ≤ M ^ (2 ^ 3) := fun h => norm_integral_le_bound μ (fun t => hF2b _)
  rw [integral_pi_cons μ F1 hF1m hF1b, integral_unique, probReal_univ, one_smul]
  congr 1; funext r
  simp only [hF1, hF2, hF]
  congr 1; funext s; congr 1; funext t; congr 1; funext z
  have hd : (default : Fin 0 → G) = Fin.elim0 := Subsingleton.elim _ _
  rw [hd]
  exact diagonalCubeIntegrand_three g r s t z

theorem integral_comp_measurePreserving_self {G : Type*} [MeasurableSpace G] (μ : Measure G)
    {φ : G → G} (hmp : MeasurePreserving φ μ μ) {F : G → ℂ} (hF : Measurable F) :
    ∫ h, F (φ h) ∂μ = ∫ h, F h ∂μ := by
  have h := integral_map (μ := μ) hmp.measurable.aemeasurable
    (hF.aestronglyMeasurable (μ := Measure.map φ μ))
  rw [hmp.map_eq] at h
  exact h.symm


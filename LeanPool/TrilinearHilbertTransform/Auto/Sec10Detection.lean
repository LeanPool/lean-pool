/-! ### The generalized von Neumann inequality on a compact abelian group

Blueprint `lem:von-neumann`, lines 1431–1446: three Cauchy–Schwarz steps bound the
progression average by the eighth root of a dilated cube average of the second slot.
All inputs here are bounded; the passage to `L²` is made later. -/

/-- The multiplicative difference `f(y) conj f(y + s)`. -/
noncomputable def mulDiff {G : Type*} [Add G] (f : G → ℂ) (s : G) (y : G) : ℂ :=
  f y * conj (f (y + s))

theorem integral_add_right_haar {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd G] (μ : Measure G) [μ.IsAddLeftInvariant] (f : G → ℂ) (a : G) :
    ∫ x, f (x + a) ∂μ = ∫ x, f x ∂μ := by
  simp_rw [add_comm _ a]
  exact integral_add_left_eq_self f a

theorem integral_swap_bdd {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (μ : Measure X) (ν : Measure Y) [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    {F : X → Y → ℂ} (hF : Measurable (Function.uncurry F)) {M : ℝ}
    (hM : ∀ x y, ‖F x y‖ ≤ M) :
    ∫ x, ∫ y, F x y ∂ν ∂μ = ∫ y, ∫ x, F x y ∂μ ∂ν :=
  integral_integral_swap (integrable_of_measurable_bounded hF (fun p => hM p.1 p.2))

theorem norm_mulDiff_le {G : Type*} [Add G] {f : G → ℂ} {M : ℝ} (hf : ∀ x, ‖f x‖ ≤ M)
    (s y : G) : ‖mulDiff f s y‖ ≤ M * M := by
  unfold mulDiff
  rw [norm_mul, Complex.norm_conj]
  exact mul_le_mul (hf _) (hf _) (norm_nonneg _) ((norm_nonneg _).trans (hf y))

theorem measurable_mulDiff {G : Type*} [Add G] [MeasurableSpace G] [MeasurableAdd₂ G]
    {f : G → ℂ} (hf : Measurable f) :
    Measurable (fun p : G × G => mulDiff f p.1 p.2) := by
  unfold mulDiff
  exact (hf.comp measurable_snd).mul
    (Complex.continuous_conj.measurable.comp (hf.comp (measurable_snd.add measurable_fst)))

theorem measurable_mulDiff_comp {G X : Type*} [Add G] [MeasurableSpace G] [MeasurableAdd₂ G]
    [MeasurableSpace X] {f : G → ℂ} (hf : Measurable f) {s y : X → G} (hs : Measurable s)
    (hy : Measurable y) : Measurable (fun x => mulDiff f (s x) (y x)) :=
  (measurable_mulDiff hf).comp (hs.prodMk hy)

theorem measurable_integral_snd {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (ν : Measure Y) [SFinite ν] {F : X → Y → ℂ} (hF : Measurable (Function.uncurry F)) :
    Measurable (fun x => ∫ y, F x y ∂ν) :=
  (hF.stronglyMeasurable.integral_prod_right' (ν := ν)).measurable

theorem norm_integral_le_bound {X : Type*} [MeasurableSpace X] (μ : Measure X)
    [IsProbabilityMeasure μ] {f : X → ℂ} {M : ℝ} (hf : ∀ x, ‖f x‖ ≤ M) :
    ‖∫ x, f x ∂μ‖ ≤ M := by
  have h := norm_integral_le_of_norm_le_const (μ := μ) (Filter.Eventually.of_forall hf)
  simpa using h

/-- First Cauchy–Schwarz step (lem:von-neumann, line 1431). -/
theorem vonNeumann_first_step {G : Type*} [AddCommGroup G] [TopologicalSpace G]
    [IsTopologicalAddGroup G] [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G]
    (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {R g b c : G → ℂ} (hRm : Measurable R) (hgm : Measurable g) (hbm : Measurable b)
    (hcm : Measurable c) {MR Mg : ℝ} (hR : ∀ x, ‖R x‖ ≤ MR) (hg : ∀ x, ‖g x‖ ≤ Mg)
    (hb : ∀ x, ‖b x‖ ≤ 1) (hc : ∀ x, ‖c x‖ ≤ 1) (nR ng nb nc : ℤ) :
    ‖∫ t, ∫ x, R (x + nR • t) * g (x + ng • t) * b (x + nb • t) * c (x + nc • t) ∂μ ∂μ‖ ^ 2 ≤
      (∫ x, ‖R x‖ ^ 2 ∂μ) * ∫ u, ‖∫ t, g (u + (ng - nR) • t) * b (u + (nb - nR) • t) *
        c (u + (nc - nR) • t) ∂μ‖ ^ 2 ∂μ := by
  have hMR : 0 ≤ MR := (norm_nonneg _).trans (hR 0)
  have hMg : 0 ≤ Mg := (norm_nonneg _).trans (hg 0)
  have hz (n : ℤ) : Continuous (fun t : G => n • t) := continuous_zsmul n
  set! A : G → G → ℂ := fun u t => g (u + (ng - nR) • t) * b (u + (nb - nR) • t) *
    c (u + (nc - nR) • t) with hA
  have hAm : Measurable (Function.uncurry A) := by
    simp only [hA]
    refine ((hgm.comp ?_).mul (hbm.comp ?_)).mul (hcm.comp ?_) <;>
      exact measurable_fst.add ((hz _).measurable.comp measurable_snd)
  have hAb : ∀ u t, ‖A u t‖ ≤ Mg := fun u t => by
    simp only [hA, norm_mul]
    have := hg (u + (ng - nR) • t)
    have := hb (u + (nb - nR) • t)
    have := hc (u + (nc - nR) • t)
    calc ‖g (u + (ng - nR) • t)‖ * ‖b (u + (nb - nR) • t)‖ * ‖c (u + (nc - nR) • t)‖ ≤
        Mg * 1 * 1 := by gcongr
      _ = Mg := by ring
  have e1 : ∀ t : G, ∫ x, R (x + nR • t) * g (x + ng • t) * b (x + nb • t) *
      c (x + nc • t) ∂μ = ∫ u, R u * A u t ∂μ := by
    intro t
    rw [← integral_add_right_haar μ _ (-(nR • t))]
    congr 1; funext u
    simp only [hA]
    have h1 : u + -(nR • t) + nR • t = u := by abel
    have h2 : ∀ n : ℤ, u + -(nR • t) + n • t = u + (n - nR) • t := fun n => by
      rw [sub_zsmul]; abel
    rw [h1, h2, h2, h2]; ring
  simp_rw [e1]
  rw [integral_swap_bdd μ μ (F := fun t u => R u * A u t)
    ((hRm.comp measurable_snd).mul (hAm.comp measurable_swap))
    (M := MR * Mg) (fun t u => by
      rw [norm_mul]; exact mul_le_mul (hR u) (hAb u t) (norm_nonneg _) hMR)]
  simp_rw [integral_const_mul]
  have hIm : Measurable (fun u => ∫ t, A u t ∂μ) := measurable_integral_snd μ hAm
  have hIb : ∀ u, ‖∫ t, A u t ∂μ‖ ≤ Mg := fun u => norm_integral_le_bound μ (hAb u)
  have hcs := norm_integral_mul_conj_sq_le μ R (fun u => conj (∫ t, A u t ∂μ)) hRm
    (Complex.continuous_conj.measurable.comp hIm) hR (N := Mg) (fun u => by
      rw [Complex.norm_conj]; exact hIb u)
  simp only [Complex.conj_conj, Complex.norm_conj] at hcs
  exact hcs

/-- The square of an inner average as a correlation (lem:von-neumann, line 1433). -/
theorem integral_norm_sq_eq_correlation {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {X : Type*} [MeasurableSpace X] (ν : Measure X) [IsProbabilityMeasure ν]
    {A : X → G → ℂ} (hA : Measurable (Function.uncurry A)) {M : ℝ} (hM : ∀ u t, ‖A u t‖ ≤ M) :
    (((∫ u, ‖∫ t, A u t ∂μ‖ ^ 2 ∂ν) : ℝ) : ℂ) =
      ∫ u, ∫ h, ∫ t, A u t * conj (A u (t + h)) ∂μ ∂μ ∂ν := by
  rw [← integral_complex_ofReal]
  congr 1; funext u
  exact (integral_haar_correlation μ (A u) (hA.comp measurable_prodMk_left) (hM u)).symm

theorem measurable_comp_zsmul_add {G : Type*} [AddCommGroup G] [TopologicalSpace G]
    [IsTopologicalAddGroup G] [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G]
    {X : Type*} [MeasurableSpace X] {f : G → ℂ} (hf : Measurable f) {u t : X → G}
    (hu : Measurable u) (ht : Measurable t) (n : ℤ) :
    Measurable (fun x => f (u x + n • t x)) :=
  hf.comp (hu.add ((continuous_zsmul n).measurable.comp ht))

/-- Shift and swap: `∫∫ U(u+αt) B(u+βt) V(u+γt) = ∫ B(y) ∫ U(y+(α-β)t) V(y+(γ-β)t)`. -/
theorem integral_three_shift_swap {G : Type*} [AddCommGroup G] [TopologicalSpace G]
    [IsTopologicalAddGroup G] [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G]
    (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {U B V : G → ℂ} (hU : Measurable U) (hB : Measurable B) (hV : Measurable V)
    {MU MB MV : ℝ} (hUb : ∀ x, ‖U x‖ ≤ MU) (hBb : ∀ x, ‖B x‖ ≤ MB) (hVb : ∀ x, ‖V x‖ ≤ MV)
    (α β γ : ℤ) :
    ∫ u, ∫ t, U (u + α • t) * B (u + β • t) * V (u + γ • t) ∂μ ∂μ =
      ∫ y, B y * ∫ t, U (y + (α - β) • t) * V (y + (γ - β) • t) ∂μ ∂μ := by
  have hz (n : ℤ) : Measurable (fun t : G => n • t) := (continuous_zsmul n).measurable
  have hMU : 0 ≤ MU := (norm_nonneg _).trans (hUb 0)
  have hMB : 0 ≤ MB := (norm_nonneg _).trans (hBb 0)
  have hMV : 0 ≤ MV := (norm_nonneg _).trans (hVb 0)
  have hb3 : ∀ x y z, ‖U x * B y * V z‖ ≤ MU * MB * MV := fun x y z => by
    rw [norm_mul, norm_mul]
    exact mul_le_mul (mul_le_mul (hUb x) (hBb y) (norm_nonneg _) hMU) (hVb z) (norm_nonneg _)
      (by positivity)
  rw [integral_swap_bdd μ μ (F := fun u t => U (u + α • t) * B (u + β • t) * V (u + γ • t))
    (((measurable_comp_zsmul_add hU measurable_fst measurable_snd α).mul
      (measurable_comp_zsmul_add hB measurable_fst measurable_snd β)).mul
      (measurable_comp_zsmul_add hV measurable_fst measurable_snd γ)) (fun _ _ => hb3 _ _ _)]
  have hshift : ∀ t, ∫ u, U (u + α • t) * B (u + β • t) * V (u + γ • t) ∂μ =
      ∫ y, B y * (U (y + (α - β) • t) * V (y + (γ - β) • t)) ∂μ := by
    intro t
    rw [← integral_add_right_haar μ (fun u => U (u + α • t) * B (u + β • t) * V (u + γ • t))
      (-(β • t))]
    congr 1; funext y
    have h1 : y + -(β • t) + α • t = y + (α - β) • t := by rw [sub_zsmul]; abel
    have h2 : y + -(β • t) + β • t = y := by abel
    have h3 : y + -(β • t) + γ • t = y + (γ - β) • t := by rw [sub_zsmul]; abel
    simp only [h1, h2, h3]; ring
  simp_rw [hshift]
  rw [integral_swap_bdd μ μ (F := fun t y => B y * (U (y + (α - β) • t) * V (y + (γ - β) • t)))
    ((hB.comp measurable_snd).mul
      ((measurable_comp_zsmul_add hU measurable_snd measurable_fst (α - β)).mul
        (measurable_comp_zsmul_add hV measurable_snd measurable_fst (γ - β))))
    (M := MB * (MU * MV)) (fun t y => by
      rw [norm_mul, norm_mul]
      exact mul_le_mul (hBb _) (mul_le_mul (hUb _) (hVb _) (norm_nonneg _) hMU)
        (by positivity) hMB)]
  congr 1; funext y
  rw [integral_const_mul]

/-- Cauchy–Schwarz on a product of two probability spaces with a `1`-bounded first factor. -/
theorem norm_integral_two_mul_sq_le {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (ν : Measure X) (μ : Measure Y) [IsProbabilityMeasure ν] [IsProbabilityMeasure μ]
    {B K : X → Y → ℂ} (hB : Measurable (Function.uncurry B))
    (hK : Measurable (Function.uncurry K)) (hBb : ∀ h y, ‖B h y‖ ≤ 1) {M : ℝ}
    (hKb : ∀ h y, ‖K h y‖ ≤ M) :
    ‖∫ h, ∫ y, B h y * K h y ∂μ ∂ν‖ ^ 2 ≤ ∫ h, ∫ y, ‖K h y‖ ^ 2 ∂μ ∂ν := by
  have hcs := norm_integral_mul_conj_sq_le (ν.prod μ) (fun p => B p.1 p.2)
    (fun p => conj (K p.1 p.2)) hB (Complex.continuous_conj.measurable.comp hK)
    (fun p => hBb p.1 p.2) (N := M) (fun p => by rw [Complex.norm_conj]; exact hKb p.1 p.2)
  simp only [Complex.conj_conj, Complex.norm_conj] at hcs
  have i1 : Integrable (fun p : X × Y => B p.1 p.2 * K p.1 p.2) (ν.prod μ) :=
    integrable_of_measurable_bounded (hB.mul hK) (M := 1 * M) (fun p => by
      rw [norm_mul]; exact mul_le_mul (hBb _ _) (hKb _ _) (norm_nonneg _) zero_le_one)
  have i2 : Integrable (fun p : X × Y => ‖B p.1 p.2‖ ^ 2) (ν.prod μ) :=
    (integrable_const (1 : ℝ)).mono' (hB.norm.pow_const 2).aestronglyMeasurable
      (Filter.Eventually.of_forall fun p => by
        rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
        have := hBb p.1 p.2
        change ‖B p.1 p.2‖ ^ 2 ≤ 1
        nlinarith only [norm_nonneg (B p.1 p.2), this])
  have i3 : Integrable (fun p : X × Y => ‖K p.1 p.2‖ ^ 2) (ν.prod μ) :=
    (integrable_const (M ^ 2)).mono' (hK.norm.pow_const 2).aestronglyMeasurable
      (Filter.Eventually.of_forall fun p => by
        rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
        exact pow_le_pow_left₀ (norm_nonneg _) (hKb _ _) 2)
  rw [integral_prod _ i1] at hcs
  rw [integral_prod _ i3] at hcs
  have hM : 0 ≤ M := by
    obtain ⟨x⟩ : Nonempty X := nonempty_of_isProbabilityMeasure ν
    obtain ⟨y⟩ : Nonempty Y := nonempty_of_isProbabilityMeasure μ
    exact (norm_nonneg _).trans (hKb x y)
  have hB1 : ∫ p, ‖B p.1 p.2‖ ^ 2 ∂(ν.prod μ) ≤ 1 := by
    have h := integral_mono i2 (integrable_const (1 : ℝ)) (fun p => by
      have := hBb p.1 p.2
      change ‖B p.1 p.2‖ ^ 2 ≤ 1
      nlinarith [norm_nonneg (B p.1 p.2)])
    simpa using h
  have hK0 : 0 ≤ ∫ h, ∫ y, ‖K h y‖ ^ 2 ∂μ ∂ν :=
    integral_nonneg fun h => integral_nonneg fun y => by positivity
  calc ‖∫ h, ∫ y, B h y * K h y ∂μ ∂ν‖ ^ 2 ≤
      (∫ p, ‖B p.1 p.2‖ ^ 2 ∂(ν.prod μ)) * ∫ h, ∫ y, ‖K h y‖ ^ 2 ∂μ ∂ν := hcs
    _ ≤ 1 * ∫ h, ∫ y, ‖K h y‖ ^ 2 ∂μ ∂ν := mul_le_mul_of_nonneg_right hB1 hK0
    _ = _ := one_mul _

/-- Second Cauchy–Schwarz step (lem:von-neumann, lines 1433–1436). -/
theorem vonNeumann_second_step {G : Type*} [AddCommGroup G] [TopologicalSpace G]
    [IsTopologicalAddGroup G] [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G]
    (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {g b c : G → ℂ} (hgm : Measurable g) (hbm : Measurable b) (hcm : Measurable c) {Mg : ℝ}
    (hg : ∀ x, ‖g x‖ ≤ Mg) (hb : ∀ x, ‖b x‖ ≤ 1) (hc : ∀ x, ‖c x‖ ≤ 1) (α β γ : ℤ) :
    (∫ u, ‖∫ t, g (u + α • t) * b (u + β • t) * c (u + γ • t) ∂μ‖ ^ 2 ∂μ) ^ 2 ≤
      ∫ h, ∫ y, ‖∫ t, mulDiff g (α • h) (y + (α - β) • t) *
        mulDiff c (γ • h) (y + (γ - β) • t) ∂μ‖ ^ 2 ∂μ ∂μ := by
  have hz (n : ℤ) : Measurable (fun t : G => n • t) := (continuous_zsmul n).measurable
  have hMg : 0 ≤ Mg := (norm_nonneg _).trans (hg 0)
  have hMM : 0 ≤ Mg * Mg := mul_nonneg hMg hMg
  set A : G → G → ℂ := fun u t => g (u + α • t) * b (u + β • t) * c (u + γ • t) with hA
  have hAm : Measurable (Function.uncurry A) :=
    ((measurable_comp_zsmul_add hgm measurable_fst measurable_snd α).mul
      (measurable_comp_zsmul_add hbm measurable_fst measurable_snd β)).mul
      (measurable_comp_zsmul_add hcm measurable_fst measurable_snd γ)
  have hAb : ∀ u t, ‖A u t‖ ≤ Mg := fun u t => by
    simp only [hA, norm_mul]
    have := hg (u + α • t); have := hb (u + β • t); have := hc (u + γ • t)
    calc ‖g (u + α • t)‖ * ‖b (u + β • t)‖ * ‖c (u + γ • t)‖ ≤ Mg * 1 * 1 := by gcongr
      _ = Mg := by ring
  have hQ := integral_norm_sq_eq_correlation μ μ hAm hAb
  have hDb : ∀ s y, ‖mulDiff b s y‖ ≤ 1 := fun s y => by
    have := norm_mulDiff_le hb s y; linarith
  have hDc : ∀ s y, ‖mulDiff c s y‖ ≤ 1 := fun s y => by
    have := norm_mulDiff_le hc s y; linarith
  have hDg : ∀ s y, ‖mulDiff g s y‖ ≤ Mg * Mg := fun s y => norm_mulDiff_le hg s y
  have hAF : ∀ u h t, A u t * conj (A u (t + h)) = mulDiff g (α • h) (u + α • t) *
      mulDiff b (β • h) (u + β • t) * mulDiff c (γ • h) (u + γ • t) := fun u h t => by
    simp only [hA, mulDiff, zsmul_add, map_mul, ← add_assoc]; ring
  simp_rw [hAF] at hQ
  have hu : Measurable (fun p : (G × G) × G => p.1.1) := measurable_fst.comp measurable_fst
  have hh : Measurable (fun p : (G × G) × G => p.1.2) := measurable_snd.comp measurable_fst
  have ht : Measurable (fun p : (G × G) × G => p.2) := measurable_snd
  have hFm : Measurable (fun p : (G × G) × G => mulDiff g (α • p.1.2) (p.1.1 + α • p.2) *
      mulDiff b (β • p.1.2) (p.1.1 + β • p.2) * mulDiff c (γ • p.1.2) (p.1.1 + γ • p.2)) :=
    ((measurable_mulDiff_comp hgm ((hz α).comp hh) (hu.add ((hz α).comp ht))).mul
      (measurable_mulDiff_comp hbm ((hz β).comp hh) (hu.add ((hz β).comp ht)))).mul
      (measurable_mulDiff_comp hcm ((hz γ).comp hh) (hu.add ((hz γ).comp ht)))
  have hFb : ∀ u h t, ‖mulDiff g (α • h) (u + α • t) * mulDiff b (β • h) (u + β • t) *
      mulDiff c (γ • h) (u + γ • t)‖ ≤ Mg * Mg * 1 * 1 := fun u h t => by
    rw [norm_mul, norm_mul]
    exact mul_le_mul (mul_le_mul (hDg _ _) (hDb _ _) (norm_nonneg _) hMM) (hDc _ _)
      (norm_nonneg _) (by positivity)
  set! K : G → G → ℂ := fun h y => ∫ t, mulDiff g (α • h) (y + (α - β) • t) *
    mulDiff c (γ • h) (y + (γ - β) • t) ∂μ with hK
  have hinner : ∀ h, ∫ u, ∫ t, mulDiff g (α • h) (u + α • t) * mulDiff b (β • h) (u + β • t) *
      mulDiff c (γ • h) (u + γ • t) ∂μ ∂μ = ∫ y, mulDiff b (β • h) y * K h y ∂μ :=
    fun h => integral_three_shift_swap μ
      ((measurable_mulDiff hgm).comp (measurable_const.prodMk measurable_id))
      ((measurable_mulDiff hbm).comp (measurable_const.prodMk measurable_id))
      ((measurable_mulDiff hcm).comp (measurable_const.prodMk measurable_id))
      (hDg _) (hDb _) (hDc _) α β γ
  have hFm' : Measurable (Function.uncurry (fun (p : G × G) (t : G) =>
      mulDiff g (α • p.2) (p.1 + α • t) * mulDiff b (β • p.2) (p.1 + β • t) *
        mulDiff c (γ • p.2) (p.1 + γ • t))) := hFm
  have hswap : ∫ u, ∫ h, ∫ t, mulDiff g (α • h) (u + α • t) * mulDiff b (β • h) (u + β • t) *
        mulDiff c (γ • h) (u + γ • t) ∂μ ∂μ ∂μ =
      ∫ h, ∫ u, ∫ t, mulDiff g (α • h) (u + α • t) * mulDiff b (β • h) (u + β • t) *
        mulDiff c (γ • h) (u + γ • t) ∂μ ∂μ ∂μ :=
    integral_swap_bdd μ μ (measurable_integral_snd μ hFm')
      (fun u h => norm_integral_le_bound μ (hFb u h))
  have hQ' : (((∫ u, ‖∫ t, A u t ∂μ‖ ^ 2 ∂μ) : ℝ) : ℂ) =
      ∫ h, ∫ y, mulDiff b (β • h) y * K h y ∂μ ∂μ := by
    rw [hQ, hswap]
    exact integral_congr_ae (Filter.Eventually.of_forall hinner)
  have hBm : Measurable (Function.uncurry (fun h y => mulDiff b (β • h) y)) :=
    measurable_mulDiff_comp hbm ((hz β).comp measurable_fst) measurable_snd
  have hKm' : Measurable (Function.uncurry (fun (p : G × G) (t : G) =>
      mulDiff g (α • p.1) (p.2 + (α - β) • t) * mulDiff c (γ • p.1) (p.2 + (γ - β) • t))) := by
    have h1 : Measurable (fun q : (G × G) × G => q.1.1) := measurable_fst.comp measurable_fst
    have h2 : Measurable (fun q : (G × G) × G => q.1.2) := measurable_snd.comp measurable_fst
    exact (measurable_mulDiff_comp hgm ((hz α).comp h1) (h2.add ((hz _).comp measurable_snd))).mul
      (measurable_mulDiff_comp hcm ((hz γ).comp h1) (h2.add ((hz _).comp measurable_snd)))
  have hKm : Measurable (Function.uncurry K) := measurable_integral_snd μ hKm'
  have hKb : ∀ h y, ‖K h y‖ ≤ Mg * Mg * 1 := fun h y => norm_integral_le_bound μ (fun t => by
    rw [norm_mul]; exact mul_le_mul (hDg _ _) (hDc _ _) (norm_nonneg _) hMM)
  have hcs := norm_integral_two_mul_sq_le μ μ hBm hKm (fun h y => hDb _ _) hKb
  rw [← hQ', Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (integral_nonneg fun u => by positivity)] at hcs
  exact hcs

/-- Shift and swap with two factors: `∫∫ U(u+at) V(u+ct) = ∫ V(z) ∫ U(z+(a-c)t)`. -/
theorem integral_two_shift_swap {G : Type*} [AddCommGroup G] [TopologicalSpace G]
    [IsTopologicalAddGroup G] [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G]
    (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {U V : G → ℂ} (hU : Measurable U) (hV : Measurable V) {MU MV : ℝ}
    (hUb : ∀ x, ‖U x‖ ≤ MU) (hVb : ∀ x, ‖V x‖ ≤ MV) (a c : ℤ) :
    ∫ u, ∫ t, U (u + a • t) * V (u + c • t) ∂μ ∂μ =
      ∫ z, V z * ∫ t, U (z + (a - c) • t) ∂μ ∂μ := by
  have h := integral_three_shift_swap μ hU hV (V := fun _ => (1 : ℂ)) measurable_const hUb hVb
    (MV := 1) (fun _ => by simp) a c 0
  simp only [mul_one] at h
  exact h

/-- The square of an inner progression average, integrated: the last differencing step. -/
theorem integral_norm_sq_shift_avg {G : Type*} [AddCommGroup G] [TopologicalSpace G]
    [IsTopologicalAddGroup G] [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G]
    (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {W : G → ℂ} (hW : Measurable W) {M : ℝ} (hWb : ∀ x, ‖W x‖ ≤ M) (e : ℤ) :
    (((∫ z, ‖∫ t, W (z + e • t) ∂μ‖ ^ 2 ∂μ) : ℝ) : ℂ) = ∫ h, ∫ z, mulDiff W (e • h) z ∂μ ∂μ := by
  have hz (n : ℤ) : Measurable (fun t : G => n • t) := (continuous_zsmul n).measurable
  have hM : 0 ≤ M := by
    obtain ⟨x⟩ : Nonempty G := nonempty_of_isProbabilityMeasure μ
    exact (norm_nonneg _).trans (hWb x)
  have hAm : Measurable (Function.uncurry (fun z t => W (z + e • t))) :=
    measurable_comp_zsmul_add hW measurable_fst measurable_snd e
  rw [integral_norm_sq_eq_correlation μ μ hAm (fun _ _ => hWb _)]
  have e1 : ∀ z h t, W (z + e • t) * conj (W (z + e • (t + h))) =
      mulDiff W (e • h) (z + e • t) := fun z h t => by
    simp only [mulDiff, zsmul_add, ← add_assoc]
  simp_rw [e1]
  have hFm : Measurable (fun p : (G × G) × G => mulDiff W (e • p.1.2) (p.1.1 + e • p.2)) :=
    measurable_mulDiff_comp hW ((hz e).comp (measurable_snd.comp measurable_fst))
      ((measurable_fst.comp measurable_fst).add ((hz e).comp measurable_snd))
  have hFb : ∀ x s y, ‖mulDiff W s (x + y)‖ ≤ M * M := fun _ _ _ => norm_mulDiff_le hWb _ _
  -- swap `z` past `h`
  have hswap : ∫ z, ∫ h, ∫ t, mulDiff W (e • h) (z + e • t) ∂μ ∂μ ∂μ =
      ∫ h, ∫ z, ∫ t, mulDiff W (e • h) (z + e • t) ∂μ ∂μ ∂μ :=
    integral_swap_bdd μ μ (measurable_integral_snd μ
      (F := fun (p : G × G) (t : G) => mulDiff W (e • p.2) (p.1 + e • t)) hFm)
      (fun z h => norm_integral_le_bound μ (fun t => hFb _ _ _))
  rw [hswap]
  congr 1; funext h
  have hF2 : Measurable (Function.uncurry (fun z t => mulDiff W (e • h) (z + e • t))) :=
    measurable_mulDiff_comp hW measurable_const (measurable_fst.add ((hz e).comp measurable_snd))
  rw [integral_swap_bdd μ μ hF2 (fun _ _ => hFb _ _ _)]
  have hshift : ∀ t, ∫ z, mulDiff W (e • h) (z + e • t) ∂μ = ∫ z, mulDiff W (e • h) z ∂μ :=
    fun t => integral_add_right_haar μ (mulDiff W (e • h)) (e • t)
  simp_rw [hshift]
  rw [integral_const, probReal_univ, one_smul]

theorem integral_prod_bdd {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (ν : Measure X) (μ : Measure Y) [IsFiniteMeasure ν] [IsFiniteMeasure μ]
    {F : X × Y → ℂ} (hF : Measurable F) {M : ℝ} (hM : ∀ p, ‖F p‖ ≤ M) :
    ∫ p, F p ∂(ν.prod μ) = ∫ x, ∫ y, F (x, y) ∂μ ∂ν :=
  integral_prod F (integrable_of_measurable_bounded hF hM)

theorem integral_prod_bdd_real {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (ν : Measure X) (μ : Measure Y) [IsFiniteMeasure ν] [IsFiniteMeasure μ]
    {F : X × Y → ℝ} (hF : Measurable F) {M : ℝ} (hM : ∀ p, ‖F p‖ ≤ M) :
    ∫ p, F p ∂(ν.prod μ) = ∫ x, ∫ y, F (x, y) ∂μ ∂ν :=
  integral_prod F ((integrable_const M).mono' hF.aestronglyMeasurable
    (Filter.Eventually.of_forall hM))

/-- Third Cauchy–Schwarz step (lem:von-neumann, lines 1436–1440), with an outer parameter. -/
theorem vonNeumann_third_step {G : Type*} [AddCommGroup G] [TopologicalSpace G]
    [IsTopologicalAddGroup G] [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G]
    (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {U V : G → G → ℂ} (hUm : Measurable (Function.uncurry U))
    (hVm : Measurable (Function.uncurry V)) {MU : ℝ} (hU : ∀ p x, ‖U p x‖ ≤ MU)
    (hV : ∀ p x, ‖V p x‖ ≤ 1) (a c : ℤ) :
    (∫ p, ∫ y, ‖∫ t, U p (y + a • t) * V p (y + c • t) ∂μ‖ ^ 2 ∂μ ∂μ) ^ 2 ≤
      ∫ p, ∫ h, ∫ z, ‖∫ t, mulDiff (U p) (a • h) (z + (a - c) • t) ∂μ‖ ^ 2 ∂μ ∂μ ∂μ := by
  have hz (n : ℤ) : Measurable (fun t : G => n • t) := (continuous_zsmul n).measurable
  have hMU : 0 ≤ MU := by
    obtain ⟨x⟩ : Nonempty G := nonempty_of_isProbabilityMeasure μ
    exact (norm_nonneg _).trans (hU x x)
  -- the inner average over the outer pair `q = (p, y)`
  set A : G × G → G → ℂ := fun q t => U q.1 (q.2 + a • t) * V q.1 (q.2 + c • t) with hA
  have hAm : Measurable (Function.uncurry A) := by
    have h1 : Measurable (fun r : (G × G) × G => r.1.1) := measurable_fst.comp measurable_fst
    have h2 : Measurable (fun r : (G × G) × G => r.1.2) := measurable_snd.comp measurable_fst
    exact (hUm.comp (h1.prodMk (h2.add ((hz a).comp measurable_snd)))).mul
      (hVm.comp (h1.prodMk (h2.add ((hz c).comp measurable_snd))))
  have hAb : ∀ q t, ‖A q t‖ ≤ MU := fun q t => by
    simp only [hA, norm_mul]
    calc ‖U q.1 (q.2 + a • t)‖ * ‖V q.1 (q.2 + c • t)‖ ≤ MU * 1 :=
          mul_le_mul (hU _ _) (hV _ _) (norm_nonneg _) hMU
      _ = MU := mul_one _
  have hIm : Measurable (fun q => ‖∫ t, A q t ∂μ‖ ^ 2) :=
    (measurable_integral_snd μ hAm).norm.pow_const 2
  have hIb : ∀ q, ‖‖∫ t, A q t ∂μ‖ ^ 2‖ ≤ MU ^ 2 := fun q => by
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    exact pow_le_pow_left₀ (norm_nonneg _) (norm_integral_le_bound μ (hAb q)) 2
  have hQ1 : ∫ p, ∫ y, ‖∫ t, U p (y + a • t) * V p (y + c • t) ∂μ‖ ^ 2 ∂μ ∂μ =
      ∫ q, ‖∫ t, A q t ∂μ‖ ^ 2 ∂(μ.prod μ) :=
    (integral_prod_bdd_real μ μ hIm hIb).symm
  have hQ2 := integral_norm_sq_eq_correlation μ (μ.prod μ) hAm hAb
  have hDU : ∀ p s y, ‖mulDiff (U p) s y‖ ≤ MU * MU := fun p s y => norm_mulDiff_le (hU p) s y
  have hDV : ∀ p s y, ‖mulDiff (V p) s y‖ ≤ 1 := fun p s y => by
    have := norm_mulDiff_le (hV p) s y; linarith
  have hMM : 0 ≤ MU * MU := mul_nonneg hMU hMU
  have e1 : ∀ q h t, A q t * conj (A q (t + h)) = mulDiff (U q.1) (a • h) (q.2 + a • t) *
      mulDiff (V q.1) (c • h) (q.2 + c • t) := fun q h t => by
    simp only [hA, mulDiff, zsmul_add, map_mul, ← add_assoc]; ring
  simp_rw [e1] at hQ2
  -- measurability of the differenced integrand in `((q, h), t)`
  have hDUm : Measurable (fun r : (G × G) × G => mulDiff (U r.1.1) r.1.2 r.2) := by
    unfold mulDiff
    exact (hUm.comp ((measurable_fst.comp measurable_fst).prodMk measurable_snd)).mul
      (Complex.continuous_conj.measurable.comp (hUm.comp
        ((measurable_fst.comp measurable_fst).prodMk
        (measurable_snd.add (measurable_snd.comp measurable_fst)))))
  have hDVm : Measurable (fun r : (G × G) × G => mulDiff (V r.1.1) r.1.2 r.2) := by
    unfold mulDiff
    exact (hVm.comp ((measurable_fst.comp measurable_fst).prodMk measurable_snd)).mul
      (Complex.continuous_conj.measurable.comp (hVm.comp
        ((measurable_fst.comp measurable_fst).prodMk
        (measurable_snd.add (measurable_snd.comp measurable_fst)))))
  -- the full differenced integrand in `((q, h), t)`
  have hΦm : Measurable (fun r : ((G × G) × G) × G =>
      mulDiff (U r.1.1.1) (a • r.1.2) (r.1.1.2 + a • r.2) *
        mulDiff (V r.1.1.1) (c • r.1.2) (r.1.1.2 + c • r.2)) := by
    have hp : Measurable (fun r : ((G × G) × G) × G => r.1.1.1) :=
      measurable_fst.comp (measurable_fst.comp measurable_fst)
    have hy : Measurable (fun r : ((G × G) × G) × G => r.1.1.2) :=
      measurable_snd.comp (measurable_fst.comp measurable_fst)
    have hh : Measurable (fun r : ((G × G) × G) × G => r.1.2) :=
      measurable_snd.comp measurable_fst
    exact (hDUm.comp ((hp.prodMk ((hz a).comp hh)).prodMk
      (hy.add ((hz a).comp measurable_snd)))).mul
      (hDVm.comp ((hp.prodMk ((hz c).comp hh)).prodMk (hy.add ((hz c).comp measurable_snd))))
  have hΦb : ∀ (q : G × G) (h t : G), ‖mulDiff (U q.1) (a • h) (q.2 + a • t) *
      mulDiff (V q.1) (c • h) (q.2 + c • t)‖ ≤ MU * MU * 1 := fun q h t => by
    rw [norm_mul]; exact mul_le_mul (hDU _ _ _) (hDV _ _ _) (norm_nonneg _) hMM
  have hΦ2m : Measurable (fun r : (G × G) × G => ∫ t, mulDiff (U r.1.1) (a • r.2) (r.1.2 + a • t) *
      mulDiff (V r.1.1) (c • r.2) (r.1.2 + c • t) ∂μ) :=
    measurable_integral_snd μ (F := fun (r : (G × G) × G) (t : G) =>
      mulDiff (U r.1.1) (a • r.2) (r.1.2 + a • t) * mulDiff (V r.1.1) (c • r.2) (r.1.2 + c • t))
      hΦm
  have hΦ1m : Measurable (fun q : G × G => ∫ h, ∫ t, mulDiff (U q.1) (a • h) (q.2 + a • t) *
      mulDiff (V q.1) (c • h) (q.2 + c • t) ∂μ ∂μ) :=
    measurable_integral_snd μ (F := fun (q : G × G) (h : G) => ∫ t,
      mulDiff (U q.1) (a • h) (q.2 + a • t) * mulDiff (V q.1) (c • h) (q.2 + c • t) ∂μ) hΦ2m
  have hΦ1b : ∀ q : G × G, ‖∫ h, ∫ t, mulDiff (U q.1) (a • h) (q.2 + a • t) *
      mulDiff (V q.1) (c • h) (q.2 + c • t) ∂μ ∂μ‖ ≤ MU * MU * 1 := fun q =>
    norm_integral_le_bound μ (fun h => norm_integral_le_bound μ (fun t => hΦb q h t))
  rw [integral_prod_bdd μ μ hΦ1m hΦ1b] at hQ2
  set! K : G → G → G → ℂ := fun p h z => ∫ t, mulDiff (U p) (a • h) (z + (a - c) • t) ∂μ with hK
  have hinner : ∀ p, ∫ y, ∫ h, ∫ t, mulDiff (U p) (a • h) (y + a • t) *
      mulDiff (V p) (c • h) (y + c • t) ∂μ ∂μ ∂μ =
      ∫ h, ∫ z, mulDiff (V p) (c • h) z * K p h z ∂μ ∂μ := by
    intro p
    have hm : Measurable (Function.uncurry (fun (y h : G) => ∫ t,
        mulDiff (U p) (a • h) (y + a • t) * mulDiff (V p) (c • h) (y + c • t) ∂μ)) :=
      hΦ2m.comp ((measurable_const.prodMk measurable_fst).prodMk measurable_snd)
    rw [integral_swap_bdd μ μ hm (fun y h => norm_integral_le_bound μ (fun t => hΦb (p, y) h t))]
    congr 1; funext h
    exact integral_two_shift_swap μ
      (hDUm.comp ((measurable_const.prodMk measurable_const).prodMk measurable_id))
      (hDVm.comp ((measurable_const.prodMk measurable_const).prodMk measurable_id))
      (hDU p _) (hDV p _) a c
  rw [integral_congr_ae (Filter.Eventually.of_forall hinner)] at hQ2
  have hKm3 : Measurable (fun r : (G × G) × G => K r.1.1 r.1.2 r.2) := by
    have hp : Measurable (fun w : ((G × G) × G) × G => w.1.1.1) :=
      measurable_fst.comp (measurable_fst.comp measurable_fst)
    have hh : Measurable (fun w : ((G × G) × G) × G => w.1.1.2) :=
      measurable_snd.comp (measurable_fst.comp measurable_fst)
    have hzz : Measurable (fun w : ((G × G) × G) × G => w.1.2) :=
      measurable_snd.comp measurable_fst
    exact measurable_integral_snd μ (F := fun (r : (G × G) × G) (t : G) =>
      mulDiff (U r.1.1) (a • r.1.2) (r.2 + (a - c) • t))
      (hDUm.comp ((hp.prodMk ((hz a).comp hh)).prodMk (hzz.add ((hz _).comp measurable_snd))))
  have hKb : ∀ p h z, ‖K p h z‖ ≤ MU * MU := fun p h z =>
    norm_integral_le_bound μ (fun t => hDU _ _ _)
  have hBm : Measurable (Function.uncurry
      (fun (r : G × G) (z : G) => mulDiff (V r.1) (c • r.2) z)) :=
    hDVm.comp (((measurable_fst.comp measurable_fst).prodMk
      ((hz c).comp (measurable_snd.comp measurable_fst))).prodMk measurable_snd)
  have hKm : Measurable (Function.uncurry (fun (r : G × G) (z : G) => K r.1 r.2 z)) := hKm3
  have hcs := norm_integral_two_mul_sq_le (μ.prod μ) μ hBm hKm (fun r z => hDV _ _ _)
    (fun r z => hKb _ _ _)
  have hfm : Measurable (fun r : G × G => ∫ z, mulDiff (V r.1) (c • r.2) z * K r.1 r.2 z ∂μ) :=
    measurable_integral_snd μ (hBm.mul hKm)
  have hfb : ∀ r : G × G, ‖∫ z, mulDiff (V r.1) (c • r.2) z * K r.1 r.2 z ∂μ‖ ≤ 1 * (MU * MU) :=
    fun r => norm_integral_le_bound μ (fun z => by
      rw [norm_mul]; exact mul_le_mul (hDV _ _ _) (hKb _ _ _) (norm_nonneg _) zero_le_one)
  rw [integral_prod_bdd μ μ hfm hfb, ← hQ2] at hcs
  have hgm : Measurable (fun r : G × G => ∫ z, ‖K r.1 r.2 z‖ ^ 2 ∂μ) :=
    ((hKm.norm.pow_const 2).stronglyMeasurable.integral_prod_right' (ν := μ)).measurable
  have hgb : ∀ r : G × G, ‖∫ z, ‖K r.1 r.2 z‖ ^ 2 ∂μ‖ ≤ (MU * MU) ^ 2 := fun r => by
    have h0 : 0 ≤ ∫ z, ‖K r.1 r.2 z‖ ^ 2 ∂μ := integral_nonneg fun z => by positivity
    rw [Real.norm_eq_abs, abs_of_nonneg h0]
    have h1 := integral_mono (μ := μ) ((integrable_const ((MU * MU) ^ 2)).mono'
      ((hKm.comp (measurable_const.prodMk measurable_id)).norm.pow_const 2).aestronglyMeasurable
      (Filter.Eventually.of_forall fun z => by
        rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
        exact pow_le_pow_left₀ (norm_nonneg _) (hKb _ _ _) 2))
      (integrable_const ((MU * MU) ^ 2))
      (fun z => pow_le_pow_left₀ (norm_nonneg _) (hKb r.1 r.2 z) 2)
    simpa using h1
  rw [integral_prod_bdd_real μ μ hgm hgb] at hcs
  rw [hQ1]
  have hq0 : 0 ≤ ∫ q, ‖∫ t, A q t ∂μ‖ ^ 2 ∂(μ.prod μ) := integral_nonneg fun q => by positivity
  rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hq0] at hcs
  exact hcs

/-- The dilated third multiplicative difference average of `g`. -/
noncomputable def dilatedCube {G : Type*} [AddCommGroup G] [MeasurableSpace G] (μ : Measure G)
    (g : G → ℂ) (a b c : ℤ) : ℂ :=
  ∫ h₁, ∫ h₂, ∫ h₃, ∫ z, mulDiff (mulDiff (mulDiff g (a • h₁)) (b • h₂)) (c • h₃) z ∂μ ∂μ ∂μ ∂μ

/-- Blueprint lem:von-neumann, lines 1431–1446, for bounded inputs on a compact abelian
group with Haar probability: `|Λ|⁸ ≤ ‖R‖₂⁸ · (dilated U³ average of g)` when `|b|,|c| ≤ 1`. -/
theorem vonNeumann_group_bounded {G : Type*} [AddCommGroup G] [TopologicalSpace G]
    [IsTopologicalAddGroup G] [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G]
    (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {R g b c : G → ℂ} (hRm : Measurable R) (hgm : Measurable g) (hbm : Measurable b)
    (hcm : Measurable c) {MR Mg : ℝ} (hR : ∀ x, ‖R x‖ ≤ MR) (hg : ∀ x, ‖g x‖ ≤ Mg)
    (hb : ∀ x, ‖b x‖ ≤ 1) (hc : ∀ x, ‖c x‖ ≤ 1) (nR ng nb nc : ℤ) :
    ‖∫ t, ∫ x, R (x + nR • t) * g (x + ng • t) * b (x + nb • t) * c (x + nc • t) ∂μ ∂μ‖ ^ 8 ≤
      (∫ x, ‖R x‖ ^ 2 ∂μ) ^ 4 * (dilatedCube μ g (ng - nR) (ng - nb) (ng - nc)).re := by
  have hz (n : ℤ) : Measurable (fun t : G => n • t) := (continuous_zsmul n).measurable
  have hMg : 0 ≤ Mg := (norm_nonneg _).trans (hg 0)
  set α := ng - nR; set! β := nb - nR; set! γ := nc - nR
  have h1 := vonNeumann_first_step μ hRm hgm hbm hcm hR hg hb hc nR ng nb nc
  have h2 := vonNeumann_second_step μ hgm hbm hcm hg hb hc α β γ
  have hUm : Measurable (Function.uncurry (fun p y => mulDiff g (α • p) y)) :=
    measurable_mulDiff_comp hgm ((hz α).comp measurable_fst) measurable_snd
  have hVm : Measurable (Function.uncurry (fun p y => mulDiff c (γ • p) y)) :=
    measurable_mulDiff_comp hcm ((hz γ).comp measurable_fst) measurable_snd
  have h3 := vonNeumann_third_step μ (U := fun p y => mulDiff g (α • p) y)
    (V := fun p y => mulDiff c (γ • p) y) hUm hVm (fun p x => norm_mulDiff_le hg _ _)
    (fun p x => by have := norm_mulDiff_le hc (γ • p) x; linarith) (α - β) (γ - β)
  -- the last differencing step, as a complex identity
  have hab : α - β = ng - nb := by simp only [α, β]; ring
  have hcd : α - β - (γ - β) = ng - nc := by simp only [α, β, γ]; ring
  have hWm (p h : G) : Measurable (mulDiff (mulDiff g (α • p)) ((α - β) • h)) :=
    (measurable_mulDiff
      ((measurable_mulDiff hgm).comp (measurable_const.prodMk measurable_id))).comp
      (measurable_const.prodMk measurable_id)
  have hWb (p h : G) : ∀ x, ‖mulDiff (mulDiff g (α • p)) ((α - β) • h) x‖ ≤ Mg * Mg * (Mg * Mg) :=
    fun x => norm_mulDiff_le (fun y => norm_mulDiff_le hg _ _) _ _
  have h4 : (((∫ p, ∫ h, ∫ z, ‖∫ t, mulDiff (mulDiff g (α • p)) ((α - β) • h)
      (z + (α - β - (γ - β)) • t) ∂μ‖ ^ 2 ∂μ ∂μ ∂μ) : ℝ) : ℂ) =
      dilatedCube μ g (ng - nR) (ng - nb) (ng - nc) := by
    rw [← integral_complex_ofReal]
    unfold dilatedCube
    congr 1; funext p
    rw [← integral_complex_ofReal]
    congr 1; funext h
    rw [integral_norm_sq_shift_avg μ (hWm p h) (hWb p h), hcd, hab]
  have hQ3 : (∫ p, ∫ h, ∫ z, ‖∫ t, mulDiff (mulDiff g (α • p)) ((α - β) • h)
      (z + (α - β - (γ - β)) • t) ∂μ‖ ^ 2 ∂μ ∂μ ∂μ) =
      (dilatedCube μ g (ng - nR) (ng - nb) (ng - nc)).re := by
    rw [← h4, Complex.ofReal_re]
  rw [← hQ3]
  -- the chain of inequalities
  set Q1 := ∫ u, ‖∫ t, g (u + α • t) * b (u + β • t) * c (u + γ • t) ∂μ‖ ^ 2 ∂μ with hQ1
  set Q2 := ∫ h, ∫ y, ‖∫ t, mulDiff g (α • h) (y + (α - β) • t) *
    mulDiff c (γ • h) (y + (γ - β) • t) ∂μ‖ ^ 2 ∂μ ∂μ with hQ2
  have hQ10 : 0 ≤ Q1 := integral_nonneg fun u => by positivity
  have hR0 : 0 ≤ ∫ x, ‖R x‖ ^ 2 ∂μ := integral_nonneg fun x => by positivity
  set Λ := ‖∫ t, ∫ x, R (x + nR • t) * g (x + ng • t) * b (x + nb • t) * c (x + nc • t) ∂μ ∂μ‖
  have hΛ8 : Λ ^ 8 = (Λ ^ 2) ^ 4 := by ring
  have hQ14 : Q1 ^ 4 = (Q1 ^ 2) ^ 2 := by ring
  have hQ20 : 0 ≤ Q1 ^ 2 := by positivity
  calc Λ ^ 8 = (Λ ^ 2) ^ 4 := hΛ8
    _ ≤ ((∫ x, ‖R x‖ ^ 2 ∂μ) * Q1) ^ 4 := pow_le_pow_left₀ (by positivity) h1 4
    _ = (∫ x, ‖R x‖ ^ 2 ∂μ) ^ 4 * (Q1 ^ 2) ^ 2 := by ring
    _ ≤ (∫ x, ‖R x‖ ^ 2 ∂μ) ^ 4 * Q2 ^ 2 :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hQ20 h2 2) (by positivity)
    _ ≤ _ := mul_le_mul_of_nonneg_left h3 (by positivity)


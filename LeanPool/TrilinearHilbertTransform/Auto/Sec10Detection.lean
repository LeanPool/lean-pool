theorem detection_atom_pair (κ : LocalKernelClass) (c₀ : ℕ) (hc₀ : 1 ≤ c₀) :
    ∃ (c₂ K : ℕ), 1 ≤ c₂ ∧ 1 ≤ K ∧
    ∀ {a₀ r H C₁ δ₀ : ℝ} {d e : ℕ} (A : QuadraticChartData d) (A' : QuadraticChartData e),

/-! ### Comparison on a short depth block (lem:shortblock, blueprint lines 2275-2369) -/

/-- Two integer pairs with the same sum and the same sum of squares agree as multisets. -/
theorem pair_eq_of_sum_sq {m₁ m₂ m₃ m₄ : ℤ} (hs : m₁ + m₂ = m₃ + m₄)
    (hq : m₁ ^ 2 + m₂ ^ 2 = m₃ ^ 2 + m₄ ^ 2) :
    (m₃ = m₁ ∧ m₄ = m₂) ∨ (m₃ = m₂ ∧ m₄ = m₁) := by
  have h2 : 2 * ((m₁ - m₃) * (m₁ - m₄)) = 0 := by
    linear_combination hq - (m₂ + m₃ + m₄ - m₁) * hs
  have hprod : (m₁ - m₃) * (m₁ - m₄) = 0 := by omega
  rcases mul_eq_zero.mp hprod with h | h
  · left; constructor <;> omega
  · right; constructor <;> omega

/-- Blueprint `eq:fourth-moment` (lines 2311-2315), the pairing count: the sum of
`a(m₁) a(m₂) conj a(m₃) conj a(m₄)` over quadruples with equal sums and equal squared sums (what
survives integration in `w` and in `γ`) is at most `2 (Σ |a|²)²`. -/
theorem fourth_moment_pairing (s : Finset ℤ) (a : ℤ → ℂ) :
    ‖∑ m₁ ∈ s, ∑ m₂ ∈ s, ∑ m₃ ∈ s, ∑ m₄ ∈ s,
        (if m₁ + m₂ = m₃ + m₄ ∧ m₁ ^ 2 + m₂ ^ 2 = m₃ ^ 2 + m₄ ^ 2 then
          a m₁ * a m₂ * conj (a m₃) * conj (a m₄) else 0)‖ ≤
      2 * (∑ m ∈ s, ‖a m‖ ^ 2) ^ 2 := by
  classical
  set X : ℤ → ℤ → ℤ → ℤ → ℝ := fun m₁ m₂ m₃ m₄ => ‖a m₁‖ * ‖a m₂‖ * ‖a m₃‖ * ‖a m₄‖
  have hterm : ∀ m₁ m₂ m₃ m₄, ‖(if m₁ + m₂ = m₃ + m₄ ∧ m₁ ^ 2 + m₂ ^ 2 = m₃ ^ 2 + m₄ ^ 2 then
      a m₁ * a m₂ * conj (a m₃) * conj (a m₄) else 0)‖ ≤
      (if m₃ = m₁ ∧ m₄ = m₂ then X m₁ m₂ m₃ m₄ else 0) +
        (if m₃ = m₂ ∧ m₄ = m₁ then X m₁ m₂ m₃ m₄ else 0) := by
    intro m₁ m₂ m₃ m₄
    have hX : 0 ≤ X m₁ m₂ m₃ m₄ := by positivity
    have h1 : ‖(if m₁ + m₂ = m₃ + m₄ ∧ m₁ ^ 2 + m₂ ^ 2 = m₃ ^ 2 + m₄ ^ 2 then
        a m₁ * a m₂ * conj (a m₃) * conj (a m₄) else 0)‖ ≤
        if m₁ + m₂ = m₃ + m₄ ∧ m₁ ^ 2 + m₂ ^ 2 = m₃ ^ 2 + m₄ ^ 2 then X m₁ m₂ m₃ m₄ else 0 := by
      split_ifs
      · simp [X]
      · simp
    refine h1.trans ?_
    split_ifs with hc hA hB hB <;> try linarith
    rcases pair_eq_of_sum_sq hc.1 hc.2 with h | h
    · exact absurd h hA
    · exact absurd h hB
  have hsum : ∀ m₁ ∈ s, ∀ m₂ ∈ s, ∑ m₃ ∈ s, ∑ m₄ ∈ s,
      ((if m₃ = m₁ ∧ m₄ = m₂ then X m₁ m₂ m₃ m₄ else 0) +
        (if m₃ = m₂ ∧ m₄ = m₁ then X m₁ m₂ m₃ m₄ else 0)) = 2 * (‖a m₁‖ ^ 2 * ‖a m₂‖ ^ 2) := by
    intro m₁ h₁ m₂ h₂
    simp only [Finset.sum_add_distrib, ite_and, Finset.sum_ite_eq', h₁, h₂, ite_true,
      Finset.sum_ite_irrel, Finset.sum_const_zero, X]
    ring
  calc _ ≤ ∑ m₁ ∈ s, ∑ m₂ ∈ s, ∑ m₃ ∈ s, ∑ m₄ ∈ s,
        ((if m₃ = m₁ ∧ m₄ = m₂ then X m₁ m₂ m₃ m₄ else 0) +
          (if m₃ = m₂ ∧ m₄ = m₁ then X m₁ m₂ m₃ m₄ else 0)) := by
        refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m₁ _ => ?_)
        refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m₂ _ => ?_)
        refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m₃ _ => ?_)
        exact (norm_sum_le _ _).trans (Finset.sum_le_sum fun m₄ _ => hterm _ _ _ _)
    _ = ∑ m₁ ∈ s, ∑ m₂ ∈ s, 2 * (‖a m₁‖ ^ 2 * ‖a m₂‖ ^ 2) :=
        Finset.sum_congr rfl fun m₁ h₁ => Finset.sum_congr rfl fun m₂ h₂ => hsum m₁ h₁ m₂ h₂
    _ = 2 * (∑ m ∈ s, ‖a m‖ ^ 2) ^ 2 := by
        rw [sq, Finset.sum_mul_sum, Finset.mul_sum]
        apply Finset.sum_congr rfl; intro m₁ _
        rw [Finset.mul_sum]

/-! ### Leaf-depth rectangles (lem:shortblock, blueprint lines 2290-2296) -/

/-- The rectangles partitioning four-tuples of leaf depths in the proof of `lem:shortblock`:
`rep S v` (the minimum `v` is attained exactly on the slots `S`, at least two of them) and
`uniq a S h k` (the minimum is attained only at `a`; at scale `2^(h+1)` the depths of slot `a` and
of the slots `S` share the block `k`, with `a` in the lower and `S` in the upper half; all other
slots lie above that block). -/
inductive DepthRect
  | rep (S : Finset (Fin 4)) (v : ℕ)
  | uniq (a : Fin 4) (S : Finset (Fin 4)) (h k : ℕ)
  deriving DecidableEq

namespace DepthRect

/-- Admissible rectangle parameters. -/
def Valid : DepthRect → Prop
  | rep S _ => 2 ≤ S.card
  | uniq a S _ _ => a ∉ S ∧ S.Nonempty

/-- Membership of a depth tuple; it is a product of per-slot conditions. -/
def Mem : DepthRect → (Fin 4 → ℕ) → Prop
  | rep S v, d => ∀ j, (j ∈ S → d j = v) ∧ (j ∉ S → v < d j)
  | uniq a S h k, d => d a / 2 ^ h = 2 * k ∧
      ∀ j, j ≠ a → (j ∈ S → d j / 2 ^ h = 2 * k + 1) ∧ (j ∉ S → 2 * k + 2 ≤ d j / 2 ^ h)

/-- The separating depth `t`: all slots except possibly the heavy slot have depth at least `t`. -/
def sep : DepthRect → ℕ
  | rep _ v => v
  | uniq _ _ h k => (2 * k + 1) * 2 ^ h

theorem div_pow_succ (x h : ℕ) : x / 2 ^ (h + 1) = x / 2 ^ h / 2 := by
  rw [pow_succ, Nat.div_div_eq_div_mul]

/-- Agreement of the dyadic blocks persists at coarser scales. -/
theorem div_pow_eq_of_le {x y h h' : ℕ} (hh : h ≤ h') (e : x / 2 ^ h = y / 2 ^ h) :
    x / 2 ^ h' = y / 2 ^ h' := by
  obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hh
  rw [pow_add, ← Nat.div_div_eq_div_mul, ← Nat.div_div_eq_div_mul, e]

/-- In a `uniq` rectangle the heavy slot is the strict minimum. -/
theorem uniq_lt {a : Fin 4} {S : Finset (Fin 4)} {h k : ℕ} {d : Fin 4 → ℕ}
    (hm : Mem (uniq a S h k) d) {j : Fin 4} (hj : j ≠ a) : d a < d j := by
  obtain ⟨ha, hS⟩ := hm
  have h1 : d a / 2 ^ h < d j / 2 ^ h := by
    by_cases hjS : j ∈ S
    · rw [ha, (hS j hj).1 hjS]; omega
    · have := (hS j hj).2 hjS; omega
  by_contra hle
  exact absurd (Nat.div_le_div_right (c := 2 ^ h) (not_lt.mp hle)) (not_le.mpr h1)

/-- Every tuple lies in a valid rectangle. -/
theorem exists_mem (d : Fin 4 → ℕ) : ∃ R, Valid R ∧ Mem R d := by
  classical
  obtain ⟨a, -, ha⟩ := Finset.exists_min_image Finset.univ d Finset.univ_nonempty
  set v := d a
  set S0 := Finset.univ.filter fun j => d j = v
  by_cases hS0 : 2 ≤ S0.card
  · refine ⟨rep S0 v, hS0, fun j => ⟨fun hj => (Finset.mem_filter.mp hj).2, fun hj => ?_⟩⟩
    have : d j ≠ v := fun e => hj (Finset.mem_filter.mpr ⟨Finset.mem_univ _, e⟩)
    exact lt_of_le_of_ne (ha j (Finset.mem_univ _)) (Ne.symm this)
  -- the minimum is unique
  have huniq : ∀ j, j ≠ a → v < d j := by
    intro j hj
    refine lt_of_le_of_ne (ha j (Finset.mem_univ _)) fun e => hS0 ?_
    have : ({a, j} : Finset (Fin 4)) ⊆ S0 := by
      intro i hi
      simp only [Finset.mem_insert, Finset.mem_singleton] at hi
      rcases hi with rfl | rfl
      · exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, rfl⟩
      · exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, e.symm⟩
    exact (Finset.card_pair (Ne.symm hj)).symm.le.trans (Finset.card_le_card this)
  -- the second minimum
  have hne : (Finset.univ.erase a).Nonempty := Finset.card_pos.mp (by
    rw [Finset.card_erase_of_mem (Finset.mem_univ _)]; simp)
  obtain ⟨i0, hi0, hmin2⟩ := Finset.exists_min_image (Finset.univ.erase a) d hne
  have hi0a : i0 ≠ a := (Finset.mem_erase.mp hi0).1
  set w := d i0
  have hvw : v < w := huniq i0 hi0a
  have hex : ∃ h, v / 2 ^ (h + 1) = w / 2 ^ (h + 1) :=
    ⟨w, by rw [Nat.div_eq_of_lt, Nat.div_eq_of_lt] <;>
      [exact (Nat.lt_two_pow_self).trans (Nat.pow_lt_pow_right (by norm_num) (by omega));
       exact hvw.trans ((Nat.lt_two_pow_self).trans
         (Nat.pow_lt_pow_right (by norm_num) (by omega)))]⟩
  set h := Nat.find hex
  have hh : v / 2 ^ (h + 1) = w / 2 ^ (h + 1) := Nat.find_spec hex
  have hh' : v / 2 ^ h ≠ w / 2 ^ h := by
    rcases Nat.eq_zero_or_pos h with h0 | hpos
    · rw [h0]; simp only [pow_zero, Nat.div_one]; omega
    · intro e
      have := Nat.find_min hex (show h - 1 < h by omega)
      rw [show h - 1 + 1 = h by omega] at this
      exact this e
  set k := v / 2 ^ (h + 1)
  have hv : v / 2 ^ h = 2 * k ∧ w / 2 ^ h = 2 * k + 1 := by
    have e1 : v / 2 ^ h / 2 = k := (div_pow_succ v h).symm
    have e2 : w / 2 ^ h / 2 = k := by rw [← div_pow_succ]; exact hh.symm
    have hle : v / 2 ^ h ≤ w / 2 ^ h := Nat.div_le_div_right hvw.le
    omega
  set S := (Finset.univ.erase a).filter fun j => d j / 2 ^ h = 2 * k + 1
  refine ⟨uniq a S h k, ⟨fun hm => (Finset.mem_erase.mp (Finset.mem_filter.mp hm).1).1 rfl,
    ⟨i0, Finset.mem_filter.mpr ⟨hi0, hv.2⟩⟩⟩, hv.1, fun j hj => ⟨fun hjS =>
      (Finset.mem_filter.mp hjS).2, fun hjS => ?_⟩⟩
  have h1 : w ≤ d j := hmin2 j (Finset.mem_erase.mpr ⟨hj, Finset.mem_univ _⟩)
  have h2 : 2 * k + 1 ≤ d j / 2 ^ h := hv.2 ▸ Nat.div_le_div_right h1
  have h3 : d j / 2 ^ h ≠ 2 * k + 1 := fun e =>
    hjS (Finset.mem_filter.mpr ⟨Finset.mem_erase.mpr ⟨hj, Finset.mem_univ _⟩, e⟩)
  omega

/-- The rectangles partition the depth tuples: a tuple lies in exactly one valid rectangle. -/
theorem existsUnique_mem (d : Fin 4 → ℕ) : ∃! R, Valid R ∧ Mem R d := by
  classical
  obtain ⟨R, hR, hm⟩ := exists_mem d
  refine ⟨R, ⟨hR, hm⟩, ?_⟩
  -- canonical data of a valid rectangle containing `d`
  suffices key : ∀ R₁ R₂, Valid R₁ → Mem R₁ d → Valid R₂ → Mem R₂ d → R₁ = R₂ from
    fun R' ⟨hR', hm'⟩ => key R' R hR' hm' hR hm
  intro R₁ R₂ hv₁ hm₁ hv₂ hm₂
  -- a `rep` rectangle has two minimizing slots; a `uniq` rectangle has a strict minimum
  have rep_min : ∀ S v, Valid (rep S v) → Mem (rep S v) d → ∀ j, v ≤ d j ∧ (d j = v ↔ j ∈ S) := by
    intro S v _ hm j
    by_cases hj : j ∈ S
    · exact ⟨((hm j).1 hj).ge, ⟨fun _ => hj, fun _ => (hm j).1 hj⟩⟩
    · exact ⟨((hm j).2 hj).le, ⟨fun e => absurd e (ne_of_gt ((hm j).2 hj)), fun h => absurd h hj⟩⟩
  have rep_uniq : ∀ S v a S' h k, Valid (rep S v) → Mem (rep S v) d →
      Mem (uniq a S' h k) d → False := by
    intro S v a S' h k hv hm hm'
    obtain ⟨j1, hj1, j2, hj2, hj12⟩ :=
      Finset.one_lt_card.mp (show 1 < S.card by have : 2 ≤ S.card := hv; omega)
    have hva := (rep_min S v hv hm a).1
    have hj : ∃ j ∈ S, j ≠ a := by
      by_cases e : j1 = a
      · exact ⟨j2, hj2, fun e2 => hj12 (e.trans e2.symm)⟩
      · exact ⟨j1, hj1, e⟩
    obtain ⟨j, hjS, hja⟩ := hj
    have := uniq_lt hm' hja
    rw [(hm j).1 hjS] at this
    omega
  cases R₁ with
  | rep S v =>
    cases R₂ with
    | rep S' v' =>
      obtain ⟨j, hj⟩ : S.Nonempty := Finset.card_pos.mp (by have : 2 ≤ S.card := hv₁; omega)
      obtain ⟨j', hj'⟩ : S'.Nonempty := Finset.card_pos.mp (by have : 2 ≤ S'.card := hv₂; omega)
      have e1 := (hm₁ j).1 hj
      have e2 := (hm₂ j').1 hj'
      have hvv : v = v' := le_antisymm (e2 ▸ (rep_min S v hv₁ hm₁ j').1)
        (e1 ▸ (rep_min S' v' hv₂ hm₂ j).1)
      subst hvv
      have hSS : S = S' := by
        ext i
        rw [← (rep_min S v hv₁ hm₁ i).2, (rep_min S' v hv₂ hm₂ i).2]
      rw [hSS]
    | uniq a S' h k => exact (rep_uniq S v a S' h k hv₁ hm₁ hm₂).elim
  | uniq a S h k =>
    cases R₂ with
    | rep S' v' => exact (rep_uniq S' v' a S h k hv₂ hm₂ hm₁).elim
    | uniq a' S' h' k' =>
      have haa : a = a' := by
        by_contra hne
        have := uniq_lt hm₁ (Ne.symm hne)
        have := uniq_lt hm₂ hne
        omega
      subst haa
      -- the second minimum
      have hne : (Finset.univ.erase a).Nonempty := Finset.card_pos.mp (by
        rw [Finset.card_erase_of_mem (Finset.mem_univ _)]; simp)
      obtain ⟨i0, hi0, hmin2⟩ := Finset.exists_min_image (Finset.univ.erase a) d hne
      have hi0a : i0 ≠ a := (Finset.mem_erase.mp hi0).1
      -- in each rectangle, `i0` lies in the upper half
      have upper : ∀ S h k, Valid (uniq a S h k) → Mem (uniq a S h k) d →
          d i0 / 2 ^ h = 2 * k + 1 := by
        intro S h k hv hm
        obtain ⟨j, hj⟩ := hv.2
        have hja : j ≠ a := fun e => hv.1 (e ▸ hj)
        have e1 := (hm.2 j hja).1 hj
        have hle : d i0 / 2 ^ h ≤ d j / 2 ^ h :=
          Nat.div_le_div_right (hmin2 j (Finset.mem_erase.mpr ⟨hja, Finset.mem_univ _⟩))
        have hge : 2 * k + 1 ≤ d i0 / 2 ^ h := by
          by_cases hi : i0 ∈ S
          · exact ((hm.2 i0 hi0a).1 hi).ge
          · have := (hm.2 i0 hi0a).2 hi; omega
        omega
      have u1 := upper S h k hv₁ hm₁
      have u2 := upper S' h' k' hv₂ hm₂
      have l1 := hm₁.1
      have l2 := hm₂.1
      -- the scale is the first level where the two depths share a block
      have blk : ∀ h k, d a / 2 ^ h = 2 * k → d i0 / 2 ^ h = 2 * k + 1 →
          d a / 2 ^ (h + 1) = d i0 / 2 ^ (h + 1) := by
        intro h k e1 e2
        rw [div_pow_succ, div_pow_succ, e1, e2]; omega
      have hhh : h = h' := by
        by_contra hne
        rcases lt_or_gt_of_ne hne with hlt | hlt
        · have := div_pow_eq_of_le (show h + 1 ≤ h' by omega) (blk h k l1 u1)
          rw [l2, u2] at this; omega
        · have := div_pow_eq_of_le (show h' + 1 ≤ h by omega) (blk h' k' l2 u2)
          rw [l1, u1] at this; omega
      subst hhh
      have hkk : k = k' := by omega
      subst hkk
      have hSS : S = S' := by
        ext j
        by_cases hja : j = a
        · subst hja; exact ⟨fun h => absurd h hv₁.1, fun h => absurd h hv₂.1⟩
        constructor
        · intro hj
          have e := (hm₁.2 j hja).1 hj
          by_contra hj'
          have := (hm₂.2 j hja).2 hj'; omega
        · intro hj
          have e := (hm₂.2 j hja).1 hj
          by_contra hj'
          have := (hm₁.2 j hja).2 hj'; omega
      rw [hSS]

/-- Positions at a level: for depths below `2^m`, a `uniq` rectangle has `h < m` and
`k < 2^(m-h-1)`; a `rep` rectangle has `v < 2^m`. -/
theorem uniq_bounds {a : Fin 4} {S : Finset (Fin 4)} {h k m : ℕ} {d : Fin 4 → ℕ}
    (hv : Valid (uniq a S h k)) (hm : Mem (uniq a S h k) d) (hd : ∀ j, d j < 2 ^ m) :
    h < m ∧ k < 2 ^ (m - h - 1) := by
  obtain ⟨j, hj⟩ := hv.2
  have hja : j ≠ a := fun e => hv.1 (e ▸ hj)
  have e := (hm.2 j hja).1 hj
  have hlt : d j / 2 ^ h < 2 ^ m / 2 ^ h :=
    Nat.div_lt_div_of_lt_of_dvd (Nat.pow_dvd_pow 2 (by
      by_contra hmh; push Not at hmh
      have : d j / 2 ^ h = 0 := Nat.div_eq_of_lt ((hd j).trans_le
        (Nat.pow_le_pow_right (by norm_num) hmh.le))
      omega)) (hd j)
  have hmh : h < m := by
    by_contra hmh; push Not at hmh
    have : d j / 2 ^ h = 0 := Nat.div_eq_of_lt ((hd j).trans_le
      (Nat.pow_le_pow_right (by norm_num) hmh))
    omega
  refine ⟨hmh, ?_⟩
  rw [Nat.pow_div hmh.le (by norm_num)] at hlt
  have : 2 ^ (m - h) = 2 * 2 ^ (m - h - 1) := by
    rw [← pow_succ']; congr 1; omega
  omega

end DepthRect

/-! ### Kernel sampling on the `δ`-lattice (lem:shortblock, blueprint lines 2298-2312) -/

/-- The first-order derivative constant of an admissible class. -/
noncomputable def admissibleLipConst (κ : LocalKernelClass) : ℝ :=
  (κ.derivativeConstant * ((1 : ℕ) + 2)) ^ (κ.derivativeConstant * ((1 : ℕ) + 2))

theorem admissibleLipConst_nonneg (κ : LocalKernelClass) : 0 ≤ admissibleLipConst κ := by
  unfold admissibleLipConst
  have := κ.one_le_derivativeConstant
  positivity

/-- An admissible kernel on a cell of length `r` is Lipschitz with constant `C_κ / r` in each
variable. -/
theorem admissible_kernel_lipschitz {κ : LocalKernelClass} {a r : ℝ}
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a r w) (z z' : ℝ × ℝ) :
    ‖w z - w z'‖ ≤ admissibleLipConst κ * r⁻¹ * (|z.1 - z'.1| + |z.2 - z'.2|) := by
  have hd : Differentiable ℝ w := hw.smooth.differentiable (by simp)
  have hb10 : ∀ y : ℝ × ℝ, ‖deriv (fun x => w (x, y.2)) y.1‖ ≤ admissibleLipConst κ * r⁻¹ := by
    intro y
    have := hw.derivativeBound 1 0 y
    simp only [localKernelPartial, iteratedDeriv_one, iteratedDeriv_zero] at this
    simpa [admissibleLipConst, pow_one, mul_comm] using this
  have hb01 : ∀ y : ℝ × ℝ, ‖deriv (fun t => w (y.1, t)) y.2‖ ≤ admissibleLipConst κ * r⁻¹ := by
    intro y
    have := hw.derivativeBound 0 1 y
    simp only [localKernelPartial, iteratedDeriv_one, iteratedDeriv_zero] at this
    simpa [admissibleLipConst, pow_one, mul_comm] using this
  have h1 : ‖w (z.1, z.2) - w (z'.1, z.2)‖ ≤ admissibleLipConst κ * r⁻¹ * |z.1 - z'.1| := by
    have hdx : Differentiable ℝ fun x => w (x, z.2) :=
      hd.comp (differentiable_id.prodMk (differentiable_const _))
    have := (convex_univ (𝕜 := ℝ) (E := ℝ)).norm_image_sub_le_of_norm_deriv_le
      (f := fun x => w (x, z.2)) (fun x _ => hdx x) (fun x _ => hb10 (x, z.2))
      (Set.mem_univ z'.1) (Set.mem_univ z.1)
    simpa [Real.norm_eq_abs] using this
  have h2 : ‖w (z'.1, z.2) - w (z'.1, z'.2)‖ ≤ admissibleLipConst κ * r⁻¹ * |z.2 - z'.2| := by
    have hdt : Differentiable ℝ fun t => w (z'.1, t) :=
      hd.comp ((differentiable_const _).prodMk differentiable_id)
    have := (convex_univ (𝕜 := ℝ) (E := ℝ)).norm_image_sub_le_of_norm_deriv_le
      (f := fun t => w (z'.1, t)) (fun t _ => hdt t) (fun t _ => hb01 (z'.1, t))
      (Set.mem_univ z'.2) (Set.mem_univ z.2)
    simpa [Real.norm_eq_abs] using this
  calc ‖w z - w z'‖ = ‖(w (z.1, z.2) - w (z'.1, z.2)) + (w (z'.1, z.2) - w (z'.1, z'.2))‖ := by
        congr 1; abel
    _ ≤ _ := (norm_add_le _ _).trans (by rw [mul_add]; exact add_le_add h1 h2)

/-- The kernel sampled on the `δ`-lattice: with `y₀ = x = δ(n₀ + u)` and
`y₁ = x + t = δ(n₁ + v)`, its value is `w(δ n₀, δ(n₁ - n₀))` (blueprint line 2307). -/
noncomputable def latticeSampledKernel (δ : ℝ) (w : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  w (δ * ⌊z.1 / δ⌋, δ * ⌊(z.1 + z.2) / δ⌋ - δ * ⌊z.1 / δ⌋)

theorem latticeSampled_offsets {δ : ℝ} (hδ : 0 < δ) (z : ℝ × ℝ) :
    0 ≤ z.1 - δ * ⌊z.1 / δ⌋ ∧ z.1 - δ * ⌊z.1 / δ⌋ < δ ∧
      0 ≤ (z.1 + z.2) - δ * ⌊(z.1 + z.2) / δ⌋ ∧ (z.1 + z.2) - δ * ⌊(z.1 + z.2) / δ⌋ < δ := by
  have k1 := Int.floor_le (z.1 / δ)
  have k2 := Int.lt_floor_add_one (z.1 / δ)
  have k3 := Int.floor_le ((z.1 + z.2) / δ)
  have k4 := Int.lt_floor_add_one ((z.1 + z.2) / δ)
  rw [le_div_iff₀ hδ] at k1 k3
  rw [div_lt_iff₀ hδ] at k2 k4
  refine ⟨by nlinarith only [k1], by nlinarith, by nlinarith, by nlinarith⟩

/-- Blueprint lines 2307-2312 (first kernel-sampling error): for an admissible kernel on a cell
of length `r` and `5δ ≤ μ r`, the form with the sampling error kernel `w - w^δ` is at most
`4 C_κ (δ / r)` times the product of normalized local norms, at every exponent tuple allowed by
`eq:absolute`. -/
theorem latticeSampled_form_error {κ : LocalKernelClass} {a r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a r w) {δ : ℝ} (hδ : 0 < δ)
    (hδr : 5 * δ ≤ κ.margin * r)
    (f : Fin 4 → ℝ → ℂ) (hf : ∀ i, Measurable (f i))
    (p : Fin 4 → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i) (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    ‖localProgressionForm r (fun z => w z - latticeSampledKernel δ w z) f‖ₑ ≤
      ENNReal.ofReal (4 * admissibleLipConst κ * (δ / r)) *
        ∏ i, eLpNorm (f i) (p i) (normalizedIntervalMeasure a r) := by
  set e : ℝ × ℝ → ℂ := fun z => w z - latticeSampledKernel δ w z
  have hwc : Continuous w := hw.smooth.continuous
  have hem : Measurable e := by
    have h1 : Measurable fun z : ℝ × ℝ =>
        (δ * ⌊z.1 / δ⌋, δ * ⌊(z.1 + z.2) / δ⌋ - δ * ⌊z.1 / δ⌋) := by
      have m1 : Measurable fun z : ℝ × ℝ => (⌊z.1 / δ⌋ : ℝ) :=
        measurable_from_top.comp (Int.measurable_floor.comp (measurable_fst.div_const δ))
      have m2 : Measurable fun z : ℝ × ℝ => (⌊(z.1 + z.2) / δ⌋ : ℝ) :=
        measurable_from_top.comp (Int.measurable_floor.comp
          ((measurable_fst.add measurable_snd).div_const δ))
      exact (m1.const_mul δ).prodMk ((m2.const_mul δ).sub (m1.const_mul δ))
    exact hwc.measurable.sub (hwc.measurable.comp h1)
  -- pointwise size of the error kernel
  have hsize : ∀ z, ‖e z‖ ≤ 2 * admissibleLipConst κ * (δ / r) := by
    intro z
    obtain ⟨o1, o2, o3, o4⟩ := latticeSampled_offsets hδ z
    have := admissible_kernel_lipschitz hw z
      (δ * ⌊z.1 / δ⌋, δ * ⌊(z.1 + z.2) / δ⌋ - δ * ⌊z.1 / δ⌋)
    simp only at this
    have hx : |z.1 - δ * ⌊z.1 / δ⌋| ≤ δ := by rw [abs_le]; constructor <;> linarith
    have ht : |z.2 - (δ * ⌊(z.1 + z.2) / δ⌋ - δ * ⌊z.1 / δ⌋)| ≤ δ := by
      rw [abs_le]; constructor <;> linarith
    have hL := admissibleLipConst_nonneg κ
    calc ‖e z‖ ≤ _ := this
      _ ≤ admissibleLipConst κ * r⁻¹ * (δ + δ) := by gcongr
      _ = 2 * admissibleLipConst κ * (δ / r) := by ring
  -- support inside the cell
  have hsupp : HasLocalProgressionSupport a r e := by
    intro z hz j
    have hμ := κ.margin_pos
    by_cases h0 : w z ≠ 0
    · obtain ⟨h1, h2⟩ := hw.support z h0 j
      constructor <;> nlinarith [mul_pos hμ hr]
    · push Not at h0
      have h0' : latticeSampledKernel δ w z ≠ 0 := by
        intro h; apply hz; simp only [e, h0, h, sub_self]
      obtain ⟨h1, h2⟩ := hw.support _ h0' j
      obtain ⟨o1, o2, o3, o4⟩ := latticeSampled_offsets hδ z
      have hj0 : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg _
      have hj3 : (j : ℝ) ≤ 3 := by exact_mod_cast Nat.le_of_lt_succ j.isLt
      simp only [realProgressionCoordinate] at h1 h2 ⊢
      set X := z.1 - δ * ⌊z.1 / δ⌋
      set Y := (z.1 + z.2) - δ * ⌊(z.1 + z.2) / δ⌋
      have hcoord : z.1 + (j : ℝ) * z.2 = (δ * ⌊z.1 / δ⌋ + (j : ℝ) *
          (δ * ⌊(z.1 + z.2) / δ⌋ - δ * ⌊z.1 / δ⌋)) + ((1 - (j : ℝ)) * X + (j : ℝ) * Y) := by
        simp only [X, Y]; ring
      have hd1 : |(1 - (j : ℝ)) * X + (j : ℝ) * Y| ≤ 5 * δ := by
        rw [abs_le]; constructor <;> nlinarith only [hj3, o1, o2, o3, o4]
      rw [abs_le] at hd1
      rw [hcoord]
      constructor <;> nlinarith only [mul_pos hμ hr, hδr, h1, hj3, o1, o2, o3, h2, o4]
  -- the form estimate
  have hW : ∀ z, ‖e z‖ₑ ≤ ENNReal.ofReal (2 * admissibleLipConst κ * (δ / r)) := fun z => by
    rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hsize z)
  have habs := localProgression_absoluteNormBound hr e hem hsupp hW f hf p hp hsum
  have hform : ‖localProgressionForm r e f‖ₑ ≤ ENNReal.ofReal r⁻¹ ^ 2 *
      ∫⁻ z : ℝ × ℝ, ‖e z‖ₑ * ∏ i, ‖f i (realProgressionCoordinate i z)‖ₑ := by
    unfold localProgressionForm
    rw [enorm_mul, enorm_pow, ← ofReal_norm, norm_inv, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hr]
    gcongr
    refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
    congr 1; funext z
    rw [enorm_mul]
    simp only [enorm_eq_nnnorm, nnnorm_prod, ENNReal.ofNNReal_finsetProd]
  refine hform.trans (habs.trans (le_of_eq ?_))
  rw [← ENNReal.ofReal_ofNat 2, ← ENNReal.ofReal_mul (by norm_num)]
  congr 2; ring

/-- The `δ`-lattice cell of the integer point `n ∈ ℤ²`. -/
def latticeCell (δ : ℝ) (n : ℤ × ℤ) : Set (ℝ × ℝ) :=
  Set.Ico (δ * n.1) (δ * (n.1 + 1)) ×ˢ Set.Ico (δ * n.2) (δ * (n.2 + 1))

theorem mem_latticeCell_iff {δ : ℝ} (hδ : 0 < δ) (n : ℤ × ℤ) (z : ℝ × ℝ) :
    z ∈ latticeCell δ n ↔ ⌊z.1 / δ⌋ = n.1 ∧ ⌊z.2 / δ⌋ = n.2 := by
  simp only [latticeCell, Set.mem_prod, Set.mem_Ico, Int.floor_eq_iff, le_div_iff₀ hδ,
    div_lt_iff₀ hδ]
  constructor <;> rintro ⟨⟨h1, h2⟩, h3, h4⟩ <;> refine ⟨⟨?_, ?_⟩, ?_, ?_⟩ <;> linarith

/-- Blueprint lines 2298-2305 (substitution `y = δ(n + u)`): an integrable function on `ℝ²` is the
`δ²`-weighted sum over `n ∈ ℤ²` of its integrals over the unit fast cell. -/
theorem lattice_integral_decomposition {G : ℝ × ℝ → ℂ} (hG : Integrable G) {δ : ℝ} (hδ : 0 < δ) :
    ∫ z, G z = (δ ^ 2 : ℝ) * ∑' n : ℤ × ℤ, ∫ u in Set.Ico (0 : ℝ) 1 ×ˢ Set.Ico (0 : ℝ) 1,
      G (δ * (n.1 + u.1), δ * (n.2 + u.2)) := by
  have hm : ∀ n, MeasurableSet (latticeCell δ n) := fun n =>
    measurableSet_Ico.prod measurableSet_Ico
  have hdis : Pairwise (Function.onFun Disjoint (latticeCell δ)) := by
    intro n n' hne
    refine Set.disjoint_left.mpr fun z h h' => hne ?_
    rw [mem_latticeCell_iff hδ] at h h'
    exact Prod.ext (h.1.symm.trans h'.1) (h.2.symm.trans h'.2)
  have hcov : (⋃ n, latticeCell δ n) = Set.univ := by
    ext z
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    exact ⟨(⌊z.1 / δ⌋, ⌊z.2 / δ⌋), (mem_latticeCell_iff hδ _ z).mpr ⟨rfl, rfl⟩⟩
  have h1 : ∫ z, G z = ∑' n, ∫ z in latticeCell δ n, G z := by
    rw [← integral_iUnion hm hdis (by rw [hcov]; exact hG.integrableOn), hcov,
      Measure.restrict_univ]
  rw [h1, ← tsum_mul_left]
  congr 1; funext n
  -- rescaling and translation on one cell
  set box : Set (ℝ × ℝ) := Set.Ico (0 : ℝ) 1 ×ˢ Set.Ico (0 : ℝ) 1
  have hind : ∀ u : ℝ × ℝ, (latticeCell δ n).indicator G (δ • (((n.1 : ℝ), (n.2 : ℝ)) + u)) =
      box.indicator (fun u => G (δ * (n.1 + u.1), δ * (n.2 + u.2))) u := by
    intro u
    have hiv : ∀ m x : ℝ, (δ * m ≤ δ * (m + x) ∧ δ * (m + x) < δ * (m + 1)) ↔
        (0 ≤ x ∧ x < 1) := by
      intro m x
      rw [mul_le_mul_iff_right₀ hδ, mul_lt_mul_iff_right₀ hδ]
      constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> linarith
    have hmem : δ • (((n.1 : ℝ), (n.2 : ℝ)) + u) ∈ latticeCell δ n ↔ u ∈ box := by
      have e1 : (δ • (((n.1 : ℝ), (n.2 : ℝ)) + u)).1 = δ * (n.1 + u.1) := by
        simp only [Prod.smul_fst, Prod.fst_add, smul_eq_mul]
      have e2 : (δ • (((n.1 : ℝ), (n.2 : ℝ)) + u)).2 = δ * (n.2 + u.2) := by
        simp only [Prod.smul_snd, Prod.snd_add, smul_eq_mul]
      simp only [latticeCell, box, Set.mem_prod, Set.mem_Ico, e1, e2, hiv]
    by_cases hu : u ∈ box
    · rw [Set.indicator_of_mem (hmem.mpr hu), Set.indicator_of_mem hu]
      congr 1
    · rw [Set.indicator_of_notMem (fun h => hu (hmem.mp h)), Set.indicator_of_notMem hu]
  have hscale := MeasureTheory.Measure.integral_comp_smul (volume : Measure (ℝ × ℝ))
    ((latticeCell δ n).indicator G) δ
  have hfin : Module.finrank ℝ (ℝ × ℝ) = 2 := by simp
  rw [hfin] at hscale
  have htr : ∫ y : ℝ × ℝ, (latticeCell δ n).indicator G (δ • y) =
      ∫ u : ℝ × ℝ, (latticeCell δ n).indicator G (δ • (((n.1 : ℝ), (n.2 : ℝ)) + u)) :=
    (integral_add_left_eq_self (fun y => (latticeCell δ n).indicator G (δ • y))
      (((n.1 : ℝ), (n.2 : ℝ)))).symm
  have key : ∫ z, (latticeCell δ n).indicator G z =
      ((δ ^ 2 : ℝ) : ℂ) * ∫ y : ℝ × ℝ, (latticeCell δ n).indicator G (δ • y) := by
    rw [hscale, Complex.real_smul, ← mul_assoc, ← Complex.ofReal_mul,
      abs_of_pos (by positivity), mul_inv_cancel₀ (by positivity), Complex.ofReal_one, one_mul]
  rw [← integral_indicator (hm n), key, htr,
    ← integral_indicator (measurableSet_Ico.prod measurableSet_Ico)]
  simp_rw [hind]
  rfl

/-! ### The fast multipliers and the fourth moment (lem:shortblock, blueprint lines 2314-2326) -/

/-- The additive character `e(x) = exp(2πix)` of a real phase. -/
noncomputable def ePhase (x : ℝ) : ℂ := Complex.exp (2 * Real.pi * Complex.I * x)

theorem ePhase_add (x y : ℝ) : ePhase x * ePhase y = ePhase (x + y) := by
  unfold ePhase; rw [← Complex.exp_add]; congr 1; push_cast; ring

theorem ePhase_conj (x : ℝ) : (starRingEnd ℂ) (ePhase x) = ePhase (-x) := by
  unfold ePhase
  rw [← Complex.exp_conj]
  congr 1
  rw [map_mul, map_mul, map_mul, Complex.conj_ofReal, Complex.conj_ofReal, Complex.conj_I,
    map_ofNat]
  push_cast; ring

theorem norm_ePhase (x : ℝ) : ‖ePhase x‖ = 1 := by
  unfold ePhase
  rw [Complex.norm_exp]
  simp

theorem continuous_ePhase : Continuous ePhase := by unfold ePhase; fun_prop

/-- `∫₀ᴸ e(k x / L) dx = L [k = 0]` for an integer frequency `k`. -/
theorem integral_ePhase_int (k : ℤ) {L : ℝ} (hL : 0 < L) :
    ∫ x in (0 : ℝ)..L, ePhase (k * x / L) = if k = 0 then (L : ℂ) else 0 := by
  split_ifs with hk
  · subst hk; simp [ePhase]
  set c : ℂ := 2 * Real.pi * Complex.I * k / L
  have hL' : (L : ℂ) ≠ 0 := by exact_mod_cast hL.ne'
  have hk' : (k : ℂ) ≠ 0 := by exact_mod_cast hk
  have hπ : (Real.pi : ℂ) ≠ 0 := by exact_mod_cast Real.pi_pos.ne'
  have hc : c ≠ 0 := by
    simp only [c]
    exact div_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero two_ne_zero hπ) Complex.I_ne_zero)
      hk') hL'
  have he : ∀ x : ℝ, ePhase (k * x / L) = Complex.exp (c * x) := by
    intro x; unfold ePhase; congr 1; simp only [c]; push_cast; field_simp
  simp_rw [he]
  rw [integral_exp_mul_complex hc]
  have h1 : c * (L : ℂ) = (k : ℂ) * (2 * Real.pi * Complex.I) := by
    simp only [c]; field_simp
  rw [h1, Complex.exp_int_mul_two_pi_mul_I]
  simp

/-- The fast trigonometric polynomial `Σ_m a_m e(γ m²/c + m w/16)` on the circle of length `16`
after the multiplier `e(γ m²/c)` (blueprint line 2316). -/
noncomputable def fastMultiplied (s : Finset ℤ) (a : ℤ → ℂ) (c : ℤ) (γ w : ℝ) : ℂ :=
  ∑ m ∈ s, a m * ePhase (γ * (m : ℝ) ^ 2 / c + m * w / 16)

/-- The fourth power expanded into the quadruple sum. -/
theorem fastMultiplied_norm_pow_four (s : Finset ℤ) (a : ℤ → ℂ) (c : ℤ) (γ w : ℝ) :
    ((‖fastMultiplied s a c γ w‖ ^ 4 : ℝ) : ℂ) =
      ∑ m₁ ∈ s, ∑ m₂ ∈ s, ∑ m₃ ∈ s, ∑ m₄ ∈ s,
        a m₁ * a m₂ * (starRingEnd ℂ) (a m₃) * (starRingEnd ℂ) (a m₄) *
          (ePhase (γ * ((m₁ : ℝ) ^ 2 + (m₂ : ℝ) ^ 2 - (m₃ : ℝ) ^ 2 - (m₄ : ℝ) ^ 2) / c) *
            ePhase (((m₁ + m₂ - m₃ - m₄ : ℤ) : ℝ) * w / 16)) := by
  set G := fastMultiplied s a c γ w
  have h4 : ((‖G‖ ^ 4 : ℝ) : ℂ) = (starRingEnd ℂ) G * (starRingEnd ℂ) G * G * G := by
    have : ((‖G‖ ^ 2 : ℝ) : ℂ) = G * (starRingEnd ℂ) G := by
      rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]
    rw [show ‖G‖ ^ 4 = (‖G‖ ^ 2) ^ 2 by ring, Complex.ofReal_pow, this]; ring
  rw [h4]
  simp only [G, fastMultiplied, map_sum, Finset.sum_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl fun m₁ _ => Finset.sum_congr rfl fun m₂ _ =>
    Finset.sum_congr rfl fun m₃ _ => Finset.sum_congr rfl fun m₄ _ => ?_
  simp only [map_mul, ePhase_conj]
  have hR : ePhase (γ * ((m₁ : ℝ) ^ 2 + (m₂ : ℝ) ^ 2 - (m₃ : ℝ) ^ 2 - (m₄ : ℝ) ^ 2) / c) *
      ePhase (((m₁ + m₂ - m₃ - m₄ : ℤ) : ℝ) * w / 16) =
        ePhase (γ * (m₁ : ℝ) ^ 2 / c + m₁ * w / 16) * ePhase (γ * (m₂ : ℝ) ^ 2 / c + m₂ * w / 16) *
          ePhase (-(γ * (m₃ : ℝ) ^ 2 / c + m₃ * w / 16)) *
          ePhase (-(γ * (m₄ : ℝ) ^ 2 / c + m₄ * w / 16)) := by
    rw [ePhase_add, ePhase_add, ePhase_add, ePhase_add]
    congr 1; push_cast; ring
  rw [hR]
  ring

/-- Interval integrals commute with quadruple finite sums of continuous functions. -/
theorem intervalIntegral_quad_sum {x₀ x₁ : ℝ} (s : Finset ℤ) (F : ℤ → ℤ → ℤ → ℤ → ℝ → ℂ)
    (hF : ∀ i j k l, Continuous (F i j k l)) :
    ∫ x in x₀..x₁, ∑ i ∈ s, ∑ j ∈ s, ∑ k ∈ s, ∑ l ∈ s, F i j k l x =
      ∑ i ∈ s, ∑ j ∈ s, ∑ k ∈ s, ∑ l ∈ s, ∫ x in x₀..x₁, F i j k l x := by
  have c1 : ∀ i j k, Continuous fun x => ∑ l ∈ s, F i j k l x := fun i j k =>
    continuous_finsetSum _ fun l _ => hF i j k l
  have c2 : ∀ i j, Continuous fun x => ∑ k ∈ s, ∑ l ∈ s, F i j k l x := fun i j =>
    continuous_finsetSum _ fun k _ => c1 i j k
  have c3 : ∀ i, Continuous fun x => ∑ j ∈ s, ∑ k ∈ s, ∑ l ∈ s, F i j k l x := fun i =>
    continuous_finsetSum _ fun j _ => c2 i j
  rw [intervalIntegral.integral_finsetSum fun i _ => (c3 i).intervalIntegrable _ _]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [intervalIntegral.integral_finsetSum fun j _ => (c2 i j).intervalIntegrable _ _]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [intervalIntegral.integral_finsetSum fun k _ => (c1 i j k).intervalIntegrable _ _]
  refine Finset.sum_congr rfl fun k _ => ?_
  exact intervalIntegral.integral_finsetSum fun l _ => (hF i j k l).intervalIntegrable _ _

/-- Blueprint `eq:fourth-moment` (lines 2318-2322) for finite Fourier sums: when `c ∣ 3`,
the average over `γ ∈ ℝ/3ℤ` of the normalized `L⁴` norm on the circle of length `16` satisfies
`E_γ ∫ |U_γ F|⁴ ≤ 2 (Σ |a_m|²)² = 2 ‖F‖₂⁴`. -/
theorem fast_fourth_moment (s : Finset ℤ) (a : ℤ → ℂ) {c : ℤ} (hc0 : c ≠ 0) (hc : c ∣ 3) :
    (1 / 3) * ∫ γ in (0 : ℝ)..3, (1 / 16) * ∫ w in (0 : ℝ)..16, ‖fastMultiplied s a c γ w‖ ^ 4 ≤
      2 * (∑ m ∈ s, ‖a m‖ ^ 2) ^ 2 := by
  classical
  obtain ⟨b, hb⟩ := hc
  have hcR : (c : ℝ) ≠ 0 := by exact_mod_cast hc0
  -- integration in `w`
  have hw : ∀ γ : ℝ, ((∫ w in (0 : ℝ)..16, ‖fastMultiplied s a c γ w‖ ^ 4 : ℝ) : ℂ) =
      16 * ∑ m₁ ∈ s, ∑ m₂ ∈ s, ∑ m₃ ∈ s, ∑ m₄ ∈ s,
        if m₁ + m₂ - m₃ - m₄ = 0 then
          a m₁ * a m₂ * (starRingEnd ℂ) (a m₃) * (starRingEnd ℂ) (a m₄) *
            ePhase (γ * ((m₁ : ℝ) ^ 2 + (m₂ : ℝ) ^ 2 - (m₃ : ℝ) ^ 2 - (m₄ : ℝ) ^ 2) / c)
        else 0 := by
    intro γ
    rw [← intervalIntegral.integral_ofReal]
    simp_rw [fastMultiplied_norm_pow_four]
    rw [intervalIntegral_quad_sum s _ fun m₁ m₂ m₃ m₄ => by
      have := continuous_ePhase; fun_prop]
    simp_rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun m₁ _ => Finset.sum_congr rfl fun m₂ _ =>
      Finset.sum_congr rfl fun m₃ _ => Finset.sum_congr rfl fun m₄ _ => ?_
    rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
      integral_ePhase_int _ (by norm_num : (0 : ℝ) < 16)]
    split_ifs <;> push_cast <;> ring
  -- integration in `γ`
  have hγ : ∀ q : ℤ, ∫ γ in (0 : ℝ)..3, ePhase (γ * q / c) = if q = 0 then (3 : ℂ) else 0 := by
    intro q
    have h := integral_ePhase_int (q * b) (L := 3) (by norm_num)
    have hq : ∀ γ : ℝ, ePhase (γ * q / c) = ePhase (((q * b : ℤ) : ℝ) * γ / 3) := by
      intro γ; congr 1
      have : (3 : ℝ) = c * b := by exact_mod_cast hb
      have hbR : (b : ℝ) ≠ 0 := by
        rintro h; rw [h, mul_zero] at this; norm_num at this
      rw [this]; push_cast; field_simp
    simp_rw [hq]
    rw [h]
    have hb0 : b ≠ 0 := by rintro rfl; simp at hb
    simp [hb0]
  set P : ℂ := ∑ m₁ ∈ s, ∑ m₂ ∈ s, ∑ m₃ ∈ s, ∑ m₄ ∈ s,
    (if m₁ + m₂ = m₃ + m₄ ∧ m₁ ^ 2 + m₂ ^ 2 = m₃ ^ 2 + m₄ ^ 2 then
      a m₁ * a m₂ * (starRingEnd ℂ) (a m₃) * (starRingEnd ℂ) (a m₄) else 0)
  have htotal : ((((1 / 3) * ∫ γ in (0 : ℝ)..3, (1 / 16) *
      ∫ w in (0 : ℝ)..16, ‖fastMultiplied s a c γ w‖ ^ 4) : ℝ) : ℂ) = P := by
    push_cast
    rw [← intervalIntegral.integral_ofReal]
    simp_rw [Complex.ofReal_mul, hw]
    simp_rw [Finset.mul_sum]
    rw [intervalIntegral_quad_sum s _ fun m₁ m₂ m₃ m₄ => by
      have := continuous_ePhase; split_ifs <;> fun_prop, Finset.mul_sum]
    refine Finset.sum_congr rfl fun m₁ _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun m₂ _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun m₃ _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun m₄ _ => ?_
    by_cases hd : m₁ + m₂ - m₃ - m₄ = 0
    · have hγq := hγ (m₁ ^ 2 + m₂ ^ 2 - m₃ ^ 2 - m₄ ^ 2)
      have hcast : ∀ γ : ℝ, γ * (((m₁ ^ 2 + m₂ ^ 2 - m₃ ^ 2 - m₄ ^ 2 : ℤ) : ℝ)) / c =
          γ * ((m₁ : ℝ) ^ 2 + (m₂ : ℝ) ^ 2 - (m₃ : ℝ) ^ 2 - (m₄ : ℝ) ^ 2) / c := by
        intro γ; push_cast; ring
      simp_rw [hcast] at hγq
      simp only [hd, ite_true]
      rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const_mul, hγq]
      have hd' : m₁ + m₂ = m₃ + m₄ := by omega
      by_cases hq : m₁ ^ 2 + m₂ ^ 2 - m₃ ^ 2 - m₄ ^ 2 = 0
      · have hq' : m₁ ^ 2 + m₂ ^ 2 = m₃ ^ 2 + m₄ ^ 2 := by omega
        rw [ite_eq_left hq, ite_eq_left ⟨hd', hq'⟩]
        push_cast; ring
      · have hq' : ¬ m₁ ^ 2 + m₂ ^ 2 = m₃ ^ 2 + m₄ ^ 2 := by omega
        simp [hq, hq']
    · have hd' : ¬ m₁ + m₂ = m₃ + m₄ := by omega
      simp [hd, hd']
  have hreal := congrArg (‖·‖) htotal
  simp only [Complex.norm_real, Real.norm_eq_abs] at hreal
  refine (le_abs_self _).trans (hreal.le.trans ?_)
  exact fourth_moment_pairing s a

/-- The fast multiplier coefficients `c = (-1, 3, -3, 1)` (blueprint line 2314). -/
def fastSlotC : Fin 4 → ℤ := ![-1, 3, -3, 1]

theorem ePhase_prod_four (x : Fin 4 → ℝ) : ∏ j, ePhase (x j) = ePhase (∑ j, x j) := by
  simp only [Fin.prod_univ_four, Fin.sum_univ_four, ePhase_add]

theorem ePhase_zero : ePhase 0 = 1 := by simp [ePhase]

/-- `fast_form_quadratic_invariance` over `ℝ`. -/
theorem fast_quadratic_invariance_real (m : Fin 4 → ℝ) (h0 : m 0 + m 1 + m 2 + m 3 = 0)
    (h1 : m 1 + 2 * m 2 + 3 * m 3 = 0) :
    ∑ j, m j ^ 2 / (fastSlotC j : ℝ) = 0 := by
  have hm1 : m 1 = -2 * m 2 - 3 * m 3 := by linarith
  have hm0 : m 0 = m 2 + 2 * m 3 := by linarith
  simp only [Fin.sum_univ_four, fastSlotC, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
  rw [hm0, hm1]; push_cast; ring

/-- The product of the four multiplied slots on the progression `w_j = (1-j)u + jv`, expanded
over frequency tuples. -/
theorem fast_slots_product (s : Finset ℤ) (a : Fin 4 → ℤ → ℂ) (γ u v : ℝ) :
    ∏ j : Fin 4, fastMultiplied s (a j) (fastSlotC j) γ ((1 - (j : ℝ)) * u + j * v) =
      ∑ p ∈ Fintype.piFinset fun _ : Fin 4 => s, (∏ j, a j (p j)) *
        (ePhase (γ * ∑ j, ((p j : ℝ)) ^ 2 / (fastSlotC j : ℝ)) *
          ePhase ((((∑ j : Fin 4, (1 - (j : ℤ)) * p j : ℤ) : ℝ) * u +
            ((∑ j : Fin 4, (j : ℤ) * p j : ℤ) : ℝ) * v) / 16)) := by
  simp only [fastMultiplied]
  rw [Finset.prod_univ_sum]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [Finset.prod_mul_distrib, ePhase_prod_four, ePhase_add]
  congr 2
  simp only [Fin.sum_univ_four]
  push_cast
  ring

/-- `∫₀¹⁶ ∫₀¹⁶ e((A u + B v)/16) dv du = 16² [A = 0][B = 0]`. -/
theorem double_integral_ePhase (A B : ℤ) :
    ∫ u in (0 : ℝ)..16, ∫ v in (0 : ℝ)..16, ePhase (((A : ℝ) * u + (B : ℝ) * v) / 16) =
      if A = 0 ∧ B = 0 then (256 : ℂ) else 0 := by
  have hsplit : ∀ u v : ℝ, ePhase (((A : ℝ) * u + (B : ℝ) * v) / 16) =
      ePhase ((A : ℝ) * u / 16) * ePhase ((B : ℝ) * v / 16) := by
    intro u v; rw [ePhase_add]; congr 1; ring
  simp_rw [hsplit, intervalIntegral.integral_const_mul]
  rw [integral_ePhase_int B (by norm_num : (0 : ℝ) < 16), intervalIntegral.integral_mul_const,
    integral_ePhase_int A (by norm_num : (0 : ℝ) < 16)]
  by_cases hA : A = 0 <;> by_cases hB : B = 0 <;> simp [hA, hB]; norm_num

/-- Blueprint lines 2314-2317: the fast form of the multiplied slots does not depend on `γ`:
its Fourier support has `Σ m_j = Σ j m_j = 0`, hence `Σ m_j² / c_j = 0`. The form equals
`16² Σ_{Σ m_j = Σ j m_j = 0} Π_j a_j(m_j)`. -/
theorem fast_form_eval (s : Finset ℤ) (a : Fin 4 → ℤ → ℂ) (γ : ℝ) :
    ∫ u in (0 : ℝ)..16, ∫ v in (0 : ℝ)..16,
        ∏ j : Fin 4, fastMultiplied s (a j) (fastSlotC j) γ ((1 - (j : ℝ)) * u + j * v) =
      256 * ∑ p ∈ Fintype.piFinset fun _ : Fin 4 => s,
        if (∑ j : Fin 4, (1 - (j : ℤ)) * p j) = 0 ∧ (∑ j : Fin 4, (j : ℤ) * p j) = 0 then
          ∏ j, a j (p j) else 0 := by
  simp_rw [fast_slots_product]
  have hc : ∀ p : Fin 4 → ℤ, Continuous fun x : ℝ × ℝ => (∏ j, a j (p j)) *
      (ePhase (γ * ∑ j, ((p j : ℝ)) ^ 2 / (fastSlotC j : ℝ)) *
        ePhase ((((∑ j : Fin 4, (1 - (j : ℤ)) * p j : ℤ) : ℝ) * x.1 +
          ((∑ j : Fin 4, (j : ℤ) * p j : ℤ) : ℝ) * x.2) / 16)) := by
    intro p; have := continuous_ePhase; fun_prop
  have hin : ∀ u : ℝ, ∫ v in (0 : ℝ)..16, ∑ p ∈ Fintype.piFinset fun _ : Fin 4 => s,
      (∏ j, a j (p j)) * (ePhase (γ * ∑ j, ((p j : ℝ)) ^ 2 / (fastSlotC j : ℝ)) *
        ePhase ((((∑ j : Fin 4, (1 - (j : ℤ)) * p j : ℤ) : ℝ) * u +
          ((∑ j : Fin 4, (j : ℤ) * p j : ℤ) : ℝ) * v) / 16)) =
      ∑ p ∈ Fintype.piFinset fun _ : Fin 4 => s, ∫ v in (0 : ℝ)..16,
      (∏ j, a j (p j)) * (ePhase (γ * ∑ j, ((p j : ℝ)) ^ 2 / (fastSlotC j : ℝ)) *
        ePhase ((((∑ j : Fin 4, (1 - (j : ℤ)) * p j : ℤ) : ℝ) * u +
          ((∑ j : Fin 4, (j : ℤ) * p j : ℤ) : ℝ) * v) / 16)) := fun u =>
    intervalIntegral.integral_finsetSum fun p _ =>
      ((hc p).comp (continuous_const.prodMk continuous_id)).intervalIntegrable _ _
  simp_rw [hin]
  rw [intervalIntegral.integral_finsetSum fun p _ => ?_]
  · rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun p _ => ?_
    simp_rw [intervalIntegral.integral_const_mul]
    rw [double_integral_ePhase]
    split_ifs with h
    · have e0 : p 0 - p 2 - 2 * p 3 = 0 := by
        have := h.1; simp only [Fin.sum_univ_four] at this; norm_num at this; linarith
      have e1 : p 1 + 2 * p 2 + 3 * p 3 = 0 := by
        have := h.2; simp only [Fin.sum_univ_four] at this; norm_num at this; linarith
      have hq : ∑ j, ((p j : ℝ)) ^ 2 / (fastSlotC j : ℝ) = 0 := by
        apply fast_quadratic_invariance_real
        · have : p 0 + p 1 + p 2 + p 3 = 0 := by linarith
          exact_mod_cast this
        · exact_mod_cast e1
      rw [hq, mul_zero, ePhase_zero]; ring
    · ring
  · have : Continuous fun u : ℝ => ∫ v in (0 : ℝ)..16,
        (∏ j, a j (p j)) * (ePhase (γ * ∑ j, ((p j : ℝ)) ^ 2 / (fastSlotC j : ℝ)) *
          ePhase ((((∑ j : Fin 4, (1 - (j : ℤ)) * p j : ℤ) : ℝ) * u +
            ((∑ j : Fin 4, (j : ℤ) * p j : ℤ) : ℝ) * v) / 16)) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        (hc p) 0 16
    exact this.intervalIntegrable _ _

/-- Blueprint lines 2314-2317: the multipliers `U_{j,γ}` leave the fast form unchanged. -/
theorem fast_form_invariance (s : Finset ℤ) (a : Fin 4 → ℤ → ℂ) (γ : ℝ) :
    ∫ u in (0 : ℝ)..16, ∫ v in (0 : ℝ)..16,
        ∏ j : Fin 4, fastMultiplied s (a j) (fastSlotC j) γ ((1 - (j : ℝ)) * u + j * v) =
      ∫ u in (0 : ℝ)..16, ∫ v in (0 : ℝ)..16,
        ∏ j : Fin 4, fastMultiplied s (a j) (fastSlotC j) 0 ((1 - (j : ℝ)) * u + j * v) := by
  rw [fast_form_eval, fast_form_eval]

/-- Blueprint lines 2302-2307 (lift to the fast variables): with `y₀ = x = δ(n₀ + u)` and
`y₁ = x + t = δ(n₁ + v)`, the form with the lattice-sampled kernel is the `δ²`-weighted sum over
`n ∈ ℤ²` of `w(δ n₀, δ(n₁ - n₀))` times the fast integral over the unit cell of the inputs at
`δ(n_j + w_j)`, `n_j = (1-j)n₀ + j n₁`, `w_j = (1-j)u + j v`. -/
theorem latticeSampled_form_lift {w : ℝ × ℝ → ℂ} {δ : ℝ} (hδ : 0 < δ) (f : Fin 4 → ℝ → ℂ)
    (hF : Integrable fun z : ℝ × ℝ =>
      latticeSampledKernel δ w z * ∏ j, f j (realProgressionCoordinate j z)) :
    ∫ z : ℝ × ℝ, latticeSampledKernel δ w z * ∏ j, f j (realProgressionCoordinate j z) =
      (δ ^ 2 : ℝ) * ∑' n : ℤ × ℤ, w (δ * n.1, δ * n.2 - δ * n.1) *
        ∫ u in Set.Ico (0 : ℝ) 1 ×ˢ Set.Ico (0 : ℝ) 1, ∏ j : Fin 4,
          f j (δ * (((1 - (j : ℝ)) * n.1 + j * n.2) + ((1 - (j : ℝ)) * u.1 + j * u.2))) := by
  set F : ℝ × ℝ → ℂ := fun z =>
    latticeSampledKernel δ w z * ∏ j, f j (realProgressionCoordinate j z)
  set g : ℝ × ℝ → ℂ := fun y => F (y.1, y.2 - y.1)
  have hS : MeasurePreserving (MeasurableEquiv.shearAddRight ℝ) (volume : Measure (ℝ × ℝ))
      volume := by
    rw [Measure.volume_eq_prod]
    exact measurePreserving_prod_add volume volume
  have hgF : ∀ z, g (MeasurableEquiv.shearAddRight ℝ z) = F z := by
    intro z; simp [g, MeasurableEquiv.shearAddRight]
  have h1 : ∫ z, F z = ∫ y, g y := by
    rw [← hS.integral_comp' g]; simp_rw [hgF]
  have hgi : Integrable g := by
    have hc : Integrable (g ∘ MeasurableEquiv.shearAddRight ℝ) := by
      convert hF using 1; funext z; exact hgF z
    exact (hS.integrable_comp_emb (MeasurableEquiv.shearAddRight ℝ).measurableEmbedding).mp hc
  rw [h1, lattice_integral_decomposition hgi hδ]
  congr 1
  refine tsum_congr fun n => ?_
  rw [← integral_const_mul]
  refine setIntegral_congr_fun (measurableSet_Ico.prod measurableSet_Ico) fun u hu => ?_
  obtain ⟨⟨hu1, hu2⟩, hv1, hv2⟩ := hu
  have hfl1 : ⌊(δ * (n.1 + u.1)) / δ⌋ = n.1 := by
    rw [mul_div_cancel_left₀ _ hδ.ne', Int.floor_eq_iff]; constructor <;> linarith
  have hfl2 : ⌊(δ * (n.1 + u.1) + (δ * (n.2 + u.2) - δ * (n.1 + u.1))) / δ⌋ = n.2 := by
    rw [show δ * (n.1 + u.1) + (δ * (n.2 + u.2) - δ * (n.1 + u.1)) = δ * (n.2 + u.2) by ring,
      mul_div_cancel_left₀ _ hδ.ne', Int.floor_eq_iff]
    constructor <;> linarith
  simp only [g, F, latticeSampledKernel, hfl1, hfl2]
  congr 1
  refine Finset.prod_congr rfl fun j _ => ?_
  congr 1
  simp only [realProgressionCoordinate]
  ring

section WindowMass
variable {ι : Type*} (S : Finset ι) (aL lL : ι → ℝ)

/-! ### Window masses (lem:shortblock, blueprint lines 2328-2332) -/

/-- The leaf interval `[a_i, a_i + l_i)`. -/
def leafInterval (i : ι) : Set ℝ := Set.Ico (aL i) (aL i + lL i)

variable {S aL lL}

/-- The selected leaf union `E = ⋃_{i ∈ S} L_i`. -/
def leafUnion (S : Finset ι) (aL lL : ι → ℝ) : Set ℝ := ⋃ i ∈ S, leafInterval aL lL i

open Classical in
/-- The mass of `z` on the leaves meeting a set `W` is at most the total length of those leaves. -/
theorem leaf_mass_le (hdis : (S : Set ι).PairwiseDisjoint (leafInterval aL lL))
    (z : ℝ → ℂ) (hz : ∀ i ∈ S, ∫⁻ x in leafInterval aL lL i, ‖z x‖ₑ ^ 2 ≤ ENNReal.ofReal (lL i))
    (W : Set ℝ) :
    ∫⁻ x in W ∩ leafUnion S aL lL, ‖z x‖ₑ ^ 2 ≤
      volume (⋃ i ∈ S.filter fun i => (W ∩ leafInterval aL lL i).Nonempty,
        leafInterval aL lL i) := by
  classical
  set T := S.filter fun i => (W ∩ leafInterval aL lL i).Nonempty
  have hsub : W ∩ leafUnion S aL lL ⊆ ⋃ i ∈ T, leafInterval aL lL i := by
    rintro x ⟨hxW, hxE⟩
    simp only [leafUnion, Set.mem_iUnion] at hxE
    obtain ⟨i, hi, hx⟩ := hxE
    exact Set.mem_biUnion (Finset.mem_filter.mpr ⟨hi, x, hxW, hx⟩) hx
  have hdisT : (T : Set ι).PairwiseDisjoint (leafInterval aL lL) :=
    hdis.subset (by intro i hi; exact (Finset.mem_filter.mp hi).1)
  calc ∫⁻ x in W ∩ leafUnion S aL lL, ‖z x‖ₑ ^ 2
      ≤ ∫⁻ x in ⋃ i ∈ T, leafInterval aL lL i, ‖z x‖ₑ ^ 2 := lintegral_mono_set hsub
    _ = ∑ i ∈ T, ∫⁻ x in leafInterval aL lL i, ‖z x‖ₑ ^ 2 :=
        lintegral_biUnion_finset hdisT (fun _ _ => measurableSet_Ico) _
    _ ≤ ∑ i ∈ T, volume (leafInterval aL lL i) := by
        refine Finset.sum_le_sum fun i hi => (hz i (Finset.mem_filter.mp hi).1).trans ?_
        simp [leafInterval, Real.volume_Ico]
    _ = volume (⋃ i ∈ T, leafInterval aL lL i) :=
        (measure_biUnion_finset hdisT (fun _ _ => measurableSet_Ico)).symm

end WindowMass

section FastTorus

/-! ### The mixed lattice-torus absolute estimate (lem:shortblock, blueprint lines 2307-2340) -/

/-- The fast circle `T₀ = ℝ / 16ℤ` of blueprint line 2303. -/
abbrev FastCircle := AddCircle (16 : ℝ)

instance : Fact ((0 : ℝ) < 16) := ⟨by norm_num⟩

/-- Normalized Haar measure on the fast circle. -/
noncomputable abbrev fastHaar : Measure FastCircle := AddCircle.haarAddCircle

/-- The progression coordinate `w_j = (1 - j) u + j v` as a homomorphism `T₀² → T₀`. -/
def fastCoord (j : ℤ) : FastCircle × FastCircle →+ FastCircle where
  toFun x := (1 - j) • x.1 + j • x.2
  map_zero' := by simp
  map_add' x y := by simp only [Prod.fst_add, Prod.snd_add, smul_add]; abel

theorem continuous_fastCoord (j : ℤ) : Continuous (fastCoord j) := by
  change Continuous fun x : FastCircle × FastCircle => (1 - j) • x.1 + j • x.2
  fun_prop

theorem fastCoord_surjective (j : ℤ) : Function.Surjective (fastCoord j) := by
  intro x
  refine ⟨(x, x), ?_⟩
  change (1 - j) • x + j • x = x
  rw [← add_smul]; simp

/-- Two distinct progression coordinates `(w_i, w_j)` as a homomorphism `T₀² → T₀²`. -/
def fastPair (i j : ℤ) : FastCircle × FastCircle →+ FastCircle × FastCircle :=
  (fastCoord i).prod (fastCoord j)

theorem fastPair_surjective {i j : ℤ} (hij : i ≠ j) : Function.Surjective (fastPair i j) := by
  rintro ⟨x, y⟩
  obtain ⟨a, rfl⟩ := QuotientAddGroup.mk_surjective x
  obtain ⟨b, rfl⟩ := QuotientAddGroup.mk_surjective y
  have hd : ((j : ℝ) - i) ≠ 0 := sub_ne_zero.mpr (by exact_mod_cast hij.symm)
  set u : ℝ := (j * a - i * b) / (j - i)
  set v : ℝ := ((1 - i) * b - (1 - j) * a) / (j - i)
  refine ⟨((u : FastCircle), (v : FastCircle)), ?_⟩
  have h1 : (1 - (i : ℝ)) * u + i * v = a := by
    simp only [u, v]; field_simp; ring
  have h2 : (1 - (j : ℝ)) * u + j * v = b := by
    simp only [u, v]; field_simp; ring
  change ((1 - i) • (u : FastCircle) + i • (v : FastCircle),
    (1 - j) • (u : FastCircle) + j • (v : FastCircle)) = ((a : FastCircle), (b : FastCircle))
  simp only [← AddCircle.coe_zsmul, zsmul_eq_mul, ← AddCircle.coe_add]
  push_cast
  rw [h1, h2]

instance : IsProbabilityMeasure (fastHaar.prod fastHaar) := inferInstance

theorem map_fastCoord : Measure.map (fastCoord j) (fastHaar.prod fastHaar) = fastHaar := by
  have : Measure.IsAddHaarMeasure (Measure.map (fastCoord j) (fastHaar.prod fastHaar)) :=
    Measure.isAddHaarMeasure_map_of_isFiniteMeasure _ (fastCoord j) (continuous_fastCoord j)
      (fastCoord_surjective j)
  have : IsProbabilityMeasure (Measure.map (fastCoord j) (fastHaar.prod fastHaar)) :=
    ⟨by rw [Measure.map_apply (continuous_fastCoord j).measurable MeasurableSet.univ]; simp⟩
  exact Measure.isAddHaarMeasure_eq_of_isProbabilityMeasure _ _

theorem map_fastPair {i j : ℤ} (hij : i ≠ j) :
    Measure.map (fastPair i j) (fastHaar.prod fastHaar) = fastHaar.prod fastHaar := by
  have hc : Continuous (fastPair i j) :=
    (continuous_fastCoord i).prodMk (continuous_fastCoord j)
  have : Measure.IsAddHaarMeasure (Measure.map (fastPair i j) (fastHaar.prod fastHaar)) :=
    Measure.isAddHaarMeasure_map_of_isFiniteMeasure _ (fastPair i j) hc (fastPair_surjective hij)
  have : IsProbabilityMeasure (Measure.map (fastPair i j) (fastHaar.prod fastHaar)) :=
    ⟨by rw [Measure.map_apply hc.measurable MeasurableSet.univ]; simp⟩
  exact Measure.isAddHaarMeasure_eq_of_isProbabilityMeasure _ _

/-- The single progression coordinate pushes Haar measure on `T₀²` to Haar measure on `T₀`. -/
theorem lintegral_fastCoord (j : ℤ) {f : FastCircle → ℝ≥0∞} (hf : Measurable f) :
    ∫⁻ x, f (fastCoord j x) ∂(fastHaar.prod fastHaar) = ∫⁻ t, f t ∂fastHaar := by
  rw [← lintegral_map hf (continuous_fastCoord j).measurable, map_fastCoord]

/-- Blueprint line 394 (torus pair endpoint): two distinct progression coordinates are
independent: `∫∫ f(w_i) g(w_j) = ∫ f ∫ g`. -/
theorem lintegral_fastPair {i j : ℤ} (hij : i ≠ j) {f g : FastCircle → ℝ≥0∞}
    (hf : Measurable f) (hg : Measurable g) :
    ∫⁻ x, f (fastCoord i x) * g (fastCoord j x) ∂(fastHaar.prod fastHaar) =
      (∫⁻ t, f t ∂fastHaar) * ∫⁻ t, g t ∂fastHaar := by
  have hc : Continuous (fastPair i j) :=
    (continuous_fastCoord i).prodMk (continuous_fastCoord j)
  have hm : Measurable fun y : FastCircle × FastCircle => f y.1 * g y.2 :=
    (hf.comp measurable_fst).mul (hg.comp measurable_snd)
  have := lintegral_map hm hc.measurable (μ := fastHaar.prod fastHaar)
  rw [map_fastPair hij] at this
  rw [lintegral_prod_mul hf.aemeasurable hg.aemeasurable] at this
  exact this.symm

end FastTorus

/-- The slow progression coordinate `n_j = (1 - j) n₀ + j n₁`. -/
def latticeCoord (j : ℤ) (n : ℤ × ℤ) : ℤ := (1 - j) * n.1 + j * n.2

theorem latticeCoord_pair_injective {i j : ℤ} (hij : i ≠ j) :
    Function.Injective fun n : ℤ × ℤ => (latticeCoord i n, latticeCoord j n) := by
  intro n n' h
  simp only [latticeCoord, Prod.mk.injEq] at h
  obtain ⟨h1, h2⟩ := h
  have hd : (j - i) * (n.2 - n.1 - (n'.2 - n'.1)) = 0 := by linear_combination h2 - h1
  rcases mul_eq_zero.mp hd with h | h
  · exact absurd (by linarith : i = j) hij
  · have e : n.2 - n.1 = n'.2 - n'.1 := by linarith
    have e1 : n.1 = n'.1 := by
      have : n.1 + i * (n.2 - n.1) = n'.1 + i * (n'.2 - n'.1) := by linarith
      rw [e] at this; linarith
    exact Prod.ext e1 (by linarith)

/-- The mixed measure: weight `ε²` on the slow pairs in `B`, normalized Haar measure on `T₀²`. -/
noncomputable def latticeTorusMeasure (B : Finset (ℤ × ℤ)) (ε : ℝ≥0∞) :
    Measure ((ℤ × ℤ) × (FastCircle × FastCircle)) :=
  (∑ n ∈ B, ε ^ 2 • Measure.dirac n).prod (fastHaar.prod fastHaar)

/-- The target measure: weight `ε` on each slow point, normalized Haar measure on `T₀`. -/
noncomputable def latticeCircleMeasure (ε : ℝ≥0∞) : Measure (ℤ × FastCircle) :=
  (ε • Measure.count).prod fastHaar

/-- The progression map `(n, u, v) ↦ (n_j, w_j)`. -/
def latticeTorusProj (j : ℤ) (x : (ℤ × ℤ) × (FastCircle × FastCircle)) : ℤ × FastCircle :=
  (latticeCoord j x.1, fastCoord j x.2)

theorem measurable_latticeTorusProj (j : ℤ) : Measurable (latticeTorusProj j) :=
  ((measurable_of_countable (latticeCoord j)).comp measurable_fst).prodMk
    ((continuous_fastCoord j).measurable.comp measurable_snd)

theorem lintegral_latticeTorusMeasure (B : Finset (ℤ × ℤ)) (ε : ℝ≥0∞)
    {F : (ℤ × ℤ) × (FastCircle × FastCircle) → ℝ≥0∞} (hF : Measurable F) :
    ∫⁻ x, F x ∂latticeTorusMeasure B ε =
      ∑ n ∈ B, ε ^ 2 * ∫⁻ w, F (n, w) ∂(fastHaar.prod fastHaar) := by
  rw [latticeTorusMeasure, lintegral_prod _ hF.aemeasurable, lintegral_finsetSum_measure]
  refine Finset.sum_congr rfl fun n _ => ?_
  rw [lintegral_smul_measure, lintegral_dirac' _ (measurable_of_countable _)]
  rfl

theorem lintegral_latticeCircleMeasure (ε : ℝ≥0∞) {f : ℤ × FastCircle → ℝ≥0∞}
    (hf : Measurable f) :
    ∫⁻ y, f y ∂latticeCircleMeasure ε = ε * ∑' m, ∫⁻ t, f (m, t) ∂fastHaar := by
  rw [latticeCircleMeasure, lintegral_prod _ hf.aemeasurable, lintegral_smul_measure,
    lintegral_count, smul_eq_mul]

/-- Total mass of the mixed lattice-torus measure. -/
theorem latticeTorus_empty (B : Finset (ℤ × ℤ)) {ε C : ℝ≥0∞} (hB : ε ^ 2 * B.card ≤ C) :
    latticeTorusMeasure B ε Set.univ ≤ C := by
  rw [latticeTorusMeasure, ← Set.univ_prod_univ, Measure.prod_prod]
  simp only [Measure.coe_finsetSum, Finset.sum_apply, Measure.smul_apply,
    Measure.dirac_apply_of_mem (Set.mem_univ _), smul_eq_mul, mul_one, measure_univ,
    Finset.sum_const, nsmul_eq_mul]
  rw [mul_comm]; exact hB

/-- The single-coordinate endpoint of the mixed absolute estimate. -/
theorem latticeTorus_single (B : Finset (ℤ × ℤ)) {ε M C : ℝ≥0∞} (hM : ε * M ≤ C)
    (hfib : ∀ j : Fin 4, ∀ m, ((B.filter fun n => latticeCoord j n = m).card : ℝ≥0∞) ≤ M)
    (i : Fin 4) (g : ℤ × FastCircle → ℝ≥0∞) (hg : Measurable g) :
    ∫⁻ x, g (latticeTorusProj i x) ∂latticeTorusMeasure B ε ≤
      C * ∫⁻ y, g y ∂latticeCircleMeasure ε := by
  classical
  rw [lintegral_latticeTorusMeasure B ε (F := fun x => g (latticeTorusProj i x))
    (hg.comp (measurable_latticeTorusProj i)),
    lintegral_latticeCircleMeasure ε hg]
  set F : ℤ → ℝ≥0∞ := fun m => ∫⁻ t, g (m, t) ∂fastHaar
  have hF : ∀ n, ∫⁻ w, g (latticeTorusProj i (n, w)) ∂(fastHaar.prod fastHaar) =
      F (latticeCoord i n) := fun n =>
    lintegral_fastCoord i (f := fun t => g (latticeCoord i n, t))
      (hg.comp measurable_prodMk_left)
  simp_rw [hF]
  have hfw : ∑ n ∈ B, ε ^ 2 * F (latticeCoord i n) ≤ ε ^ 2 * (M * ∑' m, F m) := by
    rw [← Finset.mul_sum]
    gcongr
    rw [← Finset.sum_fiberwise_of_maps_to (g := latticeCoord i) (t := B.image (latticeCoord i))
      (fun n hn => Finset.mem_image_of_mem _ hn)]
    calc ∑ m ∈ B.image (latticeCoord i), ∑ n ∈ B with latticeCoord i n = m,
          F (latticeCoord i n) = ∑ m ∈ B.image (latticeCoord i),
            ((B.filter fun n => latticeCoord i n = m).card : ℝ≥0∞) * F m := by
          refine Finset.sum_congr rfl fun m _ => ?_
          rw [Finset.sum_congr rfl fun n hn => by rw [(Finset.mem_filter.mp hn).2],
            Finset.sum_const, nsmul_eq_mul]
      _ ≤ ∑ m ∈ B.image (latticeCoord i), M * F m :=
          Finset.sum_le_sum fun m _ => by gcongr; exact hfib i m
      _ = M * ∑ m ∈ B.image (latticeCoord i), F m := by rw [Finset.mul_sum]
      _ ≤ M * ∑' m, F m := by gcongr; exact ENNReal.sum_le_tsum _
  refine hfw.trans ?_
  calc ε ^ 2 * (M * ∑' m, F m) = (ε * M) * (ε * ∑' m, F m) := by ring
    _ ≤ C * (ε * ∑' m, F m) := by gcongr

/-- The pair endpoint of the mixed absolute estimate. -/
theorem latticeTorus_pair (B : Finset (ℤ × ℤ)) {ε C : ℝ≥0∞} (hC1 : 1 ≤ C) (i j : Fin 4)
    (hij : i ≠ j) (g h : ℤ × FastCircle → ℝ≥0∞) (hg : Measurable g) (hh : Measurable h) :
    ∫⁻ x, g (latticeTorusProj i x) * h (latticeTorusProj j x) ∂latticeTorusMeasure B ε ≤
      C * (∫⁻ y, g y ∂latticeCircleMeasure ε) * ∫⁻ y, h y ∂latticeCircleMeasure ε := by
  classical
  have hij' : (i : ℤ) ≠ j := fun e => hij (Fin.ext (by exact_mod_cast e))
  rw [lintegral_latticeTorusMeasure B ε
    (F := fun x => g (latticeTorusProj i x) * h (latticeTorusProj j x))
    ((hg.comp (measurable_latticeTorusProj i)).mul
    (hh.comp (measurable_latticeTorusProj j))), lintegral_latticeCircleMeasure ε hg,
    lintegral_latticeCircleMeasure ε hh]
  set F : ℤ → ℝ≥0∞ := fun m => ∫⁻ t, g (m, t) ∂fastHaar
  set G : ℤ → ℝ≥0∞ := fun m => ∫⁻ t, h (m, t) ∂fastHaar
  have hFG : ∀ n, ∫⁻ w, g (latticeTorusProj i (n, w)) * h (latticeTorusProj j (n, w))
      ∂(fastHaar.prod fastHaar) = F (latticeCoord i n) * G (latticeCoord j n) := fun n =>
    lintegral_fastPair hij' (f := fun t => g (latticeCoord i n, t))
      (g := fun t => h (latticeCoord j n, t)) (hg.comp measurable_prodMk_left)
      (hh.comp measurable_prodMk_left)
  simp_rw [hFG]
  set K : ℤ × ℤ → ℤ × ℤ := fun n => (latticeCoord i n, latticeCoord j n)
  have hK : Function.Injective K := latticeCoord_pair_injective hij'
  have hsum : ∑ n ∈ B, F (latticeCoord i n) * G (latticeCoord j n) ≤
      (∑' m, F m) * ∑' m, G m := by
    calc ∑ n ∈ B, F (latticeCoord i n) * G (latticeCoord j n) =
          ∑ p ∈ B.image K, F p.1 * G p.2 := by
          rw [Finset.sum_image fun x _ y _ e => hK e]
      _ ≤ ∑' p : ℤ × ℤ, F p.1 * G p.2 := ENNReal.sum_le_tsum _
      _ = (∑' m, F m) * ∑' m, G m := by
          rw [ENNReal.tsum_prod']
          simp_rw [ENNReal.tsum_mul_left]
          exact ENNReal.tsum_mul_right
  calc ∑ n ∈ B, ε ^ 2 * (F (latticeCoord i n) * G (latticeCoord j n))
      = ε ^ 2 * ∑ n ∈ B, F (latticeCoord i n) * G (latticeCoord j n) := by
        rw [Finset.mul_sum]
    _ ≤ ε ^ 2 * ((∑' m, F m) * ∑' m, G m) := by gcongr
    _ = 1 * (ε * ∑' m, F m) * (ε * ∑' m, G m) := by ring
    _ ≤ C * (ε * ∑' m, F m) * (ε * ∑' m, G m) := by gcongr

/-- `eq:absolute` on local counting measure times Haar measure, in normed form: for exponents
`p_j ≥ 1` with `Σ 1/p_j ≤ 2`, the positive form is at most `C Π_j ‖f_j‖_{L^{p_j}}`. -/
theorem latticeTorus_eLpNorm_bound (B : Finset (ℤ × ℤ)) {ε M C : ℝ≥0∞} (hC1 : 1 ≤ C)
    (hB : ε ^ 2 * B.card ≤ C) (hM : ε * M ≤ C)
    (hfib : ∀ j : Fin 4, ∀ m, ((B.filter fun n => latticeCoord j n = m).card : ℝ≥0∞) ≤ M)
    (f : Fin 4 → ℤ × FastCircle → ℝ≥0∞) (hf : ∀ i, Measurable (f i))
    (p : Fin 4 → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i) (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    ∫⁻ x, ∏ i, f i (latticeTorusProj i x) ∂latticeTorusMeasure B ε ≤
      C * ∏ i, eLpNorm (f i) (p i) (latticeCircleMeasure ε) :=
  positivePairwise_eLpNorm_bound (latticeTorusMeasure B ε) (latticeCircleMeasure ε)
    (fun i => latticeTorusProj i) (fun i => measurable_latticeTorusProj i) C
    (latticeTorus_empty B hB) (latticeTorus_single B hM hfib)
    (fun i j hij => latticeTorus_pair B hC1 i j hij) f hf p hp hsum

/-- The uniform probability on `γ ∈ [0, 3)` (blueprint line 2316, `γ ∈ ℝ/3ℤ`). -/
noncomputable def gammaMeasure : Measure ℝ :=
  ENNReal.ofReal (1 / 3) • volume.restrict (Set.Ioc 0 3)

instance : IsProbabilityMeasure gammaMeasure := by
  constructor
  rw [gammaMeasure, Measure.smul_apply, Measure.restrict_apply_univ, Real.volume_Ioc,
    smul_eq_mul, ← ENNReal.ofReal_mul (by norm_num)]
  norm_num

/-- The squared window mass `e(ω, m)² = Σ_k |A(ω, m, k)|²`. -/
noncomputable def fastMass {Ω : Type*} (s : Finset ℤ) (A : Ω → ℤ → ℤ → ℂ) (ω : Ω) (m : ℤ) :
    ℝ :=
  ∑ k ∈ s, ‖A ω m k‖ ^ 2

instance (ε : ℝ≥0∞) : SFinite (latticeCircleMeasure ε) := by
  unfold latticeCircleMeasure; infer_instance

theorem fastSlotC_ne_zero (j : Fin 4) : fastSlotC j ≠ 0 := by
  fin_cases j <;> simp [fastSlotC]

theorem fastSlotC_dvd (j : Fin 4) : fastSlotC j ∣ 3 := by
  fin_cases j <;> simp [fastSlotC]

/-! ### Continuous comparison (lem:shortblock, blueprint lines 2345-2357) -/

/-- Blueprint lines 2347-2349: if the four intervals `|y - δ n_j| < c δ` with `c < 1/7` meet a real
progression `y_j = x + j t`, the integer centers form a lattice progression:
`n_j = (1 - j) n₀ + j n₁`. -/
theorem interval_centers_progression {δ c : ℝ} (hδ : 0 < δ) (hc : c < 1 / 7)
    (n : Fin 4 → ℤ) (z : ℝ × ℝ)
    (hn : ∀ j, |realProgressionCoordinate j z - δ * n j| < c * δ) (j : Fin 4) :
    n j = latticeCoord j (n 0, n 1) := by
  have h0 := hn 0
  have h1 := hn 1
  have hj := hn j
  simp only [realProgressionCoordinate, Fin.val_zero, Nat.cast_zero, zero_mul, add_zero,
    Fin.val_one, Nat.cast_one, one_mul] at h0 h1 hj
  have hj0 : (0 : ℝ) ≤ (j : ℕ) := Nat.cast_nonneg _
  have hj3 : ((j : ℕ) : ℝ) ≤ 3 := by exact_mod_cast Nat.le_of_lt_succ j.isLt
  -- the defect `d = (1-j) n₀ + j n₁ - n_j` is an integer of size `< 1`
  set d : ℤ := latticeCoord j (n 0, n 1) - n j
  have hd : δ * (d : ℝ) = (1 - (j : ℕ)) * (δ * n 0 - z.1) + (j : ℕ) * (δ * n 1 - (z.1 + z.2)) -
      (δ * n j - (z.1 + (j : ℕ) * z.2)) := by
    simp only [d, latticeCoord]; push_cast; ring
  rw [abs_lt] at h0 h1 hj
  have hb : |δ * (d : ℝ)| < δ := by
    rw [hd, abs_lt]
    rcases le_or_gt ((j : ℕ) : ℝ) 1 with hle | hlt
    · constructor <;> nlinarith
    · constructor <;> nlinarith
  rw [abs_mul, abs_of_pos hδ] at hb
  have hd1 : |(d : ℝ)| < 1 := by nlinarith
  have : d = 0 := by
    have : |d| < 1 := by exact_mod_cast hd1
    have := abs_lt.mp this
    omega
  simp only [d, sub_eq_zero] at this
  exact this.symm

/-! ### Mixed Hölder and the block factor (lem:shortblock, blueprint lines 2357-2369) -/

/-- The progression coordinate on the fast factor pushes `P ⊗ Haar(T₀²)` to `P ⊗ Haar(T₀)`. -/
theorem lintegral_fastCoord_prod {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [SFinite P]
    (j : ℤ) {g : Ω × FastCircle → ℝ≥0∞} (hg : Measurable g) :
    ∫⁻ q, g (q.1, fastCoord j q.2) ∂(P.prod (fastHaar.prod fastHaar)) =
      ∫⁻ z, g z ∂(P.prod fastHaar) := by
  have hm : Measurable fun q : Ω × (FastCircle × FastCircle) => g (q.1, fastCoord j q.2) :=
    hg.comp (measurable_fst.prodMk ((continuous_fastCoord j).measurable.comp measurable_snd))
  rw [lintegral_prod _ hm.aemeasurable, lintegral_prod _ hg.aemeasurable]
  refine lintegral_congr fun ω => ?_
  exact lintegral_fastCoord j (hg.comp measurable_prodMk_left)

/-! ### Fourier partial sums of the fast windows (limiting route of lem:shortblock) -/

/-- The symmetric Fourier partial sums of an `L²` function on the fast circle converge to it in
`L²` (Mathlib `hasSum_fourier_series_L2`). -/
theorem fast_partial_sums_tendsto (f : Lp ℂ 2 fastHaar) :
    Filter.Tendsto (fun N : ℕ => ∑ m ∈ Finset.Icc (-(N : ℤ)) N,
      fourierCoeff f m • fourierLp (T := 16) 2 m) Filter.atTop (nhds f) :=
  (hasSum_fourier_series_L2 f).comp Finset.tendsto_Icc_neg

/-- Bessel's inequality for finite sets of frequencies: `Σ_{m ∈ s} |f̂(m)|² ≤ ‖f‖₂²`. -/
theorem fast_bessel (f : Lp ℂ 2 fastHaar) (s : Finset ℤ) :
    ∑ m ∈ s, ‖fourierCoeff f m‖ ^ 2 ≤ ∫ t, ‖f t‖ ^ 2 ∂fastHaar :=
  sum_le_hasSum s (fun _ _ => by positivity) (hasSum_sq_fourierCoeff f)

/-! ### The fast lift (lem:shortblock, blueprint lines 2302-2306) -/

/-- Left endpoints of the fast lift intervals: `[0, 1)` in slots `0, 1` and `[-4, 4)` in slots
`2, 3` (blueprint line 2303: "restricted to `[0,1)` in slots `0,1` and to fixed lift intervals in
`[-4,4]` containing all needed `w_j` in slots `2,3`"). -/
noncomputable def fastLiftLeft (j : Fin 4) : ℝ := if (j : ℕ) < 2 then 0 else -4

/-- Lengths of the fast lift intervals. -/
noncomputable def fastLiftLen (j : Fin 4) : ℝ := if (j : ℕ) < 2 then 1 else 8

/-- The representative of a fast point in `[ℓ_j, ℓ_j + 16)`. -/
noncomputable def fastRep (j : Fin 4) (t : FastCircle) : ℝ :=
  (AddCircle.equivIco 16 (fastLiftLeft j) t : ℝ)

theorem measurable_fastRep (j : Fin 4) : Measurable (fastRep j) :=
  measurable_subtype_coe.comp (AddCircle.measurableEquivIco 16 (fastLiftLeft j)).measurable

theorem fastRep_coe {j : Fin 4} {x : ℝ} (hx : x ∈ Set.Ico (fastLiftLeft j) (fastLiftLeft j + 16)) :
    fastRep j (x : FastCircle) = x := by
  unfold fastRep
  rw [AddCircle.equivIco_coe_eq hx]

/-- The lift of a function on the lift interval of slot `j` to the fast circle, zero elsewhere. -/
noncomputable def fastLift (j : Fin 4) (φ : ℝ → ℂ) (t : FastCircle) : ℂ :=
  if fastRep j t < fastLiftLeft j + fastLiftLen j then φ (fastRep j t) else 0

theorem measurable_fastLift (j : Fin 4) {φ : ℝ → ℂ} (hφ : Measurable φ) :
    Measurable (fastLift j φ) :=
  Measurable.ite (measurableSet_lt (measurable_fastRep j) measurable_const)
    (hφ.comp (measurable_fastRep j)) measurable_const

/-- Normalized Haar measure on `T₀²` is `1/256` times Lebesgue measure on `[0, 16)²`. -/
theorem integral_fastHaar_prod {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (h : FastCircle × FastCircle → E) (hh : AEStronglyMeasurable h (fastHaar.prod fastHaar)) :
    ∫ x, h x ∂(fastHaar.prod fastHaar) =
      (1 / 256 : ℝ) • ∫ x in Set.Ico (0 : ℝ) 16 ×ˢ Set.Ico (0 : ℝ) 16,
        h ((x.1 : FastCircle), (x.2 : FastCircle)) := by
  have hv : (volume : Measure FastCircle) = ENNReal.ofReal 16 • fastHaar :=
    AddCircle.volume_eq_smul_haarAddCircle
  have hH' : (volume : Measure FastCircle).prod (volume : Measure FastCircle) =
      (256 : ℝ≥0∞) • fastHaar.prod fastHaar := by
    rw [hv, Measure.prod_smul_left, Measure.prod_smul_right, smul_smul, ENNReal.ofReal_ofNat]
    norm_num
  have hH : fastHaar.prod fastHaar = (1 / 256 : ℝ≥0∞) •
      ((volume : Measure FastCircle).prod (volume : Measure FastCircle)) := by
    rw [hH', smul_smul, one_div, ENNReal.inv_mul_cancel (by norm_num) (by norm_num), one_smul]
  have hmp := (AddCircle.measurePreserving_mk (16 : ℝ) 0).prod
    (AddCircle.measurePreserving_mk (16 : ℝ) 0)
  rw [zero_add, Measure.restrict_congr_set (Ioc_ae_eq_Icc.trans Ico_ae_eq_Icc.symm),
    Measure.prod_restrict, ← Measure.volume_eq_prod] at hmp
  rw [hH, integral_smul_measure, ← hmp.map_eq,
    integral_map hmp.measurable.aemeasurable (by rw [hmp.map_eq, hH']; exact hh.smul_measure _)]
  congr 1
  norm_num

theorem fastLift_coe {j : Fin 4} (φ : ℝ → ℂ) {y : ℝ}
    (hy : y ∈ Set.Ico (fastLiftLeft j) (fastLiftLeft j + 16)) :
    fastLift j φ (y : FastCircle) = if y < fastLiftLeft j + fastLiftLen j then φ y else 0 := by
  unfold fastLift; rw [fastRep_coe hy]

theorem fastCoord_coe (j : ℤ) (a b : ℝ) :
    fastCoord j ((a : FastCircle), (b : FastCircle)) =
      (((1 - (j : ℝ)) * a + j * b : ℝ) : FastCircle) := by
  change (1 - j) • (a : FastCircle) + j • (b : FastCircle) = _
  rw [← QuotientAddGroup.mk_zsmul, ← QuotientAddGroup.mk_zsmul, ← QuotientAddGroup.mk_add]
  congr 1
  simp [zsmul_eq_mul]

/-- Blueprint lines 2302-2306 ("with fixed Haar constants the fast progression integral
reproduces the original integral without wraparound"): lifting the slot functions to `T₀` on
the lift intervals, the fast progression integral over `T₀²` is `1/256` times the integral over
the unit cell `[0, 1)²`. -/
theorem fast_lift_form (φ : Fin 4 → ℝ → ℂ) (hφ : ∀ j, Measurable (φ j)) :
    ∫ x, ∏ j : Fin 4, fastLift j (φ j) (fastCoord j x) ∂(fastHaar.prod fastHaar) =
      (1 / 256 : ℝ) • ∫ u in Set.Ico (0 : ℝ) 1 ×ˢ Set.Ico (0 : ℝ) 1,
        ∏ j : Fin 4, φ j ((1 - (j : ℝ)) * u.1 + j * u.2) := by
  have hm : Measurable fun x : FastCircle × FastCircle =>
      ∏ j : Fin 4, fastLift j (φ j) (fastCoord j x) :=
    Finset.measurable_prod _ fun j _ =>
      (measurable_fastLift j (hφ j)).comp (continuous_fastCoord _).measurable
  rw [integral_fastHaar_prod _ hm.aestronglyMeasurable]
  congr 1
  have hpt : ∀ x ∈ Set.Ico (0 : ℝ) 16 ×ˢ Set.Ico (0 : ℝ) 16,
      ∏ j : Fin 4, fastLift j (φ j) (fastCoord j ((x.1 : FastCircle), (x.2 : FastCircle))) =
        (Set.Ico (0 : ℝ) 1 ×ˢ Set.Ico (0 : ℝ) 1).indicator
          (fun u => ∏ j : Fin 4, φ j ((1 - (j : ℝ)) * u.1 + j * u.2)) x := by
    rintro ⟨a, b⟩ ⟨⟨ha0, ha16⟩, ⟨hb0, hb16⟩⟩
    have hc : ∀ j : Fin 4, fastLift j (φ j) (fastCoord j ((a : FastCircle), (b : FastCircle))) =
        fastLift j (φ j) (((1 - (j : ℝ)) * a + j * b : ℝ) : FastCircle) := by
      intro j; rw [fastCoord_coe]; push_cast; rfl
    simp only [hc]
    by_cases hab : a < 1 ∧ b < 1
    · rw [Set.indicator_of_mem (by exact ⟨⟨ha0, hab.1⟩, ⟨hb0, hab.2⟩⟩)]
      refine Finset.prod_congr rfl fun j _ => ?_
      obtain ⟨ha1, hb1⟩ := hab
      fin_cases j <;>
      · rw [fastLift_coe _ (by simp [fastLiftLeft]; norm_num; constructor <;> linarith),
          ite_eq_left (by simp [fastLiftLeft, fastLiftLen]; norm_num; linarith)]
    · rw [Set.indicator_of_notMem (by
        rintro ⟨⟨-, h1'⟩, ⟨-, h2'⟩⟩; exact hab ⟨h1', h2'⟩)]
      rcases not_and_or.mp hab with h | h
      · refine Finset.prod_eq_zero (Finset.mem_univ 0) ?_
        rw [fastLift_coe _ (by simp [fastLiftLeft]; constructor <;> linarith),
          ite_eq_right (by simp [fastLiftLeft, fastLiftLen]; linarith)]
      · refine Finset.prod_eq_zero (Finset.mem_univ 1) ?_
        rw [fastLift_coe _ (by simp [fastLiftLeft]; constructor <;> linarith),
          ite_eq_right (by simp [fastLiftLeft, fastLiftLen]; linarith)]
  rw [setIntegral_congr_fun (measurableSet_Ico.prod measurableSet_Ico) hpt,
    integral_indicator (measurableSet_Ico.prod measurableSet_Ico), Measure.restrict_restrict
      (measurableSet_Ico.prod measurableSet_Ico)]
  congr 2
  ext ⟨a, b⟩
  simp only [Set.mem_inter_iff, Set.mem_prod, Set.mem_Ico]
  constructor
  · rintro ⟨⟨⟨h1, h2⟩, h3, h4⟩, -⟩; exact ⟨⟨h1, h2⟩, h3, h4⟩
  · rintro ⟨⟨h1, h2⟩, h3, h4⟩
    exact ⟨⟨⟨h1, h2⟩, h3, h4⟩, ⟨h1, by linarith⟩, h3, by linarith⟩

/-- The all-`L²` case of `eq:absolute` on `T₀²` for one slow tuple: pairing the slots `(0, 1)` and
`(2, 3)` and using independence of two coordinates, `∫∫ Π_j h_j(w_j) ≤ Π_j ‖h_j‖₂`. -/
theorem fast_form_L2_le (h : Fin 4 → FastCircle → ℝ≥0∞) (hh : ∀ j, Measurable (h j)) :
    ∫⁻ x, ∏ j : Fin 4, h j (fastCoord j x) ∂(fastHaar.prod fastHaar) ≤
      ∏ j : Fin 4, (∫⁻ t, h j t ^ (2 : ℝ) ∂fastHaar) ^ (1 / 2 : ℝ) := by
  have hc : ∀ j : Fin 4, Measurable fun x : FastCircle × FastCircle => h j (fastCoord j x) :=
    fun j => (hh j).comp (continuous_fastCoord _).measurable
  have hA := (hc 0).mul (hc 1)
  have hB := (hc 2).mul (hc 3)
  have H := ENNReal.lintegral_mul_le_Lp_mul_Lq (fastHaar.prod fastHaar)
    Real.HolderConjugate.two_two hA.aemeasurable hB.aemeasurable
  have hpair : ∀ i j : Fin 4, i ≠ j →
      ∫⁻ x, (h i (fastCoord i x) * h j (fastCoord j x)) ^ (2 : ℝ) ∂(fastHaar.prod fastHaar) =
        (∫⁻ t, h i t ^ (2 : ℝ) ∂fastHaar) * ∫⁻ t, h j t ^ (2 : ℝ) ∂fastHaar := by
    intro i j hij
    simp_rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 2)]
    exact lintegral_fastPair (by exact_mod_cast fun e => hij (Fin.ext (by exact_mod_cast e)))
      ((hh i).pow_const _) ((hh j).pow_const _)
  simp only [Pi.mul_apply] at H
  rw [hpair 0 1 (by decide), hpair 2 3 (by decide),
    ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)] at H
  refine le_trans (le_of_eq ?_) (H.trans (le_of_eq ?_))
  · congr 1; funext x; rw [Fin.prod_univ_four, mul_assoc]
  · rw [Fin.prod_univ_four]; ring

theorem enorm_prod_four (f : Fin 4 → ℂ) : ‖∏ j, f j‖ₑ = ∏ j, ‖f j‖ₑ := by
  simp [Fin.prod_univ_four]

theorem eLpNorm_two_eq {g : FastCircle → ℂ} (hg : AEStronglyMeasurable g fastHaar) :
    eLpNorm g 2 fastHaar = (∫⁻ t, ‖g t‖ₑ ^ (2 : ℝ) ∂fastHaar) ^ (1 / 2 : ℝ) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num) hg]
  norm_num

/-- `∫∫ Π_j |g_j(w_j)| ≤ Π_j ‖g_j‖₂` for complex slot functions. -/
theorem lintegral_fast_form_le (g : Fin 4 → FastCircle → ℂ) (hg : ∀ j, Measurable (g j)) :
    ∫⁻ x, ∏ j : Fin 4, ‖g j (fastCoord j x)‖ₑ ∂(fastHaar.prod fastHaar) ≤
      ∏ j : Fin 4, eLpNorm (g j) 2 fastHaar := by
  simp_rw [fun j => eLpNorm_two_eq (hg j).aestronglyMeasurable]
  exact fast_form_L2_le (fun j t => ‖g j t‖ₑ) fun j => (hg j).enorm

theorem fast_form_integrable (g : Fin 4 → FastCircle → ℂ) (hg : ∀ j, Measurable (g j))
    (hL : ∀ j, MemLp (g j) 2 fastHaar) :
    Integrable (fun x => ∏ j : Fin 4, g j (fastCoord j x)) (fastHaar.prod fastHaar) := by
  refine ⟨(Finset.measurable_prod _ fun j _ =>
    (hg j).comp (continuous_fastCoord _).measurable).aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_enorm]
  simp_rw [enorm_prod_four]
  exact (lintegral_fast_form_le g hg).trans_lt
    (ENNReal.prod_lt_top fun j _ => (hL j).eLpNorm_lt_top)

theorem norm_fast_form_le (g : Fin 4 → FastCircle → ℂ) (hg : ∀ j, Measurable (g j))
    (hL : ∀ j, MemLp (g j) 2 fastHaar) :
    ‖∫ x, ∏ j : Fin 4, g j (fastCoord j x) ∂(fastHaar.prod fastHaar)‖ ≤
      ∏ j : Fin 4, (eLpNorm (g j) 2 fastHaar).toReal := by
  have h1 := enorm_integral_le_lintegral_enorm (μ := fastHaar.prod fastHaar)
    (fun x => ∏ j : Fin 4, g j (fastCoord j x))
  simp_rw [enorm_prod_four] at h1
  have h2 := h1.trans (lintegral_fast_form_le g hg)
  have hfin : ∏ j : Fin 4, eLpNorm (g j) 2 fastHaar ≠ ⊤ :=
    (ENNReal.prod_lt_top fun j _ => (hL j).eLpNorm_lt_top).ne
  rw [← ENNReal.toReal_prod]
  have := ENNReal.toReal_mono hfin h2
  rwa [toReal_enorm] at this

theorem fast_prod_four (f : Fin 4 → FastCircle → ℂ) (x : FastCircle × FastCircle) :
    ∏ j : Fin 4, f j (fastCoord j x) =
      f 0 (fastCoord 0 x) * f 1 (fastCoord 1 x) * f 2 (fastCoord 2 x) * f 3 (fastCoord 3 x) := by
  rw [Fin.prod_univ_four]; rfl

theorem fast_form_integrable4 {g0 g1 g2 g3 : FastCircle → ℂ} (m0 : Measurable g0)
    (m1 : Measurable g1) (m2 : Measurable g2) (m3 : Measurable g3) (l0 : MemLp g0 2 fastHaar)
    (l1 : MemLp g1 2 fastHaar) (l2 : MemLp g2 2 fastHaar) (l3 : MemLp g3 2 fastHaar) :
    Integrable (fun x => g0 (fastCoord 0 x) * g1 (fastCoord 1 x) * g2 (fastCoord 2 x) *
      g3 (fastCoord 3 x)) (fastHaar.prod fastHaar) := by
  have := fast_form_integrable ![g0, g1, g2, g3] (fun j => by fin_cases j <;> assumption)
    (fun j => by fin_cases j <;> assumption)
  simp_rw [fast_prod_four] at this
  exact this

theorem norm_fast_form_le4 {g0 g1 g2 g3 : FastCircle → ℂ} (m0 : Measurable g0)
    (m1 : Measurable g1) (m2 : Measurable g2) (m3 : Measurable g3) (l0 : MemLp g0 2 fastHaar)
    (l1 : MemLp g1 2 fastHaar) (l2 : MemLp g2 2 fastHaar) (l3 : MemLp g3 2 fastHaar) :
    ‖∫ x, g0 (fastCoord 0 x) * g1 (fastCoord 1 x) * g2 (fastCoord 2 x) * g3 (fastCoord 3 x)
      ∂(fastHaar.prod fastHaar)‖ ≤ (eLpNorm g0 2 fastHaar).toReal *
        (eLpNorm g1 2 fastHaar).toReal * (eLpNorm g2 2 fastHaar).toReal *
          (eLpNorm g3 2 fastHaar).toReal := by
  have := norm_fast_form_le ![g0, g1, g2, g3] (fun j => by fin_cases j <;> assumption)
    (fun j => by fin_cases j <;> assumption)
  simp_rw [fast_prod_four, Fin.prod_univ_four] at this
  exact this

/-! ### The sampled form as a lattice sum of fast forms (lem:shortblock, lines 2298-2307) -/

/-- The fast slot functions `F_j(m, w) = f_j(δ(m + w))` on the lift interval of slot `j`
(blueprint line 2303). -/
noncomputable def slotLift (δ : ℝ) (f : Fin 4 → ℝ → ℂ) (j : Fin 4) (m : ℤ) :
    FastCircle → ℂ :=
  fastLift j (fun x => f j (δ * (m + x)))

/-- The fast progression form of one slow pair `n = (n₀, n₁)`:
`∫∫_{T₀²} Π_j F_j(n_j, w_j)` with `n_j = (1-j) n₀ + j n₁`, `w_j = (1-j) u + j v`. -/
noncomputable def fastFormAt (F : Fin 4 → ℤ → FastCircle → ℂ) (n : ℤ × ℤ) : ℂ :=
  ∫ x, ∏ j : Fin 4, F j (latticeCoord j n) (fastCoord j x) ∂(fastHaar.prod fastHaar)

theorem measurable_slotLift {δ : ℝ} {f : Fin 4 → ℝ → ℂ} (hf : ∀ j, Measurable (f j))
    (j : Fin 4) (m : ℤ) : Measurable (slotLift δ f j m) :=
  measurable_fastLift j ((hf j).comp (measurable_const.mul (measurable_const.add measurable_id)))

/-- The unit-cell integral of the progression inputs is `256` times the fast form. -/
theorem unit_cell_eq_fastFormAt {δ : ℝ} {f : Fin 4 → ℝ → ℂ} (hf : ∀ j, Measurable (f j))
    (n : ℤ × ℤ) :
    ∫ u in Set.Ico (0 : ℝ) 1 ×ˢ Set.Ico (0 : ℝ) 1, ∏ j : Fin 4,
        f j (δ * (((1 - (j : ℝ)) * n.1 + j * n.2) + ((1 - (j : ℝ)) * u.1 + j * u.2))) =
      256 * fastFormAt (slotLift δ f) n := by
  have h := fast_lift_form (fun j x => f j (δ * ((latticeCoord j n : ℤ) + x)))
    (fun j => (hf j).comp (measurable_const.mul (measurable_const.add measurable_id)))
  unfold fastFormAt slotLift
  rw [h, Complex.real_smul, ← mul_assoc]
  norm_num
  refine setIntegral_congr_fun (measurableSet_Ico.prod measurableSet_Ico) fun u _ => ?_
  refine Finset.prod_congr rfl fun j _ => ?_
  congr 2
  simp only [latticeCoord]
  push_cast
  ring

/-- The lattice-sampled kernel of a kernel with local progression support on `[a, a + r]` has
local progression support on `[a - 5δ, a + r + 5δ]`. -/
theorem latticeSampled_support {w : ℝ × ℝ → ℂ} {a r δ : ℝ} (hδ : 0 < δ)
    (hw : HasLocalProgressionSupport a r w) :
    HasLocalProgressionSupport (a - 5 * δ) (r + 10 * δ) (latticeSampledKernel δ w) := by
  intro z hz j
  have h := hw _ hz
  obtain ⟨o1, o2, o3, o4⟩ := latticeSampled_offsets hδ z
  have h0 := h 0
  have h1 := h 1
  have hj := h j
  simp only [realProgressionCoordinate, Fin.val_zero, Nat.cast_zero, zero_mul, add_zero,
    Fin.val_one, Nat.cast_one, one_mul, Set.mem_Icc] at h0 h1 hj ⊢
  have hj0 : (0 : ℝ) ≤ (j : ℕ) := Nat.cast_nonneg _
  have hj3 : ((j : ℕ) : ℝ) ≤ 3 := by exact_mod_cast Nat.le_of_lt_succ j.isLt
  -- the coordinate is an affine combination of the first two, each within `δ`
  have e : z.1 + (j : ℕ) * z.2 = (1 - (j : ℕ)) * z.1 + (j : ℕ) * (z.1 + z.2) := by ring
  set s0 := δ * (⌊z.1 / δ⌋ : ℝ)
  set s1 := δ * (⌊(z.1 + z.2) / δ⌋ : ℝ)
  have e' : s0 + (j : ℕ) * (s1 - s0) = (1 - (j : ℕ)) * s0 + (j : ℕ) * s1 := by ring
  rw [e'] at hj
  rw [e]
  constructor <;> rcases le_or_gt ((j : ℕ) : ℝ) 1 with hle | hlt <;> nlinarith

theorem measurable_latticeSampledKernel {w : ℝ × ℝ → ℂ} (hw : Measurable w) (δ : ℝ) :
    Measurable (latticeSampledKernel δ w) := by
  unfold latticeSampledKernel
  have hfl : ∀ {g : ℝ × ℝ → ℝ}, Measurable g → Measurable fun z => ((⌊g z⌋ : ℤ) : ℝ) :=
    fun hg => measurable_from_top.comp (Int.measurable_floor.comp hg)
  have h0 := hfl (measurable_fst.div_const δ)
  have h1 := hfl ((measurable_fst.add measurable_snd).div_const δ)
  exact hw.comp ((measurable_const.mul h0).prodMk
    ((measurable_const.mul h1).sub (measurable_const.mul h0)))

theorem eLpNorm_normalized_lt_top {f : ℝ → ℂ} (hf : MemLp f 2 volume) (a r : ℝ) :
    eLpNorm f 2 (normalizedIntervalMeasure a r) < ⊤ := by
  unfold normalizedIntervalMeasure
  rw [eLpNorm_smul_measure_of_ne_top (by norm_num) _ _ (hf.aestronglyMeasurable.restrict),
    smul_eq_mul]
  refine ENNReal.mul_lt_top (ENNReal.rpow_lt_top_of_nonneg (by positivity) ENNReal.ofReal_ne_top)
    ((eLpNorm_mono_measure f Measure.restrict_le_self).trans_lt hf.eLpNorm_lt_top)

/-- A bounded measurable kernel with local progression support against four `L²` inputs gives an
integrable progression integrand (all-`L²` case of `eq:absolute`). -/
theorem progression_integrable {w : ℝ × ℝ → ℂ} {a r W : ℝ} (hr : 0 < r)
    (hw : HasLocalProgressionSupport a r w) (hwm : Measurable w) (hW : ∀ z, ‖w z‖ ≤ W)
    (f : Fin 4 → ℝ → ℂ) (hf : ∀ j, Measurable (f j)) (hL : ∀ j, MemLp (f j) 2 volume) :
    Integrable fun z : ℝ × ℝ => w z * ∏ j, f j (realProgressionCoordinate j z) := by
  have hm : Measurable fun z : ℝ × ℝ => w z * ∏ j, f j (realProgressionCoordinate j z) :=
    hwm.mul (Finset.measurable_prod _ fun j _ =>
      (hf j).comp (continuous_realProgressionCoordinate j).measurable)
  refine ⟨hm.aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_enorm]
  have hb := localProgression_absoluteNormBound hr w hwm hw (W := ENNReal.ofReal W)
    (fun z => by rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hW z)) f hf
    (fun _ => 2) (fun _ => by norm_num) (by norm_num)
  have hR : ENNReal.ofReal r⁻¹ ^ 2 ≠ 0 := by
    have : 0 < r⁻¹ := inv_pos.mpr hr
    positivity
  have hfin : (2 * ENNReal.ofReal W) * ∏ i, eLpNorm (f i) 2 (normalizedIntervalMeasure a r) <
      ⊤ := ENNReal.mul_lt_top (by finiteness)
    (ENNReal.prod_lt_top fun j _ => eLpNorm_normalized_lt_top (hL j) a r)
  have h2 : ∫⁻ z : ℝ × ℝ, ‖w z‖ₑ * ∏ i, ‖f i (realProgressionCoordinate i z)‖ₑ < ⊤ := by
    by_contra hc
    rw [not_lt, top_le_iff] at hc
    rw [hc, ENNReal.mul_top hR] at hb
    exact absurd (hb.trans_lt hfin) (lt_irrefl _)
  refine lt_of_le_of_lt (le_of_eq (lintegral_congr fun z => ?_)) h2
  rw [enorm_mul, enorm_prod_four]

/-- Blueprint lines 2302-2307: the form with the lattice-sampled kernel is
`r⁻² δ² 256 Σ_n w(δ n₀, δ(n₁ - n₀)) Φ_n(F)`, the sum over the finitely many slow pairs where
the sampled kernel is nonzero, with `Φ_n` the fast form of the lifted inputs. -/
theorem sampled_form_eq_fast {w : ℝ × ℝ → ℂ} {a r δ W : ℝ} (hr : 0 < r) (hδ : 0 < δ)
    (hw : HasLocalProgressionSupport a r w) (hwm : Measurable w) (hW : ∀ z, ‖w z‖ ≤ W)
    (f : Fin 4 → ℝ → ℂ) (hf : ∀ j, Measurable (f j)) (hL : ∀ j, MemLp (f j) 2 volume)
    (B : Finset (ℤ × ℤ)) (hB : ∀ n : ℤ × ℤ, w (δ * n.1, δ * n.2 - δ * n.1) ≠ 0 → n ∈ B) :
    localProgressionForm r (latticeSampledKernel δ w) f =
      (r : ℂ)⁻¹ ^ 2 * ((δ ^ 2 : ℝ) : ℂ) * 256 *
        ∑ n ∈ B, w (δ * n.1, δ * n.2 - δ * n.1) * fastFormAt (slotLift δ f) n := by
  have hF := progression_integrable (by linarith : 0 < r + 10 * δ) (latticeSampled_support hδ hw)
    (measurable_latticeSampledKernel hwm δ) (W := W) (fun z => hW _) f hf hL
  unfold localProgressionForm
  rw [latticeSampled_form_lift hδ f hF, tsum_eq_sum (s := B) fun n hn => by
    rw [show w (δ * n.1, δ * n.2 - δ * n.1) = 0 from by_contra fun h => hn (hB n h), zero_mul]]
  simp_rw [unit_cell_eq_fastFormAt hf]
  rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun n _ => ?_
  ring

/-! ### Window masses of the fast slots (lem:shortblock, blueprint lines 2328-2331) -/

theorem fastLiftLen_le (j : Fin 4) : fastLiftLen j ≤ 8 := by
  unfold fastLiftLen; split_ifs <;> norm_num

theorem fastLiftLen_pos (j : Fin 4) : 0 < fastLiftLen j := by
  unfold fastLiftLen; split_ifs <;> norm_num

theorem fastLiftLeft_bounds (j : Fin 4) : -4 ≤ fastLiftLeft j ∧ fastLiftLeft j ≤ 0 := by
  unfold fastLiftLeft; split_ifs <;> norm_num

/-- The fast lift lengths are natural numbers (`1` or `8`). -/
noncomputable def fastLiftLenNat (j : Fin 4) : ℕ := if (j : ℕ) < 2 then 1 else 8

theorem fastLiftLenNat_cast (j : Fin 4) : (fastLiftLenNat j : ℝ) = fastLiftLen j := by
  unfold fastLiftLenNat fastLiftLen; split_ifs <;> norm_num

/-- Haar integrals of lifted functions: `∫_{T₀} φTilde = (1/16) ∫_{[ℓ_j, ℓ_j + L_j)} φ`. -/
theorem lintegral_fastLift_enorm (j : Fin 4) (φ : ℝ → ℂ) (hφ : Measurable φ) (p : ℝ)
    (hp : 0 < p) :
    ∫⁻ t, ‖fastLift j φ t‖ₑ ^ p ∂fastHaar =
      (1 / 16 : ℝ≥0∞) * ∫⁻ x in Set.Ico (fastLiftLeft j) (fastLiftLeft j + fastLiftLen j),
        ‖φ x‖ₑ ^ p := by
  have hv : (volume : Measure FastCircle) = ENNReal.ofReal 16 • fastHaar :=
    AddCircle.volume_eq_smul_haarAddCircle
  have hm : Measurable fun t => ‖fastLift j φ t‖ₑ ^ p :=
    (measurable_fastLift j hφ).enorm.pow_const _
  have hpre := AddCircle.lintegral_preimage (16 : ℝ) (fastLiftLeft j)
    (fun t => ‖fastLift j φ t‖ₑ ^ p)
  rw [hv, lintegral_smul_measure, ENNReal.ofReal_ofNat, smul_eq_mul] at hpre
  have h16 : ∫⁻ t, ‖fastLift j φ t‖ₑ ^ p ∂fastHaar =
      (1 / 16 : ℝ≥0∞) * ∫⁻ a in Set.Ioc (fastLiftLeft j) (fastLiftLeft j + 16),
        ‖fastLift j φ (a : FastCircle)‖ₑ ^ p := by
    rw [hpre, ← mul_assoc, one_div, ENNReal.inv_mul_cancel (by norm_num) (by norm_num), one_mul]
  rw [h16]
  congr 1
  rw [Measure.restrict_congr_set (Ioc_ae_eq_Icc.trans Ico_ae_eq_Icc.symm)]
  have hL := fastLiftLen_le j
  have hL0 := fastLiftLen_pos j
  rw [← lintegral_indicator measurableSet_Ico, ← lintegral_indicator measurableSet_Ico]
  refine lintegral_congr fun x => ?_
  by_cases hx : x ∈ Set.Ico (fastLiftLeft j) (fastLiftLeft j + 16)
  · rw [Set.indicator_of_mem hx, fastLift_coe φ hx]
    by_cases hxL : x < fastLiftLeft j + fastLiftLen j
    · rw [ite_eq_left hxL, Set.indicator_of_mem (Set.mem_Ico.mpr ⟨hx.1, hxL⟩)]
    · rw [ite_eq_right hxL, Set.indicator_of_notMem (fun h => hxL (Set.mem_Ico.mp h).2), enorm_zero,
        ENNReal.zero_rpow_of_pos hp]
  · have hx' : x ∉ Set.Ico (fastLiftLeft j) (fastLiftLeft j + fastLiftLen j) := fun h =>
      hx (Set.mem_Ico.mpr ⟨(Set.mem_Ico.mp h).1, by linarith [(Set.mem_Ico.mp h).2]⟩)
    rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx']

/-- The squared fast mass of a slot window: `∫_{T₀} |F_j(m, ·)|^p = (16 δ)⁻¹ ∫_{window} |f_j|^p`,
the window being `[δ(m + ℓ_j), δ(m + ℓ_j + L_j))`. -/
theorem lintegral_slotLift (δ : ℝ) (hδ : 0 < δ) (f : Fin 4 → ℝ → ℂ) (hf : ∀ j, Measurable (f j))
    (j : Fin 4) (m : ℤ) (p : ℝ) (hp : 0 < p) :
    ∫⁻ t, ‖slotLift δ f j m t‖ₑ ^ p ∂fastHaar =
      (ENNReal.ofReal (16 * δ))⁻¹ * ∫⁻ y in Set.Ico (δ * (m + fastLiftLeft j))
        (δ * (m + fastLiftLeft j + fastLiftLen j)), ‖f j y‖ₑ ^ p := by
  unfold slotLift
  rw [lintegral_fastLift_enorm j (fun x => f j (δ * (m + x))) ((hf j).comp (measurable_const.mul
    (measurable_const.add measurable_id))) p hp]
  -- substitute `y = δ (m + x)`
  set φ : ℝ → ℝ := fun x => δ * (m + x)
  have hφ : Measurable φ := measurable_const.mul (measurable_const.add measurable_id)
  have hmap : Measure.map φ volume = ENNReal.ofReal δ⁻¹ • volume := by
    have e : φ = (fun y => δ * y) ∘ (fun x => x + (m : ℝ)) := by
      funext x; simp only [φ, Function.comp_apply]; ring
    rw [e, ← Measure.map_map (measurable_const_mul δ) (measurable_add_const _),
      map_add_right_eq_self, Real.map_volume_mul_left hδ.ne',
      abs_of_pos (inv_pos.mpr hδ)]
  set T := Set.Ico (δ * (m + fastLiftLeft j)) (δ * (m + fastLiftLeft j + fastLiftLen j))
  have hg : Measurable fun y => ‖f j y‖ₑ ^ p := (hf j).enorm.pow_const _
  have hind : (Set.Ico (fastLiftLeft j) (fastLiftLeft j + fastLiftLen j)).indicator
      (fun x => ‖f j (δ * (m + x))‖ₑ ^ p) = fun x => T.indicator (fun y => ‖f j y‖ₑ ^ p) (φ x) := by
    funext x
    have hiff : x ∈ Set.Ico (fastLiftLeft j) (fastLiftLeft j + fastLiftLen j) ↔ φ x ∈ T := by
      simp only [Set.mem_Ico, T, φ]
      constructor
      · rintro ⟨h1, h2⟩; constructor <;> nlinarith
      · rintro ⟨h1, h2⟩
        constructor
        · by_contra h; push Not at h; nlinarith
        · by_contra h; push Not at h; nlinarith
    by_cases hx : x ∈ Set.Ico (fastLiftLeft j) (fastLiftLeft j + fastLiftLen j)
    · rw [Set.indicator_of_mem hx, Set.indicator_of_mem (hiff.mp hx)]
    · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem (fun h => hx (hiff.mpr h))]
  rw [← lintegral_indicator measurableSet_Ico, hind,
    ← lintegral_map (hg.indicator measurableSet_Ico) hφ, hmap, lintegral_smul_measure,
    lintegral_indicator measurableSet_Ico, smul_eq_mul, ← mul_assoc]
  congr 1
  rw [ENNReal.ofReal_mul (by norm_num), ENNReal.mul_inv (Or.inl (by norm_num))
    (Or.inl ENNReal.ofReal_ne_top), ENNReal.ofReal_inv_of_pos hδ, ENNReal.ofReal_ofNat, one_div]

/-! ### The comparison at one leaf-depth rectangle (lem:shortblock, lines 2298-2369) -/

/-- The data of the comparison at one leaf-depth rectangle of `lem:shortblock`, after
normalization: finitely many summation cells with admissible kernels, the sampling scale `δ`,
random inputs `z^σ` with deterministic sizes `Z_j`, the inputs supported in `[lo, hi]`. -/
structure BlockData (κ : LocalKernelClass) (Ω : Type*) [MeasurableSpace Ω] where
  grid : RealDyadicGrid
  cells : Finset (ℤ × ℤ)
  kernel : ℤ × ℤ → ℝ × ℝ → ℂ
  admissible : ∀ I ∈ cells, IsAdmissibleLocalKernel κ (dyadicGridLeft grid I.1 I.2)
    (dyadicGridLength grid I.1) (kernel I)
  δ : ℝ
  δ_pos : 0 < δ
  δ_small : ∀ I ∈ cells, 8 * δ ≤ κ.margin * dyadicGridLength grid I.1
  δ_le_len : ∀ I ∈ cells, 8 * δ ≤ dyadicGridLength grid I.1
  z : Fin 4 → Ω → ℝ → ℂ
  z_meas : ∀ j, Measurable (Function.uncurry (z j))
  Z : Fin 4 → ℝ → ℝ
  Z_meas : ∀ j, Measurable (Z j)
  Z_nonneg : ∀ j y, 0 ≤ Z j y
  lo : ℝ
  hi : ℝ
  z_supp : ∀ j σ y, y ∉ Set.Icc lo hi → z j σ y = 0

namespace BlockData
variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

/-- The length `r_I` of a cell. -/
noncomputable def len (I : ℤ × ℤ) : ℝ := dyadicGridLength D.grid I.1

/-- The left endpoint of a cell. -/
noncomputable def left (I : ℤ × ℤ) : ℝ := dyadicGridLeft D.grid I.1 I.2

/-- The inputs at the random parameter `σ`. -/
def inp (σ : Ω) : Fin 4 → ℝ → ℂ := fun j => D.z j σ

theorem len_pos (I : ℤ × ℤ) : 0 < D.len I := dyadicGridLength_pos _ _

theorem measurable_inp (σ : Ω) (j : Fin 4) : Measurable (D.inp σ j) :=
  (D.z_meas j).comp measurable_prodMk_left

/-- The signed sum `Σ_I |I| ε_I(σ) H_I(z^σ)` of `eq:shortblock`. -/
noncomputable def total (ε : ℤ × ℤ → Ω → ℂ) (σ : Ω) : ℂ :=
  ∑ I ∈ D.cells, (D.len I : ℂ) * ε I σ * localProgressionForm (D.len I) (D.kernel I) (D.inp σ)

/-- The first kernel-sampling error at a cell. -/
noncomputable def err1 (I : ℤ × ℤ) (σ : Ω) : ℂ :=
  localProgressionForm (D.len I) (fun w => D.kernel I w - latticeSampledKernel D.δ (D.kernel I) w)
    (D.inp σ)

end BlockData

/-- Hölder in the random parameter with four `L⁴` factors. -/
theorem lintegral_prod_four_le {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (X : Fin 4 → Ω → ℝ≥0∞) (hX : ∀ j, AEMeasurable (X j) P) :
    ∫⁻ σ, ∏ j, X j σ ∂P ≤ ∏ j, (∫⁻ σ, X j σ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) := by
  have h := ENNReal.lintegral_prod_norm_pow_le (μ := P) Finset.univ
    (f := fun j σ => X j σ ^ (4 : ℝ)) (fun j _ => (hX j).pow_const _) (p := fun _ => (1 / 4 : ℝ))
    (by simp) (fun _ _ => by norm_num)
  refine le_trans (le_of_eq ?_) h
  congr 1; funext σ
  refine Finset.prod_congr rfl fun j _ => ?_
  rw [← ENNReal.rpow_mul]; norm_num

namespace BlockData
variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

/-- The slow pairs `n` whose sampled kernel value at the cell `I` can be nonzero. -/
noncomputable def box (I : ℤ × ℤ) : Finset (ℤ × ℤ) :=
  Finset.Icc ⌈D.left I / D.δ⌉ ⌊(D.left I + D.len I) / D.δ⌋ ×ˢ
    Finset.Icc ⌈D.left I / D.δ⌉ ⌊(D.left I + D.len I) / D.δ⌋

theorem mem_box_of_ne {I : ℤ × ℤ} (hI : I ∈ D.cells) {n : ℤ × ℤ}
    (hn : D.kernel I (D.δ * n.1, D.δ * n.2 - D.δ * n.1) ≠ 0) : n ∈ D.box I := by
  have hs := admissibleLocalKernel_support (D.len_pos I).le (D.admissible I hI) _ hn
  have h0 := hs 0
  have h1 := hs 1
  simp only [realProgressionCoordinate, Fin.val_zero, Nat.cast_zero, zero_mul, add_zero,
    Fin.val_one, Nat.cast_one, one_mul, Set.mem_Icc, add_sub_cancel] at h0 h1
  have hδ := D.δ_pos
  have hb : ∀ k : ℤ, D.left I ≤ D.δ * k → D.δ * k ≤ D.left I + D.len I →
      k ∈ Finset.Icc ⌈D.left I / D.δ⌉ ⌊(D.left I + D.len I) / D.δ⌋ := by
    intro k h1 h2
    rw [Finset.mem_Icc]
    constructor
    · rw [Int.ceil_le, div_le_iff₀ hδ]; linarith
    · rw [Int.le_floor, le_div_iff₀ hδ]; linarith
  exact Finset.mem_product.mpr ⟨hb _ h0.1 h0.2, hb _ h1.1 h1.2⟩

/-- The lattice sum `Σ_I |I| ε_I r_I⁻² δ² 256 Σ_n w_I(δ n₀, δ(n₁ - n₀)) Φ_n(F)` for fast
data `F`. -/
noncomputable def latticeSum (ε : ℤ × ℤ → Ω → ℂ) (σ : Ω) (F : Fin 4 → ℤ → FastCircle → ℂ) : ℂ :=
  ∑ I ∈ D.cells, (D.len I : ℂ) * ε I σ * ((D.len I : ℂ)⁻¹ ^ 2 * ((D.δ ^ 2 : ℝ) : ℂ) * 256 *
    ∑ n ∈ D.box I, D.kernel I (D.δ * n.1, D.δ * n.2 - D.δ * n.1) * fastFormAt F n)

/-- Blueprint lines 2307-2312: for inputs in `L²`, the signed sum splits into the first sampling
errors and the lattice sum of the fast forms of the lifted inputs. -/
theorem total_eq (ε : ℤ × ℤ → Ω → ℂ) (σ : Ω) (hL : ∀ j, MemLp (D.inp σ j) 2 volume) :
    D.total ε σ = ∑ I ∈ D.cells, (D.len I : ℂ) * ε I σ * D.err1 I σ +
      D.latticeSum ε σ (slotLift D.δ (D.inp σ)) := by
  unfold total latticeSum
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun I hI => ?_
  have hr := D.len_pos I
  have hw := D.admissible I hI
  have hsupp := admissibleLocalKernel_support hr.le hw
  have hwm : Measurable (D.kernel I) := hw.smooth.continuous.measurable
  have hW := admissibleLocalKernel_norm_le hw
  have hf := D.measurable_inp σ
  have h1 := progression_integrable hr hsupp hwm hW (D.inp σ) hf hL
  have h2 := progression_integrable (by linarith [D.δ_pos] : 0 < D.len I + 10 * D.δ)
    (latticeSampled_support D.δ_pos hsupp) (measurable_latticeSampledKernel hwm D.δ)
    (W := localKernelSupBound κ) (fun z => hW _) (D.inp σ) hf hL
  have hsplit : localProgressionForm (D.len I) (D.kernel I) (D.inp σ) = D.err1 I σ +
      localProgressionForm (D.len I) (latticeSampledKernel D.δ (D.kernel I)) (D.inp σ) := by
    have h3 : Integrable fun z : ℝ × ℝ =>
        (D.kernel I z - latticeSampledKernel D.δ (D.kernel I) z) *
          ∏ j, D.inp σ j (realProgressionCoordinate j z) := by
      convert h1.sub h2 using 1; funext z; simp only [Pi.sub_apply]; ring
    unfold err1 localProgressionForm
    rw [← mul_add, ← integral_add h3 h2]
    congr 1
    refine integral_congr_ae (Filter.Eventually.of_forall fun z => ?_)
    simp only; ring
  rw [hsplit, sampled_form_eq_fast hr D.δ_pos hsupp hwm hW (D.inp σ) hf hL (D.box I)
    (fun n hn => D.mem_box_of_ne hI hn)]
  ring

end BlockData

theorem memLp_slotLift {δ : ℝ} (hδ : 0 < δ) {f : Fin 4 → ℝ → ℂ} (hf : ∀ j, Measurable (f j))
    (hL : ∀ j, MemLp (f j) 2 volume) (j : Fin 4) (m : ℤ) :
    MemLp (slotLift δ f j m) 2 fastHaar := by
  rw [memLp_iff, eLpNorm_two_eq (measurable_slotLift hf j m).aestronglyMeasurable,
    lintegral_slotLift δ hδ f hf j m 2 (by norm_num)]
  refine ENNReal.rpow_lt_top_of_nonneg (by norm_num) (ENNReal.mul_ne_top (by simp [hδ]) ?_)
  refine ((setLIntegral_le_lintegral _ _).trans_lt ?_).ne
  have h := (hL j).eLpNorm_lt_top
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)
    (hf j).aestronglyMeasurable] at h
  simp only [ENNReal.toReal_ofNat] at h
  exact (ENNReal.rpow_lt_top_iff_of_pos (by norm_num : (0 : ℝ) < 1 / 2)).mp h

/-- Joint measurability of the lifted random slots. -/
theorem measurable_slotLift_joint {Ω : Type*} [MeasurableSpace Ω] {δ : ℝ}
    {z : Fin 4 → Ω → ℝ → ℂ} (hz : ∀ j, Measurable (Function.uncurry (z j))) (j : Fin 4) (m : ℤ) :
    Measurable fun p : Ω × FastCircle => slotLift δ (fun i => z i p.1) j m p.2 := by
  unfold slotLift fastLift
  refine Measurable.ite ?_ ?_ measurable_const
  · exact measurableSet_lt ((measurable_fastRep j).comp measurable_snd) measurable_const
  · exact (hz j).comp (measurable_fst.prodMk (measurable_const.mul (measurable_const.add
      ((measurable_fastRep j).comp measurable_snd))))

theorem measurable_fourierCoeff_slotLift {Ω : Type*} [MeasurableSpace Ω] {δ : ℝ}
    {z : Fin 4 → Ω → ℝ → ℂ} (hz : ∀ j, Measurable (Function.uncurry (z j))) (j : Fin 4) (m k : ℤ) :
    Measurable fun σ => fourierCoeff (slotLift δ (fun i => z i σ) j m) k := by
  unfold fourierCoeff
  have h : StronglyMeasurable fun p : Ω × FastCircle =>
      fourier (-k) p.2 • slotLift δ (fun i => z i p.1) j m p.2 :=
    (((fourier (-k)).continuous.measurable.comp measurable_snd).smul
      (measurable_slotLift_joint hz j m)).stronglyMeasurable
  exact (h.integral_prod_right' (ν := fastHaar)).measurable

/-- The fast form is additive in one slot. -/
theorem fastFormAt_add_slot (F G H : Fin 4 → ℤ → FastCircle → ℂ) (a : Fin 4)
    (hF : ∀ j, j ≠ a → F j = G j) (hH : ∀ j, j ≠ a → H j = G j)
    (hsum : ∀ m t, G a m t = F a m t + H a m t)
    (cF : ∀ j m, Continuous (F j m)) (cH : ∀ j m, Continuous (H j m)) (n : ℤ × ℤ) :
    fastFormAt G n = fastFormAt F n + fastFormAt H n := by
  unfold fastFormAt
  have hint : ∀ K : Fin 4 → ℤ → FastCircle → ℂ, (∀ j m, Continuous (K j m)) →
      Integrable (fun x => ∏ j : Fin 4, K j (latticeCoord j n) (fastCoord j x))
        (fastHaar.prod fastHaar) := fun K hK =>
    (continuous_finsetProd _ fun j _ =>
      (hK j _).comp (continuous_fastCoord _)).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
  rw [← integral_add (hint F cF) (hint H cH)]
  congr 1; funext x
  rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ a),
    ← Finset.mul_prod_erase _ _ (Finset.mem_univ a),
    ← Finset.mul_prod_erase _ _ (Finset.mem_univ a), hsum, add_mul]
  congr 2
  · exact Finset.prod_congr rfl fun j hj => by rw [hF j (Finset.ne_of_mem_erase hj)]
  · exact Finset.prod_congr rfl fun j hj => by rw [hH j (Finset.ne_of_mem_erase hj)]

namespace BlockData
variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

/-- The retained weights: the heavy slot keeps exactly the slow points in `keep`. -/
noncomputable def wRet (a : Fin 4) (keep : Set ℤ) : Fin 4 → ℤ → ℂ := by
  classical
  exact fun j m => if j = a ∧ m ∉ keep then 0 else 1

/-- The deleted weights: the heavy slot keeps exactly the slow points outside `keep`. -/
noncomputable def wDel (a : Fin 4) (keep : Set ℤ) : Fin 4 → ℤ → ℂ := by
  classical
  exact fun j m => if j = a ∧ m ∈ keep then 0 else 1

theorem latticeSum_add (ε : ℤ × ℤ → Ω → ℂ) (σ : Ω) (F G H : Fin 4 → ℤ → FastCircle → ℂ)
    (h : ∀ n, fastFormAt G n = fastFormAt F n + fastFormAt H n) :
    D.latticeSum ε σ G = D.latticeSum ε σ F + D.latticeSum ε σ H := by
  unfold latticeSum
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun I _ => ?_
  simp_rw [h, mul_add, Finset.sum_add_distrib]
  ring

end BlockData

theorem enorm_ofReal_of_nonneg {x : ℝ} (hx : 0 ≤ x) : ‖(x : ℂ)‖ₑ = ENNReal.ofReal x := by
  rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg hx]

theorem fastLift_right_le (j : Fin 4) : fastLiftLeft j + fastLiftLen j ≤ 4 := by
  unfold fastLiftLeft fastLiftLen; split_ifs <;> norm_num

namespace BlockData
variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

/-- The deterministic sizes as complex functions. -/
noncomputable def Zc : Fin 4 → ℝ → ℂ := fun j y => (D.Z j y : ℂ)

theorem measurable_Zc (j : Fin 4) : Measurable (D.Zc j) :=
  Complex.measurable_ofReal.comp (D.Z_meas j)

/-- The constant of the second sampling error. -/
noncomputable def err2Const (C4 : ℝ) : ℝ≥0∞ := (2 : ℝ≥0∞) ^ (1 / 2 : ℝ) * ENNReal.ofReal C4 ^ 2 / 8

end BlockData

namespace DepthRect

/-! ### Assembly of `eq:shortblock` (lem:shortblock, blueprint lines 2272-2369) -/

/-- The heavy slot `a` of a rectangle (for `rep`, the least attaining slot). -/
noncomputable def heavy : DepthRect → Fin 4
  | rep S _ => if h : S.Nonempty then S.min' h else 0
  | uniq a _ _ _ => a

/-- The designated slot `b` of a rectangle (blueprint line 2292). -/
noncomputable def desig : DepthRect → Fin 4
  | rep S _ => if h : (S.erase (if h : S.Nonempty then S.min' h else 0)).Nonempty then
      (S.erase (if h : S.Nonempty then S.min' h else 0)).min' h else 0
  | uniq _ S _ _ => if h : S.Nonempty then S.min' h else 0

theorem heavy_mem_rep {S : Finset (Fin 4)} {v : ℕ} (hv : Valid (rep S v)) :
    heavy (rep S v) ∈ S := by
  have hS : S.Nonempty := Finset.card_pos.mp (by have : 2 ≤ S.card := hv; omega)
  simp only [heavy, hS, ↓reduceDIte]
  exact Finset.min'_mem S hS

theorem desig_mem_rep {S : Finset (Fin 4)} {v : ℕ} (hv : Valid (rep S v)) :
    desig (rep S v) ∈ S ∧ desig (rep S v) ≠ heavy (rep S v) := by
  have hS : S.Nonempty := Finset.card_pos.mp (by have : 2 ≤ S.card := hv; omega)
  have hE : (S.erase (S.min' hS)).Nonempty := by
    rw [← Finset.card_pos, Finset.card_erase_of_mem (Finset.min'_mem S hS)]
    have : 2 ≤ S.card := hv; omega
  simp only [desig, heavy, hS, ↓reduceDIte, hE]
  have := Finset.min'_mem _ hE
  exact ⟨Finset.mem_of_mem_erase this, Finset.ne_of_mem_erase this⟩

theorem desig_mem_uniq {a : Fin 4} {S : Finset (Fin 4)} {h k : ℕ} (hv : Valid (uniq a S h k)) :
    desig (uniq a S h k) ∈ S ∧ desig (uniq a S h k) ≠ heavy (uniq a S h k) := by
  obtain ⟨haS, hS⟩ := hv
  simp only [desig, heavy, hS, ↓reduceDIte]
  have := Finset.min'_mem S hS
  exact ⟨this, fun e => haS (e ▸ this)⟩

theorem desig_ne_heavy {R : DepthRect} (hv : Valid R) : desig R ≠ heavy R := by
  cases R with
  | rep S v => exact (desig_mem_rep hv).2
  | uniq a S h k => exact (desig_mem_uniq hv).2

/-- The level of a rectangle: its slot assignment and scale, forgetting the position. -/
def level : DepthRect → DepthRect
  | rep S _ => rep S 0
  | uniq a S h _ => uniq a S h 0

end DepthRect

/-- A finite dyadic tree piece of `lem:shortblock` (blueprint line 2276): a root cell, internal
summation cells in the `K` consecutive depths starting at `first`, and leaves in that block or one
depth below; the leaves are disjoint cells inside the root covering it, and an internal cell
meeting a leaf is strictly coarser. -/
structure ShortBlockTree (G : RealDyadicGrid) (K : ℕ) where
  root : ℤ × ℤ
  first : ℤ
  internal : Finset (ℤ × ℤ)
  leaves : Finset (ℤ × ℤ)
  internal_depth : ∀ I ∈ internal, first ≤ I.1 ∧ I.1 < first + K
  leaf_depth : ∀ L ∈ leaves, first ≤ L.1 ∧ L.1 ≤ first + K
  internal_subset : ∀ I ∈ internal,
    dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G root.1 root.2
  leaf_subset : ∀ L ∈ leaves, dyadicGridCell G L.1 L.2 ⊆ dyadicGridCell G root.1 root.2
  leaf_disjoint : (leaves : Set (ℤ × ℤ)).PairwiseDisjoint fun L => dyadicGridCell G L.1 L.2
  leaf_cover : dyadicGridCell G root.1 root.2 ⊆ ⋃ L ∈ leaves, dyadicGridCell G L.1 L.2
  internal_leaf : ∀ I ∈ internal, ∀ L ∈ leaves,
    (dyadicGridCell G I.1 I.2 ∩ dyadicGridCell G L.1 L.2).Nonempty → I.1 < L.1

namespace ShortBlockTree
variable {G : RealDyadicGrid} {K : ℕ} (T : ShortBlockTree G K)

/-- Left endpoints and lengths of cells. -/
noncomputable def cl (G : RealDyadicGrid) (c : ℤ × ℤ) : ℝ := dyadicGridLeft G c.1 c.2

noncomputable def cr (G : RealDyadicGrid) (c : ℤ × ℤ) : ℝ := dyadicGridLength G c.1

theorem leafInterval_eq (c : ℤ × ℤ) :
    leafInterval (cl G) (cr G) c = dyadicGridCell G c.1 c.2 := rfl

/-- Every leaf meeting an internal cell lies inside it. -/
theorem leaf_subset_internal {I L : ℤ × ℤ} (hI : I ∈ T.internal) (hL : L ∈ T.leaves)
    (h : (dyadicGridCell G I.1 I.2 ∩ dyadicGridCell G L.1 L.2).Nonempty) :
    dyadicGridCell G L.1 L.2 ⊆ dyadicGridCell G I.1 I.2 := by
  have hlt := T.internal_leaf I hI L hL h
  rcases dyadicGridCell_nested_or_disjoint_of_le G hlt.le I.2 L.2 with hd | hs
  · exact absurd h (Set.not_nonempty_iff_eq_empty.mpr (Set.disjoint_iff_inter_eq_empty.mp hd))
  · exact hs

/-- The padded depth of a leaf. -/
def depth (L : ℤ × ℤ) : ℕ := (L.1 - T.first).toNat

theorem depth_le {L : ℤ × ℤ} (hL : L ∈ T.leaves) : T.depth L ≤ K := by
  have := T.leaf_depth L hL; unfold depth; omega

/-- The leaf-depth labelling of points (zero outside the leaves). -/
noncomputable def dep (y : ℝ) : ℕ :=
  ∑ L ∈ T.leaves, (dyadicGridCell G L.1 L.2).indicator (fun _ => T.depth L) y

theorem dep_eq {L : ℤ × ℤ} (hL : L ∈ T.leaves) {y : ℝ} (hy : y ∈ dyadicGridCell G L.1 L.2) :
    T.dep y = T.depth L := by
  unfold dep
  rw [Finset.sum_eq_single L]
  · rw [Set.indicator_of_mem hy]
  · intro L' hL' hne
    refine Set.indicator_of_notMem (fun hy' => ?_) _
    exact Set.disjoint_left.mp (T.leaf_disjoint hL' hL hne) hy' hy
  · intro h; exact absurd hL h

theorem measurable_dep : Measurable T.dep := by
  unfold dep
  exact Finset.measurable_sum _ fun L _ =>
    measurable_const.indicator (dyadicGridCell_measurable G L.1 L.2)

theorem dep_lt {m : ℕ} (hm : K < 2 ^ m) (y : ℝ) : T.dep y < 2 ^ m := by
  by_cases h : ∃ L ∈ T.leaves, y ∈ dyadicGridCell G L.1 L.2
  · obtain ⟨L, hL, hy⟩ := h
    rw [T.dep_eq hL hy]
    exact (T.depth_le hL).trans_lt hm
  · push Not at h
    have : T.dep y = 0 := by
      unfold dep
      exact Finset.sum_eq_zero fun L hL => Set.indicator_of_notMem (h L hL) _
    rw [this]; positivity

end ShortBlockTree

namespace DepthRect

/-- The position of a rectangle within its level. -/
def pos : DepthRect → ℕ
  | rep _ v => v
  | uniq _ _ _ k => k

theorem eq_of_level_pos {R R' : DepthRect} (hl : level R = level R') (hp : pos R = pos R') :
    R = R' := by
  cases R <;> cases R' <;> simp_all [level, pos]

end DepthRect

/-- Cauchy–Schwarz for finite sums in `ℝ≥0∞`. -/
theorem ennreal_sum_sqrt_mul_le {ι : Type*} (s : Finset ι) (f g : ι → ℝ≥0∞) :
    ∑ i ∈ s, f i ^ (1 / 2 : ℝ) * g i ^ (1 / 2 : ℝ) ≤
      (∑ i ∈ s, f i) ^ (1 / 2 : ℝ) * (∑ i ∈ s, g i) ^ (1 / 2 : ℝ) := by
  refine (ENNReal.inner_le_Lp_mul_Lq s (fun i => f i ^ (1 / 2 : ℝ)) (fun i => g i ^ (1 / 2 : ℝ))
    Real.HolderConjugate.two_two).trans (le_of_eq ?_)
  simp_rw [← ENNReal.rpow_mul]
  norm_num

theorem dyadicGridLength_mul_two_pow (G : RealDyadicGrid) (s : ℤ) (n : ℕ) :
    dyadicGridLength G s = dyadicGridLength G (s + n) * 2 ^ n := by
  unfold dyadicGridLength
  rw [mul_assoc, ← zpow_natCast, ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
  congr 2; ring

theorem two_mul_dyadicGridLength_le (G : RealDyadicGrid) {s t : ℤ} (h : s < t) :
    2 * dyadicGridLength G t ≤ dyadicGridLength G s := by
  obtain ⟨n, hn⟩ : ∃ n : ℕ, t = s + (n + 1 : ℕ) := ⟨(t - s - 1).toNat, by omega⟩
  rw [dyadicGridLength_mul_two_pow G s (n + 1), ← hn, pow_succ]
  have hl := dyadicGridLength_pos G t
  have : (1 : ℝ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
  nlinarith

/-- The sampling weights of the coarser depths: `Σ_{s ∈ S} r_t / r_s ≤ 1` for distinct `s < t`. -/
theorem sum_length_ratio_le (G : RealDyadicGrid) (S : Finset ℤ) {t : ℤ} (hS : ∀ s ∈ S, s < t) :
    ∑ s ∈ S, dyadicGridLength G t / dyadicGridLength G s ≤ 1 := by
  classical
  set f : ℤ → ℕ := fun s => (t - s - 1).toNat
  have hf : Set.InjOn f S := by
    intro s hs s' hs' e
    have := hS s hs; have := hS s' hs'
    simp only [f] at e; omega
  have hterm : ∀ s ∈ S, dyadicGridLength G t / dyadicGridLength G s = (1 / 2 : ℝ) ^ (f s + 1) := by
    intro s hs
    have h := hS s hs
    have ht : t = s + ((f s + 1 : ℕ) : ℤ) := by simp only [f]; omega
    rw [div_eq_iff (dyadicGridLength_pos G s).ne', dyadicGridLength_mul_two_pow G s (f s + 1),
      ← ht, mul_comm ((1 / 2 : ℝ) ^ _), mul_assoc, ← mul_pow]
    norm_num
  rw [Finset.sum_congr rfl hterm, ← Finset.sum_image (f := fun k => (1 / 2 : ℝ) ^ (k + 1)) hf]
  obtain ⟨n, hn⟩ := Finset.exists_nat_subset_range (S.image f)
  calc ∑ k ∈ S.image f, (1 / 2 : ℝ) ^ (k + 1) ≤ ∑ k ∈ Finset.range n, (1 / 2 : ℝ) ^ (k + 1) :=
        Finset.sum_le_sum_of_subset_of_nonneg hn fun _ _ _ => by positivity
    _ ≤ 1 := by
        have h := sum_geometric_two_le n
        calc ∑ k ∈ Finset.range n, (1 / 2 : ℝ) ^ (k + 1)
            = (1 / 2) * ∑ k ∈ Finset.range n, (1 / 2 : ℝ) ^ k := by
              rw [Finset.mul_sum]; congr 1; funext k; ring
          _ ≤ (1 / 2) * 2 := by gcongr
          _ = 1 := by norm_num

namespace ShortBlockTree
variable {G : RealDyadicGrid} {K : ℕ} (T : ShortBlockTree G K)

/-- The sampling ratio `β`. -/
noncomputable def beta (κ : LocalKernelClass) : ℝ := min κ.margin 1 / 16

theorem beta_pos (κ : LocalKernelClass) : 0 < beta κ := by
  unfold beta; have := κ.margin_pos; positivity

end ShortBlockTree

namespace ShortBlockTree
variable {G : RealDyadicGrid} {K : ℕ} (T : ShortBlockTree G K) (κ : LocalKernelClass)
  (cells : Finset (ℤ × ℤ)) (hcells : cells ⊆ T.internal) (kernel : ℤ × ℤ → ℝ × ℝ → ℂ)
  (hker : ∀ I ∈ T.internal, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2)
    (dyadicGridLength G I.1) (kernel I))
  {Ω : Type*} [MeasurableSpace Ω] {E : Type*} [NormedAddCommGroup E] (z : Fin 4 → ℝ → E)
  (hz : ∀ j, Measurable fun y => ‖z j y‖) (zσ : Fin 4 → Ω → ℝ → ℂ)
  (hzσ : ∀ j, Measurable (Function.uncurry (zσ j)))

/-- The leaf bound in the normalized form. -/
def LeafBound (z : Fin 4 → ℝ → E) : Prop :=
  ∀ j, ∀ L ∈ T.leaves, ∫⁻ y in dyadicGridCell G L.1 L.2, ‖z j y‖ₑ ^ 2 ≤
    ENNReal.ofReal (dyadicGridLength G L.1)

end ShortBlockTree

/-- The heavy exponent `p_* = 2q - 2`. -/
def pStar (q : ℝ) : ℝ := 2 * q - 2

/-- The regular exponent `p = 2 p_* / (p_* - 2) = (2q - 2) / (q - 2)`. -/
noncomputable def pReg (q : ℝ) : ℝ := (2 * q - 2) / (q - 2)

theorem two_le_pStar {q : ℝ} (hq : 2 < q) : 2 ≤ pStar q := by unfold pStar; linarith

theorem two_le_pReg {q : ℝ} (hq : 2 < q) : 2 ≤ pReg q := by
  unfold pReg; rw [le_div_iff₀ (by linarith)]; linarith

theorem pStar_pReg_sum {q : ℝ} (hq : 2 < q) : 2 / pStar q + 2 / pReg q = 1 := by
  unfold pStar pReg
  have h1 : (2 * q - 2) ≠ 0 := by linarith
  have h2 : q - 2 ≠ 0 := by linarith
  rw [show 2 / ((2 * q - 2) / (q - 2)) = 2 * (q - 2) / (2 * q - 2) by field_simp,
    ← add_div, div_eq_one_iff_eq h1]
  ring

namespace ShortBlockTree
variable {G : RealDyadicGrid} {K : ℕ} (T : ShortBlockTree G K) (κ : LocalKernelClass)
  (cells : Finset (ℤ × ℤ)) (hcells : cells ⊆ T.internal) (kernel : ℤ × ℤ → ℝ × ℝ → ℂ)
  (hker : ∀ I ∈ T.internal, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2)
    (dyadicGridLength G I.1) (kernel I))
  {Ω : Type*} [MeasurableSpace Ω] {E : Type*} [NormedAddCommGroup E] (z : Fin 4 → ℝ → E)
  (hz : ∀ j, Measurable fun y => ‖z j y‖) (zσ : Fin 4 → Ω → ℝ → ℂ)
  (hzσ : ∀ j, Measurable (Function.uncurry (zσ j)))

/-- The exponents of a rectangle: `p_*` in the heavy and designated slots, `p` elsewhere. -/
noncomputable def pexp (q : ℝ) (R : DepthRect) (j : Fin 4) : ℝ := by
  classical
  exact if j = DepthRect.heavy R ∨ j = DepthRect.desig R then pStar q else pReg q

theorem sum_inv_pexp {q : ℝ} (hq : 2 < q) {R : DepthRect} (hv : DepthRect.Valid R) :
    ∑ j, 1 / pexp q R j = 1 := by
  classical
  have hab := (DepthRect.desig_ne_heavy hv).symm
  have hite : ∀ j, 1 / pexp q R j = if j = DepthRect.heavy R ∨ j = DepthRect.desig R then
      1 / pStar q else 1 / pReg q := fun j => by unfold pexp; split_ifs <;> rfl
  simp_rw [hite]
  rw [Finset.sum_ite]
  have hc1 : (Finset.univ.filter fun j : Fin 4 =>
      j = DepthRect.heavy R ∨ j = DepthRect.desig R) =
        {DepthRect.heavy R, DepthRect.desig R} := by
    ext j; simp
  have hc2 : (Finset.univ.filter fun j : Fin 4 =>
      ¬(j = DepthRect.heavy R ∨ j = DepthRect.desig R)).card = 2 := by
    have := Finset.card_filter_add_card_filter_not (s := (Finset.univ : Finset (Fin 4)))
      (fun j : Fin 4 => j = DepthRect.heavy R ∨ j = DepthRect.desig R)
    rw [hc1, Finset.card_pair hab, Finset.card_univ, Fintype.card_fin] at this
    omega
  rw [hc1, Finset.sum_const, Finset.sum_const, Finset.card_pair hab, hc2]
  have := pStar_pReg_sum hq
  simp only [nsmul_eq_mul]; push_cast
  linarith [show (2 : ℝ) * (1 / pStar q) = 2 / pStar q by ring,
    show (2 : ℝ) * (1 / pReg q) = 2 / pReg q by ring]

/-- The regular window constant `E₂ = 1/2 + 1/(8β)`. -/
noncomputable def regE2 : ℝ := 1 / 2 + 1 / (8 * beta κ)

end ShortBlockTree

theorem natLog_le_two_log (K : ℕ) : (Nat.log 2 (K + 1) : ℝ) ≤ 2 * Real.log ((K : ℝ) + 2) := by
  have h1 : 2 ^ Nat.log 2 (K + 1) ≤ K + 1 := Nat.pow_log_le_self 2 (by omega)
  have h2 : ((2 : ℝ) ^ Nat.log 2 (K + 1)) ≤ (K : ℝ) + 2 := by
    have : ((2 ^ Nat.log 2 (K + 1) : ℕ) : ℝ) ≤ ((K + 1 : ℕ) : ℝ) := by exact_mod_cast h1
    push_cast at this ⊢; linarith
  have h3 : (Nat.log 2 (K + 1) : ℝ) * Real.log 2 ≤ Real.log ((K : ℝ) + 2) := by
    rw [← Real.log_pow]
    exact Real.log_le_log (by positivity) h2
  have hl := Real.log_two_gt_d9
  have hK : 0 ≤ Real.log ((K : ℝ) + 2) :=
    Real.log_nonneg (by linarith [(K.cast_nonneg : (0 : ℝ) ≤ K)])
  nlinarith

theorem two_pow_succ_log_le (K : ℕ) :
    ((2 ^ (Nat.log 2 (K + 1) + 1) : ℕ) : ℝ) ≤ 2 * ((K : ℝ) + 2) := by
  have h1 : 2 ^ Nat.log 2 (K + 1) ≤ K + 1 := Nat.pow_log_le_self 2 (by omega)
  have : ((2 ^ (Nat.log 2 (K + 1) + 1) : ℕ) : ℝ) ≤ 2 * ((K + 1 : ℕ) : ℝ) := by
    rw [pow_succ]; push_cast; exact_mod_cast (by omega : 2 ^ Nat.log 2 (K + 1) * 2 ≤ 2 * (K + 1))
  push_cast at this ⊢; linarith

theorem pStar_exponent {q : ℝ} (hq : 2 < q) :
    (pStar q - 2) / pStar q = (q - 2) / (q - 1) ∧ 1 - 2 / pStar q = (q - 2) / (q - 1) := by
  unfold pStar
  have h1 : (2 * q - 2) ≠ 0 := by linarith
  have h2 : q - 1 ≠ 0 := by linarith
  constructor <;> field_simp <;> ring

theorem localProgressionForm_mul_const (r : ℝ) (w : ℝ × ℝ → ℂ) (f : Fin 4 → ℝ → ℂ)
    (c : Fin 4 → ℂ) :
    localProgressionForm r w (fun j y => f j y * c j) =
      (∏ j, c j) * localProgressionForm r w f := by
  unfold localProgressionForm
  simp_rw [Finset.prod_mul_distrib]
  rw [show (fun z : ℝ × ℝ => w z * ((∏ j, f j (realProgressionCoordinate j z)) * ∏ j, c j)) =
    fun z => (w z * ∏ j, f j (realProgressionCoordinate j z)) * ∏ j, c j by funext z; ring,
    integral_mul_const]
  ring

theorem q_lt_pStar {q : ℝ} (hq : 2 < q) : q < pStar q := by unfold pStar; linarith

theorem q_lt_pReg {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) : q < pReg q := by
  unfold pReg; rw [lt_div_iff₀ (by linarith)]; nlinarith


      (Xi'.bounded K li) (Xk'.bounded K' lk) hBp hai hak hab hik hib hkb)).mono hD₀ hc₁'
  let pkgb : ∀ (K K' : ℤ × ℤ) (li : Xi'.Λ) (lk : Xk'.Λ),

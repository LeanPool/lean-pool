    PredictorPackage κ (Xi.chart K li) (Xk.chart K' lk) a i k b Bp D c₁)
  {ε : ℝ} (hε0 : 0 < ε) (hε1 : ε ≤ 1)

/-! ### The delayed replacement of one high input on an accurate-fit root -/

/-- The accurate-fit setup of the high slot `a` over the predictor system of the low lists
(blueprint prop:base, lines 1626 and 1634). -/
noncomputable def predAccSetup (K₀ M : ℕ) (f : ℝ → ℂ) (w : ℤ × ℤ → ℝ × ℝ → ℂ) (q : ℝ)
    (kk c₂ : ℕ) (Bf : ℝ) : AccSetup where
  G := G
  J := J
  N := N
  K₀ := K₀
  V₀ := Xi.Λ × Xk.Λ × Fin (⌊D⌋₊)
  P₀ := predSystem κ Xi Xk a i k b Bp D pkg hε0 hε1
  M := M
  f := f
  w := w
  e := a
  q := q
  k := kk
  c₂ := c₂
  B := Bf

/-- Blueprint prop:base, proof lines 1626-1641: on the segment of an accurate-fit root `K`, the
input in slot `a` is replaced by the delayed physical projection of the accurate-fit system, with
the absolute scale-sum error of lem:predictors and lem:delay. -/
theorem replaceSlot (hai : a ≠ i) (hak : a ≠ k) (hab : a ≠ b) (hik : i ≠ k) (hib : i ≠ b)
    (hkb : k ≠ b) (hD1 : 1 ≤ D) (K₀ M : ℕ) (f : ℝ → ℂ) (w : ℤ × ℤ → ℝ × ℝ → ℂ) (q : ℝ)
    (k' c₂ : ℕ) (Bf : ℝ)
    (h : (predAccSetup κ Xi Xk a i k b Bp D pkg hε0 hε1 K₀ M f w q k' c₂ Bf).Hyp)
    (hw : ∀ I, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)
      (w I))
    {K : ℤ × ℤ} (hKr : K ∈ (predAccSetup κ Xi Xk a i k b Bp D pkg hε0 hε1 K₀ M f w q k' c₂
      Bf).tree.roots)
    {R : ℤ × ℤ} (hR : R ∈ dyadicFiniteTree G J N) (T : Finset (ℤ × ℤ))
    (hT : ∀ I ∈ T, I ∈ dyadicFiniteTree G J
      (predAccSetup κ Xi Xk a i k b Bp D pkg hε0 hε1 K₀ M f w q k' c₂ Bf).Nc ∧
      (predAccSetup κ Xi Xk a i k b Bp D pkg hε0 hε1 K₀ M f w q k' c₂ Bf).tree.seg I = K ∧
      dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G R.1 R.2)
    {Fb : ℝ → ℂ} {zb : ℤ × ℤ → ℝ → ℂ} {Kb : ℝ} (hKb : 0 ≤ Kb)
    (hzbJ : ∀ J' ∈ dyadicFiniteTree G J N, dyadicGridCell G J'.1 J'.2 ⊆ dyadicGridCell G R.1 R.2 →
      IsAdmissibleOpponent G J' Fb zb Kb ∧ HasDepthEnergy G J' Fb zb Kb)
    (hzbm : ∀ I, Measurable (zb I))
    (hzb2 : ∀ I, MemLp (zb I) 2 (volume.restrict (dyadicGridCell G I.1 I.2)))
    (hFb : IntegrableOn (fun y => ‖Fb y‖ ^ 2) (dyadicGridCell G R.1 R.2)) :
    let S := predAccSetup κ Xi Xk a i k b Bp D pkg hε0 hε1 K₀ M f w q k' c₂ Bf
    ∑ I ∈ T, dyadicGridLength G I.1 *
      ‖localProgressionForm (dyadicGridLength G I.1) (w I)
          (slots4 a i k f (Xi.val I) (Xk.val I) (zb I)) -
        localProgressionForm (dyadicGridLength G I.1) (w I)
          (slots4 a i k (S.phys I (S.tree.st I).1 (S.tree.st I).2) (Xi.val I) (Xk.val I)
            (zb I))‖ ≤
      (Fintype.card Xi.Λ * Fintype.card Xk.Λ) *
        (2 * Real.exp (-Bp) * (2 * (compressionOneConst ((S.system K).rooted R) + K₀) + 1) * Kb +
          D ^ 2 * (delayConst κ * ((2 : ℝ)⁻¹ ^ K₀ + (1 + K₀) * Real.sqrt ε) *
            (1 + D) ^ 4 * Kb)) *
        Real.sqrt (∫ y in dyadicGridCell G R.1 R.2, ‖(S.input : ℝ → ℂ) y‖ ^ 2) *
        Real.sqrt (∫ y in dyadicGridCell G R.1 R.2, ‖Fb y‖ ^ 2) := by
  intro S
  have hth := h.treeHyp
  have hKc := hth.roots_mem hKr
  have hK : K ∈ dyadicFiniteTree G J N := AccSetup.coarse_tree h hKc
  have hcov : ∀ I li lk, (Xi.restrict R hR).coef I li ≠ 0 → (Xk.restrict R hR).coef I lk ≠ 0 →
      PredictorCover κ (S.system K) a i k b Bp D ε
        ((Xi.restrict R hR).chart ((Xi.restrict R hR).birth I li) li)
        ((Xk.restrict R hR).chart ((Xk.restrict R hR).birth I lk) lk)
        (jointBirth (Xi.restrict R hR) (Xk.restrict R hR) I li lk) := fun I li lk hci hck =>
    AccSetup.predictorCover_system S K
      (predSystem_cover_restrict κ Xi Xk a i k b Bp D pkg hε0 hε1 hD1 R hR hci hck)
  have hTsub : ∀ I ∈ T, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G K.1 K.2 ∧
      I ∈ dyadicFiniteTree G J N ∧ K.1 ≤ I.1 := by
    intro I hI
    obtain ⟨hIc, hseg, -⟩ := hT I hI
    obtain ⟨-, hIK, -, -⟩ := hth.seg_spec hIc
    rw [hseg] at hIK
    exact ⟨hIK, AccSetup.coarse_tree h hIc, dyadicGridCell_depth_le_of_subset G I K hIK⟩
  have hTb : ∀ I ∈ T, I ∈ pathBelow G J N R := fun I hI =>
    (PathColumnSystem.below_mem_iff hR I).mpr ⟨(hTsub I hI).2.1, (hT I hI).2.2⟩
  have hTK₀ : ∀ I ∈ T, I.1 + K₀ ≤ J.1 + N := by
    intro I hI
    have hm : I.1 ≤ J.1 + ((N - K₀ : ℕ) : ℤ) := ((dyadicFiniteTree_mem_iff G J I _).mp (hT I
        hI).1).2
    have h1 : K₀ ≤ N := h.K₀_le
    have h2 : ((N - K₀ : ℕ) : ℤ) = (N : ℤ) - K₀ := by push_cast [h1]; ring
    omega
  have hrep := lowDelayedReplacement κ hai hak hab hik hib hkb (Dl := D) (by linarith)
    (S.system K) hR (Xi.restrict R hR) (Xk.restrict R hR) hcov S.input K₀ T hTb hTK₀ w
    (fun I _ => hw I) hKb hzbJ hzbm hzb2 hFb
  refine le_of_eq_of_le (Finset.sum_congr rfl fun I hI => ?_) hrep
  obtain ⟨hIK, hIT, hKI⟩ := hTsub I hI
  have hr := dyadicGridLength_pos G I.1
  have hwI := hw I
  have hprob : IsProbabilityMeasure (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) := normalizedIntervalMeasure_probability _ hr
  have hvi : (Xi.restrict R hR).val I = Xi.val I := funext (Xi.restrict_val R hR (hT I hI).2.2)
  have hvk : (Xk.restrict R hR).val I = Xk.val I := funext (Xk.restrict_val R hR (hT I hI).2.2)
  symm
  erw [hvi, hvk]
  -- finiteness of the fixed slots
  have hbi := LowList.val_bound Xi I
  have hbk := LowList.val_bound Xk I
  have hXif := (MemLp.of_bound (p := 2) (Xi.val_measurable I).aestronglyMeasurable _
    (Filter.Eventually.of_forall hbi) (μ := normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1))).eLpNorm_ne_top
  have hXkf := (MemLp.of_bound (p := 2) (Xk.val_measurable I).aestronglyMeasurable _
    (Filter.Eventually.of_forall hbk) (μ := normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1))).eLpNorm_ne_top
  have hzbf := (memLp_normalized_of_cell (hzb2 I)).eLpNorm_ne_top
  -- the actual input against the `L²` class of `1_J f`
  have hinm : Measurable (S.input : ℝ → ℂ) := (Lp.stronglyMeasurable _).measurable
  have hinf : eLpNorm (S.input : ℝ → ℂ) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≠ ⊤ :=
    (memLp_normalized_of_cell ((Lp.memLp S.input).restrict _)).eLpNorm_ne_top
  have hff : eLpNorm f 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≠ ⊤ := h.f_fin hIT
  have hJ : dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2 :=
    ((dyadicFiniteTree_mem_iff G J I N).mp hIT).1
  have hin_ae : (S.input : ℝ → ℂ) =ᵐ[normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)] f := by
    refine ae_normalized_of_cell ?_
    filter_upwards [h.input_ae] with y hy hyI
    rw [hy]
    exact Set.indicator_of_mem (hJ hyI) _
  have e1 := localProgressionForm_slots4_congr_a hr hwI hai hak hab hik hib hkb hinm h.f_meas
    (Xi.val_measurable I) (Xk.val_measurable I) (hzbm I) hinf hff hXif hXkf hzbf hin_ae
  -- the delayed projection against the physical part of the fine projections
  set! a' := (fitState G M S.P S.O (I.1 - K.1).toNat I).1
  set! n' := (fitState G M S.P S.O (I.1 - K.1).toNat I).2
  have hst : S.tree.st I = (a', n') := by
    change S.tree.state (S.tree.depthIn I) I = _
    unfold GreedyTree.depthIn GreedyTree.state
    rw [(hT I hI).2.1]
    rfl
  have hdel := h.system_delayed_ae hR (hTb I hI) (hT I hI).1 hIK hKI
  have hdm : Measurable (((S.system K).family R hR).delayed S.input K₀ I) := by
    unfold ColumnDepthFamily.delayed
    have hev : Continuous fun x : ColumnHilbert S.W => x.ofLp none :=
      (continuous_apply none).comp (PiLp.continuous_ofLp 2 _)
    exact hev.measurable.comp (Lp.stronglyMeasurable _).measurable
  have hdf : eLpNorm (((S.system K).family R hR).delayed S.input K₀ I) 2
      (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)) ≠ ⊤ :=
    (memLp_normalized_of_cell (ColumnDepthFamily.memLp_coord_restrict _ _)).eLpNorm_ne_top
  have hpm := S.phys_measurable I a' n'
  have hpf : eLpNorm (S.phys I a' n') 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≠ ⊤ := S.phys_fin I a' n'
  have hdel_ae : ((S.system K).family R hR).delayed S.input K₀ I =ᵐ[normalizedIntervalMeasure
      (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)] S.phys I a' n' :=
    ae_normalized_of_cell hdel
  have e2 := localProgressionForm_slots4_congr_a hr hwI hai hak hab hik hib hkb hdm hpm
    (Xi.val_measurable I) (Xk.val_measurable I) (hzbm I) hdf hpf hXif hXkf hzbf hdel_ae
  rw [hst]
  erw [e1, e2]
  rfl


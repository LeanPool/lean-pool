  refine ⟨P, A, hpack, hcover, hdisj, fun p => ?_⟩
  obtain ⟨hcells, hclos, hG, hw', ha, hb, hRp, hH', hDc, hS, hη, hcard, hrep, hpair, hsize,
    hside, htwo, hcol, hsr⟩ := hA p

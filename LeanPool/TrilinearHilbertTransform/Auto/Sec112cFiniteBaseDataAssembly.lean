/-- The input has finite normalized `L²` norm on every tree cell (only the root normalization is
used). -/
theorem AccSetup.Hyp.f_fin {S : AccSetup} (h : S.Hyp) {c : ℤ × ℤ}
    (hc : c ∈ dyadicFiniteTree S.G S.J S.N) :
    eLpNorm S.f 2 (normalizedIntervalMeasure (dyadicGridLeft S.G c.1 c.2)
      (dyadicGridLength S.G c.1)) ≠ ⊤ := by
  have hcJ := ((dyadicFiniteTree_mem_iff S.G S.J c S.N).mp hc).1
  have h1 : MemLp S.f 2 (volume.restrict (dyadicGridCell S.G c.1 c.2)) := by
    refine (h.memLp.restrict (dyadicGridCell S.G c.1 c.2)).ae_eq ?_
    filter_upwards [ae_restrict_mem (dyadicGridCell_measurable _ _ _)] with y hy
    exact Set.indicator_of_mem (hcJ hy) _
  exact (memLp_normalized_of_cell h1).eLpNorm_ne_top

/-- The physical fine projections have finite normalized `L²` norm on every cell. -/
theorem AccSetup.phys_fin (S : AccSetup) (I : ℤ × ℤ) (a : ℕ → ℝ → ℂ) (n : ℕ) :
    eLpNorm (S.phys I a n) 2 (normalizedIntervalMeasure (dyadicGridLeft S.G I.1 I.2)
      (dyadicGridLength S.G I.1)) ≠ ⊤ := by
  obtain ⟨C, hC⟩ := S.phys_bound I a n
  have := cell_isFiniteMeasure S.G I.1 I.2
  exact (memLp_normalized_of_cell (MemLp.of_bound (S.phys_measurable I a n).aestronglyMeasurable
    C (Filter.Eventually.of_forall hC))).eLpNorm_ne_top

theorem LowList.val_bound {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {R : ℤ × ℤ} {c₀ : ℕ} {H : ℝ}
    (X : LowList G J N R c₀ H) (I : ℤ × ℤ) (y : ℝ) : ‖X.val I y‖ ≤ Fintype.card X.Λ := by
  unfold LowList.val
  refine (norm_sum_le _ _).trans ?_
  calc ∑ l, ‖X.coef I l * X.atom I l y‖ ≤ ∑ _l : X.Λ, (1 : ℝ) := Finset.sum_le_sum fun l _ => by
        rw [norm_mul]
        calc ‖X.coef I l‖ * ‖X.atom I l y‖ ≤ 1 * 1 :=
              mul_le_mul (X.coef_le I l) (X.atom_bound I l y) (norm_nonneg _) zero_le_one
          _ = 1 := one_mul 1
    _ = _ := by rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one]

/-- Changing the slot-`a` input of `slots4` almost everywhere on the cell does not change the
form. -/
theorem localProgressionForm_slots4_congr_a {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a i k b : Fin 4}
    (hai : a ≠ i) (hak : a ≠ k) (hab : a ≠ b) (hik : i ≠ k) (hib : i ≠ b) (hkb : k ≠ b)
    {z₁ z₂ φ φ' zb : ℝ → ℂ} (hz₁ : Measurable z₁) (hz₂ : Measurable z₂) (hφ : Measurable φ)
    (hφ' : Measurable φ') (hzb : Measurable zb)
    (hz₁f : eLpNorm z₁ 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hz₂f : eLpNorm z₂ 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hφf : eLpNorm φ 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hφ'f : eLpNorm φ' 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hzbf : eLpNorm zb 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hae : z₁ =ᵐ[normalizedIntervalMeasure a₀ r] z₂) :
    localProgressionForm r w (slots4 a i k z₁ φ φ' zb) =
      localProgressionForm r w (slots4 a i k z₂ φ φ' zb) := by
  rw [slots4_update_a z₁, slots4_update_a z₂]
  have hcov := fin_four_cover hai hak hab hik hib hkb
  have hm : ∀ l, Measurable (slots4 a i k 0 φ φ' zb l) := by
    intro l
    rcases hcov l with rfl | rfl | rfl | rfl
    · rw [slots4_a]; exact measurable_const
    · rw [slots4_i hai]; exact hφ
    · rw [slots4_k hak hik]; exact hφ'
    · simp only [slots4, hab.symm, hib.symm, hkb.symm, ↓reduceIte]; exact hzb
  have hf : ∀ l, eLpNorm (slots4 a i k 0 φ φ' zb l) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤ := by
    intro l
    rcases hcov l with rfl | rfl | rfl | rfl
    · rw [slots4_a]; simp
    · rw [slots4_i hai]; exact hφf
    · rw [slots4_k hak hik]; exact hφ'f
    · simp only [slots4, hab.symm, hib.symm, hkb.symm, ↓reduceIte]; exact hzbf
  exact localProgressionForm_update_congr_ae hr hw hm hf hai hak hab hik hib hkb hz₁ hz₂ hz₁f hz₂f
    hae


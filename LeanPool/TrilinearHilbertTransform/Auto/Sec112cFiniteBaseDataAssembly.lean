  -- the active setups
  have hdef₀' : ∃ (d : ℕ) (Φ : QuadraticChartData d), QuadraticChartComplexity c₀ H Φ ∧
      IsBoundedQuadraticChart Φ := by
    obtain ⟨d, Φ, -, h1, h2⟩ := hdef₀; exact ⟨d, Φ, h1, h2⟩

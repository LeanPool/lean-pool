        (normalizedIntervalMeasure (dyadicGridLeft G c.1 c.2) (dyadicGridLength G c.1)) ≤ 1 :=
    fun l c hc hcH => eLpNorm_two_le_of_q (dyadicGridLength_pos G c.1) hq.le
      (hfq l c ((hbelow c).mp hc).1 (by

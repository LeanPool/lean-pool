/-- Pair smallness bounds a four-slot form by the exact sizes of its two spectators. -/
theorem PairSmall.slots4_le_norm_mul {a₀ r : ℝ} {w : ℝ × ℝ → ℂ}
    {a i k b : Fin 4} (hai : a ≠ i) (hak : a ≠ k) (hab : a ≠ b)
    (hik : i ≠ k) (hib : i ≠ b) (hkb : k ≠ b) {η : ℝ} (hη : 0 ≤ η)
    {Fi Fk : ℝ → ℂ} (hp : PairSmall a₀ r w i k Fi Fk η)
    (hFi : Measurable Fi) (hFk : Measurable Fk) (Fa Fb : ℝ → ℂ)
    (hFa : Measurable Fa) (hFb : Measurable Fb)
    (hfa : eLpNorm Fa 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hfb : eLpNorm Fb 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤) :
    ‖localProgressionForm r w (slots4 a i k Fa Fi Fk Fb)‖ ≤
      (eLpNorm Fa 2 (normalizedIntervalMeasure a₀ r)).toReal *
        (eLpNorm Fb 2 (normalizedIntervalMeasure a₀ r)).toReal * η := by
  set F := slots4 a i k Fa Fi Fk Fb with hF_def
  have hFe : slotPair F i k Fi Fk = F := by
    unfold slotPair
    rw [show Fi = F i from (slots4_i hai _ _ _ _).symm,
      show Fk = F k from (slots4_k hak hik _ _ _ _).symm,
      Function.update_eq_self, Function.update_eq_self]
  have hFm : ∀ l, Measurable (F l) := by
    intro l
    rcases fin_four_cover hai hak hab hik hib hkb l with rfl | rfl | rfl | rfl
    · rw [hF_def, slots4_a]; exact hFa
    · rw [hF_def, slots4_i hai]; exact hFi
    · rw [hF_def, slots4_k hak hik]; exact hFk
    · rw [hF_def, slots4_b hab hib hkb]; exact hFb
  have h := PairSmall.le_norm_mul hik hη hp hFm hab hai hak hib.symm hkb.symm
    (by rw [hF_def, slots4_a]; exact hfa) (by rw [hF_def, slots4_b hab hib hkb]; exact hfb)
  rw [hFe, hF_def, slots4_a, slots4_b hab hib hkb] at h
  exact h

/-- The input has finite normalized `L²` norm on every tree cell (only the root normalization is
used). -/
theorem AccSetup.Hyp.f_fin {S : AccSetup} (h : S.Hyp) {c : ℤ × ℤ}
    (hc : c ∈ dyadicFiniteTree S.G S.J S.N) :
    eLpNorm S.f 2 (normalizedIntervalMeasure (dyadicGridLeft S.G c.1 c.2)
      (dyadicGridLength S.G c.1)) ≠ ⊤ := by
  have hcJ := ((dyadicFiniteTree_mem_iff S.G S.J c S.N).mp hc).1
  have h1 : MemLp S.f 2 (volume.restrict (dyadicGridCell S.G c.1 c.2)) := by
    refine (h.memLp.restrict (dyadicGridCell S.G c.1 c.2)).ae_eq ?_
    filter_upwards [ae_restrict_mem (dyadicGridCell_measurable _ _ _)] with y hy
    exact Set.indicator_of_mem (hcJ hy) _
  exact (memLp_normalized_of_cell h1).eLpNorm_ne_top

/-- The physical fine projections have finite normalized `L²` norm on every cell. -/
theorem AccSetup.phys_fin (S : AccSetup) (I : ℤ × ℤ) (a : ℕ → ℝ → ℂ) (n : ℕ) :
    eLpNorm (S.phys I a n) 2 (normalizedIntervalMeasure (dyadicGridLeft S.G I.1 I.2)
      (dyadicGridLength S.G I.1)) ≠ ⊤ := by
  obtain ⟨C, hC⟩ := S.phys_bound I a n
  have := cell_isFiniteMeasure S.G I.1 I.2
  exact (memLp_normalized_of_cell (MemLp.of_bound (S.phys_measurable I a n).aestronglyMeasurable
    C (Filter.Eventually.of_forall hC))).eLpNorm_ne_top

theorem LowList.val_bound {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {R : ℤ × ℤ} {c₀ : ℕ} {H : ℝ}
    (X : LowList G J N R c₀ H) (I : ℤ × ℤ) (y : ℝ) : ‖X.val I y‖ ≤ Fintype.card X.Λ := by
  unfold LowList.val
  refine (norm_sum_le _ _).trans ?_
  calc ∑ l, ‖X.coef I l * X.atom I l y‖ ≤ ∑ _l : X.Λ, (1 : ℝ) := Finset.sum_le_sum fun l _ => by
        rw [norm_mul]
        calc ‖X.coef I l‖ * ‖X.atom I l y‖ ≤ 1 * 1 :=
              mul_le_mul (X.coef_le I l) (X.atom_bound I l y) (norm_nonneg _) zero_le_one
          _ = 1 := one_mul 1
    _ = _ := by rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one]

/-- Changing the slot-`a` input of `slots4` almost everywhere on the cell does not change the
form. -/
theorem localProgressionForm_slots4_congr_a {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a i k b : Fin 4}
    (hai : a ≠ i) (hak : a ≠ k) (hab : a ≠ b) (hik : i ≠ k) (hib : i ≠ b) (hkb : k ≠ b)
    {z₁ z₂ φ φ' zb : ℝ → ℂ} (hz₁ : Measurable z₁) (hz₂ : Measurable z₂) (hφ : Measurable φ)
    (hφ' : Measurable φ') (hzb : Measurable zb)
    (hz₁f : eLpNorm z₁ 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hz₂f : eLpNorm z₂ 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hφf : eLpNorm φ 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hφ'f : eLpNorm φ' 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hzbf : eLpNorm zb 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hae : z₁ =ᵐ[normalizedIntervalMeasure a₀ r] z₂) :
    localProgressionForm r w (slots4 a i k z₁ φ φ' zb) =
      localProgressionForm r w (slots4 a i k z₂ φ φ' zb) := by
  rw [slots4_update_a z₁, slots4_update_a z₂]
  have hcov := fin_four_cover hai hak hab hik hib hkb
  have hm : ∀ l, Measurable (slots4 a i k 0 φ φ' zb l) := by
    intro l
    rcases hcov l with rfl | rfl | rfl | rfl
    · rw [slots4_a]; exact measurable_const
    · rw [slots4_i hai]; exact hφ
    · rw [slots4_k hak hik]; exact hφ'
    · simp only [slots4, hab.symm, hib.symm, hkb.symm, ↓reduceIte]; exact hzb
  have hf : ∀ l, eLpNorm (slots4 a i k 0 φ φ' zb l) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤ := by
    intro l
    rcases hcov l with rfl | rfl | rfl | rfl
    · rw [slots4_a]; simp
    · rw [slots4_i hai]; exact hφf
    · rw [slots4_k hak hik]; exact hφ'f
    · simp only [slots4, hab.symm, hib.symm, hkb.symm, ↓reduceIte]; exact hzbf
  exact localProgressionForm_update_congr_ae hr hw hm hf hai hak hab hik hib hkb hz₁ hz₂ hz₁f hz₂f
    hae

section ReplaceSlot
variable (κ : LocalKernelClass) {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {c₀ c₁ : ℕ} {H : ℝ}
  (Xi Xk : LowList G J N J c₀ H) (a i k b : Fin 4) (Bp D : ℝ)
  (pkg : ∀ (K K' : ℤ × ℤ) (li : Xi.Λ) (lk : Xk.Λ),
    PredictorPackage κ (Xi.chart K li) (Xk.chart K' lk) a i k b Bp D c₁)
  {ε : ℝ} (hε0 : 0 < ε) (hε1 : ε ≤ 1)

/-! ### The delayed replacement of one high input on an accurate-fit root -/

/-- The accurate-fit setup of the high slot `a` over the predictor system of the low lists
(blueprint prop:base, lines 1626 and 1634). -/
noncomputable def predAccSetup (K₀ M : ℕ) (f : ℝ → ℂ) (w : ℤ × ℤ → ℝ × ℝ → ℂ) (q : ℝ)
    (kk c₂ : ℕ) (Bf : ℝ) : AccSetup where
  G := G
  J := J
  N := N
  K₀ := K₀
  V₀ := Xi.Λ × Xk.Λ × Fin (⌊D⌋₊)
  P₀ := predSystem κ Xi Xk a i k b Bp D pkg hε0 hε1
  M := M
  f := f
  w := w
  e := a
  q := q
  k := kk
  c₂ := c₂
  B := Bf

/-- Blueprint prop:base, proof lines 1626-1641: on the segment of an accurate-fit root `K`, the
input in slot `a` is replaced by the delayed physical projection of the accurate-fit system, with
the absolute scale-sum error of lem:predictors and lem:delay. -/
theorem replaceSlot (hai : a ≠ i) (hak : a ≠ k) (hab : a ≠ b) (hik : i ≠ k) (hib : i ≠ b)
    (hkb : k ≠ b) (hD1 : 1 ≤ D) (K₀ M : ℕ) (f : ℝ → ℂ) (w : ℤ × ℤ → ℝ × ℝ → ℂ) (q : ℝ)
    (k' c₂ : ℕ) (Bf : ℝ)
    (h : (predAccSetup κ Xi Xk a i k b Bp D pkg hε0 hε1 K₀ M f w q k' c₂ Bf).Hyp)
    (hw : ∀ I, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)
      (w I))
    {K : ℤ × ℤ} (hKr : K ∈ (predAccSetup κ Xi Xk a i k b Bp D pkg hε0 hε1 K₀ M f w q k' c₂
      Bf).tree.roots)
    {R : ℤ × ℤ} (hR : R ∈ dyadicFiniteTree G J N) (T : Finset (ℤ × ℤ))
    (hT : ∀ I ∈ T, I ∈ dyadicFiniteTree G J
      (predAccSetup κ Xi Xk a i k b Bp D pkg hε0 hε1 K₀ M f w q k' c₂ Bf).Nc ∧
      (predAccSetup κ Xi Xk a i k b Bp D pkg hε0 hε1 K₀ M f w q k' c₂ Bf).tree.seg I = K ∧
      dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G R.1 R.2)
    {Fb : ℝ → ℂ} {zb : ℤ × ℤ → ℝ → ℂ} {Kb : ℝ} (hKb : 0 ≤ Kb)
    (hzbJ : ∀ J' ∈ dyadicFiniteTree G J N, dyadicGridCell G J'.1 J'.2 ⊆ dyadicGridCell G R.1 R.2 →
      IsAdmissibleOpponent G J' Fb zb Kb ∧ HasDepthEnergy G J' Fb zb Kb)
    (hzbm : ∀ I, Measurable (zb I))
    (hzb2 : ∀ I, MemLp (zb I) 2 (volume.restrict (dyadicGridCell G I.1 I.2)))
    (hFb : IntegrableOn (fun y => ‖Fb y‖ ^ 2) (dyadicGridCell G R.1 R.2)) :
    let S := predAccSetup κ Xi Xk a i k b Bp D pkg hε0 hε1 K₀ M f w q k' c₂ Bf
    ∑ I ∈ T, dyadicGridLength G I.1 *
      ‖localProgressionForm (dyadicGridLength G I.1) (w I)
          (slots4 a i k f (Xi.val I) (Xk.val I) (zb I)) -
        localProgressionForm (dyadicGridLength G I.1) (w I)
          (slots4 a i k (S.phys I (S.tree.st I).1 (S.tree.st I).2) (Xi.val I) (Xk.val I)
            (zb I))‖ ≤
      (Fintype.card Xi.Λ * Fintype.card Xk.Λ) *
        (2 * Real.exp (-Bp) * (2 * (compressionOneConst ((S.system K).rooted R) + K₀) + 1) * Kb +
          D ^ 2 * (delayConst κ * ((2 : ℝ)⁻¹ ^ K₀ + (1 + K₀) * Real.sqrt ε) *
            (1 + D) ^ 4 * Kb)) *
        Real.sqrt (∫ y in dyadicGridCell G R.1 R.2, ‖(S.input : ℝ → ℂ) y‖ ^ 2) *
        Real.sqrt (∫ y in dyadicGridCell G R.1 R.2, ‖Fb y‖ ^ 2) := by
  intro S
  have hth := h.treeHyp
  have hKc := hth.roots_mem hKr
  have hK : K ∈ dyadicFiniteTree G J N := AccSetup.coarse_tree h hKc
  have hcov : ∀ I li lk, (Xi.restrict R hR).coef I li ≠ 0 → (Xk.restrict R hR).coef I lk ≠ 0 →
      PredictorCover κ (S.system K) a i k b Bp D ε
        ((Xi.restrict R hR).chart ((Xi.restrict R hR).birth I li) li)
        ((Xk.restrict R hR).chart ((Xk.restrict R hR).birth I lk) lk)
        (jointBirth (Xi.restrict R hR) (Xk.restrict R hR) I li lk) := fun I li lk hci hck =>
    AccSetup.predictorCover_system S K
      (predSystem_cover_restrict κ Xi Xk a i k b Bp D pkg hε0 hε1 hD1 R hR hci hck)
  have hTsub : ∀ I ∈ T, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G K.1 K.2 ∧
      I ∈ dyadicFiniteTree G J N ∧ K.1 ≤ I.1 := by
    intro I hI
    obtain ⟨hIc, hseg, -⟩ := hT I hI
    obtain ⟨-, hIK, -, -⟩ := hth.seg_spec hIc
    rw [hseg] at hIK
    exact ⟨hIK, AccSetup.coarse_tree h hIc, dyadicGridCell_depth_le_of_subset G I K hIK⟩
  have hTb : ∀ I ∈ T, I ∈ pathBelow G J N R := fun I hI =>
    (PathColumnSystem.below_mem_iff hR I).mpr ⟨(hTsub I hI).2.1, (hT I hI).2.2⟩
  have hTK₀ : ∀ I ∈ T, I.1 + K₀ ≤ J.1 + N := by
    intro I hI
    have hm : I.1 ≤ J.1 + ((N - K₀ : ℕ) : ℤ) := ((dyadicFiniteTree_mem_iff G J I _).mp (hT I
        hI).1).2
    have h1 : K₀ ≤ N := h.K₀_le
    have h2 : ((N - K₀ : ℕ) : ℤ) = (N : ℤ) - K₀ := by push_cast [h1]; ring
    omega
  have hrep := lowDelayedReplacement κ hai hak hab hik hib hkb (Dl := D) (by linarith)
    (S.system K) hR (Xi.restrict R hR) (Xk.restrict R hR) hcov S.input K₀ T hTb hTK₀ w
    (fun I _ => hw I) hKb hzbJ hzbm hzb2 hFb
  refine le_of_eq_of_le (Finset.sum_congr rfl fun I hI => ?_) hrep
  obtain ⟨hIK, hIT, hKI⟩ := hTsub I hI
  have hr := dyadicGridLength_pos G I.1
  have hwI := hw I
  have hprob : IsProbabilityMeasure (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) := normalizedIntervalMeasure_probability _ hr
  have hvi : (Xi.restrict R hR).val I = Xi.val I := funext (Xi.restrict_val R hR (hT I hI).2.2)
  have hvk : (Xk.restrict R hR).val I = Xk.val I := funext (Xk.restrict_val R hR (hT I hI).2.2)
  symm
  erw [hvi, hvk]
  -- finiteness of the fixed slots
  have hbi := LowList.val_bound Xi I
  have hbk := LowList.val_bound Xk I
  have hXif := (MemLp.of_bound (p := 2) (Xi.val_measurable I).aestronglyMeasurable _
    (Filter.Eventually.of_forall hbi) (μ := normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1))).eLpNorm_ne_top
  have hXkf := (MemLp.of_bound (p := 2) (Xk.val_measurable I).aestronglyMeasurable _
    (Filter.Eventually.of_forall hbk) (μ := normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1))).eLpNorm_ne_top
  have hzbf := (memLp_normalized_of_cell (hzb2 I)).eLpNorm_ne_top
  -- the actual input against the `L²` class of `1_J f`
  have hinm : Measurable (S.input : ℝ → ℂ) := (Lp.stronglyMeasurable _).measurable
  have hinf : eLpNorm (S.input : ℝ → ℂ) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≠ ⊤ :=
    (memLp_normalized_of_cell ((Lp.memLp S.input).restrict _)).eLpNorm_ne_top
  have hff : eLpNorm f 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≠ ⊤ := h.f_fin hIT
  have hJ : dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2 :=
    ((dyadicFiniteTree_mem_iff G J I N).mp hIT).1
  have hin_ae : (S.input : ℝ → ℂ) =ᵐ[normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)] f := by
    refine ae_normalized_of_cell ?_
    filter_upwards [h.input_ae] with y hy hyI
    rw [hy]
    exact Set.indicator_of_mem (hJ hyI) _
  have e1 := localProgressionForm_slots4_congr_a hr hwI hai hak hab hik hib hkb hinm h.f_meas
    (Xi.val_measurable I) (Xk.val_measurable I) (hzbm I) hinf hff hXif hXkf hzbf hin_ae
  -- the delayed projection against the physical part of the fine projections
  set! a' := (fitState G M S.P S.O (I.1 - K.1).toNat I).1
  set! n' := (fitState G M S.P S.O (I.1 - K.1).toNat I).2
  have hst : S.tree.st I = (a', n') := by
    change S.tree.state (S.tree.depthIn I) I = _
    unfold GreedyTree.depthIn GreedyTree.state
    rw [(hT I hI).2.1]
    rfl
  have hdel := h.system_delayed_ae hR (hTb I hI) (hT I hI).1 hIK hKI
  have hdm : Measurable (((S.system K).family R hR).delayed S.input K₀ I) := by
    unfold ColumnDepthFamily.delayed
    have hev : Continuous fun x : ColumnHilbert S.W => x.ofLp none :=
      (continuous_apply none).comp (PiLp.continuous_ofLp 2 _)
    exact hev.measurable.comp (Lp.stronglyMeasurable _).measurable
  have hdf : eLpNorm (((S.system K).family R hR).delayed S.input K₀ I) 2
      (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)) ≠ ⊤ :=
    (memLp_normalized_of_cell (ColumnDepthFamily.memLp_coord_restrict _ _)).eLpNorm_ne_top
  have hpm := S.phys_measurable I a' n'
  have hpf : eLpNorm (S.phys I a' n') 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≠ ⊤ := S.phys_fin I a' n'
  have hdel_ae : ((S.system K).family R hR).delayed S.input K₀ I =ᵐ[normalizedIntervalMeasure
      (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)] S.phys I a' n' :=
    ae_normalized_of_cell hdel
  have e2 := localProgressionForm_slots4_congr_a hr hwI hai hak hab hik hib hkb hdm hpm
    (Xi.val_measurable I) (Xk.val_measurable I) (hzbm I) hdf hpf hXif hXkf hzbf hdel_ae
  rw [hst]
  erw [e1, e2]
  rfl

end ReplaceSlot

/-! ### Opponent algebra for the replaced tuple -/

theorem IsAdmissibleOpponent.neg {G : RealDyadicGrid} {J : ℤ × ℤ} {F : ℝ → ℂ}
    {z : ℤ × ℤ → ℝ → ℂ} {K : ℝ} (h : IsAdmissibleOpponent G J F z K) :
    IsAdmissibleOpponent G J F (fun I y => -z I y) K := by
  intro ι R hR
  refine le_trans (le_of_eq (Finset.sum_congr rfl fun i _ => ?_)) (h ι R hR)
  simp only [mul_neg, integral_neg, norm_neg]

theorem HasDepthEnergy.neg {G : RealDyadicGrid} {J : ℤ × ℤ} {F : ℝ → ℂ}
    {z : ℤ × ℤ → ℝ → ℂ} {K : ℝ} (h : HasDepthEnergy G J F z K) :
    HasDepthEnergy G J F (fun I y => -z I y) K := by
  intro s S hS
  refine le_trans (le_of_eq (Finset.sum_congr rfl fun I _ => ?_)) (h s S hS)
  simp only [norm_neg]

/-- Discarding the opponent on some cells keeps it admissible. -/
theorem IsAdmissibleOpponent.of_zero_or {G : RealDyadicGrid} {J : ℤ × ℤ} {F : ℝ → ℂ}
    {z z' : ℤ × ℤ → ℝ → ℂ} {K : ℝ} (h : IsAdmissibleOpponent G J F z K)
    (hz : ∀ I, z' I = z I ∨ z' I = 0) : IsAdmissibleOpponent G J F z' K := by
  intro ι R hR
  refine le_trans (Finset.sum_le_sum fun i _ => ?_) (h ι R hR)
  rcases hz (R.cell i) with e | e
  · rw [e]
  · rw [e]; simp

theorem HasDepthEnergy.of_zero_or {G : RealDyadicGrid} {J : ℤ × ℤ} {F : ℝ → ℂ}
    {z z' : ℤ × ℤ → ℝ → ℂ} {K : ℝ} (h : HasDepthEnergy G J F z K)
    (hz : ∀ I, z' I = z I ∨ z' I = 0) : HasDepthEnergy G J F z' K := by
  intro s S hS
  refine le_trans (Finset.sum_le_sum fun I _ => ?_) (h s S hS)
  rcases hz I with e | e
  · rw [e]
  · rw [e]; simp only [Pi.zero_apply, norm_zero]; norm_num
    exact integral_nonneg fun _ => by positivity

/-- Changing the opponent slot of `slots4` almost everywhere on the cell does not change the
form. -/
theorem localProgressionForm_slots4_congr_b {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a i k b : Fin 4}
    (hai : a ≠ i) (hak : a ≠ k) (hab : a ≠ b) (hik : i ≠ k) (hib : i ≠ b) (hkb : k ≠ b)
    {za φ φ' z₁ z₂ : ℝ → ℂ} (hza : Measurable za) (hφ : Measurable φ) (hφ' : Measurable φ')
    (hz₁ : Measurable z₁) (hz₂ : Measurable z₂)
    (hzaf : eLpNorm za 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hφf : eLpNorm φ 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hφ'f : eLpNorm φ' 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hz₁f : eLpNorm z₁ 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hz₂f : eLpNorm z₂ 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hae : z₁ =ᵐ[normalizedIntervalMeasure a₀ r] z₂) :
    localProgressionForm r w (slots4 a i k za φ φ' z₁) =
      localProgressionForm r w (slots4 a i k za φ φ' z₂) := by
  have hupd : ∀ z : ℝ → ℂ, slots4 a i k za φ φ' z = Function.update (slots4 a i k za φ φ' 0) b
      z := by
    intro z; funext l
    by_cases hl : l = b
    · subst hl; rw [Function.update_self]; simp [slots4, hab.symm, hib.symm, hkb.symm]
    · rw [Function.update_of_ne hl]
      have hcov := fin_four_cover hai hak hab hik hib hkb
      rcases hcov l with rfl | rfl | rfl | rfl
      · rw [slots4_a, slots4_a]
      · rw [slots4_i hai, slots4_i hai]
      · rw [slots4_k hak hik, slots4_k hak hik]
      · exact absurd rfl hl
  rw [hupd z₁, hupd z₂]
  have hcov := fin_four_cover hai hak hab hik hib hkb
  have hm : ∀ l, Measurable (slots4 a i k za φ φ' 0 l) := by
    intro l
    rcases hcov l with rfl | rfl | rfl | rfl
    · rw [slots4_a]; exact hza
    · rw [slots4_i hai]; exact hφ
    · rw [slots4_k hak hik]; exact hφ'
    · simp only [slots4, hab.symm, hib.symm, hkb.symm, ↓reduceIte]; exact measurable_const
  have hf : ∀ l, eLpNorm (slots4 a i k za φ φ' 0 l) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤ := by
    intro l
    rcases hcov l with rfl | rfl | rfl | rfl
    · rw [slots4_a]; exact hzaf
    · rw [slots4_i hai]; exact hφf
    · rw [slots4_k hak hik]; exact hφ'f
    · simp only [slots4, hab.symm, hib.symm, hkb.symm, ↓reduceIte]; simp
  exact localProgressionForm_update_congr_ae hr hw hm hf hab.symm hib.symm hkb.symm hai hak hik
    hz₁ hz₂ hz₁f hz₂f hae

/-- Linearity in slot `a`: subtracting a common term. -/
theorem localProgressionForm_slots4_sub_common {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) {a i k b : Fin 4}
    (hai : a ≠ i) (hak : a ≠ k) (hab : a ≠ b) (hik : i ≠ k) (hib : i ≠ b) (hkb : k ≠ b)
    {u v c φ φ' zb : ℝ → ℂ} (hu : Measurable u) (hv : Measurable v) (hc : Measurable c)
    (hφ : Measurable φ) (hφ' : Measurable φ') (hzb : Measurable zb)
    (huf : eLpNorm u 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hvf : eLpNorm v 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hcf : eLpNorm c 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hφf : eLpNorm φ 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hφ'f : eLpNorm φ' 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hzbf : eLpNorm zb 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤) :
    localProgressionForm r w (slots4 a i k (u - c) φ φ' zb) -
        localProgressionForm r w (slots4 a i k (v - c) φ φ' zb) =
      localProgressionForm r w (slots4 a i k u φ φ' zb) -
        localProgressionForm r w (slots4 a i k v φ φ' zb) := by
  have hcov := fin_four_cover hai hak hab hik hib hkb
  have hm : ∀ l, Measurable (slots4 a i k 0 φ φ' zb l) := by
    intro l
    rcases hcov l with rfl | rfl | rfl | rfl
    · rw [slots4_a]; exact measurable_const
    · rw [slots4_i hai]; exact hφ
    · rw [slots4_k hak hik]; exact hφ'
    · simp only [slots4, hab.symm, hib.symm, hkb.symm, ↓reduceIte]; exact hzb
  have hf : ∀ l, eLpNorm (slots4 a i k 0 φ φ' zb l) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤ := by
    intro l
    rcases hcov l with rfl | rfl | rfl | rfl
    · rw [slots4_a]; simp
    · rw [slots4_i hai]; exact hφf
    · rw [slots4_k hak hik]; exact hφ'f
    · simp only [slots4, hab.symm, hib.symm, hkb.symm, ↓reduceIte]; exact hzbf
  rw [slots4_update_a (u - c), slots4_update_a (v - c), slots4_update_a u, slots4_update_a v,
    localProgressionForm_update_sub hr hw hm hf a hu hc huf hcf,
    localProgressionForm_update_sub hr hw hm hf a hv hc hvf hcf]
  ring

theorem compressionOneConst_rooted {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {V : Type}
    [Fintype V] (P : PathColumnSystem G J N V) (R R' : ℤ × ℤ) :
    compressionOneConst (P.rooted R) = compressionOneConst (P.rooted R') := rfl

theorem HasDepthEnergy.congr_cell {G : RealDyadicGrid} {J : ℤ × ℤ} {F : ℝ → ℂ}
    {z z' : ℤ × ℤ → ℝ → ℂ} {K : ℝ} (h : HasDepthEnergy G J F z K)
    (hz : ∀ I : ℤ × ℤ, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2 →
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 → z' I y = z I y) :
    HasDepthEnergy G J F z' K := by
  intro s S hS
  refine le_trans (le_of_eq (Finset.sum_congr rfl fun I hI => ?_)) (h s S hS)
  refine integral_congr_ae ?_
  rw [Filter.EventuallyEq, ae_restrict_iff' (dyadicGridCell_measurable _ _ _)]
  filter_upwards [hz I (hS I hI).2] with y hy hyI
  rw [hy hyI]

/-- The delayed projection of a path-uniform column system, discarded on cells too deep for the
delay, is an admissible opponent with depth energy one on every tree cell below the root of its
family (blueprint lem:delay, sequential replacement). -/
theorem PathColumnSystem.delayed_opponent {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {V : Type}
    [Fintype V] (P : PathColumnSystem G J N V) {R : ℤ × ℤ} (hR : R ∈ dyadicFiniteTree G J N)
    (f : Lp ℂ 2 (volume : Measure ℝ)) (K₀ : ℕ) :
    let z : ℤ × ℤ → ℝ → ℂ := fun I =>
      if I.1 + K₀ ≤ J.1 + N then (P.family R hR).delayed f K₀ I else 0
    (∀ I, Measurable (z I) ∧ MemLp (z I) 2 (volume.restrict (dyadicGridCell G I.1 I.2))) ∧
    ∀ J' ∈ dyadicFiniteTree G J N, dyadicGridCell G J'.1 J'.2 ⊆ dyadicGridCell G R.1 R.2 →
      IsAdmissibleOpponent G J' (f : ℝ → ℂ) z
          (2 * (compressionOneConst (P.rooted R) + K₀)) ∧
        HasDepthEnergy G J' (f : ℝ → ℂ) z 1 := by
  intro z
  classical
  refine ⟨fun I => ⟨?_, ?_⟩, fun J' hJ' hJ'R => ?_⟩
  · simp only [z]
    split_ifs
    · unfold ColumnDepthFamily.delayed
      have hev : Continuous fun x : ColumnHilbert V => x.ofLp none :=
        (continuous_apply none).comp (PiLp.continuous_ofLp 2 _)
      exact hev.measurable.comp (Lp.stronglyMeasurable _).measurable
    · exact measurable_const
  · simp only [z]
    split_ifs
    · exact ColumnDepthFamily.memLp_coord_restrict _ _
    · exact MemLp.zero
  · set Ψ' := P.family J' hJ'
    set z₁ : ℤ × ℤ → ℝ → ℂ := fun I => if I.1 + K₀ ≤ J.1 + N then Ψ'.delayed f K₀ I else 0
      with hz₁
    have hzero : ∀ I, z₁ I = Ψ'.delayed f K₀ I ∨ z₁ I = 0 := fun I => by
      simp only [hz₁]; split_ifs
      · exact Or.inl rfl
      · exact Or.inr rfl
    have hcongr : ∀ I : ℤ × ℤ, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J'.1 J'.2 →
        ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 → z I y = z₁ I y := by
      intro I hI
      by_cases hdeep : I.1 + K₀ ≤ J.1 + N
      · have hIT : I ∈ dyadicFiniteTree G J N := by
          refine (dyadicFiniteTree_mem_iff G J I N).mpr ⟨hI.trans ?_, by omega⟩
          exact ((dyadicFiniteTree_mem_iff G J J' N).mp hJ').1
        have hIR : I ∈ pathBelow G J N R :=
          (PathColumnSystem.below_mem_iff hR I).mpr ⟨hIT, hI.trans hJ'R⟩
        have hIJ' : I ∈ pathBelow G J N J' :=
          (PathColumnSystem.below_mem_iff hJ' I).mpr ⟨hIT, hI⟩
        filter_upwards [P.delayed_ae hR hJ' f K₀ hIR hIJ' hdeep] with y hy hyI
        simp only [z, hz₁, hdeep, ↓reduceIte]
        exact hy hyI
      · exact Filter.Eventually.of_forall fun y _ => by simp only [z, hz₁, hdeep, ↓reduceIte]
    have hadm := ((Ψ'.delayed_admissible f K₀).of_zero_or hzero).congr_cell hcongr
    have hen := ((Ψ'.delayed_depthEnergy f K₀).of_zero_or hzero).congr_cell hcongr
    exact ⟨by rw [compressionOneConst_rooted P R J']; exact hadm, hen⟩


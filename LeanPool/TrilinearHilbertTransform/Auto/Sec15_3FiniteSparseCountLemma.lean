        simp only [rd]; push_cast; ring
      rw [e]
      refine (abs_sub _ _).trans ?_
      rw [abs_mul, abs_of_pos hh]
      have : |(h * gridLabel h (x i) - x i) - (h * gridLabel h (x' i) - x' i) +

/-! ### The finite sparse-count lemma (lem:sparse-count, blueprint lines 2587-2705) -/

/-- Blueprint lines 2668-2674 (minimal-growth iteration): if `X` minimizes `|X' + B|/|X'|` among
its nonempty subsets, then `|X + mB| ≤ (|X + B|/|X|)^m |X|` for the `m`-fold sumset (from the
Plünnecke–Petridis inequality). -/
theorem minimal_growth_iteration (X B : Finset G)
    (hmin : ∀ X' ⊆ X, (X + B).card * X'.card ≤ (X' + B).card * X.card) (m : ℕ) :
    ((X + m • B).card : ℚ) ≤ ((X + B).card / X.card : ℚ) ^ m * X.card := by
  obtain rfl | hX := X.eq_empty_or_nonempty
  · simp
  have hX0 : (0 : ℚ) < X.card := by exact_mod_cast hX.card_pos
  have hXne : (X.card : ℚ) ≠ 0 := hX0.ne'
  induction m with
  | zero => simp
  | succ n ih =>
    refine le_of_mul_le_mul_right ?_ hX0
    have hpp := Finset.pluennecke_petridis_inequality_add (n • B) hmin
    calc ((X + (n + 1) • B).card : ℚ) * X.card = ((n • B + X + B).card : ℚ) * X.card := by
          rw [succ_nsmul, add_comm (n • B) X, add_assoc]
      _ ≤ (X + B).card * (n • B + X).card := by exact_mod_cast hpp
      _ ≤ (X + B).card * (((X + B).card / X.card : ℚ) ^ n * X.card) := by
          rw [add_comm (n • B) X]; gcongr
      _ = ((X + B).card / X.card : ℚ) ^ (n + 1) * X.card * X.card := by
          rw [div_pow, div_pow, pow_succ, pow_succ]
          field_simp

end SparseCount

/-- Blueprint `eq:count-balance` (lines 2700-2703): with `J₀ ≤ 3Lτ^{-2}`, `η = τ³/L`, `L ≥ 1`,
`ℓ ≥ 1` and `τ > 0`, `J₀ τ³ + √L τ + ℓ L J₀⁴ η^{-7} τ^{30} ≤ 85 ℓ L^{12} τ`. -/
theorem count_balance_bound {J₀ L ℓ τ : ℝ} (hL : 1 ≤ L) (hℓ : 1 ≤ ℓ) (hτ : 0 < τ)
    (hJ0 : 0 ≤ J₀) (hJ : J₀ ≤ 3 * L * τ⁻¹ ^ 2) :
    J₀ * τ ^ 3 + Real.sqrt L * τ + ℓ * L * J₀ ^ 4 * (τ ^ 3 / L)⁻¹ ^ 7 * τ ^ 30 ≤
      85 * ℓ * L ^ 12 * τ := by
  have hL0 : 0 < L := by linarith only [hL]
  have hJτ : J₀ * τ ^ 2 ≤ 3 * L := by
    calc J₀ * τ ^ 2 ≤ 3 * L * τ⁻¹ ^ 2 * τ ^ 2 := by gcongr
      _ = 3 * L := by field_simp
  have hL12 : L ≤ L ^ 12 := le_self_pow₀ hL (by norm_num)
  have hLl : L ≤ ℓ * L ^ 12 := by nlinarith
  have h1 : J₀ * τ ^ 3 ≤ 3 * (ℓ * L ^ 12 * τ) := by
    have : J₀ * τ ^ 3 ≤ 3 * L * τ := by nlinarith
    nlinarith [mul_le_mul_of_nonneg_right hLl hτ.le]
  have h2 : Real.sqrt L * τ ≤ ℓ * L ^ 12 * τ := by
    have hs : Real.sqrt L ≤ L := by
      rw [Real.sqrt_le_left hL0.le]; nlinarith
    exact mul_le_mul_of_nonneg_right (hs.trans hLl) hτ.le
  have h3 : ℓ * L * J₀ ^ 4 * (τ ^ 3 / L)⁻¹ ^ 7 * τ ^ 30 ≤ 81 * ℓ * L ^ 12 * τ := by
    have hJ4 : J₀ ^ 4 * τ ^ 8 ≤ 81 * L ^ 4 := by
      have := pow_le_pow_left₀ (by positivity) hJτ 4
      calc J₀ ^ 4 * τ ^ 8 = (J₀ * τ ^ 2) ^ 4 := by ring
        _ ≤ (3 * L) ^ 4 := this
        _ = 81 * L ^ 4 := by ring
    have e : ℓ * L * J₀ ^ 4 * (τ ^ 3 / L)⁻¹ ^ 7 * τ ^ 30 =
        ℓ * L ^ 8 * τ * (J₀ ^ 4 * τ ^ 8) := by
      field_simp
    rw [e]
    calc ℓ * L ^ 8 * τ * (J₀ ^ 4 * τ ^ 8) ≤ ℓ * L ^ 8 * τ * (81 * L ^ 4) := by
          gcongr
      _ = 81 * ℓ * L ^ 12 * τ := by ring
  linarith


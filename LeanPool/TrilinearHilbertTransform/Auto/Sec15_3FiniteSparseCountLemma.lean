/-- Blueprint line 2609: for a proper edge coloring, the four-step paths between fixed endpoints
have distinct ordered color sequences. -/
theorem bipFourPaths_colors_injOn {C : Type*} (P : Finset X) (Q : Finset Y)
    (E : Finset (X × Y)) (col : X × Y → C)
    (hpx : ∀ x y y', (x, y) ∈ E → (x, y') ∈ E → col (x, y) = col (x, y') → y = y')
    (hpy : ∀ x x' y, (x, y) ∈ E → (x', y) ∈ E → col (x, y) = col (x', y) → x = x')
    (a a' : X) :
    Set.InjOn (fun p : Y × X × Y => (col (a, p.1), col (p.2.1, p.1), col (p.2.1, p.2.2),
      col (a', p.2.2))) (bipFourPaths P Q E a a') := by
  rintro ⟨y₁, x, y₂⟩ hp ⟨z₁, w, z₂⟩ hq h
  simp only [bipFourPaths, Finset.coe_filter, Finset.mem_product, Set.mem_ofPred_eq] at hp hq
  simp only [Prod.mk.injEq] at h
  obtain ⟨h1, h2, h3, h4⟩ := h
  have e1 : y₁ = z₁ := hpx a y₁ z₁ hp.2.1 hq.2.1 h1
  subst e1
  have e2 : x = w := hpy x w y₁ hp.2.2.1 hq.2.2.1 h2
  subst e2
  have e3 : y₂ = z₂ := hpx x y₂ z₂ hp.2.2.2.1 hq.2.2.2.1 h3
  subst e3
  rfl

end FourPaths

section DifferenceCovers
open Pointwise

/-! ### Difference covers and shift boxes (lem:sparse-count, blueprint lines 2618-2626) -/

/-- Blueprint lines 2622-2624 (packing by color sequences): if every pair `(a, a')` of `B₀` has
at least `κ` witness sequences `c ∈ W a a' ⊆ Cs` with `a - a' - q c ∈ U₁`, and `U₁ - U₁ ⊆ U₂`
with `U₂` symmetric, then `B₀ - B₀` is covered by translates `p + U₂` of at most `|Cs|/κ`
packed differences. -/
theorem difference_cover_of_sequences {G C : Type*} [AddCommGroup G] [DecidableEq G]
    (B₀ : Finset G) (Cs : Finset C) (W : G → G → Finset C)
    (hW : ∀ a ∈ B₀, ∀ a' ∈ B₀, W a a' ⊆ Cs) {κ : ℕ}
    (hκ : ∀ a ∈ B₀, ∀ a' ∈ B₀, κ ≤ (W a a').card) (q : C → G) (U₁ U₂ : Finset G)
    (hq : ∀ a ∈ B₀, ∀ a' ∈ B₀, ∀ c ∈ W a a', a - a' - q c ∈ U₁)
    (hU : ∀ u ∈ U₁, ∀ v ∈ U₁, u - v ∈ U₂) (hneg : ∀ u ∈ U₂, -u ∈ U₂) (h0 : (0 : G) ∈ U₂) :
    ∃ P ⊆ B₀ - B₀, P.card * κ ≤ Cs.card ∧ ∀ x ∈ B₀ - B₀, ∃ p ∈ P, x - p ∈ U₂ := by
  classical
  set F := (B₀ - B₀).powerset.filter
    (fun P => ∀ p ∈ P, ∀ p' ∈ P, p ≠ p' → p - p' ∉ U₂)
  have hF : F.Nonempty := ⟨∅, Finset.mem_filter.mpr ⟨Finset.empty_mem_powerset _, by simp⟩⟩
  obtain ⟨P, hPF, hPmax⟩ := F.exists_max_image Finset.card hF
  obtain ⟨hPsub, hPpack⟩ := Finset.mem_filter.mp hPF
  have hPsub' := Finset.mem_powerset.mp hPsub
  refine ⟨P, hPsub', ?_, ?_⟩
  · -- counting color sequences
    have hend : ∀ p ∈ P, ∃ a ∈ B₀, ∃ a' ∈ B₀, a - a' = p := fun p hp =>
      Finset.mem_sub.mp (hPsub' hp)
    choose! ea hea ea' hea' heq using hend
    set! V := fun p => W (ea p) (ea' p)
    have hdisj : (P : Set G).PairwiseDisjoint V := by
      intro p hp p' hp' hne
      refine Finset.disjoint_left.mpr fun c hc hc' => ?_
      have h1 := hq _ (hea p hp) _ (hea' p hp) c hc
      have h2 := hq _ (hea p' hp') _ (hea' p' hp') c hc'
      rw [heq p hp] at h1; rw [heq p' hp'] at h2
      have := hU _ h1 _ h2
      rw [sub_sub_sub_cancel_right] at this
      exact hPpack p hp p' hp' hne this
    have hsum : ∑ p ∈ P, (V p).card ≤ Cs.card := by
      rw [← Finset.card_biUnion hdisj]
      exact Finset.card_le_card (Finset.biUnion_subset.mpr fun p hp =>
        hW _ (hea p hp) _ (hea' p hp))
    calc P.card * κ = ∑ _p ∈ P, κ := by rw [Finset.sum_const, smul_eq_mul]
      _ ≤ ∑ p ∈ P, (V p).card := Finset.sum_le_sum fun p hp => hκ _ (hea p hp) _ (hea' p hp)
      _ ≤ _ := hsum
  · -- maximality gives a cover
    intro x hx
    by_contra hcon
    push Not at hcon
    have hxP : x ∉ P := fun h => hcon x h (by simpa using h0)
    have hins : insert x P ∈ F := by
      refine Finset.mem_filter.mpr ⟨Finset.mem_powerset.mpr
        (Finset.insert_subset hx hPsub'), ?_⟩
      intro p hp p' hp' hne
      rcases Finset.mem_insert.mp hp with hpx | hpP <;>
        rcases Finset.mem_insert.mp hp' with hpx' | hpP'
      · exact absurd (hpx.trans hpx'.symm) hne
      · rw [hpx]; exact hcon p' hpP'
      · rw [hpx']
        intro h
        have := hneg _ h
        rw [neg_sub] at this
        exact hcon p hpP this
      · exact hPpack p hpP p' hpP' hne
    have := hPmax _ hins
    rw [Finset.card_insert_of_notMem hxP] at this
    omega

end DifferenceCovers

/-- The pure shift `n · ζ` of an integer index vector. -/
def shiftDot {d : ℕ} (n ζ : Fin d → ℤ) : ℤ := ∑ k, n k * ζ k

theorem shiftDot_add {d : ℕ} (n m ζ : Fin d → ℤ) :
    shiftDot (n + m) ζ = shiftDot n ζ + shiftDot m ζ := by
  simp only [shiftDot, Pi.add_apply, add_mul, Finset.sum_add_distrib]

theorem shiftDot_neg {d : ℕ} (n ζ : Fin d → ℤ) : shiftDot (-n) ζ = -shiftDot n ζ := by
  simp only [shiftDot, Pi.neg_apply, neg_mul, Finset.sum_neg_distrib]

theorem shiftDot_smul {d : ℕ} (c : ℤ) (n ζ : Fin d → ℤ) :
    shiftDot (c • n) ζ = c * shiftDot n ζ := by
  simp only [shiftDot, Pi.smul_apply, smul_eq_mul, mul_assoc, Finset.mul_sum]

/-- Blueprint line 2620: the shift box
`U(t) = {6 n · ζ + u : |n|_∞ ≤ t N, u ∈ ℤ, |u| ≤ t ε}` (integer form after rescaling to the
grid). -/
def shiftBox {d : ℕ} (ζ : Fin d → ℤ) (N ε t : ℕ) : Finset ℤ :=
  ((Fintype.piFinset fun _ : Fin d => Finset.Icc (-((t * N : ℕ) : ℤ)) ((t * N : ℕ) : ℤ)) ×ˢ
    Finset.Icc (-((t * ε : ℕ) : ℤ)) ((t * ε : ℕ) : ℤ)).image
      fun p => 6 * shiftDot p.1 ζ + p.2

theorem mem_shiftBox {d : ℕ} {ζ : Fin d → ℤ} {N ε t : ℕ} {x : ℤ} :
    x ∈ shiftBox ζ N ε t ↔ ∃ n : Fin d → ℤ, (∀ k, |n k| ≤ ((t * N : ℕ) : ℤ)) ∧
      ∃ u : ℤ, |u| ≤ ((t * ε : ℕ) : ℤ) ∧ x = 6 * shiftDot n ζ + u := by
  simp only [shiftBox, Finset.mem_image, Finset.mem_product, Fintype.mem_piFinset,
    Finset.mem_Icc, Prod.exists, abs_le]
  constructor
  · rintro ⟨n, u, ⟨hn, hu⟩, rfl⟩
    exact ⟨n, hn, u, hu, rfl⟩
  · rintro ⟨n, hn, u, hu, rfl⟩
    exact ⟨n, u, ⟨hn, hu⟩, rfl⟩

theorem zero_mem_shiftBox {d : ℕ} (ζ : Fin d → ℤ) (N ε t : ℕ) : (0 : ℤ) ∈ shiftBox ζ N ε t :=
  mem_shiftBox.mpr ⟨0, fun _ => by simp only [Pi.zero_apply, abs_zero]; positivity, 0,
    by simp only [abs_zero]; positivity, by simp [shiftDot]⟩

theorem add_mem_shiftBox {d : ℕ} {ζ : Fin d → ℤ} {N ε t t' : ℕ} {x y : ℤ}
    (hx : x ∈ shiftBox ζ N ε t) (hy : y ∈ shiftBox ζ N ε t') :
    x + y ∈ shiftBox ζ N ε (t + t') := by
  obtain ⟨n, hn, u, hu, rfl⟩ := mem_shiftBox.mp hx
  obtain ⟨m, hm, v, hv, rfl⟩ := mem_shiftBox.mp hy
  refine mem_shiftBox.mpr ⟨n + m, fun k => ?_, u + v, ?_, ?_⟩
  · have := (abs_add_le (n k) (m k)).trans (add_le_add (hn k) (hm k))
    simp only [Pi.add_apply]; push_cast at this ⊢; linarith only [this]
  · have := (abs_add_le u v).trans (add_le_add hu hv)
    push_cast at this ⊢; linarith
  · rw [shiftDot_add]; ring

theorem neg_mem_shiftBox {d : ℕ} {ζ : Fin d → ℤ} {N ε t : ℕ} {x : ℤ}
    (hx : x ∈ shiftBox ζ N ε t) : -x ∈ shiftBox ζ N ε t := by
  obtain ⟨n, hn, u, hu, rfl⟩ := mem_shiftBox.mp hx
  refine mem_shiftBox.mpr ⟨-n, fun k => by simpa using hn k, -u, by simpa using hu, ?_⟩
  rw [shiftDot_neg]; ring

theorem sub_mem_shiftBox {d : ℕ} {ζ : Fin d → ℤ} {N ε t t' : ℕ} {x y : ℤ}
    (hx : x ∈ shiftBox ζ N ε t) (hy : y ∈ shiftBox ζ N ε t') :
    x - y ∈ shiftBox ζ N ε (t + t') := by
  rw [sub_eq_add_neg]; exact add_mem_shiftBox hx (neg_mem_shiftBox hy)

theorem shiftBox_mono {d : ℕ} (ζ : Fin d → ℤ) (N ε : ℕ) {t t' : ℕ} (h : t ≤ t') :
    shiftBox ζ N ε t ⊆ shiftBox ζ N ε t' := by
  intro x hx
  obtain ⟨n, hn, u, hu, rfl⟩ := mem_shiftBox.mp hx
  refine mem_shiftBox.mpr ⟨n, fun k => (hn k).trans ?_, u, hu.trans ?_, rfl⟩
  · exact_mod_cast Nat.mul_le_mul_right N h
  · exact_mod_cast Nat.mul_le_mul_right ε h

/-- Integer division with a bounded quotient: `|n| ≤ tN` gives `|j| ≤ t` and `|n - jN| ≤ N`. -/
theorem exists_coarse_index {n : ℤ} {N t : ℕ} (h : |n| ≤ ((t * N : ℕ) : ℤ)) :
    ∃ j : ℤ, |j| ≤ t ∧ |n - j * N| ≤ N := by
  rcases Nat.eq_zero_or_pos N with hN | hN
  · subst hN
    simp only [mul_zero, Nat.cast_zero, abs_nonpos_iff] at h
    exact ⟨0, by simp, by simp [h]⟩
  · have hN' : (0 : ℤ) < N := by exact_mod_cast hN
    refine ⟨n / N, ?_, ?_⟩
    · have hdm := Int.mul_ediv_add_emod n N
      have hr0 := Int.emod_nonneg n hN'.ne'
      have hr1 := Int.emod_lt_of_pos n hN'
      push_cast at h
      rw [abs_le] at h ⊢
      constructor
      · by_contra hc
        push Not at hc
        have : n / N ≤ -(t : ℤ) - 1 := by omega
        nlinarith
      · by_contra hc
        push Not at hc
        have : (t : ℤ) + 1 ≤ n / N := by omega
        nlinarith
    · have hdm := Int.mul_ediv_add_emod n N
      have hr0 := Int.emod_nonneg n hN'.ne'
      have hr1 := Int.emod_lt_of_pos n hN'
      rw [abs_le]
      constructor <;> nlinarith

open Pointwise in
/-- Blueprint line 2650: `U(t)` is covered by `(2t + 1)^{d+1}` translates of `U(1)`. -/
theorem card_shiftBox_le {d : ℕ} (ζ : Fin d → ℤ) (N ε t : ℕ) :
    (shiftBox ζ N ε t).card ≤ (2 * t + 1) ^ (d + 1) * (shiftBox ζ N ε 1).card := by
  obtain ⟨T, hTdef⟩ : ∃ T : Finset ℤ, T =
      ((Fintype.piFinset fun _ : Fin d => Finset.Icc (-(t : ℤ)) t) ×ˢ
        Finset.Icc (-(t : ℤ)) t).image
          fun p => 6 * shiftDot (fun k => p.1 k * N) ζ + p.2 * ε := ⟨_, rfl⟩
  have hT : T.card ≤ (2 * t + 1) ^ (d + 1) := by
    rw [hTdef]
    refine Finset.card_image_le.trans (le_of_eq ?_)
    rw [Finset.card_product, Fintype.card_piFinset, Finset.prod_const, Finset.card_univ,
      Fintype.card_fin, Int.card_Icc, pow_succ]
    congr 2 <;> omega
  have hsub : shiftBox ζ N ε t ⊆ T + shiftBox ζ N ε 1 := by
    intro x hx
    obtain ⟨n, hn, u, hu, rfl⟩ := mem_shiftBox.mp hx
    choose j hj hjn using fun k => exists_coarse_index (hn k)
    obtain ⟨j', hj', hj'u⟩ := exists_coarse_index hu
    have hmemT : 6 * shiftDot (fun k => j k * N) ζ + j' * ε ∈ T := by
      rw [hTdef, Finset.mem_image]
      refine ⟨(j, j'), ?_, rfl⟩
      rw [Finset.mem_product, Fintype.mem_piFinset]
      exact ⟨fun k => Finset.mem_Icc.mpr (abs_le.mp (hj k)), Finset.mem_Icc.mpr (abs_le.mp hj')⟩
    have hmemU : 6 * shiftDot (fun k => n k - j k * N) ζ + (u - j' * ε) ∈
        shiftBox ζ N ε 1 :=
      (mem_shiftBox (N := N) (ε := ε) (t := 1)).mpr ⟨fun k => n k - j k * N,
        fun k => by simpa using hjn k, u - j' * ε, by simpa using hj'u, rfl⟩
    have heq : 6 * shiftDot n ζ + u = (6 * shiftDot (fun k => j k * N) ζ + j' * ε) +
        (6 * shiftDot (fun k => n k - j k * N) ζ + (u - j' * ε)) := by
      have h1 : shiftDot (fun k => n k - j k * N) ζ =
          shiftDot n ζ - shiftDot (fun k => j k * N) ζ := by
        simp only [shiftDot, sub_mul, Finset.sum_sub_distrib]
      rw [h1]; ring
    rw [heq]
    exact Finset.add_mem_add hmemT hmemU
  calc (shiftBox ζ N ε t).card ≤ (T + shiftBox ζ N ε 1).card := Finset.card_le_card hsub
    _ ≤ T.card * (shiftBox ζ N ε 1).card := Finset.card_add_le
    _ ≤ _ := Nat.mul_le_mul_right _ hT

/-- `(2000 D² + 3)^{3D} < 2^{500 D²}` for `D ≥ 1`. -/
theorem small_growth_numeric {D : ℕ} (hD : 1 ≤ D) :
    (2000 * D ^ 2 + 3) ^ (3 * D) < 2 ^ (500 * D ^ 2) := by
  have h1 : D < 2 ^ D := Nat.lt_two_pow_self
  have h2 : D ^ 2 ≤ 2 ^ (2 * D) := by
    rw [pow_mul, show (2 : ℕ) ^ 2 = 4 by norm_num]
    calc D ^ 2 ≤ (2 ^ D) ^ 2 := Nat.pow_le_pow_left h1.le 2
      _ = 4 ^ D := by rw [← pow_mul, mul_comm, pow_mul]; norm_num
  have h3 : 2000 * D ^ 2 + 3 ≤ 2 ^ (11 + 2 * D) := by
    rw [pow_add]
    have : 1 ≤ D ^ 2 := Nat.one_le_pow _ _ hD
    nlinarith
  calc (2000 * D ^ 2 + 3) ^ (3 * D) ≤ (2 ^ (11 + 2 * D)) ^ (3 * D) := Nat.pow_le_pow_left h3 _
    _ = 2 ^ ((11 + 2 * D) * (3 * D)) := by rw [← pow_mul]
    _ < 2 ^ (500 * D ^ 2) := by
        apply Nat.pow_lt_pow_right (by norm_num)
        nlinarith

/-- Blueprint lines 2650-2651 (one small-growth scale): three increasing families of finite
sets with `|U_i(t)| ≤ (2t+1)^D |U_i(1)|` and `U_i(1)` nonempty have a common odd scale
`H = 2k + 1 ≤ 1000 D²` with `|U_i(H + 2)| ≤ 2 |U_i(H)|` for all three. -/
theorem exists_small_growth_scale {α : Type*} (U : Fin 3 → ℕ → Finset α) {D : ℕ} (hD : 1 ≤ D)
    (hmono : ∀ i t t', t ≤ t' → U i t ⊆ U i t') (hne : ∀ i, (U i 1).Nonempty)
    (hcard : ∀ i t, (U i t).card ≤ (2 * t + 1) ^ D * (U i 1).card) :
    ∃ k : ℕ, 2 * k + 1 ≤ 1000 * D ^ 2 ∧
      ∀ i, (U i (2 * k + 3)).card ≤ 2 * (U i (2 * k + 1)).card := by
  by_contra hcon
  push Not at hcon
  set f : ℕ → ℕ := fun t => ∏ i, (U i t).card
  have hstep : ∀ k, 2 * k + 1 ≤ 1000 * D ^ 2 → 2 * f (2 * k + 1) ≤ f (2 * k + 3) := by
    intro k hk
    obtain ⟨i, hi⟩ := hcon k hk
    simp only [f]
    rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ i),
      ← Finset.mul_prod_erase _ (fun i => (U i (2 * k + 3)).card) (Finset.mem_univ i), ← mul_assoc]
    exact Nat.mul_le_mul hi.le (Finset.prod_le_prod fun j _ =>
      Finset.card_le_card (hmono j _ _ (by omega)))
  have hiter : ∀ k, k ≤ 500 * D ^ 2 → 2 ^ k * f 1 ≤ f (2 * k + 1) := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      intro hk
      have := hstep k (by nlinarith)
      calc 2 ^ (k + 1) * f 1 = 2 * (2 ^ k * f 1) := by ring
        _ ≤ 2 * f (2 * k + 1) := Nat.mul_le_mul_left _ (ih (by omega))
        _ ≤ f (2 * k + 3) := this
        _ = f (2 * (k + 1) + 1) := by ring_nf
  have hf1 : 0 < f 1 := Finset.prod_pos fun i _ => (hne i).card_pos
  have hupper : f (2 * (500 * D ^ 2) + 1) ≤ (2000 * D ^ 2 + 3) ^ (3 * D) * f 1 := by
    simp only [f]
    calc ∏ i, (U i (2 * (500 * D ^ 2) + 1)).card
        ≤ ∏ i : Fin 3, ((2 * (2 * (500 * D ^ 2) + 1) + 1) ^ D * (U i 1).card) :=
          Finset.prod_le_prod fun i _ => hcard i _
      _ = (2000 * D ^ 2 + 3) ^ (3 * D) * ∏ i, (U i 1).card := by
          rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
            ← pow_mul]
          congr 2 <;> ring
  have hlow := hiter _ le_rfl
  have := small_growth_numeric hD
  have : 2 ^ (500 * D ^ 2) * f 1 ≤ (2000 * D ^ 2 + 3) ^ (3 * D) * f 1 := hlow.trans hupper
  have := Nat.le_of_mul_le_mul_right this hf1
  omega

section GrowthPacking
open Pointwise
variable {G : Type*} [AddCommGroup G] [DecidableEq G]

/-! ### Packings and minimal growth (lem:sparse-count, blueprint lines 2652-2676) -/

omit [DecidableEq G] in
/-- A maximal packing of a finite set by a symmetric neighborhood `U ∋ 0` is a cover. -/
theorem exists_packing_cover (S U : Finset G) (h0 : (0 : G) ∈ U) (hneg : ∀ x ∈ U, -x ∈ U) :
    ∃ P ⊆ S, (∀ p ∈ P, ∀ p' ∈ P, p - p' ∈ U → p = p') ∧ ∀ x ∈ S, ∃ p ∈ P, x - p ∈ U := by
  classical
  set F := S.powerset.filter (fun P => ∀ p ∈ P, ∀ p' ∈ P, p - p' ∈ U → p = p')
  have hF : F.Nonempty := ⟨∅, Finset.mem_filter.mpr ⟨Finset.empty_mem_powerset _, by simp⟩⟩
  obtain ⟨P, hPF, hPmax⟩ := F.exists_max_image Finset.card hF
  obtain ⟨hPsub, hPpack⟩ := Finset.mem_filter.mp hPF
  refine ⟨P, Finset.mem_powerset.mp hPsub, hPpack, fun x hx => ?_⟩
  by_contra hcon
  push Not at hcon
  have hxP : x ∉ P := fun h => hcon x h (by simpa using h0)
  have hins : insert x P ∈ F := by
    refine Finset.mem_filter.mpr ⟨Finset.mem_powerset.mpr
      (Finset.insert_subset hx (Finset.mem_powerset.mp hPsub)), ?_⟩
    intro p hp p' hp' hpp
    rcases Finset.mem_insert.mp hp with hpx | hpP <;>
      rcases Finset.mem_insert.mp hp' with hpx' | hpP'
    · exact hpx.trans hpx'.symm
    · rw [hpx] at hpp; exact absurd hpp (hcon p' hpP')
    · rw [hpx'] at hpp
      have := hneg _ hpp
      rw [neg_sub] at this
      exact absurd this (hcon p hpP)
    · exact hPpack p hpP p' hpP' hpp
  have := hPmax _ hins
  rw [Finset.card_insert_of_notMem hxP] at this
  omega

theorem neg_mem_nsmul_neg {B : Finset G} {m : ℕ} {x : G} (hx : x ∈ m • B) :
    -x ∈ m • (-B) := by
  induction m generalizing x with
  | zero =>
    rw [zero_smul, Finset.mem_zero] at hx ⊢
    rw [hx, neg_zero]
  | succ m ih =>
    rw [succ_nsmul] at hx ⊢
    obtain ⟨y, hy, b, hb, rfl⟩ := Finset.mem_add.mp hx
    rw [neg_add]
    exact Finset.add_mem_add (ih hy) (Finset.neg_mem_neg hb)

/-- Blueprint lines 2652-2676 (one role): let `U` be an additive family of symmetric finite sets,
`B₀ ⊆ B` a nonempty anchor set whose translates by `U(H)` are disjoint, `B - B ⊆ P + U(2)`, and
`|U(H + 2)| ≤ 2|U(H)|`. Then every packing `P' ⊆ mB` with pairwise differences outside `U(2H)`
satisfies `|P'| ≤ (2|P|/|B₀|)^m |B₀|` (minimal growth of `Z = B₀ + U(H)` and one anchor
translate). -/
theorem growth_packing_bound (U : ℕ → Finset G) (hU0 : ∀ t, (0 : G) ∈ U t)
    (hadd : ∀ t t' x y, x ∈ U t → y ∈ U t' → x + y ∈ U (t + t'))
    (hneg : ∀ t x, x ∈ U t → -x ∈ U t) (B B₀ P : Finset G) (hB₀ : B₀ ⊆ B)
    (hB₀ne : B₀.Nonempty) (H : ℕ) (hsep : ∀ a ∈ B₀, ∀ a' ∈ B₀, a - a' ∈ U (H + H) → a = a')
    (hcov : ∀ a ∈ B, ∀ b ∈ B, ∃ p ∈ P, a - b - p ∈ U 2)
    (hdouble : (U (H + 2)).card ≤ 2 * (U H).card) (m : ℕ) (P' : Finset G)
    (hP' : P' ⊆ m • B) (hpack : ∀ p ∈ P', ∀ p' ∈ P', p - p' ∈ U (H + H) → p = p') :
    (P'.card : ℚ) ≤ (2 * P.card / B₀.card : ℚ) ^ m * B₀.card := by
  classical
  set Bn := -B
  set Z := B₀ + U H
  have hB₀pos : (0 : ℚ) < B₀.card := by exact_mod_cast hB₀ne.card_pos
  have hUH : (0 : ℚ) < (U H).card := by exact_mod_cast Finset.card_pos.mpr ⟨0, hU0 H⟩
  -- `|Z| = |B₀| |U(H)|`
  have hZcard : Z.card = B₀.card * (U H).card := by
    rw [← Finset.card_product]
    change (B₀ + U H).card = _
    rw [Finset.add_def]
    refine Finset.card_image_of_injOn ?_
    · intro q hq q' hq' h
      obtain ⟨ha, hu⟩ := Finset.mem_product.mp hq
      obtain ⟨ha', hu'⟩ := Finset.mem_product.mp hq'
      have h' : q.1 + q.2 = q'.1 + q'.2 := h
      have hd : q.1 - q'.1 = q'.2 + -q.2 := by
        have h2 : (q.1 - q'.1) - (q'.2 + -q.2) = (q.1 + q.2) - (q'.1 + q'.2) := by abel
        rw [h', sub_self] at h2
        exact sub_eq_zero.mp h2
      have e1 := hsep _ ha _ ha' (hd ▸ hadd _ _ _ _ hu' (hneg _ _ hu))
      exact Prod.ext e1 (by rw [e1] at h'; exact add_left_cancel h')
  -- `|Z + Bn| ≤ |P| |U(H+2)|`
  have hZB : (Z + Bn).card ≤ P.card * (U (H + 2)).card := by
    have hsub : Z + Bn ⊆ P + U (H + 2) := by
      intro x hx
      obtain ⟨z, hz, nb, hnb, rfl⟩ := Finset.mem_add.mp hx
      obtain ⟨a, ha, u, hu, rfl⟩ := Finset.mem_add.mp hz
      obtain ⟨b, hb, rfl⟩ := Finset.mem_neg.mp hnb
      obtain ⟨p, hp, hw⟩ := hcov a (hB₀ ha) b hb
      refine Finset.mem_add.mpr ⟨p, hp, (a - b - p) + u, ?_, by abel⟩
      have := hadd _ _ _ _ hw hu
      rwa [add_comm 2 H] at this
    exact (Finset.card_le_card hsub).trans Finset.card_add_le
  -- a minimizer of the growth ratio
  set F := Z.powerset.filter Finset.Nonempty
  have hZne : Z.Nonempty := Finset.Nonempty.add hB₀ne ⟨0, hU0 H⟩
  have hF : F.Nonempty := ⟨Z, Finset.mem_filter.mpr ⟨Finset.mem_powerset_self _, hZne⟩⟩
  obtain ⟨X, hXF, hXmin⟩ := F.exists_min_image
    (fun X => ((X + Bn).card : ℚ) / X.card) hF
  obtain ⟨hXZ, hXne⟩ := Finset.mem_filter.mp hXF
  have hXZ' := Finset.mem_powerset.mp hXZ
  have hXpos : (0 : ℚ) < X.card := by exact_mod_cast hXne.card_pos
  set r : ℚ := ((X + Bn).card : ℚ) / X.card
  have hr0 : 0 ≤ r := by positivity
  have hrZ : r ≤ ((Z + Bn).card : ℚ) / Z.card :=
    hXmin Z (Finset.mem_filter.mpr ⟨Finset.mem_powerset_self _, hZne⟩)
  have hr : r ≤ 2 * P.card / B₀.card := by
    refine hrZ.trans ?_
    rw [hZcard, div_le_div_iff₀ (by push_cast; positivity) hB₀pos]
    have h1 : ((Z + Bn).card : ℚ) ≤ P.card * (U (H + 2)).card := by exact_mod_cast hZB
    have h2 : ((U (H + 2)).card : ℚ) ≤ 2 * (U H).card := by exact_mod_cast hdouble
    push_cast
    calc ((Z + Bn).card : ℚ) * B₀.card ≤ P.card * (U (H + 2)).card * B₀.card := by gcongr
      _ ≤ P.card * (2 * (U H).card) * B₀.card := by gcongr
      _ = 2 * P.card * (B₀.card * (U H).card) := by ring
  have hmin : ∀ X' ⊆ X, (X + Bn).card * X'.card ≤ (X' + Bn).card * X.card := by
    intro X' hX'
    rcases X'.eq_empty_or_nonempty with rfl | hX'ne
    · simp
    · have := hXmin X' (Finset.mem_filter.mpr ⟨Finset.mem_powerset.mpr (hX'.trans hXZ'), hX'ne⟩)
      have hX'pos : (0 : ℚ) < X'.card := by exact_mod_cast hX'ne.card_pos
      rw [div_le_div_iff₀ hXpos hX'pos] at this
      exact_mod_cast this
  have hgrow := minimal_growth_iteration X Bn hmin m
  -- one anchor translate holds a `1/|B₀|` portion of `X`
  have hXcov : X ⊆ B₀.biUnion fun a => X.filter fun x => x - a ∈ U H := by
    intro x hx
    obtain ⟨a, ha, u, hu, rfl⟩ := Finset.mem_add.mp (hXZ' hx)
    exact Finset.mem_biUnion.mpr ⟨a, ha, Finset.mem_filter.mpr ⟨hx, by simpa using hu⟩⟩
  obtain ⟨a, ha, hY⟩ : ∃ a ∈ B₀, (X.card : ℚ) ≤ B₀.card * (X.filter fun x => x - a ∈ U H).card := by
    by_contra hcon
    push Not at hcon
    have h1 : (X.card : ℚ) ≤ ∑ a ∈ B₀, ((X.filter fun x => x - a ∈ U H).card : ℚ) := by
      exact_mod_cast (Finset.card_le_card hXcov).trans Finset.card_biUnion_le
    have h2 : ∑ a ∈ B₀, (B₀.card : ℚ) * ((X.filter fun x => x - a ∈ U H).card : ℚ) <
        ∑ _a ∈ B₀, (X.card : ℚ) := Finset.sum_lt_sum_of_nonempty hB₀ne hcon
    rw [← Finset.mul_sum, Finset.sum_const, nsmul_eq_mul] at h2
    nlinarith
  set Y := X.filter fun x => x - a ∈ U H
  have hYpos : (0 : ℚ) < Y.card := by
    by_contra h
    push Not at h
    nlinarith
  -- the packing injects into `X + m • Bn`
  have hinj : (P' ×ˢ Y).card ≤ (X + m • Bn).card := by
    refine Finset.card_le_card_of_injOn (fun q => q.2 + -q.1) ?_ ?_
    · intro q hq
      obtain ⟨hp, hy⟩ := Finset.mem_product.mp hq
      exact Finset.add_mem_add (Finset.mem_filter.mp hy).1 (neg_mem_nsmul_neg (hP' hp))
    · intro q hq q' hq' h
      obtain ⟨hp, hy⟩ := Finset.mem_product.mp hq
      obtain ⟨hp', hy'⟩ := Finset.mem_product.mp hq'
      have h' : q.2 + -q.1 = q'.2 + -q'.1 := h
      have hd : q.1 - q'.1 = (q.2 - a) + -(q'.2 - a) := by
        have h2 : (q.1 - q'.1) - ((q.2 - a) + -(q'.2 - a)) = (q'.2 + -q'.1) - (q.2 + -q.1) := by
          abel
        rw [← h', sub_self] at h2
        exact sub_eq_zero.mp h2
      have e1 := hpack _ hp _ hp' (hd ▸ hadd _ _ _ _ (Finset.mem_filter.mp hy).2
        (hneg _ _ (Finset.mem_filter.mp hy').2))
      refine Prod.ext e1 ?_
      rw [e1] at h'; exact add_right_cancel h'
  rw [Finset.card_product] at hinj
  have hinjQ : (P'.card : ℚ) * Y.card ≤ r ^ m * X.card := by
    have h1 : ((P'.card * Y.card : ℕ) : ℚ) ≤ ((X + m • Bn).card : ℚ) := by exact_mod_cast hinj
    push_cast at h1
    exact h1.trans hgrow
  have hrm : r ^ m ≤ (2 * P.card / B₀.card : ℚ) ^ m := pow_le_pow_left₀ hr0 hr m
  have : (P'.card : ℚ) * Y.card ≤ (2 * P.card / B₀.card : ℚ) ^ m * B₀.card * Y.card := by
    calc (P'.card : ℚ) * Y.card ≤ r ^ m * X.card := hinjQ
      _ ≤ (2 * P.card / B₀.card : ℚ) ^ m * (B₀.card * Y.card) := by
          gcongr
      _ = _ := by ring
  exact le_of_mul_le_mul_right this hYpos

end GrowthPacking

section SlabCover
open Pointwise

/-! ### The slab cover (lem:sparse-count, blueprint lines 2678-2687) -/

theorem abs_cofactor_le {α β : ℤ} (h : α * β = 6) : |β| ≤ 6 ∧ α ≠ 0 := by
  have hα : α ≠ 0 := by rintro rfl; simp at h
  refine ⟨?_, hα⟩
  have h1 : |α| * |β| = 6 := by rw [← abs_mul, h]; rfl
  have h2 : 1 ≤ |α| := Int.one_le_abs hα
  nlinarith [abs_nonneg β]

/-- Elements of a shift box with real bounds. -/
theorem mem_shiftBox_real {d : ℕ} {ζ : Fin d → ℤ} {N ε t : ℕ} {x : ℤ}
    (hx : x ∈ shiftBox ζ N ε t) : ∃ n : Fin d → ℤ, (∀ i, |(n i : ℝ)| ≤ t * N) ∧
      ∃ u : ℤ, |(u : ℝ)| ≤ t * ε ∧ x = 6 * shiftDot n ζ + u := by
  obtain ⟨n, hn, u, hu, rfl⟩ := mem_shiftBox.mp hx
  refine ⟨n, fun i => ?_, u, ?_, rfl⟩
  · have := hn i; rw [← Int.cast_abs]; exact_mod_cast this
  · rw [← Int.cast_abs]; exact_mod_cast hu

/-- Dividing a close relation `|α x - 6 k · ζ| ≤ E` by `α` (`αβ = 6`):
`|x - (β k) · ζ| ≤ E`. -/
theorem div_close {d : ℕ} {ζ : Fin d → ℤ} {α β x : ℤ} (hαβ : α * β = 6) (k : Fin d → ℤ) {E : ℝ}
    (h : |((α * x - 6 * shiftDot k ζ : ℤ) : ℝ)| ≤ E) :
    |((x - shiftDot (β • k) ζ : ℤ) : ℝ)| ≤ E := by
  have hα := (abs_cofactor_le hαβ).2
  have hid : α * x - 6 * shiftDot k ζ = α * (x - shiftDot (β • k) ζ) := by
    rw [shiftDot_smul, ← hαβ]; ring
  rw [hid, Int.cast_mul, abs_mul] at h
  have h1 : (1 : ℝ) ≤ |(α : ℝ)| := by rw [← Int.cast_abs]; exact_mod_cast Int.one_le_abs hα
  nlinarith [abs_nonneg ((x - shiftDot (β • k) ζ : ℤ) : ℝ)]

/-- Anchor separation implies disjointness of anchor translates by `U(H)`. -/
theorem anchor_sep_shiftBox {d : ℕ} {ζ : Fin d → ℤ} {N ε H : ℕ} {B₀ : Finset ℤ} {Q S : ℝ}
    (hanch : ∀ a ∈ B₀, ∀ a' ∈ B₀, ∀ k : Fin d → ℤ, (∀ i, |(k i : ℝ)| ≤ Q) →
      |((a - a' - shiftDot k ζ : ℤ) : ℝ)| ≤ S → a = a')
    (hQ : 12 * (H * N : ℝ) ≤ Q) (hS : 2 * (H * ε : ℝ) ≤ S) :
    ∀ a ∈ B₀, ∀ a' ∈ B₀, a - a' ∈ shiftBox ζ N ε (H + H) → a = a' := by
  intro a ha a' ha' h
  obtain ⟨n, hn, u, hu, hx⟩ := mem_shiftBox_real h
  refine hanch a ha a' ha' ((6 : ℤ) • n) (fun i => ?_) ?_
  · simp only [Pi.smul_apply, smul_eq_mul, Int.cast_mul, abs_mul, Int.cast_ofNat]
    have := hn i; push_cast at this; norm_num; linarith
  · rw [shiftDot_smul, show a - a' - 6 * shiftDot n ζ = u by rw [hx]; ring]
    push_cast at hu; linarith

/-- Blueprint lines 2681-2687 (local third-coordinate packing): if the pairwise differences of a
column set `Lc ⊆ 2B` satisfy `|α(x - x') - 6 k · ζ| ≤ E_c` with `|k|_∞ ≤ K_c`, and anchors are
separated, then any packing of `Lc` outside `U(2H)` has at most `(2|P|/|B₀|)³` elements: the
sums `B₀ + P₃ ⊆ 3B` form a packing with distinct sums. -/
theorem column_packing_bound {d : ℕ} (ζ : Fin d → ℤ) (N ε H : ℕ) (B B₀ P : Finset ℤ)
    (hB₀ : B₀ ⊆ B) (hB₀ne : B₀.Nonempty)
    (hcov : ∀ a ∈ B, ∀ b ∈ B, ∃ p ∈ P, a - b - p ∈ shiftBox ζ N ε 2)
    (hdouble : (shiftBox ζ N ε (H + 2)).card ≤ 2 * (shiftBox ζ N ε H).card) {Q S : ℝ}
    (hanch : ∀ a ∈ B₀, ∀ a' ∈ B₀, ∀ k : Fin d → ℤ, (∀ i, |(k i : ℝ)| ≤ Q) →
      |((a - a' - shiftDot k ζ : ℤ) : ℝ)| ≤ S → a = a')
    {α β : ℤ} (hαβ : α * β = 6) (hα : |α| ≤ 3) (Lc : Finset ℤ) (hLc : Lc ⊆ 2 • B)
    {Kc Ec : ℝ} (hclose : ∀ x ∈ Lc, ∀ x' ∈ Lc, ∃ k : Fin d → ℤ, (∀ i, |(k i : ℝ)| ≤ Kc) ∧
      |((α * (x - x') - 6 * shiftDot k ζ : ℤ) : ℝ)| ≤ Ec)
    (hQ : 6 * (Kc + 6 * (H * N : ℝ)) ≤ Q) (hQ' : 12 * (H * N : ℝ) ≤ Q)
    (hS : Ec + 6 * (H * ε : ℝ) ≤ S) (hS' : 2 * (H * ε : ℝ) ≤ S) (P₃ : Finset ℤ) (hP₃ : P₃ ⊆ Lc)
    (hpack : ∀ p ∈ P₃, ∀ p' ∈ P₃, p - p' ∈ shiftBox ζ N ε (H + H) → p = p') :
    (P₃.card : ℚ) ≤ (2 * P.card / B₀.card : ℚ) ^ 3 := by
  classical
  have hβ := (abs_cofactor_le hαβ).1
  have hsep := anchor_sep_shiftBox hanch hQ' hS'
  -- the key claim
  have hclaim : ∀ a ∈ B₀, ∀ a' ∈ B₀, ∀ p ∈ P₃, ∀ p' ∈ P₃,
      (a + p) - (a' + p') ∈ shiftBox ζ N ε (H + H) → a = a' ∧ p = p' := by
    intro a ha a' ha' p hp p' hp' hw
    obtain ⟨n, hn, u, hu, hwx⟩ := mem_shiftBox_real hw
    obtain ⟨k, hk, he⟩ := hclose p' (hP₃ hp') p (hP₃ hp)
    have haa : a = a' := by
      refine hanch a ha a' ha' (β • (α • n + k)) (fun i => ?_) ?_
      · simp only [Pi.smul_apply, Pi.add_apply, smul_eq_mul, Int.cast_mul, Int.cast_add,
          abs_mul]
        have hb : |(β : ℝ)| ≤ 6 := by rw [← Int.cast_abs]; exact_mod_cast hβ
        have ha3 : |(α : ℝ)| ≤ 3 := by rw [← Int.cast_abs]; exact_mod_cast hα
        have h1 : |(α : ℝ) * n i + k i| ≤ 3 * ((H + H : ℕ) * N) + Kc := by
          calc |(α : ℝ) * n i + k i| ≤ |(α : ℝ)| * |(n i : ℝ)| + |(k i : ℝ)| := by
                rw [← abs_mul]; exact abs_add_le _ _
            _ ≤ 3 * ((H + H : ℕ) * N) + Kc := by
                gcongr
                · exact (hn i)
                · exact hk i
        push_cast at h1 ⊢
        calc |(β : ℝ)| * |(α : ℝ) * n i + k i| ≤ 6 * (3 * ((H + H) * N) + Kc) := by
              gcongr
          _ ≤ Q := by nlinarith
      · refine div_close hαβ (α • n + k) ?_
        have hid : α * (a - a') - 6 * shiftDot (α • n + k) ζ =
            α * u + (α * (p' - p) - 6 * shiftDot k ζ) := by
          rw [shiftDot_add, shiftDot_smul]
          have : a - a' = 6 * shiftDot n ζ + u + (p' - p) := by rw [← hwx]; ring
          rw [this]; ring
        rw [hid, Int.cast_add, Int.cast_mul]
        have ha3 : |(α : ℝ)| ≤ 3 := by rw [← Int.cast_abs]; exact_mod_cast hα
        calc |(α : ℝ) * u + ((α * (p' - p) - 6 * shiftDot k ζ : ℤ) : ℝ)|
            ≤ |(α : ℝ)| * |(u : ℝ)| + Ec := by
              refine (abs_add_le _ _).trans ?_
              rw [abs_mul]; linarith
          _ ≤ 3 * ((H + H : ℕ) * ε) + Ec := by
              gcongr
          _ ≤ S := by push_cast; linarith
    subst haa
    refine ⟨rfl, hpack p hp p' hp' ?_⟩
    rwa [show a + p - (a + p') = p - p' by ring] at hw
  -- apply the growth bound to `B₀ + P₃ ⊆ 3B`
  have hsub : B₀ + P₃ ⊆ 3 • B := by
    intro x hx
    obtain ⟨a, ha, p, hp, rfl⟩ := Finset.mem_add.mp hx
    rw [show (3 : ℕ) = 2 + 1 from rfl, succ_nsmul, add_comm a p]
    exact Finset.add_mem_add (hLc (hP₃ hp)) (hB₀ ha)
  have hcard : (B₀ + P₃).card = B₀.card * P₃.card := by
    rw [← Finset.card_product, Finset.add_def]
    refine Finset.card_image_of_injOn ?_
    intro q hq q' hq' h
    obtain ⟨ha, hp⟩ := Finset.mem_product.mp hq
    obtain ⟨ha', hp'⟩ := Finset.mem_product.mp hq'
    have h' : q.1 + q.2 = q'.1 + q'.2 := h
    have := hclaim _ ha _ ha' _ hp _ hp' (by rw [h', sub_self]; exact zero_mem_shiftBox _ _ _ _)
    exact Prod.ext this.1 this.2
  have hpack' : ∀ x ∈ B₀ + P₃, ∀ x' ∈ B₀ + P₃, x - x' ∈ shiftBox ζ N ε (H + H) → x = x' := by
    intro x hx x' hx' h
    obtain ⟨a, ha, p, hp, rfl⟩ := Finset.mem_add.mp hx
    obtain ⟨a', ha', p', hp', rfl⟩ := Finset.mem_add.mp hx'
    obtain ⟨rfl, rfl⟩ := hclaim a ha a' ha' p hp p' hp' h
    rfl
  have hg := growth_packing_bound (fun t => shiftBox ζ N ε t) (fun t => zero_mem_shiftBox _ _ _ t)
    (fun t t' x y hx hy => add_mem_shiftBox hx hy) (fun t x hx => neg_mem_shiftBox hx)
    B B₀ P hB₀ hB₀ne H hsep hcov hdouble 3 (B₀ + P₃) hsub hpack'
  rw [hcard] at hg
  push_cast at hg
  have hB₀pos : (0 : ℚ) < B₀.card := by exact_mod_cast hB₀ne.card_pos
  rw [mul_comm] at hg
  exact le_of_mul_le_mul_right hg hB₀pos

end SlabCover

section TripleCount
open Pointwise

/-! ### Separation of translated triples (lem:sparse-count, blueprint lines 2689-2692) -/

theorem shiftDot_sum {d : ℕ} {κ : Type*} (s : Finset κ) (c : κ → ℤ) (k : κ → Fin d → ℤ)
    (ζ : Fin d → ℤ) : shiftDot (∑ j ∈ s, c j • k j) ζ = ∑ j ∈ s, c j * shiftDot (k j) ζ := by
  simp only [shiftDot, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_mul,
    Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun i _ => by ring

/-- The annular residual `Σ_j α_j x_j + 36 n · ζ` of a triple. -/
def tripleResidual {d : ℕ} (ζ : Fin d → ℤ) (α x : Fin 3 → ℤ) (n : Fin d → ℤ) : ℤ :=
  ∑ j, α j * x j + 36 * shiftDot n ζ

/-- Blueprint lines 2690-2692: two translated triples `x + y`, `x' + y'` whose coordinates differ
by box elements `6 k_j · ζ + w_j`, where the residual of `x` is annular at the big scale
`μR ≤ |ρ_x| ≤ νR` and all other residuals and the scalars `w_j` are small, produce a pure shift
`m · ζ` of size between `μR/50` and `50νR`; the gap hypothesis excludes it. -/
theorem translated_triples_gap {d : ℕ} (ζ : Fin d → ℤ) (α : Fin 3 → ℤ) (hα3 : ∀ j, |α j| ≤ 3)
    (x x' y y' : Fin 3 → ℤ) (nx nx' ny ny' : Fin d → ℤ) (k : Fin 3 → Fin d → ℤ) (w : Fin 3 → ℤ)
    (hdiff : ∀ j, (x j + y j) - (x' j + y' j) = 6 * shiftDot (k j) ζ + w j)
    {μ ν R e₁ e₂ Bw Kb Q : ℝ} (hR : 0 ≤ μ * R)
    (hx : μ * R ≤ |(tripleResidual ζ α x nx : ℝ)|) (hx' : |(tripleResidual ζ α x nx : ℝ)| ≤ ν * R)
    (hx'' : |(tripleResidual ζ α x' nx' : ℝ)| ≤ e₁) (hy : |(tripleResidual ζ α y ny : ℝ)| ≤ e₁)
    (hy' : |(tripleResidual ζ α y' ny' : ℝ)| ≤ e₁) (hw : ∀ j, |(w j : ℝ)| ≤ e₂)
    (herr : 3 * e₁ + 9 * e₂ ≤ μ * R / 100)
    (hn : ∀ i, |(nx i : ℝ)| ≤ Bw ∧ |(nx' i : ℝ)| ≤ Bw ∧ |(ny i : ℝ)| ≤ Bw ∧ |(ny' i : ℝ)| ≤ Bw)
    (hk : ∀ j i, |(k j i : ℝ)| ≤ Kb) (hQ : 144 * Bw + 54 * Kb ≤ Q)
    (hgap : ∀ m : Fin d → ℤ, (∀ i, |(m i : ℝ)| ≤ Q) →
      ¬ (μ * R / 50 ≤ |(shiftDot m ζ : ℝ)| ∧ |(shiftDot m ζ : ℝ)| ≤ 50 * ν * R)) : False := by
  set! m : Fin d → ℤ := (36 : ℤ) • (nx + ny - nx' - ny') + ∑ j, (6 * α j) • k j
  have hm : shiftDot m ζ = tripleResidual ζ α x nx + tripleResidual ζ α y ny -
      tripleResidual ζ α x' nx' - tripleResidual ζ α y' ny' - ∑ j, α j * w j := by
    have hsum : ∑ j, α j * ((x j + y j) - (x' j + y' j)) =
        ∑ j, α j * (6 * shiftDot (k j) ζ + w j) :=
      Finset.sum_congr rfl fun j _ => by rw [hdiff j]
    simp only [m, shiftDot_add, shiftDot_smul, shiftDot_sum, tripleResidual]
    have e1 : shiftDot (nx + ny - nx' - ny') ζ =
        shiftDot nx ζ + shiftDot ny ζ - shiftDot nx' ζ - shiftDot ny' ζ := by
      simp only [sub_eq_add_neg, shiftDot_add, shiftDot_neg]
    rw [e1]
    simp only [mul_add, mul_sub, Finset.sum_add_distrib, Finset.sum_sub_distrib] at hsum
    have e2 : ∑ j, 6 * α j * shiftDot (k j) ζ = ∑ j, α j * (6 * shiftDot (k j) ζ) :=
      Finset.sum_congr rfl fun j _ => by ring
    rw [e2]
    linear_combination -hsum
  have hwsum : |((∑ j, α j * w j : ℤ) : ℝ)| ≤ 9 * e₂ := by
    push_cast
    calc |∑ j, (α j : ℝ) * w j| ≤ ∑ j, |(α j : ℝ) * w j| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _j : Fin 3, 3 * e₂ := Finset.sum_le_sum fun j _ => by
          rw [abs_mul]
          have h3 : |(α j : ℝ)| ≤ 3 := by rw [← Int.cast_abs]; exact_mod_cast hα3 j
          exact mul_le_mul h3 (hw j) (abs_nonneg _) (by norm_num)
      _ = 9 * e₂ := by simp; ring
  have hmR : (shiftDot m ζ : ℝ) = tripleResidual ζ α x nx + tripleResidual ζ α y ny -
      tripleResidual ζ α x' nx' - tripleResidual ζ α y' ny' - ((∑ j, α j * w j : ℤ) : ℝ) := by
    rw [hm]; push_cast; ring
  have hlow : μ * R / 50 ≤ |(shiftDot m ζ : ℝ)| := by
    rw [hmR]
    have := abs_sub_abs_le_abs_sub (tripleResidual ζ α x nx : ℝ)
      (-(tripleResidual ζ α y ny : ℝ) + tripleResidual ζ α x' nx' + tripleResidual ζ α y' ny' +
        ((∑ j, α j * w j : ℤ) : ℝ))
    have h2 : |-(tripleResidual ζ α y ny : ℝ) + tripleResidual ζ α x' nx' +
        tripleResidual ζ α y' ny' + ((∑ j, α j * w j : ℤ) : ℝ)| ≤ 3 * e₁ + 9 * e₂ := by
      calc _ ≤ |-(tripleResidual ζ α y ny : ℝ)| + |(tripleResidual ζ α x' nx' : ℝ)| +
            |(tripleResidual ζ α y' ny' : ℝ)| + |((∑ j, α j * w j : ℤ) : ℝ)| := by
            refine (abs_add_le _ _).trans ?_
            gcongr
            refine (abs_add_le _ _).trans ?_
            gcongr
            exact abs_add_le _ _
        _ ≤ _ := by rw [abs_neg]; linarith
    have e : (tripleResidual ζ α x nx : ℝ) - (-(tripleResidual ζ α y ny : ℝ) +
        tripleResidual ζ α x' nx' + tripleResidual ζ α y' ny' + ((∑ j, α j * w j : ℤ) : ℝ)) =
        tripleResidual ζ α x nx + tripleResidual ζ α y ny - tripleResidual ζ α x' nx' -
          tripleResidual ζ α y' ny' - ((∑ j, α j * w j : ℤ) : ℝ) := by ring
    rw [e] at this
    linarith
  have hup : |(shiftDot m ζ : ℝ)| ≤ 50 * ν * R := by
    rw [hmR]
    have h1 : |(tripleResidual ζ α x nx : ℝ) + tripleResidual ζ α y ny -
        tripleResidual ζ α x' nx' - tripleResidual ζ α y' ny' - ((∑ j, α j * w j : ℤ) : ℝ)| ≤
        |(tripleResidual ζ α x nx : ℝ)| + |(tripleResidual ζ α y ny : ℝ)| +
        |(tripleResidual ζ α x' nx' : ℝ)| + |(tripleResidual ζ α y' ny' : ℝ)| +
        |((∑ j, α j * w j : ℤ) : ℝ)| := by
      refine (abs_sub _ _).trans ?_
      gcongr
      refine (abs_sub _ _).trans ?_
      gcongr
      refine (abs_sub _ _).trans ?_
      gcongr
      exact abs_add_le _ _
    have hνR : 0 ≤ ν * R := (abs_nonneg _).trans hx'
    nlinarith only [hR, hx, hx', hx'', hy, hy', herr, hwsum, h1]
  refine hgap m (fun i => ?_) ⟨hlow, hup⟩
  simp only [m, Pi.add_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul, Finset.sum_apply]
  push_cast
  obtain ⟨h1, h2, h3, h4⟩ := hn i
  calc |36 * ((nx i : ℝ) + ny i - nx' i - ny' i) + ∑ j, 6 * (α j : ℝ) * k j i|
      ≤ |36 * ((nx i : ℝ) + ny i - nx' i - ny' i)| + |∑ j, 6 * (α j : ℝ) * k j i| :=
        abs_add_le _ _
    _ ≤ 36 * (4 * Bw) + 54 * Kb := by
        gcongr
        · rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 36)]
          have : |(nx i : ℝ) + ny i - nx' i - ny' i| ≤ 4 * Bw := by
            refine (abs_sub _ _).trans ?_
            have := (abs_sub ((nx i : ℝ) + ny i) (nx' i)).trans
              (add_le_add ((abs_add_le _ _).trans (add_le_add h1 h3)) h2)
            linarith
          linarith
        · calc |∑ j, 6 * (α j : ℝ) * k j i| ≤ ∑ j, |6 * (α j : ℝ) * k j i| :=
                Finset.abs_sum_le_sum_abs _ _
            _ ≤ ∑ _j : Fin 3, 18 * Kb := Finset.sum_le_sum fun j _ => by

  have hB0 : 0 < B := by linarith only [hB]
  have hlogH : 2 ≤ Real.log H := by rw [Real.le_log_iff_exp_le hH0]; exact hH
  have hlogB : 0 ≤ Real.log B := Real.log_nonneg (by linarith)
  have hX1 : 1 ≤ X := by linarith
  have hd0 : (0 : ℝ) ≤ d := Nat.cast_nonneg d
  have hdX : (d : ℝ) ≤ X := by linarith
  have hd2 : ((d ^ 2 : ℕ) : ℝ) ≤ X ^ 2 := by push_cast; exact pow_le_pow_left₀ hd0 hdX 2
  have hpos : 0 < 4 * H ^ (d ^ 2) * (B ^ (d ^ 2)) ^ 2 *
      (H + (d : ℝ) ^ 2 * ((1 + B) * H * B) + 1) := by positivity
  rw [← Real.exp_log hpos]
  apply Real.exp_le_exp.mpr
  rw [Real.log_mul (by positivity) (by positivity), Real.log_mul (by positivity) (by positivity),
    Real.log_mul (by norm_num) (by positivity), Real.log_pow, Real.log_pow, Real.log_pow]
  have hlast : Real.log (H + (d : ℝ) ^ 2 * ((1 + B) * H * B) + 1) ≤ 6 * X := by
    have h1 : H + (d : ℝ) ^ 2 * ((1 + B) * H * B) + 1 ≤ 4 * (H ^ 4 * B ^ 2) := by
      have hdH : (d : ℝ) ≤ H := hd.trans (Real.log_le_self hH0.le)
      have hH1 : 1 ≤ H := by linarith [Real.add_one_le_exp (2 : ℝ)]
      have : (d : ℝ) ^ 2 ≤ H ^ 2 := pow_le_pow_left₀ hd0 hdH 2
      have hB1 : 1 + B ≤ 2 * B := by linarith
      have hH2 : H ≤ H ^ 4 := le_self_pow₀ hH1 (by norm_num)
      have hH3 : H ^ 3 ≤ H ^ 4 := pow_le_pow_right₀ hH1 (by norm_num)
      have a1 : (d : ℝ) ^ 2 * ((1 + B) * H * B) ≤ H ^ 2 * ((2 * B) * H * B) :=

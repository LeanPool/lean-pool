/-- The data of the coloring (blueprint lines 1714-1728): graph distances, the parameters
`d₀, b₁, b₂` and the primary and high delay arrays (one per round), with values in `[0, d₀]`. -/
structure ColorSetup (V : Type*) where
  /-- Depth-dependent distance used to compare chart labels. -/
  dist : DepthDistance V
  /-- Number of coloring rounds and bound for each delay value. -/
  d0 : ℕ
  /-- Distance scale dividing graph distances in the primary score. -/
  b1 : ℕ
  /-- Distance scale dividing graph distances in the high score. -/
  b2 : ℕ
  /-- Primary delay assigned to each label in each round. -/
  Dp : Fin d0 → V → ℕ
  /-- High delay assigned to each label in each round. -/
  Dh : Fin d0 → V → ℕ
  Dp_le : ∀ ρ v, Dp ρ v ≤ d0
  Dh_le : ∀ ρ v, Dh ρ v ≤ d0

namespace ColorSetup
variable {V : Type*} [DecidableEq V] (K : ColorSetup V)

/-- The primary score `D_z - ⌊d_s(z,v)/b₁⌋` of `z` at the center `v` (distance quotients capped
at `d₀ + 6`, which does not affect top scores or gaps). -/
noncomputable def psc (s : ℤ) (ρ : Fin K.d0) (v z : V) : ℤ :=
  (K.Dp ρ z : ℤ) - capDiv (K.dist.d s z v) K.b1 (K.d0 + 6)

/-- The signature of a family of rounds: the winner predicates and the top scores. -/
noncomputable def roundSig {n : ℕ} (X : Finset V) (sc : Fin n → V → ℤ) : Fin n → (V → Prop) × ℤ :=
  fun ρ => (RoundWinner X (sc ρ), roundTop X (sc ρ))

open Classical in
/-- The first marked round, its winner and its top score. -/
noncomputable def sigData {n : ℕ} (σ : Fin n → (V → Prop) × ℤ) : Option (Fin n × V × ℤ) :=
  if h : ∃ ρ, ∃ z, (σ ρ).1 z then
    some (Fin.find (fun ρ => ∃ z, (σ ρ).1 z) h,
      Classical.choose (Fin.find_spec (p := fun ρ => ∃ z, (σ ρ).1 z) h),
      (σ (Fin.find (fun ρ => ∃ z, (σ ρ).1 z) h)).2)
  else none

omit [DecidableEq V] in
theorem sigData_spec {n : ℕ} {X : Finset V} {sc : Fin n → V → ℤ} {ρ : Fin n} {z : V} {g : ℤ}
    (h : sigData (roundSig X sc) = some (ρ, z, g)) :
    RoundWinner X (sc ρ) z ∧ g = roundTop X (sc ρ) ∧ ∀ ρ' < ρ, ¬ RoundMarked X (sc ρ') := by
  classical
  unfold sigData at h
  split_ifs at h with hex
  simp only [Option.some.injEq, Prod.mk.injEq] at h
  obtain ⟨h1, h2, h3⟩ := h
  subst h1 h2 h3
  refine ⟨Classical.choose_spec (Fin.find_spec (p := fun ρ => ∃ z, (roundSig X sc ρ).1 z) hex),
    rfl,
    fun ρ' hρ' => ?_⟩
  exact Fin.find_min (p := fun ρ => ∃ z, (roundSig X sc ρ).1 z) hex hρ'

omit [DecidableEq V] in
theorem sigData_none {n : ℕ} {X : Finset V} {sc : Fin n → V → ℤ}
    (h : sigData (roundSig X sc) = none) : ∀ ρ, ¬ RoundMarked X (sc ρ) := by
  classical
  unfold sigData at h
  split_ifs at h with hex
  intro ρ hρ
  exact hex ⟨ρ, hρ⟩

/-- The primary data `(round, winner z, top score g)` of the center `v` at a state. -/
noncomputable def prim (A : AdmState V) (v : V) : Option (Fin K.d0 × V × ℤ) :=
  sigData (roundSig A.X (fun ρ => K.psc A.s ρ v))

/-- The rival profile `f_a(s') = max_{w ∈ W∖{z}} (b₁ D_w - d_{s'}(w,a))` (`-∞` when empty or at
infinite distance). -/
noncomputable def prof (ρ : Fin K.d0) (z : V) (W : Finset V) (a : V) (s' : ℤ) : WithBot ℤ :=
  (W.erase z).sup (fun w => if K.dist.d s' w a = ⊤ then ⊥ else
    (((K.b1 * K.Dp ρ w : ℕ) : ℤ) - ((K.dist.d s' w a).toNat : ℤ) : ℤ))

/-- The lower clipping level `T_l = (g - 3) b₁ + l b₁/(2 d₀)`. -/
noncomputable def Tl (g : ℤ) (l : ℕ) : ℝ := (g - 3) * K.b1 + l * K.b1 / (2 * K.d0)

/-- The upper clipping level `U = (g - 2) b₁`. -/
noncomputable def Ul (g : ℤ) : ℝ := (g - 2) * K.b1

/-- The ball radius `R_l = 10 l (d₀ + 1) b₂`. -/
noncomputable def Rl (l : ℕ) : ℝ := 10 * l * (K.d0 + 1) * K.b2

/-- The fixed pseudometric `d^{(l)}(a,b) = sup_{s'} |C_l(f_a(s')) - C_l(f_b(s'))|` of a context. -/
noncomputable def lowMet (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) (l : ℕ) (a b : V) : ℝ :=
  ⨆ s' : ℤ, |clipW (K.Tl g l) (K.Ul g) (K.prof ρ z W a s') -
    clipW (K.Tl g l) (K.Ul g) (K.prof ρ z W b s')|

/-- The floor logarithms of the sizes of the balls `B_{d^{(l)}}(v, R_l)` on the present list. -/
noncomputable def ballVec (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) (X : Finset V) (v : V)
    (l : ℕ) : ℕ :=
  flog32 (X.filter (fun a => K.lowMet ρ g z W l a v ≤ K.Rl l)).card

open Classical in
/-- The least `1 ≤ l < d₀` whose two consecutive balls have the same floor logarithm, and that
common value `n` (placeholder `(0,0)` on failure). -/
noncomputable def ballSel (vec : ℕ → ℕ) : ℕ × ℕ :=
  if h : ∃ l, 1 ≤ l ∧ l < K.d0 ∧ vec l = vec (l + 1) then
    (Nat.find h, vec (Nat.find h))
  else (0, 0)

/-- The high score `E_a - ⌊d^{(l+1)}(a,v)/b₂⌋` (capped at `d₀ + 6`). -/
noncomputable def hsc (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) (l : ℕ) (v : V)
    (ρ' : Fin K.d0) (a : V) : ℤ :=
  (K.Dh ρ' a : ℤ) - min ⌊K.lowMet ρ g z W (l + 1) a v / K.b2⌋₊ (K.d0 + 6)

/-- The complete color data at a state: primary data, cohort level, ball selection and high data
(winners included). -/
noncomputable def colorData (A : AdmState V) (v : V) :
    Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) × Option (Fin K.d0 × V × ℤ) :=
  match K.prim A v with
  | none => (none, 0, (0, 0), none)
  | some (ρ, z, g) =>
    let W := admFrozen A z
    let ls := K.ballSel (K.ballVec ρ g z W A.X v)
    (some (ρ, z, g), admLevel A z, ls,
      sigData (roundSig A.X (fun ρ' => K.hsc ρ g z W ls.1 v ρ')))

end ColorSetup

theorem sum_toNat_mono_eq {ι : Type*} (s : Finset ι) (f g : ι → ℤ) (h0 : ∀ i ∈ s, 0 ≤ f i)
    (hle : ∀ i ∈ s, f i ≤ g i) :
    (∑ i ∈ s, (f i).toNat ≤ ∑ i ∈ s, (g i).toNat) ∧
    (∑ i ∈ s, (f i).toNat = ∑ i ∈ s, (g i).toNat → ∀ i ∈ s, f i = g i) := by
  have hle' : ∀ i ∈ s, (f i).toNat ≤ (g i).toNat := fun i hi => Int.toNat_le_toNat (hle i hi)
  refine ⟨Finset.sum_le_sum hle', fun he i hi => ?_⟩
  have := (Finset.sum_eq_sum_iff_of_le hle').mp he i hi
  have h1 := Int.toNat_of_nonneg (h0 i hi)
  have h2 := Int.toNat_of_nonneg ((h0 i hi).trans (hle i hi))
  omega

theorem sum_nat_mono_eq {ι : Type*} (s : Finset ι) (f g : ι → ℕ) (hle : ∀ i ∈ s, f i ≤ g i) :
    (∑ i ∈ s, f i ≤ ∑ i ∈ s, g i) ∧ (∑ i ∈ s, f i = ∑ i ∈ s, g i → ∀ i ∈ s, f i = g i) :=
  ⟨Finset.sum_le_sum hle, fun he => (Finset.sum_eq_sum_iff_of_le hle).mp he⟩

namespace ColorSetup
variable {V : Type*} [DecidableEq V] (K : ColorSetup V)

omit [DecidableEq V] in
theorem psc_mono {s s' : ℤ} (h : s ≤ s') (ρ : Fin K.d0) (v z : V) :
    K.psc s ρ v z ≤ K.psc s' ρ v z := by
  unfold psc
  have := capDiv_mono (K.dist.anti h z v) K.b1 (K.d0 + 6)
  omega

omit [DecidableEq V] in
theorem psc_self (s : ℤ) (ρ : Fin K.d0) (v : V) : K.psc s ρ v v = K.Dp ρ v := by
  simp [psc, K.dist.self, capDiv_zero]

omit [DecidableEq V] in
theorem roundSig_congr {n : ℕ} {X X' : Finset V} {sc sc' : Fin n → V → ℤ}
    (h : ∀ ρ, roundTop X (sc ρ) = roundTop X' (sc' ρ) ∧
      ∀ z, RoundWinner X (sc ρ) z ↔ RoundWinner X' (sc' ρ) z) :
    roundSig X sc = roundSig X' sc' := by
  funext ρ
  simp only [roundSig, Prod.mk.injEq]
  exact ⟨funext fun z => propext ((h ρ).2 z), (h ρ).1⟩

/-- The first potential: the sum over primary rounds of the round potentials. -/
noncomputable def pot1 (A : AdmState V) (v : V) : ℕ :=
  ∑ ρ, (roundPot A.X (K.psc A.s ρ v)).toNat

omit [DecidableEq V] in
theorem roundPot_psc_nonneg (A : AdmState V) {v : V} (hv : v ∈ A.X) (ρ : Fin K.d0) :
    0 ≤ roundPot A.X (K.psc A.s ρ v) := by
  have := le_roundTop (sc := K.psc A.s ρ v) hv
  rw [psc_self] at this
  unfold roundPot; split_ifs <;> omega

omit [DecidableEq V] in
theorem pot1_mono {A A' : AdmState V} (h : A.Le A') {v : V} (hv : v ∈ A.X) :
    K.pot1 A v ≤ K.pot1 A' v ∧ (K.pot1 A v = K.pot1 A' v → K.prim A v = K.prim A' v) := by
  have hne : A.X.Nonempty := ⟨v, hv⟩
  have hsc : ∀ ρ, ∀ z ∈ A.X, K.psc A.s ρ v z ≤ K.psc A'.s ρ v z :=
    fun ρ z _ => K.psc_mono h.1 ρ v z
  obtain ⟨h1, h2⟩ := sum_toNat_mono_eq Finset.univ _ _
    (fun ρ _ => K.roundPot_psc_nonneg A hv ρ) (fun ρ _ => roundPot_mono hne h.2.1 (hsc ρ))
  refine ⟨h1, fun he => ?_⟩
  have := h2 he
  unfold prim
  congr 1
  exact roundSig_congr fun ρ => roundPot_eq hne h.2.1 (hsc ρ) (this ρ (Finset.mem_univ _))

omit [DecidableEq V] in
theorem prim_winner {A : AdmState V} {v : V} {ρ : Fin K.d0} {z : V} {g : ℤ}
    (h : K.prim A v = some (ρ, z, g)) : z ∈ A.X :=
  (sigData_spec h).1.1

/-- The second potential: the cohort level. -/
noncomputable def pot2 (A : AdmState V) (v : V) : ℕ :=
  match K.prim A v with
  | none => 0
  | some (_, z, _) => admLevel A z

omit [DecidableEq V] in
theorem admLevel_mono {A A' : AdmState V} (hA : A.WF) (h : A.Le A') {z : V} (hz : z ∈ A.X) :
    admLevel A z ≤ admLevel A' z := by
  unfold admLevel
  rw [h.2.2 z hz]
  have h1 := hA.1 z hz
  have h2 : A.X.card ≤ A'.X.card := Finset.card_le_card h.2.1
  exact cohortLevel_mono (by omega) (by omega)

theorem admFrozen_eq {A A' : AdmState V} (hA : A.WF) (hA' : A'.WF) (h : A.Le A') {z : V}
    (hz : z ∈ A.X) (hl : admLevel A z = admLevel A' z) : admFrozen A z = admFrozen A' z := by
  have hpre : cohortPrefix (A.pos z) (admLevel A z) ≤ A.X.card := by
    have := cohortPrefix_le (i := A.pos z) (j := A.X.card - 1) (by have := hA.1 z hz; omega) rfl
    have h0 := hA.1 z hz
    unfold admLevel; omega
  ext w
  simp only [admFrozen, Finset.mem_filter, ← hl, h.2.2 z hz]
  constructor
  · rintro ⟨hw, hp⟩
    exact ⟨h.2.1 hw, by rw [h.2.2 w hw]; exact hp⟩
  · rintro ⟨hw, hp⟩
    have hwA := h.mem_of_pos_lt hA hA' hw (lt_of_lt_of_le hp hpre)
    exact ⟨hwA, by rw [← h.2.2 w hwA]; exact hp⟩

/-- The third potential: the total floor-logarithm of the ball sizes. -/
noncomputable def pot3 (A : AdmState V) (v : V) : ℕ :=
  match K.prim A v with
  | none => 0
  | some (ρ, z, g) => ∑ l ∈ Finset.Icc 1 K.d0, K.ballVec ρ g z (admFrozen A z) A.X v l

theorem ballVec_mono (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) {X X' : Finset V}
    (h : X ⊆ X') (v : V) (l : ℕ) : K.ballVec ρ g z W X v l ≤ K.ballVec ρ g z W X' v l :=
  flog32_mono (Finset.card_le_card (Finset.filter_subset_filter _ h))

omit [DecidableEq V] in
theorem ballSel_congr {vec vec' : ℕ → ℕ} (h : ∀ l, 1 ≤ l → l ≤ K.d0 → vec l = vec' l) :
    K.ballSel vec = K.ballSel vec' := by
  have hp : (fun l => 1 ≤ l ∧ l < K.d0 ∧ vec l = vec (l + 1)) =
      (fun l => 1 ≤ l ∧ l < K.d0 ∧ vec' l = vec' (l + 1)) := by
    funext l
    apply propext
    constructor
    · rintro ⟨h1, h2, h3⟩
      exact ⟨h1, h2, by rw [← h l h1 h2.le, ← h (l + 1) (by omega) h2, h3]⟩
    · rintro ⟨h1, h2, h3⟩
      exact ⟨h1, h2, by rw [h l h1 h2.le, h (l + 1) (by omega) h2, h3]⟩
  unfold ballSel
  by_cases hex : ∃ l, 1 ≤ l ∧ l < K.d0 ∧ vec l = vec (l + 1)
  · have hex' : ∃ l, 1 ≤ l ∧ l < K.d0 ∧ vec' l = vec' (l + 1) := by
      have := hex; rw [show (∃ l, 1 ≤ l ∧ l < K.d0 ∧ vec l = vec (l + 1)) =
        ∃ l, 1 ≤ l ∧ l < K.d0 ∧ vec' l = vec' (l + 1) from congrArg Exists hp] at this
      exact this
    rw [dite_eq_left hex, dite_eq_left hex']
    have hfind : Nat.find hex = Nat.find hex' := by
      apply le_antisymm
      · exact Nat.find_min' hex (by
          have := Nat.find_spec hex'
          have hfun := congrFun hp (Nat.find hex')
          exact hfun ▸ this)
      · exact Nat.find_min' hex' (by
          have := Nat.find_spec hex
          have hfun := congrFun hp (Nat.find hex)
          exact hfun ▸ this)
    rw [hfind]
    have := (Nat.find_spec hex').1
    have := (Nat.find_spec hex').2.1
    rw [h _ (Nat.find_spec hex').1 (Nat.find_spec hex').2.1.le]
  · have hex' : ¬ ∃ l, 1 ≤ l ∧ l < K.d0 ∧ vec' l = vec' (l + 1) := by
      rintro ⟨l, hl⟩
      exact hex ⟨l, (congrFun hp l).symm ▸ hl⟩
    rw [dite_eq_right hex, dite_eq_right hex']

/-- The fourth potential: the sum over high rounds of the round potentials. -/
noncomputable def pot4 (A : AdmState V) (v : V) : ℕ :=
  match K.prim A v with
  | none => 0
  | some (ρ, z, g) =>
    ∑ ρ', (roundPot A.X (K.hsc ρ g z (admFrozen A z)
      (K.ballSel (K.ballVec ρ g z (admFrozen A z) A.X v)).1 v ρ')).toNat

theorem lowMet_self (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) (l : ℕ) (a : V) :
    K.lowMet ρ g z W l a a = 0 := by
  simp [lowMet]

theorem hsc_self (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) (l : ℕ) (v : V) (ρ' : Fin K.d0) :
    K.hsc ρ g z W l v ρ' v = K.Dh ρ' v := by
  simp [hsc, lowMet_self]

theorem roundPot_hsc_nonneg (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) (l : ℕ) {X : Finset V}
    {v : V} (hv : v ∈ X) (ρ' : Fin K.d0) : 0 ≤ roundPot X (K.hsc ρ g z W l v ρ') := by
  have := le_roundTop (sc := K.hsc ρ g z W l v ρ') hv
  rw [hsc_self] at this
  unfold roundPot; split_ifs <;> omega

end ColorSetup

theorem lex_step {a a' b b' B : ℕ} (hb : b ≤ B) (h1 : a ≤ a')
    (h2 : a = a' → b ≤ b') :
    a * (B + 1) + b ≤ a' * (B + 1) + b' ∧ (a * (B + 1) + b = a' * (B + 1) + b' → a = a' ∧ b =
        b') := by
  rcases h1.lt_or_eq with hlt | heq
  · have : a * (B + 1) + b < a' * (B + 1) + b' := by
      have : (a + 1) * (B + 1) ≤ a' * (B + 1) := Nat.mul_le_mul_right _ hlt
      nlinarith only [hb, hlt]
    exact ⟨this.le, fun he => absurd he this.ne⟩
  · subst heq
    have := h2 rfl
    exact ⟨by omega, fun he => ⟨rfl, by omega⟩⟩

namespace ColorSetup
variable {V : Type*} [DecidableEq V] (K : ColorSetup V)

/-- The lexicographic potential of the color data, with bounds `B₂, B₃, B₄` on the last three
coordinates. -/
noncomputable def potential (B₂ B₃ B₄ : ℕ) (A : AdmState V) (v : V) : ℕ :=
  ((K.pot1 A v * (B₂ + 1) + K.pot2 A v) * (B₃ + 1) + K.pot3 A v) * (B₄ + 1) + K.pot4 A v

/-- One step along a path: the potential does not decrease, and if it stays constant then the
complete color data (including both winners) are unchanged. -/
theorem potential_step {B₂ B₃ B₄ : ℕ} {A A' : AdmState V} (hA : A.WF) (hA' : A'.WF)
    (h : A.Le A') {v : V} (hv : v ∈ A.X)
    (hb : K.pot2 A v ≤ B₂ ∧ K.pot3 A v ≤ B₃ ∧ K.pot4 A v ≤ B₄) :
    K.potential B₂ B₃ B₄ A v ≤ K.potential B₂ B₃ B₄ A' v ∧
    (K.potential B₂ B₃ B₄ A v = K.potential B₂ B₃ B₄ A' v →
      K.colorData A v = K.colorData A' v) := by
  obtain ⟨b2, b3, b4⟩ := hb
  obtain ⟨p1, e1⟩ := K.pot1_mono h hv
  -- the remaining comparisons, given equal primary data
  have key : K.prim A v = K.prim A' v →
      (K.pot2 A v ≤ K.pot2 A' v) ∧
      (K.pot2 A v = K.pot2 A' v → K.pot3 A v ≤ K.pot3 A' v) ∧
      (K.pot2 A v = K.pot2 A' v → K.pot3 A v = K.pot3 A' v → K.pot4 A v ≤ K.pot4 A' v) ∧
      (K.pot2 A v = K.pot2 A' v → K.pot3 A v = K.pot3 A' v → K.pot4 A v = K.pot4 A' v →
        K.colorData A v = K.colorData A' v) := by
    intro hp
    cases hc : K.prim A v with
    | none =>
      have hc' : K.prim A' v = none := hp ▸ hc
      simp only [pot2, pot3, pot4, colorData, hc, hc', le_refl, implies_true, and_self]
    | some t =>
      obtain ⟨ρ, z, g⟩ := t
      have hc' : K.prim A' v = some (ρ, z, g) := hp ▸ hc
      have hz := K.prim_winner hc
      simp only [pot2, pot3, pot4, colorData, hc, hc']
      refine ⟨admLevel_mono hA h hz, fun hl => ?_, fun hl h3 => ?_, fun hl h3 h4 => ?_⟩
      · rw [admFrozen_eq hA hA' h hz hl]
        exact Finset.sum_le_sum fun l _ => K.ballVec_mono ρ g z _ h.2.1 v l
      · rw [admFrozen_eq hA hA' h hz hl] at h3 ⊢
        have hvec := (sum_nat_mono_eq _ _ _
          (fun l _ => K.ballVec_mono ρ g z (admFrozen A' z) h.2.1 v l)).2 h3
        rw [K.ballSel_congr (vec := K.ballVec ρ g z (admFrozen A' z) A.X v)
          (vec' := K.ballVec ρ g z (admFrozen A' z) A'.X v)
          (fun l h1 h2 => hvec l (Finset.mem_Icc.mpr ⟨h1, h2⟩))]
        exact (sum_toNat_mono_eq _ _ _ (fun ρ' _ => K.roundPot_hsc_nonneg _ _ _ _ _ hv ρ')
          (fun ρ' _ => roundPot_mono ⟨v, hv⟩ h.2.1 (fun _ _ => le_rfl))).1
      · rw [admFrozen_eq hA hA' h hz hl] at h3 h4 ⊢
        have hvec := (sum_nat_mono_eq _ _ _
          (fun l _ => K.ballVec_mono ρ g z (admFrozen A' z) h.2.1 v l)).2 h3
        have hsel := K.ballSel_congr (vec := K.ballVec ρ g z (admFrozen A' z) A.X v)
          (vec' := K.ballVec ρ g z (admFrozen A' z) A'.X v)
          (fun l h1 h2 => hvec l (Finset.mem_Icc.mpr ⟨h1, h2⟩))
        rw [hsel] at h4 ⊢
        have hr := (sum_toNat_mono_eq _ _ _ (fun ρ' _ => K.roundPot_hsc_nonneg _ _ _ _ _ hv ρ')
          (fun ρ' _ => roundPot_mono ⟨v, hv⟩ h.2.1 (fun _ _ => le_rfl))).2 h4
        have hsig := roundSig_congr fun ρ' => roundPot_eq ⟨v, hv⟩ h.2.1 (fun _ _ => le_rfl)
          (hr ρ' (Finset.mem_univ _))
        rw [hl, hsig]
  unfold potential
  -- assemble the lexicographic comparison
  have s1 := lex_step b2 p1 (fun he => (key (e1 he)).1)
  have s2 := lex_step b3 s1.1 (fun he => (key (e1 (s1.2 he).1)).2.1 (s1.2 he).2)
  have s3 := lex_step b4 s2.1 (fun he =>
    (key (e1 (s1.2 (s2.2 he).1).1)).2.2.1 (s1.2 (s2.2 he).1).2 (s2.2 he).2)
  refine ⟨s3.1, fun he => ?_⟩
  obtain ⟨he3, he4⟩ := s3.2 he
  obtain ⟨he2, he3'⟩ := s2.2 he3
  obtain ⟨he1, he2'⟩ := s1.2 he2
  exact (key (e1 he1)).2.2.2 he2' he3' he4

end ColorSetup

theorem roundPot_toNat_le {V : Type*} {X : Finset V} (hX : X.Nonempty) {sc : V → ℤ} {c : ℤ}
    (h : ∀ z ∈ X, sc z ≤ c) : (roundPot X sc).toNat ≤ (2 * c + 1).toNat := by
  have := roundTop_le hX h
  apply Int.toNat_le_toNat
  unfold roundPot; split_ifs <;> omega

namespace ColorSetup
variable {V : Type*} [DecidableEq V] (K : ColorSetup V)

omit [DecidableEq V] in
theorem pot1_le {A : AdmState V} {v : V} (hv : v ∈ A.X) : K.pot1 A v ≤ K.d0 * (2 * K.d0 + 1) := by
  unfold pot1
  calc ∑ ρ, (roundPot A.X (K.psc A.s ρ v)).toNat ≤ ∑ _ρ : Fin K.d0, (2 * K.d0 + 1) := by
        apply Finset.sum_le_sum; intro ρ _
        have h := roundPot_toNat_le ⟨v, hv⟩ (sc := K.psc A.s ρ v) (c := K.d0) (fun z _ => by
          unfold psc; have := K.Dp_le ρ z; omega)
        have e : (2 * (K.d0 : ℤ) + 1).toNat = 2 * K.d0 + 1 := by omega
        rw [e] at h; exact h
    _ = _ := by simp

omit [DecidableEq V] in
theorem pot2_le {A : AdmState V} (hA : A.WF) {Nv : ℕ} (hN : A.X.card ≤ Nv) (v : V) :
    K.pot2 A v ≤ Nat.size Nv := by
  unfold pot2
  cases hc : K.prim A v with
  | none => simp
  | some t =>
    obtain ⟨ρ, z, g⟩ := t
    have hz := K.prim_winner hc
    simp only
    unfold admLevel cohortLevel
    rw [Nat.size_le]
    have h1 := hA.1 z hz
    have h2 := Nat.lt_size_self Nv
    exact Nat.xor_lt_two_pow (by omega) (by omega)

theorem pot3_le {A : AdmState V} {Nv : ℕ} (hN : A.X.card ≤ Nv) (v : V) :
    K.pot3 A v ≤ K.d0 * flog32 Nv := by
  unfold pot3
  cases hc : K.prim A v with
  | none => simp
  | some t =>
    obtain ⟨ρ, z, g⟩ := t
    simp only
    calc ∑ l ∈ Finset.Icc 1 K.d0, K.ballVec ρ g z (admFrozen A z) A.X v l
        ≤ ∑ _l ∈ Finset.Icc 1 K.d0, flog32 Nv := by
          apply Finset.sum_le_sum; intro l _
          exact flog32_mono ((Finset.card_le_card (Finset.filter_subset _ _)).trans hN)
      _ = _ := by simp

theorem pot4_le {A : AdmState V} {v : V} (hv : v ∈ A.X) : K.pot4 A v ≤ K.d0 * (2 * K.d0 + 1) := by
  unfold pot4
  cases hc : K.prim A v with
  | none => simp
  | some t =>
    obtain ⟨ρ, z, g⟩ := t
    simp only
    calc _ ≤ ∑ _ρ : Fin K.d0, (2 * K.d0 + 1) := by
          apply Finset.sum_le_sum; intro ρ' _
          have h := roundPot_toNat_le ⟨v, hv⟩ (c := K.d0)
            (sc := K.hsc ρ g z (admFrozen A z)
              (K.ballSel (K.ballVec ρ g z (admFrozen A z) A.X v)).1 v ρ') (fun a _ => by
            unfold hsc; have := K.Dh_le ρ' a; omega)
          have e : (2 * (K.d0 : ℤ) + 1).toNat = 2 * K.d0 + 1 := by omega
          rw [e] at h; exact h
      _ = _ := by simp

/-- The maximal value of the potential. -/
def potMax (Nv : ℕ) : ℕ :=
  (K.d0 * (2 * K.d0 + 1) + 1) * (Nat.size Nv + 1) * (K.d0 * flog32 Nv + 1) *
    (K.d0 * (2 * K.d0 + 1) + 1)

theorem potential_le {A : AdmState V} (hA : A.WF) {Nv : ℕ} (hN : A.X.card ≤ Nv) {v : V}
    (hv : v ∈ A.X) :
    K.potential (Nat.size Nv) (K.d0 * flog32 Nv) (K.d0 * (2 * K.d0 + 1)) A v < K.potMax Nv := by
  have h1 := K.pot1_le hv
  have h2 := K.pot2_le hA hN v
  have h3 := K.pot3_le hN v
  have h4 := K.pot4_le hv
  unfold potential potMax
  generalize K.pot1 A v = a at *
  generalize K.pot2 A v = b at *
  generalize K.pot3 A v = c at *
  generalize K.pot4 A v = d at *
  generalize K.d0 * (2 * K.d0 + 1) = B1 at *
  generalize Nat.size Nv = B2 at *
  generalize K.d0 * flog32 Nv = B3 at *
  have e1 : a * (B2 + 1) + b < (B1 + 1) * (B2 + 1) := by nlinarith
  have e2 : (a * (B2 + 1) + b) * (B3 + 1) + c < (B1 + 1) * (B2 + 1) * (B3 + 1) := by nlinarith
  nlinarith only [h4, e2]

end ColorSetup

/-- A dyadic tree of cells with admission lists (blueprint §12.1-12.2): parents, heights above a
virtual top level (where lists are empty), depths and present lists with admission positions;
lists extend along every path. -/
structure AdmTree (V : Type*) where
  /-- Cell type of the abstract tree of admissible states. -/
  Cell : Type*
  /-- Parent cell in the admissible-state tree. -/
  par : Cell → Cell
  /-- Natural-number height above the top of the tree. -/
  ht : Cell → ℕ
  ht_par : ∀ I, 0 < ht I → ht (par I) + 1 = ht I
  /-- Integer depth associated with each tree cell. -/
  depth : Cell → ℤ
  /-- Finite set of labels present at each tree cell. -/
  X : Cell → Finset V
  /-- Position of each label in the finite list at a tree cell. -/
  pos : Cell → V → ℕ
  X_top : ∀ I, ht I = 0 → X I = ∅
  le_par : ∀ I, AdmState.Le ⟨depth (par I), X (par I), pos (par I)⟩ ⟨depth I, X I, pos I⟩
  wf : ∀ I, AdmState.WF ⟨depth I, X I, pos I⟩

namespace AdmTree
variable {V : Type*} (T : AdmTree V)

/-- The admission state of a cell. -/
def st (I : T.Cell) : AdmState V := ⟨T.depth I, T.X I, T.pos I⟩

theorem st_wf (I : T.Cell) : (T.st I).WF := T.wf I

theorem st_le_par (I : T.Cell) : (T.st (T.par I)).Le (T.st I) := T.le_par I

end AdmTree

namespace ColorSetup
variable {V : Type*} [DecidableEq V] (K : ColorSetup V) (T : AdmTree V)

open Classical in
/-- The number of changes of the color data of `v` along the last `n` ancestors of `I`. -/
noncomputable def chgN : ℕ → T.Cell → V → ℕ
  | 0, _, _ => 0
  | n + 1, I, v => chgN n (T.par I) v +
      if v ∈ T.X (T.par I) ∧ K.colorData (T.st (T.par I)) v ≠ K.colorData (T.st I) v then 1 else 0

/-- The number of changes of the color data of `v` along the whole ancestor path of `I`. -/
noncomputable def changes (I : T.Cell) (v : V) : ℕ := K.chgN T (T.ht I) I v

theorem chgN_eq_zero (n : ℕ) {I : T.Cell} {v : V} (hv : v ∉ T.X I) : K.chgN T n I v = 0 := by
  induction n generalizing I with
  | zero => rfl
  | succ n ih =>
    have hv' : v ∉ T.X (T.par I) := fun h => hv ((T.le_par I).2.1 h)
    simp [chgN, ih hv', hv']

/-- The number of changes is bounded by the potential. -/
theorem chgN_le {Nv : ℕ} (hN : ∀ I, (T.X I).card ≤ Nv) (n : ℕ) {I : T.Cell} {v : V}
    (hv : v ∈ T.X I) : K.chgN T n I v ≤
      K.potential (Nat.size Nv) (K.d0 * flog32 Nv) (K.d0 * (2 * K.d0 + 1)) (T.st I) v := by
  induction n generalizing I with
  | zero => exact Nat.zero_le _
  | succ n ih =>
    simp only [chgN]
    by_cases hp : v ∈ T.X (T.par I)
    · have hstep := K.potential_step (B₂ := Nat.size Nv) (B₃ := K.d0 * flog32 Nv)
        (B₄ := K.d0 * (2 * K.d0 + 1)) (T.st_wf (T.par I)) (T.st_wf I) (T.st_le_par I) hp
        ⟨K.pot2_le (T.st_wf (T.par I)) (hN _) v, K.pot3_le (hN _) v, K.pot4_le hp⟩
      have ih' := ih hp
      change K.chgN T n (T.par I) v ≤ K.potential _ _ _ (T.st (T.par I)) v at ih'
      split_ifs with hc
      · have hlt : K.potential (Nat.size Nv) (K.d0 * flog32 Nv) (K.d0 * (2 * K.d0 + 1))
            (T.st (T.par I)) v < K.potential (Nat.size Nv) (K.d0 * flog32 Nv)
            (K.d0 * (2 * K.d0 + 1)) (T.st I) v :=
          lt_of_le_of_ne hstep.1 (fun he => hc.2 (hstep.2 he))
        exact Nat.add_one_le_of_lt (lt_of_le_of_lt ih' hlt)
      · simp only [add_zero]; exact ih'.trans hstep.1
    · rw [chgN_eq_zero K T n hp]
      simp [hp]

end ColorSetup

theorem radix_step_inj {R a b c d : ℕ} (hb : b < R) (hd : d < R) (h : a * R + b = c * R + d) :
    a = c ∧ b = d := by
  have hR : 0 < R := by omega
  have h1 : (a * R + b) / R = a := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hR, Nat.div_eq_of_lt hb, zero_add]
  have h2 : (c * R + d) / R = c := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hR, Nat.div_eq_of_lt hd, zero_add]
  have hac : a = c := by rw [← h1, ← h2, h]
  subst hac
  exact ⟨rfl, by omega⟩

theorem radix_step_lt {R a b A : ℕ} (ha : a < A) (hb : b < R) : a * R + b < A * R := by
  have : (a + 1) * R ≤ A * R := Nat.mul_le_mul_right _ ha
  nlinarith

namespace ColorSetup
variable {V : Type*} [DecidableEq V] (K : ColorSetup V) (T : AdmTree V)

/-- The code of a round datum, forgetting the winner: `0` on failure, else `1 + ρ + d₀ g`. -/
def roundCode (t : Option (Fin K.d0 × V × ℤ)) : ℕ :=
  match t with
  | none => 0
  | some (ρ, _, g) => 1 + ρ + K.d0 * g.toNat

/-- The color metadata (blueprint line 1728): the primary round and `g`, the cohort level, `l`
and `n`, and the high round and `g₂`; winners are not part of the metadata. -/
def metaKey (c : Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) × Option (Fin K.d0 × V × ℤ)) :
    Option (Fin K.d0 × ℤ) × ℕ × ℕ × ℕ × Option (Fin K.d0 × ℤ) :=
  (c.1.map (fun t => (t.1, t.2.2)), c.2.1, c.2.2.1.1, c.2.2.1.2, c.2.2.2.map (fun t => (t.1,
      t.2.2)))

/-- The radix of the metadata encoding. -/
def radix (Nv : ℕ) : ℕ := (K.d0 + 1) ^ 2 + Nat.size Nv + flog32 Nv + 1

/-- The metadata encoding. -/
def metaCode (Nv : ℕ)
    (c : Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) × Option (Fin K.d0 × V × ℤ)) : ℕ :=
  (((K.roundCode c.1 * K.radix Nv + c.2.1) * K.radix Nv + c.2.2.1.1) * K.radix Nv +
    c.2.2.1.2) * K.radix Nv + K.roundCode c.2.2.2

/-- The admissible range of the color data: top scores in `[0, d₀]` and bounded indices. -/
def DataOK (Nv : ℕ)
    (c : Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) × Option (Fin K.d0 × V × ℤ)) : Prop :=
  (∀ t ∈ c.1, 0 ≤ t.2.2 ∧ t.2.2 ≤ K.d0) ∧ c.2.1 ≤ Nat.size Nv ∧ c.2.2.1.1 ≤ K.d0 ∧
    c.2.2.1.2 ≤ flog32 Nv ∧
    (∀ t ∈ c.2.2.2, 0 ≤ t.2.2 ∧ t.2.2 ≤ K.d0)

omit [DecidableEq V] in
theorem roundCode_lt {Nv : ℕ} {t : Option (Fin K.d0 × V × ℤ)}
    (h : ∀ u ∈ t, 0 ≤ u.2.2 ∧ u.2.2 ≤ K.d0) : K.roundCode t < K.radix Nv := by
  unfold roundCode radix
  cases t with
  | none => simp
  | some u =>
    obtain ⟨ρ, z, g⟩ := u
    have hg := h _ rfl
    simp only at hg ⊢
    have h1 : g.toNat ≤ K.d0 := by omega
    have h2 : (ρ : ℕ) < K.d0 := ρ.2
    have : K.d0 * g.toNat ≤ K.d0 * K.d0 := Nat.mul_le_mul_left _ h1
    nlinarith only [h1, h2]

omit [DecidableEq V] in
theorem roundCode_inj {t t' : Option (Fin K.d0 × V × ℤ)}
    (h : ∀ u ∈ t, 0 ≤ u.2.2 ∧ u.2.2 ≤ K.d0) (h' : ∀ u ∈ t', 0 ≤ u.2.2 ∧ u.2.2 ≤ K.d0)
    (he : K.roundCode t = K.roundCode t') :
    t.map (fun u => (u.1, u.2.2)) = t'.map (fun u => (u.1, u.2.2)) := by
  unfold roundCode at he
  cases t with
  | none => cases t' with
    | none => rfl
    | some u => obtain ⟨ρ, z, g⟩ := u; exact absurd he (by simp only; omega)
  | some u =>
    obtain ⟨ρ, z, g⟩ := u
    cases t' with
    | none => simp at he
    | some u' =>
      obtain ⟨ρ', z', g'⟩ := u'
      have hg := h _ rfl
      have hg' := h' _ rfl
      simp only at hg hg' he ⊢
      have hρ : (ρ : ℕ) < K.d0 := ρ.2
      have hρ' : (ρ' : ℕ) < K.d0 := ρ'.2
      have hρρ : (ρ : ℕ) = ρ' ∧ g.toNat = g'.toNat := by
        have e : g.toNat * K.d0 + ρ = g'.toNat * K.d0 + ρ' := by linarith
        exact (radix_step_inj hρ hρ' e).symm.imp_left (fun h => h) |>.symm |> fun ⟨a, b⟩ =>
          ⟨b, a⟩
      simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq]
      exact ⟨Fin.ext hρρ.1, by omega⟩

omit [DecidableEq V] in
theorem metaCode_lt {Nv : ℕ} {c : Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) ×
    Option (Fin K.d0 × V × ℤ)} (h : K.DataOK Nv c) : K.metaCode Nv c < K.radix Nv ^ 5 := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := h
  have r1 := K.roundCode_lt (Nv := Nv) h1
  have r5 := K.roundCode_lt (Nv := Nv) h5
  have r2 : c.2.1 < K.radix Nv := by unfold radix; omega
  have r3 : c.2.2.1.1 < K.radix Nv := by unfold radix; nlinarith only [h3]
  have r4 : c.2.2.1.2 < K.radix Nv := by unfold radix; omega
  unfold metaCode
  have s1 := radix_step_lt (A := K.radix Nv) r1 r2
  have s2 := radix_step_lt (A := K.radix Nv ^ 2) (by rw [sq]; exact s1) r3
  have s3 := radix_step_lt (A := K.radix Nv ^ 3) (by rw [pow_succ]; exact s2) r4
  have s4 := radix_step_lt (A := K.radix Nv ^ 4) (by rw [pow_succ]; exact s3) r5
  rw [pow_succ]; exact s4

omit [DecidableEq V] in
theorem metaCode_inj {Nv : ℕ} {c c' : Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) ×
    Option (Fin K.d0 × V × ℤ)} (h : K.DataOK Nv c) (h' : K.DataOK Nv c')
    (he : K.metaCode Nv c = K.metaCode Nv c') : K.metaKey c = K.metaKey c' := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := h
  obtain ⟨h1', h2', h3', h4', h5'⟩ := h'
  have lt : ∀ {x : ℕ}, x ≤ Nat.size Nv → x < K.radix Nv := fun hx => by unfold radix; omega
  have lt' : ∀ {x : ℕ}, x ≤ flog32 Nv → x < K.radix Nv := fun hx => by unfold radix; omega
  have ltd : ∀ {x : ℕ}, x ≤ K.d0 → x < K.radix Nv := fun hx => by unfold radix; nlinarith only [hx]
  unfold metaCode at he
  obtain ⟨e1, e5⟩ := radix_step_inj (K.roundCode_lt h5) (K.roundCode_lt h5') he
  obtain ⟨e1, e4⟩ := radix_step_inj (lt' h4) (lt' h4') e1
  obtain ⟨e1, e3⟩ := radix_step_inj (ltd h3) (ltd h3') e1
  obtain ⟨e1, e2⟩ := radix_step_inj (lt h2) (lt h2') e1
  unfold metaKey
  rw [K.roundCode_inj h1 h1' e1, K.roundCode_inj h5 h5' e5, e2, e3, e4]

omit [DecidableEq V] in
theorem roundTop_psc_mem {A : AdmState V} {v : V} (hv : v ∈ A.X) (ρ : Fin K.d0) :
    0 ≤ roundTop A.X (K.psc A.s ρ v) ∧ roundTop A.X (K.psc A.s ρ v) ≤ K.d0 := by
  refine ⟨?_, roundTop_le ⟨v, hv⟩ fun z _ => ?_⟩
  · have := le_roundTop (sc := K.psc A.s ρ v) hv
    rw [psc_self] at this; omega
  · unfold psc; have := K.Dp_le ρ z; omega

theorem roundTop_hsc_mem (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) (l : ℕ) {X : Finset V}
    {v : V} (hv : v ∈ X) (ρ' : Fin K.d0) :
    0 ≤ roundTop X (K.hsc ρ g z W l v ρ') ∧ roundTop X (K.hsc ρ g z W l v ρ') ≤ K.d0 := by
  refine ⟨?_, roundTop_le ⟨v, hv⟩ fun a _ => ?_⟩
  · have := le_roundTop (sc := K.hsc ρ g z W l v ρ') hv
    rw [hsc_self] at this; omega
  · unfold hsc; have := K.Dh_le ρ' a; omega

omit [DecidableEq V] in
theorem ballSel_le (vec : ℕ → ℕ) {Nv : ℕ} (hv : ∀ l, vec l ≤ Nv) :
    (K.ballSel vec).1 ≤ K.d0 ∧ (K.ballSel vec).2 ≤ Nv := by
  classical
  unfold ballSel
  split_ifs with h
  · exact ⟨(Nat.find_spec h).2.1.le, hv _⟩
  · simp

theorem dataOK {A : AdmState V} (hA : A.WF) {Nv : ℕ} (hN : A.X.card ≤ Nv) {v : V}
    (hv : v ∈ A.X) : K.DataOK Nv (K.colorData A v) := by
  unfold colorData
  cases hc : K.prim A v with
  | none => simp [DataOK]
  | some t =>
    obtain ⟨ρ, z, g⟩ := t
    obtain ⟨hw, hg, -⟩ := sigData_spec hc
    simp only [DataOK, Option.mem_def, Option.some.injEq, forall_eq']
    have hsel := K.ballSel_le (K.ballVec ρ g z (admFrozen A z) A.X v) (Nv := flog32 Nv)
      (fun l => flog32_mono ((Finset.card_le_card (Finset.filter_subset _ _)).trans hN))
    refine ⟨?_, ?_, hsel.1, hsel.2, ?_⟩
    · rw [hg]; exact K.roundTop_psc_mem hv ρ
    · have := K.pot2_le hA hN v
      unfold pot2 at this; rw [hc] at this
      exact this
    · intro t ht
      obtain ⟨ρ', a, g₂⟩ := t
      obtain ⟨-, hg₂, -⟩ := sigData_spec ht
      rw [hg₂]; exact K.roundTop_hsc_mem _ _ _ _ _ hv ρ'

theorem changes_par {I : T.Cell} {v : V} (hv : v ∈ T.X I) :
    K.changes T I v = K.changes T (T.par I) v +
      if v ∈ T.X (T.par I) ∧ K.colorData (T.st (T.par I)) v ≠ K.colorData (T.st I) v
      then 1 else 0 := by
  classical
  have hpos : 0 < T.ht I := by
    by_contra h0
    rw [T.X_top I (by omega)] at hv; simp at hv
  unfold changes
  rw [← T.ht_par I hpos]
  rfl

theorem changes_lt {Nv : ℕ} (hN : ∀ I, (T.X I).card ≤ Nv) {I : T.Cell} {v : V}
    (hv : v ∈ T.X I) : K.changes T I v < K.potMax Nv :=
  lt_of_le_of_lt (K.chgN_le T hN _ hv) (K.potential_le (T.st_wf I) (hN I) hv)

/-- The color of `v` at `I` (blueprint line 1728): a change counter, decremented at every change
of the color data along the path, followed by the encoded metadata. -/
noncomputable def color (Nv : ℕ) (I : T.Cell) (v : V) : ℕ :=
  (K.potMax Nv - K.changes T I v) * K.radix Nv ^ 5 + K.metaCode Nv (K.colorData (T.st I) v) + 1

/-- The number of colors. -/
def numColors (Nv : ℕ) : ℕ := (K.potMax Nv + 1) * K.radix Nv ^ 5

theorem color_mem {Nv : ℕ} (hN : ∀ I, (T.X I).card ≤ Nv) {I : T.Cell} {v : V}
    (hv : v ∈ T.X I) : 1 ≤ K.color T Nv I v ∧ K.color T Nv I v ≤ K.numColors Nv := by
  refine ⟨by unfold color; omega, ?_⟩
  have h := K.metaCode_lt (K.dataOK (T.st_wf I) (hN I) hv)
  unfold color numColors
  have : (K.potMax Nv - K.changes T I v) ≤ K.potMax Nv := Nat.sub_le _ _
  have : (K.potMax Nv - K.changes T I v) * K.radix Nv ^ 5 ≤ K.potMax Nv * K.radix Nv ^ 5 :=
    Nat.mul_le_mul_right _ this
  nlinarith

/-- Colors do not increase along a path (blueprint line 1730). -/
theorem color_anti {Nv : ℕ} (hN : ∀ I, (T.X I).card ≤ Nv) {I : T.Cell} {v : V}
    (hv : v ∈ T.X (T.par I)) : K.color T Nv I v ≤ K.color T Nv (T.par I) v := by
  have hvI : v ∈ T.X I := (T.le_par I).2.1 hv
  have hrec := K.changes_par T hvI
  have hlt := K.changes_lt T hN hvI
  unfold color
  by_cases hc : K.colorData (T.st (T.par I)) v ≠ K.colorData (T.st I) v
  · have hcond : v ∈ T.X (T.par I) ∧
        K.colorData (T.st (T.par I)) v ≠ K.colorData (T.st I) v := ⟨hv, hc⟩
    split_ifs at hrec
    have hm := K.metaCode_lt (K.dataOK (T.st_wf I) (hN I) hvI)
    have e : K.potMax Nv - K.changes T (T.par I) v = (K.potMax Nv - K.changes T I v) + 1 := by
      omega
    rw [e, add_mul, one_mul]
    omega
  · rw [not_not] at hc
    simp only [hc, ne_eq, not_true_eq_false, and_false, ite_false, add_zero] at hrec
    rw [hrec, hc]

/-- Equal colors have equal metadata (blueprint line 1728). -/
theorem metaKey_eq_of_color_eq {Nv : ℕ} (hN : ∀ I, (T.X I).card ≤ Nv) {I J : T.Cell} {v w : V}
    (hv : v ∈ T.X I) (hw : w ∈ T.X J) (he : K.color T Nv I v = K.color T Nv J w) :
    K.metaKey (K.colorData (T.st I) v) = K.metaKey (K.colorData (T.st J) w) := by
  have h1 := K.metaCode_lt (K.dataOK (T.st_wf I) (hN I) hv)
  have h2 := K.metaCode_lt (K.dataOK (T.st_wf J) (hN J) hw)
  unfold color at he
  have := radix_step_inj (a := K.potMax Nv - K.changes T I v)
    (c := K.potMax Nv - K.changes T J w) h1 h2 (by omega)
  exact K.metaCode_inj (K.dataOK (T.st_wf I) (hN I) hv) (K.dataOK (T.st_wf J) (hN J) hw) this.2

end ColorSetup

/-! ### Profiles and the context pseudometrics -/

/-- Clipping with a shift: `x ≤ y + δ` gives `C(x) ≤ C(y) + δ`. -/
theorem clipW_le_add {T U : ℝ} (hTU : T ≤ U) {x y : WithBot ℤ} {δ : ℕ}
    (h : x ≤ y + (δ : ℤ)) : clipW T U x ≤ clipW T U y + δ := by
  cases x with
  | bot => exact (clipW_mem hTU y).1.trans (le_add_of_nonneg_right (Nat.cast_nonneg _))
  | coe n =>
    cases y with
    | bot => exact absurd h (by simp)
    | coe m =>
      have hnm : n ≤ m + δ := by exact_mod_cast h
      simp only [clipW_coe]
      have : (n : ℝ) ≤ m + δ := by exact_mod_cast hnm
      rcases le_total (m : ℝ) T with h1 | h1 <;> rcases le_total (m : ℝ) U with h2 | h2 <;>
        simp only [max_def, min_def] <;> split_ifs <;> linarith

theorem abs_clipW_sub_le_of {T U : ℝ} (hTU : T ≤ U) {x y : WithBot ℤ} {δ : ℕ}
    (h1 : x ≤ y + (δ : ℤ)) (h2 : y ≤ x + (δ : ℤ)) : |clipW T U x - clipW T U y| ≤ δ := by
  rw [abs_le]
  constructor
  · linarith [clipW_le_add hTU h2]
  · linarith [clipW_le_add hTU h1]

/-- Clipping a clipped value again to a smaller range. -/
theorem clipW_succ {T T' U : ℝ} (hT : T ≤ T') (hT' : T' ≤ U) (x : WithBot ℤ) :
    clipW T' U x = min U (max T' (clipW T U x)) := by
  cases x with
  | bot => simp only [clipW_bot]; rw [max_eq_left hT, min_eq_right hT']
  | coe n =>
    simp only [clipW_coe]
    rcases le_total (n : ℝ) T with h1 | h1 <;> rcases le_total (n : ℝ) T' with h2 | h2 <;>
      rcases le_total (n : ℝ) U with h3 | h3 <;> simp only [max_def, min_def] <;> split_ifs <;>
      linarith

namespace ColorSetup
variable {V : Type*} [DecidableEq V] (K : ColorSetup V)

/-- One term of a profile. -/
noncomputable def profTerm (ρ : Fin K.d0) (s' : ℤ) (w a : V) : WithBot ℤ :=
  if K.dist.d s' w a = ⊤ then ⊥ else
    (((K.b1 * K.Dp ρ w : ℕ) : ℤ) - ((K.dist.d s' w a).toNat : ℤ) : ℤ)

theorem prof_eq (ρ : Fin K.d0) (z : V) (W : Finset V) (a : V) (s' : ℤ) :
    K.prof ρ z W a s' = (W.erase z).sup (fun w => K.profTerm ρ s' w a) := rfl

omit [DecidableEq V] in
theorem profTerm_mono (ρ : Fin K.d0) {s s' : ℤ} (h : s ≤ s') (w a : V) :
    K.profTerm ρ s w a ≤ K.profTerm ρ s' w a := by
  have hd := K.dist.anti h w a
  unfold profTerm
  by_cases h1 : K.dist.d s w a = ⊤
  · simp [h1]
  · have h2 : K.dist.d s' w a ≠ ⊤ := ne_top_of_le_ne_top h1 hd
    simp only [h1, h2, ite_false]
    have : (K.dist.d s' w a).toNat ≤ (K.dist.d s w a).toNat := ENat.toNat_le_toNat hd h1
    exact_mod_cast (by omega : ((K.b1 * K.Dp ρ w : ℕ) : ℤ) - ((K.dist.d s w a).toNat : ℤ) ≤
      ((K.b1 * K.Dp ρ w : ℕ) : ℤ) - ((K.dist.d s' w a).toNat : ℤ))

/-- Profiles increase with depth. -/
theorem prof_mono (ρ : Fin K.d0) (z : V) (W : Finset V) (a : V) {s s' : ℤ} (h : s ≤ s') :
    K.prof ρ z W a s ≤ K.prof ρ z W a s' :=
  Finset.sup_mono_fun fun w _ => K.profTerm_mono ρ h w a

omit [DecidableEq V] in
theorem profTerm_le_add (ρ : Fin K.d0) (s : ℤ) (w a b : V) {δ : ℕ} (hab : K.dist.d s a b = δ) :
    K.profTerm ρ s w a ≤ K.profTerm ρ s w b + (δ : ℤ) := by
  unfold profTerm
  by_cases h1 : K.dist.d s w a = ⊤
  · simp [h1]
  · have htri := K.dist.triangle s w a b
    have h2 : K.dist.d s w b ≠ ⊤ := by
      intro h; rw [h, hab] at htri
      exact h1 (by simpa using htri)
    simp only [h1, h2, ite_false]
    rw [hab] at htri
    have : (K.dist.d s w b).toNat ≤ (K.dist.d s w a).toNat + δ := by
      have := ENat.toNat_le_toNat htri (by simp [h1])
      simpa [ENat.toNat_add h1 (ENat.natCast_ne_top δ)] using this
    rw [← WithBot.coe_add]
    exact WithBot.coe_le_coe.mpr (by omega)

/-- Profiles are `1`-Lipschitz in the vertex for the graph distance at the same depth. -/
theorem prof_le_add (ρ : Fin K.d0) (z : V) (W : Finset V) (s : ℤ) {a b : V} {δ : ℕ}
    (hab : K.dist.d s a b = δ) : K.prof ρ z W a s ≤ K.prof ρ z W b s + (δ : ℤ) := by
  rw [prof_eq, prof_eq]
  apply Finset.sup_le
  intro w hw
  exact (K.profTerm_le_add ρ s w a b hab).trans
    (add_le_add (Finset.le_sup (f := fun w => K.profTerm ρ s w b) hw) le_rfl)

theorem profTerm_le_prof (ρ : Fin K.d0) {z : V} {W : Finset V} {w : V} (hw : w ∈ W) (hwz : w ≠ z)
    (a : V) (s : ℤ) : K.profTerm ρ s w a ≤ K.prof ρ z W a s :=
  Finset.le_sup (f := fun w => K.profTerm ρ s w a) (Finset.mem_erase.mpr ⟨hwz, hw⟩)

/-- The clipped profile difference whose supremum defines the context pseudometric. -/
noncomputable def clipDiff (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) (l : ℕ) (a b : V)
    (s' : ℤ) : ℝ :=
  |clipW (K.Tl g l) (K.Ul g) (K.prof ρ z W a s') - clipW (K.Tl g l) (K.Ul g) (K.prof ρ z W b s')|

omit [DecidableEq V] in
theorem Tl_le_Ul (g : ℤ) {l : ℕ} (hl : l ≤ 2 * K.d0) : K.Tl g l ≤ K.Ul g := by
  unfold Tl Ul
  rcases Nat.eq_zero_or_pos K.d0 with h0 | h0
  · simp [h0]; nlinarith [(Nat.cast_nonneg K.b1 : (0 : ℝ) ≤ K.b1)]
  · have hb : (0 : ℝ) ≤ K.b1 := Nat.cast_nonneg _
    have hd : (0 : ℝ) < 2 * K.d0 := by positivity
    have : (l : ℝ) * K.b1 / (2 * K.d0) ≤ K.b1 := by
      rw [div_le_iff₀ hd]
      have : (l : ℝ) ≤ 2 * K.d0 := by exact_mod_cast hl
      nlinarith
    linarith

theorem clipDiff_le (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) {l : ℕ} (hl : l ≤ 2 * K.d0)
    (a b : V) (s' : ℤ) : K.clipDiff ρ g z W l a b s' ≤ K.Ul g - K.Tl g l := by
  have hTU := K.Tl_le_Ul g hl
  have h1 := clipW_mem hTU (K.prof ρ z W a s')
  have h2 := clipW_mem hTU (K.prof ρ z W b s')
  unfold clipDiff
  rw [abs_le]; constructor <;> linarith

theorem lowMet_eq (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) (l : ℕ) (a b : V) :
    K.lowMet ρ g z W l a b = ⨆ s', K.clipDiff ρ g z W l a b s' := rfl

theorem clipDiff_le_lowMet (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) {l : ℕ}
    (hl : l ≤ 2 * K.d0) (a b : V) (s' : ℤ) :
    K.clipDiff ρ g z W l a b s' ≤ K.lowMet ρ g z W l a b :=
  le_ciSup (f := K.clipDiff ρ g z W l a b) ⟨K.Ul g - K.Tl g l, by
    rintro _ ⟨s, rfl⟩; exact K.clipDiff_le ρ g z W hl a b s⟩ s'

theorem lowMet_le_of (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) (l : ℕ) (a b : V) {c : ℝ}
    (h : ∀ s', K.clipDiff ρ g z W l a b s' ≤ c) : K.lowMet ρ g z W l a b ≤ c :=
  ciSup_le h

theorem lowMet_nonneg (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) {l : ℕ} (hl : l ≤ 2 * K.d0)
    (a b : V) : 0 ≤ K.lowMet ρ g z W l a b :=
  (abs_nonneg _).trans (K.clipDiff_le_lowMet ρ g z W hl a b 0)

theorem lowMet_symm (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) (l : ℕ) (a b : V) :
    K.lowMet ρ g z W l a b = K.lowMet ρ g z W l b a := by
  simp only [lowMet_eq, clipDiff, abs_sub_comm]

theorem lowMet_triangle (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) {l : ℕ}
    (hl : l ≤ 2 * K.d0) (a b c : V) :
    K.lowMet ρ g z W l a c ≤ K.lowMet ρ g z W l a b + K.lowMet ρ g z W l b c := by
  apply K.lowMet_le_of
  intro s'
  have h1 := K.clipDiff_le_lowMet ρ g z W hl a b s'
  have h2 := K.clipDiff_le_lowMet ρ g z W hl b c s'
  unfold clipDiff at h1 h2 ⊢
  exact (abs_sub_le _ _ _).trans (add_le_add h1 h2)

/-- The pseudometrics decrease in `l` (blueprint line 1738). -/
theorem lowMet_succ_le (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) {l : ℕ}
    (hl : l + 1 ≤ 2 * K.d0) (a b : V) :
    K.lowMet ρ g z W (l + 1) a b ≤ K.lowMet ρ g z W l a b := by
  have hT : K.Tl g l ≤ K.Tl g (l + 1) := by
    unfold Tl
    have hb : (0 : ℝ) ≤ K.b1 := Nat.cast_nonneg _
    have : (l : ℝ) * K.b1 / (2 * K.d0) ≤ ((l + 1 : ℕ) : ℝ) * K.b1 / (2 * K.d0) := by
      apply div_le_div_of_nonneg_right _ (by positivity)
      push_cast; nlinarith
    linarith
  have hT' := K.Tl_le_Ul g hl
  apply K.lowMet_le_of
  intro s'
  refine le_trans ?_ (K.clipDiff_le_lowMet ρ g z W (by omega) a b s')
  unfold clipDiff
  rw [clipW_succ hT hT', clipW_succ hT hT' (K.prof ρ z W b s')]
  refine (abs_min_sub_min_le_max _ _ _ _).trans (max_le (by simp) ?_)
  exact (abs_max_sub_max_le_max _ _ _ _).trans (max_le (by simp [abs_nonneg]) le_rfl)

end ColorSetup

namespace AdmTree
variable {V : Type*} (T : AdmTree V)

/-! ### Historical masks (blueprint lines 1748-1771) -/

/-- `I₀` is an ancestor of `I` (or `I` itself). -/
def Anc (I₀ I : T.Cell) : Prop := ∃ n : ℕ, T.par^[n] I = I₀

theorem anc_le {I₀ I : T.Cell} (h : T.Anc I₀ I) : (T.st I₀).Le (T.st I) := by
  obtain ⟨n, rfl⟩ := h
  induction n generalizing I with
  | zero => exact AdmState.Le.refl _
  | succ n ih =>
    rw [Function.iterate_succ_apply]
    exact (ih (I := T.par I)).trans (T.st_le_par I)

theorem anc_refl (I : T.Cell) : T.Anc I I := ⟨0, rfl⟩

theorem anc_trans {I₁ I₂ I₃ : T.Cell} (h₁ : T.Anc I₁ I₂) (h₂ : T.Anc I₂ I₃) : T.Anc I₁ I₃ := by
  obtain ⟨n, rfl⟩ := h₁
  obtain ⟨m, rfl⟩ := h₂
  exact ⟨n + m, by rw [Function.iterate_add_apply]⟩

/-- Two ancestors of one cell are comparable. -/
theorem anc_total {I₁ I₂ I : T.Cell} (h₁ : T.Anc I₁ I) (h₂ : T.Anc I₂ I) :
    T.Anc I₁ I₂ ∨ T.Anc I₂ I₁ := by
  obtain ⟨n, rfl⟩ := h₁
  obtain ⟨m, rfl⟩ := h₂
  rcases le_total n m with h | h
  · right; exact ⟨m - n, by rw [← Function.iterate_add_apply]; congr 1; omega⟩
  · left; exact ⟨n - m, by rw [← Function.iterate_add_apply]; congr 1; omega⟩

end AdmTree

/-- The numerical relations of blueprint lines 1714-1717 used by the masks:
`b₂ = 100 (H_max + 1)`, `b₁ = d₀^{10} b₂ (H_max + 1)` and `d₀ ≥ 8` (the blueprint has `d₀ ≥ 1000
    log 2`). -/
structure ColorParams {V : Type*} (K : ColorSetup V) (Hmax : ℕ) : Prop where
  hb2 : K.b2 = 100 * (Hmax + 1)
  hb1 : K.b1 = K.d0 ^ 10 * K.b2 * (Hmax + 1)
  hd0 : 8 ≤ K.d0

namespace ColorSetup
variable {V : Type*} [DecidableEq V] (K : ColorSetup V)

omit [DecidableEq V] in
/-- The winner of a successful primary round is at true score above `(g - 1) b₁`. -/
theorem prim_winner_dist {A : AdmState V} {v : V} (hv : v ∈ A.X) {ρ : Fin K.d0} {z : V} {g : ℤ}
    (hc : K.prim A v = some (ρ, z, g)) (hb : 0 < K.b1) :
    ∃ k : ℕ, K.dist.d A.s z v = k ∧ (g - 1) * K.b1 < K.b1 * K.Dp ρ z - k := by
  obtain ⟨⟨hz, hzg, -⟩, hg, -⟩ := sigData_spec hc
  have hg0 := (K.roundTop_psc_mem hv ρ).1
  rw [← hg] at hg0
  rw [← hzg] at hg
  unfold psc at hg
  have hcap : capDiv (K.dist.d A.s z v) K.b1 (K.d0 + 6) < K.d0 + 6 := by
    have := K.Dp_le ρ z; omega
  obtain ⟨hne, hq⟩ := capDiv_lt_cap hcap
  refine ⟨(K.dist.d A.s z v).toNat, (ENat.natCast_toNat hne).symm, ?_⟩
  rw [hq] at hg
  have h1 := Nat.lt_div_mul_add (a := (K.dist.d A.s z v).toNat) hb
  have hqe : (((K.dist.d A.s z v).toNat / K.b1 : ℕ) : ℤ) = (K.Dp ρ z : ℤ) - g := by omega
  have h2 : (((K.dist.d A.s z v).toNat : ℕ) : ℤ) < ((K.Dp ρ z : ℤ) - g + 1) * K.b1 := by
    have h1' : ((K.dist.d A.s z v).toNat : ℤ) <
        (((K.dist.d A.s z v).toNat / K.b1 : ℕ) : ℤ) * K.b1 + K.b1 := by exact_mod_cast h1
    rw [hqe] at h1'; linarith
  nlinarith only [h2]

omit [DecidableEq V] in
/-- Rival terms at a successful center are at most `(g - 5) b₁` at all earlier depths. -/
theorem rival_term_le {A : AdmState V} {v : V} (hv : v ∈ A.X) {ρ : Fin K.d0} {z : V} {g : ℤ}
    (hc : K.prim A v = some (ρ, z, g)) {w : V} (hw : w ∈ A.X) (hwz : w ≠ z) {s' : ℤ}
    (hs : s' ≤ A.s) : K.profTerm ρ s' w v ≤ (((g - 5) * K.b1 : ℤ) : WithBot ℤ) := by
  obtain ⟨⟨hz, hzg, hgap⟩, hg, -⟩ := sigData_spec hc
  have hr := hgap w hw hwz
  have hg0 := (K.roundTop_psc_mem hv ρ).1
  rw [← hg] at hr hg0
  refine (K.profTerm_mono ρ hs w v).trans ?_
  unfold profTerm
  split_ifs with htop
  · exact bot_le
  · unfold psc at hr
    have hw0 := K.Dp_le ρ w
    have hq : (K.Dp ρ w : ℤ) - g + 5 ≤ ((K.dist.d A.s w v).toNat / K.b1 : ℕ) := by
      unfold capDiv at hr
      simp only [htop, ite_false] at hr
      have := min_le_left ((K.dist.d A.s w v).toNat / K.b1) (K.d0 + 6)
      omega
    have h1 := Nat.div_mul_le_self (K.dist.d A.s w v).toNat K.b1
    apply WithBot.coe_le_coe.mpr
    have : (((K.dist.d A.s w v).toNat / K.b1 : ℕ) : ℤ) * K.b1 ≤ (K.dist.d A.s w v).toNat := by
      exact_mod_cast h1
    push_cast
    nlinarith only [(Nat.cast_nonneg K.b1 : (0 : ℤ) ≤ K.b1), hq, this]

theorem prof_center_le {A : AdmState V} {v : V} (hv : v ∈ A.X) {ρ : Fin K.d0} {z : V} {g : ℤ}
    (hc : K.prim A v = some (ρ, z, g)) {W : Finset V} (hW : W ⊆ A.X) {s' : ℤ} (hs : s' ≤ A.s) :
    K.prof ρ z W v s' ≤ (((g - 5) * K.b1 : ℤ) : WithBot ℤ) := by
  rw [prof_eq]
  apply Finset.sup_le
  intro w hw
  obtain ⟨hwz, hwW⟩ := Finset.mem_erase.mp hw
  exact K.rival_term_le hv hc (hW hwW) hwz hs

theorem clipW_eq_low {T U : ℝ} (hTU : T ≤ U) {x : WithBot ℤ} {c : ℤ} (hx : x ≤ (c : WithBot ℤ))
    (hc : (c : ℝ) ≤ T) : clipW T U x = T := by
  cases x with
  | bot => rfl
  | coe n =>
    have : (n : ℝ) ≤ c := by exact_mod_cast WithBot.coe_le_coe.mp hx
    simp only [clipW_coe]
    rw [max_eq_left (by linarith), min_eq_right hTU]

omit [DecidableEq V] in
theorem Tl_ge (g : ℤ) (l : ℕ) : ((g - 3) * K.b1 : ℝ) ≤ K.Tl g l := by
  unfold Tl
  have : (0 : ℝ) ≤ l * K.b1 / (2 * K.d0) := by positivity
  linarith

/-- Blueprint lem:masks, first assertion (pseudometric part): at a successful center, every
present vertex within graph distance `h ≤ 2 b₁` has context distance at most `h` for every
`l ≤ 2 d₀`. -/
theorem lowMet_center_le {A : AdmState V} {v : V} (hv : v ∈ A.X) {ρ : Fin K.d0} {z : V} {g : ℤ}
    (hc : K.prim A v = some (ρ, z, g)) {W : Finset V} (hW : W ⊆ A.X) {l : ℕ} (hl : l ≤ 2 * K.d0)
    {b : V} {δ : ℕ} (hbv : K.dist.d A.s b v = δ) (hδ : δ ≤ 2 * K.b1) :
    K.lowMet ρ g z W l b v ≤ δ := by
  have hTU := K.Tl_le_Ul g hl
  apply K.lowMet_le_of
  intro s'
  unfold clipDiff
  rcases le_total s' A.s with hs | hs
  · -- both profiles are below `T_l`
    have hv' := K.prof_center_le hv hc hW hs
    have hb' : K.prof ρ z W b s' ≤ (((g - 5) * K.b1 + δ : ℤ) : WithBot ℤ) := by
      refine (K.prof_mono ρ z W b hs).trans ((K.prof_le_add ρ z W A.s hbv).trans ?_)
      have := K.prof_center_le hv hc hW (le_refl A.s)
      rw [WithBot.coe_add]
      exact add_le_add this le_rfl
    have hT := K.Tl_ge g l
    have e1 := clipW_eq_low hTU hv' (by push_cast; nlinarith [(Nat.cast_nonneg K.b1 : (0:ℝ) ≤
        K.b1)])
    have e2 := clipW_eq_low hTU hb' (by
      push_cast
      have : (δ : ℝ) ≤ 2 * K.b1 := by exact_mod_cast hδ
      linarith)
    rw [e1, e2]; simp
  · -- persistence of the graph distance
    have hle := K.dist.anti hs b v
    rw [hbv] at hle
    obtain ⟨δ', hδ'⟩ : ∃ δ' : ℕ, K.dist.d s' b v = δ' :=
      ⟨(K.dist.d s' b v).toNat,
        (ENat.natCast_toNat (ne_top_of_le_ne_top (ENat.natCast_ne_top δ) hle)).symm⟩
    have hδδ : δ' ≤ δ := by rw [hδ'] at hle; exact_mod_cast hle
    have hvb : K.dist.d s' v b = δ' := by rw [K.dist.symm]; exact hδ'
    have := abs_clipW_sub_le_of hTU (K.prof_le_add ρ z W s' hδ') (K.prof_le_add ρ z W s' hvb)
    exact this.trans (by exact_mod_cast hδδ)

/-- Unfolding the color data of a successful primary round. -/
theorem colorData_eq_some {A : AdmState V} {v : V} {ρ : Fin K.d0} {z : V} {g : ℤ} {m : ℕ}
    {ls : ℕ × ℕ} {hd : Option (Fin K.d0 × V × ℤ)}
    (h : K.colorData A v = (some (ρ, z, g), m, ls, hd)) :
    K.prim A v = some (ρ, z, g) ∧ m = admLevel A z ∧
    ls = K.ballSel (K.ballVec ρ g z (admFrozen A z) A.X v) ∧
    hd = sigData (roundSig A.X (fun ρ' => K.hsc ρ g z (admFrozen A z) ls.1 v ρ')) := by
  unfold colorData at h
  cases hc : K.prim A v with
  | none => rw [hc] at h; simp at h
  | some t =>
    obtain ⟨ρ₀, z₀, g₀⟩ := t
    rw [hc] at h
    simp only [Prod.mk.injEq, Option.some.injEq] at h
    obtain ⟨⟨rfl, rfl, rfl⟩, rfl, rfl, rfl⟩ := h
    exact ⟨rfl, rfl, rfl, rfl⟩

omit [DecidableEq V] in
theorem ballSel_spec {vec : ℕ → ℕ} {l n : ℕ} (h : K.ballSel vec = (l, n)) (hl : 1 ≤ l) :
    l < K.d0 ∧ vec l = n ∧ vec (l + 1) = n := by
  classical
  unfold ballSel at h
  split_ifs at h with hex
  · simp only [Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    exact ⟨(Nat.find_spec hex).2.1, rfl, (Nat.find_spec hex).2.2.symm⟩
  · simp only [Prod.mk.injEq] at h; omega

/-- A successful color datum: both rounds marked and a ball level `l ≥ 1` selected. -/
def Success (c : Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) × Option (Fin K.d0 × V × ℤ)) : Prop :=
  ∃ ρ z g m l n ρ' a g₂, c = (some (ρ, z, g), m, (l, n), some (ρ', a, g₂)) ∧ 1 ≤ l

/-- The mask predicate `eq:ball-mask` for a vertex `b` at depth `s` with pad `h`, relative to a
historical central vertex whose (successful) color data are `c` and whose frozen prefix is `W`. -/
def MaskPred (c : Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) × Option (Fin K.d0 × V × ℤ))
    (W : Finset V) (v₀ : V) (s : ℤ) (b : V) (h : ℕ) : Prop :=
  ∃ ρ z g m l n ρ' a g₂, c = (some (ρ, z, g), m, (l, n), some (ρ', a, g₂)) ∧ 1 ≤ l ∧
    (∃ k : ℕ, K.dist.d s z b = k ∧ (g - 1) * K.b1 - h ≤ K.b1 * K.Dp ρ z - k) ∧
    K.lowMet ρ g z W (l + 1) b v₀ ≤ h ∧ K.lowMet ρ g z W l b v₀ ≤ 10 * K.Rl l * h

variable (T : AdmTree V)

/-- The group of a central vertex: its color and complete color data (winners, levels and
rounds; the frozen prefix and cohort block are determined by these along a path). -/
noncomputable def grp (Nv : ℕ) (I : T.Cell) (v : V) :
    ℕ × (Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) × Option (Fin K.d0 × V × ℤ)) :=
  (K.color T Nv I v, K.colorData (T.st I) v)

/-- The mask `M_{G,h}` at a cell (blueprint eq:ball-mask): present vertices satisfying the mask
predicate for some historical central vertex of the group at or above the cell. -/
def mask (Nv : ℕ) (G : ℕ × (Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) × Option (Fin K.d0 × V × ℤ)))
    (h : ℕ) (I : T.Cell) : Set V :=
  {b | b ∈ T.X I ∧ ∃ I₀, T.Anc I₀ I ∧ ∃ v₀ ∈ T.X I₀, K.grp T Nv I₀ v₀ = G ∧
    K.MaskPred (K.colorData (T.st I₀) v₀) (admFrozen (T.st I₀) (Option.elim
      (K.colorData (T.st I₀) v₀).1 v₀ (fun t => t.2.1))) v₀ (T.depth I) b h}

omit [DecidableEq V] in
theorem Rl_ge_one {Hmax : ℕ} (hP : ColorParams K Hmax) {l : ℕ} (hl : 1 ≤ l) : 1 ≤ K.Rl l := by
  unfold Rl
  have h1 : (1 : ℝ) ≤ l := by exact_mod_cast hl
  have h2 : (1 : ℝ) ≤ K.b2 := by rw [hP.hb2]; push_cast; nlinarith
  have h3 : (1 : ℝ) ≤ K.d0 + 1 := by have : (0 : ℝ) ≤ K.d0 := Nat.cast_nonneg _; linarith
  have : (1 : ℝ) ≤ l * (K.d0 + 1) := by nlinarith
  nlinarith

omit [DecidableEq V] in
theorem b1_pos {Hmax : ℕ} (hP : ColorParams K Hmax) : 0 < K.b1 := by
  rw [hP.hb1, hP.hb2]; have := hP.hd0; positivity

/-- Blueprint lem:masks, first assertion: at an actual use centered at `v`, every present vertex
within `h` graph edges of `v` lies in `M_{G,h}`. -/
theorem mem_mask_of_dist {Hmax : ℕ} (hP : ColorParams K Hmax) (Nv : ℕ) {I : T.Cell} {v : V}
    (hv : v ∈ T.X I) (hs : K.Success (K.colorData (T.st I) v)) {b : V} (hb : b ∈ T.X I)
    {h δ : ℕ} (hbv : K.dist.d (T.depth I) b v = δ) (hδ : δ ≤ h) (hh : h ≤ 2 * K.b1) :
    b ∈ K.mask T Nv (K.grp T Nv I v) h I := by
  obtain ⟨ρ, z, g, m, l, n, ρ', a, g₂, hc, hl⟩ := hs
  obtain ⟨hp, -, hls, -⟩ := K.colorData_eq_some hc
  have hlt := (K.ballSel_spec hls.symm hl).1
  refine ⟨hb, I, T.anc_refl I, v, hv, rfl, ?_⟩
  rw [hc]
  simp only [Option.elim]
  refine ⟨ρ, z, g, m, l, n, ρ', a, g₂, rfl, hl, ?_, ?_, ?_⟩
  · obtain ⟨k, hk, hkg⟩ := K.prim_winner_dist (A := T.st I) hv hp (K.b1_pos hP)
    have htri := K.dist.triangle (T.depth I) z v b
    have hvb : K.dist.d (T.depth I) v b = δ := by rw [K.dist.symm]; exact hbv
    change K.dist.d (T.depth I) z v = k at hk
    rw [hk, hvb] at htri
    obtain ⟨k', hk'⟩ : ∃ k' : ℕ, K.dist.d (T.depth I) z b = k' :=
      ⟨_, (ENat.natCast_toNat (ne_top_of_le_ne_top (by simp) htri)).symm⟩
    rw [hk'] at htri
    have : k' ≤ k + δ := by exact_mod_cast htri
    refine ⟨k', hk', ?_⟩
    nlinarith only [hδ, hkg, this]
  · have hW : admFrozen (T.st I) z ⊆ (T.st I).X := Finset.filter_subset _ _
    exact (K.lowMet_center_le (A := T.st I) hv hp hW (by omega) hbv (by omega)).trans
      (by exact_mod_cast hδ)
  · have hW : admFrozen (T.st I) z ⊆ (T.st I).X := Finset.filter_subset _ _
    have h1 := K.lowMet_center_le (A := T.st I) hv hp hW (l := l) (by omega) hbv (by omega)
    have h2 := K.Rl_ge_one hP hl
    have h3 : (δ : ℝ) ≤ h := by exact_mod_cast hδ
    have h4 : (0 : ℝ) ≤ h := Nat.cast_nonneg _
    nlinarith

end ColorSetup

namespace ColorSetup
variable {V : Type*} [DecidableEq V] (K : ColorSetup V) (T : AdmTree V)

omit [DecidableEq V] in
theorem prim_top_nonneg {A : AdmState V} {v : V} (hv : v ∈ A.X) {ρ : Fin K.d0} {z : V} {g : ℤ}
    (hp : K.prim A v = some (ρ, z, g)) : 0 ≤ g := by
  obtain ⟨-, hg, -⟩ := sigData_spec hp
  rw [hg]; exact (K.roundTop_psc_mem hv ρ).1

/-- Blueprint lem:masks, third assertion: an admitted mask vertex is within graph distance
`(d₀ + 1) b₁ + H_max` of the primary winner (which lemma graph turns into a short path). -/
theorem mask_short_path (Nv : ℕ) {G : ℕ × (Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) ×
    Option (Fin K.d0 × V × ℤ))} {ρ : Fin K.d0} {z : V} {g : ℤ} (hG : G.2.1 = some (ρ, z, g))
    {h : ℕ} {I : T.Cell} {b : V} (hb : b ∈ K.mask T Nv G h I) :
    ∃ k : ℕ, K.dist.d (T.depth I) z b = k ∧ k ≤ (K.d0 + 1) * K.b1 + h := by
  obtain ⟨-, I₀, -, v₀, hv₀, hgrp, hpred⟩ := hb
  obtain ⟨ρ₁, z₁, g₁, m, l, n, ρ', a, g₂, hc, -, ⟨k, hk, hkg⟩, -, -⟩ := hpred
  have hc' : (K.colorData (T.st I₀) v₀).1 = some (ρ, z, g) := by
    rw [← hG, ← hgrp]; rfl
  rw [hc] at hc'
  simp only [Option.some.injEq, Prod.mk.injEq] at hc'
  obtain ⟨rfl, rfl, rfl⟩ := hc'
  obtain ⟨hp, -⟩ := K.colorData_eq_some hc
  have hg0 := K.prim_top_nonneg (A := T.st I₀) hv₀ hp
  have hD := K.Dp_le ρ₁ z₁
  refine ⟨k, hk, ?_⟩
  have : (k : ℤ) ≤ (K.d0 + 1) * K.b1 + h := by
    have : (K.b1 : ℤ) * K.Dp ρ₁ z₁ ≤ K.b1 * K.d0 := by
      exact_mod_cast Nat.mul_le_mul_left _ hD
    nlinarith [(Nat.cast_nonneg K.b1 : (0 : ℤ) ≤ K.b1)]
  exact_mod_cast this

/-- Masks persist to finer cells (blueprint line 1755: the mask increases inside its cohort). -/
theorem mask_mono (Nv : ℕ) {G : ℕ × (Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) ×
    Option (Fin K.d0 × V × ℤ))} {h : ℕ} {I J : T.Cell} (hIJ : T.Anc I J) {b : V}
    (hb : b ∈ K.mask T Nv G h I) : b ∈ K.mask T Nv G h J := by
  obtain ⟨hbI, I₀, hI₀, v₀, hv₀, hgrp, hpred⟩ := hb
  have hle := T.anc_le hIJ
  refine ⟨hle.2.1 hbI, I₀, T.anc_trans hI₀ hIJ, v₀, hv₀, hgrp, ?_⟩
  obtain ⟨ρ, z, g, m, l, n, ρ', a, g₂, hc, hl, ⟨k, hk, hkg⟩, h2, h3⟩ := hpred
  refine ⟨ρ, z, g, m, l, n, ρ', a, g₂, hc, hl, ?_, h2, h3⟩
  have hd := K.dist.anti hle.1 z b
  change K.dist.d (T.depth J) z b ≤ K.dist.d (T.depth I) z b at hd
  rw [hk] at hd
  obtain ⟨k', hk'⟩ : ∃ k' : ℕ, K.dist.d (T.depth J) z b = k' :=
    ⟨_, (ENat.natCast_toNat (ne_top_of_le_ne_top (by simp) hd)).symm⟩
  rw [hk'] at hd
  have : k' ≤ k := by exact_mod_cast hd
  exact ⟨k', hk', by linarith⟩

omit [DecidableEq V] in
theorem b2_pos {Hmax : ℕ} (hP : ColorParams K Hmax) : 0 < K.b2 := by rw [hP.hb2]; positivity

/-- The high winner is within `(d₀ + 1) b₂` of the center in `d^{(l+1)}`. -/
theorem high_winner_close {Hmax : ℕ} (hP : ColorParams K Hmax) {X : Finset V} {v : V}
    (hv : v ∈ X) {ρ : Fin K.d0} {g : ℤ} {z : V} {W : Finset V} {l : ℕ} {ρ' : Fin K.d0} {a : V}
    {g₂ : ℤ} (h : sigData (roundSig X (fun ρ' => K.hsc ρ g z W l v ρ')) = some (ρ', a, g₂))
    (_hl : l + 1 ≤ 2 * K.d0) : K.lowMet ρ g z W (l + 1) a v < (K.d0 + 1) * K.b2 := by
  obtain ⟨⟨ha, hag, -⟩, -, -⟩ := sigData_spec h
  have h0 := (K.roundTop_hsc_mem ρ g z W l hv ρ').1
  rw [← hag] at h0
  unfold hsc at h0
  have hDh := K.Dh_le ρ' a
  have hfl : ⌊K.lowMet ρ g z W (l + 1) a v / K.b2⌋₊ ≤ K.d0 := by
    by_contra hc
    have : min ⌊K.lowMet ρ g z W (l + 1) a v / K.b2⌋₊ (K.d0 + 6) ≥ K.d0 + 1 :=
      le_min (by omega) (by omega)
    omega
  have hb2 : (0 : ℝ) < K.b2 := by exact_mod_cast K.b2_pos hP
  have := Nat.lt_floor_add_one (K.lowMet ρ g z W (l + 1) a v / K.b2)
  have : K.lowMet ρ g z W (l + 1) a v / K.b2 < K.d0 + 1 := by
    have : (⌊K.lowMet ρ g z W (l + 1) a v / K.b2⌋₊ : ℝ) ≤ K.d0 := by exact_mod_cast hfl
    linarith
  rwa [div_lt_iff₀ hb2] at this

omit [DecidableEq V] in
theorem Rl_succ (l : ℕ) : K.Rl (l + 1) = K.Rl l + 10 * (K.d0 + 1) * K.b2 := by
  unfold Rl; push_cast; ring

/-- The ball comparison of blueprint lines 1762-1763: a historical central vertex `v₀` of the
group and the current center `v` are within `2 R_l` in `d^{(l)}`. -/
theorem center_close {Hmax : ℕ} (hP : ColorParams K Hmax) {A₀ A : AdmState V} (hA₀ : A₀.WF)
    (hA : A.WF) (hle : A₀.Le A) {v₀ v : V} (hv₀ : v₀ ∈ A₀.X) (hv : v ∈ A.X)
    (he : K.colorData A₀ v₀ = K.colorData A v) {ρ : Fin K.d0} {z : V} {g : ℤ} {m l n : ℕ}
    {ρ' : Fin K.d0} {a : V} {g₂ : ℤ}
    (hc : K.colorData A v = (some (ρ, z, g), m, (l, n), some (ρ', a, g₂))) (hl : 1 ≤ l) :
    admFrozen A₀ z = admFrozen A z ∧ K.lowMet ρ g z (admFrozen A z) l v₀ v ≤ 2 * K.Rl l := by
  obtain ⟨hp, hm, hls, hhd⟩ := K.colorData_eq_some hc
  obtain ⟨hp₀, hm₀, hls₀, hhd₀⟩ := K.colorData_eq_some (he.trans hc)
  have hz₀ := K.prim_winner hp₀
  have hW : admFrozen A₀ z = admFrozen A z := admFrozen_eq hA₀ hA hle hz₀ (hm₀.symm.trans hm)
  refine ⟨hW, ?_⟩
  rw [hW] at hls₀ hhd₀
  set W := admFrozen A z
  obtain ⟨hld, hvl₀, hvl₀'⟩ := K.ballSel_spec hls₀.symm hl
  obtain ⟨-, hvl, hvl'⟩ := K.ballSel_spec hls.symm hl
  have hl2 : l + 1 ≤ 2 * K.d0 := by omega
  have ha₀ := K.high_winner_close hP hv₀ hhd₀.symm hl2
  have ha := K.high_winner_close hP hv hhd.symm hl2
  set! B₀ := A₀.X.filter (fun x => K.lowMet ρ g z W l x v₀ ≤ K.Rl l)
  set! B₁ := A.X.filter (fun x => K.lowMet ρ g z W l x v ≤ K.Rl l)
  set! B₂ := A.X.filter (fun x => K.lowMet ρ g z W (l + 1) x v ≤ K.Rl (l + 1))
  have hn₀ : flog32 B₀.card = n := hvl₀
  have hn₁ : flog32 B₁.card = n := hvl
  have hn₂ : flog32 B₂.card = n := hvl'
  have hsub₀ : B₀ ⊆ B₂ := by
    intro x hx
    obtain ⟨hxA, hxd⟩ := Finset.mem_filter.mp hx
    refine Finset.mem_filter.mpr ⟨hle.2.1 hxA, ?_⟩
    have t1 := K.lowMet_triangle ρ g z W hl2 x v₀ v
    have t2 := K.lowMet_triangle ρ g z W hl2 v₀ a v
    have t3 := K.lowMet_succ_le ρ g z W hl2 x v₀
    rw [K.lowMet_symm ρ g z W (l + 1) v₀ a] at t2
    rw [K.Rl_succ]
    have e : (10 : ℝ) * (K.d0 + 1) * K.b2 = 10 * ((K.d0 + 1) * K.b2) := by ring
    have : (0 : ℝ) ≤ (K.d0 + 1) * K.b2 := by positivity
    linarith
  have hsub₁ : B₁ ⊆ B₂ := by
    intro x hx
    obtain ⟨hxA, hxd⟩ := Finset.mem_filter.mp hx
    refine Finset.mem_filter.mpr ⟨hxA, ?_⟩
    have := K.lowMet_succ_le ρ g z W hl2 x v
    rw [K.Rl_succ]
    have : (0 : ℝ) ≤ 10 * (K.d0 + 1) * K.b2 := by positivity
    linarith
  have hR := K.Rl_ge_one hP hl
  have hv₀B : v₀ ∈ B₀ := Finset.mem_filter.mpr ⟨hv₀, by rw [K.lowMet_self]; linarith⟩
  have hvB : v ∈ B₁ := Finset.mem_filter.mpr ⟨hv, by rw [K.lowMet_self]; linarith⟩
  by_cases hdisj : Disjoint B₀ B₁
  · exfalso
    have hcard : B₀.card + B₁.card ≤ B₂.card := by
      rw [← Finset.card_union_of_disjoint hdisj]
      exact Finset.card_le_card (Finset.union_subset hsub₀ hsub₁)
    have e0 := pow_flog32_le (Finset.card_pos.mpr ⟨v₀, hv₀B⟩)
    have e1 := pow_flog32_le (Finset.card_pos.mpr ⟨v, hvB⟩)
    have e2 := lt_pow_flog32_succ B₂.card
    rw [hn₀] at e0; rw [hn₁] at e1; rw [hn₂] at e2
    rw [pow_succ, pow_succ, ← mul_assoc] at e2
    have f1 : B₀.card * 2 ^ n + B₁.card * 2 ^ n ≤ B₂.card * 2 ^ n := by
      rw [← add_mul]; exact Nat.mul_le_mul_right _ hcard
    generalize B₀.card * 2 ^ n = x₀ at e0 f1
    generalize B₁.card * 2 ^ n = x₁ at e1 f1
    generalize B₂.card * 2 ^ n = x₂ at e2 f1
    generalize 3 ^ n = q at e0 e1 e2
    omega
  · obtain ⟨x, hx₀, hx₁⟩ := Finset.not_disjoint_iff.mp hdisj
    have d0' := (Finset.mem_filter.mp hx₀).2
    have d1' := (Finset.mem_filter.mp hx₁).2
    have t := K.lowMet_triangle ρ g z W (show l ≤ 2 * K.d0 by omega) v₀ x v
    rw [K.lowMet_symm ρ g z W l v₀ x] at t
    linarith only [d0', d1', t]

end ColorSetup

theorem clipW_eq_of_val {T U : ℝ} (hTU : T ≤ U) {x : WithBot ℤ}
    (h : ∀ n : ℤ, x = n → (n : ℝ) ≤ T) : clipW T U x = T :=
  le_antisymm (clipW_le_of_le le_rfl h) (clipW_mem hTU x).1

theorem val_le_of_clipW {T U c : ℝ} {x : WithBot ℤ} (hc : c < U) (h : clipW T U x ≤ c) :
    ∀ n : ℤ, x = n → (n : ℝ) ≤ c := by
  rintro n rfl
  simp only [clipW_coe] at h
  rcases le_total U (max T n) with h1 | h1
  · rw [min_eq_left h1] at h; linarith
  · rw [min_eq_right h1] at h; exact (le_max_right _ _).trans h

namespace ColorSetup
variable {V : Type*} [DecidableEq V] (K : ColorSetup V) (T : AdmTree V)

omit [DecidableEq V] in
theorem Tl_succ (g : ℤ) (l : ℕ) : K.Tl g (l + 1) = K.Tl g l + K.b1 / (2 * K.d0) := by
  unfold Tl; push_cast; ring

omit [DecidableEq V] in
/-- The numerical inequalities of blueprint lines 1763-1765:
`A_h + 1 ≤ T_{l+1} - T_l` with `A_h = 10 R_l h + 2 R_l`. -/
theorem pad_gap {Hmax : ℕ} (hP : ColorParams K Hmax) {l : ℕ} (hl : l ≤ K.d0) {h : ℕ}
    (hh : h ≤ Hmax) : 10 * K.Rl l * h + 2 * K.Rl l + 1 ≤ (K.b1 : ℝ) / (2 * K.d0) := by
  have hd : (8 : ℝ) ≤ K.d0 := by exact_mod_cast hP.hd0
  have hb2 : (K.b2 : ℝ) = 100 * (Hmax + 1) := by rw [hP.hb2]; push_cast; ring
  have hb1 : (K.b1 : ℝ) = K.d0 ^ 10 * K.b2 * (Hmax + 1) := by rw [hP.hb1]; push_cast; ring
  have hlr : (l : ℝ) ≤ K.d0 := by exact_mod_cast hl
  have hhr : (h : ℝ) ≤ Hmax := by exact_mod_cast hh
  have hH : (0 : ℝ) ≤ Hmax := Nat.cast_nonneg _
  have hl0 : (0 : ℝ) ≤ l := Nat.cast_nonneg _
  have hR : K.Rl l ≤ 10 * K.d0 * (K.d0 + 1) * K.b2 := by
    unfold Rl
    have : (0 : ℝ) ≤ (K.d0 + 1) * K.b2 := by positivity
    nlinarith only [hlr, this]
  have hR0 : 0 ≤ K.Rl l := by unfold Rl; positivity
  have hd0 : (0 : ℝ) < 2 * K.d0 := by linarith
  rw [le_div_iff₀ hd0]
  set B := (K.b2 : ℝ)
  set H := (Hmax : ℝ)
  set d := (K.d0 : ℝ)
  have hB : 100 ≤ B := by rw [hb2]; nlinarith
  have step1 : 10 * K.Rl l * h + 2 * K.Rl l + 1 ≤ 10 * (10 * d * (d + 1) * B) * (H + 1) + 1 := by
    have : 10 * K.Rl l * h + 2 * K.Rl l ≤ 10 * K.Rl l * (H + 1) := by nlinarith only [hR0, hhr]
    have : 10 * K.Rl l * (H + 1) ≤ 10 * (10 * d * (d + 1) * B) * (H + 1) := by gcongr
    linarith
  have step2 : (10 * (10 * d * (d + 1) * B) * (H + 1) + 1) * (2 * d) ≤
      d ^ 10 * B * (H + 1) := by
    have hd2 : d ^ 10 = d ^ 3 * d ^ 7 := by ring
    have h87 : (8 : ℝ) ^ 7 ≤ d ^ 7 := pow_le_pow_left₀ (by norm_num) hd 7
    have hBH : 1 ≤ B * (H + 1) := by nlinarith only [hhr, hb2]
    set P := B * (H + 1) with hPdef
    have e1 : (10 * (10 * d * (d + 1) * B) * (H + 1) + 1) * (2 * d) =
        200 * d ^ 3 * P + 200 * d ^ 2 * P + 2 * d := by rw [hPdef]; ring
    have e2 : 200 * d ^ 2 * P ≤ 25 * d ^ 3 * P := by
      have : (0 : ℝ) ≤ d ^ 2 * P := by positivity
      nlinarith only [hd, this]
    have e3 : 2 * d ≤ 2 * d ^ 3 * P := by
      have : 1 ≤ d ^ 2 := by nlinarith only [hd]
      have : d ≤ d ^ 3 := by nlinarith only [hR0, hd, hR, hB]
      nlinarith only [hd, hBH, e2]
    have : (10 * (10 * d * (d + 1) * B) * (H + 1) + 1) * (2 * d) ≤
        (227 * d ^ 3) * P := by rw [e1]; nlinarith only [hd, hBH, e2]
    have : (227 * d ^ 3) * P ≤ d ^ 3 * d ^ 7 * P := by
      have : (0 : ℝ) ≤ d ^ 3 * P := by positivity
      nlinarith only [hb1, h87]
    rw [hd2]; nlinarith only [hd, h87, e2, e3]
  rw [hb1]
  nlinarith only [hd, step1, step2]

omit [DecidableEq V] in
theorem Tl_le_half (g : ℤ) {l : ℕ} (hl : l ≤ K.d0) (hd : 0 < K.d0) :
    K.Tl g l ≤ (g - 5 / 2) * K.b1 := by
  unfold Tl
  have hb : (0 : ℝ) ≤ K.b1 := Nat.cast_nonneg _
  have hd' : (0 : ℝ) < 2 * K.d0 := by positivity
  have : (l : ℝ) * K.b1 / (2 * K.d0) ≤ K.b1 / 2 := by
    rw [div_le_iff₀ hd']
    have : (l : ℝ) ≤ K.d0 := by exact_mod_cast hl
    nlinarith
  linarith

/-- The data of a use: the center's successful color data and the common frozen prefix. -/
theorem grp_colorData {Nv : ℕ} {I₀ I : T.Cell} {v₀ v : V}
    (h : K.grp T Nv I₀ v₀ = K.grp T Nv I v) :
    K.colorData (T.st I₀) v₀ = K.colorData (T.st I) v := congrArg Prod.snd h

/-- Unpacking a mask membership for the group of a successful center. -/
theorem mask_unpack {Nv : ℕ} {I : T.Cell} {v : V} {ρ : Fin K.d0} {z : V} {g : ℤ} {m l n : ℕ}
    {ρ' : Fin K.d0} {a : V} {g₂ : ℤ}
    (hc : K.colorData (T.st I) v = (some (ρ, z, g), m, (l, n), some (ρ', a, g₂))) {h : ℕ}
    {J : T.Cell} {b : V} (hb : b ∈ K.mask T Nv (K.grp T Nv I v) h J) :
    ∃ I₀, T.Anc I₀ J ∧ ∃ v₀ ∈ T.X I₀, K.colorData (T.st I₀) v₀ = K.colorData (T.st I) v ∧
      K.grp T Nv I₀ v₀ = K.grp T Nv I v ∧
      (∃ k : ℕ, K.dist.d (T.depth J) z b = k ∧ (g - 1) * K.b1 - h ≤ K.b1 * K.Dp ρ z - k) ∧
      K.lowMet ρ g z (admFrozen (T.st I₀) z) (l + 1) b v₀ ≤ h ∧
      K.lowMet ρ g z (admFrozen (T.st I₀) z) l b v₀ ≤ 10 * K.Rl l * h := by
  obtain ⟨-, I₀, hI₀, v₀, hv₀, hgrp, hpred⟩ := hb
  have he := K.grp_colorData T hgrp
  refine ⟨I₀, hI₀, v₀, hv₀, he, hgrp, ?_⟩
  obtain ⟨ρ₁, z₁, g₁, m₁, l₁, n₁, ρ₁', a₁, g₁', hc₁, -, hP1, hP2, hP3⟩ := hpred
  rw [he, hc] at hc₁
  simp only [Prod.mk.injEq, Option.some.injEq] at hc₁
  obtain ⟨⟨rfl, rfl, rfl⟩, rfl, ⟨rfl, rfl⟩, rfl, rfl, rfl⟩ := hc₁
  rw [he, hc] at hP2 hP3
  exact ⟨hP1, hP2, hP3⟩

theorem clip_center_eq {A : AdmState V} {v : V} (hv : v ∈ A.X) {ρ : Fin K.d0} {z : V} {g : ℤ}
    (hp : K.prim A v = some (ρ, z, g)) {l : ℕ} (hl : l ≤ 2 * K.d0) {s' : ℤ} (hs : s' ≤ A.s) :
    clipW (K.Tl g l) (K.Ul g) (K.prof ρ z (admFrozen A z) v s') = K.Tl g l := by
  have hW : admFrozen A z ⊆ A.X := Finset.filter_subset _ _
  apply clipW_eq_low (K.Tl_le_Ul g hl) (K.prof_center_le hv hp hW hs)
  have := K.Tl_ge g l
  have hb : (0 : ℝ) ≤ K.b1 := Nat.cast_nonneg _
  push_cast; nlinarith

/-- `eq:rival-bound` (blueprint lines 1763-1766): at an actual use centered at `v`, every vertex
of the pad-`h` mask has rival profile at most `T_l + A_h`, `A_h = 10 R_l h + 2 R_l`, at all
depths up to the use. -/
theorem rival_bound {Hmax : ℕ} (hP : ColorParams K Hmax) (Nv : ℕ) {I : T.Cell} {v : V}
    (hv : v ∈ T.X I) {ρ : Fin K.d0} {z : V} {g : ℤ} {m l n : ℕ} {ρ' : Fin K.d0} {a : V}
    {g₂ : ℤ} (hc : K.colorData (T.st I) v = (some (ρ, z, g), m, (l, n), some (ρ', a, g₂)))
    (hl : 1 ≤ l) {h : ℕ} (hh : h ≤ Hmax) {b : V} (hb : b ∈ K.mask T Nv (K.grp T Nv I v) h I)
    {s' : ℤ} (hs : s' ≤ T.depth I) :
    ∀ x : ℤ, K.prof ρ z (admFrozen (T.st I) z) b s' = x →
      (x : ℝ) ≤ K.Tl g l + (10 * K.Rl l * h + 2 * K.Rl l) := by
  obtain ⟨hp, -, hls, -⟩ := K.colorData_eq_some hc
  have hld := (K.ballSel_spec hls.symm hl).1
  obtain ⟨I₀, hI₀, v₀, hv₀, he, -, -, -, hP3⟩ := K.mask_unpack T hc hb
  obtain ⟨hW, hcl⟩ := K.center_close hP (T.st_wf I₀) (T.st_wf I) (T.anc_le hI₀) hv₀ hv he hc hl
  rw [hW] at hP3
  have hl2 : l ≤ 2 * K.d0 := by omega
  have hbv := K.lowMet_triangle ρ g z (admFrozen (T.st I) z) hl2 b v₀ v
  have hdiff := K.clipDiff_le_lowMet ρ g z (admFrozen (T.st I) z) hl2 b v s'
  have hcv := K.clip_center_eq (A := T.st I) hv hp hl2 hs
  unfold clipDiff at hdiff
  rw [hcv] at hdiff
  have hup : clipW (K.Tl g l) (K.Ul g) (K.prof ρ z (admFrozen (T.st I) z) b s') ≤
      K.Tl g l + (10 * K.Rl l * h + 2 * K.Rl l) := by
    have := (abs_le.mp (hdiff.trans (hbv.trans (add_le_add hP3 hcl)))).2
    linarith
  apply val_le_of_clipW _ hup
  have hgap := K.pad_gap hP (l := l) (by omega) hh
  have hTU := K.Tl_le_Ul g (l := l + 1) (by omega)
  rw [K.Tl_succ] at hTU
  linarith

/-- Blueprint lem:masks, second assertion (neighbor closure): at an actual use, every present
neighbor of a vertex of `M_{G,h}` belongs to `M_{G,h+1}` when `h < H_max`. -/
theorem mask_neighbor {Hmax : ℕ} (hP : ColorParams K Hmax) (Nv : ℕ) {I : T.Cell} {v : V}
    (hv : v ∈ T.X I) {ρ : Fin K.d0} {z : V} {g : ℤ} {m l n : ℕ} {ρ' : Fin K.d0} {a : V}
    {g₂ : ℤ} (hc : K.colorData (T.st I) v = (some (ρ, z, g), m, (l, n), some (ρ', a, g₂)))
    (hl : 1 ≤ l) {h : ℕ} (hh : h < Hmax) {b b' : V}
    (hb : b ∈ K.mask T Nv (K.grp T Nv I v) h I) (hb' : b' ∈ T.X I) {δ : ℕ}
    (hbb : K.dist.d (T.depth I) b b' = δ) (hδ : δ ≤ 1) :
    b' ∈ K.mask T Nv (K.grp T Nv I v) (h + 1) I := by
  obtain ⟨hp, -, hls, -⟩ := K.colorData_eq_some hc
  have hld := (K.ballSel_spec hls.symm hl).1
  have hrival := K.rival_bound T hP Nv hv hc hl hh.le hb (le_refl (T.depth I))
  obtain ⟨I₀, hI₀, v₀, hv₀, he, hgrp, ⟨k, hk, hkg⟩, hP2, hP3⟩ := K.mask_unpack T hc hb
  obtain ⟨hW, hcl⟩ := K.center_close hP (T.st_wf I₀) (T.st_wf I) (T.anc_le hI₀) hv₀ hv he hc hl
  rw [hW] at hP2 hP3
  set W := admFrozen (T.st I) z
  set s := T.depth I
  have hl2 : l + 1 ≤ 2 * K.d0 := by omega
  have hR := K.Rl_ge_one hP hl
  have hgap := K.pad_gap hP (l := l) (by omega) hh.le
  have hTs := K.Tl_succ g l
  have hTU := K.Tl_le_Ul g hl2
  -- profile bound for the neighbor at earlier depths
  have hb'prof : ∀ s'' ≤ s, ∀ x : ℤ, K.prof ρ z W b' s'' = x →
      (x : ℝ) ≤ K.Tl g l + (10 * K.Rl l * h + 2 * K.Rl l) + δ := by
    intro s'' hs'' x hx
    have h1 := K.prof_mono ρ z W b' hs''
    have hb'b : K.dist.d s b' b = δ := by rw [K.dist.symm]; exact hbb
    have h2 := h1.trans (K.prof_le_add ρ z W s hb'b)
    rw [hx] at h2
    cases hy : K.prof ρ z W b s with
    | bot => rw [hy] at h2; simp at h2
    | coe y =>
      rw [hy] at h2
      have : x ≤ y + δ := by exact_mod_cast h2
      have := hrival y hy
      have : (x : ℝ) ≤ y + δ := by exact_mod_cast (by omega : x ≤ y + δ)
      linarith
  -- distances at later depths
  have hlater : ∀ s'' , s ≤ s'' → ∃ δ' : ℕ, K.dist.d s'' b b' = δ' ∧ δ' ≤ δ := by
    intro s'' hs''
    have hle := K.dist.anti hs'' b b'
    rw [hbb] at hle
    refine ⟨(K.dist.d s'' b b').toNat,
      (ENat.natCast_toNat (ne_top_of_le_ne_top (by simp) hle)).symm, ?_⟩
    have := ENat.toNat_le_toNat hle (by simp)
    simpa using this
  -- the context distance of the two neighbors in `d^{(l+1)}`
  have hbb' : K.lowMet ρ g z W (l + 1) b b' ≤ δ := by
    apply K.lowMet_le_of
    intro s''
    unfold clipDiff
    rcases le_total s'' s with hs'' | hs''
    · have e1 : clipW (K.Tl g (l + 1)) (K.Ul g) (K.prof ρ z W b s'') = K.Tl g (l + 1) :=
        clipW_eq_of_val hTU fun x hx => by
          have := K.rival_bound T hP Nv hv hc hl hh.le hb hs'' x hx
          have : (δ : ℝ) ≤ 1 := by exact_mod_cast hδ
          linarith
      have e2 : clipW (K.Tl g (l + 1)) (K.Ul g) (K.prof ρ z W b' s'') = K.Tl g (l + 1) :=
        clipW_eq_of_val hTU fun x hx => by
          have := hb'prof s'' hs'' x hx
          have : (δ : ℝ) ≤ 1 := by exact_mod_cast hδ
          linarith
      rw [e1, e2]; simp
    · obtain ⟨δ', hδ', hδδ⟩ := hlater s'' hs''
      have hδ'' : K.dist.d s'' b' b = δ' := by rw [K.dist.symm]; exact hδ'
      exact (abs_clipW_sub_le_of hTU (K.prof_le_add ρ z W s'' hδ')
        (K.prof_le_add ρ z W s'' hδ'')).trans (by exact_mod_cast hδδ)
  refine ⟨hb', I₀, hI₀, v₀, hv₀, hgrp, ?_⟩
  rw [he, hc]
  simp only [Option.elim]
  rw [hW]
  refine ⟨ρ, z, g, m, l, n, ρ', a, g₂, rfl, hl, ?_, ?_, ?_⟩
  · -- the winner-score predicate
    have htri := K.dist.triangle s z b b'
    rw [hk, hbb] at htri
    obtain ⟨k', hk'⟩ : ∃ k' : ℕ, K.dist.d s z b' = k' :=
      ⟨_, (ENat.natCast_toNat (ne_top_of_le_ne_top (by simp) htri)).symm⟩
    rw [hk'] at htri
    have : k' ≤ k + δ := by exact_mod_cast htri
    refine ⟨k', hk', ?_⟩
    push_cast; omega
  · -- `d^{(l+1)}(b', v₀) ≤ h + 1`
    have t := K.lowMet_triangle ρ g z W hl2 b' b v₀
    rw [K.lowMet_symm ρ g z W (l + 1) b' b] at t
    have : (δ : ℝ) ≤ 1 := by exact_mod_cast hδ
    push_cast; linarith only [hP2, hbb', t, this]
  · -- `d^{(l)}(b', v₀) ≤ 10 R_l (h + 1)`
    apply K.lowMet_le_of
    intro s''
    have hl1 : l ≤ 2 * K.d0 := by omega
    have hTU' := K.Tl_le_Ul g hl1
    have hδr : (δ : ℝ) ≤ 1 := by exact_mod_cast hδ
    have hh0 : (0 : ℝ) ≤ h := Nat.cast_nonneg _
    rcases le_total s'' s with hs'' | hs''
    · -- both clipped values lie in `[T_l, T_l + A_h + 1]`
      have u1 : clipW (K.Tl g l) (K.Ul g) (K.prof ρ z W b' s'') ≤
          K.Tl g l + (10 * K.Rl l * h + 2 * K.Rl l) + δ :=
        clipW_le_of_le (by nlinarith only [hR]) (hb'prof s'' hs'')
      have l1 := (clipW_mem hTU' (K.prof ρ z W b' s'')).1
      have hd0 := K.clipDiff_le_lowMet ρ g z W hl1 v₀ v s''
      unfold clipDiff at hd0
      rw [K.clip_center_eq (A := T.st I) hv hp hl1 hs''] at hd0
      have u2 := (abs_le.mp (hd0.trans hcl)).2
      have l2 := (clipW_mem hTU' (K.prof ρ z W v₀ s'')).1
      unfold clipDiff
      rw [abs_le]; constructor <;> push_cast <;> nlinarith only [hR, l1, u2, hδr, u1, l2]
    · obtain ⟨δ', hδ', hδδ⟩ := hlater s'' hs''
      have hδ'' : K.dist.d s'' b' b = δ' := by rw [K.dist.symm]; exact hδ'
      have e1 : K.clipDiff ρ g z W l b' b s'' ≤ δ' :=
        abs_clipW_sub_le_of hTU' (K.prof_le_add ρ z W s'' hδ'') (K.prof_le_add ρ z W s'' hδ')
      have e2 := K.clipDiff_le_lowMet ρ g z W hl1 b v₀ s''
      have e3 : K.clipDiff ρ g z W l b' v₀ s'' ≤
          K.clipDiff ρ g z W l b' b s'' + K.clipDiff ρ g z W l b v₀ s'' := by
        unfold clipDiff; exact abs_sub_le _ _ _
      have : (δ' : ℝ) ≤ δ := by exact_mod_cast hδδ
      push_cast; nlinarith only [hP3, hR, hδr, e1, e2, e3, this]

/-- Two adjacent vertices, one of which has small rival profile up to depth `s`, are within
their graph distance in the high pseudometric `d^{(l+1)}`. -/
theorem lowMet_succ_adjacent (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) {l : ℕ}
    (hl2 : l + 1 ≤ 2 * K.d0) {A : ℝ} (hgap : K.Tl g l + A + 1 ≤ K.Tl g (l + 1)) {b b' : V}
    {s : ℤ} {δ : ℕ} (hbb : K.dist.d s b b' = δ) (hδ : δ ≤ 1)
    (hrival : ∀ s'' ≤ s, ∀ x : ℤ, K.prof ρ z W b' s'' = x → (x : ℝ) ≤ K.Tl g l + A) :
    K.lowMet ρ g z W (l + 1) b b' ≤ δ := by
  have hTU := K.Tl_le_Ul g hl2
  have hδr : (δ : ℝ) ≤ 1 := by exact_mod_cast hδ
  apply K.lowMet_le_of
  intro s''
  unfold clipDiff
  rcases le_total s'' s with hs'' | hs''
  · have e2 : clipW (K.Tl g (l + 1)) (K.Ul g) (K.prof ρ z W b' s'') = K.Tl g (l + 1) :=
      clipW_eq_of_val hTU fun x hx => by have := hrival s'' hs'' x hx; linarith
    have e1 : clipW (K.Tl g (l + 1)) (K.Ul g) (K.prof ρ z W b s'') = K.Tl g (l + 1) := by
      apply clipW_eq_of_val hTU
      intro x hx
      have h1 := (K.prof_mono ρ z W b hs'').trans (K.prof_le_add ρ z W s hbb)
      rw [hx] at h1
      cases hy : K.prof ρ z W b' s with
      | bot => rw [hy] at h1; simp at h1
      | coe y =>
        rw [hy] at h1
        have h2 : x ≤ y + δ := by exact_mod_cast h1
        have h3 := hrival s le_rfl y hy
        have : (x : ℝ) ≤ y + δ := by exact_mod_cast h2
        linarith
    rw [e1, e2]; simp
  · have hle := K.dist.anti hs'' b b'
    rw [hbb] at hle
    obtain ⟨δ', hδ'⟩ : ∃ δ' : ℕ, K.dist.d s'' b b' = δ' :=
      ⟨_, (ENat.natCast_toNat (ne_top_of_le_ne_top (by simp) hle)).symm⟩
    rw [hδ'] at hle
    have hδδ : δ' ≤ δ := by exact_mod_cast hle
    have hδ'' : K.dist.d s'' b' b = δ' := by rw [K.dist.symm]; exact hδ'
    exact (abs_clipW_sub_le_of hTU (K.prof_le_add ρ z W s'' hδ')
      (K.prof_le_add ρ z W s'' hδ'')).trans (by exact_mod_cast hδδ)

/-- Distinct high winners of one high round and top score at two comparable historical centers
force the centers far apart in `d^{(l+1)}` (blueprint lines 1770-1771). -/
theorem high_far {Hmax : ℕ} (hP : ColorParams K Hmax) {A₁ A₂ : AdmState V} (hle : A₁.Le A₂)
    {v₁ v₂ : V} (hv₁ : v₁ ∈ A₁.X) (_hv₂ : v₂ ∈ A₂.X) {ρ : Fin K.d0} {g : ℤ} {z : V}
    {W : Finset V} {l : ℕ} (hl2 : l + 1 ≤ 2 * K.d0) {ρ' : Fin K.d0} {a₁ a₂ : V} {g₂ : ℤ}
    (h₁ : sigData (roundSig A₁.X (fun ρ' => K.hsc ρ g z W l v₁ ρ')) = some (ρ', a₁, g₂))
    (h₂ : sigData (roundSig A₂.X (fun ρ' => K.hsc ρ g z W l v₂ ρ')) = some (ρ', a₂, g₂))
    (hne : a₁ ≠ a₂) : 4 * (K.b2 : ℝ) < K.lowMet ρ g z W (l + 1) v₁ v₂ := by
  obtain ⟨⟨ha₁, ha₁g, -⟩, hg₁, -⟩ := sigData_spec h₁
  obtain ⟨⟨-, -, hgap₂⟩, hg₂, -⟩ := sigData_spec h₂
  have hr := hgap₂ a₁ (hle.2.1 ha₁) hne
  rw [← hg₂] at hr
  rw [← hg₁] at ha₁g
  have h0 := (K.roundTop_hsc_mem ρ g z W l hv₁ ρ').1
  rw [← hg₁] at h0
  unfold hsc at ha₁g hr
  have hDh := K.Dh_le ρ' a₁
  set x₁ := K.lowMet ρ g z W (l + 1) a₁ v₁
  set x₂ := K.lowMet ρ g z W (l + 1) a₁ v₂
  have hf : ⌊x₁ / K.b2⌋₊ + 5 ≤ ⌊x₂ / K.b2⌋₊ := by
    have h1 : min ⌊x₁ / K.b2⌋₊ (K.d0 + 6) = ⌊x₁ / K.b2⌋₊ := by
      apply min_eq_left; by_contra hc; push Not at hc
      have := min_eq_right hc.le; omega
    have := min_le_left ⌊x₂ / K.b2⌋₊ (K.d0 + 6)
    omega
  have hb2 : (0 : ℝ) < K.b2 := by exact_mod_cast K.b2_pos hP
  have e1 := Nat.lt_floor_add_one (x₁ / K.b2)
  have e2 := Nat.floor_le (div_nonneg (K.lowMet_nonneg ρ g z W hl2 a₁ v₂) hb2.le)
  have hff : (⌊x₁ / K.b2⌋₊ : ℝ) + 5 ≤ ⌊x₂ / K.b2⌋₊ := by exact_mod_cast hf
  have : x₁ / K.b2 + 4 < x₂ / K.b2 := by linarith
  have hx : x₁ + 4 * K.b2 < x₂ := by
    have := (div_lt_div_iff_of_pos_right hb2).mp (show (x₁ + 4 * K.b2) / K.b2 < x₂ / K.b2 by
      rw [add_div, mul_div_assoc, div_self hb2.ne', mul_one]; linarith only [e1, e2, hff])
    exact this
  have t := K.lowMet_triangle ρ g z W hl2 a₁ v₁ v₂
  linarith only [hx, t]

omit [DecidableEq V] in
theorem admLevel_between {A₀ A A₁ : AdmState V} (hA₀ : A₀.WF) (hA : A.WF) (h₀ : A₀.Le A)
    (h₁ : A.Le A₁) {z : V} (hz : z ∈ A₀.X) {m : ℕ} (hm₀ : admLevel A₀ z = m)
    (hm₁ : admLevel A₁ z = m) : admLevel A z = m :=
  le_antisymm (hm₁ ▸ admLevel_mono hA h₁ (h₀.2.1 hz)) (hm₀ ▸ admLevel_mono hA₀ h₀ hz)

/-- Blueprint lem:masks, fourth assertion (separation): for distinct groups of one color, vertices
of their pad masks on overlapping usable endpoints `I ⊇ J` (each with an actual use below it) are at
graph distance greater than one at the finer endpoint. -/
theorem mask_separation {Hmax : ℕ} (hP : ColorParams K Hmax) (Nv : ℕ)
    (hN : ∀ I, (T.X I).card ≤ Nv) {I J : T.Cell} (hIJ : T.Anc I J) {u₀ : T.Cell}
    (hu₀ : T.Anc I u₀) {v₁ : V} (hv₁ : v₁ ∈ T.X u₀) (hs₁ : K.Success (K.colorData (T.st u₀) v₁))
    {u : T.Cell} (hu : T.Anc J u) {v₂ : V} (hv₂ : v₂ ∈ T.X u)
    (hs₂ : K.Success (K.colorData (T.st u) v₂)) (hcol : K.color T Nv u₀ v₁ = K.color T Nv u v₂)
    (hne : K.grp T Nv u₀ v₁ ≠ K.grp T Nv u v₂) {h h' : ℕ} (hh : h ≤ Hmax) (hh' : h' ≤ Hmax)
    {b b' : V} (hb : b ∈ K.mask T Nv (K.grp T Nv u₀ v₁) h I)
    (hb' : b' ∈ K.mask T Nv (K.grp T Nv u v₂) h' J) :
    ¬ K.dist.d (T.depth J) b b' ≤ 1 := by
  intro hadj
  obtain ⟨ρ, z, g, m, l, n, ρ', a, g₂, hc₁, hl⟩ := hs₁
  obtain ⟨ρ₂, z', g', m', l₂, n₂, ρ₂', a', g₂', hc₂, -⟩ := hs₂
  have hmk := K.metaKey_eq_of_color_eq T hN hv₁ hv₂ hcol
  rw [hc₁, hc₂] at hmk
  simp only [metaKey, Option.map_some, Prod.mk.injEq, Option.some.injEq] at hmk
  obtain ⟨⟨rfl, rfl⟩, rfl, rfl, rfl, rfl, rfl⟩ := hmk
  obtain ⟨δ, hδ⟩ : ∃ δ : ℕ, K.dist.d (T.depth J) b b' = δ :=
    ⟨_, (ENat.natCast_toNat (ne_top_of_le_ne_top (by simp) hadj)).symm⟩
  have hδ1 : δ ≤ 1 := by rw [hδ] at hadj; exact_mod_cast hadj
  have hδr : (δ : ℝ) ≤ 1 := by exact_mod_cast hδ1
  obtain ⟨hp₁, hm₁, hls₁, hhd₁⟩ := K.colorData_eq_some hc₁
  obtain ⟨hp₂, hm₂, hls₂, hhd₂⟩ := K.colorData_eq_some hc₂
  have hld := (K.ballSel_spec hls₁.symm hl).1
  have hl2 : l + 1 ≤ 2 * K.d0 := by omega
  obtain ⟨I₀, hI₀, v₀, hv₀, he₀, -, ⟨k, hk, hkg⟩, hP2, -⟩ := K.mask_unpack T hc₁ hb
  obtain ⟨I₀', hI₀', v₀', hv₀', he₀', -, -, hP2', -⟩ := K.mask_unpack T hc₂ hb'
  have hI₀u₀ := T.anc_trans hI₀ hu₀
  have hI₀'u := T.anc_trans hI₀' hu
  obtain ⟨hW₀, -⟩ := K.center_close hP (T.st_wf I₀) (T.st_wf u₀) (T.anc_le hI₀u₀) hv₀ hv₁ he₀
    hc₁ hl
  obtain ⟨hW₀', -⟩ := K.center_close hP (T.st_wf I₀') (T.st_wf u) (T.anc_le hI₀'u) hv₀' hv₂ he₀'
    hc₂ hl
  rw [hW₀] at hP2
  rw [hW₀'] at hP2'
  have hb'u := K.mask_mono T Nv hu hb'
  have hriv := fun s'' (hs : s'' ≤ T.depth u) => K.rival_bound T hP Nv hv₂ hc₂ hl hh' hb'u hs
  -- cohort levels at the endpoints
  obtain ⟨hp₀, hm₀, -, hhd₀⟩ := K.colorData_eq_some (he₀.trans hc₁)
  obtain ⟨hp₀', hm₀', -, hhd₀'⟩ := K.colorData_eq_some (he₀'.trans hc₂)
  have hzI₀ := K.prim_winner hp₀
  have hzI₀' := K.prim_winner hp₀'
  have hLI : admLevel (T.st I) z = m :=
    admLevel_between (T.st_wf I₀) (T.st_wf I) (T.anc_le hI₀) (T.anc_le hu₀) hzI₀ hm₀.symm
      hm₁.symm
  have hLJ : admLevel (T.st J) z' = m :=
    admLevel_between (T.st_wf I₀') (T.st_wf J) (T.anc_le hI₀') (T.anc_le hu) hzI₀' hm₀'.symm
      hm₂.symm
  have hIu := T.anc_le (T.anc_trans hIJ hu)
  have hJu := T.anc_le hu
  have hzI : z ∈ T.X I := (T.anc_le hI₀).2.1 hzI₀
  have hz'J : z' ∈ T.X J := (T.anc_le hI₀').2.1 hzI₀'
  have hb1H : ((Hmax : ℝ) + 1) ≤ K.b1 := by
    rw [hP.hb1, hP.hb2]; push_cast
    have : (1 : ℝ) ≤ (K.d0 : ℝ) ^ 10 := one_le_pow₀ (by exact_mod_cast (by omega : 1 ≤ K.d0))
    have h0 : (0 : ℝ) ≤ Hmax := Nat.cast_nonneg _
    have h1 : (1 : ℝ) ≤ (K.d0 : ℝ) ^ 10 * (100 * (Hmax + 1)) := by nlinarith only [this]
    calc (Hmax : ℝ) + 1 = 1 * (Hmax + 1) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_right h1 (by positivity)
  have hgap := K.pad_gap hP (l := l) (by omega) hh'
  have hTs := K.Tl_succ g l
  have hhalf := K.Tl_le_half g (l := l + 1) (by omega) (by omega)
  have hTU := K.Tl_le_Ul g hl2
  by_cases hzz : z = z'
  · -- equal primary winners: the high winners differ
    subst hzz
    have haa : a ≠ a' := by
      rintro rfl
      apply hne
      unfold grp
      rw [hcol, hc₁, hc₂]
    have hWI : admFrozen (T.st I) z = admFrozen (T.st u₀) z :=
      admFrozen_eq (T.st_wf I) (T.st_wf u₀) (T.anc_le hu₀) hzI (hLI.trans hm₁)
    have hWJ : admFrozen (T.st J) z = admFrozen (T.st u) z :=
      admFrozen_eq (T.st_wf J) (T.st_wf u) hJu hz'J (hLJ.trans hm₂)
    have hWIJ : admFrozen (T.st I) z = admFrozen (T.st J) z :=
      admFrozen_eq (T.st_wf I) (T.st_wf J) (T.anc_le hIJ) hzI (hLI.trans hLJ.symm)
    set W := admFrozen (T.st u) z with hWdef
    have hW1 : admFrozen (T.st u₀) z = W := by rw [← hWI, hWIJ, hWJ]
    rw [hW1] at hP2
    -- the two mask vertices are close in `d^{(l+1)}`
    have hbu : ∃ δ'' : ℕ, K.dist.d (T.depth u) b b' = δ'' ∧ δ'' ≤ 1 := by
      have hle := K.dist.anti hJu.1 b b'
      change K.dist.d (T.depth u) b b' ≤ K.dist.d (T.depth J) b b' at hle
      rw [hδ] at hle
      refine ⟨_, (ENat.natCast_toNat (ne_top_of_le_ne_top (by simp) hle)).symm, ?_⟩
      have := ENat.toNat_le_toNat hle (by simp)
      simp at this; omega
    obtain ⟨δ'', hδ'', hδ''1⟩ := hbu
    have hbb := K.lowMet_succ_adjacent ρ g z W hl2 (A := 10 * K.Rl l * h' + 2 * K.Rl l)
      (by linarith only [hgap, hTs]) hδ'' hδ''1 (fun s'' hs'' x hx => hriv s'' hs'' x hx)
    have hδ''r : (δ'' : ℝ) ≤ 1 := by exact_mod_cast hδ''1
    have hup : K.lowMet ρ g z W (l + 1) v₀ v₀' ≤ h + 1 + h' := by
      have t1 := K.lowMet_triangle ρ g z W hl2 v₀ b v₀'
      have t2 := K.lowMet_triangle ρ g z W hl2 b b' v₀'
      rw [K.lowMet_symm ρ g z W (l + 1) v₀ b] at t1
      linarith
    -- the historical centers are far apart
    rw [hW₀, hW1] at hhd₀
    rw [hW₀'] at hhd₀'
    have hfar : 4 * (K.b2 : ℝ) < K.lowMet ρ g z W (l + 1) v₀ v₀' := by
      rcases T.anc_total (T.anc_trans hI₀ hIJ) hI₀' with h₀ | h₀
      · exact K.high_far hP (T.anc_le h₀) hv₀ hv₀' hl2 hhd₀.symm hhd₀'.symm haa
      · rw [K.lowMet_symm]
        exact K.high_far hP (T.anc_le h₀) hv₀' hv₀ hl2 hhd₀'.symm hhd₀.symm (Ne.symm haa)
    have hb2 : (K.b2 : ℝ) = 100 * (Hmax + 1) := by rw [hP.hb2]; push_cast; ring
    have : (h : ℝ) ≤ Hmax := by exact_mod_cast hh
    have : (h' : ℝ) ≤ Hmax := by exact_mod_cast hh'
    linarith
  · -- distinct primary winners: the earlier winner is a rival in the later frozen prefix
    have hi : T.pos I z ≤ (T.X I).card - 1 := by
      have := (T.st_wf I).1 z hzI; simp [AdmTree.st] at this; omega
    have hi' : T.pos J z' ≤ (T.X J).card - 1 := by
      have := (T.st_wf J).1 z' hz'J; simp [AdmTree.st] at this; omega
    have hjj : (T.X I).card - 1 ≤ (T.X J).card - 1 :=
      Nat.sub_le_sub_right (Finset.card_le_card (T.anc_le hIJ).2.1) 1
    have hlt := lt_cohortPrefix_of_le hi hi' hjj hLI hLJ
    have hzW : z ∈ admFrozen (T.st u) z' := by
      unfold admFrozen
      rw [hm₂.symm]
      refine Finset.mem_filter.mpr ⟨hIu.2.1 hzI, ?_⟩
      rw [hIu.2.2 z hzI, hJu.2.2 z' hz'J]
      exact hlt
    have hterm := K.profTerm_le_prof ρ hzW hzz b' (T.depth J)
    -- the distance from `z` to `b'` at the finer endpoint
    have hd1 := K.dist.anti (T.anc_le hIJ).1 z b
    change K.dist.d (T.depth J) z b ≤ K.dist.d (T.depth I) z b at hd1
    rw [hk] at hd1
    have htri := K.dist.triangle (T.depth J) z b b'
    rw [hδ] at htri
    have hzb' : K.dist.d (T.depth J) z b' ≤ (k + δ : ℕ) := by
      refine htri.trans ?_
      push_cast
      exact add_le_add hd1 le_rfl
    obtain ⟨k', hk'⟩ : ∃ k' : ℕ, K.dist.d (T.depth J) z b' = k' :=
      ⟨_, (ENat.natCast_toNat (ne_top_of_le_ne_top (by simp) hzb')).symm⟩
    rw [hk'] at hzb'
    have hkk : k' ≤ k + δ := by exact_mod_cast hzb'
    unfold profTerm at hterm
    rw [hk'] at hterm
    simp only [ENat.natCast_ne_top, ite_false, ENat.toNat_natCast] at hterm
    cases hx : K.prof ρ z' (admFrozen (T.st u) z') b' (T.depth J) with
    | bot => rw [hx] at hterm; simp at hterm
    | coe x =>
      rw [hx] at hterm
      have hx1 : ((K.b1 * K.Dp ρ z : ℕ) : ℤ) - k' ≤ x := by exact_mod_cast hterm
      have hx2 := hriv _ hJu.1 x hx
      have : ((g - 1) * K.b1 - h - 1 : ℤ) ≤ x := by push_cast at hx1 hkg; omega
      have : (((g - 1) * K.b1 - h - 1 : ℤ) : ℝ) ≤ x := by exact_mod_cast this
      have : (h : ℝ) ≤ Hmax := by exact_mod_cast hh
      push_cast at *
      nlinarith

end ColorSetup

/-! ### Choice of the delays (blueprint lines 1732-1733)

Delays are truncated geometric: `P(D = n) = 2^{-(n+1)}` for `n < d₀` and `P(D = d₀) = 2^{-d₀}`.
A single round is marked with probability at least `1/66` once `|X| ≤ 2^{d₀ - 5}`: raising the
delay of a top scorer by five marks the round, injectively, at a weight cost at most `2^{-5}`. -/

/-- The truncated geometric weights on `{0, …, d₀}`. -/
noncomputable def geomW (d0 : ℕ) (n : Fin (d0 + 1)) : ℝ :=
  if (n : ℕ) < d0 then (1 / 2 : ℝ) ^ ((n : ℕ) + 1) else (1 / 2 : ℝ) ^ d0

theorem geomW_nonneg (d0 : ℕ) (n : Fin (d0 + 1)) : 0 ≤ geomW d0 n := by
  unfold geomW; split_ifs <;> positivity

theorem sum_range_half_pow (k : ℕ) : ∀ d0 : ℕ, k ≤ d0 →
    ∑ n ∈ Finset.range d0, (if k ≤ n then (1 / 2 : ℝ) ^ (n + 1) else 0) =
      (1 / 2 : ℝ) ^ k - (1 / 2 : ℝ) ^ d0
  | 0, hk => by have : k = 0 := by omega
                subst this; simp
  | d + 1, hk => by
    rw [Finset.sum_range_succ]
    by_cases hkd : k ≤ d
    · rw [sum_range_half_pow k d hkd, ite_eq_left hkd]; ring
    · have hk' : k = d + 1 := by omega
      subst hk'
      rw [ite_eq_right (by omega), Finset.sum_eq_zero (fun n hn => by
        rw [ite_eq_right (by simp at hn; omega)])]
      ring

/-- The tail `P(D ≥ k) = 2^{-k}`. -/
theorem sum_geomW_ge (d0 k : ℕ) (hk : k ≤ d0) :
    ∑ n : Fin (d0 + 1), (if k ≤ (n : ℕ) then geomW d0 n else 0) = (1 / 2 : ℝ) ^ k := by
  set f : ℕ → ℝ := fun n => if k ≤ n then
    (if n < d0 then (1 / 2 : ℝ) ^ (n + 1) else (1 / 2 : ℝ) ^ d0) else 0 with hf
  have e : ∀ n : Fin (d0 + 1), (if k ≤ (n : ℕ) then geomW d0 n else 0) = f n := fun n => by
    simp only [hf, geomW]
  rw [Finset.sum_congr rfl (fun n _ => e n), Fin.sum_univ_eq_sum_range f (d0 + 1),
    Finset.sum_range_succ]
  have e2 : ∑ n ∈ Finset.range d0, f n =
      ∑ n ∈ Finset.range d0, (if k ≤ n then (1 / 2 : ℝ) ^ (n + 1) else 0) :=
    Finset.sum_congr rfl (fun n hn => by
      have := Finset.mem_range.mp hn
      simp only [hf, this, ite_true])
  rw [e2, sum_range_half_pow k d0 hk]
  simp only [hf, hk, lt_irrefl, ite_true, ite_false]
  ring

theorem sum_geomW (d0 : ℕ) : ∑ n : Fin (d0 + 1), geomW d0 n = 1 := by
  have := sum_geomW_ge d0 0 (Nat.zero_le _)
  simpa using this

/-- Raising a delay by five costs at most a factor `2^{-5}` in weight. -/
theorem geomW_add_five {d0 : ℕ} (n : Fin (d0 + 1)) (h : (n : ℕ) + 5 ≤ d0) :
    (1 / 2 : ℝ) ^ 5 * geomW d0 n ≤ geomW d0 ⟨n + 5, by omega⟩ := by
  unfold geomW
  have hn : (n : ℕ) < d0 := by omega
  simp only [hn, ite_true]
  by_cases h' : (n : ℕ) + 5 < d0
  · simp only [h', ite_true]; rw [← pow_add]; apply le_of_eq; ring_nf
  · simp only [h', ite_false]
    have e : (1 / 2 : ℝ) ^ 5 * (1 / 2 : ℝ) ^ ((n : ℕ) + 1) = (1 / 2 : ℝ) ^ ((n : ℕ) + 6) := by
      ring
    rw [e]
    exact pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)

section DelayProbability
variable {V : Type*} [Fintype V] [DecidableEq V]

/-- The product weight of a delay array. -/
noncomputable def cfgW (d0 : ℕ) (D : V → Fin (d0 + 1)) : ℝ := ∏ z, geomW d0 (D z)

omit [DecidableEq V] in
theorem cfgW_nonneg (d0 : ℕ) (D : V → Fin (d0 + 1)) : 0 ≤ cfgW d0 D :=
  Finset.prod_nonneg fun _ _ => geomW_nonneg d0 _

theorem sum_cfgW (d0 : ℕ) : ∑ D : V → Fin (d0 + 1), cfgW d0 D = 1 := by
  unfold cfgW
  rw [← Fintype.prod_sum (fun _ n => geomW d0 n)]
  simp [sum_geomW]

/-- The marginal tail of one coordinate. -/
theorem sum_cfgW_tail (d0 : ℕ) (z₀ : V) {k : ℕ} (hk : k ≤ d0) :
    ∑ D : V → Fin (d0 + 1), (if k ≤ (D z₀ : ℕ) then cfgW d0 D else 0) = (1 / 2 : ℝ) ^ k := by
  have e : ∀ D : V → Fin (d0 + 1), (if k ≤ (D z₀ : ℕ) then cfgW d0 D else 0) =
      ∏ z, (geomW d0 (D z) * if z = z₀ then (if k ≤ (D z : ℕ) then 1 else 0) else 1) := by
    intro D
    unfold cfgW
    rw [Finset.prod_mul_distrib, Finset.prod_ite_eq' Finset.univ z₀,
      ite_eq_left (Finset.mem_univ _)]
    split_ifs <;> simp
  simp only [e]
  rw [← Fintype.prod_sum (fun z n => geomW d0 n * if z = z₀ then (if k ≤ (n : ℕ) then 1 else 0)
    else 1)]
  rw [Finset.prod_eq_single z₀]
  · simp only [ite_true, mul_ite, mul_one, mul_zero]
    exact sum_geomW_ge d0 k hk
  · intro z _ hz
    simp [hz, sum_geomW]
  · simp

/-- The score `D_z - c_z` of a delay array with offsets `c`. -/
def delayScore {d0 : ℕ} (D : V → Fin (d0 + 1)) (c : V → ℕ) (z : V) : ℤ := (D z : ℕ) - (c z : ℤ)

/-- A top scorer of a round. -/
noncomputable def topScorer {d0 : ℕ} (X : Finset V) (hX : X.Nonempty) (c : V → ℕ)
    (D : V → Fin (d0 + 1)) : V :=
  Classical.choose (roundTop_mem hX (delayScore D c))

omit [Fintype V] [DecidableEq V] in
theorem topScorer_spec {d0 : ℕ} (X : Finset V) (hX : X.Nonempty) (c : V → ℕ)
    (D : V → Fin (d0 + 1)) : topScorer X hX c D ∈ X ∧
      delayScore D c (topScorer X hX c D) = roundTop X (delayScore D c) :=
  Classical.choose_spec (roundTop_mem hX (delayScore D c))

/-- Raising the top scorer's delay by five. -/
noncomputable def raiseTop {d0 : ℕ} (X : Finset V) (hX : X.Nonempty) (c : V → ℕ)
    (D : V → Fin (d0 + 1)) : V → Fin (d0 + 1) :=
  if h : (D (topScorer X hX c D) : ℕ) + 5 ≤ d0 then
    Function.update D (topScorer X hX c D) ⟨(D (topScorer X hX c D) : ℕ) + 5, by omega⟩
  else D

omit [Fintype V] in
theorem raiseTop_winner {d0 : ℕ} (X : Finset V) (hX : X.Nonempty) (c : V → ℕ)
    (D : V → Fin (d0 + 1)) (h : (D (topScorer X hX c D) : ℕ) + 5 ≤ d0) :
    RoundWinner X (delayScore (raiseTop X hX c D) c) (topScorer X hX c D) := by
  obtain ⟨hz, hzt⟩ := topScorer_spec X hX c D
  set z := topScorer X hX c D
  have hR : raiseTop X hX c D = Function.update D z ⟨(D z : ℕ) + 5, by omega⟩ := by
    unfold raiseTop; rw [dite_eq_left h]
  have hsz : delayScore (raiseTop X hX c D) c z = roundTop X (delayScore D c) + 5 := by
    rw [hR]; unfold delayScore; simp only [Function.update_self]
    unfold delayScore at hzt; push_cast; omega
  have hso : ∀ y ∈ X, y ≠ z → delayScore (raiseTop X hX c D) c y ≤ roundTop X (delayScore D c) := by
    intro y hy hyz
    rw [hR]; unfold delayScore; rw [Function.update_of_ne hyz]
    exact le_roundTop (sc := delayScore D c) hy
  have htop : roundTop X (delayScore (raiseTop X hX c D) c) = roundTop X (delayScore D c) + 5 := by
    apply le_antisymm
    · apply roundTop_le hX
      intro y hy
      by_cases hyz : y = z
      · rw [hyz, hsz]
      · have := hso y hy hyz; omega
    · rw [← hsz]; exact le_roundTop hz
  refine ⟨hz, by rw [hsz, htop], fun y hy hyz => ?_⟩
  have := hso y hy hyz
  rw [htop]; omega

omit [Fintype V] in
theorem raiseTop_injOn {d0 : ℕ} (X : Finset V) (hX : X.Nonempty) (c : V → ℕ) :
    Set.InjOn (raiseTop (d0 := d0) X hX c)
      {D | (D (topScorer X hX c D) : ℕ) + 5 ≤ d0} := by
  intro D₁ h₁ D₂ h₂ he
  have h₁' : (D₁ (topScorer X hX c D₁) : ℕ) + 5 ≤ d0 := h₁
  have h₂' : (D₂ (topScorer X hX c D₂) : ℕ) + 5 ≤ d0 := h₂
  have w₁ := raiseTop_winner X hX c D₁ h₁
  have w₂ := raiseTop_winner X hX c D₂ h₂
  rw [he] at w₁
  have hz := w₁.unique w₂
  set z := topScorer X hX c D₁
  have e₁ : raiseTop X hX c D₁ = Function.update D₁ z ⟨(D₁ z : ℕ) + 5, by
      have : (D₁ z : ℕ) + 5 ≤ d0 := h₁'; omega⟩ := by unfold raiseTop; rw [dite_eq_left h₁']
  have e₂ : raiseTop X hX c D₂ = Function.update D₂ (topScorer X hX c D₂)
      ⟨(D₂ (topScorer X hX c D₂) : ℕ) + 5, by omega⟩ := by
    unfold raiseTop; rw [dite_eq_left h₂']
  rw [e₁, e₂] at he
  funext y
  have hy := congrFun he y
  simp only [Function.update_apply] at hy
  by_cases hyz : y = z
  · have hyz₂ : y = topScorer X hX c D₂ := hyz.trans hz
    rw [ite_eq_left hyz, ite_eq_left hyz₂] at hy
    rw [hyz]
    have hv := congrArg Fin.val hy
    simp only at hv
    rw [← hz] at hv
    exact Fin.ext (by omega)
  · have hyz₂ : ¬ y = topScorer X hX c D₂ := fun h => hyz (h.trans hz.symm)
    rwa [ite_eq_right hyz, ite_eq_right hyz₂] at hy

theorem cfgW_raiseTop {d0 : ℕ} (X : Finset V) (hX : X.Nonempty) (c : V → ℕ)
    (D : V → Fin (d0 + 1)) (h : (D (topScorer X hX c D) : ℕ) + 5 ≤ d0) :
    (1 / 2 : ℝ) ^ 5 * cfgW d0 D ≤ cfgW d0 (raiseTop X hX c D) := by
  set z := topScorer X hX c D
  have hR : raiseTop X hX c D = Function.update D z ⟨(D z : ℕ) + 5, by omega⟩ := by
    unfold raiseTop; rw [dite_eq_left h]
  rw [hR]
  unfold cfgW
  rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ z),
    ← Finset.mul_prod_erase Finset.univ (fun y => geomW d0 (Function.update D z _ y))
      (Finset.mem_univ z)]
  simp only [Function.update_self]
  have hrest : ∏ y ∈ Finset.univ.erase z,
      geomW d0 (Function.update D z ⟨(D z : ℕ) + 5, by omega⟩ y) =
      ∏ y ∈ Finset.univ.erase z, geomW d0 (D y) :=
    Finset.prod_congr rfl (fun y hy => by rw [Function.update_of_ne (Finset.ne_of_mem_erase hy)])
  rw [hrest, ← mul_assoc]
  exact mul_le_mul_of_nonneg_right (geomW_add_five (D z) h)
    (Finset.prod_nonneg fun y _ => geomW_nonneg d0 _)

open Classical in
/-- Blueprint lines 1732-1733: a single round is marked with probability at least `1/66` when
`|X| 2^{4 - d₀} ≤ 1/2`. -/
theorem round_unmarked_le {d0 : ℕ} (hd : 5 ≤ d0) (X : Finset V) (hX : X.Nonempty) (c : V → ℕ)
    (hq : (X.card : ℝ) * (1 / 2 : ℝ) ^ (d0 - 4) ≤ 1 / 2) :
    ∑ D : V → Fin (d0 + 1), (if RoundMarked X (delayScore D c) then 0 else cfgW d0 D) ≤
      65 / 66 := by
  set M := Finset.univ.filter (fun D : V → Fin (d0 + 1) => RoundMarked X (delayScore D c))
  set U := Finset.univ.filter (fun D : V → Fin (d0 + 1) => ¬ RoundMarked X (delayScore D c))
  set U₁ := U.filter (fun D => (D (topScorer X hX c D) : ℕ) + 5 ≤ d0)
  set U₂ := U.filter (fun D => ¬ (D (topScorer X hX c D) : ℕ) + 5 ≤ d0)
  have hsum : ∑ D, (if RoundMarked X (delayScore D c) then 0 else cfgW d0 D) =
      ∑ D ∈ U, cfgW d0 D := by
    rw [Finset.sum_filter]; apply Finset.sum_congr rfl; intro D _; split_ifs <;> rfl
  have htot : ∑ D ∈ M, cfgW d0 D + ∑ D ∈ U, cfgW d0 D = 1 := by
    rw [← sum_cfgW (V := V) d0, ← Finset.sum_filter_add_sum_filter_not Finset.univ
      (fun D : V → Fin (d0 + 1) => RoundMarked X (delayScore D c))]
  have hU : ∑ D ∈ U, cfgW d0 D = ∑ D ∈ U₁, cfgW d0 D + ∑ D ∈ U₂, cfgW d0 D :=
    (Finset.sum_filter_add_sum_filter_not U _ _).symm
  -- the injection into the marked arrays
  have h1 : (1 / 2 : ℝ) ^ 5 * ∑ D ∈ U₁, cfgW d0 D ≤ ∑ D ∈ M, cfgW d0 D := by
    rw [Finset.mul_sum]
    calc ∑ D ∈ U₁, (1 / 2 : ℝ) ^ 5 * cfgW d0 D
        ≤ ∑ D ∈ U₁, cfgW d0 (raiseTop X hX c D) := Finset.sum_le_sum fun D hD =>
          cfgW_raiseTop X hX c D (Finset.mem_filter.mp hD).2
      _ = ∑ D ∈ U₁.image (raiseTop X hX c), cfgW d0 D := by
          rw [Finset.sum_image]
          intro D₁ h₁ D₂ h₂ he
          exact raiseTop_injOn X hX c (Finset.mem_filter.mp h₁).2 (Finset.mem_filter.mp h₂).2 he
      _ ≤ ∑ D ∈ M, cfgW d0 D := by
          apply Finset.sum_le_sum_of_subset_of_nonneg
          · intro D hD
            obtain ⟨D', hD', rfl⟩ := Finset.mem_image.mp hD
            exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,
              ⟨_, raiseTop_winner X hX c D' (Finset.mem_filter.mp hD').2⟩⟩
          · intro D _ _; exact cfgW_nonneg d0 D
  -- the arrays whose top scorer has a large delay
  have h2 : ∑ D ∈ U₂, cfgW d0 D ≤ X.card * (1 / 2 : ℝ) ^ (d0 - 4) := by
    calc ∑ D ∈ U₂, cfgW d0 D
        ≤ ∑ D, ∑ z ∈ X, (if d0 - 4 ≤ (D z : ℕ) then cfgW d0 D else 0) := by
          rw [← Finset.sum_filter_add_sum_filter_not Finset.univ (fun D => D ∈ U₂)]
          refine le_add_of_le_of_nonneg ?_ (Finset.sum_nonneg fun D _ =>
            Finset.sum_nonneg fun z _ => ite_nonneg (cfgW_nonneg d0 D) le_rfl)
          rw [Finset.filter_mem_eq_inter, Finset.univ_inter]
          apply Finset.sum_le_sum
          intro D hD
          obtain ⟨hz, -⟩ := topScorer_spec X hX c D
          have hbig := (Finset.mem_filter.mp hD).2
          refine le_trans ?_ (Finset.single_le_sum (f := fun z =>
            if d0 - 4 ≤ (D z : ℕ) then cfgW d0 D else 0)
            (fun z _ => ite_nonneg (cfgW_nonneg d0 D) le_rfl) hz)
          rw [ite_eq_left (by omega)]
      _ = ∑ z ∈ X, ∑ D, (if d0 - 4 ≤ (D z : ℕ) then cfgW d0 D else 0) := Finset.sum_comm
      _ = ∑ _z ∈ X, (1 / 2 : ℝ) ^ (d0 - 4) := Finset.sum_congr rfl fun z _ =>
          sum_cfgW_tail d0 z (by omega)
      _ = _ := by simp
  rw [hsum]
  have : (1 / 2 : ℝ) ^ 5 = 1 / 32 := by norm_num
  rw [this] at h1
  linarith

/-- The weight of an array of `d₀` independent delay arrays. -/
noncomputable def roundsW (d0 : ℕ) (D : Fin d0 → V → Fin (d0 + 1)) : ℝ := ∏ ρ, cfgW d0 (D ρ)

omit [DecidableEq V] in
theorem roundsW_nonneg (d0 : ℕ) (D : Fin d0 → V → Fin (d0 + 1)) : 0 ≤ roundsW d0 D :=
  Finset.prod_nonneg fun _ _ => cfgW_nonneg d0 _

theorem sum_roundsW (d0 : ℕ) : ∑ D : Fin d0 → V → Fin (d0 + 1), roundsW d0 D = 1 := by
  unfold roundsW
  rw [← Fintype.prod_sum (fun _ E => cfgW d0 E)]
  simp [sum_cfgW]

open Classical in
/-- Independent rounds: all `d₀` rounds are unmarked with probability at most `(65/66)^{d₀}`. -/
theorem rounds_unmarked_le {d0 : ℕ} (hd : 5 ≤ d0) (X : Finset V) (hX : X.Nonempty) (c : V → ℕ)
    (hq : (X.card : ℝ) * (1 / 2 : ℝ) ^ (d0 - 4) ≤ 1 / 2) :
    ∑ D : Fin d0 → V → Fin (d0 + 1),
      (if ∀ ρ, ¬ RoundMarked X (delayScore (D ρ) c) then roundsW d0 D else 0) ≤
      (65 / 66 : ℝ) ^ d0 := by
  have e : ∀ D : Fin d0 → V → Fin (d0 + 1),
      (if ∀ ρ, ¬ RoundMarked X (delayScore (D ρ) c) then roundsW d0 D else 0) =
      ∏ ρ, (if RoundMarked X (delayScore (D ρ) c) then 0 else cfgW d0 (D ρ)) := by
    intro D
    unfold roundsW
    by_cases h : ∀ ρ, ¬ RoundMarked X (delayScore (D ρ) c)
    · rw [ite_eq_left h]; exact Finset.prod_congr rfl fun ρ _ => by rw [ite_eq_right (h ρ)]
    · rw [ite_eq_right h]
      push Not at h
      obtain ⟨ρ, hρ⟩ := h
      exact (Finset.prod_eq_zero (Finset.mem_univ ρ) (by rw [ite_eq_left hρ])).symm
  simp only [e]
  rw [← Fintype.prod_sum (fun _ E => if RoundMarked X (delayScore E c) then 0 else cfgW d0 E)]
  calc ∏ _ρ : Fin d0, ∑ E : V → Fin (d0 + 1),
        (if RoundMarked X (delayScore E c) then 0 else cfgW d0 E)
      ≤ ∏ _ρ : Fin d0, (65 / 66 : ℝ) := by
        refine Finset.prod_le_prod₀ (fun _ _ => ?_) (fun _ _ => round_unmarked_le hd X hX c hq)
        refine Finset.sum_nonneg fun E _ => ?_
        split_ifs
        · exact le_rfl
        · exact cfgW_nonneg d0 E
    _ = _ := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]

end DelayProbability

/-- A finite chain: on a finset totally preordered by `r`, a function determined by a monotone
potential takes at most as many values as the potential. -/
theorem card_image_le_of_potential {ι β : Type*} [DecidableEq β] {C : Finset ι}
    (r : ι → ι → Prop) (htot : ∀ I ∈ C, ∀ J ∈ C, r I J ∨ r J I) (φ : ι → ℕ) (f : ι → β)
    (hdet : ∀ I ∈ C, ∀ J ∈ C, r I J → φ I = φ J → f I = f J) {M : ℕ}
    (hM : ∀ I ∈ C, φ I ≤ M) : (C.image f).card ≤ M + 1 := by
  classical
  rcases C.eq_empty_or_nonempty with hC | ⟨I₀, hI₀⟩
  · simp [hC]
  have : Nonempty ι := ⟨I₀⟩
  have hfac : ∀ I ∈ C, ∀ J ∈ C, φ I = φ J → f I = f J := by
    intro I hI J hJ he
    rcases htot I hI J hJ with h | h
    · exact hdet I hI J hJ h he
    · exact (hdet J hJ I hI h he.symm).symm
  have hinv : ∀ b ∈ C.image f, Function.invFunOn f (C : Set ι) b ∈ C ∧
      f (Function.invFunOn f (C : Set ι) b) = b := by
    intro b hb
    obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hb
    have hex : ∃ a ∈ (C : Set ι), f a = f I := ⟨I, hI, rfl⟩
    exact ⟨Function.invFunOn_mem hex, Function.invFunOn_eq hex⟩
  calc (C.image f).card ≤ (C.image φ).card := by
        apply Finset.card_le_card_of_injOn (fun b => φ (Function.invFunOn f (C : Set ι) b))
        · intro b hb
          exact Finset.mem_image.mpr ⟨_, (hinv b hb).1, rfl⟩
        · intro b₁ hb₁ b₂ hb₂ he
          rw [← (hinv b₁ hb₁).2, ← (hinv b₂ hb₂).2]
          exact hfac _ (hinv b₁ hb₁).1 _ (hinv b₂ hb₂).1 he
    _ ≤ (Finset.range (M + 1)).card := by
        apply Finset.card_le_card
        intro n hn
        obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hn
        exact Finset.mem_range.mpr (Nat.lt_succ_of_le (hM I hI))
    _ = M + 1 := Finset.card_range _

theorem roundTop_congr {V : Type*} {X : Finset V} {sc sc' : V → ℤ} (h : ∀ z ∈ X, sc z = sc' z) :
    roundTop X sc = roundTop X sc' := by
  classical
  unfold roundTop
  split_ifs with hX
  · exact Finset.sup'_congr hX rfl h
  · rfl

theorem roundWinner_congr {V : Type*} {X : Finset V} {sc sc' : V → ℤ}
    (h : ∀ z ∈ X, sc z = sc' z) (z : V) : RoundWinner X sc z ↔ RoundWinner X sc' z := by
  unfold RoundWinner
  rw [roundTop_congr h]
  constructor
  · rintro ⟨hz, h1, h2⟩
    exact ⟨hz, (h z hz).symm.trans h1, fun z' hz' hne => (h z' hz') ▸ h2 z' hz' hne⟩
  · rintro ⟨hz, h1, h2⟩
    exact ⟨hz, (h z hz).trans h1, fun z' hz' hne => (h z' hz').symm ▸ h2 z' hz' hne⟩

theorem roundMarked_congr {V : Type*} {X : Finset V} {sc sc' : V → ℤ}
    (h : ∀ z ∈ X, sc z = sc' z) : RoundMarked X sc ↔ RoundMarked X sc' :=
  exists_congr fun z => roundWinner_congr h z

namespace ColorSetup

/-- The coloring setup of given primary and high delay arrays. -/
def ofArrays {V : Type*} (dist : DepthDistance V) (d0 b1 b2 : ℕ)
    (ωp ωh : Fin d0 → V → Fin (d0 + 1)) : ColorSetup V where
  dist := dist
  d0 := d0
  b1 := b1
  b2 := b2
  Dp := fun ρ v => ωp ρ v
  Dh := fun ρ v => ωh ρ v
  Dp_le := fun ρ v => Nat.lt_succ_iff.mp (ωp ρ v).2
  Dh_le := fun ρ v => Nat.lt_succ_iff.mp (ωh ρ v).2

variable {V : Type*} [DecidableEq V] (K : ColorSetup V)

theorem ballVec_le_succ (ρ : Fin K.d0) (g : ℤ) (z : V) (W X : Finset V) (v : V) {l : ℕ}
    (hl : l + 1 ≤ 2 * K.d0) : K.ballVec ρ g z W X v l ≤ K.ballVec ρ g z W X v (l + 1) := by
  apply flog32_mono
  apply Finset.card_le_card
  intro a ha
  obtain ⟨haX, hd⟩ := Finset.mem_filter.mp ha
  refine Finset.mem_filter.mpr ⟨haX, ?_⟩
  have h1 := K.lowMet_succ_le ρ g z W hl a v
  have h2 : K.Rl l ≤ K.Rl (l + 1) := by
    unfold Rl; push_cast
    have : (0 : ℝ) ≤ 10 * (K.d0 + 1) * K.b2 := by positivity
    nlinarith
  linarith

/-- The ball selection succeeds deterministically once `d₀` exceeds the floor-log range
(blueprint line 1739). -/
theorem ballSel_pos (ρ : Fin K.d0) (g : ℤ) (z : V) (W X : Finset V) (v : V) {Nv : ℕ}
    (hN : X.card ≤ Nv) (hd : flog32 Nv + 2 ≤ K.d0) :
    1 ≤ (K.ballSel (K.ballVec ρ g z W X v)).1 := by
  classical
  have hex : ∃ l, 1 ≤ l ∧ l < K.d0 ∧
      (K.ballVec ρ g z W X v) l = (K.ballVec ρ g z W X v) (l + 1) := by
    by_contra hne
    push Not at hne
    have hstep : ∀ l, 1 ≤ l → l < K.d0 →
        (K.ballVec ρ g z W X v) l + 1 ≤ (K.ballVec ρ g z W X v) (l + 1) := by
      intro l h1 h2
      have := K.ballVec_le_succ ρ g z W X v (l := l) (by omega)
      have := hne l h1 h2
      omega
    have hgrow : ∀ j, j < K.d0 → (K.ballVec ρ g z W X v) 1 + j ≤
        (K.ballVec ρ g z W X v) (j + 1) := by
      intro j
      induction j with
      | zero => intro _; simp
      | succ j ih =>
        intro hj
        have := ih (by omega)
        have := hstep (j + 1) (by omega) (by omega)
        omega
    have hg := hgrow (K.d0 - 1) (by omega)
    have hb : (K.ballVec ρ g z W X v) (K.d0 - 1 + 1) ≤ flog32 Nv := by
      exact (flog32_mono (Finset.card_le_card (Finset.filter_subset _ _))).trans
        (flog32_mono hN)
    omega
  unfold ballSel
  rw [dite_eq_left hex]
  exact (Nat.find_spec hex).1

end ColorSetup

namespace ColorSetup
variable {V : Type*} [DecidableEq V] (K : ColorSetup V) (T : AdmTree V)

omit [DecidableEq V] in
theorem sigData_eq_none_iff {n : ℕ} {X : Finset V} {sc : Fin n → V → ℤ} :
    sigData (roundSig X sc) = none ↔ ∀ ρ, ¬ RoundMarked X (sc ρ) := by
  classical
  refine ⟨sigData_none, fun h => ?_⟩
  unfold sigData
  rw [dite_eq_right]
  rintro ⟨ρ, z, hz⟩
  exact h ρ ⟨z, hz⟩

/-- The potential is monotone along ancestor chains, and constant potential means constant color
data. -/
theorem potential_anc {B₂ B₃ B₄ : ℕ} {v : V}
    (hb : ∀ I, v ∈ T.X I → K.pot2 (T.st I) v ≤ B₂ ∧ K.pot3 (T.st I) v ≤ B₃ ∧
      K.pot4 (T.st I) v ≤ B₄) {I₀ I : T.Cell} (h : T.Anc I₀ I) (hv : v ∈ T.X I₀) :
    K.potential B₂ B₃ B₄ (T.st I₀) v ≤ K.potential B₂ B₃ B₄ (T.st I) v ∧
    (K.potential B₂ B₃ B₄ (T.st I₀) v = K.potential B₂ B₃ B₄ (T.st I) v →
      K.colorData (T.st I₀) v = K.colorData (T.st I) v) := by
  obtain ⟨n, rfl⟩ := h
  induction n generalizing I with
  | zero => exact ⟨le_rfl, fun _ => rfl⟩
  | succ n ih =>
    rw [Function.iterate_succ_apply] at hv ⊢
    have hvp : v ∈ T.X (T.par I) := (T.anc_le ⟨n, rfl⟩).2.1 hv
    obtain ⟨h1, h2⟩ := ih (I := T.par I) hv
    obtain ⟨h3, h4⟩ := K.potential_step (T.st_wf (T.par I)) (T.st_wf I) (T.st_le_par I) hvp
      (hb _ hvp)
    refine ⟨h1.trans h3, fun he => ?_⟩
    have e1 : K.potential B₂ B₃ B₄ (T.st (T.par^[n] (T.par I))) v =
        K.potential B₂ B₃ B₄ (T.st (T.par I)) v := le_antisymm h1 (he ▸ h3)
    exact (h2 e1).trans (h4 (e1.symm.trans he))

/-- The primary situation of a center at a cell: the present list and the capped distance
quotients, which determine whether all primary rounds fail. -/
noncomputable def psit (I : T.Cell) (v : V) : Finset V × (V → ℕ) :=
  (T.X I, fun z => if z ∈ T.X I then capDiv (K.dist.d (T.depth I) z v) K.b1 (K.d0 + 6) else 0)

/-- Its monotone potential. -/
noncomputable def ppot (I : T.Cell) (v : V) : ℕ :=
  (T.X I).card + ∑ z ∈ T.X I, (K.d0 + 6 - capDiv (K.dist.d (T.depth I) z v) K.b1 (K.d0 + 6))

theorem ppot_anc {I₀ I : T.Cell} (h : T.Anc I₀ I) (v : V) :
    K.ppot T I₀ v ≤ K.ppot T I v ∧ (K.ppot T I₀ v = K.ppot T I v → K.psit T I₀ v = K.psit T I
        v) := by
  have hle := T.anc_le h
  have hX : T.X I₀ ⊆ T.X I := hle.2.1
  have hc : ∀ z, capDiv (K.dist.d (T.depth I) z v) K.b1 (K.d0 + 6) ≤
      capDiv (K.dist.d (T.depth I₀) z v) K.b1 (K.d0 + 6) :=
    fun z => capDiv_mono (K.dist.anti hle.1 z v) _ _
  unfold ppot
  set f₀ := fun z => K.d0 + 6 - capDiv (K.dist.d (T.depth I₀) z v) K.b1 (K.d0 + 6)
  set f := fun z => K.d0 + 6 - capDiv (K.dist.d (T.depth I) z v) K.b1 (K.d0 + 6)
  have hff : ∀ z, f₀ z ≤ f z := fun z => by simp only [f₀, f]; have := hc z; omega
  have hs1 : (T.X I₀).sum f₀ ≤ (T.X I₀).sum f := Finset.sum_le_sum fun z _ => hff z
  have hs2 : (T.X I₀).sum f ≤ (T.X I).sum f :=
    Finset.sum_le_sum_of_subset_of_nonneg hX (fun _ _ _ => Nat.zero_le _)
  have hcard := Finset.card_le_card hX
  refine ⟨by omega, fun he => ?_⟩
  have hc' : (T.X I₀).card = (T.X I).card := by omega
  have hXe : T.X I₀ = T.X I := Finset.eq_of_subset_of_card_le hX hc'.ge
  have hs : (T.X I₀).sum f₀ = (T.X I₀).sum f := by omega
  have hterm := (Finset.sum_eq_sum_iff_of_le (fun z _ => hff z)).mp hs
  unfold psit
  rw [hXe]
  congr 1
  funext z
  split_ifs with hz
  · have := hterm z (hXe ▸ hz)
    have h1 := capDiv_le (K.dist.d (T.depth I₀) z v) K.b1 (K.d0 + 6)
    have h2 := capDiv_le (K.dist.d (T.depth I) z v) K.b1 (K.d0 + 6)
    simp only [f₀, f] at this
    omega
  · rfl

omit [DecidableEq V] in
theorem ppot_le {Nv : ℕ} (hN : ∀ I, (T.X I).card ≤ Nv) (I : T.Cell) (v : V) :
    K.ppot T I v ≤ Nv * (K.d0 + 7) := by
  unfold ppot
  have h1 : (T.X I).card ≤ Nv := hN I
  have h2 : ∑ z ∈ T.X I, (K.d0 + 6 - capDiv (K.dist.d (T.depth I) z v) K.b1 (K.d0 + 6)) ≤
      ∑ _z ∈ T.X I, (K.d0 + 6) := Finset.sum_le_sum fun z _ => Nat.sub_le _ _
  rw [Finset.sum_const, smul_eq_mul] at h2
  have h3 : (T.X I).card * (K.d0 + 6) ≤ Nv * (K.d0 + 6) := Nat.mul_le_mul_right _ h1
  nlinarith

theorem colorData_fst (A : AdmState V) (v : V) : (K.colorData A v).1 = K.prim A v := by
  unfold colorData
  cases K.prim A v with
  | none => rfl
  | some t => rfl

/-- The capped high offsets `min(⌊d^{(l+1)}(a,v)/b₂⌋, d₀ + 6)` of the selected context. -/
noncomputable def hOff (A : AdmState V) (v a : V) : ℕ :=
  match K.prim A v with
  | none => 0
  | some (ρ, z, g) => min ⌊K.lowMet ρ g z (admFrozen A z)
      ((K.ballSel (K.ballVec ρ g z (admFrozen A z) A.X v)).1 + 1) a v / K.b2⌋₊ (K.d0 + 6)

/-- The high situation of a center at a cell: the present list and the high offsets. -/
noncomputable def hsit (I : T.Cell) (v : V) : Finset V × (V → ℕ) :=
  (T.X I, fun a => if a ∈ T.X I then K.hOff (T.st I) v a else 0)

theorem hOff_eq {A A' : AdmState V} (hA : A.WF) (hA' : A'.WF) (h : A.Le A') {v : V}
    (he : K.colorData A v = K.colorData A' v) (a : V) : K.hOff A v a = K.hOff A' v a := by
  have hp : K.prim A v = K.prim A' v := by
    rw [← colorData_fst, ← colorData_fst, he]
  unfold hOff
  cases hc : K.prim A v with
  | none => rw [← hp, hc]
  | some t =>
    obtain ⟨ρ, z, g⟩ := t
    have hc' : K.prim A' v = some (ρ, z, g) := hp ▸ hc
    rw [hc']
    simp only
    have hz := K.prim_winner hc
    have hd : K.colorData A v = (some (ρ, z, g), admLevel A z,
        K.ballSel (K.ballVec ρ g z (admFrozen A z) A.X v),
        sigData (roundSig A.X (fun ρ' => K.hsc ρ g z (admFrozen A z)
          (K.ballSel (K.ballVec ρ g z (admFrozen A z) A.X v)).1 v ρ'))) := by
      unfold colorData; rw [hc]
    have hd' : K.colorData A' v = (some (ρ, z, g), admLevel A' z,
        K.ballSel (K.ballVec ρ g z (admFrozen A' z) A'.X v),
        sigData (roundSig A'.X (fun ρ' => K.hsc ρ g z (admFrozen A' z)
          (K.ballSel (K.ballVec ρ g z (admFrozen A' z) A'.X v)).1 v ρ'))) := by
      unfold colorData; rw [hc']
    rw [hd, hd'] at he
    simp only [Prod.mk.injEq] at he
    obtain ⟨-, hl, hs, -⟩ := he
    have hW := admFrozen_eq hA hA' h hz hl
    rw [hW] at hs ⊢
    rw [hs]

/-- The potential of the high situation. -/
noncomputable def hpot (Nv : ℕ) (I : T.Cell) (v : V) : ℕ :=
  K.potential (Nat.size Nv) (K.d0 * flog32 Nv)
    (K.d0 * (2 * K.d0 + 1)) (T.st I) v * (Nv + 1) + (T.X I).card

theorem hpot_anc {Nv : ℕ} (hN : ∀ I, (T.X I).card ≤ Nv) {I₀ I : T.Cell} (h : T.Anc I₀ I)
    {v : V} (hv : v ∈ T.X I₀) :
    K.hpot T Nv I₀ v ≤ K.hpot T Nv I v ∧
      (K.hpot T Nv I₀ v = K.hpot T Nv I v → K.hsit T I₀ v = K.hsit T I v) := by
  obtain ⟨p1, p2⟩ := K.potential_anc T (B₂ := Nat.size Nv)
    (B₃ := K.d0 * flog32 Nv) (B₄ := K.d0 * (2 * K.d0 + 1))
    (fun I hvI => ⟨K.pot2_le (T.st_wf I) (hN I) v, K.pot3_le (hN I) v, K.pot4_le hvI⟩) h hv
  have hle := T.anc_le h
  have hcard := Finset.card_le_card hle.2.1
  have hb := hN I₀
  obtain ⟨s1, s2⟩ := lex_step (B := Nv) hb p1 (fun _ => hcard)
  unfold hpot
  refine ⟨s1, fun he => ?_⟩
  obtain ⟨e1, e2⟩ := s2 he
  have hX : T.X I₀ = T.X I := Finset.eq_of_subset_of_card_le hle.2.1 e2.ge
  have hd := p2 e1
  unfold hsit
  rw [hX]
  congr 1
  funext a
  split_ifs
  · exact K.hOff_eq (T.st_wf I₀) (T.st_wf I) hle hd a
  · rfl

theorem hpot_le {Nv : ℕ} (hN : ∀ I, (T.X I).card ≤ Nv) (I : T.Cell) {v : V} (hv : v ∈ T.X I) :
    K.hpot T Nv I v ≤ K.potMax Nv * (Nv + 1) + Nv := by
  have h1 := K.potential_le (T.st_wf I) (hN I) hv
  have h2 := hN I
  unfold hpot
  have : K.potential (Nat.size Nv) (K.d0 * flog32 Nv)
      (K.d0 * (2 * K.d0 + 1)) (T.st I) v * (Nv + 1) ≤
      K.potMax Nv * (Nv + 1) := Nat.mul_le_mul_right _ h1.le
  omega

/-- Primary failure is the failure of all primary rounds at the primary situation. -/
theorem prim_none_iff {dist : DepthDistance V} {d0 b1 b2 : ℕ}
    (ωp ωh : Fin d0 → V → Fin (d0 + 1)) (I : T.Cell) (v : V) :
    (ofArrays dist d0 b1 b2 ωp ωh).prim (T.st I) v = none ↔
      ∀ ρ, ¬ RoundMarked ((ofArrays dist d0 b1 b2 ωp ωh).psit T I v).1
        (delayScore (ωp ρ) ((ofArrays dist d0 b1 b2 ωp ωh).psit T I v).2) := by
  unfold prim
  rw [sigData_eq_none_iff]
  refine forall_congr' fun ρ => not_congr (roundMarked_congr fun z hz => ?_)
  simp only [psit, AdmTree.st] at hz ⊢
  simp only [psc, delayScore, hz, ite_true, ofArrays]

/-- High failure is the failure of all high rounds at the high situation. -/
theorem high_none_iff {dist : DepthDistance V} {d0 b1 b2 : ℕ}
    (ωp ωh : Fin d0 → V → Fin (d0 + 1)) (I : T.Cell) (v : V) {ρ : Fin d0} {z : V} {g : ℤ}
    (hp : (ofArrays dist d0 b1 b2 ωp ωh).prim (T.st I) v = some (ρ, z, g)) :
    ((ofArrays dist d0 b1 b2 ωp ωh).colorData (T.st I) v).2.2.2 = none ↔
      ∀ ρ', ¬ RoundMarked ((ofArrays dist d0 b1 b2 ωp ωh).hsit T I v).1
        (delayScore (ωh ρ') ((ofArrays dist d0 b1 b2 ωp ωh).hsit T I v).2) := by
  set K := ofArrays dist d0 b1 b2 ωp ωh
  have hd : K.colorData (T.st I) v = (some (ρ, z, g), admLevel (T.st I) z,
      K.ballSel (K.ballVec ρ g z (admFrozen (T.st I) z) (T.st I).X v),
      sigData (roundSig (T.st I).X (fun ρ' => K.hsc ρ g z (admFrozen (T.st I) z)
        (K.ballSel (K.ballVec ρ g z (admFrozen (T.st I) z) (T.st I).X v)).1 v ρ'))) := by
    unfold colorData; rw [hp]; rfl
  rw [hd]
  simp only
  rw [sigData_eq_none_iff]
  refine forall_congr' fun ρ' => not_congr (roundMarked_congr fun a ha => ?_)
  have ha' : a ∈ T.X I := ha
  simp only [hsit, delayScore, ha', ite_true, hOff, hsc]
  rw [hp]
  rfl

end ColorSetup

namespace ColorSetup
variable {V : Type*} [Fintype V] [DecidableEq V] (T : AdmTree V)

/-- The all-zero delay array. -/
def zeroArr (d0 : ℕ) : Fin d0 → V → Fin (d0 + 1) := fun _ _ => 0

omit [Fintype V] in
theorem hOff_arrays (dist : DepthDistance V) (d0 b1 b2 : ℕ)
    (ωp ωh ωh' : Fin d0 → V → Fin (d0 + 1)) (A : AdmState V) (v a : V) :
    (ofArrays dist d0 b1 b2 ωp ωh).hOff A v a = (ofArrays dist d0 b1 b2 ωp ωh').hOff A v a := by
  unfold hOff
  have hp : (ofArrays dist d0 b1 b2 ωp ωh).prim A v = (ofArrays dist d0 b1 b2 ωp ωh').prim A v :=
    rfl
  rw [hp]
  cases (ofArrays dist d0 b1 b2 ωp ωh').prim A v with
  | none => rfl
  | some t => rfl

omit [Fintype V] in
/-- High situations do not depend on the high arrays. -/
theorem hsit_arrays (dist : DepthDistance V) (d0 b1 b2 : ℕ)
    (ωp ωh ωh' : Fin d0 → V → Fin (d0 + 1)) (I : T.Cell) (v : V) :
    (ofArrays dist d0 b1 b2 ωp ωh).hsit T I v = (ofArrays dist d0 b1 b2 ωp ωh').hsit T I v := by
  unfold hsit
  congr 1
  funext a
  split_ifs
  · exact hOff_arrays dist d0 b1 b2 ωp ωh ωh' _ v a
  · rfl

/-- Some vertex at the cell has unsuccessful color data. -/
def FailAt (dist : DepthDistance V) (d0 b1 b2 : ℕ) (ωp ωh : Fin d0 → V → Fin (d0 + 1))
    (I : T.Cell) : Prop :=
  ∃ v ∈ T.X I, ¬ (ofArrays dist d0 b1 b2 ωp ωh).Success
    ((ofArrays dist d0 b1 b2 ωp ωh).colorData (T.st I) v)

omit [Fintype V] in
theorem fail_cases {dist : DepthDistance V} {d0 b1 b2 : ℕ} {Nv : ℕ}
    (hN : ∀ I, (T.X I).card ≤ Nv) (hd : flog32 Nv + 2 ≤ d0) (ωp ωh : Fin d0 → V → Fin (d0 + 1))
    {I : T.Cell} {v : V} (hf : ¬ (ofArrays dist d0 b1 b2 ωp ωh).Success
      ((ofArrays dist d0 b1 b2 ωp ωh).colorData (T.st I) v)) :
    (ofArrays dist d0 b1 b2 ωp ωh).prim (T.st I) v = none ∨
      ∃ t, (ofArrays dist d0 b1 b2 ωp ωh).prim (T.st I) v = some t ∧
        ((ofArrays dist d0 b1 b2 ωp ωh).colorData (T.st I) v).2.2.2 = none := by
  set K := ofArrays dist d0 b1 b2 ωp ωh
  cases hc : K.prim (T.st I) v with
  | none => exact Or.inl rfl
  | some t =>
    obtain ⟨ρ, z, g⟩ := t
    refine Or.inr ⟨_, rfl, ?_⟩
    have hd' : K.colorData (T.st I) v = (some (ρ, z, g), admLevel (T.st I) z,
        K.ballSel (K.ballVec ρ g z (admFrozen (T.st I) z) (T.st I).X v),
        sigData (roundSig (T.st I).X (fun ρ' => K.hsc ρ g z (admFrozen (T.st I) z)
          (K.ballSel (K.ballVec ρ g z (admFrozen (T.st I) z) (T.st I).X v)).1 v ρ'))) := by
      unfold colorData; rw [hc]
    have hl := K.ballSel_pos ρ g z (admFrozen (T.st I) z) (T.st I).X v (hN I) hd
    cases hh : ((K.colorData (T.st I) v).2.2.2) with
    | none => rfl
    | some u =>
      exfalso
      obtain ⟨ρ', a, g₂⟩ := u
      apply hf
      rw [hd'] at hh
      simp only at hh
      refine ⟨ρ, z, g, admLevel (T.st I) z,
        (K.ballSel (K.ballVec ρ g z (admFrozen (T.st I) z) (T.st I).X v)).1,
        (K.ballSel (K.ballVec ρ g z (admFrozen (T.st I) z) (T.st I).X v)).2, ρ', a, g₂, ?_, hl⟩
      rw [hd', hh]

open Classical in
theorem situation_unmarked_le {d0 Nv : ℕ} (hd5 : 5 ≤ d0)
    (hq : (Nv : ℝ) * (1 / 2 : ℝ) ^ (d0 - 4) ≤ 1 / 2) {σ : Finset V × (V → ℕ)}
    (hσ : σ.1.Nonempty) (hσN : σ.1.card ≤ Nv) :
    ∑ D : Fin d0 → V → Fin (d0 + 1),
      (if ∀ ρ, ¬ RoundMarked σ.1 (delayScore (D ρ) σ.2) then roundsW d0 D else 0) ≤
      (65 / 66 : ℝ) ^ d0 := by
  apply rounds_unmarked_le hd5 σ.1 hσ σ.2
  have : (σ.1.card : ℝ) ≤ Nv := by exact_mod_cast hσN
  have h2 : (0 : ℝ) ≤ (1 / 2 : ℝ) ^ (d0 - 4) := by positivity
  nlinarith

/-- Counting the situations of the centers along a chain. -/
theorem card_situations_le {C : Finset T.Cell} (htot : ∀ I ∈ C, ∀ J ∈ C, T.Anc I J ∨ T.Anc J I)
    {Nv : ℕ} (hN : ∀ I, (T.X I).card ≤ Nv)
    (sit : T.Cell → V → Finset V × (V → ℕ)) (pot : T.Cell → V → ℕ) {M : ℕ}
    (hdet : ∀ v, ∀ I₀ I, T.Anc I₀ I → v ∈ T.X I₀ → pot I₀ v = pot I v → sit I₀ v = sit I v)
    (hM : ∀ I v, v ∈ T.X I → pot I v ≤ M) :
    (((C ×ˢ (Finset.univ : Finset V)).filter (fun p => p.2 ∈ T.X p.1)).image
      (fun p => sit p.1 p.2)).card ≤ Nv * (M + 1) := by
  classical
  rcases C.eq_empty_or_nonempty with rfl | hC
  · simp
  -- the present lists along the chain lie in the largest one
  obtain ⟨I₁, hI₁, hmax⟩ := C.exists_max_image (fun I => (T.X I).card) hC
  have hsub : ∀ I ∈ C, T.X I ⊆ T.X I₁ := by
    intro I hI
    rcases htot I hI I₁ hI₁ with h | h
    · exact (T.anc_le h).2.1
    · exact (Finset.eq_of_subset_of_card_le (T.anc_le h).2.1 (hmax I hI)).symm.subset
  calc _ ≤ ((T.X I₁).biUnion (fun v => (C.filter (fun I => v ∈ T.X I)).image
        (fun I => sit I v))).card := by
        apply Finset.card_le_card
        intro σ hσ
        obtain ⟨⟨I, v⟩, hp, rfl⟩ := Finset.mem_image.mp hσ
        obtain ⟨hIv, hv⟩ := Finset.mem_filter.mp hp
        have hIC := (Finset.mem_product.mp hIv).1
        exact Finset.mem_biUnion.mpr ⟨v, hsub I hIC hv, Finset.mem_image.mpr
          ⟨I, Finset.mem_filter.mpr ⟨hIC, hv⟩, rfl⟩⟩
    _ ≤ ∑ v ∈ T.X I₁, ((C.filter (fun I => v ∈ T.X I)).image (fun I => sit I v)).card :=
        Finset.card_biUnion_le
    _ ≤ ∑ _v ∈ T.X I₁, (M + 1) := by
        apply Finset.sum_le_sum
        intro v _
        apply card_image_le_of_potential T.Anc
          (fun I hI J hJ => htot I (Finset.mem_filter.mp hI).1 J (Finset.mem_filter.mp hJ).1)
          (fun I => pot I v)
        · intro I hI J _ hIJ he
          exact hdet v I J hIJ (Finset.mem_filter.mp hI).2 he
        · intro I hI; exact hM I v (Finset.mem_filter.mp hI).2
    _ = (T.X I₁).card * (M + 1) := by simp
    _ ≤ Nv * (M + 1) := Nat.mul_le_mul_right _ (hN I₁)

open Classical in
/-- The failure probability along one path (blueprint lines 1732-1733): the union bound over the
primary situations and, conditionally on the primary arrays, over the high situations. -/
theorem chain_fail_le (dist : DepthDistance V) {d0 : ℕ} (b1 b2 : ℕ) (hd5 : 5 ≤ d0)
    {Nv : ℕ} (hN : ∀ I, (T.X I).card ≤ Nv) (hd : flog32 Nv + 2 ≤ d0)
    (hq : (Nv : ℝ) * (1 / 2 : ℝ) ^ (d0 - 4) ≤ 1 / 2) (C : Finset T.Cell)
    (htot : ∀ I ∈ C, ∀ J ∈ C, T.Anc I J ∨ T.Anc J I) :
    ∑ ωp : Fin d0 → V → Fin (d0 + 1), ∑ ωh : Fin d0 → V → Fin (d0 + 1),
      (if ∃ I ∈ C, FailAt T dist d0 b1 b2 ωp ωh I then roundsW d0 ωp * roundsW d0 ωh else 0) ≤
      ((Nv : ℝ) * (Nv * (d0 + 7) + 1) + Nv *
        ((ofArrays dist d0 b1 b2 (zeroArr d0) (zeroArr d0)).potMax Nv *
          (Nv + 1) + Nv + 1)) * (65 / 66 : ℝ) ^ d0 := by
  set K₀ := ofArrays dist d0 b1 b2 (zeroArr d0) (zeroArr d0)
  set pairs := (C ×ˢ (Finset.univ : Finset V)).filter (fun p => p.2 ∈ T.X p.1)
  set PS := pairs.image (fun p => K₀.psit T p.1 p.2)
  set HS := fun ωp : Fin d0 → V → Fin (d0 + 1) =>
    pairs.image (fun p => (ofArrays dist d0 b1 b2 ωp (zeroArr d0)).hsit T p.1 p.2)
  set q := (65 / 66 : ℝ) ^ d0
  set Hc := K₀.potMax Nv * (Nv + 1) + Nv
  have hq0 : 0 ≤ q := by positivity
  -- situations do not depend on the arrays they do not use
  have hps : ∀ ωp ωh I v, (ofArrays dist d0 b1 b2 ωp ωh).psit T I v = K₀.psit T I v :=
    fun _ _ _ _ => rfl
  have hhs : ∀ ωp ωh I v, (ofArrays dist d0 b1 b2 ωp ωh).hsit T I v =
      (ofArrays dist d0 b1 b2 ωp (zeroArr d0)).hsit T I v := fun ωp ωh I v =>
    hsit_arrays T dist d0 b1 b2 ωp ωh _ I v
  -- membership of situations
  have hpair : ∀ I ∈ C, ∀ v ∈ T.X I, (I, v) ∈ pairs := fun I hI v hv =>
    Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨hI, Finset.mem_univ _⟩, hv⟩
  have hne : ∀ σ ∈ PS, σ.1.Nonempty := by
    intro σ hσ
    obtain ⟨⟨I, v⟩, hp, rfl⟩ := Finset.mem_image.mp hσ
    exact ⟨v, (Finset.mem_filter.mp hp).2⟩
  have hne' : ∀ ωp, ∀ σ ∈ HS ωp, σ.1.Nonempty := by
    intro ωp σ hσ
    obtain ⟨⟨I, v⟩, hp, rfl⟩ := Finset.mem_image.mp hσ
    exact ⟨v, (Finset.mem_filter.mp hp).2⟩
  have hcN : ∀ σ ∈ PS, σ.1.card ≤ Nv := by
    intro σ hσ
    obtain ⟨⟨I, v⟩, _, rfl⟩ := Finset.mem_image.mp hσ
    exact hN I
  have hcN' : ∀ ωp, ∀ σ ∈ HS ωp, σ.1.card ≤ Nv := by
    intro ωp σ hσ
    obtain ⟨⟨I, v⟩, _, rfl⟩ := Finset.mem_image.mp hσ
    exact hN I
  -- the event inclusion
  have hinc : ∀ ωp ωh, (∃ I ∈ C, FailAt T dist d0 b1 b2 ωp ωh I) →
      (∃ σ ∈ PS, ∀ ρ, ¬ RoundMarked σ.1 (delayScore (ωp ρ) σ.2)) ∨
      (∃ σ ∈ HS ωp, ∀ ρ, ¬ RoundMarked σ.1 (delayScore (ωh ρ) σ.2)) := by
    rintro ωp ωh ⟨I, hI, v, hv, hf⟩
    rcases fail_cases T hN hd ωp ωh hf with hp | ⟨t, hp, hh⟩
    · left
      refine ⟨K₀.psit T I v, Finset.mem_image.mpr ⟨(I, v), hpair I hI v hv, rfl⟩, ?_⟩
      have := (prim_none_iff T ωp ωh I v).mp hp
      rwa [hps] at this
    · right
      obtain ⟨ρ, z, g⟩ := t
      refine ⟨(ofArrays dist d0 b1 b2 ωp (zeroArr d0)).hsit T I v,
        Finset.mem_image.mpr ⟨(I, v), hpair I hI v hv, rfl⟩, ?_⟩
      have := (high_none_iff T ωp ωh I v hp).mp hh
      rwa [hhs] at this
  -- the pointwise bound
  have hind : ∀ ωp ωh,
      (if ∃ I ∈ C, FailAt T dist d0 b1 b2 ωp ωh I then roundsW d0 ωp * roundsW d0 ωh else 0) ≤
      (∑ σ ∈ PS, (if ∀ ρ, ¬ RoundMarked σ.1 (delayScore (ωp ρ) σ.2) then roundsW d0 ωp else 0)) *
        roundsW d0 ωh +
      roundsW d0 ωp * ∑ σ ∈ HS ωp,
        (if ∀ ρ, ¬ RoundMarked σ.1 (delayScore (ωh ρ) σ.2) then roundsW d0 ωh else 0) := by
    intro ωp ωh
    have w1 := roundsW_nonneg d0 ωp
    have w2 := roundsW_nonneg d0 ωh
    have s1 : 0 ≤ ∑ σ ∈ PS,
        (if ∀ ρ, ¬ RoundMarked σ.1 (delayScore (ωp ρ) σ.2) then roundsW d0 ωp else 0) :=
      Finset.sum_nonneg fun σ _ => ite_nonneg w1 le_rfl
    have s2 : 0 ≤ ∑ σ ∈ HS ωp,
        (if ∀ ρ, ¬ RoundMarked σ.1 (delayScore (ωh ρ) σ.2) then roundsW d0 ωh else 0) :=
      Finset.sum_nonneg fun σ _ => ite_nonneg w2 le_rfl
    split_ifs with hf
    · rcases hinc ωp ωh hf with ⟨σ, hσ, hE⟩ | ⟨σ, hσ, hE⟩
      · have : roundsW d0 ωp ≤ ∑ σ ∈ PS,
            (if ∀ ρ, ¬ RoundMarked σ.1 (delayScore (ωp ρ) σ.2) then roundsW d0 ωp else 0) := by
          refine le_trans ?_ (Finset.single_le_sum (fun σ _ => ite_nonneg w1 le_rfl) hσ)
          rw [ite_eq_left hE]
        nlinarith only [w1, w2, s2, this]
      · have : roundsW d0 ωh ≤ ∑ σ ∈ HS ωp,
            (if ∀ ρ, ¬ RoundMarked σ.1 (delayScore (ωh ρ) σ.2) then roundsW d0 ωh else 0) := by
          refine le_trans ?_ (Finset.single_le_sum (fun σ _ => ite_nonneg w2 le_rfl) hσ)
          rw [ite_eq_left hE]
        nlinarith only [w1, w2, s1, this]
    · positivity
  -- the situation counts
  have hPS : (PS.card : ℝ) ≤ Nv * (Nv * (d0 + 7) + 1) := by
    have := card_situations_le T htot hN (fun I v => K₀.psit T I v) (fun I v => K₀.ppot T I v)
      (M := Nv * (d0 + 7))
      (fun v I₀ I h _ he => (K₀.ppot_anc T h v).2 he) (fun I v _ => K₀.ppot_le T hN I v)
    exact_mod_cast this
  have hHS : ∀ ωp, ((HS ωp).card : ℝ) ≤ Nv * (Hc + 1) := by
    intro ωp
    have := card_situations_le T htot hN
      (fun I v => (ofArrays dist d0 b1 b2 ωp (zeroArr d0)).hsit T I v)
      (fun I v => (ofArrays dist d0 b1 b2 ωp (zeroArr d0)).hpot T Nv I v) (M := Hc)
      (fun v I₀ I h hv he =>
        ((ofArrays dist d0 b1 b2 ωp (zeroArr d0)).hpot_anc T hN h hv).2 he)
      (fun I v hv => (ofArrays dist d0 b1 b2 ωp (zeroArr d0)).hpot_le T hN I hv)
    exact_mod_cast this
  -- summing
  calc ∑ ωp : Fin d0 → V → Fin (d0 + 1), ∑ ωh : Fin d0 → V → Fin (d0 + 1),
        (if ∃ I ∈ C, FailAt T dist d0 b1 b2 ωp ωh I then roundsW d0 ωp * roundsW d0 ωh else 0)
      ≤ ∑ ωp : Fin d0 → V → Fin (d0 + 1), ∑ ωh : Fin d0 → V → Fin (d0 + 1),
        ((∑ σ ∈ PS, (if ∀ ρ, ¬ RoundMarked σ.1 (delayScore (ωp ρ) σ.2) then roundsW d0 ωp
          else 0)) * roundsW d0 ωh +
        roundsW d0 ωp * ∑ σ ∈ HS ωp,
          (if ∀ ρ, ¬ RoundMarked σ.1 (delayScore (ωh ρ) σ.2) then roundsW d0 ωh else 0)) :=
        Finset.sum_le_sum fun ωp _ => Finset.sum_le_sum fun ωh _ => hind ωp ωh
    _ = ∑ σ ∈ PS, ∑ ωp : Fin d0 → V → Fin (d0 + 1),
          (if ∀ ρ, ¬ RoundMarked σ.1 (delayScore (ωp ρ) σ.2) then roundsW d0 ωp else 0) +
        ∑ ωp : Fin d0 → V → Fin (d0 + 1), roundsW d0 ωp * ∑ σ ∈ HS ωp,
          ∑ ωh : Fin d0 → V → Fin (d0 + 1),
            (if ∀ ρ, ¬ RoundMarked σ.1 (delayScore (ωh ρ) σ.2) then roundsW d0 ωh else 0) := by
        rw [Finset.sum_comm (s := PS)]
        simp only [Finset.sum_add_distrib, ← Finset.mul_sum, sum_roundsW,
          mul_one]
        congr 1
        apply Finset.sum_congr rfl; intro ωp _
        congr 1
        exact Finset.sum_comm
    _ ≤ ∑ _σ ∈ PS, q + ∑ ωp : Fin d0 → V → Fin (d0 + 1),
          roundsW d0 ωp * (Nv * (Hc + 1) * q) := by
        gcongr with σ hσ ωp _
        · exact situation_unmarked_le hd5 hq (hne σ hσ) (hcN σ hσ)
        · exact roundsW_nonneg d0 ωp
        · calc ∑ σ ∈ HS ωp, ∑ ωh : Fin d0 → V → Fin (d0 + 1),
                (if ∀ ρ, ¬ RoundMarked σ.1 (delayScore (ωh ρ) σ.2) then roundsW d0 ωh else 0)
              ≤ ∑ _σ ∈ HS ωp, q :=
                Finset.sum_le_sum fun σ hσ =>
                  situation_unmarked_le hd5 hq (hne' ωp σ hσ) (hcN' ωp σ hσ)
            _ = (HS ωp).card * q := by rw [Finset.sum_const, nsmul_eq_mul]
            _ ≤ Nv * (Hc + 1) * q := by gcongr; exact hHS ωp
    _ = PS.card * q + Nv * (Hc + 1) * q := by
        rw [Finset.sum_const, nsmul_eq_mul, ← Finset.sum_mul, sum_roundsW, one_mul]
    _ ≤ _ := by
        have h1 : (PS.card : ℝ) * q ≤ Nv * (Nv * (d0 + 7) + 1) * q :=
          by gcongr
        rw [add_mul]
        refine add_le_add h1 (le_of_eq ?_)
        simp only [Hc]
        push_cast
        ring

omit [Fintype V] in
open Classical in
/-- Blueprint lines 1732-1734: the delays can be fixed so that the cells carrying a failed
marking have total length at most the path failure bound times `|R|`. -/
theorem delays_exist [Finite V] (dist : DepthDistance V) {d0 : ℕ} (b1 b2 : ℕ) (hd5 : 5 ≤ d0)
    {Nv : ℕ} (hN : ∀ I, (T.X I).card ≤ Nv) (hd : flog32 Nv + 2 ≤ d0)
    (hq : (Nv : ℝ) * (1 / 2 : ℝ) ^ (d0 - 4) ≤ 1 / 2) (S : Finset T.Cell)
    (cellSet : T.Cell → Set ℝ) (hmeas : ∀ I, MeasurableSet (cellSet I)) {R : Set ℝ}
    (hRm : MeasurableSet R) (hR : volume R ≠ ⊤) (hsub : ∀ I ∈ S, cellSet I ⊆ R)
    (hnest : ∀ I ∈ S, ∀ J ∈ S, (cellSet I ∩ cellSet J).Nonempty → T.Anc I J ∨ T.Anc J I) :
    ∃ ωp ωh : Fin d0 → V → Fin (d0 + 1),
      (volume (⋃ I ∈ S.filter (FailAt T dist d0 b1 b2 ωp ωh), cellSet I)).toReal ≤
      ((Nv : ℝ) * (Nv * (d0 + 7) + 1) + Nv *
        ((ofArrays dist d0 b1 b2 (zeroArr d0) (zeroArr d0)).potMax Nv *
          (Nv + 1) + Nv + 1)) * (65 / 66 : ℝ) ^ d0 *
        (volume R).toReal := by
  have := Fintype.ofFinite V
  set B := ((Nv : ℝ) * (Nv * (d0 + 7) + 1) + Nv *
    ((ofArrays dist d0 b1 b2 (zeroArr d0) (zeroArr d0)).potMax Nv *
      (Nv + 1) + Nv + 1)) * (65 / 66 : ℝ) ^ d0
  set F := fun (ωp ωh : Fin d0 → V → Fin (d0 + 1)) =>
    ⋃ I ∈ S.filter (FailAt T dist d0 b1 b2 ωp ωh), cellSet I
  have hFm : ∀ ωp ωh, MeasurableSet (F ωp ωh) := fun ωp ωh =>
    Finset.measurableSet_biUnion _ fun I _ => hmeas I
  have hFR : ∀ ωp ωh, F ωp ωh ⊆ R := fun ωp ωh => Set.iUnion₂_subset fun I hI =>
    hsub I (Finset.mem_filter.mp hI).1
  have hvol : ∀ ωp ωh, (volume (F ωp ωh)).toReal =
      ∫ y in R, (F ωp ωh).indicator (fun _ => (1 : ℝ)) y := by
    intro ωp ωh
    rw [integral_indicator (hFm ωp ωh), setIntegral_const, smul_eq_mul, mul_one,
      Measure.real_def, Measure.restrict_apply (hFm ωp ωh), Set.inter_eq_left.mpr (hFR ωp ωh)]
  -- the pointwise bound on the root
  have hpt : ∀ y ∈ R, ∑ ωp : Fin d0 → V → Fin (d0 + 1), ∑ ωh : Fin d0 → V → Fin (d0 + 1),
      roundsW d0 ωp * roundsW d0 ωh * (F ωp ωh).indicator (fun _ => (1 : ℝ)) y ≤ B := by
    intro y _
    set! C := S.filter (fun I => y ∈ cellSet I)
    have htot : ∀ I ∈ C, ∀ J ∈ C, T.Anc I J ∨ T.Anc J I := by
      intro I hI J hJ
      obtain ⟨hI, hyI⟩ := Finset.mem_filter.mp hI
      obtain ⟨hJ, hyJ⟩ := Finset.mem_filter.mp hJ
      exact hnest I hI J hJ ⟨y, hyI, hyJ⟩
    refine le_trans (le_of_eq ?_) (chain_fail_le T dist b1 b2 hd5 hN hd hq C htot)
    apply Finset.sum_congr rfl; intro ωp _; apply Finset.sum_congr rfl; intro ωh _
    by_cases hf : ∃ I ∈ C, FailAt T dist d0 b1 b2 ωp ωh I
    · rw [ite_eq_left hf, Set.indicator_of_mem, mul_one]
      obtain ⟨I, hI, hfI⟩ := hf
      obtain ⟨hIS, hyI⟩ := Finset.mem_filter.mp hI
      exact Set.mem_biUnion (Finset.mem_filter.mpr ⟨hIS, hfI⟩) hyI
    · rw [ite_eq_right hf, Set.indicator_of_notMem, mul_zero]
      intro hy
      obtain ⟨I, hI, hyI⟩ := Set.mem_iUnion₂.mp hy
      obtain ⟨hIS, hfI⟩ := Finset.mem_filter.mp hI
      exact hf ⟨I, Finset.mem_filter.mpr ⟨hIS, hyI⟩, hfI⟩
  -- averaging over the delays
  have hRfin : volume R < ⊤ := lt_top_iff_ne_top.mpr hR
  have hint : ∀ ωp ωh, IntegrableOn ((F ωp ωh).indicator (fun _ => (1 : ℝ))) R :=
    fun ωp ωh => (integrableOn_const (C := (1 : ℝ)) hR).indicator (hFm ωp ωh)
  have havg : ∑ ωp : Fin d0 → V → Fin (d0 + 1), ∑ ωh : Fin d0 → V → Fin (d0 + 1),
      roundsW d0 ωp * roundsW d0 ωh * (volume (F ωp ωh)).toReal ≤ B * (volume R).toReal := by
    have e : ∫ y in R, ∑ ωp : Fin d0 → V → Fin (d0 + 1), ∑ ωh : Fin d0 → V → Fin (d0 + 1),
        roundsW d0 ωp * roundsW d0 ωh * (F ωp ωh).indicator (fun _ => (1 : ℝ)) y =
        ∑ ωp : Fin d0 → V → Fin (d0 + 1), ∑ ωh : Fin d0 → V → Fin (d0 + 1),
          roundsW d0 ωp * roundsW d0 ωh * (volume (F ωp ωh)).toReal := by
      rw [integral_finsetSum _ (fun ωp _ => integrable_finsetSum _ fun ωh _ =>
        (hint ωp ωh).const_mul _)]
      apply Finset.sum_congr rfl; intro ωp _
      rw [integral_finsetSum _ (fun ωh _ => (hint ωp ωh).const_mul _)]
      apply Finset.sum_congr rfl; intro ωh _
      rw [integral_const_mul, ← hvol]
    rw [← e]
    calc ∫ y in R, ∑ ωp : Fin d0 → V → Fin (d0 + 1), ∑ ωh : Fin d0 → V → Fin (d0 + 1),
          roundsW d0 ωp * roundsW d0 ωh * (F ωp ωh).indicator (fun _ => (1 : ℝ)) y
        ≤ ∫ _y in R, B := by
          apply setIntegral_mono_on _ (integrableOn_const hR) hRm hpt
          exact integrable_finsetSum _ fun ωp _ => integrable_finsetSum _ fun ωh _ =>
            (hint ωp ωh).const_mul _
      _ = B * (volume R).toReal := by
          rw [setIntegral_const, smul_eq_mul, mul_comm]; rfl
  by_contra hcon
  push Not at hcon
  have hW : ∑ ωp : Fin d0 → V → Fin (d0 + 1), ∑ ωh : Fin d0 → V → Fin (d0 + 1),
      roundsW d0 ωp * roundsW d0 ωh = 1 := by
    simp only [← Finset.mul_sum, ← Finset.sum_mul, sum_roundsW, one_mul]
  have : B * (volume R).toReal < ∑ ωp : Fin d0 → V → Fin (d0 + 1),
      ∑ ωh : Fin d0 → V → Fin (d0 + 1),
      roundsW d0 ωp * roundsW d0 ωh * (volume (F ωp ωh)).toReal := by
    have hnn : ∀ ωp ωh : Fin d0 → V → Fin (d0 + 1), 0 ≤ roundsW d0 ωp * roundsW d0 ωh :=
      fun ωp ωh => mul_nonneg (roundsW_nonneg d0 ωp) (roundsW_nonneg d0 ωh)
    obtain ⟨p₀, h₀, hp₀⟩ : ∃ ωp ωh : Fin d0 → V → Fin (d0 + 1),
        0 < roundsW d0 ωp * roundsW d0 ωh := by
      by_contra h
      push Not at h
      have : ∑ ωp : Fin d0 → V → Fin (d0 + 1), ∑ ωh : Fin d0 → V → Fin (d0 + 1),
          roundsW d0 ωp * roundsW d0 ωh = 0 :=
        Finset.sum_eq_zero fun ωp _ => Finset.sum_eq_zero fun ωh _ =>
          le_antisymm (h ωp ωh) (hnn ωp ωh)
      linarith
    set! G := fun ωp ωh : Fin d0 → V → Fin (d0 + 1) =>
      roundsW d0 ωp * roundsW d0 ωh * ((volume (F ωp ωh)).toReal - B * (volume R).toReal)
    have hG : ∀ ωp ωh, 0 ≤ G ωp ωh := fun ωp ωh =>
      mul_nonneg (hnn ωp ωh) (by linarith [hcon ωp ωh])
    have hG0 : 0 < G p₀ h₀ := mul_pos hp₀ (by linarith [hcon p₀ h₀])
    have hsumG : G p₀ h₀ ≤ ∑ ωp : Fin d0 → V → Fin (d0 + 1), ∑ ωh : Fin d0 → V → Fin (d0 + 1),
        G ωp ωh :=
      (Finset.single_le_sum (f := fun ωh => G p₀ ωh) (fun ωh _ => hG p₀ ωh)
        (Finset.mem_univ h₀)).trans
        (Finset.single_le_sum (f := fun ωp => ∑ ωh, G ωp ωh)
          (fun ωp _ => Finset.sum_nonneg fun ωh _ => hG ωp ωh) (Finset.mem_univ p₀))
    have hsplit : ∑ ωp : Fin d0 → V → Fin (d0 + 1), ∑ ωh : Fin d0 → V → Fin (d0 + 1),
        G ωp ωh = ∑ ωp : Fin d0 → V → Fin (d0 + 1), ∑ ωh : Fin d0 → V → Fin (d0 + 1),
          roundsW d0 ωp * roundsW d0 ωh * (volume (F ωp ωh)).toReal -
        B * (volume R).toReal := by
      simp only [G, mul_sub, Finset.sum_sub_distrib]
      congr 1
      simp only [← Finset.sum_mul, hW, one_mul]
    linarith
  linarith

end ColorSetup

/-! ### The coloring parameters (blueprint lines 1714-1717) -/

theorem flog32_le_log (n : ℕ) : flog32 n ≤ 2 * Nat.log 2 n + 3 := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp [flog32]
  set k := flog32 n
  have hk := pow_flog32_le hn
  set j := k / 2
  have hkj : k ≤ 2 * j + 1 := by omega
  have h1 : 9 ^ j ≤ 3 ^ k := by
    rw [show (9 : ℕ) = 3 ^ 2 by norm_num, ← pow_mul]
    exact Nat.pow_le_pow_right (by norm_num) (by omega)
  have h2 : 2 ^ k ≤ 2 * 4 ^ j := by
    calc 2 ^ k ≤ 2 ^ (2 * j + 1) := Nat.pow_le_pow_right (by norm_num) hkj
      _ = 2 * 4 ^ j := by rw [pow_succ, pow_mul]; ring
  have h3 : 8 ^ j ≤ 9 ^ j := Nat.pow_le_pow_left (by norm_num) _
  have h4 : 2 ^ j * 4 ^ j ≤ 2 * n * 4 ^ j := by
    calc 2 ^ j * 4 ^ j = 8 ^ j := by rw [← mul_pow]; norm_num
      _ ≤ 9 ^ j := h3
      _ ≤ 3 ^ k := h1
      _ ≤ n * 2 ^ k := hk
      _ ≤ n * (2 * 4 ^ j) := Nat.mul_le_mul_left _ h2
      _ = 2 * n * 4 ^ j := by ring
  have h5 : 2 ^ j ≤ 2 * n := Nat.le_of_mul_le_mul_right h4 (by positivity)
  have h6 : j ≤ Nat.log 2 (2 * n) := Nat.le_log_of_pow_le (by norm_num) h5
  have h7 : Nat.log 2 (2 * n) = Nat.log 2 n + 1 := by
    rw [mul_comm, Nat.log_mul_base (by norm_num) (by omega)]
  omega

theorem size_le_log (n : ℕ) : Nat.size n ≤ Nat.log 2 n + 1 := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp
  rw [Nat.size_le]
  exact Nat.lt_pow_succ_log_self (by norm_num) n

/-- The degree `d₀ = ⌈1000 log 2D⌉` of the coloring. -/
noncomputable def colorDegree (D : ℕ) : ℕ := ⌈1000 * Real.log (2 * D)⌉₊

theorem colorDegree_bounds {D : ℕ} (hD : 1 ≤ D) :
    1000 * Real.log (2 * D) ≤ colorDegree D ∧ (colorDegree D : ℝ) ≤ 2001 * D := by
  unfold colorDegree
  have hD' : (1 : ℝ) ≤ D := by exact_mod_cast hD
  have hpos : 0 ≤ 1000 * Real.log (2 * D) :=
    mul_nonneg (by norm_num) (Real.log_nonneg (by linarith))
  refine ⟨Nat.le_ceil _, ?_⟩
  have h1 := Nat.ceil_lt_add_one hpos
  have h2 : Real.log (2 * D) ≤ 2 * D := (Real.log_le_sub_one_of_pos (by positivity)).trans
    (by linarith)
  linarith only [hD', h1, h2]

theorem colorDegree_ge {D : ℕ} (hD : 1 ≤ D) : 2 * Nat.log 2 D + 10 ≤ colorDegree D := by
  have hD' : (1 : ℝ) ≤ D := by exact_mod_cast hD
  have hl : (Nat.log 2 D : ℝ) * Real.log 2 ≤ Real.log D := by
    rw [← Real.log_pow]
    apply Real.log_le_log (by positivity)
    exact_mod_cast Nat.pow_log_le_self 2 (by omega)
  have hl2 : (0.69 : ℝ) < Real.log 2 := by
    have := Real.log_two_gt_d9; linarith only [this]
  have hlogD : 0 ≤ Real.log D := Real.log_nonneg hD'
  have h2D : Real.log (2 * D) = Real.log 2 + Real.log D :=
    Real.log_mul (by norm_num) (by positivity)
  have hb := (colorDegree_bounds hD).1
  have : (2 * Nat.log 2 D + 10 : ℝ) ≤ colorDegree D := by
    rw [h2D] at hb
    have : (Nat.log 2 D : ℝ) ≤ 2 * Real.log D := by
      have : (Nat.log 2 D : ℝ) * 0.69 ≤ Real.log D := by nlinarith only [hl, hl2]
      nlinarith
    nlinarith
  exact_mod_cast this

namespace ColorSetup
variable {V : Type*} [DecidableEq V] (K : ColorSetup V)

omit [DecidableEq V] in
/-- The number of colors is at most `d₀^{30}` (blueprint line 1716, `L = d₀^{30}`). -/
theorem numColors_le {Nv : ℕ} (hs : Nat.size Nv ≤ K.d0) (hf : flog32 Nv ≤ K.d0)
    (hd : 3 ≤ K.d0) : K.numColors Nv ≤ K.d0 ^ 30 := by
  unfold numColors potMax radix
  set d := K.d0
  have ha : d * (2 * d + 1) + 1 ≤ 3 * d ^ 2 := by nlinarith only [hd]
  have hb : Nat.size Nv + 1 ≤ 2 * d := by omega
  have hc : d * flog32 Nv + 1 ≤ 2 * d ^ 2 := by nlinarith only [hf, hd]
  have hr : (d + 1) ^ 2 + Nat.size Nv + flog32 Nv + 1 ≤ 5 * d ^ 2 := by nlinarith
  have hp : (d * (2 * d + 1) + 1) * (Nat.size Nv + 1) * (d * flog32 Nv + 1) *
      (d * (2 * d + 1) + 1) + 1 ≤ 37 * d ^ 7 := by
    calc _ ≤ 3 * d ^ 2 * (2 * d) * (2 * d ^ 2) * (3 * d ^ 2) + 1 := by gcongr
      _ = 36 * d ^ 7 + 1 := by ring
      _ ≤ 37 * d ^ 7 := by have : 1 ≤ d ^ 7 := Nat.one_le_pow _ _ (by omega); omega
  have hr5 : ((d + 1) ^ 2 + Nat.size Nv + flog32 Nv + 1) ^ 5 ≤ 3125 * d ^ 10 := by
    calc _ ≤ (5 * d ^ 2) ^ 5 := Nat.pow_le_pow_left hr 5
      _ = 3125 * d ^ 10 := by ring
  calc _ ≤ 37 * d ^ 7 * (3125 * d ^ 10) := Nat.mul_le_mul hp hr5
    _ = 115625 * d ^ 17 := by ring
    _ ≤ d ^ 13 * d ^ 17 := by
        apply Nat.mul_le_mul_right
        calc 115625 ≤ 3 ^ 13 := by norm_num
          _ ≤ d ^ 13 := Nat.pow_le_pow_left hd 13
    _ = d ^ 30 := by ring

omit [DecidableEq V] in
theorem potMax_le {Nv : ℕ} (hs : Nat.size Nv ≤ K.d0) (hf : flog32 Nv ≤ K.d0) (hd : 2 ≤ K.d0) :
    K.potMax Nv ≤ 36 * K.d0 ^ 7 := by
  unfold potMax
  set d := K.d0
  have ha : d * (2 * d + 1) + 1 ≤ 3 * d ^ 2 := by nlinarith only [hd]
  have hb : Nat.size Nv + 1 ≤ 2 * d := by omega
  have hc : d * flog32 Nv + 1 ≤ 2 * d ^ 2 := by nlinarith only [hf, hd]
  calc _ ≤ 3 * d ^ 2 * (2 * d) * (2 * d ^ 2) * (3 * d ^ 2) := by gcongr
    _ = 36 * d ^ 7 := by ring

end ColorSetup

theorem pow_65_66_le {D : ℕ} (hD : 1 ≤ D) :
    (65 / 66 : ℝ) ^ colorDegree D ≤ 1 / (2 * D : ℝ) ^ 15 := by
  have hD' : (1 : ℝ) ≤ D := by exact_mod_cast hD
  have h1 : (65 / 66 : ℝ) ≤ Real.exp (-(1 / 66)) := by
    have := Real.add_one_le_exp (-(1 / 66 : ℝ)); linarith only [this]
  have h2 : (65 / 66 : ℝ) ^ colorDegree D ≤ Real.exp (-(1 / 66)) ^ colorDegree D :=
    pow_le_pow_left₀ (by norm_num) h1 _
  rw [← Real.exp_nat_mul] at h2
  have hb := (colorDegree_bounds hD).1
  have hlog : 0 ≤ Real.log (2 * D) := Real.log_nonneg (by linarith only [hD'])
  have h3 : Real.exp ((colorDegree D : ℝ) * -(1 / 66)) ≤ Real.exp (-(15 * Real.log (2 * D))) :=
    Real.exp_le_exp.mpr (by nlinarith)
  have h4 : Real.exp (-(15 * Real.log (2 * D))) = 1 / (2 * D : ℝ) ^ 15 := by
    rw [Real.exp_neg, ← Real.exp_log (show (0 : ℝ) < (2 * D : ℝ) ^ 15 by positivity),
      Real.log_pow]
    push_cast; ring_nf
  linarith

/-- The explicit failure bound of `delays_exist`. -/
noncomputable def failBound {V : Type*} (dist : DepthDistance V)
    (Nv d0 b1 b2 : ℕ) : ℝ :=
  ((Nv : ℝ) * (Nv * (d0 + 7) + 1) + Nv *
    ((ColorSetup.ofArrays dist d0 b1 b2 (ColorSetup.zeroArr d0)
      (ColorSetup.zeroArr d0)).potMax Nv *
      (Nv + 1) + Nv + 1)) * (65 / 66 : ℝ) ^ d0

/-- The failure bound tends to zero: with `d₀ = ⌈1000 log 2D⌉` and at most `D` vertices it is at
most `100 · 2001⁷ / D` (blueprint line 1732: the union bound tends to zero as `D` grows). -/
theorem failBound_le {V : Type*} (dist : DepthDistance V) (b1 b2 : ℕ)
    {Nv D : ℕ} (hD : 1 ≤ D) (hV : Nv ≤ D) :
    failBound dist Nv (colorDegree D) b1 b2 ≤ 100 * 2001 ^ 7 / D := by
  classical
  have hlogV : Nat.log 2 Nv ≤ Nat.log 2 D := Nat.log_mono_right hV
  set d := colorDegree D
  set K := ColorSetup.ofArrays dist d b1 b2 (ColorSetup.zeroArr d) (ColorSetup.zeroArr d)
  have hdg := colorDegree_ge hD
  have hs : Nat.size Nv ≤ K.d0 := by
    have := size_le_log Nv; change _ ≤ d; omega
  have hf : flog32 Nv ≤ K.d0 := by
    have := flog32_le_log Nv; change _ ≤ d; omega
  have hpm := K.potMax_le hs hf (by change 2 ≤ d; omega)
  have hpm' : (K.potMax Nv : ℝ) ≤ 36 * (d : ℝ) ^ 7 := by exact_mod_cast hpm
  have hD' : (1 : ℝ) ≤ D := by exact_mod_cast hD
  have hcv : (Nv : ℝ) ≤ D := by exact_mod_cast hV
  have hcv0 : (0 : ℝ) ≤ Nv := Nat.cast_nonneg _
  have hd8 : (8 : ℝ) ≤ d := by exact_mod_cast (show 8 ≤ d by omega)
  have hd7 : (1 : ℝ) ≤ (d : ℝ) ^ 7 := one_le_pow₀ (by linarith)
  have hdd7 : (d : ℝ) ≤ (d : ℝ) ^ 7 := by
    calc (d : ℝ) = (d : ℝ) ^ 1 := (pow_one _).symm
      _ ≤ _ := pow_le_pow_right₀ (by linarith) (by norm_num)
  -- the prefactor
  have hP : (Nv : ℝ) * (Nv * (d + 7) + 1) + Nv *
      (K.potMax Nv * (Nv + 1) + Nv + 1) ≤
      100 * (d : ℝ) ^ 7 * (D : ℝ) ^ 2 := by
    have e1 : (Nv : ℝ) * (Nv * (d + 7) + 1) ≤ 9 * (d : ℝ) ^ 7 * D ^ 2 := by
      have : (Nv : ℝ) * (Nv * (d + 7) + 1) ≤ D * (D * (d + 7) + 1) := by
        gcongr
      nlinarith only [hD', hd8, hdd7, this]
    have e2 : (Nv : ℝ) * (K.potMax Nv * (Nv + 1) +
        Nv + 1) ≤ D * (36 * (d : ℝ) ^ 7 * (D + 1) + D + 1) := by
      have h0 : (0 : ℝ) ≤ K.potMax Nv := Nat.cast_nonneg _
      gcongr
    have e3 : (D : ℝ) * (36 * (d : ℝ) ^ 7 * (D + 1) + D + 1) ≤ 91 * (d : ℝ) ^ 7 * D ^ 2 := by
      have hDD : (D : ℝ) ≤ D ^ 2 := by nlinarith only [hD']
      have a1 : (d : ℝ) ^ 7 * D ≤ (d : ℝ) ^ 7 * D ^ 2 :=
        mul_le_mul_of_nonneg_left hDD (by positivity)
      have a2 : (D : ℝ) ^ 2 ≤ (d : ℝ) ^ 7 * D ^ 2 := le_mul_of_one_le_left (by positivity) hd7
      have a3 : (D : ℝ) ≤ (d : ℝ) ^ 7 * D ^ 2 := hDD.trans a2
      nlinarith only [hd7, hDD]
    linarith
  have hq := pow_65_66_le hD
  have hq0 : (0 : ℝ) ≤ (65 / 66 : ℝ) ^ d := by positivity
  have hdD : (d : ℝ) ≤ 2001 * D := (colorDegree_bounds hD).2
  have hd7D : (d : ℝ) ^ 7 ≤ 2001 ^ 7 * (D : ℝ) ^ 7 := by
    calc (d : ℝ) ^ 7 ≤ (2001 * D) ^ 7 := pow_le_pow_left₀ (by positivity) hdD 7
      _ = _ := by ring
  unfold failBound
  calc _ ≤ 100 * (d : ℝ) ^ 7 * (D : ℝ) ^ 2 * (1 / (2 * D : ℝ) ^ 15) := by
        apply mul_le_mul hP hq hq0 (by positivity)
    _ ≤ 100 * (2001 ^ 7 * (D : ℝ) ^ 7) * (D : ℝ) ^ 2 * (1 / (2 * D : ℝ) ^ 15) := by gcongr
    _ = 100 * 2001 ^ 7 * ((D : ℝ) ^ 9 / (2 * D : ℝ) ^ 15) := by ring
    _ ≤ 100 * 2001 ^ 7 * (1 / D) := by
        apply mul_le_mul_of_nonneg_left _ (by positivity)
        rw [div_le_div_iff₀ (by positivity) (by positivity), one_mul]
        have : (D : ℝ) ^ 10 ≤ (2 * D : ℝ) ^ 15 := by
          calc (D : ℝ) ^ 10 ≤ (D : ℝ) ^ 15 := pow_le_pow_right₀ hD' (by norm_num)
            _ ≤ (2 * D : ℝ) ^ 15 := pow_le_pow_left₀ (by positivity) (by linarith) 15
        calc (D : ℝ) ^ 9 * D = (D : ℝ) ^ 10 := by ring
          _ ≤ _ := this
    _ = 100 * 2001 ^ 7 / D := by ring

theorem card_half_pow_le {Nv D : ℕ} (hD : 1 ≤ D) (hV : Nv ≤ D) :
    (Nv : ℝ) * (1 / 2 : ℝ) ^ (colorDegree D - 4) ≤ 1 / 2 := by
  have hdg := colorDegree_ge hD
  set n := Nat.log 2 D
  have h1 : (Nv : ℝ) ≤ 2 ^ (n + 1) := by
    have := Nat.lt_pow_succ_log_self (b := 2) (by norm_num) D
    exact_mod_cast (hV.trans this.le)
  have h2 : (1 / 2 : ℝ) ^ (colorDegree D - 4) ≤ (1 / 2 : ℝ) ^ (n + 2) :=
    pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
  calc (Nv : ℝ) * (1 / 2 : ℝ) ^ (colorDegree D - 4)
      ≤ 2 ^ (n + 1) * (1 / 2 : ℝ) ^ (n + 2) := by gcongr
    _ = 1 / 2 := by
        rw [show (1 / 2 : ℝ) ^ (n + 2) = (1 / 2) ^ (n + 1) * (1 / 2) by ring, ← mul_assoc,
          ← mul_pow]
        norm_num

open Classical in
/-- Blueprint §12.2 (Declaration coloring, `THT.Localization.monotoneColoring`): with
`d₀ = ⌈1000 log 2D⌉` and at most `D` original vertices, the delays can be fixed so that the
cells with a failed marking have total length at most `100 · 2001⁷ |R| / D`; the colors lie in
`[1, L]` with `L ≤ d₀^{30}`, do not increase along paths (the change counter decreases at every
change of the color data), and equal colors carry equal metadata. -/
theorem monotoneColoring {V : Type*} [Finite V] [DecidableEq V] (T : AdmTree V)
    (dist : DepthDistance V) (b1 b2 : ℕ) {D : ℕ} (hD : 1 ≤ D) (hV : ∀ I, (T.X I).card ≤ D)
    (S : Finset T.Cell) (cellSet : T.Cell → Set ℝ) (hmeas : ∀ I, MeasurableSet (cellSet I))
    {R : Set ℝ} (hRm : MeasurableSet R) (hR : volume R ≠ ⊤) (hsub : ∀ I ∈ S, cellSet I ⊆ R)
    (hnest : ∀ I ∈ S, ∀ J ∈ S, (cellSet I ∩ cellSet J).Nonempty → T.Anc I J ∨ T.Anc J I) :
    ∃ ωp ωh : Fin (colorDegree D) → V → Fin (colorDegree D + 1),
      (volume (⋃ I ∈ S.filter (ColorSetup.FailAt T dist (colorDegree D) b1 b2 ωp ωh),
        cellSet I)).toReal ≤ 100 * 2001 ^ 7 / D * (volume R).toReal ∧
      (ColorSetup.ofArrays dist (colorDegree D) b1 b2 ωp ωh).numColors D ≤
        colorDegree D ^ 30 ∧
      (∀ I v, v ∈ T.X I →
        1 ≤ (ColorSetup.ofArrays dist (colorDegree D) b1 b2 ωp ωh).color T D I v ∧
        (ColorSetup.ofArrays dist (colorDegree D) b1 b2 ωp ωh).color T D I v ≤
          (ColorSetup.ofArrays dist (colorDegree D) b1 b2 ωp ωh).numColors D) ∧
      (∀ I v, v ∈ T.X (T.par I) →
        (ColorSetup.ofArrays dist (colorDegree D) b1 b2 ωp ωh).color T D I v ≤
        (ColorSetup.ofArrays dist (colorDegree D) b1 b2 ωp ωh).color T D
          (T.par I) v) ∧
      (∀ I J v w, v ∈ T.X I → w ∈ T.X J →
        (ColorSetup.ofArrays dist (colorDegree D) b1 b2 ωp ωh).color T D I v =
          (ColorSetup.ofArrays dist (colorDegree D) b1 b2 ωp ωh).color T D J w →
        (ColorSetup.ofArrays dist (colorDegree D) b1 b2 ωp ωh).metaKey
          ((ColorSetup.ofArrays dist (colorDegree D) b1 b2 ωp ωh).colorData (T.st I) v) =
        (ColorSetup.ofArrays dist (colorDegree D) b1 b2 ωp ωh).metaKey
          ((ColorSetup.ofArrays dist (colorDegree D) b1 b2 ωp ωh).colorData (T.st J) w)) := by
  have hdg := colorDegree_ge hD
  have hfl : flog32 D + 2 ≤ colorDegree D := by
    have := flog32_le_log D; omega
  have hsz : Nat.size D ≤ colorDegree D := by
    have := size_le_log D; omega
  have := Fintype.ofFinite V
  obtain ⟨ωp, ωh, hfail⟩ := ColorSetup.delays_exist T dist b1 b2 (by omega) hV hfl
    (card_half_pow_le hD le_rfl) S cellSet hmeas hRm hR hsub hnest
  have hN := hV
  set K := ColorSetup.ofArrays dist (colorDegree D) b1 b2 ωp ωh
  refine ⟨ωp, ωh, ?_, K.numColors_le hsz (by change _ ≤ colorDegree D; omega)
    (by change 3 ≤ colorDegree D; omega),
    fun I v hv => K.color_mem T hN hv, fun I v hv => K.color_anti T hN hv,
    fun I J v w hv hw he => K.metaKey_eq_of_color_eq T hN hv hw he⟩
  refine hfail.trans ?_
  have hB := failBound_le dist b1 b2 (Nv := D) hD le_rfl
  unfold failBound at hB
  exact mul_le_mul_of_nonneg_right hB ENNReal.toReal_nonneg

theorem ColorParams.Hmax_le {V : Type*} {K : ColorSetup V} {Hmax : ℕ} (hP : ColorParams K Hmax) :
    Hmax ≤ 2 * K.b1 := by
  rw [hP.hb1, hP.hb2]
  have h1 : 1 ≤ K.d0 ^ 10 := Nat.one_le_pow _ _ (by have := hP.hd0; omega)
  calc Hmax ≤ 100 * (Hmax + 1) := by omega
    _ ≤ K.d0 ^ 10 * (100 * (Hmax + 1)) := Nat.le_mul_of_pos_left _ h1
    _ ≤ K.d0 ^ 10 * (100 * (Hmax + 1)) * (Hmax + 1) := Nat.le_mul_of_pos_right _ (by omega)
    _ ≤ 2 * (K.d0 ^ 10 * (100 * (Hmax + 1)) * (Hmax + 1)) := by omega

/-- Blueprint lem:masks (Declaration masks, `THT.Localization.historicalMaskSeparation`): for
the pad masks `M_{G,h}` of eq:ball-mask with `h ≤ H_max`,
(1) at an actual use centered at `v` every present vertex within `h` graph edges of `v` lies in
`M_{G,h}`; (2) at an actual use every present neighbor of a vertex of `M_{G,h}` lies in
`M_{G,h+1}` when `h < H_max`; (3) every mask vertex is within graph distance
`(d₀ + 1) b₁ + h` of the primary winner (so lemma graph gives a short path); (4) for distinct
groups of one color, vertices of their pad masks on overlapping usable endpoints are at graph
distance greater than one at the finer endpoint. -/
theorem historicalMaskSeparation {V : Type*} [Finite V] [DecidableEq V] (K : ColorSetup V)
    {Hmax : ℕ} (hP : ColorParams K Hmax) (T : AdmTree V) (Nv : ℕ)
    (hN : ∀ I, (T.X I).card ≤ Nv) :
    (∀ (I : T.Cell) (v : V), v ∈ T.X I → K.Success (K.colorData (T.st I) v) →
      ∀ b ∈ T.X I, ∀ h δ : ℕ, K.dist.d (T.depth I) b v = δ → δ ≤ h → h ≤ Hmax →
        b ∈ K.mask T Nv (K.grp T Nv I v) h I) ∧
    (∀ (I : T.Cell) (v : V), v ∈ T.X I → K.Success (K.colorData (T.st I) v) →
      ∀ h : ℕ, h < Hmax → ∀ b b' : V,
        b ∈ K.mask T Nv (K.grp T Nv I v) h I → b' ∈ T.X I →
        K.dist.d (T.depth I) b b' ≤ 1 →
        b' ∈ K.mask T Nv (K.grp T Nv I v) (h + 1) I) ∧
    (∀ G ρ z g, G.2.1 = some (ρ, z, g) → ∀ (h : ℕ) (I : T.Cell) (b : V),
      b ∈ K.mask T Nv G h I →
      ∃ k : ℕ, K.dist.d (T.depth I) z b = k ∧ k ≤ (K.d0 + 1) * K.b1 + h) ∧
    (∀ (I J u₀ u : T.Cell) (v₁ v₂ : V), T.Anc I J → T.Anc I u₀ → T.Anc J u →
      v₁ ∈ T.X u₀ → v₂ ∈ T.X u → K.Success (K.colorData (T.st u₀) v₁) →
      K.Success (K.colorData (T.st u) v₂) →
      K.color T Nv u₀ v₁ = K.color T Nv u v₂ →
      K.grp T Nv u₀ v₁ ≠ K.grp T Nv u v₂ →
      ∀ h h' : ℕ, h ≤ Hmax → h' ≤ Hmax → ∀ b b' : V,
        b ∈ K.mask T Nv (K.grp T Nv u₀ v₁) h I →
        b' ∈ K.mask T Nv (K.grp T Nv u v₂) h' J →
        ¬ K.dist.d (T.depth J) b b' ≤ 1) := by
  have := Fintype.ofFinite V
  refine ⟨fun I v hv hs b hb h δ hbv hδ hh =>
      K.mem_mask_of_dist T hP _ hv hs hb hbv hδ (hh.trans hP.Hmax_le), ?_,
    fun G ρ z g hG h I b hb => K.mask_short_path T _ hG hb,
    fun I J u₀ u v₁ v₂ hIJ hu₀ hu hv₁ hv₂ hs₁ hs₂ hcol hne h h' hh hh' b b' hb hb' =>
      K.mask_separation T hP _ hN hIJ hu₀ hv₁ hs₁ hu hv₂ hs₂ hcol hne hh hh' hb hb'⟩
  intro I v hv hs h hh b b' hb hb' hadj
  obtain ⟨ρ, z, g, m, l, n, ρ', a, g₂, hc, hl⟩ := hs
  obtain ⟨δ, hδ⟩ : ∃ δ : ℕ, K.dist.d (T.depth I) b b' = δ :=
    ⟨_, (ENat.natCast_toNat (ne_top_of_le_ne_top (by simp) hadj)).symm⟩
  have hδ1 : δ ≤ 1 := by rw [hδ] at hadj; exact_mod_cast hadj
  exact K.mask_neighbor T hP _ hv hc hl hh hb hb' hδ hδ1

section WholeRanges
variable {V ι : Type*} [Fintype V] [DecidableEq V] [Fintype ι] [DecidableEq ι]

/-! ### Whole endpoint ranges (blueprint lem:whole-ranges, lines 1777-1791) -/

/-- A group output `Z_G(y) = Σ_v a_{v,G}(y) Φ_v(y)` with combined coefficients. -/
noncomputable def groupOutput (φ : V → ℝ → ℂ) (ε : V → ℝ) (a : V → ℝ → ℂ) (y : ℝ) :
    ColumnHilbert V :=
  ∑ v, a v y • privateColumnValue φ ε v y

omit [DecidableEq V] in
theorem groupOutput_none (φ : V → ℝ → ℂ) (ε : V → ℝ) (a : V → ℝ → ℂ) (y : ℝ) :
    groupOutput φ ε a y none = ∑ v, a v y * φ v y := by
  classical
  simp [groupOutput, privateColumnValue]

omit [DecidableEq V] in
theorem groupOutput_some (φ : V → ℝ → ℂ) (ε : V → ℝ) (a : V → ℝ → ℂ) (y : ℝ) (u : V) :
    groupOutput φ ε a y (some u) = a u y * (Real.sqrt (ε u) : ℂ) := by
  classical
  simp [groupOutput, privateColumnValue, Pi.single_apply]

omit [DecidableEq V] in
theorem norm_sq_groupOutput (φ : V → ℝ → ℂ) (ε : V → ℝ) (a : V → ℝ → ℂ) (y : ℝ)
    (hε : ∀ v, 0 ≤ ε v) :
    ‖groupOutput φ ε a y‖ ^ 2 =
      ‖∑ v, a v y * φ v y‖ ^ 2 + ∑ u, ‖a u y‖ ^ 2 * ε u := by
  classical
  rw [EuclideanSpace.norm_sq_eq, Fintype.sum_option, groupOutput_none]
  congr 1
  apply Finset.sum_congr rfl
  intro u _
  rw [groupOutput_some, norm_mul, mul_pow, Complex.norm_real, Real.norm_eq_abs, sq_abs,
    Real.sq_sqrt (hε u)]

omit [DecidableEq V] [DecidableEq ι] in
theorem sum_groupOutput (φ : V → ℝ → ℂ) (ε : V → ℝ) (a : ι → V → ℝ → ℂ) (y : ℝ) :
    ∑ G, groupOutput φ ε (a G) y = groupOutput φ ε (fun v y => ∑ G, a G v y) y := by
  classical
  unfold groupOutput
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl; intro v _
  rw [Finset.sum_smul]

/-- `|Σ z_G|² = Σ_G |z_G|² + Σ_{G ≠ G'} Re(conj z_G z_{G'})`. -/
theorem norm_sq_sum_eq (z : ι → ℂ) :
    ‖∑ G, z G‖ ^ 2 = ∑ G, ‖z G‖ ^ 2 +
      ∑ G, ∑ G' ∈ Finset.univ.erase G, (starRingEnd ℂ (z G) * z G').re := by
  rw [← Complex.normSq_eq_norm_sq]
  have h1 : Complex.normSq (∑ G, z G) = (starRingEnd ℂ (∑ G, z G) * ∑ G, z G).re := by
    rw [Complex.normSq_apply, Complex.mul_re, Complex.conj_re, Complex.conj_im]; ring
  rw [h1, map_sum, Finset.sum_mul_sum, Complex.re_sum]
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl; intro G _
  rw [Complex.re_sum, ← Finset.add_sum_erase _ _ (Finset.mem_univ G)]
  congr 1
  rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply, Complex.mul_re, Complex.conj_re,
    Complex.conj_im]
  ring

/-- Cauchy–Schwarz over a support of at most `N` nonzero terms. -/
theorem sq_sum_le_of_support {κ : Type*} [Fintype κ] (x : κ → ℝ)
    {N : ℕ} (hN : (Finset.univ.filter (fun p => x p ≠ 0)).card ≤ N) :
    (∑ p, x p) ^ 2 ≤ N * ∑ p, x p ^ 2 := by
  set S := Finset.univ.filter (fun p => x p ≠ 0)
  have h1 : ∑ p, x p = ∑ p ∈ S, x p := by
    rw [Finset.sum_filter_ne_zero]
  have h2 : ∑ p ∈ S, x p ^ 2 ≤ ∑ p, x p ^ 2 :=
    Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) (fun _ _ _ => sq_nonneg _)
  rw [h1]
  calc (∑ p ∈ S, x p) ^ 2 ≤ S.card * ∑ p ∈ S, x p ^ 2 := sq_sum_le_card_mul_sum_sq
    _ ≤ N * ∑ p, x p ^ 2 := by
        have hc : (S.card : ℝ) ≤ N := by exact_mod_cast hN
        exact mul_le_mul hc h2 (Finset.sum_nonneg fun _ _ => sq_nonneg _) (Nat.cast_nonneg _)

theorem integrable_of_bound_support {E : Type*} [NormedAddCommGroup E] {f : ℝ → E}
    (hf : AEStronglyMeasurable f volume) {C : ℝ} (hC : ∀ y, ‖f y‖ ≤ C) {S : Set ℝ}
    (hS : MeasurableSet S) (hSfin : volume S ≠ ⊤) (hsupp : ∀ y, y ∉ S → f y = 0) :
    Integrable f := by
  have hg : Integrable (S.indicator (fun _ => C)) :=
    (integrableOn_const hSfin).integrable_indicator hS
  refine hg.mono' hf (Filter.Eventually.of_forall fun y => ?_)
  by_cases hy : y ∈ S
  · rw [Set.indicator_of_mem hy]; exact hC y
  · rw [Set.indicator_of_notMem hy, hsupp y hy, norm_zero]

omit [DecidableEq ι] in
theorem norm_sq_sum_of_disjoint (z : ι → ℂ) (h : ∀ G G', G ≠ G' → z G = 0 ∨ z G' = 0) :
    ‖∑ G, z G‖ ^ 2 = ∑ G, ‖z G‖ ^ 2 := by
  classical
  by_cases hz : ∃ G, z G ≠ 0
  · obtain ⟨G₀, hG₀⟩ := hz
    have hothers : ∀ G, G ≠ G₀ → z G = 0 := fun G hG =>
      (h G G₀ hG).resolve_right hG₀
    rw [Finset.sum_eq_single G₀ (fun G _ hG => hothers G hG) (by simp),
      Finset.sum_eq_single G₀ (fun G _ hG => by rw [hothers G hG, norm_zero]; ring) (by simp)]
  · push Not at hz
    simp [hz]

omit [DecidableEq V] [DecidableEq ι] in
/-- Blueprint lem:whole-ranges, analytic core: group outputs `Z_G = Σ_v a_{v,G} Φ_v` with private
coordinates that never coincide on overlaps, cross physical pairings at most `τ ∫ |a_{v,G}|
|a_{w,G'}|`, at most `N` nonzero coefficients at each point and inverse private weights at most
`W₀²` satisfy `‖Σ_G Z_G‖² ≤ (1 + τ N W₀²) Σ_G ‖Z_G‖²`. -/
theorem wholeRanges_core (φ : V → ℝ → ℂ) (ε : V → ℝ) (hε : ∀ v, 0 < ε v) {W₀ : ℝ}
    (hW : ∀ v, 1 ≤ W₀ ^ 2 * ε v) (a : ι → V → ℝ → ℂ) {M : ℝ} {S : Set ℝ}
    (hS : MeasurableSet S) (hSfin : volume S ≠ ⊤) (ha_meas : ∀ G v, Measurable (a G v))
    (hM0 : 0 ≤ M) (ha_bd : ∀ G v y, ‖a G v y‖ ≤ M) (ha_supp : ∀ G v y, y ∉ S → a G v y = 0)
    (hφm : ∀ v, Measurable (φ v)) (hφb : ∀ v y, ‖φ v y‖ ≤ M) {τ : ℝ} (hτ : 0 ≤ τ)
    (hpair : ∀ G G', G ≠ G' → ∀ v w,
      ‖∫ y, starRingEnd ℂ (a G v y * φ v y) * (a G' w y * φ w y)‖ ≤
        τ * ∫ y, ‖a G v y‖ * ‖a G' w y‖)
    (hpriv : ∀ G G', G ≠ G' → ∀ v y, a G v y = 0 ∨ a G' v y = 0) {N : ℕ}
    (hN : ∀ y, ((Finset.univ : Finset (ι × V)).filter (fun p => a p.1 p.2 y ≠ 0)).card ≤ N) :
    ∫ y, ‖∑ G, groupOutput φ ε (a G) y‖ ^ 2 ≤
      (1 + τ * N * W₀ ^ 2) * ∑ G, ∫ y, ‖groupOutput φ ε (a G) y‖ ^ 2 := by
  classical
  have hε0 : ∀ v, 0 ≤ ε v := fun v => (hε v).le
  set P : ι → ℝ → ℂ := fun G y => ∑ v, a G v y * φ v y with hP
  set! Q : ι → ℝ → ℝ := fun G y => ∑ u, ‖a G u y‖ ^ 2 * ε u with hQ
  have hZ : ∀ G y, ‖groupOutput φ ε (a G) y‖ ^ 2 = ‖P G y‖ ^ 2 + Q G y := fun G y =>
    norm_sq_groupOutput φ ε (a G) y hε0
  have hsum : ∀ y, ‖∑ G, groupOutput φ ε (a G) y‖ ^ 2 =
      ∑ G, (‖P G y‖ ^ 2 + Q G y) +
        ∑ G, ∑ G' ∈ Finset.univ.erase G, (starRingEnd ℂ (P G y) * P G' y).re := by
    intro y
    rw [sum_groupOutput, norm_sq_groupOutput _ _ _ _ hε0]
    have e1 : ∑ v, (∑ G, a G v y) * φ v y = ∑ G, P G y := by
      simp only [hP, Finset.sum_mul]; exact Finset.sum_comm
    have e2 : ∑ u, ‖∑ G, a G u y‖ ^ 2 * ε u = ∑ G, Q G y := by
      simp only [hQ]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl; intro u _
      rw [norm_sq_sum_of_disjoint (fun G => a G u y) (fun G G' h => hpriv G G' h u y),
        Finset.sum_mul]
    rw [e1, e2, norm_sq_sum_eq, Finset.sum_add_distrib]
    ring
  -- integrability
  have hsuppP : ∀ G y, y ∉ S → P G y = 0 := fun G y hy => by
    simp only [hP]; exact Finset.sum_eq_zero fun v _ => by rw [ha_supp G v y hy, zero_mul]
  have hsuppQ : ∀ G y, y ∉ S → Q G y = 0 := fun G y hy => by
    simp only [hQ]; exact Finset.sum_eq_zero fun v _ => by rw [ha_supp G v y hy]; simp
  have hPm : ∀ G, Measurable (P G) := fun G =>
    Finset.measurable_sum _ fun v _ => (ha_meas G v).mul (hφm v)
  have hQm : ∀ G, Measurable (Q G) := fun G =>
    Finset.measurable_sum _ fun v _ => ((ha_meas G v).norm.pow_const 2).mul measurable_const
  have hPb : ∀ G y, ‖P G y‖ ≤ Fintype.card V * (M * M) := by
    intro G y
    refine (norm_sum_le _ _).trans ?_
    calc ∑ v, ‖a G v y * φ v y‖ ≤ ∑ _v : V, M * M := Finset.sum_le_sum fun v _ => by
          rw [norm_mul]; exact mul_le_mul (ha_bd G v y) (hφb v y) (norm_nonneg _) hM0
      _ = _ := by simp
  have hQb : ∀ G y, ‖Q G y‖ ≤ ∑ u, M ^ 2 * ε u := by
    intro G y
    rw [Real.norm_eq_abs, abs_of_nonneg (Finset.sum_nonneg fun u _ =>
      mul_nonneg (sq_nonneg _) (hε0 u))]
    exact Finset.sum_le_sum fun u _ => mul_le_mul_of_nonneg_right
      (pow_le_pow_left₀ (norm_nonneg _) (ha_bd G u y) 2) (hε0 u)
  have hintZ : ∀ G, Integrable (fun y => ‖P G y‖ ^ 2 + Q G y) := by
    intro G
    refine integrable_of_bound_support (((hPm G).norm.pow_const 2).add (hQm G)).aestronglyMeasurable
      (C := (Fintype.card V * (M * M)) ^ 2 + ∑ u, M ^ 2 * ε u) (fun y => ?_) hS hSfin
      (fun y hy => by rw [hsuppP G y hy, hsuppQ G y hy]; simp)
    refine (norm_add_le _ _).trans (add_le_add ?_ (hQb G y))
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    exact pow_le_pow_left₀ (norm_nonneg _) (hPb G y) 2
  have hintRe : ∀ G G', Integrable (fun y => (starRingEnd ℂ (P G y) * P G' y).re) := by
    intro G G'
    refine integrable_of_bound_support
      ((Complex.measurable_re.comp ((Complex.continuous_conj.measurable.comp (hPm G)).mul
        (hPm G'))).aestronglyMeasurable)
      (C := (Fintype.card V * (M * M)) ^ 2) (fun y => ?_) hS hSfin
      (fun y hy => by simp [hsuppP G' y hy])
    refine (Complex.abs_re_le_norm _).trans ?_
    rw [norm_mul, Complex.norm_conj, sq]
    exact mul_le_mul (hPb G y) (hPb G' y) (norm_nonneg _) (by positivity)
  have hintC : ∀ G G' v w, Integrable (fun y =>
      starRingEnd ℂ (a G v y * φ v y) * (a G' w y * φ w y)) := by
    intro G G' v w
    refine integrable_of_bound_support
      (((Complex.continuous_conj.measurable.comp ((ha_meas G v).mul (hφm v))).mul
        ((ha_meas G' w).mul (hφm w))).aestronglyMeasurable)
      (C := (M * M) * (M * M)) (fun y => ?_) hS hSfin
      (fun y hy => by simp [ha_supp G' w y hy])
    rw [norm_mul, Complex.norm_conj, norm_mul, norm_mul]
    exact mul_le_mul (mul_le_mul (ha_bd G v y) (hφb v y) (norm_nonneg _) hM0)
      (mul_le_mul (ha_bd G' w y) (hφb w y) (norm_nonneg _) hM0) (by positivity) (by positivity)
  have hintA : ∀ G G' v w, Integrable (fun y => ‖a G v y‖ * ‖a G' w y‖) := by
    intro G G' v w
    refine integrable_of_bound_support
      (((ha_meas G v).norm.mul (ha_meas G' w).norm).aestronglyMeasurable)
      (C := M * M) (fun y => ?_) hS hSfin (fun y hy => by simp [ha_supp G' w y hy])
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    exact mul_le_mul (ha_bd G v y) (ha_bd G' w y) (norm_nonneg _) hM0
  -- step 1: the exact expansion of the integral
  have hstep1 : ∫ y, ‖∑ G, groupOutput φ ε (a G) y‖ ^ 2 =
      (∑ G, ∫ y, (‖P G y‖ ^ 2 + Q G y)) +
        ∑ G, ∑ G' ∈ Finset.univ.erase G, ∫ y, (starRingEnd ℂ (P G y) * P G' y).re := by
    rw [show (fun y => ‖∑ G, groupOutput φ ε (a G) y‖ ^ 2) = fun y => ∑ G, (‖P G y‖ ^ 2 + Q G y) +
        ∑ G, ∑ G' ∈ Finset.univ.erase G, (starRingEnd ℂ (P G y) * P G' y).re from funext hsum]
    rw [integral_add (integrable_finsetSum _ fun G _ => hintZ G)
      (integrable_finsetSum _ fun G _ => integrable_finsetSum _ fun G' _ => hintRe G G'),
      integral_finsetSum _ fun G _ => hintZ G,
      integral_finsetSum _ fun G _ => integrable_finsetSum _ fun G' _ => hintRe G G']
    congr 1
    apply Finset.sum_congr rfl; intro G _
    rw [integral_finsetSum _ fun G' _ => hintRe G G']
  -- step 2: each cross term
  have hstep2 : ∀ G G', G ≠ G' → ∫ y, (starRingEnd ℂ (P G y) * P G' y).re ≤
      τ * ∑ v, ∑ w, ∫ y, ‖a G v y‖ * ‖a G' w y‖ := by
    intro G G' hne
    have hexp : ∀ y, starRingEnd ℂ (P G y) * P G' y = ∑ v, ∑ w,
        starRingEnd ℂ (a G v y * φ v y) * (a G' w y * φ w y) := by
      intro y; simp only [hP, map_sum, Finset.sum_mul_sum]
    have hintCP : Integrable (fun y => starRingEnd ℂ (P G y) * P G' y) := by
      refine integrable_of_bound_support
        (((Complex.continuous_conj.measurable.comp (hPm G)).mul (hPm G')).aestronglyMeasurable)
        (C := (Fintype.card V * (M * M)) ^ 2) (fun y => ?_) hS hSfin
        (fun y hy => by simp [hsuppP G' y hy])
      rw [norm_mul, Complex.norm_conj, sq]
      exact mul_le_mul (hPb G y) (hPb G' y) (norm_nonneg _) (by positivity)
    calc ∫ y, (starRingEnd ℂ (P G y) * P G' y).re
        = (∫ y, starRingEnd ℂ (P G y) * P G' y).re := integral_re hintCP
      _ ≤ ‖∫ y, starRingEnd ℂ (P G y) * P G' y‖ := Complex.re_le_norm _
      _ = ‖∑ v, ∑ w, ∫ y, starRingEnd ℂ (a G v y * φ v y) * (a G' w y * φ w y)‖ := by
          rw [show (fun y => starRingEnd ℂ (P G y) * P G' y) = fun y => ∑ v, ∑ w,
            starRingEnd ℂ (a G v y * φ v y) * (a G' w y * φ w y) from funext hexp,
            integral_finsetSum _ fun v _ => integrable_finsetSum _ fun w _ => hintC G G' v w]
          congr 1
          apply Finset.sum_congr rfl; intro v _
          rw [integral_finsetSum _ fun w _ => hintC G G' v w]
      _ ≤ ∑ v, ∑ w, ‖∫ y, starRingEnd ℂ (a G v y * φ v y) * (a G' w y * φ w y)‖ :=
          (norm_sum_le _ _).trans (Finset.sum_le_sum fun v _ => norm_sum_le _ _)
      _ ≤ ∑ v, ∑ w, τ * ∫ y, ‖a G v y‖ * ‖a G' w y‖ :=
          Finset.sum_le_sum fun v _ => Finset.sum_le_sum fun w _ => hpair G G' hne v w
      _ = τ * ∑ v, ∑ w, ∫ y, ‖a G v y‖ * ‖a G' w y‖ := by
          rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro v _; rw [Finset.mul_sum]
  -- step 3: the pointwise Cauchy–Schwarz bound
  have hpt : ∀ y, ∑ G, ∑ G' ∈ Finset.univ.erase G, ∑ v, ∑ w, ‖a G v y‖ * ‖a G' w y‖ ≤
      N * W₀ ^ 2 * ∑ G, (‖P G y‖ ^ 2 + Q G y) := by
    intro y
    set! x : ι × V → ℝ := fun p => ‖a p.1 p.2 y‖
    have h1 : ∑ G, ∑ G' ∈ Finset.univ.erase G, ∑ v, ∑ w, ‖a G v y‖ * ‖a G' w y‖ ≤
        (∑ p, x p) ^ 2 := by
      calc _ ≤ ∑ G, ∑ G', ∑ v, ∑ w, ‖a G v y‖ * ‖a G' w y‖ :=
            Finset.sum_le_sum fun G _ => Finset.sum_le_sum_of_subset_of_nonneg
              (Finset.erase_subset _ _) (fun _ _ _ => Finset.sum_nonneg fun _ _ =>
                Finset.sum_nonneg fun _ _ => by positivity)
        _ = (∑ p, x p) ^ 2 := by
            rw [sq, Fintype.sum_prod_type, Finset.sum_mul_sum]
            apply Finset.sum_congr rfl; intro G _
            apply Finset.sum_congr rfl; intro G' _
            rw [Finset.sum_mul_sum]
    have h2 : (∑ p, x p) ^ 2 ≤ N * ∑ p, x p ^ 2 := by
      apply sq_sum_le_of_support
      refine le_trans (Finset.card_le_card ?_) (hN y)
      intro p hp
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, x] at hp ⊢
      exact fun h => hp (by rw [h, norm_zero])
    have h3 : ∑ p, x p ^ 2 ≤ W₀ ^ 2 * ∑ G, (‖P G y‖ ^ 2 + Q G y) := by
      rw [Fintype.sum_prod_type, Finset.mul_sum]
      apply Finset.sum_le_sum; intro G _
      have hQ' : ∑ v, x (G, v) ^ 2 ≤ W₀ ^ 2 * Q G y := by
        simp only [hQ, Finset.mul_sum, x]
        apply Finset.sum_le_sum; intro v _
        have := hW v
        have h0 : 0 ≤ ‖a G v y‖ ^ 2 := sq_nonneg _
        nlinarith
      have : 0 ≤ W₀ ^ 2 * ‖P G y‖ ^ 2 := by positivity
      linarith
    have hN0 : (0 : ℝ) ≤ N := Nat.cast_nonneg _
    calc _ ≤ (∑ p, x p) ^ 2 := h1
      _ ≤ N * ∑ p, x p ^ 2 := h2
      _ ≤ N * (W₀ ^ 2 * ∑ G, (‖P G y‖ ^ 2 + Q G y)) := mul_le_mul_of_nonneg_left h3 hN0
      _ = _ := by ring
  -- step 4: assembling
  have hZint : ∀ G, ∫ y, ‖groupOutput φ ε (a G) y‖ ^ 2 = ∫ y, (‖P G y‖ ^ 2 + Q G y) :=
    fun G => by congr 1; funext y; exact hZ G y
  have hcross : ∑ G, ∑ G' ∈ Finset.univ.erase G, ∫ y, (starRingEnd ℂ (P G y) * P G' y).re ≤
      τ * (N * W₀ ^ 2 * ∑ G, ∫ y, (‖P G y‖ ^ 2 + Q G y)) := by
    calc _ ≤ ∑ G, ∑ G' ∈ Finset.univ.erase G, τ * ∑ v, ∑ w, ∫ y, ‖a G v y‖ * ‖a G' w y‖ :=
          Finset.sum_le_sum fun G _ => Finset.sum_le_sum fun G' hG' =>
            hstep2 G G' (Finset.ne_of_mem_erase hG').symm
      _ = τ * ∫ y, ∑ G, ∑ G' ∈ Finset.univ.erase G, ∑ v, ∑ w, ‖a G v y‖ * ‖a G' w y‖ := by
          rw [integral_finsetSum _ fun G _ => integrable_finsetSum _ fun G' _ =>
            integrable_finsetSum _ fun v _ => integrable_finsetSum _ fun w _ => hintA G G' v w]
          rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro G _
          rw [integral_finsetSum _ fun G' _ => integrable_finsetSum _ fun v _ =>
            integrable_finsetSum _ fun w _ => hintA G G' v w, Finset.mul_sum]
          apply Finset.sum_congr rfl; intro G' _
          rw [integral_finsetSum _ fun v _ => integrable_finsetSum _ fun w _ => hintA G G' v w]
          congr 1; apply Finset.sum_congr rfl; intro v _
          rw [integral_finsetSum _ fun w _ => hintA G G' v w]
      _ ≤ τ * ∫ y, N * W₀ ^ 2 * ∑ G, (‖P G y‖ ^ 2 + Q G y) := by
          apply mul_le_mul_of_nonneg_left _ hτ
          apply integral_mono (integrable_finsetSum _ fun G _ => integrable_finsetSum _
            fun G' _ => integrable_finsetSum _ fun v _ => integrable_finsetSum _
              fun w _ => hintA G G' v w)
            ((integrable_finsetSum _ fun G _ => hintZ G).const_mul _) hpt
      _ = τ * (N * W₀ ^ 2 * ∑ G, ∫ y, (‖P G y‖ ^ 2 + Q G y)) := by
          rw [integral_const_mul, integral_finsetSum _ fun G _ => hintZ G]
  rw [hstep1]
  simp only [hZint]
  nlinarith

end WholeRanges

/-- Only finitely many cells of one depth meet a bounded interval. -/
theorem cells_meeting_finite (Gd : RealDyadicGrid) (s : ℤ) (a b : ℝ) :
    ∃ 𝒦 : Finset ℤ, ∀ n, ∀ y ∈ dyadicGridCell Gd s n, a ≤ y → y ≤ b → n ∈ 𝒦 := by
  set ℓ := dyadicGridLength Gd s
  have hℓ : 0 < ℓ := dyadicGridLength_pos Gd s
  refine ⟨Finset.Icc (⌊(a - Gd.origin s) / ℓ⌋ - 1) (⌈(b - Gd.origin s) / ℓ⌉), ?_⟩
  intro n y hy hay hyb
  simp only [dyadicGridCell, dyadicGridLeft, Set.mem_Ico] at hy
  obtain ⟨h1, h2⟩ := hy
  rw [Finset.mem_Icc]
  constructor
  · have : (a - Gd.origin s) / ℓ < n + 1 := by
      rw [div_lt_iff₀ hℓ]; linarith
    have := Int.floor_le ((a - Gd.origin s) / ℓ)
    have : (⌊(a - Gd.origin s) / ℓ⌋ : ℝ) < n + 1 := by linarith
    have : ⌊(a - Gd.origin s) / ℓ⌋ < n + 1 := by exact_mod_cast this
    omega
  · have : (n : ℝ) ≤ (b - Gd.origin s) / ℓ := by
      rw [le_div_iff₀ hℓ]; linarith
    exact Int.cast_le.mp (this.trans (Int.le_ceil _)) |> fun h => by exact_mod_cast h

/-- A function constant on the cells of one depth, supported in finitely many of them, pairs
against `ψ` with the per-cell bound (the grid argument of blueprint line 1785). -/
theorem pairing_of_cellwise_constant (Gd : RealDyadicGrid) (s : ℤ) (𝒦 : Finset ℤ)
    (f ψ : ℝ → ℂ) (hψm : Measurable ψ) {M : ℝ} (hψb : ∀ y, ‖ψ y‖ ≤ M)
    (hconst : ∀ n, ∀ y ∈ dyadicGridCell Gd s n, ∀ y' ∈ dyadicGridCell Gd s n, f y = f y')
    (hsupp : ∀ y, f y ≠ 0 → ∃ n ∈ 𝒦, y ∈ dyadicGridCell Gd s n) {τ : ℝ}
    (hcell : ∀ n ∈ 𝒦, ‖∫ y in dyadicGridCell Gd s n, ψ y‖ ≤ τ * dyadicGridLength Gd s) :
    ‖∫ y, f y * ψ y‖ ≤ τ * ∫ y, ‖f y‖ := by
  classical
  set L : ℤ → ℝ := fun n => dyadicGridLeft Gd s n
  set C : ℤ → Set ℝ := fun n => dyadicGridCell Gd s n
  have hCm : ∀ n, MeasurableSet (C n) := fun n => dyadicGridCell_measurable Gd s n
  have hCvol : ∀ n, volume (C n) ≠ ⊤ := fun n => by
    simp [C, dyadicGridCell_volume]
  have hdisj : ∀ n n', n ≠ n' → Disjoint (C n) (C n') := fun n n' h =>
    dyadicGridCell_pairwiseDisjoint Gd s h
  have hL : ∀ n, L n ∈ C n := fun n => dyadicGridCell_left_mem Gd s n
  -- the cellwise decomposition
  have hdec : ∀ (g : ℂ → ℂ), g 0 = 0 → ∀ y,
      g (f y) = ∑ n ∈ 𝒦, (C n).indicator (fun _ => g (f (L n))) y := by
    intro g hg y
    by_cases hy : ∃ n ∈ 𝒦, y ∈ C n
    · obtain ⟨n₀, hn₀, hyn₀⟩ := hy
      rw [Finset.sum_eq_single n₀]
      · rw [Set.indicator_of_mem hyn₀, hconst n₀ y hyn₀ (L n₀) (hL n₀)]
      · intro n _ hn
        exact Set.indicator_of_notMem (fun hyn => (hdisj n n₀ hn).le_bot ⟨hyn, hyn₀⟩) _
      · intro h; exact absurd hn₀ h
    · have hf0 : f y = 0 := by
        by_contra h; exact hy (hsupp y h)
      rw [hf0, hg]
      symm
      exact Finset.sum_eq_zero fun n hn => Set.indicator_of_notMem
        (fun hyn => hy ⟨n, hn, hyn⟩) _
  have hψint : ∀ n, IntegrableOn ψ (C n) := fun n =>
    Measure.integrableOn_of_bounded (M := M) (hCvol n) hψm.aestronglyMeasurable
      (Filter.Eventually.of_forall hψb)
  have h1 : ∫ y, f y * ψ y = ∑ n ∈ 𝒦, f (L n) * ∫ y in C n, ψ y := by
    have : ∀ y, f y * ψ y = ∑ n ∈ 𝒦, (C n).indicator (fun y => f (L n) * ψ y) y := by
      intro y
      have h := hdec id rfl y
      simp only [id] at h
      rw [h, Finset.sum_mul]
      apply Finset.sum_congr rfl; intro n _
      by_cases hyn : y ∈ C n
      · simp [Set.indicator_of_mem hyn]
      · simp [Set.indicator_of_notMem hyn]
    rw [show (fun y => f y * ψ y) = fun y =>
        ∑ n ∈ 𝒦, (C n).indicator (fun y => f (L n) * ψ y) y from funext this]
    rw [integral_finsetSum _ fun n _ => (show IntegrableOn (fun y => f (L n) * ψ y) (C n) volume
        from
      (hψint n).const_mul _).integrable_indicator (hCm n)]
    apply Finset.sum_congr rfl; intro n _
    rw [integral_indicator (hCm n), integral_const_mul]
  have h2 : ∫ y, ‖f y‖ = ∑ n ∈ 𝒦, ‖f (L n)‖ * dyadicGridLength Gd s := by
    have : ∀ y, ((‖f y‖ : ℝ) : ℂ) =
        ∑ n ∈ 𝒦, (C n).indicator (fun _ => ((‖f (L n)‖ : ℝ) : ℂ)) y :=
      fun y => hdec (fun z => ((‖z‖ : ℝ) : ℂ)) (by simp) y
    have hreal : ∀ y, ‖f y‖ = ∑ n ∈ 𝒦, (C n).indicator (fun _ => ‖f (L n)‖) y := by
      intro y
      have := this y
      have e : ∀ n, ((C n).indicator (fun _ => ((‖f (L n)‖ : ℝ) : ℂ)) y) =
          (((C n).indicator (fun _ => ‖f (L n)‖) y : ℝ) : ℂ) := by
        intro n
        by_cases hyn : y ∈ C n
        · simp [Set.indicator_of_mem hyn]
        · simp [Set.indicator_of_notMem hyn]
      simp only [e] at this
      exact_mod_cast this
    rw [show (fun y => ‖f y‖) = fun y => ∑ n ∈ 𝒦, (C n).indicator (fun _ => ‖f (L n)‖) y from
      funext hreal]
    rw [integral_finsetSum _ fun n _ => (integrableOn_const (hCvol n)).integrable_indicator
      (hCm n)]
    apply Finset.sum_congr rfl; intro n _
    rw [integral_indicator (hCm n), setIntegral_const, smul_eq_mul, mul_comm, measureReal_def]
    simp [C, dyadicGridCell_volume, (dyadicGridLength_pos Gd s).le]
  rw [h1, h2, Finset.mul_sum]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun n hn => ?_)
  rw [norm_mul]
  calc ‖f (L n)‖ * ‖∫ y in C n, ψ y‖ ≤ ‖f (L n)‖ * (τ * dyadicGridLength Gd s) :=
        mul_le_mul_of_nonneg_left (hcell n hn) (norm_nonneg _)
    _ = τ * (‖f (L n)‖ * dyadicGridLength Gd s) := by ring

section WholeRanges
variable {V ι : Type*} [Fintype V] [DecidableEq V] [Fintype ι] [DecidableEq ι]

/-- The combined coefficient `a_{v,G} = Σ_I a_{v,G,I} 1_I` of the occurrences of `v` in `G`. -/
noncomputable def occCoef (Gd : RealDyadicGrid) (occ : ι → V → Finset (ℤ × ℤ))
    (c : ι → V → ℤ × ℤ → ℂ) (G : ι) (v : V) (y : ℝ) : ℂ :=
  ∑ I ∈ occ G v, (dyadicGridCell Gd I.1 I.2).indicator (fun _ => c G v I) y

omit [Fintype V] [DecidableEq V] [Fintype ι] [DecidableEq ι] in
theorem occCoef_measurable (Gd : RealDyadicGrid) (occ : ι → V → Finset (ℤ × ℤ))
    (c : ι → V → ℤ × ℤ → ℂ) (G : ι) (v : V) : Measurable (occCoef Gd occ c G v) :=
  Finset.measurable_sum _ fun I _ =>
    measurable_const.indicator (dyadicGridCell_measurable Gd I.1 I.2)

omit [Fintype V] [DecidableEq V] [Fintype ι] [DecidableEq ι] in
theorem norm_occCoef_le (Gd : RealDyadicGrid) (occ : ι → V → Finset (ℤ × ℤ))
    (c : ι → V → ℤ × ℤ → ℂ) {Mc : ℝ} (hc : ∀ G v I, ‖c G v I‖ ≤ Mc) {K₀ : ℕ}
    (hK : ∀ G v, (occ G v).card ≤ K₀) (G : ι) (v : V) (y : ℝ) :
    ‖occCoef Gd occ c G v y‖ ≤ K₀ * Mc := by
  classical
  have hMc : 0 ≤ Mc := (norm_nonneg _).trans (hc G v (0, 0))
  refine (norm_sum_le _ _).trans ?_
  calc ∑ I ∈ occ G v, ‖(dyadicGridCell Gd I.1 I.2).indicator (fun _ => c G v I) y‖
      ≤ ∑ _I ∈ occ G v, Mc := Finset.sum_le_sum fun I _ => by
        by_cases hy : y ∈ dyadicGridCell Gd I.1 I.2
        · rw [Set.indicator_of_mem hy]; exact hc G v I
        · rw [Set.indicator_of_notMem hy, norm_zero]; exact hMc
    _ = (occ G v).card * Mc := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ K₀ * Mc := by gcongr; exact_mod_cast hK G v

omit [DecidableEq V] [DecidableEq ι] in
/-- Blueprint lem:whole-ranges (Declaration whole-ranges, `THT.Localization.usableRangeBessel`):
group outputs `Z_G = Σ_v a_{v,G} Φ_v` whose combined coefficients are constant on entire endpoint
cells satisfy `‖Σ_G Z_G‖² ≤ (1 + τ N W₀²) Σ_G ‖Z_G‖²` provided
(i) overlapping endpoint cells of labels in different groups have depth at most the last
separating depth `s_*(v, w)` of the two labels (lemma masks),
(ii) at that depth the physical pairing of the two pure columns is at most `τ` on every cell
(lemma graph), for labels with overlapping occurrences in different groups,
(iii) private labels never coincide on an overlap, and
(iv) at most `N` group-label pairs are present at each point and inverse private weights are
at most `W₀²`. -/
theorem usableRangeBessel (Gd : RealDyadicGrid) (φ : V → ℝ → ℂ) (ε : V → ℝ)
    (hε : ∀ v, 0 < ε v) {W₀ : ℝ} (hW : ∀ v, 1 ≤ W₀ ^ 2 * ε v) (hφm : ∀ v, Measurable (φ v))
    {Mφ : ℝ} (hφb : ∀ v y, ‖φ v y‖ ≤ Mφ) (occ : ι → V → Finset (ℤ × ℤ))
    (c : ι → V → ℤ × ℤ → ℂ) {Mc : ℝ} (hMc : 0 ≤ Mc) (hc : ∀ G v I, ‖c G v I‖ ≤ Mc) {K₀ : ℕ}
    (hK : ∀ G v, (occ G v).card ≤ K₀) {ra rb : ℝ}
    (hroot : ∀ G v, ∀ I ∈ occ G v, dyadicGridCell Gd I.1 I.2 ⊆ Set.Icc ra rb)
    (sep : V → V → ℤ)
    (hsep : ∀ G G', G ≠ G' → ∀ v w, ∀ I ∈ occ G v, ∀ J ∈ occ G' w,
      (dyadicGridCell Gd I.1 I.2 ∩ dyadicGridCell Gd J.1 J.2).Nonempty →
        I.1 ≤ sep v w ∧ J.1 ≤ sep v w)
    {τ : ℝ} (hτ : 0 ≤ τ)
    (hcell : ∀ G G', G ≠ G' → ∀ v w, (∃ I ∈ occ G v, ∃ J ∈ occ G' w,
      (dyadicGridCell Gd I.1 I.2 ∩ dyadicGridCell Gd J.1 J.2).Nonempty) →
      ∀ n, ‖∫ y in dyadicGridCell Gd (sep v w) n,
        starRingEnd ℂ (φ v y) * φ w y‖ ≤ τ * dyadicGridLength Gd (sep v w))
    (hpriv : ∀ G G', G ≠ G' → ∀ v, ∀ I ∈ occ G v, ∀ J ∈ occ G' v,
      Disjoint (dyadicGridCell Gd I.1 I.2) (dyadicGridCell Gd J.1 J.2))
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × V)).filter
      (fun p => occCoef Gd occ c p.1 p.2 y ≠ 0)).card ≤ N) :
    ∫ y, ‖∑ G, groupOutput φ ε (occCoef Gd occ c G) y‖ ^ 2 ≤
      (1 + τ * N * W₀ ^ 2) * ∑ G, ∫ y, ‖groupOutput φ ε (occCoef Gd occ c G) y‖ ^ 2 := by
  classical
  set a := occCoef Gd occ c with ha
  set! M := max ((K₀ : ℝ) * Mc) Mφ
  have hM0 : 0 ≤ M := le_max_of_le_left (by positivity)
  have hab : ∀ G v y, ‖a G v y‖ ≤ M := fun G v y =>
    (norm_occCoef_le Gd occ c hc hK G v y).trans (le_max_left _ _)
  have hφb' : ∀ v y, ‖φ v y‖ ≤ M := fun v y => (hφb v y).trans (le_max_right _ _)
  -- a nonzero coefficient sits in one of its cells
  have hmem : ∀ G v y, a G v y ≠ 0 → ∃ I ∈ occ G v, y ∈ dyadicGridCell Gd I.1 I.2 := by
    intro G v y h
    by_contra hno
    push Not at hno
    exact h (Finset.sum_eq_zero fun I hI => Set.indicator_of_notMem (hno I hI) _)
  have hsupp : ∀ G v y, y ∉ Set.Icc ra rb → a G v y = 0 := by
    intro G v y hy
    by_contra h
    obtain ⟨I, hI, hyI⟩ := hmem G v y h
    exact hy (hroot G v I hI hyI)
  apply wholeRanges_core φ ε hε hW a measurableSet_Icc measure_Icc_lt_top.ne
    (occCoef_measurable Gd occ c) hM0 hab hsupp hφm hφb' hτ _ _ hN
  · -- the cross pairings
    intro G G' hne v w
    by_cases hov : ∃ I ∈ occ G v, ∃ J ∈ occ G' w,
        (dyadicGridCell Gd I.1 I.2 ∩ dyadicGridCell Gd J.1 J.2).Nonempty
    swap
    · have h0 : ∀ y, a G v y * a G' w y = 0 := by
        intro y
        by_contra h
        obtain ⟨I, hI, hyI⟩ := hmem G v y (left_ne_zero_of_mul h)
        obtain ⟨J, hJ, hyJ⟩ := hmem G' w y (right_ne_zero_of_mul h)
        exact hov ⟨I, hI, J, hJ, y, hyI, hyJ⟩
      have hz : (fun y => starRingEnd ℂ (a G v y * φ v y) * (a G' w y * φ w y)) = fun _ => 0 := by
        funext y
        have := h0 y
        rcases mul_eq_zero.mp this with h | h <;> simp [h]
      rw [hz, integral_zero, norm_zero]
      exact mul_nonneg hτ (integral_nonneg fun y => by positivity)
    set! s := sep v w
    obtain ⟨𝒦, h𝒦⟩ := cells_meeting_finite Gd s ra rb
    set! f : ℝ → ℂ := fun y => starRingEnd ℂ (a G v y) * a G' w y
    set! ψ : ℝ → ℂ := fun y => starRingEnd ℂ (φ v y) * φ w y
    have e1 : (fun y => starRingEnd ℂ (a G v y * φ v y) * (a G' w y * φ w y)) =
        fun y => f y * ψ y := by
      funext y; simp only [f, ψ, map_mul]; ring
    have e2 : (fun y => ‖a G v y‖ * ‖a G' w y‖) = fun y => ‖f y‖ := by
      funext y; simp only [f, norm_mul, Complex.norm_conj]
    rw [e1, e2]
    apply pairing_of_cellwise_constant Gd s 𝒦 f ψ
      ((Complex.continuous_conj.measurable.comp (hφm v)).mul (hφm w))
      (M := max (M * M) (Mφ * Mφ))
    · intro y
      simp only [ψ, norm_mul, Complex.norm_conj]
      have hMφ : 0 ≤ Mφ := (norm_nonneg _).trans (hφb v y)
      exact (mul_le_mul (hφb v y) (hφb w y) (norm_nonneg _) hMφ).trans (le_max_right _ _)
    · -- constancy on the cells of the separating depth
      intro n y hy y' hy'
      simp only [f, ha, occCoef, map_sum, Finset.sum_mul_sum]
      apply Finset.sum_congr rfl; intro I hI; apply Finset.sum_congr rfl; intro J hJ
      have key : ∀ x x', x ∈ dyadicGridCell Gd s n → x' ∈ dyadicGridCell Gd s n →
          x ∈ dyadicGridCell Gd I.1 I.2 → x ∈ dyadicGridCell Gd J.1 J.2 →
          x' ∈ dyadicGridCell Gd I.1 I.2 ∧ x' ∈ dyadicGridCell Gd J.1 J.2 := by
        intro x x' hx hx' hxI hxJ
        obtain ⟨hIs, hJs⟩ := hsep G G' hne v w I hI J hJ ⟨x, hxI, hxJ⟩
        rcases dyadicGridCell_nested_or_disjoint_of_le Gd hIs I.2 n with hd | hsub
        · exact absurd (hd.le_bot ⟨hxI, hx⟩) (by simp)
        rcases dyadicGridCell_nested_or_disjoint_of_le Gd hJs J.2 n with hd' | hsub'
        · exact absurd (hd'.le_bot ⟨hxJ, hx⟩) (by simp)
        exact ⟨hsub hx', hsub' hx'⟩
      by_cases h1 : y ∈ dyadicGridCell Gd I.1 I.2 ∧ y ∈ dyadicGridCell Gd J.1 J.2
      · obtain ⟨h1', h2'⟩ := key y y' hy hy' h1.1 h1.2
        rw [Set.indicator_of_mem h1.1, Set.indicator_of_mem h1.2, Set.indicator_of_mem h1',
          Set.indicator_of_mem h2']
      · have h2 : ¬ (y' ∈ dyadicGridCell Gd I.1 I.2 ∧ y' ∈ dyadicGridCell Gd J.1 J.2) :=
          fun h => h1 (key y' y hy' hy h.1 h.2)
        have z1 : starRingEnd ℂ ((dyadicGridCell Gd I.1 I.2).indicator (fun _ => c G v I) y) *
            (dyadicGridCell Gd J.1 J.2).indicator (fun _ => c G' w J) y = 0 := by
          by_cases hyI : y ∈ dyadicGridCell Gd I.1 I.2
          · rw [Set.indicator_of_notMem (fun hyJ => h1 ⟨hyI, hyJ⟩), mul_zero]
          · rw [Set.indicator_of_notMem hyI, map_zero, zero_mul]
        have z2 : starRingEnd ℂ ((dyadicGridCell Gd I.1 I.2).indicator (fun _ => c G v I) y') *
            (dyadicGridCell Gd J.1 J.2).indicator (fun _ => c G' w J) y' = 0 := by
          by_cases hyI : y' ∈ dyadicGridCell Gd I.1 I.2
          · rw [Set.indicator_of_notMem (fun hyJ => h2 ⟨hyI, hyJ⟩), mul_zero]
          · rw [Set.indicator_of_notMem hyI, map_zero, zero_mul]
        rw [z1, z2]
    · -- support in finitely many cells
      intro y hy
      have hav : a G v y ≠ 0 := by
        intro h; apply hy; simp only [f, h, map_zero, zero_mul]
      obtain ⟨I, hI, hyI⟩ := hmem G v y hav
      have hyR := hroot G v I hI hyI
      obtain ⟨n, hn⟩ := dyadicGridCell_covers Gd s y
      exact ⟨n, h𝒦 n y hn hyR.1 hyR.2, hn⟩
    · intro n _; exact hcell G G' hne v w hov n
  · -- private coordinates never coincide on an overlap
    intro G G' hne v y
    by_contra h
    push Not at h
    obtain ⟨I, hI, hyI⟩ := hmem G v y h.1
    obtain ⟨J, hJ, hyJ⟩ := hmem G' v y h.2
    exact (hpriv G G' hne v I hI J hJ).le_bot ⟨hyI, hyJ⟩

end WholeRanges

end TrilinearHT.Auto


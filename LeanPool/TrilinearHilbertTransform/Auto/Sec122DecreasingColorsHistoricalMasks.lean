namespace TrilinearHT.Auto
open MeasureTheory Metric
open scoped FourierTransform ComplexConjugate ENNReal

section AdmissionTree
variable (G : RealDyadicGrid) (R : ℤ × ℤ) (N : ℕ)

/-! ### One attempt: the admission tree (blueprint lines 1677-1681) -/

/-- The cells of the finite tree below `R`. -/
abbrev AdmCell := ↥(dyadicFiniteTree G R N)

variable {G R N}

theorem admCell_sub (I : AdmCell G R N) :
    dyadicGridCell G I.1.1 I.1.2 ⊆ dyadicGridCell G R.1 R.2 :=
  ((dyadicFiniteTree_mem_iff G R I.1 N).mp I.2).1

theorem admCell_depth_ge (I : AdmCell G R N) : R.1 ≤ I.1.1 :=
  dyadicGridCell_depth_le_of_subset G I.1 R (admCell_sub I)

/-- Two ancestors of one cell at the same depth coincide. -/
theorem anc_eq_of_depth {I J J' : ℤ × ℤ} (hJ : dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2)
    (hJ' : dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J'.1 J'.2) (hd : J.1 = J'.1) : J = J' := by
  have hx := dyadicGridCell_left_mem G I.1 I.2
  have h1 := hJ hx
  have h2 := hJ' hx
  rw [hd] at h1
  exact Prod.ext hd (dyadicGridCell_sameDepth_common_point G J'.1 J.2 J'.2 h1 h2)

/-- The parent of a non-root cell lies in the tree. -/
theorem admParent_mem (I : AdmCell G R N) (h : I.1 ≠ R) :
    dyadicParent G I.1 ∈ dyadicFiniteTree G R N := by
  rw [dyadicFiniteTree_mem_iff]
  refine ⟨dyadicParent_subset_of_subset G (admCell_sub I) h, ?_⟩
  have := ((dyadicFiniteTree_mem_iff G R I.1 N).mp I.2).2
  simp only [dyadicParent]; omega

theorem admCell_depth_gt (I : AdmCell G R N) (h : I.1 ≠ R) : R.1 < I.1.1 :=
  dyadicGridCell_depth_lt_of_subset_ne G I.1 R (admCell_sub I) h

variable {Λ : Type*} (av : ℤ × ℤ → Λ → Prop)

/-- Ancestors-or-self of a cell in the tree at which a label is available. -/
noncomputable def admAnc (I : AdmCell G R N) (v : Λ) : Finset (AdmCell G R N) := by
  classical
  exact Finset.univ.filter fun J =>
    dyadicGridCell G I.1.1 I.1.2 ⊆ dyadicGridCell G J.1.1 J.1.2 ∧ av J.1 v

/-- The admission cell of a label along the path of `I`: its shallowest available ancestor. -/
noncomputable def admCellOf (I : AdmCell G R N) (v : Λ) : AdmCell G R N := by
  classical
  exact if h : (admAnc av I v).Nonempty then
    Classical.choose (Finset.exists_min_image (admAnc av I v) (fun J => J.1.1) h) else I

theorem admCellOf_spec {I : AdmCell G R N} {v : Λ} (h : (admAnc av I v).Nonempty) :
    admCellOf av I v ∈ admAnc av I v ∧
      ∀ J ∈ admAnc av I v, (admCellOf av I v).1.1 ≤ J.1.1 := by
  classical
  unfold admCellOf
  simp only [h, ↓reduceDIte]
  exact Classical.choose_spec (Finset.exists_min_image (admAnc av I v) (fun J => J.1.1) h)

theorem mem_admAnc {I J : AdmCell G R N} {v : Λ} :
    J ∈ admAnc av I v ↔ dyadicGridCell G I.1.1 I.1.2 ⊆ dyadicGridCell G J.1.1 J.1.2 ∧ av J.1 v := by
  classical
  unfold admAnc
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]

/-- Characterization of the admission cell by minimality. -/
theorem admCellOf_eq {I J : AdmCell G R N} {v : Λ} (hJ : J ∈ admAnc av I v)
    (hmin : ∀ J' ∈ admAnc av I v, J.1.1 ≤ J'.1.1) : admCellOf av I v = J := by
  have hne : (admAnc av I v).Nonempty := ⟨J, hJ⟩
  obtain ⟨h1, h2⟩ := admCellOf_spec av hne
  have hle := h2 J hJ
  have hge := hmin _ h1
  exact Subtype.ext (anc_eq_of_depth ((mem_admAnc av).mp h1).1 ((mem_admAnc av).mp hJ).1
    (le_antisymm hle hge))

/-- The admission cell of a label at a cell persists at its children. -/
theorem admCellOf_parent {I : AdmCell G R N} (hI : I.1 ≠ R) {v : Λ}
    (h : (admAnc av ⟨dyadicParent G I.1, admParent_mem I hI⟩ v).Nonempty) :
    (admAnc av I v).Nonempty ∧
      admCellOf av I v = admCellOf av ⟨dyadicParent G I.1, admParent_mem I hI⟩ v := by
  set P : AdmCell G R N := ⟨dyadicParent G I.1, admParent_mem I hI⟩
  have hIP : dyadicGridCell G I.1.1 I.1.2 ⊆ dyadicGridCell G P.1.1 P.1.2 :=
    dyadicParent_subset G I.1
  have hsub : ∀ J, J ∈ admAnc av P v → J ∈ admAnc av I v := fun J hJ =>
    (mem_admAnc av).mpr ⟨hIP.trans ((mem_admAnc av).mp hJ).1, ((mem_admAnc av).mp hJ).2⟩
  obtain ⟨hP1, hP2⟩ := admCellOf_spec av h
  have hne : (admAnc av I v).Nonempty := ⟨_, hsub _ hP1⟩
  refine ⟨hne, ?_⟩
  obtain ⟨hI1, hI2⟩ := admCellOf_spec av hne
  -- the admission cell at `I` is a strict ancestor of `I`
  have hdepth := hI2 _ (hsub _ hP1)
  have hPd : (admCellOf av P v).1.1 ≤ P.1.1 :=
    dyadicGridCell_depth_le_of_subset G P.1 _ ((mem_admAnc av).mp hP1).1
  have hPI : P.1.1 = I.1.1 - 1 := rfl
  have hne' : (admCellOf av I v).1 ≠ I.1 := by
    intro heq
    have : (admCellOf av I v).1.1 = I.1.1 := by rw [heq]
    omega
  have hanc : dyadicGridCell G P.1.1 P.1.2 ⊆
      dyadicGridCell G (admCellOf av I v).1.1 (admCellOf av I v).1.2 :=
    dyadicParent_subset_of_subset G ((mem_admAnc av).mp hI1).1 (Ne.symm hne')
  have hmemP : admCellOf av I v ∈ admAnc av P v :=
    (mem_admAnc av).mpr ⟨hanc, ((mem_admAnc av).mp hI1).2⟩
  exact (admCellOf_eq av hmemP fun J hJ => hI2 J (hsub J hJ)).symm

/-- The vertices: a label with its admission cell. -/
abbrev AdmVertex := Λ × AdmCell G R N

/-- The present vertices at a cell. -/
noncomputable def admPresent [Fintype Λ] (I : AdmCell G R N) :
    Finset (AdmVertex (G := G) (R := R) (N := N) (Λ := Λ)) := by
  classical
  exact (Finset.univ.filter fun v => (admAnc av I v).Nonempty).image fun v => (v, admCellOf av I v)

theorem mem_admPresent [Fintype Λ] {I : AdmCell G R N} {x : AdmVertex (G := G) (R := R) (N := N)
    (Λ := Λ)} : x ∈ admPresent av I ↔ (admAnc av I x.1).Nonempty ∧ x.2 = admCellOf av I x.1 := by
  classical
  unfold admPresent
  simp only [Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨v, hv, rfl⟩; exact ⟨hv, rfl⟩
  · rintro ⟨hv, hx⟩; exact ⟨x.1, hv, Prod.ext rfl hx.symm⟩

/-- The present vertices of the parent are present at the child. -/
theorem admPresent_parent [Fintype Λ] {I : AdmCell G R N} (hI : I.1 ≠ R) :
    admPresent av ⟨dyadicParent G I.1, admParent_mem I hI⟩ ⊆ admPresent av I := by
  intro x hx
  obtain ⟨hne, hx2⟩ := (mem_admPresent av).mp hx
  obtain ⟨hne', heq⟩ := admCellOf_parent av hI hne
  exact (mem_admPresent av).mpr ⟨hne', hx2.trans heq.symm⟩

/-- The admission key: admission depth first, then the label order. -/
noncomputable def admKey [Fintype Λ] (x : AdmVertex (G := G) (R := R) (N := N) (Λ := Λ)) : ℕ :=
  (x.2.1.1 - R.1).toNat * Fintype.card Λ + Fintype.equivFin Λ x.1

theorem admKey_label [Fintype Λ] {x y : AdmVertex (G := G) (R := R) (N := N) (Λ := Λ)}
    (h : admKey x = admKey y) : x.1 = y.1 := by
  unfold admKey at h
  have hx := (Fintype.equivFin Λ x.1).2
  have hy := (Fintype.equivFin Λ y.1).2
  have h1 : ((x.2.1.1 - R.1).toNat * Fintype.card Λ + Fintype.equivFin Λ x.1) % Fintype.card Λ =
      ((y.2.1.1 - R.1).toNat * Fintype.card Λ + Fintype.equivFin Λ y.1) % Fintype.card Λ := by
    rw [h]
  rw [Nat.mul_add_mod_self_right, Nat.mod_eq_of_lt hx, Nat.mul_add_mod_self_right,
    Nat.mod_eq_of_lt hy] at h1
  exact (Fintype.equivFin Λ).injective (Fin.ext h1)

/-- The admission position of a present vertex. -/
noncomputable def admPos [Fintype Λ] (I : AdmCell G R N)
    (x : AdmVertex (G := G) (R := R) (N := N) (Λ := Λ)) : ℕ := by
  classical
  exact ((admPresent av I).filter fun y => admKey y < admKey x).card

theorem admPos_lt [Fintype Λ] {I : AdmCell G R N} {x : AdmVertex (G := G) (R := R) (N := N)
    (Λ := Λ)} (hx : x ∈ admPresent av I) : admPos av I x < (admPresent av I).card := by
  classical
  unfold admPos
  refine Finset.card_lt_card (Finset.filter_ssubset.mpr ⟨x, hx, lt_irrefl _⟩)

theorem admPos_injOn [Fintype Λ] (I : AdmCell G R N) :
    Set.InjOn (admPos av I) (admPresent av I : Set (AdmVertex (G := G) (R := R) (N := N)
      (Λ := Λ))) := by
  classical
  intro x hx y hy hxy
  by_contra hne
  have hkey : admKey x ≠ admKey y := by
    intro h
    apply hne
    have h1 := admKey_label h
    obtain ⟨-, hx2⟩ := (mem_admPresent av).mp hx
    obtain ⟨-, hy2⟩ := (mem_admPresent av).mp hy
    exact Prod.ext h1 (by rw [hx2, hy2, h1])
  have key : ∀ a b : AdmVertex (G := G) (R := R) (N := N) (Λ := Λ), a ∈ admPresent av I →
      admKey a < admKey b → admPos av I a < admPos av I b := by
    intro a b ha hab
    unfold admPos
    refine Finset.card_lt_card ⟨Finset.monotone_filter_right _ fun z _ hz => hz.trans hab, ?_⟩
    intro hsub
    have := hsub (Finset.mem_filter.mpr ⟨ha, hab⟩)
    exact lt_irrefl _ (Finset.mem_filter.mp this).2
  rcases lt_or_gt_of_ne hkey with h | h
  · exact absurd hxy (key x y hx h).ne
  · exact absurd hxy.symm (key y x hy h).ne

/-- Positions of the parent's vertices are unchanged at the child. -/
theorem admPos_parent [Fintype Λ] {I : AdmCell G R N} (hI : I.1 ≠ R)
    {x : AdmVertex (G := G) (R := R) (N := N) (Λ := Λ)}
    (hx : x ∈ admPresent av ⟨dyadicParent G I.1, admParent_mem I hI⟩) :
    admPos av I x = admPos av ⟨dyadicParent G I.1, admParent_mem I hI⟩ x := by
  classical
  set P : AdmCell G R N := ⟨dyadicParent G I.1, admParent_mem I hI⟩
  unfold admPos
  congr 1
  ext y
  simp only [Finset.mem_filter]
  constructor
  · rintro ⟨hy, hyx⟩
    refine ⟨?_, hyx⟩
    obtain ⟨hyne, hy2⟩ := (mem_admPresent av).mp hy
    obtain ⟨hxne, hx2⟩ := (mem_admPresent av).mp hx
    -- the admission depth of `y` is at most that of `x`, hence at most the parent's depth
    have hdy : y.2.1.1 ≤ x.2.1.1 := by
      unfold admKey at hyx
      by_contra hc
      push Not at hc
      have h1 : (x.2.1.1 - R.1).toNat + 1 ≤ (y.2.1.1 - R.1).toNat := by
        have := admCell_depth_ge x.2; have := admCell_depth_ge y.2; omega
      have h2 := (Fintype.equivFin Λ x.1).2
      have h3 : ((x.2.1.1 - R.1).toNat + 1) * Fintype.card Λ ≤
          (y.2.1.1 - R.1).toNat * Fintype.card Λ := Nat.mul_le_mul_right _ h1
      nlinarith
    have hxP : x.2.1.1 ≤ P.1.1 := by
      rw [hx2]
      obtain ⟨h1, -⟩ := admCellOf_spec av hxne
      exact dyadicGridCell_depth_le_of_subset G P.1 _ ((mem_admAnc av).mp h1).1
    obtain ⟨hy1, -⟩ := admCellOf_spec av hyne
    have hyI := ((mem_admAnc av).mp hy1).1
    -- `y`'s admission cell is an ancestor of the parent
    have hyP : dyadicGridCell G P.1.1 P.1.2 ⊆ dyadicGridCell G y.2.1.1 y.2.1.2 := by
      rw [hy2]
      have hne' : I.1 ≠ (admCellOf av I y.1).1 := by
        intro heq
        have h1 : (admCellOf av I y.1).1.1 = I.1.1 := by rw [← heq]
        have h2 : P.1.1 = I.1.1 - 1 := rfl
        rw [hy2] at hdy
        omega
      exact dyadicParent_subset_of_subset G hyI hne'
    have hmemP : y.2 ∈ admAnc av P y.1 := by
      rw [hy2]; exact (mem_admAnc av).mpr ⟨hy2 ▸ hyP, ((mem_admAnc av).mp hy1).2⟩
    refine (mem_admPresent av).mpr ⟨⟨_, hmemP⟩, ?_⟩
    obtain ⟨hne'', heq⟩ := admCellOf_parent av hI ⟨_, hmemP⟩
    rw [hy2, heq]
  · rintro ⟨hy, hyx⟩
    exact ⟨admPresent_parent av hI hy, hyx⟩

/-- The parent map of the admission tree (the top above the root is its own parent). -/
noncomputable def admPar : Option (AdmCell G R N) → Option (AdmCell G R N)
  | none => none
  | some I => if h : I.1 = R then none else some ⟨dyadicParent G I.1, admParent_mem I h⟩

/-- Blueprint lines 1677-1681: the admission tree of the finite tree below `R`: the present
vertices along a path increase, with admission positions ordered by admission depth and then by
label. -/
noncomputable def admTree [Fintype Λ] :
    AdmTree (AdmVertex (G := G) (R := R) (N := N) (Λ := Λ)) where
  Cell := Option (AdmCell G R N)
  par := admPar
  ht := fun c => match c with
    | none => 0
    | some I => (I.1.1 - R.1).toNat + 1
  ht_par := by
    intro c hc
    cases c with
    | none => exact absurd hc (lt_irrefl 0)
    | some I =>
      simp only [admPar]
      by_cases h : I.1 = R
      · simp only [h, ↓reduceDIte, sub_self, Int.toNat_zero, zero_add]
      · simp only [h, ↓reduceDIte, dyadicParent]
        have := admCell_depth_gt I h
        omega
  depth := fun c => match c with
    | none => R.1 - 1
    | some I => I.1.1
  X := fun c => match c with
    | none => ∅
    | some I => admPresent av I
  pos := fun c => match c with
    | none => fun _ => 0
    | some I => admPos av I
  X_top := by
    intro c hc
    cases c with
    | none => rfl
    | some I => exact absurd hc (Nat.succ_ne_zero _)
  le_par := by
    intro c
    cases c with
    | none => exact AdmState.Le.refl _
    | some I =>
      simp only [admPar]
      by_cases h : I.1 = R
      · simp only [h, ↓reduceDIte]
        refine ⟨?_, Finset.empty_subset _, fun v hv => absurd hv (Finset.notMem_empty v)⟩
        change R.1 - 1 ≤ R.1
        omega
      · simp only [h, ↓reduceDIte]
        refine ⟨?_, admPresent_parent av h, fun x hx => admPos_parent av h hx⟩
        change I.1.1 - 1 ≤ I.1.1
        omega
  wf := by
    intro c
    cases c with
    | none => exact ⟨fun v hv => absurd hv (Finset.notMem_empty v), fun _ h => absurd h
        (Finset.notMem_empty _)⟩
    | some I => exact ⟨fun x hx => admPos_lt av hx, admPos_injOn av I⟩

end AdmissionTree

namespace ActiveSetup
variable {κ : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ c₀)

/-- The vertex bound `D` of the attempt: at most `4|L|` vertices are present at any cell. -/
def vtxBound : ℕ := 4 * Fintype.card A.L + 1

/-! ### One attempt: color parameters and historical masks (blueprint lines 1712-1760) -/

/-- The primary depth `d₀ = ⌈1000 log 2D⌉` of the attempt. -/
noncomputable def cd0 : ℕ := colorDegree A.vtxBound

/-- The high scale `b₂ = 100 (H_max + 1)` (blueprint line 1716). -/
def cb2 (Hmax : ℕ) : ℕ := 100 * (Hmax + 1)

end ActiveSetup

end TrilinearHT.Auto

end


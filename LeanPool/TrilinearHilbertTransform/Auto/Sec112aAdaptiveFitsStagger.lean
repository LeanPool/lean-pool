/-! ### Energy gain of one fresh column -/

/-- Adding a vector `u` to a closed range `U` increases the projection energy of `z` by at least
`|⟨u, z - P_U z⟩|² / ‖u‖²` (blueprint §11.2, line 1577: "squared energy gain"). -/
theorem starProjection_sup_span_gain {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
     (U : Submodule ℂ E) [FiniteDimensional ℂ U] (u z : E) :
    ‖(U ⊔ Submodule.span ℂ {u}).starProjection z‖ ^ 2 ≥
      ‖U.starProjection z‖ ^ 2 + ‖inner ℂ u (z - U.starProjection z)‖ ^ 2 / ‖u‖ ^ 2 := by
  set! W := U ⊔ Submodule.span ℂ {u} with hW
  have hUW : U ≤ W := le_sup_left
  have huW : u ∈ W :=
    (le_sup_right : Submodule.span ℂ {u} ≤ W) (Submodule.mem_span_singleton_self u)
  set r := z - U.starProjection z with hr
  have hPU : W.starProjection (U.starProjection z) = U.starProjection z :=
    Submodule.starProjection_eq_self_iff.mpr (hUW (Submodule.starProjection_apply_mem U z))
  have hdecomp : W.starProjection z = U.starProjection z + W.starProjection r := by
    rw [hr, map_sub, hPU]; abel
  have h0 : inner ℂ (U.starProjection z) r = 0 := by
    have h0' := Submodule.starProjection_inner_eq_zero z (U.starProjection z)
      (Submodule.starProjection_apply_mem U z)
    exact inner_eq_zero_symm.mp h0'
  have horth : inner ℂ (U.starProjection z) (W.starProjection r) = 0 := by
    rw [← Submodule.inner_starProjection_left_eq_right, hPU, h0]
  have hnorm : ‖W.starProjection z‖ ^ 2 = ‖U.starProjection z‖ ^ 2 + ‖W.starProjection r‖ ^ 2 := by
    have h := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ horth
    rw [hdecomp, sq, sq, sq, h]
  have hinner : inner ℂ u r = inner ℂ u (W.starProjection r) := by
    rw [← Submodule.inner_starProjection_left_eq_right, Submodule.starProjection_eq_self_iff.mpr
        huW]
  rw [hnorm, ge_iff_le]
  refine add_le_add le_rfl ?_
  rcases eq_or_ne u 0 with hu | hu
  · simp [hu]
  have hu0 : 0 < ‖u‖ := norm_pos_iff.mpr hu
  rw [div_le_iff₀ (by positivity), hinner]
  have hcs := norm_inner_le_norm (𝕜 := ℂ) u (W.starProjection r)
  calc ‖inner ℂ u (W.starProjection r)‖ ^ 2 ≤ (‖u‖ * ‖W.starProjection r‖) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) hcs 2
    _ = ‖W.starProjection r‖ ^ 2 * ‖u‖ ^ 2 := by ring

/-! ### Fit columns with private weight one -/

/-- The value `(φ(y), e_v)` of a fit column. -/
noncomputable def fitColumnValue {V : Type*} [DecidableEq V] (φ : ℝ → ℂ) (v : V)
    (y : ℝ) : ColumnHilbert V :=
  φ y • EuclideanSpace.single none (1 : ℂ) + EuclideanSpace.single (some v) (1 : ℂ)

theorem fitColumnValue_none {V : Type*} [DecidableEq V] (φ : ℝ → ℂ) (v : V)
    (y : ℝ) : fitColumnValue φ v y none = φ y := by
  simp [fitColumnValue]

theorem fitColumnValue_some {V : Type*} [DecidableEq V] (φ : ℝ → ℂ) (v w : V)
    (y : ℝ) : fitColumnValue φ v y (some w) = if w = v then 1 else 0 := by
  by_cases h : w = v <;> simp [fitColumnValue, h]

theorem norm_fitColumnValue_le {V : Type*} [Fintype V] [DecidableEq V] {φ : ℝ → ℂ}
    (hφ : ∀ y, ‖φ y‖ ≤ 1) (v : V) (y : ℝ) : ‖fitColumnValue φ v y‖ ≤ 2 := by
  unfold fitColumnValue
  have h1 : ‖φ y • EuclideanSpace.single (none : Option V) (1 : ℂ)‖ ≤ 1 := by
    simpa [norm_smul] using hφ y
  have h2 : ‖EuclideanSpace.single (some v) (1 : ℂ)‖ = 1 := by simp
  linarith only [norm_add_le (φ y • EuclideanSpace.single (none : Option V) (1 : ℂ))
    (EuclideanSpace.single (some v) (1 : ℂ)), h1, h2]

theorem measurable_fitColumnValue {V : Type*} [Finite V] [DecidableEq V] {φ : ℝ → ℂ}
    (hφ : Measurable φ) (v : V) : Measurable (fitColumnValue φ v) := by
  let : Fintype V := Fintype.ofFinite V
  exact (hφ.smul measurable_const).add measurable_const

/-- The predicate on fit data: a measurable set of finite measure and a bounded measurable atom. -/
def FitAdmissible (s : Set ℝ) (φ : ℝ → ℂ) : Prop :=
  MeasurableSet s ∧ volume s < ⊤ ∧ Measurable φ ∧ ∀ y, ‖φ y‖ ≤ 1

theorem fitColumn_memLp {V : Type*} [Fintype V] [DecidableEq V] {s : Set ℝ} {φ : ℝ → ℂ}
    (h : FitAdmissible s φ) (v : V) :
    MemLp (s.indicator (fitColumnValue φ v)) 2 volume := by
  obtain ⟨hs, hsv, hφm, hφ⟩ := h
  refine (memLp_indicator_iff_restrict hs).mpr ?_
  have : IsFiniteMeasure (volume.restrict s) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact hsv⟩
  exact MemLp.of_bound (measurable_fitColumnValue hφm v).aestronglyMeasurable 2
    (Filter.Eventually.of_forall (norm_fitColumnValue_le hφ v))

open scoped Classical in
/-- The fit column `1_s (φ, e_v)` in `L²(ℝ; ℂ ⊕ ℓ²(V))`. -/
noncomputable def fitColumn {V : Type*} [Fintype V] [DecidableEq V] (s : Set ℝ) (φ : ℝ → ℂ)
    (v : V) : ColumnL2 V :=
  if h : FitAdmissible s φ then (fitColumn_memLp h v).toLp _ else 0

theorem fitColumn_coeFn {V : Type*} [Fintype V] [DecidableEq V] {s : Set ℝ} {φ : ℝ → ℂ}
    (h : FitAdmissible s φ) (v : V) :
    (fitColumn s φ v : ℝ → ColumnHilbert V) =ᵐ[volume] s.indicator (fitColumnValue φ v) := by
  unfold fitColumn
  simp only [h, ↓reduceDIte]
  exact MemLp.coeFn_toLp _

/-- The range of the first `n` fit columns `1_s (a_i, e_i)`, `i < n`, over labels `Fin M`. -/
noncomputable def fitRange {M : ℕ} (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ) :
    Submodule ℂ (ColumnL2 (Fin M)) :=
  Submodule.span ℂ {x | ∃ i : Fin M, (i : ℕ) < n ∧ fitColumn s (a i) i = x}

instance fitRange_finiteDimensional {M : ℕ} (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ) :
    FiniteDimensional ℂ (fitRange (M := M) s a n) := by
  unfold fitRange
  refine FiniteDimensional.span_of_finite ℂ ?_
  refine (Set.finite_range (fun i : Fin M => fitColumn s (a i) i)).subset ?_
  rintro x ⟨i, -, rfl⟩
  exact ⟨i, rfl⟩

theorem fitRange_succ {M : ℕ} (s : Set ℝ) (a : ℕ → ℝ → ℂ) {n : ℕ} (hn : n < M) :
    fitRange (M := M) s a (n + 1) =
      fitRange s a n ⊔ Submodule.span ℂ {fitColumn s (a n) (⟨n, hn⟩ : Fin M)} := by
  unfold fitRange
  rw [← Submodule.span_union]
  congr 1
  ext x
  simp only [Set.mem_ofPred_eq, Set.mem_union, Set.mem_singleton_iff]
  constructor
  · rintro ⟨i, hi, rfl⟩
    rcases Nat.lt_succ_iff_lt_or_eq.mp hi with h | h
    · exact Or.inl ⟨i, h, rfl⟩
    · right
      have : i = ⟨n, hn⟩ := Fin.ext h
      subst this; rfl
  · rintro (⟨i, hi, rfl⟩ | rfl)
    · exact ⟨i, by omega, rfl⟩
    · exact ⟨⟨n, hn⟩, by simp, rfl⟩

/-- Fresh coordinates vanish on the range of the earlier columns. -/
theorem fitRange_fresh_zero {M : ℕ} {s : Set ℝ} {a : ℕ → ℝ → ℂ} {n : ℕ} {m : Fin M}
    (hm : n ≤ (m : ℕ)) {x : ColumnL2 (Fin M)} (hx : x ∈ fitRange s a n) :
    ∀ᵐ y ∂volume, (x : ℝ → ColumnHilbert (Fin M)) y (some m) = 0 := by
  refine Submodule.span_induction (R := ℂ) (M := ColumnL2 (Fin M)) (p := fun x _ =>
    ∀ᵐ y ∂volume, (x : ℝ → ColumnHilbert (Fin M)) y (some m) = 0) ?_ ?_ ?_ ?_ hx
  · rintro x ⟨i, hi, rfl⟩
    by_cases h : FitAdmissible s (a i)
    · filter_upwards [fitColumn_coeFn h i] with y hy
      rw [hy]
      by_cases hys : y ∈ s
      · have hne : m ≠ i := by intro he; rw [he] at hm; omega
        rw [Set.indicator_of_mem hys, fitColumnValue_some]
        simp only [hne, ↓reduceIte]
      · rw [Set.indicator_of_notMem hys]; rfl
    · unfold fitColumn
      simp only [h, ↓reduceDIte]
      filter_upwards [Lp.coeFn_zero (ColumnHilbert (Fin M)) 2 volume] with y hy
      rw [hy]; rfl
  · filter_upwards [Lp.coeFn_zero (ColumnHilbert (Fin M)) 2 volume] with y hy
    rw [hy]; rfl
  · intro x y _ _ hx hy
    filter_upwards [hx, hy, Lp.coeFn_add x y] with z hx hy hz
    rw [hz, Pi.add_apply, PiLp.add_apply, hx, hy, add_zero]
  · intro c x _ hx
    filter_upwards [hx, Lp.coeFn_smul c x] with z hx hz
    rw [hz, Pi.smul_apply, PiLp.smul_apply, hx, smul_zero]

/-- The inner product of a fit column with a residual whose fresh coordinate vanishes. -/
theorem inner_fitColumn {M : ℕ} {s : Set ℝ} {φ : ℝ → ℂ} (h : FitAdmissible s φ) (m : Fin M)
    (r : ColumnL2 (Fin M)) (hr : ∀ᵐ y ∂volume, (r : ℝ → ColumnHilbert (Fin M)) y (some m) = 0) :
    inner ℂ (fitColumn s φ m) r = ∫ y in s, conj (φ y) * (r : ℝ → ColumnHilbert (Fin M)) y none :=
        by
  rw [MeasureTheory.L2.inner_def, ← integral_indicator h.1]
  refine integral_congr_ae ?_
  filter_upwards [fitColumn_coeFn h m, hr] with y hy hry
  rw [hy]
  by_cases hys : y ∈ s
  · rw [Set.indicator_of_mem hys, Set.indicator_of_mem hys]
    unfold fitColumnValue
    rw [inner_add_left, inner_smul_left, EuclideanSpace.inner_single_left,
      EuclideanSpace.inner_single_left, hry]
    simp
  · rw [Set.indicator_of_notMem hys, Set.indicator_of_notMem hys]
    simp

theorem norm_fitColumn_sq_le {M : ℕ} {s : Set ℝ} {φ : ℝ → ℂ} (h : FitAdmissible s φ)
    (m : Fin M) : ‖fitColumn s φ m‖ ^ 2 ≤ 4 * volume.real s := by
  rw [columnInput_norm_sq_integral]
  have hs := h.1
  calc ∫ y, ‖(fitColumn s φ m : ℝ → ColumnHilbert (Fin M)) y‖ ^ 2
      = ∫ y, s.indicator (fun y => ‖fitColumnValue φ m y‖ ^ 2) y := by
        refine integral_congr_ae ?_
        filter_upwards [fitColumn_coeFn h m] with y hy
        rw [hy]
        by_cases hys : y ∈ s
        · rw [Set.indicator_of_mem hys, Set.indicator_of_mem hys]
        · rw [Set.indicator_of_notMem hys, Set.indicator_of_notMem hys]; simp
    _ = ∫ y in s, ‖fitColumnValue φ m y‖ ^ 2 := integral_indicator hs
    _ ≤ ∫ y in s, (4 : ℝ) := by
        refine setIntegral_mono_on ?_ (integrableOn_const h.2.1.ne) hs fun y _ => ?_
        · have : IsFiniteMeasure (volume.restrict s) :=
            ⟨by rw [Measure.restrict_apply_univ]; exact h.2.1⟩
          exact (MemLp.of_bound (measurable_fitColumnValue h.2.2.1 m).aestronglyMeasurable 2
            (Filter.Eventually.of_forall (norm_fitColumnValue_le h.2.2.2 m))).integrable_norm_pow
            two_ne_zero
        · have := norm_fitColumnValue_le h.2.2.2 m y
          nlinarith [norm_nonneg (fitColumnValue φ m y)]
    _ = 4 * volume.real s := by rw [setIntegral_const, smul_eq_mul, mul_comm]

/-! ### Residual smallness and detection -/

/-- `d_{j,I}(R) ≤ η` (blueprint §11.2, line 1568): every local form at the cell `[a₀, a₀ + r)`
with `R` in slot `j`, one normalized `L^q` input and two normalized `L²` inputs in the other
slots (any choice of the `L^q` position) is at most `η`. -/
def FormSmall (a₀ r : ℝ) (w : ℝ × ℝ → ℂ) (j : Fin 4) (q : ℝ) (R : ℝ → ℂ) (η : ℝ) : Prop :=
  ∀ (g : Fin 4 → ℝ → ℂ), (∀ i, Measurable (g i)) → g j = R →
    ∀ {ih ku lv : Fin 4}, j ≠ ih → j ≠ ku → j ≠ lv → ih ≠ ku → ih ≠ lv → ku ≠ lv →
    eLpNorm (g ih) (ENNReal.ofReal q) (normalizedIntervalMeasure a₀ r) ≤ 1 →
    eLpNorm (g ku) 2 (normalizedIntervalMeasure a₀ r) ≤ 1 →
    eLpNorm (g lv) 2 (normalizedIntervalMeasure a₀ r) ≤ 1 →
    ‖localProgressionForm r w g‖ ≤ η

/-- The detection budget at accuracy `e^{-k}` for residuals of normalized size at most two. -/
noncomputable def fitBudget (Cq : ℝ) (C : ℕ) (k : ℕ) : ℝ :=
  Real.exp (Cq * (1 + Real.log 2 + k) ^ C)

theorem one_le_fitBudget {Cq : ℝ} (hCq : 0 < Cq) (C k : ℕ) : 1 ≤ fitBudget Cq C k := by
  unfold fitBudget
  have : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
  exact Real.one_le_exp (by positivity)

/-- Blueprint §11.2, line 1577 (detection step of the adaptive fit): a residual failing
`d_{j,I} ≤ e^{-k}` correlates with a bounded atom of complexity at most `fitBudget` by at least
`fitBudget⁻¹` (Lemma `lem:detection` with `C₁ = 2`, `δ = e^{-k}`). -/
theorem fit_detect (κ : LocalKernelClass) :
    ∃ (c₂ C : ℕ), 1 ≤ c₂ ∧ 1 ≤ C ∧ ∀ q : ℝ, 2 < q → ∃ Cq : ℝ, 0 < Cq ∧
    ∀ {a₀ r : ℝ}, 0 < r → ∀ {w : ℝ × ℝ → ℂ}, IsAdmissibleLocalKernel κ a₀ r w →
    ∀ {j : Fin 4} {R : ℝ → ℂ}, Measurable R →
    eLpNorm R 2 (normalizedIntervalMeasure a₀ r) ≤ ENNReal.ofReal 2 →
    ∀ {k : ℕ}, 1 ≤ k → ¬ FormSmall a₀ r w j q R (Real.exp (-(k : ℝ))) →
    ∃ (d : ℕ) (Φ : QuadraticChartData d),
      QuadraticChartComplexity c₂ (fitBudget Cq C k) Φ ∧ IsBoundedQuadraticChart Φ ∧
      (fitBudget Cq C k)⁻¹ ≤ r⁻¹ * ‖∫ x in a₀..a₀ + r, R x * conj (quadraticChartAtom Φ x)‖ := by
  obtain ⟨c₂, C, hc₂, hC, hdet⟩ := detectResidual κ
  refine ⟨c₂, C, hc₂, hC, fun q hq => ?_⟩
  obtain ⟨Cq, hCq, hd⟩ := hdet q hq
  refine ⟨Cq, hCq, fun {a₀ r} hr {w} hw {j R} hRm hR2 {k} hk hfail => ?_⟩
  unfold FormSmall at hfail
  push Not at hfail
  obtain ⟨g, hgm, hgj, ih, ku, lv, h1, h2, h3, h4, h5, h6, hq1, hq2, hq3, hlt⟩ := hfail
  have hδ : Real.exp (-(k : ℝ)) < 1 / 2 := by
    have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast hk
    calc Real.exp (-(k : ℝ)) ≤ Real.exp (-1) := Real.exp_le_exp.mpr (by linarith only [hk1])
      _ < 1 / 2 := by
          rw [Real.exp_neg, inv_lt_comm₀ (Real.exp_pos 1) (by norm_num)]
          have := Real.add_one_lt_exp (show (1 : ℝ) ≠ 0 by norm_num); linarith
  have hlog : Real.log (1 / Real.exp (-(k : ℝ))) = k := by
    rw [one_div, ← Real.exp_neg, neg_neg, Real.log_exp]
  have h := hd (C₁ := 2) (δ := Real.exp (-(k : ℝ))) hr hw g hgm h1 h2 h3 h4 h5 h6 (by norm_num)
    (Real.exp_pos _) hδ
    (by rw [hgj]; exact hR2) hq1 hq2 hq3 hlt
  rw [hlog, hgj] at h
  exact h

/-! ### The greedy insertion at one cell -/

open scoped Classical in
/-- One insertion step: while the residual is not small and the cap `M` is not reached, insert
the oracle's atom as the next label (blueprint §11.2, line 1577). -/
noncomputable def fitStep (M : ℕ) (P : (ℕ → ℝ → ℂ) → ℕ → Prop)
    (O : (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) (st : (ℕ → ℝ → ℂ) × ℕ) : (ℕ → ℝ → ℂ) × ℕ :=
  if st.2 < M ∧ ¬ P st.1 st.2 then (Function.update st.1 st.2 (O st.1 st.2), st.2 + 1) else st

/-- The greedy fit at one cell: `M` insertion steps. -/
noncomputable def fitGreedy (M : ℕ) (P : (ℕ → ℝ → ℂ) → ℕ → Prop)
    (O : (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) (st : (ℕ → ℝ → ℂ) × ℕ) : (ℕ → ℝ → ℂ) × ℕ :=
  (fitStep M P O)^[M] st

theorem fitStep_count {M : ℕ} {P : (ℕ → ℝ → ℂ) → ℕ → Prop} {O : (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ}
    (st : (ℕ → ℝ → ℂ) × ℕ) :
    (fitStep M P O st = st) ∨
      (st.2 < M ∧ ¬ P st.1 st.2 ∧
        fitStep M P O st = (Function.update st.1 st.2 (O st.1 st.2), st.2 + 1)) := by
  unfold fitStep
  split_ifs with h
  · exact Or.inr ⟨h.1, h.2, rfl⟩
  · exact Or.inl rfl

/-- Either the iterate is a fixed point or every step inserted. -/
theorem fitStep_iterate_dichotomy {M : ℕ} {P : (ℕ → ℝ → ℂ) → ℕ → Prop}
    {O : (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ} (st : (ℕ → ℝ → ℂ) × ℕ) (t : ℕ) :
    fitStep M P O ((fitStep M P O)^[t] st) = (fitStep M P O)^[t] st ∨
      ((fitStep M P O)^[t] st).2 = st.2 + t := by
  induction t with
  | zero =>
    rcases fitStep_count (M := M) (P := P) (O := O) st with h | h
    · exact Or.inl h
    · exact Or.inr rfl
  | succ t ih =>
    rw [Function.iterate_succ_apply']
    rcases ih with h | h
    · left; rw [h, h]
    · rcases fitStep_count (M := M) (P := P) (O := O) ((fitStep M P O)^[t] st) with h' | h'
      · left; rw [h', h']
      · right; rw [h'.2.2]; simp only; omega

theorem fitStep_count_le {M : ℕ} {P : (ℕ → ℝ → ℂ) → ℕ → Prop} {O : (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ}
    (st : (ℕ → ℝ → ℂ) × ℕ) (hst : st.2 ≤ M) (t : ℕ) :
    st.2 ≤ ((fitStep M P O)^[t] st).2 ∧ ((fitStep M P O)^[t] st).2 ≤ M := by
  induction t with
  | zero => exact ⟨le_rfl, hst⟩
  | succ t ih =>
    rw [Function.iterate_succ_apply']
    rcases fitStep_count (M := M) (P := P) (O := O) ((fitStep M P O)^[t] st) with h | h
    · rw [h]; exact ih
    · rw [h.2.2]; simp only; constructor <;> omega

/-- The greedy fit ends with a small residual or at the cap. -/
theorem fitGreedy_final {M : ℕ} {P : (ℕ → ℝ → ℂ) → ℕ → Prop} {O : (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ}
    (st : (ℕ → ℝ → ℂ) × ℕ) (hst : st.2 ≤ M) :
    P (fitGreedy M P O st).1 (fitGreedy M P O st).2 ∨ (fitGreedy M P O st).2 = M := by
  have hle := (fitStep_count_le (P := P) (O := O) st hst M).2
  rcases fitStep_iterate_dichotomy (M := M) (P := P) (O := O) st M with h | h
  · unfold fitGreedy
    set s := (fitStep M P O)^[M] st with hs
    by_contra hc
    push Not at hc
    have hlt : s.2 < M := lt_of_le_of_ne hle hc.2
    have hstep : fitStep M P O s = (Function.update s.1 s.2 (O s.1 s.2), s.2 + 1) := by
      unfold fitStep
      simp only [hlt, hc.1, not_false_eq_true, and_self, ↓reduceIte]
    rw [hstep] at h
    have h2 := congrArg Prod.snd h
    simp at h2
  · right; unfold fitGreedy; omega

/-- The greedy fit only appends: earlier atoms are unchanged. -/
theorem fitGreedy_prefix {M : ℕ} {P : (ℕ → ℝ → ℂ) → ℕ → Prop} {O : (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ}
    (st : (ℕ → ℝ → ℂ) × ℕ) (hst : st.2 ≤ M) {i : ℕ} (hi : i < st.2) :
    (fitGreedy M P O st).1 i = st.1 i := by
  unfold fitGreedy
  suffices h : ∀ t, ((fitStep M P O)^[t] st).1 i = st.1 i from h M
  intro t
  induction t with
  | zero => rfl
  | succ t ih =>
    rw [Function.iterate_succ_apply']
    have hge := (fitStep_count_le (P := P) (O := O) st hst t).1
    rcases fitStep_count (M := M) (P := P) (O := O) ((fitStep M P O)^[t] st) with h | h
    · rw [h, ih]
    · rw [h.2.2]
      simp only
      rw [Function.update_of_ne (by omega), ih]

theorem fitGreedy_count {M : ℕ} {P : (ℕ → ℝ → ℂ) → ℕ → Prop} {O : (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ}
    (st : (ℕ → ℝ → ℂ) × ℕ) (hst : st.2 ≤ M) :
    st.2 ≤ (fitGreedy M P O st).2 ∧ (fitGreedy M P O st).2 ≤ M :=
  fitStep_count_le st hst M

/-- Energy accumulates at least `g` per insertion along the greedy fit. -/
theorem fitGreedy_energy {M : ℕ} {P : (ℕ → ℝ → ℂ) → ℕ → Prop} {O : (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ}
    (E : (ℕ → ℝ → ℂ) → ℕ → ℝ) {g : ℝ}
    (hE : ∀ a n, n < M → ¬ P a n → E a n + g ≤ E (Function.update a n (O a n)) (n + 1))
    (st : (ℕ → ℝ → ℂ) × ℕ) :
    E st.1 st.2 + g * ((fitGreedy M P O st).2 - st.2 : ℝ) ≤
      E (fitGreedy M P O st).1 (fitGreedy M P O st).2 := by
  unfold fitGreedy
  suffices h : ∀ t, E st.1 st.2 + g * (((fitStep M P O)^[t] st).2 - st.2 : ℝ) ≤
      E ((fitStep M P O)^[t] st).1 ((fitStep M P O)^[t] st).2 from h M
  intro t
  induction t with
  | zero => simp
  | succ t ih =>
    rw [Function.iterate_succ_apply']
    rcases fitStep_count (M := M) (P := P) (O := O) ((fitStep M P O)^[t] st) with h | h
    · rw [h]; exact ih
    · rw [h.2.2]
      have := hE _ _ h.1 h.2.1
      simp only at this ⊢
      push_cast
      linarith

/-- The fit projection at a cell with the first `n` atoms. -/
noncomputable def fitProj (M : ℕ) (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ) :
    ColumnL2 (Fin M) →L[ℂ] ColumnL2 (Fin M) :=
  (fitRange (M := M) s a n).starProjection

/-- The fit residual `f - (P F)_phys`. -/
noncomputable def fitResid (M : ℕ) (s : Set ℝ) (f : Lp ℂ 2 (volume : Measure ℝ))
    (a : ℕ → ℝ → ℂ) (n : ℕ) (y : ℝ) : ℂ :=
  (f : ℝ → ℂ) y - (fitProj M s a n (physicalColumnInput f) : ℝ → ColumnHilbert (Fin M)) y none

theorem fitRange_update {M : ℕ} (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ) (φ : ℝ → ℂ) {n' : ℕ}
    (hn' : n' ≤ n) : fitRange (M := M) s (Function.update a n φ) n' = fitRange s a n' := by
  unfold fitRange
  congr 1
  ext x
  constructor
  · rintro ⟨i, hi, rfl⟩
    exact ⟨i, hi, by rw [Function.update_of_ne (by omega)]⟩
  · rintro ⟨i, hi, rfl⟩
    exact ⟨i, hi, by rw [Function.update_of_ne (by omega)]⟩

theorem starProjection_congr {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    {K L : Submodule ℂ E} [K.HasOrthogonalProjection] [L.HasOrthogonalProjection] (h : K = L)
    (z : E) : K.starProjection z = L.starProjection z := by
  subst h; congr

/-- Blueprint §11.2, line 1577: inserting an atom whose correlation with the residual is at least
`ρ |I|` increases the fit energy by at least `ρ² |I| / 4`. -/
theorem fitEnergy_gain {M : ℕ} {s : Set ℝ} (f : Lp ℂ 2 (volume : Measure ℝ))
    (a : ℕ → ℝ → ℂ) {n : ℕ} (hn : n < M) {φ : ℝ → ℂ} (hφ : FitAdmissible s φ) {ρ : ℝ}
    (hρ : 0 ≤ ρ)
    (hcorr : ρ * volume.real s ≤ ‖∫ y in s, conj (φ y) * fitResid M s f a n y‖) :
    ‖fitProj M s a n (physicalColumnInput f)‖ ^ 2 + ρ ^ 2 * volume.real s / 4 ≤
      ‖fitProj M s (Function.update a n φ) (n + 1) (physicalColumnInput f)‖ ^ 2 := by
  set z := physicalColumnInput (V := Fin M) f with hz
  set! U := fitRange (M := M) s a n with hU
  have hsucc : fitRange (M := M) s (Function.update a n φ) (n + 1) =
      U ⊔ Submodule.span ℂ {fitColumn s φ (⟨n, hn⟩ : Fin M)} := by
    rw [fitRange_succ _ _ hn, fitRange_update _ _ _ _ le_rfl, Function.update_self]
  have hgain := starProjection_sup_span_gain U (fitColumn s φ (⟨n, hn⟩ : Fin M)) z
  unfold fitProj
  rw [starProjection_congr hsucc]
  -- the inner product with the residual
  have hfresh : ∀ᵐ y ∂volume,
      ((z - U.starProjection z : ColumnL2 (Fin M)) : ℝ → ColumnHilbert (Fin M)) y
        (some (⟨n, hn⟩ : Fin M)) = 0 := by
    filter_upwards [Lp.coeFn_sub z (U.starProjection z),
      fitRange_fresh_zero (s := s) (a := a) (m := (⟨n, hn⟩ : Fin M)) le_rfl
        (Submodule.starProjection_apply_mem U z),
      physicalColumnInput_coeFn (V := Fin M) f] with y h1 h2 h3
    rw [h1, Pi.sub_apply, PiLp.sub_apply, h2, h3]
    simp
  have hin := inner_fitColumn hφ (⟨n, hn⟩ : Fin M) (z - U.starProjection z) hfresh
  have hres : ∫ y in s, conj (φ y) * ((z - U.starProjection z : ColumnL2 (Fin M)) :
      ℝ → ColumnHilbert (Fin M)) y none = ∫ y in s, conj (φ y) * fitResid M s f a n y := by
    refine integral_congr_ae (ae_restrict_of_ae ?_)
    filter_upwards [Lp.coeFn_sub z (U.starProjection z),
      physicalColumnInput_coeFn (V := Fin M) f] with y h1 h3
    rw [h1, Pi.sub_apply, PiLp.sub_apply, h3]
    simp [fitResid, fitProj, hz, hU]
  rw [hres] at hin
  have hnorm := norm_fitColumn_sq_le hφ (⟨n, hn⟩ : Fin M)
  have hvol : 0 ≤ volume.real s := measureReal_nonneg
  have hg0 : 0 ≤ ‖inner ℂ (fitColumn s φ (⟨n, hn⟩ : Fin M)) (z - U.starProjection z)‖ ^ 2 /
      ‖fitColumn s φ (⟨n, hn⟩ : Fin M)‖ ^ 2 := by positivity
  by_cases hρ0 : ρ * volume.real s = 0
  · have h0 : ρ ^ 2 * volume.real s / 4 = 0 := by
      rw [show ρ ^ 2 * volume.real s / 4 = ρ * (ρ * volume.real s) / 4 by ring, hρ0]; simp
    rw [h0, add_zero]
    linarith [ge_iff_le.mp hgain]
  have hcp : 0 < ‖∫ y in s, conj (φ y) * fitResid M s f a n y‖ :=
    lt_of_lt_of_le (lt_of_le_of_ne (by positivity) (Ne.symm hρ0)) hcorr
  have hcol : fitColumn s φ (⟨n, hn⟩ : Fin M) ≠ 0 := by
    intro h0
    rw [h0, inner_zero_left] at hin
    rw [← hin, norm_zero] at hcp
    exact lt_irrefl _ hcp
  have hpos : 0 < ‖fitColumn s φ (⟨n, hn⟩ : Fin M)‖ := norm_pos_iff.mpr hcol
  refine le_trans ?_ (ge_iff_le.mp hgain)
  refine add_le_add le_rfl ?_
  rw [hin, le_div_iff₀ (by positivity)]
  have hc2 : (ρ * volume.real s) ^ 2 ≤ ‖∫ y in s, conj (φ y) * fitResid M s f a n y‖ ^ 2 :=
    pow_le_pow_left₀ (by positivity) hcorr 2
  have hmul := mul_le_mul_of_nonneg_left hnorm
    (by positivity : (0 : ℝ) ≤ ρ ^ 2 * volume.real s / 4)
  nlinarith only [hc2, hmul]

/-- A range inside the orthogonal sum of two ranges has at most their total projection energy. -/
theorem starProjection_energy_le_of_le_sup {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] {K U₁ U₂ : Submodule ℂ E}
    [FiniteDimensional ℂ K] [FiniteDimensional ℂ U₁] [FiniteDimensional ℂ U₂]
    (hK : K ≤ U₁ ⊔ U₂) (h12 : U₁ ⟂ U₂) (z : E) :
    ‖K.starProjection z‖ ^ 2 ≤ ‖U₁.starProjection z‖ ^ 2 + ‖U₂.starProjection z‖ ^ 2 := by
  set W := U₁ ⊔ U₂
  have hW : W.starProjection z = U₁.starProjection z + U₂.starProjection z := by
    refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero (u := z)
      (Submodule.add_mem_sup (Submodule.starProjection_apply_mem U₁ z)
        (Submodule.starProjection_apply_mem U₂ z)) fun w hw => ?_
    obtain ⟨w₁, hw₁, w₂, hw₂, rfl⟩ := Submodule.mem_sup.mp hw
    have o1 : inner ℂ (z - U₁.starProjection z) w₁ = 0 :=
      Submodule.starProjection_inner_eq_zero z w₁ hw₁
    have o2 : inner ℂ (z - U₂.starProjection z) w₂ = 0 :=
      Submodule.starProjection_inner_eq_zero z w₂ hw₂
    have o3 : inner ℂ (U₂.starProjection z) w₁ = 0 :=
      h12.symm.inner_eq (Submodule.starProjection_apply_mem U₂ z) hw₁
    have o4 : inner ℂ (U₁.starProjection z) w₂ = 0 :=
      h12.inner_eq (Submodule.starProjection_apply_mem U₁ z) hw₂
    have e : z - (U₁.starProjection z + U₂.starProjection z) =
        (z - U₁.starProjection z) - U₂.starProjection z := by abel
    have e' : z - (U₁.starProjection z + U₂.starProjection z) =
        (z - U₂.starProjection z) - U₁.starProjection z := by abel
    have i1 : inner ℂ (z - (U₁.starProjection z + U₂.starProjection z)) w₁ = 0 := by
      rw [e, inner_sub_left, o1, o3, sub_zero]
    have i2 : inner ℂ (z - (U₁.starProjection z + U₂.starProjection z)) w₂ = 0 := by
      rw [e', inner_sub_left, o2, o4, sub_zero]
    rw [inner_add_right, i1, i2, add_zero]
  have horth : inner ℂ (U₁.starProjection z) (U₂.starProjection z) = 0 :=
    h12.inner_eq (Submodule.starProjection_apply_mem U₁ z) (Submodule.starProjection_apply_mem U₂ z)
  have hn : ‖W.starProjection z‖ ^ 2 = ‖U₁.starProjection z‖ ^ 2 + ‖U₂.starProjection z‖ ^ 2 := by
    rw [hW, sq, sq, sq, norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ horth]
  have hcomp : K.starProjection z = K.starProjection (W.starProjection z) := by
    have := congrArg (fun T => T z) (Submodule.starProjection_comp_starProjection_of_le hK)
    exact this.symm
  rw [← hn, hcomp]
  have h1 := ContinuousLinearMap.le_opNorm K.starProjection (W.starProjection z)
  have h2 := Submodule.starProjection_norm_le K
  have h3 : ‖K.starProjection (W.starProjection z)‖ ≤ ‖W.starProjection z‖ :=
    h1.trans (by simpa using mul_le_mul_of_nonneg_right h2 (norm_nonneg (W.starProjection z)))
  exact pow_le_pow_left₀ (norm_nonneg _) h3 2

/-- The fit column on a disjoint union is the sum of the fit columns on the parts. -/
theorem fitColumn_union {M : ℕ} {s₁ s₂ : Set ℝ} (hs₁ : MeasurableSet s₁) (hs₁v : volume s₁ < ⊤)
    (hs₂ : MeasurableSet s₂) (hs₂v : volume s₂ < ⊤) (hd : Disjoint s₁ s₂) (φ : ℝ → ℂ)
    (m : Fin M) :
    fitColumn (s₁ ∪ s₂) φ m = fitColumn s₁ φ m + fitColumn s₂ φ m := by
  have hsv : volume (s₁ ∪ s₂) < ⊤ := (measure_union_le s₁ s₂).trans_lt
    (ENNReal.add_lt_top.mpr ⟨hs₁v, hs₂v⟩)
  by_cases h : FitAdmissible (s₁ ∪ s₂) φ
  · have h₁ : FitAdmissible s₁ φ := ⟨hs₁, hs₁v, h.2.2⟩
    have h₂ : FitAdmissible s₂ φ := ⟨hs₂, hs₂v, h.2.2⟩
    refine Lp.ext ?_
    filter_upwards [fitColumn_coeFn h m, fitColumn_coeFn h₁ m, fitColumn_coeFn h₂ m,
      Lp.coeFn_add (fitColumn s₁ φ m) (fitColumn s₂ φ m)] with y hy h1 h2 h3
    rw [hy, h3, Pi.add_apply, h1, h2, Set.indicator_union_of_disjoint hd]
  · have h₁ : ¬ FitAdmissible s₁ φ := fun h' => h ⟨hs₁.union hs₂, hsv, h'.2.2⟩
    have h₂ : ¬ FitAdmissible s₂ φ := fun h' => h ⟨hs₁.union hs₂, hsv, h'.2.2⟩
    unfold fitColumn
    simp only [h, h₁, h₂, ↓reduceDIte, add_zero]

theorem fitRange_le_sup_union {M : ℕ} {s₁ s₂ : Set ℝ} (hs₁ : MeasurableSet s₁)
    (hs₁v : volume s₁ < ⊤) (hs₂ : MeasurableSet s₂) (hs₂v : volume s₂ < ⊤)
    (hd : Disjoint s₁ s₂) (a : ℕ → ℝ → ℂ) (n : ℕ) :
    fitRange (M := M) (s₁ ∪ s₂) a n ≤ fitRange s₁ a n ⊔ fitRange s₂ a n := by
  unfold fitRange
  refine Submodule.span_le.mpr ?_
  rintro x ⟨i, hi, rfl⟩
  rw [fitColumn_union hs₁ hs₁v hs₂ hs₂v hd]
  exact Submodule.add_mem_sup (Submodule.subset_span ⟨i, hi, rfl⟩)
    (Submodule.subset_span ⟨i, hi, rfl⟩)

/-- Fit ranges on disjoint sets are orthogonal. -/
theorem fitRange_isOrtho {M : ℕ} {s₁ s₂ : Set ℝ} (hd : Disjoint s₁ s₂) (a b : ℕ → ℝ → ℂ)
    (n n' : ℕ) : fitRange (M := M) s₁ a n ⟂ fitRange s₂ b n' := by
  unfold fitRange
  refine Submodule.isOrtho_span.mpr ?_
  rintro _ ⟨i, -, rfl⟩ _ ⟨i', -, rfl⟩
  by_cases h₁ : FitAdmissible s₁ (a i)
  · by_cases h₂ : FitAdmissible s₂ (b i')
    · rw [MeasureTheory.L2.inner_def]
      refine integral_eq_zero_of_ae ?_
      filter_upwards [fitColumn_coeFn h₁ i, fitColumn_coeFn h₂ i'] with y hy1 hy2
      rw [hy1, hy2]
      by_cases hy : y ∈ s₁
      · have hy' : y ∉ s₂ := Set.disjoint_left.mp hd hy
        rw [Set.indicator_of_notMem hy', inner_zero_right]; rfl
      · rw [Set.indicator_of_notMem hy, inner_zero_left]; rfl
    · unfold fitColumn
      simp only [h₂, ↓reduceDIte, inner_zero_right]
  · unfold fitColumn
    simp only [h₁, ↓reduceDIte, inner_zero_left]

/-- The fit energy on a cell is at most the sum of the fit energies on its two halves with the
same atoms (refinement of the partition; nested subspaces). -/
theorem fitEnergy_split {M : ℕ} {s₁ s₂ : Set ℝ} (hs₁ : MeasurableSet s₁)
    (hs₁v : volume s₁ < ⊤) (hs₂ : MeasurableSet s₂) (hs₂v : volume s₂ < ⊤)
    (hd : Disjoint s₁ s₂) (a : ℕ → ℝ → ℂ) (n : ℕ) (z : ColumnL2 (Fin M)) :
    ‖fitProj M (s₁ ∪ s₂) a n z‖ ^ 2 ≤ ‖fitProj M s₁ a n z‖ ^ 2 + ‖fitProj M s₂ a n z‖ ^ 2 :=
  starProjection_energy_le_of_le_sup (fitRange_le_sup_union hs₁ hs₁v hs₂ hs₂v hd a n)
    (fitRange_isOrtho hd a a n n) z

theorem fitRange_ae_zero_off {M : ℕ} {s : Set ℝ} {a : ℕ → ℝ → ℂ} {n : ℕ}
    {x : ColumnL2 (Fin M)} (hx : x ∈ fitRange s a n) :
    ∀ᵐ y ∂volume, y ∉ s → (x : ℝ → ColumnHilbert (Fin M)) y = 0 := by
  refine Submodule.span_induction (R := ℂ) (M := ColumnL2 (Fin M)) (p := fun x _ =>
    ∀ᵐ y ∂volume, y ∉ s → (x : ℝ → ColumnHilbert (Fin M)) y = 0) ?_ ?_ ?_ ?_ hx
  · rintro x ⟨i, hi, rfl⟩
    by_cases h : FitAdmissible s (a i)
    · filter_upwards [fitColumn_coeFn h i] with y hy hys
      rw [hy, Set.indicator_of_notMem hys]
    · unfold fitColumn
      simp only [h, ↓reduceDIte]
      filter_upwards [Lp.coeFn_zero (ColumnHilbert (Fin M)) 2 volume] with y hy _
      rw [hy]; rfl
  · filter_upwards [Lp.coeFn_zero (ColumnHilbert (Fin M)) 2 volume] with y hy _
    rw [hy]; rfl
  · intro x y _ _ hx hy
    filter_upwards [hx, hy, Lp.coeFn_add x y] with z hx hy hz hzs
    rw [hz, Pi.add_apply, hx hzs, hy hzs, add_zero]
  · intro c x _ hx
    filter_upwards [hx, Lp.coeFn_smul c x] with z hx hz hzs
    rw [hz, Pi.smul_apply, hx hzs, smul_zero]

/-- The fit projection only sees the input on its cell. -/
theorem fitProj_restrict {M : ℕ} {s : Set ℝ} (hs : MeasurableSet s) (a : ℕ → ℝ → ℂ) (n : ℕ)
    (z : ColumnL2 (Fin M)) :
    fitProj M s a n (columnL2Restriction s hs z) = fitProj M s a n z := by
  unfold fitProj
  set! U := fitRange (M := M) s a n
  have e : columnL2Restriction s hs z = columnL2Indicator s hs z := rfl
  have hw : z - columnL2Restriction s hs z ∈ Uᗮ := by
    rw [e]
    refine (Submodule.mem_orthogonal' U _).mpr fun u hu => ?_
    rw [MeasureTheory.L2.inner_def]
    refine integral_eq_zero_of_ae ?_
    filter_upwards [fitRange_ae_zero_off hu, Lp.coeFn_sub z (columnL2Indicator s hs z),
      columnL2Indicator_coeFn s hs z] with y hu hy hr
    rw [hy, Pi.sub_apply, hr]
    by_cases hys : y ∈ s
    · rw [Set.indicator_of_mem hys, sub_self, inner_zero_left]; rfl
    · rw [hu hys, inner_zero_right]; rfl
  calc U.starProjection (columnL2Restriction s hs z)
      = U.starProjection (columnL2Restriction s hs z) +
          U.starProjection (z - columnL2Restriction s hs z) := by
        rw [(Submodule.starProjection_apply_eq_zero_iff U).mpr hw, add_zero]
    _ = U.starProjection z := by rw [← map_add]; congr 1; abel

/-- Contraction of the fit projection on its cell: `‖P z‖² ≤ ∫_s ‖z‖²`. -/
theorem fitEnergy_le {M : ℕ} {s : Set ℝ} (hs : MeasurableSet s) (a : ℕ → ℝ → ℂ) (n : ℕ)
    (z : ColumnL2 (Fin M)) :
    ‖fitProj M s a n z‖ ^ 2 ≤ ∫ y in s, ‖(z : ℝ → ColumnHilbert (Fin M)) y‖ ^ 2 := by
  rw [← fitProj_restrict hs, ← columnL2Restriction_norm_sq s hs z]
  have h1 := ContinuousLinearMap.le_opNorm (fitProj M s a n) (columnL2Restriction s hs z)
  have h2 : ‖fitProj M s a n‖ ≤ 1 := Submodule.starProjection_norm_le _
  have h3 : ‖fitProj M s a n (columnL2Restriction s hs z)‖ ≤ ‖columnL2Restriction s hs z‖ :=
    h1.trans (by simpa using mul_le_mul_of_nonneg_right h2 (norm_nonneg _))
  exact pow_le_pow_left₀ (norm_nonneg _) h3 2

/-! ### One attempt of the adaptive fit on a dyadic tree -/

/-- The parent cell. -/
noncomputable def dyadicParent (G : RealDyadicGrid) (c : ℤ × ℤ) : ℤ × ℤ :=
  (c.1 - 1, dyadicIndex G (c.1 - 1) (dyadicGridLeft G c.1 c.2))

theorem dyadicParent_of_mem_children (G : RealDyadicGrid) {p c : ℤ × ℤ}
    (hc : c ∈ dyadicChildren G p) : dyadicParent G c = p := by
  have hd := dyadicChildren_depth G p c hc
  have hs := dyadicChildren_subset G p c hc
  have hl := hs (dyadicGridCell_left_mem G c.1 c.2)
  have hp1 : c.1 - 1 = p.1 := by omega
  unfold dyadicParent
  rw [hp1, dyadicIndex_eq hl]

/-- The states of one attempt: atoms and count at each cell of depth `root + d`. -/
noncomputable def fitState (G : RealDyadicGrid) (M : ℕ) (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop)
    (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) : ℕ → ℤ × ℤ → (ℕ → ℝ → ℂ) × ℕ
  | 0, c => fitGreedy M (P c) (O c) (fun _ => 0, 0)
  | d + 1, c => fitGreedy M (P c) (O c) (fitState G M P O d (dyadicParent G c))

theorem fitState_count_le (G : RealDyadicGrid) (M : ℕ) (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop)
    (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) (d : ℕ) (c : ℤ × ℤ) :
    (fitState G M P O d c).2 ≤ M := by
  induction d generalizing c with
  | zero => exact (fitGreedy_count (P := P c) (O := O c) _ (Nat.zero_le _)).2
  | succ d ih => exact (fitGreedy_count (P := P c) (O := O c) _ (ih _)).2

/-- The inherited count of a cell: the parent's final count (zero at the root). -/
noncomputable def fitInherited (G : RealDyadicGrid) (M : ℕ)
    (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop) (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) :
    ℕ → ℤ × ℤ → (ℕ → ℝ → ℂ) × ℕ
  | 0, _ => (fun _ => 0, 0)
  | d + 1, c => fitState G M P O d (dyadicParent G c)

theorem fitState_eq_greedy (G : RealDyadicGrid) (M : ℕ) (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop)
    (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) (d : ℕ) (c : ℤ × ℤ) :
    fitState G M P O d c = fitGreedy M (P c) (O c) (fitInherited G M P O d c) := by
  cases d <;> rfl

theorem fitInherited_count_le (G : RealDyadicGrid) (M : ℕ)
    (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop) (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ)
    (d : ℕ) (c : ℤ × ℤ) : (fitInherited G M P O d c).2 ≤ M := by
  cases d with
  | zero => exact Nat.zero_le _
  | succ d => exact fitState_count_le G M P O d _

/-- The number of atoms inserted at a cell. -/
noncomputable def fitNew (G : RealDyadicGrid) (M : ℕ) (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop)
    (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) (d : ℕ) (c : ℤ × ℤ) : ℕ :=
  (fitState G M P O d c).2 - (fitInherited G M P O d c).2

theorem fitNew_add (G : RealDyadicGrid) (M : ℕ) (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop)
    (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) (d : ℕ) (c : ℤ × ℤ) :
    (fitState G M P O d c).2 = (fitInherited G M P O d c).2 + fitNew G M P O d c := by
  have h := (fitGreedy_count (P := P c) (O := O c) (fitInherited G M P O d c)
    (fitInherited_count_le G M P O d c)).1
  rw [fitState_eq_greedy] at *
  unfold fitNew
  rw [fitState_eq_greedy]
  omega

/-- A cell whose stopping predicate holds for every state inserts nothing. -/
theorem fitNew_eq_zero_of_P (G : RealDyadicGrid) (M : ℕ)
    (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop) (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) (d : ℕ)
    (c : ℤ × ℤ) (hP : ∀ a n, P c a n) : fitNew G M P O d c = 0 := by
  have hfix : ∀ st, fitStep M (P c) (O c) st = st := fun st => by
    rcases fitStep_count (P := P c) (O := O c) (M := M) st with h | ⟨-, hn, -⟩
    · exact h
    · exact absurd (hP st.1 st.2) hn
  have hg : ∀ st, fitGreedy M (P c) (O c) st = st := fun st => by
    unfold fitGreedy
    exact Function.iterate_fixed (hfix st) M
  unfold fitNew
  rw [fitState_eq_greedy, hg]
  omega

section FitEnergy
variable (G : RealDyadicGrid) (M : ℕ) (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop)
  (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) (f : Lp ℂ 2 (volume : Measure ℝ))

/-- The oracle hypothesis: whenever the residual at a cell is not small and the cap is not
reached, the oracle's atom is admissible and correlates with the residual by `ρ |I|`. -/
def FitOracle (ρ : ℝ) : Prop :=
  ∀ c a n, n < M → ¬ P c a n →
    FitAdmissible (dyadicGridCell G c.1 c.2) (O c a n) ∧
    ρ * dyadicGridLength G c.1 ≤
      ‖∫ y in dyadicGridCell G c.1 c.2, conj (O c a n y) *
        fitResid M (dyadicGridCell G c.1 c.2) f a n y‖

/-- The fit energy at a cell for a state. -/
noncomputable def fitCellEnergy (c : ℤ × ℤ) (st : (ℕ → ℝ → ℂ) × ℕ) : ℝ :=
  ‖fitProj M (dyadicGridCell G c.1 c.2) st.1 st.2 (physicalColumnInput f)‖ ^ 2

theorem fitCellEnergy_gain {ρ : ℝ} (hρ : 0 ≤ ρ) (horacle : FitOracle G M P O f ρ) (d : ℕ)
    (c : ℤ × ℤ) :
    fitCellEnergy G M f c (fitInherited G M P O d c) +
        ρ ^ 2 * dyadicGridLength G c.1 / 4 * fitNew G M P O d c ≤
      fitCellEnergy G M f c (fitState G M P O d c) := by
  have h := fitGreedy_energy (M := M) (P := P c) (O := O c)
    (fun a n => fitCellEnergy G M f c (a, n)) (g := ρ ^ 2 * dyadicGridLength G c.1 / 4)
    (fun a n hn hP => by
      obtain ⟨hadm, hcorr⟩ := horacle c a n hn hP
      have hgain := fitEnergy_gain f a hn hadm hρ
        (by rw [volume_real_cell]; exact hcorr)
      rw [volume_real_cell] at hgain
      exact hgain) (fitInherited G M P O d c)
  rw [← fitState_eq_greedy] at h
  have hc := (fitGreedy_count (P := P c) (O := O c) (fitInherited G M P O d c)
    (fitInherited_count_le G M P O d c)).1
  rw [← fitState_eq_greedy] at hc
  have hnew : ((fitState G M P O d c).2 - (fitInherited G M P O d c).2 : ℝ) =
      (fitNew G M P O d c : ℝ) := by
    unfold fitNew; rw [Nat.cast_sub hc]
  rw [hnew] at h
  exact h

/-- The two children of a cell carry at least the parent's fit energy with the same atoms. -/
theorem fitCellEnergy_children (p : ℤ × ℤ) (st : (ℕ → ℝ → ℂ) × ℕ) :
    fitCellEnergy G M f p st ≤ ∑ c ∈ dyadicChildren G p, fitCellEnergy G M f c st := by
  set m := Classical.choose (dyadicGridCell_children G p.1 p.2)
  have hm := Classical.choose_spec (dyadicGridCell_children G p.1 p.2)
  have hch : dyadicChildren G p = {(p.1 + 1, m), (p.1 + 1, m + 1)} := rfl
  have hne : ((p.1 + 1, m) : ℤ × ℤ) ≠ (p.1 + 1, m + 1) := by simp
  rw [hch, Finset.sum_pair hne]
  have hd : Disjoint (dyadicGridCell G (p.1 + 1) m) (dyadicGridCell G (p.1 + 1) (m + 1)) :=
    dyadicGridCell_pairwiseDisjoint G (p.1 + 1) (by omega)
  unfold fitCellEnergy
  have := fitEnergy_split (M := M) (dyadicGridCell_measurable G _ _)
    (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_lt_top)
    (dyadicGridCell_measurable G _ _)
    (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_lt_top) hd st.1 st.2
    (physicalColumnInput f)
  simp only at this ⊢
  rw [hm]
  exact this

theorem dyadicGeneration_children_disjoint (G : RealDyadicGrid) (R : ℤ × ℤ) (k : ℕ) :
    (dyadicGeneration G R k : Set (ℤ × ℤ)).PairwiseDisjoint (dyadicChildren G) := by
  intro p _ p' _ hne
  refine Finset.disjoint_left.mpr fun c hc hc' => hne ?_
  rw [← dyadicParent_of_mem_children G hc, dyadicParent_of_mem_children G hc']

/-- Blueprint §11.2, line 1577 ("fits and refinements form nested subspaces"): the energy gains
of all insertions down to generation `d` are at most the fit energy of that generation. -/
theorem fitEnergy_telescope {ρ : ℝ} (hρ : 0 ≤ ρ) (horacle : FitOracle G M P O f ρ)
    (R : ℤ × ℤ) (d : ℕ) :
    ∑ k ∈ Finset.range (d + 1), ∑ c ∈ dyadicGeneration G R k,
        ρ ^ 2 * dyadicGridLength G c.1 / 4 * fitNew G M P O k c ≤
      ∑ c ∈ dyadicGeneration G R d, fitCellEnergy G M f c (fitState G M P O d c) := by
  induction d with
  | zero =>
    simp only [zero_add, Finset.range_one, Finset.sum_singleton]
    refine Finset.sum_le_sum fun c _ => ?_
    have h := fitCellEnergy_gain G M P O f hρ horacle 0 c
    have h0 : 0 ≤ fitCellEnergy G M f c (fitInherited G M P O 0 c) := by
      unfold fitCellEnergy; positivity
    linarith
  | succ d ih =>
    rw [Finset.sum_range_succ]
    have hgen : dyadicGeneration G R (d + 1) =
        (dyadicGeneration G R d).biUnion (dyadicChildren G) := rfl
    have hstep : ∑ c ∈ dyadicGeneration G R (d + 1),
        (fitCellEnergy G M f c (fitInherited G M P O (d + 1) c) +
          ρ ^ 2 * dyadicGridLength G c.1 / 4 * fitNew G M P O (d + 1) c) ≤
        ∑ c ∈ dyadicGeneration G R (d + 1), fitCellEnergy G M f c (fitState G M P O (d + 1) c) :=
      Finset.sum_le_sum fun c _ => fitCellEnergy_gain G M P O f hρ horacle (d + 1) c
    have hinh : ∑ p ∈ dyadicGeneration G R d, fitCellEnergy G M f p (fitState G M P O d p) ≤
        ∑ c ∈ dyadicGeneration G R (d + 1),
          fitCellEnergy G M f c (fitInherited G M P O (d + 1) c) := by
      rw [hgen, Finset.sum_biUnion (dyadicGeneration_children_disjoint G R d)]
      refine Finset.sum_le_sum fun p _ => ?_
      refine (fitCellEnergy_children G M f p _).trans (le_of_eq ?_)
      refine Finset.sum_congr rfl fun c hc => ?_
      simp only [fitInherited, dyadicParent_of_mem_children G hc]
    rw [Finset.sum_add_distrib] at hstep
    linarith

/-- The fit energy of a generation is at most the input energy on the root. -/
theorem fitEnergy_generation_le (R : ℤ × ℤ) (d : ℕ) (st : ℤ × ℤ → (ℕ → ℝ → ℂ) × ℕ) :
    ∑ c ∈ dyadicGeneration G R d, fitCellEnergy G M f c (st c) ≤
      ∫ y in dyadicGridCell G R.1 R.2, ‖(f : ℝ → ℂ) y‖ ^ 2 := by
  calc ∑ c ∈ dyadicGeneration G R d, fitCellEnergy G M f c (st c)
      ≤ ∑ c ∈ dyadicGeneration G R d, ∫ y in dyadicGridCell G c.1 c.2,
          ‖(physicalColumnInput (V := Fin M) f : ℝ → ColumnHilbert (Fin M)) y‖ ^ 2 :=
        Finset.sum_le_sum fun c _ => fitEnergy_le (dyadicGridCell_measurable G _ _) _ _ _
    _ = ∫ y in dyadicGridCell G R.1 R.2,
          ‖(physicalColumnInput (V := Fin M) f : ℝ → ColumnHilbert (Fin M)) y‖ ^ 2 :=
        (setIntegral_cell_eq_sum_generation_real G R d (integrableOn_norm_sq_Lp _ _)).symm
    _ = _ := integral_physical_sq f _

end FitEnergy

/-! ### Coefficients of the fit projection -/
theorem columnHilbert_sum_apply {V : Type*} {ι : Type*} (s : Finset ι)
    (x : ι → ColumnHilbert V) (o : Option V) : (∑ i ∈ s, x i) o = ∑ i ∈ s, x i o := by
  induction s using Finset.cons_induction with
  | empty => simp only [Finset.sum_empty]; rfl
  | cons b s hb ih => rw [Finset.sum_cons, Finset.sum_cons, PiLp.add_apply, ih]

/-- The labels of the first `n` fit columns. -/
def fitLabels (M n : ℕ) : Finset (Fin M) := Finset.univ.filter (fun i : Fin M => (i : ℕ) < n)

theorem fitRange_exists_coeff {M : ℕ} {s : Set ℝ} {a : ℕ → ℝ → ℂ} {n : ℕ}
    {x : ColumnL2 (Fin M)} (hx : x ∈ fitRange s a n) :
    ∃ c : Fin M → ℂ, x = ∑ i ∈ fitLabels M n, c i • fitColumn s (a i) i := by
  classical
  refine Submodule.span_induction (R := ℂ) (M := ColumnL2 (Fin M)) (p := fun x _ =>
    ∃ c : Fin M → ℂ, x = ∑ i ∈ fitLabels M n, c i • fitColumn s (a i) i) ?_ ?_ ?_ ?_ hx
  · rintro x ⟨i, hi, rfl⟩
    refine ⟨Pi.single i (1 : ℂ), ?_⟩
    rw [Finset.sum_eq_single i]
    · simp
    · intro b _ hb; simp [hb]
    · intro h; exact absurd (show i ∈ fitLabels M n from
        Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩) h
  · exact ⟨0, by simp⟩
  · rintro x y _ _ ⟨c, rfl⟩ ⟨d, rfl⟩
    exact ⟨c + d, by simp [add_smul, Finset.sum_add_distrib]⟩
  · rintro r x _ ⟨c, rfl⟩
    exact ⟨r • c, by simp [Finset.smul_sum, smul_smul]⟩

/-- Coefficients of the fit projection in the fit columns. -/
noncomputable def fitCoeff (M : ℕ) (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ)
    (z : ColumnL2 (Fin M)) : Fin M → ℂ :=
  Classical.choose (fitRange_exists_coeff
    (Submodule.starProjection_apply_mem (fitRange (M := M) s a n) z))

theorem fitCoeff_spec (M : ℕ) (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ) (z : ColumnL2 (Fin M)) :
    fitProj M s a n z = ∑ i ∈ fitLabels M n, fitCoeff M s a n z i • fitColumn s (a i) i :=
  Classical.choose_spec (fitRange_exists_coeff
    (Submodule.starProjection_apply_mem (fitRange (M := M) s a n) z))

open scoped Classical in
/-- The pointwise physical part of the fit projection: `∑ c_i a_i` over admissible atoms. -/
noncomputable def fitPhys (M : ℕ) (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ)
    (z : ColumnL2 (Fin M)) (y : ℝ) : ℂ :=
  ∑ i ∈ fitLabels M n, if FitAdmissible s (a i) then fitCoeff M s a n z i * a i y else 0

open scoped Classical in
theorem fitProj_coeFn (M : ℕ) {s : Set ℝ} (a : ℕ → ℝ → ℂ) (n : ℕ) (z : ColumnL2 (Fin M)) :
    ∀ᵐ y ∂volume, y ∈ s → (fitProj M s a n z : ℝ → ColumnHilbert (Fin M)) y =
      ∑ i ∈ fitLabels M n, if FitAdmissible s (a i) then
        fitCoeff M s a n z i • fitColumnValue (a i) i y else 0 := by
  have hcol : ∀ i : Fin M, ∀ᵐ y ∂volume, y ∈ s →
      ((fitCoeff M s a n z i • fitColumn s (a i) i : ColumnL2 (Fin M)) :
        ℝ → ColumnHilbert (Fin M)) y = if FitAdmissible s (a i) then
          fitCoeff M s a n z i • fitColumnValue (a i) i y else 0 := by
    intro i
    by_cases h : FitAdmissible s (a i)
    · filter_upwards [Lp.coeFn_smul (fitCoeff M s a n z i) (fitColumn s (a i) i),
        fitColumn_coeFn h i] with y h1 h2 hys
      rw [h1, Pi.smul_apply, h2, Set.indicator_of_mem hys]
      simp only [h, ↓reduceIte]
    · have h0 : fitColumn s (a i) i = 0 := by unfold fitColumn; simp only [h, ↓reduceDIte]
      filter_upwards [Lp.coeFn_zero (ColumnHilbert (Fin M)) 2 volume] with y hy _
      rw [h0, smul_zero, hy]
      simp only [h, ↓reduceIte]; rfl
  have hall : ∀ᵐ y ∂volume, ∀ i ∈ fitLabels M n, y ∈ s →
      ((fitCoeff M s a n z i • fitColumn s (a i) i : ColumnL2 (Fin M)) :
        ℝ → ColumnHilbert (Fin M)) y = if FitAdmissible s (a i) then
          fitCoeff M s a n z i • fitColumnValue (a i) i y else 0 :=
    (Filter.eventually_all_finset _).mpr fun i _ => hcol i
  filter_upwards [hall, Lp.coeFn_fun_finsetSum (fitLabels M n)
    (fun i => fitCoeff M s a n z i • fitColumn s (a i) i)] with y hy hsum hys
  rw [fitCoeff_spec, hsum]
  exact Finset.sum_congr rfl fun i hi => hy i hi hys

open scoped Classical in
/-- The physical coordinate of the fit projection is `fitPhys` almost everywhere on the cell. -/
theorem fitProj_none (M : ℕ) {s : Set ℝ} (a : ℕ → ℝ → ℂ) (n : ℕ) (z : ColumnL2 (Fin M)) :
    ∀ᵐ y ∂volume, y ∈ s →
      (fitProj M s a n z : ℝ → ColumnHilbert (Fin M)) y none = fitPhys M s a n z y := by
  filter_upwards [fitProj_coeFn M a n z] with y hy hys
  rw [hy hys, fitPhys]
  rw [columnHilbert_sum_apply]
  refine Finset.sum_congr rfl fun i _ => ?_
  split_ifs
  · simp [fitColumnValue_none, smul_eq_mul]
  · rfl

open scoped Classical in
/-- The private coordinates of the fit projection are the coefficients. -/
theorem fitProj_some (M : ℕ) {s : Set ℝ} (a : ℕ → ℝ → ℂ) (n : ℕ) (z : ColumnL2 (Fin M))
    (m : Fin M) :
    ∀ᵐ y ∂volume, y ∈ s →
      (fitProj M s a n z : ℝ → ColumnHilbert (Fin M)) y (some m) =
        if m ∈ fitLabels M n ∧ FitAdmissible s (a m) then fitCoeff M s a n z m else 0 := by
  filter_upwards [fitProj_coeFn M a n z] with y hy hys
  rw [hy hys]
  rw [columnHilbert_sum_apply]
  by_cases hm : m ∈ fitLabels M n
  · rw [Finset.sum_eq_single m]
    · by_cases h1 : FitAdmissible s (a m)
      · simp [h1, hm, fitColumnValue_some]
      · simp only [h1, ↓reduceIte, and_false]; rfl
    · intro b _ hb
      split_ifs
      · simp [fitColumnValue_some, Ne.symm hb]
      · rfl
    · intro h; exact absurd hm h
  · simp only [hm, false_and, ↓reduceIte]
    refine Finset.sum_eq_zero fun b hb => ?_
    have hb' : m ≠ b := fun h => hm (h ▸ hb)
    split_ifs
    · simp [fitColumnValue_some, hb']
    · rfl

open scoped Classical in
/-- The squared coefficient norm over admissible atoms. -/
noncomputable def fitCoeffSq (M : ℕ) (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ)
    (z : ColumnL2 (Fin M)) : ℝ :=
  ∑ i ∈ fitLabels M n, if FitAdmissible s (a i) then ‖fitCoeff M s a n z i‖ ^ 2 else 0

theorem fitCoeffSq_nonneg (M : ℕ) (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ) (z : ColumnL2 (Fin M)) :
    0 ≤ fitCoeffSq M s a n z :=
  Finset.sum_nonneg fun i _ => by split_ifs <;> positivity

/-- Private weights one bound the coefficient `ℓ²` norm: `|s| ∑ |c_i|² ≤ ∫_s ‖P z‖²`. -/
theorem fitCoeffSq_le (M : ℕ) {s : Set ℝ} (hs : MeasurableSet s) (hsv : volume s < ⊤)
    (a : ℕ → ℝ → ℂ) (n : ℕ) (z : ColumnL2 (Fin M)) :
    volume.real s * fitCoeffSq M s a n z ≤
      ∫ y in s, ‖(fitProj M s a n z : ℝ → ColumnHilbert (Fin M)) y‖ ^ 2 := by
  classical
  have : IsFiniteMeasure (volume.restrict s) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact hsv⟩
  have hpt : ∀ᵐ y ∂volume.restrict s, fitCoeffSq M s a n z ≤
      ‖(fitProj M s a n z : ℝ → ColumnHilbert (Fin M)) y‖ ^ 2 := by
    have hall : ∀ᵐ y ∂volume, ∀ m : Fin M, y ∈ s →
        (fitProj M s a n z : ℝ → ColumnHilbert (Fin M)) y (some m) =
          if m ∈ fitLabels M n ∧ FitAdmissible s (a m) then fitCoeff M s a n z m else 0 :=
      ae_all_iff.mpr fun m => fitProj_some M a n z m
    rw [ae_restrict_iff' hs]
    filter_upwards [hall] with y hy hys
    rw [EuclideanSpace.norm_sq_eq, Fintype.sum_option]
    have h1 : fitCoeffSq M s a n z ≤ ∑ m : Fin M,
        ‖(fitProj M s a n z : ℝ → ColumnHilbert (Fin M)) y (some m)‖ ^ 2 := by
      unfold fitCoeffSq
      rw [← Finset.sum_subset (Finset.subset_univ (fitLabels M n)) (fun m _ hm => by
        rw [hy m hys]; simp [hm])]
      refine le_of_eq (Finset.sum_congr rfl fun m hm => ?_)
      rw [hy m hys]
      split_ifs with h1 h2 h2
      · rfl
      · exact absurd ⟨hm, h1⟩ h2
      · exact absurd h2.2 h1
      · simp
    linarith [sq_nonneg ‖(fitProj M s a n z : ℝ → ColumnHilbert (Fin M)) y none‖]
  calc volume.real s * fitCoeffSq M s a n z = ∫ _ in s, fitCoeffSq M s a n z := by
        rw [setIntegral_const, smul_eq_mul]
    _ ≤ _ := integral_mono_ae (integrable_const _) (integrableOn_norm_sq_Lp _ s) hpt

/-- The pointwise bound `|∑ c_i a_i|² ≤ M ∑ |c_i|²` for atoms bounded by one. -/
theorem norm_fitPhys_sq_le (M : ℕ) (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ) (z : ColumnL2 (Fin M))
    (y : ℝ) : ‖fitPhys M s a n z y‖ ^ 2 ≤ M * fitCoeffSq M s a n z := by
  classical
  set b : Fin M → ℝ := fun i =>
    if FitAdmissible s (a i) then ‖fitCoeff M s a n z i‖ else 0 with hb
  have h1 : ‖fitPhys M s a n z y‖ ≤ ∑ i ∈ fitLabels M n, b i := by
    unfold fitPhys
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun i _ => ?_)
    simp only [hb]
    split_ifs with h
    · rw [norm_mul]
      exact mul_le_of_le_one_right (norm_nonneg _) (h.2.2.2 y)
    · simp
  have h2 := sq_sum_le_card_mul_sum_sq (s := fitLabels M n) (f := b)
  have hcard : ((fitLabels M n).card : ℝ) ≤ M := by
    have := Finset.card_le_univ (fitLabels M n)
    simp only [Fintype.card_fin] at this
    exact_mod_cast this
  have hsq : ∑ i ∈ fitLabels M n, b i ^ 2 = fitCoeffSq M s a n z := by
    unfold fitCoeffSq
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [hb]
    split_ifs <;> simp
  have hb0 : 0 ≤ ∑ i ∈ fitLabels M n, b i :=
    Finset.sum_nonneg fun i _ => by simp only [hb]; split_ifs <;> positivity
  calc ‖fitPhys M s a n z y‖ ^ 2 ≤ (∑ i ∈ fitLabels M n, b i) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) h1 2
    _ ≤ (fitLabels M n).card * ∑ i ∈ fitLabels M n, b i ^ 2 := by exact_mod_cast h2
    _ ≤ M * fitCoeffSq M s a n z := by
        rw [hsq]
        exact mul_le_mul_of_nonneg_right hcard (fitCoeffSq_nonneg M s a n z)

theorem fitPhys_measurable (M : ℕ) (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ)
    (z : ColumnL2 (Fin M)) : Measurable (fitPhys M s a n z) := by
  classical
  unfold fitPhys
  refine Finset.measurable_sum _ fun i _ => ?_
  split_ifs with h
  · exact measurable_const.mul h.2.2.1
  · exact measurable_const

/-- The physical fit is bounded in `L²(s)` by the fit energy. -/
theorem setIntegral_fitPhys_sq_le (M : ℕ) {s : Set ℝ} (hs : MeasurableSet s)
    (hsv : volume s < ⊤) (a : ℕ → ℝ → ℂ) (n : ℕ) (z : ColumnL2 (Fin M)) :
    ∫ y in s, ‖fitPhys M s a n z y‖ ^ 2 ≤
      ∫ y in s, ‖(fitProj M s a n z : ℝ → ColumnHilbert (Fin M)) y‖ ^ 2 := by
  have : IsFiniteMeasure (volume.restrict s) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact hsv⟩
  have hint : Integrable (fun y => ‖fitPhys M s a n z y‖ ^ 2) (volume.restrict s) := by
    refine Integrable.of_bound (C := M * fitCoeffSq M s a n z)
      ((fitPhys_measurable M s a n z).norm.pow_const 2).aestronglyMeasurable
      (Filter.Eventually.of_forall fun y => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    exact norm_fitPhys_sq_le M s a n z y
  refine integral_mono_ae hint (integrableOn_norm_sq_Lp _ s) ?_
  rw [Filter.EventuallyLE, ae_restrict_iff' hs]
  filter_upwards [fitProj_none M a n z] with y hy hys
  rw [← hy hys, EuclideanSpace.norm_sq_eq, Fintype.sum_option]
  have : 0 ≤ ∑ m : Fin M,
      ‖(fitProj M s a n z : ℝ → ColumnHilbert (Fin M)) y (some m)‖ ^ 2 :=
    Finset.sum_nonneg fun _ _ => by positivity
  linarith

/-! ### The adaptive-fit oracle -/
theorem eLpNorm_normalized_le_of_integral {a r : ℝ} (hr : 0 < r) {g : ℝ → ℂ}
    (hg : MemLp g 2 (volume.restrict (Set.Ico a (a + r)))) {C : ℝ} (hC : 0 ≤ C)
    (h : ∫ y in Set.Ico a (a + r), ‖g y‖ ^ 2 ≤ C ^ 2 * r) :
    eLpNorm g 2 (normalizedIntervalMeasure a r) ≤ ENNReal.ofReal C := by
  have hres : volume.restrict (Set.Ico a (a + r)) = volume.restrict (Set.Icc a (a + r)) :=
    Measure.restrict_congr_set Ico_ae_eq_Icc
  have hm : MemLp g 2 (normalizedIntervalMeasure a r) := by
    rw [hres] at hg
    exact hg.smul_measure (c := ENNReal.ofReal r⁻¹) ENNReal.ofReal_ne_top
  rw [hm.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
  apply ENNReal.ofReal_le_ofReal
  have heq : ∫ y, ‖g y‖ ^ (2 : ENNReal).toReal ∂normalizedIntervalMeasure a r =
      r⁻¹ * ∫ y in Set.Ico a (a + r), ‖g y‖ ^ 2 := by
    rw [normalizedIntervalMeasure, integral_smul_measure,
      ENNReal.toReal_ofReal (inv_nonneg.mpr hr.le), smul_eq_mul,
      setIntegral_congr_set Ico_ae_eq_Icc.symm]
    congr 2; funext y; simp
  rw [heq]
  have hX : r⁻¹ * ∫ y in Set.Ico a (a + r), ‖g y‖ ^ 2 ≤ C ^ 2 := by
    rw [inv_mul_le_iff₀ hr]; linarith
  have hX0 : 0 ≤ r⁻¹ * ∫ y in Set.Ico a (a + r), ‖g y‖ ^ 2 :=
    mul_nonneg (inv_nonneg.mpr hr.le) (integral_nonneg fun _ => by positivity)
  have e : (2 : ENNReal).toReal⁻¹ = (1 / 2 : ℝ) := by norm_num
  rw [e, ← Real.sqrt_eq_rpow]
  calc Real.sqrt _ ≤ Real.sqrt (C ^ 2) := Real.sqrt_le_sqrt hX
    _ = C := Real.sqrt_sq hC

theorem intervalIntegral_eq_cell {a r : ℝ} (hr : 0 ≤ r) (h : ℝ → ℂ) :
    ∫ x in a..a + r, h x = ∫ x in Set.Ico a (a + r), h x := by
  rw [intervalIntegral.integral_of_le (by linarith)]
  exact setIntegral_congr_set (Ioc_ae_eq_Icc.trans Ico_ae_eq_Icc.symm)

/-- A detection chart: complexity and boundedness at budget `B`, and correlation `B⁻¹`. -/
def FitChartGood (c₂ : ℕ) (B a₀ r : ℝ) (R : ℝ → ℂ) (p : Σ d, QuadraticChartData d) : Prop :=
  QuadraticChartComplexity c₂ B p.2 ∧ IsBoundedQuadraticChart p.2 ∧
    B⁻¹ ≤ r⁻¹ * ‖∫ x in a₀..a₀ + r, R x * conj (quadraticChartAtom p.2 x)‖

open scoped Classical in
/-- The oracle atom: a chosen detection chart, when one exists. -/
noncomputable def fitOracleAtom (c₂ : ℕ) (B a₀ r : ℝ) (R : ℝ → ℂ) : ℝ → ℂ :=
  if h : ∃ p, FitChartGood c₂ B a₀ r R p then quadraticChartAtom (Classical.choose h).2 else 0

theorem fitOracleAtom_good {c₂ : ℕ} {B a₀ r : ℝ} {R : ℝ → ℂ}
    (h : ∃ p, FitChartGood c₂ B a₀ r R p) :
    ∃ p, FitChartGood c₂ B a₀ r R p ∧ fitOracleAtom c₂ B a₀ r R = quadraticChartAtom p.2 := by
  refine ⟨Classical.choose h, Classical.choose_spec h, ?_⟩
  unfold fitOracleAtom
  simp only [h, ↓reduceDIte]

/-- The kernel hull of a finite tree: cells containing a tree cell with a nonzero kernel
(blueprint prop:normalized, line 2832: the normalization is only assumed on the rooted subtree of
the used cells; the other cells carry the zero kernel). -/
def kernelHull (G : RealDyadicGrid) (J : ℤ × ℤ) (N : ℕ) (w : ℤ × ℤ → ℝ × ℝ → ℂ)
    (c : ℤ × ℤ) : Prop :=
  ∃ c' ∈ dyadicFiniteTree G J N, dyadicGridCell G c'.1 c'.2 ⊆ dyadicGridCell G c.1 c.2 ∧ w c' ≠ 0

theorem kernelHull_of_ne {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {w : ℤ × ℤ → ℝ × ℝ → ℂ}
    {c : ℤ × ℤ} (hc : c ∈ dyadicFiniteTree G J N) (hw : w c ≠ 0) : kernelHull G J N w c :=
  ⟨c, hc, subset_rfl, hw⟩

theorem kernelHull.mono {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {w : ℤ × ℤ → ℝ × ℝ → ℂ}
    {c d : ℤ × ℤ} (h : kernelHull G J N w c)
    (hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2) : kernelHull G J N w d := by
  obtain ⟨c', hc', hsub, hw⟩ := h
  exact ⟨c', hc', hsub.trans hcd, hw⟩

theorem eq_zero_of_not_kernelHull {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ}
    {w : ℤ × ℤ → ℝ × ℝ → ℂ} {c : ℤ × ℤ} (hc : c ∈ dyadicFiniteTree G J N)
    (h : ¬ kernelHull G J N w c) : w c = 0 := by
  by_contra hw; exact h (kernelHull_of_ne hc hw)

theorem localProgressionForm_zero_kernel (r : ℝ) (F : Fin 4 → ℝ → ℂ) :
    localProgressionForm r 0 F = 0 := by
  simp [localProgressionForm]

/-- Every residual is small for the zero kernel. -/
theorem formSmall_zero_kernel {a₀ r : ℝ} {j : Fin 4} {q : ℝ} {R : ℝ → ℂ} {η : ℝ} (hη : 0 ≤ η) :
    FormSmall a₀ r 0 j q R η := by
  intro g _ _ _ _ _ _ _ _ _ _ _ _ _ _
  rw [localProgressionForm_zero_kernel, norm_zero]; exact hη

/-- A failing residual test happens only at a cell of the kernel hull. -/
theorem kernelHull_of_not_formSmall {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ}
    {w : ℤ × ℤ → ℝ × ℝ → ℂ} {c : ℤ × ℤ} (hc : c ∈ dyadicFiniteTree G J N) {a₀ r : ℝ} {j : Fin 4}
    {q : ℝ} {R : ℝ → ℂ} {k : ℝ} (hns : ¬ FormSmall a₀ r (w c) j q R (Real.exp (-k))) :
    kernelHull G J N w c := by
  by_contra hT
  exact hns (by
    rw [eq_zero_of_not_kernelHull hc hT]; exact formSmall_zero_kernel (Real.exp_pos _).le)

/-- The data of one adaptive-fit construction. -/
structure FitSetup where
  /-- Dyadic grid used for the adaptive-fit construction. -/
  G : RealDyadicGrid
  /-- Root cell on which the adaptive-fit input is normalized. -/
  J : ℤ × ℤ
  /-- Number of dyadic generations available below the root. -/
  N : ℕ
  /-- Maximum number of fit columns available to an attempt. -/
  M : ℕ
  /-- Scalar input to be approximated by the adaptive fit. -/
  f : ℝ → ℂ
  /-- Local kernels assigned to the dyadic cells. -/
  w : ℤ × ℤ → ℝ × ℝ → ℂ
  /-- Position of the input in the four-linear local form. -/
  j : Fin 4
  /-- Integrability exponent used in the residual-smallness test. -/
  q : ℝ
  /-- Accuracy parameter giving the residual threshold `exp (-k)`. -/
  k : ℕ
  /-- Complexity exponent supplied to the fit oracle. -/
  c₂ : ℕ
  /-- Complexity budget supplied to the fit oracle. -/
  B : ℝ

namespace FitSetup
variable (S : FitSetup)

/-- The cell of an index. -/
noncomputable abbrev cell (c : ℤ × ℤ) : Set ℝ := dyadicGridCell S.G c.1 c.2

open scoped Classical in
/-- The input `1_J f` as an `L²` class. -/
noncomputable def input : Lp ℂ 2 (volume : Measure ℝ) :=
  if h : MemLp ((S.cell S.J).indicator S.f) 2 volume then h.toLp _ else 0

/-- The column input. -/
noncomputable def Z : ColumnL2 (Fin S.M) := physicalColumnInput S.input

/-- The pointwise physical fit at a cell. -/
noncomputable def phys (c : ℤ × ℤ) (a : ℕ → ℝ → ℂ) (n : ℕ) (y : ℝ) : ℂ :=
  fitPhys S.M (S.cell c) a n S.Z y

/-- The pointwise residual `f - g_I`. -/
noncomputable def res (c : ℤ × ℤ) (a : ℕ → ℝ → ℂ) (n : ℕ) (y : ℝ) : ℂ :=
  S.f y - S.phys c a n y

/-- The stopping predicate: the cell leaves the tree or the residual is small. -/
def P (c : ℤ × ℤ) (a : ℕ → ℝ → ℂ) (n : ℕ) : Prop :=
  c ∉ dyadicFiniteTree S.G S.J S.N ∨
    FormSmall (dyadicGridLeft S.G c.1 c.2) (dyadicGridLength S.G c.1) (S.w c) S.j S.q
      (S.res c a n) (Real.exp (-(S.k : ℝ)))

/-- The oracle. -/
noncomputable def O (c : ℤ × ℤ) (a : ℕ → ℝ → ℂ) (n : ℕ) : ℝ → ℂ :=
  fitOracleAtom S.c₂ S.B (dyadicGridLeft S.G c.1 c.2) (dyadicGridLength S.G c.1) (S.res c a n)

/-- Hypotheses on the data. -/
structure Hyp : Prop where
  f_meas : Measurable S.f
  f_norm_root : eLpNorm S.f 2
    (normalizedIntervalMeasure (dyadicGridLeft S.G S.J.1 S.J.2) (dyadicGridLength S.G S.J.1)) ≤ 1
  f_norm : ∀ c ∈ dyadicFiniteTree S.G S.J S.N, kernelHull S.G S.J S.N S.w c → eLpNorm S.f 2
    (normalizedIntervalMeasure (dyadicGridLeft S.G c.1 c.2) (dyadicGridLength S.G c.1)) ≤ 1
  B_pos : 0 < S.B
  detect : ∀ c a n, c ∈ dyadicFiniteTree S.G S.J S.N → Measurable (S.res c a n) →
    eLpNorm (S.res c a n) 2 (normalizedIntervalMeasure (dyadicGridLeft S.G c.1 c.2)
      (dyadicGridLength S.G c.1)) ≤ ENNReal.ofReal 2 →
    ¬ FormSmall (dyadicGridLeft S.G c.1 c.2) (dyadicGridLength S.G c.1) (S.w c) S.j S.q
      (S.res c a n) (Real.exp (-(S.k : ℝ))) →
    ∃ p, FitChartGood S.c₂ S.B (dyadicGridLeft S.G c.1 c.2) (dyadicGridLength S.G c.1)
      (S.res c a n) p

variable {S}

theorem tree_cell_subset {c : ℤ × ℤ} (hc : c ∈ dyadicFiniteTree S.G S.J S.N) :
    S.cell c ⊆ S.cell S.J :=
  ((dyadicFiniteTree_mem_iff S.G S.J c S.N).mp hc).1

theorem Hyp.memLp (h : S.Hyp) : MemLp ((S.cell S.J).indicator S.f) 2 volume := by
  refine (memLp_indicator_iff_restrict (dyadicGridCell_measurable _ _ _)).mpr ?_
  exact memLp_Ico_of_normalized (dyadicGridLength_pos S.G S.J.1)
    (ne_top_of_le_ne_top ENNReal.one_ne_top
      h.f_norm_root)

theorem Hyp.input_ae (h : S.Hyp) :
    (S.input : ℝ → ℂ) =ᵐ[volume] (S.cell S.J).indicator S.f := by
  unfold input
  simp only [h.memLp, ↓reduceDIte]
  exact MemLp.coeFn_toLp _

/-- The input energy on a cell inside the root is at most its length. -/
theorem Hyp.input_energy_le (h : S.Hyp) {c : ℤ × ℤ} (hc : c ∈ dyadicFiniteTree S.G S.J S.N)
    (hT : kernelHull S.G S.J S.N S.w c) :
    ∫ y in S.cell c, ‖(S.input : ℝ → ℂ) y‖ ^ 2 ≤ dyadicGridLength S.G c.1 := by
  have hs := dyadicGridCell_measurable S.G c.1 c.2
  have hr := dyadicGridLength_pos S.G c.1
  have heq : ∫ y in S.cell c, ‖(S.input : ℝ → ℂ) y‖ ^ 2 = ∫ y in S.cell c, ‖S.f y‖ ^ 2 := by
    refine setIntegral_congr_ae hs ?_
    filter_upwards [h.input_ae] with y hy hyc
    rw [hy, Set.indicator_of_mem (tree_cell_subset hc hyc)]
  have hn := h.f_norm c hc hT
  rw [← ENNReal.ofReal_one] at hn
  have hsq := sqrt_normalized_le_of_eLpNorm hr zero_le_one hn
  rw [Real.sqrt_le_iff] at hsq
  have h2 := hsq.2
  rw [one_pow, inv_mul_le_iff₀ hr, mul_one] at h2
  rw [heq]
  exact h2

theorem phys_measurable (c : ℤ × ℤ) (a : ℕ → ℝ → ℂ) (n : ℕ) : Measurable (S.phys c a n) :=
  fitPhys_measurable _ _ _ _ _

theorem Hyp.res_measurable (h : S.Hyp) (c : ℤ × ℤ) (a : ℕ → ℝ → ℂ) (n : ℕ) :
    Measurable (S.res c a n) :=
  h.f_meas.sub (phys_measurable c a n)

/-- The fit energy at a cell inside the root is at most its length. -/
theorem Hyp.fitProj_sq_le (h : S.Hyp) {c : ℤ × ℤ} (hc : c ∈ dyadicFiniteTree S.G S.J S.N)
    (hT : kernelHull S.G S.J S.N S.w c)
    (a : ℕ → ℝ → ℂ) (n : ℕ) :
    ∫ y in S.cell c, ‖(fitProj S.M (S.cell c) a n S.Z : ℝ → ColumnHilbert (Fin S.M)) y‖ ^ 2 ≤
      dyadicGridLength S.G c.1 := by
  have hs := dyadicGridCell_measurable S.G c.1 c.2
  calc _ ≤ ‖fitProj S.M (S.cell c) a n S.Z‖ ^ 2 := by
        rw [columnInput_norm_sq_integral]
        exact setIntegral_le_integral ((Lp.memLp _).integrable_norm_pow two_ne_zero)
          (Filter.Eventually.of_forall fun _ => by positivity)
    _ ≤ ∫ y in S.cell c, ‖(S.Z : ℝ → ColumnHilbert (Fin S.M)) y‖ ^ 2 := fitEnergy_le hs _ _ _
    _ = ∫ y in S.cell c, ‖(S.input : ℝ → ℂ) y‖ ^ 2 := integral_physical_sq _ _
    _ ≤ _ := h.input_energy_le hc hT

theorem Hyp.phys_sq_le (h : S.Hyp) {c : ℤ × ℤ} (hc : c ∈ dyadicFiniteTree S.G S.J S.N)
    (hT : kernelHull S.G S.J S.N S.w c)
    (a : ℕ → ℝ → ℂ) (n : ℕ) :
    ∫ y in S.cell c, ‖S.phys c a n y‖ ^ 2 ≤ dyadicGridLength S.G c.1 :=
  (setIntegral_fitPhys_sq_le S.M (dyadicGridCell_measurable _ _ _)
    (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_lt_top) a n S.Z).trans
    (h.fitProj_sq_le hc hT a n)

/-- The coefficient `ℓ²` norm is at most one. -/
theorem Hyp.coeffSq_le (h : S.Hyp) {c : ℤ × ℤ} (hc : c ∈ dyadicFiniteTree S.G S.J S.N)
    (hT : kernelHull S.G S.J S.N S.w c)
    (a : ℕ → ℝ → ℂ) (n : ℕ) : fitCoeffSq S.M (S.cell c) a n S.Z ≤ 1 := by
  have h1 := fitCoeffSq_le S.M (dyadicGridCell_measurable S.G c.1 c.2)
    (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_lt_top) a n S.Z
  have h2 := h.fitProj_sq_le hc hT a n
  rw [volume_real_cell] at h1
  have hL := dyadicGridLength_pos S.G c.1
  by_contra hlt
  push Not at hlt
  nlinarith

/-- The residual has normalized `L²` norm at most two. -/
theorem Hyp.res_eLpNorm_le (h : S.Hyp) {c : ℤ × ℤ} (hc : c ∈ dyadicFiniteTree S.G S.J S.N)
    (hT : kernelHull S.G S.J S.N S.w c)
    (a : ℕ → ℝ → ℂ) (n : ℕ) :
    eLpNorm (S.res c a n) 2 (normalizedIntervalMeasure (dyadicGridLeft S.G c.1 c.2)
      (dyadicGridLength S.G c.1)) ≤ ENNReal.ofReal 2 := by
  have hr := dyadicGridLength_pos S.G c.1
  have h1 : eLpNorm S.f 2 (normalizedIntervalMeasure (dyadicGridLeft S.G c.1 c.2)
      (dyadicGridLength S.G c.1)) ≤ ENNReal.ofReal 1 :=
    by rw [ENNReal.ofReal_one]; exact h.f_norm c hc hT
  have hmem : MemLp (S.phys c a n) 2 (volume.restrict (Set.Ico (dyadicGridLeft S.G c.1 c.2)
      (dyadicGridLeft S.G c.1 c.2 + dyadicGridLength S.G c.1))) := by
    have : IsFiniteMeasure (volume.restrict (S.cell c)) :=
      ⟨by rw [Measure.restrict_apply_univ, dyadicGridCell_volume]; exact ENNReal.ofReal_lt_top⟩
    exact MemLp.of_bound (phys_measurable c a n).aestronglyMeasurable
      (Real.sqrt (S.M * fitCoeffSq S.M (S.cell c) a n S.Z))
      (Filter.Eventually.of_forall fun y => Real.le_sqrt_of_sq_le
        (norm_fitPhys_sq_le _ _ _ _ _ y))
  have h2 : eLpNorm (S.phys c a n) 2 (normalizedIntervalMeasure (dyadicGridLeft S.G c.1 c.2)
      (dyadicGridLength S.G c.1)) ≤ ENNReal.ofReal 1 :=
    eLpNorm_normalized_le_of_integral hr hmem zero_le_one (by
      have := h.phys_sq_le hc hT a n
      simpa only [one_pow, one_mul, cell, dyadicGridCell] using this)
  calc eLpNorm (S.res c a n) 2 _ ≤ eLpNorm S.f 2 _ + eLpNorm (S.phys c a n) 2 _ :=
        eLpNorm_sub_le (by norm_num)
    _ ≤ ENNReal.ofReal 1 + ENNReal.ofReal 1 := add_le_add h1 h2
    _ = ENNReal.ofReal 2 := by
        rw [← ENNReal.ofReal_add zero_le_one zero_le_one]; norm_num

/-- The residual equals the fit residual almost everywhere on a cell inside the root. -/
theorem Hyp.res_ae (h : S.Hyp) {c : ℤ × ℤ} (hc : c ∈ dyadicFiniteTree S.G S.J S.N)
    (a : ℕ → ℝ → ℂ) (n : ℕ) :
    ∀ᵐ y ∂volume, y ∈ S.cell c → S.res c a n y = fitResid S.M (S.cell c) S.input a n y := by
  filter_upwards [h.input_ae, fitProj_none S.M (s := S.cell c) a n S.Z] with y h1 h2 hyc
  unfold res phys fitResid
  rw [h1, Set.indicator_of_mem (tree_cell_subset hc hyc), ← h2 hyc]
  rfl

/-- Blueprint §11.2, line 1577: the oracle inserts a bounded atom of residual correlation
`B⁻¹` on every failing cell. -/
theorem Hyp.oracle (h : S.Hyp) : FitOracle S.G S.M S.P S.O S.input S.B⁻¹ := by
  intro c a n _ hP
  simp only [P, not_or, not_not] at hP
  obtain ⟨hc, hns⟩ := hP
  obtain ⟨p, hgood, hO⟩ := fitOracleAtom_good
    (h.detect c a n hc (h.res_measurable c a n) (h.res_eLpNorm_le hc
      (kernelHull_of_not_formSmall hc hns) a n) hns)
  have hr := dyadicGridLength_pos S.G c.1
  have hOe : S.O c a n = quadraticChartAtom p.2 := hO
  refine ⟨⟨dyadicGridCell_measurable _ _ _,
    by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_lt_top,
    by rw [hOe]; exact quadraticChartAtom_measurable _, by rw [hOe]; exact hgood.2.1⟩, ?_⟩
  have hcorr := hgood.2.2
  rw [intervalIntegral_eq_cell hr.le] at hcorr
  have heq : ∫ x in Set.Ico (dyadicGridLeft S.G c.1 c.2)
      (dyadicGridLeft S.G c.1 c.2 + dyadicGridLength S.G c.1),
        S.res c a n x * conj (quadraticChartAtom p.2 x) =
      ∫ y in S.cell c, conj (S.O c a n y) * fitResid S.M (S.cell c) S.input a n y := by
    refine setIntegral_congr_ae (dyadicGridCell_measurable _ _ _) ?_
    filter_upwards [h.res_ae hc a n] with y hy hyc
    rw [hy hyc, hOe, mul_comm]
  rw [heq] at hcorr
  rw [le_inv_mul_iff₀ hr] at hcorr
  linarith

end FitSetup

/-! ### Ancestor chains, inherited lists and counts -/
theorem dyadicGridCell_subset_of_common_point (G : RealDyadicGrid) {c d : ℤ × ℤ} {x : ℝ}
    (hxc : x ∈ dyadicGridCell G c.1 c.2) (hxd : x ∈ dyadicGridCell G d.1 d.2)
    (hdc : d.1 ≤ c.1) : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 := by
  rcases dyadicGridCell_nested_or_disjoint_of_le G hdc d.2 c.2 with h | h
  · exact (Set.disjoint_left.mp h hxd hxc).elim
  · exact h

theorem dyadicGridCell_eq_of_common_point (G : RealDyadicGrid) {c d : ℤ × ℤ} {x : ℝ}
    (hxc : x ∈ dyadicGridCell G c.1 c.2) (hxd : x ∈ dyadicGridCell G d.1 d.2)
    (hdc : d.1 = c.1) : c = d := by
  have := dyadicGridCell_sameDepth_common_point G c.1 c.2 d.2 hxc (by rw [← hdc]; exact hxd)
  exact Prod.ext hdc.symm this

theorem dyadicParent_subset (G : RealDyadicGrid) (c : ℤ × ℤ) :
    dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G (dyadicParent G c).1 (dyadicParent G c).2 :=
  dyadicGridCell_subset_of_common_point G (dyadicGridCell_left_mem G c.1 c.2)
    (mem_dyadicIndex G (c.1 - 1) _) (by simp [dyadicParent])

/-- A strict ancestor contains the parent. -/
theorem dyadicParent_subset_of_subset (G : RealDyadicGrid) {c d : ℤ × ℤ}
    (h : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2) (hne : c ≠ d) :
    dyadicGridCell G (dyadicParent G c).1 (dyadicParent G c).2 ⊆ dyadicGridCell G d.1 d.2 := by
  have hlt := dyadicGridCell_depth_lt_of_subset_ne G c d h hne
  exact dyadicGridCell_subset_of_common_point G (mem_dyadicIndex G (c.1 - 1) _)
    (h (dyadicGridCell_left_mem G c.1 c.2)) (by simp [dyadicParent]; omega)

section FitTree
variable (G : RealDyadicGrid) (M : ℕ) (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop)
  (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ)

/-- `st` extends the list `st'`. -/
def FitPrefix (st st' : (ℕ → ℝ → ℂ) × ℕ) : Prop :=
  st'.2 ≤ st.2 ∧ ∀ i < st'.2, st.1 i = st'.1 i

theorem FitPrefix.refl (st : (ℕ → ℝ → ℂ) × ℕ) : FitPrefix st st := ⟨le_rfl, fun _ _ => rfl⟩

theorem FitPrefix.trans {st st' st'' : (ℕ → ℝ → ℂ) × ℕ} (h : FitPrefix st st')
    (h' : FitPrefix st' st'') : FitPrefix st st'' :=
  ⟨h'.1.trans h.1, fun i hi => (h.2 i (lt_of_lt_of_le hi h'.1)).trans (h'.2 i hi)⟩

theorem fitGreedy_fitPrefix {M : ℕ} {P : (ℕ → ℝ → ℂ) → ℕ → Prop}
    {O : (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ} (st : (ℕ → ℝ → ℂ) × ℕ) (hst : st.2 ≤ M) :
    FitPrefix (fitGreedy M P O st) st :=
  ⟨(fitGreedy_count st hst).1, fun _ hi => fitGreedy_prefix st hst hi⟩

/-- Every atom of the greedy fit satisfies a property preserved by the oracle. -/
theorem fitGreedy_inv {M : ℕ} {P : (ℕ → ℝ → ℂ) → ℕ → Prop} {O : (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ}
    (Good : (ℝ → ℂ) → Prop) (hO : ∀ a n, n < M → ¬ P a n → Good (O a n))
    (st : (ℕ → ℝ → ℂ) × ℕ) (h : ∀ i < st.2, Good (st.1 i)) :
    ∀ i < (fitGreedy M P O st).2, Good ((fitGreedy M P O st).1 i) := by
  unfold fitGreedy
  suffices H : ∀ t, ∀ i < ((fitStep M P O)^[t] st).2, Good (((fitStep M P O)^[t] st).1 i) from
    H M
  intro t
  induction t with
  | zero => exact h
  | succ t ih =>
    rw [Function.iterate_succ_apply']
    set s := (fitStep M P O)^[t] st
    rcases fitStep_count (M := M) (P := P) (O := O) s with he | ⟨hn, hP, he⟩
    · rw [he]; exact ih
    · rw [he]
      intro i hi
      simp only at hi ⊢
      by_cases his : i = s.2
      · subst his; rw [Function.update_self]; exact hO _ _ hn hP
      · rw [Function.update_of_ne his]; exact ih i (by omega)

theorem fitState_inv (Good : (ℝ → ℂ) → Prop) (hO : ∀ c a n, n < M → ¬ P c a n → Good (O c a n))
    (d : ℕ) (c : ℤ × ℤ) :
    ∀ i < (fitState G M P O d c).2, Good ((fitState G M P O d c).1 i) := by
  induction d generalizing c with
  | zero => exact fitGreedy_inv Good (hO c) _ (fun i hi => absurd hi (Nat.not_lt_zero _))
  | succ d ih => exact fitGreedy_inv Good (hO c) _ (ih _)

/-- Along an ancestor chain, the deeper state extends the shallower one. -/
theorem fitState_fitPrefix (d : ℕ) (c' : ℤ × ℤ) :
    ∀ e : ℕ, ∀ c : ℤ × ℤ, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G c'.1 c'.2 →
      c.1 = c'.1 + e → FitPrefix (fitState G M P O (d + e) c) (fitState G M P O d c') := by
  intro e
  induction e with
  | zero =>
    intro c hc he
    have : c = c' := dyadicGridCell_eq_of_common_point G (dyadicGridCell_left_mem G c.1 c.2)
      (hc (dyadicGridCell_left_mem G c.1 c.2)) (by omega)
    subst this
    exact FitPrefix.refl _
  | succ e ih =>
    intro c hc he
    have hne : c ≠ c' := by intro h; subst h; omega
    have hp := ih (dyadicParent G c) (dyadicParent_subset_of_subset G hc hne)
      (by simp [dyadicParent]; omega)
    have hgr : fitState G M P O (d + (e + 1)) c =
        fitGreedy M (P c) (O c) (fitState G M P O (d + e) (dyadicParent G c)) := rfl
    rw [hgr]
    exact (fitGreedy_fitPrefix _ (fitState_count_le G M P O _ _)).trans hp

open scoped Classical in
/-- The count at a cell is the ancestor sum of the insertion counts within its attempt. -/
theorem fitState_count_eq_ancestorSum (K : ℤ × ℤ) (L : ℕ) :
    ∀ d : ℕ, ∀ c : ℤ × ℤ, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G K.1 K.2 →
      c.1 = K.1 + d → d ≤ L →
      ((fitState G M P O d c).2 : ℝ) = dyadicAncestorSum G (dyadicFiniteTree G K L)
        (fun c' => (fitNew G M P O (c'.1 - K.1).toNat c' : ℝ)) c := by
  intro d
  induction d with
  | zero =>
    intro c hc he _
    have hcK : c = K := dyadicGridCell_eq_of_common_point G (dyadicGridCell_left_mem G c.1 c.2)
      (hc (dyadicGridCell_left_mem G c.1 c.2)) (by omega)
    subst hcK
    have hfilt : (dyadicFiniteTree G c L).filter (fun d' =>
        dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d'.1 d'.2) = {c} := by
      ext d'
      simp only [Finset.mem_filter, Finset.mem_singleton]
      constructor
      · rintro ⟨hd', hcd⟩
        have := ((dyadicFiniteTree_mem_iff G c d' L).mp hd').1
        exact (dyadicGridCell_injective G (Set.Subset.antisymm this hcd))
      · rintro rfl
        exact ⟨dyadicFiniteTree_root_mem G d' L, le_rfl⟩
    unfold dyadicAncestorSum
    rw [hfilt, Finset.sum_singleton, sub_self]
    simp only [Int.toNat_zero, fitNew, fitInherited, Nat.sub_zero]
  | succ d ih =>
    intro c hc he hdL
    set p := dyadicParent G c with hp
    have hcp := dyadicParent_subset G c
    have hpK : dyadicGridCell G p.1 p.2 ⊆ dyadicGridCell G K.1 K.2 :=
      dyadicGridCell_subset_of_common_point G (hcp (dyadicGridCell_left_mem G c.1 c.2))
        (hc (dyadicGridCell_left_mem G c.1 c.2)) (by simp [hp, dyadicParent]; omega)
    have hpe : p.1 = K.1 + d := by simp [hp, dyadicParent]; omega
    have hih := ih p hpK hpe (by omega)
    have hcT : c ∈ dyadicFiniteTree G K L :=
      (dyadicFiniteTree_mem_iff G K c L).mpr ⟨hc, by omega⟩
    have hfilt : (dyadicFiniteTree G K L).filter (fun d' =>
        dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d'.1 d'.2) =
        insert c ((dyadicFiniteTree G K L).filter (fun d' =>
          dyadicGridCell G p.1 p.2 ⊆ dyadicGridCell G d'.1 d'.2)) := by
      ext d'
      simp only [Finset.mem_filter, Finset.mem_insert]
      constructor
      · rintro ⟨hd', hcd⟩
        by_cases hdc : d' = c
        · exact Or.inl hdc
        · exact Or.inr ⟨hd', dyadicParent_subset_of_subset G hcd (Ne.symm hdc)⟩
      · rintro (rfl | ⟨hd', hpd⟩)
        · exact ⟨hcT, le_rfl⟩
        · exact ⟨hd', hcp.trans hpd⟩
    have hnot : c ∉ (dyadicFiniteTree G K L).filter (fun d' =>
        dyadicGridCell G p.1 p.2 ⊆ dyadicGridCell G d'.1 d'.2) := by
      intro hm
      have hpc := (Finset.mem_filter.mp hm).2
      have := dyadicGridCell_injective G (Set.Subset.antisymm hcp hpc)
      have h1 : c.1 = p.1 := congrArg Prod.fst this
      omega
    unfold dyadicAncestorSum at hih ⊢
    rw [hfilt, Finset.sum_insert hnot, ← hih]
    have htn : (c.1 - K.1).toNat = d + 1 := by omega
    rw [htn]
    have hadd := fitNew_add G M P O (d + 1) c
    have hinh : fitInherited G M P O (d + 1) c = fitState G M P O d p := rfl
    rw [hinh] at hadd
    rw [hadd]
    push_cast
    ring

open scoped Classical in
/-- The weighted insertion mass of an attempt is at most `4/ρ²` times the input energy. -/
theorem fitWeightedMass_le (f : Lp ℂ 2 (volume : Measure ℝ)) {ρ : ℝ} (hρ : 0 ≤ ρ)
    (horacle : FitOracle G M P O f ρ) (K : ℤ × ℤ) (L : ℕ) :
    ρ ^ 2 / 4 * dyadicWeightedMass G (dyadicFiniteTree G K L)
        (fun c' => (fitNew G M P O (c'.1 - K.1).toNat c' : ℝ)) ≤
      ∫ y in dyadicGridCell G K.1 K.2, ‖(f : ℝ → ℂ) y‖ ^ 2 := by
  have hdisj : ((Finset.range (L + 1) : Finset ℕ) : Set ℕ).PairwiseDisjoint
      (dyadicGeneration G K) := by
    intro k _ k' _ hkk
    refine Finset.disjoint_left.mpr fun c hc hc' => hkk ?_
    have h1 := dyadicGeneration_depth G K k hc
    have h2 := dyadicGeneration_depth G K k' hc'
    omega
  have hmass : ρ ^ 2 / 4 * dyadicWeightedMass G (dyadicFiniteTree G K L)
      (fun c' => (fitNew G M P O (c'.1 - K.1).toNat c' : ℝ)) =
      ∑ k ∈ Finset.range (L + 1), ∑ c ∈ dyadicGeneration G K k,
        ρ ^ 2 * dyadicGridLength G c.1 / 4 * fitNew G M P O k c := by
    unfold dyadicWeightedMass dyadicFiniteTree
    rw [Finset.sum_biUnion hdisj, Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun c hc => ?_
    have h1 := dyadicGeneration_depth G K k hc
    have : (c.1 - K.1).toNat = k := by omega
    simp only [this]; ring
  rw [hmass]
  exact (fitEnergy_telescope G M P O f hρ horacle K L).trans
    (fitEnergy_generation_le G M f K L _)

end FitTree

/-! ### Greedy attempts with restarts on a finite tree -/

/-- A greedy attempt structure: per-cell greedy insertion with predicate `P` and oracle `O`,
inherited along each attempt (`fitState`), with integrated insertion mass at most `A |K|` on every
attempt root `K` (blueprint sec:reduction, lines 429-451; §11.2, line 1577). -/
structure GreedyTree where
  /-- Dyadic grid supporting the greedy attempts and restarts. -/
  G : RealDyadicGrid
  /-- Initial root cell for the greedy construction. -/
  J : ℤ × ℤ
  /-- Number of dyadic generations below the initial root. -/
  N : ℕ
  /-- Maximum number of insertions available in one greedy state. -/
  M : ℕ
  /-- Predicate deciding when an insertion attempt stops. -/
  P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop
  /-- Oracle producing a new atom when the stopping predicate fails. -/
  O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ
  /-- Integrated insertion-mass bound per unit length of an attempt root. -/
  A : ℝ

namespace GreedyTree
variable (S : GreedyTree)

/-- The cell of an index. -/
noncomputable abbrev cell (c : ℤ × ℤ) : Set ℝ := dyadicGridCell S.G c.1 c.2

/-- The state of the attempt `d` generations below its root. -/
noncomputable def state (d : ℕ) (c : ℤ × ℤ) : (ℕ → ℝ → ℂ) × ℕ := fitState S.G S.M S.P S.O d c

/-- Insertion counts of the attempt rooted at `K`. -/
noncomputable def newAt (K c : ℤ × ℤ) : ℝ := (fitNew S.G S.M S.P S.O (c.1 - K.1).toNat c : ℝ)

/-- The first-crossing threshold `A / (1/4)`. -/
noncomputable def T : ℝ := S.A / (1 / 4)

/-- The finite tree below `K`. -/
noncomputable def sub (K : ℤ × ℤ) : Finset (ℤ × ℤ) :=
  dyadicFiniteTree S.G K (dyadicRemainingDepth S.J S.N K)

/-- The roots of the next attempts below `K`: the first crossings of the path count. -/
noncomputable def next (K : ℤ × ℤ) : Finset (ℤ × ℤ) :=
  dyadicFirstCrossings S.G (S.sub K) (S.newAt K) S.T

/-- Restart generations. -/
noncomputable def gen : ℕ → Finset (ℤ × ℤ)
  | 0 => {S.J}
  | n + 1 => (gen n).biUnion S.next

/-- All attempt roots. -/
noncomputable def roots : Finset (ℤ × ℤ) := (Finset.range (S.N + 1)).biUnion S.gen

/-- Hypotheses: nonnegative mass constant, the mass bound, and trivial stopping off the tree. -/
structure Hyp : Prop where
  A_nonneg : 0 ≤ S.A
  mass : ∀ K ∈ dyadicFiniteTree S.G S.J S.N,
    dyadicWeightedMass S.G (S.sub K) (S.newAt K) ≤ S.A * dyadicGridLength S.G K.1
  escape : ∀ c a n, c ∉ dyadicFiniteTree S.G S.J S.N → S.P c a n

variable {S}

theorem newAt_nonneg (K c : ℤ × ℤ) : 0 ≤ S.newAt K c := Nat.cast_nonneg _

theorem sub_mem_iff {K : ℤ × ℤ} (hK : K ∈ dyadicFiniteTree S.G S.J S.N) (c : ℤ × ℤ) :
    c ∈ S.sub K ↔ c ∈ dyadicFiniteTree S.G S.J S.N ∧ S.cell c ⊆ S.cell K :=
  dyadicFiniteTree_below_iff S.G S.J S.N hK c

theorem cell_subset_of_tree {c : ℤ × ℤ} (hc : c ∈ dyadicFiniteTree S.G S.J S.N) :
    S.cell c ⊆ S.cell S.J :=
  ((dyadicFiniteTree_mem_iff S.G S.J c S.N).mp hc).1

theorem Hyp.next_length_le (h : S.Hyp) {K : ℤ × ℤ} (hK : K ∈ dyadicFiniteTree S.G S.J S.N) :
    dyadicRootLength S.G (S.next K) ≤ 1 / 4 * dyadicGridLength S.G K.1 :=
  dyadicFirstCrossings_cost S.G (S.sub K) (S.newAt K) (fun c _ => newAt_nonneg K c) K
    (fun c hc => ((dyadicFiniteTree_mem_iff S.G K c _).mp hc).1) (by norm_num) (by norm_num)
    (h.mass K hK)

theorem count_eq_ancestorSum {K c : ℤ × ℤ} (hc : c ∈ S.sub K) :
    ((S.state (c.1 - K.1).toNat c).2 : ℝ) = dyadicAncestorSum S.G (S.sub K) (S.newAt K) c := by
  have hm := (dyadicFiniteTree_mem_iff S.G K c _).mp hc
  have hle := dyadicGridCell_depth_le_of_subset S.G c K hm.1
  exact fitState_count_eq_ancestorSum S.G S.M S.P S.O K _ _ c hm.1 (by omega) (by omega)

theorem Hyp.next_depth (h : S.Hyp) {K b : ℤ × ℤ} (hK : K ∈ dyadicFiniteTree S.G S.J S.N)
    (hb : b ∈ S.next K) : K.1 < b.1 ∧ S.cell b ⊆ S.cell K := by
  obtain ⟨hbS, hbad⟩ := dyadicFirstCrossings_mem S.G _ _ _ hb
  have hbK := ((dyadicFiniteTree_mem_iff S.G K b _).mp hbS).1
  refine ⟨dyadicGridCell_depth_lt_of_subset_ne S.G b K hbK ?_, hbK⟩
  rintro rfl
  have hKS : b ∈ S.sub b := dyadicFiniteTree_root_mem S.G b _
  rw [← count_eq_ancestorSum hKS] at hbad
  have hcnt : ((S.state (b.1 - b.1).toNat b).2 : ℝ) = S.newAt b b := by
    simp only [sub_self, Int.toNat_zero, state, newAt, fitNew, fitInherited, Nat.sub_zero]
  rw [hcnt] at hbad
  have hmass := h.mass b hK
  have hsingle : dyadicGridLength S.G b.1 * S.newAt b b ≤
      dyadicWeightedMass S.G (S.sub b) (S.newAt b) :=
    Finset.single_le_sum (f := fun c => dyadicGridLength S.G c.1 * S.newAt b c)
      (fun c _ => mul_nonneg (dyadicGridLength_pos S.G c.1).le (newAt_nonneg b c)) hKS
  have hL := dyadicGridLength_pos S.G b.1
  have h4 : S.newAt b b ≤ S.A := by
    by_contra hc
    push Not at hc
    nlinarith
  have hT : S.T = 4 * S.A := by unfold T; ring
  rw [hT] at hbad
  linarith [h.A_nonneg]

theorem Hyp.gen_mem (h : S.Hyp) (n : ℕ) {c : ℤ × ℤ} (hc : c ∈ S.gen n) :
    c ∈ dyadicFiniteTree S.G S.J S.N ∧ S.J.1 + n ≤ c.1 := by
  induction n generalizing c with
  | zero =>
    have : c = S.J := by simpa only [gen, Finset.mem_singleton] using hc
    subst this
    exact ⟨dyadicFiniteTree_root_mem _ _ _, by simp⟩
  | succ n ih =>
    obtain ⟨K, hK, hcK⟩ := Finset.mem_biUnion.mp hc
    obtain ⟨hKT, hKd⟩ := ih hK
    have hd := h.next_depth hKT hcK
    have hcS := (dyadicFirstCrossings_mem S.G _ _ _ hcK).1
    refine ⟨((sub_mem_iff hKT c).mp hcS).1, ?_⟩
    push_cast
    omega

theorem Hyp.gen_length_le (h : S.Hyp) (n : ℕ) :
    dyadicRootLength S.G (S.gen n) ≤ (1 / 4 : ℝ) ^ n * dyadicGridLength S.G S.J.1 := by
  induction n with
  | zero => simp [gen, dyadicRootLength]
  | succ n ih =>
    calc dyadicRootLength S.G (S.gen (n + 1))
        ≤ ∑ K ∈ S.gen n, dyadicRootLength S.G (S.next K) :=
          finite_union_weight_le _ _ _ fun c => (dyadicGridLength_pos S.G c.1).le
      _ ≤ ∑ K ∈ S.gen n, 1 / 4 * dyadicGridLength S.G K.1 :=
          Finset.sum_le_sum fun K hK => h.next_length_le (h.gen_mem n hK).1
      _ = 1 / 4 * dyadicRootLength S.G (S.gen n) := by rw [dyadicRootLength, Finset.mul_sum]
      _ ≤ 1 / 4 * ((1 / 4 : ℝ) ^ n * dyadicGridLength S.G S.J.1) := by gcongr
      _ = _ := by ring

/-- The restarted segments have total root length at most `4/3 |J|`. -/
theorem Hyp.roots_length_le (h : S.Hyp) :
    dyadicRootLength S.G S.roots ≤ 4 / 3 * dyadicGridLength S.G S.J.1 := by
  have hL := dyadicGridLength_pos S.G S.J.1
  calc dyadicRootLength S.G S.roots
      ≤ ∑ n ∈ Finset.range (S.N + 1), dyadicRootLength S.G (S.gen n) :=
        finite_union_weight_le _ _ _ fun c => (dyadicGridLength_pos S.G c.1).le
    _ ≤ ∑ n ∈ Finset.range (S.N + 1), (1 / 4 : ℝ) ^ n * dyadicGridLength S.G S.J.1 :=
        Finset.sum_le_sum fun n _ => h.gen_length_le n
    _ = (∑ n ∈ Finset.Ico 0 (S.N + 1), (1 / 4 : ℝ) ^ n) * dyadicGridLength S.G S.J.1 := by
        rw [Finset.sum_mul, Finset.range_eq_Ico]
    _ ≤ ((1 / 4 : ℝ) ^ 0 / (1 - 1 / 4)) * dyadicGridLength S.G S.J.1 := by
        gcongr
        exact geom_sum_Ico_le_of_lt_one (by norm_num) (by norm_num)
    _ = 4 / 3 * dyadicGridLength S.G S.J.1 := by norm_num

theorem J_mem_roots : S.J ∈ S.roots :=
  Finset.mem_biUnion.mpr ⟨0, Finset.mem_range.mpr (by omega), Finset.mem_singleton_self _⟩

theorem Hyp.roots_mem (h : S.Hyp) {K : ℤ × ℤ} (hK : K ∈ S.roots) :
    K ∈ dyadicFiniteTree S.G S.J S.N := by
  obtain ⟨n, _, hn⟩ := Finset.mem_biUnion.mp hK
  exact (h.gen_mem n hn).1

theorem Hyp.roots_closed (h : S.Hyp) {K b : ℤ × ℤ} (hK : K ∈ S.roots) (hb : b ∈ S.next K) :
    b ∈ S.roots := by
  obtain ⟨n, _, hn⟩ := Finset.mem_biUnion.mp hK
  have hbn : b ∈ S.gen (n + 1) := Finset.mem_biUnion.mpr ⟨K, hn, hb⟩
  obtain ⟨hbT, hbd⟩ := h.gen_mem (n + 1) hbn
  have hup := ((dyadicFiniteTree_mem_iff S.G S.J b S.N).mp hbT).2
  exact Finset.mem_biUnion.mpr ⟨n + 1, Finset.mem_range.mpr (by push_cast at hbd; omega), hbn⟩

theorem Hyp.segment_exists (h : S.Hyp) {u : ℤ × ℤ} (hu : u ∈ dyadicFiniteTree S.G S.J S.N) :
    ∃ K ∈ S.roots, S.cell u ⊆ S.cell K ∧ (∀ b ∈ S.next K, ¬ S.cell u ⊆ S.cell b) ∧
      ∀ L ∈ S.roots, S.cell u ⊆ S.cell L → L.1 ≤ K.1 := by
  classical
  let A := S.roots.filter (fun K : ℤ × ℤ => S.cell u ⊆ S.cell K)
  have hA : A.Nonempty := ⟨S.J, Finset.mem_filter.mpr ⟨J_mem_roots, cell_subset_of_tree hu⟩⟩
  obtain ⟨K, hK, hmax⟩ := A.exists_max_image (fun c => c.1) hA
  obtain ⟨hKr, huK⟩ := Finset.mem_filter.mp hK
  refine ⟨K, hKr, huK, fun b hb hub => ?_, fun L hL huL =>
    hmax L (Finset.mem_filter.mpr ⟨hL, huL⟩)⟩
  have hbr := h.roots_closed hKr hb
  have hle := hmax b (Finset.mem_filter.mpr ⟨hbr, hub⟩)
  have hlt := (h.next_depth (h.roots_mem hKr) hb).1
  omega

variable (S)

open scoped Classical in
/-- The root of the segment containing a tree cell: its deepest attempt root. -/
noncomputable def seg (u : ℤ × ℤ) : ℤ × ℤ :=
  if h : u ∈ dyadicFiniteTree S.G S.J S.N ∧ S.Hyp then Classical.choose (h.2.segment_exists h.1)
  else u

/-- The depth of a cell below its segment root. -/
noncomputable def depthIn (u : ℤ × ℤ) : ℕ := (u.1 - (S.seg u).1).toNat

/-- The final state at a cell. -/
noncomputable def st (u : ℤ × ℤ) : (ℕ → ℝ → ℂ) × ℕ := S.state (S.depthIn u) u

variable {S}

theorem Hyp.seg_spec (h : S.Hyp) {u : ℤ × ℤ} (hu : u ∈ dyadicFiniteTree S.G S.J S.N) :
    S.seg u ∈ S.roots ∧ S.cell u ⊆ S.cell (S.seg u) ∧
      (∀ b ∈ S.next (S.seg u), ¬ S.cell u ⊆ S.cell b) ∧
      ∀ L ∈ S.roots, S.cell u ⊆ S.cell L → L.1 ≤ (S.seg u).1 := by
  have hc : u ∈ dyadicFiniteTree S.G S.J S.N ∧ S.Hyp := ⟨hu, h⟩
  have e : S.seg u = Classical.choose (hc.2.segment_exists hc.1) := by
    unfold seg; simp only [hc, and_self, ↓reduceDIte]
  rw [e]
  exact Classical.choose_spec (hc.2.segment_exists hc.1)

/-- On every tree cell the greedy stopped below the cap, so the predicate holds. -/
theorem Hyp.retained (h : S.Hyp) (hM : S.T < S.M) {u : ℤ × ℤ}
    (hu : u ∈ dyadicFiniteTree S.G S.J S.N) :
    (S.st u).2 < S.M ∧ S.P u (S.st u).1 (S.st u).2 := by
  classical
  obtain ⟨hKr, huK, hnext, _⟩ := h.seg_spec hu
  have hKT := h.roots_mem hKr
  have husub : u ∈ S.sub (S.seg u) := (sub_mem_iff hKT u).mpr ⟨hu, huK⟩
  have hret : u ∈ dyadicRetainedCells S.G (S.sub (S.seg u)) (S.newAt (S.seg u)) S.T :=
    (dyadicRetainedCells_iff S.G _ _ (fun c _ => newAt_nonneg _ c) S.T u).mpr
      ⟨husub, fun ⟨b, hb, hub⟩ => hnext b hb hub⟩
  have hle := (Finset.mem_filter.mp hret).2
  rw [← count_eq_ancestorSum husub] at hle
  have hlt : (S.st u).2 < S.M := by
    have : ((S.st u).2 : ℝ) < S.M := lt_of_le_of_lt hle hM
    exact_mod_cast this
  refine ⟨hlt, ?_⟩
  have hgr : S.st u = fitGreedy S.M (S.P u) (S.O u)
      (fitInherited S.G S.M S.P S.O (S.depthIn u) u) := fitState_eq_greedy _ _ _ _ _ _
  have hfin := fitGreedy_final (M := S.M) (P := S.P u) (O := S.O u)
    (fitInherited S.G S.M S.P S.O (S.depthIn u) u) (fitInherited_count_le _ _ _ _ _ _)
  rw [← hgr] at hfin
  rcases hfin with hP | hcap
  · exact hP
  · omega

end GreedyTree

namespace GreedyTree
variable {S : GreedyTree}

/-! ### Tuple-specific accurate high fits -/

/-- A cell between a tree cell and its segment root has the same segment root. -/
theorem Hyp.seg_between (h : S.Hyp) {u v : ℤ × ℤ} (hu : u ∈ dyadicFiniteTree S.G S.J S.N)
    (hv : v ∈ dyadicFiniteTree S.G S.J S.N) (huv : S.cell u ⊆ S.cell v)
    (hvs : S.cell v ⊆ S.cell (S.seg u)) : S.seg v = S.seg u := by
  obtain ⟨hr, hus, -, hmax⟩ := h.seg_spec hu
  obtain ⟨hr', hvs', -, hmax'⟩ := h.seg_spec hv
  have h1 := hmax' _ hr hvs
  have h2 := hmax _ hr' (huv.trans hvs')
  have hx := dyadicGridCell_left_mem S.G u.1 u.2
  exact (dyadicGridCell_eq_of_common_point S.G (hus hx) (hvs' (huv hx)) (by omega)).symm

end GreedyTree

namespace FitSetup
variable (S : FitSetup)

/-! ### Restarts and segments of the adaptive fit -/

/-- The adaptive fit is the general restart construction with insertion mass `4 B²`. -/
noncomputable def toGreedyTree : GreedyTree where
  G := S.G
  J := S.J
  N := S.N
  M := S.M
  P := S.P
  O := S.O
  A := 4 * S.B ^ 2

/-- The state of the attempt `d` generations below its root. -/
noncomputable def state (d : ℕ) (c : ℤ × ℤ) : (ℕ → ℝ → ℂ) × ℕ := fitState S.G S.M S.P S.O d c

/-- Insertion counts of the attempt rooted at `K`. -/
noncomputable def newAt (K c : ℤ × ℤ) : ℝ := (fitNew S.G S.M S.P S.O (c.1 - K.1).toNat c : ℝ)

/-- The first-crossing threshold `(4 B²)/(1/4)`. -/
noncomputable def T : ℝ := 4 * S.B ^ 2 / (1 / 4)

/-- The finite tree below `K`. -/
noncomputable def sub (K : ℤ × ℤ) : Finset (ℤ × ℤ) :=
  dyadicFiniteTree S.G K (dyadicRemainingDepth S.J S.N K)

/-- The roots of the next attempts below `K`: the first crossings of the path count. -/
noncomputable def next (K : ℤ × ℤ) : Finset (ℤ × ℤ) :=
  dyadicFirstCrossings S.G (S.sub K) (S.newAt K) S.T

/-- Restart generations. -/
noncomputable def gen : ℕ → Finset (ℤ × ℤ) := S.toGreedyTree.gen

/-- All attempt roots. -/
noncomputable def roots : Finset (ℤ × ℤ) :=
  S.toGreedyTree.roots

variable {S}

theorem newAt_nonneg (K c : ℤ × ℤ) : 0 ≤ S.newAt K c := Nat.cast_nonneg _

theorem sub_mem_iff {K : ℤ × ℤ} (hK : K ∈ dyadicFiniteTree S.G S.J S.N) (c : ℤ × ℤ) :
    c ∈ S.sub K ↔ c ∈ dyadicFiniteTree S.G S.J S.N ∧ S.cell c ⊆ S.cell K :=
  dyadicFiniteTree_below_iff S.G S.J S.N hK c

theorem cell_subset_of_tree {c : ℤ × ℤ} (hc : c ∈ dyadicFiniteTree S.G S.J S.N) :
    S.cell c ⊆ S.cell S.J :=
  ((dyadicFiniteTree_mem_iff S.G S.J c S.N).mp hc).1

theorem T_eq : S.T = 16 * S.B ^ 2 := by unfold T; ring

/-- The weighted insertion mass of the attempt at `K` is at most `4 B² |K|`. -/
theorem Hyp.mass_le (h : S.Hyp) {K : ℤ × ℤ} (hK : K ∈ dyadicFiniteTree S.G S.J S.N) :
    dyadicWeightedMass S.G (S.sub K) (S.newAt K) ≤ 4 * S.B ^ 2 * dyadicGridLength S.G K.1 := by
  have hm := fitWeightedMass_le S.G S.M S.P S.O S.input (inv_nonneg.mpr h.B_pos.le) h.oracle K
    (dyadicRemainingDepth S.J S.N K)
  by_cases hT : ¬ kernelHull S.G S.J S.N S.w K
  · -- no insertions below a cell outside the kernel hull
    have h0 : dyadicWeightedMass S.G (S.sub K) (S.newAt K) = 0 := by
      unfold dyadicWeightedMass
      refine Finset.sum_eq_zero fun c hc => ?_
      have hc' := (sub_mem_iff hK c).mp hc
      have hP : ∀ a n, S.P c a n := fun a n => Or.inr (by
        rw [eq_zero_of_not_kernelHull hc'.1 fun hc'' => hT (hc''.mono hc'.2)]
        exact formSmall_zero_kernel (Real.exp_pos _).le)
      unfold newAt
      rw [fitNew_eq_zero_of_P S.G S.M S.P S.O _ c hP]; simp
    rw [h0]; have := dyadicGridLength_pos S.G K.1; have := h.B_pos; positivity
  push Not at hT
  have he := h.input_energy_le hK hT
  have hB := h.B_pos
  have hmass : dyadicWeightedMass S.G (S.sub K) (S.newAt K) =
      dyadicWeightedMass S.G (dyadicFiniteTree S.G K (dyadicRemainingDepth S.J S.N K))
        (fun c' => (fitNew S.G S.M S.P S.O (c'.1 - K.1).toNat c' : ℝ)) := rfl
  rw [hmass]
  set W := dyadicWeightedMass S.G (dyadicFiniteTree S.G K (dyadicRemainingDepth S.J S.N K))
    (fun c' => (fitNew S.G S.M S.P S.O (c'.1 - K.1).toNat c' : ℝ))
  have h1 : (S.B⁻¹) ^ 2 / 4 * W ≤ dyadicGridLength S.G K.1 := hm.trans he
  have h2 : W = 4 * S.B ^ 2 * ((S.B⁻¹) ^ 2 / 4 * W) := by field_simp
  rw [h2]
  exact mul_le_mul_of_nonneg_left h1 (by positivity)

/-- Analytic fit hypotheses supply the three hypotheses of the general restart theorem. -/
theorem Hyp.toGreedyTree (h : S.Hyp) : S.toGreedyTree.Hyp where
  A_nonneg := by dsimp [FitSetup.toGreedyTree]; positivity
  mass := fun _ hK => h.mass_le hK
  escape := fun _ _ _ hout => Or.inl hout

/-- Blueprint §11.2, line 1577: the first stopped roots cost at most a quarter of the root. -/
theorem Hyp.next_length_le (h : S.Hyp) {K : ℤ × ℤ} (hK : K ∈ dyadicFiniteTree S.G S.J S.N) :
    dyadicRootLength S.G (S.next K) ≤ 1 / 4 * dyadicGridLength S.G K.1 :=
  h.toGreedyTree.next_length_le hK

/-- The count at a cell of the attempt at `K` equals its ancestor sum. -/
theorem count_eq_ancestorSum {K c : ℤ × ℤ} (hc : c ∈ S.sub K) :
    ((S.state (c.1 - K.1).toNat c).2 : ℝ) = dyadicAncestorSum S.G (S.sub K) (S.newAt K) c :=
  S.toGreedyTree.count_eq_ancestorSum hc

/-- Next roots are strictly below their attempt root. -/
theorem Hyp.next_depth (h : S.Hyp) {K b : ℤ × ℤ} (hK : K ∈ dyadicFiniteTree S.G S.J S.N)
    (hb : b ∈ S.next K) : K.1 < b.1 ∧ S.cell b ⊆ S.cell K :=
  h.toGreedyTree.next_depth hK hb

theorem Hyp.gen_mem (h : S.Hyp) (n : ℕ) {c : ℤ × ℤ} (hc : c ∈ S.gen n) :
    c ∈ dyadicFiniteTree S.G S.J S.N ∧ S.J.1 + n ≤ c.1 :=
  h.toGreedyTree.gen_mem n hc

theorem Hyp.gen_length_le (h : S.Hyp) (n : ℕ) :
    dyadicRootLength S.G (S.gen n) ≤ (1 / 4 : ℝ) ^ n * dyadicGridLength S.G S.J.1 :=
  h.toGreedyTree.gen_length_le n

/-- Blueprint §11.2, line 1577: the restarted segments have total root length at most
`4/3 |J|`. -/
theorem Hyp.roots_length_le (h : S.Hyp) :
    dyadicRootLength S.G S.roots ≤ 4 / 3 * dyadicGridLength S.G S.J.1 :=
  h.toGreedyTree.roots_length_le

theorem J_mem_roots : S.J ∈ S.roots :=
  S.toGreedyTree.J_mem_roots

theorem Hyp.roots_mem (h : S.Hyp) {K : ℤ × ℤ} (hK : K ∈ S.roots) :
    K ∈ dyadicFiniteTree S.G S.J S.N :=
  h.toGreedyTree.roots_mem hK

theorem Hyp.roots_closed (h : S.Hyp) {K b : ℤ × ℤ} (hK : K ∈ S.roots) (hb : b ∈ S.next K) :
    b ∈ S.roots :=
  h.toGreedyTree.roots_closed hK hb

/-- Every tree cell lies in the segment of its deepest root. -/
theorem Hyp.segment_exists (h : S.Hyp) {u : ℤ × ℤ} (hu : u ∈ dyadicFiniteTree S.G S.J S.N) :
    ∃ K ∈ S.roots, S.cell u ⊆ S.cell K ∧ (∀ b ∈ S.next K, ¬ S.cell u ⊆ S.cell b) ∧
      ∀ L ∈ S.roots, S.cell u ⊆ S.cell L → L.1 ≤ K.1 :=
  h.toGreedyTree.segment_exists hu

end FitSetup

namespace FitSetup
variable (S : FitSetup)

/-! ### The inherited adaptive fit -/

open scoped Classical in
/-- The root of the segment containing a tree cell: its deepest attempt root. -/
noncomputable def seg (u : ℤ × ℤ) : ℤ × ℤ :=
  if h : u ∈ dyadicFiniteTree S.G S.J S.N ∧ S.Hyp then Classical.choose (h.2.segment_exists h.1)
  else u

/-- The depth of a cell below its segment root. -/
noncomputable def depthIn (u : ℤ × ℤ) : ℕ := (u.1 - (S.seg u).1).toNat

/-- The final state at a cell. -/
noncomputable def st (u : ℤ × ℤ) : (ℕ → ℝ → ℂ) × ℕ := S.state (S.depthIn u) u

/-- The fitted physical function `g_I` at a cell. -/
noncomputable def g (u : ℤ × ℤ) : ℝ → ℂ := S.phys u (S.st u).1 (S.st u).2

variable {S}

theorem Hyp.seg_spec (h : S.Hyp) {u : ℤ × ℤ} (hu : u ∈ dyadicFiniteTree S.G S.J S.N) :
    S.seg u ∈ S.roots ∧ S.cell u ⊆ S.cell (S.seg u) ∧
      (∀ b ∈ S.next (S.seg u), ¬ S.cell u ⊆ S.cell b) ∧
      ∀ L ∈ S.roots, S.cell u ⊆ S.cell L → L.1 ≤ (S.seg u).1 := by
  have hc : u ∈ dyadicFiniteTree S.G S.J S.N ∧ S.Hyp := ⟨hu, h⟩
  have e : S.seg u = Classical.choose (hc.2.segment_exists hc.1) := by
    unfold seg; simp only [hc, and_self, ↓reduceDIte]
  rw [e]
  exact Classical.choose_spec (hc.2.segment_exists hc.1)

/-- On every tree cell the greedy fit stopped below the cap, so the residual is small. -/
theorem Hyp.retained (h : S.Hyp) (hM : S.T < S.M) {u : ℤ × ℤ}
    (hu : u ∈ dyadicFiniteTree S.G S.J S.N) :
    (S.st u).2 < S.M ∧
      FormSmall (dyadicGridLeft S.G u.1 u.2) (dyadicGridLength S.G u.1) (S.w u) S.j S.q
        (S.res u (S.st u).1 (S.st u).2) (Real.exp (-(S.k : ℝ))) := by
  have hseg : S.seg u = S.toGreedyTree.seg u := by
    unfold seg GreedyTree.seg
    rw [dite_eq_left ⟨hu, h⟩, dite_eq_left ⟨hu, h.toGreedyTree⟩]
    rfl
  have hst : S.st u = S.toGreedyTree.st u := by
    unfold st depthIn GreedyTree.st GreedyTree.depthIn
    rw [hseg]
    rfl
  have hret := h.toGreedyTree.retained hM hu
  rw [← hst] at hret
  rcases hret with ⟨hlt, hout | hsmall⟩
  · exact (hout hu).elim
  · exact ⟨hlt, hsmall⟩

/-- Within a segment, deeper cells inherit the list of their ancestors. -/
theorem Hyp.inherited (h : S.Hyp) {u u' : ℤ × ℤ} (hu : u ∈ dyadicFiniteTree S.G S.J S.N)
    (hu' : u' ∈ dyadicFiniteTree S.G S.J S.N) (huu' : S.cell u ⊆ S.cell u')
    (hu'K : S.cell u' ⊆ S.cell (S.seg u)) :
    S.seg u' = S.seg u ∧ FitPrefix (S.st u) (S.st u') := by
  obtain ⟨hKr, huK, _, hmax⟩ := h.seg_spec hu
  obtain ⟨hK'r, hu'K', _, hmax'⟩ := h.seg_spec hu'
  have h1 := hmax (S.seg u') hK'r (huu'.trans hu'K')
  have h2 := hmax' (S.seg u) hKr hu'K
  have heq : S.seg u' = S.seg u :=
    dyadicGridCell_eq_of_common_point S.G (hu'K' (dyadicGridCell_left_mem S.G u'.1 u'.2))
      (hu'K (dyadicGridCell_left_mem S.G u'.1 u'.2)) (by omega)
  refine ⟨heq, ?_⟩
  have hd1 := dyadicGridCell_depth_le_of_subset S.G u u' huu'
  have hd2 := dyadicGridCell_depth_le_of_subset S.G u' (S.seg u) hu'K
  have hdepth : S.depthIn u = S.depthIn u' + (u.1 - u'.1).toNat := by
    unfold depthIn; rw [heq]; omega
  unfold st
  rw [hdepth]
  exact fitState_fitPrefix S.G S.M S.P S.O (S.depthIn u') u' _ u huu' (by omega)

/-- Every atom of every list is a bounded detection chart. -/
theorem Hyp.atoms_good (h : S.Hyp) (d : ℕ) (c : ℤ × ℤ) :
    ∀ i < (S.state d c).2, ∃ p : Σ d, QuadraticChartData d,
      QuadraticChartComplexity S.c₂ S.B p.2 ∧ IsBoundedQuadraticChart p.2 ∧
        (S.state d c).1 i = quadraticChartAtom p.2 := by
  refine fitState_inv S.G S.M S.P S.O (fun φ => ∃ p : Σ d, QuadraticChartData d,
      QuadraticChartComplexity S.c₂ S.B p.2 ∧ IsBoundedQuadraticChart p.2 ∧
        φ = quadraticChartAtom p.2) ?_ d c
  intro c a n _ hP
  simp only [P, not_or, not_not] at hP
  obtain ⟨hc, hns⟩ := hP
  obtain ⟨p, hgood, hO⟩ := fitOracleAtom_good
    (h.detect c a n hc (h.res_measurable c a n) (h.res_eLpNorm_le hc
      (kernelHull_of_not_formSmall hc hns) a n) hns)
  exact ⟨p, hgood.1, hgood.2.1, hO⟩

open scoped Classical in
/-- The fitted function is a combination of the atoms with coefficient `ℓ²` norm at most one. -/
theorem Hyp.g_coeff (h : S.Hyp) {u : ℤ × ℤ} (hu : u ∈ dyadicFiniteTree S.G S.J S.N)
    (hT : kernelHull S.G S.J S.N S.w u) :
    ∃ coef : Fin S.M → ℂ, ∑ i, ‖coef i‖ ^ 2 ≤ 1 ∧ (∀ i : Fin S.M, (S.st u).2 ≤ i → coef i = 0) ∧
      ∀ y, S.g u y = ∑ i, coef i * (S.st u).1 i y := by
  refine ⟨fun i => if i ∈ fitLabels S.M (S.st u).2 ∧ FitAdmissible (S.cell u) ((S.st u).1 i) then
    fitCoeff S.M (S.cell u) (S.st u).1 (S.st u).2 S.Z i else 0, ?_, ?_, ?_⟩
  · refine le_trans (le_of_eq ?_) (h.coeffSq_le hu hT (S.st u).1 (S.st u).2)
    unfold fitCoeffSq
    rw [← Finset.sum_filter_add_sum_filter_not Finset.univ (fun i => i ∈ fitLabels S.M (S.st u).2)]
    have hf : Finset.univ.filter (fun i => i ∈ fitLabels S.M (S.st u).2) = fitLabels S.M (S.st
        u).2 := by
      ext i; simp
    rw [hf, Finset.sum_eq_zero (s := Finset.univ.filter (fun i => i ∉ fitLabels S.M (S.st u).2))
      (fun i hi => by simp [(Finset.mem_filter.mp hi).2]), add_zero]
    refine Finset.sum_congr rfl fun i hi => ?_
    by_cases ha : FitAdmissible (S.cell u) ((S.st u).1 i) <;> simp [hi, ha]
  · intro i hi
    have : i ∉ fitLabels S.M (S.st u).2 := by simp [fitLabels]; omega
    simp [this]
  · intro y
    unfold g phys fitPhys
    rw [← Finset.sum_filter_add_sum_filter_not Finset.univ (fun i => i ∈ fitLabels S.M (S.st u).2)]
    have hf : Finset.univ.filter (fun i => i ∈ fitLabels S.M (S.st u).2) = fitLabels S.M (S.st
        u).2 := by
      ext i; simp
    rw [hf, Finset.sum_eq_zero (s := Finset.univ.filter (fun i => i ∉ fitLabels S.M (S.st u).2))
      (fun i hi => by simp [(Finset.mem_filter.mp hi).2]), add_zero]
    refine Finset.sum_congr rfl fun i hi => ?_
    by_cases ha : FitAdmissible (S.cell u) ((S.st u).1 i) <;> simp [hi, ha]

theorem Hyp.g_norm_le (h : S.Hyp) {u : ℤ × ℤ} (hu : u ∈ dyadicFiniteTree S.G S.J S.N)
    (hT : kernelHull S.G S.J S.N S.w u) (y : ℝ) :
    ‖S.g u y‖ ≤ Real.sqrt S.M := by
  have h1 := norm_fitPhys_sq_le S.M (S.cell u) (S.st u).1 (S.st u).2 S.Z y
  have h2 := h.coeffSq_le hu hT (S.st u).1 (S.st u).2
  refine Real.le_sqrt_of_sq_le (h1.trans ?_)
  have : (0 : ℝ) ≤ S.M := Nat.cast_nonneg _
  nlinarith

end FitSetup

/-! ### Packaging the adaptive fit as column tree data -/
theorem fitGreedy_inv_all {M : ℕ} {P : (ℕ → ℝ → ℂ) → ℕ → Prop}
    {O : (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ} (Good : (ℝ → ℂ) → Prop) (hO : ∀ a n, Good (O a n))
    (st : (ℕ → ℝ → ℂ) × ℕ) (h : ∀ i, Good (st.1 i)) :
    ∀ i, Good ((fitGreedy M P O st).1 i) := by
  unfold fitGreedy
  suffices H : ∀ t, ∀ i, Good (((fitStep M P O)^[t] st).1 i) from H M
  intro t
  induction t with
  | zero => exact h
  | succ t ih =>
    rw [Function.iterate_succ_apply']
    set s := (fitStep M P O)^[t] st
    rcases fitStep_count (M := M) (P := P) (O := O) s with he | ⟨_, _, he⟩
    · rw [he]; exact ih
    · rw [he]
      intro i
      simp only
      by_cases his : i = s.2
      · subst his; rw [Function.update_self]; exact hO _ _
      · rw [Function.update_of_ne his]; exact ih i

theorem fitState_inv_all (G : RealDyadicGrid) (M : ℕ) (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop)
    (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) (Good : (ℝ → ℂ) → Prop) (h0 : Good 0)
    (hO : ∀ c a n, Good (O c a n)) (d : ℕ) (c : ℤ × ℤ) :
    ∀ i, Good ((fitState G M P O d c).1 i) := by
  induction d generalizing c with
  | zero => exact fitGreedy_inv_all Good (hO c) _ (fun _ => h0)
  | succ d ih => exact fitGreedy_inv_all Good (hO c) _ (ih _)

theorem fitOracleAtom_measurable (c₂ : ℕ) (B a₀ r : ℝ) (R : ℝ → ℂ) :
    Measurable (fitOracleAtom c₂ B a₀ r R) := by
  unfold fitOracleAtom
  split_ifs
  · exact quadraticChartAtom_measurable _
  · exact measurable_const

theorem fitOracleAtom_bound (c₂ : ℕ) (B a₀ r : ℝ) (R : ℝ → ℂ) (y : ℝ) :
    ‖fitOracleAtom c₂ B a₀ r R y‖ ≤ 1 := by
  unfold fitOracleAtom
  split_ifs with h
  · exact (Classical.choose_spec h).2.1 y
  · simp

theorem norm_privateColumnValue_sq {V : Type*} [Fintype V] (φ : V → ℝ → ℂ) (ε : V → ℝ)
    (v : V) (y : ℝ) (hε : 0 ≤ ε v) :
    ‖privateColumnValue φ ε v y‖ ^ 2 = ‖φ v y‖ ^ 2 + ε v := by
  classical
  rw [EuclideanSpace.norm_sq_eq, Fintype.sum_option, privateColumnValue_physical]
  simp_rw [privateColumnValue_private]
  rw [Finset.sum_eq_single v (fun w _ hw => by simp [hw]) (by simp)]
  simp [Complex.norm_real, Real.sq_sqrt hε]

theorem dyadicIndex_measurable (G : RealDyadicGrid) (h : ℤ) :
    Measurable (dyadicIndex G h) := by
  have : dyadicIndex G h = fun y => ⌊(y - G.origin h) / dyadicGridLength G h⌋ := by
    funext y; exact dyadicIndex_eq_floor G h y
  rw [this]
  exact ((measurable_id.sub_const _).div_const _).floor

namespace FitSetup
variable {S : FitSetup}

theorem state_measurable (d : ℕ) (c : ℤ × ℤ) (i : ℕ) : Measurable ((S.state d c).1 i) :=
  fitState_inv_all S.G S.M S.P S.O Measurable measurable_const
    (fun _ _ _ => fitOracleAtom_measurable _ _ _ _ _) d c i

theorem state_bound (d : ℕ) (c : ℤ × ℤ) (i : ℕ) (y : ℝ) : ‖(S.state d c).1 i y‖ ≤ 1 :=
  fitState_inv_all S.G S.M S.P S.O (fun φ => ∀ y, ‖φ y‖ ≤ 1) (fun y => by simp)
    (fun _ _ _ => fitOracleAtom_bound _ _ _ _ _) d c i y

variable (S)

/-- The depth of the leaves of the tree. -/
def leafDepth : ℤ := S.J.1 + S.N

/-- The leaf containing `y`. -/
noncomputable def leaf (y : ℝ) : ℤ × ℤ := (S.leafDepth, dyadicIndex S.G S.leafDepth y)

/-- The count of the attempt rooted at `K` at the cell `c`. -/
noncomputable def count (K c : ℤ × ℤ) : ℕ := (S.state (c.1 - K.1).toNat c).2

/-- The atoms of the attempt rooted at `K` at the cell `c`. -/
noncomputable def atoms (K c : ℤ × ℤ) : ℕ → ℝ → ℂ := (S.state (c.1 - K.1).toNat c).1

/-- The scalar of label `v` for the attempt rooted at `K`: the atom of the leaf below `y`. -/
noncomputable def scalar (K : ℤ × ℤ) (v : Fin S.M) (y : ℝ) : ℂ :=
  by classical exact if y ∈ S.cell K then S.atoms K (S.leaf y) v y else 0

variable {S}

theorem leaf_mem (y : ℝ) : y ∈ S.cell (S.leaf y) := mem_dyadicIndex S.G _ y

theorem scalar_measurable (K : ℤ × ℤ) (v : Fin S.M) : Measurable (S.scalar K v) := by
  classical
  unfold scalar
  refine Measurable.ite (dyadicGridCell_measurable _ _ _) ?_ measurable_const
  have hF : Measurable (fun p : ℝ × ℤ => S.atoms K (S.leafDepth, p.2) v p.1) :=
    measurable_from_prod_countable_left fun m =>
      state_measurable (S := S) ((S.leafDepth, m).1 - K.1).toNat (S.leafDepth, m) (v : ℕ)
  exact hF.comp (measurable_id.prodMk (dyadicIndex_measurable S.G S.leafDepth))

theorem scalar_bound (K : ℤ × ℤ) (v : Fin S.M) (y : ℝ) : ‖S.scalar K v y‖ ≤ 1 := by
  classical
  unfold scalar
  split_ifs
  · exact state_bound _ _ _ _
  · simp

/-- Below the attempt root, the leaf list extends the list of every cell containing `y`. -/
theorem atoms_leaf {K c : ℤ × ℤ} (hK : K ∈ dyadicFiniteTree S.G S.J S.N) (hc : c ∈ S.sub K)
    {y : ℝ} (hy : y ∈ S.cell c) {v : ℕ} (hv : v < S.count K c) :
    S.atoms K (S.leaf y) v = S.atoms K c v := by
  have hm := (dyadicFiniteTree_mem_iff S.G K c _).mp hc
  have hend := dyadicRemainingDepth_endpoint S.G S.J S.N hK
  have hlow := dyadicGridCell_depth_le_of_subset S.G c K hm.1
  have hlc : S.cell (S.leaf y) ⊆ S.cell c :=
    dyadicGridCell_subset_of_common_point S.G (leaf_mem y) hy
      (by simp only [leaf, leafDepth]; omega)
  have hdepth : (S.leaf y).1 = c.1 + ((S.leaf y).1 - c.1).toNat := by
    simp only [leaf, leafDepth]; omega
  have hpre := fitState_fitPrefix S.G S.M S.P S.O (c.1 - K.1).toNat c _ (S.leaf y) hlc hdepth
  have he : (c.1 - K.1).toNat + ((S.leaf y).1 - c.1).toNat = ((S.leaf y).1 - K.1).toNat := by
    simp only [leaf, leafDepth]; omega
  rw [he] at hpre
  exact hpre.2 v hv

theorem scalar_eq {K c : ℤ × ℤ} (hK : K ∈ dyadicFiniteTree S.G S.J S.N) (hc : c ∈ S.sub K)
    {y : ℝ} (hy : y ∈ S.cell c) {v : Fin S.M} (hv : (v : ℕ) < S.count K c) :
    S.scalar K v y = S.atoms K c v y := by
  classical
  have hcK := ((dyadicFiniteTree_mem_iff S.G K c _).mp hc).1
  unfold scalar
  simp only [hcK hy, ↓reduceIte]
  rw [atoms_leaf hK hc hy hv]

theorem count_mono {K c d : ℤ × ℤ} (h2 : K.1 ≤ d.1)
    (hcd : S.cell c ⊆ S.cell d) : S.count K d ≤ S.count K c := by
  have h1 := dyadicGridCell_depth_le_of_subset S.G c d hcd
  have hpre := fitState_fitPrefix S.G S.M S.P S.O (d.1 - K.1).toNat d (c.1 - d.1).toNat c hcd
    (by omega)
  have he : (d.1 - K.1).toNat + (c.1 - d.1).toNat = (c.1 - K.1).toNat := by omega
  rw [he] at hpre
  exact hpre.1

variable (S)

/-- The column tree data of the attempt rooted at `K`, on the tree below a cell `R` of it
(blueprint §11.2, line 1574; renormalized at `R` as in sec:reduction, line 429): labels `Fin M`,
all born at `R`, private weight one, leaf-piecewise scalars. -/
noncomputable def treeData (K R : ℤ × ℤ) : ColumnTreeData (Fin S.M) where
  grid := S.G
  cells := S.sub R
  root := R
  below_root := fun c hc => ((dyadicFiniteTree_mem_iff S.G R c _).mp hc).1
  birth := fun _ => R
  birth_mem := fun _ => dyadicFiniteTree_root_mem _ _ _
  scalar := S.scalar K
  scalar_measurable := scalar_measurable K
  privateWeight := fun _ => 1
  privateWeight_pos := fun _ => one_pos
  budget := max 2 S.M
  two_le_budget := le_max_left _ _
  private_lower := fun _ => by
    rw [Real.sqrt_one]
    exact inv_le_one_of_one_le₀ (le_trans (by norm_num) (le_max_left _ _))
  column_bound := fun v => Filter.Eventually.of_forall fun y => by
    have h2 := norm_privateColumnValue_sq (S.scalar K) (fun _ => (1 : ℝ)) v y zero_le_one
    have hb := scalar_bound (S := S) K v y
    have hle : ‖privateColumnValue (S.scalar K) (fun _ => (1 : ℝ)) v y‖ ^ 2 ≤ 2 ^ 2 := by
      rw [h2]; nlinarith [norm_nonneg (S.scalar K v y)]
    exact (abs_le_of_sq_le_sq' hle (by norm_num)).2.trans (le_max_left _ _)
  path_count := fun y => by
    classical
    refine le_trans ?_ (le_max_right _ _)
    exact_mod_cast (Finset.card_le_univ _).trans (by simp)

/-- The inherited mask `{m < count}` of the attempt rooted at `K`. -/
noncomputable def treeMask (K R : ℤ × ℤ) (hKR : K.1 ≤ R.1) :
    InheritedColumnMask (S.treeData K R) where
  labels := fun c => Finset.univ.filter (fun v : Fin S.M => (v : ℕ) < S.count K c)
  available := fun c hc v _ => ((dyadicFiniteTree_mem_iff S.G R c _).mp hc).1
  inherited := fun c _ d hd hcd v hv => by
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hv ⊢
    have := dyadicGridCell_depth_le_of_subset S.G d R
      ((dyadicFiniteTree_mem_iff S.G R d _).mp hd).1
    exact lt_of_lt_of_le hv (count_mono (by omega) hcd)

/-- The attempt rooted at `K` as a column depth family on the tree below `R`. -/
noncomputable def depthFamily (K R : ℤ × ℤ) (hR : R ∈ dyadicFiniteTree S.G S.J S.N)
    (hKR : K.1 ≤ R.1) : ColumnDepthFamily (Fin S.M) where
  D := S.treeData K R
  A := S.treeMask K R hKR
  N := S.leafDepth
  root_le := by
    have := ((dyadicFiniteTree_mem_iff S.G S.J R S.N).mp hR).2
    simp only [treeData, leafDepth]; omega
  complete := fun c hc hcN => by
    have hend := dyadicRemainingDepth_endpoint S.G S.J S.N hR
    refine (dyadicFiniteTree_mem_iff S.G R c _).mpr ⟨hc, ?_⟩
    simp only [leafDepth] at hcN ⊢; omega

variable {S}

/-- The projection of the packaged data is the fit projection. -/
theorem treeProjection_eq {K R c : ℤ × ℤ} (hK : K ∈ dyadicFiniteTree S.G S.J S.N)
    (hR : R ∈ dyadicFiniteTree S.G S.J S.N) (hRK : S.cell R ⊆ S.cell K) (hKR : K.1 ≤ R.1)
    (hc : c ∈ (S.treeData K R).cells) (z : ColumnL2 (Fin S.M)) :
    cellColumnProjection (S.treeData K R) (S.treeMask K R hKR) hc z =
      fitProj S.M (S.cell c) (S.atoms K c) (S.count K c) z := by
  have hcR : c ∈ S.sub R := hc
  have hcT := ((sub_mem_iff hR c).mp hcR)
  have hcs : c ∈ S.sub K := (sub_mem_iff hK c).mpr ⟨hcT.1, hcT.2.trans hRK⟩
  have hrange : cellColumnRange (S.treeData K R) (S.treeMask K R hKR) hc =
      fitRange (M := S.M) (S.cell c) (S.atoms K c) (S.count K c) := by
    unfold cellColumnRange fitRange
    congr 1
    ext x
    simp only [Set.mem_range, Set.mem_ofPred_eq]
    constructor
    · rintro ⟨⟨v, hv⟩, rfl⟩
      have hv' : (v : ℕ) < S.count K c := by
        simpa [treeMask] using hv
      refine ⟨v, hv', ?_⟩
      have hadm : FitAdmissible (S.cell c) (S.atoms K c v) :=
        ⟨dyadicGridCell_measurable _ _ _, by rw [dyadicGridCell_volume]; exact
            ENNReal.ofReal_lt_top,
          state_measurable _ _ _, state_bound _ _ _⟩
      refine Lp.ext ?_
      filter_upwards [fitColumn_coeFn hadm v,
        cellColumnLp_coeFn (S.treeData K R) (S.treeMask K R hKR) hc ⟨v, hv⟩] with y h1 h2
      rw [h1, h2]
      by_cases hy : y ∈ S.cell c
      · have hy' : y ∈ dyadicGridCell (S.treeData K R).grid c.1 c.2 := hy
        rw [Set.indicator_of_mem hy, Set.indicator_of_mem hy']
        simp only [privateColumnValue, fitColumnValue, treeData, Real.sqrt_one,
          Complex.ofReal_one, one_smul]
        rw [scalar_eq hK hcs hy hv']
        congr; exact Subsingleton.elim _ _
      · have hy' : y ∉ dyadicGridCell (S.treeData K R).grid c.1 c.2 := hy
        rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy']
    · rintro ⟨v, hv, rfl⟩
      have hvm : v ∈ (S.treeMask K R hKR).labels c := by simpa [treeMask] using hv
      refine ⟨⟨v, hvm⟩, ?_⟩
      have hadm : FitAdmissible (S.cell c) (S.atoms K c v) :=
        ⟨dyadicGridCell_measurable _ _ _, by rw [dyadicGridCell_volume]; exact
            ENNReal.ofReal_lt_top,
          state_measurable _ _ _, state_bound _ _ _⟩
      refine Lp.ext ?_
      filter_upwards [fitColumn_coeFn hadm v,
        cellColumnLp_coeFn (S.treeData K R) (S.treeMask K R hKR) hc ⟨v, hvm⟩] with y h1 h2
      rw [h1, h2]
      by_cases hy : y ∈ S.cell c
      · have hy' : y ∈ dyadicGridCell (S.treeData K R).grid c.1 c.2 := hy
        rw [Set.indicator_of_mem hy, Set.indicator_of_mem hy']
        simp only [privateColumnValue, fitColumnValue, treeData, Real.sqrt_one,
          Complex.ofReal_one, one_smul]
        rw [scalar_eq hK hcs hy hv]
        congr; exact Subsingleton.elim _ _
      · have hy' : y ∉ dyadicGridCell (S.treeData K R).grid c.1 c.2 := hy
        rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy']
  unfold cellColumnProjection fitProj
  exact starProjection_congr hrange z

end FitSetup

section CurrentOpponent
variable {V : Type*} [Fintype V]

/-! ### Current projections: cellwise identification and depth energy -/
theorem ColumnDepthFamily.anc_self (Ψ : ColumnDepthFamily V) {I : ℤ × ℤ} (hI : I.1 ≤ Ψ.N) :
    Ψ.anc I = I := by
  unfold ColumnDepthFamily.anc
  rw [min_eq_left hI, dyadicIndex_eq (dyadicGridCell_left_mem _ _ _)]

theorem ColumnDepthFamily.current_of_mem (Ψ : ColumnDepthFamily V)
    (f : Lp ℂ 2 (volume : Measure ℝ)) {I : ℤ × ℤ} (hI : Ψ.anc I ∈ Ψ.D.cells) :
    Ψ.current f I = fun y =>
      (cellColumnProjection Ψ.D Ψ.A hI (physicalColumnInput f) : ℝ → ColumnHilbert V) y none := by
  unfold ColumnDepthFamily.current
  simp only [hI, ↓reduceDIte]

/-- On a row cell below the root, the current projection is a.e. the depth projection. -/
theorem ColumnDepthFamily.current_ae_proj (Ψ : ColumnDepthFamily V)
    (f : Lp ℂ 2 (volume : Measure ℝ)) {I : ℤ × ℤ}
    (hI : dyadicGridCell Ψ.D.grid I.1 I.2 ⊆ dyadicGridCell Ψ.D.grid Ψ.D.root.1 Ψ.D.root.2) :
    ∀ᵐ y ∂volume.restrict (dyadicGridCell Ψ.D.grid I.1 I.2), Ψ.current f I y =
      (Ψ.proj I.1 (physicalColumnInput f) : ℝ → ColumnHilbert V) y none := by
  have hroot : Ψ.D.root.1 ≤ I.1 := dyadicGridCell_depth_le_of_subset _ _ _ hI
  have hmem := Ψ.anc_mem hI
  have hpart : Ψ.anc I ∈ (Ψ.partition I.1).cells := by
    refine (Ψ.mem_partition _ _).mpr ⟨?_, Ψ.cell_sub_anc_root hI⟩
    have := Ψ.root_le
    simp only [ColumnDepthFamily.anc, ColumnDepthFamily.depth]
    omega
  have h1 := Ψ.proj_ae_cell I.1 (physicalColumnInput f) hpart
  have h2 := ae_restrict_of_ae_restrict_of_subset (Ψ.cell_sub_anc I) h1
  rw [Ψ.current_of_mem f hmem]
  filter_upwards [h2] with y hy
  rw [hy]

/-- Current projection opponents have depth energy with constant one. -/
theorem ColumnDepthFamily.current_depthEnergy (Ψ : ColumnDepthFamily V)
    (f : Lp ℂ 2 (volume : Measure ℝ)) :
    HasDepthEnergy Ψ.D.grid Ψ.D.root (f : ℝ → ℂ) (Ψ.current f) 1 := by
  classical
  intro s S hS
  rw [one_pow, one_mul]
  set z := physicalColumnInput (V := V) f
  set J := Ψ.D.root
  have hdisj : (S : Set (ℤ × ℤ)).PairwiseDisjoint
      (fun I => dyadicGridCell Ψ.D.grid I.1 I.2) := by
    intro I hI I' hI' hne
    have h1 : I.1 = I'.1 := by rw [(hS I hI).1, (hS I' hI').1]
    have h2 : I.2 ≠ I'.2 := fun h => hne (Prod.ext h1 h)
    have := dyadicGridCell_pairwiseDisjoint Ψ.D.grid I.1 h2
    simpa [Function.onFun, h1] using this
  have hcell : ∀ I ∈ S, ∫ y in dyadicGridCell Ψ.D.grid I.1 I.2, ‖Ψ.current f I y‖ ^ 2 ≤
      ∫ y in dyadicGridCell Ψ.D.grid I.1 I.2,
        ‖(Ψ.proj s z : ℝ → ColumnHilbert V) y‖ ^ 2 := by
    intro I hI
    have hae : ∀ᵐ y ∂volume.restrict (dyadicGridCell Ψ.D.grid I.1 I.2), Ψ.current f I y =
        (Ψ.proj s z : ℝ → ColumnHilbert V) y none := by
      rw [← (hS I hI).1]; exact Ψ.current_ae_proj f (hS I hI).2
    refine integral_mono_ae ?_ (integrableOn_norm_sq_Lp _ _) ?_
    · refine ((memLp_column_coord (Ψ.proj s z) none).integrable_norm_pow two_ne_zero).integrableOn
        |>.congr ?_
      filter_upwards [hae] with y hy
      rw [hy]
    · filter_upwards [hae] with y hy
      rw [hy]
      exact pow_le_pow_left₀ (norm_nonneg _) (norm_coord_le _ _) 2
  calc ∑ I ∈ S, ∫ y in dyadicGridCell Ψ.D.grid I.1 I.2, ‖Ψ.current f I y‖ ^ 2
      ≤ ∑ I ∈ S, ∫ y in dyadicGridCell Ψ.D.grid I.1 I.2,
          ‖(Ψ.proj s z : ℝ → ColumnHilbert V) y‖ ^ 2 := Finset.sum_le_sum hcell
    _ = ∫ y in ⋃ I ∈ S, dyadicGridCell Ψ.D.grid I.1 I.2,
          ‖(Ψ.proj s z : ℝ → ColumnHilbert V) y‖ ^ 2 :=
        (integral_biUnion_finset S (fun I _ => dyadicGridCell_measurable _ _ _) hdisj
          (fun I _ => integrableOn_norm_sq_Lp _ _)).symm
    _ ≤ ∫ y in dyadicGridCell Ψ.D.grid J.1 J.2, ‖(Ψ.proj s z : ℝ → ColumnHilbert V) y‖ ^ 2 :=
        setIntegral_mono_set (integrableOn_norm_sq_Lp _ _)
          (Filter.Eventually.of_forall fun _ => by positivity)
          (Filter.Eventually.of_forall (Set.iUnion₂_subset fun I hI => (hS I hI).2))
    _ ≤ ∫ y in dyadicGridCell Ψ.D.grid J.1 J.2, ‖(z : ℝ → ColumnHilbert V) y‖ ^ 2 :=
        Ψ.setIntegral_proj_le s z subset_rfl (Ψ.root_le_depth s)
    _ = ∫ y in dyadicGridCell Ψ.D.grid J.1 J.2, ‖(f : ℝ → ℂ) y‖ ^ 2 := integral_physical_sq _ _

end CurrentOpponent

namespace FitSetup
variable {S : FitSetup}

/-- On tree cells below `R`, the current projection of the packaged attempt is the fit
(a.e. on the cell). -/
theorem current_ae_fit {K R I : ℤ × ℤ} (hK : K ∈ dyadicFiniteTree S.G S.J S.N)
    (hR : R ∈ dyadicFiniteTree S.G S.J S.N) (hRK : S.cell R ⊆ S.cell K) (hKR : K.1 ≤ R.1)
    (hI : I ∈ S.sub R) :
    ∀ᵐ y ∂volume, y ∈ S.cell I →
      (S.depthFamily K R hR hKR).current S.input I y = S.phys I (S.atoms K I) (S.count K I) y := by
  set Ψ := S.depthFamily K R hR hKR
  have hIN : I.1 ≤ Ψ.N := by
    have hend := dyadicRemainingDepth_endpoint S.G S.J S.N hR
    have := ((dyadicFiniteTree_mem_iff S.G R I _).mp hI).2
    simp only [Ψ, depthFamily, leafDepth]; omega
  have hanc : Ψ.anc I = I := Ψ.anc_self hIN
  have hmem : Ψ.anc I ∈ Ψ.D.cells := by rw [hanc]; exact hI
  have key : ∀ (c : ℤ × ℤ) (hc : c ∈ Ψ.D.cells), c = I →
      cellColumnProjection Ψ.D Ψ.A hc (physicalColumnInput S.input) =
        fitProj S.M (S.cell I) (S.atoms K I) (S.count K I) S.Z := by
    rintro c hc rfl
    exact treeProjection_eq hK hR hRK hKR hc _
  filter_upwards [fitProj_none S.M (s := S.cell I) (S.atoms K I) (S.count K I) S.Z] with y hy hyI
  rw [Ψ.current_of_mem S.input hmem]
  simp only
  rw [key _ hmem hanc]
  exact hy hyI

end FitSetup

/-! ### The fits as admissible opponents -/

/-- Admissibility is invariant under changes of the opponent on the cells below the root and of
the input with the same energy on the root. -/
theorem isAdmissibleOpponent_congr {G : RealDyadicGrid} {J : ℤ × ℤ} {F F' : ℝ → ℂ}
    {z z' : ℤ × ℤ → ℝ → ℂ} {K : ℝ} (h : IsAdmissibleOpponent G J F z K)
    (hz : ∀ I : ℤ × ℤ, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2 → z' I = z I)
    (hF : ∫ y in dyadicGridCell G J.1 J.2, ‖F y‖ ^ 2 =
      ∫ y in dyadicGridCell G J.1 J.2, ‖F' y‖ ^ 2) :
    IsAdmissibleOpponent G J F' z' K := by
  intro ι R hR
  rw [← hF]
  refine le_trans (le_of_eq (Finset.sum_congr rfl fun i hi => ?_)) (h ι R hR)
  rw [hz _ (hR i hi)]

theorem hasDepthEnergy_congr {G : RealDyadicGrid} {J : ℤ × ℤ} {F F' : ℝ → ℂ}
    {z z' : ℤ × ℤ → ℝ → ℂ} {K : ℝ} (h : HasDepthEnergy G J F z K)
    (hz : ∀ I : ℤ × ℤ, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2 → z' I = z I)
    (hF : ∫ y in dyadicGridCell G J.1 J.2, ‖F y‖ ^ 2 =
      ∫ y in dyadicGridCell G J.1 J.2, ‖F' y‖ ^ 2) :
    HasDepthEnergy G J F' z' K := by
  intro s S hS
  rw [← hF]
  refine le_trans (le_of_eq (Finset.sum_congr rfl fun I hI => ?_)) (h s S hS)
  rw [hz _ (hS I hI).2]

/-- The compression constant of the fit families (`lem:compression` with `m = 1` and budget
`max 2 M`). -/
noncomputable def fitOpponentConst (M : ℕ) : ℝ :=
  (512 * ((1 : ℕ) + 1 : ℝ) ^ 512 * Real.log (2 * max 2 (M : ℝ))) ^ (512 * (1 + 1))

theorem fitOpponentConst_nonneg (M : ℕ) : 0 ≤ fitOpponentConst M := by
  unfold fitOpponentConst
  have : 0 ≤ Real.log (2 * max 2 (M : ℝ)) :=
    Real.log_nonneg (by have := le_max_left (2 : ℝ) M; linarith)
  positivity

/-- The conclusion of the adaptive fit (blueprint §11.2, lines 1567-1579) for an input `f` in
slot `j` at accuracy `e^{-k}` with chart budget `B`, on the complete finite tree of depth `N` below
`J`: restarted segments with total root length at most `4/3 |J|`, inherited lists of at most
`M ≤ 17 B²` bounded chart atoms extending along each segment, and fitted combinations `g_I`
(coefficient `ℓ²` norm at most one, `|g_I| ≤ √M`, `‖g_I‖_{2,I} ≤ 1`) with small residual
`d_{j,I}(f - g_I) ≤ e^{-k}` on every tree cell. -/
def IsAdaptiveFit (c₂ : ℕ) (B : ℝ) (G : RealDyadicGrid) (J : ℤ × ℤ) (N : ℕ)
    (w : ℤ × ℤ → ℝ × ℝ → ℂ) (j : Fin 4) (q : ℝ) (f : ℝ → ℂ) (k : ℕ) (M : ℕ)
    (roots : Finset (ℤ × ℤ)) (seg : ℤ × ℤ → ℤ × ℤ) (n : ℤ × ℤ → ℕ)
    (a : ℤ × ℤ → ℕ → ℝ → ℂ) (g : ℤ × ℤ → ℝ → ℂ) : Prop :=
  (M : ℝ) ≤ 17 * B ^ 2 ∧
  J ∈ roots ∧ roots ⊆ dyadicFiniteTree G J N ∧
  dyadicRootLength G roots ≤ 4 / 3 * dyadicGridLength G J.1 ∧
  ∀ I ∈ dyadicFiniteTree G J N,
    seg I ∈ roots ∧ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G (seg I).1 (seg I).2 ∧
    n I ≤ M ∧
    (∀ I' ∈ dyadicFiniteTree G J N, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G I'.1 I'.2 →
      dyadicGridCell G I'.1 I'.2 ⊆ dyadicGridCell G (seg I).1 (seg I).2 →
      seg I' = seg I ∧ n I' ≤ n I ∧ ∀ i < n I', a I' i = a I i) ∧
    (∀ i < n I, ∃ (d : ℕ) (Φ : QuadraticChartData d),
      QuadraticChartComplexity c₂ B Φ ∧ IsBoundedQuadraticChart Φ ∧
        a I i = quadraticChartAtom Φ) ∧
    (kernelHull G J N w I → ∃ coef : Fin M → ℂ, ∑ i, ‖coef i‖ ^ 2 ≤ 1 ∧
      (∀ i : Fin M, n I ≤ i → coef i = 0) ∧ ∀ y, g I y = ∑ i, coef i * a I i y) ∧
    Measurable (g I) ∧ (kernelHull G J N w I → ∀ y, ‖g I y‖ ≤ Real.sqrt M) ∧
    (kernelHull G J N w I →
      ∫ y in dyadicGridCell G I.1 I.2, ‖g I y‖ ^ 2 ≤ dyadicGridLength G I.1) ∧
    FormSmall (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) (w I) j q
      (fun y => f y - g I y) (Real.exp (-(k : ℝ)))

/-- The bilinear norm of the pair `(X, Y)` in slots `p ≠ p'` against normalized `L²` spectators is
at most `η` (blueprint §11.2, lines 1589-1596). -/
def PairSmall (a₀ r : ℝ) (w : ℝ × ℝ → ℂ) (p p' : Fin 4) (X Y : ℝ → ℂ) (η : ℝ) : Prop :=
  ∀ z : Fin 4 → ℝ → ℂ, (∀ l, Measurable (z l)) →
    (∀ l, l ≠ p → l ≠ p' → eLpNorm (z l) 2 (normalizedIntervalMeasure a₀ r) ≤ 1) →
    ‖localProgressionForm r w (slotPair z p p' X Y)‖ ≤ η

theorem fin4_other_two : ∀ p p' : Fin 4, p ≠ p' →
    ∃ a b : Fin 4, a ≠ b ∧ a ≠ p ∧ a ≠ p' ∧ b ≠ p ∧ b ≠ p' ∧
      ∀ l : Fin 4, l = p ∨ l = p' ∨ l = a ∨ l = b := by
  decide

section PairForm
variable {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
  (hw : IsAdmissibleLocalKernel κ a₀ r w)

include hr hw in
/-- Subtraction in one slot of the local form, for finite normalized `L²` inputs. -/
theorem localProgressionForm_update_sub {f : Fin 4 → ℝ → ℂ} (hf : ∀ j, Measurable (f j))
    (hfin : ∀ j, eLpNorm (f j) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤) (k : Fin 4)
    {g₁ g₂ : ℝ → ℂ} (hg₁ : Measurable g₁) (hg₂ : Measurable g₂)
    (hg₁f : eLpNorm g₁ 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hg₂f : eLpNorm g₂ 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤) :
    localProgressionForm r w (Function.update f k (g₁ - g₂)) =
      localProgressionForm r w (Function.update f k g₁) -
        localProgressionForm r w (Function.update f k g₂) := by
  have hm : Measurable ((-1 : ℂ) • g₂) := hg₂.const_smul _
  have hmf : eLpNorm ((-1 : ℂ) • g₂) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤ := by
    rw [eLpNorm_const_smul]; exact ENNReal.mul_ne_top ENNReal.coe_ne_top hg₂f
  have he : g₁ - g₂ = g₁ + (-1 : ℂ) • g₂ := by funext y; simp [sub_eq_add_neg]
  rw [he, localProgressionForm_update_add_two hr hw hf hfin k hg₁ hm hg₁f hmf,
    localProgressionForm_update_const_smul]
  ring

/-- Hypotheses for pair computations: measurable spectators of finite normalized `L²` norm. -/
def SpectatorOK (a₀ r : ℝ) (z : Fin 4 → ℝ → ℂ) (p p' : Fin 4) : Prop :=
  (∀ l, Measurable (z l)) ∧
    ∀ l, l ≠ p → l ≠ p' → eLpNorm (z l) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤

/-- A function with finite normalized `L²` norm. -/
def FinL2 (a₀ r : ℝ) (X : ℝ → ℂ) : Prop :=
  Measurable X ∧ eLpNorm X 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤

theorem FinL2.sub {X Y : ℝ → ℂ} (hX : FinL2 a₀ r X) (hY : FinL2 a₀ r Y) : FinL2 a₀ r (X - Y) :=
  ⟨hX.1.sub hY.1, ((eLpNorm_sub_le (by norm_num)).trans_lt
    (ENNReal.add_lt_top.mpr ⟨hX.2.lt_top, hY.2.lt_top⟩)).ne⟩

theorem FinL2.zero : FinL2 a₀ r (0 : ℝ → ℂ) := ⟨measurable_const, by simp⟩

theorem FinL2.of_bound (hr : 0 < r) {X : ℝ → ℂ} (hX : Measurable X) {S : ℝ}
    (hS : ∀ y, ‖X y‖ ≤ S) : FinL2 a₀ r X :=
  ⟨hX, ne_top_of_le_ne_top ENNReal.ofReal_ne_top (eLpNorm_two_le_of_bound hr hX hS)⟩

theorem slotPair_meas {z : Fin 4 → ℝ → ℂ} {p p' : Fin 4} (hz : ∀ l, Measurable (z l))
    {X Y : ℝ → ℂ} (hX : Measurable X) (hY : Measurable Y) (l : Fin 4) :
    Measurable (slotPair z p p' X Y l) :=
  measurable_update_slot (measurable_update_slot hz p hX) p' hY l

theorem slotPair_fin {z : Fin 4 → ℝ → ℂ} {p p' : Fin 4} (hz : SpectatorOK a₀ r z p p')
    {X Y : ℝ → ℂ} (hX : FinL2 a₀ r X) (hY : FinL2 a₀ r Y) (l : Fin 4) :
    eLpNorm (slotPair z p p' X Y l) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤ := by
  unfold slotPair
  by_cases h' : l = p'
  · subst h'; rw [Function.update_self]; exact hY.2
  · rw [Function.update_of_ne h']
    by_cases h : l = p
    · subst h; rw [Function.update_self]; exact hX.2
    · rw [Function.update_of_ne h]; exact hz.2 l h h'

include hr hw in
theorem slotPair_sub_right {z : Fin 4 → ℝ → ℂ} {p p' : Fin 4} (hz : SpectatorOK a₀ r z p p')
    {X Y Y' : ℝ → ℂ} (hX : FinL2 a₀ r X) (hY : FinL2 a₀ r Y) (hY' : FinL2 a₀ r Y') :
    localProgressionForm r w (slotPair z p p' X (Y - Y')) =
      localProgressionForm r w (slotPair z p p' X Y) -
        localProgressionForm r w (slotPair z p p' X Y') := by
  have h := localProgressionForm_update_sub hr hw (f := slotPair z p p' X Y)
    (slotPair_meas hz.1 hX.1 hY.1) (slotPair_fin hz hX hY) p' hY.1 hY'.1 hY.2 hY'.2
  simp only [slotPair, Function.update_idem] at h ⊢
  exact h

include hr hw in
theorem slotPair_sub_left {z : Fin 4 → ℝ → ℂ} {p p' : Fin 4} (hpp : p ≠ p')
    (hz : SpectatorOK a₀ r z p p') {X X' Y : ℝ → ℂ} (hX : FinL2 a₀ r X) (hX' : FinL2 a₀ r X')
    (hY : FinL2 a₀ r Y) :
    localProgressionForm r w (slotPair z p p' (X - X') Y) =
      localProgressionForm r w (slotPair z p p' X Y) -
        localProgressionForm r w (slotPair z p p' X' Y) := by
  have hz' : SpectatorOK a₀ r z p' p := ⟨hz.1, fun l h1 h2 => hz.2 l h2 h1⟩
  rw [slotPair_comm z hpp, slotPair_comm z hpp, slotPair_comm z hpp]
  exact slotPair_sub_right hr hw hz' hY hX hX'

theorem slotPair_const_smul_right (z : Fin 4 → ℝ → ℂ) (p p' : Fin 4) (X Y : ℝ → ℂ) (c : ℂ) :
    localProgressionForm r w (slotPair z p p' X (c • Y)) =
      c * localProgressionForm r w (slotPair z p p' X Y) := by
  unfold slotPair
  exact localProgressionForm_update_const_smul r w _ p' c Y

/-- Apply residual smallness with the residual in slot `p` and an `L^q` input in slot `p'`. -/
theorem FormSmall.apply_pair {p p' : Fin 4} (hpp : p ≠ p') {q : ℝ} {R : ℝ → ℂ} {η : ℝ}
    (h : FormSmall a₀ r w p q R η) (hR : Measurable R) {V : ℝ → ℂ} (hV : Measurable V)
    (hVq : eLpNorm V (ENNReal.ofReal q) (normalizedIntervalMeasure a₀ r) ≤ 1)
    {z : Fin 4 → ℝ → ℂ} (hz : ∀ l, Measurable (z l))
    (hz2 : ∀ l, l ≠ p → l ≠ p' → eLpNorm (z l) 2 (normalizedIntervalMeasure a₀ r) ≤ 1) :
    ‖localProgressionForm r w (slotPair z p p' R V)‖ ≤ η := by
  obtain ⟨a, b, hab, hap, hap', hbp, hbp', _⟩ := fin4_other_two p p' hpp
  refine h (slotPair z p p' R V) (slotPair_meas hz hR hV) (slotPair_left hpp R V)
    (ih := p') (ku := a) (lv := b) hpp (Ne.symm hap) (Ne.symm hbp) (Ne.symm hap')
    (Ne.symm hbp') hab ?_ ?_ ?_
  · rw [slotPair_right]; exact hVq
  · rw [slotPair_other hap hap']; exact hz2 a hap hap'
  · rw [slotPair_other hbp hbp']; exact hz2 b hbp hbp'

include hr in
/-- The `L^q` slot may carry a function bounded by `S`, at the cost of the factor `S`. -/
theorem FormSmall.apply_pair_bounded {p p' : Fin 4} (hpp : p ≠ p') {q : ℝ}
    {R : ℝ → ℂ} {η : ℝ} (h : FormSmall a₀ r w p q R η) (hR : Measurable R) {V : ℝ → ℂ}
    (hV : Measurable V) {S : ℝ} (hS : 0 < S) (hVS : ∀ y, ‖V y‖ ≤ S)
    {z : Fin 4 → ℝ → ℂ} (hz : ∀ l, Measurable (z l))
    (hz2 : ∀ l, l ≠ p → l ≠ p' → eLpNorm (z l) 2 (normalizedIntervalMeasure a₀ r) ≤ 1) :
    ‖localProgressionForm r w (slotPair z p p' R V)‖ ≤ S * η := by
  have : IsProbabilityMeasure (normalizedIntervalMeasure a₀ r) :=
    normalizedIntervalMeasure_probability a₀ hr
  have hV' : Measurable ((S⁻¹ : ℂ) • V) := hV.const_smul _
  have hVq : eLpNorm ((S⁻¹ : ℂ) • V) (ENNReal.ofReal q) (normalizedIntervalMeasure a₀ r) ≤ 1 := by
    refine (eLpNorm_le_of_ae_bound (C := 1) hV'.aestronglyMeasurable
      (Filter.Eventually.of_forall fun y => ?_)).trans ?_
    · exact (show ‖((S⁻¹ : ℂ) • V) y‖ ≤ 1 by
        rw [Pi.smul_apply, smul_eq_mul, norm_mul, norm_inv, Complex.norm_real,
          Real.norm_eq_abs, abs_of_pos hS, inv_mul_le_iff₀ hS, mul_one]
        exact hVS y)
    · simp
  have h1 := h.apply_pair hpp hR hV' hVq hz hz2
  have he : V = (S : ℂ) • ((S⁻¹ : ℂ) • V) := by
    rw [smul_smul, mul_inv_cancel₀ (by exact_mod_cast hS.ne'), one_smul]
  rw [he, slotPair_const_smul_right, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos hS]
  exact mul_le_mul_of_nonneg_left h1 hS.le

end PairForm

/-! ### Cyclic updates at one cell -/

/-- The position updated at level `t` (cyclic order). -/
def stagPos (t : ℕ) : Fin 4 := ⟨t % 4, Nat.mod_lt _ (by norm_num)⟩

/-- The data of the cyclic updates at one cell: inputs normalized in `L^q`, and at each level
`t ≥ 1` a bounded projection of the input in position `t mod 4` with residual smallness
`e^{-k_t}`; the accuracies grow fast enough to dominate the supremum bounds. -/
structure StaggerCell (κ : LocalKernelClass) where
  /-- Left endpoint of the cell undergoing staggered updates. -/
  a₀ : ℝ
  /-- Positive length of the cell undergoing staggered updates. -/
  r : ℝ
  /-- Admissible local kernel on the update cell. -/
  w : ℝ × ℝ → ℂ
  /-- Integrability exponent for the normalized input functions. -/
  q : ℝ
  /-- The four input functions before staggered projection updates. -/
  f : Fin 4 → ℝ → ℂ
  /-- Projected approximation selected at each update level. -/
  g : ℕ → ℝ → ℂ
  /-- Accuracy exponent controlling the residual at each update level. -/
  k : ℕ → ℝ
  /-- Pointwise norm bound for each projected approximation. -/
  S : ℕ → ℝ
  r_pos : 0 < r
  adm : IsAdmissibleLocalKernel κ a₀ r w
  two_le_q : 2 ≤ q
  f_meas : ∀ p, Measurable (f p)
  f_norm : ∀ p, eLpNorm (f p) (ENNReal.ofReal q) (normalizedIntervalMeasure a₀ r) ≤ 1
  g_meas : ∀ t, Measurable (g t)
  S_pos : ∀ t, 0 < S t
  g_bound : ∀ t y, ‖g t y‖ ≤ S t
  g_L2 : ∀ t, eLpNorm (g t) 2 (normalizedIntervalMeasure a₀ r) ≤ 1
  g_small : ∀ t, 1 ≤ t →
    FormSmall a₀ r w (stagPos t) q (f (stagPos t) - g t) (Real.exp (-k t))
  k_nonneg : ∀ t, 0 ≤ k t
  k_grow : ∀ v h, 1 ≤ v → v < h → 2 * k v ≤ k h
  S_le : ∀ v h, 1 ≤ v → v < h → S v ≤ Real.exp (k h / 2)

namespace StaggerCell
variable {κ : LocalKernelClass} (C : StaggerCell κ)

/-- The normalized measure of the cell. -/
noncomputable abbrev μ : Measure ℝ := normalizedIntervalMeasure C.a₀ C.r

/-- The local form. -/
noncomputable abbrev H (F : Fin 4 → ℝ → ℂ) : ℂ := localProgressionForm C.r C.w F

theorem k_mono {v h : ℕ} (hv : 1 ≤ v) (hvh : v ≤ h) : C.k v ≤ C.k h := by
  rcases hvh.lt_or_eq with hlt | rfl
  · linarith [C.k_grow v h hv hlt, C.k_nonneg v]
  · exact le_rfl

theorem finL2_f (p : Fin 4) : FinL2 C.a₀ C.r (C.f p) := by
  have : IsProbabilityMeasure C.μ := normalizedIntervalMeasure_probability C.a₀ C.r_pos
  refine ⟨C.f_meas p, ne_top_of_le_ne_top ENNReal.one_ne_top
    (le_trans (eLpNorm_le_eLpNorm_of_exponent_le ?_) (C.f_norm p))⟩
  rw [show (2 : ENNReal) = ENNReal.ofReal 2 by norm_num]
  exact ENNReal.ofReal_le_ofReal C.two_le_q

theorem finL2_g (t : ℕ) : FinL2 C.a₀ C.r (C.g t) :=
  FinL2.of_bound C.r_pos (C.g_meas t) (C.g_bound t)

/-- Values of terms: `none` is the actual input, `some ℓ` the projection of level `ℓ`. -/
def tv (s : Fin 4) : Option ℕ → ℝ → ℂ
  | none => C.f s
  | some ℓ => C.g ℓ

theorem finL2_tv (s : Fin 4) (A : Option ℕ) : FinL2 C.a₀ C.r (C.tv s A) := by
  cases A with
  | none => exact C.finL2_f s
  | some ℓ => exact C.finL2_g ℓ

/-- A term at slot `s` with projection levels at least `m`. -/
def Valid (s : Fin 4) (m : ℕ) (A : Option ℕ) : Prop :=
  ∀ ℓ, A = some ℓ → 1 ≤ ℓ ∧ stagPos ℓ = s ∧ m ≤ ℓ

/-- Normalized spectators for the slots `p, p'`. -/
def Spect (z : Fin 4 → ℝ → ℂ) (p p' : Fin 4) : Prop :=
  (∀ l, Measurable (z l)) ∧ ∀ l, l ≠ p → l ≠ p' → eLpNorm (z l) 2 C.μ ≤ 1

theorem Spect.flip {C : StaggerCell κ} {z : Fin 4 → ℝ → ℂ} {p p' : Fin 4} (h : C.Spect z p p') :
    C.Spect z p' p := ⟨h.1, fun l h1 h2 => h.2 l h2 h1⟩

theorem Spect.ok {C : StaggerCell κ} {z : Fin 4 → ℝ → ℂ} {p p' : Fin 4} (h : C.Spect z p p') :
    SpectatorOK C.a₀ C.r z p p' :=
  ⟨h.1, fun l h1 h2 => ne_top_of_le_ne_top ENNReal.one_ne_top (h.2 l h1 h2)⟩

theorem H_comm (z : Fin 4 → ℝ → ℂ) {p p' : Fin 4} (h : p ≠ p') (X Y : ℝ → ℂ) :
    C.H (slotPair z p p' X Y) = C.H (slotPair z p' p Y X) := by
  rw [slotPair_comm z h]

/-- Replacing a projection by its input against an actual input: error `e^{-k_ℓ}`. -/
theorem repl_input {ℓ : ℕ} (hℓ : 1 ≤ ℓ) {s' : Fin 4} (hs : stagPos ℓ ≠ s')
    {z : Fin 4 → ℝ → ℂ} (hz : C.Spect z (stagPos ℓ) s') :
    ‖C.H (slotPair z (stagPos ℓ) s' (C.g ℓ) (C.f s')) -
      C.H (slotPair z (stagPos ℓ) s' (C.f (stagPos ℓ)) (C.f s'))‖ ≤ Real.exp (-C.k ℓ) := by
  have hsub := slotPair_sub_left C.r_pos C.adm hs hz.ok (C.finL2_f (stagPos ℓ)) (C.finL2_g ℓ)
    (C.finL2_f s')
  have hsm := (C.g_small ℓ hℓ).apply_pair hs ((C.f_meas _).sub (C.g_meas ℓ)) (C.f_meas s')
    (C.f_norm s') hz.1 hz.2
  rw [hsub] at hsm
  rw [← norm_neg, neg_sub]
  exact hsm

/-- Replacing a projection by its input against a bounded function: error `S e^{-k_ℓ}`. -/
theorem repl_bounded {ℓ : ℕ} (hℓ : 1 ≤ ℓ) {s' : Fin 4} (hs : stagPos ℓ ≠ s')
    {z : Fin 4 → ℝ → ℂ} (hz : C.Spect z (stagPos ℓ) s') (v : ℕ) :
    ‖C.H (slotPair z (stagPos ℓ) s' (C.g ℓ) (C.g v)) -
      C.H (slotPair z (stagPos ℓ) s' (C.f (stagPos ℓ)) (C.g v))‖ ≤
        C.S v * Real.exp (-C.k ℓ) := by
  have hsub := slotPair_sub_left C.r_pos C.adm hs hz.ok (C.finL2_f (stagPos ℓ)) (C.finL2_g ℓ)
    (C.finL2_g v)
  have hsm := (C.g_small ℓ hℓ).apply_pair_bounded C.r_pos hs ((C.f_meas _).sub (C.g_meas ℓ))
    (C.g_meas v) (C.S_pos v) (C.g_bound v) hz.1 hz.2
  rw [hsub] at hsm
  rw [← norm_neg, neg_sub]
  exact hsm

theorem exp_half_le {m h : ℕ} (hm : 1 ≤ m) (hmh : m ≤ h) :
    Real.exp (-C.k h) ≤ Real.exp (-C.k m) :=
  Real.exp_le_exp.mpr (by linarith [C.k_mono hm hmh])

/-- `S_v e^{-k_h} ≤ e^{-k_h/2}` for `v < h`. -/
theorem S_exp_le {v h : ℕ} (hv : 1 ≤ v) (hvh : v < h) :
    C.S v * Real.exp (-C.k h) ≤ Real.exp (-C.k h / 2) := by
  calc C.S v * Real.exp (-C.k h) ≤ Real.exp (C.k h / 2) * Real.exp (-C.k h) :=
        mul_le_mul_of_nonneg_right (C.S_le v h hv hvh) (Real.exp_pos _).le
    _ = Real.exp (-C.k h / 2) := by rw [← Real.exp_add]; ring_nf

/-- Blueprint eq:stagger (line 1589): replacing any two valid terms in distinct slots by the
actual inputs costs at most `2 e^{-k_m}`. -/
theorem term_bound {s s' : Fin 4} (hss : s ≠ s') {m : ℕ} (hm : 1 ≤ m) {A B : Option ℕ}
    (hA : Valid s m A) (hB : Valid s' m B) {z : Fin 4 → ℝ → ℂ} (hz : C.Spect z s s') :
    ‖C.H (slotPair z s s' (C.tv s A) (C.tv s' B)) - C.H (slotPair z s s' (C.f s) (C.f s'))‖ ≤
      2 * Real.exp (-C.k m) := by
  have he := (Real.exp_pos (-C.k m)).le
  cases A with
  | none =>
    cases B with
    | none => simp only [tv, sub_self, norm_zero]; positivity
    | some h =>
      obtain ⟨h1, hpos, hmh⟩ := hB h rfl
      subst hpos
      have := C.repl_input h1 (Ne.symm hss) hz.flip
      rw [C.H_comm z hss, C.H_comm z hss]
      simp only [tv]
      linarith [C.exp_half_le hm hmh]
  | some ℓ =>
    obtain ⟨h1, hpos, hmℓ⟩ := hA ℓ rfl
    subst hpos
    cases B with
    | none =>
      have := C.repl_input h1 hss hz
      simp only [tv]
      linarith [C.exp_half_le hm hmℓ]
    | some h =>
      obtain ⟨h2, hpos', hmh⟩ := hB h rfl
      subst hpos'
      simp only [tv]
      have hne : ℓ ≠ h := by intro e; subst e; exact hss rfl
      rcases lt_or_gt_of_ne hne with hlt | hlt
      · -- `ℓ < h`: replace `g_h` against the bounded `g_ℓ`, then `g_ℓ` against `f`
        have e1 := C.repl_bounded h2 (Ne.symm hss) hz.flip ℓ
        have e2 := C.repl_input h1 hss hz
        rw [C.H_comm z (Ne.symm hss), C.H_comm z (Ne.symm hss)] at e1
        have hS := C.S_exp_le h1 hlt
        have hk : Real.exp (-C.k h / 2) ≤ Real.exp (-C.k m) :=
          Real.exp_le_exp.mpr (by linarith [C.k_grow ℓ h h1 hlt, C.k_mono hm hmℓ])
        calc _ = ‖(C.H (slotPair z (stagPos ℓ) (stagPos h) (C.g ℓ) (C.g h)) -
                C.H (slotPair z (stagPos ℓ) (stagPos h) (C.g ℓ) (C.f (stagPos h)))) +
              (C.H (slotPair z (stagPos ℓ) (stagPos h) (C.g ℓ) (C.f (stagPos h))) -
                C.H (slotPair z (stagPos ℓ) (stagPos h) (C.f (stagPos ℓ))
                  (C.f (stagPos h))))‖ := by ring_nf
          _ ≤ _ := norm_add_le _ _
          _ ≤ C.S ℓ * Real.exp (-C.k h) + Real.exp (-C.k ℓ) := by
              refine add_le_add ?_ e2
              rw [← norm_neg, neg_sub] at e1 ⊢
              rw [norm_sub_rev]; rw [norm_sub_rev] at e1; exact e1
          _ ≤ 2 * Real.exp (-C.k m) := by linarith [C.exp_half_le hm hmℓ]
      · -- `h < ℓ`: replace `g_ℓ` against the bounded `g_h`, then `g_h` against `f`
        have e1 := C.repl_bounded h1 hss hz h
        have e2 := C.repl_input h2 (Ne.symm hss) hz.flip
        rw [C.H_comm z (Ne.symm hss), C.H_comm z (Ne.symm hss)] at e2
        have hS := C.S_exp_le h2 hlt
        have hk : Real.exp (-C.k ℓ / 2) ≤ Real.exp (-C.k m) :=
          Real.exp_le_exp.mpr (by linarith [C.k_grow h ℓ h2 hlt, C.k_mono hm hmh])
        calc _ = ‖(C.H (slotPair z (stagPos ℓ) (stagPos h) (C.g ℓ) (C.g h)) -
                C.H (slotPair z (stagPos ℓ) (stagPos h) (C.f (stagPos ℓ)) (C.g h))) +
              (C.H (slotPair z (stagPos ℓ) (stagPos h) (C.f (stagPos ℓ)) (C.g h)) -
                C.H (slotPair z (stagPos ℓ) (stagPos h) (C.f (stagPos ℓ))
                  (C.f (stagPos h))))‖ := by ring_nf
          _ ≤ _ := norm_add_le _ _
          _ ≤ C.S h * Real.exp (-C.k ℓ) + Real.exp (-C.k h) := add_le_add e1 e2
          _ ≤ 2 * Real.exp (-C.k m) := by linarith [C.exp_half_le hm hmh]

/-- Expansion of a pair of differences around a common reference value. -/
theorem diff4_bound {s s' : Fin 4} (hss : s ≠ s') {z : Fin 4 → ℝ → ℂ} (hz : C.Spect z s s')
    {A₁ A₂ B₁ B₂ : ℝ → ℂ} (hA₁ : FinL2 C.a₀ C.r A₁) (hA₂ : FinL2 C.a₀ C.r A₂)
    (hB₁ : FinL2 C.a₀ C.r B₁) (hB₂ : FinL2 C.a₀ C.r B₂) (c : ℂ) {ε : ℝ}
    (h11 : ‖C.H (slotPair z s s' A₁ B₁) - c‖ ≤ ε) (h12 : ‖C.H (slotPair z s s' A₁ B₂) - c‖ ≤ ε)
    (h21 : ‖C.H (slotPair z s s' A₂ B₁) - c‖ ≤ ε) (h22 : ‖C.H (slotPair z s s' A₂ B₂) - c‖ ≤ ε) :
    ‖C.H (slotPair z s s' (A₁ - A₂) (B₁ - B₂))‖ ≤ 4 * ε := by
  simp only [H] at *
  rw [slotPair_sub_left C.r_pos C.adm hss hz.ok hA₁ hA₂ (hB₁.sub hB₂),
    slotPair_sub_right C.r_pos C.adm hz.ok hA₁ hB₁ hB₂,
    slotPair_sub_right C.r_pos C.adm hz.ok hA₂ hB₁ hB₂]
  calc _ = ‖(C.H (slotPair z s s' A₁ B₁) - c) - (C.H (slotPair z s s' A₁ B₂) - c) -
        ((C.H (slotPair z s s' A₂ B₁) - c) - (C.H (slotPair z s s' A₂ B₂) - c))‖ := by ring_nf
    _ ≤ ‖(C.H (slotPair z s s' A₁ B₁) - c) - (C.H (slotPair z s s' A₁ B₂) - c)‖ +
        ‖(C.H (slotPair z s s' A₂ B₁) - c) - (C.H (slotPair z s s' A₂ B₂) - c)‖ := norm_sub_le _ _
    _ ≤ (ε + ε) + (ε + ε) := add_le_add ((norm_sub_le _ _).trans (add_le_add h11 h12))
        ((norm_sub_le _ _).trans (add_le_add h21 h22))
    _ = 4 * ε := by ring

theorem diff2_bound {s s' : Fin 4} {z : Fin 4 → ℝ → ℂ} (hz : C.Spect z s s')
    {V B₁ B₂ : ℝ → ℂ} (hV : FinL2 C.a₀ C.r V) (hB₁ : FinL2 C.a₀ C.r B₁)
    (hB₂ : FinL2 C.a₀ C.r B₂) (c : ℂ) {ε : ℝ}
    (h1 : ‖C.H (slotPair z s s' V B₁) - c‖ ≤ ε) (h2 : ‖C.H (slotPair z s s' V B₂) - c‖ ≤ ε) :
    ‖C.H (slotPair z s s' V (B₁ - B₂))‖ ≤ 2 * ε := by
  simp only [H] at *
  rw [slotPair_sub_right C.r_pos C.adm hz.ok hV hB₁ hB₂]
  calc _ = ‖(C.H (slotPair z s s' V B₁) - c) - (C.H (slotPair z s s' V B₂) - c)‖ := by ring_nf
    _ ≤ ε + ε := (norm_sub_le _ _).trans (add_le_add h1 h2)
    _ = 2 * ε := by ring

/-- A difference of two valid terms. -/
def LateRep (l : Fin 4) (m : ℕ) (X : ℝ → ℂ) : Prop :=
  ∃ A₁ A₂ : Option ℕ, Valid l m A₁ ∧ Valid l m A₂ ∧ X = C.tv l A₁ - C.tv l A₂

theorem LateRep.mono {C : StaggerCell κ} {l : Fin 4} {m m' : ℕ} (hm : m' ≤ m) {X : ℝ → ℂ}
    (h : C.LateRep l m X) : C.LateRep l m' X := by
  obtain ⟨A₁, A₂, h₁, h₂, rfl⟩ := h
  exact ⟨A₁, A₂, fun ℓ hℓ => let ⟨a, b, c⟩ := h₁ ℓ hℓ; ⟨a, b, by omega⟩,
    fun ℓ hℓ => let ⟨a, b, c⟩ := h₂ ℓ hℓ; ⟨a, b, by omega⟩, rfl⟩

/-- Two late differences in distinct slots have pair norm at most `8 e^{-k_m}`. -/
theorem late_pair {s s' : Fin 4} (hss : s ≠ s') {m : ℕ} (hm : 1 ≤ m) {X Y : ℝ → ℂ}
    (hX : C.LateRep s m X) (hY : C.LateRep s' m Y) {z : Fin 4 → ℝ → ℂ}
    (hz : C.Spect z s s') : ‖C.H (slotPair z s s' X Y)‖ ≤ 8 * Real.exp (-C.k m) := by
  obtain ⟨A₁, A₂, hA₁, hA₂, rfl⟩ := hX
  obtain ⟨B₁, B₂, hB₁, hB₂, rfl⟩ := hY
  have h := C.diff4_bound hss hz (C.finL2_tv s A₁) (C.finL2_tv s A₂) (C.finL2_tv s' B₁)
    (C.finL2_tv s' B₂) (C.H (slotPair z s s' (C.f s) (C.f s')))
    (C.term_bound hss hm hA₁ hB₁ hz) (C.term_bound hss hm hA₁ hB₂ hz)
    (C.term_bound hss hm hA₂ hB₁ hz) (C.term_bound hss hm hA₂ hB₂ hz)
  linarith

/-- A bounded old projection against a late term: replacing the late term costs
`e^{-k_m/2}`. -/
theorem old_term_bound {s s' : Fin 4} (hss : s ≠ s') {v m : ℕ} (hv : 1 ≤ v) (hvm : v < m)
    {B : Option ℕ} (hB : Valid s' m B) {z : Fin 4 → ℝ → ℂ} (hz : C.Spect z s s') :
    ‖C.H (slotPair z s s' (C.g v) (C.tv s' B)) - C.H (slotPair z s s' (C.g v) (C.f s'))‖ ≤
      Real.exp (-C.k m / 2) := by
  cases B with
  | none => simp only [tv, sub_self, norm_zero]; positivity
  | some h =>
    obtain ⟨h1, hpos, hmh⟩ := hB h rfl
    subst hpos
    have e := C.repl_bounded h1 (Ne.symm hss) hz.flip v
    rw [C.H_comm z (Ne.symm hss), C.H_comm z (Ne.symm hss)] at e
    simp only [tv]
    have hS := C.S_exp_le hv (lt_of_lt_of_le hvm hmh)
    have hk : Real.exp (-C.k h / 2) ≤ Real.exp (-C.k m / 2) :=
      Real.exp_le_exp.mpr (by linarith [C.k_mono (hv.trans hvm.le) hmh])
    linarith

theorem H_zero_left {s s' : Fin 4} (hss : s ≠ s') (z : Fin 4 → ℝ → ℂ) (Y : ℝ → ℂ) :
    C.H (slotPair z s s' 0 Y) = 0 := by
  rw [C.H_comm z hss]
  have h := slotPair_const_smul_right (r := C.r) (w := C.w) z s' s Y (0 : ℝ → ℂ) 0
  rw [zero_smul, zero_mul] at h
  exact h

/-! #### The tuple of the two earliest increments -/

/-- The previous value of the position updated at level `t` (zero before its first update). -/
noncomputable def prevProj (t : ℕ) : ℝ → ℂ := if t ≤ 4 then 0 else C.g (t - 4)

/-- The increment at level `t`. -/
noncomputable def incr (t : ℕ) : ℝ → ℂ := C.g t - C.prevProj t

/-- The last update level of position `l` before level `t`. -/
def lastLevel (l : Fin 4) (t : ℕ) : ℕ := t - (t + 4 - l) % 4

theorem stagPos_eq_iff (t : ℕ) (l : Fin 4) : stagPos t = l ↔ t % 4 = l := by
  constructor
  · rintro rfl; rfl
  · intro h; exact Fin.ext h

theorem lastLevel_spec {l : Fin 4} {t : ℕ} (hl : l ≠ stagPos t) (ht : 4 ≤ t) :
    stagPos (lastLevel l t) = l ∧ t - 3 ≤ lastLevel l t ∧ lastLevel l t < t := by
  have hl' : (l : ℕ) ≠ t % 4 := fun h => hl (Fin.ext (by simp [stagPos, h]))
  have hl4 := l.isLt
  refine ⟨(stagPos_eq_iff _ _).mpr ?_, ?_, ?_⟩ <;> unfold lastLevel <;> omega

/-- The current projection of position `l` after the updates of levels `≤ t` (zero before its
first update). -/
noncomputable def lastProj (l : Fin 4) (t : ℕ) : ℝ → ℂ :=
  if 1 ≤ lastLevel l t then C.g (lastLevel l t) else 0

/-- Blueprint eq:base-tuple (line 1583): `X_i = g_u - g_{u-4}`, `X_j = g_t - g_{t-4}` and
`X_e = F_e - g_{e,prev}` in the remaining slots. -/
noncomputable def tuple (u t : ℕ) (l : Fin 4) : ℝ → ℂ :=
  if l = stagPos u then C.incr u else if l = stagPos t then C.incr t
  else C.f l - C.lastProj l t

theorem tuple_late_j {u t : ℕ} (hut : stagPos u ≠ stagPos t) (ht : 5 ≤ t) :
    C.LateRep (stagPos t) (t - 4) (C.tuple u t (stagPos t)) := by
  have hne : ¬ t ≤ 4 := by omega
  refine ⟨some t, some (t - 4), fun ℓ h => ?_, fun ℓ h => ?_, ?_⟩
  · cases h; exact ⟨by omega, rfl, by omega⟩
  · cases h
    refine ⟨by omega, (stagPos_eq_iff _ _).mpr ?_, le_rfl⟩
    simp only [stagPos]; omega
  · simp [tuple, Ne.symm hut, incr, prevProj, hne, tv]

theorem tuple_late_other {u t : ℕ} {l : Fin 4} (hlu : l ≠ stagPos u) (hlt : l ≠ stagPos t)
    (ht : 4 ≤ t) : C.LateRep l (t - 3) (C.tuple u t l) := by
  obtain ⟨hp, h1, h2⟩ := lastLevel_spec hlt ht
  refine ⟨none, some (lastLevel l t), (fun ℓ h => by cases h), fun ℓ h => ?_, ?_⟩
  · cases h; exact ⟨by omega, hp, h1⟩
  · have h1' : 1 ≤ lastLevel l t := by omega
    simp [tuple, hlu, hlt, tv, lastProj, h1']

theorem tuple_late_i {u t : ℕ} (hu : 5 ≤ u) :
    C.LateRep (stagPos u) (u - 4) (C.tuple u t (stagPos u)) := by
  have hne : ¬ u ≤ 4 := by omega
  refine ⟨some u, some (u - 4), fun ℓ h => ?_, fun ℓ h => ?_, ?_⟩
  · cases h; exact ⟨by omega, rfl, by omega⟩
  · cases h
    refine ⟨by omega, (stagPos_eq_iff _ _).mpr ?_, le_rfl⟩
    simp only [stagPos]; omega
  · simp [tuple, incr, prevProj, hne, tv]

theorem tuple_i (u t : ℕ) : C.tuple u t (stagPos u) = C.g u - C.prevProj u := by
  simp [tuple, incr]

/-- The early slot against a late difference (blueprint line 1596, case `u < t - 4`): each of
its two old projections is tested directly. -/
theorem early_pair {s' : Fin 4} {u m : ℕ} (hu : 1 ≤ u) (hum : u < m) (hss : stagPos u ≠ s')
    {Y : ℝ → ℂ} (hY : C.LateRep s' m Y) {z : Fin 4 → ℝ → ℂ} (hz : C.Spect z (stagPos u) s') :
    ‖C.H (slotPair z (stagPos u) s' (C.g u - C.prevProj u) Y)‖ ≤
      4 * Real.exp (-C.k m / 2) := by
  obtain ⟨B₁, B₂, hB₁, hB₂, rfl⟩ := hY
  have hfin_prev : FinL2 C.a₀ C.r (C.prevProj u) := by
    unfold prevProj; split_ifs
    · exact FinL2.zero
    · exact C.finL2_g _
  have hYf := (C.finL2_tv s' B₁).sub (C.finL2_tv s' B₂)
  change ‖localProgressionForm C.r C.w _‖ ≤ _
  rw [slotPair_sub_left C.r_pos C.adm hss hz.ok (C.finL2_g u) hfin_prev hYf]
  have hold : ∀ v, 1 ≤ v → v < m →
      ‖C.H (slotPair z (stagPos u) s' (C.g v) (C.tv s' B₁ - C.tv s' B₂))‖ ≤
        2 * Real.exp (-C.k m / 2) := fun v hv hvm =>
    C.diff2_bound hz (C.finL2_g v) (C.finL2_tv s' B₁) (C.finL2_tv s' B₂)
      (C.H (slotPair z (stagPos u) s' (C.g v) (C.f s')))
      (C.old_term_bound hss hv hvm hB₁ hz) (C.old_term_bound hss hv hvm hB₂ hz)
  have h1 := hold u hu hum
  have h2 : ‖C.H (slotPair z (stagPos u) s' (C.prevProj u) (C.tv s' B₁ - C.tv s' B₂))‖ ≤
      2 * Real.exp (-C.k m / 2) := by
    unfold prevProj
    split_ifs with h
    · rw [C.H_zero_left hss, norm_zero]; positivity
    · exact hold (u - 4) (by omega) (by omega)
  calc _ ≤ _ := norm_sub_le _ _
    _ ≤ _ := add_le_add h1 h2
    _ = 4 * Real.exp (-C.k m / 2) := by ring

/-- Blueprint §11.2, line 1596: for `t ≥ 12` and the two earliest increment levels `u < t` in
distinct positions, every pair of full tuple arguments has bilinear norm at most
`8 e^{-k_{t-7}}`. -/
theorem tuple_pairSmall {u t : ℕ} (ht : 12 ≤ t) (hu : 1 ≤ u) (hut : u < t)
    (hpos : stagPos u ≠ stagPos t) {s s' : Fin 4} (hss : s ≠ s') :
    PairSmall C.a₀ C.r C.w s s' (C.tuple u t s) (C.tuple u t s')
      (8 * Real.exp (-C.k (t - 7))) := by
  intro z hzm hz2
  change ‖C.H (slotPair z s s' _ _)‖ ≤ _
  have hz : C.Spect z s s' := ⟨hzm, hz2⟩
  have hm : 1 ≤ t - 7 := by omega
  have hk47 : Real.exp (-C.k (t - 4) / 2) ≤ Real.exp (-C.k (t - 7)) :=
    Real.exp_le_exp.mpr (by linarith [C.k_grow (t - 7) (t - 4) hm (by omega)])
  have hexp := (Real.exp_pos (-C.k (t - 7))).le
  -- late representations of all slots except the early position
  have hlate : ∀ l, l ≠ stagPos u → C.LateRep l (t - 7) (C.tuple u t l) := by
    intro l hl
    by_cases hlt : l = stagPos t
    · subst hlt; exact (C.tuple_late_j hpos (by omega)).mono (by omega)
    · exact (C.tuple_late_other hl hlt (by omega)).mono (by omega)
  have hlate4 : ∀ l, l ≠ stagPos u → C.LateRep l (t - 4) (C.tuple u t l) := by
    intro l hl
    by_cases hlt : l = stagPos t
    · subst hlt; exact C.tuple_late_j hpos (by omega)
    · exact (C.tuple_late_other hl hlt (by omega)).mono (by omega)
  by_cases hlu : t - 3 ≤ u
  · -- late case: all projections have levels at least `t - 7`
    have hall : ∀ l, C.LateRep l (t - 7) (C.tuple u t l) := by
      intro l
      by_cases hl : l = stagPos u
      · subst hl; exact (C.tuple_late_i (by omega)).mono (by omega)
      · exact hlate l hl
    exact C.late_pair hss hm (hall s) (hall s') hz
  · -- early case `u < t - 4`
    have hu4 : u < t - 4 := by
      have : u ≠ t - 4 := by
        intro e; apply hpos; apply (stagPos_eq_iff _ _).mpr; simp only [stagPos]; omega
      omega
    by_cases hs1 : s = stagPos u
    · subst hs1
      rw [C.tuple_i]
      have := C.early_pair hu hu4 hss (hlate4 s' (Ne.symm hss)) hz
      linarith
    · by_cases hs2 : s' = stagPos u
      · subst hs2
        rw [C.H_comm z hss, C.tuple_i]
        have := C.early_pair hu hu4 (Ne.symm hss) (hlate4 s hss) hz.flip
        linarith
      · exact C.late_pair hss hm (hlate s hs1) (hlate s' hs2) hz

/-! #### The expansion at a finite cutoff -/

/-- The terminal residuals `F_p - (current projection)` after the updates of levels `≤ τ`. -/
noncomputable def tail (τ : ℕ) : Fin 4 → ℝ → ℂ := fun p => C.f p - C.lastProj p τ

theorem lastLevel_self {τ : ℕ} {p : Fin 4} (h : stagPos τ = p) : lastLevel p τ = τ := by
  have := (stagPos_eq_iff τ p).mp h
  unfold lastLevel; omega

theorem lastLevel_pred_self {τ : ℕ} {p : Fin 4} (h : stagPos τ = p) :
    lastLevel p (τ - 1) = τ - 4 := by
  have := (stagPos_eq_iff τ p).mp h
  have hp := p.isLt
  unfold lastLevel; omega

theorem lastLevel_pred_other {τ : ℕ} (hτ : 1 ≤ τ) {p : Fin 4} (h : stagPos τ ≠ p) :
    lastLevel p (τ - 1) = lastLevel p τ := by
  have h' : τ % 4 ≠ p := fun e => h ((stagPos_eq_iff τ p).mpr e)
  have hp := p.isLt
  unfold lastLevel; omega

theorem lastProj_zero (p : Fin 4) : C.lastProj p 0 = 0 := by
  simp [lastProj, lastLevel]

theorem lastProj_self {τ : ℕ} (hτ : 1 ≤ τ) : C.lastProj (stagPos τ) τ = C.g τ := by
  simp [lastProj, lastLevel_self rfl, hτ]

theorem lastProj_pred_self (τ : ℕ) : C.lastProj (stagPos τ) (τ - 1) = C.prevProj τ := by
  unfold lastProj prevProj
  rw [lastLevel_pred_self rfl]
  by_cases h : τ ≤ 4
  · simp [h]
  · have : 1 ≤ τ - 4 := by omega
    simp [h, this]

theorem lastProj_pred_other {τ : ℕ} (hτ : 1 ≤ τ) {p : Fin 4} (h : stagPos τ ≠ p) :
    C.lastProj p (τ - 1) = C.lastProj p τ := by
  unfold lastProj; rw [lastLevel_pred_other hτ h]

theorem finL2_lastProj (p : Fin 4) (τ : ℕ) : FinL2 C.a₀ C.r (C.lastProj p τ) := by
  unfold lastProj; split_ifs
  · exact C.finL2_g _
  · exact FinL2.zero

theorem finL2_prevProj (τ : ℕ) : FinL2 C.a₀ C.r (C.prevProj τ) := by
  unfold prevProj; split_ifs
  · exact FinL2.zero
  · exact C.finL2_g _

theorem finL2_incr (τ : ℕ) : FinL2 C.a₀ C.r (C.incr τ) := (C.finL2_g τ).sub (C.finL2_prevProj τ)

theorem finL2_tail (τ : ℕ) (p : Fin 4) : FinL2 C.a₀ C.r (C.tail τ p) :=
  (C.finL2_f p).sub (C.finL2_lastProj p τ)

theorem tail_zero : C.tail 0 = C.f := by
  funext p; simp [tail, lastProj_zero]

theorem tail_pred {τ : ℕ} (hτ : 1 ≤ τ) :
    C.tail (τ - 1) = Function.update (C.tail τ) (stagPos τ) (C.incr τ + C.tail τ (stagPos τ)) := by
  funext p
  by_cases hp : p = stagPos τ
  · subst hp
    rw [Function.update_self]
    simp only [tail, incr, lastProj_pred_self, lastProj_self C hτ]
    funext y; simp only [Pi.add_apply, Pi.sub_apply]; ring
  · rw [Function.update_of_ne hp]
    simp only [tail, lastProj_pred_other C hτ (Ne.symm hp)]

theorem H_update_add {W : Fin 4 → ℝ → ℂ} (hW : ∀ l, FinL2 C.a₀ C.r (W l)) (p : Fin 4)
    {A B : ℝ → ℂ} (hA : FinL2 C.a₀ C.r A) (hB : FinL2 C.a₀ C.r B) :
    C.H (Function.update W p (A + B)) = C.H (Function.update W p A) + C.H (Function.update W p B) :=
  localProgressionForm_update_add_two C.r_pos C.adm (fun l => (hW l).1) (fun l => (hW l).2) p
    hA.1 hB.1 hA.2 hB.2

/-- First increment decomposition: telescoping over the levels in time order. -/
theorem expansion_first (T : ℕ) :
    C.H C.f = C.H (C.tail T) + ∑ τ ∈ Finset.Icc 1 T,
      C.H (Function.update (C.tail τ) (stagPos τ) (C.incr τ)) := by
  induction T with
  | zero => simp [tail_zero]
  | succ T ih =>
    rw [ih, Finset.sum_Icc_succ_top (by omega)]
    have hstep := C.tail_pred (τ := T + 1) (by omega)
    simp only [Nat.add_sub_cancel] at hstep
    rw [hstep, C.H_update_add (C.finL2_tail (T + 1)) _ (C.finL2_incr _) (C.finL2_tail _ _),
      Function.update_eq_self]
    ring

/-- The inputs after the first increment `u` has been fixed in its slot. -/
noncomputable def W (u τ : ℕ) : Fin 4 → ℝ → ℂ :=
  Function.update (C.tail τ) (stagPos u) (C.incr u)

theorem finL2_W (u τ : ℕ) (l : Fin 4) : FinL2 C.a₀ C.r (C.W u τ l) := by
  unfold W
  by_cases hl : l = stagPos u
  · subst hl; rw [Function.update_self]; exact C.finL2_incr u
  · rw [Function.update_of_ne hl]; exact C.finL2_tail τ l

theorem W_update_eq_tuple {u τ : ℕ} (h : stagPos τ ≠ stagPos u) :
    Function.update (C.W u τ) (stagPos τ) (C.incr τ) = C.tuple u τ := by
  funext l
  unfold W tuple
  by_cases hlτ : l = stagPos τ
  · subst hlτ; simp [h]
  · rw [Function.update_of_ne hlτ]
    by_cases hlu : l = stagPos u
    · subst hlu; simp
    · rw [Function.update_of_ne hlu]; simp [hlu, hlτ, tail]

theorem W_step {u τ : ℕ} (hτ : 1 ≤ τ) :
    C.H (C.W u (τ - 1)) = C.H (C.W u τ) +
      if stagPos τ ≠ stagPos u then C.H (C.tuple u τ) else 0 := by
  by_cases h : stagPos τ = stagPos u
  · have he : C.W u (τ - 1) = C.W u τ := by
      funext l
      unfold W
      by_cases hl : l = stagPos u
      · subst hl; simp
      · rw [Function.update_of_ne hl, Function.update_of_ne hl]
        simp only [tail, lastProj_pred_other C hτ (fun e => hl (e.symm.trans h))]
    simp [he, h]
  · have he : C.W u (τ - 1) = Function.update (C.W u τ) (stagPos τ)
        (C.incr τ + C.W u τ (stagPos τ)) := by
      unfold W
      rw [C.tail_pred hτ, Function.update_comm (Ne.symm h) _ _,
        Function.update_of_ne h]
    rw [he, C.H_update_add (C.finL2_W u τ) _ (C.finL2_incr _) (C.finL2_W u τ _),
      Function.update_eq_self, C.W_update_eq_tuple h]
    simp [h]
    ring

/-- Second increment decomposition with the first increment fixed. -/
theorem expansion_second (u : ℕ) :
    ∀ T, u ≤ T → C.H (C.W u u) = C.H (C.W u T) + ∑ t ∈ Finset.Ioc u T,
      if stagPos t ≠ stagPos u then C.H (C.tuple u t) else 0 := by
  intro T hT
  induction T, hT using Nat.le_induction with
  | base => simp
  | succ T hT ih =>
    rw [ih, Finset.sum_Ioc_succ_top hT]
    have hs := C.W_step (u := u) (τ := T + 1) (by omega)
    simp only [Nat.add_sub_cancel] at hs
    rw [hs]
    ring

/-- Blueprint §11.2, line 1587: at a finite cutoff `T` the expansion of every input into its
increments and terminal residual groups exactly into the tuples `eq:base-tuple` of the two
earliest increments `u < t` (distinct positions), the terms with a single increment, and the
term with four terminal residuals. -/
theorem expansion (T : ℕ) :
    C.H C.f = C.H (C.tail T) + ∑ u ∈ Finset.Icc 1 T,
      (C.H (Function.update (C.tail T) (stagPos u) (C.incr u)) +
        ∑ t ∈ Finset.Ioc u T, if stagPos t ≠ stagPos u then C.H (C.tuple u t) else 0) := by
  rw [C.expansion_first T]
  congr 1
  refine Finset.sum_congr rfl fun u hu => ?_
  have hu' := Finset.mem_Icc.mp hu
  have h := C.expansion_second u T hu'.2
  simp only [W] at h
  exact h

/-! #### Sizes and remainders -/
theorem f_L2 (p : Fin 4) : eLpNorm (C.f p) 2 C.μ ≤ 1 := by
  have : IsProbabilityMeasure C.μ := normalizedIntervalMeasure_probability C.a₀ C.r_pos
  refine le_trans (eLpNorm_le_eLpNorm_of_exponent_le ?_) (C.f_norm p)
  rw [show (2 : ENNReal) = ENNReal.ofReal 2 by norm_num]
  exact ENNReal.ofReal_le_ofReal C.two_le_q

theorem lastProj_L2 (p : Fin 4) (τ : ℕ) : eLpNorm (C.lastProj p τ) 2 C.μ ≤ 1 := by
  unfold lastProj; split_ifs
  · exact C.g_L2 _
  · simp

theorem prevProj_L2 (τ : ℕ) : eLpNorm (C.prevProj τ) 2 C.μ ≤ 1 := by
  unfold prevProj; split_ifs
  · simp
  · exact C.g_L2 _

theorem sub_L2_le {X Y : ℝ → ℂ} (hX : eLpNorm X 2 C.μ ≤ 1) (hY : eLpNorm Y 2 C.μ ≤ 1) :
    eLpNorm (X - Y) 2 C.μ ≤ 2 :=
  (eLpNorm_sub_le (by norm_num)).trans (by
    calc eLpNorm X 2 C.μ + eLpNorm Y 2 C.μ ≤ 1 + 1 := add_le_add hX hY
      _ = 2 := by norm_num)

theorem incr_L2 (τ : ℕ) : eLpNorm (C.incr τ) 2 C.μ ≤ 2 := C.sub_L2_le (C.g_L2 τ) (C.prevProj_L2 τ)

theorem tail_L2 (τ : ℕ) (p : Fin 4) : eLpNorm (C.tail τ p) 2 C.μ ≤ 2 :=
  C.sub_L2_le (C.f_L2 p) (C.lastProj_L2 p τ)

/-- Blueprint line 1596: all tuple factors have bounded normalized `L²` norm. -/
theorem tuple_L2 (u t : ℕ) (l : Fin 4) : eLpNorm (C.tuple u t l) 2 C.μ ≤ 2 := by
  unfold tuple; split_ifs
  · exact C.incr_L2 u
  · exact C.incr_L2 t
  · exact C.sub_L2_le (C.f_L2 l) (C.lastProj_L2 l t)

theorem H_update_smul_self (F : Fin 4 → ℝ → ℂ) (l : Fin 4) (c : ℂ) :
    C.H (Function.update F l (c • F l)) = c * C.H F := by
  simp only [H]
  rw [localProgressionForm_update_const_smul, Function.update_eq_self]

/-- A pair estimate against spectators of normalized size at most `c`. -/
theorem pairSmall_scaled {p p' : Fin 4} (hpp : p ≠ p') {X Y : ℝ → ℂ} {η : ℝ}
    (h : PairSmall C.a₀ C.r C.w p p' X Y η) {F : Fin 4 → ℝ → ℂ} (hF : ∀ l, Measurable (F l))
    {c : ℝ} (hc : 0 < c) (hFc : ∀ l, l ≠ p → l ≠ p' → eLpNorm (F l) 2 C.μ ≤ ENNReal.ofReal c) :
    ‖C.H (slotPair F p p' X Y)‖ ≤ c ^ 2 * η := by
  obtain ⟨a, b, hab, hap, hap', hbp, hbp', hcov⟩ := fin4_other_two p p' hpp
  set z : Fin 4 → ℝ → ℂ := fun l => ((c : ℂ)⁻¹) • F l with hz
  have hc0 : (c : ℂ) ≠ 0 := by exact_mod_cast hc.ne'
  have hzm : ∀ l, Measurable (z l) := fun l => (hF l).const_smul _
  have hz1 : ∀ l, l ≠ p → l ≠ p' → eLpNorm (z l) 2 C.μ ≤ 1 := by
    intro l h1 h2
    rw [hz, eLpNorm_const_smul]
    calc ‖((c : ℂ))⁻¹‖ₑ * eLpNorm (F l) 2 C.μ ≤ ENNReal.ofReal c⁻¹ * ENNReal.ofReal c := by
          gcongr
          · rw [← ofReal_norm, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hc]
          · exact hFc l h1 h2
      _ = 1 := by
          rw [← ENNReal.ofReal_mul (inv_nonneg.mpr hc.le), inv_mul_cancel₀ hc.ne',
            ENNReal.ofReal_one]
  have hsmall := h z hzm hz1
  set G := slotPair z p p' X Y
  have he : slotPair F p p' X Y = Function.update (Function.update G a ((c : ℂ) • G a)) b
      ((c : ℂ) • (Function.update G a ((c : ℂ) • G a)) b) := by
    funext l
    have hGa : G a = z a := slotPair_other hap hap' X Y
    have hGb : G b = z b := slotPair_other hbp hbp' X Y
    rcases hcov l with rfl | rfl | rfl | rfl
    · simp [G, slotPair_left hpp, Function.update_of_ne hap.symm, Function.update_of_ne hbp.symm]
    · simp [G, slotPair_right, Function.update_of_ne hap'.symm, Function.update_of_ne hbp'.symm]
    · rw [Function.update_of_ne hab, Function.update_self, hGa, hz]
      simp only [smul_smul, mul_inv_cancel₀ hc0, one_smul]
      exact slotPair_other hap hap' X Y
    · rw [Function.update_self, Function.update_of_ne hab.symm, hGb, hz]
      simp only [smul_smul, mul_inv_cancel₀ hc0, one_smul]
      exact slotPair_other hbp hbp' X Y
  rw [he, C.H_update_smul_self, C.H_update_smul_self, norm_mul, norm_mul, Complex.norm_real,
    Real.norm_eq_abs, abs_of_pos hc]
  nlinarith [norm_nonneg (C.H G)]

theorem tail_late {T : ℕ} (hT : 4 ≤ T) (p : Fin 4) : C.LateRep p (T - 3) (C.tail T p) := by
  by_cases hp : p = stagPos T
  · subst hp
    refine ⟨none, some T, (fun ℓ h => by cases h), fun ℓ h => ?_, ?_⟩
    · cases h; exact ⟨by omega, rfl, by omega⟩
    · simp [tail, lastProj_self C (show 1 ≤ T by omega), tv]
  · obtain ⟨hpos, h1, _⟩ := lastLevel_spec hp hT
    refine ⟨none, some (lastLevel p T), (fun ℓ h => by cases h), fun ℓ h => ?_, ?_⟩
    · cases h; exact ⟨by omega, hpos, h1⟩
    · have h1' : 1 ≤ lastLevel p T := by omega
      simp [tail, lastProj, h1', tv]

theorem slotPair_self (F : Fin 4 → ℝ → ℂ) (p p' : Fin 4) : slotPair F p p' (F p) (F p') = F := by
  unfold slotPair
  rw [Function.update_eq_self, Function.update_eq_self]

theorem exists_two_ne : ∀ p : Fin 4, ∃ a b : Fin 4, a ≠ b ∧ a ≠ p ∧ b ≠ p := by decide

/-- Blueprint line 1594: the term with four terminal residuals tends to zero. -/
theorem remainder_four {T : ℕ} (hT : 4 ≤ T) :
    ‖C.H (C.tail T)‖ ≤ 4 * (8 * Real.exp (-C.k (T - 3))) := by
  have hm : 1 ≤ T - 3 := by omega
  have hps : PairSmall C.a₀ C.r C.w 0 1 (C.tail T 0) (C.tail T 1)
      (8 * Real.exp (-C.k (T - 3))) := fun z hzm hz2 =>
    C.late_pair (by decide) hm (C.tail_late hT 0) (C.tail_late hT 1) ⟨hzm, hz2⟩
  have h := C.pairSmall_scaled (by decide) hps (fun l => (C.finL2_tail T l).1) two_pos
    (fun l _ _ => by rw [show ENNReal.ofReal 2 = 2 by norm_num]; exact C.tail_L2 T l)
  rw [slotPair_self] at h
  linarith

/-- Blueprint line 1587: each term with a single increment and three terminal residuals tends
to zero. -/
theorem remainder_one {T : ℕ} (hT : 4 ≤ T) (u : ℕ) :
    ‖C.H (Function.update (C.tail T) (stagPos u) (C.incr u))‖ ≤
      4 * (8 * Real.exp (-C.k (T - 3))) := by
  have hm : 1 ≤ T - 3 := by omega
  obtain ⟨a, b, hab, hau, hbu⟩ := exists_two_ne (stagPos u)
  set F := Function.update (C.tail T) (stagPos u) (C.incr u)
  have hFa : F a = C.tail T a := Function.update_of_ne hau _ _
  have hFb : F b = C.tail T b := Function.update_of_ne hbu _ _
  have hps : PairSmall C.a₀ C.r C.w a b (F a) (F b) (8 * Real.exp (-C.k (T - 3))) := by
    rw [hFa, hFb]
    exact fun z hzm hz2 =>
      C.late_pair hab hm (C.tail_late hT a) (C.tail_late hT b) ⟨hzm, hz2⟩
  have hFm : ∀ l, FinL2 C.a₀ C.r (F l) := by
    intro l
    by_cases hl : l = stagPos u
    · subst hl; simp only [F, Function.update_self]; exact C.finL2_incr u
    · simp only [F, Function.update_of_ne hl]; exact C.finL2_tail T l
  have h := C.pairSmall_scaled hab hps (fun l => (hFm l).1) two_pos (fun l _ _ => by
    rw [show ENNReal.ofReal 2 = 2 by norm_num]
    by_cases hl : l = stagPos u
    · subst hl; simp only [F, Function.update_self]; exact C.incr_L2 u
    · simp only [F, Function.update_of_ne hl]; exact C.tail_L2 T l)
  rw [slotPair_self] at h
  linarith

end StaggerCell

/-! ### The accuracy schedule and the declaration `stagger` -/

/-- The accuracies `k_t = k_1^{A^{t-1}}`, so that `k_{t+1} = k_t^A`. -/
def stagAcc (k₁ A t : ℕ) : ℕ := k₁ ^ (A ^ (t - 1))

theorem stagAcc_pow {k₁ A v h : ℕ} (hv : 1 ≤ v) (hvh : v ≤ h) :
    stagAcc k₁ A h = stagAcc k₁ A v ^ (A ^ (h - v)) := by
  unfold stagAcc
  rw [← pow_mul, ← pow_add]
  congr 2
  omega

theorem le_stagAcc {k₁ A : ℕ} (hk : 1 ≤ k₁) (hA : 1 ≤ A) (t : ℕ) : k₁ ≤ stagAcc k₁ A t := by
  unfold stagAcc
  calc k₁ = k₁ ^ 1 := (pow_one _).symm
    _ ≤ k₁ ^ (A ^ (t - 1)) := Nat.pow_le_pow_right hk (Nat.one_le_pow _ _ hA)

theorem stagAcc_grow {k₁ A v h : ℕ} (hk : 1 ≤ k₁) (hA : 1 ≤ A) (hv : 1 ≤ v) (hvh : v < h) :
    stagAcc k₁ A v ^ A ≤ stagAcc k₁ A h := by
  rw [stagAcc_pow hv hvh.le]
  have h1 : 1 ≤ stagAcc k₁ A v := hk.trans (le_stagAcc hk hA v)
  refine Nat.pow_le_pow_right h1 ?_
  calc A = A ^ 1 := (pow_one _).symm
    _ ≤ A ^ (h - v) := Nat.pow_le_pow_right hA (by omega)

theorem sqrt_seventeen_le_exp_two : Real.sqrt 17 ≤ Real.exp 2 := by
  have h1 : Real.sqrt 17 ≤ 5 := by
    rw [Real.sqrt_le_left (by norm_num)]; norm_num
  have h2 : (5 : ℝ) ≤ Real.exp 2 := by
    have := Real.exp_one_gt_d9
    have e : Real.exp 2 = Real.exp 1 * Real.exp 1 := by rw [← Real.exp_add]; norm_num
    rw [e]; nlinarith
  linarith

/-- The supremum bound `√17 · B_k` is at most `exp(k^{C+1}/2)` for large `k`. -/
theorem budget_le_exp {Cq : ℝ} (hCq : 0 < Cq) {C : ℕ} {x : ℕ} (hx : 16 ≤ x)
    (hxC : 4 * Cq * 2 ^ C ≤ x) :
    Real.sqrt 17 * fitBudget Cq C x ≤ Real.exp ((x : ℝ) ^ (C + 1) / 2) := by
  have hx' : (16 : ℝ) ≤ x := by exact_mod_cast hx
  have hlog : Real.log 2 < 1 := by
    have := Real.log_two_lt_d9; linarith
  have hlog0 : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
  have h1 : 1 + Real.log 2 + x ≤ 2 * x := by linarith
  have h2 : Cq * (1 + Real.log 2 + x) ^ C ≤ (x : ℝ) ^ (C + 1) / 4 := by
    calc Cq * (1 + Real.log 2 + x) ^ C ≤ Cq * (2 * x) ^ C := by
          gcongr
    _ = Cq * 2 ^ C * (x : ℝ) ^ C := by rw [mul_pow]; ring
    _ ≤ (x / 4) * (x : ℝ) ^ C := by
          gcongr
          linarith
    _ = (x : ℝ) ^ (C + 1) / 4 := by ring
  have h3 : (2 : ℝ) ≤ (x : ℝ) ^ (C + 1) / 4 := by
    have : (x : ℝ) ≤ (x : ℝ) ^ (C + 1) := by
      calc (x : ℝ) = (x : ℝ) ^ 1 := (pow_one _).symm
        _ ≤ (x : ℝ) ^ (C + 1) := pow_le_pow_right₀ (by linarith) (by omega)
    linarith
  unfold fitBudget
  calc Real.sqrt 17 * Real.exp (Cq * (1 + Real.log 2 + x) ^ C)
      ≤ Real.exp 2 * Real.exp (Cq * (1 + Real.log 2 + x) ^ C) := by
        gcongr; exact sqrt_seventeen_le_exp_two
    _ = Real.exp (2 + Cq * (1 + Real.log 2 + x) ^ C) := by rw [← Real.exp_add]
    _ ≤ Real.exp ((x : ℝ) ^ (C + 1) / 2) := Real.exp_le_exp.mpr (by linarith)

/-- `8 e^{-y} ≤ e^{-2 √y}` for `y ≥ 16`. -/
theorem eight_exp_le {y : ℝ} (hy : 16 ≤ y) : 8 * Real.exp (-y) ≤ Real.exp (-2 * Real.sqrt y) := by
  have hs : 4 ≤ Real.sqrt y := by
    rw [show (4 : ℝ) = Real.sqrt 16 by
      rw [show (16 : ℝ) = 4 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]]
    exact Real.sqrt_le_sqrt hy
  have hsq : Real.sqrt y * Real.sqrt y = y := Real.mul_self_sqrt (by linarith)
  have h2 : 2 * Real.sqrt y ≤ y / 2 := by nlinarith
  have h8 : (8 : ℝ) ≤ Real.exp (y / 2) := by
    have := Real.add_one_le_exp (y / 2); linarith
  calc 8 * Real.exp (-y) ≤ Real.exp (y / 2) * Real.exp (-y) := by gcongr
    _ = Real.exp (-(y / 2)) := by rw [← Real.exp_add]; ring_nf
    _ ≤ Real.exp (-2 * Real.sqrt y) := Real.exp_le_exp.mpr (by linarith)

theorem PairSmall.mono {a₀ r : ℝ} {w : ℝ × ℝ → ℂ} {p p' : Fin 4} {X Y : ℝ → ℂ} {η η' : ℝ}
    (h : PairSmall a₀ r w p p' X Y η) (hη : η ≤ η') : PairSmall a₀ r w p p' X Y η' :=
  fun z hz hz2 => (h z hz hz2).trans hη

/-- The normalized `L²` norm of a fit is at most one. -/
theorem eLpNorm_fit_le {G : RealDyadicGrid} {I : ℤ × ℤ} {g : ℝ → ℂ} (hg : Measurable g)
    {S : ℝ} (hS : ∀ y, ‖g y‖ ≤ S)
    (h : ∫ y in dyadicGridCell G I.1 I.2, ‖g y‖ ^ 2 ≤ dyadicGridLength G I.1) :
    eLpNorm g 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ 1 := by
  have hr := dyadicGridLength_pos G I.1
  have : IsFiniteMeasure (volume.restrict (dyadicGridCell G I.1 I.2)) :=
    ⟨by rw [Measure.restrict_apply_univ, dyadicGridCell_volume]; exact ENNReal.ofReal_lt_top⟩
  have hmem : MemLp g 2 (volume.restrict (Set.Ico (dyadicGridLeft G I.1 I.2)
      (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1))) :=
    MemLp.of_bound hg.aestronglyMeasurable S (Filter.Eventually.of_forall hS)
  have := eLpNorm_normalized_le_of_integral hr hmem zero_le_one
    (by simpa only [one_pow, one_mul, dyadicGridCell] using h)
  rwa [ENNReal.ofReal_one] at this

end TrilinearHT.Auto

end

section

namespace TrilinearHT.Auto
open MeasureTheory Metric
open scoped FourierTransform ComplexConjugate ENNReal

namespace PathColumnSystem
variable {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {V : Type} [Fintype V]
  (P : PathColumnSystem G J N V)

theorem scalar_measurable (R : ℤ × ℤ) (v : V) : Measurable (P.scalar R v) := by
  classical
  unfold scalar
  refine Measurable.ite (dyadicGridCell_measurable _ _ _) ?_ (P.scalar_meas R v)
  have hF : Measurable (fun p : ℝ × ℤ => P.scalarAt (J.1 + N, p.2) v p.1) :=
    measurable_from_prod_countable_left fun m => P.scalar_meas (J.1 + N, m) v
  exact hF.comp (measurable_id.prodMk (dyadicIndex_measurable G (J.1 + N)))

theorem leaf_tree {y : ℝ} (hy : y ∈ dyadicGridCell G J.1 J.2) :
    pathLeaf G J N y ∈ dyadicFiniteTree G J N := by
  refine (dyadicFiniteTree_mem_iff G J _ N).mpr ⟨?_, by simp [pathLeaf]⟩
  exact dyadicGridCell_subset_of_common_point G (leaf_mem y) hy (by simp [pathLeaf])

/-- On a tree cell, the leaf-read scalar is the cellwise scalar of an available label. -/
theorem scalar_eq {R c : ℤ × ℤ} (hc : c ∈ dyadicFiniteTree G J N)
    (hcR : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G R.1 R.2) {v : V} (hv : v ∈ P.avail c)
    {y : ℝ} (hy : y ∈ dyadicGridCell G c.1 c.2) : P.scalar R v y = P.scalarAt c v y := by
  classical
  have hcm := (dyadicFiniteTree_mem_iff G J c N).mp hc
  have hyJ := hcm.1 hy
  have hl := leaf_tree (N := N) hyJ
  have hlc : dyadicGridCell G (pathLeaf G J N y).1 (pathLeaf G J N y).2 ⊆
      dyadicGridCell G c.1 c.2 :=
    dyadicGridCell_subset_of_common_point G (leaf_mem y) hy (by simp [pathLeaf]; omega)
  unfold scalar
  simp only [hcR hy, ↓reduceIte]
  exact P.consistent _ _ hl hc hlc v hv y (leaf_mem y)

/-- The column tree data rooted at a tree cell `R`, all labels born at `R`. -/
noncomputable def rooted (R : ℤ × ℤ) : ColumnTreeData V where
  grid := G
  cells := pathBelow G J N R
  root := R
  below_root := fun c hc => ((dyadicFiniteTree_mem_iff G R c _).mp hc).1
  birth := fun _ => R
  birth_mem := fun _ => dyadicFiniteTree_root_mem _ _ _
  scalar := P.scalar R
  scalar_measurable := P.scalar_measurable R
  privateWeight := P.weight
  privateWeight_pos := P.weight_pos
  budget := P.budget
  two_le_budget := P.two_le_budget
  private_lower := fun v => by
    have hs : 0 < Real.sqrt (P.weight v) := Real.sqrt_pos.mpr (P.weight_pos v)
    have hle : (Real.sqrt (P.weight v))⁻¹ ≤ P.budget := by
      unfold budget
      have h1 := Finset.single_le_sum (f := fun v => (Real.sqrt (P.weight v))⁻¹)
        (fun v _ => by positivity) (Finset.mem_univ v)
      have : (0 : ℝ) ≤ Fintype.card V := Nat.cast_nonneg _
      linarith
    calc P.budget⁻¹ ≤ ((Real.sqrt (P.weight v))⁻¹)⁻¹ :=
          inv_anti₀ (by positivity) hle
      _ = Real.sqrt (P.weight v) := inv_inv _
  column_bound := fun v => Filter.Eventually.of_forall fun y => by
    have h2 := norm_privateColumnValue_sq (P.scalar R) P.weight v y (P.weight_pos v).le
    have hb := P.scalar_bound' R v y
    have hle : ‖privateColumnValue (P.scalar R) P.weight v y‖ ^ 2 ≤ 2 ^ 2 := by
      rw [h2]; nlinarith [norm_nonneg (P.scalar R v y), P.weight_le v]
    exact (abs_le_of_sq_le_sq' hle (by norm_num)).2.trans P.two_le_budget
  path_count := fun y => by
    classical
    refine le_trans ?_ (show (Fintype.card V : ℝ) ≤ P.budget by
      unfold budget
      have : 0 ≤ ∑ v, (Real.sqrt (P.weight v))⁻¹ := Finset.sum_nonneg fun v _ => by positivity
      linarith)
    exact_mod_cast Finset.card_le_univ _

/-- The inherited mask of a rooted system. -/
noncomputable def mask (R : ℤ × ℤ) (hR : R ∈ dyadicFiniteTree G J N) :
    InheritedColumnMask (P.rooted R) where
  labels := P.avail
  available := fun c hc _ _ => ((dyadicFiniteTree_mem_iff G R c _).mp hc).1
  inherited := fun c hc d hd hcd =>
    P.avail_mono c d ((below_mem_iff hR c).mp hc).1 ((below_mem_iff hR d).mp hd).1 hcd

/-- The system rooted at `R` as a column depth family down to the leaves. -/
noncomputable def family (R : ℤ × ℤ) (hR : R ∈ dyadicFiniteTree G J N) :
    ColumnDepthFamily V where
  D := P.rooted R
  A := P.mask R hR
  N := J.1 + N
  root_le := ((dyadicFiniteTree_mem_iff G J R N).mp hR).2
  complete := fun c hc hcN => by
    have hend := dyadicRemainingDepth_endpoint G J N hR
    refine (dyadicFiniteTree_mem_iff G R c _).mpr ⟨hc, ?_⟩
    change c.1 ≤ J.1 + N at hcN
    omega

theorem column_memLp (c : ℤ × ℤ) (v : V) :
    MemLp ((dyadicGridCell G c.1 c.2).indicator (privateColumnValue (P.scalarAt c) P.weight v))
      2 volume := by
  refine (memLp_indicator_iff_restrict (dyadicGridCell_measurable G c.1 c.2)).mpr
    ?_
  have := cell_isFiniteMeasure G c.1 c.2
  refine MemLp.of_bound (privateColumnValue_measurable _ _ v (P.scalar_meas c
      v)).aestronglyMeasurable
    2 (Filter.Eventually.of_forall fun y => ?_)
  have h2 := norm_privateColumnValue_sq (P.scalarAt c) P.weight v y (P.weight_pos v).le
  have hle : ‖privateColumnValue (P.scalarAt c) P.weight v y‖ ^ 2 ≤ 2 ^ 2 := by
    rw [h2]; nlinarith [norm_nonneg (P.scalarAt c v y), P.scalar_bound c v y, P.weight_le v]
  exact (abs_le_of_sq_le_sq' hle (by norm_num)).2

/-- The column `1_c (φ_v, √ε_v e_v)` of the system at the cell `c`. -/
noncomputable def column (c : ℤ × ℤ) (v : V) : ColumnL2 V := (P.column_memLp c v).toLp _

/-- The range of the available columns at `c`. -/
noncomputable def range (c : ℤ × ℤ) : Submodule ℂ (ColumnL2 V) :=
  Submodule.span ℂ (P.column c '' (P.avail c : Set V))

instance (c : ℤ × ℤ) : FiniteDimensional ℂ (P.range c) :=
  FiniteDimensional.span_of_finite ℂ ((P.avail c).finite_toSet.image _)

/-- The cell projection of the system. -/
noncomputable def proj (c : ℤ × ℤ) : ColumnL2 V →L[ℂ] ColumnL2 V := (P.range c).starProjection

/-- The rooted cell projections are the root-independent system projections. -/
theorem rooted_proj {R c : ℤ × ℤ} (hR : R ∈ dyadicFiniteTree G J N)
    (hc : c ∈ (P.rooted R).cells) :
    cellColumnProjection (P.rooted R) (P.mask R hR) hc = P.proj c := by
  have hcT := (below_mem_iff hR c).mp hc
  have hrange : cellColumnRange (P.rooted R) (P.mask R hR) hc = P.range c := by
    unfold cellColumnRange range
    congr 1
    ext x
    simp only [Set.mem_range, Set.mem_image, Finset.mem_coe]
    have key : ∀ (v : V) (hv : v ∈ P.avail c),
        cellColumnLp (P.rooted R) (P.mask R hR) hc ⟨v, hv⟩ = P.column c v := by
      intro v hv
      refine Lp.ext ?_
      filter_upwards [cellColumnLp_coeFn (P.rooted R) (P.mask R hR) hc ⟨v, hv⟩,
        MemLp.coeFn_toLp (P.column_memLp c v)] with y h1 h2
      rw [h1, column, h2]
      by_cases hy : y ∈ dyadicGridCell G c.1 c.2
      · have hy' : y ∈ dyadicGridCell (P.rooted R).grid c.1 c.2 := hy
        rw [Set.indicator_of_mem hy, Set.indicator_of_mem hy']
        simp only [privateColumnValue, rooted]
        rw [P.scalar_eq hcT.1 hcT.2 hv hy]
      · have hy' : y ∉ dyadicGridCell (P.rooted R).grid c.1 c.2 := hy
        rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy']
    constructor
    · rintro ⟨⟨v, hv⟩, rfl⟩
      exact ⟨v, hv, (key v hv).symm⟩
    · rintro ⟨v, hv, rfl⟩
      exact ⟨⟨v, hv⟩, key v hv⟩
  unfold cellColumnProjection proj
  ext z : 1
  exact starProjection_congr hrange z

end PathColumnSystem

section Delayed
variable {V : Type*} [Fintype V]

/-- The delayed opponent is the current projection plus a rolling square-energy sequence, hence
admissible (blueprint lem:delay, line 1565; prop:base, line 1632). -/
theorem ColumnDepthFamily.delayed_admissible (Ψ : ColumnDepthFamily V)
    (f : Lp ℂ 2 (volume : Measure ℝ)) (K₀ : ℕ) :
    IsAdmissibleOpponent Ψ.D.grid Ψ.D.root (f : ℝ → ℂ) (Ψ.delayed f K₀)
      (2 * (compressionOneConst Ψ.D + K₀)) := by
  set Z := physicalColumnInput (V := V) f
  set cur : ℤ × ℤ → ℝ → ℂ := fun I y => (Ψ.proj I.1 Z : ℝ → ColumnHilbert V) y none
  set roll : ℤ × ℤ → ℝ → ℂ := fun I y =>
    (Ψ.proj (I.1 + K₀) Z : ℝ → ColumnHilbert V) y none -
      (Ψ.proj I.1 Z : ℝ → ColumnHilbert V) y none
  have hsplit : Ψ.delayed f K₀ = fun I y => cur I y + roll I y := by
    funext I y; simp only [ColumnDepthFamily.delayed, cur, roll]; ring
  have hcur : IsAdmissibleOpponent Ψ.D.grid Ψ.D.root (f : ℝ → ℂ) cur
      (compressionOneConst Ψ.D) :=
    (Ψ.current_admissible f).congr_cell fun I hI => by
      have h := Ψ.current_ae_proj f hI
      rw [ae_restrict_iff' (dyadicGridCell_measurable _ _ _)] at h
      filter_upwards [h] with y hy hyI
      exact (hy hyI).symm
  have hcm : ∀ I, MemLp (cur I) 2 (volume.restrict (dyadicGridCell Ψ.D.grid I.1 I.2)) :=
    fun I => ColumnDepthFamily.memLp_coord_restrict _ _
  have hrm : ∀ I, MemLp (roll I) 2 (volume.restrict (dyadicGridCell Ψ.D.grid I.1 I.2)) :=
    fun I => (ColumnDepthFamily.memLp_coord_restrict _ _).sub
      (ColumnDepthFamily.memLp_coord_restrict _ _)
  have hroll : IsAdmissibleOpponent Ψ.D.grid Ψ.D.root (f : ℝ → ℂ) roll K₀ := by
    refine isAdmissibleOpponent_squareEnergy _ _ roll (fun I => ?_) fun S hS => ?_
    · exact (memLp_indicator_iff_restrict
        (dyadicGridCell_measurable _ _ _)).mpr (hrm I)
    · have hr := Ψ.rolling_energy Z K₀ S hS
      rw [integral_physical_sq] at hr
      refine le_trans (Finset.sum_le_sum fun I _ => ?_) hr
      refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => by positivity)
        (((Lp.memLp _).sub (Lp.memLp _)).integrable_norm_pow two_ne_zero).integrableOn
        (Filter.Eventually.of_forall fun y => ?_)
      simp only [roll]
      have := norm_coord_le ((Ψ.proj (I.1 + K₀) Z : ℝ → ColumnHilbert V) y -
        (Ψ.proj I.1 Z : ℝ → ColumnHilbert V) y) none
      rw [PiLp.sub_apply] at this
      exact pow_le_pow_left₀ (norm_nonneg _) this 2
  rw [hsplit]
  have hc0 : 0 ≤ compressionOneConst Ψ.D := by
    unfold compressionOneConst
    exact pow_nonneg (mul_nonneg (by positivity)
      (Real.log_nonneg (by linarith [Ψ.D.two_le_budget]))) _
  exact hcur.add hc0 (Nat.cast_nonneg _) hroll hcm hrm

end Delayed

namespace PathColumnSystem
variable {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {V : Type} [Fintype V]
  (P : PathColumnSystem G J N V)

/-- An available label's rooted scalar is the cellwise scalar at the root, everywhere. -/
theorem scalar_root {R : ℤ × ℤ} (hR : R ∈ dyadicFiniteTree G J N) {v : V} (hv : v ∈ P.avail R)
    (y : ℝ) : P.scalar R v y = P.scalarAt R v y := by
  classical
  by_cases hy : y ∈ dyadicGridCell G R.1 R.2
  · exact P.scalar_eq hR subset_rfl hv hy
  · unfold scalar; simp only [hy, ↓reduceIte]

end PathColumnSystem

section ColRange2
variable {V : Type} [Fintype V]

/-- Scalars bounded by one and weights in `[0, 1]` for all labels. -/
def ColData (sc : V → ℝ → ℂ) (wt : V → ℝ) : Prop :=
  ∀ v, Measurable (sc v) ∧ (∀ y, ‖sc v y‖ ≤ 1) ∧ 0 ≤ wt v ∧ wt v ≤ 1

end ColRange2




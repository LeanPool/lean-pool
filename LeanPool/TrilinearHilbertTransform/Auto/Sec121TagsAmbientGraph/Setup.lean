          nlinarith only [hτ, this, e]
  obtain ⟨q, hq, hXq⟩ := exists_large_retained_term cf _ size hcs hcsum hEs0
    hXb (by positivity) hτ.le htail'
    (by rw [hHS.tsum_eq]; exact hlt)
  -- the retained time factor

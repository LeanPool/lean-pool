    (fun t => (hbdd q).2.2 t) plateauTwo_integrable (fun u hu => plateauTwo_eq_one hu) hM
    ((hzm a).mul (quadraticChartAtom_measurable _)) ((hzm b).mul (quadraticChartAtom_measurable _))

      (mul_le_mul_of_nonneg_left hq.le hEs0.le) 6).trans hH₁E
  refine ⟨φt q, quadraticChartComplexity_mono (hcomp q).2.2 hHq, (htag q).1, (htag q).2.1,
    (htag q).2.2, fun s hs => ?_⟩
  by_contra hcon
  simp only [not_exists, not_lt] at hcon
  have hM : ∀ ξ, ‖∫ u, quadraticChartAtom (φt q) (r * u) * (plateauTwo u : ℂ) *

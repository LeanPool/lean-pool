  obtain ⟨hHS, hXb⟩ := localProgressionForm_pair_expansion hr hw hai hak hab hik hib hkb (hzm a)
    (hzm b) zero_le_one (by rw [ENNReal.ofReal_one]; exact hza) hzb cf
    (fun q => quadraticChartAtom (φa q)) (fun q => quadraticChartAtom (φb q))
    (fun q => quadraticChartAtom (φt q)) (fun q => quadraticChartAtom_measurable _)
    (fun q => quadraticChartAtom_measurable _) (fun q => quadraticChartAtom_measurable _)
    (fun q => (hbdd q).1) (fun q => (hbdd q).2.1) (fun q => (hbdd q).2.2) hcs hexp' f hfa hfi hfk
    hfb
  -- the shell selection
  have htail' : (∑' q, if T₀ ≤ size q then ‖cf q‖ else 0) * (W' * 1) ≤ τ / 2 := by
    have ht := htail T₀ hT₀1
    have hT100 : T₀ ≤ T₀ ^ 100 := le_self_pow₀ hT₀1 (by norm_num)
    have hT0 : 0 < T₀ := by linarith
    have hsT : (∑' q, if T₀ ≤ size q then ‖cf q‖ else 0) ≤ Es / T₀ :=
      ht.trans (div_le_div_of_nonneg_left hEs0.le hT0 hT100)
    rw [mul_one]

  have heq : ∑ i ∈ T, (roleCoeff i l : ℝ) * x i +
      36 * ∑ k, (((m k - (l : ℕ) * n k : ℤ)) : ℝ) * ζ k =
      (∑ r : Fin 4, ((r : ℕ) : ℝ) * x r + 36 * ∑ p, (m p : ℝ) * ζ p) -

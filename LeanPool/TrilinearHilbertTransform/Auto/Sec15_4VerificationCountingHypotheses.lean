/-- The tested-tuple multiplicity `L₀` of `tested_scale_mult` for four cores
(`L₀ ≤ P^C (1 + log(ν/μ))^C`, blueprint line 2723). -/
noncomputable def fourMult (d : ℕ) (B μ ν : ℝ) : ℝ :=
  32 * ((4 + d : ℕ) + 1 : ℝ) ^ 4 * (Real.log (2 * (36 * (4 * B))) + Real.log (2 * (4 * ν) / μ))

theorem one_le_fourMult (d : ℕ) {B μ ν : ℝ} (hB : 1 ≤ B) (hμ : 0 < μ) (hμν : μ ≤ ν) :
    1 ≤ fourMult d B μ ν := by
  unfold fourMult
  have h1 : (1 : ℝ) ≤ ((4 + d : ℕ) + 1 : ℝ) := by
    have : (0 : ℝ) ≤ ((4 + d : ℕ) : ℝ) := Nat.cast_nonneg _
    linarith
  have h2 : (1 : ℝ) ≤ ((4 + d : ℕ) + 1 : ℝ) ^ 4 := one_le_pow₀ h1
  have h3 : 1 ≤ Real.log (2 * (36 * (4 * B))) := by
    rw [Real.le_log_iff_exp_le (by positivity)]
    have := Real.exp_one_lt_d9
    nlinarith only [hB, this]
  have h4 : 0 ≤ Real.log (2 * (4 * ν) / μ) :=
    Real.log_nonneg (by rw [le_div_iff₀ hμ]; nlinarith)
  nlinarith

/-- Pair determination across all scales gives the total count: if two labels in roles `i ≠ j`
determine the tuple across the scales and each tuple occurs at most `L` times, then
`Σ_s N_s ≤ L M_i M_j` (blueprint `eq:total-count`, first bound). -/
theorem total_count_real (S : Finset ℤ) (E : ℤ → Finset (Fin 4 → ℝ)) (A : Fin 4 → Finset ℝ)
    {i j : Fin 4} (hA : ∀ s ∈ S, ∀ x ∈ E s, x i ∈ A i ∧ x j ∈ A j)
    (hpair : ∀ s ∈ S, ∀ s' ∈ S, ∀ x ∈ E s, ∀ x' ∈ E s', x i = x' i → x j = x' j → x = x')
    {L : ℝ} (hmult : ∀ x, ((S.filter fun s => x ∈ E s).card : ℝ) ≤ L) :
    ∑ s ∈ S, ((E s).card : ℝ) ≤ L * (A i).card * (A j).card := by
  classical
  have hL0 : 0 ≤ L := le_trans (Nat.cast_nonneg _) (hmult 0)
  have hnat := total_count_le S E (fun x => (x i, x j)) (A i ×ˢ A j)
    (fun s hs x hx => Finset.mem_product.mpr (hA s hs x hx)) ⌊L⌋₊
    (fun p _ => by
      by_cases hex : ∃ s ∈ S, ∃ x ∈ E s, (x i, x j) = p
      · obtain ⟨s₀, hs₀, x₀, hx₀, hp⟩ := hex
        have hfib : ∀ s ∈ S, (E s).filter (fun x => (x i, x j) = p) ⊆ {x₀} := by
          intro s hs x hx
          obtain ⟨hxE, hxp⟩ := Finset.mem_filter.mp hx
          rw [← hp] at hxp
          simp only [Prod.mk.injEq] at hxp
          exact Finset.mem_singleton.mpr (hpair s hs s₀ hs₀ x hxE x₀ hx₀ hxp.1 hxp.2)
        have hle : ∑ s ∈ S, ((E s).filter fun x => (x i, x j) = p).card ≤
            (S.filter fun s => x₀ ∈ E s).card := by
          rw [Finset.card_filter]
          refine Finset.sum_le_sum fun s hs => ?_
          split_ifs with h
          · exact (Finset.card_le_card (hfib s hs)).trans (by simp)
          · have : (E s).filter (fun x => (x i, x j) = p) = ∅ := by
              refine Finset.eq_empty_of_forall_notMem fun x hx => ?_
              have := Finset.mem_singleton.mp (hfib s hs hx)
              subst this
              exact h (Finset.mem_filter.mp hx).1
            rw [this, Finset.card_empty]
        exact hle.trans (Nat.le_floor (hmult x₀))
      · push Not at hex
        have : ∀ s ∈ S, (E s).filter (fun x => (x i, x j) = p) = ∅ := fun s hs =>
          Finset.eq_empty_of_forall_notMem fun x hx =>
            hex s hs x (Finset.mem_filter.mp hx).1 (Finset.mem_filter.mp hx).2
        rw [Finset.sum_congr rfl fun s hs => by rw [this s hs]]
        simp)
  have hcast : (((∑ s ∈ S, (E s).card : ℕ)) : ℝ) ≤ ((⌊L⌋₊ * (A i ×ˢ A j).card : ℕ) : ℝ) :=
    Nat.cast_le.mpr hnat
  push_cast at hcast
  rw [Finset.card_product, Nat.cast_mul] at hcast
  calc ∑ s ∈ S, ((E s).card : ℝ) ≤ (⌊L⌋₊ : ℝ) * (((A i).card : ℝ) * (A j).card) := hcast
    _ ≤ L * (((A i).card : ℝ) * (A j).card) :=
        mul_le_mul_of_nonneg_right (Nat.floor_le hL0) (by positivity)
    _ = _ := by ring

/-- The tested-tuple multiplicity `L₀` of `tested_scale_mult` for three cores. -/
noncomputable def threeMult (d : ℕ) (B μ ν : ℝ) : ℝ :=
  32 * ((4 + d : ℕ) + 1 : ℝ) ^ 4 * (Real.log (2 * (36 * B)) + Real.log (2 * ν / μ))

theorem one_le_threeMult (d : ℕ) {B μ ν : ℝ} (hB : 1 ≤ B) (hμ : 0 < μ) (hμν : μ ≤ ν) :
    1 ≤ threeMult d B μ ν := by
  unfold threeMult
  have h1 : (1 : ℝ) ≤ ((4 + d : ℕ) + 1 : ℝ) := by
    have : (0 : ℝ) ≤ ((4 + d : ℕ) : ℝ) := Nat.cast_nonneg _
    linarith
  have h2 : (1 : ℝ) ≤ ((4 + d : ℕ) + 1 : ℝ) ^ 4 := one_le_pow₀ h1
  have h3 : 1 ≤ Real.log (2 * (36 * B)) := by
    rw [Real.le_log_iff_exp_le (by positivity)]
    have := Real.exp_one_lt_d9
    nlinarith only [hB, this]
  have h4 : 0 ≤ Real.log (2 * ν / μ) :=
    Real.log_nonneg (by rw [le_div_iff₀ hμ]; nlinarith)
  nlinarith

theorem prod_ite_one_erase {l : Fin 4} (f : Fin 4 → ℝ) :
    ∏ j, (if j = l then (1 : ℝ) else f j) = ∏ j ∈ Finset.univ.erase l, f j := by
  rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ l), ite_eq_left_of_eq_true _ _ (eq_true rfl),
    one_mul]
  exact Finset.prod_congr rfl fun j hj =>
    ite_eq_right_iff.mpr fun h => absurd h (Finset.ne_of_mem_erase hj)


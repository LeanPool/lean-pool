    (hM : ∀ i, i ≠ l → ((S.biUnion fun s => (D.threePathE G h xs l cellOf ancOf Iw c κ s).image
      fun x => x i).card : ℝ) ≤ M)
    (hMl : ∑ s ∈ S, D.sideWeight G l cellOf c.2.2.2.1 s ≤ M) {δ : ℝ} (hδ0 : 0 < δ)

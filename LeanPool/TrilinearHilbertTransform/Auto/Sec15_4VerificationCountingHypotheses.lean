  have hc : (Finset.univ.erase l).card = 3 := by simp
  have hmemc : ∀ i, i ∈ Finset.univ.erase l ↔ i ≠ l := fun i => by simp
  obtain ⟨w, hw0, hwsum, hwinc⟩ := hw
  refine hsc d ζ (Finset.univ.erase l) (Or.inl hc) A M L hM hL

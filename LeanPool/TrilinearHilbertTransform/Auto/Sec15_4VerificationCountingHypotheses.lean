    (ε := 2 * ν * max R R') ((abs_sub _ _).trans (by linarith))
    ((abs_sub _ _).trans (by linarith)) hsep hQ ?_
  have := mul_le_mul_of_nonneg_right hSg (le_max_of_le_left hR : 0 ≤ max R R')

  · push_cast
    calc |(m p : ℝ) - ((l : ℕ) : ℝ) * n p| ≤ |(m p : ℝ)| + |((l : ℕ) : ℝ) * n p| := abs_sub _ _
      _ = |(m p : ℝ)| + ((l : ℕ) : ℝ) * |(n p : ℝ)| := by rw [abs_mul, abs_of_nonneg hl0]

section HereditaryRepresentatives
variable {ι α : Type*} (E : ι → Finset α) (lt : ι → ι → Prop) (d : ι → ℕ)
  (hd : ∀ c c', lt c c' → d c < d c') (dflt : α)

/-! ### Hereditary representatives (blueprint lines 2172-2191) -/

open Classical in
/-- Blueprint lines 2181-2182 ("process pre-cells chronologically: inherit an earlier
representative when its predecessor is contained, otherwise pick any mode"): the representative
of `c'` is that of some earlier `c` with `E c ⊆ E c'`, if there is one, and otherwise a fixed
element of `E c'`. -/
noncomputable def hereditaryRep {ι α : Type*} (E : ι → Finset α) (lt : ι → ι → Prop)
    (d : ι → ℕ) (hd : ∀ c c', lt c c' → d c < d c') (dflt : α) (c' : ι) : α :=
  if h : ∃ c, lt c c' ∧ E c ⊆ E c' then hereditaryRep E lt d hd dflt (Classical.choose h)
  else if hne : (E c').Nonempty then Classical.choose hne else dflt
termination_by d c'
decreasing_by exact hd _ _ (Classical.choose_spec h).1

open Classical in
theorem hereditaryRep_eq (c' : ι) : hereditaryRep E lt d hd dflt c' =
    if h : ∃ c, lt c c' ∧ E c ⊆ E c' then hereditaryRep E lt d hd dflt (Classical.choose h)
    else if hne : (E c').Nonempty then Classical.choose hne else dflt := by
  rw [hereditaryRep]

/-- Representatives lie in their predecessor sets. -/
theorem hereditaryRep_mem (hne : ∀ c, (E c).Nonempty) (c : ι) :
    hereditaryRep E lt d hd dflt c ∈ E c := by
  induction hn : d c using Nat.strong_induction_on generalizing c with
  | _ n ih =>
    rw [hereditaryRep_eq]
    split_ifs with h h'
    · have hs := Classical.choose_spec h
      exact hs.2 (ih _ (hn ▸ hd _ _ hs.1) _ rfl)
    · exact Classical.choose_spec h'
    · exact absurd (hne c) h'

end HereditaryRepresentatives

namespace ModeComponents
variable {Mode Mode' P : Type*} [DecidableEq Mode] [DecidableEq Mode'] [DecidableEq P]

/-- Blueprint lines 2176-2181 (nesting of predecessors along a link): let `f` transport an earlier
component system `C` into a later one `C'` on a descendant pre-cell, preserving primaries, PRE
components and CURRENT components. If `m` is good at `h` in `C`, `m'` is good at `h` in `C'`,
`f m` lies in the later CURRENT component of `m'`, the later system stabilizes good primaries,
and the later predecessor has fewer than twice the primaries of the earlier one (equal first type
coordinates), then the earlier PRE predecessor is transported into the later one. -/
theorem predecessor_nesting (C : ModeComponents Mode P) (C' : ModeComponents Mode' P)
    (f : Mode → Mode') (hπ : ∀ x, C'.π (f x) = C.π x)
    (hE : ∀ h x y, y ∈ C.E h x → f y ∈ C'.E h (f x))
    (hF : ∀ h x y, y ∈ C.F h x → f y ∈ C'.F h (f x))
    (Δ : ℕ) (goodP : ℕ → P → Prop) [∀ h, DecidablePred (goodP h)] {h : ℕ}
    (hstab : ∀ z z', goodP h (C'.π z) → C'.π z' = C'.π z → z' ∈ C'.F h z →
      z' ∈ C'.E (h - Δ) z)
    {m : Mode} {m' : Mode'} (hm' : C'.Good Δ goodP h m')
    (hlink : f m ∈ C'.F h m')
    (htype : (C'.labels (C'.E (h - Δ) m')).card < 2 * (C.labels (C.E (h - Δ) m)).card) :
    (C.E (h - Δ) m).image f ⊆ C'.E (h - Δ) m' := by
  set Fl := C'.F h m'
  set El := C'.E (h - Δ) m'
  set Ee := (C.E (h - Δ) m).image f
  have hFm : C'.F h (f m) = Fl := C'.F_comp h m' (f m) hlink
  have hEe : Ee ⊆ Fl := by
    intro z hz
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hz
    have hyF : y ∈ C.F h m := C.F_mono (h - Δ) h m (Nat.sub_le _ _) (C.E_le_F _ m hy)
    rw [← hFm]
    exact hF h m y hyF
  have hEl : El ⊆ Fl := (C'.E_le_F _ m').trans (C'.F_mono _ _ m' (Nat.sub_le _ _))
  have hlab : Ee.image C'.π = C.labels (C.E (h - Δ) m) := by
    simp only [Ee, Finset.image_image, labels]
    congr 1
    funext x
    exact hπ x
  obtain ⟨-, hBF, hGF⟩ := hm'
  refine early_predecessor_nested C'.π Fl El Ee (goodP h) hEe hEl hBF ?_ hGF ?_
  · change (C'.labels El).card < 2 * (Ee.image C'.π).card
    rw [hlab]
    exact htype
  · intro x hx x' hx' hxx' hg
    -- the common good primary joins `x` to the later predecessor
    have hxEl : x ∈ El := by
      have h1 := hstab x' x (hxx' ▸ hg) hxx' (by
        rw [C'.F_comp h m' x' (hEl hx'), ← C'.F_comp h m' x (hEe hx)]
        exact C'.E_le_F h x (C'.E_self h x))
      have h2 : C'.E (h - Δ) x' = El := C'.E_comp _ m' x' hx'
      rw [h2] at h1
      exact h1
    obtain ⟨y₀, hy₀, rfl⟩ := Finset.mem_image.mp hx
    intro z hz
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hz
    have hyy : y ∈ C.E (h - Δ) y₀ := by rw [C.E_comp _ m y₀ hy₀]; exact hy
    have h3 := hE _ y₀ y hyy
    have h4 : C'.E (h - Δ) (f y₀) = El := C'.E_comp _ m' (f y₀) hxEl
    rw [h4] at h3
    exact h3

/-- The type coordinates (blueprint line 2174): sizes with equal `⌊log₂ ·⌋` differ by less than
a factor two. -/
theorem card_lt_two_mul_of_log2_eq {a b : ℕ} (ha : 0 < a)
    (hlog : Nat.log 2 a = Nat.log 2 b) : b < 2 * a := by
  have h1 := Nat.lt_pow_succ_log_self (b := 2) (by norm_num) b
  have h2 := Nat.pow_log_le_self 2 ha.ne'
  rw [← hlog, pow_succ] at h1
  omega

end ModeComponents


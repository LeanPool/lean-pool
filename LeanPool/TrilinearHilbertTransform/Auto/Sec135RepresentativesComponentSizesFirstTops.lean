  · obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp he
    obtain ⟨hpT, hR⟩ := Finset.mem_filter.mp hp
    exact (hdec G p (Finset.mem_filter.mp hpT).1 hR).1
  · obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp he
    obtain ⟨hpT, hR⟩ := Finset.mem_filter.mp hp

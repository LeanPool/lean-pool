variable {Mode P : Type*} [Fintype Mode] [DecidableEq Mode] [DecidableEq P]

/-! ### Separation of representative frequencies (`eq:representative-separation`, 2184-2192) -/

theorem ofEdges_F_of_cur (pre cur : ℕ → Mode → Mode → Prop) (π : Mode → P)
    (hle : ∀ h m m', pre h m m' → cur h m m')
    (hpre : ∀ h h' m m', h ≤ h' → pre h m m' → pre h' m m')
    (hcur : ∀ h h' m m', h ≤ h' → cur h m m' → cur h' m m') {h : ℕ} {m m' : Mode}
    (hmm' : cur h m m') : m' ∈ (ofEdges pre cur π hle hpre hcur).F h m := by
  classical
  by_cases he : m = m'
  · subst he
    exact (ofEdges pre cur π hle hpre hcur).E_le_F h m
      ((ofEdges pre cur π hle hpre hcur).E_self h m)
  · simp only [ofEdges, Finset.mem_filter, Finset.mem_univ, true_and]
    exact SimpleGraph.Adj.reachable (by simp [SimpleGraph.fromRel_adj, he, hmm'])

end ModeComponents

namespace ModeSchedule
variable (S : ModeSchedule)

/-- Blueprint line 2192: without a gap edge at height `h`, every allowed shift leaves the affine
frequency difference above `θ` at some point, hence above `θ/2` on the whole cell when its
variation over the cell is at most `θ/2` (`eq:slope-variation`). -/
theorem sep_of_not_gapEdge {Mode : Type*} {dz : ℕ} (ω : Mode → ℝ → ℝ) (ϑ : Fin dz → ℝ)
    (a r θr : ℝ) {h : ℕ} {m m' : Mode} (hne : ¬ S.gapEdge ω ϑ a r θr h m m') {lam γ : ℝ}
    (haff : ∀ x, ω m x - ω m' x = 2 * lam * x + γ) (hvar : 2 * |lam| * r ≤ θr / 2)
    (n : Fin dz → ℤ) (hn : ∀ i, |(n i : ℝ)| ≤ S.Eh h) :
    ∀ x ∈ Set.Icc a (a + r), θr / 2 < |ω m x - ω m' x + (∑ i, (n i : ℝ) * ϑ i) / Lh h| := by
  have hx0 : ∃ x₀ ∈ Set.Icc a (a + r),
      θr < |ω m x₀ - ω m' x₀ + (∑ i, (n i : ℝ) * ϑ i) / Lh h| := by
    by_contra hno
    push Not at hno
    exact hne ⟨n, hn, hno⟩
  obtain ⟨x₀, hx₀, hlarge⟩ := hx0
  set c := (∑ i, (n i : ℝ) * ϑ i) / Lh h
  have hsep := affine_separation_on_cell (lam := lam) (γ := γ + c) hx₀ (by
    rw [haff] at hlarge; rwa [add_assoc] at hlarge) hvar
  intro x hx
  have := hsep x hx
  rw [haff, add_assoc]
  exact this

end ModeSchedule

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0)

/-- Blueprint `eq:representative-separation` (lines 2184-2192): two modes alive on the pre-cell
`J'` of block `b'` that lie in different CURRENT components at height `h` have, for every allowed
shift `n`, frequency difference above `Ξ / (2 r_{t_{b'}})` on the whole pre-cell, when the
curvature difference obeys `eq:slope-variation`; on actual cells `I, I'` of length at least
`r_{t_{b'}}` this is at least `(Ξ/2) max(|I|⁻¹, |I'|⁻¹)`. -/
theorem representative_separation {b' : ℤ} {J' : ℤ × ℤ} (hJ' : J'.1 = b' - 2 * S.K) {h : ℕ}
    {z z' : Ms.alive (ancAt Gd J' (b' - 4 * S.K))}
    (hzF : z ∉ (Ms.blockComps S hA b' J').F h z')
    (hvar : 2 * |Ms.lamOf z'.1 - Ms.lamOf z.1| * dyadicGridLength Gd J'.1 ≤
      S.Ξ / dyadicGridLength Gd (b' + S.K) / 2)
    (n : Fin Ms.zc.dim → ℤ) (hn : ∀ i, |(n i : ℝ)| ≤ S.Eh h) {rI rI' : ℝ}
    (hrI : dyadicGridLength Gd (b' + S.K) ≤ rI) (hrI' : dyadicGridLength Gd (b' + S.K) ≤ rI') :
    ∀ x ∈ Set.Icc (dyadicGridLeft Gd J'.1 J'.2) (dyadicGridLeft Gd J'.1 J'.2 +
        dyadicGridLength Gd J'.1),
      S.Ξ / 2 * max rI⁻¹ rI'⁻¹ < |Ms.slope z'.1 x - Ms.slope z.1 x +
        (∑ i, (n i : ℝ) * (Ms.zc.θ i / S.Q0)) / ModeSchedule.Lh h| := by
  have hK : (0 : ℤ) ≤ S.K := Nat.cast_nonneg _
  have h1 : J'.1 ≤ b' + S.K := by rw [hJ']; omega
  have hrt := dyadicGridLength_pos Gd (b' + S.K)
  -- no CURRENT edge between the two modes
  have hne : ¬ S.gapEdge
      (fun (x : Ms.alive (ancAt Gd J' (b' - 4 * S.K))) (y : ℝ) => Ms.slope x.1 y)
      (fun l => Ms.zc.θ l / S.Q0)
      (dyadicGridLeft Gd J'.1 J'.2) (dyadicGridLength Gd J'.1)
      (S.Ξ / dyadicGridLength Gd (b' + S.K)) h z' z := by
    intro hedge
    apply hzF
    rw [Ms.blockComps_eq S hA h1]
    unfold preComps ModeSchedule.preCurrent
    exact ModeComponents.ofEdges_F_of_cur _ _ _ _ _ _ hedge
  have hsep := S.sep_of_not_gapEdge
    (fun (x : Ms.alive (ancAt Gd J' (b' - 4 * S.K))) (y : ℝ) => Ms.slope x.1 y)
    (fun l => Ms.zc.θ l / S.Q0)
    (dyadicGridLeft Gd J'.1 J'.2) (dyadicGridLength Gd J'.1)
    (S.Ξ / dyadicGridLength Gd (b' + S.K)) hne (lam := Ms.lamOf z'.1 - Ms.lamOf z.1)
    (γ := -2 * Ms.lamOf z'.1 * dyadicGridLeft Gd (Ms.cellOf z'.1).1 (Ms.cellOf z'.1).2 +
      Ms.γOf z'.1 + 2 * Ms.lamOf z.1 * dyadicGridLeft Gd (Ms.cellOf z.1).1 (Ms.cellOf z.1).2 -
      Ms.γOf z.1) (fun x : ℝ => by simp only [slope]; ring) hvar n hn
  intro x hx
  refine lt_of_le_of_lt ?_ (hsep x hx)
  have hΞ := Ξ_nonneg S
  have hmax : max rI⁻¹ rI'⁻¹ ≤ (dyadicGridLength Gd (b' + S.K))⁻¹ :=
    max_le (inv_anti₀ hrt hrI) (inv_anti₀ hrt hrI')
  calc S.Ξ / 2 * max rI⁻¹ rI'⁻¹ ≤ S.Ξ / 2 * (dyadicGridLength Gd (b' + S.K))⁻¹ :=
        mul_le_mul_of_nonneg_left hmax (div_nonneg hΞ (by norm_num))
    _ = S.Ξ / dyadicGridLength Gd (b' + S.K) / 2 := by ring

end ModeSystem

section LowerAlmostOrthogonal
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-! ### Component sizes (blueprint lines 2193-2209, `eq:size-comparison`) -/

/-- The lower half of `almost_orthogonal_synthesis` (blueprint line 2201, "two-sided almost
orthogonality"): `(1 - η D³) Σ ‖v_e‖² ≤ ‖Σ v_e‖²`. -/
theorem almost_orthogonal_synthesis_lower {κ : Type*} (s : Finset κ) (v : κ → H)
    (b ℓ : κ → ℝ) (w : κ → κ → ℝ) {D η : ℝ} (hη : 0 ≤ η) (hD : 0 ≤ D)
    (hw0 : ∀ e e', 0 ≤ w e e') (hws : ∀ e e', w e e' = w e' e)
    (hcross : ∀ e ∈ s, ∀ e' ∈ s, e ≠ e' → ‖inner ℂ (v e) (v e')‖ ≤ η * w e e' * b e * b e')
    (hmult : ∀ e ∈ s, ∑ e' ∈ s, w e e' ≤ D * ℓ e)
    (hdiag : ∀ e ∈ s, ℓ e * b e ^ 2 ≤ D ^ 2 * ‖v e‖ ^ 2) :
    (1 - η * D ^ 3) * ∑ e ∈ s, ‖v e‖ ^ 2 ≤ ‖∑ e ∈ s, v e‖ ^ 2 := by
  have h := (abs_le.mp (almost_orthogonal_synthesis_error s v b ℓ w hη hD hw0 hws
    hcross hmult hdiag)).1
  nlinarith only [h]

/-- The lower half of `subtotals_almost_orthogonal`: subtotals over disjoint components with
small mutual pairings satisfy `(1 - η D³) Σ_j ‖T_j‖² ≤ ‖Σ_j T_j‖²`. -/
theorem subtotals_almost_orthogonal_lower {μ ι : Type*} (s : Finset ι) (E : ι → Finset μ)
    (Ψ : μ → H) (β : μ → ℂ) {η L ε D : ℝ} (hη : 0 ≤ η) (hL : 0 ≤ L) (hε : 0 < ε) (hD : 0 ≤ D)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → ∀ m ∈ E i, ∀ m' ∈ E j,
      ‖inner ℂ (Ψ m) (Ψ m')‖ ≤ η * L)
    (hpriv : ∀ i ∈ s, ε * L * ∑ m ∈ E i, ‖β m‖ ^ 2 ≤ ‖∑ m ∈ E i, β m • Ψ m‖ ^ 2)
    (hnum : (s.card : ℝ) ≤ D) (hcard : ∀ i ∈ s, ((E i).card : ℝ) ≤ ε * D ^ 2) :
    (1 - η * D ^ 3) * ∑ i ∈ s, ‖∑ m ∈ E i, β m • Ψ m‖ ^ 2 ≤
      ‖∑ i ∈ s, ∑ m ∈ E i, β m • Ψ m‖ ^ 2 := by
  obtain ⟨b, hcross, hdiag⟩ := subtotals_synthesis_bounds s E Ψ β hη hL hε hpair hpriv hcard
  refine almost_orthogonal_synthesis_lower s (fun i => ∑ m ∈ E i, β m • Ψ m) b (fun _ => L)
    (fun _ _ => L) hη hD (fun _ _ => hL) (fun _ _ => rfl) hcross (fun i _ => ?_) hdiag
  rw [Finset.sum_const, nsmul_eq_mul]
  exact mul_le_mul_of_nonneg_right hnum hL

end LowerAlmostOrthogonal

section ComponentSizes
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- Blueprint `eq:size-comparison` (lines 2196-2209), first assertion, at one actual cell: the core
subtotals `A_D = Σ_{m core in D} α_m Ψ_m` of the minimal CURRENT components `D ⊆ F` (pairwise
almost orthogonal, `η D³ ≤ 1/2`) with coefficient floors `y_D` (`Σ y_D² ≤ η_f`) satisfy
`σ_F² = Σ_D (‖A_D‖ + y_D)² ≤ 12 (‖P_F ZTilde‖² + ε² + ‖V_F‖²) + 2 η_f`, when the full subtotal is
`T_F = V_F + Σ_D A_D` and `‖P_F ZTilde - T_F‖ ≤ ε`. -/
theorem component_sizes {μ ι : Type*} (s : Finset ι) (Dc : ι → Finset μ) (Ψ : μ → H)
    (α : μ → ℂ) {η L ε D : ℝ} (hη : 0 ≤ η) (hL : 0 ≤ L) (hε : 0 < ε) (hD : 0 ≤ D)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → ∀ m ∈ Dc i, ∀ m' ∈ Dc j,
      ‖inner ℂ (Ψ m) (Ψ m')‖ ≤ η * L)
    (hpriv : ∀ i ∈ s, ε * L * ∑ m ∈ Dc i, ‖α m‖ ^ 2 ≤ ‖∑ m ∈ Dc i, α m • Ψ m‖ ^ 2)
    (hnum : (s.card : ℝ) ≤ D) (hcard : ∀ i ∈ s, ((Dc i).card : ℝ) ≤ ε * D ^ 2)
    (hηD : η * D ^ 3 ≤ 1 / 2) (y : ι → ℝ) {ηf : ℝ} (hy : ∑ i ∈ s, y i ^ 2 ≤ ηf)
    {TF VF PZ : H} {εc : ℝ} (hεc : 0 ≤ εc)
    (hT : TF - VF = ∑ i ∈ s, ∑ m ∈ Dc i, α m • Ψ m) (hclose : ‖PZ - TF‖ ≤ εc) :
    ∑ i ∈ s, (‖∑ m ∈ Dc i, α m • Ψ m‖ + y i) ^ 2 ≤
      12 * (‖PZ‖ ^ 2 + εc ^ 2 + ‖VF‖ ^ 2) + 2 * ηf := by
  have hlow := subtotals_almost_orthogonal_lower s Dc Ψ α hη hL hε hD hpair hpriv hnum hcard
  rw [← hT] at hlow
  have ha : ∑ i ∈ s, ‖∑ m ∈ Dc i, α m • Ψ m‖ ^ 2 ≤ 2 * ‖TF - VF‖ ^ 2 := by
    have h0 : 0 ≤ ∑ i ∈ s, ‖∑ m ∈ Dc i, α m • Ψ m‖ ^ 2 := Finset.sum_nonneg fun _ _ => by positivity
    nlinarith
  have hTn : |‖TF - VF‖| ≤ ‖PZ‖ + εc + ‖VF‖ := by
    rw [abs_of_nonneg (norm_nonneg _)]
    calc ‖TF - VF‖ ≤ ‖TF‖ + ‖VF‖ := norm_sub_le _ _
      _ ≤ ‖PZ‖ + εc + ‖VF‖ := by
          have := norm_le_insert' TF PZ
          have h2 : ‖TF - PZ‖ ≤ εc := by rw [norm_sub_rev]; exact hclose
          linarith
  have h := component_size_comparison s (fun i => ‖∑ m ∈ Dc i, α m • Ψ m‖) y (c := 2)
    (by norm_num) ha hy hTn (norm_nonneg _) hεc (norm_nonneg _)
  refine h.trans (le_of_eq ?_)
  ring

/-- Blueprint `eq:size-comparison`, second assertion: the side subtotals `V_F` of distinct CURRENT
components of a linear side `V = Σ_F V_F` satisfy `Σ_F ‖V_F‖² ≤ 2 ‖V‖²` (`η D³ ≤ 1/2`). -/
theorem side_subtotals_le {μ ι : Type*} (s : Finset ι) (Dc : ι → Finset μ) (Ψ : μ → H)
    (α : μ → ℂ) {η L ε D : ℝ} (hη : 0 ≤ η) (hL : 0 ≤ L) (hε : 0 < ε) (hD : 0 ≤ D)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → ∀ m ∈ Dc i, ∀ m' ∈ Dc j,
      ‖inner ℂ (Ψ m) (Ψ m')‖ ≤ η * L)
    (hpriv : ∀ i ∈ s, ε * L * ∑ m ∈ Dc i, ‖α m‖ ^ 2 ≤ ‖∑ m ∈ Dc i, α m • Ψ m‖ ^ 2)
    (hnum : (s.card : ℝ) ≤ D) (hcard : ∀ i ∈ s, ((Dc i).card : ℝ) ≤ ε * D ^ 2)
    (hηD : η * D ^ 3 ≤ 1 / 2) :
    ∑ i ∈ s, ‖∑ m ∈ Dc i, α m • Ψ m‖ ^ 2 ≤ 2 * ‖∑ i ∈ s, ∑ m ∈ Dc i, α m • Ψ m‖ ^ 2 := by
  have hlow := subtotals_almost_orthogonal_lower s Dc Ψ α hη hL hε hD hpair hpriv hnum hcard
  have h0 : 0 ≤ ∑ i ∈ s, ‖∑ m ∈ Dc i, α m • Ψ m‖ ^ 2 := Finset.sum_nonneg fun _ _ => by positivity
  nlinarith

end ComponentSizes

/-! ### First tops and their count (prop:tops, blueprint lines 2211-2231) -/

/-- Blueprint lines 2227-2229 (`eq:top-count`, second bound): if every used representative
`a ∈ A` at a point `y` has a retained first top containing `y`, distinct representatives having
distinct tops, then `|A|` is at most the number of retained tops containing `y`. -/
theorem reps_card_le_tops {α ι : Type*} (A : Finset α) (tops : Finset ι)
    (top : α → ι) (htop : ∀ a ∈ A, top a ∈ tops) (hinj : Set.InjOn top A) :
    A.card ≤ tops.card := by
  classical
  rw [← Finset.card_image_of_injOn hinj]
  exact Finset.card_le_card fun t ht => by
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp ht
    exact htop a ha

open Classical in
/-- Blueprint lines 2226-2227 ("Markov's inequality and first crossings of their partial top
counts"): tops `t ∈ T` on cells `cell t ∈ S` with total length `Σ_t |cell t| ≤ M |R|` are cut at the
first crossings of `M/ρ`, at cost `ρ|R|`, after which every point lies in at most `M/ρ` retained
tops. -/
theorem tops_count_cut (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) {ι : Type*} (T : Finset ι)
    (cell : ι → ℤ × ℤ) (hT : ∀ t ∈ T, cell t ∈ S) (root : ℤ × ℤ)
    (hroot : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2) {M ρ : ℝ}
    (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (hM : ∑ t ∈ T, dyadicGridLength G (cell t).1 ≤ M * dyadicGridLength G root.1) :
    dyadicRootLength G (dyadicFirstCrossings G S (fun I => ((T.filter fun t => cell t = I).card
        : ℝ)) (M / ρ)) ≤ ρ * dyadicGridLength G root.1 ∧
      ∀ x : ℝ, ((T.filter fun t => cell t ∈ dyadicRetainedCells G S
        (fun I => ((T.filter fun t => cell t = I).card : ℝ)) (M / ρ) ∧
          x ∈ dyadicGridCell G (cell t).1 (cell t).2).card : ℝ) ≤ M / ρ := by
  set a : ℤ × ℤ → ℝ := fun I => ((T.filter fun t => cell t = I).card : ℝ)
  have hmass : dyadicWeightedMass G S a = ∑ t ∈ T, dyadicGridLength G (cell t).1 := by
    unfold dyadicWeightedMass
    simp only [a]
    rw [← Finset.sum_fiberwise_of_maps_to (s := T) (t := S) (g := cell) hT]
    refine Finset.sum_congr rfl fun I _ => ?_
    rw [Finset.sum_congr rfl fun t ht => by rw [(Finset.mem_filter.mp ht).2], Finset.sum_const,
      nsmul_eq_mul, mul_comm]
  obtain ⟨hcost, hpath⟩ := dyadicFirstCrossingCuts G S a (fun _ _ => Nat.cast_nonneg _) root
    hroot hρ hρ1 (hmass.le.trans hM)
  refine ⟨hcost, fun x => le_trans (le_of_eq ?_) (hpath x)⟩
  set Rt := dyadicRetainedCells G S a (M / ρ)
  unfold dyadicRealPathSum
  simp only [a]
  rw [← Nat.cast_sum]
  congr 1
  rw [Finset.card_eq_sum_card_fiberwise (f := cell) (t := Rt.filter fun c =>
    x ∈ dyadicGridCell G c.1 c.2) (fun t ht => by
      obtain ⟨-, h1, h2⟩ := Finset.mem_filter.mp ht
      exact Finset.mem_filter.mpr ⟨h1, h2⟩)]
  refine Finset.sum_congr rfl fun I hI => ?_
  obtain ⟨hIR, hxI⟩ := Finset.mem_filter.mp hI
  congr 1
  ext t
  simp only [Finset.mem_filter]
  constructor
  · rintro ⟨⟨ht, -⟩, he⟩; exact ⟨ht, he⟩
  · rintro ⟨ht, he⟩; exact ⟨⟨ht, he ▸ hIR, he ▸ hxI⟩, he⟩

end TrilinearHT.Auto

end


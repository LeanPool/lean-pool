        _ ≤ (Ms.alive (ancAt Gd J (b - 4 * S.K))).card *
            ∑ m ∈ Ms.alive (ancAt Gd J (b - 4 * S.K)), ‖c m‖ ^ 2 := h2
        _ ≤ S.Dstar * Bc := mul_le_mul halive hc hS0 hDp.le

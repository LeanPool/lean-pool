    (fun l => Ms.zc.θ l / S.Q0) (fun x => Ms.keyOf x.1) Ms.dvOf Ms.θvOf hdim Gd.baseLength_pos b
    (dyadicGridLeft Gd J.1 J.2) (fun x x' hk => ?_) hJh hg' hπ hF

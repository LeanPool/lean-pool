/-- Blueprint lem:delay, `eq:delay-telescope`, as an estimate on one cell `I` of depth `s`:
`D_j`, `μ_j` are the residual and its predictor moment at depth `s + j` (so `∫_Q D_j = ∫_Q μ_j`
and `μ_j` is constant on the depth-`(s+j)` cells `Q ⊆ I`), and `θ` is a bump with
`‖θ‖ ≤ L` and Lipschitz constant `L/|I|`. The telescoping is stopped at depth `s + n + d`. -/
theorem delay_cell_telescope (G : RealDyadicGrid) (I : ℤ × ℤ) {θ : ℝ → ℂ} {L : ℝ}
    (hL : 0 ≤ L) (hθc : Continuous θ) (hθb : ∀ y, ‖θ y‖ ≤ L)
    (hLip : ∀ y z, ‖θ y - θ z‖ ≤ L / dyadicGridLength G I.1 * |y - z|)
    (D μ : ℕ → ℝ → ℂ)
    (hD2 : ∀ j, MemLp (D j) 2 (volume.restrict (dyadicGridCell G I.1 I.2)))
    (hμ2 : ∀ j, MemLp (μ j) 2 (volume.restrict (dyadicGridCell G I.1 I.2)))
    (n d : ℕ)
    (hμc : ∀ j, j ≤ n + d → ∀ Q ∈ dyadicGeneration G I j, ∀ y ∈ dyadicGridCell G Q.1 Q.2,
      ∀ z ∈ dyadicGridCell G Q.1 Q.2, μ j y = μ j z)
    (hDμ : ∀ j, j ≤ n + d → ∀ Q ∈ dyadicGeneration G I j,
      ∫ y in dyadicGridCell G Q.1 Q.2, D j y = ∫ y in dyadicGridCell G Q.1 Q.2, μ j y) :
    ‖∫ y in dyadicGridCell G I.1 I.2, D n y * θ y‖ ≤
      ‖∫ y in dyadicGridCell G I.1 I.2, μ n y * θ y‖ +
      (∑ j ∈ Finset.Ico n (n + d), 2 * L * (2 : ℝ)⁻¹ ^ j *
        Real.sqrt (dyadicGridLength G I.1) *
        (Real.sqrt (∫ y in dyadicGridCell G I.1 I.2, ‖D j y - D (j + 1) y‖ ^ 2) +
          Real.sqrt (∫ y in dyadicGridCell G I.1 I.2, ‖μ (j + 1) y - μ j y‖ ^ 2))) +
      L * (2 : ℝ)⁻¹ ^ (n + d) * Real.sqrt (dyadicGridLength G I.1) *
        Real.sqrt (∫ y in dyadicGridCell G I.1 I.2, ‖D (n + d) y‖ ^ 2) := by
  classical
  have := cell_isFiniteMeasure G I.1 I.2
  set r := dyadicGridLength G I.1 with hr
  have hr0 : 0 < r := dyadicGridLength_pos G I.1
  set C := dyadicGridCell G I.1 I.2 with hC
  set E : ℕ → ℝ → ℂ := fun j => depthExpectation G (I.1 + j) θ with hE
  have hEm : ∀ j, Measurable (E j) := fun j => measurable_depthExpectation G _ θ
  have hEb : ∀ j y, ‖E j y‖ ≤ L := fun j y => norm_depthExpectation_le G _ hθc hθb y
  have hθm : Measurable θ := hθc.measurable
  have hLip0 : 0 ≤ L / r := by positivity
  have hp0 : ∀ j : ℕ, (0 : ℝ) ≤ (2 : ℝ)⁻¹ ^ j := fun j => by positivity
  have hEθ : ∀ j y, ‖θ y - E j y‖ ≤ L * (2 : ℝ)⁻¹ ^ j := fun j y => by
    have h := norm_sub_depthExpectation_le G (I.1 + j) hLip0 hθc hLip y
    rw [dyadicGridLength_add_nat, ← hr] at h
    calc _ ≤ _ := h
      _ = L * (2 : ℝ)⁻¹ ^ j := by field_simp
  have hEE : ∀ j y, ‖E (j + 1) y - E j y‖ ≤ 2 * L * (2 : ℝ)⁻¹ ^ j := fun j y => by
    have h := norm_depthExpectation_succ_sub_le G (I.1 + j) hLip0 hθc hLip y
    rw [dyadicGridLength_add_nat, ← hr] at h
    have e : I.1 + ((j + 1 : ℕ) : ℤ) = I.1 + j + 1 := by push_cast; ring
    simp only [hE]; rw [e]
    calc _ ≤ _ := h
      _ = 2 * L * (2 : ℝ)⁻¹ ^ j := by field_simp
  have hDi : ∀ j, IntegrableOn (D j) C := fun j => (hD2 j).integrable one_le_two
  have hμi : ∀ j, IntegrableOn (μ j) C := fun j => (hμ2 j).integrable one_le_two
  have hθi : IntegrableOn θ C := integrableOn_cell_of_continuous G _ _ hθc
  have hEi : ∀ j, IntegrableOn (E j) C := fun j =>
    Integrable.of_bound (hEm j).aestronglyMeasurable L (Filter.Eventually.of_forall (hEb j))
  -- local constancy of the expectations
  have hEc : ∀ j k, j ≤ k → ∀ Q ∈ dyadicGeneration G I k, ∀ y ∈ dyadicGridCell G Q.1 Q.2,
      ∀ z ∈ dyadicGridCell G Q.1 Q.2, E j y = E j z := fun j k hjk =>
    depthConst_locConst (by omega) (depthConst_depthExpectation G _ θ)
  have hEint : ∀ j k, k ≤ j → ∀ Q ∈ dyadicGeneration G I k,
      ∫ y in dyadicGridCell G Q.1 Q.2, E j y = ∫ y in dyadicGridCell G Q.1 Q.2, θ y := by
    intro j k hkj Q hQ
    have hd := dyadicGeneration_depth G I k hQ
    exact setIntegral_depthExpectation_of_le G Q (by rw [hd]; omega)
      (integrableOn_cell_of_continuous G _ _ hθc)
  -- the telescoping terms
  set! T : ℕ → ℂ := fun j => ∫ y in C, D j y * (θ y - E j y) with hT
  have hmulθE : ∀ j, IntegrableOn (fun y => D j y * (θ y - E j y)) C := fun j =>
    integrableOn_cell_mul_bdd (hD2 j) (hθm.sub (hEm j)) (hEθ j)
  have hmulE : ∀ j k, IntegrableOn (fun y => D j y * E k y) C := fun j k =>
    integrableOn_cell_mul_bdd (hD2 j) (hEm k) (hEb k)
  have hmulμE : ∀ j k, IntegrableOn (fun y => μ j y * E k y) C := fun j k =>
    integrableOn_cell_mul_bdd (hμ2 j) (hEm k) (hEb k)
  -- the first step: `∫ D_n θ = ∫ μ_n θ + T_n`
  have hstart : ∫ y in C, D n y * θ y = (∫ y in C, μ n y * θ y) + T n := by
    have h1 : ∫ y in C, D n y * θ y = T n + ∫ y in C, D n y * E n y := by
      rw [hT, ← integral_add (hmulθE n) (hmulE n n)]
      congr 1; funext y; ring
    have h2 : ∫ y in C, D n y * E n y = ∫ y in C, μ n y * E n y :=
      setIntegral_mul_locConst G I n (hEc n n le_rfl) (hDi n) (hμi n) (hDμ n (by omega))
    have h3 : ∫ y in C, E n y * μ n y = ∫ y in C, θ y * μ n y :=
      setIntegral_mul_locConst G I n (hμc n (by omega)) (hEi n) hθi (hEint n n le_rfl)
    rw [h1, h2]
    simp only [mul_comm (μ n _)] at h3 ⊢
    rw [h3, add_comm]
  -- one telescoping step
  have hstep : ∀ j, j + 1 ≤ n + d → ‖T j‖ ≤ ‖T (j + 1)‖ + 2 * L * (2 : ℝ)⁻¹ ^ j *
      Real.sqrt r * (Real.sqrt (∫ y in C, ‖D j y - D (j + 1) y‖ ^ 2) +
        Real.sqrt (∫ y in C, ‖μ (j + 1) y - μ j y‖ ^ 2)) := by
    intro j hj
    set! g : ℝ → ℂ := fun y => E (j + 1) y - E j y with hg
    have hgm : Measurable g := (hEm _).sub (hEm _)
    have hgc : ∀ Q ∈ dyadicGeneration G I (j + 1), ∀ y ∈ dyadicGridCell G Q.1 Q.2,
        ∀ z ∈ dyadicGridCell G Q.1 Q.2, g y = g z := fun Q hQ y hy z hz => by
      simp only [hg]
      rw [hEc (j + 1) (j + 1) le_rfl Q hQ y hy z hz, hEc j (j + 1) (by omega) Q hQ y hy z hz]
    have hgi : IntegrableOn g C := (hEi _).sub (hEi _)
    have hDg : ∀ k, IntegrableOn (fun y => D k y * g y) C := fun k =>
      integrableOn_cell_mul_bdd (hD2 k) hgm (hEE j)
    have hμg : ∀ k, IntegrableOn (fun y => μ k y * g y) C := fun k =>
      integrableOn_cell_mul_bdd (hμ2 k) hgm (hEE j)
    have hA : IntegrableOn (fun y => (D j y - D (j + 1) y) * (θ y - E j y)) C :=
      integrableOn_cell_mul_bdd ((hD2 j).sub (hD2 (j + 1))) (hθm.sub (hEm j)) (hEθ j)
    have e1 : T j = (∫ y in C, (D j y - D (j + 1) y) * (θ y - E j y)) +
        (T (j + 1) + ∫ y in C, D (j + 1) y * g y) := by
      have hf : (fun y => D j y * (θ y - E j y)) = fun y =>
          (D j y - D (j + 1) y) * (θ y - E j y) +
            (D (j + 1) y * (θ y - E (j + 1) y) + D (j + 1) y * g y) := by
        funext y; simp only [hg]; ring
      have hBC : IntegrableOn (fun y => D (j + 1) y * (θ y - E (j + 1) y) +
          D (j + 1) y * g y) C := (hmulθE (j + 1)).add (hDg (j + 1))
      simp only [hT]
      rw [hf, integral_add hA hBC, integral_add (hmulθE (j + 1)) (hDg (j + 1))]
    have e2 : ∫ y in C, D (j + 1) y * g y = ∫ y in C, μ (j + 1) y * g y :=
      setIntegral_mul_locConst G I (j + 1) hgc (hDi _) (hμi _) (hDμ _ hj)
    have e3 : ∫ y in C, g y * μ j y = ∫ y in C, (0 : ℂ) * μ j y := by
      refine setIntegral_mul_locConst G I j (hμc j (by omega)) hgi (integrableOn_zero)
        fun Q hQ => ?_
      have hQi := integrableOn_cell_of_continuous G Q.1 Q.2 hθc
      have hsub := dyadicGeneration_subset G I j hQ
      rw [integral_zero, integral_sub ((hEi _).mono_set hsub) ((hEi _).mono_set hsub),
        hEint (j + 1) j (by omega) Q hQ, hEint j j le_rfl Q hQ, sub_self]
    have e4 : ∫ y in C, μ (j + 1) y * g y =
        ∫ y in C, (μ (j + 1) y - μ j y) * g y := by
      have h0 : ∫ y in C, μ j y * g y = 0 := by
        simp only [mul_comm (μ j _)]; rw [e3]; simp
      rw [← sub_zero (∫ y in C, μ (j + 1) y * g y), ← h0, ← integral_sub (hμg _) (hμg _)]
      congr 1; funext y; ring
    have bA := norm_setIntegral_cell_mul_le (I := I) ((hD2 j).sub (hD2 (j + 1)))
      (mul_nonneg hL (hp0 j)) (hEθ j)
    have bB := norm_setIntegral_cell_mul_le (I := I) ((hμ2 (j + 1)).sub (hμ2 j))
      (by have := hp0 j; positivity) (hEE j)
    rw [e1, e2, e4]
    have hsa := Real.sqrt_nonneg (∫ y in C, ‖D j y - D (j + 1) y‖ ^ 2)
    have hsr := Real.sqrt_nonneg r
    have hLa : L * (2 : ℝ)⁻¹ ^ j * Real.sqrt r *
        Real.sqrt (∫ y in C, ‖D j y - D (j + 1) y‖ ^ 2) ≤
        2 * L * (2 : ℝ)⁻¹ ^ j * Real.sqrt r *
        Real.sqrt (∫ y in C, ‖D j y - D (j + 1) y‖ ^ 2) := by
      have : 0 ≤ L * (2 : ℝ)⁻¹ ^ j * Real.sqrt r *
          Real.sqrt (∫ y in C, ‖D j y - D (j + 1) y‖ ^ 2) :=
        mul_nonneg (mul_nonneg (mul_nonneg hL (hp0 j)) hsr) hsa
      linarith
    calc ‖(∫ y in C, (D j y - D (j + 1) y) * (θ y - E j y)) +
          (T (j + 1) + ∫ y in C, (μ (j + 1) y - μ j y) * g y)‖
        ≤ ‖∫ y in C, (D j y - D (j + 1) y) * (θ y - E j y)‖ +
          (‖T (j + 1)‖ + ‖∫ y in C, (μ (j + 1) y - μ j y) * g y‖) :=
          (norm_add_le _ _).trans (add_le_add le_rfl (norm_add_le _ _))
      _ ≤ _ := by
          simp only [Pi.sub_apply] at bA bB
          nlinarith only [bA, bB, hLa]
  -- the terminal term
  have hend : ∀ N, ‖T N‖ ≤ L * (2 : ℝ)⁻¹ ^ N * Real.sqrt r *
      Real.sqrt (∫ y in C, ‖D N y‖ ^ 2) := fun N =>
    norm_setIntegral_cell_mul_le (I := I) (hD2 N) (mul_nonneg hL (hp0 N)) (hEθ N)
  -- iterate
  have hiter : ∀ d', d' ≤ d → ‖T n‖ ≤ (∑ j ∈ Finset.Ico n (n + d'), 2 * L * (2 : ℝ)⁻¹ ^ j *
      Real.sqrt r * (Real.sqrt (∫ y in C, ‖D j y - D (j + 1) y‖ ^ 2) +
        Real.sqrt (∫ y in C, ‖μ (j + 1) y - μ j y‖ ^ 2))) + ‖T (n + d')‖ := by
    intro d'
    induction d' with
    | zero => intro _; simp
    | succ k ih =>
      intro hk
      rw [← add_assoc, Finset.sum_Ico_succ_top (by omega)]
      have := hstep (n + k) (by omega)
      have := ih (by omega)
      linarith
  rw [hstart]
  have h := hiter d le_rfl
  have h' := hend (n + d)
  calc ‖(∫ y in C, μ n y * θ y) + T n‖ ≤ ‖∫ y in C, μ n y * θ y‖ + ‖T n‖ := norm_add_le _ _
    _ ≤ _ := by linarith

/-- Weighted Cauchy–Schwarz: `(Σ c a)² ≤ (Σ c)(Σ c a²)` for `c ≥ 0`. -/
theorem weighted_sq_sum_le {ι : Type*} (s : Finset ι) (c a : ι → ℝ) (hc : ∀ j ∈ s, 0 ≤ c j) :
    (∑ j ∈ s, c j * a j) ^ 2 ≤ (∑ j ∈ s, c j) * ∑ j ∈ s, c j * a j ^ 2 := by
  have h := Finset.sum_mul_sq_le_sq_mul_sq s (fun j => Real.sqrt (c j))
    (fun j => Real.sqrt (c j) * a j)
  have e1 : ∀ j ∈ s, Real.sqrt (c j) * (Real.sqrt (c j) * a j) = c j * a j := fun j hj => by
    rw [← mul_assoc, Real.mul_self_sqrt (hc j hj)]
  have e2 : ∀ j ∈ s, Real.sqrt (c j) ^ 2 = c j := fun j hj => Real.sq_sqrt (hc j hj)
  have e3 : ∀ j ∈ s, (Real.sqrt (c j) * a j) ^ 2 = c j * a j ^ 2 := fun j hj => by
    rw [mul_pow, Real.sq_sqrt (hc j hj)]
  rw [Finset.sum_congr rfl e1, Finset.sum_congr rfl e2, Finset.sum_congr rfl e3] at h
  exact h

/-- Disjoint cells of one depth inside `J` carry at most the mass of `J`. -/
theorem sum_depth_cells_le (G : RealDyadicGrid) (J : ℤ × ℤ) (S : Finset (ℤ × ℤ)) (s : ℤ)
    (hS : ∀ I ∈ S, I.1 = s ∧ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2)
    {F : ℝ → ℝ} (hF0 : ∀ y, 0 ≤ F y) (hF : IntegrableOn F (dyadicGridCell G J.1 J.2)) :
    ∑ I ∈ S, ∫ y in dyadicGridCell G I.1 I.2, F y ≤ ∫ y in dyadicGridCell G J.1 J.2, F y := by
  classical
  have hdisj : (S : Set (ℤ × ℤ)).PairwiseDisjoint (fun I => dyadicGridCell G I.1 I.2) := by
    intro I hI I' hI' hne
    have h1 : I.1 = I'.1 := by rw [(hS I hI).1, (hS I' hI').1]
    have h2 : I.2 ≠ I'.2 := fun h => hne (Prod.ext h1 h)
    have := dyadicGridCell_pairwiseDisjoint G I.1 h2
    simpa [Function.onFun, h1] using this
  rw [← integral_biUnion_finset S (fun I _ => dyadicGridCell_measurable G I.1 I.2) hdisj
    (fun I hI => hF.mono_set (hS I hI).2)]
  refine setIntegral_mono_set hF (Filter.Eventually.of_forall fun y => hF0 y) ?_
  exact Filter.Eventually.of_forall (fun y hy => by
    simp only [Set.mem_iUnion] at hy
    obtain ⟨I, hI, hyI⟩ := hy
    exact (hS I hI).2 hyI)

/-- The energy of all use cells at a fixed depth offset. -/
theorem sum_cells_energy_le (G : RealDyadicGrid) (J : ℤ × ℤ) (S : Finset (ℤ × ℤ))
    (hSJ : ∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2)
    (e : ℤ → ℝ → ℝ) (he0 : ∀ h y, 0 ≤ e h y)
    (hei : ∀ h, IntegrableOn (e h) (dyadicGridCell G J.1 J.2)) {E : ℝ}
    (hE : ∀ Hs : Finset ℤ, ∑ h ∈ Hs, ∫ y in dyadicGridCell G J.1 J.2, e h y ≤ E) (j : ℕ) :
    ∑ I ∈ S, ∫ y in dyadicGridCell G I.1 I.2, e (I.1 + j) y ≤ E := by
  classical
  rw [← Finset.sum_fiberwise_of_maps_to (s := S) (t := S.image Prod.fst)
    (g := fun I : ℤ × ℤ => I.1) (fun I hI => Finset.mem_image_of_mem _ hI)]
  calc ∑ s ∈ S.image Prod.fst, ∑ I ∈ S with I.1 = s,
        ∫ y in dyadicGridCell G I.1 I.2, e (I.1 + j) y
      ≤ ∑ s ∈ S.image Prod.fst, ∫ y in dyadicGridCell G J.1 J.2, e (s + j) y := by
        refine Finset.sum_le_sum fun s _ => ?_
        have hc : ∀ I ∈ S.filter (fun I => I.1 = s),
            ∫ y in dyadicGridCell G I.1 I.2, e (I.1 + j) y =
              ∫ y in dyadicGridCell G I.1 I.2, e (s + j) y := fun I hI => by
          rw [(Finset.mem_filter.mp hI).2]
        rw [Finset.sum_congr rfl hc]
        exact sum_depth_cells_le G J _ s (fun I hI => ⟨(Finset.mem_filter.mp hI).2,
          hSJ I (Finset.mem_filter.mp hI).1⟩) (he0 _) (hei _)
    _ = ∑ h ∈ (S.image Prod.fst).image (fun s => s + (j : ℤ)),
          ∫ y in dyadicGridCell G J.1 J.2, e h y := by
        refine (Finset.sum_image (s := S.image Prod.fst) (g := fun s : ℤ => s + (j : ℤ))
          (f := fun h => ∫ y in dyadicGridCell G J.1 J.2, e h y) ?_).symm
        intro x _ y _ h
        simpa using h
    _ ≤ E := hE _

theorem sum_geom_inj_le {α : Type*} (T : Finset α) (g : α → ℕ) (hg : Set.InjOn g T) :
    ∑ s ∈ T, (2 : ℝ)⁻¹ ^ g s ≤ 2 := by
  classical
  rw [← Finset.sum_image (f := fun k => (2 : ℝ)⁻¹ ^ k) hg]
  have hs := summable_geometric_of_lt_one (r := (2 : ℝ)⁻¹) (by norm_num) (by norm_num)
  refine (hs.sum_le_tsum _ (fun _ _ => by positivity)).trans (le_of_eq ?_)
  rw [tsum_geometric_of_lt_one (by norm_num) (by norm_num)]; norm_num

theorem geom_Ico_le (K d : ℕ) :
    ∑ j ∈ Finset.Ico K (K + d), (2 : ℝ)⁻¹ ^ j ≤ 2 * (2 : ℝ)⁻¹ ^ K := by
  rw [Finset.sum_Ico_eq_sum_range, Nat.add_sub_cancel_left]
  simp_rw [pow_add]
  rw [← Finset.mul_sum]
  have h : ∑ i ∈ Finset.range d, (2 : ℝ)⁻¹ ^ i ≤ 2 := by
    rw [geom_sum_eq (by norm_num), div_le_iff_of_neg (by norm_num)]
    have : 0 ≤ (2 : ℝ)⁻¹ ^ d := by positivity
    linarith only [this]
  calc (2 : ℝ)⁻¹ ^ K * ∑ i ∈ Finset.range d, (2 : ℝ)⁻¹ ^ i ≤ (2 : ℝ)⁻¹ ^ K * 2 :=
        mul_le_mul_of_nonneg_left h (by positivity)
    _ = 2 * (2 : ℝ)⁻¹ ^ K := by ring

theorem sqrt_setIntegral_le_of_le {s : Set ℝ} {u : ℝ → ℂ} {e : ℝ → ℝ} {c : ℝ} (hc : 0 ≤ c)
    (he : IntegrableOn e s) (hu : ∀ᵐ y ∂(volume.restrict s), ‖u y‖ ^ 2 ≤ c * e y) :
    Real.sqrt (∫ y in s, ‖u y‖ ^ 2) ≤ Real.sqrt c * Real.sqrt (∫ y in s, e y) := by
  rw [← Real.sqrt_mul hc]
  apply Real.sqrt_le_sqrt
  rw [← integral_const_mul]
  exact integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => by positivity)
    (he.const_mul c) hu




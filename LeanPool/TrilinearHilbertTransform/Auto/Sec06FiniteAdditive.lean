theorem finite_gowersNorm_pow {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] [MeasurableAdd₂ G]
    {j : ℕ} (hj : 1 ≤ j) (f : G → ℂ) :
    gowersNorm (finiteHaar G) j f ^ (2 ^ j) =
      (cubeAverage (finiteHaar G) j (fun _ => f)).re := by
  apply gowersNorm_pow (finiteHaar G) hj f (measurable_of_countable f)
    (M := ∑ x, ‖f x‖)
  intro x
  exact Finset.single_le_sum (fun _ _ => norm_nonneg _) (Finset.mem_univ x)

theorem finiteFourier_reflect_conj {q : ℕ} [NeZero q] (f : ZMod q → ℂ) (ξ : ZMod q) :
    finiteFourier (fun x => conj (f (-x))) ξ = conj (finiteFourier f ξ) := by
  rw [finiteFourier_eq_average,
    ← finiteAverage_equiv (Equiv.neg _) (fun x => conj (f (-x)) *
      ZMod.stdAddChar (-(ξ * x)))]
  simp only [Equiv.neg_apply, neg_neg, mul_neg]
  rw [finiteFourier_eq_average, ← finiteAverage_conj]
  congr 1
  funext x
  simp only [map_mul, stdAddChar_conj, neg_neg]

theorem finite_cubeAverage_sq {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] [MeasurableAdd₂ G]
    (j : ℕ) (f : G → ℂ) : cubeAverage (finiteHaar G) (j + 1) (fun _ => f) =
      (uniformMean (fun h : Fin j → G =>
        ‖uniformMean (diagonalCubeIntegrand j f h)‖ ^ 2) : ℝ) := by
  rw [cubeAverage_diagonal_eq_integral_sq (finiteHaar G) j f (measurable_of_countable f)
    (M := ∑ x, ‖f x‖) (fun x =>
      Finset.single_le_sum (fun _ _ => norm_nonneg _) (Finset.mem_univ x))]
  simp only [finiteHaar_pi, integral_finiteHaar_uniform]

theorem diagonalCubeIntegrand_one {G : Type*} [AddCommGroup G]
    (f : G → ℂ) (h : Fin 1 → G) (x : G) :
    diagonalCubeIntegrand 1 f h x = f x * conj (f (x + h 0)) := by
  rw [diagonalCubeIntegrand_succ 0]
  simp only [diagonalCubeIntegrand_zero]

theorem finiteFourier_gowers_two {q : ℕ} [NeZero q] (f : ZMod q → ℂ) :
    gowersNorm (finiteHaar (ZMod q)) 2 f ^ 4 = ∑ ξ, ‖finiteFourier f ξ‖ ^ 4 := by
  rw [show 4 = 2 ^ 2 from rfl, finite_gowersNorm_pow (by norm_num),
    show 2 = 1 + 1 from rfl, finite_cubeAverage_sq, Complex.ofReal_re]
  have hf1 (h : Fin 1 → ZMod q) : diagonalCubeIntegrand 1 f h =
      fun x => f x * conj (f (x + h 0)) := funext (diagonalCubeIntegrand_one f h)
  simp only [hf1]
  rw [uniformMean_eval (0 : Fin 1)
    (fun h => ‖uniformMean (fun x => f x * conj (f (x + h)))‖ ^ 2)]
  let D := finiteConvolution f (fun x => conj (f (-x)))
  have hd (h : ZMod q) : uniformMean (fun x => f x * conj (f (x + h))) = D (-h) := by
    rw [uniformMean_complex_eq]
    simp only [D, finiteConvolution, neg_sub, sub_neg_eq_add, add_comm]
  simp only [hd]
  have hn : uniformMean (fun h => ‖D (-h)‖ ^ 2) = uniformMean (fun h => ‖D h‖ ^ 2) := by
    simpa only [Equiv.neg_apply] using
      uniformMean_equiv (Equiv.neg _) (fun h => ‖D h‖ ^ 2)
  rw [hn, finiteFourier_parseval]
  apply Finset.sum_congr rfl
  intro ξ _
  simp only [D, finiteFourier_convolution, finiteFourier_reflect_conj,
    norm_mul, Complex.norm_conj]
  ring

theorem uniformMean_fin_cons {G E : Type*} [Fintype G] [AddCommMonoid E] [Module ℝ E]
    (j : ℕ) (f : (Fin (j + 1) → G) → E) :
    uniformMean f = uniformMean (fun t => uniformMean (fun h : Fin j → G => f (Fin.cons t h))) := by
  let e : G × (Fin j → G) ≃ (Fin (j + 1) → G) :=
    { toFun := fun p => Fin.cons p.1 p.2
      invFun := fun h => (h 0, fun i => h i.succ)
      left_inv := fun p => by ext <;> simp
      right_inv := fun h => by ext i; induction i using Fin.cases <;> simp }
  rw [← uniformMean_equiv e]
  rw [uniformMean_prod]
  rfl

theorem finite_cubeAverage_recursion {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] (j : ℕ) (f : G → ℂ) :
    cubeAverage (finiteHaar G) (j + 1) (fun _ => f) =
      uniformMean (fun t => cubeAverage (finiteHaar G) j
        (fun _ x => f x * conj (f (x + t)))) := by
  simp only [finite_cubeAverage_eq]
  rw [uniformMean_fin_cons]
  congr 1
  funext t
  congr 1
  funext h
  congr 1
  funext x
  change diagonalCubeIntegrand (j + 1) f (Fin.cons t h) x =
    diagonalCubeIntegrand j (fun x => f x * conj (f (x + t))) h x
  simp only [diagonalCubeIntegrand_succ, Fin.cons_zero, Fin.cons_succ,
    diagonalCubeIntegrand_mul, diagonalCubeIntegrand_conj, diagonalCubeIntegrand_translate]

theorem uniformMean_re {G : Type*} [Fintype G] (f : G → ℂ) :
    (uniformMean f).re = uniformMean (fun x => (f x).re) := by
  rw [uniformMean_complex_eq, finiteAverage_re]

/-- The source's `U³` recursion, with its stated multiplicative-difference convention. -/
theorem finite_gowers_three_recursion {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] [MeasurableAdd₂ G] (f : G → ℂ) :
    gowersNorm (finiteHaar G) 3 f ^ 8 = uniformMean (fun t =>
      gowersNorm (finiteHaar G) 2 (fun x => f (x + t) * conj (f x)) ^ 4) := by
  rw [show 8 = 2 ^ 3 from rfl, finite_gowersNorm_pow (by norm_num),
    show 3 = 2 + 1 from rfl, finite_cubeAverage_recursion, uniformMean_re]
  congr 1
  funext t
  rw [show 4 = 2 ^ 2 from rfl, finite_gowersNorm_pow (by norm_num)]
  have heq : (fun x => f (x + t) * conj (f x)) =
      (fun x => conj (f x * conj (f (x + t)))) := by
    funext x
    simp [mul_comm]
  rw [heq, finite_cubeAverage_conj, Complex.conj_re]


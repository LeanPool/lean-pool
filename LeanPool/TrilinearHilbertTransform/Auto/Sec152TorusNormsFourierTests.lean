/-- Blueprint lines 2522-2534: the unit-scale admissible kernel `W_s` has the bounds of a
normalized kernel, uniformly over the kernel class. -/
theorem unitKernel_bounds {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) :
    UnitKernelBounds (unitKernel a₀ r w) 4 (kernelDerivBound κ) := by
  have hrm : ∀ m : ℕ, r ^ m * r⁻¹ ^ m = 1 := fun m => by
    rw [← mul_pow, mul_inv_cancel₀ hr.ne', one_pow]
  refine ⟨hw.smooth.comp (by fun_prop), fun x s h => ?_, fun m x s => ?_, fun m x s => ?_⟩
  · have hsupp := kernelUnitRescale_support (u := ![x, s]) hr hw (by
      simpa [kernelUnitRescale, unitKernel] using h)
    exact ⟨by simpa using hsupp 0, by simpa using hsupp 1⟩
  · have he : (fun x => unitKernel a₀ r w (x, s)) =
        fun x => (fun y => w (y, r * s)) (r * x + (a₀ + r / 2)) := by
      funext x; simp [unitKernel, add_comm]
    rw [he, iteratedDeriv_comp_affine (φ := fun y => w (y, r * s))
      (hw.smooth.comp (contDiff_id.prodMk contDiff_const)), norm_smul,
      Real.norm_eq_abs, abs_pow, abs_of_pos hr]
    have hb := hw.derivativeBound m 0 (r * x + (a₀ + r / 2), r * s)
    simp only [localKernelPartial, iteratedDeriv_zero, add_zero] at hb
    calc r ^ m * ‖iteratedDeriv m (fun y => w (y, r * s)) (r * x + (a₀ + r / 2))‖ ≤
        r ^ m * (r⁻¹ ^ m * kernelDerivBound κ m) :=
          mul_le_mul_of_nonneg_left (by simpa [kernelDerivBound] using hb) (by positivity)
      _ = kernelDerivBound κ m := by rw [← mul_assoc, hrm, one_mul]
  · have he : (fun s => unitKernel a₀ r w (x, s)) =
        fun s => (fun y => w (a₀ + r / 2 + r * x, y)) (r * s + 0) := by
      funext s; simp [unitKernel]
    rw [he, iteratedDeriv_comp_affine (φ := fun y => w (a₀ + r / 2 + r * x, y))
      (hw.smooth.comp (contDiff_const.prodMk contDiff_id)), norm_smul,
      Real.norm_eq_abs, abs_pow, abs_of_pos hr]
    have hb := hw.derivativeBound 0 m (a₀ + r / 2 + r * x, r * s + 0)
    simp only [localKernelPartial, iteratedDeriv_zero, zero_add] at hb
    calc r ^ m * ‖iteratedDeriv m (fun y => w (a₀ + r / 2 + r * x, y)) (r * s + 0)‖ ≤
        r ^ m * (r⁻¹ ^ m * kernelDerivBound κ m) :=
          mul_le_mul_of_nonneg_left (by simpa [kernelDerivBound] using hb) (by positivity)
      _ = kernelDerivBound κ m := by rw [← mul_assoc, hrm, one_mul]

/-- Blueprint line 2529 ("the four marginals give zeros of `WFourier_s(q,t)` on the four lines
`t = j q`"): the unit-scale kernel has vanishing marginals along the four lines. -/
theorem unitKernel_marginal {κ : LocalKernelClass} {a₀ r : ℝ} {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) (j : Fin 4) (u : ℝ) :
    ∫ s, unitKernel a₀ r w (u - (j : ℝ) * s, s) = 0 := by
  have h := hw.marginal (a₀ + r / 2 + r * u) j
  have hc := Measure.integral_comp_mul_left (fun t => w (a₀ + r / 2 + r * u - (j : ℝ) * t, t)) r
  simp only [unitKernel]
  have he : (fun s => w (a₀ + r / 2 + r * (u - (j : ℝ) * s), r * s)) =
      fun s => (fun t => w (a₀ + r / 2 + r * u - (j : ℝ) * t, t)) (r * s) := by
    funext s; congr 2; ring
  rw [he, hc, h, smul_zero]

/-- Blueprint lines 2526-2534 for the admissible kernels: `|WFourier_s(q, t)| ν^J ≤ C_J μ` with
`μ = min(1, min_{0 ≤ j ≤ 3} |t - j q|)`, `ν = max(1, |q|, |t|)`, uniformly over the class. -/
theorem admissible_kernel_decay {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (J : ℕ) (q t : ℝ) :
    ‖kernelFT (unitKernel a₀ r w) q t‖ * max 1 (max |q| |t|) ^ J ≤
      (2 * (2 * 4 * (2 * 4 * (kernelDerivBound κ 0 +
        ((2 * Real.pi) ^ J)⁻¹ * kernelDerivBound κ J))) + (3 + 2) ^ J *
        (2 * 4 * (2 * Real.pi * 4 * (2 * (4 + 3 * 4) * (kernelDerivBound κ 0 +
          ((2 * Real.pi) ^ J)⁻¹ * kernelDerivBound κ J))))) *
      min 1 (((Finset.univ : Finset (Fin 4)).image fun j : Fin 4 => (j : ℝ)).inf'
        ⟨0, Finset.mem_image.mpr ⟨0, Finset.mem_univ _, by simp⟩⟩ fun j => |t - j * q|) := by
  refine (unitKernel_bounds hr hw).decay_lines (by norm_num) J _ _ (fun j hj => ?_)
    (fun j hj u => ?_) q t
  · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hj
    rw [abs_of_nonneg (Nat.cast_nonneg _)]
    have := i.2
    have : (i : ℝ) ≤ 3 := by exact_mod_cast Nat.lt_succ_iff.mp this
    exact this
  · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hj
    exact unitKernel_marginal hw i u


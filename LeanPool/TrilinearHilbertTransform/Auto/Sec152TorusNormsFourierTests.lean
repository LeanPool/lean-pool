/-! ### Torus sizes (blueprint lines 2483-2495, `eq:torus-size`) -/

/-- Blueprint `eq:torus-size` (lines 2489-2495): if the squared Haar norm is at most the cell
average `X` plus `ε (Σ_D s_D)²` (`cell_average_close`, `haar_norm_sq_eq`), the cell average is at
most `2 Σ_D ‖A_D‖²` (almost orthogonality of minimal CURRENT components), at most `D_*` components
are selected and `ε ≤ D_*^{-100}`, then
`a' ≤ √2 (Σ_D (‖A_D‖ + D_*^{-30} s_D)²)^{1/2}`. -/
theorem torus_size_bound {ι : Type*} (s : Finset ι) (A sD : ι → ℝ) (hA : ∀ i ∈ s, 0 ≤ A i)
    (hs : ∀ i ∈ s, 0 ≤ sD i) {a X ε Dst : ℝ} (hDst : 1 ≤ Dst)
    (hcard : (s.card : ℝ) ≤ Dst) (hεD : ε ≤ Dst ^ (-100 : ℤ))
    (haX : a ^ 2 ≤ X + ε * (∑ i ∈ s, sD i) ^ 2) (hX : X ≤ 2 * ∑ i ∈ s, A i ^ 2) :
    a ≤ Real.sqrt 2 * Real.sqrt (∑ i ∈ s, (A i + Dst ^ (-30 : ℤ) * sD i) ^ 2) := by
  have hD0 : 0 < Dst := by linarith only [hDst]
  have hcs : (∑ i ∈ s, sD i) ^ 2 ≤ s.card * ∑ i ∈ s, sD i ^ 2 := sq_sum_le_card_mul_sum_sq
  have hfl : ε * (∑ i ∈ s, sD i) ^ 2 ≤ 2 * ∑ i ∈ s, (Dst ^ (-30 : ℤ) * sD i) ^ 2 := by
    have h60 : Dst ^ (-100 : ℤ) * Dst ≤ 2 * (Dst ^ (-30 : ℤ)) ^ 2 := by
      have e1 : Dst ^ (-100 : ℤ) * Dst = Dst ^ (-99 : ℤ) := by
        rw [← zpow_add_one₀ hD0.ne']; norm_num
      have e2 : (Dst ^ (-30 : ℤ)) ^ 2 = Dst ^ (-60 : ℤ) := by
        rw [← zpow_natCast, ← zpow_mul]; norm_num
      rw [e1, e2]
      have : Dst ^ (-99 : ℤ) ≤ Dst ^ (-60 : ℤ) := zpow_le_zpow_right₀ hDst (by norm_num)
      have h0 : 0 ≤ Dst ^ (-60 : ℤ) := zpow_nonneg hD0.le _
      linarith
    have hss : 0 ≤ ∑ i ∈ s, sD i ^ 2 := Finset.sum_nonneg fun i _ => sq_nonneg _
    calc ε * (∑ i ∈ s, sD i) ^ 2 ≤ Dst ^ (-100 : ℤ) * (Dst * ∑ i ∈ s, sD i ^ 2) := by
          gcongr
          exact hcs.trans (mul_le_mul_of_nonneg_right hcard hss)
      _ = (Dst ^ (-100 : ℤ) * Dst) * ∑ i ∈ s, sD i ^ 2 := by ring
      _ ≤ (2 * (Dst ^ (-30 : ℤ)) ^ 2) * ∑ i ∈ s, sD i ^ 2 :=
          mul_le_mul_of_nonneg_right h60 hss
      _ = 2 * ∑ i ∈ s, (Dst ^ (-30 : ℤ) * sD i) ^ 2 := by
          rw [Finset.mul_sum, Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => by ring
  have hsum : ∑ i ∈ s, A i ^ 2 + ∑ i ∈ s, (Dst ^ (-30 : ℤ) * sD i) ^ 2 ≤
      ∑ i ∈ s, (A i + Dst ^ (-30 : ℤ) * sD i) ^ 2 := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_le_sum fun i hi => ?_
    have := mul_nonneg (hA i hi) (mul_nonneg (zpow_nonneg hD0.le (-30 : ℤ)) (hs i hi))
    nlinarith
  have ha2 : a ^ 2 ≤ 2 * ∑ i ∈ s, (A i + Dst ^ (-30 : ℤ) * sD i) ^ 2 := by linarith
  rw [← Real.sqrt_mul (by norm_num)]
  exact Real.le_sqrt_of_sq_le ha2

section KernelDecay

/-! ### Fourier decay of the normalized kernel (blueprint lines 2526-2534) -/

open Real in
/-- A function vanishing outside `[-R, R]` has its iterated derivatives vanishing there too. -/
theorem iteratedDeriv_eq_zero_of_support {f : ℝ → ℂ} {R : ℝ}
    (hsupp : ∀ x, f x ≠ 0 → |x| ≤ R) (k : ℕ) {x : ℝ} (hx : R < |x|) :
    iteratedDeriv k f x = 0 := by
  have hts : tsupport f ⊆ Set.Icc (-R) R := by
    refine closure_minimal (fun y hy => ?_) isClosed_Icc
    exact abs_le.mp (hsupp y hy)
  have hnot : x ∉ tsupport f := fun h => by
    have := abs_le.mpr (hts h); linarith only [hx, this]
  rw [iteratedDeriv]
  have : iteratedFDeriv ℝ k f x = 0 := by
    by_contra hne
    exact hnot (support_iteratedFDeriv_subset k (Function.mem_support.mpr hne))
  rw [this]; rfl

/-- The integral of a function bounded by `A` and vanishing outside `[-R, R]` is at most
`2 R A`. -/
theorem integral_norm_le_of_support {g : ℝ → ℂ} {R A : ℝ} (hR : 0 ≤ R)
    (hg : ∀ x, ‖g x‖ ≤ A) (hsupp : ∀ x, R < |x| → g x = 0) :
    ∫ x, ‖g x‖ ≤ 2 * R * A := by
  have hpt : ∀ x, ‖g x‖ ≤ Set.indicator (Set.Icc (-R) R) (fun _ => A) x := by
    intro x
    by_cases hx : x ∈ Set.Icc (-R) R
    · rw [Set.indicator_of_mem hx]; exact hg x
    · rw [Set.indicator_of_notMem hx, hsupp x (by
        by_contra h; push Not at h; exact hx (abs_le.mp h)), norm_zero]
  have hint : Integrable (Set.indicator (Set.Icc (-R) R) (fun _ : ℝ => A)) :=
    (continuous_const.integrableOn_Icc).integrable_indicator measurableSet_Icc
  calc ∫ x, ‖g x‖ ≤ ∫ x, Set.indicator (Set.Icc (-R) R) (fun _ => A) x :=
        integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => norm_nonneg _) hint
          (Filter.Eventually.of_forall hpt)
    _ = 2 * R * A := by
        rw [integral_indicator measurableSet_Icc, setIntegral_const, Real.volume_real_Icc,
          smul_eq_mul]
        rw [max_eq_left (by linarith)]
        ring

open Real in
theorem fourier_weighted_norm_bound {f : ℝ → ℂ} (J : ℕ) (hf : ContDiff ℝ (⊤ : ℕ∞) f)
    (hint : ∀ k ≤ J, Integrable (iteratedDeriv k f)) (q : ℝ) :
    (1 + |q| ^ J) * ‖𝓕 f q‖ ≤ (∫ v, ‖f v‖) +
      ((2 * π) ^ J)⁻¹ * ∫ v, ‖iteratedDeriv J f v‖ := by
  have hbase := VectorFourier.norm_fourierIntegral_le_integral_norm
    Real.fourierChar volume (innerₗ ℝ) f q
  have hderiv := VectorFourier.norm_fourierIntegral_le_integral_norm
    Real.fourierChar volume (innerₗ ℝ) (iteratedDeriv J f) q
  have hformula := congrFun (Real.fourier_iteratedDeriv
    (N := (J : ℕ∞)) (n := J) (hf.of_le (by exact_mod_cast le_top))
    (fun k hk => hint k (by exact_mod_cast hk)) le_rfl) q
  have hnorm : ‖𝓕 (iteratedDeriv J f) q‖ =
      (2 * π) ^ J * (|q| ^ J * ‖𝓕 f q‖) := by
    rw [hformula, norm_smul, norm_pow]
    simp [Complex.norm_real, abs_of_pos Real.pi_pos, mul_pow]
    ring
  change ‖𝓕 f q‖ ≤ _ at hbase
  change ‖𝓕 (iteratedDeriv J f) q‖ ≤ _ at hderiv
  rw [hnorm] at hderiv
  have hweighted : |q| ^ J * ‖𝓕 f q‖ ≤
      ((2 * π) ^ J)⁻¹ * ∫ v, ‖iteratedDeriv J f v‖ := by
    calc _ = ((2 * π) ^ J)⁻¹ * ((2 * π) ^ J * (|q| ^ J * ‖𝓕 f q‖)) := by
          field_simp
      _ ≤ _ := mul_le_mul_of_nonneg_left hderiv (by positivity)
  nlinarith only [hbase, hweighted]

open Real in
/-- Uniform Fourier decay of a smooth function vanishing outside `[-R, R]`:
`(1 + |q|^J) ‖𝓕 f q‖ ≤ 2 R (A₀ + (2π)^{-J} A_J)` when `|f| ≤ A₀` and `|f^{(J)}| ≤ A_J`. -/
theorem fourier_decay_of_support {f : ℝ → ℂ} (hf : ContDiff ℝ (⊤ : ℕ∞) f) {R : ℝ} (hR : 0 ≤ R)
    (hsupp : ∀ x, f x ≠ 0 → |x| ≤ R) (J : ℕ) {A₀ AJ : ℝ} (hA₀ : ∀ x, ‖f x‖ ≤ A₀)
    (hAJ : ∀ x, ‖iteratedDeriv J f x‖ ≤ AJ) (q : ℝ) :
    (1 + |q| ^ J) * ‖𝓕 f q‖ ≤ 2 * R * (A₀ + ((2 * π) ^ J)⁻¹ * AJ) := by
  have hA₀0 : 0 ≤ A₀ := (norm_nonneg _).trans (hA₀ 0)
  have hAJ0 : 0 ≤ AJ := (norm_nonneg _).trans (hAJ 0)
  have hcs : HasCompactSupport f := by
    refine HasCompactSupport.intro (isCompact_Icc (a := -R) (b := R)) fun x hx => ?_
    by_contra hne
    exact hx (abs_le.mp (hsupp x hne))
  have hint : ∀ k ≤ J, Integrable (iteratedDeriv k f) := by
    intro k _
    have hc : Continuous (iteratedDeriv k f) :=
      hf.continuous_iteratedDeriv k (by exact_mod_cast le_top)
    refine hc.integrable_of_hasCompactSupport ?_
    refine HasCompactSupport.intro (isCompact_Icc (a := -R) (b := R)) fun x hx => ?_
    refine iteratedDeriv_eq_zero_of_support hsupp k ?_
    by_contra h; push Not at h; exact hx (abs_le.mp h)
  have h := fourier_weighted_norm_bound J hf hint q
  have h1 : ∫ v, ‖f v‖ ≤ 2 * R * A₀ := integral_norm_le_of_support hR hA₀ fun x hx => by
    by_contra hne; have := hsupp x hne; linarith
  have h2 : ∫ v, ‖iteratedDeriv J f v‖ ≤ 2 * R * AJ :=
    integral_norm_le_of_support hR hAJ fun x hx => iteratedDeriv_eq_zero_of_support hsupp J hx
  have hπ : 0 ≤ ((2 * π) ^ J)⁻¹ := by positivity
  calc (1 + |q| ^ J) * ‖𝓕 f q‖ ≤ (∫ v, ‖f v‖) + ((2 * π) ^ J)⁻¹ * ∫ v, ‖iteratedDeriv J f v‖ := h
    _ ≤ 2 * R * A₀ + ((2 * π) ^ J)⁻¹ * (2 * R * AJ) := by gcongr
    _ = 2 * R * (A₀ + ((2 * π) ^ J)⁻¹ * AJ) := by ring

/-- The bounds of a normalized kernel at unit scale: smooth, vanishing outside `[-R, R]²`, with
line derivatives in each variable bounded by `A m`. -/
structure UnitKernelBounds (w : ℝ × ℝ → ℂ) (R : ℝ) (A : ℕ → ℝ) : Prop where
  smooth : ContDiff ℝ (⊤ : ℕ∞) w
  supp : ∀ x s, w (x, s) ≠ 0 → |x| ≤ R ∧ |s| ≤ R
  dx : ∀ m x s, ‖iteratedDeriv m (fun x => w (x, s)) x‖ ≤ A m
  ds : ∀ m x s, ‖iteratedDeriv m (fun s => w (x, s)) s‖ ≤ A m

/-- The Fourier transform of a kernel on `ℝ²` (first in `x`, then in `s`). -/
noncomputable def kernelFT (w : ℝ × ℝ → ℂ) (q t : ℝ) : ℂ :=
  ∫ s : ℝ, (Real.fourierChar (-(s * t)) : ℂ) * 𝓕 (fun x => w (x, s)) q

namespace UnitKernelBounds
variable {w : ℝ × ℝ → ℂ} {R : ℝ} {A : ℕ → ℝ} (hw : UnitKernelBounds w R A)
include hw

theorem A_nonneg (m : ℕ) : 0 ≤ A m := (norm_nonneg _).trans (hw.dx m 0 0)

theorem slice_x_smooth (s : ℝ) : ContDiff ℝ (⊤ : ℕ∞) (fun x => w (x, s)) :=
  hw.smooth.comp (contDiff_id.prodMk contDiff_const)

theorem slice_s_smooth (x : ℝ) : ContDiff ℝ (⊤ : ℕ∞) (fun s => w (x, s)) :=
  hw.smooth.comp (contDiff_const.prodMk contDiff_id)

open Real in
/-- Fourier decay of the `x`-slices, uniformly in `s`. -/
theorem slice_decay (hR : 0 ≤ R) (J : ℕ) (s q : ℝ) :
    (1 + |q| ^ J) * ‖𝓕 (fun x => w (x, s)) q‖ ≤ 2 * R * (A 0 + ((2 * π) ^ J)⁻¹ * A J) :=
  fourier_decay_of_support (hw.slice_x_smooth s) hR (fun x hx => (hw.supp x s hx).1) J
    (fun x => by simpa using hw.dx 0 x s) (hw.dx J · s) q

/-- The `x`-slices vanish for `|s| > R`. -/
theorem slice_eq_zero {s : ℝ} (hs : R < |s|) (q : ℝ) : 𝓕 (fun x => w (x, s)) q = 0 := by
  have : (fun x => w (x, s)) = 0 := by
    funext x
    by_contra h
    have := (hw.supp x s h).2
    linarith
  rw [this]
  simp [Real.fourier_real_eq]

open Real in
/-- Blueprint lines 2530-2533 (rapid decay in the first frequency):
`(1 + |q|^J) |WFourier(q, t)| ≤ 2R · 2R (A₀ + (2π)^{-J} A_J)`. -/
theorem decay_q (hR : 0 ≤ R) (J : ℕ) (q t : ℝ) :
    (1 + |q| ^ J) * ‖kernelFT w q t‖ ≤
      2 * R * (2 * R * (A 0 + ((2 * π) ^ J)⁻¹ * A J)) := by
  have hpos : 0 < 1 + |q| ^ J := by positivity
  set M := 2 * R * (A 0 + ((2 * π) ^ J)⁻¹ * A J)
  have hg : ∀ s, ‖(Real.fourierChar (-(s * t)) : ℂ) * 𝓕 (fun x => w (x, s)) q‖ ≤
      M / (1 + |q| ^ J) := by
    intro s
    rw [norm_mul, Circle.norm_coe, one_mul, le_div_iff₀ hpos, mul_comm]
    exact hw.slice_decay hR J s q
  have hint := integral_norm_le_of_support hR hg fun s hs => by
    rw [hw.slice_eq_zero hs q, mul_zero]
  unfold kernelFT
  rw [mul_comm, ← le_div_iff₀ hpos]
  refine (norm_integral_le_integral_norm _).trans (hint.trans (le_of_eq ?_))
  field_simp

/-- The phase-weighted kernel on `ℝ × ℝ` (in the order `(s, x)`) is integrable. -/
theorem integrable_phase (q t : ℝ) :
    Integrable (fun p : ℝ × ℝ => (Real.fourierChar (-(p.1 * t)) : ℂ) *
      ((Real.fourierChar (-(p.2 * q)) : ℂ) * w (p.2, p.1))) (volume.prod volume) := by
  refine Continuous.integrable_of_hasCompactSupport ?_ ?_
  · have hc := hw.smooth.continuous
    have h1 : Continuous fun p : ℝ × ℝ => (Real.fourierChar (-(p.1 * t)) : ℂ) :=
      continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))
    have h2 : Continuous fun p : ℝ × ℝ => (Real.fourierChar (-(p.2 * q)) : ℂ) :=
      continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))
    exact h1.mul (h2.mul (hc.comp (continuous_snd.prodMk continuous_fst)))
  · refine HasCompactSupport.intro ((isCompact_Icc (a := -R) (b := R)).prod
      (isCompact_Icc (a := -R) (b := R))) fun p hp => ?_
    by_contra hne
    have hw0 : w (p.2, p.1) ≠ 0 := fun h => hne (by rw [h, mul_zero, mul_zero])
    obtain ⟨h1, h2⟩ := hw.supp p.2 p.1 hw0
    exact hp ⟨abs_le.mp h2, abs_le.mp h1⟩

/-- Fubini: the kernel transform computed first in `s`, then in `x`. -/
theorem kernelFT_swap (q t : ℝ) :
    kernelFT w q t = ∫ x : ℝ, (Real.fourierChar (-(x * q)) : ℂ) * 𝓕 (fun s => w (x, s)) t := by
  unfold kernelFT
  simp_rw [Real.fourier_real_eq, Circle.smul_def, smul_eq_mul, ← integral_const_mul]
  rw [integral_integral_swap (hw.integrable_phase q t)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  refine integral_congr_ae (Filter.Eventually.of_forall fun s => ?_)
  simp only
  ring

open Real in
/-- Blueprint lines 2530-2533 (rapid decay in the second frequency). -/
theorem decay_t (hR : 0 ≤ R) (J : ℕ) (q t : ℝ) :
    (1 + |t| ^ J) * ‖kernelFT w q t‖ ≤
      2 * R * (2 * R * (A 0 + ((2 * π) ^ J)⁻¹ * A J)) := by
  have hpos : 0 < 1 + |t| ^ J := by positivity
  set M := 2 * R * (A 0 + ((2 * π) ^ J)⁻¹ * A J)
  have hdec : ∀ x, (1 + |t| ^ J) * ‖𝓕 (fun s => w (x, s)) t‖ ≤ M := fun x =>
    fourier_decay_of_support (hw.slice_s_smooth x) hR (fun s hs => (hw.supp x s hs).2) J
      (fun s => by simpa using hw.ds 0 x s) (hw.ds J x ·) t
  have hzero : ∀ x, R < |x| → 𝓕 (fun s => w (x, s)) t = 0 := by
    intro x hx
    have : (fun s => w (x, s)) = 0 := by
      funext s
      by_contra h
      have := (hw.supp x s h).1
      linarith
    rw [this]
    simp [Real.fourier_real_eq]
  have hg : ∀ x, ‖(Real.fourierChar (-(x * q)) : ℂ) * 𝓕 (fun s => w (x, s)) t‖ ≤
      M / (1 + |t| ^ J) := by
    intro x
    rw [norm_mul, Circle.norm_coe, one_mul, le_div_iff₀ hpos, mul_comm]
    exact hdec x
  have hint := integral_norm_le_of_support hR hg fun x hx => by rw [hzero x hx, mul_zero]
  rw [hw.kernelFT_swap, mul_comm, ← le_div_iff₀ hpos]
  refine (norm_integral_le_integral_norm _).trans (hint.trans (le_of_eq ?_))
  field_simp

/-- The sheared slices `u ↦ w(u - j s, s)` and their phase-weighted product integrability. -/
theorem integrable_shear (j q : ℝ) :
    Integrable (fun p : ℝ × ℝ => (Real.fourierChar (-(p.2 * q)) : ℂ) * w (p.2 - j * p.1, p.1))
      (volume.prod volume) := by
  refine Continuous.integrable_of_hasCompactSupport ?_ ?_
  · have hc := hw.smooth.continuous
    have h2 : Continuous fun p : ℝ × ℝ => (Real.fourierChar (-(p.2 * q)) : ℂ) :=
      continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))
    exact h2.mul (hc.comp (by fun_prop))
  · refine HasCompactSupport.intro ((isCompact_Icc (a := -R) (b := R)).prod
      (isCompact_Icc (a := -(R + |j| * R)) (b := R + |j| * R))) fun p hp => ?_
    by_contra hne
    have hw0 : w (p.2 - j * p.1, p.1) ≠ 0 := fun h => hne (by rw [h, mul_zero])
    obtain ⟨h1, h2⟩ := hw.supp _ _ hw0
    apply hp
    refine ⟨abs_le.mp h2, abs_le.mp ?_⟩
    have : |j * p.1| ≤ |j| * R := by rw [abs_mul]; exact mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
    calc |p.2| = |(p.2 - j * p.1) + j * p.1| := by ring_nf
      _ ≤ |p.2 - j * p.1| + |j * p.1| := abs_add_le _ _
      _ ≤ R + |j| * R := add_le_add h1 this

open Real in
/-- Blueprint lines 2529-2533 (zeros on the lines `t = j q` and smoothness near them): if the
marginals `∫ w(u - j s, s) ds` vanish, then near the line,
`(1 + |q|^J) |WFourier(q, j q + δ)| ≤ 2R · 2πR|δ| · 2(R + |j|R) (A₀ + (2π)^{-J} A_J)`. -/
theorem near_line (hR : 0 ≤ R) (J : ℕ) (j : ℝ) (hmarg : ∀ u, ∫ s, w (u - j * s, s) = 0)
    (q δ : ℝ) :
    (1 + |q| ^ J) * ‖kernelFT w q (j * q + δ)‖ ≤
      2 * R * (2 * π * R * |δ| * (2 * (R + |j| * R) * (A 0 + ((2 * π) ^ J)⁻¹ * A J))) := by
  have hpos : 0 < 1 + |q| ^ J := by positivity
  set R' := R + |j| * R
  have hR' : 0 ≤ R' := by positivity
  set F : ℝ → ℂ := fun s => 𝓕 (fun u => w (u - j * s, s)) q
  have hchar : ∀ a b : ℝ, (Real.fourierChar (a + b) : ℂ) =
      (Real.fourierChar a : ℂ) * (Real.fourierChar b : ℂ) := fun a b => by
    rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul]
  -- translation of the slices
  have htrans : ∀ s, 𝓕 (fun x => w (x, s)) q =
      (Real.fourierChar (j * s * q) : ℂ) * F s := by
    intro s
    simp only [F, Real.fourier_real_eq, Circle.smul_def, smul_eq_mul]
    rw [← integral_sub_right_eq_self (fun x => (Real.fourierChar (-(x * q)) : ℂ) * w (x, s))
      (j * s), ← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)

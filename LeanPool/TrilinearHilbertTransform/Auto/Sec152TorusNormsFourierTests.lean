open Real in
/-- Blueprint lines 2526-2534 (`|WFourier_s(r q', r t')| ≤ C_J μ ν^{-J}`): if the marginals along
  the
lines `t = j q`, `j ∈ L` (`|j| ≤ J_b`), vanish, then with `μ = min(1, min_j |t - j q|)` and
`ν = max(1, |q|, |t|)`, `|WFourier(q, t)| ν^J ≤ C μ` for an explicit `C` depending only on `R, J_b`
and the derivative bounds. -/
theorem decay_lines (hR : 0 ≤ R) (J : ℕ) (L : Finset ℝ) (hL : L.Nonempty) {Jb : ℝ}
    (hJb : ∀ j ∈ L, |j| ≤ Jb) (hmarg : ∀ j ∈ L, ∀ u, ∫ s, w (u - j * s, s) = 0) (q t : ℝ) :
    ‖kernelFT w q t‖ * max 1 (max |q| |t|) ^ J ≤
      (2 * (2 * R * (2 * R * (A 0 + ((2 * π) ^ J)⁻¹ * A J))) + (Jb + 2) ^ J *
        (2 * R * (2 * π * R * (2 * (R + Jb * R) * (A 0 + ((2 * π) ^ J)⁻¹ * A J))))) *
      min 1 (L.inf' hL fun j => |t - j * q|) := by
  set D := 2 * R * (2 * R * (A 0 + ((2 * π) ^ J)⁻¹ * A J))
  set Nb := 2 * R * (2 * π * R * (2 * (R + Jb * R) * (A 0 + ((2 * π) ^ J)⁻¹ * A J)))
  obtain ⟨j₀, hj₀L, hj₀⟩ := Finset.exists_mem_eq_inf' hL fun j => |t - j * q|
  have hJb0 : 0 ≤ Jb := (abs_nonneg _).trans (hJb j₀ hj₀L)
  have hA0 := hw.A_nonneg 0
  have hAJ := hw.A_nonneg J
  have hD0 : 0 ≤ D := by positivity
  have hN0 : 0 ≤ Nb := by positivity
  have hK := norm_nonneg (kernelFT w q t)
  set m := L.inf' hL fun j => |t - j * q|
  have hmax : max 1 (max |q| |t|) ^ J ≤ (1 + |q| ^ J) + (1 + |t| ^ J) := by
    rcases le_total 1 (max |q| |t|) with h | h
    · rw [max_eq_right h]
      rcases le_total |q| |t| with h' | h'
      · rw [max_eq_right h']; have := pow_nonneg (abs_nonneg q) J; linarith
      · rw [max_eq_left h']; have := pow_nonneg (abs_nonneg t) J; linarith
    · rw [max_eq_left h, one_pow]
      have := pow_nonneg (abs_nonneg q) J; have := pow_nonneg (abs_nonneg t) J; linarith
  by_cases hm : 1 ≤ m
  · rw [min_eq_left hm, mul_one]
    have h1 := hw.decay_q hR J q t
    have h2 := hw.decay_t hR J q t
    have : 0 ≤ (Jb + 2) ^ J * Nb := by positivity
    calc ‖kernelFT w q t‖ * max 1 (max |q| |t|) ^ J
        ≤ ‖kernelFT w q t‖ * ((1 + |q| ^ J) + (1 + |t| ^ J)) :=
          mul_le_mul_of_nonneg_left hmax hK
      _ ≤ 2 * D := by nlinarith only [h1, h2]
      _ ≤ _ := by linarith
  · push Not at hm
    rw [min_eq_right hm.le]
    have hδ : t = j₀ * q + (t - j₀ * q) := by ring
    have hnear := hw.near_line hR J j₀ (hmarg j₀ hj₀L) q (t - j₀ * q)
    rw [← hδ] at hnear
    have hmδ : |t - j₀ * q| = m := hj₀.symm
    rw [hmδ] at hnear
    -- the constant at `j₀` is at most the one at `J_b`
    have hR' : 2 * π * R * m * (2 * (R + |j₀| * R) * (A 0 + ((2 * π) ^ J)⁻¹ * A J)) ≤
        2 * π * R * m * (2 * (R + Jb * R) * (A 0 + ((2 * π) ^ J)⁻¹ * A J)) := by
      have hm0 : 0 ≤ m := hmδ ▸ abs_nonneg _
      gcongr
      exact hJb j₀ hj₀L
    have hN : (1 + |q| ^ J) * ‖kernelFT w q t‖ ≤ Nb * m := by
      calc (1 + |q| ^ J) * ‖kernelFT w q t‖ ≤ 2 * R * (2 * π * R * m *
            (2 * (R + |j₀| * R) * (A 0 + ((2 * π) ^ J)⁻¹ * A J))) := hnear
        _ ≤ 2 * R * (2 * π * R * m * (2 * (R + Jb * R) * (A 0 + ((2 * π) ^ J)⁻¹ * A J))) :=
            mul_le_mul_of_nonneg_left hR' (by positivity)
        _ = Nb * m := by ring
    -- `ν ≤ (J_b + 2) max(1, |q|)`
    have hν : max 1 (max |q| |t|) ^ J ≤ (Jb + 2) ^ J * (1 + |q| ^ J) := by
      have ht : |t| ≤ Jb * |q| + 1 := by
        have h1 : |t| ≤ |j₀ * q| + |t - j₀ * q| := by
          calc |t| = |j₀ * q + (t - j₀ * q)| := by ring_nf
            _ ≤ _ := abs_add_le _ _
        rw [abs_mul, hmδ] at h1
        have := mul_le_mul_of_nonneg_right (hJb j₀ hj₀L) (abs_nonneg q)
        linarith
      have hle : max 1 (max |q| |t|) ≤ (Jb + 2) * max 1 |q| := by
        have hq1 : 1 ≤ max 1 |q| := le_max_left _ _
        have hqq : |q| ≤ max 1 |q| := le_max_right _ _
        refine max_le (by nlinarith only [hJb0, hq1]) (max_le (by nlinarith only [hJb0, hq1,
            hqq]) (by nlinarith only [hJb0, ht, hq1, hqq]))
      have hp : (max 1 |q|) ^ J ≤ 1 + |q| ^ J := by
        rcases le_total 1 |q| with h | h
        · rw [max_eq_right h]; linarith
        · rw [max_eq_left h, one_pow]; have := pow_nonneg (abs_nonneg q) J; linarith
      calc max 1 (max |q| |t|) ^ J ≤ ((Jb + 2) * max 1 |q|) ^ J :=
            pow_le_pow_left₀ (le_trans zero_le_one (le_max_left _ _)) hle J
        _ = (Jb + 2) ^ J * (max 1 |q|) ^ J := mul_pow _ _ _
        _ ≤ (Jb + 2) ^ J * (1 + |q| ^ J) := mul_le_mul_of_nonneg_left hp (by positivity)
    have hm0 : 0 ≤ m := hmδ ▸ abs_nonneg _
    calc ‖kernelFT w q t‖ * max 1 (max |q| |t|) ^ J
        ≤ ‖kernelFT w q t‖ * ((Jb + 2) ^ J * (1 + |q| ^ J)) := mul_le_mul_of_nonneg_left hν hK
      _ = (Jb + 2) ^ J * ((1 + |q| ^ J) * ‖kernelFT w q t‖) := by ring
      _ ≤ (Jb + 2) ^ J * (Nb * m) := mul_le_mul_of_nonneg_left hN (by positivity)
      _ ≤ (2 * D + (Jb + 2) ^ J * Nb) * m := by nlinarith only [hD0, hm0]

end UnitKernelBounds


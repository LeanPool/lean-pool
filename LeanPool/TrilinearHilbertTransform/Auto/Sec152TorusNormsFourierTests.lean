section CosetHaar
variable {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))

/-- Blueprint line 2526 (the retained coset coefficient is bounded by `C Π_j a'_j` by
`eq:Haar-four`): for a bounded continuous multiplier `R`, continuous `g_j` on `𝓗` and a unimodular
continuous weight `χ`,
`|∫∫_{𝓗²} R(u, v) Π_j g_j(u + (j - l) v) χ(u, v)| ≤ W Π_j ‖g_j‖_{L²(𝓗)}`. -/
theorem coset_haar_four_le
    (Rm : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ) (hRm : Continuous Rm) {W : ℝ}
    (hW : 0 ≤ W) (hRb : ∀ z, ‖Rm z‖ ≤ W) (l : ℤ)
    (g : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℂ)
    (hg : ∀ i, Continuous (g i))
    (χ : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ) (hχc : Continuous χ)
    (hχ : ∀ z, ‖χ z‖ ≤ 1) :
    ‖∫ u, ∫ v, Rm (u, v) * (∏ i, g i (u + ((i : ℤ) - l) • v)) * χ (u, v)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)‖ ≤
      W * ∏ i, (eLpNorm (g i) 2 (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal := by
  set μ := torusAnnihilatorHaar (rationalIntegerIntersection V)
  set! F : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ :=
    fun z => Rm z * (∏ i, g i (z.1 + ((i : ℤ) - l) • z.2)) * χ z
  have hFc : Continuous F := by
    refine (hRm.mul (continuous_finsetProd _ fun i _ => (hg i).comp ?_)).mul hχc
    exact continuous_fst.add ((continuous_zsmul _).comp continuous_snd)
  have hFi : Integrable F (μ.prod μ) := hFc.integrable_of_hasCompactSupport
    (HasCompactSupport.of_compactSpace F)
  have hmeas : ∀ i, AEStronglyMeasurable (g i) μ := fun i => (hg i).aestronglyMeasurable
  have hfin : ∀ i, eLpNorm (g i) 2 μ ≠ ⊤ := fun i => by
    obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn (hg i).continuousOn
    exact (MemLp.of_bound (hmeas i) C (Filter.Eventually.of_forall fun x =>
      hC x (Set.mem_univ x))).eLpNorm_ne_top
  have hlin : ∫⁻ z, ‖F z‖ₑ ∂(μ.prod μ) ≤
      ENNReal.ofReal W * ∏ i, eLpNorm (g i) 2 μ := by
    have h := haar_four V (fun _ => ENNReal.ofReal W) measurable_const (fun _ => le_refl _) l
      (fun i x => ‖g i x‖ₑ) (fun i => (hg i).enorm.measurable)
    calc ∫⁻ z, ‖F z‖ₑ ∂(μ.prod μ) ≤ ∫⁻ z, ENNReal.ofReal W *
          ∏ i, ‖g i (z.1 + ((i : ℤ) - l) • z.2)‖ₑ ∂(μ.prod μ) := by
          refine lintegral_mono fun z => ?_
          simp only [F, enorm_mul]
          calc ‖Rm z‖ₑ * ‖∏ i, g i (z.1 + ((i : ℤ) - l) • z.2)‖ₑ * ‖χ z‖ₑ
              ≤ ENNReal.ofReal W * ‖∏ i, g i (z.1 + ((i : ℤ) - l) • z.2)‖ₑ * 1 := by
                gcongr
                · rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hRb z)
                · rw [← ofReal_norm, ← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (hχ z)
            _ = ENNReal.ofReal W * ∏ i, ‖g i (z.1 + ((i : ℤ) - l) • z.2)‖ₑ := by
                rw [mul_one]
                congr 1
                simp only [enorm_eq_nnnorm, nnnorm_prod, ENNReal.ofNNReal_finsetProd]
      _ ≤ ENNReal.ofReal W * ∏ i, eLpNorm (fun x => ‖g i x‖ₑ) 2 μ := h
      _ = ENNReal.ofReal W * ∏ i, eLpNorm (g i) 2 μ := by
          congr 1
          exact Finset.prod_congr rfl fun i _ => eLpNorm_enorm _ (hmeas i)
  rw [← integral_prod F hFi]
  refine (norm_integral_le_integral_norm _).trans ?_
  rw [integral_norm_eq_lintegral_enorm hFi.aestronglyMeasurable]
  have hR : ENNReal.ofReal W * ∏ i, eLpNorm (g i) 2 μ ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top (ENNReal.prod_ne_top fun i _ => hfin i)
  calc (∫⁻ z, ‖F z‖ₑ ∂(μ.prod μ)).toReal ≤ (ENNReal.ofReal W * ∏ i, eLpNorm (g i) 2 μ).toReal :=
        ENNReal.toReal_mono hR hlin
    _ = W * ∏ i, (eLpNorm (g i) 2 μ).toReal := by
        rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal hW, ENNReal.toReal_prod]

end CosetHaar

/-- Blueprint lines 2522-2523 ("its characters sample `WFourier_s` at `r(Q + n·ξ, T + m·ξ)`"): the
normalized local form of an integrable kernel against a linear phase `e(A x + B t + C)` is a value
of the Fourier transform of the unit-scale kernel,
`r⁻² ∫ w(z) e(A z₁ + B z₂ + C) = e(C + A (a₀ + r/2)) WFourier(-r A, -r B)`. -/
theorem form_linear_phase {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ} (hw : Integrable w)
    (A B C : ℝ) :
    (r : ℂ)⁻¹ ^ 2 * ∫ z : ℝ × ℝ, w z * (Real.fourierChar (A * z.1 + B * z.2 + C) : ℂ) =
      (Real.fourierChar (C + A * (a₀ + r / 2)) : ℂ) *
        kernelFT (unitKernel a₀ r w) (-(r * A)) (-(r * B)) := by
  have hr0 : (r : ℂ) ≠ 0 := by exact_mod_cast hr.ne'
  have hchar : ∀ a b : ℝ, (Real.fourierChar (a + b) : ℂ) =
      (Real.fourierChar a : ℂ) * (Real.fourierChar b : ℂ) := fun a b => by
    rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul]
  set f : ℝ × ℝ → ℂ := fun z => w z * (Real.fourierChar (A * z.1 + B * z.2 + C) : ℂ)
  have hcont : Continuous fun z : ℝ × ℝ => (Real.fourierChar (A * z.1 + B * z.2 + C) : ℂ) :=
    continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))
  have hfi : Integrable f := hw.mul_bdd (c := 1) hcont.aestronglyMeasurable
    (Filter.Eventually.of_forall fun z => by rw [Circle.norm_coe])
  -- the plane integral as an iterated integral, `s` outside
  have hprod : ∫ z : ℝ × ℝ, f z = ∫ s, ∫ x, f (x, s) := by
    rw [MeasureTheory.Measure.volume_eq_prod] at hfi ⊢
    exact integral_prod_symm f hfi
  -- rescale both variables
  have hin : ∀ s, ∫ x, f (x, s) = r * ∫ x, f (a₀ + r / 2 + r * x, s) := by
    intro s
    have h1 := Measure.integral_comp_mul_left (fun x => f (a₀ + r / 2 + x, s)) r
    have h2 := integral_add_left_eq_self (μ := volume) (fun x => f (x, s)) (a₀ + r / 2)
    rw [h1, h2, abs_inv, abs_of_pos hr, Complex.real_smul, ← mul_assoc]
    rw [show (r : ℂ) * ((r⁻¹ : ℝ) : ℂ) = 1 by push_cast; field_simp, one_mul]
  have hout : ∫ s, (r : ℂ) * ∫ x, f (a₀ + r / 2 + r * x, s) =
      (r : ℂ) * (r * ∫ s, ∫ x, f (a₀ + r / 2 + r * x, r * s)) := by
    rw [integral_const_mul]
    congr 1
    have h1 := Measure.integral_comp_mul_left (fun s => ∫ x, f (a₀ + r / 2 + r * x, s)) r
    rw [h1, abs_inv, abs_of_pos hr, Complex.real_smul, ← mul_assoc]
    rw [show (r : ℂ) * ((r⁻¹ : ℝ) : ℂ) = 1 by push_cast; field_simp, one_mul]
  rw [hprod]
  simp_rw [hin]
  rw [hout, UnitKernelBounds.kernelFT_eq_iter, ← mul_assoc, ← mul_assoc]
  rw [show (r : ℂ)⁻¹ ^ 2 * r * r = 1 by field_simp, one_mul, ← integral_const_mul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun s => ?_)
  simp only
  rw [← integral_const_mul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  simp only [f, unitKernel]
  rw [show A * (a₀ + r / 2 + r * x) + B * (r * s) + C =
      (C + A * (a₀ + r / 2)) + (-(s * -(r * B)) + -(x * -(r * A))) by ring,
    hchar (C + A * (a₀ + r / 2)), hchar (-(s * -(r * B)))]
  ring

/-! ### Three-core tests (blueprint lines 2536-2565) -/

/-- Blueprint lines 2540-2542 and 2553-2556 (the anchor function and the pairing entries): with
anchor `l` and `|l| ≤ J_b`, a kernel transform bounded by `C μ ν^{-(J + A)}` (`decay_lines`, with
the line `t = l q` among the zero lines) has, at `(κ, β + l κ)`,
`|WFourier(κ, β + lκ)| ≤ C (J_b + 2)^{J + A} min(1, |β|) max(1, |β|)^{-J} max(1, |κ|)^{-A}`. -/
theorem anchor_entry_bound {K : ℝ → ℝ → ℂ} {C Jb : ℝ} (hC : 0 ≤ C) (hJb : 0 ≤ Jb) (J A : ℕ)
    (L : Finset ℝ) (hL : L.Nonempty) {l : ℝ} (hl : l ∈ L) (hlb : |l| ≤ Jb)
    (hK : ∀ q t, ‖K q t‖ * max 1 (max |q| |t|) ^ (J + A) ≤
      C * min 1 (L.inf' hL fun j => |t - j * q|)) (κ β : ℝ) :
    ‖K κ (β + l * κ)‖ * (max 1 |β| ^ J * max 1 |κ| ^ A) ≤
      C * (Jb + 2) ^ (J + A) * min 1 |β| := by
  have hk := hK κ (β + l * κ)
  have hmin : min 1 (L.inf' hL fun j => |β + l * κ - j * κ|) ≤ min 1 |β| := by
    refine min_le_min le_rfl ((Finset.inf'_le _ hl).trans (le_of_eq ?_))
    congr 1; ring
  have hm0 : 0 ≤ min 1 (L.inf' hL fun j => |β + l * κ - j * κ|) :=
    le_min zero_le_one (Finset.le_inf' _ _ fun j _ => abs_nonneg _)
  have hβ1 : 1 ≤ max 1 |β| := le_max_left _ _
  have hκ1 : 1 ≤ max 1 |κ| := le_max_left _ _
  -- `max(1,|β|) max(1,|κ|) ≤ (J_b + 2) max(1, |κ|, |β + lκ|)`
  set M := max 1 (max |κ| |β + l * κ|)
  have hM1 : 1 ≤ M := le_max_left _ _
  have hκM : max 1 |κ| ≤ M := max_le (le_max_left _ _) ((le_max_left _ _).trans (le_max_right _ _))
  have hβM : |β| ≤ (Jb + 1) * M := by
    have h1 : |β| ≤ |β + l * κ| + |l| * |κ| := by
      have := abs_sub (β + l * κ) (l * κ)
      rw [abs_mul] at this
      have e : β + l * κ - l * κ = β := by ring
      rw [e] at this; exact this
    have h2 : |β + l * κ| ≤ M := (le_max_right _ _).trans (le_max_right _ _)
    have h3 : |κ| ≤ M := (le_max_left _ _).trans (le_max_right _ _)
    have h4 : |l| * |κ| ≤ Jb * M := mul_le_mul hlb h3 (abs_nonneg _) hJb
    nlinarith
  have hβM' : max 1 |β| ≤ (Jb + 2) * M := max_le (by nlinarith) (by nlinarith)
  have hpow : max 1 |β| ^ J * max 1 |κ| ^ A ≤ (Jb + 2) ^ (J + A) * M ^ (J + A) := by
    rw [pow_add, pow_add]
    have h1 : max 1 |β| ^ J ≤ ((Jb + 2) * M) ^ J := pow_le_pow_left₀ (by positivity) hβM' J
    have h2 : max 1 |κ| ^ A ≤ M ^ A := pow_le_pow_left₀ (by positivity) hκM A
    have h3 : max 1 |κ| ^ A ≤ (Jb + 2) ^ A * M ^ A := by
      have : (1 : ℝ) ≤ (Jb + 2) ^ A := one_le_pow₀ (by linarith)
      nlinarith only [pow_nonneg (by positivity : (0 : ℝ) ≤ M) A, h2, this]
    calc max 1 |β| ^ J * max 1 |κ| ^ A ≤ ((Jb + 2) * M) ^ J * ((Jb + 2) ^ A * M ^ A) :=
          mul_le_mul h1 h3 (by positivity) (by positivity)
      _ = (Jb + 2) ^ J * (Jb + 2) ^ A * (M ^ J * M ^ A) := by rw [mul_pow]; ring
  have hKn := norm_nonneg (K κ (β + l * κ))
  calc ‖K κ (β + l * κ)‖ * (max 1 |β| ^ J * max 1 |κ| ^ A)
      ≤ ‖K κ (β + l * κ)‖ * ((Jb + 2) ^ (J + A) * M ^ (J + A)) :=
        mul_le_mul_of_nonneg_left hpow hKn
    _ = (Jb + 2) ^ (J + A) * (‖K κ (β + l * κ)‖ * M ^ (J + A)) := by ring
    _ ≤ (Jb + 2) ^ (J + A) * (C * min 1 (L.inf' hL fun j => |β + l * κ - j * κ|)) :=
        mul_le_mul_of_nonneg_left hk (by positivity)
    _ ≤ (Jb + 2) ^ (J + A) * (C * min 1 |β|) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hmin hC) (by positivity)
    _ = C * (Jb + 2) ^ (J + A) * min 1 |β| := by ring

section DualSlice
variable {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))

/-- The `L²` norm of a continuous function on the annihilator torus. -/
theorem eLpNorm_toReal_eq_sqrt
    (f : torusAnnihilator (rationalIntegerIntersection V) → ℂ) (hf : Continuous f) :
    (eLpNorm f 2 (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal =
      Real.sqrt (∫ u, ‖f u‖ ^ 2 ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) := by
  obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn hf.continuousOn
  have hm : MemLp f 2 (torusAnnihilatorHaar (rationalIntegerIntersection V)) :=
    MemLp.of_bound hf.aestronglyMeasurable C (Filter.Eventually.of_forall fun x =>
      hC x (Set.mem_univ x))
  rw [hm.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num),
    ENNReal.toReal_ofReal (Real.rpow_nonneg (integral_nonneg fun _ => by positivity) _),
    Real.sqrt_eq_rpow]
  norm_num

/-- Blueprint lines 2545-2547 (`‖D_m‖₂ ≤ C Π_{j ≠ l} a'_j` by duality and `eq:Haar-four`): for the
slice `D_m(u) = ∫ D(u, v) e(-m·v) dv` of `D(u, v) = R(u, v) Π_{j ≠ l} g_j(u + (j - l) v)`,
`‖D_m‖_{L²(𝓗)} ≤ W Π_{j ≠ l} ‖g_j‖_{L²(𝓗)}`. -/
theorem dual_slice_bound
    (Rm : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ) (hRm : Continuous Rm) {W : ℝ}
    (hW : 0 ≤ W) (hRb : ∀ z, ‖Rm z‖ ≤ W) (l : Fin 4)
    (g : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℂ)
    (hg : ∀ i, Continuous (g i)) (m : Fin d → ℤ) :
    Real.sqrt (∫ u, ‖∫ v, Rm (u, v) *
        (∏ i ∈ Finset.univ.erase l, g i (u + ((i : ℤ) - (l : ℤ)) • v)) *
          starRingEnd ℂ (torusCharacter m v)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)‖ ^ 2
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) ≤
      W * ∏ i ∈ Finset.univ.erase l,
        (eLpNorm (g i) 2 (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal := by
  classical
  set μ := torusAnnihilatorHaar (rationalIntegerIntersection V)
  set! Dm : torusAnnihilator (rationalIntegerIntersection V) → ℂ := fun u =>
    ∫ v, Rm (u, v) * (∏ i ∈ Finset.univ.erase l, g i (u + ((i : ℤ) - (l : ℤ)) • v)) *
      starRingEnd ℂ (torusCharacter m v) ∂μ
  have hχ : Continuous fun v : torusAnnihilator (rationalIntegerIntersection V) =>
      starRingEnd ℂ (torusCharacter m v) :=
    (continuous_star.comp ((continuous_torusCharacter m).comp continuous_subtype_val))
  have hint : Continuous fun p : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) =>
      Rm (p.1, p.2) * (∏ i ∈ Finset.univ.erase l, g i (p.1 + ((i : ℤ) - (l : ℤ)) • p.2)) *
        starRingEnd ℂ (torusCharacter m p.2) := by
    refine (hRm.mul (continuous_finsetProd _ fun i _ => (hg i).comp ?_)).mul
      (hχ.comp continuous_snd)
    exact continuous_fst.add ((continuous_zsmul _).comp continuous_snd)
  have hDc : Continuous Dm := by
    have h := continuous_parametric_integral_of_continuous (μ := μ)
      (f := fun u v => Rm (u, v) * (∏ i ∈ Finset.univ.erase l,
        g i (u + ((i : ℤ) - (l : ℤ)) • v)) * starRingEnd ℂ (torusCharacter m v))
      hint isCompact_univ
    simpa [Measure.restrict_univ] using h
  -- the four functions with the dual slice in the anchor slot
  set! g' : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℂ := fun i =>
    if i = l then fun u => starRingEnd ℂ (Dm u) else g i
  have hg' : ∀ i, Continuous (g' i) := by
    intro i
    by_cases hi : i = l
    · simp only [g', hi, ↓reduceIte]; exact continuous_star.comp hDc
    · simp only [g', hi, ↓reduceIte]; exact hg i
  have h := coset_haar_four_le V Rm hRm hW hRb (l : ℤ) g' hg'
    (fun z => starRingEnd ℂ (torusCharacter m z.2)) (hχ.comp continuous_snd)
    (fun z => by
      rw [RCLike.norm_conj]
      unfold torusCharacter; rw [fourier_apply, Circle.norm_coe])
  -- the left side is the squared norm of the slice
  have hprod : ∀ u v, ∏ i, g' i (u + ((i : ℤ) - (l : ℤ)) • v) =
      starRingEnd ℂ (Dm u) * ∏ i ∈ Finset.univ.erase l, g i (u + ((i : ℤ) - (l : ℤ)) • v) := by
    intro u v
    rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ l)]
    congr 1
    · simp [g']
    · refine Finset.prod_congr rfl fun i hi => ?_
      simp [g', (Finset.mem_erase.mp hi).1]
  have hlhs : (∫ u, ∫ v, Rm (u, v) * (∏ i, g' i (u + ((i : ℤ) - (l : ℤ)) • v)) *
      starRingEnd ℂ (torusCharacter m (u, v).2) ∂μ ∂μ) = ∫ u, ((‖Dm u‖ ^ 2 : ℝ) : ℂ) ∂μ := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
    simp only
    simp_rw [hprod]
    rw [show (fun v => Rm (u, v) * (starRingEnd ℂ (Dm u) *
        ∏ i ∈ Finset.univ.erase l, g i (u + ((i : ℤ) - (l : ℤ)) • v)) *
          starRingEnd ℂ (torusCharacter m v)) = fun v => starRingEnd ℂ (Dm u) *
            (Rm (u, v) * (∏ i ∈ Finset.univ.erase l, g i (u + ((i : ℤ) - (l : ℤ)) • v)) *
              starRingEnd ℂ (torusCharacter m v)) by funext v; ring,
      integral_const_mul]
    rw [mul_comm, Complex.mul_conj, Complex.normSq_eq_norm_sq]
  rw [hlhs, integral_complex_ofReal, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (integral_nonneg fun _ => by positivity)] at h
  have hgl : (eLpNorm (g' l) 2 μ).toReal = Real.sqrt (∫ u, ‖Dm u‖ ^ 2 ∂μ) := by
    rw [eLpNorm_toReal_eq_sqrt V (g' l) (hg' l)]
    congr 1
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
    simp [g']
  rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ l), hgl] at h
  have hrest : ∏ i ∈ Finset.univ.erase l, (eLpNorm (g' i) 2 μ).toReal =
      ∏ i ∈ Finset.univ.erase l, (eLpNorm (g i) 2 μ).toReal :=
    Finset.prod_congr rfl fun i hi => by simp [g', (Finset.mem_erase.mp hi).1]
  rw [hrest] at h
  set X := ∫ u, ‖Dm u‖ ^ 2 ∂μ
  set P := ∏ i ∈ Finset.univ.erase l, (eLpNorm (g i) 2 μ).toReal
  have hX0 : 0 ≤ X := integral_nonneg fun _ => by positivity
  have hP0 : 0 ≤ P := Finset.prod_nonneg fun _ _ => ENNReal.toReal_nonneg
  have hs := Real.sq_sqrt hX0
  have hs0 := Real.sqrt_nonneg X
  -- `X ≤ W √X P` gives `√X ≤ W P`
  rcases hs0.eq_or_lt with h0 | hpos
  · exact le_trans (le_of_eq h0.symm) (mul_nonneg hW hP0)
  · have : Real.sqrt X * Real.sqrt X ≤ Real.sqrt X * (W * P) := by nlinarith only [h, hs]
    exact le_of_mul_le_mul_left this hpos

end DualSlice

/-! ### Side windows (blueprint lines 2549-2562, `eq:side-windows`) -/

/-- Points of a `1`-separated family have distinct floors. -/
theorem floor_injOn_of_separated {ι : Type*} (N : Finset ι) (f : ι → ℝ)
    (hsep : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → 1 ≤ |f n - f n'|) :
    Set.InjOn (fun n => ⌊f n⌋) N := by
  intro n hn n' hn' h
  by_contra hne
  have h1 := Int.floor_le (f n)
  have h2 := Int.lt_floor_add_one (f n)
  have h3 := Int.floor_le (f n')
  have h4 := Int.lt_floor_add_one (f n')
  simp only at h
  rw [h] at h1 h2
  have := hsep n hn n' hn' hne
  have hlt : |f n - f n'| < 1 := abs_lt.mpr ⟨by linarith, by linarith⟩
  linarith

/-- A `1`-separated family has at most `2R + 2` members within distance `R` of a point. -/
theorem card_separated_near {ι : Type*} (N : Finset ι) (f : ι → ℝ)
    (hsep : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → 1 ≤ |f n - f n'|) (c : ℝ) {R : ℝ} (hR : 0 ≤ R) :
    ((N.filter fun n => |f n - c| ≤ R).card : ℝ) ≤ 2 * R + 2 := by
  classical
  set S := N.filter fun n => |f n - c| ≤ R
  have hinj : Set.InjOn (fun n => ⌊f n⌋) S := (floor_injOn_of_separated N f hsep).mono
    (fun n hn => (Finset.mem_filter.mp hn).1)
  have hsub : S.image (fun n => ⌊f n⌋) ⊆ Finset.Icc ⌊c - R⌋ ⌊c + R⌋ := by
    intro m hm
    obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hm
    obtain ⟨-, hd⟩ := Finset.mem_filter.mp hn
    rw [abs_le] at hd
    exact Finset.mem_Icc.mpr ⟨Int.floor_le_floor (by linarith), Int.floor_le_floor (by linarith)⟩
  have hcard : S.card ≤ (Finset.Icc ⌊c - R⌋ ⌊c + R⌋).card := by
    rw [← Finset.card_image_of_injOn hinj]; exact Finset.card_le_card hsub
  rw [Int.card_Icc] at hcard
  have h1 := Int.floor_le (c + R)
  have h2 := Int.lt_floor_add_one (c - R)
  have hc : ((⌊c + R⌋ + 1 - ⌊c - R⌋).toNat : ℝ) ≤ 2 * R + 2 := by
    have hnn : (0 : ℤ) ≤ ⌊c + R⌋ + 1 - ⌊c - R⌋ := by
      have := Int.floor_le_floor (show c - R ≤ c + R by linarith); omega
    rw [show ((⌊c + R⌋ + 1 - ⌊c - R⌋).toNat : ℝ) = ((⌊c + R⌋ + 1 - ⌊c - R⌋ : ℤ) : ℝ) by
      exact_mod_cast Int.toNat_of_nonneg hnn]
    push_cast
    linarith
  exact (by exact_mod_cast hcard : (S.card : ℝ) ≤ _).trans hc

open Classical in
/-- One shell of `eq:side-windows` (lines 2553-2556: "in a shell of radius `Λ`, each row and
column has `O(Λ)` entries, since both the integers and the reference frequencies are separated"):
`Σ_{|k + f_n| ≤ R} |a_n| |b_k| ≤ (2R + 2) ‖a‖₂ ‖b‖_{ℓ²(W_R)}`, `W_R` the window of `k` within `R` of
some `-f_n`. -/
theorem shell_pairing_bound {ι : Type*} (N : Finset ι) (f : ι → ℝ)
    (hsep : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → 1 ≤ |f n - f n'|) (Kk : Finset ℤ) (a : ι → ℂ)
    (b : ℤ → ℂ) {R : ℝ} (hR : 0 ≤ R) :
    ∑ n ∈ N, ∑ k ∈ Kk.filter (fun k : ℤ => |(k : ℝ) + f n| ≤ R), ‖a n‖ * ‖b k‖ ≤
      (2 * R + 2) * (Real.sqrt (∑ n ∈ N, ‖a n‖ ^ 2) *
        Real.sqrt (∑ k ∈ Kk.filter (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + f n| ≤ R), ‖b k‖ ^ 2)) := by
  set S := (N ×ˢ Kk).filter fun p => |(p.2 : ℝ) + f p.1| ≤ R
  set W := Kk.filter (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + f n| ≤ R)
  have hsum : ∑ n ∈ N, ∑ k ∈ Kk.filter (fun k : ℤ => |(k : ℝ) + f n| ≤ R), ‖a n‖ * ‖b k‖ =
      ∑ p ∈ S, ‖a p.1‖ * ‖b p.2‖ := by
    rw [Finset.sum_filter, Finset.sum_product]
    refine Finset.sum_congr rfl fun n _ => ?_
    rw [Finset.sum_filter]
  rw [hsum]
  have hCS := sum_mul_le_sqrt_mul_sqrt' S (fun p => ‖a p.1‖) (fun p => ‖b p.2‖)
  -- row counts
  have hrow : ∑ p ∈ S, ‖a p.1‖ ^ 2 ≤ (2 * R + 2) * ∑ n ∈ N, ‖a n‖ ^ 2 := by
    have e : ∑ p ∈ S, ‖a p.1‖ ^ 2 = ∑ n ∈ N, ‖a n‖ ^ 2 *
        ((Kk.filter fun k : ℤ => |(k : ℝ) + f n| ≤ R).card : ℝ) := by
      rw [Finset.sum_filter, Finset.sum_product]
      refine Finset.sum_congr rfl fun n _ => ?_
      rw [← Finset.sum_filter]
      simp only [Finset.sum_const, nsmul_eq_mul]
      ring
    rw [e, Finset.mul_sum]
    refine Finset.sum_le_sum fun n _ => ?_
    have hc := card_separated_near Kk (fun k : ℤ => (k : ℝ)) (fun k _ k' _ hkk => by
      have h1 : (1 : ℤ) ≤ |k - k'| := Int.one_le_abs (sub_ne_zero.mpr hkk)
      have : (1 : ℝ) ≤ |((k - k' : ℤ) : ℝ)| := by rw [← Int.cast_abs]; exact_mod_cast h1
      push_cast at this; exact this) (-f n) hR
    have he : (Kk.filter fun k : ℤ => |(k : ℝ) + f n| ≤ R) =
        Kk.filter fun k : ℤ => |(k : ℝ) - -f n| ≤ R := by
      congr 1; funext k; rw [sub_neg_eq_add]
    rw [he, mul_comm]
    exact mul_le_mul_of_nonneg_right hc (sq_nonneg _)
  -- column counts
  have hcol : ∑ p ∈ S, ‖b p.2‖ ^ 2 ≤ (2 * R + 2) * ∑ k ∈ W, ‖b k‖ ^ 2 := by
    have e : ∑ p ∈ S, ‖b p.2‖ ^ 2 = ∑ k ∈ Kk, ‖b k‖ ^ 2 *
        ((N.filter fun n => |(k : ℝ) + f n| ≤ R).card : ℝ) := by
      rw [Finset.sum_filter, Finset.sum_product_right]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [← Finset.sum_filter]
      simp only [Finset.sum_const, nsmul_eq_mul]
      ring
    have e2 : ∑ k ∈ Kk, ‖b k‖ ^ 2 * ((N.filter fun n => |(k : ℝ) + f n| ≤ R).card : ℝ) =
        ∑ k ∈ W, ‖b k‖ ^ 2 * ((N.filter fun n => |(k : ℝ) + f n| ≤ R).card : ℝ) := by
      refine (Finset.sum_subset (Finset.filter_subset _ _) fun k hk hkW => ?_).symm
      have : (N.filter fun n => |(k : ℝ) + f n| ≤ R) = ∅ := by
        refine Finset.filter_false_of_mem fun n hn h => hkW ?_
        exact Finset.mem_filter.mpr ⟨hk, n, hn, h⟩
      rw [this, Finset.card_empty, Nat.cast_zero, mul_zero]
    rw [e, e2, Finset.mul_sum]
    refine Finset.sum_le_sum fun k _ => ?_
    have hc := card_separated_near N (fun n => -f n) (fun n hn n' hn' hnn => by
      have := hsep n hn n' hn' hnn
      rwa [show -f n - -f n' = -(f n - f n') by ring, abs_neg]) (k : ℝ) hR
    have he : (N.filter fun n => |(k : ℝ) + f n| ≤ R) =
        N.filter fun n => |-f n - (k : ℝ)| ≤ R := by
      congr 1; funext n
      rw [show -f n - (k : ℝ) = -((k : ℝ) + f n) by ring, abs_neg]
    rw [he, mul_comm]
    exact mul_le_mul_of_nonneg_right hc (sq_nonneg _)
  have hR2 : 0 ≤ 2 * R + 2 := by linarith
  calc ∑ p ∈ S, ‖a p.1‖ * ‖b p.2‖
      ≤ Real.sqrt (∑ p ∈ S, ‖a p.1‖ ^ 2) * Real.sqrt (∑ p ∈ S, ‖b p.2‖ ^ 2) := hCS
    _ ≤ Real.sqrt ((2 * R + 2) * ∑ n ∈ N, ‖a n‖ ^ 2) *
          Real.sqrt ((2 * R + 2) * ∑ k ∈ W, ‖b k‖ ^ 2) := by
        gcongr
    _ = (Real.sqrt (2 * R + 2) * Real.sqrt (2 * R + 2)) * (Real.sqrt (∑ n ∈ N, ‖a n‖ ^ 2) *
          Real.sqrt (∑ k ∈ W, ‖b k‖ ^ 2)) := by
        rw [Real.sqrt_mul hR2, Real.sqrt_mul hR2]; ring
    _ = _ := by rw [Real.mul_self_sqrt hR2]

/-- The dyadic majorant of `(1 + x)^{-(A+2)}`:
`(1 + x)^{-(A+2)} ≤ 2^{A+2} Σ_{i ≤ I} 2^{-i(A+2)} 1[x ≤ 2^i] + 2^{-I(A+2)}` for `x ≥ 0`. -/
theorem dyadic_majorant {x : ℝ} (hx : 0 ≤ x) (A I : ℕ) :
    (1 + x)⁻¹ ^ (A + 2) ≤ 2 ^ (A + 2) * ∑ i ∈ Finset.range (I + 1),
      ((2 : ℝ) ^ i)⁻¹ ^ (A + 2) * (if x ≤ 2 ^ i then 1 else 0) + ((2 : ℝ) ^ I)⁻¹ ^ (A + 2) := by
  have hterm : ∀ i ∈ Finset.range (I + 1), 0 ≤ ((2 : ℝ) ^ i)⁻¹ ^ (A + 2) *
      (if x ≤ 2 ^ i then (1 : ℝ) else 0) := fun i _ => by positivity
  have hsum0 : 0 ≤ ∑ i ∈ Finset.range (I + 1),
      ((2 : ℝ) ^ i)⁻¹ ^ (A + 2) * (if x ≤ 2 ^ i then (1 : ℝ) else 0) := Finset.sum_nonneg hterm
  have h1x : 0 < 1 + x := by linarith
  by_cases hI : x ≤ 2 ^ I
  · classical
    have hex : ∃ i, x ≤ 2 ^ i := ⟨I, hI⟩
    set i₀ := Nat.find hex
    have hi₀ : x ≤ 2 ^ i₀ := Nat.find_spec hex
    have hi₀I : i₀ ≤ I := Nat.find_min' hex hI
    have hle : (1 + x)⁻¹ ^ (A + 2) ≤ 2 ^ (A + 2) * (((2 : ℝ) ^ i₀)⁻¹ ^ (A + 2)) := by
      rcases Nat.eq_zero_or_pos i₀ with h0 | hpos
      · rw [h0, pow_zero, inv_one, one_pow, mul_one]
        have : (1 + x)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (by linarith)
        calc (1 + x)⁻¹ ^ (A + 2) ≤ 1 ^ (A + 2) := pow_le_pow_left₀ (by positivity) this _
          _ = 1 := one_pow _
          _ ≤ 2 ^ (A + 2) := one_le_pow₀ (by norm_num)
      · have hlt : ¬ x ≤ 2 ^ (i₀ - 1) := Nat.find_min hex (by omega)
        push Not at hlt
        have hb : ((2 : ℝ) ^ (i₀ - 1)) ≤ 1 + x := by linarith
        have hpow : (2 : ℝ) ^ i₀ = 2 * 2 ^ (i₀ - 1) := by
          rw [← pow_succ']; congr 1; omega
        have h2 : (1 + x)⁻¹ ≤ ((2 : ℝ) ^ (i₀ - 1))⁻¹ := inv_anti₀ (by positivity) hb
        calc (1 + x)⁻¹ ^ (A + 2) ≤ ((2 : ℝ) ^ (i₀ - 1))⁻¹ ^ (A + 2) :=
              pow_le_pow_left₀ (by positivity) h2 _
          _ = 2 ^ (A + 2) * (((2 : ℝ) ^ i₀)⁻¹ ^ (A + 2)) := by
              rw [hpow, mul_inv, mul_pow, ← mul_assoc, ← mul_pow, mul_inv_cancel₀ (by norm_num),
                one_pow, one_mul]
    have hmem : i₀ ∈ Finset.range (I + 1) := Finset.mem_range.mpr (by omega)
    have hsingle : ((2 : ℝ) ^ i₀)⁻¹ ^ (A + 2) ≤ ∑ i ∈ Finset.range (I + 1),
        ((2 : ℝ) ^ i)⁻¹ ^ (A + 2) * (if x ≤ 2 ^ i then 1 else 0) := by
      have := Finset.single_le_sum hterm hmem
      simpa [hi₀] using this
    have h3 : 0 ≤ ((2 : ℝ) ^ I)⁻¹ ^ (A + 2) := by positivity
    calc (1 + x)⁻¹ ^ (A + 2) ≤ 2 ^ (A + 2) * (((2 : ℝ) ^ i₀)⁻¹ ^ (A + 2)) := hle
      _ ≤ 2 ^ (A + 2) * ∑ i ∈ Finset.range (I + 1),
          ((2 : ℝ) ^ i)⁻¹ ^ (A + 2) * (if x ≤ 2 ^ i then 1 else 0) :=
          mul_le_mul_of_nonneg_left hsingle (by positivity)
      _ ≤ _ := le_add_of_nonneg_right h3
  · push Not at hI
    have h2 : (1 + x)⁻¹ ≤ ((2 : ℝ) ^ I)⁻¹ := inv_anti₀ (by positivity) (by linarith)
    have : (1 + x)⁻¹ ^ (A + 2) ≤ ((2 : ℝ) ^ I)⁻¹ ^ (A + 2) :=
      pow_le_pow_left₀ (by positivity) h2 _
    have h4 : 0 ≤ 2 ^ (A + 2) * ∑ i ∈ Finset.range (I + 1),
        ((2 : ℝ) ^ i)⁻¹ ^ (A + 2) * (if x ≤ 2 ^ i then (1 : ℝ) else 0) := by positivity
    linarith

open Classical in
/-- Blueprint `eq:side-windows` (lines 2553-2562): for a pairing matrix with entries
`|M_{n,k}| ≤ C (1 + |k + f_n|)^{-(A+2)}` against `1`-separated reference frequencies `f_n`,
`|Σ_{n,k} a_n b_k M_{n,k}| ≤ C 2^{A+4} Σ_{Λ = 2^i ≤ 2^I} Λ^{-(A+1)} ‖a‖₂ b_Λ
  + C 2^{-I(A+2)} Σ|a_n| Σ|b_k|`, with `b_Λ` the `ℓ²` norm of `b` on the window `W_Λ`. -/
theorem side_windows {ι : Type*} (N : Finset ι) (f : ι → ℝ)
    (hsep : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → 1 ≤ |f n - f n'|) (Kk : Finset ℤ) (a : ι → ℂ)
    (b : ℤ → ℂ) (M : ι → ℤ → ℂ) {C : ℝ} (hC : 0 ≤ C) (A I : ℕ)
    (hM : ∀ n k, ‖M n k‖ ≤ C * (1 + |(k : ℝ) + f n|)⁻¹ ^ (A + 2)) :
    ‖∑ n ∈ N, ∑ k ∈ Kk, a n * b k * M n k‖ ≤
      C * 2 ^ (A + 4) * ∑ i ∈ Finset.range (I + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) *
          (Real.sqrt (∑ n ∈ N, ‖a n‖ ^ 2) * Real.sqrt (∑ k ∈ Kk.filter
            (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + f n| ≤ 2 ^ i), ‖b k‖ ^ 2)) +
        C * ((2 : ℝ) ^ I)⁻¹ ^ (A + 2) * ((∑ n ∈ N, ‖a n‖) * ∑ k ∈ Kk, ‖b k‖) := by
  set An := Real.sqrt (∑ n ∈ N, ‖a n‖ ^ 2)
  set B : ℕ → ℝ := fun i => Real.sqrt (∑ k ∈ Kk.filter
    (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + f n| ≤ 2 ^ i), ‖b k‖ ^ 2)
  -- termwise majorant
  have hpt : ∀ n k, ‖a n * b k * M n k‖ ≤ C * (‖a n‖ * ‖b k‖) *
      (2 ^ (A + 2) * ∑ i ∈ Finset.range (I + 1),
        ((2 : ℝ) ^ i)⁻¹ ^ (A + 2) * (if |(k : ℝ) + f n| ≤ 2 ^ i then 1 else 0) +
        ((2 : ℝ) ^ I)⁻¹ ^ (A + 2)) := by
    intro n k
    rw [norm_mul, norm_mul]
    have h := (hM n k).trans (mul_le_mul_of_nonneg_left
      (dyadic_majorant (abs_nonneg ((k : ℝ) + f n)) A I) hC)
    calc ‖a n‖ * ‖b k‖ * ‖M n k‖ ≤ ‖a n‖ * ‖b k‖ * (C * (2 ^ (A + 2) *
          ∑ i ∈ Finset.range (I + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 2) *
            (if |(k : ℝ) + f n| ≤ 2 ^ i then 1 else 0) + ((2 : ℝ) ^ I)⁻¹ ^ (A + 2))) :=
          mul_le_mul_of_nonneg_left h (by positivity)
      _ = _ := by ring
  -- the shells
  have hshell : ∀ i ∈ Finset.range (I + 1), ∑ n ∈ N, ∑ k ∈ Kk,
      ‖a n‖ * ‖b k‖ * (if |(k : ℝ) + f n| ≤ 2 ^ i then (1 : ℝ) else 0) ≤
      4 * 2 ^ i * (An * B i) := by
    intro i _
    have h := shell_pairing_bound N f hsep Kk a b (R := 2 ^ i) (by positivity)
    have e : ∑ n ∈ N, ∑ k ∈ Kk, ‖a n‖ * ‖b k‖ *
        (if |(k : ℝ) + f n| ≤ 2 ^ i then (1 : ℝ) else 0) =
        ∑ n ∈ N, ∑ k ∈ Kk.filter (fun k : ℤ => |(k : ℝ) + f n| ≤ 2 ^ i), ‖a n‖ * ‖b k‖ := by
      refine Finset.sum_congr rfl fun n _ => ?_
      rw [Finset.sum_filter]
      refine Finset.sum_congr rfl fun k _ => ?_
      split_ifs <;> simp
    rw [e]
    refine h.trans ?_
    have hAB : 0 ≤ An * B i := mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
    have h1 : (2 : ℝ) * 2 ^ i + 2 ≤ 4 * 2 ^ i := by
      have : (1 : ℝ) ≤ 2 ^ i := one_le_pow₀ (by norm_num)
      linarith
    exact mul_le_mul_of_nonneg_right h1 hAB
  -- assemble
  refine (norm_sum_le _ _).trans ?_
  refine (Finset.sum_le_sum fun n _ => norm_sum_le _ _).trans ?_
  refine (Finset.sum_le_sum fun n _ => Finset.sum_le_sum fun k _ => hpt n k).trans ?_
  have e1 : ∀ n k, C * (‖a n‖ * ‖b k‖) * (2 ^ (A + 2) *
      ∑ i ∈ Finset.range (I + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 2) *
        (if |(k : ℝ) + f n| ≤ 2 ^ i then 1 else 0) + ((2 : ℝ) ^ I)⁻¹ ^ (A + 2)) =
      (∑ i ∈ Finset.range (I + 1), C * 2 ^ (A + 2) * (((2 : ℝ) ^ i)⁻¹ ^ (A + 2) *
        (‖a n‖ * ‖b k‖ * (if |(k : ℝ) + f n| ≤ 2 ^ i then 1 else 0)))) +
      C * ((2 : ℝ) ^ I)⁻¹ ^ (A + 2) * (‖a n‖ * ‖b k‖) := by
    intro n k
    rw [mul_add, Finset.mul_sum, Finset.mul_sum]
    congr 1
    · refine Finset.sum_congr rfl fun i _ => by ring
    · ring
  simp_rw [e1]
  rw [Finset.sum_congr rfl fun n _ => Finset.sum_add_distrib, Finset.sum_add_distrib]
  have e2 : ∑ n ∈ N, ∑ k ∈ Kk, C * ((2 : ℝ) ^ I)⁻¹ ^ (A + 2) * (‖a n‖ * ‖b k‖) =
      C * ((2 : ℝ) ^ I)⁻¹ ^ (A + 2) * ((∑ n ∈ N, ‖a n‖) * ∑ k ∈ Kk, ‖b k‖) := by
    rw [Finset.sum_mul_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun n _ => ?_
    rw [Finset.mul_sum]
  have e3 : ∑ n ∈ N, ∑ k ∈ Kk, ∑ i ∈ Finset.range (I + 1), C * 2 ^ (A + 2) *
      (((2 : ℝ) ^ i)⁻¹ ^ (A + 2) * (‖a n‖ * ‖b k‖ *
        (if |(k : ℝ) + f n| ≤ 2 ^ i then 1 else 0))) =
      C * 2 ^ (A + 2) * ∑ i ∈ Finset.range (I + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 2) *
        (∑ n ∈ N, ∑ k ∈ Kk, ‖a n‖ * ‖b k‖ * (if |(k : ℝ) + f n| ≤ 2 ^ i then 1 else 0)) := by
    rw [Finset.mul_sum]
    rw [Finset.sum_congr rfl fun n _ => Finset.sum_comm, Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun n _ => ?_
    rw [Finset.mul_sum, Finset.mul_sum]
  rw [e2, e3]
  have hmain : C * 2 ^ (A + 2) * ∑ i ∈ Finset.range (I + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 2) *
      (∑ n ∈ N, ∑ k ∈ Kk, ‖a n‖ * ‖b k‖ * (if |(k : ℝ) + f n| ≤ 2 ^ i then 1 else 0)) ≤
      C * 2 ^ (A + 4) * ∑ i ∈ Finset.range (I + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) * (An * B i) := by
    have hterm : ∀ i ∈ Finset.range (I + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 2) *
        (∑ n ∈ N, ∑ k ∈ Kk, ‖a n‖ * ‖b k‖ * (if |(k : ℝ) + f n| ≤ 2 ^ i then (1 : ℝ) else 0)) ≤
        4 * (((2 : ℝ) ^ i)⁻¹ ^ (A + 1) * (An * B i)) := by
      intro i hi
      have h2 : (0 : ℝ) ≤ ((2 : ℝ) ^ i)⁻¹ ^ (A + 2) := by positivity
      have hinv : ((2 : ℝ) ^ i)⁻¹ * 2 ^ i = 1 := inv_mul_cancel₀ (by positivity)
      calc ((2 : ℝ) ^ i)⁻¹ ^ (A + 2) * (∑ n ∈ N, ∑ k ∈ Kk, ‖a n‖ * ‖b k‖ *
            (if |(k : ℝ) + f n| ≤ 2 ^ i then (1 : ℝ) else 0))
          ≤ ((2 : ℝ) ^ i)⁻¹ ^ (A + 2) * (4 * 2 ^ i * (An * B i)) :=
            mul_le_mul_of_nonneg_left (hshell i hi) h2
        _ = 4 * (((2 : ℝ) ^ i)⁻¹ ^ (A + 1) * (((2 : ℝ) ^ i)⁻¹ * 2 ^ i) * (An * B i)) := by
            rw [pow_succ]; ring
        _ = _ := by rw [hinv, mul_one]
    have hC2 : 0 ≤ C * (2 : ℝ) ^ (A + 2) := mul_nonneg hC (by positivity)
    calc C * 2 ^ (A + 2) * ∑ i ∈ Finset.range (I + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 2) *
          (∑ n ∈ N, ∑ k ∈ Kk, ‖a n‖ * ‖b k‖ * (if |(k : ℝ) + f n| ≤ 2 ^ i then 1 else 0))
        ≤ C * 2 ^ (A + 2) * ∑ i ∈ Finset.range (I + 1),
            4 * (((2 : ℝ) ^ i)⁻¹ ^ (A + 1) * (An * B i)) :=
          mul_le_mul_of_nonneg_left (Finset.sum_le_sum hterm) hC2
      _ = _ := by rw [← Finset.mul_sum]; ring
  linarith


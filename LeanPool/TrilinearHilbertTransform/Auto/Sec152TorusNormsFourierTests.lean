namespace TrilinearHT.Auto
open MeasureTheory Metric
open scoped FourierTransform ComplexConjugate ENNReal

theorem baseLength_inv_zpow (G : RealDyadicGrid) (s : ℤ) :
    G.baseLength⁻¹ * 2 ^ s = (dyadicGridLength G s)⁻¹ := by
  unfold dyadicGridLength
  rw [mul_inv, zpow_neg, inv_inv]

/-- A fixed choice of an element of a finite set (the default if empty). -/
noncomputable def finPick {X : Type*} [Inhabited X] (S : Finset X) : X :=
  if h : S.Nonempty then h.choose else default

theorem finPick_mem {X : Type*} [Inhabited X] {S : Finset X} (h : S.Nonempty) : finPick S ∈ S := by
  simp only [finPick, h, ↓reduceDIte]
  exact h.choose_spec

open Classical in
/-- The reference of the coset of `v` modulo `K` among the frequencies `P`: a fixed member of `P`
in the same coset (blueprint line 2547, "choose one reference `n` from the box per coset"). -/
noncomputable def cosetRep {d : ℕ} (K : Submodule ℤ (Fin d → ℤ)) (P : Finset (Fin d → ℤ))
    (v : Fin d → ℤ) : Fin d → ℤ :=
  finPick (P.filter fun u => v - u ∈ K)

theorem cosetRep_spec {d : ℕ} (K : Submodule ℤ (Fin d → ℤ)) (P : Finset (Fin d → ℤ))
    {v : Fin d → ℤ} (hv : v ∈ P) : cosetRep K P v ∈ P ∧ v - cosetRep K P v ∈ K := by
  classical
  have hne : (P.filter fun u => v - u ∈ K).Nonempty := ⟨v, Finset.mem_filter.mpr ⟨hv, by simp⟩⟩
  exact Finset.mem_filter.mp (finPick_mem hne)

theorem cosetRep_eq {d : ℕ} (K : Submodule ℤ (Fin d → ℤ)) (P : Finset (Fin d → ℤ))
    {v v' : Fin d → ℤ} (h : v - v' ∈ K) : cosetRep K P v = cosetRep K P v' := by
  classical
  unfold cosetRep
  congr 1
  ext u
  simp only [Finset.mem_filter]
  refine and_congr_right fun _ => ⟨fun hu => ?_, fun hu => ?_⟩
  · have : v' - u = (v - u) - (v - v') := by abel
    rw [this]; exact K.sub_mem hu h
  · have : v - u = (v' - u) + (v - v') := by abel
    rw [this]; exact K.add_mem hu h

theorem cosetRep_sub_not_mem {d : ℕ} (K : Submodule ℤ (Fin d → ℤ)) (P : Finset (Fin d → ℤ))
    {v v' : Fin d → ℤ} (hv : v ∈ P) (hv' : v' ∈ P) (hne : cosetRep K P v ≠ cosetRep K P v') :
    cosetRep K P v - cosetRep K P v' ∉ K := by
  intro hmem
  apply hne
  refine cosetRep_eq K P ?_
  have h1 := (cosetRep_spec K P hv).2
  have h2 := (cosetRep_spec K P hv').2
  have : v - v' = (v - cosetRep K P v) + (cosetRep K P v - cosetRep K P v') -
      (v' - cosetRep K P v') := by abel
  rw [this]
  exact K.sub_mem (K.add_mem h1 hmem) h2

section PatternLeaf
variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℂ V]

open Classical in
/-- The value of one slot of a pattern at one index: the component subtotal in a core slot, the
pattern piece otherwise (`compSlot` at a single slot). -/
noncomputable def slotVal (σ : Fin 4 → Fin 3) {κ : Fin 4 → Type*} (sub : ∀ l, κ l → V)
    (s e : Fin 4 → V) (l : Fin 4) (o : Option (κ l)) : V :=
  if σ l = 0 then (match o with | some K => sub l K | none => 0) else ![0, s l, e l] (σ l)

omit [NormedSpace ℂ V] in
theorem compSlot_eq_slotVal (σ : Fin 4 → Fin 3) {κ : Fin 4 → Type*} (sub : ∀ l, κ l → V)
    (s e : Fin 4 → V) (r : ∀ l, Option (κ l)) :
    compSlot σ sub s e r = fun l => slotVal σ sub s e l (r l) := rfl

open Classical in
/-- Blueprint lines 2463-2582 for one pattern on a leaf cell and group (core slots expanded into
their components, sides and errors fixed): the pattern form is at most
`C Z / (1 - 4 ρ^{1/4}) + Σ_r e_r` if for every failure history `(n, a, w, h)` the forms of the
masked slot sums grouped by the final-height classes `cls h` are at most principal quantities
`Ψ_p` plus the errors of their member tuples, and the history averages of `Σ_p Ψ_p` obey the
moment bound (`first_success_bound`, `multilinear_regroup`). -/
theorem pattern_leaf_bound (Λ : MultilinearMap ℂ (fun _ : Fin 4 => V) ℂ) (σ : Fin 4 → Fin 3)
    {κ : Fin 4 → Type*} (Ks : ∀ l, Finset (κ l)) (sub : ∀ l, κ l → V) (s e : Fin 4 → V)
    (H : Finset ℕ) (good : ∀ l, ℕ → Option (κ l) → Prop)
    (hp : ∀ r ∈ Fintype.piFinset (compIdx σ Ks),
      (H.filter fun h => ∀ l, good l h (r l)).Nonempty)
    {ι : Fin 4 → Type*} [∀ l, DecidableEq (ι l)] (cls : ℕ → ∀ l, Option (κ l) → ι l)
    (Ψ : (n : ℕ) → (Fin n → Fin 4) → (Fin n → ℕ) → ℕ → (∀ l, ι l) → ℝ)
    (err : (∀ l, Option (κ l)) → ℝ)
    (hgrp : ∀ n (a : Fin n → Fin 4), ∀ w ∈ Fintype.piFinset (fun _ : Fin n => H), ∀ h ∈ H,
      ∀ p ∈ Fintype.piFinset
        (fun l => ((compIdx σ Ks l).filter (roleMask (good l) l a w h)).image (cls h l)),
      ‖Λ (fun l => ∑ o ∈ ((compIdx σ Ks l).filter (roleMask (good l) l a w h)).filter
          (fun o => cls h l o = p l), slotVal σ sub s e l o)‖ ≤
        Ψ n a w h p + ∑ r ∈ (Fintype.piFinset fun l =>
          (compIdx σ Ks l).filter (roleMask (good l) l a w h)).filter
          (fun r => ∀ l, cls h l (r l) = p l), err r)
    {C Z ρ : ℝ} (hρ : 0 ≤ ρ) (hq : (4 : ℝ) * ρ ^ (1 / (4 : ℝ)) < 1)
    (hmom : ∀ n (a : Fin n → Fin 4), ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ∑ h ∈ H,
      ((H.card : ℝ) ^ (n + 1))⁻¹ * ∑ p ∈ Fintype.piFinset
        (fun l => ((compIdx σ Ks l).filter (roleMask (good l) l a w h)).image (cls h l)),
        Ψ n a w h p ≤ C * (ρ ^ n) ^ (1 / (4 : ℝ)) * Z) :
    ‖∑ r ∈ Fintype.piFinset (compIdx σ Ks), Λ (compSlot σ sub s e r)‖ ≤
      C * Z / (1 - (4 : ℝ) * ρ ^ (1 / (4 : ℝ))) +
        ∑ r ∈ Fintype.piFinset (compIdx σ Ks), err r := by
  have h4 : ((4 : ℕ) : ℝ) = 4 := by norm_num
  have hq' : ((4 : ℕ) : ℝ) * ρ ^ (1 / ((4 : ℕ) : ℝ)) < 1 := by rw [h4]; exact hq
  have hb := first_success_bound (m₀ := 4) (compIdx σ Ks) H good
    (fun r => Λ (compSlot σ sub s e r)) err hp
    (fun n a w h => ∑ p ∈ Fintype.piFinset
      (fun l => ((compIdx σ Ks l).filter (roleMask (good l) l a w h)).image (cls h l)),
        Ψ n a w h p)
    (fun n a w hw h hh => ?_) hρ hq' (fun n a => by rw [h4]; exact hmom n a)
  · rw [h4] at hb; exact hb
  have hpf : (Fintype.piFinset (compIdx σ Ks)).filter
      (fun r => ∀ j, roleMask (good j) j a w h (r j)) =
      Fintype.piFinset (fun l => (compIdx σ Ks l).filter (roleMask (good l) l a w h)) := by
    ext r
    simp only [Finset.mem_filter, Fintype.mem_piFinset]
    constructor
    · rintro ⟨h1, h2⟩ l; exact ⟨h1 l, h2 l⟩
    · intro h; exact ⟨fun l => (h l).1, fun l => (h l).2⟩
  rw [hpf]
  simp_rw [compSlot_eq_slotVal]
  rw [multilinear_regroup Λ (fun l => (compIdx σ Ks l).filter (roleMask (good l) l a w h))
    (cls h) (fun l o => slotVal σ sub s e l o)]
  refine (norm_sum_le _ _).trans ?_
  refine (Finset.sum_le_sum fun p hp' => hgrp n a w hw h hh p hp').trans (le_of_eq ?_)
  rw [Finset.sum_add_distrib]
  congr 1
  convert sum_fiber_pi (fun l => (compIdx σ Ks l).filter (roleMask (good l) l a w h)) (cls h) err
    using 3
  all_goals first
    | (ext r; simp only [Finset.mem_filter])
    | (funext l; congr; exact Subsingleton.elim _ _)

end PatternLeaf

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0) (SP : SideParams)

open Classical in
/-- Distinct minimal components of a block on a pre-cell are disjoint. -/
theorem allComps_pairwiseDisjoint (b : ℤ) (J : ℤ × ℤ) :
    Set.PairwiseDisjoint (Ms.allComps S hA b J : Set (Finset Ms.Md)) id := by
  intro K hK K' hK' hne
  obtain ⟨x, -, rfl⟩ := Finset.mem_image.mp hK
  obtain ⟨x', -, rfl⟩ := Finset.mem_image.mp hK'
  change Disjoint (((Ms.blockComps S hA b J).E 0 x).map ⟨Subtype.val, Subtype.val_injective⟩)
    (((Ms.blockComps S hA b J).E 0 x').map ⟨Subtype.val, Subtype.val_injective⟩)
  rw [Finset.disjoint_left]
  intro m hm hm'
  obtain ⟨z, hz, rfl⟩ := Finset.mem_map.mp hm
  obtain ⟨z', hz', hzz⟩ := Finset.mem_map.mp hm'
  have hzz' : z' = z := Subtype.val_injective hzz
  have hz'E : z ∈ (Ms.blockComps S hA b J).E 0 x' := hzz' ▸ hz'
  apply hne
  rw [← (Ms.blockComps S hA b J).E_comp 0 x z hz, ← (Ms.blockComps S hA b J).E_comp 0 x' z hz'E]

theorem coreComps_pairwiseDisjoint (b : ℤ) (J : ℤ × ℤ) :
    Set.PairwiseDisjoint (Ms.coreComps S hA SP b J : Set (Finset Ms.Md)) id :=
  (Ms.allComps_pairwiseDisjoint S hA b J).subset
    (Finset.coe_subset.mpr Finset.sdiff_subset)

end ModeSystem


/-- The square of a finite sum of complex numbers is the double sum of the products with the
conjugates. -/
theorem normSq_sum_conj {ι : Type*} (F : Finset ι) (z : ι → ℂ) :
    ((‖∑ k ∈ F, z k‖ ^ 2 : ℝ) : ℂ) = ∑ k ∈ F, ∑ k' ∈ F, z k * starRingEnd ℂ (z k') := by
  rw [Complex.ofReal_pow, ← Complex.mul_conj', map_sum, Finset.sum_mul_sum]

theorem exp_mul_conj_exp (a b t : ℝ) :
    Complex.exp (Complex.I * (a * t : ℝ)) * starRingEnd ℂ (Complex.exp (Complex.I * (b * t : ℝ))) =
      Complex.exp (Complex.I * ((a - b) * t : ℝ)) := by
  rw [← Complex.exp_conj, map_mul, Complex.conj_I, Complex.conj_ofReal, ← Complex.exp_add]
  congr 1; push_cast; ring

section TorusBessel
variable {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))

/-- Continuous functions on the annihilator torus are integrable. -/
theorem integrable_of_continuous_annihilator
    {f : torusAnnihilator (rationalIntegerIntersection V) → ℂ} (hf : Continuous f) :
    Integrable f (torusAnnihilatorHaar (rationalIntegerIntersection V)) :=
  hf.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace f)

open Classical in
/-- Blueprint lines 2547-2549 ("collect horizontal Fourier coefficients by cosets and choose one
reference `n` per coset; Parseval bounds their `ℓ²` norm"): for references `n` in distinct cosets
of `K_B ∩ ℤ^d`, the Haar coefficients `⟨f, χ_n⟩` of a continuous function on the annihilator torus
satisfy Bessel's inequality `Σ_n |⟨f, χ_n⟩|² ≤ ‖f‖²_{L²(𝓗)}`. -/
theorem torus_bessel (f : torusAnnihilator (rationalIntegerIntersection V) → ℂ)
    (hf : Continuous f) (N : Finset (Fin d → ℤ))
    (hN : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → n - n' ∉ rationalIntegerIntersection V) :
    ∑ n ∈ N, ‖∫ u, f u * starRingEnd ℂ (torusCharacter n u)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)‖ ^ 2 ≤
      ∫ u, ‖f u‖ ^ 2 ∂torusAnnihilatorHaar (rationalIntegerIntersection V) := by
  set μ := torusAnnihilatorHaar (rationalIntegerIntersection V)
  set e : (Fin d → ℤ) → torusAnnihilator (rationalIntegerIntersection V) → ℂ :=
    fun n u => torusCharacter n u
  have he : ∀ n, Continuous (e n) := fun n =>
    (continuous_torusCharacter n).comp continuous_subtype_val
  have hI : ∀ {g : torusAnnihilator (rationalIntegerIntersection V) → ℂ}, Continuous g →
      Integrable g μ := fun hg => integrable_of_continuous_annihilator V hg
  set! a : (Fin d → ℤ) → ℂ := fun n => ∫ u, f u * starRingEnd ℂ (e n u) ∂μ
  have horth : ∀ n ∈ N, ∀ n' ∈ N, ∫ u, e n u * starRingEnd ℂ (e n' u) ∂μ =
      if n = n' then 1 else 0 := by
    intro n hn n' hn'
    simp only [e]
    simp_rw [← torusCharacter_sub]
    rw [rationalAnnihilator_character_integral V (n - n')]
    by_cases h : n = n'
    · rw [h, sub_self]; simp
    · rw [ite_eq_right_of_eq_false _ _ (eq_false (hN n hn n' hn' h)),
        ite_eq_right_of_eq_false _ _ (eq_false h)]
  have hconj : ∀ n, ∫ u, e n u * starRingEnd ℂ (f u) ∂μ = starRingEnd ℂ (a n) := by
    intro n
    simp only [a]
    rw [← integral_conj]
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
    simp only [map_mul, Complex.conj_conj]; ring
  set! h : torusAnnihilator (rationalIntegerIntersection V) → ℂ :=
    fun u => f u - ∑ n ∈ N, a n * e n u
  have hpt : ∀ u, ((‖h u‖ ^ 2 : ℝ) : ℂ) = f u * starRingEnd ℂ (f u) -
      ∑ n ∈ N, starRingEnd ℂ (a n) * (f u * starRingEnd ℂ (e n u)) -
      ∑ n ∈ N, a n * (e n u * starRingEnd ℂ (f u)) +
      ∑ n ∈ N, ∑ n' ∈ N, a n * starRingEnd ℂ (a n') * (e n u * starRingEnd ℂ (e n' u)) := by
    intro u
    rw [Complex.ofReal_pow, ← Complex.mul_conj']
    simp only [h, map_sub, map_sum, map_mul]
    rw [sub_mul, mul_sub, mul_sub, Finset.sum_mul, Finset.mul_sum, Finset.sum_mul_sum]
    have e1 : ∀ n, f u * (starRingEnd ℂ (a n) * starRingEnd ℂ (e n u)) =
        starRingEnd ℂ (a n) * (f u * starRingEnd ℂ (e n u)) := fun n => by ring
    have e2 : ∀ n, a n * e n u * starRingEnd ℂ (f u) = a n * (e n u * starRingEnd ℂ (f u)) :=
      fun n => by ring
    have e3 : ∀ n n', a n * e n u * (starRingEnd ℂ (a n') * starRingEnd ℂ (e n' u)) =
        a n * starRingEnd ℂ (a n') * (e n u * starRingEnd ℂ (e n' u)) := fun n n' => by ring
    simp only [e1, e2, e3]
    ring
  have hfc : Continuous fun u => starRingEnd ℂ (f u) := Complex.continuous_conj.comp hf
  have hec : ∀ n, Continuous fun u => starRingEnd ℂ (e n u) := fun n =>
    Complex.continuous_conj.comp (he n)
  have i1 : ∀ n, Integrable (fun u => starRingEnd ℂ (a n) * (f u * starRingEnd ℂ (e n u))) μ :=
    fun n => (hI (hf.mul (hec n))).const_mul _
  have i2 : ∀ n, Integrable (fun u => a n * (e n u * starRingEnd ℂ (f u))) μ :=
    fun n => (hI ((he n).mul hfc)).const_mul _
  have i3 : ∀ n n', Integrable (fun u => a n * starRingEnd ℂ (a n') *
      (e n u * starRingEnd ℂ (e n' u))) μ := fun n n' => (hI ((he n).mul (hec n'))).const_mul _
  have i0 : Integrable (fun u => f u * starRingEnd ℂ (f u)) μ := hI (hf.mul hfc)
  have hint : ((∫ u, ‖h u‖ ^ 2 ∂μ : ℝ) : ℂ) =
      ((∫ u, ‖f u‖ ^ 2 ∂μ : ℝ) : ℂ) - ∑ n ∈ N, starRingEnd ℂ (a n) * a n := by
    rw [← integral_complex_ofReal]
    simp_rw [hpt]
    rw [integral_add, integral_sub, integral_sub]
    · rw [integral_finsetSum _ fun n _ => i1 n, integral_finsetSum _ fun n _ => i2 n,
        integral_finsetSum _ fun n _ => integrable_finsetSum _ fun n' _ => i3 n n']
      have h4 : ∑ n ∈ N, ∫ u, ∑ n' ∈ N, a n * starRingEnd ℂ (a n') *
          (e n u * starRingEnd ℂ (e n' u)) ∂μ = ∑ n ∈ N, a n * starRingEnd ℂ (a n) := by
        refine Finset.sum_congr rfl fun n hn => ?_
        rw [integral_finsetSum _ fun n' _ => i3 n n']
        simp_rw [integral_const_mul]
        rw [Finset.sum_eq_single n]
        · rw [horth n hn n hn, ite_eq_left_of_eq_true _ _ (eq_true rfl), mul_one]
        · intro n' hn' hne
          rw [horth n hn n' hn', ite_eq_right_of_eq_false _ _ (eq_false (Ne.symm hne)), mul_zero]
        · intro h; exact absurd hn h
      rw [h4]
      simp_rw [integral_const_mul, hconj]
      have h1 : (∫ u, f u * starRingEnd ℂ (f u) ∂μ) = ((∫ u, ‖f u‖ ^ 2 ∂μ : ℝ) : ℂ) := by
        rw [← integral_complex_ofReal]
        refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
        simp only
        rw [Complex.ofReal_pow, Complex.mul_conj']
      rw [h1]
      simp only [a]
      have h2 : ∀ n, a n * starRingEnd ℂ (a n) = starRingEnd ℂ (a n) * a n := fun n => by ring
      simp only [a] at h2
      rw [Finset.sum_congr rfl fun n _ => h2 n]
      ring
    · exact i0
    · exact integrable_finsetSum _ fun n _ => i1 n
    · exact i0.sub (integrable_finsetSum _ fun n _ => i1 n)
    · exact integrable_finsetSum _ fun n _ => i2 n
    · exact (i0.sub (integrable_finsetSum _ fun n _ => i1 n)).sub
        (integrable_finsetSum _ fun n _ => i2 n)
    · exact integrable_finsetSum _ fun n _ => integrable_finsetSum _ fun n' _ => i3 n n'
  have hsq : ∑ n ∈ N, starRingEnd ℂ (a n) * a n = ((∑ n ∈ N, ‖a n‖ ^ 2 : ℝ) : ℂ) := by
    push_cast
    refine Finset.sum_congr rfl fun n _ => ?_
    rw [mul_comm, Complex.mul_conj']
  rw [hsq, ← Complex.ofReal_sub, Complex.ofReal_inj] at hint
  have h0 : 0 ≤ ∫ u, ‖h u‖ ^ 2 ∂μ := integral_nonneg fun _ => by positivity
  simp only [a, e] at hint
  linarith

end TorusBessel

section ThreeCore
variable {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))

/-- The dual slice `D_m(u) = ∫ D(u, v) e(-m·v) dv` of
`D(u, v) = R(u, v) Π_{j ≠ l} g_j(u + (j - l) v)` (blueprint lines 2543-2546). -/
noncomputable def dualSlice
    (Rm : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ) (l : Fin 4)
    (g : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℂ) (m : Fin d → ℤ)
    (u : torusAnnihilator (rationalIntegerIntersection V)) : ℂ :=
  ∫ v, Rm (u, v) * (∏ i ∈ Finset.univ.erase l, g i (u + ((i : ℤ) - (l : ℤ)) • v)) *
    starRingEnd ℂ (torusCharacter m v) ∂torusAnnihilatorHaar (rationalIntegerIntersection V)

theorem continuous_dualSlice
    (Rm : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ) (hRm : Continuous Rm) (l : Fin 4)
    (g : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℂ)
    (hg : ∀ i, Continuous (g i)) (m : Fin d → ℤ) :
    Continuous (dualSlice V Rm l g m) := by
  have hχ : Continuous fun v : torusAnnihilator (rationalIntegerIntersection V) =>
      starRingEnd ℂ (torusCharacter m v) :=
    (continuous_star.comp ((continuous_torusCharacter m).comp continuous_subtype_val))
  have hint : Continuous fun p : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) =>
      Rm (p.1, p.2) * (∏ i ∈ Finset.univ.erase l, g i (p.1 + ((i : ℤ) - (l : ℤ)) • p.2)) *
        starRingEnd ℂ (torusCharacter m p.2) := by
    refine (hRm.mul (continuous_finsetProd _ fun i _ => (hg i).comp ?_)).mul
      (hχ.comp continuous_snd)
    exact continuous_fst.add ((continuous_zsmul _).comp continuous_snd)
  have h := continuous_parametric_integral_of_continuous
    (μ := torusAnnihilatorHaar (rationalIntegerIntersection V))
    (f := fun u v => Rm (u, v) * (∏ i ∈ Finset.univ.erase l,
      g i (u + ((i : ℤ) - (l : ℤ)) • v)) * starRingEnd ℂ (torusCharacter m v))
    hint isCompact_univ
  unfold dualSlice
  simpa only [Measure.restrict_univ] using h

open Classical in
/-- Blueprint `eq:side-windows` (lines 2543-2562) for a three-core test with anchor `l` and
reference `m`: the horizontal coset coefficients `a_n = ⟨D_m, χ_n⟩` at references `n` in distinct
cosets have `ℓ²` norm at most `W Π_{j ≠ l} a'_j` (`torus_bessel`, `dual_slice_bound`); against a
pairing matrix with entries `|M_{n,k}| ≤ C (1 + |k + f_n|)^{-(A+2)}` and `1`-separated reference
frequencies `f_n`, the pairing is at most
`C 2^{A+4} Σ_{Λ = 2^i ≤ 2^I} Λ^{-(A+1)} (W Π_{j ≠ l} a'_j) b_Λ + C 2^{-I(A+2)} Σ|a_n| Σ|b_k|`. -/
theorem three_core_windows
    (Rm : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ) (hRm : Continuous Rm) {W : ℝ}
    (hW : 0 ≤ W) (hRb : ∀ z, ‖Rm z‖ ≤ W) (l : Fin 4)
    (g : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℂ)
    (hg : ∀ i, Continuous (g i)) (m : Fin d → ℤ) (N : Finset (Fin d → ℤ))
    (hN : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → n - n' ∉ rationalIntegerIntersection V)
    (fr : (Fin d → ℤ) → ℝ) (hsep : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → 1 ≤ |fr n - fr n'|)
    (Kk : Finset ℤ) (b : ℤ → ℂ) (M : (Fin d → ℤ) → ℤ → ℂ) {C : ℝ} (hC : 0 ≤ C) (A I : ℕ)
    (hM : ∀ n k, ‖M n k‖ ≤ C * (1 + |(k : ℝ) + fr n|)⁻¹ ^ (A + 2)) :
    ‖∑ n ∈ N, ∑ k ∈ Kk, (∫ u, dualSlice V Rm l g m u * starRingEnd ℂ (torusCharacter n u)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) * b k * M n k‖ ≤
      C * 2 ^ (A + 4) * ∑ i ∈ Finset.range (I + 1), ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) *
          ((W * ∏ i ∈ Finset.univ.erase l, (eLpNorm (g i) 2
            (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal) *
            Real.sqrt (∑ k ∈ Kk.filter
              (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + fr n| ≤ 2 ^ i), ‖b k‖ ^ 2)) +
        C * ((2 : ℝ) ^ I)⁻¹ ^ (A + 2) *
          ((∑ n ∈ N, ‖∫ u, dualSlice V Rm l g m u * starRingEnd ℂ (torusCharacter n u)
            ∂torusAnnihilatorHaar (rationalIntegerIntersection V)‖) * ∑ k ∈ Kk, ‖b k‖) := by
  set! a : (Fin d → ℤ) → ℂ := fun n => ∫ u, dualSlice V Rm l g m u *
    starRingEnd ℂ (torusCharacter n u) ∂torusAnnihilatorHaar (rationalIntegerIntersection V)
  have hsw := side_windows N fr hsep Kk a b M hC A I hM
  refine hsw.trans (add_le_add_left ?_ _)
  have hl2 : Real.sqrt (∑ n ∈ N, ‖a n‖ ^ 2) ≤ W * ∏ i ∈ Finset.univ.erase l,
      (eLpNorm (g i) 2 (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal :=
    (Real.sqrt_le_sqrt (torus_bessel V _ (continuous_dualSlice V Rm hRm l g hg m) N hN)).trans
      (dual_slice_bound V Rm hRm hW hRb l g hg m)
  gcongr with i

end ThreeCore

section CoreMoments

open Classical in
/-- Blueprint lines 2568-2572 ("apply the probability bound separately to each minimal-component
summand ... dropping extra success requirements only enlarges its probability"): over the words
`w ∈ H^n` of failed heights, the components `K` of role `j` failing at every height assigned to
`j` carry total weight at most `ρ^{n_j} |H|^n Σ_K σ_K` when each component is bad at a proportion
at most `ρ` of `H`. -/
theorem mask_second_moment {κ : Type*} {m₀ : ℕ} (H : Finset ℕ) (good : ℕ → κ → Prop)
    (T : Finset κ) (σ : κ → ℝ) (hσ : ∀ K ∈ T, 0 ≤ σ K) {ρ : ℝ}
    (hbad : ∀ K ∈ T, ((H.filter fun h => ¬ good h K).card : ℝ) ≤ ρ * H.card) {n : ℕ}
    (a : Fin n → Fin m₀) (j : Fin m₀) :
    ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H),
        ∑ K ∈ T.filter (fun K => ∀ i, a i = j → ¬ good (w i) K), σ K ≤
      ρ ^ (Finset.univ.filter fun i => a i = j).card * (H.card : ℝ) ^ n * ∑ K ∈ T, σ K := by
  rw [Finset.mul_sum]
  have hswap : ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H),
      ∑ K ∈ T.filter (fun K => ∀ i, a i = j → ¬ good (w i) K), σ K =
      ∑ K ∈ T, σ K * ((Fintype.piFinset (fun _ : Fin n => H)).filter
        (fun w => ∀ i, a i = j → ¬ good (w i) K)).card := by
    simp_rw [Finset.sum_filter]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun K _ => ?_
    rw [Finset.card_filter, Nat.cast_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun w _ => ?_
    split_ifs <;> simp
  rw [hswap]
  refine Finset.sum_le_sum fun K hK => ?_
  rw [mul_comm (ρ ^ _ * _) (σ K)]
  refine mul_le_mul_of_nonneg_left ?_ (hσ K hK)
  set B := H.filter fun h => ¬ good h K
  have hset : (Fintype.piFinset (fun _ : Fin n => H)).filter
      (fun w => ∀ i, a i = j → ¬ good (w i) K) =
      Fintype.piFinset (fun i : Fin n => if a i = j then B else H) := by
    ext w
    simp only [Finset.mem_filter, Fintype.mem_piFinset, B]
    constructor
    · rintro ⟨hw, hb⟩ i
      split_ifs with hi
      · exact Finset.mem_filter.mpr ⟨hw i, hb i hi⟩
      · exact hw i
    · intro hw
      refine ⟨fun i => ?_, fun i hi => ?_⟩
      · have := hw i
        split_ifs at this with hi
        · exact (Finset.mem_filter.mp this).1
        · exact this
      · have := hw i
        rw [ite_eq_left_of_eq_true _ _ (eq_true hi)] at this
        exact (Finset.mem_filter.mp this).2
  rw [hset, Fintype.card_piFinset, Nat.cast_prod]
  calc ∏ i, ((if a i = j then B else H).card : ℝ) ≤
      ∏ i : Fin n, (if a i = j then ρ else 1) * (H.card : ℝ) := by
        refine Finset.prod_le_prod₀ (fun i _ => Nat.cast_nonneg _) fun i _ => ?_
        split_ifs with hi
        · exact hbad K hK
        · rw [one_mul]
    _ = _ := by
        rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
          Finset.prod_ite, Finset.prod_const, Finset.prod_const_one, mul_one]

/-- The uniform average over the words `w ∈ H^n` as a measure on `Fin n → ℕ`. -/
noncomputable def wordAvg (H : Finset ℕ) (n : ℕ) : Measure (Fin n → ℕ) :=
  ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ((H.card : ℝ≥0∞) ^ n)⁻¹ • Measure.dirac w

theorem lintegral_wordAvg (H : Finset ℕ) (n : ℕ) (f : (Fin n → ℕ) → ℝ≥0∞) :
    ∫⁻ w, f w ∂wordAvg H n =
      ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ((H.card : ℝ≥0∞) ^ n)⁻¹ * f w := by
  unfold wordAvg
  rw [lintegral_finsetSum_measure]
  refine Finset.sum_congr rfl fun w _ => ?_
  rw [lintegral_smul_measure, lintegral_dirac, smul_eq_mul]

/-- Blueprint lines 2568-2572 averaged over the words of failed heights: if the role sizes
`a'_j(w)` satisfy `a'_j ≤ C σ_j` on the words and their averaged squares are at most
`C ρ^{n_j} σ_j²`, then the averaged product is at most `C^{m₀} (ρ^{Σ n_j})^{1/m₀} Π_j σ_j`
(Hölder with `m₀` factors, `core_moment_bound`). -/
theorem word_moment_bound (H : Finset ℕ) (n : ℕ) {m₀ : ℕ} (hm : 2 ≤ m₀)
    (A : Fin m₀ → (Fin n → ℕ) → ℝ≥0∞) {C ρ : ℝ≥0∞} (hC : 1 ≤ C) (σ : Fin m₀ → ℝ≥0∞)
    (nj : Fin m₀ → ℕ)
    (hdet : ∀ j, ∀ w ∈ Fintype.piFinset (fun _ : Fin n => H), A j w ≤ C * σ j)
    (hsq : ∀ j, ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H),
      ((H.card : ℝ≥0∞) ^ n)⁻¹ * A j w ^ 2 ≤ C * ρ ^ nj j * σ j ^ 2) :
    ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ((H.card : ℝ≥0∞) ^ n)⁻¹ * ∏ j, A j w ≤
      C ^ m₀ * (ρ ^ (∑ j, nj j)) ^ (1 / (m₀ : ℝ)) * ∏ j, σ j := by
  classical
  set W := Fintype.piFinset (fun _ : Fin n => H)
  set A' : Fin m₀ → (Fin n → ℕ) → ℝ≥0∞ := fun j w => if w ∈ W then A j w else 0
  have hA' : ∀ j, Measurable (A' j) := fun j => measurable_of_countable _
  have hdet' : ∀ j w, A' j w ≤ C * σ j := by
    intro j w
    simp only [A']
    split_ifs with hw
    · exact hdet j w hw
    · exact zero_le
  have hsq' : ∀ j, ∫⁻ w, A' j w ^ 2 ∂wordAvg H n ≤ C * ρ ^ nj j * σ j ^ 2 := by
    intro j
    rw [lintegral_wordAvg]
    refine le_trans (le_of_eq (Finset.sum_congr rfl fun w hw => ?_)) (hsq j)
    simp only [A', W] at hw ⊢
    rw [ite_eq_left_of_eq_true _ _ (eq_true hw)]
  have h := core_moment_bound (wordAvg H n) hm A' hA' hC σ nj hdet' hsq'
  rw [lintegral_wordAvg] at h
  refine le_trans (le_of_eq (Finset.sum_congr rfl fun w hw => ?_)) h
  congr 1
  refine Finset.prod_congr rfl fun j _ => ?_
  simp only [A', W] at hw ⊢
  rw [ite_eq_left_of_eq_true _ _ (eq_true hw)]

end CoreMoments

/-- An admissible local kernel is integrable (it is continuous with compact support). -/
theorem admissible_integrable {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) : Integrable w := by
  have hm := mul_nonneg κ.margin_pos.le hr.le
  have hcs : HasCompactSupport w := by
    refine HasCompactSupport.intro (isCompact_Icc (a := ((a₀, -r) : ℝ × ℝ)) (b := (a₀ + r, r)))
      fun z hz => ?_
    by_contra hne
    have h0 := hw.support z hne 0
    have h1 := hw.support z hne 1
    simp only [realProgressionCoordinate, Fin.val_zero, Fin.val_one, Nat.cast_zero,
      Nat.cast_one, zero_mul, add_zero, one_mul] at h0 h1
    exact hz ⟨⟨by linarith [h0.1], by linarith [h0.1, h1.2]⟩,
      ⟨by linarith [h0.2], by linarith [h0.2, h1.1]⟩⟩
  exact hw.smooth.continuous.integrable_of_hasCompactSupport hcs

/-- The shear `(y, t) ↦ (y + c t, t)` of the plane as a measurable equivalence. -/
noncomputable def planeShear (c : ℝ) : (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) where
  toFun p := (p.1 + c * p.2, p.2)
  invFun p := (p.1 - c * p.2, p.2)
  left_inv p := by ext <;> simp
  right_inv p := by ext <;> simp
  measurable_toFun := by
    change Measurable fun p : ℝ × ℝ => (p.1 + c * p.2, p.2); fun_prop
  measurable_invFun := by
    change Measurable fun p : ℝ × ℝ => (p.1 - c * p.2, p.2); fun_prop

theorem measurePreserving_planeShear (c : ℝ) :
    MeasurePreserving (planeShear c) (volume : Measure (ℝ × ℝ)) volume := by
  have h1 : MeasurePreserving (fun p : ℝ × ℝ => (p.2, p.1))
      (volume : Measure (ℝ × ℝ)) volume := Measure.measurePreserving_swap
  have h2 : MeasurePreserving (fun q : ℝ × ℝ => (q.1, q.2 + c * q.1))
      (volume : Measure (ℝ × ℝ)) volume :=
    (MeasurePreserving.id volume).skew_product (g := fun t y => y + c * t) (by fun_prop)
      (Filter.Eventually.of_forall fun t => (measurePreserving_add_right volume (c * t)).map_eq)
  have h := h1.comp (h2.comp h1)
  convert h using 1
  exact funext fun p => rfl

/-- The anchor function `W_B(y) = ∫ w(y - l t, t) e(B t) dt` of a kernel (blueprint lines
2540-2542). -/
noncomputable def anchorFn (w : ℝ × ℝ → ℂ) (l : Fin 4) (B y : ℝ) : ℂ :=
  ∫ t, w (y - ((l : ℕ) : ℝ) * t, t) * (Real.fourierChar (B * t) : ℂ)

/-- Blueprint lines 2519-2523 with the numerical errors of `eq:core-numerical`: if on the kernel
support the product of the inputs is within `ε` of a finite phase sum
`Σ_p C_p e(A_p (z₁ - x₀) + B_p z₂)`, the local form is within `2 ‖w‖_∞ ε` of
`Σ_p C_p e(A_p (a₀ + r/2 - x₀)) WFourier(-r A_p, -r B_p)`. -/
theorem form_phase_sum_approx {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ)
    (hfi : Integrable (fun z : ℝ × ℝ => w z * ∏ j, f j (realProgressionCoordinate j z)))
    {ι : Type*} (P : Finset ι) (C : ι → ℂ) (A B : ι → ℝ) (x₀ : ℝ) {ε : ℝ} (hε0 : 0 ≤ ε)
    (hε : ∀ z : ℝ × ℝ, w z ≠ 0 → ‖∏ j, f j (realProgressionCoordinate j z) -
      ∑ p ∈ P, C p * (Real.fourierChar (A p * (z.1 - x₀) + B p * z.2) : ℂ)‖ ≤ ε) :
    ‖localProgressionForm r w f - ∑ p ∈ P, C p *
      ((Real.fourierChar (A p * (a₀ + r / 2 - x₀)) : ℂ) *
        kernelFT (unitKernel a₀ r w) (-(r * A p)) (-(r * B p)))‖ ≤
      2 * localKernelSupBound κ * ε := by
  have hwi := admissible_integrable hr hw
  have hm := mul_nonneg κ.margin_pos.le hr.le
  set Kw := localKernelSupBound κ
  set S : ℝ × ℝ → ℂ := fun z => ∑ p ∈ P, C p *
    (Real.fourierChar (A p * (z.1 - x₀) + B p * z.2) : ℂ)
  have hSc : Continuous S := continuous_finsetSum _ fun p _ => continuous_const.mul
    (continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop)))
  have hSb : ∃ M, ∀ z, ‖S z‖ ≤ M := ⟨∑ p ∈ P, ‖C p‖, fun z => (norm_sum_le _ _).trans
    (Finset.sum_le_sum fun p _ => by rw [norm_mul, Circle.norm_coe, mul_one])⟩
  obtain ⟨M, hM⟩ := hSb
  have hwS : Integrable (fun z => w z * S z) :=
    hwi.mul_bdd hSc.aestronglyMeasurable (Filter.Eventually.of_forall hM)
  -- the phase sum form
  have hform : (r : ℂ)⁻¹ ^ 2 * ∫ z, w z * S z = ∑ p ∈ P, C p *
      ((Real.fourierChar (A p * (a₀ + r / 2 - x₀)) : ℂ) *
        kernelFT (unitKernel a₀ r w) (-(r * A p)) (-(r * B p))) := by
    have hint : ∀ p, Integrable (fun z => w z * (C p *
        (Real.fourierChar (A p * (z.1 - x₀) + B p * z.2) : ℂ))) := fun p =>
      hwi.mul_bdd (continuous_const.mul (continuous_subtype_val.comp
        (Real.continuous_fourierChar.comp (by fun_prop)))).aestronglyMeasurable
        (Filter.Eventually.of_forall fun z => le_of_eq (by
          rw [norm_mul, Circle.norm_coe, mul_one]))
    simp only [S, Finset.mul_sum]
    rw [integral_finsetSum _ fun p _ => hint p, Finset.mul_sum]
    refine Finset.sum_congr rfl fun p _ => ?_
    simp_rw [mul_left_comm (w _) (C p)]
    rw [integral_const_mul, mul_left_comm]
    have e : ∀ z : ℝ × ℝ, A p * (z.1 - x₀) + B p * z.2 = A p * z.1 + B p * z.2 + -(A p * x₀) :=
      fun z => by ring
    simp_rw [e]
    rw [form_linear_phase hr hwi]
    rw [show A p * (a₀ + r / 2 - x₀) = -(A p * x₀) + A p * (a₀ + r / 2) by ring]
  rw [← hform]
  unfold localProgressionForm
  rw [← mul_sub, ← integral_sub hfi hwS, norm_mul]
  -- the error integral
  have hbd : ∀ z, ‖w z * ∏ j, f j (realProgressionCoordinate j z) - w z * S z‖ ≤
      (Set.Icc a₀ (a₀ + r) ×ˢ Set.Icc (-r) r).indicator (fun _ => Kw * ε) z := by
    intro z
    rw [← mul_sub, norm_mul]
    by_cases hz : w z = 0
    · rw [hz, norm_zero, zero_mul]
      exact Set.indicator_nonneg (fun _ _ => mul_nonneg (localKernelSupBound_nonneg κ) hε0) _
    have h0 := hw.support z hz 0
    have h1 := hw.support z hz 1
    simp only [realProgressionCoordinate, Fin.val_zero, Fin.val_one, Nat.cast_zero,
      Nat.cast_one, zero_mul, add_zero, one_mul] at h0 h1
    have hmem : z ∈ Set.Icc a₀ (a₀ + r) ×ˢ Set.Icc (-r) r :=
      ⟨⟨by linarith [h0.1], by linarith [h0.2]⟩, ⟨by linarith [h0.2, h1.1],
        by linarith [h0.1, h1.2]⟩⟩
    rw [Set.indicator_of_mem hmem]
    exact mul_le_mul (admissibleLocalKernel_norm_le hw z) (hε z hz) (norm_nonneg _)
      (localKernelSupBound_nonneg κ)
  set box := Set.Icc a₀ (a₀ + r) ×ˢ Set.Icc (-r) r
  have hbox : MeasurableSet box := measurableSet_Icc.prod measurableSet_Icc
  have hvol : (volume box).toReal = 2 * r ^ 2 := by
    rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Icc, Real.volume_Icc,
      ENNReal.toReal_mul, ENNReal.toReal_ofReal (by linarith), ENNReal.toReal_ofReal (by linarith)]
    ring
  have hgi : Integrable (box.indicator fun _ => Kw * ε) := by
    refine (integrableOn_const ?_).integrable_indicator hbox
    rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Icc, Real.volume_Icc]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top
  have hI := norm_integral_le_of_norm_le hgi (Filter.Eventually.of_forall hbd)
  rw [integral_indicator hbox, setIntegral_const, smul_eq_mul, Measure.real, hvol] at hI
  have hr2 : ‖(r : ℂ)⁻¹ ^ 2‖ = (r ^ 2)⁻¹ := by
    rw [norm_pow, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr, inv_pow]
  rw [hr2]
  calc (r ^ 2)⁻¹ * ‖∫ z, (w z * ∏ j, f j (realProgressionCoordinate j z) - w z * S z)‖ ≤
      (r ^ 2)⁻¹ * (2 * r ^ 2 * (Kw * ε)) := by gcongr
    _ = 2 * Kw * ε := by field_simp

section TorusAlgebra
variable {d : ℕ}

theorem torusCharacter_add (n : Fin d → ℤ) (x y : StandardTorus d) :
    torusCharacter n (x + y) = torusCharacter n x * torusCharacter n y := by
  have hp : torusPairing n (x + y) = torusPairing n x + torusPairing n y :=
    (torusPairingMap n).map_add x y
  unfold torusCharacter
  rw [hp, fourier_apply, fourier_apply, fourier_apply, one_smul, one_smul, one_smul,
    AddCircle.toCircle_add, Circle.coe_mul]

theorem torusCharacter_zsmul (n : Fin d → ℤ) (k : ℤ) (y : StandardTorus d) :
    torusCharacter n (k • y) = torusCharacter (k • n) y := by
  have hp : torusPairing n (k • y) = torusPairing (k • n) y := by
    rw [torusPairing_eq_sum, torusPairing_eq_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Pi.smul_apply, Pi.smul_apply, smul_eq_mul, mul_comm, mul_smul]
  unfold torusCharacter
  rw [hp]

theorem torusCharacter_sum_freq {κ : Type*} (s : Finset κ) (m : κ → Fin d → ℤ)
    (x : StandardTorus d) :
    torusCharacter (∑ i ∈ s, m i) x = ∏ i ∈ s, torusCharacter (m i) x := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [torusCharacter_zero]
  | insert i s hi ih =>
    rw [Finset.sum_insert hi, Finset.prod_insert hi, torusCharacter_add_freq, ih]

open Classical in
/-- The character expansion of `D(u, v) = R(u, v) Π_j g_j(u + (j - l) v)` for trigonometric
polynomials `R = Σ_q r_q χ_{q₁}(u) χ_{q₂}(v)` and `g_j = Σ_k a_{j,k} χ_{n_{j,k}}` on the torus
(blueprint lines 2519-2523): the sum over `(q, k)` of `r_q Π_j a_{j,k_j}` times the characters
`χ_{q₁ + Σ_j n_{j,k_j}}(u) χ_{q₂ + Σ_j (j - l) n_{j,k_j}}(v)`. -/
theorem four_product_expand (l : ℤ) {ιR : Type*} {ι : Fin 4 → Type*} (QR : Finset ιR)
    (rc : ιR → ℂ) (fr : ιR → (Fin d → ℤ) × (Fin d → ℤ)) (F : ∀ j, Finset (ι j)) (a : ∀ j, ι j → ℂ)
    (n : ∀ j, ι j → Fin d → ℤ) (u v : StandardTorus d) :
    (∑ q ∈ QR, rc q * (torusCharacter (fr q).1 u * torusCharacter (fr q).2 v)) *
      ∏ j : Fin 4, (∑ k ∈ F j, a j k * torusCharacter (n j k) (u + (((j : ℕ) : ℤ) - l) • v)) =
    ∑ x ∈ QR ×ˢ Fintype.piFinset F, (rc x.1 * ∏ j, a j (x.2 j)) *
      (torusCharacter ((fr x.1).1 + ∑ j, n j (x.2 j)) u *
        torusCharacter ((fr x.1).2 + ∑ j : Fin 4, (((j : ℕ) : ℤ) - l) • n j (x.2 j)) v) := by
  rw [Finset.prod_univ_sum, Finset.sum_mul_sum, Finset.sum_product]
  refine Finset.sum_congr rfl fun q _ => Finset.sum_congr rfl fun k _ => ?_
  rw [torusCharacter_add_freq, torusCharacter_add_freq, torusCharacter_sum_freq,
    torusCharacter_sum_freq]
  have e : ∀ j : Fin 4, a j (k j) * torusCharacter (n j (k j)) (u + (((j : ℕ) : ℤ) - l) • v) =
      a j (k j) * (torusCharacter (n j (k j)) u *
        torusCharacter ((((j : ℕ) : ℤ) - l) • n j (k j)) v) := fun j => by
    rw [torusCharacter_add, torusCharacter_zsmul]
  simp_rw [e]
  rw [Finset.prod_mul_distrib, Finset.prod_mul_distrib]
  ring

end TorusAlgebra

section CosetGeneral
variable {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))

open Classical in
/-- `coset_sum_eq_haar` for a trigonometric polynomial indexed by an arbitrary finite set with a
frequency map. -/
theorem coset_sum_eq_haar' {ι : Type*} (P : Finset ι) (c : ι → ℂ)
    (fr : ι → (Fin d → ℤ) × (Fin d → ℤ)) (P₀ : (Fin d → ℤ) × (Fin d → ℤ)) :
    (∫ u : torusAnnihilator (rationalIntegerIntersection V), ∫ v : torusAnnihilator
        (rationalIntegerIntersection V), ∑ p ∈ P, c p *
          (torusCharacter ((fr p).1 - P₀.1) u * torusCharacter ((fr p).2 - P₀.2) v)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) =
      ∑ p ∈ P, if (fr p).1 - P₀.1 ∈ rationalIntegerIntersection V ∧
        (fr p).2 - P₀.2 ∈ rationalIntegerIntersection V then c p else 0 := by
  set μ := torusAnnihilatorHaar (rationalIntegerIntersection V)
  have hin : ∀ u : torusAnnihilator (rationalIntegerIntersection V),
      ∫ v, ∑ p ∈ P, c p * (torusCharacter ((fr p).1 - P₀.1) u *
        torusCharacter ((fr p).2 - P₀.2) v) ∂μ =
        ∑ p ∈ P, c p * torusCharacter ((fr p).1 - P₀.1) u *
          (if (fr p).2 - P₀.2 ∈ rationalIntegerIntersection V then 1 else 0) := by
    intro u
    rw [integral_finsetSum _ fun p _ => ((integrable_torusCharacter V _).const_mul _).const_mul _]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [integral_const_mul, integral_const_mul, rationalAnnihilator_character_integral]
    ring
  simp_rw [hin]
  rw [integral_finsetSum _ fun p _ => by
    simp only [mul_assoc]
    exact ((integrable_torusCharacter V _).mul_const _).const_mul _]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [integral_mul_const, integral_const_mul, rationalAnnihilator_character_integral]
  split_ifs <;> simp_all

open Classical in
/-- `four_core_test` for a trigonometric expansion indexed by an arbitrary finite set with a
frequency map `fr` (no merging of equal frequencies needed). -/
theorem four_core_test' {ι : Type*} (P : Finset ι) (c Kv : ι → ℂ)
    (fr : ι → (Fin d → ℤ) × (Fin d → ℤ)) (p₀ : (Fin d → ℤ) × (Fin d → ℤ)) (K₀ : ℂ) {ε τ : ℝ}
    (hclose : ∀ p ∈ P, ((fr p).1 - p₀.1 ∈ rationalIntegerIntersection V ∧
      (fr p).2 - p₀.2 ∈ rationalIntegerIntersection V) → ‖Kv p - K₀‖ ≤ ε)
    (hfar : ∀ p ∈ P, ¬ ((fr p).1 - p₀.1 ∈ rationalIntegerIntersection V ∧
      (fr p).2 - p₀.2 ∈ rationalIntegerIntersection V) → ‖Kv p‖ ≤ τ)
    (Rm : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ) (hRm : Continuous Rm) {W : ℝ}
    (hW : 0 ≤ W) (hRb : ∀ z, ‖Rm z‖ ≤ W) (l : ℤ)
    (g : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℂ)
    (hg : ∀ i, Continuous (g i))
    (hexp : ∀ u v, Rm (u, v) * ∏ i, g i (u + ((i : ℤ) - l) • v) =
      ∑ p ∈ P, c p * (torusCharacter (fr p).1 u * torusCharacter (fr p).2 v)) :
    ‖∑ p ∈ P, c p * Kv p‖ ≤
      ‖K₀‖ * (W * ∏ i, (eLpNorm (g i) 2
        (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal) +
      max ε τ * ∑ p ∈ P, ‖c p‖ := by
  set! rel : ι → Prop := fun p => (fr p).1 - p₀.1 ∈ rationalIntegerIntersection V ∧
    (fr p).2 - p₀.2 ∈ rationalIntegerIntersection V
  -- the reference value as a value at an extra index
  have hsplit : ∑ p ∈ P, c p * Kv p = K₀ * ∑ p ∈ P.filter rel, c p +
      (∑ p ∈ P.filter rel, c p * (Kv p - K₀) + ∑ p ∈ P.filter (fun p => ¬ rel p), c p * Kv p) := by
    rw [← Finset.sum_filter_add_sum_filter_not P rel, Finset.mul_sum, ← add_assoc,
      ← Finset.sum_add_distrib]
    congr 1
    refine Finset.sum_congr rfl fun p _ => by ring
  set! χ : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ := fun z =>
    starRingEnd ℂ (torusCharacter p₀.1 z.1) * starRingEnd ℂ (torusCharacter p₀.2 z.2)
  have hχc : Continuous χ :=
    ((Complex.continuous_conj.comp (continuous_torusCharacter p₀.1)).comp
      (continuous_subtype_val.comp continuous_fst)).mul
    ((Complex.continuous_conj.comp (continuous_torusCharacter p₀.2)).comp
      (continuous_subtype_val.comp continuous_snd))
  have hχ : ∀ z, ‖χ z‖ ≤ 1 := fun z => by
    simp only [χ, norm_mul, RCLike.norm_conj, torusCharacter, fourier_apply, Circle.norm_coe,
      mul_one, le_refl]
  have hcs : ∑ p ∈ P.filter rel, c p =
      ∫ u, ∫ v, Rm (u, v) * (∏ i, g i (u + ((i : ℤ) - l) • v)) * χ (u, v)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V) := by
    rw [Finset.sum_filter, ← coset_sum_eq_haar' V P c fr p₀]
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
    refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
    simp only [χ]
    rw [hexp, Finset.sum_mul]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [torusCharacter_sub, torusCharacter_sub]; ring
  have h4 := coset_haar_four_le V Rm hRm hW hRb l g hg χ hχc hχ
  rw [← hcs] at h4
  rw [hsplit]
  have hA : ‖∑ p ∈ P.filter rel, c p * (Kv p - K₀)‖ ≤ max ε τ * ∑ p ∈ P.filter rel, ‖c p‖ := by
    rw [Finset.mul_sum]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun p hp => ?_)
    obtain ⟨hpP, hr⟩ := Finset.mem_filter.mp hp
    rw [norm_mul, mul_comm (max ε τ)]
    exact mul_le_mul_of_nonneg_left ((hclose p hpP hr).trans (le_max_left _ _)) (norm_nonneg _)
  have hB : ‖∑ p ∈ P.filter (fun p => ¬ rel p), c p * Kv p‖ ≤
      max ε τ * ∑ p ∈ P.filter (fun p => ¬ rel p), ‖c p‖ := by
    rw [Finset.mul_sum]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun p hp => ?_)
    obtain ⟨hpP, hr⟩ := Finset.mem_filter.mp hp
    rw [norm_mul, mul_comm (max ε τ)]
    exact mul_le_mul_of_nonneg_left ((hfar p hpP hr).trans (le_max_right _ _)) (norm_nonneg _)
  have hs := Finset.sum_filter_add_sum_filter_not P rel (fun p => ‖c p‖)
  calc ‖K₀ * ∑ p ∈ P.filter rel, c p + (∑ p ∈ P.filter rel, c p * (Kv p - K₀) +
        ∑ p ∈ P.filter (fun p => ¬ rel p), c p * Kv p)‖
      ≤ ‖K₀‖ * ‖∑ p ∈ P.filter rel, c p‖ + (max ε τ * ∑ p ∈ P.filter rel, ‖c p‖ +
        max ε τ * ∑ p ∈ P.filter (fun p => ¬ rel p), ‖c p‖) := by
        refine (norm_add_le _ _).trans (add_le_add (le_of_eq (norm_mul _ _)) ?_)
        exact (norm_add_le _ _).trans (add_le_add hA hB)
    _ ≤ ‖K₀‖ * (W * ∏ i, (eLpNorm (g i) 2
          (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal) +
        max ε τ * ∑ p ∈ P, ‖c p‖ := by
        rw [← mul_add, hs]
        gcongr

end CosetGeneral

open Classical in
/-- Blueprint lines 2519-2523 (four cores, anchor `l' = 0`): if on the kernel support the product
of the inputs is within `ε` of `e(Σ_j γ_j (y_j - x₀)) D(ξ(x - x₀), ξ t)` for the torus
trigonometric polynomial `D(u, v) = R(u, v) Π_j g_j(u + j v)`, then the local form is within
`2 ‖w‖_∞ ε` of `Σ_x C_x e(A_x (a₀ + r/2 - x₀)) WFourier(-r A_x, -r B_x)` over the expansion of `D`
(`four_product_expand`), with `A_x = Σ_j γ_j + P₁(x)·ξ` and `B_x = Σ_j j γ_j + P₂(x)·ξ`. -/
theorem four_core_physical {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ)
    (hfi : Integrable (fun z : ℝ × ℝ => w z * ∏ j, f j (realProgressionCoordinate j z)))
    {d : ℕ} (ξ : Fin d → ℝ) (x₀ : ℝ) (γ : Fin 4 → ℝ) {ιR : Type*} {ι : Fin 4 → Type*}
    (QR : Finset ιR) (rc : ιR → ℂ) (fr : ιR → (Fin d → ℤ) × (Fin d → ℤ)) (F : ∀ j, Finset (ι j))
    (a : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin d → ℤ) {ε : ℝ} (hε0 : 0 ≤ ε)
    (hε : ∀ z : ℝ × ℝ, w z ≠ 0 → ‖∏ j, f j (realProgressionCoordinate j z) -
      (Real.fourierChar (∑ j, γ j * (realProgressionCoordinate j z - x₀)) : ℂ) *
        ((∑ q ∈ QR, rc q * (torusCharacter (fr q).1 (torusMk fun i => ξ i * (z.1 - x₀)) *
          torusCharacter (fr q).2 (torusMk fun i => ξ i * z.2))) *
        ∏ j : Fin 4, (∑ k ∈ F j, a j k * torusCharacter (n j k)
          ((torusMk fun i => ξ i * (z.1 - x₀)) +
            (((j : ℕ) : ℤ) - 0) • (torusMk fun i => ξ i * z.2))))‖ ≤ ε) :
    ‖localProgressionForm r w f - ∑ x ∈ QR ×ˢ Fintype.piFinset F,
      (rc x.1 * ∏ j, a j (x.2 j)) *
      ((Real.fourierChar ((∑ j, γ j + ∑ i, (((fr x.1).1 + ∑ j, n j (x.2 j)) i : ℝ) * ξ i) *
          (a₀ + r / 2 - x₀)) : ℂ) *
        kernelFT (unitKernel a₀ r w)
          (-(r * (∑ j, γ j + ∑ i, (((fr x.1).1 + ∑ j, n j (x.2 j)) i : ℝ) * ξ i)))
          (-(r * (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (((fr x.1).2 +
            ∑ j : Fin 4, (((j : ℕ) : ℤ) - 0) • n j (x.2 j)) i : ℝ) * ξ i))))‖ ≤
      2 * localKernelSupBound κ * ε := by
  refine form_phase_sum_approx hr hw f hfi (QR ×ˢ Fintype.piFinset F)
    (fun x : ιR × (∀ j, ι j) => rc x.1 * ∏ j, a j (x.2 j))
    (fun x : ιR × (∀ j, ι j) => ∑ j, γ j + ∑ i, (((fr x.1).1 + ∑ j, n j (x.2 j)) i : ℝ) * ξ i)
    (fun x : ιR × (∀ j, ι j) => ∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (((fr x.1).2 +
      ∑ j : Fin 4, (((j : ℕ) : ℤ) - 0) • n j (x.2 j)) i : ℝ) * ξ i) x₀ hε0 fun z hz => ?_
  refine le_trans (le_of_eq ?_) (hε z hz)
  congr 2
  rw [four_product_expand 0 QR rc fr F a n, Finset.mul_sum]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [torusCharacter_mk_line, torusCharacter_mk_line]
  have e1 : ∑ j : Fin 4, γ j * (realProgressionCoordinate j z - x₀) =
      (∑ j, γ j) * (z.1 - x₀) + (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j) * z.2 := by
    simp only [realProgressionCoordinate, Fin.sum_univ_four]
    norm_num
    ring
  rw [e1]
  set P1 := ∑ i, (((fr x.1).1 + ∑ j, n j (x.2 j)) i : ℝ) * ξ i
  set P2 := ∑ i, (((fr x.1).2 + ∑ j : Fin 4, (((j : ℕ) : ℤ) - 0) • n j (x.2 j)) i : ℝ) * ξ i
  have e2 : (∑ j, γ j + P1) * (z.1 - x₀) + (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + P2) * z.2 =
      ((∑ j, γ j) * (z.1 - x₀) + (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j) * z.2) +
        (P1 * (z.1 - x₀) + P2 * z.2) := by ring
  rw [e2, AddChar.map_add_eq_mul, Circle.coe_mul,
    AddChar.map_add_eq_mul Real.fourierChar (P1 * (z.1 - x₀)) (P2 * z.2), Circle.coe_mul]
  ring

open Classical in
/-- Blueprint lines 2519-2531 (the four-core test on a cell): under the hypotheses of
`four_core_physical`, if the kernel samples `K_x = e(A_x (a₀ + r/2 - x₀)) WFourier(-r A_x, -r
  B_x)` are
within `ε` of a reference value `K₀` on the reference coset `p₀ + K_B²` of the expansion
frequencies and at most `τ` off it, and the torus multiplier is bounded by `W` on `𝓗²`, then
`|Λ| ≤ 2 ‖w‖_∞ ε_ph + |K₀| W Π_j ‖g_j‖_{L²(𝓗)} + max(ε, τ) Σ_x |C_x|`. -/
theorem four_core_cell_bound {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ)
    (hfi : Integrable (fun z : ℝ × ℝ => w z * ∏ j, f j (realProgressionCoordinate j z)))
    {d : ℕ} (V : Submodule ℚ (Fin d → ℚ)) (ξ : Fin d → ℝ) (x₀ : ℝ) (γ : Fin 4 → ℝ)
    {ιR : Type*} {ι : Fin 4 → Type*} (QR : Finset ιR) (rc : ιR → ℂ)
    (fr : ιR → (Fin d → ℤ) × (Fin d → ℤ)) (F : ∀ j, Finset (ι j)) (a : ∀ j, ι j → ℂ)
    (n : ∀ j, ι j → Fin d → ℤ) {εph : ℝ} (hε0 : 0 ≤ εph)
    (hε : ∀ z : ℝ × ℝ, w z ≠ 0 → ‖∏ j, f j (realProgressionCoordinate j z) -
      (Real.fourierChar (∑ j, γ j * (realProgressionCoordinate j z - x₀)) : ℂ) *
        ((∑ q ∈ QR, rc q * (torusCharacter (fr q).1 (torusMk fun i => ξ i * (z.1 - x₀)) *
          torusCharacter (fr q).2 (torusMk fun i => ξ i * z.2))) *
        ∏ j : Fin 4, (∑ k ∈ F j, a j k * torusCharacter (n j k)
          ((torusMk fun i => ξ i * (z.1 - x₀)) +
            (((j : ℕ) : ℤ) - 0) • (torusMk fun i => ξ i * z.2))))‖ ≤ εph)
    (p₀ : (Fin d → ℤ) × (Fin d → ℤ)) (K₀ : ℂ) {ε τ : ℝ}
    (hclose : ∀ x ∈ QR ×ˢ Fintype.piFinset F,
      ((fr x.1).1 + ∑ j, n j (x.2 j) - p₀.1 ∈ rationalIntegerIntersection V ∧
        (fr x.1).2 + ∑ j : Fin 4, (((j : ℕ) : ℤ) - 0) • n j (x.2 j) - p₀.2 ∈
          rationalIntegerIntersection V) →
      ‖(Real.fourierChar ((∑ j, γ j + ∑ i, (((fr x.1).1 + ∑ j, n j (x.2 j)) i : ℝ) * ξ i) *
          (a₀ + r / 2 - x₀)) : ℂ) *
        kernelFT (unitKernel a₀ r w)
          (-(r * (∑ j, γ j + ∑ i, (((fr x.1).1 + ∑ j, n j (x.2 j)) i : ℝ) * ξ i)))
          (-(r * (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (((fr x.1).2 +
            ∑ j : Fin 4, (((j : ℕ) : ℤ) - 0) • n j (x.2 j)) i : ℝ) * ξ i))) - K₀‖ ≤ ε)
    (hfar : ∀ x ∈ QR ×ˢ Fintype.piFinset F,
      ¬ ((fr x.1).1 + ∑ j, n j (x.2 j) - p₀.1 ∈ rationalIntegerIntersection V ∧
        (fr x.1).2 + ∑ j : Fin 4, (((j : ℕ) : ℤ) - 0) • n j (x.2 j) - p₀.2 ∈
          rationalIntegerIntersection V) →
      ‖(Real.fourierChar ((∑ j, γ j + ∑ i, (((fr x.1).1 + ∑ j, n j (x.2 j)) i : ℝ) * ξ i) *
          (a₀ + r / 2 - x₀)) : ℂ) *
        kernelFT (unitKernel a₀ r w)
          (-(r * (∑ j, γ j + ∑ i, (((fr x.1).1 + ∑ j, n j (x.2 j)) i : ℝ) * ξ i)))
          (-(r * (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (((fr x.1).2 +
            ∑ j : Fin 4, (((j : ℕ) : ℤ) - 0) • n j (x.2 j)) i : ℝ) * ξ i)))‖ ≤ τ)
    {W : ℝ} (hW : 0 ≤ W)
    (hRb : ∀ u v : StandardTorus d,
      ‖∑ q ∈ QR, rc q * (torusCharacter (fr q).1 u * torusCharacter (fr q).2 v)‖ ≤ W) :
    ‖localProgressionForm r w f‖ ≤ 2 * localKernelSupBound κ * εph +
      (‖K₀‖ * (W * ∏ j : Fin 4, (eLpNorm (fun u : torusAnnihilator
          (rationalIntegerIntersection V) => ∑ k ∈ F j, a j k * torusCharacter (n j k) u) 2
          (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal) +
        max ε τ * ∑ x ∈ QR ×ˢ Fintype.piFinset F, ‖rc x.1 * ∏ j, a j (x.2 j)‖) := by
  have hphys := four_core_physical hr hw f hfi ξ x₀ γ QR rc fr F a n hε0 hε
  set! Kv : ιR × (∀ j, ι j) → ℂ := fun x =>
    (Real.fourierChar ((∑ j, γ j + ∑ i, (((fr x.1).1 + ∑ j, n j (x.2 j)) i : ℝ) * ξ i) *
          (a₀ + r / 2 - x₀)) : ℂ) *
        kernelFT (unitKernel a₀ r w)
          (-(r * (∑ j, γ j + ∑ i, (((fr x.1).1 + ∑ j, n j (x.2 j)) i : ℝ) * ξ i)))
          (-(r * (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (((fr x.1).2 +
            ∑ j : Fin 4, (((j : ℕ) : ℤ) - 0) • n j (x.2 j)) i : ℝ) * ξ i)))
  set! Rm : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ := fun z =>
    ∑ q ∈ QR, rc q * (torusCharacter (fr q).1 z.1 * torusCharacter (fr q).2 z.2)
  set! g : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℂ := fun j u =>
    ∑ k ∈ F j, a j k * torusCharacter (n j k) u
  have hRm : Continuous Rm := continuous_finsetSum _ fun q _ => continuous_const.mul
    (((continuous_torusCharacter _).comp (continuous_subtype_val.comp continuous_fst)).mul
      ((continuous_torusCharacter _).comp (continuous_subtype_val.comp continuous_snd)))
  have hg : ∀ j, Continuous (g j) := fun j => continuous_finsetSum _ fun k _ =>
    continuous_const.mul ((continuous_torusCharacter _).comp continuous_subtype_val)
  have hexp : ∀ u v, Rm (u, v) * ∏ i, g i (u + ((i : ℤ) - 0) • v) =
      ∑ x ∈ QR ×ˢ Fintype.piFinset F, (rc x.1 * ∏ j, a j (x.2 j)) *
        (torusCharacter ((fr x.1).1 + ∑ j, n j (x.2 j)) u *
          torusCharacter ((fr x.1).2 + ∑ j : Fin 4, (((j : ℕ) : ℤ) - 0) • n j (x.2 j)) v) := by
    intro u v
    have h := four_product_expand 0 QR rc fr F a n (u : StandardTorus d) (v : StandardTorus d)
    simp only [Rm, g]
    rw [← h]
    rfl
  have htest := four_core_test' V (QR ×ˢ Fintype.piFinset F)
    (fun x => rc x.1 * ∏ j, a j (x.2 j)) Kv
    (fun x => ((fr x.1).1 + ∑ j, n j (x.2 j),
      (fr x.1).2 + ∑ j : Fin 4, (((j : ℕ) : ℤ) - 0) • n j (x.2 j))) p₀ K₀ hclose hfar Rm hRm hW
    (fun z => hRb _ _) 0 g hg hexp
  calc ‖localProgressionForm r w f‖ ≤ ‖localProgressionForm r w f -
        ∑ x ∈ QR ×ˢ Fintype.piFinset F, (rc x.1 * ∏ j, a j (x.2 j)) * Kv x‖ +
        ‖∑ x ∈ QR ×ˢ Fintype.piFinset F, (rc x.1 * ∏ j, a j (x.2 j)) * Kv x‖ :=
        (norm_le_insert' _ _).trans (le_of_eq (add_comm _ _))
    _ ≤ _ := add_le_add hphys htest

section AugPhys
variable {V : Type*} [Fintype V] [DecidableEq V]

omit [DecidableEq V] in
/-- The physical coordinate of a column vector has modulus at most its norm. -/
theorem norm_none_le (v : ColumnHilbert V) : ‖v none‖ ≤ ‖v‖ := by
  classical
  have h := EuclideanSpace.norm_sq_eq v
  have hs : ‖v none‖ ^ 2 ≤ ∑ i, ‖v i‖ ^ 2 :=
    Finset.single_le_sum (f := fun i => ‖v i‖ ^ 2) (fun _ _ => sq_nonneg _) (Finset.mem_univ _)
  rw [← h] at hs
  exact (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mp hs

/-- Blueprint lines 2489-2493 ("the physical norm is bounded by the augmented one"): the cell
integral of the squared physical combination is at most the squared norm of the augmented
combination. -/
theorem augMode_toLp_sum_phys_le {J : Set ℝ} (hJ : MeasurableSet J) (hJf : volume J ≠ ⊤)
    (ψ : V → ℝ → ℂ) (hψ : ∀ m, Measurable (ψ m)) (hψb : ∀ m y, ‖ψ m y‖ ≤ 1) (εw : V → ℝ)
    (M : Finset V) (β : V → ℂ) :
    ∫ y in J, ‖∑ m ∈ M, β m * ψ m y‖ ^ 2 ≤
      ‖∑ m ∈ M, β m • (augMode_memLp hJ hJf (hψ m) (hψb m) (εw m) m).toLp‖ ^ 2 := by
  rw [columnL2_norm_sq_eq]
  set! Ψ : V → ColumnL2 V := fun m => (augMode_memLp hJ hJf (hψ m) (hψb m) (εw m) m).toLp
  have hsum : ((∑ m ∈ M, β m • Ψ m : ColumnL2 V) : ℝ → ColumnHilbert V) =ᵐ[volume]
      fun y => ∑ m ∈ M, β m • augMode J (ψ m) (εw m) m y := by
    refine (Lp.coeFn_fun_finsetSum _ _).trans ?_
    have hall : ∀ᵐ y ∂volume, ∀ m ∈ M,
        ((β m • Ψ m : ColumnL2 V) : ℝ → ColumnHilbert V) y =
          β m • augMode J (ψ m) (εw m) m y := by
      rw [Filter.eventually_all_finset]
      intro m _
      filter_upwards [Lp.coeFn_smul (β m) (Ψ m),
        MemLp.coeFn_toLp (augMode_memLp hJ hJf (hψ m) (hψb m) (εw m) m)] with y h1 h2
      rw [h1, Pi.smul_apply, h2]
    filter_upwards [hall] with y hy
    exact Finset.sum_congr rfl hy
  have hint : Integrable (fun y => ‖((∑ m ∈ M, β m • Ψ m : ColumnL2 V) :
      ℝ → ColumnHilbert V) y‖ ^ 2) volume :=
    (Lp.memLp _).integrable_norm_pow (by norm_num)
  rw [← integral_indicator hJ]
  refine integral_mono_ae ?_ hint ?_
  · refine IntegrableOn.integrable_indicator ?_ hJ
    have hm : Measurable fun y => ‖∑ m ∈ M, β m * ψ m y‖ ^ 2 :=
      ((Finset.measurable_sum _ fun m _ => measurable_const.mul (hψ m)).norm).pow_const 2
    have : IsFiniteMeasure (volume.restrict J) := isFiniteMeasure_restrict.mpr hJf
    refine (integrable_const ((∑ m ∈ M, ‖β m‖) ^ 2)).mono'
      hm.aestronglyMeasurable (Filter.Eventually.of_forall fun y => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    refine pow_le_pow_left₀ (norm_nonneg _) ((norm_sum_le _ _).trans
      (Finset.sum_le_sum fun m _ => ?_)) 2
    rw [norm_mul]; exact mul_le_of_le_one_right (norm_nonneg _) (hψb m y)
  · filter_upwards [hsum] with y hy
    by_cases hyJ : y ∈ J
    · rw [Set.indicator_of_mem hyJ, hy]
      rw [← augMode_sum_none J ψ εw M β y hyJ]
      exact pow_le_pow_left₀ (norm_nonneg _) (norm_none_le _) 2
    · rw [Set.indicator_of_notMem hyJ]; positivity

end AugPhys

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc)

/-- The cell integral of the squared physical combination of waves is at most the squared norm
of the combination of cell modes. -/
theorem wave_sum_le_cellMode (J : ℤ × ℤ) (E : Finset Ms.Md) (α : Ms.Md → ℂ) :
    ∫ y in dyadicGridCell Gd J.1 J.2, ‖∑ m ∈ E, α m * Ms.wave m y‖ ^ 2 ≤
      ‖∑ m ∈ E, α m • Ms.cellMode J m‖ ^ 2 :=
  augMode_toLp_sum_phys_le (dyadicGridCell_measurable Gd J.1 J.2)
    (dyadicGridCell_volume_ne_top Gd J) Ms.wave Ms.wave_measurable Ms.wave_norm_le Ms.L.εM E α

end ModeSystem

open Classical in
/-- Blueprint `eq:torus-size` (lines 2482-2495) for one role on the cell: with anchor shift
`s₀ = a₀ - x*` (`|s₀| ≤ r`), if the frequency differences `2π r (n_k - n_{k'})·ξ` of the
trigonometric polynomial `g = Σ_k c_k χ_{n_k}` are at most `ε` on the relation `n_k - n_{k'} ∈ K_B`
and at least `2/ε` off it (`eq:gap`), its normalized cell average
`∫₀¹ |g(ξ(s₀ + r t))|² dt` is at most `X ≤ 2 Σ_D ‖A_D‖²`, at most `D_*` components are selected
with coefficient sums covering `Σ_k |c_k|`, and `2ε ≤ D_*^{-100}`, then
`‖g‖_{L²(𝓗)} ≤ √2 (Σ_D (‖A_D‖ + D_*^{-30} s_D)²)^{1/2}`. -/
theorem torus_size_cell {d : ℕ} (V : Submodule ℚ (Fin d → ℚ)) {ι κ : Type*} (F : Finset ι)
    (c : ι → ℂ) (n : ι → Fin d → ℤ) (ξ : Fin d → ℝ) {r s₀ : ℝ} (hr : 0 < r) (hs₀ : |s₀| ≤ r)
    {ε : ℝ} (hε : 0 < ε)
    (htiny : ∀ k ∈ F, ∀ k' ∈ F, n k - n k' ∈ rationalIntegerIntersection V →
      |2 * Real.pi * r * ∑ i, (n k i : ℝ) * ξ i - 2 * Real.pi * r * ∑ i, (n k' i : ℝ) * ξ i| ≤ ε)
    (hhuge : ∀ k ∈ F, ∀ k' ∈ F, n k - n k' ∉ rationalIntegerIntersection V →
      2 / ε ≤ |2 * Real.pi * r * ∑ i, (n k i : ℝ) * ξ i -
        2 * Real.pi * r * ∑ i, (n k' i : ℝ) * ξ i|)
    (s : Finset κ) (A sD : κ → ℝ) (hA : ∀ i ∈ s, 0 ≤ A i) (hs : ∀ i ∈ s, 0 ≤ sD i) {X Dst : ℝ}
    (hDst : 1 ≤ Dst) (hcard : (s.card : ℝ) ≤ Dst) (hεD : 2 * ε ≤ Dst ^ (-100 : ℤ))
    (hX : ∫ t in (0 : ℝ)..1, ‖∑ k ∈ F, c k *
      torusCharacter (n k) (torusMk fun i => ξ i * (s₀ + r * t))‖ ^ 2 ≤ X)
    (hXA : X ≤ 2 * ∑ i ∈ s, A i ^ 2) (hc : ∑ k ∈ F, ‖c k‖ ≤ ∑ i ∈ s, sD i) :
    (eLpNorm (fun x : torusAnnihilator (rationalIntegerIntersection V) =>
        ∑ k ∈ F, c k * torusCharacter (n k) x) 2
        (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal ≤
      Real.sqrt 2 * Real.sqrt (∑ i ∈ s, (A i + Dst ^ (-30 : ℤ) * sD i) ^ 2) := by
  set μ := torusAnnihilatorHaar (rationalIntegerIntersection V)
  set g : torusAnnihilator (rationalIntegerIntersection V) → ℂ := fun x =>
    ∑ k ∈ F, c k * torusCharacter (n k) x
  have hg : Continuous g := continuous_finsetSum _ fun k _ =>
    continuous_const.mul ((continuous_torusCharacter (n k)).comp continuous_subtype_val)
  set! fq : ι → ℝ := fun k => ∑ i, (n k i : ℝ) * ξ i
  -- the Haar side
  have hH : ((∫ x, ‖g x‖ ^ 2 ∂μ : ℝ) : ℂ) = ∑ k ∈ F, ∑ k' ∈ F,
      (if n k - n k' ∈ (rationalIntegerIntersection V) then c k * starRingEnd ℂ (c k') else 0) := by
    rw [← haar_norm_sq_eq V F c n, ← integral_complex_ofReal]
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    simp only [g]
    rw [normSq_sum_conj]
    refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun k' _ => ?_
    rw [map_mul]; ring
  -- the cell side in exponential form
  set! c' : ι → ℂ := fun k => c k * (Real.fourierChar (fq k * s₀) : ℂ)
  set! φ : ι → ℝ := fun k => 2 * Real.pi * r * fq k
  have hpt : ∀ t : ℝ, ∑ k ∈ F, c k * torusCharacter (n k) (torusMk fun i => ξ i * (s₀ + r * t)) =
      ∑ k ∈ F, c' k * Complex.exp (Complex.I * (φ k * t : ℝ)) := by
    intro t
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [torusCharacter_mk_line]
    simp only [c', φ, fq]
    rw [mul_assoc]
    congr 1
    rw [show (∑ i, (n k i : ℝ) * ξ i) * (s₀ + r * t) =
      (∑ i, (n k i : ℝ) * ξ i) * s₀ + (∑ i, (n k i : ℝ) * ξ i) * r * t by ring,
      AddChar.map_add_eq_mul, Circle.coe_mul, Real.fourierChar_apply (x := (∑ i, (n k i : ℝ) *
        ξ i) * r * t)]
    congr 2
    push_cast; ring
  simp_rw [hpt] at hX
  set Xr := ∫ t in (0 : ℝ)..1, ‖∑ k ∈ F, c' k * Complex.exp (Complex.I * (φ k * t : ℝ))‖ ^ 2
  have hC : (Xr : ℂ) = ∫ t in (0 : ℝ)..1, ∑ k ∈ F, ∑ k' ∈ F, c' k * starRingEnd ℂ (c' k') *
      Complex.exp (Complex.I * ((φ k - φ k') * t : ℝ)) := by
    rw [← intervalIntegral.integral_ofReal]
    refine intervalIntegral.integral_congr fun t _ => ?_
    rw [normSq_sum_conj]
    refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun k' _ => ?_
    rw [map_mul, ← exp_mul_conj_exp]; ring
  have hclose := cell_average_close F c' φ
    (fun k k' => n k - n k' ∈ (rationalIntegerIntersection V)) hε htiny hhuge
  rw [← hC] at hclose
  have hc'n : ∀ k, ‖c' k‖ = ‖c k‖ := fun k => by
    simp only [c', norm_mul, Circle.norm_coe, mul_one]
  simp_rw [hc'n] at hclose
  -- the shifted coefficients on the relation
  have hshift : ‖(∑ k ∈ F, ∑ k' ∈ F, (if n k - n k' ∈ (rationalIntegerIntersection V) then
      c' k * starRingEnd ℂ (c' k') else 0)) -
      ∑ k ∈ F, ∑ k' ∈ F, (if n k - n k' ∈ (rationalIntegerIntersection V) then
        c k * starRingEnd ℂ (c k') else 0)‖ ≤
      ε * (∑ k ∈ F, ‖c k‖) ^ 2 := by
    rw [← Finset.sum_sub_distrib]
    simp_rw [← Finset.sum_sub_distrib]
    refine (norm_sum_le _ _).trans ?_
    rw [sq, Finset.sum_mul_sum, Finset.mul_sum]
    refine Finset.sum_le_sum fun k hk => (norm_sum_le _ _).trans ?_
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum fun k' hk' => ?_
    split_ifs with hrel
    · have e : c' k * starRingEnd ℂ (c' k') - c k * starRingEnd ℂ (c k') =
          c k * starRingEnd ℂ (c k') * ((Real.fourierChar ((fq k - fq k') * s₀) : ℂ) - 1) := by
        have hconj : starRingEnd ℂ (Real.fourierChar (fq k' * s₀) : ℂ) =
            (Real.fourierChar (-(fq k' * s₀)) : ℂ) := by
          rw [AddChar.map_neg_eq_inv, Circle.coe_inv_eq_conj]
        have hm : (Real.fourierChar (fq k * s₀) : ℂ) * (Real.fourierChar (-(fq k' * s₀)) : ℂ) =
            (Real.fourierChar ((fq k - fq k') * s₀) : ℂ) := by
          rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul]; congr 2; ring
        simp only [c', map_mul]
        rw [hconj, ← hm]
        ring
      rw [e, norm_mul, norm_mul, RCLike.norm_conj]
      have h1 := chart_fourierChar_sub_one_norm_le ((fq k - fq k') * s₀)
      have h2 : 2 * Real.pi * |(fq k - fq k') * s₀| ≤ ε := by
        have ht := htiny k hk k' hk' hrel
        rw [abs_mul]
        calc 2 * Real.pi * (|fq k - fq k'| * |s₀|) ≤ 2 * Real.pi * (|fq k - fq k'| * r) := by
              gcongr
          _ = |2 * Real.pi * r * fq k - 2 * Real.pi * r * fq k'| := by
              rw [show 2 * Real.pi * r * fq k - 2 * Real.pi * r * fq k' =
                (2 * Real.pi * r) * (fq k - fq k') by ring, abs_mul,
                abs_of_pos (by positivity : 0 < 2 * Real.pi * r)]
              ring
          _ ≤ ε := ht
      calc ‖c k‖ * ‖c k'‖ * ‖(Real.fourierChar ((fq k - fq k') * s₀) : ℂ) - 1‖ ≤
          ‖c k‖ * ‖c k'‖ * ε := by gcongr; exact h1.trans h2
        _ = ε * (‖c k‖ * ‖c k'‖) := by ring
    · rw [sub_self, norm_zero]; positivity
  -- combine
  have hI : ∫ x, ‖g x‖ ^ 2 ∂μ ≤ X + 2 * ε * (∑ i ∈ s, sD i) ^ 2 := by
    have hre : ∫ x, ‖g x‖ ^ 2 ∂μ - Xr ≤ 2 * ε * (∑ k ∈ F, ‖c k‖) ^ 2 := by
      have hz : ‖((∫ x, ‖g x‖ ^ 2 ∂μ : ℝ) : ℂ) - (Xr : ℂ)‖ ≤ 2 * ε * (∑ k ∈ F, ‖c k‖) ^ 2 := by
        rw [hH]
        have := norm_sub_le_norm_sub_add_norm_sub
          (∑ k ∈ F, ∑ k' ∈ F, (if n k - n k' ∈ (rationalIntegerIntersection V) then
            c k * starRingEnd ℂ (c k') else 0))
          (∑ k ∈ F, ∑ k' ∈ F, (if n k - n k' ∈ (rationalIntegerIntersection V) then
            c' k * starRingEnd ℂ (c' k') else 0))
          (Xr : ℂ)
        rw [norm_sub_rev] at hshift
        rw [norm_sub_rev (Xr : ℂ)] at hclose
        linarith
      have := (abs_le.mp ((Complex.abs_re_le_norm _).trans hz)).2
      simpa only [Complex.sub_re, Complex.ofReal_re] using this
    have h2 : 2 * ε * (∑ k ∈ F, ‖c k‖) ^ 2 ≤ 2 * ε * (∑ i ∈ s, sD i) ^ 2 :=
      mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (Finset.sum_nonneg fun _ _ => norm_nonneg _)
        hc 2) (by linarith)
    linarith
  rw [eLpNorm_toReal_eq_sqrt V g hg]
  have h0 : 0 ≤ ∫ x, ‖g x‖ ^ 2 ∂μ := integral_nonneg fun _ => by positivity
  refine torus_size_bound s A sD hA hs hDst hcard hεD ?_ hXA
  rw [Real.sq_sqrt h0]; exact hI

/-- The sheared kernel `w(y - l t, t)` vanishes unless `y` lies in the cell and `|t| ≤ r`, and then
all progression points `y + (j - l) t` lie in the cell. -/
theorem admissible_shear_support {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4) {y t : ℝ}
    (h : w (y - ((l : ℕ) : ℝ) * t, t) ≠ 0) :
    (∀ j : Fin 4, y + (((j : ℕ) : ℝ) - ((l : ℕ) : ℝ)) * t ∈ Set.Icc a₀ (a₀ + r)) ∧ |t| ≤ r := by
  have hm := mul_nonneg κ.margin_pos.le hr.le
  have hc : ∀ j : Fin 4, realProgressionCoordinate j (y - ((l : ℕ) : ℝ) * t, t) =
      y + (((j : ℕ) : ℝ) - ((l : ℕ) : ℝ)) * t := fun j => by
    simp only [realProgressionCoordinate]; ring
  refine ⟨fun j => ?_, ?_⟩
  · have := hw.support _ h j
    rw [hc j] at this
    exact ⟨by linarith [this.1], by linarith [this.2]⟩
  · have h0 := hw.support _ h 0
    have h1 := hw.support _ h 1
    rw [hc] at h0 h1
    simp only [Fin.val_zero, Fin.val_one, Nat.cast_zero, Nat.cast_one] at h0 h1
    rw [abs_le]; constructor <;> nlinarith [h0.1, h0.2, h1.1, h1.2]

/-- Blueprint lines 2549-2556 ("expand `S'` in normalized Fourier coefficients ... the matrix of
pairings"): for a continuous function `G` with `G(a) = G(a + r)` and summable Fourier coefficients
on `[a, a + r)` and an integrable `S` there, the pairing `∫ S G` is the convergent sum over
`k ∈ ℤ` of `GFourier(k) ∫ S(y) e(k y / r) dy`. -/
theorem interval_fourier_pairing {a r : ℝ} (hr : 0 < r) (S : ℝ → ℂ)
    (hS : IntegrableOn S (Set.Ico a (a + r))) (G : ℝ → ℂ) (hG : Continuous G)
    (hGa : G a = G (a + r)) (hsum : Summable (fourierCoeffOn (lt_add_of_pos_right a hr) G)) :
    HasSum (fun k : ℤ => fourierCoeffOn (lt_add_of_pos_right a hr) G k *
      ∫ y in Set.Ico a (a + r), S y * Complex.exp (2 * Real.pi * Complex.I * k * y / r))
      (∫ y in Set.Ico a (a + r), S y * G y) := by
  have : Fact (0 < r) := ⟨hr⟩
  set ĝ := fourierCoeffOn (lt_add_of_pos_right a hr) G
  set Gc : C(AddCircle r, ℂ) := ⟨AddCircle.liftIco r a G, AddCircle.liftIco_continuous hGa
    hG.continuousOn⟩
  have hcoef : ∀ k, fourierCoeff Gc k = ĝ k := fun k => fourierCoeff_liftIco_eq G k
  have hsum' : Summable (fourierCoeff Gc) := by
    have : fourierCoeff Gc = ĝ := funext hcoef
    rw [this]; exact hsum
  set e : ℤ → ℝ → ℂ := fun k y => Complex.exp (2 * Real.pi * Complex.I * k * y / r)
  have hpt : ∀ y ∈ Set.Ico a (a + r), HasSum (fun k => ĝ k * e k y) (G y) := by
    intro y hy
    have h := has_pointwise_sum_fourier_series_of_summable hsum' (y : AddCircle r)
    have hG' : Gc (y : AddCircle r) = G y := AddCircle.liftIco_coe_apply hy
    rw [hG'] at h
    convert h using 1
    funext k
    rw [hcoef, smul_eq_mul, fourier_coe_apply]
  have he : ∀ k y, ‖e k y‖ = 1 := fun k y => by
    simp only [e]
    rw [Complex.norm_exp]
    have : (2 * Real.pi * Complex.I * k * y / r).re = 0 := by
      simp [Complex.div_re, Complex.mul_re, Complex.mul_im]
    rw [this, Real.exp_zero]
  have hec : ∀ k, Continuous (e k) := fun k => by
    simp only [e]; fun_prop
  set μ := volume.restrict (Set.Ico a (a + r))
  have hFi : ∀ k : ℤ, Integrable (fun y => S y * (ĝ k * e k y)) μ := fun k =>
    hS.mul_bdd ((continuous_const.mul (hec k)).aestronglyMeasurable) (Filter.Eventually.of_forall
      fun y => by rw [norm_mul, he, mul_one])
  have hFn : ∀ k : ℤ, ∫ y, ‖S y * (ĝ k * e k y)‖ ∂μ = ‖ĝ k‖ * ∫ y, ‖S y‖ ∂μ := fun k => by
    rw [← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
    simp only [norm_mul, he, mul_one]; ring
  have hsumn : Summable fun k : ℤ => ∫ y, ‖S y * (ĝ k * e k y)‖ ∂μ := by
    simp_rw [hFn]; exact hsum.norm.mul_right _
  have h := hasSum_integral_of_summable_integral_norm hFi hsumn
  have htsum : ∫ y, (∑' k, S y * (ĝ k * e k y)) ∂μ = ∫ y, S y * G y ∂μ := by
    refine setIntegral_congr_fun measurableSet_Ico fun y hy => ?_
    rw [tsum_mul_left, (hpt y hy).tsum_eq]
  rw [htsum] at h
  convert h using 1
  funext k
  rw [← integral_const_mul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  ring

section AnchorFourier
variable {κ : LocalKernelClass} {a₀ r : ℝ} {w : ℝ × ℝ → ℂ}

/-- The anchor function vanishes outside the open cell. -/
theorem anchorFn_eq_zero (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4)
    (B : ℝ) {y : ℝ} (hy : y ∉ Set.Ioo a₀ (a₀ + r)) : anchorFn w l B y = 0 := by
  unfold anchorFn
  have hm := mul_pos κ.margin_pos hr
  refine integral_eq_zero_of_ae (Filter.Eventually.of_forall fun t => ?_)
  by_contra hne
  have hz : w (y - ((l : ℕ) : ℝ) * t, t) ≠ 0 := left_ne_zero_of_mul hne
  have := hw.support _ hz l
  simp only [realProgressionCoordinate] at this
  apply hy
  constructor <;> nlinarith [this.1, this.2]

/-- The anchor function as an integral over `[-r, r]`. -/
theorem anchorFn_eq_Icc (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4)
    (B y : ℝ) : anchorFn w l B y = ∫ t in Set.Icc (-r) r,
      w (y - ((l : ℕ) : ℝ) * t, t) * (Real.fourierChar (B * t) : ℂ) := by
  unfold anchorFn
  rw [← integral_indicator measurableSet_Icc]
  refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
  by_cases ht : t ∈ Set.Icc (-r) r
  · rw [Set.indicator_of_mem ht]
  · rw [Set.indicator_of_notMem ht]
    have hz : w (y - ((l : ℕ) : ℝ) * t, t) = 0 := by
      by_contra hne
      exact ht (abs_le.mp (admissible_shear_support hr hw l hne).2)
    simp [hz]

theorem continuous_anchorFn (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4)
    (B : ℝ) : Continuous (anchorFn w l B) := by
  have h : Continuous fun y => ∫ t in Set.Icc (-r) r,
      w (y - ((l : ℕ) : ℝ) * t, t) * (Real.fourierChar (B * t) : ℂ) :=
    continuous_parametric_integral_of_continuous (by
      refine (hw.smooth.continuous.comp (by fun_prop)).mul ?_
      exact continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop)))
      isCompact_Icc
  convert h using 1
  funext y
  exact anchorFn_eq_Icc hr hw l B y

open Classical in
/-- Blueprint lines 2540-2556 (the pairing entries): the Fourier coefficient of
`G(y) = e(α (y - x₀)) W_β(y)` on the cell `[a₀, a₀ + r)` at `k` is
`r e(-α x₀ + A (a₀ + r/2)) WFourier(-r A, -r (l A + β))` with `A = α - k/r`. -/
theorem fourierCoeffOn_anchor (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4)
    (α β x₀ : ℝ) (k : ℤ) :
    fourierCoeffOn (lt_add_of_pos_right a₀ hr)
        (fun y => (Real.fourierChar (α * (y - x₀)) : ℂ) * anchorFn w l β y) k =
      r * ((Real.fourierChar (-(α * x₀) + (α - k / r) * (a₀ + r / 2)) : ℂ) *
        kernelFT (unitKernel a₀ r w) (-(r * (α - k / r)))
          (-(r * (((l : ℕ) : ℝ) * (α - k / r) + β)))) := by
  have : Fact (0 < r) := ⟨hr⟩
  have hwi := admissible_integrable hr hw
  set L : ℝ := ((l : ℕ) : ℝ)
  set A := α - k / r
  set G : ℝ → ℂ := fun y => (Real.fourierChar (α * (y - x₀)) : ℂ) * anchorFn w l β y
  have hGc : Continuous G := (continuous_subtype_val.comp
    (Real.continuous_fourierChar.comp (by fun_prop))).mul (continuous_anchorFn hr hw l β)
  have hG0 : ∀ y, y ∉ Set.Ioo a₀ (a₀ + r) → G y = 0 := fun y hy => by
    simp only [G, anchorFn_eq_zero hr hw l β hy, mul_zero]
  rw [fourierCoeffOn_eq_integral]
  have hTr : a₀ + r - a₀ = r := by ring
  -- the interval integral as a plane integral
  set Φ : ℝ × ℝ → ℂ := fun q => w (q.1 - L * q.2, q.2) *
    (Real.fourierChar (β * q.2) : ℂ) * ((Real.fourierChar (α * (q.1 - x₀)) : ℂ) *
      (Real.fourierChar (-(k / r) * q.1) : ℂ))
  have hchar : ∀ y : ℝ, fourier (-k) (y : AddCircle (a₀ + r - a₀)) =
      (Real.fourierChar (-(k / r) * y) : ℂ) := by
    intro y
    rw [fourier_coe_apply, Real.fourierChar_apply, hTr]
    congr 1; push_cast; ring
  have hΦi : Integrable Φ := by
    have hT := (measurePreserving_planeShear (-L)).integrable_comp_emb
      (planeShear (-L)).measurableEmbedding (g := fun z => w z * ((Real.fourierChar (β * z.2) :
        ℂ) * ((Real.fourierChar (α * (z.1 + L * z.2 - x₀)) : ℂ) *
          (Real.fourierChar (-(k / r) * (z.1 + L * z.2)) : ℂ))))
    have hb : Integrable (fun z : ℝ × ℝ => w z * ((Real.fourierChar (β * z.2) : ℂ) *
        ((Real.fourierChar (α * (z.1 + L * z.2 - x₀)) : ℂ) *
          (Real.fourierChar (-(k / r) * (z.1 + L * z.2)) : ℂ)))) :=
      hwi.mul_bdd (Continuous.aestronglyMeasurable (by
        refine (continuous_subtype_val.comp (Real.continuous_fourierChar.comp ?_)).mul
          ((continuous_subtype_val.comp (Real.continuous_fourierChar.comp ?_)).mul
            (continuous_subtype_val.comp (Real.continuous_fourierChar.comp ?_))) <;> fun_prop))
        (Filter.Eventually.of_forall fun z => le_of_eq (by
          rw [norm_mul, norm_mul, Circle.norm_coe, Circle.norm_coe, Circle.norm_coe]))
    refine (hT.mpr hb).congr (Filter.Eventually.of_forall fun q => ?_)
    simp only [Function.comp, planeShear, MeasurableEquiv.coe_mk, Equiv.coe_fn_mk, Φ]
    have e : q.1 + -L * q.2 + L * q.2 = q.1 := by ring
    rw [show q.1 + -L * q.2 = q.1 - L * q.2 by ring] at e ⊢
    rw [e]; ring
  have hstep1 : ∫ y in a₀..a₀ + r, fourier (-k) (y : AddCircle (a₀ + r - a₀)) • G y =
      ∫ q, Φ q := by
    rw [intervalIntegral.integral_of_le (by linarith), ← integral_indicator measurableSet_Ioc,
      MeasureTheory.Measure.volume_eq_prod, integral_prod _ (by
        rw [← MeasureTheory.Measure.volume_eq_prod]; exact hΦi)]
    refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
    simp only [Φ]
    by_cases hy : y ∈ Set.Ioc a₀ (a₀ + r)
    · rw [Set.indicator_of_mem hy, smul_eq_mul, hchar]
      simp only [G, anchorFn]
      rw [← integral_const_mul, ← integral_const_mul]
      refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
      simp only [L]; ring
    · rw [Set.indicator_of_notMem hy]
      have hy' : y ∉ Set.Ioo a₀ (a₀ + r) := fun h => hy ⟨h.1, h.2.le⟩
      have h0 := anchorFn_eq_zero hr hw l β hy'
      unfold anchorFn at h0
      have : ∫ t, Φ (y, t) = (Real.fourierChar (α * (y - x₀)) : ℂ) *
          (Real.fourierChar (-(k / r) * y) : ℂ) *
          ∫ t, w (y - ((l : ℕ) : ℝ) * t, t) * (Real.fourierChar (β * t) : ℂ) := by
        rw [← integral_const_mul]
        refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
        simp only [Φ, L]; ring
      rw [this, h0, mul_zero]
  -- back to the kernel
  have hstep2 : ∫ q, Φ q = ∫ z, w z * (Real.fourierChar (A * z.1 + (L * A + β) * z.2 +
      -(α * x₀)) : ℂ) := by
    rw [← (measurePreserving_planeShear (-L)).integral_comp' (fun z => w z *
      (Real.fourierChar (A * z.1 + (L * A + β) * z.2 + -(α * x₀)) : ℂ))]
    refine integral_congr_ae (Filter.Eventually.of_forall fun q => ?_)
    simp only [planeShear, MeasurableEquiv.coe_mk, Equiv.coe_fn_mk, Φ]
    rw [show q.1 + -L * q.2 = q.1 - L * q.2 by ring, mul_assoc, ← Circle.coe_mul,
      ← Circle.coe_mul, ← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul]
    congr 3
    simp only [A]; ring
  rw [hstep1, hstep2]
  have hfl := form_linear_phase (a₀ := a₀) hr hwi A (L * A + β) (-(α * x₀))
  have hr0 : (r : ℂ) ≠ 0 := by exact_mod_cast hr.ne'
  rw [Complex.real_smul, hTr]
  have e : ∫ z, w z * (Real.fourierChar (A * z.1 + (L * A + β) * z.2 + -(α * x₀)) : ℂ) =
      (r : ℂ) ^ 2 * ((Real.fourierChar (-(α * x₀) + A * (a₀ + r / 2)) : ℂ) *
        kernelFT (unitKernel a₀ r w) (-(r * A)) (-(r * (L * A + β)))) := by
    rw [← hfl]; field_simp
  rw [e]
  push_cast
  field_simp

end AnchorFourier

/-- `Σ_{k ∈ ℤ} max(1, |k - c|)^{-2} < ∞`. -/
theorem summable_inv_max_sq (c : ℝ) :
    Summable fun k : ℤ => (max 1 |(k : ℝ) - c| ^ 2)⁻¹ := by
  refine Summable.of_norm_bounded_eventually (g := fun k : ℤ => 4 * (1 / (k : ℝ) ^ 2)) ?_ ?_
  · exact (Real.summable_one_div_int_pow (p := 2)).mpr (by norm_num) |>.mul_left _
  · obtain ⟨N, hN⟩ := exists_nat_gt (2 * |c|)
    refine Filter.eventually_cofinite.mpr ((Set.finite_Icc (-(N : ℤ)) N).subset fun k hk => ?_)
    simp only [Set.mem_ofPred_eq, not_le] at hk
    by_contra hkN
    simp only [Set.mem_Icc, not_and_or, not_le] at hkN
    have hk2 : (N : ℝ) < |(k : ℝ)| := by
      rcases hkN with h | h
      · have : (k : ℝ) < -(N : ℝ) := by exact_mod_cast h
        rw [abs_of_neg (by linarith [Nat.cast_nonneg (α := ℝ) N])]; linarith
      · have : (N : ℝ) < (k : ℝ) := by exact_mod_cast h
        rw [abs_of_pos (by linarith [Nat.cast_nonneg (α := ℝ) N])]; exact this
    have hkpos : 0 < |(k : ℝ)| := lt_of_le_of_lt (Nat.cast_nonneg _) hk2
    have hc : |c| < |(k : ℝ)| / 2 := by linarith
    have hkc : |(k : ℝ)| / 2 ≤ |(k : ℝ) - c| := by
      have := abs_sub_abs_le_abs_sub (k : ℝ) c; linarith
    have hm : (|(k : ℝ)| / 2) ^ 2 ≤ max 1 |(k : ℝ) - c| ^ 2 :=
      (pow_le_pow_left₀ (by positivity) hkc 2).trans
        (pow_le_pow_left₀ (abs_nonneg _) (le_max_right _ _) 2)
    apply hk.not_ge
    rw [Real.norm_eq_abs, abs_of_pos (by positivity)]
    rw [show 4 * (1 / (k : ℝ) ^ 2) = ((|(k : ℝ)| / 2) ^ 2)⁻¹ by
      rw [div_pow, ← sq_abs (k : ℝ)]; field_simp; ring]
    exact inv_anti₀ (by positivity) hm

section AnchorPairing
variable {κ : LocalKernelClass} {a₀ r : ℝ} {w : ℝ × ℝ → ℂ}

/-- The kernel decay constant at order two of `admissible_kernel_decay'`. -/
noncomputable def kerC2 (κ : LocalKernelClass) : ℝ :=
  2 * (2 * 4 * (2 * 4 * (kernelDerivBound κ 0 + ((2 * Real.pi) ^ 2)⁻¹ * kernelDerivBound κ 2))) +
    (3 + 2) ^ 2 * (2 * 4 * (2 * Real.pi * 4 * (2 * (4 + 3 * 4) * (kernelDerivBound κ 0 +
      ((2 * Real.pi) ^ 2)⁻¹ * kernelDerivBound κ 2))))

/-- Order-two decay of the unit kernel transform: `|WFourier(q, t)| ≤ C₂ max(1, |q|)^{-2}`. -/
theorem kernelFT_le_kerC2 (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (q t : ℝ) :
    ‖kernelFT (unitKernel a₀ r w) q t‖ ≤ kerC2 κ * (max 1 |q| ^ 2)⁻¹ := by
  have h := admissible_kernel_decay hr hw 2 q t
  have hν : 0 < max 1 (max |q| |t|) ^ 2 := pow_pos (lt_of_lt_of_le one_pos (le_max_left _ _)) _
  have hmin : min 1 (((Finset.univ : Finset (Fin 4)).image fun j : Fin 4 => (j : ℝ)).inf'
      ⟨0, Finset.mem_image.mpr ⟨0, Finset.mem_univ _, by simp⟩⟩ fun j => |t - j * q|) ≤ 1 :=
    min_le_left _ _
  have hC0 : 0 ≤ kerC2 κ := by
    unfold kerC2
    have h0 : 0 ≤ kernelDerivBound κ 0 := (norm_nonneg _).trans
      ((unitKernel_bounds hr hw).dx 0 0 0)
    have h2 : 0 ≤ kernelDerivBound κ 2 := (norm_nonneg _).trans
      ((unitKernel_bounds hr hw).dx 2 0 0)
    positivity
  have h1 : ‖kernelFT (unitKernel a₀ r w) q t‖ * max 1 (max |q| |t|) ^ 2 ≤ kerC2 κ := by
    refine h.trans ?_
    have := mul_le_mul_of_nonneg_left hmin hC0
    simpa [kerC2] using this
  have hqm : max 1 |q| ^ 2 ≤ max 1 (max |q| |t|) ^ 2 :=
    pow_le_pow_left₀ (le_trans zero_le_one (le_max_left _ _))
      (max_le_max le_rfl (le_max_left _ _)) 2
  have hq0 : 0 < max 1 |q| ^ 2 := pow_pos (lt_of_lt_of_le one_pos (le_max_left _ _)) _
  rw [← div_eq_mul_inv, le_div_iff₀ hq0]
  calc ‖kernelFT (unitKernel a₀ r w) q t‖ * max 1 |q| ^ 2 ≤
      ‖kernelFT (unitKernel a₀ r w) q t‖ * max 1 (max |q| |t|) ^ 2 :=
        mul_le_mul_of_nonneg_left hqm (norm_nonneg _)
    _ ≤ kerC2 κ := h1

open Classical in
/-- Blueprint lines 2549-2556 for one tuple term: the anchor pairing
`r⁻² ∫ S(y) e(α (y - x₀)) W_β(y) dy` of a function integrable on the cell is the convergent sum over
`k ∈ ℤ` of `r⁻¹ e(...) WFourier(-r(α - k/r), -r(l(α - k/r) + β)) s_k`, `s_k = ∫_I S(y) e(k y/r)
  dy`. -/
theorem anchor_pairing_expand (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4)
    (S : ℝ → ℂ) (hS : IntegrableOn S (Set.Ico a₀ (a₀ + r))) (α β x₀ : ℝ) :
    HasSum (fun k : ℤ => (r : ℂ)⁻¹ * ((Real.fourierChar (-(α * x₀) + (α - k / r) *
        (a₀ + r / 2)) : ℂ) * kernelFT (unitKernel a₀ r w) (-(r * (α - k / r)))
          (-(r * (((l : ℕ) : ℝ) * (α - k / r) + β)))) *
        ∫ y in Set.Ico a₀ (a₀ + r), S y * Complex.exp (2 * Real.pi * Complex.I * k * y / r))
      ((r : ℂ)⁻¹ ^ 2 * ∫ y, S y * ((Real.fourierChar (α * (y - x₀)) : ℂ) *
        anchorFn w l β y)) := by
  set G : ℝ → ℂ := fun y => (Real.fourierChar (α * (y - x₀)) : ℂ) * anchorFn w l β y
  have hGc : Continuous G := (continuous_subtype_val.comp
    (Real.continuous_fourierChar.comp (by fun_prop))).mul (continuous_anchorFn hr hw l β)
  have hG0 : ∀ y, y ∉ Set.Ioo a₀ (a₀ + r) → G y = 0 := fun y hy => by
    simp only [G, anchorFn_eq_zero hr hw l β hy, mul_zero]
  have hGa : G a₀ = G (a₀ + r) := by
    rw [hG0 a₀ (fun h => lt_irrefl _ h.1), hG0 (a₀ + r) (fun h => lt_irrefl _ h.2)]
  have hcoef := fun k => fourierCoeffOn_anchor (a₀ := a₀) hr hw l α β x₀ k
  have hsum : Summable (fourierCoeffOn (lt_add_of_pos_right a₀ hr) G) := by
    refine Summable.of_norm_bounded (g := fun k : ℤ => r * kerC2 κ *
      (max 1 |(k : ℝ) - r * α| ^ 2)⁻¹) ((summable_inv_max_sq (r * α)).mul_left _) fun k => ?_
    rw [hcoef k, norm_mul, norm_mul, Circle.norm_coe, one_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hr, mul_assoc]
    refine mul_le_mul_of_nonneg_left ((kernelFT_le_kerC2 hr hw _ _).trans (le_of_eq ?_)) hr.le
    congr 3
    rw [abs_neg, show r * (α - k / r) = r * α - k by field_simp, abs_sub_comm]
  have h := interval_fourier_pairing hr S hS G hGc hGa hsum
  have hint : ∫ y, S y * G y = ∫ y in Set.Ico a₀ (a₀ + r), S y * G y := by
    rw [← integral_indicator measurableSet_Ico]
    refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
    by_cases hy : y ∈ Set.Ico a₀ (a₀ + r)
    · rw [Set.indicator_of_mem hy]
    · rw [Set.indicator_of_notMem hy]
      change S y * G y = 0
      rw [hG0 y (fun h => hy ⟨h.1.le, h.2⟩), mul_zero]
  rw [hint]
  have h2 := h.mul_left ((r : ℂ)⁻¹ ^ 2)
  convert h2 using 1
  funext k
  rw [hcoef k]
  have hr0 : (r : ℂ) ≠ 0 := by exact_mod_cast hr.ne'
  field_simp

end AnchorPairing

/-- `Σ_{j ∈ ℤ} (1 + |j|)^{-2} = π²/3 - 1`. -/
theorem hasSum_inv_one_add_abs_sq :
    HasSum (fun j : ℤ => 1 / (1 + |(j : ℝ)|) ^ 2) (Real.pi ^ 2 / 6 + (Real.pi ^ 2 / 6 - 1)) := by
  have hz := hasSum_zeta_two
  have h1 : HasSum (fun n : ℕ => 1 / ((n + 1 : ℕ) : ℝ) ^ 2) (Real.pi ^ 2 / 6) := by
    have := (hasSum_nat_add_iff' 1).mpr hz
    simpa using this
  have h2 : HasSum (fun n : ℕ => 1 / ((n + 2 : ℕ) : ℝ) ^ 2) (Real.pi ^ 2 / 6 - 1) := by
    have := (hasSum_nat_add_iff' 2).mpr hz
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.cast_zero, Nat.cast_one] at this
    norm_num at this
    simpa using this
  refine HasSum.of_nat_of_neg_add_one ?_ ?_
  · convert h1 using 1
    funext n
    push_cast
    rw [abs_of_nonneg (Nat.cast_nonneg _), add_comm]
  · convert h2 using 1
    funext n
    push_cast
    rw [abs_neg, abs_of_nonneg (by positivity)]
    ring_nf

/-- A uniform bound: `Σ_{k ∈ ℤ} max(1, |k - c|)^{-2} ≤ 12` for every real `c`. -/
theorem tsum_inv_max_sq_le (c : ℝ) :
    ∑' k : ℤ, (max 1 |(k : ℝ) - c| ^ 2)⁻¹ ≤ 12 := by
  set m : ℤ := round c
  have hmc : |c - m| ≤ 1 / 2 := abs_sub_round c
  have hpt : ∀ k : ℤ, (max 1 |(k : ℝ) - c| ^ 2)⁻¹ ≤ 4 * (1 / (1 + |((k - m : ℤ) : ℝ)|) ^ 2) := by
    intro k
    have hge : (1 + |((k - m : ℤ) : ℝ)|) / 2 ≤ max 1 |(k : ℝ) - c| := by
      push_cast
      rcases le_or_gt |(k : ℝ) - m| 1 with h | h
      · exact le_trans (by linarith) (le_max_left _ _)
      · have h' : 2 ≤ |(k : ℝ) - m| := by
          have : ((k - m : ℤ) : ℝ) = (k : ℝ) - m := by push_cast; ring
          have hint : (1 : ℤ) < |k - m| := by
            have : (1 : ℝ) < |((k - m : ℤ) : ℝ)| := by rw [this]; exact h
            exact_mod_cast this
          have : (2 : ℤ) ≤ |k - m| := hint
          have h2 : (2 : ℝ) ≤ |((k - m : ℤ) : ℝ)| := by exact_mod_cast this
          rwa [show ((k - m : ℤ) : ℝ) = (k : ℝ) - m by push_cast; ring] at h2
        have : |(k : ℝ) - m| - 1 / 2 ≤ |(k : ℝ) - c| := by
          have := abs_sub_abs_le_abs_sub ((k : ℝ) - m) (c - m)
          rw [show (k : ℝ) - m - (c - m) = k - c by ring] at this
          linarith
        exact le_trans (by linarith) (le_max_right _ _)
    have hp : 0 < (1 + |((k - m : ℤ) : ℝ)|) / 2 := by positivity
    calc (max 1 |(k : ℝ) - c| ^ 2)⁻¹ ≤ (((1 + |((k - m : ℤ) : ℝ)|) / 2) ^ 2)⁻¹ :=
          inv_anti₀ (by positivity) (pow_le_pow_left₀ hp.le hge 2)
      _ = 4 * (1 / (1 + |((k - m : ℤ) : ℝ)|) ^ 2) := by field_simp; ring
  have hs := hasSum_inv_one_add_abs_sq
  have hs' : HasSum (fun k : ℤ => 4 * (1 / (1 + |((k - m : ℤ) : ℝ)|) ^ 2))
      (4 * (Real.pi ^ 2 / 6 + (Real.pi ^ 2 / 6 - 1))) :=
    ((Equiv.subRight m).hasSum_iff.mpr hs).mul_left 4
  have hsum := summable_inv_max_sq c
  calc ∑' k : ℤ, (max 1 |(k : ℝ) - c| ^ 2)⁻¹ ≤
      4 * (Real.pi ^ 2 / 6 + (Real.pi ^ 2 / 6 - 1)) := by
        rw [← hs'.tsum_eq]; exact hsum.tsum_le_tsum hpt hs'.summable
    _ ≤ 12 := by
        have h1 := Real.pi_lt_d2
        have h2 := Real.pi_pos
        nlinarith

section KernelKSums
variable {κ : LocalKernelClass} {a₀ r : ℝ} {w : ℝ × ℝ → ℂ}

/-- The decay constant of order `J` of `admissible_kernel_decay`. -/
noncomputable def kerC (κ : LocalKernelClass) (J : ℕ) : ℝ :=
  2 * (2 * 4 * (2 * 4 * (kernelDerivBound κ 0 +
    ((2 * Real.pi) ^ J)⁻¹ * kernelDerivBound κ J))) + (3 + 2) ^ J *
    (2 * 4 * (2 * Real.pi * 4 * (2 * (4 + 3 * 4) * (kernelDerivBound κ 0 +
      ((2 * Real.pi) ^ J)⁻¹ * kernelDerivBound κ J))))

theorem kerC_nonneg (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (J : ℕ) :
    0 ≤ kerC κ J := by
  unfold kerC
  have h0 : 0 ≤ kernelDerivBound κ 0 := (norm_nonneg _).trans ((unitKernel_bounds hr hw).dx 0 0 0)
  have hJ : 0 ≤ kernelDerivBound κ J := (norm_nonneg _).trans ((unitKernel_bounds hr hw).dx J 0 0)
  positivity

/-- Decay of order `J`: `|WFourier(q, t)| max(1, |q|, |t|)^J ≤ C_J`. -/
theorem kernelFT_mul_le_kerC (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (J : ℕ)
    (q t : ℝ) :
    ‖kernelFT (unitKernel a₀ r w) q t‖ * max 1 (max |q| |t|) ^ J ≤ kerC κ J := by
  refine (admissible_kernel_decay hr hw J q t).trans ?_
  have hmin : min 1 (((Finset.univ : Finset (Fin 4)).image fun j : Fin 4 => (j : ℝ)).inf'
      ⟨0, Finset.mem_image.mpr ⟨0, Finset.mem_univ _, by simp⟩⟩ fun j => |t - j * q|) ≤ 1 :=
    min_le_left _ _
  have := mul_le_mul_of_nonneg_left hmin (kerC_nonneg hr hw J)
  simpa [kerC] using this

/-- Blueprint lines 2523-2526 ("other cosets have rapidly decreasing Fourier tails") summed over
the cell frequencies: if `|b| ≥ 4` and `J ≥ 2`, then
`Σ_k |WFourier(k - c, l (k - c) - b)| ≤ 12 C_J (4/|b|)^{J-2}`. -/
theorem far_ksum (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4) {J : ℕ}
    (hJ : 2 ≤ J) (c b : ℝ) (hb : 4 ≤ |b|) :
    Summable (fun k : ℤ => ‖kernelFT (unitKernel a₀ r w) (k - c)
        (((l : ℕ) : ℝ) * (k - c) - b)‖) ∧
      ∑' k : ℤ, ‖kernelFT (unitKernel a₀ r w) (k - c) (((l : ℕ) : ℝ) * (k - c) - b)‖ ≤
        12 * (kerC κ J * (4 / |b|) ^ (J - 2)) := by
  have hl3 : ((l : ℕ) : ℝ) ≤ 3 := by
    have := l.isLt; exact_mod_cast (by omega : (l : ℕ) ≤ 3)
  have hl0 : (0 : ℝ) ≤ ((l : ℕ) : ℝ) := Nat.cast_nonneg _
  have hC := kerC_nonneg hr hw J
  have hpt : ∀ k : ℤ, ‖kernelFT (unitKernel a₀ r w) (k - c) (((l : ℕ) : ℝ) * (k - c) - b)‖ ≤
      kerC κ J * (4 / |b|) ^ (J - 2) * (max 1 |(k : ℝ) - c| ^ 2)⁻¹ := by
    intro k
    set q : ℝ := (k : ℝ) - c
    set t : ℝ := ((l : ℕ) : ℝ) * q - b
    set M := max 1 (max |q| |t|)
    have hM1 : 1 ≤ M := le_max_left _ _
    have hMb : |b| / 4 ≤ M := by
      rcases le_or_gt (|b| / 4) |q| with h | h
      · exact h.trans ((le_max_left _ _).trans (le_max_right _ _))
      · have ht : |b| / 4 ≤ |t| := by
          have : |b| ≤ |t| + ((l : ℕ) : ℝ) * |q| := by
            have h1 : b = ((l : ℕ) : ℝ) * q - t := by simp only [t]; ring
            rw [h1]
            calc |((l : ℕ) : ℝ) * q - t| ≤ |((l : ℕ) : ℝ) * q| + |t| := abs_sub _ _
              _ = |t| + ((l : ℕ) : ℝ) * |q| := by rw [abs_mul, abs_of_nonneg hl0]; ring
          nlinarith [abs_nonneg q]
        exact ht.trans ((le_max_right _ _).trans (le_max_right _ _))
    have hMq : max 1 |q| ≤ M := max_le_max le_rfl (le_max_left _ _)
    have hdec := kernelFT_mul_le_kerC hr hw J q t
    have hb0 : 0 < |b| := by linarith
    have hpow : (|b| / 4) ^ (J - 2) * max 1 |q| ^ 2 ≤ M ^ J := by
      have e : M ^ J = M ^ (J - 2) * M ^ 2 := by rw [← pow_add]; congr 1; omega
      rw [e]
      exact mul_le_mul (pow_le_pow_left₀ (by positivity) hMb _)
        (pow_le_pow_left₀ (by positivity) hMq _) (by positivity) (by positivity)
    have hpos : 0 < (|b| / 4) ^ (J - 2) * max 1 |q| ^ 2 := by
      have : 0 < max 1 |q| := lt_of_lt_of_le one_pos (le_max_left _ _)
      positivity
    have h4 : (4 / |b|) ^ (J - 2) = ((|b| / 4) ^ (J - 2))⁻¹ := by
      rw [← inv_pow, inv_div]
    rw [h4, mul_assoc, ← mul_inv, ← div_eq_mul_inv, le_div_iff₀ hpos]
    calc ‖kernelFT (unitKernel a₀ r w) q t‖ * ((|b| / 4) ^ (J - 2) * max 1 |q| ^ 2) ≤
        ‖kernelFT (unitKernel a₀ r w) q t‖ * M ^ J :=
          mul_le_mul_of_nonneg_left hpow (norm_nonneg _)
      _ ≤ kerC κ J := hdec
  have hs := (summable_inv_max_sq c).mul_left (kerC κ J * (4 / |b|) ^ (J - 2))
  have hsum : Summable (fun k : ℤ => ‖kernelFT (unitKernel a₀ r w) (k - c)
      (((l : ℕ) : ℝ) * (k - c) - b)‖) :=
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hpt hs
  refine ⟨hsum, ?_⟩
  calc ∑' k : ℤ, ‖kernelFT (unitKernel a₀ r w) (k - c) (((l : ℕ) : ℝ) * (k - c) - b)‖ ≤
      ∑' k : ℤ, kerC κ J * (4 / |b|) ^ (J - 2) * (max 1 |(k : ℝ) - c| ^ 2)⁻¹ :=
        hsum.tsum_le_tsum hpt hs
    _ = kerC κ J * (4 / |b|) ^ (J - 2) * ∑' k : ℤ, (max 1 |(k : ℝ) - c| ^ 2)⁻¹ := tsum_mul_left
    _ ≤ kerC κ J * (4 / |b|) ^ (J - 2) * 12 :=
        mul_le_mul_of_nonneg_left (tsum_inv_max_sq_le c) (by positivity)
    _ = _ := by ring

/-- `min(a, u + v) ≤ √a (√u + √v)` for nonnegative reals. -/
theorem min_le_sqrt_mul_add {a u v : ℝ} (ha : 0 ≤ a) (hu : 0 ≤ u) (hv : 0 ≤ v) :
    min a (u + v) ≤ Real.sqrt a * (Real.sqrt u + Real.sqrt v) := by
  have h1 : min a (u + v) ≤ Real.sqrt (a * (u + v)) := by
    rw [Real.le_sqrt (le_min ha (by positivity)) (by positivity)]
    rcases le_total a (u + v) with h | h
    · rw [min_eq_left h, sq]; exact mul_le_mul_of_nonneg_left h ha
    · rw [min_eq_right h, sq]; exact mul_le_mul_of_nonneg_right h (by positivity)
  refine h1.trans ?_
  rw [Real.sqrt_mul ha]
  refine mul_le_mul_of_nonneg_left ?_ (Real.sqrt_nonneg _)
  rw [Real.sqrt_le_left (by positivity)]
  nlinarith [Real.sq_sqrt hu, Real.sq_sqrt hv, Real.sqrt_nonneg u, Real.sqrt_nonneg v]

/-- Blueprint lines 2523-2526 ("their frequencies differ by a tiny quantity, so replace the
Fourier values by the reference value") summed over the cell frequencies: with the Lipschitz
constant `L_W` of the unit kernel transform and `δ = 4|c - c'| + |b - b'|`,
`Σ_k |WFourier(k - c, l(k - c) - b) - WFourier(k - c', l(k - c') - b')| ≤ 24 √(L_W δ C₄)`. -/
theorem near_ksum (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4)
    (c b c' b' : ℝ) :
    Summable (fun k : ℤ => ‖kernelFT (unitKernel a₀ r w) (k - c) (((l : ℕ) : ℝ) * (k - c) - b) -
        kernelFT (unitKernel a₀ r w) (k - c') (((l : ℕ) : ℝ) * (k - c') - b')‖) ∧
      ∑' k : ℤ, ‖kernelFT (unitKernel a₀ r w) (k - c) (((l : ℕ) : ℝ) * (k - c) - b) -
        kernelFT (unitKernel a₀ r w) (k - c') (((l : ℕ) : ℝ) * (k - c') - b')‖ ≤
        24 * Real.sqrt (2 * 4 * (2 * 4 * (2 * Real.pi * 4 * (4 * |c - c'| + |b - b'|) *
          kernelDerivBound κ 0))) * Real.sqrt (kerC κ 4) := by
  have hl3 : ((l : ℕ) : ℝ) ≤ 3 := by
    have := l.isLt; exact_mod_cast (by omega : (l : ℕ) ≤ 3)
  have hl0 : (0 : ℝ) ≤ ((l : ℕ) : ℝ) := Nat.cast_nonneg _
  have hA0 : 0 ≤ kernelDerivBound κ 0 :=
    (norm_nonneg _).trans ((unitKernel_bounds hr hw).dx 0 0 0)
  set a := 2 * 4 * (2 * 4 * (2 * Real.pi * 4 * (4 * |c - c'| + |b - b'|) *
    kernelDerivBound κ 0))
  have ha : 0 ≤ a := by positivity
  set C4 := kerC κ 4
  have hC4 := kerC_nonneg hr hw 4
  -- the order-four decay in the first variable
  have hdec : ∀ q t : ℝ, ‖kernelFT (unitKernel a₀ r w) q t‖ ≤ C4 * (max 1 |q| ^ 4)⁻¹ := by
    intro q t
    have h := kernelFT_mul_le_kerC hr hw 4 q t
    have hq : max 1 |q| ^ 4 ≤ max 1 (max |q| |t|) ^ 4 :=
      pow_le_pow_left₀ (le_trans zero_le_one (le_max_left _ _))
        (max_le_max le_rfl (le_max_left _ _)) 4
    have hq0 : 0 < max 1 |q| ^ 4 := pow_pos (lt_of_lt_of_le one_pos (le_max_left _ _)) _
    rw [← div_eq_mul_inv, le_div_iff₀ hq0]
    exact (mul_le_mul_of_nonneg_left hq (norm_nonneg _)).trans h
  set g : ℤ → ℝ := fun k => Real.sqrt a * Real.sqrt C4 *
    ((max 1 |(k : ℝ) - c| ^ 2)⁻¹ + (max 1 |(k : ℝ) - c'| ^ 2)⁻¹)
  have hpt : ∀ k : ℤ, ‖kernelFT (unitKernel a₀ r w) (k - c) (((l : ℕ) : ℝ) * (k - c) - b) -
      kernelFT (unitKernel a₀ r w) (k - c') (((l : ℕ) : ℝ) * (k - c') - b')‖ ≤ g k := by
    intro k
    set d := ‖kernelFT (unitKernel a₀ r w) (k - c) (((l : ℕ) : ℝ) * (k - c) - b) -
      kernelFT (unitKernel a₀ r w) (k - c') (((l : ℕ) : ℝ) * (k - c') - b')‖
    have hLip : d ≤ a := by
      refine ((unitKernel_bounds hr hw).kernelFT_lipschitz (by norm_num) _ _ _ _).trans ?_
      have hq : |((k : ℝ) - c) - ((k : ℝ) - c')| = |c - c'| := by
        rw [show ((k : ℝ) - c) - ((k : ℝ) - c') = -(c - c') by ring, abs_neg]
      have ht : |(((l : ℕ) : ℝ) * ((k : ℝ) - c) - b) - (((l : ℕ) : ℝ) * ((k : ℝ) - c') - b')| ≤
          3 * |c - c'| + |b - b'| := by
        rw [show (((l : ℕ) : ℝ) * ((k : ℝ) - c) - b) - (((l : ℕ) : ℝ) * ((k : ℝ) - c') - b') =
          -(((l : ℕ) : ℝ) * (c - c')) + -(b - b') by ring]
        refine (abs_add_le _ _).trans ?_
        rw [abs_neg, abs_neg, abs_mul, abs_of_nonneg hl0]
        gcongr
      simp only [a]
      rw [hq]
      have h3 : |c - c'| + |(((l : ℕ) : ℝ) * ((k : ℝ) - c) - b) -
          (((l : ℕ) : ℝ) * ((k : ℝ) - c') - b')| ≤ 4 * |c - c'| + |b - b'| := by
        linarith [ht, abs_nonneg (c - c')]
      gcongr
    have hdu : d ≤ C4 * (max 1 |(k : ℝ) - c| ^ 4)⁻¹ + C4 * (max 1 |(k : ℝ) - c'| ^ 4)⁻¹ :=
      (norm_sub_le _ _).trans (add_le_add (hdec _ _) (hdec _ _))
    have hmin : d ≤ min a (C4 * (max 1 |(k : ℝ) - c| ^ 4)⁻¹ +
        C4 * (max 1 |(k : ℝ) - c'| ^ 4)⁻¹) := le_min hLip hdu
    refine hmin.trans ((min_le_sqrt_mul_add ha (by positivity) (by positivity)).trans
      (le_of_eq ?_))
    have hs : ∀ x : ℝ, Real.sqrt (C4 * (max 1 |x| ^ 4)⁻¹) =
        Real.sqrt C4 * (max 1 |x| ^ 2)⁻¹ := by
      intro x
      have hm : 0 < max 1 |x| := lt_of_lt_of_le one_pos (le_max_left _ _)
      rw [Real.sqrt_mul hC4, show (max 1 |x| ^ 4)⁻¹ = ((max 1 |x| ^ 2)⁻¹) ^ 2 by
        rw [inv_pow, ← pow_mul], Real.sqrt_sq (by positivity)]
    rw [hs, hs]
    simp only [g]
    ring
  have hgs : Summable g :=
    ((summable_inv_max_sq c).add (summable_inv_max_sq c')).mul_left _
  have hsum := Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hpt hgs
  refine ⟨hsum, ?_⟩
  calc _ ≤ ∑' k, g k := hsum.tsum_le_tsum hpt hgs
    _ = Real.sqrt a * Real.sqrt C4 * (∑' k : ℤ, (max 1 |(k : ℝ) - c| ^ 2)⁻¹ +
        ∑' k : ℤ, (max 1 |(k : ℝ) - c'| ^ 2)⁻¹) := by
        simp only [g]
        rw [tsum_mul_left, (summable_inv_max_sq c).tsum_add (summable_inv_max_sq c')]
    _ ≤ Real.sqrt a * Real.sqrt C4 * (12 + 12) := by
        gcongr
        · exact tsum_inv_max_sq_le c
        · exact tsum_inv_max_sq_le c'
    _ = _ := by ring

end KernelKSums

/-- `Σ_k |WFourier(k - c, l(k - c) - b)| ≤ 12 C₂`. -/
theorem ksum_le {κ : LocalKernelClass} {a₀ r : ℝ} {w : ℝ × ℝ → ℂ} (hr : 0 < r)
    (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4) (c b : ℝ) :
    Summable (fun k : ℤ => ‖kernelFT (unitKernel a₀ r w) (k - c)
        (((l : ℕ) : ℝ) * (k - c) - b)‖) ∧
      ∑' k : ℤ, ‖kernelFT (unitKernel a₀ r w) (k - c) (((l : ℕ) : ℝ) * (k - c) - b)‖ ≤
        12 * kerC κ 2 := by
  have hpt : ∀ k : ℤ, ‖kernelFT (unitKernel a₀ r w) (k - c) (((l : ℕ) : ℝ) * (k - c) - b)‖ ≤
      kerC κ 2 * (max 1 |(k : ℝ) - c| ^ 2)⁻¹ := by
    intro k
    have h := kernelFT_mul_le_kerC hr hw 2 ((k : ℝ) - c) (((l : ℕ) : ℝ) * (k - c) - b)
    have hq : max 1 |(k : ℝ) - c| ^ 2 ≤ max 1 (max |(k : ℝ) - c|
        |((l : ℕ) : ℝ) * (k - c) - b|) ^ 2 :=
      pow_le_pow_left₀ (le_trans zero_le_one (le_max_left _ _))
        (max_le_max le_rfl (le_max_left _ _)) 2
    have hq0 : 0 < max 1 |(k : ℝ) - c| ^ 2 := pow_pos (lt_of_lt_of_le one_pos (le_max_left _ _)) _
    rw [← div_eq_mul_inv, le_div_iff₀ hq0]
    exact (mul_le_mul_of_nonneg_left hq (norm_nonneg _)).trans h
  have hs := (summable_inv_max_sq c).mul_left (kerC κ 2)
  have hsum := Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hpt hs
  refine ⟨hsum, ?_⟩
  calc _ ≤ ∑' k : ℤ, kerC κ 2 * (max 1 |(k : ℝ) - c| ^ 2)⁻¹ := hsum.tsum_le_tsum hpt hs
    _ = kerC κ 2 * ∑' k : ℤ, (max 1 |(k : ℝ) - c| ^ 2)⁻¹ := tsum_mul_left
    _ ≤ kerC κ 2 * 12 := mul_le_mul_of_nonneg_left (tsum_inv_max_sq_le c) (kerC_nonneg hr hw 2)
    _ = _ := by ring

section DualCoset
variable {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))

open Classical in
/-- Blueprint lines 2543-2549 ("only the reference `m` coset contributes ... collect horizontal
Fourier coefficients by cosets"): if `R(u, v) Π_{j ≠ l} g_j(u + (j - l) v)` has the character
expansion `Σ_x C_x χ_{n_x}(u) χ_{m_x}(v)` on `𝓗²`, the Haar coefficient of the dual slice `D_{m₀}`
at `n` is the coset sum `Σ_{n_x ∈ n + K_B, m_x ∈ m₀ + K_B} C_x`. -/
theorem dualSlice_coeff {ι : Type*} (P : Finset ι) (C : ι → ℂ)
    (fr : ι → (Fin d → ℤ) × (Fin d → ℤ))
    (Rm : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ) (l : Fin 4)
    (g : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℂ)
    (hexp : ∀ u v, Rm (u, v) * ∏ i ∈ Finset.univ.erase l, g i (u + ((i : ℤ) - (l : ℤ)) • v) =
      ∑ x ∈ P, C x * (torusCharacter (fr x).1 u * torusCharacter (fr x).2 v))
    (m₀ n : Fin d → ℤ) :
    (∫ u, dualSlice V Rm l g m₀ u * starRingEnd ℂ (torusCharacter n u)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) =
      ∑ x ∈ P, if (fr x).1 - n ∈ rationalIntegerIntersection V ∧
        (fr x).2 - m₀ ∈ rationalIntegerIntersection V then C x else 0 := by
  rw [← coset_sum_eq_haar' V P C fr (n, m₀)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
  simp only [dualSlice]
  rw [← integral_mul_const]
  refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
  simp only
  rw [hexp, Finset.sum_mul, Finset.sum_mul]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [torusCharacter_sub, torusCharacter_sub]; ring

end DualCoset

section ThreeCoreSplit
variable {κ : LocalKernelClass} {a₀ r : ℝ} {w : ℝ × ℝ → ℂ}

/-- The kernel sample of the anchor pairing at the cell frequency `k`. -/
noncomputable def anchorK (a₀ r : ℝ) (w : ℝ × ℝ → ℂ) (l : Fin 4) (x₀ α β : ℝ) (k : ℤ) : ℂ :=
  (Real.fourierChar (-(α * x₀) + (α - k / r) * (a₀ + r / 2)) : ℂ) *
    kernelFT (unitKernel a₀ r w) (-(r * (α - k / r))) (-(r * (((l : ℕ) : ℝ) * (α - k / r) + β)))

/-- The normalized anchor pairing `r⁻² ∫ S(y) e(α (y - x₀)) W_β(y) dy`. -/
noncomputable def anchorP (r : ℝ) (w : ℝ × ℝ → ℂ) (l : Fin 4) (S : ℝ → ℂ) (x₀ α β : ℝ) : ℂ :=
  (r : ℂ)⁻¹ ^ 2 * ∫ y, S y * ((Real.fourierChar (α * (y - x₀)) : ℂ) * anchorFn w l β y)

theorem anchorK_eq (hr : 0 < r) (l : Fin 4) (x₀ α β : ℝ) (k : ℤ) :
    anchorK a₀ r w l x₀ α β k = (Real.fourierChar (-(α * x₀) + (α - k / r) * (a₀ + r / 2)) : ℂ) *
      kernelFT (unitKernel a₀ r w) (k - r * α) (((l : ℕ) : ℝ) * (k - r * α) - r * β) := by
  unfold anchorK
  have hr0 : r ≠ 0 := hr.ne'
  congr 2
  · field_simp; ring
  · field_simp; ring

/-- The cell Fourier coefficients of the side are bounded by its `L¹` norm on the cell. -/
theorem norm_cellCoeff_le (S : ℝ → ℂ) (k : ℤ) :
    ‖∫ y in Set.Ico a₀ (a₀ + r), S y * Complex.exp (2 * Real.pi * Complex.I * k * y / r)‖ ≤
      ∫ y in Set.Ico a₀ (a₀ + r), ‖S y‖ := by
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  simp only
  rw [norm_mul, Complex.norm_exp]
  have : (2 * Real.pi * Complex.I * k * y / r).re = 0 := by
    simp [Complex.div_re, Complex.mul_re, Complex.mul_im]
  rw [this, Real.exp_zero, mul_one]

/-- The pairing of one tuple term against a reference: the anchor pairings differ by at most
`r⁻¹ ‖S‖_{L¹(I)} Σ_k |K(k) - K'(k)|`. -/
theorem anchorP_sub_le (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4)
    (S : ℝ → ℂ) (hS : IntegrableOn S (Set.Ico a₀ (a₀ + r))) (x₀ α β α' β' : ℝ)
    (hsum : Summable fun k : ℤ => ‖anchorK a₀ r w l x₀ α β k - anchorK a₀ r w l x₀ α' β' k‖) :
    ‖anchorP r w l S x₀ α β - anchorP r w l S x₀ α' β'‖ ≤
      r⁻¹ * (∫ y in Set.Ico a₀ (a₀ + r), ‖S y‖) *
        ∑' k : ℤ, ‖anchorK a₀ r w l x₀ α β k - anchorK a₀ r w l x₀ α' β' k‖ := by
  have h1 := anchor_pairing_expand hr hw l S hS α β x₀
  have h2 := anchor_pairing_expand hr hw l S hS α' β' x₀
  have hd := h1.sub h2
  set S1 := ∫ y in Set.Ico a₀ (a₀ + r), ‖S y‖
  have hS1 : 0 ≤ S1 := setIntegral_nonneg measurableSet_Ico fun _ _ => norm_nonneg _
  have hd' : HasSum (fun k : ℤ => (r : ℂ)⁻¹ * anchorK a₀ r w l x₀ α β k *
      (∫ y in Set.Ico a₀ (a₀ + r), S y * Complex.exp (2 * Real.pi * Complex.I * k * y / r)) -
      (r : ℂ)⁻¹ * anchorK a₀ r w l x₀ α' β' k *
      (∫ y in Set.Ico a₀ (a₀ + r), S y * Complex.exp (2 * Real.pi * Complex.I * k * y / r)))
      (anchorP r w l S x₀ α β - anchorP r w l S x₀ α' β') := hd
  rw [← hd'.tsum_eq]
  have hpt : ∀ k : ℤ, ‖(r : ℂ)⁻¹ * anchorK a₀ r w l x₀ α β k *
      (∫ y in Set.Ico a₀ (a₀ + r), S y * Complex.exp (2 * Real.pi * Complex.I * k * y / r)) -
      (r : ℂ)⁻¹ * anchorK a₀ r w l x₀ α' β' k *
      (∫ y in Set.Ico a₀ (a₀ + r), S y * Complex.exp (2 * Real.pi * Complex.I * k * y / r))‖ ≤
      r⁻¹ * S1 * ‖anchorK a₀ r w l x₀ α β k - anchorK a₀ r w l x₀ α' β' k‖ := by
    intro k
    rw [← sub_mul, ← mul_sub, norm_mul, norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hr]
    have := norm_cellCoeff_le (a₀ := a₀) (r := r) S k
    calc r⁻¹ * ‖anchorK a₀ r w l x₀ α β k - anchorK a₀ r w l x₀ α' β' k‖ *
        ‖∫ y in Set.Ico a₀ (a₀ + r), S y * Complex.exp (2 * Real.pi * Complex.I * k * y / r)‖ ≤
        r⁻¹ * ‖anchorK a₀ r w l x₀ α β k - anchorK a₀ r w l x₀ α' β' k‖ * S1 := by gcongr
      _ = _ := by ring
  have hs2 : Summable fun k : ℤ =>
      r⁻¹ * S1 * ‖anchorK a₀ r w l x₀ α β k - anchorK a₀ r w l x₀ α' β' k‖ :=
    hsum.mul_left _
  calc _ ≤ ∑' k : ℤ, r⁻¹ * S1 * ‖anchorK a₀ r w l x₀ α β k - anchorK a₀ r w l x₀ α' β' k‖ :=
        tsum_of_norm_bounded hs2.hasSum hpt
    _ = _ := by rw [tsum_mul_left]

/-- The norm of one anchor pairing: at most `r⁻¹ ‖S‖_{L¹(I)} Σ_k |K(k)|`. -/
theorem anchorP_norm_le (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4)
    (S : ℝ → ℂ) (hS : IntegrableOn S (Set.Ico a₀ (a₀ + r))) (x₀ α β : ℝ)
    (hsum : Summable fun k : ℤ => ‖anchorK a₀ r w l x₀ α β k‖) :
    ‖anchorP r w l S x₀ α β‖ ≤
      r⁻¹ * (∫ y in Set.Ico a₀ (a₀ + r), ‖S y‖) * ∑' k : ℤ, ‖anchorK a₀ r w l x₀ α β k‖ := by
  have h1 := anchor_pairing_expand hr hw l S hS α β x₀
  set S1 := ∫ y in Set.Ico a₀ (a₀ + r), ‖S y‖
  have h1' : HasSum (fun k : ℤ => (r : ℂ)⁻¹ * anchorK a₀ r w l x₀ α β k *
      (∫ y in Set.Ico a₀ (a₀ + r), S y * Complex.exp (2 * Real.pi * Complex.I * k * y / r)))
      (anchorP r w l S x₀ α β) := h1
  rw [← h1'.tsum_eq]
  have hpt : ∀ k : ℤ, ‖(r : ℂ)⁻¹ * anchorK a₀ r w l x₀ α β k *
      (∫ y in Set.Ico a₀ (a₀ + r), S y * Complex.exp (2 * Real.pi * Complex.I * k * y / r))‖ ≤
      r⁻¹ * S1 * ‖anchorK a₀ r w l x₀ α β k‖ := by
    intro k
    rw [norm_mul, norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr]
    have := norm_cellCoeff_le (a₀ := a₀) (r := r) S k
    calc r⁻¹ * ‖anchorK a₀ r w l x₀ α β k‖ *
        ‖∫ y in Set.Ico a₀ (a₀ + r), S y * Complex.exp (2 * Real.pi * Complex.I * k * y / r)‖ ≤
        r⁻¹ * ‖anchorK a₀ r w l x₀ α β k‖ * S1 := by gcongr
      _ = _ := by ring
  calc _ ≤ ∑' k : ℤ, r⁻¹ * S1 * ‖anchorK a₀ r w l x₀ α β k‖ :=
        tsum_of_norm_bounded (hsum.mul_left _).hasSum hpt
    _ = _ := by rw [tsum_mul_left]

/-- Far vertical cosets: `Σ_k |K(k)| ≤ 12 C_J (4/(r|β|))^{J-2}` when `r|β| ≥ 4`. -/
theorem anchorK_far (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4) {J : ℕ}
    (hJ : 2 ≤ J) (x₀ α β : ℝ) (hb : 4 ≤ |r * β|) :
    Summable (fun k : ℤ => ‖anchorK a₀ r w l x₀ α β k‖) ∧
      ∑' k : ℤ, ‖anchorK a₀ r w l x₀ α β k‖ ≤ 12 * (kerC κ J * (4 / |r * β|) ^ (J - 2)) := by
  have e : ∀ k : ℤ, ‖anchorK a₀ r w l x₀ α β k‖ = ‖kernelFT (unitKernel a₀ r w) (k - r * α)
      (((l : ℕ) : ℝ) * (k - r * α) - r * β)‖ := fun k => by
    rw [anchorK_eq hr, norm_mul, Circle.norm_coe, one_mul]
  simp_rw [e]
  exact far_ksum hr hw l hJ (r * α) (r * β) hb

/-- Near vertical cosets: the kernel samples at `(α, β)` and the reference `(α', β')` differ in
total by at most `24 √(L_W δ C₄) + 12 π r|α - α'| C₂` (with `x₀` in the cell). -/
theorem anchorK_near (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4)
    {x₀ : ℝ} (hx₀ : x₀ ∈ Set.Icc a₀ (a₀ + r)) (α β α' β' : ℝ) :
    Summable (fun k : ℤ => ‖anchorK a₀ r w l x₀ α β k - anchorK a₀ r w l x₀ α' β' k‖) ∧
      ∑' k : ℤ, ‖anchorK a₀ r w l x₀ α β k - anchorK a₀ r w l x₀ α' β' k‖ ≤
        24 * Real.sqrt (2 * 4 * (2 * 4 * (2 * Real.pi * 4 *
          (4 * |r * α - r * α'| + |r * β - r * β'|) * kernelDerivBound κ 0))) *
            Real.sqrt (kerC κ 4) + Real.pi * |r * α - r * α'| * (12 * kerC κ 2) := by
  obtain ⟨hs1, hb1⟩ := near_ksum hr hw l (r * α) (r * β) (r * α') (r * β')
  obtain ⟨hs2, hb2⟩ := ksum_le hr hw l (r * α') (r * β')
  set φ : ℝ → ℤ → ℝ := fun a k => -(a * x₀) + (a - k / r) * (a₀ + r / 2)
  have hph : ∀ k : ℤ, ‖(Real.fourierChar (φ α k) : ℂ) - (Real.fourierChar (φ α' k) : ℂ)‖ ≤
      Real.pi * |r * α - r * α'| := by
    intro k
    have h := chart_fourierChar_sub_one_norm_le (φ α k - φ α' k)
    have e : (Real.fourierChar (φ α k) : ℂ) - (Real.fourierChar (φ α' k) : ℂ) =
        (Real.fourierChar (φ α' k) : ℂ) * ((Real.fourierChar (φ α k - φ α' k) : ℂ) - 1) := by
      rw [mul_sub, mul_one, ← Circle.coe_mul, ← AddChar.map_add_eq_mul, add_sub_cancel]
    rw [e, norm_mul, Circle.norm_coe, one_mul]
    refine h.trans (le_of_eq_of_le rfl ?_)
    have hd : φ α k - φ α' k = (α - α') * (a₀ + r / 2 - x₀) := by simp only [φ]; ring
    rw [hd, abs_mul]
    have hx : |a₀ + r / 2 - x₀| ≤ r / 2 := by
      rw [abs_le]; constructor <;> linarith [hx₀.1, hx₀.2]
    have hra : |r * α - r * α'| = r * |α - α'| := by
      rw [← mul_sub, abs_mul, abs_of_pos hr]
    rw [hra]
    calc 2 * Real.pi * (|α - α'| * |a₀ + r / 2 - x₀|) ≤ 2 * Real.pi * (|α - α'| * (r / 2)) := by
          gcongr
      _ = Real.pi * (r * |α - α'|) := by ring
  have hpt : ∀ k : ℤ, ‖anchorK a₀ r w l x₀ α β k - anchorK a₀ r w l x₀ α' β' k‖ ≤
      ‖kernelFT (unitKernel a₀ r w) (k - r * α) (((l : ℕ) : ℝ) * (k - r * α) - r * β) -
        kernelFT (unitKernel a₀ r w) (k - r * α') (((l : ℕ) : ℝ) * (k - r * α') - r * β')‖ +
      Real.pi * |r * α - r * α'| * ‖kernelFT (unitKernel a₀ r w) (k - r * α')
        (((l : ℕ) : ℝ) * (k - r * α') - r * β')‖ := by
    intro k
    rw [anchorK_eq hr, anchorK_eq hr]
    set W1 := kernelFT (unitKernel a₀ r w) (k - r * α) (((l : ℕ) : ℝ) * (k - r * α) - r * β)
    set W2 := kernelFT (unitKernel a₀ r w) (k - r * α') (((l : ℕ) : ℝ) * (k - r * α') - r * β')
    have e : (Real.fourierChar (φ α k) : ℂ) * W1 - (Real.fourierChar (φ α' k) : ℂ) * W2 =
        (Real.fourierChar (φ α k) : ℂ) * (W1 - W2) +
          ((Real.fourierChar (φ α k) : ℂ) - (Real.fourierChar (φ α' k) : ℂ)) * W2 := by ring
    refine (le_of_eq (congrArg norm e)).trans ((norm_add_le _ _).trans (add_le_add ?_ ?_))
    · rw [norm_mul, Circle.norm_coe, one_mul]
    · rw [norm_mul]; exact mul_le_mul_of_nonneg_right (hph k) (norm_nonneg _)
  have hsum : Summable (fun k : ℤ => ‖anchorK a₀ r w l x₀ α β k - anchorK a₀ r w l x₀ α' β' k‖) :=
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hpt (hs1.add (hs2.mul_left _))
  refine ⟨hsum, ?_⟩
  calc _ ≤ ∑' k : ℤ, (‖kernelFT (unitKernel a₀ r w) (k - r * α)
        (((l : ℕ) : ℝ) * (k - r * α) - r * β) - kernelFT (unitKernel a₀ r w) (k - r * α')
          (((l : ℕ) : ℝ) * (k - r * α') - r * β')‖ +
        Real.pi * |r * α - r * α'| * ‖kernelFT (unitKernel a₀ r w) (k - r * α')
          (((l : ℕ) : ℝ) * (k - r * α') - r * β')‖) :=
        hsum.tsum_le_tsum hpt (hs1.add (hs2.mul_left _))
    _ = _ := by rw [hs1.tsum_add (hs2.mul_left _), tsum_mul_left]
    _ ≤ _ := add_le_add hb1 (mul_le_mul_of_nonneg_left hb2 (by positivity))

end ThreeCoreSplit

section ThreeCoreMain
variable {κ : LocalKernelClass} {a₀ r : ℝ} {w : ℝ × ℝ → ℂ}

/-- The entry constant of the three-core pairing matrix:
`C_{J+A+2} 5^{J+A+2} 2^{A+2} min(1, |b|) max(1, |b|)^{-J}`. -/
noncomputable def entryC (κ : LocalKernelClass) (J A : ℕ) (b : ℝ) : ℝ :=
  kerC κ (J + (A + 2)) * (3 + 2) ^ (J + (A + 2)) * min 1 |b| / max 1 |b| ^ J * 2 ^ (A + 2)

theorem entryC_nonneg (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (J A : ℕ) (b : ℝ) :
    0 ≤ entryC κ J A b := by
  unfold entryC
  have := kerC_nonneg hr hw (J + (A + 2))
  have h1 : 0 ≤ min 1 |b| := le_min zero_le_one (abs_nonneg _)
  have h2 : 0 < max 1 |b| := lt_of_lt_of_le one_pos (le_max_left _ _)
  positivity

/-- Blueprint lines 2553-2556 (`|M_{n,k}| ≤ C_{J,A} μ ν^{-J} (1 + |k + r(Q + n·ξ)|)^{-A}`): the
kernel samples of the anchor pairing at `(α, β)` satisfy
`|K(k)| ≤ entryC (1 + |k - r α|)^{-(A+2)}` with `μ, ν` built from `r β`. -/
theorem anchorK_entry (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4)
    (x₀ α β : ℝ) (J A : ℕ) (k : ℤ) :
    ‖anchorK a₀ r w l x₀ α β k‖ ≤
      entryC κ J A (r * β) * (1 + |(k : ℝ) - r * α|)⁻¹ ^ (A + 2) := by
  rw [anchorK_eq hr, norm_mul, Circle.norm_coe, one_mul]
  set L : Finset ℝ := (Finset.univ : Finset (Fin 4)).image fun j : Fin 4 => (j : ℝ)
  have hL : L.Nonempty := ⟨0, Finset.mem_image.mpr ⟨0, Finset.mem_univ _, by simp⟩⟩
  have hl : ((l : ℕ) : ℝ) ∈ L := Finset.mem_image.mpr ⟨l, Finset.mem_univ _, rfl⟩
  have hl3 : |((l : ℕ) : ℝ)| ≤ 3 := by
    rw [abs_of_nonneg (Nat.cast_nonneg _)]
    have := l.isLt; exact_mod_cast (by omega : (l : ℕ) ≤ 3)
  have hK : ∀ q t, ‖kernelFT (unitKernel a₀ r w) q t‖ * max 1 (max |q| |t|) ^ (J + (A + 2)) ≤
      kerC κ (J + (A + 2)) * min 1 (L.inf' hL fun j => |t - j * q|) := by
    intro q t
    exact admissible_kernel_decay hr hw (J + (A + 2)) q t
  have h := anchor_entry_bound (kerC_nonneg hr hw _) (by norm_num : (0 : ℝ) ≤ 3) J (A + 2) L hL
    hl hl3 hK ((k : ℝ) - r * α) (-(r * β))
  set κ' := (k : ℝ) - r * α
  have e : ((l : ℕ) : ℝ) * κ' - r * β = -(r * β) + ((l : ℕ) : ℝ) * κ' := by ring
  rw [e]
  have hb1 : 0 < max 1 |-(r * β)| ^ J := pow_pos (lt_of_lt_of_le one_pos (le_max_left _ _)) _
  have hk1 : 0 < max 1 |κ'| ^ (A + 2) := pow_pos (lt_of_lt_of_le one_pos (le_max_left _ _)) _
  have hW : ‖kernelFT (unitKernel a₀ r w) κ' (-(r * β) + ((l : ℕ) : ℝ) * κ')‖ ≤
      kerC κ (J + (A + 2)) * (3 + 2) ^ (J + (A + 2)) * min 1 |r * β| /
        (max 1 |r * β| ^ J * max 1 |κ'| ^ (A + 2)) := by
    rw [abs_neg] at h hb1
    rw [le_div_iff₀ (by positivity)]
    exact h
  refine hW.trans ?_
  have hmk : (1 + |κ'|) / 2 ≤ max 1 |κ'| := by
    rcases le_total |κ'| 1 with h1 | h1
    · exact le_trans (by linarith) (le_max_left _ _)
    · exact le_trans (by linarith) (le_max_right _ _)
  have hpk : ((1 + |κ'|) / 2) ^ (A + 2) ≤ max 1 |κ'| ^ (A + 2) :=
    pow_le_pow_left₀ (by positivity) hmk _
  have hmin : 0 ≤ kerC κ (J + (A + 2)) * (3 + 2) ^ (J + (A + 2)) * min 1 |r * β| :=
    mul_nonneg (mul_nonneg (kerC_nonneg hr hw _) (by positivity))
      (le_min zero_le_one (abs_nonneg _))
  have hb : 0 < max 1 |r * β| ^ J := by rw [abs_neg] at hb1; exact hb1
  unfold entryC
  rw [div_mul_eq_div_div, inv_pow]
  calc kerC κ (J + (A + 2)) * (3 + 2) ^ (J + (A + 2)) * min 1 |r * β| / max 1 |r * β| ^ J /
      max 1 |κ'| ^ (A + 2) ≤ kerC κ (J + (A + 2)) * (3 + 2) ^ (J + (A + 2)) * min 1 |r * β| /
        max 1 |r * β| ^ J / ((1 + |κ'|) / 2) ^ (A + 2) :=
        div_le_div_of_nonneg_left (div_nonneg hmin hb.le) (by positivity) hpk
    _ = _ := by rw [div_pow]; field_simp

end ThreeCoreMain

section ThreeCoreMain2
variable {κ : LocalKernelClass} {a₀ r : ℝ} {w : ℝ × ℝ → ℂ}

/-- The windows of the reference frequencies: the integers within `2^I` of some `r α_n`. -/
noncomputable def windowSet {ν : Type*} (N : Finset ν) (c : ν → ℝ) (I : ℕ) : Finset ℤ :=
  N.biUnion fun n => Finset.Icc ⌈c n - 2 ^ I⌉ ⌊c n + 2 ^ I⌋

theorem far_of_not_mem_windowSet {ν : Type*} (N : Finset ν) (c : ν → ℝ) (I : ℕ) {k : ℤ}
    (hk : k ∉ windowSet N c I) : ∀ n ∈ N, (2 : ℝ) ^ I < |(k : ℝ) - c n| := by
  intro n hn
  by_contra h
  push Not at h
  apply hk
  refine Finset.mem_biUnion.mpr ⟨n, hn, Finset.mem_Icc.mpr ⟨?_, ?_⟩⟩
  · exact Int.ceil_le.mpr (by linarith [(abs_le.mp h).1])
  · exact Int.le_floor.mpr (by linarith [(abs_le.mp h).2])

open Classical in
/-- Blueprint `eq:side-windows` (lines 2543-2562) for the reference terms of a three-core test:
with Haar coefficients `a_n = ⟨D_{m₀}, χ_n⟩` at `1`-separated reference frequencies `r α_n`,
`|Σ_n a_n P(α_n, β₀)|` is at most the window bound of `three_core_windows` over the windows of
the references plus the tail `12 C_ent 2^{-IA} ‖S‖_{L¹(I)} Σ_n |a_n|`. -/
theorem three_core_main (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4)
    (S : ℝ → ℂ) (hS : IntegrableOn S (Set.Ico a₀ (a₀ + r))) (x₀ : ℝ) {d : ℕ}
    (V : Submodule ℚ (Fin d → ℚ))
    (Rm : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ) (hRm : Continuous Rm) {W : ℝ}
    (hW : 0 ≤ W) (hRb : ∀ z, ‖Rm z‖ ≤ W)
    (g : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℂ)
    (hg : ∀ i, Continuous (g i)) (m₀ : Fin d → ℤ) (N : Finset (Fin d → ℤ))
    (hN : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → n - n' ∉ rationalIntegerIntersection V)
    (αN : (Fin d → ℤ) → ℝ) (β₀ : ℝ)
    (hsep : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → 1 ≤ |-(r * αN n) - -(r * αN n')|) (J A I : ℕ) :
    ‖∑ n ∈ N, (∫ u, dualSlice V Rm l g m₀ u * starRingEnd ℂ (torusCharacter n u)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) *
          anchorP r w l S x₀ (αN n) β₀‖ ≤
      (r⁻¹ * entryC κ J A (r * β₀) * 2 ^ (A + 4) * ∑ i ∈ Finset.range (I + 1),
          ((2 : ℝ) ^ i)⁻¹ ^ (A + 1) *
          ((W * ∏ i ∈ Finset.univ.erase l, (eLpNorm (g i) 2
            (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal) *
            Real.sqrt (∑ k ∈ (windowSet N (fun n => r * αN n) I).filter
              (fun k : ℤ => ∃ n ∈ N, |(k : ℝ) + -(r * αN n)| ≤ 2 ^ i),
                ‖∫ y in Set.Ico a₀ (a₀ + r), S y *
                  Complex.exp (2 * Real.pi * Complex.I * k * y / r)‖ ^ 2)) +
        r⁻¹ * entryC κ J A (r * β₀) * ((2 : ℝ) ^ I)⁻¹ ^ (A + 2) *
          ((∑ n ∈ N, ‖∫ u, dualSlice V Rm l g m₀ u * starRingEnd ℂ (torusCharacter n u)
            ∂torusAnnihilatorHaar (rationalIntegerIntersection V)‖) *
            ∑ k ∈ windowSet N (fun n => r * αN n) I, ‖∫ y in Set.Ico a₀ (a₀ + r), S y *
              Complex.exp (2 * Real.pi * Complex.I * k * y / r)‖)) +
      12 * (r⁻¹ * entryC κ J A (r * β₀) * ((2 : ℝ) ^ I)⁻¹ ^ A) *
        (∫ y in Set.Ico a₀ (a₀ + r), ‖S y‖) *
          ∑ n ∈ N, ‖∫ u, dualSlice V Rm l g m₀ u * starRingEnd ℂ (torusCharacter n u)
            ∂torusAnnihilatorHaar (rationalIntegerIntersection V)‖ := by
  set! a : (Fin d → ℤ) → ℂ := fun n => ∫ u, dualSlice V Rm l g m₀ u *
    starRingEnd ℂ (torusCharacter n u) ∂torusAnnihilatorHaar (rationalIntegerIntersection V)
  set! s : ℤ → ℂ := fun k => ∫ y in Set.Ico a₀ (a₀ + r), S y *
    Complex.exp (2 * Real.pi * Complex.I * k * y / r)
  set! M : (Fin d → ℤ) → ℤ → ℂ := fun n k => (r : ℂ)⁻¹ * anchorK a₀ r w l x₀ (αN n) β₀ k
  set Ce := r⁻¹ * entryC κ J A (r * β₀)
  have hCe : 0 ≤ Ce := mul_nonneg (inv_nonneg.mpr hr.le) (entryC_nonneg hr hw J A _)
  set S1 := ∫ y in Set.Ico a₀ (a₀ + r), ‖S y‖
  have hS1 : 0 ≤ S1 := setIntegral_nonneg measurableSet_Ico fun _ _ => norm_nonneg _
  have hs1 : ∀ k, ‖s k‖ ≤ S1 := fun k => norm_cellCoeff_le S k
  have hM : ∀ n k, ‖M n k‖ ≤ Ce * (1 + |(k : ℝ) + -(r * αN n)|)⁻¹ ^ (A + 2) := by
    intro n k
    simp only [M, Ce]
    rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr, mul_assoc]
    refine mul_le_mul_of_nonneg_left ?_ (inv_nonneg.mpr hr.le)
    have := anchorK_entry (a₀ := a₀) (w := w) hr hw l x₀ (αN n) β₀ J A k
    simpa [sub_eq_add_neg] using this
  -- the expansion of each reference term
  have hn : ∀ n, HasSum (fun k => M n k * s k) (anchorP r w l S x₀ (αN n) β₀) := by
    intro n
    have h := anchor_pairing_expand hr hw l S hS (αN n) β₀ x₀
    exact h
  have hall : HasSum (fun k => ∑ n ∈ N, a n * (M n k * s k))
      (∑ n ∈ N, a n * anchorP r w l S x₀ (αN n) β₀) :=
    hasSum_sum fun n _ => (hn n).mul_left (a n)
  set Kk := windowSet N (fun n => r * αN n) I
  set F : ℤ → ℂ := fun k => ∑ n ∈ N, a n * (M n k * s k)
  -- split into the windows and the tail
  set! Ft : ℤ → ℂ := fun k => if k ∈ Kk then 0 else F k
  have hsplitF : ∀ k, F k = (if k ∈ Kk then F k else 0) + Ft k := fun k => by
    simp only [Ft]; split_ifs <;> simp
  have hwin : HasSum (fun k => if k ∈ Kk then F k else 0) (∑ k ∈ Kk, F k) := by
    have h := hasSum_sum_of_ne_finset_zero (L := SummationFilter.unconditional ℤ) (s := Kk)
      (f := fun k => if k ∈ Kk then F k else 0)
      (fun k hk => ite_eq_right_of_eq_false _ _ (eq_false hk))
    rwa [Finset.sum_congr rfl fun k hk => ite_eq_left_of_eq_true _ _ (eq_true hk)] at h
  have hFt : HasSum Ft (∑ n ∈ N, a n * anchorP r w l S x₀ (αN n) β₀ - ∑ k ∈ Kk, F k) := by
    have := hall.sub hwin
    convert this using 1
    funext k
    simp only [Ft]
    split_ifs <;> simp
  have htot : ∑ n ∈ N, a n * anchorP r w l S x₀ (αN n) β₀ =
      ∑ k ∈ Kk, F k + ∑' k, Ft k := by
    rw [hFt.tsum_eq]; ring
  rw [htot]
  -- the window part
  have hwin_eq : ∑ k ∈ Kk, F k = ∑ n ∈ N, ∑ k ∈ Kk, a n * s k * M n k := by
    simp only [F]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun n _ => Finset.sum_congr rfl fun k _ => by ring
  have hW1 := three_core_windows V Rm hRm hW hRb l g hg m₀ N hN (fun n => -(r * αN n)) hsep Kk
    s M hCe A I hM
  -- the tail
  have htail_pt : ∀ k, ‖Ft k‖ ≤ ∑ n ∈ N, ‖a n‖ * (Ce * ((2 : ℝ) ^ I)⁻¹ ^ A * S1 *
      (max 1 |(k : ℝ) - r * αN n| ^ 2)⁻¹) := by
    intro k
    simp only [Ft]
    split_ifs with hk
    · rw [norm_zero]; exact Finset.sum_nonneg fun n _ => by positivity
    · have hfar := far_of_not_mem_windowSet N (fun n => r * αN n) I hk
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun n hnN => ?_)
      rw [norm_mul, norm_mul]
      refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
      have hx := hfar n hnN
      set x := |(k : ℝ) - r * αN n|
      have hx0 : 0 ≤ x := abs_nonneg _
      have h2I : 0 < (2 : ℝ) ^ I := by positivity
      have hMk := hM n k
      rw [show (k : ℝ) + -(r * αN n) = (k : ℝ) - r * αN n by ring] at hMk
      have hdec : (1 + x)⁻¹ ^ (A + 2) ≤ ((2 : ℝ) ^ I)⁻¹ ^ A * (max 1 x ^ 2)⁻¹ := by
        have h1 : (1 + x)⁻¹ ^ A ≤ ((2 : ℝ) ^ I)⁻¹ ^ A :=
          pow_le_pow_left₀ (by positivity) (inv_anti₀ h2I (by linarith)) A
        have h2 : (1 + x)⁻¹ ^ 2 ≤ (max 1 x ^ 2)⁻¹ := by
          rw [← inv_pow]
          refine pow_le_pow_left₀ (by positivity) (inv_anti₀ (lt_of_lt_of_le one_pos
            (le_max_left _ _)) (max_le (by linarith) (by linarith))) 2
        rw [pow_add]
        exact mul_le_mul h1 h2 (by positivity) (by positivity)
      calc ‖M n k‖ * ‖s k‖ ≤ Ce * (1 + x)⁻¹ ^ (A + 2) * S1 :=
            mul_le_mul hMk (hs1 k) (norm_nonneg _) (by positivity)
        _ ≤ Ce * (((2 : ℝ) ^ I)⁻¹ ^ A * (max 1 x ^ 2)⁻¹) * S1 := by gcongr
        _ = _ := by ring
  have hgs : Summable fun k : ℤ => ∑ n ∈ N, ‖a n‖ * (Ce * ((2 : ℝ) ^ I)⁻¹ ^ A * S1 *
      (max 1 |(k : ℝ) - r * αN n| ^ 2)⁻¹) :=
    summable_sum fun n _ => ((summable_inv_max_sq (r * αN n)).mul_left _).mul_left _
  have htail : ‖∑' k, Ft k‖ ≤ 12 * (Ce * ((2 : ℝ) ^ I)⁻¹ ^ A) * S1 * ∑ n ∈ N, ‖a n‖ := by
    refine (tsum_of_norm_bounded hgs.hasSum htail_pt).trans ?_
    have hts := (hasSum_sum fun n (_ : n ∈ N) =>
      (((summable_inv_max_sq (r * αN n)).mul_left
        (Ce * ((2 : ℝ) ^ I)⁻¹ ^ A * S1)).mul_left ‖a n‖).hasSum).tsum_eq
    rw [hts, Finset.mul_sum]
    refine Finset.sum_le_sum fun n _ => ?_
    rw [tsum_mul_left, tsum_mul_left]
    have := tsum_inv_max_sq_le (r * αN n)
    have h0 : 0 ≤ Ce * ((2 : ℝ) ^ I)⁻¹ ^ A * S1 := by positivity
    calc ‖a n‖ * (Ce * ((2 : ℝ) ^ I)⁻¹ ^ A * S1 *
        ∑' k : ℤ, (max 1 |(k : ℝ) - r * αN n| ^ 2)⁻¹) ≤
        ‖a n‖ * (Ce * ((2 : ℝ) ^ I)⁻¹ ^ A * S1 * 12) := by gcongr
      _ = _ := by ring
  rw [hwin_eq]
  exact (norm_add_le _ _).trans (add_le_add hW1 htail)

end ThreeCoreMain2

section ThreeCoreTotal
variable {κ : LocalKernelClass} {a₀ r : ℝ} {w : ℝ × ℝ → ℂ}

open Classical in
/-- Blueprint lines 2523-2549 for the three-core tuple terms: collecting the tuple terms by the
vertical reference coset `m₀ + K_B` and horizontal reference cosets, the sum
`Σ_x C_x P(α_x, β_x)` equals `Σ_{n ∈ N} a_n P(α_n, β₀)` plus the near differences and the far
terms, where `a_n` is the Haar coefficient of the dual slice `D_{m₀}` at `n`. -/
theorem three_core_collect (r : ℝ) (w : ℝ × ℝ → ℂ) (l : Fin 4) (S : ℝ → ℂ) (x₀ : ℝ) {d : ℕ}
    (V : Submodule ℚ (Fin d → ℚ)) {ι : Type*} (P : Finset ι) (C : ι → ℂ)
    (fr : ι → (Fin d → ℤ) × (Fin d → ℤ)) (α β : ι → ℝ)
    (Rm : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ)
    (g : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℂ)
    (hexp : ∀ u v, Rm (u, v) * ∏ i ∈ Finset.univ.erase l, g i (u + ((i : ℤ) - (l : ℤ)) • v) =
      ∑ x ∈ P, C x * (torusCharacter (fr x).1 u * torusCharacter (fr x).2 v))
    (m₀ : Fin d → ℤ) (N : Finset (Fin d → ℤ))
    (hN : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → n - n' ∉ rationalIntegerIntersection V)
    (αN : (Fin d → ℤ) → ℝ) (β₀ : ℝ) (nref : ι → Fin d → ℤ)
    (hnear : ∀ x ∈ P, (fr x).2 - m₀ ∈ rationalIntegerIntersection V →
      nref x ∈ N ∧ (fr x).1 - nref x ∈ rationalIntegerIntersection V) :
    ∑ x ∈ P, C x * anchorP r w l S x₀ (α x) (β x) =
      ∑ n ∈ N, (∫ u, dualSlice V Rm l g m₀ u * starRingEnd ℂ (torusCharacter n u)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) * anchorP r w l S x₀ (αN n) β₀ +
      ∑ x ∈ P.filter (fun x => (fr x).2 - m₀ ∈ rationalIntegerIntersection V),
        C x * (anchorP r w l S x₀ (α x) (β x) - anchorP r w l S x₀ (αN (nref x)) β₀) +
      ∑ x ∈ P.filter (fun x => (fr x).2 - m₀ ∉ rationalIntegerIntersection V),
        C x * anchorP r w l S x₀ (α x) (β x) := by
  -- the Haar coefficients as coset sums
  have ha : ∀ n ∈ N, (∫ u, dualSlice V Rm l g m₀ u * starRingEnd ℂ (torusCharacter n u)
      ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) =
      ∑ x ∈ (P.filter fun x => (fr x).2 - m₀ ∈ rationalIntegerIntersection V).filter
        (fun x => nref x = n), C x := by
    intro n hn
    rw [dualSlice_coeff V P C fr Rm l g hexp m₀ n, Finset.filter_filter, Finset.sum_filter]
    refine Finset.sum_congr rfl fun x hx => ?_
    have hiff : ((fr x).1 - n ∈ (rationalIntegerIntersection V) ∧
        (fr x).2 - m₀ ∈ (rationalIntegerIntersection V)) ↔
        ((fr x).2 - m₀ ∈ rationalIntegerIntersection V ∧ nref x = n) := by
      constructor
      · rintro ⟨h1, h2⟩
        refine ⟨h2, ?_⟩
        obtain ⟨hNx, hx1⟩ := hnear x hx h2
        by_contra hne
        apply hN (nref x) hNx n hn hne
        have := (rationalIntegerIntersection V).sub_mem h1 hx1
        rwa [show (fr x).1 - n - ((fr x).1 - nref x) = nref x - n by abel] at this
      · rintro ⟨h2, rfl⟩
        exact ⟨(hnear x hx h2).2, h2⟩
    simp only [hiff]
  -- reassemble
  have hmain : ∑ n ∈ N, (∫ u, dualSlice V Rm l g m₀ u * starRingEnd ℂ (torusCharacter n u)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) * anchorP r w l S x₀ (αN n) β₀ =
      ∑ x ∈ P.filter (fun x => (fr x).2 - m₀ ∈ rationalIntegerIntersection V),
        C x * anchorP r w l S x₀ (αN (nref x)) β₀ := by
    rw [Finset.sum_congr rfl fun n hn => by rw [ha n hn]]
    simp_rw [Finset.sum_mul]
    rw [Finset.sum_congr rfl fun n _ => Finset.sum_congr rfl
      (g := fun i => C i * anchorP r w l S x₀ (αN (nref i)) β₀) fun i hi => by
        rw [(Finset.mem_filter.mp hi).2]]
    rw [Finset.sum_fiberwise_of_maps_to (g := nref) (fun x hx => (hnear x
      (Finset.mem_filter.mp hx).1 (Finset.mem_filter.mp hx).2).1)
      (fun x => C x * anchorP r w l S x₀ (αN (nref x)) β₀)]
  rw [hmain, ← Finset.sum_filter_add_sum_filter_not P
    (fun x => (fr x).2 - m₀ ∈ rationalIntegerIntersection V)]
  congr 1
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun x _ => by ring

end ThreeCoreTotal

section ThreeCoreCell
variable {κ : LocalKernelClass} {a₀ r : ℝ} {w : ℝ × ℝ → ℂ}

/-- The near-coset reduction error per unit coefficient (`anchorK_near` with both frequency
differences at most `ε₁`). -/
noncomputable def nearB (κ : LocalKernelClass) (ε₁ : ℝ) : ℝ :=
  24 * Real.sqrt (2 * 4 * (2 * 4 * (2 * Real.pi * 4 * (4 * ε₁ + ε₁) * kernelDerivBound κ 0))) *
    Real.sqrt (kerC κ 4) + Real.pi * ε₁ * (12 * kerC κ 2)

end ThreeCoreCell

open Classical in
/-- `form_anchor_phase_approx` for an anchored form `r⁻² ∫ w(z) F(z) S(z₁ + l z₂) dz` with a
general core factor `F` (e.g. the core product times the side gauge). -/
theorem anchoredForm_phase_approx {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (l : Fin 4) (Fc : ℝ × ℝ → ℂ)
    (Sd : ℝ → ℂ)
    (hfm : AEStronglyMeasurable Sd volume) (hfl : IntegrableOn Sd (Set.Icc a₀ (a₀ + r)))
    (hfi : Integrable (fun z : ℝ × ℝ => w z * (Fc z * Sd (realProgressionCoordinate l z))))
    {ι : Type*} (P : Finset ι) (C : ι → ℂ) (α β : ι → ℝ) (x₀ : ℝ) {ε : ℝ} (hε0 : 0 ≤ ε)
    (hε : ∀ z : ℝ × ℝ, w z ≠ 0 → ‖Fc z -
      ∑ p ∈ P, C p * (Real.fourierChar (α p * (realProgressionCoordinate l z - x₀) +
        β p * z.2) : ℂ)‖ ≤ ε) :
    ‖(r : ℂ)⁻¹ ^ 2 * (∫ z, w z * (Fc z * Sd (realProgressionCoordinate l z))) -
      ∑ p ∈ P, C p * ((r : ℂ)⁻¹ ^ 2 * ∫ y, Sd y *
      ((Real.fourierChar (α p * (y - x₀)) : ℂ) * anchorFn w l (β p) y))‖ ≤
      2 * localKernelSupBound κ * ε * (r⁻¹ * ∫ y in Set.Icc a₀ (a₀ + r), ‖Sd y‖) := by
  set L : ℝ := ((l : ℕ) : ℝ)
  set T := planeShear (-L)
  have hT : ∀ q : ℝ × ℝ, T q = (q.1 - L * q.2, q.2) := fun q => by
    simp only [T, planeShear, MeasurableEquiv.coe_mk, Equiv.coe_fn_mk]; ext <;> simp; ring
  have hcoordl : ∀ q : ℝ × ℝ, realProgressionCoordinate l (T q) = q.1 := fun q => by
    rw [hT]; simp only [realProgressionCoordinate, L]; ring
  set Kw := localKernelSupBound κ
  set! G : ι → ℝ × ℝ → ℂ := fun p q => w (q.1 - L * q.2, q.2) * Sd q.1 *
    (C p * (Real.fourierChar (α p * (q.1 - x₀) + β p * q.2) : ℂ))
  have hG : ∀ p q, G p q = w (q.1 - L * q.2, q.2) * Sd q.1 *
    (C p * (Real.fourierChar (α p * (q.1 - x₀) + β p * q.2) : ℂ)) := fun _ _ => rfl
  have hwc : Continuous fun q : ℝ × ℝ => w (q.1 - L * q.2, q.2) :=
    hw.smooth.continuous.comp (by fun_prop)
  have hfi' : Integrable ((Set.Icc a₀ (a₀ + r)).indicator fun y => ‖Sd y‖) :=
    IntegrableOn.integrable_indicator hfl.norm measurableSet_Icc
  -- integrability of the tuple terms and the error term
  have hdom : ∀ (M : ℝ) (H : ℝ × ℝ → ℂ), Continuous H → (∀ q, ‖H q‖ ≤ M) →
      Integrable (fun q : ℝ × ℝ => w (q.1 - L * q.2, q.2) * Sd q.1 * H q) := by
    intro M H hH hM
    have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
    have hti : Integrable ((Set.Icc (-r) r).indicator fun _ : ℝ => (Kw * M : ℝ)) :=
      (integrableOn_const (by simp)).integrable_indicator measurableSet_Icc
    refine (hfi'.mul_prod hti).mono' ?_ (Filter.Eventually.of_forall fun q => ?_)
    · exact ((hwc.aestronglyMeasurable).mul hfm.comp_fst).mul hH.aestronglyMeasurable
    · rw [norm_mul, norm_mul]
      by_cases hz : w (q.1 - L * q.2, q.2) = 0
      · rw [hz, norm_zero, zero_mul, zero_mul]
        exact mul_nonneg (Set.indicator_nonneg (fun _ _ => norm_nonneg _) _)
          (Set.indicator_nonneg (fun _ _ => mul_nonneg (localKernelSupBound_nonneg κ) hM0) _)
      obtain ⟨hin, ht⟩ := admissible_shear_support hr hw l hz
      have hy : q.1 ∈ Set.Icc a₀ (a₀ + r) := by
        have := hin l; simpa [L] using this
      rw [Set.indicator_of_mem hy, Set.indicator_of_mem (show q.2 ∈ Set.Icc (-r) r from
        abs_le.mp ht)]
      have hwb := admissibleLocalKernel_norm_le hw (q.1 - L * q.2, q.2)
      calc ‖w (q.1 - L * q.2, q.2)‖ * ‖Sd q.1‖ * ‖H q‖ ≤ Kw * ‖Sd q.1‖ * M :=
            mul_le_mul (mul_le_mul_of_nonneg_right hwb (norm_nonneg _)) (hM q) (norm_nonneg _)
              (mul_nonneg (localKernelSupBound_nonneg κ) (norm_nonneg _))
        _ = ‖Sd q.1‖ * (Kw * M) := by ring
  have hGi : ∀ p, Integrable (G p) := fun p => by
    have := hdom ‖C p‖ (fun q => C p * (Real.fourierChar (α p * (q.1 - x₀) + β p * q.2) : ℂ))
      (continuous_const.mul (continuous_subtype_val.comp
        (Real.continuous_fourierChar.comp (by fun_prop))))
      (fun q => by rw [norm_mul, Circle.norm_coe, mul_one])
    exact this
  -- the tuple terms as anchor pairings
  have hterm : ∀ p, (r : ℂ)⁻¹ ^ 2 * ∫ q, G p q = C p * ((r : ℂ)⁻¹ ^ 2 * ∫ y, Sd y *
      ((Real.fourierChar (α p * (y - x₀)) : ℂ) * anchorFn w l (β p) y)) := by
    intro p
    rw [MeasureTheory.Measure.volume_eq_prod, integral_prod _ (by
      rw [← MeasureTheory.Measure.volume_eq_prod]; exact hGi p)]
    have hin : ∀ y, ∫ t, G p (y, t) = C p * (Sd y *
        ((Real.fourierChar (α p * (y - x₀)) : ℂ) * anchorFn w l (β p) y)) := by
      intro y
      have e : ∀ t, G p (y, t) = (C p * Sd y * (Real.fourierChar (α p * (y - x₀)) : ℂ)) *
          (w (y - L * t, t) * (Real.fourierChar (β p * t) : ℂ)) := fun t => by
        rw [hG, AddChar.map_add_eq_mul, Circle.coe_mul]; ring
      simp_rw [e]
      rw [integral_const_mul]
      unfold anchorFn
      simp only [L]
      ring
    simp_rw [hin]
    rw [integral_const_mul]
    ring
  -- the error
  set! E : ℝ × ℝ → ℂ := fun q => w (q.1 - L * q.2, q.2) * Sd q.1 *
    (Fc (T q) - ∑ p ∈ P, C p * (Real.fourierChar (α p * (q.1 - x₀) + β p * q.2) : ℂ))
  have hpt : ∀ q, w (T q) * (Fc (T q) * Sd (realProgressionCoordinate l (T q))) =
      E q + ∑ p ∈ P, G p q := by
    intro q
    rw [hcoordl q]
    simp only [E, hG]
    rw [hT, mul_sub, Finset.mul_sum]
    ring
  have hEi : Integrable E := by
    have h1 : Integrable fun q => w (T q) * (Fc (T q) * Sd (realProgressionCoordinate l (T q))) :=
      ((measurePreserving_planeShear (-L)).integrable_comp_emb
        (planeShear (-L)).measurableEmbedding).mpr hfi
    have h2 : Integrable fun q => ∑ p ∈ P, G p q := integrable_finsetSum _ fun p _ => hGi p
    refine (h1.sub h2).congr (Filter.Eventually.of_forall fun q => ?_)
    simp only [Pi.sub_apply]
    rw [hpt q]; ring
  have hsplit : ∫ z, w z * (Fc z * Sd (realProgressionCoordinate l z)) =
      (∫ q, E q) + ∑ p ∈ P, ∫ q, G p q := by
    rw [← (measurePreserving_planeShear (-L)).integral_comp' (fun z => w z *
      (Fc z * Sd (realProgressionCoordinate l z)))]
    rw [← integral_finsetSum _ fun p _ => hGi p,
      ← integral_add hEi (integrable_finsetSum _ fun p _ => hGi p)]
    exact integral_congr_ae (Filter.Eventually.of_forall hpt)
  rw [hsplit, mul_add, Finset.mul_sum]
  simp_rw [hterm]
  rw [add_sub_cancel_right, norm_mul]
  -- bound the error integral
  have hEb : ∀ q, ‖E q‖ ≤ (Set.Icc a₀ (a₀ + r)).indicator (fun y => ‖Sd y‖) q.1 *
      (Set.Icc (-r) r).indicator (fun _ => Kw * ε) q.2 := by
    intro q
    simp only [E, norm_mul]
    by_cases hz : w (q.1 - L * q.2, q.2) = 0
    · rw [hz, norm_zero, zero_mul, zero_mul]
      exact mul_nonneg (Set.indicator_nonneg (fun _ _ => norm_nonneg _) _)
        (Set.indicator_nonneg (fun _ _ => mul_nonneg (localKernelSupBound_nonneg κ) hε0) _)
    obtain ⟨hin, ht⟩ := admissible_shear_support hr hw l hz
    have hy : q.1 ∈ Set.Icc a₀ (a₀ + r) := by
      have := hin l; simpa [L] using this
    rw [Set.indicator_of_mem hy, Set.indicator_of_mem (show q.2 ∈ Set.Icc (-r) r from
      abs_le.mp ht)]
    have hwb := admissibleLocalKernel_norm_le hw (q.1 - L * q.2, q.2)
    have he := hε (T q) (by rw [hT]; exact hz)
    rw [hcoordl q] at he
    calc ‖w (q.1 - L * q.2, q.2)‖ * ‖Sd q.1‖ * _ ≤ Kw * ‖Sd q.1‖ * ε :=
          mul_le_mul (mul_le_mul_of_nonneg_right hwb (norm_nonneg _)) he (norm_nonneg _)
            (mul_nonneg (localKernelSupBound_nonneg κ) (norm_nonneg _))
      _ = ‖Sd q.1‖ * (Kw * ε) := by ring
  have hti : Integrable ((Set.Icc (-r) r).indicator fun _ : ℝ => (Kw * ε : ℝ)) :=
    (integrableOn_const (by simp)).integrable_indicator measurableSet_Icc
  have hI := norm_integral_le_of_norm_le (hfi'.mul_prod hti) (Filter.Eventually.of_forall hEb)
  rw [integral_prod_mul] at hI
  rw [integral_indicator measurableSet_Icc, integral_indicator measurableSet_Icc,
    setIntegral_const, smul_eq_mul, Measure.real, Real.volume_Icc,
    ENNReal.toReal_ofReal (by linarith)] at hI
  have hr2 : ‖(r : ℂ)⁻¹ ^ 2‖ = (r ^ 2)⁻¹ := by
    rw [norm_pow, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr, inv_pow]
  rw [hr2]
  have hJ0 : 0 ≤ ∫ y in Set.Icc a₀ (a₀ + r), ‖Sd y‖ := setIntegral_nonneg measurableSet_Icc
    fun _ _ => norm_nonneg _
  calc (r ^ 2)⁻¹ * ‖∫ q, E q‖ ≤ (r ^ 2)⁻¹ * ((∫ y in Set.Icc a₀ (a₀ + r), ‖Sd y‖) *
        ((r - -r) * (Kw * ε))) := by
        gcongr
        rw [MeasureTheory.Measure.volume_eq_prod]
        exact hI
    _ = _ := by field_simp; ring

section ReAnchor
variable {d : ℕ}

open Classical in
/-- Blueprint lines 2537-2545 (three cores, anchor `l`): the four-slot torus expansion re-anchored
at `u = U + l V`. On the physical side,
`e(Σ_j γ_j (y_j - x₀)) R(U, V) Π_j g_j(U + j V) = Σ_x C_x e(A_x (y_l - x₀) + (B_x - l A_x) t)`;
on the torus, `R(u - l v, v) g_l(u) Π_{j ≠ l} g_j(u + (j - l) v)` has the character expansion
with frequencies `(P₁(x), P₂(x) - l P₁(x))`. -/
theorem reanchor_physical (l : Fin 4) (ξ : Fin d → ℝ) (x₀ : ℝ) (γ : Fin 4 → ℝ) {ιR : Type*}
    {ι : Fin 4 → Type*} (QR : Finset ιR) (rc : ιR → ℂ) (fr : ιR → (Fin d → ℤ) × (Fin d → ℤ))
    (F : ∀ j, Finset (ι j)) (a : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin d → ℤ) (z : ℝ × ℝ) :
    (Real.fourierChar (∑ j, γ j * (realProgressionCoordinate j z - x₀)) : ℂ) *
        ((∑ q ∈ QR, rc q * (torusCharacter (fr q).1 (torusMk fun i => ξ i * (z.1 - x₀)) *
          torusCharacter (fr q).2 (torusMk fun i => ξ i * z.2))) *
        ∏ j : Fin 4, (∑ k ∈ F j, a j k * torusCharacter (n j k)
          ((torusMk fun i => ξ i * (z.1 - x₀)) +
            (((j : ℕ) : ℤ) - 0) • (torusMk fun i => ξ i * z.2)))) =
      ∑ x ∈ QR ×ˢ Fintype.piFinset F, (rc x.1 * ∏ j, a j (x.2 j)) *
        (Real.fourierChar ((∑ j, γ j + ∑ i, (((fr x.1).1 + ∑ j, n j (x.2 j)) i : ℝ) * ξ i) *
            (realProgressionCoordinate l z - x₀) +
          ((∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (((fr x.1).2 +
            ∑ j : Fin 4, (((j : ℕ) : ℤ) - 0) • n j (x.2 j)) i : ℝ) * ξ i) -
            ((l : ℕ) : ℝ) * (∑ j, γ j + ∑ i, (((fr x.1).1 + ∑ j, n j (x.2 j)) i : ℝ) * ξ i)) *
              z.2) : ℂ) := by
  rw [four_product_expand 0 QR rc fr F a n, Finset.mul_sum]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [torusCharacter_mk_line, torusCharacter_mk_line]
  set P1 := ∑ i, (((fr x.1).1 + ∑ j, n j (x.2 j)) i : ℝ) * ξ i
  set P2 := ∑ i, (((fr x.1).2 + ∑ j : Fin 4, (((j : ℕ) : ℤ) - 0) • n j (x.2 j)) i : ℝ) * ξ i
  have e1 : ∑ j : Fin 4, γ j * (realProgressionCoordinate j z - x₀) =
      (∑ j, γ j) * (z.1 - x₀) + (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j) * z.2 := by
    simp only [realProgressionCoordinate, Fin.sum_univ_four]
    norm_num
    ring
  have e2 : (∑ j, γ j + P1) * (realProgressionCoordinate l z - x₀) +
      ((∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + P2) - ((l : ℕ) : ℝ) * (∑ j, γ j + P1)) * z.2 =
      ((∑ j, γ j) * (z.1 - x₀) + (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j) * z.2) +
        (P1 * (z.1 - x₀) + P2 * z.2) := by
    simp only [realProgressionCoordinate]; ring
  rw [e1, e2]
  simp only [AddChar.map_add_eq_mul, Circle.coe_mul]
  ring

open Classical in
/-- The torus side of `reanchor_physical`. -/
theorem reanchor_torus (l : Fin 4) {ιR : Type*} {ι : Fin 4 → Type*} (QR : Finset ιR)
    (rc : ιR → ℂ) (fr : ιR → (Fin d → ℤ) × (Fin d → ℤ)) (F : ∀ j, Finset (ι j))
    (a : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin d → ℤ) (u v : StandardTorus d) :
    ((∑ q ∈ QR, rc q * (torusCharacter (fr q).1 (u - ((l : ℕ) : ℤ) • v) *
        torusCharacter (fr q).2 v)) * (∑ k ∈ F l, a l k * torusCharacter (n l k) u)) *
      ∏ j ∈ Finset.univ.erase l, (∑ k ∈ F j, a j k * torusCharacter (n j k)
        (u + ((j : ℤ) - (l : ℤ)) • v)) =
    ∑ x ∈ QR ×ˢ Fintype.piFinset F, (rc x.1 * ∏ j, a j (x.2 j)) *
      (torusCharacter ((fr x.1).1 + ∑ j, n j (x.2 j)) u *
        torusCharacter (((fr x.1).2 + ∑ j : Fin 4, (((j : ℕ) : ℤ) - 0) • n j (x.2 j)) -
          ((l : ℕ) : ℤ) • ((fr x.1).1 + ∑ j, n j (x.2 j))) v) := by
  have h := four_product_expand 0 QR rc fr F a n (u - ((l : ℕ) : ℤ) • v) v
  have hpt : ∀ j : Fin 4, u - ((l : ℕ) : ℤ) • v + (((j : ℕ) : ℤ) - 0) • v =
      u + ((j : ℤ) - (l : ℤ)) • v := fun j => by
    rw [sub_zero, sub_smul]; abel
  simp_rw [hpt] at h
  rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ l)] at h
  have hl : u + ((l : ℤ) - (l : ℤ)) • v = u := by simp
  rw [hl] at h
  rw [mul_assoc, h]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [sub_eq_add_neg u, torusCharacter_add, ← neg_smul, torusCharacter_zsmul,
    torusCharacter_sub]
  rw [show -((l : ℕ) : ℤ) • ((fr x.1).1 + ∑ j, n j (x.2 j)) =
    -(((l : ℕ) : ℤ) • ((fr x.1).1 + ∑ j, n j (x.2 j))) by rw [neg_smul]]
  have hneg : ∀ (m : Fin d → ℤ) (y : StandardTorus d),
      torusCharacter (-m) y = starRingEnd ℂ (torusCharacter m y) := by
    intro m y
    have := torusCharacter_sub 0 m y
    rw [zero_sub, torusCharacter_zero, one_mul] at this
    exact this
  rw [hneg]
  ring

end ReAnchor

/-- Indicators of the half-open cell may be dropped in the local form of the cell. -/
theorem form_indicator_cell {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ) :
    localProgressionForm r w (fun j => (Set.Ico a₀ (a₀ + r)).indicator (f j)) =
      localProgressionForm r w f := by
  have hm := mul_pos κ.margin_pos hr
  unfold localProgressionForm
  congr 1
  refine integral_congr_ae (Filter.Eventually.of_forall fun z => ?_)
  by_cases hz : w z = 0
  · simp [hz]
  · simp only
    congr 1
    refine Finset.prod_congr rfl fun j _ => ?_
    have := hw.support z hz j
    rw [Set.indicator_of_mem (show realProgressionCoordinate j z ∈ Set.Ico a₀ (a₀ + r) from
      ⟨by linarith [this.1], by linarith [this.2]⟩)]

section ReferenceBounds
variable {κ : LocalKernelClass} {a₀ r : ℝ} {w : ℝ × ℝ → ℂ}

/-- The kernel sample of the four-core test at real frequencies `(A, B)`. -/
noncomputable def fourK (a₀ r : ℝ) (w : ℝ × ℝ → ℂ) (x₀ A B : ℝ) : ℂ :=
  (Real.fourierChar (A * (a₀ + r / 2 - x₀)) : ℂ) *
    kernelFT (unitKernel a₀ r w) (-(r * A)) (-(r * B))

/-- Blueprint lines 2523-2526 (reference value on the coset): if `r|A - A'|, r|B - B'| ≤ ε₁` and
`x₀` lies in the cell, the four-core kernel samples differ by at most
`(π C₀ + 2 L_W) ε₁` with `C₀ = kerC 0` and `L_W` the Lipschitz constant of the unit kernel. -/
theorem fourK_close (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) {x₀ : ℝ}
    (hx₀ : x₀ ∈ Set.Icc a₀ (a₀ + r)) {A B A' B' ε₁ : ℝ} (hA : r * |A - A'| ≤ ε₁)
    (hB : r * |B - B'| ≤ ε₁) :
    ‖fourK a₀ r w x₀ A B - fourK a₀ r w x₀ A' B'‖ ≤
      (Real.pi * kerC κ 0 + 2 * (2 * 4 * (2 * 4 * (2 * Real.pi * 4 * kernelDerivBound κ 0)))) *
        ε₁ := by
  unfold fourK
  set e1 := (Real.fourierChar (A * (a₀ + r / 2 - x₀)) : ℂ)
  set e2 := (Real.fourierChar (A' * (a₀ + r / 2 - x₀)) : ℂ)
  set W1 := kernelFT (unitKernel a₀ r w) (-(r * A)) (-(r * B))
  set W2 := kernelFT (unitKernel a₀ r w) (-(r * A')) (-(r * B'))
  have hA0 : 0 ≤ kernelDerivBound κ 0 := (norm_nonneg _).trans ((unitKernel_bounds hr hw).dx 0 0 0)
  have hε₁ : 0 ≤ ε₁ := le_trans (mul_nonneg hr.le (abs_nonneg _)) hA
  have hW2 : ‖W2‖ ≤ kerC κ 0 := by
    have := kernelFT_mul_le_kerC hr hw 0 (-(r * A')) (-(r * B'))
    simpa using this
  have hph : ‖e1 - e2‖ ≤ Real.pi * ε₁ := by
    have e : e1 - e2 = e2 * ((Real.fourierChar ((A - A') * (a₀ + r / 2 - x₀)) : ℂ) - 1) := by
      rw [mul_sub, mul_one]
      congr 1
      rw [show e2 = (Real.fourierChar (A' * (a₀ + r / 2 - x₀)) : ℂ) from rfl,
        show e1 = (Real.fourierChar (A * (a₀ + r / 2 - x₀)) : ℂ) from rfl,
        ← Circle.coe_mul, ← AddChar.map_add_eq_mul]
      congr 3; ring
    rw [e, norm_mul, show e2 = (Real.fourierChar (A' * (a₀ + r / 2 - x₀)) : ℂ) from rfl,
      Circle.norm_coe, one_mul]
    refine (chart_fourierChar_sub_one_norm_le _).trans ?_
    have hx : |a₀ + r / 2 - x₀| ≤ r / 2 := by
      rw [abs_le]; constructor <;> linarith [hx₀.1, hx₀.2]
    rw [abs_mul]
    calc 2 * Real.pi * (|A - A'| * |a₀ + r / 2 - x₀|) ≤ 2 * Real.pi * (|A - A'| * (r / 2)) := by
          gcongr
      _ = Real.pi * (r * |A - A'|) := by ring
      _ ≤ Real.pi * ε₁ := by gcongr
  have hW : ‖W1 - W2‖ ≤ 2 * 4 * (2 * 4 * (2 * Real.pi * 4 * (2 * ε₁) * kernelDerivBound κ 0)) := by
    refine ((unitKernel_bounds hr hw).kernelFT_lipschitz (by norm_num) _ _ _ _).trans ?_
    have h1 : |-(r * A) - -(r * A')| ≤ ε₁ := by
      rw [show -(r * A) - -(r * A') = -(r * (A - A')) by ring, abs_neg, abs_mul, abs_of_pos hr]
      exact hA
    have h2 : |-(r * B) - -(r * B')| ≤ ε₁ := by
      rw [show -(r * B) - -(r * B') = -(r * (B - B')) by ring, abs_neg, abs_mul, abs_of_pos hr]
      exact hB
    gcongr
    linarith
  have e : e1 * W1 - e2 * W2 = e1 * (W1 - W2) + (e1 - e2) * W2 := by ring
  rw [e]
  refine (norm_add_le _ _).trans ?_
  rw [norm_mul, norm_mul, Circle.norm_coe, one_mul]
  calc ‖W1 - W2‖ + ‖e1 - e2‖ * ‖W2‖ ≤
      2 * 4 * (2 * 4 * (2 * Real.pi * 4 * (2 * ε₁) * kernelDerivBound κ 0)) +
        Real.pi * ε₁ * kerC κ 0 := by
        gcongr
    _ = _ := by ring

/-- Blueprint lines 2523-2526 (other cosets have rapidly decreasing Fourier tails): if
`r|A| ≥ H` or `r|B| ≥ H` with `H ≥ 1`, the sample is at most `C_J H^{-J}`. -/
theorem fourK_far (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w) (x₀ : ℝ) (J : ℕ)
    {A B H : ℝ} (hH : 1 ≤ H) (hfar : H ≤ r * |A| ∨ H ≤ r * |B|) :
    ‖fourK a₀ r w x₀ A B‖ ≤ kerC κ J * (H ^ J)⁻¹ := by
  unfold fourK
  rw [norm_mul, Circle.norm_coe, one_mul]
  have h := kernelFT_mul_le_kerC hr hw J (-(r * A)) (-(r * B))
  have hM : H ≤ max 1 (max |-(r * A)| |-(r * B)|) := by
    rw [abs_neg, abs_neg, abs_mul, abs_mul, abs_of_pos hr]
    rcases hfar with h1 | h1
    · exact h1.trans ((le_max_left _ _).trans (le_max_right _ _))
    · exact h1.trans ((le_max_right _ _).trans (le_max_right _ _))
  have hHJ : 0 < H ^ J := pow_pos (by linarith) _
  rw [← div_eq_mul_inv, le_div_iff₀ hHJ]
  exact (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by linarith) hM J) (norm_nonneg _)).trans h

end ReferenceBounds

section ReferenceHyps
variable {κ : LocalKernelClass} {a₀ r : ℝ} {w : ℝ × ℝ → ℂ}

/-- Blueprint lines 2523-2526 (the reference coset of a tested four-core tuple): if the expansion
frequencies on the reference coset are within `ε₁/r` of the reference `(A₀, B₀)` and off it at
distance at least `H/r` in one coordinate, with a moderate reference `r|A₀|, r|B₀| ≤ U` and
`H - U ≥ 1`, then the kernel samples satisfy the coset hypotheses of the four-core test with
`ε = (π C₀ + 2 L_W) ε₁` and `τ = C_J (H - U)^{-J}`. -/
theorem fourK_reference {ι : Type*} (hr : 0 < r) (hw : IsAdmissibleLocalKernel κ a₀ r w)
    {x₀ : ℝ} (hx₀ : x₀ ∈ Set.Icc a₀ (a₀ + r)) (P : Finset ι) (near : ι → Prop) (A B : ι → ℝ)
    {A₀ B₀ ε₁ H U : ℝ} (J : ℕ)
    (hnear : ∀ x ∈ P, near x → r * |A x - A₀| ≤ ε₁ ∧ r * |B x - B₀| ≤ ε₁)
    (hfar : ∀ x ∈ P, ¬ near x → H ≤ r * |A x - A₀| ∨ H ≤ r * |B x - B₀|)
    (hA₀ : r * |A₀| ≤ U) (hB₀ : r * |B₀| ≤ U) (hHU : 1 ≤ H - U) :
    (∀ x ∈ P, near x → ‖fourK a₀ r w x₀ (A x) (B x) - fourK a₀ r w x₀ A₀ B₀‖ ≤
      (Real.pi * kerC κ 0 + 2 * (2 * 4 * (2 * 4 * (2 * Real.pi * 4 * kernelDerivBound κ 0)))) *
        ε₁) ∧
    (∀ x ∈ P, ¬ near x → ‖fourK a₀ r w x₀ (A x) (B x)‖ ≤ kerC κ J * ((H - U) ^ J)⁻¹) := by
  refine ⟨fun x hx hn => fourK_close hr hw hx₀ (hnear x hx hn).1 (hnear x hx hn).2,
    fun x hx hn => fourK_far hr hw x₀ J hHU ?_⟩
  have tri : ∀ a a₀ : ℝ, r * |a - a₀| ≤ r * |a| + r * |a₀| := fun a a₀ => by
    rw [← mul_add]; exact mul_le_mul_of_nonneg_left (abs_sub _ _) hr.le
  rcases hfar x hx hn with h | h
  · left; linarith [tri (A x) A₀]
  · right; linarith [tri (B x) B₀]

end ReferenceHyps

section FourCorePrincipal
variable {d : ℕ}

/-- The horizontal torus frequency of a term of the four-core expansion
(multiplier frequency `L v₁` plus the four role frequencies `Q₀ L v_j + n_{j,k}`). -/
def expP1 (L QL : ℕ) {ι : Fin 4 → Type*} (n : ∀ j, ι j → Fin d → ℤ)
    (x : (Fin (d + d) → ℤ) × ∀ j, (Fin d → ℤ) × ι j) : Fin d → ℤ :=
  ((L : ℤ) • fun a => x.1 (Fin.castAdd d a)) + ∑ j, ((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2)

/-- The vertical torus frequency of a term of the four-core expansion (anchor `0`). -/
def expP2 (L QL : ℕ) {ι : Fin 4 → Type*} (n : ∀ j, ι j → Fin d → ℤ)
    (x : (Fin (d + d) → ℤ) × ∀ j, (Fin d → ℤ) × ι j) : Fin d → ℤ :=
  ((L : ℤ) • fun a => x.1 (Fin.natAdd d a)) +
    ∑ j : Fin 4, (((j : ℕ) : ℤ) - 0) • ((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2)

end FourCorePrincipal

open Classical in
/-- Blueprint lines 2482-2486 ("for every character difference needed below, `r n·ξ` is tiny if
`n ∈ K_B` and huge otherwise"): for the tiny span `K_B` of the pure frequency vector `ϑ` of a
nonexceptional primary (gap `eq:gap` at height `H`), an integer vector of height at most `H` in
`K_B ∩ ℤ^d` is tiny, and one outside is huge. -/
theorem gap_coset {d : ℕ} (ϑ : Fin d → ℝ) {H : ℕ} (hH : 1 ≤ H) {ε Λ : ℝ} (hε : 0 ≤ ε)
    (hgap : ∀ a : Fin d → ℚ, vecHeight a ≤ H → |ratEval ϑ a| ≤ ε ∨ Λ ≤ |ratEval ϑ a|)
    (hsmall : (3 * H ^ 2 : ℝ) ^ d * (d.factorial * H ^ (d ^ 2 + d)) * ε < Λ)
    (n : Fin d → ℤ) (hn : vecHeight (fun i => (n i : ℚ)) ≤ H) :
    (n ∈ rationalIntegerIntersection (tinySpan ϑ H ε) → |∑ i, (n i : ℝ) * ϑ i| ≤ ε) ∧
      (n ∉ rationalIntegerIntersection (tinySpan ϑ H ε) → Λ ≤ |∑ i, (n i : ℝ) * ϑ i|) := by
  have hev : ratEval ϑ (fun i => (n i : ℚ)) = ∑ i, (n i : ℝ) * ϑ i := by
    simp only [ratEval]; push_cast; rfl
  refine ⟨fun hmem => ?_, fun hmem => ?_⟩
  · have h := tiny_of_mem_tinySpan ϑ hH hε hgap hsmall (a := fun i => (n i : ℚ)) hmem hn
    rwa [hev] at h
  · rcases hgap _ hn with h | h
    · exfalso
      apply hmem
      exact Submodule.subset_span ⟨hn, h⟩
    · rwa [hev] at h

/-- The normalized cell average in the variable `t ∈ [0, 1]` is the cell average in `y`. -/
theorem cell_average_change {a₀ r : ℝ} (hr : 0 < r) (g : ℝ → ℝ) :
    ∫ t in (0 : ℝ)..1, g (a₀ + r * t) = r⁻¹ * ∫ y in a₀..a₀ + r, g y := by
  have h := intervalIntegral.integral_comp_mul_left (a := 0) (b := 1)
    (fun y => g (a₀ + y)) hr.ne'
  simp only [mul_zero, mul_one] at h
  rw [h, intervalIntegral.integral_comp_add_left, add_zero, smul_eq_mul]

section FirstSuccessBound
variable {m₀ : ℕ}

open Classical in
/-- Blueprint lines 2566-2582 (the core terms over failure histories): if, for every trial count,
assignment, failed word and final height, the masked tuple sum is at most a principal quantity
`Ψ` plus the per-tuple numerical errors `e`, and the averages of `Ψ` over the words and final
heights obey the moment bound `C (ρ^n)^{1/m₀} Z` (`word_moment_bound`), then with
`m₀ ρ^{1/m₀} < 1` the full
tuple sum is at most `C Z / (1 - m₀ ρ^{1/m₀}) + Σ_r e_r` (each pure tuple has first-success
weight one, `first_success_masked`; the assignments are summed as in
`assignments_total`). -/
theorem first_success_bound {κ : Fin m₀ → Type*} (T : ∀ j, Finset (κ j)) (H : Finset ℕ)
    (good : ∀ j, ℕ → κ j → Prop) (f : (∀ j, κ j) → ℂ) (e : (∀ j, κ j) → ℝ)
    (hp : ∀ r ∈ Fintype.piFinset T, (H.filter fun h => ∀ j, good j h (r j)).Nonempty)
    (Ψ : (n : ℕ) → (Fin n → Fin m₀) → (Fin n → ℕ) → ℕ → ℝ)
    (hterm : ∀ n (a : Fin n → Fin m₀), ∀ w ∈ Fintype.piFinset (fun _ : Fin n => H), ∀ h ∈ H,
      ‖∑ r ∈ (Fintype.piFinset T).filter (fun r => ∀ j, roleMask (good j) j a w h (r j)), f r‖ ≤
        Ψ n a w h + ∑ r ∈ (Fintype.piFinset T).filter
          (fun r => ∀ j, roleMask (good j) j a w h (r j)), e r)
    {C Z ρ : ℝ} (hρ : 0 ≤ ρ) (hq : (m₀ : ℝ) * ρ ^ (1 / (m₀ : ℝ)) < 1)
    (hmom : ∀ n (a : Fin n → Fin m₀), ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ∑ h ∈ H,
      ((H.card : ℝ) ^ (n + 1))⁻¹ * Ψ n a w h ≤ C * (ρ ^ n) ^ (1 / (m₀ : ℝ)) * Z) :
    ‖∑ r ∈ Fintype.piFinset T, f r‖ ≤
      C * Z / (1 - (m₀ : ℝ) * ρ ^ (1 / (m₀ : ℝ))) + ∑ r ∈ Fintype.piFinset T, e r := by
  set q := (m₀ : ℝ) * ρ ^ (1 / (m₀ : ℝ))
  have hq0 : 0 ≤ q := mul_nonneg (Nat.cast_nonneg _) (Real.rpow_nonneg hρ _)
  have hF := first_success_masked T H good f hp
  have hE := first_success_masked T H good (E := ℝ) e hp
  set Eₙ : ℕ → ℝ := fun n => ∑ a : Fin n → Fin m₀, ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H),
    ∑ h ∈ H, ((H.card : ℝ) ^ (n + 1))⁻¹ • ∑ r ∈ (Fintype.piFinset T).filter
      (fun r => ∀ j, roleMask (good j) j a w h (r j)), e r
  have hgeo : HasSum (fun n : ℕ => C * Z * q ^ n) (C * Z / (1 - q)) := by
    have := (hasSum_geometric_of_lt_one hq0 hq).mul_left (C * Z)
    rwa [div_eq_mul_inv]
  have hb : HasSum (fun n => C * Z * q ^ n + Eₙ n)
      (C * Z / (1 - q) + ∑ r ∈ Fintype.piFinset T, e r) :=
    hgeo.add hE
  have hpow : ∀ n : ℕ, (ρ ^ n) ^ (1 / (m₀ : ℝ)) = (ρ ^ (1 / (m₀ : ℝ))) ^ n := fun n => by
    rw [← Real.rpow_natCast, ← Real.rpow_natCast, ← Real.rpow_mul hρ, ← Real.rpow_mul hρ, mul_comm]
  rw [← hF.tsum_eq]
  refine tsum_of_norm_bounded hb fun n => ?_
  refine (norm_sum_le _ _).trans ?_
  have hW : 0 ≤ ((H.card : ℝ) ^ (n + 1))⁻¹ := by positivity
  have hstep : ∀ a : Fin n → Fin m₀, ‖∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ∑ h ∈ H,
      ((H.card : ℝ) ^ (n + 1))⁻¹ • ∑ r ∈ (Fintype.piFinset T).filter
        (fun r => ∀ j, roleMask (good j) j a w h (r j)), f r‖ ≤
      C * (ρ ^ n) ^ (1 / (m₀ : ℝ)) * Z + ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ∑ h ∈ H,
        ((H.card : ℝ) ^ (n + 1))⁻¹ • ∑ r ∈ (Fintype.piFinset T).filter
          (fun r => ∀ j, roleMask (good j) j a w h (r j)), e r := by
    intro a
    refine (norm_sum_le _ _).trans ?_
    have h1 : ∀ w ∈ Fintype.piFinset (fun _ : Fin n => H), ‖∑ h ∈ H,
        ((H.card : ℝ) ^ (n + 1))⁻¹ • ∑ r ∈ (Fintype.piFinset T).filter
          (fun r => ∀ j, roleMask (good j) j a w h (r j)), f r‖ ≤
        ∑ h ∈ H, (((H.card : ℝ) ^ (n + 1))⁻¹ * Ψ n a w h +
          ((H.card : ℝ) ^ (n + 1))⁻¹ • ∑ r ∈ (Fintype.piFinset T).filter
            (fun r => ∀ j, roleMask (good j) j a w h (r j)), e r) := by
      intro w hw
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun h hh => ?_)
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hW, smul_eq_mul, ← mul_add]
      exact mul_le_mul_of_nonneg_left (hterm n a w hw h hh) hW
    refine (Finset.sum_le_sum h1).trans ?_
    simp only [Finset.sum_add_distrib]
    exact add_le_add (hmom n a) le_rfl
  calc ∑ a : Fin n → Fin m₀, ‖∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ∑ h ∈ H,
        ((H.card : ℝ) ^ (n + 1))⁻¹ • ∑ r ∈ (Fintype.piFinset T).filter
          (fun r => ∀ j, roleMask (good j) j a w h (r j)), f r‖ ≤
      ∑ a : Fin n → Fin m₀, (C * (ρ ^ n) ^ (1 / (m₀ : ℝ)) * Z +
        ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ∑ h ∈ H,
          ((H.card : ℝ) ^ (n + 1))⁻¹ • ∑ r ∈ (Fintype.piFinset T).filter
            (fun r => ∀ j, roleMask (good j) j a w h (r j)), e r) :=
        Finset.sum_le_sum fun a _ => hstep a
    _ = C * Z * q ^ n + Eₙ n := by
        rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fun,
          Fintype.card_fin, Fintype.card_fin, nsmul_eq_mul, hpow]
        simp only [q, Eₙ, mul_pow]
        push_cast
        ring

end FirstSuccessBound

/-- `word_moment_bound` for nonnegative real role sizes. -/
theorem word_moment_bound_real (H : Finset ℕ) (n : ℕ) {m₀ : ℕ} (hm : 2 ≤ m₀)
    (A : Fin m₀ → (Fin n → ℕ) → ℝ) (hA0 : ∀ j w, 0 ≤ A j w) {C ρ : ℝ} (hC : 1 ≤ C)
    (hρ : 0 ≤ ρ) (σ : Fin m₀ → ℝ) (hσ : ∀ j, 0 ≤ σ j) (nj : Fin m₀ → ℕ)
    (hdet : ∀ j, ∀ w ∈ Fintype.piFinset (fun _ : Fin n => H), A j w ≤ C * σ j)
    (hsq : ∀ j, ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H),
      ((H.card : ℝ) ^ n)⁻¹ * A j w ^ 2 ≤ C * ρ ^ nj j * σ j ^ 2) :
    ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ((H.card : ℝ) ^ n)⁻¹ * ∏ j, A j w ≤
      C ^ m₀ * (ρ ^ (∑ j, nj j)) ^ (1 / (m₀ : ℝ)) * ∏ j, σ j := by
  set W := Fintype.piFinset (fun _ : Fin n => H)
  have hC0 : 0 ≤ C := by linarith
  have hR : 0 ≤ C ^ m₀ * (ρ ^ (∑ j, nj j)) ^ (1 / (m₀ : ℝ)) * ∏ j, σ j :=
    mul_nonneg (mul_nonneg (pow_nonneg hC0 _) (Real.rpow_nonneg (pow_nonneg hρ _) _))
      (Finset.prod_nonneg fun j _ => hσ j)
  -- the degenerate case: no words
  by_cases hW : W = ∅
  · rw [hW, Finset.sum_empty]; exact hR
  have hcard : 0 < (H.card : ℝ) ^ n := by
    rcases Nat.eq_zero_or_pos n with hn | hn
    · subst hn; simp
    · have hH : H.Nonempty := by
        obtain ⟨w, hw⟩ := Finset.nonempty_iff_ne_empty.mpr hW
        exact ⟨w ⟨0, hn⟩, Fintype.mem_piFinset.mp hw _⟩
      exact pow_pos (by exact_mod_cast hH.card_pos) _
  have hinv : ((H.card : ℝ≥0∞) ^ n)⁻¹ = ENNReal.ofReal (((H.card : ℝ) ^ n)⁻¹) := by
    rw [ENNReal.ofReal_inv_of_pos hcard, ENNReal.ofReal_pow (Nat.cast_nonneg _),
      ENNReal.ofReal_natCast]
  set A' : Fin m₀ → (Fin n → ℕ) → ℝ≥0∞ := fun j w => ENNReal.ofReal (A j w)
  have hdet' : ∀ j, ∀ w ∈ W, A' j w ≤ ENNReal.ofReal C * ENNReal.ofReal (σ j) := by
    intro j w hw
    rw [← ENNReal.ofReal_mul hC0]
    exact ENNReal.ofReal_le_ofReal (hdet j w hw)
  have hsq' : ∀ j, ∑ w ∈ W, ((H.card : ℝ≥0∞) ^ n)⁻¹ * A' j w ^ 2 ≤
      ENNReal.ofReal C * ENNReal.ofReal ρ ^ nj j * ENNReal.ofReal (σ j) ^ 2 := by
    intro j
    rw [hinv]
    have e : ∑ w ∈ W, ENNReal.ofReal (((H.card : ℝ) ^ n)⁻¹) * A' j w ^ 2 =
        ENNReal.ofReal (∑ w ∈ W, ((H.card : ℝ) ^ n)⁻¹ * A j w ^ 2) := by
      rw [ENNReal.ofReal_sum_of_nonneg fun w _ => by positivity]
      refine Finset.sum_congr rfl fun w _ => ?_
      simp only [A']
      rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_pow (hA0 j w)]
    rw [e, ← ENNReal.ofReal_pow hρ, ← ENNReal.ofReal_pow (hσ j), ← ENNReal.ofReal_mul hC0,
      ← ENNReal.ofReal_mul (by positivity)]
    exact ENNReal.ofReal_le_ofReal (hsq j)
  have h := word_moment_bound H n hm A' (ENNReal.one_le_ofReal.mpr hC)
    (fun j => ENNReal.ofReal (σ j)) nj hdet' hsq'
  rw [hinv] at h
  have eL : ∑ w ∈ W, ENNReal.ofReal (((H.card : ℝ) ^ n)⁻¹) * ∏ j, A' j w =
      ENNReal.ofReal (∑ w ∈ W, ((H.card : ℝ) ^ n)⁻¹ * ∏ j, A j w) := by
    rw [ENNReal.ofReal_sum_of_nonneg fun w _ => mul_nonneg (by positivity)
      (Finset.prod_nonneg fun j _ => hA0 j w)]
    refine Finset.sum_congr rfl fun w _ => ?_
    rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_prod_of_nonneg fun j _ => hA0 j w]
  have eR : ENNReal.ofReal C ^ m₀ * (ENNReal.ofReal ρ ^ (∑ j, nj j)) ^ (1 / (m₀ : ℝ)) *
      ∏ j, ENNReal.ofReal (σ j) =
      ENNReal.ofReal (C ^ m₀ * (ρ ^ (∑ j, nj j)) ^ (1 / (m₀ : ℝ)) * ∏ j, σ j) := by
    rw [ENNReal.ofReal_mul (mul_nonneg (pow_nonneg hC0 _) (Real.rpow_nonneg (pow_nonneg hρ _) _)),
      ENNReal.ofReal_mul (pow_nonneg hC0 _), ENNReal.ofReal_pow hC0,
      ENNReal.ofReal_prod_of_nonneg fun j _ => hσ j,
      ← ENNReal.ofReal_rpow_of_nonneg (pow_nonneg hρ _) (by positivity), ENNReal.ofReal_pow hρ]
  rw [eL, eR] at h
  exact (ENNReal.ofReal_le_ofReal_iff hR).mp h

/-- The assigned counts of the roles add up to the number of failed trials. -/
theorem sum_assigned_card {m₀ n : ℕ} (a : Fin n → Fin m₀) :
    ∑ j, (Finset.univ.filter fun i => a i = j).card = n := by
  rw [← Finset.card_eq_sum_card_fiberwise (fun i _ => Finset.mem_univ (a i)), Finset.card_univ,
    Fintype.card_fin]

open Classical in
/-- Blueprint lines 2568-2575 (Hölder with `m₀` factors over the words, then the final heights):
if the principal quantity of a word and final height is `Σ_p c_p Π_j a'_{j,p}(w)` with role sizes
`a'_{j,p} ≤ 2 σ_{j,p}` and word averages of `a'_{j,p}²` at most `2 ρ^{n_j} σ_{j,p}²`, then its
average over the words and final heights is at most `2^{m₀} (ρ^n)^{1/m₀} Z`, with
`Z = Σ_h |H|⁻¹ Σ_p c_p Π_j σ_{j,p}`. -/
theorem principal_word_average (H : Finset ℕ) {m₀ : ℕ} (hm : 2 ≤ m₀) {n : ℕ}
    (a : Fin n → Fin m₀) {π : ℕ → Type*} (Pset : ∀ h, Finset (π h)) (cf : ∀ h, π h → ℝ)
    (hcf : ∀ h, ∀ p ∈ Pset h, 0 ≤ cf h p) (A : ∀ h, π h → Fin m₀ → (Fin n → ℕ) → ℝ)
    (hA0 : ∀ h p j w, 0 ≤ A h p j w) (σ : ∀ h, π h → Fin m₀ → ℝ) (hσ : ∀ h p j, 0 ≤ σ h p j)
    {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hdet : ∀ h ∈ H, ∀ p ∈ Pset h, ∀ j, ∀ w ∈ Fintype.piFinset (fun _ : Fin n => H),
      A h p j w ≤ 2 * σ h p j)
    (hsq : ∀ h ∈ H, ∀ p ∈ Pset h, ∀ j, ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H),
      ((H.card : ℝ) ^ n)⁻¹ * A h p j w ^ 2 ≤
        2 * ρ ^ (Finset.univ.filter fun i => a i = j).card * σ h p j ^ 2) :
    ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ∑ h ∈ H, ((H.card : ℝ) ^ (n + 1))⁻¹ *
      (∑ p ∈ Pset h, cf h p * ∏ j, A h p j w) ≤
      2 ^ m₀ * (ρ ^ n) ^ (1 / (m₀ : ℝ)) *
        ∑ h ∈ H, (H.card : ℝ)⁻¹ * ∑ p ∈ Pset h, cf h p * ∏ j, σ h p j := by
  set W := Fintype.piFinset (fun _ : Fin n => H)
  have hsplit : ∀ w h, ((H.card : ℝ) ^ (n + 1))⁻¹ * (∑ p ∈ Pset h, cf h p * ∏ j, A h p j w) =
      (H.card : ℝ)⁻¹ * ∑ p ∈ Pset h, cf h p * (((H.card : ℝ) ^ n)⁻¹ * ∏ j, A h p j w) := by
    intro w h
    rw [pow_succ, mul_inv, Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun p _ => by ring
  simp_rw [hsplit]
  rw [Finset.sum_comm, Finset.mul_sum]
  refine Finset.sum_le_sum fun h hh => ?_
  rw [← Finset.mul_sum, Finset.sum_comm]
  have hH0 : 0 ≤ (H.card : ℝ)⁻¹ := by positivity
  calc (H.card : ℝ)⁻¹ * ∑ p ∈ Pset h, ∑ w ∈ W, cf h p * (((H.card : ℝ) ^ n)⁻¹ *
        ∏ j, A h p j w) ≤
      (H.card : ℝ)⁻¹ * ∑ p ∈ Pset h, cf h p * (2 ^ m₀ * (ρ ^ n) ^ (1 / (m₀ : ℝ)) *
        ∏ j, σ h p j) := by
        refine mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun p hp => ?_) hH0
        rw [← Finset.mul_sum]
        refine mul_le_mul_of_nonneg_left ?_ (hcf h p hp)
        have hw := word_moment_bound_real H n hm (A h p) (hA0 h p) (by norm_num : (1 : ℝ) ≤ 2)
          hρ (σ h p) (hσ h p) (fun j => (Finset.univ.filter fun i => a i = j).card)
          (hdet h hh p hp) (hsq h hh p hp)
        rwa [sum_assigned_card] at hw
    _ = 2 ^ m₀ * (ρ ^ n) ^ (1 / (m₀ : ℝ)) * ((H.card : ℝ)⁻¹ *
        ∑ p ∈ Pset h, cf h p * ∏ j, σ h p j) := by
        rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun p _ => by ring

open Classical in
/-- Summing over the class tuples of the members of each class tuple recovers the full sum. -/
theorem sum_fiber_pi {ι : Type*} [Fintype ι] [DecidableEq ι] {κ τ : ι → Type*}
    (M : ∀ l, Finset (κ l)) (cls : ∀ l, κ l → τ l) (e : (∀ l, κ l) → ℝ) :
    ∑ p ∈ Fintype.piFinset (fun l => (M l).image (cls l)),
      ∑ r ∈ (Fintype.piFinset M).filter (fun r => ∀ l, cls l (r l) = p l), e r =
      ∑ r ∈ Fintype.piFinset M, e r := by
  have h := Finset.sum_fiberwise_of_maps_to (s := Fintype.piFinset M)
    (t := Fintype.piFinset (fun l => (M l).image (cls l))) (g := fun r l => cls l (r l))
    (fun r hr => by
      rw [Fintype.mem_piFinset] at hr ⊢
      exact fun l => Finset.mem_image_of_mem _ (hr l)) e
  rw [← h]
  refine Finset.sum_congr rfl fun p _ => ?_
  refine Finset.sum_congr (Finset.filter_congr fun r _ => ?_) fun _ _ => rfl
  exact funext_iff.symm

/-- The local form integrand of measurable inputs bounded on the cell is integrable. -/
theorem form_integrable_of_bounded {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (f : Fin 4 → ℝ → ℂ)
    (hfm : ∀ j, Measurable (f j)) (M : Fin 4 → ℝ)
    (hfb : ∀ j, ∀ y ∈ Set.Icc a₀ (a₀ + r), ‖f j y‖ ≤ M j) :
    Integrable (fun z : ℝ × ℝ => w z * ∏ j, f j (realProgressionCoordinate j z)) := by
  have hm := mul_nonneg κ.margin_pos.le hr.le
  have hwi := admissible_integrable hr hw
  have hM : ∀ j, 0 ≤ M j := fun j => (norm_nonneg _).trans (hfb j a₀ ⟨le_rfl, by linarith⟩)
  refine (hwi.norm.mul_const (∏ j, M j)).mono' ?_ (Filter.Eventually.of_forall fun z => ?_)
  · refine hw.smooth.continuous.aestronglyMeasurable.mul ?_
    have : Measurable fun z : ℝ × ℝ => ∏ j, f j (realProgressionCoordinate j z) :=
      Finset.measurable_prod _ fun j _ =>
        (hfm j).comp (continuous_realProgressionCoordinate j).measurable
    exact this.aestronglyMeasurable
  · rw [norm_mul, norm_prod]
    by_cases hz : w z = 0
    · rw [hz, norm_zero, zero_mul, zero_mul]
    refine mul_le_mul_of_nonneg_left (Finset.prod_le_prod₀ (fun j _ => norm_nonneg _)
      fun j _ => hfb j _ ?_) (norm_nonneg _)
    have := hw.support z hz j
    exact ⟨by linarith [this.1], by linarith [this.2]⟩

/-- The height of a vector padded by zeros in front. -/
theorem vecHeight_append_zero {d d' : ℕ} (a : Fin d' → ℚ) :
    vecHeight (Fin.append (0 : Fin d → ℚ) a) ≤ max 1 (vecHeight a) := by
  unfold vecHeight
  refine Finset.sup_le fun i _ => ?_
  refine Fin.addCases (fun k => ?_) (fun k => ?_) i
  · rw [Fin.append_left]
    have : rationalHeight (0 : ℚ) = 1 := rfl
    simp only [Pi.zero_apply, this]
    exact le_max_left _ _
  · rw [Fin.append_right]
    exact (Finset.le_sup (f := fun i => rationalHeight (a i)) (Finset.mem_univ k)).trans
      (le_max_right _ _)

/-- Blueprint lines 2482-2484 ("a successful component contains a nonexceptional primary; apply
its gap `eq:gap` to pure `ϑ` shifts"): the gap of a frequency vector `Θ = (θ_v, ϑ)` at height `H`
restricts to pure `ϑ` shifts of height at most `H`. -/
theorem pure_gap_of_gap {dv dz : ℕ} (θv : Fin dv → ℝ) (ϑ : Fin dz → ℝ) {H : ℕ} (hH : 1 ≤ H)
    {ε Λ : ℝ}
    (hgap : ∀ a : Fin (dv + dz) → ℚ, vecHeight a ≤ H →
      |ratEval (Fin.append θv ϑ) a| ≤ ε ∨ Λ ≤ |ratEval (Fin.append θv ϑ) a|) :
    ∀ a : Fin dz → ℚ, vecHeight a ≤ H → |ratEval ϑ a| ≤ ε ∨ Λ ≤ |ratEval ϑ a| := by
  intro a ha
  have hh : vecHeight (Fin.append (0 : Fin dv → ℚ) a) ≤ H :=
    (vecHeight_append_zero a).trans (max_le hH ha)
  have he : ratEval (Fin.append θv ϑ) (Fin.append (0 : Fin dv → ℚ) a) = ratEval ϑ a := by
    simp only [ratEval, Fin.sum_univ_add, Fin.append_left, Fin.append_right, Pi.zero_apply,
      Rat.cast_zero, zero_mul, Finset.sum_const_zero, zero_add]
  rw [← he]
  exact hgap _ hh

/-- Integer vectors with entries bounded by `B ≥ 1` have height at most `B`. -/
theorem vecHeight_int_le {d : ℕ} (v : Fin d → ℤ) {B : ℕ} (hB : 1 ≤ B)
    (hv : ∀ i, |(v i : ℝ)| ≤ B) : vecHeight (fun i => (v i : ℚ)) ≤ B := by
  unfold vecHeight
  refine Finset.sup_le fun i _ => ?_
  have := rationalHeight_intCast_bound (v i) (B := (B : ℝ)) (by exact_mod_cast hB) (hv i)
  exact_mod_cast this

/-- Entries of the four-core expansion frequencies are bounded by the box and shift sizes. -/
theorem expP_entries_le {d : ℕ} (L QL Bx : ℕ) {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j))
    (n : ∀ j, ι j → Fin d → ℤ) {Nb : ℝ} (hn : ∀ j, ∀ k ∈ F j, ∀ i, |(n j k i : ℝ)| ≤ Nb)
    (x : (Fin (d + d) → ℤ) × ∀ j, (Fin d → ℤ) × ι j)
    (hx : x ∈ frequencyBox (d + d) Bx ×ˢ Fintype.piFinset (fun j => frequencyBox d Bx ×ˢ F j))
    (i : Fin d) :
    |(expP1 L QL n x i : ℝ)| ≤ L * Bx + 4 * (QL * Bx + Nb) ∧
      |(expP2 L QL n x i : ℝ)| ≤ L * Bx + 4 * (3 * (QL * Bx + Nb)) := by
  obtain ⟨hx1, hx2⟩ := Finset.mem_product.mp hx
  have hb1 : ∀ k : Fin (d + d), |(x.1 k : ℝ)| ≤ Bx := fun k => by
    have := Fintype.mem_piFinset.mp hx1 k
    rw [Finset.mem_Icc] at this
    rw [abs_le]; constructor <;> exact_mod_cast (by omega : _)
  have hb2 : ∀ j, |((((QL : ℤ) • (x.2 j).1 + n j (x.2 j).2) i : ℤ) : ℝ)| ≤
      (QL * Bx + Nb : ℝ) := by
    intro j
    obtain ⟨hv, hk⟩ := Finset.mem_product.mp (Fintype.mem_piFinset.mp hx2 j)
    have hvi := Fintype.mem_piFinset.mp hv i
    rw [Finset.mem_Icc] at hvi
    have hvi' : |((x.2 j).1 i : ℝ)| ≤ Bx := by
      rw [abs_le]; constructor <;> exact_mod_cast (by omega : _)
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    push_cast
    refine (abs_add_le _ _).trans (add_le_add ?_ (hn j _ hk i))
    rw [abs_mul, Nat.abs_cast]
    exact mul_le_mul_of_nonneg_left hvi' (Nat.cast_nonneg _)
  have h0 : 0 ≤ (QL * Bx + Nb : ℝ) := (abs_nonneg _).trans (hb2 0)
  constructor
  · unfold expP1
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_apply]
    push_cast
    refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
    · rw [abs_mul, Nat.abs_cast]
      exact mul_le_mul_of_nonneg_left (hb1 _) (Nat.cast_nonneg _)
    · refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      refine (Finset.sum_le_sum fun j _ => ?_).trans (le_of_eq (show
        ∑ _j : Fin 4, (QL * Bx + Nb : ℝ) = 4 * (QL * Bx + Nb) by simp; ring))
      have := hb2 j
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Int.cast_add, Int.cast_mul,
        Int.cast_natCast] at this; exact this
  · unfold expP2
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_apply]
    push_cast
    refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
    · rw [abs_mul, Nat.abs_cast]
      exact mul_le_mul_of_nonneg_left (hb1 _) (Nat.cast_nonneg _)
    · refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      refine (Finset.sum_le_sum fun j _ => ?_).trans (le_of_eq (show
        ∑ _j : Fin 4, 3 * (QL * Bx + Nb : ℝ) = 4 * (3 * (QL * Bx + Nb)) by simp))
      rw [abs_mul, sub_zero, Nat.abs_cast]
      have hj : ((j : ℕ) : ℝ) ≤ 3 := by
        have := j.isLt; exact_mod_cast (by omega : (j : ℕ) ≤ 3)
      have := hb2 j
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Int.cast_add, Int.cast_mul,
        Int.cast_natCast] at this
      exact mul_le_mul hj this (abs_nonneg _) (by norm_num)

theorem norm_torusCharacter {d : ℕ} (n : Fin d → ℤ) (x : StandardTorus d) :
    ‖torusCharacter n x‖ = 1 := by
  unfold torusCharacter
  rw [fourier_apply, Circle.norm_coe]

/-- The anchored side function `e(-c_l p_ρ(y)) f_l(y)` of the three-core reduction. -/
noncomputable def sideSd (z : ChartTag) (ρ : Fin z.dim → ℝ) (l : Fin 4) (g : ℝ → ℂ) (y : ℝ) :
    ℂ :=
  (Real.fourierChar (-(((slotCoeff l : ℤ) : ℝ) * centerPhase z ρ y)) : ℂ) * g y

/-- The truncated torus input `Σ_{(v, k) ∈ B × F_j} cc_v c_k χ_{QL v + n_k}` of a role. -/
noncomputable def coreG {d : ℕ} (QL Bx : ℕ) {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j))
    (c : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin d → ℤ) (cc : Fin 4 → (Fin d → ℤ) → ℂ) (j : Fin 4)
    (u : StandardTorus d) : ℂ :=
  ∑ p ∈ frequencyBox d Bx ×ˢ F j, (cc j p.1 * c j p.2) *
    torusCharacter ((QL : ℤ) • p.1 + n j p.2) u

/-- The truncated torus multiplier `Σ_q cm_q χ_{L q'}(u) χ_{L q''}(v)`. -/
noncomputable def coreR {d : ℕ} (L Bx : ℕ) (cm : (Fin (d + d) → ℤ) → ℂ)
    (u v : StandardTorus d) : ℂ :=
  ∑ q ∈ frequencyBox (d + d) Bx, cm q *
    (torusCharacter ((L : ℤ) • fun a => q (Fin.castAdd d a)) u *
      torusCharacter ((L : ℤ) • fun a => q (Fin.natAdd d a)) v)

/-- The re-anchored multiplier `R(u - l v, v) g_l(u)` on the annihilator of `K ∩ ℤ^d`. -/
noncomputable def coreRA {d : ℕ} (V : Submodule ℚ (Fin d → ℚ)) (L QL Bx : ℕ)
    {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j)) (c : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin d → ℤ)
    (cc : Fin 4 → (Fin d → ℤ) → ℂ) (cm : (Fin (d + d) → ℤ) → ℂ) (l : Fin 4)
    (uv : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V)) : ℂ :=
  coreR L Bx cm ((uv.1 : StandardTorus d) - ((l : ℕ) : ℤ) • (uv.2 : StandardTorus d)) uv.2 *
    coreG QL Bx F c n cc l uv.1

/-- Jensen for the square root on a probability space: `E √X ≤ √(E X)`. -/
theorem integral_sqrt_le {α : Type*} [MeasurableSpace α] (μ : Measure α) [IsProbabilityMeasure μ]
    {X : α → ℝ} (hX0 : ∀ x, 0 ≤ X x) (hXi : Integrable X μ) :
    Integrable (fun x => Real.sqrt (X x)) μ ∧
      ∫ x, Real.sqrt (X x) ∂μ ≤ Real.sqrt (∫ x, X x ∂μ) := by
  have hint : Integrable (fun x => Real.sqrt (X x)) μ := by
    refine Integrable.mono' ((hXi.add (integrable_const 1)).div_const 2)
      (Real.continuous_sqrt.comp_aestronglyMeasurable hXi.aestronglyMeasurable)
      (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _)]
    change Real.sqrt (X x) ≤ (X x + 1) / 2
    have h1 := Real.sq_sqrt (hX0 x)
    nlinarith [sq_nonneg (Real.sqrt (X x) - 1)]
  refine ⟨hint, ?_⟩
  have hI0 : 0 ≤ ∫ x, X x ∂μ := integral_nonneg hX0
  rcases hI0.lt_or_eq with hpos | hzero
  · set t := Real.sqrt (∫ x, X x ∂μ) with ht
    have htp : 0 < t := Real.sqrt_pos.mpr hpos
    have htt : t * t = ∫ x, X x ∂μ := Real.mul_self_sqrt hI0
    have hpt : ∀ x, Real.sqrt (X x) ≤ (X x / t + t) / 2 := fun x => by
      have h1 := Real.sq_sqrt (hX0 x)
      rw [div_add' _ _ _ htp.ne', div_div, le_div_iff₀ (by positivity)]
      nlinarith [sq_nonneg (Real.sqrt (X x) - t)]
    calc ∫ x, Real.sqrt (X x) ∂μ ≤ ∫ x, (X x / t + t) / 2 ∂μ :=
          integral_mono hint (((hXi.div_const t).add (integrable_const t)).div_const 2) hpt
      _ = ((∫ x, X x ∂μ) / t + t) / 2 := by
          rw [integral_div, integral_add (hXi.div_const t) (integrable_const t), integral_div,
            integral_const, probReal_univ, one_smul]
      _ = t := by rw [← htt]; field_simp; ring
  · have hae : X =ᵐ[μ] 0 := (integral_eq_zero_iff_of_nonneg hX0 hXi).mp hzero.symm
    have : ∫ x, Real.sqrt (X x) ∂μ = 0 := by
      rw [integral_congr_ae (g := fun _ => (0 : ℝ))
        (hae.mono fun x hx => by simp only [hx, Pi.zero_apply, Real.sqrt_zero])]
      simp
    rw [this]; exact Real.sqrt_nonneg _

/-- The cell Fourier coefficient `∫_I S(y) e(k y / r) dy` is `r` times the interval Fourier
coefficient of `S` at `-k`. -/
theorem cell_coeff_eq_fourierCoeffOn {a r : ℝ} (hr : 0 < r) (S : ℝ → ℂ) (k : ℤ) :
    ∫ y in Set.Ico a (a + r), S y * Complex.exp (2 * Real.pi * Complex.I * k * y / r) =
      r * fourierCoeffOn (lt_add_of_pos_right a hr) S (-k) := by
  have : Fact (0 < r) := ⟨hr⟩
  rw [fourierCoeffOn_eq_integral S (-k) (lt_add_of_pos_right a hr), neg_neg,
    add_sub_cancel_left, intervalIntegral.integral_of_le (lt_add_of_pos_right a hr).le,
    ← integral_Ico_eq_integral_Ioc, Complex.real_smul, ← mul_assoc]
  push_cast
  rw [mul_one_div_cancel (by exact_mod_cast hr.ne'), one_mul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  simp only [fourier_coe_apply, smul_eq_mul]
  ring_nf

/-- Bessel's inequality for the cell Fourier coefficients of a square-integrable side function:
`Σ_{k ∈ s} |∫_I S(y) e(k y / r) dy|² ≤ r ∫_I |S|²` (blueprint lines 2556-2560, the side windows
`b_Λ`). -/
theorem cell_coeff_bessel {a r : ℝ} (hr : 0 < r) (S : ℝ → ℂ)
    (hL2 : MemLp S 2 (volume.restrict (Set.Ioc a (a + r)))) (s : Finset ℤ) :
    ∑ k ∈ s, ‖∫ y in Set.Ico a (a + r), S y *
        Complex.exp (2 * Real.pi * Complex.I * k * y / r)‖ ^ 2 ≤
      r * ∫ y in a..a + r, ‖S y‖ ^ 2 := by
  have hab := lt_add_of_pos_right a hr
  have hs := hasSum_sq_fourierCoeffOn hab hL2
  simp only [add_sub_cancel_left, smul_eq_mul] at hs
  have e : ∀ k ∈ s, ‖∫ y in Set.Ico a (a + r), S y *
      Complex.exp (2 * Real.pi * Complex.I * k * y / r)‖ ^ 2 =
      r ^ 2 * ‖fourierCoeffOn hab S (-k)‖ ^ 2 := fun k _ => by
    rw [cell_coeff_eq_fourierCoeffOn hr S k, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hr, mul_pow]
  rw [Finset.sum_congr rfl e, ← Finset.mul_sum]
  have hle : ∑ k ∈ s, ‖fourierCoeffOn hab S (-k)‖ ^ 2 ≤ r⁻¹ * ∫ y in a..a + r, ‖S y‖ ^ 2 := by
    have hs' := (Equiv.neg ℤ).hasSum_iff.mpr hs
    refine (sum_le_hasSum s (fun i _ => by positivity) hs')
  calc r ^ 2 * ∑ k ∈ s, ‖fourierCoeffOn hab S (-k)‖ ^ 2 ≤
        r ^ 2 * (r⁻¹ * ∫ y in a..a + r, ‖S y‖ ^ 2) := by gcongr
    _ = r * ∫ y in a..a + r, ‖S y‖ ^ 2 := by field_simp

/-- The branch phase is jointly measurable in the offset and the point. -/
theorem measurable_centerPhase_uncurry (z : ChartTag) :
    Measurable (fun p : (Fin z.dim → ℝ) × ℝ => centerPhase z p.1 p.2) := by
  unfold centerPhase chartMatrixPhase branchLift
  refine (measurable_const.mul (measurable_snd.pow_const 2)).add ?_
  refine Finset.measurable_sum _ fun i _ => Finset.measurable_sum _ fun j _ => ?_
  refine (measurable_const.mul measurable_snd).mul_const _ |>.mul ?_
  refine ((measurable_pi_apply j).comp measurable_fst).add ?_
  exact Measurable.fract ((measurable_const.mul measurable_snd).sub
    ((measurable_pi_apply j).comp measurable_fst))

/-- The anchored side function is jointly measurable in the offset and the point. -/
theorem measurable_sideSd_uncurry (z : ChartTag) (l : Fin 4) {g : ℝ → ℂ} (hg : Measurable g) :
    Measurable (fun p : (Fin z.dim → ℝ) × ℝ => sideSd z p.1 l g p.2) := by
  unfold sideSd
  refine Measurable.mul ?_ (hg.comp measurable_snd)
  exact (continuous_subtype_val.comp Real.continuous_fourierChar).measurable.comp
    ((measurable_const.mul (measurable_centerPhase_uncurry z)).neg)

/-- The anchored side function has the modulus of the side function. -/
theorem norm_sideSd (z : ChartTag) (ρ : Fin z.dim → ℝ) (l : Fin 4) (g : ℝ → ℂ) (y : ℝ) :
    ‖sideSd z ρ l g y‖ = ‖g y‖ := by
  rw [sideSd, norm_mul, Circle.norm_coe, one_mul]

/-- Blueprint lines 2556-2560 (the side window energies `b_Λ²` before the offset average): for a
measurable side function, square integrable on the cell, the window energy
`X(ρ) = Σ_{k ∈ K} |∫_I S'_ρ(y) e(k y / r) dy|²` of the anchored side is integrable in the fresh
offset and at most `r ∫_I |f_l|²` for every offset. -/
theorem window_energy_integrable (z : ChartTag) (l : Fin 4) {g : ℝ → ℂ} (hg : Measurable g)
    {a r : ℝ} (hr : 0 < r) (hL2 : MemLp g 2 (volume.restrict (Set.Ioc a (a + r))))
    (K : Finset ℤ) :
    Integrable (fun ρ => ∑ k ∈ K, ‖∫ y in Set.Ico a (a + r), sideSd z ρ l g y *
        Complex.exp (2 * Real.pi * Complex.I * k * y / r)‖ ^ 2) (offsetMeasure z.dim) ∧
      ∀ ρ, ∑ k ∈ K, ‖∫ y in Set.Ico a (a + r), sideSd z ρ l g y *
        Complex.exp (2 * Real.pi * Complex.I * k * y / r)‖ ^ 2 ≤
        r * ∫ y in a..a + r, ‖g y‖ ^ 2 := by
  have hbd : ∀ ρ, ∑ k ∈ K, ‖∫ y in Set.Ico a (a + r), sideSd z ρ l g y *
      Complex.exp (2 * Real.pi * Complex.I * k * y / r)‖ ^ 2 ≤
      r * ∫ y in a..a + r, ‖g y‖ ^ 2 := by
    intro ρ
    have hm : MemLp (sideSd z ρ l g) 2 (volume.restrict (Set.Ioc a (a + r))) :=
      hL2.mono ((measurable_sideSd_uncurry z l hg).comp
        (measurable_const.prodMk measurable_id)).aestronglyMeasurable
        (Filter.Eventually.of_forall fun y => (norm_sideSd z ρ l g y).le)
    refine (cell_coeff_bessel hr _ hm K).trans (le_of_eq ?_)
    simp only [norm_sideSd]
  refine ⟨Integrable.mono' (integrable_const (r * ∫ y in a..a + r, ‖g y‖ ^ 2)) ?_
    (Filter.Eventually.of_forall fun ρ => ?_), hbd⟩
  · refine (Finset.measurable_sum K fun k _ => ?_).aestronglyMeasurable
    refine (StronglyMeasurable.integral_prod_right (ν := volume.restrict (Set.Ico a (a + r)))
      (f := fun ρ y => sideSd z ρ l g y * Complex.exp (2 * Real.pi * Complex.I * k * y / r))
      ?_).measurable.norm.pow_const 2
    exact ((measurable_sideSd_uncurry z l hg).mul (Complex.measurable_exp.comp
      ((measurable_const.mul (Complex.measurable_ofReal.comp measurable_snd)).div_const
        _))).stronglyMeasurable
  · rw [Real.norm_eq_abs, abs_of_nonneg (Finset.sum_nonneg fun _ _ => by positivity)]
    exact hbd ρ

/-- The truncated torus input of a role factors as (truncated cutoff) × (input polynomial). -/
theorem coreG_factor {d : ℕ} (QL Bx : ℕ) {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j))
    (c : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin d → ℤ) (cc : Fin 4 → (Fin d → ℤ) → ℂ) (j : Fin 4)
    (u : StandardTorus d) :
    coreG QL Bx F c n cc j u = (∑ v ∈ frequencyBox d Bx, cc j v *
      torusCharacter ((QL : ℤ) • v) u) * ∑ k ∈ F j, c j k * torusCharacter (n j k) u := by
  rw [coreG, Finset.sum_product, Finset.sum_mul]
  refine Finset.sum_congr rfl fun v _ => ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [torusCharacter_add_freq]
  ring

/-- Blueprint lines 2487-2495 (`eq:torus-size` for the truncated inputs): if the truncated cutoff
of role `j` is at most `M` on the torus, the `L²(𝓗)` norm of the truncated torus input is at most
`M` times that of the input polynomial `Σ_k c_k χ_{n_k}`. -/
theorem coreG_eLpNorm_le {d : ℕ} (V : Submodule ℚ (Fin d → ℚ)) (QL Bx : ℕ)
    {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j)) (c : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin d → ℤ)
    (cc : Fin 4 → (Fin d → ℤ) → ℂ) (j : Fin 4) {M : ℝ} (hM : 0 ≤ M)
    (hsup : ∀ u, ‖∑ v ∈ frequencyBox d Bx, cc j v * torusCharacter ((QL : ℤ) • v) u‖ ≤ M) :
    (eLpNorm (fun u : torusAnnihilator (rationalIntegerIntersection V) =>
        coreG QL Bx F c n cc j u) 2
        (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal ≤
      M * (eLpNorm (fun u : torusAnnihilator (rationalIntegerIntersection V) =>
        ∑ k ∈ F j, c j k * torusCharacter (n j k) u) 2
        (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal := by
  have hle := eLpNorm_le_mul_eLpNorm_of_ae_le_mul (μ := torusAnnihilatorHaar
    (rationalIntegerIntersection V)) (c := M)
    (f := fun u : torusAnnihilator (rationalIntegerIntersection V) => coreG QL Bx F c n cc j u)
    (g := fun u : torusAnnihilator (rationalIntegerIntersection V) =>
      ∑ k ∈ F j, c j k * torusCharacter (n j k) u)
    (Continuous.aestronglyMeasurable (by
      unfold coreG
      exact continuous_finsetSum _ fun p _ => continuous_const.mul
        ((continuous_torusCharacter _).comp continuous_subtype_val)))
    (Filter.Eventually.of_forall fun u => by
      rw [coreG_factor, norm_mul]
      exact mul_le_mul_of_nonneg_right (hsup u) (norm_nonneg _)) 2
  have hfin : eLpNorm (fun u : torusAnnihilator (rationalIntegerIntersection V) =>
      ∑ k ∈ F j, c j k * torusCharacter (n j k) u) 2
      (torusAnnihilatorHaar (rationalIntegerIntersection V)) ≠ ⊤ := by
    refine (MemLp.of_bound (C := ∑ k ∈ F j, ‖c j k‖) (f := fun u : torusAnnihilator
      (rationalIntegerIntersection V) => ∑ k ∈ F j, c j k * torusCharacter (n j k) u)
      (Continuous.aestronglyMeasurable
      (continuous_finsetSum _ fun k _ => continuous_const.mul
        ((continuous_torusCharacter _).comp continuous_subtype_val)))
      (Filter.Eventually.of_forall fun u => ?_)).eLpNorm_ne_top
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun k _ => ?_)
    change ‖c j k * torusCharacter (n j k) u‖ ≤ ‖c j k‖
    rw [norm_mul, norm_torusCharacter, mul_one]
  have := ENNReal.toReal_mono (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hfin) hle
  rwa [ENNReal.toReal_mul, ENNReal.toReal_ofReal hM] at this

/-- `offset_average_sqrt` with several square-root terms and an almost-everywhere bound: if
`F ≤ 2 E Φ` and `Φ ≤ a + Σ_i b_i √X_i` almost everywhere, then `F ≤ 2 (a + Σ_i b_i √(E X_i))`. -/
theorem offset_average_sqrt_sum {α ι : Type*} [MeasurableSpace α] (μ : Measure α)
    [IsProbabilityMeasure μ] (s : Finset ι) {Φ : α → ℝ} {X : ι → α → ℝ} {a F : ℝ} {b : ι → ℝ}
    (hb : ∀ i ∈ s, 0 ≤ b i) (hΦ0 : ∀ x, 0 ≤ Φ x) (hX0 : ∀ i ∈ s, ∀ x, 0 ≤ X i x)
    (hXi : ∀ i ∈ s, Integrable (X i) μ)
    (hΦ : ∀ᵐ x ∂μ, Φ x ≤ a + ∑ i ∈ s, b i * Real.sqrt (X i x))
    (hF : F ≤ 2 * ∫ x, Φ x ∂μ) :
    F ≤ 2 * (a + ∑ i ∈ s, b i * Real.sqrt (∫ x, X i x ∂μ)) := by
  have hJ := fun i (hi : i ∈ s) => integral_sqrt_le μ (hX0 i hi) (hXi i hi)
  have hint : Integrable (fun x => a + ∑ i ∈ s, b i * Real.sqrt (X i x)) μ :=
    (integrable_const a).add (integrable_finsetSum _ fun i hi => (hJ i hi).1.const_mul _)
  refine hF.trans (mul_le_mul_of_nonneg_left ?_ (by norm_num))
  calc ∫ x, Φ x ∂μ ≤ ∫ x, a + ∑ i ∈ s, b i * Real.sqrt (X i x) ∂μ :=
        integral_mono_of_nonneg (Filter.Eventually.of_forall hΦ0) hint hΦ
    _ = a + ∑ i ∈ s, b i * ∫ x, Real.sqrt (X i x) ∂μ := by
        rw [integral_add (integrable_const a)
          (integrable_finsetSum _ fun i hi => (hJ i hi).1.const_mul _), integral_const,
          probReal_univ, one_smul, integral_finsetSum _ fun i hi => (hJ i hi).1.const_mul _]
        simp only [integral_const_mul]
    _ ≤ a + ∑ i ∈ s, b i * Real.sqrt (∫ x, X i x ∂μ) := by
        gcongr with i hi
        · exact hb i hi
        · exact (hJ i hi).2

/-- Almost every fresh offset lies in the unit cube. -/
theorem offsetMeasure_ae_mem (d : ℕ) :
    ∀ᵐ ρ ∂offsetMeasure d, ∀ a, ρ a ∈ Set.Icc (0 : ℝ) 1 := by
  refine ae_all_iff.mpr fun a => ?_
  unfold offsetMeasure
  exact (Measure.quasiMeasurePreserving_eval _ a).ae (ae_restrict_mem measurableSet_Icc)

/-- The window energy `Σ_{k ∈ K} |∫_I S'_ρ(y) e(k y / r) dy|²` of the anchored side. -/
noncomputable def sideWinE (z : ChartTag) (l : Fin 4) (g : ℝ → ℂ) (a r : ℝ) (K : Finset ℤ)
    (ρ : Fin z.dim → ℝ) : ℝ :=
  ∑ k ∈ K, ‖∫ y in Set.Ico a (a + r), sideSd z ρ l g y *
    Complex.exp (2 * Real.pi * Complex.I * k * y / r)‖ ^ 2

namespace ModeComponents
variable {Mode P : Type*} [DecidableEq Mode] [DecidableEq P] (C : ModeComponents Mode P)

/-- Blueprint line 2482 ("a successful component contains a nonexceptional primary"): a good
mode's CURRENT component carries a primary label that is good (`goodP h`). -/
theorem exists_good_label (Δ : ℕ) (goodP : ℕ → P → Prop) [∀ h, DecidablePred (goodP h)]
    {h : ℕ} {m : Mode} (hg : C.Good Δ goodP h m) :
    ∃ p ∈ C.labels (C.F h m), goodP h p := by
  obtain ⟨-, -, h3⟩ := hg
  have hne : 0 < (C.labels (C.F h m)).card :=
    Finset.card_pos.mpr ⟨C.π m, Finset.mem_image_of_mem _ (C.E_le_F h m (C.E_self h m))⟩
  have hpos : 0 < ((C.labels (C.F h m)).filter (goodP h)).card := by omega
  obtain ⟨p, hp⟩ := Finset.card_pos.mp hpos
  exact ⟨p, (Finset.mem_filter.mp hp).1, (Finset.mem_filter.mp hp).2⟩

end ModeComponents

open Classical in
/-- Blueprint lines 2482-2486 (frequency tests): the gap `eq:gap` of a nonexceptional primary
`Θ = (θ_v, ϑ)` at height `H` (thresholds `T⁻¹/r_v` and `T/r_t`), applied to pure `ϑ` shifts,
makes `r n·ξ` (with `ξ = ϑ/L`, `r_t ≤ r ≤ r_v`) tiny (`≤ T⁻¹/L`) for integer `n` of height at
most `H` in the tiny span `K_B` and huge (`≥ T/L`) otherwise. -/
theorem gap_tiny_huge {dv dz : ℕ} (θv : Fin dv → ℝ) (ϑ : Fin dz → ℝ) {Hh : ℕ} (hH : 1 ≤ Hh)
    {T rv rt r L : ℝ} (hT : 0 < T) (hrv : 0 < rv) (hrt : 0 < rt)
    (hgap : ∀ a : Fin (dv + dz) → ℚ, vecHeight a ≤ Hh →
      |ratEval (Fin.append θv ϑ) a| ≤ T⁻¹ / rv ∨ T / rt ≤ |ratEval (Fin.append θv ϑ) a|)
    (hsmall : (3 * Hh ^ 2 : ℝ) ^ dz * (dz.factorial * Hh ^ (dz ^ 2 + dz)) * (T⁻¹ / rv) < T / rt)
    (hr : r ≤ rv) (hr' : rt ≤ r) (hL : 0 < L) (n : Fin dz → ℤ)
    (hn : vecHeight (fun i => (n i : ℚ)) ≤ Hh) :
    (n ∈ rationalIntegerIntersection (tinySpan ϑ Hh (T⁻¹ / rv)) →
      r * |∑ i, (n i : ℝ) * (ϑ i / L)| ≤ T⁻¹ / L) ∧
    (n ∉ rationalIntegerIntersection (tinySpan ϑ Hh (T⁻¹ / rv)) →
      T / L ≤ r * |∑ i, (n i : ℝ) * (ϑ i / L)|) := by
  have hpure := pure_gap_of_gap θv ϑ hH hgap
  have hε : 0 ≤ T⁻¹ / rv := by positivity
  obtain ⟨g1, g2⟩ := gap_coset ϑ hH hε hpure hsmall n hn
  have hr0 : 0 < r := lt_of_lt_of_le hrt hr'
  have e : ∑ i, (n i : ℝ) * (ϑ i / L) = (∑ i, (n i : ℝ) * ϑ i) / L := by
    rw [Finset.sum_div]; refine Finset.sum_congr rfl fun i _ => ?_; ring
  rw [e, abs_div, abs_of_pos hL]
  refine ⟨fun hm => ?_, fun hm => ?_⟩
  · have h1 := g1 hm
    calc r * (|∑ i, (n i : ℝ) * ϑ i| / L) ≤ rv * (T⁻¹ / rv / L) :=
          mul_le_mul hr (div_le_div_of_nonneg_right h1 hL.le) (by positivity) hrv.le
      _ = T⁻¹ / L := by field_simp
  · have h2 := g2 hm
    calc T / L = rt * (T / rt / L) := by field_simp
      _ ≤ r * (|∑ i, (n i : ℝ) * ϑ i| / L) :=
          mul_le_mul hr' (div_le_div_of_nonneg_right h2 hL.le) (by positivity) hr0.le

/-- Blueprint lines 2512-2534 (`eq:four-tests`, the kernel factor of the four-core test): at the
reference frequencies `(q', t')` the kernel sample satisfies `|WFourier_s(r q', r t')| ν^J ≤ C_J
  μ` with
`μ = min(1, min_{0 ≤ j ≤ 3} r|t' - j q'|)` and `ν = max(1, r|q'|, r|t'|)` (the four marginals
give zeros on the lines `t = j q`). -/
theorem fourK_mu_nu {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) (J : ℕ) (x₀ A B : ℝ) :
    ‖fourK a₀ r w x₀ A B‖ * max 1 (max (r * |A|) (r * |B|)) ^ J ≤
      (2 * (2 * 4 * (2 * 4 * (kernelDerivBound κ 0 +
        ((2 * Real.pi) ^ J)⁻¹ * kernelDerivBound κ J))) + (3 + 2) ^ J *
        (2 * 4 * (2 * Real.pi * 4 * (2 * (4 + 3 * 4) * (kernelDerivBound κ 0 +
          ((2 * Real.pi) ^ J)⁻¹ * kernelDerivBound κ J))))) *
      min 1 (((Finset.univ : Finset (Fin 4)).image fun j : Fin 4 => (j : ℝ)).inf'
        ⟨0, Finset.mem_image.mpr ⟨0, Finset.mem_univ _, by simp⟩⟩
          fun j => r * |B - j * A|) := by
  have h := admissible_kernel_decay hr hw J (-(r * A)) (-(r * B))
  have e1 : |-(r * A)| = r * |A| := by rw [abs_neg, abs_mul, abs_of_pos hr]
  have e2 : |-(r * B)| = r * |B| := by rw [abs_neg, abs_mul, abs_of_pos hr]
  have e3 : (fun j : ℝ => |-(r * B) - j * -(r * A)|) = fun j => r * |B - j * A| := by
    funext j
    rw [show -(r * B) - j * -(r * A) = -(r * (B - j * A)) by ring, abs_neg, abs_mul,
      abs_of_pos hr]
  rw [e1, e2, e3] at h
  unfold fourK
  rwa [norm_mul, Circle.norm_coe, one_mul]

/-- The core index data of a three-core tuple with side role `l`, the side carried as one trivial
term (`none`, the convention of `three_core_principal`). -/
noncomputable def sideOptF {ι : Fin 4 → Type*} (l : Fin 4) (F : ∀ j, Finset (ι j)) :
    ∀ j, Finset (Option (ι j)) :=
  fun j => if j = l then {none} else (F j).map Function.Embedding.some

/-- Coefficients of a three-core tuple, `1` on the side term. -/
def sideOptC {ι : Fin 4 → Type*} (c : ∀ j, ι j → ℂ) : ∀ j, Option (ι j) → ℂ :=
  fun j o => o.elim 1 (c j)

/-- Torus frequencies of a three-core tuple, `0` on the side term. -/
def sideOptN {ι : Fin 4 → Type*} {d : ℕ} (n : ∀ j, ι j → Fin d → ℤ) :
    ∀ j, Option (ι j) → Fin d → ℤ :=
  fun j o => o.elim 0 (n j)

/-- The four-core test quantity `μ = min(1, min_{0 ≤ j ≤ 3} r |t' - j q'|)` of `eq:four-tests`. -/
noncomputable def fourMu (r A B : ℝ) : ℝ :=
  min 1 (((Finset.univ : Finset (Fin 4)).image fun j : Fin 4 => (j : ℝ)).inf'
    ⟨0, Finset.mem_image.mpr ⟨0, Finset.mem_univ _, by simp⟩⟩ fun j => r * |B - j * A|)

/-- The four-core test quantity `ν = max(1, r |q'|, r |t'|)` of `eq:four-tests`. -/
noncomputable def fourNu (r A B : ℝ) : ℝ := max 1 (max (r * |A|) (r * |B|))

/-- The constant `C_J` of `fourK_mu_nu`. -/
noncomputable def fourKC (κ : LocalKernelClass) (J : ℕ) : ℝ :=
  2 * (2 * 4 * (2 * 4 * (kernelDerivBound κ 0 +
    ((2 * Real.pi) ^ J)⁻¹ * kernelDerivBound κ J))) + (3 + 2) ^ J *
    (2 * 4 * (2 * Real.pi * 4 * (2 * (4 + 3 * 4) * (kernelDerivBound κ 0 +
      ((2 * Real.pi) ^ J)⁻¹ * kernelDerivBound κ J))))

theorem fourMu_le_one (r A B : ℝ) : fourMu r A B ≤ 1 := min_le_left _ _

theorem one_le_fourNu (r A B : ℝ) : 1 ≤ fourNu r A B := le_max_left _ _

/-- Blueprint lines 2566-2569 (discarded four-core tuples): if the inner minimum is below `U₀⁻¹`
(`μ ≤ U₀⁻¹`) or no reference lies in `max(|q'|, |t'|) ≤ U₀ R_s` (`ν ≥ U₀`), the kernel sample at
the reference is at most `C_J U₀⁻¹` (`fourK_mu_nu` with `J ≥ 1`). -/
theorem fourK_discard {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) {J : ℕ} (hJ : 1 ≤ J) (x₀ A B : ℝ) {U₀ : ℝ}
    (hU : 0 < U₀) (hd : fourMu r A B ≤ U₀⁻¹ ∨ U₀ ≤ fourNu r A B) :
    ‖fourK a₀ r w x₀ A B‖ ≤ fourKC κ J * U₀⁻¹ := by
  have h := fourK_mu_nu hr hw J x₀ A B
  change ‖fourK a₀ r w x₀ A B‖ * fourNu r A B ^ J ≤ fourKC κ J * fourMu r A B at h
  have hν := one_le_fourNu r A B
  have hC : 0 ≤ fourKC κ J := by
    have := kernelDerivBound_nonneg κ 0
    have := kernelDerivBound_nonneg κ J
    unfold fourKC
    positivity
  have hνJ : fourNu r A B ≤ fourNu r A B ^ J := le_self_pow₀ hν (by omega)
  have hK0 := norm_nonneg (fourK a₀ r w x₀ A B)
  rcases hd with hd | hd
  · calc ‖fourK a₀ r w x₀ A B‖ ≤ ‖fourK a₀ r w x₀ A B‖ * fourNu r A B ^ J :=
          le_mul_of_one_le_right hK0 (one_le_pow₀ hν)
      _ ≤ fourKC κ J * fourMu r A B := h
      _ ≤ fourKC κ J * U₀⁻¹ := mul_le_mul_of_nonneg_left hd hC
  · have hpos : 0 < fourNu r A B := lt_of_lt_of_le one_pos hν
    have h1 : ‖fourK a₀ r w x₀ A B‖ * fourNu r A B ≤ fourKC κ J :=
      (mul_le_mul_of_nonneg_left hνJ hK0).trans (h.trans
        (mul_le_of_le_one_right hC (fourMu_le_one r A B)))
    calc ‖fourK a₀ r w x₀ A B‖ ≤ fourKC κ J / fourNu r A B := by
          rw [le_div_iff₀ hpos]; exact h1
      _ ≤ fourKC κ J * U₀⁻¹ := by
          rw [div_eq_mul_inv]
          exact mul_le_mul_of_nonneg_left (inv_anti₀ hU hd) hC

end TrilinearHT.Auto


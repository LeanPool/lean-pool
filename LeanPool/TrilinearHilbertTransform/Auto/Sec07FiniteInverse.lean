section

namespace TrilinearHT.Auto
open Filter MeasureTheory
open scoped Topology ENNReal
open scoped Pointwise

/-! ### Cyclic rational lattices -/

/-- A triangular coordinate change whose distinguished basis vector has denominator `q`.
 It provides the full lattice used in blueprint `lem:local-chart`, lines 1035-1039. -/
noncomputable def cyclicCoordinateEquiv {ι : Type*} [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) : (ι → ℝ) ≃ₗ[ℝ] (ι → ℝ) where
  toFun x j := if j = i₀ then x i₀ / q else x j + (a j : ℝ) * x i₀ / q
  invFun y j := if j = i₀ then q * y i₀ else y j - (a j : ℝ) * y i₀
  left_inv x := by
    have hq : (q : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne q)
    funext j
    by_cases hj : j = i₀
    · subst j
      simp
      field_simp
    · simp [hj]
      field_simp
      ring
  right_inv y := by
    have hq : (q : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne q)
    funext j
    by_cases hj : j = i₀
    · subst j
      simp [hq]
    · simp [hj]
      field_simp
      ring
  map_add' x y := by
    funext j
    by_cases hj : j = i₀ <;> simp [hj] <;> ring
  map_smul' c x := by
    funext j
    by_cases hj : j = i₀ <;> simp [hj] <;> ring

/-- A Euclidean full basis for the cyclic lift lattice. -/
noncomputable def cyclicLiftBasis {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) :
    Module.Basis ι ℝ (EuclideanSpace ℝ ι) :=
  (Pi.basisFun ℝ ι).map
    ((cyclicCoordinateEquiv q a i₀).trans (WithLp.linearEquiv 2 ℝ (ι → ℝ)).symm)

/-- The integer span of the rational cyclic basis, automatically a full discrete lattice. -/
noncomputable abbrev cyclicLiftLattice {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) : Submodule ℤ (EuclideanSpace ℝ ι) :=
  Submodule.span ℤ (Set.range (cyclicLiftBasis q a i₀))

/-- Real coordinates in the cyclic basis have a triangular explicit formula. -/
theorem cyclicLiftBasis_repr {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) (x : EuclideanSpace ℝ ι) (i : ι) :
    (cyclicLiftBasis q a i₀).repr x i =
      if i = i₀ then (q : ℝ) * x i₀ else x i - (a i : ℝ) * x i₀ := by
  rfl

/-- The integer coordinates of a lattice point agree with its real basis coordinates. -/
theorem cyclicLiftLattice_integer_coordinates {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) (x : cyclicLiftLattice q a i₀) (i : ι) :
    (((cyclicLiftBasis q a i₀).restrictScalars ℤ).repr x i : ℝ) =
      if i = i₀ then (q : ℝ) * (x : EuclideanSpace ℝ ι) i₀
      else (x : EuclideanSpace ℝ ι) i - (a i : ℝ) * (x : EuclideanSpace ℝ ι) i₀ := by
  exact (cyclicLiftBasis q a i₀).restrictScalars_repr_apply ℤ x i

/-- Every integer vector belongs to the cyclic lift lattice. -/
theorem integerVector_mem_cyclicLiftLattice {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) (z : ι → ℤ) :
    WithLp.toLp 2 (fun i => (z i : ℝ)) ∈ cyclicLiftLattice q a i₀ := by
  apply ((cyclicLiftBasis q a i₀).mem_span_iff_repr_mem ℤ _).mpr
  intro i
  rw [cyclicLiftBasis_repr]
  by_cases hi : i = i₀
  · refine ⟨(q : ℤ) * z i₀, ?_⟩
    simp [hi]
  · refine ⟨z i - a i * z i₀, ?_⟩
    simp [hi]

/-- The cyclic quotient is the distinguished integer basis coefficient modulo `q`. -/
noncomputable def cyclicLiftProjection {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) : cyclicLiftLattice q a i₀ →+ ZMod q where
  toFun x := (((cyclicLiftBasis q a i₀).restrictScalars ℤ).repr x i₀ : ZMod q)
  map_zero' := by simp only [map_zero, Finsupp.zero_apply, Int.cast_zero]
  map_add' x y := by simp only [map_add, Finsupp.add_apply, Int.cast_add]

theorem cyclicLiftProjection_basis {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ i : ι) :
    cyclicLiftProjection q a i₀ ((cyclicLiftBasis q a i₀).restrictScalars ℤ i) =
      if i = i₀ then 1 else 0 := by
  change ((((cyclicLiftBasis q a i₀).restrictScalars ℤ).repr
    ((cyclicLiftBasis q a i₀).restrictScalars ℤ i)) i₀ : ZMod q) = _
  rw [Module.Basis.repr_self]
  by_cases hi : i = i₀ <;> simp [hi]

/-- The kernel consists exactly of the vectors with integer coordinates. -/
theorem cyclicLiftProjection_eq_zero_iff {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) (x : cyclicLiftLattice q a i₀) :
    cyclicLiftProjection q a i₀ x = 0 ↔
      ∀ i, ∃ z : ℤ, (x : EuclideanSpace ℝ ι) i = z := by
  let n := ((cyclicLiftBasis q a i₀).restrictScalars ℤ).repr x i₀
  have hn : (n : ℝ) = (q : ℝ) * (x : EuclideanSpace ℝ ι) i₀ := by
    simpa only [ite_true] using cyclicLiftLattice_integer_coordinates q a i₀ x i₀
  have hq : (q : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne q)
  change (n : ZMod q) = 0 ↔ _
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
  constructor
  · rintro ⟨k, hk⟩ i
    have hx0 : (x : EuclideanSpace ℝ ι) i₀ = (k : ℝ) := by
      have hkR : (n : ℝ) = (q : ℝ) * k := by exact_mod_cast hk
      exact mul_left_cancel₀ hq (hn.symm.trans hkR)
    by_cases hi : i = i₀
    · exact ⟨k, by simpa only [hi] using hx0⟩
    · refine ⟨((cyclicLiftBasis q a i₀).restrictScalars ℤ).repr x i + a i * k, ?_⟩
      have h := cyclicLiftLattice_integer_coordinates q a i₀ x i
      rw [ite_eq_right hi, hx0] at h
      push_cast
      linarith
  · intro hx
    obtain ⟨k, hk⟩ := hx i₀
    refine ⟨k, ?_⟩
    have h : (n : ℝ) = (q : ℝ) * k := by rw [hn, hk]
    exact_mod_cast h

/-- The frequency associated to each cyclic lift coordinate, with distinguished frequency one. -/
def cyclicLiftFrequency {ι : Type*} [DecidableEq ι] (q : ℕ)
    (a : ι → ℤ) (i₀ i : ι) : ZMod q := if i = i₀ then 1 else a i

/-- Reduction modulo the integer lattice recovers every specified cyclic character. -/
theorem cyclicLiftProjection_character {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) (x : cyclicLiftLattice q a i₀) (i : ι) :
    ((x : EuclideanSpace ℝ ι) i : UnitAddCircle) =
      ZMod.toAddCircle (cyclicLiftFrequency q a i₀ i * cyclicLiftProjection q a i₀ x) := by
  let z := ((cyclicLiftBasis q a i₀).restrictScalars ℤ).repr x
  have hq : (q : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne q)
  have h0 : (x : EuclideanSpace ℝ ι) i₀ = (z i₀ : ℝ) / q := by
    have h := cyclicLiftLattice_integer_coordinates q a i₀ x i₀
    simp only [ite_true] at h
    apply (eq_div_iff hq).mpr
    nlinarith only [h]
  by_cases hi : i = i₀
  · subst i
    simp only [cyclicLiftFrequency, ite_true, one_mul]
    change ((x : EuclideanSpace ℝ ι) i₀ : UnitAddCircle) = ZMod.toAddCircle (z i₀ : ZMod q)
    rw [ZMod.toAddCircle_intCast, h0]
  · have hx : (x : EuclideanSpace ℝ ι) i =
        (z i : ℝ) + ((a i * z i₀ : ℤ) : ℝ) / q := by
      have h := cyclicLiftLattice_integer_coordinates q a i₀ x i
      rw [ite_eq_right hi, h0] at h
      rw [← mul_div_assoc] at h
      push_cast
      dsimp only [z] at *
      linarith only [h]
    simp only [cyclicLiftFrequency, ite_eq_right hi]
    change ((x : EuclideanSpace ℝ ι) i : UnitAddCircle) =
      ZMod.toAddCircle ((a i : ZMod q) * (z i₀ : ZMod q))
    rw [← Int.cast_mul, ZMod.toAddCircle_intCast, hx, AddCircle.coe_add]
    simp

/-- Two cyclic lifts less than one apart cannot have the same projection unless equal. -/
theorem cyclicLiftProjection_injective_near {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) (x y : cyclicLiftLattice q a i₀)
    (hsmall : ‖(x : EuclideanSpace ℝ ι) - (y : EuclideanSpace ℝ ι)‖ < 1)
    (heq : cyclicLiftProjection q a i₀ x = cyclicLiftProjection q a i₀ y) : x = y := by
  have hz : cyclicLiftProjection q a i₀ (x - y) = 0 := by rw [map_sub, heq, sub_self]
  have hint := (cyclicLiftProjection_eq_zero_iff q a i₀ (x - y)).mp hz
  apply Subtype.ext
  apply sub_eq_zero.mp
  ext i
  obtain ⟨z, hz⟩ := hint i
  have hcoord := PiLp.norm_apply_le ((x : EuclideanSpace ℝ ι) - (y : EuclideanSpace ℝ ι)) i
  have hreal : |(z : ℝ)| < 1 := by
    rw [← hz]
    exact hcoord.trans_lt hsmall
  have hint : |z| < (1 : ℤ) := by exact_mod_cast hreal
  have hz0 : z = 0 := by have := abs_lt.mp hint; omega
  change (x : EuclideanSpace ℝ ι) i - (y : EuclideanSpace ℝ ι) i = 0
  change (x : EuclideanSpace ℝ ι) i - (y : EuclideanSpace ℝ ι) i = (z : ℝ) at hz
  simpa only [hz0, Int.cast_zero] using hz

/-- A full lattice containing the integer lattice has integral dual coordinates. For a
 lattice vector `θ`, its basis-coordinate forms on `n θ - k` have integer coefficients;
 blueprint `lem:local-chart`, lines 1054-1057. -/
theorem integer_lattice_dual_coordinates {ι : Type*} [Fintype ι] {n : ℕ}
    (L : Submodule ℤ (EuclideanSpace ℝ ι))
    (hZ : ∀ z : ι → ℤ, WithLp.toLp 2 (fun j => (z j : ℝ)) ∈ L)
    (b : Module.Basis (Fin n) ℝ (EuclideanSpace ℝ ι))
    (hb : Submodule.span ℤ (Set.range b) = L) (θ : EuclideanSpace ℝ ι) (hθ : θ ∈ L) :
    ∃ (U : Fin n → ι → ℤ) (t : Fin n → ℤ),
      (∀ i j, euclideanDualBasis b i j = (U i j : ℝ)) ∧
      (∀ i, inner ℝ (euclideanDualBasis b i) θ = (t i : ℝ)) ∧
      (∀ (x : EuclideanSpace ℝ ι) i, b.repr x i = ∑ j, (U i j : ℝ) * x j) ∧
      ∀ (m : ℤ) (k : ι → ℤ) i,
        b.repr (m • θ - WithLp.toLp 2 (fun j => (k j : ℝ))) i =
          ((t i * m - ∑ j, U i j * k j : ℤ) : ℝ) := by
  classical
  have hdual (i : Fin n) : euclideanDualBasis b i ∈ euclideanDualLattice L := by
    rw [← hb, euclideanDualLattice_span]
    exact Submodule.subset_span (Set.mem_range_self i)
  have hcoord (i : Fin n) (j : ι) : ∃ z : ℤ, euclideanDualBasis b i j = (z : ℝ) := by
    have hj : EuclideanSpace.single j (1 : ℝ) ∈ L := by
      convert hZ (Pi.single j 1) using 1
      ext k
      simp [Pi.single_apply]
    obtain ⟨z, hz⟩ := (mem_euclideanDualLattice L _).mp (hdual i) _ hj
    exact ⟨z, by
      simpa only [EuclideanSpace.inner_single_right, one_mul, conj_trivial] using hz.symm⟩
  choose U hU using hcoord
  have htheta (i : Fin n) : ∃ z : ℤ, inner ℝ (euclideanDualBasis b i) θ = (z : ℝ) := by
    obtain ⟨z, hz⟩ := (mem_euclideanDualLattice L _).mp (hdual i) θ hθ
    exact ⟨z, hz.symm⟩
  choose t ht using htheta
  have hrepr (x : EuclideanSpace ℝ ι) (i : Fin n) :
      b.repr x i = ∑ j, (U i j : ℝ) * x j := by
    rw [← euclideanDualBasis_inner, EuclideanSpace.inner_eq_star_dotProduct]
    simp [dotProduct, hU, mul_comm]
  refine ⟨U, t, hU, ht, hrepr, ?_⟩
  intro m k i
  have hsumθ : (∑ j, (U i j : ℝ) * θ j) = (t i : ℝ) := by
    rw [← hrepr, ← euclideanDualBasis_inner]
    exact ht i
  rw [hrepr, ← Int.cast_smul_eq_zsmul ℝ]
  change (∑ j, (U i j : ℝ) * ((m : ℝ) * θ j - (k j : ℝ))) = _
  calc
    _ = (m : ℝ) * (∑ j, (U i j : ℝ) * θ j) - ∑ j, (U i j : ℝ) * (k j : ℝ) := by
      simp only [mul_sub, Finset.sum_sub_distrib, Finset.mul_sum]
      congr 1
      apply Finset.sum_congr rfl
      intro j _
      ring
    _ = _ := by rw [hsumθ]; push_cast; ring

theorem latticeBoxRadius_pos {n : ℕ} (hn : 0 < n) : 0 < latticeBoxRadius n := by
  unfold latticeBoxRadius
  have : (0 : ℝ) < n := by exact_mod_cast hn
  positivity

end TrilinearHT.Auto

end

section

namespace TrilinearHT.Auto
open Filter Polynomial MeasureTheory AddCircle
open scoped Topology ComplexConjugate FourierTransform ENNReal BigOperators

/-- The integral lower-left identity block used to encode a horizontal linear phase. -/
def chartCouplingMatrix (d : ℕ) : Matrix (Fin (d + d)) (Fin (d + d)) ℚ :=
  fun i j => Fin.addCases (fun _ => 0)
    (fun a => Fin.addCases (fun b => if a = b then 1 else 0) (fun _ => 0) j) i

theorem chartCouplingMatrix_height (d : ℕ) (i j : Fin (d + d)) :
    chartRationalHeight (chartCouplingMatrix d i j) = 1 := by
  refine Fin.addCases (fun a => ?_) (fun a => ?_) i
  · simp [-Fin.natAdd_eq_addNat, chartCouplingMatrix, chartRationalHeight]
  · refine Fin.addCases (fun b => ?_) (fun b => ?_) j
    · by_cases h : a = b <;>
        simp [-Fin.natAdd_eq_addNat, chartCouplingMatrix, h, chartRationalHeight]
    · simp [-Fin.natAdd_eq_addNat, chartCouplingMatrix, chartRationalHeight]

theorem chartMatrixPhase_coupling {d : ℕ} (z w : Fin (d + d) → ℝ) :
    chartMatrixPhase (chartCouplingMatrix d) z w =
      ∑ i, z (Fin.natAdd d i) * w (Fin.castAdd d i) := by
  simp [-Fin.natAdd_eq_addNat, chartMatrixPhase, chartCouplingMatrix, Fin.sum_univ_add,
    apply_ite, ite_mul]

/-- Couple the two coordinate blocks through the lower-left identity matrix.
 The amplitudes and ordinary phases are those of the product chart. -/
noncomputable def coupledQuadraticChart {d : ℕ} (A B : QuadraticChartData d) :
    QuadraticChartData (d + d) :=
  { productQuadraticChart A B with matrix := chartCouplingMatrix d }

theorem coupledQuadraticChart_summand {d : ℕ} (A B : QuadraticChartData d)
    (y : ℝ) (n m : Fin d → ℤ) :
    quadraticChartLatticeSummand (coupledQuadraticChart A B) y (Fin.append n m) =
      (A.amplitude (chartLatticeRemainder A y n) *
        (Real.fourierChar (y * ∑ i, B.horizontal i * chartLatticeRemainder A y n i) : ℂ)) *
      B.amplitude (chartLatticeRemainder B y m) := by
  have hl : (fun i => chartLatticeRemainder (coupledQuadraticChart A B) y
      (Fin.append n m) (Fin.castAdd d i)) = chartLatticeRemainder A y n := by
    funext i
    simp [-Fin.natAdd_eq_addNat, chartLatticeRemainder, coupledQuadraticChart,
      productQuadraticChart]
  have hr : (fun i => chartLatticeRemainder (coupledQuadraticChart A B) y
      (Fin.append n m) (Fin.natAdd d i)) = chartLatticeRemainder B y m := by
    funext i
    simp [-Fin.natAdd_eq_addNat, chartLatticeRemainder, coupledQuadraticChart,
      productQuadraticChart]
  have hphase :
      chartMatrixPhase (chartCouplingMatrix d)
        (chartHorizontalPosition (coupledQuadraticChart A B) y)
        (chartLatticeRemainder (coupledQuadraticChart A B) y (Fin.append n m)) =
      y * ∑ i, B.horizontal i * chartLatticeRemainder A y n i := by
    simp only [chartMatrixPhase_coupling, chartHorizontalPosition, chartLatticeRemainder,
      coupledQuadraticChart, productQuadraticChart, Fin.append_right, Fin.append_left,
      Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    ring
  change (A.amplitude _ * B.amplitude _) *
    (Real.fourierChar (chartMatrixPhase (chartCouplingMatrix d) _ _) : ℂ) = _
  rw [hphase, hl, hr]
  ring

theorem chartAmplitude_finite_support {d : ℕ} (A : QuadraticChartData d) (y : ℝ) :
    (fun n : Fin d → ℤ => A.amplitude (chartLatticeRemainder A y n)).HasFiniteSupport := by
  apply (quadraticChartLatticeSummand_finite_support A y).subset
  intro n hn
  change A.amplitude (chartLatticeRemainder A y n) *
    (Real.fourierChar (chartMatrixPhase A.matrix (chartHorizontalPosition A y)
      (chartLatticeRemainder A y n)) : ℂ) ≠ 0
  exact mul_ne_zero hn (Circle.coe_ne_zero _)

/-- The coupled chart factors into a phased sum in the first lattice block and
 an ordinary periodization in the second block. -/
theorem coupledQuadraticChart_atom {d : ℕ} (A B : QuadraticChartData d) (y : ℝ) :
    quadraticChartAtom (coupledQuadraticChart A B) y =
      (Real.fourierChar ((A.quadratic + B.quadratic) * y ^ 2 +
        (A.linear + B.linear) * y) : ℂ) *
      (∑' n : Fin d → ℤ, A.amplitude (chartLatticeRemainder A y n) *
        (Real.fourierChar (y * ∑ i, B.horizontal i * chartLatticeRemainder A y n i) : ℂ)) *
      ∑' m : Fin d → ℤ, B.amplitude (chartLatticeRemainder B y m) := by
  let f : (Fin d → ℤ) → ℂ := fun n =>
    A.amplitude (chartLatticeRemainder A y n) *
      (Real.fourierChar (y * ∑ i, B.horizontal i * chartLatticeRemainder A y n i) : ℂ)
  let g : (Fin d → ℤ) → ℂ := fun m => B.amplitude (chartLatticeRemainder B y m)
  have hf : f.HasFiniteSupport := (chartAmplitude_finite_support A y).mul_left _
  have hg : g.HasFiniteSupport := chartAmplitude_finite_support B y
  have hfn : Summable (fun n => ‖f n‖) := summable_of_hasFiniteSupport (by
    simpa only [Function.HasFiniteSupport, Function.support, norm_ne_zero_iff] using hf)
  have hgn : Summable (fun n => ‖g n‖) := summable_of_hasFiniteSupport (by
    simpa only [Function.HasFiniteSupport, Function.support, norm_ne_zero_iff] using hg)
  have hs : (∑' k, quadraticChartLatticeSummand (coupledQuadraticChart A B) y k) =
      (∑' n, f n) * ∑' m, g m := by
    calc
      _ = ∑' p : (Fin d → ℤ) × (Fin d → ℤ),
          quadraticChartLatticeSummand (coupledQuadraticChart A B) y (Fin.append p.1 p.2) :=
        ((Fin.appendEquiv d d).tsum_eq _).symm
      _ = ∑' p : (Fin d → ℤ) × (Fin d → ℤ), f p.1 * g p.2 :=
        tsum_congr fun p => coupledQuadraticChart_summand A B y p.1 p.2
      _ = _ := (tsum_mul_tsum_of_summable_norm hfn hgn).symm
  rw [quadraticChartAtom, hs]
  change _ * ((∑' n, f n) * ∑' m, g m) = _
  exact (mul_assoc _ _ _).symm

/-- A partition of unity in the second block removes that lattice sum exactly. -/
theorem coupledQuadraticChart_atom_of_partition {d : ℕ} (A B : QuadraticChartData d)
    (hB : ∀ z : Fin d → ℝ, ∑' m : Fin d → ℤ, B.amplitude (fun i => z i - (m i : ℝ)) = 1)
    (y : ℝ) :
    quadraticChartAtom (coupledQuadraticChart A B) y =
      (Real.fourierChar ((A.quadratic + B.quadratic) * y ^ 2 +
        (A.linear + B.linear) * y) : ℂ) *
      ∑' n : Fin d → ℤ, A.amplitude (chartLatticeRemainder A y n) *
        (Real.fourierChar (y * ∑ i, B.horizontal i * chartLatticeRemainder A y n i) : ℂ) := by
  rw [coupledQuadraticChart_atom]
  have h := hB (chartHorizontalPosition B y)
  change (∑' m : Fin d → ℤ, B.amplitude (chartLatticeRemainder B y m)) = 1 at h
  rw [h, mul_one]

/-- A finite product of finitely supported series factors without convergence qualifications. -/
theorem finite_support_tsum_product {ι κ : Type*} [Fintype ι]
    (f : ι → κ → ℂ) (hf : ∀ i, (f i).HasFiniteSupport) :
    (∑' k : ι → κ, ∏ i, f i (k i)) = ∏ i, ∑' j, f i j := by
  classical
  let s : ι → Finset κ := fun i => (hf i).toFinset
  have hout (i : ι) (j : κ) (hj : j ∉ s i) : f i j = 0 := by
    by_contra h
    exact hj ((hf i).mem_toFinset.mpr h)
  have hzero (k : ι → κ) (hk : k ∉ Fintype.piFinset s) : (∏ i, f i (k i)) = 0 := by
    by_contra h
    apply hk
    apply Fintype.mem_piFinset.mpr
    intro i
    by_contra hi
    exact h (Finset.prod_eq_zero (Finset.mem_univ i) (hout i (k i) hi))
  rw [tsum_eq_sum (s := Fintype.piFinset s) hzero, ← Finset.prod_univ_sum]
  apply Finset.prod_congr rfl
  intro i _
  exact (tsum_eq_sum (s := s i) (hout i)).symm

/-- Tensor product of a real cutoff, viewed as a complex amplitude. -/
noncomputable def chartCoordinateProduct {d : ℕ} (f : ℝ → ℝ) (z : Fin d → ℝ) : ℂ :=
  ∏ i, (f (z i) : ℂ)

theorem chartCoordinateProduct_smooth {d : ℕ} {f : ℝ → ℝ}
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) :
    ContDiff ℝ (⊤ : ℕ∞) (chartCoordinateProduct (d := d) f) := by
  apply contDiff_prod
  intro i _
  exact Complex.ofRealCLM.contDiff.comp (hf.comp (contDiff_apply ℝ _ i))

theorem chartCoordinateProduct_compact {d : ℕ} {f : ℝ → ℝ}
    (hf : HasCompactSupport f) :
    HasCompactSupport (chartCoordinateProduct (d := d) f) := by
  obtain ⟨H, hH, hbound⟩ := hf.isBounded.exists_pos_norm_le
  apply HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall 0 H)
  intro z hz
  rw [Metric.mem_closedBall, dist_zero_right]
  apply (pi_norm_le_iff_of_nonneg hH.le).mpr
  intro i
  have hprod : ∏ j : Fin d, (f (z j) : ℂ) ≠ 0 := hz
  have hfi : f (z i) ≠ 0 := by
    intro h
    exact hprod (Finset.prod_eq_zero (Finset.mem_univ i) (by simp [h]))
  exact hbound _ (subset_tsupport f hfi)

/-- A compact product cutoff multiplied by a real quadratic phase. -/
noncomputable def chartQuadraticAmplitude {d : ℕ}
    (f : ℝ → ℝ) (C : Fin d → Fin d → ℝ) (z : Fin d → ℝ) : ℂ :=
  chartCoordinateProduct f z * (Real.fourierChar (∑ i, ∑ j, C i j * z i * z j) : ℂ)

theorem chartQuadraticAmplitude_smooth {d : ℕ} {f : ℝ → ℝ}
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (C : Fin d → Fin d → ℝ) :
    ContDiff ℝ (⊤ : ℕ∞) (chartQuadraticAmplitude f C) := by
  apply (chartCoordinateProduct_smooth hf).mul
  apply chart_fourierChar_smooth.comp
  apply ContDiff.sum
  intro i _
  apply ContDiff.sum
  intro j _
  exact (contDiff_const.mul (contDiff_apply ℝ _ i)).mul (contDiff_apply ℝ _ j)

theorem chartQuadraticAmplitude_compact {d : ℕ} {f : ℝ → ℝ}
    (hf : HasCompactSupport f) (C : Fin d → Fin d → ℝ) :
    HasCompactSupport (chartQuadraticAmplitude f C) :=
  (chartCoordinateProduct_compact hf).mul_right

/-- A zero-matrix chart encoding the periodization of an arbitrary smooth compact amplitude. -/
noncomputable def amplitudeQuadraticChart {d : ℕ} (θ : Fin d → ℝ) (ell : ℝ)
    (f : (Fin d → ℝ) → ℂ) (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hc : HasCompactSupport f) :
    QuadraticChartData d where
  horizontal := θ
  quadratic := ell
  linear := 0
  matrix := 0
  amplitude := f
  smooth := hf
  compact := hc

/-- The source doubled-horizontal chart, with a quadratic cutoff in the first block
 and a tensor partition in the second; blueprint `lem:local-chart`, lines 1069-1076. -/
noncomputable def localizedQuadraticChart {d : ℕ}
    (θ v : Fin d → ℝ) (ell : ℝ) (C : Fin d → Fin d → ℝ) (f g : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hfc : HasCompactSupport f) (hgc : HasCompactSupport g) : QuadraticChartData (d + d) :=
  coupledQuadraticChart
    (amplitudeQuadraticChart θ ell (chartQuadraticAmplitude f C)
      (chartQuadraticAmplitude_smooth hf C) (chartQuadraticAmplitude_compact hfc C))
    (amplitudeQuadraticChart v 0 (chartCoordinateProduct g)
      (chartCoordinateProduct_smooth hg) (chartCoordinateProduct_compact hgc))

theorem compact_real_translate_finite_support (g : ℝ → ℝ) (hg : HasCompactSupport g)
    (x : ℝ) : (fun k : ℤ => (g (x - (k : ℝ)) : ℂ)).HasFiniteSupport := by
  classical
  obtain ⟨H, _, hH⟩ := hg.isBounded.exists_pos_norm_le
  apply (Finset.Icc ⌊x - H⌋ ⌊x + H⌋).finite_toSet.subset
  intro k hk
  have hne : g (x - (k : ℝ)) ≠ 0 := by
    intro h
    exact hk (by simp [h])
  have ha : |x - (k : ℝ)| ≤ H := hH _ (subset_tsupport g hne)
  obtain ⟨hlo, hhi⟩ := abs_le.mp ha
  apply Finset.mem_Icc.mpr
  constructor
  · have h : x - H ≤ (k : ℝ) := by linarith
    simpa only [Int.floor_intCast] using Int.floor_mono h
  · apply Int.le_floor.mpr
    linarith

/-- Tensoring a compact one-dimensional partition gives an exact lattice partition. -/
theorem chartCoordinateProduct_periodization {d : ℕ} (g : ℝ → ℝ)
    (hg : HasCompactSupport g) (hpart : ∀ x : ℝ, ∑' k : ℤ, g (x - (k : ℝ)) = 1)
    (z : Fin d → ℝ) :
    (∑' k : Fin d → ℤ, chartCoordinateProduct g (fun i => z i - (k i : ℝ))) = 1 := by
  unfold chartCoordinateProduct
  rw [finite_support_tsum_product (fun i (k : ℤ) => (g (z i - (k : ℝ)) : ℂ))
    (fun i => compact_real_translate_finite_support g hg (z i))]
  simp only [← Complex.ofReal_tsum, hpart, Complex.ofReal_one, Finset.prod_const_one]

/-- The local chart's actual lattice formula after canceling its tensor partition. -/
theorem localizedQuadraticChart_atom {d : ℕ}
    (θ v : Fin d → ℝ) (ell : ℝ) (C : Fin d → Fin d → ℝ) (f g : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hfc : HasCompactSupport f) (hgc : HasCompactSupport g)
    (hpart : ∀ x : ℝ, ∑' k : ℤ, g (x - (k : ℝ)) = 1) (y : ℝ) :
    quadraticChartAtom (localizedQuadraticChart θ v ell C f g hf hg hfc hgc) y =
      (Real.fourierChar (ell * y ^ 2) : ℂ) *
      ∑' k : Fin d → ℤ,
        chartCoordinateProduct f (fun i => θ i * y - (k i : ℝ)) *
          (Real.fourierChar
            ((∑ i, ∑ j, C i j * (θ i * y - (k i : ℝ)) * (θ j * y - (k j : ℝ))) +
              y * ∑ i, v i * (θ i * y - (k i : ℝ))) : ℂ) := by
  unfold localizedQuadraticChart
  rw [coupledQuadraticChart_atom_of_partition _ _
    (chartCoordinateProduct_periodization g hgc hpart)]
  simp only [amplitudeQuadraticChart, chartLatticeRemainder, add_zero, zero_mul,
    chartQuadraticAmplitude]
  congr 1
  apply tsum_congr
  intro k
  rw [AddChar.map_add_eq_mul, Circle.coe_mul]
  exact mul_assoc _ _ _

theorem localizedQuadraticChart_height {d : ℕ}
    (θ v : Fin d → ℝ) (ell : ℝ) (C : Fin d → Fin d → ℝ) (f g : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hfc : HasCompactSupport f) (hgc : HasCompactSupport g) (i j : Fin (d + d)) :
    chartRationalHeight ((localizedQuadraticChart θ v ell C f g hf hg hfc hgc).matrix i j) = 1 :=
  chartCouplingMatrix_height d i j

/-- Scaling a cutoff supported in the unit interval gives a compactly supported cutoff. -/
theorem scaled_unit_cutoff_compact (f : ℝ → ℝ) (hsupp : ∀ x, 1 ≤ |x| → f x = 0)
    {r : ℝ} (hr : 0 < r) : HasCompactSupport (fun x => f (x / r)) := by
  apply HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall 0 r)
  intro x hx
  rw [Metric.mem_closedBall, dist_zero_right, Real.norm_eq_abs]
  by_contra h
  apply hx
  apply hsupp
  rw [abs_div, abs_of_pos hr]
  exact (le_div_iff₀ hr).mpr (by linarith)

/-- A centered lattice representative and a strictly shorter representative must coincide. -/
theorem integer_translate_unique {d : ℕ} (z : Fin d → ℝ) (k l : Fin d → ℤ)
    (hk : ∀ i, |z i - (k i : ℝ)| ≤ 1 / 2)
    (hl : ∀ i, |z i - (l i : ℝ)| < 1 / 2) : k = l := by
  funext i
  have heq : ((k i - l i : ℤ) : ℝ) = (z i - (l i : ℝ)) - (z i - (k i : ℝ)) := by
    push_cast
    ring
  have hr : |((k i - l i : ℤ) : ℝ)| < 1 := by
    rw [heq]
    have h := abs_sub (z i - (l i : ℝ)) (z i - (k i : ℝ))
    linarith [hk i, hl i]
  have hi : |k i - l i| < (1 : ℤ) := by exact_mod_cast hr
  have h := abs_lt.mp hi
  omega

theorem chartCoordinateProduct_coord_lt {d : ℕ} {f : ℝ → ℝ} {r : ℝ}
    (hsupp : ∀ x, r ≤ |x| → f x = 0) (z : Fin d → ℝ)
    (hz : chartCoordinateProduct f z ≠ 0) (i : Fin d) : |z i| < r := by
  by_contra h
  have hfi := hsupp (z i) (le_of_not_gt h)
  exact hz (Finset.prod_eq_zero (Finset.mem_univ i) (by simp [hfi]))

/-- The entire lattice sum is its centered term, including when that term vanishes. -/
theorem localizedQuadraticChart_at_center {d : ℕ}
    (θ v : Fin d → ℝ) (ell : ℝ) (C : Fin d → Fin d → ℝ) (f g : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hfc : HasCompactSupport f) (hgc : HasCompactSupport g)
    (hpart : ∀ x : ℝ, ∑' k : ℤ, g (x - (k : ℝ)) = 1)
    {r : ℝ} (hr : r < 1 / 2) (hsupp : ∀ x, r ≤ |x| → f x = 0)
    (y : ℝ) (k : Fin d → ℤ) (hk : ∀ i, |θ i * y - (k i : ℝ)| ≤ 1 / 2) :
    quadraticChartAtom (localizedQuadraticChart θ v ell C f g hf hg hfc hgc) y =
      (Real.fourierChar (ell * y ^ 2) : ℂ) *
        chartCoordinateProduct f (fun i => θ i * y - (k i : ℝ)) *
        (Real.fourierChar
          ((∑ i, ∑ j, C i j * (θ i * y - (k i : ℝ)) * (θ j * y - (k j : ℝ))) +
            y * ∑ i, v i * (θ i * y - (k i : ℝ))) : ℂ) := by
  rw [localizedQuadraticChart_atom θ v ell C f g hf hg hfc hgc hpart]
  rw [tsum_eq_single k]
  · exact (mul_assoc _ _ _).symm
  · intro l hl
    have hz : chartCoordinateProduct f (fun i => θ i * y - (l i : ℝ)) = 0 := by
      by_contra h
      have hl' (i : Fin d) : |θ i * y - (l i : ℝ)| < 1 / 2 :=
        (chartCoordinateProduct_coord_lt hsupp _ h i).trans hr
      exact hl (integer_translate_unique (fun i => θ i * y) k l hk hl').symm
    rw [hz, zero_mul]

theorem chartCoordinateProduct_norm_le_one {d : ℕ} (f : ℝ → ℝ)
    (hf : ∀ x, |f x| ≤ 1) (z : Fin d → ℝ) : ‖chartCoordinateProduct f z‖ ≤ 1 := by
  calc
    _ = ∏ i, |f (z i)| := by simp [chartCoordinateProduct, norm_prod]
    _ ≤ 1 := Finset.prod_le_one₀ (fun i _ => abs_nonneg _) (fun i _ => hf (z i))

/-- Compact unit cutoffs of width less than one yield a chart bounded on the entire real line. -/
theorem localizedQuadraticChart_bounded {d : ℕ}
    (θ v : Fin d → ℝ) (ell : ℝ) (C : Fin d → Fin d → ℝ) (f g : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hfc : HasCompactSupport f) (hgc : HasCompactSupport g)
    (hpart : ∀ x : ℝ, ∑' k : ℤ, g (x - (k : ℝ)) = 1)
    {r : ℝ} (hr : r < 1 / 2) (hsupp : ∀ x, r ≤ |x| → f x = 0)
    (hunit : ∀ x, |f x| ≤ 1) :
    IsBoundedQuadraticChart (localizedQuadraticChart θ v ell C f g hf hg hfc hgc) := by
  intro y
  let k : Fin d → ℤ := fun i => ⌊θ i * y + 1 / 2⌋
  have hk (i : Fin d) : |θ i * y - (k i : ℝ)| ≤ 1 / 2 := by
    have hlo := Int.floor_le (θ i * y + 1 / 2)
    have hhi := Int.lt_floor_add_one (θ i * y + 1 / 2)
    apply abs_le.mpr
    dsimp [k]
    constructor <;> linarith
  rw [localizedQuadraticChart_at_center θ v ell C f g hf hg hfc hgc hpart hr hsupp y k hk]
  simp only [norm_mul, Circle.norm_coe, one_mul, mul_one]
  exact chartCoordinateProduct_norm_le_one f hunit _

/-- Geometric derivative bounds combine by adding their bases. -/
theorem derivative_product_geometric {E A : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedCommRing A] [NormedAlgebra ℝ A]
    {f g : E → A} (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (x : E) {m : ℕ} {R T : ℝ} (hR : 0 ≤ R) (_hT : 0 ≤ T)
    (hfi : ∀ i ≤ m, ‖iteratedFDeriv ℝ i f x‖ ≤ R ^ i)
    (hgi : ∀ i ≤ m, ‖iteratedFDeriv ℝ i g x‖ ≤ T ^ i) :
    ‖iteratedFDeriv ℝ m (fun y => f y * g y) x‖ ≤ (R + T) ^ m := by
  calc
    _ ≤ ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) *
        ‖iteratedFDeriv ℝ i f x‖ * ‖iteratedFDeriv ℝ (m - i) g x‖ :=
      norm_iteratedFDeriv_mul_le hf hg x (by simp)
    _ ≤ ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * R ^ i * T ^ (m - i) := by
      apply Finset.sum_le_sum
      intro i hi
      have hi' : i ≤ m := by simpa only [Finset.mem_range, Nat.lt_succ_iff] using hi
      gcongr
      · exact hfi i hi'
      · exact hgi (m - i) (Nat.sub_le _ _)
    _ = (R + T) ^ m := by
      rw [add_pow]
      apply Finset.sum_congr rfl
      intro i _
      ring

/-- A tensor product of unit zeroth derivatives has a dimension-to-the-order loss. -/
theorem finite_product_derivative_geometric {ι E A : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedCommRing A] [NormedAlgebra ℝ A] [NormOneClass A]
    (u : Finset ι) (f : ι → E → A)
    (hf : ∀ j ∈ u, ContDiff ℝ (⊤ : ℕ∞) (f j))
    (x : E) {m : ℕ} {R : ℝ} (hR : 0 ≤ R)
    (hfi : ∀ j ∈ u, ∀ i ≤ m, ‖iteratedFDeriv ℝ i (f j) x‖ ≤ R ^ i) :
    ‖iteratedFDeriv ℝ m (fun y => ∏ j ∈ u, f j y) x‖ ≤ ((u.card : ℝ) * R) ^ m := by
  classical
  induction u using Finset.induction generalizing m with
  | empty =>
    cases m <;> simp [iteratedFDeriv_succ_const]
  | @insert j u hj ih =>
    have hju : ∀ i ∈ u, ContDiff ℝ (⊤ : ℕ∞) (f i) :=
      fun i hi => hf i (Finset.mem_insert_of_mem hi)
    have hprod : ContDiff ℝ (⊤ : ℕ∞) (fun y => ∏ i ∈ u, f i y) := contDiff_prod hju
    have hinner (k : ℕ) (hk : k ≤ m) :
        ‖iteratedFDeriv ℝ k (fun y => ∏ i ∈ u, f i y) x‖ ≤ ((u.card : ℝ) * R) ^ k :=
      ih hju (fun i hi a ha => hfi i (Finset.mem_insert_of_mem hi) a (ha.trans hk))
    have h := derivative_product_geometric (hf j (Finset.mem_insert_self _ _)) hprod x
      hR (mul_nonneg (Nat.cast_nonneg _) hR)
      (hfi j (Finset.mem_insert_self _ _)) hinner
    simpa only [Finset.prod_insert hj, Finset.card_insert_of_notMem hj, Nat.cast_add,
      Nat.cast_one, add_mul, one_mul, add_comm R] using h

/-- Restricting to one coordinate cannot increase a derivative operator norm. -/
theorem coordinate_composition_derivative_norm {d : ℕ} {A : Type*}
    [NormedAddCommGroup A] [NormedSpace ℝ A] {f : ℝ → A}
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (i : Fin d) (z : Fin d → ℝ) (m : ℕ) :
    ‖iteratedFDeriv ℝ m (fun y : Fin d → ℝ => f (y i)) z‖ ≤
      ‖iteratedDeriv m f (z i)‖ := by
  let L : (Fin d → ℝ) →L[ℝ] ℝ := ContinuousLinearMap.proj i
  have hL : ‖L‖ ≤ 1 := by
    apply L.opNorm_le_bound zero_le_one
    intro y
    simpa only [L, ContinuousLinearMap.proj_apply, one_mul] using norm_le_pi_norm y i
  change ‖iteratedFDeriv ℝ m (f ∘ L) z‖ ≤ _
  rw [L.iteratedFDeriv_comp_right hf z (by simp)]
  apply (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans
  rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  calc
    _ ≤ ‖iteratedDeriv m f (L z)‖ * 1 := by
      gcongr
      exact Finset.prod_le_one₀ (fun _ _ => norm_nonneg L) (fun _ _ => hL)
    _ = _ := mul_one _

theorem coordinate_projection_derivative_norm {d : ℕ} (z : Fin d → ℝ)
    (hz : ∀ i, |z i| ≤ 1) (i : Fin d) (m : ℕ) :
    ‖iteratedFDeriv ℝ m (fun y : Fin d → ℝ => y i) z‖ ≤ 1 := by
  apply (coordinate_composition_derivative_norm contDiff_id i z m).trans
  rw [iteratedDeriv_id]
  split_ifs <;> simpa only [Real.norm_eq_abs, abs_one, abs_zero] using
    (by first | exact hz i | norm_num : _ ≤ (1 : ℝ))

/-- A product of two coordinates has geometric derivative bounds throughout the unit cube. -/
theorem coordinate_product_derivative_norm {d : ℕ} (z : Fin d → ℝ)
    (hz : ∀ i, |z i| ≤ 1) (i j : Fin d) (m : ℕ) :
    ‖iteratedFDeriv ℝ m (fun y : Fin d → ℝ => y i * y j) z‖ ≤ (2 : ℝ) ^ m := by
  simpa only [one_add_one_eq_two] using derivative_product_geometric
    (contDiff_apply ℝ _ i) (contDiff_apply ℝ _ j) z
    (by norm_num : (0 : ℝ) ≤ 1) (by norm_num : (0 : ℝ) ≤ 1)
    (fun k _ => by simpa only [one_pow] using coordinate_projection_derivative_norm z hz i k)
    (fun k _ => by simpa only [one_pow] using coordinate_projection_derivative_norm z hz j k)

/-- Bounded quadratic coefficients give a uniform operator-derivative bound on the unit cube. -/
theorem bounded_quadratic_derivative_norm {d : ℕ} (C : Fin d → Fin d → ℝ)
    (hC : ∀ i j, |C i j| ≤ 1) (z : Fin d → ℝ) (hz : ∀ i, |z i| ≤ 1) (m : ℕ) :
    ‖iteratedFDeriv ℝ m (fun y : Fin d → ℝ => ∑ i, ∑ j, C i j * y i * y j) z‖ ≤
      (d : ℝ) ^ 2 * (2 : ℝ) ^ m := by
  have hsm (i j : Fin d) : ContDiff ℝ m (fun y : Fin d → ℝ => C i j * y i * y j) :=
    (contDiff_const.mul (contDiff_apply ℝ _ i)).mul (contDiff_apply ℝ _ j)
  have hmono (i j : Fin d) :
      ‖iteratedFDeriv ℝ m (fun y : Fin d → ℝ => C i j * y i * y j) z‖ ≤ (2 : ℝ) ^ m := by
    have he : (fun y : Fin d → ℝ => C i j * y i * y j) =
        (fun y : Fin d → ℝ => C i j • (y i * y j)) := by
      funext y
      simp only [smul_eq_mul, mul_assoc]
    rw [he, iteratedFDeriv_const_smul_apply'
      (((contDiff_apply ℝ _ i).mul (contDiff_apply ℝ _ j) :
        ContDiff ℝ m (fun y : Fin d → ℝ => y i * y j)).contDiffAt),
      norm_smul, Real.norm_eq_abs]
    calc
      _ ≤ 1 * (2 : ℝ) ^ m := mul_le_mul (hC i j)
        (coordinate_product_derivative_norm z hz i j m) (norm_nonneg _) zero_le_one
      _ = _ := one_mul _
  rw [iteratedFDeriv_fun_sum_apply
    (fun i _ => (ContDiff.sum fun j _ => hsm i j).contDiffAt)]
  calc
    _ ≤ ∑ i, ‖iteratedFDeriv ℝ m (fun y : Fin d → ℝ => ∑ j, C i j * y i * y j) z‖ :=
      norm_sum_le _ _
    _ ≤ ∑ _i : Fin d, ∑ _j : Fin d, (2 : ℝ) ^ m := by
      apply Finset.sum_le_sum
      intro i _
      rw [iteratedFDeriv_fun_sum_apply (fun j _ => (hsm i j).contDiffAt)]
      exact (norm_sum_le _ _).trans (Finset.sum_le_sum fun j _ => hmono i j)
    _ = _ := by simp; ring

/-- The Fourier exponential of a bounded quadratic has factorial-geometric derivatives
 on the unit cube; no horizontal frequencies or lattice basis occur in the bound. -/
theorem bounded_quadratic_phase_derivative_norm {d : ℕ} (C : Fin d → Fin d → ℝ)
    (hC : ∀ i j, |C i j| ≤ 1) (z : Fin d → ℝ) (hz : ∀ i, |z i| ≤ 1) (m : ℕ) :
    ‖iteratedFDeriv ℝ m
      (fun y : Fin d → ℝ => (Real.fourierChar (∑ i, ∑ j, C i j * y i * y j) : ℂ)) z‖ ≤
      (m.factorial : ℝ) * (4 * Real.pi * (d + 1 : ℝ) ^ 2) ^ m := by
  let Q : (Fin d → ℝ) → ℝ := fun y => ∑ i, ∑ j, C i j * y i * y j
  have hQ : ContDiff ℝ (⊤ : ℕ∞) Q := by
    apply ContDiff.sum
    intro i _
    apply ContDiff.sum
    intro j _
    exact (contDiff_const.mul (contDiff_apply ℝ _ i)).mul (contDiff_apply ℝ _ j)
  have hpi : 1 ≤ 2 * Real.pi := by linarith [Real.pi_gt_three]
  have houter (i : ℕ) (hi : i ≤ m) :
      ‖iteratedFDeriv ℝ i (fun t : ℝ => (Real.fourierChar t : ℂ)) (Q z)‖ ≤
        (2 * Real.pi) ^ m := by
    rw [chart_fourierChar_derivative_norm]
    exact pow_le_pow_right₀ hpi hi
  have hinner (i : ℕ) (hi : 1 ≤ i) (_him : i ≤ m) :
      ‖iteratedFDeriv ℝ i Q z‖ ≤ (2 * (d + 1 : ℝ) ^ 2) ^ i := by
    apply (bounded_quadratic_derivative_norm C hC z hz i).trans
    rw [mul_pow]
    have hd : 1 ≤ (d + 1 : ℝ) ^ 2 := by
      have := Nat.cast_nonneg (α := ℝ) d
      nlinarith
    have hp : (d : ℝ) ^ 2 ≤ ((d + 1 : ℝ) ^ 2) ^ i := by
      calc
        _ ≤ (d + 1 : ℝ) ^ 2 := by have := Nat.cast_nonneg (α := ℝ) d; nlinarith
        _ ≤ _ := le_self_pow₀ hd (by omega)
    nlinarith [pow_nonneg (by norm_num : (0 : ℝ) ≤ 2) i]
  have h := norm_iteratedFDeriv_comp_le (n := m) chart_fourierChar_smooth hQ
    (by simp) z houter hinner
  change ‖iteratedFDeriv ℝ m
    (fun y : Fin d → ℝ => (Real.fourierChar (∑ i, ∑ j, C i j * y i * y j) : ℂ)) z‖ ≤ _ at h
  convert h using 1
  rw [mul_assoc (m.factorial : ℝ), ← mul_pow]
  congr 2
  ring

/-- Uniform one-variable geometric bounds yield an operator-norm tensor cutoff bound. -/
theorem chartCoordinateProduct_derivative_geometric {d : ℕ} {f : ℝ → ℝ}
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (z : Fin d → ℝ) {m : ℕ} {R : ℝ} (hR : 0 ≤ R)
    (hfi : ∀ i ≤ m, ∀ x : ℝ, |iteratedDeriv i f x| ≤ R ^ i) :
    ‖iteratedFDeriv ℝ m (chartCoordinateProduct (d := d) f) z‖ ≤ ((d : ℝ) * R) ^ m := by
  have hs (j : Fin d) : ContDiff ℝ (⊤ : ℕ∞) (fun y : Fin d → ℝ => f (y j)) :=
    hf.comp (contDiff_apply ℝ _ j)
  have hd (j : Fin d) (i : ℕ) (hi : i ≤ m) :
      ‖iteratedFDeriv ℝ i (fun y : Fin d → ℝ => f (y j)) z‖ ≤ R ^ i := by
    apply (coordinate_composition_derivative_norm hf j z i).trans
    simpa only [Real.norm_eq_abs] using hfi i hi (z j)
  have hp := finite_product_derivative_geometric Finset.univ
    (fun j (y : Fin d → ℝ) => f (y j)) (fun j _ => hs j) z hR (fun j _ => hd j)
  have he : chartCoordinateProduct (d := d) f =
      Complex.ofRealLI ∘ (fun y : Fin d → ℝ => ∏ j, f (y j)) := by
    funext y
    simp only [chartCoordinateProduct, Function.comp_apply, Complex.ofRealLI_apply,
      Complex.ofReal_prod]
  rw [he, Complex.ofRealLI.norm_iteratedFDeriv_comp_left
    ((contDiff_prod (fun j _ => hs j)).contDiffAt) (by simp)]
  simpa only [Finset.card_univ, Fintype.card_fin] using hp

/-- Coordinate restriction cannot increase an iterated derivative operator norm. -/
theorem chart_restriction_derivative_norm {d D : ℕ} {f : (Fin d → ℝ) → ℂ}
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (s : Fin d → Fin D) (z : Fin D → ℝ) (m : ℕ) :
    ‖iteratedFDeriv ℝ m (fun y => f (fun i => y (s i))) z‖ ≤
      ‖iteratedFDeriv ℝ m f (fun i => z (s i))‖ := by
  change ‖iteratedFDeriv ℝ m (f ∘ chartCoordinateRestriction s) z‖ ≤ _
  rw [(chartCoordinateRestriction s).iteratedFDeriv_comp_right hf z (by simp)]
  apply (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans
  have hp : (∏ _i : Fin m, ‖chartCoordinateRestriction s‖) ≤ 1 :=
    Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) (fun _ _ => chartCoordinateRestriction_norm_le s)
  calc
    _ ≤ ‖iteratedFDeriv ℝ m f (chartCoordinateRestriction s z)‖ * 1 :=
      mul_le_mul_of_nonneg_left hp (norm_nonneg _)
    _ = _ := mul_one _

theorem bounded_quadratic_phase_derivative_geometric {d : ℕ}
    (C : Fin d → Fin d → ℝ) (hC : ∀ i j, |C i j| ≤ 1)
    (z : Fin d → ℝ) (hz : ∀ i, |z i| ≤ 1) (m i : ℕ) (hi : i ≤ m) :
    ‖iteratedFDeriv ℝ i
      (fun y : Fin d → ℝ => (Real.fourierChar (∑ j, ∑ k, C j k * y j * y k) : ℂ)) z‖ ≤
      (4 * Real.pi * (d + 1 : ℝ) ^ 2 * (m + 1 : ℝ)) ^ i := by
  apply (bounded_quadratic_phase_derivative_norm C hC z hz i).trans
  have hfact : (i.factorial : ℝ) ≤ (m + 1 : ℝ) ^ i := by
    calc
      _ ≤ (i : ℝ) ^ i := by exact_mod_cast Nat.factorial_le_pow i
      _ ≤ _ := pow_le_pow_left₀ (Nat.cast_nonneg _) (by exact_mod_cast Nat.le_succ_of_le hi) _
  calc
    _ ≤ (m + 1 : ℝ) ^ i * (4 * Real.pi * (d + 1 : ℝ) ^ 2) ^ i :=
      mul_le_mul_of_nonneg_right hfact (by positivity)
    _ = _ := (mul_comm _ _).trans (mul_pow _ _ _).symm

/-- The quadratic cutoff has geometric bounds up to a chosen order inside the unit cube. -/
theorem chartQuadraticAmplitude_derivative_geometric {d : ℕ} {f : ℝ → ℝ}
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (C : Fin d → Fin d → ℝ)
    (hC : ∀ i j, |C i j| ≤ 1) (z : Fin d → ℝ) (hz : ∀ i, |z i| ≤ 1)
    {m i : ℕ} (hi : i ≤ m) {R : ℝ} (hR : 0 ≤ R)
    (hfi : ∀ j ≤ m, ∀ x : ℝ, |iteratedDeriv j f x| ≤ R ^ j) :
    ‖iteratedFDeriv ℝ i (chartQuadraticAmplitude f C) z‖ ≤
      ((d : ℝ) * R + 4 * Real.pi * (d + 1 : ℝ) ^ 2 * (m + 1 : ℝ)) ^ i := by
  have hphase : ContDiff ℝ (⊤ : ℕ∞)
      (fun y : Fin d → ℝ => (Real.fourierChar (∑ j, ∑ k, C j k * y j * y k) : ℂ)) := by
    apply chart_fourierChar_smooth.comp
    apply ContDiff.sum
    intro j _
    apply ContDiff.sum
    intro k _
    exact (contDiff_const.mul (contDiff_apply ℝ _ j)).mul (contDiff_apply ℝ _ k)
  exact derivative_product_geometric (chartCoordinateProduct_smooth hf) hphase z
    (mul_nonneg (Nat.cast_nonneg _) hR) (by positivity)
    (fun j hj => chartCoordinateProduct_derivative_geometric hf z hR
      (fun k hk => hfi k (hk.trans (hj.trans hi))))
    (fun j hj => bounded_quadratic_phase_derivative_geometric C hC z hz m j (hj.trans hi))

/-- The actual doubled amplitude and all its derivatives are supported in the unit cube. -/
theorem localizedQuadraticChart_amplitude_support {d : ℕ}
    (θ v : Fin d → ℝ) (ell : ℝ) (C : Fin d → Fin d → ℝ) (f g : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hfc : HasCompactSupport f) (hgc : HasCompactSupport g)
    (hfs : ∀ x, 1 ≤ |x| → f x = 0) (hgs : ∀ x, 1 ≤ |x| → g x = 0) :
    tsupport (localizedQuadraticChart θ v ell C f g hf hg hfc hgc).amplitude ⊆
      Metric.closedBall 0 1 := by
  apply closure_minimal _ Metric.isClosed_closedBall
  intro z hz
  change (chartCoordinateProduct f (fun i => z (Fin.castAdd d i)) *
      (Real.fourierChar _) : ℂ) *
    chartCoordinateProduct g (fun i => z (Fin.natAdd d i)) ≠ 0 at hz
  have hfz := (mul_ne_zero_iff.mp (mul_ne_zero_iff.mp hz).1).1
  have hgz := (mul_ne_zero_iff.mp hz).2
  rw [Metric.mem_closedBall, dist_zero_right]
  apply (pi_norm_le_iff_of_nonneg zero_le_one).mpr
  intro i
  refine Fin.addCases (fun j => ?_) (fun j => ?_) i
  · exact (chartCoordinateProduct_coord_lt hfs _ hfz j).le
  · exact (chartCoordinateProduct_coord_lt hgs _ hgz j).le

/-- Operator-norm derivatives of the actual doubled chart amplitude have a uniform
 geometric bound. Compact support removes the need for any restriction on the evaluation point. -/
theorem localizedQuadraticChart_amplitude_derivative_geometric {d : ℕ}
    (θ v : Fin d → ℝ) (ell : ℝ) (C : Fin d → Fin d → ℝ) (f g : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hfc : HasCompactSupport f) (hgc : HasCompactSupport g)
    (hfs : ∀ x, 1 ≤ |x| → f x = 0) (hgs : ∀ x, 1 ≤ |x| → g x = 0)
    (hC : ∀ i j, |C i j| ≤ 1) (z : Fin (d + d) → ℝ) (m : ℕ)
    {R T : ℝ} (hR : 0 ≤ R) (hT : 0 ≤ T)
    (hfi : ∀ i ≤ m, ∀ x : ℝ, |iteratedDeriv i f x| ≤ R ^ i)
    (hgi : ∀ i ≤ m, ∀ x : ℝ, |iteratedDeriv i g x| ≤ T ^ i) :
    ‖iteratedFDeriv ℝ m
      (localizedQuadraticChart θ v ell C f g hf hg hfc hgc).amplitude z‖ ≤
      ((d : ℝ) * R + 4 * Real.pi * (d + 1 : ℝ) ^ 2 * (m + 1 : ℝ) + (d : ℝ) * T) ^ m := by
  let A := localizedQuadraticChart θ v ell C f g hf hg hfc hgc
  by_cases hz : ‖z‖ ≤ 1
  · have hzL (i : Fin d) : |z (Fin.castAdd d i)| ≤ 1 :=
      (norm_le_pi_norm z (Fin.castAdd d i)).trans hz
    have hleft : ContDiff ℝ (⊤ : ℕ∞)
        (fun y : Fin (d + d) → ℝ => chartQuadraticAmplitude f C (fun i => y (Fin.castAdd d i))) :=
      (chartQuadraticAmplitude_smooth hf C).comp
        (chartCoordinateRestriction (Fin.castAdd d)).contDiff
    have hright : ContDiff ℝ (⊤ : ℕ∞)
        (fun y : Fin (d + d) → ℝ => chartCoordinateProduct g (fun i => y (Fin.natAdd d i))) :=
      (chartCoordinateProduct_smooth hg).comp (chartCoordinateRestriction (Fin.natAdd d)).contDiff
    apply derivative_product_geometric hleft hright z (by positivity)
      (mul_nonneg (Nat.cast_nonneg _) hT)
    · intro i hi
      apply (chart_restriction_derivative_norm (chartQuadraticAmplitude_smooth hf C)
        (Fin.castAdd d) z i).trans
      exact chartQuadraticAmplitude_derivative_geometric hf C hC _ hzL hi hR hfi
    · intro i hi
      apply (chart_restriction_derivative_norm (chartCoordinateProduct_smooth hg)
        (Fin.natAdd d) z i).trans
      exact chartCoordinateProduct_derivative_geometric hg _ hT (fun j hj => hgi j (hj.trans hi))
  · have hzero : iteratedFDeriv ℝ m A.amplitude z = 0 := by
      by_contra h
      have hs := support_iteratedFDeriv_subset (𝕜 := ℝ) (f := A.amplitude) m h
      have hb := localizedQuadraticChart_amplitude_support θ v ell C f g hf hg hfc hgc hfs hgs hs
      exact hz (by simpa only [Metric.mem_closedBall, dist_zero_right] using hb)
    change ‖iteratedFDeriv ℝ m A.amplitude z‖ ≤ _
    rw [hzero, norm_zero]
    positivity

/-- Unit zeroth derivatives remove the dimension-dependent loss in a Gevrey product. -/
theorem gevrey_derivative_geometric (f : ℝ → ℝ) (K : ℕ) (hK : 1 ≤ K)
    (hunit : ∀ x, |f x| ≤ 1)
    (hderiv : ∀ i x, |iteratedDeriv i f x| ≤
      ((K : ℝ) * (i + 1 : ℝ)) ^ (K * (i + 1)))
    (m i : ℕ) (hi : i ≤ m) (x : ℝ) :
    |iteratedDeriv i f x| ≤ (((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K)) ^ i := by
  by_cases hi0 : i = 0
  · simpa only [hi0, iteratedDeriv_zero, pow_zero] using hunit x
  have hKr : (1 : ℝ) ≤ K := by exact_mod_cast hK
  have hbase : 1 ≤ (K : ℝ) * (m + 1 : ℝ) := by
    have := Nat.cast_nonneg (α := ℝ) m
    nlinarith
  calc
    _ ≤ ((K : ℝ) * (i + 1 : ℝ)) ^ (K * (i + 1)) := hderiv i x
    _ ≤ ((K : ℝ) * (m + 1 : ℝ)) ^ (K * (i + 1)) := by
      gcongr
    _ ≤ ((K : ℝ) * (m + 1 : ℝ)) ^ ((2 * K) * i) :=
      pow_le_pow_right₀ hbase (by nlinarith [Nat.one_le_iff_ne_zero.mpr hi0])
    _ = _ := pow_mul _ _ _

/-- Scaling a unit cutoff contributes exactly one inverse-radius factor per derivative. -/
theorem scaled_gevrey_derivative_geometric (f : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (K : ℕ) (hK : 1 ≤ K)
    (hunit : ∀ x, |f x| ≤ 1)
    (hderiv : ∀ i x, |iteratedDeriv i f x| ≤
      ((K : ℝ) * (i + 1 : ℝ)) ^ (K * (i + 1)))
    {r : ℝ} (hr : 0 < r) (m i : ℕ) (hi : i ≤ m) (x : ℝ) :
    |iteratedDeriv i (fun y => f (y / r)) x| ≤
      ((((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K)) / r) ^ i := by
  have he : (fun y : ℝ => f (y / r)) = (fun y : ℝ => f (r⁻¹ * y)) := by
    funext y
    rw [div_eq_mul_inv, mul_comm]
  rw [he, iteratedDeriv_comp_const_mul (hf.of_le (by simp)) r⁻¹]
  simp only [abs_mul, abs_pow, abs_inv, abs_of_pos hr]
  calc
    _ ≤ r⁻¹ ^ i * (((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K)) ^ i :=
      mul_le_mul_of_nonneg_left (gevrey_derivative_geometric f K hK hunit hderiv m i hi _)
        (by positivity)
    _ = _ := by rw [div_pow, inv_pow]; ring

/-- The geometric amplitude base fits one fixed Gevrey order, uniformly in dimension and radius. -/
theorem local_chart_derivative_budget (d K m : ℕ) (hK : 1 ≤ K)
    {r : ℝ} (hr : 0 < r) (hr1 : r ≤ 1) :
    ((d : ℝ) * (((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K) / r) +
      4 * Real.pi * (d + 1 : ℝ) ^ 2 * (m + 1 : ℝ) +
      (d : ℝ) * ((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K)) ^ m ≤
    (100 * (K + 1 : ℝ) * (d + 1 : ℝ) / r) ^ ((2 * K + 2) * (m + 1)) *
      (m + 1 : ℝ) ^ ((2 * K + 2) * (m + 1)) := by
  let A : ℝ := 100 * (K + 1 : ℝ) * (d + 1 : ℝ) / r
  let T : ℝ := A * (m + 1 : ℝ)
  have hKr : (1 : ℝ) ≤ K := by exact_mod_cast hK
  have hd : (0 : ℝ) ≤ d := Nat.cast_nonneg _
  have hm : (1 : ℝ) ≤ m + 1 := by have := Nat.cast_nonneg (α := ℝ) m; linarith
  have hnum : 100 * (K + 1 : ℝ) * (d + 1 : ℝ) ≤ A := by
    dsimp [A]
    apply (le_div_iff₀ hr).mpr
    exact mul_le_of_le_one_right (by positivity) hr1
  have hA3 : 3 ≤ A := by nlinarith
  have hAK : (K : ℝ) ≤ A := by nlinarith
  have hAd : (d + 1 : ℝ) ≤ A := by nlinarith
  have hApi : 4 * Real.pi ≤ A := by nlinarith [Real.pi_lt_four]
  have hAr : (d : ℝ) / r ≤ A := by
    dsimp [A]
    apply (div_le_div_iff_of_pos_right hr).mpr
    nlinarith
  have hT : A ≤ T := le_mul_of_one_le_right (by linarith) hm
  have hT1 : 1 ≤ T := by linarith
  have hB : ((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K) ≤ T ^ (2 * K) :=
    pow_le_pow_left₀ (by positivity) (mul_le_mul_of_nonneg_right hAK (by linarith)) _
  have hfirst : (d : ℝ) * (((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K) / r) ≤
      T ^ (2 * K + 1) := by
    calc
      _ = ((d : ℝ) / r) * ((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K) := by ring
      _ ≤ T * T ^ (2 * K) := mul_le_mul (hAr.trans hT) hB (by positivity) (by linarith)
      _ = _ := by rw [pow_succ]; ring
  have hthird : (d : ℝ) * ((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K) ≤
      T ^ (2 * K + 1) := by
    calc
      _ ≤ T * T ^ (2 * K) :=
        mul_le_mul (by linarith) hB (by positivity) (by linarith)
      _ = _ := by rw [pow_succ]; ring
  have hsecond : 4 * Real.pi * (d + 1 : ℝ) ^ 2 * (m + 1 : ℝ) ≤ T ^ (2 * K + 1) := by
    calc
      _ ≤ A * A ^ 2 * (m + 1 : ℝ) := by gcongr
      _ ≤ T ^ 3 := by
        dsimp [T]
        have hm3 : (m + 1 : ℝ) ≤ (m + 1 : ℝ) ^ 3 := le_self_pow₀ hm (by norm_num)
        nlinarith only [mul_le_mul_of_nonneg_left hm3 (show 0 ≤ A ^ 3 by positivity)]
      _ ≤ _ := pow_le_pow_right₀ hT1 (by omega)
  have hsum : (d : ℝ) * (((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K) / r) +
      4 * Real.pi * (d + 1 : ℝ) ^ 2 * (m + 1 : ℝ) +
      (d : ℝ) * ((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K) ≤ T ^ (2 * K + 2) := by
    calc
      _ ≤ 3 * T ^ (2 * K + 1) := by linarith
      _ ≤ T * T ^ (2 * K + 1) :=
        mul_le_mul_of_nonneg_right (by linarith) (pow_nonneg (by linarith) _)
      _ = _ := by rw [show 2 * K + 2 = (2 * K + 1) + 1 by omega, pow_succ]; ring
  calc
    _ ≤ (T ^ (2 * K + 2)) ^ m := pow_le_pow_left₀ (by positivity) hsum _
    _ = T ^ ((2 * K + 2) * m) := (pow_mul _ _ _).symm
    _ ≤ T ^ ((2 * K + 2) * (m + 1)) := pow_le_pow_right₀ hT1 (Nat.mul_le_mul_left _ (Nat.le_succ m))
    _ = _ := by rw [show T = A * (m + 1 : ℝ) from rfl, mul_pow]

/-- Blueprint `lem:local-chart`, line 1082: the doubled amplitude has one fixed
 Gevrey order and explicit polynomial dependence on dimension and inverse radius. -/
theorem localizedQuadraticChart_gevrey_bound {d : ℕ}
    (θ v : Fin d → ℝ) (ell : ℝ) (C : Fin d → Fin d → ℝ) (f g : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hgc : HasCompactSupport g) (hfs : ∀ x, 1 ≤ |x| → f x = 0)
    (hgs : ∀ x, 1 ≤ |x| → g x = 0) (hC : ∀ i j, |C i j| ≤ 1)
    (K : ℕ) (hK : 1 ≤ K) (hfu : ∀ x, |f x| ≤ 1) (hgu : ∀ x, |g x| ≤ 1)
    (hfderiv : ∀ i x, |iteratedDeriv i f x| ≤
      ((K : ℝ) * (i + 1 : ℝ)) ^ (K * (i + 1)))
    (hgderiv : ∀ i x, |iteratedDeriv i g x| ≤
      ((K : ℝ) * (i + 1 : ℝ)) ^ (K * (i + 1)))
    {r : ℝ} (hr : 0 < r) (hr1 : r ≤ 1) (m : ℕ)
    (word : Fin m → Fin (d + d)) (z : Fin (d + d) → ℝ) :
    ‖coordinateWordDerivative m
      (localizedQuadraticChart θ v ell C (fun x => f (x / r)) g
        (hf.comp (contDiff_id.div_const r)) hg (scaled_unit_cutoff_compact f hfs hr) hgc).amplitude
      word z‖ ≤
      (100 * (K + 1 : ℝ) * (d + 1 : ℝ) / r) ^ ((2 * K + 2) * (m + 1)) *
        (m + 1 : ℝ) ^ ((2 * K + 2) * (m + 1)) := by
  let A := localizedQuadraticChart θ v ell C (fun x => f (x / r)) g
    (hf.comp (contDiff_id.div_const r)) hg (scaled_unit_cutoff_compact f hfs hr) hgc
  have hs (x : ℝ) (hx : 1 ≤ |x|) : f (x / r) = 0 := by
    apply hfs
    rw [abs_div, abs_of_pos hr]
    exact (le_div_iff₀ hr).mpr (by linarith)
  have h := localizedQuadraticChart_amplitude_derivative_geometric θ v ell C
    (fun x => f (x / r)) g (hf.comp (contDiff_id.div_const r)) hg
    (scaled_unit_cutoff_compact f hfs hr) hgc hs hgs hC z m
    (R := (((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K)) / r)
    (T := ((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K))
    (by positivity) (by positivity)
    (fun i hi x => scaled_gevrey_derivative_geometric f hf K hK hfu hfderiv hr m i hi x)
    (fun i hi x => gevrey_derivative_geometric g K hK hgu hgderiv m i hi x)
  have hword : ‖coordinateWordDerivative m A.amplitude word z‖ ≤
      ‖iteratedFDeriv ℝ m A.amplitude z‖ := by
    simpa [coordinateWordDerivative, Pi.norm_single] using
      (iteratedFDeriv ℝ m A.amplitude z).le_opNorm (fun i => Pi.single (word i) 1)
  exact hword.trans (h.trans (local_chart_derivative_budget d K m hK hr hr1))

theorem gevrey_derivative_bound_mono (f : ℝ → ℝ) {K L : ℕ} (hK : 1 ≤ K) (hKL : K ≤ L)
    (h : ∀ i x, |iteratedDeriv i f x| ≤
      ((K : ℝ) * (i + 1 : ℝ)) ^ (K * (i + 1))) (i : ℕ) (x : ℝ) :
    |iteratedDeriv i f x| ≤ ((L : ℝ) * (i + 1 : ℝ)) ^ (L * (i + 1)) := by
  have hL : (1 : ℝ) ≤ L := by exact_mod_cast hK.trans hKL
  have hi : (1 : ℝ) ≤ i + 1 := by have := Nat.cast_nonneg (α := ℝ) i; linarith
  calc
    _ ≤ ((K : ℝ) * (i + 1 : ℝ)) ^ (K * (i + 1)) := h i x
    _ ≤ ((L : ℝ) * (i + 1 : ℝ)) ^ (K * (i + 1)) := by gcongr
    _ ≤ _ := pow_le_pow_right₀ (by nlinarith) (Nat.mul_le_mul_right _ hKL)

/-- Multiply a quadratic chart by a linear modulation of frequency `b`. -/
noncomputable def modulateQuadraticChart {d : ℕ} (A : QuadraticChartData d) (b : ℝ) :
    QuadraticChartData d := { A with linear := A.linear + b }

theorem modulateQuadraticChart_atom {d : ℕ} (A : QuadraticChartData d) (b y : ℝ) :
    quadraticChartAtom (modulateQuadraticChart A b) y =
      (Real.fourierChar (b * y) : ℂ) * quadraticChartAtom A y := by
  unfold quadraticChartAtom modulateQuadraticChart
  have he : A.quadratic * y ^ 2 + (A.linear + b) * y =
      b * y + (A.quadratic * y ^ 2 + A.linear * y) := by ring
  rw [he, AddChar.map_add_eq_mul, Circle.coe_mul]
  exact mul_assoc _ _ _

theorem modulateQuadraticChart_complexity {d c₀ : ℕ} {H : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A) (b : ℝ) :
    QuadraticChartComplexity c₀ H (modulateQuadraticChart A b) :=
  ⟨hA.lower, hA.dimension, hA.height, hA.support, hA.derivative⟩

theorem modulateQuadraticChart_bounded {d : ℕ} {A : QuadraticChartData d}
    (hA : IsBoundedQuadraticChart A) (b : ℝ) :
    IsBoundedQuadraticChart (modulateQuadraticChart A b) := by
  intro y
  rw [modulateQuadraticChart_atom, norm_mul, Circle.norm_coe, one_mul]
  exact hA y

theorem translated_chart_power_budget {P X : ℝ} (hP : 100000 ≤ P)
    (n : ℕ) (hnP : (n : ℝ) ≤ P) (hX0 : 0 ≤ X) (hX : X ≤ P ^ 22) :
    chartTranslationBudget (Real.exp ((n : ℝ) * X ^ n)) ≤
      Real.exp (P ^ (66 * n + 4)) := by
  have hP0 : 0 ≤ P := by linarith
  have hP1 : 1 ≤ P := by linarith
  have he : (n : ℝ) * X ^ n ≤ P ^ (22 * n + 1) := by
    calc
      _ ≤ P * (P ^ 22) ^ n :=
        mul_le_mul hnP (pow_le_pow_left₀ hX0 hX n) (pow_nonneg hX0 n) hP0
      _ = _ := by rw [← pow_mul, pow_succ]; ring
  have hp : 1 ≤ P ^ (22 * n + 1) := one_le_pow₀ hP1
  unfold chartTranslationBudget logarithmicSize
  rw [Real.log_exp]
  apply Real.exp_le_exp.mpr
  calc
    100 * (1 + (n : ℝ) * X ^ n) ^ 3 ≤ 100 * (2 * P ^ (22 * n + 1)) ^ 3 := by
      gcongr
      linarith
    _ = 800 * P ^ ((22 * n + 1) * 3) := by rw [mul_pow, ← pow_mul]; ring
    _ ≤ P * P ^ ((22 * n + 1) * 3) :=
      mul_le_mul_of_nonneg_right (by linarith) (by positivity)
    _ = P ^ (66 * n + 4) := by
      rw [← pow_succ']
      congr 1
      omega

theorem uniform_translated_chart_budget (n : ℕ) (R : ℝ)
    (hR : 100000 ≤ R) (hnR : (n : ℝ) ≤ R) :
    ∃ C : ℕ, 1 ≤ C ∧ ∀ B : ℝ, 1 ≤ B → ∀ X : ℝ, 0 ≤ X →
      X ≤ (R * B ^ 8) ^ 22 →
      chartTranslationBudget (Real.exp ((n : ℝ) * X ^ n)) ≤
        Real.exp ((C : ℝ) * B ^ C) ∧
      (R * B ^ 8) ^ 34 ≤ (C : ℝ) * B ^ C := by
  let N := max 34 (66 * n + 4)
  obtain ⟨c, hc⟩ := exists_nat_ge (R ^ N)
  let C := c + 8 * N + 1
  refine ⟨C, by dsimp [C]; omega, ?_⟩
  intro B hB X hX0 hX
  have hR0 : 0 ≤ R := by linarith
  have hRP : R ≤ R * B ^ 8 := by
    simpa only [mul_one] using mul_le_mul_of_nonneg_left (one_le_pow₀ hB (n := 8)) hR0
  have hP : 100000 ≤ R * B ^ 8 := hR.trans hRP
  have hP1 : 1 ≤ R * B ^ 8 := by linarith
  have hcC : (c : ℝ) ≤ C := by
    exact_mod_cast (show c ≤ C by dsimp [C]; omega)
  have hNC : 8 * N ≤ C := by dsimp [C]; omega
  have hcommon : (R * B ^ 8) ^ N ≤ (C : ℝ) * B ^ C := by
    rw [mul_pow, ← pow_mul]
    exact mul_le_mul (hc.trans hcC) (pow_le_pow_right₀ hB hNC)
      (by positivity) (by positivity)
  have h34 : (R * B ^ 8) ^ 34 ≤ (C : ℝ) * B ^ C :=
    (pow_le_pow_right₀ hP1 (le_max_left _ _)).trans hcommon
  refine ⟨?_, h34⟩
  apply (translated_chart_power_budget hP n (hnR.trans hRP) hX0 hX).trans
  apply Real.exp_le_exp.mpr
  exact (pow_le_pow_right₀ hP1 (le_max_right _ _)).trans hcommon


theorem cyclicBohrMeasure_mean_one {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (S : Finset (ZMod q)) (r : ℝ) (hβ : 0 < cyclicBohrMass b S r) :
    (𝔼 x, cyclicBohrMeasure b S r x) = 1 := by
  change (𝔼 x, cyclicBohrWeight b S r x / cyclicBohrMass b S r) = 1
  rw [← Finset.expect_div]
  exact div_self hβ.ne'

theorem cyclicBohrMeasure_nonneg {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hb : ∀ x, 0 ≤ b x) (S : Finset (ZMod q)) (r : ℝ)
    (hβ : 0 < cyclicBohrMass b S r) (x : ZMod q) : 0 ≤ cyclicBohrMeasure b S r x :=
  div_nonneg (cyclicBohrWeight_nonneg b hb S r x) hβ.le

end TrilinearHT.Auto


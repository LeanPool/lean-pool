/-! ### Local symmetry of graph frequencies -/

theorem graphBohrSet_mono {q : ℕ} [NeZero q] {S T : Finset (ZMod q)}
    (hST : S ⊆ T) {r ρ : ℝ} (hr : r ≤ ρ) : graphBohrSet T r ⊆ graphBohrSet S ρ := by
  intro x hx
  rw [mem_graphBohrSet] at hx ⊢
  exact fun s hs => (hx s (hST hs)).trans_le hr

theorem graphBohrSet_add {q : ℕ} [NeZero q] (S : Finset (ZMod q))
    {r ρ : ℝ} {x y : ZMod q} (hx : x ∈ graphBohrSet S r) (hy : y ∈ graphBohrSet S ρ) :
    x + y ∈ graphBohrSet S (r + ρ) := by
  rw [mem_graphBohrSet] at hx hy ⊢
  intro s hs
  rw [mul_add, map_add]
  exact (norm_add_le _ _).trans_lt (add_lt_add (hx s hs) (hy s hs))

theorem graphBohrSet_neg {q : ℕ} [NeZero q] (S : Finset (ZMod q))
    {r : ℝ} {x : ZMod q} (hx : x ∈ graphBohrSet S r) : -x ∈ graphBohrSet S r := by
  rw [mem_graphBohrSet] at hx ⊢
  simpa only [mul_neg, map_neg, norm_neg] using hx

theorem graphBohrSet_sub {q : ℕ} [NeZero q] (S : Finset (ZMod q))
    {r ρ : ℝ} {x y : ZMod q} (hx : x ∈ graphBohrSet S r) (hy : y ∈ graphBohrSet S ρ) :
    x - y ∈ graphBohrSet S (r + ρ) := by
  simpa only [sub_eq_add_neg] using graphBohrSet_add S hx (graphBohrSet_neg S hy)

/-- Primitive centered-coordinate weight for the independently stated local graph model. -/
noncomputable def graphBohrWeight {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (S : Finset (ZMod q)) (r : ℝ) (x : ZMod q) : ℝ :=
  ∏ s ∈ S, b ((AddCircle.equivIco (1 : ℝ) (-(1 / 2))
    (ZMod.toAddCircle (s * x)) : ℝ) / r)

/-- Uniform mass of the smoothed graph Bohr weight. -/
noncomputable def graphBohrMass {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (S : Finset (ZMod q)) (r : ℝ) : ℝ := 𝔼 x, graphBohrWeight b S r x

/-- Graph Bohr weight divided by its uniform mass. -/
noncomputable def graphBohrMeasure {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (S : Finset (ZMod q)) (r : ℝ) (x : ZMod q) : ℝ :=
  graphBohrWeight b S r x / graphBohrMass b S r

/-- Largest character distance among the frequencies in `S`. -/
noncomputable def graphBohrNorm {q : ℕ} [NeZero q] (S : Finset (ZMod q)) (x : ZMod q) : ℝ :=
  (S.sup (fun s => ‖ZMod.toAddCircle (s * x)‖₊) : ℝ≥0)

theorem graphBohrWeight_bounds {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hb : ∀ x, 0 ≤ b x) (hb1 : ∀ x, b x ≤ 1)
    (S : Finset (ZMod q)) (r : ℝ) (x : ZMod q) :
    0 ≤ graphBohrWeight b S r x ∧ graphBohrWeight b S r x ≤ 1 :=
  ⟨cyclicBohrWeight_nonneg b hb S r x, cyclicBohrWeight_le_one b hb hb1 S r x⟩

theorem graphBohrWeight_eq_zero_of_notMem {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hsupp : ∀ x, 1 ≤ |x| → b x = 0) (S : Finset (ZMod q))
    {r : ℝ} (hr : 0 < r) (x : ZMod q) (hx : x ∉ graphBohrSet S r) :
    graphBohrWeight b S r x = 0 := by
  apply cyclicBohrWeight_eq_zero_of_notMem b hsupp S hr x
  intro h
  exact hx ((mem_graphBohrSet S r x).mpr ((mem_cyclicBohrSet S r x).mp h))

theorem graphBohrMass_bounds {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hb : ∀ x, 0 ≤ b x) (hb1 : ∀ x, b x ≤ 1)
    (hbone : ∀ x, |x| ≤ 1 / 2 → b x = 1) (S : Finset (ZMod q))
    {r : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8) :
    (r / 6) ^ S.card ≤ graphBohrMass b S r ∧ graphBohrMass b S r ≤ 1 :=
  cyclicBohrMass_bounds b hb hb1 hbone S hr hrsmall

theorem graphBohrMeasure_mean_one {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (S : Finset (ZMod q)) (r : ℝ) (hβ : 0 < graphBohrMass b S r) :
    (𝔼 x, graphBohrMeasure b S r x) = 1 := cyclicBohrMeasure_mean_one b S r hβ

theorem graphBohrNorm_le_of_mem {q : ℕ} [NeZero q] (S : Finset (ZMod q))
    {r : ℝ} (hr : 0 ≤ r) {x : ZMod q} (hx : x ∈ graphBohrSet S r) :
    graphBohrNorm S x ≤ r := by
  change ((S.sup (fun s => ‖ZMod.toAddCircle (s * x)‖₊) : ℝ≥0) : ℝ) ≤ r
  change S.sup (fun s => ‖ZMod.toAddCircle (s * x)‖₊) ≤ (⟨r, hr⟩ : ℝ≥0)
  apply Finset.sup_le
  intro s hs
  exact_mod_cast ((mem_graphBohrSet S r x).mp hx s hs).le

theorem localSymmetryInnerRadius_bounds {C r ζ : ℝ} (hC : 0 ≤ C)
    (hr : 0 < r) (hζ : 0 < ζ) (d : ℕ) :
    0 < localSymmetryInnerRadius C d r ζ ∧
      localSymmetryInnerRadius C d r ζ ≤ r / 100 ∧
      2 * C * d * localSymmetryInnerRadius C d r ζ / r ≤ ζ ^ 2 / 2 := by
  have hmin : 0 < min (1 : ℝ) (ζ ^ 2) := lt_min zero_lt_one (sq_pos_of_pos hζ)
  have hden : 0 < 1000 * (C + 1) * ((d : ℝ) + 1) := by positivity
  have hd : (0 : ℝ) ≤ d := Nat.cast_nonneg d
  have hc : 1 ≤ (C + 1) * ((d : ℝ) + 1) := by nlinarith
  refine ⟨div_pos (mul_pos hr hmin) hden, ?_, ?_⟩
  · unfold localSymmetryInnerRadius
    apply (div_le_iff₀ hden).mpr
    have hm := min_le_left (1 : ℝ) (ζ ^ 2)
    nlinarith
  · unfold localSymmetryInnerRadius
    have he : 2 * C * d * (r * min 1 (ζ ^ 2) / (1000 * (C + 1) * (d + 1))) / r =
        (2 * C * d * min 1 (ζ ^ 2)) / (1000 * (C + 1) * (d + 1)) := by
      field_simp
    rw [he]
    apply (div_le_iff₀ hden).mpr
    have hm := min_le_right (1 : ℝ) (ζ ^ 2)
    have hmul := mul_le_mul_of_nonneg_left hm (by positivity : 0 ≤ 2 * C * (d : ℝ))
    nlinarith only [sq_nonneg ζ, mul_nonneg hC hd, hC, hm]

theorem graphBohrMass_pos {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hb : ∀ x, 0 ≤ b x) (hb1 : ∀ x, b x ≤ 1)
    (hbone : ∀ x, |x| ≤ 1 / 2 → b x = 1) (S : Finset (ZMod q))
    {r : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8) : 0 < graphBohrMass b S r :=
  cyclicBohrMass_pos b hb hb1 hbone S hr hrsmall

theorem graphBohrMeasure_nonneg {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hb : ∀ x, 0 ≤ b x) (S : Finset (ZMod q)) (r : ℝ)
    (hβ : 0 < graphBohrMass b S r) (x : ZMod q) : 0 ≤ graphBohrMeasure b S r x :=
  cyclicBohrMeasure_nonneg b hb S r hβ x

theorem graphBohrMeasure_eq_zero_of_notMem {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hsupp : ∀ x, 1 ≤ |x| → b x = 0) (S : Finset (ZMod q))
    {r : ℝ} (hr : 0 < r) (x : ZMod q) (hx : x ∉ graphBohrSet S r) :
    graphBohrMeasure b S r x = 0 := by
  rw [graphBohrMeasure, graphBohrWeight_eq_zero_of_notMem b hsupp S hr x hx, zero_div]

theorem localSymmetryInnerRadius_domain {C r ζ ρ : ℝ} (hC : 0 ≤ C)
    (hr : 0 < r) (hζ : 0 < ζ) (d : ℕ) (hrρ : r ≤ ρ / 100) :
    r + 2 * localSymmetryInnerRadius C d r ζ < ρ ∧
      8 * localSymmetryInnerRadius C d r ζ < ρ ∧
      3 * localSymmetryInnerRadius C d r ζ < r := by
  have h := (localSymmetryInnerRadius_bounds hC hr hζ d).2.1
  constructor
  · linarith only [hr, hrρ, h]
  · constructor <;> linarith

/-- Averaging all translates of a normalized weight preserves uniform averages. -/
theorem finite_weighted_shift_average {G : Type*} [Fintype G] [AddCommGroup G]
    (μ : G → ℝ) (hμ : (𝔼 u, μ u) = 1) (F : G → ℂ) :
    (𝔼 y, 𝔼 u, (μ u : ℂ) * F (y + u)) = 𝔼 x, F x := by
  have hshift (u : G) : (𝔼 y, F (y + u)) = 𝔼 x, F x :=
    Fintype.expect_equiv (Equiv.addRight u) _ _ (fun _ => rfl)
  rw [Finset.expect_comm]
  simp only [← Finset.mul_expect, hshift, ← Finset.expect_mul,
    ← finite_expect_ofReal, hμ, Complex.ofReal_one, one_mul]

/-- Some weighted translate retains the magnitude of a two-variable uniform correlation. -/
theorem finite_weighted_translation_localization {G : Type*} [Fintype G] [AddCommGroup G]
    (μ : G → ℝ) (hμ : (𝔼 u, μ u) = 1) (F : G → G → ℂ) {ζ : ℝ}
    (hζ : ζ ≤ ‖𝔼 h, 𝔼 x, F h x‖) :
    ∃ y : G, ζ ≤ ‖𝔼 h, 𝔼 u, (μ u : ℂ) * F h (y + u)‖ := by
  have havg : (𝔼 y, 𝔼 h, 𝔼 u, (μ u : ℂ) * F h (y + u)) = 𝔼 h, 𝔼 x, F h x := by
    rw [Finset.expect_comm]
    apply Finset.expect_congr rfl
    intro h _
    exact finite_weighted_shift_average μ hμ (F h)
  have h : ζ ≤ 𝔼 y, ‖𝔼 h, 𝔼 u, (μ u : ℂ) * F h (y + u)‖ := by
    apply hζ.trans
    rw [← havg]
    exact RCLike.norm_expect_le (K := ℂ)
  obtain ⟨y, _, hy⟩ := Finset.exists_le_of_le_expect Finset.univ_nonempty h
  exact ⟨y, hy⟩

/-- Initial correlation in the local-symmetry argument. -/
noncomputable def graphLocalCorrelation {q : ℕ} [NeZero q]
    (w : ZMod q → ℝ) (M : ZMod q → ZMod q) (a b c : ZMod q → ℂ) : ℂ :=
  𝔼 h, 𝔼 x, (w h : ℂ) * c h *
    (a (x + h) * b x * ZMod.stdAddChar (-(2 * M h * x)))

/-- Correlation after localizing the spatial variable by a normalized weight. -/
noncomputable def graphLocalizedCorrelation {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (M : ZMod q → ZMod q) (a b c : ZMod q → ℂ) : ℂ :=
  𝔼 h, (w h : ℂ) * c h *
    (𝔼 u, (μ u : ℂ) * a (u + h) * b u * ZMod.stdAddChar (-(2 * M h * u)))

/-- The selected translate is absorbed into bounded functions
without changing the graph frequency. -/
theorem graph_correlation_localization {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (hμ : (𝔼 u, μ u) = 1) (M : ZMod q → ZMod q)
    (a b c : ZMod q → ℂ) (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1)
    (hc : ∀ x, ‖c x‖ ≤ 1) {ζ : ℝ} (hζ : ζ ≤ ‖graphLocalCorrelation w M a b c‖) :
    ∃ a' b' c' : ZMod q → ℂ, (∀ x, ‖a' x‖ ≤ 1) ∧ (∀ x, ‖b' x‖ ≤ 1) ∧
      (∀ x, ‖c' x‖ ≤ 1) ∧ ζ ≤ ‖graphLocalizedCorrelation w μ M a' b' c'‖ := by
  let F : ZMod q → ZMod q → ℂ := fun h x => (w h : ℂ) * c h *
    (a (x + h) * b x * ZMod.stdAddChar (-(2 * M h * x)))
  obtain ⟨y, hy⟩ := finite_weighted_translation_localization μ hμ F hζ
  let a' : ZMod q → ℂ := fun x => a (x + y)
  let b' : ZMod q → ℂ := fun x => b (x + y)
  let c' : ZMod q → ℂ := fun h => c h * ZMod.stdAddChar (-(2 * M h * y))
  have he : graphLocalizedCorrelation w μ M a' b' c' =
      𝔼 h, 𝔼 u, (μ u : ℂ) * F h (y + u) := by
    unfold graphLocalizedCorrelation
    apply Finset.expect_congr rfl
    intro h _
    rw [Finset.mul_expect]
    apply Finset.expect_congr rfl
    intro u _
    dsimp [a', b', c', F]
    have hchar : ZMod.stdAddChar (-(2 * M h * (y + u))) =
        ZMod.stdAddChar (-(2 * M h * y)) * ZMod.stdAddChar (-(2 * M h * u)) := by
      rw [show -(2 * M h * (y + u)) = -(2 * M h * y) + -(2 * M h * u) by ring,
        AddChar.map_add_eq_mul]
    rw [hchar]
    simp only [add_left_comm, add_comm]
    ring
  refine ⟨a', b', c', (fun x => ha (x + y)), (fun x => hb (x + y)), ?_, ?_⟩
  · intro h
    simpa only [c', norm_mul, ZMod.stdAddChar_apply, Circle.norm_coe, mul_one] using hc h
  · rwa [he]

/-- Weighted Cauchy-Schwarz for a nonnegative weight of uniform mass at most one. -/
theorem finite_weighted_complex_cauchy_schwarz {I : Type*} [Fintype I]
    (w : I → ℝ) (hw : ∀ i, 0 ≤ w i) (hmass : (𝔼 i, w i) ≤ 1)
    (c F : I → ℂ) (hc : ∀ i, ‖c i‖ ≤ 1) :
    ‖𝔼 i, (w i : ℂ) * c i * F i‖ ^ 2 ≤ 𝔼 i, w i * ‖F i‖ ^ 2 := by
  have hnorm : ‖𝔼 i, (w i : ℂ) * c i * F i‖ ≤ 𝔼 i, w i * ‖F i‖ := by
    apply (RCLike.norm_expect_le (K := ℂ)).trans
    apply Finset.expect_le_expect
    intro i _
    rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_of_nonneg (hw i)]
    have h := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left (hc i) (hw i)) (norm_nonneg (F i))
    simpa only [mul_one] using h
  have hcs := Finset.expect_mul_sq_le_sq_mul_sq (Finset.univ : Finset I)
    (fun i => Real.sqrt (w i)) (fun i => Real.sqrt (w i) * ‖F i‖)
  have h1 (i : I) : Real.sqrt (w i) * (Real.sqrt (w i) * ‖F i‖) = w i * ‖F i‖ := by
    rw [← mul_assoc, ← pow_two, Real.sq_sqrt (hw i)]
  have h2 (i : I) : Real.sqrt (w i) ^ 2 = w i := Real.sq_sqrt (hw i)
  have h3 (i : I) : (Real.sqrt (w i) * ‖F i‖) ^ 2 = w i * ‖F i‖ ^ 2 := by
    rw [mul_pow, h2]
  simp only [h1, h2, h3] at hcs
  have hnonneg : 0 ≤ 𝔼 i, w i * ‖F i‖ ^ 2 :=
    Finset.expect_nonneg (fun i _ => mul_nonneg (hw i) (sq_nonneg _))
  calc
    _ ≤ (𝔼 i, w i * ‖F i‖) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hnorm 2
    _ ≤ (𝔼 i, w i) * (𝔼 i, w i * ‖F i‖ ^ 2) := hcs
    _ ≤ 1 * (𝔼 i, w i * ‖F i‖ ^ 2) := mul_le_mul_of_nonneg_right hmass hnonneg
    _ = _ := one_mul _

/-- The real nonnegative square left by the first local-symmetry Cauchy-Schwarz step. -/
noncomputable def graphLocalizedSquare {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (M : ZMod q → ZMod q) (a b : ZMod q → ℂ) : ℝ :=
  𝔼 h, w h * ‖𝔼 u, (μ u : ℂ) * a (u + h) * b u *
    ZMod.stdAddChar (-(2 * M h * u))‖ ^ 2

theorem graphLocalizedSquare_nonneg {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (hw : ∀ h, 0 ≤ w h) (M : ZMod q → ZMod q)
    (a b : ZMod q → ℂ) : 0 ≤ graphLocalizedSquare w μ M a b :=
  Finset.expect_nonneg (fun h _ => mul_nonneg (hw h) (sq_nonneg _))

/-- The first weighted Cauchy-Schwarz inequality in the source local-symmetry proof. -/
theorem graph_localized_cauchy_schwarz {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (hw : ∀ h, 0 ≤ w h) (hmass : (𝔼 h, w h) ≤ 1)
    (M : ZMod q → ZMod q) (a b c : ZMod q → ℂ) (hc : ∀ h, ‖c h‖ ≤ 1)
    {ζ : ℝ} (hζ : 0 ≤ ζ) (hcorr : ζ ≤ ‖graphLocalizedCorrelation w μ M a b c‖) :
    ζ ^ 2 ≤ graphLocalizedSquare w μ M a b := by
  have h := finite_weighted_complex_cauchy_schwarz w hw hmass c
    (fun h => 𝔼 u, (μ u : ℂ) * a (u + h) * b u * ZMod.stdAddChar (-(2 * M h * u))) hc
  exact (pow_le_pow_left₀ hζ hcorr 2).trans h

/-- Exact complex expansion of the first square, with the differenced frequency phase. -/
theorem graphLocalizedSquare_expansion {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (M : ZMod q → ZMod q) (a b : ZMod q → ℂ) :
    (graphLocalizedSquare w μ M a b : ℂ) =
      𝔼 h, 𝔼 u, 𝔼 v, (w h * μ u * μ v : ℂ) * b u * conj (b v) *
        a (u + h) * conj (a (v + h)) * ZMod.stdAddChar (-(2 * M h * (u - v))) := by
  unfold graphLocalizedSquare
  rw [finite_expect_ofReal]
  apply Finset.expect_congr rfl
  intro h _
  rw [Complex.ofReal_mul, finite_expect_norm_sq_eq, Finset.mul_expect]
  apply Finset.expect_congr rfl
  intro u _
  rw [Finset.mul_expect]
  apply Finset.expect_congr rfl
  intro v _
  simp only [map_mul, Complex.conj_ofReal]
  have hchar : ZMod.stdAddChar (-(2 * M h * u)) *
      conj (ZMod.stdAddChar (-(2 * M h * v))) =
      ZMod.stdAddChar (-(2 * M h * (u - v))) := by
    rw [graph_stdChar_conj, ← AddChar.map_add_eq_mul]
    congr 1
    ring
  rw [← hchar]
  ring

/-- The alternating graph-frequency expression, before applying the circle embedding. -/
def graphAlternating {q : ℕ} (M : ZMod q → ZMod q) (u v : ZMod q) : ZMod q :=
  M u * v - M v * u

/-- Circle-valued alternating phase associated with the local frequency map. -/
noncomputable def graphAlternatingPhase {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (u v : ZMod q) : UnitAddCircle :=
  ZMod.toAddCircle (graphAlternating M u v)

/-- Local additivity suffices to reconstruct the outer frequency after the three-term shift. -/
theorem graph_local_additive_three {q : ℕ} [NeZero q] (S : Finset (ZMod q))
    (M : ZMod q → ZMod q) {r s ρ : ℝ} (hr : 0 ≤ r) (hs : 0 ≤ s) (hρ : r + 2 * s ≤ ρ)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    {h u v : ZMod q} (hh : h ∈ graphBohrSet S r)
    (hu : u ∈ graphBohrSet S s) (hv : v ∈ graphBohrSet S s) :
    M h = M (h + (u + v)) - M u - M v := by
  have hhρ := graphBohrSet_mono (S := S) (Finset.Subset.refl S) (by linarith : r ≤ ρ) hh
  have huρ := graphBohrSet_mono (S := S) (Finset.Subset.refl S) (by linarith : s ≤ ρ) hu
  have hvρ := graphBohrSet_mono (S := S) (Finset.Subset.refl S) (by linarith : s ≤ ρ) hv
  have huv : u + v ∈ graphBohrSet S (s + s) := graphBohrSet_add S hu hv
  have huvρ := graphBohrSet_mono (S := S) (Finset.Subset.refl S)
    (by linarith : s + s ≤ ρ) huv
  have hz : h + (u + v) ∈ graphBohrSet S (r + (s + s)) := graphBohrSet_add S hh huv
  have hzρ := graphBohrSet_mono (S := S) (Finset.Subset.refl S)
    (by linarith : r + (s + s) ≤ ρ) hz
  rw [hadd h hhρ (u + v) huvρ hzρ, hadd u huρ v hvρ huvρ]
  abel

/-- The bounded amplitude obtained after writing `z=h+u+v`. -/
noncomputable def graphLocalAmplitude {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (a b : ZMod q → ℂ) (z u : ZMod q) : ℂ :=
  b u * conj (a (z - u)) * ZMod.stdAddChar (2 * M u * u - 2 * M z * u)

/-- Exact algebraic alternating-phase identity on the locally additive domain. -/
theorem graph_local_phase_identity {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (a b : ZMod q → ℂ) (h u v : ZMod q)
    (hM : M h = M (h + (u + v)) - M u - M v) :
    b u * conj (b v) * a (u + h) * conj (a (v + h)) *
        ZMod.stdAddChar (-(2 * M h * (u - v))) =
      graphLocalAmplitude M a b (h + (u + v)) u *
        conj (graphLocalAmplitude M a b (h + (u + v)) v) *
          ZMod.stdAddChar (-(2 * graphAlternating M u v)) := by
  have hchar : ZMod.stdAddChar (2 * M u * u - 2 * M (h + (u + v)) * u) *
      conj (ZMod.stdAddChar (2 * M v * v - 2 * M (h + (u + v)) * v)) *
      ZMod.stdAddChar (-(2 * graphAlternating M u v)) =
      ZMod.stdAddChar (-(2 * M h * (u - v))) := by
    rw [graph_stdChar_conj, ← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul]
    congr 1
    rw [hM]
    unfold graphAlternating
    ring
  rw [← hchar]
  unfold graphLocalAmplitude
  simp only [map_mul, Complex.conj_conj]
  have huarg : h + (u + v) - u = v + h := by abel
  have hvarg : h + (u + v) - v = u + h := by abel
  rw [huarg, hvarg]
  ring

/-- The reindexed weighted alternating-phase average in the source symmetry argument. -/
noncomputable def graphSymmetryExpression {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (M : ZMod q → ZMod q) (a b : ZMod q → ℂ) : ℂ :=
  𝔼 z, 𝔼 u, 𝔼 v, (μ u : ℂ) * (μ v : ℂ) * (w (z - u - v) : ℂ) *
    graphLocalAmplitude M a b z u * conj (graphLocalAmplitude M a b z v) *
      ZMod.stdAddChar (-(2 * graphAlternating M u v))

/-- Reindexing is valid because every nonzero weighted term lies inside the additive domain. -/
theorem graphLocalizedSquare_symmetry_change {q : ℕ} [NeZero q]
    (S : Finset (ZMod q)) (w μ : ZMod q → ℝ) (M : ZMod q → ZMod q)
    (a b : ZMod q → ℂ) {r s ρ : ℝ} (hr : 0 ≤ r) (hs : 0 ≤ s) (hρ : r + 2 * s ≤ ρ)
    (hw : ∀ h, w h ≠ 0 → h ∈ graphBohrSet S r)
    (hμ : ∀ u, μ u ≠ 0 → u ∈ graphBohrSet S s)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y) :
    (graphLocalizedSquare w μ M a b : ℂ) = graphSymmetryExpression w μ M a b := by
  rw [graphLocalizedSquare_expansion, finite_expect_reverse_three]
  unfold graphSymmetryExpression
  rw [finite_expect_reverse_three (fun z u v =>
    (μ u : ℂ) * (μ v : ℂ) * (w (z - u - v) : ℂ) * graphLocalAmplitude M a b z u *
      conj (graphLocalAmplitude M a b z v) * ZMod.stdAddChar (-(2 * graphAlternating M u v)))]
  apply Finset.expect_congr rfl
  intro v _
  apply Finset.expect_congr rfl
  intro u _
  apply Fintype.expect_equiv (Equiv.addRight (u + v))
  intro h
  change (w h * μ u * μ v : ℂ) * b u * conj (b v) * a (u + h) *
      conj (a (v + h)) * ZMod.stdAddChar (-(2 * M h * (u - v))) =
    (μ u : ℂ) * (μ v : ℂ) * (w (h + (u + v) - u - v) : ℂ) *
      graphLocalAmplitude M a b (h + (u + v)) u *
      conj (graphLocalAmplitude M a b (h + (u + v)) v) *
        ZMod.stdAddChar (-(2 * graphAlternating M u v))
  rw [show h + (u + v) - u - v = h by abel]
  by_cases hu : μ u = 0
  · simp [hu]
  by_cases hv : μ v = 0
  · simp [hv]
  by_cases hh : w h = 0
  · simp [hh]
  have hM := graph_local_additive_three S M hr hs hρ hadd (hw h hh) (hμ u hu) (hμ v hv)
  have hp := graph_local_phase_identity M a b h u v hM
  linear_combination (w h * μ u * μ v : ℂ) * hp

theorem graphLocalAmplitude_norm_le {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (a b : ZMod q → ℂ)
    (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1) (z u : ZMod q) :
    ‖graphLocalAmplitude M a b z u‖ ≤ 1 := by
  rw [graphLocalAmplitude, norm_mul, norm_mul, Complex.norm_conj,
    ZMod.stdAddChar_apply, Circle.norm_coe, mul_one]
  exact (mul_le_mul (hb u) (ha (z - u)) (norm_nonneg _) zero_le_one).trans_eq (one_mul 1)

/-- The unit-bounded kernel of the alternating-phase correlation. -/
noncomputable def graphSymmetryKernel {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (a b : ZMod q → ℂ) (z u v : ZMod q) : ℂ :=
  graphLocalAmplitude M a b z u * conj (graphLocalAmplitude M a b z v) *
    ZMod.stdAddChar (-(2 * graphAlternating M u v))

theorem graphSymmetryKernel_norm_le {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (a b : ZMod q → ℂ)
    (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1) (z u v : ZMod q) :
    ‖graphSymmetryKernel M a b z u v‖ ≤ 1 := by
  rw [graphSymmetryKernel, norm_mul, norm_mul, Complex.norm_conj,
    ZMod.stdAddChar_apply, Circle.norm_coe, mul_one]
  exact (mul_le_mul (graphLocalAmplitude_norm_le M a b ha hb z u)
    (graphLocalAmplitude_norm_le M a b ha hb z v) (norm_nonneg _) zero_le_one).trans_eq (one_mul 1)

/-- A two-variable normalized weighted average obeys a bound valid on the weight's support. -/
theorem finite_weighted_pair_norm_le {I : Type*} [Fintype I]
    (μ : I → ℝ) (hμ : ∀ i, 0 ≤ μ i) (hmass : (𝔼 i, μ i) = 1)
    (F : I → I → ℂ) {A : ℝ}
    (hF : ∀ u v, μ u ≠ 0 → μ v ≠ 0 → ‖F u v‖ ≤ A) :
    ‖𝔼 u, 𝔼 v, (μ u : ℂ) * (μ v : ℂ) * F u v‖ ≤ A := by
  have hp (u v : I) : ‖(μ u : ℂ) * (μ v : ℂ) * F u v‖ ≤ μ u * μ v * A := by
    by_cases hu : μ u = 0
    · simp [hu]
    by_cases hv : μ v = 0
    · simp [hv]
    rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_real,
      Real.norm_of_nonneg (hμ u), Real.norm_of_nonneg (hμ v)]
    exact mul_le_mul_of_nonneg_left (hF u v hu hv) (mul_nonneg (hμ u) (hμ v))
  calc
    _ ≤ 𝔼 u, ‖𝔼 v, (μ u : ℂ) * (μ v : ℂ) * F u v‖ := RCLike.norm_expect_le (K := ℂ)
    _ ≤ 𝔼 u, 𝔼 v, μ u * μ v * A := by
      apply Finset.expect_le_expect
      intro u _
      exact (RCLike.norm_expect_le (K := ℂ)).trans
        (Finset.expect_le_expect (fun v _ => hp u v))
    _ = A := by
      simp only [mul_assoc, ← Finset.mul_expect, ← Finset.expect_mul, hmass, one_mul]

/-- A positive weighted correlation is witnessed at a point carrying nonzero weight. -/
theorem finite_weighted_correlation_select {I : Type*} [Fintype I]
    (w : I → ℝ) (hw : ∀ i, 0 ≤ w i) (hmass : (𝔼 i, w i) ≤ 1)
    (F : I → ℂ) {η : ℝ} (hη : 0 < η) (hcorr : η ≤ ‖𝔼 i, (w i : ℂ) * F i‖) :
    ∃ i, w i ≠ 0 ∧ η ≤ ‖F i‖ := by
  classical
  let T := Finset.univ.filter (fun i => w i ≠ 0)
  have hT : T.Nonempty := by
    by_contra hn
    have he : T = ∅ := Finset.not_nonempty_iff_eq_empty.mp hn
    have hz (i : I) : w i = 0 := by
      by_contra hi
      have hm : i ∈ T := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩
      rw [he] at hm
      exact Finset.notMem_empty i hm
    have hzero : (𝔼 i, (w i : ℂ) * F i) = 0 := by simp [hz]
    rw [hzero, norm_zero] at hcorr
    linarith
  obtain ⟨i, hi, hmax⟩ := Finset.exists_max_image T (fun i => ‖F i‖) hT
  refine ⟨i, (Finset.mem_filter.mp hi).2, hcorr.trans ?_⟩
  calc
    _ ≤ 𝔼 j, w j * ‖F j‖ := by
      apply (RCLike.norm_expect_le (K := ℂ)).trans_eq
      apply Finset.expect_congr rfl
      intro j _
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (hw j)]
    _ ≤ 𝔼 j, w j * ‖F i‖ := by
      apply Finset.expect_le_expect
      intro j _
      by_cases hj : w j = 0
      · simp [hj]
      · exact mul_le_mul_of_nonneg_left
          (hmax j (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj⟩)) (hw j)
    _ = (𝔼 j, w j) * ‖F i‖ := (Finset.expect_mul _ _ _).symm
    _ ≤ 1 * ‖F i‖ := mul_le_mul_of_nonneg_right hmass (norm_nonneg _)
    _ = _ := one_mul _

/-- Pairwise shifts of inner Bohr points incur the source weight-replacement error. -/
theorem graphBohrWeight_pair_translation {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    {L : ℝ≥0} (hLip : LipschitzWith L b) (hb : ∀ x, 0 ≤ b x) (hb1 : ∀ x, b x ≤ 1)
    (hsupp : ∀ x, 1 ≤ |x| → b x = 0) (S : Finset (ZMod q))
    {r s : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8) (hs : 0 ≤ s)
    (z u v : ZMod q) (hu : u ∈ graphBohrSet S s) (hv : v ∈ graphBohrSet S s) :
    |graphBohrWeight b S r (z - u - v) - graphBohrWeight b S r z| ≤
      2 * max (L : ℝ) 1 * S.card * s / r := by
  have hn := graphBohrNorm_le_of_mem S (add_nonneg hs hs) (graphBohrSet_add S hu hv)
  have h := cyclicBohrWeight_translation b hLip hb hb1 hsupp S hr hrsmall (z - u - v) (u + v)
  change |graphBohrWeight b S r ((z - u - v) + (u + v)) - graphBohrWeight b S r (z - u - v)| ≤
    max (L : ℝ) 1 * S.card * graphBohrNorm S (u + v) / r at h
  rw [show (z - u - v) + (u + v) = z by abel, abs_sub_comm] at h
  apply h.trans
  calc
    _ ≤ max (L : ℝ) 1 * S.card * (s + s) / r := by
      apply div_le_div_of_nonneg_right _ hr.le
      exact mul_le_mul_of_nonneg_left hn (by positivity)
    _ = _ := by ring

/-- The inner alternating-phase correlation at a fixed outer parameter. -/
noncomputable def graphSymmetryFixedCorrelation {q : ℕ} [NeZero q]
    (μ : ZMod q → ℝ) (M : ZMod q → ZMod q) (a b : ZMod q → ℂ) (z : ZMod q) : ℂ :=
  𝔼 u, 𝔼 v, (μ u : ℂ) * (μ v : ℂ) * graphSymmetryKernel M a b z u v

/-- Outer-weighted average of the fixed-shift graph-symmetry correlation. -/
noncomputable def graphSymmetryWeightedCorrelation {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (M : ZMod q → ZMod q) (a b : ZMod q → ℂ) : ℂ :=
  𝔼 z, (w z : ℂ) * graphSymmetryFixedCorrelation μ M a b z

/-- Replacing the shifted outer weight costs at most its uniform variation on the inner support. -/
theorem graph_symmetry_weight_error {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (hμ : ∀ u, 0 ≤ μ u) (hμmass : (𝔼 u, μ u) = 1)
    (M : ZMod q → ZMod q) (a b : ZMod q → ℂ)
    (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1) {ε : ℝ}
    (htrans : ∀ z u v, μ u ≠ 0 → μ v ≠ 0 → |w (z - u - v) - w z| ≤ ε) :
    ‖graphSymmetryExpression w μ M a b - graphSymmetryWeightedCorrelation w μ M a b‖ ≤ ε := by
  let F : ZMod q → ZMod q → ZMod q → ℂ := fun z u v =>
    ((w (z - u - v) - w z : ℝ) : ℂ) * graphSymmetryKernel M a b z u v
  have he : graphSymmetryExpression w μ M a b - graphSymmetryWeightedCorrelation w μ M a b =
      𝔼 z, 𝔼 u, 𝔼 v, (μ u : ℂ) * (μ v : ℂ) * F z u v := by
    unfold graphSymmetryExpression graphSymmetryWeightedCorrelation graphSymmetryFixedCorrelation
    simp only [Finset.mul_expect, ← Finset.expect_sub_distrib]
    apply Finset.expect_congr rfl
    intro z _
    apply Finset.expect_congr rfl
    intro u _
    apply Finset.expect_congr rfl
    intro v _
    dsimp [F, graphSymmetryKernel]
    push_cast
    ring
  rw [he]
  apply (RCLike.norm_expect_le (K := ℂ)).trans
  apply Finset.expect_le Finset.univ_nonempty
  intro z _
  apply finite_weighted_pair_norm_le μ hμ hμmass (F z)
  intro u v hu hv
  dsimp [F]
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
  have h := mul_le_mul_of_nonneg_left (graphSymmetryKernel_norm_le M a b ha hb z u v)
    (abs_nonneg (w (z - u - v) - w z))
  have hle : |w (z - u - v) - w z| * ‖graphSymmetryKernel M a b z u v‖ ≤
      |w (z - u - v) - w z| := by simpa only [mul_one] using h
  exact hle.trans (htrans z u v hu hv)

/-- The weight replacement leaves a large fixed-parameter correlation on the outer support. -/
theorem graph_symmetry_weight_replacement_select {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (hw : ∀ z, 0 ≤ w z) (hwmass : (𝔼 z, w z) ≤ 1)
    (hμ : ∀ u, 0 ≤ μ u) (hμmass : (𝔼 u, μ u) = 1)
    (M : ZMod q → ZMod q) (a b : ZMod q → ℂ)
    (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1) {ζ ε : ℝ}
    (hζ : 0 < ζ) (hε : ε ≤ ζ ^ 2 / 2)
    (hsq : ζ ^ 2 ≤ graphLocalizedSquare w μ M a b)
    (hchange : (graphLocalizedSquare w μ M a b : ℂ) = graphSymmetryExpression w μ M a b)
    (htrans : ∀ z u v, μ u ≠ 0 → μ v ≠ 0 → |w (z - u - v) - w z| ≤ ε) :
    ∃ z, w z ≠ 0 ∧ ζ ^ 2 / 2 ≤ ‖graphSymmetryFixedCorrelation μ M a b z‖ := by
  have herror := graph_symmetry_weight_error w μ hμ hμmass M a b ha hb htrans
  have horiginal : ζ ^ 2 ≤ ‖graphSymmetryExpression w μ M a b‖ := by
    rw [← hchange, Complex.norm_real,
      Real.norm_of_nonneg (graphLocalizedSquare_nonneg w μ hw M a b)]
    exact hsq
  have hcorr : ζ ^ 2 / 2 ≤ ‖graphSymmetryWeightedCorrelation w μ M a b‖ := by
    have h := norm_sub_norm_le (graphSymmetryExpression w μ M a b)
      (graphSymmetryWeightedCorrelation w μ M a b)
    linarith only [hε, herror, horiginal, h]
  exact finite_weighted_correlation_select w hw hwmass
    (graphSymmetryFixedCorrelation μ M a b) (by positivity) hcorr

/-- Source weight replacement and supported selection,
specialized to the actual smooth Bohr weights. -/
theorem graph_bohr_symmetry_select {q : ℕ} [NeZero q] (cutoff : ℝ → ℝ)
    {L : ℝ≥0} (hLip : LipschitzWith L cutoff)
    (hb0 : ∀ x, 0 ≤ cutoff x) (hb1 : ∀ x, cutoff x ≤ 1)
    (hbone : ∀ x, |x| ≤ 1 / 2 → cutoff x = 1)
    (hsupp : ∀ x, 1 ≤ |x| → cutoff x = 0) (S : Finset (ZMod q))
    {r s ρ ζ : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8) (hs : 0 < s) (hssmall : s < 1 / 8)
    (hρ : r + 2 * s ≤ ρ) (hζ : 0 < ζ)
    (htol : 2 * max (L : ℝ) 1 * S.card * s / r ≤ ζ ^ 2 / 2)
    (M : ZMod q → ZMod q) (a b : ZMod q → ℂ)
    (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    (hsq : ζ ^ 2 ≤ graphLocalizedSquare (graphBohrWeight cutoff S r)
      (graphBohrMeasure cutoff S s) M a b) :
    ∃ z, graphBohrWeight cutoff S r z ≠ 0 ∧ z ∈ graphBohrSet S r ∧
      ζ ^ 2 / 2 ≤ ‖graphSymmetryFixedCorrelation (graphBohrMeasure cutoff S s) M a b z‖ := by
  let w := graphBohrWeight cutoff S r
  let μ := graphBohrMeasure cutoff S s
  have hw : ∀ x, 0 ≤ w x := fun x => (graphBohrWeight_bounds cutoff hb0 hb1 S r x).1
  have hwmass : (𝔼 x, w x) ≤ 1 := (graphBohrMass_bounds cutoff hb0 hb1 hbone S hr hrsmall).2
  have hβ := graphBohrMass_pos cutoff hb0 hb1 hbone S hs hssmall
  have hμ : ∀ x, 0 ≤ μ x := graphBohrMeasure_nonneg cutoff hb0 S s hβ
  have hμmass : (𝔼 x, μ x) = 1 := graphBohrMeasure_mean_one cutoff S s hβ
  have hwsupp (x : ZMod q) (hx : w x ≠ 0) : x ∈ graphBohrSet S r := by
    by_contra hn
    exact hx (graphBohrWeight_eq_zero_of_notMem cutoff hsupp S hr x hn)
  have hμsupp (x : ZMod q) (hx : μ x ≠ 0) : x ∈ graphBohrSet S s := by
    by_contra hn
    exact hx (graphBohrMeasure_eq_zero_of_notMem cutoff hsupp S hs x hn)
  have hchange := graphLocalizedSquare_symmetry_change S w μ M a b hr.le hs.le hρ
    hwsupp hμsupp hadd
  have htrans (z u v : ZMod q) (hu : μ u ≠ 0) (hv : μ v ≠ 0) :
      |w (z - u - v) - w z| ≤ 2 * max (L : ℝ) 1 * S.card * s / r :=
    graphBohrWeight_pair_translation cutoff hLip hb0 hb1 hsupp S hr hrsmall hs.le
      z u v (hμsupp u hu) (hμsupp v hv)
  obtain ⟨z, hz, hcorr⟩ := graph_symmetry_weight_replacement_select w μ hw hwmass hμ hμmass
    M a b ha hb hζ htol hsq hchange htrans
  exact ⟨z, hz, hwsupp z hz, hcorr⟩

theorem finite_expect_cycle_three {I J K : Type*} [Fintype I] [Fintype J] [Fintype K]
    (f : I → J → K → ℂ) :
    (𝔼 i, 𝔼 j, 𝔼 k, f i j k) = 𝔼 j, 𝔼 k, 𝔼 i, f i j k := by
  rw [Finset.expect_comm]
  apply Finset.expect_congr rfl
  intro j _
  exact Finset.expect_comm _ _ _

/-- Exact weighted kernel square identity after the second Cauchy-Schwarz step. -/
theorem finite_weighted_kernel_square {I : Type*} [Fintype I]
    (μ : I → ℝ) (A : I → ℂ) (K : I → I → ℂ) :
    ((𝔼 u, μ u * ‖𝔼 v, (μ v : ℂ) * conj (A v) * K u v‖ ^ 2 : ℝ) : ℂ) =
      𝔼 v, 𝔼 v', (μ v : ℂ) * (μ v' : ℂ) * conj (A v) * A v' *
        (𝔼 u, (μ u : ℂ) * K u v * conj (K u v')) := by
  calc
    _ = 𝔼 u, 𝔼 v, 𝔼 v', (μ u : ℂ) * (μ v : ℂ) * (μ v' : ℂ) *
        conj (A v) * A v' * K u v * conj (K u v') := by
      rw [finite_expect_ofReal]
      apply Finset.expect_congr rfl
      intro u _
      rw [Complex.ofReal_mul, finite_expect_norm_sq_eq, Finset.mul_expect]
      apply Finset.expect_congr rfl
      intro v _
      rw [Finset.mul_expect]
      apply Finset.expect_congr rfl
      intro v' _
      simp only [map_mul, Complex.conj_ofReal, Complex.conj_conj]
      ring
    _ = 𝔼 v, 𝔼 v', 𝔼 u, (μ u : ℂ) * (μ v : ℂ) * (μ v' : ℂ) *
        conj (A v) * A v' * K u v * conj (K u v') := finite_expect_cycle_three _
    _ = _ := by
      apply Finset.expect_congr rfl
      intro v _
      apply Finset.expect_congr rfl
      intro v' _
      rw [Finset.mul_expect]
      apply Finset.expect_congr rfl
      intro u _
      ring

/-- A second weighted Cauchy-Schwarz removes both bounded amplitudes from a kernel correlation. -/
theorem finite_weighted_kernel_cauchy_schwarz {I : Type*} [Fintype I]
    (μ : I → ℝ) (hμ : ∀ i, 0 ≤ μ i) (hmass : (𝔼 i, μ i) = 1)
    (A : I → ℂ) (hA : ∀ i, ‖A i‖ ≤ 1) (K : I → I → ℂ) {κ : ℝ} (hκ : 0 ≤ κ)
    (hcorr : κ ≤ ‖𝔼 u, 𝔼 v, (μ u : ℂ) * (μ v : ℂ) * A u * conj (A v) * K u v‖) :
    κ ^ 2 ≤ 𝔼 v, 𝔼 v', μ v * μ v' * ‖𝔼 u, (μ u : ℂ) * K u v * conj (K u v')‖ := by
  let F : I → ℂ := fun u => 𝔼 v, (μ v : ℂ) * conj (A v) * K u v
  have he : (𝔼 u, 𝔼 v, (μ u : ℂ) * (μ v : ℂ) * A u * conj (A v) * K u v) =
      𝔼 u, (μ u : ℂ) * A u * F u := by
    apply Finset.expect_congr rfl
    intro u _
    dsimp [F]
    rw [Finset.mul_expect]
    apply Finset.expect_congr rfl
    intro v _
    ring
  rw [he] at hcorr
  have hcs := finite_weighted_complex_cauchy_schwarz μ hμ hmass.le A F hA
  have hlow : κ ^ 2 ≤ 𝔼 u, μ u * ‖F u‖ ^ 2 :=
    (pow_le_pow_left₀ hκ hcorr 2).trans hcs
  have hnonneg : 0 ≤ 𝔼 u, μ u * ‖F u‖ ^ 2 :=
    Finset.expect_nonneg (fun u _ => mul_nonneg (hμ u) (sq_nonneg _))
  have hn : κ ^ 2 ≤ ‖((𝔼 u, μ u * ‖F u‖ ^ 2 : ℝ) : ℂ)‖ := by
    simpa only [Complex.norm_real, Real.norm_of_nonneg hnonneg] using hlow
  rw [show ((𝔼 u, μ u * ‖F u‖ ^ 2 : ℝ) : ℂ) =
      𝔼 v, 𝔼 v', (μ v : ℂ) * (μ v' : ℂ) * conj (A v) * A v' *
        (𝔼 u, (μ u : ℂ) * K u v * conj (K u v')) from finite_weighted_kernel_square μ A K] at hn
  apply hn.trans
  apply (RCLike.norm_expect_le (K := ℂ)).trans
  apply Finset.expect_le_expect
  intro v _
  apply (RCLike.norm_expect_le (K := ℂ)).trans
  apply Finset.expect_le_expect
  intro v' _
  let B := 𝔼 u, (μ u : ℂ) * K u v * conj (K u v')
  have hAA : ‖A v‖ * ‖A v'‖ ≤ 1 :=
    (mul_le_mul (hA v) (hA v') (norm_nonneg _) zero_le_one).trans_eq (one_mul 1)
  calc
    _ = μ v * μ v' * (‖A v‖ * ‖A v'‖) * ‖B‖ := by
      simp only [norm_mul, Complex.norm_conj, Complex.norm_real,
        Real.norm_of_nonneg (hμ v), Real.norm_of_nonneg (hμ v')]
      ring
    _ ≤ μ v * μ v' * 1 * ‖B‖ := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left hAA (mul_nonneg (hμ v) (hμ v'))) (norm_nonneg _)
    _ = _ := by ring

/-- Subtraction of two inner Bohr points is compatible with the locally additive map. -/
theorem graph_local_additive_sub {q : ℕ} [NeZero q] (S : Finset (ZMod q))
    (M : ZMod q → ZMod q) {s ρ : ℝ} (hs : 0 ≤ s) (hρ : 2 * s ≤ ρ)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    {v v' : ZMod q} (hv : v ∈ graphBohrSet S s) (hv' : v' ∈ graphBohrSet S s) :
    M (v - v') = M v - M v' := by
  have hvρ := graphBohrSet_mono (S := S) (Finset.Subset.refl S) (by linarith : s ≤ ρ) hv
  have hv'ρ := graphBohrSet_mono (S := S) (Finset.Subset.refl S) (by linarith : s ≤ ρ) hv'
  have hdiff := graphBohrSet_mono (S := S) (Finset.Subset.refl S)
    (by linarith : s + s ≤ ρ) (graphBohrSet_sub S hv hv')
  have h := hadd (v - v') hdiff v' hv'ρ (by simpa only [sub_add_cancel] using hvρ)
  rw [sub_add_cancel] at h
  exact eq_sub_iff_add_eq.mpr h.symm

theorem graph_alternating_character_difference {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (u v v' : ZMod q) (hM : M (v - v') = M v - M v') :
    ZMod.stdAddChar (-(2 * graphAlternating M u v)) *
      conj (ZMod.stdAddChar (-(2 * graphAlternating M u v'))) =
        ZMod.stdAddChar (-(2 * graphAlternating M u (v - v'))) := by
  rw [graph_stdChar_conj, ← AddChar.map_add_eq_mul]
  congr 1
  unfold graphAlternating
  rw [hM]
  ring

/-- Local Fourier coefficient of the doubled alternating phase. -/
noncomputable def graphAlternatingFourier {q : ℕ} [NeZero q]
    (μ : ZMod q → ℝ) (M : ZMod q → ZMod q) (v : ZMod q) : ℂ :=
  𝔼 u, (μ u : ℂ) * ZMod.stdAddChar (-(2 * graphAlternating M u v))

/-- The source second Cauchy-Schwarz conclusion, with the exact fourth-power correlation bound. -/
theorem graph_symmetry_second_cauchy_schwarz {q : ℕ} [NeZero q]
    (S : Finset (ZMod q)) (μ : ZMod q → ℝ) (hμ : ∀ u, 0 ≤ μ u)
    (hμmass : (𝔼 u, μ u) = 1) (M : ZMod q → ZMod q) {s ρ : ℝ}
    (hs : 0 ≤ s) (hρ : 2 * s ≤ ρ) (hμsupp : ∀ u, μ u ≠ 0 → u ∈ graphBohrSet S s)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    (a b : ZMod q → ℂ) (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1)
    (z : ZMod q) {ζ : ℝ}
    (hcorr : ζ ^ 2 / 2 ≤ ‖graphSymmetryFixedCorrelation μ M a b z‖) :
    ζ ^ 4 / 4 ≤ 𝔼 v, 𝔼 v', μ v * μ v' * ‖graphAlternatingFourier μ M (v - v')‖ := by
  let A : ZMod q → ℂ := graphLocalAmplitude M a b z
  let K : ZMod q → ZMod q → ℂ := fun u v => ZMod.stdAddChar (-(2 * graphAlternating M u v))
  have hc : ζ ^ 2 / 2 ≤ ‖𝔼 u, 𝔼 v,
      (μ u : ℂ) * (μ v : ℂ) * A u * conj (A v) * K u v‖ := by
    simpa only [graphSymmetryFixedCorrelation, graphSymmetryKernel, mul_assoc] using hcorr
  have h := finite_weighted_kernel_cauchy_schwarz μ hμ hμmass A
    (graphLocalAmplitude_norm_le M a b ha hb z) K (by positivity : 0 ≤ ζ ^ 2 / 2) hc
  have he : (𝔼 v, 𝔼 v', μ v * μ v' * ‖𝔼 u, (μ u : ℂ) * K u v * conj (K u v')‖) =
      𝔼 v, 𝔼 v', μ v * μ v' * ‖graphAlternatingFourier μ M (v - v')‖ := by
    apply Finset.expect_congr rfl
    intro v _
    apply Finset.expect_congr rfl
    intro v' _
    by_cases hv : μ v = 0
    · simp [hv]
    by_cases hv' : μ v' = 0
    · simp [hv']
    have hM := graph_local_additive_sub S M hs hρ hadd (hμsupp v hv) (hμsupp v' hv')
    have hinner : (𝔼 u, (μ u : ℂ) * K u v * conj (K u v')) =
        graphAlternatingFourier μ M (v - v') := by
      apply Finset.expect_congr rfl
      intro u _
      dsimp [K]
      rw [mul_assoc, graph_alternating_character_difference M u v v' hM]
    rw [hinner]
  rw [he] at h
  convert h using 1; ring

/-- The supported upper level set used in the local-symmetry argument,
 blueprint `lem:local-symmetry`, lines 983-989. -/
noncomputable def weightedUpperLevel {I : Type*} [Fintype I]
    (μ θ : I → ℝ) (τ : ℝ) : Finset I := by
  classical
  exact Finset.univ.filter (fun i => μ i ≠ 0 ∧ τ ≤ θ i)

/-- A normalized weighted average at least twice the threshold gives at least
 the threshold of mass to its supported upper level set. -/
lemma finite_weighted_upper_level_mass {I : Type*} [Fintype I] [DecidableEq I]
    (μ θ : I → ℝ) (hμ : ∀ i, 0 ≤ μ i) (hmass : 𝔼 i, μ i = 1)
    (hθ : ∀ i, θ i ≤ 1) {τ : ℝ} (hτ : 0 ≤ τ)
    (havg : 2 * τ ≤ 𝔼 i, μ i * θ i) :
    τ ≤ 𝔼 i, if i ∈ weightedUpperLevel μ θ τ then μ i else 0 := by
  classical
  have hp (i : I) : μ i * θ i ≤ τ * μ i +
      (if i ∈ weightedUpperLevel μ θ τ then μ i else 0) := by
    by_cases hi : i ∈ weightedUpperLevel μ θ τ
    · simp only [ite_eq_left hi]
      nlinarith [mul_nonneg hτ (hμ i), mul_le_mul_of_nonneg_left (hθ i) (hμ i)]
    · simp only [ite_eq_right hi]
      by_cases hz : μ i = 0
      · simp [hz]
      · have ht : θ i < τ := by
          simpa [weightedUpperLevel, hz] using hi
        nlinarith [mul_le_mul_of_nonneg_left ht.le (hμ i)]
  have h := Finset.expect_le_expect (s := Finset.univ) (fun i _ => hp i)
  rw [Finset.expect_add_distrib, ← Finset.mul_expect, hmass, mul_one] at h
  linarith

/-- A pointwise density cap converts normalized weighted mass to counting density. -/
lemma finite_weighted_set_density {I : Type*} [Fintype I] [DecidableEq I]
    (μ : I → ℝ) (A : Finset I) {β τ : ℝ} (hβ : 0 < β)
    (hcap : ∀ i, μ i ≤ 1 / β)
    (hmass : τ ≤ 𝔼 i, if i ∈ A then μ i else 0) :
    β * τ ≤ (A.card : ℝ) / Fintype.card I := by
  have h : (𝔼 i, if i ∈ A then μ i else 0) ≤
      𝔼 i, if i ∈ A then (1 / β : ℝ) else 0 := by
    apply Finset.expect_le_expect
    intro i _
    split_ifs
    · exact hcap i
    · exact le_rfl
  have he : (𝔼 i, if i ∈ A then (1 / β : ℝ) else 0) =
      ((A.card : ℝ) / Fintype.card I) / β := by
    rw [Fintype.expect_eq_sum_div_card]
    simp only [Finset.sum_ite_mem, Finset.univ_inter,
      Finset.sum_const, nsmul_eq_mul]
    ring
  rw [he] at h
  have := (le_div_iff₀ hβ).mp (hmass.trans h)
  simpa only [mul_comm] using this

/-- Every normalized nonnegative local Fourier coefficient has modulus at most one. -/
lemma graphAlternatingFourier_norm_le {q : ℕ} [NeZero q]
    (μ : ZMod q → ℝ) (hμ : ∀ u, 0 ≤ μ u) (hmass : (𝔼 u, μ u) = 1)
    (M : ZMod q → ZMod q) (v : ZMod q) :
    ‖graphAlternatingFourier μ M v‖ ≤ 1 := by
  unfold graphAlternatingFourier
  calc
    _ ≤ 𝔼 u, ‖(μ u : ℂ) * ZMod.stdAddChar (-(2 * graphAlternating M u v))‖ :=
      RCLike.norm_expect_le (K := ℂ)
    _ = 𝔼 u, μ u := by
      apply Finset.expect_congr rfl
      intro u _
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (hμ u)]
      simp [ZMod.stdAddChar_apply]
    _ = 1 := hmass

/-- Extract the supported local spectrum with its weighted mass and ordinary density;
 blueprint `lem:local-symmetry`, lines 983-989. -/
theorem graph_local_spectrum_set {q : ℕ} [NeZero q]
    (μ : ZMod q → ℝ) (hμ : ∀ u, 0 ≤ μ u) (hmass : (𝔼 u, μ u) = 1)
    {β ζ : ℝ} (hβ : 0 < β) (hcap : ∀ u, μ u ≤ 1 / β) (hζ : 0 < ζ)
    (M : ZMod q → ZMod q)
    (hcorr : ζ ^ 4 / 4 ≤
      𝔼 v, 𝔼 v', μ v * μ v' * ‖graphAlternatingFourier μ M (v - v')‖) :
    ∃ v' : ZMod q, ∃ A : Finset (ZMod q), μ v' ≠ 0 ∧ A.Nonempty ∧
      ζ ^ 4 / 8 ≤ (𝔼 v, if v ∈ A then μ v else 0) ∧
      β * (ζ ^ 4 / 8) ≤ (A.card : ℝ) / q ∧
      ∀ v ∈ A, μ v ≠ 0 ∧ ζ ^ 4 / 8 ≤ ‖graphAlternatingFourier μ M (v - v')‖ := by
  classical
  let F : ZMod q → ℝ := fun v' => 𝔼 v, μ v * ‖graphAlternatingFourier μ M (v - v')‖
  have hF (v') : 0 ≤ F v' := Finset.expect_nonneg (fun v _ => mul_nonneg (hμ v) (norm_nonneg _))
  have he : (𝔼 v, 𝔼 v', μ v * μ v' * ‖graphAlternatingFourier μ M (v - v')‖) =
      𝔼 v', μ v' * F v' := by
    rw [Finset.expect_comm]
    apply Finset.expect_congr rfl
    intro v' _
    dsimp only [F]
    rw [Finset.mul_expect]
    apply Finset.expect_congr rfl
    intro v _
    ring
  rw [he] at hcorr
  have hc : ζ ^ 4 / 4 ≤ ‖𝔼 v', (μ v' : ℂ) * (F v' : ℂ)‖ := by
    have hec : (𝔼 v', (μ v' : ℂ) * (F v' : ℂ)) = ((𝔼 v', μ v' * F v' : ℝ) : ℂ) := by
      rw [finite_expect_ofReal]
      simp only [Complex.ofReal_mul]
    rw [hec, Complex.norm_real, Real.norm_of_nonneg
      (Finset.expect_nonneg (fun v' _ => mul_nonneg (hμ v') (hF v')))]
    exact hcorr
  obtain ⟨v', hv', hv⟩ := finite_weighted_correlation_select μ hμ hmass.le
    (fun v' => (F v' : ℂ)) (by positivity : 0 < ζ ^ 4 / 4) hc
  rw [Complex.norm_real, Real.norm_of_nonneg (hF v')] at hv
  let θ : ZMod q → ℝ := fun v => ‖graphAlternatingFourier μ M (v - v')‖
  let A := weightedUpperLevel μ θ (ζ ^ 4 / 8)
  have hAmass : ζ ^ 4 / 8 ≤ 𝔼 v, if v ∈ A then μ v else 0 :=
    finite_weighted_upper_level_mass μ θ hμ hmass
      (fun v => graphAlternatingFourier_norm_le μ hμ hmass M (v - v'))
      (by positivity) (by dsimp [F] at hv; dsimp [θ]; linarith)
  have hAdensity : β * (ζ ^ 4 / 8) ≤ (A.card : ℝ) / q := by
    simpa only [ZMod.card] using finite_weighted_set_density μ A hβ hcap hAmass
  have hA : A.Nonempty := by
    by_contra hn
    rw [Finset.not_nonempty_iff_eq_empty.mp hn, Finset.card_empty, Nat.cast_zero,
      zero_div] at hAdensity
    have : 0 < β * (ζ ^ 4 / 8) := by positivity
    linarith
  refine ⟨v', A, hv', hA, hAmass, hAdensity, ?_⟩
  intro v hv
  exact (Finset.mem_filter.mp hv).2

/-- Additivity of the alternating phase in its first argument uses only the displayed
 local additivity identity for the frequency map. -/
lemma graphAlternatingPhase_add_left {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (x y z : ZMod q) (hM : M (x + y) = M x + M y) :
    graphAlternatingPhase M (x + y) z =
      graphAlternatingPhase M x z + graphAlternatingPhase M y z := by
  unfold graphAlternatingPhase
  rw [← map_add]
  congr 1
  unfold graphAlternating
  rw [hM]
  ring

/-- The exact local Fourier decay estimate for an alternating graph frequency;
 blueprint `lem:local-symmetry`, lines 990-994. -/
theorem graph_alternating_fourier_decay {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    {L : ℝ≥0} (hLip : LipschitzWith L b) (hb : ∀ a, 0 ≤ b a) (hb1 : ∀ a, b a ≤ 1)
    (hbone : ∀ a, |a| ≤ 1 / 2 → b a = 1) (hsupp : ∀ a, 1 ≤ |a| → b a = 0)
    (S : Finset (ZMod q)) {r ρ : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8)
    (hρ : 3 * r ≤ ρ) (M : ZMod q → ZMod q)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    {τ : ℝ} (hτ : 0 < τ) (z : ZMod q)
    (hcorr : τ ≤ ‖graphAlternatingFourier (graphBohrMeasure b S r) M z‖)
    (x : ZMod q) (hx : x ∈ graphBohrSet S r) :
    ‖(2 : ℕ) • graphAlternatingPhase M x z‖ ≤
      max (L : ℝ) 1 * S.card * graphBohrNorm S x / (r * graphBohrMass b S r * τ) := by
  let φ : ZMod q → UnitAddCircle := fun u => -(2 • graphAlternatingPhase M u z)
  have hsets (s : ℝ) : cyclicBohrSet S s = graphBohrSet S s := by
    ext u
    rw [mem_cyclicBohrSet, mem_graphBohrSet]
  have hφ : ∀ u ∈ cyclicBohrSet S (3 * r), ∀ v ∈ cyclicBohrSet S (3 * r),
      u + v ∈ cyclicBohrSet S (3 * r) → φ (u + v) = φ u + φ v := by
    intro u hu v hv huv
    rw [hsets] at hu hv huv
    have hm := graphBohrSet_mono (Finset.Subset.refl S) hρ
    have hM := hadd u (hm hu) v (hm hv) (hm huv)
    simp only [φ, graphAlternatingPhase_add_left M u v z hM, smul_add, neg_add]
  have he : weightedCircleAverage (cyclicBohrMeasure b S r) φ =
      graphAlternatingFourier (graphBohrMeasure b S r) M z := by
    apply Finset.expect_congr rfl
    intro u _
    have hp : φ u = ZMod.toAddCircle (-(2 * graphAlternating M u z)) := by
      dsimp [φ, graphAlternatingPhase]
      simp only [map_neg, two_mul, map_add, two_smul]
    rw [hp]
    rfl
  have h := cyclicBohrWeight_local_fourier_decay b hLip hb hb1 hbone hsupp S hr hrsmall
    φ hφ hτ (by rw [he]; exact hcorr) x (by rw [hsets]; exact hx)
  change ‖-(2 • graphAlternatingPhase M x z)‖ ≤ _ at h
  simpa only [norm_neg, cyclicBohrNorm, graphBohrNorm, cyclicBohrMass,
    graphBohrMass, cyclicBohrWeight, graphBohrWeight, circleCutoff, unitCircleCentered] using h

/-- Additivity in the second slot of the alternating phase. -/
lemma graphAlternatingPhase_add_right {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (x y z : ZMod q) (hM : M (y + z) = M y + M z) :
    graphAlternatingPhase M x (y + z) =
      graphAlternatingPhase M x y + graphAlternatingPhase M x z := by
  unfold graphAlternatingPhase
  rw [← map_add]
  congr 1
  unfold graphAlternating
  rw [hM]
  ring

/-- Subtraction in the second slot needs only the corresponding local map identity. -/
lemma graphAlternatingPhase_sub_right {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (x y z : ZMod q) (hM : M (y - z) = M y - M z) :
    graphAlternatingPhase M x (y - z) =
      graphAlternatingPhase M x y - graphAlternatingPhase M x z := by
  unfold graphAlternatingPhase
  rw [← map_sub]
  congr 1
  unfold graphAlternating
  rw [hM]
  ring

/-- Four supported phase estimates extend to the double difference set, with all
 partial sums inside the original domain; blueprint `lem:local-symmetry`, lines 995-999. -/
theorem graph_alternating_fourfold_bound {q : ℕ} [NeZero q]
    (S A : Finset (ZMod q)) {r ρ E : ℝ} (hr : 0 ≤ r) (hρ : 4 * r ≤ ρ)
    (M : ZMod q → ZMod q)
    (hadd : ∀ u ∈ graphBohrSet S ρ, ∀ v ∈ graphBohrSet S ρ,
      u + v ∈ graphBohrSet S ρ → M (u + v) = M u + M v)
    (hA : A ⊆ graphBohrSet S r) (v' : ZMod q) (hv' : v' ∈ graphBohrSet S r)
    (x : ZMod q) (hbound : ∀ v ∈ A, ‖(2 : ℕ) • graphAlternatingPhase M x (v - v')‖ ≤ E)
    (z : ZMod q) (hz : z ∈ (2 : ℕ) • A - (2 : ℕ) • A) :
    ‖(2 : ℕ) • graphAlternatingPhase M x z‖ ≤ 4 * E := by
  rw [two_nsmul] at hz
  obtain ⟨ab, hab, cd, hcd, rfl⟩ := Finset.mem_sub.mp hz
  obtain ⟨a, ha, b, hb, rfl⟩ := Finset.mem_add.mp hab
  obtain ⟨c, hc, d, hd, rfl⟩ := Finset.mem_add.mp hcd
  have hm1 := graphBohrSet_mono (Finset.Subset.refl S) (show r ≤ ρ by linarith)
  have hm2 := graphBohrSet_mono (Finset.Subset.refl S) (show r + r ≤ ρ by linarith)
  have hab := graphBohrSet_add S (hA ha) (hA hb)
  have hcd := graphBohrSet_add S (hA hc) (hA hd)
  have hMab := hadd a (hm1 (hA ha)) b (hm1 (hA hb)) (hm2 hab)
  have hMcd := hadd c (hm1 (hA hc)) d (hm1 (hA hd)) (hm2 hcd)
  have hMsub := graph_local_additive_sub S M (add_nonneg hr hr)
    (show 2 * (r + r) ≤ ρ by linarith) hadd hab hcd
  have hp (v : ZMod q) (hv : v ∈ A) : graphAlternatingPhase M x (v - v') =
      graphAlternatingPhase M x v - graphAlternatingPhase M x v' :=
    graphAlternatingPhase_sub_right M x v v'
      (graph_local_additive_sub S M hr (by linarith) hadd (hA hv) hv')
  have he : graphAlternatingPhase M x ((a + b) - (c + d)) =
      (graphAlternatingPhase M x (a - v') + graphAlternatingPhase M x (b - v')) -
      (graphAlternatingPhase M x (c - v') + graphAlternatingPhase M x (d - v')) := by
    rw [graphAlternatingPhase_sub_right M x _ _ hMsub,
      graphAlternatingPhase_add_right M x a b hMab,
      graphAlternatingPhase_add_right M x c d hMcd, hp a ha, hp b hb, hp c hc, hp d hd]
    abel
  rw [he, smul_sub, smul_add, smul_add]
  have hn := norm_sub_le
    ((2 : ℕ) • graphAlternatingPhase M x (a - v') + 2 • graphAlternatingPhase M x (b - v'))
    ((2 : ℕ) • graphAlternatingPhase M x (c - v') + 2 • graphAlternatingPhase M x (d - v'))
  have habn := norm_add_le ((2 : ℕ) • graphAlternatingPhase M x (a - v'))
    (2 • graphAlternatingPhase M x (b - v'))
  have hcdn := norm_add_le ((2 : ℕ) • graphAlternatingPhase M x (c - v'))
    (2 • graphAlternatingPhase M x (d - v'))
  linarith [hbound a ha, hbound b hb, hbound c hc, hbound d hd]

/-- The local spectrum controls the alternating phase on its entire double difference set. -/
theorem graph_spectrum_difference_decay {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    {L : ℝ≥0} (hLip : LipschitzWith L b) (hb : ∀ a, 0 ≤ b a) (hb1 : ∀ a, b a ≤ 1)
    (hbone : ∀ a, |a| ≤ 1 / 2 → b a = 1) (hsupp : ∀ a, 1 ≤ |a| → b a = 0)
    (S A : Finset (ZMod q)) {r ρ : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8)
    (hρ : 4 * r ≤ ρ) (M : ZMod q → ZMod q)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    (hA : A ⊆ graphBohrSet S r) (v' : ZMod q) (hv' : v' ∈ graphBohrSet S r)
    {τ : ℝ} (hτ : 0 < τ)
    (hcorr : ∀ v ∈ A, τ ≤ ‖graphAlternatingFourier (graphBohrMeasure b S r) M (v - v')‖)
    (x : ZMod q) (hx : x ∈ graphBohrSet S r)
    (z : ZMod q) (hz : z ∈ (2 : ℕ) • A - (2 : ℕ) • A) :
    ‖(2 : ℕ) • graphAlternatingPhase M x z‖ ≤
      4 * (max (L : ℝ) 1 * S.card / (r * graphBohrMass b S r * τ)) * graphBohrNorm S x := by
  have h := graph_alternating_fourfold_bound S A hr.le hρ M hadd hA v' hv' x
    (fun v hv => graph_alternating_fourier_decay b hLip hb hb1 hbone hsupp S hr hrsmall
      (by linarith) M hadd hτ (v - v') (hcorr v hv) x hx) z hz
  convert h using 1; ring

/-- A concrete radius satisfying all three shrinkage constraints in the local-symmetry proof. -/
noncomputable def graphSymmetryRefinedRadius (ρ r ζ D : ℝ) : ℝ :=
  ρ * r * ζ / (1000000 * (D + 1))

/-- The product radius is positive, small in each domain, and small enough for the phase bound. -/
lemma graphSymmetryRefinedRadius_bounds {ρ r ζ D : ℝ}
    (hρ : 0 < ρ) (hρ1 : ρ ≤ 1) (hr : 0 < r) (hr1 : r ≤ 1)
    (hζ : 0 < ζ) (hζ1 : ζ ≤ 1) (hD : 0 ≤ D) :
    0 < graphSymmetryRefinedRadius ρ r ζ D ∧
      graphSymmetryRefinedRadius ρ r ζ D ≤ ρ / 100 ∧
      graphSymmetryRefinedRadius ρ r ζ D ≤ r / 100 ∧
      1000000 * D * graphSymmetryRefinedRadius ρ r ζ D ≤ ζ := by
  have hden : 0 < 1000000 * (D + 1) := by positivity
  have hprod : ρ * r ≤ 1 := (mul_le_of_le_one_left hr.le hρ1).trans hr1
  have hrζ : r * ζ ≤ 1 := (mul_le_of_le_one_left hζ.le hr1).trans hζ1
  have hρζ : ρ * ζ ≤ 1 := (mul_le_of_le_one_left hζ.le hρ1).trans hζ1
  dsimp [graphSymmetryRefinedRadius]
  refine ⟨by positivity, ?_, ?_, ?_⟩
  · apply (div_le_iff₀ hden).mpr
    have := mul_le_mul_of_nonneg_left hrζ hρ.le
    nlinarith only [mul_nonneg hρ.le hD, hρ, hrζ]
  · apply (div_le_iff₀ hden).mpr
    have := mul_le_mul_of_nonneg_left hρζ hr.le
    nlinarith [mul_nonneg hr.le hD]
  · rw [← mul_div_assoc]
    apply (div_le_iff₀ hden).mpr
    have := mul_le_mul_of_nonneg_left hprod (show 0 ≤ 1000000 * D * ζ by positivity)
    nlinarith

/-- Exact logarithmic cost of the explicit refined radius. -/
lemma graphSymmetryRefinedRadius_log {ρ r ζ D : ℝ}
    (hρ : 0 < ρ) (hr : 0 < r) (hζ : 0 < ζ) (hD : 0 ≤ D) :
    Real.log (1 / graphSymmetryRefinedRadius ρ r ζ D) =
      Real.log (1 / ρ) + Real.log (1 / r) + Real.log (1 / ζ) +
        Real.log 1000000 + Real.log (D + 1) := by
  have hD' : D + 1 ≠ 0 := by positivity
  simp only [graphSymmetryRefinedRadius, one_div, Real.log_inv,
    Real.log_div (mul_ne_zero (mul_ne_zero hρ.ne' hr.ne') hζ.ne')
      (mul_ne_zero (by norm_num : (1000000 : ℝ) ≠ 0) hD'),
    Real.log_mul (mul_ne_zero hρ.ne' hr.ne') hζ.ne',
    Real.log_mul hρ.ne' hr.ne', Real.log_mul (by norm_num : (1000000 : ℝ) ≠ 0) hD']
  ring

/-- Dense Bogolyubov followed by an explicit radius shrinkage, preserving the original
 frequencies and recording the complete rank/logarithmic cost. -/
theorem graph_symmetry_dense_subdomain {q : ℕ} [NeZero q]
    (S A : Finset (ZMod q)) (hA : A.Nonempty) {r ζ D : ℝ}
    (hr : 0 < r) (hr1 : r ≤ 1) (hζ : 0 < ζ) (hζ1 : ζ ≤ 1) (hD : 0 ≤ D) :
    ∃ T : Finset (ZMod q), ∃ s : ℝ, S ⊆ T ∧ 1 ∈ T ∧ 0 < s ∧ s ≤ r / 100 ∧
      1000000 * D * s ≤ ζ ∧ graphBohrSet T s ⊆ (2 : ℕ) • A - (2 : ℕ) • A ∧
      (T.card : ℝ) + Real.log (1 / s) ≤ S.card +
        10 ^ 20 * (1 + Real.log (1 / ((A.card : ℝ) / q))) ^ 4 +
        Real.log (1 / r) + Real.log (1 / ζ) + Real.log 1000000 + Real.log (D + 1) := by
  classical
  obtain ⟨T, ρ, hT1, hρ, hρsmall, hcost, hcontain⟩ := cyclic_small_bohr_domain A hA
  let s := graphSymmetryRefinedRadius ρ r ζ D
  obtain ⟨hs, hsρ, hsr, hsD⟩ := graphSymmetryRefinedRadius_bounds hρ
    (by linarith) hr hr1 hζ hζ1 hD
  refine ⟨S ∪ T, s, Finset.subset_union_left, Finset.mem_union_right S hT1,
    hs, hsr, hsD, ?_, ?_⟩
  · apply Finset.Subset.trans _ hcontain
    exact graphBohrSet_mono Finset.subset_union_right (hsρ.trans (by linarith))
  · have hcard : ((S ∪ T).card : ℝ) ≤ S.card + T.card := by
      exact_mod_cast Finset.card_union_le S T
    have hlog := graphSymmetryRefinedRadius_log hρ hr hζ hD
    change Real.log (1 / s) = _ at hlog
    rw [hlog]
    linarith only [hcost, hcard]

/-- In odd cyclic groups, doubling a Bohr domain divides its frequencies by two.
 Here doubling is an image, not the sum of two independently chosen points. -/
theorem graphBohrSet_doubling {q : ℕ} [NeZero q] (hq : Odd q)
    (T : Finset (ZMod q)) (r : ℝ) :
    graphBohrSet (T.image (fun t => (2 : ZMod q)⁻¹ * t)) r =
      (graphBohrSet T r).image (fun u => 2 * u) := by
  classical
  have hunit : IsUnit (2 : ZMod q) :=
    (ZMod.isUnit_iff_coprime 2 q).mpr (Nat.coprime_two_left.mpr hq)
  have hcancel := ZMod.mul_inv_of_unit (2 : ZMod q) hunit
  ext x
  constructor
  · intro hx
    refine Finset.mem_image.mpr ⟨(2 : ZMod q)⁻¹ * x, ?_, ?_⟩
    · rw [mem_graphBohrSet]
      intro t ht
      have h := (mem_graphBohrSet _ _ _).mp hx ((2 : ZMod q)⁻¹ * t)
        (Finset.mem_image.mpr ⟨t, ht, rfl⟩)
      rw [show t * ((2 : ZMod q)⁻¹ * x) = ((2 : ZMod q)⁻¹ * t) * x by ring]
      exact h
    · rw [← mul_assoc, hcancel, one_mul]
  · intro hx
    obtain ⟨u, hu, rfl⟩ := Finset.mem_image.mp hx
    rw [mem_graphBohrSet]
    intro t ht
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp ht
    have he : (2 : ZMod q)⁻¹ * a * (2 * u) = a * u := by
      calc
        _ = (2 * (2 : ZMod q)⁻¹) * (a * u) := by ring
        _ = _ := by rw [hcancel, one_mul]
    rw [he]
    exact (mem_graphBohrSet T r u).mp hu a ha

/-- Local doubling in each argument quadruples the circle-valued alternating phase. -/
lemma graphAlternatingPhase_double {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (u v : ZMod q)
    (hu : M (2 * u) = 2 * M u) (hv : M (2 * v) = 2 * M v) :
    graphAlternatingPhase M (2 * u) (2 * v) = (4 : ℕ) • graphAlternatingPhase M u v := by
  unfold graphAlternatingPhase
  rw [← map_nsmul]
  congr 1
  unfold graphAlternating
  rw [hu, hv]
  simp only [nsmul_eq_mul]
  ring

/-- Doubling the small domain controls the phase itself, without dividing a circle norm;
 blueprint `lem:local-symmetry`, lines 1008-1013. -/
theorem graph_symmetry_doubling_domain {q : ℕ} [NeZero q] (hq : Odd q)
    (S T : Finset (ZMod q)) (hST : S ⊆ T) {r s ρ D : ℝ}
    (hsr : s ≤ r) (hρ : 2 * r ≤ ρ) (hr : 0 ≤ r)
    (M : ZMod q → ZMod q)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    (hphase : ∀ u ∈ graphBohrSet T s, ∀ v ∈ graphBohrSet T s,
      ‖(2 : ℕ) • graphAlternatingPhase M u v‖ ≤ 4 * D * s) :
    ∃ S' : Finset (ZMod q), S ⊆ S' ∧ S'.card ≤ S.card + T.card ∧
      ∀ x ∈ graphBohrSet S' s, ∀ y ∈ graphBohrSet S' s,
        ‖graphAlternatingPhase M x y‖ ≤ 8 * D * s := by
  classical
  let U := T.image (fun t => (2 : ZMod q)⁻¹ * t)
  refine ⟨S ∪ U, Finset.subset_union_left, ?_, ?_⟩
  · exact (Finset.card_union_le S U).trans (Nat.add_le_add_left (Finset.card_image_le) _)
  · intro x hx y hy
    have hm := graphBohrSet_mono (S := U) (T := S ∪ U) Finset.subset_union_right (le_refl s)
    have hx' := hm hx
    have hy' := hm hy
    rw [graphBohrSet_doubling hq T s] at hx' hy'
    obtain ⟨u, hu, rfl⟩ := Finset.mem_image.mp hx'
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hy'
    have hdouble (w : ZMod q) (hw : w ∈ graphBohrSet T s) : M (2 * w) = 2 * M w := by
      have hw' := graphBohrSet_mono hST hsr hw
      have hm1 := graphBohrSet_mono (Finset.Subset.refl S) (show r ≤ ρ by linarith)
      have hm2 := graphBohrSet_mono (Finset.Subset.refl S) (show r + r ≤ ρ by linarith)
      simpa only [two_mul] using hadd w (hm1 hw') w (hm1 hw') (hm2 (graphBohrSet_add S hw' hw'))
    rw [graphAlternatingPhase_double M u v (hdouble u hu) (hdouble v hv)]
    have he : (4 : ℕ) • graphAlternatingPhase M u v =
        (2 : ℕ) • ((2 : ℕ) • graphAlternatingPhase M u v) := by rw [← mul_smul]; norm_num
    rw [he]
    have hn : ‖(2 : ℕ) • (2 • graphAlternatingPhase M u v)‖ ≤
        (2 : ℕ) * ‖(2 : ℕ) • graphAlternatingPhase M u v‖ := norm_nsmul_le
    norm_num only [Nat.cast_ofNat] at hn
    linarith [hphase u hu v hv]

/-- The dense spectrum estimate yields a smaller symmetric Bohr domain with its explicit
 complexity cost, before the final polynomial simplification in local symmetry. -/
theorem graph_symmetry_from_spectrum {q : ℕ} [NeZero q] (hq : Odd q)
    (S A : Finset (ZMod q)) (hA : A.Nonempty) {r ρ ζ D : ℝ}
    (hr : 0 < r) (hr1 : r ≤ 1) (hρ : 2 * r ≤ ρ)
    (hζ : 0 < ζ) (hζ1 : ζ ≤ 1) (hD : 0 ≤ D) (M : ZMod q → ZMod q)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    (hphase : ∀ u ∈ graphBohrSet S r, ∀ v ∈ (2 : ℕ) • A - (2 : ℕ) • A,
      ‖(2 : ℕ) • graphAlternatingPhase M u v‖ ≤ 4 * D * graphBohrNorm S u) :
    ∃ S' : Finset (ZMod q), ∃ s : ℝ, S ⊆ S' ∧ 0 < s ∧ s < r ∧
      (∀ x ∈ graphBohrSet S' s, ∀ y ∈ graphBohrSet S' s,
        ‖graphAlternatingPhase M x y‖ ≤ ζ / 1000) ∧
      (S'.card : ℝ) + Real.log (1 / s) ≤ 2 * S.card +
        10 ^ 20 * (1 + Real.log (1 / ((A.card : ℝ) / q))) ^ 4 +
        Real.log (1 / r) + Real.log (1 / ζ) + Real.log 1000000 + Real.log (D + 1) := by
  obtain ⟨T, s, hST, _, hs, hsr, hsD, hcontain, hcost⟩ :=
    graph_symmetry_dense_subdomain S A hA hr hr1 hζ hζ1 hD
  have hsr' : s ≤ r := hsr.trans (by linarith)
  have hp (u : ZMod q) (hu : u ∈ graphBohrSet T s)
      (v : ZMod q) (hv : v ∈ graphBohrSet T s) :
      ‖(2 : ℕ) • graphAlternatingPhase M u v‖ ≤ 4 * D * s := by
    have huS := graphBohrSet_mono hST (le_refl s) hu
    have huR := graphBohrSet_mono (Finset.Subset.refl S) hsr' huS
    exact (hphase u huR v (hcontain hv)).trans
      (mul_le_mul_of_nonneg_left (graphBohrNorm_le_of_mem S hs.le huS) (by positivity))
  obtain ⟨S', hSS', hcard, hphase'⟩ :=
    graph_symmetry_doubling_domain hq S T hST hsr' hρ hr.le M hadd hp
  refine ⟨S', s, hSS', hs, by linarith, ?_, ?_⟩
  · intro x hx y hy
    have h := hphase' x hx y hy
    nlinarith only [mul_nonneg hD hs.le, hsD, h]
  · have hc : (S'.card : ℝ) ≤ S.card + T.card := by exact_mod_cast hcard
    linarith

/-- A graph correlation of four unit-bounded factors has modulus at most one. -/
lemma graphLocalCorrelation_norm_le {q : ℕ} [NeZero q]
    (w : ZMod q → ℝ) (hw : ∀ h, |w h| ≤ 1) (M : ZMod q → ZMod q)
    (a b c : ZMod q → ℂ) (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1)
    (hc : ∀ x, ‖c x‖ ≤ 1) : ‖graphLocalCorrelation w M a b c‖ ≤ 1 := by
  unfold graphLocalCorrelation
  apply (RCLike.norm_expect_le (K := ℂ)).trans
  apply Finset.expect_le Finset.univ_nonempty
  intro h _
  apply (RCLike.norm_expect_le (K := ℂ)).trans
  apply Finset.expect_le Finset.univ_nonempty
  intro x _
  simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, ZMod.stdAddChar_apply,
    Circle.norm_coe, mul_one]
  calc
    |w h| * ‖c h‖ * (‖a (x + h)‖ * ‖b x‖) ≤ 1 * 1 * (1 * 1) := by
      gcongr
      · exact hw h
      · exact hc h
      · exact ha (x + h)
      · exact hb x
    _ = 1 := by norm_num

/-- The coefficient in the local alternating Fourier decay estimate. -/
noncomputable def graphSymmetryDecayConstant (C : ℝ) (d : ℕ) (s β ζ : ℝ) : ℝ :=
  C * d / (s * β * (ζ ^ 4 / 8))

/-- Assemble local symmetry at any inner radius satisfying the source's domain and
 translation tolerances, retaining an explicit complexity cost for the final budget. -/
theorem graph_local_symmetry_at_radius {q : ℕ} [NeZero q] (hq : Odd q)
    (cutoff : ℝ → ℝ) {L : ℝ≥0} (hLip : LipschitzWith L cutoff)
    (hb0 : ∀ x, 0 ≤ cutoff x) (hb1 : ∀ x, cutoff x ≤ 1)
    (hbone : ∀ x, |x| ≤ 1 / 2 → cutoff x = 1)
    (hsupp : ∀ x, 1 ≤ |x| → cutoff x = 0) (S : Finset (ZMod q))
    {r s ρ ζ : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8)
    (hs : 0 < s) (hsr : s ≤ r) (hρ : r + 2 * s ≤ ρ) (h4s : 4 * s ≤ ρ)
    (hζ : 0 < ζ) (htol : 2 * max (L : ℝ) 1 * S.card * s / r ≤ ζ ^ 2 / 2)
    (M : ZMod q → ZMod q)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    (a b c : ZMod q → ℂ) (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1)
    (hc : ∀ x, ‖c x‖ ≤ 1)
    (hcorr : ζ ≤ ‖graphLocalCorrelation (graphBohrWeight cutoff S r) M a b c‖) :
    ∃ S' : Finset (ZMod q), ∃ t : ℝ, S ⊆ S' ∧ 0 < t ∧ t < s ∧
      (∀ x ∈ graphBohrSet S' t, ∀ y ∈ graphBohrSet S' t,
        ‖graphAlternatingPhase M x y‖ ≤ ζ / 1000) ∧
      (S'.card : ℝ) + Real.log (1 / t) ≤ 2 * S.card +
        10 ^ 20 * (1 + Real.log (1 / (graphBohrMass cutoff S s * (ζ ^ 4 / 8)))) ^ 4 +
        Real.log (1 / s) + Real.log (1 / ζ) + Real.log 1000000 +
        Real.log (graphSymmetryDecayConstant (max (L : ℝ) 1) S.card s
          (graphBohrMass cutoff S s) ζ + 1) := by
  let w := graphBohrWeight cutoff S r
  let μ := graphBohrMeasure cutoff S s
  let β := graphBohrMass cutoff S s
  let D := graphSymmetryDecayConstant (max (L : ℝ) 1) S.card s β ζ
  have hssmall : s < 1 / 8 := hsr.trans_lt hrsmall
  have hβ : 0 < β := graphBohrMass_pos cutoff hb0 hb1 hbone S hs hssmall
  have hμ : ∀ u, 0 ≤ μ u := graphBohrMeasure_nonneg cutoff hb0 S s hβ
  have hμmass : (𝔼 u, μ u) = 1 := graphBohrMeasure_mean_one cutoff S s hβ
  have hμsupp (u : ZMod q) (hu : μ u ≠ 0) : u ∈ graphBohrSet S s := by
    by_contra hn
    exact hu (graphBohrMeasure_eq_zero_of_notMem cutoff hsupp S hs u hn)
  have hw (u : ZMod q) : 0 ≤ w u := (graphBohrWeight_bounds cutoff hb0 hb1 S r u).1
  have hw1 (u : ZMod q) : |w u| ≤ 1 := by
    rw [abs_of_nonneg (hw u)]
    exact (graphBohrWeight_bounds cutoff hb0 hb1 S r u).2
  have hζ1 : ζ ≤ 1 := hcorr.trans (graphLocalCorrelation_norm_le w hw1 M a b c ha hb hc)
  obtain ⟨a', b', c', ha', hb', hc', hloc⟩ :=
    graph_correlation_localization w μ hμmass M a b c ha hb hc hcorr
  have hsq := graph_localized_cauchy_schwarz w μ hw
    (graphBohrMass_bounds cutoff hb0 hb1 hbone S hr hrsmall).2 M a' b' c' hc' hζ.le hloc
  obtain ⟨z, _, _, hz⟩ := graph_bohr_symmetry_select cutoff hLip hb0 hb1 hbone hsupp S
    hr hrsmall hs hssmall hρ hζ htol M a' b' ha' hb' hadd hsq
  have hsecond := graph_symmetry_second_cauchy_schwarz S μ hμ hμmass M hs.le
    (by linarith : 2 * s ≤ ρ) hμsupp hadd a' b' ha' hb' z hz
  have hcap (u : ZMod q) : μ u ≤ 1 / β :=
    div_le_div_of_nonneg_right (graphBohrWeight_bounds cutoff hb0 hb1 S s u).2 hβ.le
  obtain ⟨v', A, hv', hA, _, hAdensity, hAcorr⟩ :=
    graph_local_spectrum_set μ hμ hμmass hβ hcap hζ M hsecond
  have hAB : A ⊆ graphBohrSet S s := fun u hu => hμsupp u (hAcorr u hu).1
  have hD : 0 ≤ D := by dsimp [D, graphSymmetryDecayConstant]; positivity
  have hphase (u : ZMod q) (hu : u ∈ graphBohrSet S s)
      (v : ZMod q) (hv : v ∈ (2 : ℕ) • A - (2 : ℕ) • A) :
      ‖(2 : ℕ) • graphAlternatingPhase M u v‖ ≤ 4 * D * graphBohrNorm S u :=
    graph_spectrum_difference_decay cutoff hLip hb0 hb1 hbone hsupp S A hs hssmall h4s M
      hadd hAB v' (hμsupp v' hv') (by positivity) (fun u hu => (hAcorr u hu).2) u hu v hv
  obtain ⟨S', t, hSS', ht, hts, hsym, hcost⟩ := graph_symmetry_from_spectrum hq S A hA
    hs (by linarith) (by linarith) hζ hζ1 hD M hadd hphase
  refine ⟨S', t, hSS', ht, hts, hsym, hcost.trans ?_⟩
  have hq : (0 : ℝ) < q := Nat.cast_pos.mpr (NeZero.pos q)
  have hα : 0 < (A.card : ℝ) / q := div_pos (Nat.cast_pos.mpr hA.card_pos) hq
  have hα1 : (A.card : ℝ) / q ≤ 1 := by
    apply (div_le_one hq).mpr
    exact_mod_cast (show A.card ≤ q by simpa only [ZMod.card] using Finset.card_le_univ A)
  have hlog : Real.log (1 / ((A.card : ℝ) / q)) ≤ Real.log (1 / (β * (ζ ^ 4 / 8))) :=
    Real.log_le_log (by positivity) (one_div_le_one_div_of_le (by positivity) hAdensity)
  have hn : 0 ≤ 1 + Real.log (1 / ((A.card : ℝ) / q)) := by
    have := Real.log_nonneg ((one_le_div hα).mpr hα1)
    linarith
  have hp := pow_le_pow_left₀ hn
    (show 1 + Real.log (1 / ((A.card : ℝ) / q)) ≤
      1 + Real.log (1 / (β * (ζ ^ 4 / 8))) by linarith) 4
  change 2 * (S.card : ℝ) + 10 ^ 20 * _ + _ + _ + _ + Real.log (D + 1) ≤ _
  dsimp only [D, β] at *
  nlinarith only [hp]

/-- The source polynomial budget for local symmetry. -/
noncomputable def graphSymmetryBudget (d : ℕ) (r ζ : ℝ) : ℝ :=
  d + Real.log (1 / r) + Real.log (1 / ζ) + 1

lemma graphSymmetryBudget_bounds (d : ℕ) {r ζ : ℝ}
    (hr : 0 < r) (hr1 : r ≤ 1) (hζ : 0 < ζ) (hζ1 : ζ ≤ 1) :
    1 ≤ graphSymmetryBudget d r ζ ∧ (d : ℝ) ≤ graphSymmetryBudget d r ζ ∧
      Real.log (1 / r) ≤ graphSymmetryBudget d r ζ ∧
      Real.log (1 / ζ) ≤ graphSymmetryBudget d r ζ := by
  have hR := Real.log_nonneg ((one_le_div hr).mpr hr1)
  have hZ := Real.log_nonneg ((one_le_div hζ).mpr hζ1)
  have hd : (0 : ℝ) ≤ d := Nat.cast_nonneg d
  dsimp [graphSymmetryBudget]
  constructor
  · linarith
  constructor
  · linarith
  constructor <;> linarith

/-- Exact logarithmic expansion of the inner radius when the correlation is at most one. -/
lemma localSymmetryInnerRadius_log (d : ℕ) {C r ζ : ℝ}
    (hC : 0 ≤ C) (hr : 0 < r) (hζ : 0 < ζ) (hζ1 : ζ ≤ 1) :
    Real.log (1 / localSymmetryInnerRadius C d r ζ) =
      Real.log (1 / r) + 2 * Real.log (1 / ζ) + Real.log 1000 +
        Real.log (C + 1) + Real.log ((d : ℝ) + 1) := by
  have hsq : ζ ^ 2 ≤ 1 := by nlinarith
  have hC' : C + 1 ≠ 0 := by positivity
  have hd' : (d : ℝ) + 1 ≠ 0 := by positivity
  have h1000 : (1000 : ℝ) ≠ 0 := by norm_num
  simp only [localSymmetryInnerRadius, min_eq_right hsq, one_div, Real.log_inv,
    Real.log_div (mul_ne_zero hr.ne' (pow_ne_zero 2 hζ.ne'))
      (mul_ne_zero (mul_ne_zero h1000 hC') hd'),
    Real.log_mul hr.ne' (pow_ne_zero 2 hζ.ne'), Real.log_pow,
    Real.log_mul (mul_ne_zero h1000 hC') hd', Real.log_mul h1000 hC']
  ring

/-- The logarithmic inner-radius loss is linear in the source budget. -/
lemma localSymmetryInnerRadius_log_bound (d : ℕ) {C r ζ : ℝ}
    (hC : 0 ≤ C) (hr : 0 < r) (hr1 : r ≤ 1) (hζ : 0 < ζ) (hζ1 : ζ ≤ 1) :
    Real.log (1 / localSymmetryInnerRadius C d r ζ) ≤
      (C + 1010) * graphSymmetryBudget d r ζ := by
  obtain ⟨hP, hd, hR, hZ⟩ := graphSymmetryBudget_bounds d hr hr1 hζ hζ1
  have hR0 := Real.log_nonneg ((one_le_div hr).mpr hr1)
  have hCmul : C + 1002 ≤ (C + 1002) * graphSymmetryBudget d r ζ :=
    le_mul_of_one_le_right (by linarith) hP
  rw [localSymmetryInnerRadius_log d hC hr hζ hζ1]
  have h1000 := Real.log_le_self (by norm_num : (0 : ℝ) ≤ 1000)
  have hClog := Real.log_le_self (show 0 ≤ C + 1 by linarith)
  have hdlog := Real.log_le_self (show (0 : ℝ) ≤ (d : ℝ) + 1 by positivity)
  dsimp [graphSymmetryBudget] at *
  nlinarith only [Nat.cast_nonneg d (α := ℝ), hC, hP, hZ, h1000, hClog, hdlog]

/-- A polynomial Bohr mass lower bound becomes the exact logarithmic mass estimate. -/
lemma graph_mass_log_bound (d : ℕ) {s β : ℝ} (hs : 0 < s)
    (hbound : (s / 6) ^ d ≤ β) : Real.log (1 / β) ≤ d * Real.log (6 / s) := by
  have h := Real.log_le_log (pow_pos (div_pos hs (by norm_num)) d) hbound
  rw [Real.log_pow, Real.log_div hs.ne' (by norm_num : (6 : ℝ) ≠ 0)] at h
  rw [one_div, Real.log_inv, Real.log_div (by norm_num : (6 : ℝ) ≠ 0) hs.ne']
  nlinarith

/-- Exact logarithmic cost of the fourth-power spectrum threshold. -/
lemma graph_symmetry_threshold_log {ζ : ℝ} (hζ : 0 < ζ) :
    Real.log (1 / (ζ ^ 4 / 8)) = 4 * Real.log (1 / ζ) + Real.log 8 := by
  rw [one_div, Real.log_inv, Real.log_div (pow_ne_zero 4 hζ.ne') (by norm_num),
    Real.log_pow, one_div, Real.log_inv]
  norm_num only [Nat.cast_ofNat]
  ring

/-- The logarithm of the decay constant loses only logarithms of the mass and radius. -/
lemma graphSymmetryDecayConstant_log (d : ℕ) {C s β ζ : ℝ}
    (hC : 0 ≤ C) (hs : 0 < s) (hs1 : s ≤ 1) (hβ : 0 < β) (hβ1 : β ≤ 1)
    (hζ : 0 < ζ) (hζ1 : ζ ≤ 1) :
    Real.log (graphSymmetryDecayConstant C d s β ζ + 1) ≤
      Real.log (C + 1) + Real.log ((d : ℝ) + 1) + Real.log (1 / s) +
        Real.log (1 / β) + 4 * Real.log (1 / ζ) + Real.log 8 := by
  have hτ : 0 < ζ ^ 4 / 8 := by positivity
  have hτ1 : ζ ^ 4 / 8 ≤ 1 := by
    have : ζ ^ 4 ≤ 1 := pow_le_one₀ hζ.le hζ1
    linarith
  have hsβ : s * β ≤ 1 := (mul_le_of_le_one_left hβ.le hs1).trans hβ1
  have hden : 0 < s * β * (ζ ^ 4 / 8) := by positivity
  have hden1 : s * β * (ζ ^ 4 / 8) ≤ 1 :=
    (mul_le_of_le_one_left hτ.le hsβ).trans hτ1
  have hC1 : 0 < C + 1 := by positivity
  have hd1 : 0 < (d : ℝ) + 1 := by positivity
  have hD : 0 ≤ graphSymmetryDecayConstant C d s β ζ := by
    unfold graphSymmetryDecayConstant
    positivity
  have hle : graphSymmetryDecayConstant C d s β ζ + 1 ≤
      ((C + 1) * ((d : ℝ) + 1)) / (s * β * (ζ ^ 4 / 8)) := by
    unfold graphSymmetryDecayConstant
    rw [div_add_one hden.ne']
    apply div_le_div_of_nonneg_right _ hden.le
    nlinarith only [Nat.cast_nonneg d (α := ℝ), hC, hτ, hτ1, hsβ]
  have hlog := Real.log_le_log (show 0 < graphSymmetryDecayConstant C d s β ζ + 1 by linarith) hle
  rw [Real.log_div (mul_ne_zero hC1.ne' hd1.ne') hden.ne',
    Real.log_mul hC1.ne' hd1.ne',
    Real.log_mul (mul_ne_zero hs.ne' hβ.ne') hτ.ne', Real.log_mul hs.ne' hβ.ne'] at hlog
  have hτlog := graph_symmetry_threshold_log hζ
  simp only [one_div, Real.log_inv] at hτlog ⊢
  linarith

/-- All logarithmic parameters in local symmetry have polynomial source-budget bounds;
 blueprint `lem:local-symmetry`, lines 1015-1016. -/
theorem graph_symmetry_parameter_bounds (d : ℕ) {C r ζ β : ℝ}
    (hC : 0 ≤ C) (hr : 0 < r) (hr1 : r ≤ 1) (hζ : 0 < ζ) (hζ1 : ζ ≤ 1)
    (hβ : 0 < β) (hβ1 : β ≤ 1)
    (hβlower : (localSymmetryInnerRadius C d r ζ / 6) ^ d ≤ β) :
    let s := localSymmetryInnerRadius C d r ζ
    let K := C + 10000
    let P := graphSymmetryBudget d r ζ
    Real.log (1 / s) ≤ K * P ∧ Real.log (1 / β) ≤ 2 * K * P ^ 2 ∧
      1 + Real.log (1 / (β * (ζ ^ 4 / 8))) ≤ 4 * K * P ^ 2 ∧
      Real.log (graphSymmetryDecayConstant C d s β ζ + 1) ≤ 6 * K * P ^ 2 := by
  let s := localSymmetryInnerRadius C d r ζ
  let K := C + 10000
  let P := graphSymmetryBudget d r ζ
  change Real.log (1 / s) ≤ K * P ∧ Real.log (1 / β) ≤ 2 * K * P ^ 2 ∧
    1 + Real.log (1 / (β * (ζ ^ 4 / 8))) ≤ 4 * K * P ^ 2 ∧
    Real.log (graphSymmetryDecayConstant C d s β ζ + 1) ≤ 6 * K * P ^ 2
  obtain ⟨hP, hd, hR, hZ⟩ := graphSymmetryBudget_bounds d hr hr1 hζ hζ1
  change 1 ≤ P at hP
  change (d : ℝ) ≤ P at hd
  change Real.log (1 / ζ) ≤ P at hZ
  have hK : 10000 ≤ K := by dsimp [K]; linarith
  have hP0 : 0 ≤ P := by linarith
  have hK0 : 0 ≤ K := by linarith
  have hPP2 : P ≤ P ^ 2 := le_self_pow₀ hP (by decide)
  have hP2 : 1 ≤ P ^ 2 := one_le_pow₀ hP
  have hKP : K ≤ K * P := le_mul_of_one_le_right hK0 hP
  have hKP2 : K ≤ K * P ^ 2 := le_mul_of_one_le_right hK0 hP2
  obtain ⟨hs, hsr, _⟩ := localSymmetryInnerRadius_bounds hC hr hζ d
  change 0 < s at hs
  change s ≤ r / 100 at hsr
  have hs1 : s ≤ 1 := by linarith
  have hR2 : Real.log (1 / s) ≤ K * P := by
    apply (localSymmetryInnerRadius_log_bound d hC hr hr1 hζ hζ1).trans
    exact mul_le_mul_of_nonneg_right (by dsimp [K]; linarith) hP0
  have h6 : 6 ≤ K * P := by linarith
  have hlog6 : Real.log (6 / s) ≤ 6 + K * P := by
    rw [Real.log_div (by norm_num : (6 : ℝ) ≠ 0) hs.ne']
    have h := hR2
    rw [one_div, Real.log_inv] at h
    linarith [Real.log_le_self (by norm_num : (0 : ℝ) ≤ 6)]
  have hB : Real.log (1 / β) ≤ 2 * K * P ^ 2 := by
    calc
      _ ≤ (d : ℝ) * Real.log (6 / s) := graph_mass_log_bound d hs hβlower
      _ ≤ (d : ℝ) * (6 + K * P) := mul_le_mul_of_nonneg_left hlog6 (Nat.cast_nonneg d)
      _ ≤ P * (6 + K * P) := mul_le_mul_of_nonneg_right hd (by positivity)
      _ ≤ 2 * K * P ^ 2 := by nlinarith only [mul_le_mul_of_nonneg_left h6 hP0]
  have hT : Real.log (1 / (ζ ^ 4 / 8)) ≤ 12 * P := by
    rw [graph_symmetry_threshold_log hζ]
    linarith [Real.log_le_self (by norm_num : (0 : ℝ) ≤ 8)]
  have hBT : Real.log (1 / (β * (ζ ^ 4 / 8))) =
      Real.log (1 / β) + Real.log (1 / (ζ ^ 4 / 8)) := by
    simp only [one_div, Real.log_inv, Real.log_mul hβ.ne' (by positivity : ζ ^ 4 / 8 ≠ 0)]
    ring
  have hKP2P : 10000 * P ≤ K * P ^ 2 := by
    calc
      _ ≤ K * P := mul_le_mul_of_nonneg_right hK hP0
      _ ≤ K * P ^ 2 := mul_le_mul_of_nonneg_left hPP2 hK0
  have hDensity : 1 + Real.log (1 / (β * (ζ ^ 4 / 8))) ≤ 4 * K * P ^ 2 := by
    rw [hBT]
    nlinarith only [hC, hP, hB, hT]
  refine ⟨hR2, hB, hDensity, ?_⟩
  have hD := graphSymmetryDecayConstant_log d hC hs hs1 hβ hβ1 hζ hζ1
  have hClog := Real.log_le_self (show 0 ≤ C + 1 by linarith)
  have hdlog := Real.log_le_self (show (0 : ℝ) ≤ (d : ℝ) + 1 by positivity)
  have h8 := Real.log_le_self (by norm_num : (0 : ℝ) ≤ 8)
  have hKP_P2 := mul_le_mul_of_nonneg_left hPP2 hK0
  have hCbound : C + 1 ≤ K := by dsimp [K]; linarith
  nlinarith only [hC, hP, hd, hZ, hPP2, hR2, hB, hD, hClog, hdlog, h8]

/-- The explicit local-symmetry construction has degree-eight polynomial complexity. -/
theorem graph_symmetry_complexity_bound (d : ℕ) {C r ζ β : ℝ}
    (hC : 0 ≤ C) (hr : 0 < r) (hr1 : r ≤ 1) (hζ : 0 < ζ) (hζ1 : ζ ≤ 1)
    (hβ : 0 < β) (hβ1 : β ≤ 1)
    (hβlower : (localSymmetryInnerRadius C d r ζ / 6) ^ d ≤ β) :
    2 * (d : ℝ) + 10 ^ 20 * (1 + Real.log (1 / (β * (ζ ^ 4 / 8)))) ^ 4 +
      Real.log (1 / localSymmetryInnerRadius C d r ζ) + Real.log (1 / ζ) +
      Real.log 1000000 +
      Real.log (graphSymmetryDecayConstant C d (localSymmetryInnerRadius C d r ζ) β ζ + 1) ≤
      10 ^ 30 * (C + 10000) ^ 4 * graphSymmetryBudget d r ζ ^ 8 := by
  let K := C + 10000
  let P := graphSymmetryBudget d r ζ
  let B := K ^ 4 * P ^ 8
  obtain ⟨hR, _, hDensity, hD⟩ := graph_symmetry_parameter_bounds d hC hr hr1 hζ hζ1 hβ hβ1 hβlower
  obtain ⟨hP, hd, _, hZ⟩ := graphSymmetryBudget_bounds d hr hr1 hζ hζ1
  change 1 ≤ P at hP
  change (d : ℝ) ≤ P at hd
  change Real.log (1 / ζ) ≤ P at hZ
  change Real.log (1 / localSymmetryInnerRadius C d r ζ) ≤ K * P at hR
  change 1 + Real.log (1 / (β * (ζ ^ 4 / 8))) ≤ 4 * K * P ^ 2 at hDensity
  change Real.log (graphSymmetryDecayConstant C d (localSymmetryInnerRadius C d r ζ) β ζ + 1) ≤
    6 * K * P ^ 2 at hD
  have hK : 1 ≤ K := by dsimp [K]; linarith
  have hK0 : 0 ≤ K := by linarith
  have hP0 : 0 ≤ P := by linarith
  have hKP2 : K * P ^ 2 ≤ B :=
    mul_le_mul (le_self_pow₀ hK (by decide : 4 ≠ 0))
      (pow_le_pow_right₀ hP (by decide : 2 ≤ 8)) (sq_nonneg P) (pow_nonneg hK0 4)
  have hPB : P ≤ B := by
    apply (le_self_pow₀ hP (by decide : 2 ≠ 0)).trans
    exact (le_mul_of_one_le_left (sq_nonneg P) hK).trans hKP2
  have hKPB : K * P ≤ B :=
    (mul_le_mul_of_nonneg_left (le_self_pow₀ hP (by decide : 2 ≠ 0)) hK0).trans hKP2
  have hB : 1 ≤ B := hP.trans hPB
  have hτ1 : ζ ^ 4 / 8 ≤ 1 := by
    have : ζ ^ 4 ≤ 1 := pow_le_one₀ hζ.le hζ1
    linarith
  have hβτ : β * (ζ ^ 4 / 8) ≤ 1 :=
    (mul_le_of_le_one_left (by positivity) hβ1).trans hτ1
  have hL : 0 ≤ 1 + Real.log (1 / (β * (ζ ^ 4 / 8))) := by
    have := Real.log_nonneg ((one_le_div (by positivity : 0 < β * (ζ ^ 4 / 8))).mpr hβτ)
    linarith
  have hp := pow_le_pow_left₀ hL hDensity 4
  have hm : 10 ^ 20 * (1 + Real.log (1 / (β * (ζ ^ 4 / 8)))) ^ 4 ≤
      (256 * 10 ^ 20) * B := by
    have h := mul_le_mul_of_nonneg_left hp (by positivity : (0 : ℝ) ≤ 10 ^ 20)
    convert h using 1; dsimp [B]; ring
  have hMillion : Real.log 1000000 ≤ 1000000 * B := by
    have := Real.log_le_self (by norm_num : (0 : ℝ) ≤ 1000000)
    linarith
  change _ ≤ 10 ^ 30 * K ^ 4 * P ^ 8
  rw [mul_assoc]
  change _ ≤ 10 ^ 30 * B
  nlinarith only [hm, hMillion, hd, hZ, hPB, hR, hKPB, hD, hKP2, hB]

/-- Quantitative local symmetry, with an explicit uniform degree-eight bound.
 This is blueprint `lem:local-symmetry`, including its original correlation hypothesis. -/
theorem graph_local_symmetry {q : ℕ} [NeZero q] (hq : Odd q)
    (cutoff : ℝ → ℝ) {L : ℝ≥0} (hLip : LipschitzWith L cutoff)
    (hb0 : ∀ x, 0 ≤ cutoff x) (hb1 : ∀ x, cutoff x ≤ 1)
    (hbone : ∀ x, |x| ≤ 1 / 2 → cutoff x = 1)
    (hsupp : ∀ x, 1 ≤ |x| → cutoff x = 0) (S : Finset (ZMod q))
    {r ρ ζ : ℝ} (hr : 0 < r) (hrρ : r ≤ ρ / 100) (hρ1 : ρ < 1) (hζ : 0 < ζ)
    (M : ZMod q → ZMod q)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    (a b c : ZMod q → ℂ) (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1)
    (hc : ∀ x, ‖c x‖ ≤ 1)
    (hcorr : ζ ≤ ‖graphLocalCorrelation (graphBohrWeight cutoff S r) M a b c‖) :
    ∃ S' : Finset (ZMod q), ∃ t : ℝ, S ⊆ S' ∧ 0 < t ∧ t < r ∧
      (∀ x ∈ graphBohrSet S' t, ∀ y ∈ graphBohrSet S' t,
        ‖graphAlternatingPhase M x y‖ ≤ ζ / 1000) ∧
      (S'.card : ℝ) + Real.log (1 / t) ≤
        (10 ^ 30 * (max (L : ℝ) 1 + 10000) ^ 4) * graphSymmetryBudget S.card r ζ ^ 8 := by
  let C := max (L : ℝ) 1
  have hC : 0 ≤ C := le_trans zero_le_one (le_max_right _ _)
  let s := localSymmetryInnerRadius C S.card r ζ
  have hrsmall : r < 1 / 8 := by linarith
  have hr1 : r ≤ 1 := by linarith
  have hw (u : ZMod q) : |graphBohrWeight cutoff S r u| ≤ 1 := by
    rw [abs_of_nonneg (graphBohrWeight_bounds cutoff hb0 hb1 S r u).1]
    exact (graphBohrWeight_bounds cutoff hb0 hb1 S r u).2
  have hζ1 := hcorr.trans
    (graphLocalCorrelation_norm_le (graphBohrWeight cutoff S r) hw M a b c ha hb hc)
  obtain ⟨hs, hsr, htol⟩ := localSymmetryInnerRadius_bounds hC hr hζ S.card
  obtain ⟨hdom, h8s, _⟩ := localSymmetryInnerRadius_domain hC hr hζ S.card hrρ
  change 0 < s at hs
  change s ≤ r / 100 at hsr
  change r + 2 * s < ρ at hdom
  change 8 * s < ρ at h8s
  obtain ⟨S', t, hSS', ht, hts, hsym, hcost⟩ := graph_local_symmetry_at_radius hq
    cutoff hLip hb0 hb1 hbone hsupp S hr hrsmall hs (by linarith) hdom.le
    (by linarith) hζ htol M hadd a b c ha hb hc hcorr
  have hssmall : s < 1 / 8 := by linarith
  have hβ := graphBohrMass_pos cutoff hb0 hb1 hbone S hs hssmall
  obtain ⟨hβlower, hβ1⟩ := graphBohrMass_bounds cutoff hb0 hb1 hbone S hs hssmall
  refine ⟨S', t, hSS', ht, by linarith, hsym, ?_⟩
  exact hcost.trans (graph_symmetry_complexity_bound S.card hC hr hr1 hζ hζ1 hβ hβ1 hβlower)

/-- Blueprint `lem:local-symmetry`: a fixed smooth cutoff admits a uniform polynomial
 local-symmetry theorem. The exponent eight and the constant are independent of the modulus,
 frequencies, radius and correlation. Only additivity in the stated Bohr domain is used. -/
theorem local_symmetry (cutoff : ℝ → ℝ) (hcont : ContDiff ℝ 1 cutoff)
    (hb0 : ∀ x, 0 ≤ cutoff x) (hb1 : ∀ x, cutoff x ≤ 1)
    (hbone : ∀ x, |x| ≤ 1 / 2 → cutoff x = 1)
    (hsupp : ∀ x, 1 ≤ |x| → cutoff x = 0) :
    ∃ C : ℝ, 0 < C ∧ ∀ (q : ℕ) [NeZero q], Odd q →
      ∀ (S : Finset (ZMod q)) (r ρ ζ : ℝ), 0 < r → r ≤ ρ / 100 → ρ < 1 → 0 < ζ →
      ∀ M : ZMod q → ZMod q,
        (∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
          x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y) →
      ∀ a b c : ZMod q → ℂ, (∀ x, ‖a x‖ ≤ 1) → (∀ x, ‖b x‖ ≤ 1) → (∀ x, ‖c x‖ ≤ 1) →
        ζ ≤ ‖graphLocalCorrelation (graphBohrWeight cutoff S r) M a b c‖ →
      ∃ S' : Finset (ZMod q), ∃ t : ℝ, S ⊆ S' ∧ 0 < t ∧ t < r ∧
        (∀ x ∈ graphBohrSet S' t, ∀ y ∈ graphBohrSet S' t,
          ‖graphAlternatingPhase M x y‖ ≤ ζ / 1000) ∧
        (S'.card : ℝ) + Real.log (1 / t) ≤ C * graphSymmetryBudget S.card r ζ ^ 8 := by
  obtain ⟨L, hLip⟩ := ContDiff.lipschitzWith_of_hasCompactSupport
    (unit_cutoff_hasCompactSupport cutoff hsupp) hcont (by norm_num)
  refine ⟨10 ^ 30 * (max (L : ℝ) 1 + 10000) ^ 4, by positivity, ?_⟩
  intro q hq hodd S r ρ ζ hr hrρ hρ1 hζ M hadd a b c ha hb hc hcorr
  exact graph_local_symmetry hodd cutoff hLip hb0 hb1 hbone hsupp S
    hr hrρ hρ1 hζ M hadd a b c ha hb hc hcorr

/-- Local additivity along a bounded positive and negative integer path gives the
 expected scalar identity without assuming global additivity. -/
theorem locally_additive_zsmul {G H : Type*} [AddCommGroup G] [AddCommGroup H]
    (U : Set G) (M : G → H) (hM0 : M 0 = 0)
    (hadd : ∀ x ∈ U, ∀ y ∈ U, x + y ∈ U → M (x + y) = M x + M y)
    (v : G) {A : ℤ} (hA : 1 ≤ A)
    (hpath : ∀ k : ℤ, |k| ≤ A → k • v ∈ U) (z : ℤ) (hz : |z| ≤ A) :
    M (z • v) = z • M v := by
  have h0 : (0 : G) ∈ U := by simpa using hpath 0 (by simpa using (show (0 : ℤ) ≤ A by omega))
  have hv : v ∈ U := by simpa using hpath 1 (by simpa using hA)
  have hnatU (n : ℕ) (hn : (n : ℤ) ≤ A) : n • v ∈ U := by
    simpa using hpath n (by simpa using hn)
  have hnat : ∀ n : ℕ, (n : ℤ) ≤ A → M (n • v) = n • M v := by
    intro n
    induction n with
    | zero => intro _; simpa using hM0
    | succ n ih =>
      intro hn
      have hn' : (n : ℤ) ≤ A := by omega
      have hsum : n • v + v ∈ U := by
        simpa only [succ_nsmul] using hnatU (n + 1) hn
      rw [succ_nsmul, hadd _ (hnatU n hn') _ hv hsum, ih hn', succ_nsmul]
  obtain ⟨n, rfl | rfl⟩ := z.eq_nat_or_neg
  · simpa using hnat n (by simpa using hz)
  · have hn : (n : ℤ) ≤ A := by simpa using hz
    have hneg : -(n • v) ∈ U := by simpa using hpath (-(n : ℤ)) hz
    have h := hadd (n • v) (hnatU n hn) (-(n • v)) hneg (by simpa using h0)
    rw [add_neg_cancel, hM0] at h
    have he : M (-(n • v)) = -M (n • v) := by
      apply eq_neg_iff_add_eq_zero.mpr
      simpa only [add_comm] using h.symm
    simpa using (he.trans (congrArg Neg.neg (hnat n hn)))

/-- A locally additive map agrees with its linear coordinate formula throughout an
 integer box contained in its domain; blueprint `lem:local-chart`, lines 1043-1047. -/
theorem locally_additive_integer_box {ι G H : Type*} [Fintype ι]
    [AddCommGroup G] [AddCommGroup H] (U : Set G) (M : G → H)
    (hadd : ∀ x ∈ U, ∀ y ∈ U, x + y ∈ U → M (x + y) = M x + M y)
    (v : ι → G) (A : ι → ℤ) (hA : ∀ i, 0 ≤ A i)
    (hbox : ∀ z : ι → ℤ, (∀ i, |z i| ≤ A i) → (∑ i, z i • v i) ∈ U)
    (z : ι → ℤ) (hz : ∀ i, |z i| ≤ A i) :
    M (∑ i, z i • v i) = ∑ i, z i • M (v i) := by
  classical
  have h0 : (0 : G) ∈ U := by
    have h := hbox 0 (fun i => by simpa using (show (0 : ℤ) ≤ A i by linarith [hA i]))
    simpa using h
  have hM0 : M 0 = 0 := by
    have h := hadd 0 h0 0 h0 (by simpa using h0)
    simp only [zero_add] at h
    have he : M 0 + M 0 = M 0 + 0 := by simpa using h.symm
    exact add_left_cancel he
  have hsingle (i : ι) (k : ℤ) (hk : |k| ≤ A i) : k • v i ∈ U := by
    have h := hbox (Pi.single i k) (fun j => ?_)
    · simpa [Pi.single_apply, ite_smul] using h
    · by_cases hj : j = i
      · subst j
        simpa using hk
      · simp [hj]
        linarith [hA j]
  have hpart (J : Finset ι) : (∑ i ∈ J, z i • v i) ∈ U := by
    have h := hbox (fun i => if i ∈ J then z i else 0) (fun i => ?_)
    · simpa only [ite_smul, zero_smul, Finset.sum_ite_mem, Finset.univ_inter] using h
    · split_ifs
      · exact hz i
      · simpa using (show (0 : ℤ) ≤ A i by linarith [hA i])
  have hsum (J : Finset ι) : M (∑ i ∈ J, z i • v i) = ∑ i ∈ J, z i • M (v i) := by
    induction J using Finset.induction_on with
    | empty => simpa using hM0
    | @insert i J hi ih =>
      have htotal : z i • v i + ∑ j ∈ J, z j • v j ∈ U := by
        simpa only [Finset.sum_insert hi] using hpart (insert i J)
      have hscalar : M (z i • v i) = z i • M (v i) := by
        by_cases hzi : z i = 0
        · simp [hzi, hM0]
        · have hAi : 1 ≤ A i := by
            have hp : 0 < |z i| := abs_pos.mpr hzi
            have := hz i
            omega
          exact locally_additive_zsmul U M hM0 hadd (v i) hAi (hsingle i) (z i) (hz i)
      rw [Finset.sum_insert hi, Finset.sum_insert hi,
        hadd _ (hsingle i (z i) (hz i)) _ (hpart J) htotal, ih, hscalar]
  exact hsum Finset.univ

/-- The product of two integer linear forms in a cyclic group is the reduction modulo
 one of the corresponding ordinary real quadratic polynomial. -/
theorem cyclic_linear_quadratic_phase {ι : Type*} [Fintype ι] {q : ℕ} [NeZero q]
    (m v : ι → ZMod q) (z : ι → ℤ) :
    ZMod.toAddCircle ((∑ i, z i • m i) * (∑ i, z i • v i)) =
      (((∑ i, (z i : ℝ) * ((m i).val : ℝ)) *
        (∑ i, (z i : ℝ) * ((v i).val : ℝ)) / q : ℝ) : UnitAddCircle) := by
  have hcast (f : ι → ZMod q) : ((∑ i, z i * ((f i).val : ℤ) : ℤ) : ZMod q) =
      ∑ i, z i • f i := by simp [zsmul_eq_mul]
  rw [← hcast m, ← hcast v, ← Int.cast_mul, ZMod.toAddCircle_intCast]
  congr 1
  simp

theorem finite_weighted_set_average {G : Type*} [Fintype G] [AddCommGroup G]
    (H : Finset G) (w : G → ℝ) :
    (𝔼 x, 𝔼 h, w h * (Set.indicator (H : Set G) 1 (x + h) : ℝ)) =
      (H.dens : ℝ) * (𝔼 h, w h) := by
  classical
  have hs (h : G) :
      (𝔼 x, (Set.indicator (H : Set G) 1 (x + h) : ℝ)) = (H.dens : ℝ) := by
    exact (Fintype.expect_equiv (Equiv.addRight h) _ _ (fun _ => rfl)).trans
      (Finset.expect_indicator_one H)
  rw [Finset.expect_comm]
  simp only [← Finset.mul_expect, hs, ← Finset.expect_mul]
  exact mul_comm _ _

theorem finite_weighted_set_translate {G : Type*} [Fintype G] [AddCommGroup G]
    (H : Finset G) (w : G → ℝ)
    (hpos : 0 < (H.dens : ℝ) * (𝔼 h, w h)) :
    ∃ x h₀, (H.dens : ℝ) * (𝔼 h, w h) ≤
      (𝔼 h, w h * (Set.indicator (H : Set G) 1 (x + h) : ℝ)) ∧
      0 < w h₀ ∧ x + h₀ ∈ H := by
  classical
  obtain ⟨x, _, hx⟩ := Finset.exists_le_of_le_expect Finset.univ_nonempty
    (finite_weighted_set_average H w).ge
  obtain ⟨h, _, hh⟩ := Finset.exists_lt_of_lt_expect Finset.univ_nonempty (hpos.trans_le hx)
  have hmem : x + h ∈ H := by
    by_contra hn
    simp [Set.indicator_of_notMem hn] at hh
  refine ⟨x, h, hx, ?_, hmem⟩
  simpa [Set.indicator_of_mem hmem] using hh

theorem graph_frequency_affine_on_translate {q : ℕ} [NeZero q]
    (H S : Finset (ZMod q)) (ξ M : ZMod q → ZMod q) {r ρ : ℝ}
    (hr : 0 ≤ r) (hρ : 2 * r ≤ ρ)
    (hadd : ∀ u ∈ graphBohrSet S ρ, ∀ v ∈ graphBohrSet S ρ,
      u + v ∈ graphBohrSet S ρ → M (u + v) = M u + M v)
    (hdiff : ∀ u ∈ H, ∀ v ∈ H, u - v ∈ graphBohrSet S ρ →
      ξ u - ξ v = 2 * M (u - v))
    {x h₀ h : ZMod q} (h₀H : x + h₀ ∈ H) (hhH : x + h ∈ H)
    (h₀B : h₀ ∈ graphBohrSet S r) (hhB : h ∈ graphBohrSet S r) :
    ξ (x + h) = (ξ (x + h₀) - 2 * M h₀) + 2 * M h := by
  have hb : h - h₀ ∈ graphBohrSet S ρ :=
    graphBohrSet_mono (Finset.Subset.refl S) (by linarith : r + r ≤ ρ)
      (graphBohrSet_sub S hhB h₀B)
  have he := hdiff (x + h) hhH (x + h₀) h₀H (by simpa only [add_sub_add_left_eq_sub] using hb)
  rw [add_sub_add_left_eq_sub, graph_local_additive_sub S M hr hρ hadd hhB h₀B] at he
  linear_combination he

theorem complex_phase_alignment (z : ℂ) :
    ∃ c : ℂ, ‖c‖ = 1 ∧ c * z = (‖z‖ : ℂ) := by
  by_cases hz : z = 0
  · exact ⟨1, by simp, by simp [hz]⟩
  have hn : ‖z‖ ≠ 0 := norm_ne_zero_iff.mpr hz
  refine ⟨conj z / (‖z‖ : ℂ), ?_, ?_⟩
  · simp [hn]
  · rw [div_mul_eq_mul_div, Complex.conj_mul']
    field_simp

theorem finite_supported_phase_alignment {G : Type*}
    (P : G → Prop) [DecidablePred P] (z : G → ℂ) :
    ∃ c : G → ℂ, (∀ h, ‖c h‖ ≤ 1) ∧
      (∀ h, P h → ‖c h‖ = 1) ∧ (∀ h, ¬ P h → c h = 0) ∧
      ∀ h, c h * z h = (if P h then (‖z h‖ : ℂ) else 0) := by
  classical
  choose a ha he using fun h => complex_phase_alignment (z h)
  refine ⟨fun h => if P h then a h else 0, ?_, ?_, ?_, ?_⟩
  · intro h
    dsimp only
    split_ifs <;> simp [ha]
  · intro h hh
    simp [hh, ha]
  · intro h hh
    simp [hh]
  · intro h
    dsimp only
    split_ifs <;> simp [he]

theorem finite_weighted_phase_lower_bound {G : Type*} [Fintype G]
    (P : G → Prop) [DecidablePred P] (w : G → ℝ) (z c : G → ℂ)
    (hw : ∀ h, 0 ≤ w h)
    (hc : ∀ h, c h * z h = if P h then (‖z h‖ : ℂ) else 0)
    {a : ℝ} (hz : ∀ h, P h → a ≤ ‖z h‖) :
    a * (𝔼 h, w h * (if P h then 1 else 0)) ≤
      ‖𝔼 h, (w h : ℂ) * (c h * z h)‖ := by
  have he : (𝔼 h, (w h : ℂ) * (c h * z h)) =
      ((𝔼 h, w h * (if P h then ‖z h‖ else 0)) : ℝ) := by
    rw [finite_expect_ofReal]
    apply Finset.expect_congr rfl
    intro h _
    rw [hc]
    split_ifs <;> simp
  rw [he, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg]
  · rw [Finset.mul_expect]
    apply Finset.expect_le_expect
    intro h _
    split_ifs with hh
    · simpa [mul_comm a] using mul_le_mul_of_nonneg_left (hz h hh) (hw h)
    · simp
  · apply Finset.expect_nonneg
    intro h _
    exact mul_nonneg (hw h) (by split_ifs <;> positivity)

theorem graph_initial_phase_correlation {q : ℕ} [NeZero q]
    (P : ZMod q → Prop) [DecidablePred P] (w : ZMod q → ℝ)
    (hw : ∀ h, 0 ≤ w h) (f : ZMod q → ℂ)
    (M : ZMod q → ZMod q) (x₀ ξ₀ : ZMod q) {a : ℝ}
    (hcor : ∀ h, P h → a ≤ ‖𝔼 x,
      f (x + h + x₀) * conj (f x) *
        ZMod.stdAddChar (-((ξ₀ + 2 * M h) * x))‖) :
    ∃ c : ZMod q → ℂ, (∀ h, ‖c h‖ ≤ 1) ∧
      (∀ h, ¬ P h → c h = 0) ∧
      a * (𝔼 h, w h * (if P h then 1 else 0)) ≤
        ‖graphLocalCorrelation w M (fun x => f (x + x₀))
          (fun x => conj (f x) * ZMod.stdAddChar (-(ξ₀ * x))) c‖ := by
  let z := fun h => 𝔼 x, f (x + h + x₀) * conj (f x) *
    ZMod.stdAddChar (-((ξ₀ + 2 * M h) * x))
  obtain ⟨c, hc, _, hc0, hcz⟩ := finite_supported_phase_alignment P z
  refine ⟨c, hc, hc0, ?_⟩
  have he : graphLocalCorrelation w M (fun x => f (x + x₀))
      (fun x => conj (f x) * ZMod.stdAddChar (-(ξ₀ * x))) c =
      𝔼 h, (w h : ℂ) * (c h * z h) := by
    unfold graphLocalCorrelation
    apply Finset.expect_congr rfl
    intro h _
    dsimp [z]
    rw [Finset.mul_expect, Finset.mul_expect]
    apply Finset.expect_congr rfl
    intro x _
    have hch : ZMod.stdAddChar (-((ξ₀ + 2 * M h) * x)) =
        ZMod.stdAddChar (-(ξ₀ * x)) * ZMod.stdAddChar (-(2 * M h * x)) := by
      rw [show -((ξ₀ + 2 * M h) * x) = -(ξ₀ * x) + -(2 * M h * x) by ring,
        AddChar.map_add_eq_mul]
    rw [hch]
    ring
  rw [he]
  exact finite_weighted_phase_lower_bound P w z c hw hcz hcor

theorem graph_initial_correlation_from_derivatives {q : ℕ} [NeZero q]
    (H S : Finset (ZMod q)) (ξ M : ZMod q → ZMod q)
    (w : ZMod q → ℝ) (f : ZMod q → ℂ) {r ρ a : ℝ}
    (hr : 0 ≤ r) (hρ : 2 * r ≤ ρ) (ha : 0 ≤ a)
    (hw : ∀ h, 0 ≤ w h)
    (hsupp : ∀ h, w h ≠ 0 → h ∈ graphBohrSet S r)
    (hpos : 0 < (H.dens : ℝ) * (𝔼 h, w h))
    (hadd : ∀ u ∈ graphBohrSet S ρ, ∀ v ∈ graphBohrSet S ρ,
      u + v ∈ graphBohrSet S ρ → M (u + v) = M u + M v)
    (hdiff : ∀ u ∈ H, ∀ v ∈ H, u - v ∈ graphBohrSet S ρ →
      ξ u - ξ v = 2 * M (u - v))
    (hcor : ∀ h ∈ H, a ≤ ‖𝔼 x,
      f (x + h) * conj (f x) * ZMod.stdAddChar (-(ξ h * x))‖) :
    ∃ (x₀ ξ₀ : ZMod q) (c : ZMod q → ℂ),
      (∀ h, ‖c h‖ ≤ 1) ∧
      a * ((H.dens : ℝ) * (𝔼 h, w h)) ≤
        ‖graphLocalCorrelation w M (fun x => f (x + x₀))
          (fun x => conj (f x) * ZMod.stdAddChar (-(ξ₀ * x))) c‖ := by
  classical
  obtain ⟨x₀, h₀, hx₀, hw₀, hH₀⟩ := finite_weighted_set_translate H w hpos
  let ξ₀ := ξ (x₀ + h₀) - 2 * M h₀
  let P := fun h => 0 < w h ∧ x₀ + h ∈ H
  have haf (h) (hh : P h) : ξ (x₀ + h) = ξ₀ + 2 * M h :=
    graph_frequency_affine_on_translate H S ξ M hr hρ hadd hdiff hH₀ hh.2
      (hsupp h₀ hw₀.ne') (hsupp h hh.1.ne')
  have hder (h) (hh : P h) : a ≤ ‖𝔼 x,
      f (x + h + x₀) * conj (f x) *
        ZMod.stdAddChar (-((ξ₀ + 2 * M h) * x))‖ := by
    have he := hcor (x₀ + h) hh.2
    rw [haf h hh] at he
    simpa only [add_comm x₀ h, add_assoc] using he
  obtain ⟨c, hc, _, hcl⟩ := graph_initial_phase_correlation P w hw f M x₀ ξ₀ hder
  refine ⟨x₀, ξ₀, c, hc, (mul_le_mul_of_nonneg_left ?_ ha).trans hcl⟩
  convert hx₀ using 1
  apply Finset.expect_congr rfl
  intro h _
  by_cases hz : w h = 0
  · simp [hz]
  · have hp : 0 < w h := lt_of_le_of_ne (hw h) (Ne.symm hz)
    by_cases hh : x₀ + h ∈ H <;> simp [P, hp, hh]

theorem graph_initial_correlation_log (d N : ℕ) {δ ρ α β K : ℝ}
    (hδ : 0 < δ) (hρ : 0 < ρ) (hK : 0 < K)
    (hα : δ ^ N / K ≤ α) (hβ : (ρ / 600) ^ d ≤ β) :
    Real.log (1 / (δ ^ 4 * α * β / Real.sqrt 2)) ≤
      (N + 4 : ℝ) * Real.log (1 / δ) + Real.log K + Real.log (Real.sqrt 2) +
        d * (Real.log 600 + Real.log (1 / ρ)) := by
  have hαpos : 0 < α := (div_pos (pow_pos hδ N) hK).trans_le hα
  have hβpos : 0 < β := (pow_pos (div_pos hρ (by norm_num)) d).trans_le hβ
  have hla := Real.log_le_log (div_pos (pow_pos hδ N) hK) hα
  have hlb := Real.log_le_log (pow_pos (div_pos hρ (by norm_num)) d) hβ
  rw [Real.log_div (pow_ne_zero N hδ.ne') hK.ne', Real.log_pow] at hla
  rw [Real.log_pow, Real.log_div hρ.ne' (by norm_num : (600 : ℝ) ≠ 0)] at hlb
  rw [one_div, Real.log_inv,
    Real.log_div (by positivity : δ ^ 4 * α * β ≠ 0) (by positivity : Real.sqrt 2 ≠ 0),
    Real.log_mul (by positivity : δ ^ 4 * α ≠ 0) hβpos.ne',
    Real.log_mul (pow_ne_zero 4 hδ.ne') hαpos.ne', Real.log_pow]
  simp only [one_div, Real.log_inv, Nat.cast_ofNat]
  nlinarith

theorem graph_initial_correlation_log_budget (d N : ℕ) {δ ρ α β K A B : ℝ}
    (hδ : 0 < δ) (hρ : 0 < ρ) (hρ1 : ρ ≤ 1) (hK : 0 < K)
    (hα : δ ^ N / K ≤ α) (hβ : (ρ / 600) ^ d ≤ β)
    (hA : 1 ≤ A) (hB : 1 ≤ B) (hδB : Real.log (1 / δ) ≤ B)
    (hd : (d : ℝ) + Real.log (1 / ρ) ≤ A * B ^ 4) :
    Real.log (1 / (δ ^ 4 * α * β / Real.sqrt 2)) ≤
      ((N : ℝ) + 4 + K + 2 + 600 * A + A ^ 2) * B ^ 8 := by
  have hlog := graph_initial_correlation_log d N hδ hρ hK hα hβ
  have hL : 0 ≤ Real.log (1 / ρ) :=
    Real.log_nonneg ((one_le_div hρ).mpr hρ1)
  have hd0 : (0 : ℝ) ≤ d := Nat.cast_nonneg d
  have hdA : (d : ℝ) ≤ A * B ^ 4 := by linarith
  have hLA : Real.log (1 / ρ) ≤ A * B ^ 4 := by linarith
  have hp := mul_le_mul hdA hLA hL (by positivity : 0 ≤ A * B ^ 4)
  have he : (A * B ^ 4) * (A * B ^ 4) = A ^ 2 * B ^ 8 := by ring
  rw [he] at hp
  have h600 := Real.log_le_self (by norm_num : (0 : ℝ) ≤ 600)
  have h600d := mul_le_mul_of_nonneg_left h600 hd0
  have hKlog := Real.log_le_self hK.le
  have hslog : Real.log (Real.sqrt 2) ≤ 2 := by
    have hl := Real.log_le_self (Real.sqrt_nonneg 2)
    have hs : Real.sqrt 2 ≤ 2 := by
      exact (Real.sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
    exact hl.trans hs
  have hδmul := mul_le_mul_of_nonneg_left hδB (by positivity : 0 ≤ (N : ℝ) + 4)
  have hB8 : B ≤ B ^ 8 := by simpa using pow_le_pow_right₀ hB (by norm_num : 1 ≤ 8)
  have hB48 : B ^ 4 ≤ B ^ 8 := pow_le_pow_right₀ hB (by norm_num : 4 ≤ 8)
  have hB80 : 1 ≤ B ^ 8 := one_le_pow₀ hB
  have hN := mul_le_mul_of_nonneg_left hB8 (by positivity : 0 ≤ (N : ℝ) + 4)
  have hC := mul_le_mul_of_nonneg_left hB80 (by positivity : 0 ≤ K + 2)
  have hD := mul_le_mul_of_nonneg_left hB48 (by positivity : 0 ≤ 600 * A)
  nlinarith only [hK, hA, hB, hδB, hd, hlog, hL, h600, hKlog, hslog, hB8, hB48]

theorem finite_weighted_shift_error {G : Type*} [Fintype G] [AddCommGroup G]
    (w μ : G → ℝ) (hμ : ∀ t, 0 ≤ μ t) (hμmass : (𝔼 t, μ t) = 1)
    (F : G → ℂ) (hF : ∀ h, ‖F h‖ ≤ 1) {ε : ℝ}
    (htrans : ∀ h t, μ t ≠ 0 → |w (h + t) - w h| ≤ ε) :
    ‖(𝔼 h, (w h : ℂ) * F h) -
      (𝔼 h, (w h : ℂ) * (𝔼 t, (μ t : ℂ) * F (h + t)))‖ ≤ ε := by
  have he := finite_weighted_shift_average μ hμmass (fun h => (w h : ℂ) * F h)
  rw [← he]
  simp only [Finset.mul_expect, ← Finset.expect_sub_distrib]
  calc
    _ ≤ 𝔼 h, ‖𝔼 t, ((μ t : ℂ) * ((w (h + t) : ℂ) * F (h + t)) -
        (w h : ℂ) * ((μ t : ℂ) * F (h + t)))‖ := RCLike.norm_expect_le (K := ℂ)
    _ ≤ 𝔼 h, 𝔼 t, μ t * ε := by
      apply Finset.expect_le_expect
      intro h _
      apply (RCLike.norm_expect_le (K := ℂ)).trans
      apply Finset.expect_le_expect
      intro t _
      by_cases ht : μ t = 0
      · simp [ht]
      · have hc : (μ t : ℂ) * ((w (h + t) : ℂ) * F (h + t)) -
            (w h : ℂ) * ((μ t : ℂ) * F (h + t)) =
            (μ t : ℂ) * ((w (h + t) - w h : ℝ) : ℂ) * F (h + t) := by
          push_cast
          ring
        rw [hc, norm_mul, norm_mul, Complex.norm_real, Real.norm_of_nonneg (hμ t),
          Complex.norm_real, Real.norm_eq_abs]
        have hp : |w (h + t) - w h| * ‖F (h + t)‖ ≤ ε := by
          simpa only [mul_one] using mul_le_mul (htrans h t ht) (hF (h + t))
            (norm_nonneg _) ((abs_nonneg _).trans (htrans h t ht))
        simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hp (hμ t)
    _ = ε := by simp only [← Finset.expect_mul, hμmass, one_mul, Fintype.expect_const]

theorem finite_weighted_shift_select {G : Type*} [Fintype G] [AddCommGroup G]
    (w μ : G → ℝ) (hw : ∀ h, 0 ≤ w h) (hwmass : (𝔼 h, w h) ≤ 1)
    (hμ : ∀ t, 0 ≤ μ t) (hμmass : (𝔼 t, μ t) = 1)
    (F : G → ℂ) (hF : ∀ h, ‖F h‖ ≤ 1) {ζ ε : ℝ} (hζ : ε < ζ)
    (hcorr : ζ ≤ ‖𝔼 h, (w h : ℂ) * F h‖)
    (htrans : ∀ h t, μ t ≠ 0 → |w (h + t) - w h| ≤ ε) :
    ∃ h, w h ≠ 0 ∧ ζ - ε ≤ ‖𝔼 t, (μ t : ℂ) * F (h + t)‖ := by
  apply finite_weighted_correlation_select w hw hwmass _ (sub_pos.mpr hζ)
  have herr := finite_weighted_shift_error w μ hμ hμmass F hF htrans
  have hn := norm_le_norm_sub_add (𝔼 h, (w h : ℂ) * F h)
    (𝔼 h, (w h : ℂ) * (𝔼 t, (μ t : ℂ) * F (h + t)))
  linarith

theorem graph_local_shift_select {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (hw : ∀ h, 0 ≤ w h) (hwmass : (𝔼 h, w h) ≤ 1)
    (hμ : ∀ t, 0 ≤ μ t) (hμmass : (𝔼 t, μ t) = 1)
    (M : ZMod q → ZMod q) (a b c : ZMod q → ℂ)
    (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1) (hc : ∀ x, ‖c x‖ ≤ 1)
    {ζ ε : ℝ} (hζ : ε < ζ) (hcorr : ζ ≤ ‖graphLocalCorrelation w M a b c‖)
    (htrans : ∀ h t, μ t ≠ 0 → |w (h + t) - w h| ≤ ε)
    (hadd : ∀ h, w h ≠ 0 → ∀ t, μ t ≠ 0 → M (h + t) = M h + M t) :
    ∃ h, w h ≠ 0 ∧ ζ - ε ≤
      ‖graphLocalCorrelation μ M (fun x => a (x + h))
        (fun x => b x * ZMod.stdAddChar (-(2 * M h * x))) (fun t => c (h + t))‖ := by
  let F := fun h => c h * (𝔼 x, a (x + h) * b x * ZMod.stdAddChar (-(2 * M h * x)))
  have hF (h) : ‖F h‖ ≤ 1 := by
    have hi : ‖𝔼 x, a (x + h) * b x * ZMod.stdAddChar (-(2 * M h * x))‖ ≤ 1 := by
      apply (RCLike.norm_expect_le (K := ℂ)).trans
      apply Finset.expect_le Finset.univ_nonempty
      intro x _
      simp only [norm_mul, ZMod.stdAddChar_apply, Circle.norm_coe, mul_one]
      exact (mul_le_mul (ha _) (hb _) (norm_nonneg _) zero_le_one).trans_eq (mul_one 1)
    dsimp [F]
    rw [norm_mul]
    exact (mul_le_mul (hc h) hi (norm_nonneg _) zero_le_one).trans_eq (mul_one 1)
  have hcorr' : ζ ≤ ‖𝔼 h, (w h : ℂ) * F h‖ := by
    simpa only [graphLocalCorrelation, F, ← Finset.mul_expect, mul_assoc] using hcorr
  obtain ⟨h, hwh, hsel⟩ := finite_weighted_shift_select w μ hw hwmass hμ hμmass F hF
    hζ hcorr' htrans
  refine ⟨h, hwh, ?_⟩
  convert hsel using 1
  congr 1
  unfold graphLocalCorrelation
  apply Finset.expect_congr rfl
  intro t _
  dsimp [F]
  rw [Finset.mul_expect, Finset.mul_expect]
  apply Finset.expect_congr rfl
  intro x _
  by_cases ht : μ t = 0
  · simp [ht]
  · have hch : ZMod.stdAddChar (-(2 * M (h + t) * x)) =
        ZMod.stdAddChar (-(2 * M h * x)) * ZMod.stdAddChar (-(2 * M t * x)) := by
      rw [hadd h hwh t ht,
        show -(2 * (M h + M t) * x) = -(2 * M h * x) + -(2 * M t * x) by ring,
        AddChar.map_add_eq_mul]
    rw [hch]
    simp only [add_assoc, add_comm t h]
    ring

theorem graph_bohr_shift_select {q : ℕ} [NeZero q]
    (cutoff : ℝ → ℝ) {L : ℝ≥0} (hLip : LipschitzWith L cutoff)
    (hb0 : ∀ x, 0 ≤ cutoff x) (hb1 : ∀ x, cutoff x ≤ 1)
    (hbone : ∀ x, |x| ≤ 1 / 2 → cutoff x = 1)
    (hsupp : ∀ x, 1 ≤ |x| → cutoff x = 0)
    (S T : Finset (ZMod q)) (hST : S ⊆ T) {r s ρ ζ : ℝ}
    (hr : 0 < r) (hrsmall : r < 1 / 8) (hs : 0 < s) (hsr : s ≤ r)
    (hrρ : r + s ≤ ρ) (hζ : 0 < ζ)
    (herror : max (L : ℝ) 1 * S.card * s / r ≤ ζ / 100)
    (M : ZMod q → ZMod q)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    (a b c : ZMod q → ℂ) (ha : ∀ x, ‖a x‖ ≤ 1)
    (hb : ∀ x, ‖b x‖ ≤ 1) (hc : ∀ x, ‖c x‖ ≤ 1)
    (hcorr : ζ ≤ ‖graphLocalCorrelation (graphBohrWeight cutoff S r) M a b c‖) :
    ∃ h ∈ graphBohrSet S r, ζ / 2 ≤
      ‖graphLocalCorrelation (graphBohrMeasure cutoff T s) M (fun x => a (x + h))
        (fun x => b x * ZMod.stdAddChar (-(2 * M h * x))) (fun t => c (h + t))‖ := by
  have hmass := graphBohrMass_pos cutoff hb0 hb1 hbone T hs (hsr.trans_lt hrsmall)
  have hμsupp (t) (ht : graphBohrMeasure cutoff T s t ≠ 0) : t ∈ graphBohrSet S s := by
    apply graphBohrSet_mono hST le_rfl
    by_contra hn
    exact ht (graphBohrMeasure_eq_zero_of_notMem cutoff hsupp T hs t hn)
  have hwsupp (h) (hh : graphBohrWeight cutoff S r h ≠ 0) : h ∈ graphBohrSet S r := by
    by_contra hn
    exact hh (graphBohrWeight_eq_zero_of_notMem cutoff hsupp S hr h hn)
  have htrans (h t) (ht : graphBohrMeasure cutoff T s t ≠ 0) :
      |graphBohrWeight cutoff S r (h + t) - graphBohrWeight cutoff S r h| ≤ ζ / 100 := by
    have hv := cyclicBohrWeight_translation cutoff hLip hb0 hb1 hsupp S hr hrsmall h t
    change |graphBohrWeight cutoff S r (h + t) - graphBohrWeight cutoff S r h| ≤
      max (L : ℝ) 1 * S.card * graphBohrNorm S t / r at hv
    apply hv.trans
    apply le_trans _ herror
    apply div_le_div_of_nonneg_right _ hr.le
    exact mul_le_mul_of_nonneg_left (graphBohrNorm_le_of_mem S hs.le (hμsupp t ht))
      (by positivity)
  have hlocal (h) (hh : graphBohrWeight cutoff S r h ≠ 0)
      (t) (ht : graphBohrMeasure cutoff T s t ≠ 0) : M (h + t) = M h + M t := by
    exact hadd h (graphBohrSet_mono (Finset.Subset.refl S) (by linarith : r ≤ ρ) (hwsupp h hh))
      t (graphBohrSet_mono (Finset.Subset.refl S) (by linarith : s ≤ ρ) (hμsupp t ht))
      (graphBohrSet_mono (Finset.Subset.refl S) hrρ
        (graphBohrSet_add S (hwsupp h hh) (hμsupp t ht)))
  obtain ⟨h, hh, hsel⟩ := graph_local_shift_select (graphBohrWeight cutoff S r)
    (graphBohrMeasure cutoff T s) (fun h => (graphBohrWeight_bounds cutoff hb0 hb1 S r h).1)
    (graphBohrMass_bounds cutoff hb0 hb1 hbone S hr hrsmall).2
    (graphBohrMeasure_nonneg cutoff hb0 T s hmass)
    (graphBohrMeasure_mean_one cutoff T s hmass) M a b c ha hb hc
    (by linarith : ζ / 100 < ζ) hcorr htrans hlocal
  exact ⟨h, hwsupp h hh, (by linarith : ζ / 2 ≤ ζ - ζ / 100).trans hsel⟩

theorem graph_correlation_localization_explicit {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (hμ : (𝔼 u, μ u) = 1) (M : ZMod q → ZMod q)
    (a b c : ZMod q → ℂ) {ζ : ℝ} (hζ : ζ ≤ ‖graphLocalCorrelation w M a b c‖) :
    ∃ y : ZMod q, ζ ≤ ‖graphLocalizedCorrelation w μ M
      (fun x => a (x + y)) (fun x => b (x + y))
      (fun h => c h * ZMod.stdAddChar (-(2 * M h * y)))‖ := by
  let F : ZMod q → ZMod q → ℂ := fun h x => (w h : ℂ) * c h *
    (a (x + h) * b x * ZMod.stdAddChar (-(2 * M h * x)))
  obtain ⟨y, hy⟩ := finite_weighted_translation_localization μ hμ F hζ
  refine ⟨y, ?_⟩
  have he : graphLocalizedCorrelation w μ M
      (fun x => a (x + y)) (fun x => b (x + y))
      (fun h => c h * ZMod.stdAddChar (-(2 * M h * y))) =
      𝔼 h, 𝔼 u, (μ u : ℂ) * F h (y + u) := by
    unfold graphLocalizedCorrelation
    apply Finset.expect_congr rfl
    intro h _
    rw [Finset.mul_expect]
    apply Finset.expect_congr rfl
    intro u _
    dsimp [F]
    have hchar : ZMod.stdAddChar (-(2 * M h * (y + u))) =
        ZMod.stdAddChar (-(2 * M h * y)) * ZMod.stdAddChar (-(2 * M h * u)) := by
      rw [show -(2 * M h * (y + u)) = -(2 * M h * y) + -(2 * M h * u) by ring,
        AddChar.map_add_eq_mul]
    rw [hchar]
    simp only [add_left_comm, add_comm]
    ring
  rw [he]
  exact hy

theorem graph_quadratic_polarization {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (u t : ZMod q) (hM : M (u + t) = M u + M t) :
    ZMod.stdAddChar (-(M u * t + M t * u)) =
      ZMod.stdAddChar (M u * u) * ZMod.stdAddChar (M t * t) *
        ZMod.stdAddChar (-(M (u + t) * (u + t))) := by
  rw [← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul, hM]
  congr 1
  ring

theorem graph_skew_character_error {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (u t : ZMod q) :
    ‖ZMod.stdAddChar (-(2 * M t * u)) -
      ZMod.stdAddChar (-(M u * t + M t * u))‖ ≤
      2 * Real.pi * ‖graphAlternatingPhase M u t‖ := by
  have he : ZMod.stdAddChar (-(2 * M t * u)) -
      ZMod.stdAddChar (-(M u * t + M t * u)) =
      ZMod.stdAddChar (-(M u * t + M t * u)) *
        (ZMod.stdAddChar (graphAlternating M u t) - 1) := by
    rw [mul_sub, mul_one, ← AddChar.map_add_eq_mul]
    congr 2
    unfold graphAlternating
    ring
  rw [he, norm_mul]
  simpa only [ZMod.stdAddChar_apply, Circle.norm_coe, one_mul, graphAlternatingPhase]
    using bogolyubov_stdChar_distance (graphAlternating M u t)

theorem graph_localized_polarization_error {q : ℕ} [NeZero q]
    (μ : ZMod q → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hμmass : (𝔼 x, μ x) = 1)
    (M : ZMod q → ZMod q) (D : Set (ZMod q))
    (a b c : ZMod q → ℂ) (ha : ∀ x, ‖a x‖ ≤ 1)
    (hb : ∀ x, ‖b x‖ ≤ 1) (hc : ∀ x, ‖c x‖ ≤ 1) {κ : ℝ}
    (hskew : ∀ u t, μ u ≠ 0 → μ t ≠ 0 → ‖graphAlternatingPhase M u t‖ ≤ κ)
    (hadd : ∀ u t, μ u ≠ 0 → μ t ≠ 0 → M (u + t) = M u + M t)
    (hD : ∀ u t, μ u ≠ 0 → μ t ≠ 0 → u + t ∈ D) :
    ‖graphLocalizedCorrelation μ μ M a b c -
      (𝔼 u, 𝔼 t,
        ((μ u : ℂ) * b u * ZMod.stdAddChar (M u * u)) *
        ((μ t : ℂ) * c t * ZMod.stdAddChar (M t * t)) *
        D.indicator (fun v => a v * ZMod.stdAddChar (-(M v * v))) (u + t))‖ ≤
      2 * Real.pi * κ := by
  classical
  let F := fun u t => c t * a (u + t) * b u *
    (ZMod.stdAddChar (-(2 * M t * u)) - ZMod.stdAddChar (-(M u * t + M t * u)))
  have he : graphLocalizedCorrelation μ μ M a b c -
      (𝔼 u, 𝔼 t,
        ((μ u : ℂ) * b u * ZMod.stdAddChar (M u * u)) *
        ((μ t : ℂ) * c t * ZMod.stdAddChar (M t * t)) *
        D.indicator (fun v => a v * ZMod.stdAddChar (-(M v * v))) (u + t)) =
      𝔼 u, 𝔼 t, (μ u : ℂ) * (μ t : ℂ) * F u t := by
    unfold graphLocalizedCorrelation
    simp only [Finset.mul_expect]
    rw [Finset.expect_comm]
    rw [← Finset.expect_sub_distrib]
    apply Finset.expect_congr rfl
    intro u _
    rw [← Finset.expect_sub_distrib]
    apply Finset.expect_congr rfl
    intro t _
    by_cases hu : μ u = 0
    · simp [hu]
    by_cases ht : μ t = 0
    · simp [ht]
    rw [Set.indicator_of_mem (hD u t hu ht)]
    dsimp only [F]
    rw [graph_quadratic_polarization M u t (hadd u t hu ht)]
    ring
  rw [he]
  apply finite_weighted_pair_norm_le μ hμ hμmass F
  intro u t hu ht
  have habc : ‖c t * a (u + t) * b u‖ ≤ 1 := by
    rw [norm_mul, norm_mul]
    have hca := (mul_le_mul (hc t) (ha (u + t)) (norm_nonneg _) zero_le_one).trans_eq (mul_one 1)
    exact (mul_le_mul hca (hb u) (norm_nonneg _) zero_le_one).trans_eq (mul_one 1)
  dsimp only [F]
  rw [norm_mul]
  apply (mul_le_mul_of_nonneg_right habc (norm_nonneg _)).trans
  rw [one_mul]
  exact (graph_skew_character_error M u t).trans
    (mul_le_mul_of_nonneg_left (hskew u t hu ht) (by positivity))

theorem graph_bohr_polarized_correlation {q : ℕ} [NeZero q]
    (cutoff : ℝ → ℝ) (hb0 : ∀ x, 0 ≤ cutoff x) (hb1 : ∀ x, cutoff x ≤ 1)
    (hbone : ∀ x, |x| ≤ 1 / 2 → cutoff x = 1)
    (hsupp : ∀ x, 1 ≤ |x| → cutoff x = 0) (S : Finset (ZMod q))
    {s ρ ζ : ℝ} (hs : 0 < s) (hs1 : s < 1 / 8) (hsρ : 2 * s ≤ ρ) (hζ : 0 < ζ)
    (M : ZMod q → ZMod q)
    (hadd : ∀ u ∈ graphBohrSet S ρ, ∀ t ∈ graphBohrSet S ρ,
      u + t ∈ graphBohrSet S ρ → M (u + t) = M u + M t)
    (hskew : ∀ u ∈ graphBohrSet S s, ∀ t ∈ graphBohrSet S s,
      ‖graphAlternatingPhase M u t‖ ≤ ζ / 1000)
    (a b c : ZMod q → ℂ) (ha : ∀ x, ‖a x‖ ≤ 1)
    (hb : ∀ x, ‖b x‖ ≤ 1) (hc : ∀ x, ‖c x‖ ≤ 1)
    (hcorr : ζ / 2 ≤ ‖graphLocalizedCorrelation (graphBohrMeasure cutoff S s)
      (graphBohrMeasure cutoff S s) M a b c‖) :
    let μ := graphBohrMeasure cutoff S s
    ζ / 4 ≤ ‖𝔼 u, 𝔼 t,
      ((μ u : ℂ) * b u * ZMod.stdAddChar (M u * u)) *
      ((μ t : ℂ) * c t * ZMod.stdAddChar (M t * t)) *
      (graphBohrSet S (2 * s) : Set (ZMod q)).indicator
        (fun v => a v * ZMod.stdAddChar (-(M v * v))) (u + t)‖ := by
  dsimp only
  let μ := graphBohrMeasure cutoff S s
  have hmass := graphBohrMass_pos cutoff hb0 hb1 hbone S hs hs1
  have hsupport (u) (hu : μ u ≠ 0) : u ∈ graphBohrSet S s := by
    by_contra hn
    exact hu (graphBohrMeasure_eq_zero_of_notMem cutoff hsupp S hs u hn)
  have hlocal (u t) (hu : μ u ≠ 0) (ht : μ t ≠ 0) : M (u + t) = M u + M t := by
    exact hadd u (graphBohrSet_mono (Finset.Subset.refl S) (by linarith : s ≤ ρ) (hsupport u hu))
      t (graphBohrSet_mono (Finset.Subset.refl S) (by linarith : s ≤ ρ) (hsupport t ht))
      (graphBohrSet_mono (Finset.Subset.refl S) (by linarith : s + s ≤ ρ)
        (graphBohrSet_add S (hsupport u hu) (hsupport t ht)))
  have hsum (u t) (hu : μ u ≠ 0) (ht : μ t ≠ 0) : u + t ∈ graphBohrSet S (2 * s) := by
    simpa only [two_mul] using graphBohrSet_add S (hsupport u hu) (hsupport t ht)
  have herr := graph_localized_polarization_error μ
    (graphBohrMeasure_nonneg cutoff hb0 S s hmass)
    (graphBohrMeasure_mean_one cutoff S s hmass) M (graphBohrSet S (2 * s)) a b c ha hb hc
    (fun u t hu ht => hskew u (hsupport u hu) t (hsupport t ht)) hlocal hsum
  have hn := norm_le_norm_sub_add (graphLocalizedCorrelation μ μ M a b c)
    (𝔼 u, 𝔼 t,
      ((μ u : ℂ) * b u * ZMod.stdAddChar (M u * u)) *
      ((μ t : ℂ) * c t * ZMod.stdAddChar (M t * t)) *
      (graphBohrSet S (2 * s) : Set (ZMod q)).indicator
        (fun v => a v * ZMod.stdAddChar (-(M v * v))) (u + t))
  have hp := mul_le_mul_of_nonneg_right Real.pi_lt_four.le hζ.le
  change ζ / 4 ≤ ‖𝔼 u, 𝔼 t,
      ((μ u : ℂ) * b u * ZMod.stdAddChar (M u * u)) *
      ((μ t : ℂ) * c t * ZMod.stdAddChar (M t * t)) *
      (graphBohrSet S (2 * s) : Set (ZMod q)).indicator
        (fun v => a v * ZMod.stdAddChar (-(M v * v))) (u + t)‖
  change ζ / 2 ≤ ‖graphLocalizedCorrelation μ μ M a b c‖ at hcorr
  linarith

theorem graph_bohr_weighted_quadratic_correlation {q : ℕ} [NeZero q]
    (cutoff : ℝ → ℝ) (hb0 : ∀ x, 0 ≤ cutoff x) (hb1 : ∀ x, cutoff x ≤ 1)
    (hbone : ∀ x, |x| ≤ 1 / 2 → cutoff x = 1)
    (hsupp : ∀ x, 1 ≤ |x| → cutoff x = 0) (S : Finset (ZMod q))
    {s ρ ζ : ℝ} (hs : 0 < s) (hs1 : s < 1 / 8) (hsρ : 2 * s ≤ ρ) (hζ : 0 < ζ)
    (M : ZMod q → ZMod q)
    (hadd : ∀ u ∈ graphBohrSet S ρ, ∀ t ∈ graphBohrSet S ρ,
      u + t ∈ graphBohrSet S ρ → M (u + t) = M u + M t)
    (hskew : ∀ u ∈ graphBohrSet S s, ∀ t ∈ graphBohrSet S s,
      ‖graphAlternatingPhase M u t‖ ≤ ζ / 1000)
    (a b c : ZMod q → ℂ) (ha : ∀ x, ‖a x‖ ≤ 1)
    (hb : ∀ x, ‖b x‖ ≤ 1) (hc : ∀ x, ‖c x‖ ≤ 1)
    (hcorr : ζ / 2 ≤ ‖graphLocalizedCorrelation (graphBohrMeasure cutoff S s)
      (graphBohrMeasure cutoff S s) M a b c‖) :
    let β := graphBohrMass cutoff S s
    ∃ ξ : ZMod q, ζ * β * Real.sqrt β / 4 ≤
      ‖𝔼 u, (graphBohrWeight cutoff S s u : ℂ) * b u *
        ZMod.stdAddChar (M u * u - ξ * u)‖ := by
  classical
  dsimp only
  let w := graphBohrWeight cutoff S s
  let β := graphBohrMass cutoff S s
  let B := fun u => b u * ZMod.stdAddChar (M u * u)
  let C := fun t => c t * ZMod.stdAddChar (M t * t)
  let A := (graphBohrSet S (2 * s) : Set (ZMod q)).indicator
    (fun v => a v * ZMod.stdAddChar (-(M v * v)))
  have hβ : 0 < β := graphBohrMass_pos cutoff hb0 hb1 hbone S hs hs1
  have hC (t) : ‖C t‖ ≤ 1 := by
    simpa only [C, norm_mul, ZMod.stdAddChar_apply, Circle.norm_coe, mul_one] using hc t
  have hA (v) : ‖A v‖ ≤ 1 := by
    by_cases hv : v ∈ graphBohrSet S (2 * s)
    · simpa only [A, Set.indicator_of_mem hv, norm_mul, ZMod.stdAddChar_apply,
        Circle.norm_coe, mul_one] using ha v
    · simp [A, Set.indicator_of_notMem hv]
  have hpol := graph_bohr_polarized_correlation cutoff hb0 hb1 hbone hsupp S
    hs hs1 hsρ hζ M hadd hskew a b c ha hb hc hcorr
  have hcorr' : ζ / 4 ≤ ‖𝔼 u, 𝔼 t,
      ((w u / β : ℝ) : ℂ) * B u * (((w t / β : ℝ) : ℂ) * C t) * A (u + t)‖ := by
    convert hpol using 1
    congr 1
    apply Finset.expect_congr rfl
    intro u _
    apply Finset.expect_congr rfl
    intro t _
    dsimp [w, β, B, C, A, graphBohrMeasure]
    ring
  obtain ⟨ξ, hξ⟩ := finite_weighted_trilinear_extract w
    (fun u => (graphBohrWeight_bounds cutoff hb0 hb1 S s u).1)
    (fun u => (graphBohrWeight_bounds cutoff hb0 hb1 S s u).2) hβ rfl B C A hC hA hcorr'
  refine ⟨ξ, ?_⟩
  have he : (𝔼 u, (w u : ℂ) * B u * ZMod.stdAddChar (-(ξ * u))) =
      𝔼 u, (graphBohrWeight cutoff S s u : ℂ) * b u *
        ZMod.stdAddChar (M u * u - ξ * u) := by
    apply Finset.expect_congr rfl
    intro u _
    dsimp [w, B]
    rw [sub_eq_add_neg, AddChar.map_add_eq_mul]
    ring
  rw [he] at hξ
  convert hξ using 1
  dsimp [β]
  ring

theorem graph_quadratic_correlation_recover {q : ℕ} [NeZero q]
    (w : ZMod q → ℝ) (f : ZMod q → ℂ) (M : ZMod q → ZMod q)
    (a y ξ : ZMod q) :
    ‖𝔼 u, (w u : ℂ) * (conj (f (u + y)) * ZMod.stdAddChar (-(a * (u + y)))) *
      ZMod.stdAddChar (M u * u - ξ * u)‖ =
    ‖𝔼 u, (w u : ℂ) * f (u + y) *
      ZMod.stdAddChar (-(M u * u) + (a + ξ) * u)‖ := by
  have hp (u) : (w u : ℂ) * (conj (f (u + y)) * ZMod.stdAddChar (-(a * (u + y)))) *
      ZMod.stdAddChar (M u * u - ξ * u) =
      ZMod.stdAddChar (-(a * y)) * conj ((w u : ℂ) * f (u + y) *
        ZMod.stdAddChar (-(M u * u) + (a + ξ) * u)) := by
    simp only [map_mul, Complex.conj_ofReal, graph_stdChar_conj]
    have hh : ZMod.stdAddChar (-(a * (u + y))) * ZMod.stdAddChar (M u * u - ξ * u) =
        ZMod.stdAddChar (-(a * y)) * ZMod.stdAddChar (-(-(M u * u) + (a + ξ) * u)) := by
      rw [← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul]
      congr 1
      ring
    linear_combination (w u : ℂ) * conj (f (u + y)) * hh
  simp_rw [hp]
  rw [← Finset.mul_expect, ← map_expect, norm_mul]
  simp only [ZMod.stdAddChar_apply, Circle.norm_coe, Complex.norm_conj, one_mul]

theorem graph_bohr_local_quadratic_correlation {q : ℕ} [NeZero q]
    (cutoff : ℝ → ℝ) {L : ℝ≥0} (hLip : LipschitzWith L cutoff)
    (hb0 : ∀ x, 0 ≤ cutoff x) (hb1 : ∀ x, cutoff x ≤ 1)
    (hbone : ∀ x, |x| ≤ 1 / 2 → cutoff x = 1)
    (hsupp : ∀ x, 1 ≤ |x| → cutoff x = 0)
    (S T : Finset (ZMod q)) (hST : S ⊆ T) {r s ρ ζ : ℝ}
    (hr : 0 < r) (hrsmall : r < 1 / 8) (hs : 0 < s) (hsr : s ≤ r)
    (hrρ : r + s ≤ ρ) (hζ : 0 < ζ)
    (herror : max (L : ℝ) 1 * S.card * s / r ≤ ζ / 100)
    (M : ZMod q → ZMod q)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    (hskew : ∀ u ∈ graphBohrSet T s, ∀ t ∈ graphBohrSet T s,
      ‖graphAlternatingPhase M u t‖ ≤ ζ / 1000)
    (a f c : ZMod q → ℂ) (ha : ∀ x, ‖a x‖ ≤ 1)
    (hf : ∀ x, ‖f x‖ ≤ 1) (hc : ∀ x, ‖c x‖ ≤ 1) (ξ₀ : ZMod q)
    (hcorr : ζ ≤ ‖graphLocalCorrelation (graphBohrWeight cutoff S r) M a
      (fun x => conj (f x) * ZMod.stdAddChar (-(ξ₀ * x))) c‖) :
    let β := graphBohrMass cutoff T s
    ∃ y ℓ : ZMod q, ζ * β * Real.sqrt β / 4 ≤
      ‖𝔼 u, (graphBohrWeight cutoff T s u : ℂ) * f (u + y) *
        ZMod.stdAddChar (-(M u * u) + ℓ * u)‖ := by
  dsimp only
  have hb (x) : ‖conj (f x) * ZMod.stdAddChar (-(ξ₀ * x))‖ ≤ 1 := by
    simpa only [norm_mul, Complex.norm_conj, ZMod.stdAddChar_apply, Circle.norm_coe,
      mul_one] using hf x
  obtain ⟨h, _, hshift⟩ := graph_bohr_shift_select cutoff hLip hb0 hb1 hbone hsupp
    S T hST hr hrsmall hs hsr hrρ hζ herror M hadd a
    (fun x => conj (f x) * ZMod.stdAddChar (-(ξ₀ * x))) c ha hb hc hcorr
  let α := ξ₀ + 2 * M h
  have hlinear (x) : (conj (f x) * ZMod.stdAddChar (-(ξ₀ * x))) *
      ZMod.stdAddChar (-(2 * M h * x)) = conj (f x) * ZMod.stdAddChar (-(α * x)) := by
    rw [mul_assoc, ← AddChar.map_add_eq_mul]
    congr 1
    dsimp [α]
    congr 1
    ring
  simp_rw [hlinear] at hshift
  let μ := graphBohrMeasure cutoff T s
  have hmass := graphBohrMass_pos cutoff hb0 hb1 hbone T hs (hsr.trans_lt hrsmall)
  obtain ⟨y, hy⟩ := graph_correlation_localization_explicit μ μ
    (graphBohrMeasure_mean_one cutoff T s hmass) M
    (fun x => a (x + h)) (fun x => conj (f x) * ZMod.stdAddChar (-(α * x)))
    (fun t => c (h + t)) hshift
  have hlocal : ∀ x ∈ graphBohrSet T ρ, ∀ y ∈ graphBohrSet T ρ,
      x + y ∈ graphBohrSet T ρ → M (x + y) = M x + M y := by
    intro x hx y hy hxy
    exact hadd x (graphBohrSet_mono hST le_rfl hx) y (graphBohrSet_mono hST le_rfl hy)
      (graphBohrSet_mono hST le_rfl hxy)
  have hby (x) : ‖conj (f (x + y)) * ZMod.stdAddChar (-(α * (x + y)))‖ ≤ 1 := by
    simpa only [norm_mul, Complex.norm_conj, ZMod.stdAddChar_apply, Circle.norm_coe,
      mul_one] using hf (x + y)
  have hcy (t) : ‖c (h + t) * ZMod.stdAddChar (-(2 * M t * y))‖ ≤ 1 := by
    simpa only [norm_mul, ZMod.stdAddChar_apply, Circle.norm_coe, mul_one] using hc (h + t)
  obtain ⟨ξ, hξ⟩ := graph_bohr_weighted_quadratic_correlation cutoff hb0 hb1 hbone hsupp T
    hs (hsr.trans_lt hrsmall) (by linarith : 2 * s ≤ ρ) hζ M hlocal hskew
    (fun x => a (x + y + h))
    (fun x => conj (f (x + y)) * ZMod.stdAddChar (-(α * (x + y))))
    (fun t => c (h + t) * ZMod.stdAddChar (-(2 * M t * y)))
    (fun x => ha (x + y + h)) hby hcy hy
  rw [graph_quadratic_correlation_recover] at hξ
  exact ⟨y, α + ξ, hξ⟩

theorem local_inverse_polynomial_budget (d D : ℕ)
    {P R Z T V B G : ℝ} (hP : 100000 ≤ P) (hT0 : 0 ≤ T)
    (hV0 : 0 ≤ V) (hd : (d : ℝ) + R ≤ P) (hZ : Z ≤ P)
    (hDT : (D : ℝ) + T ≤ P * (3 * P) ^ 8)
    (hV : V ≤ T + Z + 2 * R + P + 20000 * ((D : ℝ) + 1) ^ 2)
    (hB : B ≤ D * (6 + V)) (hG : G ≤ Z + (3 / 2) * B + 4) :
    (D : ℝ) + V + 1 ≤ P ^ 22 ∧ G ≤ P ^ 34 := by
  have hP0 : 0 ≤ P := by linarith
  have hP1 : 1 ≤ P := by linarith
  have hpow {m n : ℕ} (h : m ≤ n) : P ^ m ≤ P ^ n := pow_le_pow_right₀ hP1 h
  have hDT' : (D : ℝ) + T ≤ P ^ 10 := by
    apply hDT.trans
    calc
      P * (3 * P) ^ 8 = 6561 * P ^ 9 := by ring
      _ ≤ P * P ^ 9 := mul_le_mul_of_nonneg_right (by linarith) (by positivity)
      _ = P ^ 10 := by ring
  have hD : (D : ℝ) ≤ P ^ 10 := by linarith
  have hT : T ≤ P ^ 10 := by linarith [Nat.cast_nonneg D (α := ℝ)]
  have hR : R ≤ P := by linarith [Nat.cast_nonneg d (α := ℝ)]
  have h10 : 1 ≤ P ^ 10 := one_le_pow₀ hP1
  have hD2 : ((D : ℝ) + 1) ^ 2 ≤ 4 * P ^ 20 := by
    calc
      _ ≤ (2 * P ^ 10) ^ 2 := pow_le_pow_left₀ (by positivity) (by linarith) 2
      _ = _ := by ring
  have hP20 : P ≤ P ^ 20 := by simpa only [pow_one] using hpow (by norm_num : 1 ≤ 20)
  have h1020 : P ^ 10 ≤ P ^ 20 := hpow (by norm_num)
  have hV' : V ≤ P ^ 21 := by
    calc
      V ≤ 80005 * P ^ 20 := by nlinarith only [hd, hZ, hV, hDT', hD, h10, hP20]
      _ ≤ P * P ^ 20 := mul_le_mul_of_nonneg_right (by linarith) (by positivity)
      _ = P ^ 21 := by ring
  have hP21 : P ≤ P ^ 21 := by simpa only [pow_one] using hpow (by norm_num : 1 ≤ 21)
  have h1021 : P ^ 10 ≤ P ^ 21 := hpow (by norm_num)
  have hDVR : (D : ℝ) + V + 1 ≤ P ^ 22 := by
    calc
      _ ≤ 3 * P ^ 21 := by linarith [one_le_pow₀ hP1 (n := 21)]
      _ ≤ P * P ^ 21 := mul_le_mul_of_nonneg_right (by linarith) (by positivity)
      _ = _ := by ring
  have hB' : B ≤ P ^ 32 := by
    calc
      B ≤ D * (6 + V) := hB
      _ ≤ P ^ 10 * (2 * P ^ 21) :=
        mul_le_mul hD (by linarith) (by linarith) (by positivity)
      _ = 2 * P ^ 31 := by ring
      _ ≤ P * P ^ 31 := mul_le_mul_of_nonneg_right (by linarith) (by positivity)
      _ = P ^ 32 := by ring
  have hP32 : P ≤ P ^ 32 := by simpa only [pow_one] using hpow (by norm_num : 1 ≤ 32)
  refine ⟨hDVR, ?_⟩
  calc
    G ≤ 4 * P ^ 32 := by nlinarith only [one_le_pow₀ hP1 (n := 32), hP, hZ, hG, hD, h1020, hP21,
        hB']
    _ ≤ P * P ^ 32 := mul_le_mul_of_nonneg_right (by linarith) (by positivity)
    _ = P ^ 33 := by ring
    _ ≤ P ^ 34 := hpow (by norm_num)

theorem graph_local_inverse_log_budget (d D : ℕ) {P ρ t r ζ β C K : ℝ}
    (hP : 100000 ≤ P) (hρ : 0 < ρ) (hρ1 : ρ ≤ 1)
    (ht : 0 < t) (ht1 : t ≤ 1) (hr : 0 < r) (hr1 : r ≤ 1)
    (hζ : 0 < ζ) (hζ1 : ζ ≤ 1) (hKP : K ≤ P)
    (hd : (d : ℝ) + Real.log (1 / ρ) ≤ P)
    (hZ : Real.log (1 / ζ) ≤ P) (hC : Real.log C ≤ P)
    (hDT : (D : ℝ) + Real.log (1 / t) ≤ K * graphSymmetryBudget d (ρ / 100) ζ ^ 8)
    (hV : Real.log (1 / r) ≤ Real.log (1 / t) + Real.log (1 / ζ) +
      2 * Real.log (1 / ρ) + Real.log C + 20000 * ((D : ℝ) + 1) ^ 2)
    (hβ : (r / 6) ^ D ≤ β) :
    (D : ℝ) + Real.log (1 / r) + 1 ≤ P ^ 22 ∧
      Real.log (1 / (ζ * β * Real.sqrt β / 4)) ≤ P ^ 34 := by
  have hP0 : 0 ≤ P := by linarith
  have hρlog : 0 ≤ Real.log (1 / ρ) := Real.log_nonneg ((one_le_div hρ).mpr hρ1)
  have hζlog : 0 ≤ Real.log (1 / ζ) := Real.log_nonneg ((one_le_div hζ).mpr hζ1)
  have hlogscale : Real.log (1 / (ρ / 100)) =
      Real.log 100 + Real.log (1 / ρ) := by
    rw [show 1 / (ρ / 100) = 100 / ρ by field_simp,
      Real.log_div (by norm_num : (100 : ℝ) ≠ 0) hρ.ne', one_div, Real.log_inv]
    ring
  have hbudget0 : 0 ≤ graphSymmetryBudget d (ρ / 100) ζ := by
    dsimp [graphSymmetryBudget]
    rw [hlogscale]
    have hh : 0 ≤ Real.log (100 : ℝ) := Real.log_nonneg (by norm_num)
    positivity
  have hbudget : graphSymmetryBudget d (ρ / 100) ζ ≤ 3 * P := by
    dsimp [graphSymmetryBudget]
    rw [hlogscale]
    have hh := Real.log_le_self (by norm_num : (0 : ℝ) ≤ 100)
    linarith
  have hDT' : (D : ℝ) + Real.log (1 / t) ≤ P * (3 * P) ^ 8 :=
    hDT.trans (mul_le_mul hKP (pow_le_pow_left₀ hbudget0 hbudget 8)
      (pow_nonneg hbudget0 8) hP0)
  have hβpos : 0 < β := (pow_pos (div_pos hr (by norm_num)) D).trans_le hβ
  have hBlog : Real.log (1 / β) ≤ D * (6 + Real.log (1 / r)) := by
    apply (graph_mass_log_bound D hr hβ).trans
    rw [Real.log_div (by norm_num : (6 : ℝ) ≠ 0) hr.ne', one_div, Real.log_inv]
    have hh := Real.log_le_self (by norm_num : (0 : ℝ) ≤ 6)
    gcongr
    linarith
  have hGlog : Real.log (1 / (ζ * β * Real.sqrt β / 4)) ≤
      Real.log (1 / ζ) + (3 / 2) * Real.log (1 / β) + 4 := by
    rw [one_div, Real.log_inv,
      Real.log_div (by positivity : ζ * β * Real.sqrt β ≠ 0) (by norm_num : (4 : ℝ) ≠ 0),
      Real.log_mul (mul_ne_zero hζ.ne' hβpos.ne') (by positivity : Real.sqrt β ≠ 0),
      Real.log_mul hζ.ne' hβpos.ne', Real.log_sqrt hβpos.le]
    simp only [one_div, Real.log_inv]
    have hh := Real.log_le_self (by norm_num : (0 : ℝ) ≤ 4)
    linarith
  exact local_inverse_polynomial_budget d D hP
    (Real.log_nonneg ((one_le_div ht).mpr ht1))
    (Real.log_nonneg ((one_le_div hr).mpr hr1)) hd hZ hDT'
    (hV.trans (by linarith)) hBlog hGlog

end TrilinearHT.Auto


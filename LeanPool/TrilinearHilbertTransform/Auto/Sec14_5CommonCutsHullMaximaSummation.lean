        rw [Finset.sum_eq_zero fun Q hQ => Set.indicator_of_notMem (hex Q hQ) _]
        exact zero_le
    calc _ ≤ ∑ ν ∈ Ns, (ma ν x * mb ν x) ^ (1 / 2 : ℝ) := Finset.sum_le_sum hν
      _ ≤ (∑ ν ∈ Ns, ma ν x) ^ (1 / 2 : ℝ) * (∑ ν ∈ Ns, mb ν x) ^ (1 / 2 : ℝ) :=

/-! ### Joint hull caps for the two stacks (blueprint lines 2425-2433) -/

theorem dyadicHullMax_mono (G : RealDyadicGrid) {S T : Finset (ℤ × ℤ)} (hST : S ⊆ T)
    (g : ℝ → ℝ≥0∞) (x : ℝ) : dyadicHullMax G S g x ≤ dyadicHullMax G T g x := by
  unfold dyadicHullMax
  exact Finset.sup_mono hST

/-! ### The coupled-band estimate (`eq:near-band`, blueprint lines 2433-2445) -/

theorem energyAverage_le_hullMax (G : RealDyadicGrid) {S : Finset (ℤ × ℤ)} {c : ℤ × ℤ}
    (hc : c ∈ S) (g : ℝ → ℝ≥0∞) {x : ℝ} (hx : x ∈ dyadicGridCell G c.1 c.2) :
    dyadicEnergyAverage G g c ≤ dyadicHullMax G S g x := by
  classical
  unfold dyadicHullMax
  refine le_trans (le_of_eq ?_) (Finset.le_sup (f := fun c => (dyadicGridCell G c.1 c.2).indicator
    (fun _ => dyadicEnergyAverage G g c) x) hc)
  rw [Set.indicator_of_mem hx]

/-- Blueprint lines 2433-2445 (`eq:near-band`): for each index `ν`, sparse pieces `Q` lying in
the retained hull `H_ν`, with disjoint remainders `E_Q ⊆ Q ∩ R` of length at least `7|Q|/8`, and
terms bounded by `C |Q| a_Q b_Q` with the root sizes `a_Q² = ⨍_Q g_a`, `b_Q² = ⨍_Q g_b` (from
`lem:shortblock` on the pieces), sum to at most `(8/7) C √(AB) |R|` when the hull maxima have the
joint caps `Σ_ν m_{a,ν} ≤ A`, `Σ_ν m_{b,ν} ≤ B` on `R`. -/
theorem near_band_estimate (G : RealDyadicGrid) {N : Type*} (Ns : Finset N)
    (Hs : N → Finset (ℤ × ℤ)) (Qs : N → Finset (ℤ × ℤ)) (hQH : ∀ ν ∈ Ns, Qs ν ⊆ Hs ν)
    (E : N → ℤ × ℤ → Set ℝ) (hEm : ∀ ν Q, MeasurableSet (E ν Q)) {R : Set ℝ}
    (hRm : MeasurableSet R)
    (hdis : ∀ ν ∈ Ns, (Qs ν : Set (ℤ × ℤ)).PairwiseDisjoint (E ν))
    (hEQ : ∀ ν ∈ Ns, ∀ Q ∈ Qs ν, E ν Q ⊆ dyadicGridCell G Q.1 Q.2 ∩ R)
    (hvol : ∀ ν ∈ Ns, ∀ Q ∈ Qs ν, 7 * ENNReal.ofReal (dyadicGridLength G Q.1) ≤ 8 * volume (E ν Q))
    (ga gb : N → ℝ → ℝ≥0∞) {A B : ℝ≥0∞}
    (hA : ∀ x ∈ R, ∑ ν ∈ Ns, dyadicHullMax G (Hs ν) (ga ν) x ≤ A)
    (hB : ∀ x ∈ R, ∑ ν ∈ Ns, dyadicHullMax G (Hs ν) (gb ν) x ≤ B)
    (term : N → ℤ × ℤ → ℝ≥0∞) (C : ℝ≥0∞)
    (hterm : ∀ ν ∈ Ns, ∀ Q ∈ Qs ν, term ν Q ≤ C * (ENNReal.ofReal (dyadicGridLength G Q.1) *
      ((dyadicEnergyAverage G (ga ν) Q) ^ (1 / 2 : ℝ) *
        (dyadicEnergyAverage G (gb ν) Q) ^ (1 / 2 : ℝ)))) :
    7 * ∑ ν ∈ Ns, ∑ Q ∈ Qs ν, term ν Q ≤ 8 * C * ((A * B) ^ (1 / 2 : ℝ) * volume R) := by
  classical
  -- index the pieces by pairs to separate the families
  set Qs' : N → Finset (N × (ℤ × ℤ)) := fun ν => (Qs ν).map ⟨fun Q => (ν, Q), fun _ _ h =>
    (Prod.ext_iff.mp h).2⟩
  have hsum : ∀ (f : N × (ℤ × ℤ) → ℝ≥0∞), ∑ ν ∈ Ns, ∑ q ∈ Qs' ν, f q =
      ∑ ν ∈ Ns, ∑ Q ∈ Qs ν, f (ν, Q) := fun f =>
    Finset.sum_congr rfl fun ν _ => Finset.sum_map _ _ _
  have h := near_band_total Ns Qs' (fun q => ENNReal.ofReal (dyadicGridLength G q.2.1))
    (fun q => (dyadicEnergyAverage G (ga q.1) q.2) ^ (1 / 2 : ℝ))
    (fun q => (dyadicEnergyAverage G (gb q.1) q.2) ^ (1 / 2 : ℝ)) (fun q => E q.1 q.2)
    (fun q => hEm q.1 q.2) hRm ?_ ?_ ?_ (fun ν x => dyadicHullMax G (Hs ν) (ga ν) x)
    (fun ν x => dyadicHullMax G (Hs ν) (gb ν) x) ?_ hA hB (fun q => term q.1 q.2) C ?_
  · rwa [hsum] at h
  · intro ν hν q₁ hq₁ q₂ hq₂ hne
    obtain ⟨Q₁, hQ₁, rfl⟩ := Finset.mem_map.mp hq₁
    obtain ⟨Q₂, hQ₂, rfl⟩ := Finset.mem_map.mp hq₂
    exact hdis ν hν hQ₁ hQ₂ fun h => hne (by subst h; rfl)
  · intro ν hν q hq
    obtain ⟨Q, hQ, rfl⟩ := Finset.mem_map.mp hq
    exact (hEQ ν hν Q hQ).trans Set.inter_subset_right
  · intro ν hν q hq
    obtain ⟨Q, hQ, rfl⟩ := Finset.mem_map.mp hq
    exact hvol ν hν Q hQ
  · intro ν hν q hq x hx
    obtain ⟨Q, hQ, rfl⟩ := Finset.mem_map.mp hq
    have hxQ := ((hEQ ν hν Q hQ) hx).1
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
    exact mul_le_mul' (ENNReal.rpow_le_rpow (energyAverage_le_hullMax G (hQH ν hν hQ) _ hxQ)
      (by norm_num)) (ENNReal.rpow_le_rpow (energyAverage_le_hullMax G (hQH ν hν hQ) _ hxQ)
      (by norm_num))
  · intro ν hν q hq
    obtain ⟨Q, hQ, rfl⟩ := Finset.mem_map.mp hq
    exact hterm ν hν Q hQ

section PieceTree
variable (G : RealDyadicGrid)

/-! ### Sparse pieces as short-block trees (blueprint lines 2433-2437) -/

/-- The internal cells of a piece: the root and all cells between it and the summation cells. -/
noncomputable def pieceInternal (Q : ℤ × ℤ) (C : Finset (ℤ × ℤ)) : Finset (ℤ × ℤ) :=
  insert Q (C.biUnion fun c =>
    (Finset.range ((c.1 - Q.1).toNat + 1)).image fun n : ℕ => ancAt G c (Q.1 + n))

open Classical in
/-- The leaves of a piece: children of internal cells that are not internal. -/
noncomputable def pieceLeaves (Q : ℤ × ℤ) (C : Finset (ℤ × ℤ)) : Finset (ℤ × ℤ) :=
  ((pieceInternal G Q C).biUnion (dyadicChildren G)).filter fun d => d ∉ pieceInternal G Q C

variable {G}

theorem mem_pieceInternal {Q : ℤ × ℤ} {C : Finset (ℤ × ℤ)}
    (hC : ∀ c ∈ C, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2) {d : ℤ × ℤ} :
    d ∈ pieceInternal G Q C ↔ d = Q ∨ ∃ c ∈ C, dyadicGridCell G c.1 c.2 ⊆
      dyadicGridCell G d.1 d.2 ∧ dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G Q.1 Q.2 := by
  unfold pieceInternal
  simp only [Finset.mem_insert, Finset.mem_biUnion, Finset.mem_image, Finset.mem_range]
  refine or_congr Iff.rfl ⟨?_, ?_⟩
  · rintro ⟨c, hc, n, hn, rfl⟩
    have hQc := dyadicGridCell_depth_le_of_subset G c Q (hC c hc)
    refine ⟨c, hc, subset_ancAt G c (by omega), ancAt_subset (hC c hc) (by omega)⟩
  · rintro ⟨c, hc, hcd, hdQ⟩
    have h1 := dyadicGridCell_depth_le_of_subset G c d hcd
    have h2 := dyadicGridCell_depth_le_of_subset G d Q hdQ
    refine ⟨c, hc, (d.1 - Q.1).toNat, by omega, ?_⟩
    have he : Q.1 + ((d.1 - Q.1).toNat : ℤ) = d.1 := by omega
    rw [he]
    exact ancAt_eq_of_subset hcd

/-- Internal cells are closed under ancestors below the root. -/
theorem pieceInternal_anc {Q : ℤ × ℤ} {C : Finset (ℤ × ℤ)}
    (hC : ∀ c ∈ C, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2) {d e : ℤ × ℤ}
    (hd : d ∈ pieceInternal G Q C) (hde : dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G e.1 e.2)
    (heQ : dyadicGridCell G e.1 e.2 ⊆ dyadicGridCell G Q.1 Q.2) : e ∈ pieceInternal G Q C := by
  rcases (mem_pieceInternal hC).mp hd with rfl | ⟨c, hc, hcd, -⟩
  · -- `e` contains the root and lies inside it
    have h1 := dyadicGridCell_depth_le_of_subset G d e hde
    have h2 := dyadicGridCell_depth_le_of_subset G e d heQ
    have : e = d := dyadicGridCell_eq_of_meet G (by omega)
      ⟨_, dyadicGridCell_left_mem G e.1 e.2, heQ (dyadicGridCell_left_mem G e.1 e.2)⟩
    rw [this]; exact Finset.mem_insert_self _ _
  · exact (mem_pieceInternal hC).mpr (Or.inr ⟨c, hc, hcd.trans hde, heQ⟩)

theorem pieceInternal_sub {Q : ℤ × ℤ} {C : Finset (ℤ × ℤ)}
    (hC : ∀ c ∈ C, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2) {d : ℤ × ℤ}
    (hd : d ∈ pieceInternal G Q C) : dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G Q.1 Q.2 := by
  rcases (mem_pieceInternal hC).mp hd with rfl | ⟨c, -, -, hdQ⟩
  · exact subset_rfl
  · exact hdQ

end PieceTree

section PieceTree2
variable {G : RealDyadicGrid}

theorem mem_pieceLeaves {Q : ℤ × ℤ} {C : Finset (ℤ × ℤ)} {L : ℤ × ℤ} :
    L ∈ pieceLeaves G Q C ↔ L ∉ pieceInternal G Q C ∧
      ∃ d ∈ pieceInternal G Q C, L ∈ dyadicChildren G d := by
  classical
  unfold pieceLeaves
  rw [Finset.mem_filter, Finset.mem_biUnion]
  tauto

/-- Blueprint lines 2433-2437 ("complete pieces by children immediately below their included
cells, including missing branches ... each piece has at most `K` internal depths and leaves at
most one step below"): a root `Q` with summation cells `C` inside it, at most `K` depths below,
forms a short-block tree. -/
noncomputable def pieceTree (Q : ℤ × ℤ) (C : Finset (ℤ × ℤ))
    (hC : ∀ c ∈ C, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2) {K : ℕ} (hK : 1 ≤ K)
    (hdepth : ∀ c ∈ C, c.1 < Q.1 + K) : ShortBlockTree G K where
  root := Q
  first := Q.1
  internal := pieceInternal G Q C
  leaves := pieceLeaves G Q C
  internal_depth := by
    intro d hd
    rcases (mem_pieceInternal hC).mp hd with rfl | ⟨c, hc, hcd, hdQ⟩
    · constructor <;> omega
    · have h1 := dyadicGridCell_depth_le_of_subset G c d hcd
      have h2 := dyadicGridCell_depth_le_of_subset G d Q hdQ
      have h3 := hdepth c hc
      constructor <;> omega
  leaf_depth := by
    intro L hL
    obtain ⟨-, d, hd, hLd⟩ := mem_pieceLeaves.mp hL
    have h0 := dyadicChildren_depth G d L hLd
    rcases (mem_pieceInternal hC).mp hd with rfl | ⟨c, hc, hcd, hdQ⟩
    · constructor <;> omega
    · have h1 := dyadicGridCell_depth_le_of_subset G c d hcd
      have h2 := dyadicGridCell_depth_le_of_subset G d Q hdQ
      have h3 := hdepth c hc
      constructor <;> omega
  internal_subset := fun d hd => pieceInternal_sub hC hd
  leaf_subset := by
    intro L hL
    obtain ⟨-, d, hd, hLd⟩ := mem_pieceLeaves.mp hL
    exact (dyadicChildren_subset G d L hLd).trans (pieceInternal_sub hC hd)
  leaf_disjoint := by
    intro L hL L' hL' hne
    rw [Function.onFun, Set.disjoint_iff_inter_eq_empty]
    by_contra hmeet
    have hm : (dyadicGridCell G L.1 L.2 ∩ dyadicGridCell G L'.1 L'.2).Nonempty :=
      Set.nonempty_iff_ne_empty.mpr hmeet
    obtain ⟨hLI, d, hd, hLd⟩ := mem_pieceLeaves.mp hL
    obtain ⟨hLI', d', hd', hLd'⟩ := mem_pieceLeaves.mp hL'
    have hdQ := pieceInternal_sub hC hd
    have hdQ' := pieceInternal_sub hC hd'
    have e1 := dyadicChildren_depth G d L hLd
    have e2 := dyadicChildren_depth G d' L' hLd'
    rcases lt_trichotomy L.1 L'.1 with h | h | h
    · -- `L' ⊊ L`: `L` contains the parent `d'` of `L'`, so `L` is internal
      have hsub := dyadicGridCell_nested_of_meet G h.le hm
      have hdL : dyadicGridCell G d'.1 d'.2 ⊆ dyadicGridCell G L.1 L.2 :=
        dyadicGridCell_subset_of_common G (dyadicChildren_subset G d' L' hLd') hsub (by omega)
      exact hLI (pieceInternal_anc hC hd' hdL ((dyadicChildren_subset G d L hLd).trans hdQ))
    · exact hne (dyadicGridCell_eq_of_meet G h hm)
    · have hm' : (dyadicGridCell G L'.1 L'.2 ∩ dyadicGridCell G L.1 L.2).Nonempty := by
        rwa [Set.inter_comm] at hm
      have hsub := dyadicGridCell_nested_of_meet G h.le hm'
      have hdL : dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G L'.1 L'.2 :=
        dyadicGridCell_subset_of_common G (dyadicChildren_subset G d L hLd) hsub (by omega)
      exact hLI' (pieceInternal_anc hC hd hdL ((dyadicChildren_subset G d' L' hLd').trans hdQ'))
  leaf_cover := by
    classical
    intro x hx
    set T := (pieceInternal G Q C).filter fun d => x ∈ dyadicGridCell G d.1 d.2
    have hT : T.Nonempty := ⟨Q, Finset.mem_filter.mpr ⟨Finset.mem_insert_self _ _, hx⟩⟩
    obtain ⟨d, hdT, hmax⟩ := T.exists_max_image Prod.fst hT
    obtain ⟨hd, hxd⟩ := Finset.mem_filter.mp hdT
    obtain ⟨L, hLd, hxL⟩ := dyadicChildren_cover G d hxd
    refine Set.mem_iUnion₂.mpr ⟨L, mem_pieceLeaves.mpr ⟨fun hLI => ?_, d, hd, hLd⟩, hxL⟩
    have := hmax L (Finset.mem_filter.mpr ⟨hLI, hxL⟩)
    have := dyadicChildren_depth G d L hLd
    omega
  internal_leaf := by
    intro d hd L hL hmeet
    obtain ⟨hLI, p, hp, hLp⟩ := mem_pieceLeaves.mp hL
    by_contra hle
    push Not at hle
    have hsub := dyadicGridCell_nested_of_meet G hle (by rwa [Set.inter_comm] at hmeet)
    exact hLI (pieceInternal_anc hC hd hsub
      ((dyadicChildren_subset G p L hLp).trans (pieceInternal_sub hC hp)))

theorem pieceTree_internal_sup {Q : ℤ × ℤ} {C : Finset (ℤ × ℤ)}
    (hC : ∀ c ∈ C, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2) {K : ℕ} (hK : 1 ≤ K)
    (hdepth : ∀ c ∈ C, c.1 < Q.1 + K) : C ⊆ (pieceTree Q C hC hK hdepth).internal := by
  intro c hc
  exact (mem_pieceInternal hC).mpr (Or.inr ⟨c, hc, subset_rfl, hC c hc⟩)

end PieceTree2

/-- Blueprint line 2436 ("a child's squared average is at most twice its parent's"):
`∫_L g ≤ 2 |L| ⨍_p g` for a child `L` of `p`. -/
theorem child_lintegral_le (G : RealDyadicGrid) {p L : ℤ × ℤ} (hL : L ∈ dyadicChildren G p)
    (g : ℝ → ℝ≥0∞) :
    ∫⁻ x in dyadicGridCell G L.1 L.2, g x ≤
      2 * ENNReal.ofReal (dyadicGridLength G L.1) * dyadicEnergyAverage G g p := by
  have hd := dyadicChildren_depth G p L hL
  have hlen : dyadicGridLength G p.1 = 2 * dyadicGridLength G L.1 := by
    rw [hd, ← dyadicGridLength_half G p.1]; ring
  have hp := dyadicGridLength_pos G p.1
  have hpne : ENNReal.ofReal (dyadicGridLength G p.1) ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp
  calc ∫⁻ x in dyadicGridCell G L.1 L.2, g x ≤ ∫⁻ x in dyadicGridCell G p.1 p.2, g x :=
        lintegral_mono_set (dyadicChildren_subset G p L hL)
    _ = ENNReal.ofReal (dyadicGridLength G p.1) * dyadicEnergyAverage G g p := by
        unfold dyadicEnergyAverage
        rw [ENNReal.mul_div_cancel hpne ENNReal.ofReal_ne_top]
    _ = 2 * ENNReal.ofReal (dyadicGridLength G L.1) * dyadicEnergyAverage G g p := by
        rw [hlen, ENNReal.ofReal_mul (by norm_num)]
        norm_num

end Auto

end


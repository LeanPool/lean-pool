      unfold patternSign; split_ifs <;> simp
    have h2 : ‖(patternSign ω.2.1.1 (sb I) : ℂ)‖ = 1 := by
      unfold patternSign; split_ifs <;> simp
    simp only [ε, norm_mul, h1, h2, mul_one]
    exact hsg I
  have hTc : ∀ I ∈ cells, (Fintype.card Ω : ℂ)⁻¹ * ∑ ω, ε I ω *
      localProgressionForm (dyadicGridLength G I.1) (kernel I) (fun j => zσ j ω) =
      sg I * ∑ p ∈ u, localProgressionForm (dyadicGridLength G I.1) (kernel I)
        (Function.update (Function.update (Function.update f a (x (sa I) p)) b (w (sb I))) c
          (y p)) := by
    intro I hI
    have h := form_sign_avg3 (dyadicGridLength_pos G I.1) (hker I (hcells hI)) hab hac hbc f hf
      (hff I hI) s t u x w y hx (hxf I hI) hw (hwf I hI) hy (hyf I hI) (hsa I hI) (hsb I hI)
    rw [← h]
    have e := avg_three_families s t u (fun v₁ v₂ v₃ => sg I * ((patternSign v₁ (sa I) : ℂ) *
      patternSign v₂ (sb I) * localProgressionForm (dyadicGridLength G I.1) (kernel I)
        (randTuple3 a b c f s t u x w y v₁ v₂ v₃)))
    simp only [smul_eq_mul] at e
    have e' : ∀ ω : Ω, ε I ω * localProgressionForm (dyadicGridLength G I.1) (kernel I)
        (fun j => zσ j ω) = sg I * ((patternSign ω.1.1 (sa I) : ℂ) * patternSign ω.2.1.1 (sb I) *
          localProgressionForm (dyadicGridLength G I.1) (kernel I)
            (randTuple3 a b c f s t u x w y ω.1.1 ω.2.1.1 ω.2.2.1)) := fun ω => by
      simp only [ε, zσ]; ring
    simp_rw [e']
    rw [e]
    simp only [Finset.mul_sum]
    refine Finset.sum_congr rfl fun v₁ _ => Finset.sum_congr rfl fun v₂ _ =>
      Finset.sum_congr rfl fun v₃ _ => ?_
    ring
  exact hrb G K Nd d₀ T z hzm sv hsv hleaf zσ hzσm hmom kernel hker cells hcells hwin ε hε1 _
    hTc

end PieceBand

section SparsePieceBound

theorem prod_fin4_slots {a b c : Fin 4} (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c)
    (α β γ δ : ℝ) :
    ∏ j, (if j = a then α else if j = b then β else if j = c then γ else δ) = α * β * γ * δ := by
  rw [Fin.prod_univ_four]
  fin_cases a <;> fin_cases b <;> fin_cases c <;>
    first
    | exact absurd rfl hab | exact absurd rfl hac | exact absurd rfl hbc
    | simp (disch := decide) only [ite_eq_left, ite_eq_right, mul_comm, mul_left_comm]

theorem avg_sqrt_eq {A : ℝ≥0∞} (hA : A ≠ ⊤) :
    A ^ (1 / 2 : ℝ) = ENNReal.ofReal (Real.sqrt A.toReal) := by
  conv_lhs => rw [← ENNReal.ofReal_toReal hA]
  rw [ENNReal.ofReal_rpow_of_nonneg ENNReal.toReal_nonneg (by norm_num), Real.sqrt_eq_rpow]

/-- `∫_L g ≤ 2 |L| B²` for a child `L` of a cell `p` on which `g` has average at most `B²`. -/
theorem child_lintegral_le_sq (G : RealDyadicGrid) {p L : ℤ × ℤ} (hL : L ∈ dyadicChildren G p)
    (g : ℝ → ℝ≥0∞) {B : ℝ} (hB : dyadicEnergyAverage G g p ≤ ENNReal.ofReal (B ^ 2)) :
    ∫⁻ x in dyadicGridCell G L.1 L.2, g x ≤
      ENNReal.ofReal ((Real.sqrt 2 * B) ^ 2 * dyadicGridLength G L.1) := by
  refine (child_lintegral_le G hL g).trans ?_
  calc 2 * ENNReal.ofReal (dyadicGridLength G L.1) * dyadicEnergyAverage G g p
      ≤ 2 * ENNReal.ofReal (dyadicGridLength G L.1) * ENNReal.ofReal (B ^ 2) := by gcongr
    _ = ENNReal.ofReal ((Real.sqrt 2 * B) ^ 2 * dyadicGridLength G L.1) := by
        rw [mul_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2), mul_assoc (2 : ℝ),
          ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_mul (sq_nonneg _),
          ENNReal.ofReal_ofNat]
        ring

open Classical in
/-- Blueprint lines 2432-2437 (`lem:shortblock` on one sparse piece): for a sparse root `Q` of
the two side stacks `g_a = Σ_{i,p} |x_{ip}|²`, `g_b = Σ_k |w_k|²` and summation cells `C` owned by
`Q`, with the frozen complementary stack and the remaining input of averages at most `B_c²`,
`B_d²` on the internal cells, the selected matched band forms over `C` (arbitrary signs) are at
most a short-block constant times `|Q| a_Q b_Q B_c B_d`. -/
theorem sparse_piece_bound (κ : LocalKernelClass) {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) :
    ∃ Cq : ℝ, 0 ≤ Cq ∧ ∀ (G : RealDyadicGrid) (K Nd : ℕ) (d₀ : ℤ), 1 ≤ K →
      ∀ (H : Finset (ℤ × ℤ)) (Q : ℤ × ℤ) (C : Finset (ℤ × ℤ)),
      (∀ c ∈ C, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2) →
      (∀ c ∈ C, c.1 < Q.1 + K) →
      ∀ {ι κ' ν : Type} [DecidableEq ι] [DecidableEq κ'] [DecidableEq ν]
      (s : Finset ι) (t : Finset κ') (u : Finset ν) {a b c : Fin 4},
      a ≠ b → a ≠ c → b ≠ c →
      ∀ (f : Fin 4 → ℝ → ℂ) (x : ι → ν → ℝ → ℂ) (w : κ' → ℝ → ℂ) (y : ν → ℝ → ℂ),
      (∀ j, Measurable (f j)) → (∀ i p, Measurable (x i p)) → (∀ k, Measurable (w k)) →
      (∀ p, Measurable (y p)) →
      (∀ c' ∈ C, ∀ s' ∈ sparseStops G H
        (fun z => ENNReal.ofReal (∑ i ∈ s, ∑ p ∈ u, ‖x i p z‖ ^ 2))
        (fun z => ENNReal.ofReal (∑ k ∈ t, ‖w k z‖ ^ 2)) Q,
        ¬ dyadicGridCell G c'.1 c'.2 ⊆ dyadicGridCell G s'.1 s'.2) →
      (∀ c' ∈ C, ∀ d : ℤ × ℤ, dyadicGridCell G c'.1 c'.2 ⊆ dyadicGridCell G d.1 d.2 →
        dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G Q.1 Q.2 → d ∈ H) →
      dyadicEnergyAverage G (fun z => ENNReal.ofReal (∑ i ∈ s, ∑ p ∈ u, ‖x i p z‖ ^ 2)) Q ≠ ⊤ →
      dyadicEnergyAverage G (fun z => ENNReal.ofReal (∑ k ∈ t, ‖w k z‖ ^ 2)) Q ≠ ⊤ →
      ∀ (kernel : ℤ × ℤ → ℝ × ℝ → ℂ), (∀ I ∈ pieceInternal G Q C, IsAdmissibleLocalKernel κ
        (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) (kernel I)) →
      (∀ I ∈ C, kernel I ≠ 0 → d₀ ≤ I.1 ∧ I.1 < d₀ + Nd) →
      (∀ I ∈ C, ∀ j, eLpNorm (f j) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≠ ⊤) →
      (∀ I ∈ C, ∀ i p, eLpNorm (x i p) 2 (normalizedIntervalMeasure
        (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)) ≠ ⊤) →
      (∀ I ∈ C, ∀ k, eLpNorm (w k) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≠ ⊤) →
      (∀ I ∈ C, ∀ p, eLpNorm (y p) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≠ ⊤) →
      ∀ {Bc Bd : ℝ}, 0 ≤ Bc → 0 ≤ Bd →
      (∀ d ∈ pieceInternal G Q C, dyadicEnergyAverage G
        (fun z => ENNReal.ofReal (∑ p ∈ u, ‖y p z‖ ^ 2)) d ≤ ENNReal.ofReal (Bc ^ 2)) →
      (∀ j, j ≠ a → j ≠ b → j ≠ c → ∀ d ∈ pieceInternal G Q C,
        dyadicEnergyAverage G (fun z => ‖f j z‖ₑ ^ 2) d ≤ ENNReal.ofReal (Bd ^ 2)) →
      ∀ (sa : ℤ × ℤ → ι) (sb : ℤ × ℤ → κ'), (∀ I ∈ C, sa I ∈ s) → (∀ I ∈ C, sb I ∈ t) →
      ∀ sg : ℤ × ℤ → ℂ, (∀ I, ‖sg I‖ ≤ 1) →
      ‖∑ I ∈ C, (dyadicGridLength G I.1 : ℂ) * (sg I * ∑ p ∈ u, localProgressionForm
          (dyadicGridLength G I.1) (kernel I) (Function.update (Function.update
            (Function.update f a (x (sa I) p)) b (w (sb I))) c (y p)))‖ₑ ≤
        ENNReal.ofReal (Cq * (1 + finiteDepthConstant κ q Nd) * (1 + Real.log ((K : ℝ) + 2)) *
          ((K : ℝ) + 2) ^ (2 * (q - 2) / (q - 1)) * (64 * Bc * Bd)) *
        (ENNReal.ofReal (dyadicGridLength G Q.1) *
          ((dyadicEnergyAverage G (fun z => ENNReal.ofReal (∑ i ∈ s, ∑ p ∈ u, ‖x i p z‖ ^ 2))
            Q) ^ (1 / 2 : ℝ) *
           (dyadicEnergyAverage G (fun z => ENNReal.ofReal (∑ k ∈ t, ‖w k z‖ ^ 2))
            Q) ^ (1 / 2 : ℝ))) := by
  obtain ⟨Cq, hCq, hpb⟩ := piece_band_bound κ hq2 hq3
  refine ⟨Cq, hCq, ?_⟩
  intro G K Nd d₀ hK H Q C hC hdepth ι κ' ν _ _ _ s t u a b c hab hac hbc f x w y hf hx hw hy
    hown hhull hAa hAb kernel hker hwin hff hxf hwf hyf Bc Bd hBc hBd hcB hdB sa sb hsa hsb sg hsg
  set ga : ℝ → ℝ≥0∞ := fun z => ENNReal.ofReal (∑ i ∈ s, ∑ p ∈ u, ‖x i p z‖ ^ 2)
  set gb : ℝ → ℝ≥0∞ := fun z => ENNReal.ofReal (∑ k ∈ t, ‖w k z‖ ^ 2)
  set! Aa := (dyadicEnergyAverage G ga Q).toReal
  set! Ab := (dyadicEnergyAverage G gb Q).toReal
  set! T := pieceTree Q C hC hK hdepth
  set! sv : Fin 4 → ℝ := fun j => if j = a then Real.sqrt (32 * Aa) else if j = b then
    Real.sqrt (32 * Ab) else if j = c then Real.sqrt 2 * Bc else Real.sqrt 2 * Bd
  have hsv : ∀ j, 0 ≤ sv j := by
    intro j; simp only [sv]; split_ifs <;> positivity
  have hleafE : ∀ L ∈ T.leaves, ∀ (g : ℝ → ℝ≥0∞), dyadicEnergyAverage G g Q ≠ ⊤ →
      ∫⁻ z in dyadicGridCell G L.1 L.2, g z ≤
        32 * ENNReal.ofReal (dyadicGridLength G L.1) * dyadicEnergyAverage G g Q →
      ∫⁻ z in dyadicGridCell G L.1 L.2, g z ≤ ENNReal.ofReal
        (Real.sqrt (32 * (dyadicEnergyAverage G g Q).toReal) ^ 2 * dyadicGridLength G L.1) := by
    intro L _ g hg h
    refine h.trans (le_of_eq ?_)
    rw [Real.sq_sqrt (by positivity), mul_assoc (32 : ℝ), ENNReal.ofReal_mul (by norm_num),
      ENNReal.ofReal_mul ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hg, ENNReal.ofReal_ofNat]
    ring
  have hpl := fun L (hL : L ∈ T.leaves) =>
    piece_leaf_energy G H ga gb Q C hC hown hhull (L := L) hL
  have hint : ∀ L ∈ T.leaves, ∃ p ∈ pieceInternal G Q C, L ∈ dyadicChildren G p := fun L hL =>
    (mem_pieceLeaves.mp hL).2
  have h := hpb G K Nd d₀ T s t u hab hac hbc f x w y hf hx hw hy kernel hker C
    (pieceTree_internal_sup hC hK hdepth) hwin hff hxf hwf hyf sv hsv ?_ ?_ ?_ ?_ sa sb hsa hsb sg
    hsg
  rotate_left
  · intro L hL
    have := hleafE L hL ga hAa (hpl L hL).1
    simpa [sv] using this
  · intro L hL
    have := hleafE L hL gb hAb (hpl L hL).2
    simpa [sv, hab.symm] using this
  · intro L hL
    obtain ⟨p, hp, hLp⟩ := hint L hL
    have := child_lintegral_le_sq G hLp _ (hcB p hp)
    simpa [sv, hac.symm, hbc.symm] using this
  · intro j hja hjb hjc L hL
    obtain ⟨p, hp, hLp⟩ := hint L hL
    have := child_lintegral_le_sq G hLp _ (hdB j hja hjb hjc p hp)
    simpa [sv, hja, hjb, hjc] using this
  have hprod : ∏ j, sv j = 64 * Bc * Bd * (Real.sqrt Aa * Real.sqrt Ab) := by
    rw [prod_fin4_slots hab hac hbc, Real.sqrt_mul (by norm_num), Real.sqrt_mul (by norm_num)]
    have h32 : Real.sqrt 32 * Real.sqrt 32 = 32 := Real.mul_self_sqrt (by norm_num)
    have h2 : Real.sqrt 2 * Real.sqrt 2 = 2 := Real.mul_self_sqrt (by norm_num)
    linear_combination (Real.sqrt Aa * Real.sqrt Ab * Bc * Bd * Real.sqrt 2 * Real.sqrt 2) * h32
      + (32 * Real.sqrt Aa * Real.sqrt Ab * Bc * Bd) * h2
  have hroot : T.root = Q := rfl
  rw [hprod, hroot] at h
  have hCN := (finiteDepthConstant_bounds κ hq2.le Nd).1
  have hlog : 0 ≤ Real.log ((K : ℝ) + 2) := Real.log_nonneg (by linarith [K.cast_nonneg (α := ℝ)])
  have hQ := (dyadicGridLength_pos G Q.1).le
  rw [avg_sqrt_eq hAa, avg_sqrt_eq hAb, ← ofReal_norm,
    ← ENNReal.ofReal_mul (Real.sqrt_nonneg _), ← ENNReal.ofReal_mul hQ,
    ← ENNReal.ofReal_mul (by positivity)]
  refine ENNReal.ofReal_le_ofReal (h.trans (le_of_eq ?_))
  ring

end SparsePieceBound

section SparseRootSum
variable (G : RealDyadicGrid) (H : Finset (ℤ × ℤ)) (ga gb : ℝ → ℝ≥0∞)

/-- The roots of the sparse decomposition lie in the hull and below the initial root. -/
theorem sparseRoots_sub (Q₀ : ℤ × ℤ) (hQ₀ : Q₀ ∈ H) (D : ℕ) {Q : ℤ × ℤ}
    (hQ : Q ∈ sparseRoots G H ga gb Q₀ D) :
    Q ∈ H ∧ dyadicGridCell G Q.1 Q.2 ⊆ dyadicGridCell G Q₀.1 Q₀.2 := by
  classical
  obtain ⟨k, -, hk⟩ := Finset.mem_biUnion.mp hQ
  refine ⟨?_, (sparseGen_sub G H ga gb Q₀ k Q hk).1⟩
  cases k with
  | zero =>
    rw [sparseGen, Finset.mem_singleton] at hk
    rwa [hk]
  | succ k =>
    simp only [sparseGen, Finset.mem_biUnion] at hk
    obtain ⟨P, -, hQP⟩ := hk
    exact (sparseStops_sub G H ga gb P hQP).1

/-- The owner property of a use cell `c`: a sparse root `Q` of one of the hull roots `r ∈ Rt`
containing `c` but no stopping cell of `Q` containing `c`. -/
def SparseOwner (Rt : Finset (ℤ × ℤ)) (K : ℕ) (c Q : ℤ × ℤ) : Prop :=
  ∃ r ∈ Rt, Q ∈ sparseRoots G H ga gb r K ∧
    dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2 ∧
    (∀ s ∈ sparseStops G H ga gb Q, ¬ dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G s.1 s.2) ∧
    dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G r.1 r.2

end SparseRootSum

section SparseRootSum2

open Classical in
/-- Blueprint lines 2430-2445 (summation of the sparse pieces, `eq:near-band`): for each index
`ν` with retained hull `H_ν`, disjoint hull roots `Rt_ν ⊆ H_ν` inside `R`, and use cells `U_ν`
within `K` depths of their root, decompose each root sparsely for the two stack energies and
assign each use to its owning sparse root. If every piece (owned summation cells of one sparse
root) contributes at most `c₀ |Q| a_Q b_Q`, then the total of the absolute index sums is at most
`(8/7) c₀ √(AB) |R|` under the joint hull caps `Σ_ν m_{a,ν} ≤ A`, `Σ_ν m_{b,ν} ≤ B` on `R`. -/
theorem sparse_root_sum (G : RealDyadicGrid) {N : Type*} (Ns : Finset N) (K : ℕ)
    (H Rt U : N → Finset (ℤ × ℤ)) (ga gb : N → ℝ → ℝ≥0∞) {R : Set ℝ} (hRm : MeasurableSet R)
    (hRtH : ∀ ν ∈ Ns, Rt ν ⊆ H ν)
    (hRtdis : ∀ ν ∈ Ns, (Rt ν : Set (ℤ × ℤ)).PairwiseDisjoint fun c => dyadicGridCell G c.1 c.2)
    (hRtR : ∀ ν ∈ Ns, ∀ r ∈ Rt ν, dyadicGridCell G r.1 r.2 ⊆ R)
    (hUH : ∀ ν ∈ Ns, U ν ⊆ H ν)
    (hUr : ∀ ν ∈ Ns, ∀ c ∈ U ν, ∃ r ∈ Rt ν, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G r.1 r.2)
    (hdep : ∀ ν ∈ Ns, ∀ c ∈ U ν, ∀ r ∈ Rt ν,
      dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G r.1 r.2 → c.1 < r.1 + K)
    (hclos : ∀ ν ∈ Ns, ∀ c ∈ U ν, ∀ r ∈ Rt ν, ∀ d : ℤ × ℤ,
      dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 →
      dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G r.1 r.2 → d ∈ H ν)
    {A B : ℝ≥0∞}
    (hA : ∀ x ∈ R, ∑ ν ∈ Ns, dyadicHullMax G (H ν) (ga ν) x ≤ A)
    (hB : ∀ x ∈ R, ∑ ν ∈ Ns, dyadicHullMax G (H ν) (gb ν) x ≤ B)
    (F : N → ℤ × ℤ → ℂ) (c₀ : ℝ≥0∞)
    (hpiece : ∀ ν ∈ Ns, ∀ (Q : ℤ × ℤ) (C : Finset (ℤ × ℤ)), Q ∈ H ν → C ⊆ U ν →
      (∀ c ∈ C, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2) →
      (∀ c ∈ C, c.1 < Q.1 + K) →
      (∀ c ∈ C, ∀ s ∈ sparseStops G (H ν) (ga ν) (gb ν) Q,
        ¬ dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G s.1 s.2) →
      (∀ c ∈ C, ∀ d : ℤ × ℤ, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 →
        dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G Q.1 Q.2 → d ∈ H ν) →
      ‖∑ I ∈ C, F ν I‖ₑ ≤ c₀ * (ENNReal.ofReal (dyadicGridLength G Q.1) *
        ((dyadicEnergyAverage G (ga ν) Q) ^ (1 / 2 : ℝ) *
          (dyadicEnergyAverage G (gb ν) Q) ^ (1 / 2 : ℝ)))) :
    7 * ∑ ν ∈ Ns, ‖∑ I ∈ U ν, F ν I‖ₑ ≤ 8 * c₀ * ((A * B) ^ (1 / 2 : ℝ) * volume R) := by
  set! Qs : N → Finset (ℤ × ℤ) := fun ν =>
    (Rt ν).biUnion fun r => sparseRoots G (H ν) (ga ν) (gb ν) r K
  -- the owner property of a use cell
  set! P : N → ℤ × ℤ → ℤ × ℤ → Prop := fun ν c Q =>
    SparseOwner G (H ν) (ga ν) (gb ν) (Rt ν) K c Q with hPdef
  have hex : ∀ ν ∈ Ns, ∀ c ∈ U ν, ∃ Q, P ν c Q := by
    intro ν hν c hc
    obtain ⟨r, hr, hcr⟩ := hUr ν hν c hc
    obtain ⟨Q, hQ, hcQ, hown, -⟩ := sparse_owner G (H ν) (ga ν) (gb ν) r K (hUH ν hν hc) hcr
      (hdep ν hν c hc r hr hcr).le
    exact ⟨Q, r, hr, hQ, hcQ, hown, hcr⟩
  set! own : N → ℤ × ℤ → ℤ × ℤ := fun ν c => if h : ∃ Q, P ν c Q then h.choose else c
  have hownP : ∀ ν ∈ Ns, ∀ c ∈ U ν, P ν c (own ν c) := by
    intro ν hν c hc
    have h := hex ν hν c hc
    simp only [own, h, ↓reduceDIte]
    exact h.choose_spec
  have hownQ : ∀ ν ∈ Ns, ∀ c ∈ U ν, own ν c ∈ Qs ν := by
    intro ν hν c hc
    obtain ⟨r, hr, hQ, -⟩ := hownP ν hν c hc
    exact Finset.mem_biUnion.mpr ⟨r, hr, hQ⟩
  -- the piece terms
  set! term : N → ℤ × ℤ → ℝ≥0∞ := fun ν Q => ‖∑ I ∈ (U ν).filter (fun c => own ν c = Q), F ν I‖ₑ
  have hsplit : ∀ ν ∈ Ns, ‖∑ I ∈ U ν, F ν I‖ₑ ≤ ∑ Q ∈ Qs ν, term ν Q := by
    intro ν hν
    rw [← Finset.sum_fiberwise_of_maps_to (g := own ν) (hownQ ν hν)]
    exact enorm_sum_le _ _
  -- membership of sparse roots
  have hQmem : ∀ ν ∈ Ns, ∀ Q ∈ Qs ν, ∃ r ∈ Rt ν, Q ∈ H ν ∧
      dyadicGridCell G Q.1 Q.2 ⊆ dyadicGridCell G r.1 r.2 := by
    intro ν hν Q hQ
    obtain ⟨r, hr, hQr⟩ := Finset.mem_biUnion.mp hQ
    obtain ⟨h1, h2⟩ := sparseRoots_sub G (H ν) (ga ν) (gb ν) r (hRtH ν hν hr) K hQr
    exact ⟨r, hr, h1, h2⟩
  have hterm : ∀ ν ∈ Ns, ∀ Q ∈ Qs ν, term ν Q ≤ c₀ * (ENNReal.ofReal (dyadicGridLength G Q.1) *
      ((dyadicEnergyAverage G (ga ν) Q) ^ (1 / 2 : ℝ) *
        (dyadicEnergyAverage G (gb ν) Q) ^ (1 / 2 : ℝ))) := by
    intro ν hν Q hQ
    obtain ⟨r₀, hr₀, hQH, -⟩ := hQmem ν hν Q hQ
    have hP : ∀ c ∈ (U ν).filter (fun c => own ν c = Q), c ∈ U ν ∧ P ν c Q := by
      intro c hc
      obtain ⟨hcU, hcQ⟩ := Finset.mem_filter.mp hc
      exact ⟨hcU, hcQ ▸ hownP ν hν c hcU⟩
    refine hpiece ν hν Q _ hQH (Finset.filter_subset _ _) ?_ ?_ ?_ ?_
    · intro c hc
      obtain ⟨-, r, -, -, hcQ, -⟩ := hP c hc
      exact hcQ
    · intro c hc
      obtain ⟨hcU, r, hr, hQr, hcQ, -, hcr⟩ := hP c hc
      have h1 := hdep ν hν c hcU r hr hcr
      have h2 := dyadicGridCell_depth_le_of_subset G Q r
        (sparseRoots_sub G (H ν) (ga ν) (gb ν) r (hRtH ν hν hr) K hQr).2
      omega
    · intro c hc
      obtain ⟨-, r, -, -, -, hown, -⟩ := hP c hc
      exact hown
    · intro c hc d hcd hdQ
      obtain ⟨hcU, r, hr, hQr, -, -, -⟩ := hP c hc

      ∀ (F : M → Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) (Y : M → β → ColumnL2 (bf.Lab ⊕ Fin fp.Mc))
        (Xs : M → β → ℤ → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) (Wv : M → ℤ × ℤ → ColumnL2 (bf.Lab ⊕ Fin

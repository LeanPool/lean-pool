      (∀ L ∈ T.leaves, ∫⁻ z in dyadicGridCell G L.1 L.2, ENNReal.ofReal (∑ p ∈ u, ‖y p z‖ ^ 2) ≤
        ENNReal.ofReal (sv c ^ 2 * dyadicGridLength G L.1)) →
      (∀ j, j ≠ a → j ≠ b → j ≠ c → ∀ L ∈ T.leaves, ∫⁻ z in dyadicGridCell G L.1 L.2,

  dsimp only at hS
  obtain ⟨S, h1, h2, h3, h4, h5, hV, hH, hT, hK⟩ := hS
  have hΛe : (dmax : ℝ) + Real.log Dstar + Real.log Bstar + Real.log Dm + Real.log Q0 + 1 = Λ :=
    rfl
  rw [hΛe] at hH hT hK
  clear_value Λ

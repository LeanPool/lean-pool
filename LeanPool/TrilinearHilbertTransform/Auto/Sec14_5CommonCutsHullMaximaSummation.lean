  obtain ⟨Cq, hCq, hnb⟩ := leaf_near_bandM κ hq2 hq3
  refine ⟨Cq, hCq, ?_⟩
  intro c₀ A bf fp K Nd hKN hK hanc N Ns U bs hUc hUb ι κ' β _ _ _ s t u a b c hab hac hbc F X W Y

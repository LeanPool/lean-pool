theorem packetW_nonneg (dmax : ℕ) (y : ℝ) : 0 ≤ packetW dmax y := by
  unfold packetW
  have : 0 ≤ Real.log (2 * max 2 y) := Real.log_nonneg (by
    have := le_max_left 2 y; linarith)
  positivity


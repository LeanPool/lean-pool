      (dyadicGridCell_measurable A.G I.1 I.2) (xg b)‖ / Real.sqrt (dyadicGridLength A.G I.1) := by
    positivity
  have hxa0 : 0 ≤ ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)

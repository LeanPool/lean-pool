      (bf.origCol_memLp l s hocc) ((bf.P v.1 v.2.1).Ψ.D.scalar_measurable v.2.2)
  · refine bf.mainCol_mem_range l Mc s (x := Sum.inr n) hn ?_ (catAtom_measurable s n)

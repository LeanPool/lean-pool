  have haf : a ≠ (if st.1 then d else c) := by split_ifs <;> assumption
  have hbe : b ≠ (if st.1 then c else d) := by split_ifs <;> assumption
  have hbf : b ≠ (if st.1 then d else c) := by split_ifs <;> assumption

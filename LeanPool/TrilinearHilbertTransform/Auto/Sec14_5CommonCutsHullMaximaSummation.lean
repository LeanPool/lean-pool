    positivity
  by_cases hU : Unfl
  · simp only [hU, ite_true, add_zero]
    exact fp.nearForm_unflaggedM I hab hae haf hbe hbf hef z _ _ _ Yb (xg b) _ Fb hC₀ hX' hFc

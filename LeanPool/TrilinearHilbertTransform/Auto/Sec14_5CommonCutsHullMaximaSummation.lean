  have hUb : ∀ m ∈ Ms, ∀ c ∈ U m, bs m ≤ c.1 ∧ c.1 < bs m + K := fun m hm c hc => by
    obtain ⟨h1, h2⟩ := hUo m hm c hc
    constructor <;> omega
  have hA : ∀ m ∈ Ms, ∀ I ∈ U m, ∀ p ∈ u m,

    have := Real.log_nonneg (by linarith only [hDm] : (1 : ℝ) ≤ Dm)
    have := Real.log_nonneg (by exact_mod_cast hQ : (1 : ℝ) ≤ Q0)
    have : (0 : ℝ) ≤ dmax := Nat.cast_nonneg _
    simp only [Λ]; linarith

    (hcd : c ≠ d) (G : bf.Grp) (jc jd : ℕ) (D : List (Bool × ℕ × Option ℕ)) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) (xg : Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc))

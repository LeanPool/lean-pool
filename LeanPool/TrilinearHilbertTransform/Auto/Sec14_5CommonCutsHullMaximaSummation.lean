theorem mainCol_mem_range (l : Fin 4) (Mc : ℕ) (s : List (CatCol bf.Vtx)) {I : ℤ × ℤ}
    {x : bf.Lab ⊕ Fin Mc} (hx : bf.Relevant s x)

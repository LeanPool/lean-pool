variable {a b j : ℝ}

/-- The coefficients `y_j = α y_a + β y_b` of the slot `j` in the spectator coordinates. -/
noncomputable def slotAlpha (a b j : ℝ) : ℝ := (b - j) / (b - a)

noncomputable def slotBeta (a b j : ℝ) : ℝ := (j - a) / (b - a)

theorem slot_comb (hab : a ≠ b) (x t : ℝ) :
    slotAlpha a b j * (x + a * t) + slotBeta a b j * (x + b * t) = x + j * t := by
  have h : b - a ≠ 0 := sub_ne_zero.mpr (Ne.symm hab)
  unfold slotAlpha slotBeta; field_simp; ring

theorem slotAlpha_ne (hab : a ≠ b) (hjb : j ≠ b) : slotAlpha a b j ≠ 0 :=
  div_ne_zero (sub_ne_zero.mpr (Ne.symm hjb)) (sub_ne_zero.mpr (Ne.symm hab))

theorem slotBeta_ne (hab : a ≠ b) (hja : j ≠ a) : slotBeta a b j ≠ 0 :=
  div_ne_zero (sub_ne_zero.mpr hja) (sub_ne_zero.mpr (Ne.symm hab))

/-- The kernel-free slot triple as a convolution form. -/
theorem slotTriple_eq (hab : a ≠ b) (hja : j ≠ a) (hjb : j ≠ b) (A B G : ℝ → ℂ) :
    ∫ z : ℝ × ℝ, A (z.1 + a * z.2) * B (z.1 + b * z.2) * G (z.1 + j * z.2) =
      |slotAlpha a b j * slotBeta a b j * (b - a)|⁻¹ •
        ∫ p : ℝ × ℝ, A (-p.1 / slotAlpha a b j) * B (p.2 / slotBeta a b j) * G (p.2 - p.1) := by
  set α := slotAlpha a b j
  set β := slotBeta a b j
  have hα := slotAlpha_ne hab hjb
  have hβ := slotBeta_ne hab hja
  have hba : b - a ≠ 0 := sub_ne_zero.mpr (Ne.symm hab)
  have hdet : (-α) * (β * b) - (-α * a) * β ≠ 0 := by
    have : (-α) * (β * b) - (-α * a) * β = -(α * β * (b - a)) := by ring
    rw [this, neg_ne_zero]; exact mul_ne_zero (mul_ne_zero hα hβ) hba
  have h := integral_comp_plane hdet
    (fun p : ℝ × ℝ => A (-p.1 / α) * B (p.2 / β) * G (p.2 - p.1))
  have hdet' : (-α) * (β * b) - (-α * a) * β = -(α * β * (b - a)) := by ring
  rw [hdet', abs_neg] at h
  rw [← h]
  congr 1; funext z
  have e1 : -(-α * z.1 + -α * a * z.2) / α = z.1 + a * z.2 := by
    rw [div_eq_iff hα]; ring
  have e2 : (β * z.1 + β * b * z.2) / β = z.1 + b * z.2 := by
    rw [div_eq_iff hβ]; ring
  have e3 : β * z.1 + β * b * z.2 - (-α * z.1 + -α * a * z.2) = z.1 + j * z.2 := by
    have := slot_comb (j := j) hab z.1 z.2
    linear_combination this
  simp only [e1, e2, e3]

end SlotTriple


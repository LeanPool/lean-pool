    ∀ (B : QuadraticChartData v.dim) (B' : QuadraticChartData w.dim),
    QuadraticChartComplexity (A.csrc + 1) H B → QuadraticChartComplexity (A.csrc + 1) H B' →
    IsBoundedQuadraticChart B → IsBoundedQuadraticChart B' →

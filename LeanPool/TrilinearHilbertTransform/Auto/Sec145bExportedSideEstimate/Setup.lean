/-! ## The near parts of a leaf (blueprint `eq:near-band`, lines 2425-2443) -/

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideLeafM
variable (T : fp.SideLeafM)

open Classical in
/-- The uses of a near band application have distinct slots `a, b, e` and `a ≠ u`. -/
theorem nU_slots {S : Finset (ℤ × ℤ)} {gs : ℤ × ℤ → Finset bf.Grp} {C₀ : ℝ} {a b e : Fin 4}
    {m : (Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) × bf.Grp × ℕ} {I : ℤ × ℤ}
    (hI : I ∈ T.nU S gs C₀ a b e m) : a ≠ b ∧ a ≠ e ∧ b ≠ e ∧ T.u ≠ some a := by
  have h := (Finset.mem_filter.mp hI).2
  obtain ⟨hab, hac, had, hbc, hbd, -, hau⟩ := h.2.2.1
  have he := h.2.2.2.2.2.2.2.1
  unfold eSlot at he
  refine ⟨hab, ?_, ?_, hau⟩ <;> split_ifs at he <;> subst he <;> assumption

/-- The critical bound of one near band application of the leaf (`near_tripleM` for a basic
untouched side, `near_triple_UM` for the `U` side). -/
noncomputable def nearBnd {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) (Nd N Lp Jm : ℕ) (Mp C₀ ρ : ℝ)
    (Γa Γb : Fin 4 → ℝ) (ΓU : ℝ) (a b e : Fin 4) : ℝ :=
  if a ≠ b ∧ a ≠ e ∧ b ≠ e ∧ T.u ≠ some a then
    (if T.u = some b then
      4 * (nbCUM κ' hq2 hq3 * (1 + finiteDepthConstant κ' q Nd) *
          (1 + Real.log ((T.K : ℝ) + 2)) * ((T.K : ℝ) + 2) ^ (2 * (q - 2) / (q - 1)) *
          (64 * (2 * C₀) * (2 * C₀))) *
        (hullCutConstant (ρ / 2) * (N + 1 : ℕ) * (1 + Real.log (2 + ((N + 1 : ℕ) : ℝ) *
          ((1 : ℕ) : ℝ) * ((nOs Lp Jm).card * Mp * A.famVtxBound)))) *
        Real.sqrt (Γa a * ΓU) / Real.sqrt fp.P * dyadicGridLength A.G A.R.1
    else
      4 * (nbCM κ' hq2 hq3 * (1 + finiteDepthConstant κ' q Nd) *
          (1 + Real.log ((T.K : ℝ) + 2)) * ((T.K : ℝ) + 2) ^ (2 * (q - 2) / (q - 1)) *
          (64 * (2 * C₀) * (2 * C₀))) *
        (hullCutConstant (ρ / 2) * (N + 1 : ℕ) * (1 + Real.log (2 + ((N + 1 : ℕ) : ℝ) *
          ((N + 1 : ℕ) : ℝ) * ((nOs Lp Jm).card * Mp * A.famVtxBound)))) *
        Real.sqrt (Γa a * Γb b) / Real.sqrt fp.P * dyadicGridLength A.G A.R.1)
  else 0

open Classical in
/-- Blueprint `eq:near-band` (lines 2425-2443) on one leaf, on the main columns: one cut family
of root fraction `ρ` (the union of the cut families of the near band applications of all slot
triples, each of root fraction `ρ/64`) such that the near parts of the retained cells, weighted by
length and summed over the groups and slot tuples, are at most the sum over the slot triples of
the critical near-band bounds `nearBnd`. -/
theorem near_sumM {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) (hanc : A.AncClosed) {Nd N : ℕ}
    (hKNd : A.DepthWin Nd) (hKN : T.K ≤ 2 ^ N) (S : Finset (ℤ × ℤ)) (hS : S ⊆ A.cells)
    (gs : ℤ × ℤ → Finset bf.Grp) (gset : Finset bf.Grp) (hgs : ∀ I ∈ S, gs I ⊆ gset)
    (Lp Jm Bn k : ℕ) (hBn : ∀ I ∈ S, T.bk I < Bn) (hLp : ∀ l, (T.pe l).length ≤ Lp)
    (hJm : ∀ c d i i', (T.desc c d (T.tOf c i) (T.tOf d i')).length ≤ Jm)
    (Act : Finset (ℤ × ℤ)) (hact : ∀ I ∈ S, I ∈ Act ∧ ∀ G ∈ gs I, G ∈ fp.groupsAt I k)
    {Mp : ℝ} (hMp : ∀ y, ((Act.filter fun c => y ∈ dyadicGridCell A.G c.1 c.2).card : ℝ) ≤ Mp)
    (okZ : Fin 4 → bf.Grp → ℤ × ℤ → Prop) (BZ EW : Fin 4 → ℝ)
    (hcap : ∀ l, T.u ≠ some l → A.VarCap gset (T.Z l) (okZ l) (BZ l))
    (hok : ∀ l, T.u ≠ some l → ∀ I ∈ S, ∀ G ∈ gs I, ∀ J ∈ A.cells,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2 → okZ l G J)
    (hEW : ∀ l, T.u ≠ some l → ∑ G ∈ gset, ∑ β ∈ Finset.range Bn, ‖columnL2Restriction
      (⋃ J ∈ (S.filter fun I => G ∈ gs I ∧ T.bk I = β).image
        (fun I => ancAt A.G I (A.R.1 + ((T.K * β : ℕ) : ℤ))), dyadicGridCell A.G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
      (T.Wb l G (A.R.1 + ((T.K * β : ℕ) : ℤ)))‖ ^ 2 ≤ EW l)
    {EU : ℝ} (hEU : ∀ l, T.u = some l → ∑ I ∈ S, ∑ G ∈ gs I,
      ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) (T.sv l G I)‖ ^ 2 ≤ EU)
    {C₀ : ℝ} (hC₀ : 0 ≤ C₀) {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) (hP : 1 ≤ fp.P)
    (Γa Γb : Fin 4 → ℝ) (ΓU : ℝ)
    (hΓa : ∀ a, T.u ≠ some a → fp.stackEA (nOs Lp Jm) (T.cat a) (T.mbs a) T.Dpre N (BZ a) (EW a) ≤
      (fp.P + 2) * Γa a * dyadicGridLength A.G A.R.1)
    (hΓb : ∀ b, T.u ≠ some b → (nOs Lp Jm).card * (N * BZ b + EW b) ≤
      Γb b * dyadicGridLength A.G A.R.1)
    (hΓU : (nOs Lp Jm).card * EU ≤ ΓU * dyadicGridLength A.G A.R.1) :
    ∃ Cn : Finset (ℤ × ℤ), Cn ⊆ A.cells ∧
      dyadicRootLength A.G (maximalDyadicCells A.G Cn) ≤ ρ * dyadicGridLength A.G A.R.1 ∧
      ∑ I ∈ S.filter (fun I => ¬ ∃ e' ∈ Cn,
          dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e'.1 e'.2),
        dyadicGridLength A.G I.1 * ∑ G ∈ gs I, ∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4,
          ∑ d : Fin 4, (if T.Val a b c d ∧ ¬ T.Ucase c d then T.nearAbs C₀ a b c d G I else 0) ≤
      ∑ a : Fin 4, ∑ b : Fin 4, ∑ e : Fin 4,
        T.nearBnd hq2 hq3 Nd N Lp Jm Mp C₀ (ρ / 64) Γa Γb ΓU a b e := by
  set! Ms := nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn) with hMs
  have hP : ∀ a b e : Fin 4, ∃ C : Finset (ℤ × ℤ), C ⊆ A.cells ∧
      dyadicRootLength A.G (maximalDyadicCells A.G C) ≤ ρ / 64 * dyadicGridLength A.G A.R.1 ∧
      ((a ≠ b ∧ a ≠ e ∧ b ≠ e ∧ T.u ≠ some a) →
        ∑ m ∈ Ms, ∑ I ∈ (T.nU S gs C₀ a b e m).filter (fun I => ¬ ∃ e' ∈ C,
          dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e'.1 e'.2),
          dyadicGridLength A.G I.1 * ‖(((2 : ℤ) : ℂ) / fp.P) * T.nf a b m.1.1 m.1.2.1 m.2.1
            (T.tOf m.1.1 m.1.2.2.1) (T.tOf m.1.2.1 m.1.2.2.2.1) m.1.2.2.2.2.1 m.1.2.2.2.2.2 I‖ ≤
        T.nearBnd hq2 hq3 Nd N Lp Jm Mp C₀ (ρ / 64) Γa Γb ΓU a b e) := by
    intro a b e
    by_cases h : a ≠ b ∧ a ≠ e ∧ b ≠ e ∧ T.u ≠ some a
    · by_cases hbu : T.u = some b

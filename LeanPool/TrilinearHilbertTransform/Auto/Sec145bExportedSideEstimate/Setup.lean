open Classical in
/-- Blueprint lines 2409 and 2425-2443 (`eq:near-band`) for the slots `a` (basic, `a ≠ u`),
`b = u` (the basic `U` side, its local values used directly as positions) and the banded
complement slot `e` on the main columns: off one cut family of root fraction `ρ`, the frozen near
band forms of the unflagged uses, with the transfer coefficient `2/P`, are at most the critical
bound of `near_band_critical_UM`, with the `U` energy `|outer indices| E_U`. -/
theorem near_triple_UM {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) {a b e : Fin 4} (hab : a ≠ b)
    (hae : a ≠ e) (hbe : b ≠ e) (hau : T.u ≠ some a) (hbu : T.u = some b) (hanc : A.AncClosed)
    {Nd N : ℕ} (hKNd : A.DepthWin Nd) (hKN : T.K ≤ 2 ^ N) (S : Finset (ℤ × ℤ)) (hS : S ⊆ A.cells)
    (gs : ℤ × ℤ → Finset bf.Grp) (gset : Finset bf.Grp) (Lp Jm Bn k : ℕ)
    (Act : Finset (ℤ × ℤ)) (hact : ∀ I ∈ S, I ∈ Act ∧ ∀ G ∈ gs I, G ∈ fp.groupsAt I k)
    {Mp : ℝ} (hMp : ∀ y, ((Act.filter fun c => y ∈ dyadicGridCell A.G c.1 c.2).card : ℝ) ≤ Mp)
    {okA : bf.Grp → ℤ × ℤ → Prop} {BA : ℝ} (hcapA : A.VarCap gset (T.Z a) okA BA)
    (hok : ∀ I ∈ S, ∀ G ∈ gs I, ∀ J ∈ A.cells,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2 → okA G J)
    {EWa EU : ℝ}
    (hEWa : ∑ G ∈ gset, ∑ β ∈ Finset.range Bn, ‖columnL2Restriction
      (⋃ J ∈ (S.filter fun I => G ∈ gs I ∧ T.bk I = β).image
        (fun I => ancAt A.G I (A.R.1 + ((T.K * β : ℕ) : ℤ))), dyadicGridCell A.G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
      (T.Wb a G (A.R.1 + ((T.K * β : ℕ) : ℤ)))‖ ^ 2 ≤ EWa)
    (hEU : ∑ I ∈ S, ∑ G ∈ gs I, ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (T.sv b G I)‖ ^ 2 ≤ EU)
    {C₀ : ℝ} (hC₀ : 0 ≤ C₀) {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) (hP : 1 ≤ fp.P) {Γa Γb : ℝ}
    (hΓa : fp.stackEA (nOs Lp Jm) (T.cat a) (T.mbs a) T.Dpre N BA EWa ≤
      (fp.P + 2) * Γa * dyadicGridLength A.G A.R.1)
    (hΓb : (nOs Lp Jm).card * EU ≤ Γb * dyadicGridLength A.G A.R.1) :
    ∃ C : Finset (ℤ × ℤ), C ⊆ A.cells ∧
      dyadicRootLength A.G (maximalDyadicCells A.G C) ≤ ρ * dyadicGridLength A.G A.R.1 ∧
      ∑ m ∈ nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn), ∑ I ∈ (T.nU S gs C₀ a b e m).filter
          (fun I => ¬ ∃ e' ∈ C, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e'.1 e'.2),
        dyadicGridLength A.G I.1 * ‖(((2 : ℤ) : ℂ) / fp.P) * T.nf a b m.1.1 m.1.2.1 m.2.1
          (T.tOf m.1.1 m.1.2.2.1) (T.tOf m.1.2.1 m.1.2.2.2.1) m.1.2.2.2.2.1 m.1.2.2.2.2.2 I‖ ≤
      4 * (nbCUM κ' hq2 hq3 * (1 + finiteDepthConstant κ' q Nd) *
          (1 + Real.log ((T.K : ℝ) + 2)) * ((T.K : ℝ) + 2) ^ (2 * (q - 2) / (q - 1)) *
          (64 * (2 * C₀) * (2 * C₀))) *
        (hullCutConstant (ρ / 2) * (N + 1 : ℕ) * (1 + Real.log (2 + ((N + 1 : ℕ) : ℝ) *
          ((1 : ℕ) : ℝ) * ((nOs Lp Jm).card * Mp * A.famVtxBound)))) *
        Real.sqrt (Γa * Γb) / Real.sqrt fp.P * dyadicGridLength A.G A.R.1 := by
  classical
  have hR0 := dyadicGridLength_pos A.G A.R.1
  have hRle : ∀ I ∈ A.cells, A.R.1 ≤ I.1 := fun I hI => dyadicGridCell_depth_le_of_subset A.G I A.R
    ((dyadicFiniteTree_mem_iff A.G A.R I A.treeDepth).mp (A.cells_mem_tree hI)).1
  set Ms := nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn) with hMs
  set! U : bf.Grp → ℕ → Finset (ℤ × ℤ) := fun g β => S.filter fun I => g ∈ gs I ∧ T.bk I = β
    with hUdef
  have hU : ∀ g β, ∀ I ∈ U g β, I ∈ A.cells ∧ I.1 = A.R.1 + ((T.K * β + T.offI I : ℕ) : ℤ) ∧
      T.offI I < T.K := by
    intro g β I hI
    obtain ⟨hIS, -, hβ⟩ := Finset.mem_filter.mp hI
    have h := T.bk_offI (hRle I (hS hIS))
    rw [← hβ]
    exact ⟨hS hIS, h.1, h.2.1⟩
  have hoff : ∀ (J : ℤ × ℤ) (β m : ℕ), m < T.K → J.1 = A.R.1 + ((T.K * β + m : ℕ) : ℤ) →
      T.offI J = m := fun J β m hm hJ => T.offI_eq J β m hm hJ
  have hUact : ∀ g β, ∀ I ∈ U g β, I ∈ Act ∧ g ∈ fp.groupsAt I k := fun g β I hI =>
    ⟨(hact I (Finset.mem_filter.mp hI).1).1,
      (hact I (Finset.mem_filter.mp hI).1).2 g (Finset.mem_filter.mp hI).2.1⟩
  have hok' : ∀ g ∈ gset, ∀ β, ∀ I ∈ U g β, ∀ J ∈ A.cells,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2 → okA g J :=
    fun g _ β I hI J hJ hsub => hok I (Finset.mem_filter.mp hI).1 g
      (Finset.mem_filter.mp hI).2.1 J hJ hsub
  -- the block starts of the uses
  have hbs : ∀ m ∈ Ms, ∀ I ∈ T.nU S gs C₀ a b e m,
      A.blkStart T.K I.1 = A.R.1 + ((T.K * m.2.2 : ℕ) : ℤ) := by
    intro m _ I hI
    have hm := Finset.mem_filter.mp hI
    have h := T.bk_offI (hRle I (hS hm.1))
    rw [hm.2.2.1] at h
    exact h.2.2
  set! Fm : (Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) × bf.Grp × ℕ → Fin 4 →
      ColumnL2 (bf.Lab ⊕ Fin fp.Mc) := fun m =>
    Function.update 0 (fSlot m.1.1 m.1.2.1 (T.desc m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1)
      (T.tOf m.1.2.1 m.1.2.2.2.1)) m.1.2.2.2.2.1)
      (fp.FfrM T.cat T.mbs a m.1.1 m.1.2.1 (fp.Lc + 5) m.2.1 (T.Lf.role m.1.1)
        (T.Lf.role m.1.2.1) (T.desc m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1)
          (T.tOf m.1.2.1 m.1.2.2.2.1)) m.1.2.2.2.2.1 (A.R.1 + ((T.K * m.2.2 : ℕ) : ℤ))) with hFm
  set! Ym : (Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) × bf.Grp × ℕ → ℕ → ColumnL2 (bf.Lab ⊕ Fin fp.Mc) :=
    fun m p => fp.YfrM T.cat T.mbs a m.1.1 m.1.2.1 (fp.Lc + 5) m.2.1 (T.Lf.role m.1.1)
      (T.Lf.role m.1.2.1) (T.desc m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1)
        (T.tOf m.1.2.1 m.1.2.2.2.1)) m.1.2.2.2.2.1 m.1.2.2.2.2.2
        (A.R.1 + ((T.K * m.2.2 : ℕ) : ℤ)) p with hYm
  -- the `U` energy over all indices
  have hEUm : ∑ m ∈ Ms, ∑ I ∈ T.nU S gs C₀ a b e m, ‖columnL2Restriction
      (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2) (T.sv b m.2.1 I)‖ ^ 2 ≤
      (nOs Lp Jm).card * EU := by
    have hω : ∀ ω ∈ nOs Lp Jm, ∑ G ∈ gset, ∑ β ∈ Finset.range Bn,
        ∑ I ∈ T.nU S gs C₀ a b e (ω, G, β), ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
          (dyadicGridCell_measurable A.G I.1 I.2) (T.sv b G I)‖ ^ 2 ≤ EU := by
      intro ω _
      refine le_trans ?_ hEU
      calc ∑ G ∈ gset, ∑ β ∈ Finset.range Bn, ∑ I ∈ T.nU S gs C₀ a b e (ω, G, β),
            ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
              (dyadicGridCell_measurable A.G I.1 I.2) (T.sv b G I)‖ ^ 2
          ≤ ∑ G ∈ gset, ∑ β ∈ Finset.range Bn, ∑ I ∈ S.filter (fun I => G ∈ gs I ∧ T.bk I = β),
            ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
              (dyadicGridCell_measurable A.G I.1 I.2) (T.sv b G I)‖ ^ 2 := by
            refine Finset.sum_le_sum fun G _ => Finset.sum_le_sum fun β _ =>
              Finset.sum_le_sum_of_subset_of_nonneg (fun I hI => ?_) fun _ _ _ => sq_nonneg _
            exact Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hI).1,
              (Finset.mem_filter.mp hI).2.1, (Finset.mem_filter.mp hI).2.2.1⟩
        _ ≤ ∑ G ∈ gset, ∑ I ∈ S.filter (fun I => G ∈ gs I),
            ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
              (dyadicGridCell_measurable A.G I.1 I.2) (T.sv b G I)‖ ^ 2 := by
            refine Finset.sum_le_sum fun G _ => ?_
            rw [← Finset.sum_biUnion]
            · refine Finset.sum_le_sum_of_subset_of_nonneg (fun I hI => ?_)
                fun _ _ _ => sq_nonneg _
              obtain ⟨β, -, hβ⟩ := Finset.mem_biUnion.mp hI
              exact Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hβ).1,
                (Finset.mem_filter.mp hβ).2.1⟩
            · intro β _ β' _ hββ
              rw [Function.onFun, Finset.disjoint_left]
              intro I h1 h2
              exact hββ ((Finset.mem_filter.mp h1).2.2.symm.trans (Finset.mem_filter.mp h2).2.2)
        _ ≤ ∑ I ∈ S, ∑ G ∈ gs I, ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
              (dyadicGridCell_measurable A.G I.1 I.2) (T.sv b G I)‖ ^ 2 := by
            rw [Finset.sum_comm' (t' := S) (s' := fun I => gset.filter (fun G => G ∈ gs I))
              (fun G I => by simp only [Finset.mem_filter]; tauto)]
            exact Finset.sum_le_sum fun I _ => Finset.sum_le_sum_of_subset_of_nonneg
              (fun G hG => (Finset.mem_filter.mp hG).2) fun _ _ _ => sq_nonneg _
    calc _ = ∑ ω ∈ nOs Lp Jm, ∑ G ∈ gset, ∑ β ∈ Finset.range Bn,
          ∑ I ∈ T.nU S gs C₀ a b e (ω, G, β), ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
            (dyadicGridCell_measurable A.G I.1 I.2) (T.sv b G I)‖ ^ 2 := by
          rw [hMs, Finset.sum_product]
          refine Finset.sum_congr rfl fun ω _ => ?_
          rw [Finset.sum_product]
      _ ≤ ∑ _ω ∈ nOs Lp Jm, EU := Finset.sum_le_sum hω
      _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]
  have hspec := (Classical.choose_spec (near_band_critical_UM κ' hq2 hq3)).2 A bf fp T.K Nd N
    hKNd T.hK hKN hanc (nOs Lp Jm) gset (Finset.range Bn) k Act U T.offI hoff hU hUact hMp hab
    hae hbe (T.cat a) (T.mbs a) (fun ω => T.Lf.role ω.1) (fun ω => T.Lf.role ω.2.1) T.Dst
    T.Dpre (T.Z a) okA hcapA hok'
    (fun g β => T.Wb a g (A.R.1 + ((T.K * β : ℕ) : ℤ))) hEWa
    (fun g β h => T.Z a g h - T.Z a g (A.R.1 + ((T.K * β : ℕ) : ℤ)) +
      T.Wb a g (A.R.1 + ((T.K * β : ℕ) : ℤ)))
    (fun g β h => rfl) Ms subset_rfl (T.nU S gs C₀ a b e)
    (fun m _ I hI => Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hI).1,
      (Finset.mem_filter.mp hI).2.1, (Finset.mem_filter.mp hI).2.2.1⟩)
    (fun m => fp.uoM m.1.2.2.2.2.2) (fun m _ => Finset.filter_subset _ _)
    (fun m I => T.sv b m.2.1 I) hEUm Fm Ym
    (by positivity : (0 : ℝ) ≤ 2 * C₀) (by positivity : (0 : ℝ) ≤ 2 * C₀) ?_ ?_ hρ hρ1 hP 2
    (by norm_num) hΓa hΓb
  rotate_left
  · intro m hm I hI J hJ hsub hbJ
    have hu := (Finset.mem_filter.mp hI).2.2.2.2.2.2.2.2.2
    have hblk := hbs m hm I hI
    have h := (hu J hJ hsub (by rw [hblk]; exact hbJ)).1
    unfold ActiveSetup.BasicFamilies.FamParams.SideLeafM.desc at h
    rw [hblk] at h
    refine (energyAverage_band_le A.G _ _ J).trans (ENNReal.ofReal_le_ofReal ?_)
    rw [div_le_iff₀ (dyadicGridLength_pos A.G J.1)]
    exact h
  · intro m hm j' hja hjb hje I hI J hJ hsub hbJ
    have hu := (Finset.mem_filter.mp hI).2.2.2.2.2.2.2.2.2
    have hblk := hbs m hm I hI
    have h := (hu J hJ hsub (by rw [hblk]; exact hbJ)).2
    unfold ActiveSetup.BasicFamilies.FamParams.SideLeafM.desc at h
    rw [hblk] at h
    refine (energyAverage_single_le A.G _ J).trans (ENNReal.ofReal_le_ofReal ?_)
    rw [div_le_iff₀ (dyadicGridLength_pos A.G J.1)]
    by_cases hjf : j' = fSlot m.1.1 m.1.2.1 (T.desc m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1)
      (T.tOf m.1.2.1 m.1.2.2.2.1)) m.1.2.2.2.2.1
    · rw [hjf]
      simp only [hFm, Function.update_self]
      exact h
    · simp only [hFm, Function.update_of_ne hjf, Pi.zero_apply, map_zero, norm_zero]
      rw [zero_pow two_ne_zero]
      have := (dyadicGridLength_pos A.G J.1).le
      positivity
  obtain ⟨C, hCc, hlen, hsum⟩ := hspec
  refine ⟨C, hCc, hlen, le_trans (le_of_eq ?_) hsum⟩
  refine Finset.sum_congr rfl fun m hm => Finset.sum_congr rfl fun I hI => ?_
  have hI' := (Finset.mem_filter.mp hI).1
  have hmem := Finset.mem_filter.mp hI'
  have hblk := hbs m hm I hI'
  have hIc := hS hmem.1
  set c := m.1.1
  set d := m.1.2.1
  set G := m.2.1
  set t := T.tOf c m.1.2.2.1
  set t' := T.tOf d m.1.2.2.2.1
  set j := m.1.2.2.2.2.1
  set o := m.1.2.2.2.2.2
  obtain ⟨-, hac, had, hbc, hbd, hcd, -⟩ := hmem.2.2.2.1
  have heS : eSlot c d (T.desc c d t t') j = e := hmem.2.2.2.2.2.2.2.2.1
  have hst : (fp.gStM T.cat T.mbs a c d (fp.Lc + 5) G (T.Lf.role c) (T.Lf.role d)
      (T.desc c d t t') j I.1).1 = ((T.desc c d t t').getD j (true, 0, none)).1 := rfl
  -- the global side of `a` at the depth of the use
  have hga : T.gside a G I.1 = T.Z a G I.1 - T.Z a G (A.R.1 + ((T.K * m.2.2 : ℕ) : ℤ)) +
      T.Wb a G (A.R.1 + ((T.K * m.2.2 : ℕ) : ℤ)) := by
    rw [T.gside_eq a hau G I.1, hblk]
  obtain ⟨z, hz⟩ := T.gside_range a hau G I.1
  have hz' : colRelabel (bf.rv fp.Mc (T.cat a)) z = T.gside a G I.1 := hz
  have hband : ∀ p, T.Xb a c d G t t' j I p =
      (fp.gBandC a (T.cat a) (T.mbs a) G (T.Lf.role c) (T.Lf.role d) (T.Dst m.1) (T.Dpre m.1)
          (p + 1) I.1 -
        fp.gBandC a (T.cat a) (T.mbs a) G (T.Lf.role c) (T.Lf.role d) (T.Dst m.1) (T.Dpre m.1)
          p I.1) (T.Z a G I.1 - T.Z a G (A.R.1 + ((T.K * m.2.2 : ℕ) : ℤ)) +
            T.Wb a G (A.R.1 + ((T.K * m.2.2 : ℕ) : ℤ))) := by
    intro p
    have hj : j < (T.desc c d t t').length := hmem.2.2.2.2.2.2.2.1
    unfold Xb
    rw [← hga, ← hz', fp.gStM_help_band T.cat T.mbs a c d G _ _ _ hj,
      fp.gStM_help_band T.cat T.mbs a c d G _ _ _ hj, sub_apply]
    rfl
  have he' : (if (fp.gStM T.cat T.mbs a c d (fp.Lc + 5) G (T.Lf.role c) (T.Lf.role d)
      (T.desc c d t t') j I.1).1 then c else d) = e := heS
  unfold nf nearFormM Ybk Fbk
  rw [he', hblk]
  refine congrArg (fun z : ℂ => dyadicGridLength A.G I.1 * ‖(((2 : ℤ) : ℂ) / fp.P) * z‖) ?_
  refine Finset.sum_congr rfl fun p _ => fp.Λc_congr_restrictM I fun l => ?_
  rw [hband p]
  by_cases hle : l = e
  · subst hle
    simp only [Function.update_self]
    rfl
  by_cases hlb : l = b
  · subst hlb
    simp only [Function.update_of_ne hle, Function.update_self]
  · simp only [Function.update_of_ne hle, Function.update_of_ne hlb]
    rfl


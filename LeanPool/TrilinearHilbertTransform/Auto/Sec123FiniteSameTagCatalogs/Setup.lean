  have hc : ENNReal.ofReal |(LinearMap.det f)⁻¹| ≠ 0 := by
    rw [Ne, ENNReal.ofReal_eq_zero, not_le]; exact abs_pos.mpr (inv_ne_zero hf)
  have h1 : Integrable (fun v => (g ∘ e) (f v)) := by
    have : Integrable (g ∘ e) (Measure.map f volume) := by

theorem planeMatrix_det (p q r s : ℝ) : (planeMatrix p q r s).det = p * s - q * r := by
  simp [planeMatrix, Matrix.det_fin_two]

/-- Linear change of variables in the plane. -/
theorem integral_comp_plane {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {p q r s : ℝ} (hdet : p * s - q * r ≠ 0) (g : ℝ × ℝ → E) :

  have hM : M.det ≠ 0 := by rw [planeMatrix_det]; exact hdet
  set! f : (Fin 2 → ℝ) →ₗ[ℝ] (Fin 2 → ℝ) := Matrix.toLin' M
  have hf : LinearMap.det f ≠ 0 := by rw [LinearMap.det_toLin']; exact hM
  have hmap := MeasureTheory.Measure.map_linearMap_addHaar_eq_smul_addHaar
    (μ := (volume : Measure (Fin 2 → ℝ))) hf
  set e := MeasurableEquiv.finTwoArrow (α := ℝ)
  have he : MeasurePreserving e volume volume := volume_preserving_finTwoArrow ℝ
  -- transport to `Fin 2 → ℝ`
  have h1 : ∫ z : ℝ × ℝ, g (p * z.1 + q * z.2, r * z.1 + s * z.2) =
      ∫ v : Fin 2 → ℝ, g (e (f v)) := by
    rw [← he.integral_comp' (g := fun z : ℝ × ℝ => g (p * z.1 + q * z.2, r * z.1 + s * z.2))]
    congr 1; funext v
    simp [e, f, M, planeMatrix, Matrix.toLin'_apply, dotProduct, Fin.sum_univ_two,
      MeasurableEquiv.finTwoArrow]
  have hinj : Function.Injective f := by
    have hu : IsUnit M := (Matrix.isUnit_iff_isUnit_det M).mpr (isUnit_iff_ne_zero.mpr hM)
    intro v w hvw
    exact Matrix.mulVec_injective_iff_isUnit.mpr hu hvw
  have hemb : MeasurableEmbedding f :=
    (LinearMap.isClosedEmbedding_of_injective (LinearMap.ker_eq_bot.mpr hinj)).measurableEmbedding
  have h2 : ∫ v : Fin 2 → ℝ, g (e (f v)) = ∫ v, (g ∘ e) v ∂(Measure.map f volume) :=
    (hemb.integral_map (g ∘ e)).symm
  have h3 : ∫ x, (g ∘ e) x = ∫ z, g z := he.integral_comp' g
  rw [h1, h2, hmap, integral_smul_measure, h3, LinearMap.det_toLin', planeMatrix_det]
  congr 1
  rw [ENNReal.toReal_ofReal (abs_nonneg _), abs_inv]


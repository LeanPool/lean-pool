theorem scaled_integrable {A : ℝ → ℂ} (hA : Integrable A) {R : ℝ} (hR : R ≠ 0) :
    Integrable (fun x => A (R * x)) := hA.comp_mul_left' hR

theorem scaled_memLp_two {A : ℝ → ℂ} (hAm : Measurable A) (hA2 : MemLp A 2) {R : ℝ}
    (hR : R ≠ 0) : MemLp (fun x => A (R * x)) 2 := by
  have hm : AEStronglyMeasurable (fun x => A (R * x)) volume :=
    (hAm.comp (measurable_const.mul measurable_id)).aestronglyMeasurable
  rw [memLp_two_iff_integrable_sq_norm hm]
  have h := (memLp_two_iff_integrable_sq_norm hAm.aestronglyMeasurable).mp hA2
  exact h.comp_mul_left' hR

theorem scaled_sq_integral (A : ℝ → ℂ) {R : ℝ} (_hR : R ≠ 0) :
    ∫ x, ‖A (R * x)‖ ^ 2 = |R|⁻¹ * ∫ x, ‖A x‖ ^ 2 := by
  have h := Measure.integral_comp_mul_left (fun x => ‖A x‖ ^ 2) R
  rw [h, smul_eq_mul, abs_inv]

variable {a b j : ℝ}

/-- The kernel-free slot triple is bounded by the Fourier supremum of the slot-`j` input
times the `L²` norms of the spectator inputs (Plancherel for the convolution form). -/
theorem slotTriple_norm_le (hab : a ≠ b) (hja : j ≠ a) (hjb : j ≠ b) {A B G : ℝ → ℂ}
    (hAm : Measurable A) (hBm : Measurable B) (hA1 : Integrable A) (hA2 : MemLp A 2)
    (hB1 : Integrable B) (hB2 : MemLp B 2) (hG1 : Integrable G) {M : ℝ}
    (hM : ∀ ξ, ‖𝓕 G ξ‖ ≤ M) :
    ‖∫ z : ℝ × ℝ, A (z.1 + a * z.2) * B (z.1 + b * z.2) * G (z.1 + j * z.2)‖ ≤
      |slotAlpha a b j * slotBeta a b j * (b - a)|⁻¹ * M *
        Real.sqrt (|slotAlpha a b j| * ∫ x, ‖A x‖ ^ 2) *
        Real.sqrt (|slotBeta a b j| * ∫ x, ‖B x‖ ^ 2) := by
  set α := slotAlpha a b j
  set β := slotBeta a b j
  have hα := slotAlpha_ne hab hjb
  have hβ := slotBeta_ne hab hja
  rw [slotTriple_eq hab hja hjb, norm_smul, Real.norm_eq_abs, abs_inv, abs_abs]
  have hRa : -α⁻¹ ≠ 0 := neg_ne_zero.mpr (inv_ne_zero hα)
  have hRb : β⁻¹ ≠ 0 := inv_ne_zero hβ
  have eF : (fun x => A (-x / α)) = fun x => A (-α⁻¹ * x) := by
    funext x; congr 1; field_simp
  have eH : (fun y => B (y / β)) = fun y => B (β⁻¹ * y) := by
    funext y; congr 1; field_simp
  have h := norm_integral_convolution_form_le (F := fun x => A (-x / α))
    (G := fun y => B (y / β)) (K := G)
    (by rw [eF]; exact scaled_integrable hA1 hRa) (by rw [eF]; exact scaled_memLp_two hAm hA2 hRa)
    (by rw [eH]; exact scaled_integrable hB1 hRb) (by rw [eH]; exact scaled_memLp_two hBm hB2 hRb)
    hG1 hM
  have hFn : ∫ x, ‖A (-x / α)‖ ^ 2 = |α| * ∫ x, ‖A x‖ ^ 2 := by
    have := scaled_sq_integral A hRa
    rw [abs_neg, abs_inv, inv_inv] at this
    rw [show (fun x => ‖A (-x / α)‖ ^ 2) = fun x => ‖A (-α⁻¹ * x)‖ ^ 2 from by
      funext x; rw [show -x / α = -α⁻¹ * x by field_simp]]
    exact this
  have hHn : ∫ y, ‖B (y / β)‖ ^ 2 = |β| * ∫ x, ‖B x‖ ^ 2 := by
    have := scaled_sq_integral B hRb
    rw [abs_inv, inv_inv] at this
    rw [show (fun y => ‖B (y / β)‖ ^ 2) = fun y => ‖B (β⁻¹ * y)‖ ^ 2 from by
      funext y; rw [show y / β = β⁻¹ * y by field_simp]]
    exact this
  rw [hFn, hHn] at h
  have h0 : 0 ≤ |α * β * (b - a)|⁻¹ := inv_nonneg.mpr (abs_nonneg _)
  calc |α * β * (b - a)|⁻¹ * ‖∫ p : ℝ × ℝ, A (-p.1 / α) * B (p.2 / β) * G (p.2 - p.1)‖
      ≤ |α * β * (b - a)|⁻¹ * (M * Real.sqrt (|α| * ∫ x, ‖A x‖ ^ 2) *
          Real.sqrt (|β| * ∫ x, ‖B x‖ ^ 2)) := mul_le_mul_of_nonneg_left h h0
    _ = _ := by ring

/-- Integrability of a slot triple of `L¹ ∩ L²` spectators against an `L¹` input. -/
theorem slotTriple_integrable (_hab : a ≠ b) (hja : j ≠ a) (hjb : j ≠ b) {A B G : ℝ → ℂ}
    (hAm : Measurable A) (hBm : Measurable B) (hGm : Measurable G) (hA2 : MemLp A 2)
    (hB2 : MemLp B 2) (hG1 : Integrable G) :
    Integrable (fun z : ℝ × ℝ => A (z.1 + a * z.2) * B (z.1 + b * z.2) * G (z.1 + j * z.2)) := by
  -- dominated by `|G(y_j)| (|A(y_a)|² + |B(y_b)|²) / 2`
  have hA' := (memLp_two_iff_integrable_sq_norm hAm.aestronglyMeasurable).mp hA2
  have hB' := (memLp_two_iff_integrable_sq_norm hBm.aestronglyMeasurable).mp hB2
  have hdetA : (1 : ℝ) * a - j * 1 ≠ 0 := by
    have : (1 : ℝ) * a - j * 1 = a - j := by ring
    rw [this]; exact sub_ne_zero.mpr (Ne.symm hja)
  have hdetB : (1 : ℝ) * b - j * 1 ≠ 0 := by
    have : (1 : ℝ) * b - j * 1 = b - j := by ring
    rw [this]; exact sub_ne_zero.mpr (Ne.symm hjb)
  have hIA := integrable_comp_plane hdetA (hG1.norm.mul_prod hA')
  have hIB := integrable_comp_plane hdetB (hG1.norm.mul_prod hB')
  have hdom : Integrable (fun z : ℝ × ℝ =>
      ‖G (z.1 + j * z.2)‖ * ‖A (z.1 + a * z.2)‖ ^ 2 +
        ‖G (z.1 + j * z.2)‖ * ‖B (z.1 + b * z.2)‖ ^ 2) := by
    refine (hIA.add hIB).congr (Filter.Eventually.of_forall fun z => ?_)
    simp only [one_mul, Pi.add_apply]
  refine Integrable.mono' hdom ?_ (Filter.Eventually.of_forall fun z => ?_)
  · exact (((hAm.comp (measurable_fst.add (measurable_const.mul measurable_snd))).mul
      (hBm.comp (measurable_fst.add (measurable_const.mul measurable_snd)))).mul
      (hGm.comp (measurable_fst.add (measurable_const.mul measurable_snd)))).aestronglyMeasurable
  · rw [norm_mul, norm_mul]
    have h1 := norm_nonneg (A (z.1 + a * z.2))
    have h2 := norm_nonneg (B (z.1 + b * z.2))
    have h3 := norm_nonneg (G (z.1 + j * z.2))
    nlinarith [sq_nonneg (‖A (z.1 + a * z.2)‖ - ‖B (z.1 + b * z.2)‖)]

end SlotTriple

theorem fin4_slot_sep {a b : Fin 4} (hab : a ≠ b) : 1 ≤ |((b : ℕ) : ℝ) - ((a : ℕ) : ℝ)| := by
  have hne : (a : ℕ) ≠ (b : ℕ) := fun h => hab (Fin.ext h)
  have ha := a.isLt; have hb := b.isLt
  rcases Nat.lt_or_gt_of_ne hne with h | h
  · have : (1 : ℝ) ≤ ((b : ℕ) : ℝ) - (a : ℕ) := by
      have : ((a : ℕ) : ℝ) + 1 ≤ (b : ℕ) := by exact_mod_cast h
      linarith only [this]
    rw [abs_of_pos (by linarith)]; exact this
  · have : (1 : ℝ) ≤ ((a : ℕ) : ℝ) - (b : ℕ) := by
      have : ((b : ℕ) : ℝ) + 1 ≤ (a : ℕ) := by exact_mod_cast h
      linarith
    rw [abs_sub_comm, abs_of_pos (by linarith)]; exact this

theorem fin4_slot_le (a b : Fin 4) : |((b : ℕ) : ℝ) - ((a : ℕ) : ℝ)| ≤ 3 := by
  have ha := a.isLt; have hb := b.isLt
  rw [abs_le]
  constructor
  · have : ((a : ℕ) : ℝ) ≤ 3 := by exact_mod_cast (by omega : (a : ℕ) ≤ 3)
    have : (0 : ℝ) ≤ (b : ℕ) := Nat.cast_nonneg _
    linarith
  · have : ((b : ℕ) : ℝ) ≤ 3 := by exact_mod_cast (by omega : (b : ℕ) ≤ 3)
    have : (0 : ℝ) ≤ (a : ℕ) := Nat.cast_nonneg _
    linarith

/-- The slot-triple constant is at most `3` for distinct slots of `Fin 4`. -/
theorem slotConst_le {a b j : Fin 4} (hab : a ≠ b) (hja : j ≠ a) (hjb : j ≠ b) :
    let ar : ℝ := ((a : ℕ) : ℝ)
    let br : ℝ := ((b : ℕ) : ℝ)
    let jr : ℝ := ((j : ℕ) : ℝ)
    |slotAlpha ar br jr * slotBeta ar br jr * (br - ar)|⁻¹ * Real.sqrt |slotAlpha ar br jr| *
      Real.sqrt |slotBeta ar br jr| ≤ 3 := by
  intro ar br jr
  have h1 := fin4_slot_sep hab
  have h2 := fin4_slot_sep (Ne.symm hjb)
  have h3 := fin4_slot_sep hja
  have h4 := fin4_slot_le a b
  have hba : br - ar ≠ 0 := by intro h; rw [h, abs_zero] at h1; norm_num at h1
  have hαa : |slotAlpha ar br jr| = |br - jr| / |br - ar| := by
    unfold slotAlpha; rw [abs_div]
  have hβa : |slotBeta ar br jr| = |jr - ar| / |br - ar| := by
    unfold slotBeta; rw [abs_div]
  have h2' : 1 ≤ |br - jr| := by
    rw [abs_sub_comm]; exact h2
  have h3' : 1 ≤ |jr - ar| := by
    rw [abs_sub_comm]; exact h3
  have h4' : |br - ar| ≤ 3 := h4
  have hα3 : 1 / 3 ≤ |slotAlpha ar br jr| := by
    rw [hαa, le_div_iff₀ (by linarith only [h1])]
    linarith only [h4, h2']
  have hβ3 : 1 / 3 ≤ |slotBeta ar br jr| := by
    rw [hβa, le_div_iff₀ (by linarith)]
    linarith
  set p := |slotAlpha ar br jr|
  set q := |slotBeta ar br jr|
  have hp0 : 0 < p := by linarith
  have hq0 : 0 < q := by linarith
  rw [abs_mul, abs_mul]
  have hsp := Real.sq_sqrt hp0.le
  have hsq := Real.sq_sqrt hq0.le
  have hsp0 := Real.sqrt_pos.mpr hp0
  have hsq0 := Real.sqrt_pos.mpr hq0
  have hs1 : 1 / 3 ≤ Real.sqrt p * Real.sqrt q := by
    rw [← Real.sqrt_mul hp0.le]
    calc (1 / 3 : ℝ) = Real.sqrt (1 / 9) := by
          rw [show (1 / 9 : ℝ) = (1 / 3) ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
      _ ≤ Real.sqrt (p * q) := Real.sqrt_le_sqrt (by nlinarith only [hα3, hβ3])
  have hpq : p * q = (Real.sqrt p * Real.sqrt q) ^ 2 := by
    rw [mul_pow, hsp, hsq]
  rw [hpq]
  set u := Real.sqrt p * Real.sqrt q
  have hu0 : 0 < u := by positivity
  rw [show (u ^ 2 * |br - ar|)⁻¹ * Real.sqrt p * Real.sqrt q = (u * |br - ar|)⁻¹ by
    rw [mul_assoc]; change (u ^ 2 * |br - ar|)⁻¹ * u = _
    field_simp]
  rw [inv_le_comm₀ (by positivity) (by norm_num)]
  nlinarith only [h1, hs1]




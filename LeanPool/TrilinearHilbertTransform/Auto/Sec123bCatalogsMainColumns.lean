    have hc : (Fintype.card (W l I) : ℝ) ≤ Kt := by exact_mod_cast hKt l I
    calc (Fintype.card (W l I) : ℝ) * Q * (2 * H₀ * Dv / τ₃) ^ 2 * n (fp.Lc + 4)

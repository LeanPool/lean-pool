end ActiveSetup.BasicFamilies.FamParams

/-! ### Sizes of the closure (blueprint lem:closure, lines 1820, 1823, 1828-1830) -/


namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

/-- The mask names at a cell (blueprint line 1823): a cumulative split `m ≤ L` with a pad
`h ≤ H_max`, or an original vertex present at the cell (naming its group) with a pad. -/
abbrev MaskName (I : ℤ × ℤ) : Type :=
  (Fin (fp.Lc + 1) × Fin (fp.Hmax + 1)) ⊕ ({x // x ∈ bf.admT.X (bf.admAt I)} × Fin (fp.Hmax + 1))

open Classical in
/-- The vertex mask of a mask name: the cumulative mask `U_{m,h}` or the ball mask of the group of
the vertex at the pad `h`. -/
def maskOf (I : ℤ × ℤ) : fp.MaskName I → bf.Vtx → Prop
  | Sum.inl (m, h) => fun x => x ∈ fp.K.cumMask bf.admT A.famVtxBound m h (bf.admAt I)
  | Sum.inr (v, h) => fun x => x ∈ fp.K.mask bf.admT A.famVtxBound
      (fp.K.grp bf.admT A.famVtxBound (bf.admAt I) v.1) h (bf.admAt I)

/-- The cumulative masks of the filters are named. -/
theorem cmask_named (I : ℤ × ℤ) {m p : ℕ} (hm : m ≤ fp.Lc) (hp : p ≤ fp.P) :
    ∃ M : fp.MaskName I, fp.maskOf I M = fp.cmask I m p :=
  ⟨Sum.inl (⟨m, by omega⟩, ⟨fp.cbase m + p, by have := fp.cbase_le (m := m) hp; omega⟩), rfl⟩

open Classical in
/-- The ball masks of the filters of the groups of present vertices are named. -/
theorem bmask_named (I : ℤ × ℤ) {v : bf.Vtx} (hv : v ∈ bf.admT.X (bf.admAt I)) {j p : ℕ}
    (hj : j ≤ 4) (hp : p ≤ fp.P) :
    ∃ M : fp.MaskName I, fp.maskOf I M =
      fp.bmask I (fp.K.grp bf.admT A.famVtxBound (bf.admAt I) v) j p :=
  ⟨Sum.inr (⟨v, hv⟩, ⟨fp.bbase j + p, by have := fp.bbase_le hj hp; omega⟩), rfl⟩

/-- The names of the main tests of a slot at a cell with base names `Bn` (blueprint lines
1809-1815, 1823): a target rank `1 ≤ r ≤ L + 5` (stored as `r - 1`), a target mask name, a
history of at most `m` factors, each a rank, a mask name and a complement flag, and a base name. -/
abbrev TestName (I : ℤ × ℤ) (Bn : Type) : Type :=
  Fin (fp.Lc + 5) × fp.MaskName I ×
    (Σ ℓ : Fin (fp.mH + 1), Fin ℓ → Fin (fp.Lc + 6) × fp.MaskName I × Bool) × Bn

/-- The main test of a name, with the base vectors `base` (blueprint lines 1809-1815). -/
noncomputable def testOf (l : Fin 4) (I : ℤ × ℤ) {Bn : Type}
    (base : Bn → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) (w : fp.TestName I Bn) :
    MainTest bf.Vtx bf.Lab fp.Mc where
  t := l
  r := w.1 + 1
  M := fp.maskOf I w.2.1
  m := w.2.2.1.1
  hr := fun i => if h : i < w.2.2.1.1 then (w.2.2.1.2 ⟨i, h⟩).1 else 0
  hM := fun i => if h : i < w.2.2.1.1 then fp.maskOf I (w.2.2.1.2 ⟨i, h⟩).2.1 else fun _ => False
  θ := fun i => if h : i < w.2.2.1.1 then (w.2.2.1.2 ⟨i, h⟩).2.2 else false
  base := base w.2.2.2

theorem testOf_t (l : Fin 4) (I : ℤ × ℤ) {Bn : Type}
    (base : Bn → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) (w : fp.TestName I Bn) :
    (fp.testOf l I base w).t = l := rfl

theorem testOf_r (l : Fin 4) (I : ℤ × ℤ) {Bn : Type}
    (base : Bn → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) (w : fp.TestName I Bn) :
    1 ≤ (fp.testOf l I base w).r ∧ (fp.testOf l I base w).r ≤ fp.Lc + 5 := by
  change 1 ≤ (w.1 : ℕ) + 1 ∧ (w.1 : ℕ) + 1 ≤ fp.Lc + 5
  have := w.1.2
  omega

theorem card_maskName_le (I : ℤ × ℤ) :
    Fintype.card (fp.MaskName I) ≤ (fp.Lc + 1 + A.famVtxBound) * (fp.Hmax + 1) := by
  rw [Fintype.card_sum, Fintype.card_prod, Fintype.card_prod, Fintype.card_fin, Fintype.card_fin,
    Fintype.card_coe]
  have := bf.admT_X_card_le (bf.admAt I)
  nlinarith

theorem sum_pow_le (N m : ℕ) (hN : 1 ≤ N) :
    ∑ ℓ : Fin (m + 1), N ^ (ℓ : ℕ) ≤ (m + 1) * N ^ m := by
  calc ∑ ℓ : Fin (m + 1), N ^ (ℓ : ℕ) ≤ ∑ _ℓ : Fin (m + 1), N ^ m :=
        Finset.sum_le_sum fun ℓ _ => Nat.pow_le_pow_right hN (by omega)
    _ = (m + 1) * N ^ m := by simp

/-- The number of test names at a cell (blueprint line 1823). -/
theorem card_testName_le (I : ℤ × ℤ) (Bn : Type) [Fintype Bn] :
    Fintype.card (fp.TestName I Bn) ≤ (fp.Lc + 5) * ((fp.Lc + 1 + A.famVtxBound) * (fp.Hmax + 1)) *
      ((fp.mH + 1) * ((fp.Lc + 6) * ((fp.Lc + 1 + A.famVtxBound) * (fp.Hmax + 1)) * 2) ^ fp.mH) *
        Fintype.card Bn := by
  have hM := fp.card_maskName_le I
  rw [Fintype.card_prod, Fintype.card_prod, Fintype.card_prod, Fintype.card_fin, Fintype.card_sigma]
  simp only [Fintype.card_fun, Fintype.card_prod, Fintype.card_fin, Fintype.card_bool]
  set NM := (fp.Lc + 1 + A.famVtxBound) * (fp.Hmax + 1) with hNM
  have h1 : ∑ ℓ : Fin (fp.mH + 1), ((fp.Lc + 6) * (Fintype.card (fp.MaskName I) * 2)) ^ (ℓ : ℕ) ≤
      (fp.mH + 1) * ((fp.Lc + 6) * NM * 2) ^ fp.mH := by
    have hb : (fp.Lc + 6) * (Fintype.card (fp.MaskName I) * 2) ≤ (fp.Lc + 6) * NM * 2 := by
      rw [mul_assoc]; exact Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ hM)
    refine le_trans (Finset.sum_le_sum fun ℓ _ => Nat.pow_le_pow_left hb _) ?_
    exact sum_pow_le _ _ (Nat.one_le_iff_ne_zero.mpr (by positivity))
  calc (fp.Lc + 5) * (Fintype.card (fp.MaskName I) *
        ((∑ ℓ : Fin (fp.mH + 1), ((fp.Lc + 6) * (Fintype.card (fp.MaskName I) * 2)) ^ (ℓ : ℕ)) *
          Fintype.card Bn))
      ≤ (fp.Lc + 5) * (NM * (((fp.mH + 1) * ((fp.Lc + 6) * NM * 2) ^ fp.mH) *
          Fintype.card Bn)) := by gcongr
    _ = _ := by ring

end ActiveSetup.BasicFamilies.FamParams

/-- The test-name count is `exp(k^{O(1)})` (blueprint line 1823): with `L + 6 ≤ k^c`, vertex bound,
pad bound and base-name count at most `exp(k^c)` and histories of length at most
`c (1 + log k)`, the count of `card_testName_le` is at most `exp(k^{c+2})`. -/
theorem names_count_poly (c : ℕ) {k : ℝ} (hk : 6 * c + 6 ≤ k) (Lc D Hmax mH b : ℕ)
    (hL : (Lc + 6 : ℝ) ≤ k ^ c) (hD : (D : ℝ) ≤ Real.exp (k ^ c))
    (hH : (Hmax + 1 : ℝ) ≤ Real.exp (k ^ c)) (hm : (mH : ℝ) ≤ c * (Real.log k + 1))
    (hb : (b : ℝ) ≤ Real.exp (k ^ c)) :
    (((Lc + 6) * ((Lc + 1 + D) * (Hmax + 1)) *
      ((mH + 1) * ((Lc + 6) * ((Lc + 1 + D) * (Hmax + 1)) * 2) ^ mH) * b : ℕ) : ℝ) ≤
        Real.exp (k ^ (c + 2)) := by
  have hk1 : 1 ≤ k := le_trans (by have := Nat.cast_nonneg (α := ℝ) c; linarith) hk
  have hc0 : (0 : ℝ) ≤ c := Nat.cast_nonneg c
  set E := Real.exp (k ^ c) with hE
  have hkc : 1 ≤ k ^ c := one_le_pow₀ hk1
  have hkE : k ^ c ≤ E := by have := Real.add_one_le_exp (k ^ c); linarith
  have hE2 : 2 ≤ E := by have := Real.add_one_le_exp (k ^ c); linarith
  have hE0 : 0 < E := by linarith
  have a1 : (Lc + 6 : ℝ) ≤ E := hL.trans hkE
  have a2 : (Lc + 1 + D : ℝ) ≤ 2 * E := by linarith
  have a3 : ((Lc + 1 + D) * (Hmax + 1) : ℝ) ≤ 2 * E * E :=
    mul_le_mul a2 hH (by positivity) (by positivity)
  have a4 : ((Lc + 6) * ((Lc + 1 + D) * (Hmax + 1)) * 2 : ℝ) ≤ E ^ 5 := by
    have : ((Lc + 6) * ((Lc + 1 + D) * (Hmax + 1)) : ℝ) ≤ E * (2 * E * E) :=
      mul_le_mul a1 a3 (by positivity) (by positivity)
    have h4 : (4 : ℝ) ≤ E ^ 2 := by nlinarith only [hL, hkE]
    calc ((Lc + 6) * ((Lc + 1 + D) * (Hmax + 1)) * 2 : ℝ) ≤ E * (2 * E * E) * 2 := by linarith
      _ = 4 * E ^ 3 := by ring
      _ ≤ E ^ 2 * E ^ 3 := mul_le_mul_of_nonneg_right h4 (by positivity)
      _ = E ^ 5 := by ring
  have a5 : ((mH + 1 : ℕ) : ℝ) ≤ E ^ mH := by
    have h1 : mH + 1 ≤ 2 ^ mH := Nat.lt_two_pow_self
    calc ((mH + 1 : ℕ) : ℝ) ≤ ((2 ^ mH : ℕ) : ℝ) := by exact_mod_cast h1
      _ = 2 ^ mH := by push_cast; ring
      _ ≤ E ^ mH := pow_le_pow_left₀ (by norm_num) hE2 mH
  have a6 : (((mH + 1) * ((Lc + 6) * ((Lc + 1 + D) * (Hmax + 1)) * 2) ^ mH : ℕ) : ℝ) ≤
      E ^ (6 * mH) := by
    push_cast
    calc ((mH : ℝ) + 1) * (((Lc : ℝ) + 6) * (((Lc : ℝ) + 1 + D) * ((Hmax : ℝ) + 1)) * 2) ^ mH
        ≤ E ^ mH * (E ^ 5) ^ mH := by
          refine mul_le_mul (by exact_mod_cast a5) (pow_le_pow_left₀ (by positivity) a4 mH)
            (by positivity) (by positivity)
      _ = E ^ (6 * mH) := by rw [← pow_mul, ← pow_add]; ring_nf
  have a7 : (((Lc + 6) * ((Lc + 1 + D) * (Hmax + 1)) : ℕ) : ℝ) ≤ 2 * E ^ 3 := by
    push_cast
    calc ((Lc : ℝ) + 6) * (((Lc : ℝ) + 1 + D) * ((Hmax : ℝ) + 1)) ≤ E * (2 * E * E) :=
          mul_le_mul a1 a3 (by positivity) (by positivity)
      _ = 2 * E ^ 3 := by ring
  have htot : (((Lc + 6) * ((Lc + 1 + D) * (Hmax + 1)) *
      ((mH + 1) * ((Lc + 6) * ((Lc + 1 + D) * (Hmax + 1)) * 2) ^ mH) * b : ℕ) : ℝ) ≤
        E ^ (5 + 6 * mH) := by
    rw [Nat.cast_mul, Nat.cast_mul]
    calc _ ≤ 2 * E ^ 3 * E ^ (6 * mH) * E := by
          refine mul_le_mul (mul_le_mul a7 a6 (by positivity) (by positivity)) hb
            (by positivity) (by positivity)
      _ ≤ E * E ^ 3 * E ^ (6 * mH) * E := by gcongr
      _ = E ^ (5 + 6 * mH) := by ring
  refine htot.trans ?_
  rw [hE, ← Real.exp_nat_mul]
  apply Real.exp_le_exp.mpr
  have hlog : Real.log k ≤ k := (Real.log_le_sub_one_of_pos (by linarith)).trans (by linarith)
  have hm' : (mH : ℝ) ≤ c * (k + 1) := hm.trans (by nlinarith only [hlog])
  have hk2 : (5 : ℝ) + 6 * (c * (k + 1)) ≤ k ^ 2 := by nlinarith only [hk]
  calc ((5 + 6 * mH : ℕ) : ℝ) * k ^ c ≤ (5 + 6 * (c * (k + 1))) * k ^ c := by
        push_cast
        exact mul_le_mul_of_nonneg_right (by linarith) (by positivity)
    _ ≤ k ^ 2 * k ^ c := mul_le_mul_of_nonneg_right hk2 (by positivity)
    _ = k ^ (c + 2) := by ring


/-- Blueprint lem:closure, lines 1820 and 1828: with `L + 6 ≤ k^c` ranks, histories of length at
most `c (1 + log k)`, closure data `1 + (L + 6) M_p K_t (2 H₀ D / τ₃)² ≤ exp(k^c)` and
`n_0`-requirement at most `exp(k^c)`, the path counts can be chosen with ratios
`n_{r+1} / n_r ≥ 1 + (L + 6) M_p K` (no trial cap is attained) and a trial cap `T ≥ n_{L+5}`
with polynomial logarithm `log T ≤ k^C`. -/
theorem pathCounts_poly (c : ℕ) :
    ∃ C : ℕ, ∃ k₀ : ℝ, 2 ≤ k₀ ∧ ∀ {k : ℝ}, k₀ ≤ k → ∀ (Lc Mp Kt mH Dv : ℕ) (H₀ τ₃ n₀ : ℝ),
      (Lc + 6 : ℝ) ≤ k ^ c → (mH : ℝ) ≤ c * (Real.log k + 1) →
      1 + (Lc + 6) * Mp * (Kt * (2 * H₀ * Dv / τ₃) ^ 2) ≤ Real.exp (k ^ c) →
      n₀ ≤ Real.exp (k ^ c) →
      ∃ (n : ℕ → ℝ) (Tmax : ℕ), n₀ ≤ n 0 ∧
        (∀ r, (1 + (Lc + 6) * Mp * closureRatio Dv Kt mH Tmax H₀ τ₃) * n r ≤ n (r + 1)) ∧
        n (Lc + 5) ≤ Tmax ∧ Real.log Tmax ≤ k ^ C := by
  obtain ⟨C₂, k₁, hk₁, h⟩ := closure_parameters (c + 1)
  refine ⟨c + 1 + C₂, max k₁ 3, le_trans (by norm_num) (le_max_right _ _), ?_⟩
  intro k hk Lc Mp Kt mH Dv H₀ τ₃ n₀ hL hm hK hn₀
  have hk3 : 3 ≤ k := le_trans (le_max_right _ _) hk
  have hk1 : 1 ≤ k := by linarith
  have hkc : 1 ≤ k ^ c := one_le_pow₀ hk1
  have hkc1 : k ^ c * 3 ≤ k ^ (c + 1) := by
    rw [pow_succ]; exact mul_le_mul_of_nonneg_left hk3 (by positivity)
  have hkc' : k ^ c ≤ k ^ (c + 1) := by nlinarith only [hL, hkc1]
  have hkC : 1 ≤ k ^ C₂ := one_le_pow₀ hk1
  set a : ℝ := (Lc + 6) * Mp * (Kt * (2 * H₀ * Dv / τ₃) ^ 2) with ha
  have ha0 : 0 ≤ a := by positivity
  set K : ℝ := 1 + a with hKdef
  set! n₁ : ℝ := max n₀ 1 with hn₁
  have hn₁1 : 1 ≤ n₁ := le_max_right _ _
  have hn₁le : n₁ ≤ Real.exp (k ^ c) := max_le hn₀ (Real.one_le_exp (by positivity))
  set! j : ℕ := ⌈Real.log n₁⌉₊ with hj
  have hlog1 : 0 ≤ Real.log n₁ := Real.log_nonneg hn₁1
  have hlogk : Real.log n₁ ≤ k ^ c := (Real.log_le_iff_le_exp (by linarith)).mpr hn₁le
  have hj1 : (j : ℝ) ≤ k ^ c + 1 := (Nat.ceil_lt_add_one hlog1).le.trans (by linarith)
  set! Lr : ℕ := Lc + 6 + j with hLr
  have hLrk : (Lr : ℝ) ≤ k ^ (c + 1) := by
    simp only [hLr]; push_cast
    nlinarith only [hL, hkc1, hj1]
  set! y : ℝ := closureCount C₂ k (Lc + 5 + j) with hy
  have hy1 : 1 ≤ y := Real.one_le_exp (by positivity)
  set! Tmax : ℕ := ⌈y⌉₊ with hT
  have hTle : (Tmax : ℝ) ≤ closureCount C₂ k Lr := by
    have h1 : (Tmax : ℝ) < y + 1 := Nat.ceil_lt_add_one (by linarith)
    have h2 : closureCount C₂ k Lr = y * Real.exp (k ^ C₂) := by
      simp only [hy, closureCount, ← Real.exp_add, hLr]
      congr 1
      push_cast
      ring
    have h3 : (2 : ℝ) ≤ Real.exp (k ^ C₂) := by
      have := Real.add_one_le_exp (k ^ C₂); linarith
    rw [h2]
    nlinarith only [hy1, h1, h3]
  have hmX : (mH : ℝ) ≤ ((c + 1 : ℕ) : ℝ) * (Real.log k + 1) := by
    have := Real.log_nonneg hk1
    push_cast
    nlinarith only [hm, this]
  have hKX : K ≤ Real.exp (k ^ (c + 1)) := hK.trans (Real.exp_le_exp.mpr hkc')
  obtain ⟨hrat, hlog⟩ := @h k (le_trans (le_max_left _ _) hk) Lr mH K hLrk hmX hKX Tmax hTle
  refine ⟨fun r => closureCount C₂ k (r + j), Tmax, ?_, fun r => ?_, Nat.le_ceil _, ?_⟩
  · change n₀ ≤ Real.exp (((0 + j : ℕ) : ℝ) * k ^ C₂)
    calc n₀ ≤ n₁ := le_max_left _ _
      _ = Real.exp (Real.log n₁) := (Real.exp_log (by linarith)).symm
      _ ≤ Real.exp (((0 + j : ℕ) : ℝ) * k ^ C₂) := by
        apply Real.exp_le_exp.mpr
        have h1 : Real.log n₁ ≤ j := Nat.le_ceil _
        have h2 : (j : ℝ) ≤ j * k ^ C₂ := le_mul_of_one_le_right (Nat.cast_nonneg _) hkC
        push_cast
        linarith
  · set Q : ℝ := 4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH) with hQ
    have hQ1 : 1 ≤ Q := by
      have := projectionPrefixConstant_one_le Tmax
      exact one_le_mul_of_one_le_of_one_le (one_le_pow₀ (by norm_num)) (one_le_pow₀ this)
    have hcc := hrat (r + j)
    have hpos : 0 < closureCount C₂ k (r + j) := Real.exp_pos _
    have e : r + j + 1 = r + 1 + j := by omega
    rw [e] at hcc
    have hle : 1 + (Lc + 6) * Mp * closureRatio Dv Kt mH Tmax H₀ τ₃ ≤ K * Q := by
      have e2 : (Lc + 6 : ℝ) * Mp * closureRatio Dv Kt mH Tmax H₀ τ₃ = a * Q := by
        simp only [closureRatio, ha, hQ]
        ring
      rw [e2, hKdef]
      nlinarith only [hQ1]
    calc (1 + (Lc + 6) * Mp * closureRatio Dv Kt mH Tmax H₀ τ₃) * closureCount C₂ k (r + j)
        ≤ K * Q * closureCount C₂ k (r + j) := mul_le_mul_of_nonneg_right hle hpos.le
      _ = closureCount C₂ k (r + j) * K * Q := by ring
      _ ≤ closureCount C₂ k (r + 1 + j) := hcc.le
  · have hT1 : (1 : ℝ) ≤ Tmax := hy1.trans (Nat.le_ceil _)
    calc Real.log Tmax ≤ Real.log (closureCount C₂ k Lr) :=
          Real.log_le_log (by linarith) hTle
      _ ≤ k ^ (c + 1 + C₂) := hlog


namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

/-- The names of the helper tests of a slot at a cell with fixed base names `Bh` (blueprint line
1815): the helper rank `L + 5`, a target mask name, a history of at most `m` factors and a base
name. -/
abbrev HelperName (I : ℤ × ℤ) (Bh : Type) : Type :=
  fp.MaskName I × (Σ ℓ : Fin (fp.mH + 1), Fin ℓ → Fin (fp.Lc + 6) × fp.MaskName I × Bool) × Bh

/-- The helper test of a name, with the fixed base vectors `base` (blueprint line 1815). -/
noncomputable def helperOf (l : Fin 4) (I : ℤ × ℤ) {Bh : Type}
    (base : Bh → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) (w : fp.HelperName I Bh) :
    MainTest bf.Vtx bf.Lab fp.Mc where
  t := l
  r := fp.Lc + 5
  M := fp.maskOf I w.1
  m := w.2.1.1
  hr := fun i => if h : i < w.2.1.1 then (w.2.1.2 ⟨i, h⟩).1 else 0
  hM := fun i => if h : i < w.2.1.1 then fp.maskOf I (w.2.1.2 ⟨i, h⟩).2.1 else fun _ => False
  θ := fun i => if h : i < w.2.1.1 then (w.2.1.2 ⟨i, h⟩).2.2 else false
  base := base w.2.2

/-- The number of helper names at a cell is at most the main count with the helper base
names. -/
theorem card_helperName_le (I : ℤ × ℤ) (Bh : Type) [Fintype Bh] :
    Fintype.card (fp.HelperName I Bh) ≤
      (fp.Lc + 5) * ((fp.Lc + 1 + A.famVtxBound) * (fp.Hmax + 1)) *
      ((fp.mH + 1) * ((fp.Lc + 6) * ((fp.Lc + 1 + A.famVtxBound) * (fp.Hmax + 1)) * 2) ^ fp.mH) *
        Fintype.card Bh := by
  have h := fp.card_testName_le I Bh
  have e : Fintype.card (fp.TestName I Bh) = (fp.Lc + 5) * Fintype.card (fp.HelperName I Bh) := by
    rw [Fintype.card_prod, Fintype.card_fin]
  rw [e] at h
  have h5 : Fintype.card (fp.HelperName I Bh) ≤ (fp.Lc + 5) * Fintype.card (fp.HelperName I Bh) :=
    Nat.le_mul_of_pos_left _ (by omega)
  exact h5.trans h

end ActiveSetup.BasicFamilies.FamParams

/-- The closure data are `exp(k^{O(1)})`: with `L + 6 ≤ k^c`, path multiplicity, name count and
vertex bound at most `exp(k^c)`, source complexity `log H ≤ k^c` and `1 / τ₃ ≤ exp(k^c)`, the
quantity `1 + (L + 6) M_p K_t (2 H₀ D / τ₃)²` of the closure ratio, with the same-tag constant
`H₀ = exp(D_st (1 + log H)^{D_st})`, is at most `exp(k^{c D_st + c + 1})` for large `k`. -/
theorem closureData_le (c Dst : ℕ) {k : ℝ} (hk : 9 + 2 * Dst * 2 ^ Dst ≤ k) (Lc Mp Kt Dv : ℕ)
    {HS τ₃ : ℝ} (hL : (Lc + 6 : ℝ) ≤ k ^ c) (hMp : (Mp : ℝ) ≤ Real.exp (k ^ c))
    (hKt : (Kt : ℝ) ≤ Real.exp (k ^ c)) (hDv : (Dv : ℝ) ≤ Real.exp (k ^ c))
    (hHS : Real.exp 2 ≤ HS) (hlog : Real.log HS ≤ k ^ c) (hτ : 0 < τ₃)
    (hτ' : τ₃⁻¹ ≤ Real.exp (k ^ c)) :
    1 + (Lc + 6) * Mp * (Kt * (2 * Real.exp (Dst * (1 + Real.log HS) ^ Dst) * Dv / τ₃) ^ 2) ≤
      Real.exp (k ^ (c * Dst + c + 1)) := by
  have hk1 : 1 ≤ k := le_trans (by have : (0 : ℝ) ≤ 2 * Dst * 2 ^ Dst := by positivity
                                   linarith) hk
  set E := Real.exp (k ^ c) with hE
  have hkc : 1 ≤ k ^ c := one_le_pow₀ hk1
  have hkE : k ^ c ≤ E := by have := Real.add_one_le_exp (k ^ c); linarith
  have hE1 : 1 ≤ E := by linarith
  set h := (Dst : ℝ) * (1 + Real.log HS) ^ Dst with hh
  have hlog0 : 0 ≤ Real.log HS := by
    have := Real.log_le_log (Real.exp_pos 2) hHS
    rw [Real.log_exp] at this; linarith
  have hh0 : 0 ≤ h := by positivity
  -- the same-tag exponent
  have hhk : h ≤ Dst * 2 ^ Dst * k ^ (c * Dst) := by
    have h1 : 1 + Real.log HS ≤ 2 * k ^ c := by linarith
    have h2 : (1 + Real.log HS) ^ Dst ≤ (2 * k ^ c) ^ Dst :=
      pow_le_pow_left₀ (by positivity) h1 Dst
    rw [mul_pow, ← pow_mul] at h2
    calc h = Dst * (1 + Real.log HS) ^ Dst := rfl
      _ ≤ Dst * (2 ^ Dst * k ^ (c * Dst)) := mul_le_mul_of_nonneg_left h2 (by positivity)
      _ = Dst * 2 ^ Dst * k ^ (c * Dst) := by ring
  -- the product
  have hτ0 : 0 < τ₃⁻¹ := inv_pos.mpr hτ
  have hX : (2 * Real.exp h * Dv / τ₃) ^ 2 ≤ 4 * Real.exp (2 * h) * E ^ 4 := by
    have e1 : 2 * Real.exp h * Dv / τ₃ = 2 * Real.exp h * (Dv * τ₃⁻¹) := by
      rw [div_eq_mul_inv]; ring
    have h1 : (Dv : ℝ) * τ₃⁻¹ ≤ E * E := mul_le_mul hDv hτ' hτ0.le (by positivity)
    rw [e1, mul_pow, mul_pow, ← Real.exp_nat_mul]
    have h2 : ((Dv : ℝ) * τ₃⁻¹) ^ 2 ≤ (E * E) ^ 2 := pow_le_pow_left₀ (by positivity) h1 2
    calc 2 ^ 2 * Real.exp ((2 : ℕ) * h) * ((Dv : ℝ) * τ₃⁻¹) ^ 2
        ≤ 2 ^ 2 * Real.exp ((2 : ℕ) * h) * (E * E) ^ 2 := by gcongr
      _ = 4 * Real.exp (2 * h) * E ^ 4 := by push_cast; ring
  have hY : (Lc + 6 : ℝ) * Mp * (Kt * (2 * Real.exp h * Dv / τ₃) ^ 2) ≤
      4 * Real.exp (2 * h) * E ^ 7 := by
    have hL' : (Lc + 6 : ℝ) ≤ E := hL.trans hkE
    calc (Lc + 6 : ℝ) * Mp * (Kt * (2 * Real.exp h * Dv / τ₃) ^ 2)
        ≤ E * E * (E * (4 * Real.exp (2 * h) * E ^ 4)) := by
          gcongr
      _ = 4 * Real.exp (2 * h) * E ^ 7 := by ring
  have hZ : 1 + 4 * Real.exp (2 * h) * E ^ 7 ≤ Real.exp (2 * h + 7 * k ^ c + 2) := by
    have h1 : 1 ≤ Real.exp (2 * h) * E ^ 7 :=
      one_le_mul_of_one_le_of_one_le (Real.one_le_exp (by positivity)) (one_le_pow₀ hE1)
    have h2 : (5 : ℝ) ≤ Real.exp 2 := by
      have := Real.add_one_le_exp (2 : ℝ)
      have h3 : Real.exp 2 = Real.exp 1 * Real.exp 1 := by rw [← Real.exp_add]; norm_num
      have h4 := Real.exp_one_gt_d9
      nlinarith only [h3, h4]
    have e : Real.exp (2 * h + 7 * k ^ c + 2) = Real.exp (2 * h) * E ^ 7 * Real.exp 2 := by
      rw [hE, ← Real.exp_nat_mul, ← Real.exp_add, ← Real.exp_add]; push_cast; ring_nf
    rw [e]
    nlinarith only [h1, h2]
  have hW : 1 + (Lc + 6 : ℝ) * Mp * (Kt * (2 * Real.exp h * Dv / τ₃) ^ 2) ≤
      1 + 4 * Real.exp (2 * h) * E ^ 7 := by linarith
  refine hW.trans (hZ.trans (Real.exp_le_exp.mpr ?_))
  -- the exponent
  set e := c * Dst + c with he
  have hke : 1 ≤ k ^ e := one_le_pow₀ hk1
  have hc1 : k ^ c ≤ k ^ e := pow_le_pow_right₀ hk1 (by omega)
  have hc2 : k ^ (c * Dst) ≤ k ^ e := pow_le_pow_right₀ hk1 (by omega)
  have hD0 : (0 : ℝ) ≤ Dst * 2 ^ Dst := by positivity
  calc 2 * h + 7 * k ^ c + 2 ≤ 2 * (Dst * 2 ^ Dst * k ^ (c * Dst)) + 7 * k ^ c + 2 := by linarith
    _ ≤ (9 + 2 * Dst * 2 ^ Dst) * k ^ e := by
        have := mul_le_mul_of_nonneg_left hc2 hD0
        nlinarith only [hL, hc1, hc2, hD0]
    _ ≤ k * k ^ e := mul_le_mul_of_nonneg_right hk (by positivity)
    _ = k ^ (c * Dst + c + 1) := by rw [he, pow_succ]; ring

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}

/-- Blueprint lem:closure, lines 1820, 1823 and 1828-1830: for fixed degrees `c` and same-tag
exponent `D_st` there are a degree `C` and a threshold `k₀` such that for `k ≥ k₀` and every
attempt with `L + 6 ≤ k^c` ranks, vertex bound, pad bound, path multiplicity, the two column
budgets of `n_0` and base-name counts at most `exp(k^c)`, histories of length at most
`c (1 + log k)`, source complexity `log H ≤ k^c` and `1 / τ₃ ≤ exp(k^c)`:
the named main and helper tests number at most `K_t` per cell with `log K_t ≤ k^C` (line 1823),
and there are path counts `n` and a trial cap `T` with `n_0 ≥ 2 colBudget`, ratios
`n_{r+1} / n_r ≥ 1 + (L + 6) M_p K` for the closure ratio `K` of `T` (the binary-prefix factor is
below the ratio, so no cap is attained), `n_{L+5} ≤ T`, the helper allowance `K n_{L+4} < T`, and
`log T ≤ k^C` (line 1828). None of these bounds involves the edge threshold `H_ed`, so they are
fixed before `H_ed` (line 1830). With `main_closure` and `helper_closure` this gives lem:closure
with `log n_{L+5} ≤ k^{O(1)}`. -/
theorem closure_poly (c Dst : ℕ) :
    ∃ C : ℕ, ∃ k₀ : ℝ, 2 ≤ k₀ ∧ ∀ {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀}
      {bf : A.BasicFamilies} {k : ℝ}, k₀ ≤ k → ∀ (fp : bf.FamParams) {HS τ₃ : ℝ} {Mp : ℕ}
      (Bn Bh : Type) [Fintype Bn] [Fintype Bh],
      (fp.Lc + 6 : ℝ) ≤ k ^ c → (A.famVtxBound : ℝ) ≤ Real.exp (k ^ c) →
      (fp.Hmax + 1 : ℝ) ≤ Real.exp (k ^ c) → (fp.mH : ℝ) ≤ c * (Real.log k + 1) →
      Real.exp 2 ≤ HS → Real.log HS ≤ k ^ c → 0 < τ₃ → τ₃⁻¹ ≤ Real.exp (k ^ c) →
      1 ≤ Mp → (Mp : ℝ) ≤ Real.exp (k ^ c) → 2 * A.colBudget ≤ Real.exp (k ^ c) →
      (Fintype.card Bn : ℝ) ≤ Real.exp (k ^ c) → (Fintype.card Bh : ℝ) ≤ Real.exp (k ^ c) →
      ∃ (Kt : ℕ) (n : ℕ → ℝ) (Tmax : ℕ),
        (∀ I, Fintype.card (fp.TestName I Bn) ≤ Kt) ∧
        (∀ I, Fintype.card (fp.HelperName I Bh) ≤ Kt) ∧ Real.log Kt ≤ k ^ C ∧
        2 * A.colBudget ≤ n 0 ∧
        (∀ r, (1 + (fp.Lc + 6) * Mp * closureRatio A.famVtxBound Kt fp.mH Tmax
          (Real.exp (Dst * (1 + Real.log HS) ^ Dst)) τ₃) * n r ≤ n (r + 1)) ∧
        n (fp.Lc + 5) ≤ Tmax ∧
        closureRatio A.famVtxBound Kt fp.mH Tmax (Real.exp (Dst * (1 + Real.log HS) ^ Dst)) τ₃ *
          n (fp.Lc + 4) < Tmax ∧
        Real.log (n (fp.Lc + 5)) ≤ k ^ C ∧ Real.log Tmax ≤ k ^ C := by
  set e := (c + 3) * Dst + (c + 3) + 1 with he
  obtain ⟨C₁, k₁, hk₁, hpc⟩ := pathCounts_poly e
  refine ⟨max (c + 3) C₁, max k₁ (max (6 * (c + 1) + 6) (9 + 2 * Dst * 2 ^ Dst)),
    le_trans hk₁ (le_max_left _ _), ?_⟩
  intro κ c₀ A bf k hk fp HS τ₃ Mp Bn Bh _ _ hL hDv hH hm hHS hlog hτ hτ' hMp1 hMp hcb hBn hBh
  have hk1' : k₁ ≤ k := le_trans (le_max_left _ _) hk
  have hk2 : 6 * (c + 1) + 6 ≤ k := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hk
  have hk3 : 9 + 2 * Dst * 2 ^ Dst ≤ k :=
    le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hk
  have hk1 : 1 ≤ k := by have := Nat.cast_nonneg (α := ℝ) c; linarith
  have hkc : k ^ c ≤ k ^ (c + 1) := pow_le_pow_right₀ hk1 (by omega)
  have hkc3 : k ^ c ≤ k ^ (c + 3) := pow_le_pow_right₀ hk1 (by omega)
  have hkce : k ^ c ≤ k ^ e := pow_le_pow_right₀ hk1 (by omega)
  have hexp : ∀ {x y : ℝ}, x ≤ y → Real.exp x ≤ Real.exp y := fun h => Real.exp_le_exp.mpr h
  -- the name count
  set! Kt : ℕ := (fp.Lc + 6) * ((fp.Lc + 1 + A.famVtxBound) * (fp.Hmax + 1)) *
    ((fp.mH + 1) * ((fp.Lc + 6) * ((fp.Lc + 1 + A.famVtxBound) * (fp.Hmax + 1)) * 2) ^ fp.mH) *
      (Fintype.card Bn + Fintype.card Bh) with hKt
  have hKtn : ∀ I, Fintype.card (fp.TestName I Bn) ≤ Kt := fun I => by
    refine (fp.card_testName_le I Bn).trans ?_
    rw [hKt]
    gcongr <;> omega
  have hKth : ∀ I, Fintype.card (fp.HelperName I Bh) ≤ Kt := fun I => by
    refine (fp.card_helperName_le I Bh).trans ?_
    rw [hKt]
    gcongr <;> omega
  have hb : ((Fintype.card Bn + Fintype.card Bh : ℕ) : ℝ) ≤ Real.exp (k ^ (c + 1)) := by
    have h2 : Real.exp (k ^ c) * 2 ≤ Real.exp (k ^ (c + 1)) := by
      have h1 : (2 : ℝ) ≤ Real.exp (k ^ c) := by
        have := Real.add_one_le_exp (k ^ c); have := one_le_pow₀ (n := c) hk1; linarith
      calc Real.exp (k ^ c) * 2 ≤ Real.exp (k ^ c) * Real.exp (k ^ c) :=
            mul_le_mul_of_nonneg_left h1 (by positivity)
        _ = Real.exp (2 * k ^ c) := by rw [← Real.exp_add]; ring_nf
        _ ≤ Real.exp (k ^ (c + 1)) := hexp (by
            rw [pow_succ, mul_comm 2]
            exact mul_le_mul_of_nonneg_left (by linarith) (by positivity))
    push_cast; linarith
  have hKtle : (Kt : ℝ) ≤ Real.exp (k ^ (c + 3)) := by
    have := names_count_poly (c + 1) (by push_cast; linarith) fp.Lc A.famVtxBound fp.Hmax fp.mH
      (Fintype.card Bn + Fintype.card Bh) (hL.trans hkc) (hDv.trans (hexp hkc))
      (hH.trans (hexp hkc)) (hm.trans (by
        have := Real.log_nonneg hk1; push_cast; nlinarith only [this])) hb
    rw [hKt]
    exact this.trans (hexp (by
      rw [show c + 1 + 2 = c + 3 by ring]))
  have hlogKt : Real.log Kt ≤ k ^ (max (c + 3) C₁) := by
    rcases Nat.eq_zero_or_pos Kt with h0 | h0
    · rw [h0, Nat.cast_zero, Real.log_zero]; positivity
    · have h1 := Real.log_le_log (by exact_mod_cast h0) hKtle
      rw [Real.log_exp] at h1
      exact h1.trans (pow_le_pow_right₀ hk1 (le_max_left _ _))
  -- the closure data
  have hdata := closureData_le (c + 3) Dst hk3 fp.Lc Mp Kt A.famVtxBound (hL.trans hkc3)
    (hMp.trans (hexp hkc3)) hKtle (hDv.trans (hexp hkc3)) hHS (hlog.trans hkc3) hτ
    (hτ'.trans (hexp hkc3))
  obtain ⟨n, Tmax, hn0, hratio, hT, hlogT⟩ := hpc hk1' fp.Lc Mp Kt fp.mH A.famVtxBound
    (Real.exp (Dst * (1 + Real.log HS) ^ Dst)) τ₃ (2 * A.colBudget) (hL.trans hkce)
    (hm.trans (mul_le_mul_of_nonneg_right (by exact_mod_cast (show c ≤ e by omega))
      (by have := Real.log_nonneg hk1; linarith))) hdata (hcb.trans (hexp hkce))
  -- the helper allowance and the size of the path counts
  set Kc := closureRatio A.famVtxBound Kt fp.mH Tmax (Real.exp (Dst * (1 + Real.log HS) ^ Dst)) τ₃
  have hKc0 : 0 ≤ Kc := closureRatio_nonneg _ _ _ _ _ _
  have hcb0 : 0 < A.colBudget := by
    have := A.Dc_nonneg; unfold ActiveSetup.colBudget; positivity
  have hX0 : 0 ≤ (fp.Lc + 6 : ℝ) * Mp * Kc := by positivity
  have hpos : ∀ r, 0 < n r := by
    intro r
    induction r with
    | zero => linarith
    | succ r ih => exact lt_of_lt_of_le (mul_pos (by linarith) ih) (hratio r)
  have hMp' : (1 : ℝ) ≤ Mp := by exact_mod_cast hMp1
  have hLM : (1 : ℝ) ≤ (fp.Lc + 6) * Mp :=
    one_le_mul_of_one_le_of_one_le (by have := Nat.cast_nonneg (α := ℝ) fp.Lc; linarith) hMp'
  have h2 : Kc ≤ (fp.Lc + 6) * Mp * Kc := le_mul_of_one_le_left hKc0 hLM
  have hC : k ^ C₁ ≤ k ^ (max (c + 3) C₁) := pow_le_pow_right₀ hk1 (le_max_right _ _)
  refine ⟨Kt, n, Tmax, hKtn, hKth, hlogKt, hn0, hratio, hT, ?_,
    ((Real.log_le_log (hpos _) hT).trans hlogT).trans hC, hlogT.trans hC⟩
  calc Kc * n (fp.Lc + 4) < (1 + (fp.Lc + 6) * Mp * Kc) * n (fp.Lc + 4) :=
        mul_lt_mul_of_pos_right (by linarith) (hpos _)
    _ ≤ n (fp.Lc + 4 + 1) := hratio (fp.Lc + 4)
    _ ≤ Tmax := hT

end ActiveSetup.BasicFamilies.FamParams

/-! ### Expansion of main primals (blueprint line 1835) -/

/-- The private coordinate of a private column value. -/
theorem inner_single_privateColumnValue {W : Type*} [Fintype W] [DecidableEq W]
    (φ : W → ℝ → ℂ) (ε : W → ℝ) (v w : W) (y : ℝ) :
    inner ℂ (EuclideanSpace.single (some w) (1 : ℂ)) (privateColumnValue φ ε v y) =
      if v = w then (Real.sqrt (ε v) : ℂ) else 0 := by
  unfold privateColumnValue
  rw [inner_add_right, inner_smul_right, inner_smul_right, EuclideanSpace.inner_single_left,
    EuclideanSpace.inner_single_left]
  by_cases h : v = w
  · subst h; simp
  · simp [h, Ne.symm h]

section MainExpansion
variable {V : Type} [Fintype V] {Tg : Type*} {G : RealDyadicGrid} {Mc : ℕ} {O : OrigCols V Tg}

/-- The pointwise form of a combination of main columns on the cell. -/
theorem mainCombination_coeFn (s : List (CatCol Tg)) (I : ℤ × ℤ) (F : Finset (V ⊕ Fin Mc))
    (c : V ⊕ Fin Mc → ℂ) (hmem : ∀ v ∈ F, MemLp ((dyadicGridCell G I.1 I.2).indicator
      (privateColumnValue (mainScalar Mc O s) (mainWeight Mc O) v)) 2 volume) :
    ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 →
      ((∑ v ∈ F, c v • mainCol G Mc O s I v : ColumnL2 (V ⊕ Fin Mc)) :
        ℝ → ColumnHilbert (V ⊕ Fin Mc)) y =
        ∑ v ∈ F, c v • privateColumnValue (mainScalar Mc O s) (mainWeight Mc O) v y := by
  have hcol : ∀ v ∈ F, ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 →
      ((c v • mainCol G Mc O s I v : ColumnL2 (V ⊕ Fin Mc)) :
        ℝ → ColumnHilbert (V ⊕ Fin Mc)) y =
        c v • privateColumnValue (mainScalar Mc O s) (mainWeight Mc O) v y := by
    intro v hv
    filter_upwards [Lp.coeFn_smul (c v) (mainCol G Mc O s I v), wColumn_coeFn (hmem v hv)]
      with y h1 h2 hys
    rw [h1, Pi.smul_apply]
    unfold mainCol
    rw [h2, Set.indicator_of_mem hys]
  have hall : ∀ᵐ y ∂volume, ∀ v ∈ F, y ∈ dyadicGridCell G I.1 I.2 →
      ((c v • mainCol G Mc O s I v : ColumnL2 (V ⊕ Fin Mc)) :
        ℝ → ColumnHilbert (V ⊕ Fin Mc)) y =
        c v • privateColumnValue (mainScalar Mc O s) (mainWeight Mc O) v y :=
    (Filter.eventually_all_finset _).mpr hcol
  filter_upwards [hall, Lp.coeFn_fun_finsetSum F
    (fun v => c v • mainCol G Mc O s I v)] with y hy hsum hys
  rw [hsum]
  exact Finset.sum_congr rfl fun v hv => hy v hv hys

open scoped Classical in
/-- The coefficients of a combination of main columns are controlled by the private
coordinates: their absolute sum is at most `√N D ‖x‖ / √|I|` for `N` labels whose inverse
private weights are at most `D²` (blueprint line 1835: only original columns have small private
weights). -/
theorem mainCoeff_sum_le (s : List (CatCol Tg)) (I : ℤ × ℤ) (F : Finset (V ⊕ Fin Mc))
    (c : V ⊕ Fin Mc → ℂ) (hmem : ∀ v ∈ F, MemLp ((dyadicGridCell G I.1 I.2).indicator
      (privateColumnValue (mainScalar Mc O s) (mainWeight Mc O) v)) 2 volume)
    {D : ℝ} (hD0 : 0 ≤ D) (hD : ∀ v ∈ F, (mainWeight Mc O v)⁻¹ ≤ D ^ 2) :
    ∑ v ∈ F, ‖c v‖ ≤ Real.sqrt F.card * D *
      ‖(∑ v ∈ F, c v • mainCol G Mc O s I v : ColumnL2 (V ⊕ Fin Mc))‖ /
        Real.sqrt (dyadicGridLength G I.1) := by
  set x : ColumnL2 (V ⊕ Fin Mc) := ∑ v ∈ F, c v • mainCol G Mc O s I v with hx
  have hr := dyadicGridLength_pos G I.1
  have hwpos : ∀ v, 0 < mainWeight Mc O v := fun v => by
    rcases v with v | n
    · exact O.weight_pos v
    · exact one_pos
  -- the private coordinates
  set! S : ℝ := ∑ w ∈ F, ‖c w‖ ^ 2 * mainWeight Mc O w with hS
  have hpt : ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 →
      S ≤ ‖(x : ℝ → ColumnHilbert (V ⊕ Fin Mc)) y‖ ^ 2 := by
    filter_upwards [mainCombination_coeFn s I F c hmem] with y hy hys
    rw [hy hys]
    have hon : Orthonormal ℂ fun w : V ⊕ Fin Mc =>
        EuclideanSpace.single (some w : Option (V ⊕ Fin Mc)) (1 : ℂ) :=
      EuclideanSpace.orthonormal_single.comp _ (Option.some_injective _)
    refine le_trans (le_of_eq ?_) (Orthonormal.sum_inner_products_le (s := F) _ hon)
    refine Finset.sum_congr rfl fun w hw => ?_
    rw [inner_sum, Finset.sum_eq_single w]
    · rw [inner_smul_right, inner_single_privateColumnValue, ite_eq_left_of_eq_true _ _ (eq_self w),
        norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _),
        mul_pow, Real.sq_sqrt (hwpos w).le]
    · intro b _ hb
      rw [inner_smul_right, inner_single_privateColumnValue,
        ite_eq_right_of_eq_false _ _ (eq_false hb), mul_zero]
    · intro h; exact absurd hw h
  have hS0 : 0 ≤ S := Finset.sum_nonneg fun w _ => mul_nonneg (by positivity) (hwpos w).le
  have hint : dyadicGridLength G I.1 * S ≤ ‖x‖ ^ 2 := by
    rw [columnInput_norm_sq_integral]
    have hmeas := dyadicGridCell_measurable G I.1 I.2
    have hvol : volume.real (dyadicGridCell G I.1 I.2) = dyadicGridLength G I.1 := by
      rw [Measure.real, dyadicGridCell_volume, ENNReal.toReal_ofReal hr.le]
    have hf : Integrable (fun y => ‖(x : ℝ → ColumnHilbert (V ⊕ Fin Mc)) y‖ ^ 2) volume :=
      (Lp.memLp x).integrable_norm_pow (by norm_num)
    calc dyadicGridLength G I.1 * S = ∫ _y in dyadicGridCell G I.1 I.2, S := by
          rw [setIntegral_const, smul_eq_mul, hvol]
      _ ≤ ∫ y in dyadicGridCell G I.1 I.2, ‖(x : ℝ → ColumnHilbert (V ⊕ Fin Mc)) y‖ ^ 2 := by
          refine setIntegral_mono_on_ae ?_ hf.integrableOn hmeas ?_
          · exact integrableOn_const (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_ne_top)
          · exact hpt
      _ ≤ ∫ y, ‖(x : ℝ → ColumnHilbert (V ⊕ Fin Mc)) y‖ ^ 2 :=
          setIntegral_le_integral hf (Filter.Eventually.of_forall fun y => by positivity)
  -- Cauchy-Schwarz over the labels
  have hcs : (∑ v ∈ F, ‖c v‖) ^ 2 ≤ F.card * (D ^ 2 * S) := by
    refine (sq_sum_le_card_mul_sum_sq).trans ?_
    refine mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg _)
    rw [hS, Finset.mul_sum]
    refine Finset.sum_le_sum fun v hv => ?_
    have h1 : 1 ≤ D ^ 2 * mainWeight Mc O v := by
      have := hD v hv
      rw [inv_le_iff_one_le_mul₀ (hwpos v)] at this
      linarith
    nlinarith [sq_nonneg ‖c v‖]
  have hsr : 0 < Real.sqrt (dyadicGridLength G I.1) := Real.sqrt_pos.mpr hr
  rw [le_div_iff₀ hsr]
  have hlhs : 0 ≤ ∑ v ∈ F, ‖c v‖ := Finset.sum_nonneg fun v _ => norm_nonneg _
  refine le_of_pow_le_pow_left₀ two_ne_zero (by positivity) ?_
  calc ((∑ v ∈ F, ‖c v‖) * Real.sqrt (dyadicGridLength G I.1)) ^ 2
      = (∑ v ∈ F, ‖c v‖) ^ 2 * dyadicGridLength G I.1 := by
        rw [mul_pow, Real.sq_sqrt hr.le]
    _ ≤ F.card * (D ^ 2 * S) * dyadicGridLength G I.1 := by
        have := sq_sum_le_card_mul_sum_sq (s := F) (f := fun v => ‖c v‖)
        nlinarith
    _ = F.card * D ^ 2 * (dyadicGridLength G I.1 * S) := by ring
    _ ≤ F.card * D ^ 2 * ‖x‖ ^ 2 := mul_le_mul_of_nonneg_left hint (by positivity)
    _ = (Real.sqrt F.card * D * ‖x‖) ^ 2 := by
        rw [mul_pow, mul_pow, Real.sq_sqrt (Nat.cast_nonneg _)]

end MainExpansion

namespace ActiveSetup.BasicFamilies
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} (bf : A.BasicFamilies)

open scoped Classical in
/-- The columns of the main labels of a slot are square integrable on the cell. -/
theorem mainLabel_memLp (l : Fin 4) {Mc : ℕ} (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ) (r : ℕ)
    {v : bf.Lab ⊕ Fin Mc} (hv : v ∈ mainLabels A.G Mc (bf.origCols l) s I r) :
    MemLp ((dyadicGridCell A.G I.1 I.2).indicator (privateColumnValue
      (mainScalar Mc (bf.origCols l) s) (mainWeight Mc (bf.origCols l)) v)) 2 volume := by
  rcases v with v | n
  · have h : (bf.origCols l).avail I v := by
      simp only [mainLabels, Finset.mem_filter, Finset.mem_univ, true_and, Sum.elim_inl] at hv
      exact hv
    exact bf.origCol_memLp l s h.2
  · exact wColumn_memLp (dyadicGridCell_measurable A.G I.1 I.2)
      (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_lt_top) _
      (catAtom_measurable s n) (C := 1) fun y _ => catAtom_bound s n y

/-- The inverse private weights of the main labels are at most `colBudget²`: original columns
by the column budgets of the basic families, new labels have private weight one (blueprint line
1835: only original columns have small private weights). -/
theorem inv_mainWeight_le (l : Fin 4) {Mc : ℕ} (v : bf.Lab ⊕ Fin Mc) :
    (mainWeight Mc (bf.origCols l) v)⁻¹ ≤ A.colBudget ^ 2 := by
  rcases v with v | n
  · exact (bf.P v.1 v.2.1).inv_privateWeight_le (bf.budget v.1 v.2.1) v.2.2
  · have h2 : (2 : ℝ) ≤ A.colBudget := by
      have := A.Dc_nonneg; unfold ActiveSetup.colBudget
      have : (0 : ℝ) ≤ Fintype.card A.L * (1 + A.Dc) := by positivity
      linarith
    change (1 : ℝ)⁻¹ ≤ _
    rw [inv_one]; nlinarith

end ActiveSetup.BasicFamilies

namespace ActiveSetup
variable {κ : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ c₀)

theorem two_le_colBudget : (2 : ℝ) ≤ A.colBudget := by
  have := A.Dc_nonneg; unfold ActiveSetup.colBudget
  have : (0 : ℝ) ≤ Fintype.card A.L * (1 + A.Dc) := by positivity
  linarith

/-- The inverse-weight budget is at most the vertex bound `D` of eq:catalog-test, so the
expansion cost `colBudget √n_{r-1}` of a lower-rank primal times the threshold
`τ₃ / (D √n_{r-1})` is at most `τ₃` (blueprint line 1835). -/
theorem colBudget_le_famVtxBound : A.colBudget ≤ A.famVtxBound := by
  have h2 := A.two_le_colBudget
  unfold famVtxBound
  have := Nat.lt_floor_add_one (8 * A.colBudget)
  push_cast
  linarith

end ActiveSetup


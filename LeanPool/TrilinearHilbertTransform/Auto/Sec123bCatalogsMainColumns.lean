  set H₀ := Real.exp (Dst * (1 + Real.log HS) ^ Dst) with hH₀
  set Dv := A.famVtxBound with hDv
  set! Q : ℝ := 4 ^ fp.mH * projectionPrefixConstant Tmax ^ (2 * fp.mH) with hQ
  set Kc := closureRatio Dv Kt fp.mH Tmax H₀ τ₃ with hKc
  have hH₀p : 0 < H₀ := Real.exp_pos _
  have hDvp : 0 < Dv := A.one_le_famVtxBound
  have hKc0 : 0 ≤ Kc := closureRatio_nonneg _ _ _ _ _ _
  have hQ0 : 0 ≤ Q := by have := projectionPrefixConstant_one_le Tmax; positivity
  have hn' : 0 < n (fp.Lc + 5 - 1) := by simpa using hn
  have hτp : 0 < catThreshold Dv τ₃ n (fp.Lc + 5) := catThreshold_pos hDvp hτ₃ hn'
  have hallow : ∀ c : ℝ, c * Q / (catThreshold Dv τ₃ n (fp.Lc + 5) / (2 * H₀)) ^ 2 =

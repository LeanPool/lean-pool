section WeightedColumns
variable {W : Type*} [Fintype W]

open scoped Classical in
/-- The weighted column `1_s (φ_x, √ε_x e_x)` of the label `x` (blueprint line 473), zero when it
is not square integrable. -/
noncomputable def wColumn (s : Set ℝ) (φ : W → ℝ → ℂ) (ε : W → ℝ) (x : W) : ColumnL2 W :=
  if h : MemLp (s.indicator (privateColumnValue φ ε x)) 2 volume then h.toLp _ else 0

theorem wColumn_coeFn {s : Set ℝ} {φ : W → ℝ → ℂ} {ε : W → ℝ} {x : W}
    (h : MemLp (s.indicator (privateColumnValue φ ε x)) 2 volume) :
    (wColumn s φ ε x : ℝ → ColumnHilbert W) =ᵐ[volume] s.indicator (privateColumnValue φ ε x) := by
  unfold wColumn
  simp only [h, ↓reduceDIte]
  exact MemLp.coeFn_toLp _

theorem norm_privateColumnValue_le (φ : W → ℝ → ℂ) (ε : W → ℝ) (x : W) (y : ℝ) :
    ‖privateColumnValue φ ε x y‖ ≤ ‖φ x y‖ + Real.sqrt (ε x) := by
  classical
  unfold privateColumnValue
  refine (norm_add_le _ _).trans ?_
  rw [norm_smul, norm_smul]
  simp [abs_of_nonneg (Real.sqrt_nonneg (ε x))]

/-- A scalar bounded on a set of finite measure gives a square-integrable column. -/
theorem wColumn_memLp {s : Set ℝ} (hs : MeasurableSet s) (hsv : volume s < ⊤) {φ : W → ℝ → ℂ}
    (ε : W → ℝ) {x : W} (hφ : Measurable (φ x)) {C : ℝ} (hC : ∀ y ∈ s, ‖φ x y‖ ≤ C) :
    MemLp (s.indicator (privateColumnValue φ ε x)) 2 volume := by
  refine (memLp_indicator_iff_restrict hs).mpr ?_
  have : IsFiniteMeasure (volume.restrict s) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact hsv⟩
  refine MemLp.of_bound (privateColumnValue_measurable φ ε x hφ).aestronglyMeasurable
    (C + Real.sqrt (ε x)) ((ae_restrict_iff' hs).mpr (Filter.Eventually.of_forall fun y hy => ?_))
  exact (norm_privateColumnValue_le φ ε x y).trans (by linarith [hC y hy])

/-- The column of a label depends only on its own scalar and weight. -/
theorem wColumn_congr {s : Set ℝ} {φ φ' : W → ℝ → ℂ} {ε ε' : W → ℝ} {x : W}
    (hφ : φ x = φ' x) (hε : ε x = ε' x) : wColumn s φ ε x = wColumn s φ' ε' x := by
  have e : privateColumnValue φ ε x = privateColumnValue φ' ε' x := by
    funext y; simp only [privateColumnValue, hφ, hε]
  unfold wColumn
  rw [e]

open scoped Classical in
/-- The private coordinates of a column vanish off its own label. -/
theorem wColumn_some_ne {s : Set ℝ} {φ : W → ℝ → ℂ} {ε : W → ℝ} {x x' : W} (hne : x' ≠ x) :
    ∀ᵐ y ∂volume, (wColumn s φ ε x : ℝ → ColumnHilbert W) y (some x') = 0 := by
  by_cases h : MemLp (s.indicator (privateColumnValue φ ε x)) 2 volume
  · filter_upwards [wColumn_coeFn h] with y hy
    rw [hy]
    by_cases hys : y ∈ s
    · rw [Set.indicator_of_mem hys, privateColumnValue_private]
      simp only [hne, ↓reduceIte]
    · rw [Set.indicator_of_notMem hys]; rfl
  · unfold wColumn
    simp only [h, ↓reduceDIte]
    filter_upwards [Lp.coeFn_zero (ColumnHilbert W) 2 volume] with y hy
    rw [hy]; rfl

end WeightedColumns

section MainProjections
variable {V : Type} [Fintype V] {Tg : Type*}

/-- The original columns of a basic family as seen by the catalogs: scalars, private weights,
availability at the cells and the vertex (tag) of an available label at a cell (blueprint
lines 1676-1680, 1805). -/
structure OrigCols (V : Type) [Fintype V] (Tg : Type*) where
  /-- Scalar function carried by each original column label. -/
  scalar : V → ℝ → ℂ
  /-- Positive private-coordinate weight of each original column. -/
  weight : V → ℝ
  weight_pos : ∀ v, 0 < weight v
  /-- Availability of each original column label at a dyadic cell. -/
  avail : ℤ × ℤ → V → Prop
  /-- Cell-dependent chart tag of each original column. -/
  tag : ℤ × ℤ → V → Tg

variable (G : RealDyadicGrid) (Mc : ℕ) (O : OrigCols V Tg)

/-- The scalars of the main labels: original scalars and catalog atoms. -/
noncomputable def mainScalar (s : List (CatCol Tg)) : V ⊕ Fin Mc → ℝ → ℂ :=
  Sum.elim O.scalar fun n => catAtom s n

/-- The private weights of the main labels: original weights, and weight one for new labels
(blueprint line 1806). -/
def mainWeight : V ⊕ Fin Mc → ℝ := Sum.elim O.weight fun _ => 1

/-- The main column of a label at the cell `I`. -/
noncomputable def mainCol (s : List (CatCol Tg)) (I : ℤ × ℤ) (x : V ⊕ Fin Mc) :
    ColumnL2 (V ⊕ Fin Mc) :=
  wColumn (dyadicGridCell G I.1 I.2) (mainScalar Mc O s) (mainWeight Mc O) x

/-- The available main columns at the cell `I` of rank at most `r` with tag in the vertex mask
`M`: the original columns available at `I` whose vertex lies in `M` (rank zero) and the catalog
templates born above `I` of rank at most `r` with tag in `M` (blueprint lines 1805-1806). -/
def mainSel (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) :
    Set (ColumnL2 (V ⊕ Fin Mc)) :=
  {x | ∃ v, O.avail I v ∧ M (O.tag I v) ∧ mainCol G Mc O s I (Sum.inl v) = x} ∪
  {x | ∃ (n : Fin Mc) (hn : (n : ℕ) < s.length),
    dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G (s[(n : ℕ)]).birth.1 (s[(n : ℕ)]).birth.2 ∧
      (s[(n : ℕ)]).rank ≤ r ∧ M (s[(n : ℕ)]).tag ∧ mainCol G Mc O s I (Sum.inr n) = x}

/-- The range of the rank-`r` main projection with vertex mask `M` at the cell `I`. -/
noncomputable def mainRange (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) :
    Submodule ℂ (ColumnL2 (V ⊕ Fin Mc)) :=
  Submodule.span ℂ (mainSel G Mc O s I r M)

theorem mainSel_finite (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) :
    (mainSel G Mc O s I r M).Finite := by
  refine (Set.finite_range (mainCol G Mc O s I)).subset ?_
  rintro x (⟨v, -, -, rfl⟩ | ⟨n, -, -, -, -, rfl⟩)
  · exact ⟨_, rfl⟩
  · exact ⟨_, rfl⟩

instance (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) :
    FiniteDimensional ℂ (mainRange G Mc O s I r M) :=
  FiniteDimensional.span_of_finite ℂ (mainSel_finite G Mc O s I r M)

/-- The rank-`r` main projection with vertex mask `M` at the cell `I` (blueprint line 1806: a
rank-`r` projection uses all available columns of ranks at most `r` in its vertex mask). -/
noncomputable def mainProj (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) :
    ColumnL2 (V ⊕ Fin Mc) →L[ℂ] ColumnL2 (V ⊕ Fin Mc) :=
  (mainRange G Mc O s I r M).starProjection

theorem mainProj_isStarProjection (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) :
    IsStarProjection (mainProj G Mc O s I r M) := isStarProjection_starProjection

theorem catAtom_append_of_lt (s : List (CatCol Tg)) (d : CatCol Tg) {n : ℕ} (hn : n < s.length) :
    catAtom (s ++ [d]) n = catAtom s n := by
  unfold catAtom
  have hn' : n < (s ++ [d]).length := by simp; omega
  simp only [hn, hn', ↓reduceDIte, List.getElem_append_left hn]

theorem mainCol_append (s : List (CatCol Tg)) (d : CatCol Tg) (I : ℤ × ℤ) (x : V ⊕ Fin Mc)
    (hx : ∀ n : Fin Mc, x = Sum.inr n → (n : ℕ) < s.length) :
    mainCol G Mc O (s ++ [d]) I x = mainCol G Mc O s I x := by
  unfold mainCol
  refine wColumn_congr ?_ rfl
  rcases x with v | n
  · rfl
  · exact catAtom_append_of_lt s d (hx n rfl)

theorem mainSel_append (s : List (CatCol Tg)) (d : CatCol Tg) (I : ℤ × ℤ) (r : ℕ)
    (M : Tg → Prop) : mainSel G Mc O s I r M ⊆ mainSel G Mc O (s ++ [d]) I r M := by
  rintro x (⟨v, h1, h2, rfl⟩ | ⟨n, hn, h1, h2, h3, rfl⟩)
  · refine Or.inl ⟨v, h1, h2, ?_⟩
    exact mainCol_append G Mc O s d I _ fun n h => absurd h (by simp)
  · have hn' : (n : ℕ) < (s ++ [d]).length := by simp; omega
    have e : (s ++ [d])[(n : ℕ)]'hn' = s[(n : ℕ)]'hn := List.getElem_append_left hn
    refine Or.inr ⟨n, hn', ?_⟩
    rw [e]
    refine ⟨h1, h2, h3, ?_⟩
    exact mainCol_append G Mc O s d I _ fun m h => by
      rw [← Sum.inr.inj h]; exact hn

theorem mainRange_append (s : List (CatCol Tg)) (d : CatCol Tg) (I : ℤ × ℤ) (r : ℕ)
    (M : Tg → Prop) : mainRange G Mc O s I r M ≤ mainRange G Mc O (s ++ [d]) I r M :=
  Submodule.span_mono (mainSel_append G Mc O s d I r M)

/-- Main projections are nested in the insertion index (blueprint line 1828). -/
theorem mainProj_nest (s : List (CatCol Tg)) (d : CatCol Tg) (I : ℤ × ℤ) (r : ℕ)
    (M : Tg → Prop) :
    (mainProj G Mc O s I r M).comp (mainProj G Mc O (s ++ [d]) I r M) =
      mainProj G Mc O s I r M :=
  Submodule.starProjection_comp_starProjection_of_le (mainRange_append G Mc O s d I r M)

/-- Main projections grow with the rank and the vertex mask (nested in the pad, blueprint
line 1807). -/
theorem mainRange_mono (s : List (CatCol Tg)) (I : ℤ × ℤ) {r r' : ℕ} {M M' : Tg → Prop}
    (hr : r ≤ r') (hM : ∀ t, M t → M' t) :
    mainRange G Mc O s I r M ≤ mainRange G Mc O s I r' M' := by
  refine Submodule.span_mono ?_
  rintro x (⟨v, h1, h2, rfl⟩ | ⟨n, hn, h1, h2, h3, rfl⟩)
  · exact Or.inl ⟨v, h1, hM _ h2, rfl⟩
  · exact Or.inr ⟨n, hn, h1, h2.trans hr, hM _ h3, rfl⟩

/-- Vectors whose template coordinates from the label `n` on vanish. -/
def MainFresh (n : ℕ) (x : ColumnL2 (V ⊕ Fin Mc)) : Prop :=
  ∀ m : Fin Mc, n ≤ (m : ℕ) →
    ∀ᵐ y ∂volume, (x : ℝ → ColumnHilbert (V ⊕ Fin Mc)) y (some (Sum.inr m)) = 0

variable {G Mc O}

theorem MainFresh.add {n : ℕ} {x x' : ColumnL2 (V ⊕ Fin Mc)} (h : MainFresh Mc n x)
    (h' : MainFresh Mc n x') : MainFresh Mc n (x + x') := fun m hm => by
  filter_upwards [h m hm, h' m hm, Lp.coeFn_add x x'] with y hx hx' hy
  rw [hy, Pi.add_apply, PiLp.add_apply, hx, hx', add_zero]

theorem MainFresh.smul {n : ℕ} {x : ColumnL2 (V ⊕ Fin Mc)} (h : MainFresh Mc n x) (c : ℂ) :
    MainFresh Mc n (c • x) := fun m hm => by
  filter_upwards [h m hm, Lp.coeFn_smul c x] with y hx hy
  rw [hy, Pi.smul_apply, PiLp.smul_apply, hx, smul_zero]

theorem MainFresh.sub {n : ℕ} {x x' : ColumnL2 (V ⊕ Fin Mc)} (h : MainFresh Mc n x)
    (h' : MainFresh Mc n x') : MainFresh Mc n (x - x') := by
  rw [sub_eq_add_neg, ← neg_one_smul ℂ x']
  exact h.add (h'.smul _)

theorem mainFresh_zero (n : ℕ) : MainFresh Mc n (0 : ColumnL2 (V ⊕ Fin Mc)) := fun m _ => by
  filter_upwards [Lp.coeFn_zero (ColumnHilbert (V ⊕ Fin Mc)) 2 volume] with y hy
  rw [hy]; rfl

theorem MainFresh.mono {n n' : ℕ} (hn : n ≤ n') {x : ColumnL2 (V ⊕ Fin Mc)}
    (h : MainFresh Mc n x) : MainFresh Mc n' x := fun m hm => h m (hn.trans hm)

/-- The main ranges have no template coordinates beyond the current catalog length. -/
theorem mainRange_fresh (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop)
    {x : ColumnL2 (V ⊕ Fin Mc)} (hx : x ∈ mainRange G Mc O s I r M) :
    MainFresh Mc s.length x := by
  intro m hm
  refine Submodule.span_induction (R := ℂ) (M := ColumnL2 (V ⊕ Fin Mc)) (p := fun x _ =>
    ∀ᵐ y ∂volume, (x : ℝ → ColumnHilbert (V ⊕ Fin Mc)) y (some (Sum.inr m)) = 0) ?_ ?_ ?_ ?_ hx
  · rintro x (⟨v, -, -, rfl⟩ | ⟨n, hn, -, -, -, rfl⟩)
    · exact wColumn_some_ne (by simp)
    · refine wColumn_some_ne ?_
      intro he
      have := Sum.inr.inj he
      rw [this] at hm
      omega
  · exact mainFresh_zero (Mc := Mc) s.length m hm
  · intro x y _ _ hx hy
    filter_upwards [hx, hy, Lp.coeFn_add x y] with z hx hy hz
    rw [hz, Pi.add_apply, PiLp.add_apply, hx, hy, add_zero]
  · intro c x _ hx
    filter_upwards [hx, Lp.coeFn_smul c x] with z hx hz
    rw [hz, Pi.smul_apply, PiLp.smul_apply, hx, smul_zero]

theorem mainProj_fresh (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop)
    (x : ColumnL2 (V ⊕ Fin Mc)) : MainFresh Mc s.length (mainProj G Mc O s I r M x) :=
  mainRange_fresh s I r M (Submodule.starProjection_apply_mem _ x)

end MainProjections

section MainGain
variable {W : Type*} [Fintype W]

open scoped Classical in
/-- The inner product of a weighted column with a vector without the column's private coordinate
is the moment of the physical part against the scalar. -/
theorem inner_wColumn {s : Set ℝ} (hs : MeasurableSet s) {φ : W → ℝ → ℂ} {ε : W → ℝ} {x : W}
    (h : MemLp (s.indicator (privateColumnValue φ ε x)) 2 volume) (X : ColumnL2 W)
    (hX : ∀ᵐ y ∂volume, (X : ℝ → ColumnHilbert W) y (some x) = 0) :
    inner ℂ (wColumn s φ ε x) X = ∫ y in s, conj (φ x y) * (X : ℝ → ColumnHilbert W) y none := by
  rw [MeasureTheory.L2.inner_def, ← integral_indicator hs]
  refine integral_congr_ae ?_
  filter_upwards [wColumn_coeFn h, hX] with y hy hXy
  rw [hy]
  by_cases hys : y ∈ s
  · rw [Set.indicator_of_mem hys, Set.indicator_of_mem hys]
    unfold privateColumnValue
    rw [inner_add_left, inner_smul_left, inner_smul_left, EuclideanSpace.inner_single_left,
      EuclideanSpace.inner_single_left, hXy]
    simp
  · rw [Set.indicator_of_notMem hys, Set.indicator_of_notMem hys]
    simp

/-- A column with scalar bounded by one and weight at most one has squared norm at most twice the
measure of its set. -/
theorem norm_wColumn_sq_le {s : Set ℝ} (hs : MeasurableSet s) (hsv : volume s < ⊤)
    {φ : W → ℝ → ℂ} {ε : W → ℝ} {x : W} (hφm : Measurable (φ x)) (hφ : ∀ y, ‖φ x y‖ ≤ 1)
    (hε0 : 0 ≤ ε x) (hε1 : ε x ≤ 1) : ‖wColumn s φ ε x‖ ^ 2 ≤ 2 * volume.real s := by
  have h := wColumn_memLp (W := W) hs hsv ε hφm (C := 1) fun y _ => hφ y
  rw [columnInput_norm_sq_integral]
  have hle : ∀ y, ‖s.indicator (privateColumnValue φ ε x) y‖ ^ 2 ≤
      s.indicator (fun _ => (2 : ℝ)) y := fun y => by
    by_cases hys : y ∈ s
    · rw [Set.indicator_of_mem hys, Set.indicator_of_mem hys,
        norm_privateColumnValue_sq φ ε x y hε0]
      nlinarith [hφ y, norm_nonneg (φ x y)]
    · rw [Set.indicator_of_notMem hys, Set.indicator_of_notMem hys]; simp
  calc ∫ y, ‖(wColumn s φ ε x : ℝ → ColumnHilbert W) y‖ ^ 2
      = ∫ y, ‖s.indicator (privateColumnValue φ ε x) y‖ ^ 2 := by
        refine integral_congr_ae ?_
        filter_upwards [wColumn_coeFn h] with y hy
        rw [hy]
    _ ≤ ∫ y, s.indicator (fun _ => (2 : ℝ)) y := by
        refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun y => by positivity)
          ((integrableOn_const hsv.ne).integrable_indicator hs) (Filter.Eventually.of_forall hle)
    _ = 2 * volume.real s := by
        rw [integral_indicator hs, setIntegral_const, smul_eq_mul, mul_comm]

end MainGain

section MainTests
variable {V : Type} [Fintype V] {Tg : Type*} {G : RealDyadicGrid} {Mc : ℕ} {O : OrigCols V Tg}

/-- The template column appended at the end of the catalog lies in the new range when it
qualifies. -/
theorem mainCol_last_mem (s : List (CatCol Tg)) (d : CatCol Tg) (I : ℤ × ℤ) (r : ℕ)
    (M : Tg → Prop) (hlen : s.length < Mc)
    (hI : dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2) (hr : d.rank ≤ r)
    (hM : M d.tag) :
    mainCol G Mc O (s ++ [d]) I (Sum.inr ⟨s.length, hlen⟩) ∈
      mainRange G Mc O (s ++ [d]) I r M := by
  refine Submodule.subset_span (Or.inr ⟨⟨s.length, hlen⟩, by simp, ?_⟩)
  have e : (s ++ [d])[s.length]'(by simp) = d := by simp
  simp only [e]
  exact ⟨hI, hr, hM, by trivial⟩

theorem catAtom_append_length (s : List (CatCol Tg)) (d : CatCol Tg) :
    catAtom (s ++ [d]) s.length = d.atom := by
  unfold catAtom
  simp

/-- The gain of a template insertion (blueprint line 1825): the target projection grows on a
vector without fresh template coordinates by at least the residual moment of the new column. -/
theorem mainProj_gain (s : List (CatCol Tg)) (d : CatCol Tg) (I : ℤ × ℤ) (r : ℕ)
    (M : Tg → Prop) (hlen : s.length < Mc)
    (hI : dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2) (hr : d.rank ≤ r)
    (hM : M d.tag) (X : ColumnL2 (V ⊕ Fin Mc)) (hX : MainFresh Mc s.length X) :
    ‖∫ y in dyadicGridCell G I.1 I.2, conj (d.atom y) *
        ((X - mainProj G Mc O s I r M X : ColumnL2 (V ⊕ Fin Mc)) :
          ℝ → ColumnHilbert (V ⊕ Fin Mc)) y none‖ ≤
      2 * Real.sqrt (dyadicGridLength G I.1) *
        ‖(mainProj G Mc O (s ++ [d]) I r M - mainProj G Mc O s I r M) X‖ := by
  set! u := mainCol G Mc O (s ++ [d]) I (Sum.inr ⟨s.length, hlen⟩) with hu
  set Pn := mainProj G Mc O (s ++ [d]) I r M
  set Po := mainProj G Mc O s I r M
  have hcell := dyadicGridCell_measurable G I.1 I.2
  have hvol : volume (dyadicGridCell G I.1 I.2) < ⊤ := by
    rw [dyadicGridCell_volume]; exact ENNReal.ofReal_lt_top
  have hsc : mainScalar Mc O (s ++ [d]) (Sum.inr ⟨s.length, hlen⟩) = d.atom :=
    catAtom_append_length s d
  have hmeas : Measurable (mainScalar Mc O (s ++ [d]) (Sum.inr ⟨s.length, hlen⟩)) := by
    rw [hsc]; exact d.meas
  have hmemLp := wColumn_memLp (W := V ⊕ Fin Mc) hcell hvol (mainWeight Mc O) hmeas (C := 1)
    fun y _ => by rw [hsc]; exact d.bound y
  have hmem := mainCol_last_mem (O := O) s d I r M hlen hI hr hM
  have hfresh : MainFresh Mc s.length (X - Po X) := hX.sub (mainProj_fresh s I r M X)
  have hin := inner_wColumn hcell hmemLp (X - Po X) (hfresh ⟨s.length, hlen⟩ le_rfl)
  rw [hsc] at hin
  change inner ℂ u (X - Po X) = _ at hin
  rw [← hin]
  have hPu : Pn u = u := Submodule.starProjection_eq_self_iff.mpr hmem
  have key : inner ℂ u (X - Po X) = inner ℂ u ((Pn - Po) X) := by
    rw [sub_apply, inner_sub_right, inner_sub_right]
    congr 1
    calc inner ℂ u X = inner ℂ (Pn u) X := by rw [hPu]
      _ = inner ℂ u (Pn X) := Submodule.inner_starProjection_left_eq_right _ u X
  rw [key]
  have hcs := norm_inner_le_norm (𝕜 := ℂ) u ((Pn - Po) X)
  have hnorm := norm_wColumn_sq_le (W := V ⊕ Fin Mc) hcell hvol (ε := mainWeight Mc O) hmeas
    (fun y => by rw [hsc]; exact d.bound y) zero_le_one le_rfl
  rw [measureReal_def, dyadicGridCell_volume,
    ENNReal.toReal_ofReal (dyadicGridLength_pos G I.1).le] at hnorm
  have hu2 : ‖u‖ ≤ 2 * Real.sqrt (dyadicGridLength G I.1) := by
    rw [← Real.sqrt_sq (norm_nonneg u)]
    calc Real.sqrt (‖u‖ ^ 2) ≤ Real.sqrt (4 * dyadicGridLength G I.1) :=
          Real.sqrt_le_sqrt (by
            have : ‖u‖ ^ 2 ≤ 2 * dyadicGridLength G I.1 := hnorm
            have := (dyadicGridLength_pos G I.1).le
            linarith)
      _ = 2 * Real.sqrt (dyadicGridLength G I.1) := by
          rw [Real.sqrt_mul (by norm_num), show (4 : ℝ) = 2 ^ 2 by norm_num,
            Real.sqrt_sq (by norm_num)]
  exact hcs.trans (mul_le_mul_of_nonneg_right hu2 (norm_nonneg _))

/-- The normalized `L²` norm on the cell `I` of a column-space vector. -/
noncomputable def cellNorm {W : Type*} [Fintype W] (G : RealDyadicGrid) (I : ℤ × ℤ)
    (x : ColumnL2 W) : ℝ :=
  Real.sqrt ((dyadicGridLength G I.1)⁻¹ *
    ∫ y in dyadicGridCell G I.1 I.2, ‖(x : ℝ → ColumnHilbert W) y‖ ^ 2)

end MainTests

/-- A named main catalog test (blueprint eq:catalog-test, lines 1809-1815): the residual slot
`t`, the target rank and vertex mask, a history of at most `m` main filters (ranks, masks and
complement flags) and its base, a fixed augmented vector (a basic `B`, a basic side `U`, or for
the helper rank a fixed vector-valued base). -/
structure MainTest (Tg : Type*) (V : Type) [Fintype V] (Mc : ℕ) where
  /-- Residual slot selected by the main catalog test. -/
  t : Fin 4
  /-- Rank cutoff of the residual-slot main projection. -/
  r : ℕ
  /-- Tag mask of the residual-slot main projection. -/
  M : Tg → Prop
  /-- Number of historical high-slot factors in the main test. -/
  m : ℕ
  /-- Rank cutoff for each historical main-test factor. -/
  hr : ℕ → ℕ
  /-- Tag mask for each historical main-test factor. -/
  hM : ℕ → Tg → Prop
  /-- Boolean choices specifying the historical main-test projection factors. -/
  θ : ℕ → Bool
  /-- Column L² input containing original labels and finite catalog labels. -/
  base : ColumnL2 (V ⊕ Fin Mc)

namespace MainTest
variable {V : Type} [Fintype V] {Tg : Type*} (G : RealDyadicGrid) (Mc : ℕ) (O : OrigCols V Tg)
  (I : ℤ × ℤ) (w : MainTest Tg V Mc)

/-- The history factor of index `l` (the identity beyond the history length). -/
noncomputable def Q (s : List (CatCol Tg)) (l : ℕ) :
    ColumnL2 (V ⊕ Fin Mc) →L[ℂ] ColumnL2 (V ⊕ Fin Mc) :=
  if l < w.m then mainProj G Mc O s I (w.hr l) (w.hM l) else ContinuousLinearMap.id ℂ _

/-- The history value on the base. -/
noncomputable def hist (mH : ℕ) (s : List (CatCol Tg)) : ColumnL2 (V ⊕ Fin Mc) :=
  operatorComplementProduct (fun l => w.Q G Mc O I s l) w.θ mH w.base

/-- The target residual of the history value. -/
noncomputable def resid (mH : ℕ) (s : List (CatCol Tg)) : ColumnL2 (V ⊕ Fin Mc) :=
  w.hist G Mc O I mH s - mainProj G Mc O s I w.r w.M (w.hist G Mc O I mH s)

theorem Q_isStarProjection (s : List (CatCol Tg)) (l : ℕ) :
    IsStarProjection (w.Q G Mc O I s l) := by
  unfold Q; split_ifs
  · exact mainProj_isStarProjection G Mc O s I _ _
  · exact IsStarProjection.one _

theorem Q_nest (s : List (CatCol Tg)) (d : CatCol Tg) (l : ℕ) :
    (w.Q G Mc O I s l).comp (w.Q G Mc O I (s ++ [d]) l) = w.Q G Mc O I s l := by
  unfold Q; split_ifs
  · exact mainProj_nest G Mc O s d I _ _
  · rfl

variable {G Mc O I w}

theorem fresh_complementProduct (s : List (CatCol Tg)) (θ : ℕ → Bool) (n : ℕ)
    (hn : s.length ≤ n) : ∀ (k : ℕ) {x : ColumnL2 (V ⊕ Fin Mc)}, MainFresh Mc n x →
      MainFresh Mc n (operatorComplementProduct (fun l => w.Q G Mc O I s l) θ k x)
  | 0, x, hx => hx
  | k + 1, x, hx => by
    have ih := fresh_complementProduct s θ n hn k hx
    set y := operatorComplementProduct (fun l => w.Q G Mc O I s l) θ k x
    have hQ : MainFresh Mc n (w.Q G Mc O I s k y) := by
      unfold Q; split_ifs
      · exact (mainProj_fresh s I _ _ y).mono hn
      · exact ih
    change MainFresh Mc n ((if θ k then ContinuousLinearMap.id ℂ _ - w.Q G Mc O I s k else
      w.Q G Mc O I s k) y)
    split_ifs
    · rw [sub_apply]; exact ih.sub hQ
    · exact hQ

theorem hist_fresh (mH : ℕ) (s : List (CatCol Tg)) (hb : MainFresh Mc s.length w.base) :
    MainFresh Mc s.length (w.hist G Mc O I mH s) :=
  fresh_complementProduct s w.θ s.length le_rfl mH hb

end MainTest

namespace MainTest
variable {V : Type} [Fintype V] {Tg : Type*} {Mc : ℕ} (w : MainTest Tg V Mc)

/-- The test passes (blueprint eq:catalog-test): every pure source whose tag lies in the vertex
mask, in any slot other than the residual slot, has form norm at most `τ ‖base‖_{2,I}` against the
target residual and two arbitrary normalized `L²` spectators. -/
def Pass (G : RealDyadicGrid) (O : OrigCols V Tg) (I : ℤ × ℤ) (c₀ : ℕ) (H : ℝ)
    (tagOf : Tg → ChartTag) (wI : ℝ × ℝ → ℂ) (τ : ℝ) (mH : ℕ) (s : List (CatCol Tg)) : Prop :=
  ∀ x, w.M x → ∀ {u a b : Fin 4}, u ≠ w.t → u ≠ a → u ≠ b → w.t ≠ a → w.t ≠ b → a ≠ b →
    ∀ A : QuadraticChartData (tagOf x).dim, QuadraticChartComplexity c₀ H A →
      A.horizontal = (tagOf x).θ → A.matrix = (slotCoeff u : ℚ) • (tagOf x).C →
      A.quadratic = slotCoeff u * (tagOf x).lam →
    ∀ z : Fin 4 → ℝ → ℂ, z u = quadraticChartAtom A →
      z w.t = (fun y => (w.resid G Mc O I mH s : ℝ → ColumnHilbert (V ⊕ Fin Mc)) y none) →
      Measurable (z a) → Measurable (z b) →
      eLpNorm (z a) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≤ 1 →
      eLpNorm (z b) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≤ 1 →
      ‖localProgressionForm (dyadicGridLength G I.1) wI z‖ ≤ τ * cellNorm G I w.base

end MainTest

/-! ### The original basic columns of an active setup (blueprint lines 1613, 1676-1686) -/

namespace ActiveSetup
variable {κ : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ c₀)

/-- The basic projections of a column representation of the setup, two per slot, with their
column budgets and charts, representing `B_l = P_{l,0} - P_{l,1}` on the cells of the setup
(blueprint prop:base, lines 1607 and 1613). -/
structure BasicFamilies where
  /-- The two basic projection systems representing each of the four slots. -/
  P : Fin 4 → Fin 2 → BasicProjection A.G A.R 1
  budget : ∀ l j, (P l j).Ψ.D.budget ≤ A.colBudget
  charts : ∀ l j, (P l j).HasChartsOn ↑A.cells c₀ A.H
  energy : ∀ l j, (P l j).CellEnergyOn ↑A.cells
  rep : ∀ l, ∀ I ∈ A.cells, ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
    A.B l I y = (P l 0).val I y - (P l 1).val I y

variable {A} in
theorem HasColumnRep.families (h : A.HasColumnRep 1) : Nonempty A.BasicFamilies := by
  choose P₁ P₂ h₁ h₂ c₁ c₂ e₁ e₂ hP using h
  refine ⟨⟨fun l j => ![P₁ l, P₂ l] j, fun l j => ?_, fun l j => ?_, fun l j => ?_,
    fun l I hI => hP l I hI⟩⟩
  · fin_cases j
    · exact h₁ l
    · exact h₂ l
  · fin_cases j
    · exact c₁ l
    · exact c₂ l
  · fin_cases j
    · exact e₁ l
    · exact e₂ l

/-- The vertex bound `D` of an attempt on the original basic columns: the original columns
available at a cell number at most `8` column budgets of the setup (blueprint line 1679: at most
`D` members along a path). -/
noncomputable def famVtxBound : ℕ := ⌊8 * A.colBudget⌋₊ + 1

theorem one_le_famVtxBound : 1 ≤ A.famVtxBound := Nat.le_add_left 1 _

/-- A cell of the admission tree is not deeper than some cell of the setup. -/
theorem exists_cell_depth_ge {I : ℤ × ℤ} (hI : I ∈ dyadicFiniteTree A.G A.R A.treeDepth)
    (hne : A.cells.Nonempty) : ∃ c ∈ A.cells, I.1 ≤ c.1 := by
  obtain ⟨c, hc, hcs⟩ := Finset.exists_mem_eq_sup A.cells hne fun I : ℤ × ℤ => (I.1 - A.R.1).toNat
  refine ⟨c, hc, ?_⟩
  have h1 := ((dyadicFiniteTree_mem_iff A.G A.R I _).mp hI).2
  have h2 := dyadicGridCell_depth_le_of_subset A.G c A.R (A.sub c hc)
  have h3 : A.treeDepth = (c.1 - A.R.1).toNat := hcs
  omega

end ActiveSetup

namespace ActiveSetup.BasicFamilies
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} (bf : A.BasicFamilies)

/-- The labels of the original basic columns of the slot `l`: family index and family label. -/
abbrev SLab (l : Fin 4) : Type := Σ j : Fin 2, (bf.P l j).V

/-- The labels of the original basic columns: slot and slot label. -/
abbrev Lab : Type := Σ l : Fin 4, bf.SLab l

/-- An original basic column occurrence is available at a cell of the setup when its label lies
in the mask of its family there (blueprint line 1676: a vertex is an original basic column
occurrence). -/
def occAvail (I : ℤ × ℤ) (x : bf.Lab) : Prop :=
  I ∈ A.cells ∧ x.2.2 ∈ (bf.P x.1 x.2.1).Ψ.A.labels I

/-- The vertices of the attempt: original basic column occurrences with their admission cells. -/
abbrev Vtx := AdmVertex (G := A.G) (R := A.R) (N := A.treeDepth) (Λ := bf.Lab)

open scoped Classical in
/-- The admission tree of the original basic columns. -/
noncomputable def admT : AdmTree bf.Vtx :=
  admTree (G := A.G) (R := A.R) (N := A.treeDepth) bf.occAvail

theorem exists_vchart (x : bf.Vtx) : ∃ p : Σ d, QuadraticChartData d, 1 ≤ p.1 ∧
    QuadraticChartComplexity (max c₀ (2 * tagKρ)) (max A.H ActiveSetup.padW) p.2 ∧
    (bf.occAvail x.2.1 x.1 →
      QuadraticChartComplexity (max c₀ (2 * tagKρ)) (max A.H ActiveSetup.padW) p.2 ∧
      IsBoundedQuadraticChart p.2 ∧ ∀ y ∈ dyadicGridCell A.G x.2.1.1 x.2.1.2,
        (bf.P x.1.1 x.1.2.1).Ψ.D.scalar x.1.2.2 y = quadraticChartAtom p.2 y) := by
  by_cases h : bf.occAvail x.2.1 x.1
  · obtain ⟨-, -, hch⟩ := bf.charts x.1.1 x.1.2.1 x.2.1 h.1
    obtain ⟨d, B, h1, h2, h3⟩ := hch x.1.2.2 h.2
    rcases Nat.eq_zero_or_pos d with hd | hd
    · subst hd
      have hW : Real.exp 2 ≤ max A.H ActiveSetup.padW :=
        le_trans (le_max_left _ _) (le_max_right _ _)
      obtain ⟨B', hc, hb, ha, -, -, -⟩ := chart_pad B h2 hW
        (le_trans (le_max_right _ _) (le_max_right _ _))
      have hcB := quadraticChartComplexity_mono_order hc (le_max_right c₀ (2 * tagKρ))
      exact ⟨⟨1, B'⟩, le_rfl, hcB, fun _ => ⟨hcB, hb, fun y hy => by rw [h3 y hy, ha]⟩⟩
    · have hcB := quadraticChartComplexity_mono_order
        (quadraticChartComplexity_mono h1 (le_max_left A.H ActiveSetup.padW))
        (le_max_left c₀ (2 * tagKρ))
      exact ⟨⟨d, B⟩, hd, hcB, fun _ => ⟨hcB, h2, h3⟩⟩
  · have hW : Real.exp 2 ≤ max A.H ActiveSetup.padW :=
      le_trans (le_max_left _ _) (le_max_right _ _)
    have hH0 : 0 < max A.H ActiveSetup.padW := lt_of_lt_of_le (Real.exp_pos 2) hW
    refine ⟨⟨1, ⟨fun _ => 0, 0, 0, 0, fun _ => 0, contDiff_const, HasCompactSupport.zero⟩⟩,
      le_rfl, ⟨hW, ?_, fun i j => ?_, fun z hz => (hz rfl).elim, fun m word z => ?_⟩,
      fun h' => absurd h' h⟩
    · have h2 : (2 : ℝ) ≤ Real.log (max A.H ActiveSetup.padW) := by
        rw [Real.le_log_iff_exp_le hH0]; exact hW
      push_cast
      linarith
    · have h1 : (1 : ℝ) ≤ max A.H ActiveSetup.padW :=
        le_trans (by have := Real.add_one_le_exp (2 : ℝ); linarith) hW
      simpa [chartRationalHeight] using h1
    · have h0 : coordinateWordDerivative m (fun _ : Fin 1 → ℝ => (0 : ℂ)) word z = 0 := by
        simp [coordinateWordDerivative, iteratedFDeriv_fun_zero]
      change ‖coordinateWordDerivative m (fun _ : Fin 1 → ℝ => (0 : ℂ)) word z‖ ≤ _
      rw [h0, norm_zero]
      positivity

/-- The chart of a vertex at its admission cell (a fixed default when unavailable). -/
noncomputable def vchart (x : bf.Vtx) : Σ d, QuadraticChartData d :=
  Classical.choose (bf.exists_vchart x)

theorem vchart_spec (x : bf.Vtx) (h : bf.occAvail x.2.1 x.1) :
    QuadraticChartComplexity (max c₀ (2 * tagKρ)) (max A.H ActiveSetup.padW) (bf.vchart x).2 ∧
      IsBoundedQuadraticChart (bf.vchart x).2 ∧ ∀ y ∈ dyadicGridCell A.G x.2.1.1 x.2.1.2,
        (bf.P x.1.1 x.1.2.1).Ψ.D.scalar x.1.2.2 y = quadraticChartAtom (bf.vchart x).2 y :=
  (Classical.choose_spec (bf.exists_vchart x)).2.2 h

theorem one_le_vchart_dim (x : bf.Vtx) : 1 ≤ (bf.vchart x).1 :=
  (Classical.choose_spec (bf.exists_vchart x)).1

/-- The chart of every vertex (available or not) has the complexity of the setup's charts: the
default chart of an unavailable vertex is the zero chart of dimension one. -/
theorem vchart_complexity (x : bf.Vtx) :
    QuadraticChartComplexity (max c₀ (2 * tagKρ)) (max A.H ActiveSetup.padW) (bf.vchart x).2 :=
  (Classical.choose_spec (bf.exists_vchart x)).2.1

/-- The normalized tag of a vertex: its slot multiplier `c_l` is removed from the matrix and the
quadratic coefficient (blueprint line 1677). -/
noncomputable def vtag (x : bf.Vtx) : ChartTag where
  dim := (bf.vchart x).1
  θ := (bf.vchart x).2.horizontal
  C := ((slotCoeff x.1.1 : ℚ)⁻¹) • (bf.vchart x).2.matrix
  lam := (bf.vchart x).2.quadratic / slotCoeff x.1.1

/-- The tag graph at depth `s`: tags joined by an edge at the cell length of depth `s`, or equal
tags (blueprint lines 1682-1686). -/
def tagGraphEdge (Hed : ℝ) (s : ℤ) (x y : bf.Vtx) : Prop :=
  tagEdge Hed (dyadicGridLength A.G s) (bf.vtag x) (bf.vtag y) ∨ bf.vtag x = bf.vtag y

/-- The graph distances of the tag graph; they decrease with depth. -/
noncomputable def tagDist (Hed : ℝ) : DepthDistance bf.Vtx :=
  DepthDistance.ofEdges (bf.tagGraphEdge Hed)
    (fun _ _ _ h => h.elim (fun h => Or.inl (tagEdge_symm h)) fun h => Or.inr h.symm)
    (fun {_ s'} hss _ _ h => h.elim (fun h => Or.inl (tagEdge_refine h
      (dyadicGridLength_pos A.G s').le ((dyadicGridLength_strictAnti A.G).antitone hss))) Or.inr)


/-- A label available at an ancestor of a cell of the admission tree is in its family mask at
the cell. -/
theorem mem_labels_of_admAnc {I : AdmCell A.G A.R A.treeDepth} {x : bf.Lab}
    (h : (admAnc (G := A.G) (R := A.R) (N := A.treeDepth) bf.occAvail I x).Nonempty) :
    I.1 ∈ (bf.P x.1 x.2.1).Ψ.D.cells ∧ x.2.2 ∈ (bf.P x.1 x.2.1).Ψ.A.labels I.1 := by
  obtain ⟨J, hJ⟩ := h
  obtain ⟨hIJ, hJc, hJl⟩ := (mem_admAnc bf.occAvail).mp hJ
  set P := bf.P x.1 x.2.1
  obtain ⟨hJD, -, -⟩ := bf.charts x.1 x.2.1 J.1 hJc
  obtain ⟨c, hc, hIc⟩ := A.exists_cell_depth_ge I.2 ⟨J.1, hJc⟩
  obtain ⟨-, hcN, -⟩ := bf.charts x.1 x.2.1 c hc
  have hgrid : P.Ψ.D.grid = A.G := P.grid
  have hIR : dyadicGridCell A.G I.1.1 I.1.2 ⊆ dyadicGridCell A.G A.R.1 A.R.2 :=
    ((dyadicFiniteTree_mem_iff A.G A.R I.1 _).mp I.2).1
  have hID : I.1 ∈ P.Ψ.D.cells := by
    refine P.Ψ.complete I.1 ?_ (hIc.trans hcN)
    rw [hgrid]
    exact hIR.trans P.root_sub
  refine ⟨hID, P.Ψ.A.inherited I.1 hID J.1 hJD ?_ hJl⟩
  rw [hgrid]
  exact hIJ

/-- At most `8` column budgets of original columns are present at any cell. -/
theorem admT_X_card_le (c : bf.admT.Cell) : (bf.admT.X c).card ≤ A.famVtxBound := by
  classical
  rcases c with _ | I
  · change (∅ : Finset bf.Vtx).card ≤ _; simp
  have h1 : (bf.admT.X (some I)).card ≤
      (Finset.univ.filter fun x : bf.Lab =>
        (admAnc (G := A.G) (R := A.R) (N := A.treeDepth) bf.occAvail I x).Nonempty).card := by
    refine Finset.card_le_card_of_injOn (fun x => x.1) (fun x hx => ?_) (fun x hx y hy hxy => ?_)
    · obtain ⟨h, -⟩ := (mem_admPresent bf.occAvail).mp hx
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, h⟩
    · obtain ⟨-, hx2⟩ := (mem_admPresent bf.occAvail).mp hx
      obtain ⟨-, hy2⟩ := (mem_admPresent bf.occAvail).mp hy
      have hxy' : x.1 = y.1 := hxy
      exact Prod.ext hxy' (by rw [hx2, hy2, hxy'])
  by_cases hne : A.cells.Nonempty
  swap
  · have he : (Finset.univ.filter fun x : bf.Lab =>
        (admAnc (G := A.G) (R := A.R) (N := A.treeDepth) bf.occAvail I x).Nonempty) = ∅ := by
      refine Finset.filter_eq_empty_iff.mpr fun x _ hx => hne ?_
      obtain ⟨J, hJ⟩ := hx
      exact ⟨J.1, ((mem_admAnc bf.occAvail).mp hJ).2.1⟩
    rw [he, Finset.card_empty] at h1
    omega
  have hID : ∀ lj : Fin 4 × Fin 2, I.1 ∈ (bf.P lj.1 lj.2).Ψ.D.cells := fun lj => by
    obtain ⟨c, hc, hIc⟩ := A.exists_cell_depth_ge I.2 hne
    obtain ⟨-, hcN, -⟩ := bf.charts lj.1 lj.2 c hc
    refine (bf.P lj.1 lj.2).Ψ.complete I.1 ?_ (hIc.trans hcN)
    rw [(bf.P lj.1 lj.2).grid]
    exact (((dyadicFiniteTree_mem_iff A.G A.R I.1 _).mp I.2).1).trans (bf.P lj.1 lj.2).root_sub
  have hsub : (Finset.univ.filter fun x : bf.Lab =>
      (admAnc (G := A.G) (R := A.R) (N := A.treeDepth) bf.occAvail I x).Nonempty) ⊆
      (Finset.univ : Finset (Fin 4 × Fin 2)).biUnion fun lj =>
        ((bf.P lj.1 lj.2).Ψ.A.labels I.1).image fun v => (⟨lj.1, ⟨lj.2, v⟩⟩ : bf.Lab) := by
    intro x hx
    have hl := (bf.mem_labels_of_admAnc (Finset.mem_filter.mp hx).2).2
    refine Finset.mem_biUnion.mpr ⟨(x.1, x.2.1), Finset.mem_univ _, ?_⟩
    exact Finset.mem_image.mpr ⟨x.2.2, hl, rfl⟩
  have h2 := (Finset.card_le_card hsub).trans (Finset.card_biUnion_le
    (s := (Finset.univ : Finset (Fin 4 × Fin 2)))
    (t := fun lj => ((bf.P lj.1 lj.2).Ψ.A.labels I.1).image
      fun v => (⟨lj.1, ⟨lj.2, v⟩⟩ : bf.Lab)))
  have h4 : ∀ lj : Fin 4 × Fin 2, ((((bf.P lj.1 lj.2).Ψ.A.labels I.1).image
      fun v => (⟨lj.1, ⟨lj.2, v⟩⟩ : bf.Lab)).card : ℝ) ≤ A.colBudget := fun lj =>
    (Nat.cast_le.mpr Finset.card_image_le).trans ((InheritedColumnMask_card_le _ _
      (hID lj)).trans (bf.budget lj.1 lj.2))
  have h5 : ((Finset.univ.filter fun x : bf.Lab =>
      (admAnc (G := A.G) (R := A.R) (N := A.treeDepth) bf.occAvail I x).Nonempty).card : ℝ) ≤
      8 * A.colBudget := by
    refine (Nat.cast_le.mpr h2).trans ?_
    push_cast
    refine (Finset.sum_le_sum fun lj _ => h4 lj).trans ?_
    simp
  have h6 := Nat.le_floor h5
  unfold famVtxBound
  omega

end ActiveSetup.BasicFamilies

/-! ### Colors and masks on the original basic columns (blueprint lines 1712-1773, 1804-1807) -/

namespace ActiveSetup
variable {κ : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ c₀)

/-- The primary depth `d₀ = ⌈1000 log 2D⌉` of an attempt on the original basic columns. -/
noncomputable def fcd0 : ℕ := colorDegree A.famVtxBound

/-- The primary scale `b₁ = d₀^{10} b₂ (H_max + 1)` (blueprint line 1716). -/
noncomputable def fcb1 (Hmax : ℕ) : ℕ := A.fcd0 ^ 10 * cb2 Hmax * (Hmax + 1)

end ActiveSetup

namespace ActiveSetup.BasicFamilies
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} (bf : A.BasicFamilies)

noncomputable instance : Fintype bf.admT.Cell :=
  inferInstanceAs (Fintype (Option (AdmCell A.G A.R A.treeDepth)))

open Classical in
/-- Blueprint lines 1720-1734 for one attempt on the original basic columns: the delays of the
decreasing colors can be fixed so that the failed cells have total length at most
`100 · 2001⁷ |R| / D`. -/
theorem coloring (Hed : ℝ) (b1 b2 : ℕ) :
    ∃ ωp ωh : Fin (colorDegree A.famVtxBound) → bf.Vtx →
      Fin (colorDegree A.famVtxBound + 1),
      IsMonotoneColoring bf.admT (bf.tagDist Hed) A.famVtxBound b1 b2 Finset.univ
        (admCellSet (G := A.G) (R := A.R) (N := A.treeDepth))
        (dyadicGridCell A.G A.R.1 A.R.2) ωp ωh := by
  have hR : volume (dyadicGridCell A.G A.R.1 A.R.2) ≠ ⊤ := by
    rw [dyadicGridCell_volume]; exact ENNReal.ofReal_ne_top
  have hnest : ∀ c ∈ (Finset.univ : Finset bf.admT.Cell),
      ∀ c' ∈ (Finset.univ : Finset bf.admT.Cell),
      (admCellSet c ∩ admCellSet c').Nonempty → bf.admT.Anc c c' ∨ bf.admT.Anc c' c :=
    fun c _ c' _ h => admCellSet_nest (G := A.G) (R := A.R) (N := A.treeDepth) bf.occAvail c c' h
  obtain ⟨ωp, ωh, h⟩ := monotoneColoring bf.admT (bf.tagDist Hed) b1 b2 A.one_le_famVtxBound
    bf.admT_X_card_le Finset.univ admCellSet admCellSet_measurable
    (dyadicGridCell_measurable A.G A.R.1 A.R.2) hR (fun c _ => admCellSet_sub c) hnest
  exact ⟨ωp, ωh, h⟩

open Classical in
/-- The color data of the attempt for fixed delay arrays. -/
noncomputable def colorSetup (Hed : ℝ) (Hmax : ℕ) (ωp ωh : Fin A.fcd0 → bf.Vtx → Fin (A.fcd0 + 1)) :
    ColorSetup bf.Vtx :=
  ColorSetup.ofArrays (bf.tagDist Hed) A.fcd0 (A.fcb1 Hmax) (cb2 Hmax) ωp ωh

open Classical in
theorem colorParams (Hed : ℝ) (Hmax : ℕ) (ωp ωh : Fin A.fcd0 → bf.Vtx → Fin (A.fcd0 + 1)) :
    ColorParams (bf.colorSetup Hed Hmax ωp ωh) Hmax where
  hb2 := rfl
  hb1 := rfl
  hd0 := by
    have := colorDegree_ge A.one_le_famVtxBound
    change 8 ≤ colorDegree A.famVtxBound
    omega

open Classical in
/-- Blueprint lem:masks for one attempt on the original basic columns: the pad masks of the colors
contain the present vertices near a center, are closed under neighbors, have short paths to the
primary winner, and separate distinct groups of one color. -/
theorem masks (Hed : ℝ) (Hmax : ℕ) (ωp ωh : Fin A.fcd0 → bf.Vtx → Fin (A.fcd0 + 1)) :
    let K := bf.colorSetup Hed Hmax ωp ωh
    let T := bf.admT
    (∀ (I : T.Cell) (v : bf.Vtx), v ∈ T.X I → K.Success (K.colorData (T.st I) v) →
      ∀ b ∈ T.X I, ∀ h δ : ℕ, K.dist.d (T.depth I) b v = δ → δ ≤ h → h ≤ Hmax →
        b ∈ K.mask T A.famVtxBound (K.grp T A.famVtxBound I v) h I) ∧
    (∀ (I : T.Cell) (v : bf.Vtx), v ∈ T.X I → K.Success (K.colorData (T.st I) v) →
      ∀ h : ℕ, h < Hmax → ∀ b b' : bf.Vtx,
        b ∈ K.mask T A.famVtxBound (K.grp T A.famVtxBound I v) h I → b' ∈ T.X I →
        K.dist.d (T.depth I) b b' ≤ 1 →
        b' ∈ K.mask T A.famVtxBound (K.grp T A.famVtxBound I v) (h + 1) I) ∧
    (∀ G ρ z g, G.2.1 = some (ρ, z, g) → ∀ (h : ℕ) (I : T.Cell) (b : bf.Vtx),
      b ∈ K.mask T A.famVtxBound G h I →
      ∃ k : ℕ, K.dist.d (T.depth I) z b = k ∧ k ≤ (K.d0 + 1) * K.b1 + h) ∧
    (∀ (I J u₀ u : T.Cell) (v₁ v₂ : bf.Vtx), T.Anc I J → T.Anc I u₀ → T.Anc J u →
      v₁ ∈ T.X u₀ → v₂ ∈ T.X u → K.Success (K.colorData (T.st u₀) v₁) →
      K.Success (K.colorData (T.st u) v₂) →
      K.color T A.famVtxBound u₀ v₁ = K.color T A.famVtxBound u v₂ →
      K.grp T A.famVtxBound u₀ v₁ ≠ K.grp T A.famVtxBound u v₂ →
      ∀ h h' : ℕ, h ≤ Hmax → h' ≤ Hmax → ∀ b b' : bf.Vtx,
        b ∈ K.mask T A.famVtxBound (K.grp T A.famVtxBound u₀ v₁) h I →
        b' ∈ K.mask T A.famVtxBound (K.grp T A.famVtxBound u v₂) h' J →
        ¬ K.dist.d (T.depth J) b b' ≤ 1) :=
  historicalMaskSeparation _ (bf.colorParams Hed Hmax ωp ωh) bf.admT A.famVtxBound
    bf.admT_X_card_le

/-- The admission cell of a cell of the setup (the top otherwise). -/
noncomputable def admAt (I : ℤ × ℤ) : bf.admT.Cell := by
  classical
  exact if h : I ∈ A.cells then
    (some ⟨I, A.cells_mem_tree h⟩ : Option (AdmCell A.G A.R A.treeDepth)) else
    (none : Option (AdmCell A.G A.R A.treeDepth))

/-- The vertex of the original column `x` at a cell of the setup: the label with its admission
cell along the path of the cell. -/
noncomputable def vtxAt (I : ℤ × ℤ) (x : bf.Lab) : bf.Vtx := by
  classical
  exact if h : I ∈ A.cells then
    (x, admCellOf (G := A.G) (R := A.R) (N := A.treeDepth) bf.occAvail ⟨I, A.cells_mem_tree h⟩ x)
  else (x, ⟨A.R, dyadicFiniteTree_root_mem A.G A.R _⟩)

/-- An available original column is present at its cell with its vertex. -/
theorem vtxAt_mem {I : ℤ × ℤ} {x : bf.Lab} (h : bf.occAvail I x) :
    bf.vtxAt I x ∈ bf.admT.X (bf.admAt I) := by
  classical
  have hI := h.1
  simp only [vtxAt, admAt, hI, ↓reduceDIte]
  refine (mem_admPresent bf.occAvail).mpr ⟨⟨⟨I, A.cells_mem_tree hI⟩, ?_⟩, rfl⟩
  exact (mem_admAnc bf.occAvail).mpr ⟨subset_rfl, h⟩

/-- The original columns of the slot `l` as seen by the catalogs (blueprint lines 1676 and
1805), in the common column space of all original basic columns: every original basic column has
its family scalar and private weight; at a cell exactly the columns of the two basic families of
the slot `l` that lie in their family masks are available, with their vertices. The columns of the
other slots are never available for the slot `l`, so the slot-`l` projections act in the
coordinates of the slot `l`. -/
noncomputable def origCols (l : Fin 4) : OrigCols bf.Lab bf.Vtx where
  scalar := fun x => (bf.P x.1 x.2.1).Ψ.D.scalar x.2.2
  weight := fun x => (bf.P x.1 x.2.1).Ψ.D.privateWeight x.2.2
  weight_pos := fun x => (bf.P x.1 x.2.1).Ψ.D.privateWeight_pos x.2.2
  avail := fun I x => x.1 = l ∧ bf.occAvail I x
  tag := fun I x => bf.vtxAt I x

end ActiveSetup.BasicFamilies

/-- The parameters of an attempt on the original basic columns: the edge threshold, the pad
bound, the delays, the number of pads `P`, the number of colors `L`, the label capacity and the
history bound, with all needed neighbor enlargements of the pads below `H_max` (blueprint line
1808). -/
structure ActiveSetup.BasicFamilies.FamParams {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀}
    (bf : A.BasicFamilies) where
  /-- Rational-height budget for edges between basic-family chart tags. -/
  Hed : ℝ
  /-- Maximum graph radius used by the basic-family tag masks. -/
  Hmax : ℕ
  /-- Primary coloring choices for basic-family labels in each round. -/
  ωp : Fin A.fcd0 → bf.Vtx → Fin (A.fcd0 + 1)
  /-- High coloring choices for basic-family labels in each round. -/
  ωh : Fin A.fcd0 → bf.Vtx → Fin (A.fcd0 + 1)
  /-- Positive number of search steps allocated to each basic-family level. -/
  P : ℕ
  hP : 0 < P
  /-- Base catalog rank for the basic-family search. -/
  Lc : ℕ
  /-- Number of main column labels available to the basic-family tests. -/
  Mc : ℕ
  /-- Maximum number of historical factors in a basic-family test. -/
  mH : ℕ
  pads_le : 20 * P * (Lc + 1) + 31 * P + 2 ≤ Hmax

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

/-- The color data of the attempt. -/
noncomputable abbrev K : ColorSetup bf.Vtx := bf.colorSetup fp.Hed fp.Hmax fp.ωp fp.ωh

/-- The rank of the cumulative split `m`: `L - m + 1` (blueprint line 1807). -/
def crank (m : ℕ) : ℕ := fp.Lc - m + 1

/-- The base pad of the cumulative split `m`: `10 P (L - m + 1)` (blueprint line 1807). -/
def cbase (m : ℕ) : ℕ := 10 * fp.P * (fp.Lc - m + 1)

/-- The rank of the ball insertion `j`: `L + j` (blueprint line 1807). -/
def brank (j : ℕ) : ℕ := fp.Lc + j

/-- The base pad of the ball insertion `j`: `20 P (L + 1) + 10 (j - 1) P` (blueprint line 1807). -/
def bbase (j : ℕ) : ℕ := 20 * fp.P * (fp.Lc + 1) + 10 * (j - 1) * fp.P

/-- The helper rank `L + 5` (blueprint line 1815). -/
def hrank : ℕ := fp.Lc + 5

open Classical in
/-- The cumulative mask of the cell `I` at the split `m` and the pad index `p`: the cumulative
mask `U_{m, h}` at the pad `h = 10 P (L - m + 1) + p` (blueprint lines 1804-1807). -/
def cmask (I : ℤ × ℤ) (m p : ℕ) : bf.Vtx → Prop := fun x =>
  x ∈ fp.K.cumMask bf.admT A.famVtxBound m (fp.cbase m + p) (bf.admAt I)

open Classical in
/-- The ball mask of the cell `I` for the group `G` at the ball level `j` and the pad index `p`
(blueprint lines 1807-1808). -/
def bmask (I : ℤ × ℤ) (G : ℕ × (Option (Fin A.fcd0 × bf.Vtx × ℤ) × ℕ × (ℕ × ℕ) ×
    Option (Fin A.fcd0 × bf.Vtx × ℤ))) (j p : ℕ) : bf.Vtx → Prop := fun x =>
  x ∈ fp.K.mask bf.admT A.famVtxBound G (fp.bbase j + p) (bf.admAt I)

/-- Every pad used by a filter, with two neighbor enlargements, lies below `H_max` (blueprint
line 1808). -/
theorem cbase_le {m p : ℕ} (hp : p ≤ fp.P) : fp.cbase m + p + 2 ≤ fp.Hmax := by
  have h := fp.pads_le
  have h1 : fp.cbase m ≤ 10 * fp.P * (fp.Lc + 1) := Nat.mul_le_mul_left _ (by omega)
  have h2 : 10 * fp.P * (fp.Lc + 1) ≤ 20 * fp.P * (fp.Lc + 1) :=
    Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (by norm_num))
  omega

theorem bbase_le {j p : ℕ} (hj : j ≤ 4) (hp : p ≤ fp.P) : fp.bbase j + p + 2 ≤ fp.Hmax := by
  have h := fp.pads_le
  have h1 : 10 * (j - 1) * fp.P ≤ 30 * fp.P := Nat.mul_le_mul_right _ (by omega)
  unfold bbase
  omega

end ActiveSetup.BasicFamilies.FamParams

/-! ### Positive smeared filters and the catalog tests (blueprint lines 1807-1815) -/

section Filters
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-- An average of contractions is a contraction (blueprint line 1807). -/
theorem opAvg_norm_le_one {P : ℕ} (hP : 0 < P) (Q : Fin P → E →L[ℂ] E) (hQ : ∀ p, ‖Q p‖ ≤ 1) :
    ‖opAvg Q‖ ≤ 1 := by
  unfold opAvg
  rw [norm_smul, norm_inv, Complex.norm_natCast]
  have hc : (0 : ℝ) < P := by exact_mod_cast hP
  rw [inv_mul_le_iff₀ hc, mul_one]
  calc ‖∑ p, Q p‖ ≤ ∑ p, ‖Q p‖ := norm_sum_le _ _
    _ ≤ ∑ _p : Fin P, (1 : ℝ) := Finset.sum_le_sum fun p _ => hQ p
    _ = P := by simp

/-- The averages of orthogonal projections and their complements are contractions (blueprint line
1807). -/
theorem opAvg_starProjection_contraction {P : ℕ} (hP : 0 < P) (Q : Fin P → E →L[ℂ] E)
    (hQ : ∀ p, IsStarProjection (Q p)) :
    ‖opAvg Q‖ ≤ 1 ∧ ‖ContinuousLinearMap.id ℂ E - opAvg Q‖ ≤ 1 := by
  refine ⟨opAvg_norm_le_one hP Q fun p => IsStarProjection.norm_le _ (hQ p), ?_⟩
  rw [id_sub_opAvg hP]
  exact opAvg_norm_le_one hP _ fun p => IsStarProjection.norm_le _ (hQ p).one_sub

omit [CompleteSpace E] in
/-- The target residual of an averaged history, against an averaged target, is the average over all
individual pad choices of the residuals of the single-choice histories (blueprint lines 1810-1811:
histories include every individual pad choice). -/
theorem avg_residual_eq {P : ℕ} (hP : 0 < P) (Q : ℕ → Fin P → E →L[ℂ] E) (θ : ℕ → Bool)
    (m : ℕ) (T : Fin P → E →L[ℂ] E) (z : E) :
    operatorComplementProduct (fun l => opAvg (Q l)) θ m z -
        opAvg T (operatorComplementProduct (fun l => opAvg (Q l)) θ m z) =
      (((Finset.univ : Finset (Fin P × (Fin m → Fin P))).card : ℂ))⁻¹ •
        ∑ pc : Fin P × (Fin m → Fin P),
          (operatorComplementProduct (fun l => Q l (choiceExt hP pc.2 l)) θ m z -
            T pc.1 (operatorComplementProduct (fun l => Q l (choiceExt hP pc.2 l)) θ m z)) := by
  have hP' : (P : ℂ) ≠ 0 := by exact_mod_cast hP.ne'
  rw [complementProduct_opAvg hP Q θ m z]
  set S := ∑ c : Fin m → Fin P, operatorComplementProduct (fun l => Q l (choiceExt hP c l)) θ m z
    with hS
  have hcard : ((Finset.univ : Finset (Fin P × (Fin m → Fin P))).card : ℂ) =
      (P : ℂ) * (P : ℂ) ^ m := by
    rw [Finset.card_univ, Fintype.card_prod, Fintype.card_fun, Fintype.card_fin,
      Fintype.card_fin]
    push_cast; ring
  rw [hcard, Finset.sum_sub_distrib, smul_sub, Fintype.sum_prod_type, Fintype.sum_prod_type]
  have e1 : ∑ _p : Fin P, ∑ c : Fin m → Fin P,
      operatorComplementProduct (fun l => Q l (choiceExt hP c l)) θ m z = (P : ℂ) • S := by
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, ← Nat.cast_smul_eq_nsmul ℂ]
  have e2 : ∑ p : Fin P, ∑ c : Fin m → Fin P,
      T p (operatorComplementProduct (fun l => Q l (choiceExt hP c l)) θ m z) =
        ∑ p, T p S := Finset.sum_congr rfl fun p _ => by rw [hS, map_sum]
  have e3 : opAvg T (((P : ℂ) ^ m)⁻¹ • S) = ((P : ℂ) * (P : ℂ) ^ m)⁻¹ • ∑ p, T p S := by
    unfold opAvg
    rw [smul_apply, sum_apply]
    simp only [map_smul]
    rw [← Finset.smul_sum, smul_smul, mul_inv]
  rw [e1, e2, e3]
  congr 1
  rw [smul_smul]
  congr 1
  field_simp

end Filters

section ResidOK
variable {W : Type*} [Fintype W]

/-- A residual `R` in slot `t` passes at level `β` on the cell `I` (blueprint eq:catalog-test):
against every pure source whose tag lies in the mask, in another slot, and two arbitrary
normalized `L²` spectators, the local form is at most `β`. -/
abbrev ResidOK {Tg : Type*} (G : RealDyadicGrid) (I : ℤ × ℤ) (c₀ : ℕ) (H : ℝ)
    (tagOf : Tg → ChartTag) (wI : ℝ × ℝ → ℂ) (t : Fin 4) (M : Tg → Prop) (R : ColumnL2 W)
    (β : ℝ) : Prop :=
  ResidPass G I c₀ H tagOf wI t M R β

/-- The physical coordinate of an average of column vectors is the average of their physical
coordinates. -/
theorem phys_avg_ae {ι : Type*} (s : Finset ι) (R : ι → ColumnL2 W) :
    (fun y => ((((s.card : ℂ))⁻¹ • ∑ i ∈ s, R i : ColumnL2 W) : ℝ → ColumnHilbert W) y none)
      =ᵐ[volume]
      fun y => ∑ i ∈ s, ((s.card : ℂ))⁻¹ * (R i : ℝ → ColumnHilbert W) y none := by
  classical
  have hsum : ∀ t : Finset ι, (fun y => ((∑ i ∈ t, R i : ColumnL2 W) : ℝ → ColumnHilbert W) y none)
      =ᵐ[volume] fun y => ∑ i ∈ t, (R i : ℝ → ColumnHilbert W) y none := by
    intro t
    induction t using Finset.induction_on with
    | empty =>
      simp only [Finset.sum_empty]
      filter_upwards [Lp.coeFn_zero (ColumnHilbert W) 2 volume] with y hy
      rw [hy]; rfl
    | insert i t hi ih =>
      simp only [Finset.sum_insert hi]
      filter_upwards [Lp.coeFn_add (R i) (∑ j ∈ t, R j), ih] with y h1 h2
      rw [h1, Pi.add_apply, PiLp.add_apply, h2]
  filter_upwards [Lp.coeFn_smul (((s.card : ℂ))⁻¹) (∑ i ∈ s, R i), hsum s] with y h1 h2
  rw [h1, Pi.smul_apply, PiLp.smul_apply, h2, smul_eq_mul, Finset.mul_sum]

/-- Blueprint lines 1810-1811 ("histories include every individual pad choice, so the tests also
hold for averages"): an average of residuals passing at level `β` passes at level `β`. -/
theorem ResidOK.avg {κ : LocalKernelClass} {Tg : Type*} {G : RealDyadicGrid} {I : ℤ × ℤ}
    {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {wI : ℝ × ℝ → ℂ}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) wI)
    {t : Fin 4} {M : Tg → Prop} {ι : Type*} (s : Finset ι) (hs : s.Nonempty)
    (R : ι → ColumnL2 W) {β : ℝ} (h : ∀ i ∈ s, ResidOK G I c₀ H tagOf wI t M (R i) β) :
    ResidOK G I c₀ H tagOf wI t M (((s.card : ℂ))⁻¹ • ∑ i ∈ s, R i) β := by
  intro x hx u a b hut hua hub hta htb hab A hA hAθ hAM hAq z hzu hzt hza hzb hza2 hzb2
  have hr := dyadicGridLength_pos G I.1
  set μ := normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)
  have hprob := normalizedIntervalMeasure_probability (dyadicGridLeft G I.1 I.2) hr
  -- the slots are measurable with finite normalized norms
  have hcov : ∀ j : Fin 4, j = t ∨ j = u ∨ j = a ∨ j = b := fun j =>
    fin4_eq_of_distinct t u a b j (Ne.symm hut) hta htb hua hub hab
  have hphm : ∀ X : ColumnL2 W, Measurable fun y => (X : ℝ → ColumnHilbert W) y none :=
    fun X => columnPhys_measurable X
  have hphf : ∀ X : ColumnL2 W,
      eLpNorm (fun y => (X : ℝ → ColumnHilbert W) y none) 2 μ ≠ ⊤ :=
    fun X => (columnPhys_memLp_normalized X _ _).eLpNorm_ne_top
  have hum : Measurable (z u) := by rw [hzu]; exact quadraticChartAtom_measurable A
  have huf : eLpNorm (z u) 2 μ ≠ ⊤ := by
    rw [hzu]
    exact (memLp_top_of_bound (quadraticChartAtom_measurable A).aestronglyMeasurable _
      (Filter.Eventually.of_forall (quadraticChartAtom_norm_le hA))).mono_exponent le_top
      |>.eLpNorm_ne_top
  have hm : ∀ j, Measurable (z j) := fun j => by
    rcases hcov j with rfl | rfl | rfl | rfl
    · rw [hzt]; exact hphm _
    · exact hum
    · exact hza
    · exact hzb
  have hf : ∀ j, eLpNorm (z j) 2 μ ≠ ⊤ := fun j => by
    rcases hcov j with rfl | rfl | rfl | rfl
    · rw [hzt]; exact hphf _
    · exact huf
    · exact ne_top_of_le_ne_top ENNReal.one_ne_top hza2
    · exact ne_top_of_le_ne_top ENNReal.one_ne_top hzb2
  -- replace the residual slot by the average of the physical parts
  have hcongr : localProgressionForm (dyadicGridLength G I.1) wI z =
      localProgressionForm (dyadicGridLength G I.1) wI (Function.update z t
        (fun y => ∑ i ∈ s, ((s.card : ℂ))⁻¹ * (R i : ℝ → ColumnHilbert W) y none)) := by
    refine localProgressionForm_congr_ae _ _ fun j => ?_
    by_cases hj : j = t
    · subst hj
      rw [Function.update_self, hzt]
      exact phys_avg_ae s R
    · rw [Function.update_of_ne hj]
  rw [hcongr, localProgressionForm_update_sum hr hwI hm hf t s (fun _ => ((s.card : ℂ))⁻¹)
    (fun i => fun y => (R i : ℝ → ColumnHilbert W) y none) (fun i => hphm _) (fun i => hphf _)]
  have hc : (0 : ℝ) < s.card := by exact_mod_cast hs.card_pos
  have hbound : ∀ i ∈ s, ‖localProgressionForm (dyadicGridLength G I.1) wI
      (Function.update z t fun y => (R i : ℝ → ColumnHilbert W) y none)‖ ≤ β := fun i hi =>
    h i hi x hx hut hua hub hta htb hab A hA hAθ hAM hAq _
      (by rw [Function.update_of_ne hut]; exact hzu) (Function.update_self _ _ _)
      (by rw [Function.update_of_ne hta.symm]; exact hza)
      (by rw [Function.update_of_ne htb.symm]; exact hzb)
      (by rw [Function.update_of_ne hta.symm]; exact hza2)
      (by rw [Function.update_of_ne htb.symm]; exact hzb2)
  calc ‖∑ i ∈ s, ((s.card : ℂ))⁻¹ * localProgressionForm (dyadicGridLength G I.1) wI
        (Function.update z t fun y => (R i : ℝ → ColumnHilbert W) y none)‖
      ≤ ∑ i ∈ s, ‖((s.card : ℂ))⁻¹ * localProgressionForm (dyadicGridLength G I.1) wI
        (Function.update z t fun y => (R i : ℝ → ColumnHilbert W) y none)‖ := norm_sum_le _ _
    _ ≤ ∑ _i ∈ s, (s.card : ℝ)⁻¹ * β := Finset.sum_le_sum fun i hi => by
        rw [norm_mul, norm_inv, Complex.norm_natCast]
        exact mul_le_mul_of_nonneg_left (hbound i hi) (inv_nonneg.mpr (Nat.cast_nonneg _))
    _ = β := by rw [Finset.sum_const, nsmul_eq_mul, ← mul_assoc, mul_inv_cancel₀ hc.ne', one_mul]

end ResidOK

/-! ### Nesting of the main projections in the pad and in depth (blueprint line 1807) -/

namespace ActiveSetup.BasicFamilies
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} (bf : A.BasicFamilies)

theorem admAt_of_mem {I : ℤ × ℤ} (hI : I ∈ A.cells) :
    bf.admAt I = some ⟨I, A.cells_mem_tree hI⟩ := by
  unfold admAt; exact dite_eq_left_of_eq_true (eq_true hI)

/-- Nested cells of the setup have admission cells in ancestor relation. -/
theorem admAt_anc {I J : ℤ × ℤ} (hI : I ∈ A.cells) (hJ : J ∈ A.cells)
    (h : dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2) :
    bf.admT.Anc (bf.admAt J) (bf.admAt I) := by
  rw [bf.admAt_of_mem hI, bf.admAt_of_mem hJ]
  exact admTree_anc bf.occAvail h

/-- The admission cell of a label available above a cell is the same at the cell. -/
theorem admCellOf_desc {I J : AdmCell A.G A.R A.treeDepth} {x : bf.Lab}
    (hIJ : dyadicGridCell A.G I.1.1 I.1.2 ⊆ dyadicGridCell A.G J.1.1 J.1.2)
    (h : (admAnc (G := A.G) (R := A.R) (N := A.treeDepth) bf.occAvail J x).Nonempty) :
    admCellOf bf.occAvail I x = admCellOf bf.occAvail J x := by
  obtain ⟨hK, hKmin⟩ := admCellOf_spec bf.occAvail h
  set K := admCellOf bf.occAvail J x
  obtain ⟨hJK, hKav⟩ := (mem_admAnc bf.occAvail).mp hK
  refine admCellOf_eq bf.occAvail ((mem_admAnc bf.occAvail).mpr ⟨hIJ.trans hJK, hKav⟩) ?_
  intro J' hJ'
  obtain ⟨hIJ', hJ'av⟩ := (mem_admAnc bf.occAvail).mp hJ'
  by_cases hd : J'.1.1 ≤ J.1.1
  · have hx := dyadicGridCell_left_mem A.G I.1.1 I.1.2
    have hJJ' : dyadicGridCell A.G J.1.1 J.1.2 ⊆ dyadicGridCell A.G J'.1.1 J'.1.2 :=
      dyadicGridCell_subset_of_common_point A.G (hIJ hx) (hIJ' hx) hd
    exact hKmin J' ((mem_admAnc bf.occAvail).mpr ⟨hJJ', hJ'av⟩)
  · have := dyadicGridCell_depth_le_of_subset A.G J.1 K.1 hJK
    omega

/-- The vertex of an original column available at a cell is its vertex at every subcell of the
setup. -/
theorem vtxAt_desc {I J : ℤ × ℤ} (hI : I ∈ A.cells) (hJ : J ∈ A.cells)
    (h : dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2) {x : bf.Lab}
    (hx : bf.occAvail J x) : bf.vtxAt I x = bf.vtxAt J x := by
  classical
  simp only [vtxAt, hI, hJ, ↓reduceDIte]
  refine Prod.ext rfl (bf.admCellOf_desc h ?_)
  exact ⟨⟨J, A.cells_mem_tree hJ⟩, (mem_admAnc bf.occAvail).mpr ⟨subset_rfl, hx⟩⟩

/-- Availability of original columns is inherited by the subcells of the setup. -/
theorem occAvail_desc {I J : ℤ × ℤ} (hI : I ∈ A.cells)
    (h : dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2) {x : bf.Lab}
    (hx : bf.occAvail J x) : bf.occAvail I x := by
  refine ⟨hI, ?_⟩
  obtain ⟨hID, -, -⟩ := bf.charts x.1 x.2.1 I hI
  obtain ⟨hJD, -, -⟩ := bf.charts x.1 x.2.1 J hx.1
  refine (bf.P x.1 x.2.1).Ψ.A.inherited I hID J hJD ?_ hx.2
  rw [(bf.P x.1 x.2.1).grid]
  exact h

/-- An original column available at a cell of the setup is square integrable on the cell. -/
theorem origCol_memLp (l : Fin 4) {Mc : ℕ} (s : List (CatCol bf.Vtx)) {I : ℤ × ℤ}
    {v : bf.Lab} (hv : bf.occAvail I v) :
    MemLp ((dyadicGridCell A.G I.1 I.2).indicator (privateColumnValue
      (mainScalar Mc (bf.origCols l) s) (mainWeight Mc (bf.origCols l)) (Sum.inl v))) 2
      volume := by
  obtain ⟨-, -, hch⟩ := bf.charts v.1 v.2.1 I hv.1
  obtain ⟨d, Φ, h1, -, h3⟩ := hch v.2.2 hv.2
  refine wColumn_memLp (dyadicGridCell_measurable A.G I.1 I.2)
    (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_lt_top) _
    ((bf.P v.1 v.2.1).Ψ.D.scalar_measurable v.2.2) (C := (2 * A.H + 3) ^ d * A.H ^ c₀)
    fun y hy => ?_
  change ‖(bf.P v.1 v.2.1).Ψ.D.scalar v.2.2 y‖ ≤ _
  rw [h3 y hy]
  exact quadraticChartAtom_norm_le h1 y

end ActiveSetup.BasicFamilies

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

open Classical in
/-- Cumulative masks grow in depth (blueprint line 1807). -/
theorem cmask_mono {I J : ℤ × ℤ} (hI : I ∈ A.cells) (hJ : J ∈ A.cells)
    (h : dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2) (m p : ℕ) (x : bf.Vtx)
    (hx : fp.cmask J m p x) : fp.cmask I m p x :=
  ColorSetup.cumMask_anc bf.admT_X_card_le (bf.admAt_anc hI hJ h) hx

open Classical in
/-- Ball masks grow in depth (blueprint line 1807). -/
theorem bmask_mono {I J : ℤ × ℤ} (hI : I ∈ A.cells) (hJ : J ∈ A.cells)
    (h : dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2)
    (G : ℕ × (Option (Fin A.fcd0 × bf.Vtx × ℤ) × ℕ × (ℕ × ℕ) ×
      Option (Fin A.fcd0 × bf.Vtx × ℤ))) (j p : ℕ) (x : bf.Vtx)
    (hx : fp.bmask J G j p x) : fp.bmask I G j p x :=
  ColorSetup.mask_anc (bf.admAt_anc hI hJ h) hx

open Classical in
/-- Cumulative masks grow with the pad (blueprint line 1807). -/
theorem cmask_pad_mono (I : ℤ × ℤ) (m : ℕ) {p p' : ℕ} (hp : p ≤ p') (x : bf.Vtx)
    (hx : fp.cmask I m p x) : fp.cmask I m p' x := by
  obtain ⟨hx1, w, hw, hc, hd⟩ := hx
  refine ⟨hx1, w, hw, hc, hd.trans ?_⟩
  exact_mod_cast (show fp.cbase m + p ≤ fp.cbase m + p' by omega)

open Classical in
/-- Ball masks grow with the pad (blueprint line 1807). -/
theorem bmask_pad_mono (I : ℤ × ℤ)
    (G : ℕ × (Option (Fin A.fcd0 × bf.Vtx × ℤ) × ℕ × (ℕ × ℕ) ×
      Option (Fin A.fcd0 × bf.Vtx × ℤ))) (j : ℕ) {p p' : ℕ} (hp : p ≤ p') (x : bf.Vtx)
    (hx : fp.bmask I G j p x) : fp.bmask I G j p' x :=
  ColorSetup.mask_pad_mono _ _ _ (show fp.bbase j + p ≤ fp.bbase j + p' by omega) hx

/-- The positive smeared cumulative filter of the slot `l` at the split `m` on the cell `I`: the
average over the pads `10 P (L - m + 1) + p`, `1 ≤ p ≤ P`, of the rank-`(L - m + 1)` main
projections with the cumulative masks (blueprint line 1807). -/
noncomputable def cumFilt (l : Fin 4) (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ) (m : ℕ) :
    ColumnL2 (bf.Lab ⊕ Fin fp.Mc) →L[ℂ] ColumnL2 (bf.Lab ⊕ Fin fp.Mc) :=
  opAvg fun p : Fin fp.P =>
    mainProj A.G fp.Mc (bf.origCols l) s I (fp.crank m) (fp.cmask I m (p + 1))

/-- The positive smeared ball filter of the slot `l` for the group `G` at the ball level `j` on
the cell `I` (blueprint line 1807). -/
noncomputable def ballFilt (l : Fin 4) (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ)
    (G : ℕ × (Option (Fin A.fcd0 × bf.Vtx × ℤ) × ℕ × (ℕ × ℕ) ×
      Option (Fin A.fcd0 × bf.Vtx × ℤ))) (j : ℕ) :
    ColumnL2 (bf.Lab ⊕ Fin fp.Mc) →L[ℂ] ColumnL2 (bf.Lab ⊕ Fin fp.Mc) :=
  opAvg fun p : Fin fp.P =>
    mainProj A.G fp.Mc (bf.origCols l) s I (fp.brank j) (fp.bmask I G j (p + 1))

/-- The smeared filters and their complements are contractions (blueprint line 1807). -/
theorem cumFilt_contraction (l : Fin 4) (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ) (m : ℕ) :
    ‖fp.cumFilt l s I m‖ ≤ 1 ∧ ‖ContinuousLinearMap.id ℂ _ - fp.cumFilt l s I m‖ ≤ 1 :=
  opAvg_starProjection_contraction fp.hP _ fun _ => mainProj_isStarProjection _ _ _ _ _ _ _

theorem ballFilt_contraction (l : Fin 4) (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ)
    (G : ℕ × (Option (Fin A.fcd0 × bf.Vtx × ℤ) × ℕ × (ℕ × ℕ) ×
      Option (Fin A.fcd0 × bf.Vtx × ℤ))) (j : ℕ) :
    ‖fp.ballFilt l s I G j‖ ≤ 1 ∧ ‖ContinuousLinearMap.id ℂ _ - fp.ballFilt l s I G j‖ ≤ 1 :=
  opAvg_starProjection_contraction fp.hP _ fun _ => mainProj_isStarProjection _ _ _ _ _ _ _

end ActiveSetup.BasicFamilies.FamParams

/-! ### The catalog tests on averaged histories (blueprint lines 1809-1815) -/

/-- A main catalog test passes exactly when its target residual passes at the level
`τ ‖base‖_{2,I}` (blueprint eq:catalog-test). -/
theorem MainTest.pass_iff {V : Type} [Fintype V] {Tg : Type*} {Mc : ℕ} (w : MainTest Tg V Mc)
    (G : RealDyadicGrid) (O : OrigCols V Tg) (I : ℤ × ℤ) (c₀ : ℕ) (H : ℝ)
    (tagOf : Tg → ChartTag) (wI : ℝ × ℝ → ℂ) (τ : ℝ) (mH : ℕ) (s : List (CatCol Tg)) :
    w.Pass G O I c₀ H tagOf wI τ mH s ↔
      ResidOK G I c₀ H tagOf wI w.t w.M (w.resid G Mc O I mH s) (τ * cellNorm G I w.base) :=
  Iff.rfl

/-- Blueprint lines 1810-1811 ("histories include every individual pad choice, so the tests also
hold for averages"): if the residuals of the histories of all individual pad choices pass at a
level, the residual of the averaged history against the averaged target passes at that level. -/
theorem avg_history_pass {W : Type*} [Fintype W] {κ : LocalKernelClass} {Tg : Type*}
    {G : RealDyadicGrid} {I : ℤ × ℤ} {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag}
    {wI : ℝ × ℝ → ℂ}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) wI)
    {t : Fin 4} {M : Tg → Prop} {P : ℕ} (hP : 0 < P) (Q : ℕ → Fin P → ColumnL2 W →L[ℂ] ColumnL2 W)
    (θ : ℕ → Bool) (m : ℕ) (T : Fin P → ColumnL2 W →L[ℂ] ColumnL2 W) (z : ColumnL2 W) {β : ℝ}
    (h : ∀ pc : Fin P × (Fin m → Fin P), ResidOK G I c₀ H tagOf wI t M
      (operatorComplementProduct (fun l => Q l (choiceExt hP pc.2 l)) θ m z -
        T pc.1 (operatorComplementProduct (fun l => Q l (choiceExt hP pc.2 l)) θ m z)) β) :
    ResidOK G I c₀ H tagOf wI t M
      (operatorComplementProduct (fun l => opAvg (Q l)) θ m z -
        opAvg T (operatorComplementProduct (fun l => opAvg (Q l)) θ m z)) β := by
  have : Nonempty (Fin P × (Fin m → Fin P)) := ⟨(⟨0, hP⟩, fun _ => ⟨0, hP⟩)⟩
  rw [avg_residual_eq hP Q θ m T z]
  exact ResidOK.avg hwI Finset.univ Finset.univ_nonempty _ fun pc _ => h pc

/-! ### Catalog closure on the main columns (blueprint lem:closure, lines 1819-1828) -/

section MainAppend
variable {V : Type} [Fintype V] {Tg : Type*} {G : RealDyadicGrid} {Mc : ℕ} {O : OrigCols V Tg}

theorem catAtom_append_left (s t : List (CatCol Tg)) {n : ℕ} (hn : n < s.length) :
    catAtom (s ++ t) n = catAtom s n := by
  unfold catAtom
  have hn' : n < (s ++ t).length := by simp; omega
  simp only [hn, hn', ↓reduceDIte, List.getElem_append_left hn]

theorem mainCol_append_left (s t : List (CatCol Tg)) (I : ℤ × ℤ) (x : V ⊕ Fin Mc)
    (hx : ∀ n : Fin Mc, x = Sum.inr n → (n : ℕ) < s.length) :
    mainCol G Mc O (s ++ t) I x = mainCol G Mc O s I x := by
  unfold mainCol
  refine wColumn_congr ?_ rfl
  rcases x with v | n
  · rfl
  · exact catAtom_append_left s t (hx n rfl)

theorem mainSel_mono_append (s t : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) :
    mainSel G Mc O s I r M ⊆ mainSel G Mc O (s ++ t) I r M := by
  rintro x (⟨v, h1, h2, rfl⟩ | ⟨n, hn, h1, h2, h3, rfl⟩)
  · exact Or.inl ⟨v, h1, h2, mainCol_append_left s t I _ fun n h => absurd h (by simp)⟩
  · have hn' : (n : ℕ) < (s ++ t).length := by simp; omega
    have e : (s ++ t)[(n : ℕ)]'hn' = s[(n : ℕ)]'hn := List.getElem_append_left hn
    refine Or.inr ⟨n, hn', ?_⟩
    rw [e]
    exact ⟨h1, h2, h3, mainCol_append_left s t I _ fun m h => by rw [← Sum.inr.inj h]; exact hn⟩

/-- Templates born at cells not containing `I` do not change the main projections at `I`. -/
theorem mainSel_append_irrel (s t : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop)
    (ht : ∀ d ∈ t, ¬ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2) :
    mainSel G Mc O (s ++ t) I r M = mainSel G Mc O s I r M := by
  ext x
  constructor
  · rintro (⟨v, h1, h2, rfl⟩ | ⟨n, hn, h1, h2, h3, rfl⟩)
    · exact Or.inl ⟨v, h1, h2, (mainCol_append_left s t I _ fun n h => absurd h (by simp)).symm⟩
    · by_cases hns : (n : ℕ) < s.length
      · have e : (s ++ t)[(n : ℕ)]'hn = s[(n : ℕ)]'hns := List.getElem_append_left hns
        rw [e] at h1 h2 h3
        exact Or.inr ⟨n, hns, h1, h2, h3,
          (mainCol_append_left s t I _ fun m h => by rw [← Sum.inr.inj h]; exact hns).symm⟩
      · exfalso
        have hmem : (s ++ t)[(n : ℕ)]'hn ∈ t := by
          rw [List.getElem_append_right (by omega)]
          exact List.getElem_mem _
        exact ht _ hmem h1
  · intro hx
    exact mainSel_mono_append s t I r M hx

theorem mainProj_append_irrel (s t : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop)
    (ht : ∀ d ∈ t, ¬ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2) :
    mainProj G Mc O (s ++ t) I r M = mainProj G Mc O s I r M := by
  have h : mainRange G Mc O (s ++ t) I r M = mainRange G Mc O s I r M := by
    unfold mainRange; rw [mainSel_append_irrel s t I r M ht]
  unfold mainProj
  ext x : 1
  exact starProjection_congr h x

theorem MainTest.resid_append_irrel (w : MainTest Tg V Mc) (I : ℤ × ℤ) (mH : ℕ)
    (s t : List (CatCol Tg))
    (ht : ∀ d ∈ t, ¬ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2) :
    w.resid G Mc O I mH (s ++ t) = w.resid G Mc O I mH s := by
  have hQ : (fun l => w.Q G Mc O I (s ++ t) l) = fun l => w.Q G Mc O I s l := by
    funext l; unfold MainTest.Q; split_ifs
    · exact mainProj_append_irrel s t I _ _ ht
    · rfl
  unfold MainTest.resid MainTest.hist
  rw [hQ, mainProj_append_irrel s t I _ _ ht]

theorem MainTest.pass_append_irrel (w : MainTest Tg V Mc) (I : ℤ × ℤ) (c₀ : ℕ) (H : ℝ)
    (tagOf : Tg → ChartTag) (wI : ℝ × ℝ → ℂ) (τ : ℝ) (mH : ℕ) (s t : List (CatCol Tg))
    (ht : ∀ d ∈ t, ¬ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2) :
    w.Pass G O I c₀ H tagOf wI τ mH (s ++ t) ↔ w.Pass G O I c₀ H tagOf wI τ mH s := by
  unfold MainTest.Pass
  rw [w.resid_append_irrel I mH s t ht]

end MainAppend

namespace MainTest
variable {V : Type} [Fintype V] {Tg : Type*} {G : RealDyadicGrid} {Mc : ℕ} {O : OrigCols V Tg}
  {I : ℤ × ℤ} (w : MainTest Tg V Mc)

/-- A failed main test is repaired by inserting a same-tag template at the cell (blueprint lines
1823-1825): the target projection grows on the old history value by more than `τ / (2 H₀)` times
the norm of the base on the cell. -/
theorem gain {κ : LocalKernelClass} {c₀ D : ℕ} (hst : SameTagBound κ c₀ D) {H : ℝ}
    (hH : Real.exp 2 ≤ H) {tagOf : Tg → ChartTag} (hdim : ∀ x, 1 ≤ (tagOf x).dim)
    {wI : ℝ × ℝ → ℂ}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) wI)
    {τ : ℝ} {mH : ℕ} {s : List (CatCol Tg)} (hlen : s.length < Mc)
    (hb : MainFresh Mc s.length w.base) (hfail : ¬ w.Pass G O I c₀ H tagOf wI τ mH s) :
    ∃ d : CatCol Tg, d.rank = w.r ∧ d.birth = I ∧ w.M d.tag ∧
      (∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
        d = templateCol (tagOf d.tag) w.t R γ I w.r d.tag) ∧
      τ / (2 * Real.exp (D * (1 + Real.log H) ^ D)) *
          (Real.sqrt (dyadicGridLength G I.1) * cellNorm G I w.base) <
        ‖(mainProj G Mc O (s ++ [d]) I w.r w.M - mainProj G Mc O s I w.r w.M)
          (w.hist G Mc O I mH s)‖ := by
  set H₀ := Real.exp (D * (1 + Real.log H) ^ D) with hH₀
  set r := dyadicGridLength G I.1 with hr_def
  have hr : 0 < r := dyadicGridLength_pos G I.1
  unfold Pass at hfail
  push Not at hfail
  obtain ⟨x, hx, u, a, b, hut, hua, hub, hta, htb, hab, A, hA, hAθ, hAM, hAq, z, hzu, hzt, hza,
    hzb, hza2, hzb2, hlt⟩ := hfail
  have hztm : Measurable (z w.t) := by rw [hzt]; exact columnPhys_measurable _
  have hzt2 : MemLp (z w.t) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2) r) := by
    rw [hzt]; exact columnPhys_memLp_normalized _ _ _
  obtain ⟨R, hR, γ, hbd⟩ := hst H hH (tagOf x) (hdim x) hut hua hub hta htb hab A hA hAθ hAM hAq
    hr hwI z hzu hztm hza hzb hzt2 hza2 hzb2
  set! d : CatCol Tg := templateCol (tagOf x) w.t R γ I w.r x with hd
  refine ⟨d, rfl, rfl, hx, ⟨R, hR, γ, rfl⟩, ?_⟩
  have hgain := mainProj_gain (G := G) (O := O) s d I w.r w.M hlen subset_rfl le_rfl hx
    (w.hist G Mc O I mH s) (hist_fresh mH s hb)
  have hmom : ∫ y, z w.t y * (starRingEnd ℂ) (quadraticChartAtom
      (tagTemplateData (tagOf x).θ (tagOf x).C (tagOf x).lam w.t R) y *
        (Real.fourierChar (γ * y) : ℂ)) ∂(normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2) r) =
      (r : ℂ)⁻¹ * ∫ y in dyadicGridCell G I.1 I.2, conj (d.atom y) *
        ((w.hist G Mc O I mH s - mainProj G Mc O s I w.r w.M (w.hist G Mc O I mH s) :
          ColumnL2 (V ⊕ Fin Mc)) : ℝ → ColumnHilbert (V ⊕ Fin Mc)) y none := by
    rw [integral_normalized_cell G I]
    congr 1
    refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
    simp only [hzt]
    rw [mul_comm]
    rfl
  have hn : ‖((r : ℂ)⁻¹)‖ = r⁻¹ := by
    rw [norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr]
  rw [hmom, norm_mul, hn] at hbd
  have hsq : 0 < Real.sqrt r := Real.sqrt_pos.mpr hr
  have hH₀p : 0 < H₀ := Real.exp_pos _
  set q := ‖(mainProj G Mc O (s ++ [d]) I w.r w.M - mainProj G Mc O s I w.r w.M)
    (w.hist G Mc O I mH s)‖ with hq
  have h1 : ‖localProgressionForm r wI z‖ ≤ H₀ * (r⁻¹ * (2 * Real.sqrt r * q)) :=
    hbd.trans (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hgain
      (inv_nonneg.mpr hr.le)) hH₀p.le)
  have e : r⁻¹ * (2 * Real.sqrt r * q) = 2 * q / Real.sqrt r := by
    rw [show r⁻¹ = (Real.sqrt r * Real.sqrt r)⁻¹ by rw [Real.mul_self_sqrt hr.le]]
    field_simp
  rw [e] at h1
  have h2 : τ * cellNorm G I w.base < H₀ * (2 * q / Real.sqrt r) := hlt.trans_le h1
  rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
  have h3 : τ * cellNorm G I w.base * Real.sqrt r < H₀ * (2 * q / Real.sqrt r) * Real.sqrt r :=
    mul_lt_mul_of_pos_right h2 hsq
  have e2 : H₀ * (2 * q / Real.sqrt r) * Real.sqrt r = 2 * H₀ * q := by field_simp
  rw [e2] at h3
  nlinarith only [h3]

end MainTest

/-- Blueprint lem:closure at one active cell (lines 1819-1828) on the main columns: for finitely
many named main tests at the cell whose bases are supported on the cell and have no coordinates
on template labels beyond a fixed prefix catalog `s₀`, inserting same-tag templates born at the
cell after `s₀` closes the catalog: every test
passes, fewer than `T_max` columns are inserted, and the insertions of each rank number at most
`|W| 4^m L^{2m} (2H₀/τ_r)²`, provided this allowance summed over the ranks stays below `T_max`.
The fresh template coordinates of the inserted columns are absent from the old state. -/
theorem main_cell_closure {κ : LocalKernelClass} {c₀ D : ℕ} (hst : SameTagBound κ c₀ D)
    {V : Type} [Fintype V] {G : RealDyadicGrid} {Tg : Type*} {Mc : ℕ} {O : OrigCols V Tg}
    {H : ℝ} (hH : Real.exp 2 ≤ H) {tagOf : Tg → ChartTag} (hdim : ∀ x, 1 ≤ (tagOf x).dim)
    {I : ℤ × ℤ} {wI : ℝ × ℝ → ℂ}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) wI)
    {W : Type*} [Fintype W] (tests : W → MainTest Tg V Mc) (mH : ℕ) (τ : ℕ → ℝ)
    (hτ : ∀ w, 0 < τ (tests w).r)
    (s₀ : List (CatCol Tg))
    (hbase : ∀ w, MainFresh Mc s₀.length (tests w).base ∧
      ‖(tests w).base‖ ≤ Real.sqrt (dyadicGridLength G I.1) * cellNorm G I (tests w).base)
    {Tmax : ℕ} (hMc : s₀.length + Tmax ≤ Mc)
    (hcap : ∑ r ∈ Finset.univ.image (fun w => (tests w).r),
      Fintype.card W * (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) /
        (τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ^ 2 < (Tmax : ℝ)) :
    ∃ s : List (CatCol Tg), (∀ d ∈ s, d.birth = I ∧ ∃ w, d.rank = (tests w).r ∧
        (tests w).M d.tag ∧ ∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
          d = templateCol (tagOf d.tag) (tests w).t R γ I (tests w).r d.tag) ∧ s.length < Tmax ∧
      (∀ w, (tests w).Pass G O I c₀ H tagOf wI (τ (tests w).r) mH (s₀ ++ s)) ∧
      ∀ r, (((Finset.range s.length).filter
        (fun j => ∃ hj : j < s.length, s[j].rank = r)).card : ℝ) *
          (τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ^ 2 ≤
        Fintype.card W * (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) ∨
        (τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ≤ 0 := by
  classical
  set H₀ := Real.exp (D * (1 + Real.log H) ^ D) with hH₀
  have hH₀p : 0 < H₀ := Real.exp_pos _
  let Dt := {d : CatCol Tg // d.birth = I ∧ ∃ w, d.rank = (tests w).r ∧ (tests w).M d.tag ∧
    ∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (tagOf d.tag) (tests w).t R γ I (tests w).r d.tag}
  let cat : List Dt → List (CatCol Tg) := fun s => s₀ ++ s.map Subtype.val
  have hcat : ∀ (s : List Dt) (d : Dt), cat (s ++ [d]) = cat s ++ [d.1] := by
    intro s d; simp only [cat, List.map_append, List.map_cons, List.map_nil, List.append_assoc]
  set Rset := Finset.univ.image (fun w => (tests w).r)
  set! δ : ℕ → ℝ := fun r => τ r / (2 * H₀)
  set! P : W → List Dt → ColumnL2 (V ⊕ Fin Mc) →L[ℂ] ColumnL2 (V ⊕ Fin Mc) :=
    fun w s => mainProj G Mc O (cat s) I (tests w).r (tests w).M
  set! Q : W → ℕ → List Dt → ColumnL2 (V ⊕ Fin Mc) →L[ℂ] ColumnL2 (V ⊕ Fin Mc) :=
    fun w l s => (tests w).Q G Mc O I (cat s) l
  have hP : ∀ w s, IsStarProjection (P w s) := fun w s => mainProj_isStarProjection _ _ _ _ _ _ _
  have hP1 : ∀ w s d, (P w s).comp (P w (s ++ [d])) = P w s := fun w s d => by
    simp only [P, hcat]; exact mainProj_nest _ _ _ _ _ _ _ _
  have hQ : ∀ w l s, IsStarProjection (Q w l s) := fun w l s =>
    MainTest.Q_isStarProjection _ _ _ _ _ _ _
  have hQ1 : ∀ w l s d, (Q w l s).comp (Q w l (s ++ [d])) = Q w l s := fun w l s d => by
    simp only [Q, hcat]; exact MainTest.Q_nest _ _ _ _ _ _ _ _
  have hrk : ∀ d : Dt, d.1.rank ∈ Rset := fun d => by
    obtain ⟨w, hw, -⟩ := d.2.2
    exact Finset.mem_image.mpr ⟨w, Finset.mem_univ _, hw.symm⟩
  have hδ : ∀ r ∈ Rset, 0 < δ r := fun r hr => by
    obtain ⟨w, -, rfl⟩ := Finset.mem_image.mp hr
    exact div_pos (hτ w) (by positivity)
  have hbd : ∀ s : List Dt, LocalValid (fun d : Dt => d.1.rank) (fun w => (tests w).r) δ P Q
      (fun w => (tests w).θ) mH (fun w => (tests w).base) s → s.length < Tmax := fun s h =>
    h.length_lt hP hP1 hQ hQ1 Rset hrk hδ hcap
  obtain ⟨s, hs, hpass, hlen⟩ := local_closure (rk := fun d : Dt => d.1.rank)
    (rkW := fun w => (tests w).r) (δ := δ) (P := P) (Q := Q) (θ := fun w => (tests w).θ)
    (m := mH) (g := fun w => (tests w).base) hP hP1 hQ hQ1 Rset hrk hδ hcap
    (fun w s => (tests w).Pass G O I c₀ H tagOf wI (τ (tests w).r) mH (cat s)) (by
      intro s hs w hw
      have hlen : (cat s).length < Mc := by
        have := hbd s hs
        simp only [cat, List.length_append, List.length_map]
        omega
      obtain ⟨d, hdr, hdb, hdM, hdt, hg⟩ := (tests w).gain hst hH hdim hwI hlen
        ((hbase w).1.mono (by simp only [cat, List.length_append]; omega)) hw
      refine ⟨⟨d, hdb, w, hdr, hdM, hdt⟩, hdr.symm, ?_⟩
      simp only [P, Q, hcat]
      refine lt_of_le_of_lt ?_ hg
      exact mul_le_mul_of_nonneg_left (hbase w).2 (hδ _ (Finset.mem_image_of_mem _
        (Finset.mem_univ w))).le)
  refine ⟨s.map Subtype.val, fun d hd => ?_, by simpa using hlen, hpass, fun r => ?_⟩
  · obtain ⟨d', -, rfl⟩ := List.mem_map.mp hd
    exact d'.2
  · by_cases hr : δ r ≤ 0
    · exact Or.inr hr
    · left
      have hc := hs.rank_count hP hP1 hQ hQ1 r (lt_of_not_ge hr)
      have hL : projectionPrefixConstant s.length ≤ projectionPrefixConstant Tmax :=
        projectionPrefixConstant_mono hlen.le
      have hL0 : 0 ≤ projectionPrefixConstant s.length :=
        le_trans zero_le_one (projectionPrefixConstant_one_le _)
      refine le_trans (le_of_eq ?_) (hc.trans (mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hL0 hL _) (by positivity))
        (Nat.cast_nonneg _)))
      simp only [List.length_map, List.getElem_map]
      rfl

/-- A vector supported on a cell has norm `√|I|` times its normalized norm on the cell. -/
theorem norm_eq_cellNorm_of_support {W : Type*} [Fintype W] (G : RealDyadicGrid) (I : ℤ × ℤ)
    (x : ColumnL2 W) (hx : ∀ᵐ y ∂volume, y ∉ dyadicGridCell G I.1 I.2 →
      (x : ℝ → ColumnHilbert W) y = 0) :
    ‖x‖ = Real.sqrt (dyadicGridLength G I.1) * cellNorm G I x := by
  have hr := dyadicGridLength_pos G I.1
  have h1 : ∫ y in dyadicGridCell G I.1 I.2, ‖(x : ℝ → ColumnHilbert W) y‖ ^ 2 = ‖x‖ ^ 2 := by
    rw [columnInput_norm_sq_integral]
    refine setIntegral_eq_integral_of_ae_compl_eq_zero ?_
    filter_upwards [hx] with y hy hys
    rw [hy hys, norm_zero, zero_pow two_ne_zero]
  unfold cellNorm
  rw [h1, ← Real.sqrt_mul hr.le, ← mul_assoc, mul_inv_cancel₀ hr.ne', one_mul,
    Real.sqrt_sq (norm_nonneg _)]

/-- The cells of a finite set can be listed without repetition with coarser cells first: no
cell is contained in a later one. -/
theorem exists_coarse_first (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) :
    ∃ L : List (ℤ × ℤ), L.Nodup ∧ (∀ I, I ∈ L ↔ I ∈ S) ∧
      ∀ i j (hi : i < L.length) (hj : j < L.length), i < j →
        ¬ dyadicGridCell G L[i].1 L[i].2 ⊆ dyadicGridCell G L[j].1 L[j].2 := by
  classical
  set L := S.toList.mergeSort (fun a b : ℤ × ℤ => decide (a.1 ≤ b.1)) with hL
  have hperm : L.Perm S.toList := List.mergeSort_perm _ _
  have hnd : L.Nodup := hperm.nodup_iff.mpr (Finset.nodup_toList S)
  refine ⟨L, hnd, fun I => by rw [hperm.mem_iff, Finset.mem_toList], ?_⟩
  intro i j hi hj hij hsub
  have hs : L.Pairwise (fun a b : ℤ × ℤ => decide (a.1 ≤ b.1) = true) :=
    List.pairwise_mergeSort (fun a b c hab hbc => by simp only [decide_eq_true_eq] at *; omega)
      (fun a b => by simp only [Bool.or_eq_true, decide_eq_true_eq]; exact le_total _ _) _
  have h1 := List.pairwise_iff_getElem.mp hs i j hi hj hij
  simp only [decide_eq_true_eq] at h1
  have h2 := dyadicGridCell_depth_le_of_subset G _ _ hsub
  have hx := dyadicGridCell_left_mem G L[i].1 L[i].2
  have he := dyadicGridCell_eq_of_common_point G hx (hsub hx) (by omega)
  exact absurd ((List.Nodup.getElem_inj_iff hnd).mp he) (by omega)

/-- Blueprint lem:closure over a finite tree on the main columns (lines 1819-1828): processing
the cells with ancestors first and closing the catalog at each cell (`main_cell_closure`) after a
fixed prefix `s₀` gives one extension passing all tests at all cells; its columns born at a cell
are that cell's own insertions, with the rank counts of `main_cell_closure`. -/
theorem main_tree_closure {κ : LocalKernelClass} {c₀ D : ℕ} (hst : SameTagBound κ c₀ D)
    {V : Type} [Fintype V] {G : RealDyadicGrid} {Tg : Type*} {Mc : ℕ} {O : OrigCols V Tg}
    {H : ℝ} (hH : Real.exp 2 ≤ H) {tagOf : Tg → ChartTag}
    (hdim : ∀ x, 1 ≤ (tagOf x).dim) (L : List (ℤ × ℤ)) (hnd : L.Nodup)
    (hord : ∀ i j (hi : i < L.length) (hj : j < L.length), i < j →
      ¬ dyadicGridCell G L[i].1 L[i].2 ⊆ dyadicGridCell G L[j].1 L[j].2)
    (wI : ℤ × ℤ → ℝ × ℝ → ℂ)
    (hwI : ∀ I ∈ L, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)
      (wI I))
    (W : ℤ × ℤ → Type*) [∀ I, Fintype (W I)] (tests : ∀ I, W I → MainTest Tg V Mc) (mH : ℕ)
    (τ : ℕ → ℝ) (hτ : ∀ I w, 0 < τ (tests I w).r) (s₀ : List (CatCol Tg))
    (hbase : ∀ I ∈ L, ∀ w, MainFresh Mc s₀.length (tests I w).base ∧
      ‖(tests I w).base‖ ≤ Real.sqrt (dyadicGridLength G I.1) * cellNorm G I (tests I w).base)
    {Tmax : ℕ} (hMc : s₀.length + L.length * Tmax ≤ Mc)
    (hcap : ∀ I ∈ L, ∑ r ∈ Finset.univ.image (fun w => (tests I w).r),
      Fintype.card (W I) * (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) /
        (τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ^ 2 < (Tmax : ℝ)) :
    ∃ cat : List (CatCol Tg),
      (∀ I ∈ L, ∀ w, (tests I w).Pass G O I c₀ H tagOf (wI I) (τ (tests I w).r) mH (s₀ ++ cat)) ∧
      (∀ d ∈ cat, d.birth ∈ L ∧ ∃ w, d.rank = (tests d.birth w).r ∧ (tests d.birth w).M d.tag ∧
        ∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
          d = templateCol (tagOf d.tag) (tests d.birth w).t R γ d.birth (tests d.birth w).r d.tag) ∧
      (∀ I ∈ L, ∀ r, ((cat.filter (fun d => decide (d.birth = I ∧ d.rank = r))).length : ℝ) *
          (τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ^ 2 ≤
        Fintype.card (W I) * (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) ∨
        τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D)) ≤ 0) ∧
      cat.length ≤ L.length * Tmax := by
  classical
  set! δ : ℕ → ℝ := fun r => τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))
  set! c : ℕ → ℤ × ℤ := fun i => L.getD i (0, 0) with hc
  have hcL : ∀ i (hi : i < L.length), c i = L[i] := fun i hi => by
    simp only [hc, List.getD_eq_getElem _ _ hi]
  -- the invariant after the first `n` cells
  have key : ∀ n, n ≤ L.length → ∃ cat : List (CatCol Tg),
      (∀ i < n, ∀ w, (tests (c i) w).Pass G O (c i) c₀ H tagOf (wI (c i))
        (τ (tests (c i) w).r) mH (s₀ ++ cat)) ∧
      (∀ d ∈ cat, ∃ i < n, d.birth = c i ∧
        ∃ w, d.rank = (tests d.birth w).r ∧ (tests d.birth w).M d.tag ∧
          ∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
            d = templateCol (tagOf d.tag) (tests d.birth w).t R γ d.birth (tests d.birth w).r
              d.tag) ∧
      (∀ i < n, ∀ r, ((cat.filter (fun d => decide (d.birth = c i ∧ d.rank = r))).length : ℝ) *
          δ r ^ 2 ≤ Fintype.card (W (c i)) *
            (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) ∨ δ r ≤ 0) ∧
      cat.length ≤ n * Tmax := by
    intro n
    induction n with
    | zero =>
      intro _
      exact ⟨[], fun i hi => absurd hi (Nat.not_lt_zero _), fun d hd => absurd hd (by simp),
        fun i hi => absurd hi (Nat.not_lt_zero _), by simp⟩
    | succ n ih =>
      intro hn
      obtain ⟨cat, hpass, hbirth, hcount, hlen⟩ := ih (by omega)
      set! I := c n with hI
      have hIL : I ∈ L := by rw [hI, hcL n (by omega)]; exact List.getElem_mem _
      obtain ⟨s, hs, hslen, hspass, hscount⟩ := main_cell_closure (O := O) hst hH hdim (hwI I hIL)
        (tests I) mH τ (hτ I) (s₀ ++ cat) (fun w => ⟨(hbase I hIL w).1.mono (by simp),
          (hbase I hIL w).2⟩) (Tmax := Tmax) (by
          have := Nat.mul_le_mul_right Tmax hn
          rw [Nat.succ_mul] at this
          simp only [List.length_append]
          omega) (hcap I hIL)
      have hinj : ∀ i j, i < L.length → j < L.length → c i = c j → i = j := by
        intro i j hi hj he
        rw [hcL i hi, hcL j hj] at he
        exact (List.Nodup.getElem_inj_iff hnd).mp he
      -- the earlier cells are not affected
      have hirr : ∀ i < n, ∀ d ∈ s,
          ¬ dyadicGridCell G (c i).1 (c i).2 ⊆ dyadicGridCell G d.birth.1 d.birth.2 := by
        intro i hi d hd
        rw [(hs d hd).1, hI, hcL i (by omega), hcL n (by omega)]
        exact hord i n (by omega) (by omega) hi
      -- the births of the old extension are earlier cells
      have hold : ∀ d ∈ cat, d.birth ≠ I := by
        intro d hd he
        obtain ⟨i, hi, hdi, -⟩ := hbirth d hd
        have := hinj i n (by omega) (by omega) (hdi.symm.trans he)
        omega
      refine ⟨cat ++ s, fun i hi w => ?_, fun d hd => ?_, fun i hi r => ?_, ?_⟩
      · rw [← List.append_assoc]
        by_cases hin : i < n
        · exact ((tests _ w).pass_append_irrel _ c₀ H tagOf _ _ mH (s₀ ++ cat) s
            (hirr i hin)).mpr (hpass i hin w)
        · have hi' : i = n := by omega
          subst hi'
          exact hspass w
      · rcases List.mem_append.mp hd with hd | hd
        · obtain ⟨i, hi, h1, h2⟩ := hbirth d hd
          exact ⟨i, by omega, h1, h2⟩
        · obtain ⟨h1, h2⟩ := hs d hd
          refine ⟨n, by omega, h1, ?_⟩
          rw [h1]; exact h2
      · rw [List.filter_append, List.length_append]
        by_cases hin : i < n
        · have h0 : (s.filter (fun d => decide (d.birth = c i ∧ d.rank = r))).length = 0 := by
            rw [List.length_eq_zero_iff, List.filter_eq_nil_iff]
            intro d hd
            simp only [decide_eq_true_eq, not_and]
            intro he
            rw [(hs d hd).1] at he
            have := hinj n i (by omega) (by omega) he
            omega
          rw [h0, Nat.add_zero]
          exact hcount i hin r
        · have hi' : i = n := by omega
          subst hi'
          have h0 : (cat.filter (fun d => decide (d.birth = I ∧ d.rank = r))).length = 0 := by
            rw [List.length_eq_zero_iff, List.filter_eq_nil_iff]
            intro d hd
            simp only [decide_eq_true_eq, not_and]
            intro he
            exact absurd he (hold d hd)
          rw [h0, Nat.zero_add]
          have hfs : s.filter (fun d => decide (d.birth = I ∧ d.rank = r)) =
              s.filter (fun d => decide (d.rank = r)) := by
            refine List.filter_congr fun d hd => ?_
            simp [(hs d hd).1]
          rw [hfs, ← card_range_filter_getElem s (fun d => d.rank = r)]
          exact hscount r
      · rw [List.length_append, Nat.succ_mul]
        omega
  obtain ⟨cat, hpass, hbirth, hcount, hlen⟩ := key L.length le_rfl
  refine ⟨cat, fun I hI => ?_, fun d hd => ?_, fun I hI r => ?_, hlen⟩
  · obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hI
    rw [← hcL i hi]
    exact hpass i hi
  · obtain ⟨i, hi, h1, h2⟩ := hbirth d hd
    exact ⟨by rw [h1, hcL i hi]; exact List.getElem_mem _, h2⟩
  · obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hI
    rw [← hcL i hi]
    exact hcount i hi r

/-! ### Path counts of the main labels (blueprint line 1820) -/

/-- The elements of a list satisfying `p` are counted by their keys in a finite set. -/
theorem length_filter_le_sum {α β : Type*} [DecidableEq β] (s : List α) (key : α → β)
    (T : Finset β) (p : α → Bool) (hT : ∀ d ∈ s, p d → key d ∈ T) :
    (s.filter p).length ≤ ∑ b ∈ T, (s.filter (fun d => decide (key d = b) && p d)).length := by
  induction s with
  | nil => simp
  | cons d s ih =>
    have ih' := ih fun x hx => hT x (List.mem_cons_of_mem d hx)
    rw [length_filter_cons]
    simp_rw [length_filter_cons]
    rw [Finset.sum_add_distrib]
    have e : (∑ b ∈ T, if (decide (key d = b) && p d) = true then 1 else 0) =
        if p d = true then 1 else 0 := by
      by_cases hp : p d = true
      · simp only [hp, Bool.and_true, decide_eq_true_eq, ↓reduceIte]
        rw [Finset.sum_ite_eq]
        simp [hT d List.mem_cons_self hp]
      · simp [hp]
    rw [e]
    omega

section MainLabels
variable {V : Type} [Fintype V] {Tg : Type*}

open scoped Classical in
/-- The main labels at the cell `I` of rank at most `r`: the original labels available at `I`
(rank zero) and the catalog templates born above `I` of rank at most `r`. Their number is the path
count `n_r` (blueprint line 1820). -/
noncomputable def mainLabels (G : RealDyadicGrid) (Mc : ℕ) (O : OrigCols V Tg)
    (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) : Finset (V ⊕ Fin Mc) :=
  Finset.univ.filter fun x => Sum.elim (fun v => O.avail I v) (fun n : Fin Mc =>
    ∃ hn : (n : ℕ) < s.length, dyadicGridCell G I.1 I.2 ⊆
      dyadicGridCell G (s[(n : ℕ)]).birth.1 (s[(n : ℕ)]).birth.2 ∧ (s[(n : ℕ)]).rank ≤ r) x

open scoped Classical in
/-- The main labels of rank at most `r` at `I` are the available originals and the templates,
counted by their birth cells and ranks. -/
theorem card_mainLabels_le (G : RealDyadicGrid) (Mc : ℕ) (O : OrigCols V Tg)
    (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (T : Finset ((ℤ × ℤ) × ℕ))
    (hT : ∀ d ∈ s, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2 →
      d.rank ≤ r → (d.birth, d.rank) ∈ T) :
    (mainLabels G Mc O s I r).card ≤ (Finset.univ.filter fun v => O.avail I v).card +
      ∑ b ∈ T, (s.filter (fun d => decide (d.birth = b.1 ∧ d.rank = b.2))).length := by
  set P : CatCol Tg → Prop := fun d =>
    dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2 ∧ d.rank ≤ r with hP
  have hsub : mainLabels G Mc O s I r ⊆
      (Finset.univ.filter fun v => O.avail I v).map Function.Embedding.inl ∪
      (Finset.univ.filter fun n : Fin Mc => ∃ hn : (n : ℕ) < s.length, P s[(n : ℕ)]).map
        Function.Embedding.inr := by
    intro x hx
    simp only [mainLabels, Finset.mem_filter, Finset.mem_univ, true_and] at hx
    rcases x with v | n
    · refine Finset.mem_union_left _ (Finset.mem_map.mpr ⟨v, ?_, rfl⟩)
      simpa using hx
    · refine Finset.mem_union_right _ (Finset.mem_map.mpr ⟨n, ?_, rfl⟩)
      simpa [P] using hx
  have h1 : (Finset.univ.filter fun n : Fin Mc => ∃ hn : (n : ℕ) < s.length, P s[(n : ℕ)]).card ≤
      (s.filter (fun d => decide (P d))).length := by
    rw [← card_range_filter_getElem s P]
    refine Finset.card_le_card_of_injOn (fun n => (n : ℕ)) (fun n hn => ?_)
      (fun a _ b _ h => Fin.ext h)
    simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_ofPred_eq] at hn
    obtain ⟨hn, hPn⟩ := hn
    simp only [Finset.coe_filter, Finset.mem_range, Set.mem_ofPred_eq]
    exact ⟨hn, hn, hPn⟩
  have h2 := length_filter_le_sum s (fun d => (d.birth, d.rank)) T (fun d => decide (P d))
    (fun d hd hPd => by
      simp only [decide_eq_true_eq] at hPd
      exact hT d hd hPd.1 hPd.2)
  have h3 : ∀ b ∈ T, (s.filter (fun d => decide ((d.birth, d.rank) = b) && decide (P d))).length ≤
      (s.filter (fun d => decide (d.birth = b.1 ∧ d.rank = b.2))).length := by
    intro b _
    rw [← List.countP_eq_length_filter, ← List.countP_eq_length_filter]
    refine List.countP_mono_left fun d _ h => ?_
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h ⊢
    rw [← h.1]
    exact ⟨rfl, rfl⟩
  calc (mainLabels G Mc O s I r).card
      ≤ ((Finset.univ.filter fun v => O.avail I v).map Function.Embedding.inl ∪
        (Finset.univ.filter fun n : Fin Mc => ∃ hn : (n : ℕ) < s.length, P s[(n : ℕ)]).map
          Function.Embedding.inr).card := Finset.card_le_card hsub
    _ ≤ _ := Finset.card_union_le _ _
    _ = (Finset.univ.filter fun v => O.avail I v).card +
        (Finset.univ.filter fun n : Fin Mc => ∃ hn : (n : ℕ) < s.length, P s[(n : ℕ)]).card := by
      rw [Finset.card_map, Finset.card_map]
    _ ≤ _ := by
      have := (h1.trans h2).trans (Finset.sum_le_sum h3)
      omega

end MainLabels

/-! ### The closure on the active cells of an attempt (blueprint lem:closure, lines 1819-1828) -/

/-- The catalog threshold of eq:catalog-test for the target rank `r`: `τ₃ / (D √n_{r-1})` with
the vertex bound `D` and the path counts `n` (blueprint lines 1809-1812). -/
noncomputable def catThreshold (Dv : ℕ) (τ₃ : ℝ) (n : ℕ → ℝ) (r : ℕ) : ℝ :=
  τ₃ / (Dv * Real.sqrt (n (r - 1)))

/-- The closure ratio `K_t Q (2 H₀ D / τ₃)²` (blueprint line 1828): the number of named tests at a
cell, the binary-prefix factor `Q = 4^m L_T^{2m}` of the trial cap `T` with history bound `m`,
the same-tag constant `H₀`, the vertex bound `D` and the threshold scale `τ₃`. -/
noncomputable def closureRatio (Dv Kt mH Tmax : ℕ) (H₀ τ₃ : ℝ) : ℝ :=
  Kt * (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) * (2 * H₀ * Dv / τ₃) ^ 2

theorem closureRatio_nonneg (Dv Kt mH Tmax : ℕ) (H₀ τ₃ : ℝ) :
    0 ≤ closureRatio Dv Kt mH Tmax H₀ τ₃ := by
  unfold closureRatio
  have := projectionPrefixConstant_one_le Tmax
  positivity

theorem catThreshold_pos {Dv : ℕ} (hDv : 0 < Dv) {τ₃ : ℝ} (hτ₃ : 0 < τ₃) {n : ℕ → ℝ} {r : ℕ}
    (hn : 0 < n (r - 1)) : 0 < catThreshold Dv τ₃ n r := by
  unfold catThreshold
  have : (0 : ℝ) < Dv := by exact_mod_cast hDv
  have := Real.sqrt_pos.mpr hn
  positivity

/-- The trial allowance of a rank at the threshold `catThreshold`. -/
theorem allowance_eq {Dv : ℕ} (hDv : 0 < Dv) {τ₃ : ℝ} (hτ₃ : 0 < τ₃) {n : ℕ → ℝ} {r : ℕ}
    (hn : 0 < n (r - 1)) (c Q : ℝ) {H₀ : ℝ} (hH₀ : 0 < H₀) :
    c * Q / (catThreshold Dv τ₃ n r / (2 * H₀)) ^ 2 =
      c * Q * (2 * H₀ * Dv / τ₃) ^ 2 * n (r - 1) := by
  unfold catThreshold
  have hs : 0 < Real.sqrt (n (r - 1)) := Real.sqrt_pos.mpr hn
  have hD : (0 : ℝ) < Dv := by exact_mod_cast hDv
  have hsq : Real.sqrt (n (r - 1)) ^ 2 = n (r - 1) := Real.sq_sqrt hn.le
  conv_rhs => rw [← hsq]
  field_simp

namespace ActiveSetup.BasicFamilies
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} (bf : A.BasicFamilies)

open scoped Classical in
/-- At most two column budgets of original columns of a slot are available at a cell. -/
theorem card_avail_le (l : Fin 4) (I : ℤ × ℤ) :
    ((Finset.univ.filter fun x : bf.Lab => (bf.origCols l).avail I x).card : ℝ) ≤
      2 * A.colBudget := by
  by_cases hI : I ∈ A.cells
  · have hsub : (Finset.univ.filter fun x : bf.Lab => (bf.origCols l).avail I x) ⊆
        ((Finset.univ : Finset (Fin 2)).sigma fun j => (bf.P l j).Ψ.A.labels I).image
          fun x => (⟨l, x⟩ : bf.Lab) := by
      rintro ⟨l', j, v⟩ hx
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx
      obtain ⟨rfl, -, hv⟩ := hx
      exact Finset.mem_image.mpr ⟨⟨j, v⟩, Finset.mem_sigma.mpr ⟨Finset.mem_univ _, hv⟩, rfl⟩
    refine (Nat.cast_le.mpr ((Finset.card_le_card hsub).trans Finset.card_image_le)).trans ?_
    rw [Finset.card_sigma, Fin.sum_univ_two]
    push_cast
    have h := fun j : Fin 2 => (InheritedColumnMask_card_le (bf.P l j).Ψ.D (bf.P l j).Ψ.A
      ((bf.charts l j) I hI).1).trans (bf.budget l j)
    linarith [h 0, h 1]
  · have he : (Finset.univ.filter fun x : bf.Lab => (bf.origCols l).avail I x) = ∅ :=
      Finset.filter_eq_empty_iff.mpr fun x _ hx => hI hx.2.1
    rw [he, Finset.card_empty, Nat.cast_zero]
    have := A.Dc_nonneg
    unfold ActiveSetup.colBudget
    positivity

end ActiveSetup.BasicFamilies

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}

open scoped Classical in
/-- Blueprint lem:closure (lines 1819-1828) on the main columns of an attempt: for any finite
families of named main tests on the active cells (at most `K_t` per cell and slot, residual slot
the slot of the catalog, target ranks `1 ≤ r ≤ L + 5`, bases supported on the cell without
template coordinates) with the thresholds `τ₃ / (D √n_{r-1})` of eq:catalog-test, path counts
`n_r` with `n_0` at least the original labels of a cell and ratios
`n_r / n_{r-1} ≥ 1 + (L + 6) M_p K` (`K` the closure ratio) and trial cap `T ≥ n_{L+5}`, the
catalog closure terminates on every active cell: there are slot catalogs of same-tag templates of
their slot born at the active cells, with rank and tag of a named test there, passing all named
tests; the rank-`r` insertions at one cell number at most `K n_{r-1}`; at every cell lying in at
most `M_p` active cells the main labels of rank at most `r ≤ L + 5` number at most `n_r`. The
counts do not involve the edge threshold `H_ed` (blueprint line 1820). -/
theorem main_closure (fp : bf.FamParams) (Tc : Finset (ℤ × ℤ)) (hTc : Tc ⊆ A.cells)
    {cS Dst : ℕ} (hst : SameTagBound κ cS Dst) {HS : ℝ}
    (hHS : Real.exp 2 ≤ HS) (W : Fin 4 → ℤ × ℤ → Type*) [∀ l I, Fintype (W l I)]
    (tests : ∀ l I, W l I → MainTest bf.Vtx bf.Lab fp.Mc)
    (ht : ∀ l I w, (tests l I w).t = l)
    (hr : ∀ l I w, 1 ≤ (tests l I w).r ∧ (tests l I w).r ≤ fp.Lc + 5)
    (hbase : ∀ l, ∀ I ∈ Tc, ∀ w, MainFresh fp.Mc 0 (tests l I w).base ∧
      ∀ᵐ y ∂volume, y ∉ dyadicGridCell A.G I.1 I.2 →
        ((tests l I w).base : ℝ → ColumnHilbert (bf.Lab ⊕ Fin fp.Mc)) y = 0)
    {Kt : ℕ} (hKt : ∀ l I, Fintype.card (W l I) ≤ Kt) {Mp : ℕ} (hMp : 1 ≤ Mp)
    {τ₃ : ℝ} (hτ₃ : 0 < τ₃) {Tmax : ℕ} (n : ℕ → ℝ) (hn0 : 2 * A.colBudget ≤ n 0)
    (hratio : ∀ r, (1 + (fp.Lc + 6) * Mp * closureRatio A.famVtxBound Kt fp.mH Tmax
      (Real.exp (Dst * (1 + Real.log HS) ^ Dst)) τ₃) * n r ≤ n (r + 1))
    (hT : n (fp.Lc + 5) ≤ Tmax) (hMc : Tc.card * Tmax ≤ fp.Mc) :
    ∃ cat : Fin 4 → List (CatCol bf.Vtx), ∀ l,
      (∀ I ∈ Tc, ∀ w, (tests l I w).Pass A.G (bf.origCols l) I cS HS bf.vtag (A.w I)
        (catThreshold A.famVtxBound τ₃ n (tests l I w).r) fp.mH (cat l)) ∧
      (∀ d ∈ cat l, d.birth ∈ Tc ∧
        (∃ w, d.rank = (tests l d.birth w).r ∧ (tests l d.birth w).M d.tag) ∧
        ∃ R ∈ residueBox (bf.vtag d.tag).dim 9, ∃ γ : ℝ,
          d = templateCol (bf.vtag d.tag) l R γ d.birth d.rank d.tag) ∧
      (∀ I ∈ Tc, ∀ r,
        (((cat l).filter (fun d => decide (d.birth = I ∧ d.rank = r))).length : ℝ) ≤
          closureRatio A.famVtxBound Kt fp.mH Tmax (Real.exp (Dst * (1 + Real.log HS) ^ Dst)) τ₃ *
            n (r - 1)) ∧
      (∀ I, (Tc.filter fun I' : ℤ × ℤ =>
          dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G I'.1 I'.2).card ≤ Mp →
        ∀ r ≤ fp.Lc + 5, ((mainLabels A.G fp.Mc (bf.origCols l) (cat l) I r).card : ℝ) ≤ n r) ∧
      (cat l).length ≤ Tc.card * Tmax := by
  classical
  set H₀ := Real.exp (Dst * (1 + Real.log HS) ^ Dst) with hH₀
  set Dv := A.famVtxBound with hDv
  set! Q : ℝ := 4 ^ fp.mH * projectionPrefixConstant Tmax ^ (2 * fp.mH) with hQ
  set Kc := closureRatio Dv Kt fp.mH Tmax H₀ τ₃ with hKc
  have hH₀p : 0 < H₀ := Real.exp_pos _
  have hDvp : 0 < Dv := A.one_le_famVtxBound
  have hKc0 : 0 ≤ Kc := closureRatio_nonneg _ _ _ _ _ _
  have hQ0 : 0 ≤ Q := by have := projectionPrefixConstant_one_le Tmax; positivity
  have hcb : 0 < A.colBudget := by
    have := A.Dc_nonneg; unfold ActiveSetup.colBudget; positivity
  have hMp' : (1 : ℝ) ≤ Mp := by exact_mod_cast hMp
  have hgr : 0 ≤ (fp.Lc + 6 : ℝ) * Mp * Kc := by positivity
  have hpos : ∀ r, 0 < n r := by
    intro r
    induction r with
    | zero => linarith
    | succ r ih => have := hratio r; nlinarith only [hgr, ih, this]
  have hmono : Monotone n := monotone_nat_of_le_succ fun r => by
    have := hratio r; have := hpos r; nlinarith
  have hτp : ∀ r, 0 < catThreshold Dv τ₃ n r := fun r => catThreshold_pos hDvp hτ₃ (hpos _)
  have hallow : ∀ (c : ℝ) r, c * Q / (catThreshold Dv τ₃ n r / (2 * H₀)) ^ 2 =
      c * Q * (2 * H₀ * Dv / τ₃) ^ 2 * n (r - 1) := fun c r =>
    allowance_eq hDvp hτ₃ (hpos _) c Q hH₀p
  -- no trial cap is attained
  have hcap : ∀ l I, ∑ r ∈ Finset.univ.image (fun w => (tests l I w).r),
      (Fintype.card (W l I) : ℝ) * Q / (catThreshold Dv τ₃ n r / (2 * H₀)) ^ 2 < (Tmax : ℝ) := by
    intro l I
    have hterm : ∀ r ∈ Finset.univ.image (fun w => (tests l I w).r),
        (Fintype.card (W l I) : ℝ) * Q / (catThreshold Dv τ₃ n r / (2 * H₀)) ^ 2 ≤
          Kc * n (fp.Lc + 4) := by
      intro r hr'
      obtain ⟨w, -, rfl⟩ := Finset.mem_image.mp hr'
      rw [hallow]
      have hc : (Fintype.card (W l I) : ℝ) ≤ Kt := by exact_mod_cast hKt l I
      have hn := hmono (show (tests l I w).r - 1 ≤ fp.Lc + 4 by have := (hr l I w).2; omega)
      have := hpos ((tests l I w).r - 1)
      calc (Fintype.card (W l I) : ℝ) * Q * (2 * H₀ * Dv / τ₃) ^ 2 * n ((tests l I w).r - 1)
          ≤ Kt * Q * (2 * H₀ * Dv / τ₃) ^ 2 * n (fp.Lc + 4) := by gcongr
        _ = Kc * n (fp.Lc + 4) := rfl
    have hsub : Finset.univ.image (fun w => (tests l I w).r) ⊆ Finset.Icc 1 (fp.Lc + 5) :=
      fun r hr' => by
        obtain ⟨w, -, rfl⟩ := Finset.mem_image.mp hr'
        exact Finset.mem_Icc.mpr (hr l I w)
    have hcard : ((Finset.univ.image (fun w => (tests l I w).r)).card : ℝ) ≤ fp.Lc + 5 := by
      have h := Finset.card_le_card hsub
      rw [Nat.card_Icc] at h
      have h' : (Finset.univ.image (fun w => (tests l I w).r)).card ≤ fp.Lc + 5 := by omega
      exact_mod_cast h'
    have hn4 := hpos (fp.Lc + 4)
    have hKn : 0 ≤ Kc * n (fp.Lc + 4) := mul_nonneg hKc0 hn4.le
    calc ∑ r ∈ Finset.univ.image (fun w => (tests l I w).r),
          (Fintype.card (W l I) : ℝ) * Q / (catThreshold Dv τ₃ n r / (2 * H₀)) ^ 2
        ≤ ∑ r ∈ Finset.univ.image (fun w => (tests l I w).r), Kc * n (fp.Lc + 4) :=
          Finset.sum_le_sum hterm
      _ = (Finset.univ.image (fun w => (tests l I w).r)).card * (Kc * n (fp.Lc + 4)) := by
          rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ (fp.Lc + 5) * (Kc * n (fp.Lc + 4)) := mul_le_mul_of_nonneg_right hcard hKn
      _ < (1 + (fp.Lc + 6) * Mp * Kc) * n (fp.Lc + 4) := by
          have h56 : (fp.Lc + 5 : ℝ) ≤ (fp.Lc + 6) * Mp := by nlinarith only [hMp']
          have : (fp.Lc + 5 : ℝ) * Kc ≤ (fp.Lc + 6) * Mp * Kc :=
            mul_le_mul_of_nonneg_right h56 hKc0
          nlinarith only [hn4, hKn, h56]
      _ ≤ n (fp.Lc + 5) := hratio (fp.Lc + 4)
      _ ≤ Tmax := hT
  obtain ⟨L, hnd, hmem, hord⟩ := exists_coarse_first A.G Tc
  have hLlen : L.length = Tc.card := by
    rw [← List.toFinset_card_of_nodup hnd]
    congr 1
    ext I
    rw [List.mem_toFinset, hmem]
  have h := fun l : Fin 4 => main_tree_closure (O := bf.origCols l) hst hHS (tagOf := bf.vtag)
    bf.one_le_vchart_dim L hnd hord A.w (fun I hI => A.adm I (hTc ((hmem I).mp hI))) (W l) (tests l)
    fp.mH (catThreshold Dv τ₃ n) (fun I w => hτp _) []
    (fun I hI w => ⟨(hbase l I ((hmem I).mp hI) w).1,
      (norm_eq_cellNorm_of_support A.G I _ (hbase l I ((hmem I).mp hI) w).2).le⟩)
    (Tmax := Tmax) (by simp only [List.length_nil, hLlen]; omega) (fun I _ => hcap l I)
  choose cat hcat using h
  refine ⟨cat, fun l => ?_⟩
  obtain ⟨hpass, hbirth, hcount, hlen⟩ := hcat l
  -- the rank counts at one cell
  have hcnt : ∀ I ∈ Tc, ∀ r,
      (((cat l).filter (fun d => decide (d.birth = I ∧ d.rank = r))).length : ℝ) ≤
        Kc * n (r - 1) := by
    intro I hI r
    rcases hcount I ((hmem I).mpr hI) r with h | h
    · have hδ : 0 < (catThreshold Dv τ₃ n r / (2 * H₀)) ^ 2 := by
        have := hτp r; positivity
      have h' := (le_div_iff₀ hδ).mpr h
      rw [hallow] at h'
      refine h'.trans ?_
      have hc : (Fintype.card (W l I) : ℝ) ≤ Kt := by exact_mod_cast hKt l I
      have := hpos (r - 1)
      calc (Fintype.card (W l I) : ℝ) * Q * (2 * H₀ * Dv / τ₃) ^ 2 * n (r - 1)
          ≤ Kt * Q * (2 * H₀ * Dv / τ₃) ^ 2 * n (r - 1) := by gcongr
        _ = Kc * n (r - 1) := rfl
    · exact absurd h (not_le.mpr (div_pos (hτp r) (by positivity)))
  refine ⟨fun I hI w => hpass I ((hmem I).mpr hI) w, fun d hd => ?_, hcnt,
    fun I hMpI r hr' => ?_, by rw [← hLlen]; exact hlen⟩
  · obtain ⟨hb, w, hrk, hM, R, hR, γ, hd'⟩ := hbirth d hd
    refine ⟨(hmem _).mp hb, ⟨w, hrk, hM⟩, R, hR, γ, ?_⟩
    rw [ht, ← hrk] at hd'
    exact hd'
  -- the path counts
  set C := Tc.filter fun I' : ℤ × ℤ =>
    dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G I'.1 I'.2 with hC
  have hT' : ∀ d ∈ cat l, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G d.birth.1 d.birth.2 →
      d.rank ≤ r → (d.birth, d.rank) ∈ C ×ˢ Finset.Icc 1 r := by
    intro d hd h1 h2
    obtain ⟨hb, w, hrk, -⟩ := hbirth d hd
    refine Finset.mem_product.mpr ⟨Finset.mem_filter.mpr ⟨(hmem _).mp hb, h1⟩,
      Finset.mem_Icc.mpr ⟨?_, h2⟩⟩
    rw [hrk]
    exact (hr l _ w).1
  have h1 := card_mainLabels_le A.G fp.Mc (bf.origCols l) (cat l) I r _ hT'
  have h2 := bf.card_avail_le l I
  have h3 : ∀ b ∈ C ×ˢ Finset.Icc 1 r,
      (((cat l).filter (fun d => decide (d.birth = b.1 ∧ d.rank = b.2))).length : ℝ) ≤
        Kc * n (r - 1) := by
    intro b hb
    simp only [Finset.mem_product, Finset.mem_Icc] at hb
    exact (hcnt b.1 (Finset.mem_filter.mp hb.1).1 b.2).trans
      (mul_le_mul_of_nonneg_left (hmono (by omega)) hKc0)
  have h1' : ((mainLabels A.G fp.Mc (bf.origCols l) (cat l) I r).card : ℝ) ≤
      ((Finset.univ.filter fun v => (bf.origCols l).avail I v).card : ℝ) +
        ∑ b ∈ C ×ˢ Finset.Icc 1 r,
          (((cat l).filter (fun d => decide (d.birth = b.1 ∧ d.rank = b.2))).length : ℝ) := by
    exact_mod_cast h1
  have h4 : ((mainLabels A.G fp.Mc (bf.origCols l) (cat l) I r).card : ℝ) ≤
      n 0 + (C.card : ℝ) * r * (Kc * n (r - 1)) := by
    refine h1'.trans (add_le_add (h2.trans hn0) ((Finset.sum_le_sum h3).trans (le_of_eq ?_)))
    rw [Finset.sum_const, Finset.card_product, Nat.card_Icc, nsmul_eq_mul, Nat.add_sub_cancel]
    push_cast
    ring
  rcases Nat.eq_zero_or_pos r with rfl | hr1
  · simpa using h4
  · have hCM : (C.card : ℝ) ≤ Mp := by exact_mod_cast hMpI
    have hrL : (r : ℝ) ≤ fp.Lc + 6 := by
      have : r ≤ fp.Lc + 6 := by omega
      exact_mod_cast this
    have hKn : 0 ≤ Kc * n (r - 1) := mul_nonneg hKc0 (hpos _).le
    have h5 : (C.card : ℝ) * r * (Kc * n (r - 1)) ≤ (fp.Lc + 6) * Mp * Kc * n (r - 1) := by
      have : (C.card : ℝ) * r ≤ Mp * (fp.Lc + 6) :=
        mul_le_mul hCM hrL (Nat.cast_nonneg _) (by positivity)
      nlinarith only [hKn, this]
    have h6 := hmono (Nat.zero_le (r - 1))
    have h7 := hratio (r - 1)
    rw [Nat.sub_add_cancel hr1] at h7
    nlinarith only [h4, h5, h6, h7]

/-- Blueprint lem:closure, the reserved helper closure (lines 1815, 1820, 1828): for any slot
catalogs and any finite families of helper tests of rank `L + 5` on the active cells (at most
`K_t` per cell and slot, residual slot the slot of the catalog) on fixed whole bases supported on
the cell whose coordinates avoid the fresh helper labels beyond the catalog, helper templates of
rank `L + 5` born at the active cells close the helper tests at the thresholds
`τ₃ / (D √n_{L+4})`, with at most `K n_{L+4}` insertions per cell, whenever this allowance stays
below the trial cap. -/
theorem helper_closure (fp : bf.FamParams) (Tc : Finset (ℤ × ℤ)) (hTc : Tc ⊆ A.cells)
    {cS Dst : ℕ} (hst : SameTagBound κ cS Dst) {HS : ℝ}
    (hHS : Real.exp 2 ≤ HS) (cat : Fin 4 → List (CatCol bf.Vtx)) (W : Fin 4 → ℤ × ℤ → Type*)
    [∀ l I, Fintype (W l I)] (tests : ∀ l I, W l I → MainTest bf.Vtx bf.Lab fp.Mc)
    (ht : ∀ l I w, (tests l I w).t = l) (hr : ∀ l I w, (tests l I w).r = fp.Lc + 5)
    (hbase : ∀ l, ∀ I ∈ Tc, ∀ w, MainFresh fp.Mc (cat l).length (tests l I w).base ∧
      ∀ᵐ y ∂volume, y ∉ dyadicGridCell A.G I.1 I.2 →
        ((tests l I w).base : ℝ → ColumnHilbert (bf.Lab ⊕ Fin fp.Mc)) y = 0)
    {Kt : ℕ} (hKt : ∀ l I, Fintype.card (W l I) ≤ Kt) {τ₃ : ℝ} (hτ₃ : 0 < τ₃) {Tmax : ℕ}
    (n : ℕ → ℝ) (hn : 0 < n (fp.Lc + 4))
    (hcapH : closureRatio A.famVtxBound Kt fp.mH Tmax
      (Real.exp (Dst * (1 + Real.log HS) ^ Dst)) τ₃ * n (fp.Lc + 4) < Tmax)
    (hMc : ∀ l, (cat l).length + Tc.card * Tmax ≤ fp.Mc) :
    ∃ hcat : Fin 4 → List (CatCol bf.Vtx), ∀ l,
      (∀ I ∈ Tc, ∀ w, (tests l I w).Pass A.G (bf.origCols l) I cS HS bf.vtag (A.w I)
        (catThreshold A.famVtxBound τ₃ n (fp.Lc + 5)) fp.mH (cat l ++ hcat l)) ∧
      (∀ d ∈ hcat l, d.birth ∈ Tc ∧ d.rank = fp.Lc + 5 ∧ (∃ w, (tests l d.birth w).M d.tag) ∧
        ∃ R ∈ residueBox (bf.vtag d.tag).dim 9, ∃ γ : ℝ,
          d = templateCol (bf.vtag d.tag) l R γ d.birth d.rank d.tag) ∧
      (∀ I ∈ Tc, (((hcat l).filter (fun d => decide (d.birth = I))).length : ℝ) ≤
          closureRatio A.famVtxBound Kt fp.mH Tmax (Real.exp (Dst * (1 + Real.log HS) ^ Dst)) τ₃ *
            n (fp.Lc + 4)) ∧
      (hcat l).length ≤ Tc.card * Tmax := by

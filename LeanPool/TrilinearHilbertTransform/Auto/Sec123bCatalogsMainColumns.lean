    obtain ⟨-, w, h, -⟩ := hbirth d hd
    rw [h, hr]
  refine ⟨fun I hI w => ?_, fun d hd => ?_, fun I hI => ?_, by rw [← hLlen]; exact hlen⟩
  · have := hpass I ((hmem I).mpr hI) w

-- Modified for Lean Pool.

module

public import LeanPool.NonpluripolarProducts.Foundations.Analysis.FirstPass.CoordinateWedgePullback
public import LeanPool.NonpluripolarProducts.Foundations.Analysis.FirstPass.PositiveClasses
public import Mathlib.Geometry.Convex.Cone.Pointed
public import Mathlib.Tactic.Module

/-!
# Strongly positive forms at a point

On the model space `ComplexModel n = ℂⁿ`, a real `(1,1)`-form `β` (`IsOneOne`) is
*semipositive* when `β(v, i v) ≥ 0` for every `v`.  The *strongly positive cone* in degree
`2q` is the convex cone generated by the exterior products `β₁ ∧ ⋯ ∧ β_q` of semipositive
real `(1,1)`-forms (`demailly-cadg:III.1`: a semipositive `(1,1)`-form is a sum of forms
`i γ ∧ γBar`, so this is the cone generated by the products `i γ₁ ∧ γBar₁ ∧ ⋯ ∧ i γ_q ∧ γBar_q`).
It is defined here by the recursion `SP₀ = ℝ_{≥0} · 1` and
`SP_{q+1} = cone (SP_q ∧ semipositive)`, with the genuine exterior product
`FirstPass.MongeAmpere.coordinateWedge`; the degree is written `2 * q`, so that
`2 * (q + 1)` and `2 * q + 2` agree definitionally and no cast is needed.

These cones are the pointwise positivity used by the positive currents of
`Pending.PositiveProductCurrents` (weak positivity of a current = nonnegativity on
strongly positive test forms, `demailly-cadg:III.1.13`).

## Main results

* `wedgeBilin` — the exterior product `Λᵖ × Λ² → Λᵖ⁺²` as a bilinear map.
* `IsSemipositiveOneOne` and its closure properties; `IsSemipositiveOneOne.comp` —
  pullback along a complex-linear map.
* `spCone`, `wedge_mem_spCone`, `formPower_mem_spCone` (powers of a semipositive form).
* `orderUnit_step` — the inductive step of the order-unit bound: if `c ω^q ± P` are
  strongly positive and `K ω ± β` semipositive, then `c K ω^{q+1} ± P ∧ β` are strongly
  positive.  So a power of a positive form dominates every product of real `(1,1)`-forms.
* `compContinuousLinearMap_mem_spCone` — strong positivity is preserved by pullback along
  complex-linear maps (holomorphic changes of coordinates, holomorphic maps).
-/

@[expose] public section

noncomputable section

namespace SGPT.Foundations.Analysis.Pending.StronglyPositiveForms

open FirstPass FirstPass.MongeAmpere FirstPass.PositiveClasses

variable {m n : ℕ}

/-- Real continuous alternating `k`-forms on the model space. -/
abbrev RealForm (n k : ℕ) := (ComplexModel n) [⋀^Fin k]→L[ℝ] ℝ

/-! ### Bilinearity of the exterior product -/

section Bilinear

variable {p q : ℕ}

theorem coordinateWedge_add_left (A A' : RealForm n p) (B : RealForm n q) :
    coordinateWedge (A + A') B = coordinateWedge A B + coordinateWedge A' B := by
  ext v
  simp only [coordinateWedge_apply, coordinateWedgeSum_apply,
    ContinuousAlternatingMap.add_apply, add_mul, mul_add, Finset.sum_add_distrib]

theorem coordinateWedge_add_right (A : RealForm n p) (B B' : RealForm n q) :
    coordinateWedge A (B + B') = coordinateWedge A B + coordinateWedge A B' := by
  ext v
  simp only [coordinateWedge_apply, coordinateWedgeSum_apply,
    ContinuousAlternatingMap.add_apply, mul_add, Finset.sum_add_distrib]

theorem coordinateWedge_smul_left (c : ℝ) (A : RealForm n p) (B : RealForm n q) :
    coordinateWedge (c • A) B = c • coordinateWedge A B := by
  ext v
  simp only [coordinateWedge_apply, coordinateWedgeSum_apply,
    ContinuousAlternatingMap.smul_apply, smul_eq_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl fun σ _ => ?_
  ring

theorem coordinateWedge_smul_right (c : ℝ) (A : RealForm n p) (B : RealForm n q) :
    coordinateWedge A (c • B) = c • coordinateWedge A B := by
  ext v
  simp only [coordinateWedge_apply, coordinateWedgeSum_apply,
    ContinuousAlternatingMap.smul_apply, smul_eq_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl fun σ _ => ?_
  ring

/-- The exterior product with a two-form, as a bilinear map `Λᵖ → Λ² → Λᵖ⁺²`. -/
def wedgeBilin (n p : ℕ) : RealForm n p →ₗ[ℝ] RealForm n 2 →ₗ[ℝ] RealForm n (p + 2) :=
  LinearMap.mk₂ ℝ (fun A B => coordinateWedge A B) coordinateWedge_add_left
    coordinateWedge_smul_left coordinateWedge_add_right coordinateWedge_smul_right

@[simp] theorem wedgeBilin_apply (A : RealForm n p) (B : RealForm n 2) :
    wedgeBilin n p A B = coordinateWedge A B := rfl

end Bilinear

/-! ### Semipositive real `(1,1)`-forms -/

/-- A real two-form of type `(1,1)` that is nonnegative on every complex line. -/
def IsSemipositiveOneOne (β : RealForm n 2) : Prop :=
  IsOneOne β ∧ CoefficientSemipositive β

namespace IsSemipositiveOneOne

theorem zero : IsSemipositiveOneOne (0 : RealForm n 2) :=
  ⟨fun _ _ => rfl, coefficientSemipositive_zero⟩

theorem add {β γ : RealForm n 2} (hβ : IsSemipositiveOneOne β)
    (hγ : IsSemipositiveOneOne γ) : IsSemipositiveOneOne (β + γ) := by
  refine ⟨fun u v => ?_, fun v => ?_⟩
  · simp only [ContinuousAlternatingMap.add_apply, hβ.1 u v, hγ.1 u v]
  · simp only [ContinuousAlternatingMap.add_apply]
    exact add_nonneg (hβ.2 v) (hγ.2 v)

theorem smul {β : RealForm n 2} (hβ : IsSemipositiveOneOne β) {c : ℝ} (hc : 0 ≤ c) :
    IsSemipositiveOneOne (c • β) := by
  refine ⟨fun u v => ?_, fun v => ?_⟩
  · simp only [ContinuousAlternatingMap.smul_apply, hβ.1 u v]
  · simp only [ContinuousAlternatingMap.smul_apply, smul_eq_mul]
    exact mul_nonneg hc (hβ.2 v)

/-- Pullback along a real-linear map commuting with `i` (the derivative of a holomorphic
map) keeps a semipositive `(1,1)`-form semipositive of type `(1,1)`. -/
theorem comp {β : RealForm n 2} (hβ : IsSemipositiveOneOne β)
    (L : ComplexModel m →L[ℝ] ComplexModel n)
    (hL : ∀ v, L (Complex.I • v) = Complex.I • L v) :
    IsSemipositiveOneOne (β.compContinuousLinearMap L) := by
  have hcomp : ∀ u v : ComplexModel m, (⇑L ∘ ![u, v]) = ![L u, L v] := by
    intro u v
    funext i
    fin_cases i <;> rfl
  refine ⟨fun u v => ?_, fun v => ?_⟩
  · simp only [ContinuousAlternatingMap.compContinuousLinearMap_apply, hcomp, hL]
    exact hβ.1 (L u) (L v)
  · simp only [ContinuousAlternatingMap.compContinuousLinearMap_apply, hcomp, hL]
    exact hβ.2 (L v)

end IsSemipositiveOneOne

/-- `K • ω ± β` is the order-unit condition for a real two-form `β` relative to `ω`. -/
theorem isSemipositiveOneOne_sub_iff_add_neg (ω β : RealForm n 2) (K : ℝ) :
    IsSemipositiveOneOne (K • ω - β) ↔ IsSemipositiveOneOne (K • ω + -β) := by
  rw [sub_eq_add_neg]

/-! ### The strongly positive cone -/

/-- The strongly positive cone in degree `2q`: nonnegative constants in degree `0`, and
the cone generated by `P ∧ β` with `P` strongly positive and `β` semipositive `(1,1)`. -/
def spCone : (q : ℕ) → PointedCone ℝ (RealForm n (2 * q))
  | 0 => PointedCone.hull ℝ {coordinateWedgeUnit}
  | q + 1 => PointedCone.hull ℝ
      {R | ∃ P ∈ spCone q, ∃ β : RealForm n 2, IsSemipositiveOneOne β ∧
        R = coordinateWedge P β}

theorem unit_mem_spCone : (coordinateWedgeUnit : RealForm n 0) ∈ spCone (n := n) 0 :=
  PointedCone.subset_hull rfl

/-- The generators: a strongly positive form wedge a semipositive `(1,1)`-form. -/
theorem wedge_mem_spCone {q : ℕ} {P : RealForm n (2 * q)} (hP : P ∈ spCone q)
    {β : RealForm n 2} (hβ : IsSemipositiveOneOne β) :
    coordinateWedge P β ∈ spCone (q + 1) :=
  PointedCone.subset_hull ⟨P, hP, β, hβ, rfl⟩

theorem smul_mem_spCone {q : ℕ} {P : RealForm n (2 * q)} (hP : P ∈ spCone q) {c : ℝ}
    (hc : 0 ≤ c) : c • P ∈ spCone q :=
  PointedCone.smul_mem _ hc hP

/-- The powers `ω^q` of a two-form, by the same recursion. -/
def formPower (ω : RealForm n 2) : (q : ℕ) → RealForm n (2 * q)
  | 0 => coordinateWedgeUnit
  | q + 1 => coordinateWedge (formPower ω q) ω

@[simp] theorem formPower_zero (ω : RealForm n 2) : formPower ω 0 = coordinateWedgeUnit := rfl

theorem formPower_succ (ω : RealForm n 2) (q : ℕ) :
    formPower ω (q + 1) = coordinateWedge (formPower ω q) ω := rfl

theorem formPower_mem_spCone {ω : RealForm n 2} (hω : IsSemipositiveOneOne ω) :
    ∀ q, formPower ω q ∈ spCone q
  | 0 => unit_mem_spCone
  | q + 1 => wedge_mem_spCone (formPower_mem_spCone hω q) hω

/-- **The inductive step of the order-unit bound.**  If `c ω^q ± P` are strongly positive
and `K ω ± β` are semipositive `(1,1)`-forms, then `c K ω^{q+1} ± P ∧ β` are strongly
positive.  Writing `A = c ω^q + P`, `B = c ω^q - P`, `G = K ω + β`, `H = K ω - β`:
`2 (c K ω^{q+1} + P ∧ β) = A ∧ G + B ∧ H` and `2 (c K ω^{q+1} - P ∧ β) = A ∧ H + B ∧ G`. -/
theorem orderUnit_step {q : ℕ} {ω β : RealForm n 2} {P : RealForm n (2 * q)} {c K : ℝ}
    (hP₁ : c • formPower ω q - P ∈ spCone q) (hP₂ : c • formPower ω q + P ∈ spCone q)
    (hβ₁ : IsSemipositiveOneOne (K • ω - β)) (hβ₂ : IsSemipositiveOneOne (K • ω + β)) :
    (c * K) • formPower ω (q + 1) - coordinateWedge P β ∈ spCone (q + 1) ∧
      (c * K) • formPower ω (q + 1) + coordinateWedge P β ∈ spCone (q + 1) := by
  set W := formPower ω q
  have hAH := wedge_mem_spCone hP₂ hβ₁
  have hBG := wedge_mem_spCone hP₁ hβ₂
  have hAG := wedge_mem_spCone hP₂ hβ₂
  have hBH := wedge_mem_spCone hP₁ hβ₁
  have e₁ : (c * K) • formPower ω (q + 1) - coordinateWedge P β =
      (1 / 2 : ℝ) • (coordinateWedge (c • W + P) (K • ω - β) +
        coordinateWedge (c • W - P) (K • ω + β)) := by
    simp only [formPower_succ, ← wedgeBilin_apply, map_add, map_sub, map_smul,
      LinearMap.add_apply, LinearMap.sub_apply, LinearMap.smul_apply, W]
    module
  have e₂ : (c * K) • formPower ω (q + 1) + coordinateWedge P β =
      (1 / 2 : ℝ) • (coordinateWedge (c • W + P) (K • ω + β) +
        coordinateWedge (c • W - P) (K • ω - β)) := by
    simp only [formPower_succ, ← wedgeBilin_apply, map_add, map_sub, map_smul,
      LinearMap.add_apply, LinearMap.sub_apply, LinearMap.smul_apply, W]
    module
  rw [e₁, e₂]
  exact ⟨smul_mem_spCone ((spCone (q + 1)).add_mem hAH hBG) (by norm_num),
    smul_mem_spCone ((spCone (q + 1)).add_mem hAG hBH) (by norm_num)⟩

/-! ### Pullback along complex-linear maps -/

theorem zero_compContinuousLinearMap {k : ℕ} (L : ComplexModel m →L[ℝ] ComplexModel n) :
    (0 : RealForm n k).compContinuousLinearMap L = 0 := by
  ext v
  rfl

theorem add_compContinuousLinearMap {k : ℕ} (A B : RealForm n k)
    (L : ComplexModel m →L[ℝ] ComplexModel n) :
    (A + B).compContinuousLinearMap L =
      A.compContinuousLinearMap L + B.compContinuousLinearMap L := by
  ext v
  rfl

theorem smul_compContinuousLinearMap {k : ℕ} (c : ℝ) (A : RealForm n k)
    (L : ComplexModel m →L[ℝ] ComplexModel n) :
    (c • A).compContinuousLinearMap L = c • A.compContinuousLinearMap L := by
  ext v
  rfl

theorem coordinateWedgeUnit_compContinuousLinearMap
    (L : ComplexModel m →L[ℝ] ComplexModel n) :
    (coordinateWedgeUnit : RealForm n 0).compContinuousLinearMap L = coordinateWedgeUnit := by
  ext v
  rfl

/-- **Strong positivity is preserved by complex-linear pullback.** -/
theorem compContinuousLinearMap_mem_spCone (L : ComplexModel m →L[ℝ] ComplexModel n)
    (hL : ∀ v, L (Complex.I • v) = Complex.I • L v) :
    ∀ (q : ℕ) {P : RealForm n (2 * q)}, P ∈ spCone q →
      P.compContinuousLinearMap L ∈ spCone (n := m) q
  | 0, P, hP => by
    induction hP using Submodule.span_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      subst hx
      rw [coordinateWedgeUnit_compContinuousLinearMap]
      exact unit_mem_spCone
    | zero => rw [zero_compContinuousLinearMap]; exact (spCone (n := m) 0).zero_mem
    | add x y _ _ hx hy =>
      rw [add_compContinuousLinearMap]
      exact (spCone (n := m) 0).add_mem hx hy
    | smul a x _ hx =>
      change ((a : ℝ) • x).compContinuousLinearMap L ∈ _
      rw [smul_compContinuousLinearMap]
      exact smul_mem_spCone hx a.2
  | q + 1, P, hP => by
    induction hP using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨Q, hQ, β, hβ, rfl⟩ := hx
      rw [coordinateWedge_compContinuousLinearMap]
      exact wedge_mem_spCone (compContinuousLinearMap_mem_spCone L hL q hQ) (hβ.comp L hL)
    | zero => rw [zero_compContinuousLinearMap]; exact (spCone (n := m) (q + 1)).zero_mem
    | add x y _ _ hx hy =>
      rw [add_compContinuousLinearMap]
      exact (spCone (n := m) (q + 1)).add_mem hx hy
    | smul a x _ hx =>
      change ((a : ℝ) • x).compContinuousLinearMap L ∈ _
      rw [smul_compContinuousLinearMap]
      exact smul_mem_spCone hx a.2

end SGPT.Foundations.Analysis.Pending.StronglyPositiveForms

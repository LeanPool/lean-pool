/-!
# The generator of a `C₀`-semigroup

The paper writes `e^{t L_{ε,u}}` for the semigroup generated by the induction operator
(Lemma A.1, `lem:semigroup-spectral-growth`) and uses the standard facts on generators of
`C₀`-semigroups (Engel–Nagel, Chapter II.1).  This module defines the generator of a
`FastDynamo.StronglyContinuousSemigroup` and proves those facts.

* `StronglyContinuousSemigroup.generator`: the generator `G` as a Mathlib partially defined
  linear map `X →ₗ.[ℂ] X`.  Its domain is the set of vectors `x` whose right difference quotient
  `diffQuotient x h = h⁻¹ (S(h) x − x)` converges as `h → 0⁺`, and its value is the limit
  (Engel–Nagel Definition II.1.2).
* `apply_mem_generator_domain`: the domain is invariant under `S(t)` and `G S(t) = S(t) G` on it.
* `hasDerivWithinAt_apply`: for `x` in the domain the orbit `t ↦ S(t) x` is differentiable on
  `[0, ∞)` (one-sided at `0`) with derivative `S(t) G x`.
* `dense_generator_domain`: the domain is dense; the averaged orbits
  `τ⁻¹ ∫₀^τ S(s) x ds` lie in the domain and converge to `x`.
* `apply_eq_cexp_smul_of_generator_eq_smul`: an eigenvector `G x = λ x` evolves as
  `S(t) x = e^{tλ} x`.
* `ext_of_generator_eq`: a `C₀`-semigroup on a Banach space is determined by its generator
  (Engel–Nagel Theorem II.1.4).  For `x` in the domain, `s ↦ T(t − s) S(s) x` has right
  derivative `0` on `[0, t)`; the product rule for the strongly continuous, locally bounded
  family `T(t − s)` is `hasDerivWithinAt_operator_apply`.
* `mem_generator_restrict_domain_iff`, `generator_restrict_apply`: the generator of the
  restriction to a closed invariant subspace `W` is the part of `G` in `W`, with domain
  `D(G) ∩ W`.
-/

@[expose] public section

namespace FastDynamo

noncomputable section

open Filter Topology Set

universe u

namespace StronglyContinuousSemigroup

variable {X : Type u} [NormedAddCommGroup X] [NormedSpace ℂ X]

/-!
## The generator
-/

/-- The right difference quotient `h⁻¹ (S(h) x − x)` of the orbit of `x` at time `0`. -/
def diffQuotient (S : StronglyContinuousSemigroup X) (x : X) (h : ℝ) : X :=
  (h : ℂ)⁻¹ • (S (Real.toNNReal h) x - x)

/-- The difference quotient is additive in the vector. -/
theorem diffQuotient_add (S : StronglyContinuousSemigroup X) (x y : X) :
    S.diffQuotient (x + y) = S.diffQuotient x + S.diffQuotient y := by
  funext h
  simp only [diffQuotient, map_add, Pi.add_apply, ← smul_add]
  congr 1
  abel

/-- The difference quotient is homogeneous in the vector. -/
theorem diffQuotient_smul (S : StronglyContinuousSemigroup X) (c : ℂ) (x : X) :
    S.diffQuotient (c • x) = c • S.diffQuotient x := by
  funext h
  simp only [diffQuotient, map_smul, Pi.smul_apply, ← smul_sub, smul_comm c]

/-- The generator of a `C₀`-semigroup (Engel–Nagel Definition II.1.2), as a partially defined
linear map: its domain is the set of vectors whose right difference quotient converges as
`h → 0⁺`, and its value is the limit. -/
def generator (S : StronglyContinuousSemigroup X) : X →ₗ.[ℂ] X where
  domain :=
    { carrier := {x | ∃ y, Tendsto (S.diffQuotient x) (𝓝[>] (0 : ℝ)) (𝓝 y)}
      add_mem' := by
        rintro x y ⟨a, ha⟩ ⟨b, hb⟩
        exact ⟨a + b, by rw [diffQuotient_add]; exact ha.add hb⟩
      zero_mem' := ⟨0, by
        have h0 : S.diffQuotient 0 = fun _ ↦ 0 := by
          funext h
          simp [diffQuotient]
        rw [h0]
        exact tendsto_const_nhds⟩
      smul_mem' := by
        rintro c x ⟨a, ha⟩
        exact ⟨c • a, by rw [diffQuotient_smul]; exact ha.const_smul c⟩ }
  toFun :=
    { toFun := fun x ↦ limUnder (𝓝[>] (0 : ℝ)) (S.diffQuotient (x : X))
      map_add' := by
        rintro ⟨x, a, ha⟩ ⟨y, b, hb⟩
        have hxy : Tendsto (S.diffQuotient (x + y)) (𝓝[>] (0 : ℝ)) (𝓝 (a + b)) := by
          rw [diffQuotient_add]
          exact ha.add hb
        simp only [Submodule.coe_add]
        rw [hxy.limUnder_eq, ha.limUnder_eq, hb.limUnder_eq]
      map_smul' := by
        rintro c ⟨x, a, ha⟩
        have hcx : Tendsto (S.diffQuotient (c • x)) (𝓝[>] (0 : ℝ)) (𝓝 (c • a)) := by
          rw [diffQuotient_smul]
          exact ha.const_smul c
        simp only [SetLike.val_smul, RingHom.id_apply]
        rw [hcx.limUnder_eq, ha.limUnder_eq] }

/-- Membership in the domain of the generator: the right difference quotient converges. -/
theorem mem_generator_domain_iff (S : StronglyContinuousSemigroup X) (x : X) :
    x ∈ S.generator.domain ↔ ∃ y, Tendsto (S.diffQuotient x) (𝓝[>] (0 : ℝ)) (𝓝 y) :=
  Iff.rfl

/-- On its domain the right difference quotient converges to the value of the generator. -/
theorem tendsto_diffQuotient_generator (S : StronglyContinuousSemigroup X)
    (x : S.generator.domain) :
    Tendsto (S.diffQuotient (x : X)) (𝓝[>] (0 : ℝ)) (𝓝 (S.generator x)) := by
  obtain ⟨y, hy⟩ := x.2
  change Tendsto _ _ (𝓝 (limUnder (𝓝[>] (0 : ℝ)) (S.diffQuotient (x : X))))
  rwa [hy.limUnder_eq]

/-- The value of the generator is characterised as the limit of the right difference quotient. -/
theorem generator_eq_iff (S : StronglyContinuousSemigroup X) (x : S.generator.domain) (y : X) :
    S.generator x = y ↔ Tendsto (S.diffQuotient (x : X)) (𝓝[>] (0 : ℝ)) (𝓝 y) :=
  ⟨fun h ↦ h ▸ S.tendsto_diffQuotient_generator x,
    fun h ↦ tendsto_nhds_unique (S.tendsto_diffQuotient_generator x) h⟩

/-!
## Invariance of the domain and differentiability of orbits
-/

/-- The difference quotient of `S(t) x` is `S(t)` applied to the difference quotient of `x`. -/
theorem diffQuotient_apply (S : StronglyContinuousSemigroup X) (t : NNReal) (x : X) :
    S.diffQuotient (S t x) = fun h ↦ S t (S.diffQuotient x h) := by
  funext h
  simp only [diffQuotient, map_smul, map_sub]
  rw [← S.apply_add, add_comm, S.apply_add]

/-- The domain of the generator is invariant under the semigroup, and `G S(t) = S(t) G` on it. -/
theorem apply_mem_generator_domain (S : StronglyContinuousSemigroup X)
    (t : NNReal) (x : S.generator.domain) :
    ∃ h : S t (x : X) ∈ S.generator.domain, S.generator ⟨S t (x : X), h⟩ = S t (S.generator x) := by
  have hT : Tendsto (S.diffQuotient (S t (x : X))) (𝓝[>] (0 : ℝ)) (𝓝 (S t (S.generator x))) := by
    rw [diffQuotient_apply]
    exact ((S t).continuous.tendsto _).comp (S.tendsto_diffQuotient_generator x)
  exact ⟨⟨_, hT⟩, (S.generator_eq_iff ⟨_, ⟨_, hT⟩⟩ _).2 hT⟩

/-- If the operators `A a` are eventually bounded by `K`, `A a v₀ → y₀` and `v a → v₀`, then
`A a (v a) → y₀`. -/
theorem tendsto_apply_of_norm_le {α : Type*} {l : Filter α} {A : α → X →L[ℂ] X} {v : α → X}
    {v₀ y₀ : X} {K : ℝ} (hK : ∀ᶠ a in l, ‖A a‖ ≤ K) (hA : Tendsto (fun a ↦ A a v₀) l (𝓝 y₀))
    (hv : Tendsto v l (𝓝 v₀)) : Tendsto (fun a ↦ A a (v a)) l (𝓝 y₀) := by
  have h1 : Tendsto (fun a ↦ A a (v a - v₀)) l (𝓝 0) := by
    have hv' : Tendsto (fun a ↦ ‖v a - v₀‖) l (𝓝 0) := tendsto_iff_norm_sub_tendsto_zero.1 hv
    refine squeeze_zero_norm' ?_ (by simpa using hv'.const_mul K)
    filter_upwards [hK] with a ha
    exact (A a).le_of_opNorm_le ha _
  have h2 := h1.add hA
  rw [zero_add] at h2
  refine h2.congr fun a ↦ ?_
  rw [map_sub, sub_add_cancel]

/-- Right derivative of an orbit of a domain vector. -/
theorem hasDerivWithinAt_apply_Ici (S : StronglyContinuousSemigroup X)
    (x : S.generator.domain) {t : ℝ} (ht : 0 ≤ t) :
    HasDerivWithinAt (fun s : ℝ ↦ S (Real.toNNReal s) (x : X))
      (S (Real.toNNReal t) (S.generator x)) (Ici t) t := by
  rw [← hasDerivWithinAt_Ioi_iff_Ici,
    hasDerivWithinAt_iff_tendsto_slope' (s := Ioi t) (lt_irrefl t)]
  have hsub : Tendsto (fun s : ℝ ↦ s - t) (𝓝[>] t) (𝓝[>] 0) := by
    refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
    · have := (tendsto_id (x := 𝓝 t)).sub_const t
      rw [sub_self] at this
      exact this.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with s hs
      exact sub_pos.2 (mem_Ioi.1 hs)
  have hlim := ((S (Real.toNNReal t)).continuous.tendsto _).comp
    ((S.tendsto_diffQuotient_generator x).comp hsub)
  refine hlim.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with s hs
  have hsplit : Real.toNNReal s = Real.toNNReal t + Real.toNNReal (s - t) := by
    rw [← Real.toNNReal_add ht (sub_pos.2 hs).le]
    congr 1
    ring
  simp only [Function.comp_apply, slope_def_module, diffQuotient, map_smul, map_sub]
  rw [hsplit, S.apply_add, ← Complex.ofReal_inv, Complex.coe_smul]

/-- Left derivative of an orbit of a domain vector at a positive time. -/
theorem hasDerivWithinAt_apply_Iio [CompleteSpace X] (S : StronglyContinuousSemigroup X)
    (x : S.generator.domain) {t : ℝ} (ht : 0 < t) :
    HasDerivWithinAt (fun s : ℝ ↦ S (Real.toNNReal s) (x : X))
      (S (Real.toNNReal t) (S.generator x)) (Iio t) t := by
  rw [hasDerivWithinAt_iff_tendsto_slope' (s := Iio t) (lt_irrefl t)]
  have hsub : Tendsto (fun s : ℝ ↦ t - s) (𝓝[<] t) (𝓝[>] 0) := by
    refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
    · have := (tendsto_id (x := 𝓝 t)).const_sub t
      rw [sub_self] at this
      exact this.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with s hs
      exact sub_pos.2 (mem_Iio.1 hs)
  obtain ⟨K, -, hK⟩ := S.exists_norm_operator_le (Real.toNNReal t)
  have hcont : Continuous fun s : ℝ ↦ S (Real.toNNReal s) (S.generator x) :=
    (S.orbit_continuous _).comp continuous_real_toNNReal
  have hlim : Tendsto (fun s : ℝ ↦ S (Real.toNNReal s) (S.diffQuotient (x : X) (t - s)))
      (𝓝[<] t) (𝓝 (S (Real.toNNReal t) (S.generator x))) := by
    refine tendsto_apply_of_norm_le (K := K) ?_ ((hcont.tendsto t).mono_left nhdsWithin_le_nhds)
      ((S.tendsto_diffQuotient_generator x).comp hsub)
    filter_upwards [self_mem_nhdsWithin] with s hs
    exact hK _ (Real.toNNReal_le_toNNReal (le_of_lt hs))
  refine hlim.congr' ?_
  filter_upwards [self_mem_nhdsWithin, mem_nhdsWithin_of_mem_nhds (Ioi_mem_nhds ht)]
    with s hs hs0
  have hs0' : (0 : ℝ) ≤ s := le_of_lt hs0
  have hsplit : Real.toNNReal t = Real.toNNReal s + Real.toNNReal (t - s) := by
    rw [← Real.toNNReal_add hs0' (sub_pos.2 hs).le]
    congr 1
    ring
  simp only [slope_def_module, diffQuotient, map_smul, map_sub]
  rw [hsplit, S.apply_add, ← Complex.ofReal_inv, Complex.coe_smul,
    show s - t = -(t - s) by ring, inv_neg, neg_smul, ← smul_neg, neg_sub]

/-- The orbit `t ↦ S(t) x` of a vector `x` in the domain of the generator is differentiable on
`[0, ∞)`, one-sided at `0`, with derivative `S(t) G x`. -/
theorem hasDerivWithinAt_apply [CompleteSpace X] (S : StronglyContinuousSemigroup X)
    (x : S.generator.domain) {t : ℝ} (ht : 0 ≤ t) :
    HasDerivWithinAt (fun s : ℝ ↦ S (Real.toNNReal s) (x : X))
      (S (Real.toNNReal t) (S.generator x)) (Set.Ici 0) t := by
  rcases ht.eq_or_lt with rfl | ht'
  · exact S.hasDerivWithinAt_apply_Ici x le_rfl
  · have h := (S.hasDerivWithinAt_apply_Iio x ht').union (S.hasDerivWithinAt_apply_Ici x ht)
    rw [Iio_union_Ici, hasDerivWithinAt_univ] at h
    exact h.hasDerivWithinAt

/-!
## Density of the domain
-/

/-- The integrated orbit `∫₀^τ S(s) x ds`, `τ ≥ 0`, lies in the domain of the generator. -/
theorem integral_mem_generator_domain [CompleteSpace X] (S : StronglyContinuousSemigroup X)
    (x : X) {τ : ℝ} (hτ : 0 ≤ τ) :
    (∫ s in (0 : ℝ)..τ, S (Real.toNNReal s) x) ∈ S.generator.domain := by
  set f : ℝ → X := fun s ↦ S (Real.toNNReal s) x with hf_def
  have hf : Continuous f := (S.orbit_continuous x).comp continuous_real_toNNReal
  set F : ℝ → X := fun τ ↦ ∫ s in (0 : ℝ)..τ, f s with hF_def
  have hF : ∀ τ, HasDerivAt F (f τ) τ := fun τ ↦ (hf.integral_hasStrictDerivAt 0 τ).hasDerivAt
  have hshift : ∀ h : ℝ, 0 ≤ h → S (Real.toNNReal h) (F τ) = F (τ + h) - F h := by
    intro h hh
    rw [hF_def]
    dsimp only
    rw [← (S (Real.toNNReal h)).intervalIntegral_comp_comm (hf.intervalIntegrable 0 τ)]
    have hcongr :
        (∫ s in (0 : ℝ)..τ, S (Real.toNNReal h) (f s)) = ∫ s in (0 : ℝ)..τ, f (s + h) := by
      refine intervalIntegral.integral_congr fun s hs ↦ ?_
      rw [uIcc_of_le hτ] at hs
      simp only [hf_def]
      rw [← S.apply_add, ← Real.toNNReal_add hh hs.1, add_comm]
    rw [hcongr, intervalIntegral.integral_comp_add_right, zero_add,
      intervalIntegral.integral_interval_sub_left (hf.intervalIntegrable _ _)
        (hf.intervalIntegrable _ _)]
  refine ⟨f τ - f 0, ?_⟩
  have hlim := (hF τ).tendsto_slope_zero_right.sub (hF 0).tendsto_slope_zero_right
  refine hlim.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with h hh
  have hF0 : F 0 = 0 := intervalIntegral.integral_same
  simp only [diffQuotient]
  rw [hshift h (le_of_lt hh), ← Complex.ofReal_inv, Complex.coe_smul, ← smul_sub, hF0, zero_add,
    sub_zero]
  congr 1
  abel

/-- The domain of the generator is dense: the averaged orbits `τ⁻¹ ∫₀^τ S(s) x ds` lie in the
domain and converge to `x` as `τ → 0⁺` (Engel–Nagel Theorem II.1.4). -/
theorem dense_generator_domain [CompleteSpace X] (S : StronglyContinuousSemigroup X) :
    Dense (S.generator.domain : Set X) := by
  intro x
  set f : ℝ → X := fun s ↦ S (Real.toNNReal s) x with hf_def
  have hf : Continuous f := (S.orbit_continuous x).comp continuous_real_toNNReal
  have hlim := (hf.integral_hasStrictDerivAt 0 0).hasDerivAt.tendsto_slope_zero_right
  simp only [zero_add, intervalIntegral.integral_same, sub_zero, hf_def, Real.toNNReal_zero,
    S.apply_zero] at hlim
  refine mem_closure_of_tendsto hlim ?_
  filter_upwards [self_mem_nhdsWithin] with τ hτ
  rw [SetLike.mem_coe, ← Complex.coe_smul]
  exact S.generator.domain.smul_mem _ (S.integral_mem_generator_domain x (le_of_lt hτ))

/-!
## Eigenvectors
-/

/-- An eigenvector of the generator, `G x = λ x`, evolves as `S(t) x = e^{tλ} x`. -/
theorem apply_eq_cexp_smul_of_generator_eq_smul [CompleteSpace X]
    (S : StronglyContinuousSemigroup X) (x : S.generator.domain) (lam : ℂ)
    (hx : S.generator x = lam • (x : X)) (t : NNReal) :
    S t (x : X) = Complex.exp (((t : ℝ) : ℂ) * lam) • (x : X) := by
  set φ : ℝ → X := fun s ↦ Complex.exp (-((s : ℂ) * lam)) • S (Real.toNNReal s) (x : X)
  have hc : ∀ s : ℝ, HasDerivAt (fun s : ℝ ↦ Complex.exp (-((s : ℂ) * lam)))
      (Complex.exp (-((s : ℂ) * lam)) * -((1 : ℝ) * lam)) s := fun s ↦
    (((hasDerivAt_id s).ofReal_comp).mul_const lam).neg.cexp
  have hcont : Continuous φ :=
    ((Complex.continuous_ofReal.mul continuous_const).neg.cexp).smul
      ((S.orbit_continuous _).comp continuous_real_toNNReal)
  have hderiv : ∀ s ∈ Ico (0 : ℝ) t, HasDerivWithinAt φ 0 (Ici s) s := by
    intro s hs
    have h : HasDerivWithinAt φ _ (Ici s) s := (hc s).hasDerivWithinAt.smul
      ((S.hasDerivWithinAt_apply x hs.1).mono (Ici_subset_Ici.2 hs.1))
    convert h using 1
    rw [hx, map_smul, smul_smul, ← add_smul, Complex.ofReal_one, one_mul, mul_neg,
      add_neg_cancel, zero_smul]
  have h := constant_of_has_deriv_right_zero hcont.continuousOn hderiv t ⟨t.2, le_rfl⟩
  simp only [φ, Complex.ofReal_zero, zero_mul, neg_zero, Complex.exp_zero, one_smul,
    Real.toNNReal_zero, S.apply_zero, Real.toNNReal_coe] at h
  calc S t (x : X)
      = Complex.exp (((t : ℝ) : ℂ) * lam) •
          (Complex.exp (-(((t : ℝ) : ℂ) * lam)) • S t (x : X)) := by
        rw [smul_smul, ← Complex.exp_add, add_neg_cancel, Complex.exp_zero, one_smul]
    _ = Complex.exp (((t : ℝ) : ℂ) * lam) • (x : X) := by rw [h]

/-!
## A semigroup is determined by its generator
-/

/-- Product rule for a strongly continuous, locally bounded operator family applied to a
differentiable curve: if `‖A r‖ ≤ K` near `s₀`, `r ↦ A r b'` is continuous at `s₀`,
`r ↦ A r (b s₀)` has derivative `a'` and `b` has derivative `b'`, then `r ↦ A r (b r)` has
derivative `A s₀ b' + a'`.  No differentiability of `A` in operator norm is needed. -/
theorem hasDerivWithinAt_operator_apply {A : ℝ → X →L[ℂ] X} {b : ℝ → X} {s : Set ℝ} {s₀ : ℝ}
    {a' b' : X} {K : ℝ} (hK : ∀ᶠ r in 𝓝[s] s₀, ‖A r‖ ≤ K)
    (hA : Tendsto (fun r ↦ A r b') (𝓝[s] s₀) (𝓝 (A s₀ b')))
    (hAb : HasDerivWithinAt (fun r ↦ A r (b s₀)) a' s s₀) (hb : HasDerivWithinAt b b' s s₀) :
    HasDerivWithinAt (fun r ↦ A r (b r)) (A s₀ b' + a') s s₀ := by
  rw [hasDerivWithinAt_iff_tendsto_slope] at hAb hb ⊢
  have h1 : Tendsto (fun r ↦ A r (slope b s₀ r)) (𝓝[s \ {s₀}] s₀) (𝓝 (A s₀ b')) :=
    tendsto_apply_of_norm_le (hK.filter_mono (nhdsWithin_mono _ sdiff_subset))
      (hA.mono_left (nhdsWithin_mono _ sdiff_subset)) hb
  refine (h1.add hAb).congr fun r ↦ ?_
  simp only [slope_def_module]
  rw [ContinuousLinearMap.map_smul_of_tower, map_sub, ← smul_add]
  congr 1
  abel

/-- A `C₀`-semigroup on a Banach space is determined by its generator (Engel–Nagel
Theorem II.1.4).  For `x` in the common domain and `t ≥ 0`, the curve `s ↦ T(t − s) S(s) x` has
right derivative `T(t − s) G S(s) x − T(t − s) G S(s) x = 0` on `[0, t)`, so `S(t) x = T(t) x`;
the domain is dense. -/
theorem ext_of_generator_eq [CompleteSpace X] {S T : StronglyContinuousSemigroup X}
    (h : S.generator = T.generator) : S = T := by
  obtain ⟨hdom, hval⟩ := LinearPMap.ext_iff.1 h
  have key : ∀ (t : NNReal) (x : S.generator.domain), S t (x : X) = T t (x : X) := by
    intro t x
    set τ : ℝ := (t : ℝ)
    set φ : ℝ → X := fun r ↦ T (Real.toNNReal (τ - r)) (S (Real.toNNReal r) (x : X))
    obtain ⟨K, -, hK⟩ := T.exists_norm_operator_le t
    have hKr : ∀ r : ℝ, 0 ≤ r → ‖T (Real.toNNReal (τ - r))‖ ≤ K := fun r hr ↦
      hK _ (Real.toNNReal_le_iff_le_coe.2 (by simp only [τ]; linarith))
    have hTc : ∀ y : X, Continuous fun r : ℝ ↦ T (Real.toNNReal (τ - r)) y := fun y ↦
      (T.orbit_continuous y).comp (continuous_real_toNNReal.comp (continuous_const.sub
        continuous_id))
    have hSc : Continuous fun r : ℝ ↦ S (Real.toNNReal r) (x : X) :=
      (S.orbit_continuous _).comp continuous_real_toNNReal
    have hcont : ContinuousOn φ (Icc 0 τ) := fun r₀ _ ↦
      tendsto_apply_of_norm_le (K := K)
        (eventually_nhdsWithin_of_forall fun r hr ↦ hKr r hr.1)
        (((hTc _).tendsto r₀).mono_left nhdsWithin_le_nhds)
        ((hSc.tendsto r₀).mono_left nhdsWithin_le_nhds)
    have hderiv : ∀ r ∈ Ico (0 : ℝ) τ, HasDerivWithinAt φ 0 (Ici r) r := by
      intro r hr
      obtain ⟨hy, hGy⟩ := S.apply_mem_generator_domain (Real.toNNReal r) x
      set y : X := S (Real.toNNReal r) (x : X)
      have hyT : y ∈ T.generator.domain := hdom ▸ hy
      have hGT : T.generator ⟨y, hyT⟩ = S (Real.toNNReal r) (S.generator x) :=
        (hval (hf := hy) (hg := hyT)).symm.trans hGy
      have hpos : 0 < τ - r := sub_pos.2 hr.2
      have hd : HasDerivAt (fun p : ℝ ↦ T (Real.toNNReal p) y)
          (T (Real.toNNReal (τ - r)) (T.generator ⟨y, hyT⟩)) (τ - r) :=
        (T.hasDerivWithinAt_apply ⟨y, hyT⟩ hpos.le).hasDerivAt (Ici_mem_nhds hpos)
      have hAb : HasDerivWithinAt (fun q : ℝ ↦ T (Real.toNNReal (τ - q)) y)
          ((-1 : ℝ) • T (Real.toNNReal (τ - r)) (T.generator ⟨y, hyT⟩)) (Ici r) r := by
        have := hd.scomp r ((hasDerivAt_id r).const_sub τ)
        exact this.hasDerivWithinAt
      have hb := (S.hasDerivWithinAt_apply x hr.1).mono (Ici_subset_Ici.2 hr.1)
      have hprod := hasDerivWithinAt_operator_apply (s := Ici r) (K := K)
        (eventually_nhdsWithin_of_forall fun q hq ↦ hKr q (hr.1.trans hq))
        (((hTc _).tendsto r).mono_left nhdsWithin_le_nhds) hAb hb
      rw [hGT, neg_one_smul, add_neg_cancel] at hprod
      exact hprod
    have hφ := constant_of_has_deriv_right_zero hcont hderiv τ ⟨t.2, le_rfl⟩
    simp only [φ, τ, sub_self, Real.toNNReal_zero, T.apply_zero, Real.toNNReal_coe, sub_zero,
      S.apply_zero] at hφ
    exact hφ
  ext t : 1
  refine DFunLike.coe_injective ?_
  refine Continuous.ext_on S.dense_generator_domain (S t).continuous (T t).continuous ?_
  intro x hx
  exact key t ⟨x, hx⟩

/-!
## Restriction to a closed invariant subspace
-/

/-- The generator of the restriction of `S` to a closed invariant subspace `W` has domain
`D(G) ∩ W`: a vector of `W` lies in its domain if and only if it lies in the domain of the
generator of `S`. -/
theorem mem_generator_restrict_domain_iff (S : StronglyContinuousSemigroup X)
    (W : Submodule ℂ X) (hW : IsClosed (W : Set X))
    (hinv : ∀ (t : NNReal) (x : X), x ∈ W → S t x ∈ W) (x : W) :
    x ∈ (S.restrict W hinv).generator.domain ↔ (x : X) ∈ S.generator.domain := by
  constructor
  · rintro ⟨y, hy⟩
    exact ⟨y, tendsto_subtype_rng.1 hy⟩
  · rintro ⟨y, hy⟩
    have hyW : y ∈ W :=
      hW.mem_of_tendsto hy (Eventually.of_forall fun h ↦ ((S.restrict W hinv).diffQuotient x h).2)
    exact ⟨⟨y, hyW⟩, tendsto_subtype_rng.2 hy⟩

/-- On its domain the generator of the restriction of `S` to an invariant subspace `W` agrees
with the generator of `S`: it is the part of the generator in `W`. -/
theorem generator_restrict_apply (S : StronglyContinuousSemigroup X)
    (W : Submodule ℂ X) (hinv : ∀ (t : NNReal) (x : X), x ∈ W → S t x ∈ W)
    (x : (S.restrict W hinv).generator.domain) (hx : ((x : W) : X) ∈ S.generator.domain) :
    (((S.restrict W hinv).generator x : W) : X) = S.generator ⟨((x : W) : X), hx⟩ :=
  ((S.generator_eq_iff ⟨_, hx⟩ _).2
    (tendsto_subtype_rng.1 ((S.restrict W hinv).tendsto_diffQuotient_generator x))).symm

end StronglyContinuousSemigroup


-- Modified for Lean Pool.

module

public import LeanPool.FastDynamo.Dynamics.HilleYosida.Realization
public import LeanPool.FastDynamo.Dynamics.SemigroupGenerator
public import LeanPool.FastDynamo.Operator.UnboundedResolvent

/-!
# The generator of the Hille–Yosida semigroup

`HilleYosidaRay.semigroup` builds, from a resolvent ray of a domain operator
`A : DomainOperator X D` and the density of its domain, a `C₀`-semigroup `S` on `X`.  This module
identifies the generator of `S` (`StronglyContinuousSemigroup.generator`, Engel–Nagel
Definition II.1.2) with `A`, read as the partially defined map `A.toLinearPMap` with domain the
range of the embedding: `HilleYosidaRay.generator_semigroup`.  This is the generation half of the
Hille–Yosida theorem (Engel–Nagel Theorem II.3.5) in the form used by the paper (Lemma A.1,
`lem:semigroup-spectral-growth`): the semigroup is generated by `A`, not merely realized by it.

* `A ⊆ G`: for `d : D` the right derivative at `0` of `t ↦ S t (ι d)` is `A d`
  (`hasDerivWithinAt_semigroup_embedding`).
* `G ⊆ A`: for `x` in the domain of `G` and real `r > M`, the vector
  `w = R(r) (r x − G x) − x` lies in the domain of `G` and satisfies `G w = r w`, so
  `S t w = e^{rt} w` (`apply_eq_cexp_smul_of_generator_eq_smul`); the bound `‖S t‖ ≤ e^{Mt}` forces
  `w = 0`, i.e. `x = R(r) (r x − G x)` lies in the range of the embedding.
-/

@[expose] public section

namespace FastDynamo

noncomputable section

open Filter Topology Set

universe u v

variable {X : Type u} {D : Type v}
  [NormedAddCommGroup X] [NormedSpace ℂ X] [CompleteSpace X]
  [NormedAddCommGroup D] [NormedSpace ℂ D]
  {A : DomainOperator X D}

/-- The right difference quotient at `0` of the generated semigroup on the embedding of a domain
vector `d` converges to `A d`. -/
theorem HilleYosidaRay.tendsto_diffQuotient_semigroup_embedding {M : ℝ}
    (hy : HilleYosidaRay A M) (hdense : DenseRange A.embedding) (d : D) :
    Tendsto ((hy.semigroup hdense).diffQuotient (A.embedding d)) (𝓝[>] (0 : ℝ))
      (𝓝 (A.op d)) := by
  have h := hasDerivWithinAt_semigroup_embedding hy hdense d le_rfl
  rw [← hasDerivWithinAt_Ioi_iff_Ici,
    hasDerivWithinAt_iff_tendsto_slope' (s := Ioi 0) (lt_irrefl 0)] at h
  rw [Real.toNNReal_zero, (hy.semigroup hdense).apply_zero] at h
  refine h.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with h _
  simp only [slope_def_module, StronglyContinuousSemigroup.diffQuotient, sub_zero,
    Real.toNNReal_zero, (hy.semigroup hdense).apply_zero]
  rw [← Complex.ofReal_inv, Complex.coe_smul]

/-- **The generator of the Hille–Yosida semigroup is the domain operator.**  The semigroup built
by `HilleYosidaRay.semigroup` from a resolvent ray of `A` and the density of its domain has
generator `A`, with domain exactly the range of the embedding `D → X` (Engel–Nagel
Theorem II.3.5, generation half). -/
theorem HilleYosidaRay.generator_semigroup {M : ℝ} (hy : HilleYosidaRay A M)
    (hdense : DenseRange A.embedding) :
    (hy.semigroup hdense).generator = A.toLinearPMap := by
  set S := hy.semigroup hdense
  -- every embedded domain vector lies in the domain of the generator, with value `A d`
  have hemb : ∀ d : D, ∃ h : A.embedding d ∈ S.generator.domain,
      S.generator ⟨A.embedding d, h⟩ = A.op d := fun d ↦
    ⟨⟨_, hy.tendsto_diffQuotient_semigroup_embedding hdense d⟩,
      (S.generator_eq_iff _ _).2 (hy.tendsto_diffQuotient_semigroup_embedding hdense d)⟩
  -- every vector of the domain of the generator is an embedded domain vector
  have hdom : ∀ x : S.generator.domain, ∃ d : D, A.embedding d = x := by
    intro x
    set r : ℝ := max M 0 + 1
    have hr : M < r := by
      have := le_max_left M 0
      simp only [r]
      linarith
    set d : D := hy.resolvent.inv (r : ℂ) ((r : ℂ) • (x : X) - S.generator x)
    have hpencil : (r : ℂ) • A.embedding d - A.op d = (r : ℂ) • (x : X) - S.generator x := by
      have := DFunLike.congr_fun (hy.resolvent.right_inv (r : ℂ) (hy.mem_ofReal r hr))
        ((r : ℂ) • (x : X) - S.generator x)
      simpa [DomainOperator.pencil, d] using this
    obtain ⟨hd, hGd⟩ := hemb d
    set w : S.generator.domain := ⟨A.embedding d, hd⟩ - x
    have hw : S.generator w = (r : ℂ) • (w : X) := by
      rw [LinearPMap.map_sub, hGd]
      simp only [w, Submodule.coe_sub, smul_sub]
      linear_combination (norm := module) -hpencil
    have hexp := S.apply_eq_cexp_smul_of_generator_eq_smul w (r : ℂ) hw 1
    have hbound := hy.norm_semigroup_le hdense 1
    rw [NNReal.coe_one, mul_one] at hbound
    have hnorm : ‖S 1 (w : X)‖ ≤ Real.exp M * ‖(w : X)‖ :=
      ((S 1).le_opNorm _).trans (mul_le_mul_of_nonneg_right hbound (norm_nonneg _))
    have heq : ‖S 1 (w : X)‖ = Real.exp r * ‖(w : X)‖ := by
      rw [hexp, norm_smul, Complex.norm_exp]
      simp
    have hw0 : (w : X) = 0 := by
      by_contra hne
      have hpos : 0 < ‖(w : X)‖ := norm_pos_iff.2 hne
      have h2 : Real.exp M < Real.exp r := Real.exp_lt_exp.2 hr
      nlinarith
    refine ⟨d, ?_⟩
    have : (w : X) = A.embedding d - x := rfl
    rw [this, sub_eq_zero] at hw0
    exact hw0
  refine LinearPMap.ext ?_ ?_
  · ext x
    rw [DomainOperator.mem_toLinearPMap_domain_iff]
    constructor
    · intro hx
      exact hdom ⟨x, hx⟩
    · rintro ⟨d, rfl⟩
      exact (hemb d).1
  · intro x hx hx'
    obtain ⟨d, hd⟩ := hdom ⟨x, hx⟩
    rw [DomainOperator.toLinearPMap_apply_of_embedding_eq A hx' hd]
    obtain ⟨_, hGd⟩ := hemb d
    subst hd
    exact hGd

end

end FastDynamo

module

public import LeanPool.FastDynamo.Dynamics.HilleYosida.Convergence
public import LeanPool.FastDynamo.Dynamics.GrowthBound

/-!
# The Hille–Yosida limit as a bundled strongly continuous semigroup

`Convergence.lean` produced the operator family `hy.semigroupOperator hdense : ℝ → X →L[ℂ] X`
together with everything the semigroup interface of
`FastDynamo/Dynamics/StronglyContinuousSemigroup.lean` asks for: the value
`ContinuousLinearMap.id ℂ X` at time `0` (`semigroupOperator_zero`), the additive law on
nonnegative times (`semigroupOperator_add`), and strong continuity on `[0, ∞)`
(`continuousOn_semigroupOperator_apply`).  This module performs the one remaining step,
which is bookkeeping rather than analysis: the interface indexes time by `ℝ≥0`, while every
analytic statement of this directory lives on `ℝ`.  The bundled
semigroup is therefore

```
operator t := hy.semigroupOperator hdense (t : ℝ)
```

and the three laws are the three theorems above, read through `NNReal.coe_zero`,
`NNReal.coe_add` and `NNReal.continuous_coe`; no time is ever negative because
`NNReal.coe_nonneg` supplies the hypothesis `0 ≤ t` each of them carries.

Two consequences are recorded on top of the definition.

* `HilleYosidaRay.norm_semigroup_le`: the Hille–Yosida constant `M` bounds the exponential
  growth of the semigroup, `‖S t‖ ≤ exp (M t)`.  This is `norm_semigroupOperator_le`.
* `HilleYosidaRay.growthBound_le`: hence `S.growthBound ≤ M` in `EReal`, by
  `StronglyContinuousSemigroup.growthBound_le_of_norm_le` at `C = 1`.  This is the upper
  half of the growth-bound sandwich completed in `Generation.lean`; the matching lower half
  `Re λ ≤ S.growthBound` for an eigenpair of `A` needs the realization of `Realization.lean`
  and is proved there and in `Generation.lean`.

Namespaces follow the other modules of the directory: `HilleYosidaRay.semigroup` is a
definition in the `HilleYosidaRay` namespace so that `hy.semigroup hdense` is dot notation,
and so are the theorems that are naturally read as statements about it.
-/

@[expose] public section

namespace FastDynamo

universe u v

variable {X : Type u} {D : Type v}
  [NormedAddCommGroup X] [NormedSpace ℂ X] [CompleteSpace X]
  [NormedAddCommGroup D] [NormedSpace ℂ D]
  {A : DomainOperator X D}

/--
The strongly continuous semigroup generated by a Hille–Yosida ray on a domain operator with
dense range.

The evolution operator at a nonnegative time `t` is the limit
`hy.semigroupOperator hdense (t : ℝ)` of the Yosida approximant semigroups
`exp (t A_r)`, and the three fields are `semigroupOperator_zero`, `semigroupOperator_add`
and `continuousOn_semigroupOperator_apply` of `Convergence.lean`, each applied at a
nonnegative real time supplied by `NNReal.coe_nonneg`.
-/
noncomputable def HilleYosidaRay.semigroup {M : ℝ} (hy : HilleYosidaRay A M)
    (hdense : DenseRange A.embedding) : StronglyContinuousSemigroup X where
  operator t := hy.semigroupOperator hdense (t : ℝ)
  operator_zero' := by
    rw [NNReal.coe_zero]
    exact semigroupOperator_zero hy hdense
  operator_add' s t := by
    rw [NNReal.coe_add]
    exact semigroupOperator_add hy hdense s.coe_nonneg t.coe_nonneg
  strong_continuous' x :=
    (continuousOn_semigroupOperator_apply hy hdense x).comp_continuous
      NNReal.continuous_coe fun t ↦ t.coe_nonneg

/-- The evolution operator of `HilleYosidaRay.semigroup` is the real-time family of
`Convergence.lean`, read at the coerced time.  This is definitional. -/
theorem HilleYosidaRay.semigroup_operator {M : ℝ} (hy : HilleYosidaRay A M)
    (hdense : DenseRange A.embedding) (t : NNReal) :
    (hy.semigroup hdense).operator t = hy.semigroupOperator hdense (t : ℝ) :=
  rfl

/-- The evolution operator at a nonnegative *real* time, the form every analytic statement
about the semigroup uses.  The coercion `Real.toNNReal` is undone by `Real.coe_toNNReal`. -/
theorem HilleYosidaRay.semigroup_toNNReal {M : ℝ} (hy : HilleYosidaRay A M)
    (hdense : DenseRange A.embedding) {t : ℝ} (ht : 0 ≤ t) :
    (hy.semigroup hdense).operator (Real.toNNReal t) = hy.semigroupOperator hdense t := by
  rw [hy.semigroup_operator hdense, Real.coe_toNNReal t ht]

/-- Pointwise form of `HilleYosidaRay.semigroup_operator`: the semigroup orbit of `x` is the
pointwise limit `HilleYosidaRay.limitFun` of the approximant orbits. -/
theorem HilleYosidaRay.semigroup_apply {M : ℝ} (hy : HilleYosidaRay A M)
    (hdense : DenseRange A.embedding) (t : NNReal) (x : X) :
    (hy.semigroup hdense) t x = hy.limitFun (t : ℝ) x :=
  semigroupOperator_apply hy hdense t.coe_nonneg x

/-- The defining approximation property, in the bundled form: the Yosida approximant
semigroups converge strongly to the bundled semigroup at every nonnegative time. -/
theorem tendsto_semigroup_apply {M : ℝ} (hy : HilleYosidaRay A M)
    (hdense : DenseRange A.embedding) {t : ℝ} (ht : 0 ≤ t) (x : X) :
    Filter.Tendsto (fun r : ℝ ↦ hy.approx r t x) Filter.atTop
      (nhds ((hy.semigroup hdense) (Real.toNNReal t) x)) := by
  rw [show (hy.semigroup hdense) (Real.toNNReal t) x = hy.semigroupOperator hdense t x from
    congrArg (fun T : X →L[ℂ] X ↦ T x) (hy.semigroup_toNNReal hdense ht)]
  exact tendsto_semigroupOperator hy hdense ht x

/--
The growth bound of the generated semigroup in exponential form: `‖S t‖ ≤ exp (M t)` for
every nonnegative time, with `M` the constant of the Hille–Yosida hypothesis.  This is
`norm_semigroupOperator_le` of `Convergence.lean`.
-/
theorem HilleYosidaRay.norm_semigroup_le {M : ℝ} (hy : HilleYosidaRay A M)
    (hdense : DenseRange A.embedding) (t : NNReal) :
    ‖(hy.semigroup hdense).operator t‖ ≤ Real.exp (M * (t : ℝ)) :=
  norm_semigroupOperator_le hy hdense t.coe_nonneg

/--
The Hille–Yosida constant bounds the growth bound: `S.growthBound ≤ M` in `EReal`.

This is `StronglyContinuousSemigroup.growthBound_le_of_norm_le` at `C = 1` applied to
`HilleYosidaRay.norm_semigroup_le`.  Combined with
`DomainOperatorSemigroupRealization.re_le_growthBound_of_eigenpair` it gives the
sandwich `Re λ ≤ S.growthBound ≤ M` assembled in `Generation.lean`.
-/
theorem HilleYosidaRay.growthBound_le {M : ℝ} (hy : HilleYosidaRay A M)
    (hdense : DenseRange A.embedding) :
    (hy.semigroup hdense).growthBound ≤ (M : EReal) :=
  (hy.semigroup hdense).growthBound_le_of_norm_le one_pos fun t ↦ by
    rw [one_mul]
    exact hy.norm_semigroup_le hdense t

end FastDynamo

module

public import LeanPool.FastDynamo.Operator.FixedSector
public import Mathlib.Analysis.Complex.RealDeriv

/-!
# Explicit evolution generated by an eigenpair

This module records the elementary Banach-valued differentiation used at the
end of the paper.  It is independent of semigroup generation: an eigenpair of
a domain operator gives an explicit strong solution by scalar exponentiation.
-/

@[expose] public section

namespace FastDynamo

noncomputable section

universe u v

/-- A fixed continuous real-linear map may be applied to a Banach-valued
real-time derivative. -/
theorem hasDerivAt_continuousLinearMap_comp
    {E : Type u} {F : Type v}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    {f : ℝ → E} {f' : E} {t : ℝ}
    (L : E →L[ℝ] F) (hf : HasDerivAt f f' t) :
    HasDerivAt (fun s : ℝ => L (f s)) (L f') t := by
  have h := (L.hasFDerivAt.comp t hf.hasFDerivAt).hasDerivAt
  convert h using 1
  · rfl
  · simp [ContinuousLinearMap.comp_apply]

namespace DomainOperator

variable {X : Type u} {D : Type v}
  [NormedAddCommGroup X] [NormedSpace ℂ X]
  [NormedAddCommGroup D] [NormedSpace ℂ D]

/-- A domain-valued curve is a strong solution when its ambient embedding is
differentiable and its derivative equals the operator action.  The time
variable is real even though the state space is complex. -/
def IsStrongSolution (A : DomainOperator X D) (trajectory : ℝ → D) : Prop :=
  ∀ t : ℝ,
    HasDerivAt (fun s : ℝ => A.embedding (trajectory s))
      (A.op (trajectory t)) t

/-- Domain-valued exponential trajectory generated by a vector and a complex
growth rate. -/
def eigenTrajectory (_A : DomainOperator X D)
    (eigenvalue : ℂ) (B : D) (t : ℝ) : D :=
  Complex.exp ((t : ℂ) * eigenvalue) • B

/-- Real-time derivative of a complex exponential. -/
theorem hasDerivAt_complexExp_mul (eigenvalue : ℂ) (t : ℝ) :
    HasDerivAt (fun s : ℝ => Complex.exp ((s : ℂ) * eigenvalue))
      (eigenvalue * Complex.exp ((t : ℂ) * eigenvalue)) t := by
  have hcomplex :
      HasDerivAt (fun z : ℂ => Complex.exp (z * eigenvalue))
        (Complex.exp ((t : ℂ) * eigenvalue) * eigenvalue) (t : ℂ) := by
    simpa only [id_eq, one_mul] using
      ((hasDerivAt_id (x := (t : ℂ))).mul_const eigenvalue).cexp
  simpa [mul_comm] using hcomplex.comp_ofReal

/-- The embedded exponential curve has the expected Banach-valued
derivative. -/
theorem hasDerivAt_embedding_eigenTrajectory
    (A : DomainOperator X D) (eigenvalue : ℂ) (B : D) (t : ℝ) :
    HasDerivAt (fun s : ℝ => A.embedding (A.eigenTrajectory eigenvalue B s))
      (eigenvalue •
        A.embedding (A.eigenTrajectory eigenvalue B t)) t := by
  change HasDerivAt
    (fun s : ℝ =>
      A.embedding (Complex.exp ((s : ℂ) * eigenvalue) • B))
    (eigenvalue •
      A.embedding (Complex.exp ((t : ℂ) * eigenvalue) • B)) t
  simpa only [map_smul, smul_smul, mul_comm, mul_left_comm, mul_assoc] using
    (hasDerivAt_complexExp_mul eigenvalue t).smul_const (A.embedding B)

/-- Every eigenpair yields an explicit strong solution, without invoking a
semigroup or a uniqueness theorem. -/
theorem isStrongSolution_eigenTrajectory
    (A : DomainOperator X D) (eigenvalue : ℂ) (B : D)
    (h : A.IsEigenpair eigenvalue B) :
    A.IsStrongSolution (A.eigenTrajectory eigenvalue B) := by
  intro t
  have hderiv :=
    hasDerivAt_embedding_eigenTrajectory A eigenvalue B t
  convert hderiv using 1
  change A.op (Complex.exp ((t : ℂ) * eigenvalue) • B) =
    eigenvalue •
      A.embedding (Complex.exp ((t : ℂ) * eigenvalue) • B)
  rw [map_smul, h.2, map_smul]
  simp only [smul_smul]
  module

end DomainOperator

end

end FastDynamo

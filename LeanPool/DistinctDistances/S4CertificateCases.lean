/-!
# The cases of the `1/40` certificate

Generated by `scripts/gen_constant_gain_1_40_lean.py`. Do not edit. In each case
`Y_k ≤ yMean ≤ Y_{k+1}` (`k < 60`), the accepted certificate contradicts the configuration.
-/

@[expose] public section

namespace Esgk.S4

/-- No configuration of Theorem S4 has its mean radial excess in a case of the certificate. -/
theorem false_of_case {n : ℕ} (S : Setting n) (hch : params.ChordsHold S) (k : Nat)
    (hk : k < 60) (hlo : ((caseY.get k : ℚ) : ℝ) ≤ S.ybar)
    (hhi : S.ybar ≤ ((caseY.get (k + 1) : ℚ) : ℝ)) : False := by

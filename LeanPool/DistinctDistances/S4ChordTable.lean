/-- The radius-cell table, from `r = 487171/4000000` to `r = 2`. -/
noncomputable def chordCells : ChordCells :=
  chordCells01 ++ (chordCells02 ++ (chordCells03 ++ (chordCells04)))

/-- The kernel check of the table, from the checks of its segments. -/
theorem chordCells_check : cellsCheck 16000000 64000000000000 1948684 32000000 chordCells = true :=
  cellsCheck_append chordCells01_check
    (cellsCheck_append chordCells02_check
    (cellsCheck_append chordCells03_check
    (chordCells04_check)))

/-- The check of one chord condition `x = (lo, hi, T)` with codes `y = (A, B, C)` against the
table: `A/Q ≤ lo`, `hi ≤ B/Q`, `C/QT ≤ T`, `0 ≤ hi`, the table starts at or below `A`, and the
cover check. -/
noncomputable def chordCondCheck (x : ℚ × ℚ × ℚ) (y : ℕ × ℕ × ℕ) : Bool :=
  decide (mkRat (y.1 : ℤ) 16000000 ≤ x.1) && decide (x.2.1 ≤ mkRat (y.2.1 : ℤ) 16000000) &&
    decide (mkRat (y.2.2 : ℤ) 64000000000000 ≤ x.2.2) && decide (0 ≤ x.2.1) &&
    Nat.ble 1948684 y.1 && coverCheck y.1 y.2.1 y.2.2 1948684 chordCells

/-- The check of the chord condition of index `k`. -/
noncomputable def chordCondOK (k : ℕ) : Bool :=
  chordCondCheck (chordConds.get k) (chordCondCodes.get k)

/-- The kernel check of the chord conditions `0 ≤ k < 91` against the table. -/
theorem chordCondOK_check_1 : allRange chordCondOK 0 91 = true := by
  decide +kernel


/-- The kernel check of the chord conditions `91 ≤ k < 182` against the table. -/
theorem chordCondOK_check_2 : allRange chordCondOK 91 91 = true := by
  decide +kernel


/-- The kernel check of the chord conditions `182 ≤ k < 271` against the table. -/
theorem chordCondOK_check_3 : allRange chordCondOK 182 89 = true := by
  decide +kernel

/-- The check of all chord conditions, from the checks of the chunks. -/
theorem chordCondOK_check : allRange chordCondOK 0 nchord = true :=
  allRange_append (a := 0) (m₁ := 91) (m₂ := 180) chordCondOK_check_1
    (allRange_append (a := 91) (m₁ := 91) (m₂ := 89) chordCondOK_check_2
    (chordCondOK_check_3))

/-- **The chord conditions of the certificate.** For every configuration of the contradiction
argument and every `k < nchord`, with `(lo, hi, T) = chordConds.get k`, every saturated
incidence of radius `r` with `lo²ρ² < r² ≤ hi²ρ²` has two of its points at squared distance at
most `Tρ²` (`Setting.ChordHolds`). -/
theorem chordConds_hold {n : ℕ} (S : Setting n) :
    ∀ k < nchord, S.ChordHolds (chordConds.get k).1 (chordConds.get k).2.1
      (chordConds.get k).2.2 := by
  intro k hk
  have h := allRange_spec chordCondOK_check k (Nat.zero_le k) (by rw [Nat.zero_add]; exact hk)
  simp only [chordCondOK, chordCondCheck, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨⟨hA, hB⟩, hC⟩, hhi⟩, hc₀⟩, hcov⟩ := h
  exact S.chordHolds_of_cover chordCells chordCells_check hcov (Nat.le_of_ble_eq_true hc₀)
    hA hB hC hhi

end Esgk.S4

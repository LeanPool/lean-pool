/-!
# Chord conditions from a table of radius cells

The chord side conditions `C((lo, hi], √T)` of `scripts/verify_constant_gain_1_40.py` (the
`Chords.holds_on` checks of the `P` rows) are proved from one table of radius cells. The
table is generated by `scripts/emit_constant_gain_1_40_chords.py` into the modules
`Esgk.S4ChordTableNN` and is used by `Esgk.S4ChordTable`.

* A cell list (`ChordCells`) holds entries `(c₁, t′, t)` of natural codes with scales `Q`,
  `QT`: the cell of an entry is the radius interval `[r₀, r₁]` with `r₁ = c₁/Q`, where `r₀` is
  the end of the previous entry (or the start of the list), and `t` is a `ChordBoxTree` of the
  box `[sBar, 1] × [r₀, r₁]` with the squared bound `T′ = t′/QT`.
* `cellsCheck Q QT c₀ e cells` checks every tree (`ChordBoxTree.check`) and that the last cell
  ends at the code `e`; it splits over `++` (`cellsCheck_append`), so the table is checked in
  segments.
* `coverCheck A B C c₀ cells` checks, for a condition `(lo, hi, T)` with codes `A/Q ≤ lo`,
  `hi ≤ B/Q`, `C/QT ≤ T`, that the cells reach `B` and that every cell meeting `(A, B]` has
  `t′ ≤ C`. It compares natural numbers only, so it is a short kernel computation.
* `allRange f a m` checks `f k` for `a ≤ k < a + m`, and splits over `m₁ + m₂`.
* `exists_dist_sq_le_of_cover` is the chord condition for an apex and three equidistant points
  of the annulus, and `Setting.chordHolds_of_cover` is its incidence form `Setting.ChordHolds`.
* `s4_chordcells% "…"` elaborates the cell list from a string (one cell per line).

The soundness of the trees is `ChordBoxTree.exists_dist_sq_le_of_check` (Lemma C′ of
`docs/results/explicit-constant-gain-5-239-2026-10-20.md`, §2).
-/

@[expose] public section

namespace Esgk.S4

open Lean Elab Term Meta

/-- A list of radius cells: entries `(c₁, t′, tree)`, each cell starting where the previous one
ends. With the scales `Q` and `QT` of a table, the cell ends at `r₁ = c₁ / Q` and has the
squared bound `T′ = t′ / QT`. -/
abbrev ChordCells : Type := List (ℕ × ℕ × ChordBoxTree)

/-- The check of a cell list with scales `Q`, `QT`, started at the code `c`: the tree of every
cell `[r₀, r₁]` passes `ChordBoxTree.check sig T′` on the box `[sBar, 1] × [r₀, r₁]`, and the last
cell ends at the code `e`. -/
def cellsCheck (Q QT : ℕ) : ℕ → ℕ → ChordCells → Bool
  | c, e, [] => Nat.beq c e
  | c, e, (c', t', t) :: rest =>
      t.check sig (mkRat t' QT) sig 1 (mkRat c Q) (mkRat c' Q) && cellsCheck Q QT c' e rest

/-- The check of a concatenation of two cell lists from the checks of the parts. -/
theorem cellsCheck_append {Q QT c m e : ℕ} {l₁ l₂ : ChordCells}
    (h₁ : cellsCheck Q QT c m l₁ = true) (h₂ : cellsCheck Q QT m e l₂ = true) :
    cellsCheck Q QT c e (l₁ ++ l₂) = true := by
  induction l₁ generalizing c with
  | nil =>
    have : c = m := Nat.eq_of_beq_eq_true h₁
    subst this
    exact h₂
  | cons x rest ih =>
    obtain ⟨c', t', t⟩ := x
    simp only [cellsCheck, Bool.and_eq_true] at h₁
    simp only [List.cons_append, cellsCheck, Bool.and_eq_true]
    exact ⟨h₁.1, ih h₁.2⟩

/-- The cover check of a chord condition with the codes `A`, `B`, `C` (`lo ≥ A/Q`, `hi ≤ B/Q`,
`T ≥ C/QT`) on a cell list started at the code `c`: the cells reach `B`, and every cell before
that whose end exceeds `A` has `t′ ≤ C`. It compares natural numbers only. -/
def coverCheck (A B C : ℕ) : ℕ → ChordCells → Bool
  | c, [] => Nat.ble B c
  | c, (c', t', _) :: rest =>
      Nat.ble B c || ((Nat.ble c' A || Nat.ble t' C) && coverCheck A B C c' rest)

/-- The check `f k = true` for `a ≤ k < a + m`. -/
def allRange (f : ℕ → Bool) : ℕ → ℕ → Bool
  | _, 0 => true
  | a, m + 1 => f a && allRange f (a + 1) m

theorem allRange_append {f : ℕ → Bool} {a m₁ m₂ : ℕ} (h₁ : allRange f a m₁ = true)
    (h₂ : allRange f (a + m₁) m₂ = true) : allRange f a (m₁ + m₂) = true := by
  induction m₁ generalizing a with
  | zero => simpa using h₂
  | succ m ih =>
    simp only [allRange, Bool.and_eq_true] at h₁
    rw [show m + 1 + m₂ = (m + m₂) + 1 by omega]
    simp only [allRange, Bool.and_eq_true]
    exact ⟨h₁.1, ih h₁.2 (by rw [show a + 1 + m = a + (m + 1) by omega]; exact h₂)⟩

theorem allRange_spec {f : ℕ → Bool} {a m : ℕ} (h : allRange f a m = true) :
    ∀ k, a ≤ k → k < a + m → f k = true := by
  induction m generalizing a with
  | zero => intro k h1 h2; omega
  | succ m ih =>
    simp only [allRange, Bool.and_eq_true] at h
    intro k h1 h2
    rcases Nat.eq_or_lt_of_le h1 with h1 | h1
    · rw [← h1]; exact h.1
    · exact ih h.2 k h1 (by omega)

private lemma mkRat_cast (a q : ℕ) : ((mkRat (a : ℤ) q : ℚ) : ℝ) = (a : ℝ) / q := by
  rw [Rat.mkRat_eq_div]; push_cast; rfl

private lemma mkRat_cast_le {a b q : ℕ} (h : a ≤ b) :
    ((mkRat (a : ℤ) q : ℚ) : ℝ) ≤ ((mkRat (b : ℤ) q : ℚ) : ℝ) := by
  rw [mkRat_cast, mkRat_cast]
  exact div_le_div_of_nonneg_right (by exact_mod_cast h) (Nat.cast_nonneg q)

/-- **The chord condition from a cell table**, for an apex and three equidistant points. Let
`cellsCheck Q QT c₀ e cells = true` and `coverCheck A B C c₀ cells = true`, with `c₀ ≤ A`,
`A/Q ≤ lo`, `hi ≤ B/Q`, `C/QT ≤ T` and `0 ≤ hi`. Then for every apex `p` of the annulus
`sBar²ρ² ≤ |p - c|² ≤ ρ²` and three points `q i` of the annulus at a common distance `r` from `p`
with `lo² ρ² < r² ≤ hi² ρ²`, two of the points are at squared distance at most `T ρ²`. -/
theorem exists_dist_sq_le_of_cover (c p : Point) (q : Fin 3 → Point) {ρ : ℝ}
    {lo hi T : ℚ} {Q QT A B C c₀ e : ℕ} (cells : ChordCells)
    (hcells : cellsCheck Q QT c₀ e cells = true) (hcover : coverCheck A B C c₀ cells = true)
    (hc₀ : c₀ ≤ A) (hA : mkRat (A : ℤ) Q ≤ lo) (hB : hi ≤ mkRat (B : ℤ) Q)
    (hC : mkRat (C : ℤ) QT ≤ T) (hhi0 : 0 ≤ hi)
    (hρ : 0 < ρ) (hp : (sig : ℝ) ^ 2 * ρ ^ 2 ≤ dist p c ^ 2) (hp1 : dist p c ^ 2 ≤ ρ ^ 2)
    (hlo : ∀ i, (sig : ℝ) ^ 2 * ρ ^ 2 ≤ dist (q i) c ^ 2) (hhi : ∀ i, dist (q i) c ^ 2 ≤ ρ ^ 2)
    (heq : ∀ i j, dist p (q i) = dist p (q j))
    (hr1 : (lo : ℝ) ^ 2 * ρ ^ 2 < dist p (q 0) ^ 2)
    (hr2 : dist p (q 0) ^ 2 ≤ (hi : ℝ) ^ 2 * ρ ^ 2) :
    ∃ i j : Fin 3, i ≠ j ∧ dist (q i) (q j) ^ 2 ≤ (T : ℝ) * ρ ^ 2 := by
  have hle {u v : ℝ} (hv : 0 ≤ v) (h : u ^ 2 ≤ v ^ 2) : u ≤ v := (abs_le_of_sq_le_sq' h hv).2
  have hpσ : ((sig : ℚ) : ℝ) * ρ ≤ dist p c := hle dist_nonneg (by rw [mul_pow]; exact hp)
  have hpc : dist p c ≤ ((1 : ℚ) : ℝ) * ρ := by
    rw [Rat.cast_one, one_mul]; exact hle hρ.le hp1
  have hplo : (lo : ℝ) * ρ < dist p (q 0) :=
    (abs_lt_of_sq_lt_sq' (by rw [mul_pow]; exact hr1) dist_nonneg).2
  have hhi0' : (0 : ℝ) ≤ hi := by exact_mod_cast hhi0
  have hphi : dist p (q 0) ≤ (hi : ℝ) * ρ :=
    hle (mul_nonneg hhi0' hρ.le) (by rw [mul_pow]; exact hr2)
  have hA' : ((mkRat (A : ℤ) Q : ℚ) : ℝ) ≤ lo := by exact_mod_cast hA
  have hB' : (hi : ℝ) ≤ ((mkRat (B : ℤ) Q : ℚ) : ℝ) := by exact_mod_cast hB
  have hC' : ((mkRat (C : ℤ) QT : ℚ) : ℝ) ≤ T := by exact_mod_cast hC
  have hstart : ((mkRat (c₀ : ℤ) Q : ℚ) : ℝ) * ρ < dist p (q 0) :=
    lt_of_le_of_lt (mul_le_mul_of_nonneg_right ((mkRat_cast_le hc₀).trans hA') hρ.le) hplo
  clear hr1 hr2 hp hp1 hc₀
  -- reaching `B` is impossible before the radius is passed
  have hpast {c' : ℕ} (hBc : B ≤ c') (hc' : ((mkRat (c' : ℤ) Q : ℚ) : ℝ) * ρ < dist p (q 0)) :
      False := by
    have := mul_le_mul_of_nonneg_right (hB'.trans (mkRat_cast_le hBc)) hρ.le
    linarith
  induction cells generalizing c₀ with
  | nil =>
    exact (hpast (Nat.le_of_ble_eq_true hcover) hstart).elim
  | cons x rest ih =>
    obtain ⟨c', t', t⟩ := x
    simp only [cellsCheck, Bool.and_eq_true] at hcells
    simp only [coverCheck, Bool.and_eq_true, Bool.or_eq_true] at hcover
    obtain ⟨ht, hrest⟩ := hcells
    rcases hcover with hBc | ⟨hb, hcrest⟩
    · exact (hpast (Nat.le_of_ble_eq_true hBc) hstart).elim
    rcases le_or_gt (dist p (q 0)) (((mkRat (c' : ℤ) Q : ℚ) : ℝ) * ρ) with hr | hr
    · obtain ⟨i, j, hij, hclose⟩ := ChordBoxTree.exists_dist_sq_le_of_check c p q hρ hlo hhi heq
        t ht hpσ hpc hstart.le hr
      have hT : ((mkRat (t' : ℤ) QT : ℚ) : ℝ) ≤ T := by
        rcases hb with hb | hb
        · have := mul_le_mul_of_nonneg_right
            ((mkRat_cast_le (Nat.le_of_ble_eq_true hb)).trans hA') hρ.le
          linarith
        · exact (mkRat_cast_le (Nat.le_of_ble_eq_true hb)).trans hC'
      exact ⟨i, j, hij, hclose.trans (mul_le_mul_of_nonneg_right hT (sq_nonneg ρ))⟩
    · exact ih hrest hcrest hr

/-- A saturated incidence carries an increasing pair below `t` whenever every
indexed triple on its circle has a pair below `t`. (A copy of the private
`saturated_incidence_increasing_pair_of_triple` of `Esgk.ChordRadiusBound`.) -/
private lemma saturated_incidence_increasing_pair_of_triple {n : ℕ} {p : Config n} {t : ℝ}
    {ir : Fin n × ℝ} (hir : ir ∈ SaturatedDistanceIncidences p)
    (htriple : ∀ f : Fin 3 → Fin n, (∀ i, dist (p ir.1) (p (f i)) = ir.2) →
      ∃ i j : Fin 3, i ≠ j ∧ dist (p (f i)) (p (f j)) ^ 2 ≤ t) :
    ∃ a b, a ∈ DistanceOutNeighborsAtValue p ir.1 ir.2 ∧
      b ∈ DistanceOutNeighborsAtValue p ir.1 ir.2 ∧
      a < b ∧ dist (p a) (p b) ^ 2 ≤ t := by
  classical
  have hc := (Finset.mem_filter.mp hir).2
  obtain ⟨a, b, c, hab, hac, hbc, hs⟩ := Finset.card_eq_three.mp hc
  let f : Fin 3 → Fin n := ![a, b, c]
  have hf : Function.Injective f := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [f]
  have hmem (i : Fin 3) : f i ∈ DistanceOutNeighborsAtValue p ir.1 ir.2 := by
    rw [hs]; fin_cases i <;> simp [f]
  have hd (i : Fin 3) : dist (p ir.1) (p (f i)) = ir.2 :=
    (Finset.mem_filter.mp (hmem i)).2.2
  obtain ⟨i, j, hij, hclose⟩ := htriple f hd
  rcases lt_or_gt_of_ne (hf.ne hij) with hlt | hgt
  · exact ⟨f i, f j, hmem i, hmem j, hlt, hclose⟩
  · exact ⟨f j, f i, hmem j, hmem i, hgt, by simpa [dist_comm] using hclose⟩

/-- **The chord condition `Setting.ChordHolds lo hi T` from a cell table**: under the
hypotheses of `exists_dist_sq_le_of_cover` on the cells and the codes, every saturated
incidence of radius `r` with `lo²ρ² < r² ≤ hi²ρ²` has two of its points `a < b` at squared
distance at most `Tρ²` (`ρ = distanceAnnulusRadius`, annulus at `sBar`). -/
theorem Setting.chordHolds_of_cover {n : ℕ} (S : Setting n) {lo hi T : ℚ}
    {Q QT A B C c₀ e : ℕ} (cells : ChordCells) (hcells : cellsCheck Q QT c₀ e cells = true)
    (hcover : coverCheck A B C c₀ cells = true) (hc₀ : c₀ ≤ A) (hA : mkRat (A : ℤ) Q ≤ lo)
    (hB : hi ≤ mkRat (B : ℤ) Q) (hC : mkRat (C : ℤ) QT ≤ T) (hhi0 : 0 ≤ hi) :
    S.ChordHolds lo hi T := by
  intro ir hir hr1 hr2
  refine saturated_incidence_increasing_pair_of_triple hir fun f hf ↦ ?_
  exact exists_dist_sq_le_of_cover S.c (S.p ir.1) (fun i ↦ S.p (f i)) cells hcells hcover hc₀
    hA hB hC hhi0 S.hρ (S.hlo ir.1) (S.hhi ir.1) (fun i ↦ S.hlo (f i)) (fun i ↦ S.hhi (f i))
    (fun i j ↦ (hf i).trans (hf j).symm) (by rw [hf 0]; exact hr1) (by rw [hf 0]; exact hr2)

/-! ### The cell list elaborator -/

meta section

/-- Split a chord-cell line into nonempty space-delimited fields. -/
def splitCellWords (line : String) : List String :=
  (line.splitOn " ").filter (· ≠ "")

/-- Construct an integer literal using `Int.ofNat` or `Int.negSucc`. -/
def integerExpression (z : Int) : Expr :=
  if 0 ≤ z then mkApp (Lean.mkConst ``Int.ofNat) (mkRawNatLit z.toNat)
  else mkApp (Lean.mkConst ``Int.negSucc) (mkRawNatLit (z.natAbs - 1))

/-- Construct `mkRat z d` for a signed chord-certificate entry. -/
def signedRationalExpression (z : Int) (d : Nat) : Expr :=
  mkApp2 (Lean.mkConst ``mkRat) (integerExpression z) (mkRawNatLit d)

/-- The tree of the tokens from position `i` (prefix form: `c z d` is `cert (z/d)`, `D` is
`disk`, `A t t` is `splitApex`, `R t t` is `splitRadius`, `Q t t t t` is `split`), with the
position after it. -/
def parseChordTree (ws : Array String) : Nat → Nat → Option (Expr × Nat)
  | 0, _ => none
  | fuel + 1, i =>
      match ws[i]? with
      | some "c" => do
          let z ← ws[i + 1]?.bind String.toInt?
          let d ← ws[i + 2]?.bind String.toNat?
          return (mkApp (Lean.mkConst ``ChordBoxTree.cert) (signedRationalExpression z d), i + 3)
      | some "D" => some (Lean.mkConst ``ChordBoxTree.disk, i + 1)
      | some "A" => do
          let (t₁, j) ← parseChordTree ws fuel (i + 1)
          let (t₂, k) ← parseChordTree ws fuel j
          return (mkApp2 (Lean.mkConst ``ChordBoxTree.splitApex) t₁ t₂, k)
      | some "R" => do
          let (t₁, j) ← parseChordTree ws fuel (i + 1)
          let (t₂, k) ← parseChordTree ws fuel j
          return (mkApp2 (Lean.mkConst ``ChordBoxTree.splitRadius) t₁ t₂, k)
      | some "Q" => do
          let (t₁, j₁) ← parseChordTree ws fuel (i + 1)
          let (t₂, j₂) ← parseChordTree ws fuel j₁
          let (t₃, j₃) ← parseChordTree ws fuel j₂
          let (t₄, j₄) ← parseChordTree ws fuel j₃
          return (mkApp4 (Lean.mkConst ``ChordBoxTree.split) t₁ t₂ t₃ t₄, j₄)
      | _ => none

/-- `s4_chordcells% "…"`: a `ChordCells` list, one cell per line `c₁ t′ tree` (natural codes of
the cell end and of the squared bound, then the tree in prefix form). -/
elab "s4_chordcells% " s:str : term => do
  let q := Lean.mkConst ``Nat
  let treeT := Lean.mkConst ``ChordBoxTree
  let entT := mkApp2 (Lean.mkConst ``Prod [Level.zero, Level.zero]) q
    (mkApp2 (Lean.mkConst ``Prod [Level.zero, Level.zero]) q treeT)
  let lines := ((s.getString.splitOn "\n").map splitCellWords).filter (· ≠ [])
  let mut ents : Array Expr := #[]
  for ws in lines do
    let wa := ws.toArray
    let some rc := wa[0]?.bind String.toNat? | throwError "bad cell line {ws}"
    let some tc := wa[1]?.bind String.toNat? | throwError "bad cell line {ws}"
    let some (t, k) := parseChordTree wa wa.size 2 | throwError "bad tree in cell line {ws}"
    unless k == wa.size do throwError "trailing tokens in cell line {ws}"
    let inner := mkApp4 (Lean.mkConst ``Prod.mk [Level.zero, Level.zero]) q treeT
      (mkRawNatLit tc) t
    ents := ents.push (mkApp4 (Lean.mkConst ``Prod.mk [Level.zero, Level.zero]) q
      (mkApp2 (Lean.mkConst ``Prod [Level.zero, Level.zero]) q treeT) (mkRawNatLit rc) inner)
  let mut l := mkApp (Lean.mkConst ``List.nil [Level.zero]) entT
  for e in ents.reverse do
    l := mkApp3 (Lean.mkConst ``List.cons [Level.zero]) entT e l
  return l

end

end Esgk.S4

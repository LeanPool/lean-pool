module

public import LeanPool.FormalLinguistics.BarHillel

/-!
  The Lambek calculus `L` (Lambek 1958) and Lambek grammars.

  This file contains the easy half of the Chomsky–Pentus theorem: every ε-free
  context-free language is generated by a Lambek grammar. It reuses the AB grammar
  obtained from 2-Greibach normal form in `BarHillel.lean`:

    • every AB derivation is a derivation in `L`, so the Lambek grammar with the same
      lexicon generates at least the AB language (`ABG.lang_sub_lambek`);
    • `L` is sound for language models (`LDer.sound`), which shows that for the
      Greibach-derived lexicon it generates nothing more (`GNFtoABG.lambek_sub`).

  The hard half (Pentus 1993: every Lambek grammar generates a context-free language)
  is not in this file.
-/

@[expose] public section

namespace FormalLinguistics

/-- Types of the Lambek calculus with product: `over A B` is `A / B`,
    `under B A` is `B \ A`, and `mul A B` is `A • B`. -/
inductive LType (P : Type) where
  | prim : P → LType P
  | over : LType P → LType P → LType P
  | under : LType P → LType P → LType P
  | mul : LType P → LType P → LType P
  deriving DecidableEq, Repr

namespace LType

variable {P T : Type}

/-- AB categories are the product-free Lambek types. -/
def ofCat : Cat P → LType P
  | Cat.atom p => prim p
  | Cat.rslash A B => over (ofCat A) (ofCat B)
  | Cat.lslash B A => under (ofCat B) (ofCat A)

/-- Interpretation of types in a language model: primitive types are interpreted by
    arbitrary languages, and the connectives by the residuated operations on languages. -/
def sem (I : P → List T → Prop) : LType P → List T → Prop
  | prim p => I p
  | over A B => fun x => ∀ y, sem I B y → sem I A (x ++ y)
  | under B A => fun x => ∀ y, sem I B y → sem I A (y ++ x)
  | mul A B => fun x => ∃ y z, x = y ++ z ∧ sem I A y ∧ sem I B z

end LType

/-- Derivability in the Lambek calculus `L`: sequents `Γ → C` with the axiom, the left and
    right rules for `/`, `\` and `•`, and cut. As in Lambek (1958), the right rules for the
    two divisions require a non-empty antecedent, so no sequent with an empty antecedent is
    derivable. -/
inductive LDer {P : Type} : List (LType P) → LType P → Prop where
  | ax (A : LType P) : LDer [A] A
  | overR {Γ : List (LType P)} {A B : LType P} :
      Γ ≠ [] → LDer (Γ ++ [B]) A → LDer Γ (LType.over A B)
  | underR {Γ : List (LType P)} {A B : LType P} :
      Γ ≠ [] → LDer (B :: Γ) A → LDer Γ (LType.under B A)
  | overL {Γ Δ Θ : List (LType P)} {A B C : LType P} :
      LDer Θ B → LDer (Γ ++ [A] ++ Δ) C → LDer (Γ ++ [LType.over A B] ++ Θ ++ Δ) C
  | underL {Γ Δ Θ : List (LType P)} {A B C : LType P} :
      LDer Θ B → LDer (Γ ++ [A] ++ Δ) C → LDer (Γ ++ Θ ++ [LType.under B A] ++ Δ) C
  | mulR {Γ Δ : List (LType P)} {A B : LType P} :
      LDer Γ A → LDer Δ B → LDer (Γ ++ Δ) (LType.mul A B)
  | mulL {Γ Δ : List (LType P)} {A B C : LType P} :
      LDer (Γ ++ [A, B] ++ Δ) C → LDer (Γ ++ [LType.mul A B] ++ Δ) C
  | cut {Γ Δ Θ : List (LType P)} {A C : LType P} :
      LDer Θ A → LDer (Γ ++ [A] ++ Δ) C → LDer (Γ ++ Θ ++ Δ) C

/-- A finite Lambek grammar over primitive types `P` and alphabet `T`. -/
structure LambekGrammar (P T : Type) where
  /-- Primitive goal type for complete strings. -/
  distinguished : P
  /-- Finite list of assigned Lambek types for individual terminals. -/
  lexicon : List (T × LType P)

namespace LambekGrammar

variable {P T : Type}

/-- Lexical assignment of one type to each letter of a word. -/
inductive LexAssign (G : LambekGrammar P T) : List T → List (LType P) → Prop where
  | nil : LexAssign G [] []
  | cons {a : T} {A : LType P} {w : List T} {Γ : List (LType P)} :
      (a, A) ∈ G.lexicon → LexAssign G w Γ → LexAssign G (a :: w) (A :: Γ)

/-- The string language generated by a Lambek grammar. -/
def Lang (G : LambekGrammar P T) (w : List T) : Prop :=
  ∃ Γ, LexAssign G w Γ ∧ LDer Γ (LType.prim G.distinguished)

end LambekGrammar

/-! ### Soundness of `L` for language models -/

section Soundness

variable {P T : Type}

/-- A string belongs to the interpretation of a sequence of types if it is a concatenation
    of strings belonging to the interpretations of the types, in order. -/
inductive SeqSem (I : P → List T → Prop) : List (LType P) → List T → Prop where
  | nil : SeqSem I [] []
  | cons {A : LType P} {Γ : List (LType P)} {x y : List T} :
      A.sem I x → SeqSem I Γ y → SeqSem I (A :: Γ) (x ++ y)

theorem SeqSem.single {I : P → List T → Prop} {A : LType P} {x : List T}
    (h : A.sem I x) : SeqSem I [A] x := by
  simpa using SeqSem.cons h SeqSem.nil

theorem SeqSem.of_single {I : P → List T → Prop} {A : LType P} {x : List T}
    (h : SeqSem I [A] x) : A.sem I x := by
  cases h with
  | cons hA hnil =>
    cases hnil
    simpa using hA

theorem SeqSem.append {I : P → List T → Prop} {Γ Δ : List (LType P)} {x y : List T}
    (h1 : SeqSem I Γ x) (h2 : SeqSem I Δ y) : SeqSem I (Γ ++ Δ) (x ++ y) := by
  induction h1 with
  | nil => simpa using h2
  | cons hA _ ih => simpa [List.append_assoc] using SeqSem.cons hA ih

theorem SeqSem.split {I : P → List T → Prop} {Γ Δ : List (LType P)} {x : List T}
    (h : SeqSem I (Γ ++ Δ) x) :
    ∃ y z, x = y ++ z ∧ SeqSem I Γ y ∧ SeqSem I Δ z := by
  induction Γ generalizing x with
  | nil => exact ⟨[], x, rfl, SeqSem.nil, h⟩
  | cons A Γ ih =>
    cases h with
    | cons hA hrest =>
      obtain ⟨y, z, hyz, hy, hz⟩ := ih hrest
      refine ⟨_ ++ y, z, ?_, SeqSem.cons hA hy, hz⟩
      simp [hyz, List.append_assoc]

/-- Soundness: if `Γ → C` is derivable in `L`, then in every language model the
    interpretation of `Γ` is included in the interpretation of `C`. -/
theorem LDer.sound {I : P → List T → Prop} {Γ : List (LType P)} {C : LType P}
    (h : LDer Γ C) : ∀ x, SeqSem I Γ x → C.sem I x := by
  induction h with
  | ax A =>
    intro x hx
    exact SeqSem.of_single hx
  | overR _ _ ih =>
    intro x hx
    simp only [LType.sem]
    intro y hy
    exact ih (x ++ y) (SeqSem.append hx (SeqSem.single hy))
  | underR _ _ ih =>
    intro x hx
    simp only [LType.sem]
    intro y hy
    exact ih (y ++ x) (SeqSem.cons hy hx)
  | overL _ _ ih1 ih2 =>
    intro x hx
    obtain ⟨x1, xΔ, rfl, h1, hΔ⟩ := SeqSem.split hx
    obtain ⟨x2, xΘ, rfl, h2, hΘ⟩ := SeqSem.split h1
    obtain ⟨xΓ, xo, rfl, hΓ, ho⟩ := SeqSem.split h2
    have ho' := SeqSem.of_single ho
    simp only [LType.sem] at ho'
    have hA := ho' xΘ (ih1 xΘ hΘ)
    have := ih2 _ (SeqSem.append (SeqSem.append hΓ (SeqSem.single hA)) hΔ)
    simpa [List.append_assoc] using this
  | underL _ _ ih1 ih2 =>
    intro x hx
    obtain ⟨x1, xΔ, rfl, h1, hΔ⟩ := SeqSem.split hx
    obtain ⟨x2, xu, rfl, h2, hu⟩ := SeqSem.split h1
    obtain ⟨xΓ, xΘ, rfl, hΓ, hΘ⟩ := SeqSem.split h2
    have hu' := SeqSem.of_single hu
    simp only [LType.sem] at hu'
    have hA := hu' xΘ (ih1 xΘ hΘ)
    have := ih2 _ (SeqSem.append (SeqSem.append hΓ (SeqSem.single hA)) hΔ)
    simpa [List.append_assoc] using this
  | mulR _ _ ih1 ih2 =>
    intro x hx
    obtain ⟨y, z, rfl, hy, hz⟩ := SeqSem.split hx
    simp only [LType.sem]
    exact ⟨y, z, rfl, ih1 y hy, ih2 z hz⟩
  | mulL _ ih =>
    intro x hx
    obtain ⟨x1, xΔ, rfl, h1, hΔ⟩ := SeqSem.split hx
    obtain ⟨xΓ, xm, rfl, hΓ, hm⟩ := SeqSem.split h1
    have hm' := SeqSem.of_single hm
    simp only [LType.sem] at hm'
    obtain ⟨y, z, rfl, hy, hz⟩ := hm'
    have hAB : SeqSem I [_, _] (y ++ z) := SeqSem.cons hy (SeqSem.single hz)
    have := ih _ (SeqSem.append (SeqSem.append hΓ hAB) hΔ)
    simpa [List.append_assoc] using this
  | cut _ _ ih1 ih2 =>
    intro x hx
    obtain ⟨x1, xΔ, rfl, h1, hΔ⟩ := SeqSem.split hx
    obtain ⟨xΓ, xΘ, rfl, hΓ, hΘ⟩ := SeqSem.split h1
    have := ih2 _ (SeqSem.append (SeqSem.append hΓ (SeqSem.single (ih1 xΘ hΘ))) hΔ)
    simpa [List.append_assoc] using this

end Soundness

/-! ### AB grammars as Lambek grammars -/

namespace ABG

variable {P T : Type}

/-- The Lambek grammar with the same lexicon as an AB grammar. -/
def toLambek (G : ABG P T) : LambekGrammar P T where
  distinguished := G.distinguished
  lexicon := G.lexicon.map fun (a, C) => (a, LType.ofCat C)

/-- An AB cancellation step is admissible in `L`. -/
theorem LDer_of_abStep {γ δ : List (Cat P)} (h : ABStep γ δ) {C : LType P}
    (hC : LDer (δ.map LType.ofCat) C) : LDer (γ.map LType.ofCat) C := by
  cases h with
  | fwd u v A B =>
    have h1 : (u ++ [A] ++ v).map LType.ofCat
        = u.map LType.ofCat ++ [LType.ofCat A] ++ v.map LType.ofCat := by simp
    have h2 : (u ++ [Cat.rslash A B, B] ++ v).map LType.ofCat
        = u.map LType.ofCat ++ [LType.over (LType.ofCat A) (LType.ofCat B)]
            ++ [LType.ofCat B] ++ v.map LType.ofCat := by
      simp [LType.ofCat, List.append_assoc]
    rw [h1] at hC
    rw [h2]
    exact LDer.overL (LDer.ax _) hC
  | bwd u v A B =>
    have h1 : (u ++ [A] ++ v).map LType.ofCat
        = u.map LType.ofCat ++ [LType.ofCat A] ++ v.map LType.ofCat := by simp
    have h2 : (u ++ [B, Cat.lslash B A] ++ v).map LType.ofCat
        = u.map LType.ofCat ++ [LType.ofCat B]
            ++ [LType.under (LType.ofCat B) (LType.ofCat A)] ++ v.map LType.ofCat := by
      simp [LType.ofCat, List.append_assoc]
    rw [h1] at hC
    rw [h2]
    exact LDer.underL (LDer.ax _) hC

theorem LDer_of_abDerives {γ δ : List (Cat P)} (h : ABDerives γ δ) {C : LType P} :
    LDer (δ.map LType.ofCat) C → LDer (γ.map LType.ofCat) C := by
  induction h with
  | refl => exact id
  | tail _ hstep ih => exact fun hC => ih (LDer_of_abStep hstep hC)

theorem lexAssign_toLambek {G : ABG P T} {w : List T} {γ : List (Cat P)}
    (h : LexAssign G w γ) : LambekGrammar.LexAssign G.toLambek w (γ.map LType.ofCat) := by
  induction h with
  | nil => exact LambekGrammar.LexAssign.nil
  | cons ha _ ih =>
    refine LambekGrammar.LexAssign.cons ?_ ih
    exact List.mem_map.mpr ⟨_, ha, rfl⟩

/-- Every string generated by an AB grammar is generated by the Lambek grammar with the
    same lexicon. -/
theorem lang_sub_lambek (G : ABG P T) {w : List T} (h : G.Lang w) : G.toLambek.Lang w := by
  obtain ⟨γ, hlex, hder⟩ := h
  refine ⟨γ.map LType.ofCat, lexAssign_toLambek hlex, ?_⟩
  exact LDer_of_abDerives hder (LDer.ax _)

end ABG

/-! ### Every ε-free context-free language is a Lambek language -/

namespace GNFtoABG

variable {N T : Type}

/-- In the language model that interprets each nonterminal by its yield, every lexical type
    of the Greibach-derived grammar contains its own letter. -/
theorem lex_sem {G : GNF2 N T} {a : T} {C : Cat N} (h : (a, C) ∈ (toABG G).lexicon) :
    (LType.ofCat C).sem (GNF2.Yield G) [a] := by
  rcases lex_shapes h with ⟨U, rfl, hr⟩ | ⟨U, V, rfl, hr⟩ | ⟨U, V, W, rfl, hr⟩
  · simp only [LType.ofCat, LType.sem]
    exact GNF2.Yield.r0 hr
  · simp only [LType.ofCat, LType.sem]
    intro y hy
    exact GNF2.Yield.r1 hr hy
  · simp only [LType.ofCat, LType.sem]
    intro y hy z hz
    simpa [List.append_assoc] using GNF2.Yield.r2 hr hy hz

theorem lexAssign_sem {G : GNF2 N T} {w : List T} {Γ : List (LType N)}
    (h : LambekGrammar.LexAssign (toABG G).toLambek w Γ) : SeqSem (GNF2.Yield G) Γ w := by
  induction h with
  | nil => exact SeqSem.nil
  | cons ha _ ih =>
    obtain ⟨⟨a', C⟩, hmem, heq⟩ := List.mem_map.mp ha
    simp only [Prod.mk.injEq] at heq
    obtain ⟨rfl, rfl⟩ := heq
    exact SeqSem.cons (lex_sem hmem) ih

/-- The Lambek grammar with the Greibach-derived lexicon generates no more than the
    2-GNF grammar it comes from. -/
theorem lambek_sub (G : GNF2 N T) {w : List T} (h : (toABG G).toLambek.Lang w) : G.Lang w := by
  obtain ⟨Γ, hlex, hder⟩ := h
  exact hder.sound w (lexAssign_sem hlex)

theorem toLambek_lang (G : GNF2 N T) (w : List T) :
    (toABG G).toLambek.Lang w ↔ G.Lang w :=
  ⟨lambek_sub G, fun h => ABG.lang_sub_lambek _ ((toABG_lang G w).mpr h)⟩

end GNFtoABG

/-- Every context-free grammar has a Lambek grammar generating exactly its non-empty
    strings. The lexicon uses only right division, with types of the forms `p`, `p / q`
    and `(p / r) / q`. -/
theorem cfg_to_lambek_equiv {N T : Type} [DecidableEq N] [DecidableEq T] (G : CFG N T) :
    ∀ w, (cfgToABG G).toLambek.Lang w ↔ G.Lang w ∧ w ≠ [] := by
  intro w
  unfold cfgToABG
  rw [GNFtoABG.toLambek_lang, CNFtoGNF.cnfToGNF_lang, cfgToCNF_lang]


end FormalLinguistics

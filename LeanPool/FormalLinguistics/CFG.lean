module

public import Init

/-!
  Context-Free Grammars (Chomsky, 1956/1959)
  Standard string-rewriting definition + equivalence with parse-tree derivations (`Yield`).
-/

@[expose] public section

namespace FormalLinguistics

/-- Grammar symbols: either a nonterminal `N` or a terminal `T`. -/
inductive Symbol (N T : Type) where
  | nt : N → Symbol N T
  | tm : T → Symbol N T
  deriving DecidableEq, Repr

/-- A finite Context-Free Grammar over nonterminals `N` and terminals `T`. -/
structure CFG (N T : Type) where
  /-- Nonterminal from which complete words are derived. -/
  start : N
  /-- Finite list of pairs of a nonterminal and its replacement word. -/
  rules : List (N × List (Symbol N T))

namespace CFG

variable {N T : Type}

/-- Single-step context-free rewriting: `u A v ⇒ u rhs v` when `(A, rhs) ∈ G.rules`. -/
inductive Step (G : CFG N T) : List (Symbol N T) → List (Symbol N T) → Prop where
  | mk (u v rhs : List (Symbol N T)) (A : N) :
      (A, rhs) ∈ G.rules →
      Step G (u ++ [Symbol.nt A] ++ v) (u ++ rhs ++ v)

/-- Multi-step derivation: reflexive-transitive closure of `Step`. -/
inductive Derives (G : CFG N T) : List (Symbol N T) → List (Symbol N T) → Prop where
  | refl (u : List (Symbol N T)) : Derives G u u
  | tail {u v w : List (Symbol N T)} : Derives G u v → Step G v w → Derives G u w

/-- The string language generated by a CFG. -/
def Lang (G : CFG N T) (w : List T) : Prop :=
  Derives G [Symbol.nt G.start] (w.map Symbol.tm)

theorem Derives.single {G : CFG N T} {u v : List (Symbol N T)} (h : Step G u v) :
    Derives G u v :=
  Derives.tail (Derives.refl u) h

theorem Derives.trans {G : CFG N T} {u v w : List (Symbol N T)}
    (h1 : Derives G u v) (h2 : Derives G v w) : Derives G u w := by
  induction h2 with
  | refl => exact h1
  | tail _ hstep ih => exact Derives.tail ih hstep

theorem Step.append_left {G : CFG N T} (p : List (Symbol N T)) {u v : List (Symbol N T)}
    (h : Step G u v) : Step G (p ++ u) (p ++ v) := by
  cases h with
  | mk l r rhs A hr =>
    have h1 : p ++ (l ++ [Symbol.nt A] ++ r) = (p ++ l) ++ [Symbol.nt A] ++ r := by
      simp [List.append_assoc]
    have h2 : p ++ (l ++ rhs ++ r) = (p ++ l) ++ rhs ++ r := by
      simp [List.append_assoc]
    rw [h1, h2]
    exact Step.mk (p ++ l) r rhs A hr

theorem Step.append_right {G : CFG N T} (s : List (Symbol N T)) {u v : List (Symbol N T)}
    (h : Step G u v) : Step G (u ++ s) (v ++ s) := by
  cases h with
  | mk l r rhs A hr =>
    have h1 : (l ++ [Symbol.nt A] ++ r) ++ s = l ++ [Symbol.nt A] ++ (r ++ s) := by
      simp [List.append_assoc]
    have h2 : (l ++ rhs ++ r) ++ s = l ++ rhs ++ (r ++ s) := by
      simp [List.append_assoc]
    rw [h1, h2]
    exact Step.mk l (r ++ s) rhs A hr

theorem Derives.append_left {G : CFG N T} (p : List (Symbol N T)) {u v : List (Symbol N T)}
    (h : Derives G u v) : Derives G (p ++ u) (p ++ v) := by
  induction h with
  | refl => exact Derives.refl _
  | tail _ hstep ih => exact Derives.tail ih (Step.append_left p hstep)

theorem Derives.append_right {G : CFG N T} (s : List (Symbol N T)) {u v : List (Symbol N T)}
    (h : Derives G u v) : Derives G (u ++ s) (v ++ s) := by
  induction h with
  | refl => exact Derives.refl _
  | tail _ hstep ih => exact Derives.tail ih (Step.append_right s hstep)

theorem Derives.append {G : CFG N T} {u1 v1 u2 v2 : List (Symbol N T)}
    (h1 : Derives G u1 v1) (h2 : Derives G u2 v2) : Derives G (u1 ++ u2) (v1 ++ v2) :=
  Derives.trans (Derives.append_right u2 h1) (Derives.append_left v1 h2)

/- Structural parse-tree derivations (mutually inductive for single nonterminals and sentential forms). -/
mutual
  /-- Parse-tree derivations from one nonterminal. -/
  inductive Yield (G : CFG N T) : N → List T → Prop where
    | rule {A : N} {rhs : List (Symbol N T)} {w : List T} :
        (A, rhs) ∈ G.rules → YieldList G rhs w → Yield G A w

  /-- Parse-forest derivations from a sentential form. -/
  inductive YieldList (G : CFG N T) : List (Symbol N T) → List T → Prop where
    | nil : YieldList G [] []
    | cons_tm {a : T} {rhs : List (Symbol N T)} {w : List T} :
        YieldList G rhs w → YieldList G (Symbol.tm a :: rhs) (a :: w)
    | cons_nt {B : N} {rhs : List (Symbol N T)} {w1 w2 : List T} :
        Yield G B w1 → YieldList G rhs w2 → YieldList G (Symbol.nt B :: rhs) (w1 ++ w2)
end

theorem YieldList.append {G : CFG N T} {α β : List (Symbol N T)} {w1 w2 : List T} :
    YieldList G α w1 → YieldList G β w2 → YieldList G (α ++ β) (w1 ++ w2)
  | YieldList.nil, h2 => by simpa using h2
  | YieldList.cons_tm h1, h2 => YieldList.cons_tm (YieldList.append h1 h2)
  | YieldList.cons_nt hy h1, h2 => by
    simpa [List.append_assoc] using YieldList.cons_nt hy (YieldList.append h1 h2)

theorem YieldList.of_terminals {G : CFG N T} (w : List T) :
    YieldList G (w.map Symbol.tm) w := by
  induction w with
  | nil => exact YieldList.nil
  | cons a t ih => exact YieldList.cons_tm ih

theorem YieldList.split_append {G : CFG N T} {α β : List (Symbol N T)} {w : List T}
    (h : YieldList G (α ++ β) w) :
    ∃ w1 w2, w = w1 ++ w2 ∧ YieldList G α w1 ∧ YieldList G β w2 := by
  induction α generalizing w with
  | nil =>
    exact ⟨[], w, rfl, YieldList.nil, h⟩
  | cons s t ih =>
    cases s with
    | tm a =>
      cases h with
      | cons_tm ht =>
        obtain ⟨w1, w2, hw, h1, h2⟩ := ih ht
        exact ⟨a :: w1, w2, by simp [hw], YieldList.cons_tm h1, h2⟩
    | nt B =>
      cases h with
      | cons_nt hy ht =>
        obtain ⟨w1, w2, hw, h1, h2⟩ := ih ht
        refine ⟨_ ++ w1, w2, ?_, YieldList.cons_nt hy h1, h2⟩
        simp [hw, List.append_assoc]

theorem YieldList.step_back {G : CFG N T} {u v : List (Symbol N T)} {w : List T}
    (hs : Step G u v) (hv : YieldList G v w) : YieldList G u w := by
  cases hs with
  | mk l r rhs A hr =>
    rw [List.append_assoc] at hv
    obtain ⟨w1, w23, hw1, hl, h23⟩ := YieldList.split_append hv
    obtain ⟨w2, w3, hw2, hrhs, hr'⟩ := YieldList.split_append h23
    have hA : Yield G A w2 := Yield.rule hr hrhs
    have hAs : YieldList G [Symbol.nt A] w2 := by
      simpa using YieldList.cons_nt hA YieldList.nil
    have hres := YieldList.append (YieldList.append hl hAs) hr'
    simpa [hw1, hw2, List.append_assoc] using hres

theorem Derives.yieldList_back {G : CFG N T} {u v : List (Symbol N T)} {w : List T}
    (h : Derives G u v) (hv : YieldList G v w) : YieldList G u w := by
  induction h with
  | refl => exact hv
  | tail _ hstep ih => exact ih (YieldList.step_back hstep hv)

theorem Derives.to_yieldList {G : CFG N T} {u : List (Symbol N T)} {w : List T}
    (h : Derives G u (w.map Symbol.tm)) : YieldList G u w :=
  Derives.yieldList_back h (YieldList.of_terminals w)

mutual
  theorem derives_of_yield {G : CFG N T} {A : N} {w : List T} :
      Yield G A w → Derives G [Symbol.nt A] (w.map Symbol.tm)
    | Yield.rule (rhs := rhs) hr hyl =>
      have hstep : Step G [Symbol.nt A] rhs := by
        simpa using Step.mk [] [] rhs A hr
      Derives.trans (Derives.single hstep) (derives_of_yieldList hyl)

  theorem derives_of_yieldList {G : CFG N T} {α : List (Symbol N T)} {w : List T} :
      YieldList G α w → Derives G α (w.map Symbol.tm)
    | YieldList.nil => Derives.refl []
    | YieldList.cons_tm (a := a) h => by
      simpa using Derives.append_left [Symbol.tm a] (derives_of_yieldList h)
    | YieldList.cons_nt hy hyl => by
      simpa [List.map_append] using Derives.append (derives_of_yield hy) (derives_of_yieldList hyl)
end

/-- Fundamental equivalence: rewriting derivations ↔ structural parse trees. -/
theorem derives_iff_yield {G : CFG N T} {A : N} {w : List T} :
    Derives G [Symbol.nt A] (w.map Symbol.tm) ↔ Yield G A w := by
  constructor
  · intro h
    have hyl := Derives.to_yieldList h
    cases hyl with
    | cons_nt hy hnil =>
      cases hnil
      simpa using hy
  · exact derives_of_yield

theorem lang_iff_yield {G : CFG N T} {w : List T} :
    G.Lang w ↔ Yield G G.start w :=
  derives_iff_yield

end CFG
end FormalLinguistics

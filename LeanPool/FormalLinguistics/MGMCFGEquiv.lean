module

public import LeanPool.FormalLinguistics.MGtoMCFG
public import LeanPool.FormalLinguistics.MCFGtoMG

/-!
  Michaelis (1998, 2001) & Harkema (2001) Equivalence Theorem

  Main machine-checked result:
    The class of languages generated by finite chain-based Minimalist Grammars
    in the invariant-carrying presentation coincides exactly with the class of
    languages generated by finite Linear Non-Erasing Multiple Context-Free
    Grammars / Linear Context-Free Rewriting Systems (Seki et al. 1991;
    Vijay-Shanker, Weir & Joshi 1987):

        L(MG) = L(MCFG / LCFRS).

  Also includes a verified mildly context-sensitive (non-context-free)
  cross-serial dependency witness:
    • `abcMCFG`: a 3-rule 3-dimensional MCFG whose exact language is
        `{ a^n b^n c^n | n ≥ 1 }`, automatically compiled to an equivalent MG
        `abcCompiledMG = MCFGtoMG.mcfgToMG abcMCFG`.
    • `abcDirectMG`: a 9-item hand-crafted Minimalist Grammar generating
        `a^n b^n c^n` for all `n ≥ 1`, automatically compiled to an equivalent
        MCFG `abcCompiledMCFG = MGtoMCFG.mgToMCFG abcDirectMG`.
-/

@[expose] public section

namespace FormalLinguistics

/-! ### Part 1: Main Weak Equivalence Theorems (`L(MG) = L(MCFG)`) -/

/-- A language `L` over terminal alphabet `T` is generated by a finite Minimalist Grammar
    with decidable syntactic feature equality. -/
def IsDecMGLang {T : Type} (L : List T → Prop) : Prop :=
  ∃ (Base Lic : Type) (_ : DecidableEq Base) (_ : DecidableEq Lic)
    (G : MG Base Lic T), ∀ w, G.Lang w ↔ L w

/-- A language `L` over terminal alphabet `T` is generated by a finite Linear Non-Erasing MCFG
    with decidable nonterminal equality. -/
def IsDecMCFGLang {T : Type} (L : List T → Prop) : Prop :=
  ∃ (N : Type) (_ : DecidableEq N) (G : MCFG N T), ∀ w, G.Lang w ↔ L w

/-- **Decidable-Alphabet Michaelis–Harkema Equivalence Theorem**:
    For any decidable terminal alphabet `T`, a language is generated by a finite
    Minimalist Grammar (with decidable feature equality) iff it is generated by a
    finite Linear Non-Erasing MCFG (LCFRS) (with decidable nonterminal equality). -/
theorem michaelis_harkema_equivalence_decidable {T : Type} [DecidableEq T]
    (L : List T → Prop) :
    IsDecMGLang L ↔ IsDecMCFGLang L := by
  constructor
  · rintro ⟨Base, Lic, hB, hL, G, hG⟩
    refine ⟨MGMCFGNT Base Lic, inferInstance, MGtoMCFG.mgToMCFG G, ?_⟩
    intro w
    rw [MGtoMCFG.mgToMCFG_lang G w, hG w]
  · rintro ⟨N, hN, G, hG⟩
    refine ⟨MCFGtoMG.MGBase (BinMCFGNT N) T, MCFGtoMG.MGLic, inferInstance, inferInstance,
      MCFGtoMG.mcfgToMG G, ?_⟩
    intro w
    rw [MCFGtoMG.mcfgToMG_lang G w, hG w]

/-- General language class of finite Minimalist Grammars over an arbitrary alphabet `T`. -/
def IsMGLang {T : Type} (L : List T → Prop) : Prop :=
  ∃ (Base Lic : Type) (G : MG Base Lic T), ∀ w, G.Lang w ↔ L w

/-- General language class of finite Linear Non-Erasing MCFGs (LCFRSs) over an arbitrary alphabet `T`. -/
def IsMCFGLang {T : Type} (L : List T → Prop) : Prop :=
  ∃ (N : Type) (G : MCFG N T), ∀ w, G.Lang w ↔ L w

/-- **Michaelis–Harkema Equivalence Theorem** (`L(MG) = L(MCFG)` over any alphabet `T`):
The translations adapt Michaelis’s LACL 1998 forward inclusion and the LACL 2001
converse constructions of Michaelis and Harkema to the chain-based presentation. -/
theorem michaelis_harkema_equivalence {T : Type} (L : List T → Prop) :
    IsMGLang L ↔ IsMCFGLang L := by
  constructor
  · rintro ⟨Base, Lic, G, hG⟩
    letI : DecidableEq Base := Classical.typeDecidableEq Base
    letI : DecidableEq Lic := Classical.typeDecidableEq Lic
    refine ⟨MGMCFGNT Base Lic, MGtoMCFG.mgToMCFG G, ?_⟩
    intro w
    rw [MGtoMCFG.mgToMCFG_lang G w, hG w]
  · rintro ⟨N, G, hG⟩
    refine ⟨MCFGtoMG.MGBase (BinMCFGNT N) T, MCFGtoMG.MGLic, MCFGtoMG.mcfgToMG G, ?_⟩
    intro w
    rw [MCFGtoMG.mcfgToMG_lang G w, hG w]

/-! ### Part 2: Verified Cross-Serial Dependency Example (`{ a^n b^n c^n | n ≥ 1 }`) -/

namespace CrossSerialExample

/-- Three-symbol terminal alphabet `{a, b, c}`. -/
inductive ABCTerm where
  | a | b | c
  deriving DecidableEq, Repr

/-- The non-context-free copy-count language `{ a^n b^n c^n | n ≥ 1 }`. -/
def abcWord (n : Nat) : List ABCTerm :=
  List.replicate n .a ++ List.replicate n .b ++ List.replicate n .c

/-- The language of equal positive runs of a, b, and c in that order. -/
def ABCLang (w : List ABCTerm) : Prop :=
  ∃ n, 1 ≤ n ∧ w = abcWord n

/-! #### 2A. Exact 3-Rule MCFG for `{ a^n b^n c^n | n ≥ 1 }` and Its Compiled MG -/

/-- Nonterminals for complete words and for their three separate components. -/
inductive ABCNT where
  | S -- dim 1: full sentence `a^n b^n c^n`
  | T -- dim 3: triple `(a^n, b^n, c^n)`
  deriving DecidableEq, Repr

/-- The sentence symbol yields one component and the counting symbol yields three. -/
def abcDim : ABCNT → Nat
  | .S => 1
  | .T => 3

/-- Concatenate the three letter runs into a sentence. -/
def rJoin : MCFGRule ABCNT ABCTerm :=
  { lhs := .S
    rhs := [.T]
    yield := [[.var 0 0, .var 0 1, .var 0 2]] }

/-- Start the derivation with three runs of length one. -/
def rBase : MCFGRule ABCNT ABCTerm :=
  { lhs := .T
    rhs := []
    yield := [[.tm .a], [.tm .b], [.tm .c]] }

/-- Extend each of the three runs by one letter. -/
def rStep : MCFGRule ABCNT ABCTerm :=
  { lhs := .T
    rhs := [.T]
    yield := [[.tm .a, .var 0 0], [.tm .b, .var 0 1], [.tm .c, .var 0 2]] }

theorem abcMCFG_rules_wf :
    ∀ r, r ∈ [rJoin, rBase, rStep] → r.WellFormed abcDim := by
  intro r hr
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl | rfl
  · refine ⟨rfl, by simp [MCFGRule.isLinear, MCFGRule.varOccurrences, rJoin], ?_⟩
    intro i j
    simp only [rJoin, MCFGRule.varOccurrences, List.flatMap_cons, List.flatMap_nil,
      List.filterMap_cons, List.filterMap_nil, List.append_nil, List.mem_cons,
      List.not_mem_nil, or_false, Prod.mk.injEq]
    constructor
    · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
      · exact ⟨.T, rfl, by decide⟩
      · exact ⟨.T, rfl, by decide⟩
      · exact ⟨.T, rfl, by decide⟩
    · rintro ⟨B, hB, hj⟩
      cases i with
      | zero =>
        simp at hB; subst hB; simp [abcDim] at hj
        omega
      | succ _ => simp at hB
  · refine ⟨rfl, by simp [MCFGRule.isLinear, MCFGRule.varOccurrences, rBase], ?_⟩
    intro i j
    simp [rBase, MCFGRule.varOccurrences]
  · refine ⟨rfl, by simp [MCFGRule.isLinear, MCFGRule.varOccurrences, rStep], ?_⟩
    intro i j
    simp only [rStep, MCFGRule.varOccurrences, List.flatMap_cons, List.flatMap_nil,
      List.filterMap_cons, List.filterMap_nil, List.cons_append, List.nil_append,
      List.append_nil, List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq]
    constructor
    · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
      · exact ⟨.T, rfl, by decide⟩
      · exact ⟨.T, rfl, by decide⟩
      · exact ⟨.T, rfl, by decide⟩
    · rintro ⟨B, hB, hj⟩
      cases i with
      | zero =>
        simp at hB; subst hB; simp [abcDim] at hj
        omega
      | succ _ => simp at hB

/-- 3-rule Linear Non-Erasing MCFG generating exactly `{ a^n b^n c^n | n ≥ 1 }`. -/
def abcMCFG : MCFG ABCNT ABCTerm where
  start := .S
  dim := abcDim
  dim_pos := fun A => by cases A <;> simp [abcDim]
  dim_start := rfl
  rules := [rJoin, rBase, rStep]
  rules_wf := abcMCFG_rules_wf

/-- Semantic invariant characterizing every tuple yielded by `abcMCFG`. -/
def abcInterp : ABCNT → List (List ABCTerm) → Prop
  | .S, tup => ∃ n, 1 ≤ n ∧ tup = [abcWord n]
  | .T, tup => ∃ n, 1 ≤ n ∧ tup = [List.replicate n .a, List.replicate n .b, List.replicate n .c]

/-- Interpret a list of example nonterminals by tuples of the expected shape. -/
inductive ABCInterpList : List ABCNT → List (List (List ABCTerm)) → Prop where
  | nil : ABCInterpList [] []
  | cons {A As tup tups} :
      abcInterp A tup → ABCInterpList As tups → ABCInterpList (A :: As) (tup :: tups)

mutual
  theorem abcMCFG_sound {A : ABCNT} {tup : List (List ABCTerm)} :
      MCFG.Yield abcMCFG A tup → abcInterp A tup
    | MCFG.Yield.rule hr hargs_raw => by
      have hargs := abcMCFG_sound_list hargs_raw
      change _ ∈ [rJoin, rBase, rStep] at hr
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl | rfl
      · cases hargs with
        | cons hT hnil =>
          cases hnil
          obtain ⟨n, hn, rfl⟩ := hT
          exact ⟨n, hn, by simp [rJoin, MCFG.evalYield, MCFG.evalComp, abcWord, List.append_assoc]⟩
      · cases hargs
        exact ⟨1, Nat.le_refl 1, by simp [rBase, MCFG.evalYield, MCFG.evalComp]⟩
      · cases hargs with
        | cons hT hnil =>
          cases hnil
          obtain ⟨n, hn, rfl⟩ := hT
          exact ⟨n + 1, by omega, by simp [rStep, MCFG.evalYield, MCFG.evalComp, List.replicate_succ]⟩

  theorem abcMCFG_sound_list {As : List ABCNT} {args : List (List (List ABCTerm))} :
      MCFG.YieldList abcMCFG As args → ABCInterpList As args
    | MCFG.YieldList.nil => ABCInterpList.nil
    | MCFG.YieldList.cons hy hrest => ABCInterpList.cons (abcMCFG_sound hy) (abcMCFG_sound_list hrest)
end

theorem abcMCFG_T_complete :
    ∀ n, 1 ≤ n →
      MCFG.Yield abcMCFG .T [List.replicate n .a, List.replicate n .b, List.replicate n .c] := by
  intro n
  induction n with
  | zero => intro h; omega
  | succ k ih =>
    intro _
    cases k with
    | zero =>
      have hr : rBase ∈ abcMCFG.rules := by simp [abcMCFG]
      simpa [rBase, MCFG.evalYield, MCFG.evalComp] using MCFG.Yield.rule hr MCFG.YieldList.nil
    | succ k' =>
      have hprev := ih (by omega)
      have hr : rStep ∈ abcMCFG.rules := by simp [abcMCFG]
      have hy := MCFG.Yield.rule hr (MCFG.YieldList.cons hprev MCFG.YieldList.nil)
      simpa [rStep, MCFG.evalYield, MCFG.evalComp, List.replicate_succ] using hy

/-- Exact language theorem for `abcMCFG`: `L(abcMCFG) = { a^n b^n c^n | n ≥ 1 }`. -/
theorem abcMCFG_lang_iff (w : List ABCTerm) :
    abcMCFG.Lang w ↔ ABCLang w := by
  constructor
  · intro h
    obtain ⟨n, hn, heq⟩ := abcMCFG_sound h
    simp at heq
    exact ⟨n, hn, heq⟩
  · rintro ⟨n, hn, rfl⟩
    have hT := abcMCFG_T_complete n hn
    have hr : rJoin ∈ abcMCFG.rules := by simp [abcMCFG]
    have hy := MCFG.Yield.rule hr (MCFG.YieldList.cons hT MCFG.YieldList.nil)
    change MCFG.Yield abcMCFG .S [abcWord n]
    simpa [rJoin, MCFG.evalYield, MCFG.evalComp, abcWord, List.append_assoc] using hy

/-- Automatically compiled Minimalist Grammar for `{ a^n b^n c^n | n ≥ 1 }` via `MCFGtoMG.mcfgToMG`. -/
def abcCompiledMG := MCFGtoMG.mcfgToMG abcMCFG

/-- Exact language theorem transferred automatically to `abcCompiledMG`. -/
theorem abcCompiledMG_lang_iff (w : List ABCTerm) :
    abcCompiledMG.Lang w ↔ ABCLang w := by
  rw [abcCompiledMG, MCFGtoMG.mcfgToMG_lang abcMCFG w, abcMCFG_lang_iff w]

/-- Concrete witness: `"aabbcc"` is generated by `abcCompiledMG`. -/
theorem aabbcc_in_abcCompiledMG :
    abcCompiledMG.Lang [.a, .a, .b, .b, .c, .c] :=
  (abcCompiledMG_lang_iff _).mpr ⟨2, by omega, rfl⟩

/-! #### 2B. Hand-Crafted 9-Item Minimalist Grammar for `{ a^n b^n c^n | n ≥ 1 }` and Its Compiled MCFG -/

/-- Categories for the sentence, the counting loop, and the movement stages. -/
inductive ABCBase where
  | Start | Loop | C0 | B0 | A0 | S1 | S2 | S3
  deriving DecidableEq, Repr

/-- Licensee features tracking the three letter runs. -/
inductive ABCLic where
  | fa | fb | fc
  deriving DecidableEq, Repr

/-- Lexical items for the direct minimalist derivation of three equal letter runs. -/
def abcDirectLexicon : List (List ABCTerm × List (MGFeature ABCBase ABCLic)) :=
  [ ([.c], [.cat .C0, .licensee .fc]),
    ([.b], [.sel .C0, .cat .B0, .licensee .fb]),
    ([.a], [.sel .B0, .cat .A0, .licensee .fa]),
    ([],   [.sel .A0, .cat .Loop]),
    ([.c], [.sel .Loop, .licensor .fc, .cat .S1, .licensee .fc]),
    ([.b], [.sel .S1, .licensor .fb, .cat .S2, .licensee .fb]),
    ([.a], [.sel .S2, .licensor .fa, .cat .S3, .licensee .fa]),
    ([],   [.sel .S3, .cat .Loop]),
    ([],   [.sel .Loop, .licensor .fc, .licensor .fb, .licensor .fa, .cat .Start]) ]

/-- Direct 9-item Minimalist Grammar generating `{ a^n b^n c^n | n ≥ 1 }`. -/
def abcDirectMG : MG ABCBase ABCLic ABCTerm where
  start := .Start
  lexicon := abcDirectLexicon
  lex_nonempty := by
    intro e he
    simp only [abcDirectLexicon, List.mem_cons, List.not_mem_nil, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp

theorem replicate_append_singleton {α : Type} (n : Nat) (x : α) :
    List.replicate n x ++ [x] = List.replicate (n + 1) x := by
  induction n with
  | zero => rfl
  | succ k ih => simp [List.replicate_succ, ih]

theorem abcDirectMG_loop :
    ∀ n, 1 ≤ n →
      MG.Derives abcDirectMG
        ⟨false, ⟨[], [.cat .Loop]⟩,
          [⟨List.replicate n .a, [.licensee .fa]⟩,
           ⟨List.replicate n .b, [.licensee .fb]⟩,
           ⟨List.replicate n .c, [.licensee .fc]⟩]⟩ := by
  intro n
  induction n with
  | zero => intro h; omega
  | succ k ih =>
    intro _
    cases k with
    | zero =>
      -- Base case n = 1
      have hC0 : MG.Derives abcDirectMG ⟨true, ⟨[.c], [.cat .C0, .licensee .fc]⟩, []⟩ :=
        MG.Derives.lex (by simp [abcDirectMG, abcDirectLexicon])
      have hB0lex : MG.Derives abcDirectMG ⟨true, ⟨[.b], [.sel .C0, .cat .B0, .licensee .fb]⟩, []⟩ :=
        MG.Derives.lex (by simp [abcDirectMG, abcDirectLexicon])
      have hB0 : MG.Derives abcDirectMG
          ⟨false, ⟨[.b], [.cat .B0, .licensee .fb]⟩, [⟨[.c], [.licensee .fc]⟩]⟩ :=
        MG.Derives.merge3 hB0lex hC0 ⟨by intro c hc; simp at hc; subst hc; exact ⟨.fc, [], rfl⟩, by decide⟩
      have hA0lex : MG.Derives abcDirectMG ⟨true, ⟨[.a], [.sel .B0, .cat .A0, .licensee .fa]⟩, []⟩ :=
        MG.Derives.lex (by simp [abcDirectMG, abcDirectLexicon])
      have hA0 : MG.Derives abcDirectMG
          ⟨false, ⟨[.a], [.cat .A0, .licensee .fa]⟩,
            [⟨[.b], [.licensee .fb]⟩, ⟨[.c], [.licensee .fc]⟩]⟩ :=
        MG.Derives.merge3 hA0lex hB0
          ⟨by intro c hc; simp at hc; rcases hc with rfl | rfl; exact ⟨.fb, [], rfl⟩; exact ⟨.fc, [], rfl⟩,
           by decide⟩
      have hLlex : MG.Derives abcDirectMG ⟨true, ⟨[], [.sel .A0, .cat .Loop]⟩, []⟩ :=
        MG.Derives.lex (by simp [abcDirectMG, abcDirectLexicon])
      exact MG.Derives.merge3 hLlex hA0
        ⟨by intro c hc; simp at hc; rcases hc with rfl | rfl | rfl
            · exact ⟨.fa, [], rfl⟩
            · exact ⟨.fb, [], rfl⟩
            · exact ⟨.fc, [], rfl⟩,
         by decide⟩
    | succ k' =>
      -- Inductive step: n = k' + 1 → n + 1
      let m := k' + 1
      have hprev := ih (by omega)
      -- 1. Advance c^m → c^{m+1}
      have hS1lex : MG.Derives abcDirectMG
          ⟨true, ⟨[.c], [.sel .Loop, .licensor .fc, .cat .S1, .licensee .fc]⟩, []⟩ :=
        MG.Derives.lex (by simp [abcDirectMG, abcDirectLexicon])
      have hS1a : MG.Derives abcDirectMG
          ⟨false, ⟨[.c], [.licensor .fc, .cat .S1, .licensee .fc]⟩,
            [⟨List.replicate m .a, [.licensee .fa]⟩,
             ⟨List.replicate m .b, [.licensee .fb]⟩] ++
            ⟨List.replicate m .c, [.licensee .fc]⟩ :: []⟩ := by
        simpa [m] using MG.Derives.merge1 hS1lex hprev
      have hS1 : MG.Derives abcDirectMG
          ⟨false, ⟨List.replicate (m + 1) .c, [.cat .S1, .licensee .fc]⟩,
            [⟨List.replicate m .a, [.licensee .fa]⟩,
             ⟨List.replicate m .b, [.licensee .fb]⟩]⟩ := by
        simpa [replicate_append_singleton] using MG.Derives.move1 hS1a
      -- 2. Advance b^m → b^{m+1}
      have hS2lex : MG.Derives abcDirectMG
          ⟨true, ⟨[.b], [.sel .S1, .licensor .fb, .cat .S2, .licensee .fb]⟩, []⟩ :=
        MG.Derives.lex (by simp [abcDirectMG, abcDirectLexicon])
      have hS2a : MG.Derives abcDirectMG
          ⟨false, ⟨[.b], [.licensor .fb, .cat .S2, .licensee .fb]⟩,
            [⟨List.replicate (m + 1) .c, [.licensee .fc]⟩,
             ⟨List.replicate m .a, [.licensee .fa]⟩] ++
            ⟨List.replicate m .b, [.licensee .fb]⟩ :: []⟩ := by
        have h3 := MG.Derives.merge3 hS2lex hS1
          ⟨by intro c hc; simp at hc; rcases hc with rfl | rfl | rfl
              · exact ⟨.fc, [], rfl⟩
              · exact ⟨.fa, [], rfl⟩
              · exact ⟨.fb, [], rfl⟩,
           by simp [MGChain.headLic]⟩
        simpa using h3
      have hS2 : MG.Derives abcDirectMG
          ⟨false, ⟨List.replicate (m + 1) .b, [.cat .S2, .licensee .fb]⟩,
            [⟨List.replicate (m + 1) .c, [.licensee .fc]⟩,
             ⟨List.replicate m .a, [.licensee .fa]⟩]⟩ := by
        simpa [replicate_append_singleton] using MG.Derives.move1 hS2a
      -- 3. Advance a^m → a^{m+1}
      have hS3lex : MG.Derives abcDirectMG
          ⟨true, ⟨[.a], [.sel .S2, .licensor .fa, .cat .S3, .licensee .fa]⟩, []⟩ :=
        MG.Derives.lex (by simp [abcDirectMG, abcDirectLexicon])
      have hS3a : MG.Derives abcDirectMG
          ⟨false, ⟨[.a], [.licensor .fa, .cat .S3, .licensee .fa]⟩,
            [⟨List.replicate (m + 1) .b, [.licensee .fb]⟩,
             ⟨List.replicate (m + 1) .c, [.licensee .fc]⟩] ++
            ⟨List.replicate m .a, [.licensee .fa]⟩ :: []⟩ := by
        have h3 := MG.Derives.merge3 hS3lex hS2
          ⟨by intro c hc; simp at hc; rcases hc with rfl | rfl | rfl
              · exact ⟨.fb, [], rfl⟩
              · exact ⟨.fc, [], rfl⟩
              · exact ⟨.fa, [], rfl⟩,
           by simp [MGChain.headLic]⟩
        simpa using h3
      have hS3 : MG.Derives abcDirectMG
          ⟨false, ⟨List.replicate (m + 1) .a, [.cat .S3, .licensee .fa]⟩,
            [⟨List.replicate (m + 1) .b, [.licensee .fb]⟩,
             ⟨List.replicate (m + 1) .c, [.licensee .fc]⟩]⟩ := by
        simpa [replicate_append_singleton] using MG.Derives.move1 hS3a
      -- 4. Park a^{m+1} and close loop
      have hLlex : MG.Derives abcDirectMG ⟨true, ⟨[], [.sel .S3, .cat .Loop]⟩, []⟩ :=
        MG.Derives.lex (by simp [abcDirectMG, abcDirectLexicon])
      exact MG.Derives.merge3 hLlex hS3
        ⟨by intro c hc; simp at hc; rcases hc with rfl | rfl | rfl
            · exact ⟨.fa, [], rfl⟩
            · exact ⟨.fb, [], rfl⟩
            · exact ⟨.fc, [], rfl⟩,
         by simp [MGChain.headLic]⟩

/-- Every word `a^n b^n c^n` (`n ≥ 1`) is generated by the direct 9-item Minimalist Grammar. -/
theorem abcDirectMG_generates_all (n : Nat) (hn : 1 ≤ n) :
    abcDirectMG.Lang (abcWord n) := by
  have hLoop := abcDirectMG_loop n hn
  have hFinLex : MG.Derives abcDirectMG
      ⟨true, ⟨[], [.sel .Loop, .licensor .fc, .licensor .fb, .licensor .fa, .cat .Start]⟩, []⟩ :=
    MG.Derives.lex (by simp [abcDirectMG, abcDirectLexicon])
  have h1 : MG.Derives abcDirectMG
      ⟨false, ⟨[], [.licensor .fc, .licensor .fb, .licensor .fa, .cat .Start]⟩,
        [⟨List.replicate n .a, [.licensee .fa]⟩,
         ⟨List.replicate n .b, [.licensee .fb]⟩] ++
        ⟨List.replicate n .c, [.licensee .fc]⟩ :: []⟩ := by
    simpa using MG.Derives.merge1 hFinLex hLoop
  have h2 : MG.Derives abcDirectMG
      ⟨false, ⟨List.replicate n .c, [.licensor .fb, .licensor .fa, .cat .Start]⟩,
        [⟨List.replicate n .a, [.licensee .fa]⟩] ++
        ⟨List.replicate n .b, [.licensee .fb]⟩ :: []⟩ := by
    simpa using MG.Derives.move1 h1
  have h3 : MG.Derives abcDirectMG
      ⟨false, ⟨List.replicate n .b ++ List.replicate n .c, [.licensor .fa, .cat .Start]⟩,
        [] ++ ⟨List.replicate n .a, [.licensee .fa]⟩ :: []⟩ := by
    simpa using MG.Derives.move1 h2
  have h4 : MG.Derives abcDirectMG
      ⟨false, ⟨List.replicate n .a ++ (List.replicate n .b ++ List.replicate n .c), [.cat .Start]⟩,
        []⟩ := by
    simpa using MG.Derives.move1 h3
  refine ⟨false, ?_⟩
  change MG.Derives abcDirectMG ⟨false, ⟨abcWord n, [.cat .Start]⟩, []⟩
  simpa [abcWord, List.append_assoc] using h4

/-- Automatically compiled MCFG from the direct 9-item MG via Michaelis's construction. -/
def abcCompiledMCFG := MGtoMCFG.mgToMCFG abcDirectMG

/-- Every word `a^n b^n c^n` (`n ≥ 1`) is automatically transferred to `abcCompiledMCFG`. -/
theorem abcCompiledMCFG_generates_all (n : Nat) (hn : 1 ≤ n) :
    abcCompiledMCFG.Lang (abcWord n) :=
  (MGtoMCFG.mgToMCFG_lang abcDirectMG (abcWord n)).mpr (abcDirectMG_generates_all n hn)

/-- Concrete witness: `"aaabbbccc"` is generated by `abcCompiledMCFG`. -/
theorem aaabbbccc_in_abcCompiledMCFG :
    abcCompiledMCFG.Lang [.a, .a, .a, .b, .b, .b, .c, .c, .c] :=
  abcCompiledMCFG_generates_all 3 (by omega)

end CrossSerialExample


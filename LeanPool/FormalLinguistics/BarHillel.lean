module

public import LeanPool.FormalLinguistics.ABGtoCFG
public import LeanPool.FormalLinguistics.CFGtoABG

/-!
  ==============================================================================
  Bar-Hillel, Gaifman & Shamir (1960) Equivalence Theorem in Lean 4
  ==============================================================================
  "On Categorial and Phrase-Structure Grammars",
  Bulletin of the Research Council of Israel, 9F(1), 1–16 (1960).

  Main machine-checked theorems (zero `sorry`, standard Lean 4 core only):
    1. `abg_to_cfg_equiv`: Every AB Categorial Grammar generates a context-free
       language (and never generates the empty string).
    2. `cfg_to_abg_equiv`: Every finite Context-Free Grammar has a finite AB
       Categorial Grammar generating precisely its non-empty strings.
    3. `bar_hillel_gaifman_shamir`: A formal language `L` is generated by an
       AB Categorial Grammar if and only if `L` is an ε-free Context-Free
       Language!
    4. Bonus corollary (`cfg_to_abg_unidirectional_depth2`): Every ε-free CFL is even
       generated by a unidirectional (right-slash only) AB grammar of slash
       depth ≤ 2.
-/

@[expose] public section

namespace FormalLinguistics

/-- Full computable translation: arbitrary finite CFG → finite AB Categorial Grammar. -/
def cfgToABG [DecidableEq N] [DecidableEq T] (G : CFG N T) : ABG (GNFNT (BinNT N T)) T :=
  GNFtoABG.toABG (CNFtoGNF.cnfToGNF (cfgToCNF G))

/-- Direction 1 (ABG → CFG):
    Every AB Categorial Grammar has a weakly equivalent Context-Free Grammar,
    and its language is ε-free. -/
theorem abg_to_cfg_equiv {P T : Type} (G : ABG P T) :
    (∀ w, G.toCFG.Lang w ↔ G.Lang w) ∧ ¬ G.Lang [] :=
  ⟨ABG.toCFG_lang G, fun h => ABG.lang_nonempty h rfl⟩

/-- Direction 2 (CFG → ABG):
    Every finite Context-Free Grammar has a finite AB Categorial Grammar
    generating precisely its non-empty strings. -/
theorem cfg_to_abg_equiv {N T : Type} [DecidableEq N] [DecidableEq T] (G : CFG N T) :
    ∀ w, (cfgToABG G).Lang w ↔ G.Lang w ∧ w ≠ [] := by
  intro w
  unfold cfgToABG
  rw [GNFtoABG.toABG_lang, CNFtoGNF.cnfToGNF_lang, cfgToCNF_lang]

/-- **Bar-Hillel, Gaifman & Shamir Theorem (1960)** for ε-free Context-Free Grammars:
    If `G` does not generate the empty string, then `cfgToABG G` is weakly equivalent to `G`. -/
theorem cfg_to_abg_eps_free {N T : Type} [DecidableEq N] [DecidableEq T]
    (G : CFG N T) (heps : ¬ G.Lang []) :
    ∀ w, (cfgToABG G).Lang w ↔ G.Lang w := by
  intro w
  rw [cfg_to_abg_equiv G w]
  constructor
  · exact And.left
  · intro h
    refine ⟨h, ?_⟩
    intro hnil
    subst hnil
    exact heps h

/-- Slash-nesting depth of a categorial type. -/
def Cat.depth {P : Type} : Cat P → Nat
  | Cat.atom _ => 0
  | Cat.rslash A B => 1 + max A.depth B.depth
  | Cat.lslash B A => 1 + max B.depth A.depth

/-- Whether a category uses only right slashes (`/`), i.e. unidirectional forward application. -/
def Cat.isRightOnly {P : Type} : Cat P → Prop
  | Cat.atom _ => True
  | Cat.rslash A B => A.isRightOnly ∧ B.isRightOnly
  | Cat.lslash _ _ => False

/-- Corollary (unidirectional normal form, after Bar-Hillel, Gaifman & Shamir 1960):
    Every ε-free Context-Free Language is generated by a *unidirectional* (right-slash only)
    AB Categorial Grammar whose lexical categories all have slash depth ≤ 2! -/
theorem cfg_to_abg_unidirectional_depth2 {N T : Type} [DecidableEq N] [DecidableEq T]
    (G : CFG N T) :
    ∀ a C, (a, C) ∈ (cfgToABG G).lexicon → C.isRightOnly ∧ C.depth ≤ 2 := by
  intro a C hmem
  rcases GNFtoABG.lex_shapes hmem with
    ⟨U, rfl, _⟩ | ⟨U, V, rfl, _⟩ | ⟨U, V, W, rfl, _⟩
  · simp [Cat.isRightOnly, Cat.depth]
  · simp [Cat.isRightOnly, Cat.depth]
  · simp [Cat.isRightOnly, Cat.depth]

/-- **Main Classification Theorem (Bar-Hillel, Gaifman & Shamir, 1960)**:
    For any alphabet `T` with decidable equality, a language `L : List T → Prop`
    is an AB Categorial Language if and only if `L` is an ε-free Context-Free Language. -/
theorem bar_hillel_gaifman_shamir {T : Type} [DecidableEq T] (L : List T → Prop) :
    (∃ (P : Type) (G : ABG P T), ∀ w, G.Lang w ↔ L w) ↔
    ((∃ (N : Type) (_ : DecidableEq N) (G : CFG N T), ∀ w, G.Lang w ↔ L w) ∧ ¬ L []) := by
  constructor
  · rintro ⟨P, G, hG⟩
    refine ⟨⟨Cat P, Classical.typeDecidableEq (Cat P), G.toCFG, ?_⟩, ?_⟩
    · intro w
      rw [ABG.toCFG_lang, hG]
    · intro hnil
      exact ABG.lang_nonempty ((hG []).mpr hnil) rfl
  · rintro ⟨⟨N, _, G, hG⟩, hne⟩
    refine ⟨GNFNT (BinNT N T), cfgToABG G, ?_⟩
    intro w
    have hGeps : ¬ G.Lang [] := fun h => hne ((hG []).mp h)
    rw [cfg_to_abg_eps_free G hGeps w, hG]

/-- Clean version where primitive categories / nonterminals carry `DecidableEq`. -/
theorem bar_hillel_gaifman_shamir_decidable {T : Type} [DecidableEq T] (L : List T → Prop) :
    (∃ (P : Type) (_ : DecidableEq P) (G : ABG P T), ∀ w, G.Lang w ↔ L w) ↔
    ((∃ (N : Type) (_ : DecidableEq N) (G : CFG N T), ∀ w, G.Lang w ↔ L w) ∧ ¬ L []) := by
  constructor
  · rintro ⟨P, _, G, hG⟩
    refine ⟨⟨Cat P, inferInstance, G.toCFG, ?_⟩, ?_⟩
    · intro w
      rw [ABG.toCFG_lang, hG]
    · intro hnil
      exact ABG.lang_nonempty ((hG []).mpr hnil) rfl
  · rintro ⟨⟨N, _, G, hG⟩, hne⟩
    refine ⟨GNFNT (BinNT N T), inferInstance, cfgToABG G, ?_⟩
    intro w
    have hGeps : ¬ G.Lang [] := fun h => hne ((hG []).mp h)
    rw [cfg_to_abg_eps_free G hGeps w, hG]

/-! ### Axiom Audit (just like verifying a formal proof release!) -/


end FormalLinguistics

/-! A plane projection of a curve has a nonzero kernel. If one coordinate is
transcendental, that kernel is generated by a single irreducible equation. -/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial

/-- A two-variable polynomial ring cannot inject, through linear coordinates,
into a coordinate ring with eventually linear Hilbert growth. -/
private theorem plane_projection_not_injective {K τ : Type*} [Field K] [Finite τ]
    (I : Ideal (MvPolynomial τ K)) (a : Fin 2 → MvPolynomial τ K)
    (ha : ∀ i, (a i).totalDegree ≤ 1) (d : ℕ)
    (hdegree : HasFilteredCurveDegree I d) :
    ¬ Function.Injective (projectionCoordinateMap I a) := by
  classical
  let := Fintype.ofFinite τ
  intro hinj
  have hlow (M : ℕ) : (M + 2).choose 2 ≤ Module.finrank K (filteredCoordinateSpace I M) := by
    let V := restrictTotalDegree (Fin 2) K M
    let ψ := projectionCoordinateMap I a
    let T : V →ₗ[K] filteredCoordinateSpace I M :=
      (ψ.toLinearMap.comp V.subtype).codRestrict _ (fun v =>
        projectionCoordinateMap_filtered I a ha v.val
          ((mem_restrictTotalDegree _ _ _).mp v.property))
    have hi : Function.Injective T := by
      intro x y h
      apply Subtype.ext
      apply hinj
      exact congrArg Subtype.val h
    have hh := LinearMap.finrank_le_finrank_of_injective hi
    rwa [finrank_restrictTotalDegree_two] at hh
  obtain ⟨N₀, c, hN₀⟩ := hdegree
  let M := 4 * (d + c.natAbs + N₀ + 1)
  have hM : N₀ ≤ M := by dsimp [M]; omega
  have he := hN₀ M hM
  have hlo : (((M + 2).choose 2 : ℕ) : ℤ) ≤ (d : ℤ) * M + c := by
    rw [← he]
    exact_mod_cast hlow M
  have hchoose : (2 : ℤ) * ((M + 2).choose 2 : ℕ) = ((M : ℤ) + 2) * (M + 1) := by
    exact_mod_cast two_mul_choose_add_two M
  have hm4d : (4 : ℤ) * d ≤ M := by
    simp only [M, Nat.cast_mul, Nat.cast_add, Nat.cast_one, Nat.cast_ofNat]; omega
  have hm4c : (4 : ℤ) * c.natAbs + 4 ≤ M := by
    simp only [M, Nat.cast_mul, Nat.cast_add, Nat.cast_one, Nat.cast_ofNat]; omega
  have hprod := mul_le_mul_of_nonneg_right hm4d (Nat.cast_nonneg M : (0 : ℤ) ≤ M)
  have hc : c ≤ (c.natAbs : ℤ) := Int.le_natAbs
  nlinarith

/-- An irreducible equation in a plane map with a transcendental coordinate
generates its entire kernel. The proof uses the filtered section-rank bound. -/
private theorem plane_map_eq_zero_iff_dvd {K A : Type*} [Field K] [CommRing A] [Algebra K A]
    (f : MvPolynomial (Fin 2) K) (hf : Irreducible f)
    (ψ : MvPolynomial (Fin 2) K →ₐ[K] A) (hψ : ψ f = 0)
    (j : Fin 2) (hj : Transcendental K (ψ (X j)))
    (g : MvPolynomial (Fin 2) K) : ψ g = 0 ↔ f ∣ g := by
  constructor
  · intro hg
    by_contra hnd
    let p : Ideal (MvPolynomial (Fin 2) K) := Ideal.span {f}
    have : p.IsPrime := Ideal.isPrime_span_singleton_of_prime hf.prime
    let φ : (MvPolynomial (Fin 2) K ⧸ p) →ₐ[K] A :=
      Ideal.Quotient.liftₐ p ψ (by
        intro l hl
        obtain ⟨u, rfl⟩ := Ideal.mem_span_singleton.mp hl
        rw [map_mul, hψ, zero_mul])
    have hφ (l : MvPolynomial (Fin 2) K) : φ ((Ideal.Quotient.mk p) l) = ψ l := rfl
    let N := f.totalDegree * g.totalDegree + 1
    let h : Fin N → MvPolynomial (Fin 2) K := fun i => X j ^ i.val
    have hi : LinearIndependent K (fun i => φ ((Ideal.Quotient.mk p) (h i))) := by
      simpa only [hφ, h, map_pow] using transcendental_powers_independent (ψ (X j)) hj N
    have hh := section_image_rank_le p f.totalDegree
      ⟨f.totalDegree, (f.totalDegree : ℤ) - f.totalDegree.choose 2,
        fun M hM => principal_plane_hilbert_function f hf.ne_zero hM⟩
      φ h hi g (by simpa only [p, Ideal.mem_span_singleton] using hnd) g.totalDegree le_rfl
      (by rw [hφ]; exact hg)
    simp only [Fintype.card_fin, N] at hh
    omega
  · rintro ⟨u, rfl⟩
    rw [map_mul, hψ, zero_mul]

/-- A linear plane projection with a transcendental coordinate has a
principal prime kernel with an irreducible generator. -/
theorem exists_plane_projection_equation {K τ : Type*} [Field K] [Finite τ]
    (I : Ideal (MvPolynomial τ K)) [I.IsPrime]
    (a : Fin 2 → MvPolynomial τ K) (ha : ∀ i, (a i).totalDegree ≤ 1)
    (d : ℕ) (hdegree : HasFilteredCurveDegree I d)
    (j : Fin 2) (hj : Transcendental K ((Ideal.Quotient.mk I) (a j))) :
    ∃ f : MvPolynomial (Fin 2) K, Irreducible f ∧
      RingHom.ker (projectionCoordinateMap I a) = Ideal.span {f} := by
  classical
  let := Fintype.ofFinite τ
  let ψ := projectionCoordinateMap I a
  have hker : RingHom.ker ψ ≠ ⊥ := by
    intro he
    exact plane_projection_not_injective I a ha d hdegree
      ((RingHom.injective_iff_ker_eq_bot ψ.toRingHom).mpr he)
  have hprime : (RingHom.ker ψ).IsPrime := RingHom.ker_isPrime ψ.toRingHom
  obtain ⟨f, hfmem, hf⟩ := hprime.exists_mem_prime_of_ne_bot hker
  refine ⟨f, hf.irreducible, ?_⟩
  ext g
  exact (plane_map_eq_zero_iff_dvd f hf.irreducible ψ hfmem j
    (by
      change Transcendental K (projectionCoordinateMap I a (X j))
      rw [projectionCoordinateMap, AlgHom.comp_apply, aeval_X]
      exact hj) g).trans
    Ideal.mem_span_singleton.symm

end
end CCDN

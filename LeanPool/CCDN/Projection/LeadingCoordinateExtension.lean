/-! Extending a linear projection by one leading coordinate. Integrality and
algebraic independence of the tail coordinates pass to the extended projection;
for a homogeneous prime whose function field is generated by the extended
coordinates, the image is a hypersurface cut out by a form of exactly the
original degree. -/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial

/-- Restricting the projection along `l` to the tail variables gives the projection along the
tail of `l`. -/
private theorem projectionCoordinateMap_comp_rename_succ {K τ : Type*} [Field K] {m : ℕ}
    (I : Ideal (MvPolynomial τ K)) (l : Fin (m + 1) → MvPolynomial τ K) :
    (projectionCoordinateMap I l).comp (rename Fin.succ) =
      projectionCoordinateMap I (fun i : Fin m => l i.succ) := by
  ext i
  simp [projectionCoordinateMap]

/-- A projection is integral as soon as the projection along its tail coordinates is. -/
theorem projectionCoordinateMap_isIntegral_of_tail {K τ : Type*} [Field K] {m : ℕ}
    (I : Ideal (MvPolynomial τ K)) (l : Fin (m + 1) → MvPolynomial τ K)
    (h : (projectionCoordinateMap I (fun i : Fin m => l i.succ)).IsIntegral) :
    (projectionCoordinateMap I l).IsIntegral := by
  apply RingHom.IsIntegral.tower_top (rename Fin.succ).toRingHom
    (projectionCoordinateMap I l).toRingHom
  change ((projectionCoordinateMap I l).comp (rename Fin.succ)).IsIntegral
  rwa [projectionCoordinateMap_comp_rename_succ]

/-- If the projection along the tail coordinates is injective, the images of the tail
variables under the extended projection are algebraically independent. -/
private theorem algebraicIndependent_projectionCoordinateMap_X_succ {K τ : Type*} [Field K] {m : ℕ}
    (I : Ideal (MvPolynomial τ K)) (l : Fin (m + 1) → MvPolynomial τ K)
    (h : Function.Injective (projectionCoordinateMap I (fun i : Fin m => l i.succ))) :
    AlgebraicIndependent K (fun i : Fin m => projectionCoordinateMap I l (X i.succ)) := by
  have hl : (fun i : Fin m => projectionCoordinateMap I l (X i.succ)) =
      fun i => Ideal.Quotient.mk I (l i.succ) := by
    funext i
    simp [projectionCoordinateMap]
  rw [hl]
  exact injective_projectionCoordinateMap_iff.mp h

/-- Extending a finite injective projection of a prime of projective dimension `m` and degree
`d` by one linear coordinate gives a hypersurface equation: the kernel is generated by an
irreducible polynomial of positive total degree at most `d`. -/
theorem exists_extended_projection_equation_degree_le
    {K τ : Type*} [Field K] [Fintype τ] [LinearOrder τ] {m : ℕ}
    (I : Ideal (MvPolynomial τ K)) [I.IsPrime]
    (l : Fin (m + 2) → MvPolynomial τ K) (hl : ∀ i, (l i).totalDegree ≤ 1)
    (hinj : Function.Injective (projectionCoordinateMap I (fun i : Fin (m + 1) => l i.succ)))
    (d : ℕ) (hdimdeg : HasProjectiveDimensionDegree I m d) :
    ∃ f : MvPolynomial (Fin (m + 2)) K, Irreducible f ∧
      0 < f.totalDegree ∧ f.totalDegree ≤ d ∧
      RingHom.ker (projectionCoordinateMap I l) = Ideal.span {f} :=
  exists_hypersurface_projection_equation_degree_le I l hl d hdimdeg (fun i => X i.succ)
    (fun _ => by simp) (algebraicIndependent_projectionCoordinateMap_X_succ I l hinj)

/-- A finite birational projection of a homogeneous prime of projective dimension `m` and
degree `d`, obtained by extending a finite injective linear projection by one linear form and
generating the function field, has image a hypersurface cut out by an irreducible form of
degree exactly `d`. -/
theorem exists_homogeneous_extended_projection_equation
    {K F τ : Type*} [Field K] [Field F] [Algebra K F] [Fintype τ] [LinearOrder τ] {m : ℕ}
    (I : Ideal (MvPolynomial τ K)) [I.IsPrime]
    [Algebra (MvPolynomial τ K ⧸ I) F] [IsScalarTower K (MvPolynomial τ K ⧸ I) F]
    [IsFractionRing (MvPolynomial τ K ⧸ I) F]
    (hI : IsHomogeneousIdeal I)
    (l : Fin (m + 2) → MvPolynomial τ K) (hl : ∀ i, (l i).IsHomogeneous 1)
    (hint : (projectionCoordinateMap I (fun i : Fin (m + 1) => l i.succ)).IsIntegral)
    (hinj : Function.Injective (projectionCoordinateMap I (fun i : Fin (m + 1) => l i.succ)))
    (hfield : IntermediateField.adjoin K
      (Set.range (fun i => algebraMap (MvPolynomial τ K ⧸ I) F
        ((Ideal.Quotient.mk I) (l i)))) = ⊤)
    (d : ℕ) (hdimdeg : HasProjectiveDimensionDegree I m d) :
    ∃ f : MvPolynomial (Fin (m + 2)) K,
      Irreducible f ∧ f.IsHomogeneous d ∧ f.totalDegree = d ∧ 0 < d ∧
      RingHom.ker (projectionCoordinateMap I l) = Ideal.span {f} := by
  obtain ⟨f, hf, hfpos, _, hker⟩ := exists_extended_projection_equation_degree_le I l
    (fun i => (hl i).totalDegree_le) hinj d hdimdeg
  have hlead := homogeneous_finite_birational_projection_leadingCoeff_eq (F := F) I hI l hl
    (projectionCoordinateMap_isIntegral_of_tail I l hint) hfield
  rw [hker, principal_filteredHilbertPolynomial_leadingCoeff f hf.ne_zero hfpos,
    hdimdeg.leadingCoeff_eq] at hlead
  have hfdeg : f.totalDegree = d := by
    have hh := (div_left_inj' (by positivity : ((m + 1).factorial : ℚ) ≠ 0)).mp hlead
    exact_mod_cast hh
  refine ⟨f, hf, ?_, hfdeg, hfdeg ▸ hfpos, hker⟩
  rw [← hfdeg]
  exact homogeneous_projection_equation I hI l hl f hf.ne_zero hker

end
end CCDN

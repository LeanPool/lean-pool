/- Modified for Lean Pool: module paths, toolchain compatibility, and quality repairs.
Upstream: jasondavies/ccdn-dimension-growth @ bb025e7207f3a35a21b898629f5678b72aa7e44f. -/

public import LeanPool.CCDN.Hilbert.LinearProjectionFiltration
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
public import Mathlib.RingTheory.IntegralClosure.IsIntegral.Defs
import LeanPool.CCDN.Projection.PrimitiveCoordinateField

/-! The field generated by projected coordinates is the fraction field
of the image coordinate ring. Its inclusion in the source function
field is constructed and identified on every coordinate-ring element. -/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial

variable {K F σ τ : Type*} [Field K] [Field F] [Algebra K F]
variable (I : Ideal (MvPolynomial τ K))
variable [Algebra (MvPolynomial τ K ⧸ I) F] [IsScalarTower K (MvPolynomial τ K ⧸ I) F]
variable (a : σ → MvPolynomial τ K)

/-- The subfield of `F` generated over `K` by the images of the forms `a` in the quotient by `I`;
for `F` the function field of `I`, it is the function field of the image of the projection by `a`.
-/
def projectionImageField : IntermediateField K F :=
  IntermediateField.adjoin K (Set.range (fun i =>
    algebraMap (MvPolynomial τ K ⧸ I) F ((Ideal.Quotient.mk I) (a i))))

/-- The forms `a` give a Noether normalization of the quotient by `I`: the coordinate map
`K[y] → K[x]/I` is integral and injective, that is, the forms are algebraically independent
modulo `I` and the quotient is finite over the polynomial ring they generate. -/
structure IsNoetherNormalization : Prop where
  /-- The quotient by `I` is integral over the subring generated by the forms. -/
  integral : (projectionCoordinateMap I a).IsIntegral
  /-- The forms are algebraically independent modulo `I`. -/
  injective : Function.Injective (projectionCoordinateMap I a)

/-- The forms `a` map the variety of the prime `I` birationally onto the hypersurface `f = 0`:
the images of the forms generate the function field of `I`, and the kernel of the coordinate map
`K[y] → K[x]/I` is generated by the irreducible polynomial `f`. -/
structure IsBirationalImage [I.IsPrime] (f : MvPolynomial σ K) : Prop where
  /-- The images of the forms generate the function field of `I`. -/
  birational : projectionImageField (F := FractionRing (MvPolynomial τ K ⧸ I)) I a = ⊤
  /-- The image equation `f` is irreducible. -/
  irreducible : Irreducible f
  /-- The kernel of the coordinate map is the principal ideal generated by `f`. -/
  ker_eq : RingHom.ker (projectionCoordinateMap I a) = Ideal.span {f}

/-- The forms `a` define a finite birational projection of the variety of the prime `I` onto
the hypersurface `f = 0`: a birational image whose coordinate map `K[y] → K[x]/I` is moreover
integral. -/
structure IsBirationalProjection [I.IsPrime] (f : MvPolynomial σ K) : Prop
    extends IsBirationalImage I a f where
  /-- The quotient by `I` is integral over the subring generated by the forms. -/
  integral : (projectionCoordinateMap I a).IsIntegral

variable {I} in
/-- For a birational image onto `f = 0`, a polynomial in the forms lies in the ideal exactly when
it is a multiple of `f`. -/
lemma IsBirationalImage.aeval_mem_iff [I.IsPrime] {a : σ → MvPolynomial τ K}
    {f : MvPolynomial σ K} (h : IsBirationalImage I a f) (g : MvPolynomial σ K) :
    aeval a g ∈ I ↔ f ∣ g := by
  rw [← Ideal.mem_span_singleton, ← h.ker_eq, RingHom.mem_ker]
  exact Ideal.Quotient.eq_zero_iff_mem.symm

variable {I} in
/-- The image equation of a birational image vanishes on the variety: substituting the forms
into it gives an element of the ideal. -/
lemma IsBirationalImage.aeval_mem [I.IsPrime] {a : σ → MvPolynomial τ K}
    {f : MvPolynomial σ K} (h : IsBirationalImage I a f) : aeval a f ∈ I :=
  (h.aeval_mem_iff f).mpr dvd_rfl

/-- The image of the form `a i` in `F`, as an element of the field generated by the projected
coordinates. -/
def projectionImageCoordinate (i : σ) : projectionImageField (F := F) I a :=
  ⟨algebraMap (MvPolynomial τ K ⧸ I) F ((Ideal.Quotient.mk I) (a i)),
    IntermediateField.subset_adjoin K _ ⟨i, rfl⟩⟩

/-- Evaluating a polynomial at the projected coordinates and including the result in `F` agrees with
applying the projection map to the quotient by `I` and then mapping to `F`. -/
lemma projectionImageCoordinate_eval_comp :
    (projectionImageField (F := F) I a).val.comp (aeval (projectionImageCoordinate (F := F) I a)) =
      (IsScalarTower.toAlgHom K (MvPolynomial τ K ⧸ I) F).comp (projectionCoordinateMap I a) := by
  ext i
  simp only [AlgHom.comp_apply, aeval_X, projectionCoordinateMap, Ideal.Quotient.mkₐ_eq_mk]
  rfl

/-- The image coordinate ring embeds into the generated image field. -/
def projectionImageFieldMap :
    (MvPolynomial σ K ⧸ RingHom.ker (projectionCoordinateMap I a)) →ₐ[K]
      projectionImageField (F := F) I a :=
  Ideal.Quotient.liftₐ _ (aeval (projectionImageCoordinate (F := F) I a)) (by
    intro p hp
    apply (projectionImageField (F := F) I a).val.injective
    have he := DFunLike.congr_fun (projectionImageCoordinate_eval_comp (F := F) I a) p
    change ((aeval (projectionImageCoordinate (F := F) I a)) p : F) =
      algebraMap (MvPolynomial τ K ⧸ I) F ((projectionCoordinateMap I a) p) at he
    change ((aeval (projectionImageCoordinate (F := F) I a)) p : F) = 0
    exact he.trans (by rw [hp, map_zero]))


/-- The embedding of the image coordinate ring into the image field, followed by the inclusion into
`F`, is the induced map from the image coordinate ring to the quotient by `I`, followed by the map
to `F`. -/
lemma projectionImageFieldMap_comp_val :
    (projectionImageField (F := F) I a).val.comp (projectionImageFieldMap (F := F) I a) =
      (IsScalarTower.toAlgHom K (MvPolynomial τ K ⧸ I) F).comp
        (Ideal.kerLiftAlg (projectionCoordinateMap I a)) := by
  apply AlgHom.ext
  intro x
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact DFunLike.congr_fun (projectionImageCoordinate_eval_comp (F := F) I a) p

private lemma projectionImageFieldMap_X (i : σ) :
    projectionImageFieldMap (F := F) I a
      ((Ideal.Quotient.mk (RingHom.ker (projectionCoordinateMap I a))) (X i)) =
      projectionImageCoordinate (F := F) I a i := by
  change (aeval (projectionImageCoordinate (F := F) I a)) (X i) = _
  rw [aeval_X]

/-- When `F` is the fraction field of the quotient by the prime `I`, the embedding of the image
coordinate ring into the image field is injective. -/
lemma projectionImageFieldMap_injective [I.IsPrime] [IsFractionRing (MvPolynomial τ K ⧸ I) F] :
    Function.Injective (projectionImageFieldMap (F := F) I a) := by
  intro x y h
  apply Ideal.kerLiftAlg_injective (projectionCoordinateMap I a)
  apply IsFractionRing.injective (MvPolynomial τ K ⧸ I) F
  have hx := DFunLike.congr_fun (projectionImageFieldMap_comp_val (F := F) I a) x
  have hy := DFunLike.congr_fun (projectionImageFieldMap_comp_val (F := F) I a) y
  exact hx.symm.trans ((congrArg (projectionImageField (F := F) I a).val h).trans hy)


private lemma projectionImageFieldMap_generates :
    IntermediateField.adjoin K (Set.range (fun i => projectionImageFieldMap (F := F) I a
      ((Ideal.Quotient.mk (RingHom.ker (projectionCoordinateMap I a))) (X i)))) = ⊤ := by
  let L := projectionImageField (F := F) I a
  apply IntermediateField.lift_injective L
  rw [IntermediateField.lift_adjoin, IntermediateField.lift_top, ← Set.range_comp]
  simp only [Function.comp_def, projectionImageFieldMap_X]
  rfl

/-- When `F` is the fraction field of the quotient by the prime `I`, the field generated by the
projected coordinates is a fraction field of the image coordinate ring. -/
theorem projectionImageFieldMap_isFractionRing
    [I.IsPrime] [IsFractionRing (MvPolynomial τ K ⧸ I) F] :
    let : Algebra (MvPolynomial σ K ⧸ RingHom.ker (projectionCoordinateMap I a))
      (projectionImageField (F := F) I a) :=
      (projectionImageFieldMap (F := F) I a).toRingHom.toAlgebra
    IsFractionRing (MvPolynomial σ K ⧸ RingHom.ker (projectionCoordinateMap I a))
      (projectionImageField (F := F) I a) :=
  isFractionRing_of_generating_tuple (projectionImageFieldMap (F := F) I a)
    (projectionImageFieldMap_injective I a) (fun i => (Ideal.Quotient.mk _) (X i))
    (projectionImageFieldMap_generates I a)

end
end CCDN

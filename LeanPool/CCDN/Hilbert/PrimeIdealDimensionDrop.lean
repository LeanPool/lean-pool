/-! A strict containment of affine prime ideals strictly lowers the
Hilbert dimension. The proof uses a polynomial in their difference. -/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial

private theorem prime_ideal_strict_hilbert_dimension_drop
    {K : Type*} [Field K] {n m : ℕ}
    (I J : Ideal (MvPolynomial (Fin n) K)) [I.IsPrime]
    (hdim : (filteredHilbertPolynomial I).natDegree = m + 1)
    (hJ : J ≠ ⊤) (hIJ : I < J) :
    (filteredHilbertPolynomial J).natDegree ≤ m := by
  obtain ⟨f, hfJ, hfI⟩ := IsConcreteLE.not_le_iff_exists.mp (not_le_of_gt hIJ)
  have hsection : I ⊔ Ideal.span {f} ≤ J :=
    sup_le hIJ.le (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hfJ))
  have hsectionproper : I ⊔ Ideal.span {f} ≠ ⊤ :=
    fun h => hJ (top_le_iff.mp (h ▸ hsection))
  have hfdeg : 0 < f.totalDegree := by
    by_contra! h
    have he := totalDegree_eq_zero_iff_eq_C.mp (Nat.eq_zero_of_le_zero h)
    have hc : f.coeff 0 ≠ 0 := by
      intro hc
      apply hfI
      rw [he, hc, map_zero]
      exact I.zero_mem
    have hu : IsUnit f := by
      rw [he]
      exact (isUnit_iff_ne_zero.mpr hc).map C
    exact hJ (Ideal.eq_top_of_isUnit_mem J hfJ hu)
  exact (filteredHilbertPolynomial_natDegree_le J _ hJ
    (filteredCoordinateSpace_finrank_antitone_ideal _ _ hsection)).trans
      (proper_section_hilbert_dimension_leadingCoeff I m hdim f hfI hfdeg hsectionproper).1

/-- Distinct prime ideals of the same positive Hilbert dimension are not contained in one another.
-/
theorem prime_ideal_not_le_of_same_positive_dimension
    {K : Type*} [Field K] {n m : ℕ}
    (I J : Ideal (MvPolynomial (Fin n) K)) [I.IsPrime] [J.IsPrime]
    (hI : (filteredHilbertPolynomial I).natDegree = m + 1)
    (hJ : (filteredHilbertPolynomial J).natDegree = m + 1) (hne : I ≠ J) :
    ¬ I ≤ J := by
  intro h
  have hh := prime_ideal_strict_hilbert_dimension_drop I J hI
    (Ideal.IsPrime.ne_top ‹J.IsPrime›) (lt_of_le_of_ne h hne)
  omega

/-- A prime ideal in `n + 2` variables whose Hilbert polynomial has degree `n + 1`, that is a
projective hypersurface, is generated by one nonconstant prime element. -/
theorem exists_prime_generator_of_hilbert_dimension {n : ℕ}
    (I : Ideal (MvPolynomial (Fin (n + 2)) ℚ)) [hI : I.IsPrime]
    (hdim : (filteredHilbertPolynomial I).natDegree = n + 1) :
    ∃ p : MvPolynomial (Fin (n + 2)) ℚ, Prime p ∧ 0 < p.totalDegree ∧ I = Ideal.span {p} := by
  have hbot : I ≠ ⊥ := by
    rintro rfl
    rw [filteredHilbertPolynomial_bot, Polynomial.natDegree_preHilbertPoly,
      Fintype.card_fin] at hdim
    omega
  obtain ⟨p, hpI, hp⟩ := hI.exists_mem_prime_of_ne_bot hbot
  have hdeg : 0 < p.totalDegree :=
    totalDegree_pos_of_ne_zero_of_not_isUnit hp.ne_zero hp.not_isUnit
  have : (Ideal.span {p}).IsPrime := (Ideal.span_singleton_prime hp.ne_zero).mpr hp
  refine ⟨p, hp, hdeg, ?_⟩
  by_contra hne
  exact prime_ideal_not_le_of_same_positive_dimension (Ideal.span {p}) I
    (principal_filteredHilbertPolynomial_natDegree p hp.ne_zero hdeg) hdim (Ne.symm hne)
    ((Ideal.span_singleton_le_iff_mem I).mpr hpI)

end
end CCDN

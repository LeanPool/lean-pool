/-! Finite minimal-prime components and their filtered dimension budget.
The component family and zero-set cover are constructed here; eventual
linearity of their Hilbert functions is a separate hypothesis. -/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial

/-- The finite set of minimal primes over an ideal `I` of a Noetherian ring. -/
def minimalPrimeComponents {R : Type*} [CommRing R] [IsNoetherianRing R]
    (I : Ideal R) : Finset (Ideal R) :=
  (Ideal.finite_minimalPrimes_of_isNoetherianRing R I).toFinset

/-- `P` belongs to `minimalPrimeComponents I` exactly when it is a minimal prime over `I`. -/
@[simp]
lemma mem_minimalPrimeComponents {R : Type*} [CommRing R] [IsNoetherianRing R]
    {I P : Ideal R} : P ∈ minimalPrimeComponents I ↔ I.IsMinimalPrime P :=
  Set.Finite.mem_toFinset _

/-- Every member of `minimalPrimeComponents I` is a prime ideal. -/
lemma minimalPrimeComponents_isPrime {R : Type*} [CommRing R] [IsNoetherianRing R]
    {I P : Ideal R} (hP : P ∈ minimalPrimeComponents I) : P.IsPrime :=
  (mem_minimalPrimeComponents.mp hP).isPrime

/-- Every member of `minimalPrimeComponents I` contains `I`. -/
lemma le_minimalPrimeComponents {R : Type*} [CommRing R] [IsNoetherianRing R]
    {I P : Ideal R} (hP : P ∈ minimalPrimeComponents I) : I ≤ P :=
  (mem_minimalPrimeComponents.mp hP).le

/-- Two members of `minimalPrimeComponents I` that are comparable are equal. -/
lemma minimalPrimeComponents_eq_of_le {R : Type*} [CommRing R] [IsNoetherianRing R]
    {I P Q : Ideal R} (hP : P ∈ minimalPrimeComponents I)
    (hQ : Q ∈ minimalPrimeComponents I) (hPQ : P ≤ Q) : P = Q :=
  (mem_minimalPrimeComponents.mp hQ).eq_of_le
    (mem_minimalPrimeComponents.mp hP).prop hPQ

/-- The finite family is the minimal-prime decomposition, and its
rational zero sets cover exactly the original zero set. -/
theorem idealZeroLocus_eq_union_minimalPrimeComponents {n : ℕ}
    (I : Ideal (CoordinatePolynomial n)) :
    idealZeroLocus I = ⋃ P ∈ minimalPrimeComponents I, idealZeroLocus P := by
  ext x
  constructor
  · intro hx
    let J := RingHom.ker (eval x)
    have : J.IsPrime := RingHom.ker_isPrime (eval x)
    have hIJ : I ≤ J := by
      intro f hf
      exact hx f hf
    obtain ⟨P, hP, hPJ⟩ := Ideal.exists_minimalPrimes_le hIJ
    apply Set.mem_iUnion.mpr
    refine ⟨P, Set.mem_iUnion.mpr ⟨mem_minimalPrimeComponents.mpr hP, ?_⟩⟩
    intro f hf
    exact hPJ hf
  · intro hx
    obtain ⟨P, hxP⟩ := Set.mem_iUnion.mp hx
    obtain ⟨hP, hxP⟩ := Set.mem_iUnion.mp hxP
    intro f hf
    exact hxP f (le_minimalPrimeComponents hP hf)

/-- Separators for any finite family of incomparable prime ideals. -/
theorem exists_prime_component_separators {R ι : Type*} [CommRing R]
    [Finite ι] (P : ι → Ideal R)
    (hprime : ∀ i, (P i).IsPrime)
    (hanti : ∀ i j, P i ≤ P j → i = j) :
    ∃ a : ι → R, (∀ i, a i ∉ P i) ∧
      ∀ i j, i ≠ j → a i ∈ P j := by
  classical
  let := Fintype.ofFinite ι
  have hex (i : ι) : ∃ a : R, a ∉ P i ∧ ∀ j, i ≠ j → a ∈ P j := by
    have hw (j : {j : ι // j ≠ i}) : ∃ x : R, x ∈ P j.val ∧ x ∉ P i := by
      by_contra! h
      exact j.property (hanti j.val i h)
    choose w hwmem hwnot using hw
    have : (P i).IsPrime := hprime i
    refine ⟨∏ j, w j, ?_, ?_⟩
    · rw [Ideal.IsPrime.prod_mem_iff]
      rintro ⟨j, _, hj⟩
      exact hwnot j hj
    · intro j hij
      exact (P j).prod_mem (Finset.mem_univ (⟨j, Ne.symm hij⟩ : {j : ι // j ≠ i}))
        (hwmem ⟨j, Ne.symm hij⟩)
  choose a ha hsep using hex
  exact ⟨a, ha, hsep⟩

/-- The ideal generated by the two equations of an auxiliary section. -/
def polynomialSectionIdeal {K σ : Type*} [Field K] (f g : MvPolynomial σ K) :
    Ideal (MvPolynomial σ K) := Ideal.span {f, g}

/-- The first equation `f` lies in `polynomialSectionIdeal f g`. -/
lemma polynomialSectionIdeal_first_mem {K σ : Type*} [Field K]
    (f g : MvPolynomial σ K) : f ∈ polynomialSectionIdeal f g :=
  Ideal.subset_span (by simp)

/-- The second equation `g` lies in `polynomialSectionIdeal f g`. -/
lemma polynomialSectionIdeal_second_mem {K σ : Type*} [Field K]
    (f g : MvPolynomial σ K) : g ∈ polynomialSectionIdeal f g :=
  Ideal.subset_span (by simp)

/-- The zero locus of the ideal `(f, g)` is the intersection of the zero loci of `f` and `g`. -/
lemma idealZeroLocus_polynomialSectionIdeal {n : ℕ} (f g : CoordinatePolynomial n) :
    idealZeroLocus (polynomialSectionIdeal f g) = zeroLocus f ∩ zeroLocus g := by
  ext x
  constructor
  · intro hx
    exact ⟨hx f (polynomialSectionIdeal_first_mem f g),
      hx g (polynomialSectionIdeal_second_mem f g)⟩
  · rintro ⟨hxf, hxg⟩
    have hI : polynomialSectionIdeal f g ≤ RingHom.ker (eval x) := by
      apply Ideal.span_le.mpr
      intro p hp
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp
      rcases hp with rfl | rfl
      · exact hxf
      · exact hxg
    exact fun p hp => hI hp

end
end CCDN

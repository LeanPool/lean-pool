public import LeanPool.CCDN.Algebra.ProjectiveSection
public import LeanPool.CCDN.Height.ProjectiveZeroLocus
import LeanPool.CCDN.Hilbert.PlaneHilbert

/-! The homogeneous degree of a plane equation agrees with its
projective Hilbert degree, giving sharp projective plane intersection bounds. -/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial

variable {K : Type*} [Field K]

private theorem principal_projective_plane_hilbert_function
    (f : MvPolynomial (Fin 3) K) {d M : ℕ}
    (hf : f.IsHomogeneous d) (hf0 : f ≠ 0) (hM : d ≤ M) :
    (projectiveHilbertFunction (Ideal.span {f}) M : ℤ) =
      (d : ℤ) * M + ((d : ℤ) - d.choose 2) := by
  have h := principal_homogeneous_hilbert_count f hf hf0 hM
  rw [Nat.add_comm 2 (M - d), Nat.add_comm 2 M] at h
  rw [Nat.choose_symm_add, Nat.choose_symm_add] at h
  have h0 := two_mul_choose_add_two M
  have h1 := two_mul_choose_add_two (M - d)
  have h2 := Nat.descFactorial_eq_factorial_mul_choose d 2
  norm_num [Nat.descFactorial_succ] at h2
  have hsum : (projectiveHilbertFunction (Ideal.span {f}) M : ℤ) +
      ((M - d + 2).choose 2 : ℤ) = ((M + 2).choose 2 : ℤ) := by
    exact_mod_cast h
  have hc0 : (2 : ℤ) * ((M + 2).choose 2 : ℤ) = ((M : ℤ) + 2) * (M + 1) := by
    exact_mod_cast h0
  have hc1 : (2 : ℤ) * ((M - d + 2).choose 2 : ℤ) =
      ((M : ℤ) - d + 2) * ((M : ℤ) - d + 1) := by
    exact_mod_cast h1
  have hc2 : (2 : ℤ) * (d.choose 2 : ℤ) = (d : ℤ) * ((d : ℤ) - 1) := by
    cases d with
    | zero => simp
    | succ k =>
      simp only [Nat.add_sub_cancel] at h2
      push_cast
      have hcast : (k : ℤ) * (k + 1) = 2 * ((k + 1).choose 2 : ℤ) := by
        exact_mod_cast h2
      nlinarith
  nlinarith

/-- The ideal generated by a nonzero ternary form of degree `d` defines a projective plane curve of
degree `d`, in the sense of its Hilbert polynomial. -/
theorem principal_plane_hasProjectiveCurveDegree
    (f : MvPolynomial (Fin 3) K) {d : ℕ} (hf : f.IsHomogeneous d) (hf0 : f ≠ 0) :
    HasProjectiveCurveDegree (Ideal.span {f}) d :=
  ⟨d, (d : ℤ) - d.choose 2, fun _ hM =>
    principal_projective_plane_hilbert_function f hf hf0 hM⟩

/-- The projective zero locus of the ideal generated by a homogeneous polynomial `f` is the
projective zero locus of `f`. -/
theorem projectiveIdealZeroLocus_span_singleton {n d : ℕ}
    (f : MvPolynomial (Fin (n + 1)) K) (hf : f.IsHomogeneous d) :
    projectiveIdealZeroLocus (Ideal.span {f}) = projectiveZeroLocus f := by
  ext x
  constructor
  · intro hx
    exact projectiveIdealZeroLocus_rep hx f (Ideal.subset_span (by simp))
  · intro hx v hv hvx g hg
    have hfv : eval v f = 0 := by
      apply (mem_projectiveZeroLocus_mk hf v hv).mp
      rwa [hvx]
    obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hg
    rw [eval_mul, hfv, zero_mul]

/-- Sharp projective Bézout over any field for an irreducible plane equation and
a homogeneous polynomial not divisible by it, including points at infinity. -/
theorem projective_plane_common_zeros_card_le {d m : ℕ} {ι : Type*}
    [Fintype ι]
    (f g : MvPolynomial (Fin 3) K) (hf : f.IsHomogeneous d)
    (hir : Irreducible f) (hg : g.IsHomogeneous m) (hfg : ¬ f ∣ g)
    (z : ι → Projectivization K (Fin 3 → K)) (hz : Function.Injective z)
    (hzf : ∀ i, z i ∈ projectiveZeroLocus f)
    (hzg : ∀ i, z i ∈ projectiveZeroLocus g) :
    Fintype.card ι ≤ d * m := by
  classical
  let I : Ideal (MvPolynomial (Fin 3) K) := Ideal.span {f}
  have : I.IsPrime := Ideal.isPrime_span_singleton_of_prime hir.prime
  apply projective_section_card_le_degree I
    (principal_plane_hasProjectiveCurveDegree f hf hir.ne_zero) g hg
    (by simpa only [I, Ideal.mem_span_singleton] using hfg) z hz
  · intro i
    change z i ∈ projectiveIdealZeroLocus (Ideal.span {f})
    rw [projectiveIdealZeroLocus_span_singleton f hf]
    exact hzf i
  · exact hzg

end
end CCDN

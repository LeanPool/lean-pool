module

public import LeanPool.CompositionAlgebrasOverRings.Composition.RankTwoSubalgebra
public import Mathlib.Algebra.QuadraticAlgebra.Basic
public import Mathlib.Algebra.QuadraticAlgebra.Discriminant

/-!
# A quadratic algebra is a conic algebra, and is composition exactly when étale (`GPR 19.8`)

Everything in `Composition/QuadraticSubalgebra.lean` builds the quadratic algebra `k[u]` *inside*
an ambient conic algebra, so its norm and trace are inherited rather than constructed. This file
supplies the missing standalone direction: given a commutative `k`-algebra `L` whose underlying
module is free on `1` and a single element `u`, with

  `u² = t·u − n₀·1`,

there is a conic structure on `L` with `t(u) = t` and `n(u) = n₀`, its norm is multiplicative, and
it is a composition algebra exactly when the discriminant `t² − 4n₀` is a unit — that is, exactly
when `L` is quadratic **étale**.

Without this, the only rank-two composition algebra available as an object in its own right is the
split one `k × k` (`Composition/Reduced/Split.lean`), and `Cay(k, μ)`, which needs `2 ∈ kˣ` and
only reaches the presentations with `t = 0`.

## Main definitions

* `ConicAlgebra.quadraticCoeffNorm t n₀` : the form `(a, b) ↦ a² + t·ab + n₀·b²` on `k²`.
* `ConicAlgebra.IsQuadraticAlgebra u t n₀` : the data above — `u² = t·u − n₀·1`, and `(a, b) ↦
  a·1 + b·u` a bijection.
* `ConicAlgebra.IsQuadraticAlgebra.conic` : the resulting conic algebra.
* `ConicAlgebra.IsQuadraticAlgebra.quadraticAlgebraEquiv` : `QuadraticAlgebra k (-n₀) t ≃ₐ[k] L`,
  `ω ↦ u` — the presentation identifies `L` with mathlib's model quadratic algebra.

## Main results

* `ConicAlgebra.IsQuadraticAlgebra.isMultiplicative_conic` : the norm permits composition
  (`GPR 19.8(i)`).
* `ConicAlgebra.IsQuadraticAlgebra.isGPRRegular_conic_iff` : regularity of the norm is exactly
  invertibility of the discriminant (`GPR 19.8(iii)`).
* `ConicAlgebra.IsQuadraticAlgebra.isComposition_conic` : **a quadratic étale algebra is a
  composition algebra of rank two**.
* `ConicAlgebra.IsQuadraticAlgebra.finrank_eq_two`, `.rankAtStalk_eq_two` : its rank.
* `ConicAlgebra.exists_isQuadraticAlgebra_of_finrank_eq_two` : over a field, every commutative
  algebra of dimension two admits such a presentation.
* `ConicAlgebra.IsQuadraticAlgebra.norm_quadraticAlgebraEquiv`, `.trace_quadraticAlgebraEquiv` :
  the conic norm and trace are mathlib's `QuadraticAlgebra.norm` and `QuadraticAlgebra.trace`, and
  `.isGPRRegular_conic_iff_isUnit_discr` restates `GPR 19.8(iii)` with mathlib's
  `QuadraticAlgebra.discr`.
* `ConicAlgebra.isQuadraticAlgebra_omega` : conversely, mathlib's `QuadraticAlgebra k a b` is a
  quadratic algebra in this sense, generated by `ω`.

## Implementation notes

The norm is *defined* by transporting the coefficient form `quadraticCoeffNorm` along the given
bijection, rather than by a formula on `L`; this is what makes the degree-two identity and
multiplicativity two-variable polynomial identities that `ring` discharges.

Once the conic algebra exists, the ambient machinery applies to it with no duplication: the
discriminant criterion is `ConicAlgebra.normOnSpan_isGPRRegular_iff_isUnit_discriminant` read at
`C := h.conic`, since `h.conic.normOnSpan u` is `quadraticCoeffNorm t n₀` on the nose.

⚠ **`t` is not `2a` for some `a`.** The presentation carries the *un-halved* trace, so the
characteristic-two case — where the discriminant is `t²` and étale means `t` invertible — is
included. Writing the norm as `(a + t b/2)² − (t² − 4n₀) b²/4` would need `2 ∈ kˣ` and would lose
exactly the separable quadratic extensions of a field of characteristic two.

## References

* [GPR] Garibaldi, Petersson, Racine, *Albert Algebras over Commutative Rings*, 19.8.
-/

@[expose] public section

universe u v

namespace ConicAlgebra

section CoeffNorm

variable (k : Type u) [CommRing k]

/-- The quadratic form `(a, b) ↦ a² + t·ab + n₀·b²` on `k²`, in the coefficient coordinates of
`a·1 + b·u`. -/
def quadraticCoeffNorm (t n₀ : k) : QuadraticForm k (k × k) :=
  QuadraticMap.linMulLin (LinearMap.fst k k k) (LinearMap.fst k k k) +
    t • QuadraticMap.linMulLin (LinearMap.fst k k k) (LinearMap.snd k k k) +
    n₀ • QuadraticMap.linMulLin (LinearMap.snd k k k) (LinearMap.snd k k k)

variable {k}

@[simp] theorem quadraticCoeffNorm_apply (t n₀ : k) (p : k × k) :
    quadraticCoeffNorm k t n₀ p = p.1 * p.1 + t * (p.1 * p.2) + n₀ * (p.2 * p.2) := by
  simp only [quadraticCoeffNorm, add_apply, smul_apply,
    QuadraticMap.linMulLin_apply, LinearMap.fst_apply, LinearMap.snd_apply, smul_eq_mul]

theorem polar_quadraticCoeffNorm (t n₀ : k) (p q : k × k) :
    QuadraticMap.polar (quadraticCoeffNorm k t n₀) p q =
      2 * (p.1 * q.1) + t * (p.1 * q.2 + p.2 * q.1) + n₀ * (2 * (p.2 * q.2)) := by
  simp only [QuadraticMap.polar, quadraticCoeffNorm_apply, Prod.fst_add, Prod.snd_add]
  ring

end CoeffNorm

section Quadratic

variable {k : Type u} {L : Type v} [CommRing k] [CommRing L] [Algebra k L]

/-- **The data of a quadratic `k`-algebra (`GPR 19.8`)**: an element `u` whose square is the
prescribed combination `t·u − n₀·1`, and for which `(a, b) ↦ a·1 + b·u` is a bijection `k² ≃ L`.

The second clause is `GPR 19.8(ii)`: `L` is free with basis `(1, u)`. No regularity is assumed —
that is the discriminant condition, and it is what separates étale from inseparable. -/
structure IsQuadraticAlgebra (u : L) (t n₀ : k) : Prop where
  /-- The generator satisfies its monic quadratic relation. -/
  mul_self_gen : u * u = t • u - n₀ • (1 : L)
  /-- `(1, u)` is a basis of `L` over `k`. -/
  bijective_spanOne : Function.Bijective (spanOne k u)

namespace IsQuadraticAlgebra

variable {u : L} {t n₀ : k} (h : IsQuadraticAlgebra u t n₀)

/-- The coefficient isomorphism `k² ≃ L`, `(a, b) ↦ a·1 + b·u`. -/
noncomputable def equivCoeff : (k × k) ≃ₗ[k] L :=
  LinearEquiv.ofBijective (spanOne k u) h.bijective_spanOne

@[simp] theorem equivCoeff_apply (p : k × k) : h.equivCoeff p = p.1 • (1 : L) + p.2 • u := rfl

include h in
/-- Multiplication in coefficient coordinates, from the defining relation alone. -/
theorem spanOne_mul_gen (p q : k × k) :
    (spanOne k u p) * (spanOne k u q) =
      spanOne k u (p.1 * q.1 - p.2 * q.2 * n₀, p.1 * q.2 + p.2 * q.1 + p.2 * q.2 * t) := by
  simp only [spanOne_apply, add_mul, mul_add, smul_mul_assoc, mul_smul_comm, one_mul, mul_one,
    h.mul_self_gen]
  module

/-- The norm of the quadratic algebra, transported from the coefficient form. -/
noncomputable def norm : QuadraticForm k L :=
  (quadraticCoeffNorm k t n₀).comp h.equivCoeff.symm.toLinearMap

theorem norm_spanOne (p : k × k) :
    h.norm (spanOne k u p) = p.1 * p.1 + t * (p.1 * p.2) + n₀ * (p.2 * p.2) := by
  change (quadraticCoeffNorm k t n₀).comp h.equivCoeff.symm.toLinearMap (spanOne k u p) = _
  rw [QuadraticMap.comp_apply]
  change quadraticCoeffNorm k t n₀ (h.equivCoeff.symm (h.equivCoeff p)) = _
  rw [h.equivCoeff.symm_apply_apply, quadraticCoeffNorm_apply]

theorem polar_norm_spanOne (p q : k × k) :
    QuadraticMap.polar h.norm (spanOne k u p) (spanOne k u q) =
      2 * (p.1 * q.1) + t * (p.1 * q.2 + p.2 * q.1) + n₀ * (2 * (p.2 * q.2)) := by
  rw [QuadraticMap.polar, ← map_add, h.norm_spanOne, h.norm_spanOne, h.norm_spanOne]
  simp only [Prod.fst_add, Prod.snd_add]
  ring

theorem norm_one_eq : h.norm (1 : L) = 1 := by
  rw [show (1 : L) = spanOne k u (1, 0) by simp, h.norm_spanOne]
  ring

theorem polar_norm_one_spanOne (p : k × k) :
    QuadraticMap.polar h.norm 1 (spanOne k u p) = 2 * p.1 + t * p.2 := by
  rw [show (1 : L) = spanOne k u (1, 0) by simp, h.polar_norm_spanOne]
  ring

/-- **`GPR 19.8`: a quadratic algebra is a conic algebra.** The degree-two identity is the
defining relation, written in coefficient coordinates. -/
noncomputable def conic : ConicAlgebra k L where
  norm := h.norm
  norm_one := h.norm_one_eq
  mul_self x := by
    obtain ⟨p, rfl⟩ := h.bijective_spanOne.2 x
    rw [h.spanOne_mul_gen p p, h.polar_norm_one_spanOne, h.norm_spanOne]
    simp only [spanOne_apply]
    match_scalars <;> ring

@[simp] theorem conic_norm : h.conic.norm = h.norm := rfl

theorem conic_norm_spanOne (p : k × k) :
    h.conic.norm (spanOne k u p) = p.1 * p.1 + t * (p.1 * p.2) + n₀ * (p.2 * p.2) :=
  h.norm_spanOne p

include h in
@[simp] theorem trace_conic_gen : h.conic.trace u = t := by
  have key := h.polar_norm_spanOne (1, 0) (0, 1)
  rw [show spanOne k u ((1 : k), (0 : k)) = (1 : L) by simp,
    show spanOne k u ((0 : k), (1 : k)) = u by simp] at key
  rw [trace_apply, conic_norm, key]
  ring

include h in
theorem norm_conic_gen : h.conic.norm u = n₀ := by
  have key := h.norm_spanOne (0, 1)
  rw [show spanOne k u ((0 : k), (1 : k)) = u by simp] at key
  rw [conic_norm, key]
  ring

/-! ### Multiplicativity -/

include h in
/-- **`GPR 19.8(i)`.** The norm of a quadratic algebra permits composition, with no hypothesis on
the discriminant: it is the two-variable identity `n(xy) = n(x)n(y)` for the binary form
`a² + t·ab + n₀·b²`. -/
theorem isMultiplicative_conic : h.conic.IsMultiplicative := by
  intro x y
  obtain ⟨p, rfl⟩ := h.bijective_spanOne.2 x
  obtain ⟨q, rfl⟩ := h.bijective_spanOne.2 y
  rw [h.spanOne_mul_gen p q, h.conic_norm_spanOne, h.conic_norm_spanOne, h.conic_norm_spanOne]
  ring

/-! ### Regularity and the discriminant -/

include h in
@[simp] theorem normOnSpan_conic : h.conic.normOnSpan u = quadraticCoeffNorm k t n₀ := by
  ext p
  change h.conic.norm (spanOne k u p) = _
  rw [h.conic_norm_spanOne, quadraticCoeffNorm_apply]

include h in
@[simp] theorem elementDiscriminant_conic :
    h.conic.elementDiscriminant u = t ^ 2 - 4 * n₀ := by
  change h.conic.trace u ^ 2 - 4 * h.conic.norm u = _
  rw [h.trace_conic_gen, h.norm_conic_gen]

include h in
/-- **`GPR 19.8(iii)`.** The norm of a quadratic algebra is regular exactly when the discriminant
`t² − 4n₀` is a unit — that is, exactly when the algebra is quadratic étale. -/
theorem isGPRRegular_conic_iff : h.conic.norm.IsGPRRegular ↔ IsUnit (t ^ 2 - 4 * n₀) := by
  rw [conic_norm, norm, QuadraticForm.isGPRRegular_comp_linearEquiv_iff, ← h.normOnSpan_conic,
    h.conic.normOnSpan_isGPRRegular_iff_isUnit_discriminant u, h.elementDiscriminant_conic]

/-! ### Rank -/

include h in
theorem module_free : Module.Free k L := Module.Free.of_equiv h.equivCoeff

include h in
theorem module_finite : Module.Finite k L := Module.Finite.equiv h.equivCoeff

include h in
/-- The generator lies outside `k · 1`: otherwise `(d, -1)` would be a nonzero element of the
kernel of the coefficient map. -/
theorem ne_smul_one [Nontrivial k] (d : k) : u ≠ d • (1 : L) := by
  intro hd
  have h0 : spanOne k u ((d, -1) : k × k) = spanOne k u 0 := by
    simp only [spanOne_apply, map_zero]
    rw [hd]
    module
  have hneg : (-1 : k) = 0 := congrArg Prod.snd (h.bijective_spanOne.1 h0)
  exact one_ne_zero (neg_eq_zero.mp hneg)

include h in
theorem finrank_eq_two [Nontrivial k] : Module.finrank k L = 2 := by
  rw [← LinearEquiv.finrank_eq h.equivCoeff, Module.finrank_prod, Module.finrank_self]

include h in
theorem rankAtStalk_eq_two [Nontrivial k] : Module.rankAtStalk (R := k) L = fun _ ↦ 2 :=
  Module.rankAtStalk_eq_of_equiv h.equivCoeff.symm |>.trans (by
    rw [Module.rankAtStalk_prod, Module.rankAtStalk_self]
    rfl)

include h in
/-- **A quadratic étale algebra is a composition algebra of rank two.** Non-singularity comes from
regularity of the norm (`GN (C.8.1)`), which by `GPR 19.8(iii)` is invertibility of the
discriminant; multiplicativity is unconditional. -/
theorem isComposition_conic [Module.Finite k L] [Module.Projective k L]
    (hdisc : IsUnit (t ^ 2 - 4 * n₀)) : h.conic.IsComposition.{u, v, u} :=
  ⟨((h.isGPRRegular_conic_iff).mpr hdisc).isGPRNonsingular, h.isMultiplicative_conic⟩

/-! ### mathlib's `QuadraticAlgebra`

mathlib's `QuadraticAlgebra k a b` is the model quadratic algebra, `k ⊕ k ω` with `ω² = a + b ω`.
A presentation `u² = t u - n₀` with basis `(1, u)` says exactly that `L` is
`QuadraticAlgebra k (-n₀) t`, with `ω ↦ u`; the conic norm and trace are then mathlib's. -/

include h in
/-- The defining relation in the shape `QuadraticAlgebra.lift` asks for: `u² = (-n₀)·1 + t·u`. -/
theorem mul_self_gen_eq_add : u * u = (-n₀) • (1 : L) + t • u := by
  rw [h.mul_self_gen, neg_smul]
  abel

/-- **`L` is mathlib's `QuadraticAlgebra k (-n₀) t`**, by the algebra map sending `ω` to `u`
(`QuadraticAlgebra.lift`). It is bijective because `(1, u)` is a basis. -/
noncomputable def quadraticAlgebraEquiv : QuadraticAlgebra k (-n₀) t ≃ₐ[k] L :=
  AlgEquiv.ofBijective (QuadraticAlgebra.lift ⟨u, h.mul_self_gen_eq_add⟩) <| by
    have : ⇑(QuadraticAlgebra.lift ⟨u, h.mul_self_gen_eq_add⟩) =
        h.equivCoeff ∘ QuadraticAlgebra.equivProd (-n₀) t := rfl
    rw [this]
    exact h.equivCoeff.bijective.comp (QuadraticAlgebra.equivProd (-n₀) t).bijective

@[simp] theorem quadraticAlgebraEquiv_apply (z : QuadraticAlgebra k (-n₀) t) :
    h.quadraticAlgebraEquiv z = z.re • (1 : L) + z.im • u :=
  rfl

theorem quadraticAlgebraEquiv_omega :
    h.quadraticAlgebraEquiv QuadraticAlgebra.omega = u := by
  simp

/-- Under `quadraticAlgebraEquiv`, the conic norm is mathlib's `QuadraticAlgebra.norm`. -/
theorem norm_quadraticAlgebraEquiv (z : QuadraticAlgebra k (-n₀) t) :
    h.conic.norm (h.quadraticAlgebraEquiv z) = QuadraticAlgebra.norm z := by
  rw [show h.quadraticAlgebraEquiv z = spanOne k u (z.re, z.im) from rfl, h.conic_norm_spanOne,
    QuadraticAlgebra.norm_def]
  ring

/-- Under `quadraticAlgebraEquiv`, the conic trace is mathlib's `QuadraticAlgebra.trace`. -/
theorem trace_quadraticAlgebraEquiv (z : QuadraticAlgebra k (-n₀) t) :
    h.conic.trace (h.quadraticAlgebraEquiv z) = QuadraticAlgebra.trace z := by
  rw [show h.quadraticAlgebraEquiv z = spanOne k u (z.re, z.im) from rfl, trace_apply,
    conic_norm, h.polar_norm_one_spanOne, QuadraticAlgebra.trace_def]

include h in
/-- **`GPR 19.8(iii)` in mathlib's terms**: the norm is regular exactly when mathlib's
discriminant `QuadraticAlgebra.discr (-n₀) t = t² - 4n₀` is a unit. -/
theorem isGPRRegular_conic_iff_isUnit_discr :
    h.conic.norm.IsGPRRegular ↔ IsUnit (QuadraticAlgebra.discr (-n₀) t) := by
  rw [h.isGPRRegular_conic_iff, QuadraticAlgebra.discr_def]
  ring_nf

end IsQuadraticAlgebra

/-- Conversely, **mathlib's `QuadraticAlgebra k a b` is a quadratic algebra** in the sense of
`IsQuadraticAlgebra`, generated by `ω` with trace `b` and norm `-a`. -/
theorem isQuadraticAlgebra_omega (a b : k) :
    IsQuadraticAlgebra (QuadraticAlgebra.omega : QuadraticAlgebra k a b) b (-a) where
  mul_self_gen := by
    rw [QuadraticAlgebra.omega_mul_omega_eq_add, neg_smul, sub_neg_eq_add, add_comm]
  bijective_spanOne := by
    have : ⇑(spanOne k (QuadraticAlgebra.omega : QuadraticAlgebra k a b)) =
        (QuadraticAlgebra.equivProd a b).symm := by
      funext p
      ext <;> simp [QuadraticAlgebra.re_one, QuadraticAlgebra.im_one]
    rw [this]
    exact (QuadraticAlgebra.equivProd a b).symm.bijective

end Quadratic

/-! ### Every two-dimensional commutative algebra over a field is quadratic -/

section Field

variable {K : Type u} {L : Type v} [Field K] [CommRing L] [Algebra K L] [Nontrivial L]

/-- Over a field, a commutative algebra of dimension two is a quadratic algebra: any element
outside `K · 1` generates, and its square is a combination of `1` and itself. -/
theorem exists_isQuadraticAlgebra_of_finrank_eq_two (h : Module.finrank K L = 2) :
    ∃ (u : L) (t n₀ : K), IsQuadraticAlgebra u t n₀ := by
  have : FiniteDimensional K L := Module.finite_of_finrank_pos (by omega)
  -- An element outside `K · 1` exists because the dimension exceeds one.
  obtain ⟨u, hu⟩ : ∃ u : L, ∀ d : K, u ≠ d • (1 : L) := by
    by_contra hcon
    have hall : ∀ x : L, ∃ d : K, x = d • (1 : L) := by
      intro x
      by_contra hx
      exact hcon ⟨x, fun d hd ↦ hx ⟨d, hd⟩⟩
    exact absurd (finrank_le_one_of_forall_exists_smul (1 : L) hall) (by omega)
  -- `spanOne K u` is injective, hence bijective by equality of dimensions.
  have hinj : Function.Injective (spanOne K u) := by
    rw [injective_iff_map_eq_zero]
    rintro ⟨a, b⟩ hab
    rw [spanOne_apply] at hab
    rcases eq_or_ne b 0 with rfl | hb
    · rw [zero_smul, add_zero, smul_eq_zero] at hab
      rcases hab with rfl | h1
      · rfl
      · exact absurd h1 one_ne_zero
    · refine absurd ?_ (hu (-(b⁻¹ * a)))
      have hbu : b • u = (-a) • (1 : L) := by
        linear_combination (norm := module) hab
      calc u = b⁻¹ • (b • u) := by rw [smul_smul, inv_mul_cancel₀ hb, one_smul]
        _ = b⁻¹ • ((-a) • (1 : L)) := by rw [hbu]
        _ = (-(b⁻¹ * a)) • (1 : L) := by rw [smul_smul]; ring_nf
  have hbij : Function.Bijective (spanOne K u) :=
    ⟨hinj, (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (by simp [h])).mp hinj⟩
  -- The square of `u` lies in `K · 1 + K · u`, which supplies the structure constants.
  obtain ⟨p, hp⟩ := hbij.2 (u * u)
  exact ⟨u, p.2, -p.1, ⟨by rw [← hp, spanOne_apply]; module, hbij⟩⟩

end Field

/-! ### Quadratic field extensions -/

section Extension

variable {K : Type u} {M : Type v} [Field K] [Field M] [Algebra K M]
  {u : M} {t n₀ : K}

/-- **The discriminant of a quadratic field extension is a unit.** If it vanished, `u` would be a
double root: `u − c·1` would square to zero, hence vanish, putting `u` in `K · 1`.

The hypothesis is consumed **only in characteristic two**, where the vanishing discriminant is
`t²` and the missing scalar `c` is a square root of `n₀`. In every other characteristic `c = t/2`
is available outright. -/
theorem IsQuadraticAlgebra.isUnit_discriminant_of_field (h : IsQuadraticAlgebra u t n₀)
    (hsq : (2 : K) = 0 → ∀ c : K, ∃ d : K, d * d = c) : IsUnit (t ^ 2 - 4 * n₀) := by
  rw [isUnit_iff_ne_zero]
  intro hzero
  obtain ⟨c, htc, hcn⟩ : ∃ c : K, t = 2 * c ∧ c * c = n₀ := by
    rcases eq_or_ne (2 : K) 0 with h2 | h2
    · have ht : t = 0 := by
        have hsq0 : t * t = 0 := by linear_combination hzero + (2 * n₀ - t ^ 2 / 2 * 0) * h2
        exact mul_self_eq_zero.mp hsq0
      obtain ⟨d, hd⟩ := hsq h2 n₀
      exact ⟨d, by rw [ht, h2]; ring, hd⟩
    · refine ⟨t / 2, by field_simp, ?_⟩
      field_simp
      linear_combination hzero
  have hexp :
      (u - c • (1 : M)) * (u - c • (1 : M)) =
        (t - 2 * c) • u + (c * c - n₀) • (1 : M) := by
    simp only [sub_mul, mul_sub, smul_mul_assoc, mul_smul_comm, one_mul, mul_one, h.mul_self_gen]
    module
  have hnil : (u - c • (1 : M)) * (u - c • (1 : M)) = 0 := by
    rw [hexp, htc, hcn]
    simp
  exact h.ne_smul_one c (by
    have := mul_self_eq_zero.mp hnil
    linear_combination (norm := module) this)

/-- Over a finite field of characteristic two every element is a square: squaring is injective,
because `(a − b)² = a² + b²` there, and an injective self-map of a finite type is surjective. -/
theorem exists_mul_self_eq_of_finite [Finite K] (h2 : (2 : K) = 0) (c : K) :
    ∃ d : K, d * d = c := by
  have hinj : Function.Injective (fun x : K ↦ x * x) := by
    intro a b hab
    simp only at hab
    have : (a - b) * (a - b) = 0 := by linear_combination hab + (b * (b - a)) * h2
    exact sub_eq_zero.mp (mul_self_eq_zero.mp this)
  exact Finite.injective_iff_surjective.mp hinj c

/-- **The discriminant of a quadratic extension of a finite field is a unit**, in every
characteristic. This is the separability of finite field extensions, in the only form the conic
structure needs. -/
theorem IsQuadraticAlgebra.isUnit_discriminant_of_finite [Finite K]
    (h : IsQuadraticAlgebra u t n₀) : IsUnit (t ^ 2 - 4 * n₀) :=
  h.isUnit_discriminant_of_field fun h2 ↦ exists_mul_self_eq_of_finite h2

end Extension

end ConicAlgebra

public import Mathlib.RingTheory.Flat.LocallyFree

/-!
# Quadratic subalgebras generated by one element (`GPR 19.8`)

For an element `u` of a conic algebra, the submodule `k · 1 + k · u` is closed under
multiplication because `u² = t(u)u - n(u)1`. This is the unital subalgebra denoted `k[u]` in
`GPR 19.8`.

The discriminant `t(u)² - 4n(u)` controls whether `(1,u)` is a basis. If it is a unit, applying
the polar form at `1` and at `u` to a relation `a·1 + b·u = 0` gives a two-by-two linear system
whose determinant is the negative discriminant, forcing `a = b = 0`.

## Main definitions

* `ConicAlgebra.spanOne` : the linear map `(a,b) ↦ a·1 + b·u`.
* `ConicAlgebra.adjoinElement` : the unital non-associative subalgebra `k[u]`.
* `ConicAlgebra.normOnSpan` : the norm on `k·1 + k·u`, in coefficient coordinates.
* `ConicAlgebra.conicAdjoinElement` : the restricted conic structure on `k[u]`.
* `ConicAlgebra.RegularRankTwoCompositionStructure` : a witnessing abstract composition norm for
  condition `GPR 19.8(i)`.
* `ConicAlgebra.IsRegularRankTwoComposition` : condition `GPR 19.8(i)`.

## Main results

* `ConicAlgebra.adjoinElement_mul_comm` and `ConicAlgebra.adjoinElement_mul_assoc` : `k[u]` is
  commutative and associative.
* `ConicAlgebra.normOnSpan_isGPRRegular_iff_isUnit_discriminant` : regularity of the restricted
  norm is equivalent to invertibility of the discriminant.
* `ConicAlgebra.basis_and_regular_iff_isUnit_discriminant` : `GPR 19.8(ii) ⇔ (iii)`.
* `ConicAlgebra.isRegularRankTwoComposition_iff_isUnit_discriminant` : `GPR 19.8(i) ⇔ (iii)`.
* `ConicAlgebra.regularRankTwoComposition_iff_basisAndRegular` : the full three-way equivalence.
* `ConicAlgebra.quadraticSpan_injective_of_isUnit_discriminant` : the unit-discriminant part of
  `GPR 19.8`, proving that `(1,u)` is linearly independent.
* `ConicAlgebra.quadraticSpanEquiv` : under that hypothesis, `k² ≃ k[u]`.
* `ConicAlgebra.exists_forall_mem_adjoinElement_of_isLGRing_of_rankAtStalk_eq_two` : over an LG
  ring, a finitely generated projective conic algebra of constant rank two is `k[u]` for some `u`,
  with no composition hypothesis; hence it is commutative and associative
  (`ConicAlgebra.mul_comm_of_isLGRing_of_rankAtStalk_eq_two`,
  `ConicAlgebra.mul_assoc_of_isLGRing_of_rankAtStalk_eq_two`, `GPR 16.4`).

## Implementation notes

Condition (i) is genuinely existential: its composition norm is not defined to be the ambient
norm restricted to `k[u]`. In `(i) ⇒ (ii)`, projectivity and rank two first make the canonical
surjection `k² → k[u]` an equivalence; `ConicAlgebra.norm_eq_of_projective` then proves that the
witnessing conic norm equals the restriction of the ambient norm. Building that equality into the
definition of condition (i) would omit the uniqueness step in GPR's proof.

## References

* [GPR] Garibaldi, Petersson, Racine, *Albert Algebras over Commutative Rings*, 11.24, 16.4,
  16.7, 19.8.
-/

@[expose] public section

universe u v

open QuadraticMap (polar)

namespace ConicAlgebra

variable {k : Type u} {A : Type v} [CommRing k] [NonAssocRing A] [Module k A]
  [SMulCommClass k A A] [IsScalarTower k A A] (C : ConicAlgebra k A)

omit C in
/-- The coefficient map `(a,b) ↦ a·1 + b·u` whose range is the quadratic subalgebra `k[u]`. -/
def spanOne (k : Type u) [CommRing k] {A : Type v} [NonAssocRing A] [Module k A]
    (u : A) : k × k →ₗ[k] A where
  toFun p := p.1 • (1 : A) + p.2 • u
  map_add' p q := by simp only [Prod.fst_add, Prod.snd_add, add_smul]; abel
  map_smul' a p := by
    simp only [Prod.smul_fst, Prod.smul_snd, smul_add, smul_smul, RingHom.id_apply,
      smul_eq_mul]

omit [SMulCommClass k A A] [IsScalarTower k A A] in
@[simp] theorem spanOne_apply (u : A) (p : k × k) :
    spanOne k u p = p.1 • (1 : A) + p.2 • u := rfl

/-- The unital subalgebra `k[u] = k·1 + k·u` of `GPR 19.8`.

Closure under multiplication consumes only the degree-two identity of a conic algebra. -/
def adjoinElement (u : A) : NonAssocSubalgebra k A where
  toNonUnitalSubalgebra :=
    { carrier := LinearMap.range (spanOne k u)
      zero_mem' := Submodule.zero_mem _
      add_mem' := Submodule.add_mem _
      smul_mem' := fun c _ hx ↦ Submodule.smul_mem _ c hx
      mul_mem' := by
        rintro _ _ ⟨p, rfl⟩ ⟨q, rfl⟩
        rcases p with ⟨a, b⟩
        rcases q with ⟨c, d⟩
        refine ⟨(a * c - b * d * C.norm u, a * d + b * c + b * d * C.trace u), ?_⟩
        simp only [spanOne_apply, add_mul, mul_add, smul_mul_assoc, mul_smul_comm,
          one_mul, mul_one, C.mul_self_eq]
        module }
  one_mem := ⟨(1, 0), by simp⟩

/-- The coefficient map from `k²` onto the quadratic subalgebra `k[u]`. -/
def spanOneToAdjoin (u : A) : k × k →ₗ[k] C.adjoinElement u :=
  (spanOne k u).codRestrict (C.adjoinElement u).toNonUnitalSubalgebra.toSubmodule fun p ↦
    ⟨p, rfl⟩

@[simp] theorem coe_spanOneToAdjoin_apply (u : A) (p : k × k) :
    (C.spanOneToAdjoin u p : A) = spanOne k u p := rfl

/-- The coefficient map onto `k[u]` is always surjective. -/
theorem spanOneToAdjoin_surjective (u : A) : Function.Surjective (C.spanOneToAdjoin u) := by
  rintro ⟨x, ⟨p, hp⟩⟩
  exact ⟨p, Subtype.ext hp⟩

/-- The algebra `k[u]` is generated as a module by `1` and `u`, hence is finitely generated. -/
theorem finite_adjoinElement (u : A) : Module.Finite k (C.adjoinElement u) :=
  Module.Finite.of_surjective (C.spanOneToAdjoin u) (C.spanOneToAdjoin_surjective u)

@[simp] theorem mem_adjoinElement_iff (u x : A) :
    x ∈ C.adjoinElement u ↔ ∃ a b : k, a • (1 : A) + b • u = x := by
  constructor
  · rintro ⟨⟨a, b⟩, rfl⟩
    exact ⟨a, b, rfl⟩
  · rintro ⟨a, b, rfl⟩
    exact ⟨(a, b), rfl⟩

/-- The algebra generated by one element of a conic algebra is commutative (`GPR 19.8`). -/
theorem adjoinElement_mul_comm (u : A) (x y : C.adjoinElement u) : x * y = y * x := by
  apply Subtype.ext
  change (x : A) * (y : A) = (y : A) * (x : A)
  obtain ⟨a, b, hx⟩ := (C.mem_adjoinElement_iff u x).mp x.2
  obtain ⟨c, d, hy⟩ := (C.mem_adjoinElement_iff u y).mp y.2
  rw [← hx, ← hy]
  simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, one_mul, mul_one]
  module

/-- Every element of a conic algebra generates an associative cube. -/
theorem mul_self_mul_eq_mul_mul_self (C : ConicAlgebra k A) (u : A) :
    u * u * u = u * (u * u) := by
  rw [C.mul_self_eq]
  simp only [sub_mul, mul_sub, smul_mul_assoc, mul_smul_comm, one_mul, mul_one]

/-- The algebra generated by one element of a conic algebra is associative (`GPR 19.8`). -/
theorem adjoinElement_mul_assoc (u : A) (x y z : C.adjoinElement u) :
    x * y * z = x * (y * z) := by
  apply Subtype.ext
  change ((x : A) * (y : A)) * (z : A) = (x : A) * ((y : A) * (z : A))
  obtain ⟨a, b, hx⟩ := (C.mem_adjoinElement_iff u x).mp x.2
  obtain ⟨c, d, hy⟩ := (C.mem_adjoinElement_iff u y).mp y.2
  obtain ⟨e, f, hz⟩ := (C.mem_adjoinElement_iff u z).mp z.2
  rw [← hx, ← hy, ← hz]
  simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, one_mul, mul_one]
  rw [C.mul_self_mul_eq_mul_mul_self]

/-- The quadratic subalgebra `k[u]` as a commutative ring. -/
@[instance_reducible] def adjoinElementCommRing (u : A) : CommRing (C.adjoinElement u) :=
  { (inferInstance : NonAssocRing (C.adjoinElement u)) with
    mul_assoc := C.adjoinElement_mul_assoc u
    mul_comm := C.adjoinElement_mul_comm u }

/-- The quadratic subalgebra `k[u]` as an associative `k`-algebra. -/
@[instance_reducible] def adjoinElementAlgebra (u : A) :
    letI := C.adjoinElementCommRing u
    Algebra k (C.adjoinElement u) :=
  letI := C.adjoinElementCommRing u
  Algebra.ofModule (fun r x y ↦ by exact smul_mul_assoc r x y)
    (fun r x y ↦ by exact mul_smul_comm r x y)

/-- The discriminant attached to `u`, namely `t(u)² - 4n(u)` (`GPR 19.8(iii)`). -/
def elementDiscriminant (u : A) : k := C.trace u ^ 2 - 4 * C.norm u

/-- The restriction of the norm to `k·1 + k·u`, written in coefficient coordinates. -/
def normOnSpan (u : A) : QuadraticForm k (k × k) := C.norm.comp (spanOne k u)

/-- The norm of `C` restricted to the quadratic subalgebra `k[u]`. -/
def normAdjoinElement (u : A) : QuadraticForm k (C.adjoinElement u) :=
  C.normRestrict (C.adjoinElement u)

@[simp] theorem normAdjoinElement_apply (u : A) (x : C.adjoinElement u) :
    C.normAdjoinElement u x = C.norm (x : A) := rfl

/-- The conic structure on the quadratic subalgebra `k[u]`, obtained by restricting the norm. -/
def conicAdjoinElement (u : A) :
    letI := C.adjoinElementCommRing u
    letI := C.adjoinElementAlgebra u
    ConicAlgebra k (C.adjoinElement u) := by
  letI := C.adjoinElementCommRing u
  letI := C.adjoinElementAlgebra u
  exact C.restrict (C.adjoinElement u)

omit [SMulCommClass k A A] [IsScalarTower k A A] in
@[simp] theorem normOnSpan_apply (u : A) (p : k × k) :
    C.normOnSpan u p = p.1 ^ 2 + p.1 * p.2 * C.trace u + p.2 ^ 2 * C.norm u := by
  rw [normOnSpan, QuadraticMap.comp_apply, spanOne_apply, QuadraticMap.map_add C.norm,
    C.norm.map_smul, C.norm.map_smul, QuadraticMap.polar_smul_left,
    QuadraticMap.polar_smul_right, C.norm_one, ← C.trace_apply]
  simp only [smul_eq_mul]
  ring

/-- Multiplication in the coefficient presentation of `k[u]`. -/
theorem spanOne_mul (u : A) (p q : k × k) :
    spanOne k u p * spanOne k u q =
      spanOne k u
        (p.1 * q.1 - p.2 * q.2 * C.norm u,
          p.1 * q.2 + p.2 * q.1 + p.2 * q.2 * C.trace u) := by
  simp only [spanOne_apply, add_mul, mul_add, smul_mul_assoc, mul_smul_comm,
    one_mul, mul_one, C.mul_self_eq]
  module

/-- The restricted norm on `k[u]` is multiplicative (`GPR 19.8(i)`). -/
theorem isMultiplicative_conicAdjoinElement (u : A) :
    letI := C.adjoinElementCommRing u
    letI := C.adjoinElementAlgebra u
    (C.conicAdjoinElement u).IsMultiplicative := by
  let := C.adjoinElementCommRing u
  let := C.adjoinElementAlgebra u
  intro x y
  obtain ⟨p, rfl⟩ := C.spanOneToAdjoin_surjective u x
  obtain ⟨q, rfl⟩ := C.spanOneToAdjoin_surjective u y
  change C.norm (spanOne k u p * spanOne k u q) =
    C.norm (spanOne k u p) * C.norm (spanOne k u q)
  rw [C.spanOne_mul]
  change C.normOnSpan u _ = C.normOnSpan u p * C.normOnSpan u q
  simp only [normOnSpan_apply]
  ring

/-- Coordinates on the dual of `k × k`, obtained by evaluation on `(1,0)` and `(0,1)`. -/
def dualProdCoordinates : Module.Dual k (k × k) ≃ₗ[k] k × k where
  toFun f := (f (1, 0), f (0, 1))
  invFun p :=
    { toFun := fun q ↦ p.1 * q.1 + p.2 * q.2
      map_add' := by intros; simp only [Prod.fst_add, Prod.snd_add]; ring
      map_smul' := by intros; simp only [Prod.smul_fst, Prod.smul_snd, RingHom.id_apply]; ring }
  left_inv f := by
    apply LinearMap.ext
    rintro ⟨x, y⟩
    change f (1, 0) * x + f (0, 1) * y = f (x, y)
    rw [mul_comm (f (1, 0)) x, mul_comm (f (0, 1)) y]
    change x • f (1, 0) + y • f (0, 1) = f (x, y)
    rw [← map_smul, ← map_smul, ← map_add]
    congr 1
    ext <;> simp
  right_inv p := by ext <;> simp
  map_add' f g := by ext <;> simp
  map_smul' a f := by ext <;> simp

/-- The polar map of `normOnSpan`, with its dual output written as two coordinates. -/
def polarSpanCoordinates (u : A) : k × k →ₗ[k] k × k :=
  dualProdCoordinates.comp (QuadraticMap.polarBilin (C.normOnSpan u))

omit [SMulCommClass k A A] [IsScalarTower k A A] in
@[simp] theorem polarSpanCoordinates_apply (u : A) (p : k × k) :
    C.polarSpanCoordinates u p =
      (2 * p.1 + C.trace u * p.2, C.trace u * p.1 + 2 * C.norm u * p.2) := by
  simp only [polarSpanCoordinates, LinearMap.comp_apply, dualProdCoordinates]
  change
    (polar (C.normOnSpan u) p (1, 0), polar (C.normOnSpan u) p (0, 1)) = _
  rw [show polar (C.normOnSpan u) p (1, 0) =
      polar C.norm (spanOne k u p) (spanOne k u (1, 0)) by
        simp only [polar, normOnSpan, QuadraticMap.comp_apply, LinearMap.map_add],
    show polar (C.normOnSpan u) p (0, 1) =
      polar C.norm (spanOne k u p) (spanOne k u (0, 1)) by
        simp only [polar, normOnSpan, QuadraticMap.comp_apply, LinearMap.map_add]]
  simp only [spanOne_apply, one_smul, zero_smul, add_zero, zero_add,
    QuadraticMap.polar_add_left, QuadraticMap.polar_smul_left,
    QuadraticMap.polar_self, smul_eq_mul, nsmul_eq_mul]
  push_cast
  ext <;> dsimp
  · rw [C.norm_one, QuadraticMap.polar_comm C.norm u 1, ← C.trace_apply]
    ring
  · rw [← C.trace_apply]
    ring

omit [SMulCommClass k A A] [IsScalarTower k A A] in
/-- The coefficient norm is regular exactly when its coordinate polar map is bijective. -/
theorem normOnSpan_isGPRRegular_iff_bijective_polarSpanCoordinates (u : A) :
    (C.normOnSpan u).IsGPRRegular ↔ Function.Bijective (C.polarSpanCoordinates u) := by
  constructor
  · exact fun h ↦ dualProdCoordinates.bijective.comp h
  · intro h
    constructor
    · intro x y hxy
      apply h.1
      simp only [polarSpanCoordinates, LinearMap.comp_apply, hxy]
    · intro φ
      obtain ⟨x, hx⟩ := h.2 (dualProdCoordinates φ)
      exact ⟨x, dualProdCoordinates.injective hx⟩

omit [SMulCommClass k A A] [IsScalarTower k A A] in
/-- The two-by-two polar matrix is bijective exactly when its discriminant is a unit.

Bijectivity of an endomorphism is invertibility (`Module.End.isUnit_iff`), which the matrix
algebra equivalence turns into invertibility of the Gram matrix `!![2, t(u); t(u), 2n(u)]`, hence
of its determinant `4n(u) - t(u)²`. That is the negative of the discriminant. -/
theorem bijective_polarSpanCoordinates_iff_isUnit_discriminant (u : A) :
    Function.Bijective (C.polarSpanCoordinates u) ↔ IsUnit (C.elementDiscriminant u) := by
  have hmat : LinearMap.toMatrixAlgEquiv (Module.Basis.finTwoProd k)
      (C.polarSpanCoordinates u) = !![2, C.trace u; C.trace u, 2 * C.norm u] := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [LinearMap.toMatrixAlgEquiv_apply, polarSpanCoordinates_apply]
  rw [← Module.End.isUnit_iff,
    ← MulEquiv.isUnit_map (LinearMap.toMatrixAlgEquiv (Module.Basis.finTwoProd k)),
    hmat, Matrix.isUnit_iff_isUnit_det, Matrix.det_fin_two_of, elementDiscriminant,
    show 2 * (2 * C.norm u) - C.trace u * C.trace u = 4 * C.norm u - C.trace u ^ 2 by ring]
  exact IsUnit.sub_iff

omit [SMulCommClass k A A] [IsScalarTower k A A] in
/-- **`GPR 19.8`, regularity criterion.** The norm on `k·1 + k·u`, in coefficient
coordinates, is regular if and only if `t(u)² - 4n(u)` is a unit. -/
theorem normOnSpan_isGPRRegular_iff_isUnit_discriminant (u : A) :
    (C.normOnSpan u).IsGPRRegular ↔ IsUnit (C.elementDiscriminant u) :=
  (C.normOnSpan_isGPRRegular_iff_bijective_polarSpanCoordinates u).trans
    (C.bijective_polarSpanCoordinates_iff_isUnit_discriminant u)

omit [SMulCommClass k A A] [IsScalarTower k A A] in
/-- A relation `a·1 + b·u = 0` gives the first row of the polar Gram matrix:
`2a + t(u)b = 0`. -/
theorem trace_eq_zero_of_smul_one_add_smul_eq_zero {u : A} {a b : k}
    (h : a • (1 : A) + b • u = 0) : 2 * a + C.trace u * b = 0 := by
  have ht := congrArg C.trace h
  simp only [map_add, map_smul, trace_one, map_zero, smul_eq_mul] at ht
  linear_combination ht

omit [SMulCommClass k A A] [IsScalarTower k A A] in
/-- The same relation gives the second row of the polar Gram matrix:
`t(u)a + 2n(u)b = 0`. -/
theorem polar_eq_zero_of_smul_one_add_smul_eq_zero {u : A} {a b : k}
    (h : a • (1 : A) + b • u = 0) : C.trace u * a + 2 * C.norm u * b = 0 := by
  have hp := congrArg (fun x ↦ polar C.norm u x) h
  simp only [QuadraticMap.polar_add_right, QuadraticMap.polar_smul_right,
    QuadraticMap.polar_zero_right, QuadraticMap.polar_self, QuadraticMap.polar_comm C.norm u 1,
    smul_eq_mul, nsmul_eq_mul] at hp
  push_cast at hp
  change a * C.trace u + b * (2 * C.norm u) = 0 at hp
  linear_combination hp

omit [SMulCommClass k A A] [IsScalarTower k A A] in
/-- **`GPR 19.8`, `(iii) ⇒` linear independence.** If `t(u)² - 4n(u)` is a unit, then
`a·1 + b·u = 0` forces `a = b = 0`. -/
theorem eq_zero_of_smul_one_add_smul_eq_zero {u : A}
    (hdisc : IsUnit (C.elementDiscriminant u)) {a b : k}
    (h : a • (1 : A) + b • u = 0) : a = 0 ∧ b = 0 := by
  -- The two displayed rows are exactly the coordinates of `polarSpanCoordinates u (a, b)`, so
  -- this is the injectivity half of the criterion above rather than a second `2 × 2` solve.
  have hz : C.polarSpanCoordinates u (a, b) = 0 := by
    rw [polarSpanCoordinates_apply, Prod.mk_eq_zero]
    exact ⟨C.trace_eq_zero_of_smul_one_add_smul_eq_zero h,
      C.polar_eq_zero_of_smul_one_add_smul_eq_zero h⟩
  have h0 := ((C.bijective_polarSpanCoordinates_iff_isUnit_discriminant u).mpr hdisc).1
    (hz.trans (map_zero _).symm)
  exact ⟨congrArg Prod.fst h0, congrArg Prod.snd h0⟩

omit [SMulCommClass k A A] [IsScalarTower k A A] in
theorem quadraticSpan_injective_of_isUnit_discriminant {u : A}
    (hdisc : IsUnit (C.elementDiscriminant u)) : Function.Injective (spanOne k u) := by
  rw [← LinearMap.ker_eq_bot]
  ext p
  simp only [LinearMap.mem_ker, Submodule.mem_bot]
  constructor
  · intro hp
    obtain ⟨h₁, h₂⟩ := C.eq_zero_of_smul_one_add_smul_eq_zero hdisc hp
    exact Prod.ext h₁ h₂
  · rintro rfl
    simp

/-- **`GPR 19.8`, `(ii) ⇔ (iii)`.** The pair `(1,u)` is a basis of `k[u]` and the
restricted norm is regular if and only if `t(u)² - 4n(u)` is a unit. The restricted norm is
written through this basis as `normOnSpan`. -/
theorem basis_and_regular_iff_isUnit_discriminant (u : A) :
    (Function.Bijective (C.spanOneToAdjoin u) ∧ (C.normOnSpan u).IsGPRRegular) ↔
      IsUnit (C.elementDiscriminant u) := by
  constructor
  · exact fun h ↦ (C.normOnSpan_isGPRRegular_iff_isUnit_discriminant u).mp h.2
  · intro hdisc
    refine ⟨⟨?_, C.spanOneToAdjoin_surjective u⟩,
      (C.normOnSpan_isGPRRegular_iff_isUnit_discriminant u).mpr hdisc⟩
    intro p q hpq
    exact C.quadraticSpan_injective_of_isUnit_discriminant hdisc (congrArg Subtype.val hpq)

/-- Under the unit-discriminant hypothesis, `(1,u)` is a basis of `k[u]`, expressed as a linear
equivalence `k × k ≃ k[u]`. -/
noncomputable def quadraticSpanEquiv {u : A} (hdisc : IsUnit (C.elementDiscriminant u)) :
    (k × k) ≃ₗ[k] C.adjoinElement u where
  toFun p := ⟨spanOne k u p, ⟨p, rfl⟩⟩
  invFun x := x.2.choose
  left_inv p := C.quadraticSpan_injective_of_isUnit_discriminant hdisc
    (⟨p, rfl⟩ : spanOne k u p ∈ C.adjoinElement u).choose_spec
  right_inv x := Subtype.ext x.2.choose_spec
  map_add' p q := Subtype.ext (map_add (spanOne k u) p q)
  map_smul' a p := Subtype.ext (map_smul (spanOne k u) a p)

/-- Under the unit-discriminant hypothesis `k[u]` has constant rank two, being the image of `k²`
under `quadraticSpanEquiv`. -/
theorem rankAtStalk_adjoinElement [Nontrivial k] {u : A}
    (hdisc : IsUnit (C.elementDiscriminant u)) :
    Module.rankAtStalk (R := k) (C.adjoinElement u).toNonUnitalSubalgebra.toSubmodule =
      fun _ ↦ 2 := by
  change Module.rankAtStalk (R := k) (C.adjoinElement u) = fun _ ↦ 2
  rw [← Module.rankAtStalk_eq_of_equiv (C.quadraticSpanEquiv hdisc), Module.rankAtStalk_prod,
    Module.rankAtStalk_self]
  rfl

/-- The coefficient norm is the restricted norm read through the coefficient equivalence. This is
the form of that identification consumed by `QuadraticForm.isGPRRegular_comp_linearEquiv_iff`. -/
theorem normOnSpan_eq_comp_quadraticSpanEquiv {u : A}
    (hdisc : IsUnit (C.elementDiscriminant u)) :
    C.normOnSpan u = (C.normAdjoinElement u).comp (C.quadraticSpanEquiv hdisc).toLinearMap :=
  QuadraticMap.ext fun _ ↦ rfl

/-- A unit discriminant makes the norm restricted to `k[u]` regular. -/
theorem normAdjoinElement_isGPRRegular {u : A}
    (hdisc : IsUnit (C.elementDiscriminant u)) : (C.normAdjoinElement u).IsGPRRegular :=
  (QuadraticForm.isGPRRegular_comp_linearEquiv_iff (C.quadraticSpanEquiv hdisc)).mp
    (C.normOnSpan_eq_comp_quadraticSpanEquiv hdisc ▸
      (C.normOnSpan_isGPRRegular_iff_isUnit_discriminant u).mpr hdisc)

/-- **`GPR 19.8`, `(iii) ⇒ (i)`.** A unit discriminant makes `k[u]`, with its restricted
norm, a regular rank-two composition algebra. The rank-two basis is `quadraticSpanEquiv`. -/
theorem isComposition_conicAdjoinElement {u : A}
    (hdisc : IsUnit (C.elementDiscriminant u)) :
    letI := C.adjoinElementCommRing u
    letI := C.adjoinElementAlgebra u
    letI : Module.Free k (C.adjoinElement u) :=
      Module.Free.of_equiv (C.quadraticSpanEquiv hdisc)
    letI : Module.Finite k (C.adjoinElement u) :=
      Module.Finite.equiv (C.quadraticSpanEquiv hdisc)
    (C.conicAdjoinElement u).IsComposition.{u, v, u} := by
  let := C.adjoinElementCommRing u
  let := C.adjoinElementAlgebra u
  let : Module.Free k (C.adjoinElement u) :=
    Module.Free.of_equiv (C.quadraticSpanEquiv hdisc)
  let : Module.Finite k (C.adjoinElement u) :=
    Module.Finite.equiv (C.quadraticSpanEquiv hdisc)
  exact
    { isGPRNonsingular := (C.normAdjoinElement_isGPRRegular hdisc).isGPRNonsingular
      isMultiplicative := C.isMultiplicative_conicAdjoinElement u }

/-- `k[u]` admits the structure of a regular rank-two composition algebra, the condition in
`GPR 19.8(i)`.

The composition norm is existential data and is **not** assumed to be the ambient norm restricted
to `k[u]`. Identifying the two norms is a conclusion of `GPR 19.8(i) ⇒ (ii)`, using uniqueness
of conic norms on finitely generated projective algebras. -/
structure RegularRankTwoCompositionStructure (u : A) where
  /-- A conic structure on the abstract algebra `k[u]`; its norm is not definitionally the
  restriction of the ambient norm. -/
  conic : ConicAlgebra k (C.adjoinElement u)
  /-- The quadratic subalgebra is projective. -/
  projective : Module.Projective k (C.adjoinElement u)
  /-- Its rank at every maximal ideal agrees with that of the free module `k²`. -/
  rank_two : ∀ (m : Ideal k) [m.IsMaximal],
    Module.rankAtStalk (k × k) ⟨m, inferInstance⟩ =
      Module.rankAtStalk (C.adjoinElement u) ⟨m, inferInstance⟩
  /-- The composition norm is regular in GPR's sense. -/
  regular : conic.norm.IsGPRRegular
  /-- The chosen norm permits composition. -/
  isMultiplicative : conic.IsMultiplicative

/-- The proposition that the abstract algebra `k[u]` admits a regular rank-two composition
structure. The witnessing norm is intentionally existential. -/
def IsRegularRankTwoComposition (u : A) : Prop :=
  Nonempty (C.RegularRankTwoCompositionStructure u)

/-- A regular rank-two quadratic-subalgebra structure is an actual composition algebra in the
sense of `ConicAlgebra.IsComposition`. -/
theorem RegularRankTwoCompositionStructure.isComposition {u : A}
    (h : C.RegularRankTwoCompositionStructure u) :
    letI := C.adjoinElementCommRing u
    letI := C.adjoinElementAlgebra u
    letI : Module.Finite k (C.adjoinElement u) := C.finite_adjoinElement u
    letI : Module.Projective k (C.adjoinElement u) := h.projective
    h.conic.IsComposition.{u, v, u} := by
  let := C.adjoinElementCommRing u
  let := C.adjoinElementAlgebra u
  let : Module.Finite k (C.adjoinElement u) := C.finite_adjoinElement u
  let : Module.Projective k (C.adjoinElement u) := h.projective
  exact
    { isGPRNonsingular := h.regular.isGPRNonsingular
      isMultiplicative := h.isMultiplicative }

/-- In condition `GPR 19.8(i)`, the abstract composition norm on `k[u]` is forced to equal the
ambient conic norm restricted to `k[u]`. This is the uniqueness step missing if condition (i) is
defined using the restricted norm from the outset. -/
theorem RegularRankTwoCompositionStructure.conic_norm_eq_normAdjoinElement {u : A}
    (h : C.RegularRankTwoCompositionStructure u) :
    h.conic.norm = C.normAdjoinElement u := by
  let : Module.Finite k (C.adjoinElement u) := C.finite_adjoinElement u
  let : Module.Projective k (C.adjoinElement u) := h.projective
  exact ConicAlgebra.norm_eq_of_projective h.conic (C.restrict (C.adjoinElement u))

/-- Pulling the restricted norm back through the coefficient equivalence preserves regularity. -/
theorem normOnSpan_isGPRRegular_of_normAdjoinElement_isGPRRegular (u : A)
    (hbasis : Function.Bijective (C.spanOneToAdjoin u))
    (hregular : (C.normAdjoinElement u).IsGPRRegular) : (C.normOnSpan u).IsGPRRegular := by
  have he : C.normOnSpan u =
      (C.normAdjoinElement u).comp (LinearEquiv.ofBijective _ hbasis).toLinearMap :=
    QuadraticMap.ext fun _ ↦ rfl
  exact he ▸ hregular.comp_linearEquiv _

/-- **`GPR 19.8`, `(i) ⇔ (iii)`.** The generated algebra `k[u]` is a regular rank-two
composition algebra if and only if `t(u)² - 4n(u)` is a unit. -/
theorem isRegularRankTwoComposition_iff_isUnit_discriminant (u : A) :
    C.IsRegularRankTwoComposition u ↔ IsUnit (C.elementDiscriminant u) := by
  constructor
  · intro h
    obtain ⟨h⟩ := h
    let := C.finite_adjoinElement u
    let := h.projective
    have hbasis : Function.Bijective (C.spanOneToAdjoin u) :=
      Module.bijective_of_surjective_of_rankAtStalk_eq
        (C.spanOneToAdjoin_surjective u) h.rank_two
    have hregular : (C.normAdjoinElement u).IsGPRRegular := by
      rw [← h.conic_norm_eq_normAdjoinElement]
      exact h.regular
    exact (C.normOnSpan_isGPRRegular_iff_isUnit_discriminant u).mp
      (C.normOnSpan_isGPRRegular_of_normAdjoinElement_isGPRRegular u hbasis hregular)
  · intro hdisc
    let e := C.quadraticSpanEquiv hdisc
    exact ⟨
      { conic := C.conicAdjoinElement u
        projective := by
          let : Module.Free k (C.adjoinElement u) := Module.Free.of_equiv e
          infer_instance
        rank_two := fun m _ ↦ congrFun (Module.rankAtStalk_eq_of_equiv e) ⟨m, inferInstance⟩
        regular := C.normAdjoinElement_isGPRRegular hdisc
        isMultiplicative := C.isMultiplicative_conicAdjoinElement u }⟩

/-- **`GPR 19.8`.** The three conditions are equivalent: `k[u]` is a regular rank-two
composition algebra; `(1,u)` is a basis and the restricted norm is regular; and the discriminant
`t(u)² - 4n(u)` is a unit. -/
theorem regularRankTwoComposition_iff_basisAndRegular (u : A) :
    C.IsRegularRankTwoComposition u ↔
      Function.Bijective (C.spanOneToAdjoin u) ∧ (C.normOnSpan u).IsGPRRegular :=
  (C.isRegularRankTwoComposition_iff_isUnit_discriminant u).trans
    (C.basis_and_regular_iff_isUnit_discriminant u).symm

/-! ### Constant rank two over an LG ring -/

section ConstantRankTwo

variable [Module.Finite k A] [Module.Projective k A]

/-- A finitely generated projective conic algebra of constant rank two over an LG ring is
generated by one element: `A = k[u]` (`GPR 19.8`).

The unit is unimodular (`GPR 16.7`), so a functional `l` with `l 1 = 1` splits `A ≃ k × ker l`,
and `ker l` is projective of constant rank one, hence free (`GPR 11.24`); its generator is `u`.
`GPR 23.4` uses this over a local ring, extending `1` to a basis of `A`. No composition,
regularity or nontriviality hypothesis is needed. -/
theorem exists_forall_mem_adjoinElement_of_isLGRing_of_rankAtStalk_eq_two (hLG : IsLGRing k)
    (hA : Module.rankAtStalk (R := k) A = fun _ ↦ 2) : ∃ u : A, ∀ x : A, x ∈ C.adjoinElement u := by
  rcases subsingleton_or_nontrivial k with hk | hk
  · have : Subsingleton A := Module.subsingleton k A
    exact ⟨0, fun x ↦ (C.mem_adjoinElement_iff 0 x).mpr ⟨0, 0, Subsingleton.elim _ _⟩⟩
  obtain ⟨l, hl⟩ := Module.isUnimodular_iff.mp C.isUnimodular_one
  set e := LinearMap.equivProdKerOfApplyEqOne l 1 hl
  have : Module.Finite k (LinearMap.ker l) := Module.Finite.of_linearEquiv_prod e
  have : Module.Projective k (LinearMap.ker l) := Module.Projective.of_linearEquiv_prod e
  have hker : Module.rankAtStalk (R := k) (LinearMap.ker l) = fun _ ↦ 1 := by
    have hM := Module.rankAtStalk_eq_of_equiv e
    rw [Module.rankAtStalk_prod, Module.rankAtStalk_self] at hM
    funext p
    have := congrFun (hM.symm.trans hA) p
    simp only [Pi.add_apply, Pi.one_apply] at this
    omega
  have : Module.Free k (LinearMap.ker l) :=
    Module.free_of_isLGRing_of_rankAtStalk_eq hLG 1 _ hker
  have hfin : Module.finrank k (LinearMap.ker l) = 1 := by
    obtain ⟨p⟩ : Nonempty (PrimeSpectrum k) := inferInstance
    have := congrFun hker p
    rwa [Module.rankAtStalk_eq_finrank_of_free] at this
  let b := Module.finBasisOfFinrankEq k (LinearMap.ker l) hfin
  refine ⟨(b 0 : A), fun x ↦ (C.mem_adjoinElement_iff _ x).mpr ?_⟩
  have hx : x - l x • (1 : A) ∈ LinearMap.ker l := by
    simp only [LinearMap.mem_ker, map_sub, map_smul, hl, smul_eq_mul, mul_one, sub_self]
  refine ⟨l x, b.repr ⟨_, hx⟩ 0, ?_⟩
  have hsum := b.sum_repr ⟨_, hx⟩
  rw [Fin.sum_univ_one] at hsum
  have hcoe : b.repr ⟨_, hx⟩ 0 • (b 0 : A) = x - l x • 1 := congrArg Subtype.val hsum
  rw [hcoe]
  abel

include C in
/-- A finitely generated projective conic algebra of constant rank two over an LG ring is
commutative, being `k[u]` (`GPR 16.4`). -/
theorem mul_comm_of_isLGRing_of_rankAtStalk_eq_two (hLG : IsLGRing k)
    (hA : Module.rankAtStalk (R := k) A = fun _ ↦ 2) (x y : A) : x * y = y * x := by
  obtain ⟨u, hmem⟩ := C.exists_forall_mem_adjoinElement_of_isLGRing_of_rankAtStalk_eq_two hLG hA
  exact congrArg Subtype.val (C.adjoinElement_mul_comm u ⟨x, hmem x⟩ ⟨y, hmem y⟩)

include C in
/-- A finitely generated projective conic algebra of constant rank two over an LG ring is
associative, being `k[u]` (`GPR 16.4`). -/
theorem mul_assoc_of_isLGRing_of_rankAtStalk_eq_two (hLG : IsLGRing k)
    (hA : Module.rankAtStalk (R := k) A = fun _ ↦ 2) (x y z : A) : x * y * z = x * (y * z) := by
  obtain ⟨u, hmem⟩ := C.exists_forall_mem_adjoinElement_of_isLGRing_of_rankAtStalk_eq_two hLG hA
  exact congrArg Subtype.val (C.adjoinElement_mul_assoc u ⟨x, hmem x⟩ ⟨y, hmem y⟩ ⟨z, hmem z⟩)

end ConstantRankTwo

end ConicAlgebra

/-!
# Cells of the orientation double cover

Two fixed-point-free involutions `a`, `b` of a type `D` have a common sign-reversing function
`D → Bool` (`exists_bool_flip_of_involutions`): every orbit of the group they generate is an even
cycle (or a pair), so the union of the two perfect matchings `a` and `b` is bipartite. The proof
writes every element of the dihedral group as `(b a) ^ m` or `(b a) ^ m a` and observes that the
elements of the second kind are conjugates of `a` or `b`, so have no fixed point.

Consequently, for a closed-surface map `G`, every residue of two of the three involutions lifts to
exactly two residues of the orientation double cover, and the double cover has exactly twice as
many cells of each dimension (`GMap.natCard_cell_orientationDoubleCover`).

## References

* S. Wilson, *Maniplexes: Part 1: maps, polytopes, symmetry and operators*, Symmetry 4 (2012),
  265–275, §5.
-/

@[expose] public section

namespace LeanPool.PseudolineArrangements

open Equiv

section Dihedral

variable {D : Type*} {a b : Perm D}

/-- In the group generated by two involutions `a, b`, with `g = b a`, the conjugation by `a`
inverts the powers of `g`. -/
theorem mul_zpow_eq_zpow_neg_mul (ha : a * a = 1) (hb : b * b = 1) (m : ℤ) :
    a * (b * a) ^ m = (b * a) ^ (-m) * a := by
  have ha' : a⁻¹ = a := inv_eq_of_mul_eq_one_right ha
  have h1 : a * (b * a) * a⁻¹ = (b * a)⁻¹ := by
    rw [ha', mul_inv_rev, inv_eq_of_mul_eq_one_right hb, ha']
    calc a * (b * a) * a = a * b * (a * a) := by simp only [mul_assoc]
      _ = a * b := by rw [ha, mul_one]
  have h2 : a * (b * a) ^ m * a⁻¹ = (b * a) ^ (-m) := by
    rw [← conj_zpow, h1, inv_zpow, zpow_neg]
  calc a * (b * a) ^ m = a * (b * a) ^ m * a⁻¹ * a := (inv_mul_cancel_right _ _).symm
    _ = _ := by rw [h2]

theorem mul_zpow_eq_zpow_neg_mul' (ha : a * a = 1) (hb : b * b = 1) (m : ℤ) :
    b * (b * a) ^ m = (b * a) ^ (-m) * b := by
  have hb' : b⁻¹ = b := inv_eq_of_mul_eq_one_right hb
  have h1 : b * (b * a) * b⁻¹ = (b * a)⁻¹ := by
    rw [hb', mul_inv_rev, inv_eq_of_mul_eq_one_right ha, hb']
    calc b * (b * a) * b = (b * b) * a * b := by simp only [mul_assoc]
      _ = a * b := by rw [hb, one_mul]
  have h2 : b * (b * a) ^ m * b⁻¹ = (b * a) ^ (-m) := by
    rw [← conj_zpow, h1, inv_zpow, zpow_neg]
  calc b * (b * a) ^ m = b * (b * a) ^ m * b⁻¹ * b := (inv_mul_cancel_right _ _).symm
    _ = _ := by rw [h2]

/-- The elements `(b a) ^ m a` of the dihedral group are fixed-point free, being conjugates of `a`
or of `b`. -/
theorem zpow_mul_apply_ne (ha : a * a = 1) (hb : b * b = 1) (hfa : ∀ x, a x ≠ x)
    (hfb : ∀ x, b x ≠ x) (m : ℤ) (x : D) : ((b * a) ^ m * a) x ≠ x := by
  obtain ⟨k, rfl | rfl⟩ := Int.even_or_odd' m
  · have h : (b * a) ^ (2 * k) * a = (b * a) ^ k * a * ((b * a) ^ k)⁻¹ := by
      rw [mul_assoc, ← zpow_neg, mul_zpow_eq_zpow_neg_mul ha hb, neg_neg, ← mul_assoc,
        ← zpow_add, two_mul]
    rw [h]
    intro hx
    apply hfa (((b * a) ^ k)⁻¹ x)
    have := congrArg (fun y => ((b * a) ^ k)⁻¹ y) hx
    simpa [Perm.mul_apply, perm_inv_apply_self] using this
  · have h : (b * a) ^ (2 * k + 1) * a = (b * a) ^ k * b * ((b * a) ^ k)⁻¹ := by
      calc (b * a) ^ (2 * k + 1) * a = (b * a) ^ (2 * k) * (b * (a * a)) := by
            rw [zpow_add_one]; simp only [mul_assoc]
        _ = (b * a) ^ k * (b * a) ^ k * b := by rw [ha, mul_one, ← zpow_add, two_mul]
        _ = (b * a) ^ k * (b * (b * a) ^ (-k)) := by
            rw [mul_zpow_eq_zpow_neg_mul' ha hb, neg_neg, mul_assoc]
        _ = _ := by rw [zpow_neg, mul_assoc]
    rw [h]
    intro hx
    apply hfb (((b * a) ^ k)⁻¹ x)
    have := congrArg (fun y => ((b * a) ^ k)⁻¹ y) hx
    simpa [Perm.mul_apply, perm_inv_apply_self] using this

/-- Every element of the group generated by two involutions `a, b` is `(b a) ^ m` or
`(b a) ^ m a`. -/
theorem exists_zpow_of_mem_closure (ha : a * a = 1) (hb : b * b = 1) {h : Perm D}
    (hh : h ∈ Subgroup.closure {a, b}) :
    ∃ m : ℤ, h = (b * a) ^ m ∨ h = (b * a) ^ m * a := by
  have ha' : a⁻¹ = a := inv_eq_of_mul_eq_one_right ha
  induction hh using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with rfl | rfl
    · exact ⟨0, Or.inr (by simp)⟩
    · exact ⟨1, Or.inr (by rw [zpow_one, mul_assoc, ha, mul_one])⟩
  | one => exact ⟨0, Or.inl (by simp)⟩
  | mul x y _ _ hx hy =>
    obtain ⟨m, rfl | rfl⟩ := hx <;> obtain ⟨k, rfl | rfl⟩ := hy
    · exact ⟨m + k, Or.inl (zpow_add _ _ _).symm⟩
    · exact ⟨m + k, Or.inr (by rw [zpow_add, mul_assoc])⟩
    · refine ⟨m - k, Or.inr ?_⟩
      rw [mul_assoc, mul_zpow_eq_zpow_neg_mul ha hb, ← mul_assoc, ← zpow_add, sub_eq_add_neg]
    · refine ⟨m - k, Or.inl ?_⟩
      rw [mul_assoc, ← mul_assoc a, mul_zpow_eq_zpow_neg_mul ha hb, mul_assoc, ha, mul_one,
        ← zpow_add, sub_eq_add_neg]
  | inv x _ hx =>
    obtain ⟨m, rfl | rfl⟩ := hx
    · exact ⟨-m, Or.inl (zpow_neg _ _).symm⟩
    · refine ⟨m, Or.inr ?_⟩
      rw [mul_inv_rev, ha', ← zpow_neg, mul_zpow_eq_zpow_neg_mul ha hb, neg_neg]

/-- Two fixed-point-free involutions have a common sign-reversing function: the union of two
perfect matchings is bipartite. -/
theorem exists_bool_flip_of_involutions (ha : a * a = 1) (hb : b * b = 1) (hfa : ∀ x, a x ≠ x)
    (hfb : ∀ x, b x ≠ x) : ∃ c : D → Bool, ∀ x, c (a x) = !c x ∧ c (b x) = !c x := by
  classical
  set S := Subgroup.closure ({a, b} : Set (Perm D))
  set R := MulAction.orbitRel S D
  set g := b * a
  let rep : D → D := fun x => (Quotient.mk R x).out
  have hrep : ∀ x, ∃ m : ℤ, x = (g ^ m) (rep x) ∨ x = (g ^ m * a) (rep x) := by
    intro x
    obtain ⟨⟨h, hh⟩, hx⟩ := R.symm (Quotient.mk_out (s := R) x)
    obtain ⟨m, rfl | rfl⟩ := exists_zpow_of_mem_closure ha hb hh
    · exact ⟨m, Or.inl hx.symm⟩
    · exact ⟨m, Or.inr hx.symm⟩
  have hsame : ∀ x (h : Perm D), h ∈ S → rep (h x) = rep x := by
    intro x h hh
    change (Quotient.mk R (h x)).out = (Quotient.mk R x).out
    congr 1
    exact Quotient.sound ⟨⟨h, hh⟩, rfl⟩
  have haS : a ∈ S := Subgroup.subset_closure (by simp)
  have hbS : b ∈ S := Subgroup.subset_closure (by simp)
  have hnot : ∀ m k : ℤ, ∀ r, (g ^ m) r ≠ (g ^ k * a) r := by
    intro m k r h
    apply zpow_mul_apply_ne ha hb hfa hfb (-m + k) r
    have := congrArg (fun y => (g ^ (-m)) y) h
    simp only [← Perm.mul_apply, ← zpow_add, neg_add_cancel, zpow_zero, Perm.one_apply] at this
    rw [zpow_add, mul_assoc]
    exact this.symm
  let c : D → Bool := fun x => decide (∃ m : ℤ, (g ^ m) (rep x) = x)
  have hc_true : ∀ x (m : ℤ), x = (g ^ m) (rep x) → c x = true := fun x m h =>
    decide_eq_true ⟨m, h.symm⟩
  have hc_false : ∀ x (m : ℤ), x = (g ^ m * a) (rep x) → c x = false := fun x m h => by
    refine decide_eq_false ?_
    rintro ⟨k, hk⟩
    exact hnot k m (rep x) (hk.trans h)
  have hga : g * a = b := by rw [mul_assoc, ha, mul_one]
  have e1 : ∀ m : ℤ, a * g ^ m = g ^ (-m) * a := mul_zpow_eq_zpow_neg_mul ha hb
  have e2 : ∀ m : ℤ, b * g ^ m = g ^ (-m + 1) * a := fun m => by
    rw [mul_zpow_eq_zpow_neg_mul' ha hb, zpow_add_one, mul_assoc, hga]
  have e3 : ∀ m : ℤ, a * (g ^ m * a) = g ^ (-m) := fun m => by
    rw [← mul_assoc, e1, mul_assoc, ha, mul_one]
  have e4 : ∀ m : ℤ, b * (g ^ m * a) = g ^ (-m + 1) := fun m => by
    rw [← mul_assoc, e2, mul_assoc, ha, mul_one]
  refine ⟨c, fun x => ?_⟩
  have hra := hsame x a haS
  have hrb := hsame x b hbS
  obtain ⟨m, hx | hx⟩ := hrep x
  · rw [hc_true x m hx]
    refine ⟨hc_false _ (-m) ?_, hc_false _ (-m + 1) ?_⟩
    · rw [hra, ← e1, Perm.mul_apply, ← hx]
    · rw [hrb, ← e2, Perm.mul_apply, ← hx]
  · rw [hc_false x m hx]
    refine ⟨hc_true _ (-m) ?_, hc_true _ (-m + 1) ?_⟩
    · rw [hra, ← e3, Perm.mul_apply, ← hx]
    · rw [hrb, ← e4, Perm.mul_apply, ← hx]

end Dihedral

namespace GMap

variable {n : ℕ} {D : Type*} (G : GMap n D)

/-- Moves inside a residue of the double cover project to moves inside a residue of `G`, and
preserve the sheet corrected by a sign-reversing function. -/
theorem residue_cover_proj (J : Set (Fin (n + 1))) (c : D → Bool)
    (hc : ∀ j ∈ J, ∀ d, c (G.adj j d) = !c d) {g' : Perm (D × Bool)}
    (hg' : g' ∈ Subgroup.closure (G.orientationDoubleCover.adj '' J)) (p : D × Bool) :
    (∃ g ∈ Subgroup.closure (G.adj '' J), g p.1 = (g' p).1) ∧
      xor (g' p).2 (c (g' p).1) = xor p.2 (c p.1) := by
  induction hg' using Subgroup.closure_induction generalizing p with
  | mem x hx =>
    obtain ⟨j, hj, rfl⟩ := hx
    refine ⟨⟨G.adj j, Subgroup.subset_closure ⟨j, hj, rfl⟩, rfl⟩, ?_⟩
    simp only [orientationDoubleCover_adj, hc j hj]
    cases p.2 <;> cases c p.1 <;> rfl
  | one => exact ⟨⟨1, Subgroup.one_mem _, rfl⟩, rfl⟩
  | mul x y _ _ hx hy =>
    obtain ⟨⟨gy, hgy, hy1⟩, hy2⟩ := hy p
    obtain ⟨⟨gx, hgx, hx1⟩, hx2⟩ := hx (y p)
    refine ⟨⟨gx * gy, Subgroup.mul_mem _ hgx hgy, ?_⟩, ?_⟩
    · rw [Perm.mul_apply, hy1, hx1]; rfl
    · rw [Perm.mul_apply, hx2, hy2]
  | inv x _ hx =>
    obtain ⟨⟨g, hg, h1⟩, h2⟩ := hx (x⁻¹ p)
    rw [perm_apply_inv_self] at h1 h2
    refine ⟨⟨g⁻¹, Subgroup.inv_mem _ hg, ?_⟩, h2.symm⟩
    rw [← h1, perm_inv_apply_self]

/-- Moves inside a residue of `G` lift to moves inside a residue of the double cover. -/
theorem residue_lift (J : Set (Fin (n + 1))) {g : Perm D}
    (hg : g ∈ Subgroup.closure (G.adj '' J)) (p : D × Bool) :
    ∃ g' ∈ Subgroup.closure (G.orientationDoubleCover.adj '' J), (g' p).1 = g p.1 := by
  induction hg using Subgroup.closure_induction'' generalizing p with
  | mem x hx =>
    obtain ⟨j, hj, rfl⟩ := hx
    exact ⟨_, Subgroup.subset_closure ⟨j, hj, rfl⟩, rfl⟩
  | inv_mem x hx =>
    obtain ⟨j, hj, rfl⟩ := hx
    refine ⟨_, Subgroup.subset_closure ⟨j, hj, rfl⟩, ?_⟩
    rw [inv_eq_of_mul_eq_one_right (G.adj_mul_self j)]
    rfl
  | one => exact ⟨1, Subgroup.one_mem _, rfl⟩
  | mul x y _ _ hx hy =>
    obtain ⟨y', hy', hy1⟩ := hy p
    obtain ⟨x', hx', hx1⟩ := hx (y' p)
    exact ⟨x' * y', Subgroup.mul_mem _ hx' hy', by rw [Perm.mul_apply, hx1, hy1]; rfl⟩

private theorem bool_eq_xor_of_xor_eq {u v t : Bool} (h : xor u v = t) : u = xor t v := by
  subst h; cases u <;> cases v <;> rfl

/-- With a sign-reversing function on the involutions of `J`, the `J`-residues of the double
cover are two copies of the `J`-residues of `G`. -/
noncomputable def residueCoverEquiv (J : Set (Fin (n + 1))) (c : D → Bool)
    (hc : ∀ j ∈ J, ∀ d, c (G.adj j d) = !c d) :
    Quotient (G.orientationDoubleCover.residueRel J) ≃ Quotient (G.residueRel J) × Bool where
  toFun := Quotient.lift (fun p => (Quotient.mk _ p.1, xor p.2 (c p.1))) fun p q hpq => by
    obtain ⟨⟨s, hs⟩, rfl⟩ := hpq
    obtain ⟨⟨g, hg, h1⟩, h2⟩ := G.residue_cover_proj J c hc hs q
    refine Prod.ext (Quotient.sound ⟨⟨g, hg⟩, h1⟩) h2
  invFun x := Quotient.lift (fun d => Quotient.mk (G.orientationDoubleCover.residueRel J)
      (d, xor x.2 (c d))) (fun d e hde => by
        obtain ⟨⟨s, hs⟩, rfl⟩ := hde
        obtain ⟨g', hg', h1⟩ := G.residue_lift J hs (e, xor x.2 (c e))
        have h2 := (G.residue_cover_proj J c hc hg' (e, xor x.2 (c e))).2
        refine Quotient.sound ⟨⟨g', hg'⟩, Prod.ext h1 ?_⟩
        change (g' (e, xor x.2 (c e))).1 = s e at h1
        rw [h1, Bool.xor_assoc, Bool.xor_self, Bool.xor_false] at h2
        change (g' (e, xor x.2 (c e))).2 = xor x.2 (c (s e))
        exact bool_eq_xor_of_xor_eq h2) x.1
  left_inv q := by
    induction q using Quotient.inductionOn
    rename_i p
    change Quotient.mk _ (p.1, xor (xor p.2 (c p.1)) (c p.1)) = Quotient.mk _ p
    rw [Bool.xor_assoc, Bool.xor_self, Bool.xor_false]
  right_inv := by
    rintro ⟨q, t⟩
    refine Quotient.inductionOn q fun d => ?_
    change (Quotient.mk _ d, xor (xor t (c d)) (c d)) = _
    rw [Bool.xor_assoc, Bool.xor_self, Bool.xor_false]

theorem natCard_residue_orientationDoubleCover (J : Set (Fin (n + 1))) (c : D → Bool)
    (hc : ∀ j ∈ J, ∀ d, c (G.adj j d) = !c d) :
    Nat.card (Quotient (G.orientationDoubleCover.residueRel J)) =
      2 * Nat.card (Quotient (G.residueRel J)) := by
  rw [Nat.card_congr (G.residueCoverEquiv J c hc), Nat.card_prod, Nat.card_eq_fintype_card
    (α := Bool), Fintype.card_bool, mul_comm]

/-- The orientation double cover of a closed-surface flag system of rank 2 doubles every cell
count, hence the Euler characteristic. -/
theorem natCard_cell_orientationDoubleCover (G : GMap2 D) (hS : G.IsClosedSurface)
    (i : Fin 3) : Nat.card (G.orientationDoubleCover.Cell i) = 2 * Nat.card (G.Cell i) := by
  have hinv : ∀ j, G.adj j * G.adj j = 1 := G.adj_mul_self
  obtain ⟨j₁, j₂, hj⟩ : ∃ j₁ j₂ : Fin 3, ∀ j, j ≠ i ↔ j = j₁ ∨ j = j₂ := by
    fin_cases i
    · exact ⟨1, 2, by decide⟩
    · exact ⟨0, 2, by decide⟩
    · exact ⟨0, 1, by decide⟩
  obtain ⟨c, hc⟩ := exists_bool_flip_of_involutions (hinv j₁) (hinv j₂) (hS.1 j₁) (hS.1 j₂)
  refine G.natCard_residue_orientationDoubleCover _ c fun j hjJ d => ?_
  rcases (hj j).1 hjJ with rfl | rfl
  · exact (hc d).1
  · exact (hc d).2

/-- The orientation double cover of a closed-surface map has twice as many vertices, edges and
faces. -/
theorem cellNumbers_orientationDoubleCover (G : GMap2 D) (hS : G.IsClosedSurface) :
    G.orientationDoubleCover.cellNumbers =
      (2 * G.cellNumbers.1, 2 * G.cellNumbers.2.1, 2 * G.cellNumbers.2.2) := by
  simp only [cellNumbers, natCard_cell_orientationDoubleCover G hS]

end GMap

end LeanPool.PseudolineArrangements

module

public import Mathlib.Algebra.Group.Action.End
public import Mathlib.Algebra.Group.Subgroup.Actions
public import Mathlib.Combinatorics.SimpleGraph.Coloring.Vertex
public import Mathlib.GroupTheory.GroupAction.Defs

/-!
# Flag systems

A flag system of rank `n` (Grothendieck's `n`-carte, a maniplex in the sense of Wilson) on a
type `D` of darts, or flags, is a family of involutions `adj 0, …, adj n` of `D` such that
`adj i` and `adj j` commute as soon as `i + 2 ≤ j`. In rank `2` these are the combinatorial maps.

We define flag systems (`GMap`), their monodromy group, residues and cells, connectedness,
isomorphisms, the closed-surface predicate, the flag graph and orientability, and prove that a
flag system is connected exactly when its flag graph is preconnected
(`GMap.isConnected_iff_preconnected_flagGraph`).

## References

* S. Wilson, *Maniplexes: Part 1: maps, polytopes, symmetry and operators*, Symmetry 4 (2012),
  265–275, §5.
* A. Grothendieck, *Esquisse d'un programme* (1984), §3–4.
-/

@[expose] public section

namespace LeanPool.PseudolineArrangements

open Equiv

theorem perm_apply_inv_self {α : Type*} (σ : Perm α) (x : α) : σ (σ⁻¹ x) = x :=
  σ.apply_symm_apply x

theorem perm_inv_apply_self {α : Type*} (σ : Perm α) (x : α) : σ⁻¹ (σ x) = x :=
  σ.symm_apply_apply x

/-- A flag system of rank `n`: involutions `adj i` of an arbitrary dart type, with `adj i` and
`adj j` commuting when `i + 2 ≤ j`. -/
structure GMap (n : ℕ) (D : Type*) where
  /-- The involution changing the member of rank `i` of a flag. -/
  adj : Fin (n + 1) → Perm D
  /-- Each `adj i` is an involution. -/
  involutive : ∀ i, Function.Involutive (adj i)
  /-- Distant involutions commute. -/
  commute_of_far : ∀ i j : Fin (n + 1), (i : ℕ) + 2 ≤ j → Commute (adj i) (adj j)

/-- Flag systems of rank 2, the carrier of maps. -/
abbrev GMap2 (D : Type*) := GMap 2 D

namespace GMap

variable {n : ℕ} {D D' D'' : Type*} (G : GMap n D)

/-- The monodromy group: the subgroup of `Perm D` generated by the `adj i`. -/
def monodromy : Subgroup (Perm D) := Subgroup.closure (Set.range G.adj)

/-- The `J`-residue relation: lying in one orbit of the subgroup generated by the `adj j`,
`j ∈ J`. -/
def residueRel (J : Set (Fin (n + 1))) : Setoid D :=
  MulAction.orbitRel (Subgroup.closure (G.adj '' J)) D

/-- The `i`-cells: the residues of `{j | j ≠ i}`. -/
def Cell (i : Fin (n + 1)) : Type _ := Quotient (G.residueRel {j | j ≠ i})

/-- Connected: the monodromy group acts transitively (the empty flag system is connected). -/
def IsConnected : Prop := MulAction.IsPretransitive G.monodromy D

/-- An isomorphism of flag systems: a bijection of darts commuting with every `adj i`. -/
structure Iso (G : GMap n D) (G' : GMap n D') where
  /-- The bijection of darts. -/
  toEquiv : D ≃ D'
  /-- It commutes with every `adj i`. -/
  map_adj : ∀ i d, toEquiv (G.adj i d) = G'.adj i (toEquiv d)

/-- The numbers of `0`-, `1`- and `2`-cells (vertices, edges, faces). -/
noncomputable def cellNumbers (G : GMap2 D) : ℕ × ℕ × ℕ :=
  (Nat.card (G.Cell 0), Nat.card (G.Cell 1), Nat.card (G.Cell 2))

/-- The closed-surface predicate: no dart is fixed by `adj 0`, `adj 1` or `adj 2`, and
`adj 2 d ≠ adj 0 d`. -/
def IsClosedSurface (G : GMap2 D) : Prop :=
  (∀ i d, G.adj i d ≠ d) ∧ ∀ d, G.adj 2 d ≠ G.adj 0 d

/-- The flag graph: two distinct flags are adjacent when some `adj i` exchanges them. -/
def flagGraph : SimpleGraph D where
  Adj d e := d ≠ e ∧ ∃ i, G.adj i d = e
  symm := ⟨fun d e h => ⟨h.1.symm, h.2.imp fun i hi => by rw [← hi, G.involutive i d]⟩⟩
  loopless := ⟨fun _ h => h.1 rfl⟩

/-- Orientable: the flag graph is bipartite. -/
def IsOrientable : Prop := G.flagGraph.Colorable 2

@[simp]
theorem adj_adj (i : Fin (n + 1)) (d : D) : G.adj i (G.adj i d) = d := G.involutive i d

theorem adj_mul_self (i : Fin (n + 1)) : G.adj i * G.adj i = 1 :=
  Equiv.ext fun d => G.involutive i d

theorem adj_mem_monodromy (i : Fin (n + 1)) : G.adj i ∈ G.monodromy :=
  Subgroup.subset_closure ⟨i, rfl⟩

/-- Each `adj i` moves a flag to a flag reachable from it in the flag graph. -/
theorem reachable_adj (i : Fin (n + 1)) (d : D) : G.flagGraph.Reachable d (G.adj i d) := by
  by_cases h : d = G.adj i d
  · rw [← h]
  · exact SimpleGraph.Adj.reachable ⟨h, i, rfl⟩

/-- Every element of the monodromy group moves flags inside their component of the flag graph. -/
theorem reachable_of_mem_monodromy {g : Perm D} (hg : g ∈ G.monodromy) (d : D) :
    G.flagGraph.Reachable d (g d) := by
  induction hg using Subgroup.closure_induction generalizing d with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact G.reachable_adj i d
  | one => rfl
  | mul x y _ _ hx hy => exact (hy d).trans (hx (y d))
  | inv x _ hx =>
    have := hx (x⁻¹ d)
    rw [perm_apply_inv_self] at this
    exact this.symm

/-- Flags joined by a path of the flag graph are related by the monodromy group. -/
theorem exists_mem_monodromy_of_reachable {d e : D} (h : G.flagGraph.Reachable d e) :
    ∃ g ∈ G.monodromy, g d = e := by
  rw [SimpleGraph.reachable_iff_reflTransGen] at h
  induction h with
  | refl => exact ⟨1, G.monodromy.one_mem, rfl⟩
  | tail _ hbc ih =>
    obtain ⟨g, hg, rfl⟩ := ih
    obtain ⟨_, i, rfl⟩ := hbc
    exact ⟨G.adj i * g, G.monodromy.mul_mem (G.adj_mem_monodromy i) hg, rfl⟩

theorem isConnected_iff_forall_exists :
    G.IsConnected ↔ ∀ d e : D, ∃ g ∈ G.monodromy, g d = e := by
  constructor
  · intro h d e
    obtain ⟨g, hg⟩ := h.exists_smul_eq d e
    exact ⟨g, g.2, hg⟩
  · intro h
    refine ⟨fun d e => ?_⟩
    obtain ⟨g, hg, rfl⟩ := h d e
    exact ⟨⟨g, hg⟩, rfl⟩

/-- A flag system is connected iff its flag graph is preconnected (Wilson 2012, §5). -/
theorem isConnected_iff_preconnected_flagGraph :
    G.IsConnected ↔ G.flagGraph.Preconnected := by
  rw [isConnected_iff_forall_exists]
  constructor
  · intro h d e
    obtain ⟨g, hg, rfl⟩ := h d e
    exact G.reachable_of_mem_monodromy hg d
  · intro h d e
    exact G.exists_mem_monodromy_of_reachable (h d e)

namespace Iso

variable {G} {G' : GMap n D'} {G'' : GMap n D''}

/-- The identity isomorphism. -/
@[simps]
def refl (G : GMap n D) : G.Iso G := ⟨Equiv.refl D, fun _ _ => rfl⟩

/-- The inverse of an isomorphism. -/
@[simps]
def symm (f : G.Iso G') : G'.Iso G where
  toEquiv := f.toEquiv.symm
  map_adj i d := by
    apply f.toEquiv.injective
    rw [f.map_adj, Equiv.apply_symm_apply, Equiv.apply_symm_apply]

/-- The composite of two isomorphisms. -/
@[simps]
def trans (f : G.Iso G') (g : G'.Iso G'') : G.Iso G'' where
  toEquiv := f.toEquiv.trans g.toEquiv
  map_adj i d := by simp [f.map_adj, g.map_adj]

/-- An isomorphism carries the flag graph onto the flag graph. -/
def flagGraphIso (f : G.Iso G') : G.flagGraph ≃g G'.flagGraph where
  toEquiv := f.toEquiv
  map_rel_iff' {d e} := by
    change (f.toEquiv d ≠ f.toEquiv e ∧ ∃ i, G'.adj i (f.toEquiv d) = f.toEquiv e) ↔
      (d ≠ e ∧ ∃ i, G.adj i d = e)
    simp only [ne_eq, EmbeddingLike.apply_eq_iff_eq, ← f.map_adj]

theorem isConnected_iff (f : G.Iso G') : G.IsConnected ↔ G'.IsConnected := by
  rw [isConnected_iff_preconnected_flagGraph, isConnected_iff_preconnected_flagGraph]
  exact f.flagGraphIso.preconnected_iff

theorem isOrientable_iff (f : G.Iso G') : G.IsOrientable ↔ G'.IsOrientable :=
  ⟨fun ⟨c⟩ => ⟨c.comp f.symm.flagGraphIso.toHom⟩, fun ⟨c⟩ => ⟨c.comp f.flagGraphIso.toHom⟩⟩

end Iso

end GMap

end LeanPool.PseudolineArrangements

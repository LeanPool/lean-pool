/-! # Intervals: certified bounds for the zeta(5) proof

The endpoint certificates are grouped into four modules. This module combines them into
an interval covering and the potential bound on the whole half-line.
-/

@[expose] public section

open Finset

namespace Zeta5Irrational

lemma cov_0_2 :
    ∀ t, (0 : ℝ) ≤ t → t ≤ (21522393 / 400000000000 : ℝ) → 0 < t → 2 * Uρ t - Vfield t ≤ M0 :=
  fun t h1 h2 h0 =>
  (le_or_gt t (7174131 / 200000000000 : ℝ)).elim (fun h => tc_0 t h1 h h0)
    (fun h => tc_1 t h.le h2 h0)


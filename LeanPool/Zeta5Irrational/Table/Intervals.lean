theorem potential_ineq (t : ℝ) (ht : 0 < t) : 2 * Uρ t - Vfield t ≤ M0 := by
  rcases le_or_gt t 2 with h | h
  · exact cov_0_684 t ht.le h ht
  · exact potential_ineq_tail h.le

end Zeta5Irrational

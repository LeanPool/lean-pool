public import Mathlib.Analysis.Real.Pi.Bounds
public import Mathlib.Analysis.SpecialFunctions.Log.Base

/-!
# Bounds for anisotropic Carleson operators: proof of Theorem 1.1

Part of the formalization of Theorem 1.1 of

* J. Roos, *Bounds for anisotropic Carleson operators*, arXiv:1710.10962v1 (2017),
  J. Fourier Anal. Appl. (doi:10.1007/s00041-018-09657-7).

This file contains the reduction of Theorem 1.1 to the bound for the model operator
(Theorem 3.2, `Auto.thm_3_2` in `LeanPool/CarlesonLT/Auto/ModelOperator.lean`):
the averaging procedure and
Lemma 3.3 (Section 3), and the proof of Theorem 1.1 itself (cone decomposition, reflections,
averaging and weak type bounds). The main results are `Auto.thm_1_1` and
`Auto.anisotropic_carleson`, the latter in the formulation of `LeanPool/CarlesonLT/Defs.lean`.
-/

@[expose] public section

noncomputable section

open MeasureTheory Real Complex UnitAddTorus
open scoped NNReal ENNReal InnerProductSpace SchwartzMap ComplexConjugate

namespace CarlesonLT.Auto

variable {n : ℕ}

/-! ### Fourier series on a box and the fixed-scale identity (paper, Lemma 3.3, texline~233) -/

section TorusParseval

/-- The Haar probability measure on the unit circle, as in
    `Mathlib.Analysis.Fourier.AddCircleMulti`. -/
local instance unitCircleMeasureSpace : MeasureSpace UnitAddCircle := ⟨AddCircle.haarAddCircle⟩

local instance unitCircleProbabilityMeasure :
    IsProbabilityMeasure (volume : Measure UnitAddCircle) :=
  inferInstanceAs (IsProbabilityMeasure AddCircle.haarAddCircle)

/-- The exponential `e^{-2πi⟨ℓ, x⟩}` on `ℝⁿ = Fin n → ℝ`. -/
def expLat (ℓ : Fin n → ℤ) (x : Fin n → ℝ) : ℂ :=
  Complex.exp (-(2 * π * Complex.I * ∑ i, (ℓ i : ℂ) * (x i : ℂ)))

theorem mFourier_neg_coe (ℓ : Fin n → ℤ) (x : Fin n → ℝ) :
    mFourier (-ℓ) (fun i => (x i : UnitAddCircle)) = expLat ℓ x := by
  simp only [mFourier, ContinuousMap.coe_mk, Pi.neg_apply, fourier_coe_apply, expLat]
  rw [← Complex.exp_sum]
  congr 1
  rw [Finset.mul_sum, ← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  push_cast
  ring

/-- The fundamental domain `∏ᵢ (bᵢ, bᵢ + 1]`. -/
def boxIoc (b : Fin n → ℝ) : Set (Fin n → ℝ) := {x | ∀ i, x i ∈ Set.Ioc (b i) (b i + 1)}

/-- The lift of the torus to the fundamental domain `∏ᵢ (bᵢ, bᵢ + 1]`. -/
def liftT (b : Fin n → ℝ) (t : UnitAddTorus (Fin n)) : Fin n → ℝ :=
  fun i => (AddCircle.equivIoc 1 (b i) (t i) : ℝ)

theorem liftT_coe (b : Fin n → ℝ) {x : Fin n → ℝ} (hx : x ∈ boxIoc b) :
    liftT b (fun i => (x i : UnitAddCircle)) = x := by
  funext i
  simp only [liftT]
  rw [AddCircle.equivIoc_coe_of_mem (hx i)]

theorem measurable_liftT (b : Fin n → ℝ) : Measurable (liftT b) := by
  have : liftT b = Subtype.val ∘ (measurableEquivPiIoc b) := by
    funext t; rfl
  rw [this]
  exact measurable_subtype_coe.comp (measurableEquivPiIoc b).measurable

theorem measurableSet_boxIoc (b : Fin n → ℝ) : MeasurableSet (boxIoc b) := by
  have : boxIoc b = Set.pi Set.univ fun i => Set.Ioc (b i) (b i + 1) := by
    ext x; simp [boxIoc]
  rw [this]
  exact MeasurableSet.univ_pi fun i => measurableSet_Ioc

/-- Parseval's identity for bounded measurable functions supported in a fundamental domain of
`ℤⁿ` (a consequence of Mathlib's Parseval identity on `UnitAddTorus`):
`∑_{ℓ ∈ ℤⁿ} conj(Ghat(ℓ)) Hhat(ℓ) = ∫_B conj(G) H`, with `Ghat(ℓ) = ∫_B e^{-2πi⟨ℓ,x⟩} G(x) dx`. -/
theorem hasSum_parseval_box (b : Fin n → ℝ) {G H : (Fin n → ℝ) → ℂ} (hGm : Measurable G)
    (hHm : Measurable H) {CG CH : ℝ} (hGb : ∀ x, ‖G x‖ ≤ CG) (hHb : ∀ x, ‖H x‖ ≤ CH) :
    HasSum (fun ℓ : Fin n → ℤ => conj (∫ x in boxIoc b, expLat ℓ x * G x) *
        ∫ x in boxIoc b, expLat ℓ x * H x)
      (∫ x in boxIoc b, conj (G x) * H x) := by
  set GT : UnitAddTorus (Fin n) → ℂ := G ∘ liftT b
  set HT : UnitAddTorus (Fin n) → ℂ := H ∘ liftT b
  have hG2 : MemLp GT 2 := MemLp.of_bound (hGm.comp (measurable_liftT b)).aestronglyMeasurable CG
    (Filter.Eventually.of_forall fun t => hGb _)
  have hH2 : MemLp HT 2 := MemLp.of_bound (hHm.comp (measurable_liftT b)).aestronglyMeasurable CH
    (Filter.Eventually.of_forall fun t => hHb _)
  have h := hasSum_prod_mFourierCoeff (hG2.toLp GT) (hH2.toLp HT)
  have hcoef : ∀ (F : (Fin n → ℝ) → ℂ) (hF : MemLp (F ∘ liftT b) 2 (volume : Measure
      (UnitAddTorus (Fin n))))
      (ℓ : Fin n → ℤ), mFourierCoeff (hF.toLp (F ∘ liftT b)) ℓ = ∫ x in boxIoc b, expLat ℓ x * F
          x := by
    intro F hF ℓ
    have h1 : mFourierCoeff (hF.toLp (F ∘ liftT b)) ℓ = mFourierCoeff (F ∘ liftT b) ℓ := by
      unfold mFourierCoeff
      refine integral_congr_ae ?_
      filter_upwards [hF.coeFn_toLp] with t ht
      rw [ht]
    rw [h1, mFourierCoeff_eq_integral _ ℓ b]
    refine setIntegral_congr_fun (measurableSet_boxIoc b) fun x hx => ?_
    simp only [Function.comp_apply, smul_eq_mul]
    rw [mFourier_neg_coe, liftT_coe b hx]
  have hrhs : (∫ t, conj ((hG2.toLp GT) t) * (hH2.toLp HT) t) = ∫ x in boxIoc b, conj (G x) * H
      x := by
    have h1 : (∫ t, conj ((hG2.toLp GT) t) * (hH2.toLp HT) t) = ∫ t, conj (GT t) * HT t := by
      refine integral_congr_ae ?_
      filter_upwards [hG2.coeFn_toLp, hH2.coeFn_toLp] with t h1 h2
      rw [h1, h2]
    rw [h1, integral_preimage _ b]
    refine setIntegral_congr_fun (measurableSet_boxIoc b) fun x hx => ?_
    simp only [GT, HT, Function.comp_apply]
    rw [liftT_coe b hx]
  rw [hrhs] at h
  convert h using 1
  funext ℓ
  rw [hcoef G hG2 ℓ, hcoef H hH2 ℓ]

/-- The affine change of variables `v ↦ c₀ + δ_{2^{-k}}(2π v)` from `Fin n → ℝ` to `ℝⁿ`. -/
def psiMap (α : Fin n → ℕ) (k : ℤ) (c0 : Rn n) (v : Fin n → ℝ) : Rn n :=
  c0 + dil α ((2 : ℝ) ^ k)⁻¹ ((2 * π) • WithLp.toLp 2 v)

theorem continuous_psiMap (α : Fin n → ℕ) (k : ℤ) (c0 : Rn n) : Continuous (psiMap α k c0) := by
  unfold psiMap
  fun_prop

/-- Change of variables along `psiMap`:
`∫ F(ξ) dξ = (2π)^n 2^{-k|α|} ∫ F(c₀ + δ_{2^{-k}}(2π v)) dv`. -/
theorem integral_eq_integral_psiMap (α : Fin n → ℕ) (k : ℤ) (c0 : Rn n) (F : Rn n → ℂ) :
    ∫ ξ, F ξ = ((2 * π) ^ n * ((2 : ℝ) ^ k)⁻¹ ^ absA α : ℝ) •
      ∫ v : Fin n → ℝ, F (psiMap α k c0 v) := by
  set t : ℝ := (2 : ℝ) ^ k
  have ht : 0 < t := by positivity
  have h1 : ∫ ξ, F ξ = ∫ y, F (c0 + y) := (integral_add_left_eq_self F c0).symm
  have h2 : ∫ y, F (c0 + y) = (t⁻¹ ^ absA α) • ∫ y, F (c0 + dil α t⁻¹ y) := by
    rw [integral_comp_dil α (inv_pos.mpr ht) (fun y => F (c0 + y)), smul_smul,
      mul_inv_cancel₀ (by positivity), one_smul]
  have h3 : ∫ y, F (c0 + dil α t⁻¹ y) =
      (2 * π) ^ n • ∫ y : Rn n, F (c0 + dil α t⁻¹ ((2 * π) • y)) := by
    rw [Measure.integral_comp_smul volume (fun y => F (c0 + dil α t⁻¹ y)) (2 * π),
      finrank_euclideanSpace_fin, smul_smul, abs_inv, abs_pow,
      abs_of_pos (by positivity : (0 : ℝ) < 2 * π), mul_inv_cancel₀ (by positivity), one_smul]
  have h4 : ∫ y : Rn n, F (c0 + dil α t⁻¹ ((2 * π) • y)) =
      ∫ v : Fin n → ℝ, F (psiMap α k c0 v) := by
    have hmp := (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin n)).symm
    exact (hmp.integral_comp' (fun y : Rn n => F (c0 + dil α t⁻¹ ((2 * π) • y)))).symm
  rw [h1, h2, h3, h4, smul_smul]
  congr 1
  ring

theorem inner_cI_psiMap (α : Fin n → ℕ) (P : Tile n) (v : Fin n → ℝ) :
    ⟪P.cI α, psiMap α P.k (P.cω0 α) v - P.cω0 α⟫_ℝ = 2 * π * ∑ i, ((P.ℓ i : ℝ) + 1 / 2) * v i := by
  simp only [psiMap, add_sub_cancel_left, PiLp.inner_apply, RCLike.inner_apply, conj_trivial,
    dil_apply, PiLp.smul_apply, Tile.cI, smul_eq_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  have hs : ((2 : ℝ) ^ P.k)⁻¹ ^ α i * side α P.k i = 1 := by
    rw [side, zpow_mul, zpow_natCast, inv_pow, inv_mul_cancel₀ (by positivity)]
  calc ((2 : ℝ) ^ P.k)⁻¹ ^ α i * (2 * π * v i) * (side α P.k i * (P.ℓ i + 1 / 2))
      = (((2 : ℝ) ^ P.k)⁻¹ ^ α i * side α P.k i) * (2 * π * ((P.ℓ i + 1 / 2) * v i)) := by ring
    _ = _ := by rw [hs, one_mul]

theorem dil_psiMap_sub (α : Fin n → ℕ) (k : ℤ) (c0 : Rn n) (v : Fin n → ℝ) :
    dil α ((2 : ℝ) ^ k) (psiMap α k c0 v - c0) = (2 * π) • WithLp.toLp 2 v := by
  simp only [psiMap, add_sub_cancel_left, dil_dil, mul_inv_cancel₀ (by positivity : (2 : ℝ) ^ k
      ≠ 0),
    dil_one]

/-- The unit box `(-1/2, 1/2]ⁿ`. -/
def halfBox (n : ℕ) : Fin n → ℝ := fun _ => -(1 / 2)

theorem phiHat_two_pi_eq_zero {v : Fin n → ℝ} (hv : v ∉ boxIoc (halfBox n)) :
    phiHat ((2 * π) • WithLp.toLp 2 v : Rn n) = 0 := by
  simp only [boxIoc, halfBox, Set.mem_ofPred_eq, not_forall, Set.mem_Ioc, not_and_or,
    not_lt, not_le] at hv
  obtain ⟨i, hi⟩ := hv
  apply phiHat_eq_zero_of_lt (i := i)
  simp only [PiLp.smul_apply, smul_eq_mul, abs_mul,
    abs_of_pos (by positivity : (0 : ℝ) < 2 * π)]
  have hπ := Real.pi_gt_three
  norm_num [b0]
  rcases hi with hi | hi
  · have : 1 / 2 ≤ |v i| := by rw [abs_of_neg (by linarith)]; linarith
    nlinarith
  · have : 1 / 2 ≤ |v i| := by rw [abs_of_pos (by linarith)]; linarith
    nlinarith

/-- `Φ_P(ξ) = φ̂(δ_{2^{k_P}}(ξ - c(ω_{P(0)})))`; it depends only on `k_P` and `u_P`. -/
def PhiP (α : Fin n → ℕ) (P : Tile n) (ξ : Rn n) : ℂ :=
  phiHat (dil α ((2 : ℝ) ^ P.k) (ξ - P.cω0 α))

theorem conj_phiHat (ζ : Rn n) : conj (phiHat ζ) = phiHat ζ := by
  rw [(phiHat_re_mem ζ).1, Complex.conj_ofReal]

/-- The phase `e^{-πi ∑ vᵢ}` coming from the half-integer centers `c(I_P) = δ_{2^k}(ℓ + 1/2)`. -/
def halfPhase (v : Fin n → ℝ) : ℂ := Complex.exp (-(π * Complex.I * ∑ i, (v i : ℂ)))

theorem norm_halfPhase (v : Fin n → ℝ) : ‖halfPhase v‖ = 1 := by
  rw [halfPhase, show -(π * Complex.I * ∑ i, (v i : ℂ)) = ((-(π * ∑ i, v i) : ℝ) : ℂ) * Complex.I by
    push_cast; ring, Complex.norm_exp_ofReal_mul_I]

theorem exp_phase_psiMap (α : Fin n → ℕ) (P : Tile n) (v : Fin n → ℝ) :
    Complex.exp (Complex.I * (⟪P.cI α, psiMap α P.k (P.cω0 α) v - P.cω0 α⟫_ℝ : ℂ)) =
      conj (expLat P.ℓ v * halfPhase v) := by
  rw [inner_cI_psiMap, map_mul, expLat, halfPhase, ← Complex.exp_conj, ← Complex.exp_conj,
    ← Complex.exp_add]
  have h1 : conj (-(2 * π * Complex.I * ∑ i, (P.ℓ i : ℂ) * (v i : ℂ))) =
      Complex.I * ((2 * π * ∑ i, (P.ℓ i : ℝ) * v i : ℝ) : ℂ) := by
    simp only [map_neg, map_mul, map_sum, Complex.conj_I, Complex.conj_ofReal, map_intCast,
      map_ofNat]
    push_cast
    ring
  have h2 : conj (-(π * Complex.I * ∑ i, (v i : ℂ))) =
      Complex.I * ((π * ∑ i, v i : ℝ) : ℂ) := by
    simp only [map_neg, map_mul, map_sum, Complex.conj_I, Complex.conj_ofReal]
    push_cast
    ring
  rw [h1, h2, ← mul_add, ← Complex.ofReal_add]
  congr 3
  rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  ring

/-- The rescaled frequency profile `Gcheck(v) = conj(ĝ(Ψ v) φ̂(2πv)) e^{-πi∑vᵢ}` of a function on
the unit box (for the tile scale and frequency position of `P`). -/
def gCheck (α : Fin n → ℕ) (P : Tile n) (G : Rn n → ℂ) (v : Fin n → ℝ) : ℂ :=
  conj (G (psiMap α P.k (P.cω0 α) v) * phiHat ((2 * π) • WithLp.toLp 2 v : Rn n)) * halfPhase v

theorem gCheck_eq_zero (α : Fin n → ℕ) (P : Tile n) (G : Rn n → ℂ) {v : Fin n → ℝ}
    (hv : v ∉ boxIoc (halfBox n)) : gCheck α P G v = 0 := by
  simp [gCheck, phiHat_two_pi_eq_zero hv]

/-- Box representation of the coefficient `⟨g, φ_P⟩`:
`⟨g, φ_P⟩ = 2^{-k_P|α|/2} conj(∫_B e^{-2πi⟨ℓ_P, v⟩} Gcheck(v) dv)` with `Gcheck = gCheck α P ĝ`. -/
theorem pairing_wavePhi_eq_box (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {g : Rn n → ℂ}
    (hg : Integrable g) (P : Tile n) :
    pairing g (wavePhi α P) = ((((2 : ℝ) ^ P.k) ^ (-(absA α : ℝ) / 2) : ℝ) : ℂ) *
      conj (∫ v in boxIoc (halfBox n), expLat P.ℓ v * gCheck α P (fhat g) v) := by
  set t : ℝ := (2 : ℝ) ^ P.k
  have ht : 0 < t := by positivity
  rw [pairing_eq_fhat hg (continuous_wavePhi α P) (integrable_wavePhi α hα P)
    (integrable_fhat_wavePhi α P), integral_eq_integral_psiMap α P.k (P.cω0 α)]
  have hint : ∀ v : Fin n → ℝ, fhat g (psiMap α P.k (P.cω0 α) v) *
      conj (fhat (wavePhi α P) (psiMap α P.k (P.cω0 α) v)) =
      ((t ^ ((absA α : ℝ) / 2) : ℝ) : ℂ) * conj (expLat P.ℓ v * gCheck α P (fhat g) v) := by
    intro v
    rw [fhat_wavePhi, dil_psiMap_sub]
    simp only [gCheck, map_mul, conj_phiHat, Complex.conj_ofReal, RCLike.conj_conj]
    rw [← Complex.exp_conj, map_neg, map_mul, Complex.conj_I, Complex.conj_ofReal, neg_mul, neg_neg,
      exp_phase_psiMap]
    simp only [map_mul]
    ring
  simp_rw [hint]
  rw [integral_const_mul, ← setIntegral_eq_integral_of_forall_compl_eq_zero (s := boxIoc
      (halfBox n))
    (fun v hv => by simp [gCheck_eq_zero α P _ hv]), integral_conj, Complex.real_smul]
  have hreal : ((2 * π) ^ n)⁻¹ * ((2 * π) ^ n * t⁻¹ ^ absA α) * t ^ ((absA α : ℝ) / 2) =
      t ^ (-(absA α : ℝ) / 2) := by
    have h2π : (2 * π) ^ n ≠ 0 := by positivity
    rw [← mul_assoc, inv_mul_cancel₀ h2π, one_mul, inv_pow, ← Real.rpow_natCast,
      ← Real.rpow_neg ht.le, ← Real.rpow_add ht]
    congr 1; ring
  calc _ = ((((2 * π) ^ n)⁻¹ * ((2 * π) ^ n * t⁻¹ ^ absA α) * t ^ ((absA α : ℝ) / 2) : ℝ) : ℂ) *
        conj (∫ v in boxIoc (halfBox n), expLat P.ℓ v * gCheck α P (fhat g) v) := by
        simp only [t]; push_cast; ring
    _ = _ := by rw [hreal]

/-- The rescaled profile `B_check(v) = m(Ψ v - N) φ̂(2πv) e^{i⟨z, Ψ v⟩} e^{-πi∑vᵢ}` for
`ψ^N_P(z)`. -/
def psiCheck (α : Fin n → ℕ) (P : Tile n) (m : Rn n → ℂ) (N z : Rn n) (v : Fin n → ℝ) : ℂ :=
  m (psiMap α P.k (P.cω0 α) v - N) * phiHat ((2 * π) • WithLp.toLp 2 v : Rn n) *
    Complex.exp (Complex.I * (⟪z, psiMap α P.k (P.cω0 α) v⟫_ℝ : ℂ)) * halfPhase v

theorem psiCheck_eq_zero (α : Fin n → ℕ) (P : Tile n) (m : Rn n → ℂ) (N z : Rn n)
    {v : Fin n → ℝ} (hv : v ∉ boxIoc (halfBox n)) : psiCheck α P m N z v = 0 := by
  simp [psiCheck, phiHat_two_pi_eq_zero hv]

/-- Box representation of `ψ^N_P(z) = 2^{-k_P|α|/2} ∫_B e^{-2πi⟨ℓ_P, v⟩} B_check(v) dv`. -/
theorem wavePsi_eq_box (α : Fin n → ℕ) (m : Rn n → ℂ) (N : Rn n) (P : Tile n) (z : Rn n) :
    wavePsi α m N P z = ((((2 : ℝ) ^ P.k) ^ (-(absA α : ℝ) / 2) : ℝ) : ℂ) *
      ∫ v in boxIoc (halfBox n), expLat P.ℓ v * psiCheck α P m N z v := by
  set t : ℝ := (2 : ℝ) ^ P.k
  have ht : 0 < t := by positivity
  unfold wavePsi
  rw [integral_eq_integral_psiMap α P.k (P.cω0 α)]
  have hint : ∀ v : Fin n → ℝ, m (psiMap α P.k (P.cω0 α) v - N) *
      fhat (wavePhi α P) (psiMap α P.k (P.cω0 α) v) *
        Complex.exp (Complex.I * (⟪z, psiMap α P.k (P.cω0 α) v⟫_ℝ : ℂ)) =
      ((t ^ ((absA α : ℝ) / 2) : ℝ) : ℂ) * (expLat P.ℓ v * psiCheck α P m N z v) := by
    intro v
    rw [fhat_wavePhi, dil_psiMap_sub]
    have h := exp_phase_psiMap α P v
    have h' : Complex.exp (-(Complex.I * (⟪P.cI α, psiMap α P.k (P.cω0 α) v - P.cω0 α⟫_ℝ : ℂ))) =
        expLat P.ℓ v * halfPhase v := by
      have := congrArg (starRingEnd ℂ) h
      rw [RCLike.conj_conj, ← Complex.exp_conj, map_mul,
        Complex.conj_I, Complex.conj_ofReal] at this
      rw [← this]
      congr 1
      ring
    rw [h']
    simp only [psiCheck]
    ring
  simp_rw [hint]
  rw [integral_const_mul, ← setIntegral_eq_integral_of_forall_compl_eq_zero (s := boxIoc
      (halfBox n))
    (fun v hv => by simp [psiCheck_eq_zero α P m N z hv]), Complex.real_smul]
  have hreal : ((2 * π) ^ n)⁻¹ * ((2 * π) ^ n * t⁻¹ ^ absA α) * t ^ ((absA α : ℝ) / 2) =
      t ^ (-(absA α : ℝ) / 2) := by
    have h2π : (2 * π) ^ n ≠ 0 := by positivity
    rw [← mul_assoc, inv_mul_cancel₀ h2π, one_mul, inv_pow, ← Real.rpow_natCast,
      ← Real.rpow_neg ht.le, ← Real.rpow_add ht]
    congr 1; ring
  calc _ = ((((2 * π) ^ n)⁻¹ * ((2 * π) ^ n * t⁻¹ ^ absA α) * t ^ ((absA α : ℝ) / 2) : ℝ) : ℂ) *
        ∫ v in boxIoc (halfBox n), expLat P.ℓ v * psiCheck α P m N z v := by
        simp only [t]; push_cast; ring
    _ = _ := by rw [hreal]

theorem phiHat_two_pi_eq_PhiP (α : Fin n → ℕ) (P : Tile n) (v : Fin n → ℝ) :
    phiHat ((2 * π) • WithLp.toLp 2 v : Rn n) = PhiP α P (psiMap α P.k (P.cω0 α) v) := by
  rw [PhiP, dil_psiMap_sub]

theorem continuous_halfPhase : Continuous (halfPhase : (Fin n → ℝ) → ℂ) := by
  unfold halfPhase
  fun_prop

theorem gCheck_tile (α : Fin n → ℕ) (k : ℤ) (ℓ u : Fin n → ℤ) (G : Rn n → ℂ) :
    gCheck α ⟨k, ℓ, u⟩ G = gCheck α ⟨k, 0, u⟩ G := rfl

theorem psiCheck_tile (α : Fin n → ℕ) (k : ℤ) (ℓ u : Fin n → ℤ) (m : Rn n → ℂ) (N z : Rn n) :
    psiCheck α ⟨k, ℓ, u⟩ m N z = psiCheck α ⟨k, 0, u⟩ m N z := rfl

theorem continuous_gCheck (α : Fin n → ℕ) (P : Tile n) {G : Rn n → ℂ} (hG : Continuous G) :
    Continuous (gCheck α P G) := by
  unfold gCheck
  have h1 := continuous_psiMap α P.k (P.cω0 α)
  have h2 : Continuous fun v : Fin n → ℝ => phiHat ((2 * π) • WithLp.toLp 2 v : Rn n) := by
    fun_prop
  exact (Complex.continuous_conj.comp ((hG.comp h1).mul h2)).mul continuous_halfPhase

theorem measurable_psiCheck (α : Fin n → ℕ) (P : Tile n) {m : Rn n → ℂ} (hm : Measurable m)
    (N z : Rn n) : Measurable (psiCheck α P m N z) := by
  unfold psiCheck
  have h1 := continuous_psiMap α P.k (P.cω0 α)
  have h2 : Continuous fun v : Fin n → ℝ => phiHat ((2 * π) • WithLp.toLp 2 v : Rn n) := by
    fun_prop
  have h3 : Continuous fun v : Fin n → ℝ =>
      Complex.exp (Complex.I * (⟪z, psiMap α P.k (P.cω0 α) v⟫_ℝ : ℂ)) := by
    fun_prop
  exact (((hm.comp (h1.measurable.sub_const N)).mul h2.measurable).mul h3.measurable).mul
    continuous_halfPhase.measurable

/-- The fixed-scale identity behind the paper's "Poisson summation in `u`" (Lemma 3.3,
texline~233–240): for fixed scale `k` and frequency position `u`,
`∑_ℓ ⟨g, φ_P⟩ ψ^N_P(z) = (2π)^{-n} ∫ ĝ(ξ) m(ξ - N) e^{i z ξ} Φ_P(ξ)² dξ`,
the sum over the spatial positions `ℓ` of `P = (k, ℓ, u)`. -/
theorem hasSum_fixedScale (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {m : Rn n → ℂ}
    (hmeas : Measurable m) {Cm : ℝ} (hmb : ∀ ξ, ‖m ξ‖ ≤ Cm) {g : Rn n → ℂ} (hg : Integrable g)
    (hGc : Continuous (fhat g)) {CG : ℝ} (hGb : ∀ ξ, ‖fhat g ξ‖ ≤ CG) (k : ℤ) (u : Fin n → ℤ)
    (N z : Rn n) :
    HasSum (fun ℓ : Fin n → ℤ => pairing g (wavePhi α ⟨k, ℓ, u⟩) * wavePsi α m N ⟨k, ℓ, u⟩ z)
      ((((2 * π) ^ n)⁻¹ : ℂ) * ∫ ξ, fhat g ξ * m (ξ - N) *
        Complex.exp (Complex.I * (⟪z, ξ⟫_ℝ : ℂ)) * PhiP α ⟨k, 0, u⟩ ξ ^ 2) := by
  set P0 : Tile n := ⟨k, 0, u⟩
  set t : ℝ := (2 : ℝ) ^ k
  have ht : 0 < t := by positivity
  set Gc := gCheck α P0 (fhat g)
  set Hc := psiCheck α P0 m N z
  have hGcm : Measurable Gc := (continuous_gCheck α P0 hGc).measurable
  have hHcm : Measurable Hc := measurable_psiCheck α P0 hmeas N z
  have hGcb : ∀ v, ‖Gc v‖ ≤ CG := by
    intro v
    simp only [Gc, gCheck, norm_mul, RCLike.norm_conj, norm_halfPhase, mul_one]
    calc ‖fhat g (psiMap α P0.k (P0.cω0 α) v)‖ * ‖phiHat ((2 * π) • WithLp.toLp 2 v : Rn n)‖
        ≤ CG * 1 := mul_le_mul (hGb _) (norm_phiHat_le_one _) (norm_nonneg _)
          ((norm_nonneg _).trans (hGb 0))
      _ = CG := mul_one _
  have hHcb : ∀ v, ‖Hc v‖ ≤ Cm := by
    intro v
    simp only [Hc, psiCheck, norm_mul, norm_halfPhase, norm_cexp_I_mul, mul_one]
    calc ‖m (psiMap α P0.k (P0.cω0 α) v - N)‖ * ‖phiHat ((2 * π) • WithLp.toLp 2 v : Rn n)‖
        ≤ Cm * 1 := mul_le_mul (hmb _) (norm_phiHat_le_one _) (norm_nonneg _)
          ((norm_nonneg _).trans (hmb 0))
      _ = Cm := mul_one _
  have hpars := (hasSum_parseval_box (halfBox n) hGcm hHcm hGcb hHcb).mul_left
    (((t ^ (-(absA α : ℝ)) : ℝ) : ℂ))
  -- identify the terms
  have hterm : ∀ ℓ : Fin n → ℤ, pairing g (wavePhi α ⟨k, ℓ, u⟩) * wavePsi α m N ⟨k, ℓ, u⟩ z =
      ((t ^ (-(absA α : ℝ)) : ℝ) : ℂ) * (conj (∫ v in boxIoc (halfBox n), expLat ℓ v * Gc v) *
        ∫ v in boxIoc (halfBox n), expLat ℓ v * Hc v) := by
    intro ℓ
    rw [pairing_wavePhi_eq_box α hα hg, wavePsi_eq_box, gCheck_tile, psiCheck_tile]
    have hpow : ((t ^ (-(absA α : ℝ) / 2) : ℝ) : ℂ) * ((t ^ (-(absA α : ℝ) / 2) : ℝ) : ℂ) =
        ((t ^ (-(absA α : ℝ)) : ℝ) : ℂ) := by
      rw [← Complex.ofReal_mul, ← Real.rpow_add ht]
      congr 2; ring
    calc _ = ((t ^ (-(absA α : ℝ) / 2) : ℝ) : ℂ) * ((t ^ (-(absA α : ℝ) / 2) : ℝ) : ℂ) *
          (conj (∫ v in boxIoc (halfBox n), expLat ℓ v * Gc v) *
            ∫ v in boxIoc (halfBox n), expLat ℓ v * Hc v) := by
          simp only [Gc, Hc, P0, t]; ring
      _ = _ := by rw [hpow]
  -- identify the sum
  have hsum : ((t ^ (-(absA α : ℝ)) : ℝ) : ℂ) * ∫ v in boxIoc (halfBox n), conj (Gc v) * Hc v =
      (((2 * π) ^ n)⁻¹ : ℂ) * ∫ ξ, fhat g ξ * m (ξ - N) *
        Complex.exp (Complex.I * (⟪z, ξ⟫_ℝ : ℂ)) * PhiP α ⟨k, 0, u⟩ ξ ^ 2 := by
    set F : Rn n → ℂ := fun ξ => fhat g ξ * m (ξ - N) *
      Complex.exp (Complex.I * (⟪z, ξ⟫_ℝ : ℂ)) * PhiP α ⟨k, 0, u⟩ ξ ^ 2
    have hpt : ∀ v, conj (Gc v) * Hc v = F (psiMap α k (P0.cω0 α) v) := by
      intro v
      have hh : conj (halfPhase v) * halfPhase v = 1 := by
        rw [mul_comm, Complex.mul_conj, Complex.normSq_eq_norm_sq, norm_halfPhase]; simp
      simp only [Gc, Hc, gCheck, psiCheck, F, map_mul, RCLike.conj_conj,
        phiHat_two_pi_eq_PhiP α P0 v]
      calc _ = fhat g (psiMap α P0.k (P0.cω0 α) v) * m (psiMap α P0.k (P0.cω0 α) v - N) *
            Complex.exp (Complex.I * (⟪z, psiMap α P0.k (P0.cω0 α) v⟫_ℝ : ℂ)) *
              PhiP α P0 (psiMap α P0.k (P0.cω0 α) v) ^ 2 * (conj (halfPhase v) * halfPhase v) := by
            ring
        _ = _ := by rw [hh, mul_one]
    have hbox : (∫ v in boxIoc (halfBox n), conj (Gc v) * Hc v) =
        ∫ v : Fin n → ℝ, F (psiMap α k (P0.cω0 α) v) := by
      rw [setIntegral_eq_integral_of_forall_compl_eq_zero fun v hv => by
        simp [Gc, gCheck_eq_zero α P0 _ hv]]
      exact integral_congr_ae (Filter.Eventually.of_forall hpt)
    rw [hbox]
    have hcv := integral_eq_integral_psiMap α k (P0.cω0 α) F
    have hne : ((2 * π) ^ n * t⁻¹ ^ absA α : ℝ) ≠ 0 := by positivity
    have : ∫ v : Fin n → ℝ, F (psiMap α k (P0.cω0 α) v) =
        (((2 * π) ^ n * t⁻¹ ^ absA α : ℝ)⁻¹ : ℝ) • ∫ ξ, F ξ := by
      rw [hcv, smul_smul, inv_mul_cancel₀ hne, one_smul]
    rw [this, Complex.real_smul]
    have hreal : t ^ (-(absA α : ℝ)) * ((2 * π) ^ n * t⁻¹ ^ absA α)⁻¹ = ((2 * π) ^ n)⁻¹ := by
      rw [mul_inv, inv_pow, inv_inv, Real.rpow_neg ht.le, Real.rpow_natCast]
      field_simp
    calc _ = ((t ^ (-(absA α : ℝ)) * ((2 * π) ^ n * t⁻¹ ^ absA α)⁻¹ : ℝ) : ℂ) * ∫ ξ, F ξ := by
          push_cast; ring
      _ = _ := by rw [hreal]; push_cast; ring
  rw [← hsum]
  exact hpars.congr_fun fun ℓ => hterm ℓ

end TorusParseval

/-! ## Section 3: the averaging procedure and Lemma 3.3 -/

/-- The anisotropic ball `𝓑_s = {x : ρ(x) ≤ s}` (paper, §3, texline~210). -/
def ballA (α : Fin n → ℕ) (s : ℝ) : Set (Rn n) := {x | rho α x ≤ s}

/-- An anisotropic cone (paper, §3, texline~207): a proper subset of `ℝⁿ` of the form
`{δ_t ξ : t > 0, ξ ∈ Q}` for a (closed) cube `Q`. -/
def IsAnisoCone (α : Fin n → ℕ) (Θ : Set (Rn n)) : Prop :=
  Θ ≠ Set.univ ∧ ∃ (a : Rn n) (h : ℝ), 0 < h ∧
    Θ = {ζ | ∃ t : ℝ, 0 < t ∧ ∃ ξ ∈ rectIcc a (a + WithLp.toLp 2 (fun _ => h)), ζ = dil α t ξ}

/-- The integrand of the averaging procedure (paper, §3, (3.5)):
`M_{-η} T_{-y} D²_{2^{-s}} A^{r,m}_{2^{-s}η} D²_{2^s} T_y M_η f`, evaluated at `x`. -/
def avgIntegrand (α : Fin n → ℕ) (r : Fin n → Fin 2) (m : Rn n → ℂ) (f : Rn n → ℂ)
    (x η y : Rn n) (s : ℝ) : ℂ :=
  modul (-η) (transl (-y) (dilOp α 2 ((2 : ℝ) ^ (-s))
    (modelOp α r m (dil α ((2 : ℝ) ^ (-s)) η)
      (dilOp α 2 ((2 : ℝ) ^ s) (transl y (modul η f)))))) x

/-- The averages `R^{-2|α|} ∫_{𝓑_R} ∫_{𝓑_R} ∫_0^1 (…) ds dy dη` of (3.5). -/
def avgR (α : Fin n → ℕ) (r : Fin n → Fin 2) (m : Rn n → ℂ) (f : Rn n → ℂ) (x : Rn n)
    (R : ℝ) : ℂ :=
  ((R ^ (-(2 * absA α : ℝ)) : ℝ) : ℂ) *
    ∫ η in ballA α R, ∫ y in ballA α R, ∫ s in (0 : ℝ)..1, avgIntegrand α r m f x η y s

/-- The averaged operator `𝐀^{r,m} f(x) = lim_{R → ∞} R^{-2|α|} ∫_{𝓑_R} ∫_{𝓑_R} ∫_0^1 (…)`
(paper, §3, (3.5)). -/
def avgOp (α : Fin n → ℕ) (r : Fin n → Fin 2) (m : Rn n → ℂ) (f : Rn n → ℂ) (x : Rn n) : ℂ :=
  Filter.limUnder Filter.atTop (avgR α r m f x)

/-- The Fourier transform of `D²_λ T_y M_η f`:
`(D²_λ T_y M_η f)^(ξ) = λ^{|α|/2} e^{-i⟨y, δ_λ ξ⟩} f̂(δ_λ ξ - η)`. -/
theorem fhat_dilOp_transl_modul (α : Fin n → ℕ) {t : ℝ} (ht : 0 < t) (y η : Rn n)
    (f : Rn n → ℂ) (ξ : Rn n) :
    fhat (dilOp α 2 t (transl y (modul η f))) ξ =
      ((t ^ ((absA α : ℝ) / 2) : ℝ) : ℂ) *
        Complex.exp (-(Complex.I * (⟪y, dil α t ξ⟫_ℝ : ℂ))) * fhat f (dil α t ξ - η) := by
  simp only [fhat, dilOp, transl, modul]
  set c : ℂ := ((t ^ (-(absA α : ℝ) / 2) : ℝ) : ℂ)
  set G : Rn n → ℂ := fun w => Complex.exp (-(Complex.I * (⟪dil α t w, ξ⟫_ℝ : ℂ))) *
    (c * (Complex.exp (Complex.I * (⟪w - y, η⟫_ℝ : ℂ)) * f (w - y)))
  have h1 : ∀ x : Rn n, Complex.exp (-(Complex.I * (⟪x, ξ⟫_ℝ : ℂ))) *
      (c * (Complex.exp (Complex.I * (⟪dil α t⁻¹ x - y, η⟫_ℝ : ℂ)) * f (dil α t⁻¹ x - y))) =
      G (dil α t⁻¹ x) := by
    intro x
    simp only [G, dil_dil, mul_inv_cancel₀ ht.ne', dil_one]
  calc (∫ x, Complex.exp (-(Complex.I * (⟪x, ξ⟫_ℝ : ℂ))) *
        (c * (Complex.exp (Complex.I * (⟪dil α t⁻¹ x - y, η⟫_ℝ : ℂ)) * f (dil α t⁻¹ x - y))))
      = ∫ x, G (dil α t⁻¹ x) := by congr 1; ext x; exact h1 x
    _ = (t⁻¹ ^ absA α)⁻¹ • ∫ w, G w := integral_comp_dil α (inv_pos.mpr ht) G
    _ = (t⁻¹ ^ absA α)⁻¹ • ∫ w, G (w + y) := by rw [integral_add_right_eq_self]
    _ = _ := by
        rw [Complex.real_smul]
        have hG : ∀ w, G (w + y) = c * Complex.exp (-(Complex.I * (⟪y, dil α t ξ⟫_ℝ : ℂ))) *
            (Complex.exp (-(Complex.I * (⟪w, dil α t ξ - η⟫_ℝ : ℂ))) * f w) := by
          intro w
          simp only [G, add_sub_cancel_right, inner_add_left, inner_sub_right,
            inner_dil_left]
          rw [show Complex.exp (-(Complex.I * ((⟪w, dil α t ξ⟫_ℝ + ⟪y, dil α t ξ⟫_ℝ : ℝ) : ℂ))) =
            Complex.exp (-(Complex.I * (⟪y, dil α t ξ⟫_ℝ : ℂ))) *
              Complex.exp (-(Complex.I * (⟪w, dil α t ξ⟫_ℝ : ℂ))) by
            rw [← Complex.exp_add]; congr 1; push_cast; ring]
          have : Complex.exp (-(Complex.I * (⟪w, dil α t ξ⟫_ℝ : ℂ))) *
              Complex.exp (Complex.I * (⟪w, η⟫_ℝ : ℂ)) =
              Complex.exp (-(Complex.I * ((⟪w, dil α t ξ⟫_ℝ - ⟪w, η⟫_ℝ : ℝ) : ℂ))) := by
            rw [← Complex.exp_add]; congr 1; push_cast; ring
          calc _ = c * Complex.exp (-(Complex.I * (⟪y, dil α t ξ⟫_ℝ : ℂ))) *
                (Complex.exp (-(Complex.I * (⟪w, dil α t ξ⟫_ℝ : ℂ))) *
                  Complex.exp (Complex.I * (⟪w, η⟫_ℝ : ℂ)) * f w) := by ring
            _ = _ := by rw [this]
        simp_rw [hG]
        rw [integral_const_mul]
        have hpow : ((t⁻¹ ^ absA α)⁻¹ : ℝ) * t ^ (-(absA α : ℝ) / 2) = t ^ ((absA α : ℝ) / 2) := by
          rw [inv_pow, inv_inv, ← Real.rpow_natCast, ← Real.rpow_add ht]
          congr 1; ring
        calc _ = (((t⁻¹ ^ absA α)⁻¹ * t ^ (-(absA α : ℝ) / 2) : ℝ) : ℂ) *
              Complex.exp (-(Complex.I * (⟪y, dil α t ξ⟫_ℝ : ℂ))) *
              ∫ w, Complex.exp (-(Complex.I * (⟪w, dil α t ξ - η⟫_ℝ : ℂ))) * f w := by
              simp only [c]; push_cast; ring
          _ = _ := by rw [hpow]

/-- Bounded overlap: for `r ≠ 0` and fixed `N, ξ`, at most four pairs `(k, u)` have
`N ∈ ω_{P(r)}` and `ξ ∈ S_P` (with `P = (k, ·, u)`). -/
theorem tsum_ind_suppBox_le (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2}
    (hr : r ≠ 0) (N ξ : Rn n) :
    ∑' k : ℤ, ∑' u : Fin n → ℤ,
      ((⟨k, 0, u⟩ : Tile n).semi α r).indicator (fun _ => (1 : ℝ≥0∞)) N *
        (suppBox α ⟨k, 0, u⟩).indicator (fun _ => (1 : ℝ≥0∞)) ξ ≤ 4 := by
  set K : Finset ℤ :=
    Finset.Icc (-(Int.log 2 (rho α (ξ - N))) - 3) (-(Int.log 2 (rho α (ξ - N))))
  have hle : ∀ (k : ℤ) (u : Fin n → ℤ),
      ((⟨k, 0, u⟩ : Tile n).semi α r).indicator (fun _ => (1 : ℝ≥0∞)) N *
        (suppBox α ⟨k, 0, u⟩).indicator (fun _ => (1 : ℝ≥0∞)) ξ ≤
        if k ∈ K then (if u = freqPos α k ξ then 1 else 0) else 0 := by
    intro k u
    by_cases hNP : N ∈ (⟨k, 0, u⟩ : Tile n).semi α r
    · by_cases hξ : ξ ∈ suppBox α ⟨k, 0, u⟩
      · have hb := rho_sub_bounds_of_mem_suppBox α hα hr hNP hξ
        have ht0 : 0 < rho α (ξ - N) := lt_of_lt_of_le (by positivity) hb.1
        have hk : k ∈ K := scales_subset_Icc ht0 hb.1 hb.2
        have hu : u = freqPos α k ξ := u_eq_freqPos_of_mem_suppBox α hξ
        rw [Set.indicator_of_mem hNP, Set.indicator_of_mem hξ]
        simp [hk, hu]
      · simp [Set.indicator_of_notMem hξ]
    · simp [Set.indicator_of_notMem hNP]
  calc _ ≤ ∑' k : ℤ, ∑' u : Fin n → ℤ,
        (if k ∈ K then (if u = freqPos α k ξ then (1 : ℝ≥0∞) else 0) else 0) :=
        ENNReal.tsum_le_tsum fun k => ENNReal.tsum_le_tsum fun u => hle k u
    _ = ∑' k : ℤ, (if k ∈ K then (1 : ℝ≥0∞) else 0) := by
        congr 1
        ext k
        split_ifs with hk
        · exact tsum_ite_eq (freqPos α k ξ) 1
        · simp
    _ = ∑ k ∈ K, (1 : ℝ≥0∞) := by
        rw [tsum_eq_sum (s := K) fun k hk => by simp [hk]]
        exact Finset.sum_congr rfl fun k hk => by simp [hk]
    _ ≤ 4 := by
        simp only [Finset.sum_const, nsmul_eq_mul, mul_one, K, Int.card_Icc]
        norm_cast
        omega

theorem PhiP_eq_zero_of_notMem (α : Fin n → ℕ) (P : Tile n) {ξ : Rn n}
    (hξ : ξ ∉ suppBox α P) : PhiP α P ξ = 0 := by
  by_contra hne
  apply hξ
  intro i
  have hi : |dil α ((2 : ℝ) ^ P.k) (ξ - P.cω0 α) i| < b0 / 2 := by
    by_contra hcon
    exact hne (phiHat_eq_zero_of_lt (not_lt.mp hcon))
  rw [dil_zpow_apply, abs_mul, abs_of_pos (side_pos α P.k i)] at hi
  have hs : side α (-P.k) i * side α P.k i = 1 := by
    rw [← side_add]; simp [side]
  have := mul_lt_mul_of_pos_left hi (side_pos α (-P.k) i)
  rwa [← mul_assoc, hs, one_mul] at this

theorem norm_PhiP_sq_le (α : Fin n → ℕ) (P : Tile n) (ξ : Rn n) :
    ‖PhiP α P ξ ^ 2‖ ≤ (suppBox α P).indicator (fun _ => (1 : ℝ)) ξ := by
  by_cases hξ : ξ ∈ suppBox α P
  · rw [Set.indicator_of_mem hξ, norm_pow]
    have := norm_phiHat_le_one (dil α ((2 : ℝ) ^ P.k) (ξ - P.cω0 α))
    calc ‖PhiP α P ξ‖ ^ 2 ≤ 1 ^ 2 := by gcongr; exact this
      _ = 1 := one_pow 2
  · rw [Set.indicator_of_notMem hξ, PhiP_eq_zero_of_notMem α P hξ]
    simp

/-- The multiplier `Ξ_r(ζ, η, s) = ∑_{k,u} 1_{ω_{P(r)}}(δ_{2^{-s}}η) Φ_P(δ_{2^{-s}}(ζ + η))²`,
`P = (k, ·, u)`, which appears after the fixed-scale identity (Lemma 3.3, texline~239). -/
def XiR (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ η : Rn n) (s : ℝ) : ℂ :=
  ∑' ku : ℤ × (Fin n → ℤ),
    ((⟨ku.1, 0, ku.2⟩ : Tile n).semi α r).indicator (fun _ => (1 : ℂ)) (dil α ((2 : ℝ) ^ (-s)) η) *
      PhiP α ⟨ku.1, 0, ku.2⟩ (dil α ((2 : ℝ) ^ (-s)) (ζ + η)) ^ 2

theorem tsum_enorm_XiR_terms_le (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2}
    (hr : r ≠ 0) (N w : Rn n) :
    ∑' ku : ℤ × (Fin n → ℤ), ‖((⟨ku.1, 0, ku.2⟩ : Tile n).semi α r).indicator
      (fun _ => (1 : ℂ)) N * PhiP α ⟨ku.1, 0, ku.2⟩ w ^ 2‖ₑ ≤ 4 := by
  rw [ENNReal.tsum_prod']
  refine le_trans (ENNReal.tsum_le_tsum fun k => ENNReal.tsum_le_tsum fun u => ?_)
    (tsum_ind_suppBox_le α hα hr N w)
  rw [enorm_mul]
  gcongr
  · by_cases hN : N ∈ (⟨k, 0, u⟩ : Tile n).semi α r
    · simp [Set.indicator_of_mem hN]
    · simp [Set.indicator_of_notMem hN]
  · have := norm_PhiP_sq_le α ⟨k, 0, u⟩ w
    rw [← ofReal_norm]
    by_cases hw : w ∈ suppBox α ⟨k, 0, u⟩
    · rw [Set.indicator_of_mem hw] at this ⊢
      exact ENNReal.ofReal_le_one.mpr this
    · rw [Set.indicator_of_notMem hw] at this ⊢
      rw [le_antisymm this (norm_nonneg _)]
      simp

theorem summable_XiR_terms (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2}
    (hr : r ≠ 0) (N w : Rn n) :
    Summable (fun ku : ℤ × (Fin n → ℤ) => ((⟨ku.1, 0, ku.2⟩ : Tile n).semi α r).indicator
      (fun _ => (1 : ℂ)) N * PhiP α ⟨ku.1, 0, ku.2⟩ w ^ 2) := by
  have h := tsum_enorm_XiR_terms_le α hα hr N w
  have hfin : ∑' ku : ℤ × (Fin n → ℤ), ‖((⟨ku.1, 0, ku.2⟩ : Tile n).semi α r).indicator
      (fun _ => (1 : ℂ)) N * PhiP α ⟨ku.1, 0, ku.2⟩ w ^ 2‖ₑ ≠ ⊤ :=
    ne_top_of_le_ne_top (by norm_num) h
  have := ENNReal.summable_toReal hfin
  exact Summable.of_norm (by simpa [toReal_enorm] using this)

theorem norm_XiR_le (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0)
    (ζ η : Rn n) (s : ℝ) : ‖XiR α r ζ η s‖ ≤ 4 := by
  have h := tsum_enorm_XiR_terms_le α hα hr (dil α ((2 : ℝ) ^ (-s)) η)
    (dil α ((2 : ℝ) ^ (-s)) (ζ + η))
  have hfin := ne_top_of_le_ne_top (by norm_num : (4 : ℝ≥0∞) ≠ ⊤) h
  have hsn := ENNReal.summable_toReal hfin
  calc ‖XiR α r ζ η s‖ ≤ ∑' ku : ℤ × (Fin n → ℤ), ‖((⟨ku.1, 0, ku.2⟩ : Tile n).semi α r).indicator
        (fun _ => (1 : ℂ)) (dil α ((2 : ℝ) ^ (-s)) η) *
          PhiP α ⟨ku.1, 0, ku.2⟩ (dil α ((2 : ℝ) ^ (-s)) (ζ + η)) ^ 2‖ :=
        norm_tsum_le_tsum_norm (by simpa [toReal_enorm] using hsn)
    _ = (∑' ku : ℤ × (Fin n → ℤ), ‖((⟨ku.1, 0, ku.2⟩ : Tile n).semi α r).indicator
        (fun _ => (1 : ℂ)) (dil α ((2 : ℝ) ^ (-s)) η) *
          PhiP α ⟨ku.1, 0, ku.2⟩ (dil α ((2 : ℝ) ^ (-s)) (ζ + η)) ^ 2‖ₑ).toReal := by
        rw [ENNReal.tsum_toReal_eq (fun _ => enorm_ne_top)]
        simp [toReal_enorm]
    _ ≤ (4 : ℝ≥0∞).toReal := ENNReal.toReal_mono (by norm_num) h
    _ = 4 := by norm_num

theorem ClassM.homogeneous' {α : Fin n → ℕ} {ν : ℕ} {m : Rn n → ℂ} (hm : ClassM α ν m)
    (w : Rn n) {t : ℝ} (ht : 0 < t) : m (dil α t w) = m w := by
  by_cases hw : w = 0
  · rw [hw, dil_zero]
  · exact hm.homogeneous w hw t ht

theorem continuous_fhat_schwartz (f : 𝓢(Rn n, ℂ)) : Continuous (fhat (f : Rn n → ℂ)) := by
  have : fhat (f : Rn n → ℂ) = fun ξ => (FourierTransform.fourier f : 𝓢(Rn n, ℂ)) ((2 * π)⁻¹ •
      ξ) := by
    funext ξ; rw [fhat_eq_fourier, SchwartzMap.fourier_coe]
  rw [this]
  exact (SchwartzMap.continuous _).comp (continuous_const_smul _)

theorem norm_fhat_le (f : Rn n → ℂ) (ξ : Rn n) : ‖fhat f ξ‖ ≤ ∫ x, ‖f x‖ := by
  unfold fhat
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  congr 1; ext x
  rw [norm_mul, norm_cexp_neg_I_mul, one_mul]

theorem integrable_dilOp_transl_modul (α : Fin n → ℕ) {t : ℝ} (ht : 0 < t) (y η : Rn n)
    {f : Rn n → ℂ} (hf : Integrable f) : Integrable (dilOp α 2 t (transl y (modul η f))) := by
  have h1 : Integrable (fun w : Rn n => modul η f (w - y)) := by
    have : Integrable (modul η f) := by
      refine hf.norm.mono' ?_ (Filter.Eventually.of_forall fun w => ?_)
      · exact (by fun_prop : Continuous fun w : Rn n =>
          Complex.exp (Complex.I * (⟪w, η⟫_ℝ : ℂ))).aestronglyMeasurable.mul hf.aestronglyMeasurable
      · simp only [modul, norm_mul, norm_cexp_I_mul, one_mul, le_refl]
    exact this.comp_sub_right y
  have h2 : Integrable ((fun w : Rn n => modul η f (w - y)) ∘ dil α t⁻¹) := by
    rw [← (dil_measurableEmbedding α (inv_pos.mpr ht)).integrable_map_iff,
      map_dil_volume α (inv_pos.mpr ht)]
    exact h1.smul_measure ENNReal.ofReal_ne_top
  exact h2.const_mul _

theorem fhat_conj_facts (α : Fin n → ℕ) {t : ℝ} (ht : 0 < t) (y η : Rn n) (f : 𝓢(Rn n, ℂ)) :
    Continuous (fhat (dilOp α 2 t (transl y (modul η (f : Rn n → ℂ))))) ∧
    (∀ ξ, ‖fhat (dilOp α 2 t (transl y (modul η (f : Rn n → ℂ)))) ξ‖ ≤
      t ^ ((absA α : ℝ) / 2) * ∫ x, ‖(f : Rn n → ℂ) x‖) ∧
    Integrable (fhat (dilOp α 2 t (transl y (modul η (f : Rn n → ℂ))))) := by
  have hform := fhat_dilOp_transl_modul α ht y η (f : Rn n → ℂ)
  have hF : fhat (dilOp α 2 t (transl y (modul η (f : Rn n → ℂ)))) = fun ξ =>
      ((t ^ ((absA α : ℝ) / 2) : ℝ) : ℂ) *
        Complex.exp (-(Complex.I * (⟪y, dil α t ξ⟫_ℝ : ℂ))) * fhat f (dil α t ξ - η) :=
    funext hform
  have hc := continuous_fhat_schwartz f
  refine ⟨?_, ?_, ?_⟩
  · rw [hF]
    have := continuous_dil α t
    fun_prop
  · intro ξ
    rw [hform, norm_mul, norm_mul, norm_cexp_neg_I_mul, mul_one, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos (by positivity)]
    gcongr
    exact norm_fhat_le _ _
  · have h1 : Integrable (fun ξ : Rn n => fhat (f : Rn n → ℂ) (dil α t ξ - η)) := by
      have h0 : Integrable ((fun w => fhat (f : Rn n → ℂ) (w - η)) ∘ dil α t) := by
        rw [← (dil_measurableEmbedding α ht).integrable_map_iff, map_dil_volume α ht]
        exact ((integrable_fhat_schwartz f).comp_sub_right η).smul_measure ENNReal.ofReal_ne_top
      exact h0
    have h2 := h1.const_mul (((t ^ ((absA α : ℝ) / 2) : ℝ) : ℂ))
    refine h2.norm.mono' ?_ (Filter.Eventually.of_forall fun ξ => ?_)
    · rw [hF]
      have := continuous_dil α t
      exact (by fun_prop : Continuous fun ξ => ((t ^ ((absA α : ℝ) / 2) : ℝ) : ℂ) *
        Complex.exp (-(Complex.I * (⟪y, dil α t ξ⟫_ℝ : ℂ))) *
          fhat (f : Rn n → ℂ) (dil α t ξ - η)).aestronglyMeasurable
    · rw [hform, norm_mul, norm_mul, norm_cexp_neg_I_mul, mul_one, norm_mul]

/-- Reindexing tiles as ((scale, frequency position), spatial position). -/
def tileEquiv' : Tile n ≃ (ℤ × (Fin n → ℤ)) × (Fin n → ℤ) where
  toFun P := ((P.k, P.u), P.ℓ)
  invFun t := ⟨t.1.1, t.2, t.1.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

theorem semi_tile (α : Fin n → ℕ) (k : ℤ) (ℓ u : Fin n → ℤ) (r : Fin n → Fin 2) :
    (⟨k, ℓ, u⟩ : Tile n).semi α r = (⟨k, 0, u⟩ : Tile n).semi α r := rfl

/-- Decomposition of the model sum over `(k, u)`, with the fixed-scale identity applied to the
sum over the spatial positions (paper, Lemma 3.3, texline~233–240). -/
theorem modelOp_eq_tsum_fixedScale (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2}
    (hr : r ≠ 0) {m : Rn n → ℂ} (hm : ClassM α (absA α + 1) m) {g : Rn n → ℂ}
    (hg : Integrable g) (hGc : Continuous (fhat g)) {CG : ℝ} (hGb : ∀ ξ, ‖fhat g ξ‖ ≤ CG)
    (hGi : Integrable (fhat g)) (N z : Rn n) :
    modelOp α r m N g z = ∑' ku : ℤ × (Fin n → ℤ),
      ((⟨ku.1, 0, ku.2⟩ : Tile n).semi α r).indicator (fun _ => (1 : ℂ)) N *
        ((((2 * π) ^ n)⁻¹ : ℂ) * ∫ ξ, fhat g ξ * m (ξ - N) *
          Complex.exp (Complex.I * (⟪z, ξ⟫_ℝ : ℂ)) * PhiP α ⟨ku.1, 0, ku.2⟩ ξ ^ 2) := by
  obtain ⟨C, hC, hsb⟩ := modelOp_summable_bound α hα hr
  obtain ⟨hsum, -⟩ := hsb m hm g hg hGi N z
  obtain ⟨Cm, -, hmb⟩ := hm.bounded'
  set term : Tile n → ℂ := fun P => pairing g (wavePhi α P) * wavePsi α m N P z *
    (P.semi α r).indicator (fun _ => (1 : ℂ)) N
  have hsum' : Summable (term ∘ tileEquiv'.symm) := (tileEquiv'.symm.summable_iff).mpr hsum
  have h1 : ∑' P, term P = ∑' c, term (tileEquiv'.symm c) := (tileEquiv'.symm.tsum_eq term).symm
  have h2 : ∑' c, term (tileEquiv'.symm c) =
      ∑' ku, ∑' ℓ, term (tileEquiv'.symm (ku, ℓ)) :=
    hsum'.tsum_prod' (fun ku => hsum'.prod_factor ku)
  change ∑' P, term P = _
  rw [h1, h2]
  congr 1
  ext ku
  have hfix := hasSum_fixedScale α hα hm.measurable hmb hg hGc hGb ku.1 ku.2 N z
  have hterm : ∀ ℓ, term (tileEquiv'.symm (ku, ℓ)) =
      pairing g (wavePhi α ⟨ku.1, ℓ, ku.2⟩) * wavePsi α m N ⟨ku.1, ℓ, ku.2⟩ z *
        ((⟨ku.1, 0, ku.2⟩ : Tile n).semi α r).indicator (fun _ => (1 : ℂ)) N := fun ℓ => rfl
  rw [tsum_congr hterm, tsum_mul_right, hfix.tsum_eq]
  ring

/-- Rescaling of a fixed-scale integral under the conjugation `D²_t T_y M_η`
(paper, Lemma 3.3, texline~225–239): the variable `y` drops out. -/
theorem integral_fixedScale_rescale (α : Fin n → ℕ) {ν : ℕ} {m : Rn n → ℂ} (hm : ClassM α ν m)
    {t : ℝ} (ht : 0 < t) (f : Rn n → ℂ) (x y η : Rn n) (P : Tile n) :
    ∫ ξ, fhat (dilOp α 2 t (transl y (modul η f))) ξ * m (ξ - dil α t⁻¹ η) *
        Complex.exp (Complex.I * (⟪dil α t (x + y), ξ⟫_ℝ : ℂ)) * PhiP α P ξ ^ 2 =
      ((t ^ (-(absA α : ℝ) / 2) : ℝ) : ℂ) * Complex.exp (Complex.I * (⟪x, η⟫_ℝ : ℂ)) *
        ∫ ζ, fhat f ζ * m ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ)) *
          PhiP α P (dil α t⁻¹ (ζ + η)) ^ 2 := by
  set H : Rn n → ℂ := fun ξ => fhat (dilOp α 2 t (transl y (modul η f))) ξ * m (ξ - dil α t⁻¹ η) *
    Complex.exp (Complex.I * (⟪dil α t (x + y), ξ⟫_ℝ : ℂ)) * PhiP α P ξ ^ 2
  set K : Rn n → ℂ := fun ζ => fhat f ζ * m ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ)) *
    PhiP α P (dil α t⁻¹ (ζ + η)) ^ 2
  have hHK : ∀ w, H (dil α t⁻¹ w) = ((t ^ ((absA α : ℝ) / 2) : ℝ) : ℂ) *
      Complex.exp (Complex.I * (⟪x, η⟫_ℝ : ℂ)) * K (w - η) := by
    intro w
    simp only [H, K, fhat_dilOp_transl_modul α ht, dil_dil, mul_inv_cancel₀ ht.ne', dil_one,
      sub_add_cancel]
    rw [← dil_sub, hm.homogeneous' _ (inv_pos.mpr ht), inner_dil_left, dil_dil,
      mul_inv_cancel₀ ht.ne', dil_one]
    have hexp : Complex.exp (-(Complex.I * (⟪y, w⟫_ℝ : ℂ))) *
        Complex.exp (Complex.I * (⟪x + y, w⟫_ℝ : ℂ)) =
        Complex.exp (Complex.I * (⟪x, η⟫_ℝ : ℂ)) *
          Complex.exp (Complex.I * (⟪x, w - η⟫_ℝ : ℂ)) := by
      rw [← Complex.exp_add, ← Complex.exp_add]
      congr 1
      simp only [inner_add_left, inner_sub_right]
      push_cast
      ring
    calc _ = ((t ^ ((absA α : ℝ) / 2) : ℝ) : ℂ) * fhat f (w - η) * m (w - η) *
          (Complex.exp (-(Complex.I * (⟪y, w⟫_ℝ : ℂ))) *
            Complex.exp (Complex.I * (⟪x + y, w⟫_ℝ : ℂ))) *
          PhiP α P (dil α t⁻¹ w) ^ 2 := by ring
      _ = _ := by rw [hexp]; ring
  have h1 : ∫ ξ, H ξ = (t⁻¹ ^ absA α) • ∫ w, H (dil α t⁻¹ w) := by
    rw [integral_comp_dil α (inv_pos.mpr ht) H, smul_smul, mul_inv_cancel₀ (by positivity),
      one_smul]
  have h2 : ∫ w, K (w - η) = ∫ ζ, K ζ := integral_sub_right_eq_self K η
  change ∫ ξ, H ξ = _
  rw [h1]
  simp_rw [hHK]
  rw [integral_const_mul, h2, Complex.real_smul]
  have hpow : (t⁻¹ ^ absA α : ℝ) * t ^ ((absA α : ℝ) / 2) = t ^ (-(absA α : ℝ) / 2) := by
    rw [inv_pow, ← Real.rpow_natCast, ← Real.rpow_neg ht.le, ← Real.rpow_add ht]
    congr 1; ring
  calc _ = (((t⁻¹ ^ absA α : ℝ) * t ^ ((absA α : ℝ) / 2) : ℝ) : ℂ) *
        Complex.exp (Complex.I * (⟪x, η⟫_ℝ : ℂ)) * ∫ ζ, K ζ := by push_cast; ring
    _ = _ := by rw [hpow]

theorem continuous_PhiP (α : Fin n → ℕ) (P : Tile n) : Continuous (PhiP α P) := by
  unfold PhiP
  have := continuous_dil α ((2 : ℝ) ^ P.k)
  fun_prop

/-- The averaged integrand of (3.5) as a Fourier multiplier (paper, Lemma 3.3,
texline~225–240): for Schwartz `f`,
`[M_{-η} T_{-y} D²_{2^{-s}} A^{r,m}_{2^{-s}η} D²_{2^s} T_y M_η f](x)
  = (2π)^{-n} ∫ f̂(ζ) m(ζ) e^{i x ζ} Ξ_r(ζ, η, s) dζ`, independently of `y`. -/
theorem avgIntegrand_eq (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0)
    {m : Rn n → ℂ} (hm : ClassM α (absA α + 1) m) (f : 𝓢(Rn n, ℂ)) (x η y : Rn n) (s : ℝ) :
    avgIntegrand α r m f x η y s = (((2 * π) ^ n)⁻¹ : ℂ) *
      ∫ ζ, fhat f ζ * m ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ)) * XiR α r ζ η s := by
  set t : ℝ := (2 : ℝ) ^ s
  have ht : 0 < t := by positivity
  have htinv : (2 : ℝ) ^ (-s) = t⁻¹ := Real.rpow_neg (by norm_num) s
  have ht_def : (2 : ℝ) ^ s = t := rfl
  obtain ⟨hGc, hGb, hGi⟩ := fhat_conj_facts α ht y η f
  have hg : Integrable (dilOp α 2 t (transl y (modul η (f : Rn n → ℂ)))) :=
    integrable_dilOp_transl_modul α ht y η (SchwartzMap.integrable f)
  obtain ⟨Cm, hCm, hmb⟩ := hm.bounded'
  -- unfold the conjugations
  have hunf : avgIntegrand α r m f x η y s =
      Complex.exp (-(Complex.I * (⟪x, η⟫_ℝ : ℂ))) * ((t ^ ((absA α : ℝ) / 2) : ℝ) : ℂ) *
        modelOp α r m (dil α t⁻¹ η) (dilOp α 2 t (transl y (modul η (f : Rn n → ℂ))))
          (dil α t (x + y)) := by
    simp only [avgIntegrand, htinv, ht_def]
    simp only [modul, transl, dilOp, inv_inv, sub_neg_eq_add]
    rw [inner_neg_right]
    have : (t⁻¹ : ℝ) ^ (-(absA α : ℝ) / 2) = t ^ ((absA α : ℝ) / 2) := by
      rw [Real.inv_rpow ht.le, ← Real.rpow_neg ht.le]; congr 1; ring
    rw [this]
    push_cast
    ring_nf
  rw [hunf, modelOp_eq_tsum_fixedScale α hα hr hm hg hGc hGb hGi]
  simp_rw [integral_fixedScale_rescale α hm ht (f : Rn n → ℂ) x y η]
  -- collect constants
  set F : ℤ × (Fin n → ℤ) → Rn n → ℂ := fun ku ζ =>
    ((⟨ku.1, 0, ku.2⟩ : Tile n).semi α r).indicator (fun _ => (1 : ℂ)) (dil α t⁻¹ η) *
      (fhat f ζ * m ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ)) *
        PhiP α ⟨ku.1, 0, ku.2⟩ (dil α t⁻¹ (ζ + η)) ^ 2)
  have hconst : ∀ ku : ℤ × (Fin n → ℤ),
      ((⟨ku.1, 0, ku.2⟩ : Tile n).semi α r).indicator (fun _ => (1 : ℂ)) (dil α t⁻¹ η) *
        ((((2 * π) ^ n)⁻¹ : ℂ) * (((t ^ (-(absA α : ℝ) / 2) : ℝ) : ℂ) *
          Complex.exp (Complex.I * (⟪x, η⟫_ℝ : ℂ)) *
          ∫ ζ, fhat f ζ * m ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ)) *
            PhiP α ⟨ku.1, 0, ku.2⟩ (dil α t⁻¹ (ζ + η)) ^ 2)) =
      ((((2 * π) ^ n)⁻¹ : ℂ) * (((t ^ (-(absA α : ℝ) / 2) : ℝ) : ℂ) *
          Complex.exp (Complex.I * (⟪x, η⟫_ℝ : ℂ)))) * ∫ ζ, F ku ζ := by
    intro ku
    simp only [F]
    rw [integral_const_mul]
    ring
  rw [tsum_congr hconst, tsum_mul_left]
  -- interchange sum and integral
  have hfm : Integrable (fun ζ => fhat f ζ * m ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ))) := by
    refine ((integrable_fhat_schwartz f).norm.const_mul Cm).mono' ?_
      (Filter.Eventually.of_forall fun ζ => ?_)
    · exact (((continuous_fhat_schwartz f).aestronglyMeasurable.mul
        hm.measurable.aestronglyMeasurable).mul
        (by fun_prop : Continuous fun ζ : Rn n =>
          Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ))).aestronglyMeasurable)
    · rw [norm_mul, norm_mul, norm_cexp_I_mul, mul_one, mul_comm]
      exact mul_le_mul_of_nonneg_right (hmb ζ) (norm_nonneg _)
  have hFmeas : ∀ ku, AEStronglyMeasurable (F ku) := by
    intro ku
    simp only [F]
    exact aestronglyMeasurable_const.mul (hfm.aestronglyMeasurable.mul
      (((continuous_PhiP α _).comp ((continuous_dil α t⁻¹).comp
        (continuous_id.add continuous_const))).pow 2).aestronglyMeasurable)
  have hsumint : ∑' ku, ∫⁻ ζ, ‖F ku ζ‖ₑ ≠ ⊤ := by
    have hle : ∑' ku, ∫⁻ ζ, ‖F ku ζ‖ₑ ≤ ∫⁻ ζ, 4 * ‖fhat f ζ * m ζ *
        Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ))‖ₑ := by
      rw [← lintegral_tsum fun ku => (hFmeas ku).enorm]
      refine lintegral_mono fun ζ => ?_
      have hb := tsum_enorm_XiR_terms_le α hα hr (dil α t⁻¹ η) (dil α t⁻¹ (ζ + η))
      set c := ‖fhat f ζ * m ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ))‖ₑ
      set w : ℤ × (Fin n → ℤ) → ℝ≥0∞ := fun ku =>
        ‖((⟨ku.1, 0, ku.2⟩ : Tile n).semi α r).indicator (fun _ => (1 : ℂ)) (dil α t⁻¹ η) *
          PhiP α ⟨ku.1, 0, ku.2⟩ (dil α t⁻¹ (ζ + η)) ^ 2‖ₑ with hw
      have hF : ∀ ku, ‖F ku ζ‖ₑ = w ku * c := by
        intro ku
        simp only [F, hw, c, enorm_mul]
        ring
      calc ∑' ku, ‖F ku ζ‖ₑ = ∑' ku, w ku * c := tsum_congr hF
        _ = (∑' ku, w ku) * c := ENNReal.tsum_mul_right
        _ ≤ 4 * c := by gcongr
    refine ne_top_of_le_ne_top ?_ hle
    rw [lintegral_const_mul' _ _ (by norm_num)]
    exact ENNReal.mul_ne_top (by norm_num) hfm.hasFiniteIntegral.ne
  rw [← integral_tsum hFmeas hsumint]
  have hXi : ∀ ζ, ∑' ku, F ku ζ = fhat f ζ * m ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ)) *
      XiR α r ζ η s := by
    intro ζ
    simp only [F, XiR, htinv]
    rw [← tsum_mul_left]
    congr 1; ext ku
    rw [dil_add]
    ring
  simp_rw [hXi]
  have hexp : Complex.exp (-(Complex.I * (⟪x, η⟫_ℝ : ℂ))) *
      Complex.exp (Complex.I * (⟪x, η⟫_ℝ : ℂ)) = 1 := by
    rw [← Complex.exp_add, neg_add_cancel, Complex.exp_zero]
  have htt : ((t ^ ((absA α : ℝ) / 2) : ℝ) : ℂ) * ((t ^ (-(absA α : ℝ) / 2) : ℝ) : ℂ) = 1 := by
    rw [← Complex.ofReal_mul, ← Real.rpow_add ht, show (absA α : ℝ) / 2 + -(absA α : ℝ) / 2 = 0
        by ring,
      Real.rpow_zero, Complex.ofReal_one]
  calc _ = (Complex.exp (-(Complex.I * (⟪x, η⟫_ℝ : ℂ))) *
        Complex.exp (Complex.I * (⟪x, η⟫_ℝ : ℂ))) *
        (((t ^ ((absA α : ℝ) / 2) : ℝ) : ℂ) * ((t ^ (-(absA α : ℝ) / 2) : ℝ) : ℂ)) *
        ((((2 * π) ^ n)⁻¹ : ℂ) * ∫ ζ, fhat f ζ * m ζ *
          Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ)) * XiR α r ζ η s) := by ring
    _ = _ := by rw [hexp, htt, one_mul, one_mul]

/-! ### Lemma 3.3: the limit `R → ∞` -/

/-- Averaging over the scales `2^{k-s}`, `k ∈ ℤ`, `s ∈ (0, 1]` (paper, Lemma 3.3, texline~244–247,
in the variable `v = log₂ t`): `∫_{(0,1]} ∑_k F(k - s) ds = ∫_ℝ F(v) dv`. -/
theorem lintegral_Ioc_tsum_sub (F : ℝ → ℝ≥0∞) (hF : Measurable F) :
    ∫⁻ s in Set.Ioc (0 : ℝ) 1, ∑' k : ℤ, F (k - s) = ∫⁻ v, F v := by
  have hmeas : ∀ k : ℤ, Measurable fun s : ℝ => F (k - s) :=
    fun k => hF.comp (measurable_const.sub measurable_id)
  rw [lintegral_tsum fun k => (hmeas k).aemeasurable]
  have hk : ∀ k : ℤ, ∫⁻ s in Set.Ioc (0 : ℝ) 1, F (k - s) =
      ∫⁻ v, (Set.Ico ((k : ℝ) - 1) k).indicator F v := by
    intro k
    rw [← lintegral_indicator measurableSet_Ioc]
    have : (fun s : ℝ => (Set.Ioc (0 : ℝ) 1).indicator (fun s => F (k - s)) s) =
        fun s => (fun v => (Set.Ico ((k : ℝ) - 1) k).indicator F v) (k - s) := by
      funext s
      dsimp only
      by_cases hs : s ∈ Set.Ioc (0 : ℝ) 1
      · rw [Set.indicator_of_mem hs, Set.indicator_of_mem]
        simp only [Set.mem_Ico, Set.mem_Ioc] at hs ⊢
        constructor <;> linarith [hs.1, hs.2]
      · rw [Set.indicator_of_notMem hs, Set.indicator_of_notMem]
        simp only [Set.mem_Ico, Set.mem_Ioc, not_and_or, not_lt, not_le] at hs ⊢
        rcases hs with hs | hs
        · right; linarith
        · left; linarith
    rw [this, lintegral_sub_left_eq_self (fun v => (Set.Ico ((k : ℝ) - 1) k).indicator F v) (k : ℝ)]
  simp_rw [hk]
  rw [← lintegral_tsum fun k => (hF.indicator measurableSet_Ico).aemeasurable]
  congr 1
  ext v
  rw [tsum_eq_single (⌊v⌋ + 1)]
  · rw [Set.indicator_of_mem]
    simp only [Int.cast_add, Int.cast_one, add_sub_cancel_right, Set.mem_Ico]
    exact ⟨Int.floor_le v, Int.lt_floor_add_one v⟩
  · intro k hk
    rw [Set.indicator_of_notMem]
    simp only [Set.mem_Ico, not_and_or, not_le, not_lt]
    by_contra hcon
    push Not at hcon
    apply hk
    have h1 : ((k : ℝ) - 1) ≤ v := hcon.1
    have h2 : v < k := hcon.2
    have : ⌊v⌋ = k - 1 := by
      rw [Int.floor_eq_iff]; push_cast; constructor <;> linarith
    omega

/-- The real part of `φ̂` (which is real-valued with values in `[0, 1]`). -/
def phiR (ζ : Rn n) : ℝ := (phiHat ζ).re

theorem phiHat_eq_phiR (ζ : Rn n) : phiHat ζ = (phiR ζ : ℂ) := (phiHat_re_mem ζ).1

theorem phiR_nonneg (ζ : Rn n) : 0 ≤ phiR ζ := (phiHat_re_mem ζ).2.1

theorem phiR_le_one (ζ : Rn n) : phiR ζ ≤ 1 := (phiHat_re_mem ζ).2.2

theorem continuous_phiR : Continuous (phiR : Rn n → ℝ) :=
  Complex.continuous_re.comp continuous_phiHat

/-- The quarter vector `(1/4, …, 1/4)`. -/
def quarterVec (n : ℕ) : Rn n := WithLp.toLp 2 (fun _ => (1 / 4 : ℝ))

/-- `χ(w) = |φ̂|²(w - 1/4)` (paper, Lemma 3.3, texline~255), as an extended nonnegative real. -/
def chiE (w : Rn n) : ℝ≥0∞ := ENNReal.ofReal (phiR (w - quarterVec n) ^ 2)

/-- The closed box `Q_r = [r/2, (r+1)/2]` (paper, Lemma 3.3, texline~248). -/
def boxQ (r : Fin n → Fin 2) : Set (Rn n) :=
  {w | ∀ i, ((r i : ℕ) : ℝ) / 2 ≤ w i ∧ w i ≤ (((r i : ℕ) : ℝ) + 1) / 2}

theorem measurableSet_boxQ (r : Fin n → Fin 2) : MeasurableSet (boxQ r : Set (Rn n)) := by
  have : (boxQ r : Set (Rn n)) = ⋂ i, {w : Rn n | ((r i : ℕ) : ℝ) / 2 ≤ w i ∧
      w i ≤ (((r i : ℕ) : ℝ) + 1) / 2} := by
    ext w; simp [boxQ]
  rw [this]
  refine MeasurableSet.iInter fun i => ?_
  have hc : Measurable fun w : Rn n => w i :=
    ((continuous_apply i).comp (PiLp.continuous_ofLp 2 _)).measurable
  exact (measurableSet_le measurable_const hc).inter (measurableSet_le hc measurable_const)

/-- `G_t(ζ, η) = ∑_u 1_{Q_r}(δ_t η - u) χ(δ_t(ζ + η) - u)` (paper, Lemma 3.3, texline~243). -/
def Gsum (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ η : Rn n) (t : ℝ) : ℝ≥0∞ :=
  ∑' u : Fin n → ℤ, (boxQ r).indicator (fun _ => (1 : ℝ≥0∞)) (dil α t η - latticePt u) *
    chiE (dil α t (ζ + η) - latticePt u)

/-- The multiplier `Ξ_r` as an extended nonnegative real:
`Ξ_r(ζ, η, s) = ∑_k G_{2^{k-s}}(ζ, η)`. -/
def XiE (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ η : Rn n) (s : ℝ) : ℝ≥0∞ :=
  ∑' k : ℤ, Gsum α r ζ η ((2 : ℝ) ^ ((k : ℝ) - s))

theorem mem_semi_iff_boxQ (α : Fin n → ℕ) (k : ℤ) (u : Fin n → ℤ)
    (r : Fin n → Fin 2) (N : Rn n) :
    N ∈ (⟨k, 0, u⟩ : Tile n).semi α r ↔ dil α ((2 : ℝ) ^ k) N - latticePt u ∈ boxQ r := by
  simp only [Tile.semi, boxQ, Set.mem_ofPred_eq, PiLp.sub_apply, dil_zpow_apply, latticePt_apply]
  refine forall_congr' fun i => ?_
  have hs := side_pos α (-k) i
  have hs' : side α k i * side α (-k) i = 1 := by rw [← side_add]; simp [side]
  constructor
  · rintro ⟨h1, h2⟩
    constructor
    · have := mul_le_mul_of_nonneg_left h1 (side_pos α k i).le
      rw [← mul_assoc, hs', one_mul] at this
      linarith
    · have := mul_le_mul_of_nonneg_left h2 (side_pos α k i).le
      rw [← mul_assoc, hs', one_mul] at this
      linarith
  · rintro ⟨h1, h2⟩
    have hN : side α (-k) i * (side α k i * N i) = N i := by
      rw [← mul_assoc, mul_comm (side α (-k) i), hs', one_mul]
    constructor
    · calc side α (-k) i * ((u i : ℝ) + ((r i : ℕ) : ℝ) / 2)
          ≤ side α (-k) i * (side α k i * N i) := by gcongr; linarith
        _ = N i := hN
    · calc N i = side α (-k) i * (side α k i * N i) := hN.symm
        _ ≤ side α (-k) i * ((u i : ℝ) + (((r i : ℕ) : ℝ) + 1) / 2) := by gcongr; linarith

theorem PhiP_eq_phiR (α : Fin n → ℕ) (k : ℤ) (u : Fin n → ℤ) (w : Rn n) :
    PhiP α ⟨k, 0, u⟩ w = (phiR (dil α ((2 : ℝ) ^ k) w - latticePt u - quarterVec n) : ℂ) := by
  rw [PhiP, phiHat_eq_phiR]
  congr 2
  ext i
  simp only [dil_zpow_apply, Tile.cω0, PiLp.sub_apply, latticePt_apply, quarterVec]
  have hs' : side α k i * side α (-k) i = 1 := by rw [← side_add]; simp [side]
  rw [mul_sub, ← mul_assoc, hs', one_mul]
  ring

theorem dil_dil_zpow_rpow (α : Fin n → ℕ) (k : ℤ) (s : ℝ) (w : Rn n) :
    dil α ((2 : ℝ) ^ k) (dil α ((2 : ℝ) ^ (-s)) w) = dil α ((2 : ℝ) ^ ((k : ℝ) - s)) w := by
  rw [dil_dil]
  congr 1
  rw [sub_eq_add_neg, Real.rpow_add (by norm_num), Real.rpow_intCast]

/-- The terms of `Ξ_r`, as extended nonnegative reals. -/
theorem enorm_XiR_term (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ η : Rn n)
    (s : ℝ) (k : ℤ) (u : Fin n → ℤ) :
    ‖((⟨k, 0, u⟩ : Tile n).semi α r).indicator (fun _ => (1 : ℂ)) (dil α ((2 : ℝ) ^ (-s)) η) *
        PhiP α ⟨k, 0, u⟩ (dil α ((2 : ℝ) ^ (-s)) (ζ + η)) ^ 2‖ₑ =
      (boxQ r).indicator (fun _ => (1 : ℝ≥0∞)) (dil α ((2 : ℝ) ^ ((k : ℝ) - s)) η - latticePt u) *
        chiE (dil α ((2 : ℝ) ^ ((k : ℝ) - s)) (ζ + η) - latticePt u) := by
  rw [PhiP_eq_phiR, dil_dil_zpow_rpow, enorm_mul]
  congr 1
  · by_cases hN : dil α ((2 : ℝ) ^ (-s)) η ∈ (⟨k, 0, u⟩ : Tile n).semi α r
    · have hQ := (mem_semi_iff_boxQ α k u r _).mp hN
      rw [dil_dil_zpow_rpow] at hQ
      simp [Set.indicator_of_mem hN, Set.indicator_of_mem hQ]
    · have hQ : dil α ((2 : ℝ) ^ ((k : ℝ) - s)) η - latticePt u ∉ boxQ r := by
        rw [← dil_dil_zpow_rpow]
        exact fun h => hN ((mem_semi_iff_boxQ α k u r _).mpr h)
      simp [Set.indicator_of_notMem hN, Set.indicator_of_notMem hQ]
  · rw [chiE, ← Complex.ofReal_pow, ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (by positivity)]

theorem XiE_le_four (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0)
    (ζ η : Rn n) (s : ℝ) : XiE α r ζ η s ≤ 4 := by
  have h := tsum_enorm_XiR_terms_le α hα hr (dil α ((2 : ℝ) ^ (-s)) η)
    (dil α ((2 : ℝ) ^ (-s)) (ζ + η))
  rw [ENNReal.tsum_prod'] at h
  simp_rw [enorm_XiR_term α r ζ η s] at h
  exact h

/-- `Ξ_r` is the real number underlying `Ξ^E_r`. -/
theorem XiR_eq_toReal (α : Fin n → ℕ) (r : Fin n → Fin 2)
    (ζ η : Rn n) (s : ℝ) : XiR α r ζ η s = ((XiE α r ζ η s).toReal : ℂ) := by
  have hreal : ∀ ku : ℤ × (Fin n → ℤ),
      ((⟨ku.1, 0, ku.2⟩ : Tile n).semi α r).indicator (fun _ => (1 : ℂ)) (dil α ((2 : ℝ) ^ (-s))
          η) *
        PhiP α ⟨ku.1, 0, ku.2⟩ (dil α ((2 : ℝ) ^ (-s)) (ζ + η)) ^ 2 =
      (((boxQ r).indicator (fun _ => (1 : ℝ≥0∞))
          (dil α ((2 : ℝ) ^ ((ku.1 : ℝ) - s)) η - latticePt ku.2) *
        chiE (dil α ((2 : ℝ) ^ ((ku.1 : ℝ) - s)) (ζ + η) - latticePt ku.2)).toReal : ℂ) := by
    intro ku
    rw [← enorm_XiR_term α r ζ η s ku.1 ku.2, toReal_enorm]
    -- the term is a nonnegative real
    rw [PhiP_eq_phiR]
    by_cases hN : dil α ((2 : ℝ) ^ (-s)) η ∈ (⟨ku.1, 0, ku.2⟩ : Tile n).semi α r
    · rw [Set.indicator_of_mem hN, one_mul, ← Complex.ofReal_pow, Complex.norm_real,
        Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    · rw [Set.indicator_of_notMem hN, zero_mul, norm_zero, Complex.ofReal_zero]
  have hfin : ∀ ku : ℤ × (Fin n → ℤ), (boxQ r).indicator (fun _ => (1 : ℝ≥0∞))
      (dil α ((2 : ℝ) ^ ((ku.1 : ℝ) - s)) η - latticePt ku.2) *
        chiE (dil α ((2 : ℝ) ^ ((ku.1 : ℝ) - s)) (ζ + η) - latticePt ku.2) ≠ ⊤ := by
    intro ku
    refine ENNReal.mul_ne_top ?_ ENNReal.ofReal_ne_top
    by_cases h : dil α ((2 : ℝ) ^ ((ku.1 : ℝ) - s)) η - latticePt ku.2 ∈ boxQ r
    · simp [Set.indicator_of_mem h]
    · simp [Set.indicator_of_notMem h]
  unfold XiR
  rw [tsum_congr hreal, ← Complex.ofReal_tsum, ← ENNReal.tsum_toReal_eq hfin, XiE]
  congr 2
  rw [ENNReal.tsum_prod']
  rfl

/-- The lattice count `#{u ∈ ℤⁿ : ρ(p + u) ≤ T}`. -/
def latCount (α : Fin n → ℕ) (p : Rn n) (T : ℝ) : ℝ≥0∞ :=
  ∑' u : Fin n → ℤ, (ballA α T).indicator (fun _ => (1 : ℝ≥0∞)) (p + latticePt u)

theorem indicator_ballA_dil (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {t : ℝ} (ht : 0 < t) (R : ℝ)
    (p : Rn n) :
    (ballA α R).indicator (fun _ => (1 : ℝ≥0∞)) (dil α t⁻¹ p) =
      (ballA α (t * R)).indicator (fun _ => (1 : ℝ≥0∞)) p := by
  have h : dil α t⁻¹ p ∈ ballA α R ↔ p ∈ ballA α (t * R) := by
    simp only [ballA, Set.mem_ofPred_eq, rho_dil α hα (inv_pos.mpr ht)]
    rw [inv_mul_le_iff₀ ht]
  by_cases hp : p ∈ ballA α (t * R)
  · rw [Set.indicator_of_mem hp, Set.indicator_of_mem (h.mpr hp)]
  · rw [Set.indicator_of_notMem hp, Set.indicator_of_notMem (fun h' => hp (h.mp h'))]

theorem measurableSet_ballA (α : Fin n → ℕ) (T : ℝ) : MeasurableSet (ballA α T) :=
  measurableSet_le (continuous_rho α).measurable measurable_const

theorem measurable_chiE : Measurable (chiE : Rn n → ℝ≥0∞) :=
  ENNReal.measurable_ofReal.comp ((continuous_phiR.comp
    (continuous_id.sub continuous_const)).pow 2).measurable

/-- The change of variables (3.7) (paper, Lemma 3.3, texline~248–253), for a fixed scale `t`:
`∫_{𝓑_R} G_t(ζ, η) dη = t^{-|α|} ∫ χ(w) 1_{Q_r}(w - δ_t ζ) #{u : ρ(w - δ_t ζ + u) ≤ tR} dw`. -/
theorem lintegral_ballA_Gsum (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) (r : Fin n → Fin 2) (ζ : Rn n)
    {t : ℝ} (ht : 0 < t) (R : ℝ) :
    ∫⁻ η in ballA α R, Gsum α r ζ η t = ENNReal.ofReal ((t ^ absA α)⁻¹) *
      ∫⁻ w, chiE w * (boxQ r).indicator (fun _ => (1 : ℝ≥0∞)) (w - dil α t ζ) *
        latCount α (w - dil α t ζ) (t * R) := by
  have hQ := measurableSet_boxQ r (n := n)
  have hB := measurableSet_ballA α R
  have hmeasu : ∀ u : Fin n → ℤ, Measurable fun η : Rn n =>
      (boxQ r).indicator (fun _ => (1 : ℝ≥0∞)) (dil α t η - latticePt u) *
        chiE (dil α t (ζ + η) - latticePt u) := by
    intro u
    refine (measurable_const.indicator hQ).comp ((continuous_dil α t).measurable.sub_const _) |>.mul
      (measurable_chiE.comp ((continuous_dil α t).measurable.comp
        (measurable_const.add measurable_id) |>.sub_const _))
  unfold Gsum
  rw [lintegral_tsum fun u => (hmeasu u).aemeasurable]
  have hu : ∀ u : Fin n → ℤ, ∫⁻ η in ballA α R, (boxQ r).indicator (fun _ => (1 : ℝ≥0∞))
      (dil α t η - latticePt u) * chiE (dil α t (ζ + η) - latticePt u) =
      ENNReal.ofReal ((t ^ absA α)⁻¹) * ∫⁻ w, chiE w * (boxQ r).indicator (fun _ => (1 : ℝ≥0∞))
        (w - dil α t ζ) * (ballA α (t * R)).indicator (fun _ => (1 : ℝ≥0∞))
          (w - dil α t ζ + latticePt u) := by
    intro u
    rw [← lintegral_indicator hB]
    set H : Rn n → ℝ≥0∞ := (ballA α R).indicator fun η =>
      (boxQ r).indicator (fun _ => (1 : ℝ≥0∞)) (dil α t η - latticePt u) *
        chiE (dil α t (ζ + η) - latticePt u)
    have h1 : ∫⁻ η, H η = ENNReal.ofReal ((t ^ absA α)⁻¹) * ∫⁻ v, H (dil α t⁻¹ v) := by
      rw [lintegral_comp_dil α (inv_pos.mpr ht), ← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
      rw [show (t ^ absA α)⁻¹ * ((t⁻¹) ^ absA α)⁻¹ = 1 by
        rw [inv_pow, inv_inv, inv_mul_cancel₀ (by positivity)]]
      simp
    have h2 : ∫⁻ v, H (dil α t⁻¹ v) = ∫⁻ w, H (dil α t⁻¹ (w - dil α t ζ + latticePt u)) :=
      (lintegral_add_right_eq_self (fun v => H (dil α t⁻¹ v)) (latticePt u - dil α t ζ)).symm.trans
        (by congr 1; ext w; congr 2; abel)
    rw [h1, h2]
    congr 1
    congr 1
    ext w
    simp only [H]
    have hdd : dil α t (dil α t⁻¹ (w - dil α t ζ + latticePt u)) = w - dil α t ζ + latticePt u := by
      rw [dil_dil, mul_inv_cancel₀ ht.ne', dil_one]
    have hmem := indicator_ballA_dil α hα ht R (w - dil α t ζ + latticePt u)
    by_cases hb : dil α t⁻¹ (w - dil α t ζ + latticePt u) ∈ ballA α R
    · rw [Set.indicator_of_mem hb, ← hmem, Set.indicator_of_mem hb, mul_one, hdd, dil_add, hdd]
      have e1 : w - dil α t ζ + latticePt u - latticePt u = w - dil α t ζ := by abel
      have e2 : dil α t ζ + (w - dil α t ζ + latticePt u) - latticePt u = w := by abel
      rw [e1, e2, mul_comm]
    · rw [Set.indicator_of_notMem hb, ← hmem, Set.indicator_of_notMem hb, mul_zero]
  simp_rw [hu]
  rw [ENNReal.tsum_mul_left]
  congr 1
  have hmw : ∀ u : Fin n → ℤ, Measurable fun w : Rn n => chiE w *
      (boxQ r).indicator (fun _ => (1 : ℝ≥0∞)) (w - dil α t ζ) *
        (ballA α (t * R)).indicator (fun _ => (1 : ℝ≥0∞)) (w - dil α t ζ + latticePt u) := by
    intro u
    exact (measurable_chiE.mul ((measurable_const.indicator hQ).comp
      (measurable_id.sub_const _))).mul ((measurable_const.indicator
        (measurableSet_ballA α (t * R))).comp ((measurable_id.sub_const _).add_const _))
  rw [← lintegral_tsum fun u => (hmw u).aemeasurable]
  congr 1
  ext w
  unfold latCount
  rw [ENNReal.tsum_mul_left]

/-- The one-dimensional count `#{m ∈ ℤ : |x + m| ≤ L}` (for `L ≥ 0`). -/
def cnt1 (x L : ℝ) : ℕ := (⌊-x + L⌋ - ⌈-x - L⌉ + 1).toNat

theorem cnt1_bounds {x L : ℝ} (hL : 0 ≤ L) :
    2 * L - 1 ≤ (cnt1 x L : ℝ) ∧ (cnt1 x L : ℝ) ≤ 2 * L + 1 := by
  have h1 := Int.floor_le (-x + L)
  have h2 := Int.lt_floor_add_one (-x + L)
  have h3 := Int.le_ceil (-x - L)
  have h4 := Int.ceil_lt_add_one (-x - L)
  have hnn : 0 ≤ ⌊-x + L⌋ - ⌈-x - L⌉ + 1 := by
    have : (⌈-x - L⌉ : ℝ) < ⌊-x + L⌋ + 2 := by linarith
    have : ⌈-x - L⌉ < ⌊-x + L⌋ + 2 := by exact_mod_cast this
    omega
  have hc : (cnt1 x L : ℝ) = ((⌊-x + L⌋ : ℝ) - ⌈-x - L⌉ + 1) := by
    unfold cnt1
    rw [show ((⌊-x + L⌋ - ⌈-x - L⌉ + 1).toNat : ℝ) = ((⌊-x + L⌋ - ⌈-x - L⌉ + 1 : ℤ) : ℝ) by
      rw [← Int.cast_natCast, Int.toNat_of_nonneg hnn]]
    push_cast; ring
  rw [hc]
  constructor <;> linarith

theorem mem_ballA_add_iff (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {T : ℝ} (hT : 0 ≤ T) (p : Rn n)
    (u : Fin n → ℤ) :
    p + latticePt u ∈ ballA α T ↔
      ∀ i, u i ∈ Finset.Icc (⌈-p i - T ^ α i⌉) (⌊-p i + T ^ α i⌋) := by
  have hρ : p + latticePt u ∈ ballA α T ↔ ∀ i, |p i + u i| ≤ T ^ α i := by
    simp only [ballA, Set.mem_ofPred_eq]
    constructor
    · intro h i
      have h1 := abs_coord_rpow_le_rho α (p + latticePt u) i
      simp only [PiLp.add_apply, latticePt_apply] at h1
      have hαi : (α i : ℝ) ≠ 0 := by have := hα i; positivity
      have h2 : |p i + u i| ^ ((α i : ℝ)⁻¹) ≤ T := h1.trans h
      have := Real.rpow_le_rpow (by positivity) h2 (Nat.cast_nonneg (α i))
      rwa [← Real.rpow_mul (abs_nonneg _), inv_mul_cancel₀ hαi, Real.rpow_one,
        Real.rpow_natCast] at this
    · intro h
      have : rhoNN α (p + latticePt u) ≤ T.toNNReal := by
        rw [rhoNN_le_iff]
        intro i
        rw [← NNReal.coe_le_coe, Real.coe_toNNReal _ hT]
        simp only [NNReal.coe_rpow, coe_nnnorm, Real.norm_eq_abs, PiLp.add_apply, latticePt_apply]
        have hαi : (0 : ℝ) < α i := by have := hα i; positivity
        calc |p i + u i| ^ ((α i : ℝ)⁻¹) ≤ (T ^ α i) ^ ((α i : ℝ)⁻¹) :=
              Real.rpow_le_rpow (abs_nonneg _) (h i) (by positivity)
          _ = T := by
              rw [← Real.rpow_natCast, ← Real.rpow_mul hT, mul_inv_cancel₀ hαi.ne', Real.rpow_one]
      have := NNReal.coe_le_coe.mpr this
      rwa [Real.coe_toNNReal _ hT] at this
  rw [hρ]
  refine forall_congr' fun i => ?_
  rw [Finset.mem_Icc, Int.ceil_le, Int.le_floor, abs_le]
  constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> linarith

/-- The lattice count is a product of one-dimensional counts. -/
theorem latCount_eq (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {T : ℝ} (hT : 0 ≤ T) (p : Rn n) :
    latCount α p T = ∏ i, (cnt1 (p i) (T ^ α i) : ℝ≥0∞) := by
  set S : Finset (Fin n → ℤ) :=
    Fintype.piFinset fun i => Finset.Icc (⌈-p i - T ^ α i⌉) (⌊-p i + T ^ α i⌋)
  have hind : ∀ u : Fin n → ℤ, (ballA α T).indicator (fun _ => (1 : ℝ≥0∞)) (p + latticePt u) =
      if u ∈ S then 1 else 0 := by
    intro u
    have h := mem_ballA_add_iff α hα hT p u
    by_cases hu : u ∈ S
    · simp only [hu, ↓reduceIte]
      exact Set.indicator_of_mem (h.mpr (Fintype.mem_piFinset.mp hu)) _
    · simp only [hu, ↓reduceIte]
      exact Set.indicator_of_notMem (fun h' => hu (Fintype.mem_piFinset.mpr (h.mp h'))) _
  unfold latCount
  simp_rw [hind]
  rw [tsum_eq_sum (s := S) fun u hu => by simp [hu], Finset.sum_boole]
  rw [Finset.filter_mem_eq_inter, Finset.inter_self, Fintype.card_piFinset]
  push_cast
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [Int.card_Icc, cnt1]
  congr 3
  ring_nf

theorem tendsto_cnt1_div (x : ℝ) {a : ℕ} (ha : 1 ≤ a) :
    Filter.Tendsto (fun T : ℝ => (cnt1 x (T ^ a) : ℝ) / T ^ a) Filter.atTop (nhds 2) := by
  have hTa : Filter.Tendsto (fun T : ℝ => (T ^ a)⁻¹) Filter.atTop (nhds 0) :=
    tendsto_inv_atTop_zero.comp (Filter.tendsto_pow_atTop (by omega))
  have hlo : Filter.Tendsto (fun T : ℝ => 2 - (T ^ a)⁻¹) Filter.atTop (nhds 2) := by
    simpa using tendsto_const_nhds.sub hTa
  have hhi : Filter.Tendsto (fun T : ℝ => 2 + (T ^ a)⁻¹) Filter.atTop (nhds 2) := by
    simpa using tendsto_const_nhds.add hTa
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' hlo hhi ?_ ?_
  · filter_upwards [Filter.eventually_gt_atTop 0] with T hT
    have hb := (cnt1_bounds (x := x) (L := T ^ a) (by positivity)).1
    have hpos : 0 < T ^ a := by positivity
    rw [le_div_iff₀ hpos, sub_mul, inv_mul_cancel₀ hpos.ne']
    linarith
  · filter_upwards [Filter.eventually_gt_atTop 0] with T hT
    have hb := (cnt1_bounds (x := x) (L := T ^ a) (by positivity)).2
    have hpos : 0 < T ^ a := by positivity
    rw [div_le_iff₀ hpos, add_mul, inv_mul_cancel₀ hpos.ne']
    linarith

theorem latCount_mul_eq (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {T : ℝ} (hT : 0 < T) (p : Rn n) :
    latCount α p T * ENNReal.ofReal ((T ^ absA α)⁻¹) =
      ENNReal.ofReal (∏ i, (cnt1 (p i) (T ^ α i) : ℝ) / T ^ α i) := by
  rw [latCount_eq α hα hT.le, ENNReal.ofReal_prod_of_nonneg (fun i _ => by positivity)]
  have hprod : ((T ^ absA α)⁻¹ : ℝ) = ∏ i, (T ^ α i)⁻¹ := by
    rw [absA, ← Finset.prod_pow_eq_pow_sum, Finset.prod_inv_distrib]
  rw [hprod, ENNReal.ofReal_prod_of_nonneg (fun i _ => by positivity), ← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [div_eq_mul_inv, ENNReal.ofReal_mul (Nat.cast_nonneg _), ENNReal.ofReal_natCast]

/-- Lattice count asymptotics (paper, Lemma 3.3, texline~257–259):
`#{u : ρ(p + u) ≤ T} / T^{|α|} → 2ⁿ` as `T → ∞`. -/
theorem tendsto_latCount (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) (p : Rn n) :
    Filter.Tendsto (fun T : ℝ => latCount α p T * ENNReal.ofReal ((T ^ absA α)⁻¹))
      Filter.atTop (nhds (2 ^ n)) := by
  have h1 : Filter.Tendsto (fun T : ℝ => ∏ i, (cnt1 (p i) (T ^ α i) : ℝ) / T ^ α i)
      Filter.atTop (nhds (∏ _i : Fin n, (2 : ℝ))) :=
    tendsto_finsetProd _ fun i _ => tendsto_cnt1_div (p i) (hα i)
  rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin] at h1
  have h2 := (ENNReal.tendsto_ofReal h1)
  rw [show ENNReal.ofReal (2 ^ n) = 2 ^ n by rw [ENNReal.ofReal_pow (by norm_num)]; simp] at h2
  refine h2.congr' ?_
  filter_upwards [Filter.eventually_gt_atTop 0] with T hT
  rw [latCount_mul_eq α hα hT]

theorem latCount_mul_le (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {T : ℝ} (hT : 1 ≤ T) (p : Rn n) :
    latCount α p T * ENNReal.ofReal ((T ^ absA α)⁻¹) ≤ 3 ^ n := by
  rw [latCount_mul_eq α hα (by linarith)]
  calc ENNReal.ofReal (∏ i, (cnt1 (p i) (T ^ α i) : ℝ) / T ^ α i)
      ≤ ENNReal.ofReal (∏ _i : Fin n, (3 : ℝ)) := by
        apply ENNReal.ofReal_le_ofReal
        refine Finset.prod_le_prod₀ (fun i _ => by positivity) fun i _ => ?_
        have hpos : 0 < T ^ α i := by positivity
        have h1 : 1 ≤ T ^ α i := one_le_pow₀ hT
        have hb := (cnt1_bounds (x := p i) (L := T ^ α i) hpos.le).2
        rw [div_le_iff₀ hpos]
        linarith
    _ = 3 ^ n := by
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin, ENNReal.ofReal_pow (by norm_num)]
        simp

theorem chiE_eq_zero {w : Rn n} (hw : ∃ i, b0 / 2 ≤ |w i - 1 / 4|) : chiE w = 0 := by
  obtain ⟨i, hi⟩ := hw
  have : phiR (w - quarterVec n) = 0 := by
    have h := phiHat_eq_zero_of_lt (ξ := w - quarterVec n) (i := i) (by simpa [quarterVec] using hi)
    rw [phiHat_eq_phiR] at h
    exact_mod_cast h
  simp [chiE, this]

theorem chiE_le_one (w : Rn n) : chiE w ≤ 1 := by
  rw [chiE, ENNReal.ofReal_le_one]
  have h0 := phiR_nonneg (w - quarterVec n)
  have h1 := phiR_le_one (w - quarterVec n)
  nlinarith

theorem continuous_dil_param (α : Fin n → ℕ) (ζ : Rn n) :
    Continuous fun t : ℝ => dil α t ζ := by
  have : (fun t : ℝ => dil α t ζ) = fun t => WithLp.toLp 2 (fun i => t ^ α i * ζ i) := rfl
  rw [this]
  exact (PiLp.continuous_toLp 2 _).comp (continuous_pi fun i => by fun_prop)

/-- Support of the `(v, w)`-integrand: if `χ(w) ≠ 0` and `w - δ_{2^v}ζ ∈ Q_r` then, for every `j`
with `r_j = 1`, `2^{v α_j} |ζ_j| ≥ 1/5`, and for every `i`, `2^{v αᵢ} |ζᵢ| ≤ 2`. -/
theorem support_bounds (α : Fin n → ℕ) {r : Fin n → Fin 2} {ζ w : Rn n} {t : ℝ}
    (hχ : chiE w ≠ 0) (hQ : w - dil α t ζ ∈ boxQ r) :
    (∀ j, r j = 1 → 1 / 5 ≤ |t ^ α j * ζ j|) ∧ (∀ i, |t ^ α i * ζ i| ≤ 2) := by
  have hw : ∀ i, |w i - 1 / 4| < b0 / 2 := by
    by_contra h
    push Not at h
    exact hχ (chiE_eq_zero h)
  constructor
  · intro j hj
    have hQj := (hQ j).1
    rw [hj] at hQj
    simp only [Fin.val_one, Nat.cast_one, PiLp.sub_apply, dil_apply] at hQj
    have hwj := hw j
    rw [abs_lt] at hwj
    norm_num [b0] at hwj
    rw [le_abs]
    right
    linarith
  · intro i
    have hQi := hQ i
    simp only [PiLp.sub_apply, dil_apply] at hQi
    have hri : ((r i : ℕ) : ℝ) ≤ 1 := by exact_mod_cast Nat.lt_succ_iff.mp (r i).2
    have hri0 : (0 : ℝ) ≤ ((r i : ℕ) : ℝ) := Nat.cast_nonneg _
    have hwi := hw i
    rw [abs_lt] at hwi
    norm_num [b0] at hwi
    rw [abs_le]
    constructor <;> linarith [hQi.1, hQi.2]

/-- `Θ(ζ) = ∫_ℝ ∫ χ(w) 1_{Q_r}(w - δ_{2^v} ζ) dw dv`, so that `θ_r = 4ⁿ Θ` (paper, Lemma 3.3, (3.8),
in the variable `t = 2^v`). -/
def ThetaE (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ : Rn n) : ℝ≥0∞ :=
  ∫⁻ v : ℝ, ∫⁻ w : Rn n, chiE w * (boxQ r).indicator (fun _ => (1 : ℝ≥0∞))
    (w - dil α ((2 : ℝ) ^ v) ζ)

/-- The multiplier `θ_r(ζ) = 4ⁿ Θ(ζ)` of Lemma 3.3 ((3.8)). -/
def thetaR (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ : Rn n) : ℝ := 4 ^ n * (ThetaE α r ζ).toReal

theorem continuous_dil_two_rpow (α : Fin n → ℕ) (ζ : Rn n) :
    Continuous fun v : ℝ => dil α ((2 : ℝ) ^ v) ζ :=
  (continuous_dil_param α ζ).comp (Real.continuous_const_rpow (by norm_num))

theorem measurable_latCount_param (α : Fin n → ℕ) (ζ : Rn n) (R : ℝ) :
    Measurable fun q : ℝ × Rn n =>
      latCount α (q.2 - dil α ((2 : ℝ) ^ q.1) ζ) ((2 : ℝ) ^ q.1 * R) := by
  unfold latCount
  refine Measurable.tsum fun u => ?_
  have hset : MeasurableSet {q : ℝ × Rn n |
      q.2 - dil α ((2 : ℝ) ^ q.1) ζ + latticePt u ∈ ballA α ((2 : ℝ) ^ q.1 * R)} := by
    simp only [ballA, Set.mem_ofPred_eq]
    refine measurableSet_le ?_ ?_
    · exact (continuous_rho α).measurable.comp
        ((measurable_snd.sub ((continuous_dil_two_rpow α ζ).measurable.comp
            measurable_fst)).add_const _)
    · exact ((Real.continuous_const_rpow (by norm_num)).measurable.comp measurable_fst).mul_const _
  have : (fun q : ℝ × Rn n => (ballA α ((2 : ℝ) ^ q.1 * R)).indicator (fun _ => (1 : ℝ≥0∞))
      (q.2 - dil α ((2 : ℝ) ^ q.1) ζ + latticePt u)) =
      {q : ℝ × Rn n | q.2 - dil α ((2 : ℝ) ^ q.1) ζ + latticePt u ∈
        ballA α ((2 : ℝ) ^ q.1 * R)}.indicator (fun _ => 1) := by
    funext q
    by_cases h : q.2 - dil α ((2 : ℝ) ^ q.1) ζ + latticePt u ∈ ballA α ((2 : ℝ) ^ q.1 * R)
    · rw [Set.indicator_of_mem h, Set.indicator_of_mem (by exact h)]
    · rw [Set.indicator_of_notMem h, Set.indicator_of_notMem (by exact h)]
  rw [this]
  exact measurable_const.indicator hset

theorem measurable_chiQ_param (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ : Rn n) :
    Measurable fun q : ℝ × Rn n => chiE q.2 *
      (boxQ r).indicator (fun _ => (1 : ℝ≥0∞)) (q.2 - dil α ((2 : ℝ) ^ q.1) ζ) :=
  (measurable_chiE.comp measurable_snd).mul ((measurable_const.indicator (measurableSet_boxQ
      r)).comp
    (measurable_snd.sub ((continuous_dil_two_rpow α ζ).measurable.comp measurable_fst)))

/-- The box `{w : |wᵢ - 1/4| ≤ b₀/2}` containing the support of `χ`. -/
def chiBox (n : ℕ) : Set (Rn n) := {w | ∀ i, |w i - 1 / 4| ≤ b0 / 2}

theorem chiE_le_indicator (w : Rn n) :
    chiE w ≤ (chiBox n).indicator (fun _ => (1 : ℝ≥0∞)) w := by
  by_cases hw : w ∈ chiBox n
  · rw [Set.indicator_of_mem hw]; exact chiE_le_one w
  · rw [Set.indicator_of_notMem hw]
    simp only [chiBox, Set.mem_ofPred_eq, not_forall, not_le] at hw
    obtain ⟨i, hi⟩ := hw
    rw [chiE_eq_zero ⟨i, hi.le⟩]

theorem volume_chiBox_lt_top : volume (chiBox n) < ⊤ := by
  have : chiBox n = (WithLp.toLp 2 : (Fin n → ℝ) → Rn n) ''
      Set.pi Set.univ fun _ => Set.Icc (1 / 4 - b0 / 2) (1 / 4 + b0 / 2) := by
    ext w
    constructor
    · intro h
      refine ⟨WithLp.ofLp w, fun i _ => ?_, by simp⟩
      have := abs_le.mp (h i)
      constructor <;> linarith [this.1, this.2]
    · rintro ⟨v, hv, rfl⟩ i
      have := hv i (Set.mem_univ i)
      rw [abs_le]
      constructor <;> simp <;> linarith [this.1, this.2]
  rw [this]
  exact ((isCompact_univ_pi fun _ => isCompact_Icc).image (PiLp.continuous_toLp 2 _)).measure_lt_top

theorem measurableSet_chiBox : MeasurableSet (chiBox n) := by
  have : chiBox n = ⋂ i, {w : Rn n | |w i - 1 / 4| ≤ b0 / 2} := by ext w; simp [chiBox]
  rw [this]
  refine MeasurableSet.iInter fun i => measurableSet_le ?_ measurable_const
  exact (((continuous_apply i).comp (PiLp.continuous_ofLp 2 _)).sub continuous_const).abs.measurable

/-- The inner integral `∫ χ(w) 1_{Q_r}(w - δ_{2^v} ζ) dw` vanishes outside a compact range of
`v` when `ζ ≠ 0`, and is bounded by `|chiBox|`. -/
theorem innerTheta_bounds (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0)
    {ζ : Rn n} (hζ : ζ ≠ 0) :
    ∃ v1 v2 : ℝ, ∀ v : ℝ, ∀ w : Rn n,
      chiE w * (boxQ r).indicator (fun _ => (1 : ℝ≥0∞)) (w - dil α ((2 : ℝ) ^ v) ζ) ≠ 0 →
        v ∈ Set.Icc v1 v2 := by
  obtain ⟨j, hj⟩ := exists_eq_one_of_ne_zero hr
  obtain ⟨i, hi⟩ : ∃ i, ζ i ≠ 0 := by
    by_contra h
    push Not at h
    exact hζ (by ext i; simp [h i])
  by_cases hζj : ζ j = 0
  · refine ⟨0, 0, fun v w hne => ?_⟩
    exfalso
    have hχ : chiE w ≠ 0 := left_ne_zero_of_mul hne
    have hQ : w - dil α ((2 : ℝ) ^ v) ζ ∈ boxQ r := by
      by_contra hQ
      rw [Set.indicator_of_notMem hQ, mul_zero] at hne
      exact hne rfl
    have := (support_bounds α hχ hQ).1 j hj
    rw [hζj, mul_zero, abs_zero] at this
    norm_num at this
  · -- lower bound from `j`, upper bound from `i`
    have hαj : (0 : ℝ) < α j := by have := hα j; positivity
    have hαi : (0 : ℝ) < α i := by have := hα i; positivity
    set v1 := Real.logb 2 ((1 / (5 * |ζ j|)) ^ ((α j : ℝ)⁻¹))
    set v2 := Real.logb 2 ((2 / |ζ i|) ^ ((α i : ℝ)⁻¹))
    refine ⟨v1, v2, fun v w hne => ?_⟩
    have hχ : chiE w ≠ 0 := left_ne_zero_of_mul hne
    have hQ : w - dil α ((2 : ℝ) ^ v) ζ ∈ boxQ r := by
      by_contra hQ
      rw [Set.indicator_of_notMem hQ, mul_zero] at hne
      exact hne rfl
    obtain ⟨hlo, hhi⟩ := support_bounds α hχ hQ
    have hlo' := hlo j hj
    have hhi' := hhi i
    have h2v : (0 : ℝ) < 2 ^ v := by positivity
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < (2 ^ v) ^ α j)] at hlo'
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < (2 ^ v) ^ α i)] at hhi'
    have hzj : 0 < |ζ j| := abs_pos.mpr hζj
    have hzi : 0 < |ζ i| := abs_pos.mpr hi
    constructor
    · -- `(2^v)^{α_j} ≥ 1/(5|ζ_j|)`
      have h1 : 1 / (5 * |ζ j|) ≤ (2 ^ v) ^ α j := by
        rw [div_le_iff₀ (by positivity)]; nlinarith
      have h2 : (1 / (5 * |ζ j|)) ^ ((α j : ℝ)⁻¹) ≤ 2 ^ v := by
        calc (1 / (5 * |ζ j|)) ^ ((α j : ℝ)⁻¹) ≤ ((2 ^ v) ^ α j) ^ ((α j : ℝ)⁻¹) :=
              Real.rpow_le_rpow (by positivity) h1 (by positivity)
          _ = 2 ^ v := by
              rw [← Real.rpow_natCast, ← Real.rpow_mul h2v.le, mul_inv_cancel₀ hαj.ne',
                Real.rpow_one]
      have := Real.logb_le_logb_of_le (b := 2) (by norm_num) (by positivity) h2
      rwa [Real.logb_rpow (by norm_num) (by norm_num)] at this
    · have h1 : (2 ^ v) ^ α i ≤ 2 / |ζ i| := by
        rw [le_div_iff₀ hzi]; exact hhi'
      have h2 : 2 ^ v ≤ (2 / |ζ i|) ^ ((α i : ℝ)⁻¹) := by
        calc (2 : ℝ) ^ v = ((2 ^ v) ^ α i) ^ ((α i : ℝ)⁻¹) := by
              rw [← Real.rpow_natCast, ← Real.rpow_mul h2v.le, mul_inv_cancel₀ hαi.ne',
                Real.rpow_one]
          _ ≤ _ := Real.rpow_le_rpow (by positivity) h1 (by positivity)
      have := Real.logb_le_logb_of_le (b := 2) (by norm_num) h2v h2
      rwa [Real.logb_rpow (by norm_num) (by norm_num)] at this

theorem ThetaE_lt_top (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0)
    {ζ : Rn n} (hζ : ζ ≠ 0) : ThetaE α r ζ < ⊤ := by
  obtain ⟨v1, v2, hv⟩ := innerTheta_bounds α hα hr hζ
  have hle : ∀ v, ∫⁻ w : Rn n, chiE w * (boxQ r).indicator (fun _ => (1 : ℝ≥0∞))
      (w - dil α ((2 : ℝ) ^ v) ζ) ≤ (Set.Icc v1 v2).indicator (fun _ => volume (chiBox n)) v := by
    intro v
    by_cases hvI : v ∈ Set.Icc v1 v2
    · rw [Set.indicator_of_mem hvI]
      calc _ ≤ ∫⁻ w : Rn n, (chiBox n).indicator (fun _ => (1 : ℝ≥0∞)) w := by
            refine lintegral_mono fun w => ?_
            calc _ ≤ chiE w * 1 := by
                  gcongr
                  by_cases h : w - dil α ((2 : ℝ) ^ v) ζ ∈ boxQ r
                  · simp [Set.indicator_of_mem h]
                  · simp [Set.indicator_of_notMem h]
              _ ≤ _ := by rw [mul_one]; exact chiE_le_indicator w
        _ = volume (chiBox n) := by
            rw [lintegral_indicator measurableSet_chiBox, setLIntegral_const, one_mul]
    · rw [Set.indicator_of_notMem hvI]
      refine le_of_eq (lintegral_eq_zero_of_ae_eq_zero ?_)  -- dummy, replaced below
      exact Filter.Eventually.of_forall fun w => by
        by_contra hne
        exact hvI (hv v w hne)
  calc ThetaE α r ζ ≤ ∫⁻ v : ℝ, (Set.Icc v1 v2).indicator (fun _ => volume (chiBox n)) v :=
        lintegral_mono hle
    _ = volume (chiBox n) * volume (Set.Icc v1 v2) := by
        rw [lintegral_indicator measurableSet_Icc, setLIntegral_const]
    _ < ⊤ := ENNReal.mul_lt_top volume_chiBox_lt_top (by simp)

theorem continuous_dil_joint (α : Fin n → ℕ) : Continuous fun p : ℝ × Rn n => dil α p.1 p.2 := by
  have : (fun p : ℝ × Rn n => dil α p.1 p.2) =
      fun p => WithLp.toLp 2 (fun i => p.1 ^ α i * p.2 i) := rfl
  rw [this]
  refine (PiLp.continuous_toLp 2 _).comp (continuous_pi fun i => ?_)
  exact (continuous_fst.pow _).mul ((continuous_apply i).comp
    ((PiLp.continuous_ofLp 2 _).comp continuous_snd))

theorem measurable_Gsum_param (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ : Rn n) :
    Measurable fun q : Rn n × ℝ => Gsum α r ζ q.1 ((2 : ℝ) ^ q.2) := by
  unfold Gsum
  refine Measurable.tsum fun u => ?_
  have hd1 : Measurable fun q : Rn n × ℝ => dil α ((2 : ℝ) ^ q.2) q.1 :=
    (continuous_dil_joint α).measurable.comp
      (((Real.continuous_const_rpow (by norm_num)).measurable.comp measurable_snd).prodMk
          measurable_fst)
  have hd2 : Measurable fun q : Rn n × ℝ => dil α ((2 : ℝ) ^ q.2) (ζ + q.1) :=
    (continuous_dil_joint α).measurable.comp
      (((Real.continuous_const_rpow (by norm_num)).measurable.comp measurable_snd).prodMk
        (measurable_const.add measurable_fst))
  exact ((measurable_const.indicator (measurableSet_boxQ r)).comp (hd1.sub_const _)).mul
    (measurable_chiE.comp (hd2.sub_const _))

theorem measurable_Gsum_v (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ η : Rn n) :
    Measurable fun v : ℝ => Gsum α r ζ η ((2 : ℝ) ^ v) := by
  unfold Gsum
  refine Measurable.tsum fun u => ?_
  have hd1 : Measurable fun v : ℝ => dil α ((2 : ℝ) ^ v) η :=
    (continuous_dil_two_rpow α η).measurable
  have hd2 : Measurable fun v : ℝ => dil α ((2 : ℝ) ^ v) (ζ + η) :=
    (continuous_dil_two_rpow α (ζ + η)).measurable
  exact ((measurable_const.indicator (measurableSet_boxQ r)).comp (hd1.sub_const _)).mul
    (measurable_chiE.comp (hd2.sub_const _))

/-- The `(v, w)`-profile `χ(w) 1_{Q_r}(w - δ_{2^v} ζ)`. -/
def cQfun (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ : Rn n) (v : ℝ) (w : Rn n) : ℝ≥0∞ :=
  chiE w * (boxQ r).indicator (fun _ => (1 : ℝ≥0∞)) (w - dil α ((2 : ℝ) ^ v) ζ)

/-- The rescaled integrand `χ(w) 1_{Q_r}(w - δ_{2^v}ζ) #{…}/(2^v R)^{|α|}` of (3.7). -/
def Ifun (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ : Rn n) (R v : ℝ) (w : Rn n) : ℝ≥0∞ :=
  cQfun α r ζ v w * (latCount α (w - dil α ((2 : ℝ) ^ v) ζ) ((2 : ℝ) ^ v * R) *
    ENNReal.ofReal ((((2 : ℝ) ^ v * R) ^ absA α)⁻¹))

theorem measurable_cQfun (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ : Rn n) :
    Measurable fun q : ℝ × Rn n => cQfun α r ζ q.1 q.2 := measurable_chiQ_param α r ζ

theorem measurable_cQfun_v (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ : Rn n) (v : ℝ) :
    Measurable (cQfun α r ζ v) :=
  measurable_chiE.mul ((measurable_const.indicator (measurableSet_boxQ r)).comp
    (measurable_id.sub_const _))

theorem measurable_Ifun (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ : Rn n) (R : ℝ) :
    Measurable fun q : ℝ × Rn n => Ifun α r ζ R q.1 q.2 := by
  refine (measurable_cQfun α r ζ).mul ((measurable_latCount_param α ζ R).mul ?_)
  exact ENNReal.measurable_ofReal.comp ((((Real.continuous_const_rpow (by norm_num)).measurable.comp
    measurable_fst).mul_const R).pow_const _).inv

theorem measurable_latCount_w (α : Fin n → ℕ) (c : Rn n) (T : ℝ) :
    Measurable fun w : Rn n => latCount α (w - c) T := by
  unfold latCount
  exact Measurable.tsum fun u => (measurable_const.indicator (measurableSet_ballA α T)).comp
    ((measurable_id.sub_const c).add_const _)

theorem measurable_Ifun_v (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ : Rn n) (R v : ℝ) :
    Measurable (Ifun α r ζ R v) := by
  unfold Ifun
  exact (measurable_cQfun_v α r ζ v).mul ((measurable_latCount_w α _ _).mul measurable_const)

theorem ThetaE_eq (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ : Rn n) :
    ThetaE α r ζ = ∫⁻ v : ℝ, ∫⁻ w, cQfun α r ζ v w := rfl

/-- Step A of the limit (paper, Lemma 3.3, texline~244–256): the averages of `Ξ_r` in terms of the
rescaled lattice counts. -/
theorem avg_XiE_eq (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) (r : Fin n → Fin 2) (ζ : Rn n) {R : ℝ}
    (hR : 0 < R) :
    ENNReal.ofReal ((R ^ absA α)⁻¹) * ∫⁻ η in ballA α R, ∫⁻ s in Set.Ioc (0 : ℝ) 1, XiE α r ζ η s =
      ∫⁻ v : ℝ, ∫⁻ w, Ifun α r ζ R v w := by
  have h1 : ∀ η, ∫⁻ s in Set.Ioc (0 : ℝ) 1, XiE α r ζ η s =
      ∫⁻ v : ℝ, Gsum α r ζ η ((2 : ℝ) ^ v) := by
    intro η
    have h := lintegral_Ioc_tsum_sub (fun v => Gsum α r ζ η ((2 : ℝ) ^ v)) (measurable_Gsum_v α
        r ζ η)
    beta_reduce at h
    unfold XiE
    exact h
  simp_rw [h1]
  rw [lintegral_lintegral_swap ((measurable_Gsum_param α r ζ).aemeasurable)]
  have hB : ∀ v : ℝ, ∫⁻ η in ballA α R, Gsum α r ζ η ((2 : ℝ) ^ v) =
      ENNReal.ofReal ((((2 : ℝ) ^ v) ^ absA α)⁻¹) *
        ∫⁻ w, chiE w * (boxQ r).indicator (fun _ => (1 : ℝ≥0∞)) (w - dil α ((2 : ℝ) ^ v) ζ) *
          latCount α (w - dil α ((2 : ℝ) ^ v) ζ) ((2 : ℝ) ^ v * R) :=
    fun v => lintegral_ballA_Gsum α hα r ζ (by positivity) R
  simp_rw [hB]
  rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_congr fun v => ?_
  rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity),
    ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_congr fun w => ?_
  have hc : (R ^ absA α)⁻¹ * (((2 : ℝ) ^ v) ^ absA α)⁻¹ = (((2 : ℝ) ^ v * R) ^ absA α)⁻¹ := by
    rw [mul_pow, mul_inv, mul_comm]
  rw [hc, Ifun, cQfun]
  ring

/-- Domination for the rescaled integrand, for `R` large (depending on `ζ`). -/
theorem Ifun_le (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0) (ζ : Rn n) :
    ∃ R0 : ℝ, 0 < R0 ∧ ∀ R, R0 ≤ R → ∀ v w, Ifun α r ζ R v w ≤ 3 ^ n * cQfun α r ζ v w := by
  obtain ⟨j, hj⟩ := exists_eq_one_of_ne_zero hr
  refine ⟨max ((5 * |ζ j|) ^ ((α j : ℝ)⁻¹)) 1, by positivity, fun R hR v w => ?_⟩
  by_cases hcq : cQfun α r ζ v w = 0
  · simp [Ifun, hcq]
  · have hχ : chiE w ≠ 0 := left_ne_zero_of_mul hcq
    have hQ : w - dil α ((2 : ℝ) ^ v) ζ ∈ boxQ r := by
      by_contra hQ
      apply hcq
      simp [cQfun, Set.indicator_of_notMem hQ]
    have hlo := (support_bounds α hχ hQ).1 j hj
    have h2v : (0 : ℝ) < 2 ^ v := by positivity
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < (2 ^ v) ^ α j)] at hlo
    have hzj : 0 < |ζ j| := by
      by_contra h
      push Not at h
      have : |ζ j| = 0 := le_antisymm h (abs_nonneg _)
      rw [this, mul_zero] at hlo
      norm_num at hlo
    have hαj : (0 : ℝ) < α j := by have := hα j; positivity
    have hT : 1 ≤ (2 : ℝ) ^ v * R := by
      have h1 : 1 ≤ (2 ^ v) ^ α j * (5 * |ζ j|) := by nlinarith
      have h2 : 1 ≤ 2 ^ v * (5 * |ζ j|) ^ ((α j : ℝ)⁻¹) := by
        have := Real.rpow_le_rpow (by norm_num) h1 (by positivity : (0 : ℝ) ≤ (α j : ℝ)⁻¹)
        rwa [Real.one_rpow, Real.mul_rpow (by positivity) (by positivity), ← Real.rpow_natCast,
          ← Real.rpow_mul h2v.le, mul_inv_cancel₀ hαj.ne', Real.rpow_one] at this
      calc (1 : ℝ) ≤ 2 ^ v * (5 * |ζ j|) ^ ((α j : ℝ)⁻¹) := h2
        _ ≤ 2 ^ v * R := by gcongr; exact (le_max_left _ _).trans hR
    calc Ifun α r ζ R v w = cQfun α r ζ v w * (latCount α (w - dil α ((2 : ℝ) ^ v) ζ)
          ((2 : ℝ) ^ v * R) * ENNReal.ofReal ((((2 : ℝ) ^ v * R) ^ absA α)⁻¹)) := rfl
      _ ≤ cQfun α r ζ v w * 3 ^ n := by gcongr; exact latCount_mul_le α hα hT _
      _ = 3 ^ n * cQfun α r ζ v w := mul_comm _ _

theorem cQfun_le_indicator (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ : Rn n) (v : ℝ) (w : Rn n) :
    cQfun α r ζ v w ≤ (chiBox n).indicator (fun _ => (1 : ℝ≥0∞)) w := by
  calc cQfun α r ζ v w ≤ chiE w * 1 := by
        unfold cQfun
        gcongr
        by_cases h : w - dil α ((2 : ℝ) ^ v) ζ ∈ boxQ r
        · simp [Set.indicator_of_mem h]
        · simp [Set.indicator_of_notMem h]
    _ ≤ _ := by rw [mul_one]; exact chiE_le_indicator w

theorem lintegral_cQfun_le (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ : Rn n) (v : ℝ) :
    ∫⁻ w, cQfun α r ζ v w ≤ volume (chiBox n) := by
  calc ∫⁻ w, cQfun α r ζ v w ≤ ∫⁻ w : Rn n, (chiBox n).indicator (fun _ => (1 : ℝ≥0∞)) w :=
        lintegral_mono fun w => cQfun_le_indicator α r ζ v w
    _ = volume (chiBox n) := by
        rw [lintegral_indicator measurableSet_chiBox, setLIntegral_const, one_mul]

theorem tendsto_Ifun (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) (r : Fin n → Fin 2) (ζ : Rn n) (v : ℝ)
    (w : Rn n) :
    Filter.Tendsto (fun R => Ifun α r ζ R v w) Filter.atTop (nhds (2 ^ n * cQfun α r ζ v w)) := by
  rw [mul_comm (2 ^ n)]
  have hT : Filter.Tendsto (fun R : ℝ => (2 : ℝ) ^ v * R) Filter.atTop Filter.atTop :=
    Filter.tendsto_id.const_mul_atTop (by positivity)
  have hfin : cQfun α r ζ v w ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.one_ne_top ((cQfun_le_indicator α r ζ v w).trans
      (Set.indicator_le_self' (fun _ _ => zero_le_one) w))
  exact ENNReal.Tendsto.const_mul ((tendsto_latCount α hα _).comp hT) (Or.inr hfin)

/-- The pointwise limit of the averages of `Ξ_r` (paper, Lemma 3.3, texline~257–262): for
`ζ ≠ 0`, `R^{-|α|} ∫_{𝓑_R} ∫_0^1 Ξ_r(ζ, η, s) ds dη → 2ⁿ Θ(ζ)`. -/
theorem tendsto_avg_XiE (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0)
    {ζ : Rn n} (hζ : ζ ≠ 0) :
    Filter.Tendsto (fun R : ℝ => ENNReal.ofReal ((R ^ absA α)⁻¹) *
      ∫⁻ η in ballA α R, ∫⁻ s in Set.Ioc (0 : ℝ) 1, XiE α r ζ η s) Filter.atTop
      (nhds (2 ^ n * ThetaE α r ζ)) := by
  obtain ⟨R0, hR0, hbound⟩ := Ifun_le α hα hr ζ
  have hlim : Filter.Tendsto (fun R => ∫⁻ v : ℝ, ∫⁻ w, Ifun α r ζ R v w) Filter.atTop
      (nhds (∫⁻ v : ℝ, 2 ^ n * ∫⁻ w, cQfun α r ζ v w)) := by
    refine tendsto_lintegral_filter_of_dominated_convergence
      (fun v => 3 ^ n * ∫⁻ w, cQfun α r ζ v w)
      (Filter.Eventually.of_forall fun R => (measurable_Ifun α r ζ R).lintegral_prod_right') ?_
          ?_ ?_
    · filter_upwards [Filter.eventually_ge_atTop R0] with R hR
      refine Filter.Eventually.of_forall fun v => ?_
      rw [← lintegral_const_mul _ (measurable_cQfun_v α r ζ v)]
      exact lintegral_mono fun w => hbound R hR v w
    · rw [lintegral_const_mul _ (measurable_cQfun α r ζ).lintegral_prod_right', ← ThetaE_eq]
      exact ENNReal.mul_ne_top (by simp) (ThetaE_lt_top α hα hr hζ).ne
    · refine Filter.Eventually.of_forall fun v => ?_
      rw [← lintegral_const_mul _ (measurable_cQfun_v α r ζ v)]
      refine tendsto_lintegral_filter_of_dominated_convergence (fun w => 3 ^ n * cQfun α r ζ v w)
        (Filter.Eventually.of_forall fun R => measurable_Ifun_v α r ζ R v) ?_ ?_ ?_
      · filter_upwards [Filter.eventually_ge_atTop R0] with R hR
        exact Filter.Eventually.of_forall fun w => hbound R hR v w
      · rw [lintegral_const_mul _ (measurable_cQfun_v α r ζ v)]
        exact ENNReal.mul_ne_top (by simp)
          (ne_top_of_le_ne_top volume_chiBox_lt_top.ne (lintegral_cQfun_le α r ζ v))
      · exact Filter.Eventually.of_forall fun w => tendsto_Ifun α hα r ζ v w
  rw [lintegral_const_mul _ (measurable_cQfun α r ζ).lintegral_prod_right', ← ThetaE_eq] at hlim
  refine hlim.congr' ?_
  filter_upwards [Filter.eventually_gt_atTop 0] with R hR
  exact (avg_XiE_eq α hα r ζ hR).symm

theorem measurable_XiE (α : Fin n → ℕ) (r : Fin n → Fin 2) :
    Measurable fun p : Rn n × Rn n × ℝ => XiE α r p.1 p.2.1 p.2.2 := by
  unfold XiE Gsum
  refine Measurable.tsum fun k => Measurable.tsum fun u => ?_
  have ht : Measurable fun p : Rn n × Rn n × ℝ => (2 : ℝ) ^ ((k : ℝ) - p.2.2) :=
    (Real.continuous_const_rpow (by norm_num)).measurable.comp
      (measurable_const.sub (measurable_snd.comp measurable_snd))
  have hd1 : Measurable fun p : Rn n × Rn n × ℝ => dil α ((2 : ℝ) ^ ((k : ℝ) - p.2.2)) p.2.1 :=
    (continuous_dil_joint α).measurable.comp (ht.prodMk (measurable_fst.comp measurable_snd))
  have hd2 : Measurable fun p : Rn n × Rn n × ℝ =>
      dil α ((2 : ℝ) ^ ((k : ℝ) - p.2.2)) (p.1 + p.2.1) :=
    (continuous_dil_joint α).measurable.comp
      (ht.prodMk (measurable_fst.add (measurable_fst.comp measurable_snd)))
  exact ((measurable_const.indicator (measurableSet_boxQ r)).comp (hd1.sub_const _)).mul
    (measurable_chiE.comp (hd2.sub_const _))

theorem ballA_eq_image (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {R : ℝ} (hR : 0 ≤ R) :
    ballA α R = (WithLp.toLp 2 : (Fin n → ℝ) → Rn n) ''
      Set.pi Set.univ fun i => Set.Icc (-(R ^ α i)) (R ^ α i) := by
  ext x
  have h0 := mem_ballA_add_iff α hα hR x 0
  simp only [latticePt, Pi.zero_apply, Int.cast_zero] at h0
  have hlat : (WithLp.toLp 2 (fun _ : Fin n => (0 : ℝ)) : Rn n) = 0 := rfl
  rw [hlat, add_zero] at h0
  constructor
  · intro hx
    refine ⟨WithLp.ofLp x, fun i _ => ?_, by simp⟩
    have := (h0.mp hx) i
    rw [Finset.mem_Icc, Int.ceil_le, Int.le_floor] at this
    push_cast at this
    constructor <;> linarith [this.1, this.2]
  · rintro ⟨v, hv, rfl⟩
    refine h0.mpr fun i => ?_
    have := hv i (Set.mem_univ i)
    rw [Finset.mem_Icc, Int.ceil_le, Int.le_floor]
    push_cast
    constructor <;> linarith [this.1, this.2]

/-- `|𝓑_R| = 2ⁿ R^{|α|}`. -/
theorem volume_ballA (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {R : ℝ} (hR : 0 ≤ R) :
    volume (ballA α R) = ENNReal.ofReal (2 ^ n * R ^ absA α) := by
  rw [ballA_eq_image α hα hR, ← (PiLp.volume_preserving_toLp (Fin n)).map_eq,
    Measure.map_apply_of_aemeasurable (PiLp.volume_preserving_toLp (Fin n)).measurable.aemeasurable]
  · rw [show (WithLp.toLp 2 : (Fin n → ℝ) → Rn n) ⁻¹' ((WithLp.toLp 2 : (Fin n → ℝ) → Rn n) ''
        Set.pi Set.univ fun i => Set.Icc (-(R ^ α i)) (R ^ α i)) =
        Set.pi Set.univ fun i => Set.Icc (-(R ^ α i)) (R ^ α i) from
      Set.preimage_image_eq _ (fun a b h => by simpa using h)]
    rw [show (Set.pi Set.univ fun i => Set.Icc (-(R ^ α i)) (R ^ α i)) =
      Set.Icc (fun i => -(R ^ α i)) (fun i => R ^ α i) from Set.pi_univ_Icc _ _, Real.volume_Icc_pi]
    rw [← ENNReal.ofReal_prod_of_nonneg (fun i _ => by have := pow_nonneg hR (α i); linarith)]
    congr 1
    have : ∀ i, R ^ α i - -R ^ α i = 2 * R ^ α i := fun i => by ring
    simp only [this, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
      absA, Finset.prod_pow_eq_pow_sum]
  · have := ballA_eq_image α hα hR
    rw [← this]
    exact measurableSet_ballA α R

/-- The frequency-side integrand `f̂(ζ) m(ζ) e^{i x ζ}`. -/
def Fint (m : Rn n → ℂ) (f : Rn n → ℂ) (x ζ : Rn n) : ℂ :=
  fhat f ζ * m ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ))

theorem integrable_Fint {α : Fin n → ℕ} {ν : ℕ} {m : Rn n → ℂ} (hm : ClassM α ν m)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) : Integrable (Fint m (f : Rn n → ℂ) x) := by
  obtain ⟨Cm, -, hmb⟩ := hm.bounded'
  refine ((integrable_fhat_schwartz f).norm.const_mul Cm).mono' ?_
    (Filter.Eventually.of_forall fun ζ => ?_)
  · exact (((continuous_fhat_schwartz f).aestronglyMeasurable.mul
      hm.measurable.aestronglyMeasurable).mul
      (by fun_prop : Continuous fun ζ : Rn n =>
        Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ))).aestronglyMeasurable)
  · rw [Fint, norm_mul, norm_mul, norm_cexp_I_mul, mul_one, mul_comm]
    exact mul_le_mul_of_nonneg_right (hmb ζ) (norm_nonneg _)

/-- The averaged `Ξ`-integral `J_R(ζ) = ∫_{𝓑_R} ∫_0^1 Ξ_r(ζ, η, s) ds dη`. -/
def JR (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ : Rn n) (R : ℝ) : ℝ≥0∞ :=
  ∫⁻ η in ballA α R, ∫⁻ s in Set.Ioc (0 : ℝ) 1, XiE α r ζ η s

theorem JR_le (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0) (ζ : Rn n)
    {R : ℝ} (hR : 0 ≤ R) : JR α r ζ R ≤ 4 * ENNReal.ofReal (2 ^ n * R ^ absA α) := by
  unfold JR
  calc ∫⁻ η in ballA α R, ∫⁻ s in Set.Ioc (0 : ℝ) 1, XiE α r ζ η s
      ≤ ∫⁻ η in ballA α R, ∫⁻ s in Set.Ioc (0 : ℝ) 1, (4 : ℝ≥0∞) :=
        lintegral_mono fun η => lintegral_mono fun s => XiE_le_four α hα hr ζ η s
    _ = 4 * ENNReal.ofReal (2 ^ n * R ^ absA α) := by
        simp [volume_ballA α hα hR, mul_comm]

/-- The averaged multiplier `K_R(ζ) = 2ⁿ R^{-|α|} J_R(ζ)`. -/
def KR (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ : Rn n) (R : ℝ) : ℝ :=
  2 ^ n * (ENNReal.ofReal ((R ^ absA α)⁻¹) * JR α r ζ R).toReal

theorem KR_le (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0) (ζ : Rn n)
    {R : ℝ} (hR : 0 < R) : KR α r ζ R ≤ 4 * 4 ^ n := by
  unfold KR
  have h := JR_le α hα hr ζ hR.le
  have h2 : ENNReal.ofReal ((R ^ absA α)⁻¹) * JR α r ζ R ≤ ENNReal.ofReal (4 * 2 ^ n) := by
    calc _ ≤ ENNReal.ofReal ((R ^ absA α)⁻¹) * (4 * ENNReal.ofReal (2 ^ n * R ^ absA α)) := by
          gcongr
      _ = ENNReal.ofReal (4 * 2 ^ n) := by
          rw [show (4 : ℝ≥0∞) = ENNReal.ofReal 4 by simp, ← ENNReal.ofReal_mul (by norm_num),
            ← ENNReal.ofReal_mul (by positivity)]
          congr 1
          field_simp
  have h3 := ENNReal.toReal_mono ENNReal.ofReal_ne_top h2
  rw [ENNReal.toReal_ofReal (by positivity)] at h3
  calc 2 ^ n * (ENNReal.ofReal ((R ^ absA α)⁻¹) * JR α r ζ R).toReal ≤ 2 ^ n * (4 * 2 ^ n) := by
        gcongr
    _ = 4 * 4 ^ n := by rw [show (4 : ℝ) ^ n = 2 ^ n * 2 ^ n by rw [← mul_pow]; norm_num]; ring

theorem KR_nonneg (α : Fin n → ℕ) (r : Fin n → Fin 2) (ζ : Rn n) (R : ℝ) : 0 ≤ KR α r ζ R := by
  unfold KR; positivity

theorem tendsto_KR (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0)
    {ζ : Rn n} (hζ : ζ ≠ 0) :
    Filter.Tendsto (fun R => KR α r ζ R) Filter.atTop (nhds (thetaR α r ζ)) := by
  have h := tendsto_avg_XiE α hα hr hζ
  have hfin : 2 ^ n * ThetaE α r ζ ≠ ⊤ :=
    ENNReal.mul_ne_top (by simp) (ThetaE_lt_top α hα hr hζ).ne
  have h2 := (ENNReal.tendsto_toReal hfin).comp h
  have h3 := h2.const_mul (2 ^ n : ℝ)
  have hval : (2 : ℝ) ^ n * (2 ^ n * ThetaE α r ζ).toReal = thetaR α r ζ := by
    unfold thetaR
    rw [ENNReal.toReal_mul, ENNReal.toReal_pow, ENNReal.toReal_ofNat,
      show (4 : ℝ) ^ n = 2 ^ n * 2 ^ n by rw [← mul_pow]; norm_num]
    ring
  rw [← hval]
  exact h3.congr fun R => rfl

theorem measurable_XiE_gen (α : Fin n → ℕ) (r : Fin n → Fin 2) {X : Type*} [MeasurableSpace X]
    {a b : X → Rn n} {c : X → ℝ} (ha : Measurable a) (hb : Measurable b) (hc : Measurable c) :
    Measurable fun p => XiE α r (a p) (b p) (c p) := by
  unfold XiE Gsum
  refine Measurable.tsum fun k => Measurable.tsum fun u => ?_
  have ht : Measurable fun p => (2 : ℝ) ^ ((k : ℝ) - c p) :=
    (Real.continuous_const_rpow (by norm_num)).measurable.comp (measurable_const.sub hc)
  have hd1 : Measurable fun p => dil α ((2 : ℝ) ^ ((k : ℝ) - c p)) (b p) :=
    (continuous_dil_joint α).measurable.comp (ht.prodMk hb)
  have hd2 : Measurable fun p => dil α ((2 : ℝ) ^ ((k : ℝ) - c p)) (a p + b p) :=
    (continuous_dil_joint α).measurable.comp (ht.prodMk (ha.add hb))
  exact ((measurable_const.indicator (measurableSet_boxQ r)).comp (hd1.sub_const _)).mul
    (measurable_chiE.comp (hd2.sub_const _))

theorem measurable_lintegral_XiE_gen (α : Fin n → ℕ) (r : Fin n → Fin 2) {X : Type*}
    [MeasurableSpace X] {a b : X → Rn n} (ha : Measurable a) (hb : Measurable b) :
    Measurable fun p => ∫⁻ s in Set.Ioc (0 : ℝ) 1, XiE α r (a p) (b p) s :=
  (measurable_XiE_gen α r (ha.comp measurable_fst) (hb.comp measurable_fst)
    measurable_snd).lintegral_prod_right'

theorem measurable_JR (α : Fin n → ℕ) (r : Fin n → Fin 2) (R : ℝ) :
    Measurable fun ζ : Rn n => JR α r ζ R := by
  unfold JR
  exact (measurable_lintegral_XiE_gen α r measurable_fst measurable_snd).lintegral_prod_right'

theorem measurable_KR (α : Fin n → ℕ) (r : Fin n → Fin 2) (R : ℝ) :
    Measurable fun ζ : Rn n => KR α r ζ R := by
  unfold KR
  exact measurable_const.mul ((measurable_const.mul (measurable_JR α r R)).ennreal_toReal)

theorem lintegral_XiE_le (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0)
    (ζ η : Rn n) : ∫⁻ s in Set.Ioc (0 : ℝ) 1, XiE α r ζ η s ≤ 4 := by
  calc _ ≤ ∫⁻ s in Set.Ioc (0 : ℝ) 1, (4 : ℝ≥0∞) :=
        lintegral_mono fun s => XiE_le_four α hα hr ζ η s
    _ = 4 := by simp

theorem avgIntegrand_eq' (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0)
    {m : Rn n → ℂ} (hm : ClassM α (absA α + 1) m) (f : 𝓢(Rn n, ℂ)) (x η y : Rn n) (s : ℝ) :
    avgIntegrand α r m f x η y s = (((2 * π) ^ n)⁻¹ : ℂ) *
      ∫ ζ, Fint m (f : Rn n → ℂ) x ζ * (((XiE α r ζ η s).toReal : ℝ) : ℂ) := by
  rw [avgIntegrand_eq α hα hr hm f x η y s]
  simp_rw [XiR_eq_toReal α r]
  rfl

/-- Fubini/Tonelli rearrangement of the averages (paper, Lemma 3.3, texline~241–247):
`avgR = (2π)^{-n} ∫ f̂(ζ) m(ζ) e^{i x ζ} K_R(ζ) dζ` with `K_R = 2ⁿ R^{-|α|} J_R`. -/
theorem avgR_eq (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0)
    {m : Rn n → ℂ} (hm : ClassM α (absA α + 1) m) (f : 𝓢(Rn n, ℂ)) (x : Rn n) {R : ℝ}
    (hR : 0 < R) :
    avgR α r m f x R = (((2 * π) ^ n)⁻¹ : ℂ) *
      ∫ ζ, Fint m (f : Rn n → ℂ) x ζ * (KR α r ζ R : ℂ) := by
  have hF : Integrable (Fint m (f : Rn n → ℂ) x) := integrable_Fint hm f x
  have hB : volume (ballA α R) = ENNReal.ofReal (2 ^ n * R ^ absA α) := volume_ballA α hα hR.le
  -- Step (a): the `s`-integral
  have ha : ∀ η y : Rn n, ∫ s in (0 : ℝ)..1, avgIntegrand α r m f x η y s =
      (((2 * π) ^ n)⁻¹ : ℂ) * ∫ ζ, Fint m (f : Rn n → ℂ) x ζ *
        (((∫⁻ s in Set.Ioc (0 : ℝ) 1, XiE α r ζ η s).toReal : ℝ) : ℂ) := by
    intro η y
    rw [intervalIntegral.integral_of_le zero_le_one]
    simp_rw [avgIntegrand_eq' α hα hr hm f x η y]
    rw [integral_const_mul]
    congr 1
    have hK : Integrable (Function.uncurry fun (s : ℝ) (ζ : Rn n) =>
        Fint m (f : Rn n → ℂ) x ζ * (((XiE α r ζ η s).toReal : ℝ) : ℂ))
        ((volume.restrict (Set.Ioc (0 : ℝ) 1)).prod volume) := by
      have hbd : Integrable (fun q : ℝ × Rn n => (4 : ℝ) * ‖Fint m (f : Rn n → ℂ) x q.2‖)
          ((volume.restrict (Set.Ioc (0 : ℝ) 1)).prod volume) :=
        (integrable_const (4 : ℝ)).mul_prod hF.norm
      refine hbd.mono' ?_ (Filter.Eventually.of_forall fun q => ?_)
      · exact hF.aestronglyMeasurable.comp_snd.mul
          (Complex.continuous_ofReal.comp_aestronglyMeasurable
            ((measurable_XiE_gen α r measurable_snd measurable_const
              measurable_fst).ennreal_toReal.aestronglyMeasurable))
      · simp only [Function.uncurry, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg ENNReal.toReal_nonneg]
        have h4 : (XiE α r q.2 η q.1).toReal ≤ 4 := by
          have := ENNReal.toReal_mono (by norm_num) (XiE_le_four α hα hr q.2 η q.1)
          simpa using this
        nlinarith [norm_nonneg (Fint m (f : Rn n → ℂ) x q.2),
          ENNReal.toReal_nonneg (a := XiE α r q.2 η q.1)]
    rw [integral_integral_swap hK]
    refine integral_congr_ae (Filter.Eventually.of_forall fun ζ => ?_)
    simp only
    rw [integral_const_mul, integral_complex_ofReal, integral_toReal (f := fun s => XiE α r ζ η s)
      (measurable_XiE_gen α r measurable_const measurable_const measurable_id).aemeasurable
      (Filter.Eventually.of_forall fun s => (XiE_le_four α hα hr ζ η s).trans_lt (by norm_num))]
  -- Step (b): the `y`-integral of a constant
  have hb : ∀ η : Rn n, ∫ y in ballA α R, ∫ s in (0 : ℝ)..1, avgIntegrand α r m f x η y s =
      ((2 ^ n * R ^ absA α : ℝ) : ℂ) * ((((2 * π) ^ n)⁻¹ : ℂ) * ∫ ζ, Fint m (f : Rn n → ℂ) x ζ *
        (((∫⁻ s in Set.Ioc (0 : ℝ) 1, XiE α r ζ η s).toReal : ℝ) : ℂ)) := by
    intro η
    simp_rw [ha η]
    rw [setIntegral_const, measureReal_def, hB, ENNReal.toReal_ofReal (by positivity),
      Complex.real_smul]
  -- Step (c): the `η`-integral
  have hc : ∫ η in ballA α R, ∫ ζ, Fint m (f : Rn n → ℂ) x ζ *
      (((∫⁻ s in Set.Ioc (0 : ℝ) 1, XiE α r ζ η s).toReal : ℝ) : ℂ) =
      ∫ ζ, Fint m (f : Rn n → ℂ) x ζ * (((JR α r ζ R).toReal : ℝ) : ℂ) := by
    have : IsFiniteMeasure (volume.restrict (ballA α R)) :=
      ⟨by rw [Measure.restrict_apply_univ, hB]; exact ENNReal.ofReal_lt_top⟩
    have hK : Integrable (Function.uncurry fun (η : Rn n) (ζ : Rn n) =>
        Fint m (f : Rn n → ℂ) x ζ * (((∫⁻ s in Set.Ioc (0 : ℝ) 1, XiE α r ζ η s).toReal : ℝ) : ℂ))
        ((volume.restrict (ballA α R)).prod volume) := by
      have hbd : Integrable (fun q : Rn n × Rn n => (4 : ℝ) * ‖Fint m (f : Rn n → ℂ) x q.2‖)
          ((volume.restrict (ballA α R)).prod volume) :=
        (integrable_const (4 : ℝ)).mul_prod hF.norm
      refine hbd.mono' ?_ (Filter.Eventually.of_forall fun q => ?_)
      · exact hF.aestronglyMeasurable.comp_snd.mul
          (Complex.continuous_ofReal.comp_aestronglyMeasurable
            ((measurable_lintegral_XiE_gen α r measurable_snd
              measurable_fst).ennreal_toReal.aestronglyMeasurable))
      · simp only [Function.uncurry, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg ENNReal.toReal_nonneg]
        have h4 : (∫⁻ s in Set.Ioc (0 : ℝ) 1, XiE α r q.2 q.1 s).toReal ≤ 4 := by
          have := ENNReal.toReal_mono (by norm_num) (lintegral_XiE_le α hα hr q.2 q.1)
          simpa using this
        nlinarith [norm_nonneg (Fint m (f : Rn n → ℂ) x q.2),
          ENNReal.toReal_nonneg (a := ∫⁻ s in Set.Ioc (0 : ℝ) 1, XiE α r q.2 q.1 s)]
    rw [integral_integral_swap hK]
    refine integral_congr_ae (Filter.Eventually.of_forall fun ζ => ?_)
    simp only
    rw [integral_const_mul, integral_complex_ofReal, integral_toReal]
    · rfl
    · exact (measurable_lintegral_XiE_gen α r measurable_const measurable_id).aemeasurable
    · exact Filter.Eventually.of_forall fun η =>
        (lintegral_XiE_le α hα hr ζ η).trans_lt (by norm_num)
  unfold avgR
  simp_rw [hb]
  rw [integral_const_mul, integral_const_mul, hc, ← integral_const_mul, ← integral_const_mul,
    ← integral_const_mul, ← integral_const_mul]
  congr 1
  funext ζ
  unfold KR
  rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity)]
  have hRR : R ^ (-(2 * absA α : ℝ)) * R ^ absA α = (R ^ absA α)⁻¹ := by
    rw [← Real.rpow_natCast, ← Real.rpow_add hR, ← Real.rpow_neg hR.le]
    congr 1; ring
  calc _ = (((2 * π) ^ n)⁻¹ : ℂ) * Fint m (f : Rn n → ℂ) x ζ *
        ((((R ^ (-(2 * absA α : ℝ)) * R ^ absA α) * 2 ^ n * (JR α r ζ R).toReal) : ℝ) : ℂ) := by
        push_cast; ring
    _ = _ := by rw [hRR]; push_cast; ring

theorem nontrivial_of_ne_zero {r : Fin n → Fin 2} (hr : r ≠ 0) : Nontrivial (Rn n) := by
  obtain ⟨j, -⟩ := exists_eq_one_of_ne_zero hr
  refine ⟨⟨EuclideanSpace.single j 1, 0, fun h => ?_⟩⟩
  have := congrArg (fun v : Rn n => v j) h
  simp at this

/-- **Lemma 3.3** (the averaging identity, paper, (3.5) and (3.8)): for `r ≠ 0`, `m ∈ 𝓜^{|α|+1}` and
a Schwartz function `f`, the averages of (3.5) converge, and
`𝐀^{r,m} f(x) = (2π)^{-n} ∫ θ_r(ξ) m(ξ) f̂(ξ) e^{i x ξ} dξ`, i.e. `𝐀^{r,m}` is the Fourier
multiplier `θ_r m`, with `θ_r` independent of `m` (see `thetaR`). -/
theorem tendsto_avgR (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0)
    {m : Rn n → ℂ} (hm : ClassM α (absA α + 1) m) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    Filter.Tendsto (avgR α r m f x) Filter.atTop (nhds ((((2 * π) ^ n)⁻¹ : ℂ) *
      ∫ ζ, thetaR α r ζ * m ζ * fhat f ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ)))) := by
  have := nontrivial_of_ne_zero hr
  have hF : Integrable (Fint m (f : Rn n → ℂ) x) := integrable_Fint hm f x
  have hlim : Filter.Tendsto (fun R => ∫ ζ, Fint m (f : Rn n → ℂ) x ζ * (KR α r ζ R : ℂ))
      Filter.atTop (nhds (∫ ζ, Fint m (f : Rn n → ℂ) x ζ * (thetaR α r ζ : ℂ))) := by
    refine tendsto_integral_filter_of_dominated_convergence
      (fun ζ => 4 * 4 ^ n * ‖Fint m (f : Rn n → ℂ) x ζ‖) ?_ ?_ ?_ ?_
    · exact Filter.Eventually.of_forall fun R => hF.aestronglyMeasurable.mul
        (Complex.continuous_ofReal.comp_aestronglyMeasurable (measurable_KR α r
            R).aestronglyMeasurable)
    · filter_upwards [Filter.eventually_gt_atTop 0] with R hR
      refine Filter.Eventually.of_forall fun ζ => ?_
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (KR_nonneg α r ζ R),
          mul_comm]
      exact mul_le_mul_of_nonneg_right (KR_le α hα hr ζ hR) (norm_nonneg _)
    · exact hF.norm.const_mul _
    · have hae : ∀ᵐ ζ : Rn n, ζ ≠ 0 := by
        rw [ae_iff]
        simp
      filter_upwards [hae] with ζ hζ
      exact tendsto_const_nhds.mul (Complex.continuous_ofReal.continuousAt.tendsto.comp
        (tendsto_KR α hα hr hζ))
  have h2 := hlim.const_mul (((2 * π) ^ n)⁻¹ : ℂ)
  have hval : ∫ ζ, Fint m (f : Rn n → ℂ) x ζ * (thetaR α r ζ : ℂ) =
      ∫ ζ, thetaR α r ζ * m ζ * fhat f ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ)) := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun ζ => ?_)
    simp only [Fint]
    ring
  rw [hval] at h2
  refine h2.congr' ?_
  filter_upwards [Filter.eventually_gt_atTop 0] with R hR
  exact (avgR_eq α hα hr hm f x hR).symm

/-- The averaged operator is the Fourier multiplier `θ_r m` (paper, Lemma 3.3). -/
theorem avgOp_eq (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0)
    {m : Rn n → ℂ} (hm : ClassM α (absA α + 1) m) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    avgOp α r m f x = (((2 * π) ^ n)⁻¹ : ℂ) *
      ∫ ζ, thetaR α r ζ * m ζ * fhat f ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ)) :=
  (tendsto_avgR α hα hr hm f x).limUnder_eq

/-! ### Lemma 3.3: properties of `θ_r` -/

/-- `χ(w) = φ̂(w - 1/4)²` as a real function. -/
def chiR (w : Rn n) : ℝ := phiR (w - quarterVec n) ^ 2

theorem chiE_eq_ofReal (w : Rn n) : chiE w = ENNReal.ofReal (chiR w) := rfl

theorem chiR_nonneg (w : Rn n) : 0 ≤ chiR w := sq_nonneg _

theorem continuous_chiR : Continuous (chiR : Rn n → ℝ) :=
  (continuous_phiR.comp (continuous_id.sub continuous_const)).pow 2

theorem chiR_le_indicator (w : Rn n) : chiR w ≤ (chiBox n).indicator (fun _ => (1 : ℝ)) w := by
  have h := chiE_le_indicator w
  by_cases hw : w ∈ chiBox n
  · rw [Set.indicator_of_mem hw] at h ⊢
    rwa [chiE_eq_ofReal, ENNReal.ofReal_le_one] at h
  · rw [Set.indicator_of_notMem hw] at h ⊢
    rw [chiE_eq_ofReal, nonpos_iff_eq_zero, ENNReal.ofReal_eq_zero] at h
    exact h

theorem hasCompactSupport_chiR : HasCompactSupport (chiR : Rn n → ℝ) := by
  have hK : IsCompact (chiBox n) := by
    have : chiBox n = (WithLp.toLp 2 : (Fin n → ℝ) → Rn n) ''
        Set.pi Set.univ fun _ => Set.Icc (1 / 4 - b0 / 2) (1 / 4 + b0 / 2) := by
      ext w
      constructor
      · intro h
        refine ⟨WithLp.ofLp w, fun i _ => ?_, by simp⟩
        have := abs_le.mp (h i)
        constructor <;> linarith [this.1, this.2]
      · rintro ⟨v, hv, rfl⟩ i
        have := hv i (Set.mem_univ i)
        rw [abs_le]
        constructor <;> simp <;> linarith [this.1, this.2]
    rw [this]
    exact (isCompact_univ_pi fun _ => isCompact_Icc).image (PiLp.continuous_toLp 2 _)
  refine HasCompactSupport.intro hK fun w hw => ?_
  have := chiR_le_indicator w
  rw [Set.indicator_of_notMem hw] at this
  exact le_antisymm this (chiR_nonneg w)

theorem contDiff_phiR : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (phiR : Rn n → ℝ) :=
  Complex.reCLM.contDiff.comp contDiff_phiHat

theorem contDiff_chiR : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (chiR : Rn n → ℝ) :=
  (contDiff_phiR.comp (contDiff_id.sub contDiff_const)).pow 2

/-- `g_r(y) = ∫ χ(w) 1_{Q_r}(w - y) dw`, so that `θ_r(ξ) = 4ⁿ ∫_ℝ g_r(δ_{2^v} ξ) dv`. -/
def gQ (r : Fin n → Fin 2) (y : Rn n) : ℝ :=
  ∫ w, chiR w * (boxQ r).indicator (fun _ => (1 : ℝ)) (w - y)

theorem integrable_chiR_mul_indicator (r : Fin n → Fin 2) (y : Rn n) :
    Integrable fun w : Rn n => chiR w * (boxQ r).indicator (fun _ => (1 : ℝ)) (w - y) := by
  have hc : Integrable (chiR : Rn n → ℝ) :=
    continuous_chiR.integrable_of_hasCompactSupport hasCompactSupport_chiR
  refine hc.mono' ?_ (Filter.Eventually.of_forall fun w => ?_)
  · exact hc.aestronglyMeasurable.mul (((measurable_const.indicator (measurableSet_boxQ r)).comp
      (measurable_id.sub_const y)).aestronglyMeasurable)
  · rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (chiR_nonneg w)]
    calc chiR w * |(boxQ r).indicator (fun _ => (1 : ℝ)) (w - y)| ≤ chiR w * 1 := by
          gcongr
          · exact chiR_nonneg w
          · by_cases h : w - y ∈ boxQ r
            · simp [Set.indicator_of_mem h]
            · simp [Set.indicator_of_notMem h]
      _ = chiR w := mul_one _

theorem gQ_nonneg (r : Fin n → Fin 2) (y : Rn n) : 0 ≤ gQ r y :=
  integral_nonneg fun w => mul_nonneg (chiR_nonneg w)
    (Set.indicator_nonneg (fun _ _ => zero_le_one) _)

theorem lintegral_chiE_eq (r : Fin n → Fin 2) (y : Rn n) :
    ∫⁻ w, chiE w * (boxQ r).indicator (fun _ => (1 : ℝ≥0∞)) (w - y) = ENNReal.ofReal (gQ r y) := by
  rw [gQ, ofReal_integral_eq_lintegral_ofReal (integrable_chiR_mul_indicator r y)
    (Filter.Eventually.of_forall fun w => mul_nonneg (chiR_nonneg w)
      (Set.indicator_nonneg (fun _ _ => zero_le_one) _))]
  refine lintegral_congr fun w => ?_
  rw [chiE_eq_ofReal, ENNReal.ofReal_mul (chiR_nonneg w)]
  congr 1
  by_cases h : w - y ∈ boxQ r
  · simp [Set.indicator_of_mem h]
  · simp [Set.indicator_of_notMem h]

theorem ThetaE_eq_gQ (α : Fin n → ℕ) (r : Fin n → Fin 2) (ξ : Rn n) :
    ThetaE α r ξ = ∫⁻ v : ℝ, ENNReal.ofReal (gQ r (dil α ((2 : ℝ) ^ v) ξ)) := by
  unfold ThetaE
  simp_rw [lintegral_chiE_eq]

theorem isCompact_boxQ (r : Fin n → Fin 2) : IsCompact (boxQ r : Set (Rn n)) := by
  have : (boxQ r : Set (Rn n)) = (WithLp.toLp 2 : (Fin n → ℝ) → Rn n) ''
      Set.pi Set.univ fun i => Set.Icc (((r i : ℕ) : ℝ) / 2) ((((r i : ℕ) : ℝ) + 1) / 2) := by
    ext w
    constructor
    · intro h
      exact ⟨WithLp.ofLp w, fun i _ => h i, by simp⟩
    · rintro ⟨v, hv, rfl⟩ i
      exact hv i (Set.mem_univ i)
  rw [this]
  exact (isCompact_univ_pi fun _ => isCompact_Icc).image (PiLp.continuous_toLp 2 _)

theorem continuous_gQ (r : Fin n → Fin 2) : Continuous (gQ r : Rn n → ℝ) := by
  -- `g_r = χ ⋆ 1_{-Q_r}` is a convolution of a compactly supported continuous function
  -- with a locally integrable one
  have hconv : gQ r = fun y => convolution chiR
      (fun z : Rn n => (boxQ r).indicator (fun _ => (1 : ℝ)) (-z))
      (ContinuousLinearMap.lsmul ℝ ℝ) volume y := by
    funext y
    simp only [gQ, convolution, ContinuousLinearMap.lsmul_apply, smul_eq_mul, neg_sub]
  rw [hconv]
  refine hasCompactSupport_chiR.continuous_convolution_left _ continuous_chiR ?_
  have hset : MeasurableSet (Neg.neg ⁻¹' (boxQ r : Set (Rn n))) :=
    measurable_neg (measurableSet_boxQ r)
  have heq : (fun z : Rn n => (boxQ r).indicator (fun _ => (1 : ℝ)) (-z)) =
      (Neg.neg ⁻¹' (boxQ r : Set (Rn n))).indicator (fun _ => 1) := by
    funext z
    by_cases h : -z ∈ boxQ r
    · rw [Set.indicator_of_mem h, Set.indicator_of_mem (by exact h)]
    · rw [Set.indicator_of_notMem h, Set.indicator_of_notMem (by exact h)]
  rw [heq]
  have hfin : volume (Neg.neg ⁻¹' (boxQ r : Set (Rn n))) < ⊤ := by
    rw [Measure.measure_preimage_neg]
    exact (isCompact_boxQ r).measure_lt_top
  exact ((integrableOn_const hfin.ne enorm_ne_top).integrable_indicator hset).locallyIntegrable

/-- Homogeneity of `θ_r` (paper, Lemma 3.3, texline~263): `θ_r(δ_t ξ) = θ_r(ξ)` for `t > 0`. -/
theorem thetaR_dil (α : Fin n → ℕ) (r : Fin n → Fin 2) (ξ : Rn n) {t : ℝ} (ht : 0 < t) :
    thetaR α r (dil α t ξ) = thetaR α r ξ := by
  unfold thetaR
  congr 2
  unfold ThetaE
  have h : ∀ v : ℝ, dil α ((2 : ℝ) ^ v) (dil α t ξ) = dil α ((2 : ℝ) ^ (v + Real.logb 2 t)) ξ := by
    intro v
    rw [dil_dil, Real.rpow_add (by norm_num), Real.rpow_logb (by norm_num) (by norm_num) ht]
  simp_rw [h]
  exact lintegral_add_right_eq_self (fun v : ℝ => ∫⁻ w : Rn n, chiE w *
    (boxQ r).indicator (fun _ => (1 : ℝ≥0∞)) (w - dil α ((2 : ℝ) ^ v) ξ)) (Real.logb 2 t)

theorem gQ_eq_convolution (r : Fin n → Fin 2) : gQ r = fun y => convolution chiR
    (fun z : Rn n => (boxQ r).indicator (fun _ => (1 : ℝ)) (-z))
    (ContinuousLinearMap.lsmul ℝ ℝ) volume y := by
  funext y
  simp only [gQ, convolution, ContinuousLinearMap.lsmul_apply, smul_eq_mul, neg_sub]

theorem locallyIntegrable_indicator_neg (r : Fin n → Fin 2) :
    LocallyIntegrable (fun z : Rn n => (boxQ r).indicator (fun _ => (1 : ℝ)) (-z)) := by
  have hset : MeasurableSet (Neg.neg ⁻¹' (boxQ r : Set (Rn n))) :=
    measurable_neg (measurableSet_boxQ r)
  have heq : (fun z : Rn n => (boxQ r).indicator (fun _ => (1 : ℝ)) (-z)) =
      (Neg.neg ⁻¹' (boxQ r : Set (Rn n))).indicator (fun _ => 1) := by
    funext z
    by_cases h : -z ∈ boxQ r
    · rw [Set.indicator_of_mem h, Set.indicator_of_mem (by exact h)]
    · rw [Set.indicator_of_notMem h, Set.indicator_of_notMem (by exact h)]
  rw [heq]
  have hfin : volume (Neg.neg ⁻¹' (boxQ r : Set (Rn n))) < ⊤ := by
    rw [Measure.measure_preimage_neg]
    exact (isCompact_boxQ r).measure_lt_top
  exact ((integrableOn_const hfin.ne enorm_ne_top).integrable_indicator hset).locallyIntegrable

theorem contDiff_gQ (r : Fin n → Fin 2) : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (gQ r : Rn n → ℝ) := by
  rw [gQ_eq_convolution]
  exact hasCompactSupport_chiR.contDiff_convolution_left _ contDiff_chiR
    (locallyIntegrable_indicator_neg r)

/-- Support of `g_r`: if `g_r(y) ≠ 0` then `|yᵢ| ≤ 2` for all `i`, and `y_j ≤ -1/5` whenever
`r_j = 1`. -/
theorem gQ_support (r : Fin n → Fin 2) {y : Rn n} (hy : gQ r y ≠ 0) :
    (∀ i, |y i| ≤ 2) ∧ (∀ j, r j = 1 → y j ≤ -1 / 5) := by
  obtain ⟨w, hw⟩ : ∃ w, chiR w * (boxQ r).indicator (fun _ => (1 : ℝ)) (w - y) ≠ 0 := by
    by_contra h
    push Not at h
    apply hy
    simp [gQ, h]
  have hχ : chiR w ≠ 0 := left_ne_zero_of_mul hw
  have hQ : w - y ∈ boxQ r := by
    by_contra hQ
    rw [Set.indicator_of_notMem hQ, mul_zero] at hw
    exact hw rfl
  have hwb : w ∈ chiBox n := by
    by_contra hwb
    have := chiR_le_indicator w
    rw [Set.indicator_of_notMem hwb] at this
    exact hχ (le_antisymm this (chiR_nonneg w))
  constructor
  · intro i
    have h1 := hQ i
    have h2 := abs_le.mp (hwb i)
    simp only [PiLp.sub_apply] at h1
    have hri : ((r i : ℕ) : ℝ) ≤ 1 := by exact_mod_cast Nat.lt_succ_iff.mp (r i).2
    have hri0 : (0 : ℝ) ≤ ((r i : ℕ) : ℝ) := Nat.cast_nonneg _
    norm_num [b0] at h2
    rw [abs_le]
    constructor <;> linarith [h1.1, h1.2, h2.1, h2.2]
  · intro j hj
    have h1 := (hQ j).1
    rw [hj] at h1
    simp only [Fin.val_one, Nat.cast_one, PiLp.sub_apply] at h1
    have h2 := abs_le.mp (hwb j)
    norm_num [b0] at h2
    linarith [h2.2]

theorem contDiff_two_rpow : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun v : ℝ => (2 : ℝ) ^ v) := by
  have : (fun v : ℝ => (2 : ℝ) ^ v) = fun v => Real.exp (Real.log 2 * v) := by
    funext v; rw [Real.rpow_def_of_pos (by norm_num)]
  rw [this]
  exact Real.contDiff_exp.comp (contDiff_const.mul contDiff_id)

theorem contDiff_dil_joint (α : Fin n → ℕ) :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun p : Rn n × ℝ => dil α ((2 : ℝ) ^ p.2) p.1) := by
  have : (fun p : Rn n × ℝ => dil α ((2 : ℝ) ^ p.2) p.1) =
      fun p => (PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin n => ℝ)).symm
        (fun i => ((2 : ℝ) ^ p.2) ^ α i * p.1 i) := by
    funext p; rfl
  rw [this]
  refine (PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin n => ℝ)).symm.contDiff.comp ?_
  refine contDiff_pi.mpr fun i => ?_
  exact ((contDiff_two_rpow.comp contDiff_snd).pow _).mul
    ((EuclideanSpace.proj i : Rn n →L[ℝ] ℝ).contDiff.comp contDiff_fst)

theorem thetaR_eq_integral (α : Fin n → ℕ) (r : Fin n → Fin 2) (ξ : Rn n) :
    thetaR α r ξ = 4 ^ n * ∫ v : ℝ, gQ r (dil α ((2 : ℝ) ^ v) ξ) := by
  unfold thetaR
  rw [ThetaE_eq_gQ, integral_eq_lintegral_of_nonneg_ae
    (Filter.Eventually.of_forall fun v => gQ_nonneg r _)]
  exact ((continuous_gQ r).comp ((continuous_dil_param α ξ).comp
    (Real.continuous_const_rpow (by norm_num)))).aestronglyMeasurable

/-- Locally uniform compactness of the scale range: near `ξ₀ ≠ 0`, `g_r(δ_{2^v} ξ) ≠ 0` forces
`v` into a fixed compact interval. -/
theorem local_scale_range (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0)
    {ξ₀ : Rn n} (hξ₀ : ξ₀ ≠ 0) :
    ∃ ε > 0, ∃ a b : ℝ, ∀ ξ ∈ Metric.ball ξ₀ ε, ∀ v : ℝ,
      gQ r (dil α ((2 : ℝ) ^ v) ξ) ≠ 0 → v ∈ Set.Icc a b := by
  obtain ⟨j, hj⟩ := exists_eq_one_of_ne_zero hr
  obtain ⟨i, hi⟩ : ∃ i, ξ₀ i ≠ 0 := by
    by_contra h
    push Not at h
    exact hξ₀ (by ext i; simp [h i])
  have hzi : 0 < |ξ₀ i| := abs_pos.mpr hi
  set ε := |ξ₀ i| / 2
  have hαi : (0 : ℝ) < α i := by have := hα i; positivity
  have hαj : (0 : ℝ) < α j := by have := hα j; positivity
  refine ⟨ε, by positivity, Real.logb 2 ((1 / (5 * (|ξ₀ j| + ε))) ^ ((α j : ℝ)⁻¹)),
    Real.logb 2 ((4 / |ξ₀ i|) ^ ((α i : ℝ)⁻¹)), fun ξ hξ v hv => ?_⟩
  have hsupp := gQ_support r hv
  have hcoord : ∀ k, |ξ k - ξ₀ k| < ε := fun k =>
    lt_of_le_of_lt (by simpa [Real.norm_eq_abs] using PiLp.norm_apply_le (ξ - ξ₀) k)
      (by rwa [Metric.mem_ball, dist_eq_norm] at hξ)
  have h2v : (0 : ℝ) < 2 ^ v := by positivity
  constructor
  · have hy := hsupp.2 j hj
    simp only [dil_apply] at hy
    have hξj : |ξ j| ≤ |ξ₀ j| + ε := by
      have := hcoord j
      calc |ξ j| = |(ξ j - ξ₀ j) + ξ₀ j| := by ring_nf
        _ ≤ |ξ j - ξ₀ j| + |ξ₀ j| := abs_add_le _ _
        _ ≤ _ := by linarith
    have hpos : (0 : ℝ) < (2 ^ v) ^ α j := by positivity
    have h1 : 1 / 5 ≤ (2 ^ v) ^ α j * |ξ j| := by
      have : (2 ^ v) ^ α j * ξ j ≤ -1 / 5 := hy
      have habs : -((2 ^ v) ^ α j * |ξ j|) ≤ (2 ^ v) ^ α j * ξ j := by
        rw [← mul_neg]; exact mul_le_mul_of_nonneg_left (neg_abs_le _) hpos.le
      linarith
    have h2 : 1 / (5 * (|ξ₀ j| + ε)) ≤ (2 ^ v) ^ α j := by
      rw [div_le_iff₀ (by positivity)]
      nlinarith
    have h3 : (1 / (5 * (|ξ₀ j| + ε))) ^ ((α j : ℝ)⁻¹) ≤ 2 ^ v := by
      calc (1 / (5 * (|ξ₀ j| + ε))) ^ ((α j : ℝ)⁻¹) ≤ ((2 ^ v) ^ α j) ^ ((α j : ℝ)⁻¹) :=
            Real.rpow_le_rpow (by positivity) h2 (by positivity)
        _ = 2 ^ v := by
            rw [← Real.rpow_natCast, ← Real.rpow_mul h2v.le, mul_inv_cancel₀ hαj.ne', Real.rpow_one]
    have := Real.logb_le_logb_of_le (b := 2) (by norm_num) (by positivity) h3
    rwa [Real.logb_rpow (by norm_num) (by norm_num)] at this
  · have hy := hsupp.1 i
    simp only [dil_apply] at hy
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < (2 ^ v) ^ α i)] at hy
    have hξi : |ξ₀ i| / 2 ≤ |ξ i| := by
      have hc := hcoord i
      have hεdef : ε = |ξ₀ i| / 2 := rfl
      have htri : |ξ₀ i| ≤ |ξ₀ i - ξ i| + |ξ i| := by
        calc |ξ₀ i| = |(ξ₀ i - ξ i) + ξ i| := by ring_nf
          _ ≤ _ := abs_add_le _ _
      rw [abs_sub_comm] at htri
      linarith
    have h1 : (2 ^ v) ^ α i ≤ 4 / |ξ₀ i| := by
      rw [le_div_iff₀ hzi]
      nlinarith [(by positivity : (0 : ℝ) ≤ (2 ^ v) ^ α i)]
    have h2 : 2 ^ v ≤ (4 / |ξ₀ i|) ^ ((α i : ℝ)⁻¹) := by
      calc (2 : ℝ) ^ v = ((2 ^ v) ^ α i) ^ ((α i : ℝ)⁻¹) := by
            rw [← Real.rpow_natCast, ← Real.rpow_mul h2v.le, mul_inv_cancel₀ hαi.ne', Real.rpow_one]
        _ ≤ _ := Real.rpow_le_rpow (by positivity) h1 (by positivity)
    have := Real.logb_le_logb_of_le (b := 2) (by norm_num) h2v h2
    rwa [Real.logb_rpow (by norm_num) (by norm_num)] at this

/-- Smoothness of `θ_r` away from the origin (paper, Lemma 3.3, texline~216 and ~263). -/
theorem contDiffAt_thetaR (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0)
    {ξ₀ : Rn n} (hξ₀ : ξ₀ ≠ 0) :
    ContDiffAt ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (thetaR α r) ξ₀ := by
  obtain ⟨ε, hε, a, b, hab⟩ := local_scale_range α hα hr hξ₀
  -- a smooth cutoff in `v`, equal to `1` on `[a, b]`
  set ψ : ContDiffBump ((a + b) / 2) :=
    ⟨|b - a| / 2 + 1, |b - a| / 2 + 2, by positivity, by linarith⟩
  set Φ : Rn n × ℝ → ℝ := fun p => ψ p.2 * gQ r (dil α ((2 : ℝ) ^ p.2) p.1)
  have hΦ : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) Φ :=
    (ψ.contDiff.comp contDiff_snd).mul ((contDiff_gQ r).comp (contDiff_dil_joint α))
  have hK : IsCompact (Metric.closedBall ((a + b) / 2) (|b - a| / 2 + 2)) :=
      isCompact_closedBall _ _
  have hsupp : ∀ ξ v, v ∉ Metric.closedBall ((a + b) / 2) (|b - a| / 2 + 2) → Φ (ξ, v) = 0 := by
    intro ξ v hv
    have : ψ v = 0 := by
      rw [← Function.notMem_support, ψ.support_eq]
      exact fun h => hv (Metric.ball_subset_closedBall h)
    simp [Φ, this]
  have hsmooth := contDiff_integral_of_vanish hΦ hK hsupp
  have heq : thetaR α r =ᶠ[nhds ξ₀] fun ξ => 4 ^ n * ∫ v, Φ (ξ, v) := by
    filter_upwards [Metric.ball_mem_nhds ξ₀ hε] with ξ hξ
    rw [thetaR_eq_integral]
    congr 1
    refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
    simp only [Φ]
    by_cases hv : gQ r (dil α ((2 : ℝ) ^ v) ξ) = 0
    · rw [hv, mul_zero]
    · have hvab := hab ξ hξ v hv
      have : ψ v = 1 := by
        apply ψ.one_of_mem_closedBall
        rw [Metric.mem_closedBall, Real.dist_eq, abs_le]
        have hrIn : ψ.rIn = |b - a| / 2 + 1 := rfl
        rw [hrIn]
        rcases abs_cases (b - a) with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> rw [h1] <;>
          constructor <;> linarith [hvab.1, hvab.2]
      rw [this, one_mul]
  exact (contDiff_const.mul hsmooth).contDiffAt.congr_of_eventuallyEq heq

/-- Lower corners of the cubes generating the cones `Θ_r`: `-7/10` in the directions with
`r_i = 1` and `-6/25` in the directions with `r_i = 0`; the cubes have side `12/25`. -/
def coneLo (r : Fin n → Fin 2) : Rn n :=
  WithLp.toLp 2 (fun i => if r i = 1 then -(7 / 10 : ℝ) else -(6 / 25 : ℝ))

/-- The cube `B_r = [coneLo r, coneLo r + 12/25]` generating `Θ_r`. -/
def coneCube (r : Fin n → Fin 2) : Set (Rn n) :=
  rectIcc (coneLo r) (coneLo r + WithLp.toLp 2 (fun _ => (12 / 25 : ℝ)))

/-- The anisotropic cone `Θ_r = {δ_t ξ : t > 0, ξ ∈ B_r}` (paper, Lemma 3.3, texline~266). -/
def coneR (α : Fin n → ℕ) (r : Fin n → Fin 2) : Set (Rn n) :=
  {ζ | ∃ t : ℝ, 0 < t ∧ ∃ ξ ∈ coneCube r, ζ = dil α t ξ}

theorem mem_coneCube_iff (r : Fin n → Fin 2) (ξ : Rn n) :
    ξ ∈ coneCube r ↔ ∀ i, (r i = 1 → -(7 / 10) ≤ ξ i ∧ ξ i ≤ -(11 / 50)) ∧
      (r i = 0 → -(6 / 25) ≤ ξ i ∧ ξ i ≤ 6 / 25) := by
  simp only [coneCube, rectIcc, coneLo, Set.mem_ofPred_eq, PiLp.add_apply, PiLp.toLp_apply]
  refine forall_congr' fun i => ?_
  have h01 : r i = 0 ∨ r i = 1 := by
    rcases Fin.exists_fin_two.mp ⟨r i, rfl⟩ with h | h <;> simp [h]
  rcases h01 with h | h
  · simp only [h, zero_ne_one, ↓reduceIte, false_implies, true_and, forall_const]
    constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> linarith
  · simp only [h, ↓reduceIte, one_ne_zero, false_implies, and_true, forall_const]
    constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> linarith

theorem isCompact_coneCube (r : Fin n → Fin 2) : IsCompact (coneCube r : Set (Rn n)) := by
  have : coneCube r = (WithLp.toLp 2 : (Fin n → ℝ) → Rn n) ''
      Set.pi Set.univ fun i => Set.Icc (coneLo r i) (coneLo r i + 12 / 25) := by
    ext w
    constructor
    · intro h
      exact ⟨WithLp.ofLp w, fun i _ => by simpa using h i, by simp⟩
    · rintro ⟨v, hv, rfl⟩ i
      simpa using hv i (Set.mem_univ i)
  rw [this]
  exact (isCompact_univ_pi fun _ => isCompact_Icc).image (PiLp.continuous_toLp 2 _)

theorem ne_zero_of_mem_coneCube {r : Fin n → Fin 2} (hr : r ≠ 0) {ξ : Rn n}
    (hξ : ξ ∈ coneCube r) : ξ ≠ 0 := by
  obtain ⟨j, hj⟩ := exists_eq_one_of_ne_zero hr
  intro h0
  have := ((mem_coneCube_iff r ξ).mp hξ j).1 hj
  rw [h0] at this
  simp at this
  linarith [this.2]

/-- `g_r > 0` on the cube `B_r`. -/
theorem gQ_pos_of_mem_coneCube (r : Fin n → Fin 2) {ξ : Rn n} (hξ : ξ ∈ coneCube r) :
    0 < gQ r ξ := by
  have hmem := (mem_coneCube_iff r ξ).mp hξ
  set L : Fin n → ℝ := fun i => max (1 / 4 - b1 / 2) (ξ i + ((r i : ℕ) : ℝ) / 2)
  set U : Fin n → ℝ := fun i => min (1 / 4 + b1 / 2) (ξ i + (((r i : ℕ) : ℝ) + 1) / 2)
  have hLU : ∀ i, L i < U i := by
    intro i
    have h01 : r i = 0 ∨ r i = 1 := by
      rcases Fin.exists_fin_two.mp ⟨r i, rfl⟩ with h | h <;> simp [h]
    simp only [L, U, max_lt_iff, lt_min_iff]
    rcases h01 with h | h
    · obtain ⟨h1, h2⟩ := (hmem i).2 h
      simp only [h, Fin.val_zero, Nat.cast_zero]
      refine ⟨⟨?_, ?_⟩, ?_, ?_⟩ <;> norm_num [b1] <;> linarith
    · obtain ⟨h1, h2⟩ := (hmem i).1 h
      simp only [h, Fin.val_one, Nat.cast_one]
      refine ⟨⟨?_, ?_⟩, ?_, ?_⟩ <;> norm_num [b1] <;> linarith
  set S : Set (Rn n) := {w | ∀ i, L i < w i ∧ w i < U i}
  have hSopen : IsOpen S := by
    have : S = ⋂ i, {w : Rn n | L i < w i ∧ w i < U i} := by ext w; simp [S]
    rw [this]
    refine isOpen_iInter_of_finite fun i => ?_
    have hc : Continuous fun w : Rn n => w i := (continuous_apply i).comp (PiLp.continuous_ofLp 2 _)
    exact (isOpen_lt continuous_const hc).inter (isOpen_lt hc continuous_const)
  have hSne : S.Nonempty := ⟨WithLp.toLp 2 (fun i => (L i + U i) / 2), fun i => by
    simp only; constructor <;> linarith [hLU i]⟩
  have hSpos : 0 < volume S := hSopen.measure_pos volume hSne
  have hint := integrable_chiR_mul_indicator r ξ
  have hnn : 0 ≤ fun w : Rn n => chiR w * (boxQ r).indicator (fun _ => (1 : ℝ)) (w - ξ) :=
    fun w => mul_nonneg (chiR_nonneg w) (Set.indicator_nonneg (fun _ _ => zero_le_one) _)
  rw [gQ, integral_pos_iff_support_of_nonneg hnn hint]
  refine lt_of_lt_of_le hSpos (measure_mono fun w hw => ?_)
  rw [Function.mem_support]
  have hQ : w - ξ ∈ boxQ r := by
    intro i
    simp only [PiLp.sub_apply]
    have := hw i
    simp only [L, U, max_lt_iff, lt_min_iff] at this
    constructor <;> linarith [this.1.2, this.2.2]
  have hχ : chiR w = 1 := by
    have h1 : phiHat (w - quarterVec n) = 1 := by
      apply phiHat_eq_one
      intro i
      have := hw i
      simp only [L, U, max_lt_iff, lt_min_iff] at this
      simp only [PiLp.sub_apply, quarterVec]
      rw [abs_le]
      constructor <;> linarith [this.1.1, this.2.1]
    have : phiR (w - quarterVec n) = 1 := by
      rw [phiR, h1, Complex.one_re]
    simp [chiR, this]
  rw [Set.indicator_of_mem hQ, hχ]
  norm_num

/-- `θ_r > 0` on the cube `B_r`. -/
theorem thetaR_pos_of_mem_coneCube (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2}
    (hr : r ≠ 0) {ξ : Rn n} (hξ : ξ ∈ coneCube r) : 0 < thetaR α r ξ := by
  have hξ0 := ne_zero_of_mem_coneCube hr hξ
  rw [thetaR_eq_integral]
  refine mul_pos (by positivity) ?_
  set G : ℝ → ℝ := fun v => gQ r (dil α ((2 : ℝ) ^ v) ξ)
  have hGc : Continuous G := (continuous_gQ r).comp ((continuous_dil_param α ξ).comp
    (Real.continuous_const_rpow (by norm_num)))
  obtain ⟨ε, hε, a, b, hab⟩ := local_scale_range α hα hr hξ0
  have hGsupp : HasCompactSupport G := HasCompactSupport.intro isCompact_Icc fun v hv => by
    by_contra h
    exact hv (hab ξ (Metric.mem_ball_self hε) v h)
  have hGint : Integrable G := hGc.integrable_of_hasCompactSupport hGsupp
  have hnn : 0 ≤ G := fun v => gQ_nonneg r _
  rw [integral_pos_iff_support_of_nonneg hnn hGint]
  have h0 : G 0 ≠ 0 := by
    simp only [G, Real.rpow_zero, dil_one]
    exact (gQ_pos_of_mem_coneCube r hξ).ne'
  have hopen : IsOpen (Function.support G) := hGc.isOpen_support
  exact hopen.measure_pos volume ⟨0, h0⟩

/-- A uniform positive lower bound for `θ_r` on `B_r`, by compactness. -/
theorem exists_thetaR_lower (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2}
    (hr : r ≠ 0) : ∃ ε > 0, ∀ ξ ∈ coneCube r, ε ≤ thetaR α r ξ := by
  have hne : (coneCube r : Set (Rn n)).Nonempty :=
    ⟨coneLo r, fun i => by simp [coneLo]; norm_num⟩
  have hcont : ContinuousOn (thetaR α r) (coneCube r) := fun ξ hξ =>
    (contDiffAt_thetaR α hα hr (ne_zero_of_mem_coneCube hr hξ)).continuousAt.continuousWithinAt
  obtain ⟨ξm, hξm, hmin⟩ := (isCompact_coneCube r).exists_isMinOn hne hcont
  exact ⟨thetaR α r ξm, thetaR_pos_of_mem_coneCube α hα hr hξm, fun ξ hξ => hmin hξ⟩

theorem isAnisoCone_coneR (α : Fin n → ℕ) {r : Fin n → Fin 2} (hr : r ≠ 0) :
    IsAnisoCone α (coneR α r) := by
  refine ⟨fun h => ?_, coneLo r, 12 / 25, by norm_num, rfl⟩
  have h0 : (0 : Rn n) ∈ coneR α r := h ▸ Set.mem_univ _
  obtain ⟨t, ht, ξ, hξ, h0'⟩ := h0
  have : ξ = 0 := by
    have := congrArg (dil α t⁻¹) h0'
    rwa [dil_zero, dil_dil, inv_mul_cancel₀ ht.ne', dil_one, eq_comm] at this
  exact ne_zero_of_mem_coneCube hr hξ this

theorem rho_pos_of_ne_zero (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {ζ : Rn n} (hζ : ζ ≠ 0) :
    0 < rho α ζ := by
  rcases (rho_nonneg α ζ).lt_or_eq with h | h
  · exact h
  · exfalso
    apply hζ
    ext i
    have h1 := abs_coord_rpow_le_rho α ζ i
    rw [← h] at h1
    have hq : 0 < (α i : ℝ)⁻¹ := by have := hα i; positivity
    have h2 : |ζ i| ^ ((α i : ℝ)⁻¹) = 0 := le_antisymm h1 (by positivity)
    rw [Real.rpow_eq_zero (abs_nonneg _) hq.ne'] at h2
    simpa using h2

theorem abs_coord_le_one_of_rho (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {ξ : Rn n}
    (hξ : rho α ξ = 1) (i : Fin n) : |ξ i| ≤ 1 := by
  have h1 := abs_coord_rpow_le_rho α ξ i
  rw [hξ] at h1
  have hq : 0 < (α i : ℝ)⁻¹ := by have := hα i; positivity
  by_contra h
  push Not at h
  have := Real.one_lt_rpow h hq
  linarith

/-- Covering of a dilation-invariant neighbourhood of the closed negative quadrant by the cones
`Θ_r`, `r ≠ 0` (paper, Lemma 3.3, (3.6), interpreted as a dilation-invariant covering). -/
theorem cone_covering (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {ζ : Rn n} (hζ : ζ ≠ 0)
    (hq : ∀ i, ζ i ≤ (1 / 8) * rho α ζ ^ α i) : ∃ r : Fin n → Fin 2, r ≠ 0 ∧ ζ ∈ coneR α r := by
  set ρ0 := rho α ζ
  have hρ0 : 0 < ρ0 := rho_pos_of_ne_zero α hα hζ
  set ξ' := dil α ρ0⁻¹ ζ
  have hξ'ρ : rho α ξ' = 1 := by rw [rho_dil α hα (inv_pos.mpr hρ0)]; exact inv_mul_cancel₀ hρ0.ne'
  have hξ'le : ∀ i, ξ' i ≤ 1 / 8 := by
    intro i
    simp only [ξ', dil_apply]
    have := hq i
    have hp : 0 < ρ0⁻¹ ^ α i := by positivity
    calc ρ0⁻¹ ^ α i * ζ i ≤ ρ0⁻¹ ^ α i * ((1 / 8) * ρ0 ^ α i) := by gcongr
      _ = 1 / 8 := by rw [inv_pow]; field_simp
  have hξ'abs := abs_coord_le_one_of_rho α hα hξ'ρ
  obtain ⟨j, hj⟩ := exists_coord_eq_rho α hα (by rw [hξ'ρ]; norm_num : (0 : ℝ) < rho α ξ')
  rw [hξ'ρ, one_pow] at hj
  have hξ'j : ξ' j = -1 := by
    rcases abs_eq (zero_le_one' ℝ) |>.mp hj with h | h
    · have := hξ'le j; rw [h] at this; norm_num at this
    · exact h
  have hne : (Finset.univ : Finset (Fin n)).Nonempty := ⟨j, Finset.mem_univ j⟩
  set f : ℝ → ℝ := fun l => Finset.univ.inf' hne fun i => l ^ α i * ξ' i
  have hfc : Continuous f :=
    Continuous.finset_inf'_apply hne fun i _ => (continuous_pow _).mul continuous_const
  have hf0 : f 0 = 0 := by
    simp only [f]
    have : ∀ i, (0 : ℝ) ^ α i * ξ' i = 0 := fun i => by
      rw [zero_pow (by have := hα i; omega), zero_mul]
    simp [this]
  have hf1 : f 1 ≤ -1 := by
    have := Finset.inf'_le (fun i => (1 : ℝ) ^ α i * ξ' i) (Finset.mem_univ j)
    simp only [one_pow, one_mul] at this
    simp only [f, one_pow, one_mul]
    rw [← hξ'j]; exact this
  obtain ⟨l, hl, hfl⟩ : ∃ l ∈ Set.Icc (0 : ℝ) 1, f l = -1 / 2 := by
    have := intermediate_value_Icc' (zero_le_one' ℝ) hfc.continuousOn
    exact this ⟨by linarith, by rw [hf0]; norm_num⟩
  have hl0 : 0 < l := by
    rcases hl.1.lt_or_eq with h | h
    · exact h
    · rw [← h, hf0] at hfl; norm_num at hfl
  set η := dil α l ξ'
  have hηge : ∀ i, -1 / 2 ≤ η i := by
    intro i
    rw [← hfl]
    exact Finset.inf'_le (fun i => l ^ α i * ξ' i) (Finset.mem_univ i)
  have hηle : ∀ i, η i ≤ 1 / 8 := by
    intro i
    simp only [η, dil_apply]
    have hp : 0 ≤ l ^ α i := by positivity
    have hp1 : l ^ α i ≤ 1 := pow_le_one₀ hl0.le hl.2
    calc l ^ α i * ξ' i ≤ l ^ α i * (1 / 8) := by gcongr; exact hξ'le i
      _ ≤ 1 * (1 / 8) := by gcongr
      _ = 1 / 8 := one_mul _
  obtain ⟨i1, -, hi1⟩ := Finset.exists_mem_eq_inf' hne fun i => l ^ α i * ξ' i
  have hηi1 : η i1 = -1 / 2 := by
    simp only [η, dil_apply]; rw [← hi1]; exact hfl
  set r : Fin n → Fin 2 := fun i => if η i < -(23 / 100) then 1 else 0
  have hr : r ≠ 0 := by
    intro h
    have := congrFun h i1
    simp only [r, hηi1, Pi.zero_apply] at this
    norm_num at this
  refine ⟨r, hr, ρ0 / l, by positivity, η, ?_, ?_⟩
  · rw [mem_coneCube_iff]
    intro i
    constructor
    · intro hri
      have : η i < -(23 / 100) := by
        by_contra hc
        simp only [r, hc, ↓reduceIte] at hri
        exact zero_ne_one hri
      constructor <;> linarith [hηge i]
    · intro hri
      have : ¬ η i < -(23 / 100) := by
        intro hc
        simp only [r, hc, ↓reduceIte] at hri
        exact one_ne_zero hri
      push Not at this
      constructor <;> linarith [hηle i]
  · simp only [η, ξ', dil_dil]
    rw [show ρ0 / l * (l * ρ0⁻¹) = 1 by field_simp, dil_one]

/-- **Lemma 3.3, cone part** (paper, texline~216–221): there are `ε₀ > 0` and anisotropic cones
`Θ_r` (`r ≠ 0`) with `θ_r > ε₀` on `Θ_r`, covering the dilation-invariant neighbourhood
`{ξ ≠ 0 : ξᵢ ≤ ε₀ ρ(ξ)^{αᵢ}}` of the closed negative quadrant ((3.6), intended reading). -/
theorem lemma_3_3_cones (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) :
    ∃ ε₀ > 0, (∀ r : Fin n → Fin 2, r ≠ 0 → IsAnisoCone α (coneR α r) ∧
        ∀ ζ ∈ coneR α r, ε₀ < thetaR α r ζ) ∧
      ∀ ζ : Rn n, ζ ≠ 0 → (∀ i, ζ i ≤ ε₀ * rho α ζ ^ α i) →
        ∃ r : Fin n → Fin 2, r ≠ 0 ∧ ζ ∈ coneR α r := by
  have hlow : ∀ r : Fin n → Fin 2, ∃ e > 0, r ≠ 0 → ∀ ξ ∈ coneCube r, 2 * e ≤ thetaR α r ξ := by
    intro r
    by_cases hr : r = 0
    · exact ⟨1, one_pos, fun h => absurd hr h⟩
    · obtain ⟨ε, hε, h⟩ := exists_thetaR_lower α hα hr
      exact ⟨ε / 2, by positivity, fun _ ξ hξ => by linarith [h ξ hξ]⟩
  choose e he hle using hlow
  have hne : (Finset.univ : Finset (Fin n → Fin 2)).Nonempty := ⟨0, Finset.mem_univ _⟩
  set e0 := Finset.univ.inf' hne e
  have he0 : 0 < e0 := (Finset.lt_inf'_iff hne).mpr fun r _ => he r
  refine ⟨min (1 / 8) e0, by positivity, fun r hr => ⟨isAnisoCone_coneR α hr, ?_⟩, ?_⟩
  · rintro ζ ⟨t, ht, ξ, hξ, rfl⟩
    rw [thetaR_dil α r ξ ht]
    have h1 := hle r hr ξ hξ
    have h2 : e0 ≤ e r := Finset.inf'_le e (Finset.mem_univ r)
    have h3 : min (1 / 8) e0 ≤ e0 := min_le_right _ _
    linarith [he r]
  · intro ζ hζ hq
    apply cone_covering α hα hζ
    intro i
    refine (hq i).trans ?_
    gcongr
    · exact pow_nonneg (rho_nonneg α ζ) _
    · exact min_le_left _ _

/-! ### Half-open versus closed semi-tiles in the averaged operator -/

/-- The dyadic grid hyperplanes `{ξ : ξᵢ ∈ 2^{-kαᵢ} ℤ / 2}`, off which closed and half-open
semi-tiles agree. -/
def gridBd (α : Fin n → ℕ) : Set (Rn n) :=
  {ξ | ∃ (k : ℤ) (i : Fin n) (z : ℤ), ξ i = side α (-k) i * ((z : ℝ) / 2)}

theorem mem_semi_iff_mem_semiHO (α : Fin n → ℕ) (P : Tile n) (r : Fin n → Fin 2) {N : Rn n}
    (hN : N ∉ gridBd α) : N ∈ P.semi α r ↔ N ∈ P.semiHO α r := by
  refine ⟨fun h i => ⟨(h i).1, lt_of_le_of_ne (h i).2 fun heq => hN ?_⟩,
    fun h => P.semiHO_subset_semi α r h⟩
  refine ⟨P.k, i, 2 * P.u i + (r i : ℤ) + 1, ?_⟩
  rw [heq]
  push_cast
  ring

theorem indicator_semi_eq_semiHO (α : Fin n → ℕ) (P : Tile n) (r : Fin n → Fin 2) {N : Rn n}
    (hN : N ∉ gridBd α) : (P.semi α r).indicator (fun _ => (1 : ℂ)) N =
      (P.semiHO α r).indicator (fun _ => (1 : ℂ)) N := by
  by_cases h : N ∈ P.semi α r
  · rw [Set.indicator_of_mem h, Set.indicator_of_mem ((mem_semi_iff_mem_semiHO α P r hN).mp h)]
  · rw [Set.indicator_of_notMem h, Set.indicator_of_notMem
      (fun h' => h ((mem_semi_iff_mem_semiHO α P r hN).mpr h'))]

theorem modelOp_eq_modelOpHO (α : Fin n → ℕ) (r : Fin n → Fin 2) (m : Rn n → ℂ) {N : Rn n}
    (hN : N ∉ gridBd α) (f : Rn n → ℂ) : modelOp α r m N f = modelOpHO α r m N f := by
  ext x
  unfold modelOp modelOpHO
  congr 1; ext P
  rw [indicator_semi_eq_semiHO α P r hN]

/-- For `η` with nonzero coordinates, `δ_{2^{-s}} η` lies on the grid hyperplanes only for
countably many `s`. -/
theorem countable_bad_scales (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {η : Rn n}
    (hη : ∀ i, η i ≠ 0) : {s : ℝ | dil α ((2 : ℝ) ^ (-s)) η ∈ gridBd α}.Countable := by
  have hsub : {s : ℝ | dil α ((2 : ℝ) ^ (-s)) η ∈ gridBd α} ⊆
      ⋃ (k : ℤ) (i : Fin n) (z : ℤ), {s : ℝ | ((2 : ℝ) ^ (-s)) ^ α i * η i =
        side α (-k) i * ((z : ℝ) / 2)} := by
    rintro s ⟨k, i, z, h⟩
    simp only [Set.mem_iUnion]
    exact ⟨k, i, z, by simpa [dil_apply] using h⟩
  refine Set.Countable.mono hsub (Set.countable_iUnion fun k => Set.countable_iUnion fun i =>
    Set.countable_iUnion fun z => (Set.Subsingleton.countable ?_))
  intro s hs s' hs'
  simp only [Set.mem_ofPred_eq] at hs hs'
  have h1 : ((2 : ℝ) ^ (-s)) ^ α i = ((2 : ℝ) ^ (-s')) ^ α i := by
    have := hs.trans hs'.symm
    exact mul_right_cancel₀ (hη i) this
  rw [← Real.rpow_natCast, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num),
    ← Real.rpow_mul (by norm_num)] at h1
  have hai : (α i : ℝ) ≠ 0 := by have := hα i; positivity
  have h2 := congrArg (Real.logb 2) h1
  rw [Real.logb_rpow (by norm_num) (by norm_num), Real.logb_rpow (by norm_num) (by norm_num)] at h2
  have := mul_right_cancel₀ hai h2
  linarith

theorem volume_coord_eq (i : Fin n) (c : ℝ) : volume {η : Rn n | η i = c} = 0 := by
  have hset : {η : Rn n | η i = c} = (WithLp.ofLp : Rn n → (Fin n → ℝ)) ⁻¹'
      Set.pi Set.univ (Function.update (fun _ => Set.univ) i {c}) := by
    ext η
    simp only [Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_pi, Set.mem_univ, true_implies]
    constructor
    · intro h j
      by_cases hj : j = i
      · subst hj; simp [h]
      · simp [Function.update_of_ne hj]
    · intro h
      simpa using h i
  rw [hset, (PiLp.volume_preserving_ofLp _).measure_preimage
    (MeasurableSet.univ_pi fun j => by
      by_cases hj : j = i
      · subst hj; simp
      · simp [Function.update_of_ne hj]).nullMeasurableSet, volume_pi_pi]
  exact Finset.prod_eq_zero (Finset.mem_univ i) (by simp)

/-- The averaging integrand with half-open semi-tiles. -/
def avgIntegrandHO (α : Fin n → ℕ) (r : Fin n → Fin 2) (m : Rn n → ℂ) (f : Rn n → ℂ)
    (x η y : Rn n) (s : ℝ) : ℂ :=
  modul (-η) (transl (-y) (dilOp α 2 ((2 : ℝ) ^ (-s))
    (modelOpHO α r m (dil α ((2 : ℝ) ^ (-s)) η)
      (dilOp α 2 ((2 : ℝ) ^ s) (transl y (modul η f)))))) x

/-- The averages of (3.5) with half-open semi-tiles. -/
def avgRHO (α : Fin n → ℕ) (r : Fin n → Fin 2) (m : Rn n → ℂ) (f : Rn n → ℂ) (x : Rn n)
    (R : ℝ) : ℂ :=
  ((R ^ (-(2 * absA α : ℝ)) : ℝ) : ℂ) *
    ∫ η in ballA α R, ∫ y in ballA α R, ∫ s in (0 : ℝ)..1, avgIntegrandHO α r m f x η y s

/-- The averages with closed and with half-open semi-tiles coincide: the two model operators
differ only when `δ_{2^{-s}} η` lies on a grid hyperplane, a null set of parameters. -/
theorem avgR_eq_avgRHO (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) (r : Fin n → Fin 2) (m : Rn n → ℂ)
    (f : Rn n → ℂ) (x : Rn n) (R : ℝ) : avgR α r m f x R = avgRHO α r m f x R := by
  unfold avgR avgRHO
  congr 1
  refine integral_congr_ae (ae_restrict_of_ae ?_)
  have hae : ∀ᵐ η : Rn n ∂volume, ∀ i, η i ≠ 0 := by
    rw [ae_all_iff]
    intro i
    rw [ae_iff]
    simpa using volume_coord_eq (n := n) i 0
  filter_upwards [hae] with η hη
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  refine intervalIntegral.integral_congr_ae ?_
  have hnull := (countable_bad_scales α hα hη).measure_zero volume
  have : ∀ᵐ s : ℝ ∂volume, dil α ((2 : ℝ) ^ (-s)) η ∉ gridBd α :=
    measure_eq_zero_iff_ae_notMem.mp hnull
  filter_upwards [this] with s hs _
  unfold avgIntegrand avgIntegrandHO
  rw [modelOp_eq_modelOpHO α r m hs]

/-- **Lemma 3.3** for the model operator with half-open semi-tiles. -/
theorem tendsto_avgRHO (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0)
    {m : Rn n → ℂ} (hm : ClassM α (absA α + 1) m) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    Filter.Tendsto (avgRHO α r m f x) Filter.atTop (nhds ((((2 * π) ^ n)⁻¹ : ℂ) *
      ∫ ζ, thetaR α r ζ * m ζ * fhat f ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ)))) := by
  have h := tendsto_avgR α hα hr hm f x
  have e : avgRHO α r m f x = avgR α r m f x := funext fun R => (avgR_eq_avgRHO α hα r m f x R).symm
  rw [e]
  exact h

/-! ## Proof of Theorem 1.1 (paper, §3, texline~275–282) -/

/-! ### Schwartz functions under modulation, translation and dilation -/

/-- The dilation `δ_t` as a continuous linear equivalence. -/
def dilCLE (α : Fin n → ℕ) {t : ℝ} (ht : 0 < t) : Rn n ≃L[ℝ] Rn n :=
  (LinearEquiv.ofLinearMap (dilLin α t) (dilLin α t⁻¹)
    (LinearMap.ext fun x => by
      simp only [LinearMap.comp_apply, dilLin_apply, dil_dil, mul_inv_cancel₀ ht.ne', dil_one,
        LinearMap.id_apply])
    (LinearMap.ext fun x => by
      simp only [LinearMap.comp_apply, dilLin_apply, dil_dil, inv_mul_cancel₀ ht.ne', dil_one,
        LinearMap.id_apply])).toContinuousLinearEquiv

@[simp]
theorem dilCLE_apply (α : Fin n → ℕ) {t : ℝ} (ht : 0 < t) (x : Rn n) :
    dilCLE α ht x = dil α t x := dilLin_apply α t x

theorem hasTemperateGrowth_char (η : Rn n) :
    Function.HasTemperateGrowth fun x : Rn n => Complex.exp (Complex.I * (⟪x, η⟫_ℝ : ℂ)) := by
  have h1 : Function.HasTemperateGrowth fun x : Rn n => ⟪x, η⟫_ℝ := by
    have e : (fun x : Rn n => ⟪x, η⟫_ℝ) = ⇑(innerSL ℝ η) := by
      funext x; simp [real_inner_comm]
    rw [e]; exact (innerSL ℝ η).hasTemperateGrowth
  have e : (fun x : Rn n => Complex.exp (Complex.I * (⟪x, η⟫_ℝ : ℂ))) =
      (fun t : ℝ => Complex.exp (t * Complex.I)) ∘ fun x : Rn n => ⟪x, η⟫_ℝ := by
    funext x; simp [Function.comp, mul_comm]
  rw [e]
  exact Complex.hasTemperateGrowth_exp_mul_I.comp h1

/-- `M_η f` as a Schwartz function. -/
def schwartzModul (η : Rn n) (f : 𝓢(Rn n, ℂ)) : 𝓢(Rn n, ℂ) :=
  SchwartzMap.smulLeftCLM ℂ (fun x : Rn n => Complex.exp (Complex.I * (⟪x, η⟫_ℝ : ℂ))) f

@[simp]
theorem coe_schwartzModul (η : Rn n) (f : 𝓢(Rn n, ℂ)) :
    (schwartzModul η f : Rn n → ℂ) = modul η f := by
  funext x
  simp [schwartzModul, SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_char η), modul]

/-- `T_y f` as a Schwartz function. -/
def schwartzTransl (y : Rn n) (f : 𝓢(Rn n, ℂ)) : 𝓢(Rn n, ℂ) :=
  SchwartzMap.compSubConstCLM ℂ y f

@[simp]
theorem coe_schwartzTransl (y : Rn n) (f : 𝓢(Rn n, ℂ)) :
    (schwartzTransl y f : Rn n → ℂ) = transl y f := rfl

/-- `D²_t f` as a Schwartz function. -/
def schwartzDil (α : Fin n → ℕ) {t : ℝ} (ht : 0 < t) (f : 𝓢(Rn n, ℂ)) : 𝓢(Rn n, ℂ) :=
  (((t ^ (-(absA α : ℝ) / 2) : ℝ) : ℂ)) •
    SchwartzMap.compCLMOfContinuousLinearEquiv ℂ (dilCLE α (inv_pos.mpr ht)) f

@[simp]
theorem coe_schwartzDil (α : Fin n → ℕ) {t : ℝ} (ht : 0 < t) (f : 𝓢(Rn n, ℂ)) :
    (schwartzDil α ht f : Rn n → ℂ) = dilOp α 2 t f := by
  funext x
  simp [schwartzDil, dilOp]

/-- The function `D²_t T_y M_η f` as a Schwartz function. -/
def schwartzDTM (α : Fin n → ℕ) {t : ℝ} (ht : 0 < t) (y η : Rn n) (f : 𝓢(Rn n, ℂ)) :
    𝓢(Rn n, ℂ) :=
  schwartzDil α ht (schwartzTransl y (schwartzModul η f))

@[simp]
theorem coe_schwartzDTM (α : Fin n → ℕ) {t : ℝ} (ht : 0 < t) (y η : Rn n) (f : 𝓢(Rn n, ℂ)) :
    (schwartzDTM α ht y η f : Rn n → ℂ) = dilOp α 2 t (transl y (modul η f)) := by
  simp [schwartzDTM]

/-! ### The averages and modulations -/

theorem modul_modul (ξ ξ' : Rn n) (f : Rn n → ℂ) : modul ξ (modul ξ' f) = modul (ξ + ξ') f := by
  funext x
  simp only [modul, inner_add_right, Complex.ofReal_add, mul_add, Complex.exp_add]
  ring

theorem norm_modul (ξ : Rn n) (f : Rn n → ℂ) (x : Rn n) : ‖modul ξ f x‖ = ‖f x‖ := by
  simp only [modul, norm_mul, mul_comm Complex.I, Complex.norm_exp_ofReal_mul_I, one_mul]

/-- The norm of the averages is bounded by the average of the norms (no integrability needed). -/
theorem enorm_avgR_le (α : Fin n → ℕ) (r : Fin n → Fin 2) (m : Rn n → ℂ) (f : Rn n → ℂ)
    (x : Rn n) {R : ℝ} (hR : 0 < R) :
    ‖avgR α r m f x R‖ₑ ≤ ENNReal.ofReal (R ^ (-(2 * absA α : ℝ))) *
      ∫⁻ η in ballA α R, ∫⁻ y in ballA α R, ∫⁻ s in Set.Ioc (0 : ℝ) 1,
        ‖avgIntegrand α r m f x η y s‖ₑ := by
  unfold avgR
  rw [enorm_mul, ← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
  gcongr
  refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun η => ?_)
  refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun y => ?_)
  rw [intervalIntegral.integral_of_le zero_le_one]
  exact enorm_integral_le_lintegral_enorm _

/-- Shifting the modulation into the frequency parameter: the integrand for `M_{-N} f` at `η + N`
has the same modulus as the conjugated model operator at frequency `δ_{2^{-s}}(η + N)` applied to
`D²_{2^s} T_y M_η f`. -/
theorem enorm_avgIntegrand_modul (α : Fin n → ℕ) (r : Fin n → Fin 2) (m : Rn n → ℂ)
    (f : Rn n → ℂ) (N x η y : Rn n) (s : ℝ) :
    ‖avgIntegrand α r m (modul (-N) f) x (η + N) y s‖ₑ =
      ‖transl (-y) (dilOp α 2 ((2 : ℝ) ^ (-s)) (modelOp α r m (dil α ((2 : ℝ) ^ (-s)) (η + N))
        (dilOp α 2 ((2 : ℝ) ^ s) (transl y (modul η f))))) x‖ₑ := by
  unfold avgIntegrand
  rw [modul_modul, show η + N + -N = η by abel, ← ofReal_norm, ← ofReal_norm, norm_modul]

theorem finset_sup_ofReal {ι : Type*} {s : Finset ι} (hs : s.Nonempty) (a : ι → ℝ) :
    s.sup (fun i => ENNReal.ofReal (a i)) = ENNReal.ofReal (s.sup' hs a) := by
  apply le_antisymm
  · exact Finset.sup_le fun i hi => ENNReal.ofReal_le_ofReal (Finset.le_sup' a hi)
  · obtain ⟨i, hi, hmax⟩ := Finset.exists_mem_eq_sup' hs a
    rw [hmax]
    exact Finset.le_sup (f := fun i => ENNReal.ofReal (a i)) hi

/-- Change of variables `z = δ_t(x + y)` in a set integral. -/
theorem setLIntegral_comp_dil_add (α : Fin n → ℕ) {t : ℝ} (ht : 0 < t) (y : Rn n)
    {E : Set (Rn n)} (hE : MeasurableSet E) (φ : Rn n → ℝ≥0∞) :
    ∫⁻ x in E, φ (dil α t (x + y)) =
      ENNReal.ofReal ((t ^ absA α)⁻¹) * ∫⁻ z in {z | dil α t⁻¹ z - y ∈ E}, φ z := by
  have hE' : MeasurableSet {z : Rn n | dil α t⁻¹ z - y ∈ E} :=
    hE.preimage ((continuous_dil α t⁻¹).measurable.sub_const y)
  rw [← lintegral_indicator hE, ← lintegral_indicator hE']
  have h1 : ∀ x, E.indicator (fun x => φ (dil α t (x + y))) x =
      (fun w => {z | dil α t⁻¹ z - y ∈ E}.indicator φ (dil α t w)) (x + y) := by
    intro x
    have hmem : dil α t (x + y) ∈ {z | dil α t⁻¹ z - y ∈ E} ↔ x ∈ E := by
      change dil α t⁻¹ (dil α t (x + y)) - y ∈ E ↔ x ∈ E
      rw [dil_dil, inv_mul_cancel₀ ht.ne', dil_one, add_sub_cancel_right]
    change E.indicator (fun x => φ (dil α t (x + y))) x =
      {z | dil α t⁻¹ z - y ∈ E}.indicator φ (dil α t (x + y))
    by_cases hx : x ∈ E
    · rw [Set.indicator_of_mem hx, Set.indicator_of_mem (hmem.mpr hx)]
    · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem (fun h => hx (hmem.mp h))]
  simp_rw [h1]
  rw [lintegral_add_right_eq_self (fun w => {z | dil α t⁻¹ z - y ∈ E}.indicator φ (dil α t w)) y,
    lintegral_comp_dil α ht]

theorem eLpNorm_modul (η : Rn n) {f : Rn n → ℂ} (hf : AEStronglyMeasurable f volume)
    (p : ℝ≥0∞) : eLpNorm (modul η f) p volume = eLpNorm f p volume :=
  eLpNorm_congr_norm_ae (((by fun_prop : Continuous fun x : Rn n =>
    Complex.exp (Complex.I * (⟪x, η⟫_ℝ : ℂ))).aestronglyMeasurable).mul hf) hf
    (Filter.Eventually.of_forall fun x => norm_modul η f x)

theorem eLpNorm_transl (y : Rn n) {f : Rn n → ℂ} (hf : AEStronglyMeasurable f volume)
    (p : ℝ≥0∞) : eLpNorm (transl y f) p volume = eLpNorm f p volume :=
  eLpNorm_comp_measurePreserving (f := fun x : Rn n => x - y) hf
    (measurePreserving_sub_right volume y)

theorem eLpNorm_dilOp_two (α : Fin n → ℕ) {t : ℝ} (ht : 0 < t) {f : Rn n → ℂ}
    (hf : Continuous f) : eLpNorm (dilOp α 2 t f) 2 volume = eLpNorm f 2 volume := by
  have hti : 0 < t⁻¹ := inv_pos.mpr ht
  have e : dilOp α 2 t f = ((((t ^ (-(absA α : ℝ) / 2) : ℝ)) : ℂ)) • (f ∘ dil α t⁻¹) := by
    funext x; simp [dilOp]
  rw [e, eLpNorm_const_smul, ← eLpNorm_map_measure hf.aestronglyMeasurable
    (continuous_dil α t⁻¹).measurable.aemeasurable, map_dil_volume α hti,
    eLpNorm_smul_measure_of_ne_top (by norm_num : (2 : ℝ≥0∞) ≠ ⊤) _ _ hf.aestronglyMeasurable,
    smul_eq_mul, ← mul_assoc]
  convert one_mul _
  rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg (by positivity),
    ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num), ← ENNReal.ofReal_mul (by
        positivity)]
  rw [inv_pow, inv_inv]
  have h12 : ((1 : ℝ≥0∞) / 2).toReal = 1 / 2 := by norm_num
  rw [h12, ← Real.rpow_natCast, ← Real.rpow_mul ht.le, ← Real.rpow_add ht,
    show -(absA α : ℝ) / 2 + (absA α : ℝ) * (1 / 2) = 0 by ring, Real.rpow_zero, ENNReal.ofReal_one]

theorem eLpNorm_schwartzDTM (α : Fin n → ℕ) {t : ℝ} (ht : 0 < t) (y η : Rn n) (f : 𝓢(Rn n, ℂ)) :
    eLpNorm (schwartzDTM α ht y η f : Rn n → ℂ) 2 volume = eLpNorm (f : Rn n → ℂ) 2 volume := by
  have h1 : Continuous (transl y (modul η (f : Rn n → ℂ))) := by
    simpa using (schwartzTransl y (schwartzModul η f)).continuous
  have h2 : Continuous (modul η (f : Rn n → ℂ)) := by
    simpa using (schwartzModul η f).continuous
  rw [coe_schwartzDTM, eLpNorm_dilOp_two α ht h1, eLpNorm_transl y h2.aestronglyMeasurable,
    eLpNorm_modul η f.continuous.aestronglyMeasurable]

theorem sup'_const_mul {ι : Type*} {s : Finset ι} (hs : s.Nonempty) (b : ι → ℝ) {c : ℝ}
    (hc : 0 ≤ c) : s.sup' hs (fun i => c * b i) = c * s.sup' hs b := by
  apply le_antisymm
  · exact Finset.sup'_le hs _ fun i hi => mul_le_mul_of_nonneg_left (Finset.le_sup' b hi) hc
  · obtain ⟨i, hi, hmax⟩ := Finset.exists_mem_eq_sup' hs b
    rw [hmax]
    exact Finset.le_sup' (fun i => c * b i) hi

theorem measurable_finset_sup' {ι : Type*} {s : Finset ι} (hs : s.Nonempty) {b : ι → Rn n → ℝ}
    (hb : ∀ i ∈ s, Measurable (b i)) : Measurable fun z => s.sup' hs fun i => b i z := by
  have e : (fun z => s.sup' hs fun i => b i z) = s.sup' hs b :=
    funext fun z => (Finset.sup'_apply hs b z).symm
  rw [e]
  exact Finset.measurable_sup' hs hb

/-- **The conjugated model operators obey the bound of Theorem 3.2** (used in texline~279–281):
    for a
parameter `(η, y, s)` for which all frequencies `δ_{2^{-s}}(η + N)`, `N ∈ F`, avoid the grid
hyperplanes, `∫_E max_{N∈F} |T_{-y} D²_{2^{-s}} A_{δ_{2^{-s}}(η+N)} D²_{2^s} T_y M_η f| ≤
    C‖m‖|E|^{1/2}‖f‖₂`. -/
theorem conj_modelOp_le (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) (hn : 0 < n) {r : Fin n → Fin 2}
    (hr : r ≠ 0) (ν : ℕ) (hν : 3 * absA α + 2 ≤ ν) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (m : Rn n → ℂ), ClassM α ν m → ∀ (f : 𝓢(Rn n, ℂ)) (F : Finset (Rn n)),
      F.Nonempty → ∀ (E : Set (Rn n)), MeasurableSet E → volume E < ⊤ →
      ∀ (η y : Rn n) (s : ℝ), (∀ N ∈ F, dil α ((2 : ℝ) ^ (-s)) (η + N) ∉ gridBd α) →
      ∫⁻ x in E, F.sup (fun N => ‖transl (-y) (dilOp α 2 ((2 : ℝ) ^ (-s))
        (modelOp α r m (dil α ((2 : ℝ) ^ (-s)) (η + N))
          (dilOp α 2 ((2 : ℝ) ^ s) (transl y (modul η f))))) x‖ₑ) ≤
        ENNReal.ofReal (C * (normM α ν m).toReal * Real.sqrt (volume E).toReal *
          (eLpNorm (f : Rn n → ℂ) 2 volume).toReal) := by
  classical
  obtain ⟨C, hC, h32⟩ := thm_3_2 α hα hn hr ν hν
  refine ⟨C, hC, fun m hm f F hF E hE hEfin η y s hgood => ?_⟩
  have hm' : ClassM α (absA α + 1) m := hm.mono (by omega)
  obtain ⟨C0, hC0, hbd⟩ := modelOpHO_summable_bound α hα hr
  set Nm := (normM α ν m).toReal
  have hNm : 0 ≤ Nm := ENNReal.toReal_nonneg
  have hts : (2 : ℝ) ^ (-s) = ((2 : ℝ) ^ s)⁻¹ := Real.rpow_neg (by norm_num) s
  have ht : 0 < (2 : ℝ) ^ s := by positivity
  rw [hts]
  simp only [hts] at hgood
  generalize (2 : ℝ) ^ s = t at ht hgood ⊢
  set g := schwartzDTM α ht y η f
  have hg : (g : Rn n → ℂ) = dilOp α 2 t (transl y (modul η f)) := coe_schwartzDTM α ht y η f
  set a : Rn n → Rn n := fun N => dil α t⁻¹ (η + N)
  set u : ℝ := t ^ ((absA α : ℝ) / 2)
  have hu : 0 < u := by positivity
  have huu : u * u = t ^ absA α := by
    rw [← Real.rpow_add ht, ← Real.rpow_natCast]; congr 1; ring
  set H : Rn n → ℝ := fun z => F.sup' hF (fun N => ‖modelOpHO α r m (a N) g z‖)
  -- the pointwise identity
  have hpt : ∀ x, F.sup (fun N => ‖transl (-y) (dilOp α 2 t⁻¹
      (modelOp α r m (dil α t⁻¹ (η + N))
        (dilOp α 2 t (transl y (modul η f))))) x‖ₑ) =
      ENNReal.ofReal (u * H (dil α t (x + y))) := by
    intro x
    have hterm : ∀ N ∈ F, ‖transl (-y) (dilOp α 2 t⁻¹
        (modelOp α r m (dil α t⁻¹ (η + N))
          (dilOp α 2 t (transl y (modul η f))))) x‖ₑ =
        ENNReal.ofReal (u * ‖modelOpHO α r m (a N) g (dil α t (x + y))‖) := by
      intro N hN
      have hN' := hgood N hN
      rw [← hg, modelOp_eq_modelOpHO α r m hN']
      simp only [transl, dilOp, sub_neg_eq_add, inv_inv]
      rw [enorm_mul, ← ofReal_norm, ← ofReal_norm, Complex.norm_real,
        Real.norm_of_nonneg (by positivity), ← ENNReal.ofReal_mul (by positivity)]
      congr 2
      rw [Real.inv_rpow ht.le, ← Real.rpow_neg ht.le]
      congr 1; ring
    rw [Finset.sup_congr rfl hterm, finset_sup_ofReal hF, sup'_const_mul hF _ hu.le]
  refine (lintegral_congr fun x => hpt x).trans_le ?_
  -- change of variables
  set E' := {z : Rn n | dil α t⁻¹ z - y ∈ E}
  have hE' : MeasurableSet E' := hE.preimage ((continuous_dil α t⁻¹).measurable.sub_const y)
  rw [setLIntegral_comp_dil_add α ht y hE (fun z => ENNReal.ofReal (u * H z))]
  have hvol : volume E' = ENNReal.ofReal (t ^ absA α) * volume E := by
    have h1 := setLIntegral_comp_dil_add α ht y hE (fun _ => 1)
    simp only [setLIntegral_one] at h1
    rw [h1, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity), mul_inv_cancel₀ (by positivity),
      ENNReal.ofReal_one, one_mul]
  have hE'fin : volume E' < ⊤ := by
    rw [hvol]; exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top hEfin
  -- integrability of `H` on `E'`
  have hmeasH : Measurable H := measurable_finset_sup' hF fun N _ =>
    (measurable_Tlin α hα hr hm' g (measurable_const : Measurable fun _ : Rn n => a N)).norm
  set Cb := C0 * (normM α (absA α + 1) m).toReal * ∫ ξ, ‖fhat (g : Rn n → ℂ) ξ‖
  have hHb : ∀ z, ‖H z‖ ≤ Cb := by
    intro z
    have hH0 : 0 ≤ H z := by
      obtain ⟨N, hN⟩ := hF
      exact (norm_nonneg _).trans (Finset.le_sup' (fun N => ‖modelOpHO α r m (a N) g z‖) hN)
    rw [Real.norm_of_nonneg hH0]
    exact Finset.sup'_le hF _ fun N _ =>
      (hbd m hm' g g.integrable (integrable_fhat_schwartz g) (a N) z).2
  have hHint : IntegrableOn H E' volume := by
    have : IsFiniteMeasure (volume.restrict E') :=
      ⟨by rw [Measure.restrict_apply_univ]; exact hE'fin⟩
    exact (integrable_const Cb).mono' hmeasH.aestronglyMeasurable
      (Filter.Eventually.of_forall hHb)
  have hH0 : ∀ z, 0 ≤ H z := fun z => by
    obtain ⟨N, hN⟩ := hF
    exact (norm_nonneg _).trans (Finset.le_sup' (fun N => ‖modelOpHO α r m (a N) g z‖) hN)
  have hlin : ∫⁻ z in E', ENNReal.ofReal (u * H z) = ENNReal.ofReal (u * ∫ z in E', H z) := by
    rw [← integral_const_mul, ofReal_integral_eq_lintegral_ofReal (hHint.const_mul u)
      (Filter.Eventually.of_forall fun z => mul_nonneg hu.le (hH0 z))]
  rw [hlin]
  -- Theorem 3.2 on `E'`
  have hF' : (F.image a).Nonempty := hF.image a
  have hT := h32 m hm g (F.image a) hF' E' hE' hE'fin
  have hsup : ∀ z, (F.image a).sup' hF' (fun N => ‖modelOpHO α r m N g z‖) = H z := by
    intro z
    rw [Finset.sup'_image]
    rfl
  simp_rw [hsup] at hT
  rw [eLpNorm_schwartzDTM, hvol, ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity)] at hT
  rw [← ENNReal.ofReal_mul (by positivity)]
  refine ENNReal.ofReal_le_ofReal ?_
  have hsq : Real.sqrt (t ^ absA α * (volume E).toReal) = u * Real.sqrt (volume E).toReal := by
    rw [Real.sqrt_mul (by positivity), ← huu, Real.sqrt_mul_self hu.le]
  rw [hsq] at hT
  have hti : (t ^ absA α)⁻¹ * u * u = 1 := by
    rw [mul_assoc, huu, inv_mul_cancel₀ (by positivity)]
  calc (t ^ absA α)⁻¹ * (u * ∫ z in E', H z)
      ≤ (t ^ absA α)⁻¹ * (u * (C * Nm * (u * Real.sqrt (volume E).toReal) *
          (eLpNorm (f : Rn n → ℂ) 2 volume).toReal)) := by gcongr
    _ = ((t ^ absA α)⁻¹ * u * u) * (C * Nm * Real.sqrt (volume E).toReal *
          (eLpNorm (f : Rn n → ℂ) 2 volume).toReal) := by ring
    _ = _ := by rw [hti, one_mul]

/-! ### Joint measurability of the averaging integrand -/

theorem measurable_dil_scale (α : Fin n → ℕ) :
    Measurable fun p : ℝ × Rn n => dil α ((2 : ℝ) ^ (-p.1)) p.2 :=
  ((continuous_dil_joint α).comp (((Real.continuous_const_rpow (by norm_num)).comp
    continuous_fst.neg).prodMk continuous_snd)).measurable

theorem measurable_XiR (α : Fin n → ℕ) (r : Fin n → Fin 2) :
    Measurable fun q : Rn n × Rn n × ℝ => XiR α r q.1 q.2.1 q.2.2 := by
  unfold XiR
  refine Measurable.tsum fun ku => ?_
  have h1 : Measurable fun q : Rn n × Rn n × ℝ => dil α ((2 : ℝ) ^ (-q.2.2)) q.2.1 :=
    (measurable_dil_scale α).comp (measurable_snd.snd.prodMk measurable_snd.fst)
  have h2 : Measurable fun q : Rn n × Rn n × ℝ => dil α ((2 : ℝ) ^ (-q.2.2)) (q.1 + q.2.1) :=
    (measurable_dil_scale α).comp (measurable_snd.snd.prodMk (measurable_fst.add
        measurable_snd.fst))
  exact ((measurable_const.indicator (measurable_semi_indicator α _ r)).comp h1).mul
    (((continuous_PhiP α _).measurable.comp h2).pow_const 2)

/-- The averaging integrand of a Schwartz function is jointly measurable in `(x, η, y, s)`
(via the Fourier formula `Auto.avgIntegrand_eq`). -/
theorem measurable_avgIntegrand (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2}
    (hr : r ≠ 0) {m : Rn n → ℂ} (hm : ClassM α (absA α + 1) m) (f : 𝓢(Rn n, ℂ)) :
    Measurable fun p : Rn n × Rn n × Rn n × ℝ =>
      avgIntegrand α r m f p.1 p.2.1 p.2.2.1 p.2.2.2 := by
  have e : (fun p : Rn n × Rn n × Rn n × ℝ => avgIntegrand α r m f p.1 p.2.1 p.2.2.1 p.2.2.2) =
      fun p => (((2 * π) ^ n)⁻¹ : ℂ) * ∫ ζ, fhat f ζ * m ζ *
        Complex.exp (Complex.I * (⟪p.1, ζ⟫_ℝ : ℂ)) * XiR α r ζ p.2.1 p.2.2.2 :=
    funext fun p => avgIntegrand_eq α hα hr hm f _ _ _ _
  rw [e]
  refine measurable_const.mul ?_
  have hK : Measurable fun q : (Rn n × Rn n × Rn n × ℝ) × Rn n => fhat f q.2 * m q.2 *
      Complex.exp (Complex.I * (⟪q.1.1, q.2⟫_ℝ : ℂ)) * XiR α r q.2 q.1.2.1 q.1.2.2.2 := by
    refine ((((continuous_fhat_schwartz f).measurable.comp measurable_snd).mul
      (hm.measurable.comp measurable_snd)).mul ?_).mul ?_
    · exact (by fun_prop : Continuous fun q : (Rn n × Rn n × Rn n × ℝ) × Rn n =>
        Complex.exp (Complex.I * (⟪q.1.1, q.2⟫_ℝ : ℂ))).measurable
    · have hg : Measurable fun q : (Rn n × Rn n × Rn n × ℝ) × Rn n => (q.2, q.1.2.1, q.1.2.2.2) :=
        measurable_snd.prodMk (measurable_fst.snd.fst.prodMk measurable_fst.snd.snd.snd)
      simpa only [Function.comp_def] using (measurable_XiR α r).comp hg
  exact hK.stronglyMeasurable.integral_prod_right'.measurable

/-- Tonelli for four variables: moving the outermost integral innermost. -/
theorem lintegral_swap4 {X Y Z W : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    [MeasurableSpace Z] [MeasurableSpace W] {μ₁ : Measure X} {μ₂ : Measure Y} {μ₃ : Measure Z}
    {μ₄ : Measure W} [SFinite μ₁] [SFinite μ₂] [SFinite μ₃] [SFinite μ₄]
    (G : X → Y → Z → W → ℝ≥0∞)
    (hG : Measurable fun p : X × Y × Z × W => G p.1 p.2.1 p.2.2.1 p.2.2.2) :
    ∫⁻ x, (∫⁻ η, (∫⁻ y, (∫⁻ s, G x η y s ∂μ₄) ∂μ₃) ∂μ₂) ∂μ₁ =
      ∫⁻ η, (∫⁻ y, (∫⁻ s, (∫⁻ x, G x η y s ∂μ₁) ∂μ₄) ∂μ₃) ∂μ₂ := by
  have m1 : Measurable (Function.uncurry fun x η => ∫⁻ y, (∫⁻ s, G x η y s ∂μ₄) ∂μ₃) := by
    have h3 : Measurable fun q : ((X × Y) × Z) × W => G q.1.1.1 q.1.1.2 q.1.2 q.2 :=
      hG.comp (measurable_fst.fst.fst.prodMk (measurable_fst.fst.snd.prodMk
        (measurable_fst.snd.prodMk measurable_snd)))
    exact h3.lintegral_prod_right'.lintegral_prod_right'
  rw [lintegral_lintegral_swap m1.aemeasurable]
  refine lintegral_congr fun η => ?_
  have m2 : Measurable (Function.uncurry fun x y => ∫⁻ s, G x η y s ∂μ₄) :=
    (hG.comp (measurable_fst.fst.prodMk (measurable_const.prodMk
      (measurable_fst.snd.prodMk measurable_snd)))).lintegral_prod_right'
  rw [lintegral_lintegral_swap m2.aemeasurable]
  refine lintegral_congr fun y => ?_
  have m3 : Measurable (Function.uncurry fun x s => G x η y s) :=
    hG.comp (measurable_fst.prodMk (measurable_const.prodMk (measurable_const.prodMk
      measurable_snd)))
  exact lintegral_lintegral_swap m3.aemeasurable

/-- For a.e. `η`, all shifted frequencies `η + N`, `N ∈ F`, have nonzero coordinates. -/
theorem ae_shift_coord_ne_zero (F : Finset (Rn n)) :
    ∀ᵐ η : Rn n ∂volume, ∀ N ∈ F, ∀ i, (η + N) i ≠ 0 := by
  rw [Filter.eventually_all_finset]
  intro N _
  rw [ae_all_iff]
  intro i
  rw [ae_iff]
  have : {η : Rn n | ¬ (η + N) i ≠ 0} = {η : Rn n | η i = -N i} := by
    ext η
    simp only [ne_eq, not_not, Set.mem_ofPred_eq, PiLp.add_apply]
    constructor <;> intro h <;> linarith
  rw [this]
  exact volume_coord_eq i _

/-- **Averaged form of Theorem 3.2** (texline~279–281): the averages `avgR` of the modulated
functions `M_{-N} f`, maximized over a finite frequency set `F ⊆ 𝓑_c`, satisfy
`∫_E max_N |avgR(M_{-N} f)| ≤ R^{-2|α|} |𝓑_{R+c}| |𝓑_R| C‖m‖|E|^{1/2}‖f‖₂`. -/
theorem lintegral_sup_avgR_le (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) (hn : 0 < n)
    {r : Fin n → Fin 2} (hr : r ≠ 0) (ν : ℕ) (hν : 3 * absA α + 2 ≤ ν) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (m : Rn n → ℂ), ClassM α ν m → ∀ (f : 𝓢(Rn n, ℂ)) (F : Finset (Rn n)),
      F.Nonempty → ∀ (E : Set (Rn n)), MeasurableSet E → volume E < ⊤ →
      ∀ (R : ℝ), 0 < R → ∀ (c : ℝ), (∀ N ∈ F, rho α N ≤ c) →
      ∫⁻ x in E, F.sup (fun N => ‖avgR α r m (modul (-N) f) x R‖ₑ) ≤
        ENNReal.ofReal (R ^ (-(2 * absA α : ℝ))) * volume (ballA α (R + c)) *
          volume (ballA α R) * ENNReal.ofReal (C * (normM α ν m).toReal *
            Real.sqrt (volume E).toReal * (eLpNorm (f : Rn n → ℂ) 2 volume).toReal) := by
  classical
  obtain ⟨C, hC, hconj⟩ := conj_modelOp_le α hα hn hr ν hν
  refine ⟨C, hC, fun m hm f F hF E hE hEfin R hR c hc => ?_⟩
  have hm' : ClassM α (absA α + 1) m := hm.mono (by omega)
  set K := ENNReal.ofReal (C * (normM α ν m).toReal * Real.sqrt (volume E).toReal *
    (eLpNorm (f : Rn n → ℂ) 2 volume).toReal)
  set G : Rn n → Rn n → Rn n → ℝ → ℝ≥0∞ := fun x η y s =>
    F.sup fun N => ‖avgIntegrand α r m (modul (-N) f) x (η + N) y s‖ₑ
  have hGm : Measurable fun p : Rn n × Rn n × Rn n × ℝ => G p.1 p.2.1 p.2.2.1 p.2.2.2 := by
    have hN : ∀ N ∈ F, Measurable fun p : Rn n × Rn n × Rn n × ℝ =>
        ‖avgIntegrand α r m (modul (-N) f) p.1 (p.2.1 + N) p.2.2.1 p.2.2.2‖ₑ := by
      intro N _
      have h := measurable_avgIntegrand α hα hr hm' (schwartzModul (-N) f)
      rw [coe_schwartzModul] at h
      exact (h.comp (measurable_fst.prodMk ((measurable_snd.fst.add_const N).prodMk
        measurable_snd.snd))).enorm
    have e : (fun p : Rn n × Rn n × Rn n × ℝ => G p.1 p.2.1 p.2.2.1 p.2.2.2) =
        F.sup' hF (fun N p => ‖avgIntegrand α r m (modul (-N) f) p.1 (p.2.1 + N) p.2.2.1
          p.2.2.2‖ₑ) := by
      funext p
      simp only [G]
      rw [Finset.sup'_apply, Finset.sup'_eq_sup]
    rw [e]
    exact Finset.measurable_sup' hF hN
  set c0 := ENNReal.ofReal (R ^ (-(2 * absA α : ℝ)))
  set B' := ballA α (R + c)
  set B := ballA α R
  set I := Set.Ioc (0 : ℝ) 1
  -- pointwise bound by the average of `G`
  have hx : ∀ x, F.sup (fun N => ‖avgR α r m (modul (-N) f) x R‖ₑ) ≤
      c0 * ∫⁻ η in B', ∫⁻ y in B, ∫⁻ s in I, G x η y s := by
    intro x
    refine Finset.sup_le fun N hN => (enorm_avgR_le α r m _ x hR).trans ?_
    refine mul_le_mul' le_rfl ?_
    rw [← lintegral_indicator (measurableSet_ballA α R),
      ← lintegral_indicator (measurableSet_ballA α (R + c)),
      ← lintegral_add_right_eq_self _ N]
    refine lintegral_mono fun η => ?_
    by_cases hη : η + N ∈ B
    · have hη' : η ∈ B' := by
        have h1 := rho_add_le α hα (η + N) (-N)
        rw [add_neg_cancel_right, rho_neg] at h1
        have h2 : rho α (η + N) ≤ R := hη
        change rho α η ≤ R + c
        linarith [hc N hN]
      rw [Set.indicator_of_mem hη, Set.indicator_of_mem hη']
      refine lintegral_mono fun y => lintegral_mono fun s => ?_
      exact Finset.le_sup (f := fun N => ‖avgIntegrand α r m (modul (-N) f) x (η + N) y s‖ₑ) hN
    · rw [Set.indicator_of_notMem hη]
      exact bot_le
  -- Tonelli
  have hswap : ∫⁻ x in E, ∫⁻ η in B', ∫⁻ y in B, ∫⁻ s in I, G x η y s =
      ∫⁻ η in B', ∫⁻ y in B, ∫⁻ s in I, ∫⁻ x in E, G x η y s := by
    exact lintegral_swap4 G hGm
  -- the bound for good parameters
  have hgood : ∀ᵐ η ∂(volume.restrict B'), ∫⁻ y in B, ∫⁻ s in I, ∫⁻ x in E, G x η y s ≤
      ∫⁻ y in B, ∫⁻ s in I, K := by
    refine ae_restrict_of_ae ?_
    filter_upwards [ae_shift_coord_ne_zero F] with η hη
    refine lintegral_mono fun y => lintegral_mono_ae ?_
    have hcount : {s : ℝ | ∃ N ∈ F, dil α ((2 : ℝ) ^ (-s)) (η + N) ∈ gridBd α}.Countable := by
      have : {s : ℝ | ∃ N ∈ F, dil α ((2 : ℝ) ^ (-s)) (η + N) ∈ gridBd α} =
          ⋃ N ∈ (F : Set (Rn n)), {s : ℝ | dil α ((2 : ℝ) ^ (-s)) (η + N) ∈ gridBd α} := by
        ext s; simp
      rw [this]
      exact F.countable_toSet.biUnion fun N hN => countable_bad_scales α hα (hη N hN)
    have hae : ∀ᵐ s : ℝ ∂volume, s ∉ {s : ℝ | ∃ N ∈ F, dil α ((2 : ℝ) ^ (-s)) (η + N) ∈ gridBd α} :=
      measure_eq_zero_iff_ae_notMem.mp (hcount.measure_zero volume)
    filter_upwards [ae_restrict_of_ae hae] with s hs
    have hs' : ∀ N ∈ F, dil α ((2 : ℝ) ^ (-s)) (η + N) ∉ gridBd α := fun N hN h => hs ⟨N, hN, h⟩
    have h := hconj m hm f F hF E hE hEfin η y s hs'
    refine le_trans (le_of_eq ?_) h
    refine lintegral_congr fun x => ?_
    simp only [G]
    exact Finset.sup_congr rfl fun N _ => enorm_avgIntegrand_modul α r m f N x η y s
  calc ∫⁻ x in E, F.sup (fun N => ‖avgR α r m (modul (-N) f) x R‖ₑ)
      ≤ ∫⁻ x in E, c0 * ∫⁻ η in B', ∫⁻ y in B, ∫⁻ s in I, G x η y s := lintegral_mono hx
    _ = c0 * ∫⁻ x in E, ∫⁻ η in B', ∫⁻ y in B, ∫⁻ s in I, G x η y s :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    _ = c0 * ∫⁻ η in B', ∫⁻ y in B, ∫⁻ s in I, ∫⁻ x in E, G x η y s := by rw [hswap]
    _ ≤ c0 * ∫⁻ η in B', ∫⁻ y in B, ∫⁻ s in I, K := mul_le_mul' le_rfl (lintegral_mono_ae hgood)
    _ = _ := by
        simp only [lintegral_const, Measure.restrict_apply_univ, I, Real.volume_Ioc, sub_zero,
          ENNReal.ofReal_one]
        ring

theorem measurable_avgR (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0)
    {m : Rn n → ℂ} (hm : ClassM α (absA α + 1) m) (f : 𝓢(Rn n, ℂ)) {R : ℝ} (hR : 0 < R) :
    Measurable fun x => avgR α r m f x R := by
  have e : (fun x => avgR α r m f x R) = fun x => (((2 * π) ^ n)⁻¹ : ℂ) *
      ∫ ζ, Fint m (f : Rn n → ℂ) x ζ * (KR α r ζ R : ℂ) :=
    funext fun x => avgR_eq α hα hr hm f x hR
  rw [e]
  refine measurable_const.mul ?_
  have hK : Measurable fun q : Rn n × Rn n => Fint m (f : Rn n → ℂ) q.1 q.2 * (KR α r q.2 R : ℂ)
      := by
    unfold Fint
    refine ((((continuous_fhat_schwartz f).measurable.comp measurable_snd).mul
      (hm.measurable.comp measurable_snd)).mul ?_).mul
      (Complex.measurable_ofReal.comp ((measurable_KR α r R).comp measurable_snd))
    exact (by fun_prop : Continuous fun q : Rn n × Rn n =>
      Complex.exp (Complex.I * (⟪q.1, q.2⟫_ℝ : ℂ))).measurable
  exact hK.stronglyMeasurable.integral_prod_right'.measurable

theorem tendsto_ball_ratio (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {c : ℝ} (hc : 0 ≤ c) :
    Filter.Tendsto (fun k : ℕ => ENNReal.ofReal (((k : ℝ) + 1) ^ (-(2 * absA α : ℝ))) *
      volume (ballA α ((k : ℝ) + 1 + c)) * volume (ballA α ((k : ℝ) + 1)))
      Filter.atTop (nhds (ENNReal.ofReal (4 ^ n))) := by
  have e : ∀ k : ℕ, ENNReal.ofReal (((k : ℝ) + 1) ^ (-(2 * absA α : ℝ))) *
      volume (ballA α ((k : ℝ) + 1 + c)) * volume (ballA α ((k : ℝ) + 1)) =
      ENNReal.ofReal (4 ^ n * (1 + c / ((k : ℝ) + 1)) ^ absA α) := by
    intro k
    have hk : (0 : ℝ) < (k : ℝ) + 1 := by positivity
    rw [volume_ballA α hα (by positivity), volume_ballA α hα hk.le,
      ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    have hcast : (2 * absA α : ℝ) = ((2 * absA α : ℕ) : ℝ) := by push_cast; ring
    rw [show (1 + c / ((k : ℝ) + 1)) = ((k : ℝ) + 1 + c) / ((k : ℝ) + 1) by field_simp,
      div_pow, Real.rpow_neg hk.le, hcast, Real.rpow_natCast, pow_mul]
    field_simp
    have h4 : (4 : ℝ) ^ n = (2 ^ n) ^ 2 := by rw [← pow_mul, mul_comm, pow_mul]; norm_num
    rw [h4, ← pow_mul ((k : ℝ) + 1) (absA α) 2, ← pow_mul ((k : ℝ) + 1) 2 (absA α),
      mul_comm (absA α) 2]
    ring
  simp_rw [e]
  refine ENNReal.tendsto_ofReal ?_
  have h1 : Filter.Tendsto (fun k : ℕ => c / ((k : ℝ) + 1)) Filter.atTop (nhds 0) := by
    have := tendsto_one_div_add_atTop_nhds_zero_nat.const_mul c
    simp only [mul_zero] at this
    refine this.congr fun k => ?_
    rw [mul_one_div]
  have h2 := ((h1.const_add 1).pow (absA α)).const_mul ((4 : ℝ) ^ n)
  simpa using h2

theorem enorm_twoPi_inv : ‖(((2 * π) ^ n)⁻¹ : ℂ)‖ₑ = ENNReal.ofReal (((2 * π) ^ n)⁻¹) := by
  rw [← ofReal_norm, norm_inv, norm_pow, Complex.norm_mul, Complex.norm_ofNat, Complex.norm_real,
    Real.norm_eq_abs, abs_of_pos Real.pi_pos]

/-- **Weak form of Theorem 3.2 for the averaged operator** (texline~277–281): with
`𝐀^{r,m} g = (2π)^{-n} (θ_r m ĝ)_check` (Lemma 3.3), for finite `F`,
`∫_E max_{N∈F} |∫ θ_r m (M_{-N} f)^∧ e^{ix·}| ≤ C ‖m‖ |E|^{1/2} ‖f‖₂`. -/
theorem lintegral_sup_theta_le (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) (hn : 0 < n)
    {r : Fin n → Fin 2} (hr : r ≠ 0) (ν : ℕ) (hν : 3 * absA α + 2 ≤ ν) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (m : Rn n → ℂ), ClassM α ν m → ∀ (f : 𝓢(Rn n, ℂ)) (F : Finset (Rn n)),
      F.Nonempty → ∀ (E : Set (Rn n)), MeasurableSet E → volume E < ⊤ →
      ∫⁻ x in E, F.sup (fun N => ‖∫ ζ, (thetaR α r ζ : ℂ) * m ζ * fhat (modul (-N) f) ζ *
        Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ))‖ₑ) ≤
        ENNReal.ofReal (C * (normM α ν m).toReal * Real.sqrt (volume E).toReal *
          (eLpNorm (f : Rn n → ℂ) 2 volume).toReal) := by
  classical
  obtain ⟨C, hC, hA⟩ := lintegral_sup_avgR_le α hα hn hr ν hν
  refine ⟨(2 * π) ^ n * 4 ^ n * C, by positivity, fun m hm f F hF E hE hEfin => ?_⟩
  have hm' : ClassM α (absA α + 1) m := hm.mono (by omega)
  set Nm := (normM α ν m).toReal
  have hNm : 0 ≤ Nm := ENNReal.toReal_nonneg
  set c := F.sup' hF (rho α)
  have hc : ∀ N ∈ F, rho α N ≤ c := fun N hN => Finset.le_sup' (rho α) hN
  have hc0 : 0 ≤ c := by
    obtain ⟨N, hN⟩ := hF
    exact (rho_nonneg α N).trans (hc N hN)
  set K := ENNReal.ofReal (C * Nm * Real.sqrt (volume E).toReal *
    (eLpNorm (f : Rn n → ℂ) 2 volume).toReal)
  set I : Rn n → Rn n → ℂ := fun N x => ∫ ζ, (thetaR α r ζ : ℂ) * m ζ * fhat (modul (-N) f) ζ *
    Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ))
  set κ := ENNReal.ofReal (((2 * π) ^ n)⁻¹)
  set g : ℕ → Rn n → ℝ≥0∞ := fun k x =>
    F.sup fun N => ‖avgR α r m (modul (-N) f) x ((k : ℝ) + 1)‖ₑ
  have hR : Filter.Tendsto (fun k : ℕ => (k : ℝ) + 1) Filter.atTop Filter.atTop :=
    tendsto_natCast_atTop_atTop.atTop_add tendsto_const_nhds
  have hlim : ∀ N x, Filter.Tendsto (fun k : ℕ => ‖avgR α r m (modul (-N) f) x ((k : ℝ) + 1)‖ₑ)
      Filter.atTop (nhds (κ * ‖I N x‖ₑ)) := by
    intro N x
    have h := tendsto_avgRHO α hα hr hm' (schwartzModul (-N) f) x
    rw [coe_schwartzModul] at h
    have e : avgRHO α r m (modul (-N) f) x = avgR α r m (modul (-N) f) x :=
      funext fun R => (avgR_eq_avgRHO α hα r m _ x R).symm
    rw [e] at h
    have h' := (continuous_enorm.tendsto _).comp (h.comp hR)
    rw [enorm_mul, enorm_twoPi_inv] at h'
    exact h'
  -- pointwise: `κ ‖I N x‖ₑ ≤ liminf g`
  have hpt : ∀ x, F.sup (fun N => ‖I N x‖ₑ) ≤ κ⁻¹ * Filter.liminf (fun k => g k x) Filter.atTop
      := by
    intro x
    refine Finset.sup_le fun N hN => ?_
    have h1 : κ * ‖I N x‖ₑ ≤ Filter.liminf (fun k => g k x) Filter.atTop := by
      rw [← (hlim N x).liminf_eq]
      exact Filter.liminf_le_liminf (Filter.Eventually.of_forall fun k =>
        Finset.le_sup (f := fun N => ‖avgR α r m (modul (-N) f) x ((k : ℝ) + 1)‖ₑ) hN)
    have hκ0 : κ ≠ 0 := by
      simp only [κ, ne_eq, ENNReal.ofReal_eq_zero, not_le]; positivity
    calc ‖I N x‖ₑ = κ⁻¹ * (κ * ‖I N x‖ₑ) := by
          rw [← mul_assoc, ENNReal.inv_mul_cancel hκ0 ENNReal.ofReal_ne_top, one_mul]
      _ ≤ _ := mul_le_mul' le_rfl h1
  -- measurability of `g k`
  have hgm : ∀ k, Measurable (g k) := by
    intro k
    have hN : ∀ N ∈ F, Measurable fun x => ‖avgR α r m (modul (-N) f) x ((k : ℝ) + 1)‖ₑ := by
      intro N _
      have h := measurable_avgR α hα hr hm' (schwartzModul (-N) f) (R := (k : ℝ) + 1)
        (by positivity)
      rw [coe_schwartzModul] at h
      exact h.enorm
    have e : g k = F.sup' hF (fun N x => ‖avgR α r m (modul (-N) f) x ((k : ℝ) + 1)‖ₑ) := by
      funext x
      simp only [g]
      rw [Finset.sup'_apply, Finset.sup'_eq_sup]
    rw [e]
    exact Finset.measurable_sup' hF hN
  have hbound : ∀ k : ℕ, ∫⁻ x in E, g k x ≤
      ENNReal.ofReal (((k : ℝ) + 1) ^ (-(2 * absA α : ℝ))) *
        volume (ballA α ((k : ℝ) + 1 + c)) * volume (ballA α ((k : ℝ) + 1)) * K :=
    fun k => hA m hm f F hF E hE hEfin ((k : ℝ) + 1) (by positivity) c hc
  have htend := ENNReal.Tendsto.mul_const (tendsto_ball_ratio α hα hc0) (b := K)
    (Or.inr ENNReal.ofReal_ne_top)
  have hκinv : κ⁻¹ = ENNReal.ofReal ((2 * π) ^ n) := by
    have hp : (0 : ℝ) < (2 * π) ^ n := by positivity
    simp only [κ]
    rw [ENNReal.ofReal_inv_of_pos hp, inv_inv]
  calc ∫⁻ x in E, F.sup (fun N => ‖I N x‖ₑ)
      ≤ ∫⁻ x in E, κ⁻¹ * Filter.liminf (fun k => g k x) Filter.atTop := lintegral_mono hpt
    _ = κ⁻¹ * ∫⁻ x in E, Filter.liminf (fun k => g k x) Filter.atTop := by
        rw [lintegral_const_mul' _ _ (by rw [hκinv]; exact ENNReal.ofReal_ne_top)]
    _ ≤ κ⁻¹ * Filter.liminf (fun k => ∫⁻ x in E, g k x) Filter.atTop :=
        mul_le_mul' le_rfl (lintegral_liminf_le' fun k => (hgm k).aemeasurable)
    _ ≤ κ⁻¹ * (ENNReal.ofReal (4 ^ n) * K) := by
        refine mul_le_mul' le_rfl ?_
        rw [← htend.liminf_eq]
        exact Filter.liminf_le_liminf (Filter.Eventually.of_forall hbound)
    _ = _ := by
        rw [hκinv, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity)]
        congr 1
        ring

/-! ### The Carleson operator of `θ_r m` (paper, texline~277–279) -/

/-- A function homogeneous of degree `0` for the anisotropic dilations and continuous away from the
origin is bounded. -/
theorem bounded_of_homogeneous (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {q : Rn n → ℂ}
    (hq : ContinuousOn q {0}ᶜ) (hhom : ∀ ξ : Rn n, ξ ≠ 0 → ∀ t : ℝ, 0 < t → q (dil α t ξ) = q ξ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ ξ, ‖q ξ‖ ≤ C := by
  have hsub : {ξ : Rn n | rho α ξ = 1} ⊆ {0}ᶜ := fun ξ hξ h0 => by
    simp only [Set.mem_ofPred_eq] at hξ
    rw [Set.mem_singleton_iff.mp h0, rho_zero α hα] at hξ
    exact zero_ne_one hξ
  obtain ⟨C, hC⟩ := (isCompact_rho_eq_one α hα).exists_bound_of_continuousOn (hq.mono hsub)
  refine ⟨max C ‖q 0‖ ⊔ 0, le_sup_right, fun ξ => ?_⟩
  by_cases h0 : ξ = 0
  · rw [h0]; exact (le_max_right _ _).trans le_sup_left
  · have hρ : 0 < rho α ξ := rho_pos_of_ne_zero α hα h0
    have h1 : rho α (dil α (rho α ξ)⁻¹ ξ) = 1 := by
      rw [rho_dil α hα (inv_pos.mpr hρ), inv_mul_cancel₀ hρ.ne']
    rw [← hhom ξ h0 _ (inv_pos.mpr hρ)]
    exact ((hC _ h1).trans (le_max_left _ _)).trans le_sup_left

theorem continuousOn_thetaR (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {r : Fin n → Fin 2} (hr : r ≠ 0) :
    ContinuousOn (fun ξ => (thetaR α r ξ : ℂ)) {0}ᶜ := fun _ hξ =>
  (Complex.continuous_ofReal.continuousAt.comp
    (contDiffAt_thetaR α hα hr hξ).continuousAt).continuousWithinAt

theorem fhat_modul (ξ₀ : Rn n) (f : Rn n → ℂ) (ζ : Rn n) :
    fhat (modul ξ₀ f) ζ = fhat f (ζ - ξ₀) := by
  unfold fhat modul
  congr 1
  funext x
  rw [← mul_assoc, ← Complex.exp_add, inner_sub_right, Complex.ofReal_sub]
  congr 2
  ring

/-- The frequency-shifted integrand of the Carleson operator: the modulus of
`∫ f̂(ξ) e^{ixξ} M(ξ − N) dξ` is that of `∫ M(ζ) (M_{-N} f)^∧(ζ) e^{ixζ} dζ`. -/
theorem enorm_carlesonIntegrand_eq (M : Rn n → ℂ) (f : Rn n → ℂ) (x N : Rn n) :
    ‖∫ ξ, fhat f ξ * Complex.exp (Complex.I * (⟪x, ξ⟫_ℝ : ℂ)) * M (ξ - N)‖ₑ =
      ‖∫ ζ, M ζ * fhat (modul (-N) f) ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ))‖ₑ := by
  rw [← integral_add_right_eq_self
    (fun ξ => fhat f ξ * Complex.exp (Complex.I * (⟪x, ξ⟫_ℝ : ℂ)) * M (ξ - N)) N]
  have e : ∀ ζ, fhat f (ζ + N) * Complex.exp (Complex.I * (⟪x, ζ + N⟫_ℝ : ℂ)) * M (ζ + N - N) =
      Complex.exp (Complex.I * (⟪x, N⟫_ℝ : ℂ)) *
        (M ζ * fhat (modul (-N) f) ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ))) := by
    intro ζ
    rw [fhat_modul, sub_neg_eq_add, add_sub_cancel_right, inner_add_right, Complex.ofReal_add,
      mul_add, Complex.exp_add]
    ring
  simp_rw [e]
  rw [integral_const_mul, enorm_mul, ← ofReal_norm (Complex.exp _), mul_comm Complex.I,
    Complex.norm_exp_ofReal_mul_I, ENNReal.ofReal_one, one_mul]

/-- The Carleson integrand is continuous in the frequency `N`, for a bounded multiplier continuous
away from the origin. -/
theorem continuous_carlesonIntegrand (hn : 0 < n) {M : Rn n → ℂ} {B : ℝ} (hMb : ∀ ξ, ‖M ξ‖ ≤ B)
    (hMc : ContinuousOn M {0}ᶜ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    Continuous fun N => ∫ ξ, fhat f ξ * Complex.exp (Complex.I * (⟪x, ξ⟫_ℝ : ℂ)) * M (ξ - N) := by
  have hMm : Measurable M := measurable_of_continuousOn_compl_singleton 0 hMc
  rw [continuous_iff_continuousAt]
  intro N₀
  refine continuousAt_of_dominated (bound := fun ξ => ‖fhat (f : Rn n → ℂ) ξ‖ * B) ?_ ?_ ?_ ?_
  · refine Filter.Eventually.of_forall fun N => ?_
    exact (((continuous_fhat_schwartz f).mul (by fun_prop)).measurable.mul
      (hMm.comp (measurable_id.sub_const N))).aestronglyMeasurable
  · refine Filter.Eventually.of_forall fun N => Filter.Eventually.of_forall fun ξ => ?_
    rw [norm_mul, norm_mul, mul_comm Complex.I, Complex.norm_exp_ofReal_mul_I, mul_one]
    exact mul_le_mul_of_nonneg_left (hMb _) (norm_nonneg _)
  · exact (integrable_fhat_schwartz f).norm.mul_const B
  · have hnull : ∀ᵐ ξ ∂(volume : Measure (Rn n)), ξ ≠ N₀ := by
      rw [ae_iff]
      simp only [ne_eq, not_not]
      refine measure_mono_null (fun ξ (h : ξ = N₀) => ?_) (volume_coord_eq ⟨0, hn⟩ (N₀ ⟨0, hn⟩))
      simp [h]
    filter_upwards [hnull] with ξ hξ
    have hne : ξ - N₀ ≠ 0 := sub_ne_zero.mpr hξ
    have h1 : ContinuousAt (fun N => M (ξ - N)) N₀ :=
      (hMc.continuousAt (isOpen_compl_singleton.mem_nhds hne)).comp
        (continuous_const.sub continuous_id).continuousAt
    exact continuousAt_const.mul h1

/-- The Fourier integral `∫ M ĝ e^{ix·}` is continuous in `x`. -/
theorem continuous_fourierMult {M : Rn n → ℂ} {B : ℝ} (hMb : ∀ ξ, ‖M ξ‖ ≤ B) (hMm : Measurable M)
    (g : 𝓢(Rn n, ℂ)) :
    Continuous fun x => ∫ ζ, M ζ * fhat g ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ)) := by
  refine continuous_of_dominated (bound := fun ζ => B * ‖fhat (g : Rn n → ℂ) ζ‖) ?_ ?_ ?_ ?_
  · intro x
    exact ((hMm.mul (continuous_fhat_schwartz g).measurable).mul
      (by fun_prop : Continuous fun ζ : Rn n =>
        Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ))).measurable).aestronglyMeasurable
  · intro x
    refine Filter.Eventually.of_forall fun ζ => ?_
    rw [norm_mul, norm_mul, mul_comm Complex.I, Complex.norm_exp_ofReal_mul_I, mul_one]
    exact mul_le_mul_of_nonneg_right (hMb _) (norm_nonneg _)
  · exact (integrable_fhat_schwartz g).norm.const_mul B
  · exact Filter.Eventually.of_forall fun ζ => continuous_const.mul (by fun_prop)

theorem iSup_eq_iSup_dense {g : Rn n → ℝ≥0∞} (hg : Continuous g) {D : Set (Rn n)} (hD : Dense D) :
    ⨆ N, g N = ⨆ N ∈ D, g N := by
  refine le_antisymm (iSup_le fun N => ?_) (iSup₂_le fun N _ => le_iSup g N)
  have hcl : IsClosed {N | g N ≤ ⨆ N ∈ D, g N} := isClosed_le hg continuous_const
  have hsub : D ⊆ {N | g N ≤ ⨆ N ∈ D, g N} := fun N hN => le_iSup₂ (f := fun N (_ : N ∈ D) => g
      N) N hN
  have := hcl.closure_subset_iff.mpr hsub
  rw [hD.closure_eq] at this
  exact this (Set.mem_univ N)

theorem le_sq_of_mul_le_sqrt {t a K : ℝ} (ht : 0 < t) (ha : 0 ≤ a) (hK : 0 ≤ K)
    (h : t * a ≤ K * Real.sqrt a) : a ≤ (K / t) ^ 2 := by
  rcases ha.eq_or_lt with h0 | hpos
  · rw [← h0]; positivity
  · have hs : 0 < Real.sqrt a := Real.sqrt_pos.mpr hpos
    have h1 : t * Real.sqrt a ≤ K := by
      have := Real.mul_self_sqrt ha
      nlinarith
    have h2 : Real.sqrt a ≤ K / t := by rw [le_div_iff₀ ht]; linarith
    calc a = Real.sqrt a ^ 2 := (Real.sq_sqrt ha).symm
      _ ≤ (K / t) ^ 2 := by gcongr

/-- **Weak `(2,2)` bound for `𝒞_{θ_r m}`** (texline~277–281): for `ν ≥ 3|α| + 2`,
`|{𝒞_{θ_r m} f > t}| ≤ (C ‖m‖ ‖f‖₂ / t)²`. -/
theorem carleson_theta_weak (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) (hn : 0 < n)
    {r : Fin n → Fin 2} (hr : r ≠ 0) (ν : ℕ) (hν : 3 * absA α + 2 ≤ ν) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (m : Rn n → ℂ), ClassM α ν m → ∀ (f : 𝓢(Rn n, ℂ)) (t : ℝ), 0 < t →
      volume {x | ENNReal.ofReal t < carleson (fun ξ => (thetaR α r ξ : ℂ) * m ξ) f x} ≤
        ENNReal.ofReal ((C * (normM α ν m).toReal * (eLpNorm (f : Rn n → ℂ) 2 volume).toReal /
          t) ^ 2) := by
  classical
  obtain ⟨C, hC, hL⟩ := lintegral_sup_theta_le α hα hn hr ν hν
  refine ⟨C, hC, fun m hm f t ht => ?_⟩
  set Nm := (normM α ν m).toReal
  set Kf := C * Nm * (eLpNorm (f : Rn n → ℂ) 2 volume).toReal
  have hKf : 0 ≤ Kf := by positivity
  set M : Rn n → ℂ := fun ξ => (thetaR α r ξ : ℂ) * m ξ
  obtain ⟨Bθ, hBθ0, hBθ⟩ := bounded_of_homogeneous α hα (continuousOn_thetaR α hα hr)
    (fun ξ _ t ht => by simp only [thetaR_dil α r ξ ht])
  obtain ⟨Bm, hBm0, hBm⟩ := hm.bounded'
  have hMb : ∀ ξ, ‖M ξ‖ ≤ Bθ * Bm := fun ξ => by
    rw [norm_mul]; exact mul_le_mul (hBθ ξ) (hBm ξ) (norm_nonneg _) hBθ0
  have hMc : ContinuousOn M {0}ᶜ :=
    (continuousOn_thetaR α hα hr).mul (hm.contDiffOn.continuousOn)
  have hMm : Measurable M := measurable_of_continuousOn_compl_singleton 0 hMc
  set g : Rn n → Rn n → ℝ≥0∞ := fun N x =>
    ‖∫ ζ, M ζ * fhat (modul (-N) f) ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ))‖ₑ
  have hgN : ∀ x, Continuous fun N => g N x := by
    intro x
    have e : (fun N => g N x) = fun N => ‖∫ ξ, fhat f ξ * Complex.exp (Complex.I * (⟪x, ξ⟫_ℝ : ℂ)) *
        M (ξ - N)‖ₑ := funext fun N => (enorm_carlesonIntegrand_eq M f x N).symm
    rw [e]
    exact continuous_enorm.comp (continuous_carlesonIntegrand hn hMb hMc f x)
  have hgx : ∀ N, Measurable (g N) := by
    intro N
    have h := continuous_fourierMult hMb hMm (schwartzModul (-N) f)
    rw [coe_schwartzModul] at h
    exact (continuous_enorm.comp h).measurable
  obtain ⟨D, hDc, hDd⟩ := TopologicalSpace.exists_countable_dense (Rn n)
  have hDne : D.Nonempty := hDd.nonempty
  obtain ⟨e, he⟩ := hDc.exists_eq_range hDne
  set Fk : ℕ → Finset (Rn n) := fun k => (Finset.range (k + 1)).image e
  have hFk : ∀ k, (Fk k).Nonempty := fun k => Finset.Nonempty.image ⟨0, Finset.mem_range.mpr
      (Nat.succ_pos k)⟩ e
  set U : ℕ → Set (Rn n) := fun k => {x | ENNReal.ofReal t < (Fk k).sup fun N => g N x}
  -- the level set is the increasing union of the `U k`
  have hcarl : ∀ x, carleson M f x = ⨆ k, (Fk k).sup fun N => g N x := by
    intro x
    unfold carleson
    have e1 : (⨆ N, ‖∫ ξ, fhat f ξ * Complex.exp (Complex.I * (⟪x, ξ⟫_ℝ : ℂ)) * M (ξ - N)‖ₑ) =
        ⨆ N, g N x := iSup_congr fun N => enorm_carlesonIntegrand_eq M f x N
    rw [e1, iSup_eq_iSup_dense (hgN x) hDd]
    apply le_antisymm
    · refine iSup₂_le fun N hN => ?_
      rw [he] at hN
      obtain ⟨j, rfl⟩ := hN
      exact le_iSup_of_le j (Finset.le_sup (f := fun N => g N x)
        (Finset.mem_image.mpr ⟨j, Finset.mem_range.mpr (Nat.lt_succ_self j), rfl⟩))
    · refine iSup_le fun k => Finset.sup_le fun N hN => ?_
      obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hN
      exact le_iSup₂ (f := fun N (_ : N ∈ D) => g N x) (e j) (by rw [he]; exact ⟨j, rfl⟩)
  have hset : {x | ENNReal.ofReal t < carleson M f x} = ⋃ k, U k := by
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_iUnion, U, hcarl x, lt_iSup_iff]
  have hmono : Monotone U := by
    intro k l hkl x (hx : ENNReal.ofReal t < _)
    change ENNReal.ofReal t < _
    refine lt_of_lt_of_le hx (Finset.sup_mono ?_)
    exact Finset.image_subset_image (Finset.range_subset_range.mpr (by omega))
  have hUm : ∀ k, MeasurableSet (U k) := by
    intro k
    have hmeas : Measurable fun x => (Fk k).sup fun N => g N x := by
      have e1 : (fun x => (Fk k).sup fun N => g N x) = (Fk k).sup' (hFk k) (fun N => g N) := by
        funext x; rw [Finset.sup'_apply, Finset.sup'_eq_sup]
      rw [e1]
      exact Finset.measurable_sup' (hFk k) fun N _ => hgx N
    exact measurableSet_lt measurable_const hmeas
  -- each `U k` has small measure
  have hU : ∀ k, volume (U k) ≤ ENNReal.ofReal ((Kf / t) ^ 2) := by
    intro k
    set A : ℕ → Set (Rn n) := fun j => U k ∩ Metric.closedBall 0 j
    have hAm : Monotone A := fun i j hij => Set.inter_subset_inter_right _
      (Metric.closedBall_subset_closedBall (by exact_mod_cast hij))
    have hUA : U k = ⋃ j, A j := by
      ext x
      simp only [Set.mem_iUnion, Set.mem_inter_iff, A, Metric.mem_closedBall, dist_zero_right]
      constructor
      · intro hx
        obtain ⟨j, hj⟩ := exists_nat_ge ‖x‖
        exact ⟨j, hx, hj⟩
      · rintro ⟨j, hx, -⟩; exact hx
    rw [hUA, hAm.measure_iUnion]
    refine iSup_le fun j => ?_
    have hAmeas : MeasurableSet (A j) := (hUm k).inter Metric.isClosed_closedBall.measurableSet
    have hAfin : volume (A j) < ⊤ :=
      (measure_mono Set.inter_subset_right).trans_lt measure_closedBall_lt_top
    have h1 : ENNReal.ofReal t * volume (A j) ≤ ∫⁻ x in A j, (Fk k).sup fun N => g N x := by
      rw [← setLIntegral_const]
      exact setLIntegral_mono' hAmeas fun x hx => hx.1.le
    have h2 := hL m hm f (Fk k) (hFk k) (A j) hAmeas hAfin
    have h3 : ENNReal.ofReal t * volume (A j) ≤
        ENNReal.ofReal (Kf * Real.sqrt (volume (A j)).toReal) := by
      refine h1.trans (le_trans (le_of_eq ?_) (h2.trans (le_of_eq ?_)))
      · rfl
      · congr 1; simp only [Kf]; ring
    have hv : volume (A j) = ENNReal.ofReal (volume (A j)).toReal :=
      (ENNReal.ofReal_toReal hAfin.ne).symm
    conv_lhs at h3 => rw [hv]
    rw [← ENNReal.ofReal_mul ht.le, ENNReal.ofReal_le_ofReal_iff (by positivity)] at h3
    rw [← ENNReal.ofReal_toReal hAfin.ne]
    exact ENNReal.ofReal_le_ofReal (le_sq_of_mul_le_sqrt ht ENNReal.toReal_nonneg hKf h3)
  rw [hset, hmono.measure_iUnion]
  exact iSup_le hU

/-! ### Coordinate reflections (reduction to the quadrant, texline~275) -/

/-- The reflection `S_s` changing the sign of the coordinates `i` with `s i = true`. -/
def refl (s : Fin n → Bool) : Rn n ≃ₗᵢ[ℝ] Rn n :=
  LinearIsometryEquiv.piLpCongrRight 2
    (fun i => if s i then LinearIsometryEquiv.neg ℝ else LinearIsometryEquiv.refl ℝ ℝ)

theorem refl_apply (s : Fin n → Bool) (x : Rn n) (i : Fin n) :
    refl s x i = if s i then -x i else x i := by
  simp only [refl, LinearIsometryEquiv.piLpCongrRight_apply, PiLp.toLp_apply]
  split_ifs <;> simp

theorem refl_refl (s : Fin n → Bool) (x : Rn n) : refl s (refl s x) = x := by
  ext i
  simp only [refl_apply]
  split_ifs <;> simp

theorem dil_refl (α : Fin n → ℕ) (s : Fin n → Bool) (t : ℝ) (x : Rn n) :
    dil α t (refl s x) = refl s (dil α t x) := by
  ext i
  simp only [dil, PiLp.toLp_apply, refl_apply]
  split_ifs <;> ring

theorem rho_refl (α : Fin n → ℕ) (s : Fin n → Bool) (x : Rn n) : rho α (refl s x) = rho α x := by
  unfold rho rhoNN
  congr 2
  funext i
  simp only [refl_apply]
  split_ifs <;> simp [nnnorm_neg]

theorem exists_refl_nonpos (ξ : Rn n) : ∃ s : Fin n → Bool, ∀ i, refl s ξ i ≤ 0 := by
  refine ⟨fun i => decide (0 < ξ i), fun i => ?_⟩
  rw [refl_apply]
  by_cases h : 0 < ξ i
  · simp only [h, decide_true, ite_true]; linarith
  · simp only [h, decide_false]; simp only [Bool.false_eq_true, ite_false]; linarith

theorem inner_refl (s : Fin n → Bool) (x ξ : Rn n) : ⟪refl s x, refl s ξ⟫_ℝ = ⟪x, ξ⟫_ℝ :=
  (refl s).inner_map_map x ξ

theorem fhat_comp_refl (s : Fin n → Bool) (f : Rn n → ℂ) (ξ : Rn n) :
    fhat (f ∘ refl s) ξ = fhat f (refl s ξ) := by
  unfold fhat
  have h := ((refl s).measurePreserving).integral_comp (refl s).toHomeomorph.measurableEmbedding
    (fun y => Complex.exp (-(Complex.I * (⟪y, refl s ξ⟫_ℝ : ℂ))) * f y)
  rw [← h]
  congr 1
  funext x
  simp only [Function.comp, inner_refl]

/-- The Carleson operator commutes with reflections:
`𝒞_{M ∘ S}(f ∘ S)(x) = 𝒞_M f(S x)`. -/
theorem carleson_comp_refl (s : Fin n → Bool) (M : Rn n → ℂ) (f : Rn n → ℂ) (x : Rn n) :
    carleson (M ∘ refl s) (f ∘ refl s) x = carleson M f (refl s x) := by
  unfold carleson
  have h1 : ∀ N, ∫ ξ, fhat (f ∘ refl s) ξ * Complex.exp (Complex.I * (⟪x, ξ⟫_ℝ : ℂ)) *
      (M ∘ refl s) (ξ - N) = ∫ ζ, fhat f ζ * Complex.exp (Complex.I * (⟪refl s x, ζ⟫_ℝ : ℂ)) *
        M (ζ - refl s N) := by
    intro N
    have h := ((refl s).measurePreserving).integral_comp (refl s).toHomeomorph.measurableEmbedding
      (fun ζ => fhat f ζ * Complex.exp (Complex.I * (⟪refl s x, ζ⟫_ℝ : ℂ)) * M (ζ - refl s N))
    rw [← h]
    congr 1
    funext ξ
    simp only [Function.comp, fhat_comp_refl, inner_refl,
      LinearIsometryEquiv.map_sub]
  simp_rw [h1]
  exact (refl s).toEquiv.iSup_comp (g := fun N => ‖∫ ζ, fhat f ζ *
    Complex.exp (Complex.I * (⟪refl s x, ζ⟫_ℝ : ℂ)) * M (ζ - N)‖ₑ)

/-- `f ∘ S` as a Schwartz function. -/
def schwartzRefl (s : Fin n → Bool) (f : 𝓢(Rn n, ℂ)) : 𝓢(Rn n, ℂ) :=
  SchwartzMap.compCLMOfContinuousLinearEquiv ℂ (refl s).toContinuousLinearEquiv f

@[simp]
theorem coe_schwartzRefl (s : Fin n → Bool) (f : 𝓢(Rn n, ℂ)) :
    (schwartzRefl s f : Rn n → ℂ) = f ∘ refl s := rfl

theorem eLpNorm_schwartzRefl (s : Fin n → Bool) (f : 𝓢(Rn n, ℂ)) :
    eLpNorm (schwartzRefl s f : Rn n → ℂ) 2 volume = eLpNorm (f : Rn n → ℂ) 2 volume := by
  rw [coe_schwartzRefl]
  exact eLpNorm_comp_measurePreserving f.continuous.aestronglyMeasurable (refl s).measurePreserving

/-! ### The symbol norm under reflections and products (texline~281–282) -/

theorem normM_le_of_iteratedFDeriv (α : Fin n → ℕ) (ν : ℕ) (m' : Rn n → ℂ) {B : ℝ}
    (h : ∀ k ≤ ν, ∀ ξ : Rn n, rho α ξ = 1 → ‖iteratedFDeriv ℝ k m' ξ‖ ≤ B) :
    normM α ν m' ≤ ENNReal.ofReal B := by
  classical
  unfold normM
  refine iSup₂_le fun k hk => iSup_le fun i => iSup₂_le fun ξ hξ => ?_
  rw [iterPartial, ← ofReal_norm]
  refine ENNReal.ofReal_le_ofReal (((iteratedFDeriv ℝ k m' ξ).le_opNorm _).trans ?_)
  have : ∏ j, ‖EuclideanSpace.single (i j) (1 : ℝ)‖ = 1 := by
    simp
  rw [this, mul_one]
  exact h k hk ξ hξ

theorem norm_iteratedFDeriv_le_normM (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) (hn : 0 < n) {ν : ℕ}
    {m : Rn n → ℂ} (hm : ClassM α ν m) {k : ℕ} (hk : k ≤ ν) {ξ : Rn n} (hξ : rho α ξ = 1) :
    ‖iteratedFDeriv ℝ k m ξ‖ ≤ (n : ℝ) ^ ν * (normM α ν m).toReal := by
  have h := enorm_iteratedFDeriv_le α hα hm hk one_pos le_rfl hξ.ge
  simp only [Real.one_rpow, mul_one] at h
  rw [← ofReal_norm, ← ENNReal.ofReal_toReal (normM_lt_top α hα hm).ne,
    ← ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_le_ofReal_iff (by positivity)] at h
  refine h.trans (mul_le_mul_of_nonneg_right ?_ ENNReal.toReal_nonneg)
  exact pow_le_pow_right₀ (by exact_mod_cast hn) hk

theorem ClassM.comp_refl {α : Fin n → ℕ} {ν : ℕ} {m : Rn n → ℂ} (hm : ClassM α ν m)
    (s : Fin n → Bool) : ClassM α ν (m ∘ refl s) := by
  obtain ⟨C, hC⟩ := hm.bounded
  refine ⟨⟨C, fun ξ => hC _⟩, ?_, fun ξ hξ t ht => ?_⟩
  · refine hm.contDiffOn.comp (refl s).toContinuousLinearEquiv.contDiff.contDiffOn ?_
    intro ξ hξ h0
    apply hξ
    have : refl s (refl s ξ) = refl s 0 := congrArg (refl s) h0
    rwa [refl_refl, map_zero] at this
  · simp only [Function.comp]
    rw [← dil_refl]
    refine hm.homogeneous _ ?_ t ht
    intro h0
    apply hξ
    have : refl s (refl s ξ) = refl s 0 := congrArg (refl s) h0
    rwa [refl_refl, map_zero] at this

theorem normM_comp_refl_le (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) (hn : 0 < n) {ν : ℕ}
    {m : Rn n → ℂ} (hm : ClassM α ν m) (s : Fin n → Bool) :
    (normM α ν (m ∘ refl s)).toReal ≤ (n : ℝ) ^ ν * (normM α ν m).toReal := by
  have h := normM_le_of_iteratedFDeriv α ν (m ∘ refl s) (B := (n : ℝ) ^ ν * (normM α ν m).toReal)
    (fun k hk ξ hξ => by
      rw [LinearIsometryEquiv.norm_iteratedFDeriv_comp_right]
      exact norm_iteratedFDeriv_le_normM α hα hn hm hk (by rw [rho_refl]; exact hξ))
  exact (ENNReal.toReal_le_of_le_ofReal (by positivity) h)

/-- Multiplying by a fixed function smooth away from the origin costs a constant in the symbol
    norm. -/
theorem normM_mul_le (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) (hn : 0 < n) (ν : ℕ) {q : Rn n → ℂ}
    (hq : ContDiffOn ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) q {0}ᶜ) :
    ∃ Cq : ℝ, 0 ≤ Cq ∧ ∀ m : Rn n → ℂ, ClassM α ν m →
      (normM α ν (fun ξ => q ξ * m ξ)).toReal ≤ Cq * (normM α ν m).toReal := by
  have hsub : {ξ : Rn n | rho α ξ = 1} ⊆ {0}ᶜ := fun ξ hξ h0 => by
    simp only [Set.mem_ofPred_eq] at hξ
    rw [Set.mem_singleton_iff.mp h0, rho_zero α hα] at hξ
    exact zero_ne_one hξ
  have hopen : IsOpen ({0}ᶜ : Set (Rn n)) := isOpen_compl_singleton
  have hbd : ∀ j : ℕ, ∃ C : ℝ, ∀ ξ ∈ {ξ : Rn n | rho α ξ = 1}, ‖iteratedFDeriv ℝ j q ξ‖ ≤ C := by
    intro j
    have hc : ContinuousOn (fun ξ => iteratedFDeriv ℝ j q ξ) {0}ᶜ :=
      (hq.continuousOn_iteratedFDerivWithin (by exact_mod_cast le_top) hopen.uniqueDiffOn).congr
        (fun ξ hξ => (iteratedFDerivWithin_of_isOpen j hopen hξ).symm)
    obtain ⟨C, hC⟩ := (isCompact_rho_eq_one α hα).exists_bound_of_continuousOn (hc.mono hsub)
    exact ⟨C, hC⟩
  choose C hC using hbd
  set Bq : ℝ := ∑ j ∈ Finset.range (ν + 1), |C j|
  have hBq : 0 ≤ Bq := Finset.sum_nonneg fun j _ => abs_nonneg _
  have hCB : ∀ j ≤ ν, ∀ ξ, rho α ξ = 1 → ‖iteratedFDeriv ℝ j q ξ‖ ≤ Bq := fun j hj ξ hξ =>
    (hC j ξ hξ).trans ((le_abs_self _).trans (Finset.single_le_sum (f := fun j => |C j|)
      (fun j _ => abs_nonneg _) (Finset.mem_range.mpr (by omega))))
  refine ⟨2 ^ ν * Bq * (n : ℝ) ^ ν, by positivity, fun m hm => ?_⟩
  set Nm := (normM α ν m).toReal
  have hNm : 0 ≤ Nm := ENNReal.toReal_nonneg
  have h := normM_le_of_iteratedFDeriv α ν (fun ξ => q ξ * m ξ)
    (B := 2 ^ ν * Bq * (n : ℝ) ^ ν * Nm) (fun k hk ξ hξ => by
      have hξ0 : ξ ∈ ({0}ᶜ : Set (Rn n)) := hsub hξ
      rw [← iteratedFDerivWithin_of_isOpen k hopen hξ0]
      refine (norm_iteratedFDerivWithin_mul_le (hq.of_le (by exact_mod_cast le_top))
        hm.contDiffOn hopen.uniqueDiffOn hξ0 (n := k) (by exact_mod_cast hk)).trans ?_
      calc ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * ‖iteratedFDerivWithin ℝ i q {0}ᶜ ξ‖ *
            ‖iteratedFDerivWithin ℝ (k - i) m {0}ᶜ ξ‖
          ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * Bq * ((n : ℝ) ^ ν * Nm) := by
            refine Finset.sum_le_sum fun i hi => ?_
            have hi' : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
            rw [iteratedFDerivWithin_of_isOpen i hopen hξ0,
              iteratedFDerivWithin_of_isOpen (k - i) hopen hξ0]
            gcongr
            · exact hCB i (by omega) ξ hξ
            · exact norm_iteratedFDeriv_le_normM α hα hn hm (by omega) hξ
        _ = (2 : ℝ) ^ k * Bq * ((n : ℝ) ^ ν * Nm) := by
            rw [← Finset.sum_mul, ← Finset.sum_mul]
            congr 2
            exact_mod_cast Nat.sum_range_choose k
        _ ≤ _ := by
            have : (2 : ℝ) ^ k ≤ 2 ^ ν := pow_le_pow_right₀ (by norm_num) hk
            have : 0 ≤ Bq * ((n : ℝ) ^ ν * Nm) := by positivity
            nlinarith)
  exact ENNReal.toReal_le_of_le_ofReal (by positivity) h

/-! ### The homogeneous partition subordinate to the reflected cones (texline~275–276) -/

/-- The index set: a reflection `s` and a nonzero `r`. -/
def coneIdx (n : ℕ) : Finset ((Fin n → Bool) × (Fin n → Fin 2)) :=
  Finset.univ.filter fun p => p.2 ≠ 0

/-- The reflected multipliers `θ_r(S_s ξ)`. -/
def thetaS (α : Fin n → ℕ) (p : (Fin n → Bool) × (Fin n → Fin 2)) (ξ : Rn n) : ℝ :=
  thetaR α p.2 (refl p.1 ξ)

/-- `D(ξ) = ∑_{s, r ≠ 0} θ_r(S_s ξ)²`. -/
def Dsum (α : Fin n → ℕ) (ξ : Rn n) : ℝ := ∑ p ∈ coneIdx n, thetaS α p ξ ^ 2

/-- The partition functions `q_{s,r} = θ_r(S_s ·) / D`. -/
def qPart (α : Fin n → ℕ) (p : (Fin n → Bool) × (Fin n → Fin 2)) (ξ : Rn n) : ℂ :=
  ((thetaS α p ξ / Dsum α ξ : ℝ) : ℂ)

theorem refl_ne_zero {s : Fin n → Bool} {ξ : Rn n} (hξ : ξ ≠ 0) : refl s ξ ≠ 0 := by
  intro h
  apply hξ
  have : refl s (refl s ξ) = refl s 0 := congrArg (refl s) h
  rwa [refl_refl, map_zero] at this

theorem Dsum_lower (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) :
    ∃ ε₀ > 0, ∀ ξ : Rn n, ξ ≠ 0 → ε₀ ^ 2 ≤ Dsum α ξ := by
  obtain ⟨ε₀, hε₀, hcones, hcov⟩ := lemma_3_3_cones α hα
  refine ⟨ε₀, hε₀, fun ξ hξ => ?_⟩
  obtain ⟨s, hs⟩ := exists_refl_nonpos ξ
  have hSξ := refl_ne_zero (s := s) hξ
  obtain ⟨r, hr, hmem⟩ := hcov (refl s ξ) hSξ fun i =>
    (hs i).trans (by have := rho_nonneg α (refl s ξ); positivity)
  have hθ := (hcones r hr).2 _ hmem
  have hp : (s, r) ∈ coneIdx n := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hr⟩
  calc ε₀ ^ 2 ≤ thetaS α (s, r) ξ ^ 2 := by
        unfold thetaS; exact pow_le_pow_left₀ hε₀.le hθ.le 2
    _ ≤ Dsum α ξ := Finset.single_le_sum (f := fun p => thetaS α p ξ ^ 2)
        (fun p _ => sq_nonneg _) hp

theorem contDiffAt_thetaS (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i)
    {p : (Fin n → Bool) × (Fin n → Fin 2)} (hp : p ∈ coneIdx n) {ξ : Rn n} (hξ : ξ ≠ 0) :
    ContDiffAt ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (thetaS α p) ξ := by
  have hr : p.2 ≠ 0 := (Finset.mem_filter.mp hp).2
  exact (contDiffAt_thetaR α hα hr (refl_ne_zero hξ)).comp ξ
    (refl p.1).toContinuousLinearEquiv.contDiff.contDiffAt

theorem contDiffAt_Dsum (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {ξ : Rn n} (hξ : ξ ≠ 0) :
    ContDiffAt ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (Dsum α) ξ := by
  have : Dsum α = fun ξ => ∑ p ∈ coneIdx n, thetaS α p ξ ^ 2 := rfl
  rw [this]
  exact ContDiffAt.sum fun p hp => (contDiffAt_thetaS α hα hp hξ).pow 2

theorem contDiffOn_qPart (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i)
    {p : (Fin n → Bool) × (Fin n → Fin 2)} (hp : p ∈ coneIdx n) :
    ContDiffOn ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (qPart α p) {0}ᶜ := by
  obtain ⟨ε₀, hε₀, hD⟩ := Dsum_lower α hα
  intro ξ hξ
  have hξ' : ξ ≠ 0 := hξ
  have hD0 : Dsum α ξ ≠ 0 := (lt_of_lt_of_le (by positivity) (hD ξ hξ')).ne'
  have h := ((contDiffAt_thetaS α hα hp hξ').div (contDiffAt_Dsum α hα hξ') hD0)
  exact (Complex.ofRealCLM.contDiff.contDiffAt.comp ξ h).contDiffWithinAt

theorem thetaS_dil (α : Fin n → ℕ) (p : (Fin n → Bool) × (Fin n → Fin 2)) (ξ : Rn n) {t : ℝ}
    (ht : 0 < t) : thetaS α p (dil α t ξ) = thetaS α p ξ := by
  unfold thetaS
  rw [← dil_refl, thetaR_dil α p.2 _ ht]

theorem qPart_dil (α : Fin n → ℕ) (p : (Fin n → Bool) × (Fin n → Fin 2)) (ξ : Rn n) {t : ℝ}
    (ht : 0 < t) : qPart α p (dil α t ξ) = qPart α p ξ := by
  unfold qPart Dsum
  simp only [thetaS_dil α _ ξ ht]

theorem sum_thetaS_qPart (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {ξ : Rn n} (hξ : ξ ≠ 0) :
    ∑ p ∈ coneIdx n, (thetaS α p ξ : ℂ) * qPart α p ξ = 1 := by
  obtain ⟨ε₀, hε₀, hD⟩ := Dsum_lower α hα
  have hD0 : Dsum α ξ ≠ 0 := (lt_of_lt_of_le (by positivity) (hD ξ hξ)).ne'
  unfold qPart
  push_cast
  have hD0' : (Dsum α ξ : ℂ) ≠ 0 := by exact_mod_cast hD0
  have e : ∀ p ∈ coneIdx n, (thetaS α p ξ : ℂ) * ((thetaS α p ξ : ℂ) / (Dsum α ξ : ℂ)) =
      (thetaS α p ξ : ℂ) ^ 2 / (Dsum α ξ : ℂ) := fun p _ => by ring
  rw [Finset.sum_congr rfl e, ← Finset.sum_div, div_eq_one_iff_eq hD0']
  unfold Dsum
  push_cast
  rfl

theorem ClassM.qPart_mul (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {ν : ℕ} {m : Rn n → ℂ}
    (hm : ClassM α ν m) {p : (Fin n → Bool) × (Fin n → Fin 2)} (hp : p ∈ coneIdx n) :
    ClassM α ν (fun ξ => qPart α p ξ * m ξ) := by
  obtain ⟨Bq, _, hBq⟩ := bounded_of_homogeneous α hα
    ((contDiffOn_qPart α hα hp).continuousOn) (fun ξ _ t ht => qPart_dil α p ξ ht)
  obtain ⟨Bm, _, hBm⟩ := hm.bounded'
  refine ⟨⟨Bq * Bm, fun ξ => ?_⟩, ?_, fun ξ hξ t ht => ?_⟩
  · rw [norm_mul]
    exact mul_le_mul (hBq ξ) (hBm ξ) (norm_nonneg _) ((norm_nonneg _).trans (hBq ξ))
  · exact ((contDiffOn_qPart α hα hp).of_le (by exact_mod_cast le_top)).mul hm.contDiffOn
  · simp only [qPart_dil α p ξ ht, hm.homogeneous ξ hξ t ht]

/-! ### Proof of Theorem 1.1 -/

theorem ae_ne_point (hn : 0 < n) (N₀ : Rn n) : ∀ᵐ ξ ∂(volume : Measure (Rn n)), ξ ≠ N₀ := by
  rw [ae_iff]
  simp only [ne_eq, not_not]
  refine measure_mono_null (fun ξ (h : ξ = N₀) => ?_) (volume_coord_eq ⟨0, hn⟩ (N₀ ⟨0, hn⟩))
  simp [h]

/-- Sublinearity of the Carleson operator in the multiplier (texline~277). -/
theorem carleson_le_sum (hn : 0 < n) {ι : Type*} (s : Finset ι) (P : ι → Rn n → ℂ)
    (m : Rn n → ℂ) (hP : ∀ i ∈ s, ∃ B, ∀ ξ, ‖P i ξ‖ ≤ B) (hPm : ∀ i ∈ s, Measurable (P i))
    (hsum : ∀ ξ, ξ ≠ 0 → m ξ = ∑ i ∈ s, P i ξ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    carleson m f x ≤ ∑ i ∈ s, carleson (P i) f x := by
  unfold carleson
  refine iSup_le fun N => ?_
  have hint : ∀ i ∈ s, Integrable fun ξ => fhat f ξ *
      Complex.exp (Complex.I * (⟪x, ξ⟫_ℝ : ℂ)) * P i (ξ - N) := by
    intro i hi
    obtain ⟨B, hB⟩ := hP i hi
    refine ((integrable_fhat_schwartz f).norm.mul_const B).mono'
      ((((continuous_fhat_schwartz f).mul (by fun_prop)).measurable.mul
        ((hPm i hi).comp (measurable_id.sub_const N))).aestronglyMeasurable)
      (Filter.Eventually.of_forall fun ξ => ?_)
    rw [norm_mul, norm_mul, mul_comm Complex.I, Complex.norm_exp_ofReal_mul_I, mul_one]
    exact mul_le_mul_of_nonneg_left (hB _) (norm_nonneg _)
  have e : ∫ ξ, fhat f ξ * Complex.exp (Complex.I * (⟪x, ξ⟫_ℝ : ℂ)) * m (ξ - N) =
      ∑ i ∈ s, ∫ ξ, fhat f ξ * Complex.exp (Complex.I * (⟪x, ξ⟫_ℝ : ℂ)) * P i (ξ - N) := by
    rw [← integral_finsetSum _ hint]
    refine integral_congr_ae ?_
    filter_upwards [ae_ne_point hn N] with ξ hξ
    rw [hsum _ (sub_ne_zero.mpr hξ), Finset.mul_sum]
  rw [e]
  refine (enorm_sum_le _ _).trans (Finset.sum_le_sum fun i _ => ?_)
  exact le_iSup (fun N => ‖∫ ξ, fhat f ξ * Complex.exp (Complex.I * (⟪x, ξ⟫_ℝ : ℂ)) *
    P i (ξ - N)‖ₑ) N

/-- The level sets of `𝒞_P f` and of `𝒞_{P ∘ S}(f ∘ S)` have the same measure. -/
theorem volume_carleson_refl (s : Fin n → Bool) (P : Rn n → ℂ) (f : Rn n → ℂ) (τ : ℝ≥0∞) :
    volume {x | τ < carleson P f x} = volume {y | τ < carleson (P ∘ refl s) (f ∘ refl s) y} := by
  have hset : {x | τ < carleson P f x} =
      refl s ⁻¹' {y | τ < carleson (P ∘ refl s) (f ∘ refl s) y} := by
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_preimage]
    have h := carleson_comp_refl s (P ∘ refl s) (f ∘ refl s) x
    have e1 : (P ∘ refl s) ∘ refl s = P := funext fun ξ => by simp [refl_refl]
    have e2 : (f ∘ refl s) ∘ refl s = f := funext fun ξ => by simp [refl_refl]
    rw [e1, e2] at h
    rw [h]
  rw [hset]
  have hmp : MeasurePreserving ((refl s).toHomeomorph.toMeasurableEquiv) volume volume :=
    (refl s).measurePreserving
  exact hmp.measure_preimage_equiv _

/-- **Theorem 1.1** (paper, (1.2), texline~69): for `ν₀ ≥ 3|α| + 2` there is `C`, depending only
on `α` and `ν₀`, such that for all `m ∈ 𝓜^{ν₀}`, all Schwartz functions `f` and all `t > 0`,
`t |{x : 𝒞_m f(x) > t}|^{1/2} ≤ C ‖m‖_{𝓜^{ν₀}} ‖f‖₂`, i.e. `‖𝒞_m f‖_{L^{2,∞}} ≤ C ‖m‖_{𝓜^{ν₀}}
    ‖f‖₂`.
(The normalization `α₁ = 1` of the paper is not needed.) -/
theorem thm_1_1 (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) (hn : 0 < n) (ν₀ : ℕ)
    (hν₀ : 3 * absA α + 2 ≤ ν₀) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (m : Rn n → ℂ), ClassM α ν₀ m → ∀ (f : 𝓢(Rn n, ℂ)) (t : ℝ), 0 < t →
      ENNReal.ofReal t * volume {x | ENNReal.ofReal t < carleson m f x} ^ (1 / 2 : ℝ) ≤
        ENNReal.ofReal (C * (normM α ν₀ m).toReal * (eLpNorm (f : Rn n → ℂ) 2 volume).toReal) := by
  classical
  -- constants for each cone
  have hCr : ∀ r : Fin n → Fin 2, ∃ C : ℝ, 0 ≤ C ∧ (r ≠ 0 → ∀ (m : Rn n → ℂ), ClassM α ν₀ m →
      ∀ (f : 𝓢(Rn n, ℂ)) (t : ℝ), 0 < t →
      volume {x | ENNReal.ofReal t < carleson (fun ξ => (thetaR α r ξ : ℂ) * m ξ) f x} ≤
        ENNReal.ofReal ((C * (normM α ν₀ m).toReal * (eLpNorm (f : Rn n → ℂ) 2 volume).toReal /
          t) ^ 2)) := by
    intro r
    by_cases hr : r = 0
    · exact ⟨0, le_rfl, fun h => absurd hr h⟩
    · obtain ⟨C, hC, h⟩ := carleson_theta_weak α hα hn hr ν₀ hν₀
      exact ⟨C, hC, fun _ => h⟩
  choose Cθ hCθ0 hCθ using hCr
  have hCq : ∀ p : (Fin n → Bool) × (Fin n → Fin 2), ∃ Cq : ℝ, 0 ≤ Cq ∧ (p ∈ coneIdx n →
      ∀ m : Rn n → ℂ, ClassM α ν₀ m →
        (normM α ν₀ (fun ξ => qPart α p ξ * m ξ)).toReal ≤ Cq * (normM α ν₀ m).toReal) := by
    intro p
    by_cases hp : p ∈ coneIdx n
    · obtain ⟨Cq, hCq, h⟩ := normM_mul_le α hα hn ν₀ (contDiffOn_qPart α hα hp)
      exact ⟨Cq, hCq, fun _ => h⟩
    · exact ⟨0, le_rfl, fun h => absurd h hp⟩
  choose Cq hCq0 hCq using hCq
  set J : ℕ := (coneIdx n).card
  have hJ : 0 < J := by
    refine Finset.card_pos.mpr ⟨(fun _ => false, fun _ => 1), ?_⟩
    refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, fun h => ?_⟩
    have := congrFun h ⟨0, hn⟩
    simp at this
  set K : ℝ := ∑ p ∈ coneIdx n, Cθ p.2 * ((n : ℝ) ^ ν₀ * Cq p)
  have hK : 0 ≤ K := Finset.sum_nonneg fun p _ => by
    have := hCθ0 p.2; have := hCq0 p; positivity
  refine ⟨Real.sqrt J * J * K, by positivity, fun m hm f t ht => ?_⟩
  set Nm := (normM α ν₀ m).toReal
  have hNm : 0 ≤ Nm := ENNReal.toReal_nonneg
  set Ff := (eLpNorm (f : Rn n → ℂ) 2 volume).toReal
  have hFf : 0 ≤ Ff := ENNReal.toReal_nonneg
  -- the pieces
  set P : (Fin n → Bool) × (Fin n → Fin 2) → Rn n → ℂ := fun p ξ =>
    (thetaS α p ξ : ℂ) * (qPart α p ξ * m ξ)
  have hPb : ∀ p ∈ coneIdx n, ∃ B, ∀ ξ, ‖P p ξ‖ ≤ B := by
    intro p hp
    have hr : p.2 ≠ 0 := (Finset.mem_filter.mp hp).2
    obtain ⟨Bθ, _, hBθ⟩ := bounded_of_homogeneous α hα (continuousOn_thetaR α hα hr)
      (fun ξ _ t ht => by simp only [thetaR_dil α p.2 ξ ht])
    obtain ⟨Bm, _, hBm⟩ := (hm.qPart_mul α hα hp).bounded'
    refine ⟨Bθ * Bm, fun ξ => ?_⟩
    rw [norm_mul]
    exact mul_le_mul (by simpa [thetaS] using hBθ (refl p.1 ξ)) (hBm ξ) (norm_nonneg _)
      (by linarith [hBθ 0, norm_nonneg ((thetaR α p.2 0 : ℂ))])
  have hPm : ∀ p ∈ coneIdx n, Measurable (P p) := by
    intro p hp
    have h1 : ContinuousOn (fun ξ => (thetaS α p ξ : ℂ)) {0}ᶜ := fun ξ hξ =>
      (Complex.continuous_ofReal.continuousAt.comp
        (contDiffAt_thetaS α hα hp hξ).continuousAt).continuousWithinAt
    exact measurable_of_continuousOn_compl_singleton 0
      (h1.mul ((hm.qPart_mul α hα hp).contDiffOn.continuousOn))
  have hsum : ∀ ξ, ξ ≠ 0 → m ξ = ∑ p ∈ coneIdx n, P p ξ := by
    intro ξ hξ
    have h := sum_thetaS_qPart α hα hξ
    calc m ξ = (∑ p ∈ coneIdx n, (thetaS α p ξ : ℂ) * qPart α p ξ) * m ξ := by rw [h, one_mul]
      _ = _ := by rw [Finset.sum_mul]; exact Finset.sum_congr rfl fun p _ => by ring
  -- weak bound for each piece
  have hpiece : ∀ p ∈ coneIdx n, volume {x | ENNReal.ofReal (t / J) < carleson (P p) f x} ≤
      ENNReal.ofReal ((Cθ p.2 * ((n : ℝ) ^ ν₀ * Cq p) * Nm * Ff / (t / J)) ^ 2) := by
    intro p hp
    have hr : p.2 ≠ 0 := (Finset.mem_filter.mp hp).2
    set m'' := (fun ξ => qPart α p ξ * m ξ) ∘ refl p.1
    have hm'' : ClassM α ν₀ m'' := (hm.qPart_mul α hα hp).comp_refl p.1
    have e : P p ∘ refl p.1 = fun ξ => (thetaR α p.2 ξ : ℂ) * m'' ξ := by
      funext ξ; simp [P, m'', thetaS, refl_refl]
    rw [volume_carleson_refl p.1, e, ← coe_schwartzRefl]
    refine (hCθ p.2 hr m'' hm'' (schwartzRefl p.1 f) (t / J) (by positivity)).trans ?_
    rw [eLpNorm_schwartzRefl]
    refine ENNReal.ofReal_le_ofReal (pow_le_pow_left₀ (by have := hCθ0 p.2; positivity) ?_ 2)
    refine div_le_div_of_nonneg_right ?_ (by positivity)
    have h1 : (normM α ν₀ m'').toReal ≤ (n : ℝ) ^ ν₀ * (Cq p * Nm) :=
      (normM_comp_refl_le α hα hn (hm.qPart_mul α hα hp) p.1).trans
        (mul_le_mul_of_nonneg_left (hCq p hp m hm) (by positivity))
    have := hCθ0 p.2
    calc Cθ p.2 * (normM α ν₀ m'').toReal * Ff ≤ Cθ p.2 * ((n : ℝ) ^ ν₀ * (Cq p * Nm)) * Ff := by
          gcongr
      _ = _ := by ring
  -- the union bound
  have hsub : {x | ENNReal.ofReal t < carleson m f x} ⊆
      ⋃ p ∈ coneIdx n, {x | ENNReal.ofReal (t / J) < carleson (P p) f x} := by
    intro x hx
    simp only [Set.mem_ofPred_eq] at hx
    by_contra hcon
    simp only [Set.mem_iUnion, Set.mem_ofPred_eq, not_exists, not_lt] at hcon
    have h1 := carleson_le_sum hn (coneIdx n) P m hPb hPm hsum f x
    have h2 : ∑ p ∈ coneIdx n, carleson (P p) f x ≤ ∑ _p ∈ coneIdx n, ENNReal.ofReal (t / J) :=
      Finset.sum_le_sum fun p hp => hcon p hp
    rw [Finset.sum_const, nsmul_eq_mul] at h2
    have h3 : (J : ℝ≥0∞) * ENNReal.ofReal (t / J) = ENNReal.ofReal t := by
      rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity)]
      congr 1
      field_simp
    rw [h3] at h2
    exact absurd (h1.trans h2) (not_le.mpr hx)
  have hvol : volume {x | ENNReal.ofReal t < carleson m f x} ≤
      ENNReal.ofReal ((Real.sqrt J * J * K * Nm * Ff / t) ^ 2) := by
    refine (measure_mono hsub).trans ((measure_biUnion_finset_le _ _).trans ?_)
    refine (Finset.sum_le_sum hpiece).trans ?_
    rw [← ENNReal.ofReal_sum_of_nonneg (fun p _ => by positivity)]
    refine ENNReal.ofReal_le_ofReal ?_
    have hterm : ∀ p ∈ coneIdx n, (Cθ p.2 * ((n : ℝ) ^ ν₀ * Cq p) * Nm * Ff / (t / J)) ^ 2 ≤
        (K * Nm * Ff * J / t) ^ 2 := by
      intro p hp
      refine pow_le_pow_left₀ (by have := hCθ0 p.2; have := hCq0 p; positivity) ?_ 2
      rw [div_div_eq_mul_div]
      refine div_le_div_of_nonneg_right ?_ ht.le
      have hle : Cθ p.2 * ((n : ℝ) ^ ν₀ * Cq p) ≤ K :=
        Finset.single_le_sum (f := fun p => Cθ p.2 * ((n : ℝ) ^ ν₀ * Cq p))
          (fun p _ => by have := hCθ0 p.2; have := hCq0 p; positivity) hp
      have : 0 ≤ Nm * Ff * J := by positivity
      nlinarith
    calc ∑ p ∈ coneIdx n, (Cθ p.2 * ((n : ℝ) ^ ν₀ * Cq p) * Nm * Ff / (t / J)) ^ 2
        ≤ ∑ _p ∈ coneIdx n, (K * Nm * Ff * J / t) ^ 2 := Finset.sum_le_sum hterm
      _ = J * (K * Nm * Ff * J / t) ^ 2 := by rw [Finset.sum_const, nsmul_eq_mul]
      _ = (Real.sqrt J * J * K * Nm * Ff / t) ^ 2 := by
          have hs : Real.sqrt (J : ℝ) ^ 2 = J := Real.sq_sqrt (by positivity)
          calc (J : ℝ) * (K * Nm * Ff * J / t) ^ 2 =
              Real.sqrt (J : ℝ) ^ 2 * (K * Nm * Ff * J / t) ^ 2 := by rw [hs]
            _ = _ := by ring
  -- conclusion
  have hroot : volume {x | ENNReal.ofReal t < carleson m f x} ^ (1 / 2 : ℝ) ≤
      ENNReal.ofReal (Real.sqrt J * J * K * Nm * Ff / t) := by
    refine (ENNReal.rpow_le_rpow hvol (by norm_num)).trans (le_of_eq ?_)
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num), ← Real.sqrt_eq_rpow,
      Real.sqrt_sq (by positivity)]
  calc ENNReal.ofReal t * volume {x | ENNReal.ofReal t < carleson m f x} ^ (1 / 2 : ℝ)
      ≤ ENNReal.ofReal t * ENNReal.ofReal (Real.sqrt J * J * K * Nm * Ff / t) :=
        mul_le_mul' le_rfl hroot
    _ = _ := by
        rw [← ENNReal.ofReal_mul ht.le]
        congr 1
        field_simp

section

open scoped CarlesonLT FourierTransform

/-! ### Theorem 1.1 in the formulation of `LeanPool/CarlesonLT/Defs.lean` -/

theorem anisoNorm_eq_rho (α : Fin n → ℕ) (x : ℝ^n) : CarlesonLT.anisoNorm α x = rho α x := by
  unfold CarlesonLT.anisoNorm rho rhoNN
  rw [Finset.sup_univ_eq_ciSup, NNReal.coe_iSup]
  congr 1

theorem multiplierNorm_eq_normM (α : Fin n → ℕ) (ν : ℕ) (m : ℝ^n → ℂ) :
    CarlesonLT.multiplierNorm α ν m = normM α ν m := by
  unfold CarlesonLT.multiplierNorm normM iterPartial
  simp_rw [anisoNorm_eq_rho]

theorem classM_of_multiplierClass' {α : Fin n → ℕ} {ν : ℕ} {m : ℝ^n → ℂ}
    (h : CarlesonLT.MultiplierClass α ν m) : ClassM α ν m :=
  ⟨h.bounded, h.contDiffOn, h.homogeneous⟩

/-- The rescaling `x ↦ c • x` as a continuous linear equivalence. -/
def smulCLE (c : ℝ) (hc : c ≠ 0) : ℝ^n ≃L[ℝ] ℝ^n :=
  (LinearEquiv.smulOfNeZero ℝ (ℝ^n) c hc).toContinuousLinearEquiv

@[simp] theorem smulCLE_apply (c : ℝ) (hc : c ≠ 0) (x : ℝ^n) : smulCLE c hc x = c • x := rfl

theorem ClassM.comp_smul {α : Fin n → ℕ} {ν : ℕ} {m : ℝ^n → ℂ} (hm : ClassM α ν m) {c : ℝ}
    (hc : 0 < c) : ClassM α ν (fun ξ => m (c • ξ)) := by
  obtain ⟨C, hC⟩ := hm.bounded
  refine ⟨⟨C, fun ξ => hC _⟩, ?_, fun ξ hξ t ht => ?_⟩
  · refine hm.contDiffOn.comp (smulCLE c hc.ne').contDiff.contDiffOn fun ξ hξ h0 => hξ ?_
    simpa [smul_eq_zero, hc.ne'] using h0
  · have e : c • dil α t ξ = dil α t (c • ξ) := by
      ext i; simp only [dil, PiLp.toLp_apply, PiLp.smul_apply, smul_eq_mul]; ring
    simp only [e]
    exact hm.homogeneous _ (smul_ne_zero hc.ne' hξ) t ht

theorem rho_smul_ge (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) {c : ℝ} (hc : 0 < c) (hc1 : c ≤ 1)
    (x : ℝ^n) : c * rho α x ≤ rho α (c • x) := by
  rcases (rho_nonneg α x).eq_or_lt with h0 | hpos
  · rw [← h0, mul_zero]; exact rho_nonneg α _
  obtain ⟨j, hj⟩ := exists_coord_eq_rho α hα hpos
  have hαj : (0 : ℝ) < α j := by have := hα j; positivity
  have h1 := coord_rpow_le_rhoNN α (c • x) j
  have h2 : ((‖(c • x) j‖₊ ^ ((α j : ℝ)⁻¹) : ℝ≥0) : ℝ) = c ^ ((α j : ℝ)⁻¹) * rho α x := by
    rw [NNReal.coe_rpow, coe_nnnorm, PiLp.smul_apply, smul_eq_mul, Real.norm_eq_abs, abs_mul,
      abs_of_pos hc, Real.mul_rpow hc.le (abs_nonneg _), hj, ← Real.rpow_natCast,
      ← Real.rpow_mul (rho_nonneg α x), mul_inv_cancel₀ hαj.ne', Real.rpow_one]
  have h3 : c ≤ c ^ ((α j : ℝ)⁻¹) := by
    calc c = c ^ (1 : ℝ) := (Real.rpow_one c).symm
      _ ≤ c ^ ((α j : ℝ)⁻¹) := Real.rpow_le_rpow_of_exponent_ge hc hc1
          (inv_le_one_of_one_le₀ (by exact_mod_cast hα j))
  have h4 : (c ^ ((α j : ℝ)⁻¹) * rho α x : ℝ) ≤ rho α (c • x) := by
    rw [← h2]; exact_mod_cast h1
  calc c * rho α x ≤ c ^ ((α j : ℝ)⁻¹) * rho α x := mul_le_mul_of_nonneg_right h3 hpos.le
    _ ≤ _ := h4

/-- `‖m(c ·)‖_{𝓜^ν} ≤ n^ν c^{-ν|α|} ‖m‖_{𝓜^ν}` for `0 < c ≤ 1`. -/
theorem normM_comp_smul_le (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) (hn : 0 < n) {ν : ℕ}
    {m : ℝ^n → ℂ} (hm : ClassM α ν m) {c : ℝ} (hc : 0 < c) (hc1 : c ≤ 1) :
    (normM α ν (fun ξ => m (c • ξ))).toReal ≤
      (n : ℝ) ^ ν * c ^ (-((ν * absA α : ℕ) : ℝ)) * (normM α ν m).toReal := by
  set Nm := (normM α ν m).toReal
  have hNm : 0 ≤ Nm := ENNReal.toReal_nonneg
  have htop := (normM_lt_top α hα hm).ne
  refine ENNReal.toReal_le_of_le_ofReal (by positivity) (normM_le_of_iteratedFDeriv α ν _ ?_)
  intro k hk ξ hξ
  have hcomp : iteratedFDeriv ℝ k (fun ξ => m (c • ξ)) ξ =
      (iteratedFDeriv ℝ k m (c • ξ)).compContinuousLinearMap
        fun _ => ((smulCLE (n := n) c hc.ne' : ℝ^n ≃L[ℝ] ℝ^n) : ℝ^n →L[ℝ] ℝ^n) := by
    have := (smulCLE (n := n) c hc.ne').iteratedFDerivWithin_comp_right m uniqueDiffOn_univ
      (Set.mem_univ (smulCLE c hc.ne' ξ)) k
    rw [Set.preimage_univ, iteratedFDerivWithin_univ, iteratedFDerivWithin_univ] at this
    exact this
  have hg : ‖(smulCLE (n := n) c hc.ne' : ℝ^n →L[ℝ] ℝ^n)‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun x => ?_
    simp only [ContinuousLinearEquiv.coe_coe, smulCLE_apply, norm_smul, Real.norm_eq_abs,
      abs_of_pos hc, one_mul]
    exact mul_le_of_le_one_left (norm_nonneg _) hc1
  have hρ : c ≤ rho α (c • ξ) := by
    have := rho_smul_ge α hα hc hc1 ξ; rwa [hξ, mul_one] at this
  have hD := enorm_iteratedFDeriv_le α hα hm hk hc hc1 hρ
  rw [← ofReal_norm, ← ENNReal.ofReal_toReal htop, ← ENNReal.ofReal_mul (by positivity),
    ENNReal.ofReal_le_ofReal_iff (by positivity)] at hD
  rw [hcomp]
  refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
  have hprod : ∏ _i : Fin k, ‖(smulCLE (n := n) c hc.ne' : ℝ^n →L[ℝ] ℝ^n)‖ ≤ 1 :=
    by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]; exact pow_le_one₀
        (norm_nonneg _) hg
  have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hpow1 : (n : ℝ) ^ k ≤ (n : ℝ) ^ ν := pow_le_pow_right₀ hn1 hk
  have hpow2 : c ^ (-((k * absA α : ℕ) : ℝ)) ≤ c ^ (-((ν * absA α : ℕ) : ℝ)) := by
    refine Real.rpow_le_rpow_of_exponent_ge hc hc1 ?_
    have : (k * absA α : ℕ) ≤ ν * absA α := Nat.mul_le_mul_right _ hk
    have : ((k * absA α : ℕ) : ℝ) ≤ ((ν * absA α : ℕ) : ℝ) := by exact_mod_cast this
    linarith
  calc ‖iteratedFDeriv ℝ k m (c • ξ)‖ * ∏ _i : Fin k, ‖(smulCLE (n := n) c hc.ne' : ℝ^n →L[ℝ] ℝ^n)‖
      ≤ ‖iteratedFDeriv ℝ k m (c • ξ)‖ * 1 := mul_le_mul_of_nonneg_left hprod (norm_nonneg _)
    _ ≤ (n : ℝ) ^ k * c ^ (-((k * absA α : ℕ) : ℝ)) * Nm := by rw [mul_one]; exact hD
    _ ≤ _ := by gcongr

/-- Mathlib's Fourier normalization versus the paper's: `𝒞_m f ≤ 𝒞^{paper}_{m(·/2π)} f`. -/
theorem carlesonOperator_le (m : ℝ^n → ℂ) (f : ℝ^n → ℂ) (x : ℝ^n) :
    CarlesonLT.carlesonOperator m f x ≤
      carleson (fun ζ => m ((2 * π)⁻¹ • ζ)) f x := by
  refine iSup_le fun N => ?_
  have hπ : (0 : ℝ) < 2 * π := by positivity
  set F : ℝ^n → ℂ := fun ξ => 𝓕 f ξ * 𝐞 (⟪x, ξ⟫_ℝ) * m (ξ - N)
  have hsub := Measure.integral_comp_inv_smul (μ := (volume : Measure (ℝ^n))) F (2 * π)
  rw [abs_of_pos (by positivity), finrank_euclideanSpace_fin] at hsub
  have hG : ∀ ζ, F ((2 * π)⁻¹ • ζ) =
      fhat f ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ)) * m ((2 * π)⁻¹ • (ζ - (2 * π) • N)) := by
    intro ζ
    simp only [F]
    rw [smul_sub, smul_smul, inv_mul_cancel₀ hπ.ne', one_smul]
    congr 2
    · rw [Real.fourier_eq', fhat]
      congr 1; funext y
      rw [smul_eq_mul, inner_smul_right]
      congr 2; push_cast; field_simp
    · rw [Real.fourierChar_apply, inner_smul_right]
      congr 1; push_cast; field_simp
  simp_rw [hG] at hsub
  have hle : ‖∫ ξ, F ξ‖ₑ ≤ ‖∫ ζ, fhat f ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ)) *
      m ((2 * π)⁻¹ • (ζ - (2 * π) • N))‖ₑ := by
    rw [hsub, enorm_smul]
    refine le_trans (le_of_eq ?_) (le_mul_of_one_le_left bot_le ?_)
    · rfl
    · rw [← ofReal_norm, Real.norm_eq_abs, abs_of_pos (by positivity)]
      exact ENNReal.one_le_ofReal.mpr (one_le_pow₀ (by nlinarith [Real.pi_gt_three]))
  exact hle.trans (le_iSup (fun N' => ‖∫ ζ, fhat f ζ * Complex.exp (Complex.I * (⟪x, ζ⟫_ℝ : ℂ)) *
    m ((2 * π)⁻¹ • (ζ - N'))‖ₑ) ((2 * π) • N))

/-- **Theorem 1.1** (Roos, arXiv:1710.10962), in the formulation of
`LeanPool/CarlesonLT/Theorems.lean`. -/
theorem anisotropic_carleson (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) (hn : 0 < n) (ν₀ : ℕ)
    (hν₀ : 3 * (∑ i, α i) + 2 ≤ ν₀) :
      ∃ C : ℝ, 0 < C ∧ ∀ (m : ℝ^n → ℂ), CarlesonLT.MultiplierClass α ν₀ m → ∀ f : 𝓢(ℝ^n, ℂ),
        CarlesonLT.weakL2Norm volume (CarlesonLT.carlesonOperator m f) ≤
          ENNReal.ofReal C * (CarlesonLT.multiplierNorm α ν₀ m) * eLpNorm f 2 volume := by
  obtain ⟨C₀, hC₀, h⟩ := thm_1_1 α hα hn ν₀ hν₀
  set c : ℝ := (2 * π)⁻¹
  have hc : 0 < c := by positivity
  have hc1 : c ≤ 1 := inv_le_one_of_one_le₀ (by nlinarith [Real.pi_gt_three])
  set K : ℝ := (n : ℝ) ^ ν₀ * c ^ (-((ν₀ * absA α : ℕ) : ℝ))
  have hK : 0 ≤ K := by positivity
  refine ⟨C₀ * K + 1, by positivity, fun m hm f => ?_⟩
  have hmA := classM_of_multiplierClass' hm
  have hm' : ClassM α ν₀ (fun ζ => m (c • ζ)) := hmA.comp_smul hc
  have hnorm := normM_comp_smul_le α hα hn hmA hc hc1
  rw [multiplierNorm_eq_normM]
  set Nm := (normM α ν₀ m).toReal
  have hNm : 0 ≤ Nm := ENNReal.toReal_nonneg
  set Ff := (eLpNorm (f : ℝ^n → ℂ) 2 volume).toReal
  have hRHS : ENNReal.ofReal (C₀ * K + 1) * normM α ν₀ m * eLpNorm (f : ℝ^n → ℂ) 2 volume =
      ENNReal.ofReal ((C₀ * K + 1) * Nm * Ff) := by
    have hfin : eLpNorm (f : ℝ^n → ℂ) 2 volume ≠ ⊤ := (f.memLp 2).eLpNorm_ne_top
    rw [← ENNReal.ofReal_toReal (normM_lt_top α hα hmA).ne, ← ENNReal.ofReal_toReal hfin,
      ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
  rw [hRHS]
  refine iSup_le fun t => ?_
  rcases eq_or_ne t ⊤ with rfl | htop
  · have : {x | (⊤ : ℝ≥0∞) < CarlesonLT.carlesonOperator m f x} = ∅ := by
      ext x; simp
    rw [this, measure_empty, ENNReal.zero_rpow_of_pos (by norm_num), mul_zero]
    exact bot_le
  rcases eq_or_ne t 0 with rfl | h0
  · rw [zero_mul]; exact bot_le
  have htr : 0 < t.toReal := ENNReal.toReal_pos h0 htop
  have hset : {x | t < CarlesonLT.carlesonOperator m f x} ⊆
      {x | ENNReal.ofReal t.toReal < carleson (fun ζ => m (c • ζ)) f x} := by
    intro x hx
    rw [Set.mem_ofPred_eq, ENNReal.ofReal_toReal htop]
    exact lt_of_lt_of_le hx (carlesonOperator_le m f x)
  have hbound := h _ hm' f t.toReal htr
  rw [ENNReal.ofReal_toReal htop] at hbound
  refine (mul_le_mul' le_rfl (ENNReal.rpow_le_rpow (measure_mono hset) (by norm_num))).trans ?_
  rw [show (2⁻¹ : ℝ) = 1 / 2 by norm_num, ENNReal.ofReal_toReal htop]
  refine hbound.trans (ENNReal.ofReal_le_ofReal ?_)
  have h1 : (normM α ν₀ fun ζ => m (c • ζ)).toReal ≤ K * Nm := hnorm
  calc C₀ * (normM α ν₀ fun ζ => m (c • ζ)).toReal * Ff ≤ C₀ * (K * Nm) * Ff := by gcongr
    _ ≤ (C₀ * K + 1) * Nm * Ff := by nlinarith [mul_nonneg hNm (ENNReal.toReal_nonneg (a :=
        eLpNorm (f : ℝ^n → ℂ) 2 volume))]

end


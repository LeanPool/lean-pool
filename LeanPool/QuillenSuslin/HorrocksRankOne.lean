module

public import Mathlib.Algebra.Module.Projective
public import Mathlib.Algebra.Polynomial.Div
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic
public import Mathlib.RingTheory.Polynomial.Basic

import Mathlib.Algebra.Polynomial.FieldDivision
import Mathlib.Algebra.Polynomial.Lifts
import Mathlib.RingTheory.Finiteness.Nakayama
import Mathlib.RingTheory.Nakayama
import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# Monic polynomials over a local ring

Let `A` be a local ring with maximal ideal `m` and residue field `k`. This file collects the
ideal-theoretic facts behind Horrocks' theorem over `A`, each proved by Nakayama's lemma over `A`
applied to the free module `A[X]_{<N}` of polynomials of degree `< N`.

## Main results

* `eq_top_of_monic_mem_of_map_eq_one`: an ideal of `A[X]` containing a monic polynomial and a
  polynomial congruent to `1` modulo `m[X]` is the unit ideal; that is, the monic polynomials and
  `1 + m[X]` are comaximal (Lombardi–Quitté, Lemma XVI.4.4).
* `exists_monic_mem_map_eq`: if an ideal `b` of `A[X]` contains a monic polynomial and its image
  in `k[X]` is generated by a monic `h̄`, then `b` contains a monic lift of `h̄` (Lombardi–Quitté,
  Exercise XVI.4, item 1).
* `exists_monic_eq_span`: a finitely generated projective ideal of `A[X]` containing a monic
  polynomial is generated by a monic polynomial (Lombardi–Quitté, Exercise XVI.4); this is the
  rank one case of the local Horrocks theorem.

## References

* H. Lombardi, C. Quitté, *Commutative Algebra: Constructive Methods*, Springer, 2015.
-/

@[expose] public section

universe u

open Polynomial IsLocalRing

namespace LeanPool.QuillenSuslin

variable {A : Type u} [CommRing A] [IsLocalRing A]

/-- A polynomial of degree `< N` whose image in `k[X]` vanishes lies in `m • A[X]_{<N}`. -/
theorem mem_maximalIdeal_smul_degreeLT {N : ℕ} {x : A[X]} (hx : x ∈ degreeLT A N)
    (h0 : x.map (residue A) = 0) : x ∈ maximalIdeal A • degreeLT A N := by
  rw [x.as_sum_support_C_mul_X_pow]
  refine Submodule.sum_mem _ fun i hi => ?_
  rw [← smul_eq_C_mul]
  refine Submodule.smul_mem_smul ?_ ?_
  · rw [← residue_eq_zero_iff]
    simpa [coeff_map] using congrArg (fun p : (ResidueField A)[X] => p.coeff i) h0
  · rw [mem_degreeLT, degree_X_pow]
    exact (le_degree_of_mem_supp i hi).trans_lt (mem_degreeLT.mp hx)

omit [IsLocalRing A] in
/-- The polynomials of degree `< N` form a finitely generated `A`-module. -/
theorem fg_degreeLT (N : ℕ) : (degreeLT A N).FG := by
  have : Module.Finite A (degreeLT A N) := Module.Finite.equiv (degreeLTEquiv A N).symm
  exact Module.Finite.iff_fg.mp this

/-- Nakayama's lemma for `A[X]_{<N}`: if every polynomial of degree `< N` is congruent modulo
`m[X]` to a sum `v + w` with `v ∈ V`, `w ∈ W` and the difference of degree `< N`, then
`A[X]_{<N} ≤ V ⊔ W`. -/
theorem degreeLT_le_sup {N : ℕ} (V W : Submodule A A[X])
    (h : ∀ t ∈ degreeLT A N, ∃ v ∈ V, ∃ w ∈ W,
      t - v - w ∈ degreeLT A N ∧ (t - v - w).map (residue A) = 0) :
    degreeLT A N ≤ V ⊔ W := by
  refine Submodule.le_of_le_smul_of_le_jacobson (fg_degreeLT N)
    (ringJacobson_eq_maximalIdeal A).ge fun t ht => ?_
  obtain ⟨v, hv, w, hw, h1, h2⟩ := h t ht
  rw [show t = (v + w) + (t - v - w) by abel]
  exact Submodule.add_mem_sup (Submodule.add_mem_sup hv hw) (mem_maximalIdeal_smul_degreeLT h1 h2)

/-- The image in `k[X]` of a monic polynomial has the same degree. -/
theorem degree_map_residue_of_monic {g : A[X]} (hg : g.Monic) :
    (g.map (residue A)).degree = g.natDegree := by
  rw [degree_eq_natDegree (hg.map _).ne_zero, hg.natDegree_map]

/-- **Comaximality.** Over a local ring `A`, an ideal of `A[X]` containing a monic polynomial and
a polynomial congruent to `1` modulo `m[X]` is the unit ideal (Lombardi–Quitté, Lemma XVI.4.4). -/
theorem eq_top_of_monic_mem_of_map_eq_one {J : Ideal A[X]} {g u : A[X]} (hg : g.Monic)
    (hgJ : g ∈ J) (huJ : u ∈ J) (hu : u.map (residue A) = 1) : J = ⊤ := by
  rw [Ideal.eq_top_iff_one]
  rcases Nat.eq_zero_or_pos g.natDegree with h0 | hpos
  · rwa [← hg.natDegree_eq_zero.mp h0]
  have hgm : (g.map (residue A)).Monic := hg.map _
  have key := degreeLT_le_sup (N := g.natDegree) (J.restrictScalars A) ⊥ fun t ht => by
    refine ⟨(u * t) %ₘ g, ?_, 0, Submodule.zero_mem _, ?_, ?_⟩
    · rw [Submodule.restrictScalars_mem, modByMonic_eq_sub_mul_div _ g]
      exact J.sub_mem (J.mul_mem_right _ huJ) (J.mul_mem_right _ hgJ)
    · rw [sub_zero]
      refine Submodule.sub_mem _ ht (mem_degreeLT.mpr ?_)
      rw [← degree_eq_natDegree hg.ne_zero]
      exact degree_modByMonic_lt _ hg
    · have hdeg : (t.map (residue A)).degree < (g.map (residue A)).degree :=
        (degree_map_le).trans_lt (by rw [degree_map_residue_of_monic hg]; exact mem_degreeLT.mp ht)
      rw [sub_zero, Polynomial.map_sub, map_modByMonic _ hg, Polynomial.map_mul, hu, one_mul,
        (modByMonic_eq_self_iff hgm).mpr hdeg, sub_self]
  have h1 : (1 : A[X]) ∈ degreeLT A g.natDegree := by
    rw [mem_degreeLT, degree_one]
    exact_mod_cast hpos
  simpa using key h1

/-- If a monic `s` and an `h` lie in an ideal `b` of `A[X]`, the image `h̄` of `h` in `k[X]` is
monic, and `h̄` divides the image of every element of `b`, then `b` contains a monic polynomial
with image `h̄` (Lombardi–Quitté, Exercise XVI.4, item 1). -/
theorem exists_monic_mem_map_eq {b : Ideal A[X]} {s h : A[X]} (hs : s.Monic) (hsb : s ∈ b)
    (hhb : h ∈ b) (hh : (h.map (residue A)).Monic)
    (hdvd : ∀ x ∈ b, h.map (residue A) ∣ x.map (residue A)) :
    ∃ g ∈ b, g.Monic ∧ g.map (residue A) = h.map (residue A) := by
  set hb := h.map (residue A)
  set d := hb.natDegree
  have hsm : (s.map (residue A)).Monic := hs.map _
  have hdN : d ≤ s.natDegree := by
    have := natDegree_le_of_dvd (hdvd s hsb) hsm.ne_zero
    rwa [hs.natDegree_map] at this
  rcases hdN.lt_or_eq with hlt | heq
  swap
  · refine ⟨s, hsb, hs, eq_of_monic_of_dvd_of_natDegree_le hh hsm (hdvd s hsb) ?_⟩
    rw [hs.natDegree_map]
    exact heq.ge
  have hdb : hb.degree = d := degree_eq_natDegree hh.ne_zero
  have key := degreeLT_le_sup (N := s.natDegree) (b.restrictScalars A ⊓ degreeLT A s.natDegree)
    (degreeLT A d) fun t ht => by
    obtain ⟨q, hq⟩ := map_surjective (residue A) residue_surjective (t.map (residue A) /ₘ hb)
    obtain ⟨r, hr, hrdeg⟩ := exists_degree_eq_of_mem_lifts
      (mem_lifts_of_surjective residue_surjective (t.map (residue A) %ₘ hb))
    have hrd : r ∈ degreeLT A d := by
      rw [mem_degreeLT, hrdeg, ← hdb]
      exact degree_modByMonic_lt _ hh
    have hv : (h * q) %ₘ s ∈ degreeLT A s.natDegree := by
      rw [mem_degreeLT, ← degree_eq_natDegree hs.ne_zero]
      exact degree_modByMonic_lt _ hs
    refine ⟨(h * q) %ₘ s, ⟨?_, hv⟩, r, hrd, ?_, ?_⟩
    · change _ ∈ b
      rw [modByMonic_eq_sub_mul_div _ s]
      exact b.sub_mem (b.mul_mem_right _ hhb) (b.mul_mem_right _ hsb)
    · exact Submodule.sub_mem _ (Submodule.sub_mem _ ht hv) (degreeLT_mono hlt.le hrd)
    · have ht' : (t.map (residue A)).degree < s.natDegree :=
        degree_map_le.trans_lt (mem_degreeLT.mp ht)
      have hr' : (t.map (residue A) %ₘ hb).degree < s.natDegree :=
        (degree_modByMonic_lt _ hh).trans (by rw [hdb]; exact_mod_cast hlt)
      have hprod : hb * (t.map (residue A) /ₘ hb) =
          t.map (residue A) - t.map (residue A) %ₘ hb := by
        rw [modByMonic_eq_sub_mul_div _ hb]
        ring
      have hlt' : (hb * (t.map (residue A) /ₘ hb)).degree < (s.map (residue A)).degree := by
        rw [degree_map_residue_of_monic hs, hprod]
        exact (degree_sub_le _ _).trans_lt (max_lt ht' hr')
      rw [Polynomial.map_sub, Polynomial.map_sub, map_modByMonic _ hs, Polynomial.map_mul, hq, hr,
        (modByMonic_eq_self_iff hsm).mpr hlt', hprod]
      ring
  have hXd : (X ^ d : A[X]) ∈ degreeLT A s.natDegree := by
    rw [mem_degreeLT, degree_X_pow]
    exact_mod_cast hlt
  obtain ⟨v, ⟨hvb, -⟩, l, hl, hvl⟩ := Submodule.mem_sup.mp (key hXd)
  have hv : v = X ^ d - l := eq_sub_of_add_eq hvl
  have hmon : v.Monic := hv ▸ monic_X_pow_sub (mem_degreeLT.mp hl)
  refine ⟨v, hvb, hmon, eq_of_monic_of_dvd_of_natDegree_le hh (hmon.map _) (hdvd v hvb) ?_⟩
  rw [hmon.natDegree_map, hv]
  refine natDegree_le_of_degree_le ((degree_sub_le _ _).trans (max_le ?_ ?_))
  · rw [degree_X_pow]
  · exact (mem_degreeLT.mp hl).le

/-- A monic polynomial is a nonzerodivisor modulo `m[X]`. -/
theorem map_eq_zero_of_monic_mul {s q : A[X]} (hs : s.Monic)
    (h : (s * q).map (residue A) = 0) : q.map (residue A) = 0 := by
  rw [Polynomial.map_mul] at h
  exact (mul_eq_zero.mp h).resolve_left (hs.map _).ne_zero

/-- In a projective ideal `b` of `A[X]` containing a monic polynomial, an element of `b` lying in
`m[X]` lies in `m[X] • b`: the coordinates of a dual basis of `b` are multiplied into `m[X]`. -/
theorem mem_ker_smul_of_projective (b : Ideal A[X]) [Module.Projective A[X] b] {s : A[X]}
    (hs : s.Monic) (hsb : s ∈ b) {x : A[X]} (hxb : x ∈ b) (hx : x.map (residue A) = 0) :
    x ∈ RingHom.ker (mapRingHom (residue A)) • b := by
  obtain ⟨σ, hσ⟩ := Module.projective_def'.mp ‹Module.Projective A[X] b›
  have hx' : (⟨x, hxb⟩ : b) = Finsupp.linearCombination A[X] id (σ ⟨x, hxb⟩) :=
    (DFunLike.congr_fun hσ ⟨x, hxb⟩).symm
  have hcoef : ∀ p : b, σ ⟨x, hxb⟩ p ∈ RingHom.ker (mapRingHom (residue A)) := by
    intro p
    have hcomm : x • (⟨s, hsb⟩ : b) = s • (⟨x, hxb⟩ : b) :=
      Subtype.ext (by simp only [SetLike.val_smul, smul_eq_mul]; ring)
    have := congrArg (fun y => σ y p) hcomm
    simp only [map_smul, Finsupp.smul_apply, smul_eq_mul] at this
    rw [RingHom.mem_ker, coe_mapRingHom]
    refine map_eq_zero_of_monic_mul hs ?_
    rw [← this, Polynomial.map_mul, hx, zero_mul]
  rw [show x = (⟨x, hxb⟩ : b).1 from rfl, hx', Finsupp.linearCombination_apply, Finsupp.sum,
    Submodule.coe_sum]
  exact Submodule.sum_mem _ fun p _ => Submodule.smul_mem_smul (hcoef p) p.2

/-- **Rank one.** Over a local ring `A`, a finitely generated projective ideal of `A[X]`
containing a monic polynomial is generated by a monic polynomial (Lombardi–Quitté,
Exercise XVI.4). -/
theorem exists_monic_eq_span (b : Ideal A[X]) [Module.Projective A[X] b] (hb : b.FG) {s : A[X]}
    (hs : s.Monic) (hsb : s ∈ b) : ∃ g : A[X], g.Monic ∧ b = Ideal.span {g} := by
  classical
  set φ := mapRingHom (residue A)
  have hφ : Function.Surjective φ := map_surjective _ residue_surjective
  set I := RingHom.ker φ
  set b' := b.map φ
  set γ := Submodule.IsPrincipal.generator b'
  have hsb' : φ s ∈ b' := Ideal.mem_map_of_mem φ hsb
  have hγ0 : γ ≠ 0 := by
    intro h0
    rw [← Submodule.IsPrincipal.eq_bot_iff_generator_eq_zero] at h0
    rw [h0, Submodule.mem_bot] at hsb'
    exact (hs.map (residue A)).ne_zero hsb'
  set g0 := C γ.leadingCoeff⁻¹ * γ
  have hlc : γ.leadingCoeff ≠ 0 := leadingCoeff_ne_zero.mpr hγ0
  have hg0 : g0.Monic := monic_C_mul_of_mul_leadingCoeff_eq_one (inv_mul_cancel₀ hlc)
  have hg0mem : g0 ∈ b' := b'.mul_mem_left _ (Submodule.IsPrincipal.generator_mem b')
  have hdvd : ∀ x ∈ b, g0 ∣ φ x := by
    intro x hx
    refine dvd_trans ⟨C γ.leadingCoeff, ?_⟩
      ((Submodule.IsPrincipal.mem_iff_generator_dvd b').mp (Ideal.mem_map_of_mem φ hx))
    rw [mul_comm, ← mul_assoc, ← C_mul, mul_inv_cancel₀ hlc, C_1, one_mul]
  obtain ⟨h, hhb, hh⟩ := (Ideal.mem_map_iff_of_surjective φ hφ).mp hg0mem
  have hh' : h.map (residue A) = g0 := hh
  obtain ⟨g, hgb, hgm, hgmap⟩ := exists_monic_mem_map_eq hs hsb hhb (hh' ▸ hg0)
    (fun x hx => hh' ▸ hdvd x hx)
  refine ⟨g, hgm, le_antisymm ?_ ((Ideal.span_singleton_le_iff_mem _).mpr hgb)⟩
  have hle : ∀ x ∈ b, ∃ a ∈ Ideal.span {g}, x - a ∈ I • b := by
    intro x hx
    obtain ⟨c, hc⟩ := hdvd x hx
    obtain ⟨c', rfl⟩ := hφ c
    refine ⟨g * c', Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self g), ?_⟩
    refine mem_ker_smul_of_projective b hs hsb (b.sub_mem hx (b.mul_mem_right _ hgb)) ?_
    have hc' : x.map (residue A) = g0 * c'.map (residue A) := hc
    rw [Polynomial.map_sub, Polynomial.map_mul, hgmap, hh', hc', sub_self]
  obtain ⟨u, hu1, hub⟩ : ∃ u, u - 1 ∈ I ∧ ∀ x ∈ b, u * x ∈ Ideal.span {g} := by
    set Q := Submodule.map (Ideal.span {g}).mkQ b
    have hQ : Q ≤ I • Q := by
      rw [← Submodule.map_smul'']
      rintro _ ⟨x, hx, rfl⟩
      obtain ⟨a, ha, hxa⟩ := hle x hx
      refine ⟨x - a, hxa, ?_⟩
      simp only [map_sub, Submodule.mkQ_apply, sub_eq_self]
      exact (Submodule.Quotient.mk_eq_zero _).mpr ha
    obtain ⟨r, hr1, hr⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul I Q (Submodule.FG.map _ hb) hQ
    refine ⟨r, hr1, fun x hx => ?_⟩
    have := hr _ (Submodule.mem_map_of_mem hx)
    rwa [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, smul_eq_mul] at this
  have hu : u.map (residue A) = 1 := by
    have : φ (u - 1) = 0 := hu1
    rwa [map_sub, map_one, sub_eq_zero] at this
  have htop : Ideal.span {u, g} = ⊤ := eq_top_of_monic_mem_of_map_eq_one hgm
    (Ideal.subset_span (by simp)) (Ideal.subset_span (by simp)) hu
  obtain ⟨α, β, hαβ⟩ := Ideal.mem_span_pair.mp ((Ideal.eq_top_iff_one _).mp htop)
  intro x hx
  rw [← one_mul x, ← hαβ, add_mul, mul_assoc, mul_assoc]
  exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (hub x hx))
    (Ideal.mul_mem_left _ _ (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self g)))

end LeanPool.QuillenSuslin

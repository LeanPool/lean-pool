module

public import LeanPool.QuillenSuslin.MonicLocalization
public import Mathlib.RingTheory.Polynomial.Content

import Mathlib.RingTheory.Polynomial.GaussLemma
import Mathlib.RingTheory.PrincipalIdealDomainOfPrime

/-!
# Quillen's Lemma 2: `k⟨X⟩` is a principal ideal domain

For a principal ideal domain `k`, the localisation `k⟨X⟩` of `k[X]` at the monic polynomials is a
principal ideal domain (Quillen 1976, Lemma 2, p. 169).

The proof shows that every prime ideal `Q` of `k[X]` containing no monic polynomial is
principal. If `Q` contains a nonzero constant, then `Q ∩ k = (p)` for a prime `p` and
`Q = p k[X]`: a strictly larger prime would contain a polynomial that is nonzero modulo `p`,
which over the field `k ⧸ p` can be normalised to a monic polynomial, and a monic lift of it
lies in `Q`. Otherwise `Q` is zero or contains a prime element `π`, necessarily primitive, and
`Q = π k[X]` by Gauss's lemma, because the extension of `Q` to `Frac(k)[X]` is a proper prime
containing the irreducible `π`.

## Main results

* `isPrincipal_of_isPrime_of_disjoint`: a prime of `k[X]` with no monic element is principal.
* `isPrincipalIdealRing_monicLocalization`: `k⟨X⟩` is a principal ideal domain.

## References

* D. Quillen, *Projective modules over polynomial rings*, Invent. Math. 36 (1976), 167–171.
-/

@[expose] public section

universe u

open Polynomial

namespace LeanPool.QuillenSuslin

variable {k : Type u} [CommRing k] [IsDomain k] [IsPrincipalIdealRing k]

/-- If a prime ideal `Q` of `k[X]` contains `C p` for a nonzero prime `p` of the principal ideal
domain `k` and is strictly larger than `p k[X]`, then it contains a monic polynomial. -/
theorem exists_monic_mem_of_span_C_lt {p : k} (hp : Prime p) {Q : Ideal k[X]}
    (hpQ : C p ∈ Q) (hne : Q ≠ Ideal.span {C p}) : ∃ g ∈ Q, g.Monic := by
  classical
  have hle : Ideal.span {C p} ≤ Q := (Ideal.span_singleton_le_iff_mem _).mpr hpQ
  obtain ⟨g, hgQ, hgp⟩ : ∃ g ∈ Q, g ∉ Ideal.span {C p} := by
    by_contra! h
    exact hne (le_antisymm h hle)
  have hmax : (Ideal.span {p}).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible hp.irreducible
  let F := k ⧸ Ideal.span {p}
  let _ : Field F := Ideal.Quotient.field _
  let π : k →+* F := Ideal.Quotient.mk _
  have hker : (RingHom.ker (mapRingHom π)) = Ideal.span {C p} := by
    rw [ker_mapRingHom, Ideal.mk_ker, Ideal.map_span, Set.image_singleton]
  have hg0 : g.map π ≠ 0 := by
    intro h
    apply hgp
    rw [← hker]
    exact h
  set q := C (g.map π).leadingCoeff⁻¹ * g.map π with hq
  have hqm : q.Monic := monic_C_mul_of_mul_leadingCoeff_eq_one
    (inv_mul_cancel₀ (leadingCoeff_ne_zero.mpr hg0))
  obtain ⟨h, hh, -, hhm⟩ := lifts_and_degree_eq_and_monic
    (lifts_iff_coeff_lifts _ |>.mpr fun n => Ideal.Quotient.mk_surjective _) hqm
  obtain ⟨u, hu⟩ := Ideal.Quotient.mk_surjective (I := Ideal.span {p})
    (g.map π).leadingCoeff⁻¹
  refine ⟨h, ?_, hhm⟩
  have hdiff : h - C u * g ∈ Q := by
    apply hle
    rw [← hker, RingHom.mem_ker, map_sub, map_mul, coe_mapRingHom, Polynomial.map_C]
    change h.map (Ideal.Quotient.mk _) - C (Ideal.Quotient.mk _ u) * g.map π = 0
    rw [hh, hu, hq, sub_self]
  have := Q.add_mem hdiff (Q.mul_mem_left (C u) hgQ)
  rwa [sub_add_cancel] at this

omit [IsPrincipalIdealRing k] in
/-- A prime element of `k[X]` lying in a prime ideal that contains no nonzero constant is
primitive. -/
theorem isPrimitive_of_prime_mem {Q : Ideal k[X]} (hQ : ∀ c : k, C c ∈ Q → c = 0) {π : k[X]}
    (hπ : Prime π) (hπQ : π ∈ Q) : π.IsPrimitive := by
  intro r ⟨t, ht⟩
  rcases hπ.dvd_or_dvd (show π ∣ C r * t from ⟨1, by rw [mul_one, ← ht]⟩) with h | h
  · have hr : r = 0 := hQ r (Ideal.mem_of_dvd _ h hπQ)
    exact absurd (by rw [ht, hr, C_0, zero_mul]) hπ.ne_zero
  · obtain ⟨s, hs⟩ := h
    have h1 : π * (C r * s) = π * 1 := by
      calc π * (C r * s) = C r * (π * s) := by ring
        _ = π := by rw [← hs, ← ht]
        _ = π * 1 := (mul_one π).symm
    have := mul_left_cancel₀ hπ.ne_zero h1
    exact isUnit_C.mp (IsUnit.of_mul_eq_one _ this)

/-- If a prime ideal `Q` of `k[X]` contains no nonzero constant, then `Q` is generated by any
prime element it contains. -/
theorem eq_span_of_prime_mem {Q : Ideal k[X]} [hQp : Q.IsPrime]
    (hQ : ∀ c : k, C c ∈ Q → c = 0) {π : k[X]} (hπ : Prime π) (hπQ : π ∈ Q) :
    Q = Ideal.span {π} := by
  classical
  let K := FractionRing k
  have hprim := isPrimitive_of_prime_mem hQ hπ hπQ
  refine le_antisymm (fun a haQ => ?_) ((Ideal.span_singleton_le_iff_mem _).mpr hπQ)
  rw [Ideal.mem_span_singleton]
  refine (hprim.dvd_iff_fraction_map_dvd_fraction_map K).mpr ?_
  let _ : Algebra k[X] K[X] := Polynomial.algebra k K
  have := Polynomial.isLocalization (nonZeroDivisors k) K
  set S := (nonZeroDivisors k).map (C : k →+* k[X])
  have hdisj : Disjoint (S : Set k[X]) (Q : Set k[X]) := by
    rw [Set.disjoint_left]
    rintro _ ⟨c, hc, rfl⟩ hcQ
    exact nonZeroDivisors.ne_zero hc (hQ c hcQ)
  have hQ' := IsLocalization.isPrime_of_isPrime_disjoint S K[X] Q hQp hdisj
  have hirr : Irreducible (π.map (algebraMap k K)) :=
    (hprim.irreducible_iff_irreducible_map_fraction_map).mp hπ.irreducible
  have hmax := PrincipalIdealRing.isMaximal_of_irreducible hirr
  have hle : Ideal.span {π.map (algebraMap k K)} ≤ Q.map (algebraMap k[X] K[X]) := by
    rw [Ideal.span_singleton_le_iff_mem]
    exact Ideal.mem_map_of_mem _ hπQ
  have heq := hmax.eq_of_le hQ'.ne_top hle
  have : a.map (algebraMap k K) ∈ Q.map (algebraMap k[X] K[X]) := Ideal.mem_map_of_mem _ haQ
  rw [← heq, Ideal.mem_span_singleton] at this
  exact this

/-- A prime ideal of `k[X]`, for `k` a principal ideal domain, that contains no monic
polynomial is principal. -/
theorem isPrincipal_of_isPrime_of_disjoint (Q : Ideal k[X]) [hQp : Q.IsPrime]
    (hQ : Disjoint (monicSubmonoid k : Set k[X]) (Q : Set k[X])) : Q.IsPrincipal := by
  classical
  have hnomonic : ∀ g ∈ Q, ¬ g.Monic := fun g hg hm =>
    Set.disjoint_left.mp hQ (show g ∈ (monicSubmonoid k : Set k[X]) from hm) hg
  by_cases hc : ∃ c : k, c ≠ 0 ∧ C c ∈ Q
  · obtain ⟨c, hc0, hcQ⟩ := hc
    let P := Q.comap (C : k →+* k[X])
    have : P.IsPrime := Ideal.comap_isPrime _ _
    obtain ⟨p, hpP⟩ := (IsPrincipalIdealRing.principal P).principal
    have hP : P = Ideal.span {p} := hpP
    have hp0 : p ≠ 0 := by
      rintro rfl
      have : c ∈ P := hcQ
      rw [hP, Ideal.span_singleton_eq_bot.mpr rfl] at this
      exact hc0 this
    have hpprime : Prime p := (Ideal.span_singleton_prime hp0).mp (hP ▸ inferInstance)
    have hpQ : C p ∈ Q := show p ∈ P from hP ▸ Ideal.mem_span_singleton_self p
    by_cases hne : Q = Ideal.span {C p}
    · exact ⟨⟨C p, hne⟩⟩
    · obtain ⟨g, hg, hgm⟩ := exists_monic_mem_of_span_C_lt hpprime hpQ hne
      exact absurd hgm (hnomonic g hg)
  · push Not at hc
    have hQc : ∀ c : k, C c ∈ Q → c = 0 := fun c h => by_contra fun h0 => hc c h0 h
    by_cases hbot : Q = ⊥
    · rw [hbot]
      exact bot_isPrincipal
    · obtain ⟨π, hπQ, hπ⟩ := hQp.exists_mem_prime_of_ne_bot hbot
      exact ⟨⟨π, eq_span_of_prime_mem hQc hπ hπQ⟩⟩

/-- **Quillen's Lemma 2.** If `k` is a principal ideal domain, then so is `k⟨X⟩`, the
localisation of `k[X]` at the monic polynomials (Quillen 1976, Lemma 2, p. 169). -/
theorem isPrincipalIdealRing_monicLocalization (k : Type u) [CommRing k] [IsDomain k]
    [IsPrincipalIdealRing k] :
    IsDomain (Localization (monicSubmonoid k)) ∧
      IsPrincipalIdealRing (Localization (monicSubmonoid k)) := by
  refine ⟨inferInstance, IsPrincipalIdealRing.of_prime fun P hP => ?_⟩
  set L := Localization (monicSubmonoid k)
  have h := (IsLocalization.isPrime_iff_isPrime_disjoint (monicSubmonoid k) L P).mp hP
  have : (P.comap (algebraMap k[X] L)).IsPrime := h.1
  obtain ⟨x, hx⟩ := (isPrincipal_of_isPrime_of_disjoint _ h.2).principal
  refine ⟨⟨algebraMap k[X] L x, ?_⟩⟩
  rw [← IsLocalization.map_under (monicSubmonoid k) L P, hx]
  change Ideal.map _ (Ideal.span {x}) = _
  rw [Ideal.map_span, Set.image_singleton]

end LeanPool.QuillenSuslin


/- Modified for Lean Pool: module declarations, imports, and repository lint. -/

module

public import LeanPool.InteractionCombinators.Universality.RecursionFree.DecompositionLemmas

/-!
# Rules in expanded form are rigid

Part 1 of the symmetric decomposition of a rule `α`–`α` (Lafont 1997, page 86). The symmetry of
such a rule was first stated as `Equiv r.swap.net r.net`, the hypothesis used in this file;
`System.WellFormed.symm` now allows in addition a permutation of the internal wires, and
`RecursionFree/SymmPerm.lean` extends the result to it. `Equiv` is
generated by wire substitutions through arbitrary intermediate nets. Here it is turned into a
structural fact, for rules in *expanded form*: every equation is `p = t` with `p` an auxiliary port
and every leaf of `t` an internal wire (`Rule.Expanded`).

* `Rule.Expanded.reduced`: an expanded rule is reduced.
* `Rule.eq_id_of_bind_eq`: a renaming of the internal wires that fixes a linear reduced rule is
  the identity on the internal wires (rigidity).
* `Rule.exists_perm_of_equiv`: two linear expanded nets that are `Equiv` differ by a permutation
  of the internal wires.

The proof of the last uses the invariant `Equiv.sol_iff` (solutions on the free ports): in an
expanded net, each port `p` is the root of exactly one equation `p = T p`, so sending each port to
its tree solves the net. A solution of the other net, `p = U p`, then gives `T p = U p` with trees
plugged into the leaves; since `Equiv` keeps the cells, the trees plugged in are wires, and since
both nets are linear, the renaming of the wires is injective, hence a permutation.

Contents, in the order of the file:

1. Definition: `Rule.Expanded`, the expanded form of a rule.
2. Auxiliary lemmas on equations and trees: `Rule.Expanded.reduced`,
   `ExpandedIso.eq_of_mem_of_count_one`, `ExpandedIso.fix_of_bind_var_eq`,
   `ExpandedIso.eq_var_of_cells_eq_zero`.
3. Auxiliary lemmas on the ports of a rule: `ExpandedIso.port` and its properties
   (`port_injective`, `port_ne_internal`, `exists_port`, `count_port`), and the names and cells of
   a net written as one equation per port (`vars_map`, `cells_map`).
4. Auxiliary lemmas on the shape of an expanded net: `ExpandedIso.exists_shape` (one equation per
   port), `ExpandedIso.count_internal`, `ExpandedIso.map_port`, and `ExpandedIso.eq_bind_perm`
   (two `Equiv` expanded nets differ by a permutation of the internal wires).
5. Main results: `Rule.eq_id_of_bind_eq` (rigidity) and `Rule.exists_perm_of_equiv`
   (isomorphism of expanded rules), page 86.
-/

@[expose] public section

namespace INet

variable {S : Signature} {a b : ℕ}

open Term

-- ============================================================================================
-- 1. Definition
-- ============================================================================================

/-- A rule in expanded form: every equation is `p = t` with `p` an auxiliary port and every leaf of
`t` an internal wire. No port is a leaf of a tree, and no equation joins two ports. This is a
normal form of reduced rules used for the symmetric decomposition of page 86. -/
def Rule.Expanded
    -- a rule between cells of arities `a` and `b`
    (r : Rule S a b) :
    Prop :=
  -- every equation of the rule is `p = t`,
  ∀ e ∈ r.net, ∃ p t, e = s(Term.var p, t) ∧
    -- where `p` is not an internal wire, so is an auxiliary port,
    (∀ w, p ≠ .inr (.inr w)) ∧
    -- and every leaf of `t` is an internal wire
    ∀ x ∈ t.vars, ∃ w, x = .inr (.inr w)

-- ============================================================================================
-- 2. Auxiliary lemmas: equations and trees
-- ============================================================================================

/-- A rule in expanded form is reduced (page 86): every equation is rooted at a port. -/
theorem Rule.Expanded.reduced
    -- a rule in expanded form
    {r : Rule S a b}
    (h : r.Expanded) :
    r.Reduced := fun e he => by
  obtain ⟨p, t, rfl, hp, -⟩ := h e he
  exact ⟨p, t, rfl, hp⟩

namespace ExpandedIso

/-- Two equations of a net that share a name occurring once in the net are the same equation. -/
theorem eq_of_mem_of_count_one
    -- a net
    {ν : Type}
    [DecidableEq ν]
    {N : Net S ν}
    -- two equations of the net
    {e e' : Sym2 (Term S ν)}
    (he : e ∈ N)
    (he' : e' ∈ N)
    -- a name of both equations, which occurs once in the net
    {x : ν}
    (hx : x ∈ eqVars e)
    (hx' : x ∈ eqVars e')
    (h1 : N.vars.count x = 1) :
    -- the two equations are the same
    e = e' := by
  by_contra hne
  obtain ⟨N₁, rfl⟩ := Multiset.exists_cons_of_mem he
  have he'' : e' ∈ N₁ := (Multiset.mem_cons.1 he').resolve_left (Ne.symm hne)
  obtain ⟨N₂, rfl⟩ := Multiset.exists_cons_of_mem he''
  simp only [Net.vars_cons, Multiset.count_add] at h1
  have := Multiset.one_le_count_iff_mem.2 hx
  have := Multiset.one_le_count_iff_mem.2 hx'
  omega

/-- A renaming that fixes a tree fixes each of its leaves. -/
theorem fix_of_bind_var_eq
    -- a renaming `f` and a tree `t`
    {ν : Type}
    {f : ν → ν}
    {t : Term S ν}
    -- `t` renamed by `f` is `t`
    (h : t.bind (fun x => var (f x)) = t) :
    -- `f` fixes every leaf of `t`
    ∀ x ∈ t.vars, f x = x := by
  induction t with
  | var y =>
    intro x hx
    simp only [vars_var, Multiset.mem_singleton] at hx
    subst hx
    simpa using h
  | app α ts ih =>
    intro x hx
    simp only [vars_app, Multiset.mem_sum, Finset.mem_univ, true_and] at hx
    obtain ⟨i, hi⟩ := hx
    simp only [bind_app, app.injEq, heq_eq_eq, true_and] at h
    exact ih i (congrFun h i) x hi

/-- A tree without cells is a single name. -/
theorem eq_var_of_cells_eq_zero
    -- a tree without cells
    {ν : Type}
    {t : Term S ν}
    (h : t.cells = 0) :
    -- it is a name `y`
    ∃ y, t = var y := by
  cases t with
  | var y => exact ⟨y, rfl⟩
  | app α ts => exact absurd h (by simp)

-- ============================================================================================
-- 3. Auxiliary lemmas: the ports of a rule
-- ============================================================================================

/-- The auxiliary ports of a rule, as names of its net. -/
def port
    -- the number of internal wires
    {n : ℕ} :
    Fin a ⊕ Fin b → Fin a ⊕ Fin b ⊕ Fin n :=
  Sum.elim Sum.inl fun j => Sum.inr (Sum.inl j)

/-- Two different ports are two different names. -/
theorem port_injective
    {n : ℕ} :
    Function.Injective (port (a := a) (b := b) (n := n)) := by
  rintro (i | j) (i' | j') h <;> simp_all [port]

/-- A port is not an internal wire. -/
theorem port_ne_internal
    {n : ℕ}
    (p : Fin a ⊕ Fin b)
    (w : Fin n) :
    (port p : Fin a ⊕ Fin b ⊕ Fin n) ≠ .inr (.inr w) := by
  rcases p with i | j <;> simp [port]

/-- A name that is not an internal wire is a port. -/
theorem exists_port
    {n : ℕ}
    {q : Fin a ⊕ Fin b ⊕ Fin n}
    (h : ∀ w, q ≠ .inr (.inr w)) :
    ∃ p, q = port p := by
  rcases q with i | j | w
  · exact ⟨.inl i, rfl⟩
  · exact ⟨.inr j, rfl⟩
  · exact absurd rfl (h w)

variable {n : ℕ} {N M : Net S (Fin a ⊕ Fin b ⊕ Fin n)}

/-- In a linear rule, each port occurs once. -/
theorem count_port
    (hl : (⟨n, N⟩ : Rule S a b).Linear)
    (p : Fin a ⊕ Fin b) :
    N.vars.count (port p) = 1 := by
  rcases p with i | j
  · exact hl.left i
  · exact hl.right j

/-- The names of a net written as one equation per port. -/
theorem vars_map
    -- the tree `T p` on each port `p`
    (T : Fin a ⊕ Fin b → Term S (Fin a ⊕ Fin b ⊕ Fin n)) :
    -- the names are each port with the names of its tree
    Net.vars (Finset.univ.val.map fun p => s(var (port p), T p))
      = ∑ p, ({port p} + (T p).vars) := by
  rw [Net.vars, Multiset.bind_map]; rfl

/-- The cells of a net written as one equation per port. -/
theorem cells_map
    -- the tree `T p` on each port `p`
    (T : Fin a ⊕ Fin b → Term S (Fin a ⊕ Fin b ⊕ Fin n)) :
    -- the cells are those of the trees
    Net.cells (Finset.univ.val.map fun p => s(var (port p), T p)) = ∑ p, (T p).cells := by
  rw [Net.cells, Multiset.bind_map]; simp only [eqCells_mk, cells_var, zero_add]; rfl

-- ============================================================================================
-- 4. Auxiliary lemmas: the shape of an expanded net
-- ============================================================================================

/-- A linear net in expanded form is one equation `p = T p` per port `p`, where every leaf of
`T p` is an internal wire. -/
theorem exists_shape
    -- the net of a rule, linear and in expanded form
    (hl : (⟨n, N⟩ : Rule S a b).Linear)
    (he : (⟨n, N⟩ : Rule S a b).Expanded) :
    -- there is a tree `T p` for each port `p` such that
    ∃ T : Fin a ⊕ Fin b → Term S (Fin a ⊕ Fin b ⊕ Fin n),
      -- every leaf of each tree is an internal wire,
      (∀ p, ∀ x ∈ (T p).vars, ∃ w, x = .inr (.inr w)) ∧
      -- and the net is the equations `p = T p`
      N = Finset.univ.val.map fun p => s(var (port p), T p) := by
  have hroot : ∀ p, ∃ t : Term S (Fin a ⊕ Fin b ⊕ Fin n),
      s(var (port p), t) ∈ N ∧ ∀ x ∈ t.vars, ∃ w, x = .inr (.inr w) := by
    intro p
    have hmem : port p ∈ N.vars := Multiset.one_le_count_iff_mem.1 (count_port hl p).ge
    obtain ⟨e, heN, hpe⟩ := Multiset.mem_bind.1 hmem
    obtain ⟨q, t, rfl, -, ht⟩ := he e heN
    simp only [eqVars_mk, vars_var, Multiset.mem_add, Multiset.mem_singleton] at hpe
    rcases hpe with hq | hpt
    · exact ⟨t, hq ▸ heN, ht⟩
    · obtain ⟨w, hw⟩ := ht _ hpt
      exact absurd hw (port_ne_internal p w)
  choose T hT hTint using hroot
  refine ⟨T, hTint, ?_⟩
  set R : Net S (Fin a ⊕ Fin b ⊕ Fin n) := Finset.univ.val.map fun p => s(var (port p), T p)
  have hinj : Function.Injective fun p => (s(var (port p), T p) : Sym2 (Term S _)) := by
    intro p q hpq
    rcases Sym2.eq_iff.1 hpq with ⟨h1, -⟩ | ⟨h1, -⟩
    · exact port_injective (Term.var.inj h1)
    · obtain ⟨w, hw⟩ := hTint q (port p) (by rw [← h1]; simp)
      exact absurd hw (port_ne_internal p w)
  have hnd : R.Nodup := Multiset.Nodup.map hinj Finset.univ.nodup
  have hle : R ≤ N := (Multiset.le_iff_subset hnd).2 fun e he => by
    obtain ⟨p, -, rfl⟩ := Multiset.mem_map.1 he
    exact hT p
  obtain ⟨D, hD⟩ := Multiset.le_iff_exists_add.1 hle
  have hD0 : D = 0 := by
    refine Multiset.eq_zero_of_forall_notMem fun e heD => ?_
    obtain ⟨q, t, rfl, hq, -⟩ := he e (hD ▸ Multiset.mem_add.2 (Or.inr heD))
    obtain ⟨p, rfl⟩ := exists_port hq
    have h1 := count_port hl p
    have hR : port p ∈ R.vars :=
      Multiset.mem_bind.2 ⟨_, Multiset.mem_map.2 ⟨p, Finset.mem_univ_val _, rfl⟩, by simp⟩
    have hDv : port p ∈ Net.vars D := Multiset.mem_bind.2 ⟨_, heD, by simp⟩
    rw [hD, Net.vars_add, Multiset.count_add] at h1
    have := Multiset.one_le_count_iff_mem.2 hR
    have := Multiset.one_le_count_iff_mem.2 hDv
    omega
  rw [hD, hD0, add_zero]

/-- The internal wires of a linear net written as one equation per port all lie in the trees, twice
each. -/
theorem count_internal
    -- the net of a linear rule
    (hl : (⟨n, N⟩ : Rule S a b).Linear)
    -- written as one equation `p = T p` per port `p`
    {T : Fin a ⊕ Fin b → Term S (Fin a ⊕ Fin b ⊕ Fin n)}
    (hNT : N = Finset.univ.val.map fun p => s(var (port p), T p))
    -- an internal wire
    (w : Fin n) :
    -- it occurs twice in the trees
    (∑ p, (T p).vars).count (.inr (.inr w)) = 2 := by
  have h2 : N.vars.count (.inr (.inr w)) = 2 := hl.internal w
  rw [hNT, vars_map, Finset.sum_add_distrib, Multiset.count_add] at h2
  have h0 : (∑ p, ({port p} : Multiset (Fin a ⊕ Fin b ⊕ Fin n))).count (.inr (.inr w)) = 0 := by
    rw [Multiset.count_eq_zero, Multiset.mem_sum]
    rintro ⟨p, -, hp⟩
    exact port_ne_internal p w (Multiset.mem_singleton.1 hp).symm
  omega

/-- A renaming of the internal wires fixes the ports. -/
theorem map_port
    {f : Fin n → Fin n}
    (p : Fin a ⊕ Fin b) :
    Sum.map id (Sum.map id f) (port p : Fin a ⊕ Fin b ⊕ Fin n) = port p := by
  rcases p with i | j <;> rfl

/-- Two linear nets in expanded form that are `Equiv` differ by a permutation of the internal
wires (in the direction `N = M` renamed). -/
theorem eq_bind_perm
    -- two nets of rules, both linear
    (hN : (⟨n, N⟩ : Rule S a b).Linear)
    (hM : (⟨n, M⟩ : Rule S a b).Linear)
    -- both in expanded form
    (eN : (⟨n, N⟩ : Rule S a b).Expanded)
    (eM : (⟨n, M⟩ : Rule S a b).Expanded)
    -- and the same graph
    (h : Equiv N M) :
    -- `N` is `M` with its internal wires renamed by some permutation `π`
    ∃ π : Equiv.Perm (Fin n), N = M.bind fun x => var (Sum.map id (Sum.map id π) x) := by
  classical
  obtain ⟨T, hTint, hNT⟩ := exists_shape hN eN
  obtain ⟨U, hUint, hMU⟩ := exists_shape hM eM
  -- each port is sent to its tree in `N`: a solution of `N`
  let s₀ : Fin a ⊕ Fin b ⊕ Fin n → Term S (Fin a ⊕ Fin b ⊕ Fin n) :=
    Sum.elim (fun i => T (.inl i)) (Sum.elim (fun j => T (.inr j)) fun w => var (.inr (.inr w)))
  have hs₀ : ∀ p, s₀ (port p) = T p := by rintro (i | j) <;> rfl
  have hfix : ∀ p, (T p).bind s₀ = T p := fun p => by
    conv_rhs => rw [← Term.bind_var_self (T p)]
    exact Term.bind_congr fun x hx => by obtain ⟨w, rfl⟩ := hTint p x hx; rfl
  have hsol : N.Sol s₀ := by
    refine ⟨s₀, fun e he => ?_, fun _ _ => rfl⟩
    rw [hNT] at he
    obtain ⟨p, -, rfl⟩ := Multiset.mem_map.1 he
    change (var (port p)).bind s₀ = (T p).bind s₀
    rw [bind_var, hs₀, hfix]
  obtain ⟨g, hg, hgp⟩ := (h.sol_iff s₀).1 hsol
  have key1 : ∀ p, T p = (U p).bind g := fun p => by
    have hmem : s(var (port p), U p) ∈ M := by
      rw [hMU]; exact Multiset.mem_map.2 ⟨p, Finset.mem_univ_val _, rfl⟩
    have h1 : (var (port p)).bind g = (U p).bind g := hg _ hmem
    have h2 := hgp (port p) (count_port hM p)
    rw [hs₀] at h2
    rw [← h2, ← h1, bind_var]
  -- no cell is plugged into the leaves of `U p`
  have hcells : ∀ p, ∀ x ∈ (U p).vars, (g x).cells = 0 := by
    have hc := h.cells_eq
    rw [hNT, hMU, cells_map, cells_map] at hc
    simp only [key1, Term.cells_bind, Finset.sum_add_distrib] at hc
    have h0 := add_eq_left.1 hc
    rw [Finset.sum_eq_zero_iff] at h0
    intro p x hx
    exact Multiset.le_zero.1 (h0 p (Finset.mem_univ _) ▸ Multiset.le_bind _ hx)
  let hf : Fin a ⊕ Fin b ⊕ Fin n → Fin a ⊕ Fin b ⊕ Fin n := fun x =>
    if hx : ∃ y, g x = var y then hx.choose else x
  have hhf : ∀ p, ∀ x ∈ (U p).vars, g x = var (hf x) := fun p x hx => by
    have hv := eq_var_of_cells_eq_zero (hcells p x hx)
    simp only [hf, hv, ↓reduceDIte]
    exact hv.choose_spec
  have key2 : ∀ p, T p = (U p).bind fun x => var (hf x) := fun p => by
    rw [key1]; exact Term.bind_congr (hhf p)
  have hvarsT : ∀ p, (T p).vars = (U p).vars.map hf := fun p => by
    rw [key2, Term.vars_bind]; simp [Multiset.bind_singleton]
  have hsum : ∑ p, (T p).vars = (∑ p, (U p).vars).map hf := by
    simp only [hvarsT]
    exact (map_sum (Multiset.mapAddMonoidHom hf) _ _).symm
  -- the renaming sends internal wires to internal wires
  have hint : ∀ w, ∃ w', hf (.inr (.inr w)) = .inr (.inr w') := fun w => by
    have hm : (.inr (.inr w) : Fin a ⊕ Fin b ⊕ Fin n) ∈ ∑ p, (U p).vars :=
      Multiset.one_le_count_iff_mem.1 (by rw [count_internal hM hMU w]; omega)
    obtain ⟨p, -, hp⟩ := Multiset.mem_sum.1 hm
    exact hTint p _ (by rw [hvarsT]; exact Multiset.mem_map_of_mem _ hp)
  choose π₀ hπ₀ using hint
  -- and is injective on them, by linearity of `N`
  have hinj : Function.Injective π₀ := by
    intro w₁ w₂ h12
    by_contra hne
    have hx : (.inr (.inr w₁) : Fin a ⊕ Fin b ⊕ Fin n) ≠ .inr (.inr w₂) := by simpa using hne
    have c1 := count_internal hM hMU w₁
    have c2 := count_internal hM hMU w₂
    obtain ⟨V₁, hV₁⟩ := Multiset.le_iff_exists_add.1 (Multiset.le_count_iff_replicate_le.1 c1.ge)
    rw [hV₁, Multiset.count_add, Multiset.count_replicate] at c2
    simp only [hx, ite_false, zero_add] at c2
    obtain ⟨V₂, hV₂⟩ := Multiset.le_iff_exists_add.1 (Multiset.le_count_iff_replicate_le.1 c2.ge)
    have c := count_internal hN hNT (π₀ w₁)
    rw [hsum, hV₁, hV₂, Multiset.map_add, Multiset.map_add, Multiset.map_replicate,
      Multiset.map_replicate, hπ₀, hπ₀, ← h12, Multiset.count_add, Multiset.count_add,
      Multiset.count_replicate_self] at c
    omega
  refine ⟨Equiv.ofBijective π₀ (Finite.injective_iff_bijective.1 hinj), ?_⟩
  rw [hNT, hMU]
  unfold Net.bind
  rw [Multiset.map_map]
  refine Multiset.map_congr rfl fun p _ => ?_
  have ht : (U p).bind (fun x => var (Sum.map id
      (Sum.map id (Equiv.ofBijective π₀ (Finite.injective_iff_bijective.1 hinj))) x)) = T p := by
    rw [key2 p]
    exact Term.bind_congr fun x hx => by
      obtain ⟨w, rfl⟩ := hUint p x hx
      simp [hπ₀]
  change s(var (port p), T p) = s((var (port p)).bind _, (U p).bind _)
  rw [ht, bind_var, map_port]

end ExpandedIso

-- ============================================================================================
-- 5. Main results: rigidity and isomorphism of expanded rules
-- ============================================================================================

/-- **Rigidity** (page 86). A renaming of the internal wires that fixes a linear reduced rule is the
identity: each port lies in exactly one equation, which must be sent to itself, so the renaming
fixes every name of that equation, and every internal wire occurs in some equation. -/
theorem Rule.eq_id_of_bind_eq
    -- a linear reduced rule
    (r : Rule S a b)
    (hl : r.Linear)
    (hr : r.Reduced)
    -- a renaming `f` of its internal wires, which fixes the net of the rule
    (f : Fin r.internal → Fin r.internal)
    (h : r.net.bind (fun x => var (Sum.map id (Sum.map id f) x)) = r.net) :
    -- `f` is the identity
    ∀ w, f w = w := by
  intro w
  have hw : (Sum.inr (Sum.inr w) : Fin a ⊕ Fin b ⊕ Fin r.internal) ∈ r.net.vars :=
    Multiset.one_le_count_iff_mem.1 (by rw [hl.internal w]; omega)
  obtain ⟨e, he, hwe⟩ := Multiset.mem_bind.1 hw
  obtain ⟨q, t, rfl, hq⟩ := hr e he
  obtain ⟨p, rfl⟩ := ExpandedIso.exists_port hq
  have hwt : (Sum.inr (Sum.inr w) : Fin a ⊕ Fin b ⊕ Fin r.internal) ∈ t.vars := by
    simp only [eqVars_mk, vars_var, Multiset.mem_add, Multiset.mem_singleton] at hwe
    exact hwe.resolve_left fun e => ExpandedIso.port_ne_internal p w e.symm
  have he' : s(var (ExpandedIso.port p), t.bind fun x => var (Sum.map id (Sum.map id f) x)) ∈
      r.net := by
    rw [← h]
    refine Multiset.mem_map.2 ⟨_, he, ?_⟩
    change s((var (ExpandedIso.port p)).bind _, _) = _
    rw [bind_var, ExpandedIso.map_port]
  have hc : r.net.vars.count (ExpandedIso.port p) = 1 :=
    ExpandedIso.count_port (n := r.internal) (N := r.net) hl p
  have hee := ExpandedIso.eq_of_mem_of_count_one he he' (x := ExpandedIso.port p) (by simp)
    (by simp) hc
  have ht := Sym2.congr_right.1 hee
  have := ExpandedIso.fix_of_bind_var_eq ht.symm _ hwt
  simpa using this

/-- **Isomorphism of expanded rules** (page 86). Two linear rules in expanded form, with the same
number `n` of internal wires, whose nets are `Equiv` differ by a permutation of the internal wires:
the second net is the first one with its internal wires renamed by `π`. -/
theorem Rule.exists_perm_of_equiv
    -- two nets of rules with `n` internal wires
    {n : ℕ}
    {N M : Net S (Fin a ⊕ Fin b ⊕ Fin n)}
    -- both linear
    (hN : (⟨n, N⟩ : Rule S a b).Linear)
    (hM : (⟨n, M⟩ : Rule S a b).Linear)
    -- both in expanded form
    (eN : (⟨n, N⟩ : Rule S a b).Expanded)
    (eM : (⟨n, M⟩ : Rule S a b).Expanded)
    -- and the same graph
    (h : Equiv N M) :
    -- `M` is `N` with its internal wires renamed by some permutation `π`
    ∃ π : Equiv.Perm (Fin n), M = N.bind fun x => var (Sum.map id (Sum.map id π) x) :=
  ExpandedIso.eq_bind_perm hM hN eM eN h.symm

end INet

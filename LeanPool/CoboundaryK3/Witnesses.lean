/-! ### The `k = 8` search, split by the gauge on vertex `1` -/

private theorem k8_piece_0 :
    tsearch tableW8 27 6 ([0] ++ [0]) (0 + tinc tableW8 [0] 0) = true := by
  decide +kernel


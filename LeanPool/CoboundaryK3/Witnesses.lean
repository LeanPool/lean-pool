private theorem k8_root : tsearch tableW8 27 7 [0] 0 = true :=
  tsearch_split6 tableW8 27 6 [0] 0 k8_piece_0 k8_piece_1 k8_piece_2 k8_piece_3 k8_piece_4
    k8_piece_5

/-! ### Theorem 4 for `k = 6, 7, 8` -/

/-- **Theorem 4, k = 6.** `N = 36`, `D = 18`: `N/D = 2 = 6/3`. -/
theorem witness_k6 :
    defect w6 = 36 ∧ (∀ β, 18 ≤ cost w6 β) ∧ cost w6 (fun _ => 1) = 18 ∧ 36 * 3 = 6 * 18 :=
  ⟨by decide +kernel, gauge_lower_table tableSpec_w6 18 (by decide +kernel), by decide +kernel,
    by norm_num⟩

/-- **Theorem 4, k = 7.** `N = 28`, `D = 12`: `N/D = 7/3`. -/
theorem witness_k7 :
    defect w7 = 28 ∧ (∀ β, 12 ≤ cost w7 β) ∧ cost w7 (fun _ => 1) = 12 ∧ 28 * 3 = 7 * 12 :=
  ⟨by decide +kernel, gauge_lower_table tableSpec_w7 12 (by decide +kernel), by decide +kernel,
    by norm_num⟩

/-- **Theorem 4, k = 8.** `N = 72`, `D = 27`: `N/D = 8/3`. The residual carries twelve
transpositions (all three of `Sym(3)`) and one 3-cycle. -/
theorem witness_k8 :
    defect w8 = 72 ∧ (∀ β, 27 ≤ cost w8 β) ∧ cost w8 (fun _ => 1) = 27 ∧ 72 * 3 = 8 * 27 :=
  ⟨by decide +kernel, gauge_lower_table tableSpec_w8 27 k8_root, by decide +kernel, by norm_num⟩


module

public import LeanPool.Magma1518.Laws

/-!
# One-generated magmas satisfying laws 1518 and 3862

**Theorem A.** In every magma satisfying laws 1518 and 3862, for every `x` and all `u, v` in
`T = {x, S x, S (S x)}` one has `u ◇ v = S v`, and `S (S (S x)) = x`. Hence every word in `x` lies
in `T`, and `T` has one element or three distinct elements on which `◇` is the cyclic shift
`u ◇ v = S v`. So every one-generated magma satisfying 1518 and 3862 is the trivial magma or the
Z/3 shift `x ◇ y = y + 1`. No finiteness is assumed.

Terence Tao conjectured this on the Lean Zulip (Equational stream, "Austin pairs", 2024-11-29,
message 485148288) for magmas satisfying 1518 together with all four of 47, 614, 817 and 3862.
Assuming 3862 alone is no weaker: Matthew Bolan reported the same day (message 485153888) that
1518 and 3862 already imply the other three.

The lemmas transcribe nine equational proofs found by the Vampire prover. The four headline
declarations `table`, `cube`, `words_in_T` and `one_or_three` are the statements registered with
Palomar as `PALOMAR-2026-09-30-000005`, unchanged.
-/

@[expose] public section

namespace Magma1518

variable {G : Type} (op : G → G → G)

/-- Law 359, `(x ◇ x) ◇ x = x ◇ x`, from 1518 alone. -/
theorem l359 (h1 : Law1518 op) (x : G) : op (op x x) x = op x x := by
  have i := h1 x x
  have ii := h1 (op x x) x
  rw [← i] at ii
  exact ii.symm

/-- `x ◇ S x = S (S x)`. -/
theorem x_A (h1 : Law1518 op) (h2 : Law3862 op) (x : G) :
    op x (op x x) = op (op x x) (op x x) := by
  have e1 := h1 (op x (op x x)) (op x x)
  have hx : op (op x x) (op x (op x x)) = x := (h1 x x).symm
  rw [hx] at e1
  have h3 : op (op x (op x x)) x = op x x := (h2 x).symm
  rw [h3] at e1
  rw [l359 op h1 (op x x)] at e1
  exact e1

/-- `x ◇ S (S x) = x`. -/
theorem x_B (h1 : Law1518 op) (h2 : Law3862 op) (x : G) :
    op x (op (op x x) (op x x)) = x := by
  have a : op (op x (op x x)) x = op x x := (h2 x).symm
  have b := h1 x (op x (op x x))
  rw [a] at b
  rw [l359 op h1 (op x (op x x))] at b
  have d := l359 op h1 (op x (op x x))
  rw [← b] at d
  rw [x_A op h1 h2 x] at d
  exact d

/-- `S x ◇ S (S x) = x`. -/
theorem A_B (h1 : Law1518 op) (h2 : Law3862 op) (x : G) :
    op (op x x) (op (op x x) (op x x)) = x := by
  have hx : op (op x x) (op x (op x x)) = x := (h1 x x).symm
  rw [x_A op h1 h2 x] at hx
  exact hx

/-- `S (S x) ◇ x = S x`. -/
theorem B_x (h1 : Law1518 op) (h2 : Law3862 op) (x : G) :
    op (op (op x x) (op x x)) x = op x x := by
  have a : op (op x (op x x)) x = op x x := (h2 x).symm
  rw [x_A op h1 h2 x] at a
  exact a

/-- Theorem A, cyclicity: `S (S (S x)) = x`, i.e. `(S x ◇ S x) ◇ (S x ◇ S x) = x`. -/
theorem cube (h1 : Law1518 op) (h2 : Law3862 op) (x : G) :
    op (op (op x x) (op x x)) (op (op x x) (op x x)) = x := by
  have e := h1 x (op x x)
  rw [l359 op h1 x] at e
  rw [x_A op h1 h2 x] at e
  exact e.symm

/-- Theorem A (table). In a magma satisfying 1518 and 3862, for every `x` and all
`u, v ∈ {x, S x, S (S x)}`, `u ◇ v = S v = v ◇ v`. -/
theorem table (h1 : Law1518 op) (h2 : Law3862 op) (x u v : G) (hu : inT op x u)
    (hv : inT op x v) : op u v = op v v := by
  -- the three diagonal cases close by `rfl` inside `rw`; six off-diagonal goals remain
  rcases hu with hu | hu | hu <;> rcases hv with hv | hv | hv <;> rw [hu, hv]
  · exact x_A op h1 h2 x
  · rw [x_B op h1 h2 x, cube op h1 h2 x]
  · exact l359 op h1 x
  · rw [A_B op h1 h2 x, cube op h1 h2 x]
  · exact B_x op h1 h2 x
  · exact l359 op h1 (op x x)

/-- `T = {x, S x, S (S x)}` is closed under `◇`. -/
theorem closed (h1 : Law1518 op) (h2 : Law3862 op) (x u v : G) (hu : inT op x u)
    (hv : inT op x v) : inT op x (op u v) := by
  rw [table op h1 h2 x u v hu hv]
  rcases hv with hv | hv | hv <;> rw [hv]
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inr rfl)
  · exact Or.inl (cube op h1 h2 x)

/-- Corollary A′: every word in `x` evaluates into `{x, S x, S (S x)}`, so the submagma
generated by `x` is that set. -/
theorem words_in_T (h1 : Law1518 op) (h2 : Law3862 op) (x : G) (w : W) :
    inT op x (ev op x w) := by
  induction w with
  | v => exact Or.inl rfl
  | m a b iha ihb => exact closed op h1 h2 x _ _ iha ihb

/-- Corollary A′: either `S x = x = S (S x)` (one element) or `x, S x, S (S x)` are pairwise
distinct (three elements). -/
theorem one_or_three (h1 : Law1518 op) (h2 : Law3862 op) (x : G) :
    (op x x = x ∧ op (op x x) (op x x) = x) ∨
    (op x x ≠ x ∧ op (op x x) (op x x) ≠ x ∧ op (op x x) (op x x) ≠ op x x) := by
  by_cases hA : op x x = x
  · left
    refine ⟨hA, ?_⟩
    rw [hA, hA]
  · right
    refine ⟨hA, ?_, ?_⟩
    · intro hB
      have e := cube op h1 h2 x
      rw [hB] at e
      exact hA e
    · intro hB
      have e := cube op h1 h2 x
      rw [hB] at e
      exact hA (hB.symm.trans e)

end Magma1518

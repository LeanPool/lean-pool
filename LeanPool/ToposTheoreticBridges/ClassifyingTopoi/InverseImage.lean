/-!
# Inverse images of models

A functor `F : E ⥤ E'` preserving finite products maps a structure `M` in `E` to a structure
`M.map F` in `E'`, with carrier `F A` and the function and relation symbols transported through
the comparison `F (Aᵏ) ≅ (F A)ᵏ`. When `F` moreover preserves finite limits, epimorphisms and
coproducts indexed by `Type w`, and `E'` is a strong-epi category, the interpretation of a
geometric formula in `M.map F` is the image under `F` of its interpretation in `M`; hence `F`
maps models to models. This applies to the inverse image of a geometric morphism between sheaf
topoi, a left exact left adjoint.

## Main results

* `LeanPool.ClassifyingTopoi.CatStructure.interp_map`: `(M.map F).interp φ` is
  `mapSubobject F c (M.interp φ)`, the subobject `F S ⟶ F (Aⁿ) ≅ (F A)ⁿ`;
* `LeanPool.ClassifyingTopoi.CatStructure.IsModel.map_of_preserves`: such a functor maps models
  of a geometric theory to models;
* `LeanPool.ClassifyingTopoi.CatStructure.IsModel.map`: the inverse image of a geometric morphism
  between sheaf topoi (a left exact left adjoint `Sheaf J (Type u) ⥤ Sheaf K (Type u)`) maps
  models to models.

## Implementation notes

Mathlib has no functor `Subobject X ⥤ Subobject (F.obj X)` induced by a functor preserving
monomorphisms; `mapSubobject F c` is defined here, followed by an isomorphism `c`. It is monotone
and commutes with `⊤`, meets (`F` preserves pullbacks), equalizers, pullbacks, images, existential
quantification and images of coproducts. For images, `F` maps the epimorphism onto the image to an
epimorphism, which is strong in `E'`, so the image of `F g` is `F` of the image of `g`. In a sheaf
topos all epimorphisms are regular, hence strong (`strongEpiCategory_of_regularEpiCategory`), and
a left adjoint preserves epimorphisms and coproducts.
-/

@[expose] public section

open CategoryTheory Limits

universe w u₁ u₂ v v' u u'

namespace LeanPool.ClassifyingTopoi

variable {E : Type u} [Category.{v} E] {E' : Type u'} [Category.{v'} E']

/-- The image of a strong epimorphism followed by a monomorphism `m` is `m`. -/
theorem imageSubobject_strongEpi_comp_mono {C : Type*} [Category C] [HasImages C] {A I X : C}
    (e : A ⟶ I) (m : I ⟶ X) [StrongEpi e] [Mono m] :
    imageSubobject (e ≫ m) = Subobject.mk m := by
  refine le_antisymm (imageSubobject_le_mk m _ e rfl) ?_
  have sq : CommSq (factorThruImageSubobject (e ≫ m)) e (imageSubobject (e ≫ m)).arrow m :=
    ⟨imageSubobject_arrow_comp _⟩
  exact Subobject.mk_le_of_comm sq.lift sq.fac_right

section MapSubobject

variable (F : E ⥤ E') [F.PreservesMonomorphisms]

/-- The image of a subobject `S` of `X` under a functor `F` preserving monomorphisms, followed by
an isomorphism `c : F X ⟶ Y`: the subobject `F S ⟶ F X ⟶ Y` of `Y`. -/
noncomputable abbrev mapSubobject {X : E} {Y : E'} (c : F.obj X ⟶ Y) [IsIso c] (S : Subobject X) :
    Subobject Y :=
  Subobject.mk (F.map S.arrow ≫ c)

variable {F}

/-- `mapSubobject` is monotone. -/
theorem mapSubobject_mono {X : E} {Y : E'} (c : F.obj X ⟶ Y) [IsIso c] {S T : Subobject X}
    (h : S ≤ T) : mapSubobject F c S ≤ mapSubobject F c T :=
  Subobject.mk_le_mk_of_comm (F.map (Subobject.ofLE S T h))
    (by rw [← F.map_comp_assoc, Subobject.ofLE_arrow])

/-- `mapSubobject` on the subobject generated by a monomorphism. -/
theorem mapSubobject_mk {X A : E} {Y : E'} (c : F.obj X ⟶ Y) [IsIso c] (m : A ⟶ X) [Mono m] :
    mapSubobject F c (Subobject.mk m) = Subobject.mk (F.map m ≫ c) :=
  Subobject.mk_eq_mk_of_comm _ _ (F.mapIso (Subobject.underlyingIso m))
    (by simp [← F.map_comp_assoc])

/-- `mapSubobject` preserves the top subobject. -/
theorem mapSubobject_top {X : E} {Y : E'} (c : F.obj X ⟶ Y) [IsIso c] :
    mapSubobject F c (⊤ : Subobject X) = ⊤ :=
  Subobject.mk_eq_top_of_isIso _

/-- A morphism factors through `mapSubobject F c S` when, composed with `c⁻¹`, it factors
through `F S`. -/
theorem mapSubobject_factors_iff {X : E} {Y : E'} (c : F.obj X ⟶ Y) [IsIso c] (S : Subobject X)
    {Z : E'} (f : Z ⟶ Y) :
    (mapSubobject F c S).Factors f ↔ ∃ g, g ≫ F.map S.arrow = f ≫ inv c := by
  constructor
  · intro hf
    obtain ⟨g, hg⟩ := (Subobject.mk_factors_iff _ _).1 hf
    let g' : Z ⟶ F.obj (S : E) := g
    have hg' : g' ≫ F.map S.arrow ≫ c = f := hg
    exact ⟨g', by rw [← hg']; simp⟩
  · rintro ⟨g, hg⟩
    refine (Subobject.mk_factors_iff _ _).2 ⟨g, ?_⟩
    change g ≫ F.map S.arrow ≫ c = f
    rw [reassoc_of% hg]
    simp

/-- `mapSubobject` preserves meets when `F` preserves pullbacks. -/
theorem mapSubobject_inf [HasPullbacks E] [HasPullbacks E']
    [PreservesLimitsOfShape WalkingCospan F]
    {X : E} {Y : E'} (c : F.obj X ⟶ Y) [IsIso c] (S T : Subobject X) :
    mapSubobject F c (S ⊓ T) = mapSubobject F c S ⊓ mapSubobject F c T := by
  refine le_antisymm
    (le_inf (mapSubobject_mono c inf_le_left) (mapSubobject_mono c inf_le_right))
    (Subobject.le_of_factors ?_)
  obtain ⟨g₁, h₁⟩ :=
    (mapSubobject_factors_iff c S _).1 (Subobject.inf_arrow_factors_left _ _)
  obtain ⟨g₂, h₂⟩ :=
    (mapSubobject_factors_iff c T _).1 (Subobject.inf_arrow_factors_right _ _)
  have hP := (Subobject.inf_isPullback S T).map F
  refine (mapSubobject_factors_iff c _ _).2 ⟨hP.lift g₁ g₂ (h₁.trans h₂.symm), ?_⟩
  rw [← Subobject.ofLE_arrow (inf_le_left : S ⊓ T ≤ S), F.map_comp, hP.lift_fst_assoc, h₁]


/-- The image of `e ≫ F g ≫ c`, for `e` epi and `c` iso, is the image under `F` of the image of
`g`, when `F` preserves epimorphisms and epimorphisms of `E'` are strong. -/
theorem imageSubobject_epi_comp_map [HasEqualizers E] [HasImages E] [HasImages E']
    [StrongEpiCategory E'] [F.PreservesEpimorphisms] {A X : E} {A' Y : E'} (e : A' ⟶ F.obj A)
    [Epi e] (g : A ⟶ X) (c : F.obj X ⟶ Y) [IsIso c] :
    imageSubobject (e ≫ F.map g ≫ c) = mapSubobject F c (imageSubobject g) := by
  have : StrongEpi (e ≫ F.map (factorThruImageSubobject g)) := strongEpi_of_epi _
  have h : e ≫ F.map g ≫ c =
      (e ≫ F.map (factorThruImageSubobject g)) ≫ (F.map (imageSubobject g).arrow ≫ c) := by
    rw [Category.assoc, ← F.map_comp_assoc, imageSubobject_arrow_comp]
  rw [h, imageSubobject_strongEpi_comp_mono]

/-- The image of `F g ≫ c` is the image under `F` of the image of `g`. -/
theorem imageSubobject_map_comp [HasEqualizers E] [HasImages E] [HasImages E']
    [StrongEpiCategory E'] [F.PreservesEpimorphisms] {A X : E} {Y : E'}
    (g : A ⟶ X) (c : F.obj X ⟶ Y) [IsIso c] :
    imageSubobject (F.map g ≫ c) = mapSubobject F c (imageSubobject g) := by
  simpa using imageSubobject_epi_comp_map (𝟙 _) g c

/-- `mapSubobject` preserves equalizers when `F` does. -/
theorem mapSubobject_equalizerSubobject [HasEqualizers E] [HasEqualizers E']
    [PreservesLimitsOfShape WalkingParallelPair F] {X Z : E} {Y : E'} (c : F.obj X ⟶ Y) [IsIso c]
    (f g : X ⟶ Z) :
    mapSubobject F c (equalizerSubobject f g) =
      equalizerSubobject (inv c ≫ F.map f) (inv c ≫ F.map g) := by
  refine le_antisymm ?_ (Subobject.le_of_factors ?_)
  · rw [mapSubobject]
    exact Subobject.mk_le_of_comm ((equalizerSubobject _ _).factorThru _
      (equalizerSubobject_factors _ _ _ (by
        simp only [Category.assoc, IsIso.hom_inv_id_assoc, ← F.map_comp]
        rw [equalizerSubobject_arrow_comp]))) (Subobject.factorThru_arrow _ _ _)
  · have w := equalizerSubobject_arrow_comp (inv c ≫ F.map f) (inv c ≫ F.map g)
    simp only [← Category.assoc] at w
    refine (mapSubobject_factors_iff c _ _).2
      ⟨equalizer.lift _ w ≫ inv (equalizerComparison f g F) ≫
        F.map (equalizerSubobjectIso f g).inv, ?_⟩
    rw [Category.assoc, Category.assoc, ← F.map_comp, equalizerSubobject_arrow',
      (IsIso.inv_comp_eq _).2 (equalizerComparison_comp_π f g F).symm, equalizer.lift_ι]

/-- `mapSubobject` commutes with pullbacks when `F` preserves pullbacks. -/
theorem mapSubobject_pullback [HasPullbacks E] [HasPullbacks E']
    [PreservesLimitsOfShape WalkingCospan F]
    {X Z : E} {Y W : E'} (c : F.obj X ⟶ Y) [IsIso c] (d : F.obj Z ⟶ W) [IsIso d] (h : X ⟶ Z)
    (S : Subobject Z) :
    mapSubobject F c ((Subobject.pullback h).obj S) =
      (Subobject.pullback (inv c ≫ F.map h ≫ d)).obj (mapSubobject F d S) := by
  have hP := (Subobject.isPullback h S).map F
  have hQ : IsPullback (F.map (Subobject.pullbackπ h S))
      (F.map ((Subobject.pullback h).obj S).arrow ≫ c) (F.map S.arrow ≫ d)
      (inv c ≫ F.map h ≫ d) :=
    IsPullback.of_iso hP (Iso.refl _) (Iso.refl _) (asIso c) (asIso d) (by simp) (by simp)
      (by simp) (by simp)
  exact (Subobject.pullback_obj_mk hQ).symm

/-- `mapSubobject` commutes with existential quantification (images along a morphism). -/
theorem mapSubobject_exists [HasEqualizers E] [HasImages E] [HasImages E'] [StrongEpiCategory E']
    [F.PreservesEpimorphisms] {X Z : E} {Y W : E'} (c : F.obj X ⟶ Y) [IsIso c]
    (d : F.obj Z ⟶ W) [IsIso d] (h : X ⟶ Z) (S : Subobject X) :
    mapSubobject F d ((Subobject.exists h).obj S) =
      (Subobject.exists (inv c ≫ F.map h ≫ d)).obj (mapSubobject F c S) := by
  have e : (mapSubobject F c S).arrow =
      (Subobject.underlyingIso (F.map S.arrow ≫ c)).hom ≫ F.map S.arrow ≫ c :=
    (Subobject.underlyingIso_hom_comp_eq_mk _).symm
  rw [Subobject.exists_eq_imageSubobject, Subobject.exists_eq_imageSubobject, e]
  simp only [Category.assoc, IsIso.hom_inv_id_assoc, ← F.map_comp_assoc]
  exact (imageSubobject_epi_comp_map _ _ _).symm


/-- `mapSubobject` preserves the image of a coproduct of subobjects (their supremum) when
`F` preserves coproducts. -/
theorem mapSubobject_imageSubobject_sigmaDesc [HasEqualizers E] [HasImages E] [HasImages E']
    [StrongEpiCategory E'] [F.PreservesEpimorphisms] {ι : Type w} [HasCoproductsOfShape ι E]
    [HasCoproductsOfShape ι E'] [PreservesColimitsOfShape (Discrete ι) F] {X : E} {Y : E'}
    (c : F.obj X ⟶ Y) [IsIso c] (S : ι → Subobject X) :
    mapSubobject F c (imageSubobject (Sigma.desc fun i => (S i).arrow)) =
      imageSubobject (Sigma.desc fun i => (mapSubobject F c (S i)).arrow) := by
  have e : (Sigma.desc fun i => (mapSubobject F c (S i)).arrow) =
      (Limits.Sigma.map fun i => (Subobject.underlyingIso (F.map (S i).arrow ≫ c)).hom) ≫
        sigmaComparison F (fun i => (S i : E)) ≫
          F.map (Sigma.desc fun i => (S i).arrow) ≫ c := by
    ext i
    simp
  rw [e, ← Category.assoc]
  have : Epi ((Limits.Sigma.map fun i =>
      (Subobject.underlyingIso (F.map (S i).arrow ≫ c)).hom) ≫
      sigmaComparison F (fun i => (S i : E))) := inferInstance
  exact (imageSubobject_epi_comp_map _ _ c).symm

end MapSubobject

variable {L : FirstOrder.Language.{u₁, u₂}}

namespace CatStructure

/-- The image of a structure under a functor preserving finite products: the carrier
`F A`, the function symbols through the comparison `F (Aᵏ) ≅ (F A)ᵏ`. -/
noncomputable abbrev map [HasFiniteProducts E]
    [HasFiniteProducts E'] (M : CatStructure L E) (F : E ⥤ E') [PreservesFiniteProducts F] :
    CatStructure L E' where
  carrier := F.obj M.carrier
  funMap f := inv (piComparison F fun _ => M.carrier) ≫ F.map (M.funMap f)
  relMap R := Over.mk (F.map (M.relMap R).hom ≫ piComparison F fun _ => M.carrier)

section
variable [HasFiniteProducts E] [HasFiniteProducts E'] (M : CatStructure L E) (F : E ⥤ E')
  [PreservesFiniteProducts F]

omit [PreservesFiniteProducts F] in
/-- A functor applied to a map into a power, through the comparison morphism. -/
theorem map_piLift {X A : E} {Y : E'} (a : Y ⟶ F.obj X) {k : ℕ} (g : Fin k → (X ⟶ A)) :
    (Pi.lift fun j => a ≫ F.map (g j)) =
      a ≫ F.map (Pi.lift g) ≫ piComparison F fun _ : Fin k => A := by
  ext j
  simp

/-- Terms in `M.map F` are interpreted by `F` of their interpretation in `M`. -/
theorem termMap_map {n : ℕ} (t : L.Term (Fin n)) :
    (M.map F).termMap t =
      inv (piComparison F fun _ : Fin n => M.carrier) ≫ F.map (M.termMap t) := by
  induction t with
  | var i =>
    simp [termMap, map]
  | func f ts ih =>
    rw [termMap, termMap]
    simp only [ih]
    rw [map_piLift]
    simp only [Category.assoc, IsIso.hom_inv_id_assoc, F.map_comp]
end

section

variable [HasFiniteLimits E] [HasImages E] [HasCoproducts.{w} E] [HasFiniteLimits E']
  [HasImages E'] [HasCoproducts.{w} E'] [StrongEpiCategory E'] (M : CatStructure L E)
  (F : E ⥤ E') [PreservesFiniteLimits F] [F.PreservesEpimorphisms]
  [∀ ι : Type w, PreservesColimitsOfShape (Discrete ι) F]

/-- The interpretation of a geometric formula in `M.map F` is the image under `F` of its
interpretation in `M`, transported along the comparison `F (Aⁿ) ≅ (F A)ⁿ`. -/
theorem interp_map {n : ℕ} (φ : GeometricFormula.{w} L n) :
    (M.map F).interp φ =
      mapSubobject F (piComparison F fun _ : Fin n => M.carrier) (M.interp φ) := by
  induction φ with
  | top => rw [interp, interp, mapSubobject_top]
  | and φ ψ ihφ ihψ => rw [interp, interp, ihφ, ihψ, mapSubobject_inf]
  | @iSup m ι φ ih =>
    rw [interp, interp, mapSubobject_imageSubobject_sigmaDesc]
    exact congrArg (fun S : ι → Subobject ((M.map F).pow m) =>
      imageSubobject (Sigma.desc fun i => (S i).arrow)) (funext ih)
  | equal t₁ t₂ =>
    rw [interp, interp, mapSubobject_equalizerSubobject]
    simp only [termMap_map]
  | rel R ts =>
    rw [interp, interp, mapSubobject_pullback _ (piComparison F fun _ => M.carrier),
      ← imageSubobject_map_comp]
    simp only [termMap_map]
    rw [map_piLift]
    rfl
  | @ex m φ ih =>
    have key : (Pi.lift fun i : Fin m => Pi.π (fun _ : Fin (m + 1) => F.obj M.carrier)
        i.castSucc) = inv (piComparison F fun _ : Fin (m + 1) => M.carrier) ≫
          F.map (Pi.lift fun i : Fin m => Pi.π (fun _ : Fin (m + 1) => M.carrier) i.castSucc) ≫
          piComparison F fun _ : Fin m => M.carrier := by
      rw [← map_piLift]
      congr 1
      funext i
      simp
    rw [interp, interp, ih,
      mapSubobject_exists (piComparison F fun _ : Fin (m + 1) => M.carrier)
        (piComparison F fun _ : Fin m => M.carrier), key]

variable {M} in
/-- A functor preserving finite limits, epimorphisms and coproducts indexed by `Type w`, into a
strong-epi category, maps models of a geometric theory to models. -/
theorem IsModel.map_of_preserves {T : GeometricTheory.{w} L} (hM : M.IsModel T) :
    (M.map F).IsModel T := fun σ hσ => by
  rw [interp_map, interp_map]
  exact mapSubobject_mono _ (hM σ hσ)

end

attribute [local instance high] Sheaf.instHasColimitsOfShape in
/-- The inverse image of a geometric morphism between sheaf topoi, a left exact left
adjoint, maps models to models. -/
theorem IsModel.map {C D : Type u} [SmallCategory C] [SmallCategory D]
    {J : GrothendieckTopology C} {K : GrothendieckTopology D} {T : GeometricTheory.{u} L}
    {M : CatStructure L (Sheaf J (Type u))} (hM : M.IsModel T)
    (F : Sheaf J (Type u) ⥤ Sheaf K (Type u)) [PreservesFiniteLimits F] [F.IsLeftAdjoint] :
    (M.map F).IsModel T :=
  hM.map_of_preserves F

end CatStructure
end LeanPool.ClassifyingTopoi

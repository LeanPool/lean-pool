module

public import LeanPool.ToposTheoreticBridges.ClassifyingTopoi.CatSemantics
public import LeanPool.ToposTheoreticBridges.ClassifyingTopoi.Semantics
public import Mathlib.CategoryTheory.Limits.Types.Colimits
public import Mathlib.CategoryTheory.Limits.Types.Coproducts
public import Mathlib.CategoryTheory.Limits.Types.Images
public import Mathlib.CategoryTheory.Limits.Types.Limits
public import Mathlib.CategoryTheory.Limits.Types.Products

/-!
# The categorical semantics in `Type u` is the set-theoretic one

A structure on a type `M : Type u` is a structure `CatStructure.ofStructure M` in the category
`Type u`: products are the types of functions `Fin k → M` (through `Types.productIso`), and a
relation is interpreted by the inclusion of the subtype of the tuples where it holds.

## Main results

* `LeanPool.ClassifyingTopoi.CatStructure.range_interp_ofStructure`: the interpretation of a
  geometric formula in `ofStructure M`, a subobject of `Mⁿ`, is (through `Set.range` of its
  arrow) the set of tuples realizing the formula;
* `LeanPool.ClassifyingTopoi.CatStructure.isModel_ofStructure_iff`: `ofStructure M` is a model of
  a geometric theory exactly when `M` is a set-model of it.

## Implementation notes

A subobject `S` of a type `X` is read through the set `Set.range S.arrow`; the order of
subobjects is inclusion of these sets (`TypeSubobject.le_iff_range_subset`), and membership of
`x` is the factorisation of the point `homOfElement x` through `S`
(`TypeSubobject.mem_range_arrow_iff`). The operations used by `CatStructure.interp` are then
computed one at a time: `⊤` is the whole type, meets are intersections, equalizers are the sets
where two functions agree, pullbacks are preimages, images (and hence `Subobject.exists`) are
ranges, and the range of a map out of a coproduct is the union of the ranges of its components.
-/

@[expose] public section

open CategoryTheory Limits TypeCat

universe u u₁ u₂

namespace LeanPool.ClassifyingTopoi.TypeSubobject

variable {X Y : Type u}

/-- An element lies in a subobject of a type exactly when the corresponding point factors
through it. -/
theorem mem_range_arrow_iff (S : Subobject X) (x : X) :
    x ∈ Set.range S.arrow ↔ S.Factors (homOfElement x) := by
  constructor
  · rintro ⟨y, rfl⟩
    exact (Subobject.factors_iff _ _).2 ⟨homOfElement y, rfl⟩
  · intro h
    refine ⟨S.factorThru _ h PUnit.unit, ?_⟩
    exact types_congr_hom (S.factorThru_arrow _ h) PUnit.unit

/-- The order of subobjects of a type is the inclusion of the ranges of their arrows. -/
theorem le_iff_range_subset (P Q : Subobject X) :
    P ≤ Q ↔ Set.range P.arrow ⊆ Set.range Q.arrow := by
  constructor
  · intro h
    rintro _ ⟨y, rfl⟩
    exact ⟨Subobject.ofLE P Q h y, types_congr_hom (Subobject.ofLE_arrow h) y⟩
  · intro h
    refine Subobject.le_of_factors ((Subobject.factors_iff _ _).2
      ⟨ofHom fun y => (h ⟨y, rfl⟩).choose, ?_⟩)
    ext y
    exact (h ⟨y, rfl⟩).choose_spec

/-- The subobject generated by a monomorphism of types is its range. -/
theorem range_mk_arrow {A : Type u} (f : A ⟶ X) [Mono f] :
    Set.range (Subobject.mk f).arrow = Set.range f := by
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    rw [← Subobject.underlyingIso_hom_comp_eq_mk]
    exact ⟨_, rfl⟩
  · rintro ⟨a, rfl⟩
    exact ⟨(Subobject.underlyingIso f).inv a,
      types_congr_hom (Subobject.underlyingIso_arrow f) a⟩

/-- The top subobject of a type is the whole type. -/
theorem range_top : Set.range (⊤ : Subobject X).arrow = Set.univ := by
  ext x
  simp only [Set.mem_univ, iff_true]
  exact (mem_range_arrow_iff _ _).2 (Subobject.top_factors _)

/-- Meets of subobjects of a type are intersections. -/
theorem range_inf (P Q : Subobject X) :
    Set.range (P ⊓ Q).arrow = Set.range P.arrow ∩ Set.range Q.arrow := by
  ext x
  simp only [Set.mem_inter_iff, mem_range_arrow_iff, Subobject.inf_factors]

/-- The image of a function, as a subobject, is its range. -/
theorem range_imageSubobject_arrow {A : Type u} (f : A ⟶ X) :
    Set.range (imageSubobject f).arrow = Set.range f := by
  apply le_antisymm
  · let m : (Set.range f : Type u) ⟶ X := ofHom Subtype.val
    have : Mono m := (ofHom_mono_iff_injective _).2 Subtype.val_injective
    have : imageSubobject f ≤ Subobject.mk m :=
      imageSubobject_le_mk m f (ofHom fun a => ⟨f a, a, rfl⟩) rfl
    refine ((le_iff_range_subset _ _).1 this).trans ?_
    rw [range_mk_arrow]
    exact fun _ ⟨y, hy⟩ => hy ▸ y.2
  · rintro _ ⟨a, rfl⟩
    exact ⟨factorThruImageSubobject f a, types_congr_hom (imageSubobject_arrow_comp f) a⟩


/-- The equalizer of two functions, as a subobject, is the set where they agree. -/
theorem range_equalizerSubobject_arrow (f g : X ⟶ Y) :
    Set.range (equalizerSubobject f g).arrow = {x | f x = g x} := by
  ext x
  rw [mem_range_arrow_iff, equalizerSubobject_factors_iff]
  constructor
  · intro h
    exact types_congr_hom h PUnit.unit
  · intro h
    ext
    exact h

/-- The pullback of a subobject of a type along a function is the preimage. -/
theorem range_pullback_arrow (f : X ⟶ Y) (S : Subobject Y) :
    Set.range ((Subobject.pullback f).obj S).arrow = f ⁻¹' Set.range S.arrow := by
  ext x
  rw [mem_range_arrow_iff, Limits.pullback_factors_iff, Set.mem_preimage, mem_range_arrow_iff]
  rfl

/-- The image of a subobject of a type along a function is the image set. -/
theorem range_exists_arrow (f : X ⟶ Y) (S : Subobject X) :
    Set.range ((Subobject.exists f).obj S).arrow = f '' Set.range S.arrow := by
  rw [Subobject.exists_eq_imageSubobject, range_imageSubobject_arrow, types_comp, Set.range_comp]

/-- The range of a map out of a coproduct of types is the union of the ranges of its
components. -/
theorem range_sigmaDesc {ι : Type u} {A : ι → Type u} (g : ∀ i, A i ⟶ X) :
    Set.range (Sigma.desc g) = ⋃ i, Set.range (g i) := by
  ext x
  simp only [Set.mem_iUnion, Set.mem_range]
  constructor
  · rintro ⟨y, rfl⟩
    obtain ⟨⟨i⟩, a, rfl⟩ := Types.jointly_surjective' y
    exact ⟨i, a, (types_congr_hom (Sigma.ι_comp_desc g i) a).symm⟩
  · rintro ⟨i, a, rfl⟩
    exact ⟨Sigma.ι A i a, types_congr_hom (Sigma.ι_comp_desc g i) a⟩

/-- The components of the comparison `∏ᶜ (fun _ => M) ≅ (Fin n → M)` are the projections. -/
theorem productIso_hom_apply (M : Type u) {n : ℕ} (x : ∏ᶜ fun _ : Fin n => M) (i : Fin n) :
    (Types.productIso _).hom x i = Pi.π (fun _ : Fin n => M) i x := by
  simp

/-- The comparison `∏ᶜ (fun _ => M) ≅ (Fin n → M)` is injective. -/
theorem productIso_hom_injective (M : Type u) {n : ℕ} :
    Function.Injective (Types.productIso fun _ : Fin n => M).hom := fun a b h => by
  simpa using congrArg (Types.productIso fun _ : Fin n => M).inv h

/-- The tuple of components of a map into a power of `M`. -/
theorem productIso_hom_piLift (M : Type u) {n k : ℕ} (g : Fin k → ((∏ᶜ fun _ : Fin n => M) ⟶ M))
    (x : ∏ᶜ fun _ : Fin n => M) :
    (Types.productIso fun _ : Fin k => M).hom (Pi.lift g x) = fun i => g i x := by
  funext i
  rw [productIso_hom_apply M, Types.pi_lift_π_apply]

end LeanPool.ClassifyingTopoi.TypeSubobject

namespace LeanPool.ClassifyingTopoi
open TypeSubobject
variable {L : FirstOrder.Language.{u₁, u₂}}

namespace CatStructure

/-- A structure on a type, as a structure in the category `Type u`. -/
noncomputable abbrev ofStructure (M : Type u) [L.Structure M] :
    CatStructure L (Type u) where
  carrier := M
  funMap f :=
    (Types.productIso _).hom ≫ TypeCat.ofHom fun x => FirstOrder.Language.Structure.funMap f x
  relMap {k} R := Over.mk
    (TypeCat.ofHom
      (fun x : {x : Fin k → M // FirstOrder.Language.Structure.RelMap R x} => x.1) ≫
      (Types.productIso _).inv)

variable (M : Type u) [L.Structure M]

/-- Function symbols in `ofStructure M` are interpreted by `Structure.funMap`. -/
theorem ofStructure_funMap_apply {k : ℕ} (f : L.Functions k) (y : ∏ᶜ fun _ : Fin k => M) :
    ((ofStructure M).funMap f y : M) =
      FirstOrder.Language.Structure.funMap f ((Types.productIso _).hom y) :=
  rfl

/-- Terms in `ofStructure M` are interpreted by `Term.realize`. -/
theorem termMap_ofStructure {n : ℕ} (t : L.Term (Fin n)) (x : ∏ᶜ fun _ : Fin n => M) :
    ((ofStructure M).termMap t x : M) = t.realize ((Types.productIso _).hom x) := by
  induction t with
  | var i => simp [termMap]
  | func f ts ih =>
    change ((ofStructure M).funMap f ((Pi.lift fun j => (ofStructure M).termMap (ts j)) x) : M) = _
    rw [ofStructure_funMap_apply]
    refine congrArg (FirstOrder.Language.Structure.funMap f) (funext fun j => ?_)
    rw [productIso_hom_apply M, Types.pi_lift_π_apply]
    exact ih j

/-- The interpretation of a geometric formula in `ofStructure M` is the set of tuples
realizing it. -/
theorem range_interp_ofStructure {n : ℕ} (φ : GeometricFormula.{u} L n) :
    Set.range ((ofStructure M).interp φ).arrow =
      {x | φ.Realize ((Types.productIso fun _ : Fin n => M).hom x)} := by
  induction φ with
  | top =>
    rw [interp, range_top]
    rfl
  | and φ ψ ihφ ihψ =>
    rw [interp, range_inf, ihφ, ihψ]
    rfl
  | iSup φ ih =>
    rw [interp, range_imageSubobject_arrow, range_sigmaDesc]
    simp only [ih]
    ext x
    simp [GeometricFormula.Realize]
  | equal t₁ t₂ =>
    rw [interp, range_equalizerSubobject_arrow]
    ext x
    change _ = _ ↔ _ = _
    rw [termMap_ofStructure, termMap_ofStructure]
  | rel R ts =>
    rw [interp, range_pullback_arrow, range_imageSubobject_arrow]
    ext x
    simp only [Set.mem_preimage, Set.mem_range, Set.mem_ofPred_eq, GeometricFormula.Realize]
    constructor
    · rintro ⟨y, hy⟩
      have := congrArg (Types.productIso fun _ : Fin _ => M).hom hy
      rw [productIso_hom_piLift] at this
      simp only [Over.mk_hom, types_comp_apply, Iso.inv_hom_id_apply] at this
      simp_rw [← termMap_ofStructure, ← this]
      exact y.2
    · intro h
      refine ⟨⟨_, h⟩, productIso_hom_injective M ?_⟩
      rw [productIso_hom_piLift]
      simp only [Over.mk_hom, types_comp_apply, Iso.inv_hom_id_apply]
      exact funext fun i => (termMap_ofStructure M (ts i) x).symm
  | @ex m φ ih =>
    rw [interp, range_exists_arrow, ih]
    ext y
    simp only [Set.mem_image, Set.mem_ofPred_eq, GeometricFormula.Realize]
    have key : ∀ x : ∏ᶜ fun _ : Fin (m + 1) => M,
        (Types.productIso fun _ : Fin m => M).hom
          ((Pi.lift fun i : Fin m => Pi.π (fun _ : Fin (m + 1) => M) i.castSucc) x) =
        Fin.init ((Types.productIso fun _ : Fin (m + 1) => M).hom x) := fun x => by
      rw [productIso_hom_piLift]
      funext i
      rw [Fin.init, productIso_hom_apply]
    constructor
    · rintro ⟨x, hx, rfl⟩
      refine ⟨(Types.productIso fun _ : Fin _ => M).hom x (Fin.last _), ?_⟩
      rwa [key, Fin.snoc_init_self]
    · rintro ⟨a, ha⟩
      refine ⟨(Types.productIso fun _ : Fin _ => M).inv
        (Fin.snoc ((Types.productIso fun _ : Fin _ => M).hom y) a), ?_, ?_⟩
      · simpa using ha
      · apply productIso_hom_injective M
        rw [key]
        simp

/-- Inclusion of interpretations in `ofStructure M` is the validity of the sequent in `M`. -/
theorem interp_ofStructure_le_iff {n : ℕ} (φ ψ : GeometricFormula.{u} L n) :
    (ofStructure M).interp φ ≤ (ofStructure M).interp ψ ↔
      ∀ x : Fin n → M, φ.Realize x → ψ.Realize x := by
  rw [le_iff_range_subset, range_interp_ofStructure, range_interp_ofStructure]
  constructor
  · intro h x hx
    have := @h ((Types.productIso fun _ : Fin n => M).inv x) (by simpa using hx)
    simpa using this
  · intro h x hx
    exact h _ hx

/-- The categorical semantics in `Type u` is the set-theoretic one. -/
theorem isModel_ofStructure_iff (T : GeometricTheory.{u} L) (M : Type u)
    [L.Structure M] : (CatStructure.ofStructure M).IsModel T ↔ T.IsSetModel M :=
  forall₂_congr fun σ _ => interp_ofStructure_le_iff M σ.lhs σ.rhs

end CatStructure
end LeanPool.ClassifyingTopoi

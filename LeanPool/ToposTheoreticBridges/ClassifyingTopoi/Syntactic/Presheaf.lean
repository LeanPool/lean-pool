module

public import LeanPool.ToposTheoreticBridges.ClassifyingTopoi.NormalFormSemantics

/-!
# Structures in presheaf topoi, pointwise

A structure `P` in a category of functors `D ⥤ Type w` has, at each object `d`, a structure on
the type `P.carrier.obj d` (`CatStructure.fiberStr P d`), obtained by evaluation. This file
proves that everything about `P` is computed pointwise:

* `LeanPool.ClassifyingTopoi.Syntactic.secEquiv`: the sections of a power `Xⁿ` at `d` are the
  `n`-tuples of sections of `X` at `d`;
* `LeanPool.ClassifyingTopoi.Syntactic.mem_range_interp_app_iff`: a section lies in the
  interpretation of a geometric formula iff its tuple realizes the formula in the fiber
  structure (Kripke–Joyal semantics for presheaves);
* `LeanPool.ClassifyingTopoi.Syntactic.isHom_of_forall`: a morphism of carriers which is a
  homomorphism of fiber structures at each object is a homomorphism;
* `LeanPool.ClassifyingTopoi.Syntactic.le_iff_range_app_subset`,
  `range_app_imageSubobject`, `range_app_pullback`: the order, images and pullbacks of
  subobjects of presheaves, objectwise.
-/

@[expose] public section

universe w u₁ u₂

namespace LeanPool.ClassifyingTopoi.Syntactic

open FirstOrder FirstOrder.Language CategoryTheory CategoryTheory.Limits LeanPool.ClassifyingTopoi

variable {D : Type*} [Category D]

section Subobjects

/-- The objectwise range of the subobject generated by a monomorphism. -/
theorem range_app_mk {X A : D ⥤ Type w} (m : A ⟶ X) [Mono m] (d : D) :
    Set.range ((Subobject.mk m).arrow.app d) = Set.range (m.app d) := by
  rw [← Subobject.underlyingIso_hom_comp_eq_mk, NatTrans.comp_app]
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    exact ⟨_, rfl⟩
  · rintro ⟨y, rfl⟩
    refine ⟨((Subobject.underlyingIso m).inv.app d) y, ?_⟩
    rw [types_comp_apply, ← types_comp_apply ((Subobject.underlyingIso m).inv.app d),
      ← NatTrans.comp_app, Iso.inv_hom_id]
    rfl

/-- The objectwise range of the image of a morphism of functors to types. -/
theorem range_app_imageSubobject {X A : D ⥤ Type w} (g : A ⟶ X) (d : D) :
    Set.range ((imageSubobject g).arrow.app d) = Set.range (g.app d) := by
  have h := imageSubobject_map_comp (F := (evaluation D (Type w)).obj d) g (𝟙 _)
  have h' := congrArg (fun S => Set.range S.arrow) h
  dsimp only at h'
  rw [TypeSubobject.range_imageSubobject_arrow, TypeSubobject.range_mk_arrow] at h'
  simpa using h'.symm

/-- The objectwise range of a pullback of subobjects of functors to types. -/
theorem range_app_pullback {X Y : D ⥤ Type w} (f : X ⟶ Y) (S : Subobject Y) (d : D) :
    Set.range (((Subobject.pullback f).obj S).arrow.app d) =
      (f.app d) ⁻¹' Set.range (S.arrow.app d) := by
  have h := mapSubobject_pullback (F := (evaluation D (Type w)).obj d) (𝟙 _) (𝟙 _) f S
  have h' := congrArg (fun S => Set.range S.arrow) h
  simp only [TypeSubobject.range_pullback_arrow, TypeSubobject.range_mk_arrow] at h'
  simpa using h'

end Subobjects

/-- Membership in the range of a map followed by an isomorphism of types. -/
theorem mem_range_comp_iso_iff {A B C : Type w} (g : A ⟶ B) (e : B ≅ C) (y : C) :
    y ∈ Set.range (g ≫ e.hom) ↔ e.inv y ∈ Set.range g := by
  constructor
  · rintro ⟨a, rfl⟩
    exact ⟨a, by simp⟩
  · rintro ⟨a, ha⟩
    exact ⟨a, by rw [types_comp_apply, ha, ← types_comp_apply e.inv, Iso.inv_hom_id,
      types_id_apply]⟩

section Powers

variable (X : D ⥤ Type w) (k : ℕ) (d : D)

/-- The sections at `d` of the `k`-th power of a functor to types are the `k`-tuples of
sections. -/
noncomputable def secEquiv : (∏ᶜ fun _ : Fin k => X).obj d ≃ (Fin k → X.obj d) :=
  (asIso (piComparison ((evaluation D (Type w)).obj d) fun _ => X) ≪≫
    Types.productIso _).toEquiv

variable {X k d}

/-- The components of the tuple of a section of a power are its projections. -/
@[simp]
theorem secEquiv_apply (z : (∏ᶜ fun _ : Fin k => X).obj d) (i : Fin k) :
    secEquiv X k d z i = (Pi.π (fun _ : Fin k => X) i).app d z := by
  change (Types.productIso _).hom (piComparison ((evaluation D (Type w)).obj d) _ z) i = _
  rw [Types.productIso_hom_comp_eval_apply, ← types_comp_apply (piComparison _ _),
    piComparison_comp_π]
  rfl

/-- The tuple of a section of a power is natural. -/
theorem secEquiv_map {d' : D} (g : d ⟶ d') (z : (∏ᶜ fun _ : Fin k => X).obj d) :
    secEquiv X k d' ((∏ᶜ fun _ : Fin k => X).map g z) = X.map g ∘ secEquiv X k d z := by
  funext i
  simp [NatTrans.naturality_apply]

/-- The tuple of the image of a section under a map of powers. -/
theorem secEquiv_piMap {X' : D ⥤ Type w} (h : X ⟶ X') (z : (∏ᶜ fun _ : Fin k => X).obj d) :
    secEquiv X' k d ((Limits.Pi.map fun _ => h).app d z) = h.app d ∘ secEquiv X k d z := by
  funext i
  simp only [secEquiv_apply, Function.comp_apply]
  rw [← NatTrans.comp_app_apply, Limits.Pi.map_π, NatTrans.comp_app_apply]

/-- The section of a power with given tuple, under a map of powers. -/
theorem piMap_app_secEquiv_symm {X' : D ⥤ Type w} (h : X ⟶ X') (x : Fin k → X.obj d) :
    (Limits.Pi.map fun _ => h).app d ((secEquiv X k d).symm x) =
      (secEquiv X' k d).symm (h.app d ∘ x) := by
  rw [Equiv.eq_symm_apply, secEquiv_piMap, Equiv.apply_symm_apply]

end Powers

end LeanPool.ClassifyingTopoi.Syntactic

namespace LeanPool.ClassifyingTopoi.CatStructure

open FirstOrder FirstOrder.Language CategoryTheory CategoryTheory.Limits
  LeanPool.ClassifyingTopoi.Syntactic

variable {D : Type*} [Category D] {L : Language.{u₁, u₂}}

/-- The structure induced on the sections at `d` of the carrier of a structure in a category of
functors to types. -/
@[instance_reducible]
noncomputable def fiberStr (P : CatStructure L (D ⥤ Type w)) (d : D) :
    L.Structure (P.carrier.obj d) :=
  (P.map ((evaluation D (Type w)).obj d)).toStructure

variable (P : CatStructure L (D ⥤ Type w)) (d : D)

/-- Function symbols in the fiber structure. -/
theorem fiberStr_funMap {k : ℕ} (f : L.Functions k)
    (x : Fin k → P.carrier.obj d) :
    (P.fiberStr d).funMap f x = (P.funMap f).app d ((secEquiv _ k d).symm x) :=
  rfl

/-- Relation symbols in the fiber structure. -/
theorem fiberStr_relMap {k : ℕ} (R : L.Relations k)
    (x : Fin k → P.carrier.obj d) :
    (P.fiberStr d).RelMap R x ↔
      (secEquiv _ k d).symm x ∈ Set.range ((P.relMap R).hom.app d) := by
  exact mem_range_comp_iso_iff ((P.relMap R).hom.app d)
    (asIso (piComparison ((evaluation D (Type w)).obj d) fun _ : Fin k => P.carrier)) _

end LeanPool.ClassifyingTopoi.CatStructure

namespace LeanPool.ClassifyingTopoi.Syntactic

open FirstOrder FirstOrder.Language CategoryTheory CategoryTheory.Limits LeanPool.ClassifyingTopoi

variable {D : Type*} [Category D] {L : Language.{u₁, u₂}}

section TypeStructures

variable (M : CatStructure L (Type w))

/-- The interpretation of a geometric formula in a structure in `Type w` is the set of tuples
realizing it in the induced structure on the carrier. -/
theorem range_interp_of_type {n : ℕ} (φ : GeometricFormula.{w} L n) :
    Set.range (M.interp φ).arrow =
      {x | (letI := M.toStructure; φ.Realize ((Types.productIso fun _ : Fin n => M.carrier).hom
        x))} := by
  let := M.toStructure
  have h₁ := (CatStructure.isHom_ofStructure_id M).interp_le φ
  have h₂ := (CatStructure.isHom_ofStructure_id' M).interp_le φ
  simp only [Limits.Pi.map_id, Subobject.pullback_id] at h₁ h₂
  rw [le_antisymm h₁ h₂, CatStructure.range_interp_ofStructure]

end TypeStructures

/-- **Kripke–Joyal semantics in presheaf topoi.** A section of the `n`-th power of the carrier
lies in the interpretation of a geometric formula iff its tuple realizes the formula in the
fiber structure. -/
theorem mem_range_interp_app_iff (P : CatStructure L (D ⥤ Type w)) {n : ℕ}
    (φ : GeometricFormula.{w} L n) (d : D) (z : (P.pow n).obj d) :
    z ∈ Set.range ((P.interp φ).arrow.app d) ↔
      (letI := P.fiberStr d; φ.Realize (secEquiv P.carrier n d z)) := by
  have h := CatStructure.interp_map P ((evaluation D (Type w)).obj d) φ
  have h' := congrArg (fun S => Set.range S.arrow) h
  dsimp only at h'
  rw [range_interp_of_type, TypeSubobject.range_mk_arrow] at h'
  let e := asIso (piComparison ((evaluation D (Type w)).obj d) fun _ : Fin n => P.carrier)
  have key := mem_range_comp_iso_iff ((P.interp φ).arrow.app d) e (e.hom z)
  rw [Iso.hom_inv_id_apply] at key
  rw [← key]
  change e.hom z ∈ Set.range (((evaluation D (Type w)).obj d).map (P.interp φ).arrow ≫
    piComparison ((evaluation D (Type w)).obj d) _) ↔ _
  rw [← h']
  rfl

/-- **Pointwise criterion for homomorphisms.** A morphism of carriers of structures in a category
of functors to types which is, at each object, a homomorphism of the fiber structures, is a
homomorphism. -/
theorem isHom_of_forall {M N : CatStructure L (D ⥤ Type w)} (h : M.carrier ⟶ N.carrier)
    (hf : ∀ (d : D) {k : ℕ} (f : L.Functions k) (x : Fin k → M.carrier.obj d),
      h.app d ((M.fiberStr d).funMap f x) = (N.fiberStr d).funMap f (h.app d ∘ x))
    (hr : ∀ (d : D) {k : ℕ} (R : L.Relations k) (x : Fin k → M.carrier.obj d),
      (M.fiberStr d).RelMap R x → (N.fiberStr d).RelMap R (h.app d ∘ x)) :
    M.IsHom N h where
  funMap {k} f := by
    ext d z
    obtain ⟨x, rfl⟩ := (secEquiv M.carrier k d).symm.surjective z
    change h.app d ((M.funMap f).app d ((secEquiv M.carrier k d).symm x)) =
      (N.funMap f).app d ((Limits.Pi.map fun _ => h).app d ((secEquiv M.carrier k d).symm x))
    rw [piMap_app_secEquiv_symm]
    exact hf d f x
  relMap {k} R := by
    rw [le_iff_range_app_subset]
    intro d
    rw [range_app_imageSubobject, range_app_pullback, range_app_imageSubobject]
    rintro _ ⟨y, rfl⟩
    obtain ⟨x, hx⟩ := (secEquiv M.carrier k d).symm.surjective ((M.relMap R).hom.app d y)
    have hR : (M.fiberStr d).RelMap R x := (M.fiberStr_relMap d R x).2 ⟨y, hx.symm ▸ rfl⟩
    have := (N.fiberStr_relMap d R _).1 (hr d R x hR)
    simp only [Set.mem_preimage]
    rw [← hx, piMap_app_secEquiv_symm]
    exact this

end LeanPool.ClassifyingTopoi.Syntactic

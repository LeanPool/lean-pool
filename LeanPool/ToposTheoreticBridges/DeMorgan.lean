/-!
# De Morgan presheaf topoi and the Ore condition

A topos is *De Morgan* when, for every subobject `A`, the pseudocomplement `¬A` and its own
pseudocomplement `¬¬A` cover: `¬A ⊔ ¬¬A = ⊤`. We state this for any category whose subobjects
form bounded lattices (`IsDeMorganTopos`), and prove (Johnstone, *Elephant*, Example D4.6.3(a);
see also Hemelaer and Rogers, Theorem 2.32):

* `isDeMorganTopos_presheaf_iff_rightOreCondition`: the presheaf topos `Cᵒᵖ ⥤ Type u` is
  De Morgan iff `C` satisfies the right Ore condition (every cospan `Y ⟶ X ⟵ Z` is completed
  to a commutative square);
* `rightOreCondition_iff_of_moritaEquivalentCat`: hence the right Ore condition is invariant
  under Morita equivalence.

The proof works with subfunctors (`CategoryTheory.Subfunctor`), which are order-isomorphic to
subobjects. The pseudocomplement of a subfunctor `A` of `F` is described pointwise: a section
`x` lies in `¬A` iff no restriction of `x` lies in `A`. For the converse direction one applies
De Morgan to the sieve generated by a morphism `f`, seen as the subfunctor
`Subfunctor.range (yoneda.map f)` of a representable.
Invariance of `IsDeMorganTopos` under equivalences of categories comes from the order
isomorphisms between subobject lattices induced by `MonoOver.congr`
(`subobjectOrderIsoOfEquivalence`, shared with `Boolean.lean`); it only uses the instances
required by the definition (no pullbacks).

The general notion of De Morgan topos (via the subobject classifier, or `¬¬`-sheaves) is not
formalised; only the lattice-theoretic formulation above is.
-/

@[expose] public section

namespace LeanPool.ToposTheoreticBridges

open CategoryTheory Limits Opposite

universe u

/-- A category whose subobjects form bounded lattices is De Morgan when every subobject `A` has a
pseudocomplement `B`, the largest subobject disjoint from `A`, which has a pseudocomplement `B'`
with `B ⊔ B' = ⊤`. -/
def IsDeMorganTopos (E : Type*) [Category E] [HasImages E]
    [HasBinaryCoproducts E] [HasInitial E] [InitialMonoClass E] : Prop :=
  ∀ (X : E) (A : Subobject X), ∃ B B' : Subobject X,
    (∀ S : Subobject X, Disjoint S A ↔ S ≤ B) ∧ (∀ S : Subobject X, Disjoint S B ↔ S ≤ B') ∧
      B ⊔ B' = ⊤

/-- The De Morgan condition at an element `A` of a bounded order with binary joins transfers
along an order isomorphism. -/
theorem exists_pseudocomplement_sup_eq_top_map {L M : Type*} [SemilatticeSup L] [OrderBot L]
    [OrderTop L] [SemilatticeSup M] [OrderBot M] [OrderTop M] (φ : L ≃o M) {A : L}
    (h : ∃ B B' : L, (∀ S : L, Disjoint S A ↔ S ≤ B) ∧ (∀ S : L, Disjoint S B ↔ S ≤ B') ∧
      B ⊔ B' = ⊤) :
    ∃ B B' : M, (∀ S : M, Disjoint S (φ A) ↔ S ≤ B) ∧ (∀ S : M, Disjoint S B ↔ S ≤ B') ∧
      B ⊔ B' = ⊤ := by
  obtain ⟨B, B', hB, hB', hsup⟩ := h
  refine ⟨φ B, φ B', fun S => ?_, fun S => ?_, by rw [← φ.map_sup, hsup, φ.map_top]⟩
  · rw [← φ.apply_symm_apply S, disjoint_orderIso_apply_iff, φ.le_iff_le]
    exact hB _
  · rw [← φ.apply_symm_apply S, disjoint_orderIso_apply_iff, φ.le_iff_le]
    exact hB' _

/-- `IsDeMorganTopos` is invariant under equivalences of categories. -/
theorem IsDeMorganTopos.of_equivalence {E F : Type*} [Category E] [HasImages E]
    [HasBinaryCoproducts E] [HasInitial E] [InitialMonoClass E] [Category F] [HasImages F]
    [HasBinaryCoproducts F] [HasInitial F] [InitialMonoClass F] (e : E ≌ F)
    (h : IsDeMorganTopos E) : IsDeMorganTopos F := by
  intro Y A
  let φ : Subobject (e.inverse.obj Y) ≃o Subobject Y :=
    (subobjectOrderIsoOfEquivalence e.symm Y).symm
  simpa using exists_pseudocomplement_sup_eq_top_map φ (h _ (φ.symm A))

/-- `IsDeMorganTopos` is invariant under equivalences of categories. -/
theorem isDeMorganTopos_congr {E F : Type*} [Category E] [HasImages E] [HasBinaryCoproducts E]
    [HasInitial E] [InitialMonoClass E] [Category F] [HasImages F] [HasBinaryCoproducts F]
    [HasInitial F] [InitialMonoClass F] (e : E ≌ F) : IsDeMorganTopos E ↔ IsDeMorganTopos F :=
  ⟨IsDeMorganTopos.of_equivalence e, IsDeMorganTopos.of_equivalence e.symm⟩

namespace Subfunctor

variable {C : Type*} [Category C] {F : C ⥤ Type*}

/-- The pseudocomplement of a subfunctor `A` of `F`: the sections none of whose restrictions
lie in `A`. -/
def pseudocompl (A : Subfunctor F) : Subfunctor F where
  obj U := {x | ∀ ⦃V : C⦄ (f : U ⟶ V), F.map f x ∉ A.obj V}
  map {U U'} g x hx V f := by
    simpa using hx (g ≫ f)

/-- Membership in the pseudocomplement, unfolded. -/
theorem mem_pseudocompl_iff (A : Subfunctor F) {U : C} (x : F.obj U) :
    x ∈ (pseudocompl A).obj U ↔ ∀ ⦃V : C⦄ (f : U ⟶ V), F.map f x ∉ A.obj V :=
  Iff.rfl

/-- A subfunctor is disjoint from `A` iff it is contained in the pseudocomplement of `A`. -/
theorem disjoint_iff_le_pseudocompl (S A : Subfunctor F) : Disjoint S A ↔ S ≤ pseudocompl A := by
  rw [disjoint_iff_inf_le, Subfunctor.le_def, Subfunctor.le_def]
  simp only [Subfunctor.min_obj, Subfunctor.bot_obj, Set.subset_def,
    Set.mem_inter_iff, Set.mem_empty_iff_false, imp_false, not_and]
  constructor
  · intro h U x hx V f hf
    exact h V _ (S.map f hx) hf
  · intro h U x hx hA
    exact h U x hx (𝟙 U) (by simpa using hA)

end Subfunctor

open Subfunctor in
/-- For a presheaf category, `IsDeMorganTopos` amounts to: every section of every presheaf lies
in `¬A` or in `¬¬A`, for every subpresheaf `A`. -/
theorem isDeMorganTopos_presheaf_iff (C : Type u) [SmallCategory C] :
    IsDeMorganTopos (Cᵒᵖ ⥤ Type u) ↔ ∀ (F : Cᵒᵖ ⥤ Type u) (A : Subfunctor F) (U : Cᵒᵖ)
      (x : F.obj U), x ∈ (pseudocompl A).obj U ∨ x ∈ (pseudocompl (pseudocompl A)).obj U := by
  have key : ∀ (F : Cᵒᵖ ⥤ Type u) (A : Subfunctor F),
      (∃ B B' : Subfunctor F, (∀ S, Disjoint S A ↔ S ≤ B) ∧ (∀ S, Disjoint S B ↔ S ≤ B') ∧
        B ⊔ B' = ⊤) ↔ pseudocompl A ⊔ pseudocompl (pseudocompl A) = ⊤ := by
    intro F A
    constructor
    · rintro ⟨B, B', hB, hB', hsup⟩
      have e1 : B = pseudocompl A := le_antisymm
        ((disjoint_iff_le_pseudocompl _ _).1 ((hB B).2 le_rfl))
        ((hB _).1 ((disjoint_iff_le_pseudocompl _ _).2 le_rfl))
      subst e1
      have e2 : B' = pseudocompl (pseudocompl A) := le_antisymm
        ((disjoint_iff_le_pseudocompl _ _).1 ((hB' B').2 le_rfl))
        ((hB' _).1 ((disjoint_iff_le_pseudocompl _ _).2 le_rfl))
      rwa [← e2]
    · intro h
      exact ⟨_, _, fun S => disjoint_iff_le_pseudocompl S A,
        fun S => disjoint_iff_le_pseudocompl S _, h⟩
  constructor
  · intro h F A U x
    have h'' := exists_pseudocomplement_sup_eq_top_map (orderIsoSubobject F).symm
      (h F (orderIsoSubobject F A))
    rw [OrderIso.symm_apply_apply] at h''
    have h' := (key F A).1 h''
    have : x ∈ (⊤ : Subfunctor F).obj U := Set.mem_univ _
    rwa [← h'] at this
  · intro h F A
    have h' : pseudocompl ((orderIsoSubobject F).symm A) ⊔
        pseudocompl (pseudocompl ((orderIsoSubobject F).symm A)) = ⊤ := by
      ext U x
      simpa using h F _ U x
    have h'' := exists_pseudocomplement_sup_eq_top_map (orderIsoSubobject F) ((key F _).2 h')
    rwa [OrderIso.apply_symm_apply] at h''

/-- A presheaf topos `Cᵒᵖ ⥤ Type u` is De Morgan iff `C` satisfies the right Ore condition. -/
theorem isDeMorganTopos_presheaf_iff_rightOreCondition (C : Type u) [SmallCategory C] :
    IsDeMorganTopos (Cᵒᵖ ⥤ Type u) ↔ GrothendieckTopology.RightOreCondition C := by
  rw [isDeMorganTopos_presheaf_iff]
  constructor
  · intro h X Y Z yx zx
    let A : Subfunctor (yoneda.obj X) := Subfunctor.range (yoneda.map yx)
    rcases h _ A (op X) (𝟙 X) with h1 | h1
    · exact absurd ⟨𝟙 Y, by simp⟩ (h1 yx.op)
    · have h2 := h1 zx.op
      simp only [Subfunctor.mem_pseudocompl_iff, not_forall, not_not] at h2
      obtain ⟨V, k, w, hw⟩ := h2
      exact ⟨V.unop, w, k.unop, by simpa using hw⟩
  · intro h F A U x
    by_cases hx : x ∈ (Subfunctor.pseudocompl A).obj U
    · exact Or.inl hx
    · right
      simp only [Subfunctor.mem_pseudocompl_iff, not_forall, not_not] at hx
      obtain ⟨V, f, hf⟩ := hx
      intro V' g hg
      obtain ⟨W, w, k, hwk⟩ := h f.unop g.unop
      apply hg k.op
      have : g ≫ k.op = f ≫ w.op := Quiver.Hom.unop_inj (by simpa using hwk.symm)
      have e : F.map k.op (F.map g x) = F.map w.op (F.map f x) := by
        rw [← types_comp_apply (F.map g) (F.map k.op), ← F.map_comp, this, F.map_comp,
          types_comp_apply]
      rw [e]
      exact A.map _ hf

/-- The right Ore condition is invariant under Morita equivalence. -/
theorem rightOreCondition_iff_of_moritaEquivalentCat {C D : Type u} [SmallCategory C]
    [SmallCategory D] (h : MoritaEquivalentCat C D) :
    GrothendieckTopology.RightOreCondition C ↔ GrothendieckTopology.RightOreCondition D := by
  obtain ⟨e⟩ := h
  rw [← isDeMorganTopos_presheaf_iff_rightOreCondition,
    ← isDeMorganTopos_presheaf_iff_rightOreCondition]
  exact isDeMorganTopos_congr e

end LeanPool.ToposTheoreticBridges

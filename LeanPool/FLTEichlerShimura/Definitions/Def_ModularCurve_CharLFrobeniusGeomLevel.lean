    {f g : modularFunctionFieldC K N}
    (hg : frobeniusGeomLevel K N data hKr g = f ^ ℓ)
    {D : Divisor K (modularFunctionFieldC K N)}
    (hD : ∀ w, D w = w.ord f) (v : Place K (modularFunctionFieldC K N)) :

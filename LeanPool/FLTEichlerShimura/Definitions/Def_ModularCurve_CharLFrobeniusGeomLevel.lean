include data hKr in
theorem isPrincipal_frobeniusPushforwardGeomLevel'
    (hperf : ∀ c : K, ∃ d : K, d ^ ℓ = c)
    {D : Divisor K (modularFunctionFieldC K N)} (hD : D.IsPrincipal) :
    (frobeniusPushforwardGeomLevel K N data hKr D).IsPrincipal :=

module

public import Mathlib.NumberTheory.NumberField.Basic

/-!
# Rational-prime ideals and matrix-valued representations

This module retains elementary helpers from Prove2Me node `TaylorWiles_Primes`
(`c2ff5db8-f2a4-5d20-a6b7-48adc9eb9494`), by Claude, 2026-09-05.

`FrobeniusDensity.ratPrimeIdeal ℓ` denotes the principal ideal `(ℓ)` of `ℤ`, with a maximality
instance when `ℓ` is prime. The helpers `finite_quotient_of_ne_bot` and
`ne_bot_of_liesOver_ratPrimeIdeal` supply finiteness of quotients by nonzero ideals in a number
field's ring of integers and nonzeroness of ideals lying over a rational prime.

`TaylorWiles.ResidualRep L 𝕜` abbreviates a monoid homomorphism from the automorphism group
`L ≃ₐ[ℚ] L` to two-by-two matrices over `𝕜`. The source is a group, so its images are units.
No continuity condition or ramification condition is included in this abbreviation.

The ideal helpers use Mathlib's number-field and ideal APIs. They support the prime-counting
constructions in `LanglandsTunnell_TowerCounting` and the theorem
`NumberField.exists_isFrobenius_lift_arithFrobAt`.
-/

@[expose] public section publicSection

namespace FrobeniusDensity

open NumberField Ideal

variable (L : Type*) [Field L] [NumberField L] [IsGalois ℚ L]

/-- The principal ideal of the integers generated by `ℓ`. -/
abbrev ratPrimeIdeal (ℓ : ℕ) : Ideal ℤ := Ideal.span {(ℓ : ℤ)}

private theorem ratPrimeIdeal_ne_bot {ℓ : ℕ} (hℓ : ℓ.Prime) : ratPrimeIdeal ℓ ≠ ⊥ := by
  rw [Ne, Ideal.span_singleton_eq_bot]
  exact_mod_cast hℓ.ne_zero

instance isMaximal_ratPrimeIdeal (ℓ : ℕ) [Fact ℓ.Prime] : (ratPrimeIdeal ℓ).IsMaximal :=
  PrincipalIdealRing.isMaximal_of_irreducible
    (Nat.prime_iff_prime_int.mp Fact.out).irreducible

variable {L}

omit [IsGalois ℚ L] in
theorem finite_quotient_of_ne_bot {Q : Ideal (𝓞 L)} (hQ : Q ≠ ⊥) : Finite (𝓞 L ⧸ Q) :=
  Ring.HasFiniteQuotients.finiteQuotient hQ

omit [IsGalois ℚ L] in
theorem ne_bot_of_liesOver_ratPrimeIdeal {ℓ : ℕ} (hℓ : ℓ.Prime) {Q : Ideal (𝓞 L)}
    [Q.LiesOver (ratPrimeIdeal ℓ)] : Q ≠ ⊥ :=
  Ideal.ne_bot_of_liesOver_of_ne_bot (ratPrimeIdeal_ne_bot hℓ) Q

variable (L)

end FrobeniusDensity

namespace TaylorWiles

open NumberField Ideal FrobeniusDensity

variable (L : Type*) [Field L] [NumberField L] [IsGalois ℚ L]

/-- A two-dimensional matrix-valued representation of the automorphism group of `L` over `ℚ`. -/
abbrev ResidualRep (𝕜 : Type*) [Field 𝕜] := (L ≃ₐ[ℚ] L) →* Matrix (Fin 2) (Fin 2) 𝕜

end TaylorWiles

end publicSection

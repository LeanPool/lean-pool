    ∃ c : Kˣ, transEquiv W K S (weilFun W K n T) = algebraMap K (W⁄K).FunctionField (c : K) *
      weilFun W K n T := by
  have hg0 := weilFun_ne_zero W hn hT
  have hval : ∀ v : HeightOneSpectrum (W⁄K).CoordinateRing,
      v.valuation (W⁄K).FunctionField (transEquiv W K S (weilFun W K n T) / weilFun W K n T) = 1
        := by

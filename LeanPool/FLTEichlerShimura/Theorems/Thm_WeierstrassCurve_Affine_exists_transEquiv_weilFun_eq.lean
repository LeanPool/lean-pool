    rw [map_div₀, valuation_transEquiv_weilFun W hn S hT P hP, valuation_weilFun W hn hT P hP,
      smul_add, hS,
      add_zero, div_self]
    refine div_ne_zero ?_ ?_ <;> split_ifs <;> simp
  obtain ⟨c, hc0, hc⟩ :=
    WeierstrassCurve.Affine.FunctionField.exists_eq_algebraMap_of_valuation_eq_one (W :=
      W.baseChange K) hval
  exact ⟨Units.mk0 c hc0, by rw [Units.val_mk0, ← hc, div_mul_cancel₀ _ hg0]⟩


  have hcard3 : σ.ker.relIndex S₁ = Nat.card θ.range := by
    rw [← Subgroup.index_ker, hθker]; rfl
  have htower : Module.finrank ↥ℂ⟮t⟯ ↥E₂ * Module.finrank ↥E₂ K = Module.finrank ↥ℂ⟮t⟯ K :=

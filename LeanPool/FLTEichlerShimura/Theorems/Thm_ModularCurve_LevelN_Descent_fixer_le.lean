    have h0 := finrank_adjoin_eq_index ι M K Φ E' t hE'j hE'Φ y₀ hy₀ hΦy
    rw [← h0]
    set tE : ↥EE := ⟨t, hΦy ▸ IntermediateField.subset_adjoin ℂ _ ⟨y₀, rfl⟩⟩ with htE
    have hlift : IntermediateField.lift ℂ⟮tE⟯ = ℂ⟮t⟯ := by

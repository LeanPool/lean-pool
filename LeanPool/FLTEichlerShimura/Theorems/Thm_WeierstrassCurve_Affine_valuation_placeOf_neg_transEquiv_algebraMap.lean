      rw [hι, HeightOneSpectrum.valuation_eq_one_iff_notMem]
      intro hmem
      apply hc1
      apply hconst
      have : CoordinateRing.mk (W⁄K) (C (C (3 * x_S ^ 2 + 2 * (W⁄K).a₂ * x_S + (W⁄K).a₄ -

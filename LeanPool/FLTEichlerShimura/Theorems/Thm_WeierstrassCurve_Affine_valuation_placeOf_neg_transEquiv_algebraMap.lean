        CoordinateRing.mk (W⁄K) (C (C y_S))) * he2'
    have hq : v (ι (u₀ ^ 2 + CoordinateRing.mk (W⁄K) (C (C (3 * x_S + (W⁄K).a₂))) * u₀ +

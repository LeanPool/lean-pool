  let B₂ : Tor → Prop := fun T => (q : ℤ) • (P + (T : (W⁄k).Point)) = 0
  let B₃ : Tor → Prop :=
    fun T => σ • (σ • (P + (T : (W⁄k).Point))) = (q : ℤ) • (P + (T : (W⁄k).Point))
  have hcover : ∀ T : Tor, B₁ T ∨ B₂ T ∨ B₃ T := by
    intro T
    by_contra hnot
    push Not at hnot
    obtain ⟨h₁, h₂, h₃⟩ := hnot
    obtain ⟨x, y, h, e⟩ := exists_eq_some_of_ne_zero h₁

theorem realize_smul_eventuallyEq {x : LaurentSeries ℂ} (P : Pres Γ x)
    (γ : Γ) (τ : ℍ) :
    (fun z : ℂ => realizeOf Γ x ((((γ : SL(2, ℤ)) : GL (Fin 2) ℝ)) • ofComplex z)) =ᶠ[𝓝[≠] (τ : ℂ)]

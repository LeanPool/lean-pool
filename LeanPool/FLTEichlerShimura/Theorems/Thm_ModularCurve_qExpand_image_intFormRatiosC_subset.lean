  rintro _ ⟨x, ⟨k, f, g, pf, pg, hf, hg, hg0, rfl⟩, rfl⟩
  refine ⟨k, X1QExpandStretch.stretch hΓ' hℓ f, X1QExpandStretch.stretch hΓ' hℓ g,

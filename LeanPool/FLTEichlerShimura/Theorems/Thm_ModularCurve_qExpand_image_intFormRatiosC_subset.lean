private theorem _root_.X1QExpandStretch.periodic_comp_ofComplex (hT : ModularGroup.T ∈ Γ)
    (f : ModularForm (Γ : Subgroup (GL (Fin 2) ℝ)) k) :
    Periodic ((⇑f : ℍ → ℂ) ∘ ofComplex) 1 := by
  have h1 : (1 : ℝ) ∈ (Γ : Subgroup (GL (Fin 2) ℝ)).strictPeriods := by

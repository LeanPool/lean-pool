theorem WeierstrassCurve.isCoprime_Phi_PsiSq {F : Type*} [Field F] (W : WeierstrassCurve F)
    [W.IsElliptic] (n : ℤ) :
    IsCoprime (W.Φ n) (W.ΨSq n) :=

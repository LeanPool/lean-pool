open AlgebraicCurve
theorem AlgebraicCurve.Place.evalAt_algebraMap {K F : Type*} [Field K] [Field F] [Algebra K F]
    (v : Place K F) (a : K) :
    v.evalAt (algebraMap K F a) = a :=
  solution v a


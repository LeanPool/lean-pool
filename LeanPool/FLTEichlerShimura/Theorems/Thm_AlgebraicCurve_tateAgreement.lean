    rw [hcompl.sup_eq_top]; exact Submodule.mem_top
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp htop
  subst hab
  rw [map_add, cohenProjC_of_mem u B hcompl ha,
    cohenProjC_of_mem_B u B hcompl hb, add_zero, add_sub_cancel_left]

theorem restrict_eq_of_isCusp (u : Place 𝕂 (modularFunctionFieldBar ℓ)) (hu : IsCusp (jb ℓ) u) :
    u.restrict (RatFunc 𝕂) = (cuspInftyBar ℓ).restrict (RatFunc 𝕂) := by

    [Field F] [Algebra K F] (φ : F →ₐ[K] LaurentSeries K) (f : F) (hf : 0 < (φ f).order) :
    ∃ φ' : F →ₐ[K] LaurentSeries K,
      (∀ x : F, (φ' x).order = (φ x).order) ∧ φ' f = single (φ f).order 1 :=

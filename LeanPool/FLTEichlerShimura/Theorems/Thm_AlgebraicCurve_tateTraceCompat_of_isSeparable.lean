  have hπvmem : πv ∈ (w.restrict E).adicCompletionIntegers := by
    rw [hπv]; exact (kwHgfV352_algebraMap_mem_adicCompletionIntegers_iff _ _).mpr
      (w.restrict E).uniformizer_mem

theorem S_smul_I : ModularGroup.S • UpperHalfPlane.I = UpperHalfPlane.I :=
  ModularGroup.stabilizer_I.mpr (by simp)

theorem ST_smul_ρ : (ModularGroup.S * ModularGroup.T) • ρ = ρ :=

  have hMa : ((texp D γ hγ : ℤ) : K) ≠ 0 := Int.cast_ne_zero.mpr (texp_ne_zero D γ hγ)
  have hMb : ((b : ℤ) : K) ≠ 0 := Int.cast_ne_zero.mpr hb

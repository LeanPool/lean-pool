  have h2 : intSeriesC K (trans D γ hγ).p =
      ((b : ℤ) : K)⁻¹ • (((texp D γ hγ : ℤ) : K) • intSeriesC K E.p) := by
    rw [← h, smul_smul, inv_mul_cancel₀ hMb, one_smul]
  rw [h2, smul_smul, smul_smul]
  congr 1
  field_simp


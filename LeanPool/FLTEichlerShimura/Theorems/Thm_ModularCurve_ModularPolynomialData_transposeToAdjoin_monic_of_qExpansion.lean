    (hk : ∀ k, k ≠ 0 → (data.Φ.coeff k).degree < (dedekindPsi N : WithBot ℕ)) :
    ((swapBivar data.Φ).map evalAtJGen).Monic ∧
      ((swapBivar data.Φ).map evalAtJGen).natDegree = dedekindPsi N := by

public section publicSection

namespace AlgebraicCurve

theorem RationalFunctionField.finiteDimensional_lSpace_zero_of_constantsAreBase (K : Type*)
    [Field K] (F : Type*) [Field F] [Algebra K F] (hC : ConstantsAreBase K F) :
    FiniteDimensional K (LSpace (0 : Divisor K F)) := by
  rw [show LSpace (0 : Divisor K F) = LinearMap.range (Algebra.linearMap K F) from hC]
  exact LinearMap.finiteDimensional_range _

end AlgebraicCurve

end publicSection

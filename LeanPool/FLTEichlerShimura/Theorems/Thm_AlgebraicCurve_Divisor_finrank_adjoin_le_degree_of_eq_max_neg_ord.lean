        intro p q hpq; simp only [Prod.mk.injEq, Fin.val_inj] at hpq
        exact Prod.ext hpq.1 hpq.2
      have hcomp := hli.comp _ hinj
      rw [LinearIndependent] at hcomp ⊢
      have hker := hcomp
      refine LinearIndependent.of_comp (LSpace (m • D)).subtype ?_

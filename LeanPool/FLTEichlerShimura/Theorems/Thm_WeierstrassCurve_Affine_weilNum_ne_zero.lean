namespace P2MW.S_WeierstrassCurve_Affine_weilNum_ne_zero

open WeierstrassCurve WeierstrassCurve.Affine IsDedekindDomain IsDedekindDomain.HeightOneSpectrum
  WithZero
open scoped nonZeroDivisors

theorem solution {F K : Type*} [Field F] [Field K] [Algebra F K] [DecidableEq K] [IsAlgClosed K]
    (W : WeierstrassCurve F) [W.IsElliptic] [IsDedekindDomain (W⁄K).CoordinateRing] {n : ℕ}
    (hn : (n : K) ≠ 0) {T : (W⁄K).Point} (hT : (n : ℤ) • T = 0) :
    weilNum W K n T ≠ 0 := by
  intro h0
  obtain ⟨P, hP, -⟩ := exists_point_xc_eq W K (0 : K)
  have h := WeierstrassCurve.Affine.valuation_weilNum W hn hT P hP
  rw [h0, _root_.map_zero, Valuation.map_zero] at h
  split_ifs at h
  · exact WithZero.zero_ne_coe h
  · exact zero_ne_one h

end S_WeierstrassCurve_Affine_weilNum_ne_zero
end P2MW

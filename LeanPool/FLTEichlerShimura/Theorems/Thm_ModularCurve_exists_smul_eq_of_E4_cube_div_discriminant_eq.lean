theorem E₄_cube_sub_E₆_sq_ne_zero (z : ℍ) : E₄ z ^ 3 - E₆ z ^ 2 ≠ 0 := fun h0 => by
  have h := ModularForm.discriminant_eq_E₄_cube_sub_E₆_sq z
  rw [h0, zero_div] at h
  exact ModularForm.discriminant_ne_zero z h


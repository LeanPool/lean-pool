theorem AlgebraicCurve.Divisor.evalFun_zsmul {K F : Type*} [Field K] [Field F] [Algebra K F] (f : F)
    (D : Divisor K F) (n : ℤ) :
    Divisor.evalFun f (n • D) = Divisor.evalFun f D ^ n :=

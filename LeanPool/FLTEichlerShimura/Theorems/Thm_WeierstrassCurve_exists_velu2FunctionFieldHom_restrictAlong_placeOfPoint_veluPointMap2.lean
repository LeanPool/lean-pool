      (hι : ι.toRingHom.IsIntegral) (_hfin : AlgebraicCurve.FiniteAlong F ι),
      ∀ P : W.toAffine.Point,
        (WeierstrassCurve.Affine.placeOfPoint P).restrictAlong ι hι

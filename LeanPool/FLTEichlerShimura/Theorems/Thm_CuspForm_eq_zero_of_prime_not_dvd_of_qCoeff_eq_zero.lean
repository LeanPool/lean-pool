    {m p : ℕ} [NeZero m] (hp : p.Prime) (hpm : ¬ p ∣ m)
    (F : CuspForm (CongruenceSubgroup.Gamma0 m) 2)
    (hF : ∀ n : ℕ, ¬ p ∣ n → ModularFormClass.qCoeff F n = 0) : F = 0 :=

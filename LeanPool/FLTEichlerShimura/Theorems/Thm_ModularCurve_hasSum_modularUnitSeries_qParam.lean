theorem solution (N : ℕ) [NeZero N] (τ : UpperHalfPlane) :
    HasSum (fun m : ℤ => (((ModularCurve.modularUnitSeries N).coeff m : ℚ) : ℂ) *
      Function.Periodic.qParam 1 (τ : ℂ) ^ m) (ModularForm.discriminant τ / ModularForm.discriminant
      (ModularForm.heckeDiagMatrix N • τ)) :=
  ModularCurve.QexpN.hasSum_modularUnit N τ

end S_ModularCurve_hasSum_modularUnitSeries_qParam

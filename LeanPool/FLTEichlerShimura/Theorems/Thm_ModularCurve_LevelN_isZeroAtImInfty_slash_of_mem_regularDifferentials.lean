  have hall := hanal.eqOn_zero_of_preconnected_of_eventuallyEq_zero
    (convex_halfSpace_im_gt 0).isPreconnected hz₀pos hzero
  apply hP0
  funext τ
  have := hall τ.im_pos
  simpa [comp_apply, ofComplex_apply] using this


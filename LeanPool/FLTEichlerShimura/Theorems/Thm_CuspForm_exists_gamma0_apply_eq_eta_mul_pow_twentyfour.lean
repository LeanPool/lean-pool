theorem solution (N : ℕ) [NeZero N] :
    ∃ g : CuspForm (CongruenceSubgroup.Gamma0 N) 12,
      ∀ τ : UpperHalfPlane, g τ = ModularForm.eta (N * (τ : ℂ)) ^ 24 := by
  obtain ⟨g, hg⟩ := CuspForm.exists_degeneracy_Gamma0 (N := N) (d := N) (M := 1)
    (dvd_of_eq (mul_one N)) ModularCurve.deltaGamma0
  refine ⟨g, fun τ => ?_⟩
  rw [hg]
  simp only [ModularCurve.deltaGamma0_coe, ModularForm.discriminant]
  rw [ModularForm.coe_heckeDiagMatrix_smul (NeZero.ne N)]

end

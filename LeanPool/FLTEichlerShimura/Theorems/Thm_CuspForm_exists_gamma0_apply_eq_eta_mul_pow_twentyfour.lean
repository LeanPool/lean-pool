noncomputable def etaMultiplier (γ : SL(2, ℤ)) : ℂ := etaRatio γ UpperHalfPlane.I

private lemma etaRatio_eq_etaMultiplier {γ : SL(2, ℤ)} (hγ : γ ∈ Gamma0 11) (τ : ℍ) :

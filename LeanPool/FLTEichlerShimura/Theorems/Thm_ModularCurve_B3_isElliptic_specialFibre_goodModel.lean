theorem jNear_ne_C (j₀ c : Qbar) : jNear j₀ ≠ HahnSeries.C c := by
  intro h
  have h1 := congrArg (fun x : H => x.coeff (1 : ℚ)) h
  simp only [coeff_one_jNear, HahnSeries.C_apply,

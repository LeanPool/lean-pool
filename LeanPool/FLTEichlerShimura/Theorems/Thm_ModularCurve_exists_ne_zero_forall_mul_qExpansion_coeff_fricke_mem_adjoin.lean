    _ ≤ n + ‖c0 N a₁ a₂‖ + (n + 1) * (n + 1) * 3 * (2 * n) := by linarith
    _ ≤ ‖c0 N a₁ a₂‖ + 8 * (n + 1) ^ 3 := by nlinarith

end Coeff


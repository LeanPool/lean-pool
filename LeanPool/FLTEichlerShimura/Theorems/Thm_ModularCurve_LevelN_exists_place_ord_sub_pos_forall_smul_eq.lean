def ordFun (τ₀ : ℍ) (F : ring N) : WithZero (Multiplicative ℤ) :=
  if (F : ℍ → ℂ) = 0 then 0 else WithZero.exp (-(ordAt τ₀ (F : ℍ → ℂ) : ℤ))


theorem ordFun_of_ne_zero (τ₀ : ℍ) {F : ring N} (hF : (F : ℍ → ℂ) ≠ 0) :
    ordFun N τ₀ F = WithZero.exp (-(ordAt τ₀ (F : ℍ → ℂ) : ℤ)) := by
  simp [ordFun, hF]


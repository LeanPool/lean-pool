def moeb (δ : SL(2, ℤ)) (z : ℂ) : ℂ :=
  (((δ 0 0 : ℤ) : ℂ) * z + ((δ 0 1 : ℤ) : ℂ)) / (((δ 1 0 : ℤ) : ℂ) * z + ((δ 1 1 : ℤ) : ℂ))


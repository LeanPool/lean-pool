theorem pushCoeff_ringHom_eq_map {R R' : Type*} [CommRing R] [CommRing R'] (φ : R →+* R')
    (P : MvPolynomial (Fin 2) R) :
    pushCoeff φ.toAddMonoidHom P = MvPolynomial.map φ P := by

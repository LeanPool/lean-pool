    [Field F''] [Algebra K F] [Algebra K F'] [Algebra K F''] (φ : F →ₐ[K] F') (χ : F' →ₐ[K] F'')
    (hφ : FiniteAlong K φ) (hχ : FiniteAlong K χ) :
    FiniteAlong K (χ.comp φ) :=

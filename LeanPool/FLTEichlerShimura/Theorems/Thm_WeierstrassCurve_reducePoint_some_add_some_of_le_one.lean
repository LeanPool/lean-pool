        apply hybarne
        simp only [Affine.negY]
        rw [← hxbar]
        linear_combination h0
      have hvd₂_le : valuation K (maximalIdeal R)
          (y₁ + y₂ + W.toAffine.a₁ * x₁ + W.toAffine.a₃) ≤ 1 := by
        rw [hd₂K]; exact valuation_le_one _ _
      have hvd₂_one : valuation K (maximalIdeal R)

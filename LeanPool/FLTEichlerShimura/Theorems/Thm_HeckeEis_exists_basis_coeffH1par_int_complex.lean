theorem exists_common_den (s : Finset ℚ) : ∃ D : ℤ, D ≠ 0 ∧ ∀ x ∈ s, ∃ m : ℤ, (D : ℚ) * x = m := by
  classical
  refine ⟨∏ y ∈ s, (y.den : ℤ), ?_, fun x hx => ?_⟩
  · rw [Finset.prod_ne_zero_iff]; intro y _; exact_mod_cast y.den_nz

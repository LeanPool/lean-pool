lemma inv_ne_one (χ : DirichletCharacter ℂ L) (hodd : χ.Odd) : χ⁻¹ ≠ 1 := by
  intro h
  have : χ = 1 := by rw [← inv_inv χ, h, inv_one]
  have h1 : χ (-1) = -1 := hodd
  rw [this, MulChar.one_apply (isUnit_one.neg)] at h1

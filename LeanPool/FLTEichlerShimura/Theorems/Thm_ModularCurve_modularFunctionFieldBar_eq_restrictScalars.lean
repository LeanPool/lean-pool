open IntermediateField

theorem ModularCurve.modularFunctionFieldBar_eq_restrictScalars (ℓ : ℕ) [Fact ℓ.Prime] :
    modularFunctionFieldBar ℓ = (IntermediateField.adjoin (IntermediateField.adjoin
      (AlgebraicClosure ℚ) ({jqModC (AlgebraicClosure ℚ)} : Set (LaurentSeries (AlgebraicClosure
      ℚ)))) ({jqNModC (AlgebraicClosure ℚ) ℓ} : Set (LaurentSeries (AlgebraicClosure
      ℚ)))).restrictScalars (AlgebraicClosure ℚ) := by
    have hℓ : ℓ.Prime := Fact.out
    change laurentBaseChange _ (modularFunctionFieldFull ℓ) = _
    rw [full_eq_of_prime hℓ, laurentBaseChange_modularFunctionField]
    exact (adjoin_simple_adjoin_simple _ (jqModC _) (jqNModC _ ℓ)).symm


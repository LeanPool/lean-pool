private theorem HasRamBound.div (he : 0 < e) {x y : HahnSeries ℚ K}
    (hx : HasRamBound e x) (hy : HasRamBound e y) : HasRamBound e (x / y) := by
  rw [div_eq_mul_inv]
  exact hx.mul (hy.inv he)


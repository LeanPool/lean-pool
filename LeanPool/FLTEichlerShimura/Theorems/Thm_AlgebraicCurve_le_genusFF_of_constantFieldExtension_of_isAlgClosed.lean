    have hIF := (hγ' D₀').2
    have hnn : (0:ℤ) ≤ (indexOfSpecialty (K := K') D₀' : ℤ) := Int.natCast_nonneg _
    linarith
  rw [hdegEq, hellEq, hkey] at hbound

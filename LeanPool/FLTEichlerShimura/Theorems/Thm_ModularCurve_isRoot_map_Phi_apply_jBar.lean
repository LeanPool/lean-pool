  RingHom.mem_fieldRange.mpr ⟨C a, embDomainRingHom_C⟩

theorem single_one_mem_puiseuxRamSubfield {e : ℕ} (he : 0 < e) (c : K) :
    single (1 : ℚ) c ∈ puiseuxRamSubfield K he := by

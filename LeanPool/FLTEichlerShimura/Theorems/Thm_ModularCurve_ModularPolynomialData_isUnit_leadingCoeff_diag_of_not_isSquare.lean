      ∑ i ∈ Finset.range (D.natDegree + 1), (D.coeff i) • (jq ^ i).coeff m := by
    intro m
    rw [hW, hsum, HahnSeries.coeff_sum]
    exact Finset.sum_congr rfl fun i _ => HahnSeries.coeff_smul

/-!
# Explicit function-field models for X₀(N) and X(N)

`ModularCurve.x0_twoJModel` identifies the field of ratios of integral q-expansions of modular
forms on `Γ₀(N)` with `ℚ(j(q), j(qᴺ))`. Its degree over `ℚ(j(q))` is the Dedekind psi function.
The equality is proved by comparing this field with the field generated by all `j(qᵈ)` for `d ∣ N`,
using the existing generation theorem and the matching upper and lower degree bounds.

`ModularCurve.x0_modularPolynomialPresentation` makes the corresponding quotient presentation
explicit: `ℚ(X)[Y] / (Φ_N(X,Y))` is isomorphic to the q-expansion field, with the images of `X`
and `Y` equal to `j(q)` and `j(qᴺ)`. Here `AdjoinRoot` is the polynomial quotient, not its
fraction field; irreducibility makes the quotient itself a field. This statement is over `ℚ`,
like the two-j model above, rather than an assertion about arbitrary coefficient fields.

`ModularCurve.LevelN.frickeFunctionFieldModel` describes the full-level Fricke-function model
over `ℂ`. The ring `LevelN.ring N` is `ℂ[j, f_v : v ≠ 0]`, where the `f_v` are normalized
Weierstrass ℘-values at N-torsion points. For any fraction field of this ring, the theorem gives
the action by precomposition, its kernel `±Γ(N)`, fixed field `ℂ(j)`, and the Galois property with
degree `[SL₂(ℤ) : ±Γ(N)]`. The model is expressed over `ℂ`, not as an arithmetic model over `ℚ`.
It also includes `LevelN.FrickeGeneration`: every Γ(N)-invariant meromorphic function of
at most exponential growth at all cusps is a fraction of elements of this ring. Equality is
on punctured neighbourhoods, and the denominator is nonzero there. Thus the claim concerns
all such modular functions, not only functions assumed in advance to be Fricke-rational.
-/

open scoped IntermediateField MatrixGroups

namespace ModularCurve

private theorem finrank_adjoin_eq_relative
    {K L : Type*} [Field K] [Field L] [Algebra K L]
    (E : IntermediateField K L) (x : E) :
    Module.finrank K⟮x⟯ E = (IntermediateField.adjoin K {(x : L)}).relfinrank E := by
  have hlift : IntermediateField.lift K⟮x⟯ = IntermediateField.adjoin K {(x : L)} := by
    rw [IntermediateField.lift_adjoin]
    simp
  have hle : IntermediateField.adjoin K {(x : L)} ≤ E := by
    rw [← hlift]
    exact IntermediateField.lift_le _
  rw [IntermediateField.relfinrank_eq_finrank_of_le hle]
  let i : K⟮x⟯ ≃+* IntermediateField.adjoin K {(x : L)} :=
    ((IntermediateField.liftAlgEquiv K⟮x⟯).trans (IntermediateField.equivOfEq hlift)).toRingEquiv
  let j : E ≃+* IntermediateField.extendScalars hle := RingEquiv.refl _
  exact Algebra.finrank_eq_of_equiv_equiv i j (by ext a; rfl)

public section

/-- The q-expansion field of X₀(N) is generated by the two j-functions and has degree ψ(N)
over the j-line. The q-expansion field is defined independently using ratios of modular forms. -/
theorem x0_twoJModel (N : ℕ) [NeZero N] :
    qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma0 N) =
        IntermediateField.adjoin ℚ {jq, jqN N} ∧
      (IntermediateField.adjoin ℚ {jq}).relfinrank
        (qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma0 N)) = dedekindPsi N := by
  classical
  let E := qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma0 N)
  let B := IntermediateField.adjoin ℚ ({jq} : Set (LaurentSeries ℚ))
  let A := modularFunctionFieldFull N
  have hAE : A ≤ E := modularFunctionFieldFullC_le_qExpFunctionFieldC_gamma0 ℚ N
  have hBA : B ≤ A := (adjoin_jq_le N).trans (modularFunctionField_le_full N)
  have hj : jq ∈ E := hAE (hBA (IntermediateField.mem_adjoin_simple_self ℚ jq))
  let x : E := ⟨jq, hj⟩
  have : (CongruenceSubgroup.Gamma0 N).FiniteIndex :=
    (CongruenceSubgroup.Gamma0_is_congruence N).finiteIndex
  have hT : ModularGroup.T ∈ CongruenceSubgroup.Gamma0 N := by
    apply CongruenceSubgroup.Gamma0_mem.mpr
    change ((0 : ℤ) : ZMod N) = 0
    exact Int.cast_zero
  obtain ⟨hfinite, hbound⟩ :=
    finiteDimensional_and_finrank_adjoin_jqModC_qExpFunctionFieldC_le_index ℚ
      (CongruenceSubgroup.Gamma0 N) hT (CongruenceSubgroup.Gamma0 N) le_rfl
      (fun _ h => Or.inl h) x rfl
  have := hfinite
  have hdim : 0 < B.relfinrank E := by
    rw [← finrank_adjoin_eq_relative E x]
    exact Module.finrank_pos
  have hupper : B.relfinrank E ≤ dedekindPsi N := by
    rw [← finrank_adjoin_eq_relative E x]
    simpa only [Gamma0_index N] using hbound
  have hdegree : B.relfinrank A = dedekindPsi N := relfinrank_full_eq_dedekindPsi N
  have htower := IntermediateField.relfinrank_mul_relfinrank hBA hAE
  rw [hdegree] at htower
  have hpositive : 0 < dedekindPsi N := by nlinarith
  have hrelative : A.relfinrank E = 1 := by
    have hpos : 0 < A.relfinrank E := by nlinarith
    have hle : A.relfinrank E ≤ 1 := by
      by_contra h
      have : 2 ≤ A.relfinrank E := by omega
      nlinarith
    omega
  have hEA : E = A :=
    le_antisymm (IntermediateField.relfinrank_eq_one_iff.mp hrelative) hAE
  constructor
  · change E = _
    rw [hEA]
    change modularFunctionFieldFull N = _
    rw [← modularFunctionField_eq_full N]
    rfl
  · change B.relfinrank E = _
    rw [hEA, hdegree]

namespace ModularPolynomialData

/-- View the integral modular polynomial as a polynomial in Y over the rational function
field `ℚ(X)`, by sending its inner polynomial variable to `RatFunc.X`. -/
noncomputable def toRatFunc {N : ℕ} [NeZero N] (data : ModularPolynomialData N) :
    Polynomial (RatFunc ℚ) :=
  data.Φ.map (Polynomial.aeval (R := ℤ) (RatFunc.X : RatFunc ℚ)).toRingHom

end ModularPolynomialData

private theorem polynomialQuotientEquivAdjoinPair
    {K L : Type*} [Field K] [Field L] [Algebra K L]
    (x y : L) (hx : Transcendental K x) (Φ : Polynomial (Polynomial ℤ))
    (hmonic : Φ.Monic)
    (hirr : Irreducible
      (Φ.map (Polynomial.aeval (R := ℤ) (IntermediateField.AdjoinSimple.gen K x)).toRingHom))
    (hzero : Polynomial.aeval y
      (Φ.map (Polynomial.aeval (R := ℤ) (IntermediateField.AdjoinSimple.gen K x)).toRingHom)
        = 0) :
    let p := Φ.map (Polynomial.aeval (R := ℤ) (RatFunc.X : RatFunc K)).toRingHom
    ∃ e : AdjoinRoot p ≃+* K⟮x, y⟯,
      (e (algebraMap (RatFunc K) _ RatFunc.X) : L) = x ∧
        (e (AdjoinRoot.root p) : L) = y := by
  classical
  let B := K⟮x⟯
  let E := K⟮x, y⟯
  let eX : RatFunc K ≃ₐ[K] B := RatFunc.algEquivOfTranscendental x hx
  let p := Φ.map (Polynomial.aeval (R := ℤ) (RatFunc.X : RatFunc K)).toRingHom
  let q := Φ.map
    (Polynomial.aeval (R := ℤ) (IntermediateField.AdjoinSimple.gen K x)).toRingHom
  have hmap : p.map eX.toRingHom = q := by
    dsimp only [p, q]
    rw [Polynomial.map_map]
    congr 1
    refine Polynomial.ringHom_ext' (Subsingleton.elim _ _) ?_
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      Polynomial.aeval_X]
    apply Subtype.ext
    exact RatFunc.algEquivOfTranscendental_X x hx
  have hp : Irreducible p :=
    Polynomial.Monic.irreducible_of_irreducible_map eX.toRingHom p
      (hmonic.map _) (by rw [hmap]; exact hirr)
  have : Fact (Irreducible p) := ⟨hp⟩
  have hBE : B ≤ E := IntermediateField.adjoin.mono _ _ _ (Set.singleton_subset_iff.mpr
    (Set.mem_insert x {y}))
  let i : RatFunc K →ₐ[K] E := (IntermediateField.inclusion hBE).comp eX.toAlgHom
  let yE : E := ⟨y, IntermediateField.mem_adjoin_pair_right K x y⟩
  have hiX : (i RatFunc.X : L) = x := by
    change (eX RatFunc.X : L) = x
    exact RatFunc.algEquivOfTranscendental_X x hx
  have hroot : p.eval₂ i.toRingHom yE = 0 := by
    apply (algebraMap E L).injective
    rw [map_zero, Polynomial.hom_eval₂]
    change p.eval₂ ((algebraMap B L).comp eX.toRingHom) y = 0
    rw [← Polynomial.eval₂_map, hmap]
    exact hzero
  let f : AdjoinRoot p →ₐ[K] E := AdjoinRoot.liftAlgHom p i yE hroot
  have hfX : (f (algebraMap (RatFunc K) _ RatFunc.X) : L) = x := by
    change ((AdjoinRoot.lift i.toRingHom yE hroot) (AdjoinRoot.of p RatFunc.X) : L) = x
    rw [AdjoinRoot.lift_of hroot]
    exact hiX
  have hfY : (f (AdjoinRoot.root p) : L) = y := by
    change ((AdjoinRoot.lift i.toRingHom yE hroot) (AdjoinRoot.root p) : L) = y
    rw [AdjoinRoot.lift_root hroot]
  have hrange : IntermediateField.lift f.fieldRange = E := by
    refine le_antisymm (IntermediateField.lift_le _) ?_
    apply IntermediateField.adjoin_le_iff.mpr
    rintro z (rfl | rfl)
    · exact ⟨f (algebraMap (RatFunc K) _ RatFunc.X),
        ⟨algebraMap (RatFunc K) _ RatFunc.X, rfl⟩, hfX⟩
    · exact ⟨f (AdjoinRoot.root p), ⟨AdjoinRoot.root p, rfl⟩, hfY⟩
  have hsurj : Function.Surjective f := by
    intro z
    have hz : (z : L) ∈ IntermediateField.lift f.fieldRange := by
      rw [hrange]
      exact z.property
    exact (IntermediateField.mem_lift z).mp hz
  exact ⟨(AlgEquiv.ofBijective f ⟨f.injective, hsurj⟩).toRingEquiv, hfX, hfY⟩

private def fieldEquivOfEq
    {K L : Type*} [Field K] [Field L] [Algebra K L]
    {E F : IntermediateField K L} (h : E = F) : E ≃+* F :=
  (IntermediateField.equivOfEq h).toRingEquiv

/-- The modular-polynomial quotient is the X₀(N) q-expansion field. The isomorphism is the
evaluation map sending the rational-function variable X to j and the quotient generator Y to j_N.
AdjoinRoot p denotes Polynomial (RatFunc ℚ) ⧸ Ideal.span {p}. -/
theorem x0_modularPolynomialPresentation (N : ℕ) [NeZero N] :
    ∃ data : ModularPolynomialData N, PhiIrreducible data ∧
      ∃ e : AdjoinRoot data.toRatFunc ≃ₐ[ℚ]
          qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma0 N),
        (e (algebraMap (RatFunc ℚ) _ RatFunc.X) : LaurentSeries ℚ) = jq ∧
          (e (AdjoinRoot.root data.toRatFunc) : LaurentSeries ℚ) = jqN N := by
  classical
  obtain ⟨data, hPhi⟩ := exists_phiIrreducible N
  have hgen : (Polynomial.aeval (R := ℤ)
      (IntermediateField.AdjoinSimple.gen ℚ jq)).toRingHom = evalAtJGen := by
    rfl
  obtain ⟨e, heX, heY⟩ := polynomialQuotientEquivAdjoinPair jq (jqN N)
    (transcendental_jqModC ℚ) data.Φ data.monic
    (by rw [hgen]; exact hPhi) (by rw [hgen]; exact aeval_jqN_toAdjoin data)
  let e' := e.trans (fieldEquivOfEq (x0_twoJModel N).1.symm)
  refine ⟨data, hPhi, e'.toRatAlgEquiv, ?_, ?_⟩
  · exact heX
  · exact heY
namespace LevelN

open UpperHalfPlane
open scoped Topology

/-- Every meromorphic modular function for Γ(N), with at most exponential growth at all
cusps, is a rational expression in j and the nonzero Fricke functions. Equality is as
meromorphic functions: locally on punctured neighbourhoods, not at arbitrarily assigned
values at poles. -/
def FrickeGeneration (N : ℕ) : Prop :=
  ∀ (F : ℍ → ℂ)
    (_ : ∀ τ : ℍ, MeromorphicAt (fun z : ℂ => F (ofComplex z)) (τ : ℂ))
    (_ : ∀ γ ∈ CongruenceSubgroup.Gamma N, ∀ τ : ℍ, F (γ • τ) = F τ)
    (_ : ∀ σ : SL(2, ℤ), ∃ C : ℝ,
      Asymptotics.IsBigO atImInfty (fun τ : ℍ => F (σ • τ))
        (fun τ : ℍ => Real.exp (C * τ.im))),
    ∃ a b : ℍ → ℂ, a ∈ ring N ∧ b ∈ ring N ∧ b ≠ 0 ∧ ∀ τ : ℍ,
      (∀ᶠ z in 𝓝[≠] (τ : ℂ), b (ofComplex z) ≠ 0) ∧
      (fun z : ℂ => F (ofComplex z)) =ᶠ[𝓝[≠] (τ : ℂ)]
        fun z : ℂ => a (ofComplex z) / b (ofComplex z)

/-- Fricke functions generate all meromorphic modular functions of level N. -/
theorem frickeGeneration (N : ℕ) [NeZero N] : FrickeGeneration N := by
  intro F hmer hinv hcusp
  obtain ⟨k, f, g, hg, hfg⟩ :=
    exists_modularForm_eventuallyEq_div_of_meromorphic_of_finiteIndex
      (CongruenceSubgroup.Gamma N) F hmer hinv hcusp
  obtain ⟨a, b, ha, hb, hb0, hab⟩ := exists_frickeFraction_of_modularForm N
    (CongruenceSubgroup.Gamma N) le_rfl k f g hg
  exact ⟨a, b, ha, hb, hb0, fun τ => ⟨(hab τ).1, (hfg τ).trans (hab τ).2⟩⟩

/-- The full-level Fricke-function field is Galois over the j-line, with the standard modular
action, kernel ±Γ(N), and degree equal to the corresponding subgroup index. The generation
clause includes every meromorphic modular function of controlled cusp growth. -/
theorem frickeFunctionFieldModel (N : ℕ) [NeZero N]
    (K : Type*) [Field K] [Algebra ℂ K] [Algebra (ring N) K]
    [IsScalarTower ℂ (ring N) K] [IsFractionRing (ring N) K] :
    FrickeGeneration N ∧ ∃ (hst : ∀ γ : SL(2, ℤ), ∀ f ∈ ring N,
        (fun τ : UpperHalfPlane => f (γ • τ)) ∈ ring N)
      (σ : SL(2, ℤ) →* (K ≃ₐ[ℂ] K)),
      (∀ (γ : SL(2, ℤ)) (f : UpperHalfPlane → ℂ) (hf : f ∈ ring N),
          σ γ (algebraMap (ring N) K ⟨f, hf⟩) =
            algebraMap (ring N) K ⟨fun τ : UpperHalfPlane => f (γ⁻¹ • τ), hst γ⁻¹ f hf⟩) ∧
      σ.ker = CongruenceSubgroup.Gamma N ⊔ Subgroup.zpowers (-1 : SL(2, ℤ)) ∧
      IntermediateField.fixedField σ.range =
        IntermediateField.adjoin ℂ {algebraMap (ring N) K (jGen N)} ∧
      Transcendental ℂ (algebraMap (ring N) K (jGen N)) ∧
      FiniteDimensional (IntermediateField.adjoin ℂ {algebraMap (ring N) K (jGen N)}) K ∧
      Module.finrank (IntermediateField.adjoin ℂ {algebraMap (ring N) K (jGen N)}) K =
        (CongruenceSubgroup.Gamma N ⊔ Subgroup.zpowers (-1 : SL(2, ℤ))).index ∧
      IsGalois (IntermediateField.adjoin ℂ {algebraMap (ring N) K (jGen N)}) K :=
  ⟨frickeGeneration N, exists_monoidHom_algEquiv_fixedField_eq_adjoin N K⟩

end LevelN


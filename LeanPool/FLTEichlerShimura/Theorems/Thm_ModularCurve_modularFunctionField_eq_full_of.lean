theorem solution (N : ℕ) [NeZero N] (hstep : ∀ (M : ℕ) [NeZero M] (p : ℕ), p.Prime → M * p = N → jqN
  M ∈ modularFunctionField N) (hgen' : ∀ (M : ℕ) [NeZero M] (p : ℕ), p.Prime → M * p = N →
  modularFunctionField M = modularFunctionFieldFull M) :
    modularFunctionField N = modularFunctionFieldFull N :=
  ModularCurve.modularFunctionField_eq_full_of N hstep hgen'

end S_ModularCurve_modularFunctionField_eq_full_of

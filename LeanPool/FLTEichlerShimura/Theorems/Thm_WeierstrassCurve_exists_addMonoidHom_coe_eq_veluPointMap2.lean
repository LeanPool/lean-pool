    + (-(x₁ - x₂) * ((x₁ - x₀) + (x₂ - x₀))) * hQ
    + ((x₂ - x₀) ^ 2 * y₁ - (x₁ - x₀) ^ 2 * y₂
        + (x₁ - x₂) * ((x₁ - x₀) + (x₂ - x₀)) * y₀) * hord


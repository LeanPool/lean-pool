        * ((x₂ - x₀) * (W.a₁ * (x₁ - x₀) + y₁ - y₀)
            + (x₁ - x₀) * (W.a₁ * (x₂ - x₀) + y₂ - y₀) - W.a₁ * ((x₁ - x₀) * (x₂ - x₀)))

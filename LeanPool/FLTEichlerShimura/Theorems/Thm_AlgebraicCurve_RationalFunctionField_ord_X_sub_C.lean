open AlgebraicCurve AlgebraicCurve.RationalFunctionField
theorem AlgebraicCurve.RationalFunctionField.ord_X_sub_C (K : Type*) [Field K]
    [DecidableEq (RatFunc K)] (b : K) (v : Place K (RatFunc K)) :
    v.ord (algebraMap (Polynomial K) (RatFunc K) (Polynomial.X - Polynomial.C b)) = (Finsupp.single
      (placeOfPoint K b) (1 : ℤ) + Finsupp.single (placeInfty K) (-1 : ℤ)) v := by
  simpa only [Polynomial.natDegree_X_sub_C, Nat.cast_one, placeOfPoint_def] using
    (single_add_single_apply_eq_ord (Polynomial.irreducible_X_sub_C b) v).symm


  apply Set.Subset.antisymm
  · intro x hx
    rw [MulAction.mem_fixedPoints] at hx
    obtain ⟨a, b, ha, hb, hb0, hab⟩ :=
      exists_fixed_div_of_fixed (A := ↥D.ring) (K := D.field) (G := LevelGrp N)

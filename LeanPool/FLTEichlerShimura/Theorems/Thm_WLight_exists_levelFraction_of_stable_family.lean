lemma coe_aeval_jA (P : Polynomial ℂ) :
    ((Polynomial.aeval D.jA P : ↥D.ring) : ℍ → ℂ) = fun τ ↦ Polynomial.eval (j τ) P := by
  rw [Polynomial.aeval_subalgebra_coe]

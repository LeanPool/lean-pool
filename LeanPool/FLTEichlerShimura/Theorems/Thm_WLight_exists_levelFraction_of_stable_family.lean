theorem frickeF_integral_over_j (N : ℕ) [NeZero N] :
    ∃ P : ℕ → Polynomial ℂ,
      ∀ (i : FrickeIdx N) (τ : ℍ),
        frickeF N i.1 τ ^ (N ^ 2 - 1) +
          ∑ k ∈ Finset.range (N ^ 2 - 1),
            Polynomial.eval (j τ) (P k) * frickeF N i.1 τ ^ k = 0 := by
  obtain ⟨P, -, hP⟩ := (r4b_package N).2.2
  exact ⟨P, fun i τ => hP i.1 i.2 τ⟩


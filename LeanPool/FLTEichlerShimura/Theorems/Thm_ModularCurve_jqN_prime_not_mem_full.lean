private theorem jqN_prime_not_mem_adjoin (M : ℕ) [NeZero M] (p : ℕ) [hp : Fact (Nat.Prime p)]
    (hpM : ¬ p ∣ M)
    (hall : ∀ d : ℕ, d ∣ M → ∀ [NeZero d],
      Module.finrank ℚ⟮jq⟯
          (adjoin ℚ⟮jq⟯ ({jqN d} : Set (LaurentSeries ℚ))) = dedekindPsi d
        ∧ modularFunctionField d = modularFunctionFieldFull d) :
    jqN p ∉ adjoin ℚ⟮jq⟯ ({jqN M} : Set (LaurentSeries ℚ)) := by
  classical
  intro hmem
  let K := CyclotomicField (M * p) ℚ
  have hζ : IsPrimitiveRoot ((cycUnit (M * p) : Kˣ) : K) (M * p) := cycUnit_spec (M * p)
  have hjpF : jqN p ∈ ℚ⟮jq⟯ :=
    (ModularFunctionFieldHelpers.jqNModC_mem_adjoin_iff_mem_base_of_prime_not_dvd
      (algebraMap ℚ K) M p hpM (cycUnit (M * p)) hζ hall).mp hmem
  have hbot : adjoin ℚ⟮jq⟯ ({jqN p} : Set (LaurentSeries ℚ))
      = (⊥ : IntermediateField ℚ⟮jq⟯ (LaurentSeries ℚ)) := by
    rw [adjoin_simple_eq_bot_iff, mem_bot]
    exact ⟨⟨jqN p, hjpF⟩, rfl⟩
  have h1 : Module.finrank ℚ⟮jq⟯
      (adjoin ℚ⟮jq⟯ ({jqN p} : Set (LaurentSeries ℚ))) = 1 := by
    rw [hbot]
    exact IntermediateField.finrank_bot
  have h2 := ModularCurve.finrank_adjoin_jqN_eq_of_prime p
  rw [h1] at h2
  have h3 := hp.out.two_le
  omega

end NonMem0
end ModularCurve.W1

private theorem solution
    (M : ℕ) [NeZero M]
    (p : ℕ) [hp : Fact (Nat.Prime p)] (hpM : ¬ p ∣ M)
    (hall : ∀ d : ℕ, d ∣ M → ∀ [NeZero d],
      Module.finrank (adjoin ℚ ({jq} : Set (LaurentSeries ℚ)))
          (adjoin (adjoin ℚ ({jq} : Set (LaurentSeries ℚ)))
            ({jqN d} : Set (LaurentSeries ℚ))) = dedekindPsi d ∧
      modularFunctionField d = modularFunctionFieldFull d) :
    jqN p ∉ modularFunctionFieldFull M := by
  intro hmem0
  obtain ⟨-, hgM⟩ := hall M dvd_rfl
  have hmem : jqN p ∈ adjoin
      (adjoin ℚ ({jq} : Set (LaurentSeries ℚ)))
      ({jqN M} : Set (LaurentSeries ℚ)) := by
    rw [← hgM] at hmem0
    exact mem_adjoin_jqN_of_mem_mff hmem0
  exact ModularCurve.W1.jqN_prime_not_mem_adjoin M p hpM hall hmem

end


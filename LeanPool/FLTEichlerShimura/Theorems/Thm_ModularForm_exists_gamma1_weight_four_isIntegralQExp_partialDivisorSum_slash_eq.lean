    intro c e γ
    ext i
    fin_cases i <;>
      simp [Matrix.vecMul, dotProduct, Fin.sum_univ_two, ]
  have hrow_slash : ∀ (c : ZMod M) (γ : SL(2, ℤ)), γ ∈ CongruenceSubgroup.Gamma0 M →
      S c ∣[(4 : ℤ)] γ = S (c * ((γ 0 0 : ℤ) : ZMod M)) := by

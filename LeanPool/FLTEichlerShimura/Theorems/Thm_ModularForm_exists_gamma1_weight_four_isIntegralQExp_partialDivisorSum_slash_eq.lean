    fun c =>
    { toFun := ⇑(FS c)
      slash_action_eq' := fun A hA => by
        obtain ⟨β, hβ, rfl⟩ := Subgroup.mem_map.mp hA
        have hβ' := (CongruenceSubgroup.Gamma1_mem M β).mp hβ
        have hβ0 : β ∈ CongruenceSubgroup.Gamma0 M := CongruenceSubgroup.Gamma1_in_Gamma0 M hβ

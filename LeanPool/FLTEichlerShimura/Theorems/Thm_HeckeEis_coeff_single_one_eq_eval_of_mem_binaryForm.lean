    {P : MvPolynomial (Fin 2) K} (hP : P ∈ HeckeEis.BinaryForm K n) :
    AddMonoidAlgebra.coeff P (Finsupp.single 1 n) = MvPolynomial.eval ![0, 1] P :=
  solution hP


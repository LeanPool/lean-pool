    ∀ (v : Place K F) (f : F) (hf : f ∈ v.toValuationSubring),
    0 < v.ord f → (⟨f, hf⟩ : v.toValuationSubring) ∈ IsLocalRing.maximalIdeal _ := by
  intro v f hf hord
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  intro hu
  have hval := (v.adicValuation_coe_eq_one_iff ⟨f, hf⟩).mpr hu
  simp [Place.ord, hval] at hord

private theorem isUnit_iff_residue_ne_zero : ∀ (v : Place K F) (a : v.toValuationSubring),

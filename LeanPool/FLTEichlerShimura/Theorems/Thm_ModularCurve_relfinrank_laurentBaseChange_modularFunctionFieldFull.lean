theorem solution (L : Type*) [Field L] [Algebra ℚ L] (N : ℕ) [NeZero N] :
    IntermediateField.relfinrank (IntermediateField.adjoin L ({coeffEmb L jq} : Set (LaurentSeries
      L))) (laurentBaseChange L (modularFunctionFieldFull N)) = IntermediateField.relfinrank
      (IntermediateField.adjoin ℚ ({jq} : Set (LaurentSeries ℚ))) (modularFunctionFieldFull N) :=
  TransportRows.relfinrank_laurentBaseChange_full L N


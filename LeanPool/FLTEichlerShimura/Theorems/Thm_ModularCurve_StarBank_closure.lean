      algebraMap_eq_C, qExpand_C, ← algebraMap_eq_C, hκL, qExpand_aeval, qExpand_aeval]
  have hpoly : G ^ (p + 1) =
      Polynomial.C ((G.leadingCoeff * (-1) ^ Multiset.card G.roots) ^ p *
          (((∏ b ∈ Finset.range p, ζ ^ b : Kˣ) : K)) ^ M) *

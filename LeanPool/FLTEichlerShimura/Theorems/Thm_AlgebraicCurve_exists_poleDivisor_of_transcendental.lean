    {K F : Type*} [Field K] [IsAlgClosed K] [Field F] [Algebra K F]
    (x : F) (hx : Transcendental K x)
    [FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F] :
    ∃ D : Divisor K F, ∀ v : Place K F, D v = max 0 (-v.ord x) :=

section privateSection


namespace P2MW.S_AlgebraicCurve_exists_poleDivisor_of_transcendental

open AlgebraicCurve

theorem solution
    {K F : Type*} [Field K] [IsAlgClosed K] [Field F] [Algebra K F]
    (x : F) (hx : Transcendental K x)
    [FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F] :
    ∃ D : Divisor K F, ∀ v : Place K F, D v = max 0 (-v.ord x) := by
  have : IsCurveOver K F := isCurveOver_of_isAlgClosed_of_transcendental x hx
  have hx0 : x ≠ 0 := fun h => hx (h ▸ isAlgebraic_zero)
  obtain ⟨P, hP, -⟩ := HasPrincipalDivisors.exists_divisor (K := K) (F := F) x hx0
  refine ⟨(-P) ⊔ 0, fun v => ?_⟩
  change max ((-P) v) ((0 : Divisor K F) v) = max 0 (-v.ord x)
  rw [Finsupp.neg_apply, hP v, Finsupp.coe_zero, Pi.zero_apply, max_comm]

end S_AlgebraicCurve_exists_poleDivisor_of_transcendental
end P2MW
export P2MW.S_AlgebraicCurve_exists_poleDivisor_of_transcendental (solution)


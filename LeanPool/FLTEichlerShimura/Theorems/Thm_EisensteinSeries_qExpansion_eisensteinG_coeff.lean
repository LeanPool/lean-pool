      eisSummand (k : ℤ) ((congrSetEquivSigma a).symm p).1 τ) :=
    (congrSetEquivSigma a).symm.summable_iff.mpr ((summable_norm_eisSummand hk' τ).of_norm.subtype
      _)
  rw [hs.tsum_sigma]
  refine tsum_congr fun c => tsum_congr fun d => ?_
  rw [eisSummand_natCast]

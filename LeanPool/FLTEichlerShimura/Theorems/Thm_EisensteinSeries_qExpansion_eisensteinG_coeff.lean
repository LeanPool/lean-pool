lemma eisensteinG_eq_tsum_tsum (hk : 3 ≤ k) (a : Fin 2 → ZMod N) (τ : ℍ) :
    EisensteinSeries.eisensteinG N k a τ =
      ∑' c : cls N (a 0), ∑' d : cls N (a 1), ((((c.1 : ℂ)) * τ + d.1) ^ k)⁻¹ := by
  have hk' : 3 ≤ ((k : ℕ) : ℤ) := by exact_mod_cast hk

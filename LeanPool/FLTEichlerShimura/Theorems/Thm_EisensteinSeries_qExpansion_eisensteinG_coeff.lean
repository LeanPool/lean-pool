lemma eisSummand_natCast (v : Fin 2 → ℤ) (z : ℍ) :
    eisSummand (k : ℤ) v z = ((((v 0 : ℂ)) * z + v 1) ^ k)⁻¹ := by
  rw [eisSummand, zpow_neg, zpow_natCast]


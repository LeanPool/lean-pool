theorem valuation_a₃_le_one : valuation K (maximalIdeal R) W.a₃ ≤ 1 := by
  rw [← integralModel_a₃_eq R W]; exact valuation_le_one (maximalIdeal R) _

theorem valuation_a₄_le_one : valuation K (maximalIdeal R) W.a₄ ≤ 1 := by

theorem solution {K F F' : Type*} [Field K] [Field F] [Field F'] [Algebra K F] [Algebra K F']
    (φ : F →ₐ[K] F') (hφ : Function.Surjective φ) :
    FiniteAlong K φ := by
  let := algebraAlong φ
  exact Module.Finite.of_surjective (Algebra.linearMap F F') hφ


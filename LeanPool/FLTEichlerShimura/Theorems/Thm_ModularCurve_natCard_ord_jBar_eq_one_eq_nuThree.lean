    hmem (dedekindPsi N : ℤ) hsum
  set a := (S.filter (fun v => v.ord (jBar N - 1728) = 1)).card with ha
  set b := (S.filter (fun v => v.ord (jBar N - 1728) = 2)).card with hb
  have hScard : S.card =

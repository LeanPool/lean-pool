    rw [Set.mem_singleton_iff.mp hy]
    exact ht
  obtain ⟨P, hPmonic, hPeval⟩ : IsIntegral (Algebra.adjoin K ({t} : Set F)) (a : F) := a.2
  refine w.mem_of_eval_monic_eq_zero (P := P.map (algebraMap _ F)) (hPmonic.map _)
    (fun i => ?_) ?_

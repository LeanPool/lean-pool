private theorem JD_exists_bar_ord_eq_mul_ram_1728
    [Algebra.IsIntegral ↥ℚ⟮jq⟯ ↥(modularFunctionField N)]
    (w : Place ℚ (modularFunctionField N))
    (hw : w.restrict ↥ℚ⟮jq⟯ = jLinePlace1728) :

    refine JD_finset_card_eq_natCard fun v => ?_
    simp only [Finset.mem_filter, hS]
    exact ⟨fun ⟨_, h1⟩ => h1, fun h1 => ⟨h1 ▸ one_pos, h1⟩⟩
  rw [← hcarda, ha_nu]


private theorem DOM_algebraMap_mem_of_dom (A : ValuationSubring (modularFunctionFieldBar N))
    (hA : ∀ x : modularFunctionField N, x ∈ w.toValuationSubring → DOM_iota N x ∈ A)
    (c : AlgebraicClosure ℚ) :

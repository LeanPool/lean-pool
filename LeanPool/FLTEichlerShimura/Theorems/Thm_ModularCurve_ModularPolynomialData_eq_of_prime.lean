private theorem ModularCurve.ModularPolynomialData.eq_of_prime (p : ℕ) [hp : Fact (Nat.Prime p)]
    (d d' : ModularPolynomialData p) :
    d = d' := by
  have h : d.Φ = d'.Φ := by

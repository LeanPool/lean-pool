theorem C_ofNat (n : ℕ) [n.AtLeastTwo] :
    (HahnSeries.C (OfNat.ofNat n : Qbar) : H) = (OfNat.ofNat n : H) := map_ofNat _ n

theorem coeff_zero_C (c : Qbar) : (HahnSeries.C c : H).coeff 0 = c := by

private def _root_.PeriodPair.kwAddΨ (w : ℂ) (z : ℂ) : ℂ :=
  (℘[L] z - ℘[L] w) * ℘'[L] (z + w) + (℘'[L] z - ℘'[L] w) * ℘[L] (z + w)
    + ℘[L] z * ℘'[L] w - ℘[L] w * ℘'[L] z


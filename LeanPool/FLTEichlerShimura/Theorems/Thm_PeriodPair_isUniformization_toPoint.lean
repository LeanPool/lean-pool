private def _root_.PeriodPair.kwAddCoreE (w : ℂ) (z : ℂ) : ℂ :=
  4 * ℘[L] (z + w) + (-8 * ℘[L] w) * (z ^ 2 * ℘[L] (z + w))
    + (-4 * ℘[L] w) + (-4 * ℘'[L] w) * z + (L.g₂ - 4 * ℘[L] w ^ 2) * z ^ 2

p2m_export "PeriodPair" "kwAddCoreE"

private def _root_.PeriodPair.kwAddCoreE₁ (w : ℂ) (z : ℂ) : ℂ :=
  4 * ℘'[L] (z + w)
    + (-8 * ℘[L] w) * (2 * z * ℘[L] (z + w) + z ^ 2 * ℘'[L] (z + w))
    + 0 + (-4 * ℘'[L] w) * 1 + (L.g₂ - 4 * ℘[L] w ^ 2) * (2 * z)


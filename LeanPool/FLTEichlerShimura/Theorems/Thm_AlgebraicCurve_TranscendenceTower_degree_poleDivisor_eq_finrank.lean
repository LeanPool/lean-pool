public theorem AlgebraicCurve.TranscendenceTower.degree_poleDivisor_eq_finrank {K E F : Type*}
    [Field K] [Field E] [Field F] [Algebra K E] [Algebra K F] [Algebra E F] [IsScalarTower K E F]
    [FiniteDimensional E F] [Algebra.IsSeparable E F] [HasPrincipalDivisors K F]
    (T : TranscendenceTower K E F) :
    T.poleDivisor.degree = (Module.finrank E F : ℤ) := by
  have : SumRamificationInertia K E F := ⟨fun v ↦ Place.sum_ramificationIndex_mul_inertiaDeg v⟩
  simp [poleDivisor, Divisor.degree_pullback, T.hvdeg]

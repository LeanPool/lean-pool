private theorem coeff_dedekindEtaUnitInv_eq_coeff_partialGeom_pow (n : ℕ) :
    ∀ k ≤ n, PowerSeries.coeff k dedekindEtaUnitInv =
      PowerSeries.coeff k (partialGeom (n + 1) ^ 24) := by

        (W.baseChange K).evalEval_φ heq]
  · intro hΨ
    have hψ0 : ((W.baseChange K).ψ (n : ℤ)).evalEval x₀ y₀ = 0 :=
      sq_eq_zero_iff.mp (hψsq.trans hΨ)
    rw [← natCast_zsmul]
    exact ((W.baseChange K).smul_eq_zero_iff_evalEval_ψ h (n : ℤ)).mpr hψ0


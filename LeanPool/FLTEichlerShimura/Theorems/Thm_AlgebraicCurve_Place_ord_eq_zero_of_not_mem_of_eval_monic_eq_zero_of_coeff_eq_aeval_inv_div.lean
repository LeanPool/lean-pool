    (v : AlgebraicCurve.Place K F) {j : F} (hj : j ∉ v.toValuationSubring)
    {P Q : F[X]} (hP : P.Monic) (hQ : Q.Monic)
    (hPc : ∀ i, ∃ p q : K[X], q.coeff 0 ≠ 0 ∧ P.coeff i = aeval j⁻¹ p / aeval j⁻¹ q)

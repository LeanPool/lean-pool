private theorem linearIndependent_of_qExpansion_basis
    {M : ℕ} [NeZero M] {k d : ℕ}
    (D : AlgebraicCurve.Divisor ℂ
      ↥(laurentBaseChange ℂ (qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma1 M))))
    (b : Module.Basis (Fin d) ℂ ↥(riemannRochSpace D))
    (w : ModularForm (Gamma1 M) (1 : ℤ)) (hw0 : w ≠ 0)
    (f : Fin d → ModularForm (Gamma1 M) (k : ℤ))
    (hf : ∀ i, HahnSeries.ofPowerSeries ℤ ℂ (qExpansion 1 (f i)) =
      (((b i : ↥(riemannRochSpace D)) :
        ↥(laurentBaseChange ℂ (qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma1 M)))) :
          LaurentSeries ℂ) * HahnSeries.ofPowerSeries ℤ ℂ (qExpansion 1 w) ^ k) :
    LinearIndependent ℂ f := by
  classical
  set W : LaurentSeries ℂ := HahnSeries.ofPowerSeries ℤ ℂ (qExpansion 1 w) with hWdef
  have hW : W ≠ 0 := by
    intro h0
    apply hw0
    apply eq_zero_of_qExpansion_eq_zero M
    exact HahnSeries.ofPowerSeries_injective (by rw [← hWdef, h0, map_zero])
  rw [Fintype.linearIndependent_iff]
  intro g hg0 i
  have hq : qExpansion 1 (⇑(∑ i, g i • f i) : ℍ → ℂ) = 0 := by
    rw [hg0]; exact qExpansion_zero 1
  rw [qExpansion_sum_smul M] at hq
  have h3 : (((∑ i, vectorSpaceSMul (g i) (b i) : ↥(riemannRochSpace D)) :
        ↥(laurentBaseChange ℂ (qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma1 M)))) :
          LaurentSeries ℂ) =
      ∑ i, algebraMap ℂ (LaurentSeries ℂ) (g i) *
        (((b i : ↥(riemannRochSpace D)) :
          ↥(laurentBaseChange ℂ (qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma1 M)))) :
            LaurentSeries ℂ) := by
    dsimp only [vectorSpaceSMul]
    rw [Submodule.coe_sum, AddSubmonoidClass.coe_finsetSum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Submodule.coe_smul, IntermediateField.coe_smul]
    first
      | rw [Algebra.smul_def]
  have hL : (((∑ i, vectorSpaceSMul (g i) (b i) : ↥(riemannRochSpace D)) :
        ↥(laurentBaseChange ℂ (qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma1 M)))) :
          LaurentSeries ℂ) * W ^ k = 0 := by
    have h1 := congrArg (HahnSeries.ofPowerSeries ℤ ℂ) hq
    rw [map_sum, map_zero] at h1
    have h2 : ∀ i, HahnSeries.ofPowerSeries ℤ ℂ (g i • qExpansion 1 (⇑(f i) : ℍ → ℂ)) =
        (algebraMap ℂ (LaurentSeries ℂ) (g i) *
          (((b i : ↥(riemannRochSpace D)) :
            ↥(laurentBaseChange ℂ (qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma1 M)))) :
              LaurentSeries ℂ)) * W ^ k :=
      fun i => by rw [ofPowerSeries_smul, hf i, hWdef, mul_assoc]
    simp only [h2] at h1
    rw [← Finset.sum_mul] at h1
    rw [h3]; exact h1
  have hsum := (mul_eq_zero.1 hL).resolve_right (pow_ne_zero _ hW)
  have hsumF : (∑ i, vectorSpaceSMul (g i) (b i)) = 0 := by
    apply Subtype.val_injective; apply Subtype.val_injective
    rw [hsum]; rfl
  exact Fintype.linearIndependent_iff.1 b.linearIndependent g hsumF i

private theorem square_mul_mem_riemannRochSpace
    {F : Type*} [Field F] [Algebra ℂ F] (k : ℕ)
    (Dw Pv D1 Dk : AlgebraicCurve.Divisor ℂ F) (v : F) (hvne : v ≠ 0)
    (h2Dw : (2 : ℕ) • Dw = Pv + D1)
    (hPv : ∀ P : AlgebraicCurve.Place ℂ F, Pv P = P.ord v)
    (hEk : ∀ P : AlgebraicCurve.Place ℂ F, (k : ℤ) * D1 P = Dk P)
    (G : ↥(riemannRochSpace (k • Dw))) :
    (G : F) ^ 2 * v ^ k ∈ riemannRochSpace Dk := by
  rw [AlgebraicCurve.mem_riemannRochSpace_iff]
  intro P
  have hG := (AlgebraicCurve.mem_riemannRochSpace_iff.mp G.2) P
  by_cases hG0 : (G : F) = 0
  · left; rw [hG0]; ring
  · right
    rcases hG with hG | hG
    · exact absurd hG hG0
    rw [P.ord_mul (pow_ne_zero _ hG0) (pow_ne_zero _ hvne), ← zpow_natCast, P.ord_zpow, ←
      zpow_natCast,
      P.ord_zpow]
    rw [Finsupp.smul_apply, nsmul_eq_mul] at hG
    have e2 : 2 * Dw P = P.ord v + D1 P := by
      have := congrArg (fun D : AlgebraicCurve.Divisor ℂ _ => D P) h2Dw
      simp only [Finsupp.smul_apply, Finsupp.add_apply, nsmul_eq_mul, Nat.cast_ofNat] at this
      rw [hPv P] at this
      exact_mod_cast this
    have e3 := hEk P
    push_cast
    nlinarith [hG, e2, e3]

private theorem mul_weightFloor (k : ℕ) (a b : ℤ)
    (h0 : 0 < a → a = 3) (h1728 : 0 < b → b = 2) :
    (k : ℤ) * ((if 0 < a then (2 * 1 * a) / 3 else 0) +
      (if 0 < b then (1 * b) / 2 else 0) + (if a < 0 then 1 * a else 0)) =
    (if 0 < a then (2 * (k : ℤ) * a) / 3 else 0) +
      (if 0 < b then ((k : ℤ) * b) / 2 else 0) +
      (if a < 0 then (k : ℤ) * a else 0) := by
  have t1 : (k : ℤ) * (if 0 < a then (2 * 1 * a) / 3 else 0) =
      (if 0 < a then (2 * (k : ℤ) * a) / 3 else 0) := by
    split_ifs with hc
    · rw [h0 hc]; omega
    · simp
  have t2 : (k : ℤ) * (if 0 < b then (1 * b) / 2 else 0) =
      (if 0 < b then ((k : ℤ) * b) / 2 else 0) := by
    split_ifs with hc
    · rw [h1728 hc]; omega
    · simp
  have t3 : (k : ℤ) * (if a < 0 then 1 * a else 0) =
      (if a < 0 then (k : ℤ) * a else 0) := by
    split_ifs <;> simp
  rw [← t1, ← t2, ← t3]
  ring_nf


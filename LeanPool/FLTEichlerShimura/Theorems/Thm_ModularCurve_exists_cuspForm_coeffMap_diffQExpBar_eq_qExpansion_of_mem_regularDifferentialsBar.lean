  have hJ : phi N ι₀ (jB N) = coeffEmb ℂ jq := phi_jB N ι₀
  have h1728 : phi N ι₀ (algebraMap (AlgebraicClosure ℚ) (modularFunctionFieldBar N) 1728) =

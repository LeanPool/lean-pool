open AlgebraicCurve
theorem AlgebraicCurve.Place.ord_smul_of_ne_zero {K F : Type*} [Field K] [Field F] [Algebra K F]
    (v : Place K F) {c : K} (hc : c ≠ 0) (x : F) :
    v.ord (c • x) = v.ord x :=
  solution v hc x


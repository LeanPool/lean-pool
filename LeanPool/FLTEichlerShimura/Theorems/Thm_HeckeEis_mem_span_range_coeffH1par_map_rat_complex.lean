theorem Ψ_mk (z : ↥(coeffParabolicCocycles ((binaryFormRepSL ℚ n).comp Γ.subtype))) :
    Ψ (coeffH1parMk _ z) = coeffH1parMk _ (pushPar ιQC n z) := by
  obtain ⟨w, hw, h⟩ := hΨ z
  rw [h]
  congr 1
  apply Subtype.ext; funext g; apply Subtype.ext
  rw [hw g]
  exact (coe_pushForm_ιQC n _).symm


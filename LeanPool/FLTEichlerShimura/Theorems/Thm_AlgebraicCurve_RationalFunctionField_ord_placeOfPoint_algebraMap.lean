open AlgebraicCurve AlgebraicCurve.RationalFunctionField
theorem AlgebraicCurve.RationalFunctionField.ord_placeOfPoint_algebraMap {K : Type*} [Field K]
    (a : K) {q : Polynomial K} (hq : q ≠ 0) :
    (placeOfPoint K a).ord (algebraMap (Polynomial K) (RatFunc K) q) = Polynomial.rootMultiplicity a
      q := by
  have hX : (placeOfPoint K a).ord
      (algebraMap (Polynomial K) (RatFunc K) (Polynomial.X - Polynomial.C a)) = 1 := by
    rw [placeOfPoint_eq_ofHeightOneSpectrum]
    exact ord_ofHeightOneSpectrum_of_span _ (Polynomial.X_sub_C_ne_zero a)
      (heightOneSpectrumOfIrreducible_asIdeal K (Polynomial.irreducible_X_sub_C a))
  rw [ord_placeOfPoint_algebraMap_eq_mul a hq, hX, mul_one]


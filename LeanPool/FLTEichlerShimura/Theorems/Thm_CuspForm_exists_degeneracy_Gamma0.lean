theorem solution {k : ℤ} {M N d : ℕ} [NeZero N] (hd : d * M ∣ N)
    (f : CuspForm (CongruenceSubgroup.Gamma0 M) k) :
    ∃ g : CuspForm (CongruenceSubgroup.Gamma0 N) k, ⇑g = fun τ ↦ f (ModularForm.heckeDiagMatrix d •
      τ) :=
  ModularForm.DegeneracyPort.exists_cuspForm hd f

end S_CuspForm_exists_degeneracy_Gamma0

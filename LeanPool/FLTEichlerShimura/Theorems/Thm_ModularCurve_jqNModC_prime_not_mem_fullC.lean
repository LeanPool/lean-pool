        rw [← Polynomial.aeval_def]
        exact minpoly.aeval _ _
      rw [h0, map_zero]
    · have hd0 : M / a ≠ 0 := by
        intro h0
        rw [h0, mul_zero] at had
        exact hM0 had.symm

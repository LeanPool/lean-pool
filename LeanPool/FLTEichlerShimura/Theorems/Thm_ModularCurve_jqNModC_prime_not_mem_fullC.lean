open ModularCurve IntermediateField

theorem ModularCurve.jqNModC_prime_not_mem_fullC {K : Type*} [Field K] (M : ℕ) [NeZero M]
    (p : ℕ) [hp : Fact (Nat.Prime p)] (hpM : ¬ p ∣ M) (ζ : Kˣ)
    (hζ : IsPrimitiveRoot (ζ : K) (M * p))
    (hall : ∀ d : ℕ, d ∣ M → ∀ [NeZero d],
      Module.finrank (adjoin K ({jqModC K} : Set (LaurentSeries K)))
          (adjoin (adjoin K ({jqModC K} : Set (LaurentSeries K)))
            ({jqNModC K d} : Set (LaurentSeries K))) = dedekindPsi d ∧
      modularFunctionFieldC K d = adjoin K
        {x : LaurentSeries K | ∃ (d' : ℕ) (_ : NeZero d'), d' ∣ d ∧ x = jqNModC K d'})
    (hbase : jqNModC K p ∉ adjoin K ({jqModC K} : Set (LaurentSeries K))) :
    jqNModC K p ∉ adjoin K
      {x : LaurentSeries K | ∃ (d' : ℕ) (_ : NeZero d'), d' ∣ M ∧ x = jqNModC K d'} :=
  solution M p hpM ζ hζ hall hbase


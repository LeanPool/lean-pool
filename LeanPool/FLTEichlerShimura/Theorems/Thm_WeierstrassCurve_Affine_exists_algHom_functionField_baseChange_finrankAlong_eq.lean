    kw_isogenyEndDatumBaseChangeAlong_of_tensorIsDomainGeneral W F F'
      (kw_functionFieldTensorIsDomain_dischargeGeneral W F F')
      (kw_tensorFracIotaFinrankSeam_dischargeGeneral W F F') σ N


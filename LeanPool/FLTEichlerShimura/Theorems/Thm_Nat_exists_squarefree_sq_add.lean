theorem solution (D : ℕ) (hD : 1 ≤ D) :
    ∃ c : ℕ, 1 ≤ c ∧ Squarefree (c ^ 2 + D) :=
  K2Seam3.SqfreeSieve.kw_existsSqfreeSqAdd_proved D hD


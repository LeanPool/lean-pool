theorem kw_scale_lattice_toAddSubgroup (L : PeriodPair) (α : ℂˣ) :
    (L.scale α).lattice.toAddSubgroup
      = L.lattice.toAddSubgroup.map (AddMonoidHom.mulLeft (α : ℂ)) := by

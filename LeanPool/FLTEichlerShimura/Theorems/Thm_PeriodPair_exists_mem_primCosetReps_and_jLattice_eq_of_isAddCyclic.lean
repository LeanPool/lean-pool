  · exact ⟨α, ⟨-(L.ω₁ / L.ω₂), by simp only [Complex.neg_im]; linarith⟩,
      hlat.trans (kw_span_neg_fst _ _).symm⟩
  · exact ⟨α, ⟨L.ω₁ / L.ω₂, hpos⟩, hlat⟩

end ModularCurve

    obtain ⟨ζ, hζs⟩ := exists_zeta_of_mem_monodromy m.2 (3 / 4 : ℚ)
    have hζ4 : ζ ^ 4 = 1 := zeta_pow_eq_one_of_twist (k := 3) m.2 hζs (by norm_num)

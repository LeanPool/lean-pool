theorem R_iff (T T' : {T : (W1 L).toAffine.Point // addOrderOf T = N}) :
    R N T T' ↔ ∃ γ : VariableChange L, ∃ hγ : γ • W1 L = W1 L, ∃ k : ℕ, k.Coprime N ∧ T'.1 = k •

theorem R_imp_or (u : Lˣ) (hu : (u : L) ^ 2 = -1)
    {T T' : {T : (W1 L).toAffine.Point // addOrderOf T = N}} (h : R N T T') :
    cyc N T' = cyc N T ∨ cyc N T' = τ u hu N (cyc N T) := by

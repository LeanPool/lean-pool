theorem τ_eq_iff (u : Lˣ) (hu : (u : L) ^ 2 = -1) (N : ℕ) (hN : N ≠ 0) (H : CycSub L N) :
    τ u hu N H = H ↔ ∀ T ∈ H.1, σ u hu T ∈ H.1 := by

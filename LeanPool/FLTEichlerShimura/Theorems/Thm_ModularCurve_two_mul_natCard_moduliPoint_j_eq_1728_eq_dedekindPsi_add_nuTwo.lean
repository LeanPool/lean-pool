    obtain ⟨k, hk, hkT⟩ := exists_coprime_nsmul_of_zmultiples_eq hN hordσ T'.2 h'
    exact ⟨⟨u, 0, 0, 0⟩, hσW u hu, k, hk, hkT⟩


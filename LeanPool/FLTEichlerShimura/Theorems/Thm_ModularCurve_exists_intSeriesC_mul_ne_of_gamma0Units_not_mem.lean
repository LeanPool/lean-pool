      (ModularCurve.intSeriesC K p).coeff 1 = ((PowerSeries.coeff 1 p : ℤ) : K) := fun p => by
    rw [ModularCurve.intSeriesC, show (1 : ℤ) = ((1 : ℕ) : ℤ) from rfl,

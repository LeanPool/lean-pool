  have hg0 : ModularCurve.intSeriesC K (PowerSeries.mk fun n =>
      (∑ c ∈ (Finset.univ : Finset (ZMod M)ˣ), faithCoeff M (c * 1) n) / 2) ≠ 0 := by
    intro h
    have h1 := hcoe1 (PowerSeries.mk fun n =>

        rw [hIHM, Polynomial.IsRoot, Polynomial.eval_prod]
        refine Finset.prod_eq_zero (Nat.mem_divisors.mpr ⟨⟨d'', rfl⟩, hM'0⟩) ?_
        rw [Polynomial.eval_prod]

theorem gen_none (t : (Fin 2 → ZMod N) → (Fin 2 → ZMod N)) : gen N t none = jf := rfl

theorem gen_some (t : (Fin 2 → ZMod N) → (Fin 2 → ZMod N)) (v : {v : Fin 2 → ZMod N // v ≠ 0}) :

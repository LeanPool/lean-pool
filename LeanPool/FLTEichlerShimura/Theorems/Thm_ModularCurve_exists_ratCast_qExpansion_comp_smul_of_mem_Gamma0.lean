    ∃ r : ℚ, (UpperHalfPlane.qExpansion 1
      ((fun τ : UpperHalfPlane => G (γ • τ)) * ModularForm.discriminant ^ m)).coeff n = (r : ℂ) :=
  X1DiamondRational.cardK N m G hG hinv hbd hrat γ hγ n


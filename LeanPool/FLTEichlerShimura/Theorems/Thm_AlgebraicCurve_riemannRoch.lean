/-!
# Riemann–Roch for a one-variable function field

`AlgebraicCurve.riemannRoch` packages the existing Riemann–Roch development with field-theoretic
hypotheses: the constant field is algebraically closed, and the function field is finite over the
subfield generated by a transcendental element. It constructs the divisor of each nonzero rational
differential and proves the Riemann–Roch formula for every divisor. The genus is `genusFF`, defined
as the dimension of the adelic cohomology group `H1 0`.

No hypotheses about principal divisors, canonical divisors, residues or local differential
coordinates are required from the caller. Separability of the supplied parameter is not required:
the proof chooses a separating transcendental parameter internally.

Comparable results already exist in Tau Ceti's
`TauCeti.FieldTheory.FunctionField.Differential.CanonicalDivisor` (using Weil differentials) and
`TauCeti.AlgebraicGeometry.WeilDivisor.Scheme.RiemannRoch.Basic` (using scheme cohomology).
LeanPool's `RiemannRochFunctionFields` project also proves `FunctionField.riemann_roch` for
intrinsic divisors over full constant fields; its `JacobianDiffgeo` project proves the analogous
formula for compact Riemann surfaces. These are independent formalizations with different APIs;
this file provides an entry point to the FLT development, not a claim of mathematical novelty.
-/

open scoped IntermediateField

namespace AlgebraicCurve

private theorem riemannRoch_and_constants_of_curve
    {K F : Type*} [Field K] [Field F] [Algebra K F] [IsAlgClosed K]
    [Algebra.EssFiniteType K F] [IsCurveOver K F]
    [HasCanonicalDivisor (K := K) (F := F)] [∀ v : Place K F, v.DCoordGenerates] :
    FunctionFieldRiemannRoch K F ∧ ConstantsAreBase K F := by
  classical
  obtain ⟨t, ht, hfin, hsep⟩ := IsCurveOver.exists_separating_transcendental (K := K) (F := F)
  let e : RatFunc K ≃ₐ[K] K⟮t⟯ := RatFunc.algEquivOfTranscendental t ht
  let : Algebra (RatFunc K) F :=
    ((algebraMap K⟮t⟯ F).comp e.toAlgHom.toRingHom).toAlgebra
  have hsq : RingHom.comp (algebraMap (RatFunc K) F)
        (e.symm.toRingEquiv : K⟮t⟯ →+* RatFunc K)
      = RingHom.comp (RingEquiv.refl F : F →+* F) (algebraMap K⟮t⟯ F) := by
    ext y
    change algebraMap K⟮t⟯ F (e (e.symm y)) = algebraMap K⟮t⟯ F y
    rw [e.apply_symm_apply]
  have : IsScalarTower K (RatFunc K) F := IsScalarTower.of_algebraMap_eq fun a => by
    change algebraMap K F a = algebraMap K⟮t⟯ F (e (algebraMap K (RatFunc K) a))
    rw [e.commutes, ← IsScalarTower.algebraMap_apply]
  have := hfin
  have := hsep
  have : FiniteDimensional (RatFunc K) F :=
    Module.Finite.of_equiv_equiv e.symm.toRingEquiv (RingEquiv.refl F) hsq
  have : Algebra.IsSeparable (RatFunc K) F :=
    Algebra.IsSeparable.of_equiv_equiv e.symm.toRingEquiv (RingEquiv.refl F) hsq
  have : Algebra.IsIntegral (RatFunc K) F := Algebra.IsIntegral.of_finite _ _
  have : IsCurveOver K (RatFunc K) := isCurveOver_ratFunc K
  have : Algebra.EssFiniteType (Polynomial K) (RatFunc K) :=
    Algebra.EssFiniteType.of_isLocalization _ (nonZeroDivisors (Polynomial K))
  have : Algebra.EssFiniteType K (RatFunc K) :=
    Algebra.EssFiniteType.comp K (Polynomial K) (RatFunc K)
  have : ∀ v : Place K (RatFunc K), v.DCoordGenerates := dCoordGenerates_of_isCurveOver
  exact ⟨functionFieldRiemannRoch_of_isAlgClosed_of_isCurveOver,
    constantsAreBase_of_isAlgClosed K F⟩

public section

/-- Riemann–Roch over an algebraically closed constant field. If `F` is finite over `K(t)` for
a transcendental element `t`, every nonzero rational differential `ω` has a canonical divisor `C`,
and `ell D - ell (C - D) = degree D + 1 - genusFF K F` for every divisor `D`. -/
theorem riemannRoch
    {K F : Type*} [Field K] [IsAlgClosed K] [Field F] [Algebra K F]
    (t : F) (ht : Transcendental K t) [FiniteDimensional K⟮t⟯ F]
    {ω : Ω[F⁄K]} (hω : ω ≠ 0) :
    ∃ C : Divisor K F, (∀ v : Place K F, C v = v.ordDifferential ω) ∧
      ∀ D : Divisor K F,
        (ell D : ℤ) - (ell (C - D) : ℤ) = Divisor.degree D + 1 - (genusFF K F : ℤ) := by
  classical
  have : IsCurveOver K F := isCurveOver_of_isAlgClosed_of_transcendental t ht
  have : Algebra.EssFiniteType K F :=
    essFiniteType_of_transcendental_of_finiteDimensional ht inferInstance
  have : HasCanonicalDivisor (K := K) (F := F) := hasCanonicalDivisor_of_isCurveOver
  have : ∀ v : Place K F, v.DCoordGenerates := dCoordGenerates_of_isCurveOver
  obtain ⟨hRR, hconstants⟩ := riemannRoch_and_constants_of_curve (K := K) (F := F)
  have hduality : WeilDualityAdelic K F :=
    weilDualityAdelic_of_functionFieldRiemannRoch_of_stichtenothGenusExists
      hRR (stichtenothGenusExists_of_isCurveOver hconstants)
  have hgenus := genus_eq_genusFF hRR hduality hconstants
  refine ⟨canonicalDivisorOf hω, fun v => canonicalDivisorOf_apply hω v, fun D => ?_⟩
  simpa only [hgenus] using hRR hω D

end

end AlgebraicCurve

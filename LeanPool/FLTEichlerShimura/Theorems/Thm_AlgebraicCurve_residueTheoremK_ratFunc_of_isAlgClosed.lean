    ∀ R : (finitePlace K hpirr).CanonicalLocalResidueDataK,
      Algebra.trace K (finitePlace K hpirr).ResidueField
          (R.res (p1PrincipalPartAtom K p c m
            * (finitePlace K hpirr).differentialCoeff (dX K))) = 0


theorem ModularCurve.B3.exists_variableChange_specialFibre_goodModel (j₀ : Qbar) :
    ∃ C : VariableChange Qbar,
      C • specialFibre (goodModel j₀) = WeierstrassCurve.ofJ j₀ :=
  solution j₀


theorem transcendental_jK : Transcendental ℂ (jK N K) := by
  rw [transcendental_iff]
  intro P hP
  apply eq_zero_of_eval_jAnalytic P
  intro τ
  change Polynomial.aeval (algebraMap (ring N) K (jGen N)) P = 0 at hP

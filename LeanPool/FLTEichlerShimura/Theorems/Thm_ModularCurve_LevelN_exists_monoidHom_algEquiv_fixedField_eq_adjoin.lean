theorem coe_aeval_jGen (p : Polynomial ℂ) (τ : ℍ) :
    ((Polynomial.aeval (jGen N) p : ring N) : ℍ → ℂ) τ = p.eval (jAnalytic τ) := by
  have h1 : ((Polynomial.aeval (jGen N) p : ring N) : ℍ → ℂ) =

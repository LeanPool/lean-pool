theorem ker_σHom : (σHom N K).ker = (ρHom N).ker := by
  rw [σHom, ← MonoidHom.comap_ker,
    (MonoidHom.ker_eq_bot_iff _).mpr (IsFractionRing.fieldEquivOfAlgEquivHom_injective ℂ (ring N) ℂ

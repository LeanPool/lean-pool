      (modularFunctionFieldFull N) = dedekindPsi N := by
  rw [← ModularCurve.modularFunctionField_eq_full N, ModularCurve.relfinrank_modularFunctionField N]
  exact ModularCurve.finrank_adjoin_jqN_eq_dedekindPsi N


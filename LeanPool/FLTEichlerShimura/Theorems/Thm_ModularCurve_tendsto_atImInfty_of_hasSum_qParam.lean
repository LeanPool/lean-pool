theorem ModularCurve.tendsto_atImInfty_of_hasSum_qParam (h : ℝ) (hh : 0 < h) (F : UpperHalfPlane →
  ℂ) (c : ℕ → ℂ) (hc : ∀ τ : UpperHalfPlane, HasSum (fun m : ℕ => c m * Function.Periodic.qParam h
  (τ : ℂ) ^ m) (F τ)) :
    Filter.Tendsto F UpperHalfPlane.atImInfty (nhds (c 0)) :=
  solution h hh F c hc


  · intro hP
    obtain ⟨Q, hQ, hQP⟩ := (Ideal.mem_map_iff_of_surjective _ AdjoinRoot.mk_surjective).mp hP
    obtain ⟨c, hc⟩ := AdjoinRoot.mk_eq_mk.mp hQP

theorem solution (K : Type*) [Field K] (hΦ : ModularPolynomialFamily)
    (N : ℕ) [NeZero N] :
    IsIntegral (IntermediateField.adjoin K ({jqModC K} : Set (LaurentSeries K))) (jqNModC K N) :=
  ModularCurve.AllLevels.isIntegral_jqNModC_all K hΦ N


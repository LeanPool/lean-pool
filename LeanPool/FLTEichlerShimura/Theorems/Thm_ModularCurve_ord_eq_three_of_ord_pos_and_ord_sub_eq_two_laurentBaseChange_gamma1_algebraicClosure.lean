    (hfd : FiniteDimensional ℂ⟮t⟯ K)
    (hgal : IsGalois ℂ⟮t⟯ K)
    (hker : σ.ker = Gamma M ⊔ Subgroup.zpowers (-1 : SL(2, ℤ)))

    hfd hgal hint W₀ hW₀
  obtain ⟨ψ, hψ, rfl⟩ := h3 w hw
  rw [h5 ψ hψ, h1]
  have htmem : t ∈ ℂ⟮t⟯ := mem_adjoin_simple_self ℂ t
  have hσt : ∀ g : K ≃ₐ[ℂ⟮t⟯] K, g t = t := fun g =>
    g.commutes (⟨t, htmem⟩ : ℂ⟮t⟯)
  have hle' : ℂ⟮t⟯ ≤ E :=
    adjoin_simple_le_iff.mpr (by rw [← hv]; exact v.2)
  let rSH : (K ≃ₐ[ℂ⟮t⟯] K) →* (K ≃ₐ[ℂ] K) :=

    exact this
  have hfixL : ∀ (d : SL(2, ℤ)), ∀ z ∈ ℂ⟮t⟯, σ d z = z := fun d z hz => by
    rw [← hfix] at hz
    exact (mem_fixedField_iff _ z).mp hz _ ⟨d, rfl⟩
  have hrange : σ.range = rSH.range := by
    have hle : σ.range ≤ rSH.range := by

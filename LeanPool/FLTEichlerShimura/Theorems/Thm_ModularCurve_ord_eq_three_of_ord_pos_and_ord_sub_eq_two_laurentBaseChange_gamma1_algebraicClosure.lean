  have : IsScalarTower ℚ̄ ℂ ↥E := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower ℚ̄ ↥(laurentBaseChange ℚ̄ (qExpFunctionFieldC ℚ (Gamma1 M))) ↥E :=
    IsScalarTower.of_algebraMap_eq fun c =>
    Subtype.ext (by
      change ((algebraMap ℂ ↥E (ι c) : ↥E) : K) = ((ΦE (algebraMap ℚ̄ ↥(laurentBaseChange ℚ̄
        (qExpFunctionFieldC ℚ (Gamma1 M))) c) : ↥E) : K)
      rw [hcoeC, hΦE, hΦc])
  obtain ⟨x₀, hx₀tr, hx₀fd⟩ :=
    ModularCurve.JOneES.exists_transcendental_finiteDimensional_laurentBaseChange ℚ̄ (Gamma1 M) hT
  have : IsCurveOver ℚ̄ ↥(laurentBaseChange ℚ̄ (qExpFunctionFieldC ℚ (Gamma1 M))) :=
    isCurveOver_of_transcendental_of_perfectField hx₀tr hx₀fd
  have htr' : Transcendental ℂ (ΦE y) := fun h => htr (by
    have h' := isAlgebraic_iff.mp h
    rwa [hΦE, hΦy'] at h')
  have hEfd : FiniteDimensional ↥(adjoin ℂ ({ΦE y} : Set ↥E)) ↥E := by
    have hlift : lift (adjoin ℂ ({ΦE y} : Set ↥E)) = ℂ⟮t⟯ := by
      rw [lift_adjoin_simple, hΦE, hΦy']
    have hle' : ℂ⟮t⟯ ≤ E := by rw [← hlift]; exact lift_le _
    let E₂ : IntermediateField ℂ⟮t⟯ K := extendScalars hle'
    have hE₂ : FiniteDimensional ℂ⟮t⟯ ↥E₂ := inferInstance
    let e₁ : ↥(adjoin ℂ ({ΦE y} : Set ↥E)) ≃ₐ[ℂ] ℂ⟮t⟯ :=
      (liftAlgEquiv _).trans (equivOfEq hlift)
    let e₂ : ↥E₂ ≃+* ↥E := RingEquiv.refl _
    exact Module.Finite.of_equiv_equiv e₁.symm.toRingEquiv e₂ (by
      refine RingHom.ext fun w => Subtype.ext ?_
      have h1 : ∀ v : ↥(adjoin ℂ ({ΦE y} : Set ↥E)), ((e₁ v : ℂ⟮t⟯) : K) = ((v : ↥E) : K) :=
        fun v => rfl
      have h2 := congrArg (fun u : ℂ⟮t⟯ => (u : K)) (e₁.apply_symm_apply w)
      simp only [h1] at h2
      exact h2)
  have hgen : adjoin ℂ (Set.range (algebraMap ↥(laurentBaseChange ℚ̄ (qExpFunctionFieldC ℚ (Gamma1
    M))) ↥E)) = ⊤ :=
    by
    apply lift_injective
    rw [lift_adjoin, lift_top]
    have : Subtype.val '' Set.range (algebraMap ↥(laurentBaseChange ℚ̄ (qExpFunctionFieldC ℚ (Gamma1
      M))) ↥E) = Set.range Φ :=
      by
      ext w
      constructor
      · rintro ⟨_, ⟨f, rfl⟩, rfl⟩; exact ⟨f, (hΦE f).symm⟩
      · rintro ⟨f, rfl⟩; exact ⟨ΦE f, ⟨f, rfl⟩, hΦE f⟩
    rw [this]
  obtain ⟨P', -, hP'ord, -⟩ := Place.exists_comap_algebraMap_eq_of_constantFieldExtension
    ℚ̄ ↥(laurentBaseChange ℚ̄ (qExpFunctionFieldC ℚ (Gamma1 M))) ℂ ↥E ⟨x₀, hx₀tr, hx₀fd⟩ ⟨ΦE y,
      htr', hEfd⟩ hgen P
  have hvaly : E.val (ΦE y) = t := by rw [coe_val]; exact (hΦE y).trans hΦy'
  have hint : ∀ ψ : ↥E →ₐ[ℂ] K, ψ (ΦE y) = t → ψ.toRingHom.IsIntegral := by
    intro ψ hψ
    let S : Subalgebra ℂ K := ψ.range
    have hleS : ℂ⟮t⟯.toSubalgebra ≤ S := by
      have : ℂ⟮t⟯ ≤ ψ.fieldRange :=
        adjoin_simple_le_iff.mpr ⟨ΦE y, hψ⟩
      intro w hw
      exact (AlgHom.mem_fieldRange.mp (this hw))
    let algRS : Algebra ℂ⟮t⟯ ↥S := (Subalgebra.inclusion hleS).toRingHom.toAlgebra
    have : IsScalarTower ℂ⟮t⟯ ↥S K := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have : Module.Finite ↥S K := Module.Finite.of_restrictScalars_finite ℂ⟮t⟯ _ _
    have : Algebra.IsIntegral ↥S K := Algebra.IsIntegral.of_finite _ _
    have hS : (algebraMap ↥S K).IsIntegral := fun x => Algebra.IsIntegral.isIntegral (R := ↥S) x
    let e : ↥E ≃ₐ[ℂ] ↥S := AlgEquiv.ofInjective ψ ψ.toRingHom.injective
    have he : ψ.toRingHom = (algebraMap ↥S K).comp e.toAlgHom.toRingHom := by
      refine RingHom.ext fun x => ?_
      change ψ x = ((e x : ↥S) : K)
      rw [AlgEquiv.ofInjective_apply]
    rw [he]
    exact RingHom.IsIntegral.trans _ _ (RingHom.isIntegral_of_surjective e.toAlgHom.toRingHom
      e.surjective) hS
  have hΦfixσ : ∀ γ ∈ Gamma1 M, ∀ u, σ γ (Φ u) = Φ u :=
    fun γ hγ u => hΦfix γ hγ (hst γ⁻¹) (σ γ) (hσ γ) u
  have hfixer : ∀ η : SL(2, ℤ), (∀ e : ↥E, σ η (e : K) = (e : K)) →
      η ∈ Gamma1 M ⊔ Subgroup.zpowers (-1 : SL(2, ℤ)) := by
    intro η hη
    exact ModularCurve.LevelN.Descent.fixer_le M K t σ hker hfd hgal hdeg ι Φ E'
      hE'j hE'Φ y hy hΦy' hΦfixσ η (fun u => hη ⟨Φ u, hΦmem u⟩)
  have keyEQ := ModularCurve.NoEllAux.keyEQ M hM t E (ΦE y) σ hvaly hfd hgal
    hker hfix hdeg hint hfixer
  have h0E : P'.ord (ΦE y) = P.ord y := by rw [← hP'ord y]; rfl
  have h1728E : P'.ord (ΦE y - 1728) = P.ord (y - 1728) :=
    by rw [← hP'ord (y - 1728), map_sub, map_ofNat]; rfl
  refine ⟨fun hpos => ?_, fun hpos => ?_⟩
  · have hk := keyEQ 0 W0 (ModularGroup.S * ModularGroup.T) UpperHalfPlane.ρ ST_smul_ρ
      (by rw [map_zero, sub_zero, hW0]; norm_num) hD0 P'
    simp only [map_zero, sub_zero] at hk
    rw [h0E, hW0] at hk
    exact hk hpos
  · have hk := keyEQ 1728 W1728 ModularGroup.S UpperHalfPlane.I S_smul_I
      (by rw [map_ofNat, hW1728]; norm_num) hD1728 P'
    simp only [map_ofNat] at hk
    rw [h1728E, hW1728] at hk
    exact hk hpos

theorem solution
    (M : ℕ) [NeZero M] (hM : 4 ≤ M)
    (y : ↥(laurentBaseChange ℚ̄ (qExpFunctionFieldC ℚ (Gamma1 M))))
    (hy : (y : LaurentSeries ℚ̄) = ModularCurve.jqModC ℚ̄)
    (P : Place ℚ̄
      ↥(laurentBaseChange ℚ̄ (qExpFunctionFieldC ℚ (Gamma1 M)))) :
    (0 < P.ord y → P.ord y = 3) ∧ (0 < P.ord (y - 1728) → P.ord (y - 1728) = 2) :=
  ModularCurve.NoEllAux.main M hM y hy P

end


  let algFE : Algebra ↥(laurentBaseChange ℚ̄ (qExpFunctionFieldC ℚ (Gamma1 M))) ↥E := ΦE.toAlgebra
  let algQC : Algebra ℚ̄ ℂ := ι.toAlgebra

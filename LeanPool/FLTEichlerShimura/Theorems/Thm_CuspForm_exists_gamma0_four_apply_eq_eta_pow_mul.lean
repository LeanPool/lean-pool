  have hA₂H : A₂ ∈ H := ih _ hlt A₂ (by rw [hA₂c']) (by rw [hA₂c']; exact h4c')
  have : A = A₂ * R ^ (-n₂) * ModularGroup.T ^ (-n₁) := by
    rw [hA₂, hA₁]; group

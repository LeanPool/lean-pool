lemma denom_S (z : ℍ) :
    UpperHalfPlane.denom (Matrix.SpecialLinearGroup.toGL ((Matrix.SpecialLinearGroup.map
      (Int.castRingHom ℝ)) ModularGroup.S)) (z : ℂ) = z := by
  rw [denom_SL]; simp [ModularGroup.coe_S]

lemma denom_T_zpow (n : ℤ) (z : ℍ) :
    UpperHalfPlane.denom (Matrix.SpecialLinearGroup.toGL ((Matrix.SpecialLinearGroup.map

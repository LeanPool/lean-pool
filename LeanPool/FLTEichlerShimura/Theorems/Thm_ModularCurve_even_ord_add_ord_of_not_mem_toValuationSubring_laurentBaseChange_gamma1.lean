  have hmem : (σ : GL (Fin 2) ℝ) ∈ (𝒮ℒ : Subgroup (GL (Fin 2) ℝ)) := ⟨σ, rfl⟩
  have := SlashInvariantForm.slash_action_eqn'' F hmem τ
  rwa [show (σ : GL (Fin 2) ℝ) • τ = σ • τ from rfl] at this

theorem cexp_readout_eq (h : ℕ) (a : ℤ) (τ : ℍ) :

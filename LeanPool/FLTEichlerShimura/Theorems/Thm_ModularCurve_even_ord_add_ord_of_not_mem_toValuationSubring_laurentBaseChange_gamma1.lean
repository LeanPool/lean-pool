    have hlim : Tendsto (fun τ : ℍ =>
        -((((w : ℍ → ℂ) ∣[(1 : ℤ)] (σ : GL (Fin 2) ℝ)) τ / Function.Periodic.qParam (h : ℝ) (τ : ℂ)

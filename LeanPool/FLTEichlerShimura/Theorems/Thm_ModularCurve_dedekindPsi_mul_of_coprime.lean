p2m_open_scoped "ModularCurve.ModularPolynomialData" in
private theorem _root_.ModularCurve.ModularPolynomialData.eval₂_qExpand_eq_zero {N : ℕ} [NeZero N]
    (data : ModularPolynomialData N) (ℓ : ℕ) [NeZero ℓ] :

scoped instance finiteDimensional_adjoin_jBar (N : ℕ) [NeZero N] :
    FiniteDimensional
      (IntermediateField.adjoin (AlgebraicClosure ℚ)
        ({(jBar N : modularFunctionFieldBar N)} : Set (modularFunctionFieldBar N)))

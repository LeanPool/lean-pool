    have h1 : v₀.ord (algebraMap W.CoordinateRing W.FunctionField r) ≠ 0 :=
      (AlgebraicCurve.Place.ord_ofHeightOneSpectrum_ne_zero_iff
        (heightOneSpectrumOfEquation hy₀) hr0).mpr hrmem

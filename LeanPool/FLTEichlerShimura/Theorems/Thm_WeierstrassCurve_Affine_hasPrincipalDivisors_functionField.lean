    (K := F) (algebraMap W.CoordinateRing W.FunctionField r) hrL0
  have hDnonneg : ∀ w : AlgebraicCurve.Place F W.FunctionField, 0 ≤ D w := by
    intro w
    rw [hD w]
    exact AlgebraicCurve.Place.ord_nonneg_of_mem w (hcon w r)

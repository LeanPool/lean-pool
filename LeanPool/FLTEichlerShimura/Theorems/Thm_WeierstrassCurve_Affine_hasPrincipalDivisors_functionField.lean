theorem isUnit_coeIdeal_of_isMaximal [IsAlgClosed F] (hΔ : W.Δ ≠ 0)
    {𝔪 : Ideal W.CoordinateRing} (h𝔪 : 𝔪.IsMaximal) :
    IsUnit (𝔪 : FractionalIdeal W.CoordinateRing⁰ W.FunctionField) := by

theorem coeffHeckeU_comm (p q : ℕ) (a : ℕ → ℂ) :
    coeffHeckeU p (coeffHeckeU q a) = coeffHeckeU q (coeffHeckeU p a) := by
  funext n
  simp only [coeffHeckeU_apply, Nat.mul_right_comm]


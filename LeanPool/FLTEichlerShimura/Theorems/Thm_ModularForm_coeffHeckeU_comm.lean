theorem solution (p q : ℕ) (a : ℕ → ℂ) :
    ModularForm.coeffHeckeU p (ModularForm.coeffHeckeU q a) = ModularForm.coeffHeckeU q
      (ModularForm.coeffHeckeU p a) :=
  M4cP1W2.coeffHeckeU_comm p q a


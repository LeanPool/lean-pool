    [DecidableEq K] [IsAlgClosed K] (W : WeierstrassCurve F) [W.IsElliptic] {n : ℕ}
    (hn : (n : K) ≠ 0) (Q : (W⁄K).Point) :
    (fibSet W K n Q).Finite :=

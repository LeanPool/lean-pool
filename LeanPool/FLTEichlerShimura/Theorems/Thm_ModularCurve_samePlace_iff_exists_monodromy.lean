namespace P2MW.S_ModularCurve_samePlace_iff_exists_monodromy

open HahnSeries ModularCurve AlgebraicCurve

theorem solution (N : ℕ) [NeZero N] (j₀ : AlgebraicClosure ℚ)
    (ψ ψ' : Emb N j₀) :
    SamePlace ψ.1 ψ'.1 ↔
      ∃ m ∈ monodromy (AlgebraicClosure ℚ),
        (↑m : HahnSeries ℚ (AlgebraicClosure ℚ) →ₐ[AlgebraicClosure ℚ]
          HahnSeries ℚ (AlgebraicClosure ℚ)).comp ψ.1 = ψ'.1 := by
  rw [ModularCurve.samePlace_iff_exists_hahnTwist]
  constructor
  · rintro ⟨χ, hχ, h⟩
    refine ⟨hahnTwistHom χ, Subgroup.mem_map_of_mem _ hχ, AlgHom.ext fun x => ?_⟩
    simpa only [AlgHom.comp_apply, hahnTwistHom_apply, AlgEquiv.toAlgHom_apply] using
      (h x).symm
  · rintro ⟨m, hm, h⟩
    obtain ⟨χ, hχ, rfl⟩ := Subgroup.mem_map.mp hm
    refine ⟨χ, hχ, fun x => ?_⟩
    simpa only [AlgHom.comp_apply, hahnTwistHom_apply, AlgEquiv.toAlgHom_apply] using
      (AlgHom.congr_fun h x).symm

end S_ModularCurve_samePlace_iff_exists_monodromy
end P2MW

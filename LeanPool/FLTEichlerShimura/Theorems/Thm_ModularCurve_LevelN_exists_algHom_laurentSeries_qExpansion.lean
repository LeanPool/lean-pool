  intro G hG
  rw [SetLike.mem_coe, AlgHom.mem_equalizer]
  funext τ'
  rcases hG with rfl | ⟨v, hv, rfl⟩
  · exact jAnalytic_smul γ τ'
  · exact fricke_smul_of_mem N v hγ τ'


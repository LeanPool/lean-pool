theorem es1a10_ncVertical_reducesTo_sq {f : F} {c : K}
    (hf : es1a10_ncVertical_reducesTo v f c) :
    es1a10_ncVertical_reducesTo v (f ^ 2) (c ^ 2) := by
  rw [pow_two, pow_two]

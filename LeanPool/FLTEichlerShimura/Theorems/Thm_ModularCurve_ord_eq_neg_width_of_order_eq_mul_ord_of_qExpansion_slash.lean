  exact (ModularCurve.exists_ringHom_place_order_eq_mul_ord_of_qExpansion_slash
    (Gamma1 M) (T_mem_Gamma1 M) (ModularCurve.qExpFunctionFieldC ℚ (Gamma1 M))

      D₁.hfin D₂.hfin (ModularCurve.finiteAlong_comp D₁.hfin D₂.hfin)
      (normFormulaAlong_of_elliptic D₁.ι D₁.hfin)
      (normFormulaAlong_of_elliptic D₂.ι D₂.hfin)
      (normFormulaAlong_of_elliptic (D₂.ι.comp D₁.ι) (ModularCurve.finiteAlong_comp D₁.hfin

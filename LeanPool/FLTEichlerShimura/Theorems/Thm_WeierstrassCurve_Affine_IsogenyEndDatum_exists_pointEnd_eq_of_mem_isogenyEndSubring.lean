  refine AddMonoidHom.ext fun P => ?_
  change pointMapOfPushforward (D₂.ι.comp D₁.ι) (isIntegral_comp_ι D₁ D₂)
      (ModularCurve.finiteAlong_comp D₁.hfin D₂.hfin) _ P
    = pointMapOfPushforward D₁.ι D₁.hι D₁.hfin _

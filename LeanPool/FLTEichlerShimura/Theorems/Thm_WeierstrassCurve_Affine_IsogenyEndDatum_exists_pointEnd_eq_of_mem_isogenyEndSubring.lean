  change genusOnePic0Equiv W (Pic0.pushforwardAlongHom (D₂.ι.comp D₁.ι) _ _ _
        ((genusOnePic0Equiv W).symm P))
    = genusOnePic0Equiv W (Pic0.pushforwardAlongHom D₁.ι _ _ _

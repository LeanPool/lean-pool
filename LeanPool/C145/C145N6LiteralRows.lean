/-- The exact rational squares of the six modal overlaps. -/
def overlapSquare (i : Fin 6) : ℝ :=
  ![(14161 : ℝ) / 61206,(6241 : ℝ) / 20402,(14161 : ℝ) / 61206,(14161 : ℝ) / 122412,(14161 : ℝ) /
    204020,(14161 : ℝ) / 306030] i

/-- The affine tensor family through the literal base in the literal direction. -/
def tensorLine (t : ℝ) : Tensor := fun i j k => baseTensor i j k + t * directionTensor i j k
/-- Full weighted associativity residual, INCLUDING the ground summand r=0. -/
def assocResidual (X : Tensor) (i j k l : Fin 6) : ℝ :=
  ∑ r : Fin 6, (X i k r * X j l r-X i l r * X j k r) / overlapSquare r

/-- The coefficient of the squared line parameter in the first associativity constraint. -/
def q0 : ℝ := (-31708838956059081706040731104129454182624 : ℝ) / 14161

/-- The coefficient of the line parameter in the first associativity constraint. -/
def l0 : ℝ := (-1013041997662421555867 : ℝ) / 12019

/-- The coefficient of the squared line parameter in the second associativity constraint. -/
def q1 : ℝ := (100153572046061606829291436418360265632064 : ℝ) / 14161

/-- The coefficient of the line parameter in the second associativity constraint. -/
def l1 : ℝ := (1729844844737481701199 : ℝ) / 12019

theorem overlapSquare_positive (i : Fin 6) : 0 < overlapSquare i := by
  fin_cases i <;> norm_num [overlapSquare]

theorem first_actual_row (t : ℝ) :
    assocResidual (tensorLine t) 1 2 1 2 = q0 * t ^ 2 + l0 * t := by
  norm_num [assocResidual, Fin.sum_univ_succ, tensorLine, baseTensor, directionTensor,
    overlapSquare, q0, l0]; ring

theorem second_actual_row (t : ℝ) :
    assocResidual (tensorLine t) 1 2 1 3 = q1 * t ^ 2 + l1 * t := by
  norm_num [assocResidual, Fin.sum_univ_succ, tensorLine, baseTensor, directionTensor,
    overlapSquare, q1, l1]; ring


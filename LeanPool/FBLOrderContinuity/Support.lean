/-!
# Support functions, compact disks, and order-continuity witnesses

This module supplies the geometric tools of Section 4. The absolute support function
`support K` is a continuous seminorm when K is nonempty and bounded. For finite p,
`IsPCompactDisk p K` describes a disk generated by a p-summable sequence; at infinity
it describes a nonempty absolutely convex compact set.

`majorant_norm` computes the free norm using finite p-sum majorants. `summable_support`
constructs free-lattice elements from summable disks. The support topologies `tauP`
control all free functions through `summable_local_control` and
`summable_global_domination`; `positive_patches` detects nonzero common lower bounds.

The remaining results give finite-support approximation, the restriction-polar
identity, finite-support majorants, and compact-support order-null sequences.
`seriesDisk_properties` assembles compact witnesses for Extension and Parameters.
The paper calls uniform convergence on norm-compact sets `boundedWeakStar`; topology
comparisons use Lean's reverse ordering of topologies by their open sets.
-/

@[expose] public section

noncomputable section
open scoped BigOperators ENNReal NNReal Topology Pointwise
open Filter Set
universe u v
namespace FBLOrderContinuousLH

variable {E : Type u} {F : Type v}
  [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- The absolute support function of A: the supremum of `|φ x|` over x in A. The
real supremum is conditional, so the seminorm and continuity statements require A to
be nonempty and bounded. Compact and p-compact sets provide these hypotheses below. -/
def support (A : Set E) (φ : Dual E) : ℝ := compactSupport A φ

private theorem support_bddAbove (A : Set E) (hb : Bornology.IsBounded A) (φ : Dual E) :
    BddAbove ((fun x : E => |φ x|) '' A) := by
  obtain ⟨R, hR⟩ := hb.exists_norm_le
  refine ⟨‖φ‖ * R, ?_⟩
  rintro _ ⟨x, hx, rfl⟩
  exact (φ.le_opNorm x).trans (mul_le_mul_of_nonneg_left (hR x hx) (norm_nonneg φ))

private theorem le_support (A : Set E) (hb : Bornology.IsBounded A) (φ : Dual E)
    {x : E} (hx : x ∈ A) : |φ x| ≤ support A φ :=
  le_csSup (support_bddAbove A hb φ) (mem_image_of_mem _ hx)

private theorem support_smul (A : Set E) (a : ℝ) (φ : Dual E) :
    support A (a • φ) = |a| * support A φ :=
  compactSupport_smul A a φ

private theorem support_zero (A : Set E) : support A (0 : Dual E) = 0 := by
  simpa only [zero_smul, abs_zero, zero_mul] using support_smul A 0 (0 : Dual E)

/-- Section 4.1: support as a seminorm, for its specified domain of validity. -/
def supportSeminorm (A : Set E) (hA : A.Nonempty) (hb : Bornology.IsBounded A) :
    Seminorm ℝ (Dual E) where
  toFun := support A
  map_zero' := by simp [support, compactSupport, hA]
  add_le' := by
    intro φ ψ
    apply csSup_le (hA.image _)
    rintro _ ⟨x, hx, rfl⟩
    exact (abs_add_le (φ x) (ψ x)).trans
      (add_le_add (le_support A hb φ hx) (le_support A hb ψ hx))
  neg' := by simp [support, compactSupport]
  smul' := by simpa only [Real.norm_eq_abs] using support_smul A

/-- Section 4.1: norm continuity of bounded support functions. -/
theorem support_continuous (A : Set E) (hA : A.Nonempty) (hb : Bornology.IsBounded A) :
    Continuous (support A) := by
  obtain ⟨R, hR, hAR⟩ := hb.exists_pos_norm_le
  apply Seminorm.continuous_of_continuousAt_zero (p := supportSeminorm A hA hb)
  rw [ContinuousAt, map_zero]
  apply squeeze_zero (fun φ => apply_nonneg (supportSeminorm A hA hb) φ)
    (g := fun φ : Dual E => R * ‖φ‖)
  · intro φ
    apply csSup_le (hA.image _)
    rintro _ ⟨x, hx, rfl⟩
    exact (φ.le_opNorm x).trans (by nlinarith [hAR x hx, norm_nonneg φ])
  · simpa only [norm_zero, mul_zero] using
      ((continuous_norm : Continuous (fun φ : Dual E => ‖φ‖)).const_mul R).tendsto 0

/-- A norm-compact support function belongs to the endpoint free lattice. -/
theorem compact_support_inFree_infinity (K : Set E) (hK : IsCompact K) :
    InFree Exponent.infinity (support K) :=
  (infinity_representation (compactSupport K)).mpr
    ⟨compactSupport_homogeneous K, compactSupport_continuous hK⟩

/-- The auxiliary weak p-norm of a finite family. -/
def weakPNorm (p : Exponent) {n : ℕ} (φ : Fin n → Dual E) : ℝ :=
  sSup {r | ∃ x : E, ‖x‖ ≤ 1 ∧ r = scalarPSum p (fun i => φ i x)}

/-- A full-dual function obtained by applying a continuous positively homogeneous
function of finitely many real coordinates to evaluations at finitely many vectors.
This is the class A_E used in the proof of Lemma 4.2. -/
def IsFiniteCalculusFunction (f : Dual E → ℝ) : Prop :=
  ∃ (n : ℕ) (x : Fin n → E) (H : posHomFunctions n),
    ∀ φ, f φ = H.1 (fun i => φ (x i))

/-- The infimum of the scalar p-sums of vector norms over all finite evaluation
p-sums that dominate the absolute value of f. For finite calculus functions and finite p,
`finite_calculus_membership` identifies this cost with the free norm. -/
def majorantCost (p : Exponent) (f : Dual E → ℝ) : ℝ :=
  sInf {r : ℝ | ∃ (m : ℕ) (x : Fin m → E),
    r = scalarPSum p (fun i => ‖x i‖) ∧
    ∀ φ, |f φ| ≤ scalarPSum p (fun i => φ (x i))}

/- The majorant gauge is constructed on the solid ideal of finitely majorized
functions. Its completion is p-convex, so the free universal property compares
this gauge with the free norm. -/

private theorem scalarPSum_rpow (p : Exponent) (hp : p.IsFinite) {n : ℕ}
    (a : Fin n → ℝ) : (scalarPSum p a) ^ p.1.toReal = ∑ i, |a i| ^ p.1.toReal := by
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  simp only [scalarPSum, ite_eq_right (ne_of_lt hp), one_div]
  exact Real.rpow_inv_rpow
    (Finset.sum_nonneg (fun i _ => Real.rpow_nonneg (abs_nonneg _) _)) hp0.ne'

private theorem scalarPSum_append_rpow (p : Exponent) (hp : p.IsFinite) {n m : ℕ}
    (a : Fin n → ℝ) (b : Fin m → ℝ) :
    scalarPSum p (Fin.append a b) ^ p.1.toReal =
      scalarPSum p a ^ p.1.toReal + scalarPSum p b ^ p.1.toReal := by
  simp only [scalarPSum_rpow p hp, Fin.sum_univ_add, Fin.append_left, Fin.append_right]

private theorem scalarPSum_append_left (p : Exponent) (hp : p.IsFinite) {n m : ℕ}
    (a : Fin n → ℝ) (b : Fin m → ℝ) : scalarPSum p a ≤ scalarPSum p (Fin.append a b) := by
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  apply (Real.rpow_le_rpow_iff (scalarPSum_nonneg ..) (scalarPSum_nonneg ..) hp0).mp
  rw [scalarPSum_append_rpow p hp]
  exact le_add_of_nonneg_right (Real.rpow_nonneg (scalarPSum_nonneg ..) _)

private theorem scalarPSum_append_right (p : Exponent) (hp : p.IsFinite) {n m : ℕ}
    (a : Fin n → ℝ) (b : Fin m → ℝ) : scalarPSum p b ≤ scalarPSum p (Fin.append a b) := by
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  apply (Real.rpow_le_rpow_iff (scalarPSum_nonneg ..) (scalarPSum_nonneg ..) hp0).mp
  rw [scalarPSum_append_rpow p hp]
  exact le_add_of_nonneg_left (Real.rpow_nonneg (scalarPSum_nonneg ..) _)

/-- Domination in absolute value by evaluations of one finite vector p-sum. -/
def Majorized (p : Exponent) (f : Dual E → ℝ) : Prop :=
  ∃ (n : ℕ) (x : Fin n → E), ∀ φ, |f φ| ≤ scalarPSum p (fun i => φ (x i))

/-- The order ideal of functions admitting a finite vector p-sum majorant. -/
def majorantIdeal (p : Exponent) (hp : p.IsFinite) : OrderIdeal (Dual E → ℝ) :=
  OrderIdeal.ofSolid
    { carrier := {f | Majorized p f}
      zero_mem' := ⟨1, fun _ => 0, by intro φ; simp [scalarPSum_fin1]⟩
      add_mem' := by
        rintro f g ⟨n, x, hx⟩ ⟨m, y, hy⟩
        refine ⟨n + m, fun i => (2 : ℝ) • Fin.append x y i, ?_⟩
        intro φ
        have heq : (fun i => φ (Fin.append x y i)) =
            Fin.append (fun i => φ (x i)) (fun i => φ (y i)) := by
          funext i
          exact Fin.addCases (fun j => by simp) (fun j => by simp) i
        simp only [Pi.add_apply, map_smul, smul_eq_mul, scalarPSum_smul,
          abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2), heq]
        have h₁ := scalarPSum_append_left p hp (fun i => φ (x i)) (fun i => φ (y i))
        have h₂ := scalarPSum_append_right p hp (fun i => φ (x i)) (fun i => φ (y i))
        linarith [abs_add_le (f φ) (g φ), hx φ, hy φ]
      smul_mem' := by
        rintro c f ⟨n, x, hx⟩
        refine ⟨n, fun i => c • x i, ?_⟩
        intro φ
        simp only [Pi.smul_apply, map_smul, smul_eq_mul, scalarPSum_smul, abs_mul]
        exact mul_le_mul_of_nonneg_left (hx φ) (abs_nonneg c) }
    (by
      rintro f g ⟨n, x, hx⟩ hgf
      exact ⟨n, x, fun φ => (hgf φ).trans (hx φ)⟩)

/-- Functions with a finite vector majorant whose p-sum cost is at most one. -/
def majorantUnit (p : Exponent) (hp : p.IsFinite) :
    Set (majorantIdeal (E := E) p hp).toVectorSublattice :=
  {f | ∃ (n : ℕ) (x : Fin n → E), scalarPSum p (fun i => ‖x i‖) ≤ 1 ∧
    ∀ φ, |f.1 φ| ≤ scalarPSum p (fun i => φ (x i))}

theorem majorantUnit_balanced (p : Exponent) (hp : p.IsFinite) :
    Balanced ℝ (majorantUnit (E := E) p hp) := by
  rw [balanced_iff_smul_mem]
  rintro c hc f ⟨n, x, hx, hf⟩
  refine ⟨n, fun i => c • x i, ?_, ?_⟩
  · simp only [norm_smul, Real.norm_eq_abs, scalarPSum_smul, abs_abs]
    exact (mul_le_of_le_one_left (scalarPSum_nonneg ..)
      (by simpa only [Real.norm_eq_abs] using hc)).trans hx
  · intro φ
    change |c * f.1 φ| ≤ _
    simp only [map_smul, smul_eq_mul, scalarPSum_smul, abs_mul]
    exact mul_le_mul_of_nonneg_left (hf φ) (abs_nonneg c)

private theorem scalarPSum_weighted_append (p : Exponent) (hp : p.IsFinite)
    {n m : ℕ} (a : Fin n → ℝ) (b : Fin m → ℝ) {c d : ℝ}
    (hc : 0 ≤ c) (hd : 0 ≤ d) :
    scalarPSum p (Fin.append (fun i => c ^ (p.1.toReal)⁻¹ * a i)
      (fun i => d ^ (p.1.toReal)⁻¹ * b i)) ^ p.1.toReal =
      c * scalarPSum p a ^ p.1.toReal + d * scalarPSum p b ^ p.1.toReal := by
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  rw [scalarPSum_append_rpow p hp, scalarPSum_smul, scalarPSum_smul,
    abs_of_nonneg (Real.rpow_nonneg hc _), abs_of_nonneg (Real.rpow_nonneg hd _),
    Real.mul_rpow (Real.rpow_nonneg hc _) (scalarPSum_nonneg ..),
    Real.mul_rpow (Real.rpow_nonneg hd _) (scalarPSum_nonneg ..),
    Real.rpow_inv_rpow hc hp0.ne', Real.rpow_inv_rpow hd hp0.ne']

theorem majorantUnit_convex (p : Exponent) (hp : p.IsFinite) :
    Convex ℝ (majorantUnit (E := E) p hp) := by
  have hp1 : 1 ≤ p.1.toReal := by exact_mod_cast ENNReal.toReal_mono (ne_of_lt hp) p.2
  have hp0 : 0 < p.1.toReal := zero_lt_one.trans_le hp1
  rintro f ⟨n, x, hx, hf⟩ g ⟨m, y, hy, hg⟩ c d hc hd hcd
  let z : Fin (n + m) → E := Fin.append (fun i => c ^ (p.1.toReal)⁻¹ • x i)
    (fun i => d ^ (p.1.toReal)⁻¹ • y i)
  have heval (φ : Dual E) : (fun i => φ (z i)) =
      Fin.append (fun i => c ^ (p.1.toReal)⁻¹ * φ (x i))
        (fun i => d ^ (p.1.toReal)⁻¹ * φ (y i)) := by
    funext i
    exact Fin.addCases (fun j => by simp [z]) (fun j => by simp [z]) i
  have hnorm : (fun i => ‖z i‖) =
      Fin.append (fun i => c ^ (p.1.toReal)⁻¹ * ‖x i‖)
        (fun i => d ^ (p.1.toReal)⁻¹ * ‖y i‖) := by
    funext i
    exact Fin.addCases
      (fun j => by simp [z, norm_smul, Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg hc _)])
      (fun j => by simp [z, norm_smul, Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg hd _)]) i
  refine ⟨n + m, z, ?_, ?_⟩
  · apply (Real.rpow_le_rpow_iff (scalarPSum_nonneg ..) zero_le_one hp0).mp
    rw [hnorm, scalarPSum_weighted_append p hp _ _ hc hd, Real.one_rpow]
    have hx' := Real.rpow_le_rpow (scalarPSum_nonneg p (fun i => ‖x i‖)) hx hp0.le
    have hy' := Real.rpow_le_rpow (scalarPSum_nonneg p (fun i => ‖y i‖)) hy hp0.le
    simp only [Real.one_rpow] at hx' hy'
    nlinarith
  · intro φ
    apply (Real.rpow_le_rpow_iff (abs_nonneg _) (scalarPSum_nonneg ..) hp0).mp
    rw [heval, scalarPSum_weighted_append p hp _ _ hc hd]
    change |c * f.1 φ + d * g.1 φ| ^ p.1.toReal ≤ _
    have habs : |c * f.1 φ + d * g.1 φ| ≤ c * |f.1 φ| + d * |g.1 φ| := by
      simpa only [abs_mul, abs_of_nonneg hc, abs_of_nonneg hd] using
        abs_add_le (c * f.1 φ) (d * g.1 φ)
    refine (Real.rpow_le_rpow (abs_nonneg _) habs hp0.le).trans ?_
    have hconv := (convexOn_rpow hp1).2 (abs_nonneg (f.1 φ)) (abs_nonneg (g.1 φ)) hc hd hcd
    simp only [smul_eq_mul] at hconv
    exact hconv.trans (add_le_add
      (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (abs_nonneg _) (hf φ) hp0.le) hc)
      (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (abs_nonneg _) (hg φ) hp0.le) hd))

theorem majorantUnit_absorbent (p : Exponent) (hp : p.IsFinite) :
    Absorbent ℝ (majorantUnit (E := E) p hp) := by
  rw [absorbent_iff_eventually_nhdsNE_zero]
  intro f
  obtain ⟨n, x, hx⟩ := f.2
  have hlim : Tendsto (fun c : ℝ => |c| * scalarPSum p (fun i => ‖x i‖))
      (𝓝[≠] 0) (𝓝 0) := by
    simpa only [abs_zero, zero_mul] using
      ((continuous_abs.mul_const (scalarPSum p (fun i => ‖x i‖))).tendsto 0).mono_left
        nhdsWithin_le_nhds
  filter_upwards [hlim.eventually (gt_mem_nhds zero_lt_one)] with c hc
  refine ⟨n, fun i => c • x i, ?_, ?_⟩
  · simpa only [norm_smul, Real.norm_eq_abs, scalarPSum_smul, abs_abs] using hc.le
  · intro φ
    change |c * f.1 φ| ≤ _
    simp only [map_smul, smul_eq_mul, scalarPSum_smul, abs_mul]
    exact mul_le_mul_of_nonneg_left (hx φ) (abs_nonneg c)

/-- The Minkowski gauge of the unit-cost majorants. -/
def majorantSeminorm (p : Exponent) (hp : p.IsFinite) :
    Seminorm ℝ (majorantIdeal (E := E) p hp).toVectorSublattice :=
  gaugeSeminorm (majorantUnit_balanced p hp) (majorantUnit_convex p hp)
    (majorantUnit_absorbent p hp)

private theorem majorant_eval_bound (p : Exponent) {n : ℕ} (x : Fin n → E) (φ : Dual E) :
    scalarPSum p (fun i => φ (x i)) ≤ ‖φ‖ * scalarPSum p (fun i => ‖x i‖) := by
  calc
    _ ≤ scalarPSum p (fun i => ‖φ‖ * ‖x i‖) := scalarPSum_mono_abs p _ _ (fun i => by
      simpa only [Real.norm_eq_abs,
        abs_of_nonneg (mul_nonneg (norm_nonneg _) (norm_nonneg _))] using
        φ.le_opNorm (x i))
    _ = _ := by rw [scalarPSum_smul, abs_of_nonneg (norm_nonneg _)]

private theorem majorantUnit_eval_le (p : Exponent) (hp : p.IsFinite)
    {f : (majorantIdeal (E := E) p hp).toVectorSublattice}
    (hf : f ∈ majorantUnit p hp) (φ : Dual E) : |f.1 φ| ≤ ‖φ‖ := by
  obtain ⟨n, x, hx, hf⟩ := hf
  exact (hf φ).trans ((majorant_eval_bound p x φ).trans
    (mul_le_of_le_one_right (norm_nonneg _) hx))

theorem majorantSeminorm_eq_zero (p : Exponent) (hp : p.IsFinite)
    (f : (majorantIdeal (E := E) p hp).toVectorSublattice)
    (hf : majorantSeminorm p hp f = 0) : f = 0 := by
  apply Subtype.ext
  funext φ
  change f.1 φ = 0
  apply abs_eq_zero.mp
  apply le_antisymm ?_ (abs_nonneg _)
  apply le_of_forall_pos_le_add
  intro ε hε
  have hg : gauge (majorantUnit p hp) f < ε / (‖φ‖ + 1) := by
    change majorantSeminorm p hp f < _
    rw [hf]
    exact div_pos hε (by positivity)
  obtain ⟨r, hr, hrt, g, hg, hfg⟩ :=
    exists_lt_of_gauge_lt (majorantUnit_absorbent (E := E) p hp) hg
  have hval : f.1 φ = r * g.1 φ :=
    congrArg (fun k : (majorantIdeal (E := E) p hp).toVectorSublattice => k.1 φ) hfg.symm
  rw [hval, abs_mul, abs_of_pos hr]
  have hbound := majorantUnit_eval_le p hp hg φ
  have hrt' : r * (‖φ‖ + 1) < ε := (lt_div_iff₀ (by positivity)).mp hrt
  nlinarith only [hbound, hrt', hr]

theorem majorantSeminorm_le (p : Exponent) (hp : p.IsFinite)
    (f : (majorantIdeal (E := E) p hp).toVectorSublattice) {n : ℕ} (x : Fin n → E)
    (hx : ∀ φ, |f.1 φ| ≤ scalarPSum p (fun i => φ (x i))) :
    majorantSeminorm p hp f ≤ scalarPSum p (fun i => ‖x i‖) := by
  apply le_of_forall_pos_le_add
  intro ε hε
  let r := scalarPSum p (fun i => ‖x i‖) + ε
  have hr : 0 < r := add_pos_of_nonneg_of_pos (scalarPSum_nonneg ..) hε
  change gauge (majorantUnit p hp) f ≤ r
  apply gauge_le_of_mem hr.le
  refine ⟨r⁻¹ • f, ?_, smul_inv_smul₀ hr.ne' f⟩
  refine ⟨n, fun i => r⁻¹ • x i, ?_, ?_⟩
  · simp only [norm_smul, Real.norm_eq_abs, scalarPSum_smul,
      abs_of_pos (inv_pos.mpr hr)]
    exact (inv_mul_le_one₀ hr).mpr (le_add_of_nonneg_right hε.le)
  · intro φ
    change |r⁻¹ * f.1 φ| ≤ _
    simp only [map_smul, smul_eq_mul, scalarPSum_smul, abs_mul]
    exact mul_le_mul_of_nonneg_left (hx φ) (abs_nonneg _)

private theorem majorantCost_bddBelow (p : Exponent) (f : Dual E → ℝ) :
    BddBelow {r : ℝ | ∃ (m : ℕ) (x : Fin m → E),
      r = scalarPSum p (fun i => ‖x i‖) ∧
      ∀ φ, |f φ| ≤ scalarPSum p (fun i => φ (x i))} := by
  refine ⟨0, ?_⟩
  rintro _ ⟨m, x, rfl, _⟩
  exact scalarPSum_nonneg ..

private theorem majorantSeminorm_eq_cost (p : Exponent) (hp : p.IsFinite)
    (f : (majorantIdeal (E := E) p hp).toVectorSublattice) :
    majorantSeminorm p hp f = majorantCost p f.1 := by
  apply le_antisymm
  · apply le_csInf
    · obtain ⟨n, x, hx⟩ := f.2
      exact ⟨_, n, x, rfl, hx⟩
    · rintro _ ⟨n, x, rfl, hx⟩
      exact majorantSeminorm_le p hp f x hx
  · apply le_of_forall_gt
    intro r hr
    obtain ⟨t, ht, htr, g, ⟨n, x, hx, hg⟩, hfg⟩ :=
      exists_lt_of_gauge_lt (majorantUnit_absorbent (E := E) p hp) hr
    have hcost : majorantCost p f.1 ≤ scalarPSum p (fun i => ‖t • x i‖) := by
      apply csInf_le (majorantCost_bddBelow p f.1)
      refine ⟨n, fun i => t • x i, rfl, ?_⟩
      intro φ
      rw [← hfg]
      change |t * g.1 φ| ≤ _
      simp only [map_smul, smul_eq_mul, scalarPSum_smul, abs_mul]
      exact mul_le_mul_of_nonneg_left (hg φ) (abs_nonneg _)
    refine hcost.trans_lt (lt_of_le_of_lt ?_ htr)
    simp only [norm_smul, Real.norm_eq_abs, scalarPSum_smul, abs_of_pos ht]
    exact mul_le_of_le_one_right ht.le hx

theorem majorantSeminorm_solid (p : Exponent) (hp : p.IsFinite)
    (f g : (majorantIdeal (E := E) p hp).toVectorSublattice) (hfg : |f| ≤ |g|) :
    majorantSeminorm p hp f ≤ majorantSeminorm p hp g := by
  rw [majorantSeminorm_eq_cost p hp g]
  apply le_csInf
  · obtain ⟨n, x, hx⟩ := g.2
    exact ⟨_, n, x, rfl, hx⟩
  · rintro _ ⟨n, x, rfl, hx⟩
    exact majorantSeminorm_le p hp f x (fun φ => (hfg φ).trans (hx φ))

/-- The normed vector lattice of functions with finite p-sum majorants. -/
def MajorantSpace (p : Exponent) (hp : p.IsFinite) : Type u :=
  (majorantIdeal (E := E) p hp).toVectorSublattice

instance (p : Exponent) (hp : p.IsFinite) : AddCommGroup (MajorantSpace (E := E) p hp) :=
  inferInstanceAs (AddCommGroup (majorantIdeal (E := E) p hp).toVectorSublattice)
instance (p : Exponent) (hp : p.IsFinite) : Module ℝ (MajorantSpace (E := E) p hp) :=
  inferInstanceAs (Module ℝ (majorantIdeal (E := E) p hp).toVectorSublattice)
instance (p : Exponent) (hp : p.IsFinite) : Lattice (MajorantSpace (E := E) p hp) :=
  inferInstanceAs (Lattice (majorantIdeal (E := E) p hp).toVectorSublattice)
instance (p : Exponent) (hp : p.IsFinite) :
    IsOrderedAddMonoid (MajorantSpace (E := E) p hp) :=
  inferInstanceAs (IsOrderedAddMonoid (majorantIdeal (E := E) p hp).toVectorSublattice)
instance (p : Exponent) (hp : p.IsFinite) : VectorLattice (MajorantSpace (E := E) p hp) :=
  inferInstanceAs (VectorLattice (majorantIdeal (E := E) p hp).toVectorSublattice)
instance (p : Exponent) (hp : p.IsFinite) : Norm (MajorantSpace (E := E) p hp) :=
  ⟨majorantSeminorm p hp⟩

instance (p : Exponent) (hp : p.IsFinite) :
    NormedAddCommGroup (MajorantSpace (E := E) p hp) :=
  NormedAddCommGroup.ofCore (𝕜 := ℝ) {
    norm_nonneg := fun f => apply_nonneg (majorantSeminorm p hp) f
    norm_smul := fun c f => map_smul_eq_mul (majorantSeminorm p hp) c f
    norm_triangle := fun f g => map_add_le_add (majorantSeminorm p hp) f g
    norm_eq_zero_iff := fun f => ⟨majorantSeminorm_eq_zero p hp f, fun hf => by
      subst f
      exact map_zero (majorantSeminorm p hp)⟩ }

instance (p : Exponent) (hp : p.IsFinite) :
    NormedVectorLattice (MajorantSpace (E := E) p hp) where
  toVectorLattice := inferInstance
  solid := majorantSeminorm_solid p hp
  norm_smul := fun c f => map_smul_eq_mul (majorantSeminorm p hp) c f

private theorem posHom_apply_bound {n : ℕ} (H : posHomFunctions n) (a : Fin n → ℝ) :
    |H a| ≤ ‖H‖ * ∑ i, |a i| := by
  have hsum : 0 ≤ ∑ i, |a i| := Finset.sum_nonneg (fun i _ => abs_nonneg _)
  have hnorm : ‖a‖ ≤ ∑ i, |a i| := by
    rw [pi_norm_le_iff_of_nonneg hsum]
    intro i
    exact Finset.single_le_sum (fun j _ => abs_nonneg (a j)) (Finset.mem_univ i)
  by_cases ha : a = 0
  · subst a
    simp [PosHomFunction.map_zero]
  · let b : PosHomFunction.ellInfinityUnitSphere n := ⟨‖a‖⁻¹ • a, by
      rw [PosHomFunction.ellInfinityUnitSphere, Metric.mem_sphere, dist_zero_right]
      simp [norm_smul, norm_ne_zero_iff.mpr ha]⟩
    have heq : ‖a‖ • (b : Fin n → ℝ) = a := by
      change ‖a‖ • (‖a‖⁻¹ • a) = a
      rw [smul_inv_smul₀ (norm_ne_zero_iff.mpr ha)]
    have hH := PosHomFunction.map_smul_of_nonneg H ‖a‖ (norm_nonneg _) b
    rw [heq] at hH
    rw [hH, smul_eq_mul, abs_mul, abs_of_nonneg (norm_nonneg _)]
    calc
      _ ≤ ‖a‖ * ‖H‖ := mul_le_mul_of_nonneg_left
        (PosHomFunction.abs_apply_le_norm H b) (norm_nonneg _)
      _ ≤ ‖H‖ * ∑ i, |a i| := by nlinarith [norm_nonneg H]

/-- Evaluate a majorized function as a lattice homomorphism. -/
def majorantEvaluation (p : Exponent) (hp : p.IsFinite) (φ : Dual E) :
    VecLatHom (MajorantSpace (E := E) p hp) ℝ where
  toFun f := f.1 φ
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  map_sup' := by intros; rfl
  map_inf' := by intros; rfl

/-- The pointwise homogeneous functional calculus on the majorant space. -/
def majorantCalculus (p : Exponent) (hp : p.IsFinite) {n : ℕ}
    (f : Fin n → MajorantSpace (E := E) p hp) :
    VecLatHom (posHomFunctions n) (MajorantSpace (E := E) p hp) where
  toFun H := ⟨fun φ => H (fun i => (f i).1 φ), by
    let G : MajorantSpace (E := E) p hp := ‖H‖ • ∑ i, |f i|
    apply (majorantIdeal p hp).mem_of_abs_le_abs G.2
    intro φ
    have hbound := posHom_apply_bound H (fun i => (f i).1 φ)
    change |H (fun i => (f i).1 φ)| ≤ |majorantEvaluation p hp φ G|
    simp only [G, map_smul, map_sum, VecLatHom.map_abs, smul_eq_mul]
    change |H (fun i => (f i).1 φ)| ≤ |‖H‖ * (∑ i, |(f i).1 φ|)|
    rw [abs_of_nonneg (mul_nonneg (norm_nonneg _)
      (Finset.sum_nonneg (fun i _ => abs_nonneg _)))]
    exact hbound⟩
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  map_sup' := by intros; rfl
  map_inf' := by intros; rfl

private theorem majorantSpace_near (p : Exponent) (hp : p.IsFinite)
    (f : MajorantSpace (E := E) p hp) (ε : ℝ) (hε : 0 < ε) :
    ∃ (n : ℕ) (x : Fin n → E), scalarPSum p (fun i => ‖x i‖) < ‖f‖ + ε ∧
      ∀ φ, |f.1 φ| ≤ scalarPSum p (fun i => φ (x i)) := by
  have hne : {r : ℝ | ∃ (n : ℕ) (x : Fin n → E),
      r = scalarPSum p (fun i => ‖x i‖) ∧
      ∀ φ, |f.1 φ| ≤ scalarPSum p (fun i => φ (x i))}.Nonempty := by
    obtain ⟨n, x, hx⟩ := f.2
    exact ⟨_, n, x, rfl, hx⟩
  have hlt : majorantCost p f.1 < ‖f‖ + ε := by
    rw [← majorantSeminorm_eq_cost p hp f]
    exact lt_add_of_pos_right _ hε
  obtain ⟨r, ⟨n, x, rfl, hx⟩, hr⟩ := exists_lt_of_csInf_lt hne hlt
  exact ⟨n, x, hr, hx⟩

private theorem scalarPSum_flatten (p : Exponent) (hp : p.IsFinite) {n : ℕ}
    (m : Fin n → ℕ) (a : ∀ i, Fin (m i) → ℝ) :
    let e := (Fintype.equivFin (Σ i, Fin (m i))).symm
    scalarPSum p (fun j => a (e j).1 (e j).2) = scalarPSum p (fun i => scalarPSum p (a i)) := by
  classical
  dsimp only
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  apply Real.rpow_left_injOn hp0.ne' (scalarPSum_nonneg ..) (scalarPSum_nonneg ..)
  simp only [scalarPSum_rpow p hp, abs_of_nonneg (scalarPSum_nonneg p _)]
  simpa only [Fintype.sum_sigma] using
    (Fintype.equivFin (Σ i, Fin (m i))).symm.sum_comp
      (fun j => |a j.1 j.2| ^ p.1.toReal)

private theorem majorantCalculus_pSum_bound (p : Exponent) (hp : p.IsFinite) {n : ℕ}
    (f : Fin n → MajorantSpace (E := E) p hp) :
    ‖majorantCalculus p hp f (pSumFunction p n)‖ ≤ scalarPSum p (fun i => ‖f i‖) := by
  classical
  apply le_of_forall_pos_le_add
  intro ε hε
  let δ := ε / (n + 1)
  have hδ : 0 < δ := div_pos hε (by positivity)
  choose m x hx hbound using fun i => majorantSpace_near p hp (f i) δ hδ
  let e := (Fintype.equivFin (Σ i, Fin (m i))).symm
  let z : Fin (Fintype.card (Σ i, Fin (m i))) → E := fun j => x (e j).1 (e j).2
  have hdom (φ : Dual E) :
      |(majorantCalculus p hp f (pSumFunction p n)).1 φ| ≤ scalarPSum p (fun j => φ (z j)) := by
    change |scalarPSum p (fun i => (f i).1 φ)| ≤ _
    rw [abs_of_nonneg (scalarPSum_nonneg ..)]
    have heq := scalarPSum_flatten p hp m (fun i j => φ (x i j))
    change scalarPSum p (fun j => φ (z j)) = _ at heq
    rw [heq]
    apply scalarPSum_mono_abs
    intro i
    simpa only [abs_of_nonneg (scalarPSum_nonneg ..)] using hbound i φ
  have hnorm := majorantSeminorm_le p hp
    (majorantCalculus p hp f (pSumFunction p n)) z hdom
  have heq := scalarPSum_flatten p hp m (fun i j => ‖x i j‖)
  change scalarPSum p (fun j => ‖z j‖) = _ at heq
  rw [heq] at hnorm
  refine hnorm.trans ?_
  calc
    _ ≤ scalarPSum p (fun i => ‖f i‖ + δ) := by
      apply scalarPSum_mono_abs
      intro i
      rw [abs_of_nonneg (scalarPSum_nonneg ..), abs_of_nonneg (by positivity)]
      exact (hx i).le
    _ ≤ scalarPSum p (fun i => ‖f i‖) + scalarPSum p (fun _ : Fin n => δ) :=
      scalarPSum_add_le p _ _
    _ ≤ scalarPSum p (fun i => ‖f i‖) + ε := by
      have hle := scalarPSum_mono_exponent (show Exponent.one ≤ p from p.2) (fun _ : Fin n => δ)
      have hid : (n : ℝ) * δ ≤ ε := by
        have : ((n : ℝ) + 1) * δ = ε := by dsimp [δ]; field_simp
        nlinarith
      have hsum : scalarPSum Exponent.one (fun _ : Fin n => δ) = n * δ := by
        simp [scalarPSum, Exponent.one, abs_of_pos hδ]
      rw [hsum] at hle
      linarith

/-- Substitute selected coordinates into a positively homogeneous function. -/
def posHomReindex {n m : ℕ} (r : Fin n → Fin m) :
    VecLatHom (posHomFunctions n) (posHomFunctions m) where
  toFun H := ⟨⟨fun a => H (fun i => a (r i)),
    H.1.continuous.comp (continuous_pi (fun i => continuous_apply (r i)))⟩, by
      intro c hc a
      exact PosHomFunction.map_smul_of_nonneg H c hc (fun i => a (r i))⟩
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  map_sup' := by intros; rfl
  map_inf' := by intros; rfl

private theorem posHomCalculus_reindex {X : Type u} [NormedAddCommGroup X] [Lattice X]
    [IsOrderedAddMonoid X] [BanachLattice X] {n m : ℕ}
    (r : Fin n → Fin m) (x : Fin m → X) (H : posHomFunctions n) :
    letI := isUniformlyCompleteVectorLattice_of_banachLattice X
    PosHomFunction.functionalCalculus x (posHomReindex r H) =
      PosHomFunction.functionalCalculus (fun i => x (r i)) H := by
  let := isUniformlyCompleteVectorLattice_of_banachLattice X
  have heq := PosHomFunction.eq_functionalCalculus_of_map_coordinate (fun i => x (r i))
    ((PosHomFunction.functionalCalculus x).comp (posHomReindex r)) (by
      intro i
      change PosHomFunction.functionalCalculus x (PosHomFunction.coordinate (r i)) = _
      exact PosHomFunction.functionalCalculus_coordinate x (r i))
  exact DFunLike.congr_fun heq H

private theorem latticePSum_abs_sub_le {X : Type u} [NormedAddCommGroup X] [Lattice X]
    [IsOrderedAddMonoid X] [BanachLattice X] (p : Exponent) {n : ℕ} (x y : Fin n → X) :
    |latticePSum p x - latticePSum p y| ≤ ∑ i, |x i - y i| := by
  let := isUniformlyCompleteVectorLattice_of_banachLattice X
  let L : posHomFunctions (n + n) := posHomReindex (Fin.castAdd n) (pSumFunction p n)
  let R : posHomFunctions (n + n) := posHomReindex (Fin.natAdd n) (pSumFunction p n)
  let D : Fin n → posHomFunctions (n + n) := fun i =>
    PosHomFunction.coordinate (Fin.castAdd n i) - PosHomFunction.coordinate (Fin.natAdd n i)
  have hscalar : |L - R| ≤ ∑ i, |D i| := by
    intro a
    change |scalarPSum p (fun i => a (Fin.castAdd n i)) -
      scalarPSum p (fun i => a (Fin.natAdd n i))| ≤ _
    have hnorm := abs_norm_sub_norm_le
      (WithLp.toLp p.1 (fun i => a (Fin.castAdd n i)))
      (WithLp.toLp p.1 (fun i => a (Fin.natAdd n i)))
    have hle := scalarPSum_mono_exponent (show Exponent.one ≤ p from p.2)
      (fun i => a (Fin.castAdd n i) - a (Fin.natAdd n i))
    rw [scalarPSum_eq_piLp_norm] at hle
    rw [scalarPSum_eq_piLp_norm, scalarPSum_eq_piLp_norm]
    refine hnorm.trans (hle.trans_eq ?_)
    simp only [AddSubmonoidClass.coe_finsetSum, ContinuousMap.toFun_eq_coe,
      ContinuousMap.coe_sum, Finset.sum_apply]
    change scalarPSum Exponent.one
        (fun i => a (Fin.castAdd n i) - a (Fin.natAdd n i)) =
      ∑ i, |a (Fin.castAdd n i) - a (Fin.natAdd n i)|
    simp [scalarPSum, Exponent.one]
  have htransfer := (PosHomFunction.functionalCalculus (Fin.append x y)).monotone hscalar
  have hL : PosHomFunction.functionalCalculus (Fin.append x y) L = latticePSum p x := by
    rw [posHomCalculus_reindex]
    simp only [Fin.append_left, latticePSum]
  have hR : PosHomFunction.functionalCalculus (Fin.append x y) R = latticePSum p y := by
    rw [posHomCalculus_reindex]
    simp only [Fin.append_right, latticePSum]
  have hD (i : Fin n) : PosHomFunction.functionalCalculus (Fin.append x y) (D i) = x i - y i := by
    simp only [D, map_sub, PosHomFunction.functionalCalculus_coordinate, Fin.append_left,
      Fin.append_right]
  simpa only [VecLatHom.map_abs, map_sub, map_sum, hL, hR, hD] using htransfer

private theorem latticePSum_continuous {X : Type u} [NormedAddCommGroup X] [Lattice X]
    [IsOrderedAddMonoid X] [BanachLattice X] (p : Exponent) (n : ℕ) :
    Continuous (latticePSum p : (Fin n → X) → X) := by
  have hnorm (x y : Fin n → X) : ‖latticePSum p x - latticePSum p y‖ ≤
      ∑ i, ‖x i - y i‖ := by
    calc
      _ ≤ ‖∑ i, |x i - y i|‖ := HasSolidNorm.solid
        ((latticePSum_abs_sub_le p x y).trans (le_abs_self _))
      _ ≤ ∑ i, ‖|x i - y i|‖ := norm_sum_le _ _
      _ = _ := by simp only [norm_abs_eq_norm]
  apply LipschitzWith.continuous (K := (n : ℝ≥0))
  apply lipschitzWith_iff_norm_sub_le.mpr
  intro x y
  refine (hnorm x y).trans ?_
  calc
    _ ≤ ∑ _i : Fin n, ‖x - y‖ := Finset.sum_le_sum (fun i _ => norm_le_pi_norm (x - y) i)
    _ = (n : ℝ≥0) * ‖x - y‖ := by simp

private theorem majorantCompletion_calculus (p : Exponent) (hp : p.IsFinite) {n : ℕ}
    (f : Fin n → MajorantSpace (E := E) p hp) (H : posHomFunctions n) :
    letI := isUniformlyCompleteVectorLattice_of_banachLattice
      (UniformSpace.Completion (MajorantSpace (E := E) p hp))
    (majorantCalculus p hp f H : UniformSpace.Completion (MajorantSpace (E := E) p hp)) =
      PosHomFunction.functionalCalculus
        (fun i => (f i : UniformSpace.Completion (MajorantSpace (E := E) p hp))) H := by
  let := isUniformlyCompleteVectorLattice_of_banachLattice
    (UniformSpace.Completion (MajorantSpace (E := E) p hp))
  have heq := PosHomFunction.eq_functionalCalculus_of_map_coordinate
    (fun i => (f i : UniformSpace.Completion (MajorantSpace (E := E) p hp)))
    (toCompletionVecLatHom.comp (majorantCalculus p hp f)) (by
      intro i
      change ((majorantCalculus p hp f (PosHomFunction.coordinate i)) :
        UniformSpace.Completion (MajorantSpace (E := E) p hp)) = _
      rfl)
  exact DFunLike.congr_fun heq H

private theorem majorantCompletion_pConvex (p : Exponent) (hp : p.IsFinite) :
    ConvexWith p 1 (UniformSpace.Completion (MajorantSpace (E := E) p hp)) := by
  constructor
  · rfl
  · intro n x
    have hd (i : Fin n) : ∃ f : ℕ → MajorantSpace (E := E) p hp,
        Tendsto (fun k => (f k : UniformSpace.Completion (MajorantSpace (E := E) p hp)))
          atTop (𝓝 (x i)) := by
      obtain ⟨z, hz, hlim⟩ := mem_closure_iff_seq_limit.mp
        (UniformSpace.Completion.denseRange_coe (α := MajorantSpace (E := E) p hp) (x i))
      choose f hf using hz
      exact ⟨f, by simpa only [hf] using hlim⟩
    choose f hf using hd
    let z : ℕ → Fin n → UniformSpace.Completion (MajorantSpace (E := E) p hp) :=
      fun k i => (f i k : UniformSpace.Completion (MajorantSpace (E := E) p hp))
    have hz : Tendsto z atTop (𝓝 x) := tendsto_pi_nhds.mpr hf
    have hleft := ((latticePSum_continuous p n).norm.tendsto x).comp hz
    have hnorm : Tendsto (fun k i => ‖z k i‖) atTop (𝓝 (fun i => ‖x i‖)) :=
      tendsto_pi_nhds.mpr (fun i => (hf i).norm)
    have hright := ((pSumFunction p n).1.continuous.tendsto (fun i => ‖x i‖)).comp hnorm
    rw [one_mul]
    refine le_of_tendsto_of_tendsto' hleft hright ?_
    intro k
    have heq := majorantCompletion_calculus p hp (fun i => f i k) (pSumFunction p n)
    change (majorantCalculus p hp (fun i => f i k) (pSumFunction p n) :
      UniformSpace.Completion (MajorantSpace (E := E) p hp)) = latticePSum p (z k) at heq
    change ‖latticePSum p (z k)‖ ≤ scalarPSum p (fun i => ‖z k i‖)
    rw [← heq, UniformSpace.Completion.norm_coe]
    simpa only [z, UniformSpace.Completion.norm_coe] using
      majorantCalculus_pSum_bound p hp (fun i => f i k)

/-- The bounded evaluation map from the generating space into the majorant space. -/
def majorantDelta (p : Exponent) (hp : p.IsFinite) :
    E →L[ℝ] MajorantSpace (E := E) p hp := by
  let L : E →ₗ[ℝ] MajorantSpace (E := E) p hp :=
    { toFun x :=
        (⟨fun φ => φ x, 1, fun _ => x, by intro φ; simp [scalarPSum_fin1]⟩ : MajorantSpace p hp)
      map_add' := by intro x y; apply Subtype.ext; funext φ; exact map_add φ x y
      map_smul' := by intro c x; apply Subtype.ext; funext φ; exact map_smul φ c x }
  refine L.mkContinuous 1 ?_
  intro x
  have h := majorantSeminorm_le p hp (L x)
    (fun _ : Fin 1 => x) (by intro φ; change |φ x| ≤ _; simp [scalarPSum_fin1])
  change majorantSeminorm p hp (L x) ≤ 1 * ‖x‖
  simpa only [scalarPSum_fin1, abs_of_nonneg (norm_nonneg _), one_mul] using h

private theorem majorantDelta_norm_le (p : Exponent) (hp : p.IsFinite) :
    ‖majorantDelta (E := E) p hp‖ ≤ 1 := by
  apply (majorantDelta p hp).opNorm_le_bound zero_le_one
  intro x
  change majorantSeminorm p hp _ ≤ 1 * ‖x‖
  simpa only [scalarPSum_fin1, abs_of_nonneg (norm_nonneg _), one_mul] using
    majorantSeminorm_le p hp (majorantDelta p hp x) (fun _ : Fin 1 => x)
      (by intro φ; change |φ x| ≤ _; simp [scalarPSum_fin1])

/-- Evaluation on a free lattice as a lattice homomorphism. -/
abbrev freeEvaluation (p : Exponent) (φ : Dual E) : VecLatHom (Free p E) ℝ :=
  evalVecLatHom p φ

/-- Evaluation at a vector as a homomorphism of homogeneous-function lattices. -/
abbrev posHomEvaluation {n : ℕ} (a : Fin n → ℝ) : VecLatHom (posHomFunctions n) ℝ :=
  realPosHomEval a

private theorem freeCalculus_apply (p : Exponent) {n : ℕ} (f : Fin n → Free p E)
    (H : posHomFunctions n) (φ : Dual E) :
    letI := isUniformlyCompleteVectorLattice_of_banachLattice (Free p E)
    PosHomFunction.functionalCalculus f H φ = H (fun i => f i φ) := by
  let := isUniformlyCompleteVectorLattice_of_banachLattice (Free p E)
  let := isUniformlyCompleteVectorLattice_of_banachLattice ℝ
  have hleft := PosHomFunction.eq_functionalCalculus_of_map_coordinate
    (fun i => f i φ) ((freeEvaluation p φ).comp (PosHomFunction.functionalCalculus f))
    (by
      intro i
      simp only [VecLatHom.comp_apply, PosHomFunction.functionalCalculus_coordinate]
      rfl)
  have hright := PosHomFunction.eq_functionalCalculus_of_map_coordinate
    (fun i => f i φ) (posHomEvaluation (fun i => f i φ)) (by intro i; rfl)
  exact DFunLike.congr_fun (hleft.trans hright.symm) H

private theorem finite_calculus_membership_proof (p : Exponent) (hp : p.IsFinite)
    (f : Dual E → ℝ) (hf : IsFiniteCalculusFunction f) :
    InFree p f ∧ freeNormExt p f = ENNReal.ofReal (majorantCost p f) := by
  obtain ⟨n, x, H, hf⟩ := hf
  let := isUniformlyCompleteVectorLattice_of_banachLattice (Free p E)
  let g := PosHomFunction.functionalCalculus (fun i => delta p (x i)) H
  have hg : ∀ φ, g φ = f φ := fun φ => (freeCalculus_apply p _ H φ).trans (hf φ).symm
  refine ⟨⟨g, hg⟩, ?_⟩
  have hfun : f = (g : Dual E → ℝ) := funext (fun φ => (hg φ).symm)
  rw [hfun, freeNormExt_eq_norm]
  apply congrArg ENNReal.ofReal
  have hu : ‖g‖ ≤ majorantCost p (g : Dual E → ℝ) := by
    apply le_csInf
    · have hG := (majorantCalculus p hp (fun i => majorantDelta p hp (x i)) H).2
      obtain ⟨m, y, hy⟩ := hG
      refine ⟨_, m, y, rfl, ?_⟩
      intro φ
      rw [hg φ, hf φ]
      exact hy φ
    · rintro _ ⟨m, y, rfl, hy⟩
      have hle : |g| ≤ latticePSum p (fun i => delta p (y i)) := by
        apply (free_le_iff p _ _).mpr
        intro φ
        rw [latticePSum_apply]
        exact hy φ
      calc
        ‖g‖ ≤ ‖latticePSum p (fun i => delta p (y i))‖ :=
          HasSolidNorm.solid (hle.trans (le_abs_self _))
        _ ≤ scalarPSum p (fun i => ‖y i‖) := by
          simpa only [one_mul, LinearIsometry.norm_map] using
            (free_pConvex p (E := E)).2 m (fun i => delta p (y i))
  apply le_antisymm hu
  let X := UniformSpace.Completion (MajorantSpace (E := E) p hp)
  let completion : MajorantSpace (E := E) p hp →ₗᵢ[ℝ] X := UniformSpace.Completion.toComplₗᵢ
  let S : E →L[ℝ] X := completion.toContinuousLinearMap.comp (majorantDelta p hp)
  have hS : ‖S‖ ≤ 1 := by
    apply S.opNorm_le_bound zero_le_one
    intro y
    change ‖(majorantDelta p hp y : X)‖ ≤ 1 * ‖y‖
    rw [UniformSpace.Completion.norm_coe]
    exact ((majorantDelta p hp).le_opNorm y).trans
      (mul_le_mul_of_nonneg_right (majorantDelta_norm_le p hp) (norm_nonneg _))
  obtain ⟨T, hT, hnT, _⟩ := universal_property_of_fvl_bound p S 1 zero_le_one (by
    intro v
    have h := fvl_lift_pConvex_norm_le p (majorantCompletion_pConvex p hp) S v
    exact h.trans (mul_le_mul_of_nonneg_right (by simpa only [one_mul] using hS) (norm_nonneg _)))
  let G := majorantCalculus p hp (fun i => majorantDelta p hp (x i)) H
  have hG : majorantCost p (g : Dual E → ℝ) = ‖G‖ := by
    change _ = majorantSeminorm p hp G
    erw [majorantSeminorm_eq_cost]
    congr 1
    exact funext (fun φ => (hg φ).trans (hf φ))
  have hTG : T g = (G : X) := by
    let := isUniformlyCompleteVectorLattice_of_banachLattice X
    have heq := PosHomFunction.eq_functionalCalculus_of_map_coordinate
      (fun i => S (x i))
      (T.toVecLatHom.comp (PosHomFunction.functionalCalculus (fun i => delta p (x i))))
      (by
        intro i
        rw [VecLatHom.comp_apply, PosHomFunction.functionalCalculus_coordinate]
        exact hT (x i))
    rw [show T g = PosHomFunction.functionalCalculus (fun i => S (x i)) H from
      DFunLike.congr_fun heq H]
    exact (majorantCompletion_calculus p hp _ H).symm
  rw [hG, ← UniformSpace.Completion.norm_coe, ← hTG]
  exact (T.toContinuousLinearMap.le_opNorm g).trans
    (by simpa only [one_mul] using mul_le_mul_of_nonneg_right hnT (norm_nonneg g))

private theorem fvl_finite_calculus (p : Exponent) (v : FVL E) :
    IsFiniteCalculusFunction (fvlFunction v) := by
  obtain ⟨n, x, e, he⟩ := FVLv.exists_eval_of_eq v
  refine ⟨n, x, LLexpr.eval PosHomFunction.coordinate e, ?_⟩
  intro φ
  change freeEvaluation p φ (ofFVL p v) =
    posHomEvaluation (fun i => φ (x i)) (LLexpr.eval PosHomFunction.coordinate e)
  rw [← he, LLexpr.map_eval, LLexpr.map_eval, LLexpr.map_eval]
  congr 1
  funext i
  change ofFVL p (FVLv.of (x i)) φ = φ (x i)
  rw [ofFVL_of]
  rfl

private theorem majorant_norm_proof (p : Exponent) (hp : p.IsFinite) (v : FVL E) :
    ‖ofFVL p v‖ = majorantCost p (fvlFunction v) := by
  have h := (finite_calculus_membership_proof p hp (fvlFunction v) (fvl_finite_calculus p v)).2
  change freeNormExt p (ofFVL p v) = _ at h
  rw [freeNormExt_eq_norm] at h
  have hc : 0 ≤ majorantCost p (fvlFunction v) := by
    apply Real.sInf_nonneg
    rintro _ ⟨m, x, rfl, _⟩
    exact scalarPSum_nonneg ..
  have hreal := congrArg ENNReal.toReal h
  simpa only [ENNReal.toReal_ofReal (norm_nonneg _), ENNReal.toReal_ofReal hc] using hreal


/-- The functional-calculus embedding assertion used by the majorant-norm proof. -/
theorem finite_calculus_membership (p : Exponent) (hp : p.IsFinite)
    (f : Dual E → ℝ) (hf : IsFiniteCalculusFunction f) :
    InFree p f ∧ freeNormExt p f = ENNReal.ofReal (majorantCost p f) :=
  finite_calculus_membership_proof p hp f hf

/-- Lemma 4.2, equation (4.1): the free p-norm of an algebraic element is the infimum
of the costs of finite p-sum majorants. A majorant is a finite family of vectors whose
evaluation p-sum dominates the element on the whole dual; its cost is the p-sum of
the vector norms. The exponent p is finite. -/
theorem majorant_norm (p : Exponent) (hp : p.IsFinite) (v : FVL E) :
    ‖ofFVL p v‖ = sInf {r : ℝ | ∃ (m : ℕ) (x : Fin m → E),
      r = scalarPSum p (fun i => ‖x i‖) ∧
      ∀ φ : Dual E, |fvlFunction v φ| ≤ scalarPSum p (fun i => φ (x i))} :=
  majorant_norm_proof p hp v

/-- Conjugate exponent, including p'=infinity when p=1. -/
def conjugate (p : Exponent) : Exponent := ⟨(1 - p.1⁻¹)⁻¹, ENNReal.one_le_inv.mpr tsub_le_self⟩

/-- Equation (4.2): the image of the conjugate-exponent unit ball under the series map.
Using `HasSum` records convergence, including for arbitrary input sequences. -/
def diskOfSequence (p : Exponent) (x : ℕ → E) : Set E :=
  {y | ∃ t : lp (fun _ : ℕ => ℝ) (conjugate p).1,
    ‖t‖ ≤ 1 ∧ HasSum (fun n => t n • x n) y}

/-- Section 4.1: summable disks for finite p; nonempty absolutely convex compact sets
at the endpoint p = infinity. -/
def IsPCompactDisk (p : Exponent) (K : Set E) : Prop :=
  (p.IsFinite ∧ ∃ x : ℕ → E,
    Summable (fun n => ‖x n‖ ^ p.1.toReal) ∧ K = diskOfSequence p x) ∨
  (p = Exponent.infinity ∧ K.Nonempty ∧ AbsConvex ℝ K ∧ IsCompact K)

/-- For finite exponents, the revised definition retains the summable-sequence model. -/
theorem isPCompactDisk_iff_of_finite (p : Exponent) (hp : p.IsFinite) (K : Set E) :
    IsPCompactDisk p K ↔ ∃ x : ℕ → E,
      Summable (fun n => ‖x n‖ ^ p.1.toReal) ∧ K = diskOfSequence p x := by
  constructor
  · rintro (⟨_, h⟩ | ⟨rfl, _⟩)
    · exact h
    · exact (lt_irrefl _ hp).elim
  · exact fun h => Or.inl ⟨hp, h⟩

/-- Infinity-compact disks are precisely nonempty absolutely convex compact sets. -/
theorem isPCompactDisk_infinity_iff (K : Set E) :
    IsPCompactDisk Exponent.infinity K ↔ K.Nonempty ∧ AbsConvex ℝ K ∧ IsCompact K := by
  simp [IsPCompactDisk, Exponent.IsFinite, Exponent.infinity]

/-- Closing the absolutely convex hull of a nonempty compact set preserves its support. -/
theorem compact_support_closedAbsConvexHull [CompleteSpace E] (K : Set E)
    (hne : K.Nonempty) (hK : IsCompact K) :
    IsPCompactDisk Exponent.infinity (closedAbsConvexHull ℝ K) ∧
      ∀ φ, support (closedAbsConvexHull ℝ K) φ = support K φ := by
  have hc : IsCompact (closedAbsConvexHull ℝ K) :=
    isCompact_closedAbsConvexHull_of_totallyBounded hK.totallyBounded
  have hn : (closedAbsConvexHull ℝ K).Nonempty := hne.mono subset_closedAbsConvexHull
  refine ⟨(isPCompactDisk_infinity_iff _).mpr ⟨hn, absConvex_convexClosedHull, hc⟩, ?_⟩
  intro φ
  apply le_antisymm
  · have hsub : K ⊆ φ.toSeminorm.closedBall 0 (support K φ) := by
      intro x hx
      change ‖φ (x - 0)‖ ≤ support K φ
      simpa only [sub_zero, Real.norm_eq_abs] using le_support K hK.isBounded φ hx
    have hclosed : IsClosed (φ.toSeminorm.closedBall 0 (support K φ)) := by
      change IsClosed {x | ‖φ (x - 0)‖ ≤ support K φ}
      simpa only [sub_zero] using isClosed_le φ.continuous.norm continuous_const
    have hbound := closedAbsConvexHull_min hsub
      ⟨φ.toSeminorm.balanced_closedBall_zero _, φ.toSeminorm.convex_closedBall 0 _⟩ hclosed
    apply csSup_le (hn.image _)
    rintro _ ⟨x, hx, rfl⟩
    have hb := hbound hx
    change ‖φ (x - 0)‖ ≤ support K φ at hb
    simpa only [sub_zero, Real.norm_eq_abs] using hb
  · apply csSup_le (hne.image _)
    rintro _ ⟨x, hx, rfl⟩
    exact le_support _ hc.isBounded φ (subset_closedAbsConvexHull hx)

/-- Auxiliary notion: subsets contained in a p-compact disk, for any exponent. -/
def IsRelativelyPCompact (p : Exponent) (A : Set E) : Prop :=
  ∃ K : Set E, IsPCompactDisk p K ∧ A ⊆ K

/-- The scalar series norm used by equation (4.3). -/
def seriesPSum (p : Exponent) (a : ℕ → ℝ) : ℝ :=
  (∑' n, |a n| ^ p.1.toReal) ^ (1 / p.1.toReal)

/-- Section 4.1: summability justifies the disk's series formula. -/
theorem disk_series_summable [CompleteSpace E] (p : Exponent) (hp : p.IsFinite)
    (x : ℕ → E) (hx : Summable (fun n => ‖x n‖ ^ p.1.toReal))
    (t : lp (fun _ : ℕ => ℝ) (conjugate p).1) :
    Summable (fun n => t n • x n) := by
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  by_cases hp1 : p.1 = 1
  · have hx' : Summable (fun n => ‖x n‖) := by simpa [hp1] using hx
    apply Summable.of_norm
    apply Summable.of_nonneg_of_le (fun n => norm_nonneg _) ?_ (hx'.mul_left ‖t‖)
    intro n
    rw [norm_smul]
    exact mul_le_mul_of_nonneg_right
      (lp.norm_apply_le_norm (ne_of_gt (zero_lt_one.trans_le (conjugate p).2)) t n)
      (norm_nonneg _)
  · have hp1' : 1 < p.1.toReal := by
      exact_mod_cast (ENNReal.toReal_lt_toReal ENNReal.one_ne_top (ne_of_lt hp)).mpr
        (lt_of_le_of_ne p.2 (Ne.symm hp1))
    have hconj : p.1.toReal.HolderConjugate (conjugate p).1.toReal :=
      (ENNReal.HolderConjugate.toReal_iff hp1').mpr
        (ENNReal.HolderConjugate.inv_one_sub_inv' p.2)
    let a : lp (fun _ : ℕ => ℝ) p.1 :=
      ⟨fun n => ‖x n‖, (memℓp_gen_iff hp0).mpr (by simpa using hx)⟩
    apply Summable.of_norm
    convert (lp.summable_mul hconj a t) using 1
    ext n
    simp [a, norm_smul, mul_comm]

private theorem conjugate_holder (p : Exponent) (hp : p.IsFinite) (hp1 : p.1 ≠ 1) :
    p.1.toReal.HolderConjugate (conjugate p).1.toReal := by
  apply ENNReal.HolderConjugate.toReal_iff _ |>.mpr
    (ENNReal.HolderConjugate.inv_one_sub_inv' p.2)
  exact_mod_cast (ENNReal.toReal_lt_toReal ENNReal.one_ne_top (ne_of_lt hp)).mpr
    (lt_of_le_of_ne p.2 hp1.symm)

private theorem conjugate_mul_bound (p : Exponent) (hp : p.IsFinite)
    (a : lp (fun _ : ℕ => ℝ) p.1) (t : lp (fun _ : ℕ => ℝ) (conjugate p).1) :
    Summable (fun n => ‖t n‖ * ‖a n‖) ∧
      ∑' n, ‖t n‖ * ‖a n‖ ≤ ‖t‖ * ‖a‖ := by
  by_cases hp1 : p.1 = 1
  · have ha : Summable (fun n => ‖a n‖) := by
      simpa [hp1] using (lp.memℓp a).summable (by simp [hp1])
    have hpoint (n : ℕ) : ‖t n‖ * ‖a n‖ ≤ ‖t‖ * ‖a n‖ :=
      mul_le_mul_of_nonneg_right
        (lp.norm_apply_le_norm (ne_of_gt (zero_lt_one.trans_le (conjugate p).2)) t n)
        (norm_nonneg _)
    refine ⟨Summable.of_nonneg_of_le (fun n => by positivity) hpoint (ha.mul_left ‖t‖), ?_⟩
    calc
      _ ≤ ∑' n, ‖t‖ * ‖a n‖ :=
        Summable.tsum_le_tsum hpoint
          (Summable.of_nonneg_of_le (fun n => by positivity) hpoint (ha.mul_left ‖t‖))
          (ha.mul_left ‖t‖)
      _ = ‖t‖ * ‖a‖ := by
        rw [tsum_mul_left, lp.norm_eq_tsum_rpow (by simp [hp1]) a]
        simp [hp1]
  · exact lp.tsum_mul_le_mul_norm (conjugate_holder p hp hp1).symm t a

/-- The unit ball of the conjugate sequence space, on the common sequence carrier. -/
def coefficientBall (q : Exponent) : Set (ℕ → ℝ) :=
  {t | ∃ a : lp (fun _ : ℕ => ℝ) q.1, ‖a‖ ≤ 1 ∧ ⇑a = t}

private theorem coefficientBall_finite (q : Exponent) (hq : q.IsFinite) :
    coefficientBall q = {t | ∀ s : Finset ℕ, ∑ i ∈ s, ‖t i‖ ^ q.1.toReal ≤ 1} := by
  have hq0 : 0 < q.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le q.2)) (ne_of_lt hq)
  ext t
  constructor
  · rintro ⟨a, ha, rfl⟩ s
    exact (lp.sum_rpow_le_norm_rpow hq0 a s).trans
      (by simpa using Real.rpow_le_rpow (norm_nonneg a) ha hq0.le)
  · intro ht
    have hs : Summable (fun i => ‖t i‖ ^ q.1.toReal) :=
      summable_of_sum_le (fun i => Real.rpow_nonneg (norm_nonneg _) _) ht
    refine ⟨⟨t, (memℓp_gen_iff hq0).mpr hs⟩, ?_, rfl⟩
    exact lp.norm_le_of_forall_sum_le hq0 zero_le_one (by simpa using ht)

private theorem coefficientBall_infinity :
    coefficientBall Exponent.infinity = {t | ∀ i, ‖t i‖ ≤ 1} := by
  ext t
  constructor
  · rintro ⟨a, ha, rfl⟩ i
    exact (lp.norm_apply_le_norm (by simp [Exponent.infinity]) a i).trans ha
  · intro ht
    refine ⟨⟨t, memℓp_infty_iff.mpr ⟨1, ?_⟩⟩, ?_, rfl⟩
    · rintro _ ⟨i, rfl⟩
      exact ht i
    · exact lp.norm_le_of_forall_le zero_le_one ht

private theorem coefficientBall_compact (q : Exponent) : IsCompact (coefficientBall q) := by
  have hclosed : IsClosed (coefficientBall q) := by
    by_cases hq : q.1 = ⊤
    · have hq' : q = Exponent.infinity := Subtype.ext hq
      rw [hq', coefficientBall_infinity]
      simp_rw [ofPred_forall]
      exact isClosed_iInter fun i => isClosed_le (continuous_apply i).norm continuous_const
    · rw [coefficientBall_finite q (lt_top_iff_ne_top.mpr hq)]
      simp_rw [ofPred_forall]
      apply isClosed_iInter
      intro s
      exact isClosed_le (continuous_finsetSum _ (fun i _ =>
        (continuous_apply i).norm.rpow_const (fun _ => Or.inr ENNReal.toReal_nonneg)))
        continuous_const
  apply (isCompact_pi_infinite (fun _ : ℕ =>
    isCompact_Icc (a := (-1 : ℝ)) (b := 1))).of_isClosed_subset hclosed
  rintro t ⟨a, ha, rfl⟩ i
  exact abs_le.mp ((lp.norm_apply_le_norm (ne_of_gt (zero_lt_one.trans_le q.2)) a i).trans ha)

section DiskSeries
variable [CompleteSpace E]

private theorem coefficient_series_bound (p : Exponent) (hp : p.IsFinite)
    (x : lp (fun _ : ℕ => E) p.1) (t : coefficientBall (conjugate p)) :
    Summable (fun n => t.1 n • x n) ∧ ‖∑' n, t.1 n • x n‖ ≤ ‖x‖ := by
  obtain ⟨a, ha, hta⟩ := t.2
  have h := conjugate_mul_bound p hp (lp.toNorm x) a
  have hs : Summable (fun n => ‖a n • x n‖) := by
    simpa [norm_smul, lp.toNorm] using h.1
  have htn : Summable (fun n => ‖t.1 n • x n‖) := by
    simpa only [hta] using hs
  have htx : Summable (fun n => t.1 n • x n) := by
    simpa only [hta] using hs.of_norm
  refine ⟨htx, ?_⟩
  calc
    ‖∑' n, t.1 n • x n‖ ≤ ∑' n, ‖t.1 n • x n‖ := norm_tsum_le_tsum_norm htn
    _ ≤ ‖a‖ * ‖x‖ := by
      have h' := h.2
      rw [lp.norm_toNorm] at h'
      simpa [norm_smul, lp.toNorm, hta] using h'
    _ ≤ ‖x‖ := mul_le_of_le_one_left (norm_nonneg _) ha

/-- Sum a sequence against a coefficient vector in the conjugate unit ball. -/
def coefficientSeries (p : Exponent) (hp : p.IsFinite)
    (t : coefficientBall (conjugate p)) : lp (fun _ : ℕ => E) p.1 →L[ℝ] E :=
  LinearMap.mkContinuous
    { toFun := fun x => ∑' n, t.1 n • x n
      map_add' := by
        intro x y
        simpa only [lp.coeFn_add, Pi.add_apply, smul_add] using
          ((coefficient_series_bound p hp x t).1.tsum_add
            (coefficient_series_bound p hp y t).1)
      map_smul' := by
        intro c x
        change (∑' n, t.1 n • (c • x n)) = c • ∑' n, t.1 n • x n
        calc
          _ = ∑' n, c • (t.1 n • x n) := tsum_congr (fun n => smul_comm ..)
          _ = _ := (coefficient_series_bound p hp x t).1.tsum_const_smul c }
    1 (fun x => by
      change ‖∑' n, t.1 n • x n‖ ≤ 1 * ‖x‖
      simpa only [one_mul] using (coefficient_series_bound p hp x t).2)

private theorem coefficientSeries_single (p : Exponent) (hp : p.IsFinite)
    (t : coefficientBall (conjugate p)) (i : ℕ) (x : E) :
    coefficientSeries p hp t (lp.single p.1 i x) = t.1 i • x := by
  change (∑' n, t.1 n • (lp.single (E := fun _ : ℕ => E) p.1 i x) n) = _
  have h : (fun n => t.1 n • (lp.single (E := fun _ : ℕ => E) p.1 i x) n) =
      Pi.single i (t.1 i • x) := by
    ext n
    by_cases hni : n = i
    · subst n
      simp
    · simp [Pi.single_eq_of_ne hni]
  rw [h]
  rw [tsum_eq_single i (fun n hn => Pi.single_eq_of_ne hn _), Pi.single_eq_same]

private theorem coefficientSeries_continuous (p : Exponent) (hp : p.IsFinite)
    (x : lp (fun _ : ℕ => E) p.1) :
    Continuous (fun t : coefficientBall (conjugate p) => coefficientSeries p hp t x) := by
  let xN (N : ℕ) : lp (fun _ : ℕ => E) p.1 :=
    ∑ n ∈ Finset.range N, lp.single p.1 n (x n)
  have hlim : Tendsto xN atTop (𝓝 x) :=
    (lp.hasSum_single (ne_of_lt hp) x).tendsto_sum_nat
  have hcont (N : ℕ) : Continuous (fun t : coefficientBall (conjugate p) =>
      coefficientSeries p hp t (xN N)) := by
    simp only [xN, map_sum, coefficientSeries_single]
    exact continuous_finsetSum _ (fun n _ =>
      ((continuous_apply n).comp continuous_subtype_val).smul continuous_const)
  have hu : TendstoUniformly (fun N (t : coefficientBall (conjugate p)) =>
      coefficientSeries p hp t (xN N)) (fun t => coefficientSeries p hp t x) atTop := by
    apply Metric.tendstoUniformly_iff.mpr
    intro ε hε
    have hn : Tendsto (fun N => ‖x - xN N‖) atTop (𝓝 0) := by
      simpa only [sub_self, norm_zero] using (tendsto_const_nhds (x := x) |>.sub hlim).norm
    filter_upwards [hn.eventually_lt_const hε] with N hN t
    rw [dist_eq_norm, ← map_sub]
    exact (coefficient_series_bound p hp (x - xN N) t).2.trans_lt hN
  exact hu.continuous (Frequently.of_forall hcont)

end DiskSeries

/-- Section 4.1: p-compact disks really are nonempty, absolutely convex and compact. -/
theorem summable_disk_compact [CompleteSpace E] (p : Exponent) (K : Set E)
    (hK : IsPCompactDisk p K) : K.Nonempty ∧ AbsConvex ℝ K ∧ IsCompact K := by
  rcases hK with hK | ⟨_, hK⟩
  swap
  · exact hK
  obtain ⟨hp, x, hx, rfl⟩ := hK
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  let a : lp (fun _ : ℕ => E) p.1 := ⟨x, (memℓp_gen_iff hp0).mpr hx⟩
  have heq : diskOfSequence p x =
      range (fun t : coefficientBall (conjugate p) => coefficientSeries p hp t a) := by
    ext y
    constructor
    · rintro ⟨t, ht, hty⟩
      refine ⟨⟨t, t, ht, rfl⟩, ?_⟩
      exact hty.tsum_eq
    · rintro ⟨t, rfl⟩
      obtain ⟨b, hb, hbt⟩ := t.2
      refine ⟨b, hb, ?_⟩
      change HasSum (fun n => b n • a n) (∑' n, t.1 n • a n)
      simpa only [hbt] using (coefficient_series_bound p hp a t).1.hasSum
  refine ⟨?_, ?_, ?_⟩
  · exact ⟨0, 0, by simp, by simp⟩
  · constructor
    · intro c hc y hy
      obtain ⟨z, ⟨t, ht, htz⟩, rfl⟩ := hy
      refine ⟨c • t, ?_, ?_⟩
      · simpa only [norm_smul, mul_one] using
          (mul_le_mul hc ht (norm_nonneg t) zero_le_one)
      · simpa only [lp.coeFn_smul, Pi.smul_apply, smul_smul, smul_eq_mul] using htz.const_smul c
    · intro y hy z hz c d hc hd hcd
      obtain ⟨t, ht, hty⟩ := hy
      obtain ⟨s, hs, hsz⟩ := hz
      refine ⟨c • t + d • s, ?_, ?_⟩
      · refine (norm_add_le _ _).trans ?_
        rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs,
          abs_of_nonneg hc, abs_of_nonneg hd]
        nlinarith
      · simpa only [lp.coeFn_add, lp.coeFn_smul, Pi.add_apply, Pi.smul_apply,
          add_smul, smul_smul, smul_eq_mul] using (hty.const_smul c).add (hsz.const_smul d)
  · rw [heq]
    let : CompactSpace (coefficientBall (conjugate p)) :=
      isCompact_iff_compactSpace.mp (coefficientBall_compact (conjugate p))
    exact isCompact_range (coefficientSeries_continuous p hp a)

private theorem exists_conjugate_norming (p : Exponent) (hp : p.IsFinite)
    (a : lp (fun _ : ℕ => ℝ) p.1) :
    ∃ t : lp (fun _ : ℕ => ℝ) (conjugate p).1,
      ‖t‖ ≤ 1 ∧ ∑' n, t n * a n = ‖a‖ := by
  have hsign (r : ℝ) : ‖(SignType.sign r : ℝ)‖ ≤ 1 := by
    rcases lt_trichotomy r 0 with h | rfl | h <;> simp_all
  by_cases hp1 : p.1 = 1
  · have hq : (conjugate p).1 = ⊤ := by simp [conjugate, hp1]
    let t : lp (fun _ : ℕ => ℝ) (conjugate p).1 :=
      ⟨fun n => (SignType.sign (a n) : ℝ), by
        change Memℓp (fun n => (SignType.sign (a n) : ℝ)) _
        rw [hq, memℓp_infty_iff]
        exact ⟨1, by rintro _ ⟨n, rfl⟩; exact hsign _⟩⟩
    refine ⟨t, ?_, ?_⟩
    · have hbound {q : ℝ≥0∞} (hq : q = ⊤) (t : lp (fun _ : ℕ => ℝ) q)
          (ht : ∀ n, ‖t n‖ ≤ 1) : ‖t‖ ≤ 1 := by
        subst q
        exact lp.norm_le_of_forall_le zero_le_one ht
      exact hbound hq t (fun n => hsign _)
    · change (∑' n, (SignType.sign (a n) : ℝ) * a n) = ‖a‖
      simp only [sign_mul_self]
      rw [lp.norm_eq_tsum_rpow (by simp [hp1]) a]
      simp [hp1]
  · by_cases ha : a = 0
    · subst a
      exact ⟨0, by simp, by simp⟩
    have ha0 : 0 < ‖a‖ := norm_pos_iff.mpr ha
    have hpq := conjugate_holder p hp hp1
    let b : lp (fun _ : ℕ => ℝ) p.1 := ‖a‖⁻¹ • a
    have hb : ‖b‖ = 1 := by
      simp [b, norm_smul, ha0.ne']
    let f (n : ℕ) : ℝ := (SignType.sign (b n) : ℝ) * |b n| ^ (p.1.toReal - 1)
    have hf (n : ℕ) : ‖f n‖ = ‖b n‖ ^ (p.1.toReal - 1) := by
      rcases lt_trichotomy (b n) 0 with hn | hn | hn
      · simp [f, hn, abs_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)]
      · simp [f, hn, Real.zero_rpow (sub_pos.mpr hpq.lt).ne']
      · simp [f, hn, abs_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)]
    have hfp (n : ℕ) : ‖f n‖ ^ (conjugate p).1.toReal = ‖b n‖ ^ p.1.toReal := by
      rw [hf, ← Real.rpow_mul (norm_nonneg _), hpq.sub_one_mul_conj]
    let t : lp (fun _ : ℕ => ℝ) (conjugate p).1 :=
      ⟨f, (memℓp_gen_iff hpq.symm.pos).mpr (by
        simpa only [hfp] using (lp.memℓp b).summable hpq.pos)⟩
    have ht : ‖t‖ = 1 := by
      rw [lp.norm_eq_tsum_rpow hpq.symm.pos]
      change (∑' n, ‖f n‖ ^ (conjugate p).1.toReal) ^ (1 / (conjugate p).1.toReal) = 1
      simp_rw [hfp]
      rw [← lp.norm_rpow_eq_tsum hpq.pos b, hb]
      simp
    refine ⟨t, ht.le, ?_⟩
    have hprod (n : ℕ) : t n * b n = ‖b n‖ ^ p.1.toReal := by
      change ((SignType.sign (b n) : ℝ) * |b n| ^ (p.1.toReal - 1)) * b n = _
      rw [mul_right_comm, sign_mul_self, mul_comm]
      simpa only [sub_add_cancel, Real.norm_eq_abs] using
        (Real.rpow_add_one' (y := p.1.toReal - 1) (abs_nonneg (b n))
          (by simpa only [sub_add_cancel] using hpq.ne_zero)).symm
    have hab (n : ℕ) : a n = ‖a‖ * b n := by
      simp [b, lp.coeFn_smul, smul_eq_mul, ha0.ne']
    calc
      _ = ∑' n, ‖a‖ * (t n * b n) := tsum_congr (fun n => by rw [hab n]; ring)
      _ = ‖a‖ * (∑' n, ‖b n‖ ^ p.1.toReal) := by simp_rw [hprod]; rw [tsum_mul_left]
      _ = ‖a‖ := by rw [← lp.norm_rpow_eq_tsum hpq.pos b, hb]; simp

/-- Apply a continuous dual functional coordinatewise to a p-summable vector sequence. -/
def lpDualImage (p : Exponent) (x : lp (fun _ : ℕ => E) p.1) (φ : Dual E) :
    lp (fun _ : ℕ => ℝ) p.1 :=
  ⟨fun n => φ (x n), ((lp.memℓp x).norm.const_mul ‖φ‖).mono (fun n => φ.le_opNorm (x n))⟩

private theorem lpSupport_freeNorm_le (p : Exponent) (hp : p.IsFinite)
    (x : lp (fun _ : ℕ => E) p.1) :
    freeNormExt p (fun φ => ‖lpDualImage p x φ‖) ≤ ENNReal.ofReal ‖x‖ := by
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  rw [freeNormExt, ite_eq_right (ne_of_lt hp)]
  refine iSup_le fun n => iSup_le fun φ => iSup_le fun hφ => ENNReal.ofReal_le_ofReal ?_
  apply (Real.rpow_le_rpow_iff (scalarPSum_nonneg ..) (norm_nonneg x) hp0).mp
  rw [scalarPSum_rpow p hp]
  simp only [abs_norm, lp.norm_rpow_eq_tsum hp0]
  have hs (i : Fin n) : Summable (fun k => ‖lpDualImage p x (φ i) k‖ ^ p.1.toReal) :=
    (lp.memℓp (lpDualImage p x (φ i))).summable hp0
  rw [← Summable.tsum_finsetSum (fun i _ => hs i)]
  apply Summable.tsum_le_tsum ?_ (summable_sum (fun i _ => hs i)) ((lp.memℓp x).summable hp0)
  intro k
  change (∑ i, |φ i (x k)| ^ p.1.toReal) ≤ ‖x k‖ ^ p.1.toReal
  rw [← scalarPSum_rpow p hp]
  exact Real.rpow_le_rpow (scalarPSum_nonneg ..)
    (normAdmissible_eval_le_norm p φ hφ (x k)) hp0.le

private theorem support_disk_norm [CompleteSpace E] (p : Exponent) (hp : p.IsFinite)
    (x : lp (fun _ : ℕ => E) p.1) (φ : Dual E) :
    support (diskOfSequence p x) φ = ‖lpDualImage p x φ‖ := by
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  have hx := (lp.memℓp x).summable hp0
  have hK := summable_disk_compact p (diskOfSequence p x) (Or.inl ⟨hp, x, hx, rfl⟩)
  apply le_antisymm
  · apply csSup_le (hK.1.image _)
    rintro _ ⟨y, ⟨t, ht, hty⟩, rfl⟩
    have hval : φ y = ∑' n, t n * φ (x n) := by
      simpa only [map_smul, smul_eq_mul] using (φ.hasSum hty).tsum_eq.symm
    have hmul := conjugate_mul_bound p hp (lpDualImage p x φ) t
    change |φ y| ≤ _
    rw [hval, ← Real.norm_eq_abs]
    calc
      _ ≤ ∑' n, ‖t n‖ * ‖φ (x n)‖ := by
        simpa only [norm_mul] using
          norm_tsum_le_tsum_norm (f := fun n => t n * φ (x n))
            (by simpa [norm_mul, lpDualImage] using hmul.1)
      _ ≤ ‖t‖ * ‖lpDualImage p x φ‖ := hmul.2
      _ ≤ ‖lpDualImage p x φ‖ := mul_le_of_le_one_left (norm_nonneg _) ht
  · obtain ⟨t, ht, hta⟩ := exists_conjugate_norming p hp (lpDualImage p x φ)
    have htx := disk_series_summable p hp x hx t
    have hy : (∑' n, t n • x n) ∈ diskOfSequence p x := ⟨t, ht, htx.hasSum⟩
    have hval : φ (∑' n, t n • x n) = ‖lpDualImage p x φ‖ := by
      rw [φ.map_tsum htx]
      simpa only [map_smul, smul_eq_mul, lpDualImage] using hta
    simpa only [hval, abs_of_nonneg (norm_nonneg _)] using
      le_support _ hK.2.2.isBounded φ hy

/-- The homogeneous function given by the p-norm of a sequence’s dual evaluations. -/
def lpSupport (p : Exponent) (hp : p.IsFinite) (x : lp (fun _ : ℕ => E) p.1) :
    HP p E :=
  ⟨fun φ => ‖lpDualImage p x φ‖, by
    constructor
    · intro c hc φ
      have heq : lpDualImage p x (c • φ) = c • lpDualImage p x φ := by
        ext n
        rfl
      change ‖lpDualImage p x (c • φ)‖ = c * ‖lpDualImage p x φ‖
      rw [heq, norm_smul, Real.norm_eq_abs, abs_of_nonneg hc]
    · exact (lpSupport_freeNorm_le p hp x).trans_lt ENNReal.ofReal_lt_top⟩

private theorem lpSupport_norm_le (p : Exponent) (hp : p.IsFinite)
    (x : lp (fun _ : ℕ => E) p.1) : ‖lpSupport p hp x‖ ≤ ‖x‖ :=
  ENNReal.toReal_le_of_le_ofReal (norm_nonneg _) (lpSupport_freeNorm_le p hp x)

private theorem lpSupport_lipschitz (p : Exponent) (hp : p.IsFinite) :
    LipschitzWith 1 (lpSupport (E := E) p hp) := by
  apply lipschitzWith_iff_norm_sub_le.mpr
  intro x y
  simp only [NNReal.coe_one, one_mul]
  apply ENNReal.toReal_le_of_le_ofReal (norm_nonneg _)
  refine (freeNormExt_mono_abs p (f := (lpSupport p hp x - lpSupport p hp y : HP p E))
    (g := fun φ => ‖lpDualImage p (x - y) φ‖) ?_).trans (lpSupport_freeNorm_le p hp (x - y))
  intro φ
  have heq : lpDualImage p (x - y) φ = lpDualImage p x φ - lpDualImage p y φ := by
    ext n
    exact map_sub φ (x n) (y n)
  change |‖lpDualImage p x φ‖ - ‖lpDualImage p y φ‖| ≤ |‖lpDualImage p (x - y) φ‖|
  rw [abs_norm, heq]
  exact abs_norm_sub_norm_le _ _

private theorem lpSupport_finite (p : Exponent) (hp : p.IsFinite) (x : ℕ → E) (N : ℕ) :
    lpSupport p hp (∑ n ∈ Finset.range N, lp.single p.1 n (x n)) =
      (latticePSum p (fun i : Fin N => delta p (x i))).1 := by
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  apply Subtype.ext
  funext φ
  change ‖lpDualImage p (∑ n ∈ Finset.range N, lp.single p.1 n (x n)) φ‖ = _
  rw [latticePSum_apply]
  have heq : lpDualImage p (∑ n ∈ Finset.range N, lp.single p.1 n (x n)) φ =
      ∑ n ∈ Finset.range N, lp.single p.1 n (φ (x n)) := by
    ext k
    change φ ((∑ n ∈ Finset.range N, lp.single p.1 n (x n)) k) = _
    simp only [lp.coeFn_sum, lp.coeFn_single, Finset.sum_apply, Finset.sum_pi_single]
    split_ifs <;> simp
  rw [heq]
  change ‖∑ n ∈ Finset.range N, lp.single p.1 n (φ (x n))‖ =
    scalarPSum p (fun i : Fin N => φ (x i))
  apply Real.rpow_left_injOn hp0.ne' (norm_nonneg _) (scalarPSum_nonneg ..)
  dsimp only
  rw [lp.norm_sum_single hp0, scalarPSum_rpow p hp]
  simpa only [Real.norm_eq_abs] using
    (Fin.sum_univ_eq_sum_range (fun n => |φ (x n)| ^ p.1.toReal) N).symm

/-- Equation (4.3), including the free norm estimate and norm convergence of finite p-sums. -/
theorem summable_support [CompleteSpace E] (p : Exponent) (hp : p.IsFinite)
    (x : ℕ → E) (hx : Summable (fun n => ‖x n‖ ^ p.1.toReal)) :
    ∃ h : Free p E,
      (∀ φ, h φ = support (diskOfSequence p x) φ ∧ h φ = seriesPSum p (fun n => φ (x n))) ∧
      ‖h‖ ≤ seriesPSum p (fun n => ‖x n‖) ∧
      Tendsto (fun N => latticePSum p (fun i : Fin N => delta p (x i))) atTop (𝓝 h) := by
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  let a : lp (fun _ : ℕ => E) p.1 := ⟨x, (memℓp_gen_iff hp0).mpr hx⟩
  have hlim : Tendsto
      (fun N => (latticePSum p (fun i : Fin N => delta p (x i))).1)
      atTop (𝓝 (lpSupport p hp a)) := by
    simp_rw [← lpSupport_finite p hp]
    exact (lpSupport_lipschitz p hp).continuous.tendsto a |>.comp
      ((lp.hasSum_single (ne_of_lt hp) a).tendsto_sum_nat)
  have hmem : lpSupport p hp a ∈ freeSublattice p E :=
    (VectorSublattice.isClosed_topologicalClosure _).mem_of_tendsto hlim
      (Eventually.of_forall fun N => (latticePSum p (fun i : Fin N => delta p (x i))).2)
  let h : Free p E := ⟨lpSupport p hp a, hmem⟩
  refine ⟨h, ?_, ?_, ?_⟩
  · intro φ
    constructor
    · exact (support_disk_norm p hp a φ).symm
    · change ‖lpDualImage p a φ‖ = _
      rw [lp.norm_eq_tsum_rpow hp0]
      rfl
  · change ‖lpSupport p hp a‖ ≤ _
    have hnorm : ‖a‖ = seriesPSum p (fun n => ‖x n‖) := by
      rw [lp.norm_eq_tsum_rpow hp0]
      simp only [seriesPSum, abs_norm]
      rfl
    exact (lpSupport_norm_le p hp a).trans_eq hnorm
  · exact tendsto_subtype_rng.mpr hlim

/-- Section 4.1: continuous linear images of p-compact disks. -/
theorem pCompactDisk_image [CompleteSpace F]
    (p : Exponent) (K : Set F) (hK : IsPCompactDisk p K) (T : F →L[ℝ] E) :
    IsPCompactDisk p (T '' K) := by
  rcases hK with hK | ⟨rfl, hne, hac, hc⟩
  swap
  · apply (isPCompactDisk_infinity_iff _).mpr
    refine ⟨hne.image T, ⟨?_, hac.2.linear_image T.toLinearMap⟩, hc.image T.continuous⟩
    rw [balanced_iff_smul_mem]
    rintro c hc y ⟨x, hx, rfl⟩
    exact ⟨c • x, hac.1.smul_mem hc hx, T.map_smul c x⟩
  obtain ⟨hp, x, hx, rfl⟩ := hK
  apply Or.inl
  refine ⟨hp, fun n => T (x n), ?_, ?_⟩
  · apply Summable.of_nonneg_of_le (fun n => Real.rpow_nonneg (norm_nonneg _) _)
      (fun n => ?_) (hx.mul_left (‖T‖ ^ p.1.toReal))
    simpa only [Real.mul_rpow (norm_nonneg T) (norm_nonneg (x n))] using
      Real.rpow_le_rpow (norm_nonneg _) (T.le_opNorm (x n)) ENNReal.toReal_nonneg
  · ext y
    constructor
    · rintro ⟨z, ⟨t, ht, htz⟩, rfl⟩
      exact ⟨t, ht, by simpa using T.hasSum htz⟩
    · rintro ⟨t, ht, hty⟩
      have htx := disk_series_summable p hp x hx t
      refine ⟨∑' n, t n • x n, ⟨t, ht, htx.hasSum⟩, ?_⟩
      exact (by simpa using T.hasSum htx.hasSum :
        HasSum (fun n => t n • T (x n)) (T (∑' n, t n • x n))).unique hty

/-- Section 4.1: one-dimensional disks and their support functions. -/
private theorem segment_summableDisk [CompleteSpace E] (p : Exponent) (hp : p.IsFinite) (x : E) :
    IsPCompactDisk p {y | ∃ t : ℝ, |t| ≤ 1 ∧ y = t • x} ∧
      ∀ φ, support {y | ∃ t : ℝ, |t| ≤ 1 ∧ y = t • x} φ = |φ x| := by
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  have hq0 : 0 < (conjugate p).1 := zero_lt_one.trans_le (conjugate p).2
  have hsum (t : lp (fun _ : ℕ => ℝ) (conjugate p).1) :
      HasSum (fun n => t n • (Pi.single 0 x : ℕ → E) n) (t 0 • x) := by
    simpa using hasSum_single (f := fun n => t n • (Pi.single 0 x : ℕ → E) n) 0
      (fun n hn => by rw [Pi.single_eq_of_ne hn]; exact smul_zero _)
  have heq : diskOfSequence p (Pi.single 0 x) = {y | ∃ t : ℝ, |t| ≤ 1 ∧ y = t • x} := by
    ext y
    constructor
    · rintro ⟨t, ht, hty⟩
      exact ⟨t 0, (lp.norm_apply_le_norm hq0.ne' t 0).trans ht, hty.unique (hsum t)⟩
    · rintro ⟨c, hc, rfl⟩
      refine ⟨lp.single (conjugate p).1 0 c, ?_, ?_⟩
      · simpa only [lp.norm_single hq0, Real.norm_eq_abs] using hc
      · simpa using hsum (lp.single (conjugate p).1 0 c)
  have hK : IsPCompactDisk p {y | ∃ t : ℝ, |t| ≤ 1 ∧ y = t • x} := by
    refine Or.inl ⟨hp, Pi.single 0 x, ?_, heq.symm⟩
    exact (lp.memℓp (lp.single (E := fun _ : ℕ => E) p.1 0 x)).summable hp0
  refine ⟨hK, ?_⟩
  intro φ
  have hc := summable_disk_compact p _ hK
  apply le_antisymm
  · apply csSup_le (hc.1.image _)
    rintro _ ⟨y, ⟨t, ht, rfl⟩, rfl⟩
    simpa only [map_smul, smul_eq_mul, abs_mul, one_mul] using
      mul_le_mul_of_nonneg_right ht (abs_nonneg (φ x))
  · exact le_support _ hc.2.2.isBounded φ ⟨1, by norm_num, by simp⟩

/-- Every exponent admits line segments as compact disks, with the same support formula. -/
theorem segment_pCompactDisk [CompleteSpace E] (p : Exponent) (x : E) :
    IsPCompactDisk p {y | ∃ t : ℝ, |t| ≤ 1 ∧ y = t • x} ∧
      ∀ φ, support {y | ∃ t : ℝ, |t| ≤ 1 ∧ y = t • x} φ = |φ x| := by
  by_cases hp : p.IsFinite
  · exact segment_summableDisk p hp x
  · have hpinf : p = Exponent.infinity := Subtype.ext (eq_top_iff.mpr (not_lt.mp hp))
    subst p
    have hseg := segment_summableDisk Exponent.one (by simp [Exponent.IsFinite, Exponent.one]) x
    exact ⟨(isPCompactDisk_infinity_iff _).mpr (summable_disk_compact _ _ hseg.1), hseg.2⟩

private theorem support_disk_rpow [CompleteSpace E] (p : Exponent) (hp : p.IsFinite)
    (x : ℕ → E) (hx : Summable (fun n => ‖x n‖ ^ p.1.toReal)) (φ : Dual E) :
    support (diskOfSequence p x) φ ^ p.1.toReal = ∑' n, |φ (x n)| ^ p.1.toReal := by
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  let b : lp (fun _ : ℕ => E) p.1 := ⟨x, (memℓp_gen_iff hp0).mpr hx⟩
  rw [show support (diskOfSequence p x) φ = ‖lpDualImage p b φ‖ from support_disk_norm p hp b φ,
    lp.norm_rpow_eq_tsum hp0]
  rfl

/-- Section 4.1: finite p-sums and positive multiples of support functions remain supports. -/
theorem pCompactDisk_support_combination [CompleteSpace E] (p : Exponent)
    (hp : p.IsFinite) (m : ℕ) (K : Fin m → Set E)
    (hK : ∀ i, IsPCompactDisk p (K i)) (a : Fin m → ℝ) (ha : ∀ i, 0 ≤ a i) :
    ∃ L : Set E, IsPCompactDisk p L ∧
      ∀ φ, support L φ = scalarPSum p (fun i => a i * support (K i) φ) := by
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  cases m with
  | zero =>
    refine ⟨_, (segment_pCompactDisk p (0 : E)).1, ?_⟩
    intro φ
    rw [(segment_pCompactDisk p (0 : E)).2 φ]
    simp [scalarPSum, ne_of_lt hp, Real.zero_rpow (inv_ne_zero hp0.ne')]
  | succ m =>
    choose x hx hKx using fun i => (isPCompactDisk_iff_of_finite p hp (K i)).mp (hK i)
    let e : ℕ ≃ Fin (m + 1) × ℕ := Classical.choice inferInstance
    let z (n : ℕ) : E := a (e n).1 • x (e n).1 (e n).2
    have hrow (i : Fin (m + 1)) : Summable (fun n => ‖a i • x i n‖ ^ p.1.toReal) := by
      simpa only [norm_smul, Real.norm_eq_abs, abs_of_nonneg (ha i),
        Real.mul_rpow (ha i) (norm_nonneg _)] using (hx i).mul_left (a i ^ p.1.toReal)
    have hz : Summable (fun n => ‖z n‖ ^ p.1.toReal) := by
      apply (e.summable_iff (f := fun k => ‖a k.1 • x k.1 k.2‖ ^ p.1.toReal)).mpr
      exact (summable_prod_of_nonneg (fun _ => by positivity)).mpr
        ⟨hrow, (hasSum_fintype _).summable⟩
    refine ⟨diskOfSequence p z, (Or.inl ⟨hp, z, hz, rfl⟩), ?_⟩
    intro φ
    have hcomp := summable_disk_compact p (diskOfSequence p z) (Or.inl ⟨hp, z, hz, rfl⟩)
    apply Real.rpow_left_injOn hp0.ne'
      (apply_nonneg (supportSeminorm _ hcomp.1 hcomp.2.2.isBounded) φ) (scalarPSum_nonneg ..)
    change support (diskOfSequence p z) φ ^ p.1.toReal =
      (scalarPSum p (fun i => a i * support (K i) φ)) ^ p.1.toReal
    rw [support_disk_rpow p hp z hz, scalarPSum_rpow p hp]
    have hs : Summable (fun k : Fin (m + 1) × ℕ => |φ (a k.1 • x k.1 k.2)| ^ p.1.toReal) := by
      apply e.summable_iff.mp
      let b : lp (fun _ : ℕ => E) p.1 := ⟨z, (memℓp_gen_iff hp0).mpr hz⟩
      simpa only [Function.comp_def, lpDualImage, Real.norm_eq_abs] using
        (lp.memℓp (lpDualImage p b φ)).summable hp0
    change (∑' n, |φ (a (e n).1 • x (e n).1 (e n).2)| ^ p.1.toReal) = _
    rw [e.tsum_eq (fun k => |φ (a k.1 • x k.1 k.2)| ^ p.1.toReal), hs.tsum_prod, tsum_fintype]
    apply Finset.sum_congr rfl
    intro i _
    have hci := summable_disk_compact p (K i) (hK i)
    have hpos : 0 ≤ support (K i) φ :=
      apply_nonneg (supportSeminorm _ hci.1 hci.2.2.isBounded) φ
    simp only [map_smul, smul_eq_mul, abs_mul, abs_of_nonneg (ha i), abs_of_nonneg hpos,
      Real.mul_rpow (ha i) (abs_nonneg _), Real.mul_rpow (ha i) hpos, tsum_mul_left]
    rw [hKx i, support_disk_rpow p hp (x i) (hx i)]

private theorem seminorm_generate_eq {V ι : Type*} [AddCommGroup V] [Module ℝ V]
    (q : SeminormFamily ℝ V ι) :
    TopologicalSpace.generateFrom {U | ∃ i x r, 0 < r ∧ U = (q i).ball x r} =
      q.moduleFilterBasis.topology := by
  let t := TopologicalSpace.generateFrom {U | ∃ i x r, 0 < r ∧ U = (q i).ball x r}
  let : TopologicalSpace V := q.moduleFilterBasis.topology
  have hq : WithSeminorms q := ⟨rfl⟩
  let : IsTopologicalAddGroup V := hq.isTopologicalAddGroup
  apply le_antisymm
  · intro U hU
    obtain hballs := (hq.isOpen_iff_mem_balls U).mp hU
    let : TopologicalSpace V := t
    change @IsOpen V t U
    apply @isOpen_iff_forall_mem_open V t U |>.mpr
    intro x hx
    obtain ⟨s, r, hr, hsub⟩ := hballs x hx
    refine ⟨(s.sup q).ball x r, hsub, ?_, (s.sup q).mem_ball_self hr⟩
    rw [Seminorm.ball_finset_sup_eq_iInter q s x hr]
    apply isOpen_biInter_finset
    intro i hi
    exact TopologicalSpace.isOpen_generateFrom_of_mem ⟨i, x, r, hr, rfl⟩
  · apply TopologicalSpace.le_generateFrom_iff_subset_isOpen.mpr
    rintro U ⟨i, x, r, hr, rfl⟩
    exact isOpen_lt
      ((hq.continuous_seminorm i).comp (continuous_id.sub continuous_const)) continuous_const

/-- The topology generated by translated support-seminorm balls. -/
@[reducible] def supportTopology (D : Set (Set E)) : TopologicalSpace (Dual E) :=
  TopologicalSpace.generateFrom {U | ∃ K ∈ D, ∃ (φ : Dual E) (ε : ℝ),
    0 < ε ∧ U = {ψ | support K (ψ - φ) < ε}}

/-- Section 4.1: uniform convergence on p-compact disks. -/
@[reducible] def tauP (p : Exponent) (E : Type u) [NormedAddCommGroup E] [NormedSpace ℝ E] :
    TopologicalSpace (Dual E) := supportTopology {K | IsPCompactDisk p K}

/-- Section 4.1: uniform convergence on norm-compact sets, called bw* in the paper. -/
@[reducible] def boundedWeakStar (E : Type u) [NormedAddCommGroup E] [NormedSpace ℝ E] :
    TopologicalSpace (Dual E) := supportTopology {K | K.Nonempty ∧ IsCompact K}

/-- The weak-star topology on the continuous dual, transported from Mathlib’s `WeakDual`
to the common carrier `Dual E` for comparison with `tauP` and `boundedWeakStar`. -/
@[reducible] def weakStar (E : Type u) [NormedAddCommGroup E] [NormedSpace ℝ E] :
    TopologicalSpace (Dual E) :=
  TopologicalSpace.induced (StrongDual.toWeakDual : Dual E → WeakDual ℝ E) inferInstance

private theorem support_ball_open (D : Set (Set E)) (K : Set E) (hK : K ∈ D)
    (φ : Dual E) (r : ℝ) (hr : 0 < r) :
    @IsOpen (Dual E) (supportTopology D) {ψ | support K (ψ - φ) < r} :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨K, hK, φ, r, hr, rfl⟩

/-- Section 4.1: topology containment; Lean orders topologies by reverse inclusion of opens. -/
theorem topology_comparisons [CompleteSpace E] (p : Exponent) :
    boundedWeakStar E ≤ tauP p E ∧ tauP p E ≤ weakStar E := by
  constructor
  · apply TopologicalSpace.generateFrom_anti
    rintro U ⟨K, hK, φ, r, hr, rfl⟩
    have hc := summable_disk_compact p K hK
    exact ⟨K, ⟨hc.1, hc.2.2⟩, φ, r, hr, rfl⟩
  · change tauP p E ≤ TopologicalSpace.induced StrongDual.toWeakDual _
    rw [← continuous_iff_le_induced]
    let : TopologicalSpace (Dual E) := tauP p E
    apply WeakDual.continuous_of_continuous_eval
    intro x
    change Continuous (fun φ : Dual E => φ x)
    rw [continuous_iff_continuousAt]
    intro φ₀
    rw [ContinuousAt, Metric.tendsto_nhds]
    intro ε hε
    have hseg := segment_pCompactDisk p x
    have hopen := support_ball_open {K | IsPCompactDisk p K} _ hseg.1 φ₀ ε hε
    have hmem := hopen.mem_nhds (show support {y | ∃ t : ℝ, |t| ≤ 1 ∧ y = t • x}
        (φ₀ - φ₀) < ε by simpa only [sub_self, support_zero] using hε)
    filter_upwards [hmem] with φ hφ
    simpa only [mem_ofPred_eq, hseg.2, sub_apply, Real.dist_eq] using hφ

/-- At the endpoint, the disk topology is uniform convergence on norm-compact sets. -/
theorem tauP_infinity_eq_boundedWeakStar [CompleteSpace E] :
    tauP Exponent.infinity E = boundedWeakStar E := by
  apply le_antisymm
  · apply TopologicalSpace.generateFrom_anti
    rintro U ⟨K, ⟨hne, hK⟩, φ, r, hr, rfl⟩
    have hhull := compact_support_closedAbsConvexHull K hne hK
    refine ⟨closedAbsConvexHull ℝ K, hhull.1, φ, r, hr, ?_⟩
    simp only [hhull.2]
  · exact (topology_comparisons (E := E) Exponent.infinity).1

/-- Section 4.1: the support topology is a locally convex vector-space topology. -/
theorem tauP_locallyConvex [CompleteSpace E] (p : Exponent) :
    letI := tauP p E
    IsTopologicalAddGroup (Dual E) ∧ ContinuousSMul ℝ (Dual E) ∧
      LocallyConvexSpace ℝ (Dual E) := by
  let q : SeminormFamily ℝ (Dual E) {K : Set E // IsPCompactDisk p K} :=
    fun K => supportSeminorm K.1 (summable_disk_compact p K.1 K.2).1
      (summable_disk_compact p K.1 K.2).2.2.isBounded
  have heq : tauP p E = q.moduleFilterBasis.topology := by
    rw [← seminorm_generate_eq q]
    unfold tauP supportTopology
    congr 1
    ext U
    constructor
    · rintro ⟨K, hK, φ, r, hr, rfl⟩
      exact ⟨⟨K, hK⟩, φ, r, hr, rfl⟩
    · rintro ⟨K, φ, r, hr, rfl⟩
      exact ⟨K.1, K.2, φ, r, hr, rfl⟩
  let : TopologicalSpace (Dual E) := tauP p E
  have hq : WithSeminorms q := ⟨heq⟩
  exact ⟨hq.isTopologicalAddGroup, hq.continuousSMul, hq.toLocallyConvexSpace⟩

private theorem disk_dominates_finite_families [CompleteSpace E]
    (p : Exponent) (hp : p.IsFinite) (m : ℕ → ℕ) (x : ∀ n, Fin (m n) → E)
    (hx : Summable (fun n => (scalarPSum p (fun i => ‖x n i‖)) ^ p.1.toReal)) :
    ∃ K : Set E, IsPCompactDisk p K ∧
      ∀ n φ, scalarPSum p (fun i => φ (x n i)) ≤ support K φ := by
  classical
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  let I := Σ n : ℕ, Fin (m n + 1)
  let y : I → E := fun a => Fin.lastCases 0 (x a.1) a.2
  let e : ℕ ≃ I := Classical.choice inferInstance
  let z : ℕ → E := y ∘ e
  have hrow (n : ℕ) : (∑' j : Fin (m n + 1), ‖y ⟨n, j⟩‖ ^ p.1.toReal) =
      scalarPSum p (fun i => ‖x n i‖) ^ p.1.toReal := by
    simp only [tsum_fintype, Fin.sum_univ_castSucc, y, Fin.lastCases_castSucc,
      Fin.lastCases_last, norm_zero, Real.zero_rpow hp0.ne', add_zero,
      scalarPSum_rpow p hp, abs_norm]
  have hy : Summable (fun a : I => ‖y a‖ ^ p.1.toReal) := by
    apply (summable_sigma_of_nonneg (fun _ => by positivity)).mpr
    exact ⟨fun _ => (hasSum_fintype _).summable, by simpa only [hrow] using hx⟩
  have hz : Summable (fun n => ‖z n‖ ^ p.1.toReal) := e.summable_iff.mpr hy
  have hK : IsPCompactDisk p (diskOfSequence p z) := (Or.inl ⟨hp, z, hz, rfl⟩)
  refine ⟨diskOfSequence p z, hK, ?_⟩
  intro n φ
  have hc := summable_disk_compact p _ hK
  apply (Real.rpow_le_rpow_iff (scalarPSum_nonneg ..)
    (apply_nonneg (supportSeminorm _ hc.1 hc.2.2.isBounded) φ) hp0).mp
  change (scalarPSum p (fun i => φ (x n i))) ^ p.1.toReal ≤
    support (diskOfSequence p z) φ ^ p.1.toReal
  rw [support_disk_rpow p hp z hz]
  have hφ : Summable (fun a : I => |φ (y a)| ^ p.1.toReal) := by
    apply e.summable_iff.mp
    let b : lp (fun _ : ℕ => E) p.1 := ⟨z, (memℓp_gen_iff hp0).mpr hz⟩
    have hh := (lp.memℓp (lpDualImage p b φ)).summable hp0
    change Summable (fun k => ‖φ (z k)‖ ^ p.1.toReal) at hh
    simpa only [Real.norm_eq_abs, z, Function.comp_def] using hh
  change _ ≤ ∑' k, |φ (y (e k))| ^ p.1.toReal
  rw [e.tsum_eq (fun a : I => |φ (y a)| ^ p.1.toReal), hφ.tsum_sigma]
  have hrowφ (n : ℕ) : (∑' j : Fin (m n + 1), |φ (y ⟨n, j⟩)| ^ p.1.toReal) =
      scalarPSum p (fun i => φ (x n i)) ^ p.1.toReal := by
    simp only [tsum_fintype, Fin.sum_univ_castSucc, y, Fin.lastCases_castSucc,
      Fin.lastCases_last, map_zero, abs_zero, Real.zero_rpow hp0.ne', add_zero,
      scalarPSum_rpow p hp]
  rw [← hrowφ n]
  exact hφ.sigma.le_tsum n (fun k _ => tsum_nonneg (fun j => by positivity))

/-- Every algebraic free-lattice element has a finite p-sum majorant when p is finite.
Consequently the set of costs in `majorant_norm` is nonempty and its infimum is meaningful. -/
theorem fvl_majorant_nonempty (p : Exponent) (hp : p.IsFinite) (v : FVL E) :
    {r : ℝ | ∃ (m : ℕ) (x : Fin m → E), r = scalarPSum p (fun i => ‖x i‖) ∧
      ∀ φ, |fvlFunction v φ| ≤ scalarPSum p (fun i => φ (x i))}.Nonempty := by
  obtain ⟨n, x, H, hf⟩ := fvl_finite_calculus p v
  obtain ⟨m, y, hy⟩ := (majorantCalculus p hp (fun i => majorantDelta p hp (x i)) H).2
  refine ⟨_, m, y, rfl, ?_⟩
  intro φ
  rw [hf φ]
  exact hy φ

/-- Continuous evaluation on the free lattice at an arbitrary dual functional. -/
def freeEvaluationCLM (p : Exponent) (φ : Dual E) : Free p E →L[ℝ] ℝ :=
  (hpEvaluation p φ).comp (freeSublattice p E).toSubmodule.subtypeL

private theorem norm_sub_lt_quarter_step {X : Type*} [SeminormedAddCommGroup X]
    (f : ℕ → X) (g : X)
    (hf : ∀ n, ‖f n - g‖ < (1 / 16 : ℝ) * (1 / 4 : ℝ) ^ n) (n : ℕ) :
    ‖f (n + 1) - f n‖ < (1 / 4 : ℝ) ^ (n + 1) := by
  have hsub : f (n + 1) - f n = (f (n + 1) - g) - (f n - g) := by abel
  rw [hsub]
  have hnorm := norm_sub_le (f (n + 1) - g) (f n - g)
  have h₁ := hf (n + 1)
  have h₂ := hf n
  rw [pow_succ] at h₁ ⊢
  nlinarith only [hnorm, h₁, h₂, pow_pos (by norm_num : (0 : ℝ) < 1 / 4) n]

private theorem rapid_fvl_approximation (p : Exponent) (g : Free p E) :
    ∃ V : ℕ → FVL E, Tendsto (fun n => ofFVL p (V n)) atTop (𝓝 g) ∧
      ∀ n, ‖ofFVL p (V (n + 1) - V n)‖ < (1 / 4 : ℝ) ^ (n + 1) := by
  have hv (n : ℕ) : ∃ v : FVL E, ‖ofFVL p v - g‖ < (1 / 16 : ℝ) * (1 / 4 : ℝ) ^ n := by
    obtain ⟨_, ⟨v, rfl⟩, hv⟩ := Metric.mem_closure_iff.mp (denseRange_ofFVL p g)
      ((1 / 16 : ℝ) * (1 / 4 : ℝ) ^ n) (by positivity)
    exact ⟨v, by simpa only [dist_eq_norm, norm_sub_rev] using hv⟩
  choose V hV using hv
  have hVlim : Tendsto (fun n => ofFVL p (V n)) atTop (𝓝 g) := by
    apply tendsto_iff_norm_sub_tendsto_zero.mpr
    apply squeeze_zero (fun _ => norm_nonneg _) (fun n => (hV n).le)
    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 4)
      (by norm_num : (1 / 4 : ℝ) < 1)).const_mul (1 / 16 : ℝ)
  have hd (n : ℕ) : ‖ofFVL p (V (n + 1) - V n)‖ < (1 / 4 : ℝ) ^ (n + 1) := by
    rw [map_sub]
    exact norm_sub_lt_quarter_step (fun n => ofFVL p (V n)) g hV n
  exact ⟨V, hVlim, hd⟩

private theorem geometric_approximation [CompleteSpace E] (p : Exponent)
    (hp : p.IsFinite) (g : Free p E) :
    ∃ (V : ℕ → FVL E) (K : Set E), IsPCompactDisk p K ∧
      ∀ n φ, |g φ - fvlFunction (V n) φ| ≤ (1 / 2 : ℝ) ^ n * support K φ := by
  obtain ⟨V, hVlim, hd⟩ := rapid_fvl_approximation p g
  have hm (n : ℕ) : ∃ (m : ℕ) (x : Fin m → E),
      scalarPSum p (fun i => ‖x i‖) < (1 / 4 : ℝ) ^ (n + 1) ∧
      ∀ φ, |fvlFunction (V (n + 1) - V n) φ| ≤ scalarPSum p (fun i => φ (x i)) := by
    obtain ⟨r, ⟨m, x, rfl, hx⟩, hr⟩ := exists_lt_of_csInf_lt
      (fvl_majorant_nonempty p hp (V (n + 1) - V n))
      (by rw [← majorant_norm p hp]; exact hd n)
    exact ⟨m, x, hr, hx⟩
  choose m x hx hdom using hm
  let y : ∀ n, Fin (m n) → E := fun n i => (2 : ℝ) ^ (n + 1) • x n i
  have hy (n : ℕ) : scalarPSum p (fun i => ‖y n i‖) ≤ (1 / 2 : ℝ) ^ (n + 1) := by
    simp only [y, norm_smul, Real.norm_eq_abs, abs_of_pos (pow_pos (by norm_num : (0 : ℝ) < 2) _),
      scalarPSum_smul]
    calc
      _ ≤ (2 : ℝ) ^ (n + 1) * (1 / 4 : ℝ) ^ (n + 1) :=
        mul_le_mul_of_nonneg_left (hx n).le (by positivity)
      _ = _ := by rw [← mul_pow]; norm_num
  have hp1 : 1 ≤ p.1.toReal := by exact_mod_cast ENNReal.toReal_mono (ne_of_lt hp) p.2
  have hysum : Summable (fun n => scalarPSum p (fun i => ‖y n i‖) ^ p.1.toReal) := by
    apply Summable.of_nonneg_of_le (fun n => Real.rpow_nonneg (scalarPSum_nonneg ..) _) ?_
      (summable_geometric_two.mul_right (1 / 2 : ℝ))
    intro n
    have hb : scalarPSum p (fun i => ‖y n i‖) ≤ 1 := (hy n).trans
      (pow_le_one₀ (by norm_num) (by norm_num))
    exact (Real.rpow_le_self_of_le_one (scalarPSum_nonneg ..) hb hp1).trans
      (by simpa only [pow_succ] using hy n)
  obtain ⟨K, hK, hKbound⟩ := disk_dominates_finite_families p hp m y hysum
  refine ⟨V, K, hK, ?_⟩
  intro n φ
  have hstep (k : ℕ) : dist (fvlFunction (V k) φ) (fvlFunction (V (k + 1)) φ) ≤
      (1 / 2 : ℝ) ^ (k + 1) * support K φ := by
    have hbound := hKbound k φ
    simp only [y, map_smul, smul_eq_mul, scalarPSum_smul,
      abs_of_pos (pow_pos (by norm_num : (0 : ℝ) < 2) _)] at hbound
    have hvalue : fvlFunction (V (k + 1) - V k) φ =
        fvlFunction (V (k + 1)) φ - fvlFunction (V k) φ := by
      change ofFVL p (V (k + 1) - V k) φ = _
      rw [map_sub]
      rfl
    have hh := (mul_le_mul_of_nonneg_left (hdom k φ)
      (by positivity : (0 : ℝ) ≤ 2 ^ (k + 1))).trans hbound
    rw [hvalue] at hh
    rw [Real.dist_eq, abs_sub_comm]
    have hid : (1 / 2 : ℝ) ^ (k + 1) * 2 ^ (k + 1) = 1 := by rw [← mul_pow]; norm_num
    have hmul := mul_le_mul_of_nonneg_left hh (by positivity : (0 : ℝ) ≤ (1 / 2 : ℝ) ^ (k + 1))
    simpa only [← mul_assoc, hid, one_mul] using hmul
  have hlim : Tendsto (fun k => fvlFunction (V k) φ) atTop (𝓝 (g φ)) :=
    ((freeEvaluationCLM p φ).continuous.tendsto g).comp hVlim
  have hsum : Summable (fun k => (1 / 2 : ℝ) ^ (k + 1) * support K φ) := by
    simpa only [pow_succ, mul_assoc] using
      summable_geometric_two.mul_right ((1 / 2 : ℝ) * support K φ)
  have htail := dist_le_tsum_of_dist_le_of_tendsto _ hstep hsum hlim n
  have htailval : (∑' k, (1 / 2 : ℝ) ^ (n + k + 1) * support K φ) =
      (1 / 2 : ℝ) ^ n * support K φ := by
    simp only [pow_succ, pow_add, mul_assoc]
    rw [tsum_mul_left, tsum_mul_right, tsum_geometric_two]
    ring
  rw [htailval] at htail
  simpa only [Real.dist_eq, abs_sub_comm] using htail

private theorem scalarPSum_coord_le (p : Exponent) {n : ℕ} (a : Fin n → ℝ) (i : Fin n) :
    |a i| ≤ scalarPSum p a := by
  rw [scalarPSum_eq_piLp_norm]
  exact PiLp.norm_apply_le (WithLp.toLp p.1 a) i

private theorem finite_family_pCompactDisk [CompleteSpace E] (p : Exponent) (hp : p.IsFinite)
    {n : ℕ} (x : Fin n → E) : ∃ K : Set E, IsPCompactDisk p K ∧
      ∀ φ, support K φ = scalarPSum p (fun i => φ (x i)) := by
  let K : Fin n → Set E := fun i => {y | ∃ t : ℝ, |t| ≤ 1 ∧ y = t • x i}
  obtain ⟨L, hL, hsup⟩ := pCompactDisk_support_combination p hp n K
    (fun i => (segment_pCompactDisk p (x i)).1) (fun _ => 1) (fun _ => zero_le_one)
  refine ⟨L, hL, ?_⟩
  intro φ
  rw [hsup]
  simp only [one_mul, K, (segment_pCompactDisk p _).2 φ, scalarPSum_abs]

private theorem finite_calculus_local_control [CompleteSpace E] (p : Exponent) (hp : p.IsFinite)
    (v : FVL E) (φ₀ : Dual E) (ε : ℝ) (hε : 0 < ε) :
    ∃ K : Set E, IsPCompactDisk p K ∧
      ∀ φ, support K (φ - φ₀) < 1 → |fvlFunction v φ - fvlFunction v φ₀| < ε := by
  obtain ⟨n, x, H, hv⟩ := fvl_finite_calculus p v
  obtain ⟨δ, hδ, hH⟩ := Metric.continuousAt_iff.mp
    (H.1.continuous.continuousAt (x := fun i => φ₀ (x i))) ε hε
  obtain ⟨K, hK, hsupport⟩ := finite_family_pCompactDisk p hp (fun i => δ⁻¹ • x i)
  refine ⟨K, hK, ?_⟩
  intro φ hφ
  rw [hv φ, hv φ₀]
  apply (show dist (H (fun i => φ (x i))) (H (fun i => φ₀ (x i))) < ε from hH ?_)
  rw [dist_eq_norm, pi_norm_lt_iff hδ]
  intro i
  rw [hsupport] at hφ
  have hi := scalarPSum_coord_le p (fun j => (φ - φ₀) (δ⁻¹ • x j)) i
  have hilt := hi.trans_lt hφ
  simp only [map_smul, smul_eq_mul, sub_apply, abs_mul, abs_of_pos (inv_pos.mpr hδ)] at hilt
  change |φ (x i) - φ₀ (x i)| < δ
  exact (inv_mul_lt_one₀ hδ).mp hilt

private theorem pair_support_domination [CompleteSpace E] (p : Exponent) (hp : p.IsFinite)
    (K L : Set E) (hK : IsPCompactDisk p K) (hL : IsPCompactDisk p L) :
    ∃ D : Set E, IsPCompactDisk p D ∧
      ∀ φ, support K φ ≤ support D φ ∧ support L φ ≤ support D φ := by
  obtain ⟨D, hD, hs⟩ := pCompactDisk_support_combination p hp 2 ![K, L]
    (by intro i; fin_cases i <;> assumption) (fun _ => 1) (fun _ => zero_le_one)
  refine ⟨D, hD, ?_⟩
  intro φ
  rw [hs]
  constructor
  · simpa only [one_mul, Matrix.cons_val_zero] using
      (le_abs_self (support K φ)).trans (scalarPSum_coord_le p (fun i => support (![K, L] i) φ) 0)
  · simpa only [one_mul, Matrix.cons_val_one, Matrix.head_cons] using
      (le_abs_self (support L φ)).trans (scalarPSum_coord_le p (fun i => support (![K, L] i) φ) 1)

private theorem compact_local_control (p : Exponent) (f : Free p E)
    (φ₀ : Dual E) (ε : ℝ) (hε : 0 < ε) :
    ∃ K : Set E, K.Nonempty ∧ IsCompact K ∧
      ∀ φ, support K (φ - φ₀) < 1 → |f φ - f φ₀| < ε := by
  let D : Set (WeakDual ℝ E) := {ψ | ε ≤ |f (ψ.toStrongDual + φ₀) - f φ₀|}
  have hD (r : ℝ) : IsClosed (D ∩ weakDualNormBall r) := by
    have hb : IsClosed (weakDualNormBall (E := E) r) := by
      convert WeakDual.isClosed_closedBall (0 : Dual E) r using 1
      ext φ
      simp [weakDualNormBall, Metric.mem_closedBall, dist_zero_right]
    have hc : ContinuousOn (fun ψ : WeakDual ℝ E => f (ψ.toStrongDual + φ₀))
        (weakDualNormBall r) := by
      exact (weakStar_continuous_bounded p f (r + ‖φ₀‖)).comp
        ((continuous_id.add continuous_const :
          Continuous (fun ψ : WeakDual ℝ E => ψ + StrongDual.toWeakDual φ₀)).continuousOn)
        (fun ψ hψ => (norm_add_le _ _).trans (add_le_add hψ le_rfl))
    have hclosed : IsClosed {ψ : WeakDual ℝ E | ψ ∈ weakDualNormBall r ∧
        ε ≤ |f (ψ.toStrongDual + φ₀) - f φ₀|} :=
      hb.isClosed_le (f := fun _ => ε) continuousOn_const (hc.sub continuousOn_const).abs
    convert hclosed using 1
    ext ψ
    exact and_comm
  have h0 : (0 : WeakDual ℝ E) ∉ D := by
    change ¬ ε ≤ |f (0 + φ₀) - f φ₀|
    simpa only [zero_add, sub_self, abs_zero] using hε.not_ge
  obtain ⟨K, hK, hsep⟩ := weakDual_exists_compact_separator D hD h0
  refine ⟨insert 0 K, Set.insert_nonempty _ _, hK.insert 0, ?_⟩
  intro φ hφ
  by_contra hn
  have hd : StrongDual.toWeakDual (φ - φ₀) ∈ D := by
    change ε ≤ |f ((φ - φ₀) + φ₀) - f φ₀|
    simpa only [sub_add_cancel] using le_of_not_gt hn
  obtain ⟨x, hx, hgt⟩ := hsep _ hd
  have hle := le_support (insert 0 K) (hK.insert 0).isBounded (φ - φ₀)
    (mem_insert_of_mem 0 hx)
  exact hgt.not_ge (hle.trans hφ.le)

/-- The finite-exponent case of the local-control lemma. -/
private theorem finite_summable_local_control [CompleteSpace E] (p : Exponent) (hp : p.IsFinite)
    (g : Free p E) (φ₀ : Dual E) (ε : ℝ) (hε : 0 < ε) :
    ∃ K : Set E, IsPCompactDisk p K ∧
      ∀ φ, support K (φ - φ₀) < 1 → |g φ - g φ₀| < ε := by
  obtain ⟨V, K, hK, happrox⟩ := geometric_approximation p hp g
  have hlim : Tendsto (fun n => (1 / 2 : ℝ) ^ n * (2 * support K φ₀ + 1))
      atTop (𝓝 0) := by
    simpa only [zero_mul] using
      summable_geometric_two.tendsto_atTop_zero.mul_const (2 * support K φ₀ + 1)
  obtain ⟨N, hN⟩ := (hlim.eventually (gt_mem_nhds (half_pos hε))).exists
  obtain ⟨L, hL, hlocal⟩ := finite_calculus_local_control p hp (V N) φ₀ (ε / 2) (half_pos hε)
  obtain ⟨D, hD, hdom⟩ := pair_support_domination p hp K L hK hL
  refine ⟨D, hD, ?_⟩
  intro φ hφ
  have hρ : support K (φ - φ₀) < 1 := ((hdom _).1).trans_lt hφ
  have hV := hlocal φ (((hdom _).2).trans_lt hφ)
  have hc := summable_disk_compact p K hK
  have hs := map_add_le_add (supportSeminorm K hc.1 hc.2.2.isBounded) (φ - φ₀) φ₀
  change support K ((φ - φ₀) + φ₀) ≤ support K (φ - φ₀) + support K φ₀ at hs
  rw [sub_add_cancel] at hs
  have htail := happrox N φ
  have htail₀ := happrox N φ₀
  have htriangle := abs_sub_le (g φ) (fvlFunction (V N) φ) (g φ₀)
  have htriangle' := abs_sub_le (fvlFunction (V N) φ) (fvlFunction (V N) φ₀) (g φ₀)
  rw [abs_sub_comm (fvlFunction (V N) φ₀) (g φ₀)] at htriangle'
  have hpw : 0 ≤ (1 / 2 : ℝ) ^ N := by positivity
  nlinarith only [hN, hρ, hV, hs, htail, htail₀, htriangle, htriangle', hpw]

/-- Lemma 4.3 (`lem:summable-local-control`): at any dual point and positive `epsilon`,
an element of `Free p E` is controlled on a neighborhood defined by one p-compact support
seminorm. The result includes p = ∞ and yields continuity for the topology `tauP p E`. -/
theorem summable_local_control [CompleteSpace E] (p : Exponent)
    (g : Free p E) (φ₀ : Dual E) (ε : ℝ) (hε : 0 < ε) :
    ∃ K : Set E, IsPCompactDisk p K ∧
      ∀ φ, support K (φ - φ₀) < 1 → |g φ - g φ₀| < ε := by
  by_cases hp : p.IsFinite
  · exact finite_summable_local_control p hp g φ₀ ε hε
  · have hpinf : p = Exponent.infinity := Subtype.ext (eq_top_iff.mpr (not_lt.mp hp))
    subst p
    obtain ⟨K, hne, hK, hbound⟩ := compact_local_control Exponent.infinity g φ₀ ε hε
    have hhull := compact_support_closedAbsConvexHull K hne hK
    refine ⟨closedAbsConvexHull ℝ K, hhull.1, ?_⟩
    intro φ hφ
    exact hbound φ (by simpa only [hhull.2] using hφ)

/-- Every free-lattice function is continuous for uniform convergence on p-compact
disks. The local support bound from Lemma 4.3 gives a basic neighborhood for each
positive tolerance, including at the infinity endpoint. -/
theorem free_tauP_continuous [CompleteSpace E] (p : Exponent)
    (g : Free p E) : @Continuous (Dual E) ℝ (tauP p E) inferInstance g := by
  let : TopologicalSpace (Dual E) := tauP p E
  rw [continuous_iff_continuousAt]
  intro φ₀
  rw [ContinuousAt, Metric.tendsto_nhds]
  intro ε hε
  obtain ⟨K, hK, hbound⟩ := summable_local_control p g φ₀ ε hε
  have hopen := support_ball_open {K | IsPCompactDisk p K} K hK φ₀ 1 zero_lt_one
  have hmem := hopen.mem_nhds (x := φ₀)
    (by simp only [mem_ofPred_eq, sub_self, support_zero]; norm_num)
  filter_upwards [hmem] with φ hφ
  simpa only [Real.dist_eq] using hbound φ hφ

/-- The support function of a p-compact disk belongs to the free lattice. -/
theorem pCompact_support_inFree [CompleteSpace E] (p : Exponent) (K : Set E)
    (hK : IsPCompactDisk p K) : InFree p (support K) := by
  rcases hK with hK | ⟨rfl, _, _, hc⟩
  swap
  · exact compact_support_inFree_infinity K hc
  obtain ⟨hp, x, hx, rfl⟩ := hK
  obtain ⟨h, hh, _, _⟩ := summable_support p hp x hx
  exact ⟨h, fun φ => (hh φ).1⟩

/-- Corollary 4.4 (`cor:summable-approximation`): a homogeneous function belongs to
`Free p E`, for finite p, exactly when it can be uniformly approximated by
elements of the free vector lattice, with normalizer the support of a p-compact disk. -/
theorem summable_approximation [CompleteSpace E] (p : Exponent) (hp : p.IsFinite)
    (g : Dual E → ℝ) (hg : PosHomogeneous g) :
    InFree p g ↔ ∃ (V : ℕ → FVL E) (K : Set E) (ε : ℕ → ℝ),
      IsPCompactDisk p K ∧ (∀ n, 0 < ε n) ∧ Tendsto ε atTop (𝓝 0) ∧
      ∀ n φ, |g φ - fvlFunction (V n) φ| ≤ ε n * support K φ := by
  constructor
  · rintro ⟨f, hf⟩
    obtain ⟨V, K, hK, hbound⟩ := geometric_approximation p hp f
    exact ⟨V, K, (fun n => (1 / 2 : ℝ) ^ n), hK, (fun n => by positivity),
      summable_geometric_two.tendsto_atTop_zero, fun n φ => by rw [← hf φ]; exact hbound n φ⟩
  · rintro ⟨V, K, ε, hK, hε, hlim, hbound⟩
    obtain ⟨h, hh⟩ := pCompact_support_inFree p K hK
    let W : Free p E := ε 0 • h + |ofFVL p (V 0)|
    have hfinite : freeNormExt p g < ⊤ := by
      have hmono : freeNormExt p g ≤ freeNormExt p W := by
        apply freeNormExt_mono_abs
        intro φ
        have hb := hbound 0 φ
        have ht := abs_add_le (g φ - fvlFunction (V 0) φ) (fvlFunction (V 0) φ)
        rw [sub_add_cancel] at ht
        refine (ht.trans (add_le_add hb le_rfl)).trans ?_
        change ε 0 * support K φ + |fvlFunction (V 0) φ| ≤
          |ε 0 * h φ + (|fvlFunction (V 0) φ|)|
        rw [hh]
        exact le_abs_self _
      exact hmono.trans_lt (by rw [freeNormExt_eq_norm]; exact ENNReal.ofReal_lt_top)
    let G : HP p E := ⟨g, hg, hfinite⟩
    have hnorm (n : ℕ) : ‖G - (ofFVL p (V n)).1‖ ≤ ε n * ‖h‖ := by
      have hsolid : |G - (ofFVL p (V n)).1| ≤ |ε n • h.1| := by
        intro φ
        change |g φ - fvlFunction (V n) φ| ≤ |ε n * h φ|
        rw [hh]
        exact (hbound n φ).trans (le_abs_self _)
      have hb := HasSolidNorm.solid hsolid
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (hε n)] at hb
      exact hb
    have hGlim : Tendsto (fun n => (ofFVL p (V n)).1) atTop (𝓝 G) := by
      apply tendsto_iff_norm_sub_tendsto_zero.mpr
      apply squeeze_zero (fun n => norm_nonneg _)
        (fun n => by simpa only [norm_sub_rev] using hnorm n)
      simpa only [zero_mul] using hlim.mul_const ‖h‖
    have hG : G ∈ freeSublattice p E :=
      (VectorSublattice.isClosed_topologicalClosure _).mem_of_tendsto hGlim
        (Filter.Eventually.of_forall (fun n => (ofFVL p (V n)).2))
    exact ⟨⟨G, hG⟩, fun φ => rfl⟩

/-- The final clause of Corollary 4.4: geometric errors may be prescribed. -/
theorem summable_approximation_geometric [CompleteSpace E] (p : Exponent)
    (hp : p.IsFinite) (g : Free p E) :
    ∃ (V : ℕ → FVL E) (K : Set E), IsPCompactDisk p K ∧
      ∀ n φ, |g φ - fvlFunction (V n) φ| ≤ (2 : ℝ) ^ (-(n : ℤ)) * support K φ := by
  obtain ⟨V, K, hK, hbound⟩ := geometric_approximation p hp g
  refine ⟨V, K, hK, ?_⟩
  simpa only [zpow_neg, zpow_natCast, one_div, inv_pow] using hbound

/-- Corollary 4.5 (`cor:summable-global-domination`): the absolute value of every
 element of `Free p E` is dominated on the entire dual by the support of one p-compact
disk. Positive homogeneity turns local control at zero into this global estimate.
The statement also holds at the infinity endpoint. -/
theorem summable_global_domination [CompleteSpace E] (p : Exponent)
    (g : Free p E) : ∃ K : Set E, IsPCompactDisk p K ∧ ∀ φ, |g φ| ≤ support K φ := by
  obtain ⟨K, hK, hbound⟩ := summable_local_control p g 0 1 zero_lt_one
  refine ⟨K, hK, ?_⟩
  intro φ
  have hc := summable_disk_compact p K hK
  have hn : 0 ≤ support K φ := apply_nonneg (supportSeminorm K hc.1 hc.2.2.isBounded) φ
  apply le_of_forall_gt
  intro t ht
  have ht0 : 0 < t := hn.trans_lt ht
  have hb := hbound (t⁻¹ • φ) (by
    rw [sub_zero, support_smul, abs_of_pos (inv_pos.mpr ht0)]
    exact (inv_mul_lt_one₀ ht0).mpr ht)
  have hg0 : g (0 : Dual E) = 0 := by
    have h := g.1.2.1 0 (le_refl 0) (0 : Dual E)
    simpa only [zero_smul, zero_mul] using h
  rw [hg0, sub_zero, g.1.2.1 _ (inv_nonneg.mpr ht0.le), abs_mul,
    abs_of_pos (inv_pos.mpr ht0)] at hb
  exact (inv_mul_lt_one₀ ht0).mp hb

/-- A family of free functions has a common positive patch if one positive lower
bound holds for all its members on a neighborhood of a dual point defined by the
support of a p-compact disk. `positive_patches` converts this local condition into
a strictly positive common lattice minorant for a nonempty positive family. -/
def HasPositivePatch (p : Exponent) (A : Set (Free p E)) : Prop :=
  ∃ (φ₀ : Dual E) (ε : ℝ) (K : Set E), 0 < ε ∧ IsPCompactDisk p K ∧
    ∀ f ∈ A, ∀ φ, support K (φ - φ₀) < 1 → ε ≤ f φ

private theorem patch_function_inFree [CompleteSpace E] (p : Exponent) (K : Set E)
    (hK : IsPCompactDisk p K) (e : E) (φ₀ : Dual E) (ε : ℝ) :
    InFree p (fun ψ => ε * max (ψ e - support ((fun x : E => x - φ₀ x • e) '' K) ψ) 0) := by
  let Q : E →L[ℝ] E := ContinuousLinearMap.id ℝ E - φ₀.smulRight e
  obtain ⟨s, hs⟩ := pCompact_support_inFree p (Q '' K) (pCompactDisk_image p K hK Q)
  refine ⟨ε • ((delta p e - s) ⊔ 0), ?_⟩
  intro ψ
  change ε * max (ψ e - s ψ) 0 = _
  rw [hs]
  rfl

/-- The explicit minorant `ε * max (ψ e - support (Q(K)) ψ) 0`, where
`Q x = x - φ₀ x • e`. Its membership in the free lattice uses only the compact-disk
condition. The normalization `φ₀ e = 1` and positivity of ε are retained as arguments
for the nonzero-value and minorization assertions in `patchMinorant_properties`. -/
def patchMinorant [CompleteSpace E] (p : Exponent) (K : Set E) (hK : IsPCompactDisk p K)
    (e : E) (φ₀ : Dual E) (_he : φ₀ e = 1) (ε : ℝ) (_hε : 0 < ε) : Free p E :=
  ⟨⟨fun ψ => ε * max (ψ e - support ((fun x : E => x - φ₀ x • e) '' K) ψ) 0,
    by
      obtain ⟨h, hh⟩ := patch_function_inFree p K hK e φ₀ ε
      have heq : (fun ψ => ε * max (ψ e - support ((fun x : E => x - φ₀ x • e) '' K) ψ) 0) =
          h.1.1 := funext (fun ψ => (hh ψ).symm)
      change PosHomogeneous _ ∧ freeNormExt p _ < ⊤
      rw [heq]
      exact h.1.2⟩, by
    obtain ⟨h, hh⟩ := patch_function_inFree p K hK e φ₀ ε
    refine Eq.mpr (congrArg (fun f : HP p E => f ∈ freeSublattice p E) ?_) h.2
    exact Subtype.ext (funext (fun ψ => (hh ψ).symm))⟩

/-- Proposition 4.6's constructive implication, with the claimed nonzero value. -/
theorem patchMinorant_properties [CompleteSpace E] (p : Exponent)
    (K : Set E) (hK : IsPCompactDisk p K) (e : E) (φ₀ : Dual E) (he : φ₀ e = 1)
    (ε : ℝ) (hε : 0 < ε) :
    patchMinorant p K hK e φ₀ he ε hε φ₀ = ε ∧
      0 < patchMinorant p K hK e φ₀ he ε hε ∧
      ∀ f : Free p E, 0 ≤ f →
        (∀ ψ, support K (ψ - φ₀) < 1 → ε ≤ f ψ) →
        patchMinorant p K hK e φ₀ he ε hε ≤ f := by
  let Q : E →L[ℝ] E := ContinuousLinearMap.id ℝ E - φ₀.smulRight e
  let L := Q '' K
  have hL := summable_disk_compact p L (pCompactDisk_image p K hK Q)
  have hcK := summable_disk_compact p K hK
  have hval (ψ : Dual E) : patchMinorant p K hK e φ₀ he ε hε ψ =
      ε * max (ψ e - support L ψ) 0 := rfl
  have hs₀ : support L φ₀ = 0 := by
    apply le_antisymm
    · apply csSup_le (hL.1.image _)
      rintro _ ⟨_, ⟨x, hx, rfl⟩, rfl⟩
      simp [Q, he]
    · exact apply_nonneg (supportSeminorm L hL.1 hL.2.2.isBounded) φ₀
  have hval₀ : patchMinorant p K hK e φ₀ he ε hε φ₀ = ε := by
    simp [hval, he, hs₀]
  refine ⟨hval₀, ?_, ?_⟩
  · apply lt_iff_le_not_ge.mpr
    constructor
    · apply (free_le_iff p _ _).mpr
      intro ψ
      change 0 ≤ patchMinorant p K hK e φ₀ he ε hε ψ
      rw [hval]
      exact mul_nonneg hε.le (le_max_right _ _)
    · intro hle
      have hb := (free_le_iff p _ _).mp hle φ₀
      change patchMinorant p K hK e φ₀ he ε hε φ₀ ≤ 0 at hb
      rw [hval₀] at hb
      exact hε.not_ge hb
  · intro f hf hpatch
    apply (free_le_iff p _ _).mpr
    intro ψ
    rw [hval]
    by_cases hpos : 0 < ψ e - support L ψ
    · have hspos : 0 ≤ support L ψ :=
        apply_nonneg (supportSeminorm L hL.1 hL.2.2.isBounded) ψ
      have ht : 0 < ψ e := by linarith
      have hpatch' : ε ≤ f ((ψ e)⁻¹ • ψ) := by
        apply hpatch
        calc
          support K ((ψ e)⁻¹ • ψ - φ₀) ≤ (ψ e)⁻¹ * support L ψ := by
            apply csSup_le (hcK.1.image _)
            rintro _ ⟨x, hx, rfl⟩
            have hb := le_support L hL.2.2.isBounded ψ (mem_image_of_mem Q hx)
            have heq : (((ψ e)⁻¹ • ψ) - φ₀) x = (ψ e)⁻¹ * ψ (Q x) := by
              simp only [Q, sub_apply, ContinuousLinearMap.id_apply,
                ContinuousLinearMap.smulRight_apply, map_sub, map_smul, smul_apply, smul_eq_mul]
              field_simp
            change |(((ψ e)⁻¹ • ψ) - φ₀) x| ≤ _
            rw [heq, abs_mul, abs_of_pos (inv_pos.mpr ht)]
            exact mul_le_mul_of_nonneg_left hb (inv_nonneg.mpr ht.le)
          _ < 1 := (inv_mul_lt_one₀ ht).mpr (by linarith)
      have hhom := f.1.2.1 ((ψ e)⁻¹) (inv_nonneg.mpr ht.le) ψ
      have hbound : ε * ψ e ≤ f ψ := by
        rw [hhom] at hpatch'
        have hh := mul_le_mul_of_nonneg_left hpatch' ht.le
        simpa only [← mul_assoc, mul_inv_cancel₀ ht.ne', one_mul, mul_comm (ψ e) ε] using hh
      rw [max_eq_left hpos.le]
      exact (mul_le_mul_of_nonneg_left (by linarith) hε.le).trans hbound
    · rw [max_eq_right (le_of_not_gt hpos), mul_zero]
      exact (free_le_iff p _ _).mp hf ψ

/-- Proposition 4.6 (`prop:positive-patches`): a nonempty family of positive free
functions has a strictly positive common lattice minorant exactly when it has a
common positive patch in the support topology. `patchMinorant` gives an explicit
minorant from the patch data, for every exponent including ∞. -/
theorem positive_patches [CompleteSpace E] (p : Exponent)
    (A : Set (Free p E)) (hne : A.Nonempty) (hpos : ∀ f ∈ A, 0 ≤ f) :
    (∃ h : Free p E, 0 < h ∧ ∀ f ∈ A, h ≤ f) ↔ HasPositivePatch p A := by
  constructor
  · rintro ⟨h, hh, hbound⟩
    have hpoint : ∃ φ₀ : Dual E, 0 < h φ₀ := by
      by_contra! hn
      exact hh.not_ge ((free_le_iff p _ _).mpr hn)
    obtain ⟨φ₀, hφ₀⟩ := hpoint
    obtain ⟨K, hK, hlocal⟩ := summable_local_control p h φ₀ (h φ₀ / 2) (half_pos hφ₀)
    refine ⟨φ₀, h φ₀ / 2, K, half_pos hφ₀, hK, ?_⟩
    intro f hf φ hφ
    have hb := (free_le_iff p _ _).mp (hbound f hf) φ
    have hd := (abs_lt.mp (hlocal φ hφ)).1
    linarith
  · rintro ⟨φ₀, ε, K, hε, hK, hpatch⟩
    have hφ₀ : φ₀ ≠ 0 := by
      intro hz
      obtain ⟨f, hf⟩ := hne
      have hb := hpatch f hf φ₀ (by simpa only [sub_self, support_zero] using zero_lt_one)
      have hzero := f.1.2.1 0 (le_refl 0) (0 : Dual E)
      rw [hz] at hb
      simp only [zero_smul, zero_mul] at hzero
      exact hε.not_ge (by simpa only [hzero] using hb)
    obtain ⟨x, hx⟩ : ∃ x : E, φ₀ x ≠ 0 := by
      by_contra! hx
      exact hφ₀ (ContinuousLinearMap.ext hx)
    let e : E := (φ₀ x)⁻¹ • x
    have he : φ₀ e = 1 := by simp only [e, map_smul, smul_eq_mul, inv_mul_cancel₀ hx]
    have hminor := patchMinorant_properties p K hK e φ₀ he ε hε
    exact ⟨patchMinorant p K hK e φ₀ he ε hε, hminor.2.1,
      fun f hf => hminor.2.2 f (hpos f hf) (hpatch f hf)⟩

/-- The net conclusion of Proposition 4.6 for a nonempty preordered index type. -/
theorem positive_patches_net [CompleteSpace E] (p : Exponent)
    {ι : Type v} [Preorder ι] [Nonempty ι]
    (f : ι → Free p E) (hmono : Antitone f) (hpos : ∀ i, 0 ≤ f i) :
    DecreasesToZero f ↔ ¬ HasPositivePatch p (Set.range f) := by
  have hpatch := positive_patches p (Set.range f) (Set.range_nonempty f)
    (by rintro _ ⟨i, rfl⟩; exact hpos i)
  constructor
  · intro hf hpch
    obtain ⟨h, hh, hbound⟩ := hpatch.mpr hpch
    exact hh.not_ge (hf.2.2 hbound)
  · intro hnone
    refine ⟨hmono, ⟨?_, ?_⟩⟩
    · rintro _ ⟨i, rfl⟩
      exact hpos i
    · intro h hh
      by_contra hn
      apply hnone
      apply hpatch.mp
      refine ⟨h ⊔ 0, lt_iff_le_not_ge.mpr ⟨le_sup_right, ?_⟩, ?_⟩
      · exact fun hle => hn (le_sup_left.trans hle)
      · rintro _ ⟨i, rfl⟩
        exact sup_le (hh (Set.mem_range_self i)) (hpos i)

/-- Finite absolute suprema of evaluations in BanLat's free vector lattice. -/
def finiteSupport (A : Finset E) : FVL E :=
  if h : A.Nonempty then A.sup' h (fun a => |FVLv.of a|) else 0

private theorem finiteSupport_apply (A : Finset E) (hA : A.Nonempty) (φ : Dual E) :
    fvlFunction (finiteSupport A) φ = A.sup' hA (fun a => |φ a|) := by
  classical
  change (freeEvaluation Exponent.one φ) (ofFVL Exponent.one (finiteSupport A)) = _
  rw [finiteSupport, dite_eq_left hA, map_finset_sup', map_finset_sup']
  congr 1
  funext a
  change (freeEvaluation Exponent.one φ) (ofFVL Exponent.one |FVLv.of a|) = |φ a|
  rw [VecLatHom.map_abs, ofFVL_of, VecLatHom.map_abs]
  rfl

/-- A nonempty finite absolute supremum is the support of its generating finite set. -/
theorem finiteSupport_support (A : Finset E) (hA : A.Nonempty) (φ : Dual E) :
    fvlFunction (finiteSupport A) φ = support (A : Set E) φ := by
  rw [finiteSupport_apply A hA]
  apply le_antisymm
  · exact Finset.sup'_le _ _ (fun a ha => le_support _ A.finite_toSet.isBounded φ ha)
  · apply csSup_le (hA.to_set.image _)
    rintro _ ⟨a, ha, rfl⟩
    exact Finset.le_sup' (fun a => |φ a|) ha

private theorem ofFVL_map (p : Exponent) (T : F →L[ℝ] E) (v : FVL F) :
    ofFVL p (FVLv.map T.toLinearMap v) = induced p T (ofFVL p v) := by
  have heq : (ofFVL p).comp (FVLv.map T.toLinearMap) =
      (induced p T).toVecLatHom.comp (ofFVL p) := by
    apply FVLv.hom_ext
    intro x
    simp only [VecLatHom.comp_apply, FVLv.map_of, ofFVL_of]
    exact ((induced_norm_generators p T).2 x).symm
  exact DFunLike.congr_fun heq v

/-- A finite family of vectors generates a p-compact disk contained in its linear span.
The disk’s support at φ is exactly the scalar p-sum of the values of φ on that family.
This supplies compact, finite-dimensional support majorants for algebraic free elements. -/
theorem finite_family_disk_in_span (p : Exponent) (hp : p.IsFinite)
    {n : ℕ} (x : Fin n → E) : ∃ K : Set E, IsPCompactDisk p K ∧
      K ⊆ Submodule.span ℝ (Set.range x) ∧
      ∀ φ, support K φ = scalarPSum p (fun i => φ (x i)) := by
  let N := Submodule.span ℝ (Set.range x)
  let : FiniteDimensional ℝ N := FiniteDimensional.span_of_finite (K := ℝ) (Set.finite_range x)
  let y : Fin n → N := fun i => ⟨x i, Submodule.subset_span (Set.mem_range_self i)⟩
  obtain ⟨L, hL, hsupport⟩ := finite_family_pCompactDisk p hp y
  refine ⟨N.subtypeL '' L, pCompactDisk_image p L hL N.subtypeL, ?_, ?_⟩
  · rintro _ ⟨a, _, rfl⟩
    exact a.2
  · intro φ
    rw [support, compactSupport, Set.image_image]
    exact hsupport (φ.comp N.subtypeL)

/-- A bound on the absolute value of a linear functional on A extends to the absolutely
convex hull of A. This is the support estimate used when replacing finite sets by disks. -/
theorem absConvexHull_eval_bound (A : Set E) (φ : Dual E) (r : ℝ)
    (h : ∀ a ∈ A, |φ a| ≤ r) : ∀ a ∈ absConvexHull ℝ A, |φ a| ≤ r := by
  have hsub : A ⊆ φ.toSeminorm.closedBall 0 r := by
    intro a ha
    change ‖φ (a - 0)‖ ≤ r
    simpa only [sub_zero, Real.norm_eq_abs] using h a ha
  intro a ha
  have hmem := absConvexHull_min hsub
    ⟨φ.toSeminorm.balanced_closedBall_zero r, φ.toSeminorm.convex_closedBall 0 r⟩ ha
  change ‖φ (a - 0)‖ ≤ r at hmem
  simpa only [sub_zero, Real.norm_eq_abs] using hmem

private theorem bounded_coordinates_finite_net {ι : Type*} {N : ℕ}
    (f : ι → Fin N → ℝ) (hf : ∀ i j, |f i j| ≤ 1) (ε : ℝ) (hε : 0 < ε) :
    ∃ B : Finset ι, ∀ i, ∃ j ∈ B, ∀ k, |f i k - f j k| < ε := by
  classical
  have hb : Set.range f ⊆ Metric.closedBall 0 1 := by
    rintro _ ⟨i, rfl⟩
    rw [Metric.mem_closedBall, dist_zero_right, pi_norm_le_iff_of_nonneg zero_le_one]
    intro j
    exact hf i j
  have hc : IsCompact (closure (Set.range f)) :=
    (isCompact_closedBall (0 : Fin N → ℝ) 1).of_isClosed_subset isClosed_closure
      (closure_minimal hb Metric.isClosed_closedBall)
  obtain ⟨B, hB⟩ := hc.elim_finite_subcover (fun i => Metric.ball (f i) ε)
    (fun _ => Metric.isOpen_ball) (by
      intro a ha
      obtain ⟨_, ⟨i, rfl⟩, hi⟩ := Metric.mem_closure_iff.mp ha ε hε
      exact Set.mem_iUnion.mpr ⟨i, hi⟩)
  refine ⟨B, ?_⟩
  intro i
  obtain ⟨j, hj, hij⟩ := Set.mem_iUnion₂.mp (hB (subset_closure (Set.mem_range_self i)))
  refine ⟨j, hj, fun k => ?_⟩
  exact (dist_le_pi_dist (f i) (f j) k).trans_lt hij

private theorem coefficientSeries_eval_le [CompleteSpace E] (p : Exponent) (hp : p.IsFinite)
    (x : lp (fun _ : ℕ => E) p.1) (t : coefficientBall (conjugate p)) (φ : Dual E) :
    |φ (coefficientSeries p hp t x)| ≤ lpSupport p hp x φ := by
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  have hK := summable_disk_compact p (diskOfSequence p x)
    (Or.inl ⟨hp, x, (lp.memℓp x).summable hp0, rfl⟩)
  change |φ (coefficientSeries p hp t x)| ≤ ‖lpDualImage p x φ‖
  rw [← support_disk_norm p hp x φ]
  apply le_support _ hK.2.2.isBounded φ
  obtain ⟨b, hb, hbt⟩ := t.2
  refine ⟨b, hb, ?_⟩
  change HasSum (fun n => b n • x n) (∑' n, t.1 n • x n)
  simpa only [hbt] using (coefficient_series_bound p hp x t).1.hasSum

private theorem finite_subset_support_approx [CompleteSpace E] (p : Exponent) (hp : p.IsFinite)
    (A K : Set E) (hA : A.Nonempty) (hAK : A ⊆ K) (hK : IsPCompactDisk p K)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ B : Finset E, B.Nonempty ∧ (↑B : Set E) ⊆ A ∧ ∃ W : HP p E,
      ‖W‖ < ε ∧ ∀ φ, |support A φ - fvlFunction (finiteSupport B) φ| ≤ W φ := by
  classical
  obtain ⟨x, hx, rfl⟩ := (isPCompactDisk_iff_of_finite p hp K).mp hK
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos
    (ne_of_gt (zero_lt_one.trans_le p.2)) (ne_of_lt hp)
  let a : lp (fun _ : ℕ => E) p.1 := ⟨x, (memℓp_gen_iff hp0).mpr hx⟩
  have hrep (b : A) : ∃ t : coefficientBall (conjugate p),
      coefficientSeries p hp t a = (b : E) := by
    obtain ⟨t, ht, htb⟩ := hAK b.2
    exact ⟨⟨t, t, ht, rfl⟩, htb.tsum_eq⟩
  choose t ht using hrep
  let aN (N : ℕ) : lp (fun _ : ℕ => E) p.1 := ∑ i : Fin N, lp.single p.1 i (a i)
  have hlim : Tendsto aN atTop (𝓝 a) := by
    have heq (N : ℕ) : aN N = ∑ i ∈ Finset.range N, lp.single p.1 i (a i) :=
      Fin.sum_univ_eq_sum_range (fun i => lp.single p.1 i (a i)) N
    change Tendsto (fun N => aN N) atTop (𝓝 a)
    simp_rw [heq]
    exact (lp.hasSum_single (ne_of_lt hp) a).tendsto_sum_nat
  have htail : Tendsto (fun N => ‖a - aN N‖) atTop (𝓝 0) := by
    simpa only [sub_self, norm_zero] using ((tendsto_const_nhds (x := a)).sub hlim).norm
  obtain ⟨N, hN⟩ := (htail.eventually_lt_const (by positivity : 0 < ε / 4)).exists
  let z := a - aN N
  let S : ℝ := ∑ i : Fin N, ‖a i‖
  have hS : 0 ≤ S := Finset.sum_nonneg (fun _ _ => norm_nonneg _)
  let η := ε / (2 * (S + 1))
  have hη : 0 < η := div_pos hε (mul_pos (by norm_num) (by linarith))
  obtain ⟨B, hB⟩ := bounded_coordinates_finite_net
    (fun b : A => fun i : Fin N => (t b).1 i) (fun b i => by
      obtain ⟨c, hc, hct⟩ := (t b).2
      rw [← hct]
      exact (lp.norm_apply_le_norm (ne_of_gt (zero_lt_one.trans_le (conjugate p).2)) c i).trans hc)
    η hη
  have hBne : B.Nonempty := by
    obtain ⟨b, hb, _⟩ := hB ⟨hA.some, hA.some_mem⟩
    exact ⟨b, hb⟩
  let C := B.image (fun b : A => (b : E))
  have hC : C.Nonempty := hBne.image _
  have hCA : (↑C : Set E) ⊆ A := by
    rintro _ hc
    obtain ⟨b, _, rfl⟩ := Finset.mem_image.mp hc
    exact b.2
  let U : Free p E := ∑ i : Fin N, |delta p (a i)|
  let W : HP p E := η • U.1 + (2 : ℝ) • lpSupport p hp z
  refine ⟨C, hC, hCA, W, ?_, ?_⟩
  · have hU : ‖U‖ ≤ S := by
      calc
        ‖U‖ ≤ ∑ i : Fin N, ‖|delta p (a i)|‖ := norm_sum_le _ _
        _ = S := by simp only [norm_abs_eq_norm, LinearIsometry.norm_map, S]
    have hηS : η * S < ε / 2 := by
      have heq : η * (S + 1) = ε / 2 := by dsimp [η]; field_simp
      nlinarith
    have hb := norm_add_le (η • U.1) ((2 : ℝ) • lpSupport p hp z)
    rw [norm_smul, norm_smul, Real.norm_eq_abs, abs_of_pos hη] at hb
    have hz := lpSupport_norm_le p hp z
    change ‖z‖ < ε / 4 at hN
    change ‖U.1‖ ≤ S at hU
    norm_num only [Real.norm_eq_abs, abs_of_pos (by norm_num : (0 : ℝ) < 2)] at hb
    exact hb.trans_lt (by nlinarith [mul_le_mul_of_nonneg_left hU hη.le])
  · intro φ
    have hW : W φ = η * (∑ i : Fin N, |φ (a i)|) + 2 * lpSupport p hp z φ := by
      have hU : U φ = ∑ i : Fin N, |φ (a i)| := by
        change freeEvaluation p φ (∑ i : Fin N, |delta p (a i)|) = _
        rw [map_sum]
        apply Finset.sum_congr rfl
        intro i _
        rw [VecLatHom.map_abs]
        rfl
      change η * U φ + 2 * lpSupport p hp z φ = _
      rw [hU]
    have hdec (b : A) : φ (b : E) =
        (∑ i : Fin N, (t b).1 i * φ (a i)) + φ (coefficientSeries p hp (t b) z) := by
      calc
        φ (b : E) = φ (coefficientSeries p hp (t b) (aN N + z)) := by
          rw [show aN N + z = a by dsimp [z]; abel, ht b]
        _ = _ := by
          simp only [map_add, aN, map_sum, coefficientSeries_single, map_smul, smul_eq_mul]
    have hclose (b c : A) (hbc : ∀ i : Fin N, |(t b).1 i - (t c).1 i| < η) :
        |φ (b : E) - φ (c : E)| ≤ W φ := by
      have hh : |(∑ i : Fin N, (t b).1 i * φ (a i)) -
          (∑ i : Fin N, (t c).1 i * φ (a i))| ≤ η * ∑ i : Fin N, |φ (a i)| := by
        rw [← Finset.sum_sub_distrib, Finset.mul_sum]
        apply (Finset.abs_sum_le_sum_abs _ _).trans
        apply Finset.sum_le_sum
        intro i _
        rw [← sub_mul, abs_mul]
        exact mul_le_mul_of_nonneg_right (hbc i).le (abs_nonneg _)
      have htb := coefficientSeries_eval_le p hp z (t b) φ
      have htc := coefficientSeries_eval_le p hp z (t c) φ
      rw [hdec b, hdec c, hW]
      have htri := abs_add_le
        ((∑ i : Fin N, (t b).1 i * φ (a i)) - (∑ i : Fin N, (t c).1 i * φ (a i)))
        (φ (coefficientSeries p hp (t b) z) - φ (coefficientSeries p hp (t c) z))
      have httri := abs_sub (φ (coefficientSeries p hp (t b) z))
        (φ (coefficientSeries p hp (t c) z))
      have heq : ((∑ i : Fin N, (t b).1 i * φ (a i)) + φ (coefficientSeries p hp (t b) z)) -
          ((∑ i : Fin N, (t c).1 i * φ (a i)) + φ (coefficientSeries p hp (t c) z)) =
          ((∑ i : Fin N, (t b).1 i * φ (a i)) - (∑ i : Fin N, (t c).1 i * φ (a i))) +
          (φ (coefficientSeries p hp (t b) z) - φ (coefficientSeries p hp (t c) z)) := by ring
      rw [heq]
      linarith
    have hAbounded : Bornology.IsBounded A :=
      (summable_disk_compact p _ (Or.inl ⟨hp, x, hx, rfl⟩)).2.2.isBounded.subset hAK
    have hbelow : fvlFunction (finiteSupport C) φ ≤ support A φ := by
      rw [finiteSupport_apply C hC]
      exact Finset.sup'_le _ _ (fun c hc => le_support A hAbounded φ (hCA hc))
    rw [abs_of_nonneg (sub_nonneg.mpr hbelow)]
    apply sub_le_iff_le_add.mpr
    apply csSup_le (hA.image _)
    rintro _ ⟨b, hb, rfl⟩
    obtain ⟨c, hc, hbc⟩ := hB ⟨b, hb⟩
    have hcC : (c : E) ∈ C := Finset.mem_image.mpr ⟨c, hc, rfl⟩
    have hfc : |φ (c : E)| ≤ fvlFunction (finiteSupport C) φ := by
      rw [finiteSupport_apply C hC]
      exact Finset.le_sup' (fun c => |φ c|) hcC
    have hd := hclose ⟨b, hb⟩ c hbc
    have htri := abs_sub_le (φ b) (φ (c : E)) 0
    simp only [sub_zero] at htri
    linarith

/-- Lemma 4.7 (`lem:subsets-summable-disk`): the support of a nonempty subset A of
a p-compact disk belongs to `Free p E` for finite p. It lies in the norm-closed
sublattice generated by evaluations at A and is the supremum and norm limit of
increasing finite-support functions with generators in A. -/
theorem subsets_summable_disk [CompleteSpace E] (p : Exponent) (hp : p.IsFinite) (A K : Set E)
    (hA : A.Nonempty) (hAK : A ⊆ K) (hK : IsPCompactDisk p K) :
    ∃ h : Free p E, (∀ φ, h φ = support A φ) ∧
      h ∈ (VectorSublattice.generated (delta p '' A)).topologicalClosure ∧
      ∃ B : ℕ → Finset E, Monotone B ∧
        (∀ n, (B n).Nonempty ∧ (↑(B n) : Set E) ⊆ A) ∧
        IsLUB (Set.range fun n => ofFVL p (finiteSupport (B n))) h ∧
        Tendsto (fun n => ofFVL p (finiteSupport (B n))) atTop (𝓝 h) := by
  classical
  have hcK := summable_disk_compact p K hK
  have hbA := hcK.2.2.isBounded.subset hAK
  have hmono (φ : Dual E) : support A φ ≤ support K φ := by
    apply csSup_le (hA.image _)
    rintro _ ⟨a, ha, rfl⟩
    exact le_support K hcK.2.2.isBounded φ (hAK ha)
  obtain ⟨H, hH⟩ := pCompact_support_inFree p K hK
  have hfinite : freeNormExt p (support A) < ⊤ := by
    apply lt_of_le_of_lt (b := freeNormExt p H)
    · apply freeNormExt_mono_abs
      intro φ
      have hnonneg : 0 ≤ support A φ := apply_nonneg (supportSeminorm A hA hbA) φ
      rw [abs_of_nonneg hnonneg]
      exact (hmono φ).trans (by rw [hH]; exact le_abs_self _)
    · rw [freeNormExt_eq_norm]
      exact ENNReal.ofReal_lt_top
  let G : HP p E := ⟨support A, (by
    intro c hc φ
    rw [support_smul, abs_of_nonneg hc]), hfinite⟩
  let ε : ℕ → ℝ := fun n => (1 / 2 : ℝ) ^ n
  have hε (n : ℕ) : 0 < ε n := by dsimp [ε]; positivity
  have hεlim : Tendsto ε atTop (𝓝 0) := summable_geometric_two.tendsto_atTop_zero
  choose C hC hCA W hW happrox using
    fun n => finite_subset_support_approx p hp A K hA hAK hK (ε n) (hε n)
  let B (n : ℕ) : Finset E := (Finset.range (n + 1)).biUnion C
  have hCB (n : ℕ) : C n ⊆ B n :=
    Finset.subset_biUnion_of_mem C (Finset.mem_range.mpr (Nat.lt_succ_self n))
  have hBm : Monotone B := fun n m hnm =>
    Finset.biUnion_subset_biUnion_of_subset_left C (Finset.range_mono (Nat.add_le_add_right hnm 1))
  have hBn (n : ℕ) : (B n).Nonempty := (hC n).mono (hCB n)
  have hBA (n : ℕ) : (↑(B n) : Set E) ⊆ A := by
    intro a ha
    obtain ⟨i, _, hi⟩ := Finset.mem_biUnion.mp ha
    exact hCA i hi
  let V (n : ℕ) : Free p E := ofFVL p (finiteSupport (B n))
  have hVle (n : ℕ) (φ : Dual E) : V n φ ≤ support A φ := by
    change fvlFunction (finiteSupport (B n)) φ ≤ _
    rw [finiteSupport_apply _ (hBn n)]
    exact Finset.sup'_le _ _ (fun b hb => le_support A hbA φ (hBA n hb))
  have hVm : Monotone V := by
    intro n m hnm
    apply (free_le_iff p _ _).mpr
    intro φ
    change fvlFunction (finiteSupport (B n)) φ ≤ fvlFunction (finiteSupport (B m)) φ
    rw [finiteSupport_apply _ (hBn n), finiteSupport_apply _ (hBn m)]
    exact Finset.sup'_le _ _ (fun b hb => Finset.le_sup' (fun b => |φ b|) (hBm hnm hb))
  have hnorm (n : ℕ) : ‖G - (V n).1‖ < ε n := by
    apply lt_of_le_of_lt (b := ‖W n‖) ?_ (hW n)
    apply HasSolidNorm.solid
    intro φ
    change |support A φ - V n φ| ≤ |W n φ|
    rw [abs_of_nonneg (sub_nonneg.mpr (hVle n φ))]
    have hCV : fvlFunction (finiteSupport (C n)) φ ≤ V n φ := by
      change fvlFunction (finiteSupport (C n)) φ ≤ fvlFunction (finiteSupport (B n)) φ
      rw [finiteSupport_apply _ (hC n), finiteSupport_apply _ (hBn n)]
      exact Finset.sup'_le _ _ (fun c hc => Finset.le_sup' (fun c => |φ c|) (hCB n hc))
    exact (sub_le_sub_left hCV _).trans ((le_abs_self _).trans
      ((happrox n φ).trans (le_abs_self _)))
  have hlim : Tendsto (fun n => (V n).1) atTop (𝓝 G) := by
    apply tendsto_iff_norm_sub_tendsto_zero.mpr
    apply squeeze_zero (fun n => norm_nonneg _) (fun n => ?_) hεlim
    simpa only [norm_sub_rev] using (hnorm n).le
  have hG : G ∈ freeSublattice p E :=
    (VectorSublattice.isClosed_topologicalClosure _).mem_of_tendsto hlim
      (Eventually.of_forall (fun n => (V n).2))
  let g : Free p E := ⟨G, hG⟩
  have hVlim : Tendsto V atTop (𝓝 g) := tendsto_subtype_rng.mpr hlim
  let L := VectorSublattice.generated (delta p '' A)
  have hVL (n : ℕ) : V n ∈ L := by
    dsimp [V]
    rw [finiteSupport, dite_eq_left (hBn n), map_finset_sup']
    apply Finset.sup'_mem (L : Set (Free p E)) (fun _ ha _ hb => L.sup_mem ha hb)
    intro a ha
    change ofFVL p |FVLv.of a| ∈ L
    rw [VecLatHom.map_abs, ofFVL_of]
    apply L.abs_mem
    exact VectorSublattice.subset_generated _ (Set.mem_image_of_mem _ (hBA n ha))
  refine ⟨g, fun _ => rfl, ?_, B, hBm, fun n => ⟨hBn n, hBA n⟩, ?_, hVlim⟩
  · exact (VectorSublattice.isClosed_topologicalClosure L).mem_of_tendsto hVlim
      (Eventually.of_forall (fun n => L.le_topologicalClosure (hVL n)))
  · refine ⟨?_, ?_⟩
    · rintro _ ⟨n, rfl⟩
      exact (free_le_iff p _ _).mpr (hVle n)
    · intro u hu
      exact le_of_tendsto hVlim (Eventually.of_forall (fun n => hu (Set.mem_range_self n)))

private theorem seminorm_bound_of_unit_ball {V : Type*} [AddCommGroup V] [Module ℝ V]
    (q r : Seminorm ℝ V) (C : ℝ) (hC : 0 < C)
    (hbound : ∀ v, q v < 1 → r v ≤ C) (v : V) : r v ≤ C * q v := by
  apply le_of_forall_pos_le_add
  intro ε hε
  let t := q v + ε / C
  have ht : 0 < t := add_pos_of_nonneg_of_pos (apply_nonneg q v) (div_pos hε hC)
  have hb := hbound (t⁻¹ • v) (by
    rw [map_smul_eq_mul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr ht)]
    exact (inv_mul_lt_one₀ ht).mpr (lt_add_of_pos_right _ (div_pos hε hC)))
  rw [map_smul_eq_mul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr ht)] at hb
  have hmul := mul_le_mul_of_nonneg_left hb ht.le
  rw [← mul_assoc, mul_inv_cancel₀ ht.ne', one_mul] at hmul
  refine hmul.trans_eq ?_
  dsimp [t]
  field_simp

private theorem compact_submodule_section (M : Submodule ℝ E) (hM : IsClosed (M : Set E))
    (K : Set E) (hne : K.Nonempty) (ha : AbsConvex ℝ K) (hk : IsCompact K) :
    {x : M | (x : E) ∈ K}.Nonempty ∧ IsCompact {x : M | (x : E) ∈ K} := by
  have hzero : (0 : E) ∈ K := by
    simpa only [zero_smul] using ha.1.smul_mem (a := (0 : ℝ)) (by simp) hne.some_mem
  refine ⟨⟨0, hzero⟩, Topology.IsEmbedding.subtypeVal.isCompact_iff.mpr ?_⟩
  have heq : ((↑) : M → E) '' {x : M | (x : E) ∈ K} = K ∩ (M : Set E) := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩; exact ⟨hy, y.2⟩
    · rintro ⟨hx, hm⟩; exact ⟨⟨x, hm⟩, hx, rfl⟩
  rw [heq]
  exact hk.inter_right hM

private theorem compact_support_extension_approx (M : Submodule ℝ E)
    (hM : IsClosed (M : Set E)) (K : Set E) (hne : K.Nonempty)
    (ha : AbsConvex ℝ K) (hk : IsCompact K) (ψ : Dual M) (r : ℝ)
    (hr : support {x : M | (x : E) ∈ K} ψ < r) :
    ∃ φ : Dual E, φ.comp M.subtypeL = ψ ∧ support K φ ≤ r := by
  let S : Set M := {x | (x : E) ∈ K}
  obtain ⟨hSne, hSc⟩ := compact_submodule_section M hM K hne ha hk
  have hr0 : 0 < r := (apply_nonneg (supportSeminorm S hSne hSc.isBounded) ψ).trans_lt hr
  obtain ⟨θ, hθ, _⟩ := exists_extension_norm_eq M ψ
  let U : Set E := {x | |θ x| < r} ∪ (M : Set E)ᶜ
  have hU : IsOpen U := (isOpen_lt θ.continuous.abs continuous_const).union hM.isOpen_compl
  have hKU : K ⊆ U := by
    intro x hx
    by_cases hm : x ∈ M
    · left
      change |θ x| < r
      rw [show θ x = ψ (⟨x, hm⟩ : M) from hθ ⟨x, hm⟩]
      exact (le_support S hSc.isBounded ψ hx).trans_lt hr
    · exact Or.inr hm
  obtain ⟨δ, hδ, hδU⟩ := hk.exists_thickening_subset_open hU hKU
  let A := K + Metric.ball (0 : E) δ
  have hzero : (0 : E) ∈ K := by
    simpa only [zero_smul] using ha.1.smul_mem (a := (0 : ℝ)) (by simp) hne.some_mem
  have hball : Metric.ball (0 : E) δ ⊆ A := fun x hx => ⟨0, hzero, x, hx, zero_add x⟩
  have hAneigh : A ∈ 𝓝 (0 : E) := mem_of_superset (Metric.ball_mem_nhds _ hδ) hball
  have hA : AbsConvex ℝ A := ⟨ha.1.add balanced_ball_zero, ha.2.add (convex_ball _ _)⟩
  have hA0 : (0 : E) ∈ A := hball (by simpa using hδ)
  have hAabs : Absorbent ℝ A := absorbent_nhds_zero hAneigh
  let q : Seminorm ℝ E := gaugeSeminorm hA.1 hA.2 hAabs
  have hunit (m : M) (hm : (q.comp M.subtype) m < 1) : ψ.toSeminorm m ≤ r := by
    have hmA : (m : E) ∈ A := setOfPred_gauge_lt_one_subset_self hA.2 hA0 hAabs hm
    obtain ⟨k, hk, b, hb, heq⟩ := hmA
    have hnear : (m : E) ∈ Metric.thickening δ K := by
      apply Metric.mem_thickening_iff.mpr
      refine ⟨k, hk, ?_⟩
      rw [← heq, dist_eq_norm, add_sub_cancel_left]
      simpa only [Metric.mem_ball, dist_zero_right] using hb
    have hu : |θ m| < r := (hδU hnear).resolve_right (by exact not_not.mpr m.2)
    rw [hθ m] at hu
    exact hu.le
  have hψ := seminorm_bound_of_unit_ball (q.comp M.subtype) ψ.toSeminorm r hr0 hunit
  let cr : ℝ≥0 := ⟨r, hr0.le⟩
  let rq : Seminorm ℝ E := cr • q
  have hrqc : Continuous rq := by
    exact (continuous_gauge hA.2 hAneigh).const_smul cr
  obtain ⟨φ, hφ, hφbound⟩ := Module.Dual.exists_continuous_extension_of_le_seminorm_real
    M ψ.toLinearMap (p := rq) hrqc (fun m => (le_abs_self (ψ m)).trans (hψ m))
  refine ⟨φ, ContinuousLinearMap.ext hφ, ?_⟩
  apply csSup_le (hne.image _)
  rintro _ ⟨x, hx, rfl⟩
  have hxA : x ∈ A := ⟨x, hx, 0, by simpa using hδ, add_zero x⟩
  have hq : q x ≤ 1 := gauge_le_one_of_mem hxA
  exact (hφbound x).trans (mul_le_of_le_one_right hr0.le hq)

/-- Lemma 4.8 (`lem:restriction-polar`): the norm closure of restrictions to a closed
subspace M of the strict polar of K equals the closed polar of the section K ∩ M.
Here K is nonempty, absolutely convex, and compact; the section and its support
are formed in M’s own normed-space type. -/
theorem restriction_polar (M : Submodule ℝ E)
    (hM : IsClosed (M : Set E)) (K : Set E) (hne : K.Nonempty)
    (ha : AbsConvex ℝ K) (hk : IsCompact K) :
    closure ((fun φ : Dual E => φ.comp M.subtypeL) '' {φ | support K φ < 1}) =
      {ψ : Dual M | support {x : M | (x : E) ∈ K} ψ ≤ 1} := by
  let S : Set M := {x | (x : E) ∈ K}
  obtain ⟨hSne, hSc⟩ := compact_submodule_section M hM K hne ha hk
  apply Set.Subset.antisymm
  · apply closure_minimal ?_
      (isClosed_le (support_continuous S hSne hSc.isBounded) continuous_const)
    rintro _ ⟨φ, hφ, rfl⟩
    change support S (φ.comp M.subtypeL) ≤ 1
    apply csSup_le (hSne.image _)
    rintro _ ⟨x, hx, rfl⟩
    exact (le_support K hk.isBounded φ hx).trans hφ.le
  · intro ψ hψ
    let a : ℕ → ℝ := fun n => (1 / 2 : ℝ) ^ n
    have ha0 (n : ℕ) : 0 < a n := by dsimp [a]; positivity
    have halim : Tendsto a atTop (𝓝 0) := summable_geometric_two.tendsto_atTop_zero
    have htlim : Tendsto (fun n => 1 + a n) atTop (𝓝 1) := by
      simpa only [add_zero] using tendsto_const_nhds.add halim
    have hψlim : Tendsto (fun n => (1 + a n)⁻¹ • ψ) atTop (𝓝 ψ) := by
      simpa only [inv_one, one_smul] using (htlim.inv₀ one_ne_zero).smul
        (tendsto_const_nhds : Tendsto (fun _ : ℕ => ψ) atTop (𝓝 ψ))
    apply isClosed_closure.mem_of_tendsto hψlim
    apply Filter.Eventually.of_forall
    intro n
    apply subset_closure
    obtain ⟨φ, hφ, hcost⟩ := compact_support_extension_approx M hM K hne ha hk ψ
      (1 + a n / 2) (by change support S ψ < _; exact lt_of_le_of_lt hψ (by linarith [ha0 n]))
    refine ⟨(1 + a n)⁻¹ • φ, ?_, ?_⟩
    · change support K ((1 + a n)⁻¹ • φ) < 1
      have ht : 0 < 1 + a n := by linarith [ha0 n]
      rw [support_smul, abs_of_pos (inv_pos.mpr ht)]
      apply (inv_mul_lt_one₀ ht).mpr
      exact hcost.trans_lt (by linarith [ha0 n])
    · ext x
      have heq := DFunLike.congr_fun hφ x
      change (1 + a n)⁻¹ * φ x = (1 + a n)⁻¹ * ψ x
      rw [show φ x = ψ x from heq]

/-- Equation `eq:finite-support-extension`: the support cost of a functional on
K ∩ M is the infimum of the costs of its continuous extensions to E. The paper uses
finite-dimensional disks; that hypothesis is retained, although the proof via
`compact_support_extension_approx` works for any nonempty absolutely convex compact K. -/
theorem finite_support_extension (M : Submodule ℝ E)
    (hM : IsClosed (M : Set E)) (K : Set E) (hne : K.Nonempty)
    (ha : AbsConvex ℝ K) (hk : IsCompact K)
    (_hfd : FiniteDimensional ℝ (Submodule.span ℝ K)) (ψ : Dual M) :
    support {x : M | (x : E) ∈ K} ψ =
      sInf {r | ∃ φ : Dual E, φ.comp M.subtypeL = ψ ∧ r = support K φ} := by
  let S : Set M := {x | (x : E) ∈ K}
  obtain ⟨hSne, hSc⟩ := compact_submodule_section M hM K hne ha hk
  have hneCost : {r | ∃ φ : Dual E, φ.comp M.subtypeL = ψ ∧ r = support K φ}.Nonempty := by
    obtain ⟨φ, hφ, _⟩ := compact_support_extension_approx M hM K hne ha hk ψ
      (support S ψ + 1) (lt_add_one _)
    exact ⟨_, φ, hφ, rfl⟩
  have hbelow : BddBelow {r | ∃ φ : Dual E, φ.comp M.subtypeL = ψ ∧ r = support K φ} := by
    refine ⟨0, ?_⟩
    rintro _ ⟨φ, _, rfl⟩
    exact apply_nonneg (supportSeminorm K hne hk.isBounded) φ
  apply le_antisymm
  · apply le_csInf hneCost
    rintro _ ⟨φ, hφ, rfl⟩
    apply csSup_le (hSne.image _)
    rintro _ ⟨x, hx, rfl⟩
    have heq : φ x = ψ x := DFunLike.congr_fun hφ x
    change |ψ x| ≤ support K φ
    rw [← heq]
    exact le_support K hk.isBounded φ hx
  · apply le_of_forall_pos_le_add
    intro ε hε
    obtain ⟨φ, hφ, hb⟩ := compact_support_extension_approx M hM K hne ha hk ψ
      (support S ψ + ε) (lt_add_of_pos_right _ hε)
    exact (csInf_le hbelow ⟨φ, hφ, rfl⟩).trans hb

private theorem outer_polytope_proof (K : Set E) (hne : K.Nonempty)
    (ha : AbsConvex ℝ K) (hk : IsCompact K)
    (hfd : FiniteDimensional ℝ (Submodule.span ℝ K)) (θ : ℝ) (hθ : 0 < θ) :
    ∃ A : Finset E, K ⊆ absConvexHull ℝ (A : Set E) ∧
      absConvexHull ℝ (A : Set E) ⊆ (1 + θ) • K := by
  classical
  let M := Submodule.span ℝ K
  let : FiniteDimensional ℝ M := hfd
  let S : Set M := {x | (x : E) ∈ K}
  have hSimage : M.subtype '' S = K := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩; exact hy
    · intro hx
      exact ⟨⟨x, Submodule.subset_span hx⟩, hx, rfl⟩
  have hScompact : IsCompact S := Topology.IsEmbedding.subtypeVal.isCompact_iff.mpr (by
    change IsCompact (M.subtype '' S)
    rw [hSimage]
    exact hk)
  have hS : AbsConvex ℝ S := by
    constructor
    · rw [balanced_iff_smul_mem]
      intro c hc x hx
      exact ha.1.smul_mem hc hx
    · intro x hx y hy a b ha' hb hab
      exact ha.2 hx hy ha' hb hab
  have hzeroK : (0 : E) ∈ K := by
    simpa only [zero_smul] using ha.1.smul_mem (a := (0 : ℝ)) (by simp) hne.some_mem
  have hzero : (0 : M) ∈ S := hzeroK
  have hspan : Submodule.span ℝ S = ⊤ := by
    apply Submodule.map_injective_of_injective M.injective_subtype
    rw [Submodule.map_span, hSimage, Submodule.map_top, Submodule.range_subtype]
  have haff : affineSpan ℝ S = ⊤ := by
    apply SetLike.coe_injective
    calc
      (affineSpan ℝ S : Set M) = (affineSpan ℝ (insert 0 S) : Set M) := by
        rw [insert_eq_of_mem hzero]
      _ = (Submodule.span ℝ S : Set M) :=
        congrArg (fun A : AffineSubspace ℝ M => (A : Set M)) (affineSpan_insert_zero S)
      _ = (⊤ : AffineSubspace ℝ M) := by rw [hspan]; rfl
  obtain ⟨a, haint⟩ := hS.2.interior_nonempty_iff_affineSpan_eq_top.mpr haff
  have h0int : (0 : M) ∈ interior S := by
    have h := hS.2.combo_interior_self_mem_interior haint
      (hS.1.neg_mem_iff.mpr (interior_subset haint))
      (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num)
    simpa only [smul_neg, add_neg_cancel] using h
  have ht : 0 < 1 + θ := by linarith
  have hti : (1 + θ)⁻¹ < 1 := (inv_lt_one₀ ht).mpr (by linarith)
  have hnbhd : (1 + θ) • S ∈ 𝓝ˢ S := by
    apply subset_interior_iff_mem_nhdsSet.mp
    intro x hx
    rw [interior_smul₀ ht.ne']
    refine ⟨(1 + θ)⁻¹ • x, ?_, smul_inv_smul₀ ht.ne' x⟩
    have h := hS.2.combo_interior_self_mem_interior h0int hx
      (sub_pos.mpr hti) (inv_nonneg.mpr ht.le) (sub_add_cancel 1 ((1 + θ)⁻¹))
    simpa only [smul_zero, zero_add] using h
  obtain ⟨B, hB, hBbound⟩ :=
    hS.2.exists_subset_interior_convexHull_finset_of_isCompact hScompact hnbhd
  refine ⟨B.image M.subtype, ?_, ?_⟩
  · intro x hx
    let y : M := ⟨x, Submodule.subset_span hx⟩
    have hy : y ∈ convexHull ℝ (B : Set M) := interior_subset (hB hx)
    have himage : M.subtype '' convexHull ℝ (B : Set M) =
        convexHull ℝ (M.subtype '' (B : Set M)) := by
      exact M.subtype.image_convexHull (B : Set M)
    have hymem : x ∈ convexHull ℝ (↑(B.image M.subtype) : Set E) := by
      rw [Finset.coe_image, ← himage]
      exact ⟨y, hy, rfl⟩
    exact convexHull_min subset_absConvexHull convex_absConvexHull hymem
  · apply absConvexHull_min
    · rintro x hx
      obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨z, hz, hzy⟩ := hBbound (subset_convexHull ℝ (B : Set M) hy)
      exact ⟨(z : E), hz, congrArg Subtype.val hzy⟩
    · exact ⟨ha.1.smul _, ha.2.smul _⟩

/-- The finite-dimensional outer polytope approximation used in Lemma 4.10. -/
theorem outer_polytope_approximation (K : Set E) (hne : K.Nonempty)
    (ha : AbsConvex ℝ K) (hk : IsCompact K)
    (hfd : FiniteDimensional ℝ (Submodule.span ℝ K)) (θ : ℝ) (hθ : 0 < θ) :
    ∃ A : Finset E, K ⊆ absConvexHull ℝ (A : Set E) ∧
      absConvexHull ℝ (A : Set E) ⊆ (1 + θ) • K :=
  outer_polytope_proof K hne ha hk hfd θ hθ

private theorem finite_support_image_norm_le (p : Exponent) (hp : p.IsFinite)
    (M : Submodule ℝ E) {n : ℕ} (x : Fin n → E) (K : Set E) (hKc : IsCompact K)
    (hsupport : ∀ φ, support K φ = scalarPSum p (fun i => φ (x i)))
    (L : Set M) (hLK : ∀ {a : M}, a ∈ L → (a : E) ∈ K)
    (A : Finset M) (hA : A.Nonempty) (t : ℝ) (ht : 0 < t)
    (hAL : absConvexHull ℝ (A : Set M) ⊆ t • L) :
    ‖induced p M.subtypeL (ofFVL p (finiteSupport A))‖ ≤
      t * scalarPSum p (fun i => ‖x i‖) := by
  let z : FVL E := FVLv.map M.subtype (finiteSupport A)
  have hz : ofFVL p z = induced p M.subtypeL (ofFVL p (finiteSupport A)) :=
    ofFVL_map p M.subtypeL (finiteSupport A)
  have hzbound (φ : Dual E) : |fvlFunction z φ| ≤
      scalarPSum p (fun i => φ (t • x i)) := by
    have hzeq : fvlFunction z φ = fvlFunction (finiteSupport A) (φ.comp M.subtypeL) := by
      change ofFVL p z φ = ofFVL p (finiteSupport A) (φ.comp M.subtypeL)
      rw [hz, canonical_map_formulas]
    rw [hzeq, finiteSupport_apply A hA]
    have hnonneg : 0 ≤ A.sup' hA (fun a => |(φ.comp M.subtypeL) a|) :=
      (abs_nonneg _).trans (Finset.le_sup' (fun a => |(φ.comp M.subtypeL) a|) hA.choose_spec)
    rw [abs_of_nonneg hnonneg]
    simp only [map_smul, smul_eq_mul, scalarPSum_smul, abs_of_pos ht]
    apply Finset.sup'_le
    intro a ha
    obtain ⟨b, hb, heq⟩ := hAL (subset_absConvexHull ha)
    rw [← heq]
    change |(φ.comp M.subtypeL) (t • b)| ≤ _
    rw [map_smul, smul_eq_mul]
    change |t * φ (b : E)| ≤ _
    rw [abs_mul, abs_of_pos ht, ← hsupport φ]
    exact mul_le_mul_of_nonneg_left (le_support K hKc.isBounded φ (hLK hb)) ht.le
  have hnorm : ‖ofFVL p z‖ ≤ t * scalarPSum p (fun i => ‖x i‖) := by
    rw [majorant_norm p hp]
    apply csInf_le
    · refine ⟨0, ?_⟩
      rintro _ ⟨m, y, rfl, _⟩
      exact scalarPSum_nonneg ..
    · refine ⟨n, fun i => t • x i, ?_, hzbound⟩
      simp only [norm_smul, Real.norm_eq_abs, abs_of_pos ht, scalarPSum_smul]
  rw [← hz]
  exact hnorm

/-- Lemma 4.10 (`lem:finite-support-majorant`): every element of the free vector lattice
on a closed subspace M has a majorant that is a finite supremum of absolute evaluations
at points of M. After inclusion into the ambient free lattice, the majorant’s norm
is within any prescribed positive error of the original image norm. -/
theorem finite_support_majorant [CompleteSpace E] (p : Exponent) (hp : p.IsFinite)
    (M : Submodule ℝ E) (hM : IsClosed (M : Set E)) (v : FVL M)
    (η : ℝ) (hη : 0 < η) :
    ∃ A : Finset M, (∀ ψ, |fvlFunction v ψ| ≤ fvlFunction (finiteSupport A) ψ) ∧
      ‖induced p M.subtypeL (ofFVL p (finiteSupport A))‖ <
        ‖induced p M.subtypeL (ofFVL p v)‖ + η := by
  classical
  let w : FVL E := FVLv.map M.subtype v
  have hw : ofFVL p w = induced p M.subtypeL (ofFVL p v) := ofFVL_map p M.subtypeL v
  obtain ⟨r, ⟨n, x, rfl, hmajor⟩, hcost⟩ := exists_lt_of_csInf_lt
    (fvl_majorant_nonempty p hp w)
    (by rw [← majorant_norm p hp]; exact lt_add_of_pos_right ‖ofFVL p w‖ (half_pos hη))
  obtain ⟨K, hK, hKN, hsupport⟩ := finite_family_disk_in_span p hp x
  obtain ⟨hKne, hKa, hKc⟩ := summable_disk_compact p K hK
  let L : Set M := {m | (m : E) ∈ K}
  obtain ⟨hLne, hLc⟩ := compact_submodule_section M hM K hKne hKa hKc
  have hLa : AbsConvex ℝ L := by
    constructor
    · rw [balanced_iff_smul_mem]
      intro c hc m hm
      exact hKa.1.smul_mem hc hm
    · intro a ha b hb s t hs ht hst
      exact hKa.2 ha hb hs ht hst
  have hLfd : FiniteDimensional ℝ (Submodule.span ℝ L) := by
    let N := Submodule.span ℝ (Set.range x)
    let : FiniteDimensional ℝ N := FiniteDimensional.span_of_finite (K := ℝ) (Set.finite_range x)
    have hspan : Submodule.span ℝ L ≤ N.comap M.subtype :=
      Submodule.span_le.mpr (fun _ hm => hKN hm)
    let j : Submodule.span ℝ L →ₗ[ℝ] N :=
      LinearMap.codRestrict N (M.subtype.comp (Submodule.span ℝ L).subtype) (fun a => hspan a.2)
    apply FiniteDimensional.of_injective j
    intro a b hab
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun z : N => (z : E)) hab
  have hmajorL (ψ : Dual M) : |fvlFunction v ψ| ≤ support L ψ := by
    apply le_of_forall_pos_le_add
    intro ε hε
    obtain ⟨φ, hφ, hb⟩ := compact_support_extension_approx M hM K hKne hKa hKc ψ
      (support L ψ + ε) (lt_add_of_pos_right _ hε)
    have hv : fvlFunction w φ = fvlFunction v ψ := by
      change ofFVL p w φ = ofFVL p v ψ
      rw [hw, canonical_map_formulas, hφ]
    rw [← hv]
    exact (hmajor φ).trans ((hsupport φ).symm.le.trans hb)
  let C := scalarPSum p (fun i => ‖x i‖)
  have hC : 0 ≤ C := scalarPSum_nonneg ..
  let θ := η / (2 * (C + 1))
  have hθ : 0 < θ := div_pos hη (mul_pos (by norm_num) (by linarith))
  have ht : 0 < 1 + θ := by linarith
  have hθC : θ * C < η / 2 := by
    have heq : θ * (C + 1) = η / 2 := by
      dsimp [θ]
      field_simp
    nlinarith
  have hscaled : (1 + θ) * C < ‖ofFVL p w‖ + η := by
    change C < _ at hcost
    nlinarith
  obtain ⟨A, hLA, hAL⟩ := outer_polytope_approximation L hLne hLa hLc hLfd θ hθ
  have hA : A.Nonempty := by
    by_contra hn
    have he : A = ∅ := Finset.not_nonempty_iff_eq_empty.mp hn
    have hmem := hLA hLne.some_mem
    simp only [he, Finset.coe_empty, absConvexHull_empty, Set.mem_empty_iff_false] at hmem
  refine ⟨A, ?_, ?_⟩
  · intro ψ
    apply (hmajorL ψ).trans
    apply csSup_le (hLne.image _)
    rintro _ ⟨a, ha, rfl⟩
    apply absConvexHull_eval_bound (A : Set M) ψ _ ?_ a (hLA ha)
    intro b hb
    rw [finiteSupport_apply A hA]
    exact Finset.le_sup' (fun b => |ψ b|) hb
  · have hnorm := finite_support_image_norm_le p hp M x K hKc hsupport
      L (fun ha => ha) A hA (1 + θ) ht hAL
    rw [← hw]
    exact hnorm.trans_lt hscaled

/-- If the support of a compact set has infinite free p-norm, any free function
dominating its pointwise minimum with `|delta p e|` must dominate `|delta p e|` itself.
This forces the lower bounds in `compact_support_order_null` to be nonpositive.
Absolute convexity is retained from the paper’s disk setting but is not needed in this step. -/
theorem compact_support_upper_bound [CompleteSpace E] (p : Exponent) (hp : p.IsFinite)
    (K : Set E) (hne : K.Nonempty) (_ha : AbsConvex ℝ K) (hk : IsCompact K)
    (hinf : freeNormExt p (support K) = ⊤) (e : E) (g : Free p E)
    (hg : ∀ φ, min |φ e| (support K φ) ≤ g φ) : |delta p e| ≤ g := by
  apply (free_le_iff p _ _).mpr
  intro φ₀
  change |φ₀ e| ≤ g φ₀
  by_contra hn
  have hgap : 0 < (|φ₀ e| - g φ₀) / 4 := div_pos (sub_pos.mpr (lt_of_not_ge hn)) (by norm_num)
  let ε := (|φ₀ e| - g φ₀) / 4
  have hε : 0 < ε := hgap
  obtain ⟨L, hL, hlocal⟩ := summable_local_control p g φ₀ ε hgap
  obtain ⟨D, hD, hdom⟩ := pair_support_domination p hp L
    {y | ∃ t : ℝ, |t| ≤ 1 ∧ y = t • (ε⁻¹ • e)} hL
    (segment_pCompactDisk p (ε⁻¹ • e)).1
  have hcD := summable_disk_compact p D hD
  let q := supportSeminorm D hcD.1 hcD.2.2.isBounded
  let r := supportSeminorm K hne hk.isBounded
  have hnear (φ : Dual E) (hφ : support D (φ - φ₀) < 1) : support K φ ≤ g φ₀ + ε := by
    have hglocal := hlocal φ (((hdom _).1).trans_lt hφ)
    have heval := ((hdom (φ - φ₀)).2).trans_lt hφ
    rw [(segment_pCompactDisk p (ε⁻¹ • e)).2] at heval
    simp only [map_smul, smul_eq_mul, abs_mul, abs_of_pos (inv_pos.mpr hε), sub_apply] at heval
    have heval' : |φ e - φ₀ e| < ε := (inv_mul_lt_one₀ hε).mp heval
    have habs := abs_abs_sub_abs_le_abs_sub (φ e) (φ₀ e)
    have hstrict : g φ < |φ e| := by
      have hgupper := (abs_lt.mp hglocal).2
      have helower := (abs_le.mp habs).1
      dsimp [ε] at hgupper heval'
      linarith
    have hkbound : support K φ ≤ g φ := by
      exact (min_le_iff.mp (hg φ)).resolve_left hstrict.not_ge
    exact hkbound.trans (by linarith [(abs_lt.mp hglocal).2])
  let C := |g φ₀| + ε + support K φ₀ + 1
  have hC : 0 < C := by
    have hs : 0 ≤ support K φ₀ := apply_nonneg r φ₀
    dsimp [C]
    positivity
  have hunit (ψ : Dual E) (hψ : q ψ < 1) : r ψ ≤ C := by
    change support D ψ < 1 at hψ
    have hb := hnear (ψ + φ₀) (by simpa only [add_sub_cancel_right] using hψ)
    have hsub := map_sub_le_add r (ψ + φ₀) φ₀
    change support K ((ψ + φ₀) - φ₀) ≤ support K (ψ + φ₀) + support K φ₀ at hsub
    rw [add_sub_cancel_right] at hsub
    change support K ψ ≤ C
    dsimp [C]
    linarith [le_abs_self (g φ₀)]
  have hglobal := seminorm_bound_of_unit_ball q r C hC hunit
  obtain ⟨h, hh⟩ := pCompact_support_inFree p D hD
  have hnorm : freeNormExt p (support K) ≤ freeNormExt p (C • h : Free p E) := by
    apply freeNormExt_mono_abs
    intro φ
    change |support K φ| ≤ |C * h φ|
    rw [abs_of_nonneg (show 0 ≤ support K φ from apply_nonneg r φ)]
    rw [hh]
    exact (hglobal φ).trans (le_abs_self _)
  rw [hinf, freeNormExt_eq_norm] at hnorm
  exact (ENNReal.ofReal_lt_top : ENNReal.ofReal ‖C • h‖ < ⊤).not_ge hnorm

/-- Lemma 4.11 (`lem:compact-support-order-null`): if an increasing sequence has
pointwise supremum equal to a compact support of infinite free p-norm, then the
positive parts `(|delta p e| - q n) ⊔ 0` decrease to zero. This gives the source-side
order-null sequence in the failure witnesses. The retained positivity hypothesis on
q records the paper’s approximation setting; monotonicity and the supremum suffice here. -/
theorem compact_support_order_null [CompleteSpace E] (p : Exponent) (hp : p.IsFinite)
    (K : Set E) (hne : K.Nonempty) (ha : AbsConvex ℝ K) (hk : IsCompact K)
    (hinf : freeNormExt p (support K) = ⊤) (q : ℕ → Free p E)
    (_hpos : ∀ n, 0 ≤ q n) (hmono : Monotone q)
    (hlim : ∀ φ, IsLUB (Set.range fun n => q n φ) (support K φ)) (e : E) :
    DecreasesToZero (fun n => (|delta p e| - q n) ⊔ 0) := by
  refine ⟨?_, ⟨?_, ?_⟩⟩
  · intro m n hmn
    exact sup_le_sup (sub_le_sub_left (hmono hmn) _) le_rfl
  · rintro _ ⟨n, rfl⟩
    exact le_sup_right
  · intro b hb
    let g := |delta p e| - b
    have hbound (φ : Dual E) : min |φ e| (support K φ) ≤ g φ := by
      have hn (n : ℕ) : min |φ e| (q n φ) ≤ g φ := by
        have h := (free_le_iff p _ _).mp (hb (Set.mem_range_self n)) φ
        change b φ ≤ max (|φ e| - q n φ) 0 at h
        change min |φ e| (q n φ) ≤ |φ e| - b φ
        by_cases hle : |φ e| ≤ q n φ
        · rw [min_eq_left hle, max_eq_right (sub_nonpos.mpr hle)] at *
          linarith
        · rw [min_eq_right (le_of_not_ge hle), max_eq_left (sub_nonneg.mpr (le_of_not_ge hle))] at *
          linarith
      apply le_of_forall_lt
      intro t ht
      obtain ⟨_, ⟨n, rfl⟩, hnt⟩ := (lt_isLUB_iff (hlim φ)).mp ((lt_min_iff.mp ht).2)
      exact (lt_min ((lt_min_iff.mp ht).1) hnt).trans_le (hn n)
    have hg := compact_support_upper_bound p hp K hne ha hk hinf e g hbound
    apply (free_le_iff p _ _).mpr
    intro φ
    have h := (free_le_iff p _ _).mp hg φ
    change |φ e| ≤ |φ e| - b φ at h
    change b φ ≤ 0
    linarith

/-- The Minkowski series disk used in Propositions 4.12 and 5.2. -/
def seriesDisk (K : ℕ → Set E) : Set E :=
  {x | ∃ z : ℕ → E, (∀ n, z n ∈ K n) ∧ HasSum z x}

/-- For compact absolutely convex disks bounded by a summable sequence of radii,
the set of convergent sums of one point from each disk is again nonempty, absolutely
convex, and compact. Its support is the sum of the individual supports. Used in
Propositions 4.12 and 5.2. The explicit nonnegativity of the radii is retained for
clarity; it also follows from nonemptiness and the norm bounds. -/
theorem seriesDisk_properties [CompleteSpace E] (K : ℕ → Set E) (c : ℕ → ℝ)
    (_hc : ∀ n, 0 ≤ c n) (hs : Summable c)
    (hK : ∀ n, (K n).Nonempty ∧ AbsConvex ℝ (K n) ∧ IsCompact (K n))
    (hb : ∀ n, ∀ x ∈ K n, ‖x‖ ≤ c n) :
    (seriesDisk K).Nonempty ∧ AbsConvex ℝ (seriesDisk K) ∧ IsCompact (seriesDisk K) ∧
      ∀ φ, support (seriesDisk K) φ = ∑' n, support (K n) φ := by
  have hsum (z : ℕ → E) (hz : ∀ n, z n ∈ K n) : Summable z :=
    Summable.of_norm (Summable.of_nonneg_of_le (fun n => norm_nonneg _) (fun n => hb n _ (hz n)) hs)
  have hne : (seriesDisk K).Nonempty := by
    choose z hz using fun n => (hK n).1
    exact ⟨∑' n, z n, z, hz, (hsum z hz).hasSum⟩
  have hac : AbsConvex ℝ (seriesDisk K) := by
    constructor
    · rw [balanced_iff_smul_mem]
      rintro a ha y ⟨z, hz, hzy⟩
      exact ⟨fun n => a • z n, fun n => (hK n).2.1.1.smul_mem ha (hz n), hzy.const_smul a⟩
    · rintro y ⟨z, hz, hzy⟩ y' ⟨z', hz', hzy'⟩ a b ha hb hab
      exact ⟨fun n => a • z n + b • z' n,
        fun n => (hK n).2.1.2 (hz n) (hz' n) ha hb hab,
        (hzy.const_smul a).add (hzy'.const_smul b)⟩
  have hcompact : IsCompact (seriesDisk K) := by
    let Z := ∀ n, K n
    let (n : ℕ) : CompactSpace (K n) := isCompact_iff_compactSpace.mp (hK n).2.2
    let S : Z → E := fun z => ∑' n, (z n : E)
    have hS : Continuous S := continuous_tsum
      (fun n => continuous_subtype_val.comp (continuous_apply n)) hs (fun n z => hb n _ (z n).2)
    have heq : seriesDisk K = Set.range S := by
      ext y
      constructor
      · rintro ⟨z, hz, hzy⟩
        exact ⟨fun n => ⟨z n, hz n⟩, hzy.tsum_eq⟩
      · rintro ⟨z, rfl⟩
        exact ⟨fun n => (z n : E), fun n => (z n).2, (hsum _ (fun n => (z n).2)).hasSum⟩
    rw [heq]
    exact isCompact_range hS
  refine ⟨hne, hac, hcompact, ?_⟩
  intro φ
  have hsupport_nonneg (n : ℕ) : 0 ≤ support (K n) φ :=
    apply_nonneg (supportSeminorm _ (hK n).1 (hK n).2.2.isBounded) φ
  have hsupport_bound (n : ℕ) : support (K n) φ ≤ ‖φ‖ * c n := by
    apply csSup_le ((hK n).1.image _)
    rintro _ ⟨x, hx, rfl⟩
    exact (φ.le_opNorm x).trans (mul_le_mul_of_nonneg_left (hb n x hx) (norm_nonneg _))
  have hsupp : Summable (fun n => support (K n) φ) :=
    Summable.of_nonneg_of_le hsupport_nonneg hsupport_bound (hs.mul_left ‖φ‖)
  apply le_antisymm
  · apply csSup_le (hne.image _)
    rintro _ ⟨y, ⟨z, hz, hzy⟩, rfl⟩
    have hnorm : Summable (fun n => ‖φ (z n)‖) :=
      Summable.of_nonneg_of_le (fun _ => norm_nonneg _)
        (fun n => le_support (K n) (hK n).2.2.isBounded φ (hz n)) hsupp
    have hφsum := φ.hasSum hzy
    change |φ y| ≤ _
    rw [← hφsum.tsum_eq]
    calc
      _ ≤ ∑' n, ‖φ (z n)‖ := norm_tsum_le_tsum_norm hnorm
      _ ≤ ∑' n, support (K n) φ := hnorm.tsum_le_tsum
        (fun n => le_support (K n) (hK n).2.2.isBounded φ (hz n)) hsupp
  · have hmax (n : ℕ) : ∃ z ∈ K n, φ z = support (K n) φ := by
      obtain ⟨x, hx, hmax⟩ := (hK n).2.2.exists_isMaxOn (hK n).1 φ.continuous.abs.continuousOn
      have heq : support (K n) φ = |φ x| := by
        apply le_antisymm
        · apply csSup_le ((hK n).1.image _)
          rintro _ ⟨y, hy, rfl⟩
          exact hmax hy
        · exact le_support (K n) (hK n).2.2.isBounded φ hx
      by_cases hφx : 0 ≤ φ x
      · exact ⟨x, hx, by rw [heq, abs_of_nonneg hφx]⟩
      · exact ⟨-x, (hK n).2.1.1.neg_mem_iff.mpr hx, by
          rw [map_neg, heq, abs_of_neg (lt_of_not_ge hφx)]⟩
    choose z hz hzval using hmax
    have hzmem : (∑' n, z n) ∈ seriesDisk K := ⟨z, hz, (hsum z hz).hasSum⟩
    have hφsum := φ.hasSum (hsum z hz).hasSum
    have hval : φ (∑' n, z n) = ∑' n, support (K n) φ := by
      rw [← hφsum.tsum_eq]
      exact tsum_congr hzval
    have hb := le_support (seriesDisk K) hcompact.isBounded φ hzmem
    rw [hval, abs_of_nonneg (tsum_nonneg hsupport_nonneg)] at hb
    exact hb

/-- Section 2: bounded weak-star continuity for every parameter. -/
theorem free_boundedWeakStar_continuous (p : Exponent) (f : Free p E) :
    @Continuous (Dual E) ℝ (boundedWeakStar E) inferInstance f := by
  let : TopologicalSpace (Dual E) := boundedWeakStar E
  rw [continuous_iff_continuousAt]
  intro φ₀
  rw [ContinuousAt, Metric.tendsto_nhds]
  intro ε hε
  obtain ⟨K, hne, hK, hbound⟩ := compact_local_control p f φ₀ ε hε
  have hopen := support_ball_open {K : Set E | K.Nonempty ∧ IsCompact K}
    K ⟨hne, hK⟩ φ₀ 1 zero_lt_one
  have hmem := hopen.mem_nhds (x := φ₀)
    (by simp only [mem_ofPred_eq, sub_self, support_zero]; norm_num)
  filter_upwards [hmem] with φ hφ
  simpa only [Real.dist_eq] using hbound φ hφ


end FBLOrderContinuousLH

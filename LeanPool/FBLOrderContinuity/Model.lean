/-!
# Concrete models of free p-convex Banach lattices

This module constructs the spaces from Sections 1 and 2 of `main_20_10_26.tex`.
`Exponent` ranges over `[1, ∞]`. Positively homogeneous functions on the continuous dual
carry the extended norm `freeNormExt`; its finite part is the Banach lattice `HP p E`.
The norm-closed sublattice generated by evaluations is `Free p E`.

The main interfaces are `delta` (the evaluation isometry), `ofFVL` (the dense algebraic
core), `induced` (composition with an adjoint), and `inclusion` (change of exponent).
`universal_property` gives the unique bounded lattice extension into a p-convex target.
`infinity_representation` identifies the endpoint with homogeneous functions continuous
on the weak-star dual unit ball. `banlat_fbl_identification` connects p = 1 to BanLat.

Order is pointwise, whereas the norm topology is specified by the free norm. The type
synonym `HP` keeps these topologies distinct. Scalar and lattice p-sums include the
empty family and the infinity endpoint.
-/

@[expose] public section

noncomputable section
open scoped BigOperators ENNReal NNReal Topology
open Filter Set
universe u v w

namespace FBLOrderContinuousLH

/-- Convexity parameters, including the endpoint infinity. -/
abbrev Exponent := {p : ℝ≥0∞ // 1 ≤ p}

namespace Exponent
/-- The exponent 1, giving the ordinary free Banach lattice. -/
def one : Exponent := ⟨1, le_rfl⟩
/-- The endpoint exponent ∞, whose free norm is the supremum on the dual unit ball. -/
def infinity : Exponent := ⟨⊤, le_top⟩
/-- The exponent 2, used for Euclidean admissibility and the Hilbert comparison. -/
def two : Exponent := ⟨2, by norm_num⟩
/-- The condition that a convexity exponent is strictly below ∞. Together with membership
in `Exponent`, it ensures that `p.1.toReal` is a real number at least one. -/
def IsFinite (p : Exponent) : Prop := p.1 < ⊤
instance (p : Exponent) : Fact (1 ≤ p.1) := ⟨p.2⟩
end Exponent

/-- The continuous real dual of E, equipped with its operator norm. Weak-star statements
use the corresponding `WeakDual` type explicitly. -/
abbrev Dual (E : Type u) [NormedAddCommGroup E] [NormedSpace ℝ E] := StrongDual ℝ E

variable {E : Type u} {F : Type v}
  [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- Positive homogeneity on the full dual: scaling an argument by any nonnegative real
scales the value by the same number. Including scalar zero forces the function to vanish at zero. -/
def PosHomogeneous (f : Dual E → ℝ) : Prop :=
  ∀ (a : ℝ), 0 ≤ a → ∀ φ, f (a • φ) = a * f φ

/-- Section 2: the vector lattice H[E], with pointwise operations. -/
def homogeneousSublattice (E : Type u) [NormedAddCommGroup E] [NormedSpace ℝ E] :
    VectorSublattice (Dual E → ℝ) where
  toSubmodule := {
    carrier := {f | PosHomogeneous f}
    zero_mem' := by simp [PosHomogeneous]
    add_mem' := by
      intro f g hf hg a ha φ
      simp only [Pi.add_apply, hf a ha φ, hg a ha φ, mul_add]
    smul_mem' := by
      intro c f hf a ha φ
      simp [Pi.smul_apply, hf a ha φ, mul_left_comm] }
  sup_mem' := by
    intro f g hf hg a ha φ
    simpa only [Pi.sup_apply, hf a ha φ, hg a ha φ] using
      (mul_max_of_nonneg (f φ) (g φ) ha).symm

/-- The real vector lattice of positively homogeneous functions on the full continuous
dual of E. Addition, scalar multiplication, and lattice operations are pointwise. -/
abbrev Homogeneous (E : Type u) [NormedAddCommGroup E] [NormedSpace ℝ E] : Type u :=
  homogeneousSublattice E

/-- The scalar finite p-sum; at infinity it is the finite maximum, with empty value zero. -/
def scalarPSum (p : Exponent) {n : ℕ} (a : Fin n → ℝ) : ℝ :=
  if p.1 = ⊤ then (Finset.univ.sup fun i => (⟨|a i|, abs_nonneg _⟩ : ℝ≥0) : ℝ≥0)
  else (∑ i, |a i| ^ p.1.toReal) ^ (1 / p.1.toReal)

/-- The scalar formula is Mathlib's finite `ℓᵖ` norm. -/
theorem scalarPSum_eq_piLp_norm (p : Exponent) {n : ℕ} (a : Fin n → ℝ) :
    scalarPSum p a = ‖WithLp.toLp p.1 a‖ := by
  by_cases h : p.1 = ⊤
  · rw [scalarPSum, ite_eq_left h, h]
    exact congrArg (fun r : ℝ≥0 => (r : ℝ)) (PiLp.nnnorm_toLp a).symm
  · have hp : 0 < p.1.toReal := ENNReal.toReal_pos_iff.mpr
      ⟨lt_of_lt_of_le zero_lt_one p.2, lt_top_iff_ne_top.mpr h⟩
    simp [scalarPSum, h, PiLp.norm_eq_sum hp]

/-- A finite scalar p-sum is nonnegative, including the empty family and p = ∞. -/
theorem scalarPSum_nonneg (p : Exponent) {n : ℕ} (a : Fin n → ℝ) :
    0 ≤ scalarPSum p a := by
  rw [scalarPSum_eq_piLp_norm]
  exact norm_nonneg _

/-- Minkowski inequality for finite scalar p-sums, valid also for the maximum norm. -/
theorem scalarPSum_add_le (p : Exponent) {n : ℕ} (a b : Fin n → ℝ) :
    scalarPSum p (fun i => a i + b i) ≤ scalarPSum p a + scalarPSum p b := by
  simp only [scalarPSum_eq_piLp_norm]
  exact norm_add_le (WithLp.toLp p.1 a) (WithLp.toLp p.1 b)

/-- Scaling a finite scalar family multiplies its p-sum by the absolute value of the scalar. -/
theorem scalarPSum_smul (p : Exponent) {n : ℕ} (c : ℝ) (a : Fin n → ℝ) :
    scalarPSum p (fun i => c * a i) = |c| * scalarPSum p a := by
  simp only [scalarPSum_eq_piLp_norm]
  exact norm_smul c (WithLp.toLp p.1 a)

/-- Coordinatewise domination in absolute value implies domination of scalar p-sums. -/
theorem scalarPSum_mono_abs (p : Exponent) {n : ℕ} (a b : Fin n → ℝ)
    (h : ∀ i, |a i| ≤ |b i|) : scalarPSum p a ≤ scalarPSum p b := by
  by_cases htop : p.1 = ⊤
  · simp only [scalarPSum, htop, ↓reduceIte]
    exact NNReal.coe_le_coe.mpr (Finset.sup_mono_fun (fun i _ => h i))
  · simp only [scalarPSum, htop, ↓reduceIte]
    apply Real.rpow_le_rpow
    · exact Finset.sum_nonneg fun i hi => Real.rpow_nonneg (abs_nonneg _) _
    · apply Finset.sum_le_sum
      intro i hi
      exact Real.rpow_le_rpow (abs_nonneg _) (h i) ENNReal.toReal_nonneg
    · exact one_div_nonneg.mpr ENNReal.toReal_nonneg

/-- Taking coordinatewise absolute values leaves the scalar p-sum unchanged. -/
theorem scalarPSum_abs (p : Exponent) {n : ℕ} (a : Fin n → ℝ) :
    scalarPSum p (fun i => |a i|) = scalarPSum p a := by
  by_cases htop : p.1 = ⊤ <;> simp [scalarPSum, htop]

/-- For every exponent, the p-sum of a singleton is the absolute value of its entry. -/
theorem scalarPSum_fin1 (p : Exponent) (r : ℝ) :
    scalarPSum p (fun _ : Fin 1 => r) = |r| := by
  rw [scalarPSum_eq_piLp_norm]
  have hsingle : (WithLp.toLp p.1 (fun _ : Fin 1 => r) :
      PiLp p.1 (fun _ : Fin 1 => ℝ)) = PiLp.single p.1 0 r := by
    ext i
    fin_cases i
    simp
  rw [hsingle, PiLp.norm_single, Real.norm_eq_abs]

private theorem scalarPSum_one_eq_sum {n : ℕ} (a : Fin n → ℝ) :
    scalarPSum Exponent.one a = ∑ i, |a i| := by
  simp [scalarPSum, Exponent.one]

/-- The scalar p-sum is continuous on a fixed finite product of real lines. This
provides the continuity needed for the homogeneous functional calculus. -/
theorem continuous_scalarPSum (p : Exponent) {n : ℕ} :
    Continuous (scalarPSum p : (Fin n → ℝ) → ℝ) := by
  convert (continuous_norm.comp
    (PiLp.continuous_toLp p.1 (fun _ : Fin n => ℝ))) using 1
  ext a
  exact scalarPSum_eq_piLp_norm p a

private theorem sum_rpow_le_rpow_sum {ι : Type*} (s : Finset ι) (f : ι → ℝ)
    (hf : ∀ i ∈ s, 0 ≤ f i) {r : ℝ} (hr : 1 ≤ r) :
    (∑ i ∈ s, f i ^ r) ≤ (∑ i ∈ s, f i) ^ r := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using Real.rpow_nonneg (le_refl (0 : ℝ)) r
  | @insert i s his ih =>
    have hfi : 0 ≤ f i := hf i (Finset.mem_insert_self ..)
    have hfs : ∀ j ∈ s, 0 ≤ f j := by
      intro j hj
      exact hf j (Finset.mem_insert_of_mem hj)
    rw [Finset.sum_insert his, Finset.sum_insert his]
    calc
      f i ^ r + ∑ j ∈ s, f j ^ r ≤ f i ^ r + (∑ j ∈ s, f j) ^ r := by
        gcongr
        exact ih hfs
      _ ≤ (f i + ∑ j ∈ s, f j) ^ r :=
        Real.add_rpow_le_rpow_add hfi (Finset.sum_nonneg hfs) hr

private theorem realPSum_mono {n : ℕ} {p q : ℝ} (hp : 0 < p) (hpq : p ≤ q)
    (a : Fin n → ℝ) :
    (∑ i, |a i| ^ q) ^ (1 / q) ≤ (∑ i, |a i| ^ p) ^ (1 / p) := by
  have hq : 0 < q := lt_of_lt_of_le hp hpq
  have hr : 1 ≤ q / p := (one_le_div hp).mpr hpq
  have hsum : (∑ i, (|a i| ^ p) ^ (q / p)) ≤
      (∑ i, |a i| ^ p) ^ (q / p) := by
    apply sum_rpow_le_rpow_sum Finset.univ (fun i => |a i| ^ p) (by
      intro i hi
      exact Real.rpow_nonneg (abs_nonneg _) _) hr
  have hsum_nonneg : 0 ≤ ∑ i, |a i| ^ p :=
    Finset.sum_nonneg fun i hi => Real.rpow_nonneg (abs_nonneg _) _
  have hsumleft_nonneg : 0 ≤ ∑ i, (|a i| ^ p) ^ (q / p) :=
    Finset.sum_nonneg fun i hi => Real.rpow_nonneg (Real.rpow_nonneg (abs_nonneg _) _) _
  calc
    (∑ i, |a i| ^ q) ^ (1 / q) =
        (∑ i, (|a i| ^ p) ^ (q / p)) ^ (1 / q) := by
      congr 1
      apply Finset.sum_congr rfl
      intro i hi
      rw [← Real.rpow_mul (abs_nonneg _)]
      congr 1
      field_simp
    _ ≤ ((∑ i, |a i| ^ p) ^ (q / p)) ^ (1 / q) :=
      Real.rpow_le_rpow hsumleft_nonneg hsum (one_div_nonneg.mpr hq.le)
    _ = (∑ i, |a i| ^ p) ^ (1 / p) := by
      rw [← Real.rpow_mul hsum_nonneg]
      congr 1
      field_simp

/-- Finite scalar p-sums decrease as the exponent increases. -/
theorem scalarPSum_mono_exponent {p q : Exponent} (hpq : p ≤ q) {n : ℕ}
    (a : Fin n → ℝ) : scalarPSum q a ≤ scalarPSum p a := by
  by_cases hn : n = 0
  · subst n
    have hzero (r : Exponent) : scalarPSum r a = 0 := by
      rw [scalarPSum_eq_piLp_norm]
      have hz : (WithLp.toLp r.1 a : PiLp r.1 (fun _ : Fin 0 => ℝ)) = 0 :=
        Subsingleton.elim _ _
      rw [hz, norm_zero]
    rw [hzero p, hzero q]
  have : Nonempty (Fin n) := ⟨⟨0, Nat.pos_of_ne_zero hn⟩⟩
  by_cases hq : q.1 = ⊤
  · rw [scalarPSum_eq_piLp_norm, scalarPSum_eq_piLp_norm, hq, PiLp.norm_eq_ciSup]
    refine ciSup_le fun i => ?_
    simpa only [Real.norm_eq_abs] using PiLp.norm_apply_le (WithLp.toLp p.1 a) i
  · have hp : p.1 ≠ ⊤ := by
      intro h
      have h' : q.1 = ⊤ := top_le_iff.mp (h ▸ hpq)
      exact hq h'
    have hpReal : 0 < p.1.toReal := ENNReal.toReal_pos_iff.mpr
      ⟨lt_of_lt_of_le zero_lt_one p.2, lt_top_iff_ne_top.mpr hp⟩
    have hpqReal : p.1.toReal ≤ q.1.toReal := ENNReal.toReal_mono hq hpq
    simpa [scalarPSum, hp, hq] using realPSum_mono hpReal hpqReal a

/-- A finite dual family has weak p-norm at most one if its evaluations have scalar
p-sum at most one on the closed unit ball of E. This is the admissibility condition in
equation (2.1), stated without a conditional supremum. -/
def NormAdmissible (p : Exponent) {n : ℕ} (φ : Fin n → Dual E) : Prop :=
  ∀ x : E, ‖x‖ ≤ 1 → scalarPSum p (fun i => φ i x) ≤ 1

/-- A dual family admissible at p remains admissible at every q ≥ p, since finite
scalar q-sums are bounded by the corresponding p-sums. -/
theorem normAdmissible_mono {p q : Exponent} (hpq : p ≤ q) {n : ℕ}
    (φ : Fin n → Dual E) (hφ : NormAdmissible p φ) : NormAdmissible q φ := by
  intro x hx
  exact (scalarPSum_mono_exponent hpq fun i => φ i x).trans (hφ x hx)

private theorem realPSum_mul_le {n : ℕ} {p q r : ℝ}
    (hpqr : p.HolderTriple q r) (a b : Fin n → ℝ) :
    (∑ i, |a i * b i| ^ r) ^ (1 / r) ≤
      (∑ i, |a i| ^ p) ^ (1 / p) * (∑ i, |b i| ^ q) ^ (1 / q) := by
  let A : Fin n → ℝ≥0 := fun i => ⟨|a i|, abs_nonneg _⟩
  let B : Fin n → ℝ≥0 := fun i => ⟨|b i|, abs_nonneg _⟩
  have h := NNReal.Lr_le_Lp_mul_Lq Finset.univ A B hpqr
  have hReal := NNReal.coe_le_coe.mpr h
  have hA (i : Fin n) : (A i : ℝ) = |a i| := rfl
  have hB (i : Fin n) : (B i : ℝ) = |b i| := rfl
  simpa only [NNReal.coe_mul, NNReal.coe_rpow, NNReal.coe_sum, hA, hB,
    abs_mul] using hReal

private theorem holderTriple_of_lt {p q : ℝ} (hp : 0 < p) (hpq : p < q) :
    q.HolderTriple (p * q / (q - p)) p := by
  have hq : 0 < q := lt_trans hp hpq
  have hdiff : 0 < q - p := sub_pos.mpr hpq
  have hr : 0 < p * q / (q - p) := by positivity
  refine ⟨?_, hq, hr⟩
  field_simp
  ring

private theorem normAdmissible_weighted {p q : Exponent} (hpq : p < q)
    (hp : p.IsFinite) (hq : q.IsFinite) {n : ℕ}
    (φ : Fin n → Dual E) (hφ : NormAdmissible q φ) (w : Fin n → ℝ)
    (hw : (∑ i, |w i| ^ (p.1.toReal * q.1.toReal /
        (q.1.toReal - p.1.toReal))) ^
        (1 / (p.1.toReal * q.1.toReal / (q.1.toReal - p.1.toReal))) ≤ 1) :
    NormAdmissible p (fun i => w i • φ i) := by
  have hpReal : 0 < p.1.toReal := ENNReal.toReal_pos_iff.mpr
    ⟨lt_of_lt_of_le zero_lt_one p.2, hp⟩
  have hpqReal : p.1.toReal < q.1.toReal :=
    (ENNReal.toReal_lt_toReal (ne_of_lt hp) (ne_of_lt hq)).mpr hpq
  let r : ℝ := p.1.toReal * q.1.toReal / (q.1.toReal - p.1.toReal)
  have hholder : q.1.toReal.HolderTriple r p.1.toReal :=
    holderTriple_of_lt hpReal hpqReal
  intro x hx
  have hqbound : (∑ i, |φ i x| ^ q.1.toReal) ^ (1 / q.1.toReal) ≤ 1 := by
    simpa [NormAdmissible, scalarPSum, ne_of_lt hq] using hφ x hx
  have hwnonneg : 0 ≤ (∑ i, |w i| ^ r) ^ (1 / r) := by
    apply Real.rpow_nonneg
    exact Finset.sum_nonneg fun i hi => Real.rpow_nonneg (abs_nonneg _) _
  have hmain := realPSum_mul_le hholder (fun i => φ i x) w
  change scalarPSum p (fun i => (w i • φ i) x) ≤ 1
  rw [scalarPSum, ite_eq_right (ne_of_lt hp)]
  have hpoint (i : Fin n) : (w i • φ i) x = w i * φ i x := rfl
  simp_rw [hpoint]
  calc
    (∑ i, |w i * φ i x| ^ p.1.toReal) ^ (1 / p.1.toReal) ≤
        (∑ i, |φ i x| ^ q.1.toReal) ^ (1 / q.1.toReal) *
          (∑ i, |w i| ^ r) ^ (1 / r) := by
      simpa only [mul_comm] using hmain
    _ ≤ 1 := by
      have hw' : (∑ i, |w i| ^ r) ^ (1 / r) ≤ 1 := hw
      calc
        _ ≤ 1 * (∑ i, |w i| ^ r) ^ (1 / r) :=
          mul_le_mul_of_nonneg_right hqbound hwnonneg
        _ ≤ 1 * 1 := mul_le_mul_of_nonneg_left hw' zero_le_one
        _ = 1 := one_mul _

private theorem realPSum_weighted_exists {n : ℕ} {p q : ℝ} (hp : 0 < p)
    (hpq : p < q) (a : Fin n → ℝ) :
    ∃ w : Fin n → ℝ,
      (∀ i, 0 ≤ w i) ∧
      (∑ i, |w i| ^ (p * q / (q - p))) ^ (1 / (p * q / (q - p))) ≤ 1 ∧
      (∑ i, |w i * a i| ^ p) ^ (1 / p) =
        (∑ i, |a i| ^ q) ^ (1 / q) := by
  let r : ℝ := p * q / (q - p)
  have hholder : q.HolderTriple r p := holderTriple_of_lt hp hpq
  let f : Fin n → ℝ≥0 := fun i => ⟨|a i| ^ p, Real.rpow_nonneg (abs_nonneg _) _⟩
  obtain ⟨g, hg, heq⟩ := (NNReal.isGreatest_Lp Finset.univ f
    hholder.holderConjugate_div_div).1
  let w : Fin n → ℝ := fun i => (g i : ℝ) ^ (1 / p)
  refine ⟨w, (fun i => Real.rpow_nonneg (NNReal.coe_nonneg _) _), ?_, ?_⟩
  · have hr : 0 < r := hholder.right_pos
    have hgle : (∑ i, (g i : ℝ) ^ (r / p)) ≤ 1 := by
      have h := NNReal.coe_le_coe.mpr hg
      simpa only [NNReal.coe_sum, NNReal.coe_rpow, NNReal.coe_one] using h
    have hterm (i : Fin n) : |w i| ^ r = (g i : ℝ) ^ (r / p) := by
      rw [abs_of_nonneg (Real.rpow_nonneg (NNReal.coe_nonneg _) _)]
      rw [← Real.rpow_mul (NNReal.coe_nonneg _)]
      congr 1
      field_simp
    change (∑ i, |w i| ^ r) ^ (1 / r) ≤ 1
    simp_rw [hterm]
    calc
      (∑ i, (g i : ℝ) ^ (r / p)) ^ (1 / r) ≤ 1 ^ (1 / r) :=
        Real.rpow_le_rpow
          (Finset.sum_nonneg fun i hi => Real.rpow_nonneg (NNReal.coe_nonneg _) _)
          hgle (one_div_nonneg.mpr hr.le)
      _ = 1 := by simp
  · have heqR : (∑ i, (f i : ℝ) * (g i : ℝ)) =
        (∑ i, (f i : ℝ) ^ (q / p)) ^ (1 / (q / p)) := by
      have h := congrArg (fun z : ℝ≥0 => (z : ℝ)) heq
      simpa only [NNReal.coe_sum, NNReal.coe_mul, NNReal.coe_rpow] using h
    have hweighted : (∑ i, |w i * a i| ^ p) =
        ∑ i, (f i : ℝ) * (g i : ℝ) := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [abs_mul, abs_of_nonneg (Real.rpow_nonneg (NNReal.coe_nonneg _) _)]
      rw [Real.mul_rpow (Real.rpow_nonneg (NNReal.coe_nonneg _) _) (abs_nonneg _)]
      rw [← Real.rpow_mul (NNReal.coe_nonneg _)]
      have hmul : 1 / p * p = 1 := by field_simp
      rw [hmul, Real.rpow_one]
      change (g i : ℝ) * |a i| ^ p = |a i| ^ p * (g i : ℝ)
      ring
    have hsum : (∑ i, (f i : ℝ) ^ (q / p)) = ∑ i, |a i| ^ q := by
      apply Finset.sum_congr rfl
      intro i hi
      change (|a i| ^ p) ^ (q / p) = _
      rw [← Real.rpow_mul (abs_nonneg _)]
      congr 1
      field_simp
    have hsum_nonneg : 0 ≤ ∑ i, (f i : ℝ) ^ (q / p) :=
      Finset.sum_nonneg fun i hi => Real.rpow_nonneg (NNReal.coe_nonneg _) _
    calc
      (∑ i, |w i * a i| ^ p) ^ (1 / p) =
          ((∑ i, (f i : ℝ) ^ (q / p)) ^ (1 / (q / p))) ^ (1 / p) := by
        rw [hweighted, heqR]
      _ = (∑ i, (f i : ℝ) ^ (q / p)) ^ (1 / q) := by
        rw [← Real.rpow_mul hsum_nonneg]
        congr 1
        field_simp
      _ = (∑ i, |a i| ^ q) ^ (1 / q) := by rw [hsum]

/-- Every dual functional of operator norm at most one is a singleton admissible
family at every exponent. -/
theorem normAdmissible_singleton (p : Exponent) (φ : Dual E) (hφ : ‖φ‖ ≤ 1) :
    NormAdmissible p (fun _ : Fin 1 => φ) := by
  intro x hx
  rw [scalarPSum_fin1]
  calc
    |φ x| = ‖φ x‖ := (Real.norm_eq_abs _).symm
    _ ≤ ‖φ‖ * ‖x‖ := φ.le_opNorm x
    _ ≤ 1 := by nlinarith [norm_nonneg φ, norm_nonneg x]

/-- The unit-ball condition in `NormAdmissible` scales to a bound at every x:
the p-sum of the family evaluated at x is at most the norm of x. -/
theorem normAdmissible_eval_le_norm (p : Exponent) {n : ℕ}
    (φ : Fin n → Dual E) (hφ : NormAdmissible p φ) (x : E) :
    scalarPSum p (fun i => φ i x) ≤ ‖x‖ := by
  by_cases hx : x = 0
  · subst x
    simp [scalarPSum_eq_piLp_norm]
    rfl
  · have hnormpos : 0 < ‖x‖ := norm_pos_iff.mpr hx
    have hunit : ‖‖x‖⁻¹ • x‖ ≤ 1 :=
      mem_closedBall_zero_iff.mp (inv_norm_smul_mem_unitClosedBall x)
    have hvalue := hφ (‖x‖⁻¹ • x) hunit
    have hfun : (fun i => φ i (‖x‖⁻¹ • x)) =
        (fun i => ‖x‖⁻¹ * φ i x) := by
      funext i
      simp
    rw [hfun, scalarPSum_smul, abs_of_pos (inv_pos.mpr hnormpos)] at hvalue
    calc
      scalarPSum p (fun i => φ i x) =
          ‖x‖ * (‖x‖⁻¹ * scalarPSum p (fun i => φ i x)) := by
        rw [← mul_assoc, mul_inv_cancel₀ hnormpos.ne', one_mul]
      _ ≤ ‖x‖ * 1 := mul_le_mul_of_nonneg_left hvalue (le_of_lt hnormpos)
      _ = ‖x‖ := mul_one _

private theorem normAdmissible_comp_scaled (p : Exponent) {n : ℕ}
    (T : F →L[ℝ] E) (hT : 0 < ‖T‖) (φ : Fin n → Dual E)
    (hφ : NormAdmissible p φ) :
    NormAdmissible p (fun i => ‖T‖⁻¹ • (φ i).comp T) := by
  intro x hx
  have hfun : (fun i => (‖T‖⁻¹ • (φ i).comp T) x) =
      (fun i => ‖T‖⁻¹ * φ i (T x)) := by
    funext i
    rfl
  rw [hfun, scalarPSum_smul, abs_of_pos (inv_pos.mpr hT)]
  have hadm := normAdmissible_eval_le_norm p φ hφ (T x)
  have hop := T.le_opNorm x
  have hle : ‖T x‖ ≤ ‖T‖ := by
    calc
      ‖T x‖ ≤ ‖T‖ * ‖x‖ := hop
      _ ≤ ‖T‖ * 1 := mul_le_mul_of_nonneg_left hx (norm_nonneg T)
      _ = ‖T‖ := mul_one _
  calc
    ‖T‖⁻¹ * scalarPSum p (fun i => φ i (T x)) ≤ ‖T‖⁻¹ * ‖T x‖ :=
      mul_le_mul_of_nonneg_left hadm (le_of_lt (inv_pos.mpr hT))
    _ ≤ ‖T‖⁻¹ * ‖T‖ := mul_le_mul_of_nonneg_left hle (le_of_lt (inv_pos.mpr hT))
    _ = 1 := inv_mul_cancel₀ hT.ne'

/-- The extended free p-norm of a real function on the full dual (equations (2.1)–(2.2)).
For finite p, take the supremum of scalar p-sums over all admissible finite dual families.
At ∞, take the supremum of absolute values on the dual unit ball. Values lie in `ℝ≥0∞`
so that functions outside the finite-norm model retain their infinite norm. -/
def freeNormExt (p : Exponent) (f : Dual E → ℝ) : ℝ≥0∞ :=
  if p.1 = ⊤ then ⨆ (φ : Dual E) (_ : ‖φ‖ ≤ 1), ENNReal.ofReal |f φ|
  else ⨆ (n : ℕ) (φ : Fin n → Dual E) (_ : NormAdmissible p φ),
    ENNReal.ofReal (scalarPSum p (fun i => f (φ i)))

/-- The extended free norm of evaluation at x is bounded by the norm of x.
The matching lower bound is supplied by Hahn–Banach in `freeNormExt_eval_eq`. -/
theorem freeNormExt_eval_le (p : Exponent) (x : E) :
    freeNormExt p (fun φ : Dual E => φ x) ≤ ENNReal.ofReal ‖x‖ := by
  by_cases htop : p.1 = ⊤
  · rw [freeNormExt, ite_eq_left htop]
    refine iSup_le fun φ => iSup_le fun hφ => ?_
    apply ENNReal.ofReal_le_ofReal
    calc
      |φ x| = ‖φ x‖ := (Real.norm_eq_abs _).symm
      _ ≤ ‖φ‖ * ‖x‖ := φ.le_opNorm x
      _ ≤ ‖x‖ := by nlinarith [norm_nonneg x]
  · rw [freeNormExt, ite_eq_right htop]
    refine iSup_le fun n => iSup_le fun φ => iSup_le fun hφ => ?_
    exact ENNReal.ofReal_le_ofReal (normAdmissible_eval_le_norm p φ hφ x)

/-- Evaluation at a dual functional in the unit ball is bounded by the extended
free norm, with no homogeneity or finiteness assumption on the function. -/
theorem ofReal_abs_le_freeNormExt (p : Exponent) (f : Dual E → ℝ)
    (φ : Dual E) (hφ : ‖φ‖ ≤ 1) :
    ENNReal.ofReal |f φ| ≤ freeNormExt p f := by
  by_cases htop : p.1 = ⊤
  · rw [freeNormExt, ite_eq_left htop]
    exact le_iSup_of_le φ (le_iSup_of_le hφ le_rfl)
  · rw [freeNormExt, ite_eq_right htop]
    have hsingleton := normAdmissible_singleton p φ hφ
    have hle : ENNReal.ofReal (scalarPSum p (fun _ : Fin 1 => f φ)) ≤
        ⨆ (n : ℕ) (ψ : Fin n → Dual E) (_ : NormAdmissible p ψ),
          ENNReal.ofReal (scalarPSum p (fun i => f (ψ i))) := by
      exact le_iSup_of_le (1 : ℕ) (le_iSup_of_le (fun _ : Fin 1 => φ)
        (le_iSup_of_le hsingleton le_rfl))
    simpa only [scalarPSum_fin1] using hle

/-- The endpoint supremum norm is bounded by every free p-norm. -/
theorem freeNormExt_infinity_le (p : Exponent) (f : Dual E → ℝ) :
    freeNormExt Exponent.infinity f ≤ freeNormExt p f := by
  rw [freeNormExt, ite_eq_left (show (Exponent.infinity : Exponent).1 = ⊤ by rfl)]
  exact iSup_le fun φ => iSup_le fun hφ => ofReal_abs_le_freeNormExt p f φ hφ

/-- Strict finite-parameter comparison of the free norms on homogeneous functions. -/
theorem freeNormExt_mono_finite {p q : Exponent} (hpq : p < q) (hq : q.IsFinite)
    (f : Dual E → ℝ) (hf : PosHomogeneous f) : freeNormExt q f ≤ freeNormExt p f := by
  have hp : p.IsFinite := lt_trans hpq hq
  have hpReal : 0 < p.1.toReal := ENNReal.toReal_pos_iff.mpr
    ⟨lt_of_lt_of_le zero_lt_one p.2, hp⟩
  have hpqReal : p.1.toReal < q.1.toReal :=
    (ENNReal.toReal_lt_toReal (ne_of_lt hp) (ne_of_lt hq)).mpr hpq
  rw [freeNormExt, ite_eq_right (ne_of_lt hq)]
  refine iSup_le fun n => iSup_le fun φ => iSup_le fun hφ => ?_
  obtain ⟨w, hwpos, hw, heq⟩ := realPSum_weighted_exists hpReal hpqReal
    (fun i : Fin n => f (φ i))
  have hψ : NormAdmissible p (fun i => w i • φ i) :=
    normAdmissible_weighted hpq hp hq φ hφ w hw
  have hvalue : scalarPSum q (fun i => f (φ i)) =
      scalarPSum p (fun i => f (w i • φ i)) := by
    have hpoint (i : Fin n) : f (w i • φ i) = w i * f (φ i) := hf (w i) (hwpos i) (φ i)
    simp_rw [hpoint]
    simp only [scalarPSum, ite_eq_right (ne_of_lt hp), ite_eq_right (ne_of_lt hq)]
    simpa only [mul_comm] using heq.symm
  rw [hvalue]
  rw [freeNormExt, ite_eq_right (ne_of_lt hp)]
  exact le_iSup_of_le n (le_iSup_of_le (fun i => w i • φ i)
    (le_iSup_of_le hψ le_rfl))

/-- The free norms of homogeneous functions decrease with the exponent. -/
theorem freeNormExt_mono {p q : Exponent} (hpq : p ≤ q)
    (f : Dual E → ℝ) (hf : PosHomogeneous f) : freeNormExt q f ≤ freeNormExt p f := by
  by_cases heq : p = q
  · subst q
    exact le_rfl
  by_cases htop : q.1 = ⊤
  · have hq : q = Exponent.infinity := Subtype.ext htop
    subst q
    exact freeNormExt_infinity_le p f
  · have hq : q.IsFinite := lt_top_iff_ne_top.mpr htop
    have hlt : p < q := lt_of_le_of_ne hpq heq
    exact freeNormExt_mono_finite hlt hq f hf

/-- Evaluation at x has extended free norm exactly equal to the norm of x.
This is the norm identity underlying the canonical isometry `delta`. -/
theorem freeNormExt_eval_eq (p : Exponent) (x : E) :
    freeNormExt p (fun φ : Dual E => φ x) = ENNReal.ofReal ‖x‖ := by
  apply le_antisymm (freeNormExt_eval_le p x)
  obtain ⟨φ, hφnorm, hφx⟩ := exists_dual_vector'' ℝ x
  have hle := ofReal_abs_le_freeNormExt p (fun ψ : Dual E => ψ x) φ hφnorm
  simpa [hφx, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg x)] using hle

/-- The zero function has zero extended free norm at every exponent. -/
theorem freeNormExt_zero (p : Exponent) :
    freeNormExt p (fun _ : Dual E => 0) = 0 := by
  unfold freeNormExt
  split_ifs
  · simp
  · simp only [ENNReal.iSup_eq_zero, ENNReal.ofReal_eq_zero]
    intro n φ hφ
    change scalarPSum p (0 : Fin n → ℝ) ≤ 0
    rw [scalarPSum_eq_piLp_norm]
    exact le_of_eq (norm_zero)

/-- The extended free norm is absolutely homogeneous, with multiplication in `ℝ≥0∞`.
The formula includes the zero scalar and functions of infinite free norm. -/
theorem freeNormExt_smul (p : Exponent) (c : ℝ) (f : Dual E → ℝ) :
    freeNormExt p (c • f) = ENNReal.ofReal |c| * freeNormExt p f := by
  by_cases htop : p.1 = ⊤
  · simp only [freeNormExt, htop, ↓reduceIte]
    rw [ENNReal.mul_iSup]
    congr with φ
    rw [ENNReal.mul_iSup]
    congr with hφ
    simp [Pi.smul_apply, smul_eq_mul, abs_mul,
      ENNReal.ofReal_mul (abs_nonneg c)]
  · simp only [freeNormExt, htop, ↓reduceIte]
    rw [ENNReal.mul_iSup]
    congr with n
    rw [ENNReal.mul_iSup]
    congr with φ
    rw [ENNReal.mul_iSup]
    congr with hφ
    simp [Pi.smul_apply, smul_eq_mul, scalarPSum_smul,
      ENNReal.ofReal_mul (abs_nonneg c)]

/-- The extended free norm satisfies the triangle inequality for arbitrary dual functions. -/
theorem freeNormExt_add_le (p : Exponent) (f g : Dual E → ℝ) :
    freeNormExt p (f + g) ≤ freeNormExt p f + freeNormExt p g := by
  by_cases htop : p.1 = ⊤
  · rw [freeNormExt, ite_eq_left htop]
    refine iSup_le fun φ => iSup_le fun hφ => ?_
    calc
      ENNReal.ofReal |(f + g) φ| ≤ ENNReal.ofReal (|f φ| + |g φ|) := by
        apply ENNReal.ofReal_le_ofReal
        simpa using abs_add_le (f φ) (g φ)
      _ = ENNReal.ofReal |f φ| + ENNReal.ofReal |g φ| := by
        rw [ENNReal.ofReal_add (abs_nonneg _) (abs_nonneg _)]
      _ ≤ freeNormExt p f + freeNormExt p g := by
        apply add_le_add
        all_goals rw [freeNormExt, ite_eq_left htop]
        all_goals exact le_iSup_of_le φ (le_iSup_of_le hφ le_rfl)
  · rw [freeNormExt, ite_eq_right htop]
    refine iSup_le fun n => iSup_le fun φ => iSup_le fun hφ => ?_
    calc
      ENNReal.ofReal (scalarPSum p (fun i => (f + g) (φ i))) ≤
          ENNReal.ofReal (scalarPSum p (fun i => f (φ i)) +
            scalarPSum p (fun i => g (φ i))) := by
        apply ENNReal.ofReal_le_ofReal
        simpa only [Pi.add_apply] using
          scalarPSum_add_le p (fun i => f (φ i)) (fun i => g (φ i))
      _ = ENNReal.ofReal (scalarPSum p (fun i => f (φ i))) +
          ENNReal.ofReal (scalarPSum p (fun i => g (φ i))) := by
        rw [ENNReal.ofReal_add (scalarPSum_nonneg ..) (scalarPSum_nonneg ..)]
      _ ≤ freeNormExt p f + freeNormExt p g := by
        apply add_le_add
        all_goals rw [freeNormExt, ite_eq_right htop]
        all_goals exact le_iSup_of_le n (le_iSup_of_le φ (le_iSup_of_le hφ le_rfl))

/-- Pointwise domination in absolute value implies domination of extended free norms. -/
theorem freeNormExt_mono_abs (p : Exponent) {f g : Dual E → ℝ}
    (h : ∀ φ, |f φ| ≤ |g φ|) : freeNormExt p f ≤ freeNormExt p g := by
  by_cases htop : p.1 = ⊤
  · rw [freeNormExt, ite_eq_left htop, freeNormExt, ite_eq_left htop]
    refine iSup_le fun φ => iSup_le fun hφ => ?_
    exact (ENNReal.ofReal_le_ofReal (h φ)).trans
      (le_iSup_of_le φ (le_iSup_of_le hφ le_rfl))
  · rw [freeNormExt, ite_eq_right htop, freeNormExt, ite_eq_right htop]
    refine iSup_le fun n => iSup_le fun φ => iSup_le fun hφ => ?_
    exact (ENNReal.ofReal_le_ofReal
      (scalarPSum_mono_abs p (fun i => f (φ i)) (fun i => g (φ i))
        (fun i => h (φ i)))).trans
      (le_iSup_of_le n (le_iSup_of_le φ (le_iSup_of_le hφ le_rfl)))

/-- Taking the pointwise absolute value leaves the extended free norm unchanged. -/
theorem freeNormExt_abs (p : Exponent) (f : Dual E → ℝ) :
    freeNormExt p (fun φ => |f φ|) = freeNormExt p f := by
  apply le_antisymm
  · apply freeNormExt_mono_abs
    intro φ
    simp
  · apply freeNormExt_mono_abs
    intro φ
    simp

/-- The free norm of a pointwise supremum is bounded by the sum of the two free norms.
This ensures that finite-norm homogeneous functions form a vector sublattice. -/
theorem freeNormExt_sup_le (p : Exponent) (f g : Dual E → ℝ) :
    freeNormExt p (f ⊔ g) ≤ freeNormExt p f + freeNormExt p g := by
  calc
    freeNormExt p (f ⊔ g) ≤ freeNormExt p (fun φ => |f φ| + |g φ|) := by
      apply freeNormExt_mono_abs
      intro φ
      simpa [Pi.sup_apply, abs_of_nonneg
        (add_nonneg (abs_nonneg (f φ)) (abs_nonneg (g φ)))] using
        FVLv.abs_sup_le_add_abs (f φ) (g φ)
    _ ≤ freeNormExt p (fun φ => |f φ|) + freeNormExt p (fun φ => |g φ|) :=
      freeNormExt_add_le p (fun φ => |f φ|) (fun φ => |g φ|)
    _ = freeNormExt p f + freeNormExt p g := by
      rw [freeNormExt_abs, freeNormExt_abs]
/-- Section 2: H_p[E] is the actual finite-norm part of H[E]. -/
def finiteNormSublattice (p : Exponent) (E : Type u)
    [NormedAddCommGroup E] [NormedSpace ℝ E] : VectorSublattice (Dual E → ℝ) where
  toSubmodule := {
    carrier := {f | PosHomogeneous f ∧ freeNormExt p f < ⊤}
    zero_mem' := by
      refine ⟨?_, ?_⟩
      · simp [PosHomogeneous]
      · change freeNormExt p (fun _ : Dual E => 0) < ⊤
        rw [freeNormExt_zero]
        norm_num
    add_mem' := by
      intro f g hf hg
      refine ⟨(homogeneousSublattice E).add_mem hf.1 hg.1, ?_⟩
      exact (freeNormExt_add_le p f g).trans_lt
        (lt_top_iff_ne_top.mpr
          (ENNReal.add_ne_top.mpr ⟨ne_of_lt hf.2, ne_of_lt hg.2⟩))
    smul_mem' := by
      intro c f hf
      refine ⟨(homogeneousSublattice E).smul_mem c hf.1, ?_⟩
      rw [freeNormExt_smul]
      exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top hf.2 }
  sup_mem' := by
    intro f g hf hg
    refine ⟨(homogeneousSublattice E).sup_mem hf.1 hg.1, ?_⟩
    exact (freeNormExt_sup_le p f g).trans_lt
      (lt_top_iff_ne_top.mpr
        (ENNReal.add_ne_top.mpr ⟨ne_of_lt hf.2, ne_of_lt hg.2⟩))

/-- The Banach lattice H_p[E] of positively homogeneous functions with finite free norm.
This type synonym carries the free norm topology, independently of the product topology
on all dual functions. Its underlying carrier is `finiteNormSublattice p E`. -/
def HP (p : Exponent) (E : Type u) [NormedAddCommGroup E] [NormedSpace ℝ E] : Type u :=
  finiteNormSublattice p E

instance (p : Exponent) : AddCommGroup (HP p E) :=
  inferInstanceAs (AddCommGroup (finiteNormSublattice p E))
instance (p : Exponent) : Module ℝ (HP p E) :=
  inferInstanceAs (Module ℝ (finiteNormSublattice p E))
instance (p : Exponent) : Lattice (HP p E) :=
  inferInstanceAs (Lattice (finiteNormSublattice p E))
instance (p : Exponent) : IsOrderedAddMonoid (HP p E) :=
  inferInstanceAs (IsOrderedAddMonoid (finiteNormSublattice p E))
instance (p : Exponent) : VectorLattice (HP p E) :=
  inferInstanceAs (VectorLattice (finiteNormSublattice p E))

instance (p : Exponent) : CoeFun (HP p E) (fun _ => Dual E → ℝ) := ⟨fun f => f.1⟩
instance (p : Exponent) : Norm (HP p E) := ⟨fun f => (freeNormExt p f.1).toReal⟩

-- Opaque norm proofs keep the instance value small during later type-class normalization.
private theorem hp_norm_smul (p : Exponent) (c : ℝ) (f : HP p E) :
    ‖c • f‖ = ‖c‖ * ‖f‖ := by
  change (freeNormExt p (c • (f : Dual E → ℝ))).toReal =
    ‖c‖ * (freeNormExt p f.1).toReal
  rw [freeNormExt_smul, ENNReal.toReal_mul,
    ENNReal.toReal_ofReal (abs_nonneg c), Real.norm_eq_abs]

private theorem hp_norm_triangle (p : Exponent) (f g : HP p E) :
    ‖f + g‖ ≤ ‖f‖ + ‖g‖ := by
  change (freeNormExt p (f.1 + g.1)).toReal ≤
    (freeNormExt p f.1).toReal + (freeNormExt p g.1).toReal
  calc
    (freeNormExt p (f.1 + g.1)).toReal ≤
        (freeNormExt p f.1 + freeNormExt p g.1).toReal := by
      apply ENNReal.toReal_mono
      · exact ENNReal.add_ne_top.mpr ⟨ne_of_lt f.2.2, ne_of_lt g.2.2⟩
      · exact freeNormExt_add_le p f.1 g.1
    _ ≤ (freeNormExt p f.1).toReal + (freeNormExt p g.1).toReal :=
      ENNReal.toReal_add_le

private theorem hp_norm_eq_zero_iff (p : Exponent) (f : HP p E) :
    ‖f‖ = 0 ↔ f = 0 := by
  constructor
  · intro hnorm
    have hzero : freeNormExt p f.1 = 0 := by
      have hfin : freeNormExt p f.1 ≠ ⊤ := ne_of_lt f.2.2
      exact (ENNReal.toReal_eq_zero_iff _).mp hnorm |>.resolve_right hfin
    apply Subtype.ext
    funext φ
    change f.1 φ = 0
    let ψ : Dual E := ‖φ‖⁻¹ • φ
    have hψnorm : ‖ψ‖ ≤ 1 := by
      change ‖‖φ‖⁻¹ • φ‖ ≤ 1
      exact mem_closedBall_zero_iff.mp (inv_norm_smul_mem_unitClosedBall φ)
    have hψval : f.1 ψ = 0 := by
      have hle := ofReal_abs_le_freeNormExt p f.1 ψ hψnorm
      rw [hzero] at hle
      have habs : |f.1 ψ| ≤ 0 :=
        (ENNReal.ofReal_eq_zero.mp (le_zero_iff.mp hle))
      exact abs_eq_zero.mp (le_antisymm habs (abs_nonneg _))
    by_cases hφ : φ = 0
    · subst φ
      have hz := f.2.1 0 (le_refl 0) (0 : Dual E)
      simpa using hz
    · have hφnorm : ‖φ‖ ≠ 0 := norm_ne_zero_iff.mpr hφ
      have hsmul : ‖φ‖ • ψ = φ := by
        dsimp [ψ]
        rw [smul_smul, mul_inv_cancel₀ hφnorm, one_smul]
      rw [← hsmul, f.2.1 ‖φ‖ (norm_nonneg _) ψ, hψval, mul_zero]
  · intro hf
    subst f
    change (freeNormExt p (fun _ : Dual E => 0)).toReal = 0
    rw [freeNormExt_zero]
    rfl

instance hpNormedAddCommGroup (p : Exponent) : NormedAddCommGroup (HP p E) :=
  NormedAddCommGroup.ofCore (𝕜 := ℝ) {
    norm_nonneg := fun _ => ENNReal.toReal_nonneg
    norm_smul := by exact hp_norm_smul p
    norm_triangle := by exact hp_norm_triangle p
    norm_eq_zero_iff := by exact hp_norm_eq_zero_iff p }

instance hpNormedVectorLattice (p : Exponent) : NormedVectorLattice (HP p E) where
  toVectorLattice := inferInstance
  solid := by
    intro f g hfg
    change (freeNormExt p f.1).toReal ≤ (freeNormExt p g.1).toReal
    exact ENNReal.toReal_mono (ne_of_lt g.2.2)
      (freeNormExt_mono_abs p (fun φ => hfg φ))
  norm_smul := by exact hp_norm_smul p

private theorem hp_unit_eval_le (p : Exponent) (f : HP p E) (φ : Dual E)
    (hφ : ‖φ‖ ≤ 1) : |f φ| ≤ ‖f‖ := by
  change |f.1 φ| ≤ (freeNormExt p f.1).toReal
  exact (ENNReal.ofReal_le_iff_le_toReal (ne_of_lt f.2.2)).mp
    (ofReal_abs_le_freeNormExt p f.1 φ hφ)

/-- Evaluation of a finite-free-norm function at φ is bounded by the product of the
operator norm of φ and the free norm of the function. In particular, evaluation is continuous. -/
theorem hp_apply_abs_le (p : Exponent) (f : HP p E) (φ : Dual E) :
    |f φ| ≤ ‖φ‖ * ‖f‖ := by
  let ψ : Dual E := ‖φ‖⁻¹ • φ
  have hψ : ‖ψ‖ ≤ 1 := by
    change ‖‖φ‖⁻¹ • φ‖ ≤ 1
    exact mem_closedBall_zero_iff.mp (inv_norm_smul_mem_unitClosedBall φ)
  by_cases hφ : φ = 0
  · subst φ
    have hz := f.2.1 0 (le_refl 0) (0 : Dual E)
    simpa using hz
  · have hφnorm : ‖φ‖ ≠ 0 := norm_ne_zero_iff.mpr hφ
    have hsmul : ‖φ‖ • ψ = φ := by
      dsimp [ψ]
      rw [smul_smul, mul_inv_cancel₀ hφnorm, one_smul]
    have hfun : f φ = ‖φ‖ * f ψ := by
      calc
        f φ = f (‖φ‖ • ψ) := congrArg f hsmul.symm
        _ = ‖φ‖ * f ψ := f.2.1 ‖φ‖ (norm_nonneg _) ψ
    calc
      |f φ| = |‖φ‖ * f ψ| := by rw [hfun]
      _ = ‖φ‖ * |f ψ| := by rw [abs_mul, abs_of_nonneg (norm_nonneg φ)]
      _ ≤ ‖φ‖ * ‖f‖ := mul_le_mul_of_nonneg_left (hp_unit_eval_le p f ψ hψ)
        (norm_nonneg φ)

/-- Continuous evaluation of a finite-free-norm homogeneous function at a dual vector. -/
def hpEvaluation (p : Exponent) (φ : Dual E) : HP p E →L[ℝ] ℝ :=
  ({ toFun := fun f : HP p E => f φ
     map_add' := by intros; rfl
     map_smul' := by intros; rfl } : HP p E →ₗ[ℝ] ℝ).mkContinuous
    ‖φ‖ (by
      intro f
      change |f φ| ≤ ‖φ‖ * ‖f‖
      exact hp_apply_abs_le p f φ)

private theorem hp_admissible_eval_le (p : Exponent) (hptop : p.1 ≠ ⊤)
    (f : HP p E) {n : ℕ} (φ : Fin n → Dual E) (hφ : NormAdmissible p φ) :
    scalarPSum p (fun i => f (φ i)) ≤ ‖f‖ := by
  have hle : ENNReal.ofReal (scalarPSum p (fun i => f (φ i))) ≤ freeNormExt p f.1 := by
    rw [freeNormExt, ite_eq_right hptop]
    exact le_iSup_of_le n (le_iSup_of_le φ (le_iSup_of_le hφ le_rfl))
  exact (ENNReal.ofReal_le_iff_le_toReal (ne_of_lt f.2.2)).mp hle

private theorem hp_limit_sub_bound (p : Exponent) (u : ℕ → HP p E)
    (g : Dual E → ℝ) (hg : ∀ φ, Filter.Tendsto (fun m => u m φ) atTop (𝓝 (g φ)))
    (N : ℕ) (r : ℝ) (hN : ∀ᶠ m in atTop, ‖u m - u N‖ ≤ r) :
    freeNormExt p (g - (u N : Dual E → ℝ)) ≤ ENNReal.ofReal r := by
  by_cases hptop : p.1 = ⊤
  · rw [freeNormExt, ite_eq_left hptop]
    refine iSup_le fun φ => iSup_le fun hφ => ?_
    apply ENNReal.ofReal_le_ofReal
    have ht : Filter.Tendsto (fun m => |(u m - u N) φ|) atTop
        (𝓝 |g φ - u N φ|) := by
      have hd : Filter.Tendsto (fun m => (u m - u N) φ) atTop
          (𝓝 (g φ - u N φ)) := by
        convert (hg φ).sub tendsto_const_nhds using 1
        funext m
        rfl
      exact (continuous_abs.tendsto _).comp hd
    have hbound : ∀ᶠ m in atTop, |(u m - u N) φ| ≤ r := by
      filter_upwards [hN] with m hm
      exact (hp_unit_eval_le p (u m - u N) φ hφ).trans hm
    exact le_of_tendsto ht hbound
  · rw [freeNormExt, ite_eq_right hptop]
    refine iSup_le fun n => iSup_le fun φ => iSup_le fun hφ => ?_
    apply ENNReal.ofReal_le_ofReal
    have hcoords : Filter.Tendsto
        (fun m : ℕ => fun i : Fin n => (u m - u N) (φ i)) atTop
        (𝓝 (fun i : Fin n => g (φ i) - u N (φ i))) := by
      apply tendsto_pi_nhds.mpr
      intro i
      convert (hg (φ i)).sub tendsto_const_nhds using 1
      funext m
      rfl
    have ht : Filter.Tendsto
        (fun m => scalarPSum p (fun i : Fin n => (u m - u N) (φ i))) atTop
        (𝓝 (scalarPSum p (fun i : Fin n => g (φ i) - u N (φ i)))) :=
      ((continuous_scalarPSum p).tendsto _).comp hcoords
    have hbound : ∀ᶠ m in atTop,
        scalarPSum p (fun i : Fin n => (u m - u N) (φ i)) ≤ r := by
      filter_upwards [hN] with m hm
      exact (hp_admissible_eval_le p hptop (u m - u N) φ hφ).trans hm
    exact le_of_tendsto ht hbound

instance hpCompleteSpace (p : Exponent) : CompleteSpace (HP p E) := by
  refine Metric.complete_of_cauchySeq_tendsto fun u hu => ?_
  have hpoint : ∀ φ : Dual E, CauchySeq (fun n => u n φ) := by
    intro φ
    have hc := (hpEvaluation p φ).uniformContinuous.comp_cauchySeq hu
    change CauchySeq (fun n => u n φ) at hc
    exact hc
  choose g hg using fun φ => cauchySeq_tendsto_of_complete (hpoint φ)
  have hg_pos : PosHomogeneous g := by
    intro a ha φ
    have ht : Filter.Tendsto (fun n => u n (a • φ)) atTop (𝓝 (a * g φ)) := by
      convert tendsto_const_nhds.mul (hg φ) using 1
      funext n
      exact (u n).2.1 a ha φ
    exact tendsto_nhds_unique (hg (a • φ)) ht
  have huMetric := Metric.cauchySeq_iff.mp hu
  have hg_fin : freeNormExt p g < ⊤ := by
    obtain ⟨N, hN⟩ := huMetric 1 zero_lt_one
    have htail : ∀ᶠ m in atTop, ‖u m - u N‖ ≤ (1 : ℝ) := by
      filter_upwards [Filter.eventually_atTop.2 ⟨N, fun m hm => hm⟩] with m hm
      exact le_of_lt (by simpa [dist_eq_norm] using hN m hm N le_rfl)
    have hdiff : freeNormExt p (g - (u N : Dual E → ℝ)) ≤ ENNReal.ofReal 1 :=
      hp_limit_sub_bound p u g hg N 1 htail
    have hdiff_lt : freeNormExt p (g - (u N : Dual E → ℝ)) < ⊤ :=
      lt_of_le_of_lt hdiff (lt_top_iff_ne_top.mpr ENNReal.ofReal_ne_top)
    have hg_le : freeNormExt p g ≤
        freeNormExt p (g - (u N : Dual E → ℝ)) +
          freeNormExt p (u N : Dual E → ℝ) := by
      simpa [sub_add_cancel] using
        freeNormExt_add_le p (g - (u N : Dual E → ℝ)) (u N : Dual E → ℝ)
    exact lt_of_le_of_lt hg_le
      (lt_top_iff_ne_top.mpr
        (ENNReal.add_ne_top.mpr ⟨ne_of_lt hdiff_lt, ne_of_lt (u N).2.2⟩))
  let gHP : HP p E := ⟨g, hg_pos, hg_fin⟩
  refine ⟨gHP, ?_⟩
  rw [Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨N, hN⟩ := huMetric (ε / 2) (by linarith)
  refine ⟨N, fun n hn => ?_⟩
  rw [dist_eq_norm]
  have htail : ∀ᶠ m in atTop, ‖u m - u n‖ ≤ ε / 2 := by
    filter_upwards [Filter.eventually_atTop.2 ⟨N, fun m hm => hm⟩] with m hm
    exact le_of_lt (by simpa [dist_eq_norm] using hN m hm n hn)
  have hdiff : freeNormExt p (g - (u n : Dual E → ℝ)) ≤ ENNReal.ofReal (ε / 2) :=
    hp_limit_sub_bound p u g hg n (ε / 2) htail
  have hnorm : ‖gHP - u n‖ ≤ ε / 2 := by
    change (freeNormExt p ((gHP - u n : HP p E) : Dual E → ℝ)).toReal ≤ ε / 2
    have hcoe : ((gHP - u n : HP p E) : Dual E → ℝ) =
        g - (u n : Dual E → ℝ) := rfl
    rw [hcoe]
    exact ENNReal.toReal_le_of_le_ofReal (by linarith) hdiff
  rw [norm_sub_rev]
  linarith
instance hpBanachLattice (p : Exponent) : BanachLattice (HP p E) where
  toNormedVectorLattice := hpNormedVectorLattice p
  toCompleteSpace := hpCompleteSpace p

/-- Section 2: evaluation in the ambient finite-norm space. -/
def hpEval (p : Exponent) (x : E) : HP p E := ⟨fun φ => φ x, by
  refine ⟨?_, ?_⟩
  · intro a ha φ
    simp
  · exact (freeNormExt_eval_le p x).trans_lt ENNReal.ofReal_lt_top⟩

/-- The norm closure of the vector sublattice generated by evaluations inside `HP p E`.
Its subtype is `Free p E`; closure is taken for the free norm. -/
def freeSublattice (p : Exponent) (E : Type u)
    [NormedAddCommGroup E] [NormedSpace ℝ E] : VectorSublattice (HP p E) :=
  (VectorSublattice.generated (Set.range (hpEval p : E → HP p E))).topologicalClosure

/-- The free p-convex Banach lattice over E, realized as the norm-closed vector sublattice
of `HP p E` generated by evaluations. The canonical embedding of E is `delta p`. -/
abbrev Free (p : Exponent) (E : Type u) [NormedAddCommGroup E] [NormedSpace ℝ E] : Type u :=
  freeSublattice p E

instance (p : Exponent) : CoeFun (Free p E) (fun _ => Dual E → ℝ) :=
  ⟨fun f => f.1.1⟩

instance freeBanachLattice (p : Exponent) : BanachLattice (Free p E) :=
  VectorSublattice.banachLatticeCoe _
    (VectorSublattice.isClosed_topologicalClosure _)

/-- Membership in the free lattice for a full-dual function, including its homogeneity. -/
def InFree (p : Exponent) (f : Dual E → ℝ) : Prop :=
  ∃ g : Free p E, ∀ φ, g φ = f φ

/-- Section 2: the canonical evaluation isometry; its function is explicitly evaluation. -/
def delta (p : Exponent) : E →ₗᵢ[ℝ] Free p E where
  toFun x := ⟨hpEval p x, by
    exact (VectorSublattice.le_topologicalClosure _)
      (VectorSublattice.subset_generated _ (Set.mem_range_self x))⟩
  map_add' := by
    intro x y
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    exact map_add φ x y
  map_smul' := by
    intro c x
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    exact map_smul φ c x
  norm_map' := by
    intro x
    change (freeNormExt p (fun φ : Dual E => φ x)).toReal = ‖x‖
    rw [freeNormExt_eval_eq, ENNReal.toReal_ofReal (norm_nonneg x)]

/-- Use BanLat's existing free vector lattice over a normed space. -/
abbrev FVL (E : Type u) [NormedAddCommGroup E] [NormedSpace ℝ E] := FVLv E

/-- Normalize a functional into BanLat's weak-star dual unit ball. -/
def normalizedDual (φ : Dual E) : FVLv.dualUnitBall E :=
  ⟨StrongDual.toWeakDual (‖φ‖⁻¹ • φ), by
    change ‖φ‖⁻¹ • φ ∈ Metric.closedBall (0 : Dual E) 1
    exact inv_norm_smul_mem_unitClosedBall φ⟩

/-- Radial extension of BanLat's unit-ball model to the full dual. -/
def fvlFunction (v : FVL E) (φ : Dual E) : ℝ := ‖φ‖ * v (normalizedDual φ)

/-- Evaluation on the algebraic free lattice after radial extension to the full dual. -/
def radialEval (φ : Dual E) : VecLatHom (FVL E) ℝ where
  toFun v := fvlFunction v φ
  map_add' := by
    intro v w
    simp [fvlFunction, mul_add]
  map_smul' := by
    intro c v
    simp [fvlFunction, mul_left_comm]
  map_sup' := by
    intro v w
    simp [fvlFunction, mul_max_of_nonneg, norm_nonneg]
  map_inf' := by
    intro v w
    simp [fvlFunction, mul_min_of_nonneg, norm_nonneg]

private theorem radialEval_of (φ : Dual E) (x : E) :
    radialEval φ (FVLv.of x) = φ x := by
  change ‖φ‖ * (FVLv.of x) (normalizedDual φ) = φ x
  rw [FVLv.of_apply]
  change ‖φ‖ * (‖φ‖⁻¹ • φ) x = φ x
  change ‖φ‖ * (‖φ‖⁻¹ * φ x) = φ x
  by_cases hφ : φ = 0
  · subst φ
    simp
  · rw [← mul_assoc, mul_inv_cancel₀ (norm_ne_zero_iff.mpr hφ), one_mul]

/-- The algebraic lift of the canonical evaluation isometry into the free Banach lattice. -/
def liftToFree (p : Exponent) : VecLatHom (FVL E) (Free p E) :=
  FVLv.lift (delta p).toLinearMap

/-- Evaluation on the free lattice as a real lattice homomorphism. -/
def evalVecLatHom (p : Exponent) (φ : Dual E) : VecLatHom (Free p E) ℝ where
  toFun f := f φ
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  map_sup' := by intros; rfl
  map_inf' := by intros; rfl

/-- Evaluation of the algebraic free lattice on the dual unit ball. -/
def evalFVLv (ψ : FVLv.dualUnitBall E) : VecLatHom (FVL E) ℝ where
  toFun v := v ψ
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  map_sup' := by intros; rfl
  map_inf' := by intros; rfl

theorem radialEval_eq_liftToFree (p : Exponent) (φ : Dual E) (v : FVL E) :
    fvlFunction v φ = liftToFree p v φ := by
  let ev : VecLatHom (Free p E) ℝ := {
    toFun := fun f => f φ
    map_add' := by intros; rfl
    map_smul' := by intros; rfl
    map_sup' := by intros; rfl
    map_inf' := by intros; rfl }
  have hleft : radialEval φ = FVLv.lift (φ : E →ₗ[ℝ] ℝ) := by
    apply FVLv.lift_unique
    intro x
    exact radialEval_of φ x
  have hright : ev.comp (liftToFree p) = FVLv.lift (φ : E →ₗ[ℝ] ℝ) := by
    apply FVLv.lift_unique
    intro x
    change liftToFree p (FVLv.of x) φ = φ x
    rw [liftToFree, FVLv.lift_of]
    rfl
  have h := DFunLike.congr_fun (hleft.trans hright.symm) v
  exact h

/-- Radial extension of an algebraic free element has finite free norm. -/
theorem fvlFunction_mem_finiteNormSublattice (p : Exponent) (v : FVL E) :
    fvlFunction v ∈ finiteNormSublattice p E := by
  have hfun : fvlFunction v = (liftToFree p v).1.1 :=
    funext fun φ => radialEval_eq_liftToFree p φ v
  rw [hfun]
  exact (liftToFree p v).1.2

/-- The radial model of an algebraic free element belongs to the closed generated lattice. -/
theorem fvlFunction_mem_freeSublattice (p : Exponent) (v : FVL E) :
    (⟨fvlFunction v, fvlFunction_mem_finiteNormSublattice p v⟩ : HP p E) ∈
      freeSublattice p E := by
  have heq : (⟨fvlFunction v, fvlFunction_mem_finiteNormSublattice p v⟩ : HP p E) =
      (liftToFree p v).1 := by
    apply Subtype.ext
    exact funext fun φ => radialEval_eq_liftToFree p φ v
  rw [heq]
  exact (liftToFree p v).2

/-- Embed BanLat’s algebraic free vector lattice into `Free p E` by radial extension from
the dual unit ball. The embedding preserves lattice operations, agrees with `delta` on
generators, and has norm-dense range. -/
def ofFVL (p : Exponent) : VecLatHom (FVL E) (Free p E) where
  toFun v := ⟨⟨fvlFunction v, fvlFunction_mem_finiteNormSublattice p v⟩,
    fvlFunction_mem_freeSublattice p v⟩
  map_add' := by
    intro v w
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    change fvlFunction (v + w) φ = fvlFunction v φ + fvlFunction w φ
    simp [fvlFunction, mul_add]
  map_smul' := by
    intro c v
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    change fvlFunction (c • v) φ = c * fvlFunction v φ
    simp [fvlFunction, mul_left_comm]
  map_sup' := by
    intro v w
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    change fvlFunction (v ⊔ w) φ = max (fvlFunction v φ) (fvlFunction w φ)
    simp [fvlFunction, mul_max_of_nonneg, norm_nonneg]
  map_inf' := by
    intro v w
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    change fvlFunction (v ⊓ w) φ = min (fvlFunction v φ) (fvlFunction w φ)
    simp [fvlFunction, mul_min_of_nonneg, norm_nonneg]

private theorem ofFVL_eq_liftToFree (p : Exponent) :
    (ofFVL p (E := E)) = liftToFree p := by
  apply DFunLike.ext
  intro v
  apply Subtype.ext
  apply Subtype.ext
  funext φ
  exact radialEval_eq_liftToFree p φ v

/-- The algebraic generator at x maps to the canonical evaluation `delta p x`. -/
theorem ofFVL_of (p : Exponent) (x : E) :
    ofFVL p (FVLv.of x) = delta p x := by
  rw [ofFVL_eq_liftToFree]
  exact FVLv.lift_of (delta p).toLinearMap x

private theorem ofFVL_apply_ball (p : Exponent) (v : FVL E)
    (ψ : FVLv.dualUnitBall E) :
    ofFVL p v (WeakDual.toStrongDual ψ.1) = v ψ := by
  let φ : Dual E := WeakDual.toStrongDual ψ.1
  have hleft : (evalVecLatHom p φ).comp (ofFVL p) =
      FVLv.lift (φ : E →ₗ[ℝ] ℝ) := by
    apply FVLv.lift_unique
    intro x
    rw [VecLatHom.comp_apply, ofFVL_of]
    rfl
  have hright : evalFVLv ψ = FVLv.lift (φ : E →ₗ[ℝ] ℝ) := by
    apply FVLv.lift_unique
    intro x
    change (FVLv.of x) ψ = φ x
    rw [FVLv.of_apply]
    rfl
  exact DFunLike.congr_fun (hleft.trans hright.symm) v

private theorem continuous_llExpr_dual_eval {n : ℕ} (x : Fin n → E) (e : LLexpr n) :
    Continuous (fun φ : Dual E => LLexpr.eval (fun i => φ (x i)) e) := by
  induction e with
  | zero => exact continuous_const
  | var i => exact (ContinuousLinearMap.apply ℝ ℝ (x i)).continuous
  | add e₁ e₂ h₁ h₂ => exact h₁.add h₂
  | smul c e h => exact continuous_const.mul h
  | sup e₁ e₂ h₁ h₂ => exact h₁.sup h₂
  | inf e₁ e₂ h₁ h₂ => exact h₁.inf h₂

private theorem continuous_llExpr_weak_eval {n : ℕ} (x : Fin n → E) (e : LLexpr n) :
    Continuous (fun φ : WeakDual ℝ E => LLexpr.eval (fun i => φ (x i)) e) := by
  induction e with
  | zero => exact continuous_const
  | var i => exact WeakDual.eval_continuous (x i)
  | add e₁ e₂ h₁ h₂ => exact h₁.add h₂
  | smul c e h => exact continuous_const.mul h
  | sup e₁ e₂ h₁ h₂ => exact h₁.sup h₂
  | inf e₁ e₂ h₁ h₂ => exact h₁.inf h₂

private theorem ofFVL_expr_apply (p : Exponent) {n : ℕ} (x : Fin n → E)
    (e : LLexpr n) (φ : Dual E) :
    ofFVL p (LLexpr.eval (fun i => FVLv.of (x i)) e) φ =
      LLexpr.eval (fun i => φ (x i)) e := by
  have hmap := LLexpr.map_eval ((evalVecLatHom p φ).comp (ofFVL p))
    (fun i => FVLv.of (x i)) e
  change ofFVL p (LLexpr.eval (fun i => FVLv.of (x i)) e) φ =
    LLexpr.eval (fun i => ofFVL p (FVLv.of (x i)) φ) e at hmap
  simpa [ofFVL_of, delta, hpEval] using hmap

private theorem ofFVL_norm_continuous (p : Exponent) (v : FVL E) :
    Continuous (fun φ : Dual E => ofFVL p v φ) := by
  obtain ⟨n, x, e, he⟩ := FVLv.exists_eval_of_eq v
  rw [← he]
  have hfun : (fun φ : Dual E =>
      ofFVL p (LLexpr.eval (fun i => FVLv.of (x i)) e) φ) =
      (fun φ : Dual E => LLexpr.eval (fun i => φ (x i)) e) := by
    funext φ
    exact ofFVL_expr_apply p x e φ
  rw [hfun]
  exact continuous_llExpr_dual_eval x e

private theorem ofFVL_weakstar_continuous (p : Exponent) (v : FVL E) :
    Continuous (fun φ : WeakDual ℝ E => ofFVL p v (WeakDual.toStrongDual φ)) := by
  obtain ⟨n, x, e, he⟩ := FVLv.exists_eval_of_eq v
  rw [← he]
  have hfun : (fun φ : WeakDual ℝ E =>
      ofFVL p (LLexpr.eval (fun i => FVLv.of (x i)) e)
        (WeakDual.toStrongDual φ)) =
      (fun φ : WeakDual ℝ E => LLexpr.eval (fun i => φ (x i)) e) := by
    funext φ
    simpa only [WeakDual.toStrongDual_apply] using
      ofFVL_expr_apply p x e (WeakDual.toStrongDual φ)
  rw [hfun]
  exact continuous_llExpr_weak_eval x e

private theorem free_apply_sub_le (p : Exponent) (f g : Free p E) (φ : Dual E) :
    |f φ - g φ| ≤ ‖φ‖ * ‖f - g‖ := by
  have h := hp_apply_abs_le p (f.1 - g.1) φ
  change |f φ - g φ| ≤ ‖φ‖ * ‖f - g‖ at h
  exact h

/-- Section 2: explicit evaluation and radial-extension bridges. -/
theorem model_evaluation (p : Exponent) (x : E) (v : FVL E) (φ : Dual E) :
    delta p x φ = φ x ∧ ofFVL p v φ = fvlFunction v φ := by
  exact ⟨rfl, rfl⟩

/-- Section 2: pointwise order in the full-dual representation. -/
theorem free_le_iff (p : Exponent) (f g : Free p E) :
    f ≤ g ↔ ∀ φ, f φ ≤ g φ := by rfl

/-- Compatibility of the norm with its ENNReal formula. -/
theorem freeNormExt_eq_norm (p : Exponent) (f : Free p E) :
    freeNormExt p f = ENNReal.ofReal ‖f‖ := by
  exact (ENNReal.ofReal_toReal (ne_of_lt f.1.2.2)).symm

/-- The free vector lattice is embedded faithfully and its generators agree. -/
theorem ofFVL_embedding (p : Exponent) : Function.Injective (ofFVL p (E := E)) ∧
    ∀ x : E, ofFVL p (FVLv.of x) = delta p x := by
  refine ⟨?_, ofFVL_of p⟩
  intro v w h
  apply Subtype.ext
  apply ContinuousMap.ext
  intro ψ
  have heq := congrArg (fun f : Free p E => f (WeakDual.toStrongDual ψ.1)) h
  simpa only [ofFVL_apply_ball] using heq

/-- Section 2: norm density of the specified copy of FVL. -/
theorem denseRange_ofFVL (p : Exponent) : DenseRange (ofFVL p (E := E)) := by
  let G := VectorSublattice.generated (Set.range (hpEval p : E → HP p E))
  let C := freeSublattice p E
  have hGC : G ≤ C := (VectorSublattice.generated
    (Set.range (hpEval p : E → HP p E))).le_topologicalClosure
  let ι : G → Free p E := Set.inclusion hGC
  have hι_dense : DenseRange ι := by
    change DenseRange (Set.inclusion hGC)
    exact (denseRange_inclusion_iff hGC).2 (by
      change (G.topologicalClosure : Set (HP p E)) ⊆ _
      rw [VectorSublattice.topologicalClosure_coe])
  have hι_range : Set.range ι ⊆ Set.range (ofFVL p (E := E)) := by
    intro z hz
    rcases hz with ⟨y, rfl⟩
    have hy : (y : HP p E) ∈ G := y.2
    change (y : HP p E) ∈
      (VectorSublattice.generated (Set.range (hpEval p : E → HP p E)) :
        Set (HP p E)) at hy
    rw [LLexpr.generated_eq_iUnion_combinations
      (Set.range (hpEval p : E → HP p E))] at hy
    simp only [Set.mem_iUnion, LLexpr.combinations, Set.mem_range] at hy
    obtain ⟨n, z, e, hz⟩ := hy
    choose x hx using fun i : Fin n => (z i).2
    refine ⟨LLexpr.eval (fun i : Fin n => FVLv.of (x i)) e, ?_⟩
    apply Subtype.ext
    have hmap : ofFVL p (LLexpr.eval (fun i : Fin n => FVLv.of (x i)) e) =
        LLexpr.eval (fun i : Fin n => delta p (x i)) e := by
      simpa only [ofFVL_of] using
        LLexpr.map_eval (ofFVL p) (fun i : Fin n => FVLv.of (x i)) e
    calc
      ((ofFVL p (LLexpr.eval (fun i : Fin n => FVLv.of (x i)) e) : Free p E) : HP p E) =
          ((LLexpr.eval (fun i : Fin n => delta p (x i)) e : Free p E) : HP p E) := by
        rw [hmap]
      _ = LLexpr.eval (fun i : Fin n => ((delta p (x i) : Free p E) : HP p E)) e :=
        LLexpr.coe_eval_vectorSublattice (freeSublattice p E)
          (fun i : Fin n => delta p (x i)) e
      _ = LLexpr.eval (fun i : Fin n => hpEval p (x i)) e := by
        congr
      _ = LLexpr.eval (fun i : Fin n => (z i : HP p E)) e := by
        congr
        funext i
        rw [hx i]
      _ = (y : HP p E) := hz
  apply denseRange_iff_closure_range.mpr
  ext z
  constructor
  · intro _; trivial
  · intro _
    have hz : z ∈ closure (Set.range ι) := by
      rw [hι_dense.closure_range]
      trivial
    exact closure_mono hι_range hz

/-- The norm of an algebraic element is the concrete extended norm’s real part. -/
theorem norm_ofFVL_eq_toReal (p : Exponent) (v : FVL E) :
    ‖ofFVL p v‖ = (freeNormExt p (fvlFunction v)).toReal := rfl

/-- The endpoint free norm is contractive on the common algebraic free lattice. -/
theorem norm_ofFVL_infinity_le (p : Exponent) (v : FVL E) :
    ‖ofFVL Exponent.infinity v‖ ≤ ‖ofFVL p v‖ := by
  rw [norm_ofFVL_eq_toReal, norm_ofFVL_eq_toReal]
  exact ENNReal.toReal_mono (ne_of_lt (ofFVL p v).1.2.2)
    (freeNormExt_infinity_le p (fvlFunction v))

/-- On the common algebraic free lattice, increasing the convexity exponent can only
decrease the free norm. This includes the target endpoint ∞. -/
theorem norm_ofFVL_mono {p q : Exponent} (hpq : p ≤ q) (v : FVL E) :
    ‖ofFVL q v‖ ≤ ‖ofFVL p v‖ := by
  rw [norm_ofFVL_eq_toReal, norm_ofFVL_eq_toReal]
  exact ENNReal.toReal_mono (ne_of_lt (ofFVL p v).1.2.2)
    (freeNormExt_mono hpq (fvlFunction v) (ofFVL p v).1.2.1)

/-- Evaluation on BanLat’s free Banach lattice as a real lattice homomorphism. -/
def banlatEval (ψ : FVLv.dualUnitBall E) : VecLatHom (_root_.FBL E) ℝ where
  toFun f := f ψ
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  map_sup' := by intros; rfl
  map_inf' := by intros; rfl

private theorem banlat_ofFVLv_apply (v : FVL E) (ψ : FVLv.dualUnitBall E) :
    (_root_.FBL.ofFVLv v : _root_.FBL E) ψ = v ψ := by
  let φ : Dual E := WeakDual.toStrongDual ψ.1
  have hleft : (banlatEval ψ).comp (FVLv.lift (_root_.FBL.ofLinear (E := E))) =
      FVLv.lift (φ : E →ₗ[ℝ] ℝ) := by
    apply FVLv.lift_unique
    intro x
    rw [VecLatHom.comp_apply, FVLv.lift_of]
    change (_root_.FBL.of x : _root_.FBL E) ψ = φ x
    rw [_root_.FBL.of_apply]
    rfl
  have hright : evalFVLv ψ = FVLv.lift (φ : E →ₗ[ℝ] ℝ) := by
    apply FVLv.lift_unique
    intro x
    change (FVLv.of x) ψ = φ x
    rw [FVLv.of_apply]
    rfl
  exact DFunLike.congr_fun (hleft.trans hright.symm) v

private theorem normAdmissible_one_iff_ball {n : ℕ}
    (ψ : Fin n → FVLv.dualUnitBall E) :
    NormAdmissible Exponent.one (fun i => WeakDual.toStrongDual (ψ i).1) ↔
      _root_.FBL.NormAdmissible E ψ := by
  simp only [NormAdmissible, _root_.FBL.NormAdmissible, scalarPSum_one_eq_sum,
    WeakDual.toStrongDual_apply]

private theorem normAdmissible_one_component_norm_le {n : ℕ}
    (φ : Fin n → Dual E) (hφ : NormAdmissible Exponent.one φ) (i : Fin n) :
    ‖φ i‖ ≤ 1 := by
  apply (φ i).opNorm_le_bound zero_le_one
  intro x
  rw [one_mul]
  have hsum := normAdmissible_eval_le_norm Exponent.one φ hφ x
  rw [scalarPSum_one_eq_sum] at hsum
  have hi : |φ i x| ≤ ∑ j, |φ j x| :=
    Finset.single_le_sum (f := fun j : Fin n => |φ j x|)
      (fun j _ => abs_nonneg _) (Finset.mem_univ i)
  simpa [Real.norm_eq_abs] using hi.trans hsum

-- Compare the plain functions before specializing to completed free-lattice elements.
private theorem freeNormExt_one_eq_of_restriction (f : Dual E → ℝ)
    (g : C(FVLv.dualUnitBall E, ℝ))
    (hfg : ∀ ψ, f (WeakDual.toStrongDual ψ.1) = g ψ) :
    freeNormExt Exponent.one f = _root_.FBL.freeNormExt E g := by
  have htop : (Exponent.one : Exponent).1 ≠ ⊤ := by norm_num [Exponent.one]
  rw [freeNormExt, ite_eq_right htop, _root_.FBL.freeNormExt]
  apply le_antisymm
  · refine iSup_le fun n => iSup_le fun φ => iSup_le fun hφ => ?_
    let ψ : Fin n → FVLv.dualUnitBall E := fun i =>
      ⟨StrongDual.toWeakDual (φ i), by
        dsimp [FVLv.dualUnitBall]
        simpa [Metric.mem_closedBall, dist_eq_norm] using
          normAdmissible_one_component_norm_le φ hφ i⟩
    have hψ : _root_.FBL.NormAdmissible E ψ :=
      (normAdmissible_one_iff_ball ψ).mp (by
        intro x hx
        simpa only [ψ, scalarPSum_one_eq_sum, WeakDual.toStrongDual_apply,
          StrongDual.toWeakDual_apply] using hφ x hx)
    have heq : scalarPSum Exponent.one (fun i => f (φ i)) = ∑ i, |g (ψ i)| := by
      rw [scalarPSum_one_eq_sum]
      apply Finset.sum_congr rfl
      intro i _
      exact congrArg abs (hfg (ψ i))
    rw [heq]
    exact le_iSup_of_le n (le_iSup_of_le ψ (le_iSup_of_le hψ le_rfl))
  · refine iSup_le fun n => iSup_le fun ψ => iSup_le fun hψ => ?_
    let φ : Fin n → Dual E := fun i => WeakDual.toStrongDual (ψ i).1
    have hφ : NormAdmissible Exponent.one φ := (normAdmissible_one_iff_ball ψ).mpr hψ
    have heq : (∑ i, |g (ψ i)|) = scalarPSum Exponent.one (fun i => f (φ i)) := by
      rw [scalarPSum_one_eq_sum]
      apply Finset.sum_congr rfl
      intro i _
      exact congrArg abs (hfg (ψ i)).symm
    rw [heq]
    exact le_iSup_of_le n (le_iSup_of_le φ (le_iSup_of_le hφ le_rfl))

private theorem freeNormExt_one_ofFVL_eq_banlat (v : FVL E) :
    freeNormExt Exponent.one (ofFVL Exponent.one v).1.1 =
      _root_.FBL.freeNormExt E (_root_.FBL.ofFVLv v).1.1 := by
  apply freeNormExt_one_eq_of_restriction
  intro ψ
  exact (ofFVL_apply_ball Exponent.one v ψ).trans (banlat_ofFVLv_apply v ψ).symm

theorem norm_ofFVL_one_eq_banlat (v : FVL E) :
    ‖ofFVL Exponent.one v‖ = ‖_root_.FBL.ofFVLv v‖ := by
  change (freeNormExt Exponent.one (ofFVL Exponent.one v).1.1).toReal =
    (_root_.FBL.freeNormExt E (_root_.FBL.ofFVLv v).1.1).toReal
  rw [freeNormExt_one_ofFVL_eq_banlat]

/-- The canonical linear isometry between the exponent-one model and BanLat’s model. -/
def banlatLinearEquiv :
    Free Exponent.one E ≃ₗᵢ[ℝ] _root_.FBL E :=
  (LinearEquiv.refl ℝ (FVL E)).extendOfIsometry
    (ofFVL Exponent.one (E := E)).toLinearMap (_root_.FBL.ofFVLv (E := E))
    (denseRange_ofFVL Exponent.one (E := E))
    (_root_.FBL.denseRange_ofFVLv (E := E))
    (fun v => (norm_ofFVL_one_eq_banlat v).symm)

private theorem banlat_ofFVLv_sup (v w : FVL E) :
    _root_.FBL.ofFVLv (v ⊔ w) =
      (_root_.FBL.ofFVLv v : _root_.FBL E) ⊔ _root_.FBL.ofFVLv w := by
  change FVLv.lift (_root_.FBL.ofLinear (E := E)) (v ⊔ w) = _
  exact map_sup _ _ _

private theorem banlat_ofFVLv_inf (v w : FVL E) :
    _root_.FBL.ofFVLv (v ⊓ w) =
      (_root_.FBL.ofFVLv v : _root_.FBL E) ⊓ _root_.FBL.ofFVLv w := by
  change FVLv.lift (_root_.FBL.ofLinear (E := E)) (v ⊓ w) = _
  exact map_inf _ _ _

private theorem banlatLinearEquiv_ofFVL (v : FVL E) :
    banlatLinearEquiv (ofFVL Exponent.one v) = _root_.FBL.ofFVLv v := by
  exact LinearEquiv.extendOfIsometry_eq
    (LinearEquiv.refl ℝ (FVL E))
    (ofFVL Exponent.one (E := E)).toLinearMap (_root_.FBL.ofFVLv (E := E))
    (denseRange_ofFVL Exponent.one (E := E))
    (_root_.FBL.denseRange_ofFVLv (E := E))
    (fun w => (norm_ofFVL_one_eq_banlat w).symm) v

-- Keep density arguments abstract so their proofs do not repeatedly reduce the concrete norms.
private theorem map_binary_of_dense_range {A X Y : Type*}
    [TopologicalSpace X] [TopologicalSpace Y] [T2Space Y]
    (i : A → X) (hi : DenseRange i) (f : X → Y) (hf : Continuous f)
    (sourceOperation : X → X → X) (targetOperation : Y → Y → Y)
    (hX : Continuous (fun z : X × X => sourceOperation z.1 z.2))
    (hY : Continuous (fun z : Y × Y => targetOperation z.1 z.2))
    (hcore : ∀ a b, f (sourceOperation (i a) (i b)) = targetOperation (f (i a)) (f (i b)))
    (x y : X) : f (sourceOperation x y) = targetOperation (f x) (f y) := by
  have heq := (hi.prodMap hi).equalizer (hf.comp hX)
    (hY.comp ((hf.comp continuous_fst).prodMk (hf.comp continuous_snd))) (by
      funext z
      exact hcore z.1 z.2)
  exact congrFun heq (x, y)

private theorem banlatLinearEquiv_map_sup (f g : Free Exponent.one E) :
    banlatLinearEquiv (f ⊔ g) = banlatLinearEquiv f ⊔ banlatLinearEquiv g := by
  refine map_binary_of_dense_range
    (ofFVL Exponent.one (E := E)) (denseRange_ofFVL Exponent.one)
    (banlatLinearEquiv (E := E)) banlatLinearEquiv.continuous
    (· ⊔ ·) (· ⊔ ·) (continuous_fst.sup continuous_snd)
    (continuous_fst.sup continuous_snd) ?_ f g
  intro v w
  rw [← map_sup (ofFVL Exponent.one (E := E)) v w,
    banlatLinearEquiv_ofFVL, banlatLinearEquiv_ofFVL,
    banlatLinearEquiv_ofFVL, banlat_ofFVLv_sup]

private theorem banlatLinearEquiv_map_inf (f g : Free Exponent.one E) :
    banlatLinearEquiv (f ⊓ g) = banlatLinearEquiv f ⊓ banlatLinearEquiv g := by
  refine map_binary_of_dense_range
    (ofFVL Exponent.one (E := E)) (denseRange_ofFVL Exponent.one)
    (banlatLinearEquiv (E := E)) banlatLinearEquiv.continuous
    (· ⊓ ·) (· ⊓ ·) (continuous_fst.inf continuous_snd)
    (continuous_fst.inf continuous_snd) ?_ f g
  intro v w
  rw [← map_inf (ofFVL Exponent.one (E := E)) v w,
    banlatLinearEquiv_ofFVL, banlatLinearEquiv_ofFVL,
    banlatLinearEquiv_ofFVL, banlat_ofFVLv_inf]

private theorem banlat_eval_abs_le_norm (g : _root_.FBL E)
    (ψ : FVLv.dualUnitBall E) : |g ψ| ≤ ‖g‖ := by
  have hψnorm : ‖WeakDual.toStrongDual ψ.1‖ ≤ 1 := by
    have hψmem := ψ.property
    change WeakDual.toStrongDual ψ.1 ∈ Metric.closedBall (0 : Dual E) 1 at hψmem
    simpa [Metric.mem_closedBall, dist_eq_norm] using hψmem
  have hAdm : _root_.FBL.NormAdmissible E (fun _ : Fin 1 => ψ) :=
    (normAdmissible_one_iff_ball (fun _ : Fin 1 => ψ)).mp
      (normAdmissible_singleton Exponent.one _ hψnorm)
  have hle : ENNReal.ofReal |g ψ| ≤ _root_.FBL.freeNormExt E g.1.1 := by
    have h : ENNReal.ofReal
        (∑ i : Fin 1, |g ((fun _ : Fin 1 => ψ) i)|) ≤
        _root_.FBL.freeNormExt E g.1.1 := by
      rw [_root_.FBL.freeNormExt]
      exact le_iSup_of_le (1 : ℕ)
        (le_iSup_of_le (fun _ : Fin 1 => ψ) (le_iSup_of_le hAdm le_rfl))
    simpa using h
  have hreal := (ENNReal.ofReal_le_iff_le_toReal (ne_of_lt g.1.2)).mp hle
  exact hreal

/-- Continuous evaluation on BanLat’s free Banach lattice at a dual-ball point. -/
def banlatEvaluation (ψ : FVLv.dualUnitBall E) : _root_.FBL E →L[ℝ] ℝ :=
  ({ toFun := fun g => g ψ
     map_add' := by intros; rfl
     map_smul' := by intros; rfl } : _root_.FBL E →ₗ[ℝ] ℝ).mkContinuous 1 (by
       intro g
       change |g ψ| ≤ 1 * ‖g‖
       simpa only [one_mul] using banlat_eval_abs_le_norm g ψ)

private theorem banlatLinearEquiv_apply (f : Free Exponent.one E)
    (ψ : FVLv.dualUnitBall E) :
    banlatLinearEquiv f ψ = f (WeakDual.toStrongDual ψ.1) := by
  let φ : Dual E := WeakDual.toStrongDual ψ.1
  let e : FVL E → Free Exponent.one E := ofFVL Exponent.one
  have hcL : Continuous (fun g : Free Exponent.one E => banlatLinearEquiv g ψ) :=
    (banlatEvaluation ψ).continuous.comp banlatLinearEquiv.continuous
  have hcR : Continuous (fun g : Free Exponent.one E => g φ) :=
    (hpEvaluation Exponent.one φ).continuous.comp continuous_subtype_val
  have hEq := (denseRange_ofFVL Exponent.one (E := E)).equalizer hcL hcR (by
    funext v
    change banlatLinearEquiv (ofFVL Exponent.one v) ψ =
      ofFVL Exponent.one v φ
    rw [banlatLinearEquiv_ofFVL, banlat_ofFVLv_apply]
    exact (ofFVL_apply_ball Exponent.one v ψ).symm)
  exact congrFun hEq f

/-- Bridge to BanLat's completed ordinary free Banach lattice, at p = 1. -/
theorem banlat_fbl_identification :
    ∃ U : BanachLatEquiv (Free Exponent.one E) (_root_.FBL E),
      ∀ (f : Free Exponent.one E) (φ : FVLv.dualUnitBall E),
        U f φ = f (WeakDual.toStrongDual φ.1) := by
  let U : BanachLatEquiv (Free Exponent.one E) (_root_.FBL E) := {
    toLinearIsometryEquiv := banlatLinearEquiv
    map_sup' := banlatLinearEquiv_map_sup
    map_inf' := banlatLinearEquiv_map_inf }
  exact ⟨U, fun f φ => banlatLinearEquiv_apply f φ⟩

/-- Full-dual homogeneous functions continuous on the weak-star unit ball. -/
def WeakStarContinuousOnBall (f : Dual E → ℝ) : Prop :=
  Continuous (fun φ : FVLv.dualUnitBall E => f (WeakDual.toStrongDual φ.1))

/-- Section 2: weak-star continuity on every bounded dual ball. -/
theorem weakStar_continuous_bounded (p : Exponent) (f : Free p E) (R : ℝ) :
    ContinuousOn (fun φ : WeakDual ℝ E => f (WeakDual.toStrongDual φ))
      {φ | ‖WeakDual.toStrongDual φ‖ ≤ R} := by
  apply continuousOn_of_uniform_approx_of_continuousOn
  intro U hU
  obtain ⟨ε, hε, hUε⟩ := Metric.mem_uniformity_dist.mp hU
  let B : ℝ := max R 0 + 1
  have hB : 0 < B := by dsimp [B]; positivity
  obtain ⟨v, hv⟩ := (denseRange_ofFVL p).exists_dist_lt f
    (show 0 < ε / B by positivity)
  let g : Free p E := ofFVL p v
  have hnorm : ‖f - g‖ < ε / B := by
    simpa only [g, dist_eq_norm] using hv
  refine ⟨(fun φ : WeakDual ℝ E => g (WeakDual.toStrongDual φ)), ?_, ?_⟩
  · exact (ofFVL_weakstar_continuous p v).continuousOn
  · intro φ hφ
    apply hUε
    rw [Real.dist_eq]
    have hbound : ‖WeakDual.toStrongDual φ‖ ≤ B := by
      have hRB : R ≤ B := by dsimp [B]; linarith [le_max_left R 0]
      exact hφ.trans hRB
    have hsmall : B * ‖f - g‖ < ε := by
      have hmul := mul_lt_mul_of_pos_left hnorm hB
      have hcalc : B * (ε / B) = ε := by field_simp
      rw [hcalc] at hmul
      exact hmul
    exact (free_apply_sub_le p f g (WeakDual.toStrongDual φ)).trans_lt
      ((mul_le_mul_of_nonneg_right hbound (norm_nonneg (f - g))).trans_lt hsmall)

/-- Free functions are continuous when the weak-star dual is given its compactly generated
topology. Compact weak-star sets are norm bounded by uniform boundedness, so this follows from
continuity on every norm-bounded dual ball. -/
theorem weakStar_continuous_compactlyGenerated [CompleteSpace E]
    (p : Exponent) (f : Free p E) :
    Continuous[TopologicalSpace.compactlyGenerated (WeakDual ℝ E), inferInstance]
      (fun φ : WeakDual ℝ E => f (WeakDual.toStrongDual φ)) := by
  apply continuous_from_compactlyGenerated
  intro K g
  have hb : Bornology.IsBounded (Set.range (g : K → WeakDual ℝ E)) :=
    (WeakDual.isBounded_iff_isVonNBounded).mpr
      ((isCompact_range g.continuous).isVonNBounded ℝ)
  obtain ⟨R, hR⟩ := isBounded_iff_forall_norm_le.mp hb
  exact (weakStar_continuous_bounded p f R).comp_continuous g.continuous
    (fun k => hR (g k) ⟨k, rfl⟩)

/-- The zero-centered norm ball in the weak dual. -/
def weakDualNormBall (R : ℝ) : Set (WeakDual ℝ E) :=
  {φ | ‖WeakDual.toStrongDual φ‖ ≤ R}

/-- On a Banach dual, the compactly generated weak-star closed sets are exactly those whose
intersections with all norm balls are weak-star closed. The forward direction uses compactness
of weak-star closed dual balls; the reverse direction uses uniform boundedness on compact sets. -/
theorem weakDual_isClosed_compactlyGenerated_iff [CompleteSpace E]
    (s : Set (WeakDual ℝ E)) :
    @IsClosed (WeakDual ℝ E)
      (TopologicalSpace.compactlyGenerated.{u} (WeakDual ℝ E)) s ↔
      ∀ R : ℝ, IsClosed (s ∩ weakDualNormBall (E := E) R) := by
  constructor
  · intro h
    have hk : ∀ (K : CompHaus.{u}) (g : C(K, WeakDual ℝ E)),
        IsClosed (g ⁻¹' s) := by
      rw [TopologicalSpace.compactlyGenerated, isClosed_coinduced,
        isClosed_sigma_iff] at h
      intro K g
      simpa only [Set.preimage_preimage] using h ⟨K, g⟩
    intro R
    have hBclosed : IsClosed (weakDualNormBall (E := E) R) := by
      convert WeakDual.isClosed_closedBall (0 : Dual E) R using 1
      ext φ
      simp [weakDualNormBall, Metric.mem_closedBall, dist_zero_right]
    have hBcompact : IsCompact (weakDualNormBall (E := E) R) := by
      convert WeakDual.isCompact_closedBall (0 : Dual E) R using 1
      ext φ
      simp [weakDualNormBall, Metric.mem_closedBall, dist_zero_right]
    let : CompactSpace (weakDualNormBall (E := E) R) :=
      isCompact_iff_compactSpace.mp hBcompact
    let K : CompHaus.{u} := CompHaus.of (weakDualNormBall (E := E) R)
    let g : C(K, WeakDual ℝ E) := ⟨Subtype.val, continuous_subtype_val⟩
    have hpre : IsClosed (g ⁻¹' s) := hk K g
    have himage : IsClosed
        ((Subtype.val : weakDualNormBall (E := E) R → WeakDual ℝ E) ''
          ((Subtype.val : weakDualNormBall (E := E) R → WeakDual ℝ E) ⁻¹' s)) :=
      hBclosed.isClosedMap_subtype_val _ hpre
    convert himage using 1
    ext φ
    simp [weakDualNormBall, and_comm]
  · intro h
    rw [TopologicalSpace.compactlyGenerated, isClosed_coinduced,
      isClosed_sigma_iff]
    intro ⟨K, g⟩
    change IsClosed (g ⁻¹' s)
    have hb : Bornology.IsBounded (Set.range (g : K → WeakDual ℝ E)) :=
      (WeakDual.isBounded_iff_isVonNBounded).mpr
        ((isCompact_range g.continuous).isVonNBounded ℝ)
    obtain ⟨R, hR⟩ := isBounded_iff_forall_norm_le.mp hb
    have hs : g ⁻¹' s = g ⁻¹' (s ∩ weakDualNormBall (E := E) R) := by
      ext k
      have hk := hR (g k) ⟨k, rfl⟩
      change ‖WeakDual.toStrongDual (g k)‖ ≤ R at hk
      simp [weakDualNormBall, hk]
    rw [hs]
    exact (h R).preimage g.continuous

/-- The easy direction of the endpoint representation: every free function is homogeneous and
weak-star continuous on the dual unit ball. -/
theorem inFree_infinity_imp (f : Dual E → ℝ)
    (hf : InFree Exponent.infinity f) :
    PosHomogeneous f ∧ WeakStarContinuousOnBall f := by
  obtain ⟨g, hg⟩ := hf
  constructor
  · intro a ha φ
    calc
      f (a • φ) = g (a • φ) := (hg _).symm
      _ = a * g φ := g.1.2.1 a ha φ
      _ = a * f φ := by rw [hg]
  · have hc : Continuous (fun ψ : FVLv.dualUnitBall E =>
        g (WeakDual.toStrongDual ψ.1)) :=
      (weakStar_continuous_bounded Exponent.infinity g 1).comp_continuous
        continuous_subtype_val (fun ψ => by
          have hψ := ψ.2
          change WeakDual.toStrongDual ψ.1 ∈
            Metric.closedBall (0 : Dual E) 1 at hψ
          change ‖WeakDual.toStrongDual ψ.1‖ ≤ 1
          simpa only [Metric.mem_closedBall, dist_zero_right] using hψ)
    change Continuous (fun ψ : FVLv.dualUnitBall E =>
      f (WeakDual.toStrongDual ψ.1))
    convert hc using 1
    funext ψ
    exact (hg _).symm

/-- Weak-star continuity on the compact dual ball makes the endpoint free norm finite. -/
theorem weakStar_homogeneous_mem_HP_infinity (f : Dual E → ℝ)
    (hhom : PosHomogeneous f) (hcont : WeakStarContinuousOnBall f) :
    f ∈ finiteNormSublattice Exponent.infinity E := by
  refine ⟨hhom, ?_⟩
  let g : C(FVLv.dualUnitBall E, ℝ) := ⟨fun ψ => f (WeakDual.toStrongDual ψ.1), hcont⟩
  have hbound (φ : Dual E) (hφ : ‖φ‖ ≤ 1) : |f φ| ≤ ‖g‖ := by
    have hm : WeakDual.toStrongDual (StrongDual.toWeakDual φ) ∈
        Metric.closedBall (0 : Dual E) 1 := by
      change φ ∈ Metric.closedBall (0 : Dual E) 1
      simpa only [Metric.mem_closedBall, dist_zero_right] using hφ
    let ψ : FVLv.dualUnitBall E := ⟨StrongDual.toWeakDual φ, hm⟩
    have h := ContinuousMap.norm_coe_le_norm g ψ
    change ‖f φ‖ ≤ ‖g‖ at h
    simpa only [Real.norm_eq_abs] using h
  have hle : freeNormExt Exponent.infinity f ≤ ENNReal.ofReal ‖g‖ := by
    rw [freeNormExt, ite_eq_left (show (Exponent.infinity : Exponent).1 = ⊤ by rfl)]
    exact iSup_le fun φ => iSup_le fun hφ => ENNReal.ofReal_le_ofReal (hbound φ hφ)
  exact hle.trans_lt ENNReal.ofReal_lt_top

/-- A target-relative version of lattice Stone–Weierstrass: interpolating the target at
each pair of points suffices to approximate that target uniformly. This does not require
the lattice to contain nonzero constants. -/
private theorem relative_sublattice_stone_weierstrass
    {K : Type*} [TopologicalSpace K] [CompactSpace K]
    (L : Set C(K, ℝ)) (hL : L.Nonempty)
    (hInf : ∀ a ∈ L, ∀ b ∈ L, a ⊓ b ∈ L)
    (hSup : ∀ a ∈ L, ∀ b ∈ L, a ⊔ b ∈ L)
    (f : C(K, ℝ))
    (hInterp : ∀ x y : K, ∃ g ∈ L, g x = f x ∧ g y = f y) :
    f ∈ closure L := by
  refine Filter.Frequently.mem_closure
    ((Filter.HasBasis.frequently_iff Metric.nhds_basis_ball).mpr fun ε hε => ?_)
  simp only [Metric.mem_ball]
  by_cases hK : Nonempty K
  swap
  · exact ⟨hL.some, (ContinuousMap.dist_lt_iff hε).mpr fun x => False.elim (hK ⟨x⟩),
      hL.choose_spec⟩
  choose g hg gx gy using hInterp
  let V : K → K → Set K := fun x y => {z | f z - ε < g x y z}
  have hV (x y : K) : V x y ∈ 𝓝 y := by
    apply IsOpen.mem_nhds
    · exact isOpen_lt (f.continuous.sub continuous_const) (g x y).continuous
    · dsimp [V]
      rw [gy]
      linarith
  let ys : K → Finset K := fun x =>
    (CompactSpace.elim_nhds_subcover (V x) (hV x)).choose
  have hys (x : K) : ⋃ y ∈ ys x, V x y = ⊤ :=
    (CompactSpace.elim_nhds_subcover (V x) (hV x)).choose_spec
  have hys_ne (x : K) : (ys x).Nonempty :=
    Set.nonempty_of_union_eq_top_of_nonempty _ _ hK (hys x)
  let a : K → C(K, ℝ) := fun x => (ys x).sup' (hys_ne x) (g x)
  have haL (x : K) : a x ∈ L := by
    dsimp [a]
    exact Finset.sup'_mem _ hSup _ _ _ (fun y _ => hg x y)
  have halow (x z : K) : f z - ε < a x z := by
    obtain ⟨y, hym, hz⟩ := Set.exists_set_mem_of_union_eq_top _ _ (hys x) z
    dsimp [a]
    simp only [ContinuousMap.sup'_apply, Finset.lt_sup'_iff]
    exact ⟨y, hym, hz⟩
  have haeq (x : K) : a x x = f x := by
    dsimp [a]
    simp [gx]
  let W : K → Set K := fun x => {z | a x z < f z + ε}
  have hW (x : K) : W x ∈ 𝓝 x := by
    apply IsOpen.mem_nhds
    · exact isOpen_lt (a x).continuous (f.continuous.add continuous_const)
    · dsimp [W]
      rw [haeq]
      linarith
  let xs : Finset K := (CompactSpace.elim_nhds_subcover W hW).choose
  have hxs : ⋃ x ∈ xs, W x = ⊤ :=
    (CompactSpace.elim_nhds_subcover W hW).choose_spec
  have hxs_ne : xs.Nonempty :=
    Set.nonempty_of_union_eq_top_of_nonempty _ _ hK hxs
  let b : C(K, ℝ) := xs.inf' hxs_ne a
  have hbL : b ∈ L := by
    dsimp [b]
    exact Finset.inf'_mem _ hInf _ _ _ (fun x _ => haL x)
  refine ⟨b, ?_, hbL⟩
  rw [ContinuousMap.dist_lt_iff hε]
  intro z
  rw [show ∀ c d ε : ℝ, dist c d < ε ↔ c < d + ε ∧ d - ε < c by
    intros; simp only [← Metric.mem_ball, Real.ball_eq_Ioo, Set.mem_Ioo, and_comm]]
  constructor
  · simp only [b, Finset.inf'_lt_iff, ContinuousMap.inf'_apply]
    exact Set.exists_set_mem_of_union_eq_top _ _ hxs z
  · simp only [b, Finset.lt_inf'_iff, ContinuousMap.inf'_apply]
    intro x _
    exact halow x z

/-- A nonzero dual functional has a vector on which it does not vanish. -/
private theorem exists_eval_ne_zero (φ : Dual E) (hφ : φ ≠ 0) :
    ∃ x : E, φ x ≠ 0 := by
  by_contra h
  push Not at h
  apply hφ
  ext x
  exact h x

/-- Algebraic free-lattice expressions interpolate a positively homogeneous function
at any two points of the weak-star dual ball. -/
private theorem fvl_two_point_interp (f : Dual E → ℝ) (hhom : PosHomogeneous f)
    (φ ψ : FVLv.dualUnitBall E) :
    ∃ v : FVL E,
      v φ = f (WeakDual.toStrongDual φ.1) ∧
      v ψ = f (WeakDual.toStrongDual ψ.1) := by
  let φD : Dual E := WeakDual.toStrongDual φ.1
  let ψD : Dual E := WeakDual.toStrongDual ψ.1
  have hfzero : f 0 = 0 := by
    simpa using hhom 0 le_rfl (0 : Dual E)
  by_cases hφ : φD = 0
  · by_cases hψ : ψD = 0
    · refine ⟨0, ?_, ?_⟩ <;> simp [φD, ψD, hφ, hψ, hfzero]
    · obtain ⟨x, hx⟩ := exists_eval_ne_zero ψD hψ
      let v : FVL E := (f ψD / ψD x) • FVLv.of x
      refine ⟨v, ?_, ?_⟩
      · change (f ψD / ψD x) * φD x = f φD
        simp [hφ, hfzero]
      · change (f ψD / ψD x) * ψD x = f ψD
        field_simp
  · by_cases hψ : ψD = 0
    · obtain ⟨x, hx⟩ := exists_eval_ne_zero φD hφ
      let v : FVL E := (f φD / φD x) • FVLv.of x
      refine ⟨v, ?_, ?_⟩
      · change (f φD / φD x) * φD x = f φD
        field_simp
      · change (f φD / φD x) * ψD x = f ψD
        simp [hψ, hfzero]
    · obtain ⟨x, hx⟩ := exists_eval_ne_zero φD hφ
      obtain ⟨y, hy⟩ := exists_eval_ne_zero ψD hψ
      let u : FVL E := |FVLv.of x| + |FVLv.of y|
      have hu (θ : FVLv.dualUnitBall E) :
          u θ = |(WeakDual.toStrongDual θ.1 : Dual E) x| +
            |(WeakDual.toStrongDual θ.1 : Dual E) y| := rfl
      have huφ : 0 < u φ := by
        rw [hu]
        have hx' : 0 < |φD x| := abs_pos.mpr hx
        change 0 < |φD x| + |φD y|
        positivity
      have huψ : 0 < u ψ := by
        rw [hu]
        have hy' : 0 < |ψD y| := abs_pos.mpr hy
        change 0 < |ψD x| + |ψD y|
        positivity
      by_cases hsep : ∃ z : E, φD z * u ψ ≠ ψD z * u φ
      · obtain ⟨z, hz⟩ := hsep
        let d : ℝ := φD z * u ψ - ψD z * u φ
        have hd : d ≠ 0 := sub_ne_zero.mpr hz
        let a : ℝ := (f φD * u ψ - f ψD * u φ) / d
        let b : ℝ := (φD z * f ψD - ψD z * f φD) / d
        let v : FVL E := a • FVLv.of z + b • u
        refine ⟨v, ?_, ?_⟩
        · change a * φD z + b * u φ = f φD
          dsimp [a, b]
          field_simp [hd]
          dsimp [d] at *
          ring
        · change a * ψD z + b * u ψ = f ψD
          dsimp [a, b]
          field_simp [hd]
          dsimp [d] at *
          ring
      · push Not at hsep
        let c : ℝ := u ψ / u φ
        have hc : 0 ≤ c := by dsimp [c]; positivity
        have hψeq : ψD = c • φD := by
          ext z
          change ψD z = c * φD z
          dsimp [c]
          have hz := hsep z
          field_simp [huφ.ne']
          nlinarith
        let v : FVL E := (f φD / u φ) • u
        refine ⟨v, ?_, ?_⟩
        · change (f φD / u φ) * u φ = f φD
          field_simp
        · change (f φD / u φ) * u ψ = f ψD
          rw [hψeq, hhom c hc φD]
          dsimp [c]
          field_simp

/-- Restriction of an endpoint free function to the weak-star dual unit ball is an
isometry onto a closed subspace of continuous functions. -/
def infinityRestriction : Free Exponent.infinity E →ₗᵢ[ℝ]
    C(FVLv.dualUnitBall E, ℝ) where
  toFun g :=
    ⟨fun ψ => g (WeakDual.toStrongDual ψ.1),
      (inFree_infinity_imp (fun φ => g φ) ⟨g, fun _ => rfl⟩).2⟩
  map_add' := by
    intro g h
    ext ψ
    rfl
  map_smul' := by
    intro c g
    ext ψ
    rfl
  norm_map' := by
    intro g
    apply le_antisymm
    · apply (ContinuousMap.norm_le (f :=
        (⟨fun ψ => g (WeakDual.toStrongDual ψ.1),
          (inFree_infinity_imp (fun φ => g φ) ⟨g, fun _ => rfl⟩).2⟩ :
            C(FVLv.dualUnitBall E, ℝ))) (norm_nonneg g)).2
      intro ψ
      have hψ : ‖WeakDual.toStrongDual ψ.1‖ ≤ 1 := by
        have hm := ψ.2
        change WeakDual.toStrongDual ψ.1 ∈
          Metric.closedBall (0 : Dual E) 1 at hm
        simpa only [Metric.mem_closedBall, dist_zero_right] using hm
      change |g (WeakDual.toStrongDual ψ.1)| ≤ ‖g‖
      exact hp_unit_eval_le Exponent.infinity g.1 (WeakDual.toStrongDual ψ.1) hψ
    · change (freeNormExt Exponent.infinity g).toReal ≤
        ‖(⟨fun ψ => g (WeakDual.toStrongDual ψ.1),
          (inFree_infinity_imp (fun φ => g φ) ⟨g, fun _ => rfl⟩).2⟩ :
            C(FVLv.dualUnitBall E, ℝ))‖
      apply ENNReal.toReal_le_of_le_ofReal (norm_nonneg _)
      rw [freeNormExt, ite_eq_left (show (Exponent.infinity : Exponent).1 = ⊤ by rfl)]
      refine iSup_le fun φ => iSup_le fun hφ => ?_
      let ψ : FVLv.dualUnitBall E := ⟨StrongDual.toWeakDual φ, by
        change φ ∈ Metric.closedBall (0 : Dual E) 1
        simpa only [Metric.mem_closedBall, dist_zero_right] using hφ⟩
      have hval := ContinuousMap.norm_coe_le_norm
        (⟨fun ψ => g (WeakDual.toStrongDual ψ.1),
          (inFree_infinity_imp (fun φ => g φ) ⟨g, fun _ => rfl⟩).2⟩ :
            C(FVLv.dualUnitBall E, ℝ)) ψ
      change ‖g φ‖ ≤ _ at hval
      exact ENNReal.ofReal_le_ofReal (by
        simpa only [Real.norm_eq_abs] using hval)

/-- Equation (2.2): a full-dual function belongs to the infinity free lattice exactly
when it is positively homogeneous and weak-star continuous on the dual unit ball.
The reverse implication uses lattice approximation on that compact ball. -/
theorem infinity_representation (f : Dual E → ℝ) :
    InFree Exponent.infinity f ↔ PosHomogeneous f ∧ WeakStarContinuousOnBall f := by
  constructor
  · exact inFree_infinity_imp f
  · intro hf
    have hfHP : f ∈ finiteNormSublattice Exponent.infinity E :=
      weakStar_homogeneous_mem_HP_infinity f hf.1 hf.2
    have hfFree : (⟨f, hfHP⟩ : HP Exponent.infinity E) ∈
        freeSublattice Exponent.infinity E := by
      let r : Free Exponent.infinity E →ₗᵢ[ℝ] C(FVLv.dualUnitBall E, ℝ) :=
        infinityRestriction
      let L : Set C(FVLv.dualUnitBall E, ℝ) := Set.range r
      let fBall : C(FVLv.dualUnitBall E, ℝ) :=
        ⟨fun ψ => f (WeakDual.toStrongDual ψ.1), hf.2⟩
      have hL : L.Nonempty := ⟨r 0, 0, rfl⟩
      have hInf : ∀ a ∈ L, ∀ b ∈ L, a ⊓ b ∈ L := by
        rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
        refine ⟨a ⊓ b, ?_⟩
        ext ψ
        rfl
      have hSup : ∀ a ∈ L, ∀ b ∈ L, a ⊔ b ∈ L := by
        rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
        refine ⟨a ⊔ b, ?_⟩
        ext ψ
        rfl
      have hInterp (ψ χ : FVLv.dualUnitBall E) :
          ∃ g ∈ L, g ψ = fBall ψ ∧ g χ = fBall χ := by
        obtain ⟨v, hvψ, hvχ⟩ := fvl_two_point_interp f hf.1 ψ χ
        refine ⟨r (ofFVL Exponent.infinity v),
          ⟨ofFVL Exponent.infinity v, rfl⟩, ?_, ?_⟩
        · exact (ofFVL_apply_ball Exponent.infinity v ψ).trans hvψ
        · exact (ofFVL_apply_ball Exponent.infinity v χ).trans hvχ
      have hclosure : fBall ∈ closure L :=
        relative_sublattice_stone_weierstrass L hL hInf hSup fBall hInterp
      have hclosed : IsClosed L :=
        r.isometry.isUniformInducing.isComplete_range.isClosed
      obtain ⟨g, hg⟩ : fBall ∈ L := hclosed.closure_eq ▸ hclosure
      have hfun (φ : Dual E) : g φ = f φ := by
        let ψ := normalizedDual φ
        have hscale : ‖φ‖ • WeakDual.toStrongDual ψ.1 = φ := by
          change ‖φ‖ • (‖φ‖⁻¹ • φ) = φ
          by_cases hφ : φ = 0
          · subst φ
            simp
          · rw [smul_smul, mul_inv_cancel₀ (norm_ne_zero_iff.mpr hφ), one_smul]
        have hball : g (WeakDual.toStrongDual ψ.1) =
            f (WeakDual.toStrongDual ψ.1) := by
          have h := congrArg (fun a : C(FVLv.dualUnitBall E, ℝ) => a ψ) hg
          exact h
        calc
          g φ = g (‖φ‖ • WeakDual.toStrongDual ψ.1) :=
            congrArg (fun θ => g θ) hscale.symm
          _ = ‖φ‖ * g (WeakDual.toStrongDual ψ.1) :=
            g.1.2.1 ‖φ‖ (norm_nonneg φ) _
          _ = ‖φ‖ * f (WeakDual.toStrongDual ψ.1) := by rw [hball]
          _ = f φ := by rw [← hf.1 ‖φ‖ (norm_nonneg φ) _, hscale]
      have heq : (⟨f, hfHP⟩ : HP Exponent.infinity E) = g.1 := by
        apply Subtype.ext
        funext φ
        exact (hfun φ).symm
      rw [heq]
      exact g.2
    exact ⟨⟨⟨f, hfHP⟩, hfFree⟩, fun _ => rfl⟩

/-- Section 2: full-dual norm continuity, used in the polar-restriction argument. -/
theorem free_function_norm_continuous (p : Exponent) (f : Free p E) :
    Continuous (f : Dual E → ℝ) := by
  refine Metric.continuous_iff.mpr fun φ ε hε => ?_
  let R : ℝ := ‖φ‖ + 1
  have hR : 0 < R := by dsimp [R]; positivity
  obtain ⟨v, hv⟩ := (denseRange_ofFVL p).exists_dist_lt f
    (show 0 < ε / (6 * R) by positivity)
  let g : Free p E := ofFVL p v
  have hnorm : ‖f - g‖ < ε / (6 * R) := by
    simpa only [g, dist_eq_norm] using hv
  obtain ⟨δ, hδ, hcont⟩ := Metric.continuousAt_iff.mp
    (ofFVL_norm_continuous p v).continuousAt (ε / 3) (by positivity)
  refine ⟨min δ 1, lt_min hδ zero_lt_one, ?_⟩
  intro ψ hψ
  have hψδ : dist ψ φ < δ := lt_of_lt_of_le hψ (min_le_left _ _)
  have hψ1 : dist ψ φ < 1 := lt_of_lt_of_le hψ (min_le_right _ _)
  have hψnorm : ‖ψ‖ ≤ R := by
    calc
      ‖ψ‖ = ‖(ψ - φ) + φ‖ := by rw [sub_add_cancel]
      _ ≤ ‖ψ - φ‖ + ‖φ‖ := norm_add_le _ _
      _ = dist ψ φ + ‖φ‖ := by rw [dist_eq_norm]
      _ ≤ R := by dsimp [R]; linarith
  have hφnorm : ‖φ‖ ≤ R := by dsimp [R]; linarith
  have hsmall : R * ‖f - g‖ < ε / 6 := by
    have hmul := mul_lt_mul_of_pos_left hnorm hR
    have hcalc : R * (ε / (6 * R)) = ε / 6 := by
      field_simp
    rw [hcalc] at hmul
    exact hmul
  have hψerr : dist (f ψ) (g ψ) < ε / 6 := by
    calc
      dist (f ψ) (g ψ) = |f ψ - g ψ| := Real.dist_eq ..
      _ ≤ ‖ψ‖ * ‖f - g‖ := free_apply_sub_le p f g ψ
      _ ≤ R * ‖f - g‖ := mul_le_mul_of_nonneg_right hψnorm (norm_nonneg _)
      _ < ε / 6 := hsmall
  have hφerr : dist (f φ) (g φ) < ε / 6 := by
    calc
      dist (f φ) (g φ) = |f φ - g φ| := Real.dist_eq ..
      _ ≤ ‖φ‖ * ‖f - g‖ := free_apply_sub_le p f g φ
      _ ≤ R * ‖f - g‖ := mul_le_mul_of_nonneg_right hφnorm (norm_nonneg _)
      _ < ε / 6 := hsmall
  have hgdiff : dist (g ψ) (g φ) < ε / 3 := hcont hψδ
  have hψerr' : dist (g ψ) (f ψ) < ε / 6 := by
    simpa only [dist_comm] using hψerr
  have hφerr' : dist (g φ) (f φ) < ε / 6 := by
    simpa only [dist_comm] using hφerr
  calc
    dist (f ψ) (f φ) ≤ dist (g ψ) (g φ) +
        (dist (g ψ) (f ψ) + dist (g φ) (f φ)) := dist_triangle4_left ..
    _ < ε := by linarith

/-- A norm-continuous real lattice homomorphism, retaining both bundled APIs. -/
structure LatticeOperator (X : Type u) (Y : Type v)
    [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [NormedVectorLattice X]
    [NormedAddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y] [NormedVectorLattice Y]
    extends X →L[ℝ] Y where
  /-- Preservation of binary lattice suprema by the underlying continuous linear map. -/
  map_sup' : ∀ x y, toContinuousLinearMap (x ⊔ y) =
    toContinuousLinearMap x ⊔ toContinuousLinearMap y
  /-- Preservation of binary lattice infima by the underlying continuous linear map. -/
  map_inf' : ∀ x y, toContinuousLinearMap (x ⊓ y) =
    toContinuousLinearMap x ⊓ toContinuousLinearMap y

namespace LatticeOperator
variable {X : Type u} {Y : Type v}
  [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [NormedVectorLattice X]
  [NormedAddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y] [NormedVectorLattice Y]
instance : CoeFun (LatticeOperator X Y) (fun _ => X → Y) :=
  ⟨fun T => T.toContinuousLinearMap⟩
/-- Forget the continuity data of a bounded lattice operator, retaining its real linear
map and preservation of suprema and infima in BanLat’s `VecLatHom` interface. -/
def toVecLatHom (T : LatticeOperator X Y) : VecLatHom X Y :=
  { T.toContinuousLinearMap.toLinearMap with
    map_sup' := T.map_sup', map_inf' := T.map_inf' }
end LatticeOperator

/-- A bounded lattice homomorphism out of the free lattice is determined by its generators. -/
theorem latticeOperator_ext_delta (p : Exponent) {X : Type w}
    [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [BanachLattice X]
    (M N : LatticeOperator (Free p E) X)
    (h : ∀ x : E, M (delta p x) = N (delta p x)) : M = N := by
  let T : E →ₗ[ℝ] X := M.toContinuousLinearMap.toLinearMap.comp (delta p).toLinearMap
  have hM : M.toVecLatHom.comp (ofFVL p) = FVLv.lift T :=
    FVLv.lift_unique T _ (by
      intro x
      change M (ofFVL p (FVLv.of x)) = M (delta p x)
      rw [ofFVL_of])
  have hN : N.toVecLatHom.comp (ofFVL p) = FVLv.lift T :=
    FVLv.lift_unique T _ (by
      intro x
      change N (ofFVL p (FVLv.of x)) = M (delta p x)
      rw [ofFVL_of]
      exact (h x).symm)
  have hMN : M.toVecLatHom.comp (ofFVL p) =
      N.toVecLatHom.comp (ofFVL p) := hM.trans hN.symm
  have hfun : (M : Free p E → X) = (N : Free p E → X) :=
    (denseRange_ofFVL p).equalizer M.toContinuousLinearMap.continuous
      N.toContinuousLinearMap.continuous (by
        funext v
        exact DFunLike.congr_fun hMN v)
  have hlin : M.toContinuousLinearMap = N.toContinuousLinearMap := by
    ext f
    exact congrFun hfun f
  cases M with
  | mk m hsup hinf =>
    cases N with
    | mk n hsup' hinf' =>
      cases hlin
      rfl

private theorem freeNormExt_comp_le (p : Exponent) (T : F →L[ℝ] E)
    (f : Dual F → ℝ) (hf : PosHomogeneous f) :
    freeNormExt p (fun φ : Dual E => f (φ.comp T)) ≤
      ENNReal.ofReal ‖T‖ * freeNormExt p f := by
  by_cases hT0 : ‖T‖ = 0
  · have hT : T = 0 := norm_eq_zero.mp hT0
    have hf0 : f 0 = 0 := by
      have h := hf 0 (le_refl 0) (0 : Dual F)
      simpa using h
    have hfun : (fun φ : Dual E => f (φ.comp T)) = fun _ => 0 := by
      funext φ
      simp [hT, hf0]
    rw [hfun, freeNormExt_zero, hT0, ENNReal.ofReal_zero, zero_mul]
  · have hT : 0 < ‖T‖ := lt_of_le_of_ne (norm_nonneg T) (Ne.symm hT0)
    by_cases htop : p.1 = ⊤
    · rw [freeNormExt, ite_eq_left htop]
      refine iSup_le fun φ => iSup_le fun hφ => ?_
      let ψ : Dual F := ‖T‖⁻¹ • φ.comp T
      have hcomp : ‖φ.comp T‖ ≤ ‖T‖ := by
        calc
          ‖φ.comp T‖ ≤ ‖φ‖ * ‖T‖ := φ.opNorm_comp_le T
          _ ≤ 1 * ‖T‖ := mul_le_mul_of_nonneg_right hφ (norm_nonneg T)
          _ = ‖T‖ := one_mul _
      have hψ : ‖ψ‖ ≤ 1 := by
        dsimp [ψ]
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hT)]
        calc
          ‖T‖⁻¹ * ‖φ.comp T‖ ≤ ‖T‖⁻¹ * ‖T‖ :=
            mul_le_mul_of_nonneg_left hcomp (le_of_lt (inv_pos.mpr hT))
          _ = 1 := inv_mul_cancel₀ hT.ne'
      have hscaled : ‖T‖ • ψ = φ.comp T := by
        dsimp [ψ]
        rw [smul_smul, mul_inv_cancel₀ hT.ne', one_smul]
      have hval : f (φ.comp T) = ‖T‖ * f ψ := by
        rw [← hscaled, hf ‖T‖ (le_of_lt hT) ψ]
      have hle := ofReal_abs_le_freeNormExt p f ψ hψ
      calc
        ENNReal.ofReal |f (φ.comp T)| =
            ENNReal.ofReal ‖T‖ * ENNReal.ofReal |f ψ| := by
          rw [hval, abs_mul, abs_of_nonneg (norm_nonneg T),
            ENNReal.ofReal_mul (norm_nonneg T)]
        _ ≤ ENNReal.ofReal ‖T‖ * freeNormExt p f :=
          mul_le_mul_of_nonneg_left hle (by positivity)
    · rw [freeNormExt, ite_eq_right htop]
      refine iSup_le fun n => iSup_le fun φ => iSup_le fun hφ => ?_
      let ψ : Fin n → Dual F := fun i => ‖T‖⁻¹ • (φ i).comp T
      have hψ : NormAdmissible p ψ := normAdmissible_comp_scaled p T hT φ hφ
      have hscaled (i : Fin n) : ‖T‖ • ψ i = (φ i).comp T := by
        dsimp [ψ]
        rw [smul_smul, mul_inv_cancel₀ hT.ne', one_smul]
      have hfun : (fun i => f ((φ i).comp T)) = fun i => ‖T‖ * f (ψ i) := by
        funext i
        rw [← hscaled i, hf ‖T‖ (le_of_lt hT) (ψ i)]
      have hle : ENNReal.ofReal (scalarPSum p (fun i => f (ψ i))) ≤
          freeNormExt p f := by
        rw [freeNormExt, ite_eq_right htop]
        exact le_iSup_of_le n (le_iSup_of_le ψ (le_iSup_of_le hψ le_rfl))
      calc
        ENNReal.ofReal (scalarPSum p (fun i => f ((φ i).comp T))) =
            ENNReal.ofReal ‖T‖ *
              ENNReal.ofReal (scalarPSum p (fun i => f (ψ i))) := by
          rw [hfun, scalarPSum_smul, abs_of_pos hT,
            ENNReal.ofReal_mul (norm_nonneg T)]
        _ ≤ ENNReal.ofReal ‖T‖ * freeNormExt p f :=
          mul_le_mul_of_nonneg_left hle (by positivity)

private theorem freeNormExt_comp_norm_le (p : Exponent) (T : F →L[ℝ] E)
    (f : Free p F) :
    (freeNormExt p (fun φ : Dual E => f (φ.comp T))).toReal ≤ ‖T‖ * ‖f‖ := by
  have hle := freeNormExt_comp_le p T f.1.1 f.1.2.1
  have hnorm : freeNormExt p f.1.1 = ENNReal.ofReal ‖f‖ :=
    freeNormExt_eq_norm p f
  rw [hnorm, ← ENNReal.ofReal_mul (norm_nonneg T)] at hle
  exact ENNReal.toReal_le_of_le_ofReal
    (mul_nonneg (norm_nonneg T) (norm_nonneg f)) hle

private theorem hp_comp_norm_le (p : Exponent) (T : F →L[ℝ] E)
    (f : HP p F) :
    (freeNormExt p (fun φ : Dual E => f (φ.comp T))).toReal ≤ ‖T‖ * ‖f‖ := by
  have hle := freeNormExt_comp_le p T f.1 f.2.1
  have htop : ENNReal.ofReal ‖T‖ * freeNormExt p f.1 ≠ ⊤ :=
    ne_of_lt (ENNReal.mul_lt_top ENNReal.ofReal_lt_top f.2.2)
  calc
    (freeNormExt p (fun φ : Dual E => f (φ.comp T))).toReal ≤
        (ENNReal.ofReal ‖T‖ * freeNormExt p f.1).toReal :=
      ENNReal.toReal_mono htop hle
    _ = ‖T‖ * ‖f‖ := by
      rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal (norm_nonneg T)]
      rfl

/-- The lattice operator on homogeneous functions induced by composition with an adjoint. -/
def compHP (p : Exponent) (T : F →L[ℝ] E) :
    LatticeOperator (HP p F) (HP p E) where
  toFun f := ⟨fun φ => f (φ.comp T), by
    refine ⟨?_, ?_⟩
    · intro a ha φ
      change f ((a • φ).comp T) = a * f (φ.comp T)
      have hcomp : (a • φ).comp T = a • (φ.comp T) := by
        ext x
        rfl
      rw [hcomp]
      exact f.2.1 a ha (φ.comp T)
    · exact (freeNormExt_comp_le p T f.1 f.2.1).trans_lt
        (ENNReal.mul_lt_top ENNReal.ofReal_lt_top f.2.2)⟩
  map_add' := by
    intro f g
    apply Subtype.ext
    funext φ
    rfl
  map_smul' := by
    intro c f
    apply Subtype.ext
    funext φ
    rfl
  cont := by
    refine (Metric.continuous_iff (α := HP p F) (β := HP p E)).mpr fun f ε hε => ?_
    let K : ℝ := ‖T‖ + 1
    have hK : 0 < K := by dsimp [K]; positivity
    refine ⟨ε / K, by positivity, ?_⟩
    intro g hgf
    erw [dist_eq_norm] at hgf ⊢
    change (freeNormExt p (fun φ : Dual E => (g - f) (φ.comp T))).toReal < ε
    calc
      (freeNormExt p (fun φ : Dual E => (g - f) (φ.comp T))).toReal ≤
          ‖T‖ * ‖g - f‖ := hp_comp_norm_le p T (g - f)
      _ ≤ K * ‖g - f‖ :=
        mul_le_mul_of_nonneg_right (by dsimp [K]; linarith) (norm_nonneg _)
      _ < ε := by
        have hmul := mul_lt_mul_of_pos_left hgf hK
        have hcalc : K * (ε / K) = ε := by field_simp
        rw [hcalc] at hmul
        exact hmul
  map_sup' := by
    intro f g
    apply Subtype.ext
    funext φ
    rfl
  map_inf' := by
    intro f g
    apply Subtype.ext
    funext φ
    rfl

private theorem compHP_mem_free (p : Exponent) (T : F →L[ℝ] E)
    (f : Free p F) : compHP p T f.1 ∈ freeSublattice p E := by
  let D : VectorSublattice (HP p F) := {
    toSubmodule := {
      carrier := {h | compHP p T h ∈ freeSublattice p E}
      zero_mem' := by
        change compHP p T (0 : HP p F) ∈ freeSublattice p E
        rw [map_zero]
        exact (freeSublattice p E).zero_mem
      add_mem' := by
        intro h k hh hk
        change compHP p T (h + k) ∈ freeSublattice p E
        rw [map_add]
        exact (freeSublattice p E).add_mem hh hk
      smul_mem' := by
        intro c h hh
        change compHP p T (c • h) ∈ freeSublattice p E
        rw [map_smul]
        exact (freeSublattice p E).smul_mem c hh }
    sup_mem' := by
      intro h k hh hk
      change compHP p T (h ⊔ k) ∈ freeSublattice p E
      rw [(compHP p T).map_sup']
      exact (freeSublattice p E).sup_mem hh hk }
  have hDclosed : IsClosed (D : Set (HP p F)) := by
    change IsClosed ((compHP p T).toContinuousLinearMap ⁻¹'
      (freeSublattice p E : Set (HP p E)))
    exact (VectorSublattice.isClosed_topologicalClosure _).preimage
      (compHP p T).toContinuousLinearMap.continuous
  have hgenerated :
      VectorSublattice.generated (Set.range (hpEval p : F → HP p F)) ≤ D := by
    apply VectorSublattice.generated_le
    rintro _ ⟨x, rfl⟩
    change compHP p T (hpEval p x) ∈ freeSublattice p E
    have heq : compHP p T (hpEval p x) = hpEval p (T x) := by
      apply Subtype.ext
      funext φ
      rfl
    rw [heq]
    exact (delta p (T x)).2
  have hclosure := VectorSublattice.topologicalClosure_minimal hgenerated hDclosed
  have hf : (f.1 : HP p F) ∈ D := hclosure f.2
  exact hf

/-- Equation (2.3): induced operator is composition with the adjoint. -/
def induced (p : Exponent) (T : F →L[ℝ] E) : LatticeOperator (Free p F) (Free p E) where
  toFun f := ⟨⟨fun φ => f (φ.comp T), by
    refine ⟨?_, ?_⟩
    · intro a ha φ
      change f ((a • φ).comp T) = a * f (φ.comp T)
      have hcomp : (a • φ).comp T = a • (φ.comp T) := by
        ext x
        rfl
      rw [hcomp]
      exact f.1.2.1 a ha (φ.comp T)
    · exact (freeNormExt_comp_le p T f.1.1 f.1.2.1).trans_lt
        (ENNReal.mul_lt_top ENNReal.ofReal_lt_top f.1.2.2)⟩, by
          change compHP p T f.1 ∈ freeSublattice p E
          exact compHP_mem_free p T f⟩
  map_add' := by
    intro f g
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    rfl
  map_smul' := by
    intro c f
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    rfl
  cont := by
    refine Metric.continuous_iff.mpr fun f ε hε => ?_
    let K : ℝ := ‖T‖ + 1
    have hK : 0 < K := by dsimp [K]; positivity
    refine ⟨ε / K, by positivity, ?_⟩
    intro g hgf
    rw [dist_eq_norm] at hgf ⊢
    change (freeNormExt p (fun φ : Dual E => (g - f) (φ.comp T))).toReal < ε
    calc
      (freeNormExt p (fun φ : Dual E => (g - f) (φ.comp T))).toReal ≤
          ‖T‖ * ‖g - f‖ := freeNormExt_comp_norm_le p T (g - f)
      _ ≤ K * ‖g - f‖ :=
        mul_le_mul_of_nonneg_right (by dsimp [K]; linarith) (norm_nonneg _)
      _ < ε := by
        have hmul := mul_lt_mul_of_pos_left hgf hK
        have hcalc : K * (ε / K) = ε := by field_simp
        rw [hcalc] at hmul
        exact hmul
  map_sup' := by
    intro f g
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    rfl
  map_inf' := by
    intro f g
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    rfl

/-- Equation (2.3): the induced map acts by precomposition with the continuous adjoint,
so its value at φ is the original function evaluated at `φ.comp T`. -/
theorem canonical_map_formulas (p : Exponent) (T : F →L[ℝ] E)
    (f : Free p F) (φ : Dual E) : induced p T f φ = f (φ.comp T) := by rfl

/-- Section 1: norm and generator formula for induced maps. -/
theorem induced_norm_generators (p : Exponent) (T : F →L[ℝ] E) :
    ‖(induced p T).toContinuousLinearMap‖ = ‖T‖ ∧
    ∀ x, induced p T (delta p x) = delta p (T x) := by
  have hgen (x : F) : induced p T (delta p x) = delta p (T x) := by
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    rfl
  have hupper : ‖(induced p T).toContinuousLinearMap‖ ≤ ‖T‖ :=
    (induced p T).toContinuousLinearMap.opNorm_le_bound (norm_nonneg T) (by
      intro f
      change (freeNormExt p (fun φ : Dual E => f (φ.comp T))).toReal ≤ ‖T‖ * ‖f‖
      exact freeNormExt_comp_norm_le p T f)
  have hlower : ‖T‖ ≤ ‖(induced p T).toContinuousLinearMap‖ :=
    T.opNorm_le_bound (norm_nonneg _) (by
      intro x
      calc
        ‖T x‖ = ‖delta p (T x)‖ := ((delta p).norm_map (T x)).symm
        _ = ‖induced p T (delta p x)‖ := by rw [hgen]
        _ ≤ ‖(induced p T).toContinuousLinearMap‖ * ‖delta p x‖ :=
          (induced p T).toContinuousLinearMap.le_opNorm (delta p x)
        _ = ‖(induced p T).toContinuousLinearMap‖ * ‖x‖ := by
          rw [(delta p).norm_map])
  exact ⟨le_antisymm hupper hlower, hgen⟩

/-- The algebraic core, regarded as a submodule of the free Banach lattice. -/
abbrev endpointRange (p : Exponent) := LinearMap.range (ofFVL p (E := E)).toLinearMap

/-- Identify the algebraic free lattice with its embedded range. -/
def endpointRangeEquiv (p : Exponent) :
    FBLOrderContinuousLH.FVL E ≃ₗ[ℝ] endpointRange (E := E) p :=
  LinearEquiv.ofInjective (ofFVL p (E := E)).toLinearMap
    (ofFVL_embedding p).1

/-- The algebraic change-of-exponent map from the core to the infinity model. -/
def endpointRangeMap (p : Exponent) :
    endpointRange (E := E) p →ₗ[ℝ] Free Exponent.infinity E :=
  (ofFVL Exponent.infinity (E := E)).toLinearMap.comp (endpointRangeEquiv p).symm.toLinearMap

private theorem endpointRange_dense (p : Exponent) :
    DenseRange (endpointRange (E := E) p).subtype := by
  apply denseRange_iff_closure_range.mpr
  ext x
  constructor
  · intro _; trivial
  · intro _
    have hx : x ∈ closure (Set.range (ofFVL p (E := E))) := by
      rw [(denseRange_ofFVL p (E := E)).closure_range]
      trivial
    apply closure_mono ?_ hx
    rintro _ ⟨v, rfl⟩
    exact ⟨⟨ofFVL p v, ⟨v, rfl⟩⟩, rfl⟩

private theorem endpointRangeMap_bound (p : Exponent) (x : endpointRange (E := E) p) :
    ‖endpointRangeMap p x‖ ≤ ‖(x : Free p E)‖ := by
  let v := (endpointRangeEquiv p).symm x
  have hx : ofFVL p v = (x : Free p E) := by
    have h := LinearEquiv.ofInjective_symm_apply
      (f := (ofFVL p (E := E)).toLinearMap) (h := (ofFVL_embedding p).1) x
    change ofFVL p v = (x : Free p E) at h
    exact h
  change ‖ofFVL Exponent.infinity v‖ ≤ ‖(x : Free p E)‖
  rw [← hx]
  exact norm_ofFVL_infinity_le p v

/-- The continuous extension of the algebraic map into the infinity model. -/
def endpointExtension (p : Exponent) : Free p E →L[ℝ] Free Exponent.infinity E :=
  (endpointRangeMap p).extendOfNorm (endpointRange (E := E) p).subtype

private theorem endpointExtension_ofFVL (p : Exponent) (v : FBLOrderContinuousLH.FVL E) :
    endpointExtension p (ofFVL p v) = ofFVL Exponent.infinity v := by
  have hb : ∃ C, ∀ x : endpointRange (E := E) p,
      ‖endpointRangeMap p x‖ ≤ C * ‖(endpointRange (E := E) p).subtype x‖ :=
    ⟨1, by intro x; simpa using endpointRangeMap_bound p x⟩
  have he := LinearMap.extendOfNorm_eq (f := endpointRangeMap p)
    (e := (endpointRange (E := E) p).subtype) (endpointRange_dense p) hb ((endpointRangeEquiv p) v)
  have he' : endpointExtension p (ofFVL p v) = endpointRangeMap p ((endpointRangeEquiv p) v) := by
    have hv : (endpointRange (E := E) p).subtype ((endpointRangeEquiv p) v) = ofFVL p v := by
      have h := LinearEquiv.ofInjective_apply
        (f := (ofFVL p (E := E)).toLinearMap) (h := (ofFVL_embedding p).1) v
      change (endpointRange (E := E) p).subtype ((endpointRangeEquiv p) v) = ofFVL p v at h
      exact h
    rw [← hv]
    exact he
  calc
    endpointExtension p (ofFVL p v) = endpointRangeMap p ((endpointRangeEquiv p) v) := he'
    _ = ofFVL Exponent.infinity v := by
      dsimp only [endpointRangeMap, LinearMap.comp_apply]
      simp
      rfl

private theorem endpointExtension_norm_le (p : Exponent) (x : Free p E) :
    ‖endpointExtension p x‖ ≤ ‖x‖ := by
  have hb : ∀ y : endpointRange (E := E) p,
      ‖endpointRangeMap p y‖ ≤ (1 : ℝ) * ‖(endpointRange (E := E) p).subtype y‖ := by
    intro y
    simpa using endpointRangeMap_bound p y
  simpa [endpointExtension] using
    (LinearMap.norm_extendOfNorm_apply_le (f := endpointRangeMap p)
      (e := (endpointRange (E := E) p).subtype) (endpointRange_dense p) 1 hb x)

theorem endpointExtension_map_sup (p : Exponent) (f g : Free p E) :
    endpointExtension p (f ⊔ g) = endpointExtension p f ⊔ endpointExtension p g := by
  refine map_binary_of_dense_range (ofFVL p (E := E)) (denseRange_ofFVL p)
    (endpointExtension p) (endpointExtension p).continuous
    (· ⊔ ·) (· ⊔ ·) (continuous_fst.sup continuous_snd)
    (continuous_fst.sup continuous_snd) ?_ f g
  intro v w
  rw [← map_sup (ofFVL p (E := E)) v w,
    endpointExtension_ofFVL, endpointExtension_ofFVL, endpointExtension_ofFVL,
    map_sup (ofFVL Exponent.infinity (E := E)) v w]

theorem endpointExtension_map_inf (p : Exponent) (f g : Free p E) :
    endpointExtension p (f ⊓ g) = endpointExtension p f ⊓ endpointExtension p g := by
  refine map_binary_of_dense_range (ofFVL p (E := E)) (denseRange_ofFVL p)
    (endpointExtension p) (endpointExtension p).continuous
    (· ⊓ ·) (· ⊓ ·) (continuous_fst.inf continuous_snd)
    (continuous_fst.inf continuous_snd) ?_ f g
  intro v w
  rw [← map_inf (ofFVL p (E := E)) v w,
    endpointExtension_ofFVL, endpointExtension_ofFVL, endpointExtension_ofFVL,
    map_inf (ofFVL Exponent.infinity (E := E)) v w]

private theorem endpointExtension_apply (p : Exponent) (f : Free p E) (φ : Dual E) :
    endpointExtension p f φ = f φ := by
  have hleft : Continuous (fun g : Free p E => endpointExtension p g φ) :=
    ((hpEvaluation Exponent.infinity φ).continuous.comp continuous_subtype_val).comp
      (endpointExtension p).continuous
  have hright : Continuous (fun g : Free p E => g φ) :=
    (hpEvaluation p φ).continuous.comp continuous_subtype_val
  have heq := (denseRange_ofFVL p (E := E)).equalizer hleft hright (by
    funext v
    change endpointExtension p (ofFVL p v) φ = ofFVL p v φ
    rw [endpointExtension_ofFVL]
    rfl)
  exact congrFun heq f

/-- The canonical inclusion into the endpoint free lattice, constructed from the dense FVL. -/
def inclusionInfinity (p : Exponent) :
    LatticeOperator (Free p E) (Free Exponent.infinity E) where
  toContinuousLinearMap := endpointExtension p
  map_sup' := endpointExtension_map_sup p
  map_inf' := endpointExtension_map_inf p

/-- The canonical map to the infinity free lattice preserves every full-dual evaluation. -/
theorem inclusionInfinity_apply (p : Exponent) (f : Free p E) (φ : Dual E) :
    inclusionInfinity p f φ = f φ := endpointExtension_apply p f φ

/-- The canonical map into the infinity free lattice has operator norm at most one. -/
theorem inclusionInfinity_norm_le (p : Exponent) :
    ‖(inclusionInfinity p (E := E)).toContinuousLinearMap‖ ≤ 1 := by
  apply (inclusionInfinity p (E := E)).toContinuousLinearMap.opNorm_le_bound zero_le_one
  intro f
  change ‖endpointExtension p f‖ ≤ 1 * ‖f‖
  simpa only [one_mul] using endpointExtension_norm_le p f

/-- The endpoint inclusion maps each canonical generator to the same generator at ∞. -/
theorem inclusionInfinity_generators (p : Exponent) (x : E) :
    inclusionInfinity p (delta p x) = delta Exponent.infinity x := by
  rw [← ofFVL_of p x, ← ofFVL_of Exponent.infinity x]
  exact endpointExtension_ofFVL p (FVLv.of x)

/-- The endpoint inclusion is injective because it leaves the underlying dual function unchanged. -/
theorem inclusionInfinity_injective (p : Exponent) :
    Function.Injective (inclusionInfinity p (E := E)) := by
  intro f g h
  apply Subtype.ext
  apply Subtype.ext
  funext φ
  have hφ := congrArg (fun k : Free Exponent.infinity E => k φ) h
  simpa only [inclusionInfinity_apply] using hφ

/-- The endpoint inclusion has norm-dense range, since its range contains the algebraic
generators. -/
theorem inclusionInfinity_denseRange (p : Exponent) :
    DenseRange (inclusionInfinity p (E := E)) := by
  apply denseRange_iff_closure_range.mpr
  ext z
  constructor
  · intro _; trivial
  · intro _
    have hz : z ∈ closure (Set.range (ofFVL Exponent.infinity (E := E))) := by
      rw [(denseRange_ofFVL Exponent.infinity (E := E)).closure_range]
      trivial
    apply closure_mono ?_ hz
    rintro _ ⟨v, rfl⟩
    exact ⟨ofFVL p v, endpointExtension_ofFVL p v⟩

/-- The algebraic change-of-exponent map between two free-lattice models. -/
def parameterRangeMap (p q : Exponent) :
    endpointRange (E := E) p →ₗ[ℝ] Free q E :=
  (ofFVL q (E := E)).toLinearMap.comp (endpointRangeEquiv p).symm.toLinearMap

private theorem parameterRangeMap_bound {p q : Exponent} (hpq : p ≤ q)
    (x : endpointRange (E := E) p) :
    ‖parameterRangeMap p q x‖ ≤ ‖(x : Free p E)‖ := by
  let v := (endpointRangeEquiv p).symm x
  have hx : ofFVL p v = (x : Free p E) := by
    have h := LinearEquiv.ofInjective_symm_apply
      (f := (ofFVL p (E := E)).toLinearMap) (h := (ofFVL_embedding p).1) x
    change ofFVL p v = (x : Free p E) at h
    exact h
  change ‖ofFVL q v‖ ≤ ‖(x : Free p E)‖
  rw [← hx]
  exact norm_ofFVL_mono hpq v

/-- Extend the contractive change-of-exponent map to the completed free lattices. -/
def parameterExtension {p q : Exponent} (_hpq : p ≤ q) : Free p E →L[ℝ] Free q E :=
  (parameterRangeMap p q).extendOfNorm (endpointRange (E := E) p).subtype

private theorem parameterExtension_ofFVL {p q : Exponent} (hpq : p ≤ q) (v : FVL E) :
    parameterExtension hpq (ofFVL p v) = ofFVL q v := by
  have hb : ∃ C, ∀ x : endpointRange (E := E) p,
      ‖parameterRangeMap p q x‖ ≤ C * ‖(endpointRange (E := E) p).subtype x‖ :=
    ⟨1, by intro x; simpa using parameterRangeMap_bound hpq x⟩
  have he := LinearMap.extendOfNorm_eq (f := parameterRangeMap p q)
    (e := (endpointRange (E := E) p).subtype) (endpointRange_dense p) hb
      ((endpointRangeEquiv p) v)
  have he' : parameterExtension hpq (ofFVL p v) =
      parameterRangeMap p q ((endpointRangeEquiv p) v) := by
    have hv : (endpointRange (E := E) p).subtype ((endpointRangeEquiv p) v) = ofFVL p v := by
      have h := LinearEquiv.ofInjective_apply
        (f := (ofFVL p (E := E)).toLinearMap) (h := (ofFVL_embedding p).1) v
      change (endpointRange (E := E) p).subtype ((endpointRangeEquiv p) v) = ofFVL p v at h
      exact h
    rw [← hv]
    exact he
  calc
    parameterExtension hpq (ofFVL p v) =
        parameterRangeMap p q ((endpointRangeEquiv p) v) := he'
    _ = ofFVL q v := by
      dsimp only [parameterRangeMap, LinearMap.comp_apply]
      simp
      rfl

private theorem parameterExtension_norm_le {p q : Exponent} (hpq : p ≤ q)
    (x : Free p E) : ‖parameterExtension hpq x‖ ≤ ‖x‖ := by
  have hb : ∀ y : endpointRange (E := E) p,
      ‖parameterRangeMap p q y‖ ≤ (1 : ℝ) * ‖(endpointRange (E := E) p).subtype y‖ := by
    intro y
    simpa using parameterRangeMap_bound hpq y
  simpa [parameterExtension] using
    (LinearMap.norm_extendOfNorm_apply_le (f := parameterRangeMap p q)
      (e := (endpointRange (E := E) p).subtype) (endpointRange_dense p) 1 hb x)

private theorem parameterExtension_apply {p q : Exponent} (hpq : p ≤ q)
    (f : Free p E) (φ : Dual E) : parameterExtension hpq f φ = f φ := by
  have hleft : Continuous (fun g : Free p E => parameterExtension hpq g φ) :=
    ((hpEvaluation q φ).continuous.comp continuous_subtype_val).comp
      (parameterExtension hpq).continuous
  have hright : Continuous (fun g : Free p E => g φ) :=
    (hpEvaluation p φ).continuous.comp continuous_subtype_val
  have heq := (denseRange_ofFVL p (E := E)).equalizer hleft hright (by
    funext v
    change parameterExtension hpq (ofFVL p v) φ = ofFVL p v φ
    rw [parameterExtension_ofFVL]
    rfl)
  exact congrFun heq f

/-- Section 2 and Section 5: change of convexity parameter is the identity on functions. -/
def inclusion {p q : Exponent} (hpq : p ≤ q) : LatticeOperator (Free p E) (Free q E) where
  toContinuousLinearMap := parameterExtension hpq
  map_sup' := by
    intro f g
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    change parameterExtension hpq (f ⊔ g) φ =
      parameterExtension hpq f φ ⊔ parameterExtension hpq g φ
    simp only [parameterExtension_apply]
    rfl
  map_inf' := by
    intro f g
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    change parameterExtension hpq (f ⊓ g) φ =
      parameterExtension hpq f φ ⊓ parameterExtension hpq g φ
    simp only [parameterExtension_apply]
    rfl

/-- Section 5: the canonical parameter map acts as the identity on full-dual functions. -/
theorem inclusion_apply {p q : Exponent} (hpq : p ≤ q) (f : Free p E) (φ : Dual E) :
    inclusion hpq f φ = f φ := parameterExtension_apply hpq f φ

/-- The actual scalar p-sum function used in BanLat's homogeneous functional calculus. -/
def pSumFunction (p : Exponent) (n : ℕ) : posHomFunctions n :=
  ⟨⟨scalarPSum p, by
    convert (continuous_norm.comp
      (PiLp.continuous_toLp p.1 (fun _ : Fin n => ℝ))) using 1
    ext a
    exact scalarPSum_eq_piLp_norm p a⟩, by
    intro c hc a
    have hfun : c • a = fun i => c * a i := by
      funext i
      simp
    change scalarPSum p (c • a) = c * scalarPSum p a
    rw [hfun, scalarPSum_smul, abs_of_nonneg hc]⟩

/-- Functional-calculus p-sums in arbitrary Banach lattices. -/
def latticePSum (p : Exponent) {X : Type u} [NormedAddCommGroup X] [Lattice X]
    [IsOrderedAddMonoid X] [BanachLattice X] {n : ℕ} (x : Fin n → X) : X :=
  letI := isUniformlyCompleteVectorLattice_of_banachLattice X
  PosHomFunction.functionalCalculus x (pSumFunction p n)

private theorem posHomFunctionalCalculus_map_universes {n : ℕ}
    {X : Type u} {Y : Type v}
    [AddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [VectorLattice X]
    [IsUniformlyCompleteVectorLattice X]
    [AddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y] [VectorLattice Y]
    [IsUniformlyCompleteVectorLattice Y]
    (T : VecLatHom X Y) (x : Fin n → X) (h : posHomFunctions n) :
    T (PosHomFunction.functionalCalculus x h) =
      PosHomFunction.functionalCalculus (fun i => T (x i)) h := by
  have hcomp : ∀ i,
      (T.comp (PosHomFunction.functionalCalculus x))
        (PosHomFunction.coordinate i) = T (x i) := by
    intro i
    rw [VecLatHom.comp_apply, PosHomFunction.functionalCalculus_coordinate]
  have heq := PosHomFunction.eq_functionalCalculus_of_map_coordinate
    (fun i => T (x i)) (T.comp (PosHomFunction.functionalCalculus x)) hcomp
  simpa [VecLatHom.comp_apply] using DFunLike.congr_fun heq h

/-- Evaluation of a continuous positively homogeneous function at a real vector. -/
def realPosHomEval {n : ℕ} (x : Fin n → ℝ) : VecLatHom (posHomFunctions n) ℝ where
  toFun f := f x
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  map_sup' := by intros; rfl
  map_inf' := by intros; rfl

section RealPosHomCalc
local instance : IsUniformlyCompleteVectorLattice ℝ :=
  isUniformlyCompleteVectorLattice_of_banachLattice ℝ

private theorem realPosHomFunctionalCalculus {n : ℕ} (x : Fin n → ℝ)
    (h : posHomFunctions n) : PosHomFunction.functionalCalculus x h = h x := by
  have heq := PosHomFunction.eq_functionalCalculus_of_map_coordinate x
    (realPosHomEval x) (by intro i; rfl)
  exact (DFunLike.congr_fun heq h).symm
end RealPosHomCalc

/-- Full-dual version of the scalar functional-calculus identity. -/
theorem latticePSum_apply (p q : Exponent) {n : ℕ} (f : Fin n → Free p E) (φ : Dual E) :
    latticePSum q f φ = scalarPSum q (fun i => f i φ) := by
  let := isUniformlyCompleteVectorLattice_of_banachLattice (Free p E)
  let := isUniformlyCompleteVectorLattice_of_banachLattice ℝ
  change evalVecLatHom p φ (PosHomFunction.functionalCalculus f (pSumFunction q n)) = _
  calc
    evalVecLatHom p φ (PosHomFunction.functionalCalculus f (pSumFunction q n)) =
        PosHomFunction.functionalCalculus (fun i => evalVecLatHom p φ (f i))
          (pSumFunction q n) := by
      exact posHomFunctionalCalculus_map_universes (evalVecLatHom p φ) f
        (pSumFunction q n)
    _ = scalarPSum q (fun i => f i φ) := by
      rw [realPosHomFunctionalCalculus]
      rfl

/-- The p-convexity estimate with a fixed constant C ≥ 1: every finite lattice p-sum
has norm at most C times the scalar p-sum of the individual norms. All exponents,
including the maximum operation at ∞, use the same functional-calculus interface. -/
def ConvexWith (p : Exponent) (C : ℝ) (X : Type u) [NormedAddCommGroup X] [Lattice X]
    [IsOrderedAddMonoid X] [BanachLattice X] : Prop :=
  1 ≤ C ∧ ∀ (n : ℕ) (x : Fin n → X),
    ‖latticePSum p x‖ ≤ C * scalarPSum p (fun i => ‖x i‖)

/-- A Banach lattice is p-convex if its finite lattice p-sums satisfy `ConvexWith p C`
for some constant C ≥ 1. The endpoint uses finite suprema of absolute values. -/
def IsPConvex (p : Exponent) (X : Type u) [NormedAddCommGroup X] [Lattice X]
    [IsOrderedAddMonoid X] [BanachLattice X] : Prop := ∃ C, ConvexWith p C X

/-- Adding the same scalar to every coordinate changes a finite p-sum by at most its
number of coordinates times the scalar's absolute value. -/
private theorem scalarPSum_add_const_le (p : Exponent) {n : ℕ}
    (a : Fin n → ℝ) (ε : ℝ) :
    scalarPSum p (fun i => a i + ε) ≤ scalarPSum p a + n * |ε| := by
  calc
    scalarPSum p (fun i => a i + ε) ≤
        scalarPSum p a + scalarPSum p (fun _ : Fin n => ε) :=
      scalarPSum_add_le p a (fun _ => ε)
    _ ≤ scalarPSum p a + scalarPSum Exponent.one (fun _ : Fin n => ε) := by
      gcongr
      exact scalarPSum_mono_exponent p.2 (fun _ : Fin n => ε)
    _ = scalarPSum p a + n * |ε| := by
      simp [scalarPSum, Exponent.one]

/-- A closed lattice ideal quotient preserves lattice p-sums. -/
private theorem quotient_latticePSum_map {X : Type u}
    [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [BanachLattice X]
    (p : Exponent) (J : OrderIdeal X) (hJ : IsClosed (J : Set X))
    {n : ℕ} (x : Fin n → X) :
    letI : NormedAddCommGroup (X ⧸ J.toSubmodule) := J.quotientNormedAddCommGroup hJ
    letI : Lattice (X ⧸ J.toSubmodule) := J.instQuotientLattice
    letI : IsOrderedAddMonoid (X ⧸ J.toSubmodule) := J.instQuotientIsOrderedAddMonoid
    letI : BanachLattice (X ⧸ J.toSubmodule) := J.quotientBanachLattice hJ
    J.mkQ (latticePSum p x) = latticePSum p (fun i => J.mkQ (x i)) := by
  let : NormedAddCommGroup (X ⧸ J.toSubmodule) := J.quotientNormedAddCommGroup hJ
  let : Lattice (X ⧸ J.toSubmodule) := J.instQuotientLattice
  let : IsOrderedAddMonoid (X ⧸ J.toSubmodule) := J.instQuotientIsOrderedAddMonoid
  let : BanachLattice (X ⧸ J.toSubmodule) := J.quotientBanachLattice hJ
  let : IsUniformlyCompleteVectorLattice X :=
    isUniformlyCompleteVectorLattice_of_banachLattice X
  let : IsUniformlyCompleteVectorLattice (X ⧸ J.toSubmodule) :=
    isUniformlyCompleteVectorLattice_of_banachLattice (X ⧸ J.toSubmodule)
  change J.mkQVecLatHom (PosHomFunction.functionalCalculus x (pSumFunction p n)) =
    PosHomFunction.functionalCalculus (fun i => J.mkQVecLatHom (x i)) (pSumFunction p n)
  exact PosHomFunction.functionalCalculus_map J.mkQVecLatHom x (pSumFunction p n)

/-- A closed lattice ideal quotient retains a p-convexity constant. -/
theorem quotient_convexWith {X : Type u}
    [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [BanachLattice X]
    (p : Exponent) (C : ℝ) (hC : ConvexWith p C X)
    (J : OrderIdeal X) (hJ : IsClosed (J : Set X)) :
    letI : NormedAddCommGroup (X ⧸ J.toSubmodule) := J.quotientNormedAddCommGroup hJ
    letI : Lattice (X ⧸ J.toSubmodule) := J.instQuotientLattice
    letI : IsOrderedAddMonoid (X ⧸ J.toSubmodule) := J.instQuotientIsOrderedAddMonoid
    letI : BanachLattice (X ⧸ J.toSubmodule) := J.quotientBanachLattice hJ
    ConvexWith p C (X ⧸ J.toSubmodule) := by
  let : NormedAddCommGroup (X ⧸ J.toSubmodule) := J.quotientNormedAddCommGroup hJ
  let : Lattice (X ⧸ J.toSubmodule) := J.instQuotientLattice
  let : IsOrderedAddMonoid (X ⧸ J.toSubmodule) := J.instQuotientIsOrderedAddMonoid
  let : BanachLattice (X ⧸ J.toSubmodule) := J.quotientBanachLattice hJ
  constructor
  · exact hC.1
  · intro n x
    classical
    refine le_of_forall_pos_le_add fun ε hε => ?_
    let δ : ℝ := ε / (C * (n + 1))
    have hCpos : 0 < C := lt_of_lt_of_le zero_lt_one hC.1
    have hden : 0 < C * (n + 1 : ℝ) := by positivity
    have hδ : 0 < δ := div_pos hε hden
    have hlift : ∀ i : Fin n, ∃ y : X, J.mkQ y = x i ∧ ‖y‖ < ‖x i‖ + δ := by
      intro i
      exact Submodule.Quotient.norm_mk_lt (x i) hδ
    choose y hy hybound using hlift
    have hmap : J.mkQ (latticePSum p y) = latticePSum p x := by
      rw [quotient_latticePSum_map p J hJ y]
      congr 1
      funext i
      exact hy i
    have hsum : scalarPSum p (fun i => ‖y i‖) ≤
        scalarPSum p (fun i => ‖x i‖ + δ) := by
      apply scalarPSum_mono_abs
      intro i
      rw [abs_of_nonneg (norm_nonneg _), abs_of_nonneg (add_nonneg (norm_nonneg _) hδ.le)]
      exact (hybound i).le
    calc
      ‖latticePSum p x‖ = ‖J.mkQ (latticePSum p y)‖ := by rw [hmap]
      _ ≤ ‖latticePSum p y‖ := Submodule.Quotient.norm_mk_le J.toSubmodule _
      _ ≤ C * scalarPSum p (fun i => ‖y i‖) := hC.2 n y
      _ ≤ C * scalarPSum p (fun i => ‖x i‖ + δ) :=
        mul_le_mul_of_nonneg_left hsum hCpos.le
      _ ≤ C * scalarPSum p (fun i => ‖x i‖) + ε := by
        have hbound := scalarPSum_add_const_le p (fun i => ‖x i‖) δ
        rw [abs_of_pos hδ] at hbound
        have hδid : C * (n : ℝ) * δ ≤ ε := by
          calc
            C * (n : ℝ) * δ ≤ C * ((n : ℝ) + 1) * δ := by
              gcongr
              exact le_add_of_nonneg_right zero_le_one
            _ = ε := by
              dsimp [δ]
              exact mul_div_cancel₀ ε (ne_of_gt hden)
        nlinarith

/-- A quotient by a closed lattice ideal is p-convex whenever the original lattice is. -/
theorem quotient_isPConvex {X : Type u}
    [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [BanachLattice X]
    (p : Exponent) (hX : IsPConvex p X)
    (J : OrderIdeal X) (hJ : IsClosed (J : Set X)) :
    letI : NormedAddCommGroup (X ⧸ J.toSubmodule) := J.quotientNormedAddCommGroup hJ
    letI : Lattice (X ⧸ J.toSubmodule) := J.instQuotientLattice
    letI : IsOrderedAddMonoid (X ⧸ J.toSubmodule) := J.instQuotientIsOrderedAddMonoid
    letI : BanachLattice (X ⧸ J.toSubmodule) := J.quotientBanachLattice hJ
    IsPConvex p (X ⧸ J.toSubmodule) := by
  obtain ⟨C, hC⟩ := hX
  exact ⟨C, quotient_convexWith p C hC J hJ⟩

/-- The infimum of the constants C satisfying `ConvexWith p C X`. For p-convex spaces,
`convexityConstant_ge_one` and `convexityConstant_spec` show that this infimum is itself
an admissible constant. Its use as an optimal constant requires `IsPConvex p X`. -/
def convexityConstant (p : Exponent) (X : Type u) [NormedAddCommGroup X] [Lattice X]
    [IsOrderedAddMonoid X] [BanachLattice X] : ℝ := sInf {C | ConvexWith p C X}

private theorem scalarPSum_swap (p : Exponent) {n m : ℕ} (a : Fin n → Fin m → ℝ) :
    scalarPSum p (fun i => scalarPSum p (a i)) =
      scalarPSum p (fun j => scalarPSum p (fun i => a i j)) := by
  let A : PiLp p.1 (fun _ : Fin n => PiLp p.1 (fun _ : Fin m => ℝ)) :=
    WithLp.toLp p.1 (fun i => WithLp.toLp p.1 (a i))
  let B : PiLp p.1 (fun _ : Fin m => PiLp p.1 (fun _ : Fin n => ℝ)) :=
    WithLp.toLp p.1 (fun j => WithLp.toLp p.1 (fun i => a i j))
  let e : (Σ _ : Fin n, Fin m) ≃ (Σ _ : Fin m, Fin n) := {
    toFun := fun z => Sigma.mk z.2 z.1
    invFun := fun z => Sigma.mk z.2 z.1
    left_inv := by intro z; cases z; rfl
    right_inv := by intro z; cases z; rfl }
  let T := (LinearIsometryEquiv.piLpCurry ℝ p.1 (fun _ : Fin n => fun _ : Fin m => ℝ)).symm
  let U := LinearIsometryEquiv.piLpCongrLeft p.1 ℝ ℝ e
  let V := LinearIsometryEquiv.piLpCurry ℝ p.1 (fun _ : Fin m => fun _ : Fin n => ℝ)
  have hswap : V (U (T A)) = B := by
    ext j i
    rfl
  have hnorm : ‖A‖ = ‖B‖ := by
    calc
      ‖A‖ = ‖T A‖ := (T.norm_map A).symm
      _ = ‖U (T A)‖ := (U.norm_map (T A)).symm
      _ = ‖V (U (T A))‖ := (V.norm_map (U (T A))).symm
      _ = ‖B‖ := by rw [hswap]
  have hleft : scalarPSum p (fun i => scalarPSum p (a i)) = ‖A‖ := by
    simp only [scalarPSum_eq_piLp_norm]
    by_cases htop : p.1 = ⊤
    · change ‖WithLp.toLp p.1 (fun i => ‖WithLp.toLp p.1 (a i)‖)‖ =
          ‖WithLp.toLp p.1 (fun i => WithLp.toLp p.1 (a i))‖
      rw [htop]
      simp only [PiLp.norm_eq_ciSup, Real.norm_eq_abs]
      exact iSup_congr fun i => abs_of_nonneg
        (Real.iSup_nonneg fun j => abs_nonneg _)
    · have hp : 0 < p.1.toReal := ENNReal.toReal_pos_iff.mpr
        ⟨lt_of_lt_of_le zero_lt_one p.2, lt_top_iff_ne_top.mpr htop⟩
      simp only [A, PiLp.norm_eq_sum hp, Real.norm_eq_abs]
      congr 1
      apply Finset.sum_congr rfl
      intro i hi
      rw [abs_of_nonneg (Real.rpow_nonneg
        (Finset.sum_nonneg fun j hj => Real.rpow_nonneg (abs_nonneg _) _) _)]
  have hright : scalarPSum p (fun j => scalarPSum p (fun i => a i j)) = ‖B‖ := by
    simp only [scalarPSum_eq_piLp_norm]
    by_cases htop : p.1 = ⊤
    · change ‖WithLp.toLp p.1 (fun j => ‖WithLp.toLp p.1 (fun i => a i j)‖)‖ =
          ‖WithLp.toLp p.1 (fun j => WithLp.toLp p.1 (fun i => a i j))‖
      rw [htop]
      simp only [PiLp.norm_eq_ciSup, Real.norm_eq_abs]
      exact iSup_congr fun i => abs_of_nonneg
        (Real.iSup_nonneg fun j => abs_nonneg _)
    · have hp : 0 < p.1.toReal := ENNReal.toReal_pos_iff.mpr
        ⟨lt_of_lt_of_le zero_lt_one p.2, lt_top_iff_ne_top.mpr htop⟩
      simp only [B, PiLp.norm_eq_sum hp, Real.norm_eq_abs]
      congr 1
      apply Finset.sum_congr rfl
      intro j hj
      rw [abs_of_nonneg (Real.rpow_nonneg
        (Finset.sum_nonneg fun i hi => Real.rpow_nonneg (abs_nonneg _) _) _)]
  exact hleft.trans (hnorm.trans hright.symm)

private theorem realLp_finset_sum_le {ι κ : Type*}
    [Fintype κ] {r : ℝ} (hr : 1 ≤ r) (s : Finset ι)
    (a : ι → κ → ℝ) (ha : ∀ i ∈ s, ∀ j, 0 ≤ a i j) :
    (∑ j, (∑ i ∈ s, a i j) ^ r) ^ (1 / r) ≤
      ∑ i ∈ s, (∑ j, a i j ^ r) ^ (1 / r) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    have hrpos : 0 < r := lt_of_lt_of_le zero_lt_one hr
    simp [Real.zero_rpow hrpos.ne', Real.zero_rpow (inv_ne_zero hrpos.ne')]
  | @insert i s his ih =>
    have hai : ∀ j, 0 ≤ a i j := fun j => ha i (Finset.mem_insert_self ..) j
    have has : ∀ k ∈ s, ∀ j, 0 ≤ a k j := by
      intro k hk j
      exact ha k (Finset.mem_insert_of_mem hk) j
    simp only [Finset.sum_insert his]
    calc
      (∑ j, (a i j + ∑ k ∈ s, a k j) ^ r) ^ (1 / r) ≤
          (∑ j, a i j ^ r) ^ (1 / r) +
            (∑ j, (∑ k ∈ s, a k j) ^ r) ^ (1 / r) :=
        Real.Lp_add_le_of_nonneg Finset.univ hr
          (by intro j hj; exact hai j)
          (by intro j hj; exact Finset.sum_nonneg fun k hk => has k hk j)
      _ ≤ (∑ j, a i j ^ r) ^ (1 / r) +
            ∑ k ∈ s, (∑ j, a k j ^ r) ^ (1 / r) := by
        gcongr
        exact ih has

private theorem realMixedPSum_mono {n m : ℕ} {p q : ℝ} (hp : 0 < p)
    (hpq : p ≤ q) (a : Fin n → Fin m → ℝ) :
    (∑ j, ((∑ i, |a i j| ^ p) ^ (1 / p)) ^ q) ^ (1 / q) ≤
      (∑ i, ((∑ j, |a i j| ^ q) ^ (1 / q)) ^ p) ^ (1 / p) := by
  have hq : 0 < q := lt_of_lt_of_le hp hpq
  let r : ℝ := q / p
  have hr : 1 ≤ r := (one_le_div hp).mpr hpq
  let b : Fin n → Fin m → ℝ := fun i j => |a i j| ^ p
  have hb : ∀ i ∈ (Finset.univ : Finset (Fin n)), ∀ j, 0 ≤ b i j := by
    intro i hi j
    exact Real.rpow_nonneg (abs_nonneg _) _
  have hMink := realLp_finset_sum_le hr Finset.univ b hb
  have hMLnonneg : 0 ≤ (∑ j, (∑ i ∈ Finset.univ, b i j) ^ r) ^ (1 / r) := by
    apply Real.rpow_nonneg
    exact Finset.sum_nonneg fun j hj =>
      Real.rpow_nonneg (Finset.sum_nonneg fun i hi => hb i hi j) _
  have hpow := Real.rpow_le_rpow hMLnonneg hMink (one_div_nonneg.mpr hp.le)
  convert hpow using 1
  · have hterm (j : Fin m) : ((∑ i, |a i j| ^ p) ^ (1 / p)) ^ q =
        (∑ i, b i j) ^ r := by
      change ((∑ i, |a i j| ^ p) ^ (1 / p)) ^ q =
        (∑ i, |a i j| ^ p) ^ r
      rw [← Real.rpow_mul (Finset.sum_nonneg fun i hi =>
        Real.rpow_nonneg (abs_nonneg _) _)]
      congr 1
      dsimp [r]
      field_simp
    simp_rw [hterm]
    rw [← Real.rpow_mul (Finset.sum_nonneg fun j hj =>
      Real.rpow_nonneg (Finset.sum_nonneg fun i hi => hb i hi j) _)]
    congr 1
    dsimp [r]
    field_simp
  · congr 1
    apply Finset.sum_congr rfl
    intro i hi
    have hinner : (∑ j, b i j ^ r) = ∑ j, |a i j| ^ q := by
      apply Finset.sum_congr rfl
      intro j hj
      change (|a i j| ^ p) ^ r = |a i j| ^ q
      rw [← Real.rpow_mul (abs_nonneg _)]
      congr 1
      dsimp [r]
      field_simp
    rw [hinner]
    rw [← Real.rpow_mul (Finset.sum_nonneg fun j hj =>
      Real.rpow_nonneg (abs_nonneg _) _)]
    congr 1
    dsimp [r]
    field_simp

/-- Mixed finite p-sums satisfy the Minkowski interchange inequality. -/
theorem scalarPSum_mixed_le_finite {p q : Exponent} (hpq : p ≤ q)
    (hq : q.IsFinite) {n m : ℕ} (a : Fin n → Fin m → ℝ) :
    scalarPSum q (fun j => scalarPSum p (fun i => a i j)) ≤
      scalarPSum p (fun i => scalarPSum q (fun j => a i j)) := by
  have hp : p.IsFinite := lt_of_le_of_lt hpq hq
  have hpReal : 0 < p.1.toReal := ENNReal.toReal_pos_iff.mpr
    ⟨lt_of_lt_of_le zero_lt_one p.2, hp⟩
  have hpqReal : p.1.toReal ≤ q.1.toReal :=
    ENNReal.toReal_mono (ne_of_lt hq) hpq
  have h := realMixedPSum_mono hpReal hpqReal a
  simpa [scalarPSum, ne_of_lt hp, ne_of_lt hq,
    abs_of_nonneg (Real.rpow_nonneg (Finset.sum_nonneg fun _ _ =>
      Real.rpow_nonneg (abs_nonneg _) _) _)] using h

private theorem freeNormExt_latticePSum_le (p : Exponent) {n : ℕ}
    (f : Fin n → Free p E) :
    freeNormExt p (latticePSum p f : Free p E).1.1 ≤
      ENNReal.ofReal (scalarPSum p (fun i => ‖f i‖)) := by
  by_cases htop : p.1 = ⊤
  · rw [freeNormExt, ite_eq_left htop]
    refine iSup_le fun φ => iSup_le fun hφ => ?_
    apply ENNReal.ofReal_le_ofReal
    rw [latticePSum_apply, abs_of_nonneg (scalarPSum_nonneg ..)]
    apply scalarPSum_mono_abs
    intro i
    have hnorm : ‖(f i).1‖ = ‖f i‖ := rfl
    simpa only [abs_of_nonneg (norm_nonneg (f i)), hnorm] using
      (hp_unit_eval_le p (f i).1 φ hφ)
  · rw [freeNormExt, ite_eq_right htop]
    refine iSup_le fun m => iSup_le fun φ => iSup_le fun hφ => ?_
    apply ENNReal.ofReal_le_ofReal
    simp_rw [latticePSum_apply]
    rw [scalarPSum_swap]
    apply scalarPSum_mono_abs
    intro i
    have hle := hp_admissible_eval_le p htop (f i).1 φ hφ
    have hnorm : ‖(f i).1‖ = ‖f i‖ := rfl
    simpa only [abs_of_nonneg (scalarPSum_nonneg ..),
      abs_of_nonneg (norm_nonneg (f i)), hnorm] using hle

/-- Section 1: free lattices have convexity constant one. -/
theorem free_pConvex (p : Exponent) : ConvexWith p 1 (Free p E) := by
  refine ⟨le_rfl, ?_⟩
  intro n f
  rw [one_mul]
  change (freeNormExt p (latticePSum p f : Free p E).1.1).toReal ≤ _
  exact ENNReal.toReal_le_of_le_ofReal (scalarPSum_nonneg ..)
    (freeNormExt_latticePSum_le p f)

/-- The endpoint free lattice has convexity constant one at every exponent. -/
theorem free_infinity_pConvex (p : Exponent) :
    ConvexWith p 1 (Free Exponent.infinity E) := by
  refine ⟨le_rfl, ?_⟩
  intro n f
  rw [one_mul]
  change (freeNormExt Exponent.infinity
    (latticePSum p f : Free Exponent.infinity E).1.1).toReal ≤ _
  apply ENNReal.toReal_le_of_le_ofReal (scalarPSum_nonneg ..)
  rw [freeNormExt, ite_eq_left (show (Exponent.infinity : Exponent).1 = ⊤ by rfl)]
  refine iSup_le fun φ => iSup_le fun hφ => ?_
  apply ENNReal.ofReal_le_ofReal
  rw [latticePSum_apply, abs_of_nonneg (scalarPSum_nonneg ..)]
  apply scalarPSum_mono_abs
  intro i
  have h := hp_unit_eval_le Exponent.infinity (f i).1 φ hφ
  simpa using h

/-- Section 5: higher-convexity free lattices have lower-convexity constant one. -/
theorem free_lower_convexity {p q : Exponent} (hpq : p ≤ q) :
    ConvexWith p 1 (Free q E) := by
  by_cases h : p = q
  · subst q
    exact free_pConvex p
  · by_cases hq : q = Exponent.infinity
    · subst q
      exact free_infinity_pConvex p
    · have hqfinite : q.IsFinite := lt_top_iff_ne_top.mpr (by
        intro htop
        exact hq (Subtype.ext htop))
      refine ⟨le_rfl, ?_⟩
      intro n f
      rw [one_mul]
      change (freeNormExt q (latticePSum p f : Free q E).1.1).toReal ≤ _
      apply ENNReal.toReal_le_of_le_ofReal (scalarPSum_nonneg ..)
      rw [freeNormExt, ite_eq_right (ne_of_lt hqfinite)]
      refine iSup_le fun m => iSup_le fun φ => iSup_le fun hφ => ?_
      apply ENNReal.ofReal_le_ofReal
      simp_rw [latticePSum_apply]
      calc
        scalarPSum q (fun j => scalarPSum p (fun i => f i (φ j))) ≤
            scalarPSum p (fun i => scalarPSum q (fun j => f i (φ j))) :=
          scalarPSum_mixed_le_finite hpq hqfinite _
        _ ≤ scalarPSum p (fun i => ‖f i‖) := by
          apply scalarPSum_mono_abs
          intro i
          have hle := hp_admissible_eval_le q (ne_of_lt hqfinite) (f i).1 φ hφ
          have hnorm : ‖(f i).1‖ = ‖f i‖ := rfl
          simpa only [abs_of_nonneg (scalarPSum_nonneg ..),
            abs_of_nonneg (norm_nonneg (f i)), hnorm] using hle

/-- At p = 1, BanLat's free Banach lattice lift gives the extension with its sharp norm. -/
theorem universal_property_one_core {X : Type w}
    [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [BanachLattice X]
    (S : E →L[ℝ] X) :
    ∃ L : LatticeOperator (Free Exponent.one E) X,
      (∀ x, L (delta Exponent.one x) = S x) ∧
      ‖L.toContinuousLinearMap‖ ≤ ‖S‖ := by
  obtain ⟨U, hU⟩ := banlat_fbl_identification (E := E)
  let A : Free Exponent.one E →L[ℝ] _root_.FBL E :=
    U.toContinuousLinearEquiv.toContinuousLinearMap
  let B : Free Exponent.one E →L[ℝ] X :=
    (_root_.FBL.liftContinuousLinearMap S).comp A
  let L : LatticeOperator (Free Exponent.one E) X := {
    toContinuousLinearMap := B
    map_sup' := by
      intro f g
      change _root_.FBL.lift S (U (f ⊔ g)) =
        _root_.FBL.lift S (U f) ⊔ _root_.FBL.lift S (U g)
      have h : U (f ⊔ g) = U f ⊔ U g := U.map_sup' f g
      rw [h]
      exact (_root_.FBL.lift S).map_sup' (U f) (U g)
    map_inf' := by
      intro f g
      change _root_.FBL.lift S (U (f ⊓ g)) =
        _root_.FBL.lift S (U f) ⊓ _root_.FBL.lift S (U g)
      have h : U (f ⊓ g) = U f ⊓ U g := U.map_inf' f g
      rw [h]
      exact (_root_.FBL.lift S).map_inf' (U f) (U g) }
  have hUdelta (x : E) : U (delta Exponent.one x) = _root_.FBL.of x := by
    apply Subtype.ext
    apply Subtype.ext
    ext ψ
    calc
      (U (delta Exponent.one x) : _root_.FBL E) ψ =
          (delta Exponent.one x) (WeakDual.toStrongDual ψ.1) := hU _ ψ
      _ = (_root_.FBL.of x : _root_.FBL E) ψ := rfl
  refine ⟨L, ?_, ?_⟩
  · intro x
    change _root_.FBL.liftContinuousLinearMap S (U (delta Exponent.one x)) = S x
    rw [hUdelta, _root_.FBL.liftContinuousLinearMap_apply, _root_.FBL.lift_of]
  · change ‖B‖ ≤ ‖S‖
    apply B.opNorm_le_bound (norm_nonneg S)
    intro f
    change ‖_root_.FBL.liftContinuousLinearMap S (U f)‖ ≤ ‖S‖ * ‖f‖
    calc
      ‖_root_.FBL.liftContinuousLinearMap S (U f)‖ ≤
          ‖_root_.FBL.liftContinuousLinearMap S‖ * ‖U f‖ :=
        (_root_.FBL.liftContinuousLinearMap S).le_opNorm (U f)
      _ = ‖S‖ * ‖f‖ := by
        have h : ‖U f‖ = ‖f‖ := U.toLinearIsometryEquiv.norm_map f
        rw [_root_.FBL.norm_lift, h]

/-- Every admissible p-convexity constant is at least one. -/
theorem convexityConstant_ge_one (p : Exponent) {X : Type w}
    [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [BanachLattice X]
    (hX : IsPConvex p X) : 1 ≤ convexityConstant p X := by
  obtain ⟨C, hC⟩ := hX
  unfold convexityConstant
  apply le_csInf ⟨C, hC⟩
  intro b hb
  exact hb.1

/-- The optimal p-convexity constant itself satisfies the finite-family estimate. -/
theorem convexityConstant_spec (p : Exponent) {X : Type w}
    [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [BanachLattice X]
    (hX : IsPConvex p X) : ConvexWith p (convexityConstant p X) X := by
  obtain ⟨C, hC⟩ := hX
  constructor
  · exact le_csInf ⟨C, hC⟩ (fun b hb => hb.1)
  · intro n x
    let a := scalarPSum p (fun i => ‖x i‖)
    have ha : 0 ≤ a := scalarPSum_nonneg p _
    by_cases h0 : a = 0
    · have hB := hC.2 n x
      change ‖latticePSum p x‖ ≤ C * a at hB
      change ‖latticePSum p x‖ ≤ convexityConstant p X * a
      rw [h0, mul_zero] at hB ⊢
      exact hB
    · have hap : 0 < a := lt_of_le_of_ne ha (Ne.symm h0)
      have hdiv : ‖latticePSum p x‖ / a ≤ convexityConstant p X := by
        apply le_csInf ⟨C, hC⟩
        intro b hb
        exact (div_le_iff₀ hap).mpr (hb.2 n x)
      change ‖latticePSum p x‖ ≤ convexityConstant p X * a
      exact (div_le_iff₀ hap).mp hdiv

/-- An admissible family evaluates every free-lattice element within its free norm. -/
theorem freeNorm_family_le (p : Exponent) {n : ℕ} (f : Free p E)
    (ψ : Fin n → Dual E) (hψ : NormAdmissible p ψ) :
    scalarPSum p (fun i => f (ψ i)) ≤ ‖f‖ := by
  by_cases htop : p.1 = ⊤
  · by_cases hn : n = 0
    · subst n
      rw [scalarPSum_eq_piLp_norm]
      have hz : (WithLp.toLp p.1 (fun i : Fin 0 => f (ψ i)) :
          PiLp p.1 (fun _ : Fin 0 => ℝ)) = 0 := Subsingleton.elim _ _
      rw [hz, norm_zero]
      exact norm_nonneg f
    have : Nonempty (Fin n) := ⟨⟨0, Nat.pos_of_ne_zero hn⟩⟩
    have hφnorm (i : Fin n) : ‖ψ i‖ ≤ 1 := by
      apply (ψ i).opNorm_le_bound zero_le_one
      intro x
      have hcoord := PiLp.norm_apply_le
        (WithLp.toLp p.1 (fun j => ψ j x) : PiLp p.1 (fun _ : Fin n => ℝ)) i
      have hsum := normAdmissible_eval_le_norm p ψ hψ x
      rw [scalarPSum_eq_piLp_norm] at hsum
      simpa only [Real.norm_eq_abs, one_mul] using hcoord.trans hsum
    rw [scalarPSum_eq_piLp_norm, htop, PiLp.norm_eq_ciSup]
    apply ciSup_le
    intro i
    have hle := ofReal_abs_le_freeNormExt p (fun θ : Dual E => f θ) (ψ i) (hφnorm i)
    have hfin : freeNormExt p (fun θ : Dual E => f θ) ≠ ⊤ := ne_of_lt f.1.2.2
    have hreal := (ENNReal.ofReal_le_iff_le_toReal hfin).mp hle
    change |f (ψ i)| ≤ ‖f‖ at hreal
    simpa only [Real.norm_eq_abs] using hreal
  · have hle : ENNReal.ofReal (scalarPSum p (fun i => f (ψ i))) ≤
        freeNormExt p (fun θ : Dual E => f θ) := by
      rw [freeNormExt, ite_eq_right htop]
      exact le_iSup_of_le n (le_iSup_of_le ψ (le_iSup_of_le hψ le_rfl))
    have hfin : freeNormExt p (fun θ : Dual E => f θ) ≠ ⊤ := ne_of_lt f.1.2.2
    exact (ENNReal.ofReal_le_iff_le_toReal hfin).mp hle

section PConvexLiftBound

variable {X : Type w} [NormedAddCommGroup X] [Lattice X]
  [IsOrderedAddMonoid X] [BanachLattice X]

/-- A positive dual functional dominates the scalar p-sum of its values by its value on the
lattice p-sum. -/
theorem positive_dual_scalarPSum_le (p : Exponent) {n : ℕ} (x : Fin n → X)
    (ψ : Dual X) (hψ : 0 ≤ ψ) :
    scalarPSum p (fun i => ψ (x i)) ≤ ψ (latticePSum p x) := by
  let := isUniformlyCompleteVectorLattice_of_banachLattice X
  let y : PiLp p.1 (fun _ : Fin n => ℝ) := WithLp.toLp p.1 (fun i => ψ (x i))
  obtain ⟨l, hl, hly⟩ := exists_dual_vector'' ℝ y
  let a : Fin n → ℝ := fun i => l (PiLp.single p.1 i 1)
  have hlin (z : Fin n → ℝ) :
      ∑ i, a i * z i = l (WithLp.toLp p.1 z) := by
    have hz := (PiLp.basisFun p.1 ℝ (Fin n)).sum_repr (WithLp.toLp p.1 z)
    simpa [a, map_sum, map_smul, smul_eq_mul, mul_comm] using congrArg l hz
  have hpoint : (∑ i, a i • PosHomFunction.coordinate i) ≤ pSumFunction p n := by
    intro z
    change (∑ i, a i • PosHomFunction.coordinate i : posHomFunctions n) z ≤ scalarPSum p z
    change ((posHomFunctions n).toSubmodule.subtype
      (∑ i, a i • PosHomFunction.coordinate i)) z ≤ _
    simp only [map_sum, map_smul, ContinuousMap.sum_apply,
      ContinuousMap.smul_apply, smul_eq_mul]
    change (∑ i, a i * z i) ≤ scalarPSum p z
    rw [hlin, scalarPSum_eq_piLp_norm]
    exact (le_abs_self _).trans ((l.le_opNorm _).trans
      (by simpa only [one_mul] using mul_le_mul_of_nonneg_right hl (norm_nonneg _)))
  have hcalc := (PosHomFunction.functionalCalculus x).monotone hpoint
  simp only [map_sum, map_smul, PosHomFunction.functionalCalculus_coordinate] at hcalc
  have hbound := StrongDual.apply_le_apply_of_nonneg hψ hcalc
  simp only [map_sum, map_smul, smul_eq_mul] at hbound
  rw [hlin] at hbound
  change l y ≤ ψ (latticePSum p x) at hbound
  simpa [hly, scalarPSum_eq_piLp_norm, y] using hbound

private theorem positive_dual_family_pSum_le (p : Exponent) {C : ℝ}
    (hC : ConvexWith p C X) {m n : ℕ} (ψ : Fin m → Dual X)
    (hψ : ∀ i, 0 ≤ ψ i) (x : Fin n → X) :
    ∑ i, scalarPSum p (fun j => ψ i (x j)) ≤
      ‖∑ i, ψ i‖ * C * scalarPSum p (fun j => ‖x j‖) := by
  have h := Finset.sum_le_sum (s := Finset.univ)
    (fun i _ => positive_dual_scalarPSum_le p x (ψ i) (hψ i))
  calc
    ∑ i, scalarPSum p (fun j => ψ i (x j)) ≤ ∑ i, ψ i (latticePSum p x) := h
    _ = (∑ i, ψ i) (latticePSum p x) := by simp
    _ ≤ ‖∑ i, ψ i‖ * ‖latticePSum p x‖ :=
      (le_abs_self _).trans ((∑ i, ψ i).le_opNorm _)
    _ ≤ ‖∑ i, ψ i‖ * (C * scalarPSum p (fun j => ‖x j‖)) :=
      mul_le_mul_of_nonneg_left (hC.2 n x) (norm_nonneg _)
    _ = _ := by ring

private theorem mem_convexHull_exists_fin {d : ℕ} {s : Set (Fin d → ℝ)}
    {a : Fin d → ℝ} (ha : a ∈ convexHull ℝ s) :
    ∃ n : ℕ, ∃ c : Fin n → ℝ, ∃ z : Fin n → (Fin d → ℝ),
      (∀ j, 0 ≤ c j) ∧ (∑ j, c j = 1) ∧ (∀ j, z j ∈ s) ∧ ∑ j, c j • z j = a := by
  obtain ⟨ι, _, c, z, hc, hsum, hz, ha⟩ := mem_convexHull_iff_exists_fintype.mp ha
  let e := Fintype.equivFin ι
  refine ⟨Fintype.card ι, c ∘ e.symm, z ∘ e.symm, fun j => hc _, ?_, fun j => hz _, ?_⟩
  · simpa only [Function.comp_apply] using (e.symm.sum_comp c).trans hsum
  · simpa only [Function.comp_apply] using
      (e.symm.sum_comp (fun j => c j • z j)).trans ha

private theorem positive_dual_convexHull_pSum_le (p : Exponent) (hp : p.IsFinite) {C : ℝ}
    (hC : ConvexWith p C X) {m : ℕ} (ψ : Fin m → Dual X)
    (hψ : ∀ i, 0 ≤ ψ i) {a : Fin m → ℝ}
    (ha : a ∈ convexHull ℝ ((fun x : X => fun i => |ψ i x| ^ p.1.toReal) ''
      Metric.closedBall 0 1)) :
    ∑ i, (a i) ^ (1 / p.1.toReal) ≤ ‖∑ i, ψ i‖ * C := by
  obtain ⟨n, c, z, hc, hsum, hz, rfl⟩ := mem_convexHull_exists_fin ha
  choose x hx hz using hz
  let y : Fin n → X := fun j => c j ^ (1 / p.1.toReal) • x j
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos_iff.mpr
    ⟨lt_of_lt_of_le zero_lt_one p.2, hp⟩
  have hpow (j : Fin n) : (c j ^ (1 / p.1.toReal)) ^ p.1.toReal = c j := by
    simpa only [one_div] using Real.rpow_inv_rpow (hc j) hp0.ne'
  have hcoord (i : Fin m) : (∑ j, c j • z j) i = ∑ j, |ψ i (y j)| ^ p.1.toReal := by
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    apply Finset.sum_congr rfl
    intro j _
    rw [← hz j]
    simp only [y, map_smul, smul_eq_mul, abs_mul,
      abs_of_nonneg (Real.rpow_nonneg (hc j) _)]
    rw [Real.mul_rpow (Real.rpow_nonneg (hc j) _) (abs_nonneg _), hpow]
  have hynorm : scalarPSum p (fun j => ‖y j‖) ≤ 1 := by
    have hle : scalarPSum p (fun j => ‖y j‖) ≤
        scalarPSum p (fun j => c j ^ (1 / p.1.toReal)) := by
      apply scalarPSum_mono_abs
      intro j
      rw [abs_of_nonneg (norm_nonneg (y j))]
      simp only [y, norm_smul, Real.norm_eq_abs,
        abs_of_nonneg (Real.rpow_nonneg (hc j) _)]
      exact mul_le_of_le_one_right (Real.rpow_nonneg (hc j) _)
        (mem_closedBall_zero_iff.mp (hx j))
    convert hle using 1
    simp only [scalarPSum, ite_eq_right (ne_of_lt hp),
      abs_of_nonneg (Real.rpow_nonneg (hc _) _), hpow, hsum, Real.one_rpow]
  have h := positive_dual_family_pSum_le p hC ψ hψ y
  have hb := h.trans (mul_le_of_le_one_right
    (mul_nonneg (norm_nonneg _) (le_trans zero_le_one hC.1)) hynorm)
  simpa only [hcoord, scalarPSum, ite_eq_right (ne_of_lt hp)] using hb

private theorem exists_positive_diagonal_weights {n : ℕ} {r δ : ℝ}
    (hr : 0 < r) (hδ : 0 < δ) (K : Set (Fin n → ℝ))
    (hK : IsCompact K) (hne : K.Nonempty) (hconv : Convex ℝ K)
    (hpos : ∀ a ∈ K, ∀ i, 0 ≤ a i) :
    ∃ a ∈ K, ∀ b ∈ K,
      ∑ i, (a i + δ) ^ (r - 1) * b i ≤
        ∑ i, (a i + δ) ^ (r - 1) * a i := by
  let g : (Fin n → ℝ) → ℝ := fun a => ∑ i, (a i + δ) ^ r
  have hg : Continuous g := by
    exact continuous_finsetSum _ (fun i _ =>
      ((continuous_apply i).add continuous_const).rpow_const (fun _ => Or.inr hr.le))
  obtain ⟨a, ha, hmax⟩ := hK.exists_isMaxOn hne hg.continuousOn
  have hd (i : Fin n) : HasFDerivAt (fun b : Fin n → ℝ => (b i + δ) ^ r)
      ((r * (a i + δ) ^ (r - 1)) •
        (ContinuousLinearMap.proj i : (Fin n → ℝ) →L[ℝ] ℝ)) a := by
    exact (((ContinuousLinearMap.proj i : (Fin n → ℝ) →L[ℝ] ℝ).hasFDerivAt
      (x := a)).add_const δ).rpow_const
      (Or.inl (ne_of_gt (add_pos_of_nonneg_of_pos (hpos a ha i) hδ)))
  have hdg := HasFDerivAt.fun_sum (u := Finset.univ) (fun i _ => hd i)
  refine ⟨a, ha, ?_⟩
  intro b hb
  have hdir := hmax.isLocalMaxOn.hasFDerivWithinAt_nonpos hdg.hasFDerivWithinAt
    (sub_mem_posTangentConeAt_of_segment_subset (hconv.segment_subset ha hb))
  simp only [sum_apply, smul_apply,
    ContinuousLinearMap.proj_apply, Pi.sub_apply, smul_eq_mul] at hdir
  simp_rw [mul_assoc, mul_sub] at hdir
  rw [Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.mul_sum] at hdir
  nlinarith

private theorem positive_dual_diagonal_bound (p : Exponent) (hp : p.IsFinite) {C δ : ℝ}
    (hC : ConvexWith p C X) (hδ : 0 < δ) {m : ℕ} (ψ : Fin m → Dual X)
    (hψ : ∀ i, 0 ≤ ψ i) :
    ∃ a : Fin m → ℝ, (∀ i, 0 ≤ a i) ∧
      (∑ i, (a i) ^ (1 / p.1.toReal) ≤ ‖∑ i, ψ i‖ * C) ∧
      ∀ x : X, ‖x‖ ≤ 1 →
        ∑ i, (a i + δ) ^ (1 / p.1.toReal - 1) * |ψ i x| ^ p.1.toReal ≤
          ∑ i, (a i + δ) ^ (1 / p.1.toReal) := by
  let A : Set (Fin m → ℝ) := (fun x : X => fun i => |ψ i x| ^ p.1.toReal) ''
    Metric.closedBall 0 1
  let K := closure (convexHull ℝ A)
  let b : Fin m → ℝ := fun i => ‖ψ i‖ ^ p.1.toReal
  have hA : A ⊆ Icc 0 b := by
    rintro _ ⟨x, hx, rfl⟩
    constructor
    · intro i
      exact Real.rpow_nonneg (abs_nonneg _) _
    · intro i
      apply Real.rpow_le_rpow (abs_nonneg _) _ ENNReal.toReal_nonneg
      exact ((ψ i).le_opNorm x).trans
        (mul_le_of_le_one_right (norm_nonneg _) (mem_closedBall_zero_iff.mp hx))
  have hKsub : K ⊆ Icc 0 b := closure_minimal (convexHull_min hA (convex_Icc _ _))
    isClosed_Icc
  have hK : IsCompact K := isCompact_Icc.of_isClosed_subset isClosed_closure hKsub
  have hne : K.Nonempty := by
    have hmem : (fun i => |ψ i (0 : X)| ^ p.1.toReal) ∈ A :=
      ⟨0, mem_closedBall_zero_iff.mpr (by simp), rfl⟩
    exact ⟨_, subset_closure (subset_convexHull ℝ A hmem)⟩
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos_iff.mpr
    ⟨lt_of_lt_of_le zero_lt_one p.2, hp⟩
  have hg : Continuous (fun a : Fin m → ℝ => ∑ i, (a i) ^ (1 / p.1.toReal)) :=
    continuous_finsetSum _ (fun i _ => (continuous_apply i).rpow_const
      (fun _ => Or.inr (by positivity)))
  have hbound : ∀ a ∈ K, ∑ i, (a i) ^ (1 / p.1.toReal) ≤ ‖∑ i, ψ i‖ * C := by
    apply closure_minimal
    · exact fun a ha => positive_dual_convexHull_pSum_le p hp hC ψ hψ ha
    · exact isClosed_le hg continuous_const
  obtain ⟨a, ha, hw⟩ := exists_positive_diagonal_weights (one_div_pos.mpr hp0) hδ
    K hK hne (convex_convexHull ℝ A).closure (fun a ha i => (hKsub ha).1 i)
  refine ⟨a, (hKsub ha).1, hbound a ha, ?_⟩
  intro x hx
  have hxK : (fun i => |ψ i x| ^ p.1.toReal) ∈ K :=
    subset_closure (subset_convexHull ℝ A ⟨x, mem_closedBall_zero_iff.mpr hx, rfl⟩)
  apply (hw _ hxK).trans
  apply Finset.sum_le_sum
  intro i _
  have hai : 0 < a i + δ := add_pos_of_nonneg_of_pos ((hKsub ha).1 i) hδ
  calc
    (a i + δ) ^ (1 / p.1.toReal - 1) * a i ≤
        (a i + δ) ^ (1 / p.1.toReal - 1) * (a i + δ) :=
      mul_le_mul_of_nonneg_left (le_add_of_nonneg_right hδ.le) (Real.rpow_nonneg hai.le _)
    _ = (a i + δ) ^ (1 / p.1.toReal) := by
      rw [Real.rpow_sub_one hai.ne', div_mul_cancel₀ _ hai.ne']

/-- A uniformly bounded family of functionals evaluates free elements with the same bound. -/
theorem freeNorm_scaled_family_le (p : Exponent) {n : ℕ}
    (f : Free p E) (φ : Fin n → Dual E) {D : ℝ} (hD : 0 < D)
    (hφ : ∀ x : E, ‖x‖ ≤ 1 → scalarPSum p (fun i => φ i x) ≤ D) :
    scalarPSum p (fun i => f (φ i)) ≤ D * ‖f‖ := by
  let θ : Fin n → Dual E := fun i => D⁻¹ • φ i
  have hθ : NormAdmissible p θ := by
    intro x hx
    change scalarPSum p (fun i => D⁻¹ * φ i x) ≤ 1
    rw [scalarPSum_smul, abs_of_pos (inv_pos.mpr hD)]
    exact (mul_le_mul_of_nonneg_left (hφ x hx) (inv_nonneg.mpr hD.le)).trans
      (by rw [inv_mul_cancel₀ hD.ne'])
  have h := freeNorm_family_le p f θ hθ
  have hf : PosHomogeneous (fun η => f η) := f.1.2.1
  have hscale (i : Fin n) : f (φ i) = D * f (θ i) := by
    rw [← hf D hD.le]
    simp [θ, smul_smul, hD.ne']
  simp_rw [hscale]
  rw [scalarPSum_smul, abs_of_pos hD]
  exact mul_le_mul_of_nonneg_left h hD.le

private theorem scalarPSum_weighted_holder (p : Exponent) (hp : p.IsFinite) {n : ℕ}
    (d u : Fin n → ℝ) (hd : ∀ i, 0 < d i) :
    ∑ i, u i ≤ (∑ i, d i) ^ (1 - 1 / p.1.toReal) *
      scalarPSum p (fun i => d i ^ (1 / p.1.toReal - 1) * u i) := by
  have hp1 : 1 ≤ p.1.toReal :=
    (ENNReal.toReal_le_toReal (by simp) (ne_of_lt hp)).mpr p.2
  have hp0 : 0 < p.1.toReal := lt_of_lt_of_le zero_lt_one hp1
  have hpow (i : Fin n) :
      d i * (|u i| / d i) ^ p.1.toReal =
        |d i ^ (1 / p.1.toReal - 1) * u i| ^ p.1.toReal := by
    rw [abs_mul, abs_of_pos (Real.rpow_pos_of_pos (hd i) _),
      Real.mul_rpow (Real.rpow_nonneg (hd i).le _) (abs_nonneg _),
      ← Real.rpow_mul (hd i).le, Real.div_rpow (abs_nonneg _) (hd i).le]
    have he : (1 / p.1.toReal - 1) * p.1.toReal = 1 - p.1.toReal := by
      field_simp
    rw [he, Real.rpow_sub (hd i), Real.rpow_one]
    ring
  have h := Real.inner_le_weight_mul_Lp_of_nonneg Finset.univ hp1 d
    (fun i => |u i| / d i) (fun i => (hd i).le)
    (fun i => div_nonneg (abs_nonneg _) (hd i).le)
  have hmul (i : Fin n) : d i * (|u i| / d i) = |u i| := by
    field_simp [(hd i).ne']
  simp_rw [hmul, hpow] at h
  apply (Finset.sum_le_sum (fun i _ => le_abs_self (u i))).trans
  simpa only [scalarPSum, ite_eq_right (ne_of_lt hp), one_div] using h

private theorem free_positive_dual_sum_le_add (p : Exponent) (hp : p.IsFinite) {C δ : ℝ}
    (hC : ConvexWith p C X) (hδ : 0 < δ) {m : ℕ} (ψ : Fin m → Dual X)
    (hψ : ∀ i, 0 ≤ ψ i) (f : Free p X) :
    ∑ i, f (ψ i) ≤ (‖∑ i, ψ i‖ * C + m * δ ^ (1 / p.1.toReal)) * ‖f‖ := by
  by_cases hm : m = 0
  · subst m
    simp
  have : Nonempty (Fin m) := ⟨⟨0, Nat.pos_of_ne_zero hm⟩⟩
  obtain ⟨a, ha, hsum, hdiag⟩ := positive_dual_diagonal_bound p hp hC hδ ψ hψ
  let r := 1 / p.1.toReal
  let d : Fin m → ℝ := fun i => (a i + δ) ^ r
  let B := ∑ i, d i
  have hp1 : 1 ≤ p.1.toReal :=
    (ENNReal.toReal_le_toReal (by simp) (ne_of_lt hp)).mpr p.2
  have hp0 : 0 < p.1.toReal := lt_of_lt_of_le zero_lt_one hp1
  have hd (i : Fin m) : 0 < d i :=
    Real.rpow_pos_of_pos (add_pos_of_nonneg_of_pos (ha i) hδ) _
  have hB : 0 < B := Finset.sum_pos (fun i _ => hd i) Finset.univ_nonempty
  let φ : Fin m → Dual X := fun i => d i ^ (r - 1) • ψ i
  have hφpow (i : Fin m) (x : X) :
      |φ i x| ^ p.1.toReal = (a i + δ) ^ (r - 1) * |ψ i x| ^ p.1.toReal := by
    simp only [φ, smul_apply, smul_eq_mul, abs_mul,
      abs_of_pos (Real.rpow_pos_of_pos (hd i) _)]
    rw [Real.mul_rpow (Real.rpow_nonneg (hd i).le _) (abs_nonneg _),
      ← Real.rpow_mul (hd i).le]
    dsimp [d]
    rw [← Real.rpow_mul (le_of_lt (add_pos_of_nonneg_of_pos (ha i) hδ))]
    congr 2
    dsimp [r]
    field_simp
  have hφ : ∀ x : X, ‖x‖ ≤ 1 → scalarPSum p (fun i => φ i x) ≤ B ^ r := by
    intro x hx
    rw [scalarPSum, ite_eq_right (ne_of_lt hp)]
    simp_rw [hφpow]
    exact Real.rpow_le_rpow
      (Finset.sum_nonneg (fun i _ => mul_nonneg
        (Real.rpow_nonneg (add_nonneg (ha i) hδ.le) _) (Real.rpow_nonneg (abs_nonneg _) _)))
      (hdiag x hx) (by positivity)
  have hfree := freeNorm_scaled_family_le p f φ (Real.rpow_pos_of_pos hB r) hφ
  have hh := scalarPSum_weighted_holder p hp d (fun i => f (ψ i)) hd
  have hf : PosHomogeneous (fun η => f η) := f.1.2.1
  have heval (i : Fin m) : f (φ i) = d i ^ (r - 1) * f (ψ i) :=
    hf _ (Real.rpow_nonneg (hd i).le _) _
  have hmain : ∑ i, f (ψ i) ≤ B * ‖f‖ := by
    change ∑ i, f (ψ i) ≤ B ^ (1 - r) *
      scalarPSum p (fun i => d i ^ (r - 1) * f (ψ i)) at hh
    simp_rw [← heval] at hh
    calc
      ∑ i, f (ψ i) ≤ B ^ (1 - r) * scalarPSum p (fun i => f (φ i)) := hh
      _ ≤ B ^ (1 - r) * (B ^ r * ‖f‖) :=
        mul_le_mul_of_nonneg_left hfree (Real.rpow_nonneg hB.le _)
      _ = B * ‖f‖ := by rw [← mul_assoc, ← Real.rpow_add hB, sub_add_cancel, Real.rpow_one]
  have hBbound : B ≤ ‖∑ i, ψ i‖ * C + m * δ ^ r := by
    calc
      B ≤ ∑ i, ((a i) ^ r + δ ^ r) :=
        Finset.sum_le_sum (fun i _ => Real.rpow_add_le_add_rpow (ha i) hδ.le
          (one_div_nonneg.mpr hp0.le) ((div_le_one hp0).mpr hp1))
      _ = (∑ i, (a i) ^ r) + m * δ ^ r := by simp [Finset.sum_add_distrib]
      _ ≤ ‖∑ i, ψ i‖ * C + m * δ ^ r := add_le_add hsum le_rfl
  exact hmain.trans (mul_le_mul_of_nonneg_right hBbound (norm_nonneg _))

private theorem free_positive_dual_sum_le_finite (p : Exponent) (hp : p.IsFinite) {C : ℝ}
    (hC : ConvexWith p C X) {m : ℕ} (ψ : Fin m → Dual X)
    (hψ : ∀ i, 0 ≤ ψ i) (f : Free p X) :
    ∑ i, f (ψ i) ≤ ‖∑ i, ψ i‖ * C * ‖f‖ := by
  have hp0 : 0 < p.1.toReal := ENNReal.toReal_pos_iff.mpr
    ⟨lt_of_lt_of_le zero_lt_one p.2, hp⟩
  have hlim : Tendsto (fun δ : ℝ =>
      (‖∑ i, ψ i‖ * C + m * δ ^ (1 / p.1.toReal)) * ‖f‖)
      (𝓝[>] 0) (𝓝 (‖∑ i, ψ i‖ * C * ‖f‖)) := by
    have hr : 0 ≤ 1 / p.1.toReal := one_div_nonneg.mpr hp0.le
    have hcont : Continuous (fun δ : ℝ =>
        (‖∑ i, ψ i‖ * C + m * δ ^ (1 / p.1.toReal)) * ‖f‖) := by
      fun_prop
    simpa only [Real.zero_rpow (ne_of_gt (one_div_pos.mpr hp0)), mul_zero, add_zero] using
      (hcont.continuousAt (x := 0)).tendsto.mono_left
        (nhdsWithin_le_nhds (s := Ioi (0 : ℝ)))
  apply ge_of_tendsto hlim
  filter_upwards [self_mem_nhdsWithin] with δ hδ
  exact free_positive_dual_sum_le_add p hp hC hδ ψ hψ f

/-- Each coordinate is dominated in absolute value by the functional-calculus p-sum. -/
theorem abs_le_latticePSum (p : Exponent) {n : ℕ} (x : Fin n → X) (i : Fin n) :
    |x i| ≤ latticePSum p x := by
  let := isUniformlyCompleteVectorLattice_of_banachLattice X
  have h : |PosHomFunction.coordinate i| ≤ pSumFunction p n := by
    intro z
    change |z i| ≤ scalarPSum p z
    rw [scalarPSum_eq_piLp_norm]
    exact PiLp.norm_apply_le (WithLp.toLp p.1 z) i
  have hcalc := (PosHomFunction.functionalCalculus x).monotone h
  simpa only [latticePSum, VecLatHom.map_abs,
    PosHomFunction.functionalCalculus_coordinate] using hcalc

/-- Infinity-convexity controls the sum of the norms of a finite positive dual family. -/
theorem positive_dual_norm_sum_le_infinity {C : ℝ} (hC : ConvexWith Exponent.infinity C X)
    {m : ℕ} (ψ : Fin m → Dual X) (hψ : ∀ i, 0 ≤ ψ i) :
    ∑ i, ‖ψ i‖ ≤ ‖∑ i, ψ i‖ * C := by
  have happrox (ε : ℝ) (hε : 0 < ε) :
      ∑ i, ‖ψ i‖ ≤ ‖∑ i, ψ i‖ * C + m * ε := by
    have hex (i : Fin m) : ∃ x : X, ‖x‖ ≤ 1 ∧ ‖ψ i‖ - ε ≤ ψ i |x| := by
      obtain ⟨x, hx, hval⟩ := (ψ i).exists_lt_apply_of_lt_opNorm (sub_lt_self _ hε)
      exact ⟨x, hx.le, hval.le.trans (StrongDual.abs_apply_le_apply_abs (hψ i) x)⟩
    choose x hx hval using hex
    have hscalar : scalarPSum Exponent.infinity (fun i => ‖x i‖) ≤ 1 := by
      simp only [scalarPSum, Exponent.infinity, ↓reduceIte]
      exact_mod_cast Finset.sup_le (fun i _ => show
        (⟨|‖x i‖|, abs_nonneg _⟩ : ℝ≥0) ≤ 1 by
          change |‖x i‖| ≤ (1 : ℝ)
          simpa using hx i)
    have hz : ‖latticePSum Exponent.infinity x‖ ≤ C :=
      (hC.2 m x).trans (mul_le_of_le_one_right (le_trans zero_le_one hC.1) hscalar)
    have hupper : ∑ i, ψ i |x i| ≤ ‖∑ i, ψ i‖ * C := by
      calc
        ∑ i, ψ i |x i| ≤ ∑ i, ψ i (latticePSum Exponent.infinity x) :=
          Finset.sum_le_sum (fun i _ => StrongDual.apply_le_apply_of_nonneg (hψ i)
            (abs_le_latticePSum Exponent.infinity x i))
        _ = (∑ i, ψ i) (latticePSum Exponent.infinity x) := by simp
        _ ≤ ‖∑ i, ψ i‖ * ‖latticePSum Exponent.infinity x‖ :=
          (le_abs_self _).trans ((∑ i, ψ i).le_opNorm _)
        _ ≤ ‖∑ i, ψ i‖ * C := mul_le_mul_of_nonneg_left hz (norm_nonneg _)
    have hlower := Finset.sum_le_sum (s := Finset.univ) (fun i _ => hval i)
    simp only [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_fin, nsmul_eq_mul] at hlower
    linarith
  have hlim : Tendsto (fun ε : ℝ => ‖∑ i, ψ i‖ * C + m * ε)
      (𝓝[>] 0) (𝓝 (‖∑ i, ψ i‖ * C)) := by
    have hc : Continuous (fun ε : ℝ => ‖∑ i, ψ i‖ * C + m * ε) := by fun_prop
    simpa only [mul_zero, add_zero] using
      (hc.continuousAt (x := 0)).tendsto.mono_left
        (nhdsWithin_le_nhds (s := Ioi (0 : ℝ)))
  apply ge_of_tendsto hlim
  filter_upwards [self_mem_nhdsWithin] with ε hε
  exact happrox ε hε

/-- Positive dual families evaluate a free function within the p-convexity bound.
For finite exponents, diagonal weights come from optimization on a finite-dimensional compact
convex set. -/
theorem free_positive_dual_sum_le (p : Exponent) {C : ℝ} (hC : ConvexWith p C X)
    {m : ℕ} (ψ : Fin m → Dual X) (hψ : ∀ i, 0 ≤ ψ i) (f : Free p X) :
    ∑ i, f (ψ i) ≤ ‖∑ i, ψ i‖ * C * ‖f‖ := by
  by_cases hp : p.IsFinite
  · exact free_positive_dual_sum_le_finite p hp hC ψ hψ f
  have hpinf : p = Exponent.infinity := Subtype.ext (not_lt_top_iff.mp hp)
  subst p
  calc
    ∑ i, f (ψ i) ≤ ∑ i, ‖ψ i‖ * ‖f‖ := Finset.sum_le_sum (fun i _ =>
      (le_abs_self _).trans (hp_apply_abs_le Exponent.infinity f.1 (ψ i)))
    _ = (∑ i, ‖ψ i‖) * ‖f‖ := (Finset.sum_mul ..).symm
    _ ≤ ‖∑ i, ψ i‖ * C * ‖f‖ := mul_le_mul_of_nonneg_right
      (positive_dual_norm_sum_le_infinity hC ψ hψ) (norm_nonneg _)

private theorem free_positive_dual_finset_sum_le (p : Exponent) {C : ℝ}
    (hC : ConvexWith p C X) {ι : Type*} (s : Finset ι) (ψ : ι → Dual X)
    (hψ : ∀ i ∈ s, 0 ≤ ψ i) (f : Free p X) :
    ∑ i ∈ s, f (ψ i) ≤ ‖∑ i ∈ s, ψ i‖ * C * ‖f‖ := by
  let e := Fintype.equivFin s
  have h := free_positive_dual_sum_le p hC
    (fun i => ψ (e.symm i).1) (fun i => hψ _ (e.symm i).2) f
  rw [e.symm.sum_comp (fun i : s => f (ψ i.1)),
    e.symm.sum_comp (fun i : s => ψ i.1), Finset.univ_eq_attach,
    Finset.sum_attach s (fun i => f (ψ i)), Finset.sum_attach s ψ] at h
  exact h

private theorem positive_dual_linearCombination_le_eval {n : ℕ} (x : Fin n → X)
    (e : LLexpr n) (ψ : Dual X) (hψ : 0 ≤ ψ) (c : Fin n → ℝ)
    (hc : c ∈ (LLexpr.normalize e).pos.coeffs) :
    ψ (Fintype.linearCombination ℝ x c) ≤
      LLexpr.eval (fun i => ψ (x i)) e + ψ ((LLexpr.normalize e).neg.eval x) := by
  have hlin (d : Fin n → ℝ) : ψ (Fintype.linearCombination ℝ x d) =
      Fintype.linearCombination ℝ (fun i => ψ (x i)) d := by
    simp [Fintype.linearCombination_apply, map_sum, map_smul]
  have hA : ψ (Fintype.linearCombination ℝ x c) ≤
      (LLexpr.normalize e).pos.eval (fun i => ψ (x i)) := by
    rw [hlin]
    exact Finset.le_sup' (f := Fintype.linearCombination ℝ (fun i => ψ (x i))) hc
  have hB : (LLexpr.normalize e).neg.eval (fun i => ψ (x i)) ≤
      ψ ((LLexpr.normalize e).neg.eval x) := by
    apply Finset.sup'_le
    intro d hd
    rw [← hlin]
    exact StrongDual.apply_le_apply_of_nonneg hψ
      (Finset.le_sup' (f := Fintype.linearCombination ℝ x) hd)
  rw [← LLexpr.normalize_eval, LLexpr.NormalForm.eval]
  linarith

private theorem positive_dual_fvl_lift_le (p : Exponent) {C : ℝ} (hC : ConvexWith p C X)
    (S : E →L[ℝ] X) (v : FVLv E) (ψ : Dual X) (hψ : 0 ≤ ψ) :
    ψ (FVLv.lift S.toLinearMap v) ≤ ‖ψ‖ * C * ‖induced p S (ofFVL p v)‖ := by
  obtain ⟨n, x, e, rfl⟩ := FVLv.exists_eval_of_eq v
  let y : Fin n → X := fun i => S (x i)
  let N := LLexpr.normalize e
  let f : Free p X := induced p S (ofFVL p (LLexpr.eval (fun i => FVLv.of (x i)) e))
  have hf (θ : Dual X) : f θ = LLexpr.eval (fun i => θ (y i)) e := by
    change ofFVL p (LLexpr.eval (fun i => FVLv.of (x i)) e) (θ.comp S) = _
    exact ofFVL_expr_apply p x e (θ.comp S)
  have hlift : FVLv.lift S.toLinearMap (LLexpr.eval (fun i => FVLv.of (x i)) e) =
      LLexpr.eval y e := by
    simpa [FVLv.lift_of, y] using
      LLexpr.map_eval (FVLv.lift S.toLinearMap) (fun i => FVLv.of (x i)) e
  rw [hlift, ← LLexpr.normalize_eval, LLexpr.NormalForm.eval, map_sub]
  change ψ (N.pos.eval y) - ψ (N.neg.eval y) ≤ ‖ψ‖ * C * ‖f‖
  suffices hb : ψ (N.pos.eval y) ≤ ‖ψ‖ * C * ‖f‖ + ψ (N.neg.eval y) by linarith
  have hψOD : (0 : OrderDualSpace X) ≤ StrongDual.toOrderDualSpace ψ := by
    exact hψ
  apply (OrderBoundedHom.isLUB_apply_finset_sup N.pos.nonempty hψOD
    (Fintype.linearCombination ℝ y)).2
  rintro _ ⟨θ, hθpos, hθsum, rfl⟩
  let χ : (Fin n → ℝ) → Dual X := fun i => StrongDual.ofOrderDualSpace (θ i)
  have hχpos : ∀ i ∈ N.pos.coeffs, 0 ≤ χ i := by
    intro i hi
    exact hθpos i hi
  have hχsum : ∑ i ∈ N.pos.coeffs, χ i = ψ := by
    change ∑ i ∈ N.pos.coeffs, StrongDual.equivOrderDualSpace.symm (θ i) = ψ
    rw [← map_sum, hθsum]
    exact StrongDual.equivOrderDualSpace.symm_apply_apply ψ
  have hbound := free_positive_dual_finset_sum_le p hC N.pos.coeffs χ hχpos f
  rw [hχsum] at hbound
  calc
    ∑ i ∈ N.pos.coeffs, θ i (Fintype.linearCombination ℝ y i) =
        ∑ i ∈ N.pos.coeffs, χ i (Fintype.linearCombination ℝ y i) := rfl
    _ ≤ ∑ i ∈ N.pos.coeffs, (f (χ i) + χ i (N.neg.eval y)) := by
      apply Finset.sum_le_sum
      intro i hi
      rw [hf]
      exact positive_dual_linearCombination_le_eval y e (χ i) (hχpos i hi) i hi
    _ = (∑ i ∈ N.pos.coeffs, f (χ i)) + ψ (N.neg.eval y) := by
      rw [Finset.sum_add_distrib, ← sum_apply, hχsum]
    _ ≤ ‖ψ‖ * C * ‖f‖ + ψ (N.neg.eval y) := add_le_add hbound le_rfl

/-- The algebraic free-vector-lattice lift into a p-convex Banach lattice satisfies the required
sharp bound. -/
theorem fvl_lift_pConvex_norm_le (p : Exponent) {C : ℝ} (hC : ConvexWith p C X)
    (S : E →L[ℝ] X) (v : FVLv E) :
    ‖FVLv.lift S.toLinearMap v‖ ≤ (C * ‖S‖) * ‖ofFVL p v‖ := by
  obtain ⟨ψ, hψ, hψnorm, hψval⟩ := StrongDual.exists_positive_dual_norming
    (x := |FVLv.lift S.toLinearMap v|) (abs_nonneg _)
  have h := positive_dual_fvl_lift_le p hC S |v| ψ hψ
  rw [VecLatHom.map_abs, hψval, norm_abs_eq_norm] at h
  have hop : ‖induced p S (ofFVL p |v|)‖ ≤ ‖S‖ * ‖ofFVL p v‖ := by
    have ho := (induced p S).toContinuousLinearMap.le_opNorm (ofFVL p |v|)
    rw [(induced_norm_generators p S).1, VecLatHom.map_abs, norm_abs_eq_norm] at ho
    simpa only [VecLatHom.map_abs] using ho
  calc
    ‖FVLv.lift S.toLinearMap v‖ ≤ ‖ψ‖ * C * ‖induced p S (ofFVL p |v|)‖ := h
    _ ≤ 1 * C * ‖induced p S (ofFVL p |v|)‖ :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hψnorm (le_trans zero_le_one hC.1)) (norm_nonneg _)
    _ ≤ C * (‖S‖ * ‖ofFVL p v‖) := by
      simpa only [one_mul] using mul_le_mul_of_nonneg_left hop (le_trans zero_le_one hC.1)
    _ = (C * ‖S‖) * ‖ofFVL p v‖ := by ring

end PConvexLiftBound

/-- A coordinate projection from a finite real `ℓᵖ` space as a continuous linear map. -/
def piLpEvalCLM (p : Exponent) (n : ℕ) (i : Fin n) :
    PiLp p.1 (fun _ : Fin n => ℝ) →L[ℝ] ℝ where
  toFun z := z i
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  cont := PiLp.continuous_apply p.1 (fun _ : Fin n => ℝ) i

/-- A coordinate projection from a finite real `ℓᵖ` space as a lattice homomorphism. -/
def piLpEvalVec (p : Exponent) (n : ℕ) (i : Fin n) :
    VecLatHom (PiLp p.1 (fun _ : Fin n => ℝ)) ℝ where
  toFun z := z i
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  map_sup' := by intros; rfl
  map_inf' := by intros; rfl

/-- The algebraic free-lattice lift has the sharp bound for a finite `ℓᵖ` target. -/
theorem fvl_lift_piLp_norm_le (p : Exponent) (n : ℕ)
    (S : E →L[ℝ] PiLp p.1 (fun _ : Fin n => ℝ)) (v : FVLv E) :
    ‖FVLv.lift S.toLinearMap v‖ ≤ ‖S‖ * ‖ofFVL p v‖ := by
  let φ : Fin n → Dual E := fun i => (piLpEvalCLM p n i).comp S
  have hcoord (i : Fin n) : (FVLv.lift S.toLinearMap v) i = ofFVL p v (φ i) := by
    let ev : VecLatHom (Free p E) ℝ := {
      toFun f := f (φ i)
      map_add' := by intros; rfl
      map_smul' := by intros; rfl
      map_sup' := by intros; rfl
      map_inf' := by intros; rfl }
    have hleft : (piLpEvalVec p n i).comp (FVLv.lift S.toLinearMap) =
        FVLv.lift ((φ i) : E →ₗ[ℝ] ℝ) := by
      apply FVLv.lift_unique
      intro x
      change (FVLv.lift S.toLinearMap (FVLv.of x)) i = φ i x
      rw [FVLv.lift_of]
      rfl
    have hright : ev.comp (ofFVL p) = FVLv.lift ((φ i) : E →ₗ[ℝ] ℝ) := by
      apply FVLv.lift_unique
      intro x
      change ofFVL p (FVLv.of x) (φ i) = φ i x
      rw [ofFVL_of]
      rfl
    exact DFunLike.congr_fun (hleft.trans hright.symm) v
  have hnormcoord : ‖FVLv.lift S.toLinearMap v‖ =
      scalarPSum p (fun i => ofFVL p v (φ i)) := by
    rw [scalarPSum_eq_piLp_norm]
    congr 1
    apply PiLp.ext
    intro i
    exact hcoord i
  by_cases hS : S = 0
  · have hφzero (i : Fin n) : φ i = 0 := by
      simp [φ, hS]
    let y : Free p E := ofFVL p v
    have hyhom : PosHomogeneous (fun θ : Dual E => y θ) := y.val.property.1
    have hyzero : y (0 : Dual E) = 0 := by
      have h := hyhom 0 (le_refl 0) (0 : Dual E)
      simpa using h
    have hz : (fun i : Fin n => ofFVL p v (φ i)) = fun _ => 0 := by
      funext i
      rw [hφzero i]
      exact hyzero
    rw [hnormcoord, hz, scalarPSum_eq_piLp_norm]
    have hzero : (WithLp.toLp p.1 (fun _ : Fin n => (0 : ℝ)) :
        PiLp p.1 (fun _ : Fin n => ℝ)) = 0 := rfl
    rw [hzero, norm_zero, hS, norm_zero, zero_mul]
  have hSpos : 0 < ‖S‖ := norm_pos_iff.mpr hS
  let ψ : Fin n → Dual E := fun i => ‖S‖⁻¹ • φ i
  have hφscale (i : Fin n) : φ i = ‖S‖ • ψ i := by
    simp only [ψ, smul_smul, mul_inv_cancel₀ hSpos.ne', one_smul]
  have hψ : NormAdmissible p ψ := by
    intro x hx
    have hnormSx : ‖S x‖ ≤ ‖S‖ := by
      calc
        ‖S x‖ ≤ ‖S‖ * ‖x‖ := S.le_opNorm x
        _ ≤ ‖S‖ * 1 := mul_le_mul_of_nonneg_left hx (norm_nonneg S)
        _ = ‖S‖ := mul_one _
    have hscalar : scalarPSum p (fun i => φ i x) = ‖S x‖ := by
      rw [scalarPSum_eq_piLp_norm]
      congr 1
    change scalarPSum p (fun i => (‖S‖⁻¹ • φ i) x) ≤ 1
    have hfun : (fun i => (‖S‖⁻¹ • φ i) x) =
        (fun i => ‖S‖⁻¹ * φ i x) := rfl
    rw [hfun, scalarPSum_smul, abs_of_pos (inv_pos.mpr hSpos), hscalar]
    calc
      ‖S‖⁻¹ * ‖S x‖ ≤ ‖S‖⁻¹ * ‖S‖ :=
        mul_le_mul_of_nonneg_left hnormSx (le_of_lt (inv_pos.mpr hSpos))
      _ = 1 := inv_mul_cancel₀ hSpos.ne'
  let y : Free p E := ofFVL p v
  have hscale : scalarPSum p (fun i => y (φ i)) =
      ‖S‖ * scalarPSum p (fun i => y (ψ i)) := by
    have hyhom : PosHomogeneous (fun θ : Dual E => y θ) := y.val.property.1
    have hval (i : Fin n) : y (φ i) = ‖S‖ * y (ψ i) := by
      rw [hφscale i]
      exact hyhom ‖S‖ hSpos.le (ψ i)
    simp_rw [hval]
    simpa only [abs_of_nonneg (norm_nonneg S)] using
      scalarPSum_smul p ‖S‖ (fun i => y (ψ i))
  rw [hnormcoord, hscale]
  exact mul_le_mul_of_nonneg_left (freeNorm_family_le p y ψ hψ) (norm_nonneg S)

section ContinuousMapLift
private theorem fvl_lift_continuousMap_apply {K : Type*}
    [TopologicalSpace K] (p : Exponent)
    (S : E →L[ℝ] C(K, ℝ)) (v : FVLv E) (k : K) :
    (FVLv.lift S.toLinearMap v) k =
      ofFVL p v ((ContinuousMap.evalCLM ℝ k).comp S) := by
  let φ : Dual E := (ContinuousMap.evalCLM ℝ k).comp S
  let ev : VecLatHom C(K, ℝ) ℝ := {
    toFun z := z k
    map_add' := by intros; rfl
    map_smul' := by intros; rfl
    map_sup' := by intros; rfl
    map_inf' := by intros; rfl }
  let evFree : VecLatHom (Free p E) ℝ := {
    toFun f := f φ
    map_add' := by intros; rfl
    map_smul' := by intros; rfl
    map_sup' := by intros; rfl
    map_inf' := by intros; rfl }
  have hleft : ev.comp (FVLv.lift S.toLinearMap) =
      FVLv.lift (φ : E →ₗ[ℝ] ℝ) := by
    apply FVLv.lift_unique
    intro x
    change (FVLv.lift S.toLinearMap (FVLv.of x)) k = φ x
    rw [FVLv.lift_of]
    rfl
  have hright : evFree.comp (ofFVL p) =
      FVLv.lift (φ : E →ₗ[ℝ] ℝ) := by
    apply FVLv.lift_unique
    intro x
    change ofFVL p (FVLv.of x) φ = φ x
    rw [ofFVL_of]
    rfl
  exact DFunLike.congr_fun (hleft.trans hright.symm) v

/-- The algebraic free-lattice lift is bounded for every compact-space continuous-function target.
The estimate holds for every exponent because one dual functional norms each point evaluation. -/
theorem fvl_lift_continuousMap_norm_le {K : Type*}
    [TopologicalSpace K] [CompactSpace K] (p : Exponent)
    (S : E →L[ℝ] C(K, ℝ)) (v : FVLv E) :
    ‖FVLv.lift S.toLinearMap v‖ ≤ ‖S‖ * ‖ofFVL p v‖ := by
  apply (ContinuousMap.norm_le (FVLv.lift S.toLinearMap v)
    (mul_nonneg (norm_nonneg S) (norm_nonneg (ofFVL p v)))).mpr
  intro k
  let φ : Dual E := (ContinuousMap.evalCLM ℝ k).comp S
  rw [fvl_lift_continuousMap_apply p S v k]
  have hφnorm : ‖φ‖ ≤ ‖S‖ := by
    apply φ.opNorm_le_bound (norm_nonneg S)
    intro x
    calc
      ‖φ x‖ = ‖S x k‖ := rfl
      _ ≤ ‖S x‖ := ContinuousMap.norm_coe_le_norm (S x) k
      _ ≤ ‖S‖ * ‖x‖ := S.le_opNorm x
  calc
    ‖ofFVL p v φ‖ ≤ ‖φ‖ * ‖ofFVL p v‖ := by
      have h := hp_apply_abs_le p (ofFVL p v).1 φ
      change |ofFVL p v φ| ≤ ‖φ‖ * ‖ofFVL p v‖ at h
      simpa only [Real.norm_eq_abs] using h
    _ ≤ ‖S‖ * ‖ofFVL p v‖ :=
      mul_le_mul_of_nonneg_right hφnorm (norm_nonneg _)
end ContinuousMapLift

section AlgebraicLiftExtension
private theorem exists_bounded_linear_extension
    {V W X : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
    [NormedAddCommGroup W] [NormedSpace ℝ W]
    [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]
    (e : V →ₗ[ℝ] W) (he : DenseRange e) (B : V →ₗ[ℝ] X)
    (C : ℝ) (hC : 0 ≤ C) (hB : ∀ z, ‖B z‖ ≤ C * ‖e z‖) :
    ∃ A : W →L[ℝ] X, (∀ z, A (e z) = B z) ∧ ‖A‖ ≤ C := by
  let A := B.extendOfNorm e
  refine ⟨A, ?_, ?_⟩
  · exact LinearMap.extendOfNorm_eq he ⟨C, hB⟩
  · apply A.opNorm_le_bound hC
    exact LinearMap.norm_extendOfNorm_apply_le he C hB

private theorem endpointRangeEquiv_apply (p : Exponent) (v : FVLv E) :
    (endpointRange (E := E) p).subtype ((endpointRangeEquiv p) v) = ofFVL p v :=
  LinearEquiv.ofInjective_apply (f := (ofFVL p (E := E)).toLinearMap)
    (h := (ofFVL_embedding p).1) v

private theorem endpointRangeEquiv_symm_apply (p : Exponent)
    (z : endpointRange (E := E) p) :
    ofFVL p ((endpointRangeEquiv p).symm z) = (z : Free p E) :=
  LinearEquiv.ofInjective_symm_apply (f := (ofFVL p (E := E)).toLinearMap)
    (h := (ofFVL_embedding p).1) z

private theorem exists_algebraic_lift_extension (p : Exponent) {X : Type w}
    [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [BanachLattice X]
    (S : E →L[ℝ] X) (C : ℝ) (hC : 0 ≤ C)
    (hb : ∀ v : FVLv E,
      ‖FVLv.lift S.toLinearMap v‖ ≤ C * ‖ofFVL p v‖) :
    ∃ A : Free p E →L[ℝ] X,
      (∀ v : FVLv E, A (ofFVL p v) = FVLv.lift S.toLinearMap v) ∧ ‖A‖ ≤ C := by
  let B : endpointRange (E := E) p →ₗ[ℝ] X :=
    (FVLv.lift S.toLinearMap).toLinearMap.comp
      (endpointRangeEquiv p).symm.toLinearMap
  have hB (z : endpointRange (E := E) p) :
      ‖B z‖ ≤ C * ‖(endpointRange (E := E) p).subtype z‖ := by
    change ‖FVLv.lift S.toLinearMap ((endpointRangeEquiv p).symm z)‖ ≤ C * ‖(z : Free p E)‖
    rw [← endpointRangeEquiv_symm_apply p z]
    exact hb _
  obtain ⟨A, hA, hnorm⟩ := exists_bounded_linear_extension
    (endpointRange (E := E) p).subtype (endpointRange_dense p) B C hC hB
  refine ⟨A, fun v => ?_, hnorm⟩
  rw [← endpointRangeEquiv_apply p v, hA]
  change FVLv.lift S.toLinearMap
    ((endpointRangeEquiv p).symm ((endpointRangeEquiv p) v)) = _
  rw [LinearEquiv.symm_apply_apply]

private theorem algebraic_lift_extension_map_sup (p : Exponent) {X : Type w}
    [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [NormedVectorLattice X]
    (S : E →L[ℝ] X) (A : Free p E →L[ℝ] X)
    (hA : ∀ v : FVLv E, A (ofFVL p v) = FVLv.lift S.toLinearMap v)
    (f g : Free p E) : A (f ⊔ g) = A f ⊔ A g := by
  refine map_binary_of_dense_range (ofFVL p (E := E)) (denseRange_ofFVL p)
    A A.continuous (· ⊔ ·) (· ⊔ ·) (continuous_fst.sup continuous_snd)
    (continuous_fst.sup continuous_snd) ?_ f g
  intro v w
  rw [← map_sup (ofFVL p (E := E)) v w, hA, hA, hA]
  exact (FVLv.lift S.toLinearMap).map_sup' v w

private theorem algebraic_lift_extension_map_inf (p : Exponent) {X : Type w}
    [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [NormedVectorLattice X]
    (S : E →L[ℝ] X) (A : Free p E →L[ℝ] X)
    (hA : ∀ v : FVLv E, A (ofFVL p v) = FVLv.lift S.toLinearMap v)
    (f g : Free p E) : A (f ⊓ g) = A f ⊓ A g := by
  refine map_binary_of_dense_range (ofFVL p (E := E)) (denseRange_ofFVL p)
    A A.continuous (· ⊓ ·) (· ⊓ ·) (continuous_fst.inf continuous_snd)
    (continuous_fst.inf continuous_snd) ?_ f g
  intro v w
  rw [← map_inf (ofFVL p (E := E)) v w, hA, hA, hA]
  exact (FVLv.lift S.toLinearMap).map_inf' v w

/-- A norm estimate on the algebraic free vector lattice extends its lift to the completed
free Banach lattice, preserving both lattice operations. -/
theorem universal_property_of_fvl_bound (p : Exponent) {X : Type w}
    [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [BanachLattice X]
    (S : E →L[ℝ] X) (C : ℝ) (hC : 0 ≤ C)
    (hb : ∀ v : FVLv E,
      ‖FVLv.lift S.toLinearMap v‖ ≤ C * ‖ofFVL p v‖) :
    ∃ L : LatticeOperator (Free p E) X,
      (∀ x, L (delta p x) = S x) ∧
      ‖L.toContinuousLinearMap‖ ≤ C ∧
      ∀ M : LatticeOperator (Free p E) X,
        (∀ x, M (delta p x) = S x) → M = L := by
  obtain ⟨A, hA, hnorm⟩ := exists_algebraic_lift_extension p S C hC hb
  let L : LatticeOperator (Free p E) X := {
    toContinuousLinearMap := A
    map_sup' := algebraic_lift_extension_map_sup p S A hA
    map_inf' := algebraic_lift_extension_map_inf p S A hA }
  have hgen (x : E) : L (delta p x) = S x := by
    change A (delta p x) = S x
    rw [← ofFVL_of p x, hA, FVLv.lift_of]
    rfl
  refine ⟨L, hgen, ?_, ?_⟩
  · exact hnorm
  · intro M hM
    exact latticeOperator_ext_delta p M L
      (fun x => (hM x).trans (hgen x).symm)
end AlgebraicLiftExtension

/-- The full free-lattice extension into continuous real functions on a compact space. -/
theorem universal_property_continuousMap {K : Type*}
    [TopologicalSpace K] [CompactSpace K] (p : Exponent)
    (S : E →L[ℝ] C(K, ℝ)) :
    ∃ L : LatticeOperator (Free p E) C(K, ℝ),
      (∀ x, L (delta p x) = S x) ∧
      ‖L.toContinuousLinearMap‖ ≤ ‖S‖ ∧
      ∀ M : LatticeOperator (Free p E) C(K, ℝ),
        (∀ x, M (delta p x) = S x) → M = L :=
  universal_property_of_fvl_bound p S ‖S‖ (norm_nonneg S)
    (fvl_lift_continuousMap_norm_le p S)

/-- The universal property for an AM-space with a unit, transported along Kakutani's
lattice-isometric representation as continuous functions on a compact space. -/
theorem universal_property_amSpaceWithUnit {X : Type w}
    [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X]
    [AMSpaceWithUnit X] [Nontrivial X]
    (p : Exponent) (S : E →L[ℝ] X) :
    ∃ L : LatticeOperator (Free p E) X,
      (∀ x, L (delta p x) = S x) ∧
      ‖L.toContinuousLinearMap‖ ≤ ‖S‖ ∧
      ∀ M : LatticeOperator (Free p E) X,
        (∀ x, M (delta p x) = S x) → M = L := by
  let e := AMSpaceWithUnit.kakutaniEquiv X
  let S' : E →L[ℝ] C(AMSpaceWithUnit.LatticeCharacter X, ℝ) :=
    e.toContinuousLinearEquiv.toContinuousLinearMap.comp S
  obtain ⟨L', hgen, hbound, _⟩ := universal_property_continuousMap p S'
  let L : LatticeOperator (Free p E) X := {
    toContinuousLinearMap := e.symm.toContinuousLinearEquiv.toContinuousLinearMap.comp
      L'.toContinuousLinearMap
    map_sup' := by
      intro a b
      change e.symm (L' (a ⊔ b)) = e.symm (L' a) ⊔ e.symm (L' b)
      rw [L'.map_sup']
      exact e.symm.map_sup' _ _
    map_inf' := by
      intro a b
      change e.symm (L' (a ⊓ b)) = e.symm (L' a) ⊓ e.symm (L' b)
      rw [L'.map_inf']
      exact e.symm.map_inf' _ _ }
  refine ⟨L, ?_, ?_, ?_⟩
  · intro x
    change e.symm (L' (delta p x)) = S x
    rw [hgen x]
    change e.toLinearIsometryEquiv.symm (e.toLinearIsometryEquiv (S x)) = S x
    exact e.toLinearIsometryEquiv.symm_apply_apply (S x)
  · calc
      ‖L.toContinuousLinearMap‖ ≤ ‖e.symm.toContinuousLinearEquiv.toContinuousLinearMap‖ *
          ‖L'.toContinuousLinearMap‖ := ContinuousLinearMap.opNorm_comp_le _ _
      _ ≤ ‖S‖ := by
        have he : ‖e.symm.toContinuousLinearEquiv.toContinuousLinearMap‖ ≤ 1 :=
          e.symm.toLinearIsometryEquiv.toLinearIsometry.norm_toContinuousLinearMap_le
        have hS : ‖S'‖ ≤ ‖S‖ := by
          calc
            ‖S'‖ ≤ ‖e.toContinuousLinearEquiv.toContinuousLinearMap‖ * ‖S‖ :=
              ContinuousLinearMap.opNorm_comp_le _ _
            _ ≤ 1 * ‖S‖ := mul_le_mul_of_nonneg_right
              e.toLinearIsometryEquiv.toLinearIsometry.norm_toContinuousLinearMap_le (norm_nonneg S)
            _ = ‖S‖ := one_mul _
        calc
          ‖e.symm.toContinuousLinearEquiv.toContinuousLinearMap‖ * ‖L'.toContinuousLinearMap‖ ≤
              1 * ‖L'.toContinuousLinearMap‖ :=
            mul_le_mul_of_nonneg_right he (norm_nonneg L'.toContinuousLinearMap)
          _ = ‖L'.toContinuousLinearMap‖ := one_mul _
          _ ≤ ‖S'‖ := hbound
          _ ≤ ‖S‖ := hS
  · intro M hM
    exact latticeOperator_ext_delta p M L (fun x => (hM x).trans (by
      change S x = e.symm (L' (delta p x))
      rw [hgen x]
      change S x = e.toLinearIsometryEquiv.symm (e.toLinearIsometryEquiv (S x))
      exact (e.toLinearIsometryEquiv.symm_apply_apply (S x)).symm))

/-- The full free-lattice extension into a finite scalar `ℓᵖ` target. -/
theorem universal_property_piLp (p : Exponent) (n : ℕ)
    (S : E →L[ℝ] PiLp p.1 (fun _ : Fin n => ℝ)) :
    ∃ L : LatticeOperator (Free p E) (PiLp p.1 (fun _ : Fin n => ℝ)),
      (∀ x, L (delta p x) = S x) ∧
      ‖L.toContinuousLinearMap‖ ≤ ‖S‖ ∧
      ∀ M : LatticeOperator (Free p E) (PiLp p.1 (fun _ : Fin n => ℝ)),
        (∀ x, M (delta p x) = S x) → M = L :=
  universal_property_of_fvl_bound p S ‖S‖ (norm_nonneg S)
    (fvl_lift_piLp_norm_le p n S)

/-- The full universal property at p = 1, transported from BanLat. -/
theorem universal_property_one (X : Type w)
    [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [BanachLattice X]
    (hX : IsPConvex Exponent.one X) (S : E →L[ℝ] X) :
    ∃ L : LatticeOperator (Free Exponent.one E) X,
      (∀ x, L (delta Exponent.one x) = S x) ∧
      ‖L.toContinuousLinearMap‖ ≤ convexityConstant Exponent.one X * ‖S‖ ∧
      ∀ M : LatticeOperator (Free Exponent.one E) X,
        (∀ x, M (delta Exponent.one x) = S x) → M = L := by
  obtain ⟨L, hL, hbound⟩ := universal_property_one_core S
  refine ⟨L, hL, ?_, ?_⟩
  · calc
      ‖L.toContinuousLinearMap‖ ≤ ‖S‖ := hbound
      _ = 1 * ‖S‖ := (one_mul _).symm
      _ ≤ convexityConstant Exponent.one X * ‖S‖ :=
        mul_le_mul_of_nonneg_right (convexityConstant_ge_one Exponent.one hX) (norm_nonneg S)
  · intro M hM
    exact latticeOperator_ext_delta Exponent.one M L
      (fun x => (hM x).trans (hL x).symm)

/-- The universal property of `Free p E`: every bounded linear map from E into a
p-convex Banach lattice X extends uniquely to a bounded lattice homomorphism. Its operator
norm is bounded by the optimal p-convexity constant of X times the original operator norm.
Uniqueness is among all bounded lattice homomorphisms agreeing on `delta p`. -/
theorem universal_property (p : Exponent) {X : Type w}
    [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [BanachLattice X]
    (hX : IsPConvex p X) (S : E →L[ℝ] X) :
    ∃ L : LatticeOperator (Free p E) X,
      (∀ x, L (delta p x) = S x) ∧
      ‖L.toContinuousLinearMap‖ ≤ convexityConstant p X * ‖S‖ ∧
      ∀ M : LatticeOperator (Free p E) X, (∀ x, M (delta p x) = S x) → M = L := by
  exact universal_property_of_fvl_bound p S (convexityConstant p X * ‖S‖)
    (mul_nonneg (le_trans zero_le_one (convexityConstant_ge_one p hX)) (norm_nonneg S))
    (fvl_lift_pConvex_norm_le p (convexityConstant_spec p hX) S)

/-- Functoriality of the free-lattice construction: inducing a composite bounded linear
map gives the composite of the induced lattice maps. -/
theorem induced_comp (p : Exponent) {G : Type w}
    [NormedAddCommGroup G] [NormedSpace ℝ G] (S : E →L[ℝ] G) (T : F →L[ℝ] E) :
    (induced p (S.comp T)).toContinuousLinearMap =
      (induced p S).toContinuousLinearMap.comp (induced p T).toContinuousLinearMap := by
  apply ContinuousLinearMap.ext
  intro f
  apply Subtype.ext
  apply Subtype.ext
  funext φ
  rfl

/-- The induced map of the identity is the identity. -/
theorem induced_id (p : Exponent) :
    (induced p (ContinuousLinearMap.id ℝ E)).toContinuousLinearMap =
      ContinuousLinearMap.id ℝ (Free p E) := by
  apply ContinuousLinearMap.ext
  intro f
  apply Subtype.ext
  apply Subtype.ext
  funext φ
  rfl

/-- A bounded left inverse makes the induced map injective. -/
theorem induced_injective_of_leftInverse (p : Exponent)
    (T : F →L[ℝ] E) (U : E →L[ℝ] F)
    (h : U.comp T = ContinuousLinearMap.id ℝ F) :
    Function.Injective (induced p T) := by
  intro f g hfg
  have hcomp := induced_comp p U T
  rw [h, induced_id] at hcomp
  have hf := congrArg (fun L : Free p F →L[ℝ] Free p F => L f) hcomp
  have hg := congrArg (fun L : Free p F →L[ℝ] Free p F => L g) hcomp
  simpa only [ContinuousLinearMap.id_apply, ContinuousLinearMap.comp_apply] using
    hf.trans ((congrArg (fun z => induced p U z) hfg).trans hg.symm)

/-- A bounded right inverse makes the induced map surjective. -/
theorem induced_surjective_of_rightInverse (p : Exponent)
    (T : F →L[ℝ] E) (U : E →L[ℝ] F)
    (h : T.comp U = ContinuousLinearMap.id ℝ E) :
    Function.Surjective (induced p T) := by
  intro g
  refine ⟨induced p U g, ?_⟩
  have hcomp := induced_comp p T U
  rw [h, induced_id] at hcomp
  have hg := congrArg (fun L : Free p E →L[ℝ] Free p E => L g) hcomp
  simpa using hg.symm

/-- The induced operator vanishes exactly when the original operator does. -/
theorem induced_eq_zero_iff (p : Exponent) (T : F →L[ℝ] E) :
    (induced p T).toContinuousLinearMap = 0 ↔ T = 0 := by
  calc
    (induced p T).toContinuousLinearMap = 0 ↔
        ‖(induced p T).toContinuousLinearMap‖ = 0 := norm_eq_zero.symm
    _ ↔ ‖T‖ = 0 := by rw [(induced_norm_generators p T).1]
    _ ↔ T = 0 := norm_eq_zero

/-- Injectivity of the induced operator forces injectivity on the generators. -/
theorem induced_injective_imp (p : Exponent) (T : F →L[ℝ] E)
    (h : Function.Injective (induced p T)) : Function.Injective T := by
  intro x y hxy
  apply (delta p).injective
  apply h
  rw [(induced_norm_generators p T).2 x,
    (induced_norm_generators p T).2 y, hxy]

/-- A surjective dual pullback makes the induced free-lattice operator injective. -/
theorem induced_injective_of_dual_surjective (p : Exponent) (T : F →L[ℝ] E)
    (h : ∀ φ : Dual F, ∃ ψ : Dual E, ψ.comp T = φ) :
    Function.Injective (induced p T) := by
  intro f g hfg
  apply Subtype.ext
  apply Subtype.ext
  funext φ
  obtain ⟨ψ, rfl⟩ := h φ
  exact congrArg (fun k : Free p E => k ψ) hfg

/-- Norm density of the dual pullback suffices for injectivity of the induced map. -/
theorem induced_injective_of_dual_denseRange (p : Exponent) (T : F →L[ℝ] E)
    (h : DenseRange (fun ψ : Dual E => ψ.comp T)) :
    Function.Injective (induced p T) := by
  intro f g hfg
  apply Subtype.ext
  apply Subtype.ext
  have heq : (fun φ : Dual F => f φ) = (fun φ : Dual F => g φ) :=
    h.equalizer (free_function_norm_continuous p f)
      (free_function_norm_continuous p g) (by
        funext ψ
        exact congrArg (fun k : Free p E => k ψ) hfg)
  exact heq

/-- Density of the dual pullback in the compactly generated weak-star topology suffices for
injectivity. This is the topology in which every free function is continuous. -/
theorem induced_injective_of_dual_compactlyGenerated_dense [CompleteSpace F]
    (p : Exponent) (T : F →L[ℝ] E)
    (h : @DenseRange (WeakDual ℝ F)
      (TopologicalSpace.compactlyGenerated (WeakDual ℝ F))
      (Dual E)
      (fun ψ => (StrongDual.toWeakDual (ψ.comp T) : WeakDual ℝ F))) :
    Function.Injective (induced p T) := by
  let : TopologicalSpace (WeakDual ℝ F) :=
    TopologicalSpace.compactlyGenerated (WeakDual ℝ F)
  intro f g hfg
  apply Subtype.ext
  apply Subtype.ext
  have heq := h.equalizer (weakStar_continuous_compactlyGenerated p f)
    (weakStar_continuous_compactlyGenerated p g) (by
      funext ψ
      exact congrArg (fun k : Free p E => k ψ) hfg)
  funext φ
  exact congrFun heq (StrongDual.toWeakDual φ)

/-- For an injective operator, a dual functional can be matched on any finite set
by pulling back a dual functional from the codomain. -/
private theorem dual_pullback_finset_interp (T : F →L[ℝ] E)
    (hT : Function.Injective T) (s : Finset F) (φ : Dual F) :
    ∃ ψ : Dual E, ∀ x ∈ s, ψ (T x) = φ x := by
  let V : Submodule ℝ F := Submodule.span ℝ (s : Set F)
  let t : V →ₗ[ℝ] E := T.toLinearMap.comp V.subtype
  let W : Submodule ℝ E := t.range
  have : FiniteDimensional ℝ V := FiniteDimensional.span_finset ℝ s
  have : FiniteDimensional ℝ W :=
    FiniteDimensional.of_surjective t.rangeRestrict t.surjective_rangeRestrict
  have htinj : Function.Injective t := by
    intro a b hab
    apply Subtype.ext
    exact hT hab
  let e : V ≃ₗ[ℝ] W := LinearEquiv.ofBijective t.rangeRestrict
    ⟨(fun a b hab => htinj (congrArg Subtype.val hab)), t.surjective_rangeRestrict⟩
  let ell : W →ₗ[ℝ] ℝ := (φ : F →ₗ[ℝ] ℝ).comp (V.subtype.comp e.symm.toLinearMap)
  let ellc : Dual W := ⟨ell, ell.continuous_of_finiteDimensional⟩
  obtain ⟨ψ, hψ, _⟩ := exists_extension_norm_eq W ellc
  refine ⟨ψ, ?_⟩
  intro x hx
  have hxV : x ∈ V := Submodule.subset_span hx
  let vx : V := ⟨x, hxV⟩
  have hte : (e vx : E) = T x := rfl
  calc
    ψ (T x) = ψ (e vx : E) := by rw [hte]
    _ = ellc (e vx) := hψ (e vx)
    _ = φ x := by simp [ellc, ell, e, vx]

/-- The range of dual pullback is convex in the weak-star dual. -/
theorem dual_pullback_range_convex (T : F →L[ℝ] E) :
    Convex ℝ (Set.range (fun ψ : Dual E =>
      (StrongDual.toWeakDual (ψ.comp T) : WeakDual ℝ F))) := by
  let L : Dual E →ₗ[ℝ] WeakDual ℝ F := {
    toFun := fun ψ => StrongDual.toWeakDual (ψ.comp T)
    map_add' := by
      intro ψ χ
      change StrongDual.toWeakDual ((ψ + χ).comp T) =
        StrongDual.toWeakDual (ψ.comp T) + StrongDual.toWeakDual (χ.comp T)
      rw [← map_add]
      congr 1
    map_smul' := by
      intro a ψ
      change StrongDual.toWeakDual ((a • ψ).comp T) =
        a • StrongDual.toWeakDual (ψ.comp T)
      rw [← map_smul]
      congr 1 }
  change Convex ℝ (LinearMap.range L : Set (WeakDual ℝ F))
  exact Submodule.convex _

/-- The pullback of dual functionals along an injective operator is weak-star dense. -/
theorem dual_pullback_weakstar_dense (T : F →L[ℝ] E)
    (hT : Function.Injective T) :
    DenseRange (fun ψ : Dual E => (StrongDual.toWeakDual (ψ.comp T) : WeakDual ℝ F)) := by
  apply denseRange_iff_closure_range.mpr
  ext φ
  constructor
  · intro _; trivial
  · intro _
    rw [mem_closure_iff_nhds]
    intro U hU
    have hEmb : Topology.IsEmbedding (fun θ : WeakDual ℝ F => (θ : F → ℝ)) :=
      WeakBilin.isEmbedding (by
        intro a b hab
        apply ContinuousLinearMap.ext
        intro x
        simpa only [topDualPairing_apply] using
          congrArg (fun l : F →ₗ[ℝ] ℝ => l x) hab)
    have hnhds : (𝓝 φ : Filter (WeakDual ℝ F)) =
        Filter.comap (fun θ : WeakDual ℝ F => (θ : F → ℝ))
          (𝓝 (fun x : F => φ x)) := hEmb.isInducing.nhds_eq_comap φ
    rw [hnhds] at hU
    obtain ⟨V, hV, hVU⟩ := Filter.mem_comap.mp hU
    rw [nhds_pi] at hV
    have hV' : V ∈ Filter.pi (fun x : F => pure (φ x)) :=
      Filter.pi_mono (fun x => pure_le_nhds (φ x)) hV
    obtain ⟨I, hIfinite, hIV⟩ := Filter.mem_pi_pure.mp hV'
    obtain ⟨ψ, hψ⟩ := dual_pullback_finset_interp T hT hIfinite.toFinset
      φ.toStrongDual
    refine ⟨StrongDual.toWeakDual (ψ.comp T), ?_, ⟨ψ, rfl⟩⟩
    apply hVU
    apply hIV
    intro x hx
    have hxs : x ∈ hIfinite.toFinset := hIfinite.mem_toFinset.mpr hx
    simpa only [ContinuousLinearMap.comp_apply, StrongDual.toWeakDual_apply,
      WeakDual.toStrongDual_apply] using hψ x hxs

private theorem weakDual_finite_separator (C : Set (WeakDual ℝ E)) (hC : IsCompact C)
    (S : Set E) (hS : ∀ φ ∈ C, ∃ x ∈ S, 1 < |φ x|) :
    ∃ s : Finset E, (∀ x ∈ s, x ∈ S) ∧ ∀ φ ∈ C, ∃ x ∈ s, 1 < |φ x| := by
  classical
  let U (x : S) : Set (WeakDual ℝ E) := {φ | 1 < |φ x|}
  have hU (x : S) : IsOpen (U x) :=
    isOpen_lt continuous_const (WeakDual.eval_continuous (x : E)).abs
  have hcover : C ⊆ ⋃ x : S, U x := by
    intro φ hφ
    obtain ⟨x, hx, hval⟩ := hS φ hφ
    exact mem_iUnion.mpr ⟨⟨x, hx⟩, hval⟩
  obtain ⟨s, hs⟩ := hC.elim_finite_subcover U hU hcover
  refine ⟨s.image Subtype.val, ?_, ?_⟩
  · intro x hx
    obtain ⟨y, _, rfl⟩ := Finset.mem_image.mp hx
    exact y.property
  · intro φ hφ
    obtain ⟨x, hx, hval⟩ := mem_iUnion₂.mp (hs hφ)
    exact ⟨x, Finset.mem_image.mpr ⟨x, hx, rfl⟩, hval⟩

private theorem weakDual_small_separator (φ : WeakDual ℝ E) {r : ℝ}
    (hr : 0 < r) (hφ : r < ‖φ.toStrongDual‖) :
    ∃ x : E, ‖x‖ ≤ r⁻¹ ∧ 1 < |φ x| := by
  obtain ⟨y, hy, hval⟩ := φ.toStrongDual.exists_lt_apply_of_lt_opNorm hφ
  refine ⟨r⁻¹ • y, ?_, ?_⟩
  · rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hr)]
    exact (mul_le_mul_of_nonneg_left hy.le (inv_nonneg.mpr hr.le)).trans_eq (mul_one _)
  · rw [map_smul, smul_eq_mul]
    rw [abs_mul, abs_of_pos (inv_pos.mpr hr)]
    have h := mul_lt_mul_of_pos_left hval (inv_pos.mpr hr)
    simpa only [inv_mul_cancel₀ hr.ne', Real.norm_eq_abs, WeakDual.toStrongDual_apply] using h

omit [NormedSpace ℝ E] in
private theorem isCompact_insert_iUnion_finset_small (s : ℕ → Finset E)
    (hs : ∀ n x, x ∈ s n → ‖x‖ ≤ ((n : ℝ) + 1)⁻¹) :
    IsCompact (insert 0 (⋃ n, (s n : Set E))) := by
  classical
  apply isCompact_of_finite_subcover
  intro ι U hU hcover
  obtain ⟨i₀, hi₀⟩ := mem_iUnion.mp (hcover (mem_insert 0 _))
  obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp (hU i₀) 0 hi₀
  obtain ⟨N, hN⟩ := exists_nat_one_div_lt hδ
  let H : Finset E := (Finset.range N).biUnion s
  have hHcover : (H : Set E) ⊆ ⋃ i, U i := by
    intro x hx
    obtain ⟨n, _, hxn⟩ := Finset.mem_biUnion.mp hx
    exact hcover (mem_insert_of_mem 0 (mem_iUnion.mpr ⟨n, hxn⟩))
  obtain ⟨t, ht⟩ := H.finite_toSet.isCompact.elim_finite_subcover U hU hHcover
  refine ⟨insert i₀ t, ?_⟩
  intro x hx
  rcases mem_insert_iff.mp hx with rfl | hx
  · exact mem_iUnion₂.mpr ⟨i₀, Finset.mem_insert_self _ _, hi₀⟩
  · obtain ⟨n, hxn⟩ := mem_iUnion.mp hx
    by_cases hn : n < N
    · have hxH : x ∈ H := Finset.mem_biUnion.mpr ⟨n, Finset.mem_range.mpr hn, hxn⟩
      obtain ⟨i, hi, hxi⟩ := mem_iUnion₂.mp (ht hxH)
      exact mem_iUnion₂.mpr ⟨i, Finset.mem_insert_of_mem hi, hxi⟩
    · have hn' : (N : ℝ) ≤ n := by exact_mod_cast Nat.le_of_not_gt hn
      have hnorm : ‖x‖ < δ := calc
        ‖x‖ ≤ ((n : ℝ) + 1)⁻¹ := hs n x hxn
        _ ≤ ((N : ℝ) + 1)⁻¹ := inv_anti₀ (by positivity) (by linarith)
        _ < δ := by simpa only [one_div] using hN
      have hxU := hball (show x ∈ Metric.ball 0 δ by simpa using hnorm)
      exact mem_iUnion₂.mpr ⟨i₀, Finset.mem_insert_self _ _, hxU⟩

/-- A set closed on every weak-star dual ball and avoiding zero is separated from zero by
uniform evaluation on a norm-compact set of predual vectors. Finite separating families are
constructed on successive balls, with the norms of newly added vectors tending to zero. -/
theorem weakDual_exists_compact_separator (C : Set (WeakDual ℝ E))
    (hC : ∀ R : ℝ, IsClosed (C ∩ weakDualNormBall (E := E) R))
    (h0 : (0 : WeakDual ℝ E) ∉ C) :
    ∃ K : Set E, IsCompact K ∧ ∀ φ ∈ C, ∃ x ∈ K, 1 < |φ x| := by
  classical
  have hball (R : ℝ) : IsCompact (C ∩ weakDualNormBall (E := E) R) := by
    apply (WeakDual.isCompact_closedBall (0 : Dual E) R).of_isClosed_subset (hC R)
    intro φ hφ
    simpa only [weakDualNormBall, Set.mem_ofPred_eq, Set.mem_preimage,
      Metric.mem_closedBall, dist_zero_right] using hφ.2
  let P (n : ℕ) (s : Finset E) : Prop :=
    ∀ φ ∈ C, ‖φ.toStrongDual‖ ≤ (n : ℝ) + 1 → ∃ x ∈ s, 1 < |φ x|
  have hinit : ∃ s : Finset E, P 0 s := by
    have hw : ∀ φ ∈ C ∩ weakDualNormBall (E := E) 1, ∃ x ∈ (univ : Set E), 1 < |φ x| := by
      intro φ hφ
      have hn : 0 < ‖φ.toStrongDual‖ := norm_pos_iff.mpr (by
        intro hz
        apply h0
        have hφ0 : φ = 0 := WeakDual.toStrongDual.injective (by simpa using hz)
        simpa [hφ0] using hφ.1)
      obtain ⟨x, _, hx⟩ := weakDual_small_separator φ (half_pos hn) (half_lt_self hn)
      exact ⟨x, mem_univ x, hx⟩
    obtain ⟨s, _, hs⟩ := weakDual_finite_separator _ (hball 1) univ hw
    refine ⟨s, ?_⟩
    intro φ hφ hn
    apply hs φ
    exact ⟨hφ, by simpa [weakDualNormBall] using hn⟩
  have hstep (n : ℕ) (s : Finset E) (hs : P n s) :
      ∃ t : Finset E, (∀ x ∈ t, ‖x‖ ≤ ((n : ℝ) + 1)⁻¹) ∧ P (n + 1) (s ∪ t) := by
    let D : Set (WeakDual ℝ E) :=
      (C ∩ weakDualNormBall (E := E) ((n : ℝ) + 2)) ∩ {φ | ∀ x ∈ s, |φ x| ≤ 1}
    have hD : IsCompact D := by
      apply (hball ((n : ℝ) + 2)).inter_right
      have heq : {φ : WeakDual ℝ E | ∀ x ∈ s, |φ x| ≤ 1} =
          ⋂ x ∈ s, {φ : WeakDual ℝ E | |φ x| ≤ 1} := by ext φ; simp
      rw [heq]
      exact isClosed_biInter fun x _ =>
        isClosed_le (WeakDual.eval_continuous x).abs continuous_const
    have hlarge (φ : WeakDual ℝ E) (hφ : φ ∈ D) : (n : ℝ) + 1 < ‖φ.toStrongDual‖ := by
      by_contra hn
      obtain ⟨x, hx, hval⟩ := hs φ hφ.1.1 (le_of_not_gt hn)
      exact (not_lt_of_ge (hφ.2 x hx)) hval
    obtain ⟨t, ht, hsep⟩ := weakDual_finite_separator D hD
      {x : E | ‖x‖ ≤ ((n : ℝ) + 1)⁻¹} (fun φ hφ =>
        weakDual_small_separator φ (by positivity) (hlarge φ hφ))
    refine ⟨t, ht, ?_⟩
    intro φ hφ hn
    by_cases hold : ∃ x ∈ s, 1 < |φ x|
    · obtain ⟨x, hx, hval⟩ := hold
      exact ⟨x, Finset.mem_union_left _ hx, hval⟩
    · have hφD : φ ∈ D := by
        refine ⟨⟨hφ, ?_⟩, ?_⟩
        · change ‖φ.toStrongDual‖ ≤ (n : ℝ) + 2
          simpa only [Nat.cast_add, Nat.cast_one, add_assoc, one_add_one_eq_two] using hn
        · intro x hx
          exact le_of_not_gt (fun hval => hold ⟨x, hx, hval⟩)
      obtain ⟨x, hx, hval⟩ := hsep φ hφD
      exact ⟨x, Finset.mem_union_right _ hx, hval⟩
  choose t ht hnext using hstep
  obtain ⟨s₀, hs₀⟩ := hinit
  let b : ∀ n, {s : Finset E // P n s} :=
    fun n => Nat.rec ⟨s₀, hs₀⟩ (fun n s =>
      ⟨s.val ∪ t n s.val s.property, hnext n s.val s.property⟩) n
  let d (n : ℕ) : Finset E := t n (b n).val (b n).property
  let K : Set E := (s₀ : Set E) ∪ insert 0 (⋃ n, (d n : Set E))
  have hK : IsCompact K := s₀.finite_toSet.isCompact.union
    (isCompact_insert_iUnion_finset_small d (fun n => ht n (b n).val (b n).property))
  have hbK (n : ℕ) : ((b n).val : Set E) ⊆ K := by
    induction n with
    | zero => exact subset_union_left
    | succ n ih =>
      intro x hx
      change x ∈ (b n).val ∪ d n at hx
      rcases Finset.mem_union.mp hx with hx | hx
      · exact ih hx
      · exact Or.inr (mem_insert_of_mem 0 (mem_iUnion.mpr ⟨n, hx⟩))
  refine ⟨K, hK, ?_⟩
  intro φ hφ
  obtain ⟨n, hn⟩ := exists_nat_gt ‖φ.toStrongDual‖
  obtain ⟨x, hx, hval⟩ := (b n).property φ hφ (by linarith)
  exact ⟨x, hbK n hx, hval⟩

/-- For an injective operator with Banach domain, dual pullbacks approximate every functional
uniformly on each norm-compact set. The closed absolutely convex hull is compact; separating
its graph under `(T, φ)` from `(0, ε)` gives the approximating functional. -/
theorem dual_pullback_uniform_approx_compact [CompleteSpace F] (T : F →L[ℝ] E)
    (hT : Function.Injective T) (K : Set F) (hK : IsCompact K)
    (φ : Dual F) {ε : ℝ} (hε : 0 < ε) :
    ∃ ψ : Dual E, ∀ x ∈ K, |ψ (T x) - φ x| < ε := by
  let A : Set F := closedAbsConvexHull ℝ (insert 0 K)
  have hAcompact : IsCompact A :=
    isCompact_closedAbsConvexHull_of_totallyBounded (hK.insert 0).totallyBounded
  have hAabs : AbsConvex ℝ A := absConvex_convexClosedHull
  have hA0 : (0 : F) ∈ A := subset_closedAbsConvexHull (mem_insert _ _)
  let L : F →L[ℝ] E × ℝ := T.prod φ
  have hnot : (0, ε) ∉ L '' A := by
    rintro ⟨x, _, hx⟩
    have hTx : T x = 0 := congrArg Prod.fst hx
    have hx0 : x = 0 := hT (hTx.trans (map_zero T).symm)
    have hφx : φ x = ε := congrArg Prod.snd hx
    simp only [hx0, map_zero] at hφx
    exact hε.ne' hφx.symm
  obtain ⟨f, a, hfa, ha⟩ := geometric_hahn_banach_closed_point
    (hAabs.2.linear_image L.toLinearMap) (hAcompact.image L.continuous).isClosed hnot
  have ha0 : 0 < a := by
    simpa using hfa (L 0) ⟨0, hA0, rfl⟩
  let c : ℝ := f (0, 1)
  have hfvertical (r : ℝ) : f (0, r) = r * c := by
    simpa [c] using f.map_smul r (0, 1)
  rw [hfvertical] at ha
  have hc : 0 < c := (mul_pos_iff_of_pos_left hε).mp (ha0.trans ha)
  let ψ : Dual E := -(c⁻¹ • f.comp (ContinuousLinearMap.inl ℝ E ℝ))
  refine ⟨ψ, ?_⟩
  intro x hx
  have hxA : x ∈ A := subset_closedAbsConvexHull (mem_insert_of_mem 0 hx)
  have hnxA : -x ∈ A := by
    simpa using hAabs.1.smul_mem (show ‖(-1 : ℝ)‖ ≤ 1 by norm_num) hxA
  have hbound : |f (L x)| < ε * c := by
    have hpos := hfa (L x) ⟨x, hxA, rfl⟩
    have hneg := hfa (L (-x)) ⟨-x, hnxA, rfl⟩
    simp only [map_neg] at hneg
    exact (abs_lt.mpr ⟨by linarith, hpos⟩).trans ha
  have hfL : f (L x) = f (T x, 0) + φ x * c := by
    have heq : L x = (T x, 0) + (0, φ x) := by simp [L]
    rw [heq, map_add, hfvertical]
  have herror : ψ (T x) - φ x = -(f (L x) / c) := by
    change -(c⁻¹ * f (T x, 0)) - φ x = -(f (L x) / c)
    rw [hfL]
    field_simp
    ring
  rw [herror, abs_neg, abs_div, abs_of_pos hc]
  exact (div_lt_iff₀ hc).mpr hbound

open scoped CompactConvergenceCLM in
/-- Dual pullback along an injective operator with Banach domain has dense range for uniform
convergence on norm-compact subsets of the domain. -/
theorem dual_pullback_compactConvergence_dense [CompleteSpace F] (T : F →L[ℝ] E)
    (hT : Function.Injective T) :
    DenseRange (fun ψ : Dual E =>
      (UniformConvergenceCLM.ofFun (RingHom.id ℝ) ℝ
        {K : Set F | IsCompact K} (ψ.comp T) : F →L_c[ℝ] ℝ)) := by
  intro φ
  rw [mem_closure_iff_nhds]
  intro U hU
  have hU0 : (fun η : F →L_c[ℝ] ℝ => η + φ) ⁻¹' U ∈ 𝓝 0 := by
    exact (continuous_id.add continuous_const).continuousAt.preimage_mem_nhds (by simpa using hU)
  obtain ⟨⟨K, ε⟩, ⟨hK, hε⟩, hsub⟩ :=
    (CompactConvergenceCLM.hasBasis_nhds_zero_of_basis
      (σ := RingHom.id ℝ) (E := F) (Metric.nhds_basis_ball (x := (0 : ℝ)))).mem_iff.mp hU0
  let e := UniformConvergenceCLM.ofFun (RingHom.id ℝ) ℝ {K : Set F | IsCompact K}
  obtain ⟨ψ, hψ⟩ := dual_pullback_uniform_approx_compact T hT K hK (e.symm φ) hε
  refine ⟨e (ψ.comp T), ?_, ψ, rfl⟩
  have hmem : e (ψ.comp T) - φ ∈ {f : F →L_c[ℝ] ℝ |
      ∀ x ∈ K, f x ∈ Metric.ball 0 ε} := by
    intro x hx
    rw [Metric.mem_ball, dist_zero_right, Real.norm_eq_abs]
    change |ψ (T x) - (e.symm φ) x| < ε
    exact hψ x hx
  simpa only [Set.mem_preimage, sub_add_cancel] using hsub hmem

/-- An injective operator with Banach domain induces an injective free-lattice map. -/
theorem induced_injective_of [CompleteSpace F] (p : Exponent) (T : F →L[ℝ] E)
    (hT : Function.Injective T) : Function.Injective (induced p T) := by
  intro f g hfg
  apply Subtype.ext
  apply Subtype.ext
  funext φ
  by_contra hφ
  let C : Set (WeakDual ℝ F) := {θ | f (θ.toStrongDual + φ) = g (θ.toStrongDual + φ)}
  have h0 : (0 : WeakDual ℝ F) ∉ C := by simpa [C] using hφ
  have hC (R : ℝ) : IsClosed (C ∩ weakDualNormBall (E := F) R) := by
    have hB : IsClosed (weakDualNormBall (E := F) R) := by
      convert WeakDual.isClosed_closedBall (0 : Dual F) R using 1
      ext θ
      simp [weakDualNormBall, Metric.mem_closedBall, dist_zero_right]
    have hcont (a : Free p F) :
        ContinuousOn (fun θ : WeakDual ℝ F => a (θ.toStrongDual + φ))
          (weakDualNormBall (E := F) R) := by
      have htrans : ContinuousOn (fun θ : WeakDual ℝ F => θ + StrongDual.toWeakDual φ)
          (weakDualNormBall (E := F) R) := (continuous_id.add continuous_const).continuousOn
      have hc := (weakStar_continuous_bounded p a (R + ‖φ‖)).comp htrans (by
          intro θ hθ
          change ‖θ.toStrongDual + φ‖ ≤ R + ‖φ‖
          change ‖θ.toStrongDual‖ ≤ R at hθ
          exact (norm_add_le _ _).trans (add_le_add hθ le_rfl))
      convert hc using 1
      funext θ
      rfl
    simpa only [C, Set.ofPred_and, Set.ofPred_mem_eq, inter_comm]
      using hB.isClosed_eq (hcont f) (hcont g)
  obtain ⟨K, hK, hsep⟩ := weakDual_exists_compact_separator C hC h0
  obtain ⟨ψ, hψ⟩ := dual_pullback_uniform_approx_compact T hT K hK φ zero_lt_one
  let θ : WeakDual ℝ F := StrongDual.toWeakDual (ψ.comp T - φ)
  have hθ : θ ∈ C := by
    change f ((ψ.comp T - φ) + φ) = g ((ψ.comp T - φ) + φ)
    rw [sub_add_cancel]
    exact congrArg (fun k : Free p E => k ψ) hfg
  obtain ⟨x, hx, hval⟩ := hsep θ hθ
  exact (not_lt_of_gt (hψ x hx)) hval

/-- Injectivity follows if each dual functional can be approximated, in the weak-star topology,
by a norm-bounded slice of the dual pullback range. This isolates the boundedness needed to
apply weak-star continuity of free functions on dual balls. -/
theorem induced_injective_of_dual_bounded_weakstar_dense (p : Exponent) (T : F →L[ℝ] E)
    (h : ∀ φ : Dual F, ∃ R : ℝ,
      (StrongDual.toWeakDual φ : WeakDual ℝ F) ∈
        closure {θ : WeakDual ℝ F |
          (∃ ψ : Dual E, θ = StrongDual.toWeakDual (ψ.comp T)) ∧
          ‖WeakDual.toStrongDual θ‖ ≤ R}) :
    Function.Injective (induced p T) := by
  intro f g hfg
  apply Subtype.ext
  apply Subtype.ext
  funext φ
  obtain ⟨R, hR⟩ := h φ
  let s : Set (WeakDual ℝ F) :=
    {θ | (∃ ψ : Dual E, θ = StrongDual.toWeakDual (ψ.comp T)) ∧
      ‖WeakDual.toStrongDual θ‖ ≤ R}
  let b : Set (WeakDual ℝ F) := {θ | ‖WeakDual.toStrongDual θ‖ ≤ R}
  have hsb : s ⊆ b := fun θ hθ => hθ.2
  have hbclosed : IsClosed b := by
    convert (WeakDual.isClosed_closedBall (0 : Dual F) R) using 1
    ext θ
    simp [b, Metric.mem_closedBall, dist_zero_right]
  have hclosure : closure s ⊆ b := closure_minimal hsb hbclosed
  have hff : ContinuousOn (fun θ : WeakDual ℝ F => f (WeakDual.toStrongDual θ))
      (closure s) := (weakStar_continuous_bounded p f R).mono hclosure
  have hgg : ContinuousOn (fun θ : WeakDual ℝ F => g (WeakDual.toStrongDual θ))
      (closure s) := (weakStar_continuous_bounded p g R).mono hclosure
  have heq : EqOn (fun θ : WeakDual ℝ F => f (WeakDual.toStrongDual θ))
      (fun θ : WeakDual ℝ F => g (WeakDual.toStrongDual θ)) s := by
    intro θ hθ
    obtain ⟨ψ, hψ⟩ := hθ.1
    subst θ
    exact congrArg (fun k : Free p E => k ψ) hfg
  have heqclosure := heq.of_subset_closure hff hgg subset_closure (Subset.rfl)
  exact heqclosure hR

/-- An injective operator with closed range induces an injective operator on the free lattices. -/
theorem induced_injective_of_isClosed_range [CompleteSpace E] [CompleteSpace F]
    (p : Exponent)
    (T : F →L[ℝ] E) (hT : Function.Injective T)
    (hc : IsClosed (Set.range T)) : Function.Injective (induced p T) := by
  apply induced_injective_of_dual_surjective p T
  intro φ
  let R : T.range →L[ℝ] F := (T.equivRange hT hc).symm.toContinuousLinearMap
  obtain ⟨ψ, hψ, _⟩ := exists_extension_norm_eq T.range (φ.comp R)
  refine ⟨ψ, ?_⟩
  apply ContinuousLinearMap.ext
  intro x
  change ψ (T x) = φ x
  rw [hψ ⟨T x, ⟨x, rfl⟩⟩]
  change φ (R ⟨T x, ⟨x, rfl⟩⟩) = φ x
  rw [show R ⟨T x, ⟨x, rfl⟩⟩ = x from by
    exact T.equivRange_symm_apply hT hc x]

/-- Surjectivity of the induced map gives a uniform lower bound for dual pullback. -/
theorem induced_surjective_dual_bound (p : Exponent) (T : F →L[ℝ] E)
    (h : Function.Surjective (induced p T)) :
    ∃ C > 0, ∀ φ : Dual E, ‖φ‖ ≤ C * ‖φ.comp T‖ := by
  have hs : Function.Surjective (induced p T).toContinuousLinearMap := h
  obtain ⟨C, hC, hpre⟩ :=
    (induced p T).toContinuousLinearMap.exists_preimage_norm_le hs
  refine ⟨C, hC, fun φ => ?_⟩
  apply φ.opNorm_le_bound (mul_nonneg hC.le (norm_nonneg _))
  intro x
  obtain ⟨f, hfx, hfn⟩ := hpre (delta p x)
  have hval : φ x = f (φ.comp T) := by
    have hv := congrArg (fun g : Free p E => g φ) hfx
    exact hv.symm
  calc
    ‖φ x‖ = |f (φ.comp T)| := by rw [hval, Real.norm_eq_abs]
    _ ≤ ‖φ.comp T‖ * ‖f‖ := hp_apply_abs_le p f.1 (φ.comp T)
    _ ≤ ‖φ.comp T‖ * (C * ‖delta p x‖) :=
      mul_le_mul_of_nonneg_left hfn (norm_nonneg _)
    _ = (C * ‖φ.comp T‖) * ‖x‖ := by
      rw [(delta p).norm_map]
      ring

private theorem dual_bound_unitBall_closure {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    (T : F →L[ℝ] E) (C : ℝ) (hC : 0 < C)
    (hb : ∀ φ : StrongDual ℝ E, ‖φ‖ ≤ C * ‖φ.comp T‖) :
    Metric.closedBall (0 : E) 1 ⊆
      closure (T '' Metric.closedBall (0 : F) (C + 1)) := by
  intro y hy
  by_contra hn
  let s : Set E := closure (T '' Metric.closedBall (0 : F) (C + 1))
  have hs : Convex ℝ s :=
    ((convex_closedBall (0 : F) (C + 1)).linear_image T.toLinearMap).closure
  obtain ⟨φ, u, hu, huy⟩ := geometric_hahn_banach_closed_point hs isClosed_closure hn
  have hR : 0 < C + 1 := by linarith
  have hzero : (0 : E) ∈ s := by
    apply subset_closure
    exact ⟨0, by simp [hR.le], by simp⟩
  have hu0 : 0 < u := by simpa using hu 0 hzero
  have hbound : ‖φ.comp T‖ ≤ u / (C + 1) := by
    have hpoint (x : F) (hx : ‖x‖ ≤ C + 1) : |φ (T x)| ≤ u := by
      have hxp : φ (T x) < u := hu (T x) (subset_closure ⟨x, by simpa using hx, rfl⟩)
      have hxn : φ (T (-x)) < u := hu (T (-x)) (subset_closure
        ⟨-x, by simpa using hx, rfl⟩)
      have hn' : -φ (T x) < u := by simpa using hxn
      exact abs_le.mpr ⟨by linarith, hxp.le⟩
    apply (φ.comp T).opNorm_le_bound (div_nonneg hu0.le hR.le)
    intro x
    by_cases hx : x = 0
    · simp [hx]
    let v : F := ‖x‖⁻¹ • x
    have hxnorm : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
    have hvnorm : ‖v‖ = 1 := by
      simp [v, norm_smul, inv_mul_cancel₀ hxnorm]
    have hxv : ‖x‖ • v = x := by
      simp [v, smul_smul, mul_inv_cancel₀ hxnorm]
    have hvball : ‖(C + 1) • v‖ ≤ C + 1 := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hR.le, hvnorm, mul_one]
    have hp := hpoint ((C + 1) • v) hvball
    have hvbound : (C + 1) * |φ (T v)| ≤ u := by
      simpa only [T.map_smul, map_smul, smul_eq_mul, abs_mul,
        abs_of_nonneg hR.le] using hp
    have hvle : |φ (T v)| ≤ u / (C + 1) :=
      (le_div_iff₀ hR).mpr (by simpa only [mul_comm] using hvbound)
    change |φ (T x)| ≤ u / (C + 1) * ‖x‖
    calc
      |φ (T x)| = |φ (T (‖x‖ • v))| := by rw [hxv]
      _ = ‖x‖ * |φ (T v)| := by
        rw [T.map_smul, map_smul, smul_eq_mul, abs_mul,
          abs_of_nonneg (norm_nonneg x)]
      _ ≤ ‖x‖ * (u / (C + 1)) := mul_le_mul_of_nonneg_left hvle (norm_nonneg x)
      _ = (u / (C + 1)) * ‖x‖ := mul_comm _ _
  have hphi : φ y ≤ C * ‖φ.comp T‖ := by
    calc
      φ y ≤ ‖φ y‖ := by simpa only [Real.norm_eq_abs] using le_abs_self (φ y)
      _ ≤ ‖φ‖ * ‖y‖ := φ.le_opNorm y
      _ ≤ C * ‖φ.comp T‖ * ‖y‖ := by gcongr; exact hb φ
      _ ≤ C * ‖φ.comp T‖ := by
        have hy1 : ‖y‖ ≤ 1 := by simpa using hy
        nlinarith [mul_nonneg hC.le (norm_nonneg (φ.comp T))]
  have hfinal : C * ‖φ.comp T‖ ≤ u := by
    have hn : 0 ≤ ‖φ.comp T‖ := norm_nonneg _
    have hmul := (mul_le_mul_of_nonneg_left hbound hR.le)
    rw [mul_div_cancel₀ _ hR.ne'] at hmul
    nlinarith
  exact (not_lt_of_ge (hphi.trans hfinal)) huy

private theorem dual_bound_approx_preimage {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    (T : F →L[ℝ] E) (C : ℝ) (hC : 0 < C)
    (hb : ∀ φ : StrongDual ℝ E, ‖φ‖ ≤ C * ‖φ.comp T‖) (y : E) :
    ∃ x : F, ‖T x - y‖ ≤ (1 / 2 : ℝ) * ‖y‖ ∧ ‖x‖ ≤ (C + 1) * ‖y‖ := by
  by_cases hy : y = 0
  · subst y
    exact ⟨0, by simp, by simp⟩
  have hyn : ‖y‖ ≠ 0 := norm_ne_zero_iff.mpr hy
  have hyp : 0 < ‖y‖ := lt_of_le_of_ne (norm_nonneg y) (Ne.symm hyn)
  let z : E := ‖y‖⁻¹ • y
  have hz : z ∈ Metric.closedBall (0 : E) 1 := by
    have hzn : ‖z‖ = 1 := by simp [z, norm_smul, inv_mul_cancel₀ hyn]
    simpa using hzn.le
  have hcl := dual_bound_unitBall_closure T C hC hb hz
  obtain ⟨w, ⟨v, hv, rfl⟩, hd⟩ :=
    (Metric.mem_closure_iff.mp hcl) (1 / 2) (by norm_num)
  have hyz : ‖y‖ • z = y := by simp [z, smul_smul, mul_inv_cancel₀ hyn]
  refine ⟨‖y‖ • v, ?_, ?_⟩
  · have hdist : ‖T v - z‖ < (1 / 2 : ℝ) := by
      simpa only [dist_eq_norm, norm_sub_rev] using hd
    calc
      ‖T (‖y‖ • v) - y‖ = ‖T (‖y‖ • v) - ‖y‖ • z‖ := by rw [hyz]
      _ = ‖y‖ * ‖T v - z‖ := by
        rw [T.map_smul, ← smul_sub, norm_smul, Real.norm_eq_abs,
          abs_of_nonneg (norm_nonneg y)]
      _ ≤ (1 / 2 : ℝ) * ‖y‖ := by
        have h := mul_lt_mul_of_pos_left hdist hyp
        nlinarith
  · have hvn : ‖v‖ ≤ C + 1 := by simpa using hv
    calc
      ‖‖y‖ • v‖ = ‖y‖ * ‖v‖ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg y)]
      _ ≤ (C + 1) * ‖y‖ := by nlinarith [mul_nonneg (norm_nonneg y) (sub_nonneg.mpr hvn)]

private theorem surjective_of_dual_bound {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (T : F →L[ℝ] E) (C : ℝ) (hC : 0 < C)
    (hb : ∀ φ : StrongDual ℝ E, ‖φ‖ ≤ C * ‖φ.comp T‖) :
    Function.Surjective T := by
  have happrox := dual_bound_approx_preimage T C hC hb
  choose g hg using happrox
  let h (y : E) := y - T (g y)
  have hle : ∀ y, ‖h y‖ ≤ (1 / 2 : ℝ) * ‖y‖ := by
    intro y
    simpa only [h, norm_sub_rev] using (hg y).1
  intro y
  have hnle : ∀ n : ℕ, ‖h^[n] y‖ ≤ (1 / 2 : ℝ) ^ n * ‖y‖ := by
    intro n
    induction n with
    | zero => simp only [one_div, one_mul, Function.iterate_zero_apply, pow_zero, le_rfl]
    | succ n IH =>
      rw [Function.iterate_succ']
      apply le_trans (hle _) _
      rw [pow_succ', mul_assoc]
      gcongr
  let u n := g (h^[n] y)
  have ule : ∀ n, ‖u n‖ ≤ (1 / 2 : ℝ) ^ n * ((C + 1) * ‖y‖) := fun n => by
    apply le_trans (hg _).2
    calc
      (C + 1) * ‖h^[n] y‖ ≤ (C + 1) * ((1 / 2 : ℝ) ^ n * ‖y‖) := by
        exact mul_le_mul_of_nonneg_left (hnle n) (by linarith)
      _ = (1 / 2 : ℝ) ^ n * ((C + 1) * ‖y‖) := by ring
  have sNu : Summable fun n => ‖u n‖ := by
    refine .of_nonneg_of_le (fun n => norm_nonneg _) ule ?_
    exact Summable.mul_right _ (summable_geometric_of_lt_one (by simp) (by norm_num))
  have su : Summable u := sNu.of_norm
  let x := tsum u
  have fsumeq : ∀ n : ℕ, T (∑ i ∈ Finset.range n, u i) = y - h^[n] y := by
    intro n
    induction n with
    | zero => simp [T.map_zero]
    | succ n IH => rw [Finset.sum_range_succ, T.map_add, IH, Function.iterate_succ_apply', sub_add]
  have hsum : Filter.Tendsto (fun n => ∑ i ∈ Finset.range n, u i) Filter.atTop (𝓝 x) :=
    su.hasSum.tendsto_sum_nat
  have L₁ : Filter.Tendsto (fun n => T (∑ i ∈ Finset.range n, u i)) Filter.atTop (𝓝 (T x)) :=
    (T.continuous.tendsto _).comp hsum
  simp only [fsumeq] at L₁
  have L₂ : Filter.Tendsto (fun n => y - h^[n] y) Filter.atTop (𝓝 (y - 0)) := by
    refine tendsto_const_nhds.sub ?_
    rw [tendsto_iff_norm_sub_tendsto_zero]
    simp only [sub_zero]
    refine squeeze_zero (fun _ => norm_nonneg _) hnle ?_
    rw [← zero_mul ‖y‖]
    refine (_root_.tendsto_pow_atTop_nhds_zero_of_lt_one ?_ ?_).mul tendsto_const_nhds <;> norm_num
  have feq : T x = y - 0 := tendsto_nhds_unique L₁ L₂
  exact ⟨x, by simpa using feq⟩

/-- Surjectivity of the induced free-lattice map forces surjectivity of the original map. -/
theorem induced_surjective_imp [CompleteSpace F]
    (p : Exponent) (T : F →L[ℝ] E)
    (h : Function.Surjective (induced p T)) : Function.Surjective T := by
  obtain ⟨C, hC, hb⟩ := induced_surjective_dual_bound p T h
  exact surjective_of_dual_bound T C hC hb

/-- Dense range passes from an operator to its induced free-lattice operator. -/
theorem induced_denseRange_of (p : Exponent) (T : F →L[ℝ] E)
    (hT : DenseRange T) : DenseRange (induced p T) := by
  let R : VectorSublattice (Free p E) := {
    toSubmodule := (induced p T).toContinuousLinearMap.range
    sup_mem' := by
      intro a b ha hb
      obtain ⟨f, rfl⟩ := ha
      obtain ⟨g, rfl⟩ := hb
      exact ⟨f ⊔ g, (induced p T).map_sup' f g⟩ }
  have hgen (x : E) : delta p x ∈ R.topologicalClosure := by
    have hx : x ∈ closure (Set.range T) := by
      rw [hT.closure_range]
      trivial
    have hx' : delta p x ∈ closure ((delta p) '' Set.range T) :=
      mem_closure_image (delta p).continuous.continuousAt hx
    have hsub : (delta p) '' Set.range T ⊆ (R : Set (Free p E)) := by
      rintro _ ⟨_, ⟨y, rfl⟩, rfl⟩
      exact ⟨delta p y, (induced_norm_generators p T).2 y⟩
    change delta p x ∈ (R.topologicalClosure : Set (Free p E))
    rw [VectorSublattice.topologicalClosure_coe]
    exact closure_mono hsub hx'
  have hExpr {n : ℕ} (x : Fin n → E) (e : LLexpr n) :
      LLexpr.eval (fun i => delta p (x i)) e ∈ R.topologicalClosure := by
    induction e with
    | zero => exact (R.topologicalClosure).zero_mem
    | var i => exact hgen (x i)
    | add e₁ e₂ h₁ h₂ => exact (R.topologicalClosure).add_mem h₁ h₂
    | smul c e h => exact (R.topologicalClosure).smul_mem c h
    | sup e₁ e₂ h₁ h₂ => exact (R.topologicalClosure).sup_mem h₁ h₂
    | inf e₁ e₂ h₁ h₂ => exact (R.topologicalClosure).inf_mem h₁ h₂
  have hfv (v : FVL E) : ofFVL p v ∈ R.topologicalClosure := by
    obtain ⟨n, x, e, he⟩ := FVLv.exists_eval_of_eq v
    rw [← he, LLexpr.map_eval]
    simpa only [ofFVL_of] using hExpr x e
  have hCtop : R.topologicalClosure = ⊤ := by
    ext y
    constructor
    · intro _
      trivial
    · intro _
      have hy : y ∈ closure (Set.range (ofFVL p (E := E))) := by
        rw [(denseRange_ofFVL p (E := E)).closure_range]
        trivial
      have hsub : Set.range (ofFVL p (E := E)) ⊆
          (R.topologicalClosure : Set (Free p E)) := by
        rintro _ ⟨v, rfl⟩
        exact hfv v
      exact closure_minimal hsub (VectorSublattice.isClosed_topologicalClosure R) hy
  apply denseRange_iff_closure_range.mpr
  change closure (R : Set (Free p E)) = Set.univ
  rw [← VectorSublattice.topologicalClosure_coe, hCtop]
  rfl

/-- Dense induced range detects every functional annihilating the original range. -/
private theorem induced_denseRange_dual_ker (p : Exponent) (T : F →L[ℝ] E)
    (hD : DenseRange (induced p T)) (φ : Dual E) (hφ : φ.comp T = 0) : φ = 0 := by
  have heval : Continuous (fun g : Free p E => g φ) := by
    exact (hpEvaluation p φ).continuous.comp continuous_subtype_val
  have hclosed : IsClosed {g : Free p E | g φ = 0} :=
    isClosed_eq heval continuous_const
  have hsub : Set.range (induced p T) ⊆ {g : Free p E | g φ = 0} := by
    rintro _ ⟨f, rfl⟩
    change f (φ.comp T) = 0
    rw [hφ]
    simpa using f.1.2.1 0 le_rfl (0 : Dual F)
  have hall : ∀ g : Free p E, g φ = 0 := by
    intro g
    have hg : g ∈ closure (Set.range (induced p T)) := by
      rw [hD.closure_range]
      trivial
    exact closure_minimal hsub hclosed hg
  apply ContinuousLinearMap.ext
  intro x
  have hx := hall (delta p x)
  change φ x = 0 at hx
  exact hx

private theorem denseRange_of_dual_ker (T : F →L[ℝ] E)
    (h : ∀ φ : Dual E, φ.comp T = 0 → φ = 0) : DenseRange T := by
  let K := T.range.topologicalClosure
  have hKclosed : IsClosed (K : Set E) := T.range.isClosed_topologicalClosure
  let : IsClosed (K : Set E) := hKclosed
  have hKtop : K = ⊤ := by
    ext x
    constructor
    · intro _
      trivial
    · intro _
      by_contra hx
      let z : E ⧸ K := K.mkQ x
      have hz : z ≠ 0 := by
        simpa [z] using hx
      obtain ⟨ψ, _, hψz⟩ := exists_dual_vector'' ℝ z
      let φ : Dual E := ψ.comp K.mkQL
      have hφT : φ.comp T = 0 := by
        apply ContinuousLinearMap.ext
        intro y
        change ψ (K.mkQ (T y)) = 0
        have hy : T y ∈ K := T.range.le_topologicalClosure ⟨y, rfl⟩
        have hq : K.mkQ (T y) = 0 := (Submodule.Quotient.mk_eq_zero K).2 hy
        rw [hq]
        simp
      have hφ : φ = 0 := h φ hφT
      have hz0 : ‖z‖ = 0 := by
        calc
          ‖z‖ = ψ z := hψz.symm
          _ = φ x := rfl
          _ = 0 := by rw [hφ]; simp
      exact hz (norm_eq_zero.mp hz0)
  apply denseRange_iff_closure_range.mpr
  change closure (T.range : Set E) = Set.univ
  change (K : Set E) = Set.univ
  rw [hKtop]
  rfl

/-- The induced map has dense range exactly when the original operator does. -/
theorem induced_denseRange_iff (p : Exponent) (T : F →L[ℝ] E) :
    DenseRange (induced p T) ↔ DenseRange T := by
  constructor
  · intro hD
    apply denseRange_of_dual_ker T
    intro φ hφ
    exact induced_denseRange_dual_ker p T hD φ hφ
  · exact induced_denseRange_of p T

/-- Surjectivity of the underlying operator lifts through the free lattice quotient. -/
theorem induced_surjective_of [CompleteSpace E] [CompleteSpace F]
    (p : Exponent) (T : F →L[ℝ] E) (hT : Function.Surjective T) :
    Function.Surjective (induced p T) := by
  let J : OrderIdeal (Free p F) :=
    OrderIdeal.ofKerVecLatHom (induced p T).toVecLatHom
  have hJ : IsClosed (J : Set (Free p F)) := by
    change IsClosed ((induced p T).toContinuousLinearMap.ker : Set (Free p F))
    exact (induced p T).toContinuousLinearMap.isClosed_ker
  let : NormedAddCommGroup (Free p F ⧸ J.toSubmodule) := J.quotientNormedAddCommGroup hJ
  let : Lattice (Free p F ⧸ J.toSubmodule) := J.instQuotientLattice
  let : IsOrderedAddMonoid (Free p F ⧸ J.toSubmodule) := J.instQuotientIsOrderedAddMonoid
  let : BanachLattice (Free p F ⧸ J.toSubmodule) := J.quotientBanachLattice hJ
  have hQ : IsPConvex p (Free p F ⧸ J.toSubmodule) :=
    quotient_isPConvex p ⟨1, free_pConvex p⟩ J hJ
  let : IsClosed (T.ker : Set F) := T.isClosed_ker
  let Tq : F ⧸ T.ker →L[ℝ] E := T.ker.liftQL T (le_refl _)
  have hqinj : Tq.ker = ⊥ := by
    change (T.ker.liftQ T.toLinearMap (le_refl _)).ker = ⊥
    exact Submodule.ker_liftQ_eq_bot _ _ _ (le_refl _)
  have hqsurj : Tq.range = ⊤ := by
    change (T.ker.liftQ T.toLinearMap (le_refl _)).range = ⊤
    rw [Submodule.range_liftQ]
    exact LinearMap.range_eq_top.mpr hT
  let TqEquiv : (F ⧸ T.ker) ≃L[ℝ] E :=
    ContinuousLinearEquiv.ofBijective Tq hqinj hqsurj
  let qdelta : F →L[ℝ] (Free p F ⧸ J.toSubmodule) :=
    J.toSubmodule.mkQL.comp (delta p).toContinuousLinearMap
  have hker : T.ker ≤ qdelta.ker := by
    intro x hx
    change J.mkQ (delta p x) = 0
    apply (Submodule.Quotient.mk_eq_zero J.toSubmodule).mpr
    change (induced p T) (delta p x) = 0
    rw [(induced_norm_generators p T).2 x, (show T x = 0 from hx)]
    simp
  let S : E →L[ℝ] (Free p F ⧸ J.toSubmodule) :=
    (T.ker.liftQL qdelta hker).comp TqEquiv.symm.toContinuousLinearMap
  obtain ⟨L, hL, _, _⟩ := universal_property p hQ S
  have hRker : J.toSubmodule ≤ (induced p T).toContinuousLinearMap.ker := le_refl _
  let R : (Free p F ⧸ J.toSubmodule) →L[ℝ] Free p E :=
    J.toSubmodule.liftQL (induced p T).toContinuousLinearMap hRker
  have hR_mk (g : Free p F) : R (J.mkQ g) = induced p T g := by
    rfl
  have hRsup (a b : Free p F ⧸ J.toSubmodule) : R (a ⊔ b) = R a ⊔ R b := by
    obtain ⟨g, rfl⟩ := Submodule.Quotient.mk_surjective J.toSubmodule a
    obtain ⟨h, rfl⟩ := Submodule.Quotient.mk_surjective J.toSubmodule b
    change R (J.mkQ g ⊔ J.mkQ h) = R (J.mkQ g) ⊔ R (J.mkQ h)
    rw [← J.mkQ_sup, hR_mk, hR_mk, hR_mk]
    exact (induced p T).map_sup' g h
  have hRinf (a b : Free p F ⧸ J.toSubmodule) : R (a ⊓ b) = R a ⊓ R b := by
    obtain ⟨g, rfl⟩ := Submodule.Quotient.mk_surjective J.toSubmodule a
    obtain ⟨h, rfl⟩ := Submodule.Quotient.mk_surjective J.toSubmodule b
    change R (J.mkQ g ⊓ J.mkQ h) = R (J.mkQ g) ⊓ R (J.mkQ h)
    rw [← J.mkQ_inf, hR_mk, hR_mk, hR_mk]
    exact (induced p T).map_inf' g h
  let RL : LatticeOperator (Free p E) (Free p E) := {
    toContinuousLinearMap := R.comp L.toContinuousLinearMap
    map_sup' := by
      intro a b
      change R (L (a ⊔ b)) = R (L a) ⊔ R (L b)
      rw [L.map_sup', hRsup]
    map_inf' := by
      intro a b
      change R (L (a ⊓ b)) = R (L a) ⊓ R (L b)
      rw [L.map_inf', hRinf] }
  have hTqmk (x : F) : TqEquiv (Submodule.Quotient.mk x) = T x := by
    rfl
  have hST (x : F) : S (T x) = J.mkQ (delta p x) := by
    change (T.ker.liftQL qdelta hker) (TqEquiv.symm (T x)) = J.mkQ (delta p x)
    rw [← hTqmk x, TqEquiv.symm_apply_apply]
    rfl
  have hRLdelta (x : E) : RL (delta p x) = delta p x := by
    obtain ⟨y, rfl⟩ := hT x
    change R (L (delta p (T y))) = delta p (T y)
    rw [hL (T y), hST y, hR_mk, (induced_norm_generators p T).2 y]
  have hRLid : RL = {
    toContinuousLinearMap := ContinuousLinearMap.id ℝ (Free p E)
    map_sup' := by intros; rfl
    map_inf' := by intros; rfl } := by
    apply latticeOperator_ext_delta p
    exact hRLdelta
  intro f
  obtain ⟨g, hg⟩ := Submodule.Quotient.mk_surjective J.toSubmodule (L f)
  change J.mkQ g = L f at hg
  refine ⟨g, ?_⟩
  have hRLf : R (L f) = f := by
    have h := congrArg (fun A : LatticeOperator (Free p E) (Free p E) => A f) hRLid
    exact h
  calc
    induced p T g = R (J.mkQ g) := (hR_mk g).symm
    _ = R (L f) := by rw [hg]
    _ = f := hRLf


/-- Section 1: faithful behavior on zero, injectivity, dense range and surjectivity. -/
theorem induced_basic_properties [CompleteSpace E] [CompleteSpace F]
    (p : Exponent) (T : F →L[ℝ] E) :
    ((induced p T).toContinuousLinearMap = 0 ↔ T = 0) ∧
    (Function.Injective (induced p T) ↔ Function.Injective T) ∧
    (DenseRange (induced p T) ↔ DenseRange T) ∧
    (Function.Surjective (induced p T) ↔ Function.Surjective T) := by
  exact ⟨induced_eq_zero_iff p T,
    ⟨induced_injective_imp p T, induced_injective_of p T⟩,
    induced_denseRange_iff p T,
    ⟨induced_surjective_imp p T, induced_surjective_of p T⟩⟩

/-- Section 5: canonical inclusions are contractive, injective, have dense range and fix
generators. -/
theorem inclusion_properties {p q : Exponent} (hpq : p ≤ q) :
    ‖(inclusion (E := E) hpq).toContinuousLinearMap‖ ≤ 1 ∧
    Function.Injective (inclusion (E := E) hpq) ∧ DenseRange (inclusion (E := E) hpq) ∧
    ∀ x : E, inclusion hpq (delta p x) = delta q x := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · apply (inclusion (E := E) hpq).toContinuousLinearMap.opNorm_le_bound zero_le_one
    intro f
    change ‖parameterExtension hpq f‖ ≤ 1 * ‖f‖
    simpa only [one_mul] using parameterExtension_norm_le hpq f
  · intro f g h
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    have hφ := congrArg (fun k : Free q E => k φ) h
    simpa only [inclusion_apply] using hφ
  · apply denseRange_iff_closure_range.mpr
    ext z
    constructor
    · intro _; trivial
    · intro _
      have hz : z ∈ closure (Set.range (ofFVL q (E := E))) := by
        rw [(denseRange_ofFVL q (E := E)).closure_range]
        trivial
      apply closure_mono ?_ hz
      rintro _ ⟨v, rfl⟩
      exact ⟨ofFVL p v, parameterExtension_ofFVL hpq v⟩
  · intro x
    rw [← ofFVL_of p x, ← ofFVL_of q x]
    exact parameterExtension_ofFVL hpq (FVLv.of x)

/-- Equation (2.4): the reverse triangle inequality for lattice absolute values and
the identities expressing `a - a ⊓ b` as the positive part of `a - b`. The latter is
nonnegative and bounded by `|a - b|`; these estimates control witness approximations. -/
theorem lattice_inequalities {X : Type w} [AddCommGroup X] [Lattice X]
    [IsOrderedAddMonoid X] (a b : X) :
    |(|a| - |b|)| ≤ |a - b| ∧ 0 ≤ a - a ⊓ b ∧
    a - a ⊓ b = (a - b) ⊔ 0 ∧ (a - b) ⊔ 0 ≤ |a - b| := by
  refine ⟨abs_abs_sub_abs_le a b, ?_, ?_, ?_⟩
  · rw [sub_inf_eq_posPart]
    exact posPart_nonneg _
  · exact sub_inf_eq_posPart a b
  · exact posPart_le_abs _

end FBLOrderContinuousLH

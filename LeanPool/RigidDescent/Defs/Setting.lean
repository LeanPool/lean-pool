module

public import Mathlib.CategoryTheory.Triangulated.Functor
public import Mathlib.CategoryTheory.Monoidal.Rigid.Basic
public import Mathlib.CategoryTheory.Preadditive.Yoneda.Basic

/-!
# The setting: tensor-triangulated and rigidly-compactly generated categories

Paper: §1 (definition of a tensor-triangulated category, and of a rigidly-compactly
generated one, after [BKS19, Hyp. 0.1]) and the Conventions.
We use slightly weaker notions in some places, such as our definition of the monoidal structure.

-/

@[expose] public section

open CategoryTheory Limits MonoidalCategory Opposite

universe v u

namespace RigidDescent

section TensorTriangulated

variable (T : Type u) [Category.{v} T] [Preadditive T] [HasZeroObject T] [HasShift T ℤ]
  [∀ n : ℤ, (shiftFunctor T n).Additive] [Pretriangulated T] [MonoidalCategory T]

/-- A monoidal structure on a pretriangulated category is *exact in each variable*: for every
object `X`, the functors `X ⊗ -` and `- ⊗ X` commute with the shift and send distinguished
triangles to distinguished triangles.

Paper, §1: "a triangulated category `T` with a symmetric monoidal structure `⊗` that is exact
in each variable". No compatibility between the two commutation isomorphisms (the usual sign
axiom) is assumed, since the paper does not use one. -/
class TensorTriangulated where
  /-- The isomorphisms `(X ⊗ Y)⟦n⟧ ≅ X ⊗ Y⟦n⟧`. -/
  commShiftLeft (X : T) : (tensorLeft X).CommShift ℤ
  isTriangulatedLeft (X : T) :
    letI := commShiftLeft X
    (tensorLeft X).IsTriangulated
  /-- The isomorphisms `(Y ⊗ X)⟦n⟧ ≅ Y⟦n⟧ ⊗ X`. -/
  commShiftRight (X : T) : (tensorRight X).CommShift ℤ
  isTriangulatedRight (X : T) :
    letI := commShiftRight X
    (tensorRight X).IsTriangulated

variable {T}

instance [TensorTriangulated T] (X : T) : (tensorLeft X).CommShift ℤ :=
  TensorTriangulated.commShiftLeft X

instance [TensorTriangulated T] (X : T) : (tensorLeft X).IsTriangulated :=
  TensorTriangulated.isTriangulatedLeft X

instance [TensorTriangulated T] (X : T) : (tensorRight X).CommShift ℤ :=
  TensorTriangulated.commShiftRight X

instance [TensorTriangulated T] (X : T) : (tensorRight X).IsTriangulated :=
  TensorTriangulated.isTriangulatedRight X

end TensorTriangulated

section Compact

variable {T : Type u} [Category.{v} T] [Preadditive T]

/-- An object `K` is *compact* if `Hom(K, -)` preserves small coproducts (paper, §1). -/
def IsCompactObj (K : T) : Prop :=
  ∀ J : Type v, PreservesColimitsOfShape (Discrete J) (preadditiveCoyoneda.obj (op K))

variable [MonoidalCategory T]

/-- An object `K` is *dualizable* if it has a (right) dual. As `T` will be symmetric, left and
right duals agree. -/
def IsDualizable (K : T) : Prop :=
  ∃ D : T, Nonempty (ExactPairing K D)

end Compact

section CompactlyGenerated

variable (T : Type u) [Category.{v} T] [Preadditive T] [HasShift T ℤ]

/-- A *compactly generated* category (paper, §1): `T` has small
coproducts and is generated by a set of compact objects. That is, there is a family
`G : ι → T`, `ι : Type v`, of compact objects such that `Hom(G i, X)_* = 0` for every `i`
implies `X = 0`, where `Hom(K, X)_n = Hom(K⟦n⟧, X)`.

The triangulated structure is a separate typeclass. Neeman's theorem and Brown
representability (`RigidDescent/Foundations/`) are proved in this setting. -/
class CompactlyGenerated : Prop where
  hasCoproducts : HasCoproducts.{v} T
  exists_generators : ∃ (ι : Type v) (G : ι → T), (∀ i, IsCompactObj (G i)) ∧
    ∀ X : T, (∀ (i : ι) (n : ℤ) (f : (G i)⟦n⟧ ⟶ X), f = 0) → IsZero X

attribute [instance] CompactlyGenerated.hasCoproducts

end CompactlyGenerated

section Rigid

variable (T : Type u) [Category.{v} T] [Preadditive T] [HasShift T ℤ] [MonoidalCategory T]

/-- A *rigidly-compactly generated* category (paper, §1, after [BKS19, Hyp. 0.1]): a compactly
generated category whose compact objects are exactly its dualizable objects.

The remaining parts of the paper's definition are typeclasses of their own: the
tensor-triangulated structure (`TensorTriangulated T`), symmetry (`SymmetricCategory T`) and
closedness (`MonoidalClosed T`). -/
class RigidlyCompactlyGenerated : Prop extends CompactlyGenerated T where
  isCompactObj_iff_isDualizable (K : T) : IsCompactObj K ↔ IsDualizable K

end Rigid

end RigidDescent

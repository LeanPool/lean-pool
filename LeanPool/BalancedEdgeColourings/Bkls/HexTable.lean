/-- The eighteen-bit witness at the given table index. -/
def wit (idx : Nat) : Nat := (table (idx / 4096) >>> (18 * (idx % 4096))) % 262144
/-- The i-th base-four digit of an encoded colouring. -/
def dig (n i : Nat) : Nat := n / 4 ^ i % 4
/-- Whether a diagonal belongs to the encoded mask. -/
def inD (mask j : Nat) : Bool := (mask >>> j) % 2 == 1
/-- The colour of the third edge incident with vertex i. -/
def qv (mask n w i : Nat) : Nat := if inD mask (i % 3) then dig (w / 4096) (i % 3) else dig n i
/-- Check properness at one vertex of the hexagon. -/
def okVertex (mask n w i : Nat) : Bool :=
  let a := dig w ((i + 5) % 6); let b := dig w i; let c := qv mask n w i
  a != b && a != c && b != c
/-- The sum of the three colours at vertex i. -/
def sumAt (mask n w i : Nat) : Nat := dig w ((i + 5) % 6) + dig w i + qv mask n w i
/-- Check one pendant-colouring instance, or discard an inadmissible instance. -/
def okEntry (mask n : Nat) : Bool :=
  !((List.range 3).all fun i => inD mask i || dig n i != dig n (i + 3)) ||
    (let w := wit (mask * 4096 + n)
     (List.range 6).all (okVertex mask n w) &&
       (List.range 3).all fun i => sumAt mask n w i != sumAt mask n w (i + 3))

private theorem check0 : (List.range 4096).all (okEntry 0) = true := by
  decide +kernel

private theorem check1 : (List.range 4096).all (okEntry 1) = true := by
  decide +kernel

private theorem check2 : (List.range 4096).all (okEntry 2) = true := by
  decide +kernel

private theorem check3 : (List.range 4096).all (okEntry 3) = true := by
  decide +kernel


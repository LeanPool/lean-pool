/-!
# A hexagon with pendant edges (Balister–Kostochka–Li–Schelp 2004, Lemma 5)

`H` is a 6-cycle `v₀ … v₅` (edge `i` joins `v_i` and `v_{i+1}`, indices in `ZMod 6`) with one more
edge at each `v_i`: a pendant edge, or, for opposite pairs `i, i + 3` in `D`, a diagonal. Pendant
colours `p i ∈ Fin 4` with `p i ≠ p (i + 3)` (`i ∉ D`) extend to a proper colouring in which
opposite vertices see different colour sets (`hexagon`).

The paper verified this by computer. Here a table of witnesses (`table`, one entry of 18 bits per
pair `(D, p)`: six hexagon colours and three diagonal colours) is checked by the kernel
(`check`, `decide +kernel`); the colour sets of opposite vertices are compared through the sums of
their three distinct colours.
-/

@[expose] public section

namespace LeanPool.BalancedEdgeColourings.Bkls.Hex

/-- The colour set at `v_i`: hexagon edges `i - 1`, `i`, and the third edge coloured `q i`. -/
def S (h q : ZMod 6 → Fin 4) (i : ZMod 6) : Finset (Fin 4) := {h (i - 1), h i, q i}

/-- Proper at every `v_i`: the three edges at `v_i` have distinct colours. -/
def Proper (h q : ZMod 6 → Fin 4) : Prop :=
  ∀ i, h (i - 1) ≠ h i ∧ h (i - 1) ≠ q i ∧ h i ≠ q i

-- Expand readable hexadecimal fragments into kernel-checked natural-number literals.
local macro "hexadecimal%" pieces:str+ : term => do
  let digits := String.join (pieces.toList.map (fun piece => piece.getString))
  let value := digits.toList.foldl (fun value digit =>
    16 * value + (if digit <= '9' then digit.toNat - 48 else digit.toNat - 87)) 0
  return Lean.Syntax.mkNumLit (toString value)


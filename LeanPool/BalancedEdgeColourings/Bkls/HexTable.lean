private theorem check5 : (List.range 4096).all (okEntry 5) = true := by
  decide +kernel

private theorem check6 : (List.range 4096).all (okEntry 6) = true := by
  decide +kernel

private theorem check7 : (List.range 4096).all (okEntry 7) = true := by
  decide +kernel

/-- The complete kernel-checked certificate. -/
theorem check : (List.range 8).all (fun mask => (List.range 4096).all (okEntry mask)) = true := by
  change ((List.range 4096).all (okEntry 0) &&
    ((List.range 4096).all (okEntry 1) &&
    ((List.range 4096).all (okEntry 2) &&
    ((List.range 4096).all (okEntry 3) &&
    ((List.range 4096).all (okEntry 4) &&
    ((List.range 4096).all (okEntry 5) &&
    ((List.range 4096).all (okEntry 6) &&
    ((List.range 4096).all (okEntry 7) &&
    (true))))))))) = true
  simp only [check0, check1, check2, check3, check4, check5, check6, check7, Bool.and_self]


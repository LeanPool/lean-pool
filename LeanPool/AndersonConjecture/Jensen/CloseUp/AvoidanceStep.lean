/-!
# Close-up: avoidance step

The prime-avoidance step in the general close-up construction.
Given generators {a} union s' with c in their T-span, if no
common prime factor of the elements of s' divides both a and c,
one obtains the required A-extension by applying prime avoidance
(Heitmann, Lemma 4).
-/

@[expose] public section

noncomputable section

open Cardinal Ideal

variable {T : Type*} [CommRing T] [IsLocalRing T] [IsNoetherianRing T] [IsDomain T]

omit [IsLocalRing T] [IsNoetherianRing T] [IsDomain T] in
/-- A chosen lift to `T` of an element of `T ⧸ P`. -/
private def quotientLift (P : Ideal T) (α : T ⧸ P) : T :=
  (Ideal.Quotient.mk_surjective α).choose

omit [IsLocalRing T] [IsNoetherianRing T] [IsDomain T] in
private lemma quotientLift_spec (P : Ideal T) (α : T ⧸ P) :
    Ideal.Quotient.mk P (quotientLift P α) = α :=
  (Ideal.Quotient.mk_surjective α).choose_spec

/-- The primes to avoid: associated primes of nonzero principal ideals generated by elements of
`R` that do not contain `I`, together with `⊥`. -/
private def avoidanceGoodPrimes (R : NSubring T) (I : Ideal T) : Set (Ideal T) :=
  (⋃ (r : R.carrier), ⋃ (_ : (r : T) ≠ 0),
    {P ∈ associatedPrimes T (T ⧸ span {(r : T)}) | ¬(I ≤ P)}) ∪ {⊥}

/-- Absolute transcendence obstacles: `-t` and the roots of nonzero polynomials over `R`,
shifted by `-t`. -/
private def avoidanceBaseObstacles (R : NSubring T) (t : T) : Set T :=
  {-t} ∪ ⋃ (f : Polynomial R.carrier), ⋃ (_ : f ≠ 0),
    (fun x => x - t) '' {x : T | Polynomial.aeval x f = 0}

/-- Modular transcendence obstacles at a prime `P`: lifts of roots of nonzero reductions of
polynomials over `R` modulo `P`, shifted by `-t`. -/
private def avoidanceModFiber (R : NSubring T) (t : T) (P : Ideal T) : Set T :=
  ⋃ (f : Polynomial R.carrier),
    ⋃ (_ : Polynomial.map ((Ideal.Quotient.mk P).comp R.carrier.subtype) f ≠ 0),
      (fun α => quotientLift P α - t) ''
        {α : T ⧸ P | (Polynomial.map ((Ideal.Quotient.mk P).comp R.carrier.subtype) f).IsRoot α}

/-- All the elements `δ` must avoid modulo the good primes. -/
private def avoidanceObstacles (R : NSubring T) (I : Ideal T) (t : T) : Set T :=
  avoidanceBaseObstacles R t ∪ ⋃ P ∈ avoidanceGoodPrimes R I, avoidanceModFiber R t P

private lemma avoidanceGoodPrimes_isPrime {R : NSubring T} {I P : Ideal T}
    (hP : P ∈ avoidanceGoodPrimes R I) : P.IsPrime := by
  unfold avoidanceGoodPrimes at hP
  rcases (Set.mem_union _ _ _).mp hP with h | h
  · rw [Set.mem_iUnion] at h
    obtain ⟨r, h⟩ := h
    rw [Set.mem_iUnion] at h
    obtain ⟨_, hPmem⟩ := h
    exact hPmem.1.isPrime
  · exact Set.mem_singleton_iff.mp h ▸ Ideal.isPrime_bot

private lemma avoidanceGoodPrimes_ne_maximalIdeal {R : NSubring T} {I P : Ideal T}
    (hM_not_assoc : ∀ (r : T), r ≠ 0 →
      IsLocalRing.maximalIdeal T ∉ associatedPrimes T (T ⧸ Ideal.span {r}))
    (hM_ne_bot : IsLocalRing.maximalIdeal T ≠ ⊥)
    (hP : P ∈ avoidanceGoodPrimes R I) : P ≠ IsLocalRing.maximalIdeal T := by
  unfold avoidanceGoodPrimes at hP
  rcases (Set.mem_union _ _ _).mp hP with h | h
  · rw [Set.mem_iUnion] at h
    obtain ⟨r, h⟩ := h
    rw [Set.mem_iUnion] at h
    obtain ⟨hr, hPmem⟩ := h
    exact fun heq => hM_not_assoc (r : T) hr (heq ▸ hPmem.1)
  · rw [Set.mem_singleton_iff.mp h]
    exact fun h => hM_ne_bot h.symm

private lemma avoidanceGoodPrimes_not_le {R : NSubring T} {I P : Ideal T} (hI_bot : I ≠ ⊥)
    (hP : P ∈ avoidanceGoodPrimes R I) : ¬(I ≤ P) := by
  intro hle
  unfold avoidanceGoodPrimes at hP
  rcases (Set.mem_union _ _ _).mp hP with h | h
  · rw [Set.mem_iUnion] at h
    obtain ⟨r, h⟩ := h
    rw [Set.mem_iUnion] at h
    obtain ⟨_, hPmem⟩ := h
    exact hPmem.2 hle
  · rw [Set.mem_singleton_iff.mp h] at hle
    exact hI_bot (le_antisymm hle bot_le)

private lemma avoidance_root_shift_countable (R : NSubring T) (t : T)
    (f : Polynomial R.carrier) (hf : f ≠ 0) :
    ((fun x => x - t) '' {x : T | Polynomial.aeval x f = 0}).Countable := by
  apply Set.Countable.image
  have hmap_ne : Polynomial.map R.carrier.subtype f ≠ 0 := by
    rw [Ne, ← Polynomial.map_zero R.carrier.subtype]
    exact (Polynomial.map_injective R.carrier.subtype
      Subtype.val_injective).ne hf
  have h_eq : {x : T | Polynomial.aeval x f = 0} =
      {x : T | (Polynomial.map R.carrier.subtype f).IsRoot x} := by
    ext x
    simp [Polynomial.IsRoot, Polynomial.aeval_def, Polynomial.eval_map,
      show algebraMap R.carrier T = R.carrier.subtype from rfl]
  rw [h_eq]
  exact (Polynomial.finite_setOfPred_isRoot hmap_ne).countable

/-- When `R` is countable, the good primes and all obstacles are countable. -/
private lemma avoidance_countable_of_countable (R : NSubring T) (I : Ideal T) (t : T)
    (hR_le : Cardinal.mk R.carrier ≤ Cardinal.aleph0) :
    (avoidanceGoodPrimes R I).Countable ∧ (avoidanceObstacles R I t).Countable := by
  have : Countable R.carrier := Cardinal.mk_le_aleph0_iff.mp hR_le
  have : Countable (Polynomial R.carrier) := by
    let : Countable (AddMonoidAlgebra R.carrier ℕ) :=
      Countable.of_equiv _ AddMonoidAlgebra.coeffEquiv.symm
    exact Polynomial.toFinsupp_injective.countable
  have hC_good_countable : (avoidanceGoodPrimes R I).Countable := by
    unfold avoidanceGoodPrimes
    exact Set.Countable.union (Set.countable_iUnion fun r =>
      Set.countable_iUnion fun _ =>
        ((associatedPrimes.finite T (T ⧸ span {(r : T)})).subset
          fun P hP => hP.1).countable) (Set.countable_singleton _)
  have hD_base_countable : (avoidanceBaseObstacles R t).Countable :=
    Set.Countable.union (Set.countable_singleton _)
      (Set.countable_iUnion fun f => Set.countable_iUnion fun hf =>
        avoidance_root_shift_countable R t f hf)
  have hD_mod_countable :
      (⋃ P ∈ avoidanceGoodPrimes R I, avoidanceModFiber R t P).Countable := by
    apply Set.Countable.biUnion hC_good_countable
    intro P hP
    apply Set.countable_iUnion
    intro f
    apply Set.countable_iUnion
    intro hfne
    apply Set.Countable.image
    have : P.IsPrime := avoidanceGoodPrimes_isPrime hP
    have : IsDomain (T ⧸ P) := Ideal.Quotient.isDomain P
    exact (Polynomial.finite_setOfPred_isRoot hfne).countable
  exact ⟨hC_good_countable, Set.Countable.union hD_base_countable hD_mod_countable⟩

private lemma avoidanceGoodPrimes_card_le (R : NSubring T) (I : Ideal T)
    (hR_inf : Cardinal.aleph0 ≤ Cardinal.mk R.carrier) :
    Cardinal.mk (avoidanceGoodPrimes R I) ≤ Cardinal.mk R.carrier := by
  unfold avoidanceGoodPrimes
  calc _ ≤ Cardinal.mk ↑(⋃ (r : R.carrier), ⋃ (_ : (r : T) ≠ 0),
            {P ∈ associatedPrimes T (T ⧸ span {(r : T)}) | ¬(I ≤ P)}) +
          Cardinal.mk ↑({⊥} : Set (Ideal T)) := Cardinal.mk_union_le _ _
    _ ≤ Cardinal.mk R.carrier * Cardinal.aleph0 + Cardinal.mk R.carrier := by
        gcongr
        · exact (Cardinal.mk_iUnion_le _).trans
            (mul_le_mul_right (ciSup_le' fun r => by
            exact Cardinal.mk_le_aleph0_iff.mpr
              ((Set.Finite.subset (associatedPrimes.finite T _)
                (Set.iUnion_subset fun _ => fun P hP => hP.1)).countable.to_subtype)) _)
        · exact (Cardinal.mk_le_one_iff_set_subsingleton.mpr
            Set.subsingleton_singleton).trans (one_le_aleph0.trans hR_inf)
    _ = Cardinal.mk R.carrier := by
        rw [Cardinal.mul_aleph0_eq hR_inf, Cardinal.add_eq_left hR_inf le_rfl]

private lemma avoidanceBaseObstacles_card_le (R : NSubring T) (t : T)
    (hR_inf : Cardinal.aleph0 ≤ Cardinal.mk R.carrier) :
    Cardinal.mk (avoidanceBaseObstacles R t) ≤ Cardinal.mk R.carrier := by
  unfold avoidanceBaseObstacles
  calc _ ≤ Cardinal.mk ↑({-t} : Set T) +
          Cardinal.mk ↑(⋃ (f : Polynomial R.carrier), ⋃ (_ : f ≠ 0),
            (fun x => x - t) '' {x : T | Polynomial.aeval x f = 0}) :=
        Cardinal.mk_union_le _ _
    _ ≤ Cardinal.mk R.carrier + Cardinal.mk R.carrier := by
        gcongr
        · exact (Cardinal.mk_le_one_iff_set_subsingleton.mpr
            Set.subsingleton_singleton).trans (one_le_aleph0.trans hR_inf)
        · exact (Cardinal.mk_iUnion_le _).trans ((mul_le_mul'
            (Polynomial.cardinalMk_le_max.trans (max_le le_rfl hR_inf))
            (ciSup_le' fun f => Cardinal.mk_le_aleph0_iff.mpr (by
              by_cases hf : f = 0
              · exact Set.Countable.to_subtype (by simp [hf])
              · exact (Set.countable_iUnion fun _ =>
                  avoidance_root_shift_countable R t f hf).to_subtype))).trans
            (Cardinal.mul_aleph0_eq hR_inf).le)
    _ = Cardinal.mk R.carrier := Cardinal.add_eq_left hR_inf le_rfl

private lemma avoidanceModFiber_card_le (R : NSubring T) (t : T)
    (hR_inf : Cardinal.aleph0 ≤ Cardinal.mk R.carrier) (P : Ideal T) [P.IsPrime] :
    Cardinal.mk (avoidanceModFiber R t P) ≤ Cardinal.mk R.carrier := by
  unfold avoidanceModFiber
  refine (Cardinal.mk_iUnion_le _).trans ?_
  calc _ ≤ Cardinal.mk R.carrier * Cardinal.aleph0 := by
        gcongr
        · exact Polynomial.cardinalMk_le_max.trans (max_le le_rfl hR_inf)
        · apply ciSup_le'
          intro f
          apply Cardinal.mk_le_aleph0_iff.mpr
          by_cases hfne : Polynomial.map ((Ideal.Quotient.mk P).comp R.carrier.subtype) f = 0
          · exact Set.Countable.to_subtype (by simp [hfne])
          · have : IsDomain (T ⧸ P) := Ideal.Quotient.isDomain P
            apply Set.Countable.to_subtype
            apply Set.Finite.countable
            apply Set.Finite.subset
              (((Polynomial.rootSet_finite
                (Polynomial.map ((Ideal.Quotient.mk P).comp R.carrier.subtype) f)
                (T ⧸ P)).image (quotientLift P)).image (fun x => x - t))
            apply Set.iUnion_subset
            intro _ x hx
            obtain ⟨α, hα, rfl⟩ := hx
            exact ⟨quotientLift P α, ⟨α, Polynomial.mem_rootSet.mpr ⟨hfne, hα⟩, rfl⟩, rfl⟩
    _ = Cardinal.mk R.carrier := Cardinal.mul_aleph0_eq hR_inf

private lemma avoidanceObstacles_card_le (R : NSubring T) (I : Ideal T) (t : T)
    (hR_inf : Cardinal.aleph0 ≤ Cardinal.mk R.carrier) :
    Cardinal.mk (avoidanceObstacles R I t) ≤ Cardinal.mk R.carrier := by
  have hD_mod_le : Cardinal.mk ↑(⋃ P ∈ avoidanceGoodPrimes R I, avoidanceModFiber R t P) ≤
      Cardinal.mk R.carrier := by
    apply (Cardinal.mk_biUnion_le _ _).trans
    refine (mul_le_mul' (avoidanceGoodPrimes_card_le R I hR_inf) (ciSup_le' fun x => ?_)).trans
      (Cardinal.mul_eq_self hR_inf).le
    have : x.1.IsPrime := avoidanceGoodPrimes_isPrime x.2
    exact avoidanceModFiber_card_le R t hR_inf x.1
  unfold avoidanceObstacles
  calc _ ≤ Cardinal.mk (avoidanceBaseObstacles R t) +
          Cardinal.mk ↑(⋃ P ∈ avoidanceGoodPrimes R I, avoidanceModFiber R t P) :=
        Cardinal.mk_union_le _ _
    _ ≤ Cardinal.mk R.carrier + Cardinal.mk R.carrier :=
        add_le_add (avoidanceBaseObstacles_card_le R t hR_inf) hD_mod_le
    _ = Cardinal.mk R.carrier := Cardinal.add_eq_left hR_inf le_rfl

/-- The cardinality hypothesis of `avoidance` for the good primes and obstacles. -/
private lemma avoidance_cardinal_bound (R : NSubring T) (I : Ideal T) (t : T)
    (hR_card : Cardinal.mk R.carrier < Cardinal.mk T)
    (hT_card : Cardinal.mk T = Cardinal.mk (IsLocalRing.ResidueField T)) :
    Cardinal.mk (↑(avoidanceGoodPrimes R I) × ↑(avoidanceObstacles R I t)) <
        Cardinal.mk (IsLocalRing.ResidueField T) ∨
      ((avoidanceGoodPrimes R I).Countable ∧ (avoidanceObstacles R I t).Countable) := by
  by_cases hR_le : Cardinal.mk R.carrier ≤ Cardinal.aleph0
  · exact Or.inr (avoidance_countable_of_countable R I t hR_le)
  · left
    push Not at hR_le
    have hR_inf : Cardinal.aleph0 ≤ Cardinal.mk R.carrier := le_of_lt hR_le
    calc Cardinal.mk (↑(avoidanceGoodPrimes R I) × ↑(avoidanceObstacles R I t))
        = Cardinal.mk (avoidanceGoodPrimes R I) * Cardinal.mk (avoidanceObstacles R I t) :=
          (Cardinal.mul_def _ _).symm
      _ ≤ Cardinal.mk R.carrier * Cardinal.mk R.carrier :=
          mul_le_mul' (avoidanceGoodPrimes_card_le R I hR_inf)
            (avoidanceObstacles_card_le R I t hR_inf)
      _ = Cardinal.mk R.carrier := Cardinal.mul_eq_self hR_inf
      _ < Cardinal.mk T := hR_card
      _ = Cardinal.mk (IsLocalRing.ResidueField T) := hT_card

/-- If no prime of `R` divides every element of `s'`, then the extension of the ideal
generated by `s'` is contained in no associated prime of a nonzero principal ideal. -/
private lemma span_not_le_associatedPrime (R : NSubring T) (s' : Finset R.carrier)
    (hI_bot : Ideal.map R.carrier.subtype (span (↑s' : Set R.carrier)) ≠ ⊥)
    (h_no_common : ∀ (q : R.carrier), Prime q → ¬(∀ x ∈ s', q ∣ x))
    (r : R.carrier) (hr : (r : T) ≠ 0) (P : Ideal T)
    (hP_mem : P ∈ associatedPrimes T (T ⧸ span {(r : T)})) :
    ¬(Ideal.map R.carrier.subtype (span (↑s' : Set R.carrier)) ≤ P) := by
  have : UniqueFactorizationMonoid R.carrier := R.isUFD
  intro hle
  have hht := R.height_bound (r : T) hr P hP_mem
  by_cases hcomap : P.comap R.carrier.subtype = ⊥
  · -- P ∩ R = ⊥: all s' zero, I_s' = ⊥
    exact hI_bot (le_antisymm (by
      apply Ideal.map_le_iff_le_comap.mpr
      apply Ideal.span_le.mpr
      intro x hx
      have h1 : x ∈ P.comap R.carrier.subtype :=
        Ideal.mem_comap.mpr (hle (Ideal.mem_map_of_mem _
          (Ideal.subset_span (Finset.mem_coe.mpr hx))))
      have h1' : x ∈ (⊥ : Ideal R.carrier) := hcomap ▸ h1
      have hx_zero : x = 0 := (Submodule.mem_bot _).mp h1'
      change R.carrier.subtype x ∈ (⊥ : Ideal T)
      rw [hx_zero, map_zero]
      exact (Submodule.mem_bot T).mpr rfl) bot_le)
  · -- P ∩ R ≠ ⊥: find q_P, contradiction from h_no_common
    have : (P.comap R.carrier.subtype).IsPrime := hP_mem.isPrime.comap _
    obtain ⟨q_P, hqP_prime, hqP_in⟩ :=
      exists_prime_mem_of_ne_bot_closeup (P.comap R.carrier.subtype) hcomap
    have hQ_eq : Ideal.span {q_P} = P.comap R.carrier.subtype :=
      @eq_of_prime_le_prime_height_le_one R.carrier _ (NSubring.isDomain R) _ _
        ((Ideal.span_singleton_prime hqP_prime.ne_zero).mpr hqP_prime)
        (hP_mem.isPrime.comap _)
        (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hqP_in))
        (mt (Ideal.span_singleton_eq_bot (α := R.carrier)).mp hqP_prime.ne_zero) hht
    have hqP_dvd_s' : ∀ x ∈ s', q_P ∣ x := fun x hx =>
      (Ideal.mem_span_singleton (α := R.carrier)).mp
        (hQ_eq ▸ Ideal.mem_comap.mpr (hle (Ideal.mem_map_of_mem _
          (Ideal.subset_span (Finset.mem_coe.mpr hx)))))
    exact h_no_common q_P hqP_prime hqP_dvd_s'

open scoped Pointwise in
/-- An element avoiding all obstacles modulo `⊥` makes `t + δ` transcendental over `R`. -/
private lemma avoidance_shift_transcendental (R : NSubring T) (I : Ideal T) (t δ : T)
    (hδ_avoid : ∀ P ∈ avoidanceGoodPrimes R I, ∀ r ∈ avoidanceObstacles R I t,
      δ ∉ (P : Set T) + ({r} : Set T)) :
    Transcendental R.carrier (t + δ) := by
  rw [Transcendental]
  intro ⟨p, hp_ne, hp_eval⟩
  have hδ_in_D : δ ∈ avoidanceObstacles R I t := by
    unfold avoidanceObstacles avoidanceBaseObstacles
    exact Set.mem_union_left _ (Set.mem_union_right _
      (Set.mem_iUnion.mpr ⟨p, Set.mem_iUnion.mpr ⟨hp_ne, ⟨t + δ, hp_eval, by ring⟩⟩⟩))
  have h_absurd : δ ∈ ((⊥ : Ideal T) : Set T) + ({δ} : Set T) := by
    have := Set.add_mem_add (⊥ : Ideal T).zero_mem
      (show δ ∈ ({δ} : Set T) from rfl)
    rwa [zero_add] at this
  have h_bot : (⊥ : Ideal T) ∈ avoidanceGoodPrimes R I := by
    unfold avoidanceGoodPrimes
    exact Set.mem_union_right _ rfl
  exact absurd h_absurd (hδ_avoid ⊥ h_bot δ hδ_in_D)

open scoped Pointwise in
/-- Modular transcendence of `t + δ`: the kernel condition of
`adjoin_transcendental_isNSubring`. -/
private lemma avoidance_shift_mod_transcendental (R : NSubring T) {I : Ideal T} (t δ : T)
    (hI_assoc : ∀ (r : R.carrier), (r : T) ≠ 0 →
      ∀ P ∈ associatedPrimes T (T ⧸ span {(r : T)}), ¬(I ≤ P))
    (hδ_avoid : ∀ P ∈ avoidanceGoodPrimes R I, ∀ r ∈ avoidanceObstacles R I t,
      δ ∉ (P : Set T) + ({r} : Set T))
    (P : Ideal T) (hP_prime : P.IsPrime) (hP_ht : P.height ≤ 1)
    (hPR_ne : P.comap R.carrier.subtype ≠ ⊥) (f : Polynomial R.carrier)
    (hf_in : (Polynomial.aeval (t + δ) f : T) ∈ (P : Set T)) (i : ℕ) :
    f.coeff i ∈ P.comap R.carrier.subtype := by
  by_contra h_neg
  -- f.map (φ P) ≠ 0 (some coefficient doesn't vanish mod P)
  have hf_bar_ne : f.map ((Ideal.Quotient.mk P).comp R.carrier.subtype) ≠ 0 := by
    intro h_eq
    apply h_neg
    have h := congr_arg (fun p => Polynomial.coeff p i) h_eq
    simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h
    exact Ideal.mem_comap.mpr (Ideal.Quotient.eq_zero_iff_mem.mp h)
  -- P is an associated prime of some T/(r₀), hence a good prime
  obtain ⟨r₀, hr₀T_ne, hP_assoc⟩ :=
    prime_height_le_one_mem_assoc P hP_prime hP_ht hPR_ne
  have hP_in_C_good : P ∈ avoidanceGoodPrimes R I := by
    unfold avoidanceGoodPrimes
    exact Set.mem_union_left _ (Set.mem_iUnion.mpr ⟨r₀, Set.mem_iUnion.mpr
      ⟨hr₀T_ne, hP_assoc, hI_assoc r₀ hr₀T_ne P hP_assoc⟩⟩)
  -- mk P (t+δ) is a root of f.map (φ P) in T/P
  have ht_root : (f.map ((Ideal.Quotient.mk P).comp R.carrier.subtype)).IsRoot
      (Ideal.Quotient.mk P (t + δ)) := by
    rw [Polynomial.IsRoot, Polynomial.eval_map,
      ← Polynomial.hom_eval₂ f R.carrier.subtype (Ideal.Quotient.mk P) (t + δ)]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hf_in
  -- liftQ P (mk P (t+δ)) - t is an obstacle
  have hlift_shifted_in_D :
      quotientLift P (Ideal.Quotient.mk P (t + δ)) - t ∈ avoidanceObstacles R I t := by
    unfold avoidanceObstacles avoidanceModFiber
    exact Set.mem_union_right _
      (Set.mem_iUnion.mpr ⟨P, Set.mem_iUnion.mpr
        ⟨hP_in_C_good, Set.mem_iUnion.mpr ⟨f,
          Set.mem_iUnion.mpr ⟨hf_bar_ne,
            ⟨Ideal.Quotient.mk P (t + δ), ht_root, rfl⟩⟩⟩⟩⟩)
  -- δ - (liftQ - t) = (t + δ) - liftQ ∈ P
  have hlift_in_P : δ - (quotientLift P (Ideal.Quotient.mk P (t + δ)) - t) ∈ P := by
    have hmem : (t + δ) - quotientLift P (Ideal.Quotient.mk P (t + δ)) ∈ P := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, quotientLift_spec]
      exact sub_self _
    convert hmem using 1
    ring
  -- δ ∈ P + {liftQ - t}, contradicting avoidance
  exact absurd
    ⟨δ - (quotientLift P (Ideal.Quotient.mk P (t + δ)) - t), hlift_in_P,
      quotientLift P (Ideal.Quotient.mk P (t + δ)) - t, rfl, by ring⟩
    (hδ_avoid P hP_in_C_good
      (quotientLift P (Ideal.Quotient.mk P (t + δ)) - t) hlift_shifted_in_D)

/-- Final step: after adjoining `x` with `c - x a ∈ (s')T`, the induction hypothesis on `s'`
yields the required extension. -/
private lemma close_up_avoidance_step_of_adjoin {m : ℕ}
    (ih : ∀ (R : NSubring T) (_ : Cardinal.mk R.carrier < Cardinal.mk T)
      (s : Finset R.carrier) (_ : s.card ≤ m) (c : R.carrier)
      (_ : (c : T) ∈ Ideal.map R.carrier.subtype (span (↑s : Set R.carrier))),
      ∃ S : NSubring T, IsAExtension R S ∧ ∃ (hle : R.carrier ≤ S.carrier),
        (⟨(c : T), hle c.2⟩ : S.carrier) ∈
          Ideal.map (Subring.inclusion hle) (span (↑s : Set R.carrier)))
    (R : NSubring T) (hR_card : Cardinal.mk R.carrier < Cardinal.mk T)
    (hT_aleph0 : Cardinal.aleph0 < Cardinal.mk T)
    (a : R.carrier) (s' : Finset R.carrier) (hs'_card : s'.card ≤ m) (c : R.carrier)
    (x : T) (S₁ : NSubring T) (hAext₁ : IsAExtension R S₁) (hx_S₁ : x ∈ (S₁.carrier : Set T))
    (hrem_T : ((c : T) - x * (a : T)) ∈
      Ideal.map R.carrier.subtype (span (↑s' : Set R.carrier))) :
    ∃ S : NSubring T, IsAExtension R S ∧ ∃ (hle : R.carrier ≤ S.carrier),
      (⟨(c : T), hle c.2⟩ : S.carrier) ∈
        Ideal.map (Subring.inclusion hle)
          (span (insert (a : R.carrier) (↑s' : Set R.carrier))) := by
  have : DecidableEq R.carrier := Classical.decEq _
  have hle₁ := hAext₁.le
  have hrem_in_S₁ : (c : T) - x * (a : T) ∈ S₁.carrier :=
    S₁.carrier.sub_mem (hle₁ c.2) (S₁.carrier.mul_mem hx_S₁ (hle₁ a.2))
  let rem₁ : S₁.carrier := ⟨(c : T) - x * (a : T), hrem_in_S₁⟩
  have : DecidableEq S₁.carrier := Classical.decEq _
  let liftR₁ := Subring.inclusion hle₁
  let s₁ : Finset S₁.carrier := s'.image liftR₁
  have hs₁_card : s₁.card ≤ m := Finset.card_image_le.trans hs'_card
  have hcomp : S₁.carrier.subtype.comp liftR₁ = R.carrier.subtype :=
    RingHom.ext fun _ => rfl
  have hrem₁_span : (rem₁ : T) ∈
      Ideal.map S₁.carrier.subtype (span (↑s₁ : Set S₁.carrier)) := by
    change (c : T) - x * (a : T) ∈ _
    change _ ∈ Ideal.map S₁.carrier.subtype
      (span (↑(s'.image liftR₁) : Set S₁.carrier))
    rw [Finset.coe_image, ← Ideal.map_span, Ideal.map_map, hcomp]
    exact hrem_T
  have hS₁_card : Cardinal.mk S₁.carrier < Cardinal.mk T :=
    lt_of_le_of_lt hAext₁.card_le (max_lt hT_aleph0 hR_card)
  obtain ⟨S₂, hAext₂, hle₂, hrem₂⟩ :=
    ih S₁ hS₁_card s₁ hs₁_card rem₁ hrem₁_span
  refine ⟨S₂, isAExtension_trans' hAext₁ hAext₂,
    le_trans hle₁ hle₂, ?_⟩
  rw [Ideal.span_insert, Ideal.map_sup]
  refine Submodule.mem_sup.mpr
    ⟨⟨x, hle₂ hx_S₁⟩ * ⟨(a : T), (le_trans hle₁ hle₂) a.2⟩, ?_,
     ⟨(c : T) - x * (a : T), hle₂ hrem_in_S₁⟩, ?_, ?_⟩
  · rw [Ideal.map_span, Set.image_singleton]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
  · have hcomp₂ : (Subring.inclusion hle₂).comp liftR₁ =
        Subring.inclusion (le_trans hle₁ hle₂) :=
      RingHom.ext fun _ => rfl
    change ⟨(rem₁ : T), hle₂ rem₁.2⟩ ∈
      Ideal.map (Subring.inclusion hle₂)
        (span (↑(s'.image liftR₁) : Set S₁.carrier)) at hrem₂
    rw [Finset.coe_image, ← Ideal.map_span, Ideal.map_map, hcomp₂] at hrem₂
    exact hrem₂
  · exact Subtype.ext (by
      simp only [Subring.coe_add, Subring.coe_mul]
      ring)

lemma close_up_avoidance_step
    [IsAdicComplete (IsLocalRing.maximalIdeal T) T]
    (hM_not_assoc : ∀ (r : T), r ≠ 0 →
      IsLocalRing.maximalIdeal T ∉ associatedPrimes T (T ⧸ Ideal.span {r}))
    (hAss_ht : ∀ (r : T), r ≠ 0 →
      ∀ P ∈ associatedPrimes T (T ⧸ Ideal.span {r}), P.height ≤ 1)
    {m : ℕ}
    (ih : ∀ (R : NSubring T) (_ : Cardinal.mk R.carrier < Cardinal.mk T)
      (s : Finset R.carrier) (_ : s.card ≤ m) (c : R.carrier)
      (_ : (c : T) ∈ Ideal.map R.carrier.subtype (span (↑s : Set R.carrier))),
      ∃ S : NSubring T, IsAExtension R S ∧ ∃ (hle : R.carrier ≤ S.carrier),
        (⟨(c : T), hle c.2⟩ : S.carrier) ∈
          Ideal.map (Subring.inclusion hle) (span (↑s : Set R.carrier)))
    (R : NSubring T) (hR_card : Cardinal.mk R.carrier < Cardinal.mk T)
    (hT_card : Cardinal.mk T = Cardinal.mk (IsLocalRing.ResidueField T))
    (hT_aleph0 : Cardinal.aleph0 < Cardinal.mk T)
    (a : R.carrier) (s' : Finset R.carrier) (hs'_card : s'.card ≤ m)
    (c : R.carrier)
    (hc : (c : T) ∈ Ideal.map R.carrier.subtype
      (span (insert (a : R.carrier) (↑s' : Set R.carrier))))
    (h_no_common : ∀ (q : R.carrier), Prime q → ¬(∀ x ∈ s', q ∣ x)) :
    ∃ S : NSubring T, IsAExtension R S ∧ ∃ (hle : R.carrier ≤ S.carrier),
      (⟨(c : T), hle c.2⟩ : S.carrier) ∈
        Ideal.map (Subring.inclusion hle)
          (span (insert (a : R.carrier) (↑s' : Set R.carrier))) := by
  have : DecidableEq R.carrier := Classical.decEq _
  have : IsDomain R.carrier := NSubring.isDomain R
  have : UniqueFactorizationMonoid R.carrier := R.isUFD
  rw [Ideal.span_insert, Ideal.map_sup] at hc
  obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.mp hc
  rw [Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton] at hu
  obtain ⟨t, ht_eq⟩ := hu
  by_cases ha_zero : (a : T) = 0
  · have hu_zero : u = 0 := by
      rw [ht_eq]
      change (a : T) * t = 0
      rw [ha_zero, zero_mul]
    have hc_s' : (c : T) ∈ Ideal.map R.carrier.subtype (span (↑s' : Set R.carrier)) := by
      rw [← huv, hu_zero, zero_add]
      exact hv
    obtain ⟨S, hAext, hle, hmem⟩ := ih R hR_card s' hs'_card c hc_s'
    exact ⟨S, hAext, hle, Ideal.map_mono (Ideal.span_mono
      (Set.subset_insert a ↑s')) hmem⟩
  · -- a ≠ 0
    by_cases hI_bot : Ideal.map R.carrier.subtype (span (↑s' : Set R.carrier)) = ⊥
    · have hv_zero : v = 0 := (Submodule.mem_bot T).mp (hI_bot ▸ hv)
      have hc_aT : (c : T) ∈ span {(a : T)} := by
        rw [← huv, hv_zero, add_zero, ht_eq]
        exact Ideal.mem_span_singleton.mpr ⟨t, rfl⟩
      refine ⟨R, ⟨le_refl _, fun r hr => hr, le_max_right _ _⟩, le_refl _, ?_⟩
      have h_id : Subring.inclusion (le_refl R.carrier) =
          RingHom.id R.carrier := RingHom.ext fun x => Subtype.ext rfl
      have hcR := close_up_dvd R a c hc_aT
      change (⟨(c : T), _⟩ : R.carrier) ∈
        Ideal.map (Subring.inclusion (le_refl R.carrier))
          (span (insert (a : R.carrier) (↑s' : Set R.carrier)))
      rw [h_id, Ideal.map_id]
      exact Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert a _)) hcR
    · -- I_s' ≠ 0
      by_cases hM_bot : IsLocalRing.maximalIdeal T = ⊥
      · -- M = 0: T is a field, a is a unit
        refine ⟨R, ⟨le_refl _, fun r hr => hr, le_max_right _ _⟩, le_refl _, ?_⟩
        have h_id : Subring.inclusion (le_refl R.carrier) =
            RingHom.id R.carrier := RingHom.ext fun x => Subtype.ext rfl
        change (⟨(c : T), _⟩ : R.carrier) ∈
          Ideal.map (Subring.inclusion (le_refl R.carrier))
            (span (insert (a : R.carrier) (↑s' : Set R.carrier)))
        rw [h_id, Ideal.map_id]
        have ha_unit : IsUnit a := by
          by_contra h
          have hmem := (IsLocalRing.mem_maximalIdeal _).mpr h
          rw [R.maximal_ideal_eq, Ideal.mem_comap, hM_bot, Submodule.mem_bot] at hmem
          exact ha_zero hmem
        rw [Ideal.eq_top_of_isUnit_mem _
          (Ideal.subset_span (Set.mem_insert a _)) ha_unit]
        exact Submodule.mem_top
      · -- M ≠ ⊥: main avoidance argument
        set I_s' := Ideal.map R.carrier.subtype (span (↑s' : Set R.carrier))
        -- Apply unified avoidance (handles both countable and uncountable R)
        obtain ⟨δ, hδ_mem, hδ_avoid⟩ :=
          avoidance (fun P hP => avoidanceGoodPrimes_isPrime hP)
            (fun P hP => avoidanceGoodPrimes_ne_maximalIdeal hM_not_assoc hM_bot hP)
            (avoidance_cardinal_bound R I_s' t hR_card hT_card)
            (fun P hP => avoidanceGoodPrimes_not_le hI_bot hP)
        -- t' = t + δ satisfies transcendence and the remainder condition
        have hrem_T : ((c : T) - (t + δ) * (a : T)) ∈ I_s' := by
          suffices hrw : (↑c : T) - (t + δ) * (↑a : T) = v - δ * (↑a : T) by
            rw [hrw]
            exact Submodule.sub_mem _ hv (Ideal.mul_mem_right _ _ hδ_mem)
          have h_c_eq : (↑c : T) = (↑a : T) * t + v := by
            rw [← huv, ht_eq]
            simp
          rw [h_c_eq]
          ring
        -- Adjoin t+δ to R → S₁
        obtain ⟨S₁, hAext₁, ht'_S₁⟩ :=
          adjoin_transcendental_isNSubring R (t + δ)
            (avoidance_shift_transcendental R I_s' t δ hδ_avoid) hAss_ht
            (avoidance_shift_mod_transcendental R t δ
              (span_not_le_associatedPrime R s' hI_bot h_no_common) hδ_avoid)
        exact close_up_avoidance_step_of_adjoin ih R hR_card hT_aleph0 a s' hs'_card c
          (t + δ) S₁ hAext₁ ht'_S₁ hrem_T
end

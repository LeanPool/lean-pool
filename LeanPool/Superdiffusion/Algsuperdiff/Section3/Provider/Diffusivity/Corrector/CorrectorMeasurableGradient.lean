/-! ## Scalar corollaries -/

/-- Unconditional: a coordinate set integral of a gradient class over a
measurable subset of the cube is a continuous, hence measurable, functional. -/
theorem measurable_setIntegral_gradCoordL2 (Q : TriadicCube d) {Omega : Type*}
    {mOmega : MeasurableSpace Omega} {S : Set (Vec d)} (hS : MeasurableSet S) (i : Fin d)
    {F : Omega → HilbertVectorL2 (openCubeSet Q)} (hF : Measurable F) :
    Measurable fun omega =>
      ∫ x in S, (F omega) x i ∂(volumeMeasureOn (openCubeSet Q)) := by
  have : IsFiniteMeasure (volumeMeasureOn (openCubeSet Q)) :=
    isFiniteMeasure_volumeMeasureOn_openCubeSet Q
  have hEq : (fun omega =>
      ∫ x in S, (F omega) x i ∂(volumeMeasureOn (openCubeSet Q))) =
      (hilbertVectorL2CoordSetIntegralCLM (U := openCubeSet Q) S hS i) ∘ F := by
    funext omega
    exact (hilbertVectorL2CoordSetIntegralCLM_apply (U := openCubeSet Q) S hS i (F omega)).symm
  rw [hEq]
  exact (hilbertVectorL2CoordSetIntegralCLM (U := openCubeSet Q) S hS i).continuous.measurable.comp
    hF

end

end Algsuperdiff.Section3.Provider.Diffusivity.Corrector

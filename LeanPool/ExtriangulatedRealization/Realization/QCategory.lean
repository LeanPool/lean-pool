module

public import LeanPool.ExtriangulatedRealization.Intervals.Homs

/-!
# An enlarged version of the additive category `Q` in Proposition 2.3

Given a vector space `W` with maps `q_i : W → D_i` (`i ∈ J`), let `K_i ⊆ W` be the intersection of
the kernels `ker q_j` over `j ∈ J` with `j ≤ i` (for `i ∈ J` this is `ker q_i` when the `q_i` are
compatible). The functor `Φ_W` on the interval category sends `Y ↦ W`, `P i ↦ K_i` and
`A i ↦ 0`; a morphism between `Y`, `P`-intervals acts by its value at `*` times the inclusion.
In Step 2 of Proposition 2.3, the paper adjoins `L` to the category generated by `Y` and
`P i` for `i ∈ J`. Here `Q` is the additive envelope of the one-point extension of the
entire interval category by `Φ_W`, so it also includes `A i` and `P i` outside `J`.
It has `Q(L, Y) = W` and `Q(L, P i) = K_i`. Every morphism from an interval to `L` is zero.
-/

@[expose] public section

namespace ExtriangulatedRealization

open CategoryTheory Limits Opposite Statement IntervalLabel

universe u

variable {k : Type u} [Field k] {I : Type u} [LinearOrder I] {D : Iᵒᵖ ⥤ ModuleCat.{u} k}

/-- The object `Y` of the interval category. -/
abbrev IntervalCat.objY : IntervalCat k I := IntervalLabel.Y

/-- The object `A i` of the interval category. -/
abbrev IntervalCat.objA (i : I) : IntervalCat k I := IntervalLabel.A i

/-- The object `P i` of the interval category. -/
abbrev IntervalCat.objP (i : I) : IntervalCat k I := IntervalLabel.P i

/-- The data of Proposition 2.3: a vector space with maps to the `D_i`, `i ∈ J`. -/
structure RealizationData (D : Iᵒᵖ ⥤ ModuleCat.{u} k) (J : Set I) where
  /-- The vector space `W`. -/
  W : ModuleCat.{u} k
  /-- The maps `q_i : W → D_i`. -/
  q : ∀ i ∈ J, W ⟶ D.obj (op i)

namespace RealizationData

variable {J : Set I} (R : RealizationData D J)

/-- `K_i = ⋂_{j ∈ J, j ≤ i} ker q_j`. -/
def K (i : I) : Submodule k R.W :=
  ⨅ (j : I) (hj : j ∈ J) (_ : j ≤ i), LinearMap.ker (R.q j hj).hom

lemma K_anti {i j : I} (h : i ≤ j) : R.K j ≤ R.K i := by
  simp only [K, le_iInf_iff]
  intro l hl hli
  exact iInf_le_of_le l (iInf_le_of_le hl (iInf_le_of_le (hli.trans h) le_rfl))

/-- `Φ_W` on objects. -/
def phiObj : IntervalCat k I → ModuleCat.{u} k
  | Y => R.W
  | A _ => ModuleCat.of k PUnit
  | P i => ModuleCat.of k (R.K i)

/-- `Φ_W` on morphisms. -/
noncomputable def phiMap : ∀ {l l' : IntervalCat k I}, (l ⟶ l') → (R.phiObj l ⟶ R.phiObj l')
  | P j, P i, φ => if h : i ≤ j then
      coeffBot (show HasBot (P i) from trivial) φ.hom •
        ModuleCat.ofHom (Submodule.inclusion (R.K_anti h))
      else 0
  | P j, Y, φ => coeffBot (show HasBot Y from trivial) φ.hom •
      ModuleCat.ofHom (R.K j).subtype
  | Y, Y, φ => coeffBot (show HasBot Y from trivial) φ.hom • 𝟙 R.W
  | Y, P _, _ => 0
  | Y, A _, _ => 0
  | A _, _, _ => 0
  | P _, A _, _ => 0

lemma coeffBot_Y_P (i : I) (φ : (Y (I := I)).rep k ⟶ (P i).rep k) :
    coeffBot (show HasBot (P i) from trivial) φ = 0 :=
  coeffBot_eq_zero_of_P i (IntervalLabel.coe_not_mem_Y i) φ

lemma coeffBot_P_P {i j : I} (h : ¬ i ≤ j) (φ : (P j).rep k ⟶ (P i).rep k) :
    coeffBot (show HasBot (P i) from trivial) φ = 0 :=
  coeffBot_eq_zero_of_P (l := P j) i (fun hm => h (IntervalLabel.coe_mem_P.mp hm)) φ

lemma phiMap_comp_YYY (φ : (IntervalCat.objY (k := k) (I := I)) ⟶
      (IntervalCat.objY (k := k) (I := I)))
    (ψ : (IntervalCat.objY (k := k) (I := I)) ⟶ (IntervalCat.objY (k := k) (I := I))) :
    R.phiMap (φ ≫ ψ) = R.phiMap φ ≫ R.phiMap ψ := by
    change coeffBot _ (φ.hom ≫ ψ.hom) • 𝟙 R.W =
      (coeffBot _ φ.hom • 𝟙 R.W) ≫ (coeffBot _ ψ.hom • 𝟙 R.W)
    rw [coeffBot_comp (show HasBot Y from trivial)
      (show HasBot Y from trivial), Linear.smul_comp, Linear.comp_smul, smul_smul,
      Category.id_comp, mul_comm]

lemma phiMap_comp_YYP {h : I} (φ : (IntervalCat.objY (k := k) (I := I)) ⟶
      (IntervalCat.objY (k := k) (I := I)))
    (ψ : (IntervalCat.objY (k := k) (I := I)) ⟶ (IntervalCat.objP (k := k) h)) :
    R.phiMap (φ ≫ ψ) = R.phiMap φ ≫ R.phiMap ψ := by
    exact comp_zero.symm

lemma phiMap_comp_YAY {i : I} (φ : (IntervalCat.objY (k := k) (I := I)) ⟶
      (IntervalCat.objA (k := k) i))
    (ψ : (IntervalCat.objA (k := k) i) ⟶ (IntervalCat.objY (k := k) (I := I))) :
    R.phiMap (φ ≫ ψ) = R.phiMap φ ≫ R.phiMap ψ := by
    change coeffBot _ (φ.hom ≫ ψ.hom) • 𝟙 R.W = (0 : R.W ⟶ ModuleCat.of k PUnit) ≫ _
    rw [coeffBot_comp_of_A (show HasBot Y from trivial),
      zero_smul]
    exact zero_comp.symm

lemma phiMap_comp_YAP {i h : I} (φ : (IntervalCat.objY (k := k) (I := I)) ⟶
      (IntervalCat.objA (k := k) i))
    (ψ : (IntervalCat.objA (k := k) i) ⟶ (IntervalCat.objP (k := k) h)) :
    R.phiMap (φ ≫ ψ) = R.phiMap φ ≫ R.phiMap ψ := by
    exact zero_comp.symm

lemma phiMap_comp_YPY {i : I} (φ : (IntervalCat.objY (k := k) (I := I)) ⟶
      (IntervalCat.objP (k := k) i))
    (ψ : (IntervalCat.objP (k := k) i) ⟶ (IntervalCat.objY (k := k) (I := I))) :
    R.phiMap (φ ≫ ψ) = R.phiMap φ ≫ R.phiMap ψ := by
    change coeffBot _ (φ.hom ≫ ψ.hom) • 𝟙 R.W = (0 : R.W ⟶ ModuleCat.of k (R.K i)) ≫ _
    rw [coeffBot_comp (show HasBot (P i) from trivial)
      (show HasBot Y from trivial), coeffBot_Y_P, zero_mul, zero_smul]
    exact zero_comp.symm

lemma phiMap_comp_YPP {i h : I} (φ : (IntervalCat.objY (k := k) (I := I)) ⟶
      (IntervalCat.objP (k := k) i))
    (ψ : (IntervalCat.objP (k := k) i) ⟶ (IntervalCat.objP (k := k) h)) :
    R.phiMap (φ ≫ ψ) = R.phiMap φ ≫ R.phiMap ψ := by
    exact zero_comp.symm

lemma phiMap_comp_PYY {j : I} (φ : (IntervalCat.objP (k := k) j) ⟶
      (IntervalCat.objY (k := k) (I := I)))
    (ψ : (IntervalCat.objY (k := k) (I := I)) ⟶ (IntervalCat.objY (k := k) (I := I))) :
    R.phiMap (φ ≫ ψ) = R.phiMap φ ≫ R.phiMap ψ := by
    change coeffBot _ (φ.hom ≫ ψ.hom) • ModuleCat.ofHom (R.K j).subtype =
      (coeffBot _ φ.hom • ModuleCat.ofHom (R.K j).subtype) ≫ (coeffBot _ ψ.hom • 𝟙 R.W)
    rw [coeffBot_comp (show HasBot Y from trivial)
      (show HasBot Y from trivial), Linear.smul_comp, Linear.comp_smul, smul_smul,
      Category.comp_id, mul_comm]

lemma phiMap_comp_PYP {j h : I} (φ : (IntervalCat.objP (k := k) j) ⟶
      (IntervalCat.objY (k := k) (I := I)))
    (ψ : (IntervalCat.objY (k := k) (I := I)) ⟶ (IntervalCat.objP (k := k) h)) :
    R.phiMap (φ ≫ ψ) = R.phiMap φ ≫ R.phiMap ψ := by
    change (if hhj : h ≤ j then coeffBot _ (φ.hom ≫ ψ.hom) •
        ModuleCat.ofHom (Submodule.inclusion (R.K_anti hhj)) else 0) =
      _ ≫ (0 : R.W ⟶ ModuleCat.of k (R.K h))
    rw [coeffBot_comp (show HasBot Y from trivial)
      (show HasBot (P h) from trivial), coeffBot_Y_P, mul_zero]
    simp only [zero_smul, dite_eq_ite, ite_self]
    exact comp_zero.symm

lemma phiMap_comp_PAY {j i : I} (φ : (IntervalCat.objP (k := k) j) ⟶ (IntervalCat.objA (k := k) i))
    (ψ : (IntervalCat.objA (k := k) i) ⟶ (IntervalCat.objY (k := k) (I := I))) :
    R.phiMap (φ ≫ ψ) = R.phiMap φ ≫ R.phiMap ψ := by
    change coeffBot _ (φ.hom ≫ ψ.hom) • ModuleCat.ofHom (R.K j).subtype =
      (0 : ModuleCat.of k (R.K j) ⟶ ModuleCat.of k PUnit) ≫ _
    rw [coeffBot_comp_of_A (show HasBot Y from trivial),
      zero_smul]
    exact zero_comp.symm

lemma phiMap_comp_PAP {j i h : I} (φ : (IntervalCat.objP (k := k) j) ⟶
      (IntervalCat.objA (k := k) i))
    (ψ : (IntervalCat.objA (k := k) i) ⟶ (IntervalCat.objP (k := k) h)) :
    R.phiMap (φ ≫ ψ) = R.phiMap φ ≫ R.phiMap ψ := by
    change (if hhj : h ≤ j then coeffBot _ (φ.hom ≫ ψ.hom) •
        ModuleCat.ofHom (Submodule.inclusion (R.K_anti hhj)) else 0) =
      (0 : ModuleCat.of k (R.K j) ⟶ ModuleCat.of k PUnit) ≫ _
    rw [coeffBot_comp_of_A (show HasBot (P h) from trivial)]
    simp only [zero_smul, dite_eq_ite, ite_self]
    exact zero_comp.symm

private lemma ofHom_inclusion_comp {V : Type u} [AddCommGroup V] [Module k V]
    {U V' W : Submodule k V} (hUV : U ≤ V') (hVW : V' ≤ W) :
    ModuleCat.ofHom (Submodule.inclusion hUV) ≫ ModuleCat.ofHom (Submodule.inclusion hVW) =
      ModuleCat.ofHom (Submodule.inclusion (hUV.trans hVW)) := rfl

lemma phiMap_comp_PPY {j i : I} (φ : (IntervalCat.objP (k := k) j) ⟶ (IntervalCat.objP (k := k) i))
    (ψ : (IntervalCat.objP (k := k) i) ⟶ (IntervalCat.objY (k := k) (I := I))) :
    R.phiMap (φ ≫ ψ) = R.phiMap φ ≫ R.phiMap ψ := by
    change coeffBot _ (φ.hom ≫ ψ.hom) • ModuleCat.ofHom (R.K j).subtype =
      (if hij : i ≤ j then coeffBot _ φ.hom •
        ModuleCat.ofHom (Submodule.inclusion (R.K_anti hij)) else 0) ≫
      (coeffBot _ ψ.hom • ModuleCat.ofHom (R.K i).subtype)
    rw [coeffBot_comp (show HasBot (P i) from trivial)
      (show HasBot Y from trivial)]
    by_cases hij : i ≤ j
    · have hc : ModuleCat.ofHom (Submodule.inclusion (R.K_anti hij)) ≫
          ModuleCat.ofHom (R.K i).subtype = ModuleCat.ofHom (R.K j).subtype :=
        (ModuleCat.ofHom_comp _ _).symm.trans
          (congrArg ModuleCat.ofHom (Submodule.subtype_comp_inclusion _ _ (R.K_anti hij)))
      rw [dite_eq_left hij, Linear.smul_comp, Linear.comp_smul, smul_smul, mul_comm, hc]
    · rw [dite_eq_right hij, zero_comp, coeffBot_P_P hij, zero_mul, zero_smul]

lemma phiMap_comp_PPP {j i h : I} (φ : (IntervalCat.objP (k := k) j) ⟶
      (IntervalCat.objP (k := k) i))
    (ψ : (IntervalCat.objP (k := k) i) ⟶ (IntervalCat.objP (k := k) h)) :
    R.phiMap (φ ≫ ψ) = R.phiMap φ ≫ R.phiMap ψ := by
    change (if hhj : h ≤ j then coeffBot _ (φ.hom ≫ ψ.hom) •
        ModuleCat.ofHom (Submodule.inclusion (R.K_anti hhj)) else 0) =
      (if hij : i ≤ j then coeffBot _ φ.hom •
        ModuleCat.ofHom (Submodule.inclusion (R.K_anti hij)) else 0) ≫
      (if hhi : h ≤ i then coeffBot _ ψ.hom •
        ModuleCat.ofHom (Submodule.inclusion (R.K_anti hhi)) else 0)
    rw [coeffBot_comp (show HasBot (P i) from trivial)
      (show HasBot (P h) from trivial)]
    by_cases hij : i ≤ j
    · by_cases hhi : h ≤ i
      · have hc : ModuleCat.ofHom (Submodule.inclusion (R.K_anti hij)) ≫
            ModuleCat.ofHom (Submodule.inclusion (R.K_anti hhi)) =
            ModuleCat.ofHom (Submodule.inclusion (R.K_anti (hhi.trans hij))) :=
          ofHom_inclusion_comp (R.K_anti hij) (R.K_anti hhi)
        rw [dite_eq_left (hhi.trans hij), dite_eq_left hij, dite_eq_left hhi, Linear.smul_comp,
          Linear.comp_smul, smul_smul, mul_comm, hc]
      · rw [dite_eq_right hhi, comp_zero, coeffBot_P_P hhi, mul_zero]
        simp only [zero_smul, dite_eq_ite, ite_self]
    · rw [dite_eq_right hij, zero_comp, coeffBot_P_P hij, zero_mul]
      simp only [zero_smul, dite_eq_ite, ite_self]


/-- The functor `Φ_W` on the interval category. -/
noncomputable def phi : IntervalCat k I ⥤ ModuleCat.{u} k where
  obj := R.phiObj
  map := R.phiMap
  map_id l := by
    rcases l with _ | i | i
    · change coeffBot _ (𝟙 _) • 𝟙 R.W = 𝟙 R.W
      rw [coeffBot_id, one_smul]
    · exact psi_hom_ext_of_source_punit _ _
    · change (if h : i ≤ i then coeffBot _ (𝟙 _) •
        ModuleCat.ofHom (Submodule.inclusion (R.K_anti h)) else 0) = 𝟙 _
      rw [dite_eq_left le_rfl, coeffBot_id, one_smul]
      rfl
  map_comp {l l' l''} φ ψ := by
    rcases l with _ | j | j <;> rcases l' with _ | i | i <;> rcases l'' with _ | h | h
    case Y.Y.Y => exact phiMap_comp_YYY R φ ψ
    case Y.Y.P => exact phiMap_comp_YYP R φ ψ
    case Y.A.Y => exact phiMap_comp_YAY R φ ψ
    case Y.A.P => exact phiMap_comp_YAP R φ ψ
    case Y.P.Y => exact phiMap_comp_YPY R φ ψ
    case Y.P.P => exact phiMap_comp_YPP R φ ψ
    case P.Y.Y => exact phiMap_comp_PYY R φ ψ
    case P.Y.P => exact phiMap_comp_PYP R φ ψ
    case P.A.Y => exact phiMap_comp_PAY R φ ψ
    case P.A.P => exact phiMap_comp_PAP R φ ψ
    case P.P.Y => exact phiMap_comp_PPY R φ ψ
    case P.P.P => exact phiMap_comp_PPP R φ ψ
    all_goals first
      | exact psi_hom_ext_of_source_punit _ _
      | exact psi_hom_ext_of_target_punit _ _

instance phi_additive : R.phi.Additive where
  map_add {l l'} φ ψ := by
    rcases l with _ | j | j
    · rcases l' with _ | i | i
      · change coeffBot _ (φ.hom + ψ.hom) • 𝟙 R.W =
          coeffBot _ φ.hom • 𝟙 R.W + coeffBot _ ψ.hom • 𝟙 R.W
        rw [coeffBot_add, add_smul]
      · exact psi_hom_ext_of_target_punit _ _
      · exact (add_zero (0 : R.W ⟶ ModuleCat.of k (R.K i))).symm
    · exact psi_hom_ext_of_source_punit _ _
    · rcases l' with _ | i | i
      · change coeffBot _ (φ.hom + ψ.hom) • ModuleCat.ofHom (R.K j).subtype =
          coeffBot _ φ.hom • ModuleCat.ofHom (R.K j).subtype +
            coeffBot _ ψ.hom • ModuleCat.ofHom (R.K j).subtype
        rw [coeffBot_add, add_smul]
      · exact psi_hom_ext_of_target_punit _ _
      · change (if hij : i ≤ j then coeffBot _ (φ.hom + ψ.hom) •
          ModuleCat.ofHom (Submodule.inclusion (R.K_anti hij)) else 0) =
          (if hij : i ≤ j then coeffBot _ φ.hom •
            ModuleCat.ofHom (Submodule.inclusion (R.K_anti hij)) else 0) +
          (if hij : i ≤ j then coeffBot _ ψ.hom •
            ModuleCat.ofHom (Submodule.inclusion (R.K_anti hij)) else 0)
        split_ifs
        · rw [coeffBot_add, add_smul]
        · rw [add_zero]

instance phi_linear : R.phi.Linear k where
  map_smul {l l'} φ r := by
    rcases l with _ | j | j
    · rcases l' with _ | i | i
      · change coeffBot _ (r • φ.hom) • 𝟙 R.W = r • (coeffBot _ φ.hom • 𝟙 R.W)
        rw [coeffBot_smul, smul_smul]
      · exact psi_hom_ext_of_target_punit _ _
      · exact (smul_zero (A := R.W ⟶ ModuleCat.of k (R.K i)) r).symm
    · exact psi_hom_ext_of_source_punit _ _
    · rcases l' with _ | i | i
      · change coeffBot _ (r • φ.hom) • ModuleCat.ofHom (R.K j).subtype =
          r • (coeffBot _ φ.hom • ModuleCat.ofHom (R.K j).subtype)
        rw [coeffBot_smul, smul_smul]
      · exact psi_hom_ext_of_target_punit _ _
      · change (if hij : i ≤ j then coeffBot _ (r • φ.hom) •
          ModuleCat.ofHom (Submodule.inclusion (R.K_anti hij)) else 0) =
          r • (if hij : i ≤ j then coeffBot _ φ.hom •
            ModuleCat.ofHom (Submodule.inclusion (R.K_anti hij)) else 0)
        split_ifs
        · rw [coeffBot_smul, smul_smul]
        · rw [smul_zero]

/-- The base of `Q`: the one-point extension of the interval category by `Φ_W`. -/
abbrev QInd := OnePointExtension (IntervalCat k I) R.phi

/-- The additive envelope of the one-point extension of the entire interval category. -/
abbrev Q := Mat_ R.QInd

end RealizationData

end ExtriangulatedRealization

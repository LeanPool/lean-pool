module

public import LeanPool.ExtriangulatedRealization.Intervals.Good
public import Mathlib.LinearAlgebra.Dual.Lemmas

/-!
# Splitting off an interval summand

A vector `v ∈ M(a)` whose images vanish outside an interval `U` with least point `a` gives a
morphism `k_U ⟶ M`; a functional on `M(d)`, for the largest point `d` of `U`, gives a morphism
`M ⟶ k_U` provided `M` has no structure maps entering `U` from outside. When the functional is
`1` on the image of `v` at `d`, the interval `k_U` is a direct summand of `M`.
-/

@[expose] public section

namespace ExtriangulatedRealization

open CategoryTheory Limits Opposite Statement IntervalLabel

universe u

variable {k : Type u} [Field k] {I : Type u} [LinearOrder I]

open Classical in
/-- The morphism `k_U ⟶ M` generated by a vector `v ∈ M(a)`. -/
noncomputable def fromVec (M : Rep k I) (U : Set (WithBot I)) [U.OrdConnected] (a : WithBot I)
    (v : M.obj a) (hUa : ∀ t ∈ U, a ≤ t) (hdie : ∀ t (h : a ≤ t), t ∉ U → smap M h v = 0) :
    intervalRep U ⟶ M where
  app t := ModuleCat.ofHom
    { toFun := fun f => if ht : t ∈ U then f ⟨(), ht⟩ • smap M (hUa t ht) v else 0
      map_add' := fun f g => by split_ifs <;> simp [add_smul]
      map_smul' := fun r f => by split_ifs <;> simp [mul_smul] }
  naturality s t hst := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro f
    change (if ht : t ∈ U then ((intervalRep U).map hst).hom f ⟨(), ht⟩ • smap M (hUa t ht) v
      else 0) = smap M (leOfHom hst) (if hs : s ∈ U then f ⟨(), hs⟩ • smap M (hUa s hs) v else 0)
    by_cases hs : s ∈ U
    · rw [dite_eq_left hs, map_smul, smap_comp]
      by_cases ht : t ∈ U
      · rw [dite_eq_left ht]
        congr 1
        exact (intervalRep_map_apply (k := k) (leOfHom hst) f ⟨(), ht⟩).trans (dite_eq_left hs)
      · rw [dite_eq_right ht, hdie t _ ht, smul_zero]
    · rw [dite_eq_right hs, map_zero]
      by_cases ht : t ∈ U
      · rw [dite_eq_left ht]
        rw [show ((intervalRep U).map hst).hom f ⟨(), ht⟩ = 0 from
          (intervalRep_map_apply (k := k) (leOfHom hst) f ⟨(), ht⟩).trans (dite_eq_right hs),
          zero_smul]
      · rw [dite_eq_right ht]

/-- The morphism `M ⟶ k_U` given by a functional on `M(d)`. -/
noncomputable def toInt (M : Rep k I) (U : Set (WithBot I)) [U.OrdConnected] (d : WithBot I)
    (μ : M.obj d →ₗ[k] k) (hUd : ∀ t ∈ U, t ≤ d)
    (hzero : ∀ s t (h : s ≤ t), s ∉ U → t ∈ U → ∀ m, smap M h m = 0) :
    M ⟶ intervalRep U where
  app t := ModuleCat.ofHom
    { toFun := fun m x => μ (smap M (hUd t x.2) m)
      map_add' := fun m m' => by funext x; simp
      map_smul' := fun r m => by funext x; simp }
  naturality s t hst := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro m
    funext x
    change μ (smap M (hUd t x.2) (smap M (leOfHom hst) m)) =
      ((intervalRep U).map (homOfLE (leOfHom hst))).hom
        (fun y => μ (smap M (hUd s y.2) m)) x
    refine Eq.trans ?_ (intervalRep_map_apply (k := k) (leOfHom hst) _ x).symm
    by_cases hs : s ∈ U
    · rw [dite_eq_left hs, smap_comp]
    · rw [dite_eq_right hs, hzero s t (leOfHom hst) hs x.2, map_zero, map_zero]

open Classical in
lemma fromVec_comp_toInt (M : Rep k I) (U : Set (WithBot I)) [U.OrdConnected] (a d : WithBot I)
    (v : M.obj a) (hUa : ∀ t ∈ U, a ≤ t) (hdie : ∀ t (h : a ≤ t), t ∉ U → smap M h v = 0)
    (μ : M.obj d →ₗ[k] k) (hUd : ∀ t ∈ U, t ≤ d)
    (hzero : ∀ s t (h : s ≤ t), s ∉ U → t ∈ U → ∀ m, smap M h m = 0) (had : a ≤ d)
    (hμ : μ (smap M had v) = 1) :
    fromVec M U a v hUa hdie ≫ toInt M U d μ hUd hzero = 𝟙 _ := by
  apply NatTrans.ext
  funext t
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro f
  funext x
  change μ (smap M (hUd t x.2)
    (if ht : t ∈ U then f ⟨(), ht⟩ • smap M (hUa t ht) v else 0)) = f x
  rw [dite_eq_left x.2, map_smul, smap_comp, map_smul, hμ, smul_eq_mul, mul_one]

/-! ### Splitting a retract -/

/-- The split kernel bicone associated to a retraction and its specified section. -/
noncomputable def kernelSplitBiproduct {X M : Rep k I} (ι : X ⟶ M) (r : M ⟶ X)
    (h : ι ≫ r = 𝟙 X) : BinaryBiproductData X (kernel r) := by
  let projection := kernel.lift r (𝟙 M - r ≫ ι) (by
    rw [Preadditive.sub_comp, Category.assoc, h, Category.comp_id, Category.id_comp, sub_self])
  have projection_section : ι ≫ projection = 0 := by
    apply (cancel_mono (kernel.ι r)).mp
    rw [Category.assoc, kernel.lift_ι, Preadditive.comp_sub, Category.comp_id,
      ← Category.assoc, h, Category.id_comp, sub_self, zero_comp]
  have projection_kernel : kernel.ι r ≫ projection = 𝟙 _ := by
    apply (cancel_mono (kernel.ι r)).mp
    rw [Category.assoc, kernel.lift_ι, Preadditive.comp_sub, Category.comp_id,
      ← Category.assoc, kernel.condition, zero_comp, sub_zero, Category.id_comp]
  let bicone : BinaryBicone X (kernel r) :=
    ⟨M, r, projection, ι, kernel.ι r, h, projection_section, kernel.condition r, projection_kernel⟩
  refine ⟨bicone, isBinaryBilimitOfTotal bicone ?_⟩
  change r ≫ ι + projection ≫ kernel.ι r = 𝟙 M
  rw [kernel.lift_ι, add_sub_cancel]

/-- The projection onto the kernel of a retraction. -/
noncomputable def kerProj {X M : Rep k I} (ι : X ⟶ M) (r : M ⟶ X) (h : ι ≫ r = 𝟙 X) :
    M ⟶ kernel r :=
  (kernelSplitBiproduct ι r h).bicone.snd

/-- A split monomorphism `X ⟶ M` with retraction `r` exhibits `M` as `X ⊞ ker r`. -/
noncomputable def isoBiprodKernel {X M : Rep k I} (ι : X ⟶ M) (r : M ⟶ X) (h : ι ≫ r = 𝟙 X) :
    M ≅ X ⊞ kernel r :=
  biprod.uniqueUpToIso _ _ (kernelSplitBiproduct ι r h).isBilimit

end ExtriangulatedRealization

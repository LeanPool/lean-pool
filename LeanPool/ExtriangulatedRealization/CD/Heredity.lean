module

public import LeanPool.ExtriangulatedRealization.CD.Indecomposables

/-!
# Heredity of `C(D)` over arbitrary linearly ordered indices

Split an object `M` into the summand `M_A` formed by its entries `A i` and the summand `M_R` of
its other entries, so that `1_M = ι_A π_A + ι_R π_R`. By (4.1), `E(M_A, -) = 0` and
`E(-, M_R) = 0`. A generator of `Eⁿ(C, A)` with `n ≥ 2` is `α ⊗ w` with `α ∈ E(M, A)` and `w` a
word starting in `E(-, M)`. Then `α = (π_R)^*(ι_R)^* α`, and by balance
`α ⊗ w ≡ (ι_R)^* α ⊗ (π_R)_* w`, whose second word starts in `E(-, M_R) = 0`. So `Eⁿ = 0` for
all `n ≥ 2` (Gorsky, Nakaoka and Palu).
-/

@[expose] public section

namespace ExtriangulatedRealization

open CategoryTheory Limits Opposite Statement IntervalLabel

universe u

variable {k : Type u} [Field k] {I : Type u} [LinearOrder I] (D : Iᵒᵖ ⥤ ModuleCat.{u} k)

attribute [local instance] HasExt.standard

/-- Whether a label is some `A i`. -/
def isALabel : IndCat D → Bool
  | some (A _) => true
  | _ => false

lemma not_isExtPair_of_isALabel {c : IndCat D} (hc : isALabel D c = true) (a : IndCat D) :
    ¬ IsExtPair c a := by
  rcases c with _ | _ | j | j <;> rcases a with _ | _ | i | i <;> simp_all [isALabel, IsExtPair]

lemma not_isExtPair_of_not_isALabel {a : IndCat D} (ha : (!isALabel D a) = true) (c : IndCat D) :
    ¬ IsExtPair c a := by
  rcases c with _ | _ | j | j <;> rcases a with _ | _ | i | i <;> simp_all [isALabel, IsExtPair]

/-- The subgroup generated by the relations of `Eⁿ(C, A)`. -/
abbrev relSubgroup (C' A : CD D) (n : ℕ) :
    AddSubgroup (FreeAbelianGroup ((cdData D).TensorWord C' A n)) :=
  AddSubgroup.closure {r | (cdData D).TensorRel r}

lemma of_single_zero_mem (C' A : CD D) :
    FreeAbelianGroup.of (.single 0 : (cdData D).TensorWord C' A 1) ∈ relSubgroup D C' A 1 := by
  have hr := AddSubgroup.subset_closure (k := {r | (cdData D).TensorRel r})
    (ExtriangulatedData.TensorRel.add_single (𝔼 := cdData D)
    (C' := C') (A := A) 0 0)
  rw [add_zero, sub_self, zero_sub] at hr
  exact neg_mem_iff.mp hr

lemma of_cons_zero_mem {C' M A : CD D} {n : ℕ} (w : (cdData D).TensorWord C' M n) :
    FreeAbelianGroup.of (.cons (0 : (cdData D).Ext M A) w) ∈ relSubgroup D C' A (n + 1) := by
  have hr := AddSubgroup.subset_closure (k := {r | (cdData D).TensorRel r})
    (ExtriangulatedData.TensorRel.add_cons (𝔼 := cdData D)
    (0 : (cdData D).Ext M A) 0 w)
  rw [add_zero, sub_self, zero_sub] at hr
  exact neg_mem_iff.mp hr

/-- Prefixing a factor maps relations to relations. -/
lemma of_cons_mem {C' M A : CD D} {n : ℕ} (α : (cdData D).Ext M A)
    {w : (cdData D).TensorWord C' M n} (hw : FreeAbelianGroup.of w ∈ relSubgroup D C' M n) :
    FreeAbelianGroup.of (.cons α w) ∈ relSubgroup D C' A (n + 1) := by
  have key : ∀ r ∈ relSubgroup D C' M n,
      FreeAbelianGroup.map (ExtriangulatedData.TensorWord.cons α) r ∈
        relSubgroup D C' A (n + 1) := by
    intro r hr
    induction hr using AddSubgroup.closure_induction with
    | mem r hr =>
        exact AddSubgroup.subset_closure (k := {r | (cdData D).TensorRel r})
          (ExtriangulatedData.TensorRel.tail α hr)
    | zero => rw [map_zero]; exact zero_mem _
    | add r r' _ _ h h' => rw [map_add]; exact add_mem h h'
    | neg r _ h => rw [map_neg]; exact neg_mem h
  simpa using key _ hw

/-- A word whose first factor is pushed into an object `N` with `E(-, N) = 0` is a relation. -/
lemma of_push_mem {C' M N : CD D} {n : ℕ} (f : M ⟶ N)
    (hN : ∀ (X : CD D) (γ : (cdData D).Ext X N), γ = 0) (w : (cdData D).TensorWord C' M n) :
    FreeAbelianGroup.of (ExtriangulatedData.TensorWord.push (cdData D) f w) ∈
      relSubgroup D C' N n := by
  cases w with
  | single β =>
    change FreeAbelianGroup.of (ExtriangulatedData.TensorWord.single ((cdData D).push f β)) ∈ _
    rw [hN _ ((cdData D).push f β)]
    exact of_single_zero_mem D _ _
  | cons β w' =>
    change FreeAbelianGroup.of (ExtriangulatedData.TensorWord.cons ((cdData D).push f β) w') ∈ _
    rw [hN _ ((cdData D).push f β)]
    exact of_cons_zero_mem D w'

/-- A generator `α ⊗ w` of length at least two is a relation. -/
lemma of_cons_word_mem {C' M A : CD D} {n : ℕ} (α : (cdData D).Ext M A)
    (w' : (cdData D).TensorWord C' M n) :
    FreeAbelianGroup.of (.cons α w') ∈ relSubgroup D C' A (n + 1) := by
  classical
  let p : M.ι → Bool := fun i => isALabel D (M.X i)
  let q : M.ι → Bool := fun i => !isALabel D (M.X i)
  have hdisj : ∀ i, p i = true → q i = true → False := fun i hp hq => by
    simp_all [p, q]
  have hcov : ∀ i, p i = true ∨ q i = true := fun i => by
    cases h : isALabel D (M.X i) <;> simp [p, q, h]
  have hα : α = (cdData D).pull (subProj M p) ((cdData D).pull (subIncl M p) α) +
      (cdData D).pull (subProj M q) ((cdData D).pull (subIncl M q) α) := by
    rw [ExtriangulatedData.pull_comp, ExtriangulatedData.pull_comp, ← cdData_pull_add,
      subProj_subIncl_add M p q hcov hdisj, cdData_pull_id]
  have h₁ : (cdData D).pull (subIncl M p) α = 0 :=
    cdExt_eq_zero D (C := subObj M p) (fun i j => not_isExtPair_of_isALabel D i.2 _) _
  rw [h₁, map_zero, zero_add] at hα
  have hN : ∀ (X : CD D) (γ : (cdData D).Ext X (subObj M q)), γ = 0 := fun X γ =>
    cdExt_eq_zero D (A := subObj M q) (fun i j => not_isExtPair_of_not_isALabel D j.2 _) γ
  have hbal := AddSubgroup.subset_closure (k := {r | (cdData D).TensorRel r})
    (ExtriangulatedData.TensorRel.balance (𝔼 := cdData D) (subProj M q)
      ((cdData D).pull (subIncl M q) α) w')
  have h := add_mem hbal (of_cons_mem D ((cdData D).pull (subIncl M q) α)
    (of_push_mem D (subProj M q) hN w'))
  rw [sub_add_cancel, ← hα] at h
  exact h

/-- The heredity clause of Proposition 4.4, extended to arbitrary linearly ordered
indices and arbitrary transition maps. The paper assumes a nonempty ordinal and
surjective transitions. The higher extension groups vanish for every `n ≥ 2`. -/
theorem cdData_isHereditary : (cdData D).IsHereditary := by
  intro n hn C' A w
  cases w with
  | single α => omega
  | cons α w' => exact of_cons_word_mem D α w'

end ExtriangulatedRealization

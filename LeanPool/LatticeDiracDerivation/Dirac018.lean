module

public import LeanPool.LatticeDiracDerivation.Dirac017Closed

/-!
# DIRAC-018: native cubical factorization classification

This stage addresses the remaining ambiguity in the cubical square-root
readout.  It does not assume a set of Dirac matrices.  Instead it classifies
the complete real, local, first-order class generated by the three native
cube-incidence directions and the native parity grading.

The classification hypotheses are stated at the coefficient level:

* the transport coefficients commute with two generating quarter turns of
  the cubic rotation group;
* the resulting first-order operator squares to the action-derived scalar
  continuum symbol for every mass and momentum; and
* the already-derived positive rest-frequency and current orientations are
  retained.

The conclusion is exact: the mass coefficient and transport matrix are the
canonical ones, so the candidate operator is `cubeDiracSymbol`.  A separate
copy census proves that the native flavor involution has exactly the two
rank-four sectors already exhibited, while a full first-Brillouin-zone check
proves that the C19 scalar transport symbol has no additional zero away from
the origin.  Thus the two cube copies are internal flavor copies, not hidden
momentum-space zeros.

The scope is deliberately explicit.  This is uniqueness inside the native
local first-order cubical-incidence class.  It does not classify arbitrary
nonlocal square roots or prove that a localized nonlinear electron is
dynamically selected.
-/

@[expose] public section

namespace LeanDirac

noncomputable section
open Complex

/-- A real vector in `ℝ³`, as a function `Fin 3 → ℝ`. -/
abbrev RealCubeVector := Fin 3 → ℝ
/-- A real `3 × 3` matrix, as a function of a row index and a column index. -/
abbrev RealCubeMatrix := Fin 3 → Fin 3 → ℝ

/-- The standard basis vector of `ℝ³` with a `1` in position `axis` and `0` elsewhere. -/
def realCubeBasis (axis : Fin 3) : RealCubeVector :=
  fun component => if component = axis then 1 else 0

/-- The matrix-vector product of a real `3 × 3` matrix with a vector in `ℝ³`. -/
def realCubeMatrixApply
    (matrix : RealCubeMatrix) (vector : RealCubeVector) : RealCubeVector :=
  fun row => ∑ column, matrix row column * vector column

/-- The quarter turn about the third axis, `(x, y, z) ↦ (-y, x, z)`. -/
def realCubeQuarterTurnZ (vector : RealCubeVector) : RealCubeVector
  | 0 => -vector 1
  | 1 => vector 0
  | _ => vector 2

/-- The quarter turn about the first axis, `(x, y, z) ↦ (x, -z, y)`. -/
def realCubeQuarterTurnX (vector : RealCubeVector) : RealCubeVector
  | 0 => vector 0
  | 1 => -vector 2
  | _ => vector 1

/-- The matrix commutes with both quarter turns `realCubeQuarterTurnZ` and
`realCubeQuarterTurnX`. -/
def CubicCoefficientCovariant (matrix : RealCubeMatrix) : Prop :=
  (∀ vector,
    realCubeMatrixApply matrix (realCubeQuarterTurnZ vector) =
      realCubeQuarterTurnZ (realCubeMatrixApply matrix vector)) ∧
  (∀ vector,
    realCubeMatrixApply matrix (realCubeQuarterTurnX vector) =
      realCubeQuarterTurnX (realCubeMatrixApply matrix vector))

theorem cubic_covariant_coefficients_are_scalar
    (matrix : RealCubeMatrix) (hcovariant : CubicCoefficientCovariant matrix) :
    ∃ scale : ℝ, ∀ row column,
      matrix row column = if row = column then scale else 0 := by
  rcases hcovariant with ⟨hz, hx⟩
  have hz00 := congrFun (hz (realCubeBasis 0)) 0
  have hz01 := congrFun (hz (realCubeBasis 0)) 1
  have hz02 := congrFun (hz (realCubeBasis 0)) 2
  have hz10 := congrFun (hz (realCubeBasis 1)) 0
  have hz11 := congrFun (hz (realCubeBasis 1)) 1
  have hz12 := congrFun (hz (realCubeBasis 1)) 2
  have hz20 := congrFun (hz (realCubeBasis 2)) 0
  have hz21 := congrFun (hz (realCubeBasis 2)) 1
  have hz22 := congrFun (hz (realCubeBasis 2)) 2
  have hx00 := congrFun (hx (realCubeBasis 0)) 0
  have hx01 := congrFun (hx (realCubeBasis 0)) 1
  have hx02 := congrFun (hx (realCubeBasis 0)) 2
  have hx10 := congrFun (hx (realCubeBasis 1)) 0
  have hx11 := congrFun (hx (realCubeBasis 1)) 1
  have hx12 := congrFun (hx (realCubeBasis 1)) 2
  have hx20 := congrFun (hx (realCubeBasis 2)) 0
  have hx21 := congrFun (hx (realCubeBasis 2)) 1
  have hx22 := congrFun (hx (realCubeBasis 2)) 2
  simp [realCubeMatrixApply, realCubeQuarterTurnZ,
    realCubeQuarterTurnX, realCubeBasis, Fin.sum_univ_succ]
    at hz00 hz01 hz02 hz10 hz11 hz12 hz20 hz21 hz22 hx00 hx01 hx02 hx10 hx11 hx12 hx20 hx21 hx22
  refine ⟨matrix 0 0, ?_⟩
  intro row column
  fin_cases row <;> fin_cases column <;>
    simp <;>
    linarith

/-- The coefficients of a first-order operator on eight-corner amplitudes: a real scale for the
mass term and a real `3 × 3` transport matrix acting on the momentum. -/
structure NativeCubicalRootCandidate where
  /-- The real factor multiplying the mass term. -/
  massScale : ℝ
  /-- The real `3 × 3` matrix applied to the momentum before the incidence operators. -/
  transport : RealCubeMatrix

/-- The `axis` component of the transport matrix of `candidate` applied to `momentum`. -/
def candidateIncidenceMomentum
    (candidate : NativeCubicalRootCandidate)
    (momentum : Fin 3 → ℂ) (axis : Fin 3) : ℂ :=
  ∑ component,
    (candidate.transport axis component : ℂ) * momentum component

/-- The operator `massScale * mass * cubeParityBeta + cubeIncidenceLinear k₀ k₁ k₂` on
eight-corner amplitudes, where `kᵢ` is `candidateIncidenceMomentum candidate momentum i`. -/
def nativeCubicalRootOperator
    (candidate : NativeCubicalRootCandidate)
    (mass : ℂ) (momentum : Fin 3 → ℂ) (amplitude : Cell8) : Cell8 :=
  fun corner =>
    (candidate.massScale : ℂ) * mass * cubeParityBeta amplitude corner +
      cubeIncidenceLinear
        (candidateIncidenceMomentum candidate momentum 0)
        (candidateIncidenceMomentum candidate momentum 1)
        (candidateIncidenceMomentum candidate momentum 2)
        amplitude corner

/-- For every mass, momentum and amplitude, the square of `nativeCubicalRootOperator candidate`
is multiplication by `mass ^ 2 + ∑ᵢ momentum i ^ 2` (the operator `cubeScalarSymbol`). -/
def NativeCubicalRootMatchesScalar
    (candidate : NativeCubicalRootCandidate) : Prop :=
  ∀ mass momentum amplitude,
    nativeCubicalRootOperator candidate mass momentum
        (nativeCubicalRootOperator candidate mass momentum amplitude) =
      cubeScalarSymbol mass (momentum 0) (momentum 1) (momentum 2) amplitude

/-- The candidate has a transport matrix commuting with the two quarter turns, squares to the
scalar symbol, and has nonnegative `massScale` and nonnegative entry `transport 0 0`. -/
def NativeCubicalRootAdmissible
    (candidate : NativeCubicalRootCandidate) : Prop :=
  CubicCoefficientCovariant candidate.transport ∧
  NativeCubicalRootMatchesScalar candidate ∧
  0 ≤ candidate.massScale ∧
  0 ≤ candidate.transport 0 0

theorem native_cubical_root_operator_square
    (candidate : NativeCubicalRootCandidate)
    (mass : ℂ) (momentum : Fin 3 → ℂ) (amplitude : Cell8) :
    nativeCubicalRootOperator candidate mass momentum
        (nativeCubicalRootOperator candidate mass momentum amplitude) =
      fun corner =>
        (((candidate.massScale : ℂ) * mass) ^ 2 +
          candidateIncidenceMomentum candidate momentum 0 ^ 2 +
          candidateIncidenceMomentum candidate momentum 1 ^ 2 +
          candidateIncidenceMomentum candidate momentum 2 ^ 2) *
            amplitude corner := by
  funext corner
  fin_cases corner <;>
    simp [nativeCubicalRootOperator, candidateIncidenceMomentum,
      cubeParityBeta, cubeIncidenceLinear, cubeIncidenceGamma,
      cubeIncidenceSign, cubeIncidenceFlip, cellFlip0, cellFlip1,
      cellFlip2, cellBit0, cellBit1, cellBit2, Fin.sum_univ_succ] <;>
    ring

/-!
The following two controls make the classification hypotheses falsifiable.
An overall negative root has the same square and cubic covariance but is
rejected by the previously selected positive frequency/current orientation.
An axis reflection also has the same scalar square, but it fails cubic
covariance.  Thus neither positivity nor cubic covariance is a redundant
decoration of the theorem.
-/

/-- The negative of the `3 × 3` identity matrix. -/
def negativeIdentityCubeMatrix : RealCubeMatrix :=
  fun row column => if row = column then -1 else 0

/-- The diagonal matrix `diag (-1, 1, 1)`, the reflection of the first axis. -/
def reflectedAxisCubeMatrix : RealCubeMatrix :=
  fun row column =>
    if row = column then if row = 0 then -1 else 1 else 0

/-- The candidate with mass scale `-1` and transport matrix `negativeIdentityCubeMatrix`. -/
def overallNegativeRootCandidate : NativeCubicalRootCandidate where
  massScale := -1
  transport := negativeIdentityCubeMatrix

/-- The candidate with mass scale `1` and transport matrix `reflectedAxisCubeMatrix`. -/
def reflectedAxisRootCandidate : NativeCubicalRootCandidate where
  massScale := 1
  transport := reflectedAxisCubeMatrix

theorem negative_identity_cube_matrix_covariant :
    CubicCoefficientCovariant negativeIdentityCubeMatrix := by
  constructor <;> intro vector <;> funext row <;> fin_cases row <;>
    simp [realCubeMatrixApply, realCubeQuarterTurnZ,
      realCubeQuarterTurnX, negativeIdentityCubeMatrix]

theorem overall_negative_root_matches_scalar :
    NativeCubicalRootMatchesScalar overallNegativeRootCandidate := by
  intro mass momentum amplitude
  rw [native_cubical_root_operator_square]
  funext corner
  simp [overallNegativeRootCandidate, negativeIdentityCubeMatrix,
    candidateIncidenceMomentum, cubeScalarSymbol, Fin.sum_univ_succ]

theorem overall_negative_root_is_rejected :
    ¬ NativeCubicalRootAdmissible overallNegativeRootCandidate := by
  intro hadmissible
  have hpositive := hadmissible.2.2.1
  norm_num [overallNegativeRootCandidate] at hpositive

theorem reflected_axis_root_matches_scalar :
    NativeCubicalRootMatchesScalar reflectedAxisRootCandidate := by
  intro mass momentum amplitude
  rw [native_cubical_root_operator_square]
  funext corner
  simp [reflectedAxisRootCandidate, reflectedAxisCubeMatrix,
    candidateIncidenceMomentum, cubeScalarSymbol, Fin.sum_univ_succ]

theorem reflected_axis_cube_matrix_not_covariant :
    ¬ CubicCoefficientCovariant reflectedAxisCubeMatrix := by
  intro hcovariant
  obtain ⟨scale, hmatrix⟩ :=
    cubic_covariant_coefficients_are_scalar reflectedAxisCubeMatrix hcovariant
  have h00 := hmatrix 0 0
  have h11 := hmatrix 1 1
  norm_num [reflectedAxisCubeMatrix] at h00 h11
  linarith

theorem reflected_axis_root_is_rejected :
    ¬ NativeCubicalRootAdmissible reflectedAxisRootCandidate := by
  intro hadmissible
  exact reflected_axis_cube_matrix_not_covariant hadmissible.1

/-! The classification is proved once, for a squaring condition imposed only on the image of
an arbitrary embedding that has a component equal to one somewhere. The all-amplitude
statements are the special case of the constant embedding. -/

/-- The square of `nativeCubicalRootOperator candidate` agrees with `cubeScalarSymbol` on every
amplitude in the image of `embedding`, for every mass and momentum. -/
def NativeCubicalRootMatchesOnEmbedding
    (candidate : NativeCubicalRootCandidate)
    (embedding : Cell4 → Cell8) : Prop :=
  ∀ mass momentum z,
    nativeCubicalRootOperator candidate mass momentum
        (nativeCubicalRootOperator candidate mass momentum (embedding z)) =
      cubeScalarSymbol mass (momentum 0) (momentum 1) (momentum 2)
        (embedding z)

/-- The variant of `NativeCubicalRootAdmissible` in which the squaring condition is required
only on the image of `embedding`. -/
def NativeCubicalRootAdmissibleOnEmbedding
    (candidate : NativeCubicalRootCandidate)
    (embedding : Cell4 → Cell8) : Prop :=
  CubicCoefficientCovariant candidate.transport ∧
  NativeCubicalRootMatchesOnEmbedding candidate embedding ∧
  0 ≤ candidate.massScale ∧
  0 ≤ candidate.transport 0 0

/-- The first standard basis vector of `Cell4`, with a `1` in position `0`. -/
def cell4FirstBasis : Cell4
  | 0 => 1
  | _ => 0

theorem embedding_admissible_mass_scale_square
    (candidate : NativeCubicalRootCandidate)
    (embedding : Cell4 → Cell8) (probe : Cell4) (corner : CubeCorner)
    (hprobe : embedding probe corner = 1)
    (hadmissible : NativeCubicalRootAdmissibleOnEmbedding candidate embedding) :
    candidate.massScale ^ 2 = 1 := by
  rcases hadmissible with ⟨_, hscalar, _, _⟩
  have h := congrFun
    (hscalar (1 : ℂ) (fun _ => 0) probe) corner
  rw [native_cubical_root_operator_square] at h
  have hre := congrArg Complex.re h
  norm_num [cubeScalarSymbol, candidateIncidenceMomentum,
    Fin.sum_univ_succ, hprobe] at hre
  simpa [pow_two] using hre

theorem embedding_admissible_transport_scale_square
    (candidate : NativeCubicalRootCandidate)
    (embedding : Cell4 → Cell8) (probe : Cell4) (corner : CubeCorner)
    (hprobe : embedding probe corner = 1)
    (hadmissible : NativeCubicalRootAdmissibleOnEmbedding candidate embedding) :
    candidate.transport 0 0 ^ 2 = 1 := by
  rcases hadmissible with ⟨hcovariant, hscalar, _, _⟩
  obtain ⟨scale, hmatrix⟩ :=
    cubic_covariant_coefficients_are_scalar candidate.transport hcovariant
  have hscale : scale = candidate.transport 0 0 := by
    simpa using (hmatrix 0 0).symm
  have h := congrFun
    (hscalar (0 : ℂ)
      (fun axis => if axis = 0 then 1 else 0) probe) corner
  rw [native_cubical_root_operator_square] at h
  have hre := congrArg Complex.re h
  norm_num [cubeScalarSymbol, candidateIncidenceMomentum,
    Fin.sum_univ_succ, hmatrix, hprobe] at hre
  rw [hscale] at hre
  simpa [pow_two] using hre

theorem embedding_admissible_mass_scale_eq_one
    (candidate : NativeCubicalRootCandidate)
    (embedding : Cell4 → Cell8) (probe : Cell4) (corner : CubeCorner)
    (hprobe : embedding probe corner = 1)
    (hadmissible : NativeCubicalRootAdmissibleOnEmbedding candidate embedding) :
    candidate.massScale = 1 := by
  have hsquare := embedding_admissible_mass_scale_square
    candidate embedding probe corner hprobe hadmissible
  nlinarith [hadmissible.2.2.1]

theorem embedding_admissible_transport_is_identity
    (candidate : NativeCubicalRootCandidate)
    (embedding : Cell4 → Cell8) (probe : Cell4) (corner : CubeCorner)
    (hprobe : embedding probe corner = 1)
    (hadmissible : NativeCubicalRootAdmissibleOnEmbedding candidate embedding) :
    ∀ row column,
      candidate.transport row column = if row = column then 1 else 0 := by
  obtain ⟨scale, hmatrix⟩ :=
    cubic_covariant_coefficients_are_scalar candidate.transport hadmissible.1
  have hscale0 : scale = candidate.transport 0 0 := by
    simpa using (hmatrix 0 0).symm
  have hsquare := embedding_admissible_transport_scale_square
    candidate embedding probe corner hprobe hadmissible
  have hpositive : 0 ≤ scale := by
    rw [hscale0]
    exact hadmissible.2.2.2
  have hscale : scale = 1 := by nlinarith
  intro row column
  rw [hmatrix, hscale]

theorem embedding_admissible_root_is_canonical
    (candidate : NativeCubicalRootCandidate)
    (embedding : Cell4 → Cell8) (probe : Cell4) (corner : CubeCorner)
    (hprobe : embedding probe corner = 1)
    (hadmissible : NativeCubicalRootAdmissibleOnEmbedding candidate embedding)
    (mass : ℂ) (momentum : Fin 3 → ℂ) (amplitude : Cell8) :
    nativeCubicalRootOperator candidate mass momentum amplitude =
      cubeDiracSymbol mass (momentum 0) (momentum 1) (momentum 2) amplitude := by
  have hmass := embedding_admissible_mass_scale_eq_one
    candidate embedding probe corner hprobe hadmissible
  have htransport := embedding_admissible_transport_is_identity
    candidate embedding probe corner hprobe hadmissible
  funext outputCorner
  fin_cases outputCorner <;>
    simp [nativeCubicalRootOperator, candidateIncidenceMomentum,
      cubeDiracSymbol, cubeIncidenceLinear, hmass, htransport,
      Fin.sum_univ_succ]

/-- The embedding of `Cell4` into eight-corner amplitudes that places the first component
at every corner. -/
def constantCubeEmbedding (z : Cell4) : Cell8 := fun _ => z 0

theorem admissible_on_constant_embedding
    (candidate : NativeCubicalRootCandidate)
    (hadmissible : NativeCubicalRootAdmissible candidate) :
    NativeCubicalRootAdmissibleOnEmbedding candidate constantCubeEmbedding :=
  ⟨hadmissible.1, fun mass momentum _ => hadmissible.2.1 mass momentum _,
    hadmissible.2.2.1, hadmissible.2.2.2⟩

theorem admissible_mass_scale_eq_one
    (candidate : NativeCubicalRootCandidate)
    (hadmissible : NativeCubicalRootAdmissible candidate) :
    candidate.massScale = 1 :=
  embedding_admissible_mass_scale_eq_one candidate constantCubeEmbedding cell4FirstBasis 0
    rfl (admissible_on_constant_embedding candidate hadmissible)

theorem admissible_transport_is_identity
    (candidate : NativeCubicalRootCandidate)
    (hadmissible : NativeCubicalRootAdmissible candidate) :
    ∀ row column,
      candidate.transport row column = if row = column then 1 else 0 :=
  embedding_admissible_transport_is_identity candidate constantCubeEmbedding cell4FirstBasis 0
    rfl (admissible_on_constant_embedding candidate hadmissible)

theorem admissible_native_cubical_root_is_canonical
    (candidate : NativeCubicalRootCandidate)
    (hadmissible : NativeCubicalRootAdmissible candidate)
    (mass : ℂ) (momentum : Fin 3 → ℂ) (amplitude : Cell8) :
    nativeCubicalRootOperator candidate mass momentum amplitude =
      cubeDiracSymbol mass (momentum 0) (momentum 1) (momentum 2) amplitude :=
  embedding_admissible_root_is_canonical candidate constantCubeEmbedding cell4FirstBasis 0
    rfl (admissible_on_constant_embedding candidate hadmissible) mass momentum amplitude

/-! ## Exact census of the two internal cube copies -/

/-- The projection `(amplitude + cubeFlavor amplitude) / 2` onto the `+1` eigenspace of the
involution `cubeFlavor`. -/
def cubeFlavorPlusProjection (amplitude : Cell8) : Cell8 :=
  fun corner => (amplitude corner + cubeFlavor amplitude corner) / 2

/-- The projection `(amplitude - cubeFlavor amplitude) / 2` onto the `-1` eigenspace of the
involution `cubeFlavor`. -/
def cubeFlavorMinusProjection (amplitude : Cell8) : Cell8 :=
  fun corner => (amplitude corner - cubeFlavor amplitude corner) / 2

theorem cube_flavor_projection_decomposition (amplitude : Cell8) :
    (fun corner =>
      cubeFlavorPlusProjection amplitude corner +
        cubeFlavorMinusProjection amplitude corner) = amplitude := by
  funext corner
  simp [cubeFlavorPlusProjection, cubeFlavorMinusProjection]
  ring

theorem cube_flavor_plus_projection_is_positive (amplitude : Cell8) :
    cubeFlavor (cubeFlavorPlusProjection amplitude) =
      cubeFlavorPlusProjection amplitude := by
  funext corner
  fin_cases corner <;>
    simp [cubeFlavorPlusProjection, cubeFlavor, cubeFlavorSign,
      cellFlip1, cellFlip2, cellBit2] <;>
    ring_nf <;> rw [Complex.I_sq] <;> ring

theorem cube_flavor_minus_projection_is_negative (amplitude : Cell8) :
    cubeFlavor (cubeFlavorMinusProjection amplitude) =
      fun corner => -cubeFlavorMinusProjection amplitude corner := by
  funext corner
  fin_cases corner <;>
    simp [cubeFlavorMinusProjection, cubeFlavor, cubeFlavorSign,
      cellFlip1, cellFlip2, cellBit2] <;>
    ring_nf <;> rw [Complex.I_sq] <;> ring

/-!
A flavor-preserving candidate may a priori use different real coefficients
on the two native copies.  The next definition includes that possibility;
the one-copy theorem is applied independently on each exact flavor
projection.  This prevents copy symmetry from being smuggled in as an
unstated assumption.
-/

/-- A pair of candidate coefficient sets, one acting on each eigenspace of `cubeFlavor`. -/
structure NativeTwoCopyCubicalRootCandidate where
  /-- The candidate coefficients used on the `+1` eigenspace of `cubeFlavor`. -/
  plus : NativeCubicalRootCandidate
  /-- The candidate coefficients used on the `-1` eigenspace of `cubeFlavor`. -/
  minus : NativeCubicalRootCandidate

theorem plus_probe_component_is_one :
    cubeDiracEmbedPlus cell4FirstBasis 5 = 1 := by rfl

theorem minus_probe_component_is_one :
    cubeDiracEmbedMinus cell4FirstBasis 0 = 1 := by rfl

/-- The operator applying `nativeCubicalRootOperator candidate.plus` to the `+1` flavor
projection and `nativeCubicalRootOperator candidate.minus` to the `-1` projection, summed. -/
def nativeTwoCopyCubicalRootOperator
    (candidate : NativeTwoCopyCubicalRootCandidate)
    (mass : ℂ) (momentum : Fin 3 → ℂ) (amplitude : Cell8) : Cell8 :=
  fun corner =>
    nativeCubicalRootOperator candidate.plus mass momentum
        (cubeFlavorPlusProjection amplitude) corner +
      nativeCubicalRootOperator candidate.minus mass momentum
        (cubeFlavorMinusProjection amplitude) corner

/-- `candidate.plus` is admissible on the image of `cubeDiracEmbedPlus` and `candidate.minus` is
admissible on the image of `cubeDiracEmbedMinus`. -/
def NativeTwoCopyCubicalRootAdmissible
    (candidate : NativeTwoCopyCubicalRootCandidate) : Prop :=
  NativeCubicalRootAdmissibleOnEmbedding candidate.plus cubeDiracEmbedPlus ∧
    NativeCubicalRootAdmissibleOnEmbedding candidate.minus cubeDiracEmbedMinus

theorem admissible_two_copy_native_root_is_canonical
    (candidate : NativeTwoCopyCubicalRootCandidate)
    (hadmissible : NativeTwoCopyCubicalRootAdmissible candidate)
    (mass : ℂ) (momentum : Fin 3 → ℂ) (amplitude : Cell8) :
    nativeTwoCopyCubicalRootOperator candidate mass momentum amplitude =
      cubeDiracSymbol mass (momentum 0) (momentum 1) (momentum 2) amplitude := by
  have hplus := embedding_admissible_root_is_canonical
    candidate.plus cubeDiracEmbedPlus cell4FirstBasis 5
      plus_probe_component_is_one hadmissible.1 mass momentum
      (cubeFlavorPlusProjection amplitude)
  have hminus := embedding_admissible_root_is_canonical
    candidate.minus cubeDiracEmbedMinus cell4FirstBasis 0
      minus_probe_component_is_one hadmissible.2 mass momentum
      (cubeFlavorMinusProjection amplitude)
  funext corner
  rw [show nativeTwoCopyCubicalRootOperator candidate mass momentum amplitude
      corner =
      nativeCubicalRootOperator candidate.plus mass momentum
          (cubeFlavorPlusProjection amplitude) corner +
        nativeCubicalRootOperator candidate.minus mass momentum
          (cubeFlavorMinusProjection amplitude) corner by rfl,
    congrFun hplus corner, congrFun hminus corner]
  fin_cases corner <;>
    simp [cubeDiracSymbol, cubeParityBeta, cubeIncidenceLinear,
      cubeIncidenceGamma, cubeIncidenceSign, cubeIncidenceFlip,
      cubeFlavorPlusProjection, cubeFlavorMinusProjection, cubeFlavor,
      cubeFlavorSign, cellFlip0, cellFlip1, cellFlip2,
      cellBit0, cellBit1, cellBit2] <;>
    ring

/-- The four amplitudes at the corners `0`, `1`, `4`, `5`, read off as a `Cell4`. -/
def cubeRawCoordinates (amplitude : Cell8) : Cell4
  | 0 => amplitude 0
  | 1 => amplitude 1
  | 2 => amplitude 4
  | _ => amplitude 5

theorem positive_flavor_is_exactly_plus_embedding
    (amplitude : Cell8) (hflavor : cubeFlavor amplitude = amplitude) :
    ∃ z : Cell4, cubeDiracEmbedPlus z = amplitude := by
  let raw := cubeRawCoordinates amplitude
  refine ⟨plusCubeSpinorToStandard raw, ?_⟩
  rw [cubeDiracEmbedPlus, plus_cube_basis_right_inverse]
  funext corner
  have h0 := congrFun hflavor 0
  have h1 := congrFun hflavor 1
  have h2 := congrFun hflavor 2
  have h3 := congrFun hflavor 3
  have h4 := congrFun hflavor 4
  have h5 := congrFun hflavor 5
  have h6 := congrFun hflavor 6
  have h7 := congrFun hflavor 7
  fin_cases corner <;>
    simp only [cubeFlavor, cubeFlavorSign, cellBit2, Fin.isValue, Nat.zero_mod, ↓reduceIte,
        ofReal_one, mul_one, cellFlip1, cellFlip2, Nat.mod_succ, one_ne_zero, ofReal_neg, mul_neg,
        neg_mul, cubeEmbedPlus, Fin.zero_eta, cubeRawCoordinates, raw, Fin.mk_one,
        Fin.reduceFinMk] at h0 h1 h2 h3 h4 h5 h6 h7 ⊢ <;>
    assumption

theorem negative_flavor_is_exactly_minus_embedding
    (amplitude : Cell8)
    (hflavor : cubeFlavor amplitude = fun corner => -amplitude corner) :
    ∃ z : Cell4, cubeDiracEmbedMinus z = amplitude := by
  let raw := cubeRawCoordinates amplitude
  refine ⟨minusCubeSpinorToStandard raw, ?_⟩
  rw [cubeDiracEmbedMinus, minus_cube_basis_right_inverse]
  funext corner
  have h0 := congrFun hflavor 0
  have h1 := congrFun hflavor 1
  have h2 := congrFun hflavor 2
  have h3 := congrFun hflavor 3
  have h4 := congrFun hflavor 4
  have h5 := congrFun hflavor 5
  have h6 := congrFun hflavor 6
  have h7 := congrFun hflavor 7
  fin_cases corner <;>
    simp only [cubeFlavor, cubeFlavorSign, cellBit2, Fin.isValue, Nat.zero_mod, ↓reduceIte,
        ofReal_one, mul_one, cellFlip1, cellFlip2, Nat.mod_succ, one_ne_zero, ofReal_neg, mul_neg,
        neg_mul, neg_inj, cubeEmbedMinus, Fin.zero_eta, cubeRawCoordinates, raw, Fin.mk_one,
        Fin.reduceFinMk] at h0 h1 h2 h3 h4 h5 h6 h7 ⊢
  all_goals first | assumption | linear_combination (-1 : ℂ) * h2 |
    linear_combination (-1 : ℂ) * h6

theorem cube_flavor_copies_intersect_only_at_zero
    (amplitude : Cell8)
    (hplus : cubeFlavor amplitude = amplitude)
    (hminus : cubeFlavor amplitude = fun corner => -amplitude corner) :
    amplitude = 0 := by
  funext corner
  have h := congrFun (hplus.symm.trans hminus) corner
  simp only [Pi.zero_apply]
  have hzero : amplitude corner - (-amplitude corner) = 0 :=
    sub_eq_zero.mpr h
  calc
    amplitude corner =
        (1 / 2 : ℂ) * (amplitude corner - (-amplitude corner)) := by ring
    _ = 0 := by rw [hzero]; ring

/-! ## Full first-Brillouin-zone zero census for the C19 scalar symbol -/

/-- Every component of the momentum lies in the closed interval `[-π, π]`. -/
def InFirstBrillouinZone (momentum : LatticeMomentum) : Prop :=
  ∀ axis, -Real.pi ≤ momentum axis ∧ momentum axis ≤ Real.pi

theorem c19_closed_symbol_zero_forces_cosines_one
    (momentum : LatticeMomentum) (hzero : c19ClosedSymbol momentum = 0) :
    Real.cos (momentum 0) = 1 ∧
      Real.cos (momentum 1) = 1 ∧
      Real.cos (momentum 2) = 1 := by
  have h01abs :
      |Real.cos (momentum 0) * Real.cos (momentum 1)| ≤ 1 := by
    rw [abs_mul]
    nlinarith [abs_nonneg (Real.cos (momentum 0)),
      abs_nonneg (Real.cos (momentum 1)),
      Real.abs_cos_le_one (momentum 0), Real.abs_cos_le_one (momentum 1)]
  have h02abs :
      |Real.cos (momentum 0) * Real.cos (momentum 2)| ≤ 1 := by
    rw [abs_mul]
    nlinarith [abs_nonneg (Real.cos (momentum 0)),
      abs_nonneg (Real.cos (momentum 2)),
      Real.abs_cos_le_one (momentum 0), Real.abs_cos_le_one (momentum 2)]
  have h12abs :
      |Real.cos (momentum 1) * Real.cos (momentum 2)| ≤ 1 := by
    rw [abs_mul]
    nlinarith [abs_nonneg (Real.cos (momentum 1)),
      abs_nonneg (Real.cos (momentum 2)),
      Real.abs_cos_le_one (momentum 1), Real.abs_cos_le_one (momentum 2)]
  have h01 : Real.cos (momentum 0) * Real.cos (momentum 1) ≤ 1 :=
    (le_abs_self _).trans h01abs
  have h02 : Real.cos (momentum 0) * Real.cos (momentum 2) ≤ 1 :=
    (le_abs_self _).trans h02abs
  have h12 : Real.cos (momentum 1) * Real.cos (momentum 2) ≤ 1 :=
    (le_abs_self _).trans h12abs
  unfold c19ClosedSymbol at hzero
  constructor
  · nlinarith [Real.cos_le_one (momentum 0),
      Real.cos_le_one (momentum 1), Real.cos_le_one (momentum 2)]
  constructor <;>
    nlinarith [Real.cos_le_one (momentum 0),
      Real.cos_le_one (momentum 1), Real.cos_le_one (momentum 2)]

theorem c19_first_brillouin_zone_zero_unique
    (momentum : LatticeMomentum) (hzone : InFirstBrillouinZone momentum)
    (hzero : c19TransportSymbol momentum = 0) :
    momentum = fun _ => 0 := by
  have hclosed : c19ClosedSymbol momentum = 0 := by
    rw [← c19_transport_symbol_closed]
    exact hzero
  obtain ⟨hcos0, hcos1, hcos2⟩ :=
    c19_closed_symbol_zero_forces_cosines_one momentum hclosed
  funext axis
  have hbounds := hzone axis
  have hlower : -(2 * Real.pi) < momentum axis := by
    have hpi := Real.pi_pos
    linarith [hbounds.1]
  have hupper : momentum axis < 2 * Real.pi := by
    have hpi := Real.pi_pos
    linarith [hbounds.2]
  have hcos : Real.cos (momentum axis) = 1 := by
    fin_cases axis <;> assumption
  exact (Real.cos_eq_one_iff_of_lt_of_lt hlower hupper).mp hcos

/-- The DIRAC-018 statement bundle: the DIRAC-017 certificate holds, admissible first-order
candidates equal `cubeDiracSymbol`,
the two `cubeFlavor` eigenspaces are exactly the images of `cubeDiracEmbedPlus` and
`cubeDiracEmbedMinus`, `c19TransportSymbol` vanishes in `[-π, π]³` only at zero, and the
orientation and covariance hypotheses are each necessary. -/
structure Dirac018NativeFactorizationClassificationCertificate : Prop where
  priorChain : Dirac017ClosedSpinHalfRepresentationCertificate
  covariantCoefficientsAreScalar : ∀ matrix,
    CubicCoefficientCovariant matrix →
      ∃ scale : ℝ, ∀ row column,
        matrix row column = if row = column then scale else 0
  admissibleRootIsCanonical : ∀ candidate,
    NativeCubicalRootAdmissible candidate →
      ∀ mass momentum amplitude,
        nativeCubicalRootOperator candidate mass momentum amplitude =
          cubeDiracSymbol mass (momentum 0) (momentum 1) (momentum 2)
            amplitude
  independentlyAdmissibleCopiesAreCanonical : ∀ candidate,
    NativeTwoCopyCubicalRootAdmissible candidate →
      ∀ mass momentum amplitude,
        nativeTwoCopyCubicalRootOperator candidate mass momentum amplitude =
          cubeDiracSymbol mass (momentum 0) (momentum 1) (momentum 2)
            amplitude
  positiveEmbeddingIsInjective : Function.Injective cubeDiracEmbedPlus
  negativeEmbeddingIsInjective : Function.Injective cubeDiracEmbedMinus
  positiveEmbeddingHasPositiveFlavor : ∀ z,
    cubeFlavor (cubeDiracEmbedPlus z) = cubeDiracEmbedPlus z
  negativeEmbeddingHasNegativeFlavor : ∀ z,
    cubeFlavor (cubeDiracEmbedMinus z) =
      fun corner => -cubeDiracEmbedMinus z corner
  positiveCopyIsExhaustive : ∀ amplitude,
    cubeFlavor amplitude = amplitude →
      ∃ z : Cell4, cubeDiracEmbedPlus z = amplitude
  negativeCopyIsExhaustive : ∀ amplitude,
    cubeFlavor amplitude = (fun corner => -amplitude corner) →
      ∃ z : Cell4, cubeDiracEmbedMinus z = amplitude
  copyIntersectionIsZero : ∀ amplitude,
    cubeFlavor amplitude = amplitude →
    cubeFlavor amplitude = (fun corner => -amplitude corner) →
      amplitude = 0
  everyAmplitudeDecomposes : ∀ amplitude,
    (fun corner =>
      cubeFlavorPlusProjection amplitude corner +
        cubeFlavorMinusProjection amplitude corner) = amplitude
  noAdditionalC19MomentumZero : ∀ momentum,
    InFirstBrillouinZone momentum → c19TransportSymbol momentum = 0 →
      momentum = fun _ => 0
  orientationHypothesisIsNecessary :
    NativeCubicalRootMatchesScalar overallNegativeRootCandidate ∧
    CubicCoefficientCovariant overallNegativeRootCandidate.transport ∧
    ¬ NativeCubicalRootAdmissible overallNegativeRootCandidate
  cubicCovarianceHypothesisIsNecessary :
    NativeCubicalRootMatchesScalar reflectedAxisRootCandidate ∧
    ¬ CubicCoefficientCovariant reflectedAxisRootCandidate.transport

theorem dirac018_native_factorization_classification :
    Dirac018NativeFactorizationClassificationCertificate where
  priorChain := dirac017_closed_spin_half_representation
  covariantCoefficientsAreScalar := cubic_covariant_coefficients_are_scalar
  admissibleRootIsCanonical := admissible_native_cubical_root_is_canonical
  independentlyAdmissibleCopiesAreCanonical :=
    admissible_two_copy_native_root_is_canonical
  positiveEmbeddingIsInjective := cube_dirac_embed_plus_injective
  negativeEmbeddingIsInjective := cube_dirac_embed_minus_injective
  positiveEmbeddingHasPositiveFlavor :=
    cube_dirac_embed_plus_has_positive_flavor
  negativeEmbeddingHasNegativeFlavor :=
    cube_dirac_embed_minus_has_negative_flavor
  positiveCopyIsExhaustive := positive_flavor_is_exactly_plus_embedding
  negativeCopyIsExhaustive := negative_flavor_is_exactly_minus_embedding
  copyIntersectionIsZero := cube_flavor_copies_intersect_only_at_zero
  everyAmplitudeDecomposes := cube_flavor_projection_decomposition
  noAdditionalC19MomentumZero := c19_first_brillouin_zone_zero_unique
  orientationHypothesisIsNecessary := ⟨overall_negative_root_matches_scalar,
    negative_identity_cube_matrix_covariant,
    overall_negative_root_is_rejected⟩
  cubicCovarianceHypothesisIsNecessary :=
    ⟨reflected_axis_root_matches_scalar,
      reflected_axis_cube_matrix_not_covariant⟩

end
end LeanDirac

module

public import LeanPool.LatticeDiracDerivation.V35AntiparticleResidueClosure
public import LeanPool.LatticeDiracDerivation.V32FiniteLorentz

/-!
# V3.5 Stage 3: transformations generated by the cubical rotors and boosts

The words below contain only the finite rotations and boosts already derived
from the cubical Clifford representation.  The inverse theorem is therefore
an exact statement about the existing operators, not an imported Lorentz
representation.
-/

@[expose] public section

namespace LeanDirac.V2

noncomputable section

/-- A finite cubical rotation or boost used to generate V3.5 transformation
words. -/
inductive V35LorentzStep where
  | rotation (axis : Fin 3) (angle : ℝ)
  | boost (axis : Fin 3) (rapidity : ℝ)

/-- A finite sequence of inherited cubical rotations and boosts. -/
abbrev V35LorentzWord := List V35LorentzStep

/-- Apply one generated rotation or boost to a cubical four-component state. -/
def v35ApplyLorentzStep
    (step : V35LorentzStep) (z : CubicalCell4) : CubicalCell4 :=
  match step with
  | .rotation axis angle => standardCubicalContinuousTurn angle axis z
  | .boost axis rapidity => standardCubicalFiniteBoost axis rapidity z

/-- Return the generator with negated angle or rapidity. -/
def v35InverseLorentzStep : V35LorentzStep → V35LorentzStep
  | .rotation axis angle => .rotation axis (-angle)
  | .boost axis rapidity => .boost axis (-rapidity)

/-- Apply a finite transformation word in list order. -/
def v35ApplyLorentzWord : V35LorentzWord → CubicalCell4 → CubicalCell4
  | [], z => z
  | step :: rest, z => v35ApplyLorentzWord rest (v35ApplyLorentzStep step z)

/-- Reverse a transformation word and invert each generator. -/
def v35InverseLorentzWord (word : V35LorentzWord) : V35LorentzWord :=
  word.reverse.map v35InverseLorentzStep

@[simp] theorem v35_inverse_lorentz_step_involutive (step : V35LorentzStep) :
    v35InverseLorentzStep (v35InverseLorentzStep step) = step := by
  cases step <;> simp [v35InverseLorentzStep]

theorem v35_inverse_lorentz_word_involutive (word : V35LorentzWord) :
    v35InverseLorentzWord (v35InverseLorentzWord word) = word := by
  simp only [v35InverseLorentzWord, List.map_reverse, List.reverse_reverse,
    List.map_map]
  have hfunction :
      v35InverseLorentzStep ∘ v35InverseLorentzStep =
        (id : V35LorentzStep → V35LorentzStep) := by
    funext step
    exact v35_inverse_lorentz_step_involutive step
  rw [hfunction]
  exact List.map_id word

theorem v35_lorentz_step_inverse
    (step : V35LorentzStep) (z : CubicalCell4) :
    v35ApplyLorentzStep (v35InverseLorentzStep step)
        (v35ApplyLorentzStep step z) = z := by
  cases step with
  | rotation axis angle =>
      exact standard_cubical_continuous_turn_inverse angle axis z
  | boost axis rapidity =>
      exact standard_cubical_finite_boost_inverse axis rapidity z

theorem v35_apply_lorentz_word_append
    (first second : V35LorentzWord) (z : CubicalCell4) :
    v35ApplyLorentzWord (first ++ second) z =
      v35ApplyLorentzWord second (v35ApplyLorentzWord first z) := by
  induction first generalizing z with
  | nil => rfl
  | cons step rest ih =>
      simp only [List.cons_append, v35ApplyLorentzWord]
      exact ih (v35ApplyLorentzStep step z)

theorem v35_apply_inverse_lorentz_word
    (word : V35LorentzWord) (z : CubicalCell4) :
    v35ApplyLorentzWord (v35InverseLorentzWord word)
        (v35ApplyLorentzWord word z) = z := by
  induction word generalizing z with
  | nil => rfl
  | cons step rest ih =>
      simp only [v35InverseLorentzWord, List.reverse_cons, List.map_append,
        List.map_singleton, v35ApplyLorentzWord]
      rw [v35_apply_lorentz_word_append]
      change v35ApplyLorentzStep (v35InverseLorentzStep step)
        (v35ApplyLorentzWord (rest.reverse.map v35InverseLorentzStep)
          (v35ApplyLorentzWord rest (v35ApplyLorentzStep step z))) = z
      have hrest :
          v35ApplyLorentzWord (rest.reverse.map v35InverseLorentzStep)
              (v35ApplyLorentzWord rest (v35ApplyLorentzStep step z)) =
            v35ApplyLorentzStep step z := by
        simpa [v35InverseLorentzWord] using
          ih (v35ApplyLorentzStep step z)
      rw [hrest]
      exact v35_lorentz_step_inverse step z

theorem v35_apply_lorentz_word_inverse
    (word : V35LorentzWord) (z : CubicalCell4) :
    v35ApplyLorentzWord word
        (v35ApplyLorentzWord (v35InverseLorentzWord word) z) = z := by
  have h := v35_apply_inverse_lorentz_word (v35InverseLorentzWord word) z
  rw [v35_inverse_lorentz_word_involutive] at h
  exact h

/-- Certificate for composition, inversion, and two-sided cancellation of the
generated transformations. -/
structure V35GeneratedLorentzTransformationCertificate : Prop where
  stepInverse : ∀ step z,
    v35ApplyLorentzStep (v35InverseLorentzStep step)
        (v35ApplyLorentzStep step z) = z
  composition : ∀ first second z,
    v35ApplyLorentzWord (first ++ second) z =
      v35ApplyLorentzWord second (v35ApplyLorentzWord first z)
  wordInverse : ∀ word z,
    v35ApplyLorentzWord (v35InverseLorentzWord word)
        (v35ApplyLorentzWord word z) = z
  inverseWord : ∀ word z,
    v35ApplyLorentzWord word
        (v35ApplyLorentzWord (v35InverseLorentzWord word) z) = z

theorem v35_generated_lorentz_transformations :
    V35GeneratedLorentzTransformationCertificate where
  stepInverse := v35_lorentz_step_inverse
  composition := v35_apply_lorentz_word_append
  wordInverse := v35_apply_inverse_lorentz_word
  inverseWord := v35_apply_lorentz_word_inverse

end
end LeanDirac.V2

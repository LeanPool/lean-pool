module

public import LeanPool.LatticeDiracDerivation.V34CovariantSpinors

/-!
# V3.4 Stage 5: non-forward Gordon identity

The tensor operator is defined from the commutator of the gamma operators
already derived from the cube.  The non-forward identity is then a Clifford
algebra consequence for independently chosen incoming and outgoing momenta.
No electromagnetic field, form factor, or value of `g` is assumed.
-/

@[expose] public section

namespace LeanDirac.V2

noncomputable section
open BigOperators Complex

/-- The antisymmetric sigma action generated by two cubical gamma actions. -/
def v34Sigma (mu nu : Fin 4) (z : CubicalCell4) : CubicalCell4 :=
  fun component =>
    (I / 2) *
      (v34Gamma mu (v34Gamma nu z) component -
        v34Gamma nu (v34Gamma mu z) component)

/-- Predicate that a covector is on shell on the left. -/
def v34LeftOnShell
    (mass energy px py pz : ℝ) (left : CubicalCell4) : Prop :=
  ∀ w : CubicalCell4,
    v34DiracBilinear left (v34MomentumSlash energy px py pz) w =
      (mass : ℂ) * v34DiracBilinear left (fun z => z) w

/-- Predicate that a spinor is on shell on the right. -/
def v34RightOnShell
    (mass energy px py pz : ℝ) (right : CubicalCell4) : Prop :=
  v34MomentumSlash energy px py pz right =
    fun component => (mass : ℂ) * right component

theorem v34_nonforward_clifford_identity
    (outEnergy outPx outPy outPz inEnergy inPx inPy inPz : ℝ)
    (mu : Fin 4) (z : CubicalCell4) :
    (fun component =>
      v34MomentumSlash outEnergy outPx outPy outPz
          (v34Gamma mu z) component +
        v34Gamma mu
          (v34MomentumSlash inEnergy inPx inPy inPz z) component) =
    (fun component =>
      ((v34ContravariantMomentum outEnergy outPx outPy outPz mu +
          v34ContravariantMomentum inEnergy inPx inPy inPz mu : ℝ) : ℂ) *
          z component +
        ∑ nu : Fin 4,
          I * ((v34CovariantMomentum outEnergy outPx outPy outPz nu -
            v34CovariantMomentum inEnergy inPx inPy inPz nu : ℝ) : ℂ) *
              v34Sigma mu nu z component) := by
  funext component
  fin_cases mu <;> fin_cases component <;>
    simp [v34MomentumSlash, v34ContravariantMomentum,
      v34CovariantMomentum, v34Gamma, v34Sigma,
      cubicalGammaTime, cubicalGammaSpace, cubicalAlpha,
      cubicalStandardBeta, cubicalStandardAlphaX,
      cubicalStandardAlphaY, cubicalStandardAlphaZ,
      Fin.sum_univ_four] <;>
    ring_nf <;> norm_num [Complex.I_sq] <;> ring

theorem v34_positive_spinor_right_on_shell
    (mass energy px py pz : ℝ)
    (hdenom : energy + mass ≠ 0)
    (hshell : energy ^ 2 = mass ^ 2 + px ^ 2 + py ^ 2 + pz ^ 2)
    (spin : Fin 2) :
    v34RightOnShell mass energy px py pz
      (v34PositiveSpinor mass energy px py pz spin) := by
  have h := v34_positive_spinor_covariant_equation
    mass energy px py pz hdenom hshell spin
  funext component
  have hc := congrFun h component
  exact sub_eq_zero.mp hc

theorem v34_bilinear_dirac_residual_is_hamiltonian_residual
    (mass energy px py pz : ℝ) (left right : CubicalCell4) :
    v34DiracBilinear left (v34MomentumSlash energy px py pz) right -
        (mass : ℂ) * v34DiracBilinear left (fun z => z) right =
      cubicalCell4Inner left (fun component =>
        (energy : ℂ) * right component -
          v32ContinuumHamiltonian mass px py pz right component) := by
  simp [v34DiracBilinear, v34DiracAdjointComponent,
    v34MomentumSlash, v34CovariantMomentum, v34Gamma,
    cubicalGammaTime, cubicalGammaSpace, cubicalAlpha,
    v32ContinuumHamiltonian, cubicalCell4Inner,
    cubicalStandardHamiltonian, cubicalStandardSpatial,
    cubicalStandardBeta, cubicalStandardAlphaX,
    cubicalStandardAlphaY, cubicalStandardAlphaZ,
    Fin.sum_univ_four]
  ring

theorem v34_positive_spinor_left_on_shell
    (mass energy px py pz : ℝ)
    (hdenom : energy + mass ≠ 0)
    (hshell : energy ^ 2 = mass ^ 2 + px ^ 2 + py ^ 2 + pz ^ 2)
    (spin : Fin 2) :
    v34LeftOnShell mass energy px py pz
      (v34PositiveSpinor mass energy px py pz spin) := by
  intro w
  let u := v34PositiveSpinor mass energy px py pz spin
  have heigen :
      v32ContinuumHamiltonian mass px py pz u =
        fun component => (energy : ℂ) * u component := by
    exact normalized_positive_frequency_is_energy_eigenstate
      mass energy px py pz hdenom hshell (v34TwoChannelBasis spin)
  have hhermitian := v32_continuum_hamiltonian_is_hermitian
    mass px py pz u w
  have hinnerEigen :
      cubicalCell4Inner u (v32ContinuumHamiltonian mass px py pz w) =
        (energy : ℂ) * cubicalCell4Inner u w := by
    calc
      _ = cubicalCell4Inner
          (v32ContinuumHamiltonian mass px py pz u) w := hhermitian
      _ = cubicalCell4Inner
          (fun component => (energy : ℂ) * u component) w := by rw [heigen]
      _ = (energy : ℂ) * cubicalCell4Inner u w := by
        simp [cubicalCell4Inner, Fin.sum_univ_four]
        ring
  have hresidualInner :
      cubicalCell4Inner u (fun component =>
        (energy : ℂ) * w component -
          v32ContinuumHamiltonian mass px py pz w component) = 0 := by
    calc
      _ = (energy : ℂ) * cubicalCell4Inner u w -
          cubicalCell4Inner u
            (v32ContinuumHamiltonian mass px py pz w) := by
              simp [cubicalCell4Inner, Fin.sum_univ_four]
              ring
      _ = 0 := by rw [hinnerEigen]; ring
  have hbridge := v34_bilinear_dirac_residual_is_hamiltonian_residual
    mass energy px py pz u w
  rw [hresidualInner] at hbridge
  exact sub_eq_zero.mp hbridge

theorem v34_nonforward_gordon_identity
    (mass outEnergy outPx outPy outPz inEnergy inPx inPy inPz : ℝ)
    (left right : CubicalCell4) (mu : Fin 4)
    (hleft : v34LeftOnShell mass outEnergy outPx outPy outPz left)
    (hright : v34RightOnShell mass inEnergy inPx inPy inPz right) :
    (2 * mass : ℂ) * v34DiracBilinear left (v34Gamma mu) right =
      ((v34ContravariantMomentum outEnergy outPx outPy outPz mu +
          v34ContravariantMomentum inEnergy inPx inPy inPz mu : ℝ) : ℂ) *
        v34DiracBilinear left (fun z => z) right +
      ∑ nu : Fin 4,
        I * ((v34CovariantMomentum outEnergy outPx outPy outPz nu -
          v34CovariantMomentum inEnergy inPx inPy inPz nu : ℝ) : ℂ) *
            v34DiracBilinear left (v34Sigma mu nu) right := by
  have hL := hleft (v34Gamma mu right)
  have hL' :
      v34DiracBilinear left
          (v34MomentumSlash outEnergy outPx outPy outPz)
          (v34Gamma mu right) =
        (mass : ℂ) * v34DiracBilinear left (v34Gamma mu) right := by
    simpa [v34DiracBilinear] using hL
  have hrightGamma :
      v34DiracBilinear left (v34Gamma mu)
          (v34MomentumSlash inEnergy inPx inPy inPz right) =
        (mass : ℂ) * v34DiracBilinear left (v34Gamma mu) right := by
    rw [hright]
    fin_cases mu <;>
      simp [v34DiracBilinear, v34Gamma, cubicalGammaTime,
        cubicalGammaSpace, cubicalAlpha, cubicalStandardBeta,
        cubicalStandardAlphaX, cubicalStandardAlphaY,
        cubicalStandardAlphaZ, Fin.sum_univ_four] <;> ring
  have hraw := v34_nonforward_clifford_identity
    outEnergy outPx outPy outPz inEnergy inPx inPy inPz mu right
  have hrawB := congrArg
    (fun w : CubicalCell4 => v34DiracBilinear left (fun z => z) w) hraw
  calc
    (2 * mass : ℂ) * v34DiracBilinear left (v34Gamma mu) right =
        v34DiracBilinear left
            (v34MomentumSlash outEnergy outPx outPy outPz)
            (v34Gamma mu right) +
          v34DiracBilinear left (v34Gamma mu)
            (v34MomentumSlash inEnergy inPx inPy inPz right) := by
              rw [hL', hrightGamma]
              ring
    _ = v34DiracBilinear left (fun z => z)
        (fun component =>
          v34MomentumSlash outEnergy outPx outPy outPz
              (v34Gamma mu right) component +
            v34Gamma mu
              (v34MomentumSlash inEnergy inPx inPy inPz right) component) := by
          simp [v34DiracBilinear, Fin.sum_univ_four]
          ring
    _ = v34DiracBilinear left (fun z => z)
        (fun component =>
          ((v34ContravariantMomentum outEnergy outPx outPy outPz mu +
              v34ContravariantMomentum inEnergy inPx inPy inPz mu : ℝ) : ℂ) *
              right component +
            ∑ nu : Fin 4,
              I * ((v34CovariantMomentum outEnergy outPx outPy outPz nu -
                v34CovariantMomentum inEnergy inPx inPy inPz nu : ℝ) : ℂ) *
                  v34Sigma mu nu right component) := hrawB
    _ = _ := by
      simp [v34DiracBilinear, Fin.sum_univ_four]
      ring

theorem v34_nonforward_gordon_for_native_spinors
    (mass outEnergy outPx outPy outPz inEnergy inPx inPy inPz : ℝ)
    (outSpin inSpin : Fin 2) (mu : Fin 4)
    (houtDenom : outEnergy + mass ≠ 0)
    (houtShell : outEnergy ^ 2 = mass ^ 2 + outPx ^ 2 + outPy ^ 2 + outPz ^ 2)
    (hinDenom : inEnergy + mass ≠ 0)
    (hinShell : inEnergy ^ 2 = mass ^ 2 + inPx ^ 2 + inPy ^ 2 + inPz ^ 2) :
    (2 * mass : ℂ) *
        v34DiracBilinear
          (v34PositiveSpinor mass outEnergy outPx outPy outPz outSpin)
          (v34Gamma mu)
          (v34PositiveSpinor mass inEnergy inPx inPy inPz inSpin) =
      ((v34ContravariantMomentum outEnergy outPx outPy outPz mu +
          v34ContravariantMomentum inEnergy inPx inPy inPz mu : ℝ) : ℂ) *
        v34DiracBilinear
          (v34PositiveSpinor mass outEnergy outPx outPy outPz outSpin)
          (fun z => z)
          (v34PositiveSpinor mass inEnergy inPx inPy inPz inSpin) +
      ∑ nu : Fin 4,
        I * ((v34CovariantMomentum outEnergy outPx outPy outPz nu -
          v34CovariantMomentum inEnergy inPx inPy inPz nu : ℝ) : ℂ) *
            v34DiracBilinear
              (v34PositiveSpinor mass outEnergy outPx outPy outPz outSpin)
              (v34Sigma mu nu)
              (v34PositiveSpinor mass inEnergy inPx inPy inPz inSpin) := by
  exact v34_nonforward_gordon_identity
    mass outEnergy outPx outPy outPz inEnergy inPx inPy inPz
    (v34PositiveSpinor mass outEnergy outPx outPy outPz outSpin)
    (v34PositiveSpinor mass inEnergy inPx inPy inPz inSpin) mu
    (v34_positive_spinor_left_on_shell
      mass outEnergy outPx outPy outPz houtDenom houtShell outSpin)
    (v34_positive_spinor_right_on_shell
      mass inEnergy inPx inPy inPz hinDenom hinShell inSpin)

/-- Certificate for the nonforward Gordon decomposition between on-shell states. -/
structure V34NonforwardGordonCertificate : Prop where
  clifford : ∀ outEnergy outPx outPy outPz inEnergy inPx inPy inPz mu z,
    (fun component =>
      v34MomentumSlash outEnergy outPx outPy outPz
          (v34Gamma mu z) component +
        v34Gamma mu
          (v34MomentumSlash inEnergy inPx inPy inPz z) component) =
    (fun component =>
      ((v34ContravariantMomentum outEnergy outPx outPy outPz mu +
          v34ContravariantMomentum inEnergy inPx inPy inPz mu : ℝ) : ℂ) *
          z component +
        ∑ nu : Fin 4,
          I * ((v34CovariantMomentum outEnergy outPx outPy outPz nu -
            v34CovariantMomentum inEnergy inPx inPy inPz nu : ℝ) : ℂ) *
              v34Sigma mu nu z component)
  gordon : ∀ mass outEnergy outPx outPy outPz inEnergy inPx inPy inPz
      left right mu,
    v34LeftOnShell mass outEnergy outPx outPy outPz left →
    v34RightOnShell mass inEnergy inPx inPy inPz right →
    (2 * mass : ℂ) * v34DiracBilinear left (v34Gamma mu) right =
      ((v34ContravariantMomentum outEnergy outPx outPy outPz mu +
          v34ContravariantMomentum inEnergy inPx inPy inPz mu : ℝ) : ℂ) *
        v34DiracBilinear left (fun z => z) right +
      ∑ nu : Fin 4,
        I * ((v34CovariantMomentum outEnergy outPx outPy outPz nu -
          v34CovariantMomentum inEnergy inPx inPy inPz nu : ℝ) : ℂ) *
            v34DiracBilinear left (v34Sigma mu nu) right
  nativeLeftOnShell : ∀ mass energy px py pz,
    energy + mass ≠ 0 →
    energy ^ 2 = mass ^ 2 + px ^ 2 + py ^ 2 + pz ^ 2 → ∀ spin,
      v34LeftOnShell mass energy px py pz
        (v34PositiveSpinor mass energy px py pz spin)
  nativeGordon : ∀ (mass outEnergy outPx outPy outPz
      inEnergy inPx inPy inPz : ℝ),
    ∀ (outSpin inSpin : Fin 2) (mu : Fin 4),
    outEnergy + mass ≠ 0 →
    outEnergy ^ 2 = mass ^ 2 + outPx ^ 2 + outPy ^ 2 + outPz ^ 2 →
    inEnergy + mass ≠ 0 →
    inEnergy ^ 2 = mass ^ 2 + inPx ^ 2 + inPy ^ 2 + inPz ^ 2 →
    (2 * mass : ℂ) *
        v34DiracBilinear
          (v34PositiveSpinor mass outEnergy outPx outPy outPz outSpin)
          (v34Gamma mu)
          (v34PositiveSpinor mass inEnergy inPx inPy inPz inSpin) =
      ((v34ContravariantMomentum outEnergy outPx outPy outPz mu +
          v34ContravariantMomentum inEnergy inPx inPy inPz mu : ℝ) : ℂ) *
        v34DiracBilinear
          (v34PositiveSpinor mass outEnergy outPx outPy outPz outSpin)
          (fun z => z)
          (v34PositiveSpinor mass inEnergy inPx inPy inPz inSpin) +
      ∑ nu : Fin 4,
        I * ((v34CovariantMomentum outEnergy outPx outPy outPz nu -
          v34CovariantMomentum inEnergy inPx inPy inPz nu : ℝ) : ℂ) *
            v34DiracBilinear
              (v34PositiveSpinor mass outEnergy outPx outPy outPz outSpin)
              (v34Sigma mu nu)
              (v34PositiveSpinor mass inEnergy inPx inPy inPz inSpin)

theorem v34_nonforward_gordon : V34NonforwardGordonCertificate where
  clifford := v34_nonforward_clifford_identity
  gordon := v34_nonforward_gordon_identity
  nativeLeftOnShell := v34_positive_spinor_left_on_shell
  nativeGordon := v34_nonforward_gordon_for_native_spinors

end
end LeanDirac.V2

/-
Extracted for Lean Pool from the PriorityStage, GuardedStage, and LocalStage modules of
bjoernkjoshanssen/tt-auto/OAI/Computability/DegreeRigidity/Effective.
The transition and scheduling proofs are shared over procedure and state interfaces.
-/

module

public import LeanPool.TuringConeRigidity.CohenForcing.EncodedForcing
public import LeanPool.TuringConeRigidity.Effective.FiniteInjuryLimits
public import LeanPool.TuringConeRigidity.Effective.FiniteInjurySchedule

/-!
# Shared finite-injury stage engine

The engine separates procedure selection from state representation and proves its
scheduling and extension properties for any supplied column family. The original
state structures instantiate the interface through their unchanged constructors.
-/

@[expose] public section

namespace OAI.TuringRigidity.StageEngine

open Encodable CodingForcing EncodedForcing FiniteInjury
noncomputable section
attribute [local instance] Classical.propDecidable

/-- The numerical pair and open-decision procedures used by a stage construction. -/
structure Procedures where
  /-- Select an encoded candidate for a priority and condition request. -/
  pairProcedure : ℕ → ℕ
  /-- Decide an encoded open requirement and condition request. -/
  openProcedure : ℕ → ℕ

/-- Access to an existing state representation with its three constructor equations. -/
structure StateInterface (S : Type) where
  /-- The state's current coding condition. -/
  condition : S → Condition
  /-- The completed priorities. -/
  done : S → Finset ℕ
  /-- The priorities visited since their last injury reset. -/
  seen : S → Finset ℕ
  /-- Construct a state from its condition and priority records. -/
  make : Condition → Finset ℕ → Finset ℕ → S
  /-- Constructing a state retains its condition. -/
  condition_make : ∀ p d s, condition (make p d s) = p
  /-- Constructing a state retains its completed record. -/
  done_make : ∀ p d s, done (make p d s) = d
  /-- Constructing a state retains its visited record. -/
  seen_make : ∀ p d s, seen (make p d s) = s

variable {S : Type} (I : StateInterface S)

/-- The selected candidate condition at priority `t`, normalized to level `t`. -/
def candidate (C : Procedures) (t : ℕ) (p : Condition) : Condition :=
  atLevel (condition (C.pairProcedure (Nat.pair t (code (atLevel p t))))) t

/-- The selected candidate changes at least one condition word. -/
def Changes (C : Procedures) (t : ℕ) (p : Condition) : Prop :=
  (candidate C t p).left ≠ p.left ∨ (candidate C t p).right ≠ p.right

/-- Search a bounded priority range for an unfinished candidate that changes the
condition. -/
def scan (C : Procedures) (p : Condition) (done : Finset ℕ) (t : ℕ) : ℕ → Option ℕ
  | 0 => none
  | n+1 => if t ∉ done ∧ Changes C t p then some t else scan C p done (t+1) n

theorem scan_spec {C : Procedures} {p : Condition} {done : Finset ℕ} {t n i : ℕ}
    (h : scan C p done t n = some i) :
    t ≤ i ∧ i < t+n ∧ i ∉ done ∧ Changes C i p := by
  induction n generalizing t with
  | zero => simp [scan] at h
  | succ n ih =>
    simp only [scan] at h
    split at h
    · rename_i ht
      have he := Option.some.inj h
      subst i
      exact ⟨le_rfl,by omega,ht⟩
    · obtain ⟨hlo,hhi,hd,hc⟩ := ih h
      exact ⟨by omega,by omega,hd,hc⟩

/-- Extend the condition to meet its least unvisited open requirement. -/
def generic (C : Procedures) (p : S) : Condition :=
  EncodedForcing.condition (C.openProcedure (Nat.pair (FiniteInjurySchedule.visit (I.seen p)) (code
    (I.condition p))))

/-- The bounded stage action selected after the open extension. -/
def stageAction (C : Procedures) (s : ℕ) (p : S) : Option ℕ := scan C (generic I C p)
  (I.done p) 0 s

/-- Select the stage condition from the open extension and any action candidate. -/
def stageWord (C : Procedures) (s : ℕ) (p : S) : Condition :=
  match stageAction I C s p with
  | none => generic I C p
  | some t => candidate C t (generic I C p)

/-- Advance the condition and its completed and visited priority records. -/
def advance (C : Procedures) (s : ℕ) (p : S) : S :=
  I.make (atLevel (append (stageWord I C s p) [false]) (s+1))
    (FiniteInjury.update (I.done p) (stageAction I C s p))
    (FiniteInjurySchedule.reset (insert (FiniteInjurySchedule.visit (I.seen p)) (I.seen p))
      (stageAction I C s p))

/-- The state sequence starting from the empty state. -/
def construction (C : Procedures) : ℕ → S
  | 0 => I.make ⟨[],[],rfl,0⟩ ∅ ∅
  | s+1 => advance I C s (construction C s)

/-- The condition component of the state at stage `s`. -/
def conditions (C : Procedures) (s : ℕ) := (I.condition (construction I C s))

/-- The finite-injury action proposal generated by the state at stage `s`. -/
def proposal (C : Procedures) (s : ℕ) (_ : Finset ℕ) : Option ℕ :=
  stageAction I C s (construction I C s)

theorem action_not_done (C : Procedures) (s : ℕ) (p : S) (t : ℕ)
    (h : stageAction I C s p = some t) : t ∉ (I.done p) := (scan_spec h).2.2.1

theorem accept_action (C : Procedures) (s : ℕ) (p : S) :
    FiniteInjury.accept (I.done p) (stageAction I C s p) = stageAction I C s p := by
  cases ha : stageAction I C s p with
  | none => simp [FiniteInjury.accept]
  | some t => simp [FiniteInjury.accept,action_not_done I C s p t ha]

theorem done_eq (C : Procedures) (s : ℕ) :
    I.done (construction I C s) = FiniteInjury.state (proposal I C) s := by
  induction s with
  | zero => simp only [construction, I.done_make, FiniteInjury.state]
  | succ s ih =>
    rw [construction, advance, I.done_make, FiniteInjury.state, ← ih]
    simp only [proposal, accept_action]

theorem action_eq (C : Procedures) (s : ℕ) :
    FiniteInjury.action (proposal I C) s = stageAction I C s (construction I C s) := by
  rw [FiniteInjury.action,← done_eq]
  exact accept_action I C s _

theorem seen_eq (C : Procedures) (s : ℕ) :
    I.seen (construction I C s) = FiniteInjurySchedule.seen (proposal I C) s := by
  induction s with
  | zero => simp only [construction, I.seen_make, FiniteInjurySchedule.seen]
  | succ s ih =>
    rw [construction, advance, I.seen_make, FiniteInjurySchedule.seen, action_eq, ← ih]

/-- The next condition is obtained by appending one false bit and advancing the level. -/
theorem conditions_succ (C : Procedures) (s : ℕ) :
    conditions I C (s+1) =
      atLevel (append (stageWord I C s (construction I C s)) [false]) (s+1) := by
  simp only [conditions, construction, advance, I.condition_make]

theorem active_eq (C : Procedures) (s : ℕ) : (conditions I C s).active = s := by
  cases s with
  | zero => simp only [conditions, construction, I.condition_make]
  | succ s => rw [conditions_succ]; rfl

section Extension

variable {F : ℕ → Oracle} (C : Procedures)
  (hpair : ∀ t p, Extends F (atLevel p t) (candidate C t p))
  (hopen : ∀ e p, Extends F p (condition (C.openProcedure (Nat.pair e (code p)))))

include hpair hopen

theorem stage_words (s : ℕ) (p : S) :
    (I.condition p).left <+: (stageWord I C s p).left ∧
      (I.condition p).right <+: (stageWord I C s p).right := by
  have ho := hopen (FiniteInjurySchedule.visit (I.seen p)) (I.condition p)
  cases ha : stageAction I C s p with
  | none => exact ⟨by simpa [stageWord, ha, generic] using ho.1, by simpa [stageWord, ha, generic]
      using ho.2.1⟩
  | some t =>
    have hc := hpair t (generic I C p)
    exact ⟨by simpa [stageWord,ha] using ho.1.trans hc.1,
      by simpa [stageWord,ha] using ho.2.1.trans hc.2.1⟩

theorem word_growth (s : ℕ) :
    (conditions I C s).left <+: (conditions I C (s+1)).left ∧
    (conditions I C s).right <+: (conditions I C (s+1)).right := by
  rw [conditions_succ]
  have h := stage_words I C hpair hopen s (construction I C s)
  exact ⟨h.1.trans (List.prefix_append _ _),h.2.trans (List.prefix_append _ _)⟩

theorem length_bound (s : ℕ) : s ≤ (conditions I C s).left.length := by
  induction s with
  | zero => exact Nat.zero_le _
  | succ s ih =>
    have h := (stage_words I C hpair hopen s (construction I C s)).1.length_le
    rw [conditions_succ]
    change s+1 ≤ ((stageWord I C s (construction I C s)).left ++ [false]).length
    simp only [List.length_append,List.length_singleton]
    exact Nat.add_le_add_right (ih.trans h) 1

theorem level_step (s k : ℕ) (hk : k ≤ s)
    (hact : ∀ t, FiniteInjury.action (proposal I C) s = some t → k ≤ t) :
    Extends F (atLevel (conditions I C s) k) (atLevel (conditions I C (s+1)) k) := by
  let p := construction I C s
  have ho := hopen (FiniteInjurySchedule.visit (I.seen p)) (I.condition p)
  have hg : Extends F (atLevel (I.condition p) k) (atLevel (generic I C p) k) := by
    refine ⟨ho.1,ho.2.1,le_rfl,?_⟩
    intro m hm hlen
    apply ho.2.2.2 m ⟨hm.1,?_,hm.2.2⟩ hlen
    exact hm.2.1.trans_le (by
      change k ≤ (conditions I C s).active
      rw [active_eq]
      exact hk)
  have hw : Extends F (atLevel (generic I C p) k) (atLevel (stageWord I C s p) k) := by
    cases ha : stageAction I C s p with
    | none => simpa [stageWord,ha] using extends_refl F (atLevel (generic I C p) k)
    | some t =>
      have hkt : k ≤ t := hact t (by simpa [action_eq,p] using ha)
      have hc := hpair t (generic I C p)
      have hc' : Extends F (atLevel (generic I C p) t) (atLevel (candidate C t (generic I C p)) t)
        := hc
      simpa [stageWord,ha] using level_mono hc' hkt
  have htail : Extends F (atLevel (stageWord I C s p) k)
      (atLevel (conditions I C (s+1)) k) := by
    rw [conditions_succ]
    exact append_extends _ _ [false]
  exact extends_trans hg (extends_trans hw htail)

theorem surviving_columns (k : ℕ) : ∃ S, ∀ m,
    (conditions I C S).left.length ≤ m → (Nat.unpair m).1 < k →
    F (Nat.unpair m).1 (Nat.unpair m).2 = true →
    leftLimit (conditions I C) m = rightLimit (conditions I C) m :=
  eventual_column_agreement F (proposal I C) (conditions I C)
    (word_growth I C hpair hopen) (length_bound I C hpair hopen) (level_step I C hpair hopen) k

end Extension

theorem surviving_generic_visit (C : Procedures) (t : ℕ) : ∃ s,
    FiniteInjurySchedule.visit (I.seen (construction I C s)) = t ∧
      ∀ u, s ≤ u → ∀ i < t, stageAction I C u (construction I C u) ≠ some i := by
  obtain ⟨s,hs,hh⟩ := FiniteInjurySchedule.surviving_visit (proposal I C) t
  refine ⟨s,?_,?_⟩
  · simpa [seen_eq,FiniteInjurySchedule.scheduled] using hs
  · simpa only [action_eq] using hh


theorem done_witness (C : Procedures) {s t : ℕ} (ht : t ∈ I.done (construction I C s)) :
    ∃ u, u < s ∧ stageAction I C u (construction I C u) = some t := by
  induction s with
  | zero => simp [construction, I.done_make] at ht
  | succ s ih =>
    rw [construction, advance, I.done_make] at ht
    cases ha : stageAction I C s (construction I C s) with
    | none =>
      obtain ⟨u,hu,he⟩ := ih (by simpa [ha,FiniteInjury.update] using ht)
      exact ⟨u,by omega,he⟩
    | some i =>
      simp only [ha,FiniteInjury.update,Finset.mem_insert,Finset.mem_filter] at ht
      rcases ht with rfl | ⟨ht,_⟩
      · exact ⟨s,by omega,ha⟩
      · obtain ⟨u,hu,he⟩ := ih ht
        exact ⟨u,by omega,he⟩

theorem scan_hits {C : Procedures} {p : Condition} {d : Finset ℕ} {start n t : ℕ}
    (hlo : start ≤ t) (hhi : t < start + n) (hd : t ∉ d) (hc : Changes C t p) :
    ∃ i, i ≤ t ∧ scan C p d start n = some i := by
  induction n generalizing start with
  | zero => omega
  | succ n ih =>
    by_cases h : start ∉ d ∧ Changes C start p
    · exact ⟨start,hlo,by simp only [scan,ite_eq_left h]⟩
    · have hne : start ≠ t := by rintro rfl; exact h ⟨hd,hc⟩
      obtain ⟨i,hi,he⟩ := ih (start := start+1) (by omega) (by omega)
      exact ⟨i,hi,by simpa only [scan,ite_eq_right h] using he⟩

end
end OAI.TuringRigidity.StageEngine

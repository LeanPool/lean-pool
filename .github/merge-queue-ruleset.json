{
  "name": "Validated merge queue",
  "target": "branch",
  "enforcement": "disabled",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          {
            "context": "Build project",
            "integration_id": 15368
          },
          {
            "context": "Content / non-content separation",
            "integration_id": 15368
          },
          {
            "context": "Documentation preflight",
            "integration_id": 15368
          },
          {
            "context": "Lint (ruff)",
            "integration_id": 15368
          },
          {
            "context": "Test (pytest)",
            "integration_id": 15368
          },
          {
            "context": "actionlint",
            "integration_id": 15368
          },
          {
            "context": "SHA-pinned Actions",
            "integration_id": 15368
          },
          {
            "context": "Verify minimal Lean files",
            "integration_id": 15368
          }
        ]
      }
    },
    {
      "type": "merge_queue",
      "parameters": {
        "check_response_timeout_minutes": 240,
        "grouping_strategy": "ALLGREEN",
        "max_entries_to_build": 3,
        "max_entries_to_merge": 10,
        "merge_method": "SQUASH",
        "min_entries_to_merge": 1,
        "min_entries_to_merge_wait_minutes": 0
      }
    }
  ]
}

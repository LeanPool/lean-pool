[Unit]
Description=Resume Lean Pool version bumps on the Lean VM using cx
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/data/lean-pool-bump/engine/python
Environment=PATH=/home/vasil/.local/bin:/home/vasil/.elan/bin:/usr/local/bin:/usr/bin:/bin
Environment=TMPDIR=/data/lean-pool-bump/tmp
EnvironmentFile=-/data/lean-pool-bump/environment
ExecStart=/data/lean-pool-bump/engine/python/.venv/bin/python -m lean_pool.bump_vm
UMask=0077
TimeoutStartSec=infinity
TimeoutStopSec=30s
KillMode=control-group
Restart=on-failure
RestartSec=1h
MemoryMax=24G
CPUQuota=400%
TasksMax=4096
Nice=10
CPUWeight=20
IOWeight=20
